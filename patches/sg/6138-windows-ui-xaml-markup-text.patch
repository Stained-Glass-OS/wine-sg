+/*
+ * XAML text, per the public XAML language documentation: an element is an object (one of ours, by
+ * its name in the presentation namespace, or the application's -- "using:" namespaces -- through its
+ * IXamlMetadataProvider); an attribute or a property element sets a member, from a string converted
+ * by the member's type; child elements go to the type's content property; Owner.Member is an
+ * attached property; x:Name names an object, x:ConnectionId hands it to the component being loaded
+ * (IComponentConnector), as compiled pages expect.  The object writer (xaml_writer_*) is shared with
+ * the binary reader.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "private.h"
+#include "winuser.h"
+#include "appmodel.h"
+
+LONG WINAPI GetCurrentPackagePath( UINT32 *length, WCHAR *path );
+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#include "initguid.h"
+#include "xmllite.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const WCHAR ns_presentation[] = L"http://schemas.microsoft.com/winfx/2006/xaml/presentation";
+static const WCHAR ns_xaml[] = L"http://schemas.microsoft.com/winfx/2006/xaml";
+static const WCHAR ns_compat[] = L"http://schemas.openxmlformats.org/markup-compatibility/2006";
+
+static const GUID IID_IXamlMetadataProvider_x = { 0xb3765d69, 0x68a5, 0x4b32, { 0x88, 0x61, 0xfd, 0xb9, 0x0c, 0x1f, 0x58, 0x36 } };
+static const GUID IID_IComponentConnector_x = { 0xf6790987, 0xe6e5, 0x47f2, { 0x92, 0xc6, 0xec, 0xcc, 0xe4, 0xba, 0x15, 0x9a } };
+static const GUID IID_IUriRuntimeClass_x = { 0x9e365e57, 0x48b2, 0x4160, { 0x95, 0x6f, 0xc7, 0x38, 0x51, 0x20, 0xbb, 0xfc } };
+static const GUID IID_IXamlReaderStatics_x = { 0x9891c6bd, 0x534f, 0x4955, { 0xb8, 0x5a, 0x8a, 0x8d, 0xc0, 0xdc, 0xa6, 0x02 } };
+
+/* IXamlType and IXamlMember slots (windows-rs 0.30.0) */
+enum { XT_ContentProperty = 7, XT_FullName = 8, XT_IsCollection = 10, XT_ActivateInstance = 18, XT_CreateFromString = 19,
+       XT_GetMember = 20, XT_AddToVector = 21 };
+enum { XM_Type = 11, XM_GetValue = 12, XM_SetValue = 13 };
+#define CALL(o, slot, type) ((type)(((void **)((IUnknown *)(o))->lpVtbl)[slot]))
+
+/* ---- our types ---- */
+
+struct xtype
+{
+    const WCHAR *name;          /* in the presentation namespace */
+    const WCHAR *class;         /* the runtime class */
+    const WCHAR *base;          /* its base's name */
+    const GUID *composable;     /* its composable factory, or NULL (activatable) */
+    const WCHAR *content;       /* its content property */
+};
+
+static const struct xtype types[] =
+{
+    { L"DependencyObject", L"Windows.UI.Xaml.DependencyObject", NULL, &IID_IDependencyObjectFactory },
+    { L"UIElement", L"Windows.UI.Xaml.UIElement", L"DependencyObject" },
+    { L"FrameworkElement", L"Windows.UI.Xaml.FrameworkElement", L"UIElement", &IID_IFrameworkElementFactory },
+    { L"Panel", L"Windows.UI.Xaml.Controls.Panel", L"FrameworkElement", &IID_IPanelFactory, L"Children" },
+    { L"Grid", L"Windows.UI.Xaml.Controls.Grid", L"Panel", &IID_IGridFactory, L"Children" },
+    { L"StackPanel", L"Windows.UI.Xaml.Controls.StackPanel", L"Panel", &IID_IStackPanelFactory, L"Children" },
+    { L"Border", L"Windows.UI.Xaml.Controls.Border", L"FrameworkElement", NULL, L"Child" },
+    { L"TextBlock", L"Windows.UI.Xaml.Controls.TextBlock", L"FrameworkElement", NULL, L"Text" },
+    { L"RowDefinition", L"Windows.UI.Xaml.Controls.RowDefinition", L"DependencyObject" },
+    { L"ColumnDefinition", L"Windows.UI.Xaml.Controls.ColumnDefinition", L"DependencyObject" },
+    { L"Control", L"Windows.UI.Xaml.Controls.Control", L"FrameworkElement", &IID_IControlFactory },
+    { L"ContentControl", L"Windows.UI.Xaml.Controls.ContentControl", L"Control", &IID_IContentControlFactory, L"Content" },
+    { L"UserControl", L"Windows.UI.Xaml.Controls.UserControl", L"Control", &IID_IUserControlFactory, L"Content" },
+    { L"Page", L"Windows.UI.Xaml.Controls.Page", L"UserControl", &IID_IPageFactory, L"Content" },
+    { L"Brush", L"Windows.UI.Xaml.Media.Brush", L"DependencyObject", &IID_IBrushFactory },
+    { L"SolidColorBrush", L"Windows.UI.Xaml.Media.SolidColorBrush", L"Brush", NULL, L"Color" },
+};
+
+static const struct xtype *find_type( const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(types); i++) if (!wcscmp( types[i].name, name )) return &types[i];
+    return NULL;
+}
+
+static const struct xtype *type_of_class( const WCHAR *class )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(types); i++) if (!wcscmp( types[i].class, class )) return &types[i];
+    return NULL;
+}
+
+/* the type of one of our objects (an application's derived object: the type of its base of ours) */
+static const struct xtype *type_of_object( IInspectable *obj )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+    return d ? type_of_class( d->obj.cls->name ) : NULL;
+}
+
+static HRESULT create_ours( const struct xtype *type, IInspectable **out )
+{
+    IActivationFactory *factory;
+    IInspectable *inner = NULL;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = xaml_get_factory( type->class, &factory ))) return hr;
+    if (type->composable)
+    {
+        IInspectable *composable;
+        if (SUCCEEDED(hr = IActivationFactory_QueryInterface( factory, type->composable, (void **)&composable )))
+        {
+            hr = CALL( composable, 6, HRESULT (WINAPI *)( IInspectable *, IInspectable *, IInspectable **, IInspectable ** ) )
+                     ( composable, NULL, &inner, out );
+            IInspectable_Release( composable );
+        }
+    }
+    else hr = IActivationFactory_ActivateInstance( factory, out );
+    IActivationFactory_Release( factory );
+    return hr;
+}
+
+/* a member of ours: the property of that name of the type or one of its bases */
+static struct xaml_property *find_member( const struct xtype *type, const WCHAR *name )
+{
+    struct xaml_property *prop;
+
+    for (; type; type = type->base ? find_type( type->base ) : NULL)
+        if ((prop = xaml_property_find( type->class, name ))) return prop;
+    return NULL;
+}
+
+/* ---- the application's types ---- */
+
+static IInspectable *metadata_provider(void)
+{
+    IInspectable *app = xaml_current_application(), *provider = NULL;
+
+    if (!app) return NULL;
+    IInspectable_QueryInterface( app, &IID_IXamlMetadataProvider_x, (void **)&provider );
+    IInspectable_Release( app );
+    return provider;
+}
+
+static IInspectable *app_type( const WCHAR *full_name )
+{
+    IInspectable *provider = metadata_provider(), *type = NULL;
+    HSTRING str;
+
+    if (!provider) return NULL;
+    if (SUCCEEDED(WindowsCreateString( full_name, wcslen( full_name ), &str )))
+    {
+        CALL( provider, 7, HRESULT (WINAPI *)( IInspectable *, HSTRING, IInspectable ** ) )( provider, str, &type );
+        WindowsDeleteString( str );
+    }
+    IInspectable_Release( provider );
+    return type;
+}
+
+/* ---- values from strings ---- */
+
+static const struct { const WCHAR *name; DWORD argb; } colors[] =
+{
+    { L"Transparent", 0x00ffffff }, { L"Black", 0xff000000 }, { L"White", 0xffffffff }, { L"Red", 0xffff0000 },
+    { L"Green", 0xff008000 }, { L"Lime", 0xff00ff00 }, { L"Blue", 0xff0000ff }, { L"Yellow", 0xffffff00 },
+    { L"Gray", 0xff808080 }, { L"LightGray", 0xffd3d3d3 }, { L"DarkGray", 0xffa9a9a9 }, { L"Orange", 0xffffa500 },
+    { L"Purple", 0xff800080 }, { L"Navy", 0xff000080 }, { L"Silver", 0xffc0c0c0 }, { L"Maroon", 0xff800000 },
+    { L"Teal", 0xff008080 }, { L"Aqua", 0xff00ffff }, { L"Cyan", 0xff00ffff }, { L"Fuchsia", 0xffff00ff },
+    { L"Magenta", 0xffff00ff }, { L"Olive", 0xff808000 }, { L"DimGray", 0xff696969 }, { L"WhiteSmoke", 0xfff5f5f5 },
+};
+
+static BOOL parse_color( const WCHAR *str, struct xcolor *color )
+{
+    unsigned int i;
+    DWORD argb;
+    WCHAR *end;
+    size_t len;
+
+    while (*str == ' ') str++;
+    if (*str == '#')
+    {
+        len = wcslen( str + 1 );
+        argb = wcstoul( str + 1, &end, 16 );
+        if (*end && *end != ' ') return FALSE;
+        if (len == 6) argb |= 0xff000000;
+        else if (len == 3) argb = 0xff000000 | ((argb & 0xf00) * 0x1100) | ((argb & 0xf0) * 0x110) | ((argb & 0xf) * 0x11);
+        else if (len != 8) return FALSE;
+    }
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(colors); i++) if (!wcsicmp( colors[i].name, str )) break;
+        if (i == ARRAY_SIZE(colors)) return FALSE;
+        argb = colors[i].argb;
+    }
+    color->a = argb >> 24; color->r = argb >> 16; color->g = argb >> 8; color->b = argb;
+    return TRUE;
+}
+
+/* up to four numbers separated by commas or spaces */
+static int parse_numbers( const WCHAR *str, DOUBLE *values, int max )
+{
+    int count = 0;
+    WCHAR *end;
+
+    while (count < max)
+    {
+        while (*str == ' ' || *str == ',') str++;
+        if (!*str) break;
+        values[count] = wcstod( str, &end );
+        if (end == str) return -1;
+        count++;
+        str = end;
+    }
+    while (*str == ' ' || *str == ',') str++;
+    return *str ? -1 : count;
+}
+
+static BOOL parse_thickness( const WCHAR *str, struct xthickness *t )
+{
+    DOUBLE v[4];
+
+    switch (parse_numbers( str, v, 4 ))
+    {
+    case 1: t->left = t->top = t->right = t->bottom = v[0]; return TRUE;
+    case 2: t->left = t->right = v[0]; t->top = t->bottom = v[1]; return TRUE;
+    case 4: t->left = v[0]; t->top = v[1]; t->right = v[2]; t->bottom = v[3]; return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL parse_corner( const WCHAR *str, struct xcorner *c )
+{
+    DOUBLE v[4];
+
+    switch (parse_numbers( str, v, 4 ))
+    {
+    case 1: c->top_left = c->top_right = c->bottom_right = c->bottom_left = v[0]; return TRUE;
+    case 4: c->top_left = v[0]; c->top_right = v[1]; c->bottom_right = v[2]; c->bottom_left = v[3]; return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL parse_grid_length( const WCHAR *str, struct xgrid_length *gl )
+{
+    WCHAR *end;
+
+    while (*str == ' ') str++;
+    if (!wcsicmp( str, L"Auto" )) { gl->value = 1; gl->unit = XGRID_AUTO; return TRUE; }
+    if (!wcscmp( str, L"*" )) { gl->value = 1; gl->unit = XGRID_STAR; return TRUE; }
+    gl->value = wcstod( str, &end );
+    if (end == str) return FALSE;
+    if (*end == '*') { gl->unit = XGRID_STAR; end++; }
+    else gl->unit = XGRID_PIXEL;
+    return !*end;
+}
+
+static const struct { const WCHAR *type; const GUID *iid; const WCHAR *names[8]; } enums[] =
+{
+    { L"Windows.UI.Xaml.HorizontalAlignment", &IID_IReference_HorizontalAlignment, { L"Left", L"Center", L"Right", L"Stretch" } },
+    { L"Windows.UI.Xaml.VerticalAlignment", &IID_IReference_VerticalAlignment, { L"Top", L"Center", L"Bottom", L"Stretch" } },
+    { L"Windows.UI.Xaml.Visibility", &IID_IReference_Visibility, { L"Visible", L"Collapsed" } },
+    { L"Windows.UI.Xaml.Controls.Orientation", &IID_IReference_Orientation, { L"Vertical", L"Horizontal" } },
+    { L"Windows.UI.Xaml.TextWrapping", &IID_IReference_TextWrapping, { L"", L"NoWrap", L"Wrap", L"WrapWholeWords" } },
+    { L"Windows.UI.Xaml.TextAlignment", &IID_IReference_TextAlignment, { L"Center", L"Left", L"Right", L"Justify", L"DetectFromContent" } },
+    { L"Windows.UI.Xaml.FlowDirection", &IID_IReference_FlowDirection, { L"LeftToRight", L"RightToLeft" } },
+    { L"Windows.UI.Xaml.ElementTheme", &IID_IReference_ElementTheme, { L"Default", L"Light", L"Dark" } },
+    { L"Windows.UI.Text.FontStyle", &IID_IReference_FontStyle, { L"Normal", L"Oblique", L"Italic" } },
+};
+
+static const struct { const WCHAR *name; UINT16 weight; } weights[] =
+{
+    { L"Thin", 100 }, { L"ExtraLight", 200 }, { L"Light", 300 }, { L"SemiLight", 350 }, { L"Normal", 400 },
+    { L"Medium", 500 }, { L"SemiBold", 600 }, { L"Bold", 700 }, { L"ExtraBold", 800 }, { L"Black", 900 },
+    { L"ExtraBlack", 950 },
+};
+
+/* a string converted to a value of the type named (a property's) */
+static HRESULT value_from_string( const WCHAR *type, const WCHAR *str, IInspectable **value )
+{
+    unsigned int i, j;
+    WCHAR *end;
+
+    *value = NULL;
+    if (!wcscmp( type, L"Double" ) || !wcscmp( type, L"Single" ))
+    {
+        DOUBLE d;
+        if (!wcsicmp( str, L"Auto" ) || !wcsicmp( str, L"NaN" )) d = NAN;
+        else if (!wcsicmp( str, L"Infinity" )) d = INFINITY;
+        else
+        {
+            d = wcstod( str, &end );
+            if (end == str || *end) return E_INVALIDARG;
+        }
+        *value = xbox_double( d );
+    }
+    else if (!wcscmp( type, L"Int32" ))
+    {
+        LONG n = wcstol( str, &end, 10 );
+        if (end == str || *end) return E_INVALIDARG;
+        *value = xbox_int32( n );
+    }
+    else if (!wcscmp( type, L"Boolean" ))
+    {
+        if (!wcsicmp( str, L"True" )) *value = xbox_boolean( TRUE );
+        else if (!wcsicmp( str, L"False" )) *value = xbox_boolean( FALSE );
+        else return E_INVALIDARG;
+    }
+    else if (!wcscmp( type, L"String" ) || !wcscmp( type, L"Object" )) *value = xbox_string( str );
+    else if (!wcscmp( type, L"Windows.UI.Xaml.Thickness" ))
+    {
+        struct xthickness t;
+        if (!parse_thickness( str, &t )) return E_INVALIDARG;
+        *value = xbox_ref( &IID_IReference_Thickness, &t, sizeof(t) );
+    }
+    else if (!wcscmp( type, L"Windows.UI.Xaml.CornerRadius" ))
+    {
+        struct xcorner c;
+        if (!parse_corner( str, &c )) return E_INVALIDARG;
+        *value = xbox_ref( &IID_IReference_CornerRadius, &c, sizeof(c) );
+    }
+    else if (!wcscmp( type, L"Windows.UI.Xaml.GridLength" ))
+    {
+        struct xgrid_length gl;
+        if (!parse_grid_length( str, &gl )) return E_INVALIDARG;
+        *value = xbox_ref( &IID_IReference_GridLength, &gl, sizeof(gl) );
+    }
+    else if (!wcscmp( type, L"Windows.UI.Xaml.Media.Brush" ))
+    {
+        struct xcolor color;
+        if (!parse_color( str, &color )) return E_INVALIDARG;
+        *value = xaml_solid_brush( color );
+    }
+    else if (!wcscmp( type, L"Windows.UI.Color" ))
+    {
+        struct xcolor color;
+        if (!parse_color( str, &color )) return E_INVALIDARG;
+        *value = xbox_ref( &IID_IReference_Color, &color, sizeof(color) );
+    }
+    else if (!wcscmp( type, L"Windows.UI.Xaml.Media.FontFamily" )) *value = xaml_font_family( str );
+    else if (!wcscmp( type, L"Windows.UI.Text.FontWeight" ))
+    {
+        UINT16 w = 0;
+        for (i = 0; i < ARRAY_SIZE(weights); i++) if (!wcsicmp( weights[i].name, str )) w = weights[i].weight;
+        if (!w && !(w = wcstoul( str, &end, 10 ))) return E_INVALIDARG;
+        *value = xbox_ref( &IID_IReference_FontWeight, &w, sizeof(w) );
+    }
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(enums); i++)
+        {
+            if (wcscmp( enums[i].type, type )) continue;
+            for (j = 0; j < ARRAY_SIZE(enums[i].names) && enums[i].names[j]; j++)
+            {
+                INT32 v = j;
+                if (!enums[i].names[j][0] || wcsicmp( enums[i].names[j], str )) continue;
+                *value = xbox_ref( enums[i].iid, &v, sizeof(v) );
+                return *value ? S_OK : E_OUTOFMEMORY;
+            }
+            return E_INVALIDARG;
+        }
+        FIXME( "no conversion of %s to %s\n", debugstr_w( str ), debugstr_w( type ) );
+        return E_NOTIMPL;
+    }
+    return *value ? S_OK : E_OUTOFMEMORY;
+}
+
+/* ---- the object writer ---- */
+
+struct xaml_writer
+{
+    IInspectable *root;         /* what the markup's root sets members on (LoadComponent: the component) */
+    IInspectable *component;    /* the component being loaded: its IComponentConnector, or NULL */
+    HRESULT error;
+};
+
+/* an application object's member, set from a string or an object */
+static HRESULT set_app_member( IInspectable *obj, IInspectable *type, const WCHAR *name, const WCHAR *str, IInspectable *value )
+{
+    IInspectable *member = NULL, *member_type = NULL, *boxed = NULL;
+    HSTRING hname, full = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &hname ))) return hr;
+    hr = CALL( type, XT_GetMember, HRESULT (WINAPI *)( IInspectable *, HSTRING, IInspectable ** ) )( type, hname, &member );
+    WindowsDeleteString( hname );
+    if (FAILED(hr) || !member) return FAILED(hr) ? hr : E_INVALIDARG;
+    if (str)
+    {
+        CALL( member, XM_Type, HRESULT (WINAPI *)( IInspectable *, IInspectable ** ) )( member, &member_type );
+        if (member_type) CALL( member_type, XT_FullName, HRESULT (WINAPI *)( IInspectable *, HSTRING * ) )( member_type, &full );
+        hr = value_from_string( full ? WindowsGetStringRawBuffer( full, NULL ) : L"String", str, &boxed );
+        WindowsDeleteString( full );
+        if (member_type) IInspectable_Release( member_type );
+        value = boxed;
+    }
+    if (SUCCEEDED(hr))
+        hr = CALL( member, XM_SetValue, HRESULT (WINAPI *)( IInspectable *, IInspectable *, IInspectable * ) )( member, obj, value );
+    if (boxed) IInspectable_Release( boxed );
+    IInspectable_Release( member );
+    return hr;
+}
+
+static HRESULT append_to_vector( IInspectable *vector, IInspectable *item )
+{
+    /* IVector<T>.Append: slot 13 whatever T is */
+    return CALL( vector, 13, HRESULT (WINAPI *)( IInspectable *, IInspectable * ) )( vector, item );
+}
+
+/* members of ours that are not properties: collections and the Border's child */
+static HRESULT set_special( IInspectable *obj, const WCHAR *name, IInspectable *value )
+{
+    IInspectable *iface = NULL, *collection = NULL;
+    HRESULT hr = E_INVALIDARG;
+    const GUID *iid = NULL;
+    int slot = 0;
+
+    if (!wcscmp( name, L"Children" )) { iid = &IID_IPanel; slot = IPanel_Children; }
+    else if (!wcscmp( name, L"RowDefinitions" )) { iid = &IID_IGrid; slot = IGrid_RowDefinitions; }
+    else if (!wcscmp( name, L"ColumnDefinitions" )) { iid = &IID_IGrid; slot = IGrid_ColumnDefinitions; }
+    else if (!wcscmp( name, L"Child" ))
+    {
+        if (FAILED(IInspectable_QueryInterface( obj, &IID_IBorder, (void **)&iface ))) return E_INVALIDARG;
+        hr = CALL( iface, IBorder_SetChild, HRESULT (WINAPI *)( IInspectable *, IInspectable * ) )( iface, value );
+        IInspectable_Release( iface );
+        return hr;
+    }
+    else return E_INVALIDARG;
+    if (FAILED(IInspectable_QueryInterface( obj, iid, (void **)&iface ))) return E_INVALIDARG;
+    hr = CALL( iface, slot, HRESULT (WINAPI *)( IInspectable *, IInspectable ** ) )( iface, &collection );
+    IInspectable_Release( iface );
+    if (FAILED(hr)) return hr;
+    hr = append_to_vector( collection, value );
+    IInspectable_Release( collection );
+    return hr;
+}
+
+/* sets a member of an object: from a string (str) or an object (value) */
+HRESULT xaml_writer_set( struct xaml_writer *writer, IInspectable *obj, const WCHAR *owner, const WCHAR *name,
+                         const WCHAR *str, IInspectable *value )
+{
+    const struct xtype *type = owner ? find_type( owner ) : type_of_object( obj );
+    struct xaml_property *prop = NULL;
+    struct dobj *d = dobj_from_inspectable( obj );
+    IInspectable *boxed = NULL;
+    HRESULT hr;
+
+    TRACE( "%p %s.%s = %s %p\n", obj, debugstr_w( owner ), debugstr_w( name ), debugstr_w( str ), value );
+#ifdef SG_MUTANT_MARKUP_NO_ATTACHED
+    if (owner) return S_OK;
+#endif
+    if (owner && !type)
+    {
+        FIXME( "attached member of an unknown owner %s.%s\n", debugstr_w( owner ), debugstr_w( name ) );
+        return S_OK;
+    }
+    if (type) prop = find_member( type, name );
+    if (prop && d)
+    {
+        if (str)
+        {
+            if (FAILED(hr = value_from_string( prop->type, str, &boxed )))
+            {
+                WARN( "%s: %s is not a %s\n", debugstr_w( name ), debugstr_w( str ), debugstr_w( prop->type ) );
+                return hr;
+            }
+            value = boxed;
+        }
+        hr = dobj_set_value( d, prop, value );
+        if (boxed) IInspectable_Release( boxed );
+        return hr;
+    }
+    if (value && SUCCEEDED(hr = set_special( obj, name, value ))) return hr;
+    if (!d || type_of_object( obj ) != type || !type)
+    {
+        /* the application's own members */
+        IInspectable *xtype = NULL;
+        HSTRING class_name = NULL;
+        if (SUCCEEDED(IInspectable_GetRuntimeClassName( obj, &class_name )) && class_name)
+        {
+            xtype = app_type( WindowsGetStringRawBuffer( class_name, NULL ) );
+            WindowsDeleteString( class_name );
+        }
+        if (xtype)
+        {
+            hr = set_app_member( obj, xtype, name, str, value );
+            IInspectable_Release( xtype );
+            return hr;
+        }
+    }
+    FIXME( "no member %s of %s\n", debugstr_w( name ), type ? debugstr_w( type->name ) : "(unknown)" );
+    return S_OK;   /* as Windows does for unknown members in loose markup: ignored here, not fatal */
+}
+
+/* the object of an element */
+HRESULT xaml_writer_create( struct xaml_writer *writer, const WCHAR *ns, const WCHAR *name, IInspectable **out )
+{
+    const struct xtype *type;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!ns || !wcscmp( ns, ns_presentation ))
+    {
+        if (!(type = find_type( name )))
+        {
+            FIXME( "no type %s yet\n", debugstr_w( name ) );
+            return E_NOTIMPL;
+        }
+        return create_ours( type, out );
+    }
+    if (!wcsncmp( ns, L"using:", 6 ))
+    {
+        WCHAR *full = malloc( (wcslen( ns + 6 ) + wcslen( name ) + 2) * sizeof(WCHAR) );
+        IInspectable *xtype;
+        if (!full) return E_OUTOFMEMORY;
+        swprintf( full, wcslen( ns + 6 ) + wcslen( name ) + 2, L"%s.%s", ns + 6, name );
+        xtype = app_type( full );
+        if (!xtype)
+        {
+            WARN( "no application type %s\n", debugstr_w( full ) );
+            free( full );
+            return E_INVALIDARG;
+        }
+        free( full );
+        hr = CALL( xtype, XT_ActivateInstance, HRESULT (WINAPI *)( IInspectable *, IInspectable ** ) )( xtype, out );
+        IInspectable_Release( xtype );
+        return hr;
+    }
+    FIXME( "namespace %s\n", debugstr_w( ns ) );
+    return E_NOTIMPL;
+}
+
+/* a child element's object goes to its parent's content property */
+HRESULT xaml_writer_add_content( struct xaml_writer *writer, IInspectable *parent, IInspectable *child )
+{
+    const struct xtype *type = type_of_object( parent );
+
+    if (type && type->content) return xaml_writer_set( writer, parent, NULL, type->content, NULL, child );
+    FIXME( "%p has no content property\n", parent );
+    return E_INVALIDARG;
+}
+
+HRESULT xaml_writer_add_text( struct xaml_writer *writer, IInspectable *parent, const WCHAR *text )
+{
+    const struct xtype *type = type_of_object( parent );
+
+    if (type && type->content) return xaml_writer_set( writer, parent, NULL, type->content, text, NULL );
+    return S_OK;
+}
+
+/* x:ConnectionId: the component gets the object (its named elements, its event handlers) */
+void xaml_writer_connect( struct xaml_writer *writer, INT32 id, IInspectable *obj )
+{
+    IInspectable *connector;
+
+    if (!writer->component) return;
+    if (FAILED(IInspectable_QueryInterface( writer->component, &IID_IComponentConnector_x, (void **)&connector ))) return;
+    CALL( connector, 6, HRESULT (WINAPI *)( IInspectable *, INT32, IInspectable * ) )( connector, id, obj );
+    IInspectable_Release( connector );
+}
+
+/* ---- XAML text ---- */
+
+struct text_state
+{
+    IXmlReader *reader;
+    struct xaml_writer *writer;
+    int depth;
+};
+
+static HRESULT read_element( struct text_state *state, IInspectable *existing, IInspectable **out );
+
+static BOOL ignorable( const WCHAR *ns )
+{
+    return !wcscmp( ns, ns_compat ) || !wcscmp( ns, L"http://schemas.microsoft.com/expression/blend/2008" ) ||
+           !wcscmp( ns, L"http://www.w3.org/2000/xmlns/" );
+}
+
+/* the element's attributes: members, x: directives */
+static HRESULT read_attributes( struct text_state *state, IInspectable *obj )
+{
+    const WCHAR *local, *ns, *value;
+    INT32 connection = -1;
+    HRESULT hr;
+
+    for (hr = IXmlReader_MoveToFirstAttribute( state->reader ); hr == S_OK; hr = IXmlReader_MoveToNextAttribute( state->reader ))
+    {
+        WCHAR *dot, *owner = NULL;
+        IXmlReader_GetLocalName( state->reader, &local, NULL );
+        IXmlReader_GetNamespaceUri( state->reader, &ns, NULL );
+        IXmlReader_GetValue( state->reader, &value, NULL );
+        if (!wcscmp( ns, ns_xaml ))
+        {
+            if (!wcscmp( local, L"Name" )) xaml_writer_set( state->writer, obj, NULL, L"Name", value, NULL );
+            else if (!wcscmp( local, L"ConnectionId" )) connection = wcstol( value, NULL, 10 );
+            continue;   /* x:Class, x:Key, x:Uid ... */
+        }
+        if (ignorable( ns ) || !wcscmp( local, L"xmlns" ) || IXmlReader_IsDefault( state->reader )) continue;
+        if (*ns && wcscmp( ns, ns_presentation ) && wcsncmp( ns, L"using:", 6 )) continue;
+        if ((dot = wcschr( local, '.' )))
+        {
+            if (!(owner = wcsdup( local ))) return E_OUTOFMEMORY;
+            owner[dot - local] = 0;
+            local = dot + 1;
+        }
+        if (owner)
+        {
+            hr = xaml_writer_set( state->writer, obj, owner, local, value, NULL );
+            free( owner );
+        }
+        else hr = xaml_writer_set( state->writer, obj, NULL, local, value, NULL );
+        if (FAILED(hr) && hr != E_NOTIMPL) return hr;
+    }
+    IXmlReader_MoveToElement( state->reader );
+    if (connection >= 0) xaml_writer_connect( state->writer, connection, obj );
+    return S_OK;
+}
+
+/* the content of an element: child elements, property elements, text */
+static HRESULT read_content( struct text_state *state, IInspectable *obj, const WCHAR *element_name )
+{
+    XmlNodeType type;
+    HRESULT hr;
+
+    while ((hr = IXmlReader_Read( state->reader, &type )) == S_OK)
+    {
+        if (type == XmlNodeType_EndElement) return S_OK;
+        if (type == XmlNodeType_Text || type == XmlNodeType_CDATA)
+        {
+            const WCHAR *text;
+            IXmlReader_GetValue( state->reader, &text, NULL );
+            if (FAILED(hr = xaml_writer_add_text( state->writer, obj, text ))) return hr;
+        }
+        else if (type == XmlNodeType_Element)
+        {
+            const WCHAR *local, *dot;
+            IXmlReader_GetLocalName( state->reader, &local, NULL );
+            if ((dot = wcschr( local, '.' )))
+            {
+                /* a property element: Owner.Member */
+                WCHAR *member = wcsdup( dot + 1 );
+                BOOL empty = IXmlReader_IsEmptyElement( state->reader );
+                if (!member) return E_OUTOFMEMORY;
+                while (!empty && (hr = IXmlReader_Read( state->reader, &type )) == S_OK && type != XmlNodeType_EndElement)
+                {
+                    IInspectable *child = NULL;
+                    if (type == XmlNodeType_Text)
+                    {
+                        const WCHAR *text;
+                        IXmlReader_GetValue( state->reader, &text, NULL );
+                        hr = xaml_writer_set( state->writer, obj, NULL, member, text, NULL );
+                    }
+                    else if (type == XmlNodeType_Element)
+                    {
+                        if (SUCCEEDED(hr = read_element( state, NULL, &child )) && child)
+                        {
+                            hr = xaml_writer_set( state->writer, obj, NULL, member, NULL, child );
+                            IInspectable_Release( child );
+                        }
+                        else if (hr == E_NOTIMPL) hr = S_OK;   /* not ours yet: skipped */
+                    }
+                    if (FAILED(hr)) break;
+                }
+                free( member );
+                if (FAILED(hr)) return hr;
+            }
+            else
+            {
+                IInspectable *child = NULL;
+                hr = read_element( state, NULL, &child );
+                if (hr == E_NOTIMPL) continue;   /* skipped */
+                if (FAILED(hr)) return hr;
+                hr = xaml_writer_add_content( state->writer, obj, child );
+                IInspectable_Release( child );
+                if (FAILED(hr)) return hr;
+            }
+        }
+    }
+    return FAILED(hr) ? hr : HRESULT_FROM_WIN32( ERROR_INVALID_DATA );   /* ended inside the element */
+}
+
+/* skips the element the reader is on */
+static HRESULT skip_element( struct text_state *state )
+{
+    XmlNodeType type;
+    int depth = 1;
+    HRESULT hr;
+
+    if (IXmlReader_IsEmptyElement( state->reader )) return S_OK;
+    while (depth && (hr = IXmlReader_Read( state->reader, &type )) == S_OK)
+    {
+        if (type == XmlNodeType_Element && !IXmlReader_IsEmptyElement( state->reader )) depth++;
+        else if (type == XmlNodeType_EndElement) depth--;
+    }
+    return depth ? E_FAIL : S_OK;
+}
+
+/* the reader is on an element's start: its object, made (or existing: a component's root) */
+static HRESULT read_element( struct text_state *state, IInspectable *existing, IInspectable **out )
+{
+    const WCHAR *local, *ns;
+    IInspectable *obj = NULL;
+    BOOL empty;
+    HRESULT hr;
+
+    if (++state->depth > 256)
+    {
+        state->depth--;
+        return E_INVALIDARG;   /* nested too deep */
+    }
+    IXmlReader_GetLocalName( state->reader, &local, NULL );
+    IXmlReader_GetNamespaceUri( state->reader, &ns, NULL );
+    empty = IXmlReader_IsEmptyElement( state->reader );
+    if (existing) IInspectable_AddRef( (obj = existing) );
+    else if (FAILED(hr = xaml_writer_create( state->writer, ns, local, &obj )))
+    {
+        if (hr == E_NOTIMPL) skip_element( state );
+        state->depth--;
+        return hr;
+    }
+    if (SUCCEEDED(hr = read_attributes( state, obj )) && !empty) hr = read_content( state, obj, local );
+    state->depth--;
+    if (FAILED(hr))
+    {
+        IInspectable_Release( obj );
+        return hr;
+    }
+    *out = obj;
+    return S_OK;
+}
+
+static HRESULT load_text( const char *data, size_t size, IInspectable *component, IInspectable **out )
+{
+    struct xaml_writer writer = { component, component };
+    struct text_state state = { NULL, &writer };
+    XmlNodeType type;
+    IStream *stream;
+    HGLOBAL mem;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, size ))) return E_OUTOFMEMORY;
+    memcpy( GlobalLock( mem ), data, size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, &stream )))
+    {
+        GlobalFree( mem );
+        return hr;
+    }
+    if (FAILED(hr = CreateXmlReader( &IID_IXmlReader, (void **)&state.reader, NULL )))
+    {
+        IStream_Release( stream );
+        return hr;
+    }
+    IXmlReader_SetProperty( state.reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    IXmlReader_SetInput( state.reader, (IUnknown *)stream );
+    while ((hr = IXmlReader_Read( state.reader, &type )) == S_OK && type != XmlNodeType_Element) ;
+    if (hr == S_OK) hr = read_element( &state, component, out );
+    else if (SUCCEEDED(hr)) hr = E_INVALIDARG;   /* no root element */
+    IXmlReader_Release( state.reader );
+    IStream_Release( stream );
+    TRACE( "loaded: hr %#lx, root %p\n", hr, *out );
+    return hr;
+}
+
+HRESULT xaml_load_text( const WCHAR *text, IInspectable *component, IInspectable **out )
+{
+    int len = WideCharToMultiByte( CP_UTF8, 0, text, -1, NULL, 0, NULL, NULL );
+    char *utf8;
+    HRESULT hr;
+
+    if (!(utf8 = malloc( len ))) return E_OUTOFMEMORY;
+    WideCharToMultiByte( CP_UTF8, 0, text, -1, utf8, len, NULL, NULL );
+    hr = load_text( utf8, len - 1, component, out );
+    free( utf8 );
+    return hr;
+}
+
+/* ---- Application.LoadComponent: ms-appx: markup of the application ---- */
+
+/* the application's folder: its package's, or its executable's */
+static WCHAR *app_folder(void)
+{
+    WCHAR *path = malloc( MAX_PATH * sizeof(WCHAR) ), *slash;
+    UINT32 len = MAX_PATH;
+
+    if (!path) return NULL;
+    if (GetCurrentPackagePath( &len, path ) == ERROR_SUCCESS) return path;
+    GetModuleFileNameW( NULL, path, MAX_PATH );
+    if ((slash = wcsrchr( path, '\\' ))) *slash = 0;
+    return path;
+}
+
+static char *read_file( const WCHAR *path, size_t *size )
+{
+    HANDLE file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    LARGE_INTEGER li;
+    char *data = NULL;
+    DWORD got;
+
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (GetFileSizeEx( file, &li ) && li.QuadPart < 64 * 1024 * 1024 && (data = malloc( li.QuadPart + 1 )))
+    {
+        if (!ReadFile( file, data, li.QuadPart, &got, NULL ) || got != li.QuadPart) { free( data ); data = NULL; }
+        else *size = got;
+    }
+    CloseHandle( file );
+    return data;
+}
+
+HRESULT xaml_load_component( IInspectable *component, IInspectable *locator )
+{
+    IUriRuntimeClass *uri = NULL;
+    HSTRING raw = NULL;
+    const WCHAR *str, *rel;
+    WCHAR *folder, *path;
+    IInspectable *root = NULL;
+    size_t size, len;
+    char *data;
+    HRESULT hr;
+
+    if (!component || !locator) return E_INVALIDARG;
+    if (FAILED(hr = IInspectable_QueryInterface( locator, &IID_IUriRuntimeClass_x, (void **)&uri ))) return hr;
+    IUriRuntimeClass_get_RawUri( uri, &raw );
+    IUriRuntimeClass_Release( uri );
+    str = WindowsGetStringRawBuffer( raw, NULL );
+    TRACE( "%p %s\n", component, debugstr_w( str ) );
+    if (wcsnicmp( str, L"ms-appx:///", 11 ))
+    {
+        FIXME( "%s\n", debugstr_w( str ) );
+        WindowsDeleteString( raw );
+        return E_INVALIDARG;
+    }
+    rel = str + 11;
+    if (!(folder = app_folder()) || !(path = malloc( (wcslen( folder ) + wcslen( rel ) + 2) * sizeof(WCHAR) )))
+    {
+        free( folder );
+        WindowsDeleteString( raw );
+        return E_OUTOFMEMORY;
+    }
+    swprintf( path, wcslen( folder ) + wcslen( rel ) + 2, L"%s\\%s", folder, rel );
+    for (len = wcslen( folder ) + 1; path[len]; len++) if (path[len] == '/') path[len] = '\\';
+    free( folder );
+    WindowsDeleteString( raw );
+    if ((data = read_file( path, &size )))
+    {
+        /* XAML text */
+        hr = load_text( data, size, component, &root );
+        free( data );
+    }
+    else
+    {
+        FIXME( "no markup at %s (compiled XAML comes later)\n", debugstr_w( path ) );
+        hr = S_OK;
+    }
+    free( path );
+    if (root) IInspectable_Release( root );
+    return hr;
+}
+
+/* ---- XamlReader ---- */
+
+static HRESULT WINAPI reader_statics_Load( struct xfiface *iface, HSTRING xaml, IInspectable **result )
+{
+    if (!result) return E_POINTER;
+    return xaml_load_text( WindowsGetStringRawBuffer( xaml, NULL ), NULL, result );
+}
+
+static const void *reader_statics_vtbl[] = { XFIFACE_COMMON, reader_statics_Load, reader_statics_Load };
+
+static struct xfactory reader_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Markup.XamlReader",
+    { &IID_IXamlReaderStatics_x },
+    { { reader_statics_vtbl } },
+};
+
+IActivationFactory *xaml_reader_factory = &reader_factory_obj.IActivationFactory_iface;
