From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] urlmon: RegisterMediaTypeClass, FindMediaTypeClass

RegisterMediaTypeClass keeps media type to CLSID overrides on the bind context (an object parameter; a later registration of a type replaces the earlier one). FindMediaTypeClass returns the bind context's override, else the CLSID the MIME database registers for the type. A binding that creates the object for its data's MIME type uses the override first, as the documentation describes. They were spec stubs; urlmon.h gains their prototypes.
---
--- a/include/urlmon.idl
+++ b/include/urlmon.idl
@@ -2240,6 +2240,8 @@
 cpp_quote("HRESULT WINAPI GetSoftwareUpdateInfo( LPCWSTR szDistUnit, LPSOFTDISTINFO psdi);")
 cpp_quote("HRESULT WINAPI FaultInIEFeature(HWND,uCLSSPEC*,QUERYCONTEXT*,DWORD);")
 cpp_quote("HRESULT WINAPI FindMimeFromData(LPBC,LPCWSTR,LPVOID,DWORD,LPCWSTR,DWORD,LPWSTR*,DWORD);")
+cpp_quote("HRESULT WINAPI RegisterMediaTypeClass(LPBC,UINT,LPCSTR*,CLSID*,DWORD);")
+cpp_quote("HRESULT WINAPI FindMediaTypeClass(LPBC,LPCSTR,CLSID*,DWORD);")
 cpp_quote("HRESULT WINAPI GetClassFileOrMime(LPBC,LPCWSTR,LPVOID,DWORD,LPCWSTR,DWORD,CLSID*);")
 cpp_quote("HRESULT WINAPI HlinkGoBack(IUnknown*);")
 cpp_quote("HRESULT WINAPI HlinkGoForward(IUnknown*);")
--- a/dlls/urlmon/urlmon_main.h
+++ b/dlls/urlmon/urlmon_main.h
@@ -76,6 +76,7 @@
 HRESULT find_mime_from_ext(const WCHAR*,WCHAR**);
 
 HRESULT bind_to_storage(IUri*,IBindCtx*,REFIID,void**);
+BOOL find_media_class_override(IBindCtx*,const WCHAR*,CLSID*);
 HRESULT bind_to_object(IMoniker*,IUri*,IBindCtx*,REFIID,void**ppv);
 
 HRESULT create_default_callback(IBindStatusCallback**);
--- a/dlls/urlmon/urlmon_main.c
+++ b/dlls/urlmon/urlmon_main.c
@@ -999,6 +999,179 @@
    return S_OK;
 }
 
+#ifndef SG_MUTANT_NO_MEDIACLASS
+/* (wine-sg 8249) Media type to CLSID overrides of a bind context (RegisterMediaTypeClass): kept on the bind
+ * context as an object parameter, consulted by FindMediaTypeClass and when a binding creates the object for
+ * the data's MIME type. */
+struct media_class_map
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    UINT count;
+    struct { WCHAR *type; CLSID clsid; } *entries;
+};
+
+static const WCHAR media_class_keyW[] = L"_SG_MediaTypeClassMap";
+
+static inline struct media_class_map *impl_from_media_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct media_class_map, IUnknown_iface);
+}
+
+static HRESULT WINAPI media_class_map_QueryInterface(IUnknown *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        IUnknown_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI media_class_map_AddRef(IUnknown *iface)
+{
+    return InterlockedIncrement(&impl_from_media_IUnknown(iface)->ref);
+}
+
+static ULONG WINAPI media_class_map_Release(IUnknown *iface)
+{
+    struct media_class_map *map = impl_from_media_IUnknown(iface);
+    LONG ref = InterlockedDecrement(&map->ref);
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < map->count; i++) free(map->entries[i].type);
+        free(map->entries);
+        free(map);
+    }
+    return ref;
+}
+
+static const IUnknownVtbl media_class_map_vtbl =
+{
+    media_class_map_QueryInterface,
+    media_class_map_AddRef,
+    media_class_map_Release,
+};
+
+static struct media_class_map *get_media_class_map(IBindCtx *bctx)
+{
+    IUnknown *unk;
+
+    if (!bctx || FAILED(IBindCtx_GetObjectParam(bctx, (WCHAR *)media_class_keyW, &unk))) return NULL;
+    if (unk->lpVtbl != &media_class_map_vtbl)
+    {
+        IUnknown_Release(unk);
+        return NULL;
+    }
+    return impl_from_media_IUnknown(unk);
+}
+
+/* the override a bind context has for a MIME type, if any */
+BOOL find_media_class_override(IBindCtx *bctx, const WCHAR *mime, CLSID *clsid)
+{
+    struct media_class_map *map;
+    BOOL ret = FALSE;
+    UINT i;
+
+    if (!mime || !(map = get_media_class_map(bctx))) return FALSE;
+    for (i = 0; i < map->count; i++)
+        if (!wcsicmp(map->entries[i].type, mime))
+        {
+            *clsid = map->entries[i].clsid;
+            ret = TRUE;
+            break;
+        }
+    IUnknown_Release(&map->IUnknown_iface);
+    return ret;
+}
+
+/***********************************************************************
+ *            RegisterMediaTypeClass (URLMON.@)
+ */
+HRESULT WINAPI RegisterMediaTypeClass(IBindCtx *bctx, UINT count, const char **types, CLSID *clsids, DWORD reserved)
+{
+    struct media_class_map *map;
+    BOOL created = FALSE;
+    HRESULT hr = S_OK;
+    UINT i, j;
+
+    TRACE("%p %u %p %p %#lx\n", bctx, count, types, clsids, reserved);
+
+    if (!bctx || !count || !types || !clsids) return E_INVALIDARG;
+    for (i = 0; i < count; i++) if (!types[i]) return E_INVALIDARG;
+
+    if (!(map = get_media_class_map(bctx)))
+    {
+        if (!(map = calloc(1, sizeof(*map)))) return E_OUTOFMEMORY;
+        map->IUnknown_iface.lpVtbl = &media_class_map_vtbl;
+        map->ref = 1;
+        created = TRUE;
+    }
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, types[i], -1, NULL, 0);
+        WCHAR *type = malloc(len * sizeof(WCHAR));
+        void *grown;
+
+        if (!type) { hr = E_OUTOFMEMORY; break; }
+        MultiByteToWideChar(CP_ACP, 0, types[i], -1, type, len);
+        for (j = 0; j < map->count; j++)
+            if (!wcsicmp(map->entries[j].type, type)) break;
+        if (j < map->count)
+        {
+            /* a later registration of the same type replaces the earlier one */
+            free(type);
+            map->entries[j].clsid = clsids[i];
+            continue;
+        }
+        if (!(grown = realloc(map->entries, (map->count + 1) * sizeof(*map->entries))))
+        {
+            free(type);
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        map->entries = grown;
+        map->entries[map->count].type = type;
+        map->entries[map->count].clsid = clsids[i];
+        map->count++;
+    }
+    if (SUCCEEDED(hr) && created) hr = IBindCtx_RegisterObjectParam(bctx, (WCHAR *)media_class_keyW, &map->IUnknown_iface);
+    IUnknown_Release(&map->IUnknown_iface);
+    return hr;
+}
+
+/***********************************************************************
+ *            FindMediaTypeClass (URLMON.@)
+ *
+ * The bind context's override for the media type, else the CLSID the MIME database registers for it.
+ */
+HRESULT WINAPI FindMediaTypeClass(IBindCtx *bctx, const char *type, CLSID *clsid, DWORD reserved)
+{
+    WCHAR typeW[256], key[300], value[64];
+    DWORD size = sizeof(value);
+
+    TRACE("%p %s %p %#lx\n", bctx, debugstr_a(type), clsid, reserved);
+
+    if (!type || !clsid) return E_INVALIDARG;
+    *clsid = CLSID_NULL;
+    if (!MultiByteToWideChar(CP_ACP, 0, type, -1, typeW, ARRAY_SIZE(typeW))) return E_INVALIDARG;
+    if (find_media_class_override(bctx, typeW, clsid)) return S_OK;
+    swprintf(key, ARRAY_SIZE(key), L"MIME\\Database\\Content Type\\%s", typeW);
+    if (!RegGetValueW(HKEY_CLASSES_ROOT, key, L"CLSID", RRF_RT_REG_SZ, NULL, value, &size) &&
+        SUCCEEDED(CLSIDFromString(value, clsid)))
+        return S_OK;
+    return REGDB_E_CLASSNOTREG;
+}
+#else
+BOOL find_media_class_override(IBindCtx *bctx, const WCHAR *mime, CLSID *clsid) { return FALSE; }
+HRESULT WINAPI RegisterMediaTypeClass(IBindCtx *bctx, UINT count, const char **types, CLSID *clsids, DWORD reserved) { return E_NOTIMPL; }
+HRESULT WINAPI FindMediaTypeClass(IBindCtx *bctx, const char *type, CLSID *clsid, DWORD reserved) { return E_NOTIMPL; }
+#endif
+
 /***********************************************************************
  *            ShouldShowIntranetWarningSecband
  *    Undocumented, added in IE7
--- a/dlls/urlmon/binding.c
+++ b/dlls/urlmon/binding.c
@@ -299,7 +299,13 @@
         return;
     }
 
-    if((clsid_str = get_mime_clsid(binding->mime, &clsid)))
+    /* the bind context's RegisterMediaTypeClass override comes first (wine-sg 8249) */
+    if(find_media_class_override(binding->bctx, binding->mime, &clsid)) {
+        if((clsid_str = malloc(39 * sizeof(WCHAR))))
+            StringFromGUID2(&clsid, clsid_str, 39);
+    }else
+        clsid_str = get_mime_clsid(binding->mime, &clsid);
+    if(clsid_str)
         IBindStatusCallback_OnProgress(binding->callback, 0, 0, BINDSTATUS_CLASSIDAVAILABLE, clsid_str);
 
     IBindStatusCallback_OnProgress(binding->callback, 0, 0, BINDSTATUS_BEGINSYNCOPERATION, NULL);
