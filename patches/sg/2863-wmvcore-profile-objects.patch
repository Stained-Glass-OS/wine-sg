+
+/* The Windows Media Format SDK string getters: a NULL buffer returns the
+ * length needed, in characters including the terminator; a short buffer
+ * returns that length with ASF_E_BUFFERTOOSMALL. */
+HRESULT wm_get_string(const WCHAR *str, WCHAR *out, DWORD *len)
+{
+    DWORD length = str ? wcslen(str) : 0;
+    DWORD size = length + 1;
+
+    if (!len)
+        return E_INVALIDARG;
+
+#ifdef SG_MUTANT_WMVW_STRLEN
+    size--;
+#endif
+    if (!out)
+    {
+        *len = size;
+        return S_OK;
+    }
+    if (*len < size)
+    {
+        *len = size;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    if (length)
+        memcpy(out, str, length * sizeof(WCHAR));
+    out[length] = 0;
+    *len = size;
+    return S_OK;
+}
+
+HRESULT wm_get_string_word(const WCHAR *str, WCHAR *out, WORD *len)
+{
+    DWORD size;
+    HRESULT hr;
+
+    if (!len)
+        return E_INVALIDARG;
+    size = *len;
+    hr = wm_get_string(str, out, &size);
+    if (hr == S_OK || hr == ASF_E_BUFFERTOOSMALL)
+        *len = min(size, 0xffff);
+    return hr;
+}
+
+static HRESULT set_string(WCHAR **dst, const WCHAR *src, size_t max)
+{
+    WCHAR *copy;
+
+    if (!src || wcslen(src) + 1 > max)
+        return E_INVALIDARG;
+    if (!(copy = wcsdup(src)))
+        return E_OUTOFMEMORY;
+    free(*dst);
+    *dst = copy;
+    return S_OK;
+}
+
+HRESULT wm_copy_media_type(const WM_MEDIA_TYPE *src, WM_MEDIA_TYPE *mt, DWORD *size)
+{
+    const DWORD req_size = *size;
+
+    *size = sizeof(*mt) + src->cbFormat;
+    if (!mt)
+        return S_OK;
+    if (req_size < *size)
+        return ASF_E_BUFFERTOOSMALL;
+
+    memcpy(mt, src, sizeof(*mt));
+    if (src->cbFormat)
+        memcpy(mt + 1, src->pbFormat, src->cbFormat);
+    mt->pbFormat = src->cbFormat ? (BYTE *)(mt + 1) : NULL;
+    mt->pUnk = NULL;
+    return S_OK;
+}
+
+HRESULT wm_dup_media_type(const WM_MEDIA_TYPE *src, WM_MEDIA_TYPE **out)
+{
+    WM_MEDIA_TYPE *mt;
+
+    if (!(mt = calloc(1, sizeof(*mt))))
+        return E_OUTOFMEMORY;
+    *mt = *src;
+    mt->pUnk = NULL;
+    mt->pbFormat = NULL;
+    if (src->cbFormat)
+    {
+        if (!src->pbFormat || !(mt->pbFormat = malloc(src->cbFormat)))
+        {
+            free(mt);
+            return src->pbFormat ? E_OUTOFMEMORY : E_INVALIDARG;
+        }
+        memcpy(mt->pbFormat, src->pbFormat, src->cbFormat);
+    }
+    *out = mt;
+    return S_OK;
+}
+
+void wm_free_media_type(WM_MEDIA_TYPE *mt)
+{
+    if (!mt)
+        return;
+    free(mt->pbFormat);
+    free(mt);
+}
+
+/* The editable properties of a stream, as held by a profile and by the
+ * IWMStreamConfig objects handed out of it. */
+struct stream_rec
+{
+    WORD number;
+    GUID type;
+    WCHAR *name, *connection;
+    DWORD bitrate, window;
+    BOOL window_set;
+    WM_MEDIA_TYPE *mt;
+};
+
+static void rec_clear(struct stream_rec *rec)
+{
+    free(rec->name);
+    free(rec->connection);
+    wm_free_media_type(rec->mt);
+    memset(rec, 0, sizeof(*rec));
+}
+
+static HRESULT rec_copy(struct stream_rec *dst, const struct stream_rec *src)
+{
+    struct stream_rec tmp = *src;
+    HRESULT hr = E_OUTOFMEMORY;
+
+    tmp.name = tmp.connection = NULL;
+    tmp.mt = NULL;
+    if ((src->name && !(tmp.name = wcsdup(src->name)))
+            || (src->connection && !(tmp.connection = wcsdup(src->connection))))
+        goto fail;
+    if (src->mt && FAILED(hr = wm_dup_media_type(src->mt, &tmp.mt)))
+        goto fail;
+    *dst = tmp;
+    return S_OK;
+
+fail:
+    rec_clear(&tmp);
+    return hr;
+}
+
+/* Lists of stream numbers: the shared part of mutual exclusions and
+ * bandwidth sharing objects. */
+struct stream_list
+{
+    WORD *numbers;
+    WORD count;
+};
+
+static HRESULT stream_list_get(const struct stream_list *list, WORD *array, WORD *count)
+{
+    if (!count)
+        return E_INVALIDARG;
+    if (!array)
+    {
+        *count = list->count;
+        return S_OK;
+    }
+    if (*count < list->count)
+    {
+        *count = list->count;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    if (list->count)
+        memcpy(array, list->numbers, list->count * sizeof(*array));
+    *count = list->count;
+    return S_OK;
+}
+
+static HRESULT stream_list_add(struct stream_list *list, WORD number)
+{
+    WORD *numbers;
+    unsigned int i;
+
+    if (!number || number > MAX_PROFILE_STREAM)
+        return E_INVALIDARG;
+#ifndef SG_MUTANT_WMVW_LISTDUP
+    for (i = 0; i < list->count; ++i)
+    {
+        if (list->numbers[i] == number)
+            return NS_E_INVALID_STREAM;
+    }
+#endif
+    if (!(numbers = realloc(list->numbers, (list->count + 1) * sizeof(*numbers))))
+        return E_OUTOFMEMORY;
+    list->numbers = numbers;
+    list->numbers[list->count++] = number;
+    return S_OK;
+}
+
+static HRESULT stream_list_remove(struct stream_list *list, WORD number)
+{
+    unsigned int i;
+
+    for (i = 0; i < list->count; ++i)
+    {
+        if (list->numbers[i] != number)
+            continue;
+        memmove(&list->numbers[i], &list->numbers[i + 1], (list->count - i - 1) * sizeof(*list->numbers));
+        --list->count;
+        return S_OK;
+    }
+    return NS_E_INVALID_STREAM;
+}
