+
+static HRESULT profile_add_rec(struct profile *profile, const struct stream_rec *src)
+{
+    struct stream_rec *streams;
+    HRESULT hr;
+
+    if (!src->number || src->number > MAX_PROFILE_STREAM)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&profile->cs);
+#ifndef SG_MUTANT_WMVW_ADDDUP
+    if (profile_find(profile, src->number))
+    {
+        LeaveCriticalSection(&profile->cs);
+        return NS_E_INVALID_STREAM;
+    }
+#endif
+    if (!(streams = realloc(profile->streams, (profile->stream_count + 1) * sizeof(*streams))))
+    {
+        LeaveCriticalSection(&profile->cs);
+        return E_OUTOFMEMORY;
+    }
+    profile->streams = streams;
+    if (SUCCEEDED(hr = rec_copy(&streams[profile->stream_count], src)))
+        ++profile->stream_count;
+    LeaveCriticalSection(&profile->cs);
+    return hr;
+}
+
+static HRESULT WINAPI profile_AddStream(IWMProfile3 *iface, IWMStreamConfig *config)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    struct stream_rec rec;
+    HRESULT hr;
+
+    TRACE("iface %p, config %p.\n", iface, config);
+
+    if (!config)
+        return E_INVALIDARG;
+    if (FAILED(hr = rec_from_config(config, &rec)))
+        return hr;
+    hr = profile_add_rec(profile, &rec);
+    rec_clear(&rec);
+    return hr;
+}
+
+static HRESULT WINAPI profile_ReconfigStream(IWMProfile3 *iface, IWMStreamConfig *config)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    struct stream_rec rec, *old;
+    HRESULT hr;
+
+    TRACE("iface %p, config %p.\n", iface, config);
+
+    if (!config)
+        return E_INVALIDARG;
+    if (FAILED(hr = rec_from_config(config, &rec)))
+        return hr;
+
+    EnterCriticalSection(&profile->cs);
+    if (!(old = profile_find(profile, rec.number)))
+        hr = NS_E_NO_STREAM;
+#ifndef SG_MUTANT_WMVW_NORECONFIG
+    else
+    {
+        /* The type of a stream cannot change. */
+        rec.type = old->type;
+        rec_clear(old);
+        *old = rec;
+        memset(&rec, 0, sizeof(rec));
+    }
+#endif
+    LeaveCriticalSection(&profile->cs);
+    rec_clear(&rec);
+    return hr;
+}
+
+static HRESULT WINAPI profile_CreateNewStream(IWMProfile3 *iface, REFGUID type, IWMStreamConfig **config)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    struct stream_rec rec = {0};
+    WORD number;
+    HRESULT hr;
+
+    TRACE("iface %p, type %s, config %p.\n", iface, debugstr_guid(type), config);
+
+    if (!type || !config || IsEqualGUID(type, &null_guid))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&profile->cs);
+    /* The new stream gets the lowest number not in use. */
+    for (number = 1; number <= MAX_PROFILE_STREAM; ++number)
+    {
+#ifdef SG_MUTANT_WMVW_NEWNUM
+        if (number == 1)
+            continue;
+#endif
+        if (!profile_find(profile, number))
+            break;
+    }
+    LeaveCriticalSection(&profile->cs);
+    if (number > MAX_PROFILE_STREAM)
+        return E_FAIL;
+
+    rec.number = number;
+    rec.type = *type;
+    hr = config_create(&rec, config);
+    return hr;
+}
+
+static HRESULT WINAPI profile_GetMutualExclusionCount(IWMProfile3 *iface, DWORD *count)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    *count = profile->mutex_count;
+    LeaveCriticalSection(&profile->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetMutualExclusion(IWMProfile3 *iface, DWORD index, IWMMutualExclusion **excl)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, index %lu, excl %p.\n", iface, index, excl);
+
+    if (!excl)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    if (index >= profile->mutex_count)
+        hr = E_INVALIDARG;
+    else
+    {
+        *excl = profile->mutexes[index];
+        IWMMutualExclusion_AddRef(*excl);
+    }
+    LeaveCriticalSection(&profile->cs);
+    return hr;
+}
+
+static HRESULT WINAPI profile_RemoveMutualExclusion(IWMProfile3 *iface, IWMMutualExclusion *excl)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    unsigned int i;
+
+    TRACE("iface %p, excl %p.\n", iface, excl);
+
+    if (!excl)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    for (i = 0; i < profile->mutex_count; ++i)
+    {
+        if (profile->mutexes[i] != excl)
+            continue;
+        memmove(&profile->mutexes[i], &profile->mutexes[i + 1],
+                (profile->mutex_count - i - 1) * sizeof(*profile->mutexes));
+        --profile->mutex_count;
+        LeaveCriticalSection(&profile->cs);
+        IWMMutualExclusion_Release(excl);
+        return S_OK;
+    }
+    LeaveCriticalSection(&profile->cs);
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI profile_AddMutualExclusion(IWMProfile3 *iface, IWMMutualExclusion *excl)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    IWMMutualExclusion **mutexes;
+
+    TRACE("iface %p, excl %p.\n", iface, excl);
+
+    if (!excl)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    if (!(mutexes = realloc(profile->mutexes, (profile->mutex_count + 1) * sizeof(*mutexes))))
+    {
+        LeaveCriticalSection(&profile->cs);
+        return E_OUTOFMEMORY;
+    }
+    profile->mutexes = mutexes;
+    IWMMutualExclusion_AddRef(excl);
+    profile->mutexes[profile->mutex_count++] = excl;
+    LeaveCriticalSection(&profile->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_CreateNewMutualExclusion(IWMProfile3 *iface, IWMMutualExclusion **excl)
+{
+    TRACE("iface %p, excl %p.\n", iface, excl);
+
+    if (!excl)
+        return E_INVALIDARG;
+    return mutex_create(excl);
+}
+
+static HRESULT WINAPI profile_GetProfileID(IWMProfile3 *iface, GUID *id)
+{
+    TRACE("iface %p, id %p.\n", iface, id);
+
+    if (!id)
+        return E_INVALIDARG;
+    /* A profile made here is not one of the system profiles. */
+    *id = null_guid;
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetStorageFormat(IWMProfile3 *iface, WMT_STORAGE_FORMAT *format)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("iface %p, format %p.\n", iface, format);
+
+    if (!format)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    *format = profile->storage;
+    LeaveCriticalSection(&profile->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_SetStorageFormat(IWMProfile3 *iface, WMT_STORAGE_FORMAT format)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("iface %p, format %#x.\n", iface, format);
+
+    if (format != WMT_Storage_Format_MP3 && format != WMT_Storage_Format_V1)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    profile->storage = format;
+    LeaveCriticalSection(&profile->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_GetBandwidthSharingCount(IWMProfile3 *iface, DWORD *count)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    *count = profile->sharing_count;
+    LeaveCriticalSection(&profile->cs);
