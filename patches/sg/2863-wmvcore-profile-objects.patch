+}
+
+static HRESULT WINAPI profile_GetBandwidthSharing(IWMProfile3 *iface, DWORD index, IWMBandwidthSharing **sharing)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, index %lu, sharing %p.\n", iface, index, sharing);
+
+    if (!sharing)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    if (index >= profile->sharing_count)
+        hr = E_INVALIDARG;
+    else
+    {
+        *sharing = profile->sharings[index];
+        IWMBandwidthSharing_AddRef(*sharing);
+    }
+    LeaveCriticalSection(&profile->cs);
+    return hr;
+}
+
+static HRESULT WINAPI profile_RemoveBandwidthSharing(IWMProfile3 *iface, IWMBandwidthSharing *sharing)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    unsigned int i;
+
+    TRACE("iface %p, sharing %p.\n", iface, sharing);
+
+    if (!sharing)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    for (i = 0; i < profile->sharing_count; ++i)
+    {
+        if (profile->sharings[i] != sharing)
+            continue;
+        memmove(&profile->sharings[i], &profile->sharings[i + 1],
+                (profile->sharing_count - i - 1) * sizeof(*profile->sharings));
+        --profile->sharing_count;
+        LeaveCriticalSection(&profile->cs);
+        IWMBandwidthSharing_Release(sharing);
+        return S_OK;
+    }
+    LeaveCriticalSection(&profile->cs);
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI profile_AddBandwidthSharing(IWMProfile3 *iface, IWMBandwidthSharing *sharing)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    IWMBandwidthSharing **sharings;
+
+    TRACE("iface %p, sharing %p.\n", iface, sharing);
+
+    if (!sharing)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    if (!(sharings = realloc(profile->sharings, (profile->sharing_count + 1) * sizeof(*sharings))))
+    {
+        LeaveCriticalSection(&profile->cs);
+        return E_OUTOFMEMORY;
+    }
+    profile->sharings = sharings;
+    IWMBandwidthSharing_AddRef(sharing);
+    profile->sharings[profile->sharing_count++] = sharing;
+    LeaveCriticalSection(&profile->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_CreateNewBandwidthSharing(IWMProfile3 *iface, IWMBandwidthSharing **sharing)
+{
+    TRACE("iface %p, sharing %p.\n", iface, sharing);
+
+    if (!sharing)
+        return E_INVALIDARG;
+    return sharing_create(sharing);
+}
+
+static HRESULT WINAPI profile_GetStreamPrioritization(IWMProfile3 *iface, IWMStreamPrioritization **stream)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, stream %p.\n", iface, stream);
+
+    if (!stream)
+        return E_INVALIDARG;
+    EnterCriticalSection(&profile->cs);
+    if ((*stream = profile->priorities))
+        IWMStreamPrioritization_AddRef(*stream);
+    else
+        hr = S_FALSE;
+    LeaveCriticalSection(&profile->cs);
+    return hr;
+}
+
+static HRESULT WINAPI profile_SetStreamPrioritization(IWMProfile3 *iface, IWMStreamPrioritization *stream)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    IWMStreamPrioritization *old;
+
+    TRACE("iface %p, stream %p.\n", iface, stream);
+
+    if (!stream)
+        return E_INVALIDARG;
+    IWMStreamPrioritization_AddRef(stream);
+    EnterCriticalSection(&profile->cs);
+    old = profile->priorities;
+    profile->priorities = stream;
+    LeaveCriticalSection(&profile->cs);
+    if (old)
+        IWMStreamPrioritization_Release(old);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_RemoveStreamPrioritization(IWMProfile3 *iface)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    IWMStreamPrioritization *old;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&profile->cs);
+    old = profile->priorities;
+    profile->priorities = NULL;
+    LeaveCriticalSection(&profile->cs);
+    if (old)
+        IWMStreamPrioritization_Release(old);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_CreateNewStreamPrioritization(IWMProfile3 *iface, IWMStreamPrioritization **stream)
+{
+    TRACE("iface %p, stream %p.\n", iface, stream);
+
+    if (!stream)
+        return E_INVALIDARG;
+    return priorities_create(stream);
+}
+
+static HRESULT WINAPI profile_GetExpectedPacketCount(IWMProfile3 *iface, QWORD duration, QWORD *count)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    double bytes = 0;
+    unsigned int i;
+
+    TRACE("iface %p, duration %s, count %p.\n", iface, wine_dbgstr_longlong(duration), count);
+
+    if (!count)
+        return E_INVALIDARG;
+
+    /* The bytes the streams' bitrates produce over the duration, in packets
+     * of the usual packet size of a file. */
+    EnterCriticalSection(&profile->cs);
+    for (i = 0; i < profile->stream_count; ++i)
+        bytes += profile->streams[i].bitrate / 8.0 * (duration / 10000000.0);
+    LeaveCriticalSection(&profile->cs);
+
+    *count = (QWORD)ceil(bytes / PROFILE_PACKET_SIZE);
+    return S_OK;
+}
+
+static const IWMProfile3Vtbl profile_vtbl =
+{
+    profile_QueryInterface,
+    profile_AddRef,
+    profile_Release,
+    profile_GetVersion,
+    profile_GetName,
+    profile_SetName,
+    profile_GetDescription,
+    profile_SetDescription,
+    profile_GetStreamCount,
+    profile_GetStream,
+    profile_GetStreamByNumber,
+    profile_RemoveStream,
+    profile_RemoveStreamByNumber,
+    profile_AddStream,
+    profile_ReconfigStream,
+    profile_CreateNewStream,
+    profile_GetMutualExclusionCount,
+    profile_GetMutualExclusion,
+    profile_RemoveMutualExclusion,
+    profile_AddMutualExclusion,
+    profile_CreateNewMutualExclusion,
+    profile_GetProfileID,
+    profile_GetStorageFormat,
+    profile_SetStorageFormat,
+    profile_GetBandwidthSharingCount,
+    profile_GetBandwidthSharing,
+    profile_RemoveBandwidthSharing,
+    profile_AddBandwidthSharing,
+    profile_CreateNewBandwidthSharing,
+    profile_GetStreamPrioritization,
+    profile_SetStreamPrioritization,
+    profile_RemoveStreamPrioritization,
+    profile_CreateNewStreamPrioritization,
+    profile_GetExpectedPacketCount,
+};
+
+HRESULT profile_create(WMT_VERSION version, IWMProfile3 **out)
+{
+    struct profile *profile;
+
+    if (!(profile = calloc(1, sizeof(*profile))))
+        return E_OUTOFMEMORY;
+    profile->IWMProfile3_iface.lpVtbl = &profile_vtbl;
+    profile->refcount = 1;
+    InitializeCriticalSectionEx(&profile->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    profile->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": profile.cs");
+    profile->version = version;
+    profile->storage = WMT_Storage_Format_V1;
+    *out = &profile->IWMProfile3_iface;
+    return S_OK;
+}
+
+static HRESULT read_profile_string(IWMProfile *src, BOOL description, WCHAR **out)
+{
+    DWORD len = 0;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = description ? IWMProfile_GetDescription(src, NULL, &len) : IWMProfile_GetName(src, NULL, &len);
+    if (FAILED(hr) || len <= 1)
+        return S_OK;
+    if (!(*out = malloc(len * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    hr = description ? IWMProfile_GetDescription(src, *out, &len) : IWMProfile_GetName(src, *out, &len);
+    if (FAILED(hr))
+    {
+        free(*out);
+        *out = NULL;
+    }
+    return hr;
+}
+
+static HRESULT clone_list(IWMStreamList *src, IWMStreamList *dst)
+{
+    WORD *numbers, count = 0, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMStreamList_GetStreams(src, NULL, &count)) || !count)
+        return hr;
+    if (!(numbers = malloc(count * sizeof(*numbers))))
+        return E_OUTOFMEMORY;
+    if (SUCCEEDED(hr = IWMStreamList_GetStreams(src, numbers, &count)))
+    {
+        for (i = 0; i < count && SUCCEEDED(hr); ++i)
+            hr = IWMStreamList_AddStream(dst, numbers[i]);
+    }
+    free(numbers);
+    return hr;
+}
+
+HRESULT profile_clone(IWMProfile *src, IWMProfile3 **out)
+{
+    IWMProfile3 *src3 = NULL, *dst;
+    struct profile *profile;
+    WMT_VERSION version;
+    DWORD count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IWMProfile_GetVersion(src, &version)))
+        return hr;
+    if (FAILED(hr = profile_create(version, &dst)))
+        return hr;
+    profile = impl_from_IWMProfile3(dst);
+    IWMProfile_QueryInterface(src, &IID_IWMProfile3, (void **)&src3);
+
+    if (FAILED(hr = read_profile_string(src, FALSE, &profile->name))
+            || FAILED(hr = read_profile_string(src, TRUE, &profile->description)))
+        goto fail;
+    if (src3)
+        IWMProfile3_GetStorageFormat(src3, &profile->storage);
+
+    if (FAILED(hr = IWMProfile_GetStreamCount(src, &count)))
+        goto fail;
+    for (i = 0; i < count; ++i)
+    {
+        IWMStreamConfig *config;
+        struct stream_rec rec;
+
+        if (FAILED(hr = IWMProfile_GetStream(src, i, &config)))
+            goto fail;
+        hr = rec_from_config(config, &rec);
+        IWMStreamConfig_Release(config);
+        if (FAILED(hr))
+            goto fail;
+        hr = profile_add_rec(profile, &rec);
+        rec_clear(&rec);
+        if (FAILED(hr))
+            goto fail;
+    }
+
+    if (SUCCEEDED(IWMProfile_GetMutualExclusionCount(src, &count)))
+    {
+        for (i = 0; i < count; ++i)
+        {
+            IWMMutualExclusion *from, *to;
+            GUID type;
+
+            if (FAILED(hr = IWMProfile_GetMutualExclusion(src, i, &from)))
+                goto fail;
+            if (SUCCEEDED(hr = mutex_create(&to)))
+            {
+                if (SUCCEEDED(hr = IWMMutualExclusion_GetType(from, &type)))
+                    hr = IWMMutualExclusion_SetType(to, &type);
+                if (SUCCEEDED(hr))
+                    hr = clone_list((IWMStreamList *)from, (IWMStreamList *)to);
+                if (SUCCEEDED(hr))
+                    hr = IWMProfile3_AddMutualExclusion(dst, to);
+                IWMMutualExclusion_Release(to);
+            }
+            IWMMutualExclusion_Release(from);
+            if (FAILED(hr))
+                goto fail;
+        }
+    }
+
+    if (src3 && SUCCEEDED(IWMProfile3_GetBandwidthSharingCount(src3, &count)))
+    {
+        for (i = 0; i < count; ++i)
+        {
+            IWMBandwidthSharing *from, *to;
+            DWORD bitrate, buffer;
+            GUID type;
+
+            if (FAILED(hr = IWMProfile3_GetBandwidthSharing(src3, i, &from)))
+                goto fail;
+            if (SUCCEEDED(hr = sharing_create(&to)))
+            {
+                if (SUCCEEDED(hr = IWMBandwidthSharing_GetType(from, &type)))
+                    hr = IWMBandwidthSharing_SetType(to, &type);
+                if (SUCCEEDED(hr) && SUCCEEDED(hr = IWMBandwidthSharing_GetBandwidth(from, &bitrate, &buffer)))
+                    hr = IWMBandwidthSharing_SetBandwidth(to, bitrate, buffer);
+                if (SUCCEEDED(hr))
+                    hr = clone_list((IWMStreamList *)from, (IWMStreamList *)to);
+                if (SUCCEEDED(hr))
+                    hr = IWMProfile3_AddBandwidthSharing(dst, to);
+                IWMBandwidthSharing_Release(to);
+            }
+            IWMBandwidthSharing_Release(from);
+            if (FAILED(hr))
+                goto fail;
+        }
+    }
+
+    if (src3)
+    {
+        IWMStreamPrioritization *from;
+
+        if (IWMProfile3_GetStreamPrioritization(src3, &from) == S_OK)
+        {
+            IWMStreamPrioritization *to;
+            WM_STREAM_PRIORITY_RECORD *records = NULL;
+            WORD n = 0;
+
+            hr = IWMStreamPrioritization_GetPriorityRecords(from, NULL, &n);
+            if (SUCCEEDED(hr) && n && !(records = malloc(n * sizeof(*records))))
+                hr = E_OUTOFMEMORY;
+            if (SUCCEEDED(hr) && n)
+                hr = IWMStreamPrioritization_GetPriorityRecords(from, records, &n);
+            if (SUCCEEDED(hr) && SUCCEEDED(hr = priorities_create(&to)))
+            {
+                if (SUCCEEDED(hr = IWMStreamPrioritization_SetPriorityRecords(to, records, n)))
+                    hr = IWMProfile3_SetStreamPrioritization(dst, to);
+                IWMStreamPrioritization_Release(to);
+            }
+            free(records);
+            IWMStreamPrioritization_Release(from);
+            if (FAILED(hr))
+                goto fail;
+        }
+    }
+
+    if (src3)
+        IWMProfile3_Release(src3);
+    *out = dst;
+    return S_OK;
+
+fail:
+    if (src3)
+        IWMProfile3_Release(src3);
+    IWMProfile3_Release(dst);
+    return hr;
+}
