+/* IWMStreamConfig and IWMMediaProps of one
+ * stream: a private copy of the stream's record. Changes reach the profile
+ * through IWMProfile::ReconfigStream or AddStream only. */
+struct stream_config
+{
+    IWMStreamConfig IWMStreamConfig_iface;
