+/* WMMUTEX_Unknown and WMBandwidthSharing_Exclusive: the types of a freshly
+ * created object. The types are otherwise opaque and stored as given. */
+static const GUID mutex_type_unknown = {0xd6e22a03, 0x35da, 0x11d1, {0x90, 0x34, 0x00, 0xa0, 0xc9, 0x03, 0x49, 0xbe}};
+static const GUID sharing_type_exclusive = {0xaf6060aa, 0x5197, 0x11d2, {0xb6, 0xaf, 0x00, 0xc0, 0x4f, 0xd9, 0x08, 0xe9}};
+
+struct mutual_exclusion
+{
+    IWMMutualExclusion IWMMutualExclusion_iface;
+    LONG refcount;
+    GUID type;
+    struct stream_list list;
+};
+
+static struct mutual_exclusion *impl_from_IWMMutualExclusion(IWMMutualExclusion *iface)
+{
+    return CONTAINING_RECORD(iface, struct mutual_exclusion, IWMMutualExclusion_iface);
+}
+
+static HRESULT WINAPI mutex_QueryInterface(IWMMutualExclusion *iface, REFIID iid, void **out)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMStreamList)
+            || IsEqualGUID(iid, &IID_IWMMutualExclusion))
+        *out = &mutex->IWMMutualExclusion_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI mutex_AddRef(IWMMutualExclusion *iface)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+    return InterlockedIncrement(&mutex->refcount);
+}
+
+static ULONG WINAPI mutex_Release(IWMMutualExclusion *iface)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+    ULONG refcount = InterlockedDecrement(&mutex->refcount);
+
+    if (!refcount)
+    {
+        free(mutex->list.numbers);
+        free(mutex);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI mutex_GetStreams(IWMMutualExclusion *iface, WORD *numbers, WORD *count)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+
+    TRACE("iface %p, numbers %p, count %p.\n", iface, numbers, count);
+
+    return stream_list_get(&mutex->list, numbers, count);
+}
+
+static HRESULT WINAPI mutex_AddStream(IWMMutualExclusion *iface, WORD number)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+
+    TRACE("iface %p, number %u.\n", iface, number);
+
+    return stream_list_add(&mutex->list, number);
+}
+
+static HRESULT WINAPI mutex_RemoveStream(IWMMutualExclusion *iface, WORD number)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+
+    TRACE("iface %p, number %u.\n", iface, number);
+
+    return stream_list_remove(&mutex->list, number);
+}
+
+static HRESULT WINAPI mutex_GetType(IWMMutualExclusion *iface, GUID *type)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+
+    TRACE("iface %p, type %p.\n", iface, type);
+
+    if (!type)
+        return E_INVALIDARG;
+    *type = mutex->type;
+    return S_OK;
+}
+
+static HRESULT WINAPI mutex_SetType(IWMMutualExclusion *iface, REFGUID type)
+{
+    struct mutual_exclusion *mutex = impl_from_IWMMutualExclusion(iface);
+
+    TRACE("iface %p, type %s.\n", iface, debugstr_guid(type));
+
+    if (!type)
+        return E_INVALIDARG;
+    mutex->type = *type;
+    return S_OK;
+}
+
+static const IWMMutualExclusionVtbl mutex_vtbl =
+{
+    mutex_QueryInterface,
+    mutex_AddRef,
+    mutex_Release,
+    mutex_GetStreams,
+    mutex_AddStream,
+    mutex_RemoveStream,
+    mutex_GetType,
+    mutex_SetType,
+};
+
+static HRESULT mutex_create(IWMMutualExclusion **out)
+{
+    struct mutual_exclusion *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IWMMutualExclusion_iface.lpVtbl = &mutex_vtbl;
+    object->refcount = 1;
+    object->type = mutex_type_unknown;
+    *out = &object->IWMMutualExclusion_iface;
+    return S_OK;
+}
