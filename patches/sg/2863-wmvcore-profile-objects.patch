+struct stream_priorities
+{
+    IWMStreamPrioritization IWMStreamPrioritization_iface;
+    LONG refcount;
+    WM_STREAM_PRIORITY_RECORD *records;
+    WORD count;
+};
+
+static struct stream_priorities *impl_from_IWMStreamPrioritization(IWMStreamPrioritization *iface)
+{
+    return CONTAINING_RECORD(iface, struct stream_priorities, IWMStreamPrioritization_iface);
+}
+
+static HRESULT WINAPI priorities_QueryInterface(IWMStreamPrioritization *iface, REFIID iid, void **out)
+{
+    struct stream_priorities *priorities = impl_from_IWMStreamPrioritization(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMStreamPrioritization))
+        *out = &priorities->IWMStreamPrioritization_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI priorities_AddRef(IWMStreamPrioritization *iface)
+{
+    struct stream_priorities *priorities = impl_from_IWMStreamPrioritization(iface);
+    return InterlockedIncrement(&priorities->refcount);
+}
+
+static ULONG WINAPI priorities_Release(IWMStreamPrioritization *iface)
+{
+    struct stream_priorities *priorities = impl_from_IWMStreamPrioritization(iface);
+    ULONG refcount = InterlockedDecrement(&priorities->refcount);
+
+    if (!refcount)
+    {
+        free(priorities->records);
+        free(priorities);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI priorities_GetPriorityRecords(IWMStreamPrioritization *iface,
+        WM_STREAM_PRIORITY_RECORD *array, WORD *count)
+{
+    struct stream_priorities *priorities = impl_from_IWMStreamPrioritization(iface);
+
+    TRACE("iface %p, array %p, count %p.\n", iface, array, count);
+
+    if (!count)
+        return E_INVALIDARG;
+    if (!array)
+    {
+        *count = priorities->count;
+        return S_OK;
+    }
+    if (*count < priorities->count)
+    {
+        *count = priorities->count;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    if (priorities->count)
+        memcpy(array, priorities->records, priorities->count * sizeof(*array));
+    *count = priorities->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI priorities_SetPriorityRecords(IWMStreamPrioritization *iface,
+        WM_STREAM_PRIORITY_RECORD *array, WORD count)
+{
+    struct stream_priorities *priorities = impl_from_IWMStreamPrioritization(iface);
+    WM_STREAM_PRIORITY_RECORD *records = NULL;
+    unsigned int i, j;
+
+    TRACE("iface %p, array %p, count %u.\n", iface, array, count);
+
+    if (count && !array)
+        return E_INVALIDARG;
+    for (i = 0; i < count; ++i)
+    {
+        if (!array[i].wStreamNumber || array[i].wStreamNumber > MAX_PROFILE_STREAM)
+            return E_INVALIDARG;
+        for (j = 0; j < i; ++j)
+        {
+            if (array[j].wStreamNumber == array[i].wStreamNumber)
+                return E_INVALIDARG;
+        }
+    }
+
+    if (count)
+    {
+        if (!(records = malloc(count * sizeof(*records))))
+            return E_OUTOFMEMORY;
+        memcpy(records, array, count * sizeof(*records));
+    }
+    free(priorities->records);
+    priorities->records = records;
+    priorities->count = count;
+    return S_OK;
+}
+
+static const IWMStreamPrioritizationVtbl priorities_vtbl =
+{
+    priorities_QueryInterface,
+    priorities_AddRef,
+    priorities_Release,
+    priorities_GetPriorityRecords,
+    priorities_SetPriorityRecords,
+};
+
+static HRESULT priorities_create(IWMStreamPrioritization **out)
+{
+    struct stream_priorities *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IWMStreamPrioritization_iface.lpVtbl = &priorities_vtbl;
+    object->refcount = 1;
+    *out = &object->IWMStreamPrioritization_iface;
+    return S_OK;
+}
