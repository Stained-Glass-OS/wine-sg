+static HRESULT WINAPI stream_props_GetMediaType(IWMMediaProps *iface, WM_MEDIA_TYPE *mt, DWORD *size)
+{
+    struct stream_config *config = impl_from_IWMMediaProps(iface);
+    WM_MEDIA_TYPE empty = {0};
+
+    TRACE("iface %p, mt %p, size %p.\n", iface, mt, size);
+
+    if (!size)
+        return E_INVALIDARG;
+    if (config->rec.mt)
+        return wm_copy_media_type(config->rec.mt, mt, size);
+
+    /* Nothing was set: only the major type is known. */
+    empty.majortype = config->rec.type;
+    return wm_copy_media_type(&empty, mt, size);
+}
+
+static HRESULT WINAPI stream_props_SetMediaType(IWMMediaProps *iface, WM_MEDIA_TYPE *mt)
+{
+    struct stream_config *config = impl_from_IWMMediaProps(iface);
+    WM_MEDIA_TYPE *copy;
+    HRESULT hr;
+
+    TRACE("iface %p, mt %p.\n", iface, mt);
+
+    if (!mt || (mt->cbFormat && !mt->pbFormat))
+        return E_INVALIDARG;
+    if (!IsEqualGUID(&config->rec.type, &mt->majortype))
+        return E_INVALIDARG;
+    if (FAILED(hr = wm_dup_media_type(mt, &copy)))
+        return hr;
+
+    wm_free_media_type(config->rec.mt);
+    config->rec.mt = copy;
+    return S_OK;
+}
