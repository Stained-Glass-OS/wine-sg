+static HRESULT config_create(const struct stream_rec *rec, IWMStreamConfig **out)
+{
+    struct stream_config *object;
+    HRESULT hr;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IWMStreamConfig_iface.lpVtbl = &stream_config_vtbl;
+    object->IWMMediaProps_iface.lpVtbl = &stream_props_vtbl;
+    object->refcount = 1;
+    if (FAILED(hr = rec_copy(&object->rec, rec)))
+    {
+        free(object);
+        return hr;
+    }
+    *out = &object->IWMStreamConfig_iface;
+    return S_OK;
+}
+
+/* Reads the record of any stream configuration object through its interfaces. */
+static HRESULT rec_from_config(IWMStreamConfig *config, struct stream_rec *rec)
+{
+    IWMMediaProps *props;
+    WORD len;
+    DWORD size;
+    HRESULT hr;
+
+    memset(rec, 0, sizeof(*rec));
+    if (FAILED(hr = IWMStreamConfig_GetStreamType(config, &rec->type))
+            || FAILED(hr = IWMStreamConfig_GetStreamNumber(config, &rec->number))
+            || FAILED(hr = IWMStreamConfig_GetBitrate(config, &rec->bitrate))
+            || FAILED(hr = IWMStreamConfig_GetBufferWindow(config, &rec->window)))
+        return hr;
+    rec->window_set = rec->window != ~0u;
+
+    len = 0;
+    if (SUCCEEDED(hr = IWMStreamConfig_GetStreamName(config, NULL, &len)) && len > 1)
+    {
+        if (!(rec->name = malloc(len * sizeof(WCHAR))))
+            goto oom;
+        if (FAILED(hr = IWMStreamConfig_GetStreamName(config, rec->name, &len)))
+            goto fail;
+    }
+    len = 0;
+    if (SUCCEEDED(hr = IWMStreamConfig_GetConnectionName(config, NULL, &len)) && len > 1)
+    {
+        if (!(rec->connection = malloc(len * sizeof(WCHAR))))
+            goto oom;
+        if (FAILED(hr = IWMStreamConfig_GetConnectionName(config, rec->connection, &len)))
+            goto fail;
+    }
+
+    if (SUCCEEDED(IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props)))
+    {
+        WM_MEDIA_TYPE *buffer;
+
+        size = 0;
+        hr = IWMMediaProps_GetMediaType(props, NULL, &size);
+        if (SUCCEEDED(hr) && size >= sizeof(WM_MEDIA_TYPE))
+        {
+            if (!(buffer = malloc(size)))
+            {
+                IWMMediaProps_Release(props);
+                goto oom;
+            }
+            if (SUCCEEDED(hr = IWMMediaProps_GetMediaType(props, buffer, &size))
+                    && (!IsEqualGUID(&buffer->subtype, &null_guid) || buffer->cbFormat))
+                hr = wm_dup_media_type(buffer, &rec->mt);
+            free(buffer);
+        }
+        IWMMediaProps_Release(props);
+        if (FAILED(hr))
+            goto fail;
+    }
+
+    return S_OK;
+
+oom:
+    hr = E_OUTOFMEMORY;
+fail:
+    rec_clear(rec);
+    return hr;
+}
+
+struct profile
+{
+    IWMProfile3 IWMProfile3_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+
+    WMT_VERSION version;
+    WMT_STORAGE_FORMAT storage;
+    WCHAR *name, *description;
+    struct stream_rec *streams;
+    unsigned int stream_count;
+    IWMMutualExclusion **mutexes;
+    unsigned int mutex_count;
+    IWMBandwidthSharing **sharings;
+    unsigned int sharing_count;
+    IWMStreamPrioritization *priorities;
+};
+
+static struct profile *impl_from_IWMProfile3(IWMProfile3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct profile, IWMProfile3_iface);
+}
+
+static struct stream_rec *profile_find(struct profile *profile, WORD number)
+{
+    unsigned int i;
+
+    for (i = 0; i < profile->stream_count; ++i)
+    {
+        if (profile->streams[i].number == number)
+            return &profile->streams[i];
+    }
+    return NULL;
+}
+
+static void profile_forget_stream(struct profile *profile, WORD number)
+{
+    unsigned int i;
+
+    for (i = 0; i < profile->mutex_count; ++i)
+        IWMMutualExclusion_RemoveStream(profile->mutexes[i], number);
+    for (i = 0; i < profile->sharing_count; ++i)
+        IWMBandwidthSharing_RemoveStream(profile->sharings[i], number);
+}
+
+static HRESULT profile_remove_stream(struct profile *profile, WORD number)
+{
+    struct stream_rec *rec;
+
+    EnterCriticalSection(&profile->cs);
+    if (!(rec = profile_find(profile, number)))
+    {
+        LeaveCriticalSection(&profile->cs);
+        return NS_E_NO_STREAM;
+    }
+#ifndef SG_MUTANT_WMVW_REMOVE
+    rec_clear(rec);
+    memmove(rec, rec + 1, (&profile->streams[profile->stream_count] - (rec + 1)) * sizeof(*rec));
+    --profile->stream_count;
+    profile_forget_stream(profile, number);
+#endif
+    LeaveCriticalSection(&profile->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI profile_QueryInterface(IWMProfile3 *iface, REFIID iid, void **out)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+
+    TRACE("profile %p, iid %s, out %p.\n", profile, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWMProfile)
+            || IsEqualGUID(iid, &IID_IWMProfile2) || IsEqualGUID(iid, &IID_IWMProfile3))
+        *out = &profile->IWMProfile3_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI profile_AddRef(IWMProfile3 *iface)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    return InterlockedIncrement(&profile->refcount);
+}
+
+static ULONG WINAPI profile_Release(IWMProfile3 *iface)
+{
+    struct profile *profile = impl_from_IWMProfile3(iface);
+    ULONG refcount = InterlockedDecrement(&profile->refcount);
+    unsigned int i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < profile->stream_count; ++i)
+            rec_clear(&profile->streams[i]);
+        free(profile->streams);
+        for (i = 0; i < profile->mutex_count; ++i)
+            IWMMutualExclusion_Release(profile->mutexes[i]);
+        free(profile->mutexes);
+        for (i = 0; i < profile->sharing_count; ++i)
+            IWMBandwidthSharing_Release(profile->sharings[i]);
+        free(profile->sharings);
+        if (profile->priorities)
+            IWMStreamPrioritization_Release(profile->priorities);
+        free(profile->name);
+        free(profile->description);
+        profile->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&profile->cs);
+        free(profile);
+    }
+    return refcount;
+}
