 static HRESULT WINAPI IDPLobbySPImpl_EnumSessionsResponse( IDPLobbySP *iface,
         SPDATA_ENUMSESSIONSRESPONSE *er )
 {
   IDPLobbySPImpl *This = impl_from_IDPLobbySP( iface );
-  FIXME( "(%p)->(%p):stub\n", This, er );
+  DPMSG_ENUMSESSIONSREPLY *reply;
+  DWORD size, nameSize;
+  static const DWORD header = 0;
+
+  TRACE( "(%p)->(%p)\n", This, er );
+
+  if( !DPLSP_Valid( er, er ? er->dwSize : 0, sizeof( *er ) ) || !er->lpsd ||
+      er->lpsd->dwSize != sizeof( DPSESSIONDESC2 ) )
+    return DPERR_INVALIDPARAMS;
+
+  nameSize = ( er->lpsd->lpszSessionName ? wcslen( er->lpsd->lpszSessionName ) : 0 ) + 1;
+  size = sizeof( *reply ) + nameSize * sizeof( WCHAR );
+
+  reply = calloc( 1, size );
+  if( !reply )
+    return DPERR_OUTOFMEMORY;
+
+  reply->envelope.dwMagic    = DPMSGMAGIC_DPLAYMSG;
+  reply->envelope.wCommandId = DPMSGCMD_ENUMSESSIONSREPLY;
+  reply->envelope.wVersion   = DPMSGVER_DP6;
+  reply->sd                  = *er->lpsd;
+  if( er->lpsd->lpszSessionName )
+    wcscpy( (WCHAR *)( reply + 1 ), er->lpsd->lpszSessionName );
+
+  EnterCriticalSection( &This->dplay->lock );
+#ifndef SG_MUTANT_LSP_ENUMRESP
+  NS_AddRemoteComputerAsNameServer( &header, sizeof( header ), reply, size,
+                                    This->dplay->dp2->lpNameServerData );
+#endif
+  LeaveCriticalSection( &This->dplay->lock );
+
+  free( reply );
+
   return DP_OK;
 }
 
