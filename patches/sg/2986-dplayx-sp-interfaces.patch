 }
 
 static HRESULT WINAPI IDirectPlaySPImpl_EnumAddress( IDirectPlaySP *iface,
@@ -148,11 +347,41 @@ static HRESULT WINAPI IDirectPlaySPImpl_EnumMRUEntries( IDirectPlaySP *iface, LP
         LPCWSTR lpKey, LPENUMMRUCALLBACK lpEnumMRUCallback, void *lpContext )
 {
   IDirectPlaySPImpl *This = impl_from_IDirectPlaySP( iface );
+  struct DPSPMRUEntry *entries;
+  DWORD count, i;
+  HKEY hkey;
+
+  TRACE( "(%p)->(%s,%s,%p,%p)\n",
+         This, debugstr_w( lpSection ), debugstr_w( lpKey ), lpEnumMRUCallback, lpContext );
+
+  if( !lpSection || !lpEnumMRUCallback )
+    return DPERR_INVALIDPARAMS;
 
-  /* Should be able to call the comctl32 undocumented MRU routines.
-     I suspect that the interface works appropriately */
-  FIXME( "(%p)->(%p,%p,%p,%p): stub\n",
-         This, lpSection, lpKey, lpEnumMRUCallback, lpContext );
+  /* No list yet: nothing to enumerate */
+  hkey = DPSP_OpenMRUKey( lpSection, lpKey, FALSE );
+  if( !hkey )
+    return DP_OK;
+
+  entries = calloc( DPSP_MRU_LIMIT, sizeof( *entries ) );
+  if( !entries )
+  {
+    RegCloseKey( hkey );
+    return DPERR_OUTOFMEMORY;
+  }
+
+  count = DPSP_ReadMRU( hkey, entries );
+  RegCloseKey( hkey );
+
+  /* Newest first, until the callback says it has had enough */
+  for( i = 0; i < count; i++ )
+  {
+    if( !lpEnumMRUCallback( entries[ i ].data, entries[ i ].size, lpContext ) )
+      break;
+  }
+
+  for( i = 0; i < count; i++ )
+    free( entries[ i ].data );
+  free( entries );
 
   return DP_OK;
 }
