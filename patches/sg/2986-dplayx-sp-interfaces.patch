+/* A most-recently-used list is kept in the registry of the user, under
+ * HKEY_CURRENT_USER\<section>\<key>: the entry "0" is the newest one, the
+ * entries are binary values. */
+#define DPSP_MRU_LIMIT 256
+
+static HKEY DPSP_OpenMRUKey( LPCWSTR section, LPCWSTR key, BOOL create )
+{
+  WCHAR *path;
+  HKEY hkey = NULL;
+  size_t len = wcslen( section ) + ( key ? wcslen( key ) + 1 : 0 ) + 1;
+
+  path = malloc( len * sizeof( WCHAR ) );
+  if( !path )
+    return NULL;
+
+  wcscpy( path, section );
+  if( key )
+  {
+    wcscat( path, L"\\" );
+    wcscat( path, key );
+  }
+
+  if( create )
+  {
+    if( RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_READ | KEY_WRITE, NULL, &hkey,
+                         NULL ) != ERROR_SUCCESS )
+      hkey = NULL;
+  }
+  else if( RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &hkey ) != ERROR_SUCCESS )
+    hkey = NULL;
+
+  free( path );
+
+  return hkey;
+}
+
+struct DPSPMRUEntry
+{
+  void *data;
+  DWORD size;
+};
+
+/* Reads entries 0, 1, ... (up to the limit) */
+static DWORD DPSP_ReadMRU( HKEY hkey, struct DPSPMRUEntry *entries )
+{
+  DWORD count = 0;
+
+  while( count < DPSP_MRU_LIMIT )
+  {
+    WCHAR name[ 16 ];
+    DWORD size = 0, type;
+
+    swprintf( name, ARRAY_SIZE( name ), L"%lu", count );
+
+    if( RegQueryValueExW( hkey, name, NULL, &type, NULL, &size ) != ERROR_SUCCESS ||
+        type != REG_BINARY )
+      break;
+
+    entries[ count ].data = malloc( size ? size : 1 );
+    entries[ count ].size = size;
+    if( !entries[ count ].data ||
+        RegQueryValueExW( hkey, name, NULL, &type, entries[ count ].data, &size ) != ERROR_SUCCESS )
+    {
+      free( entries[ count ].data );
+      break;
+    }
+
+    count++;
+  }
+
+  return count;
+}
+
 static HRESULT WINAPI IDirectPlaySPImpl_AddMRUEntry( IDirectPlaySP *iface, LPCWSTR lpSection,
         LPCWSTR lpKey, const void *lpData, DWORD dwDataSize, DWORD dwMaxEntries )
 {
   IDirectPlaySPImpl *This = impl_from_IDirectPlaySP( iface );
+  struct DPSPMRUEntry *entries;
+  DWORD count, i, j, kept = 0;
+  HRESULT hr = DP_OK;
+  HKEY hkey;
 
-  /* Should be able to call the comctl32 undocumented MRU routines.
-     I suspect that the interface works appropriately */
-  FIXME( "(%p)->(%p,%p%p,0x%08lx,0x%08lx): stub\n",
-         This, lpSection, lpKey, lpData, dwDataSize, dwMaxEntries );
+  TRACE( "(%p)->(%s,%s,%p,0x%08lx,0x%08lx)\n",
+         This, debugstr_w( lpSection ), debugstr_w( lpKey ), lpData, dwDataSize, dwMaxEntries );
 
-  return DP_OK;
+  if( !lpSection || !lpData || !dwDataSize || !dwMaxEntries )
+    return DPERR_INVALIDPARAMS;
+
+  if( dwMaxEntries > DPSP_MRU_LIMIT )
+    dwMaxEntries = DPSP_MRU_LIMIT;
+#ifdef SG_MUTANT_SP_MRUMAX
+  dwMaxEntries = DPSP_MRU_LIMIT;
+#endif
+
+  hkey = DPSP_OpenMRUKey( lpSection, lpKey, TRUE );
+  if( !hkey )
+    return DPERR_GENERIC;
+
+  entries = calloc( DPSP_MRU_LIMIT + 1, sizeof( *entries ) );
+  if( !entries )
+  {
+    RegCloseKey( hkey );
+    return DPERR_OUTOFMEMORY;
+  }
+
+  /* The new entry first, then the old ones without a copy of it */
+  entries[ 0 ].data = (void *) lpData;
+  entries[ 0 ].size = dwDataSize;
+  kept = 1;
+
+  count = DPSP_ReadMRU( hkey, entries + 1 ) + 1;
+
+  for( i = 1; i < count; i++ )
+  {
+#ifdef SG_MUTANT_SP_MRUDUP
+    if( 0 )
+#else
+    if( entries[ i ].size == dwDataSize && !memcmp( entries[ i ].data, lpData, dwDataSize ) )
+#endif
+    {
+      free( entries[ i ].data );
+      continue;
+    }
+
+    if( kept >= dwMaxEntries )
+    {
+      free( entries[ i ].data );
+      continue;
+    }
+
+    entries[ kept++ ] = entries[ i ];
+  }
+
+#ifdef SG_MUTANT_SP_MRUORDER
+  if( kept > 1 )
+  {
+    struct DPSPMRUEntry tmp = entries[ 0 ];
+    entries[ 0 ] = entries[ kept - 1 ];
+    entries[ kept - 1 ] = tmp;
+  }
+#endif
+  for( i = 0; i < kept; i++ )
+  {
+    WCHAR name[ 16 ];
+
+    swprintf( name, ARRAY_SIZE( name ), L"%lu", i );
+    if( RegSetValueExW( hkey, name, 0, REG_BINARY, entries[ i ].data, entries[ i ].size ) !=
+        ERROR_SUCCESS )
+      hr = DPERR_GENERIC;
+  }
+
+  /* Entries that no longer belong to the list */
+  for( j = kept; j < DPSP_MRU_LIMIT; j++ )
+  {
+    WCHAR name[ 16 ];
+
+    swprintf( name, ARRAY_SIZE( name ), L"%lu", j );
+    if( RegDeleteValueW( hkey, name ) != ERROR_SUCCESS )
+      break;
+  }
+
+  for( i = 1; i < kept; i++ )
+    free( entries[ i ].data );
+  free( entries );
+  RegCloseKey( hkey );
+
+  return hr;
+}
+
+/* Both elements of an address are chosen by the provider; it may use the
+ * Unicode address types as well as the ANSI ones */
+static BOOL DPSP_UsesUnicodeAddress( const DPCOMPOUNDADDRESSELEMENT *elements, DWORD count )
+{
+  DWORD i;
+
+  for( i = 0; i < count; i++ )
+  {
+    if( IsEqualGUID( &elements[ i ].guidDataType, &DPAID_PhoneW ) ||
+        IsEqualGUID( &elements[ i ].guidDataType, &DPAID_ModemW ) ||
+        IsEqualGUID( &elements[ i ].guidDataType, &DPAID_INetW ) )
+      return TRUE;
+  }
+
+  return FALSE;
 }
 
