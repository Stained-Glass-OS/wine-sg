+/* The lobby service provider tells DirectPlay what happened to the session on
+ * the lobby server: players and groups that were made, renamed or removed
+ * there, messages and session changes that arrived. Each call updates the
+ * view of the session that this object has, and neither is sent on to the
+ * lobby provider again. */
+
+static HRESULT DPLSP_CheckSession( IDirectPlayImpl *dp )
+{
+#ifdef SG_MUTANT_LSP_STATE
+  return DP_OK;
+#endif
+  if( dp->dp2->connectionInitialized != DP_LOBBY_PROVIDER )
+    return DPERR_UNINITIALIZED;
+
+  if( !dp->dp2->lpSysGroup )
+    return DPERR_NOSESSIONS;
+
+  return DP_OK;
+}
+
+static BOOL DPLSP_Valid( const void *data, DWORD size, DWORD expected )
+{
+  return data && size >= expected;
+}
+
+/* Makes the player known if it is not yet. The lock is held. */
+static HRESULT DPLSP_EnsurePlayer( IDirectPlayImpl *dp, DPID id, DWORD flags, DPNAME *name )
+{
+  DWORD known;
+
+  if( SUCCEEDED( DP_GetPlayerFlags( dp, id, &known ) ) )
+    return DP_OK;
+
+  return DP_CreatePlayer( dp, NULL, &id, name, NULL, 0, NULL, 0, flags & ~DPLAYI_PLAYER_PLAYERLOCAL,
+                          NULL, NULL, FALSE );
+}
