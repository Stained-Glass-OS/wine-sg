+/* A message for the local players that arrived by way of a service provider
+ * (the lobby one): it is queued like one sent by another peer. */
+HRESULT DP_QueueGameMessage( IDirectPlayImpl *This, DPID from, DPID to, const void *data,
+        DWORD size )
+{
+    HRESULT hr;
+
+    EnterCriticalSection( &This->lock );
+
+    if ( !This->dp2->lpSysGroup )
+        hr = DPERR_NOSESSIONS;
+    else
+        hr = DP_QueueMessage( This, from, to, 0, (void *) data, DP_CopyGeneric, size );
+
+    LeaveCriticalSection( &This->lock );
+
+    return hr;
+}
+
+/* The host changed the session description. The copy of it kept here is
+ * replaced and not sent on again. */
+HRESULT DP_UpdateSessionDesc( IDirectPlayImpl *This, const DPSESSIONDESC2 *sdesc )
+{
+    DPSESSIONDESC2 *copy;
+
+    if ( !sdesc || sdesc->dwSize != sizeof( DPSESSIONDESC2 ) )
+        return DPERR_INVALIDPARAMS;
+
+    /* The session description is kept with ANSI strings, like the one the
+     * name server answers enumerations with. */
+    copy = DP_DuplicateSessionDesc( sdesc, TRUE, FALSE );
+    if ( !copy )
+        return DPERR_OUTOFMEMORY;
+
+    EnterCriticalSection( &This->lock );
+
+    free( This->dp2->lpSessionDesc );
+    This->dp2->lpSessionDesc = copy;
+
+    LeaveCriticalSection( &This->lock );
+
+    return DP_OK;
+}
+
+static DWORD DP_CopyStartSession( DPMSG_GENERIC *genericDst, DPMSG_GENERIC *genericSrc,
+                                  DWORD genericSize, BOOL ansi )
+{
+    DPMSG_STARTSESSION *src = (DPMSG_STARTSESSION *) genericSrc;
+    DPMSG_STARTSESSION *dst = (DPMSG_STARTSESSION *) genericDst;
+    DPLCONNECTION conn = *src->lpConn;
+    DPSESSIONDESC2 sdesc;
+    DPNAME name;
+    DWORD size;
+
+    /* The connection comes with Unicode strings: give an ANSI receiver ANSI ones */
+    if ( conn.lpSessionDesc )
+    {
+        sdesc = *conn.lpSessionDesc;
+        conn.lpSessionDesc = &sdesc;
+        if ( ansi )
+        {
+            sdesc.lpszSessionNameA = DP_DuplicateString( sdesc.lpszSessionName, TRUE, FALSE );
+            sdesc.lpszPasswordA    = DP_DuplicateString( sdesc.lpszPassword, TRUE, FALSE );
+        }
+    }
+    if ( conn.lpPlayerName )
+    {
+        name = *conn.lpPlayerName;
+        conn.lpPlayerName = &name;
+        if ( ansi )
+        {
+            name.lpszShortNameA = DP_DuplicateString( name.lpszShortName, TRUE, FALSE );
+            name.lpszLongNameA  = DP_DuplicateString( name.lpszLongName, TRUE, FALSE );
+        }
+    }
+
+    size = DPLAYX_SizeOfConnection( &conn, ansi );
+
+    if ( dst )
+    {
+        *dst = *src;
+        dst->lpConn = (DPLCONNECTION *)( dst + 1 );
+        DPLAYX_CopyConnection( dst->lpConn, &conn, ansi );
+    }
+
+    if ( ansi )
+    {
+        if ( conn.lpSessionDesc )
+        {
+            free( sdesc.lpszSessionNameA );
+            free( sdesc.lpszPasswordA );
+        }
+        if ( conn.lpPlayerName )
+        {
+            free( name.lpszShortNameA );
+            free( name.lpszLongNameA );
+        }
+    }
+
+    return sizeof( DPMSG_STARTSESSION ) + size;
+}
+
+/* The lobby told the session to start: the players of the group (all of them
+ * for the system group) get a DPSYS_STARTSESSION message with the connection
+ * settings to join the new session with. */
+HRESULT DP_QueueStartSession( IDirectPlayImpl *This, DPID group, const DPLCONNECTION *conn )
+{
+    DPMSG_STARTSESSION msg;
+    HRESULT hr;
+
+    if ( !conn || conn->dwSize != sizeof( DPLCONNECTION ) )
+        return DPERR_INVALIDPARAMS;
+
+    msg.dwType = DPSYS_STARTSESSION;
+    msg.lpConn = (DPLCONNECTION *) conn;
+
+    EnterCriticalSection( &This->lock );
+
+    if ( !This->dp2->lpSysGroup || !DP_FindAnyGroup( This, group ) )
+        hr = DPERR_INVALIDGROUP;
+    else
+        hr = DP_QueueMessage( This, DPID_SYSMSG, group, 0, &msg, DP_CopyStartSession, 0 );
+
+    LeaveCriticalSection( &This->lock );
+
+    return hr;
+}
+
