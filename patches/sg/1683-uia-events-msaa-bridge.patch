+/*
+ * Stained Glass OS 1683: an IAccessible answer (a child id or an object)
+ * as a provider, as get_accFocus answers are. Consumes the VARIANT.
+ */
+static HRESULT msaa_provider_from_acc_variant(struct msaa_provider *prov, VARIANT *v,
+        IRawElementProviderSimple **out)
+{
+    IAccessible *acc = NULL;
+    INT cid = CHILDID_SELF;
+    HWND hwnd = NULL;
+    HRESULT hr;
+
+    *out = NULL;
+    if (V_VT(v) == VT_I4)
+    {
+        IDispatch *disp = NULL;
+
+        if (V_I4(v) == CHILDID_SELF)
+            return create_msaa_provider(prov->acc, CHILDID_SELF, prov->hwnd, FALSE, FALSE, out);
+        hr = IAccessible_get_accChild(prov->acc, *v, &disp);
+        if (FAILED(hr))
+            return hr;
+        if (hr == S_FALSE || !disp)
+            return create_msaa_provider(prov->acc, V_I4(v), prov->hwnd, FALSE, FALSE, out);
+        V_VT(v) = VT_DISPATCH;
+        V_DISPATCH(v) = disp;
+    }
+    if (V_VT(v) != VT_DISPATCH && V_VT(v) != VT_UNKNOWN)
+    {
+        VariantClear(v);
+        return S_FALSE;
+    }
+    hr = IUnknown_QueryInterface(V_UNKNOWN(v), &IID_IAccessible, (void **)&acc);
+    VariantClear(v);
+    if (FAILED(hr))
+        return hr;
+    if (FAILED(WindowFromAccessibleObject(acc, &hwnd)) || !hwnd)
+        hwnd = prov->hwnd;
+    hr = create_msaa_provider(acc, cid, hwnd, FALSE, FALSE, out);
+    IAccessible_Release(acc);
+    return hr;
+}
+
+static HRESULT msaa_fragment_from_acc_variant(struct msaa_provider *prov, VARIANT *v,
+        IRawElementProviderFragment **out)
+{
+    IRawElementProviderSimple *elprov;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = msaa_provider_from_acc_variant(prov, v, &elprov);
+    if (hr != S_OK)
+        return FAILED(hr) ? hr : S_OK;
+    hr = IRawElementProviderSimple_QueryInterface(elprov, &IID_IRawElementProviderFragment, (void **)out);
+    IRawElementProviderSimple_Release(elprov);
+    return hr;
+}
