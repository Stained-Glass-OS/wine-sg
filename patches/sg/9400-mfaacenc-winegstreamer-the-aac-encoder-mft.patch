+ */
+
+/*
+ * Stained Glass OS (wine-sg 9400): the Media Foundation AAC encoder (CLSID_AACMFTEncoder, mfaacenc.dll
+ * on Windows), as Microsoft documents it ("AAC Encoder"): AAC-LC from 16-bit PCM, mono, stereo or 5.1,
+ * 44.1 or 48 kHz, at 12000/16000/20000/24000 bytes per second per channel pair (x6 for 5.1), raw
+ * (payload type 0) or ADTS (payload type 1) frames of 1024 samples, one per output sample, with the
+ * HEAACWAVEINFO tail and the AudioSpecificConfig in MF_MT_USER_DATA. The types can be set in either
+ * order. Encoding runs through wg_transform (GStreamer's libav AAC encoder); the AudioSpecificConfig,
+ * the ADTS headers and the output sample times are the transform's own.
+ */
+
+#include "gst_private.h"
+
+#include "mfapi.h"
+#include "mferror.h"
+#include "mfobjects.h"
+#include "mftransform.h"
+#include "wmcodecdsp.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+WINE_DECLARE_DEBUG_CHANNEL(winediag);
+
+#define AAC_FRAME_SAMPLES 1024
+
+static const UINT32 aac_rates[] = {44100, 48000};
+static const UINT32 aac_channels[] = {1, 2, 6};
+static const UINT32 aac_bytes_per_second[] = {12000, 16000, 20000, 24000};
+static const UINT32 aac_levels[] = {0x29, 0x2a, 0x2b, 0x2c, 0x2e, 0x2f, 0x30, 0x31, 0x32, 0x33};
+
+struct aac_encoder
+{
+    IMFTransform IMFTransform_iface;
+    LONG refcount;
+
+    IMFMediaType *input_type;
+    IMFMediaType *output_type;
+    UINT32 rate, channels, bytes_per_second, payload, level;
+
+    wg_transform_t wg_transform;
+    struct wg_sample_queue *wg_sample_queue;
+    IMFSample *frame;           /* the wg_transform's output, before it goes to the caller's sample */
+
+    BOOL have_time;
+    LONGLONG next_time;         /* the next output frame's time */
+    LONGLONG frame_duration;    /* from the input samples' durations, as Windows' encoder counts it */
+};
+
+static struct aac_encoder *impl_from_IMFTransform(IMFTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct aac_encoder, IMFTransform_iface);
+}
+
+static BOOL value_in(UINT32 value, const UINT32 *list, unsigned int count)
+{
+    while (count--) if (list[count] == value) return TRUE;
+    return FALSE;
+}
+
+static UINT32 bytes_scale(UINT32 channels)
+{
+    return channels == 6 ? 6 : 1;
+}
+
+/* AudioSpecificConfig (ISO/IEC 14496-3 1.6.2.1): AAC LC, the sampling frequency index, the channel
+ * configuration, then frameLengthFlag, dependsOnCoreCoder and extensionFlag, all zero */
+static void aac_audio_specific_config(UINT32 rate, UINT32 channels, BYTE config[2])
+{
+    UINT32 index = rate == 48000 ? 3 : 4, object = 2;
+#ifdef SG_MUTANT_AACENC_ASC
+    index = 8;
+#endif
+    config[0] = (object << 3) | (index >> 1);
+    config[1] = ((index & 1) << 7) | (channels << 3);
+}
+
+static HRESULT create_input_type(UINT32 rate, UINT32 channels, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFAudioFormat_PCM);
+    IMFMediaType_SetGUID(type, &MF_MT_AM_FORMAT_TYPE, &FORMAT_WaveFormatEx);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, 2 * channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, rate * 2 * channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AVG_BITRATE, rate * 2 * channels * 8);
+    IMFMediaType_SetUINT32(type, &MF_MT_COMPRESSED, 0);
+    IMFMediaType_SetUINT32(type, &MF_MT_FIXED_SIZE_SAMPLES, 1);
+    IMFMediaType_SetUINT32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1);
+    hr = IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_PREFER_WAVEFORMATEX, 1);
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(type);
+        return hr;
+    }
+    *out = type;
+    return S_OK;
+}
+
+static HRESULT create_output_type(UINT32 rate, UINT32 channels, UINT32 bytes_per_second, UINT32 payload,
+        UINT32 level, IMFMediaType **out)
+{
+    BYTE user_data[sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX) + 2];
+    HEAACWAVEINFO info = {{0}};
+    IMFMediaType *type;
+    HRESULT hr;
+
+    /* the part of HEAACWAVEINFO after the WAVEFORMATEX, then the AudioSpecificConfig */
+    info.wPayloadType = payload;
+    info.wAudioProfileLevelIndication = level;
+    memcpy(user_data, &info.wPayloadType, sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX));
+    aac_audio_specific_config(rate, channels, user_data + sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX));
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFAudioFormat_AAC);
+    IMFMediaType_SetGUID(type, &MF_MT_AM_FORMAT_TYPE, &FORMAT_WaveFormatEx);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, 1);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, bytes_per_second);
+    IMFMediaType_SetUINT32(type, &MF_MT_AVG_BITRATE, bytes_per_second * 8);
+    IMFMediaType_SetUINT32(type, &MF_MT_COMPRESSED, 1);
+    IMFMediaType_SetUINT32(type, &MF_MT_FIXED_SIZE_SAMPLES, 0);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_PREFER_WAVEFORMATEX, 1);
+    IMFMediaType_SetUINT32(type, &MF_MT_AAC_AUDIO_PROFILE_LEVEL_INDICATION, level);
+    IMFMediaType_SetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, payload);
+    hr = IMFMediaType_SetBlob(type, &MF_MT_USER_DATA, user_data, sizeof(user_data));
+    if (FAILED(hr))
+    {
+        IMFMediaType_Release(type);
+        return hr;
+    }
+    *out = type;
+    return S_OK;
+}
+
+static void encoder_reset_stream(struct aac_encoder *encoder)
+{
+    encoder->have_time = FALSE;
+    encoder->next_time = 0;
+    encoder->frame_duration = 0;
+}
+
+static void encoder_destroy_transform(struct aac_encoder *encoder)
+{
+    if (encoder->wg_transform)
+    {
+        wg_transform_destroy(encoder->wg_transform);
+        encoder->wg_transform = 0;
+    }
+    encoder_reset_stream(encoder);
+}
+
+static HRESULT encoder_try_create_transform(struct aac_encoder *encoder)
+{
+    struct wg_transform_attrs attrs = {.input_queue_length = 15};
+    IMFMediaType *output;
+    HRESULT hr;
+
+    encoder_destroy_transform(encoder);
+    if (!encoder->input_type || !encoder->output_type)
+        return S_OK;
+
+    /* GStreamer's encoder writes raw frames; the ADTS headers are added here */
+    if (FAILED(hr = create_output_type(encoder->rate, encoder->channels, encoder->bytes_per_second, 0,
+            encoder->level, &output)))
+        return hr;
+    hr = wg_transform_create_mf(encoder->input_type, output, &attrs, &encoder->wg_transform);
+    IMFMediaType_Release(output);
+    if (FAILED(hr))
+        ERR_(winediag)("GStreamer doesn't support AAC encoding, please install appropriate plugins\n");
+    return hr;
+}
+
+static HRESULT WINAPI transform_QueryInterface(IMFTransform *iface, REFIID iid, void **out)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IMFTransform))
+        *out = &encoder->IMFTransform_iface;
+    else
+    {
+        *out = NULL;
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI transform_AddRef(IMFTransform *iface)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    ULONG refcount = InterlockedIncrement(&encoder->refcount);
+    TRACE("iface %p increasing refcount to %lu.\n", encoder, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI transform_Release(IMFTransform *iface)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    ULONG refcount = InterlockedDecrement(&encoder->refcount);
+
+    TRACE("iface %p decreasing refcount to %lu.\n", encoder, refcount);
+
+    if (!refcount)
+    {
+        encoder_destroy_transform(encoder);
+        if (encoder->input_type)
+            IMFMediaType_Release(encoder->input_type);
+        if (encoder->output_type)
+            IMFMediaType_Release(encoder->output_type);
+        if (encoder->frame)
+            IMFSample_Release(encoder->frame);
+        wg_sample_queue_destroy(encoder->wg_sample_queue);
+        free(encoder);
+    }
+
+    return refcount;
+}
+
+static HRESULT WINAPI transform_GetStreamLimits(IMFTransform *iface, DWORD *input_minimum,
+        DWORD *input_maximum, DWORD *output_minimum, DWORD *output_maximum)
+{
+    TRACE("iface %p, input_minimum %p, input_maximum %p, output_minimum %p, output_maximum %p.\n",
+            iface, input_minimum, input_maximum, output_minimum, output_maximum);
+    *input_minimum = *input_maximum = *output_minimum = *output_maximum = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamCount(IMFTransform *iface, DWORD *inputs, DWORD *outputs)
+{
+    TRACE("iface %p, inputs %p, outputs %p.\n", iface, inputs, outputs);
+    *inputs = *outputs = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetStreamIDs(IMFTransform *iface, DWORD input_size, DWORD *inputs,
+        DWORD output_size, DWORD *outputs)
+{
+    TRACE("iface %p, input_size %lu, inputs %p, output_size %lu, outputs %p.\n", iface,
+            input_size, inputs, output_size, outputs);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetInputStreamInfo(IMFTransform *iface, DWORD id, MFT_INPUT_STREAM_INFO *info)
+{
+    TRACE("iface %p, id %#lx, info %p.\n", iface, id, info);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    memset(info, 0, sizeof(*info));
+    return S_OK;
+}
+
+static DWORD output_frame_size(struct aac_encoder *encoder)
+{
+    /* the largest AAC frame: 6144 bits per channel (ISO/IEC 13818-7), and an ADTS header */
+    return encoder->channels <= 2 ? 0x600 : encoder->channels * 768 + 7;
+}
+
+static HRESULT WINAPI transform_GetOutputStreamInfo(IMFTransform *iface, DWORD id, MFT_OUTPUT_STREAM_INFO *info)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, info %p.\n", iface, id, info);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    memset(info, 0, sizeof(*info));
+    if (encoder->input_type && encoder->output_type)
+        info->cbSize = output_frame_size(encoder);
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetAttributes(IMFTransform *iface, IMFAttributes **attributes)
+{
+    TRACE("iface %p, attributes %p.\n", iface, attributes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetInputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
+{
+    TRACE("iface %p, id %#lx, attributes %p.\n", iface, id, attributes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_GetOutputStreamAttributes(IMFTransform *iface, DWORD id, IMFAttributes **attributes)
+{
+    TRACE("iface %p, id %#lx, attributes %p.\n", iface, id, attributes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_DeleteInputStream(IMFTransform *iface, DWORD id)
+{
+    TRACE("iface %p, id %#lx.\n", iface, id);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_AddInputStreams(IMFTransform *iface, DWORD streams, DWORD *ids)
+{
+    TRACE("iface %p, streams %lu, ids %p.\n", iface, streams, ids);
+    return E_NOTIMPL;
+}
+
+/* With a type set on the other side, only its rate and channel count are offered. */
+static HRESULT WINAPI transform_GetInputAvailableType(IMFTransform *iface, DWORD id, DWORD index,
+        IMFMediaType **type)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    unsigned int i, j;
+
+    TRACE("iface %p, id %#lx, index %#lx, type %p.\n", iface, id, index, type);
+
+    *type = NULL;
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (encoder->output_type)
+        return index ? MF_E_NO_MORE_TYPES : create_input_type(encoder->rate, encoder->channels, type);
+
+    for (i = 0; i < ARRAY_SIZE(aac_rates); i++)
+        for (j = 0; j < ARRAY_SIZE(aac_channels); j++)
+            if (!index--)
+                return create_input_type(aac_rates[i], aac_channels[j], type);
+    return MF_E_NO_MORE_TYPES;
+}
+
+static HRESULT WINAPI transform_GetOutputAvailableType(IMFTransform *iface, DWORD id, DWORD index,
+        IMFMediaType **type)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    unsigned int i, j, k;
+
+    TRACE("iface %p, id %#lx, index %#lx, type %p.\n", iface, id, index, type);
+
+    *type = NULL;
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+
+    for (i = 0; i < ARRAY_SIZE(aac_rates); i++)
+        for (j = 0; j < ARRAY_SIZE(aac_channels); j++)
+        {
+            if (encoder->input_type && (aac_rates[i] != encoder->rate || aac_channels[j] != encoder->channels))
+                continue;
+            for (k = 0; k < ARRAY_SIZE(aac_bytes_per_second); k++)
+                if (!index--)
+                    return create_output_type(aac_rates[i], aac_channels[j],
+                            aac_bytes_per_second[k] * bytes_scale(aac_channels[j]), 0, 0x29, type);
+        }
+    return MF_E_NO_MORE_TYPES;
+}
+
+static HRESULT get_audio_params(IMFMediaType *type, const GUID *subtype, UINT32 *rate, UINT32 *channels)
+{
+    UINT32 bits;
+    GUID major, sub;
+
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_MAJOR_TYPE, &major)) || !IsEqualGUID(&major, &MFMediaType_Audio))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &sub)) || !IsEqualGUID(&sub, subtype))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, &bits)) || bits != 16)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, rate))
+            || !value_in(*rate, aac_rates, ARRAY_SIZE(aac_rates)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, channels))
+            || !value_in(*channels, aac_channels, ARRAY_SIZE(aac_channels)))
+        return MF_E_INVALIDMEDIATYPE;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_SetInputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 rate, channels;
+    IMFMediaType *input;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+
+    if (!type)
+    {
+        if (flags & MFT_SET_TYPE_TEST_ONLY)
+            return S_OK;
+        if (encoder->input_type)
+            IMFMediaType_Release(encoder->input_type);
+        encoder->input_type = NULL;
+        encoder_destroy_transform(encoder);
+        return S_OK;
+    }
+
+    if (FAILED(hr = get_audio_params(type, &MFAudioFormat_PCM, &rate, &channels)))
+        return hr;
+    if (encoder->output_type && (rate != encoder->rate || channels != encoder->channels))
+        return MF_E_INVALIDMEDIATYPE;
+    if (flags & MFT_SET_TYPE_TEST_ONLY)
+        return S_OK;
+
+    /* the encoder completes the type: block alignment, byte rate, bit rate */
+    if (FAILED(hr = create_input_type(rate, channels, &input)))
+        return hr;
+    if (encoder->input_type)
+        IMFMediaType_Release(encoder->input_type);
+    encoder->input_type = input;
+    encoder->rate = rate;
+    encoder->channels = channels;
+
+    if (FAILED(hr = encoder_try_create_transform(encoder)))
+    {
+        IMFMediaType_Release(encoder->input_type);
+        encoder->input_type = NULL;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI transform_SetOutputType(IMFTransform *iface, DWORD id, IMFMediaType *type, DWORD flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    UINT32 rate, channels, bytes, payload, level;
+    IMFMediaType *output;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, type %p, flags %#lx.\n", iface, id, type, flags);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+
+    if (!type)
+    {
+        if (flags & MFT_SET_TYPE_TEST_ONLY)
+            return S_OK;
+        if (encoder->output_type)
+            IMFMediaType_Release(encoder->output_type);
+        encoder->output_type = NULL;
+        encoder_destroy_transform(encoder);
+        return S_OK;
+    }
+
+    if (FAILED(hr = get_audio_params(type, &MFAudioFormat_AAC, &rate, &channels)))
+        return hr;
+    if (encoder->input_type && (rate != encoder->rate || channels != encoder->channels))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, &bytes))
+            || bytes % bytes_scale(channels)
+            || !value_in(bytes / bytes_scale(channels), aac_bytes_per_second, ARRAY_SIZE(aac_bytes_per_second)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, &payload)))
+        payload = 0;
+    if (payload > 1)
+        return MF_E_INVALIDMEDIATYPE;
+    if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AAC_AUDIO_PROFILE_LEVEL_INDICATION, &level)))
+        level = 0x29;
+    if (!value_in(level, aac_levels, ARRAY_SIZE(aac_levels)))
+        return MF_E_INVALIDMEDIATYPE;
+    if (flags & MFT_SET_TYPE_TEST_ONLY)
+        return S_OK;
+
+    /* the encoder adds MF_MT_USER_DATA (and the rest of the description) */
+    if (FAILED(hr = create_output_type(rate, channels, bytes, payload, level, &output)))
+        return hr;
+    if (encoder->output_type)
+        IMFMediaType_Release(encoder->output_type);
+    encoder->output_type = output;
+    encoder->rate = rate;
+    encoder->channels = channels;
+    encoder->bytes_per_second = bytes;
+    encoder->payload = payload;
+    encoder->level = level;
+
+    if (FAILED(hr = encoder_try_create_transform(encoder)))
+    {
+        IMFMediaType_Release(encoder->output_type);
+        encoder->output_type = NULL;
+    }
+    return hr;
+}
+
+static HRESULT copy_type(IMFMediaType *from, IMFMediaType **out)
+{
+    IMFMediaType *type;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&type)))
+        return hr;
+    if (SUCCEEDED(hr = IMFMediaType_CopyAllItems(from, (IMFAttributes *)type)))
+        IMFMediaType_AddRef(*out = type);
+    IMFMediaType_Release(type);
+    return hr;
+}
+
+static HRESULT WINAPI transform_GetInputCurrentType(IMFTransform *iface, DWORD id, IMFMediaType **out)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, out %p.\n", iface, id, out);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!encoder->input_type)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+    return copy_type(encoder->input_type, out);
+}
+
+static HRESULT WINAPI transform_GetOutputCurrentType(IMFTransform *iface, DWORD id, IMFMediaType **out)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+
+    TRACE("iface %p, id %#lx, out %p.\n", iface, id, out);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!encoder->output_type)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+    return copy_type(encoder->output_type, out);
+}
+
+static HRESULT WINAPI transform_GetInputStatus(IMFTransform *iface, DWORD id, DWORD *flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    bool accepts_input;
+
+    TRACE("iface %p, id %#lx, flags %p.\n", iface, id, flags);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!encoder->wg_transform)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+    if (!wg_transform_get_status(encoder->wg_transform, &accepts_input))
+        return E_FAIL;
+    *flags = accepts_input ? MFT_INPUT_STATUS_ACCEPT_DATA : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_GetOutputStatus(IMFTransform *iface, DWORD *flags)
+{
+    TRACE("iface %p, flags %p.\n", iface, flags);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_SetOutputBounds(IMFTransform *iface, LONGLONG lower, LONGLONG upper)
+{
+    TRACE("iface %p, lower %I64d, upper %I64d.\n", iface, lower, upper);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_ProcessEvent(IMFTransform *iface, DWORD id, IMFMediaEvent *event)
+{
+    TRACE("iface %p, id %#lx, event %p.\n", iface, id, event);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_TYPE message, ULONG_PTR param)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, message %#x, param %p.\n", iface, message, (void *)param);
+
+    switch (message)
+    {
+    case MFT_MESSAGE_COMMAND_DRAIN:
+        return encoder->wg_transform ? wg_transform_drain(encoder->wg_transform) : MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    case MFT_MESSAGE_COMMAND_FLUSH:
+        if (!encoder->wg_transform)
+            return MF_E_TRANSFORM_TYPE_NOT_SET;
+        if (SUCCEEDED(hr = wg_transform_flush(encoder->wg_transform)))
+            encoder_reset_stream(encoder);
+        return hr;
+
+    case MFT_MESSAGE_NOTIFY_BEGIN_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_STREAMING:
+    case MFT_MESSAGE_NOTIFY_END_OF_STREAM:
+    case MFT_MESSAGE_NOTIFY_START_OF_STREAM:
+        return S_OK;
+
+    default:
+        FIXME("Ignoring message %#x.\n", message);
+        return S_OK;
+    }
+}
+
+static HRESULT WINAPI transform_ProcessInput(IMFTransform *iface, DWORD id, IMFSample *sample, DWORD flags)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    LONGLONG time, duration;
+    DWORD length;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, sample %p, flags %#lx.\n", iface, id, sample, flags);
+
+    if (id)
+        return MF_E_INVALIDSTREAMNUMBER;
+    if (!encoder->wg_transform)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    /* documented: every input sample needs a time and a duration */
+    if (FAILED(IMFSample_GetSampleTime(sample, &time)))
+        return MF_E_NO_SAMPLE_TIMESTAMP;
+    if (FAILED(IMFSample_GetSampleDuration(sample, &duration)))
+        return MF_E_NO_SAMPLE_DURATION;
+    if (FAILED(hr = IMFSample_GetTotalLength(sample, &length)))
+        return hr;
+
+    if (FAILED(hr = wg_transform_push_mf(encoder->wg_transform, sample, encoder->wg_sample_queue)))
+        return hr;
+
+    if (!encoder->have_time)
+    {
+        encoder->have_time = TRUE;
+        encoder->next_time = time;
+    }
+    /* the frames' times follow the input's own clock: its duration over its samples */
+    if (length >= 2 * encoder->channels)
+        encoder->frame_duration = duration * AAC_FRAME_SAMPLES / (length / (2 * encoder->channels));
+    return S_OK;
+}
+
+/* the 7-byte ADTS header (ISO/IEC 13818-7 6.2), without CRC */
+static void write_adts_header(struct aac_encoder *encoder, BYTE *dst, DWORD frame_length)
+{
+    UINT32 index = encoder->rate == 48000 ? 3 : 4, length = frame_length + 7;
+    UINT32 fullness = 0x7ff, channels = encoder->channels;
+
+    dst[0] = 0xff;
+    dst[1] = 0xf1;                                  /* MPEG-4, layer 0, no CRC */
+    dst[2] = (1 << 6) | (index << 2) | (channels >> 2); /* AAC LC (profile 1) */
+    dst[3] = ((channels & 3) << 6) | (length >> 11);
+    dst[4] = (length >> 3) & 0xff;
+    dst[5] = ((length & 7) << 5) | (fullness >> 6);
+    dst[6] = (fullness & 0x3f) << 2;                /* one raw data block */
+}
+
+static HRESULT WINAPI transform_ProcessOutput(IMFTransform *iface, DWORD flags, DWORD count,
+        MFT_OUTPUT_DATA_BUFFER *samples, DWORD *status)
+{
+    struct aac_encoder *encoder = impl_from_IMFTransform(iface);
+    DWORD frame_size = output_frame_size(encoder), header = encoder->payload == 1 ? 7 : 0;
+    DWORD length, max_length, read_flags = 0;
+    IMFMediaBuffer *src_buffer, *dst_buffer;
+    BYTE *src, *dst;
+    HRESULT hr;
+    int tries;
+
+    TRACE("iface %p, flags %#lx, count %lu, samples %p, status %p.\n", iface, flags, count, samples, status);
+
+    if (count != 1)
+        return E_INVALIDARG;
+    if (!encoder->wg_transform)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    *status = samples->dwStatus = 0;
+    if (!samples->pSample)
+        return E_INVALIDARG;
+
+    if (!encoder->frame && FAILED(hr = MFCreateSample(&encoder->frame)))
+        return hr;
+    IMFSample_RemoveAllBuffers(encoder->frame);
+    if (FAILED(hr = MFCreateMemoryBuffer(frame_size, &src_buffer)))
+        return hr;
+    IMFSample_AddBuffer(encoder->frame, src_buffer);
+
+    /* the encoder's caps can settle on the first read */
+    for (tries = 0; tries < 3; tries++)
+    {
+        hr = wg_transform_read_mf(encoder->wg_transform, encoder->frame, frame_size, &read_flags);
+        if (hr != MF_E_TRANSFORM_STREAM_CHANGE) break;
+    }
+    if (FAILED(hr))
+    {
+        IMFMediaBuffer_Release(src_buffer);
+        samples->dwStatus = MFT_OUTPUT_DATA_BUFFER_NO_SAMPLE;
+        return hr;
+    }
+    wg_sample_queue_flush(encoder->wg_sample_queue, false);
+
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(samples->pSample, &dst_buffer)))
+    {
+        IMFMediaBuffer_Release(src_buffer);
+        return hr;
+    }
+    if (SUCCEEDED(hr = IMFMediaBuffer_Lock(src_buffer, &src, NULL, &length)))
+    {
+        if (SUCCEEDED(hr = IMFMediaBuffer_Lock(dst_buffer, &dst, &max_length, NULL)))
+        {
+            if (max_length < length + header)
+                hr = MF_E_BUFFERTOOSMALL;
+            else
+            {
+                if (header)
+                    write_adts_header(encoder, dst, length);
+                memcpy(dst + header, src, length);
+            }
+            IMFMediaBuffer_Unlock(dst_buffer);
+            if (SUCCEEDED(hr))
+                hr = IMFMediaBuffer_SetCurrentLength(dst_buffer, length + header);
+        }
+        IMFMediaBuffer_Unlock(src_buffer);
+    }
+    IMFMediaBuffer_Release(dst_buffer);
+    IMFMediaBuffer_Release(src_buffer);
+    if (FAILED(hr))
+        return hr;
+
+    if (!encoder->frame_duration)
+        encoder->frame_duration = (LONGLONG)AAC_FRAME_SAMPLES * 10000000 / encoder->rate;
+    IMFSample_SetSampleTime(samples->pSample, encoder->next_time);
+    IMFSample_SetSampleDuration(samples->pSample, encoder->frame_duration);
+    IMFSample_SetUINT32(samples->pSample, &MFSampleExtension_CleanPoint, 1);
+#ifndef SG_MUTANT_AACENC_TIME
+    encoder->next_time += encoder->frame_duration;
+#endif
+    return S_OK;
+}
+
+static const IMFTransformVtbl transform_vtbl =
+{
+    transform_QueryInterface,
+    transform_AddRef,
+    transform_Release,
+    transform_GetStreamLimits,
+    transform_GetStreamCount,
+    transform_GetStreamIDs,
+    transform_GetInputStreamInfo,
+    transform_GetOutputStreamInfo,
+    transform_GetAttributes,
+    transform_GetInputStreamAttributes,
+    transform_GetOutputStreamAttributes,
+    transform_DeleteInputStream,
+    transform_AddInputStreams,
+    transform_GetInputAvailableType,
+    transform_GetOutputAvailableType,
+    transform_SetInputType,
+    transform_SetOutputType,
+    transform_GetInputCurrentType,
+    transform_GetOutputCurrentType,
+    transform_GetInputStatus,
+    transform_GetOutputStatus,
+    transform_SetOutputBounds,
+    transform_ProcessEvent,
+    transform_ProcessMessage,
+    transform_ProcessInput,
+    transform_ProcessOutput,
+};
+
+HRESULT aac_encoder_create(REFIID riid, void **ret)
+{
+    static const WAVEFORMATEX pcm = {.wFormatTag = WAVE_FORMAT_PCM, .nChannels = 2, .nSamplesPerSec = 44100,
+            .nAvgBytesPerSec = 176400, .nBlockAlign = 4, .wBitsPerSample = 16};
+    static const struct
+    {
+        WAVEFORMATEX wfx;
+        BYTE info[sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX)];
+        BYTE config[2];
+    } aac =
+    {
+        .wfx = {.wFormatTag = WAVE_FORMAT_MPEG_HEAAC, .nChannels = 2, .nSamplesPerSec = 44100,
+                .nAvgBytesPerSec = 16000, .nBlockAlign = 1, .wBitsPerSample = 16,
+                .cbSize = sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX) + 2},
+        .info = {0, 0, 0x29},
+        .config = {0x12, 0x10},
+    };
+    struct aac_encoder *encoder;
+    HRESULT hr;
+
+    TRACE("riid %s, ret %p.\n", debugstr_guid(riid), ret);
+
+    if (FAILED(hr = check_audio_transform_support(&pcm, &aac.wfx)))
+    {
+        ERR_(winediag)("GStreamer doesn't support AAC encoding, please install appropriate plugins\n");
+        return hr;
+    }
+
+    if (!(encoder = calloc(1, sizeof(*encoder))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = wg_sample_queue_create(&encoder->wg_sample_queue)))
+    {
+        free(encoder);
+        return hr;
+    }
+
+    encoder->IMFTransform_iface.lpVtbl = &transform_vtbl;
+    encoder->refcount = 1;
+
+    *ret = &encoder->IMFTransform_iface;
+    TRACE("Created encoder %p\n", *ret);
+    return S_OK;
+}
