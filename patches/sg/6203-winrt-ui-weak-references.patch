From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui: a CoreDispatcher and a UISettings can be held weakly

OneDrive (React Native for Windows) holds its thread's CoreDispatcher and a UISettings as weak references, the way C++/WinRT programs do; both answered E_NOINTERFACE for IWeakReferenceSource and the program used the null it got, crashing. The CoreDispatcher, its thread's for life, now gives a weak reference that always resolves to it; a UISettings gives one that resolves while it lives and to nothing once it is gone.
---
diff --git a/dlls/windows.ui/dispatcher.c b/dlls/windows.ui/dispatcher.c
index 72d6aa8..ab812ed 100644
--- a/dlls/windows.ui/dispatcher.c
+++ b/dlls/windows.ui/dispatcher.c
@@ -333,6 +333,8 @@ struct dispatcher
 {
     const void *vtbl;                  /* ICoreDispatcher */
     const void *dispatcher2_vtbl, *priority_vtbl, *accelerator_vtbl;
+    const void *weak_source_vtbl;      /* IWeakReferenceSource */
+    const void *weak_vtbl;             /* its IWeakReference: the dispatcher is its thread's for life */
     LONG ref;
     DWORD thread;
     HWND hwnd;                         /* message-only, of its thread */
@@ -349,6 +351,11 @@ static struct dispatcher *dispatcher_from( void *iface, size_t offset )
 #define FROM_D2(iface) dispatcher_from( iface, offsetof(struct dispatcher, dispatcher2_vtbl) )
 #define FROM_P(iface) dispatcher_from( iface, offsetof(struct dispatcher, priority_vtbl) )
 #define FROM_A(iface) dispatcher_from( iface, offsetof(struct dispatcher, accelerator_vtbl) )
+#define FROM_WS(iface) dispatcher_from( iface, offsetof(struct dispatcher, weak_source_vtbl) )
+#define FROM_W(iface) dispatcher_from( iface, offsetof(struct dispatcher, weak_vtbl) )
+
+static const GUID IID_IWeakReferenceSource_cd = { 0x00000038, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const GUID IID_IWeakReference_cd = { 0x00000037, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
 
 static HRESULT dispatcher_qi( struct dispatcher *impl, REFIID iid, void **out )
 {
@@ -358,6 +365,9 @@ static HRESULT dispatcher_qi( struct dispatcher *impl, REFIID iid, void **out )
     else if (IsEqualGUID( iid, &IID_ICoreDispatcher2_sg )) *out = &impl->dispatcher2_vtbl;
     else if (IsEqualGUID( iid, &IID_ICoreDispatcherWithTaskPriority_sg )) *out = &impl->priority_vtbl;
     else if (IsEqualGUID( iid, &IID_ICoreAcceleratorKeys_sg )) *out = &impl->accelerator_vtbl;
+#ifndef SG_MUTANT_DISPATCHER_NO_WEAK_SOURCE
+    else if (IsEqualGUID( iid, &IID_IWeakReferenceSource_cd )) *out = &impl->weak_source_vtbl;
+#endif
     else
     {
         FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
@@ -387,6 +397,42 @@ DISPATCHER_BASE(d2, FROM_D2)
 DISPATCHER_BASE(dp, FROM_P)
 DISPATCHER_BASE(da, FROM_A)
 
+/* held weakly (C++/WinRT programs keep their thread's dispatcher so: React Native for Windows):
+ * the weak reference always resolves, the dispatcher is never freed */
+static HRESULT WINAPI ws_QueryInterface( void *iface, REFIID iid, void **out ) { return dispatcher_qi( FROM_WS( iface ), iid, out ); }
+static ULONG WINAPI ws_AddRef( void *iface ) { return dispatcher_addref( FROM_WS( iface ) ); }
+static ULONG WINAPI ws_Release( void *iface ) { return dispatcher_release( FROM_WS( iface ) ); }
+static HRESULT WINAPI ws_GetWeakReference( void *iface, void **out )
+{
+    struct dispatcher *impl = FROM_WS( iface );
+
+    if (!out) return E_POINTER;
+    dispatcher_addref( impl );
+    *out = &impl->weak_vtbl;
+    return S_OK;
+}
+static const void *weak_source_vtbl[] = { ws_QueryInterface, ws_AddRef, ws_Release, ws_GetWeakReference };
+
+static HRESULT WINAPI w_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference_cd ))
+    {
+        dispatcher_addref( FROM_W( iface ) );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI w_AddRef( void *iface ) { return dispatcher_addref( FROM_W( iface ) ); }
+static ULONG WINAPI w_Release( void *iface ) { return dispatcher_release( FROM_W( iface ) ); }
+static HRESULT WINAPI w_Resolve( void *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    return dispatcher_qi( FROM_W( iface ), iid, out );
+}
+static const void *weak_vtbl[] = { w_QueryInterface, w_AddRef, w_Release, w_Resolve };
+
 static HRESULT WINAPI d_get_HasThreadAccess( void *iface, boolean *value )
 {
     if (!value) return E_POINTER;
@@ -544,6 +590,8 @@ HRESULT thread_dispatcher( IInspectable **out )
         impl->dispatcher2_vtbl = dispatcher2_vtbl;
         impl->priority_vtbl = priority_vtbl;
         impl->accelerator_vtbl = accelerator_vtbl;
+        impl->weak_source_vtbl = weak_source_vtbl;
+        impl->weak_vtbl = weak_vtbl;
         impl->ref = 1;
         impl->thread = GetCurrentThreadId();
         impl->priority = 0;   /* Normal */
diff --git a/dlls/windows.ui/uisettings.c b/dlls/windows.ui/uisettings.c
index 117a259..a6ace6f 100644
--- a/dlls/windows.ui/uisettings.c
+++ b/dlls/windows.ui/uisettings.c
@@ -36,9 +36,32 @@ struct uisettings
     IUISettings4 IUISettings4_iface;
     IUISettings5 IUISettings5_iface;
     IUISettings6 IUISettings6_iface;
+    const void *weak_source_vtbl;      /* IWeakReferenceSource */
+    struct uisettings_weak *weak;      /* its weak reference, once one is asked for */
     LONG ref;
 };
 
+/* a weak reference to a UISettings (C++/WinRT programs hold theirs so: React Native for Windows):
+ * it resolves while the object lives; the object clears it, under weak_cs, before it is freed */
+struct uisettings_weak
+{
+    const void *vtbl;                  /* IWeakReference */
+    LONG ref;
+    struct uisettings *settings;
+};
+
+static CRITICAL_SECTION weak_cs;
+static CRITICAL_SECTION_DEBUG weak_cs_debug =
+{
+    0, 0, &weak_cs,
+    { &weak_cs_debug.ProcessLocksList, &weak_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": weak_cs") }
+};
+static CRITICAL_SECTION weak_cs = { &weak_cs_debug, -1, 0, 0, 0, 0 };
+
+static const GUID IID_IWeakReferenceSource_ui = { 0x00000038, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const GUID IID_IWeakReference_ui = { 0x00000037, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+
 /* The Changed events, as Windows raises them: on a background thread, when
  * the setting behind them changes (here: a registry watcher over the keys the
  * settings live in, started with the first handler). */
@@ -101,6 +124,10 @@ static HRESULT WINAPI uisettings_QueryInterface( IUISettings *iface, REFIID iid,
         *out = &impl->IUISettings5_iface;
     else if (IsEqualGUID( iid, &IID_IUISettings6 ))
         *out = &impl->IUISettings6_iface;
+#ifndef SG_MUTANT_UISETTINGS_NO_WEAK_SOURCE
+    else if (IsEqualGUID( iid, &IID_IWeakReferenceSource_ui ))
+        *out = &impl->weak_source_vtbl;
+#endif
 
     if (!*out)
     {
@@ -127,10 +154,121 @@ static ULONG WINAPI uisettings_Release( IUISettings *iface )
 
     TRACE( "iface %p, ref %lu.\n", iface, ref );
 
-    if (!ref) free( impl );
+    if (!ref)
+    {
+        struct uisettings_weak *weak;
+
+        /* weak references no longer resolve */
+        EnterCriticalSection( &weak_cs );
+        if ((weak = impl->weak)) weak->settings = NULL;
+        LeaveCriticalSection( &weak_cs );
+        if (weak && !InterlockedDecrement( &weak->ref )) free( weak );
+        free( impl );
+    }
     return ref;
 }
 
+static struct uisettings_weak *weak_from( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct uisettings_weak, vtbl );
+}
+
+static HRESULT WINAPI weak_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference_ui ))
+    {
+        InterlockedIncrement( &weak_from( iface )->ref );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI weak_AddRef( void *iface )
+{
+    return InterlockedIncrement( &weak_from( iface )->ref );
+}
+
+static ULONG WINAPI weak_Release( void *iface )
+{
+    struct uisettings_weak *weak = weak_from( iface );
+    ULONG ref = InterlockedDecrement( &weak->ref );
+    if (!ref) free( weak );
+    return ref;
+}
+
+static HRESULT WINAPI weak_Resolve( void *iface, REFIID iid, void **out )
+{
+    struct uisettings_weak *weak = weak_from( iface );
+    struct uisettings *impl;
+    HRESULT hr;
+    LONG ref;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    /* a strong reference only while one is still held */
+    EnterCriticalSection( &weak_cs );
+    if ((impl = weak->settings))
+    {
+        do ref = impl->ref; while (ref && InterlockedCompareExchange( &impl->ref, ref + 1, ref ) != ref);
+        if (!ref) impl = NULL;
+    }
+    LeaveCriticalSection( &weak_cs );
+    if (!impl) return S_OK;   /* gone: a null object */
+    hr = IUISettings_QueryInterface( &impl->IUISettings_iface, iid, out );
+    IUISettings_Release( &impl->IUISettings_iface );
+    return hr;
+}
+
+static const void *weak_vtbl[] = { weak_QueryInterface, weak_AddRef, weak_Release, weak_Resolve };
+
+static struct uisettings *settings_from_weak_source( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct uisettings, weak_source_vtbl );
+}
+
+static HRESULT WINAPI weak_source_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return IUISettings_QueryInterface( &settings_from_weak_source( iface )->IUISettings_iface, iid, out );
+}
+
+static ULONG WINAPI weak_source_AddRef( void *iface )
+{
+    return IUISettings_AddRef( &settings_from_weak_source( iface )->IUISettings_iface );
+}
+
+static ULONG WINAPI weak_source_Release( void *iface )
+{
+    return IUISettings_Release( &settings_from_weak_source( iface )->IUISettings_iface );
+}
+
+static HRESULT WINAPI weak_source_GetWeakReference( void *iface, void **out )
+{
+    struct uisettings *impl = settings_from_weak_source( iface );
+    struct uisettings_weak *weak;
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection( &weak_cs );
+    if (!(weak = impl->weak) && (weak = calloc( 1, sizeof(*weak) )))
+    {
+        weak->vtbl = weak_vtbl;
+        weak->ref = 1;   /* the object's */
+        weak->settings = impl;
+        impl->weak = weak;
+    }
+    if (weak) InterlockedIncrement( &weak->ref );
+    LeaveCriticalSection( &weak_cs );
+    if (!weak) return E_OUTOFMEMORY;
+    *out = &weak->vtbl;
+    return S_OK;
+}
+
+static const void *weak_source_vtbl[] =
+{
+    weak_source_QueryInterface, weak_source_AddRef, weak_source_Release, weak_source_GetWeakReference,
+};
+
 static HRESULT WINAPI uisettings_GetIids( IUISettings *iface, ULONG *iid_count, IID **iids )
 {
     static const IID *all[] = { &IID_IUISettings, &IID_IUISettings2, &IID_IUISettings3,
@@ -1072,6 +1210,7 @@ static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInsp
     impl->IUISettings4_iface.lpVtbl = &uisettings4_vtbl;
     impl->IUISettings5_iface.lpVtbl = &uisettings5_vtbl;
     impl->IUISettings6_iface.lpVtbl = &uisettings6_vtbl;
+    impl->weak_source_vtbl = weak_source_vtbl;
     impl->ref = 1;
 
     *instance = (IInspectable *)&impl->IUISettings3_iface;
