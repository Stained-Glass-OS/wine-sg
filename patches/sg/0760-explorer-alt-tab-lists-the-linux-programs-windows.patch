From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Alt+Tab lists the Linux programs' windows

Task View showed the session's Linux programs' windows (cards, by the
taskbar's stand-ins); Alt+Tab's switcher left them out, so Linux and
Windows programs could not be switched between with the keyboard (David
2026-10-01: Linux and Windows programs first class). They are listed now,
on every desktop, as a card with their icon; chosen, the Linux window comes
forward (XACTIVATE).

Gate: test/taskview-linux-gate.sh (mutant SG_MUTANT_ALTTAB_NO_LINUX fails it).
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -1344,6 +1344,11 @@
     HWND target = sw.sel >= 0 && sw.sel < sw.n ? sw.items[sw.sel] : 0;
     DestroyWindow( hwnd );
     if (!target) return;
+    if (is_linux_window( target ))
+    {
+        sg_linux_window_command( target, L"XACTIVATE" );
+        return;
+    }
     if (IsIconic( target )) ShowWindow( target, SW_RESTORE );
     SetForegroundWindow( target );
 }
@@ -1352,6 +1357,16 @@
 {
     int d;
     if (sw.n >= ARRAY_SIZE(sw.items)) return FALSE;
+    /* Stained Glass OS: the session's Linux programs' windows too, by their
+     * hidden stand-ins, on every desktop, as in Task View (a card with their
+     * icon); chosen, they come forward (XACTIVATE) */
+#ifndef SG_MUTANT_ALTTAB_NO_LINUX
+    if (is_linux_window( hwnd ))
+    {
+        sw.items[sw.n++] = hwnd;
+        return TRUE;
+    }
+#endif
     if (!IsWindowVisible( hwnd ) || !is_app_window( hwnd )) return TRUE;
     if ((d = desktop_of( hwnd )) >= 0 && d != vd_current) return TRUE;
     sw.items[sw.n++] = hwnd;
@@ -1464,7 +1479,7 @@
     sw.n = 0;
     EnumWindows( switcher_collect, 0 );
     if (sw.n < 1) return;
-    for (i = 0; i < sw.n; i++) capture_thumb( sw.items[i] );
+    for (i = 0; i < sw.n; i++) if (!is_linux_window( sw.items[i] )) capture_thumb( sw.items[i] );
     /* the first press already moves to the previous window, as on Windows */
     sw.sel = sw.n > 1 ? (back ? sw.n - 1 : 1) : 0;
     w = min( sw.n, (GetSystemMetrics( SM_CXSCREEN ) - 64) / SW_CELL_W ) * SW_CELL_W + 32;
