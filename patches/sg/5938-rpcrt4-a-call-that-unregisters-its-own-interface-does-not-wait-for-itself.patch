From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: a call that unregisters its own interface does not wait for itself

COM unregisters an object's interface (RpcServerUnregisterIf, waiting for its
calls to complete) when the call that ends the object releases its last stub
(dispatch_rpc -> stub_manager_int_release), holding combase's list of
registered interfaces meanwhile. That call is one of the calls waited for, so
it waited for itself forever, and every later COM marshal in the process
queued behind the list: Microsoft Office's Click-to-Run service never took
setup's first task and setup stayed at 1% (fresh install, 2026-10-19).

rpcrt4 now keeps the server interface whose call each thread runs; a waiting
unregister from inside a call on that interface does not wait (the interface
goes when its calls end, as without the wait). Gate: test-rpcselfunreg; mutant
SG_MUTANT_UNREGISTER_WAITS_FOR_ITSELF hangs it.
---
--- a/dlls/rpcrt4/rpcrt4_main.c
+++ b/dlls/rpcrt4/rpcrt4_main.c
@@ -93,6 +93,8 @@
     DWORD thread_id;
     RpcConnection *connection;
     RpcBinding *server_binding;
+    /* the server interface whose call this thread is running, or NULL */
+    void *server_interface;
     struct context_handle_list *context_handle_list;
     /* seconds to wait for a server to answer a cancelled call: RpcMgmtSetCancelTimeout */
     LONG cancel_timeout;
@@ -1028,6 +1030,18 @@
     tdata->server_binding = Binding;
 }
 
+void RPCRT4_SetThreadCurrentServerInterface(void *sif)
+{
+    struct threaddata *tdata = get_or_create_threaddata();
+    if (tdata) tdata->server_interface = sif;
+}
+
+void *RPCRT4_GetThreadCurrentServerInterface(void)
+{
+    struct threaddata *tdata = get_or_create_threaddata();
+    return tdata ? tdata->server_interface : NULL;
+}
+
 RpcBinding *RPCRT4_GetThreadCurrentCallHandle(void)
 {
     struct threaddata *tdata = get_or_create_threaddata();
--- a/dlls/rpcrt4/rpc_binding.h
+++ b/dlls/rpcrt4/rpc_binding.h
@@ -269,6 +269,8 @@
 LONG RPCRT4_GetThreadCancelTimeout(void);
 void RPCRT4_SetThreadCurrentCallHandle(RpcBinding *Binding);
 RpcBinding *RPCRT4_GetThreadCurrentCallHandle(void);
+void RPCRT4_SetThreadCurrentServerInterface(void *sif);
+void *RPCRT4_GetThreadCurrentServerInterface(void);
 void RPCRT4_PushThreadContextHandle(NDR_SCONTEXT SContext);
 void RPCRT4_RemoveThreadContextHandle(NDR_SCONTEXT SContext);
 NDR_SCONTEXT RPCRT4_PopThreadContextHandle(void);
--- a/dlls/rpcrt4/rpc_server.c
+++ b/dlls/rpcrt4/rpc_server.c
@@ -367,6 +367,7 @@
   RpcServerInterface* sif;
   RPC_DISPATCH_FUNCTION func;
   BOOL exception;
+  void *prev_sif;
   UUID *object_uuid;
   NDR_SCONTEXT context_handle;
   void *buf = msg->Buffer;
@@ -435,6 +436,8 @@
 
   /* dispatch */
   RPCRT4_SetThreadCurrentCallHandle(msg->Handle);
+  prev_sif = RPCRT4_GetThreadCurrentServerInterface();
+  RPCRT4_SetThreadCurrentServerInterface(sif);
   __TRY {
     if (func) func(msg);
   } __EXCEPT_ALL {
@@ -448,6 +451,7 @@
                                        RPC2NCA_STATUS(status));
   } __ENDTRY
     RPCRT4_SetThreadCurrentCallHandle(NULL);
+  RPCRT4_SetThreadCurrentServerInterface(prev_sif);
 
   /* release any unmarshalled context handles */
   while ((context_handle = RPCRT4_PopThreadContextHandle()) != NULL)
@@ -1267,7 +1271,17 @@
       if (cif->CurrentCalls) {
         completed = FALSE;
         cif->Delete = TRUE;
+        /* Stained Glass: a call on this interface that unregisters it (COM
+         * releasing an object's last stub when the call that ends it returns
+         * holds combase's interface list meanwhile) cannot wait for itself:
+         * the interface goes when the calls end, without waiting. A waiting
+         * Click-to-Run service froze every COM call after (Office setup at
+         * 1%). */
+#ifndef SG_MUTANT_UNREGISTER_WAITS_FOR_ITSELF
+        if (WaitForCallsToComplete && RPCRT4_GetThreadCurrentServerInterface() != cif)
+#else
         if (WaitForCallsToComplete)
+#endif
           cif->CallsCompletedEvent = event = CreateEventW(NULL, FALSE, FALSE, NULL);
       }
       found = TRUE;
