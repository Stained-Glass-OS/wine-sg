+/* ---- read-only collections that are always empty ---- */
+
+#define EMPTY_COLLECTION( Type, type, ItemType ) \
+struct type##_empty \
+{ \
+    Type Type##_iface; \
+    LONG refs; \
+}; \
+static inline struct type##_empty *type##_impl( Type *iface ) \
+{ \
+    return CONTAINING_RECORD( iface, struct type##_empty, Type##_iface ); \
+} \
+static HRESULT WINAPI type##_QueryInterface( Type *iface, REFIID riid, void **obj ) \
+{ \
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj ); \
+    if (IsEqualGUID( riid, &IID_##Type ) || IsEqualGUID( riid, &IID_IDispatch ) || \
+        IsEqualGUID( riid, &IID_IUnknown )) \
+    { \
+        *obj = iface; \
+        Type##_AddRef( iface ); \
+        return S_OK; \
+    } \
+    *obj = NULL; \
+    return E_NOINTERFACE; \
+} \
+static ULONG WINAPI type##_AddRef( Type *iface ) \
+{ \
+    return InterlockedIncrement( &type##_impl( iface )->refs ); \
+} \
+static ULONG WINAPI type##_Release( Type *iface ) \
+{ \
+    struct type##_empty *This = type##_impl( iface ); \
+    LONG refs = InterlockedDecrement( &This->refs ); \
+    if (!refs) free( This ); \
+    return refs; \
+} \
+static HRESULT WINAPI type##_GetTypeInfoCount( Type *iface, UINT *count ) \
+{ \
+    return wu_GetTypeInfoCount( count ); \
+} \
+static HRESULT WINAPI type##_GetTypeInfo( Type *iface, UINT index, LCID lcid, ITypeInfo **info ) \
+{ \
+    return wu_GetTypeInfo( &IID_##Type, index, lcid, info ); \
+} \
+static HRESULT WINAPI type##_GetIDsOfNames( Type *iface, REFIID riid, LPOLESTR *names, UINT count, \
+                                            LCID lcid, DISPID *dispid ) \
+{ \
+    return wu_GetIDsOfNames( &IID_##Type, riid, names, count, lcid, dispid ); \
+} \
+static HRESULT WINAPI type##_Invoke( Type *iface, DISPID id, REFIID riid, LCID lcid, WORD flags, \
+                                     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err ) \
+{ \
+    return wu_Invoke( (IDispatch *)iface, &IID_##Type, id, riid, lcid, flags, params, result, excep, arg_err ); \
+} \
+static HRESULT WINAPI type##_get_Item( Type *iface, LONG index, ItemType **item ) \
+{ \
+    TRACE( "%p, %ld, %p\n", iface, index, item ); \
+    if (!item) return E_POINTER; \
+    *item = NULL; \
+    return E_INVALIDARG; \
+} \
+static HRESULT WINAPI type##_get__NewEnum( Type *iface, IUnknown **enum_ret ) \
+{ \
+    VARIANT *items; \
+    HRESULT hr; \
+    TRACE( "%p, %p\n", iface, enum_ret ); \
+    if (!enum_ret) return E_POINTER; \
+    if (!(items = calloc( 1, sizeof(*items) ))) return E_OUTOFMEMORY; \
+    hr = create_enum( items, 0, 0, (IEnumVARIANT **)enum_ret ); \
+    return hr; \
+} \
+static HRESULT WINAPI type##_get_Count( Type *iface, LONG *count ) \
+{ \
+    TRACE( "%p, %p\n", iface, count ); \
+    if (!count) return E_POINTER; \
+    *count = 0; \
+    return S_OK; \
+} \
+static const Type##Vtbl type##_vtbl = \
+{ \
+    type##_QueryInterface, \
+    type##_AddRef, \
+    type##_Release, \
+    type##_GetTypeInfoCount, \
+    type##_GetTypeInfo, \
+    type##_GetIDsOfNames, \
+    type##_Invoke, \
+    type##_get_Item, \
+    type##_get__NewEnum, \
+    type##_get_Count, \
+}; \
+static HRESULT Type##_create_empty( Type **ret ) \
+{ \
+    struct type##_empty *This; \
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY; \
+    This->Type##_iface.lpVtbl = &type##_vtbl; \
+    This->refs = 1; \
+    *ret = &This->Type##_iface; \
+    return S_OK; \
+}
+
+EMPTY_COLLECTION( ICategoryCollection, category_collection, ICategory )
+EMPTY_COLLECTION( IUpdateExceptionCollection, exception_collection, IUpdateException )
+EMPTY_COLLECTION( IUpdateHistoryEntryCollection, history_collection, IUpdateHistoryEntry )
+
+HRESULT CategoryCollection_create( ICategoryCollection **ret ) { return ICategoryCollection_create_empty( ret ); }
+HRESULT UpdateExceptionCollection_create( IUpdateExceptionCollection **ret ) { return IUpdateExceptionCollection_create_empty( ret ); }
+HRESULT UpdateHistoryEntryCollection_create( IUpdateHistoryEntryCollection **ret ) { return IUpdateHistoryEntryCollection_create_empty( ret ); }
+
+/* ---- IStringCollection ---- */
+
+struct string_collection
+{
+    IStringCollection IStringCollection_iface;
+    LONG refs;
+    BSTR *items;
+    LONG count, allocated;
+};
+
+static inline struct string_collection *impl_from_IStringCollection( IStringCollection *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_collection, IStringCollection_iface );
+}
+
+static HRESULT WINAPI strcoll_QueryInterface( IStringCollection *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IStringCollection ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IStringCollection_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI strcoll_AddRef( IStringCollection *iface )
+{
+    return InterlockedIncrement( &impl_from_IStringCollection( iface )->refs );
+}
+
+static ULONG WINAPI strcoll_Release( IStringCollection *iface )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    LONG i;
+
+    if (!refs)
+    {
+        for (i = 0; i < This->count; i++) SysFreeString( This->items[i] );
+        free( This->items );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI strcoll_GetTypeInfoCount( IStringCollection *iface, UINT *count )
+{
+    return wu_GetTypeInfoCount( count );
+}
+
+static HRESULT WINAPI strcoll_GetTypeInfo( IStringCollection *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return wu_GetTypeInfo( &IID_IStringCollection, index, lcid, info );
+}
+
+static HRESULT WINAPI strcoll_GetIDsOfNames( IStringCollection *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                             LCID lcid, DISPID *dispid )
+{
+    return wu_GetIDsOfNames( &IID_IStringCollection, riid, names, count, lcid, dispid );
+}
+
+static HRESULT WINAPI strcoll_Invoke( IStringCollection *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                      DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return wu_Invoke( (IDispatch *)iface, &IID_IStringCollection, id, riid, lcid, flags, params, result, excep,
+                      arg_err );
+}
+
+static HRESULT WINAPI strcoll_get_Item( IStringCollection *iface, LONG index, BSTR *ret )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+
+    TRACE( "%p, %ld, %p\n", iface, index, ret );
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    if (index < 0 || index >= This->count) return E_INVALIDARG;
+    return wu_get_bstr( This->items[index], ret );
+}
+
+static HRESULT WINAPI strcoll_put_Item( IStringCollection *iface, LONG index, BSTR value )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+    BSTR copy;
+
+    TRACE( "%p, %ld, %s\n", iface, index, debugstr_w(value) );
+
+    if (index < 0 || index >= This->count) return E_INVALIDARG;
+    if (!(copy = SysAllocString( value ? value : L"" ))) return E_OUTOFMEMORY;
+    SysFreeString( This->items[index] );
+    This->items[index] = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI strcoll_get__NewEnum( IStringCollection *iface, IUnknown **ret )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+    VARIANT *items;
+    LONG i;
+
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    if (!(items = calloc( This->count ? This->count : 1, sizeof(*items) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        V_VT(&items[i]) = VT_BSTR;
+        V_BSTR(&items[i]) = SysAllocString( This->items[i] );
+    }
+    return create_enum( items, This->count, 0, (IEnumVARIANT **)ret );
+}
+
+static HRESULT WINAPI strcoll_get_Count( IStringCollection *iface, LONG *count )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+
+    TRACE( "%p, %p\n", iface, count );
+
+    if (!count) return E_POINTER;
+    *count = This->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI strcoll_get_ReadOnly( IStringCollection *iface, VARIANT_BOOL *ret )
+{
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    *ret = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT strcoll_insert( struct string_collection *This, LONG index, BSTR value )
+{
+    BSTR copy;
+
+    if (index < 0 || index > This->count) return E_INVALIDARG;
+    if (This->count == This->allocated)
+    {
+        LONG size = This->allocated ? This->allocated * 2 : 8;
+        BSTR *tmp = realloc( This->items, size * sizeof(*tmp) );
+        if (!tmp) return E_OUTOFMEMORY;
+        This->items = tmp;
+        This->allocated = size;
+    }
+    if (!(copy = SysAllocString( value ? value : L"" ))) return E_OUTOFMEMORY;
+    memmove( &This->items[index + 1], &This->items[index], (This->count - index) * sizeof(*This->items) );
+    This->items[index] = copy;
+    This->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI strcoll_Add( IStringCollection *iface, BSTR value, LONG *index )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(value), index );
+
+    if (!index) return E_POINTER;
+    if (SUCCEEDED(hr = strcoll_insert( This, This->count, value ))) *index = This->count - 1;
+    return hr;
+}
+
+static HRESULT WINAPI strcoll_Clear( IStringCollection *iface )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+    LONG i;
+
+    TRACE( "%p\n", iface );
+
+    for (i = 0; i < This->count; i++) SysFreeString( This->items[i] );
+    This->count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI strcoll_Copy( IStringCollection *iface, IStringCollection **ret )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface ), *copy;
+    IStringCollection *new_coll;
+    LONG i;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    if (FAILED(hr = StringCollection_create( &new_coll ))) return hr;
+    copy = impl_from_IStringCollection( new_coll );
+    for (i = 0; i < This->count; i++)
+    {
+        if (FAILED(hr = strcoll_insert( copy, copy->count, This->items[i] )))
+        {
+            IStringCollection_Release( new_coll );
+            return hr;
+        }
+    }
+    *ret = new_coll;
+    return S_OK;
+}
+
+static HRESULT WINAPI strcoll_Insert( IStringCollection *iface, LONG index, BSTR value )
+{
+    TRACE( "%p, %ld, %s\n", iface, index, debugstr_w(value) );
+
+    return strcoll_insert( impl_from_IStringCollection( iface ), index, value );
+}
+
+static HRESULT WINAPI strcoll_RemoveAt( IStringCollection *iface, LONG index )
+{
+    struct string_collection *This = impl_from_IStringCollection( iface );
+
+    TRACE( "%p, %ld\n", iface, index );
+
+    if (index < 0 || index >= This->count) return E_INVALIDARG;
+    SysFreeString( This->items[index] );
+    memmove( &This->items[index], &This->items[index + 1], (This->count - index - 1) * sizeof(*This->items) );
+    This->count--;
+    return S_OK;
+}
+
+static const IStringCollectionVtbl strcoll_vtbl =
+{
+    strcoll_QueryInterface,
+    strcoll_AddRef,
+    strcoll_Release,
+    strcoll_GetTypeInfoCount,
+    strcoll_GetTypeInfo,
+    strcoll_GetIDsOfNames,
+    strcoll_Invoke,
+    strcoll_get_Item,
+    strcoll_put_Item,
+    strcoll_get__NewEnum,
+    strcoll_get_Count,
+    strcoll_get_ReadOnly,
+    strcoll_Add,
+    strcoll_Clear,
+    strcoll_Copy,
+    strcoll_Insert,
+    strcoll_RemoveAt,
+};
+
+HRESULT StringCollection_create( IStringCollection **ret )
+{
+    struct string_collection *This;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->IStringCollection_iface.lpVtbl = &strcoll_vtbl;
+    This->refs = 1;
+    *ret = &This->IStringCollection_iface;
+    return S_OK;
+}
+
+/* ---- IUpdateCollection ---- */
+
+struct update_collection
+{
+    IUpdateCollection IUpdateCollection_iface;
+    LONG refs;
+    IUpdate **items;
+    LONG count, allocated;
+};
+
+static inline struct update_collection *impl_from_IUpdateCollection( IUpdateCollection *iface )
+{
+    return CONTAINING_RECORD( iface, struct update_collection, IUpdateCollection_iface );
+}
+
+static HRESULT WINAPI updcoll_QueryInterface( IUpdateCollection *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IUpdateCollection ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IUpdateCollection_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI updcoll_AddRef( IUpdateCollection *iface )
+{
+    return InterlockedIncrement( &impl_from_IUpdateCollection( iface )->refs );
+}
+
+static ULONG WINAPI updcoll_Release( IUpdateCollection *iface )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    LONG i;
+
+    if (!refs)
+    {
+        for (i = 0; i < This->count; i++) IUpdate_Release( This->items[i] );
+        free( This->items );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI updcoll_GetTypeInfoCount( IUpdateCollection *iface, UINT *count )
+{
+    return wu_GetTypeInfoCount( count );
+}
+
+static HRESULT WINAPI updcoll_GetTypeInfo( IUpdateCollection *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return wu_GetTypeInfo( &IID_IUpdateCollection, index, lcid, info );
+}
+
+static HRESULT WINAPI updcoll_GetIDsOfNames( IUpdateCollection *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                             LCID lcid, DISPID *dispid )
+{
+    return wu_GetIDsOfNames( &IID_IUpdateCollection, riid, names, count, lcid, dispid );
+}
+
+static HRESULT WINAPI updcoll_Invoke( IUpdateCollection *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                      DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return wu_Invoke( (IDispatch *)iface, &IID_IUpdateCollection, id, riid, lcid, flags, params, result, excep,
+                      arg_err );
+}
+
+static HRESULT WINAPI updcoll_get_Item( IUpdateCollection *iface, LONG index, IUpdate **ret )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+
+    TRACE( "%p, %ld, %p\n", iface, index, ret );
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    if (index < 0 || index >= This->count) return E_INVALIDARG;
+    *ret = This->items[index];
+    IUpdate_AddRef( *ret );
+    return S_OK;
+}
+
+static HRESULT WINAPI updcoll_put_Item( IUpdateCollection *iface, LONG index, IUpdate *value )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+
+    TRACE( "%p, %ld, %p\n", iface, index, value );
+
+    if (!value) return E_POINTER;
+    if (index < 0 || index >= This->count) return E_INVALIDARG;
+    IUpdate_AddRef( value );
+    IUpdate_Release( This->items[index] );
+    This->items[index] = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI updcoll_get__NewEnum( IUpdateCollection *iface, IUnknown **ret )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+    VARIANT *items;
+    LONG i;
+
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    if (!(items = calloc( This->count ? This->count : 1, sizeof(*items) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        V_VT(&items[i]) = VT_DISPATCH;
+        V_DISPATCH(&items[i]) = (IDispatch *)This->items[i];
+        IDispatch_AddRef( V_DISPATCH(&items[i]) );
+    }
+    return create_enum( items, This->count, 0, (IEnumVARIANT **)ret );
+}
+
+static HRESULT WINAPI updcoll_get_Count( IUpdateCollection *iface, LONG *count )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+
+    TRACE( "%p, %p\n", iface, count );
+
+    if (!count) return E_POINTER;
+    *count = This->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI updcoll_get_ReadOnly( IUpdateCollection *iface, VARIANT_BOOL *ret )
+{
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    *ret = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT updcoll_insert( struct update_collection *This, LONG index, IUpdate *value )
+{
+    if (!value) return E_POINTER;
+    if (index < 0 || index > This->count) return E_INVALIDARG;
+    if (This->count == This->allocated)
+    {
+        LONG size = This->allocated ? This->allocated * 2 : 8;
+        IUpdate **tmp = realloc( This->items, size * sizeof(*tmp) );
+        if (!tmp) return E_OUTOFMEMORY;
+        This->items = tmp;
+        This->allocated = size;
+    }
+    memmove( &This->items[index + 1], &This->items[index], (This->count - index) * sizeof(*This->items) );
+    IUpdate_AddRef( value );
+    This->items[index] = value;
+    This->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI updcoll_Add( IUpdateCollection *iface, IUpdate *value, LONG *index )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %p, %p\n", iface, value, index );
+
+    if (!index) return E_POINTER;
+    if (SUCCEEDED(hr = updcoll_insert( This, This->count, value ))) *index = This->count - 1;
+    return hr;
+}
+
+static HRESULT WINAPI updcoll_Clear( IUpdateCollection *iface )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+    LONG i;
+
+    TRACE( "%p\n", iface );
+
+    for (i = 0; i < This->count; i++) IUpdate_Release( This->items[i] );
+    This->count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI updcoll_Copy( IUpdateCollection *iface, IUpdateCollection **ret )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface ), *copy;
+    IUpdateCollection *new_coll;
+    LONG i;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    if (FAILED(hr = UpdateCollection_create( &new_coll ))) return hr;
+    copy = impl_from_IUpdateCollection( new_coll );
+    for (i = 0; i < This->count; i++)
+    {
+        if (FAILED(hr = updcoll_insert( copy, copy->count, This->items[i] )))
+        {
+            IUpdateCollection_Release( new_coll );
+            return hr;
+        }
+    }
+    *ret = new_coll;
+    return S_OK;
+}
+
+static HRESULT WINAPI updcoll_Insert( IUpdateCollection *iface, LONG index, IUpdate *value )
+{
+    TRACE( "%p, %ld, %p\n", iface, index, value );
+
+    return updcoll_insert( impl_from_IUpdateCollection( iface ), index, value );
+}
+
+static HRESULT WINAPI updcoll_RemoveAt( IUpdateCollection *iface, LONG index )
+{
+    struct update_collection *This = impl_from_IUpdateCollection( iface );
+
+    TRACE( "%p, %ld\n", iface, index );
+
+    if (index < 0 || index >= This->count) return E_INVALIDARG;
+    IUpdate_Release( This->items[index] );
+    memmove( &This->items[index], &This->items[index + 1], (This->count - index - 1) * sizeof(*This->items) );
+    This->count--;
+    return S_OK;
+}
+
+static const IUpdateCollectionVtbl updcoll_vtbl =
+{
+    updcoll_QueryInterface,
+    updcoll_AddRef,
+    updcoll_Release,
+    updcoll_GetTypeInfoCount,
+    updcoll_GetTypeInfo,
+    updcoll_GetIDsOfNames,
+    updcoll_Invoke,
+    updcoll_get_Item,
+    updcoll_put_Item,
+    updcoll_get__NewEnum,
+    updcoll_get_Count,
+    updcoll_get_ReadOnly,
+    updcoll_Add,
+    updcoll_Clear,
+    updcoll_Copy,
+    updcoll_Insert,
+    updcoll_RemoveAt,
+};
+
+HRESULT UpdateCollection_create( IUpdateCollection **ret )
+{
+    struct update_collection *This;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->IUpdateCollection_iface.lpVtbl = &updcoll_vtbl;
+    This->refs = 1;
+    *ret = &This->IUpdateCollection_iface;
+    return S_OK;
+}
+
+/* ---- ISearchResult: what a search over a system that has no update source finds ---- */
+
+struct search_result
+{
+    ISearchResult ISearchResult_iface;
+    LONG refs;
+};
+
+static inline struct search_result *impl_from_ISearchResult( ISearchResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct search_result, ISearchResult_iface );
+}
+
+static HRESULT WINAPI result_QueryInterface( ISearchResult *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_ISearchResult ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        ISearchResult_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI result_AddRef( ISearchResult *iface )
+{
+    return InterlockedIncrement( &impl_from_ISearchResult( iface )->refs );
+}
+
+static ULONG WINAPI result_Release( ISearchResult *iface )
+{
+    struct search_result *This = impl_from_ISearchResult( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+
+    if (!refs) free( This );
+    return refs;
+}
+
+static HRESULT WINAPI result_GetTypeInfoCount( ISearchResult *iface, UINT *count )
+{
+    return wu_GetTypeInfoCount( count );
+}
+
+static HRESULT WINAPI result_GetTypeInfo( ISearchResult *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return wu_GetTypeInfo( &IID_ISearchResult, index, lcid, info );
+}
+
+static HRESULT WINAPI result_GetIDsOfNames( ISearchResult *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                            LCID lcid, DISPID *dispid )
+{
+    return wu_GetIDsOfNames( &IID_ISearchResult, riid, names, count, lcid, dispid );
+}
+
+static HRESULT WINAPI result_Invoke( ISearchResult *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return wu_Invoke( (IDispatch *)iface, &IID_ISearchResult, id, riid, lcid, flags, params, result, excep,
+                      arg_err );
+}
+
+static HRESULT WINAPI result_get_ResultCode( ISearchResult *iface, OperationResultCode *code )
+{
+    TRACE( "%p, %p\n", iface, code );
+
+    if (!code) return E_POINTER;
+    *code = orcSucceeded;
+    return S_OK;
+}
+
+static HRESULT WINAPI result_get_RootCategories( ISearchResult *iface, ICategoryCollection **ret )
+{
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    return CategoryCollection_create( ret );
+}
+
+static HRESULT WINAPI result_get_Updates( ISearchResult *iface, IUpdateCollection **ret )
+{
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    return UpdateCollection_create( ret );
+}
+
+static HRESULT WINAPI result_get_Warnings( ISearchResult *iface, IUpdateExceptionCollection **ret )
+{
+    TRACE( "%p, %p\n", iface, ret );
+
+    if (!ret) return E_POINTER;
+    return UpdateExceptionCollection_create( ret );
+}
+
+static const ISearchResultVtbl result_vtbl =
+{
+    result_QueryInterface,
+    result_AddRef,
+    result_Release,
+    result_GetTypeInfoCount,
+    result_GetTypeInfo,
+    result_GetIDsOfNames,
+    result_Invoke,
+    result_get_ResultCode,
+    result_get_RootCategories,
+    result_get_Updates,
+    result_get_Warnings,
+};
+
+HRESULT SearchResult_create( ISearchResult **ret )
+{
+    struct search_result *This;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->ISearchResult_iface.lpVtbl = &result_vtbl;
+    This->refs = 1;
+    *ret = &This->ISearchResult_iface;
+    return S_OK;
+}
