+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "ole2.h"
+#include "wuapi.h"
+
+#include "wine/debug.h"
+#include "wuapi_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wuapi);
+
+#define MAX_TYPEINFOS 32
+
+static ITypeLib *typelib;
+static struct { const GUID *iid; ITypeInfo *info; } typeinfos[MAX_TYPEINFOS];
+static CRITICAL_SECTION typelib_cs;
+static CRITICAL_SECTION_DEBUG typelib_cs_debug =
+{
+    0, 0, &typelib_cs,
+    { &typelib_cs_debug.ProcessLocksList, &typelib_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": typelib_cs") }
+};
+static CRITICAL_SECTION typelib_cs = { &typelib_cs_debug, -1, 0, 0, 0, 0 };
+
+static HRESULT load_typelib(void)
+{
+    WCHAR path[MAX_PATH];
+    HMODULE module;
+    ITypeLib *lib;
+    HRESULT hr;
+
+    if (typelib) return S_OK;
+
+    if (!GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                             (const WCHAR *)load_typelib, &module ) ||
+        !GetModuleFileNameW( module, path, ARRAY_SIZE(path) ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+
+    if (FAILED(hr = LoadTypeLibEx( path, REGKIND_NONE, &lib ))) return hr;
+    if (InterlockedCompareExchangePointer( (void **)&typelib, lib, NULL )) ITypeLib_Release( lib );
+    return S_OK;
+}
+
+HRESULT wu_get_typeinfo( REFIID iid, ITypeInfo **info )
+{
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = load_typelib())) return hr;
+
+    EnterCriticalSection( &typelib_cs );
+    for (i = 0; i < MAX_TYPEINFOS && typeinfos[i].iid; i++)
+    {
+        if (IsEqualGUID( typeinfos[i].iid, iid ))
+        {
+            *info = typeinfos[i].info;
+            ITypeInfo_AddRef( *info );
+            LeaveCriticalSection( &typelib_cs );
+            return S_OK;
+        }
+    }
+
+    hr = ITypeLib_GetTypeInfoOfGuid( typelib, iid, info );
+    if (SUCCEEDED(hr) && i < MAX_TYPEINFOS)
+    {
+        typeinfos[i].iid = iid;
+        typeinfos[i].info = *info;
+        ITypeInfo_AddRef( *info );
+    }
+    LeaveCriticalSection( &typelib_cs );
+    return hr;
+}
+
+void wu_release_typelib(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_TYPEINFOS && typeinfos[i].iid; i++) ITypeInfo_Release( typeinfos[i].info );
+    if (typelib) ITypeLib_Release( typelib );
+}
+
+HRESULT wu_GetTypeInfoCount( UINT *count )
+{
+    if (!count) return E_POINTER;
+    *count = 1;
+    return S_OK;
+}
+
+HRESULT wu_GetTypeInfo( REFIID iid, UINT index, LCID lcid, ITypeInfo **info )
+{
+    TRACE( "%s, %u, %#lx, %p\n", debugstr_guid(iid), index, lcid, info );
+
+    if (!info) return E_POINTER;
+    *info = NULL;
+    if (index) return DISP_E_BADINDEX;
+    return wu_get_typeinfo( iid, info );
+}
+
+HRESULT wu_GetIDsOfNames( REFIID iid, REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *dispid )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    TRACE( "%s, %p, %u, %#lx, %p\n", debugstr_guid(iid), names, count, lcid, dispid );
+
+    if (!IsEqualGUID( riid, &IID_NULL )) return DISP_E_UNKNOWNINTERFACE;
+    if (!names || !count || !dispid) return E_INVALIDARG;
+
+    if (SUCCEEDED(hr = wu_get_typeinfo( iid, &info )))
+    {
+        hr = ITypeInfo_GetIDsOfNames( info, names, count, dispid );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+HRESULT wu_Invoke( IDispatch *iface, REFIID iid, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                   DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %ld, %#x\n", iface, debugstr_guid(iid), id, flags );
+
+    if (!IsEqualGUID( riid, &IID_NULL )) return DISP_E_UNKNOWNINTERFACE;
+
+    if (SUCCEEDED(hr = wu_get_typeinfo( iid, &info )))
+    {
+        hr = ITypeInfo_Invoke( info, iface, id, flags, params, result, excep, arg_err );
+        ITypeInfo_Release( info );
+    }
+    return hr;
+}
+
+/* a BSTR property kept by an object */
+HRESULT wu_get_bstr( BSTR value, BSTR *ret )
+{
+    if (!ret) return E_POINTER;
+    *ret = SysAllocString( value ? value : L"" );
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+HRESULT wu_put_bstr( BSTR *dst, BSTR value )
+{
+    BSTR copy = NULL;
+
+    if (value && !(copy = SysAllocString( value ))) return E_OUTOFMEMORY;
+    SysFreeString( *dst );
+    *dst = copy;
+    return S_OK;
+}
