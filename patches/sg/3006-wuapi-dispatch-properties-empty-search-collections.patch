+/* ---- IEnumVARIANT over a snapshot ---- */
+
+struct snapshot_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    VARIANT *items;
+    LONG count, pos;
+};
+
+static inline struct snapshot_enum *impl_from_IEnumVARIANT( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, struct snapshot_enum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IEnumVARIANT ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumVARIANT( iface )->refs );
+}
+
+static ULONG WINAPI enum_Release( IEnumVARIANT *iface )
+{
+    struct snapshot_enum *This = impl_from_IEnumVARIANT( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    LONG i;
+
+    if (!refs)
+    {
+        for (i = 0; i < This->count; i++) VariantClear( &This->items[i] );
+        free( This->items );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI enum_Next( IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched )
+{
+    struct snapshot_enum *This = impl_from_IEnumVARIANT( iface );
+    ULONG n = 0;
+
+    if (fetched) *fetched = 0;
+    if (celt && !var) return E_INVALIDARG;
+
+    while (n < celt && This->pos < This->count)
+    {
+        VariantInit( &var[n] );
+        if (FAILED(VariantCopy( &var[n], &This->items[This->pos] ))) break;
+        n++;
+        This->pos++;
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_Skip( IEnumVARIANT *iface, ULONG celt )
+{
+    struct snapshot_enum *This = impl_from_IEnumVARIANT( iface );
+
+    if (celt > (ULONG)(This->count - This->pos))
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_Reset( IEnumVARIANT *iface )
+{
+    impl_from_IEnumVARIANT( iface )->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl enum_vtbl;
+
+/* takes ownership of the items */
+static HRESULT create_enum( VARIANT *items, LONG count, LONG pos, IEnumVARIANT **ret )
+{
+    struct snapshot_enum *This;
+
+    if (!(This = calloc( 1, sizeof(*This) )))
+    {
+        LONG i;
+        for (i = 0; i < count; i++) VariantClear( &items[i] );
+        free( items );
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumVARIANT_iface.lpVtbl = &enum_vtbl;
+    This->refs = 1;
+    This->items = items;
+    This->count = count;
+    This->pos = pos;
+    *ret = &This->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **ret )
+{
+    struct snapshot_enum *This = impl_from_IEnumVARIANT( iface );
+    VARIANT *copy;
+    LONG i;
+
+    if (!ret) return E_POINTER;
+    if (!(copy = calloc( This->count ? This->count : 1, sizeof(*copy) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++) VariantCopy( &copy[i], &This->items[i] );
+    return create_enum( copy, This->count, This->pos, ret );
+}
+
+static const IEnumVARIANTVtbl enum_vtbl =
+{
+    enum_QueryInterface,
+    enum_AddRef,
+    enum_Release,
+    enum_Next,
+    enum_Skip,
+    enum_Reset,
+    enum_Clone,
+};
