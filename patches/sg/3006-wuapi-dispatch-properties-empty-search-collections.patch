+    for (i = 0; i < len; i++) if (unescaped[i] == '\'') quotes++;
+    if (!(ret = SysAllocStringLen( NULL, len + quotes ))) return E_OUTOFMEMORY;
+    for (dst = ret, i = 0; i < len; i++)
+    {
+        if (unescaped[i] == '\'') *dst++ = '\'';
+        *dst++ = unescaped[i];
+    }
+    *retval = ret;
+    return S_OK;
 }
 
