diff --git a/dlls/windows.ui.xaml/flyouts.c b/dlls/windows.ui.xaml/flyouts.c
index a1b0eb4..cd14c4f 100644
--- a/dlls/windows.ui.xaml/flyouts.c
+++ b/dlls/windows.ui.xaml/flyouts.c
@@ -20,8 +20,11 @@
 
 /*
  * A flyout is made and given to elements as their context or selection flyout (NanaZip makes a
- * TextCommandBarFlyout for its address bar when its template is applied): its placement and
- * commands are kept and its events accepted; showing it comes with the popups.
+ * TextCommandBarFlyout for its address bar when its template is applied).  ShowAt shows it in a popup
+ * window: a menu in the desktop's colours with a button per command (its Label; a click runs it and
+ * closes the menu) -- a text flyout without commands of its own offers Cut, Copy, Paste and Select All
+ * on its target.  It opens below its target or at the pointer (a context menu), raises Opening and
+ * Opened, and closes on Hide, a command or a click elsewhere (Closed).
  */
 
 #include <stdlib.h>
@@ -48,8 +51,14 @@ struct flyout
     INT32 placement;
     struct xvector *primary, *secondary;
     struct handler_list opened, closed, opening;
+    HWND window;                    /* while shown */
+    IInspectable *menu;             /* its menu's root, while shown */
+    struct uielem *target;          /* a reference, while shown */
+    struct list entry;              /* in open_flyouts while shown */
 };
 
+static struct list open_flyouts = LIST_INIT( open_flyouts );
+
 static struct flyout *flyout_from_iface( struct xiface *iface )
 {
     return CONTAINING_RECORD( iface->obj, struct flyout, d.obj );
@@ -78,17 +87,280 @@ FLYOUT_EVENT(Opened, opened)
 FLYOUT_EVENT(Closed, closed)
 FLYOUT_EVENT(Opening, opening)
 
+static const struct xclass text_flyout_class, flyout_class;
+static struct flyout *new_flyout( BOOL text, IInspectable *outer );
+
+/* ---- shown ---- */
+
+struct menu_click
+{
+    IUnknown IUnknown_iface;        /* a RoutedEventHandler: Invoke( sender, args ) */
+    LONG ref;
+    struct flyout *flyout;          /* no reference: the menu lives only while it is shown */
+    IInspectable *command;          /* a command element to click (a reference), or NULL */
+    WCHAR text_command;             /* or a text command on the target */
+};
+
+static struct menu_click *click_from_iface( IUnknown *iface ) { return CONTAINING_RECORD( iface, struct menu_click, IUnknown_iface ); }
+
+static HRESULT WINAPI click_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    *out = iface;
+    IUnknown_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI click_AddRef( IUnknown *iface ) { return InterlockedIncrement( &click_from_iface( iface )->ref ); }
+
+static ULONG WINAPI click_Release( IUnknown *iface )
+{
+    struct menu_click *click = click_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &click->ref );
+
+    if (!ref)
+    {
+        if (click->command) IInspectable_Release( click->command );
+        free( click );
+    }
+    return ref;
+}
+
+static void flyout_hide( struct flyout *flyout );
+
+static HRESULT WINAPI click_Invoke( IUnknown *iface, IInspectable *sender, IInspectable *args )
+{
+    struct menu_click *click = click_from_iface( iface );
+    struct flyout *flyout = click->flyout;
+    struct uielem *target = flyout->target, *command = click->command ? uielem_from_inspectable( click->command ) : NULL;
+
+    TRACE( "%p: command %p %#x\n", flyout, command, click->text_command );
+    if (target) IUnknown_AddRef( target->d.obj.outer );
+    IUnknown_AddRef( iface );
+    flyout_hide( flyout );
+    if (command) xaml_button_click( command );
+    else if (target && click->text_command) xaml_text_box_command( target, click->text_command );
+    IUnknown_Release( iface );
+    if (target) IUnknown_Release( target->d.obj.outer );
+    return S_OK;
+}
+
+static const void *click_vtbl[] = { click_QueryInterface, click_AddRef, click_Release, click_Invoke };
+
+static void flyout_raise( struct flyout *flyout, struct handler_list *list )
+{
+    IInspectable *sender = NULL;
+
+    if (list_empty( &list->entries )) return;
+    if (FAILED(IUnknown_QueryInterface( flyout->d.obj.outer, &IID_IInspectable, (void **)&sender ))) return;
+    xaml_raise_routed( list, sender, NULL );
+    IInspectable_Release( sender );
+}
+
+/* a label of a command: an AppBarButton's Label, else its content text */
+static WCHAR *command_label( IInspectable *command )
+{
+    struct dobj *obj = dobj_from_inspectable( command );
+    struct xaml_property *prop;
+    IInspectable *box = NULL;
+    WCHAR *label = NULL;
+
+    if (!obj) return NULL;
+    if ((prop = xaml_property_find( L"Windows.UI.Xaml.Controls.AppBarButton", L"Label" )) ||
+        (prop = xaml_property_find( L"Windows.UI.Xaml.Controls.AppBarToggleButton", L"Label" )))
+    {
+        dobj_get_value( obj, prop, &box );
+        label = xunbox_string( box );
+        if (box) IInspectable_Release( box );
+    }
+    return label;
+}
+
+/* markup's text, escaped */
+static void append_escaped( WCHAR *buf, size_t size, const WCHAR *str )
+{
+    size_t len = wcslen( buf );
+
+    for (; *str && len + 7 < size; str++)
+    {
+        const WCHAR *rep = *str == '<' ? L"&lt;" : *str == '>' ? L"&gt;" : *str == '&' ? L"&amp;" : *str == '"' ? L"&quot;" : NULL;
+        if (rep) { wcscpy( buf + len, rep ); len += wcslen( rep ); }
+        else buf[len++] = *str;
+        buf[len] = 0;
+    }
+}
+
+#define MAX_ITEMS 32
+
+/* the menu: a button per command */
+static IInspectable *make_menu( struct flyout *flyout, struct menu_click **clicks, unsigned int *count )
+{
+    static const WCHAR *text_labels[] = { L"Cut", L"Copy", L"Paste", L"Select All" };
+    static const WCHAR text_commands[] = { 'X', 'C', 'V', 'A' };
+    IInspectable *commands[MAX_ITEMS], *root = NULL;
+    WCHAR *xaml, *labels[MAX_ITEMS];
+    unsigned int i, n = 0;
+    size_t size = 4096;
+    struct xvector *lists[2] = { flyout->primary, flyout->secondary };
+    unsigned int l;
+
+    for (l = 0; l < 2; l++)
+        for (i = 0; lists[l] && i < xvector_size( lists[l] ) && n < MAX_ITEMS; i++)
+        {
+            IInspectable *command = xvector_item( lists[l], i );
+            WCHAR *label = command_label( command );
+            if (!label || !*label) { free( label ); continue; }   /* separators, unlabeled */
+            commands[n] = command;
+            labels[n++] = label;
+        }
+    if (!n && flyout->d.obj.cls == &text_flyout_class)
+        for (i = 0; i < ARRAY_SIZE(text_labels); i++)
+        {
+            commands[n] = NULL;
+            labels[n++] = wcsdup( text_labels[i] );
+        }
+    *count = 0;
+    if (!n || !(xaml = malloc( size * sizeof(WCHAR) ))) return NULL;
+    wcscpy( xaml, L"<Border xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\""
+                  L" Background=\"{ThemeResource ControlFillColorDefaultBrush}\""
+                  L" BorderBrush=\"{ThemeResource ControlStrokeColorDefaultBrush}\" BorderThickness=\"1\" Padding=\"2\">"
+                  L"<StackPanel>" );
+    for (i = 0; i < n; i++)
+    {
+        WCHAR item[64];
+        swprintf( item, ARRAY_SIZE(item), L"<Button Name=\"Item%u\" HorizontalAlignment=\"Stretch\" Content=\"", i );
+        wcscat( xaml, item );
+        append_escaped( xaml, size - 64, labels[i] );
+        wcscat( xaml, L"\"/>" );
+    }
+    wcscat( xaml, L"</StackPanel></Border>" );
+    if (FAILED(xaml_load_text( xaml, NULL, &root ))) root = NULL;
+    free( xaml );
+    for (i = 0; root && i < n; i++)
+    {
+        struct uielem *button;
+        struct menu_click *click;
+        IInspectable *base = NULL;
+        WCHAR name[16];
+        INT64 token;
+
+        swprintf( name, ARRAY_SIZE(name), L"Item%u", i );
+        if (!(button = xaml_find_name( uielem_from_inspectable( root ), name ))) continue;
+        if (!(click = calloc( 1, sizeof(*click) ))) continue;
+        click->IUnknown_iface.lpVtbl = (void *)click_vtbl;
+        click->ref = 1;
+        click->flyout = flyout;
+        if ((click->command = commands[i])) IInspectable_AddRef( click->command );
+        else click->text_command = text_commands[i];
+        if (SUCCEEDED(IUnknown_QueryInterface( button->d.obj.outer, &IID_IButtonBase, (void **)&base )))
+        {
+            ((HRESULT (WINAPI *)( IInspectable *, IUnknown *, INT64 * ))((void **)base->lpVtbl)[IButtonBase_Click])(
+                    base, &click->IUnknown_iface, &token );
+            IInspectable_Release( base );
+        }
+        clicks[(*count)++] = click;
+    }
+    for (i = 0; i < n; i++) free( labels[i] );
+    return root;
+}
+
+/* shown below its target, or at a point of its target's window (a context menu) */
+BOOL xaml_flyout_show( IInspectable *obj, struct uielem *target, const POINT *at )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+    struct flyout *flyout;
+    struct menu_click *clicks[MAX_ITEMS];
+    unsigned int i, count;
+    struct uielem *e;
+    POINT pt = { 0, 0 };
+    HWND owner;
+
+    if (!d || (d->obj.cls != &text_flyout_class && d->obj.cls != &flyout_class)) return FALSE;
+    flyout = CONTAINING_RECORD( d, struct flyout, d );
+    if (flyout->window) flyout_hide( flyout );
+    if (!target || !(owner = xaml_element_window( target ))) return FALSE;
+    flyout_raise( flyout, &flyout->opening );
+    if (!(flyout->menu = make_menu( flyout, clicks, &count ))) return FALSE;
+    if (at) pt = *at;
+    else
+    {
+        for (e = target; e; e = e->parent)
+        {
+            pt.x += e->offset.x;
+            pt.y += e->offset.y;
+        }
+        pt.y += target->render.height;
+    }
+    ClientToScreen( owner, &pt );
+#ifdef SG_MUTANT_FLYOUT_NOT_SHOWN
+    for (i = 0; i < count; i++) IUnknown_Release( &clicks[i]->IUnknown_iface );
+    IInspectable_Release( flyout->menu );
+    flyout->menu = NULL;
+    return FALSE;
+#endif
+    for (i = 0; i < count; i++) IUnknown_Release( &clicks[i]->IUnknown_iface );   /* the buttons keep them */
+    if (!(flyout->window = xaml_popup_window_open( flyout->menu, owner, pt )))
+    {
+        IInspectable_Release( flyout->menu );
+        flyout->menu = NULL;
+        return FALSE;
+    }
+    flyout->target = target;
+    IUnknown_AddRef( target->d.obj.outer );
+    IUnknown_AddRef( flyout->d.obj.outer );   /* shown flyouts are kept */
+    list_add_tail( &open_flyouts, &flyout->entry );
+    TRACE( "%p: shown in %p at %ld,%ld\n", flyout, flyout->window, pt.x, pt.y );
+    flyout_raise( flyout, &flyout->opened );
+    return TRUE;
+}
+
+static void flyout_hide( struct flyout *flyout )
+{
+    HWND window = flyout->window;
+
+    if (!window) return;
+    flyout->window = NULL;
+    list_remove( &flyout->entry );
+    xaml_popup_window_close( window );
+    if (flyout->menu) IInspectable_Release( flyout->menu );
+    flyout->menu = NULL;
+    if (flyout->target) IUnknown_Release( flyout->target->d.obj.outer );
+    flyout->target = NULL;
+    flyout_raise( flyout, &flyout->closed );
+    IUnknown_Release( flyout->d.obj.outer );
+}
+
+void xaml_flyouts_light_dismiss( HWND clicked )
+{
+    struct flyout *flyout, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( flyout, next, &open_flyouts, struct flyout, entry )
+        if (flyout->window != clicked) flyout_hide( flyout );
+}
+
 static HRESULT WINAPI flyout_ShowAt( struct xiface *iface, IInspectable *target )
 {
-    FIXME( "%p, %p: flyouts are not shown yet\n", iface, target );
+    struct flyout *flyout = flyout_from_iface( iface );
+    struct uielem *elem = target ? uielem_from_inspectable( target ) : NULL;
+
+    TRACE( "%p, %p\n", flyout, target );
+    if (!elem) return E_INVALIDARG;
+    xaml_flyout_show( (IInspectable *)&flyout->IFlyoutBase_iface, elem, NULL );
     return S_OK;
 }
 
 static HRESULT WINAPI flyout_Hide( struct xiface *iface )
 {
+    flyout_hide( flyout_from_iface( iface ) );
     return S_OK;
 }
 
+/* a text box's context menu when it has none of its own */
+IInspectable *xaml_default_text_flyout(void)
+{
+    struct flyout *flyout = new_flyout( TRUE, NULL );
+    return flyout ? (IInspectable *)&flyout->ITextCommandBarFlyout_iface : NULL;
+}
+
 static const void *flyout_base_vtbl[] =
 {
     IFlyoutBase_STUBS,
