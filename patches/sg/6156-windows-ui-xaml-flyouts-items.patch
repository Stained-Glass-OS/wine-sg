+/* hover, pressed, selected: the desktop's highlight shades */
+static void item_host_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct item_host *host = host_from_elem( elem );
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
