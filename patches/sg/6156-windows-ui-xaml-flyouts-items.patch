+/* a container clicked: its item selected (unless the list selects nothing), ItemClick if enabled */
+void xaml_list_item_click( struct uielem *elem )
+{
+    struct item_host *host = host_from_elem( elem );
+    struct items_control *items = host->owner;
+    IInspectable **list, *sender = NULL;
+    struct click_args *args;
+    UINT32 n;
