+    if (!items) return;
+    IUnknown_AddRef( items->c.e.d.obj.outer );
+    if (get_int( &items->c.e.d, prop_selection_mode ) != 0) selector_select( items, host->index );
+    if (get_bool( &items->c.e.d, prop_item_click_enabled ) && !list_empty( &items->item_click_handlers.entries ) &&
+        SUCCEEDED(IUnknown_QueryInterface( items->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender )) &&
+        (args = calloc( 1, sizeof(*args) )))
+    {
+        n = get_items( items, &list );
+        args->IItemClickEventArgs_iface.vtbl = click_args_vtbl;
+        args->IRoutedEventArgs_iface.vtbl = click_routed_vtbl;
+        xobj_init( &args->obj, &click_args_class, NULL );
+        if (host->index < n && (args->item = list[host->index])) IInspectable_AddRef( args->item );
+        IInspectable_AddRef( (args->source = sender) );
+        free_items( list, n );
