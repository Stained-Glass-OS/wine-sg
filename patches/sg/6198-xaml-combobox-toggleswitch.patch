+/* the selection box: what the selected item's container shows (its content, or the item's template
+ * made for it), not taking clicks: they go to the combo box */
+static void combo_make_face( struct items_control *combo )
+{
+    IInspectable **list, *item = NULL, *placeholder = NULL;
+    struct uielem *face = NULL;
+    UINT32 n;
+
+    if (combo->face)
+    {
+        uielem_remove_child( &combo->c.e, combo->face );
+        combo->face = NULL;
+    }
+    combo->face_index = combo->selected_index;
+    n = get_items( combo, &list );
+    if (combo->selected_index >= 0 && (UINT32)combo->selected_index < n) item = list[combo->selected_index];
+    if (item)
+    {
+        struct uielem *own = uielem_from_inspectable( item );
+        if (xaml_is_list_item( own ))
+        {
+            /* a ComboBoxItem of the markup: a container of its content */
+            IInspectable *content = NULL, *cc = NULL;
+            struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.ContentControl", L"Content" );
+            if (prop) dobj_get_value( &own->d, prop, &content );
+            if (content && uielem_from_inspectable( content ))
+            {
+                /* an element shown by its own container stays there */
+                IInspectable_Release( content );
+                content = NULL;
+            }
+            face = make_container( combo, NULL, combo->selected_index );
+            if (face && content && SUCCEEDED(IUnknown_QueryInterface( face->d.obj.outer, &IID_IContentControl, (void **)&cc )))
+            {
+                ((HRESULT (WINAPI *)( IInspectable *, IInspectable * ))((void **)cc->lpVtbl)[IContentControl_SetContent])( cc, content );
+                IInspectable_Release( cc );
+            }
+            if (content) IInspectable_Release( content );
+        }
+        else face = make_container( combo, item, combo->selected_index );
+    }
+    else
+    {
+        /* nothing selected: its PlaceholderText */
+        dobj_get_value( &combo->c.e.d, prop_combo_placeholder, &placeholder );
+        face = make_container( combo, NULL, -1 );   /* (no item: not through the item template) */
+        if (face && placeholder)
+        {
+            IInspectable *cc = NULL;
+            if (SUCCEEDED(IUnknown_QueryInterface( face->d.obj.outer, &IID_IContentControl, (void **)&cc )))
+            {
+                ((HRESULT (WINAPI *)( IInspectable *, IInspectable * ))((void **)cc->lpVtbl)[IContentControl_SetContent])( cc, placeholder );
+                IInspectable_Release( cc );
+            }
+        }
+        if (placeholder) IInspectable_Release( placeholder );
+    }
+    free_items( list, n );
+    if (!face) return;
+    host_from_elem( face )->owner = NULL;   /* not drawn as selected; not one of the list's */
+    put_box( &face->d, xaml_property_find( L"Windows.UI.Xaml.UIElement", L"IsHitTestVisible" ), xbox_boolean( FALSE ) );
+    uielem_add_child( &combo->c.e, face );
+    IUnknown_Release( face->d.obj.outer );
+    combo->face = face;
