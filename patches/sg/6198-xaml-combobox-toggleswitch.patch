+        /* SelectedItem set before its items were there */
+        IInspectable *wanted = NULL;
+        selector_props_init();
+        dobj_get_value( &combo->c.e.d, prop_sel_item, &wanted );
+        if (wanted) selection_set( combo, item_index( combo, wanted ), SELECT_ONLY );
+        if (wanted) IInspectable_Release( wanted );
+    }
+    if (combo->dirty) make_containers( combo );
+    if (!combo->face || combo->face_index != combo->selected_index) combo_make_face( combo );
+    /* as wide as its widest item */
+    LIST_FOR_EACH_ENTRY( child, &combo->drop->c.e.children, struct uielem, entry )
+    {
+        uielem_measure( child, infinite );
+        width = fmax( width, child->desired.width );
+    }
+    desired->width = width + COMBO_CHEVRON;
+    desired->height = 32;
+    if (combo->face)
+    {
+        uielem_measure( combo->face, inner );
+        desired->width = fmax( desired->width, combo->face->desired.width + COMBO_CHEVRON );
+        desired->height = fmax( desired->height, combo->face->desired.height );
+    }
+}
+
+static void combo_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct items_control *combo = items_from_elem( elem );
+    struct xrect rect = { 0, 0, fmax( 0, final.width - COMBO_CHEVRON ), final.height };
+
+    if (combo->face) uielem_arrange( combo->face, rect );
+    *used = final;
+}
+
+/* a box like the desktop's drop-down list: its face, a border, a chevron at its right */
+static void combo_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct items_control *combo = items_from_elem( elem );
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xthickness thickness = { 1, 1, 1, 1 };
+    struct xcolor back, text = xaml_theme_color( XTHEME_CONTROL_TEXT );
+    FLOAT cx = elem->render.width - COMBO_CHEVRON / 2.0f, cy = elem->render.height / 2.0f;
+
+    if (!control_brush( &combo->c, FALSE, &back )) back = xaml_theme_color( XTHEME_CONTROL );
+    xdraw_fill( draw, &rect, back, NULL );
+    xdraw_border( draw, &rect, &thickness, xaml_theme_color( XTHEME_BORDER ), NULL );
+    xdraw_line( draw, cx - 4, cy - 2, cx, cy + 2, text, 1 );
+    xdraw_line( draw, cx, cy + 2, cx + 4, cy - 2, text, 1 );
+}
+
+static const struct elem_ops combo_ops = { combo_measure, combo_arrange, combo_render };
+
+static void combo_raise( struct items_control *combo, struct handler_list *list )
+{
+    IInspectable *sender = NULL;
+
+    if (list_empty( &list->entries )) return;
+    if (FAILED(IUnknown_QueryInterface( combo->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender ))) return;
+    xaml_raise_routed( list, sender, NULL );
+    IInspectable_Release( sender );
+}
+
+/* IsDropDownOpen: the list shown below the box (its own window), or closed */
+static void combo_open_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct items_control *combo;
+    BOOL open = xunbox_boolean( new_value, FALSE );
+
+    if (obj->obj.cls != &combo_class) return;
+    combo = CONTAINING_RECORD( obj, struct items_control, c.e.d );
+    if (open && !combo->drop_window)
+    {
+        struct uielem *e, *drop = &combo->drop->c.e;
+        POINT pt = { 0, 0 };
+        HWND owner;
+        struct xsize infinite = { INFINITY, INFINITY };
+        struct xrect rect;
+
+#ifdef SG_MUTANT_COMBO_NO_DROP
+        return;
+#endif
+        if (!(owner = xaml_element_window( &combo->c.e ))) return;
+        if (combo->dirty) make_containers( combo );
+        if (open_combo && open_combo != combo) put_box( &open_combo->c.e.d, prop_combo_open, xbox_boolean( FALSE ) );
+        for (e = &combo->c.e; e; e = e->parent)
+        {
+            pt.x += e->offset.x;
+            pt.y += e->offset.y;
+        }
+        pt.y += combo->c.e.render.height;
+        ClientToScreen( owner, &pt );
+        /* as wide as the box at least */
+        uielem_measure( drop, infinite );
+        rect.x = rect.y = 0;
+        rect.width = fmax( drop->desired.width, combo->c.e.render.width );
+        rect.height = drop->desired.height;
+        uielem_arrange( drop, rect );
+        if (!(combo->drop_window = xaml_popup_window_open( (IInspectable *)&combo->drop->IItemsControl_iface, owner, pt ))) return;
+        SetWindowPos( combo->drop_window, NULL, 0, 0, (int)ceil( rect.width ), max( 1, (int)ceil( rect.height ) ),
+                      SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE );
+        combo->drop_island = owner;
+        open_combo = combo;
+        IUnknown_AddRef( combo->c.e.d.obj.outer );   /* an open list keeps its box */
+        TRACE( "%p: dropped down in %p\n", combo, combo->drop_window );
+        combo_raise( combo, &combo->drop_opened );
+    }
+    else if (!open && combo->drop_window)
+    {
+        HWND window = combo->drop_window;
+        combo->drop_window = NULL;
+        if (open_combo == combo) open_combo = NULL;
+        xaml_popup_window_close( window );
+        TRACE( "%p: closed\n", combo );
+        combo_raise( combo, &combo->drop_closed );
+        IUnknown_Release( combo->c.e.d.obj.outer );
+    }
+}
+
+/* the box clicked: its list down, or up again */
+void xaml_combo_click( struct uielem *elem )
+{
+    struct items_control *combo;
+
+    if (!xaml_is_combo( elem )) return;
+    combo = items_from_elem( elem );
+    combo_props_init();
+    put_box( &combo->c.e.d, prop_combo_open, xbox_boolean( !combo->drop_window ) );
+}
+
+/* an item of an open list clicked (selected by then): the list closes */
+static void combo_item_chosen( struct items_control *combo )
+{
+    if (!is_combo( combo )) return;
+    put_box( &combo->c.e.d, prop_combo_open, xbox_boolean( FALSE ) );
+    uielem_invalidate_measure( &combo->c.e );
+}
+
+/* a click elsewhere than in its list closes it */
+static void combo_light_dismiss( HWND clicked )
+{
+    if (!open_combo || clicked == open_combo->drop_window) return;
+    put_box( &open_combo->c.e.d, prop_combo_open, xbox_boolean( FALSE ) );
+}
+
+/* keys on a focused combo box: Alt+Down/F4/Space/Enter open or close it, Up/Down select */
+BOOL xaml_combo_key( struct uielem *elem, UINT vk )
+{
+    struct items_control *combo;
+    IInspectable **list;
+    UINT32 n;
+
+    if (!xaml_is_combo( elem )) return FALSE;
+    combo = items_from_elem( elem );
+    combo_props_init();
+    switch (vk)
+    {
+    case VK_F4: case VK_SPACE: case VK_RETURN:
+        put_box( &combo->c.e.d, prop_combo_open, xbox_boolean( !combo->drop_window ) );
+        return TRUE;
+    case VK_ESCAPE:
+        if (!combo->drop_window) return FALSE;
+        put_box( &combo->c.e.d, prop_combo_open, xbox_boolean( FALSE ) );
+        return TRUE;
+    case VK_UP: case VK_DOWN:
+        n = get_items( combo, &list );
+        free_items( list, n );
+        if (!n) return TRUE;
+        if (vk == VK_UP && combo->selected_index > 0) selector_select( combo, combo->selected_index - 1 );
+        if (vk == VK_DOWN && combo->selected_index + 1 < (INT32)n) selector_select( combo, combo->selected_index + 1 );
+        return TRUE;
+    }
+    return FALSE;
+}
