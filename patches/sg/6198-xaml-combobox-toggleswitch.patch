diff --git a/dlls/windows.ui.xaml/compositiontarget.c b/dlls/windows.ui.xaml/compositiontarget.c
new file mode 100644
index 0000000..9a7d96b
--- /dev/null
+++ b/dlls/windows.ui.xaml/compositiontarget.c
@@ -0,0 +1,240 @@
+/*
+ * Windows.UI.Xaml.Media.CompositionTarget (Rendering, Rendered, SurfaceContentsLost) and
+ * Windows.UI.Xaml.Controls.Primitives.LayoutInformation
+ *
+ * Copyright 2026 Stained Glass OS
+ *
