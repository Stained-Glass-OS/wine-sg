+
+/*
+ * A ToggleSwitch is drawn by us, without a template: its Header (a string) above, then a switch --
+ * a rounded track, filled with the accent colour when on, its knob at the left (off) or the right
+ * (on) -- and beside it its OnContent or OffContent ("On" and "Off" unless set).  A click, Space or
+ * Enter flips IsOn; a change of IsOn raises Toggled.
+ */
+
+#include <stdlib.h>
+#include <math.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+#define TRACK_WIDTH  40
+#define TRACK_HEIGHT 20
+#define GAP          12
+
+struct toggle_switch
+{
+    struct control c;
+    struct xiface IToggleSwitch_iface;
+    struct handler_list toggled;
+    IUnknown *header, *state;       /* laid out texts */
+    struct xsize header_size, state_size;
+};
+
+static struct xaml_property *prop_is_on, *prop_header, *prop_header_template, *prop_on_content, *prop_on_template,
+                            *prop_off_content, *prop_off_template;
+static const struct xclass toggle_switch_class;
+
+static struct toggle_switch *switch_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct toggle_switch, c.e );
+}
+
+static struct toggle_switch *switch_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct toggle_switch, c.e.d.obj );
+}
+
+BOOL xaml_is_toggle_switch( struct uielem *elem )
+{
+    return elem && elem->d.obj.cls == &toggle_switch_class;
+}
+
+static boolean is_on( struct toggle_switch *ts )
+{
+    IInspectable *box = NULL;
+    boolean ret;
+
+    dobj_get_value( &ts->c.e.d, prop_is_on, &box );
+    ret = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+/* a content shown as text: a string, else what it says it is */
+static WCHAR *content_text( struct toggle_switch *ts, struct xaml_property *prop, const WCHAR *def )
+{
+    IInspectable *value = NULL;
+    WCHAR *text = NULL;
+    HSTRING str = NULL;
+
+    dobj_get_value( &ts->c.e.d, prop, &value );
+    if (value && !(text = xunbox_string( value )) && SUCCEEDED(IInspectable_GetRuntimeClassName( value, &str )))
+    {
+        /* an element as content (not shown yet): nothing */
+        WindowsDeleteString( str );
+    }
+    if (value) IInspectable_Release( value );
+    if (!text && def) text = wcsdup( def );
+    return text;
+}
+
+static void switch_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct toggle_switch *ts = switch_from_elem( elem );
+    WCHAR *header = content_text( ts, prop_header, NULL ), *state;
+
+    if (ts->header) IUnknown_Release( ts->header );
+    if (ts->state) IUnknown_Release( ts->state );
+    ts->header = ts->state = NULL;
+    ts->header_size.width = ts->header_size.height = 0;
+    if (header && *header) ts->header = xaml_make_text_layout( header, NULL, 14, 400, &ts->header_size );
+    free( header );
+    state = is_on( ts ) ? content_text( ts, prop_on_content, L"On" ) : content_text( ts, prop_off_content, L"Off" );
+    ts->state_size.width = ts->state_size.height = 0;
+    if (state && *state) ts->state = xaml_make_text_layout( state, NULL, 14, 400, &ts->state_size );
+    free( state );
+    desired->width = fmax( ts->header_size.width, TRACK_WIDTH + GAP + ts->state_size.width );
+    desired->height = (ts->header ? ts->header_size.height + 4 : 0) + fmax( 32, ts->state_size.height );
+}
+
+static void switch_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    *used = final;
+}
+
+static void switch_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct toggle_switch *ts = switch_from_elem( elem );
+    struct xcolor text, accent = xaml_theme_color( XTHEME_ACCENT ), border = xaml_theme_color( XTHEME_CONTROL_TEXT );
+    FLOAT top = ts->header ? ts->header_size.height + 4 : 0, row = fmax( 32, ts->state_size.height );
+    struct xrect track = { 0, top + (row - TRACK_HEIGHT) / 2, TRACK_WIDTH, TRACK_HEIGHT };
+    struct xcorner round = { TRACK_HEIGHT / 2, TRACK_HEIGHT / 2, TRACK_HEIGHT / 2, TRACK_HEIGHT / 2 };
+    struct xthickness one = { 1, 1, 1, 1 };
+    struct xrect knob;
+    BOOL on = is_on( ts );
+
+    if (!control_brush( &ts->c, TRUE, &text ))
+    {
+        IInspectable *inherited = xaml_control_inherited( elem, XINHERIT_FOREGROUND );
+        if (!inherited || !xaml_brush_color( inherited, &text )) text = xaml_theme_color( XTHEME_CONTROL_TEXT );
+        if (inherited) IInspectable_Release( inherited );
+    }
+    if (ts->header) xdraw_text( draw, ts->header, 0, 0, text );
+#ifndef SG_MUTANT_TOGGLE_SWITCH_NOT_DRAWN_ON
+    if (on) xdraw_fill( draw, &track, accent, &round );
+    else
+#endif
+        xdraw_border( draw, &track, &one, border, &round );
+    knob.width = knob.height = TRACK_HEIGHT - 8;
+    knob.y = track.y + 4;
+    knob.x = on ? track.x + TRACK_WIDTH - 4 - knob.width : track.x + 4;
+    round.top_left = round.top_right = round.bottom_right = round.bottom_left = knob.width / 2;
+    xdraw_fill( draw, &knob, on ? xaml_theme_color( XTHEME_ACCENT_TEXT ) : border, &round );
+    if (ts->state) xdraw_text( draw, ts->state, TRACK_WIDTH + GAP, top + (row - ts->state_size.height) / 2, text );
+}
+
+static const struct elem_ops switch_ops = { switch_measure, switch_arrange, switch_render };
+
+static void is_on_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct toggle_switch *ts;
+    IInspectable *sender = NULL, *args;
+
+    if (obj->obj.cls != &toggle_switch_class) return;
+    ts = switch_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+    if (xunbox_boolean( old_value, FALSE ) == xunbox_boolean( new_value, FALSE )) return;
+    uielem_invalidate_measure( &ts->c.e );
+    xaml_invalidate_visuals();
+#ifdef SG_MUTANT_TOGGLE_SWITCH_NO_TOGGLED
+    return;
+#endif
+    if (list_empty( &ts->toggled.entries )) return;
+    if (FAILED(IUnknown_QueryInterface( ts->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender ))) return;
+    if ((args = xaml_routed_args( sender )))
+    {
+        xaml_raise_routed( &ts->toggled, sender, args );
+        IInspectable_Release( args );
+    }
+    IInspectable_Release( sender );
+}
+
+static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+static HRESULT put_box( struct toggle_switch *ts, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &ts->c.e.d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+/* a click, Space or Enter: flipped */
+void xaml_toggle_switch_click( struct uielem *elem )
+{
+    struct toggle_switch *ts;
+
+    if (!xaml_is_toggle_switch( elem )) return;
+    ts = switch_from_elem( elem );
+    TRACE( "%p: flipped\n", ts );
+    put_box( ts, prop_is_on, xbox_boolean( !is_on( ts ) ) );
+}
+
+BOOL xaml_toggle_switch_key( struct uielem *elem, UINT vk )
+{
+    if (!xaml_is_toggle_switch( elem ) || (vk != VK_SPACE && vk != VK_RETURN)) return FALSE;
+    xaml_toggle_switch_click( elem );
+    return TRUE;
+}
+
+/* ---- IToggleSwitch ---- */
+
+static HRESULT WINAPI ts_get_IsOn( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = is_on( switch_from_iface( iface ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI ts_put_IsOn( struct xiface *iface, boolean value )
+{
+    return put_box( switch_from_iface( iface ), prop_is_on, xbox_boolean( value ) );
+}
+
+#define OBJECT_PROP(name, prop) \
+static HRESULT WINAPI ts_get_##name( struct xiface *iface, IInspectable **value ) \
+{ if (!value) return E_POINTER; return dobj_get_value( &switch_from_iface( iface )->c.e.d, prop, value ); } \
+static HRESULT WINAPI ts_put_##name( struct xiface *iface, IInspectable *value ) \
+{ return dobj_set_value( &switch_from_iface( iface )->c.e.d, prop, value ); }
+
+OBJECT_PROP(Header, prop_header)
+OBJECT_PROP(HeaderTemplate, prop_header_template)
+OBJECT_PROP(OnContent, prop_on_content)
+OBJECT_PROP(OnContentTemplate, prop_on_template)
+OBJECT_PROP(OffContent, prop_off_content)
+OBJECT_PROP(OffContentTemplate, prop_off_template)
+
+static HRESULT WINAPI ts_get_TemplateSettings( struct xiface *iface, IInspectable **value )
+{
+    /* no template: no knob offsets to tell */
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI ts_add_Toggled( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &switch_from_iface( iface )->toggled, handler, token );
+}
+
+static HRESULT WINAPI ts_remove_Toggled( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &switch_from_iface( iface )->toggled, token );
+}
+
+static const void *toggle_switch_vtbl[] =
+{
+    IToggleSwitch_STUBS,
+    [IToggleSwitch_IsOn] = ts_get_IsOn, [IToggleSwitch_SetIsOn] = ts_put_IsOn,
+    [IToggleSwitch_Header] = ts_get_Header, [IToggleSwitch_SetHeader] = ts_put_Header,
+    [IToggleSwitch_HeaderTemplate] = ts_get_HeaderTemplate, [IToggleSwitch_SetHeaderTemplate] = ts_put_HeaderTemplate,
+    [IToggleSwitch_OnContent] = ts_get_OnContent, [IToggleSwitch_SetOnContent] = ts_put_OnContent,
+    [IToggleSwitch_OnContentTemplate] = ts_get_OnContentTemplate, [IToggleSwitch_SetOnContentTemplate] = ts_put_OnContentTemplate,
+    [IToggleSwitch_OffContent] = ts_get_OffContent, [IToggleSwitch_SetOffContent] = ts_put_OffContent,
+    [IToggleSwitch_OffContentTemplate] = ts_get_OffContentTemplate, [IToggleSwitch_SetOffContentTemplate] = ts_put_OffContentTemplate,
+    [IToggleSwitch_TemplateSettings] = ts_get_TemplateSettings,
+    [IToggleSwitch_Toggled] = ts_add_Toggled, [IToggleSwitch_RemoveToggled] = ts_remove_Toggled,
+};
+
+static const struct xiface_entry toggle_switch_ifaces[] =
+{
+    { &IID_IToggleSwitch, offsetof(struct toggle_switch, IToggleSwitch_iface) },
+    CONTROL_IFACES,
+};
+
+static void switch_destroy( struct xobj *obj )
+{
+    struct toggle_switch *ts = CONTAINING_RECORD( obj, struct toggle_switch, c.e.d.obj );
+    if (ts->header) IUnknown_Release( ts->header );
+    if (ts->state) IUnknown_Release( ts->state );
+    handlers_clear( &ts->toggled );
+    control_cleanup( &ts->c );
+}
+
+static const struct xclass toggle_switch_class =
+{
+    L"Windows.UI.Xaml.Controls.ToggleSwitch", toggle_switch_ifaces, ARRAY_SIZE(toggle_switch_ifaces), switch_destroy,
+};
+
+static BOOL WINAPI init_switch( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR ts[] = L"Windows.UI.Xaml.Controls.ToggleSwitch";
+
+    xaml_controls_init();
+    prop_is_on = xaml_property_register( ts, L"IsOn", L"Boolean", xbox_boolean( FALSE ), FALSE, is_on_changed );
+    prop_header = xaml_property_register( ts, L"Header", L"Object", NULL, FALSE, layout_changed );
+    prop_header_template = xaml_property_register( ts, L"HeaderTemplate", L"Windows.UI.Xaml.DataTemplate", NULL, FALSE, NULL );
+    prop_on_content = xaml_property_register( ts, L"OnContent", L"Object", NULL, FALSE, layout_changed );
+    prop_on_template = xaml_property_register( ts, L"OnContentTemplate", L"Windows.UI.Xaml.DataTemplate", NULL, FALSE, NULL );
+    prop_off_content = xaml_property_register( ts, L"OffContent", L"Object", NULL, FALSE, layout_changed );
+    prop_off_template = xaml_property_register( ts, L"OffContentTemplate", L"Windows.UI.Xaml.DataTemplate", NULL, FALSE, NULL );
+    return TRUE;
+}
+
+static void switch_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_switch, NULL, NULL );
+}
+
+static HRESULT activate_switch( IInspectable **out )
+{
+    struct toggle_switch *ts;
+
+    switch_init();
+    if (!(ts = calloc( 1, sizeof(*ts) ))) return E_OUTOFMEMORY;
+    ts->IToggleSwitch_iface.vtbl = toggle_switch_vtbl;
