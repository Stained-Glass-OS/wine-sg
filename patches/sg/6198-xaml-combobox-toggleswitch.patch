+static void combo_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct items_control *combo = items_from_elem( elem );
+    struct xsize infinite = { INFINITY, INFINITY }, inner = { fmax( 0, available.width - COMBO_CHEVRON ), available.height };
+    struct uielem *child;
+    FLOAT width = 0;
+
+    if (combo->selected_index < 0)
