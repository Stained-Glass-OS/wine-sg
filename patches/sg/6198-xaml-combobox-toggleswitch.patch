+static HRESULT WINAPI combo_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct items_control *combo;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    text_input_init();
+    if (!(combo = new_combo( outer ))) return E_OUTOFMEMORY;
+    if (outer)
+    {
+        *inner = &combo->c.e.d.obj.IInspectable_inner;
+        IUnknown_AddRef( combo->c.e.d.obj.outer );
+    }
+    *value = &combo->IComboBox_iface;
+    return S_OK;
+}
