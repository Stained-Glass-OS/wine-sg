+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * CompositionTarget.Rendering is raised once per frame (about 60 times a second) on the thread
+ * that added the handler, while it has handlers: a thread timer of that thread raises it with
+ * RenderingEventArgs (the time since the first frame).  Rendered follows each Rendering.
+ * SurfaceContentsLost is never raised: no device is lost here.  WinUI 2 queues work for the next
+ * frame through Rendering (SharedHelpers::QueueCallbackForCompositionRendering).
+ *
+ * LayoutInformation tells where an element's parent placed it (its layout slot, its margin
+ * included) and what size it was offered (its last Measure's).
+ */
+
+#include <stdlib.h>
+#include <math.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+#define FRAME_MS 16
+
+struct thread_frames
+{
+    DWORD thread;
+    UINT_PTR timer;
+    LONGLONG start;
+};
+
+static struct handler_list rendering = { LIST_INIT( rendering.entries ) }, rendered = { LIST_INIT( rendered.entries ) };
+static struct thread_frames frames;     /* the thread whose handlers are called */
+
+struct rendering_args
+{
+    struct xobj obj;
+    struct xiface iface;
+    INT64 time;                     /* 100 ns since the first frame */
+};
+
+static const struct xiface_entry args_ifaces[] =
+{
+    { &IID_IRenderingEventArgs, offsetof(struct rendering_args, iface) },
+};
+
+static const struct xclass args_class = { L"Windows.UI.Xaml.Media.RenderingEventArgs", args_ifaces, ARRAY_SIZE(args_ifaces), NULL };
+
+static HRESULT WINAPI args_get_RenderingTime( struct xiface *iface, INT64 *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct rendering_args, obj )->time;
+    return S_OK;
+}
+
+static const void *args_vtbl[] = { IRenderingEventArgs_STUBS, [IRenderingEventArgs_RenderingTime] = args_get_RenderingTime };
+
+static LONGLONG now_100ns(void)
+{
+    LARGE_INTEGER counter, frequency;
+
+    QueryPerformanceCounter( &counter );
+    QueryPerformanceFrequency( &frequency );
+    return (LONGLONG)((double)counter.QuadPart * 10000000.0 / (double)frequency.QuadPart);
+}
+
+static void stop_frames(void)
+{
+    if (!frames.timer) return;
+    KillTimer( NULL, frames.timer );
+    frames.timer = 0;
+}
+
+static void CALLBACK frame_proc( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    struct rendering_args *args;
+
+    if (list_empty( &rendering.entries ) && list_empty( &rendered.entries ))
+    {
+        stop_frames();
+        return;
+    }
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->iface.vtbl = args_vtbl;
+    args->time = now_100ns() - frames.start;
+    xobj_init( &args->obj, &args_class, NULL );
+    xaml_raise_routed( &rendering, NULL, (IInspectable *)&args->iface );
+    IInspectable_Release( (IInspectable *)&args->iface );
+    xaml_raise_routed( &rendered, NULL, NULL );
+}
+
+static void start_frames(void)
+{
+#ifdef SG_MUTANT_NO_RENDERING_FRAMES
+    return;
+#endif
+    if (frames.timer) return;
+    frames.thread = GetCurrentThreadId();
+    if (!frames.start) frames.start = now_100ns();
+    frames.timer = SetTimer( NULL, 0, FRAME_MS, frame_proc );
+}
+
+static HRESULT WINAPI target_add_Rendering( struct xfiface *iface, IUnknown *handler, INT64 *token )
+{
+    HRESULT hr;
+
+    TRACE( "%p\n", handler );
+    if (FAILED(hr = handlers_add( &rendering, handler, token ))) return hr;
+    start_frames();
+    return S_OK;
+}
+
+static HRESULT WINAPI target_remove_Rendering( struct xfiface *iface, INT64 token )
+{
+    return handlers_remove( &rendering, token );
+}
+
+static HRESULT WINAPI target_add_Rendered( struct xfiface *iface, IUnknown *handler, INT64 *token )
+{
+    HRESULT hr;
+
+    if (FAILED(hr = handlers_add( &rendered, handler, token ))) return hr;
+    start_frames();
+    return S_OK;
+}
+
+static HRESULT WINAPI target_remove_Rendered( struct xfiface *iface, INT64 token )
+{
+    return handlers_remove( &rendered, token );
+}
+
+static INT64 lost_token;
+
+/* no device is lost here: kept by nobody */
+static HRESULT WINAPI target_add_SurfaceContentsLost( struct xfiface *iface, IUnknown *handler, INT64 *token )
+{
+    if (!handler || !token) return E_INVALIDARG;
+    *token = ++lost_token;
+    return S_OK;
+}
+
+static HRESULT WINAPI target_remove_SurfaceContentsLost( struct xfiface *iface, INT64 token )
+{
+    return S_OK;
+}
+
+static const void *target_statics_vtbl[] =
+{
+    ICompositionTargetStatics_FSTUBS,
+    [ICompositionTargetStatics_Rendering] = target_add_Rendering,
+    [ICompositionTargetStatics_RemoveRendering] = target_remove_Rendering,
+    [ICompositionTargetStatics_SurfaceContentsLost] = target_add_SurfaceContentsLost,
+    [ICompositionTargetStatics_RemoveSurfaceContentsLost] = target_remove_SurfaceContentsLost,
+};
+static const void *target_statics3_vtbl[] =
+{
+    ICompositionTargetStatics3_FSTUBS,
+    [ICompositionTargetStatics3_Rendered] = target_add_Rendered, [ICompositionTargetStatics3_RemoveRendered] = target_remove_Rendered,
+};
+
+static struct xfactory target_factory_obj =
+{
+    { &xfactory_vtbl }, L"Windows.UI.Xaml.Media.CompositionTarget",
+    { &IID_ICompositionTargetStatics, &IID_ICompositionTargetStatics3 }, { { target_statics_vtbl }, { target_statics3_vtbl } }, NULL,
+};
+IActivationFactory *composition_target_factory = &target_factory_obj.IActivationFactory_iface;
+
+/* ---- LayoutInformation ---- */
+
+struct wrect_l { FLOAT X, Y, Width, Height; };
+struct wsize_l { FLOAT Width, Height; };
+
+static HRESULT WINAPI layout_GetLayoutExceptionElement( struct xfiface *iface, IInspectable *dispatcher, IInspectable **value )
+{
+    /* layout never fails with an exception here */
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI layout_GetLayoutSlot( struct xfiface *iface, IInspectable *element, struct wrect_l *value )
+{
+    struct uielem *elem = element ? uielem_from_inspectable( element ) : NULL;
+
+    if (!value) return E_POINTER;
+    if (!elem) return E_INVALIDARG;
+    value->X = elem->final.x;
+    value->Y = elem->final.y;
+    value->Width = elem->final.width;
+    value->Height = elem->final.height;
+#ifdef SG_MUTANT_LAYOUT_SLOT_EMPTY
+    value->Width = value->Height = 0;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI layout_GetAvailableSize( struct xfiface *iface, IInspectable *element, struct wsize_l *value )
+{
+    struct uielem *elem = element ? uielem_from_inspectable( element ) : NULL;
+
+    if (!value) return E_POINTER;
+    if (!elem) return E_INVALIDARG;
+    value->Width = elem->constraint.width;
+    value->Height = elem->constraint.height;
+    return S_OK;
+}
+
+static const void *layout_statics_vtbl[] =
+{
+    ILayoutInformationStatics_FSTUBS,
+    [ILayoutInformationStatics_GetLayoutExceptionElement] = layout_GetLayoutExceptionElement,
+    [ILayoutInformationStatics_GetLayoutSlot] = layout_GetLayoutSlot,
+};
+static const void *layout_statics2_vtbl[] =
+{
+    ILayoutInformationStatics2_FSTUBS, [ILayoutInformationStatics2_GetAvailableSize] = layout_GetAvailableSize,
+};
+
+static struct xfactory layout_factory_obj =
+{
+    { &xfactory_vtbl }, L"Windows.UI.Xaml.Controls.Primitives.LayoutInformation",
+    { &IID_ILayoutInformationStatics, &IID_ILayoutInformationStatics2 }, { { layout_statics_vtbl }, { layout_statics2_vtbl } }, NULL,
+};
+IActivationFactory *layout_information_factory = &layout_factory_obj.IActivationFactory_iface;
