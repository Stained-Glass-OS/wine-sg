+static struct items_control *new_combo( IInspectable *outer )
+{
+    struct items_control *combo, *drop;
+    struct xthickness padding = { 0, 0, 0, 0 };
+
+    combo_props_init();
+    if (!(drop = new_items( FALSE, NULL ))) return NULL;
+    if (!(combo = calloc( 1, sizeof(*combo) )))
+    {
+        IUnknown_Release( drop->c.e.d.obj.outer );
+        return NULL;
+    }
+    combo->IItemsControl_iface.vtbl = items_vtbl;
+    combo->IListViewBase_iface.vtbl = list_view_base_vtbl;
+    combo->IItemContainerMapping_iface.vtbl = mapping_vtbl;
+    combo->ISelector_iface.vtbl = selector_vtbl;
+    combo->IComboBox_iface.vtbl = combo_vtbl;
+    combo->IComboBox2_iface.vtbl = combo2_vtbl;
+    combo->IComboBox3_iface.vtbl = combo3_vtbl;
+    combo->IComboBox4_iface.vtbl = combo4_vtbl;
+    combo->IComboBox5_iface.vtbl = combo5_vtbl;
+    combo->IComboBox6_iface.vtbl = combo6_vtbl;
+    combo->selected_index = -1;
+    combo->anchor = -1;
+    combo->orientation = 0;
+    combo->face_index = -2;
+    combo->dirty = TRUE;
+    handlers_init( &combo->selection_changed );
+    handlers_init( &combo->item_click_handlers );
+    handlers_init( &combo->container_changing );
+    handlers_init( &combo->drag_completed );
+    handlers_init( &combo->choosing_item );
+    handlers_init( &combo->choosing_header );
+    handlers_init( &combo->drop_opened );
+    handlers_init( &combo->drop_closed );
+    control_init( &combo->c, KIND_OTHER, &combo_class, &combo_ops, outer );
+    /* its list: an items host of its containers (their owner is the combo box) */
+    drop->dirty = FALSE;
+    drop->orientation = 0;
+    {
+        IInspectable *pad = xbox_ref( &IID_IReference_Thickness, &padding, sizeof(padding) );
+        IInspectable *back = xaml_solid_brush( xaml_theme_color( XTHEME_BACKGROUND ) );
+        if (pad) xaml_control_set( &drop->c, L"Padding", pad );
+        if (back) xaml_control_set( &drop->c, L"Background", back );
+        if (pad) IInspectable_Release( pad );
+        if (back) IInspectable_Release( back );
+    }
+    combo->drop = drop;
+    return combo;
+}
