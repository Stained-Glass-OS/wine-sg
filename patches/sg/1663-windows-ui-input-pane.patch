+/* ---- the keyboard's comings and goings ----------------------------------- */
+
+struct pending_call
+{
+    ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *handler;
+    IInputPane *pane;
+    IInputPaneVisibilityEventArgs *args;
 };
 
+static void raise_visibility( BOOL showing )
+{
+    struct pending_call *calls = NULL;
+    struct inputpane *pane;
+    struct pane_handler *h;
+    size_t count = 0, size = 0, i;
+
+    EnterCriticalSection( &pane_cs );
+    LIST_FOR_EACH_ENTRY( pane, &pane_list, struct inputpane, entry )
+    {
+        struct visibility_args *args = NULL;
+
+        LIST_FOR_EACH_ENTRY( h, &pane->handlers, struct pane_handler, entry )
+        {
+            if (h->showing != showing) continue;
+            if (!args)
+            {
+                if (!(args = calloc( 1, sizeof(*args) ))) break;
+                args->IInputPaneVisibilityEventArgs_iface.lpVtbl = &args_vtbl;
+                args->ref = 1;
+                keyboard_rect( pane->window, &args->rect );
+            }
+            if (count == size)
+            {
+                struct pending_call *n = realloc( calls, (size = size ? size * 2 : 8) * sizeof(*calls) );
+                if (!n) break;
+                calls = n;
+            }
+            calls[count].handler = h->handler;
+            ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_AddRef( h->handler );
+            calls[count].pane = &pane->IInputPane_iface;
+            IInputPane_AddRef( calls[count].pane );
+            calls[count].args = &args->IInputPaneVisibilityEventArgs_iface;
+            IInputPaneVisibilityEventArgs_AddRef( calls[count].args );
+            count++;
+        }
+        if (args) IInputPaneVisibilityEventArgs_Release( &args->IInputPaneVisibilityEventArgs_iface );
+    }
+    LeaveCriticalSection( &pane_cs );
+
+    /* the handlers are called without the lock: they may add and remove */
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_Invoke( calls[i].handler, calls[i].pane,
+                                                                            calls[i].args );
+        ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_Release( calls[i].handler );
+        IInputPane_Release( calls[i].pane );
+        IInputPaneVisibilityEventArgs_Release( calls[i].args );
+    }
+    free( calls );
+}
+
+static void check_keyboard(void)
+{
+    Rect rect;
+    BOOL shown = keyboard_rect( NULL, &rect );
+
+    if (shown == pane_shown) return;
+    pane_shown = shown;
+    TRACE( "the input pane %s\n", shown ? "shows" : "is hidden" );
+    raise_visibility( shown );
+}
+
+static void CALLBACK keyboard_event( HWINEVENTHOOK hook, DWORD event, HWND hwnd, LONG object, LONG child,
+                                     DWORD thread, DWORD time )
+{
+    if (object != OBJID_WINDOW) return;
+    check_keyboard();
+}
+
+static DWORD WINAPI watch_proc( void *arg )
+{
+    MSG msg;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_windows_ui_inputpane" );
+    SetWinEventHook( EVENT_SYSTEM_MINIMIZESTART, EVENT_SYSTEM_MINIMIZEEND, NULL, keyboard_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT );
+    SetWinEventHook( EVENT_OBJECT_DESTROY, EVENT_OBJECT_HIDE, NULL, keyboard_event, 0, 0, WINEVENT_OUTOFCONTEXT );
+    /* SetEvent: the hooks are in place */
+    SetEvent( arg );
+    while (GetMessageW( &msg, NULL, 0, 0 ))
+    {
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    return 0;
+}
+
+static void start_watching(void)
+{
+    HANDLE ready;
+
+    if (watch_thread) return;
+    pane_shown = keyboard_rect( NULL, &(Rect){0} );
+    ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+    if ((watch_thread = CreateThread( NULL, 0, watch_proc, ready, 0, NULL )))
+        WaitForSingleObject( ready, 5000 );
+    CloseHandle( ready );
+}
+
+static HRESULT add_pane_handler( struct inputpane *pane, BOOL showing,
+                                 ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *handler,
+                                 EventRegistrationToken *token )
+{
+    struct pane_handler *h;
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(h = calloc( 1, sizeof(*h) ))) return E_OUTOFMEMORY;
+    h->showing = showing;
+    h->handler = handler;
+    ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_AddRef( handler );
+
+    EnterCriticalSection( &pane_cs );
+    h->token.value = next_token++;
+    *token = h->token;
+    if (list_empty( &pane->handlers )) list_add_tail( &pane_list, &pane->entry );
+    list_add_tail( &pane->handlers, &h->entry );
+    start_watching();
+    LeaveCriticalSection( &pane_cs );
+    return S_OK;
+}
+
+static HRESULT remove_pane_handler( struct inputpane *pane, BOOL showing, EventRegistrationToken token )
+{
+    struct pane_handler *h, *found = NULL;
+
+    EnterCriticalSection( &pane_cs );
+    LIST_FOR_EACH_ENTRY( h, &pane->handlers, struct pane_handler, entry )
+    {
+        if (h->showing != showing || h->token.value != token.value) continue;
+        found = h;
+        list_remove( &h->entry );
+        if (list_empty( &pane->handlers )) list_remove( &pane->entry );
+        break;
+    }
+    LeaveCriticalSection( &pane_cs );
+    if (!found) return S_OK;
+    ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_Release( found->handler );
+    free( found );
+    return S_OK;
+}
+
