+static const struct IInputPaneVisibilityEventArgsVtbl args_vtbl =
+{
+    args_QueryInterface,
+    args_AddRef,
+    args_Release,
+    args_GetIids,
+    args_GetRuntimeClassName,
+    args_GetTrustLevel,
