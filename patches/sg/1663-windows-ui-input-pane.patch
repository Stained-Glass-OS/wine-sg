+}
+
+static HRESULT WINAPI args_GetTrustLevel( IInputPaneVisibilityEventArgs *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI args_get_OccludedRect( IInputPaneVisibilityEventArgs *iface, Rect *value )
+{
+    struct visibility_args *impl = impl_from_IInputPaneVisibilityEventArgs( iface );
+    *value = impl->rect;
+    return S_OK;
+}
+
+static HRESULT WINAPI args_put_EnsuredFocusedElementInView( IInputPaneVisibilityEventArgs *iface, boolean value )
+{
