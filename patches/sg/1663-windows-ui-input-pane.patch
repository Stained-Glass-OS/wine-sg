+/* Stained Glass OS 1663: the input pane is the on-screen keyboard (sg-osk,
+ * window class OSKMainClass, started as osk.exe): TryShow starts or
+ * restores it, TryHide minimizes it, OccludedRect is where it is while it
+ * shows, and Showing/Hiding are raised when it appears and goes. */
+
 struct inputpane
 {
     IInputPane IInputPane_iface;
     IInputPane2 IInputPane2_iface;
     LONG ref;
+    HWND window;
+    struct list entry;        /* in pane_list while it has handlers */
+    struct list handlers;
+};
+
+struct pane_handler
+{
+    struct list entry;
+    BOOL showing;
+    EventRegistrationToken token;
+    ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs *handler;
+};
+
+static CRITICAL_SECTION pane_cs;
+static CRITICAL_SECTION_DEBUG pane_cs_debug =
+{
+    0, 0, &pane_cs,
+    { &pane_cs_debug.ProcessLocksList, &pane_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": pane_cs") }
+};
+static CRITICAL_SECTION pane_cs = { &pane_cs_debug, -1, 0, 0, 0, 0 };
+static struct list pane_list = LIST_INIT( pane_list );
+static LONGLONG next_token = 1;
+static HANDLE watch_thread;
+static BOOL pane_shown;
+
+static HWND keyboard_window(void)
+{
+    return FindWindowW( L"OSKMainClass", NULL );
+}
+
+/* where the keyboard covers the screen, in view pixels (DIPs); empty while
+ * it does not show */
+static BOOL keyboard_rect( HWND window, Rect *rect )
+{
+    HWND kbd = keyboard_window();
+    UINT dpi = window ? GetDpiForWindow( window ) : 0;
+    RECT rc;
+
+    memset( rect, 0, sizeof(*rect) );
+#ifdef SG_MUTANT_PANE_NEVER_SHOWS
+    return FALSE;
+#endif
+    if (!kbd || !IsWindowVisible( kbd ) || IsIconic( kbd ) || !GetWindowRect( kbd, &rc )) return FALSE;
+    if (!dpi) dpi = GetDpiForSystem();
+    if (!dpi) dpi = 96;
+    rect->X = rc.left * 96.0f / dpi;
+    rect->Y = rc.top * 96.0f / dpi;
+    rect->Width = (rc.right - rc.left) * 96.0f / dpi;
+    rect->Height = (rc.bottom - rc.top) * 96.0f / dpi;
+    return TRUE;
+}
+
+/* ---- InputPaneVisibilityEventArgs ---------------------------------------- */
+
+struct visibility_args
+{
+    IInputPaneVisibilityEventArgs IInputPaneVisibilityEventArgs_iface;
+    LONG ref;
+    Rect rect;
+    boolean ensured;
+};
+
+static inline struct visibility_args *impl_from_IInputPaneVisibilityEventArgs( IInputPaneVisibilityEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct visibility_args, IInputPaneVisibilityEventArgs_iface );
+}
+
+static HRESULT WINAPI args_QueryInterface( IInputPaneVisibilityEventArgs *iface, REFIID iid, void **out )
+{
+    struct visibility_args *impl = impl_from_IInputPaneVisibilityEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IInputPaneVisibilityEventArgs ))
+    {
+        IInspectable_AddRef( (*out = &impl->IInputPaneVisibilityEventArgs_iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI args_AddRef( IInputPaneVisibilityEventArgs *iface )
+{
+    struct visibility_args *impl = impl_from_IInputPaneVisibilityEventArgs( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI args_Release( IInputPaneVisibilityEventArgs *iface )
+{
+    struct visibility_args *impl = impl_from_IInputPaneVisibilityEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI args_GetIids( IInputPaneVisibilityEventArgs *iface, ULONG *iid_count, IID **iids )
+{
+    INSPECTABLE_IIDS( iid_count, iids, &IID_IInputPaneVisibilityEventArgs );
