-    if (!ref) free( impl );
+    /* a pane with handlers holds no reference of its own: the handlers are
+     * dropped with it */
+    if (!ref)
+    {
+        struct pane_handler *h, *next;
+
+        EnterCriticalSection( &pane_cs );
+        if (!list_empty( &impl->handlers )) list_remove( &impl->entry );
+        LeaveCriticalSection( &pane_cs );
+        LIST_FOR_EACH_ENTRY_SAFE( h, next, &impl->handlers, struct pane_handler, entry )
+        {
+            ITypedEventHandler_InputPane_InputPaneVisibilityEventArgs_Release( h->handler );
+            free( h );
+        }
+        free( impl );
+    }
     return ref;
 }
 
