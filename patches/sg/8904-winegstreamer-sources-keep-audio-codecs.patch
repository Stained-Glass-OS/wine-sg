From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winegstreamer: Media sources hand out AAC, WMA and MP3 audio as it is in the file

Windows' MPEG-4, ASF and MP3 sources describe and deliver their audio compressed: the source reader's native type is MFAudioFormat_AAC, WMAudioV8 (or V9 / Lossless / MSAUDIO1) or MP3, and a PCM type asked of the reader, or of a topology, is decoded by the decoder MFT the reader or the topology loader adds. Wine's GStreamer source decoded in the source, so programs that look at the native type (to choose a decoder, read the codec data, or pass the stream through) saw PCM. The parser now keeps raw AAC, WMA and MPEG layer 3 audio for the media source (wg_parser output_audio_codecs); other codecs are decoded as before. The media types say what Windows' do: MP3 its rate and block alignment 1, AAC MF_MT_AAC_PAYLOAD_TYPE, WMA its bits per sample.
---
--- a/dlls/winegstreamer/gst_private.h
+++ b/dlls/winegstreamer/gst_private.h
@@ -73,6 +73,7 @@
 void wg_sample_queue_flush(struct wg_sample_queue *queue, bool all);
 
 wg_parser_t wg_parser_create(bool output_compressed);
+wg_parser_t wg_parser_create_ex(bool output_compressed, bool output_audio_codecs);
 void wg_parser_destroy(wg_parser_t parser);
 
 HRESULT wg_parser_connect(wg_parser_t parser, uint64_t file_size, const WCHAR *uri);
--- a/dlls/winegstreamer/main.c
+++ b/dlls/winegstreamer/main.c
@@ -165,14 +165,20 @@
 
 wg_parser_t wg_parser_create(bool output_compressed)
 {
+    return wg_parser_create_ex(output_compressed, false);
+}
+
+wg_parser_t wg_parser_create_ex(bool output_compressed, bool output_audio_codecs)
+{
     struct wg_parser_create_params params =
     {
         .output_compressed = output_compressed,
         .err_on = ERR_ON(quartz),
         .warn_on = WARN_ON(quartz),
+        .output_audio_codecs = output_audio_codecs,
     };
 
-    TRACE("output_compressed %d.\n", output_compressed);
+    TRACE("output_compressed %d, output_audio_codecs %d.\n", output_compressed, output_audio_codecs);
 
     if (WINE_UNIX_CALL(unix_wg_parser_create, &params))
         return 0;
--- a/dlls/winegstreamer/media_source.c
+++ b/dlls/winegstreamer/media_source.c
@@ -1741,7 +1741,11 @@
     if (FAILED(hr = MFAllocateWorkQueue(&object->async_commands_queue)))
         goto fail;
 
-    if (!(parser = wg_parser_create(FALSE)))
+    /* Stained Glass OS (wine-sg 8904): AAC, WMA and MP3 streams are described
+     * and delivered as they are in the file, as Windows' MPEG-4, ASF and MP3
+     * sources do (GetNativeMediaType: MFAudioFormat_AAC, WMAudioV8, MP3); the
+     * source reader and the topology loader add the decoder MFT. */
+    if (!(parser = wg_parser_create_ex(FALSE, TRUE)))
     {
         hr = E_OUTOFMEMORY;
         goto fail;
--- a/dlls/winegstreamer/mfplat.c
+++ b/dlls/winegstreamer/mfplat.c
@@ -315,6 +315,10 @@
     IMFMediaType_SetGUID(type, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
     IMFMediaType_SetGUID(type, &MF_MT_SUBTYPE, &MFAudioFormat_MP3);
     IMFMediaType_SetGUID(type, &MF_MT_AM_FORMAT_TYPE, &FORMAT_WaveFormatEx);
+    /* wine-sg 8904: the rate too -- the decoder's output types are at the input's rate */
+    if (format->u.audio.rate)
+        IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, format->u.audio.rate);
+    IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, 1);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, format->u.audio.channels);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_CHANNEL_MASK, format->u.audio.channel_mask);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_PREFER_WAVEFORMATEX, TRUE);
@@ -339,6 +343,7 @@
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_NUM_CHANNELS, format->u.audio.channels);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_CHANNEL_MASK, format->u.audio.channel_mask);
     IMFMediaType_SetUINT32(type, &MF_MT_AAC_AUDIO_PROFILE_LEVEL_INDICATION, 0); /* unknown */
+    IMFMediaType_SetUINT32(type, &MF_MT_AAC_PAYLOAD_TYPE, format->u.audio.payload_type);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_PREFER_WAVEFORMATEX, TRUE);
     IMFMediaType_SetUINT32(type, &MF_MT_FIXED_SIZE_SAMPLES, TRUE);
     IMFMediaType_SetUINT32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT, TRUE);
@@ -426,6 +431,9 @@
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, format->u.audio.bitrate / 8);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_PREFER_WAVEFORMATEX, TRUE);
     IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BLOCK_ALIGNMENT, format->u.audio.block_align);
+    /* wine-sg 8904: the stream's bit depth, as Windows' ASF source gives it */
+    if (format->u.audio.depth)
+        IMFMediaType_SetUINT32(type, &MF_MT_AUDIO_BITS_PER_SAMPLE, format->u.audio.depth);
     IMFMediaType_SetBlob(type, &MF_MT_USER_DATA, format->u.audio.codec_data, format->u.audio.codec_data_len);
 
     return type;
--- a/dlls/winegstreamer/unixlib.h
+++ b/dlls/winegstreamer/unixlib.h
@@ -222,6 +222,7 @@
     UINT8 output_compressed;
     UINT8 err_on;
     UINT8 warn_on;
+    UINT8 output_audio_codecs;  /* wine-sg 8904: AAC, WMA and MP3 audio as it is in the file */
 };
 
 struct wg_parser_connect_params
--- a/dlls/winegstreamer/wg_parser.c
+++ b/dlls/winegstreamer/wg_parser.c
@@ -78,6 +78,7 @@
 
     pthread_cond_t init_cond;
     bool output_compressed;
+    bool output_audio_codecs;
     bool no_more_pads, has_duration, error;
     bool err_on, warn_on;
 
@@ -977,6 +978,33 @@
     return true;
 }
 
+/* Stained Glass OS (wine-sg 8904): the audio a Media Foundation source hands
+ * out as it is in the file, as Windows' sources do -- AAC from MPEG-4, WMA from
+ * ASF, MP3 -- for the source reader or the topology loader to decode with the
+ * decoder MFTs. Other codecs (Vorbis, FLAC, ...) are decoded here as before. */
+static bool output_audio_codec(struct wg_parser *parser, GstCaps *caps)
+{
+    struct wg_format format;
+
+#ifdef SG_MUTANT_SOURCE_DECODES_AUDIO
+    return false;
+#endif
+    if (!parser->output_audio_codecs || !caps)
+        return false;
+    wg_format_from_caps(&format, caps);
+    switch (format.major_type)
+    {
+        case WG_MAJOR_TYPE_AUDIO_MPEG4:
+            return format.u.audio.payload_type == 0;   /* raw AAC, an MPEG-4 file's */
+        case WG_MAJOR_TYPE_AUDIO_WMA:
+            return format.u.audio.version >= 1 && format.u.audio.version <= 4;
+        case WG_MAJOR_TYPE_AUDIO_MPEG1:
+            return format.u.audio.layer == 3;
+        default:
+            return false;
+    }
+}
+
 static void pad_added_cb(GstElement *element, GstPad *pad, gpointer user)
 {
     struct wg_parser_stream *stream;
@@ -992,7 +1020,8 @@
     stream->codec_caps = gst_pad_query_caps(pad, NULL);
 
     /* For compressed stream, create an extra decodebin to decode it. */
-    if (!parser->output_compressed && caps_is_compressed(stream->codec_caps))
+    if (!parser->output_compressed && caps_is_compressed(stream->codec_caps)
+            && !output_audio_codec(parser, stream->codec_caps))
     {
         if (!stream_decodebin_create(stream))
         {
@@ -1829,6 +1858,7 @@
     pthread_cond_init(&parser->read_cond, NULL);
     pthread_cond_init(&parser->read_done_cond, NULL);
     parser->output_compressed = params->output_compressed;
+    parser->output_audio_codecs = params->output_audio_codecs;
     parser->err_on = params->err_on;
     parser->warn_on = params->warn_on;
     GST_DEBUG("Created winegstreamer parser %p.", parser);
