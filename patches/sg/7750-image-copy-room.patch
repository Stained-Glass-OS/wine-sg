From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, ntdll: an image's section copy goes in the prefix, and an image loads even when there is no room for it

The server copies an image's sections once per file when one is not
page-aligned in the file (most MinGW and Electron DLLs) or is shared and
writable. The copy went in the server dir, usually tmpfs /tmp, where it
stays in memory; and when it could not be written (a full /tmp or disk) the
load failed with STATUS_INVALID_FILE_FOR_SECTION: WindowsCodecs.dll in the
Visual Studio Installer (WPF without wpfgfx: no text, "Set property
ResourceDictionary.DeferrableContent threw") and the Google Earth Pro
installer (ERROR_BAD_EXE_FORMAT). The copy now goes in the prefix, on disk,
where its clean pages can be dropped (the server dir when the prefix cannot
take it), and with no room for it the image loads mapped privately, a
shared writable section private to each process.
---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 930eb04..e304687 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2854,8 +2854,10 @@ static NTSTATUS map_image_into_view( struct file_view *view, const WCHAR *filena
             return status;
         }
 
+        /* Stained Glass OS 7750: no shared file when the server had no room for it: the section is
+         * mapped like any other, copy-on-write, private to this process */
         if ((sec->Characteristics & IMAGE_SCN_MEM_SHARED) &&
-            (sec->Characteristics & IMAGE_SCN_MEM_WRITE))
+            (sec->Characteristics & IMAGE_SCN_MEM_WRITE) && shared_fd != -1)
         {
             TRACE_(module)( "%s mapping shared section %.8s at %p off %x (%x) size %lx (%lx) flags %x\n",
                             debugstr_w(filename), sec->Name, ptr + sec->VirtualAddress,
diff --git a/server/mapping.c b/server/mapping.c
index a1f2b44..05eef19 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -388,6 +388,37 @@ static int create_temp_file( file_pos_t size )
     return fd;
 }
 
+/* Stained Glass OS 7750: the copy of an image's sections that build_shared_mapping makes. It goes in
+ * the prefix (the config dir, on disk): those pages are clean and the kernel can drop them under memory
+ * pressure, where the server dir is usually tmpfs (/tmp), which keeps them in memory and fills up -- a
+ * full /tmp made DLL loads fail with STATUS_INVALID_FILE_FOR_SECTION (WindowsCodecs.dll in the Visual
+ * Studio Installer, the Google Earth installer). The server dir when the prefix cannot take it. */
+static int create_image_temp_file( file_pos_t size )
+{
+    static int prefix_exec = -1;
+    char tmpfn[16];
+    int fd = -1;
+
+#ifndef SG_MUTANT_IMAGE_COPY_IN_TMP
+    if (fchdir( config_dir_fd ) != -1)
+    {
+        if (prefix_exec == -1) prefix_exec = check_current_dir_for_exec();
+        if (prefix_exec && (fd = make_temp_file( tmpfn )) != -1)
+        {
+            if (!grow_file( fd, size ))
+            {
+                close( fd );
+                fd = -1;
+            }
+            unlink( tmpfn );
+        }
+        fchdir( server_dir_fd );
+    }
+#endif
+    if (fd == -1) fd = create_temp_file( size );
+    return fd;
+}
+
 /* find a memory view from its base address */
 struct memory_view *find_mapped_view( struct process *process, client_ptr_t base )
 {
@@ -656,8 +687,8 @@ static int build_shared_mapping( struct mapping *mapping, int fd,
 
     /* create a temp file for the mapping */
 
-    if ((shared_fd = create_temp_file( total_size )) == -1) return 0;
-    if (!(file = create_file_for_fd( shared_fd, FILE_GENERIC_READ|FILE_GENERIC_WRITE, 0 ))) return 0;
+    if ((shared_fd = create_image_temp_file( total_size )) == -1) goto no_copy;
+    if (!(file = create_file_for_fd( shared_fd, FILE_GENERIC_READ|FILE_GENERIC_WRITE, 0 ))) goto no_copy;
 
     if (!(buffer = malloc( max_size ))) goto error;
 
@@ -699,7 +730,17 @@ static int build_shared_mapping( struct mapping *mapping, int fd,
  error:
     release_object( file );
     free( buffer );
+ no_copy:
+#ifdef SG_MUTANT_IMAGE_COPY_NO_FALLBACK
     return 0;
+#endif
+    /* Stained Glass OS 7750: no room for the copy (a full disk or /tmp): the image still loads, its
+     * sections mapped from the file into each process (read into private memory where they are not
+     * page-aligned), and a shared writable section private to each process, as before the copy */
+    clear_error();
+    mapping->image.sections_in_shared = 0;
+    mapping->shared = NULL;
+    return 1;
 }
 
 /* load a data directory header from its section */
