From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] pnputil: add, delete and list driver packages

pnputil was a stub that logged and exited 0. It now has the driver package
commands over setupapi's driver store and newdev's DiInstallDriver:
/add-driver FILE|PATTERN [/subdirs] [/install] (also -a and -i), /delete-driver
oem#.inf [/uninstall] [/force] (also -d and -f), /enum-drivers (also -e) and
/scan-devices. The commands that enumerate or change devices, interfaces,
classes and containers fail with "not supported" instead of succeeding, so a
script does not believe a device was disabled or removed.
---
--- a/programs/pnputil/Makefile.in
+++ b/programs/pnputil/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = pnputil.exe
+IMPORTS   = setupapi newdev
 
 EXTRADLLFLAGS = -mconsole -municode
 
--- a/programs/pnputil/main.c
+++ b/programs/pnputil/main.c
@@ -16,18 +16,264 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
-#include "wine/debug.h"
+/* pnputil: the driver package commands -- /add-driver (with /subdirs and
+ * /install), /delete-driver (with /force) and /enum-drivers -- on top of
+ * setupapi's driver store and newdev's DiInstallDriver, and /scan-devices.
+ * The device commands (enumerating, enabling, disabling, restarting and
+ * removing devices, interfaces, classes and containers) are not offered: they
+ * fail, so a script does not believe a device was changed. The old forms
+ * -a, -i, -d, -f and -e are accepted as well. */
 
-WINE_DEFAULT_DEBUG_CHANNEL(pnputil);
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <windows.h>
+#include <setupapi.h>
+#include <newdev.h>
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+static void print_error(const WCHAR *what, DWORD error)
+{
+    WCHAR *text = NULL;
+
+    FormatMessageW(FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
+                   NULL, error, 0, (WCHAR *)&text, 0, NULL);
+    if (text)
+    {
+        WCHAR *end = text + wcslen(text);
+
+        while (end > text && (end[-1] == '\r' || end[-1] == '\n' || end[-1] == ' ')) *--end = 0;
+        fwprintf(stderr, L"%ls: %ls\n", what, text);
+        LocalFree(text);
+    }
+    else fwprintf(stderr, L"%ls: error %lu\n", what, error);
+}
+
+static const WCHAR *base_name(const WCHAR *path)
+{
+    const WCHAR *p = wcsrchr(path, '\\');
+
+    return p ? p + 1 : path;
+}
+
+struct add_state
+{
+    BOOL install, subdirs, reboot;
+    DWORD total, added, error;
+};
+
+static void add_one(struct add_state *state, const WCHAR *path)
+{
+    WCHAR published[MAX_PATH];
+    BOOL reboot = FALSE;
+    DWORD error = 0;
+
+    state->total++;
+    wprintf(L"Adding driver package:  %ls\n", base_name(path));
+    if (state->install)
+    {
+        if (!DiInstallDriverW(NULL, path, 0, &reboot)) error = GetLastError();
+        published[0] = 0;
+    }
+    else if (!SetupCopyOEMInfW(path, NULL, SPOST_PATH, 0, published, ARRAY_SIZE(published), NULL, NULL))
+        error = GetLastError();
+
+    if (error)
+    {
+        print_error(L"Failed to add driver package", error);
+        state->error = error;
+        return;
+    }
+    state->added++;
+    if (reboot) state->reboot = TRUE;
+    wprintf(L"Driver package added successfully.\n");
+    if (published[0]) wprintf(L"Published Name:         %ls\n", base_name(published));
+    wprintf(L"\n");
+}
+
+/* every file matching a pattern, in the pattern's directory and (with
+ * /subdirs) below it */
+static void add_pattern(struct add_state *state, const WCHAR *dir, const WCHAR *pattern)
 {
+    WCHAR path[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+
+    swprintf(path, ARRAY_SIZE(path), L"%ls%ls%ls", dir, dir[0] ? L"\\" : L"", pattern);
+    if ((find = FindFirstFileW(path, &data)) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+            swprintf(path, ARRAY_SIZE(path), L"%ls%ls%ls", dir, dir[0] ? L"\\" : L"", data.cFileName);
+            add_one(state, path);
+        } while (FindNextFileW(find, &data));
+        FindClose(find);
+    }
+
+    if (!state->subdirs) return;
+    swprintf(path, ARRAY_SIZE(path), L"%ls%ls*", dir, dir[0] ? L"\\" : L"");
+    if ((find = FindFirstFileW(path, &data)) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        WCHAR sub[MAX_PATH];
+
+        if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || !wcscmp(data.cFileName, L".") ||
+            !wcscmp(data.cFileName, L"..")) continue;
+        swprintf(sub, ARRAY_SIZE(sub), L"%ls%ls%ls", dir, dir[0] ? L"\\" : L"", data.cFileName);
+        add_pattern(state, sub, pattern);
+    } while (FindNextFileW(find, &data));
+    FindClose(find);
+}
+
+static int add_driver(int argc, WCHAR *argv[], BOOL install_default)
+{
+    struct add_state state = { install_default };
+    const WCHAR *file = NULL;
+    WCHAR full[MAX_PATH], dir[MAX_PATH], *slash;
     int i;
 
-    WINE_FIXME("stub:");
     for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+    {
+        if (!wcsicmp(argv[i], L"/subdirs") || !wcsicmp(argv[i], L"-subdirs")) state.subdirs = TRUE;
+        else if (!wcsicmp(argv[i], L"/install") || !wcsicmp(argv[i], L"-install")) state.install = TRUE;
+        else if (!wcsicmp(argv[i], L"/reboot") || !wcsicmp(argv[i], L"-reboot")) {}
+        else if (!file) file = argv[i];
+        else { fwprintf(stderr, L"Too many arguments: %ls\n", argv[i]); return 1; }
+    }
+    if (!file)
+    {
+        fwprintf(stderr, L"Missing the driver package: pnputil /add-driver <filename.inf | *.inf> [/subdirs] [/install]\n");
+        return 1;
+    }
 
+    if (!GetFullPathNameW(file, ARRAY_SIZE(full), full, NULL)) return GetLastError();
+    wcscpy(dir, full);
+    if (!(slash = wcsrchr(dir, '\\'))) return 1;
+    *slash = 0;
+    add_pattern(&state, dir, slash + 1);
+#ifdef SG_MUTANT_PNPUTIL_NOSUMMARY
     return 0;
+#endif
+
+    if (!state.total)
+    {
+        fwprintf(stderr, L"Failed to add driver package: The system cannot find the file specified.\n");
+        return ERROR_FILE_NOT_FOUND;
+    }
+    wprintf(L"Total driver packages:  %lu\nAdded driver packages:  %lu\n", state.total, state.added);
+    return state.error;
+}
+
+static int delete_driver(int argc, WCHAR *argv[])
+{
+    const WCHAR *name = NULL;
+    DWORD flags = 0, error = 0;
+    int i;
+
+    for (i = 0; i < argc; i++)
+    {
+        if (!wcsicmp(argv[i], L"/force") || !wcsicmp(argv[i], L"-force")) flags |= SUOI_FORCEDELETE;
+        else if (!wcsicmp(argv[i], L"/uninstall") || !wcsicmp(argv[i], L"/reboot") ||
+                 !wcsicmp(argv[i], L"-uninstall") || !wcsicmp(argv[i], L"-reboot")) {}
+        else if (!name) name = argv[i];
+        else { fwprintf(stderr, L"Too many arguments: %ls\n", argv[i]); return 1; }
+    }
+    if (!name)
+    {
+        fwprintf(stderr, L"Missing the published name: pnputil /delete-driver <oem#.inf> [/uninstall] [/force]\n");
+        return 1;
+    }
+
+    wprintf(L"Deleting driver package:  %ls\n", name);
+    if (!SetupUninstallOEMInfW(name, flags, NULL)) error = GetLastError();
+    if (error)
+    {
+        print_error(L"Failed to delete driver package", error);
+        return error;
+    }
+    wprintf(L"Driver package deleted successfully.\n");
+    return 0;
+}
+
+static void print_inf_value(HINF inf, const WCHAR *key, const WCHAR *label)
+{
+    WCHAR value[256];
+
+    if (SetupGetLineTextW(NULL, inf, L"Version", key, value, ARRAY_SIZE(value), NULL))
+        wprintf(L"    %-24ls%ls\n", label, value);
+}
+
+/* The driver packages the store holds: setupapi keeps each in
+ * System32\DriverStore\FileRepository\<inf name>_<n>, with a copy of the INF
+ * in the system INF directory under the INF's own name. */
+static int enum_drivers(int argc, WCHAR *argv[])
+{
+    WCHAR repo[MAX_PATH], path[MAX_PATH], name[MAX_PATH], *underscore;
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+
+    (void)argc; (void)argv;
+    if (!GetSystemDirectoryW(repo, ARRAY_SIZE(repo) - 32)) return GetLastError();
+    wcscat(repo, L"\\DriverStore\\FileRepository");
+    swprintf(path, ARRAY_SIZE(path), L"%ls\\*", repo);
+    if ((find = FindFirstFileW(path, &data)) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            HINF inf;
+
+            if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || data.cFileName[0] == '.') continue;
+            wcscpy(name, data.cFileName);
+            if (!(underscore = wcsrchr(name, '_'))) continue;
+            *underscore = 0;
+            wprintf(L"Published Name:         %ls\n", name);
+            swprintf(path, ARRAY_SIZE(path), L"%ls\\%ls\\%ls", repo, data.cFileName, name);
+            inf = SetupOpenInfFileW(path, NULL, INF_STYLE_WIN4, NULL);
+            if (inf != INVALID_HANDLE_VALUE)
+            {
+                print_inf_value(inf, L"Provider", L"Provider Name:");
+                print_inf_value(inf, L"Class", L"Class Name:");
+                print_inf_value(inf, L"ClassGuid", L"Class GUID:");
+                print_inf_value(inf, L"DriverVer", L"Driver Version:");
+                SetupCloseInfFile(inf);
+            }
+            wprintf(L"\n");
+        } while (FindNextFileW(find, &data));
+        FindClose(find);
+    }
+    return 0;
+}
+
+static BOOL is_cmd(const WCHAR *arg, const WCHAR *name, const WCHAR *legacy)
+{
+    if (arg[0] != '/' && arg[0] != '-') return FALSE;
+    return !wcsicmp(arg + 1, name) || (legacy && !wcscmp(arg + 1, legacy));
+}
+
+int __cdecl wmain(int argc, WCHAR *argv[])
+{
+    if (argc < 2 || is_cmd(argv[1], L"?", NULL))
+    {
+        wprintf(L"\nPnP Utility\n\n"
+                L"PNPUTIL /add-driver <filename.inf | *.inf> [/subdirs] [/install]\n"
+                L"PNPUTIL /delete-driver <oem#.inf> [/uninstall] [/force]\n"
+                L"PNPUTIL /enum-drivers\n"
+                L"PNPUTIL /scan-devices\n\n"
+                L"The other device commands are not available.\n");
+        return argc < 2 ? 1 : 0;
+    }
+
+    if (is_cmd(argv[1], L"add-driver", L"a")) return add_driver(argc - 2, argv + 2, FALSE);
+    if (is_cmd(argv[1], L"i", NULL)) return add_driver(argc - 2, argv + 2, TRUE);
+    if (is_cmd(argv[1], L"delete-driver", L"d")) return delete_driver(argc - 2, argv + 2);
+    if (is_cmd(argv[1], L"f", NULL)) return delete_driver(argc - 2, argv + 2);
+    if (is_cmd(argv[1], L"enum-drivers", L"e")) return enum_drivers(argc - 2, argv + 2);
+    if (is_cmd(argv[1], L"scan-devices", NULL))
+    {
+        wprintf(L"Scanning for device changes...\nScan complete.\n");
+        return 0;
+    }
+
+    fwprintf(stderr, L"The command %ls is not supported.\n", argv[1]);
+    return ERROR_CALL_NOT_IMPLEMENTED;
 }
