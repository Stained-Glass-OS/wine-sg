+    vkd3d_string_buffer_release(&parser->string_buffers, operands);
+
+    return VKD3D_OK;
+
+raw:
+    parser->pos = pos;
+    spirv_parser_parse_raw_instruction(parser, count);
+
+    return VKD3D_OK;
+}
