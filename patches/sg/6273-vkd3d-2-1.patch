+        .value = VKD3D_SHADER_API_VERSION_CURRENT,
+    };
+    struct vkd3d_shader_compile_info compile_info =
+    {
+        .type = VKD3D_SHADER_STRUCTURE_TYPE_COMPILE_INFO,
+        .options = &version_option,
+        .option_count = 1,
+    };
