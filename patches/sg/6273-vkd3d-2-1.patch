+    msl_print_indent(gen->buffer, gen->indent);
+    vkd3d_string_buffer_printf(gen->buffer, "%s x%u[%u];\n", type,
+            ins->declaration.indexable_temp.register_idx,
+            ins->declaration.indexable_temp.register_size);
