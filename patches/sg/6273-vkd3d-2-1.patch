+            return s;
+        }
+        else
+        {
+            /* Denormalised number; renormalise it. */
+            while (!(m & 0x400u))
+            {
+                m <<= 1;
+                --e;
+            }
+
+            ++e;
+            m &= ~0x400u;
+        }
+    }
+    else if (e == 31u)
+    {
+        /* Positive or negative infinity for zero 'm'.
+         * NaN for non-zero 'm'; preserve sign and significand bits. */
+        return s | 0x7f800000u | (m << 13);
+    }
+
+    /* Normalised number. */
