From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rtworkq: RtwqSetDeadline, RtwqSetDeadline2, RtwqCancelDeadline (3738)

rtworkq: RtwqSetDeadline, RtwqSetDeadline2, RtwqCancelDeadline

A deadline request is a real handle, given for an existing queue and released
by RtwqCancelDeadline. The deadline itself is only a hint and schedules nothing.
---
diff --git a/dlls/rtworkq/queue.c b/dlls/rtworkq/queue.c
index 9046a70..1c8f8d7 100644
--- a/dlls/rtworkq/queue.c
+++ b/dlls/rtworkq/queue.c
@@ -1529,25 +1529,80 @@ HRESULT WINAPI RtwqLockSharedWorkQueue(const WCHAR *usageclass, LONG priority, D
     return hr;
 }
 
+/* Stained Glass OS: deadlines. A deadline is a scheduling hint for the work queue: nothing here is scheduled
+ * by it, but the request is a real handle that RtwqCancelDeadline releases, and it is only given for a queue
+ * that exists. The error returned for a handle that is not a request is E_INVALIDARG (GUESS). */
+struct deadline_request
+{
+    struct list entry;
+    HANDLE handle;
+    DWORD queue_id;
+    LONGLONG deadline, predeadline;
+};
+
+static struct list deadline_requests = LIST_INIT(deadline_requests);
+
+static HRESULT set_deadline(DWORD queue_id, LONGLONG deadline, LONGLONG predeadline, HANDLE *request)
+{
+    struct deadline_request *req;
+    struct queue *queue;
+    HRESULT hr;
+
+    if (!request) return E_POINTER;
+    *request = NULL;
+    if (deadline <= 0 || predeadline < 0 || predeadline > deadline) return E_INVALIDARG;
+    if (FAILED(hr = grab_queue(queue_id, &queue))) return hr;
+    if (!(req = calloc(1, sizeof(*req)))) return E_OUTOFMEMORY;
+    if (!(req->handle = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        free(req);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    req->queue_id = queue_id;
+    req->deadline = deadline;
+    req->predeadline = predeadline;
+    EnterCriticalSection(&queues_section);
+    list_add_tail(&deadline_requests, &req->entry);
+    LeaveCriticalSection(&queues_section);
+    *request = req->handle;
+    return S_OK;
+}
+
 HRESULT WINAPI RtwqSetDeadline(DWORD queue_id, LONGLONG deadline, HANDLE *request)
 {
-    FIXME("%#lx, %s, %p.\n", queue_id, wine_dbgstr_longlong(deadline), request);
+    TRACE("%#lx, %s, %p.\n", queue_id, wine_dbgstr_longlong(deadline), request);
 
-    return E_NOTIMPL;
+    return set_deadline(queue_id, deadline, 0, request);
 }
 
 HRESULT WINAPI RtwqSetDeadline2(DWORD queue_id, LONGLONG deadline, LONGLONG predeadline, HANDLE *request)
 {
-    FIXME("%#lx, %s, %s, %p.\n", queue_id, wine_dbgstr_longlong(deadline), wine_dbgstr_longlong(predeadline), request);
+    TRACE("%#lx, %s, %s, %p.\n", queue_id, wine_dbgstr_longlong(deadline), wine_dbgstr_longlong(predeadline), request);
 
-    return E_NOTIMPL;
+    return set_deadline(queue_id, deadline, predeadline, request);
 }
 
 HRESULT WINAPI RtwqCancelDeadline(HANDLE request)
 {
-    FIXME("%p.\n", request);
+    struct deadline_request *req;
+    HRESULT hr = E_INVALIDARG;
 
-    return E_NOTIMPL;
+    TRACE("%p.\n", request);
+
+    EnterCriticalSection(&queues_section);
+    LIST_FOR_EACH_ENTRY(req, &deadline_requests, struct deadline_request, entry)
+    {
+        if (req->handle == request)
+        {
+            list_remove(&req->entry);
+            CloseHandle(req->handle);
+            free(req);
+            hr = S_OK;
+            break;
+        }
+    }
+    LeaveCriticalSection(&queues_section);
+    return hr;
 }
 
 HRESULT WINAPI RtwqAllocateSerialWorkQueue(DWORD target_queue, DWORD *queue)
