From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, win32u: a program's ActivateKeyboardLayout of one of the session's layouts switches the keyboard (9156)

On Windows the input method is the person's, not each window's ("Let me
use a different input method for each app window" is off by default): a
program in the foreground that activates one of the loaded layouts with
ActivateKeyboardLayout switches the keyboard -- the keys type in that
layout, and the input indicator, which follows the focus window, shows it.
A thread in the background changes its own layout only. Here the session's
layouts are the display server's XKB groups (9154), owned on Xwayland by
sg-compositor: Wine changed the thread's tables, the keyboard went on
typing the old layout, and the person's indicator never moved.

- X11DRV_ActivateKeyboardLayout: an HKL that is one of the X map's groups,
  activated by the foreground window's thread, switches the keyboard to
  that group. The compositor owns the group on Xwayland (an X client's
  XkbLockGroup would last until its next modifier state), so it is asked
  on its control socket, "LAYOUT n" (sg-compositor's KEYMAP/LAYOUT/KEYBOARD
  commands; SG_LOCK_CONTROL, else the session's socket for this user, as
  wtsapi32's session state); with no compositor there -- an X server of
  its own -- XkbLockGroup.
- The layouts of the input language changes 9154 posts for the person's own
  switch (Windows logo key + Space) are noted: when DefWindowProc activates
  one, the keyboard is already there, and two quick switches queued while
  the program was busy are not sent back as the program's.
- The thread's last-seen group is the new one, so the keys that follow post
  no request for it.
- win32u: ActivateKeyboardLayout returns the layout before for a thread
  that had activated none (the keyboard's), taken before the driver call:
  after the switch the keyboard's is the new one.

Gate test/kbdactivate-gate.sh (Xvfb, us,de, XTEST; a stand-in control
socket), and test/kbdcompositor-gate.sh x11: on sg-compositor's own
Xwayland, the compositor's keyboard switched and the keys following it. Mutants SG_MUTANT_KBD_ACTIVATE_LOCAL, SG_MUTANT_KBD_ACTIVATE_ANY_THREAD,
SG_MUTANT_KBD_REQUEST_SWITCHES.
---
 dlls/win32u/input.c          |   9 ++--
 dlls/winex11.drv/keyboard.c  | 114 +++++++++++++++++++++++++++++++++++++++++++
 dlls/winex11.drv/x11drv.h    |   3 ++
 dlls/winex11.drv/xkbtables.c |  19 ++++++++
 4 files changed, 142 insertions(+), 3 deletions(-)

--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1434,7 +1434,7 @@ static BOOL is_loaded_layout( HKL layout )
 HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
 {
     struct user_thread_info *info = get_user_thread_info();
-    HKL old_layout;
+    HKL old_layout, previous = 0;
     LCID locale;
     HWND focus;
 
@@ -1473,10 +1473,13 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
         return 0;
     }
 
+    /* Stained Glass OS (9156): the layout before, taken before the driver may switch the session's
+     * keyboard -- a thread that never activated one has the keyboard's, which is the new one after */
+    old_layout = get_thread_kbd_layout( info );
+    if (!old_layout) previous = get_locale_kbd_layout();
     if (!user_driver->pActivateKeyboardLayout( layout, flags ))
         return 0;
 
-    old_layout = get_thread_kbd_layout( info );
 #ifdef SG_MUTANT_KBD_NOPROC
     if (0)
 #else
@@ -1524,7 +1527,7 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
             send_message( focus, WM_INPUTLANGCHANGE, cs.ciCharset, (LPARAM)layout );
     }
 
-    if (!old_layout) return get_locale_kbd_layout();
+    if (!old_layout) return previous;
     return old_layout;
 }
 
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -38,7 +38,12 @@
 
 #include <ctype.h>
 #include <stdarg.h>
+#include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
 
 #include "x11drv.h"
 
@@ -97,6 +102,39 @@ static void check_keyboard_mapping( Display *display )
 
 static char KEYBOARD_MapDeadKeysym(KeySym keysym);
 
+/* (9156) a WM_INPUTLANGCHANGEREQUEST posted for the person's own switch on the display server: when
+ * DefWindowProc activates its layout, the keyboard already types with it */
+static void note_layout_request( struct x11drv_thread_data *data, HKL layout )
+{
+    UINT i, oldest = 0;
+
+    for (i = 0; i < ARRAY_SIZE(data->kbd_requests); i++)
+    {
+        if (!data->kbd_requests[i]) { oldest = i; break; }
+        if ((int)(data->kbd_request_times[i] - data->kbd_request_times[oldest]) < 0) oldest = i;
+    }
+    data->kbd_requests[oldest] = layout;
+    data->kbd_request_times[oldest] = NtGetTickCount();
+}
+
+static BOOL take_layout_request( struct x11drv_thread_data *data, HKL layout )
+{
+    UINT i;
+
+#ifdef SG_MUTANT_KBD_REQUEST_SWITCHES
+    return FALSE;
+#endif
+
+    for (i = 0; i < ARRAY_SIZE(data->kbd_requests); i++)
+    {
+        if (data->kbd_requests[i] != layout) continue;
+        data->kbd_requests[i] = 0;
+        /* a request a program kept for long is no longer the person's switch */
+        if (NtGetTickCount() - data->kbd_request_times[i] < 5000) return TRUE;
+    }
+    return FALSE;
+}
+
 /* (9154) WM_INPUTLANGCHANGEREQUEST's wParam */
 #ifndef INPUTLANGCHANGE_SYSCHARSET
 #define INPUTLANGCHANGE_SYSCHARSET 0x0001
@@ -1477,6 +1515,7 @@ BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *xev )
             if (!focus) focus = hwnd;
             NtUserPostMessage( focus, WM_INPUTLANGCHANGEREQUEST, flags, (LPARAM)group_layout );
             data->kbd_switch_layout = group_layout;
+            note_layout_request( data, group_layout );
         }
         data->kbd_group = group + 1;
         if (data->kbd_switch_layout == layout) data->kbd_switch_layout = 0;
@@ -1918,13 +1957,88 @@ void X11DRV_InitKeyboard( Display *display )
 }
 
 
+/* (9156) ask the session's compositor, which owns the keyboard on Xwayland, to type with layout group,
+ * on its control socket: SG_LOCK_CONTROL, which sg-session exports, else where the session puts it for
+ * this user (as wtsapi32's session state). 1 if it did, 0 if it refused, -1 if there is none */
+static int compositor_layout( int group )
+{
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    struct timeval tv = { .tv_sec = 1 };
+    const char *path = getenv( "SG_LOCK_CONTROL" );
+    char cmd[32], reply[64] = "";
+    int fd, len;
+    ssize_t got = -1;
+
+    if (path && *path)
+    {
+        if (strlen( path ) >= sizeof(addr.sun_path)) return -1;
+        strcpy( addr.sun_path, path );
+    }
+    else snprintf( addr.sun_path, sizeof(addr.sun_path), "/run/stained-glass-seat/seat0/%u/control.sock",
+                   (unsigned int)getuid() );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return -1;
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ))
+    {
+        close( fd );
+        return -1;
+    }
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    setsockopt( fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv) );
+    len = snprintf( cmd, sizeof(cmd), "LAYOUT %d\n", group );
+    if (send( fd, cmd, len, MSG_NOSIGNAL ) == len) got = recv( fd, reply, sizeof(reply) - 1, 0 );
+    close( fd );
+    if (got > 0) reply[got] = 0;
+    TRACE( "compositor %s: LAYOUT %d -> %s\n", debugstr_a(addr.sun_path), group, debugstr_a(reply) );
+    return got > 0 && !strncmp( reply, "OK", 2 );
+}
+
+static void switch_session_layout( struct x11drv_thread_data *data, int group )
+{
+    Display *display = data->display;
+    XkbStateRec state;
+    int ret;
+
+    if (XkbGetState( display, XkbUseCoreKbd, &state ) == Success && state.group == group) return;
+    TRACE( "the keyboard switches to group %d\n", group );
+    data->kbd_group = group + 1;   /* the key events that follow are in it: no request for it */
+    data->kbd_switch_layout = 0;
+    x11drv_group_layout( group );
+    /* a compositor owns the group (an X client's lock on Xwayland lasts until its next state); with
+     * none -- an X server of its own -- the X server does */
+    if ((ret = compositor_layout( group )) >= 0)
+    {
+        if (!ret) WARN( "the compositor did not switch to layout %d\n", group );
+        return;
+    }
+    XkbLockGroup( display, XkbUseCoreKbd, group );
+    XFlush( display );
+}
+
 /***********************************************************************
  *		ActivateKeyboardLayout (X11DRV.@)
  */
 BOOL X11DRV_ActivateKeyboardLayout(HKL hkl, UINT flags)
 {
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    HWND foreground = NtUserGetForegroundWindow();
+    int group;
+
     TRACE( "%p, %04x\n", hkl, flags );
 
+    /* Stained Glass OS (9156): the session's keyboard layouts are the display server's (the X map's
+     * groups). On Windows the input method is the person's, not each window's ("Let me use a different
+     * input method for each app window" is off): a program that activates one of them while it is in the
+     * foreground switches the keyboard -- the keys type in that layout and the input indicator, which
+     * follows the focus window, shows it. A thread in the background changes its own layout only. The
+     * switch the person made (WM_INPUTLANGCHANGEREQUEST's DefWindowProc) is already the keyboard's. */
+    if (!data || (group = x11drv_layout_group( hkl )) < 0) return TRUE;
+    if (take_layout_request( data, hkl )) return TRUE;
+#ifndef SG_MUTANT_KBD_ACTIVATE_ANY_THREAD
+    if (!foreground || NtUserGetWindowThread( foreground, NULL ) != GetCurrentThreadId()) return TRUE;
+#endif
+#ifndef SG_MUTANT_KBD_ACTIVATE_LOCAL
+    switch_session_layout( data, group );
+#endif
     return TRUE;
 }
 
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -206,6 +206,7 @@ extern const KBDTABLES *X11DRV_KbdLayerDescriptor( HKL hkl );
 extern void X11DRV_ReleaseKbdTables( const KBDTABLES *tables );
 extern UINT X11DRV_GetKeyboardLayoutDevice( UINT index );
 extern HKL x11drv_group_layout( UINT group );
+extern int x11drv_layout_group( HKL hkl );
 extern const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl );
 extern void x11drv_foreign_kbd_reset(void);
 extern void x11drv_x_map_windows_vks( Display *display, BYTE vks[0x80] );
@@ -475,6 +476,8 @@ struct x11drv_thread_data
     HWND     last_xic_hwnd;        /* last xic window */
     UINT     kbd_group;            /* (Stained Glass OS 9154) XKB group of the last key event + 1, 0 if none yet */
     HKL      kbd_switch_layout;    /* (9154) the layout the person switched to, until the thread has it */
+    HKL      kbd_requests[4];      /* (9156) the layouts of the input language changes posted for the person's own */
+    DWORD    kbd_request_times[4]; /* (9156) switches, and when: activating one is not a program's switch */
     XFontSet font_set;             /* international text drawing font set */
     Window   selection_wnd;        /* window used for selection interactions */
     unsigned long warp_serial;     /* serial number of last pointer warp request */
--- a/dlls/winex11.drv/xkbtables.c
+++ b/dlls/winex11.drv/xkbtables.c
@@ -1073,6 +1073,20 @@ HKL x11drv_group_layout( UINT group )
     return ULongToHandle( MAKELONG( LANGIDFROMLCID( locale ), device ) );
 }
 
+/* (9156) the XKB group that is the session's layout hkl (its high word), -1 if it is none of them */
+int x11drv_layout_group( HKL hkl )
+{
+    UINT g, device = HIWORD( (UINT_PTR)hkl );
+    int group = -1;
+
+    pthread_mutex_lock( &foreign_mutex );
+    if (!x_names_known) read_x_layout_names( thread_init_display() );
+    for (g = 0; g < x_groups; g++)
+        if (x_devices[g] && x_devices[g] == device) { group = g; break; }
+    pthread_mutex_unlock( &foreign_mutex );
+    return group;
+}
+
 #else  /* HAVE_XKBCOMMON_XKBCOMMON_H */
 
 void x11drv_x_map_windows_vks( Display *display, BYTE vks[0x80] )
@@ -1099,6 +1113,11 @@ HKL x11drv_group_layout( UINT group )
     return 0;
 }
 
+int x11drv_layout_group( HKL hkl )
+{
+    return -1;
+}
+
 #endif  /* HAVE_XKBCOMMON_XKBCOMMON_H */
 
 /***********************************************************************
