 {
-    FIXME("(%p, %p, %p, 0x%08lx) stub\n", p1, p2, p3, d1 );
-    return NULL;
+    TRACE("(%p, %p, %p, 0x%08lx)\n", modified, info, size, options);
+    return find_first_container(modified, info, size, options, TRUE);
 }
 
