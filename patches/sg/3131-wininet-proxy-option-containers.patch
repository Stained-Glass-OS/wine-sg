From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:41:14 -0700
Subject: [PATCH] wininet: INTERNET_OPTION_PROXY on a session handle, URL cache
 container enumeration

InternetSetOption(INTERNET_OPTION_PROXY) on an InternetOpen handle now sets the
session's access type, proxy and bypass list (direct, proxy with a name, or
preconfig); wrong sizes, a proxy type without a proxy name and unknown access
types are refused with ERROR_INVALID_PARAMETER. FindFirst/NextUrlCacheContainer
A/W enumerate the Content, History and Cookies containers with the
INTERNET_CACHE_CONTAINER_INFO layout (strings packed behind the structure,
ERROR_INSUFFICIENT_BUFFER with the size, ERROR_NO_MORE_ITEMS at the end) and
FindCloseUrlCache closes them.

diff --git a/dlls/wininet/internet.c b/dlls/wininet/internet.c
index cdb8e66..d7298d5 100644
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -1315,6 +1315,41 @@ static DWORD APPINFO_SetOption(object_header_t *hdr, DWORD option, void *buf, DW
     case INTERNET_OPTION_REFRESH:
         FIXME("INTERNET_OPTION_REFRESH\n");
         return ERROR_SUCCESS;
+    case INTERNET_OPTION_PROXY: {
+        INTERNET_PROXY_INFOW *info = buf;
+        WCHAR *proxy = NULL, *bypass = NULL;
+
+#ifdef SG_MUTANT_WININET_NOPROXYSET
+        return ERROR_INTERNET_INVALID_OPTION;
+#endif
+        if (!buf || size < sizeof(*info)) return ERROR_INVALID_PARAMETER;
+        if (info->dwAccessType == INTERNET_OPEN_TYPE_PROXY)
+        {
+            if (!info->lpszProxy) return ERROR_INVALID_PARAMETER;
+            if (!(proxy = wcsdup(info->lpszProxy))) return ERROR_OUTOFMEMORY;
+            if (info->lpszProxyBypass && !(bypass = wcsdup(info->lpszProxyBypass)))
+            {
+                free(proxy);
+                return ERROR_OUTOFMEMORY;
+            }
+        }
+        else if (info->dwAccessType != INTERNET_OPEN_TYPE_DIRECT && info->dwAccessType != INTERNET_OPEN_TYPE_PRECONFIG &&
+                 info->dwAccessType != INTERNET_OPEN_TYPE_PRECONFIG_WITH_NO_AUTOPROXY)
+            return ERROR_INVALID_PARAMETER;
+
+        free(ai->proxy);
+        free(ai->proxyBypass);
+        free(ai->proxyUsername);
+        free(ai->proxyPassword);
+        ai->proxy = proxy;
+        ai->proxyBypass = bypass;
+        ai->proxyUsername = ai->proxyPassword = NULL;
+        ai->accessType = info->dwAccessType;
+        if (info->dwAccessType == INTERNET_OPEN_TYPE_PRECONFIG ||
+            info->dwAccessType == INTERNET_OPEN_TYPE_PRECONFIG_WITH_NO_AUTOPROXY)
+            INTERNET_ConfigureProxy(ai);
+        return ERROR_SUCCESS;
+    }
     case INTERNET_OPTION_PER_CONNECTION_OPTION: {
         INTERNET_PER_CONN_OPTION_LISTW *con = buf;
         unsigned int i;
diff --git a/dlls/wininet/urlcache.c b/dlls/wininet/urlcache.c
index eecb9ef..b679255 100644
--- a/dlls/wininet/urlcache.c
+++ b/dlls/wininet/urlcache.c
@@ -192,6 +192,7 @@ typedef struct
     DWORD hash_table_idx;
     DWORD hash_entry_idx;
     DWORD filter; /* CacheEntryType bits an entry needs one of, 0: all */
+    BOOL containers; /* enumerates the containers, not the entries */
 } find_handle;
 
 /* List of all containers available */
@@ -3356,40 +3357,175 @@ BOOL WINAPI CreateUrlCacheContainerW(DWORD d1, DWORD d2, DWORD d3, DWORD d4,
     return TRUE;
 }
 
+/* INTERNET_CACHE_CONTAINER_INFO of the documentation */
+typedef struct
+{
+    DWORD dwCacheVersion;
+    char *lpszName;
+    char *lpszCachePrefix;
+    char *lpszVolumeLabel;
+    char *lpszVolumeTitle;
+} container_info_a;
+
+typedef struct
+{
+    DWORD dwCacheVersion;
+    WCHAR *lpszName;
+    WCHAR *lpszCachePrefix;
+    WCHAR *lpszVolumeLabel;
+    WCHAR *lpszVolumeTitle;
+} container_info_w;
+
+#define CACHE_FIND_CONTAINER_RETURN_NOCHANGE 0x1
+
+static const char *container_name(const cache_container *container)
+{
+    if (container->default_entry_type & COOKIE_CACHE_ENTRY) return "Cookies";
+    if (container->default_entry_type & URLHISTORY_CACHE_ENTRY) return "History";
+    return "Content";
+}
+
+static BOOL container_next(find_handle *handle, void *info, DWORD *size, BOOL unicode)
+{
+    cache_container *container;
+    const char *name;
+    DWORD name_len, prefix_len, needed;
+
+#ifdef SG_MUTANT_WININET_NOCONT
+    SetLastError(ERROR_NO_MORE_ITEMS);
+    return FALSE;
+#endif
+    if (!size || (*size && !info))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if (!cache_containers_enum(NULL, handle->container_idx, &container))
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+
+    name = container_name(container);
+    name_len = strlen(name) + 1;
+    prefix_len = strlen(container->cache_prefix) + 1;
+    /* name, prefix, and an empty volume label and title */
+    needed = (unicode ? sizeof(container_info_w) : sizeof(container_info_a)) + (name_len + prefix_len + 2) * (unicode ? sizeof(WCHAR) : 1);
+    if (*size < needed)
+    {
+        *size = needed;
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    *size = needed;
+
+    if (unicode)
+    {
+        container_info_w *w = info;
+        WCHAR *p = (WCHAR *)(w + 1);
+
+        w->dwCacheVersion = 1;
+        w->lpszName = p;
+        MultiByteToWideChar(CP_ACP, 0, name, name_len, p, name_len);
+        p += name_len;
+        w->lpszCachePrefix = p;
+        MultiByteToWideChar(CP_ACP, 0, container->cache_prefix, prefix_len, p, prefix_len);
+        p += prefix_len;
+        w->lpszVolumeLabel = p;
+        *p++ = 0;
+        w->lpszVolumeTitle = p;
+        *p = 0;
+    }
+    else
+    {
+        container_info_a *a = info;
+        char *p = (char *)(a + 1);
+
+        a->dwCacheVersion = 1;
+        a->lpszName = p;
+        memcpy(p, name, name_len);
+        p += name_len;
+        a->lpszCachePrefix = p;
+        memcpy(p, container->cache_prefix, prefix_len);
+        p += prefix_len;
+        a->lpszVolumeLabel = p;
+        *p++ = 0;
+        a->lpszVolumeTitle = p;
+        *p = 0;
+    }
+    handle->container_idx++;
+    return TRUE;
+}
+
+static HANDLE find_first_container(DWORD *modified, void *info, DWORD *size, DWORD options, BOOL unicode)
+{
+    find_handle *handle;
+
+    if (modified) *modified = 0;
+    if (!(handle = calloc(1, sizeof(*handle))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return NULL;
+    }
+    handle->magic = URLCACHE_FIND_ENTRY_HANDLE_MAGIC;
+    handle->containers = TRUE;
+    if (!container_next(handle, info, size, unicode))
+    {
+        DWORD error = GetLastError();
+        FindCloseUrlCache(handle);
+        SetLastError(error);
+        return NULL;
+    }
+    return handle;
+}
+
+static BOOL find_next_container(HANDLE hnd, void *info, DWORD *size, BOOL unicode)
+{
+    find_handle *handle = hnd;
+
+    if (!handle || handle->magic != URLCACHE_FIND_ENTRY_HANDLE_MAGIC || !handle->containers)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    return container_next(handle, info, size, unicode);
+}
+
 /***********************************************************************
  *           FindFirstUrlCacheContainerA (WININET.@)
  */
-HANDLE WINAPI FindFirstUrlCacheContainerA( LPVOID p1, LPVOID p2, LPVOID p3, DWORD d1 )
+HANDLE WINAPI FindFirstUrlCacheContainerA( DWORD *modified, void *info, DWORD *size, DWORD options )
 {
-    FIXME("(%p, %p, %p, 0x%08lx) stub\n", p1, p2, p3, d1 );
-    return NULL;
+    TRACE("(%p, %p, %p, 0x%08lx)\n", modified, info, size, options);
+    return find_first_container(modified, info, size, options, FALSE);
 }
 
