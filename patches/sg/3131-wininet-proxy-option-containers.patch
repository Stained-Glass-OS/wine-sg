 {
-    FIXME("(%p, %p, %p) stub\n", handle, p1, p2 );
-    return FALSE;
+    TRACE("(%p, %p, %p)\n", handle, info, size);
+    return find_next_container(handle, info, size, FALSE);
 }
 
 /***********************************************************************
  *           FindNextUrlCacheContainerW (WININET.@)
  */
-BOOL WINAPI FindNextUrlCacheContainerW( HANDLE handle, LPVOID p1, LPVOID p2 )
+BOOL WINAPI FindNextUrlCacheContainerW( HANDLE handle, void *info, DWORD *size )
 {
-    FIXME("(%p, %p, %p) stub\n", handle, p1, p2 );
-    return FALSE;
+    TRACE("(%p, %p, %p)\n", handle, info, size);
+    return find_next_container(handle, info, size, TRUE);
 }
 
