+/* the command line prompt: on the console, or what is given on standard
+ * input when it is not one */
+static void cmd_write( const WCHAR *text )
+{
+    HANDLE out = GetStdHandle( STD_ERROR_HANDLE );
+    DWORD written, len = lstrlenW( text );
+
+    if (!WriteConsoleW( out, text, len, &written, NULL ))
+    {
+        char *a = strdupWtoA( text );
+        if (a) WriteFile( out, a, strlen( a ), &written, NULL );
+        free( a );
+    }
+}
+
+static void cmd_write_id( UINT id, const WCHAR *arg1, const WCHAR *arg2 )
+{
+    WCHAR format[256], text[1024];
+    DWORD_PTR args[2];
+
+    LoadStringW( hinstCredUI, id, format, ARRAY_SIZE(format) );
+    args[0] = (DWORD_PTR)(arg1 ? arg1 : L"");
+    args[1] = (DWORD_PTR)(arg2 ? arg2 : L"");
+    if (FormatMessageW( FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY, format, 0, 0, text,
+                        ARRAY_SIZE(text), (va_list *)args ))
+        cmd_write( text );
+}
+
+static BOOL cmd_read( WCHAR *buf, ULONG len, BOOL echo )
+{
+    HANDLE in = GetStdHandle( STD_INPUT_HANDLE );
+    DWORD mode = 0, read, i = 0;
+    BOOL console = GetConsoleMode( in, &mode );
+    char c;
+
+    if (!len) return FALSE;
+    if (console)
+    {
+        WCHAR line[1024];
+
+        if (!echo) SetConsoleMode( in, mode & ~ENABLE_ECHO_INPUT );
+        if (!ReadConsoleW( in, line, ARRAY_SIZE(line) - 1, &read, NULL )) read = 0;
+        if (!echo)
+        {
+            SetConsoleMode( in, mode );
+            cmd_write( L"\n" );
+        }
+        while (read && (line[read - 1] == '\n' || line[read - 1] == '\r')) read--;
+        line[read] = 0;
+        lstrcpynW( buf, line, len );
+        SecureZeroMemory( line, sizeof(line) );
+        return TRUE;
+    }
+    /* a pipe or a file: one line */
+    while (ReadFile( in, &c, 1, &read, NULL ) && read)
+    {
+        WCHAR wc;
+
+        if (c == '\n') break;
+        if (c == '\r') continue;
+        MultiByteToWideChar( CP_ACP, 0, &c, 1, &wc, 1 );
+        if (i + 1 < len) buf[i++] = wc;
+    }
+    buf[i] = 0;
+    if (!echo) cmd_write( L"\n" );
+    return TRUE;
+}
