+
+/* Stained Glass OS: authentication buffers. A packed buffer is a
+ * KERB_INTERACTIVE_LOGON (KerbInteractiveLogon) whose strings follow it, their
+ * Buffer fields offsets from the start, as LsaLogonUser takes it; with
+ * CRED_PACK_WOW_BUFFER, the 32-bit layout. With CRED_PACK_PROTECTED_CREDENTIALS
+ * the password is protected with CredProtect (and unprotected on unpacking). */
+#define KERB_INTERACTIVE_LOGON_TYPE 2
+#define KERB_WORKSTATION_UNLOCK_LOGON_TYPE 7
+
+struct packed_string
+{
+    USHORT Length;
+    USHORT MaximumLength;
+    ULONG_PTR Buffer;
+};
+
+struct packed_logon
+{
+    ULONG MessageType;
+    struct packed_string LogonDomainName;
+    struct packed_string UserName;
+    struct packed_string Password;
+};
+
+struct packed_string32
+{
+    USHORT Length;
+    USHORT MaximumLength;
+    ULONG Buffer;
+};
+
+struct packed_logon32
+{
+    ULONG MessageType;
+    struct packed_string32 LogonDomainName;
+    struct packed_string32 UserName;
+    struct packed_string32 Password;
+};
+
+#define CRED_PACK_VALID_FLAGS (CRED_PACK_PROTECTED_CREDENTIALS | CRED_PACK_WOW_BUFFER | \
+                               CRED_PACK_GENERIC_CREDENTIALS | CRED_PACK_ID_PROVIDER_CREDENTIALS)
+
+/******************************************************************************
+ * CredPackAuthenticationBufferW [CREDUI.@]
+ */
+BOOL WINAPI CredPackAuthenticationBufferW( DWORD flags, WCHAR *username, WCHAR *password, BYTE *buf,
+                                           DWORD *size )
+{
+    WCHAR protected_pw[1024], *pw = password;
+    DWORD header, needed, len_user, len_pw, protected_len = ARRAY_SIZE(protected_pw);
+    BYTE *ptr;
+
+    TRACE( "(%08lx, %s, %p, %p, %p)\n", flags, debugstr_w(username), password, buf, size );
+
+    if (!username || !password || !size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (flags & ~CRED_PACK_VALID_FLAGS)
+    {
+        SetLastError( ERROR_INVALID_FLAGS );
+        return FALSE;
+    }
+    if (flags & CRED_PACK_PROTECTED_CREDENTIALS)
+    {
+        CRED_PROTECTION_TYPE type;
+
+        if (!CredIsProtectedW( password, &type ) || type == CredUnprotected)
+        {
+            if (!CredProtectW( FALSE, password, lstrlenW(password) + 1, protected_pw, &protected_len, &type ))
+                return FALSE;
+            pw = protected_pw;
+        }
+    }
+
+    header = (flags & CRED_PACK_WOW_BUFFER) ? sizeof(struct packed_logon32) : sizeof(struct packed_logon);
+    len_user = lstrlenW( username );
+    len_pw = lstrlenW( pw );
+    needed = header + sizeof(WCHAR) + (len_user + 1 + len_pw + 1) * sizeof(WCHAR);
+    if (!buf || *size < needed)
+    {
+        *size = needed;
+        SecureZeroMemory( protected_pw, sizeof(protected_pw) );
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+
+    memset( buf, 0, needed );
+    ptr = buf + header;
+    /* an empty domain, then the user name and the password */
+    if (flags & CRED_PACK_WOW_BUFFER)
+    {
+        struct packed_logon32 *logon = (struct packed_logon32 *)buf;
+
+        logon->MessageType = KERB_INTERACTIVE_LOGON_TYPE;
+        logon->LogonDomainName.MaximumLength = sizeof(WCHAR);
+        logon->LogonDomainName.Buffer = ptr - buf;
+        ptr += sizeof(WCHAR);
+        logon->UserName.Length = len_user * sizeof(WCHAR);
+        logon->UserName.MaximumLength = (len_user + 1) * sizeof(WCHAR);
+        logon->UserName.Buffer = ptr - buf;
+        memcpy( ptr, username, len_user * sizeof(WCHAR) );
+        ptr += (len_user + 1) * sizeof(WCHAR);
+        logon->Password.Length = len_pw * sizeof(WCHAR);
+        logon->Password.MaximumLength = (len_pw + 1) * sizeof(WCHAR);
+        logon->Password.Buffer = ptr - buf;
+        memcpy( ptr, pw, len_pw * sizeof(WCHAR) );
+    }
+    else
+    {
+        struct packed_logon *logon = (struct packed_logon *)buf;
+
+        logon->MessageType = KERB_INTERACTIVE_LOGON_TYPE;
+        logon->LogonDomainName.MaximumLength = sizeof(WCHAR);
+        logon->LogonDomainName.Buffer = ptr - buf;
+        ptr += sizeof(WCHAR);
+        logon->UserName.Length = len_user * sizeof(WCHAR);
+        logon->UserName.MaximumLength = (len_user + 1) * sizeof(WCHAR);
+        logon->UserName.Buffer = ptr - buf;
+        memcpy( ptr, username, len_user * sizeof(WCHAR) );
+        ptr += (len_user + 1) * sizeof(WCHAR);
+        logon->Password.Length = len_pw * sizeof(WCHAR);
+        logon->Password.MaximumLength = (len_pw + 1) * sizeof(WCHAR);
+        logon->Password.Buffer = ptr - buf;
+        memcpy( ptr, pw, len_pw * sizeof(WCHAR) );
+    }
+    *size = needed;
+    SecureZeroMemory( protected_pw, sizeof(protected_pw) );
+    return TRUE;
+}
+
+static BOOL get_packed_string( const BYTE *buf, DWORD size, USHORT len, ULONG_PTR offset, const WCHAR **str )
+{
+    *str = NULL;
+    if (!len) return TRUE;
+    if (len % sizeof(WCHAR) || offset > size || len > size - offset) return FALSE;
+    *str = (const WCHAR *)(buf + offset);
+    return TRUE;
+}
+
+static BOOL return_string( const WCHAR *str, DWORD len, WCHAR *out, DWORD *out_len, BOOL *too_small )
+{
+    if (!out_len) return TRUE;
+    if (!out || *out_len < len + 1)
+    {
+        *too_small = TRUE;
+        *out_len = len + 1;
+        return TRUE;
+    }
+    if (len) memcpy( out, str, len * sizeof(WCHAR) );
+    out[len] = 0;
+    *out_len = len + 1;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredUnPackAuthenticationBufferW [CREDUI.@]
+ */
+BOOL WINAPI CredUnPackAuthenticationBufferW( DWORD flags, void *buf, DWORD size, WCHAR *username,
+                                             DWORD *len_username, WCHAR *domain, DWORD *len_domain,
+                                             WCHAR *password, DWORD *len_password )
+{
+    const WCHAR *dom, *user, *pw;
+    DWORD dom_len, user_len, pw_len, type;
+    WCHAR *combined = NULL, unprotected[1024];
+    BOOL too_small = FALSE;
+
+    TRACE( "(%08lx, %p, %lu, %p, %p, %p, %p, %p, %p)\n", flags, buf, size, username, len_username,
+           domain, len_domain, password, len_password );
+
+    if (!buf || !len_username || !len_password)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (flags & ~CRED_PACK_VALID_FLAGS)
+    {
+        SetLastError( ERROR_INVALID_FLAGS );
+        return FALSE;
+    }
+
+    if (flags & CRED_PACK_WOW_BUFFER)
+    {
+        const struct packed_logon32 *logon = buf;
+
+        if (size < sizeof(*logon)) goto invalid;
+        type = logon->MessageType;
+        if (!get_packed_string( buf, size, logon->LogonDomainName.Length, logon->LogonDomainName.Buffer, &dom ) ||
+            !get_packed_string( buf, size, logon->UserName.Length, logon->UserName.Buffer, &user ) ||
+            !get_packed_string( buf, size, logon->Password.Length, logon->Password.Buffer, &pw ))
+            goto invalid;
+        dom_len = logon->LogonDomainName.Length / sizeof(WCHAR);
+        user_len = logon->UserName.Length / sizeof(WCHAR);
+        pw_len = logon->Password.Length / sizeof(WCHAR);
+    }
+    else
+    {
+        const struct packed_logon *logon = buf;
+
+        if (size < sizeof(*logon)) goto invalid;
+        type = logon->MessageType;
+        if (!get_packed_string( buf, size, logon->LogonDomainName.Length, logon->LogonDomainName.Buffer, &dom ) ||
+            !get_packed_string( buf, size, logon->UserName.Length, logon->UserName.Buffer, &user ) ||
+            !get_packed_string( buf, size, logon->Password.Length, logon->Password.Buffer, &pw ))
+            goto invalid;
+        dom_len = logon->LogonDomainName.Length / sizeof(WCHAR);
+        user_len = logon->UserName.Length / sizeof(WCHAR);
+        pw_len = logon->Password.Length / sizeof(WCHAR);
+    }
+    if (type != KERB_INTERACTIVE_LOGON_TYPE && type != KERB_WORKSTATION_UNLOCK_LOGON_TYPE) goto invalid;
+
+    /* asked for no domain: it is in the user name */
+    if (dom_len && !domain && !len_domain)
+    {
+        if (!(combined = malloc( (dom_len + 1 + user_len) * sizeof(WCHAR) )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+        memcpy( combined, dom, dom_len * sizeof(WCHAR) );
+        combined[dom_len] = '\\';
+        if (user_len) memcpy( combined + dom_len + 1, user, user_len * sizeof(WCHAR) );
+        user = combined;
+        user_len += dom_len + 1;
+        dom_len = 0;
+    }
+
+    if ((flags & CRED_PACK_PROTECTED_CREDENTIALS) && pw_len && pw_len < ARRAY_SIZE(unprotected))
+    {
+        WCHAR copy[1024];
+        DWORD len = ARRAY_SIZE(unprotected);
+        CRED_PROTECTION_TYPE prot;
+
+        memcpy( copy, pw, pw_len * sizeof(WCHAR) );
+        copy[pw_len] = 0;
+        if (CredIsProtectedW( copy, &prot ) && prot != CredUnprotected)
+        {
+#ifndef SG_MUTANT_NO_UNPROTECT
+            if (!CredUnprotectW( FALSE, copy, pw_len + 1, unprotected, &len ))
+            {
+                SecureZeroMemory( copy, sizeof(copy) );
+                free( combined );
+                return FALSE;
+            }
+            pw = unprotected;
+            pw_len = len - 1;
+#endif
+        }
+        SecureZeroMemory( copy, sizeof(copy) );
+    }
+
+    return_string( user, user_len, username, len_username, &too_small );
+    return_string( dom, dom_len, domain, len_domain, &too_small );
+    return_string( pw, pw_len, password, len_password, &too_small );
+    SecureZeroMemory( unprotected, sizeof(unprotected) );
+    free( combined );
+    if (too_small)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    return TRUE;
+
+invalid:
+    SetLastError( ERROR_NOT_CAPABLE );
+    return FALSE;
+}
+
+static char *strdupWtoA( const WCHAR *str )
+{
+    char *ret;
+    DWORD len;
+
+    if (!str) return NULL;
+    len = WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL );
+    if ((ret = malloc( len ))) WideCharToMultiByte( CP_ACP, 0, str, -1, ret, len, NULL, NULL );
+    return ret;
+}
