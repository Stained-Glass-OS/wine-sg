+/******************************************************************************
+ * CredUICmdLinePromptForCredentialsW [CREDUI.@]
+ */
+DWORD WINAPI CredUICmdLinePromptForCredentialsW( const WCHAR *target, CtxtHandle *reserved, DWORD error,
+                                                 WCHAR *username, ULONG len_username, WCHAR *password,
+                                                 ULONG len_password, BOOL *save, DWORD flags )
+{
+    WCHAR answer[16];
+
+    TRACE( "(%s, %p, %lu, %s, %lu, %p, %lu, %p, %#lx)\n", debugstr_w(target), reserved, error,
+           debugstr_w(username), len_username, password, len_password, save, flags );
+
+    if ((flags & (CREDUI_FLAGS_ALWAYS_SHOW_UI | CREDUI_FLAGS_GENERIC_CREDENTIALS)) == CREDUI_FLAGS_ALWAYS_SHOW_UI)
+        return ERROR_INVALID_FLAGS;
+    if (!target || !username || !password || !len_username || !len_password) return ERROR_INVALID_PARAMETER;
+    if ((flags & CREDUI_FLAGS_SHOW_SAVE_CHECK_BOX) && !save) return ERROR_INVALID_PARAMETER;
+
+    if (!(flags & CREDUI_FLAGS_ALWAYS_SHOW_UI) && !(flags & CREDUI_FLAGS_INCORRECT_PASSWORD) &&
+        find_existing_credential( target, username, len_username, password, len_password ))
+        return ERROR_SUCCESS;
+
+    if (flags & CREDUI_FLAGS_INCORRECT_PASSWORD) cmd_write_id( IDS_CMD_INCORRECT, NULL, NULL );
+    if (!username[0] || !(flags & CREDUI_FLAGS_KEEP_USERNAME))
+    {
+        WCHAR name[CREDUI_MAX_USERNAME_LENGTH + 1];
+
+        cmd_write_id( IDS_CMD_USERNAME, target, NULL );
+        if (!cmd_read( name, ARRAY_SIZE(name), TRUE )) return ERROR_CANCELLED;
+        if (name[0]) lstrcpynW( username, name, len_username );
+        if (!username[0]) return ERROR_CANCELLED;
+    }
+    cmd_write_id( IDS_CMD_PASSWORD, username, target );
+    if (!cmd_read( password, len_password, FALSE )) return ERROR_CANCELLED;
+
+    if (flags & CREDUI_FLAGS_SHOW_SAVE_CHECK_BOX)
+    {
+        cmd_write_id( IDS_CMD_SAVE, NULL, NULL );
+        cmd_read( answer, ARRAY_SIZE(answer), TRUE );
+        *save = answer[0] == 'y' || answer[0] == 'Y';
+    }
+    if (save && *save && !(flags & CREDUI_FLAGS_DO_NOT_PERSIST))
+    {
+        if (flags & CREDUI_FLAGS_EXPECT_CONFIRMATION)
+        {
+            /* kept until CredUIConfirmCredentials, as the dialog's */
+            struct pending_credentials *entry = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*entry) );
+
+            if (!entry) return ERROR_NOT_ENOUGH_MEMORY;
+            entry->pszTargetName = HeapAlloc( GetProcessHeap(), 0, (lstrlenW(target) + 1) * sizeof(WCHAR) );
+            entry->pszUsername = HeapAlloc( GetProcessHeap(), 0, (lstrlenW(username) + 1) * sizeof(WCHAR) );
+            entry->pszPassword = HeapAlloc( GetProcessHeap(), 0, (lstrlenW(password) + 1) * sizeof(WCHAR) );
+            lstrcpyW( entry->pszTargetName, target );
+            lstrcpyW( entry->pszUsername, username );
+            lstrcpyW( entry->pszPassword, password );
+            entry->generic = (flags & CREDUI_FLAGS_GENERIC_CREDENTIALS) != 0;
+            EnterCriticalSection( &csPendingCredentials );
+            list_add_tail( &pending_credentials_list, &entry->entry );
+            LeaveCriticalSection( &csPendingCredentials );
+        }
+        else return save_credentials( target, username, password, (flags & CREDUI_FLAGS_GENERIC_CREDENTIALS) != 0 );
+    }
+    return ERROR_SUCCESS;
+}
