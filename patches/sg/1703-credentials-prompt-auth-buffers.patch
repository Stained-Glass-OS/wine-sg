+/******************************************************************************
+ * CredPackAuthenticationBufferA [CREDUI.@]
+ */
+BOOL WINAPI CredPackAuthenticationBufferA( DWORD flags, char *username, char *password, BYTE *buf, DWORD *size )
+{
+    WCHAR *userW = strdupAtoW( username ), *passW = strdupAtoW( password );
+    BOOL ret;
+
+    TRACE( "(%08lx, %s, %p, %p, %p)\n", flags, debugstr_a(username), password, buf, size );
+
+    ret = CredPackAuthenticationBufferW( flags, userW, passW, buf, size );
+    free( userW );
+    if (passW) SecureZeroMemory( passW, lstrlenW(passW) * sizeof(WCHAR) );
+    free( passW );
+    return ret;
+}
+
+static BOOL return_string_a( const WCHAR *str, char *out, DWORD *out_len, BOOL *too_small )
+{
+    DWORD len;
+
+    if (!out_len) return TRUE;
+    len = WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL );
+    if (!out || *out_len < len) *too_small = TRUE;
+    else WideCharToMultiByte( CP_ACP, 0, str, -1, out, len, NULL, NULL );
+    *out_len = len;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredUnPackAuthenticationBufferA [CREDUI.@]
+ */
+BOOL WINAPI CredUnPackAuthenticationBufferA( DWORD flags, void *buf, DWORD size, char *username,
+                                             DWORD *len_username, char *domain, DWORD *len_domain,
+                                             char *password, DWORD *len_password )
+{
+    WCHAR user[CREDUI_MAX_USERNAME_LENGTH + 1], dom[CREDUI_MAX_DOMAIN_TARGET_LENGTH + 1], pass[1024];
+    DWORD ulen = ARRAY_SIZE(user), dlen = ARRAY_SIZE(dom), plen = ARRAY_SIZE(pass);
+    BOOL too_small = FALSE;
+
+    TRACE( "(%08lx, %p, %lu, %p, %p, %p, %p, %p, %p)\n", flags, buf, size, username, len_username,
+           domain, len_domain, password, len_password );
+
+    if (!len_username || !len_password)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!CredUnPackAuthenticationBufferW( flags, buf, size, user, &ulen, (domain || len_domain) ? dom : NULL,
+                                          (domain || len_domain) ? &dlen : NULL, pass, &plen ))
+        return FALSE;
+    return_string_a( user, username, len_username, &too_small );
+    if (domain || len_domain) return_string_a( dom, domain, len_domain, &too_small );
+    return_string_a( pass, password, len_password, &too_small );
+    SecureZeroMemory( pass, sizeof(pass) );
+    if (too_small)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    return TRUE;
+}
