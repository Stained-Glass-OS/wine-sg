From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: the view's own icon list takes overlay pictures drawn for its size

In large icons the view's own image list took an overlay's picture from the 256-pixel system list and scaled it down. Overlay icons are drawn differently for each size, and OneDrive's mark is a fifth of its 256-pixel frame but a quarter of the 96-pixel one, so the scaled mark was too small in the icon's corner. The own list now reads the overlay's picture from its file at the list's size.
---
diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 51a9a98..70f5331 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -1532,6 +1532,28 @@ BOOL SHELL32_OverlayRequest( IShellIconOverlay *folder, LPCITEMIDLIST child, HWN
     return FALSE;
 }
 
+/* Stained Glass OS 6255: an overlay's picture at a size, read from its file (an overlay's frames
+ * are drawn for their sizes: OneDrive's mark is a fifth of its 256-pixel frame but a quarter of
+ * 96, so one scaled from the jumbo list is too small); NULL when it has none */
+HICON SHELL32_OverlayIcon( int overlay, int size )
+{
+    WCHAR file[MAX_PATH];
+    HICON icon = NULL;
+    int index = 0;
+
+    if (!overlays_wait_ready()) return NULL;
+    EnterCriticalSection( &overlay_cs );
+    if (overlay >= 1 && overlay <= (int)overlay_count && overlay_handlers[overlay - 1].obj)
+    {
+        lstrcpynW( file, overlay_handlers[overlay - 1].icon_file, MAX_PATH );
+        index = overlay_handlers[overlay - 1].icon_index;
+    }
+    else file[0] = 0;
+    LeaveCriticalSection( &overlay_cs );
+    if (file[0] && !PrivateExtractIconsW( file, index, size, size, &icon, NULL, 1, 0 )) icon = NULL;
+    return icon;
+}
+
 /* the system image list index of an overlay (1..15), -1 when it has none */
 int SHELL32_OverlayImage( int overlay )
 {
diff --git a/dlls/shell32/shell32_main.h b/dlls/shell32/shell32_main.h
index 1ab1c4e..319f009 100644
--- a/dlls/shell32/shell32_main.h
+++ b/dlls/shell32/shell32_main.h
@@ -54,6 +54,7 @@ INT SIC_GetIconIndex (LPCWSTR sSourceFile, INT dwSourceIndex, DWORD dwFlags );
 HRESULT SIC_get_location( int list_idx, WCHAR *file, DWORD *size, int *res_idx );
 int SHELL32_OverlayForPath( const WCHAR *path, DWORD attributes, int *image );
 int SHELL32_OverlayImage( int overlay );
+HICON SHELL32_OverlayIcon( int overlay, int size );
 BOOL SHELL32_OverlayIsSlow(void);
 BOOL SHELL32_OverlayRequest( IShellIconOverlay *folder, LPCITEMIDLIST child, HWND hwnd, UINT msg,
                              void *cookie, void (*free_cookie)(void *) );
diff --git a/dlls/shell32/shlview.c b/dlls/shell32/shlview.c
index 33d65f2..2522b19 100644
--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -897,7 +897,18 @@ static void ShellView_OwnOverlay(IShellViewImpl *This, int overlay)
 {
     if (overlay > 0 && overlay < 16 && This->own_icons && !This->own_overlay_set[overlay])
     {
-        int own = ShellView_OwnIcon(This, SHELL32_OverlayImage(overlay));
+        int own = -1, cx = 0, cy = 0;
+        HICON icon = NULL;
+
+        /* 6255: the picture drawn for the list's size, as the system lists have theirs */
+#ifndef SG_MUTANT_OVERLAY_SCALED
+        if (ImageList_GetIconSize(This->own_icons, &cx, &cy) && (icon = SHELL32_OverlayIcon(overlay, cx)))
+        {
+            own = ImageList_AddIcon(This->own_icons, icon);
+            DestroyIcon(icon);
+        }
+#endif
+        if (own < 0) own = ShellView_OwnIcon(This, SHELL32_OverlayImage(overlay));
         if (own >= 0) ImageList_SetOverlayImage(This->own_icons, own, overlay);
         TRACE("overlay %d is image %d of the view's own list %p\n", overlay, own, This->own_icons);
         This->own_overlay_set[overlay] = TRUE;
