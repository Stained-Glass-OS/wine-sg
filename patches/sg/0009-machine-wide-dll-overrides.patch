From: Stained Glass OS <dev@stained-glass.example>
Subject: Consult HKLM for DLL overrides, after HKCU

Upstream reads DLL overrides from HKCU only. For a single-user prefix that is
the whole story; for a system-wide installation it leaves machine policy with
nowhere to live.

In a shared system prefix HKCU is per user, so an administrator installing
DXVK and VKD3D-Proton would have to write the overrides into every existing
user's hive -- and into every hive created afterwards, which is not something
an installer can do. The DLLs sit in system32 and syswow64 looking installed
while Wine quietly loads its own builtins instead. Nothing reports an error:
Direct3D works, just not through the translation layer that was installed for
it, which is the kind of difference that only shows up as bad frame rates.

Machine-wide overrides are consulted last, after the environment variable, the
per-application key and the user's own key, so anything a user sets still
wins. The key is opened read-only: HKLM is machine state an ordinary user must
not rewrite, and asking for KEY_ALL_ACCESS would fail for every non-admin,
which in this design is every interactive user.

Verified with DXVK 3.1.1 and VKD3D-Proton 3.0.1 installed into a system
prefix: before, d3d11 and d3d12 came from Wine's builtins; after, DXVK and
VKD3D-Proton report themselves and create D3D11 (feature level 11_0) and
D3D12 devices on both 32-bit and 64-bit.

Forwarded: not-needed
--- a/dlls/ntdll/unix/registry.c
+++ b/dlls/ntdll/unix/registry.c
@@ -69,6 +69,27 @@
 }
 
 
+/* Stained Glass OS: the machine-wide counterpart of open_hkcu_key.
+ *
+ * Opened read-only on purpose. HKLM is machine state that an ordinary user
+ * must not be able to rewrite, and in a shared system prefix asking for
+ * KEY_ALL_ACCESS here would fail for every user who is not an administrator --
+ * which is all of them. */
+NTSTATUS open_hklm_key( const char *path, HANDLE *key )
+{
+    char buffer[256];
+    WCHAR bufferW[256];
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    DWORD len;
+
+    len = snprintf( buffer, sizeof(buffer), "\\Registry\\Machine\\%s", path );
+    ascii_to_unicode( bufferW, buffer, len + 1 );
+    init_unicode_string( &name, bufferW );
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    return NtOpenKey( key, KEY_READ, &attr );
+}
+
 /******************************************************************************
  *              NtCreateKey  (NTDLL.@)
  */
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -325,6 +325,7 @@
 extern NTSTATUS set_thread_wow64_context( HANDLE handle, const void *ctx, ULONG size );
 extern void fill_vm_counters( VM_COUNTERS_EX *pvmi, int unix_pid );
 extern NTSTATUS open_hkcu_key( const char *path, HANDLE *key );
+extern NTSTATUS open_hklm_key( const char *path, HANDLE *key );
 
 extern NTSTATUS sync_ioctl( HANDLE file, ULONG code, void *in_buffer, ULONG in_size,
                             void *out_buffer, ULONG out_size );
--- a/dlls/ntdll/unix/loadorder.c
+++ b/dlls/ntdll/unix/loadorder.c
@@ -56,6 +56,7 @@
 static const WCHAR separatorsW[] = {',',' ','\t',0};
 
 static HANDLE std_key;
+static HANDLE machine_key;
 static HANDLE app_key;
 static BOOL init_done;
 static BOOL main_exe_loaded;
@@ -226,6 +227,8 @@
 
     /* @@ Wine registry key: HKCU\Software\Wine\DllOverrides */
     open_hkcu_key( "Software\\Wine\\DllOverrides", &std_key );
+    /* @@ Wine registry key: HKLM\Software\Wine\DllOverrides */
+    open_hklm_key( "Software\\Wine\\DllOverrides", &machine_key );
 
     init_done = TRUE;
 
@@ -330,6 +333,7 @@
  * 1. The WINEDLLOVERRIDES environment variable
  * 2. The per-application DllOverrides key
  * 3. The standard DllOverrides key
+ * 4. The machine-wide DllOverrides key
  */
 static enum loadorder get_load_order_value( HANDLE std_key, HANDLE app_key, WCHAR *module )
 {
@@ -353,6 +357,17 @@
         return ret;
     }
 
+    /* Stained Glass OS: machine-wide policy, last so that anything a user set
+     * still wins. Upstream consults HKCU only, which leaves a system-wide
+     * install with nowhere to put a DLL override: in a shared prefix HKCU is
+     * per user, so an administrator installing DXVK would have to write into
+     * every user's hive and into every hive created afterwards. */
+    if (machine_key && ((ret = get_registry_value( machine_key, module )) != LO_INVALID))
+    {
+        TRACE( "got machine key %s for %s\n", debugstr_loadorder(ret), debugstr_w(module) );
+        return ret;
+    }
+
     return ret;
 }
 
