From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advpack: UserUnInstStubWrapper (3676)

advpack: UserUnInstStubWrapper

UserUnInstStubWrapperA/W run the RealStubPath of the "<guid>.Restore" key
under Active Setup\Installed Components, the uninstall twin of
UserInstStubWrapper (which now shares its code). The call needs
administrator rights.
---
diff --git a/dlls/advpack/advpack.c b/dlls/advpack/advpack.c
index bbde228..a6efac6 100644
--- a/dlls/advpack/advpack.c
+++ b/dlls/advpack/advpack.c
@@ -878,8 +878,8 @@ HRESULT WINAPI UserInstStubWrapperA(HWND hWnd, HINSTANCE hInstance,
  *   we should call ExpandEnvironmentStrings on the value and
  *   launch the result.
  */
-HRESULT WINAPI UserInstStubWrapperW(HWND hWnd, HINSTANCE hInstance,
-                                    LPWSTR pszParms, INT nShow)
+static HRESULT user_stub_wrapper(HWND hWnd, HINSTANCE hInstance,
+                                 LPWSTR pszParms, INT nShow, const WCHAR *suffix)
 {
     HKEY setup, guid;
     WCHAR stub[MAX_PATH];
@@ -887,8 +887,6 @@ HRESULT WINAPI UserInstStubWrapperW(HWND hWnd, HINSTANCE hInstance,
     HRESULT hr = S_OK;
     BOOL res;
 
-    TRACE("(%p, %p, %s, %i)\n", hWnd, hInstance, debugstr_w(pszParms), nShow);
-
     if (!pszParms || !*pszParms)
         return E_INVALIDARG;
 
@@ -897,9 +895,27 @@ HRESULT WINAPI UserInstStubWrapperW(HWND hWnd, HINSTANCE hInstance,
         return E_FAIL;
     }
 
-    if (RegOpenKeyExW(setup, pszParms, 0, KEY_READ, &guid))
+    if (suffix)
+    {
+        WCHAR name[MAX_PATH];
+
+        if (lstrlenW(pszParms) + lstrlenW(suffix) >= MAX_PATH)
+        {
+            RegCloseKey(setup);
+            return E_FAIL;
+        }
+        lstrcpyW(name, pszParms);
+        lstrcatW(name, suffix);
+        res = RegOpenKeyExW(setup, name, 0, KEY_READ, &guid);
+    }
+    else
+        res = RegOpenKeyExW(setup, pszParms, 0, KEY_READ, &guid);
+    if (res)
     {
         RegCloseKey(setup);
+#ifdef ADV_MUT_MISSING
+        return S_OK;
+#endif
         return E_FAIL;
     }
 
@@ -917,6 +933,14 @@ done:
     return hr;
 }
 
+HRESULT WINAPI UserInstStubWrapperW(HWND hWnd, HINSTANCE hInstance,
+                                    LPWSTR pszParms, INT nShow)
+{
+    TRACE("(%p, %p, %s, %i)\n", hWnd, hInstance, debugstr_w(pszParms), nShow);
+
+    return user_stub_wrapper(hWnd, hInstance, pszParms, nShow, NULL);
+}
+
 /***********************************************************************
  *             UserUnInstStubWrapperA   (ADVPACK.@)
  *
@@ -948,7 +972,27 @@ HRESULT WINAPI UserUnInstStubWrapperA(HWND hWnd, HINSTANCE hInstance,
 HRESULT WINAPI UserUnInstStubWrapperW(HWND hWnd, HINSTANCE hInstance,
                                       LPWSTR pszParms, INT nShow)
 {
-    FIXME("(%p, %p, %s, %i): stub\n", hWnd, hInstance, debugstr_w(pszParms), nShow);
+    SID_IDENTIFIER_AUTHORITY nt_authority = { SECURITY_NT_AUTHORITY };
+    PSID admins = NULL;
+    BOOL is_admin = FALSE;
 
-    return E_FAIL;
+    TRACE("(%p, %p, %s, %i)\n", hWnd, hInstance, debugstr_w(pszParms), nShow);
+
+    /* Observed behaviour (not Microsoft documentation): the uninstall twin of
+     * UserInstStubWrapper needs administrator rights and reads RealStubPath
+     * from the "<guid>.Restore" Active Setup key.  CORE review: installer. */
+    if (AllocateAndInitializeSid(&nt_authority, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS,
+                                 0, 0, 0, 0, 0, 0, &admins))
+    {
+        CheckTokenMembership(NULL, admins, &is_admin);
+        FreeSid(admins);
+    }
+#ifndef ADV_MUT_ADMIN
+    if (!is_admin) return E_FAIL;
+#endif
+
+#ifdef ADV_MUT_SUFFIX
+    return user_stub_wrapper(hWnd, hInstance, pszParms, nShow, NULL);
+#endif
+    return user_stub_wrapper(hWnd, hInstance, pszParms, nShow, L".Restore");
 }
