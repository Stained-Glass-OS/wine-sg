+/* Stained Glass OS 9930: a program the person may bring forward that starts a Unix program (a bridge,
+ * a helper that starts the real window again: Setup's) hands it a token in its environment; the Wine
+ * program that one starts claims it and gets the starter's grant -- the same as a program it started
+ * itself. Tokens end with the person's moving on, as grants do, and are claimed once. */
+static struct { unsigned int token, serial; } fg_tokens[16];
+
+static unsigned int foreground_token_issue(void)
+{
+    static unsigned int next;
+    unsigned int i, oldest = 0, token;
+
+    token = (unsigned int)(monotonic_time ^ (monotonic_time >> 29)) * 2654435761u + ++next;
+    if (!token) token = 1;
+    for (i = 0; i < ARRAY_SIZE(fg_tokens); i++)
+    {
+        if (!fg_tokens[i].token || fg_tokens[i].serial != fg_input_serial) { oldest = i; break; }
+        oldest = (oldest + 1) % ARRAY_SIZE(fg_tokens);
+    }
+    fg_tokens[oldest].token = token;
+    fg_tokens[oldest].serial = fg_input_serial;
+    return token;
+}
+
+static void foreground_token_claim( struct process *process, unsigned int token )
+{
+    unsigned int i;
+
+    if (!token) return;
+    for (i = 0; i < ARRAY_SIZE(fg_tokens); i++)
+    {
+        if (fg_tokens[i].token != token) continue;
+#ifndef SG_MUTANT_FG_NO_TOKEN
+        if (fg_tokens[i].serial == fg_input_serial) process->fg_grant = fg_input_serial;
+#endif
+        fg_tokens[i].token = 0;
+        return;
+    }
+}
+
+/* Stained Glass OS 9930: a program started by one that may set the foreground window gets a grant of
+ * its own (Windows' "started by the foreground process" holds once its starter has exited) */
+void foreground_inherit( struct process *child )
+{
+    struct desktop *desktop;
+
+    if (!current || !(desktop = get_thread_desktop( current, 0 ))) return;
+#ifndef SG_MUTANT_FG_NO_INHERIT
+    if (foreground_allowed( desktop, current->process, ~0u ) != FG_REFUSED) child->fg_grant = fg_input_serial;
+#endif
+    release_object( desktop );
+}
+
+/* Stained Glass OS 9930: LockSetForegroundWindow, AllowSetForegroundWindow, may the caller set it */
+DECL_HANDLER(foreground_lock)
+{
+    struct desktop *desktop;
+    struct process *process;
+    int can;
+
+    reply->token = 0;
+    if (req->op == FOREGROUND_LOCK_CLAIM)   /* at the claimer's start: no desktop yet */
+    {
+        foreground_token_claim( current->process, req->pid );
+        return;
+    }
+    if (!(desktop = get_thread_desktop( current, 0 )))
+    {
+        clear_error();   /* a program with no desktop grants nothing */
+        return;
+    }
+    can = foreground_allowed( desktop, current->process, req->lock_timeout ) != FG_REFUSED;
+
+    switch (req->op)
+    {
+    case FOREGROUND_LOCK_LOCK:
+        if (can) desktop->fg_lock_pid = current->process->id;
+        else set_error( STATUS_ACCESS_DENIED );
+        break;
+    case FOREGROUND_LOCK_UNLOCK:
+        if (can || desktop->fg_lock_pid == current->process->id) desktop->fg_lock_pid = 0;
+        else set_error( STATUS_ACCESS_DENIED );
+        break;
+    case FOREGROUND_LOCK_ALLOW:
+        if (!can) set_error( STATUS_ACCESS_DENIED );
+        else if (req->pid == (process_id_t)-1) desktop->fg_any = fg_input_serial;
+        else if ((process = get_process_from_id( req->pid )))
+        {
+            process->fg_grant = fg_input_serial;
+            release_object( process );
+        }
+        else set_error( STATUS_INVALID_PARAMETER );
+        break;
+    case FOREGROUND_LOCK_CAN:
+        if (!can) set_error( STATUS_ACCESS_DENIED );
+        break;
+    case FOREGROUND_LOCK_TOKEN:
+        /* only for the right of its own (or the person's input), not for the lock's time-out */
+        if (foreground_allowed( desktop, current->process, ~0u ) != FG_REFUSED) reply->token = foreground_token_issue();
+        break;
+    default:
+        set_error( STATUS_INVALID_PARAMETER );
+        break;
+    }
+    release_object( desktop );
+}
