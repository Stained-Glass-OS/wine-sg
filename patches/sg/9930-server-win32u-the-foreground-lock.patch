 /*******************************************************************
  *		set_foreground_window
  */
 BOOL set_foreground_window( HWND hwnd, BOOL mouse )
 {
-    BOOL ret, send_msg_old = FALSE, send_msg_new = FALSE;
+    return set_foreground_window_flags( hwnd, mouse, mouse ? SET_FOREGROUND_INPUT : SET_FOREGROUND_CHECK, NULL );
+}
+
+/* flags: SET_FOREGROUND_CHECK for a program's request, which the foreground lock may refuse
+ * (*refused: the window is left inactive, its taskbar button flashes); SET_FOREGROUND_INPUT for
+ * the person's input */
+BOOL set_foreground_window_flags( HWND hwnd, BOOL mouse, UINT flags, BOOL *refused )
+{
+    BOOL ret, send_msg_old = FALSE, send_msg_new = FALSE, held = FALSE;
     DWORD new_thread_id;
     HWND previous = 0;
+    UINT timeout = (flags & SET_FOREGROUND_CHECK) ? foreground_lock_timeout() : 0;
 
+    if (refused) *refused = FALSE;
     if (mouse) hwnd = get_full_window_handle( hwnd );
     new_thread_id = get_window_thread( hwnd, NULL );
 
     SERVER_START_REQ( set_foreground_window )
     {
         req->handle = wine_server_user_handle( hwnd );
+        req->flags = flags;
+        req->lock_timeout = timeout;
         if ((ret = !wine_server_call_err( req )))
         {
             previous = wine_server_ptr_handle( reply->previous );
             send_msg_old = reply->send_msg_old;
             send_msg_new = reply->send_msg_new;
+            held = reply->refused;
         }
     }
     SERVER_END_REQ;
 
+    if (ret && held)
+    {
+        TRACE( "foreground lock: %p stays behind %p\n", hwnd, previous );
+        if (refused) *refused = TRUE;
+        /* not activated, even in its own thread: the person's click on it (or its taskbar button)
+         * activates it then as any window behind -- remembered as kept back (take_fg_held) */
+        {
+            HWND root = NtUserGetAncestor( hwnd, GA_ROOT );
+            if (root && new_thread_id == GetCurrentThreadId()) NtUserSetProp( root, fg_heldW, (HANDLE)1 );
+        }
+        flash_refused( hwnd );
+        return FALSE;
+    }
+
     if (ret && previous != hwnd)
     {
         if (send_msg_old)  /* old window belongs to other thread */
@@ -2426,8 +2529,13 @@ BOOL set_foreground_window( HWND hwnd, BOOL mouse )
         if (send_msg_new)  /* new window belongs to other thread */
             NtUserMessageCall( hwnd, WM_WINE_SETACTIVEWINDOW, (WPARAM)hwnd, 0,
                                0, NtUserSendNotifyMessage, FALSE );
+        else if (hwnd == get_active_window() && take_fg_held( hwnd ))
+            activate_in_front( hwnd, previous, mouse );
         else  /* new window belongs to us */
+        {
+            take_fg_held( hwnd );
             ret = set_active_window( hwnd, NULL, mouse, TRUE, 0 );
+        }
     }
     return ret;
 }
