+/* Stained Glass OS 9930: Wine wrote ForegroundLockTimeout 0, its default, into every account at its
+ * first session: there was no foreground lock. Now that there is one, an account made before it
+ * gets Windows' 200000 once (a 0 set afterwards, by the person, stays) */
+static void sg_upgrade_foreground_lock(void)
+{
+    static const WCHAR doneW[] = {'F','o','r','e','g','r','o','u','n','d','L','o','c','k',0};
+    static const WCHAR timeoutW[] = {'F','o','r','e','g','r','o','u','n','d','L','o','c','k','T','i','m','e','o','u','t',0};
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    DWORD one = 1, timeout = 200000;
+    HKEY key, desk;
+
+#ifdef SG_MUTANT_FG_NO_UPGRADE
+    return;
+#endif
+    if (!(key = reg_create_ascii_key( hkcu_key, "Software\\Stained Glass\\Upgrades", 0, NULL ))) return;
+    if (query_reg_value( key, doneW, value, sizeof(buffer) ))
+    {
+        NtClose( key );
+        return;
+    }
+    if ((desk = reg_open_hkcu_key( "Control Panel\\Desktop" )))
+    {
+        if (query_reg_value( desk, timeoutW, value, sizeof(buffer) ) && value->Type == REG_DWORD &&
+            value->DataLength == sizeof(DWORD) && !*(DWORD *)value->Data)
+            set_reg_value( desk, timeoutW, REG_DWORD, &timeout, sizeof(timeout) );
+        NtClose( desk );
+    }
+    set_reg_value( key, doneW, REG_DWORD, &one, sizeof(one) );
+    NtClose( key );
+}
+
