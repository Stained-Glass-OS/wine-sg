+/* whether a process is the given one or was started by it (or by one it started) */
+static int fg_descends_from( struct process *process, process_id_t ancestor )
+{
+    struct process *p = process, *next;
+    int depth, ret = 0;
+
+    if (!ancestor) return 0;
+    for (depth = 0; p && depth < 32; depth++)
+    {
+        if (p->id == ancestor) { ret = 1; break; }
+        if (!p->parent_id) break;
+        next = get_process_from_id( p->parent_id );
+#ifndef SG_MUTANT_FG_PARENT_ERROR
+        if (!next) clear_error();   /* a parent gone is no error of the request's */
+#endif
+        /* a parent's id reused by a later process is not the parent */
+        if (next && next->start_time > p->start_time) { release_object( next ); next = NULL; }
+        if (p != process) release_object( p );
+        p = next;
+    }
+    if (p && p != process) release_object( p );
+    return ret;
