+/* Stained Glass OS 9930: the person's ForegroundLockTimeout, in ms */
+static UINT foreground_lock_timeout(void)
+{
+    UINT timeout = 200000;
+    NtUserSystemParametersInfo( SPI_GETFOREGROUNDLOCKTIMEOUT, 0, &timeout, 0 );
+    return timeout;
+}
+
+C_ASSERT( NTUSER_FGLOCK_LOCK == FOREGROUND_LOCK_LOCK && NTUSER_FGLOCK_UNLOCK == FOREGROUND_LOCK_UNLOCK &&
+          NTUSER_FGLOCK_ALLOW == FOREGROUND_LOCK_ALLOW && NTUSER_FGLOCK_CAN == FOREGROUND_LOCK_CAN );
+
+/* Stained Glass OS 9930: LockSetForegroundWindow, AllowSetForegroundWindow and may-I (FOREGROUND_LOCK_*) */
+BOOL foreground_lock( UINT op, DWORD pid )
+{
+    UINT timeout = foreground_lock_timeout();
+    BOOL ret;
+
+    SERVER_START_REQ( foreground_lock )
+    {
+        req->op = op;
+        req->pid = pid;
+        req->lock_timeout = timeout;
+        ret = !wine_server_call_err( req );
+    }
+    SERVER_END_REQ;
+    /* may I: only the lock's own answer is a no (a thread not yet on a desktop is not held) */
+    if (!ret && op == FOREGROUND_LOCK_CAN && RtlGetLastWin32Error() != ERROR_ACCESS_DENIED) ret = TRUE;
+    return ret;
+}
+
+/* Stained Glass OS 9930: as Windows, a window the foreground lock kept back has its taskbar button
+ * flash (ForegroundFlashCount times; it stays lit until the window is activated) */
+static void flash_refused( HWND hwnd )
+{
+    FLASHWINFO info = { sizeof(info) };
+    UINT count = 3;
+    HWND root = NtUserGetAncestor( hwnd, GA_ROOTOWNER );
+
+#ifdef SG_MUTANT_FG_NO_FLASH
+    return;
+#endif
+    NtUserSystemParametersInfo( SPI_GETFOREGROUNDFLASHCOUNT, 0, &count, 0 );
+    info.hwnd = root ? root : hwnd;
+    info.dwFlags = FLASHW_TRAY | FLASHW_TIMERNOFG;
+    info.uCount = count ? count : 1;
+    NtUserFlashWindowEx( &info );
+}
+
+static const WCHAR fg_heldW[] = {'_','_','w','i','n','e','_','s','g','_','f','g','_','h','e','l','d',0};
+
+/* whether the foreground lock kept this window back (and forget it) */
+BOOL take_fg_held( HWND hwnd )
+{
+    return hwnd && NtUserRemoveProp( hwnd, fg_heldW ) != 0;
+}
+
+/* Stained Glass OS 9930: a window that is its thread's active one already, in the background (its
+ * program set the focus to it before showing it, and the foreground lock kept it behind), just got
+ * the foreground: activated -- and given the keyboard -- now, as any window (set_active_window does
+ * nothing for the window that is active already) */
+void activate_in_front( HWND hwnd, HWND previous, BOOL mouse )
+{
+    GUITHREADINFO info = { sizeof(info) };
+
+    NtUserNotifyWinEvent( EVENT_SYSTEM_FOREGROUND, hwnd, 0, 0 );
+    send_message( hwnd, WM_NCACTIVATE, TRUE, (LPARAM)previous );
+    send_message( hwnd, WM_ACTIVATE, MAKEWPARAM( mouse ? WA_CLICKACTIVE : WA_ACTIVE, is_iconic( hwnd ) ),
+                  (LPARAM)previous );
+    NtUserGetGUIThreadInfo( GetCurrentThreadId(), &info );
+    if (info.hwndActive != hwnd) return;
+    if (!info.hwndFocus || NtUserGetAncestor( info.hwndFocus, GA_ROOT ) != hwnd) set_focus_window( hwnd );
+#ifndef SG_MUTANT_FG_NO_LATE_FOCUS
+    else user_driver->pSetFocus( info.hwndFocus );
+#endif
+}
