From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dpvoice: Answer QueryInterface in the class factories and take three arguments in DirectPlayVoiceCreate.

The class factories' QueryInterface answers IUnknown and IClassFactory and
clears the pointer for anything else, as QueryInterface must. LockServer
already succeeded; the DLL is never unloaded, so there is nothing to count,
and its FIXME is a TRACE now. DirectPlayVoiceCreate takes three arguments,
as the import libraries have it (DirectPlayVoiceCreate@12); with two, a
32-bit caller's stack was left unbalanced. What it creates is still unknown.

Gate: test/dpvoice-factory-gate.sh (64/32).

The two todo_wine marks on dpnet calls in the dpvoice test (Host, Close)
are removed: they succeed since dpnet's server was implemented (2980).
---
 dlls/dpvoice/dpvoice.spec  |  2 +-
 dlls/dpvoice/main.c        | 22 ++++++++++++++++++----
 dlls/dpvoice/tests/voice.c |  4 ++--
 3 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/dlls/dpvoice/dpvoice.spec b/dlls/dpvoice/dpvoice.spec
index 5169b47..993b547 100644
--- a/dlls/dpvoice/dpvoice.spec
+++ b/dlls/dpvoice/dpvoice.spec
@@ -1,4 +1,4 @@
-1 stdcall DirectPlayVoiceCreate(ptr ptr)
+1 stdcall DirectPlayVoiceCreate(ptr ptr ptr)
 
 @ stdcall -private DllCanUnloadNow()
 @ stdcall -private DllGetClassObject(ptr ptr ptr)
diff --git a/dlls/dpvoice/main.c b/dlls/dpvoice/main.c
index 6a7d6b9..5aa63d4 100644
--- a/dlls/dpvoice/main.c
+++ b/dlls/dpvoice/main.c
@@ -49,7 +49,18 @@ static HRESULT WINAPI DICF_QueryInterface(LPCLASSFACTORY iface,REFIID riid,void
 {
     IClassFactoryImpl *This = impl_from_IClassFactory(iface);
 
-    FIXME("(%p)->(%s,%p),stub!\n",This,debugstr_guid(riid),ppobj);
+    TRACE("(%p)->(%s,%p)\n",This,debugstr_guid(riid),ppobj);
+
+#ifndef SG_MUTANT_DPV_QI
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IClassFactory))
+    {
+        InterlockedIncrement(&This->ref);
+        *ppobj = iface;
+        return S_OK;
+    }
+#endif
+    WARN("no interface %s\n", debugstr_guid(riid));
+    *ppobj = NULL;
     return E_NOINTERFACE;
 }
 
@@ -77,7 +88,8 @@ static HRESULT WINAPI DICF_CreateInstance(IClassFactory *iface, IUnknown *pOuter
 static HRESULT WINAPI DICF_LockServer(IClassFactory *iface,BOOL dolock)
 {
     IClassFactoryImpl *This = impl_from_IClassFactory(iface);
-    FIXME("(%p)->(%d),stub!\n",This,dolock);
+    /* the DLL is never unloaded (DllCanUnloadNow is winecrt0's), so there is nothing to count */
+    TRACE("(%p)->(%d)\n",This,dolock);
     return S_OK;
 }
 
@@ -97,9 +109,11 @@ static IClassFactoryImpl DPVOICE_CFS[] =
     { { NULL }, 0, NULL, NULL }
 };
 
-HRESULT WINAPI DirectPlayVoiceCreate(LPCGUID pIID, void **ppvInterface)
+/* three arguments, as the import libraries have it (DirectPlayVoiceCreate@12);
+ * what they mean is not documented */
+HRESULT WINAPI DirectPlayVoiceCreate(LPCGUID pIID, void **ppvInterface, void *unknown)
 {
-    FIXME("(%s, %p) stub\n", debugstr_guid(pIID), ppvInterface);
+    FIXME("(%s, %p, %p) stub\n", debugstr_guid(pIID), ppvInterface, unknown);
     return E_NOTIMPL;
 }
 
diff --git a/dlls/dpvoice/tests/voice.c b/dlls/dpvoice/tests/voice.c
index 0afec71..18b2229 100644
--- a/dlls/dpvoice/tests/voice.c
+++ b/dlls/dpvoice/tests/voice.c
@@ -115,7 +115,7 @@ static BOOL test_init_dpvoice_server(void)
         dpnAppDesc.pwszSessionName  = sessionname;
 
         hr = IDirectPlay8Server_Host(dpserver, &dpnAppDesc, &localaddr, 1, NULL, NULL, NULL, 0  );
-        todo_wine ok(hr == S_OK, "Host failed with 0x%08lx\n", hr);
+        ok(hr == S_OK, "Host failed with 0x%08lx\n", hr);
 
         hr = IDirectPlayVoiceServer_Initialize(vserver, NULL, &DirectPlayVoiceServerMessageHandler, NULL, 0, 0);
         todo_wine ok(hr == DVERR_NOTRANSPORT, "Initialize failed with 0x%08lx\n", hr);
@@ -316,7 +316,7 @@ static void test_cleanup_dpvoice(void)
     if(dpserver)
     {
         hr = IDirectPlay8Server_Close(dpserver, 0);
-        todo_wine ok(hr == S_OK, "got 0x%08lx\n", hr);
+        ok(hr == S_OK, "got 0x%08lx\n", hr);
 
         IDirectPlay8Server_Release(dpserver);
     }
