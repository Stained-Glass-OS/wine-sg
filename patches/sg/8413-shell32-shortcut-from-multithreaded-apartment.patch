From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: open a shortcut from a thread in the multithreaded apartment

ShellExecute runs a shortcut through its context-menu handler, which shellex_load_object_and_run
loads after CoInitialize. On a thread already in the multithreaded apartment CoInitialize fails with
RPC_E_CHANGED_MODE; the handler was skipped, the .lnk executed as a program (error 193) and
ShellExecute returned SE_ERR_NOASSOC: nothing started. SG Store initialises WinRT multithreaded, so
its Open did nothing for an app whose Start entry is a shortcut in a folder (OpenRA).

COM is usable there and the shortcut's handler is threading both: RPC_E_CHANGED_MODE now goes on,
and CoUninitialize is called only when CoInitialize succeeded.
---
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -2039,11 +2039,21 @@
     IDataObject *dataobj = NULL;
     IObjectWithSite *ows = NULL;
     IShellExtInit *obj = NULL;
+    BOOL com_init;
     HRESULT r;
 
     TRACE("%p %s %p\n", hkey, debugstr_guid( guid ), sei );
 
     r = CoInitialize( NULL );
+    com_init = SUCCEEDED( r );
+#ifndef SG_MUTANT_SHELLEX_NO_MTA
+    /* Stained Glass OS (8413): a thread already in the multithreaded apartment (SG Store: WinRT,
+     * RO_INIT_MULTITHREADED) has COM; the handlers (the shortcut's own, threading both) run there.
+     * Refused before, a shortcut opened from such a thread was taken for a program: error 193,
+     * SE_ERR_NOASSOC, nothing started. */
+    if ( r == RPC_E_CHANGED_MODE )
+        r = S_OK;
+#endif
     if ( FAILED( r ) )
         goto end;
 
@@ -2081,7 +2091,8 @@
         IDataObject_Release( dataobj );
     if ( obj )
         IShellExtInit_Release( obj );
-    CoUninitialize();
+    if ( com_init )
+        CoUninitialize();
     return r;
 }
 
