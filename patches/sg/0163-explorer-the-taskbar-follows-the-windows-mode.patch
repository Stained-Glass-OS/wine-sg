From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: the taskbar follows the Windows mode; the shell applies the app mode

- The taskbar's palette follows HKCU\...\Themes\Personalize
  SystemUsesLightTheme ("Choose your default Windows mode"): the dark bar
  unless it is 1, a light one (#eeeeee, dark text) when it is.
- On WM_SETTINGCHANGE "ImmersiveColorSet" and when it starts, the shell calls
  uxtheme's RefreshImmersiveColorPolicyState (0161), so the app mode reaches
  every program, and repaints the desktop afterwards (the switch's repaint
  could leave its icons painted over -- the desktop surface flush, 0069).

Gate: test/darkmode-gate.sh.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -145,11 +145,26 @@
 #define SG_TASKBAR_HEIGHT 40           /* Windows 10 taskbar height */
 #define SG_CLOCK_WIDTH    88           /* reserved at the right for the clock */
 #define SG_CLOCK_TIMER    0xC10C       /* our own timer id for the clock tick */
+#define SG_MODE_TIMER     0xC10D       /* repaint the desktop after a mode change */
 
-#define SG_COL_BAR      RGB(0x1F,0x1F,0x1F)  /* the flat dark bar */
-#define SG_COL_HOVER    RGB(0x2E,0x2E,0x2E)  /* button under the pointer */
-#define SG_COL_ACTIVE   RGB(0x3A,0x3A,0x3A)  /* the foreground window's button */
-#define SG_COL_TEXT     RGB(0xF0,0xF0,0xF0)  /* button and clock text */
+/* Windows mode (HKCU\...\Themes\Personalize SystemUsesLightTheme): the
+ * bar is dark unless it is 1, as on Windows 10 */
+struct sg_palette
+{
+    COLORREF bar;       /* the flat bar */
+    COLORREF hover;     /* button under the pointer */
+    COLORREF active;    /* the foreground window's button */
+    COLORREF text;      /* button and clock text, glyphs */
+};
+static const struct sg_palette sg_dark_palette =
+    { RGB(0x1F,0x1F,0x1F), RGB(0x2E,0x2E,0x2E), RGB(0x3A,0x3A,0x3A), RGB(0xF0,0xF0,0xF0) };
+static const struct sg_palette sg_light_palette =
+    { RGB(0xEE,0xEE,0xEE), RGB(0xF8,0xF8,0xF8), RGB(0xD9,0xD9,0xD9), RGB(0x1A,0x1A,0x1A) };
+static const struct sg_palette *sg_pal = &sg_dark_palette;
+#define SG_COL_BAR      (sg_pal->bar)
+#define SG_COL_HOVER    (sg_pal->hover)
+#define SG_COL_ACTIVE   (sg_pal->active)
+#define SG_COL_TEXT     (sg_pal->text)
 #define SG_COL_ACCENT   RGB(0x8A,0x2B,0xE2)  /* purple underline on the active button */
 
 /* the four stained-glass tiles of the Start mark: deliberately not Windows'
@@ -1238,6 +1253,37 @@
     if (id) SendNotifyMessageW( (HWND)id, WM_POPUPSYSTEMMENU, 0, lparam );
 }
 
+static BOOL CALLBACK sg_repaint_window( HWND hwnd, LPARAM lparam )
+{
+    if (IsWindowVisible( hwnd ))
+        RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    return TRUE;
+}
+
+/* Stained Glass OS: the Windows mode decides the bar's palette */
+static void sg_load_mode(void)
+{
+    DWORD light = 0, size = sizeof(light);
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                  L"SystemUsesLightTheme", RRF_RT_REG_DWORD, NULL, &light, &size );
+    sg_pal = light ? &sg_light_palette : &sg_dark_palette;
+}
+
+/* Stained Glass OS: the app mode decides the visual style's colour scheme
+ * (uxtheme's RefreshImmersiveColorPolicyState, ordinal 104, switches it for
+ * every program); the shell applies it when it starts and on
+ * WM_SETTINGCHANGE "ImmersiveColorSet", as Windows' shell does */
+static void sg_apply_app_mode(void)
+{
+    static void (WINAPI *refresh)(void);
+    HMODULE uxtheme;
+
+    if (!refresh && (uxtheme = LoadLibraryW( L"uxtheme.dll" )))
+        refresh = (void *)GetProcAddress( uxtheme, MAKEINTRESOURCEA(104) );
+    if (refresh) refresh();
+}
+
 static void do_hide_systray(void)
 {
     ShowWindow( tray_window, SW_HIDE );
@@ -1323,6 +1369,15 @@
         break;
 
     case WM_TIMER:
+        if (wparam == SG_MODE_TIMER)
+        {
+            /* the desktop first, then every window over it: the desktop's
+             * surface is flushed over its children (see 0069) */
+            KillTimer( hwnd, SG_MODE_TIMER );
+            RedrawWindow( GetDesktopWindow(), NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_UPDATENOW );
+            EnumWindows( sg_repaint_window, 0 );
+            return 0;
+        }
         if (wparam == SG_CLOCK_TIMER)
         {
             RECT rc;
@@ -1336,6 +1391,19 @@
     case WM_COPYDATA:
         return handle_incoming((HWND)wparam, (COPYDATASTRUCT *)lparam);
 
+    case WM_SETTINGCHANGE:
+        /* Stained Glass OS: Settings > Personalization > Colors */
+        if (enable_taskbar && lparam && !wcscmp( (const WCHAR *)lparam, L"ImmersiveColorSet" ))
+        {
+            sg_load_mode();
+            RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
+            sg_apply_app_mode();
+            /* the switch's repaint can leave the desktop's icons painted over
+             * (the desktop surface flush, see 0069): draw the desktop again */
+            SetTimer( hwnd, SG_MODE_TIMER, 400, NULL );
+        }
+        break;
+
     case WM_DISPLAYCHANGE:
         if (!show_systray) do_hide_systray();
         else if (!nb_displayed && !enable_taskbar) do_hide_systray();
@@ -1526,6 +1594,11 @@
         initialize_shell_keys( tray_window );
     }
 
+    if (enable_taskbar)
+    {
+        sg_load_mode();
+        sg_apply_app_mode();
+    }
     if (enable_taskbar) do_show_systray();
     else do_hide_systray();
 }
