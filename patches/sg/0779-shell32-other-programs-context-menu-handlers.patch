+/* ---- Stained Glass OS: other programs' context menu handlers -------------
+ * As Windows: the handlers registered for the items' type, for every file
+ * (*), for every file system object, and for folders (Directory, Folder),
+ * each once and not if blocked; each is given the folder and the items
+ * (IShellExtInit) and adds its items to the menu (IContextMenu), which
+ * routes their commands, verbs and help back to it (David 2026-10-03:
+ * TortoiseGit added nothing to the right-click menu). */
+
+static BOOL ext_blocked(const WCHAR *clsid)
+{
+    HKEY key;
+    BOOL blocked = FALSE;
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Shell Extensions\\Blocked",
+                       0, KEY_READ, &key))
+    {
+        blocked = !RegQueryValueExW(key, clsid, NULL, NULL, NULL, NULL);
+        RegCloseKey(key);
+    }
+    return blocked;
+}
+
+static void ext_add_from(ContextMenu *This, const WCHAR *type, HMENU hmenu, UINT *pos, UINT idCmdFirst,
+                         UINT idCmdLast, UINT flags, IDataObject *data, UINT *next)
+{
+    WCHAR path[MAX_PATH + 64], name[256], clsid_str[64];
+    HKEY key, progid = NULL;
+    DWORD i, len, size;
+
+    swprintf(path, ARRAY_SIZE(path), L"%s\\shellex\\ContextMenuHandlers", type);
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, path, 0, KEY_READ, &key)) return;
+    RegOpenKeyExW(HKEY_CLASSES_ROOT, type, 0, KEY_READ, &progid);
+    for (i = 0; This->ext_count < MAX_EXT; i++)
+    {
+        IShellExtInit *init;
+        IContextMenu *cm;
+        CLSID clsid;
+        HRESULT hr;
+        UINT before, j;
+
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW(key, i, name, &len, NULL, NULL, NULL, NULL)) break;
+        /* the handler's CLSID: its default value, or its key's name */
+        size = sizeof(clsid_str);
+        if (RegGetValueW(key, name, NULL, RRF_RT_REG_SZ, NULL, clsid_str, &size) || clsid_str[0] != '{')
+            lstrcpynW(clsid_str, name, ARRAY_SIZE(clsid_str));
+        if (FAILED(CLSIDFromString(clsid_str, &clsid)) || ext_blocked(clsid_str)) continue;
+        for (j = 0; j < This->ext_count; j++)
+        {
+            IPersist *persist;
+            CLSID have;
+            if (SUCCEEDED(IContextMenu_QueryInterface(This->ext[j].cm, &IID_IPersist, (void **)&persist)))
+            {
+                hr = IPersist_GetClassID(persist, &have);
+                IPersist_Release(persist);
+                if (SUCCEEDED(hr) && IsEqualCLSID(&have, &clsid)) break;
+            }
+        }
+        if (j < This->ext_count) continue;
+        if (FAILED(CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IShellExtInit, (void **)&init)))
+        {
+            TRACE("handler %s did not load\n", debugstr_w(clsid_str));
+            continue;
+        }
+        hr = IShellExtInit_Initialize(init, This->pidl, data, progid);
+        if (SUCCEEDED(hr)) hr = IShellExtInit_QueryInterface(init, &IID_IContextMenu, (void **)&cm);
+        IShellExtInit_Release(init);
+        if (FAILED(hr)) continue;
+        before = GetMenuItemCount(hmenu);
+        hr = IContextMenu_QueryContextMenu(cm, hmenu, *pos, idCmdFirst + *next, idCmdLast, flags);
+        if (FAILED(hr))
+        {
+            IContextMenu_Release(cm);
+            continue;
+        }
+        This->ext[This->ext_count].cm = cm;
+        This->ext[This->ext_count].first = *next;
+        This->ext[This->ext_count].count = HRESULT_CODE(hr);
+        This->ext_count++;
+        *next += HRESULT_CODE(hr);
+        *pos += GetMenuItemCount(hmenu) - before;
+        TRACE("handler %s added %u commands\n", debugstr_w(clsid_str), (UINT)HRESULT_CODE(hr));
+    }
+    if (progid) RegCloseKey(progid);
+    RegCloseKey(key);
+}
+
+static void ext_add_handlers(ContextMenu *This, HMENU hmenu, UINT *pos, UINT idCmdFirst, UINT idCmdLast,
+                             UINT flags, INT *uIDMax)
+{
+    IDataObject *data = NULL;
+    UINT next = EXT_ID_OFFSET, folders = 0, i;
+    WCHAR path[MAX_PATH];
+
+#ifdef SG_MUTANT_NO_MENU_HANDLERS
+    return;
+#endif
+    for (i = 0; i < This->ext_count; i++) IContextMenu_Release(This->ext[i].cm);
+    This->ext_count = 0;
+    if (!This->cidl || idCmdFirst + EXT_ID_OFFSET > idCmdLast) return;
+    if (FAILED(IShellFolder_GetUIObjectOf(This->parent, NULL, This->cidl, (LPCITEMIDLIST *)This->apidl,
+                                          &IID_IDataObject, NULL, (void **)&data)))
+        return;
+    for (i = 0; i < This->cidl; i++)
+    {
+        ITEMIDLIST *full = ILCombine(This->pidl, This->apidl[i]);
+        if (full && SHGetPathFromIDListW(full, path) && PathIsDirectoryW(path)) folders++;
+        ILFree(full);
+    }
+    idCmdLast = min(idCmdLast, idCmdFirst + EXT_ID_LAST);
+    if (folders == This->cidl)
+    {
+        ext_add_from(This, L"Directory", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
+        ext_add_from(This, L"Folder", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
+    }
+    else
+    {
+        if (This->filetype[0]) ext_add_from(This, This->filetype, hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
+        ext_add_from(This, L"*", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
+    }
+    ext_add_from(This, L"AllFilesystemObjects", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
+    IDataObject_Release(data);
+    if (next > EXT_ID_OFFSET) *uIDMax = max(*uIDMax, (INT)(idCmdFirst + next));
+}
+
+/* the handler a command offset belongs to, and its own offset */
+static struct ext_handler *ext_for(ContextMenu *This, UINT_PTR id, UINT *own)
+{
+    UINT i;
+    for (i = 0; i < This->ext_count; i++)
+        if (id >= This->ext[i].first && id < This->ext[i].first + This->ext[i].count)
+        {
+            *own = id - This->ext[i].first;
+            return &This->ext[i];
+        }
+    return NULL;
+}
+
