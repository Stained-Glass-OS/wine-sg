From: Stained Glass OS <ke7oxh@gmail.com>
Subject: mountmgr: a shell folder is never linked to itself

Stained Glass OS makes a user's Linux home a link to their Windows profile
(/home/<user> -> C:\users\<user>), so $HOME/Documents is the profile's own
Documents. Asked to link a shell folder to its $HOME counterpart -- winecfg's
shell folders, shell32 for a folder that is missing -- the mount manager
moved the folder aside as "<name>.backup" and made it a link to itself: the
user's files seemed to vanish. A folder is now never linked to itself, to a
folder inside it, or to a folder that contains it.

Gate: make test-selflink.
--- a/dlls/mountmgr.sys/unixlib.c
+++ b/dlls/mountmgr.sys/unixlib.c
@@ -513,6 +513,28 @@
         goto done;
     }
 
+    /* Stained Glass OS: a user's home can be their Windows profile itself
+     * (/home/<user> -> C:\users\<user>): then $HOME/Documents *is* the
+     * profile's Documents, and linking one to the other moved the folder,
+     * files and all, aside as "Documents.backup" and left a link to itself.
+     * A folder is never linked to itself, to a folder inside it, or to one
+     * that contains it. */
+    if (link)
+    {
+        char *real_link = realpath( link, NULL ), *real_folder = realpath( folder, NULL );
+        BOOL same = FALSE;
+        if (real_link && real_folder)
+        {
+            size_t ll = strlen( real_link ), fl = strlen( real_folder );
+            same = !strcmp( real_link, real_folder ) ||
+                   (ll > fl && !strncmp( real_link, real_folder, fl ) && real_link[fl] == '/') ||
+                   (fl > ll && !strncmp( real_folder, real_link, ll ) && real_folder[ll] == '/');
+        }
+        free( real_link );
+        free( real_folder );
+        if (same) goto done;
+    }
+
     if (!lstat( folder, &st )) /* move old folder/link out of the way */
     {
         if (S_ISLNK( st.st_mode ))
