From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: Match type library names case-insensitively in IsName and FindName.

ITypeLib::IsName and FindName match names whatever their case and write
the library's spelling into the caller's buffer, as on Windows (the
oleaut32 typelib test's FindName("guid") finds GUID; its todo_wine is
removed). They compared case-sensitively.

Gate: test/oleaut32-typelibname-gate.sh (64/32).
---
 dlls/oleaut32/tests/typelib.c |  2 --
 dlls/oleaut32/typelib.c       | 32 +++++++++++++++++++++++---------
 2 files changed, 23 insertions(+), 11 deletions(-)

diff --git a/dlls/oleaut32/tests/typelib.c b/dlls/oleaut32/tests/typelib.c
index 153964e..f751025 100644
--- a/dlls/oleaut32/tests/typelib.c
+++ b/dlls/oleaut32/tests/typelib.c
@@ -7743,11 +7743,9 @@ static void test_FindName(void)
     ti = (void*)0xdeadbeef;
     hr = ITypeLib_FindName(tl, buffW, 0, &ti, &memid, &c);
     ok(hr == S_OK, "got 0x%08lx\n", hr);
-todo_wine {
     ok(memid == MEMBERID_NIL, "got %ld\n", memid);
     ok(!lstrcmpW(buffW, wszGUID), "got %s\n", wine_dbgstr_w(buffW));
     ok(c == 1, "got %d\n", c);
-}
     if (c == 1)
         ITypeInfo_Release(ti);
 
diff --git a/dlls/oleaut32/typelib.c b/dlls/oleaut32/typelib.c
index d4cd531..8d38fa5 100644
--- a/dlls/oleaut32/typelib.c
+++ b/dlls/oleaut32/typelib.c
@@ -1380,6 +1380,21 @@ static inline int TLB_str_memcmp(void *left, const TLBString *str, DWORD len)
     return memcmp(left, str->str, len);
 }
 
+/* IsName and FindName match a name whatever its case and give back the
+ * library's spelling in the caller's buffer (oleaut32 typelib tests on
+ * Windows: "guid" finds GUID) */
+static BOOL TLB_name_matches(LPOLESTR name, const TLBString *str)
+{
+    if (!str || !name) return FALSE;
+#ifndef SG_MUTANT_TLB_NAME_CASE
+    if (lstrcmpiW(name, str->str)) return FALSE;
+    memcpy(name, str->str, lstrlenW(name) * sizeof(WCHAR));
+    return TRUE;
+#else
+    return !lstrcmpW(name, str->str);
+#endif
+}
+
 static inline const GUID *TLB_get_guidref(const TLBGuid *guid)
 {
     return guid != NULL ? &guid->guid : NULL;
@@ -5118,26 +5133,26 @@ static HRESULT WINAPI ITypeLib2_fnIsName(
 {
     ITypeLibImpl *This = impl_from_ITypeLib2(iface);
     int tic;
-    UINT nNameBufLen = (lstrlenW(szNameBuf)+1)*sizeof(WCHAR), fdc, vrc;
+    UINT fdc, vrc;
 
     TRACE("%p, %s, %#lx, %p.\n", iface, debugstr_w(szNameBuf), lHashVal, pfName);
 
     *pfName=TRUE;
     for(tic = 0; tic < This->TypeInfoCount; ++tic){
         ITypeInfoImpl *pTInfo = This->typeinfos[tic];
-        if(!TLB_str_memcmp(szNameBuf, pTInfo->Name, nNameBufLen)) goto ITypeLib2_fnIsName_exit;
+        if(TLB_name_matches(szNameBuf, pTInfo->Name)) goto ITypeLib2_fnIsName_exit;
         for(fdc = 0; fdc < pTInfo->typeattr.cFuncs; ++fdc) {
             TLBFuncDesc *pFInfo = &pTInfo->funcdescs[fdc];
             int pc;
-            if(!TLB_str_memcmp(szNameBuf, pFInfo->Name, nNameBufLen)) goto ITypeLib2_fnIsName_exit;
+            if(TLB_name_matches(szNameBuf, pFInfo->Name)) goto ITypeLib2_fnIsName_exit;
             for(pc=0; pc < pFInfo->funcdesc.cParams; pc++){
-                if(!TLB_str_memcmp(szNameBuf, pFInfo->pParamDesc[pc].Name, nNameBufLen))
+                if(TLB_name_matches(szNameBuf, pFInfo->pParamDesc[pc].Name))
                     goto ITypeLib2_fnIsName_exit;
             }
         }
         for(vrc = 0; vrc < pTInfo->typeattr.cVars; ++vrc){
             TLBVarDesc *pVInfo = &pTInfo->vardescs[vrc];
-            if(!TLB_str_memcmp(szNameBuf, pVInfo->Name, nNameBufLen)) goto ITypeLib2_fnIsName_exit;
+            if(TLB_name_matches(szNameBuf, pVInfo->Name)) goto ITypeLib2_fnIsName_exit;
         }
 
     }
@@ -5167,20 +5182,18 @@ static HRESULT WINAPI ITypeLib2_fnFindName(
     ITypeLibImpl *This = impl_from_ITypeLib2(iface);
     int tic;
     UINT count = 0;
-    UINT len;
 
     TRACE("%p, %s %#lx, %p, %p, %p.\n", iface, debugstr_w(name), hash, ppTInfo, memid, found);
 
     if ((!name && hash == 0) || !ppTInfo || !memid || !found)
         return E_INVALIDARG;
 
-    len = (lstrlenW(name) + 1)*sizeof(WCHAR);
     for(tic = 0; count < *found && tic < This->TypeInfoCount; ++tic) {
         ITypeInfoImpl *pTInfo = This->typeinfos[tic];
         TLBVarDesc *var;
         UINT fdc;
 
-        if(!TLB_str_memcmp(name, pTInfo->Name, len)) {
+        if(TLB_name_matches(name, pTInfo->Name)) {
             memid[count] = MEMBERID_NIL;
             goto ITypeLib2_fnFindName_exit;
         }
@@ -5188,7 +5201,7 @@ static HRESULT WINAPI ITypeLib2_fnFindName(
         for(fdc = 0; fdc < pTInfo->typeattr.cFuncs; ++fdc) {
             TLBFuncDesc *func = &pTInfo->funcdescs[fdc];
 
-            if(!TLB_str_memcmp(name, func->Name, len)) {
+            if(TLB_name_matches(name, func->Name)) {
                 memid[count] = func->funcdesc.memid;
                 goto ITypeLib2_fnFindName_exit;
             }
@@ -5196,6 +5209,7 @@ static HRESULT WINAPI ITypeLib2_fnFindName(
 
         var = TLB_get_vardesc_by_name(pTInfo, name);
         if (var) {
+            TLB_name_matches(name, var->Name);
             memid[count] = var->vardesc.memid;
             goto ITypeLib2_fnFindName_exit;
         }
