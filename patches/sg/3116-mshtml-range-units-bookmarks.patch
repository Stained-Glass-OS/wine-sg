+/* The "textedit" unit is the whole text of the body: a positive count moves a
+ * boundary to its end, a negative one to its start. The count returned is 1
+ * (or -1) when the boundary moved, 0 when it was there already. */
+static HRESULT move_textedit(HTMLTxtRange *This, int which, LONG count, LONG *actual)
+{
+    rangepoint_t old, target;
+    BOOL changed;
+
+    if(!get_body_point(This, count > 0, &target)) {
+        *actual = 0;
+        return S_OK;
+    }
+
+    if(which == 2)
+        get_end_point(This, &old);
+    else
+        get_start_point(This, &old);
+    changed = !rangepoint_cmp(&old, &target);
+    free_rangepoint(&old);
+
+    if(which == 2)
+        set_end_point(This, &target);
+    else
+        set_start_point(This, &target);
+    if(which == 0)
+        nsIDOMRange_Collapse(This->nsrange, TRUE);
+    free_rangepoint(&target);
+
+    *actual = changed ? (count > 0 ? 1 : -1) : 0;
+    return S_OK;
+}
