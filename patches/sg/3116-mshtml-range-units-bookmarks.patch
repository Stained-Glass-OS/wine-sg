     return ret;
 }
 
+static BOOL is_sentence_end_char(WCHAR c)
+{
+    return c == '.' || c == '!' || c == '?';
+}
+
+/* A sentence ends with ".", "!" or "?" and the white space that follows it, or
+ * with the end of a block. */
+static BOOL find_sentence_end(rangepoint_t *iter)
+{
+    BOOL consumed = FALSE, term = FALSE, space = FALSE;
+    rangepoint_t prev;
+    WCHAR c;
+
+    while(1) {
+        init_rangepoint(&prev, iter->node, iter->off);
+        c = move_next_char(iter);
+        if(!c) {
+            free_rangepoint(&prev);
+            return consumed;
+        }
+        if(term && space && !iswspace(c)) {
+            free_rangepoint(iter);
+            *iter = prev;
+            return TRUE;
+        }
+        free_rangepoint(&prev);
+        consumed = TRUE;
+        if(c == '\n')
+            return TRUE;
+        if(iswspace(c)) {
+            space = TRUE;
+        }else {
+            term = is_sentence_end_char(c);
+            space = FALSE;
+        }
+    }
+}
+
+static BOOL is_prev_sentence_boundary(const rangepoint_t *pos)
+{
+    rangepoint_t p;
+    BOOL ret = FALSE;
+    WCHAR c;
+
+    init_rangepoint(&p, pos->node, pos->off);
+    while((c = move_prev_char(&p)) && iswspace(c) && c != '\n');
+    ret = !c || c == '\n' || is_sentence_end_char(c);
+    free_rangepoint(&p);
+    return ret;
+}
+
+static BOOL at_sentence_end(const rangepoint_t *pos)
+{
+    rangepoint_t p;
+    WCHAR c;
+
+    init_rangepoint(&p, pos->node, pos->off);
+    c = move_prev_char(&p);
+    free_rangepoint(&p);
+    return c == '\n' || (c && iswspace(c) && is_prev_sentence_boundary(pos));
+}
+
+/* Moves to the start of the sentence that holds the point; when skip_space is
+ * set a point at the start of a sentence goes to the one before it. */
+static BOOL find_sentence_start(rangepoint_t *iter, BOOL skip_space)
+{
+    rangepoint_t prev;
+    BOOL moved = FALSE;
+    WCHAR c;
+
+    if(skip_space) {
+        while(1) {
+            init_rangepoint(&prev, iter->node, iter->off);
+            c = move_prev_char(&prev);
+            if(c && iswspace(c) && c != '\n') {
+                free_rangepoint(iter);
+                *iter = prev;
+                moved = TRUE;
+            }else {
+                free_rangepoint(&prev);
+                break;
+            }
+        }
+    }
+
+    while(1) {
+        init_rangepoint(&prev, iter->node, iter->off);
+        c = move_prev_char(&prev);
+        if(!c || c == '\n' || (iswspace(c) && is_prev_sentence_boundary(iter))) {
+            free_rangepoint(&prev);
+            break;
+        }
+        free_rangepoint(iter);
+        *iter = prev;
+        moved = TRUE;
+    }
+    return moved;
+}
+
+static LONG move_by_sentences(rangepoint_t *iter, LONG cnt)
+{
+    LONG ret = 0;
+#ifdef SG_MUTANT_RANGE_NOSENTENCE
+    return 0;
+#endif
+
+    if(cnt >= 0) {
+        while(ret < cnt && find_sentence_end(iter))
+            ret++;
+    }else {
+        while(ret > cnt && find_sentence_start(iter, TRUE))
+            ret--;
+    }
+    return ret;
+}
+
+static BOOL get_body_point(HTMLTxtRange *This, BOOL end, rangepoint_t *ret)
+{
+    nsIDOMHTMLElement *nsbody = NULL;
+    nsresult nsres;
+
+    if(!This->doc->html_document)
+        return FALSE;
+    nsres = nsIDOMHTMLDocument_GetBody(This->doc->html_document, &nsbody);
+    if(NS_FAILED(nsres) || !nsbody)
+        return FALSE;
+    init_rangepoint_no_addref(ret, (nsIDOMNode*)nsbody, end ? get_child_count((nsIDOMNode*)nsbody) : 0);
+    return TRUE;
+}
