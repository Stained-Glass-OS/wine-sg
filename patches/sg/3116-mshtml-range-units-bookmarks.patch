+/* A bookmark is an opaque string holding both boundaries as the child indices
+ * leading from the document down to the container node, and the offset in it. */
+static BOOL bookmark_append_point(wstrbuf_t *buf, const rangepoint_t *pt)
+{
+    UINT32 idx[256];
+    nsIDOMNode *node, *parent;
+    unsigned depth = 0, i;
+    WCHAR num[16];
+
+    nsIDOMNode_AddRef(pt->node);
+    node = pt->node;
+    while(1) {
+        nsIDOMNode_GetParentNode(node, &parent);
+        if(!parent)
+            break;
+        if(depth == ARRAY_SIZE(idx)) {
+            nsIDOMNode_Release(parent);
+            nsIDOMNode_Release(node);
+            return FALSE;
+        }
+        idx[depth++] = get_child_index(parent, node);
+        nsIDOMNode_Release(node);
+        node = parent;
+    }
+    nsIDOMNode_Release(node);
+
+    for(i = depth; i--;) {
+        swprintf(num, ARRAY_SIZE(num), L"%u.", idx[i]);
+        wstrbuf_append_len(buf, num, lstrlenW(num));
+    }
+    swprintf(num, ARRAY_SIZE(num), L":%u", pt->off);
+    wstrbuf_append_len(buf, num, lstrlenW(num));
+    return TRUE;
+}
+
 static HRESULT WINAPI HTMLTxtRange_getBookmark(IHTMLTxtRange *iface, BSTR *Bookmark)
 {
     HTMLTxtRange *This = impl_from_IHTMLTxtRange(iface);
-    FIXME("(%p)->(%p)\n", This, Bookmark);
-    return E_NOTIMPL;
+    rangepoint_t start, end;
+    wstrbuf_t buf;
+    BOOL ok;
+
+    TRACE("(%p)->(%p)\n", This, Bookmark);
+
+    if(!Bookmark)
+        return E_POINTER;
+    *Bookmark = NULL;
+
+    if(!wstrbuf_init(&buf))
+        return E_OUTOFMEMORY;
+
+    get_start_point(This, &start);
+    get_end_point(This, &end);
+    wstrbuf_append_len(&buf, L"SG1;", lstrlenW(L"SG1;"));
+    ok = bookmark_append_point(&buf, &start);
+    wstrbuf_append_len(&buf, L";", lstrlenW(L";"));
+    ok = ok && bookmark_append_point(&buf, &end);
+    free_rangepoint(&start);
+    free_rangepoint(&end);
+
+    if(ok)
+        *Bookmark = SysAllocString(buf.buf);
+    wstrbuf_finish(&buf);
+    return ok ? (*Bookmark ? S_OK : E_OUTOFMEMORY) : E_FAIL;
+}
+
+static BOOL bookmark_parse_point(HTMLTxtRange *This, const WCHAR **str, rangepoint_t *ret)
+{
+    nsIDOMNode *node;
+    WCHAR *end;
+    ULONG val;
+
+    node = This->doc->node.nsnode;
+    nsIDOMNode_AddRef(node);
+
+    while(**str != ':') {
+        nsIDOMNode *child;
+
+        if(**str < '0' || **str > '9')
+            goto fail;
+        val = wcstoul(*str, &end, 10);
+        if(*end != '.')
+            goto fail;
+        child = get_child_node(node, val);
+        if(!child)
+            goto fail;
+        nsIDOMNode_Release(node);
+        node = child;
+        *str = end + 1;
+    }
+    (*str)++;
+    if(**str < '0' || **str > '9')
+        goto fail;
+    {
+        UINT32 off = wcstoul(*str, &end, 10);
+        UINT32 limit = get_node_type(node) == TEXT_NODE ? get_text_length(node) : get_child_count(node);
+
+        if(off > limit)
+            goto fail;
+        *str = end;
+        init_rangepoint_no_addref(ret, node, off);
+        return TRUE;
+    }
+
+fail:
+    nsIDOMNode_Release(node);
+    return FALSE;
 }
 
