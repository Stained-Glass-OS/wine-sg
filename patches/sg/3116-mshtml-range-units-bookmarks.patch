+static BOOL mp_mover_sentences(rangepoint_t *pt, LONG cnt) { return move_by_sentences(pt, cnt) != 0; }
+
+static BOOL mp_mover_word_end(rangepoint_t *pt, LONG cnt)
+{
+    rangepoint_t prev;
+    BOOL moved = FALSE;
+    WCHAR c;
+
+    if(cnt > 0) {
+        while(1) { /* skip the white space, then the word */
+            init_rangepoint(&prev, pt->node, pt->off);
+            c = move_next_char(pt);
+            if(!c || !iswspace(c)) {
+                free_rangepoint(pt);
+                *pt = prev;
+                break;
+            }
+            free_rangepoint(&prev);
+            moved = TRUE;
+        }
+        while(1) {
+            init_rangepoint(&prev, pt->node, pt->off);
+            c = move_next_char(pt);
+            if(!c || iswspace(c)) {
+                free_rangepoint(pt);
+                *pt = prev;
+                break;
+            }
+            free_rangepoint(&prev);
+            moved = TRUE;
+        }
+    }else {
+        while(1) { /* leave the word, then the white space before it */
+            init_rangepoint(&prev, pt->node, pt->off);
+            c = move_prev_char(&prev);
+            if(!c || iswspace(c)) {
+                free_rangepoint(&prev);
+                break;
+            }
+            free_rangepoint(pt);
+            *pt = prev;
+            moved = TRUE;
+        }
+        while(1) {
+            init_rangepoint(&prev, pt->node, pt->off);
+            c = move_prev_char(&prev);
+            if(!c || !iswspace(c)) {
+                free_rangepoint(&prev);
+                break;
+            }
+            free_rangepoint(pt);
+            *pt = prev;
+            moved = TRUE;
+        }
+    }
+    return moved;
+}
+
+/* Text that looks like an address: scheme://..., www.... or mailto:..., without
+ * the punctuation that ends a sentence after it. Returns the length of the address. */
+static unsigned url_text_length(const WCHAR *s, unsigned len)
+{
+    unsigned i, n = 0;
+
+    if(len > 4 && !wcsnicmp(s, L"www.", 4))
+        n = len;
+    else if(len > 7 && !wcsnicmp(s, L"mailto:", 7))
+        n = len;
+    else if(len > 3 && iswalpha(s[0])) {
+        for(i = 1; i < len && (iswalnum(s[i]) || s[i] == '+' || s[i] == '-' || s[i] == '.'); i++);
+        if(i > 1 && i + 3 < len && s[i] == ':' && s[i+1] == '/' && s[i+2] == '/')
+            n = len;
+    }
+    while(n && wcschr(L".,;:!?'\")]>", s[n-1]))
+        n--;
+    if(n && n <= 4 && !wcsnicmp(s, L"www.", n))
+        n = 0;
+    return n;
+}
+
+typedef struct {
+    rangepoint_t start, end;
+} url_span_t;
+
+static int rangepoint_order(nsIDOMRange *tmpl, const rangepoint_t *a, const rangepoint_t *b)
+{
+    nsIDOMRange *ra = NULL, *rb = NULL;
+    nsIDOMNode *na = a->node, *nb = b->node;
+    LONG oa = a->off, ob = b->off;
+    short cmp = 0;
+    int ret = 0;
+
+    if(na == nb && oa == ob)
+        return 0;
+    if(SUCCEEDED(nsIDOMRange_CloneRange(tmpl, &ra)) && SUCCEEDED(nsIDOMRange_CloneRange(tmpl, &rb))
+       && NS_SUCCEEDED(nsIDOMRange_SetStart(ra, na, oa)) && NS_SUCCEEDED(nsIDOMRange_SetEnd(ra, na, oa))
+       && NS_SUCCEEDED(nsIDOMRange_SetStart(rb, nb, ob)) && NS_SUCCEEDED(nsIDOMRange_SetEnd(rb, nb, ob))
+       && NS_SUCCEEDED(nsIDOMRange_CompareBoundaryPoints(ra, NS_START_TO_START, rb, &cmp)))
+        ret = cmp < 0 ? -1 : cmp > 0 ? 1 : 0;
+    if(ra) nsIDOMRange_Release(ra);
+    if(rb) nsIDOMRange_Release(rb);
+    return ret;
+}
+
+static void free_url_spans(url_span_t *spans, unsigned count)
+{
+    unsigned i;
+    for(i = 0; i < count; i++) {
+        free_rangepoint(&spans[i].start);
+        free_rangepoint(&spans[i].end);
+    }
+    free(spans);
+}
+
+/* Finds every address in the text of the document, in order. */
+static HRESULT find_url_spans(HTMLDocumentNode *doc, url_span_t **ret, unsigned *count)
+{
+    url_span_t *spans = NULL;
+    unsigned n = 0, size = 0;
+    rangepoint_t pt, prev, tokstart;
+    wstrbuf_t buf;
+    WCHAR c;
+
+    *ret = NULL;
+    *count = 0;
+    if(!wstrbuf_init(&buf))
+        return E_OUTOFMEMORY;
+
+    init_rangepoint(&pt, doc->node.nsnode, 0);
+    while(1) {
+        while(1) { /* skip the white space */
+            init_rangepoint(&prev, pt.node, pt.off);
+            c = move_next_char(&pt);
+            if(!c || !iswspace(c)) {
+                free_rangepoint(&pt);
+                pt = prev;
+                break;
+            }
+            free_rangepoint(&prev);
+        }
+        if(!c)
+            break;
+
+        init_rangepoint(&tokstart, pt.node, pt.off);
+        buf.len = 0;
+        buf.buf[0] = 0;
+        while(1) {
+            init_rangepoint(&prev, pt.node, pt.off);
+            c = move_next_char(&pt);
+            if(!c || iswspace(c)) {
+                free_rangepoint(&pt);
+                pt = prev;
+                break;
+            }
+            free_rangepoint(&prev);
+            wstrbuf_append_len(&buf, &c, 1);
+        }
+
+        {
+            unsigned len = url_text_length(buf.buf, buf.len);
+            if(len) {
+                url_span_t *tmp;
+
+                if(n == size) {
+                    size = size ? size * 2 : 8;
+                    tmp = realloc(spans, size * sizeof(*spans));
+                    if(!tmp) {
+                        free_rangepoint(&tokstart);
+                        free_rangepoint(&pt);
+                        free_url_spans(spans, n);
+                        wstrbuf_finish(&buf);
+                        return E_OUTOFMEMORY;
+                    }
+                    spans = tmp;
+                }
+                spans[n].start = tokstart;
+                init_rangepoint(&spans[n].end, tokstart.node, tokstart.off);
+                move_by_chars(&spans[n].end, len);
+                n++;
+                tokstart.node = NULL;
+            }
+        }
+        if(tokstart.node)
+            free_rangepoint(&tokstart);
+        if(!c)
+            break;
+    }
+    free_rangepoint(&pt);
+    wstrbuf_finish(&buf);
+    *ret = spans;
+    *count = n;
+    return S_OK;
+}
+
+static HRESULT mp_move_url(MarkupPointer *This, MOVEUNIT_ACTION action)
+{
+    url_span_t *spans;
+    unsigned count, i;
+    nsIDOMNode *node;
+    rangepoint_t here, *target = NULL;
+    LONG off;
+    HRESULT hres;
+
+    if(!mp_get(This, &node, &off))
+        return E_FAIL;
+    mp_normalize(&node, &off);
+    init_rangepoint_no_addref(&here, node, off);
+
+    hres = find_url_spans(This->doc, &spans, &count);
+    if(FAILED(hres)) {
+        free_rangepoint(&here);
+        return hres;
+    }
+
+    switch(action) {
+    case MOVEUNIT_NEXTURLBEG:
+        for(i = 0; i < count; i++)
+            if(rangepoint_order(This->range, &spans[i].start, &here) > 0) { target = &spans[i].start; break; }
+        break;
+    case MOVEUNIT_NEXTURLEND:
+        for(i = 0; i < count; i++)
+            if(rangepoint_order(This->range, &spans[i].end, &here) > 0) { target = &spans[i].end; break; }
+        break;
+    case MOVEUNIT_PREVURLBEG:
+        for(i = count; i--;)
+            if(rangepoint_order(This->range, &spans[i].start, &here) < 0) { target = &spans[i].start; break; }
+        break;
+    case MOVEUNIT_PREVURLEND:
+        for(i = count; i--;)
