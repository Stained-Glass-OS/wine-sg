+struct enum_ctx
+{
+    const WCHAR *product, *sid, *component;
+    DWORD context, filter;
+};
+
+static UINT enum_products_cb(void *p, DWORD index, MSIHANDLE *rec)
+{
+    struct enum_ctx *c = p;
+    WCHAR code[GUID_SIZE], sid[256];
+    DWORD sidlen = ARRAY_SIZE(sid);
+    MSIINSTALLCONTEXT context;
+    UINT r;
+
+    sid[0] = 0;
+    if ((r = MsiEnumProductsExW(c->product, c->sid, c->context, index, code, &context, sid, &sidlen))) return r;
+    return (*rec = make_record(3, code, context, sid, NULL)) ? ERROR_SUCCESS : ERROR_OUTOFMEMORY;
+}
+
+static UINT enum_patches_cb(void *p, DWORD index, MSIHANDLE *rec)
+{
+    struct enum_ctx *c = p;
+    WCHAR patch[GUID_SIZE], product[GUID_SIZE], sid[256];
+    DWORD sidlen = ARRAY_SIZE(sid);
+    MSIINSTALLCONTEXT context;
+    UINT r;
+
+    sid[0] = 0;
+    if ((r = MsiEnumPatchesExW(c->product, c->sid, c->context, c->filter, index, patch, product, &context, sid,
+                               &sidlen)))
+        return r;
+    if (!(*rec = MsiCreateRecord(4))) return ERROR_OUTOFMEMORY;
+    MsiRecordSetStringW(*rec, 1, patch);
+    MsiRecordSetStringW(*rec, 2, product);
+    MsiRecordSetInteger(*rec, 3, context);
+    MsiRecordSetStringW(*rec, 4, sid);
+    return ERROR_SUCCESS;
+}
