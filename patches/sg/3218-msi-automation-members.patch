+{
+    WCHAR *productW = source_dupAtoW( product ), *sidW = source_dupAtoW( usersid );
+    UINT r = MsiSourceListForceResolutionExW( productW, sidW, context, options );
+
+    free( productW );
+    free( sidW );
+    return r;
+}
+
+/******************************************************************
+ *  MsiSourceListForceResolutionExW (MSI.@)
+ */
+UINT WINAPI MsiSourceListForceResolutionExW( const WCHAR *product, const WCHAR *usersid, MSIINSTALLCONTEXT context,
+                                             DWORD options )
+{
+    WCHAR squashed[SQUASHED_GUID_SIZE];
+    HKEY sourcekey;
+    UINT r;
+
+    TRACE( "%s, %s, %d, %#lx\n", debugstr_w(product), debugstr_w(usersid), context, options );
+
+    if (!product || !squash_guid( product, squashed )) return ERROR_INVALID_PARAMETER;
+    if (options != MSICODE_PRODUCT && options != MSICODE_PATCH) return ERROR_INVALID_PARAMETER;
+    if (context != MSIINSTALLCONTEXT_USERMANAGED && context != MSIINSTALLCONTEXT_USERUNMANAGED &&
+        context != MSIINSTALLCONTEXT_MACHINE)
+        return ERROR_INVALID_PARAMETER;
+    if ((context == MSIINSTALLCONTEXT_MACHINE) && usersid) return ERROR_INVALID_PARAMETER;
+
+    if ((r = OpenSourceKey( product, &sourcekey, options, context, FALSE ))) return r;
+#ifndef SG_MUTANT_MSI_NOFORCERESEX
+    RegDeleteValueW( sourcekey, L"LastUsedSource" );
+#endif
+    RegCloseKey( sourcekey );
+    return ERROR_SUCCESS;
+}
