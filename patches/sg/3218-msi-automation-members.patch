+    free( sidW );
+    return r;
+}
+
+/******************************************************************
+ *  MsiSourceListClearMediaDiskW (MSI.@)
+ */
+UINT WINAPI MsiSourceListClearMediaDiskW( const WCHAR *product, const WCHAR *usersid, MSIINSTALLCONTEXT context,
+                                          DWORD options, DWORD diskid )
+{
+    WCHAR squashed[SQUASHED_GUID_SIZE], index[10];
+    HKEY sourcekey, mediakey;
+    UINT r;
+
+    TRACE( "%s, %s, %d, %#lx, %lu\n", debugstr_w(product), debugstr_w(usersid), context, options, diskid );
+
+    if (!product || !squash_guid( product, squashed )) return ERROR_INVALID_PARAMETER;
+    if (options != MSICODE_PRODUCT && options != MSICODE_PATCH) return ERROR_INVALID_PARAMETER;
+    if (context != MSIINSTALLCONTEXT_USERMANAGED && context != MSIINSTALLCONTEXT_USERUNMANAGED &&
+        context != MSIINSTALLCONTEXT_MACHINE)
+        return ERROR_INVALID_PARAMETER;
+    if ((context == MSIINSTALLCONTEXT_MACHINE) && usersid) return ERROR_INVALID_PARAMETER;
+
+    if ((r = OpenSourceKey( product, &sourcekey, options, context, FALSE ))) return r;
+    if (OpenMediaSubkey( sourcekey, &mediakey, FALSE ))
+    {
+        /* no media sources are registered: nothing to remove */
+        RegCloseKey( sourcekey );
+        return ERROR_SUCCESS;
+    }
+    swprintf( index, ARRAY_SIZE(index), L"%lu", diskid );
+#ifndef SG_MUTANT_MSI_NOCLEARDISK
+    RegDeleteValueW( mediakey, index );
+#endif
+    RegCloseKey( mediakey );
+    RegCloseKey( sourcekey );
+    return ERROR_SUCCESS;
+}
