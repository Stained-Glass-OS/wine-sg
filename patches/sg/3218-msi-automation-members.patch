+/* copies a string into a caller buffer with the MSI conventions: *len is the buffer size in characters and
+ * receives the length without the null */
+static UINT copy_script_string( const WCHAR *value, WCHAR *buf, DWORD *len )
+{
+    DWORD size = lstrlenW( value );
+    UINT r = ERROR_SUCCESS;
+
+    if (buf && len)
+    {
+        if (*len <= size) r = ERROR_MORE_DATA;
+        lstrcpynW( buf, value, *len );
+    }
+    if (len) *len = size;
+    return r;
+}
+
+/***********************************************************************
+ * MsiGetProductInfoFromScriptW        [MSI.@]
+ */
+UINT WINAPI MsiGetProductInfoFromScriptW( const WCHAR *szScriptFile, WCHAR *lpProductBuf39, LANGID *plgidLanguage,
+                                          DWORD *pdwVersion, WCHAR *lpNameBuf, DWORD *pcchNameBuf,
+                                          WCHAR *lpPackageBuf, DWORD *pcchPackageBuf )
+{
+    WCHAR *text = NULL, *package = NULL, *code = NULL, *lang = NULL, *name = NULL, *version = NULL;
+    const WCHAR *file;
+    MSIDATABASE *db;
+    MSIRECORD *rec;
+    UINT r, r2;
+
+    TRACE( "%s, %p, %p, %p, %p, %p, %p, %p\n", debugstr_w(szScriptFile), lpProductBuf39, plgidLanguage, pdwVersion,
+           lpNameBuf, pcchNameBuf, lpPackageBuf, pcchPackageBuf );
+
+    if (!szScriptFile || !szScriptFile[0]) return ERROR_INVALID_PARAMETER;
+    if ((lpNameBuf && !pcchNameBuf) || (lpPackageBuf && !pcchPackageBuf)) return ERROR_INVALID_PARAMETER;
+    if ((r = read_script_text( szScriptFile, &text ))) return r == ERROR_OUTOFMEMORY ? r : ERROR_INSTALL_FAILURE;
+
+    package = read_script_value( text, L"Package" );
+    code = read_script_value( text, L"ProductCode" );
+    free( text );
+    if (!package || !code)
+    {
+        r = ERROR_INSTALL_FAILURE;
+        goto done;
+    }
+
+    /* name and version come from the Property table of the package the script names */
+    if (MSI_OpenDatabaseW( package, MSIDBOPEN_READONLY, &db ))
+    {
+        r = ERROR_INSTALL_FAILURE;
+        goto done;
+    }
+    if ((rec = MSI_QueryGetRecord( db, L"SELECT `Value` FROM `Property` WHERE `Property` = 'ProductName'" )))
+    {
+        name = wcsdup( MSI_RecordGetString( rec, 1 ) ? MSI_RecordGetString( rec, 1 ) : L"" );
+        msiobj_release( &rec->hdr );
+    }
+    if ((rec = MSI_QueryGetRecord( db, L"SELECT `Value` FROM `Property` WHERE `Property` = 'ProductLanguage'" )))
+    {
+        lang = wcsdup( MSI_RecordGetString( rec, 1 ) ? MSI_RecordGetString( rec, 1 ) : L"" );
+        msiobj_release( &rec->hdr );
+    }
+    if ((rec = MSI_QueryGetRecord( db, L"SELECT `Value` FROM `Property` WHERE `Property` = 'ProductVersion'" )))
+    {
+        version = wcsdup( MSI_RecordGetString( rec, 1 ) ? MSI_RecordGetString( rec, 1 ) : L"" );
+        msiobj_release( &rec->hdr );
+    }
+    msiobj_release( &db->hdr );
+    if (!name) name = wcsdup( L"" );
+    if (!version) version = wcsdup( L"" );
+    if (!name || !version)
+    {
+        r = ERROR_OUTOFMEMORY;
+        goto done;
+    }
+
+    r = ERROR_SUCCESS;
+    if (lpProductBuf39) lstrcpyW( lpProductBuf39, code );
+    if (plgidLanguage) *plgidLanguage = lang ? wcstol( lang, NULL, 10 ) : 0;
+    if (pdwVersion)
+    {
+        /* major in the top byte, minor in the next, build in the low word */
+        DWORD major = 0, minor = 0, build = 0;
+        WCHAR *end;
+
+        major = wcstoul( version, &end, 10 );
+        if (*end == '.') minor = wcstoul( end + 1, &end, 10 );
+        if (*end == '.') build = wcstoul( end + 1, &end, 10 );
+#ifndef SG_MUTANT_AUT_SCRIPTVER
+        *pdwVersion = ((major & 0xff) << 24) | ((minor & 0xff) << 16) | (build & 0xffff);
+#else
+        *pdwVersion = (major << 16) | minor;
+#endif
+    }
+    if (pcchNameBuf && (r2 = copy_script_string( name, lpNameBuf, pcchNameBuf ))) r = r2;
+    if (pcchPackageBuf)
+    {
+        file = wcsrchr( package, '\\' );
+        if (!file) file = wcsrchr( package, '/' );
+        if ((r2 = copy_script_string( file ? file + 1 : package, lpPackageBuf, pcchPackageBuf ))) r = r2;
+    }
+
+done:
+    free( package );
+    free( code );
+    free( lang );
+    free( name );
+    free( version );
+    return r;
+}
+
+/***********************************************************************
+ * MsiGetProductInfoFromScriptA        [MSI.@]
+ */
+UINT WINAPI MsiGetProductInfoFromScriptA( const char *szScriptFile, char *lpProductBuf39, LANGID *plgidLanguage,
+                                          DWORD *pdwVersion, char *lpNameBuf, DWORD *pcchNameBuf,
+                                          char *lpPackageBuf, DWORD *pcchPackageBuf )
+{
+    WCHAR *script = NULL, code[GUID_SIZE], *name = NULL, *package = NULL;
+    DWORD namelen = 0, packagelen = 0;
+    UINT r;
+
+    if (szScriptFile && !(script = strdupAtoW( szScriptFile ))) return ERROR_OUTOFMEMORY;
+    if (pcchNameBuf)
+    {
+        namelen = *pcchNameBuf;
+        if (lpNameBuf && !(name = malloc( (namelen ? namelen : 1) * sizeof(WCHAR) ))) { free( script ); return ERROR_OUTOFMEMORY; }
+    }
+    if (pcchPackageBuf)
+    {
+        packagelen = *pcchPackageBuf;
+        if (lpPackageBuf && !(package = malloc( (packagelen ? packagelen : 1) * sizeof(WCHAR) )))
+        {
+            free( script );
+            free( name );
+            return ERROR_OUTOFMEMORY;
+        }
+    }
+    r = MsiGetProductInfoFromScriptW( script, lpProductBuf39 ? code : NULL, plgidLanguage, pdwVersion, name,
+                                      pcchNameBuf ? &namelen : NULL, package, pcchPackageBuf ? &packagelen : NULL );
+    if (lpProductBuf39 && (r == ERROR_SUCCESS || r == ERROR_MORE_DATA))
+        WideCharToMultiByte( CP_ACP, 0, code, -1, lpProductBuf39, GUID_SIZE, NULL, NULL );
+    if (name && (r == ERROR_SUCCESS || r == ERROR_MORE_DATA))
+        WideCharToMultiByte( CP_ACP, 0, name, -1, lpNameBuf, *pcchNameBuf, NULL, NULL );
+    if (package && (r == ERROR_SUCCESS || r == ERROR_MORE_DATA))
+        WideCharToMultiByte( CP_ACP, 0, package, -1, lpPackageBuf, *pcchPackageBuf, NULL, NULL );
+    if (pcchNameBuf) *pcchNameBuf = namelen;
+    if (pcchPackageBuf) *pcchPackageBuf = packagelen;
+    free( script );
+    free( name );
+    free( package );
+    return r;
+}
+
+/* The text of the patch description that MsiDeterminePatchSequence and MsiDetermineApplicablePatches take
+ * instead of the patch file.  The document layout is not published: this one names the patch and the
+ * products it targets with the elements MsiDeterminePatchSequence reads (MsiPatch/TargetProduct/TargetProductCode). */
+static UINT extract_patch_xml( const WCHAR *path, WCHAR **xml )
+{
+    MSIDATABASE *db;
+    MSISUMMARYINFO *si;
+    WCHAR *revision, *template, **products, *text, *p;
+    UINT r, i, size;
+
+    if ((r = MSI_OpenDatabaseW( path, MSIDBOPEN_READONLY, &db )))
+        return GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES ? ERROR_PATCH_PACKAGE_OPEN_FAILED
+                                                                    : ERROR_PATCH_PACKAGE_INVALID;
+    r = msi_get_suminfo( db->storage, 0, &si );
+    msiobj_release( &db->hdr );
+    if (r) return ERROR_PATCH_PACKAGE_INVALID;
+
+    revision = msi_suminfo_dup_string( si, PID_REVNUMBER );
+    template = msi_suminfo_dup_string( si, PID_TEMPLATE );
+    msiobj_release( &si->hdr );
+    if (!revision || revision[0] != '{' || !(p = wcschr( revision, '}' )))
+    {
+        free( revision );
+        free( template );
+        return ERROR_PATCH_PACKAGE_INVALID;
+    }
+    p[1] = 0;  /* the patch code; the codes of patches it obsoletes follow */
+    products = msi_split_string( template ? template : L"", ';' );
+
+    size = 80 + lstrlenW( revision );
+    for (i = 0; products && products[i]; i++) size += 70 + lstrlenW( products[i] );
+    if (!(text = malloc( size * sizeof(WCHAR) )))
+        r = ERROR_OUTOFMEMORY;
+    else
+    {
+        p = text + swprintf( text, size, L"<MsiPatch PatchGUID=\"%s\">", revision );
+        for (i = 0; products && products[i]; i++)
+#ifdef SG_MUTANT_AUT_PATCHXML
+            if (i == 0)
+#else
+            if (products[i][0])
+#endif
+                p += swprintf( p, size - (p - text),
+                               L"<TargetProduct><TargetProductCode>%s</TargetProductCode></TargetProduct>",
+                               products[i] );
+        lstrcpyW( p, L"</MsiPatch>" );
+        *xml = text;
+        r = ERROR_SUCCESS;
+    }
+    free( products );
+    free( revision );
+    free( template );
+    return r;
+}
+
+/***********************************************************************
+ * MsiExtractPatchXMLDataW        [MSI.@]
+ */
+UINT WINAPI MsiExtractPatchXMLDataW( const WCHAR *szPatchPath, DWORD dwReserved, WCHAR *szXMLData,
+                                     DWORD *pcchXMLData )
+{
+    WCHAR *xml = NULL;
+    UINT r;
+
+    TRACE( "%s, %#lx, %p, %p\n", debugstr_w(szPatchPath), dwReserved, szXMLData, pcchXMLData );
+
+    if (!szPatchPath || !szPatchPath[0] || dwReserved || !pcchXMLData) return ERROR_INVALID_PARAMETER;
+    if ((r = extract_patch_xml( szPatchPath, &xml ))) return r;
+
+    r = ERROR_SUCCESS;
+    if (szXMLData)
+    {
+        if (*pcchXMLData > lstrlenW( xml )) lstrcpyW( szXMLData, xml );
+        else r = ERROR_MORE_DATA;
+    }
+    *pcchXMLData = lstrlenW( xml );
+    free( xml );
+    return r;
+}
+
+/***********************************************************************
+ * MsiExtractPatchXMLDataA        [MSI.@]
+ */
+UINT WINAPI MsiExtractPatchXMLDataA( const char *szPatchPath, DWORD dwReserved, char *szXMLData,
+                                     DWORD *pcchXMLData )
+{
+    WCHAR *path = NULL, *xml = NULL;
+    UINT r;
+
+    TRACE( "%s, %#lx, %p, %p\n", debugstr_a(szPatchPath), dwReserved, szXMLData, pcchXMLData );
+
+    if (!szPatchPath || !szPatchPath[0] || dwReserved || !pcchXMLData) return ERROR_INVALID_PARAMETER;
+    if (!(path = strdupAtoW( szPatchPath ))) return ERROR_OUTOFMEMORY;
+    r = extract_patch_xml( path, &xml );
+    free( path );
+    if (r) return r;
+
+    r = ERROR_SUCCESS;
+    if (szXMLData)
+    {
+        if (*pcchXMLData > lstrlenW( xml )) WideCharToMultiByte( CP_ACP, 0, xml, -1, szXMLData, *pcchXMLData, NULL, NULL );
+        else r = ERROR_MORE_DATA;
+    }
+    *pcchXMLData = lstrlenW( xml );
+    free( xml );
+    return r;
+}
