+    switch (id)
+    {
+    case DISPID_VIEW_COLUMNINFO:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_olong(&a, 0, 0, &format)))
