+        DWORD len = 0;
+        MSIDBERROR e;
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        /* the column that failed the last validation, an empty string when there was no error */
+        e = MsiViewGetErrorW(This->msiHandle, tiny, &len);
