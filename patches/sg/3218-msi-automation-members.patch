+{
+    struct enum_ctx *c = p;
+    WCHAR code[GUID_SIZE], sid[256];
+    DWORD sidlen = ARRAY_SIZE(sid);
+    MSIINSTALLCONTEXT context;
+    UINT r;
+
+    sid[0] = 0;
+    if ((r = MsiEnumClientsExW(c->component, c->sid, c->context, index, code, &context, sid, &sidlen))) return r;
+    return (*rec = make_record(3, code, context, sid, NULL)) ? ERROR_SUCCESS : ERROR_OUTOFMEMORY;
+}
+
+static HRESULT safearray_bytes(VARIANT *res, const BYTE *data, DWORD size)
+{
+    SAFEARRAY *sa = SafeArrayCreateVector(VT_UI1, 0, size);
+    void *ptr;
+
+    if (!sa) return E_OUTOFMEMORY;
+    SafeArrayAccessData(sa, &ptr);
+    memcpy(ptr, data, size);
+    SafeArrayUnaccessData(sa);
+    V_VT(res) = VT_ARRAY | VT_UI1;
+    V_ARRAY(res) = sa;
+    return S_OK;
+}
+
+/* Product and Patch objects: one instance of a product or patch in a context */
+struct instance_object
+{
+    struct automation_object autoobj;
+    WCHAR *code;     /* product code, or patch code */
+    WCHAR *product;  /* the product of a patch instance */
+    WCHAR *sid;      /* NULL: current user / machine */
+    DWORD context;
+};
+
+static void instance_free(struct automation_object *This)
+{
+    struct instance_object *obj = CONTAINING_RECORD(This, struct instance_object, autoobj);
+
+    free(obj->code);
+    free(obj->product);
+    free(obj->sid);
+}
+
+static HRESULT create_instance(tid_t tid, const WCHAR *code, const WCHAR *product, const WCHAR *sid, DWORD context,
+                               VARIANT *res)
+{
+    struct instance_object *obj;
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    init_automation_object(&obj->autoobj, 0, tid);
+    obj->context = context;
+    if (!(obj->code = wcsdup(code)) || (product && !(obj->product = wcsdup(product))) ||
+        (sid && !(obj->sid = wcsdup(sid))))
+    {
+        IDispatch_Release(&obj->autoobj.IDispatch_iface);
+        return E_OUTOFMEMORY;
+    }
+    V_VT(res) = VT_DISPATCH;
+    V_DISPATCH(res) = &obj->autoobj.IDispatch_iface;
+    return S_OK;
+}
+
+/* the members that Product and Patch objects share: source lists */
+static HRESULT instance_sources(struct instance_object *obj, BOOL patch, DISPID id, WORD wFlags, ARGS *a,
+                                VARIANT *res)
+{
+    const DWORD code_type = patch ? MSICODE_PATCH : MSICODE_PRODUCT;
+    const WCHAR *s1, *s2;
+    LONG l1, l2;
+    HRESULT hr;
+    UINT r;
+    WCHAR *str;
+
+    switch (id)
+    {
+    case DISPID_PRODUCT_SOURCELISTADDMEDIADISK:
+        if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+        if (SUCCEEDED(hr = a_long(a, 0, &l1)) && SUCCEEDED(hr = a_ostr(a, 1, &s1)) && SUCCEEDED(hr = a_ostr(a, 2, &s2)))
+            hr = ex(MsiSourceListAddMediaDiskW(obj->code, obj->sid, obj->context, code_type, l1, s1, s2));
+        return hr;
+
+    case DISPID_PRODUCT_SOURCELISTADDSOURCE:
+        if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+        if (SUCCEEDED(hr = a_long(a, 0, &l1)) && SUCCEEDED(hr = a_str(a, 1, &s1)) &&
+            SUCCEEDED(hr = a_olong(a, 2, 0, &l2)))
+            #ifndef SG_MUTANT_AUT_SRCOPTS
+            hr = ex(MsiSourceListAddSourceExW(obj->code, obj->sid, obj->context, l1 | code_type, s1, l2));
+#else
+            hr = ex(MsiSourceListAddSourceExW(obj->code, obj->sid, obj->context, l1 | MSICODE_PRODUCT, s1, l2));
+#endif
+        return hr;
+
+    case DISPID_PRODUCT_SOURCELISTCLEARALL:
+        if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+        if (SUCCEEDED(hr = a_long(a, 0, &l1)))
+            hr = ex(MsiSourceListClearAllExW(obj->code, obj->sid, obj->context, l1 | code_type));
+        return hr;
+
+    case DISPID_PRODUCT_SOURCELISTCLEARMEDIADISK:
+        if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+        if (SUCCEEDED(hr = a_long(a, 0, &l1)))
+            hr = ex(MsiSourceListClearMediaDiskW(obj->code, obj->sid, obj->context, code_type, l1));
+        return hr;
+
+    case DISPID_PRODUCT_SOURCELISTCLEARSOURCE:
+        if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+        if (SUCCEEDED(hr = a_long(a, 0, &l1)) && SUCCEEDED(hr = a_str(a, 1, &s1)))
+            hr = ex(MsiSourceListClearSourceW(obj->code, obj->sid, obj->context, l1 | code_type, s1));
+        return hr;
+
+    case DISPID_PRODUCT_SOURCELISTFORCERESOLUTION:
+        if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+        return ex(MsiSourceListForceResolutionExW(obj->code, obj->sid, obj->context, code_type));
+
+    case DISPID_PRODUCT_SOURCELISTINFO:
+        if (wFlags & DISPATCH_PROPERTYPUT)
+        {
+            if (SUCCEEDED(hr = a_str(a, 0, &s1)) && SUCCEEDED(hr = a_str(a, 1, &s2)))
+            {
+                DWORD options = code_type;
+
+                /* LastUsedSource is written as "n;<source>" (network) or "u;<source>" (URL) */
+                if (!wcscmp(s1, L"LastUsedSource"))
+                {
+                    if ((s2[0] == 'n' || s2[0] == 'u') && s2[1] == ';')
+                    {
+                        options |= s2[0] == 'n' ? MSISOURCETYPE_NETWORK : MSISOURCETYPE_URL;
+                        s2 += 2;
+                    }
+                    else options |= MSISOURCETYPE_NETWORK;
+                }
+                hr = ex(MsiSourceListSetInfoW(obj->code, obj->sid, obj->context, options, s1, s2));
+            }
+            return hr;
+        }
+        if (!(wFlags & EXT_GET)) return DISP_E_MEMBERNOTFOUND;
+        if (SUCCEEDED(hr = a_str(a, 0, &s1)))
+        {
+            QSTR(r, str, MsiSourceListGetInfoW(obj->code, obj->sid, obj->context, code_type, s1, qbuf, &qlen));
+            if (!(hr = ex(r))) hr = r_str(res, str);
+            free(str);
+        }
+        return hr;
+
+    case DISPID_PRODUCT_SOURCES:
+    {
+        WCHAR **strings = NULL, buf[MAX_PATH * 4];
+        int count = 0, cap = 0;
+        DWORD len, i;
+
+        if (!(wFlags & EXT_GET)) return DISP_E_MEMBERNOTFOUND;
+        if (FAILED(hr = a_long(a, 0, &l1))) return hr;
+        for (i = 0; ; i++)
+        {
+            len = ARRAY_SIZE(buf);
+            r = MsiSourceListEnumSourcesW(obj->code, obj->sid, obj->context, l1 | code_type, i, buf, &len);
+            if (r == ERROR_NO_MORE_ITEMS) break;
+            if (r) { hr = ex(r); break; }
+            if (FAILED(hr = add_string(&strings, &count, &cap, buf))) break;
+        }
+        if (SUCCEEDED(hr)) hr = return_string_list(res, strings, count);
+        free_string_array(strings, count);
+        return hr;
+    }
+
+    case DISPID_PRODUCT_MEDIADISKS:
+    {
+        IDispatch *disp;
+        struct list_object *list;
+        WCHAR label[MAX_PATH], prompt[MAX_PATH];
+        DWORD diskid, llen, plen, i;
+        MSIHANDLE rec;
+
+        if (!(wFlags & EXT_GET)) return DISP_E_MEMBERNOTFOUND;
+        if (FAILED(hr = new_list(RecordList_tid, &disp, &list))) return hr;
+        for (i = 0; ; i++)
+        {
+            llen = plen = MAX_PATH;
+            r = MsiSourceListEnumMediaDisksW(obj->code, obj->sid, obj->context, code_type, i, &diskid, label, &llen,
+                                             prompt, &plen);
+            if (r == ERROR_NO_MORE_ITEMS) break;
+            if (r) { hr = ex(r); break; }
+            if (!(rec = MsiCreateRecord(3))) { hr = E_OUTOFMEMORY; break; }
+            MsiRecordSetInteger(rec, 1, diskid);
+            MsiRecordSetStringW(rec, 2, label);
+            MsiRecordSetStringW(rec, 3, prompt);
+            if (FAILED(hr = list_add_record(list, rec))) break;
+        }
+        return return_list(res, disp, hr);
+    }
+
+    case DISPID_PRODUCT_CONTEXT:
+        return (wFlags & EXT_GET) ? r_long(res, obj->context) : DISP_E_MEMBERNOTFOUND;
+
+    case DISPID_PRODUCT_USERSID:
+        return (wFlags & EXT_GET) ? r_str(res, obj->sid) : DISP_E_MEMBERNOTFOUND;
+    }
+    return DISP_E_MEMBERNOTFOUND;
+}
+
+static HRESULT product_invoke(struct automation_object *This, DISPID id, REFIID riid, LCID lcid, WORD wFlags,
+                              DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+{
+    struct instance_object *obj = CONTAINING_RECORD(This, struct instance_object, autoobj);
+    const WCHAR *s1;
+    WCHAR *str;
+    INSTALLSTATE state;
+    ARGS a;
+    HRESULT hr;
+    UINT r;
+
+    args_init(&a, dp, err);
+    switch (id)
+    {
+    case DISPID_PRODUCT_PRODUCTCODE:
+        hr = (wFlags & EXT_GET) ? r_str(res, obj->code) : DISP_E_MEMBERNOTFOUND;
+        break;
+
+    case DISPID_PRODUCT_COMPONENTSTATE:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)) &&
+            !(hr = ex(MsiQueryComponentStateW(obj->code, obj->sid, obj->context, s1, &state))))
+            hr = r_long(res, state);
+        break;
+
+    case DISPID_PRODUCT_FEATURESTATE:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)) &&
+            !(hr = ex(MsiQueryFeatureStateExW(obj->code, obj->sid, obj->context, s1, &state))))
+            hr = r_long(res, state);
+        break;
+
+    case DISPID_PRODUCT_INSTALLPROPERTY:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)))
+        {
+            QSTR(r, str, MsiGetProductInfoExW(obj->code, obj->sid, obj->context, s1, qbuf, &qlen));
+            if (!(hr = ex(r))) hr = r_str(res, str);
+            free(str);
+        }
+        break;
+
+    case DISPID_PRODUCT_STATE:
+    {
+        DWORD len = 0;
+        WCHAR value[8] = L"";
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        /* the "State" property: "1" advertised, "5" installed */
+        len = ARRAY_SIZE(value);
+        r = MsiGetProductInfoExW(obj->code, obj->sid, obj->context, L"State", value, &len);
+        if (r == ERROR_SUCCESS)
+            hr = r_long(res, wcstol(value, NULL, 10));
+        else if (r == ERROR_UNKNOWN_PRODUCT)
+            hr = r_long(res, INSTALLSTATE_UNKNOWN);
+        else hr = ex(r);
+        break;
+    }
+
+    default:
+        hr = instance_sources(obj, FALSE, id, wFlags, &a, res);
+    }
+    args_clear(&a);
+    return hr;
+}
+
+/* the source list members of a Patch have the same arguments as those of a Product */
+static DISPID patch_to_product_id(DISPID id)
+{
+    switch (id)
+    {
+    case DISPID_PATCH_CONTEXT: return DISPID_PRODUCT_CONTEXT;
+    case DISPID_PATCH_MEDIADISKS: return DISPID_PRODUCT_MEDIADISKS;
+    case DISPID_PATCH_SOURCELISTADDMEDIADISK: return DISPID_PRODUCT_SOURCELISTADDMEDIADISK;
+    case DISPID_PATCH_SOURCELISTADDSOURCE: return DISPID_PRODUCT_SOURCELISTADDSOURCE;
+    case DISPID_PATCH_SOURCELISTCLEARALL: return DISPID_PRODUCT_SOURCELISTCLEARALL;
+    case DISPID_PATCH_SOURCELISTCLEARMEDIADISK: return DISPID_PRODUCT_SOURCELISTCLEARMEDIADISK;
+    case DISPID_PATCH_SOURCELISTCLEARSOURCE: return DISPID_PRODUCT_SOURCELISTCLEARSOURCE;
+    case DISPID_PATCH_SOURCELISTFORCERESOLUTION: return DISPID_PRODUCT_SOURCELISTFORCERESOLUTION;
+    case DISPID_PATCH_SOURCELISTINFO: return DISPID_PRODUCT_SOURCELISTINFO;
+#ifndef SG_MUTANT_AUT_PATCHIDS
+    case DISPID_PATCH_SOURCES: return DISPID_PRODUCT_SOURCES;
+#endif
+    case DISPID_PATCH_USERSID: return DISPID_PRODUCT_USERSID;
+    }
+    return DISPID_UNKNOWN;
+}
+
+static HRESULT patch_invoke(struct automation_object *This, DISPID id, REFIID riid, LCID lcid, WORD wFlags,
+                            DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+{
+    struct instance_object *obj = CONTAINING_RECORD(This, struct instance_object, autoobj);
+    const WCHAR *s1;
+    WCHAR *str;
+    ARGS a;
+    HRESULT hr;
+    UINT r;
+
+    args_init(&a, dp, err);
+    switch (id)
+    {
+    case DISPID_PATCH_PATCHCODE:
+        hr = (wFlags & EXT_GET) ? r_str(res, obj->code) : DISP_E_MEMBERNOTFOUND;
+        break;
+
+    case DISPID_PATCH_PRODUCTCODE:
+        hr = (wFlags & EXT_GET) ? r_str(res, obj->product) : DISP_E_MEMBERNOTFOUND;
+        break;
+
+    case DISPID_PATCH_PATCHPROPERTY:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)))
+        {
+            QSTR(r, str, MsiGetPatchInfoExW(obj->code, obj->product, obj->sid, obj->context, s1, qbuf, &qlen));
+            if (!(hr = ex(r))) hr = r_str(res, str);
+            free(str);
+        }
+        break;
+
+    case DISPID_PATCH_STATE:
+    {
+        WCHAR value[8] = L"";
+        DWORD len = ARRAY_SIZE(value);
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        r = MsiGetPatchInfoExW(obj->code, obj->product, obj->sid, obj->context, L"State", value, &len);
+        hr = r ? ex(r) : r_long(res, wcstol(value, NULL, 10));
+        break;
+    }
+
+    default:
+        hr = instance_sources(obj, TRUE, patch_to_product_id(id), wFlags, &a, res);
+    }
+    args_clear(&a);
+    return hr;
+}
+
+static HRESULT installer_ext(DISPID id, WORD wFlags, DISPPARAMS *dp, VARIANT *res, UINT *err)
+{
+    const WCHAR *s1, *s2, *s3, *s4;
+    LONG l1, l2, l3, l4;
+    struct enum_ctx ctx;
+    ARGS a;
+    HRESULT hr;
+    UINT r;
+
+    args_init(&a, dp, err);
+    switch (id)
+    {
+    case DISPID_INSTALLER_ADVERTISEPRODUCT:
+        if (!(wFlags & DISPATCH_METHOD)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)) && SUCCEEDED(hr = a_long(&a, 1, &l1)) &&
+            SUCCEEDED(hr = a_ostr(&a, 2, &s2)) && SUCCEEDED(hr = a_olong(&a, 3, 0, &l2)) &&
+            SUCCEEDED(hr = a_olong(&a, 4, 0, &l3)))
+        {
+            /* the script argument is ADVERTISEFLAGS_MACHINEASSIGN (0) or _USERASSIGN (1) */
+            const WCHAR *target = l1 == 1 ? (const WCHAR *)ADVERTISEFLAGS_USERASSIGN
+                                          : (const WCHAR *)ADVERTISEFLAGS_MACHINEASSIGN;
+#ifndef SG_MUTANT_AUT_ADVCTX
+            hr = ex(MsiAdvertiseProductExW(s1, target, s2, l2, 0, l3));
+#else
+            hr = ex(MsiAdvertiseProductExW(s1, (const WCHAR *)ADVERTISEFLAGS_MACHINEASSIGN, s2, l2, 0, l3));
+#endif
+        }
+        break;
+
+    case DISPID_INSTALLER_ADVERTISESCRIPT:
+        if (!(wFlags & DISPATCH_METHOD)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)) && SUCCEEDED(hr = a_long(&a, 1, &l1)))
+        {
+            VARIANT_BOOL remove = VARIANT_FALSE;
+
+            if (SUCCEEDED(DispGetParam(dp, 2, VT_BOOL, &a.v[2], err))) remove = V_BOOL(&a.v[2]);
+            hr = ex(MsiAdvertiseScriptW(s1, l1, NULL, remove != VARIANT_FALSE));
+        }
+        break;
+
+    case DISPID_INSTALLER_APPLYMULTIPLEPATCHES:
+        if (!(wFlags & DISPATCH_METHOD)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)) && SUCCEEDED(hr = a_ostr(&a, 1, &s2)) &&
+            SUCCEEDED(hr = a_ostr(&a, 2, &s3)))
+            hr = ex(MsiApplyMultiplePatchesW(s1, s2, s3));
+        break;
+
+    case DISPID_INSTALLER_CLIENTSEX:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        memset(&ctx, 0, sizeof(ctx));
+        if (SUCCEEDED(hr = a_str(&a, 0, &ctx.component)) && SUCCEEDED(hr = a_ostr(&a, 1, &ctx.sid)) &&
+            SUCCEEDED(hr = a_olong(&a, 2, MSIINSTALLCONTEXT_ALL, &l1)))
+        {
+            ctx.context = l1;
+            hr = enum_records(res, enum_clients_cb, &ctx);
+        }
+        break;
+
+    case DISPID_INSTALLER_COMPONENTPATHEX:
+    {
+        WCHAR path[MAX_PATH];
+        DWORD len = ARRAY_SIZE(path);
+        INSTALLSTATE state;
+        MSIHANDLE rec;
+        IDispatch *disp;
+        struct list_object *list;
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (FAILED(hr = a_str(&a, 0, &s1)) || FAILED(hr = a_str(&a, 1, &s2)) || FAILED(hr = a_ostr(&a, 2, &s3)) ||
+            FAILED(hr = a_olong(&a, 3, MSIINSTALLCONTEXT_ALL, &l1)))
+            break;
+        path[0] = 0;
+        state = MsiGetComponentPathExW(s1, s2, s3, l1, path, &len);
+        if (state == INSTALLSTATE_INVALIDARG || state == INSTALLSTATE_UNKNOWN) { hr = DISP_E_EXCEPTION; break; }
+        /* one record: the path and the installed state */
+        if (FAILED(hr = new_list(RecordList_tid, &disp, &list))) break;
+        if (!(rec = MsiCreateRecord(2))) hr = E_OUTOFMEMORY;
+        else
+        {
+            MsiRecordSetStringW(rec, 1, path);
+            MsiRecordSetInteger(rec, 2, state);
+            hr = list_add_record(list, rec);
+        }
+        hr = return_list(res, disp, hr);
+        break;
+    }
+
+    case DISPID_INSTALLER_COMPONENTSEX:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        memset(&ctx, 0, sizeof(ctx));
+        if (SUCCEEDED(hr = a_ostr(&a, 0, &ctx.sid)) && SUCCEEDED(hr = a_olong(&a, 1, MSIINSTALLCONTEXT_ALL, &l1)))
+        {
+            ctx.context = l1;
+            hr = enum_records(res, enum_components_cb, &ctx);
+        }
+        break;
+
+    case DISPID_INSTALLER_CREATEADVERTISESCRIPT:
+        if (!(wFlags & DISPATCH_METHOD)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (SUCCEEDED(hr = a_str(&a, 0, &s1)) && SUCCEEDED(hr = a_str(&a, 1, &s2)) &&
+            SUCCEEDED(hr = a_ostr(&a, 2, &s3)) && SUCCEEDED(hr = a_olong(&a, 3, 0, &l1)) &&
+            SUCCEEDED(hr = a_olong(&a, 4, 0, &l2)) && SUCCEEDED(hr = a_olong(&a, 5, 0, &l3)))
+            hr = ex(MsiAdvertiseProductExW(s1, s2, s3, l1, l2, l3));
+        break;
+
+    case DISPID_INSTALLER_EXTRACTPATCHXMLDATA:
+    {
+        WCHAR *xml;
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (FAILED(hr = a_str(&a, 0, &s1))) break;
+        QSTR(r, xml, MsiExtractPatchXMLDataW(s1, 0, qbuf, &qlen));
+        if (!(hr = ex(r))) hr = r_str(res, xml);
+        free(xml);
+        break;
+    }
+
+    case DISPID_INSTALLER_FILESIGNATUREINFO:
+    {
+        PCCERT_CONTEXT cert = NULL;
+        BYTE hash[64];
+        DWORD hashlen = sizeof(hash);
+        HRESULT sig;
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (FAILED(hr = a_str(&a, 0, &s1)) || FAILED(hr = a_long(&a, 1, &l1)) || FAILED(hr = a_long(&a, 2, &l2)))
+            break;
+        if (l2 != 0 && l2 != 1) { hr = DISP_E_EXCEPTION; break; }
+        sig = MsiGetFileSignatureInformationW(s1, l1, &cert, hash, &hashlen);
+        if (FAILED(sig)) { hr = DISP_E_EXCEPTION; break; }
+        if (l2 == 0) hr = safearray_bytes(res, cert->pbCertEncoded, cert->cbCertEncoded);
+        else hr = safearray_bytes(res, hash, hashlen);
+        CertFreeCertificateContext(cert);
+        break;
+    }
+
+    case DISPID_INSTALLER_PATCHFILES:
+    {
+        WCHAR **strings = NULL;
+        int count = 0, cap = 0;
+        DWORD n, i;
+        MSIHANDLE *recs;
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (FAILED(hr = a_str(&a, 0, &s1)) || FAILED(hr = a_str(&a, 1, &s2))) break;
+        if ((hr = ex(MsiGetPatchFileListW(s1, s2, &n, &recs)))) break;
+        for (i = 0; i < n; i++)
+        {
+            WCHAR *name;
+
+            QSTR(r, name, MsiRecordGetStringW(recs[i], 1, qbuf, &qlen));
+            if (r == ERROR_SUCCESS && name) hr = add_string(&strings, &count, &cap, name);
+            free(name);
+            MsiCloseHandle(recs[i]);
+        }
+        LocalFree(recs);
+        if (SUCCEEDED(hr)) hr = return_string_list(res, strings, count);
+        free_string_array(strings, count);
+        break;
+    }
+
+    case DISPID_INSTALLER_PATCHESEX:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        memset(&ctx, 0, sizeof(ctx));
