+/* the Msi*Ex enumerations: a RecordList of records filled by cb(index, record handle) until it reports
+ * ERROR_NO_MORE_ITEMS */
+static HRESULT enum_records(VARIANT *res, UINT (*cb)(void *ctx, DWORD index, MSIHANDLE *rec), void *ctx)
+{
+    IDispatch *disp;
+    struct list_object *list;
+    MSIHANDLE rec;
+    DWORD i;
+    HRESULT hr;
+    UINT r;
+
+    if (FAILED(hr = new_list(RecordList_tid, &disp, &list))) return hr;
+    for (i = 0; ; i++)
+    {
+        r = cb(ctx, i, &rec);
+        if (r == ERROR_NO_MORE_ITEMS) break;
+        if (r) { hr = ex(r); break; }
+        if (FAILED(hr = list_add_record(list, rec))) break;
+    }
+    return return_list(res, disp, hr);
+}
