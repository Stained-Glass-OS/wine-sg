+/* the disk space an installation needs, per drive, compared with what the drives have free: ERROR_DISK_FULL when
+ * a drive cannot hold it.  Costs are in units of 512 bytes. */
+UINT WINAPI MsiVerifyDiskSpace( MSIHANDLE handle )
+{
+    struct { WCHAR letter; LONGLONG need; } drives[26];
+    MSIPACKAGE *package;
+    MSICOMPONENT *comp;
+    WCHAR drive[8];
+    DWORD len, i, count = 0;
+    int cost, temp;
+    UINT r;
+
+    TRACE( "%lu\n", handle );
+
+    if (!(package = msihandle2msiinfo( handle, MSIHANDLETYPE_PACKAGE ))) return ERROR_INVALID_HANDLE;
+    /* the cost of the installer engine itself first: this also checks that costing is complete */
+    len = ARRAY_SIZE(drive);
+    r = MsiEnumComponentCostsW( handle, NULL, 0, INSTALLSTATE_LOCAL, drive, &len, &cost, &temp );
+    if (r)
+    {
+        msiobj_release( &package->hdr );
+        return r;
+    }
+    LIST_FOR_EACH_ENTRY( comp, &package->components, MSICOMPONENT, entry )
+    {
+        WCHAR letter;
+
+        if (comp->Action != INSTALLSTATE_LOCAL) continue;
+        len = ARRAY_SIZE(drive);
+        if (MsiEnumComponentCostsW( handle, comp->Component, 0, INSTALLSTATE_LOCAL, drive, &len, &cost, &temp ))
+            continue;
+        letter = towupper( drive[0] );
+        for (i = 0; i < count; i++) if (drives[i].letter == letter) break;
+        if (i == count)
+        {
+            if (count == ARRAY_SIZE(drives)) continue;
+            drives[count].letter = letter;
+            drives[count++].need = 0;
+        }
+        drives[i].need += ((LONGLONG)cost + temp) * 512;
+    }
+    msiobj_release( &package->hdr );
+
+    for (i = 0; i < count; i++)
+    {
+        ULARGE_INTEGER free_bytes;
+        WCHAR root[4] = { drives[i].letter, ':', '\\', 0 };
+
+        if (drives[i].need <= 0) continue;
+        if (!GetDiskFreeSpaceExW( root, &free_bytes, NULL, NULL )) continue;
+#ifndef SG_MUTANT_MSI_DISKFULL
+        if ((ULONGLONG)drives[i].need > free_bytes.QuadPart) return ERROR_DISK_FULL;
+#endif
+    }
+    return ERROR_SUCCESS;
+}
