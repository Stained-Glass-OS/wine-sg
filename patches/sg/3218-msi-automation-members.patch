+
+/*
+ * Members of the automation objects that are documented for the Installer object model but were missing from
+ * the type library (patch 3218).  Their DISPIDs are our own (0x1000 and up, see msiserver_dispids.h).  Every
+ * member is a thin wrapper over the Msi* API of the same name.
+ */
+#define EXT_GET (DISPATCH_METHOD | DISPATCH_PROPERTYGET)
+
+typedef struct
+{
+    DISPPARAMS *dp;
+    UINT *err;
+    VARIANT v[8];
+} ARGS;
+
+static void args_init(ARGS *a, DISPPARAMS *dp, UINT *err)
+{
+    unsigned int i;
+
+    a->dp = dp;
+    a->err = err;
+    for (i = 0; i < ARRAY_SIZE(a->v); i++) VariantInit(&a->v[i]);
+}
+
+static void args_clear(ARGS *a)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(a->v); i++) VariantClear(&a->v[i]);
+}
+
+/* a required string argument */
+static HRESULT a_str(ARGS *a, UINT i, const WCHAR **s)
+{
+    HRESULT hr = DispGetParam(a->dp, i, VT_BSTR, &a->v[i], a->err);
+
+    if (SUCCEEDED(hr)) *s = V_BSTR(&a->v[i]) ? V_BSTR(&a->v[i]) : L"";
+    return hr;
+}
+
+/* an optional string argument: NULL when it is missing, empty or Null */
+static HRESULT a_ostr(ARGS *a, UINT i, const WCHAR **s)
+{
+    HRESULT hr = DispGetParam(a->dp, i, VT_BSTR, &a->v[i], a->err);
+
+    *s = NULL;
+    if (hr == DISP_E_PARAMNOTFOUND || hr == DISP_E_TYPEMISMATCH) return S_OK;
+    if (SUCCEEDED(hr) && V_BSTR(&a->v[i]) && V_BSTR(&a->v[i])[0]) *s = V_BSTR(&a->v[i]);
+    return hr;
+}
+
+static HRESULT a_long(ARGS *a, UINT i, LONG *l)
+{
+    HRESULT hr = DispGetParam(a->dp, i, VT_I4, &a->v[i], a->err);
+
+    if (SUCCEEDED(hr)) *l = V_I4(&a->v[i]);
+    return hr;
+}
+
+static HRESULT a_olong(ARGS *a, UINT i, LONG def, LONG *l)
+{
+    HRESULT hr = DispGetParam(a->dp, i, VT_I4, &a->v[i], a->err);
+
+    *l = def;
+    if (hr == DISP_E_PARAMNOTFOUND || hr == DISP_E_TYPEMISMATCH) return S_OK;
+    if (SUCCEEDED(hr)) *l = V_I4(&a->v[i]);
+    return hr;
+}
+
+/* an object argument of the given automation type: its MSI handle (0 when missing and optional) */
+static HRESULT a_obj(ARGS *a, UINT i, tid_t tid, BOOL optional, MSIHANDLE *h)
+{
+    HRESULT hr = DispGetParam(a->dp, i, VT_DISPATCH, &a->v[i], a->err);
+    struct automation_object *obj;
+
+    *h = 0;
+    if (FAILED(hr))
+    {
+        if (optional && (hr == DISP_E_PARAMNOTFOUND || hr == DISP_E_TYPEMISMATCH)) return S_OK;
+        return hr;
+    }
+    if (!V_DISPATCH(&a->v[i])) return optional ? S_OK : DISP_E_TYPEMISMATCH;
+    obj = (struct automation_object *)V_DISPATCH(&a->v[i]);
+    if (obj->IDispatch_iface.lpVtbl != &AutomationObjectVtbl || obj->tid != tid)
+    {
+        *a->err = i;
+        return DISP_E_TYPEMISMATCH;
+    }
+    *h = obj->msiHandle;
+    return S_OK;
+}
+
+static HRESULT ex(UINT r)
+{
+    if (r == ERROR_SUCCESS) return S_OK;
+    WARN("Msi API returned %u\n", r);
+    return DISP_E_EXCEPTION;
+}
+
+static HRESULT r_str(VARIANT *res, const WCHAR *s)
+{
+    V_VT(res) = VT_BSTR;
+    V_BSTR(res) = SysAllocString(s ? s : L"");
+    return V_BSTR(res) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT r_long(VARIANT *res, LONG l)
+{
+    V_VT(res) = VT_I4;
+    V_I4(res) = l;
+    return S_OK;
+}
+
+static HRESULT r_bool(VARIANT *res, BOOL b)
+{
+    V_VT(res) = VT_BOOL;
+    V_BOOL(res) = b ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT r_record(VARIANT *res, MSIHANDLE rec)
+{
+    IDispatch *disp;
+    HRESULT hr = create_record(rec, &disp);
+
+    if (FAILED(hr))
+    {
+        MsiCloseHandle(rec);
+        return hr;
+    }
+    V_VT(res) = VT_DISPATCH;
+    V_DISPATCH(res) = disp;
+    return S_OK;
+}
+
+/* fetch a string through a (buffer, length) call, retrying with the length it reports; CALL uses qbuf and
+ * &qlen and returns ERROR_MORE_DATA when the buffer is too small */
+#define QSTR(R, OUT, CALL) do { \
+    WCHAR qe[1]; DWORD qlen = 0; WCHAR *qbuf = qe; \
+    (OUT) = NULL; \
+    (R) = CALL; \
+    if ((R) == ERROR_MORE_DATA) \
+    { \
+        qbuf = (OUT) = malloc((qlen + 1) * sizeof(WCHAR)); \
+        if (!(OUT)) (R) = ERROR_OUTOFMEMORY; \
+        else { qlen++; (R) = CALL; } \
+    } \
+    else if ((R) == ERROR_SUCCESS) (OUT) = wcsdup(L""); \
+    if ((R) && (OUT)) { free(OUT); (OUT) = NULL; } \
+} while (0)
+
+/* RecordList objects: a list of Record objects */
+static HRESULT new_list(tid_t tid, IDispatch **disp, struct list_object **list)
+{
+    *list = calloc(1, sizeof(**list));
+    if (!*list) return E_OUTOFMEMORY;
+    init_automation_object(&(*list)->autoobj, 0, tid);
+    *disp = &(*list)->autoobj.IDispatch_iface;
+    return S_OK;
+}
+
+/* appends a record, taking ownership of the handle */
+static HRESULT list_add_record(struct list_object *list, MSIHANDLE rec)
+{
+    VARIANT *data;
+    IDispatch *disp;
+    HRESULT hr;
+
+    if (FAILED(hr = create_record(rec, &disp)))
+    {
+        MsiCloseHandle(rec);
+        return hr;
+    }
+    if (!(data = realloc(list->data, (list->count + 1) * sizeof(VARIANT))))
+    {
+        IDispatch_Release(disp);
+        return E_OUTOFMEMORY;
+    }
+    list->data = data;
+    VariantInit(&data[list->count]);
+    V_VT(&data[list->count]) = VT_DISPATCH;
+    V_DISPATCH(&data[list->count]) = disp;
+    list->count++;
+    return S_OK;
+}
+
+static HRESULT return_list(VARIANT *res, IDispatch *disp, HRESULT hr)
+{
+    if (FAILED(hr))
+    {
+        IDispatch_Release(disp);
+        return hr;
+    }
+    V_VT(res) = VT_DISPATCH;
+    V_DISPATCH(res) = disp;
+    return S_OK;
+}
+
+/* a record of strings and integers: "s" fields are WCHAR *, "i" fields are LONG values passed as INT_PTR */
+static MSIHANDLE make_record(unsigned int count, const WCHAR *s1, INT_PTR i2, const WCHAR *s3, const WCHAR *s4)
+{
+    MSIHANDLE rec = MsiCreateRecord(count);
+
+    if (!rec) return 0;
+    if (s1) MsiRecordSetStringW(rec, 1, s1);
+    if (count >= 2) MsiRecordSetInteger(rec, 2, (int)i2);
+    if (count >= 3 && s3) MsiRecordSetStringW(rec, 3, s3);
+    if (count >= 4 && s4) MsiRecordSetStringW(rec, 4, s4);
+    return rec;
+}
+
+/* UIPreview objects */
+static HRESULT create_uipreview(MSIHANDLE msiHandle, IDispatch **disp)
+{
+    struct automation_object *preview = malloc(sizeof(*preview));
+
+    if (!preview) return E_OUTOFMEMORY;
+    init_automation_object(preview, msiHandle, UIPreview_tid);
+    *disp = &preview->IDispatch_iface;
+    return S_OK;
+}
+
+static HRESULT uipreview_invoke(struct automation_object *This, DISPID id, REFIID riid, LCID lcid, WORD wFlags,
+                                DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+{
+    const WCHAR *name, *value;
+    ARGS a;
+    HRESULT hr;
+    WCHAR *str;
+
+    args_init(&a, dp, err);
+    switch (id)
+    {
+    case DISPID_UIPREVIEW_PROPERTY:
+    {
+        MSIPREVIEW *preview;
+
+        /* a property of the previewed database, or an environment variable when the name starts with % */
+        if (!(wFlags & (DISPATCH_PROPERTYPUT | EXT_GET))) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (!(preview = msihandle2msiinfo(This->msiHandle, MSIHANDLETYPE_PREVIEW))) { hr = DISP_E_EXCEPTION; break; }
+        if (FAILED(hr = a_str(&a, 0, &name))) { msiobj_release(&preview->hdr); break; }
+        if (wFlags & DISPATCH_PROPERTYPUT)
+        {
+            if (SUCCEEDED(hr = a_str(&a, 1, &value)))
+            {
+                if (name[0] == '%') hr = SetEnvironmentVariableW(name + 1, value) ? S_OK : DISP_E_EXCEPTION;
+#ifndef SG_MUTANT_AUT_UIPROP
+                else hr = ex(msi_set_property(preview->package->db, name, value, -1));
+#else
+                else hr = S_OK;
+#endif
+            }
+        }
+        else if (name[0] == '%')
+        {
+            WCHAR buf[1024];
+            DWORD len = GetEnvironmentVariableW(name + 1, buf, ARRAY_SIZE(buf));
+
+            hr = r_str(res, len && len < ARRAY_SIZE(buf) ? buf : L"");
+        }
+        else
+        {
+            str = msi_dup_property(preview->package->db, name);
+            hr = r_str(res, str ? str : L"");
+            free(str);
+        }
+        msiobj_release(&preview->hdr);
+        break;
+    }
+
+    case DISPID_UIPREVIEW_VIEWDIALOG:
+        if (!(wFlags & DISPATCH_METHOD)) hr = DISP_E_MEMBERNOTFOUND;
+        else if (SUCCEEDED(hr = a_str(&a, 0, &name))) hr = ex(MsiPreviewDialogW(This->msiHandle, name));
+        break;
+
+    case DISPID_UIPREVIEW_VIEWBILLBOARD:
+        if (!(wFlags & DISPATCH_METHOD)) hr = DISP_E_MEMBERNOTFOUND;
+        else if (SUCCEEDED(hr = a_str(&a, 0, &name)) && SUCCEEDED(hr = a_str(&a, 1, &value)))
+            hr = ex(MsiPreviewBillboardW(This->msiHandle, name, value));
+        break;
+
+    default:
+        hr = DISP_E_MEMBERNOTFOUND;
+    }
+    args_clear(&a);
+    return hr;
+}
+
+/* FeatureInfo objects: the feature of a session */
+struct featureinfo_object
+{
+    struct automation_object autoobj;
+    IDispatch *session;
+    WCHAR *feature;
+};
+
+static void featureinfo_free(struct automation_object *This)
+{
+    struct featureinfo_object *info = CONTAINING_RECORD(This, struct featureinfo_object, autoobj);
+
+    IDispatch_Release(info->session);
+    free(info->feature);
+}
+
+static HRESULT create_featureinfo(struct automation_object *session, const WCHAR *feature, IDispatch **disp)
+{
+    struct featureinfo_object *info = calloc(1, sizeof(*info));
+
+    if (!info) return E_OUTOFMEMORY;
+    if (!(info->feature = wcsdup(feature)))
+    {
+        free(info);
+        return E_OUTOFMEMORY;
+    }
+    init_automation_object(&info->autoobj, 0, FeatureInfo_tid);
+    info->session = &session->IDispatch_iface;
+    IDispatch_AddRef(info->session);
+    *disp = &info->autoobj.IDispatch_iface;
+    return S_OK;
+}
+
+static UINT get_feature_info(MSIHANDLE session, const WCHAR *feature, DWORD *attrs, WCHAR **title, WCHAR **help)
+{
+    DWORD tlen = 256, hlen = 256;
+    UINT r;
+    int tries;
+
+    *title = *help = NULL;
+    for (tries = 0; tries < 3; tries++)
+    {
+        free(*title);
+        free(*help);
+        *title = malloc((tlen + 1) * sizeof(WCHAR));
+        *help = malloc((hlen + 1) * sizeof(WCHAR));
+        if (!*title || !*help) return ERROR_OUTOFMEMORY;
+        r = MsiGetFeatureInfoW(session, feature, attrs, *title, &tlen, *help, &hlen);
+        if (r != ERROR_MORE_DATA) break;
+    }
+    return r;
+}
+
+static HRESULT featureinfo_invoke(struct automation_object *This, DISPID id, REFIID riid, LCID lcid, WORD wFlags,
+                                  DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+{
+    struct featureinfo_object *info = CONTAINING_RECORD(This, struct featureinfo_object, autoobj);
+    MSIHANDLE session = ((struct automation_object *)info->session)->msiHandle;
+    WCHAR *title, *help;
+    DWORD attrs = 0;
+    ARGS a;
+    HRESULT hr;
+    UINT r;
+
+    args_init(&a, dp, err);
+    switch (id)
+    {
+    case DISPID_FEATUREINFO_ATTRIBUTES:
+        if (wFlags & DISPATCH_PROPERTYPUT)
+        {
+            LONG value;
+
+            if (SUCCEEDED(hr = a_long(&a, 0, &value)))
+                hr = ex(MsiSetFeatureAttributesW(session, info->feature, value));
+        }
+        else if (wFlags & EXT_GET)
+        {
+            r = get_feature_info(session, info->feature, &attrs, &title, &help);
+            if (!(hr = ex(r))) hr = r_long(res, attrs);
+            free(title);
+            free(help);
+        }
+        else hr = DISP_E_MEMBERNOTFOUND;
+        break;
+
+    case DISPID_FEATUREINFO_TITLE:
+    case DISPID_FEATUREINFO_DESCRIPTION:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        r = get_feature_info(session, info->feature, &attrs, &title, &help);
+        if (!(hr = ex(r))) hr = r_str(res, id == DISPID_FEATUREINFO_TITLE ? title : help);
+        free(title);
+        free(help);
+        break;
+
+    default:
+        hr = DISP_E_MEMBERNOTFOUND;
+    }
+    args_clear(&a);
+    return hr;
+}
+
+/* Record members */
+static HRESULT record_ext(struct automation_object *This, DISPID id, WORD wFlags, DISPPARAMS *dp, VARIANT *res,
+                          UINT *err)
+{
+    const WCHAR *path;
+    WCHAR *str;
+    LONG field, length, format;
+    ARGS a;
+    HRESULT hr;
+    UINT r;
+
+    args_init(&a, dp, err);
+    switch (id)
+    {
+    case DISPID_RECORD_CLEARDATA:
+        hr = (wFlags & DISPATCH_METHOD) ? ex(MsiRecordClearData(This->msiHandle)) : DISP_E_MEMBERNOTFOUND;
+        break;
+
+    case DISPID_RECORD_DATASIZE:
+        if (!(wFlags & EXT_GET)) hr = DISP_E_MEMBERNOTFOUND;
+        else if (SUCCEEDED(hr = a_long(&a, 0, &field))) hr = r_long(res, MsiRecordDataSize(This->msiHandle, field));
+        break;
+
+    case DISPID_RECORD_FORMATTEXT:
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        QSTR(r, str, MsiFormatRecordW(0, This->msiHandle, qbuf, &qlen));
+        if (!(hr = ex(r))) hr = r_str(res, str);
+        free(str);
+        break;
+
+    case DISPID_RECORD_ISNULL:
+        if (!(wFlags & EXT_GET)) hr = DISP_E_MEMBERNOTFOUND;
+        else if (SUCCEEDED(hr = a_long(&a, 0, &field))) hr = r_bool(res, MsiRecordIsNull(This->msiHandle, field));
+        break;
+
+    case DISPID_RECORD_READSTREAM:
+    {
+        char *buf;
+        DWORD size;
+
+        if (!(wFlags & EXT_GET)) { hr = DISP_E_MEMBERNOTFOUND; break; }
+        if (FAILED(hr = a_long(&a, 0, &field)) || FAILED(hr = a_long(&a, 1, &length)) ||
+            FAILED(hr = a_long(&a, 2, &format)))
+            break;
+        if (length < 0 || format < 0 || format > 3 || (format == 0 && (length < 1 || length > 4)))
+        {
+            hr = DISP_E_EXCEPTION;
+            break;
+        }
+        if (!(buf = calloc(length + 1, 1))) { hr = E_OUTOFMEMORY; break; }
+        size = length;
+        /* a missing field, or one that is not a stream, gives an Empty value */
+        if (MsiRecordReadStream(This->msiHandle, field, buf, &size) != ERROR_SUCCESS)
+        {
+            V_VT(res) = VT_EMPTY;
+            hr = S_OK;
+        }
+        else if (format == 0)
+        {
+            LONG value = 0;
+
+            memcpy(&value, buf, size);
+            hr = r_long(res, value);
+        }
+#ifndef SG_MUTANT_AUT_READSTREAM
+        else if (format == 2)
+#else
+        else if (format == 9)
+#endif
+        {
+            int len = MultiByteToWideChar(CP_ACP, 0, buf, size, NULL, 0);
+            WCHAR *wide = malloc((len + 1) * sizeof(WCHAR));
+
+            if (!wide) hr = E_OUTOFMEMORY;
+            else
+            {
+                MultiByteToWideChar(CP_ACP, 0, buf, size, wide, len);
+                V_VT(res) = VT_BSTR;
+                V_BSTR(res) = SysAllocStringLen(wide, len);
+                hr = V_BSTR(res) ? S_OK : E_OUTOFMEMORY;
+                free(wide);
+            }
+        }
+        else if (format == 1)
+        {
+            DWORD i;
+            WCHAR *wide = malloc((size + 1) * sizeof(WCHAR));
+
+            if (!wide) hr = E_OUTOFMEMORY;
+            else
+            {
+                for (i = 0; i < size; i++) wide[i] = (unsigned char)buf[i];
+                V_VT(res) = VT_BSTR;
+                V_BSTR(res) = SysAllocStringLen(wide, size);
+                hr = V_BSTR(res) ? S_OK : E_OUTOFMEMORY;
+                free(wide);
+            }
+        }
+        else /* the byte pairs are the characters of the string */
+        {
+            V_VT(res) = VT_BSTR;
+            V_BSTR(res) = SysAllocStringByteLen(buf, size);
+            hr = V_BSTR(res) ? S_OK : E_OUTOFMEMORY;
+        }
+        free(buf);
+        break;
+    }
+
+    case DISPID_RECORD_SETSTREAM:
+        if (!(wFlags & DISPATCH_METHOD)) hr = DISP_E_MEMBERNOTFOUND;
+        else if (SUCCEEDED(hr = a_long(&a, 0, &field)) && SUCCEEDED(hr = a_str(&a, 1, &path)))
+            hr = ex(MsiRecordSetStreamW(This->msiHandle, field, path));
+        break;
+
+    default:
+        hr = DISP_E_MEMBERNOTFOUND;
+    }
+    args_clear(&a);
+    return hr;
+}
