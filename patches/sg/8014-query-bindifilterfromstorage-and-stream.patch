From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] query: BindIFilterFromStorage and BindIFilterFromStream

Spec stubs before (Anki imports them). The filter is found the way LoadIFilter finds a file's: the persistent handler of the object's class (STATSTG clsid, HKCR\CLSID\{clsid}\PersistentHandler) or else of the extension of its name (a storage or stream on a file is named after it), that handler's IFilter add-in is created and reads the object through IPersistStorage / IPersistStream; *ppIUnk is the IFilter (the inner IUnknown when aggregated). E_FAIL when nothing is registered, E_INVALIDARG for missing arguments.
---
--- a/include/ntquery.h
+++ b/include/ntquery.h
@@ -51,6 +51,8 @@
 STDAPI LocateCatalogsA(CHAR const *, ULONG, CHAR *, ULONG *, CHAR *, ULONG *);
 STDAPI LocateCatalogsW(WCHAR const *, ULONG, WCHAR *, ULONG *, WCHAR *, ULONG *);
 #define LocateCatalogs WINELIB_NAME_AW(LocateCatalogs)
+STDAPI BindIFilterFromStorage(IStorage *, IUnknown *, void **);
+STDAPI BindIFilterFromStream(IStream *, IUnknown *, void **);
 STDAPI LoadIFilter(WCHAR const *, IUnknown *, void **);
 
 #ifdef __cplusplus
--- a/dlls/query/query_main.c
+++ b/dlls/query/query_main.c
@@ -180,3 +180,130 @@
     *ppIUnk = unk;
     return S_OK;
 }
+
+/* Stained Glass OS (wine-sg 8014): BindIFilterFromStorage and BindIFilterFromStream, which LoadIFilter's
+ * lookup serves for an open storage or stream: the persistent handler of the object's class (its
+ * STATSTG CLSID, HKCR\CLSID\{clsid}\PersistentHandler), or else of the extension of its name (a storage
+ * or stream opened on a file is named after the file); the filter then reads the object through
+ * IPersistStorage / IPersistStream. *ppIUnk is the IFilter, or the inner IUnknown when aggregated. */
+DEFINE_GUID(sg_IID_IFilter, 0x89bcb740, 0x6119, 0x101a, 0xbc, 0xb7, 0x00, 0xdd, 0x01, 0x06, 0x55, 0xaf);
+
+static HRESULT filter_from_stat(const STATSTG *st, IUnknown *outer, IUnknown **unk)
+{
+    static const WCHAR filter_addin[] = L"PersistentAddinsRegistered\\{89BCB740-6119-101A-BCB7-00DD010655AF}";
+    WCHAR handler[64], filter_clsid[64], key[MAX_PATH], progid[MAX_PATH];
+    const WCHAR *ext = NULL, *p;
+    BOOL found = FALSE;
+    CLSID clsid;
+    HRESULT hr;
+
+    if (!IsEqualCLSID(&st->clsid, &CLSID_NULL))
+    {
+        StringFromGUID2(&st->clsid, handler, ARRAY_SIZE(handler));
+        swprintf(key, ARRAY_SIZE(key), L"CLSID\\%ls", handler);
+        found = query_class_value(key, L"PersistentHandler", handler, ARRAY_SIZE(handler));
+    }
+    if (!found && st->pwcsName)
+    {
+        for (p = st->pwcsName; *p; p++)
+        {
+            if (*p == '\\' || *p == '/') ext = NULL;
+            else if (*p == '.') ext = p;
+        }
+        if (ext && ext[1])
+        {
+            found = query_class_value(ext, L"PersistentHandler", handler, ARRAY_SIZE(handler));
+            if (!found && query_class_value(ext, NULL, progid, ARRAY_SIZE(progid)))
+                found = query_class_value(progid, L"PersistentHandler", handler, ARRAY_SIZE(handler));
+        }
+    }
+#ifdef SG_MUTANT_NO_BINDIFILTER
+    found = FALSE;
+#endif
+    if (!found) return E_FAIL;
+
+    swprintf(key, ARRAY_SIZE(key), L"CLSID\\%ls", handler);
+    if (!query_class_value(key, filter_addin, filter_clsid, ARRAY_SIZE(filter_clsid))) return E_FAIL;
+    if (FAILED(CLSIDFromString(filter_clsid, &clsid))) return E_FAIL;
+    if (FAILED(hr = CoCreateInstance(&clsid, outer, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)unk)))
+    {
+        WARN("could not create the filter %s: %#lx\n", debugstr_w(filter_clsid), hr);
+        return hr == E_OUTOFMEMORY ? hr : E_FAIL;
+    }
+    return S_OK;
+}
+
+static HRESULT bind_result(IUnknown *unk, IUnknown *outer, HRESULT load_hr, void **ppIUnk)
+{
+    HRESULT hr;
+
+    if (FAILED(load_hr))
+    {
+        IUnknown_Release(unk);
+        return load_hr == E_ACCESSDENIED || load_hr == E_OUTOFMEMORY ? load_hr : E_FAIL;
+    }
+    if (outer)
+    {
+        *ppIUnk = unk;
+        return S_OK;
+    }
+    hr = IUnknown_QueryInterface(unk, &sg_IID_IFilter, ppIUnk);
+    IUnknown_Release(unk);
+    return SUCCEEDED(hr) ? S_OK : E_FAIL;
+}
+
+/***********************************************************************
+ *             BindIFilterFromStorage (QUERY.@)
+ */
+HRESULT WINAPI BindIFilterFromStorage(IStorage *stg, IUnknown *outer, void **ppIUnk)
+{
+    IPersistStorage *persist;
+    IUnknown *unk;
+    STATSTG st;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", stg, outer, ppIUnk);
+
+    if (!ppIUnk) return E_INVALIDARG;
+    *ppIUnk = NULL;
+    if (!stg) return E_INVALIDARG;
+    memset(&st, 0, sizeof(st));
+    if (FAILED(hr = IStorage_Stat(stg, &st, STATFLAG_DEFAULT))) return hr == E_ACCESSDENIED ? hr : E_FAIL;
+    hr = filter_from_stat(&st, outer, &unk);
+    CoTaskMemFree(st.pwcsName);
+    if (FAILED(hr)) return hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface(unk, &IID_IPersistStorage, (void **)&persist)))
+        return bind_result(unk, outer, E_FAIL, ppIUnk);
+    hr = IPersistStorage_Load(persist, stg);
+    IPersistStorage_Release(persist);
+    return bind_result(unk, outer, hr, ppIUnk);
+}
+
+/***********************************************************************
+ *             BindIFilterFromStream (QUERY.@)
+ */
+HRESULT WINAPI BindIFilterFromStream(IStream *stm, IUnknown *outer, void **ppIUnk)
+{
+    IPersistStream *persist;
+    IUnknown *unk;
+    STATSTG st;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", stm, outer, ppIUnk);
+
+    if (!ppIUnk) return E_INVALIDARG;
+    *ppIUnk = NULL;
+    if (!stm) return E_INVALIDARG;
+    memset(&st, 0, sizeof(st));
+    if (FAILED(hr = IStream_Stat(stm, &st, STATFLAG_DEFAULT))) return hr == E_ACCESSDENIED ? hr : E_FAIL;
+    hr = filter_from_stat(&st, outer, &unk);
+    CoTaskMemFree(st.pwcsName);
+    if (FAILED(hr)) return hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface(unk, &IID_IPersistStream, (void **)&persist)))
+        return bind_result(unk, outer, E_FAIL, ppIUnk);
+    hr = IPersistStream_Load(persist, stm);
+    IPersistStream_Release(persist);
+    return bind_result(unk, outer, hr, ppIUnk);
+}
--- a/dlls/query/query.spec
+++ b/dlls/query/query.spec
@@ -1,7 +1,7 @@
 @ stub _AbortMerges@16
 @ stub BeginCacheTransaction
-@ stub BindIFilterFromStorage
-@ stub BindIFilterFromStream
+@ stdcall BindIFilterFromStorage(ptr ptr ptr)
+@ stdcall BindIFilterFromStream(ptr ptr ptr)
 @ stub CIBuildQueryNode
 @ stub CIBuildQueryTree
 @ stub CICreateCommand
