From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: a mixed-mode (C++/CLI) DLL stays loaded until the process ends.

As the CLR does, a DLL with native code and a CLR header (not IL-only) is pinned when _CorDllMain attaches it: its native code and data are the process's, whichever application domain loaded it. Wine Mono freed it when that domain unloaded, so its native DllMain ran inside the loader lock on the runtime's unloading thread; OpenOffice's CLI-UNO bridge (cli_uno.dll) deadlocked there and AppDomain.Unload never returned.
---
--- a/dlls/mscoree/assembly.c
+++ b/dlls/mscoree/assembly.c
@@ -300,6 +300,12 @@
     return S_OK;
 }
 
+/* Stained Glass OS (wine-sg 9452): the image has native code too (C++/CLI) */
+BOOL assembly_is_mixed_mode(ASSEMBLY *assembly)
+{
+    return !(assembly->corhdr->Flags & COMIMAGE_FLAGS_ILONLY);
+}
+
 HRESULT assembly_get_native_entrypoint(ASSEMBLY *assembly, NativeEntryPointFunc *func)
 {
     if (assembly->corhdr->Flags & COMIMAGE_FLAGS_NATIVE_ENTRYPOINT)
--- a/dlls/mscoree/corruntimehost.c
+++ b/dlls/mscoree/corruntimehost.c
@@ -2544,9 +2544,20 @@
         assembly_get_native_entrypoint(assembly, &NativeEntryPoint);
         if (fdwReason == DLL_PROCESS_ATTACH)
         {
+            HMODULE pinned;
+
             if (!NativeEntryPoint)
                 DisableThreadLibraryCalls(hinstDLL);
             FixupVTable_Assembly(hinstDLL,assembly);
+            /* Stained Glass OS (wine-sg 9452): as the CLR does, a mixed-mode (C++/CLI) DLL stays loaded
+             * until the process ends: its native code and data are the process's, whichever application
+             * domain loaded it. The runtime frees it when that domain unloads; its native DllMain then
+             * ran inside the loader lock in the unloading thread and deadlocked against the runtime. */
+#ifndef SG_MUTANT_MSCOREE_NO_PIN
+            if (assembly_is_mixed_mode(assembly))
+                GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                                   (const WCHAR *)hinstDLL, &pinned);
+#endif
         }
         assembly_release(assembly);
         /* FIXME: clean up the vtables on DLL_PROCESS_DETACH */
--- a/dlls/mscoree/mscoree_private.h
+++ b/dlls/mscoree/mscoree_private.h
@@ -44,6 +44,7 @@
 extern HRESULT assembly_get_runtime_version(ASSEMBLY *assembly, LPSTR *version);
 extern HRESULT assembly_get_vtable_fixups(ASSEMBLY *assembly, VTableFixup **fixups, DWORD *count);
 extern HRESULT assembly_get_native_entrypoint(ASSEMBLY *assembly, NativeEntryPointFunc *func);
+extern BOOL assembly_is_mixed_mode(ASSEMBLY *assembly);
 
 #define WINE_MONO_VERSION "9.4.0"
 
