+/* Stained Glass OS: make sure a user's HKEY_CURRENT_USER hive exists.
+ *
+ * init_registry() below loads exactly one user hive, for one SID, at server
+ * startup -- upstream's own FIXME there says as much. That is fine when a
+ * prefix has one user and wrong as soon as it has two: with a SID per uid,
+ * every user but the first finds \\Registry\\User\\<their SID> missing and
+ * every HKCU operation fails with OBJECT_NAME_NOT_FOUND.
+ *
+ * So per-uid SIDs and per-user hives are not independent changes: doing the
+ * first without the second breaks HKCU for everyone.
+ *
+ * Hives are created on demand, when a process belonging to that user first
+ * appears, and saved to user-<uid>.reg beside system.reg.
+ */
+static uid_t sg_loaded_uids[SG_MAX_USER_HIVES];
+static unsigned int sg_loaded_uid_count;
+
+void sg_ensure_user_hive( uid_t uid )
+{
+    const struct sid *sid;
+    struct unicode_str path;
+    WCHAR *path_str;
+    struct key *key;
+    char *filename;
+    unsigned int i;
+
+    if (!sg_system_prefix || !root_key) return;
+
+    /* Track what we have loaded explicitly rather than probing the registry.
+     * Each load registers a save branch, and there is a hard limit on those --
+     * getting the "already loaded" test wrong does not merely reload, it
+     * trips an assertion in load_init_registry_from_file() once enough
+     * processes have started. */
+    for (i = 0; i < sg_loaded_uid_count; i++)
+        if (sg_loaded_uids[i] == uid) return;
+    if (sg_loaded_uid_count >= ARRAY_SIZE(sg_loaded_uids)) return;
+
+    sid = security_unix_uid_to_sid( uid );
+    if (!(path_str = format_user_registry_path( sid, &path ))) return;
+
+    if ((key = open_key( root_key, &path, 0, 0 )))   /* already there */
+    {
+        release_object( key );
+        free( path_str );
+        sg_loaded_uids[sg_loaded_uid_count++] = uid;
+        return;
+    }
