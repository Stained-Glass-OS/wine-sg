+/* Stained Glass OS: a SID per Unix uid, for shared prefixes.
+ *
+ * Upstream's mapping below is binary -- you, or Anonymous Logon -- which is
+ * correct when a prefix has exactly one user and useless when it has several:
+ * every user would land on the same SID, so HKCU could not be separated and no
+ * security descriptor could tell them apart.
+ *
+ * local_user_sid is S-1-5-21-0-0-0-1000. We keep that shape and vary the RID
+ * with the uid, which is the same convention Windows and Samba use for local
+ * accounts. The returned pointer must outlive the call, so entries are cached
+ * rather than returned from the stack.
+ *
+ * Note this deliberately does NOT consult /etc/passwd or winbind. Mapping to
+ * *domain* SIDs is a separate job with a separate failure mode (the lookup can
+ * block or fail), and belongs outside the server.
+ */
+struct sg_uid_sid
+{
+    struct list entry;
+    uid_t       uid;
+    struct sid  sid;
+};
+static struct list sg_uid_sids = LIST_INIT( sg_uid_sids );
+
+static const struct sid *sg_sid_for_uid( uid_t uid )
+{
+    struct sg_uid_sid *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, &sg_uid_sids, struct sg_uid_sid, entry )
+        if (entry->uid == uid) return &entry->sid;
+
+    if (!(entry = mem_alloc( sizeof(*entry) ))) return &anonymous_logon_sid;
+    entry->uid = uid;
+    entry->sid = local_user_sid;
+    entry->sid.sub_auth[4] = 1000 + uid;
+    list_add_tail( &sg_uid_sids, &entry->entry );
+    return &entry->sid;
+}
+
 const struct sid *security_unix_uid_to_sid( uid_t uid )
 {
+    if (sg_system_prefix) return sg_sid_for_uid( uid );
+
     /* very simple mapping: either the current user or not the current user */
     if (uid == getuid())
         return &local_user_sid;
@@ -739,6 +784,46 @@
     return (struct token *)get_handle_obj( process, handle, access, &token_ops );
 }
 
+/* Stained Glass OS: the default DACL for a shared prefix.
+ *
+ * Upstream's create_default_dacl() grants its argument GENERIC_ALL, and
+ * token_create_admin() passes Domain Users -- so by default every object is
+ * writable by everyone, which is why nothing in the registry is protected
+ * today.
+ *
+ * Naming the creating user instead protects HKLM keys and breaks it: a key
+ * written by one user becomes invisible to the next, and HKLM is meant to be
+ * the machine's shared state. Neither extreme is right, and the first attempt
+ * here made exactly that mistake -- clause 3 of the S2 gate started passing
+ * and clause 2 started failing.
+ *
+ * This is the arrangement Windows uses for HKLM: administrators and the system
+ * may write, everyone else may read. Per-user privacy is not this descriptor's
+ * job -- HKCU gets that from being a separate hive per user.
+ */
+static struct acl *sg_create_system_dacl(void)
+{
+    struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
+    struct ace *ace;
+    struct acl *dacl;
+    size_t size = sizeof(*dacl) + 3 * sizeof(*ace) +
+                  sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) +
+                  sid_len( &domain_users_sid );
+
+    if (!(dacl = mem_alloc( size ))) return NULL;
+
+    dacl->revision = ACL_REVISION;
+    dacl->pad1     = 0;
+    dacl->size     = size;
+    dacl->count    = 3;
+    dacl->pad2     = 0;
+
+    ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    ace = set_ace( ace_next( ace ), &alias_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_ALL );
+    set_ace( ace_next( ace ), &domain_users_sid, ACCESS_ALLOWED_ACE_TYPE, 0, GENERIC_READ );
+    return dacl;
+}
