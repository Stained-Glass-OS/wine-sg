 static struct wine_rb_tree screen_buffer_map = { screen_buffer_compare_id };
 
+/* Stained Glass OS: the cells' true colours (rgb_fg, rgb_bg), kept beside
+ * their attributes wherever cells are written, moved or cleared. Claude Code
+ * draws in true colour; the 16 colours alone made it look off (David
+ * 2026-10-01, 2026-10-04). Without the arrays (no memory), none. */
+#ifndef SG_MUTANT_NO_TRUECOLOR
+static void rgb_alloc( struct screen_buffer *sb )
+{
+    size_t n = (size_t)sb->width * sb->height;
+    free( sb->rgb_fg ); free( sb->rgb_bg );
+    sb->rgb_fg = calloc( n, sizeof(*sb->rgb_fg) );
+    sb->rgb_bg = calloc( n, sizeof(*sb->rgb_bg) );
+    if (!sb->rgb_fg || !sb->rgb_bg) { free( sb->rgb_fg ); free( sb->rgb_bg ); sb->rgb_fg = sb->rgb_bg = NULL; }
+}
+#else
+static void rgb_alloc( struct screen_buffer *sb ) { sb->rgb_fg = sb->rgb_bg = NULL; }
+#endif
+
+static void rgb_clear( struct screen_buffer *sb, size_t at, size_t count, unsigned int bg )
+{
+    size_t i;
+    if (!sb->rgb_fg) return;
+    for (i = 0; i < count; i++) { sb->rgb_fg[at + i] = 0; sb->rgb_bg[at + i] = bg; }
+}
+
+static void rgb_move( struct screen_buffer *sb, size_t to, size_t from, size_t count )
+{
+    if (!sb->rgb_fg) return;
+    memmove( sb->rgb_fg + to, sb->rgb_fg + from, count * sizeof(*sb->rgb_fg) );
+    memmove( sb->rgb_bg + to, sb->rgb_bg + from, count * sizeof(*sb->rgb_bg) );
+}
+
+static void rgb_cell( const struct screen_buffer *sb, size_t at, unsigned int *fg, unsigned int *bg )
+{
+    *fg = sb->rgb_fg ? sb->rgb_fg[at] : 0;
+    *bg = sb->rgb_bg ? sb->rgb_bg[at] : 0;
+}
