+/* the 256-colour palette's colour n (16-255) as 0x01RRGGBB */
+static unsigned int vt_256_rgb( unsigned int n )
+{
+    static const unsigned char level[6] = { 0, 95, 135, 175, 215, 255 };
+    unsigned int r, g, b;
+    if (n < 232) { n -= 16; r = level[n / 36]; g = level[(n / 6) % 6]; b = level[n % 6]; }
+    else r = g = b = 8 + (n - 232) * 10;
+    return 0x01000000 | (r << 16) | (g << 8) | b;
+}
