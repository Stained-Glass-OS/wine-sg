+/* Stained Glass OS: a cell's true colours to the tty, after its attribute's:
+ * 38;2 / 48;2 for them, its attribute's colour again where it has none */
+static void set_tty_rgb( struct console *console, unsigned int attr, unsigned int fg, unsigned int bg )
+{
+    char buf[48];
+    if (fg != console->tty_fg)
+    {
+        if (fg) sprintf( buf, "\x1b[38;2;%u;%u;%um", (fg >> 16) & 0xff, (fg >> 8) & 0xff, fg & 0xff );
+        else
+        {
+            unsigned int n = 30;
+            if ((attr & 0x0f) == 7) n = 39;
+            else
+            {
+                if (attr & FOREGROUND_BLUE)  n += 4;
+                if (attr & FOREGROUND_GREEN) n += 2;
+                if (attr & FOREGROUND_RED)   n += 1;
+                if (attr & FOREGROUND_INTENSITY) n += 60;
+            }
+            sprintf( buf, "\x1b[%um", n );
+        }
+        tty_write( console, buf, strlen(buf) );
+        console->tty_fg = fg;
+    }
+    if (bg != console->tty_bg)
+    {
+        if (bg) sprintf( buf, "\x1b[48;2;%u;%u;%um", (bg >> 16) & 0xff, (bg >> 8) & 0xff, bg & 0xff );
+        else
+        {
+            unsigned int n = 40;
+            if (!(attr & 0xf0)) n = 49;
+            else
+            {
+                if (attr & BACKGROUND_BLUE)  n += 4;
+                if (attr & BACKGROUND_GREEN) n += 2;
+                if (attr & BACKGROUND_RED)   n += 1;
+                if (attr & BACKGROUND_INTENSITY) n += 60;
+            }
+            sprintf( buf, "\x1b[%um", n );
+        }
+        tty_write( console, buf, strlen(buf) );
+        console->tty_bg = bg;
+    }
+}
