+/*
+ * A component's events: the connection point of its event dispinterface (whose type is made from
+ * the <event> elements when asked for), and fireEvent, which calls the connected sinks.
+ */
+static HRESULT component_class_typeinfo(struct scriptlet_factory *factory, ITypeInfo **ret);
+
+static void factory_events_iid(struct scriptlet_factory *factory, GUID *iid)
+{
+    if (!factory->have_events_iid)
+    {
+        CoCreateGuid(&factory->events_iid);
+        factory->have_events_iid = TRUE;
+    }
+    *iid = factory->events_iid;
+}
+
+static void fire_component_event(struct scriptlet_instance *This, const WCHAR *name)
+{
+    struct scriptlet_event *event;
+    DISPPARAMS params = {0};
+    DISPID id = 0, i = 0;
+    DWORD n;
+
+    LIST_FOR_EACH_ENTRY(event, &This->factory->events, struct scriptlet_event, entry)
+    {
+        i++;
+        if (!wcsicmp(event->name, name)) { id = i; break; }
+    }
+    if (!id) return;
+#ifdef SG_MUTANT_SCROBJ_NO_FIRE
+    return;
+#endif
+
+    IDispatchEx_AddRef(&This->IDispatchEx_iface);
+    for (n = 0; n < This->sink_count; n++)
+    {
+        IDispatch *sink = This->sinks[n];
+        if (!sink) continue;
+        IDispatch_AddRef(sink);
+        IDispatch_Invoke(sink, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &params, NULL, NULL, NULL);
+        IDispatch_Release(sink);
+    }
+    IDispatchEx_Release(&This->IDispatchEx_iface);
+}
+
+static inline struct scriptlet_instance *impl_from_instance_IConnectionPointContainer(IConnectionPointContainer *iface)
+{
+    return CONTAINING_RECORD(iface, struct scriptlet_instance, IConnectionPointContainer_iface);
