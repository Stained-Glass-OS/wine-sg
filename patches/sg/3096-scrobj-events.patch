+/* the interface of a component's events: one method for each, as they have no parameters */
+static HRESULT typelib_add_events(ICreateTypeLib2 *lib, struct scriptlet_factory *factory, const WCHAR *class_name,
+        ITypeInfo **ret)
+{
+    struct scriptlet_event *event;
+    ICreateTypeInfo *cti;
+    WCHAR name[128];
+    unsigned index = 0;
+    GUID guid;
+    HRESULT hr;
+
+    swprintf(name, ARRAY_SIZE(name), L"_I%sEvents", class_name);
+    if (FAILED(hr = ICreateTypeLib2_CreateTypeInfo(lib, name, TKIND_DISPATCH, &cti))) return hr;
+    factory_events_iid(factory, &guid);
+    ICreateTypeInfo_SetGuid(cti, &guid);
+    ICreateTypeInfo_SetTypeFlags(cti, TYPEFLAG_FDISPATCHABLE);
+
+    LIST_FOR_EACH_ENTRY(event, &factory->events, struct scriptlet_event, entry)
+    {
+        WCHAR *names[1] = { event->name };
+        FUNCDESC fd;
+
+        memset(&fd, 0, sizeof(fd));
+        fd.memid = index + 1;
+        fd.funckind = FUNC_DISPATCH;
+        fd.invkind = INVOKE_FUNC;
+        fd.callconv = CC_STDCALL;
+        fd.elemdescFunc.tdesc.vt = VT_VOID;
+        hr = ICreateTypeInfo_AddFuncDesc(cti, index, &fd);
+        if (SUCCEEDED(hr)) hr = ICreateTypeInfo_SetFuncAndParamNames(cti, index, names, 1);
+        if (FAILED(hr))
+        {
+            WARN("event %s: %#lx\n", debugstr_w(event->name), hr);
+            goto fail;
+        }
+        index++;
+    }
+
+    hr = ICreateTypeInfo_QueryInterface(cti, &IID_ITypeInfo, (void **)ret);
+fail:
+    ICreateTypeInfo_Release(cti);
+    return hr;
+}
