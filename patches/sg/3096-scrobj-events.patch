+/* the component's class as a type library has it, made when first asked for in a file of its own */
+static HRESULT component_class_typeinfo(struct scriptlet_factory *factory, ITypeInfo **ret)
+{
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    ICreateTypeLib2 *lib;
+    ITypeLib *tl = NULL;
+    GUID guid;
+    UINT i, count;
+    HRESULT hr;
+
+    if (factory->class_info)
+    {
+        ITypeInfo_AddRef((*ret = factory->class_info));
+        return S_OK;
+    }
+
+    if (!GetTempPathW(ARRAY_SIZE(dir), dir) || !GetTempFileNameW(dir, L"wsc", 0, path)) return E_FAIL;
+    if (FAILED(hr = CreateTypeLib2(SYS_WIN32, path, &lib)))
+    {
+        DeleteFileW(path);
+        return hr;
+    }
+    CoCreateGuid(&guid);
+    ICreateTypeLib2_SetGuid(lib, &guid);
+    ICreateTypeLib2_SetLcid(lib, 0);
+    { WCHAR lib_name[] = L"ScriptletComponent"; ICreateTypeLib2_SetName(lib, lib_name); }
+    hr = typelib_add_class(lib, factory, NULL);
+    if (SUCCEEDED(hr)) hr = ICreateTypeLib2_SaveAllChanges(lib);
+    ICreateTypeLib2_Release(lib);
+    if (SUCCEEDED(hr)) hr = LoadTypeLibEx(path, REGKIND_NONE, &tl);
+    DeleteFileW(path);
+    if (FAILED(hr)) return hr;
+
+    count = ITypeLib_GetTypeInfoCount(tl);
+    for (i = 0; i < count; i++)
+    {
+        TYPEKIND kind;
+        if (SUCCEEDED(ITypeLib_GetTypeInfoType(tl, i, &kind)) && kind == TKIND_COCLASS)
+        {
+            if (SUCCEEDED(hr = ITypeLib_GetTypeInfo(tl, i, &factory->class_info))) break;
+        }
+    }
+    if (!factory->class_info)
+    {
+        ITypeLib_Release(tl);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    factory->class_lib = tl;
+    ITypeInfo_AddRef((*ret = factory->class_info));
+    return S_OK;
+}
