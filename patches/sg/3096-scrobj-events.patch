+
+static HRESULT WINAPI instance_cp_Advise(IConnectionPoint *iface, IUnknown *unk, DWORD *cookie)
+{
+    struct scriptlet_instance *This = impl_from_instance_IConnectionPoint(iface);
+    IDispatch *sink;
+    GUID iid;
+    DWORD i;
+
+    TRACE("(%p)->(%p %p)\n", This, unk, cookie);
+
+    if (!unk || !cookie) return E_POINTER;
+    factory_events_iid(This->factory, &iid);
+    if (FAILED(IUnknown_QueryInterface(unk, &iid, (void **)&sink)) &&
+        FAILED(IUnknown_QueryInterface(unk, &IID_IDispatch, (void **)&sink)))
+        return CONNECT_E_CANNOTCONNECT;
+
+    for (i = 0; i < This->sink_count; i++) if (!This->sinks[i]) break;
+    if (i == This->sink_count)
+    {
+        IDispatch **new_sinks = realloc(This->sinks, (i + 4) * sizeof(*new_sinks));
+        if (!new_sinks)
+        {
+            IDispatch_Release(sink);
+            return E_OUTOFMEMORY;
+        }
+        memset(new_sinks + i, 0, 4 * sizeof(*new_sinks));
+        This->sinks = new_sinks;
+        This->sink_count = i + 4;
+    }
+    This->sinks[i] = sink;
+    *cookie = i + 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI instance_cp_Unadvise(IConnectionPoint *iface, DWORD cookie)
+{
+    struct scriptlet_instance *This = impl_from_instance_IConnectionPoint(iface);
+
+    TRACE("(%p)->(%lu)\n", This, cookie);
+
+    if (!cookie || cookie > This->sink_count || !This->sinks[cookie - 1]) return CONNECT_E_NOCONNECTION;
+    IDispatch_Release(This->sinks[cookie - 1]);
+    This->sinks[cookie - 1] = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI instance_cp_EnumConnections(IConnectionPoint *iface, IEnumConnections **ret)
