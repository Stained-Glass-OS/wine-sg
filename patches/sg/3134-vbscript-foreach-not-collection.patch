From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:57:04 -0700
Subject: [PATCH] vbscript: For Each over a non-collection is error 451

A For Each over Empty, a number or a string raises "Object not a collection"
(451) instead of E_NOTIMPL, and the resumed enumeration step after such an
error raises it again instead of E_FAIL. The matching todo marks of error.vbs
are removed.

diff --git a/dlls/vbscript/interp.c b/dlls/vbscript/interp.c
index 2467002..5eb740c 100644
--- a/dlls/vbscript/interp.c
+++ b/dlls/vbscript/interp.c
@@ -1600,9 +1600,13 @@ static HRESULT interp_newenum(exec_ctx_t *ctx)
         break;
     }
     default:
-        FIXME("Unsupported for %s\n", debugstr_variant(v.v));
+        /* not a collection: Object not a collection (451) */
+        TRACE("Unsupported for %s\n", debugstr_variant(v.v));
         release_val(&v);
+#ifdef SG_MUTANT_VB_NOTENUM
         return E_NOTIMPL;
+#endif
+        return MAKE_VBSERROR(VBSE_NOT_ENUM);
     }
 
     return S_OK;
@@ -1621,8 +1625,12 @@ static HRESULT interp_enumnext(exec_ctx_t *ctx)
     TRACE("\n");
 
     if(V_VT(stack_top(ctx, 0)) == VT_EMPTY) {
-        FIXME("uninitialized\n");
+        /* the enumerator could not be created: resumed after an error */
+        TRACE("uninitialized\n");
+#ifdef SG_MUTANT_VB_NOTENUM
         return E_FAIL;
+#endif
+        return MAKE_VBSERROR(VBSE_NOT_ENUM);
     }
 
     assert(V_VT(stack_top(ctx, 0)) == VT_UNKNOWN);
diff --git a/dlls/vbscript/tests/error.vbs b/dlls/vbscript/tests/error.vbs
index 9b74dc8..8092843 100644
--- a/dlls/vbscript/tests/error.vbs
+++ b/dlls/vbscript/tests/error.vbs
@@ -197,7 +197,7 @@ sub testThrow
     next
     call ok(x = 2, "x = " & x)
     call ok(y = 1, "y = " & y)
-    call todo_wine_ok(Err.Number = VB_E_OBJNOTCOLLECTION, "Err.Number = " & Err.Number)
+    call ok(Err.Number = VB_E_OBJNOTCOLLECTION, "Err.Number = " & Err.Number)
 
     Err.clear()
     y = 0
@@ -318,7 +318,7 @@ sub testForEachError()
     z = true
     call ok(y, "for each not executed")
     call ok(z, "line after next not executed")
-    call todo_wine_ok(Err.Number = VB_E_OBJNOTCOLLECTION, "Err.Number = " & Err.Number)
+    call ok(Err.Number = VB_E_OBJNOTCOLLECTION, "Err.Number = " & Err.Number)
 end sub
 
 call testForEachError()
