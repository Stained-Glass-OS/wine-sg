From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u, dxgi: a display says it is an 8-bit sRGB SDR display

DisplayConfigGetDeviceInfo answered DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO
and ..._GET_SDR_WHITE_LEVEL with ERROR_INVALID_PARAMETER, and
IDXGIOutput6::GetDesc1 reported 0 bits per colour, zero primaries and zero
luminance. Programs that choose between SDR and HDR/advanced-colour paths
from these (Chromium, OBS, Paint.NET, games) got nonsense. Now: advanced
colour not supported or enabled, RGB, 8 bits per channel, SDR white level
1000 (80 nits), for a target that exists; GetDesc1 gives 8 bits, the sRGB
primaries and D65 white point, and a nominal 0.5-270 nit range.

Gate: test/advcolor-gate.sh (make test-advcolor; stock fails 3 of 6).
---
--- a/dlls/dxgi/output.c
+++ b/dlls/dxgi/output.c
@@ -627,7 +627,7 @@
     struct wined3d_display_mode mode;
     HRESULT hr;
 
-    FIXME("iface %p, desc %p semi-stub!\n", iface, desc);
+    TRACE("iface %p, desc %p.\n", iface, desc);
 
     if (!desc)
         return E_INVALIDARG;
@@ -662,20 +662,20 @@
     desc->Rotation = dxgi_mode_rotation_from_wined3d(rotation);
     desc->Monitor = wined3d_desc.monitor;
 
-    /* FIXME: fill this from monitor EDID */
-    desc->BitsPerColor = 0;
+    /* An SDR sRGB display, as one without EDID colour data is described. */
+    desc->BitsPerColor = 8;
     desc->ColorSpace = DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709;
-    desc->RedPrimary[0] = 0.f;
-    desc->RedPrimary[1] = 0.f;
-    desc->GreenPrimary[0] = 0.f;
-    desc->GreenPrimary[1] = 0.f;
-    desc->BluePrimary[0] = 0.f;
-    desc->BluePrimary[1] = 0.f;
-    desc->WhitePoint[0] = 0.f;
-    desc->WhitePoint[1] = 0.f;
-    desc->MinLuminance = 0.f;
-    desc->MaxLuminance = 0.f;
-    desc->MaxFullFrameLuminance = 0.f;
+    desc->RedPrimary[0] = 0.640f;
+    desc->RedPrimary[1] = 0.330f;
+    desc->GreenPrimary[0] = 0.300f;
+    desc->GreenPrimary[1] = 0.600f;
+    desc->BluePrimary[0] = 0.150f;
+    desc->BluePrimary[1] = 0.060f;
+    desc->WhitePoint[0] = 0.3127f;
+    desc->WhitePoint[1] = 0.3290f;
+    desc->MinLuminance = 0.5f;
+    desc->MaxLuminance = 270.0f;
+    desc->MaxFullFrameLuminance = 270.0f;
 
     return S_OK;
 }
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7429,13 +7429,48 @@
 
         return STATUS_NOT_SUPPORTED;
     }
+    case DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO:
+    case DISPLAYCONFIG_DEVICE_INFO_GET_SDR_WHITE_LEVEL:
+    {
+        /* Our displays are SDR: 8 bits per channel RGB, no advanced colour,
+         * SDR white at the default 80 nits (1000 = 80 nits). */
+        DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO *color_info = (DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO *)packet;
+        DISPLAYCONFIG_SDR_WHITE_LEVEL *white_level = (DISPLAYCONFIG_SDR_WHITE_LEVEL *)packet;
+        struct monitor *monitor;
+
+        TRACE( "packet type %u.\n", packet->type );
+
+        if (packet->type == DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO
+                ? packet->size < sizeof(*color_info) : packet->size < sizeof(*white_level))
+            return STATUS_INVALID_PARAMETER;
+
+        if (!lock_display_devices( FALSE )) return STATUS_UNSUCCESSFUL;
+
+        LIST_FOR_EACH_ENTRY(monitor, &monitors, struct monitor, entry)
+        {
+            if (packet->id != monitor->output_id) continue;
+            if (memcmp( &packet->adapterId, &monitor->source->gpu->luid, sizeof(monitor->source->gpu->luid) ))
+                continue;
+
+            if (packet->type == DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO)
+            {
+                color_info->value = 0;
+                color_info->colorEncoding = DISPLAYCONFIG_COLOR_ENCODING_RGB;
+                color_info->bitsPerColorChannel = 8;
+            }
+            else white_level->SDRWhiteLevel = 1000;
+            ret = STATUS_SUCCESS;
+            break;
+        }
+
+        unlock_display_devices();
+        return ret;
+    }
     case DISPLAYCONFIG_DEVICE_INFO_SET_TARGET_PERSISTENCE:
     case DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_BASE_TYPE:
     case DISPLAYCONFIG_DEVICE_INFO_GET_SUPPORT_VIRTUAL_RESOLUTION:
     case DISPLAYCONFIG_DEVICE_INFO_SET_SUPPORT_VIRTUAL_RESOLUTION:
-    case DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO:
     case DISPLAYCONFIG_DEVICE_INFO_SET_ADVANCED_COLOR_STATE:
-    case DISPLAYCONFIG_DEVICE_INFO_GET_SDR_WHITE_LEVEL:
     default:
         FIXME( "Unimplemented packet type %u.\n", packet->type );
         return STATUS_INVALID_PARAMETER;
