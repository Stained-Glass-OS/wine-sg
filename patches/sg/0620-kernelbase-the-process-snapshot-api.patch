+
+
+/* process snapshots: what is captured is the process's information (the
+ * PSS_QUERY_PROCESS_INFORMATION record); clones, handles, threads and the
+ * address space are not captured */
+#define PSS_SNAPSHOT_MAGIC 0x53535053 /* 'PSPS' */
+#define PSS_SUPPORTED_FLAGS (PSS_CREATE_BREAKAWAY_OPTIONAL | PSS_CREATE_BREAKAWAY | PSS_CREATE_FORCE_BREAKAWAY | \
+                             PSS_CREATE_USE_VM_ALLOCATIONS | PSS_CREATE_MEASURE_PERFORMANCE | PSS_CREATE_RELEASE_SECTION)
+
+struct pss_snapshot
+{
+    DWORD magic;
+    PSS_CAPTURE_FLAGS flags;
+    PSS_PROCESS_INFORMATION info;
+};
+
+struct pss_walk_marker
+{
+    ULONG_PTR position;
+    PSS_ALLOCATOR allocator;
+};
+
+static struct pss_snapshot *pss_snapshot( HPSS handle )
+{
+    struct pss_snapshot *snapshot = (struct pss_snapshot *)handle;
+    if (!snapshot || snapshot->magic != PSS_SNAPSHOT_MAGIC) return NULL;
+    return snapshot;
+}
+
+static BOOL pss_is_current_process( HANDLE process )
+{
+    return process == GetCurrentProcess() || GetProcessId( process ) == GetCurrentProcessId();
+}
+
+
+/***********************************************************************
+ *           PssCaptureSnapshot   (kernelbase.@)
+ */
+DWORD WINAPI PssCaptureSnapshot( HANDLE process, PSS_CAPTURE_FLAGS flags, DWORD context_flags, HPSS *ret )
+{
+    PROCESS_BASIC_INFORMATION basic;
+    VM_COUNTERS_EX vm;
+    struct pss_snapshot *snapshot;
+    DWORD size;
+    BOOL wow64;
+    NTSTATUS status;
+
+    TRACE( "%p %#x %#lx %p\n", process, flags, context_flags, ret );
+
+    if (!ret) return ERROR_INVALID_PARAMETER;
+    if (flags & ~PSS_SUPPORTED_FLAGS)
+    {
+        FIXME( "capture flags %#x not supported\n", flags & ~PSS_SUPPORTED_FLAGS );
+        return ERROR_NOT_SUPPORTED;
+    }
+    if ((status = NtQueryInformationProcess( process, ProcessBasicInformation, &basic, sizeof(basic), NULL )))
+        return RtlNtStatusToDosError( status );
+    if (!(snapshot = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*snapshot) )))
+        return ERROR_NOT_ENOUGH_MEMORY;
+
+    snapshot->magic = PSS_SNAPSHOT_MAGIC;
+    snapshot->flags = flags;
+    snapshot->info.ExitStatus = basic.ExitStatus;
+    snapshot->info.PebBaseAddress = basic.PebBaseAddress;
+    snapshot->info.AffinityMask = basic.AffinityMask;
+    snapshot->info.BasePriority = basic.BasePriority;
+    snapshot->info.ProcessId = basic.UniqueProcessId;
+    snapshot->info.ParentProcessId = basic.InheritedFromUniqueProcessId;
+    if (IsWow64Process( process, &wow64 ) && wow64) snapshot->info.Flags |= PSS_PROCESS_FLAGS_WOW64;
+    GetProcessTimes( process, &snapshot->info.CreateTime, &snapshot->info.ExitTime,
+                     &snapshot->info.KernelTime, &snapshot->info.UserTime );
+    snapshot->info.PriorityClass = GetPriorityClass( process );
+    if (!NtQueryInformationProcess( process, ProcessVmCounters, &vm, sizeof(vm), NULL ))
+    {
+        snapshot->info.PeakVirtualSize = vm.PeakVirtualSize;
+        snapshot->info.VirtualSize = vm.VirtualSize;
+        snapshot->info.PageFaultCount = vm.PageFaultCount;
+        snapshot->info.PeakWorkingSetSize = vm.PeakWorkingSetSize;
+        snapshot->info.WorkingSetSize = vm.WorkingSetSize;
+        snapshot->info.QuotaPeakPagedPoolUsage = vm.QuotaPeakPagedPoolUsage;
+        snapshot->info.QuotaPagedPoolUsage = vm.QuotaPagedPoolUsage;
+        snapshot->info.QuotaPeakNonPagedPoolUsage = vm.QuotaPeakNonPagedPoolUsage;
+        snapshot->info.QuotaNonPagedPoolUsage = vm.QuotaNonPagedPoolUsage;
+        snapshot->info.PagefileUsage = vm.PagefileUsage;
+        snapshot->info.PeakPagefileUsage = vm.PeakPagefileUsage;
+        snapshot->info.PrivateUsage = vm.PrivateUsage;
+    }
+    if (pss_is_current_process( process ))
+        NtQueryInformationProcess( process, ProcessExecuteFlags, &snapshot->info.ExecuteFlags,
+                                   sizeof(snapshot->info.ExecuteFlags), NULL );
+    size = ARRAY_SIZE(snapshot->info.ImageFileName);
+    if (!QueryFullProcessImageNameW( process, 0, snapshot->info.ImageFileName, &size ))
+        snapshot->info.ImageFileName[0] = 0;
+
+    *ret = (HPSS)snapshot;
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssQuerySnapshot   (kernelbase.@)
+ */
+DWORD WINAPI PssQuerySnapshot( HPSS handle, PSS_QUERY_INFORMATION_CLASS class, void *buffer, DWORD length )
+{
+    struct pss_snapshot *snapshot = pss_snapshot( handle );
+
+    TRACE( "%p %d %p %lu\n", handle, class, buffer, length );
+
+    if (!snapshot || !buffer) return ERROR_INVALID_PARAMETER;
+    switch (class)
+    {
+    case PSS_QUERY_PROCESS_INFORMATION:
+        if (length < sizeof(snapshot->info)) return ERROR_BAD_LENGTH;
+        memcpy( buffer, &snapshot->info, sizeof(snapshot->info) );
+        return ERROR_SUCCESS;
+    case PSS_QUERY_PERFORMANCE_COUNTERS:
+        if (!(snapshot->flags & PSS_CREATE_MEASURE_PERFORMANCE)) return ERROR_NOT_FOUND;
+        if (length < sizeof(PSS_PERFORMANCE_COUNTERS)) return ERROR_BAD_LENGTH;
+        memset( buffer, 0, sizeof(PSS_PERFORMANCE_COUNTERS) );
+        return ERROR_SUCCESS;
+    default:
+        return ERROR_NOT_FOUND;
+    }
+}
+
+
+/***********************************************************************
+ *           PssFreeSnapshot   (kernelbase.@)
+ */
+DWORD WINAPI PssFreeSnapshot( HANDLE process, HPSS handle )
+{
+    struct pss_snapshot *snapshot;
+
+    TRACE( "%p %p\n", process, handle );
+
+    if (!pss_is_current_process( process ))
+    {
+        FIXME( "snapshot in another process\n" );
+        return ERROR_NOT_SUPPORTED;
+    }
+    if (!(snapshot = pss_snapshot( handle ))) return ERROR_INVALID_HANDLE;
+    snapshot->magic = 0;
+    HeapFree( GetProcessHeap(), 0, snapshot );
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssDuplicateSnapshot   (kernelbase.@)
+ */
+DWORD WINAPI PssDuplicateSnapshot( HANDLE source_process, HPSS handle, HANDLE target_process,
+                                   HPSS *ret, PSS_DUPLICATE_FLAGS flags )
+{
+    struct pss_snapshot *snapshot, *copy;
+
+    TRACE( "%p %p %p %p %#x\n", source_process, handle, target_process, ret, flags );
+
+    if (!ret) return ERROR_INVALID_PARAMETER;
+    if (!pss_is_current_process( source_process ) || !pss_is_current_process( target_process ))
+    {
+        FIXME( "snapshot in another process\n" );
+        return ERROR_NOT_SUPPORTED;
+    }
+    if (!(snapshot = pss_snapshot( handle ))) return ERROR_INVALID_HANDLE;
+    if (flags & PSS_DUPLICATE_CLOSE_SOURCE)
+    {
+        *ret = handle;
+        return ERROR_SUCCESS;
+    }
+    if (!(copy = HeapAlloc( GetProcessHeap(), 0, sizeof(*copy) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    *copy = *snapshot;
+    *ret = (HPSS)copy;
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssWalkMarkerCreate   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerCreate( const PSS_ALLOCATOR *allocator, HPSSWALK *ret )
+{
+    struct pss_walk_marker *marker;
+
+    TRACE( "%p %p\n", allocator, ret );
+
+    if (!ret) return ERROR_INVALID_PARAMETER;
+    if (allocator && allocator->AllocRoutine)
+        marker = allocator->AllocRoutine( allocator->Context, sizeof(*marker) );
+    else
+        marker = HeapAlloc( GetProcessHeap(), 0, sizeof(*marker) );
+    if (!marker) return ERROR_NOT_ENOUGH_MEMORY;
+    marker->position = 0;
+    if (allocator) marker->allocator = *allocator;
+    else memset( &marker->allocator, 0, sizeof(marker->allocator) );
+    *ret = (HPSSWALK)marker;
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssWalkMarkerFree   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerFree( HPSSWALK handle )
+{
+    struct pss_walk_marker *marker = (struct pss_walk_marker *)handle;
+
+    TRACE( "%p\n", handle );
+
+    if (!marker) return ERROR_INVALID_HANDLE;
+    if (marker->allocator.AllocRoutine)
+    {
+        if (marker->allocator.FreeRoutine) marker->allocator.FreeRoutine( marker->allocator.Context, marker );
+    }
+    else HeapFree( GetProcessHeap(), 0, marker );
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssWalkMarkerGetPosition   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerGetPosition( HPSSWALK handle, ULONG_PTR *position )
+{
+    struct pss_walk_marker *marker = (struct pss_walk_marker *)handle;
+
+    if (!marker) return ERROR_INVALID_HANDLE;
+    if (!position) return ERROR_INVALID_PARAMETER;
+    *position = marker->position;
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssWalkMarkerSetPosition   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerSetPosition( HPSSWALK handle, ULONG_PTR position )
+{
+    struct pss_walk_marker *marker = (struct pss_walk_marker *)handle;
+
+    if (!marker) return ERROR_INVALID_HANDLE;
+    marker->position = position;
+    return ERROR_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           PssWalkMarkerSeekToBeginning   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerSeekToBeginning( HPSSWALK handle )
+{
+    return PssWalkMarkerSetPosition( handle, 0 );
+}
+
+
+/***********************************************************************
+ *           PssWalkSnapshot   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkSnapshot( HPSS handle, PSS_WALK_INFORMATION_CLASS class, HPSSWALK walk,
+                              void *buffer, DWORD length )
+{
+    TRACE( "%p %d %p %p %lu\n", handle, class, walk, buffer, length );
+
+    if (!pss_snapshot( handle ) || !walk) return ERROR_INVALID_PARAMETER;
+    /* nothing but the process's information is captured */
+    return ERROR_NO_MORE_ITEMS;
+}
