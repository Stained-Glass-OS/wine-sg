+    ULONG_PTR QuotaNonPagedPoolUsage;
+    ULONG_PTR PagefileUsage;
+    ULONG_PTR PeakPagefileUsage;
+    ULONG_PTR PrivateUsage;
+    DWORD ExecuteFlags;
