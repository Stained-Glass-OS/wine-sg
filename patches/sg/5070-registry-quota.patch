From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Report the registry's size as the quota used.

GetSystemRegistryQuota made up its own numbers (2 GB allowed, 100 MB used)
and SystemRegistryQuotaInformation others (32 MB, 2 MB). Both now report the
same: the quota used is the size of the registry, here the bytes of the
prefix's system.reg, user.reg and userdef.reg; the quota allowed stays 32 MB,
raised to the used size (rounded up to a megabyte) for a larger registry, as
the registry has no size limit here. GetSystemRegistryQuota asks ntdll.

Gate: test/kernel32-regquota-gate.sh (the gate passes the files' size).
---
 dlls/kernel32/kernel_main.c | 16 ++++++++++------
 dlls/ntdll/unix/system.c    | 35 ++++++++++++++++++++++-------------
 2 files changed, 32 insertions(+), 19 deletions(-)

diff --git a/dlls/kernel32/kernel_main.c b/dlls/kernel32/kernel_main.c
index d7301ae..13e9b40 100644
--- a/dlls/kernel32/kernel_main.c
+++ b/dlls/kernel32/kernel_main.c
@@ -206,13 +206,17 @@ INT WINAPI MulDiv( INT nMultiplicand, INT nMultiplier, INT nDivisor)
  */
 BOOL WINAPI GetSystemRegistryQuota(PDWORD pdwQuotaAllowed, PDWORD pdwQuotaUsed)
 {
-    FIXME("(%p, %p) faking reported quota values\n", pdwQuotaAllowed, pdwQuotaUsed);
+    SYSTEM_REGISTRY_QUOTA_INFORMATION info;
+    NTSTATUS status;
 
-    if (pdwQuotaAllowed)
-        *pdwQuotaAllowed = 2 * 1000 * 1000 * 1000; /* 2 GB */
-
-    if (pdwQuotaUsed)
-        *pdwQuotaUsed = 100 * 1000 * 1000; /* 100 MB */
+    TRACE("(%p, %p)\n", pdwQuotaAllowed, pdwQuotaUsed);
 
+    if ((status = NtQuerySystemInformation(SystemRegistryQuotaInformation, &info, sizeof(info), NULL)))
+    {
+        SetLastError(RtlNtStatusToDosError(status));
+        return FALSE;
+    }
+    if (pdwQuotaAllowed) *pdwQuotaAllowed = info.RegistryQuotaAllowed;
+    if (pdwQuotaUsed) *pdwQuotaUsed = info.RegistryQuotaUsed;
     return TRUE;
 }
diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index d3eb023..e0566a8 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -3657,26 +3657,35 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
 
     case SystemRegistryQuotaInformation:  /* 37 */
     {
-        /* Something to do with the size of the registry             *
-         * Since we don't have a size limitation, fake it            *
-         * This is almost certainly wrong.                           *
-         * This sets each of the three words in the struct to 32 MB, *
-         * which is enough to make the IE 5 installer happy.         */
+        /* the registry has no size limit here: the quota is a fixed 32 MB, raised to what
+         * is used when the registry is larger; what is used is the size of the registry
+         * files the server keeps in the prefix */
+        static const char * const files[] = { "system.reg", "user.reg", "userdef.reg" };
         SYSTEM_REGISTRY_QUOTA_INFORMATION srqi;
+        ULONGLONG used = 0;
+        unsigned int i;
+        struct stat st;
+        char *path;
 
-        srqi.RegistryQuotaAllowed = 0x2000000;
-        srqi.RegistryQuotaUsed = 0x200000;
-        srqi.Reserved1 = (void*)0x200000;
+        for (i = 0; i < ARRAY_SIZE(files); i++)
+        {
+            if (!(path = malloc( strlen( config_dir ) + strlen( files[i] ) + 2 ))) continue;
+            sprintf( path, "%s/%s", config_dir, files[i] );
+            if (!stat( path, &st )) used += st.st_size;
+            free( path );
+        }
+#ifdef SG_MUTANT_REGQUOTA_FIXED
+        used = 0x200000;
+#endif
+        srqi.RegistryQuotaUsed = min( used, 0xffffffff );
+        srqi.RegistryQuotaAllowed = max( 0x2000000, (srqi.RegistryQuotaUsed + 0xfffff) & ~0xfffff );
+        srqi.Reserved1 = (void *)0x200000;
         len = sizeof(srqi);
 
         if (size >= len)
         {
             if (!info) ret = STATUS_ACCESS_VIOLATION;
-            else
-            {
-                FIXME("SystemRegistryQuotaInformation: faking max registry size of 32 MB\n");
-                memcpy( info, &srqi, len);
-            }
+            else memcpy( info, &srqi, len );
         }
         else ret = STATUS_INFO_LENGTH_MISMATCH;
         break;
