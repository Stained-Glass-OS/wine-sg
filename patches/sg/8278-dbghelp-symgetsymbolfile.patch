From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: SymGetSymbolFile

SymGetSymbolFile(W) find an image's own file, its .dbg or its .pdb (the names and index its debug directory gives) along a symbol path: by name in each folder and at <store>\<name>\<index>\<name> in each srv* store; a candidate counts only when its own index matches. SymbolFile gets the name, DbgFile the full path; with no process the path must be given. They were spec stubs.
---
--- a/include/dbghelp.h
+++ b/include/dbghelp.h
@@ -1128,6 +1128,9 @@
 BOOL IMAGEAPI SymSrvIsStoreW(HANDLE, PCWSTR);
 PCSTR IMAGEAPI SymSrvStoreFile(HANDLE, PCSTR, PCSTR, DWORD);
 PCWSTR IMAGEAPI SymSrvStoreFileW(HANDLE, PCWSTR, PCWSTR, DWORD);
+BOOL IMAGEAPI SymGetSymbolFile(HANDLE, PCSTR, PCSTR, DWORD, PSTR, size_t, PSTR, size_t);
+BOOL IMAGEAPI SymGetSymbolFileW(HANDLE, PCWSTR, PCWSTR, DWORD, PWSTR, size_t, PWSTR, size_t);
+enum { sfImage = 0, sfDbg, sfPdb, sfMpd, sfMax };
 #define SYMSTOREOPT_COMPRESS        0x01
 #define SYMSTOREOPT_OVERWRITE       0x02
 #define SYMSTOREOPT_RETURNINDEX     0x04
--- a/dlls/dbghelp/path.c
+++ b/dlls/dbghelp/path.c
@@ -1230,3 +1230,122 @@
 PCWSTR WINAPI SymSrvStoreFileW(HANDLE process, PCWSTR srv_path, PCWSTR file, DWORD flags) { return NULL; }
 PCSTR WINAPI SymSrvStoreFile(HANDLE process, PCSTR srv_path, PCSTR file, DWORD flags) { return NULL; }
 #endif
+
+#ifndef SG_MUTANT_NO_GET_SYMBOL_FILE
+/* the symbol store index of a file of the given kind, from the image's index information */
+static void symbol_file_index(const SYMSRV_INDEX_INFOW *info, BOOL pdb, WCHAR *buf, size_t len)
+{
+    static const GUID null_guid;
+
+    if (pdb && memcmp(&info->guid, &null_guid, sizeof(null_guid)))
+        swprintf(buf, len, L"%08X%04X%04X%02X%02X%02X%02X%02X%02X%02X%02X%x", info->guid.Data1, info->guid.Data2,
+                 info->guid.Data3, info->guid.Data4[0], info->guid.Data4[1], info->guid.Data4[2], info->guid.Data4[3],
+                 info->guid.Data4[4], info->guid.Data4[5], info->guid.Data4[6], info->guid.Data4[7], info->age);
+    else if (pdb)
+        swprintf(buf, len, L"%08X%x", info->sig, info->age);
+    else
+        swprintf(buf, len, L"%08X%x", info->timestamp, info->size);
+}
+
+/******************************************************************
+ *      SymGetSymbolFileW (DBGHELP.@)
+ *
+ * (wine-sg 8278) The image's own file, its .dbg or its .pdb (the names and index its debug directory gives),
+ * looked for along the symbol path: in each folder by name, and in each "srv*" store at
+ * <store>\<name>\<index>\<name>; a candidate counts only when its own index matches. SymbolFile gets the
+ * name, DbgFile the full path of the file found.
+ */
+BOOL WINAPI SymGetSymbolFileW(HANDLE process, PCWSTR sym_path, PCWSTR image, DWORD type, PWSTR symbol_file,
+                              size_t symbol_len, PWSTR dbg_file, size_t dbg_len)
+{
+    SYMSRV_INDEX_INFOW info;
+    WCHAR path[2048], want[64], have[64], cand[MAX_PATH], *dir, *ctx;
+    const WCHAR *name;
+    struct process *pcs = process ? process_find_by_handle(process) : NULL;
+
+    TRACE("(%p, %s, %s, %lu, %p, %Iu, %p, %Iu)\n", process, debugstr_w(sym_path), debugstr_w(image), type,
+          symbol_file, symbol_len, dbg_file, dbg_len);
+
+    if (!image || !symbol_file || !symbol_len || type > sfPdb || (!process && (!sym_path || !*sym_path)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (sym_path && *sym_path) lstrcpynW(path, sym_path, ARRAY_SIZE(path));
+    else if (pcs && pcs->search_path) lstrcpynW(path, pcs->search_path, ARRAY_SIZE(path));
+    else
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.sizeofstruct = sizeof(info);
+    if (!SymSrvGetFileIndexInfoW(image, &info, 0) && GetLastError() != ERROR_BAD_EXE_FORMAT) return FALSE;
+    name = type == sfPdb ? info.pdbfile : type == sfDbg ? info.dbgfile : file_name(image);
+    if (type != sfImage) name = file_name(name);
+    if (!*name)
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+    symbol_file_index(&info, type == sfPdb, want, ARRAY_SIZE(want));
+
+    for (dir = wcstok(path, L";", &ctx); dir; dir = wcstok(NULL, L";", &ctx))
+    {
+        WCHAR *store = dir, *star;
+
+        if (!wcsnicmp(store, L"srv*", 4))
+        {
+            store += 4;
+            if ((star = wcschr(store, '*'))) *star = 0;
+            if (!*store) continue;
+            swprintf(cand, ARRAY_SIZE(cand), L"%s\\%s\\%s\\%s", store, name, want, name);
+        }
+        else swprintf(cand, ARRAY_SIZE(cand), L"%s\\%s", dir, name);
+        if (GetFileAttributesW(cand) == INVALID_FILE_ATTRIBUTES) continue;
+        if (!SymSrvGetFileIndexStringW(process, NULL, cand, have, ARRAY_SIZE(have), 0) || wcscmp(have, want)) continue;
+        if (wcslen(name) >= symbol_len || (dbg_file && wcslen(cand) >= dbg_len))
+        {
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            return FALSE;
+        }
+        wcscpy(symbol_file, name);
+        if (dbg_file) wcscpy(dbg_file, cand);
+        return TRUE;
+    }
+    SetLastError(ERROR_FILE_NOT_FOUND);
+    return FALSE;
+}
+
+/******************************************************************
+ *      SymGetSymbolFile (DBGHELP.@)
+ */
+BOOL WINAPI SymGetSymbolFile(HANDLE process, PCSTR sym_path, PCSTR image, DWORD type, PSTR symbol_file,
+                             size_t symbol_len, PSTR dbg_file, size_t dbg_len)
+{
+    WCHAR pathW[2048], imageW[MAX_PATH], symW[MAX_PATH], dbgW[MAX_PATH];
+
+    if (!image || !symbol_file)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (sym_path) MultiByteToWideChar(CP_ACP, 0, sym_path, -1, pathW, ARRAY_SIZE(pathW));
+    MultiByteToWideChar(CP_ACP, 0, image, -1, imageW, ARRAY_SIZE(imageW));
+    if (!SymGetSymbolFileW(process, sym_path ? pathW : NULL, imageW, type, symW, ARRAY_SIZE(symW), dbgW, ARRAY_SIZE(dbgW)))
+        return FALSE;
+    if (!WideCharToMultiByte(CP_ACP, 0, symW, -1, symbol_file, symbol_len, NULL, NULL) ||
+        (dbg_file && !WideCharToMultiByte(CP_ACP, 0, dbgW, -1, dbg_file, dbg_len, NULL, NULL)))
+    {
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    return TRUE;
+}
+#else
+BOOL WINAPI SymGetSymbolFileW(HANDLE process, PCWSTR sym_path, PCWSTR image, DWORD type, PWSTR symbol_file,
+                              size_t symbol_len, PWSTR dbg_file, size_t dbg_len) { return FALSE; }
+BOOL WINAPI SymGetSymbolFile(HANDLE process, PCSTR sym_path, PCSTR image, DWORD type, PSTR symbol_file,
+                             size_t symbol_len, PSTR dbg_file, size_t dbg_len) { return FALSE; }
+#endif
--- a/dlls/dbghelp/dbghelp.spec
+++ b/dlls/dbghelp/dbghelp.spec
@@ -131,8 +131,8 @@
 @ stdcall SymGetSymNext64(long ptr)
 @ stdcall SymGetSymPrev(long ptr)
 @ stdcall SymGetSymPrev64(long ptr)
-@ stub SymGetSymbolFile
-@ stub SymGetSymbolFileW
+@ stdcall SymGetSymbolFile(ptr str str long ptr long ptr long)
+@ stdcall SymGetSymbolFileW(ptr wstr wstr long ptr long ptr long)
 @ stdcall SymGetTypeFromName(ptr int64 str ptr)
 @ stdcall SymGetTypeFromNameW(ptr int64 wstr ptr)
 @ stdcall SymGetTypeInfo(ptr int64 long long ptr)
