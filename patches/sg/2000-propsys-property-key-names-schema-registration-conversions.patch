 HRESULT WINAPI PSRegisterPropertySchema(PCWSTR path)
 {
-    FIXME("%s stub\n", debugstr_w(path));
+    HKEY key;
+    LSTATUS ls;
+    FILETIME ft;
+
+    TRACE("%s\n", debugstr_w(path));
 
+    if (!path)
+        return E_POINTER;
+
+#ifdef SG_MUTANT_SCHEMAREG
     return S_OK;
+#else
+    if ((ls = RegCreateKeyExW(HKEY_LOCAL_MACHINE, schema_key_path, 0, NULL, 0,
+            KEY_WRITE, NULL, &key, NULL)))
+        return HRESULT_FROM_WIN32(ls);
+
+    GetSystemTimeAsFileTime(&ft);
+    ls = RegSetValueExW(key, path, 0, REG_QWORD, (const BYTE *)&ft, sizeof(ft));
+    RegCloseKey(key);
+    return ls ? HRESULT_FROM_WIN32(ls) : S_OK;
+#endif
 }
 
