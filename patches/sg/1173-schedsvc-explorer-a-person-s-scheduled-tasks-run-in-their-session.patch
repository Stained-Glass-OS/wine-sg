+
+/* the service: every person's host looks at the requests */
+static void wake_hosts(void)
+{
+    LARGE_INTEGER due;
+    FILETIME ft;
+
+    if (!host_wake) return;
+    SetEvent(host_wake);
+    if (!host_wake_reset) host_wake_reset = CreateThreadpoolTimer(reset_host_wake, NULL, NULL);
+    if (!host_wake_reset) return;
+    due.QuadPart = -2000 * 10000;
+    ft.dwLowDateTime = due.LowPart;
+    ft.dwHighDateTime = due.HighPart;
+    SetThreadpoolTimer(host_wake_reset, &ft, 0, 0);
+}
+
+static HKEY state_root(void)
