+/* a person's host: the Run requests for their tasks, newer than the last it took */
+static void take_requests(void)
+{
+    WCHAR name[1024];
+    DWORD index, len, type, size;
+    ULONGLONG when, taken;
+    struct run_task *task;
+    HKEY key, mine;
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, requests_key, 0, KEY_READ, &key)) return;
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, requests_key, 0, NULL, 0, KEY_READ | KEY_SET_VALUE, NULL, &mine, NULL))
+    {
+        RegCloseKey(key);
+        return;
+    }
+    for (index = 0; ; index++)
+    {
+        len = ARRAY_SIZE(name);
+        size = sizeof(when);
+        if (RegEnumValueW(key, index, name, &len, NULL, &type, (BYTE *)&when, &size)) break;
+        if (type != REG_QWORD) continue;
+        size = sizeof(taken);
+        if (!RegGetValueW(mine, NULL, name, RRF_RT_REG_QWORD, NULL, &taken, &size) && taken >= when) continue;
+        EnterCriticalSection(&cs);
+        if ((task = find_task(name)) && task->ours && task->enabled && !task->disabled)
+        {
+            TRACE("Run asked for %s\n", debugstr_w(name));
+            start_task(task, TRUE);
+        }
+        LeaveCriticalSection(&cs);
+        RegSetValueExW(mine, name, 0, REG_QWORD, (const BYTE *)&when, sizeof(when));
+    }
+    RegCloseKey(mine);
+    RegCloseKey(key);
+}
