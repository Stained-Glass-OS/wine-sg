+/* an account or group this scheduler runs the tasks of */
+static BOOL is_ours(const WCHAR *id, BOOL group)
+{
+    static const WCHAR *const person_groups[] =
+    {
+        L"S-1-5-32-545", L"Users", L"BUILTIN\\Users", L"S-1-5-4", L"INTERACTIVE", L"NT AUTHORITY\\INTERACTIVE",
+        L"S-1-5-11", L"Authenticated Users", L"NT AUTHORITY\\Authenticated Users", L"S-1-1-0", L"Everyone",
+    };
+    const WCHAR *slash;
+    unsigned int i;
+
+    if (!user_mode) return !group && is_system_account(id);
+    if (group)
+    {
+        for (i = 0; i < ARRAY_SIZE(person_groups); i++) if (!wcsicmp(id, person_groups[i])) return TRUE;
+        return FALSE;
+    }
+    if (!wcsicmp(id, user_sid) || !wcsicmp(id, user_name)) return TRUE;
+    /* DOMAIN\name, any domain the account is known by */
+    if ((slash = wcsrchr(id, '\\')) && !wcsicmp(slash + 1, user_name)) return TRUE;
+    return FALSE;
+}
