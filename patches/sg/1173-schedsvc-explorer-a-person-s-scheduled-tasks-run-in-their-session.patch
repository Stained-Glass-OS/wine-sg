+/* the event that asks the people's hosts to look at the Run requests: open
+ * to everyone (a host runs as the person) */
+static HANDLE create_host_wake(void)
+{
+    SECURITY_ATTRIBUTES sa = { sizeof(sa) };
+    SECURITY_DESCRIPTOR sd;
+
+    InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION);
+    SetSecurityDescriptorDacl(&sd, TRUE, NULL, FALSE);
+    sa.lpSecurityDescriptor = &sd;
+    return CreateEventW(&sa, TRUE, FALSE, L"Global\\SgTaskHostWake");
+}
+
 void taskrun_start(HANDLE done_event)
 {
     service_start = now_utc();
     wake_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    host_wake = create_host_wake();
     scheduler_thread = CreateThread(NULL, 0, scheduler_proc, done_event, 0, NULL);
 }
 
+static void identify_user(const WCHAR *as)
+{
+    TOKEN_USER *user;
+    WCHAR *sid;
+    HANDLE token;
+    DWORD size = 0, name_len = ARRAY_SIZE(user_name), domain_len = ARRAY_SIZE(user_domain);
+    SID_NAME_USE use;
+
+    if (as && *as)
+    {
+        lstrcpynW(user_sid, as, ARRAY_SIZE(user_sid));
+        lstrcpynW(user_name, as, ARRAY_SIZE(user_name));
+        return;
+    }
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return;
+    GetTokenInformation(token, TokenUser, NULL, 0, &size);
+    if ((user = malloc(size)) && GetTokenInformation(token, TokenUser, user, size, &size))
+    {
+        if (ConvertSidToStringSidW(user->User.Sid, &sid))
+        {
+            lstrcpynW(user_sid, sid, ARRAY_SIZE(user_sid));
+            LocalFree(sid);
+        }
+        LookupAccountSidW(NULL, user->User.Sid, user_name, &name_len, user_domain, &domain_len, &use);
+    }
+    free(user);
+    CloseHandle(token);
+}
+
+/* rundll32 schedsvc.dll,SgUserTaskHost [--as ACCOUNT]: the signed-in
+ * person's tasks, for as long as their session lasts. The shell starts it at
+ * each sign-in; one per session. --as names the account whose tasks it
+ * takes (they still run as whoever runs it): for tests. */
+void WINAPI SgUserTaskHostW(HWND hwnd, HINSTANCE instance, WCHAR *cmdline, int show)
+{
+    const WCHAR *as = NULL;
+    HANDLE mutex, never;
+    WCHAR name[300];
+
+#ifdef SG_MUTANT_TASK_NO_USER_HOST
+    return;
+#endif
+    if (cmdline && !wcsncmp(cmdline, L"--as ", 5)) as = cmdline + 5;
+    identify_user(as);
+    if (!user_sid[0]) return;
+    /* the system's tasks are the service's */
+    if (!as && (!wcscmp(user_sid, L"S-1-5-18") || !wcscmp(user_sid, L"S-1-5-19") || !wcscmp(user_sid, L"S-1-5-20")))
+    {
+        TRACE("not for the system's accounts\n");
+        return;
+    }
+    /* one host per account in a session */
+    swprintf(name, ARRAY_SIZE(name), L"Local\\SgUserTaskHost-%s", user_sid);
+    mutex = CreateMutexW(NULL, TRUE, name);
+    if (!mutex || GetLastError() == ERROR_ALREADY_EXISTS) return;
+    TRACE("the tasks of %s (%s)\n", debugstr_w(user_name), debugstr_w(user_sid));
+    user_mode = TRUE;
+    service_start = now_utc();
+    wake_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    host_wake = OpenEventW(SYNCHRONIZE, FALSE, L"Global\\SgTaskHostWake");
+    never = CreateEventW(NULL, TRUE, FALSE, NULL);
+    scheduler_proc(never);
+}
