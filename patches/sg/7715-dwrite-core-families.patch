From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: the core families in the system collection, as their metric-compatible fonts

---
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -5021,6 +5021,42 @@
 }
 
 
+/* Stained Glass OS 7715: the core families Windows always has, when neither the system nor the
+ * Replacements and FontSubstitutes keys give them, as their open metric-compatible fonts (or the
+ * nearest the system has). The fonts keep their own names; the family is found by the Windows
+ * name too. WPF falls back to "Arial" for any character no font of the text maps, and fails fast
+ * when the family does not exist: DuckDuckGo, MyMoney.Net and LanguageTool stopped at their first
+ * text in a profile without sg-shell's Replacements (2026-11-08). */
+static void fontcollection_add_core_families(struct dwrite_fontcollection *collection)
+{
+    static const struct
+    {
+        const WCHAR *name;
+        const WCHAR *candidates[4];
+    }
+    core[] =
+    {
+        { L"Arial",           { L"Liberation Sans", L"Arimo", L"DejaVu Sans" } },
+        { L"Times New Roman", { L"Liberation Serif", L"Tinos", L"DejaVu Serif" } },
+        { L"Courier New",     { L"Liberation Mono", L"Cousine", L"DejaVu Sans Mono" } },
+        { L"Segoe UI",        { L"Inter", L"Noto Sans", L"Liberation Sans", L"DejaVu Sans" } },
+        { L"Calibri",         { L"Carlito", L"Liberation Sans", L"DejaVu Sans" } },
+        { L"Cambria",         { L"Caladea", L"Liberation Serif", L"DejaVu Serif" } },
+        { L"Consolas",        { L"Cascadia Mono", L"Liberation Mono", L"DejaVu Sans Mono" } },
+    };
+    unsigned int i, j;
+
+#ifdef SG_MUTANT_DW_NO_CORE
+    return;
+#endif
+    for (i = 0; i < ARRAY_SIZE(core); i++)
+    {
+        if (collection_find_family(collection, core[i].name) != ~0u) continue;
+        for (j = 0; j < ARRAY_SIZE(core[i].candidates) && core[i].candidates[j]; j++)
+            if (fontcollection_add_replacement(collection, core[i].name, core[i].candidates[j])) break;
+    }
+}
+
 HRESULT create_font_collection(IDWriteFactory7 *factory, IDWriteFontFileEnumerator *enumerator, BOOL is_system,
     IDWriteFontCollection3 **ret)
 {
@@ -5182,6 +5218,7 @@
 #ifndef SG_MUTANT_DWSUBST
         fontcollection_add_substitutes(collection);
 #endif
+        fontcollection_add_core_families(collection);
     }
 
     return hr;
