diff --git a/dlls/windows.ui.xaml/text.c b/dlls/windows.ui.xaml/text.c
index 04e8125..6102248 100644
--- a/dlls/windows.ui.xaml/text.c
+++ b/dlls/windows.ui.xaml/text.c
@@ -445,6 +445,51 @@ static void text_arrange( struct uielem *elem, struct xsize final, struct xsize
         IDWriteTextLayout_Release( layout );
 }
 
+/* the Hyperlink under a point of a TextBlock's own coordinates (wine-sg 6247) */
+static IInspectable *text_link_at( struct text_block *text, FLOAT x, FLOAT y )
+{
+    DWRITE_HIT_TEST_METRICS metrics;
+    struct xthickness padding;
+    BOOL trailing = FALSE, inside = FALSE;
+    UINT32 i, pos;
+
+    if (!text->layout || !text->range_count) return NULL;
+    get_padding( &text->e, &padding );
+    if (FAILED(IDWriteTextLayout_HitTestPoint( text->layout, x - padding.left, y - padding.top, &trailing, &inside, &metrics ))
+            || !inside)
+        return NULL;
+    pos = metrics.textPosition;
+    for (i = text->range_count; i-- > 0;)    /* the innermost (last collected) range first */
+    {
+        struct xtext_range *r = &text->ranges[i];
+        if (r->link && pos >= r->start && pos < r->start + r->length)
+        {
+            IInspectable_AddRef( r->link );
+            return r->link;
+        }
+    }
+    return NULL;
+}
+
+/* the Hyperlink under a point of an element's parent's coordinates, looking through the tree */
+IInspectable *xaml_text_hyperlink_at( struct uielem *elem, FLOAT x, FLOAT y )
+{
+    struct uielem *child;
+    IInspectable *link;
+
+#ifdef SG_MUTANT_HYPERLINK_NO_HIT
+    return NULL;
+#endif
+    if (!elem || elem->visibility == XCOLLAPSED || !elem->arrange_valid) return NULL;
+    x -= elem->offset.x;
+    y -= elem->offset.y;
+    LIST_FOR_EACH_ENTRY_REV( child, &elem->children, struct uielem, entry )
+        if ((link = xaml_text_hyperlink_at( child, x, y ))) return link;
+    if (elem->d.obj.cls != &text_class || x < 0 || y < 0 || x >= elem->render.width || y >= elem->render.height)
+        return NULL;
+    return text_link_at( text_from_elem( elem ), x, y );
+}
+
 static void text_render( struct uielem *elem, struct xdraw *draw )
 {
     struct text_block *text = text_from_elem( elem );
