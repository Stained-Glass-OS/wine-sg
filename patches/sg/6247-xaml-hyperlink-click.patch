+        input.link = xaml_text_hyperlink_at( uielem_from_inspectable( content ), (SHORT)LOWORD( lparam ), (SHORT)HIWORD( lparam ) );
+        if (input.link) SetCapture( hwnd );
         button = button_at( content, lparam );
         set_hover( button );
         hold( &input.pressed, button );
@@ -341,6 +346,16 @@ BOOL xaml_input_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IIns
         }
         return TRUE;
     case WM_LBUTTONUP:
+        if (input.link)
+        {
+            IInspectable *link = input.link, *now;
+            input.link = NULL;
+            if (GetCapture() == hwnd && !input.pressed) ReleaseCapture();
+            now = xaml_text_hyperlink_at( uielem_from_inspectable( content ), (SHORT)LOWORD( lparam ), (SHORT)HIWORD( lparam ) );
+            if (now == link) xaml_hyperlink_click( link );
+            if (now) IInspectable_Release( now );
+            IInspectable_Release( link );
+        }
         button = button_at( content, lparam );
         if (input.pressed)
         {
