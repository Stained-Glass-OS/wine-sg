index e27b509..5244fe3 100644
--- a/dlls/windows.ui.xaml/documents.c
+++ b/dlls/windows.ui.xaml/documents.c
@@ -27,6 +27,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include "private.h"
+#include "shellapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 
 
 static const GUID IID_IVector_Inline = { 0x92ec9252, 0x8ee3, 0x55d6, { 0x84, 0xb4, 0x30, 0xb6, 0x35, 0x07, 0x77, 0x78 } };
@@ -157,7 +160,7 @@ static void append( WCHAR **buf, size_t *len, size_t *size, const WCHAR *str )
 }
 
 /* the formatting text inherits down the spans */
-struct format { INT32 weight, style, underline, strike; DOUBLE size; IInspectable *foreground; BOOL hyperlink; };
+struct format { INT32 weight, style, underline, strike; DOUBLE size; IInspectable *foreground; BOOL hyperlink; IInspectable *link; };
 
 struct collector
 {
@@ -176,7 +179,11 @@ static void own_format( struct text_inline *in, const struct format *parent, str
     if (in->kind == INLINE_BOLD) f->weight = 700;
     if (in->kind == INLINE_ITALIC) f->style = 2;
     if (in->kind == INLINE_UNDERLINE || in->kind == INLINE_HYPERLINK) f->underline = 1;
-    if (in->kind == INLINE_HYPERLINK) f->hyperlink = TRUE;
+    if (in->kind == INLINE_HYPERLINK)
+    {
+        f->hyperlink = TRUE;
+        f->link = (IInspectable *)in->d.obj.outer;
+    }
 #ifdef SG_MUTANT_INLINE_FORMAT_IGNORED
     return;
 #endif
@@ -238,6 +245,7 @@ static void add_range( struct collector *c, size_t start, const struct format *f
     r->strike = f->strike;
     r->size = f->size;
     r->hyperlink = f->hyperlink;
+    r->link = f->link;
     if ((r->foreground = f->foreground)) IInspectable_AddRef( r->foreground );
 }
 
@@ -401,6 +409,42 @@ static HRESULT WINAPI hyperlink_put_NavigateUri( struct xiface *iface, IInspecta
 {
     return dobj_set_value( &inline_from_iface( iface )->d, prop_navigate_uri, value );
 }
+void xaml_hyperlink_click( IInspectable *link )
+{
+    struct dobj *obj = dobj_from_inspectable( link );
+    struct text_inline *in;
+    IInspectable *uri = NULL;
+    HSTRING text = NULL;
+
+    if (!obj) return;
+    in = CONTAINING_RECORD( obj, struct text_inline, d );
+    TRACE( "%p\n", link );
+    IInspectable_AddRef( link );
+    if (!list_empty( &in->click.entries )) xaml_raise_routed( &in->click, link, NULL );
+#ifndef SG_MUTANT_HYPERLINK_NOT_OPENED
+    /* a link with a NavigateUri opens it, as a Windows one does with the program's browser */
+    if (SUCCEEDED(dobj_get_value( &in->d, prop_navigate_uri, &uri )) && uri)
+    {
+        static const GUID IID_IUriRuntimeClass_x = { 0x9e365e57, 0x48b2, 0x4160, { 0x95, 0x6f, 0xc7, 0x38, 0x51, 0x20, 0xbb, 0xfc } };
+        IInspectable *runtime;
+        if (SUCCEEDED(IInspectable_QueryInterface( uri, &IID_IUriRuntimeClass_x, (void **)&runtime )))
+        {
+            /* IUriRuntimeClass.AbsoluteUri, its first member */
+            if (SUCCEEDED(((HRESULT (WINAPI *)( IInspectable *, HSTRING * ))((void **)runtime->lpVtbl)[6])( runtime, &text ))
+                    && WindowsGetStringLen( text ))
+            {
+                TRACE( "opening %s\n", debugstr_w( WindowsGetStringRawBuffer( text, NULL ) ) );
+                ShellExecuteW( NULL, L"open", WindowsGetStringRawBuffer( text, NULL ), NULL, NULL, SW_SHOWNORMAL );
+            }
+            WindowsDeleteString( text );
+            IInspectable_Release( runtime );
+        }
+        IInspectable_Release( uri );
+    }
+#endif
+    IInspectable_Release( link );
+}
+
 static HRESULT WINAPI hyperlink_add_Click( struct xiface *iface, IUnknown *handler, INT64 *token )
 {
     return handlers_add( &inline_from_iface( iface )->click, handler, token );
