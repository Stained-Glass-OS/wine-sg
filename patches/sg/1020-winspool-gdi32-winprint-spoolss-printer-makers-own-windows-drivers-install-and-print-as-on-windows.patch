+/* the attributes a print processor plays a job with (ATTRIBUTE_INFO_3) */
+struct attribute_info_3
+{
+    DWORD dwJobNumberOfPagesPerSide;
+    DWORD dwDrvNumberOfPagesPerSide;
+    DWORD dwNupBorderFlags;
+    DWORD dwJobPageOrderFlags;
+    DWORD dwDrvPageOrderFlags;
+    DWORD dwJobNumberOfCopies;
+    DWORD dwDrvNumberOfCopies;
+    DWORD dwColorOptimization;
+    short dmPrintQuality;
+    short dmYResolution;
+};
+
+/******************************************************************
+ *      GetJobAttributes  [SPOOLSS.@]
+ *
+ * What a maker's print processor needs to play a job: pages per sheet,
+ * page order and copies, from the job's devmode.  We let the processor do
+ * the copies; the driver gets one of each page.
+ */
+BOOL WINAPI GetJobAttributes( WCHAR *printer, DEVMODEW *devmode, void *info )
+{
+    struct attribute_info_3 *attr = info;
+
+    TRACE( "%s %p %p\n", debugstr_w(printer), devmode, info );
+    if (!attr) return FALSE;
+    memset( attr, 0, sizeof(*attr) );
+    attr->dwJobNumberOfPagesPerSide = 1;
+    attr->dwDrvNumberOfPagesPerSide = 1;
+    attr->dwJobNumberOfCopies = devmode && (devmode->dmFields & DM_COPIES) && devmode->dmCopies > 0 ? devmode->dmCopies : 1;
+    attr->dwDrvNumberOfCopies = 1;
+    if (devmode && (devmode->dmFields & DM_PRINTQUALITY)) attr->dmPrintQuality = devmode->dmPrintQuality;
+    if (devmode && (devmode->dmFields & DM_YRESOLUTION)) attr->dmYResolution = devmode->dmYResolution;
+    return TRUE;
+}
+
+/******************************************************************
+ *      RouterAllocBidiMem  [SPOOLSS.@]
+ */
+void * WINAPI RouterAllocBidiMem( SIZE_T size )
+{
+    return HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size );
+}
+
+/******************************************************************
+ *      RouterFreeBidiMem  [SPOOLSS.@]
+ */
+DWORD WINAPI RouterFreeBidiMem( void *mem )
+{
+    HeapFree( GetProcessHeap(), 0, mem );
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************
+ *      RouterAllocBidiResponseContainer  [SPOOLSS.@]
+ *
+ * A language monitor answers a bidirectional query (ink level, paper
+ * state...) in one of these.
+ */
+BIDI_RESPONSE_CONTAINER * WINAPI RouterAllocBidiResponseContainer( DWORD count )
+{
+    BIDI_RESPONSE_CONTAINER *ret;
+    SIZE_T size = FIELD_OFFSET(BIDI_RESPONSE_CONTAINER, aData[max( count, 1 )]);
+
+    if (!(ret = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) return NULL;
+    ret->Version = 1;
+    ret->Count = count;
+    return ret;
+}
