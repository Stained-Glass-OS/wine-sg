+/* where the package's files are unpacked when they are compressed or in a
+ * cabinet: a directory of our own, removed after the install */
+struct staging
+{
+    WCHAR dir[MAX_PATH];
+    BOOL  made;
+};
+
+static BOOL staging_dir( struct staging *st )
+{
+    WCHAR tmp[MAX_PATH];
+    if (st->made) return TRUE;
+    GetTempPathW( ARRAY_SIZE(tmp), tmp );
+    swprintf( st->dir, ARRAY_SIZE(st->dir), L"%ssgdrv%lx-%lx", tmp, GetCurrentProcessId(), GetTickCount() );
+    if (!CreateDirectoryW( st->dir, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS) return FALSE;
+    st->made = TRUE;
+    return TRUE;
+}
+
+static void remove_tree( const WCHAR *dir )
+{
+    WCHAR pattern[MAX_PATH], path[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+            swprintf( path, ARRAY_SIZE(path), L"%s\\%s", dir, fd.cFileName );
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) remove_tree( path );
+            else
+            {
+                SetFileAttributesW( path, FILE_ATTRIBUTE_NORMAL );
+                DeleteFileW( path );
+            }
+        } while (FindNextFileW( find, &fd ));
+        FindClose( find );
+    }
+    RemoveDirectoryW( dir );
+}
+
+static void staging_free( struct staging *st )
+{
+    if (st->made) remove_tree( st->dir );
+    st->made = FALSE;
+}
