+static BOOL driver_draws( const struct driver *drv, SURFOBJ *so, const struct wine_eng_device *dev )
+{
+#ifdef SG_MUTANT_DRVCOPYBITS
+    return FALSE;
+#endif
+    if (!drv->copy_bits && !drv->bit_blt) return FALSE;
+    if (so->iType != STYPE_BITMAP || !so->pvScan0) return TRUE;
