+/***********************************************************************
+ *           EngBitBlt    (GDI32.@)
+ */
+BOOL WINAPI EngBitBlt( SURFOBJ *dst, SURFOBJ *src, SURFOBJ *mask, CLIPOBJ *clip, XLATEOBJ *xlate, RECTL *rect,
+                       POINTL *src_pt, POINTL *mask_pt, BRUSHOBJ *brush, POINTL *brush_org, ROP4 rop )
+{
+    RECTL src_rect;
+
+    TRACE( "%p %p %p %p %s rop %#lx\n", dst, src, clip, xlate, rect ? wine_dbgstr_rect( (RECT *)rect ) : "-", rop );
+    if (!rect) return FALSE;
+    if (mask && ((rop >> 8) & 0xff) != (rop & 0xff)) FIXME( "masks are not supported\n" );
+    if (src_pt)
+    {
+        src_rect.left = src_pt->x;
+        src_rect.top = src_pt->y;
+        src_rect.right = src_pt->x + (rect->right - rect->left);
+        src_rect.bottom = src_pt->y + (rect->bottom - rect->top);
+    }
+#ifdef SG_MUTANT_ENGBLT
+    if (src && src->iBitmapFormat != dst->iBitmapFormat) return FALSE;
+#endif
+    return eng_blit( dst, src, clip, xlate, rect, src_pt ? &src_rect : NULL, brush, rop & 0xff );
+}
