+/* the files of the core drivers are ours: a package that carries its own
+ * copies of them (some makers ship the system's PostScript driver) still
+ * gets ours, which is the one that runs here */
+static BOOL is_core_file( const WCHAR *file )
+{
+    static const WCHAR *core[] = { L"PSCRIPT5.DLL", L"PS5UI.DLL", L"UNIDRV.DLL", L"UNIDRVUI.DLL" };
+    unsigned int i;
+#ifdef SG_MUTANT_COREFILES
