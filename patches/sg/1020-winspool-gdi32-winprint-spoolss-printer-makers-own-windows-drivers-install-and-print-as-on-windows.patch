+/******************************************************************************
+ *		SetPortW (WINSPOOL.@)
+ *
+ * A language monitor tells the system the port's state (PORT_INFO_3: the
+ * printer is out of paper, offline, low on toner); the printers on the port
+ * show it.  The state is kept under the port in the registry, where
+ * GetPrinter's Status and the jobs' status read it.
+ */
+BOOL WINAPI SetPortW( WCHAR *server, WCHAR *port, DWORD level, BYTE *info )
+{
+    PORT_INFO_3W *pi3 = (PORT_INFO_3W *)info;
+    HKEY key;
+    WCHAR path[MAX_PATH];
+
+    TRACE( "%s %s %lu %p\n", debugstr_w(server), debugstr_w(port), level, info );
+    if (level != 3 || !port || !info)
+    {
+        SetLastError( ERROR_INVALID_LEVEL );
+        return FALSE;
+    }
+    TRACE( "status %lu %s severity %lu\n", pi3->dwStatus, debugstr_w(pi3->pszStatus), pi3->dwSeverity );
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\Printing\\Port Status\\%s", port );
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, REG_OPTION_VOLATILE, KEY_SET_VALUE, NULL, &key, NULL ))
+        return FALSE;
+    RegSetValueExW( key, L"Status", 0, REG_DWORD, (BYTE *)&pi3->dwStatus, sizeof(DWORD) );
+    RegSetValueExW( key, L"Severity", 0, REG_DWORD, (BYTE *)&pi3->dwSeverity, sizeof(DWORD) );
+    if (pi3->pszStatus)
+        RegSetValueExW( key, L"Text", 0, REG_SZ, (BYTE *)pi3->pszStatus, (wcslen( pi3->pszStatus ) + 1) * sizeof(WCHAR) );
