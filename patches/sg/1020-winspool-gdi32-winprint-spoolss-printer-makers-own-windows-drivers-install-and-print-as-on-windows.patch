+/* a file compressed for setup has the last letter of its name replaced by
+ * an underscore (brprm17a.dl_); setupapi expands it */
+static BOOL expand_compressed( const WCHAR *dir, const WCHAR *file, struct staging *st, WCHAR *path, DWORD size )
+{
+    WCHAR packed[MAX_PATH];
+    size_t len;
+
+    swprintf( packed, ARRAY_SIZE(packed), L"%s\\%s", dir, file );
+    len = wcslen( packed );
+    if (!len || packed[len - 1] == '_') return FALSE;
+    packed[len - 1] = '_';
+    if (!exists( packed )) return FALSE;
+#ifdef SG_MUTANT_EXPAND
+    return FALSE;
+#endif
+    if (!staging_dir( st )) return FALSE;
+    swprintf( path, size, L"%s\\%s", st->dir, file );
+    if (!exists( path ) && SetupDecompressOrCopyFileW( packed, path, NULL ) != ERROR_SUCCESS)
+    {
+        WARN( "cannot expand %s\n", debugstr_w(packed) );
+        return FALSE;
+    }
+    TRACE( "%s expanded\n", debugstr_w(packed) );
+    return TRUE;
+}
