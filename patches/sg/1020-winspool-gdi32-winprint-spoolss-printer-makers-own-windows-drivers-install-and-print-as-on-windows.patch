+/***********************************************************************
+ *           HT_Get8BPPFormatPalette    (GDI32.@)
+ *
+ * A palette for eight-bit halftoning: a 6x6x6 colour cube and a ramp of
+ * greys, red in the low byte of each entry.
+ */
+LONG WINAPI HT_Get8BPPFormatPalette( PALETTEENTRY *entries, USHORT red_gamma, USHORT green_gamma,
+                                     USHORT blue_gamma )
+{
+    int i;
+
+    if (!entries) return 256;
+    for (i = 0; i < 216; i++)
+    {
+        entries[i].peRed = (i / 36) * 51;
+        entries[i].peGreen = ((i / 6) % 6) * 51;
+        entries[i].peBlue = (i % 6) * 51;
+        entries[i].peFlags = 0;
+    }
+    for (i = 216; i < 256; i++)
+    {
+        BYTE v = (i - 216) * 255 / 39;
+        entries[i].peRed = entries[i].peGreen = entries[i].peBlue = v;
+        entries[i].peFlags = 0;
+    }
+    return 256;
+}
+
