+/*
+ * The print processor hands a printer driver each page (or band) as a 24-bit
+ * picture: through the driver's DrvCopyBits or DrvBitBlt when the driver
+ * draws on a surface of its own or watches what is drawn on its bitmap, as
+ * GDI does for a printer DC.  Drivers pass such calls back to us (the
+ * "punt" to EngCopyBits and EngBitBlt) or read the picture themselves
+ * through the colour translation object (XLATEOBJ) we give them.  So the
+ * engine converts between the DDI's bitmap formats: 1, 4, 8, 16, 24 and
+ * 32 bits per pixel, indexed or not, with the raster operations, stretching
+ * and an ordered dither where a picture meets a palette of few colours.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "ddk/winddi.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(gdi);
+
+#define XLATE_MAGIC 0x54414c58
+
+/* a colour translation; colours inside are 0x00RRGGBB */
+struct eng_xlate
+{
+    XLATEOBJ xo;            /* first: drivers get its address */
+    DWORD    magic;
+    ULONG    src_type, dst_type;
+    ULONG    src_count, dst_count;
+    ULONG    src_colors[256], dst_colors[256];
+    ULONG    src_masks[3], dst_masks[3];
+    ULONG    vector[256];   /* indexed source to destination */
+    BYTE    *cube;          /* 32x32x32 nearest destination index */
+    BOOL     dither;
+};
+
+static int format_bpp( ULONG format )
+{
+    switch (format)
+    {
+    case BMF_1BPP:  return 1;
+    case BMF_4BPP:  return 4;
+    case BMF_8BPP:  return 8;
+    case BMF_16BPP: return 16;
+    case BMF_24BPP: return 24;
+    case BMF_32BPP: return 32;
+    }
+    return 0;
+}
+
+static ULONG swap_rb( ULONG c )
+{
+    return ((c & 0xff) << 16) | (c & 0xff00) | ((c >> 16) & 0xff);
+}
+
+static struct eng_xlate *get_xlate( XLATEOBJ *xo )
+{
+    struct eng_xlate *x = (struct eng_xlate *)xo;
+    return x && x->magic == XLATE_MAGIC ? x : NULL;
+}
+
+/* a palette as a translation side: type, colours, masks */
+static void palette_side( const struct wine_eng_palette *pal, ULONG format, ULONG *type, ULONG *count,
+                          ULONG *colors, ULONG *masks )
+{
+    int bpp = format_bpp( format );
+    ULONG i;
+
+    *count = 0;
+    masks[0] = 0xff0000; masks[1] = 0xff00; masks[2] = 0xff;
+    if (pal && pal->mode == PAL_INDEXED)
+    {
+        *type = PAL_INDEXED;
+        *count = min( pal->count, 256 );
+        /* a DDI palette entry is red in the low byte */
+        for (i = 0; i < *count; i++) colors[i] = swap_rb( pal->colors[i] & 0xffffff );
+        return;
+    }
+    if (pal && pal->mode == PAL_BITFIELDS)
+    {
+        *type = PAL_BITFIELDS;
+        masks[0] = pal->red; masks[1] = pal->green; masks[2] = pal->blue;
+        return;
+    }
+    if (pal && pal->mode == PAL_RGB) { *type = PAL_RGB; return; }
+    if (bpp && bpp <= 8)
+    {
+        /* no palette: a grey ramp, 0 black */
+        ULONG n = 1u << bpp;
+        *type = PAL_INDEXED;
+        *count = n;
+        for (i = 0; i < n; i++)
+        {
+            ULONG v = i * 255 / (n - 1);
+            colors[i] = (v << 16) | (v << 8) | v;
+        }
+        return;
+    }
+    if (bpp == 16)
+    {
+        *type = PAL_BITFIELDS;
+        masks[0] = 0x7c00; masks[1] = 0x03e0; masks[2] = 0x001f;
+        return;
+    }
+    *type = PAL_BGR;
+}
+
+static int mask_shift( ULONG mask )
+{
+    int s = 0;
+    if (!mask) return 0;
+    while (!(mask & 1)) { mask >>= 1; s++; }
+    return s;
+}
+
+static ULONG mask_get( ULONG v, ULONG mask )
+{
+    int shift = mask_shift( mask ), bits = 0;
+    ULONG m = mask >> shift, c;
+    while (m >> bits) bits++;
+    if (!bits) return 0;
+    c = (v & mask) >> shift;
+    if (bits >= 8) return c >> (bits - 8);
+    return (c << (8 - bits)) | (c >> (2 * bits - 8 > 0 ? 2 * bits - 8 : 0));
+}
+
+static ULONG mask_put( ULONG c8, ULONG mask )
+{
+    int shift = mask_shift( mask ), bits = 0;
+    ULONG m = mask >> shift;
+    while (m >> bits) bits++;
+    if (bits <= 8) return ((c8 >> (8 - bits)) << shift) & mask;
+    return ((c8 << (bits - 8)) << shift) & mask;
+}
+
+/* a raw source value as 0x00RRGGBB */
+static ULONG src_to_rgb( const struct eng_xlate *x, ULONG v )
+{
+    switch (x->src_type)
+    {
+    case PAL_INDEXED: return v < x->src_count ? x->src_colors[v] : 0;
+    case PAL_RGB: return swap_rb( v & 0xffffff );
+    case PAL_BITFIELDS:
+        return (mask_get( v, x->src_masks[0] ) << 16) | (mask_get( v, x->src_masks[1] ) << 8) |
+               mask_get( v, x->src_masks[2] );
+    }
+    return v & 0xffffff;  /* PAL_BGR */
+}
+
+static ULONG nearest_index( const struct eng_xlate *x, ULONG rgb )
+{
+    ULONG best = 0, best_d = ~0u, i;
+    int r = (rgb >> 16) & 0xff, g = (rgb >> 8) & 0xff, b = rgb & 0xff;
+
+    for (i = 0; i < x->dst_count; i++)
+    {
+        int dr = r - (int)((x->dst_colors[i] >> 16) & 0xff);
+        int dg = g - (int)((x->dst_colors[i] >> 8) & 0xff);
+        int db = b - (int)(x->dst_colors[i] & 0xff);
+        ULONG d = dr * dr * 3 + dg * dg * 4 + db * db * 2;
+        if (d < best_d) { best_d = d; best = i; }
+    }
+    return best;
+}
+
+/* 0x00RRGGBB as a raw destination value */
+static ULONG rgb_to_dst( struct eng_xlate *x, ULONG rgb )
+{
+    switch (x->dst_type)
+    {
+    case PAL_INDEXED:
+        if (x->dst_count <= 2) return nearest_index( x, rgb );
+        if (!x->cube)
+        {
+            ULONG i;
+            if (!(x->cube = malloc( 32 * 32 * 32 ))) return nearest_index( x, rgb );
+            for (i = 0; i < 32 * 32 * 32; i++)
+            {
+                ULONG c = (((i >> 10) & 31) * 255 / 31) << 16 | (((i >> 5) & 31) * 255 / 31) << 8 |
+                          ((i & 31) * 255 / 31);
+                x->cube[i] = nearest_index( x, c );
+            }
+        }
+        return x->cube[(((rgb >> 19) & 31) << 10) | (((rgb >> 11) & 31) << 5) | ((rgb >> 3) & 31)];
+    case PAL_RGB: return swap_rb( rgb );
+    case PAL_BITFIELDS:
+        return mask_put( (rgb >> 16) & 0xff, x->dst_masks[0] ) | mask_put( (rgb >> 8) & 0xff, x->dst_masks[1] ) |
+               mask_put( rgb & 0xff, x->dst_masks[2] );
+    }
+    return rgb;
+}
+
+static void build_vector( struct eng_xlate *x )
+{
+    ULONG i;
+    if (x->src_type != PAL_INDEXED) return;
+    for (i = 0; i < x->src_count; i++) x->vector[i] = rgb_to_dst( x, x->src_colors[i] );
+    x->xo.pulXlate = x->vector;
+    x->xo.cEntries = x->src_count;
+    x->xo.flXlate |= XO_TABLE;
+}
+
+/***********************************************************************
+ *           __wine_eng_create_xlate    (GDI32.@)
+ *
+ * The translation from a surface of src_format with src_pal (NULL: the
+ * format's own colours) to one of dst_format with dst_pal.
+ */
+XLATEOBJ * WINAPI __wine_eng_create_xlate( ULONG src_format, HPALETTE src_pal, ULONG dst_format, HPALETTE dst_pal )
+{
+    struct eng_xlate *x = calloc( 1, sizeof(*x) );
+
+    if (!x) return NULL;
+    x->magic = XLATE_MAGIC;
+    palette_side( (const struct wine_eng_palette *)src_pal, src_format, &x->src_type, &x->src_count,
+                  x->src_colors, x->src_masks );
+    palette_side( (const struct wine_eng_palette *)dst_pal, dst_format, &x->dst_type, &x->dst_count,
+                  x->dst_colors, x->dst_masks );
+    x->xo.iUniq = 0;  /* not to be cached */
+    x->xo.iSrcType = x->src_type;
+    x->xo.iDstType = x->dst_type;
+    if (x->dst_type == PAL_INDEXED && x->dst_count == 2) x->xo.flXlate |= XO_TO_MONO;
+    /* a picture meeting a palette of few colours is dithered */
+    x->dither = x->dst_type == PAL_INDEXED && x->dst_count <= 16 && x->src_type != PAL_INDEXED;
+    build_vector( x );
+    if (x->src_type == x->dst_type && src_format == dst_format && x->src_type != PAL_INDEXED &&
+        !memcmp( x->src_masks, x->dst_masks, sizeof(x->src_masks) ))
+        x->xo.flXlate |= XO_TRIVIAL;
+    TRACE( "%lu %p -> %lu %p: %p (src type %lu, dst type %lu/%lu)\n", src_format, src_pal, dst_format, dst_pal,
+           x, x->src_type, x->dst_type, x->dst_count );
+    return &x->xo;
+}
+
+/***********************************************************************
+ *           __wine_eng_delete_xlate    (GDI32.@)
+ */
+void WINAPI __wine_eng_delete_xlate( XLATEOBJ *xo )
+{
+    struct eng_xlate *x = get_xlate( xo );
+    if (!x) return;
+    x->magic = 0;
+    free( x->cube );
+    free( x );
+}
+
+/***********************************************************************
+ *           XLATEOBJ_iXlate    (GDI32.@)
+ */
+ULONG WINAPI XLATEOBJ_iXlate( XLATEOBJ *xo, ULONG color )
+{
+    struct eng_xlate *x = get_xlate( xo );
+    if (x) return rgb_to_dst( x, src_to_rgb( x, color ) );
+    if (xo && (xo->flXlate & XO_TABLE) && xo->pulXlate && color < xo->cEntries) return xo->pulXlate[color];
+    return color;
+}
+
+/***********************************************************************
+ *           XLATEOBJ_piVector    (GDI32.@)
+ */
+ULONG * WINAPI XLATEOBJ_piVector( XLATEOBJ *xo )
+{
+    return xo && (xo->flXlate & XO_TABLE) ? xo->pulXlate : NULL;
+}
+
+/***********************************************************************
+ *           XLATEOBJ_cGetPalette    (GDI32.@)
+ *
+ * The source's or the destination's palette, entries as the palette's type
+ * has them; bit fields as three masks.
+ */
+ULONG WINAPI XLATEOBJ_cGetPalette( XLATEOBJ *xo, ULONG which, ULONG count, ULONG *colors )
+{
+    struct eng_xlate *x = get_xlate( xo );
+    const ULONG *pal, *masks;
+    ULONG type, n, i;
+
+    if (!x) return 0;
+    switch (which)
+    {
+    case XO_SRCPALETTE: type = x->src_type; n = x->src_count; pal = x->src_colors; masks = x->src_masks; break;
+    case XO_DESTPALETTE:
+    case XO_DESTDCPALETTE: type = x->dst_type; n = x->dst_count; pal = x->dst_colors; masks = x->dst_masks; break;
+    case XO_SRCBITFIELDS:
+    case XO_DESTBITFIELDS:
+        masks = which == XO_SRCBITFIELDS ? x->src_masks : x->dst_masks;
+        if (!colors) return 3;
+        for (i = 0; i < min( count, 3 ); i++) colors[i] = masks[i];
+        return min( count, 3 );
+    default: return 0;
+    }
+    if (type != PAL_INDEXED) return 0;
+    if (!colors) return n;
+    /* entries as a DDI palette has them: red in the low byte */
+    for (i = 0; i < min( count, n ); i++) colors[i] = swap_rb( pal[i] );
+    return min( count, n );
+}
+
+/***********************************************************************
+ *           XLATEOBJ_hGetColorTransform    (GDI32.@)
+ */
+HANDLE WINAPI XLATEOBJ_hGetColorTransform( XLATEOBJ *xo )
+{
+    return NULL;
+}
+
+/* ---- pixels ---- */
+
+static inline BYTE *row_ptr( SURFOBJ *so, int y )
+{
+    return (BYTE *)so->pvScan0 + (LONG_PTR)y * so->lDelta;
+}
+
+static inline ULONG get_pixel( const BYTE *row, int x, int bpp )
+{
+    switch (bpp)
+    {
+    case 1: return (row[x / 8] >> (7 - x % 8)) & 1;
+    case 4: return (row[x / 2] >> (x & 1 ? 0 : 4)) & 0xf;
+    case 8: return row[x];
+    case 16: return ((const WORD *)row)[x];
+    case 24: return row[x * 3] | (row[x * 3 + 1] << 8) | (row[x * 3 + 2] << 16);
+    case 32: return ((const DWORD *)row)[x];
+    }
+    return 0;
+}
+
+static inline void put_pixel( BYTE *row, int x, int bpp, ULONG v )
+{
+    switch (bpp)
+    {
+    case 1:
+        if (v & 1) row[x / 8] |= 0x80 >> (x % 8);
+        else row[x / 8] &= ~(0x80 >> (x % 8));
+        break;
+    case 4:
+        if (x & 1) row[x / 2] = (row[x / 2] & 0xf0) | (v & 0xf);
+        else row[x / 2] = (row[x / 2] & 0x0f) | ((v & 0xf) << 4);
+        break;
+    case 8: row[x] = v; break;
+    case 16: ((WORD *)row)[x] = v; break;
+    case 24: row[x * 3] = v; row[x * 3 + 1] = v >> 8; row[x * 3 + 2] = v >> 16; break;
+    case 32: ((DWORD *)row)[x] = v; break;
+    }
+}
+
+/* an 8x8 ordered dither matrix, 0..63 */
+static const BYTE bayer8[8][8] =
+{
+    {  0, 32,  8, 40,  2, 34, 10, 42 }, { 48, 16, 56, 24, 50, 18, 58, 26 },
+    { 12, 44,  4, 36, 14, 46,  6, 38 }, { 60, 28, 52, 20, 62, 30, 54, 22 },
+    {  3, 35, 11, 43,  1, 33,  9, 41 }, { 51, 19, 59, 27, 49, 17, 57, 25 },
+    { 15, 47,  7, 39, 13, 45,  5, 37 }, { 63, 31, 55, 23, 61, 29, 53, 21 },
+};
+
+static inline int clamp255( int v ) { return v < 0 ? 0 : v > 255 ? 255 : v; }
+
+/* a source pixel at device (x, y) as a raw destination value */
+static ULONG translate( struct eng_xlate *x, XLATEOBJ *xo, ULONG v, int dx, int dy )
+{
+    ULONG rgb;
+    int t;
+
+    if (!x)
+    {
+        if (xo && (xo->flXlate & XO_TABLE) && xo->pulXlate && v < xo->cEntries) return xo->pulXlate[v];
+        return v;
+    }
+    if (x->src_type == PAL_INDEXED && v < x->src_count) return x->vector[v];
+    rgb = src_to_rgb( x, v );
+    if (!x->dither) return rgb_to_dst( x, rgb );
+    if (x->dst_count == 2)
+    {
+        /* one bit: the dither decides between the darker and the lighter entry */
+        ULONG c0 = x->dst_colors[0], c1 = x->dst_colors[1];
+        int l0 = (((c0 >> 16) & 0xff) * 77 + ((c0 >> 8) & 0xff) * 150 + (c0 & 0xff) * 29) >> 8;
+        int l1 = (((c1 >> 16) & 0xff) * 77 + ((c1 >> 8) & 0xff) * 150 + (c1 & 0xff) * 29) >> 8;
+        int l = (((rgb >> 16) & 0xff) * 77 + ((rgb >> 8) & 0xff) * 150 + (rgb & 0xff) * 29) >> 8;
+        int lo = min( l0, l1 ), hi = max( l0, l1 );
+        int th = lo + (hi - lo) * (bayer8[dy & 7][dx & 7] * 4 + 2) / 256;
+        BOOL light = hi > lo ? l > th : l >= 128;
+        return light == (l1 > l0);
+    }
+    t = (bayer8[dy & 7][dx & 7] - 32) * 255 / (64 * 3);
+    rgb = (clamp255( ((rgb >> 16) & 0xff) + t ) << 16) | (clamp255( ((rgb >> 8) & 0xff) + t ) << 8) |
+          clamp255( (rgb & 0xff) + t );
+    return rgb_to_dst( x, rgb );
+}
+
+static ULONG do_rop3( BYTE rop, ULONG p, ULONG s, ULONG d )
+{
+    ULONG r = 0;
+    if (rop & 0x01) r |= ~p & ~s & ~d;
+    if (rop & 0x02) r |= ~p & ~s & d;
+    if (rop & 0x04) r |= ~p & s & ~d;
+    if (rop & 0x08) r |= ~p & s & d;
+    if (rop & 0x10) r |= p & ~s & ~d;
+    if (rop & 0x20) r |= p & ~s & d;
+    if (rop & 0x40) r |= p & s & ~d;
+    if (rop & 0x80) r |= p & s & d;
+    return r;
+}
+
+static BOOL bitmap_surface( SURFOBJ *so )
+{
+    return so && so->pvScan0 && format_bpp( so->iBitmapFormat );
+}
+
+static BOOL intersect( RECTL *r, const RECTL *a, const RECTL *b )
+{
+    r->left = max( a->left, b->left );
+    r->top = max( a->top, b->top );
+    r->right = min( a->right, b->right );
+    r->bottom = min( a->bottom, b->bottom );
+    return r->left < r->right && r->top < r->bottom;
+}
+
+/* the rectangle a blit may touch: the destination's, the clip's bounds */
+static BOOL blit_area( SURFOBJ *dst, CLIPOBJ *clip, const RECTL *rect, RECTL *area )
+{
+    RECTL r = *rect, bounds = { 0, 0, dst->sizlBitmap.cx, dst->sizlBitmap.cy };
+
+    if (r.left > r.right) { LONG t = r.left; r.left = r.right; r.right = t; }
+    if (r.top > r.bottom) { LONG t = r.top; r.top = r.bottom; r.bottom = t; }
+    if (!intersect( area, &r, &bounds )) return FALSE;
+    if (clip && clip->iDComplexity != DC_TRIVIAL && !intersect( area, area, &clip->rclBounds )) return FALSE;
+    return TRUE;
+}
+
+/* where destination step t of dlen falls in a source span of slen from s0
+ * (slen < 0: the source runs backwards) */
+static LONG map_coord( LONG t, LONG dlen, LONG s0, LONG slen )
+{
+    LONGLONG num = (LONGLONG)(2 * t + 1) * slen, den = 2 * (LONGLONG)dlen;
+    LONGLONG q = num >= 0 ? num / den : -((-num + den - 1) / den);
+    return s0 + (LONG)q;
+}
+
+/* the general blit: destination = rop3(pattern, source scaled into
+ * dst_rect, destination) */
+static BOOL eng_blit( SURFOBJ *dst, SURFOBJ *src, CLIPOBJ *clip, XLATEOBJ *xo, const RECTL *dst_rect,
+                      const RECTL *src_rect, BRUSHOBJ *brush, BYTE rop )
+{
+    struct eng_xlate *x = get_xlate( xo );
+    int dbpp = format_bpp( dst->iBitmapFormat ), sbpp = src ? format_bpp( src->iBitmapFormat ) : 0;
+    BOOL use_src = ((rop >> 2) ^ rop) & 0x33, use_pat = ((rop >> 4) ^ rop) & 0x0f;
+    BOOL use_dst = ((rop >> 1) ^ rop) & 0x55;
+    BOOL mirror_x = dst_rect->right < dst_rect->left, mirror_y = dst_rect->bottom < dst_rect->top;
+    LONG dw = abs( dst_rect->right - dst_rect->left ), dh = abs( dst_rect->bottom - dst_rect->top );
+    LONG left = min( dst_rect->left, dst_rect->right ), top = min( dst_rect->top, dst_rect->bottom );
+    LONG sw = 0, sh = 0;
+    ULONG pat = 0;
+    RECTL area;
+    int x_, y_;
+
+    if (!bitmap_surface( dst )) return FALSE;
+    if (use_src && (!bitmap_surface( src ) || !src_rect)) return FALSE;
+    if (use_pat)
+    {
+        if (!brush || brush->iSolidColor == 0xffffffff)
+        {
+            FIXME( "pattern brushes are not supported\n" );
+            pat = 0xffffffff;  /* paper */
+        }
+        else pat = brush->iSolidColor;
+    }
+    if (!dw || !dh || !blit_area( dst, clip, dst_rect, &area )) return TRUE;
+    if (use_src)
+    {
+        sw = src_rect->right - src_rect->left;
+        sh = src_rect->bottom - src_rect->top;
+    }
+
+    for (y_ = area.top; y_ < area.bottom; y_++)
+    {
+        BYTE *drow = row_ptr( dst, y_ );
+        const BYTE *srow = NULL;
+
+        if (use_src)
+        {
+            LONG t = y_ - top, sy;
+            if (mirror_y) t = dh - 1 - t;
+            sy = map_coord( t, dh, src_rect->top, sh );
+            if (sy < 0 || sy >= src->sizlBitmap.cy) continue;
+            srow = row_ptr( src, sy );
+        }
+        for (x_ = area.left; x_ < area.right; x_++)
+        {
+            ULONG s = 0, d = 0, v;
+            if (use_src)
+            {
+                LONG t = x_ - left, sx;
+                if (mirror_x) t = dw - 1 - t;
+                sx = map_coord( t, dw, src_rect->left, sw );
+                if (sx < 0 || sx >= src->sizlBitmap.cx) continue;
+                s = translate( x, xo, get_pixel( srow, sx, sbpp ), x_, y_ );
+            }
+            if (use_dst) d = get_pixel( drow, x_, dbpp );
+            v = rop == 0xcc ? s : do_rop3( rop, pat, s, d );
+            put_pixel( drow, x_, dbpp, v );
+        }
+    }
+    return TRUE;
+}
