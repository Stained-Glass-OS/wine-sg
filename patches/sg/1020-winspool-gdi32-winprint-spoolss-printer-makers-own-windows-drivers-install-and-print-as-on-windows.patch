+/***********************************************************************
+ *           EngTransparentBlt    (GDI32.@)
+ */
+BOOL WINAPI EngTransparentBlt( SURFOBJ *dst, SURFOBJ *src, CLIPOBJ *clip, XLATEOBJ *xlate, RECTL *dst_rect,
+                               RECTL *src_rect, ULONG transparent, ULONG reserved )
+{
+    struct eng_xlate *x = get_xlate( xlate );
+    int dbpp, sbpp;
+    LONG dw, dh, sw, sh;
+    RECTL area;
+    int x_, y_;
+
+    if (!bitmap_surface( dst ) || !bitmap_surface( src ) || !dst_rect || !src_rect) return FALSE;
+    dbpp = format_bpp( dst->iBitmapFormat );
+    sbpp = format_bpp( src->iBitmapFormat );
+    dw = dst_rect->right - dst_rect->left; dh = dst_rect->bottom - dst_rect->top;
+    sw = src_rect->right - src_rect->left; sh = src_rect->bottom - src_rect->top;
+    if (dw <= 0 || dh <= 0 || !blit_area( dst, clip, dst_rect, &area )) return TRUE;
+    for (y_ = area.top; y_ < area.bottom; y_++)
+    {
+        LONG sy = src_rect->top + (y_ - dst_rect->top) * sh / dh;
+        const BYTE *srow;
+        if (sy < 0 || sy >= src->sizlBitmap.cy) continue;
+        srow = row_ptr( src, sy );
+        for (x_ = area.left; x_ < area.right; x_++)
+        {
+            LONG sx = src_rect->left + (x_ - dst_rect->left) * sw / dw;
+            ULONG v;
+            if (sx < 0 || sx >= src->sizlBitmap.cx) continue;
+            v = get_pixel( srow, sx, sbpp );
+            if (v == transparent) continue;
+            put_pixel( row_ptr( dst, y_ ), x_, dbpp, translate( x, xlate, v, x_, y_ ) );
+        }
+    }
+    return TRUE;
+}
