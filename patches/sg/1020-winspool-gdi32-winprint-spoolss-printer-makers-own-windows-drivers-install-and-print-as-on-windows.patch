+static BOOL from_cabinet( const WCHAR *inf_dir, const WCHAR *cab, const WCHAR *file, struct staging *st,
+                          WCHAR *path, DWORD size )
+{
+    WCHAR cab_path[MAX_PATH], dir[MAX_PATH];
