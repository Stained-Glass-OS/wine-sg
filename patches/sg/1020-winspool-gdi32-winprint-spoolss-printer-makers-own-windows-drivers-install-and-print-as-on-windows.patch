+/* the page (band at origin, the surface's size) as a 24-bit picture handed
+ * to the driver's DrvCopyBits or DrvBitBlt, in strips */
+static BOOL deliver_page( const struct driver *drv, const struct spool_page *page, SURFOBJ *so,
+                          const DEVINFO *devinfo, POINTL origin )
+{
+    int w = so->sizlBitmap.cx, h = so->sizlBitmap.cy, strip = h, y;
+    XLATEOBJ *xlate;
+    BOOL ret = TRUE;
+
+    /* at most 32 MB of picture at a time */
+    if ((LONGLONG)w * 3 * h > 32 * 1024 * 1024) strip = max( 1, 32 * 1024 * 1024 / (w * 3) );
+    xlate = __wine_eng_create_xlate( BMF_24BPP, NULL, so->iBitmapFormat, devinfo->hpalDefault );
+    for (y = 0; y < h && ret; y += strip)
+    {
+        int rows = min( strip, h - y );
+        POINTL at = { origin.x, origin.y + y };
+        SURFOBJ *src_so;
+        HSURF src;
+        HBITMAP dib;
+        HDC hdc;
+        BYTE *bits;
+        SIZEL size = { w, rows };
+        CLIPOBJ clip;
+        RECTL rect = { 0, y, w, y + rows };
+        POINTL pt = { 0, 0 };
+
+        play_page( page, w, rows, 24, NULL, 0, at, &hdc, &dib, &bits );
+        src = EngCreateBitmap( size, (w * 3 + 3) & ~3, BMF_24BPP, BMF_TOPDOWN, bits );
+        src_so = EngLockSurface( src );
+        memset( &clip, 0, sizeof(clip) );
+        clip.iDComplexity = DC_TRIVIAL;
+        clip.iFComplexity = FC_RECT;
+        clip.rclBounds = rect;
+        if (drv->copy_bits) ret = drv->copy_bits( so, src_so, &clip, xlate, &rect, &pt );
+        else ret = drv->bit_blt( so, src_so, NULL, &clip, xlate, &rect, &pt, NULL, NULL, NULL, 0xcccc );
+        if (!ret && so->iType == STYPE_BITMAP && so->pvScan0)
+            ret = EngCopyBits( so, src_so, &clip, xlate, &rect, &pt );
+        TRACE( "strip %d+%d: %d\n", y, rows, ret );
+        EngUnlockSurface( src_so );
+        EngDeleteSurface( src );
+        free_page_dib( hdc, dib );
+    }
+    __wine_eng_delete_xlate( xlate );
+    return ret;
+}
