+    impl->IAppxBlockMapFile_iface.lpVtbl = &file_vtbl;
+    impl->ref = 1;
+    impl->bm = bm;
+    IAppxBlockMapReader_AddRef( &bm->IAppxBlockMapReader_iface );
+    impl->file = f;
+    *out = &impl->IAppxBlockMapFile_iface;
+    return S_OK;
+}
