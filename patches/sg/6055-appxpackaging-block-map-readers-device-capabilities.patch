+/* takes data */
+HRESULT blockmap_reader_create( BYTE *data, SIZE_T size, IAppxBlockMapReader **out )
+{
+    struct blockmap *bm;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(bm = calloc( 1, sizeof(*bm) )))
+    {
+        free( data );
+        return E_OUTOFMEMORY;
+    }
+    bm->IAppxBlockMapReader_iface.lpVtbl = &reader_vtbl;
+    bm->ref = 1;
+    bm->data = data;
+    bm->size = size;
+    if (FAILED(hr = parse( bm )))
+    {
+        WARN( "not a block map, hr %#lx\n", hr );
+        blockmap_free( bm );
+        return hr;
+    }
+    *out = &bm->IAppxBlockMapReader_iface;
+    return S_OK;
