+    for (i = 0; i < bm->file_count; i++)
+        if (!wcsicmp( bm->files[i].name, name )) return file_create( bm, &bm->files[i], file );
+    return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
