+
+static HRESULT WINAPI reader_GetStream( IAppxBlockMapReader *iface, IStream **stream )
+{
+    struct blockmap *bm = impl_from_IAppxBlockMapReader( iface );
+    HGLOBAL mem;
+    HRESULT hr;
+
+    TRACE( "iface %p, stream %p.\n", iface, stream );
+    if (!stream) return E_POINTER;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, bm->size ? bm->size : 1 ))) return E_OUTOFMEMORY;
+    memcpy( GlobalLock( mem ), bm->data, bm->size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, stream ))) GlobalFree( mem );
+    else
+    {
+        ULARGE_INTEGER size;
+        size.QuadPart = bm->size;
+        IStream_SetSize( *stream, size );
+    }
+    return hr;
+}
