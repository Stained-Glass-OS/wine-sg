+
+HRESULT read_whole_stream( IStream *stream, SIZE_T max, BYTE **data, SIZE_T *size )
+{
+    STATSTG stat;
+    ULONG read;
+    HRESULT hr;
+
+    *data = NULL;
+    *size = 0;
+    if (FAILED(hr = IStream_Stat( stream, &stat, STATFLAG_NONAME ))) return hr;
+    if (stat.cbSize.QuadPart > max) return APPX_E_INVALID_BLOCKMAP;
+    if (!(*data = malloc( stat.cbSize.QuadPart + 1 ))) return E_OUTOFMEMORY;
+    /* from the current position, as the other readers */
+    if (FAILED(hr = IStream_Read( stream, *data, stat.cbSize.QuadPart, &read )))
+    {
+        free( *data );
+        *data = NULL;
+        return hr;
+    }
+    *size = read;
+    return S_OK;
+}
+
+/* AppxSignature.p7x: "PKCX", then a PKCS #7 signed message; its content's AXBM digest is the block map's */
+static HRESULT check_signature( const BYTE *blockmap, SIZE_T blockmap_size, const WCHAR *path )
+{
+    HCRYPTMSG msg = NULL;
+    HCERTSTORE store = NULL;
+    PCCERT_CONTEXT signer = NULL;
+    CERT_INFO *signer_info = NULL;
+    BYTE *sig = NULL, *content = NULL, digest[32];
+    DWORD sig_size = 0, read, len = 0, i;
+    HANDLE file;
+    HRESULT hr = TRUST_E_NOSIGNATURE;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    sig_size = GetFileSize( file, NULL );
+    if (sig_size > 4 && sig_size < 16 * 1024 * 1024 && (sig = malloc( sig_size ))
+            && ReadFile( file, sig, sig_size, &read, NULL ) && read == sig_size && !memcmp( sig, "PKCX", 4 ))
+        hr = S_OK;
+    CloseHandle( file );
+    if (FAILED(hr)) goto done;
+
+    /* the message, and its signature by its signer */
+    hr = TRUST_E_NOSIGNATURE;
+    if (!(msg = CryptMsgOpenToDecode( X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL ))) goto done;
+    if (!CryptMsgUpdate( msg, sig + 4, sig_size - 4, TRUE )) goto done;
+    if (!CryptMsgGetParam( msg, CMSG_CONTENT_PARAM, 0, NULL, &len ) || !(content = malloc( len ))
+            || !CryptMsgGetParam( msg, CMSG_CONTENT_PARAM, 0, content, &len ))
+        goto done;
+    hr = TRUST_E_BAD_DIGEST;
+    if ((store = CertOpenStore( CERT_STORE_PROV_MSG, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0, 0, msg )))
+    {
+        DWORD info_size = 0;
+
+        if (CryptMsgGetParam( msg, CMSG_SIGNER_CERT_INFO_PARAM, 0, NULL, &info_size )
+                && (signer_info = malloc( info_size ))
+                && CryptMsgGetParam( msg, CMSG_SIGNER_CERT_INFO_PARAM, 0, signer_info, &info_size ))
+            signer = CertGetSubjectCertificateFromStore( store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, signer_info );
+    }
+    if (!signer || !CryptMsgControl( msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, signer->pCertInfo ))
+    {
+        WARN( "the signature does not verify\n" );
+        goto done;
+    }
+
+    /* the digests: "APPX", then tagged SHA-256 values */
+    if (BCryptHash( BCRYPT_SHA256_ALG_HANDLE, NULL, 0, (BYTE *)blockmap, blockmap_size, digest, sizeof(digest) ))
+        goto done;
+    for (i = 0; i + 4 + sizeof(digest) <= len; i++)
+    {
+        if (memcmp( content + i, "AXBM", 4 )) continue;
+#ifndef SG_MUTANT_BLOCKMAP_SIGNATURE_IGNORED
+        if (memcmp( content + i + 4, digest, sizeof(digest) )) break;
+#endif
+        hr = S_OK;
+        break;
+    }
+    if (FAILED(hr)) WARN( "the block map is not the signed one\n" );
+
+done:
+    if (signer) CertFreeCertificateContext( signer );
+    if (store) CertCloseStore( store, 0 );
+    if (msg) CryptMsgClose( msg );
+    free( signer_info );
+    free( content );
+    free( sig );
+    return hr;
+}
+
+HRESULT validated_blockmap_reader_create( IStream *stream, const WCHAR *signature, IAppxBlockMapReader **out )
+{
+    BYTE *data;
+    SIZE_T size;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = read_whole_stream( stream, 256 * 1024 * 1024, &data, &size ))) return hr;
+    if (FAILED(hr = check_signature( data, size, signature )))
+    {
+        free( data );
+        return hr;
+    }
+    return blockmap_reader_create( data, size, out );
+}
