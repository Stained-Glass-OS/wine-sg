+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * The block map (AppxBlockMap.xml) names every file of a package with its
+ * size, the size of its ZIP local file header, and the hash (and, for
+ * compressed files, the compressed size) of each 64 KiB block. A validated
+ * reader also checks the block map's digest in the package signature
+ * (AppxSignature.p7x: "PKCX" and a PKCS #7 message whose indirect data holds
+ * the AXBM digest) and that message's signature.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "bcrypt.h"
+#include "wincrypt.h"
+#include "xmllite.h"
+#include "urlmon.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+#define BLOCK_SIZE 65536
+#define MAX_HASH   64
+
+struct bm_block
+{
+    BYTE hash[MAX_HASH];
+    UINT32 compressed_size;
+};
+
+struct bm_file
+{
+    WCHAR *name;
+    UINT64 size;
+    UINT32 lfh_size;
+    unsigned int block_count;
+    struct bm_block *blocks;
+};
+
+struct blockmap
+{
+    IAppxBlockMapReader IAppxBlockMapReader_iface;
+    LONG ref;
+    BYTE *data;                 /* the XML */
+    SIZE_T size;
+    WCHAR *hash_method;
+    BCRYPT_ALG_HANDLE hash_alg;
+    ULONG hash_size;
+    unsigned int file_count;
+    struct bm_file *files;
+};
+
+static void blockmap_free( struct blockmap *bm )
+{
+    unsigned int i;
+
+    for (i = 0; i < bm->file_count; i++)
+    {
+        free( bm->files[i].name );
+        free( bm->files[i].blocks );
+    }
+    free( bm->files );
+    free( bm->hash_method );
+    free( bm->data );
+    free( bm );
+}
+
+static int b64val( WCHAR c )
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+static BOOL base64_decode( const WCHAR *s, BYTE *out, ULONG size )
+{
+    ULONG n = 0;
+    UINT32 acc = 0;
+    int bits = 0, v;
+
+    for (; *s && *s != '='; s++)
+    {
+        if ((v = b64val( *s )) < 0) return FALSE;
+        acc = (acc << 6) | v;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            if (n >= size) return FALSE;
+            out[n++] = acc >> bits;
+        }
+    }
+    return n == size;
+}
+
+static HRESULT attr( IXmlReader *reader, const WCHAR *name, const WCHAR **value )
+{
+    HRESULT hr = IXmlReader_MoveToAttributeByName( reader, name, NULL );
+    *value = NULL;
+    if (hr != S_OK) return S_FALSE;
+    return IXmlReader_GetValue( reader, value, NULL );
+}
+
+static BOOL parse_u64( const WCHAR *text, UINT64 *value )
+{
+    WCHAR *end;
+
+    if (!text || !text[0]) return FALSE;
+    *value = _wcstoui64( text, &end, 10 );
+    return !*end;
+}
+
+static HRESULT parse( struct blockmap *bm )
+{
+    struct bm_file *cur = NULL;
+    unsigned int blocks_seen = 0;
+    BOOL have_root = FALSE;
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType type;
+    HGLOBAL mem;
+    HRESULT hr;
+
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, bm->size ? bm->size : 1 ))) return E_OUTOFMEMORY;
+    memcpy( GlobalLock( mem ), bm->data, bm->size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, &stream )))
+    {
+        GlobalFree( mem );
+        return hr;
+    }
+    if (SUCCEEDED(hr = CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL )))
+    {
+        IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+        hr = IXmlReader_SetInput( reader, (IUnknown *)stream );
+    }
+
+    while (SUCCEEDED(hr) && (hr = IXmlReader_Read( reader, &type )) == S_OK)
+    {
+        const WCHAR *name, *value;
+        UINT depth;
+
+        if (FAILED(hr = IXmlReader_GetDepth( reader, &depth ))) break;
+        if (type == XmlNodeType_EndElement)
+        {
+            if (cur && depth == 1)
+            {
+                if (blocks_seen != cur->block_count) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+                cur = NULL;
+            }
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        if (FAILED(hr = IXmlReader_GetLocalName( reader, &name, NULL ))) break;
+
+        if (depth == 0)
+        {
+            if (wcscmp( name, L"BlockMap" )) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            have_root = TRUE;
+            if (FAILED(hr = attr( reader, L"HashMethod", &value ))) break;
+            if (value && !wcscmp( value, L"http://www.w3.org/2001/04/xmlenc#sha256" ))
+            { bm->hash_alg = BCRYPT_SHA256_ALG_HANDLE; bm->hash_size = 32; }
+            else if (value && !wcscmp( value, L"http://www.w3.org/2001/04/xmldsig-more#sha384" ))
+            { bm->hash_alg = BCRYPT_SHA384_ALG_HANDLE; bm->hash_size = 48; }
+            else if (value && !wcscmp( value, L"http://www.w3.org/2001/04/xmlenc#sha512" ))
+            { bm->hash_alg = BCRYPT_SHA512_ALG_HANDLE; bm->hash_size = 64; }
+            else { WARN( "hash method %s\n", debugstr_w( value ) ); hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (!(bm->hash_method = strdupW( value ))) { hr = E_OUTOFMEMORY; break; }
+        }
+        else if (depth == 1 && !wcscmp( name, L"File" ))
+        {
+            struct bm_file *files;
+            UINT64 size, lfh = 0;
+            BOOL empty = IXmlReader_IsEmptyElement( reader );
+            unsigned int i;
+
+            if (attr( reader, L"Size", &value ) != S_OK || !parse_u64( value, &size )) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (attr( reader, L"LfhSize", &value ) == S_OK && value && !parse_u64( value, &lfh ))
+            { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (attr( reader, L"Name", &value ) != S_OK || !value || !value[0]) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            for (i = 0; i < bm->file_count; i++)
+                if (!wcsicmp( bm->files[i].name, value )) break;
+            if (i < bm->file_count || bm->file_count >= 0x100000 || size > ((UINT64)1 << 40))
+            { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (!(files = realloc( bm->files, (bm->file_count + 1) * sizeof(*files) ))) { hr = E_OUTOFMEMORY; break; }
+            bm->files = files;
+            cur = &files[bm->file_count];
+            memset( cur, 0, sizeof(*cur) );
+            if (!(cur->name = strdupW( value ))) { hr = E_OUTOFMEMORY; break; }
+            bm->file_count++;
+            cur->size = size;
+            cur->lfh_size = lfh;
+            cur->block_count = (size + BLOCK_SIZE - 1) / BLOCK_SIZE;
+            if (cur->block_count && !(cur->blocks = calloc( cur->block_count, sizeof(*cur->blocks) )))
+            { hr = E_OUTOFMEMORY; break; }
+            blocks_seen = 0;
+            if (empty)
+            {
+                if (cur->block_count) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+                cur = NULL;
+            }
+        }
+        else if (depth == 2 && cur && !wcscmp( name, L"Block" ))
+        {
+            struct bm_block *block;
+            UINT64 compressed;
+
+            if (blocks_seen >= cur->block_count) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            block = &cur->blocks[blocks_seen];
+            if (attr( reader, L"Hash", &value ) != S_OK || !value || !base64_decode( value, block->hash, bm->hash_size ))
+            { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            /* no Size: a stored block, as long as it is */
+            if (attr( reader, L"Size", &value ) == S_OK && value)
+            {
+                if (!parse_u64( value, &compressed ) || compressed > BLOCK_SIZE * 2) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+                block->compressed_size = compressed;
+            }
+            else
+            {
+                UINT64 off = (UINT64)blocks_seen * BLOCK_SIZE;
+                block->compressed_size = cur->size - off < BLOCK_SIZE ? cur->size - off : BLOCK_SIZE;
+            }
+            blocks_seen++;
+        }
+    }
+    if (hr == S_FALSE) hr = S_OK;
+    if (SUCCEEDED(hr) && (cur || !have_root)) hr = APPX_E_INVALID_BLOCKMAP;
+    if (FAILED(hr) && hr != E_OUTOFMEMORY) hr = APPX_E_INVALID_BLOCKMAP;
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return hr;
+}
+
+/* ---- IAppxBlockMapBlock ---------------------------------------------------- */
+
+struct block
+{
+    IAppxBlockMapBlock IAppxBlockMapBlock_iface;
+    LONG ref;
+    struct blockmap *bm;        /* referenced */
+    const struct bm_block *block;
+};
+
+static inline struct block *impl_from_IAppxBlockMapBlock( IAppxBlockMapBlock *iface )
+{
+    return CONTAINING_RECORD( iface, struct block, IAppxBlockMapBlock_iface );
+}
+
+static HRESULT WINAPI block_QueryInterface( IAppxBlockMapBlock *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxBlockMapBlock ))
+    {
+        *out = iface;
+        IAppxBlockMapBlock_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI block_AddRef( IAppxBlockMapBlock *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxBlockMapBlock( iface )->ref );
+}
+
+static ULONG WINAPI block_Release( IAppxBlockMapBlock *iface )
+{
+    struct block *impl = impl_from_IAppxBlockMapBlock( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IAppxBlockMapReader_Release( &impl->bm->IAppxBlockMapReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+/* the hash is the block's: valid while the block is */
+static HRESULT WINAPI block_GetHash( IAppxBlockMapBlock *iface, UINT32 *size, BYTE **buffer )
+{
+    struct block *impl = impl_from_IAppxBlockMapBlock( iface );
+
+    TRACE( "iface %p, size %p, buffer %p.\n", iface, size, buffer );
+    if (!size || !buffer) return E_POINTER;
+    *size = impl->bm->hash_size;
+    *buffer = (BYTE *)impl->block->hash;
+    return S_OK;
+}
+
+static HRESULT WINAPI block_GetCompressedSize( IAppxBlockMapBlock *iface, UINT32 *size )
+{
+    if (!size) return E_POINTER;
+    *size = impl_from_IAppxBlockMapBlock( iface )->block->compressed_size;
+    return S_OK;
+}
+
+static const IAppxBlockMapBlockVtbl block_vtbl =
+{
+    block_QueryInterface, block_AddRef, block_Release,
+    block_GetHash, block_GetCompressedSize,
+};
+
+/* ---- IAppxBlockMapBlocksEnumerator, IAppxBlockMapFilesEnumerator ----------- */
+
+struct item_enum
+{
+    IAppxBlockMapBlocksEnumerator IAppxBlockMapBlocksEnumerator_iface;
+    IAppxBlockMapFilesEnumerator IAppxBlockMapFilesEnumerator_iface;
+    LONG ref;
+    struct blockmap *bm;        /* referenced */
+    const struct bm_file *file; /* the blocks of this file, or NULL: the files */
+    unsigned int index, count;
+};
+
+static HRESULT file_create( struct blockmap *bm, const struct bm_file *file, IAppxBlockMapFile **out );
+
+static inline struct item_enum *impl_from_IAppxBlockMapBlocksEnumerator( IAppxBlockMapBlocksEnumerator *iface )
+{
+    return CONTAINING_RECORD( iface, struct item_enum, IAppxBlockMapBlocksEnumerator_iface );
+}
+
+static inline struct item_enum *impl_from_IAppxBlockMapFilesEnumerator( IAppxBlockMapFilesEnumerator *iface )
+{
+    return CONTAINING_RECORD( iface, struct item_enum, IAppxBlockMapFilesEnumerator_iface );
+}
+
+static ULONG item_enum_release( struct item_enum *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IAppxBlockMapReader_Release( &impl->bm->IAppxBlockMapReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI blocks_QueryInterface( IAppxBlockMapBlocksEnumerator *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxBlockMapBlocksEnumerator ))
+    {
+        *out = iface;
+        IAppxBlockMapBlocksEnumerator_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI blocks_AddRef( IAppxBlockMapBlocksEnumerator *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxBlockMapBlocksEnumerator( iface )->ref );
+}
+
+static ULONG WINAPI blocks_Release( IAppxBlockMapBlocksEnumerator *iface )
+{
+    return item_enum_release( impl_from_IAppxBlockMapBlocksEnumerator( iface ) );
+}
+
+static HRESULT WINAPI blocks_GetCurrent( IAppxBlockMapBlocksEnumerator *iface, IAppxBlockMapBlock **out )
+{
+    struct item_enum *impl = impl_from_IAppxBlockMapBlocksEnumerator( iface );
+    struct block *block;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (impl->index >= impl->count) return APPX_E_PACKAGING_INTERNAL;
+    if (!(block = calloc( 1, sizeof(*block) ))) return E_OUTOFMEMORY;
+    block->IAppxBlockMapBlock_iface.lpVtbl = &block_vtbl;
+    block->ref = 1;
+    block->bm = impl->bm;
+    IAppxBlockMapReader_AddRef( &impl->bm->IAppxBlockMapReader_iface );
+    block->block = &impl->file->blocks[impl->index];
+    *out = &block->IAppxBlockMapBlock_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI blocks_GetHasCurrent( IAppxBlockMapBlocksEnumerator *iface, BOOL *has )
+{
+    struct item_enum *impl = impl_from_IAppxBlockMapBlocksEnumerator( iface );
+    if (!has) return E_POINTER;
+    *has = impl->index < impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI blocks_MoveNext( IAppxBlockMapBlocksEnumerator *iface, BOOL *has )
+{
+    struct item_enum *impl = impl_from_IAppxBlockMapBlocksEnumerator( iface );
+    if (!has) return E_POINTER;
+    if (impl->index < impl->count) impl->index++;
+    *has = impl->index < impl->count;
+    return S_OK;
+}
+
+static const IAppxBlockMapBlocksEnumeratorVtbl blocks_vtbl =
+{
+    blocks_QueryInterface, blocks_AddRef, blocks_Release,
+    blocks_GetCurrent, blocks_GetHasCurrent, blocks_MoveNext,
+};
+
+static HRESULT WINAPI files_QueryInterface( IAppxBlockMapFilesEnumerator *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxBlockMapFilesEnumerator ))
+    {
+        *out = iface;
+        IAppxBlockMapFilesEnumerator_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI files_AddRef( IAppxBlockMapFilesEnumerator *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxBlockMapFilesEnumerator( iface )->ref );
+}
+
+static ULONG WINAPI files_Release( IAppxBlockMapFilesEnumerator *iface )
+{
+    return item_enum_release( impl_from_IAppxBlockMapFilesEnumerator( iface ) );
+}
+
+static HRESULT WINAPI files_GetCurrent( IAppxBlockMapFilesEnumerator *iface, IAppxBlockMapFile **out )
+{
+    struct item_enum *impl = impl_from_IAppxBlockMapFilesEnumerator( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (impl->index >= impl->count) return APPX_E_PACKAGING_INTERNAL;
+    return file_create( impl->bm, &impl->bm->files[impl->index], out );
+}
+
+static HRESULT WINAPI files_GetHasCurrent( IAppxBlockMapFilesEnumerator *iface, BOOL *has )
+{
+    struct item_enum *impl = impl_from_IAppxBlockMapFilesEnumerator( iface );
+    if (!has) return E_POINTER;
+    *has = impl->index < impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI files_MoveNext( IAppxBlockMapFilesEnumerator *iface, BOOL *has )
+{
+    struct item_enum *impl = impl_from_IAppxBlockMapFilesEnumerator( iface );
+    if (!has) return E_POINTER;
+    if (impl->index < impl->count) impl->index++;
+    *has = impl->index < impl->count;
+    return S_OK;
+}
+
+static const IAppxBlockMapFilesEnumeratorVtbl files_vtbl =
+{
+    files_QueryInterface, files_AddRef, files_Release,
+    files_GetCurrent, files_GetHasCurrent, files_MoveNext,
+};
+
+static struct item_enum *item_enum_create( struct blockmap *bm, const struct bm_file *file )
+{
+    struct item_enum *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IAppxBlockMapBlocksEnumerator_iface.lpVtbl = &blocks_vtbl;
+    impl->IAppxBlockMapFilesEnumerator_iface.lpVtbl = &files_vtbl;
+    impl->ref = 1;
+    impl->bm = bm;
+    IAppxBlockMapReader_AddRef( &bm->IAppxBlockMapReader_iface );
+    impl->file = file;
+    impl->count = file ? file->block_count : bm->file_count;
+    return impl;
+}
+
+/* ---- IAppxBlockMapFile ----------------------------------------------------- */
+
+struct file
+{
+    IAppxBlockMapFile IAppxBlockMapFile_iface;
+    LONG ref;
+    struct blockmap *bm;        /* referenced */
+    const struct bm_file *file;
+};
+
+static inline struct file *impl_from_IAppxBlockMapFile( IAppxBlockMapFile *iface )
+{
+    return CONTAINING_RECORD( iface, struct file, IAppxBlockMapFile_iface );
+}
+
+static HRESULT WINAPI file_QueryInterface( IAppxBlockMapFile *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxBlockMapFile ))
+    {
+        *out = iface;
+        IAppxBlockMapFile_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI file_AddRef( IAppxBlockMapFile *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxBlockMapFile( iface )->ref );
+}
+
+static ULONG WINAPI file_Release( IAppxBlockMapFile *iface )
+{
+    struct file *impl = impl_from_IAppxBlockMapFile( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IAppxBlockMapReader_Release( &impl->bm->IAppxBlockMapReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI file_GetBlocks( IAppxBlockMapFile *iface, IAppxBlockMapBlocksEnumerator **blocks )
+{
+    struct file *impl = impl_from_IAppxBlockMapFile( iface );
+    struct item_enum *e;
+
+    TRACE( "iface %p, blocks %p.\n", iface, blocks );
+    if (!blocks) return E_POINTER;
+    if (!(e = item_enum_create( impl->bm, impl->file ))) return E_OUTOFMEMORY;
+    *blocks = &e->IAppxBlockMapBlocksEnumerator_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_GetLocalFileHeaderSize( IAppxBlockMapFile *iface, UINT32 *size )
+{
+    if (!size) return E_POINTER;
+    *size = impl_from_IAppxBlockMapFile( iface )->file->lfh_size;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_GetName( IAppxBlockMapFile *iface, LPWSTR *name )
+{
+    if (!name) return E_POINTER;
+    return (*name = co_strdupW( impl_from_IAppxBlockMapFile( iface )->file->name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI file_GetUncompressedSize( IAppxBlockMapFile *iface, UINT64 *size )
+{
+    if (!size) return E_POINTER;
+    *size = impl_from_IAppxBlockMapFile( iface )->file->size;
+    return S_OK;
+}
+
+/* the stream's content, from its start, against the file's size and block hashes */
+static HRESULT WINAPI file_ValidateFileHash( IAppxBlockMapFile *iface, IStream *stream, BOOL *valid )
+{
+    struct file *impl = impl_from_IAppxBlockMapFile( iface );
+    const struct bm_file *f = impl->file;
+    BYTE *buffer, hash[MAX_HASH], extra;
+    LARGE_INTEGER zero = {{ 0 }};
+    unsigned int i;
+    ULONG read;
+    HRESULT hr;
+
+    TRACE( "iface %p, stream %p, valid %p.\n", iface, stream, valid );
+    if (!stream || !valid) return E_POINTER;
+    *valid = FALSE;
+    if (FAILED(hr = IStream_Seek( stream, zero, STREAM_SEEK_SET, NULL ))) return hr;
+    if (!(buffer = malloc( BLOCK_SIZE ))) return E_OUTOFMEMORY;
+    for (i = 0; i < f->block_count; i++)
+    {
+        UINT64 off = (UINT64)i * BLOCK_SIZE;
+        ULONG len = f->size - off < BLOCK_SIZE ? f->size - off : BLOCK_SIZE;
+
+        if (FAILED(hr = IStream_Read( stream, buffer, len, &read ))) break;
+        if (read != len) break;
+        if (BCryptHash( impl->bm->hash_alg, NULL, 0, buffer, len, hash, impl->bm->hash_size )) break;
+#ifdef SG_MUTANT_BLOCKMAP_NO_VALIDATE
+        continue;
+#endif
+        if (memcmp( hash, f->blocks[i].hash, impl->bm->hash_size )) break;
+    }
+    free( buffer );
+    if (FAILED(hr)) return hr;
+    /* the whole of it, and nothing more */
+    if (i == f->block_count && SUCCEEDED(IStream_Read( stream, &extra, 1, &read )) && !read) *valid = TRUE;
+    return S_OK;
+}
+
+static const IAppxBlockMapFileVtbl file_vtbl =
+{
