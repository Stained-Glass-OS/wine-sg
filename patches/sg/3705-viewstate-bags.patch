+/* The view state bags.  They are registry keys of the shell's "Bags" tree: per folder
+ * Bags\F<hash of the folder's item id list>\<bag name>, for all folders Bags\AllFolders\<bag name>;
+ * the per-folder inherit bag is below the bag name as "Inherit".  The names Bags, AllFolders and the
+ * bag name as the subkey are the shell's; the hashed slot and the Inherit key are this implementation's
+ * (the shell numbers its slots), and nothing reads them but this function.  Without
+ * SHGVSPB_ROAM the per-user bags are in the local (non-roaming) part of the user's classes. */
+#define VS_MAX_SOURCES 24
+
+struct vs_source { HKEY root; WCHAR path[260]; };
+
+struct vs_bag
+{
+    IPropertyBag IPropertyBag_iface;
+    LONG ref;
+    int count;
+    struct vs_source src[VS_MAX_SOURCES]; /* src[0] is the one written to */
+};
+
+HRESULT WINAPI SHCreatePropertyBagOnRegKey(HKEY, LPCWSTR, DWORD, REFIID, void **);
+
+static struct vs_bag *vs_bag_from_IPropertyBag(IPropertyBag *iface)
+{
+    return CONTAINING_RECORD(iface, struct vs_bag, IPropertyBag_iface);
+}
+
+static HRESULT WINAPI vs_bag_QueryInterface(IPropertyBag *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IPropertyBag))
+    {
+        *obj = iface;
+        IPropertyBag_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI vs_bag_AddRef(IPropertyBag *iface)
+{
+    return InterlockedIncrement(&vs_bag_from_IPropertyBag(iface)->ref);
+}
+
+static ULONG WINAPI vs_bag_Release(IPropertyBag *iface)
+{
+    struct vs_bag *bag = vs_bag_from_IPropertyBag(iface);
+    ULONG ref = InterlockedDecrement(&bag->ref);
+
+    if (!ref) HeapFree(GetProcessHeap(), 0, bag);
+    return ref;
+}
+
+static HRESULT WINAPI vs_bag_Read(IPropertyBag *iface, const WCHAR *name, VARIANT *var, IErrorLog *log)
+{
+    struct vs_bag *bag = vs_bag_from_IPropertyBag(iface);
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    int i;
+
+    TRACE("%p, %s, %p, %p.\n", bag, debugstr_w(name), var, log);
+
+    if (!name || !var) return E_POINTER;
+    for (i = 0; i < bag->count; i++)
+    {
+        IPropertyBag *src;
+        VARIANT v = *var;
+
+        if (FAILED(SHCreatePropertyBagOnRegKey(bag->src[i].root, bag->src[i].path, STGM_READ, &IID_IPropertyBag, (void **)&src)))
+            continue;
+#ifdef SG_MUTANT_VSBAG_NOFALLBACK
+        if (i) { IPropertyBag_Release(src); break; }
+#endif
+        hr = IPropertyBag_Read(src, name, &v, log);
+        IPropertyBag_Release(src);
+        if (SUCCEEDED(hr))
+        {
+            *var = v;
+            return hr;
+        }
+    }
+    return hr;
+}
+
+static HRESULT WINAPI vs_bag_Write(IPropertyBag *iface, const WCHAR *name, VARIANT *var)
+{
+    struct vs_bag *bag = vs_bag_from_IPropertyBag(iface);
+    IPropertyBag *dst;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p.\n", bag, debugstr_w(name), var);
+
+    if (!name || !var) return E_POINTER;
+    hr = SHCreatePropertyBagOnRegKey(bag->src[0].root, bag->src[0].path, STGM_WRITE | STGM_CREATE, &IID_IPropertyBag, (void **)&dst);
+    if (FAILED(hr)) return hr;
+    hr = IPropertyBag_Write(dst, name, var);
+    IPropertyBag_Release(dst);
+    return hr;
+}
+
+static const IPropertyBagVtbl vs_bag_vtbl =
+{
+    vs_bag_QueryInterface,
+    vs_bag_AddRef,
+    vs_bag_Release,
+    vs_bag_Read,
+    vs_bag_Write,
+};
+
+static UINT vs_pidl_size(PCIDLIST_ABSOLUTE pidl)
+{
+    const BYTE *p = (const BYTE *)pidl;
+    UINT size = 0, cb;
+
+    while ((cb = *(const USHORT *)(p + size))) size += cb;
+    return size;
+}
+
+static void vs_add(struct vs_bag *bag, BOOL all_users, DWORD flags, const WCHAR *folder, const WCHAR *bag_name, BOOL inherit)
+{
+    struct vs_source *src;
+
+    if (bag->count == VS_MAX_SOURCES) return;
+    src = &bag->src[bag->count++];
+    if (all_users)
+    {
+        src->root = HKEY_LOCAL_MACHINE;
+        lstrcpyW(src->path, L"Software\\Microsoft\\Windows\\Shell\\Bags\\");
+    }
+    else
+    {
+        src->root = HKEY_CURRENT_USER;
+        lstrcpyW(src->path, (flags & SHGVSPB_ROAM) ? L"Software\\Microsoft\\Windows\\Shell\\Bags\\"
+                 : L"Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\Shell\\Bags\\");
+    }
+    lstrcatW(src->path, folder);
+    lstrcatW(src->path, L"\\");
+    lstrcatW(src->path, bag_name);
+    if (inherit) lstrcatW(src->path, L"\\Inherit");
+}
+
+/* the slot of a folder is named by a hash of its parsing name, so that it does not depend on the
+ * times and sizes an item id carries; an id list the shell cannot name is hashed as it is */
+static void vs_folder_name(WCHAR *out, const BYTE *pidl, UINT size)
+{
+    typedef HRESULT (WINAPI *get_name_t)(PCIDLIST_ABSOLUTE, int, WCHAR **);
+    static get_name_t get_name;
+    DWORD h = 2166136261u;
+    WCHAR *str = NULL;
+    BYTE *copy;
+    UINT i;
+
+    if (!get_name)
+    {
+        HMODULE shell32 = LoadLibraryW(L"shell32.dll");
+        if (shell32) get_name = (get_name_t)GetProcAddress(shell32, "SHGetNameFromIDList");
+    }
+    copy = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, size + 2);
+    if (copy)
+    {
+        memcpy(copy, pidl, size);
+        if (get_name && get_name((PCIDLIST_ABSOLUTE)copy, 0x80028000 /* SIGDN_DESKTOPABSOLUTEPARSING */, &str) == S_OK && str)
+        {
+            for (i = 0; str[i]; i++) h = (h ^ (WCHAR)towlower(str[i])) * 16777619u;
+            CoTaskMemFree(str);
+            HeapFree(GetProcessHeap(), 0, copy);
+            wsprintfW(out, L"F%08lX", h);
+            return;
+        }
+        HeapFree(GetProcessHeap(), 0, copy);
+    }
+    for (i = 0; i < size; i++) h = (h ^ pidl[i]) * 16777619u;
+    wsprintfW(out, L"F%08lX", h);
+}
