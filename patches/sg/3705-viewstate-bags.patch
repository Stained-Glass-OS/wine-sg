+/**************************************************************************
+ * View state: the property bag named by SetPropertyBag keeps the view mode and the folder flags of
+ * a folder; they are written when the view is destroyed or a navigation begins, and read when the
+ * view of a folder is created.
+ */
+static void save_view_state(ExplorerBrowserImpl *This)
+{
+    IPropertyBag *bag;
+    IFolderView2 *view;
+    VARIANT var;
+    DWORD flags;
+    UINT mode;
+
+#ifdef SG_MUTANT_EB_NOSAVE
+    return;
+#endif
+    if (!This->propbag_name || !This->psv || !This->current_pidl) return;
+    if (FAILED(IShellView_QueryInterface(This->psv, &IID_IFolderView2, (void **)&view))) return;
+    if (SUCCEEDED(IFolderView2_GetCurrentViewMode(view, &mode)) && SUCCEEDED(IFolderView2_GetCurrentFolderFlags(view, &flags))
+            && SUCCEEDED(SHGetViewStatePropertyBag(This->current_pidl, This->propbag_name, SHGVSPB_FOLDER, &IID_IPropertyBag, (void **)&bag)))
+    {
+        V_VT(&var) = VT_I4;
+        V_I4(&var) = mode;
+        IPropertyBag_Write(bag, L"Mode", &var);
+        V_I4(&var) = flags;
+        IPropertyBag_Write(bag, L"FFlags", &var);
+        IPropertyBag_Release(bag);
+    }
+    IFolderView2_Release(view);
+}
+
+static void load_view_state(ExplorerBrowserImpl *This, PCIDLIST_ABSOLUTE pidl)
+{
+    IPropertyBag *bag;
+    VARIANT var;
+
+#ifdef SG_MUTANT_EB_NOLOAD
+    return;
+#endif
+    if (!This->propbag_name) return;
+    if (FAILED(SHGetViewStatePropertyBag(pidl, This->propbag_name, SHGVSPB_FOLDER, &IID_IPropertyBag, (void **)&bag))) return;
+    V_VT(&var) = VT_I4;
+    if (SUCCEEDED(IPropertyBag_Read(bag, L"Mode", &var, NULL)) && V_I4(&var) > 0 && V_I4(&var) <= FVM_THUMBSTRIP)
+        This->fs.ViewMode = V_I4(&var);
+    V_VT(&var) = VT_I4;
+    if (SUCCEEDED(IPropertyBag_Read(bag, L"FFlags", &var, NULL)))
+        This->fs.fFlags = (V_I4(&var) & ~FWF_NOCLIENTEDGE) | (This->fs.fFlags & FWF_NOCLIENTEDGE);
+    IPropertyBag_Release(bag);
+}
+
+static void apply_empty_text(ExplorerBrowserImpl *This)
+{
+    IFolderView2 *view;
+
+    if (!This->empty_text || !This->psv) return;
+    if (SUCCEEDED(IShellView_QueryInterface(This->psv, &IID_IFolderView2, (void **)&view)))
+    {
+        IFolderView2_SetText(view, FVST_EMPTYTEXT, This->empty_text);
+        IFolderView2_Release(view);
+    }
+}
+
+/* the stream of IShellBrowser::GetViewStateStream: kept in the view state bag as a binary value and
+ * written back when the stream is committed or released */
+struct view_stream
+{
+    IStream IStream_iface;
+    LONG ref;
+    IStream *mem;
+    IPropertyBag *bag;
+    BOOL write;
+};
+
+static inline struct view_stream *impl_from_view_stream(IStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct view_stream, IStream_iface);
+}
+
+static void view_stream_flush(struct view_stream *This)
+{
+    SAFEARRAY *array;
+    VARIANT var;
+    STATSTG stat;
+    LARGE_INTEGER zero = {{0}};
+    ULARGE_INTEGER pos;
+    void *bytes;
+    ULONG read;
+
+#ifdef SG_MUTANT_EB_NOFLUSH
+    return;
+#endif
+    if (!This->write || FAILED(IStream_Stat(This->mem, &stat, STATFLAG_NONAME))) return;
+    if (!(array = SafeArrayCreateVector(VT_UI1, 0, stat.cbSize.LowPart))) return;
+    SafeArrayAccessData(array, &bytes);
+    IStream_Seek(This->mem, zero, STREAM_SEEK_CUR, &pos);
+    IStream_Seek(This->mem, zero, STREAM_SEEK_SET, NULL);
+    IStream_Read(This->mem, bytes, stat.cbSize.LowPart, &read);
+    zero.QuadPart = pos.QuadPart;
+    IStream_Seek(This->mem, zero, STREAM_SEEK_SET, NULL);
+    SafeArrayUnaccessData(array);
+    V_VT(&var) = VT_ARRAY | VT_UI1;
+    V_ARRAY(&var) = array;
+    IPropertyBag_Write(This->bag, L"ViewStream", &var);
+    SafeArrayDestroy(array);
+}
+
+static HRESULT WINAPI view_stream_QueryInterface(IStream *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ISequentialStream) || IsEqualIID(riid, &IID_IStream))
+    {
+        *ppv = iface;
+        IStream_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI view_stream_AddRef(IStream *iface)
+{
+    return InterlockedIncrement(&impl_from_view_stream(iface)->ref);
+}
+
+static ULONG WINAPI view_stream_Release(IStream *iface)
+{
+    struct view_stream *This = impl_from_view_stream(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        view_stream_flush(This);
+        IStream_Release(This->mem);
+        IPropertyBag_Release(This->bag);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_stream_Read(IStream *iface, void *pv, ULONG cb, ULONG *read)
+{
+    return IStream_Read(impl_from_view_stream(iface)->mem, pv, cb, read);
+}
+
+static HRESULT WINAPI view_stream_Write(IStream *iface, const void *pv, ULONG cb, ULONG *written)
+{
+    struct view_stream *This = impl_from_view_stream(iface);
+
+    if (!This->write) return STG_E_ACCESSDENIED;
+    return IStream_Write(This->mem, pv, cb, written);
+}
+
+static HRESULT WINAPI view_stream_Seek(IStream *iface, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *pos)
+{
+    return IStream_Seek(impl_from_view_stream(iface)->mem, move, origin, pos);
+}
+
+static HRESULT WINAPI view_stream_SetSize(IStream *iface, ULARGE_INTEGER size)
+{
+    struct view_stream *This = impl_from_view_stream(iface);
+
+    if (!This->write) return STG_E_ACCESSDENIED;
+    return IStream_SetSize(This->mem, size);
+}
+
+static HRESULT WINAPI view_stream_CopyTo(IStream *iface, IStream *dest, ULARGE_INTEGER cb, ULARGE_INTEGER *read, ULARGE_INTEGER *written)
+{
+    return IStream_CopyTo(impl_from_view_stream(iface)->mem, dest, cb, read, written);
+}
+
+static HRESULT WINAPI view_stream_Commit(IStream *iface, DWORD flags)
+{
+    view_stream_flush(impl_from_view_stream(iface));
+    return S_OK;
+}
+
+static HRESULT WINAPI view_stream_Revert(IStream *iface)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI view_stream_LockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER cb, DWORD type)
+{
+    return STG_E_INVALIDFUNCTION;
+}
+
+static HRESULT WINAPI view_stream_UnlockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER cb, DWORD type)
+{
+    return STG_E_INVALIDFUNCTION;
+}
+
+static HRESULT WINAPI view_stream_Stat(IStream *iface, STATSTG *stat, DWORD flags)
+{
+    return IStream_Stat(impl_from_view_stream(iface)->mem, stat, flags);
+}
+
+static HRESULT WINAPI view_stream_Clone(IStream *iface, IStream **clone)
+{
+    *clone = NULL;
+    return E_NOTIMPL;
+}
+
+static const IStreamVtbl view_stream_vtbl =
+{
+    view_stream_QueryInterface,
+    view_stream_AddRef,
+    view_stream_Release,
+    view_stream_Read,
+    view_stream_Write,
+    view_stream_Seek,
+    view_stream_SetSize,
+    view_stream_CopyTo,
+    view_stream_Commit,
+    view_stream_Revert,
+    view_stream_LockRegion,
+    view_stream_UnlockRegion,
+    view_stream_Stat,
+    view_stream_Clone
+};
