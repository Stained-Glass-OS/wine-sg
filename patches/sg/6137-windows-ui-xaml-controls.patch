+static HRESULT new_control( enum control_kind kind, IInspectable *outer, IInspectable **inner, void **value )
+{
+    static const struct xclass *classes[] = { &control_class, &content_control_class, &user_control_class, &page_class };
+    struct control *control;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    controls_init();
+    if (!(control = calloc( 1, sizeof(*control) ))) return E_OUTOFMEMORY;
+    control->kind = kind;
+    control->IControl_iface.vtbl = control_vtbl;
+    control->IControl2_iface.vtbl = control2_vtbl;
+    control->IControl3_iface.vtbl = control3_vtbl;
+    control->IControl4_iface.vtbl = control4_vtbl;
+    control->IControl5_iface.vtbl = control5_vtbl;
+    control->IControl7_iface.vtbl = control7_vtbl;
+    control->IControlOverrides_iface.vtbl = control_overrides_vtbl;
+    control->IControlOverrides6_iface.vtbl = control_overrides6_vtbl;
+    control->IControlProtected_iface.vtbl = control_protected_vtbl;
+    control->IContentControl_iface.vtbl = content_vtbl;
+    control->IContentControl2_iface.vtbl = content2_vtbl;
+    control->IContentControlOverrides_iface.vtbl = content_overrides_vtbl;
+    control->IUserControl_iface.vtbl = user_vtbl;
+    control->IPage_iface.vtbl = page_vtbl;
+    control->IPageOverrides_iface.vtbl = page_overrides_vtbl;
+    uielem_init( &control->e, classes[kind], &control_ops, outer );
+    if (outer)
+    {
+        *inner = &control->e.d.obj.IInspectable_inner;
+        IUnknown_AddRef( control->e.d.obj.outer );
+    }
+    switch (kind)
+    {
+    case KIND_CONTROL: *value = &control->IControl_iface; break;
+    case KIND_CONTENT: *value = &control->IContentControl_iface; break;
+    case KIND_USER: *value = &control->IUserControl_iface; break;
+    case KIND_PAGE: *value = &control->IPage_iface; break;
+    }
+    return S_OK;
+}
