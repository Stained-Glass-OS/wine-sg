+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * The controls applications derive their pages and user controls from.  A Control draws its
+ * Background and border itself (templates come with styles, later) and passes its text properties
+ * (Foreground, FontSize, FontFamily, FontWeight, FontStyle) down to the text inside it.  A
+ * ContentControl shows its Content: an element as its child, a string as text; a UserControl's and a
+ * Page's Content is an element.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <limits.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+enum control_kind { KIND_CONTROL, KIND_CONTENT, KIND_USER, KIND_PAGE };
+
+struct control
+{
+    struct uielem e;
+    struct xiface IControl_iface, IControl2_iface, IControl3_iface, IControl4_iface, IControl5_iface, IControl7_iface,
+                  IControlOverrides_iface, IControlOverrides6_iface, IControlProtected_iface;
+    struct xiface IContentControl_iface, IContentControl2_iface, IContentControlOverrides_iface;
+    struct xiface IUserControl_iface;
+    struct xiface IPage_iface, IPageOverrides_iface;
+    enum control_kind kind;
+    struct uielem *child;           /* what its content shows */
+    BOOL child_is_text;             /* a TextBlock of ours for a string content */
+};
+
+static struct xaml_property *prop_font_size, *prop_font_family, *prop_font_weight, *prop_font_style, *prop_font_stretch,
+                            *prop_character_spacing, *prop_foreground, *prop_is_tab_stop, *prop_is_enabled,
+                            *prop_tab_index, *prop_tab_navigation, *prop_template, *prop_padding, *prop_hcontent,
+                            *prop_vcontent, *prop_background, *prop_border_thickness, *prop_border_brush,
+                            *prop_default_style_key, *prop_is_text_scale_factor_enabled, *prop_use_system_focus_visuals,
+                            *prop_corner_radius;
+static struct xaml_property *prop_content, *prop_content_template, *prop_content_template_selector,
+                            *prop_content_transitions, *prop_user_content;
+static struct xaml_property *prop_frame, *prop_top_app_bar, *prop_bottom_app_bar, *prop_navigation_cache_mode;
+
+static const struct xclass control_class, content_control_class, user_control_class, page_class;
+
+static BOOL is_control( struct dobj *obj )
+{
+    const struct xclass *cls = obj->obj.cls;
+    return cls == &control_class || cls == &content_control_class || cls == &user_control_class || cls == &page_class;
+}
+
+static struct control *control_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct control, e );
+}
+
+static struct control *control_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct control, e.d.obj );
+}
+
+/* ---- values ---- */
+
+static HRESULT put_boxed( struct control *control, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &control->e.d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static DOUBLE get_dbl( struct control *control, struct xaml_property *prop, DOUBLE def )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( &control->e.d, prop, &box );
+    ret = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static INT32 get_enum( struct control *control, struct xaml_property *prop, const GUID *iid, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    dobj_get_value( &control->e.d, prop, &box );
+    ret = xunbox_enum( box, iid, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static boolean get_bool( struct control *control, struct xaml_property *prop, boolean def )
+{
+    IInspectable *box = NULL;
+    boolean ret;
+
+    dobj_get_value( &control->e.d, prop, &box );
+    ret = xunbox_boolean( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static void get_ref( struct control *control, struct xaml_property *prop, const GUID *iid, void *value, size_t size )
+{
+    IInspectable *box = NULL;
+
+    memset( value, 0, size );
+    dobj_get_value( &control->e.d, prop, &box );
+    xunbox_ref( box, iid, value, size );
+    if (box) IInspectable_Release( box );
+}
+
+/* the value a text property has for an element inside controls: the nearest control's own, with a
+ * reference, or NULL */
+IInspectable *xaml_control_inherited( struct uielem *elem, enum xaml_inherit which )
+{
+    struct xaml_property *prop;
+    IInspectable *value = NULL;
+
+    switch (which)
+    {
+    case XINHERIT_FOREGROUND: prop = prop_foreground; break;
+    case XINHERIT_FONT_SIZE: prop = prop_font_size; break;
+    case XINHERIT_FONT_FAMILY: prop = prop_font_family; break;
+    case XINHERIT_FONT_WEIGHT: prop = prop_font_weight; break;
+    case XINHERIT_FONT_STYLE: prop = prop_font_style; break;
+    default: return NULL;
+    }
+    if (!prop) return NULL;
+#ifdef SG_MUTANT_CONTROL_NO_INHERIT
+    return NULL;
+#endif
+    for (elem = elem->parent; elem; elem = elem->parent)
+    {
+        if (!is_control( &elem->d ) || !dobj_has_local( &elem->d, prop )) continue;
+        dobj_get_value( &elem->d, prop, &value );
+        return value;
+    }
+    return NULL;
+}
+
+static void inherited_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_text_inherited_changed( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+static void visual_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_invalidate_visuals();
+}
+
+/* ---- the content ---- */
+
+static void set_child( struct control *control, struct uielem *child, BOOL is_text )
+{
+    if (control->child == child) return;
+    if (control->child)
+    {
+        struct uielem *old = control->child;
+        control->child = NULL;
+        uielem_remove_child( &control->e, old );
+        if (control->child_is_text) IUnknown_Release( old->d.obj.outer );   /* ours */
+    }
+    control->child = child;
+    control->child_is_text = is_text;
+    if (child) uielem_add_child( &control->e, child );
+}
+
+static void content_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct control *control = control_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+    struct uielem *child = uielem_from_inspectable( new_value );
+    WCHAR *str;
+
+    if (child)
+    {
+        if (child->parent && child->parent != &control->e)
+        {
+            WARN( "%p is already another element's child\n", child );
+            child = NULL;
+        }
+        set_child( control, child, FALSE );
+    }
+    else if (prop == prop_content && (str = xunbox_string( new_value )))
+    {
+        /* a string is shown as text */
+        IInspectable *text = xaml_text_block( str );
+        free( str );
+        set_child( control, NULL, FALSE );
+        if (text && (child = uielem_from_inspectable( text ))) set_child( control, child, TRUE );
+        else if (text) IInspectable_Release( text );
+    }
+    else set_child( control, NULL, FALSE );
+}
+
+/* ---- layout and drawing ---- */
+
+static void insets( struct control *control, struct xthickness *t )
+{
+    struct xthickness border, padding;
+
+    get_ref( control, prop_border_thickness, &IID_IReference_Thickness, &border, sizeof(border) );
+    get_ref( control, prop_padding, &IID_IReference_Thickness, &padding, sizeof(padding) );
+    t->left = border.left + padding.left;
+    t->top = border.top + padding.top;
+    t->right = border.right + padding.right;
+    t->bottom = border.bottom + padding.bottom;
+}
+
+static void control_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct control *control = control_from_elem( elem );
+    struct xthickness t;
+    struct xsize inner;
+
+    insets( control, &t );
+    desired->width = t.left + t.right;
+    desired->height = t.top + t.bottom;
+    if (!control->child) return;
+    inner.width = fmax( 0, available.width - t.left - t.right );
+    inner.height = fmax( 0, available.height - t.top - t.bottom );
+    uielem_measure( control->child, inner );
+    desired->width += control->child->desired.width;
+    desired->height += control->child->desired.height;
+}
+
+static void control_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct control *control = control_from_elem( elem );
+    struct xthickness t;
+    struct xrect rect;
+
+    *used = final;
+    if (!control->child) return;
+    insets( control, &t );
+    rect.x = t.left;
+    rect.y = t.top;
+    rect.width = fmax( 0, final.width - t.left - t.right );
+    rect.height = fmax( 0, final.height - t.top - t.bottom );
+    if (control->child_is_text)
+    {
+        /* a string content: placed by HorizontalContentAlignment and VerticalContentAlignment */
+        INT32 h = get_enum( control, prop_hcontent, &IID_IReference_HorizontalAlignment, XALIGN_LEFT );
+        INT32 v = get_enum( control, prop_vcontent, &IID_IReference_VerticalAlignment, XALIGN_LEFT );
+        struct xsize size = control->child->desired;
+        if (h != XALIGN_STRETCH && size.width < rect.width)
+        {
+            rect.x += h == XALIGN_CENTER ? (rect.width - size.width) / 2 : h == XALIGN_RIGHT ? rect.width - size.width : 0;
+            rect.width = size.width;
+        }
+        if (v != XALIGN_STRETCH && size.height < rect.height)
+        {
+            rect.y += v == XALIGN_CENTER ? (rect.height - size.height) / 2 : v == XALIGN_RIGHT ? rect.height - size.height : 0;
+            rect.height = size.height;
+        }
+    }
+    uielem_arrange( control->child, rect );
+}
+
+static void control_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct control *control = control_from_elem( elem );
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xthickness thickness;
+    struct xcorner corner;
+    IInspectable *brush = NULL;
+    struct xcolor color;
+
+    get_ref( control, prop_corner_radius, &IID_IReference_CornerRadius, &corner, sizeof(corner) );
+    get_ref( control, prop_border_thickness, &IID_IReference_Thickness, &thickness, sizeof(thickness) );
+    dobj_get_value( &elem->d, prop_background, &brush );
+    if (brush && xaml_brush_color( brush, &color )) xdraw_fill( draw, &rect, color, &corner );
+    if (brush) IInspectable_Release( brush );
+    brush = NULL;
+    dobj_get_value( &elem->d, prop_border_brush, &brush );
+    if (brush && xaml_brush_color( brush, &color )) xdraw_border( draw, &rect, &thickness, color, &corner );
+    if (brush) IInspectable_Release( brush );
+}
+
+static const struct elem_ops control_ops = { control_measure, control_arrange, control_render };
+
+/* ---- IControl ---- */
+
+#define OBJECT_PROP(prefix, name, prop) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, IInspectable **value ) \
+{ if (!value) return E_POINTER; return dobj_get_value( &control_from_iface( iface )->e.d, prop, value ); } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, IInspectable *value ) \
+{ return dobj_set_value( &control_from_iface( iface )->e.d, prop, value ); }
+
+#define DOUBLE_PROP(prefix, name, prop, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, DOUBLE *value ) \
+{ if (!value) return E_POINTER; *value = get_dbl( control_from_iface( iface ), prop, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, DOUBLE value ) \
+{ return put_boxed( control_from_iface( iface ), prop, xbox_double( value ) ); }
+
+#define BOOL_PROP(prefix, name, prop, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, boolean *value ) \
+{ if (!value) return E_POINTER; *value = get_bool( control_from_iface( iface ), prop, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, boolean value ) \
+{ return put_boxed( control_from_iface( iface ), prop, xbox_boolean( value ) ); }
+
+#define ENUM_PROP(prefix, name, prop, iid, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, INT32 *value ) \
+{ if (!value) return E_POINTER; *value = get_enum( control_from_iface( iface ), prop, iid, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, INT32 value ) \
+{ return put_boxed( control_from_iface( iface ), prop, xbox_ref( iid, &value, sizeof(value) ) ); }
+
+#define INT_PROP(prefix, name, prop, def) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, INT32 *value ) \
+{ if (!value) return E_POINTER; *value = get_enum( control_from_iface( iface ), prop, NULL, def ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, INT32 value ) \
+{ return put_boxed( control_from_iface( iface ), prop, xbox_int32( value ) ); }
+
+#define THICKNESS_PROP(prefix, name, prop) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, struct xthickness *value ) \
+{ if (!value) return E_POINTER; get_ref( control_from_iface( iface ), prop, &IID_IReference_Thickness, value, sizeof(*value) ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, struct xthickness value ) \
+{ return put_boxed( control_from_iface( iface ), prop, xbox_ref( &IID_IReference_Thickness, &value, sizeof(value) ) ); }
+
+DOUBLE_PROP(control, FontSize, prop_font_size, 14)
+OBJECT_PROP(control, FontFamily, prop_font_family)
+ENUM_PROP(control, FontStyle, prop_font_style, &IID_IReference_FontStyle, 0)
+INT_PROP(control, FontStretch, prop_font_stretch, 5)
+INT_PROP(control, CharacterSpacing, prop_character_spacing, 0)
+OBJECT_PROP(control, Foreground, prop_foreground)
+BOOL_PROP(control, IsTabStop, prop_is_tab_stop, TRUE)
+BOOL_PROP(control, IsEnabled, prop_is_enabled, TRUE)
+INT_PROP(control, TabIndex, prop_tab_index, INT_MAX)
+INT_PROP(control, TabNavigation, prop_tab_navigation, 0)
+OBJECT_PROP(control, Template, prop_template)
+THICKNESS_PROP(control, Padding, prop_padding)
+ENUM_PROP(control, HorizontalContentAlignment, prop_hcontent, &IID_IReference_HorizontalAlignment, XALIGN_CENTER)
+ENUM_PROP(control, VerticalContentAlignment, prop_vcontent, &IID_IReference_VerticalAlignment, XALIGN_CENTER)
+OBJECT_PROP(control, Background, prop_background)
+THICKNESS_PROP(control, BorderThickness, prop_border_thickness)
+OBJECT_PROP(control, BorderBrush, prop_border_brush)
+
+static HRESULT WINAPI control_get_FontWeight( struct xiface *iface, UINT16 *value )
+{
+    if (!value) return E_POINTER;
+    *value = 400;
+    get_ref( control_from_iface( iface ), prop_font_weight, &IID_IReference_FontWeight, value, sizeof(*value) );
+    if (!*value) *value = 400;
+    return S_OK;
+}
+
+static HRESULT WINAPI control_put_FontWeight( struct xiface *iface, UINT16 value )
+{
+    return put_boxed( control_from_iface( iface ), prop_font_weight, xbox_ref( &IID_IReference_FontWeight, &value, sizeof(value) ) );
+}
+
+static HRESULT WINAPI control_get_FocusState( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = 0;   /* Unfocused */
+    return S_OK;
+}
+
+static HRESULT WINAPI control_ApplyTemplate( struct xiface *iface, boolean *applied )
+{
+    if (!applied) return E_POINTER;
+    *applied = FALSE;
+    return S_OK;
