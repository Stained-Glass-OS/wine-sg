diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
new file mode 100644
index 0000000..de69980
--- /dev/null
+++ b/dlls/windows.ui.xaml/control.c
@@ -0,0 +1,902 @@
+/*
+ * Windows.UI.Xaml.Controls: Control, ContentControl, UserControl, Page
+ *
+ * Copyright 2026 Stained Glass OS
+ *
