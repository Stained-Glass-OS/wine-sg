+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "ole2.h"
+#include "wuapi.h"
+#include "wuapi_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wuapi);
+
+/* The arguments of the callback of a search: nothing but the object */
+struct callback_args
+{
+    ISearchCompletedCallbackArgs ISearchCompletedCallbackArgs_iface;
+    LONG refs;
+};
+
+static struct callback_args *args_from_iface( ISearchCompletedCallbackArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct callback_args, ISearchCompletedCallbackArgs_iface );
+}
+
+static HRESULT WINAPI args_QueryInterface( ISearchCompletedCallbackArgs *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_ISearchCompletedCallbackArgs ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        ISearchCompletedCallbackArgs_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI args_AddRef( ISearchCompletedCallbackArgs *iface )
+{
+    return InterlockedIncrement( &args_from_iface( iface )->refs );
+}
+
+static ULONG WINAPI args_Release( ISearchCompletedCallbackArgs *iface )
+{
+    struct callback_args *args = args_from_iface( iface );
+    LONG refs = InterlockedDecrement( &args->refs );
+
+    if (!refs) free( args );
+    return refs;
+}
+
+static HRESULT WINAPI args_GetTypeInfoCount( ISearchCompletedCallbackArgs *iface, UINT *count )
+{
+    if (!count) return E_POINTER;
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI args_GetTypeInfo( ISearchCompletedCallbackArgs *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    if (!info) return E_POINTER;
+    *info = NULL;
+    return index ? DISP_E_BADINDEX : TYPE_E_ELEMENTNOTFOUND;
+}
+
+static HRESULT WINAPI args_GetIDsOfNames( ISearchCompletedCallbackArgs *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                          LCID lcid, DISPID *dispid )
+{
+    UINT i;
+
+    /* it has no members */
+    for (i = 0; i < count; i++) dispid[i] = DISPID_UNKNOWN;
+    return DISP_E_UNKNOWNNAME;
+}
+
+static HRESULT WINAPI args_Invoke( ISearchCompletedCallbackArgs *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                   DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return DISP_E_MEMBERNOTFOUND;
+}
+
+static const ISearchCompletedCallbackArgsVtbl args_vtbl =
+{
+    args_QueryInterface,
+    args_AddRef,
+    args_Release,
+    args_GetTypeInfoCount,
+    args_GetTypeInfo,
+    args_GetIDsOfNames,
+    args_Invoke
+};
+
+/* The job */
+struct search_job
+{
+    ISearchJob ISearchJob_iface;
+    LONG refs;
+    VARIANT state;
+    BSTR criteria;
+    IStream *callback_stream;     /* the callback, marshaled for the thread that calls it */
+    IUnknown *callback_direct;    /* or the callback itself, when it cannot be marshaled */
+    HANDLE completed;             /* the search is over */
+    HANDLE finished;              /* the callback has been called */
+    HRESULT hr;
+    ISearchResult *result;
+    BOOL ended;
+    CRITICAL_SECTION cs;
+};
+
+static inline struct search_job *impl_from_ISearchJob( ISearchJob *iface )
+{
+    return CONTAINING_RECORD( iface, struct search_job, ISearchJob_iface );
+}
+
+static const ISearchJobVtbl search_job_vtbl;
+
+static HRESULT WINAPI job_QueryInterface( ISearchJob *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_ISearchJob ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        ISearchJob_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI job_AddRef( ISearchJob *iface )
+{
+    return InterlockedIncrement( &impl_from_ISearchJob( iface )->refs );
+}
+
+static ULONG WINAPI job_Release( ISearchJob *iface )
+{
+    struct search_job *job = impl_from_ISearchJob( iface );
+    LONG refs = InterlockedDecrement( &job->refs );
+
+    if (!refs)
+    {
+        VariantClear( &job->state );
+        SysFreeString( job->criteria );
+        if (job->callback_stream) IStream_Release( job->callback_stream );
+        if (job->callback_direct) IUnknown_Release( job->callback_direct );
+        if (job->result) ISearchResult_Release( job->result );
+        CloseHandle( job->completed );
+        CloseHandle( job->finished );
+        job->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &job->cs );
+        free( job );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI job_GetTypeInfoCount( ISearchJob *iface, UINT *count )
+{
+    return wu_GetTypeInfoCount( count );
+}
+
+static HRESULT WINAPI job_GetTypeInfo( ISearchJob *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return wu_GetTypeInfo( &IID_ISearchJob, index, lcid, info );
+}
+
+static HRESULT WINAPI job_GetIDsOfNames( ISearchJob *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid,
+                                         DISPID *dispid )
+{
+    return wu_GetIDsOfNames( &IID_ISearchJob, riid, names, count, lcid, dispid );
+}
+
+static HRESULT WINAPI job_Invoke( ISearchJob *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                  DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return wu_Invoke( (IDispatch *)iface, &IID_ISearchJob, id, riid, lcid, flags, params, result, excep, arg_err );
+}
+
+static HRESULT WINAPI job_get_AsyncState( ISearchJob *iface, VARIANT *retval )
+{
+    struct search_job *job = impl_from_ISearchJob( iface );
+
+    TRACE( "%p, %p\n", job, retval );
+
+    if (!retval) return E_POINTER;
+    VariantInit( retval );
+#ifdef SG_MUTANT_WUA_STATE
+    return S_OK;
+#endif
+    return VariantCopy( retval, &job->state );
+}
+
+static HRESULT WINAPI job_get_IsCompleted( ISearchJob *iface, VARIANT_BOOL *retval )
+{
+    struct search_job *job = impl_from_ISearchJob( iface );
+
+    TRACE( "%p, %p\n", job, retval );
+
+    if (!retval) return E_POINTER;
+#ifdef SG_MUTANT_WUA_COMPLETED
+    *retval = VARIANT_FALSE;
+#else
+    *retval = WaitForSingleObject( job->completed, 0 ) == WAIT_OBJECT_0 ? VARIANT_TRUE : VARIANT_FALSE;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI job_CleanUp( ISearchJob *iface )
+{
+    struct search_job *job = impl_from_ISearchJob( iface );
+
+    TRACE( "%p\n", job );
+
+    /* waits for the operation, and for its callback */
+#ifndef SG_MUTANT_WUA_CLEANUP
+    WaitForSingleObject( job->finished, INFINITE );
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI job_RequestAbort( ISearchJob *iface )
+{
+    TRACE( "%p\n", iface );
+    /* the search is over as soon as it is started: there is nothing to cancel */
+    return S_OK;
+}
+
+static const ISearchJobVtbl search_job_vtbl =
+{
+    job_QueryInterface,
+    job_AddRef,
+    job_Release,
+    job_GetTypeInfoCount,
+    job_GetTypeInfo,
+    job_GetIDsOfNames,
+    job_Invoke,
+    job_get_AsyncState,
+    job_get_IsCompleted,
+    job_CleanUp,
+    job_RequestAbort
+};
+
+static void call_callback( struct search_job *job )
+{
+    IUnknown *unk = NULL;
+    ISearchCompletedCallback *callback;
+    ISearchCompletedCallbackArgs *args;
+    struct callback_args *a;
+    IDispatch *disp;
+
+    if (job->callback_stream)
+    {
+        HRESULT hr = CoGetInterfaceAndReleaseStream( job->callback_stream, &IID_IUnknown, (void **)&unk );
+
+        job->callback_stream = NULL;
+        if (FAILED( hr )) unk = NULL;
+    }
+    else if (job->callback_direct)
+    {
+        unk = job->callback_direct;
+        job->callback_direct = NULL;
+    }
+    if (!unk) return;
+
+    if ((a = calloc( 1, sizeof(*a) )))
+    {
+        a->ISearchCompletedCallbackArgs_iface.lpVtbl = &args_vtbl;
+        a->refs = 1;
+        args = &a->ISearchCompletedCallbackArgs_iface;
+
+        if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_ISearchCompletedCallback, (void **)&callback )))
+        {
+            ISearchCompletedCallback_Invoke( callback, &job->ISearchJob_iface, args );
+            ISearchCompletedCallback_Release( callback );
+        }
+        else if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_IDispatch, (void **)&disp )))
+        {
+            /* a script: the function of dispatch identifier 0, called with the job and the arguments */
+            VARIANT argv[2], res;
+            DISPPARAMS params;
+
+            V_VT( &argv[0] ) = VT_DISPATCH;
+            V_DISPATCH( &argv[0] ) = (IDispatch *)args;
+            V_VT( &argv[1] ) = VT_DISPATCH;
+#ifdef SG_MUTANT_WUA_ARGORDER
+            V_DISPATCH( &argv[1] ) = (IDispatch *)args;
+            V_DISPATCH( &argv[0] ) = (IDispatch *)&job->ISearchJob_iface;
+#else
+            V_DISPATCH( &argv[1] ) = (IDispatch *)&job->ISearchJob_iface;
+#endif
+            params.rgvarg = argv;
+            params.cArgs = 2;
+            params.cNamedArgs = 0;
+            params.rgdispidNamedArgs = NULL;
+            VariantInit( &res );
+#ifndef SG_MUTANT_WUA_SCRIPT
+            IDispatch_Invoke( disp, DISPID_VALUE, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &params, &res, NULL, NULL );
+#endif
+            VariantClear( &res );
+            IDispatch_Release( disp );
+        }
+        ISearchCompletedCallbackArgs_Release( args );
+    }
+    IUnknown_Release( unk );
+}
+
+static DWORD WINAPI search_thread( void *arg )
+{
+    struct search_job *job = arg;
+    HRESULT init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    ISearchResult *result = NULL;
+    HRESULT hr;
+
+    /* the criteria is looked at as the synchronous search does: a search finds nothing here */
+#ifdef SG_MUTANT_WUA_CRITERIA
+    if (FALSE)
+#else
+    if (!job->criteria || !*job->criteria)
+#endif
+        hr = WU_E_INVALID_CRITERIA;
+    else hr = SearchResult_create( &result );
+
+    EnterCriticalSection( &job->cs );
+    job->hr = hr;
+    job->result = result;
+    LeaveCriticalSection( &job->cs );
+    SetEvent( job->completed );
+
+    call_callback( job );
+    SetEvent( job->finished );
+
+    ISearchJob_Release( &job->ISearchJob_iface );
+    if (SUCCEEDED( init )) CoUninitialize();
+    return 0;
+}
+
+HRESULT SearchJob_begin( BSTR criteria, IUnknown *callback, VARIANT state, ISearchJob **ret )
+{
+    struct search_job *job;
+    HANDLE thread;
+
+    if (!(job = calloc( 1, sizeof(*job) ))) return E_OUTOFMEMORY;
+    job->ISearchJob_iface.lpVtbl = &search_job_vtbl;
+    job->refs = 1;
+    InitializeCriticalSectionEx( &job->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    job->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": search_job.cs");
+    job->completed = CreateEventW( NULL, TRUE, FALSE, NULL );
+    job->finished = CreateEventW( NULL, TRUE, FALSE, NULL );
+    VariantInit( &job->state );
+    if (!job->completed || !job->finished || FAILED(VariantCopy( &job->state, &state )) ||
+        !(job->criteria = SysAllocString( criteria )))
+    {
+        ISearchJob_Release( &job->ISearchJob_iface );
+        return E_OUTOFMEMORY;
+    }
+    if (callback)
+    {
+        /* the thread that calls it may be in another apartment than the caller's */
+        if (FAILED(CoMarshalInterThreadInterfaceInStream( &IID_IUnknown, callback, &job->callback_stream )))
+        {
+            job->callback_stream = NULL;
+            IUnknown_AddRef( callback );
+            job->callback_direct = callback;
+        }
+    }
+    else SetEvent( job->finished );
+
+    ISearchJob_AddRef( &job->ISearchJob_iface );   /* for the thread */
+    if (!(thread = CreateThread( NULL, 0, search_thread, job, 0, NULL )))
+    {
+        ISearchJob_Release( &job->ISearchJob_iface );
+        ISearchJob_Release( &job->ISearchJob_iface );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    CloseHandle( thread );
+    *ret = &job->ISearchJob_iface;
+    return S_OK;
+}
+
+HRESULT SearchJob_end( ISearchJob *iface, ISearchResult **ret )
+{
+    struct search_job *job;
+    HRESULT hr;
+
+    /* a job that is not one of ours was not made by BeginSearch */
+#ifndef SG_MUTANT_WUA_FOREIGN
+    if (iface->lpVtbl != &search_job_vtbl) return E_INVALIDARG;
+#endif
+    job = impl_from_ISearchJob( iface );
+
+    WaitForSingleObject( job->completed, INFINITE );
+    EnterCriticalSection( &job->cs );
+#ifdef SG_MUTANT_WUA_ENDTWICE
+    if (FALSE) hr = WU_E_INVALID_OPERATION;
+#else
+    if (job->ended) hr = WU_E_INVALID_OPERATION;
+#endif
+    else
+    {
+        job->ended = TRUE;
+        hr = job->hr;
+        if (SUCCEEDED( hr ))
+        {
+            *ret = job->result;
+            ISearchResult_AddRef( *ret );
+        }
+    }
+    LeaveCriticalSection( &job->cs );
+    return hr;
+}
diff --git a/dlls/wuapi/searcher.c b/dlls/wuapi/searcher.c
index c9d3e6e..f7b499f 100644
