+WINE_DEFAULT_DEBUG_CHANNEL(wuapi);
+
+struct web_proxy
+{
+    IWebProxy IWebProxy_iface;
+    LONG refs;
+    BSTR address, user, password;
+    IStringCollection *bypass;
+    VARIANT_BOOL bypass_local, auto_detect;
+    CRITICAL_SECTION cs;
+};
+
+static inline struct web_proxy *impl_from_IWebProxy( IWebProxy *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_proxy, IWebProxy_iface );
+}
+
+static HRESULT WINAPI proxy_QueryInterface( IWebProxy *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IWebProxy ) || IsEqualGUID( riid, &IID_IDispatch ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IWebProxy_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI proxy_AddRef( IWebProxy *iface )
+{
+    return InterlockedIncrement( &impl_from_IWebProxy( iface )->refs );
+}
+
+static ULONG WINAPI proxy_Release( IWebProxy *iface )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+
+    if (!refs)
+    {
+        SysFreeString( This->address );
+        SysFreeString( This->user );
+        if (This->password) SecureZeroMemory( This->password, SysStringLen( This->password ) * sizeof(WCHAR) );
+        SysFreeString( This->password );
+        if (This->bypass) IStringCollection_Release( This->bypass );
+        This->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &This->cs );
+        free( This );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI proxy_GetTypeInfoCount( IWebProxy *iface, UINT *count )
+{
+    return wu_GetTypeInfoCount( count );
+}
+
+static HRESULT WINAPI proxy_GetTypeInfo( IWebProxy *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return wu_GetTypeInfo( &IID_IWebProxy, index, lcid, info );
+}
+
+static HRESULT WINAPI proxy_GetIDsOfNames( IWebProxy *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid,
+                                           DISPID *dispid )
+{
+    return wu_GetIDsOfNames( &IID_IWebProxy, riid, names, count, lcid, dispid );
+}
+
+static HRESULT WINAPI proxy_Invoke( IWebProxy *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                    DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return wu_Invoke( (IDispatch *)iface, &IID_IWebProxy, id, riid, lcid, flags, params, result, excep, arg_err );
+}
+
+static HRESULT WINAPI proxy_get_Address( IWebProxy *iface, BSTR *retval )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", This, retval );
+    EnterCriticalSection( &This->cs );
+    hr = wu_get_bstr( This->address, retval );
+    LeaveCriticalSection( &This->cs );
+    return hr;
+}
+
+static HRESULT WINAPI proxy_put_Address( IWebProxy *iface, BSTR value )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %s\n", This, debugstr_w(value) );
+    EnterCriticalSection( &This->cs );
+    hr = wu_put_bstr( &This->address, value );
+    LeaveCriticalSection( &This->cs );
+    return hr;
+}
+
+static HRESULT WINAPI proxy_get_BypassList( IWebProxy *iface, IStringCollection **retval )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "%p, %p\n", This, retval );
+
+    if (!retval) return E_POINTER;
+    EnterCriticalSection( &This->cs );
+#ifdef SG_MUTANT_WUA_BYPASS
+    if (This->bypass) { IStringCollection_Release( This->bypass ); This->bypass = NULL; }
+#endif
+    if (!This->bypass) hr = StringCollection_create( &This->bypass );
+    if (SUCCEEDED( hr ))
+    {
+        *retval = This->bypass;
+        IStringCollection_AddRef( *retval );
+    }
+    LeaveCriticalSection( &This->cs );
+    return hr;
+}
+
+static HRESULT WINAPI proxy_put_BypassList( IWebProxy *iface, IStringCollection *value )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    IStringCollection *old;
+
+    TRACE( "%p, %p\n", This, value );
+
+    if (value) IStringCollection_AddRef( value );
+    EnterCriticalSection( &This->cs );
+    old = This->bypass;
+    This->bypass = value;
+    LeaveCriticalSection( &This->cs );
+    if (old) IStringCollection_Release( old );
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_get_BypassProxyOnLocal( IWebProxy *iface, VARIANT_BOOL *retval )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+
+    TRACE( "%p, %p\n", This, retval );
+    if (!retval) return E_POINTER;
+    *retval = This->bypass_local;
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_put_BypassProxyOnLocal( IWebProxy *iface, VARIANT_BOOL value )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+
+    TRACE( "%p, %d\n", This, value );
+#ifndef SG_MUTANT_WUA_BYPASSLOCAL
+    This->bypass_local = value ? VARIANT_TRUE : VARIANT_FALSE;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_get_ReadOnly( IWebProxy *iface, VARIANT_BOOL *retval )
+{
+    TRACE( "%p, %p\n", iface, retval );
+    if (!retval) return E_POINTER;
+    *retval = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_get_UserName( IWebProxy *iface, BSTR *retval )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", This, retval );
+    EnterCriticalSection( &This->cs );
+    hr = wu_get_bstr( This->user, retval );
+    LeaveCriticalSection( &This->cs );
+    return hr;
+}
+
+static HRESULT WINAPI proxy_put_UserName( IWebProxy *iface, BSTR value )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    HRESULT hr;
+
+    TRACE( "%p, %s\n", This, debugstr_w(value) );
+    EnterCriticalSection( &This->cs );
+    hr = wu_put_bstr( &This->user, value );
+    LeaveCriticalSection( &This->cs );
+    return hr;
+}
+
+static HRESULT WINAPI proxy_SetPassword( IWebProxy *iface, BSTR value )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    BSTR copy = NULL;
+
+    TRACE( "%p\n", This );
+
+    if (value && !(copy = SysAllocStringLen( value, SysStringLen( value ) ))) return E_OUTOFMEMORY;
+    EnterCriticalSection( &This->cs );
+    if (This->password) SecureZeroMemory( This->password, SysStringLen( This->password ) * sizeof(WCHAR) );
+    SysFreeString( This->password );
+    This->password = copy;
+    LeaveCriticalSection( &This->cs );
+    return S_OK;
+}
+
+static HRESULT prompt( struct web_proxy *This, HWND parent, BSTR title )
+{
+    CREDUI_INFOW info;
+    WCHAR user[CREDUI_MAX_USERNAME_LENGTH + 1] = L"", pass[CREDUI_MAX_PASSWORD_LENGTH + 1] = L"";
+    DWORD ret;
+
+    memset( &info, 0, sizeof(info) );
+    info.cbSize = sizeof(info);
+    info.hwndParent = parent;
+    info.pszCaptionText = title;
+    info.pszMessageText = This->address ? This->address : L"";
+    EnterCriticalSection( &This->cs );
+    if (This->user) lstrcpynW( user, This->user, ARRAY_SIZE(user) );
+    LeaveCriticalSection( &This->cs );
+
+    ret = CredUIPromptForCredentialsW( &info, This->address ? This->address : L"proxy", NULL, 0, user, ARRAY_SIZE(user),
+                                       pass, ARRAY_SIZE(pass), NULL,
+                                       CREDUI_FLAGS_GENERIC_CREDENTIALS | CREDUI_FLAGS_DO_NOT_PERSIST |
+                                       CREDUI_FLAGS_ALWAYS_SHOW_UI );
+    if (ret == NO_ERROR)
+    {
+        BSTR u = SysAllocString( user ), p = SysAllocString( pass );
+
+        EnterCriticalSection( &This->cs );
+        SysFreeString( This->user );
+        This->user = u;
+        if (This->password) SecureZeroMemory( This->password, SysStringLen( This->password ) * sizeof(WCHAR) );
+        SysFreeString( This->password );
+        This->password = p;
+        LeaveCriticalSection( &This->cs );
+    }
+    SecureZeroMemory( pass, sizeof(pass) );
+#ifdef SG_MUTANT_WUA_CANCEL
+    return S_OK;
+#endif
+    return ret == NO_ERROR ? S_OK : HRESULT_FROM_WIN32( ret );
+}
+
+static HRESULT WINAPI proxy_PromptForCredentials( IWebProxy *iface, IUnknown *parent, BSTR title )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+    HWND hwnd = NULL;
+
+    TRACE( "%p, %p, %s\n", This, parent, debugstr_w(title) );
+
+    /* the parent is an object that has a window: IOleWindow, or the hWnd property of a script object */
+    if (parent)
+    {
+        IOleWindow *ole_window;
+        IDispatch *disp;
+
+        if (SUCCEEDED(IUnknown_QueryInterface( parent, &IID_IOleWindow, (void **)&ole_window )))
+        {
+            IOleWindow_GetWindow( ole_window, &hwnd );
+            IOleWindow_Release( ole_window );
+        }
+        else if (SUCCEEDED(IUnknown_QueryInterface( parent, &IID_IDispatch, (void **)&disp )))
+        {
+            static WCHAR name[] = L"hWnd";
+            LPOLESTR names[1] = { name };
+            DISPID id;
+            DISPPARAMS none = { NULL, NULL, 0, 0 };
+            VARIANT v;
+
+            VariantInit( &v );
+            if (SUCCEEDED(IDispatch_GetIDsOfNames( disp, &IID_NULL, names, 1, LOCALE_USER_DEFAULT, &id )) &&
+                SUCCEEDED(IDispatch_Invoke( disp, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &none, &v,
+                                            NULL, NULL )) &&
+                SUCCEEDED(VariantChangeType( &v, &v, 0, VT_I8 )))
+                hwnd = (HWND)(ULONG_PTR)V_I8( &v );
+            VariantClear( &v );
+            IDispatch_Release( disp );
+        }
+    }
+    return prompt( This, hwnd, title );
+}
+
+static HRESULT WINAPI proxy_PromptForCredentialsFromHwnd( IWebProxy *iface, HWND parent, BSTR title )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+
+    TRACE( "%p, %p, %s\n", This, parent, debugstr_w(title) );
+    return prompt( This, parent, title );
+}
+
+static HRESULT WINAPI proxy_get_AutoDetect( IWebProxy *iface, VARIANT_BOOL *retval )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+
+    TRACE( "%p, %p\n", This, retval );
+    if (!retval) return E_POINTER;
+    *retval = This->auto_detect;
+    return S_OK;
+}
+
+static HRESULT WINAPI proxy_put_AutoDetect( IWebProxy *iface, VARIANT_BOOL value )
+{
+    struct web_proxy *This = impl_from_IWebProxy( iface );
+
+    TRACE( "%p, %d\n", This, value );
+    This->auto_detect = value ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static const IWebProxyVtbl proxy_vtbl =
+{
+    proxy_QueryInterface,
+    proxy_AddRef,
+    proxy_Release,
+    proxy_GetTypeInfoCount,
+    proxy_GetTypeInfo,
+    proxy_GetIDsOfNames,
+    proxy_Invoke,
+    proxy_get_Address,
+    proxy_put_Address,
+    proxy_get_BypassList,
+    proxy_put_BypassList,
+    proxy_get_BypassProxyOnLocal,
+    proxy_put_BypassProxyOnLocal,
+    proxy_get_ReadOnly,
+    proxy_get_UserName,
+    proxy_put_UserName,
+    proxy_SetPassword,
+    proxy_PromptForCredentials,
+    proxy_PromptForCredentialsFromHwnd,
+    proxy_get_AutoDetect,
+    proxy_put_AutoDetect
+};
+
+/* The settings a session starts with: the proxy is detected, nothing is set */
+HRESULT WebProxy_create( IWebProxy **ret )
+{
+    struct web_proxy *This;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->IWebProxy_iface.lpVtbl = &proxy_vtbl;
+    This->refs = 1;
+#ifdef SG_MUTANT_WUA_AUTODETECT
+    This->auto_detect = VARIANT_FALSE;
+#else
+    This->auto_detect = VARIANT_TRUE;
+#endif
+    InitializeCriticalSectionEx( &This->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    This->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": web_proxy.cs");
+    *ret = &This->IWebProxy_iface;
+    return S_OK;
+}
