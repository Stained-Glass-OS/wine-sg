diff --git a/dlls/wuapi/jobs.c b/dlls/wuapi/jobs.c
new file mode 100644
index 0000000..680563f
--- /dev/null
+++ b/dlls/wuapi/jobs.c
@@ -0,0 +1,433 @@
+/*
+ * Windows Update Agent API: asynchronous search jobs
+ *
+ * Copyright 2026 Stained Glass OS
+ *
