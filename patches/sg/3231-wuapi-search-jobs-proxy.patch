@@ -185,23 +185,51 @@ static HRESULT WINAPI update_downloader_put_Updates( IUpdateDownloader *iface, I
     return S_OK;
 }
 
+HRESULT wu_check_updates( IUpdateCollection *updates )
+{
+    LONG count = 0;
+
+    /* an updates property that is not set is an empty collection */
+#ifdef SG_MUTANT_WUA_NOUPDATE
+    return S_OK;
+#endif
+    if (!updates || FAILED(IUpdateCollection_get_Count( updates, &count )) || !count) return WU_E_NO_UPDATE;
+    /* the agent has no update source: what the updates need cannot be reached */
+#ifdef SG_MUTANT_WUA_INVALIDOP
+    return S_OK;
+#else
+    return WU_E_INVALID_OPERATION;
+#endif
+}
+
 static HRESULT WINAPI update_downloader_BeginDownload(
-    IUpdateDownloader *This,
+    IUpdateDownloader *iface,
     IUnknown *onProgressChanged,
     IUnknown *onCompleted,
     VARIANT state,
     IDownloadJob **retval )
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    update_downloader *This = impl_from_IUpdateDownloader( iface );
+
+    TRACE( "%p, %p, %p, %p\n", This, onProgressChanged, onCompleted, retval );
+
+    if (!retval) return E_POINTER;
+    *retval = NULL;
+    /* no job is made: the download cannot start */
+    return wu_check_updates( This->updates );
 }
 
 static HRESULT WINAPI update_downloader_Download(
-    IUpdateDownloader *This,
+    IUpdateDownloader *iface,
     IDownloadResult **retval )
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    update_downloader *This = impl_from_IUpdateDownloader( iface );
+
+    TRACE( "%p, %p\n", This, retval );
+
+    if (!retval) return E_POINTER;
+    *retval = NULL;
+    return wu_check_updates( This->updates );
 }
 
 static HRESULT WINAPI update_downloader_EndDownload(
@@ -209,8 +237,15 @@ static HRESULT WINAPI update_downloader_EndDownload(
     IDownloadJob *value,
     IDownloadResult **retval )
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    TRACE( "%p, %p, %p\n", This, value, retval );
+
+    if (!value || !retval) return E_POINTER;
+    *retval = NULL;
+#ifdef SG_MUTANT_WUA_ENDJOB
+    return S_OK;
+#endif
+    /* a download job comes from BeginDownload, which has never made one */
+    return E_INVALIDARG;
 }
 
 static const struct IUpdateDownloaderVtbl update_downloader_vtbl =
