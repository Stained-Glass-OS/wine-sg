From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:29:39 -0700
Subject: [PATCH] msi: MsiUseFeature records the use, MsiGetFeatureUsage
 returns it

MsiUseFeature(Ex) on a locally installed feature counts the use and the date in a Usage value under the
product's UserData key; MsiGetFeatureUsage reads them back (ERROR_UNKNOWN_PRODUCT, ERROR_UNKNOWN_FEATURE
and ERROR_INVALID_PARAMETER as documented) instead of ERROR_CALL_NOT_IMPLEMENTED.

diff --git a/dlls/msi/msi.c b/dlls/msi/msi.c
index 3e2d2dd..556daaa 100644
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -3443,15 +3443,70 @@ UINT WINAPI MsiGetFileVersionW( const WCHAR *path, WCHAR *verbuf, DWORD *verlen,
     return ret;
 }
 
+/* The usage record of a feature: <product's UserData key>\\Usage, one DWORD value per feature, the use
+ * count in the low word and the date of the last use (MS-DOS date) in the high word. */
+static UINT open_usage_key( const WCHAR *product, BOOL create, HKEY *key )
+{
+    static const MSIINSTALLCONTEXT contexts[] =
+        { MSIINSTALLCONTEXT_USERMANAGED, MSIINSTALLCONTEXT_USERUNMANAGED, MSIINSTALLCONTEXT_MACHINE };
+    UINT i, r = ERROR_UNKNOWN_PRODUCT;
+    HKEY prod;
+
+    for (i = 0; i < ARRAY_SIZE(contexts); i++)
+    {
+        if (MSIREG_OpenUserDataProductKey( product, contexts[i], NULL, &prod, FALSE )) continue;
+        if (create) r = RegCreateKeyExW( prod, L"Usage", 0, NULL, 0, KEY_ALL_ACCESS, NULL, key, NULL );
+        else r = RegOpenKeyExW( prod, L"Usage", 0, KEY_READ, key );
+        RegCloseKey( prod );
+        if (!create && r == ERROR_FILE_NOT_FOUND) r = ERROR_UNKNOWN_FEATURE;
+        return r;
+    }
+    return r;
+}
+
+static void mark_feature_used( const WCHAR *product, const WCHAR *feature )
+{
+    DWORD value = 0, size = sizeof(value), type;
+    SYSTEMTIME st;
+    FILETIME ft;
+    WORD date, time;
+    HKEY key;
+
+#ifdef SG_MUTANT_MSIUSAGE
+    return;
+#endif
+    if (open_usage_key( product, TRUE, &key )) return;
+    if (RegQueryValueExW( key, feature, NULL, &type, (BYTE *)&value, &size ) || type != REG_DWORD) value = 0;
+    GetLocalTime( &st );
+    SystemTimeToFileTime( &st, &ft );
+    FileTimeToDosDateTime( &ft, &date, &time );
+    if (LOWORD(value) < 0xffff) value++;
+    value = MAKELONG( LOWORD(value), date );
+    RegSetValueExW( key, feature, 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+    RegCloseKey( key );
+}
+
 /***********************************************************************
  * MsiGetFeatureUsageW           [MSI.@]
  */
 UINT WINAPI MsiGetFeatureUsageW( LPCWSTR szProduct, LPCWSTR szFeature,
                                  LPDWORD pdwUseCount, LPWORD pwDateUsed )
 {
-    FIXME("%s %s %p %p\n",debugstr_w(szProduct), debugstr_w(szFeature),
-          pdwUseCount, pwDateUsed);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    DWORD value, size = sizeof(value), type;
+    UINT r;
+    HKEY key;
+
+    TRACE("%s %s %p %p\n", debugstr_w(szProduct), debugstr_w(szFeature), pdwUseCount, pwDateUsed);
+
+    if (!szProduct || !szFeature) return ERROR_INVALID_PARAMETER;
+    if ((r = open_usage_key( szProduct, FALSE, &key ))) return r;
+    r = RegQueryValueExW( key, szFeature, NULL, &type, (BYTE *)&value, &size );
+    RegCloseKey( key );
+    if (r || type != REG_DWORD) return ERROR_UNKNOWN_FEATURE;
+
+    if (pdwUseCount) *pdwUseCount = LOWORD(value);
+    if (pwDateUsed) *pwDateUsed = HIWORD(value);
+    return ERROR_SUCCESS;
 }
 
 /***********************************************************************
@@ -3500,8 +3555,7 @@ INSTALLSTATE WINAPI MsiUseFeatureExW( const WCHAR *szProduct, const WCHAR *szFea
 
     if (state == INSTALLSTATE_LOCAL && dwInstallMode != INSTALLMODE_NODETECTION)
     {
-        FIXME("mark product %s feature %s as used\n",
-              debugstr_w(szProduct), debugstr_w(szFeature) );
+        mark_feature_used( szProduct, szFeature );
     }
 
     return state;
