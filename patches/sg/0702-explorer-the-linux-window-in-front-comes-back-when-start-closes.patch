From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the Linux window in front comes back when Start closes

With 0700, opening Start (or a flyout) while SG Office's window was in front
put Wine's desktop in front -- and closing Start with Esc left SG Office
behind the desktop, where Windows returns to the window that was in front.

A passing shell surface (the Start panel, a tool-window popup) that brings
the desktop forward remembers the Linux window that was in front. When it
goes and, after a moment, nothing else came forward -- no program's window
was shown or activated (one started from Start stays in front) -- that
window is brought back (XACTIVATE). The moment (0.6-0.7 s) also keeps the
two compositor commands from racing: each goes out in a process of its own.

Gate: test/desktopfront-gate.sh, now with a Start-like popup dismissed and
one that starts a program; the stand-in sg-lockctl acts on its window list
as the compositor would (SG_FAKE_FOCUS). SG_MUTANT_NO_POPUP_RESTORE fails it.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -266,6 +266,7 @@
 #define SG_AUTOHIDE_TIMER  0xC10E
 #define SG_SYNC_TIMER      0xC10F   /* a window was shown, hidden, renamed or brought forward */
 #define SG_ELEVATED_TIMER  0xC110   /* look for elevated programs' windows (ADR 0012) */
+#define SG_POPUP_RESTORE_TIMER 0xC1A0  /* a passing shell surface went: the Linux window back? (0702) */
 #define SG_AUTOHIDE_TICK   150
 #define SG_AUTOHIDE_DELAY  600
 
@@ -1469,9 +1470,27 @@
  * read a tick late, does not know yet */
 static DWORD sg_xwin_front_time;
 
-static void sg_desktop_front(void)
+/* Stained Glass OS: a passing shell surface -- the Start menu, a flyout (a
+ * tool window) -- puts the desktop in front only while it is up: closed
+ * without starting anything (Esc, a click on the desktop), the Linux window
+ * that was in front comes back, as on Windows, where the window in front
+ * before Start keeps the focus. sg_restore_xwin: that window, while
+ * sg_restore_popup is up. */
+static HWND sg_restore_popup;
+static unsigned long sg_restore_xwin;
+static DWORD sg_restore_hidden;   /* when the surface was seen gone (0: not yet) */
+
+static BOOL sg_is_passing_surface( HWND hwnd )
+{
+    WCHAR class[64];
+    if (GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) && !wcscmp( class, L"SgStartPanel" )) return TRUE;
+    return (GetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOOLWINDOW) && (GetWindowLongW( hwnd, GWL_STYLE ) & WS_POPUP);
+}
+
+static void sg_desktop_front_for( HWND hwnd )
 {
     struct taskbar_button *win;
+    unsigned long front = 0;
 
 #ifdef SG_MUTANT_NO_DESKTOP_FRONT
     return;
@@ -1483,9 +1502,53 @@
     LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
         if (win->xwin && win->xwin_focused)
         {
+            front = win->xwin;
             win->xwin_focused = FALSE;   /* until the next list says otherwise */
             InvalidateRect( win->button, NULL, FALSE );
         }
+#ifndef SG_MUTANT_NO_POPUP_RESTORE
+    if (hwnd && front && sg_is_passing_surface( hwnd ))
+    {
+        sg_restore_popup = hwnd;
+        sg_restore_xwin = front;
+        sg_restore_hidden = 0;
+    }
+#endif
+}
+
+static void sg_desktop_front(void)
+{
+    sg_desktop_front_for( NULL );
+}
+
+/* the passing surface is gone: what came forward instead? Nothing (the
+ * desktop, the bar) -- the Linux window that was in front returns */
+static void sg_check_popup_restore(void)
+{
+    HWND fg;
+    struct taskbar_button *win;
+
+    if (!sg_restore_popup) return;
+    if (IsWindow( sg_restore_popup ) && IsWindowVisible( sg_restore_popup )) { sg_restore_hidden = 0; return; }
+    /* gone for a moment first: a program started from it shows its window */
+    if (!sg_restore_hidden) { sg_restore_hidden = GetTickCount() | 1; return; }
+    if (GetTickCount() - sg_restore_hidden < 600) return;
+    fg = GetForegroundWindow();
+    if (!fg || fg == GetDesktopWindow() || fg == tray_window || fg == sg_restore_popup ||
+        !IsWindowVisible( fg ) || sg_is_passing_surface( fg ))
+    {
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+            if (win->xwin == sg_restore_xwin && !win->xwin_minimized)
+            {
+                sg_xwin_command( win, L"XACTIVATE" );
+                sg_xwin_front = TRUE;
+                sg_xwin_front_time = GetTickCount();
+                break;
+            }
+    }
+    sg_restore_popup = NULL;
+    sg_restore_xwin = 0;
+    sg_restore_hidden = 0;
 }
 
 /* a window brought forward, in any process (this one's File Explorer too) */
@@ -1494,12 +1557,35 @@
 {
     WCHAR class[64];
 
-    if (!sg_xwin_front || !hwnd || object != OBJID_WINDOW) return;
+    if (!hwnd || object != OBJID_WINDOW) return;
+    /* another window than the passing one came forward: it stays in front */
+    if (sg_restore_popup && hwnd != sg_restore_popup && hwnd != GetDesktopWindow() && hwnd != tray_window &&
+        IsWindowVisible( hwnd ) && !sg_is_passing_surface( hwnd ))
+    {
+        sg_restore_popup = NULL;
+        sg_restore_xwin = 0;
+        sg_restore_hidden = 0;
+    }
+    if (!sg_xwin_front) return;
     if (hwnd == tray_window || hwnd == GetDesktopWindow() || !IsWindowVisible( hwnd )) return;
     if (GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) &&
         (!wcscmp( class, L"SgLinuxWindow" ) || !wcscmp( class, L"Progman" ) || !wcscmp( class, L"WorkerW" )))
         return;
-    sg_desktop_front();
+    sg_desktop_front_for( hwnd );
+}
+
+/* the passing surface hidden: look a moment later -- a program started from
+ * it shows its window meanwhile, and then stays in front (a quicker look,
+ * and the Linux window's return and the program's window raced: the two
+ * commands go out in processes of their own, in either order) */
+static void CALLBACK sg_popup_hide_event( HWINEVENTHOOK hook, DWORD event, HWND hwnd, LONG object,
+                                          LONG child, DWORD thread, DWORD time )
+{
+    if (hwnd && hwnd == sg_restore_popup && object == OBJID_WINDOW)
+    {
+        sg_restore_hidden = GetTickCount() | 1;
+        SetTimer( tray_window, SG_POPUP_RESTORE_TIMER, 700, NULL );
+    }
 }
 
 /* Task View's action on a Linux window, by its stand-in */
@@ -3108,6 +3194,16 @@
                                       LONG child, DWORD thread, DWORD time )
 {
     if (!hwnd || object != OBJID_WINDOW) return;
+    /* a program's window shown while a passing surface goes (started from
+     * it): it stays in front, the Linux window does not come back */
+    if (event == EVENT_OBJECT_SHOW && sg_restore_popup && hwnd != sg_restore_popup &&
+        GetAncestor( hwnd, GA_PARENT ) == GetDesktopWindow() && !sg_is_passing_surface( hwnd ) &&
+        !(GetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOOLWINDOW))
+    {
+        sg_restore_popup = NULL;
+        sg_restore_xwin = 0;
+        sg_restore_hidden = 0;
+    }
     if (event != EVENT_SYSTEM_FOREGROUND && GetAncestor( hwnd, GA_PARENT ) != GetDesktopWindow()) return;
     /* the bar back on top of a window brought forward or shown -- not of a
      * menu or a tooltip, topmost themselves and above it; and behind the
@@ -3138,6 +3234,8 @@
     /* this process's windows too (File Explorer's) */
     SetWinEventHook( EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, NULL, sg_foreground_event, 0, 0,
                      WINEVENT_OUTOFCONTEXT );
+    SetWinEventHook( EVENT_OBJECT_HIDE, EVENT_OBJECT_HIDE, NULL, sg_popup_hide_event, 0, 0,
+                     WINEVENT_OUTOFCONTEXT );
 }
 
 /* what SHAppBarMessage reports and sets (appbar.c) */
@@ -3321,6 +3419,13 @@
         {
             sg_sync_elevated();
             sg_sync_xwindows();
+            sg_check_popup_restore();
+            return 0;
+        }
+        if (wparam == SG_POPUP_RESTORE_TIMER)
+        {
+            KillTimer( hwnd, SG_POPUP_RESTORE_TIMER );
+            sg_check_popup_restore();
             return 0;
         }
         if (wparam == SG_AUTOHIDE_TIMER)
