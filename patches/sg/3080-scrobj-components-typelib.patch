+static HRESULT typelib_add_class(ICreateTypeLib2 *lib, struct scriptlet_factory *factory, const WCHAR *url)
+{
+    ICreateTypeInfo *cls;
+    ITypeInfo *iface = NULL;
+    WCHAR *class_name;
+    HREFTYPE href;
+    GUID guid;
+    WCHAR guidstr[39];
+    HRESULT hr;
+
+    if (!(class_name = typelib_class_name(factory, url))) return E_OUTOFMEMORY;
+    hr = typelib_add_interface(lib, factory, class_name, &iface);
+    if (SUCCEEDED(hr)) hr = ICreateTypeLib2_CreateTypeInfo(lib, class_name, TKIND_COCLASS, &cls);
+    if (SUCCEEDED(hr))
+    {
+        if (factory->classid_str) guid = factory->classid;
+        else typelib_guid_string(&guid, guidstr);
+        ICreateTypeInfo_SetGuid(cls, &guid);
+        ICreateTypeInfo_SetTypeFlags(cls, TYPEFLAG_FCANCREATE);
+        hr = ICreateTypeInfo_AddRefTypeInfo(cls, iface, &href);
+        if (FAILED(hr)) WARN("AddRefTypeInfo: %#lx\n", hr);
+        if (SUCCEEDED(hr)) hr = ICreateTypeInfo_AddImplType(cls, 0, href);
+        if (SUCCEEDED(hr)) hr = ICreateTypeInfo_SetImplTypeFlags(cls, 0, IMPLTYPEFLAG_FDEFAULT);
+        ICreateTypeInfo_Release(cls);
