+/* the type names of a ProgID: its last part, with characters a type name cannot have replaced */
+static WCHAR *typelib_class_name(const struct scriptlet_factory *factory, const WCHAR *url)
+{
+    const WCHAR *src = factory->progid, *dot;
+    WCHAR *name, *c;
+
+    if (!src) src = L"ScriptletClass";
+    if ((dot = wcsrchr(src, '.')) && dot[1]) src = dot + 1;
+    if (!(name = wcsdup(src))) return NULL;
+    for (c = name; *c; c++)
+        if (!iswalnum(*c) && *c != '_') *c = '_';
+    return name;
+}
