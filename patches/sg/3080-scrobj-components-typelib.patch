 }
 
+
+enum global_member { GLOBAL_CREATECOMPONENT = 1, GLOBAL_GETRESOURCE, GLOBAL_FIREEVENT, GLOBAL_LAST = GLOBAL_FIREEVENT };
+
+static const WCHAR * const global_names[] = { NULL, L"createComponent", L"getResource", L"fireEvent" };
+
 static HRESULT WINAPI global_GetDispID(IDispatchEx *iface, BSTR bstrName, DWORD grfdex, DISPID *pid)
 {
     struct scriptlet_global *This = global_from_IDispatchEx(iface);
-    FIXME("(%p)->(%s %lx %p)\n", This, debugstr_w(bstrName), grfdex, pid);
-    return E_NOTIMPL;
+    unsigned i;
+
+    TRACE("(%p)->(%s %lx %p)\n", This, debugstr_w(bstrName), grfdex, pid);
+
+    for (i = 1; i <= GLOBAL_LAST; i++)
+    {
+        if ((grfdex & fdexNameCaseSensitive) ? !wcscmp(global_names[i], bstrName) : !wcsicmp(global_names[i], bstrName))
+        {
+            *pid = i;
+            return S_OK;
+        }
+    }
+
+    *pid = DISPID_UNKNOWN;
+    return DISP_E_UNKNOWNNAME;
 }
 
 static HRESULT WINAPI global_InvokeEx(IDispatchEx *iface, DISPID id, LCID lcid, WORD wFlags, DISPPARAMS *pdp,
         VARIANT *pvarRes, EXCEPINFO *pei, IServiceProvider *pspCaller)
 {
     struct scriptlet_global *This = global_from_IDispatchEx(iface);
-    FIXME("(%p)->(%lx %lx %x %p %p %p %p)\n", This, id, lcid, wFlags, pdp, pvarRes, pei, pspCaller);
-    return E_NOTIMPL;
+    VARIANT arg;
+    CLSID clsid;
+    IDispatch *disp;
+    HRESULT hres;
+
+    TRACE("(%p)->(%lx %lx %x %p %p %p %p)\n", This, id, lcid, wFlags, pdp, pvarRes, pei, pspCaller);
+
+    if (id < 1 || id > GLOBAL_LAST) return DISP_E_MEMBERNOTFOUND;
+    if (!(wFlags & DISPATCH_METHOD)) return DISP_E_MEMBERNOTFOUND;
+    if (pvarRes) V_VT(pvarRes) = VT_EMPTY;
+
+    if (id == GLOBAL_FIREEVENT)
+    {
+        if (!pdp || pdp->cArgs != 1) return DISP_E_BADPARAMCOUNT;
+        return S_OK;    /* no event sinks are connected to a component */
+    }
+
+    if (!pdp || pdp->cArgs != 1) return DISP_E_BADPARAMCOUNT;
+    VariantInit(&arg);
+    hres = VariantChangeType(&arg, &pdp->rgvarg[0], 0, VT_BSTR);
+    if (FAILED(hres)) return DISP_E_TYPEMISMATCH;
+
+    if (id == GLOBAL_GETRESOURCE)
+    {
+        struct scriptlet_resource *res;
+
+        hres = E_FAIL;
+#ifdef SG_MUTANT_NO_RESOURCES
+        if (0)
+#else
+        if (This->factory)
+#endif
+        {
+            LIST_FOR_EACH_ENTRY(res, &This->factory->resources, struct scriptlet_resource, entry)
+            {
+                if (wcscmp(res->id, V_BSTR(&arg))) continue;
+                if (pvarRes)
+                {
+                    V_VT(pvarRes) = VT_BSTR;
+                    V_BSTR(pvarRes) = SysAllocString(res->text);
+                    if (!V_BSTR(pvarRes)) hres = E_OUTOFMEMORY;
+                    else hres = S_OK;
+                }
+                else hres = S_OK;
+                break;
+            }
+        }
+        VariantClear(&arg);
+        return hres;
+    }
+
+    /* createComponent: by ProgID or class id */
+    hres = CLSIDFromProgID(V_BSTR(&arg), &clsid);
+    if (FAILED(hres)) hres = CLSIDFromString(V_BSTR(&arg), &clsid);
+    VariantClear(&arg);
+    if (FAILED(hres)) return hres;
+    hres = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER | CLSCTX_LOCAL_SERVER, &IID_IDispatch, (void **)&disp);
+    if (FAILED(hres)) return hres;
+    if (pvarRes)
+    {
+        V_VT(pvarRes) = VT_DISPATCH;
+        V_DISPATCH(pvarRes) = disp;
+    }
+    else IDispatch_Release(disp);
+    return S_OK;
 }
 
