+static HRESULT typelib_add_interface(ICreateTypeLib2 *lib, struct scriptlet_factory *factory, const WCHAR *class_name,
+        ITypeInfo **ret)
+{
+    struct scriptlet_member *member;
+    ICreateTypeInfo *cti;
+    WCHAR name[128], guidstr[39];
+    unsigned index = 0, memid = 1;
+    GUID guid;
+    HRESULT hr;
+
+    swprintf(name, ARRAY_SIZE(name), L"I%s", class_name);
+    if (FAILED(hr = ICreateTypeLib2_CreateTypeInfo(lib, name, TKIND_DISPATCH, &cti))) return hr;
+    typelib_guid_string(&guid, guidstr);
+    ICreateTypeInfo_SetGuid(cti, &guid);
+    ICreateTypeInfo_SetTypeFlags(cti, TYPEFLAG_FDISPATCHABLE);
+
+    LIST_FOR_EACH_ENTRY(member, &factory->members, struct scriptlet_member, entry)
+    {
+        FUNCDESC fd;
+        ELEMDESC *params = NULL;
+        unsigned nparams = 0, i;
+        struct method_parameter *param;
+        WCHAR *names[32];
+        INVOKEKIND kinds[2];
+        unsigned nkinds = 0;
+
+        if (member->type == MEMBER_METHOD)
+        {
+            LIST_FOR_EACH_ENTRY(param, &member->u.parameters, struct method_parameter, entry) nparams++;
+            kinds[nkinds++] = INVOKE_FUNC;
+        }
+        else
+        {
+            if (member->u.flags & (PROP_GETTER | PROP_VARIABLE)) kinds[nkinds++] = INVOKE_PROPERTYGET;
+            if (member->u.flags & (PROP_SETTER | PROP_VARIABLE)) kinds[nkinds++] = INVOKE_PROPERTYPUT;
+        }
+
+        for (i = 0; i < nkinds; i++)
+        {
+            unsigned np = kinds[i] == INVOKE_PROPERTYPUT ? 1 : (kinds[i] == INVOKE_FUNC ? nparams : 0), n = 0;
+
+            if (np > ARRAY_SIZE(names) - 1) np = ARRAY_SIZE(names) - 1;
+            if (np && !(params = calloc(np, sizeof(*params)))) { hr = E_OUTOFMEMORY; goto fail; }
+            names[n++] = member->name;
+            if (kinds[i] == INVOKE_FUNC)
+            {
+                unsigned k = 0;
+                LIST_FOR_EACH_ENTRY(param, &member->u.parameters, struct method_parameter, entry)
+                {
+                    if (k >= np) break;
+                    names[n++] = param->name;
+                    params[k].tdesc.vt = VT_VARIANT;
+                    params[k].paramdesc.wParamFlags = PARAMFLAG_FIN;
+                    k++;
+                }
+            }
+            else if (kinds[i] == INVOKE_PROPERTYPUT)
+            {
+                /* the name of a put's value is not given (SetFuncAndParamNames takes up to cParams names) */
+                params[0].tdesc.vt = VT_VARIANT;
+                params[0].paramdesc.wParamFlags = PARAMFLAG_FIN;
+            }
+
+            memset(&fd, 0, sizeof(fd));
+            fd.memid = memid;
+            fd.funckind = FUNC_DISPATCH;
+            fd.invkind = kinds[i];
+            fd.callconv = CC_STDCALL;
+            fd.cParams = np;
+            fd.lprgelemdescParam = params;
+            fd.elemdescFunc.tdesc.vt = kinds[i] == INVOKE_PROPERTYPUT ? VT_VOID : VT_VARIANT;
+            hr = ICreateTypeInfo_AddFuncDesc(cti, index, &fd);
+            if (FAILED(hr)) WARN("AddFuncDesc %s: %#lx\n", debugstr_w(member->name), hr);
+            if (SUCCEEDED(hr)) hr = ICreateTypeInfo_SetFuncAndParamNames(cti, index, names, n);
+            if (FAILED(hr)) WARN("SetFuncAndParamNames %s: %#lx\n", debugstr_w(member->name), hr);
+            free(params);
+            params = NULL;
+            if (FAILED(hr)) goto fail;
+            index++;
+        }
+        memid++;
+    }
+
+    hr = ICreateTypeInfo_QueryInterface(cti, &IID_ITypeInfo, (void **)ret);
+fail:
+    ICreateTypeInfo_Release(cti);
+    return hr;
+}
