 struct scriptlet_member
 {
     struct list entry;
     enum member_type type;
     WCHAR *name;
+    WCHAR *internal_name;   /* the script function of a method */
+    WCHAR *get_name;        /* the script functions of a property */
+    WCHAR *put_name;
     union
     {
         struct list parameters;
@@ -88,10 +92,35 @@ struct scriptlet_script
     WCHAR *body;
 };
 
+struct scriptlet_resource
+{
