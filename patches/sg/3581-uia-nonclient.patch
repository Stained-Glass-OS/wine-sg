+/***********************************************************************
+ *          UiaProviderForNonClient (uiautomationcore.@)
+ *
+ * The provider for a part of a window's non-client area (the window itself,
+ * its title bar, menus, scroll bars), through the window's MSAA objects.
+ */
+HRESULT WINAPI UiaProviderForNonClient(HWND hwnd, LONG obj_id, LONG child_id, IRawElementProviderSimple **elprov)
+{
+    struct msaa_provider *msaa_prov;
+    IAccessible *acc;
+    HRESULT hr;
+
+    TRACE("(%p, %ld, %ld, %p)\n", hwnd, obj_id, child_id, elprov);
+
+    if (elprov)
+        *elprov = NULL;
+    if (!elprov)
+        return E_POINTER;
+    if (!hwnd || !IsWindow(hwnd))
+        return E_INVALIDARG;
+    if (obj_id > 0 || obj_id < OBJID_NATIVEOM)
+        return E_INVALIDARG;
+
+    hr = AccessibleObjectFromWindow(hwnd, obj_id, &IID_IAccessible, (void **)&acc);
+    if (FAILED(hr) || !acc)
+        return FAILED(hr) ? hr : E_FAIL;
+
+    hr = create_msaa_provider(acc, child_id, hwnd, TRUE,
+#ifdef SG_MUTANT_NC_PARENT
+            FALSE,
+#else
+            obj_id == OBJID_WINDOW && child_id == CHILDID_SELF,
+#endif
+            elprov);
+    IAccessible_Release(acc);
+    if (SUCCEEDED(hr))
+    {
+        msaa_prov = impl_from_msaa_provider(*elprov);
+        msaa_prov->nonclient = TRUE;
+    }
+    return hr;
+}
+
 /***********************************************************************
  *          UiaProviderFromIAccessible (uiautomationcore.@)
  */
