+static HRESULT WINAPI dobj_BeginEnumeration( IWbemClassObject *iface, LONG flags )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+    obj->pos = 0;
+    obj->enum_flags = flags;
+    return WBEM_S_NO_ERROR;
+}
+
+static HRESULT WINAPI dobj_Next( IWbemClassObject *iface, LONG flags, BSTR *name, VARIANT *value, CIMTYPE *type,
+                                 LONG *flavor )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+
+    while (obj->pos < obj->count && !dprop_wanted( &obj->props[obj->pos], obj->enum_flags )) obj->pos++;
+    if (obj->pos >= obj->count) return WBEM_S_NO_MORE_DATA;
+    if (name) *name = SysAllocString( obj->props[obj->pos].name );
+    if (value)
+    {
+        VariantInit( value );
+        VariantCopy( value, &obj->props[obj->pos].value );
+    }
+    if (type) *type = obj->props[obj->pos].type;
+    if (flavor) *flavor = obj->props[obj->pos].flavor;
+    obj->pos++;
+    return WBEM_S_NO_ERROR;
+}
+
+static HRESULT WINAPI dobj_EndEnumeration( IWbemClassObject *iface )
+{
+    impl_from_dobj( iface )->pos = 0;
+    return WBEM_S_NO_ERROR;
+}
