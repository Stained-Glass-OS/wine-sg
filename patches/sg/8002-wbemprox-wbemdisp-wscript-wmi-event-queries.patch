+        return hr;
     }
     else if (flags == DISPATCH_PROPERTYPUT)
     {
@@ -4202,6 +4388,132 @@ static HRESULT WINAPI services_ExecNotificationQuery( ISWbemServices *iface, BST
     return hr;
 }
 
+/*
+ * Stained Glass OS: an async event query. WMI hands the events to this relay on
+ * its own thread; the relay posts them to a window of the thread that made the
+ * query, which fires the sink's OnObjectReady there (a script's handlers run on
+ * the script's thread, while WScript.Sleep pumps messages), and OnCompleted
+ * once the query is cancelled.
+ */
+#define WM_SG_WBEM_EVENT  (WM_USER + 1)
+#define WM_SG_WBEM_STATUS (WM_USER + 2)
+
+struct event_relay
+{
+    IWbemObjectSink IWbemObjectSink_iface;
+    LONG refs;
+    struct sink *sink;
+    struct services *services;
+    IDispatch *context;
+    HWND hwnd;
+    struct list entry;          /* in sink->relays until OnCompleted */
+};
+
+static inline struct event_relay *impl_from_relay( IWbemObjectSink *iface )
+{
+    return CONTAINING_RECORD( iface, struct event_relay, IWbemObjectSink_iface );
+}
+
+static HRESULT WINAPI relay_QueryInterface( IWbemObjectSink *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IWbemObjectSink ))
+    {
+        *obj = iface;
+        IWbemObjectSink_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI relay_AddRef( IWbemObjectSink *iface )
+{
+    return InterlockedIncrement( &impl_from_relay( iface )->refs );
+}
+
+static ULONG WINAPI relay_Release( IWbemObjectSink *iface )
+{
+    struct event_relay *relay = impl_from_relay( iface );
+    LONG refs = InterlockedDecrement( &relay->refs );
+
+    if (!refs)
+    {
+        if (relay->context) IDispatch_Release( relay->context );
+        ISWbemServices_Release( &relay->services->ISWbemServices_iface );
+        ISWbemSink_Release( &relay->sink->ISWbemSink_iface );
+        free( relay );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI relay_Indicate( IWbemObjectSink *iface, LONG count, IWbemClassObject **objs )
+{
+    struct event_relay *relay = impl_from_relay( iface );
+    LONG i;
+
+    TRACE( "%p, %ld\n", relay, count );
+    for (i = 0; i < count; i++)
+    {
+        IWbemClassObject_AddRef( objs[i] );
+        if (!PostMessageW( relay->hwnd, WM_SG_WBEM_EVENT, 0, (LPARAM)objs[i] )) IWbemClassObject_Release( objs[i] );
+    }
+    return WBEM_S_NO_ERROR;
+}
+
+static HRESULT WINAPI relay_SetStatus( IWbemObjectSink *iface, LONG flags, HRESULT hr, BSTR param, IWbemClassObject *obj )
+{
+    struct event_relay *relay = impl_from_relay( iface );
+
+    TRACE( "%p, %#lx, %#lx\n", relay, flags, hr );
+    if (flags == WBEM_STATUS_COMPLETE) PostMessageW( relay->hwnd, WM_SG_WBEM_STATUS, hr, 0 );
+    return WBEM_S_NO_ERROR;
+}
+
+static const IWbemObjectSinkVtbl relay_vtbl =
+{
+    relay_QueryInterface, relay_AddRef, relay_Release, relay_Indicate, relay_SetStatus
+};
+
+static LRESULT CALLBACK relay_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct event_relay *relay = (struct event_relay *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+
+    if (msg == WM_SG_WBEM_EVENT)
+    {
+        IWbemClassObject *event = (IWbemClassObject *)lparam;
+        ISWbemObject *object;
+
+        if (relay && SUCCEEDED(SWbemObject_create( relay->services, event, &object )))
+        {
+            sink_object_ready( relay->sink, (IDispatch *)object, relay->context );
+            ISWbemObject_Release( object );
+        }
+        IWbemClassObject_Release( event );
+        return 0;
+    }
+    if (msg == WM_SG_WBEM_STATUS)
+    {
+        if (relay)
+        {
+            sink_completed( relay->sink, (HRESULT)wparam, relay->context );
+            list_remove( &relay->entry );
+            SetWindowLongPtrW( hwnd, GWLP_USERDATA, 0 );
+            DestroyWindow( hwnd );
+            IWbemObjectSink_Release( &relay->IWbemObjectSink_iface );
+        }
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static void cancel_relays( struct sink *sink )
+{
+    struct event_relay *relay, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( relay, next, &sink->relays, struct event_relay, entry )
+        IWbemServices_CancelAsyncCall( relay->services->services, &relay->IWbemObjectSink_iface );
+}
+
 static HRESULT WINAPI services_ExecNotificationQueryAsync(
     ISWbemServices *iface,
     IDispatch *objWbemSink,
@@ -4211,8 +4523,57 @@ static HRESULT WINAPI services_ExecNotificationQueryAsync(
     IDispatch *objWbemNamedValueSet,
     IDispatch *objWbemAsyncContext )
 {
-    FIXME( "\n" );
+    static const WCHAR class_name[] = L"SgWbemEventRelay";
+    struct services *services = impl_from_ISWbemServices( iface );
+    IWbemContext *context = unsafe_get_context_from_namedvalueset( objWbemNamedValueSet );
+    struct event_relay *relay;
+    struct sink *sink;
+    WNDCLASSW wc = { 0 };
+    BSTR lang;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %s, %s, %#lx, %p, %p\n", iface, objWbemSink, debugstr_w(strQuery),
+           debugstr_w(strQueryLanguage), iFlags, objWbemNamedValueSet, objWbemAsyncContext );
+
+#ifdef SG_MUTANT_WBEM_NO_ASYNC_EVENTS
     return E_NOTIMPL;
+#endif
+    ASYNC_SINK( objWbemSink, sink );
+    if (!strQuery) return E_INVALIDARG;
+
+    wc.lpfnWndProc = relay_wndproc;
+    wc.hInstance = GetModuleHandleW( L"wbemdisp.dll" );
+    wc.lpszClassName = class_name;
+    RegisterClassW( &wc );  /* fails harmlessly once it is registered */
+
+    if (!(relay = calloc( 1, sizeof(*relay) ))) return E_OUTOFMEMORY;
+    relay->IWbemObjectSink_iface.lpVtbl = &relay_vtbl;
+    relay->refs = 1;
+    if (!(relay->hwnd = CreateWindowW( class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, wc.hInstance, NULL )))
+    {
+        free( relay );
+        return E_OUTOFMEMORY;
+    }
+    ISWbemSink_AddRef( &sink->ISWbemSink_iface );
+    relay->sink = sink;
+    ISWbemServices_AddRef( &services->ISWbemServices_iface );
+    relay->services = services;
+    if ((relay->context = objWbemAsyncContext)) IDispatch_AddRef( relay->context );
+    SetWindowLongPtrW( relay->hwnd, GWLP_USERDATA, (LONG_PTR)relay );
+
+    lang = strQueryLanguage && strQueryLanguage[0] ? strQueryLanguage : SysAllocString( L"WQL" );
+    hr = IWbemServices_ExecNotificationQueryAsync( services->services, lang, strQuery, 0, context,
+                                                   &relay->IWbemObjectSink_iface );
+    if (lang != strQueryLanguage) SysFreeString( lang );
+    if (FAILED(hr))
+    {
+        SetWindowLongPtrW( relay->hwnd, GWLP_USERDATA, 0 );
+        DestroyWindow( relay->hwnd );
+        IWbemObjectSink_Release( &relay->IWbemObjectSink_iface );
+        return hr;
+    }
+    list_add_tail( &sink->relays, &relay->entry );
+    return S_OK;
 }
 
 static HRESULT WINAPI services_ExecMethod(
