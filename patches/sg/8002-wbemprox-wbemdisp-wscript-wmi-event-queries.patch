+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS: the events Windows' WMI delivers for classes that have no
+ * event provider of their own, found the way Windows finds them -- by polling.
+ *
+ *   SELECT * FROM __InstanceCreationEvent|__InstanceDeletionEvent|
+ *                 __InstanceModificationEvent|__InstanceOperationEvent
+ *       [WITHIN seconds] WHERE TargetInstance ISA 'Class' [AND conditions on TargetInstance.Prop]
+ *
+ * runs "SELECT * FROM Class WHERE conditions" every WITHIN seconds (one second
+ * when there is no WITHIN) and compares the instances by __RELPATH: a new one is
+ * a creation event, a missing one a deletion event, one whose property values
+ * changed a modification event (with PreviousInstance). The extrinsic events
+ * Win32_ProcessStartTrace/Win32_ProcessStopTrace/Win32_ProcessTrace come from
+ * Win32_Process the same way (their ProcessName/ProcessID/ParentProcessID/
+ * SessionID conditions are Win32_Process's Name/ProcessId/ParentProcessId/
+ * SessionId; polled every 200 ms, so a process that lives less than that may
+ * be missed), Win32_DeviceChangeEvent from Win32_PnPEntity and
+ * Win32_VolumeChangeEvent from Win32_LogicalDisk (EventType 2 arrival, 3
+ * removal). The instances there when the query starts make no events.
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "wbemcli.h"
+
+#include "wine/debug.h"
+#include "wbemprox_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wbemprox);
+
+enum event_kind
+{
+    EVENT_INSTANCE,      /* __Instance*Event */
+    EVENT_PROCESS,       /* Win32_Process*Trace */
+    EVENT_DEVICE,        /* Win32_DeviceChangeEvent */
+    EVENT_VOLUME,        /* Win32_VolumeChangeEvent */
+};
+
+#define WANT_CREATE 1
+#define WANT_DELETE 2
+#define WANT_MODIFY 4
+
+struct snapshot_item
+{
+    BSTR relpath;
+    WCHAR *values;           /* the property values, to see a modification */
+    IWbemClassObject *obj;
+};
+
+struct snapshot
+{
+    struct snapshot_item *items;
+    UINT count;
+};
+
+struct event_sub
+{
+    struct list entry;
+    enum wbm_namespace ns;
+    enum event_kind kind;
+    UINT want;               /* WANT_* */
+    WCHAR *event_class;      /* the class the events are of (__InstanceCreationEvent for an operation event's creation...) */
+    WCHAR *poll;             /* the data query polled */
+    int event_type;          /* EVENT_DEVICE/EVENT_VOLUME: EventType asked for, 0 for both */
+    DWORD interval;          /* milliseconds */
+    IWbemObjectSink *sink;   /* an async query's sink, or NULL */
+    struct event_queue *queue; /* a semisynchronous query's enumerator, or NULL */
+    HANDLE stop, thread;
+    struct snapshot snap;
+};
+
+/* the events a semisynchronous query's enumerator hands out */
+struct event_queue
+{
+    IEnumWbemClassObject IEnumWbemClassObject_iface;
+    LONG refs;
+    CRITICAL_SECTION cs;
+    HANDLE ready;            /* set while there are events */
+    IWbemClassObject **events;
+    UINT count, size;
+    struct event_sub *sub;
+};
+
+static const WCHAR *skip_space( const WCHAR *p )
+{
+    while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+    return p;
+}
+
+/* is the word at p this keyword (not the start of a longer name)? */
+static BOOL is_word( const WCHAR *p, const WCHAR *word )
+{
+    size_t len = wcslen( word );
+    if (wcsnicmp( p, word, len )) return FALSE;
+    return !iswalnum( p[len] ) && p[len] != '_' && p[len] != '.';
+}
+
+static BOOL is_name_char( WCHAR c )
+{
+    return iswalnum( c ) || c == '_';
+}
+
+/* the WHERE text with the keyword-free spans changed: TargetInstance. dropped,
+ * or Win32_Process*Trace's property names made Win32_Process's */
+static WCHAR *rewrite_condition( const WCHAR *cond, enum event_kind kind )
+{
+    static const struct { const WCHAR *from, *to; } process_names[] =
+    {
+        { L"ProcessName", L"Name" }, { L"ProcessID", L"ProcessId" },
+        { L"ParentProcessID", L"ParentProcessId" }, { L"SessionID", L"SessionId" },
+    };
+    WCHAR *ret = malloc( (wcslen( cond ) * 2 + 1) * sizeof(WCHAR) ), *o = ret;
+    const WCHAR *p = cond;
+    unsigned int i;
+
+    if (!ret) return NULL;
+    while (*p)
+    {
+        if (*p == '\'' || *p == '"')
+        {
+            WCHAR q = *p;
+            *o++ = *p++;
+            while (*p && *p != q) *o++ = *p++;
+            if (*p) *o++ = *p++;
+            continue;
+        }
+        if (is_name_char( *p ) && (p == cond || !is_name_char( p[-1] )))
+        {
+            if (kind == EVENT_INSTANCE && !wcsnicmp( p, L"TargetInstance.", 15 ))
+            {
+                p += 15;
+                continue;
+            }
+            if (kind == EVENT_PROCESS)
+            {
+                for (i = 0; i < ARRAY_SIZE(process_names); i++)
+                {
+                    size_t len = wcslen( process_names[i].from );
+                    if (!wcsnicmp( p, process_names[i].from, len ) && !is_name_char( p[len] ))
+                    {
+                        wcscpy( o, process_names[i].to );
+                        o += wcslen( process_names[i].to );
+                        p += len;
+                        break;
+                    }
+                }
+                if (i < ARRAY_SIZE(process_names)) continue;
+            }
+            while (is_name_char( *p ) || *p == '.') *o++ = *p++;
+            continue;
+        }
+        *o++ = *p++;
+    }
+    *o = 0;
+    return ret;
+}
+
+/* "TargetInstance ISA 'Class'" taken out of a condition: the class, and the rest in *rest */
+static HRESULT take_isa( const WCHAR *cond, WCHAR **class, WCHAR **rest )
+{
+    const WCHAR *p = cond, *start = NULL, *end = NULL, *name;
+    WCHAR *r;
+    size_t len;
+
+    *class = *rest = NULL;
+    while (*p)
+    {
+        if (*p == '\'' || *p == '"')
+        {
+            WCHAR q = *p++;
+            while (*p && *p != q) p++;
+            if (*p) p++;
+            continue;
+        }
+        if ((p == cond || !is_name_char( p[-1] )) && is_word( p, L"TargetInstance" ))
+        {
+            const WCHAR *q = skip_space( p + 14 );
+            if (is_word( q, L"ISA" ))
+            {
+                WCHAR quote;
+                q = skip_space( q + 3 );
+                if (*q != '\'' && *q != '"') return WBEM_E_INVALID_QUERY;
+                quote = *q++;
+                name = q;
+                while (*q && *q != quote) q++;
+                if (!*q) return WBEM_E_INVALID_QUERY;
+                if (!(*class = malloc( (q - name + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+                memcpy( *class, name, (q - name) * sizeof(WCHAR) );
+                (*class)[q - name] = 0;
+                start = p;
+                end = q + 1;
+                break;
+            }
+        }
+        p++;
+    }
+    if (!*class) return WBEM_E_NOT_SUPPORTED;  /* events of every class: not polled */
+
+    /* the rest, without the AND that joined the ISA test to it */
+    len = wcslen( cond );
+    if (!(r = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( r, cond, (start - cond) * sizeof(WCHAR) );
+    r[start - cond] = 0;
+    {
+        WCHAR *tail = r + (start - cond);
+        const WCHAR *after = skip_space( end );
+        size_t n = wcslen( r );
+
+        while (n && (r[n - 1] == ' ' || r[n - 1] == '\t' || r[n - 1] == '(')) n--;
+        if (n >= 3 && !wcsnicmp( r + n - 3, L"AND", 3 ) && (n == 3 || !is_name_char( r[n - 4] )))
+        {
+            r[n - 3] = 0;
+            tail = r + n - 3;
+        }
+        else if (is_word( after, L"AND" )) after = skip_space( after + 3 );
+        wcscpy( tail, after );
+    }
+    /* nothing but spaces and brackets left: no condition */
+    for (p = r; *p; p++) if (*p != ' ' && *p != '\t' && *p != '(' && *p != ')') break;
+    if (!*p) r[0] = 0;
+    *rest = r;
+    return S_OK;
+}
+
+static void free_sub( struct event_sub *sub )
+{
+    UINT i;
+
+    for (i = 0; i < sub->snap.count; i++)
+    {
+        SysFreeString( sub->snap.items[i].relpath );
+        free( sub->snap.items[i].values );
+        IWbemClassObject_Release( sub->snap.items[i].obj );
+    }
+    free( sub->snap.items );
+    if (sub->sink) IWbemObjectSink_Release( sub->sink );
+    if (sub->stop) CloseHandle( sub->stop );
+    if (sub->thread) CloseHandle( sub->thread );
+    free( sub->event_class );
+    free( sub->poll );
+    free( sub );
+}
+
+/* the query understood: what to poll, and what events it asks for */
+static HRESULT parse_event_query( enum wbm_namespace ns, const WCHAR *query, struct event_sub **ret )
+{
+    const WCHAR *p = skip_space( query ), *name;
+    WCHAR *class = NULL, *cond = NULL, *target = NULL, *rest = NULL;
+    struct event_sub *sub;
+    double within = 0;
+    HRESULT hr = WBEM_E_INVALID_QUERY;
+    size_t len;
+
+    if (!is_word( p, L"SELECT" )) return WBEM_E_INVALID_QUERY;
+    while (*p && !is_word( p, L"FROM" )) p++;
+    if (!*p) return WBEM_E_INVALID_QUERY;
+    p = skip_space( p + 4 );
+    name = p;
+    while (is_name_char( *p )) p++;
+    if (p == name) return WBEM_E_INVALID_QUERY;
+    if (!(class = malloc( (p - name + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( class, name, (p - name) * sizeof(WCHAR) );
+    class[p - name] = 0;
+    p = skip_space( p );
+    if (is_word( p, L"WITHIN" ))
+    {
+        WCHAR *e;
+        within = wcstod( skip_space( p + 6 ), &e );
+        if (e == skip_space( p + 6 ) || within <= 0) goto done;
+        p = skip_space( e );
+    }
+    if (is_word( p, L"WHERE" ))
+    {
+        p = skip_space( p + 5 );
+        if (!(cond = wcsdup( p ))) { hr = E_OUTOFMEMORY; goto done; }
+    }
+    else if (*p) goto done;   /* GROUP, HAVING: not supported */
+
+    if (!(sub = calloc( 1, sizeof(*sub) ))) { hr = E_OUTOFMEMORY; goto done; }
+    sub->ns = ns;
+    sub->interval = within ? (DWORD)(within * 1000) : 1000;
+    if (sub->interval < 100) sub->interval = 100;
+
+    if (!wcsicmp( class, L"__InstanceCreationEvent" ) || !wcsicmp( class, L"__InstanceDeletionEvent" ) ||
+        !wcsicmp( class, L"__InstanceModificationEvent" ) || !wcsicmp( class, L"__InstanceOperationEvent" ))
+    {
+        struct table *table;
+
+        sub->kind = EVENT_INSTANCE;
+        if (!wcsicmp( class, L"__InstanceCreationEvent" )) sub->want = WANT_CREATE;
+        else if (!wcsicmp( class, L"__InstanceDeletionEvent" )) sub->want = WANT_DELETE;
+        else if (!wcsicmp( class, L"__InstanceModificationEvent" )) sub->want = WANT_MODIFY;
+        else sub->want = WANT_CREATE | WANT_DELETE | WANT_MODIFY;
+        if (!cond) { hr = WBEM_E_NOT_SUPPORTED; free_sub( sub ); goto done; }
+        if ((hr = take_isa( cond, &target, &rest )) != S_OK) { free_sub( sub ); goto done; }
+        if (wcsstr( rest, L"PreviousInstance" ) || wcsstr( rest, L"previousinstance" ))
+        {
+            FIXME( "conditions on PreviousInstance are not supported: %s\n", debugstr_w(rest) );
+            hr = WBEM_E_NOT_SUPPORTED;
+            free_sub( sub );
+            goto done;
+        }
+        if (!(table = find_table( ns, target )))
+        {
+            hr = WBEM_E_INVALID_CLASS;
+            free_sub( sub );
+            goto done;
+        }
+        release_table( table );
+        free( cond );
+        cond = rest[0] ? rewrite_condition( rest, EVENT_INSTANCE ) : NULL;
+        len = wcslen( target ) + (cond ? wcslen( cond ) : 0) + 32;
+        if ((sub->poll = malloc( len * sizeof(WCHAR) )))
+        {
+            if (cond) swprintf( sub->poll, len, L"SELECT * FROM %s WHERE %s", target, cond );
+            else swprintf( sub->poll, len, L"SELECT * FROM %s", target );
+        }
+    }
+    else if (!wcsicmp( class, L"Win32_ProcessStartTrace" ) || !wcsicmp( class, L"Win32_ProcessStopTrace" ) ||
+             !wcsicmp( class, L"Win32_ProcessTrace" ))
+    {
+        WCHAR *mapped = cond ? rewrite_condition( cond, EVENT_PROCESS ) : NULL;
+
+        sub->kind = EVENT_PROCESS;
+        /* Windows reports these as processes start and stop: a short poll keeps
+         * short-lived processes from slipping between two looks */
+        if (!within) sub->interval = 200;
+        if (!wcsicmp( class, L"Win32_ProcessStartTrace" )) sub->want = WANT_CREATE;
+        else if (!wcsicmp( class, L"Win32_ProcessStopTrace" )) sub->want = WANT_DELETE;
+        else sub->want = WANT_CREATE | WANT_DELETE;
+        len = (mapped ? wcslen( mapped ) : 0) + 48;
+        if ((sub->poll = malloc( len * sizeof(WCHAR) )))
+        {
+            if (mapped) swprintf( sub->poll, len, L"SELECT * FROM Win32_Process WHERE %s", mapped );
+            else wcscpy( sub->poll, L"SELECT * FROM Win32_Process" );
+        }
+        free( mapped );
+    }
+    else if (!wcsicmp( class, L"Win32_DeviceChangeEvent" ) || !wcsicmp( class, L"Win32_VolumeChangeEvent" ))
+    {
+        BOOL volume = !wcsicmp( class, L"Win32_VolumeChangeEvent" );
+
+        sub->kind = volume ? EVENT_VOLUME : EVENT_DEVICE;
+        sub->want = WANT_CREATE | WANT_DELETE;
+        if (cond)
+        {
+            /* EventType = n is the condition these are asked with */
+            const WCHAR *c = skip_space( cond );
+            WCHAR *e;
+
+            if (!is_word( c, L"EventType" )) { hr = WBEM_E_NOT_SUPPORTED; free_sub( sub ); goto done; }
+            c = skip_space( c + 9 );
+            if (*c != '=') { hr = WBEM_E_NOT_SUPPORTED; free_sub( sub ); goto done; }
+            sub->event_type = wcstol( skip_space( c + 1 ), &e, 10 );
+            if (*skip_space( e )) { hr = WBEM_E_NOT_SUPPORTED; free_sub( sub ); goto done; }
+            if (sub->event_type == 2) sub->want = WANT_CREATE;
+            else if (sub->event_type == 3) sub->want = WANT_DELETE;
+            else sub->want = 0;  /* configuration changes and docking: none here */
+        }
+        sub->poll = wcsdup( volume ? L"SELECT * FROM Win32_LogicalDisk" : L"SELECT * FROM Win32_PnPEntity" );
+    }
+    else
+    {
+        FIXME( "events of %s are not supported\n", debugstr_w(class) );
+        hr = WBEM_E_INVALID_CLASS;
+        free_sub( sub );
+        goto done;
+    }
+    if (!sub->poll) { hr = E_OUTOFMEMORY; free_sub( sub ); goto done; }
+    TRACE( "%s: polling %s every %lu ms, want %#x\n", debugstr_w(query), debugstr_w(sub->poll), sub->interval,
+           sub->want );
+    *ret = sub;
+    hr = S_OK;
+
+done:
+    free( class );
+    free( cond );
+    free( target );
+    free( rest );
+    return hr;
+}
+
+/*
+ * A detached object: the property values of an instance or an event, held by
+ * itself. wbemprox's own objects keep their table locked for as long as they
+ * live (grab_table), so objects that outlive a poll, or go to another thread,
+ * must not be those.
+ */
+struct dprop
+{
+    BSTR name;
+    VARIANT value;
+    CIMTYPE type;
+    LONG flavor;
+};
+
+struct dobj
+{
+    IWbemClassObject IWbemClassObject_iface;
+    LONG refs;
+    struct dprop *props;
+    UINT count;
+    UINT pos;              /* of the enumeration */
+    LONG enum_flags;
+};
+
+static const IWbemClassObjectVtbl dobj_vtbl;
+
+static inline struct dobj *impl_from_dobj( IWbemClassObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct dobj, IWbemClassObject_iface );
+}
+
+static struct dobj *dobj_new( void )
+{
+    struct dobj *obj = calloc( 1, sizeof(*obj) );
+    if (!obj) return NULL;
+    obj->IWbemClassObject_iface.lpVtbl = &dobj_vtbl;
+    obj->refs = 1;
+    return obj;
+}
+
+static struct dprop *dobj_find( struct dobj *obj, const WCHAR *name )
+{
+    UINT i;
+    if (!name) return NULL;
+    for (i = 0; i < obj->count; i++) if (!wcsicmp( obj->props[i].name, name )) return &obj->props[i];
+    return NULL;
+}
+
+static HRESULT dobj_set( struct dobj *obj, const WCHAR *name, const VARIANT *value, CIMTYPE type, LONG flavor )
+{
+    struct dprop *prop = dobj_find( obj, name ), *grown;
+
+    if (!prop)
+    {
+        if (!(grown = realloc( obj->props, (obj->count + 1) * sizeof(*grown) ))) return E_OUTOFMEMORY;
+        obj->props = grown;
+        prop = &obj->props[obj->count];
+        if (!(prop->name = SysAllocString( name ))) return E_OUTOFMEMORY;
+        VariantInit( &prop->value );
+        prop->type = type;
+        prop->flavor = flavor;
+        obj->count++;
+    }
+    else if (type) prop->type = type;
+    VariantClear( &prop->value );
+    if (value) return VariantCopy( &prop->value, value );
+    V_VT( &prop->value ) = VT_NULL;
+    return S_OK;
+}
+
+static void dobj_set_str( struct dobj *obj, const WCHAR *name, const WCHAR *str, CIMTYPE type )
+{
+    VARIANT v;
+    if (str)
+    {
+        V_VT( &v ) = VT_BSTR;
+        V_BSTR( &v ) = SysAllocString( str );
+        dobj_set( obj, name, &v, type, WBEM_FLAVOR_ORIGIN_SYSTEM );
+        VariantClear( &v );
+    }
+    else dobj_set( obj, name, NULL, type, WBEM_FLAVOR_ORIGIN_SYSTEM );
+}
+
+static HRESULT WINAPI dobj_QueryInterface( IWbemClassObject *iface, REFIID riid, void **ret )
+{
+    if (IsEqualGUID( riid, &IID_IWbemClassObject ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *ret = iface;
+        IWbemClassObject_AddRef( iface );
+        return S_OK;
+    }
+    *ret = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI dobj_AddRef( IWbemClassObject *iface )
+{
+    return InterlockedIncrement( &impl_from_dobj( iface )->refs );
+}
+
+static ULONG WINAPI dobj_Release( IWbemClassObject *iface )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+    LONG refs = InterlockedDecrement( &obj->refs );
+    UINT i;
+
+    if (!refs)
+    {
+        for (i = 0; i < obj->count; i++)
+        {
+            SysFreeString( obj->props[i].name );
+            VariantClear( &obj->props[i].value );
+        }
+        free( obj->props );
+        free( obj );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI dobj_GetQualifierSet( IWbemClassObject *iface, IWbemQualifierSet **set )
+{
+    if (set) *set = NULL;
+    return WBEM_E_NOT_SUPPORTED;
+}
+
+static HRESULT WINAPI dobj_Get( IWbemClassObject *iface, LPCWSTR name, LONG flags, VARIANT *value, CIMTYPE *type,
+                                LONG *flavor )
+{
+    struct dprop *prop = dobj_find( impl_from_dobj( iface ), name );
+
+    TRACE( "%p, %s\n", iface, debugstr_w(name) );
+    if (!name) return WBEM_E_INVALID_PARAMETER;
+    if (!prop) return WBEM_E_NOT_FOUND;
+    if (value)
+    {
+        VariantInit( value );
+        VariantCopy( value, &prop->value );
+    }
+    if (type) *type = prop->type;
+    if (flavor) *flavor = prop->flavor;
+    return WBEM_S_NO_ERROR;
+}
+
+static HRESULT WINAPI dobj_Put( IWbemClassObject *iface, LPCWSTR name, LONG flags, VARIANT *value, CIMTYPE type )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+
+    if (!name) return WBEM_E_INVALID_PARAMETER;
+    if (name[0] == '_' && name[1] == '_') return WBEM_E_READ_ONLY;
+    return dobj_set( obj, name, value, type, WBEM_FLAVOR_ORIGIN_LOCAL );
+}
+
+static HRESULT WINAPI dobj_Delete( IWbemClassObject *iface, LPCWSTR name )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+    struct dprop *prop = dobj_find( obj, name );
+    UINT i;
+
+    if (!prop) return WBEM_E_NOT_FOUND;
+    i = prop - obj->props;
+    SysFreeString( prop->name );
+    VariantClear( &prop->value );
+    memmove( prop, prop + 1, (obj->count - i - 1) * sizeof(*prop) );
+    obj->count--;
+    return WBEM_S_NO_ERROR;
+}
+
+static BOOL dprop_wanted( const struct dprop *prop, LONG flags )
+{
+    BOOL system = prop->name[0] == '_' && prop->name[1] == '_';
+    if ((flags & WBEM_FLAG_SYSTEM_ONLY) && !system) return FALSE;
+    if ((flags & WBEM_FLAG_NONSYSTEM_ONLY) && system) return FALSE;
+    return TRUE;
+}
