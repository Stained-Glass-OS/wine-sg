new file mode 100644
index 0000000..cdde871
--- /dev/null
+++ b/dlls/wbemprox/events.c
@@ -0,0 +1,1322 @@
+/*
+ * WMI event queries (ExecNotificationQuery and ExecNotificationQueryAsync)
+ *
+ * Copyright 2026 Stained Glass OS
