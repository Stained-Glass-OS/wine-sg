+    { L"Win32_DeviceChangeEvent", C(col_devicechangeevent), 0, 0, NULL, fill_event_class },
+    { L"Win32_ProcessStartTrace", C(col_processstarttrace), 0, 0, NULL, fill_event_class },
+    { L"Win32_ProcessStopTrace", C(col_processstoptrace), 0, 0, NULL, fill_event_class },
+    { L"Win32_VolumeChangeEvent", C(col_volumechangeevent), 0, 0, NULL, fill_event_class },
     { L"CIM_DataFile", C(col_datafile), 0, 0, NULL, fill_datafile },
     { L"CIM_LogicalDisk", C(col_logicaldisk), 0, 0, NULL, fill_logicaldisk },
     { L"CIM_Processor", C(col_processor), 0, 0, NULL, fill_processor },
