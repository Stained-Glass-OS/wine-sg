+/* every property of a wbemprox object, copied */
+static struct dobj *detach( IWbemClassObject *src )
+{
+    struct dobj *obj = dobj_new();
+    CIMTYPE type;
+    LONG flavor;
+    BSTR name;
+    VARIANT v;
+
+    if (!obj) return NULL;
+    if (FAILED(IWbemClassObject_BeginEnumeration( src, 0 ))) return obj;
+    while (IWbemClassObject_Next( src, 0, &name, &v, &type, &flavor ) == S_OK)
+    {
+        dobj_set( obj, name, &v, type, flavor );
+        SysFreeString( name );
+        VariantClear( &v );
+    }
+    IWbemClassObject_EndEnumeration( src );
+    return obj;
+}
+
+/* the values of an instance's own properties, joined, to see whether it changed */
+static WCHAR *instance_values( struct dobj *obj )
+{
+    WCHAR *ret = NULL, *grown;
+    size_t len = 0;
+    UINT i;
+
+    for (i = 0; i < obj->count; i++)
+    {
+        const WCHAR *text = L"?";
+        VARIANT v;
+        size_t n;
+
+        if (obj->props[i].name[0] == '_' && obj->props[i].name[1] == '_') continue;
+        VariantInit( &v );
+        if (V_VT( &obj->props[i].value ) == VT_NULL) text = L"";
+        else if (!(V_VT( &obj->props[i].value ) & VT_ARRAY) && V_VT( &obj->props[i].value ) != VT_UNKNOWN &&
+                 V_VT( &obj->props[i].value ) != VT_DISPATCH &&
+                 SUCCEEDED(VariantChangeType( &v, &obj->props[i].value, 0, VT_BSTR ))) text = V_BSTR( &v );
+        n = wcslen( obj->props[i].name ) + wcslen( text ) + 3;
+        if ((grown = realloc( ret, (len + n + 1) * sizeof(WCHAR) )))
+        {
+            ret = grown;
+            swprintf( ret + len, n + 1, L"%s=%s;", obj->props[i].name, text );
+            len += wcslen( ret + len );
+        }
+        VariantClear( &v );
+    }
+    return ret ? ret : wcsdup( L"" );
+}
+
+/* the instances the poll query gives now, detached; no wbemprox object is left behind */
+static HRESULT take_snapshot( struct event_sub *sub, struct snapshot *snap )
+{
+    IEnumWbemClassObject *iter;
+    IWbemClassObject *obj;
+    ULONG count;
+    HRESULT hr;
+
+    snap->items = NULL;
+    snap->count = 0;
+    if ((hr = exec_query( sub->ns, sub->poll, &iter )) != S_OK) return hr;
+    for (;;)
+    {
+        struct snapshot_item *grown;
+        struct dobj *copy;
+        struct dprop *path;
+
+        IEnumWbemClassObject_Next( iter, WBEM_INFINITE, 1, &obj, &count );
+        if (!count) break;
+        copy = detach( obj );
+        IWbemClassObject_Release( obj );
+        if (!copy) continue;
+        path = dobj_find( copy, L"__RELPATH" );
+        if (!path || V_VT( &path->value ) != VT_BSTR ||
+            !(grown = realloc( snap->items, (snap->count + 1) * sizeof(*grown) )))
+        {
+            IWbemClassObject_Release( &copy->IWbemClassObject_iface );
+            continue;
+        }
+        snap->items = grown;
+        snap->items[snap->count].relpath = SysAllocString( V_BSTR( &path->value ) );
+        snap->items[snap->count].values = sub->want & WANT_MODIFY ? instance_values( copy ) : NULL;
+        snap->items[snap->count].obj = &copy->IWbemClassObject_iface;
+        snap->count++;
+    }
+    IEnumWbemClassObject_Release( iter );
+    return S_OK;
+}
+
+static const struct snapshot_item *find_item( const struct snapshot *snap, BSTR relpath )
+{
+    UINT i;
+    for (i = 0; i < snap->count; i++) if (!wcscmp( snap->items[i].relpath, relpath )) return &snap->items[i];
+    return NULL;
+}
+
+static void put_uint( struct dobj *obj, const WCHAR *name, UINT value, CIMTYPE type )
+{
+    VARIANT v;
+    V_VT( &v ) = VT_I4;
+    V_I4( &v ) = value;
+    dobj_set( obj, name, &v, type, WBEM_FLAVOR_ORIGIN_PROPAGATED );
+}
+
+static void put_object( struct dobj *obj, const WCHAR *name, IWbemClassObject *value )
+{
+    VARIANT v;
+    V_VT( &v ) = VT_UNKNOWN;
+    V_UNKNOWN( &v ) = (IUnknown *)value;
+    dobj_set( obj, name, &v, CIM_OBJECT, WBEM_FLAVOR_ORIGIN_PROPAGATED );
+}
+
+/* uint64 properties travel as decimal strings, as WMI's do */
+static void put_time( struct dobj *obj )
+{
+    FILETIME ft;
+    WCHAR buf[24];
+
+    GetSystemTimeAsFileTime( &ft );
+    swprintf( buf, ARRAY_SIZE(buf), L"%I64u", (ULONGLONG)ft.dwHighDateTime << 32 | ft.dwLowDateTime );
+    dobj_set_str( obj, L"TIME_CREATED", buf, CIM_UINT64 );
+}
+
+static void copy_property( struct dobj *to, const WCHAR *to_name, IWbemClassObject *from, const WCHAR *from_name,
+                           CIMTYPE type )
+{
+    VARIANT v;
+
+    VariantInit( &v );
+    if (SUCCEEDED(IWbemClassObject_Get( from, from_name, 0, &v, NULL, NULL )))
+        dobj_set( to, to_name, &v, type, WBEM_FLAVOR_ORIGIN_PROPAGATED );
+    VariantClear( &v );
+}
+
+/* an event object: its class, superclass chain and system properties */
+static struct dobj *new_event( const WCHAR *class, const WCHAR *super, const WCHAR *root )
+{
+    struct dobj *event = dobj_new();
+    SAFEARRAY *sa;
+    VARIANT v;
+    LONG i = 0;
+
+    if (!event) return NULL;
+    dobj_set_str( event, L"__CLASS", class, CIM_STRING );
+    dobj_set_str( event, L"__SUPERCLASS", super, CIM_STRING );
+    dobj_set_str( event, L"__DYNASTY", L"__SystemClass", CIM_STRING );
+    dobj_set_str( event, L"__RELPATH", NULL, CIM_STRING );
+    dobj_set_str( event, L"__PATH", NULL, CIM_STRING );
+    V_VT( &v ) = VT_I4;
+    V_I4( &v ) = WBEM_GENUS_INSTANCE;
+    dobj_set( event, L"__GENUS", &v, CIM_SINT32, WBEM_FLAVOR_ORIGIN_SYSTEM );
+    if ((sa = SafeArrayCreateVector( VT_BSTR, 0, root ? 4 : 3 )))
+    {
+        const WCHAR *chain[] = { super, root ? root : L"__Event", root ? L"__Event" : L"__IndicationRelated",
+                                 root ? L"__IndicationRelated" : NULL };
+        for (i = 0; i < (root ? 4 : 3); i++)
+        {
+            BSTR name = SysAllocString( chain[i] );
+            SafeArrayPutElement( sa, &i, name );
+            SysFreeString( name );
+        }
+        V_VT( &v ) = VT_ARRAY | VT_BSTR;
+        V_ARRAY( &v ) = sa;
+        dobj_set( event, L"__DERIVATION", &v, CIM_STRING | CIM_FLAG_ARRAY, WBEM_FLAVOR_ORIGIN_SYSTEM );
+        SafeArrayDestroy( sa );
+    }
+    return event;
+}
+
+static void deliver( struct event_sub *sub, IWbemClassObject *event )
+{
+    if (sub->sink) IWbemObjectSink_Indicate( sub->sink, 1, &event );
+    else if (sub->queue)
+    {
+        struct event_queue *q = sub->queue;
+
+        EnterCriticalSection( &q->cs );
+        if (q->count == q->size)
+        {
+            UINT size = q->size ? q->size * 2 : 16;
+            IWbemClassObject **grown = realloc( q->events, size * sizeof(*grown) );
+            if (grown) { q->events = grown; q->size = size; }
+        }
+        if (q->count < q->size)
+        {
+            IWbemClassObject_AddRef( event );
+            q->events[q->count++] = event;
+            SetEvent( q->ready );
+        }
+        LeaveCriticalSection( &q->cs );
+    }
+}
+
+/* the event for an instance that came (create), went (delete) or changed */
+static void instance_event( struct event_sub *sub, UINT what, IWbemClassObject *obj, IWbemClassObject *previous )
+{
+    struct dobj *event = NULL;
+
+    switch (sub->kind)
+    {
+    case EVENT_INSTANCE:
+        event = new_event( what == WANT_CREATE ? L"__InstanceCreationEvent" :
+                           what == WANT_DELETE ? L"__InstanceDeletionEvent" : L"__InstanceModificationEvent",
+                           L"__InstanceOperationEvent", NULL );
+        if (!event) return;
+        put_object( event, L"TargetInstance", obj );
+        if (previous) put_object( event, L"PreviousInstance", previous );
+        break;
+    case EVENT_PROCESS:
+        event = new_event( what == WANT_CREATE ? L"Win32_ProcessStartTrace" : L"Win32_ProcessStopTrace",
+                           L"Win32_ProcessTrace", L"__ExtrinsicEvent" );
+        if (!event) return;
+        copy_property( event, L"ProcessName", obj, L"Name", CIM_STRING );
+        copy_property( event, L"ProcessID", obj, L"ProcessId", CIM_UINT32 );
+        copy_property( event, L"ParentProcessID", obj, L"ParentProcessId", CIM_UINT32 );
+        copy_property( event, L"SessionID", obj, L"SessionId", CIM_UINT32 );
+        if (what == WANT_DELETE) put_uint( event, L"ExitStatus", 0, CIM_UINT32 );
+        break;
+    case EVENT_DEVICE:
+        event = new_event( L"Win32_DeviceChangeEvent", L"Win32_SystemConfigurationChangeEvent", L"__ExtrinsicEvent" );
+        if (!event) return;
+        put_uint( event, L"EventType", what == WANT_CREATE ? 2 : 3, CIM_UINT16 );
+        break;
+    case EVENT_VOLUME:
+        event = new_event( L"Win32_VolumeChangeEvent", L"Win32_DeviceChangeEvent", L"Win32_SystemConfigurationChangeEvent" );
+        if (!event) return;
+        copy_property( event, L"DriveName", obj, L"DeviceID", CIM_STRING );
+        put_uint( event, L"EventType", what == WANT_CREATE ? 2 : 3, CIM_UINT16 );
+        break;
+    }
+    put_time( event );
+    deliver( sub, &event->IWbemClassObject_iface );
+    IWbemClassObject_Release( &event->IWbemClassObject_iface );
+}
+
+static void free_snapshot( struct snapshot *snap )
+{
+    UINT i;
+    for (i = 0; i < snap->count; i++)
+    {
+        SysFreeString( snap->items[i].relpath );
+        free( snap->items[i].values );
+        IWbemClassObject_Release( snap->items[i].obj );
+    }
+    free( snap->items );
+    snap->items = NULL;
+    snap->count = 0;
+}
+
+static void poll_once( struct event_sub *sub )
+{
+    struct snapshot now;
+    UINT i, device_changes = 0;
+
+    if (take_snapshot( sub, &now ) != S_OK) return;
+    for (i = 0; i < now.count; i++)
+    {
+        const struct snapshot_item *old = find_item( &sub->snap, now.items[i].relpath );
+
+        if (!old)
+        {
+            if (sub->kind == EVENT_DEVICE) device_changes |= WANT_CREATE;
+            else if (sub->want & WANT_CREATE) instance_event( sub, WANT_CREATE, now.items[i].obj, NULL );
+        }
+        else if ((sub->want & WANT_MODIFY) && old->values && now.items[i].values &&
+                 wcscmp( old->values, now.items[i].values ))
+            instance_event( sub, WANT_MODIFY, now.items[i].obj, old->obj );
+    }
+    for (i = 0; i < sub->snap.count; i++)
+    {
+        if (find_item( &now, sub->snap.items[i].relpath )) continue;
+        if (sub->kind == EVENT_DEVICE) device_changes |= WANT_DELETE;
+        else if (sub->want & WANT_DELETE) instance_event( sub, WANT_DELETE, sub->snap.items[i].obj, NULL );
+    }
+    /* devices: one event per kind of change in a poll, as Windows sends one per broadcast */
+    if (device_changes & sub->want & WANT_CREATE) instance_event( sub, WANT_CREATE, NULL, NULL );
+    if (device_changes & sub->want & WANT_DELETE) instance_event( sub, WANT_DELETE, NULL, NULL );
+    free_snapshot( &sub->snap );
+    sub->snap = now;
+}
+
+static DWORD CALLBACK poll_thread( void *arg )
+{
+    struct event_sub *sub = arg;
+
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    while (WaitForSingleObject( sub->stop, sub->interval ) == WAIT_TIMEOUT)
+    {
+#ifndef SG_MUTANT_WMI_NO_EVENTS
+        poll_once( sub );
+#endif
+    }
+    CoUninitialize();
+    return 0;
+}
+
+static HRESULT start_sub( struct event_sub *sub )
+{
+    HRESULT hr;
+
+    /* what is there now makes no events */
+    if ((hr = take_snapshot( sub, &sub->snap )) != S_OK) return hr;
+    if (!(sub->stop = CreateEventW( NULL, TRUE, FALSE, NULL ))) return E_OUTOFMEMORY;
+    if (!(sub->thread = CreateThread( NULL, 0, poll_thread, sub, 0, NULL ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+void stop_event_sub( struct event_sub *sub, BOOL cancelled )
+{
+    SetEvent( sub->stop );
+    WaitForSingleObject( sub->thread, INFINITE );
+    if (sub->sink && cancelled)
+        IWbemObjectSink_SetStatus( sub->sink, WBEM_STATUS_COMPLETE, WBEM_E_CALL_CANCELLED, NULL, NULL );
+    free_sub( sub );
+}
+
+/* an async event query: its events go to the sink until it is cancelled */
+HRESULT start_event_query_async( enum wbm_namespace ns, const WCHAR *query, IWbemObjectSink *sink,
+                                 struct event_sub **ret )
+{
+    struct event_sub *sub;
+    HRESULT hr;
+
+    if ((hr = parse_event_query( ns, query, &sub )) != S_OK) return hr;
+    IWbemObjectSink_AddRef( (sub->sink = sink) );
+    if ((hr = start_sub( sub )) != S_OK)
+    {
+        if (sub->stop && sub->thread) stop_event_sub( sub, FALSE );
+        else free_sub( sub );
+        return hr;
+    }
+    *ret = sub;
+    return S_OK;
+}
+
+/* the same object, whichever of its interfaces CancelAsyncCall was given */
+BOOL event_sub_has_sink( const struct event_sub *sub, IWbemObjectSink *sink )
+{
+    IUnknown *a, *b;
+    BOOL ret;
+
+    if (!sub->sink) return FALSE;
+    if (sub->sink == sink) return TRUE;
+    if (FAILED(IWbemObjectSink_QueryInterface( sub->sink, &IID_IUnknown, (void **)&a ))) return FALSE;
+    if (FAILED(IWbemObjectSink_QueryInterface( sink, &IID_IUnknown, (void **)&b )))
+    {
+        IUnknown_Release( a );
+        return FALSE;
+    }
+    ret = a == b;
+    IUnknown_Release( a );
+    IUnknown_Release( b );
+    return ret;
+}
+
+struct list *event_sub_entry( struct event_sub *sub )
+{
+    return &sub->entry;
+}
+
+struct event_sub *event_sub_from_entry( struct list *entry )
+{
+    return LIST_ENTRY( entry, struct event_sub, entry );
+}
+
+/*
+ * The semisynchronous enumerator
+ */
+static inline struct event_queue *impl_from_IEnumWbemClassObject( IEnumWbemClassObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct event_queue, IEnumWbemClassObject_iface );
+}
+
+static ULONG WINAPI event_queue_AddRef( IEnumWbemClassObject *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumWbemClassObject( iface )->refs );
+}
+
+static ULONG WINAPI event_queue_Release( IEnumWbemClassObject *iface )
+{
+    struct event_queue *q = impl_from_IEnumWbemClassObject( iface );
+    LONG refs = InterlockedDecrement( &q->refs );
+    UINT i;
+
+    if (!refs)
+    {
+        if (q->sub) stop_event_sub( q->sub, FALSE );
+        for (i = 0; i < q->count; i++) IWbemClassObject_Release( q->events[i] );
+        free( q->events );
+        CloseHandle( q->ready );
+        q->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &q->cs );
+        free( q );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI event_queue_QueryInterface( IEnumWbemClassObject *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumWbemClassObject ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumWbemClassObject_AddRef( iface );
+        return S_OK;
+    }
+    if (IsEqualGUID( riid, &IID_IClientSecurity ))
+    {
+        /* callers set a blanket on it, as on any WMI proxy; nothing to do in the process */
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI event_queue_Reset( IEnumWbemClassObject *iface )
+{
+    return WBEM_E_INVALID_OPERATION;
+}
+
+static HRESULT WINAPI event_queue_Next( IEnumWbemClassObject *iface, LONG timeout, ULONG count,
+                                        IWbemClassObject **objs, ULONG *returned )
+{
+    struct event_queue *q = impl_from_IEnumWbemClassObject( iface );
+    ULONGLONG deadline = timeout < 0 ? ~0ull : GetTickCount64() + timeout;
+    ULONG got = 0;
+
+    TRACE( "%p, %ld, %lu, %p, %p\n", iface, timeout, count, objs, returned );
+
+    if (!objs || !returned) return WBEM_E_INVALID_PARAMETER;
+    *returned = 0;
+    if (!count) return WBEM_S_NO_ERROR;
+    for (;;)
+    {
+        ULONGLONG now;
+        DWORD wait;
+
+        EnterCriticalSection( &q->cs );
+        while (got < count && q->count)
+        {
+            objs[got++] = q->events[0];
+            memmove( q->events, q->events + 1, --q->count * sizeof(*q->events) );
+        }
+        if (!q->count) ResetEvent( q->ready );
+        LeaveCriticalSection( &q->cs );
+        if (got == count) break;
+        now = GetTickCount64();
+        if (now >= deadline) break;
+        wait = deadline == ~0ull ? INFINITE : (DWORD)min( deadline - now, 0xfffffffe );
+        if (WaitForSingleObject( q->ready, wait ) == WAIT_TIMEOUT) break;
+    }
+    *returned = got;
+    return got == count ? WBEM_S_NO_ERROR : WBEM_S_TIMEDOUT;
+}
+
+static HRESULT WINAPI event_queue_NextAsync( IEnumWbemClassObject *iface, ULONG count, IWbemObjectSink *sink )
+{
+    FIXME( "%p, %lu, %p\n", iface, count, sink );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI event_queue_Clone( IEnumWbemClassObject *iface, IEnumWbemClassObject **ret )
+{
+    if (ret) *ret = NULL;
+    return WBEM_E_INVALID_OPERATION;
+}
+
+static HRESULT WINAPI event_queue_Skip( IEnumWbemClassObject *iface, LONG timeout, ULONG count )
+{
+    IWbemClassObject *obj;
+    ULONG got, i;
+    HRESULT hr = WBEM_S_NO_ERROR;
+
+    for (i = 0; i < count && hr == WBEM_S_NO_ERROR; i++)
+    {
+        hr = event_queue_Next( iface, timeout, 1, &obj, &got );
+        if (got) IWbemClassObject_Release( obj );
+    }
+    return hr;
+}
+
+static const IEnumWbemClassObjectVtbl event_queue_vtbl =
+{
+    event_queue_QueryInterface,
+    event_queue_AddRef,
+    event_queue_Release,
+    event_queue_Reset,
+    event_queue_Next,
+    event_queue_NextAsync,
+    event_queue_Clone,
+    event_queue_Skip
+};
+
+/* a semisynchronous event query: its events wait in the enumerator for Next */
+HRESULT start_event_query( enum wbm_namespace ns, const WCHAR *query, IEnumWbemClassObject **ret )
+{
+    struct event_queue *q;
+    struct event_sub *sub;
+    HRESULT hr;
+
+    if ((hr = parse_event_query( ns, query, &sub )) != S_OK) return hr;
+    if (!(q = calloc( 1, sizeof(*q) )) || !(q->ready = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        free( q );
+        free_sub( sub );
+        return E_OUTOFMEMORY;
+    }
+    q->IEnumWbemClassObject_iface.lpVtbl = &event_queue_vtbl;
+    q->refs = 1;
+    InitializeCriticalSectionEx( &q->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    q->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": event_queue.cs");
+    sub->queue = q;
+    if ((hr = start_sub( sub )) != S_OK)
+    {
+        if (sub->stop && sub->thread) stop_event_sub( sub, FALSE );
+        else free_sub( sub );
+        IEnumWbemClassObject_Release( &q->IEnumWbemClassObject_iface );
+        return hr;
+    }
+    q->sub = sub;
+    *ret = &q->IEnumWbemClassObject_iface;
+    return S_OK;
+}
