+
+    if (!ret) return WBEM_E_INVALID_PARAMETER;
+    if (!(copy = dobj_new())) return E_OUTOFMEMORY;
+    for (i = 0; i < obj->count; i++)
+        dobj_set( copy, obj->props[i].name, &obj->props[i].value, obj->props[i].type, obj->props[i].flavor );
+    *ret = &copy->IWbemClassObject_iface;
