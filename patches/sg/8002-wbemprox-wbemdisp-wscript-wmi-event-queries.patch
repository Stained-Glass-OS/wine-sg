+static HRESULT WINAPI dobj_GetNames( IWbemClassObject *iface, LPCWSTR qualifier, LONG flags, VARIANT *qualifier_value,
+                                     SAFEARRAY **names )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+    SAFEARRAY *sa;
+    LONG n = 0;
+    UINT i;
+
+    if (!names) return WBEM_E_INVALID_PARAMETER;
+    for (i = 0; i < obj->count; i++) if (dprop_wanted( &obj->props[i], flags )) n++;
+    if (!(sa = SafeArrayCreateVector( VT_BSTR, 0, n ))) return E_OUTOFMEMORY;
+    for (i = 0, n = 0; i < obj->count; i++)
+    {
+        if (!dprop_wanted( &obj->props[i], flags )) continue;
+        SafeArrayPutElement( sa, &n, obj->props[i].name );
+        n++;
+    }
+    *names = sa;
+    return WBEM_S_NO_ERROR;
+}
