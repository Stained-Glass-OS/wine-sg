+static HRESULT WINAPI dobj_GetObjectText( IWbemClassObject *iface, LONG flags, BSTR *text )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+    struct dprop *class = dobj_find( obj, L"__CLASS" );
+    WCHAR *buf, *grown;
+    size_t len;
+    UINT i;
+
+    if (!text) return WBEM_E_INVALID_PARAMETER;
+    len = 64 + (class && V_VT( &class->value ) == VT_BSTR ? wcslen( V_BSTR( &class->value ) ) : 0);
+    if (!(buf = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    swprintf( buf, len, L"\ninstance of %s\n{\n",
+              class && V_VT( &class->value ) == VT_BSTR ? V_BSTR( &class->value ) : L"" );
+    for (i = 0; i < obj->count; i++)
+    {
+        VARIANT v;
+        size_t n;
+
+        if (obj->props[i].name[0] == '_' || V_VT( &obj->props[i].value ) == VT_NULL) continue;
+        VariantInit( &v );
+        if (V_VT( &obj->props[i].value ) & VT_ARRAY || V_VT( &obj->props[i].value ) == VT_UNKNOWN ||
+            FAILED(VariantChangeType( &v, &obj->props[i].value, 0, VT_BSTR ))) continue;
+        n = wcslen( buf ) + wcslen( obj->props[i].name ) + wcslen( V_BSTR( &v ) ) + 16;
+        if ((grown = realloc( buf, n * sizeof(WCHAR) )))
+        {
+            buf = grown;
+            swprintf( buf + wcslen( buf ), n - wcslen( buf ), L"\t%s = \"%s\";\n", obj->props[i].name, V_BSTR( &v ) );
+        }
+        VariantClear( &v );
+    }
+    len = wcslen( buf ) + 4;
+    if ((grown = realloc( buf, len * sizeof(WCHAR) ))) { buf = grown; wcscat( buf, L"};\n" ); }
+    *text = SysAllocString( buf );
+    free( buf );
+    return *text ? WBEM_S_NO_ERROR : E_OUTOFMEMORY;
+}
