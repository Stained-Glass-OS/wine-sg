+
+static HRESULT WINAPI dobj_InheritsFrom( IWbemClassObject *iface, LPCWSTR ancestor )
+{
+    struct dobj *obj = impl_from_dobj( iface );
+    struct dprop *prop = dobj_find( obj, L"__DERIVATION" );
+    LONG i, lo, hi;
+
+    if (!ancestor) return WBEM_E_INVALID_PARAMETER;
+    if (!prop || V_VT( &prop->value ) != (VT_ARRAY | VT_BSTR)) return WBEM_S_FALSE;
+    SafeArrayGetLBound( V_ARRAY( &prop->value ), 1, &lo );
+    SafeArrayGetUBound( V_ARRAY( &prop->value ), 1, &hi );
+    for (i = lo; i <= hi; i++)
+    {
+        BSTR name;
+        BOOL match;
+        if (FAILED(SafeArrayGetElement( V_ARRAY( &prop->value ), &i, &name ))) continue;
+        match = !wcsicmp( name, ancestor );
+        SysFreeString( name );
+        if (match) return WBEM_S_NO_ERROR;
+    }
+    return WBEM_S_FALSE;
+}
