+/* Stained Glass OS: an enumerator over a fixed list of interface pointers or connections */
+struct cp_enum
+{
+    union { IEnumConnectionPoints points; IEnumConnections connections; } iface;
+    LONG refs;
+    BOOL connections;               /* the items are CONNECTDATA */
+    CONNECTDATA *items;             /* pUnk only for connection points */
+    ULONG count, pos;
+};
+
+static struct cp_enum *impl_from_cp_enum( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct cp_enum, iface );
+}
+
+static HRESULT cp_enum_create( BOOL connections, CONNECTDATA *items, ULONG count, ULONG pos, void **ret );
+
+static HRESULT WINAPI cp_enum_QueryInterface( IEnumConnections *iface, REFIID riid, void **obj )
+{
+    struct cp_enum *e = impl_from_cp_enum( iface );
+
+    if (IsEqualGUID( riid, &IID_IUnknown ) ||
+        IsEqualGUID( riid, e->connections ? &IID_IEnumConnections : &IID_IEnumConnectionPoints ))
+    {
+        *obj = iface;
+        InterlockedIncrement( &e->refs );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cp_enum_AddRef( IEnumConnections *iface )
+{
+    return InterlockedIncrement( &impl_from_cp_enum( iface )->refs );
+}
+
+static ULONG WINAPI cp_enum_Release( IEnumConnections *iface )
+{
+    struct cp_enum *e = impl_from_cp_enum( iface );
+    LONG refs = InterlockedDecrement( &e->refs );
+    ULONG i;
+
+    if (!refs)
+    {
+        for (i = 0; i < e->count; i++) IUnknown_Release( e->items[i].pUnk );
+        free( e->items );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI cp_enum_Next( IEnumConnections *iface, ULONG count, CONNECTDATA *out, ULONG *fetched )
+{
+    struct cp_enum *e = impl_from_cp_enum( iface );
+    ULONG got = 0;
+
+    if (!out || (count > 1 && !fetched)) return E_POINTER;
+    while (got < count && e->pos < e->count)
+    {
+        IUnknown *unk = e->items[e->pos].pUnk;
+        IUnknown_AddRef( unk );
+        if (e->connections) out[got] = e->items[e->pos];
+        else ((IConnectionPoint **)out)[got] = (IConnectionPoint *)unk;
+        got++;
+        e->pos++;
+    }
+    if (fetched) *fetched = got;
+    return got == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI cp_enum_Skip( IEnumConnections *iface, ULONG count )
+{
+    struct cp_enum *e = impl_from_cp_enum( iface );
+    ULONG left = e->count - e->pos;
+
+    e->pos += min( count, left );
+    return count <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI cp_enum_Reset( IEnumConnections *iface )
+{
+    impl_from_cp_enum( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI cp_enum_Clone( IEnumConnections *iface, IEnumConnections **ret )
+{
+    struct cp_enum *e = impl_from_cp_enum( iface );
+
+    if (!ret) return E_POINTER;
+    return cp_enum_create( e->connections, e->items, e->count, e->pos, (void **)ret );
+}
+
+static const IEnumConnectionsVtbl cp_enum_connections_vtbl =
+{
+    cp_enum_QueryInterface, cp_enum_AddRef, cp_enum_Release, cp_enum_Next, cp_enum_Skip, cp_enum_Reset, cp_enum_Clone
+};
+
+/* IEnumConnectionPoints has the same layout with IConnectionPoint * items */
+static const IEnumConnectionPointsVtbl cp_enum_points_vtbl =
+{
+    (void *)cp_enum_QueryInterface, (void *)cp_enum_AddRef, (void *)cp_enum_Release, (void *)cp_enum_Next,
+    (void *)cp_enum_Skip, (void *)cp_enum_Reset, (void *)cp_enum_Clone
+};
+
+static HRESULT cp_enum_create( BOOL connections, CONNECTDATA *items, ULONG count, ULONG pos, void **ret )
+{
+    struct cp_enum *e;
+    ULONG i;
+
+    *ret = NULL;
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    if (count && !(e->items = malloc( count * sizeof(*items) )))
+    {
+        free( e );
+        return E_OUTOFMEMORY;
+    }
+    if (connections) e->iface.connections.lpVtbl = &cp_enum_connections_vtbl;
+    else e->iface.points.lpVtbl = &cp_enum_points_vtbl;
+    e->refs = 1;
+    e->connections = connections;
+    for (i = 0; i < count; i++)
+    {
+        e->items[i] = items[i];
+        IUnknown_AddRef( e->items[i].pUnk );
+    }
+    e->count = count;
+    e->pos = pos;
+    *ret = &e->iface;
+    return S_OK;
+}
+
 static HRESULT WINAPI sink_cpc_EnumConnectionPoints( IConnectionPointContainer *iface, IEnumConnectionPoints **enum_points )
 {
-    FIXME( "%p\n", enum_points );
