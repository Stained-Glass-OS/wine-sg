--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -908,8 +908,31 @@ static HRESULT WINAPI Host_Sleep(IHost *iface, LONG Time)
     TRACE("(%ld)\n", Time);
     if (Time < 0)
         return E_INVALIDARG;
+#ifdef SG_MUTANT_WSH_SLEEP_NO_PUMP
     Sleep(Time);
     return S_OK;
+#endif
+    /* Stained Glass OS: the script's thread keeps taking its messages while it
+     * sleeps, as on Windows, so events of objects it connected to (an async WMI
+     * query's sink) reach their handlers during WScript.Sleep */
+    {
+        ULONGLONG end = GetTickCount64() + Time;
+        MSG msg;
+
+        for (;;)
+        {
+            ULONGLONG now = GetTickCount64();
+            if (now >= end) break;
+            if (MsgWaitForMultipleObjects(0, NULL, FALSE, (DWORD)min(end - now, 0xfffffffe), QS_ALLINPUT) == WAIT_TIMEOUT)
+                break;
+            while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE))
+            {
+                TranslateMessage(&msg);
+                DispatchMessageW(&msg);
+            }
+        }
+    }
+    return S_OK;
 }
 
