+{
+    return class_name( class_factory_from( iface )->name, name );
+}
+
+static HRESULT WINAPI class_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI class_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    FIXME( "%s: no default constructor.\n", debugstr_w( class_factory_from( iface )->name ) );
