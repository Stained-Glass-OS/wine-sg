+/* The accounts MSAL has signed in, for FindAllAccountsAsync. */
+HRESULT broker_accounts( IWebAccountProvider *provider, IInspectable **result )
+{
+    IWebAccountProvider2 *provider2;
+    HSTRING authority = NULL;
+    struct sbuf sb = { 0 };
+    struct json *answer;
+    const struct json *list;
+    IWebAccount **accounts = NULL;
+    UINT32 count = 0;
+    HRESULT hr;
+    int i;
+
+    if (SUCCEEDED(IWebAccountProvider_QueryInterface( provider, &IID_IWebAccountProvider2, (void **)&provider2 )))
+    {
+        IWebAccountProvider2_get_Authority( provider2, &authority );
+        IWebAccountProvider2_Release( provider2 );
+    }
+    sb_str( &sb, "{\"mode\":\"accounts\"" );
+    sb_authority( &sb, WindowsGetStringRawBuffer( authority, NULL ) );
+    sb_field_w( &sb, "client_id", DEFAULT_CLIENT );
+    sb_str( &sb, ",\"scopes\":[]}" );
+    WindowsDeleteString( authority );
+    answer = sb.data ? run_helper( sb.data, SILENT_TIMEOUT ) : NULL;
+    free( sb.data );
+
+    list = json_get( json_get( answer, "result" ), "accounts" );
+    if (list && list->type == J_ARR && list->count && (accounts = calloc( list->count, sizeof(*accounts) )))
+    {
+        for (i = 0; i < list->count; i++)
+        {
+            WCHAR *wid = from_utf8( json_str( list->items[i], "home_account_id" ) );
+            WCHAR *wname = from_utf8( json_str( list->items[i], "username" ) );
+            HSTRING id = NULL, name = NULL;
+
+            if (wid && wname)
+            {
+                WindowsCreateString( wid, wcslen( wid ), &id );
+                WindowsCreateString( wname, wcslen( wname ), &name );
+                if (SUCCEEDED(account_create( provider, id, name, WebAccountState_Connected, &accounts[count] ))) count++;
+                WindowsDeleteString( id );
+                WindowsDeleteString( name );
+            }
+            free( wid );
+            free( wname );
+        }
+    }
+    hr = find_all_result_create( FindAllWebAccountsStatus_Success, NULL, accounts, count, result );
+    for (i = 0; i < count; i++) IWebAccount_Release( accounts[i] );
+    free( accounts );
+    json_free( answer );
+    return hr;
+}
