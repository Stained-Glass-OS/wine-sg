+/*
+ * Signing in is Microsoft's own: the token requests of an app are handed to
+ * sg-wam-msal (sg-session), a small native program that asks Microsoft's MSAL
+ * library for the token. MSAL shows the real sign-in page in the person's
+ * browser and keeps the token cache; this file never sees a password. What
+ * lives here is only the translation between the Web Account Manager's objects
+ * and the program's JSON.
+ *
+ * The program is /usr/bin/sg-wam-msal, or the native program SG_WAM_HELPER
+ * names (an absolute Unix path; for tests).
+ */
+
+#include "private.h"
+
+#include <ctype.h>
+#include <time.h>
+
+#include "wine/debug.h"
+#include "wine/sgnetctl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(webauth);
+
+#define RESULT_MARKER "SGWAM-RESULT:"
+#define DEFAULT_CLIENT L"d3590ed6-52b3-4102-aeff-aad2292ab01c"
+#define SILENT_TIMEOUT 60000
+#define INTERACTIVE_TIMEOUT (15 * 60 * 1000)
+
+/*
+ * JSON: just enough to read the program's answer
+ */
+
+enum json_type { J_NULL, J_BOOL, J_NUM, J_STR, J_ARR, J_OBJ };
+
+struct json
+{
+    enum json_type type;
+    char *str;
+    double num;
+    int boolean;
+    struct json **items;   /* array elements, object values */
+    char **keys;           /* object keys */
+    int count;
+};
+
+static void json_free( struct json *j )
+{
+    int i;
+
+    if (!j) return;
+    for (i = 0; i < j->count; i++)
+    {
+        json_free( j->items[i] );
+        if (j->keys) free( j->keys[i] );
+    }
+    free( j->items );
+    free( j->keys );
+    free( j->str );
+    free( j );
+}
+
+static void json_skip( const char **p )
+{
+    while (**p == ' ' || **p == '\t' || **p == '\r' || **p == '\n') (*p)++;
+}
+
+static void put_utf8( char **out, unsigned int c )
+{
+    char *o = *out;
+    if (c < 0x80) *o++ = c;
+    else if (c < 0x800) { *o++ = 0xc0 | (c >> 6); *o++ = 0x80 | (c & 0x3f); }
+    else if (c < 0x10000) { *o++ = 0xe0 | (c >> 12); *o++ = 0x80 | ((c >> 6) & 0x3f); *o++ = 0x80 | (c & 0x3f); }
+    else { *o++ = 0xf0 | (c >> 18); *o++ = 0x80 | ((c >> 12) & 0x3f); *o++ = 0x80 | ((c >> 6) & 0x3f); *o++ = 0x80 | (c & 0x3f); }
+    *out = o;
+}
+
+static unsigned int hex4( const char *p )
+{
+    unsigned int v = 0;
+    int i;
+    for (i = 0; i < 4; i++)
+    {
+        char c = p[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9') v |= c - '0';
+        else if (c >= 'a' && c <= 'f') v |= c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F') v |= c - 'A' + 10;
+        else return 0xffffffff;
+    }
+    return v;
+}
+
+/* a string at *p (after the opening quote); NULL on a syntax error */
+static char *json_string( const char **p )
+{
+    const char *s = *p;
+    char *buf, *o;
+
+    if (!(o = buf = malloc( strlen( s ) + 1 ))) return NULL;
+    while (*s && *s != '"')
+    {
+        if (*s != '\\') { *o++ = *s++; continue; }
+        s++;
+        switch (*s)
+        {
+        case 'n': *o++ = '\n'; s++; break;
+        case 't': *o++ = '\t'; s++; break;
+        case 'r': *o++ = '\r'; s++; break;
+        case 'b': *o++ = '\b'; s++; break;
+        case 'f': *o++ = '\f'; s++; break;
+        case 'u':
+        {
+            unsigned int c = hex4( s + 1 ), lo;
+            if (c == 0xffffffff) goto fail;
+            s += 5;
+            if (c >= 0xd800 && c < 0xdc00 && s[0] == '\\' && s[1] == 'u' && (lo = hex4( s + 2 )) != 0xffffffff)
+            {
+                c = 0x10000 + ((c - 0xd800) << 10) + (lo - 0xdc00);
+                s += 6;
+            }
+            put_utf8( &o, c );
+            break;
+        }
+        case 0: goto fail;
+        default: *o++ = *s++; break;   /* \" \\ \/ */
+        }
+    }
+    if (*s != '"') goto fail;
+    *o = 0;
+    *p = s + 1;
+    return buf;
+fail:
+    free( buf );
+    return NULL;
+}
+
+static struct json *json_parse_value( const char **p, int depth )
+{
+    struct json *j;
+
+    json_skip( p );
+    if (depth > 32 || !(j = calloc( 1, sizeof(*j) ))) return NULL;
+    if (**p == '"')
+    {
+        (*p)++;
+        j->type = J_STR;
+        if (!(j->str = json_string( p ))) goto fail;
+    }
+    else if (**p == '{' || **p == '[')
+    {
+        char close = **p == '{' ? '}' : ']';
+        int obj = **p == '{';
+
+        j->type = obj ? J_OBJ : J_ARR;
+        (*p)++;
+        json_skip( p );
+        if (**p == close) { (*p)++; return j; }
+        for (;;)
+        {
+            struct json *item;
+            char *key = NULL;
+            void *tmp;
+
+            json_skip( p );
+            if (obj)
+            {
+                if (**p != '"') goto fail;
+                (*p)++;
+                if (!(key = json_string( p ))) goto fail;
+                json_skip( p );
+                if (*(*p)++ != ':') { free( key ); goto fail; }
+            }
+            if (!(item = json_parse_value( p, depth + 1 ))) { free( key ); goto fail; }
+            if (!(tmp = realloc( j->items, (j->count + 1) * sizeof(*j->items) ))) { free( key ); json_free( item ); goto fail; }
+            j->items = tmp;
+            if (obj)
+            {
+                if (!(tmp = realloc( j->keys, (j->count + 1) * sizeof(*j->keys) ))) { free( key ); json_free( item ); goto fail; }
+                j->keys = tmp;
+                j->keys[j->count] = key;
+            }
+            j->items[j->count++] = item;
+            json_skip( p );
+            if (**p == ',') { (*p)++; continue; }
+            if (**p == close) { (*p)++; break; }
+            goto fail;
+        }
+    }
+    else if (!strncmp( *p, "true", 4 )) { j->type = J_BOOL; j->boolean = 1; *p += 4; }
+    else if (!strncmp( *p, "false", 5 )) { j->type = J_BOOL; *p += 5; }
+    else if (!strncmp( *p, "null", 4 )) { j->type = J_NULL; *p += 4; }
+    else if (**p == '-' || (**p >= '0' && **p <= '9'))
+    {
+        char *end;
+        j->type = J_NUM;
+        j->num = strtod( *p, &end );
+        if (end == *p) goto fail;
+        *p = end;
+    }
+    else goto fail;
+    return j;
+fail:
+    json_free( j );
+    return NULL;
+}
+
+static const struct json *json_get( const struct json *o, const char *key )
+{
+    int i;
+
+    if (!o || o->type != J_OBJ) return NULL;
+    for (i = 0; i < o->count; i++) if (!strcmp( o->keys[i], key )) return o->items[i];
+    return NULL;
+}
+
+static const char *json_str( const struct json *o, const char *key )
+{
+    const struct json *j = json_get( o, key );
+    return j && j->type == J_STR ? j->str : NULL;
+}
+
+/*
+ * Building the request: a growing UTF-8 string
+ */
+
+struct sbuf { char *data; size_t len, cap; };
+
+static void sb_add( struct sbuf *sb, const char *text, size_t n )
+{
+    if (sb->len + n + 1 > sb->cap)
+    {
+        size_t cap = max( sb->cap * 2, sb->len + n + 256 );
+        char *p = realloc( sb->data, cap );
+        if (!p) return;
+        sb->data = p;
+        sb->cap = cap;
+    }
+    if (!sb->data) return;
+    memcpy( sb->data + sb->len, text, n );
+    sb->len += n;
+    sb->data[sb->len] = 0;
+}
+
+static void sb_str( struct sbuf *sb, const char *text )
+{
+    sb_add( sb, text, strlen( text ) );
+}
+
+/* a JSON string literal of the UTF-8 text */
+static void sb_json( struct sbuf *sb, const char *text )
+{
+    sb_add( sb, "\"", 1 );
+    for (; *text; text++)
+    {
+        unsigned char c = *text;
+        char esc[8];
+
+        if (c == '"' || c == '\\') { esc[0] = '\\'; esc[1] = c; sb_add( sb, esc, 2 ); }
+        else if (c < 0x20) { sprintf( esc, "\\u%04x", c ); sb_add( sb, esc, 6 ); }
+        else sb_add( sb, text, 1 );
+    }
+    sb_add( sb, "\"", 1 );
+}
+
+static char *to_utf8( const WCHAR *str )
+{
+    int len;
+    char *out;
+
+    if (!str) str = L"";
+    len = WideCharToMultiByte( CP_UTF8, 0, str, -1, NULL, 0, NULL, NULL );
+    if (!(out = malloc( len ))) return NULL;
+    WideCharToMultiByte( CP_UTF8, 0, str, -1, out, len, NULL, NULL );
+    return out;
+}
+
+static WCHAR *from_utf8( const char *str )
+{
+    int len;
+    WCHAR *out;
+
+    if (!str) str = "";
+    len = MultiByteToWideChar( CP_UTF8, 0, str, -1, NULL, 0 );
+    if (!(out = malloc( len * sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( CP_UTF8, 0, str, -1, out, len );
+    return out;
+}
+
+static void sb_field_w( struct sbuf *sb, const char *name, const WCHAR *value )
+{
+    char *u = to_utf8( value );
+
+    sb_str( sb, ",\"" );
+    sb_str( sb, name );
+    sb_str( sb, "\":" );
+    sb_json( sb, u ? u : "" );
+    free( u );
+}
+
+/* the authority a request names: a bare tenant ("organizations", a GUID, a domain) is on the public cloud */
+static void sb_authority( struct sbuf *sb, const WCHAR *authority )
+{
+    char *u = to_utf8( authority && authority[0] ? authority : L"organizations" );
+    struct sbuf url = { 0 };
+
+    if (!strncmp( u, "https://", 8 )) sb_str( &url, u );
+    else
+    {
+        sb_str( &url, "https://login.microsoftonline.com/" );
+        sb_str( &url, u );
+    }
+    sb_str( sb, ",\"authority\":" );
+    sb_json( sb, url.data ? url.data : "" );
+    free( url.data );
+    free( u );
+}
+
+/* scopes are separated by spaces; the token request's scope is one string */
+static void sb_scopes( struct sbuf *sb, const WCHAR *scope )
+{
+    char *u = to_utf8( scope ), *p, *save = NULL;
+    int first = 1;
+
+    sb_str( sb, ",\"scopes\":[" );
+    for (p = u ? strtok_s( u, " ", &save ) : NULL; p; p = strtok_s( NULL, " ", &save ))
+    {
+        if (!first) sb_str( sb, "," );
+        first = 0;
+        sb_json( sb, p );
+    }
+    sb_str( sb, "]" );
+    free( u );
+}
+
+/*
+ * Running the program
+ */
+
+static const WCHAR *helper_path(void)
+{
+    static WCHAR path[MAX_PATH];
+    WCHAR unix_path[MAX_PATH - 8];
+
+    if (!path[0])
+    {
+        if (GetEnvironmentVariableW( L"SG_WAM_HELPER", unix_path, ARRAY_SIZE(unix_path) ) && unix_path[0] == '/')
+        {
+            WCHAR *p;
+            swprintf( path, ARRAY_SIZE(path), L"\\\\?\\unix%ls", unix_path );
+            for (p = path + 8; *p; p++) if (*p == '/') *p = '\\';
+        }
+        else wcscpy( path, L"\\\\?\\unix\\usr\\bin\\sg-wam-msal" );
+    }
+    return path;
+}
+
+/* ask the program; the parsed {"ok":..} answer, or NULL when it did not answer */
+static struct json *run_helper( const char *request, DWORD timeout )
+{
+    char *text, *mark;
+    DWORD code;
+    struct json *answer = NULL;
+    const char *p;
+
+    if (!sgnet_run_native_input( helper_path(), NULL, 0, request, &text, &code, timeout ))
+    {
+        WARN( "the program %s did not answer.\n", debugstr_w( helper_path() ) );
+        return NULL;
+    }
+    if ((mark = strstr( text, RESULT_MARKER )))
+    {
+        p = mark + strlen( RESULT_MARKER );
+        answer = json_parse_value( &p, 0 );
+    }
+    if (!answer) WARN( "no result (exit %lu): %.200s\n", code, text );
+    free( text );
+    return answer;
+}
+
+/*
+ * The answer as the Web Account Manager's objects
+ */
+
+static void response_property( IWebTokenResponse *response, const char *name, const char *value )
+{
+    IMap_HSTRING_HSTRING *props = token_response_properties( response );
+    HSTRING k, v;
+    WCHAR *wname = from_utf8( name ), *wvalue = from_utf8( value );
+    boolean replaced;
+
+    if (wname && wvalue && props &&
+        SUCCEEDED(WindowsCreateString( wname, wcslen( wname ), &k )))
+    {
+        if (SUCCEEDED(WindowsCreateString( wvalue, wcslen( wvalue ), &v )))
+        {
+            IMap_HSTRING_HSTRING_Insert( props, k, v, &replaced );
+            WindowsDeleteString( v );
+        }
+        WindowsDeleteString( k );
+    }
+    free( wname );
+    free( wvalue );
+}
+
+static HRESULT make_result( WebTokenRequestStatus status, const WCHAR *message, UINT32 code, IInspectable **result )
+{
+    IWebProviderError *error = NULL;
+    HRESULT hr;
+
+    if (status != WebTokenRequestStatus_Success)
+    {
+        if (FAILED(hr = provider_error_create_w( code, message, &error ))) return hr;
+    }
+    hr = token_result_create( status, error, NULL, result );
+    if (error) IWebProviderError_Release( error );
+    return hr;
+}
+
+static HRESULT success_result( IWebAccountProvider *provider, const struct json *res, IInspectable **result )
+{
+    const char *token = json_str( res, "access_token" );
+    const struct json *acc = json_get( res, "account" ), *expires = json_get( res, "expires_in" );
+    IWebAccount *account = NULL;
+    IWebTokenResponse *response;
+    HSTRING id = NULL, name = NULL, tok = NULL;
+    WCHAR *wid, *wname, *wtoken;
+    char buf[32];
+    HRESULT hr;
+
+    wtoken = from_utf8( token );
+    wid = from_utf8( json_str( acc, "home_account_id" ) );
+    wname = from_utf8( json_str( acc, "username" ) );
+    if (!wtoken || !wid || !wname) { free( wtoken ); free( wid ); free( wname ); return E_OUTOFMEMORY; }
+
+    if (acc && acc->type == J_OBJ)
+    {
+        WindowsCreateString( wid, wcslen( wid ), &id );
+        WindowsCreateString( wname, wcslen( wname ), &name );
+        hr = account_create( provider, id, name, WebAccountState_Connected, &account );
+        WindowsDeleteString( id );
+        WindowsDeleteString( name );
+        if (FAILED(hr)) goto done;
+    }
+    WindowsCreateString( wtoken, wcslen( wtoken ), &tok );
+    hr = token_response_create( tok, account, NULL, &response );
+    WindowsDeleteString( tok );
+    if (FAILED(hr)) goto done;
+
+    if (json_str( res, "id_token" )) response_property( response, "id_token", json_str( res, "id_token" ) );
+    if (json_str( res, "token_type" )) response_property( response, "token_type", json_str( res, "token_type" ) );
+    if (json_str( res, "scope" )) response_property( response, "scope", json_str( res, "scope" ) );
+    if (json_str( res, "refresh_token" )) response_property( response, "refresh_token", json_str( res, "refresh_token" ) );
+    /* the names the Windows broker's own answers use, which MSAL-based clients (Office) read */
+#ifndef SG_MUTANT_WAM_NO_WAMCOMPAT
+    if (json_str( res, "id_token" )) response_property( response, "wamcompat_id_token", json_str( res, "id_token" ) );
+    if (json_str( res, "client_info" )) response_property( response, "wamcompat_client_info", json_str( res, "client_info" ) );
+    if (json_str( res, "scope" )) response_property( response, "wamcompat_scopes", json_str( res, "scope" ) );
+#endif
+    if (expires && expires->type == J_NUM)
+    {
+        sprintf( buf, "%lld", (long long)expires->num );
+        response_property( response, "expires_in", buf );
+        sprintf( buf, "%lld", (long long)time( NULL ) + (long long)expires->num );
+        response_property( response, "expires_on", buf );
+        /* TokenExpiresOn: seconds since 1601 (the library checks > 11644473600, subtracts it and scales by 1e7) */
+        sprintf( buf, "%lld", (long long)time( NULL ) + (long long)expires->num + 11644473600LL );
+#ifndef SG_MUTANT_WAM_NO_EXPIRES_ON
+        response_property( response, "TokenExpiresOn", buf );
+#endif
+    }
+    hr = token_result_create( WebTokenRequestStatus_Success, NULL, response, result );
+    IWebTokenResponse_Release( response );
+done:
+    if (account) IWebAccount_Release( account );
+    free( wtoken );
+    free( wid );
+    free( wname );
+    return hr;
+}
+
+/* "cancelled", "Canceled" and "cancel" all say the person closed the sign-in page */
+static BOOL contains_nocase( const char *text, const char *word )
+{
+    size_t i, n = strlen( word );
+
+    for (; *text; text++)
+    {
+        for (i = 0; i < n && text[i] && tolower( (unsigned char)text[i] ) == word[i]; i++) ;
+        if (i == n) return TRUE;
+    }
+    return FALSE;
+}
+
+/* One token request, answered by the program. mode: "silent" or "interactive". */
+HRESULT broker_token( const char *mode, IInspectable *request, IInspectable *account, IInspectable **result )
+{
+    IWebAccountProvider *provider = NULL;
+    IMap_HSTRING_HSTRING *props = NULL, *app_props = NULL;
+    HSTRING scope = NULL, client_id = NULL, correlation = NULL, authority = NULL, hint = NULL, account_id = NULL;
+    WebTokenRequestPromptType prompt = 0;
+    struct sbuf sb = { 0 };
+    struct json *answer;
+    const struct json *res;
+    HRESULT hr;
+
+    if (!token_request_get( request, &provider, &scope, &client_id, &prompt, &props, &app_props, &correlation ))
+        return make_result( WebTokenRequestStatus_ProviderError, L"The request is not a web token request.", 0x80004001, result );
+
+    if (provider)
+    {
+        IWebAccountProvider2 *provider2;
+        if (SUCCEEDED(IWebAccountProvider_QueryInterface( provider, &IID_IWebAccountProvider2, (void **)&provider2 )))
+        {
+            IWebAccountProvider2_get_Authority( provider2, &authority );
+            IWebAccountProvider2_Release( provider2 );
+        }
+    }
+    string_map_get( props, L"LoginHint", &hint );
+    if (!hint || !WindowsGetStringLen( hint )) { WindowsDeleteString( hint ); string_map_get( props, L"login_hint", &hint ); }
+    if (!hint || !WindowsGetStringLen( hint )) { WindowsDeleteString( hint ); string_map_get( props, L"username", &hint ); }
+    if (account)
+    {
+        /* a request for a given web account is for that account's token */
+        IWebAccount *web_account;
+        IWebAccount2 *web_account2;
+
+        if (SUCCEEDED(IInspectable_QueryInterface( account, &IID_IWebAccount2, (void **)&web_account2 )))
+        {
+            IWebAccount2_get_Id( web_account2, &account_id );
+            IWebAccount2_Release( web_account2 );
+        }
+        if ((!hint || !WindowsGetStringLen( hint )) &&
+            SUCCEEDED(IInspectable_QueryInterface( account, &IID_IWebAccount, (void **)&web_account )))
+        {
+            WindowsDeleteString( hint );
+            hint = NULL;
+            IWebAccount_get_UserName( web_account, &hint );
+            IWebAccount_Release( web_account );
+        }
+    }
+
+    sb_str( &sb, "{\"mode\":" );
+    sb_json( &sb, mode );
+    sb_authority( &sb, WindowsGetStringRawBuffer( authority, NULL ) );
+    sb_field_w( &sb, "client_id", client_id && WindowsGetStringLen( client_id ) ?
+                WindowsGetStringRawBuffer( client_id, NULL ) : DEFAULT_CLIENT );
+    sb_scopes( &sb, WindowsGetStringRawBuffer( scope, NULL ) );
+    sb_field_w( &sb, "login_hint", WindowsGetStringRawBuffer( hint, NULL ) );
+    if (account_id && WindowsGetStringLen( account_id )) sb_field_w( &sb, "account_id", WindowsGetStringRawBuffer( account_id, NULL ) );
+    sb_str( &sb, prompt == WebTokenRequestPromptType_ForceAuthentication ? ",\"force_prompt\":true" : ",\"force_prompt\":false" );
+    sb_str( &sb, "}" );
+    TRACE( "%s\n", debugstr_a( sb.data ) );
+
+    answer = sb.data ? run_helper( sb.data, !strcmp( mode, "silent" ) ? SILENT_TIMEOUT : INTERACTIVE_TIMEOUT ) : NULL;
+    free( sb.data );
+    WindowsDeleteString( hint );
+    WindowsDeleteString( account_id );
+    WindowsDeleteString( authority );
+
+    if (!answer)
+        hr = make_result( WebTokenRequestStatus_ProviderError, L"The sign-in program did not answer.", 0x80004005, result );
+    else if ((res = json_get( answer, "result" )) && json_get( answer, "ok" ) && json_get( answer, "ok" )->boolean)
+        hr = success_result( provider, res, result );
+    else
+    {
+        const struct json *inter = json_get( answer, "interaction_required" );
+        const char *desc = json_str( answer, "error_description" );
+        WCHAR *wdesc = from_utf8( desc ? desc : json_str( answer, "error" ) );
+
+        WARN( "failed: %s: %s\n", debugstr_a( json_str( answer, "error" ) ), debugstr_a( desc ) );
+        if (inter && inter->boolean && !strcmp( mode, "silent" ))
+            hr = make_result( WebTokenRequestStatus_UserInteractionRequired, wdesc ? wdesc : L"", 0, result );
+        else if (!strcmp( json_str( answer, "error" ) ? json_str( answer, "error" ) : "", "access_denied" ) ||
+                 (desc && contains_nocase( desc, "cancel" )))
+            hr = make_result( WebTokenRequestStatus_UserCancel, wdesc ? wdesc : L"", 0, result );
+        else
+            hr = make_result( WebTokenRequestStatus_ProviderError, wdesc ? wdesc : L"", 0x80004005, result );
+        free( wdesc );
+    }
+    json_free( answer );
+    return hr;
+}
