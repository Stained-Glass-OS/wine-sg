+            FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", what, debugstr_guid( iid ) );
+            *out = NULL;
+            return E_NOINTERFACE;
+        }
+        *out = (char *)obj + e->offset;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
