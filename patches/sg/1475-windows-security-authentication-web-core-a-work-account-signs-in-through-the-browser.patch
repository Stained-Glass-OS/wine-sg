+static HRESULT WINAPI class_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct class_factory *impl = class_factory_from( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebTokenRequestFactory ) && impl->iid == &IID_IWebTokenRequestFactory)
+        *out = &impl->IWebTokenRequestFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebTokenResponseFactory ) && impl->iid == &IID_IWebTokenResponseFactory)
+        *out = &impl->IWebTokenResponseFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebProviderErrorFactory ) && impl->iid == &IID_IWebProviderErrorFactory)
+        *out = &impl->IWebProviderErrorFactory_iface;
+    else
+    {
+        FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( impl->name ), debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
