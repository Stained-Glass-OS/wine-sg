+    *iids = NULL;
+    if (!n) return S_OK;
+    if (!(*iids = CoTaskMemAlloc( n * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *table[i].iid;
+    *count = n;
+    return S_OK;
