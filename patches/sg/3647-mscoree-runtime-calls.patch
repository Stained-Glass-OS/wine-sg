+static BOOL set_install_root(const char *root, char *old, DWORD *old_size, BOOL *had_old)
+{
+    HKEY key;
+    LONG ret;
+
+    ret = RegCreateKeyExA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Microsoft\\.NETFramework", 0, NULL, 0,
+            KEY_READ | KEY_WRITE, NULL, &key, NULL);
+    if (ret) return FALSE;
+    *had_old = !RegQueryValueExA(key, "InstallRoot", NULL, NULL, (BYTE *)old, old_size);
+    ret = RegSetValueExA(key, "InstallRoot", 0, REG_SZ, (const BYTE *)root, strlen(root) + 1);
+    RegCloseKey(key);
+    return !ret;
+}
+
+static void restore_install_root(const char *old, DWORD old_size, BOOL had_old)
+{
+    HKEY key;
+
+    if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, "SOFTWARE\\Microsoft\\.NETFramework", 0, KEY_WRITE, &key)) return;
+    if (had_old) RegSetValueExA(key, "InstallRoot", 0, REG_SZ, (const BYTE *)old, old_size);
+    else RegDeleteValueA(key, "InstallRoot");
+    RegCloseKey(key);
+}
