+/* ---- runtimes in other processes ---- */
+
+static void child_load(const char *event_prefix, const char *dll_a, const char *dll_b)
+{
+    char name[100];
+    HANDLE loaded, quit;
+
+    if (dll_a[0]) ok(!!LoadLibraryA(dll_a), "Failed to load %s.\n", dll_a);
+    if (dll_b[0]) ok(!!LoadLibraryA(dll_b), "Failed to load %s.\n", dll_b);
+    sprintf(name, "%s_loaded", event_prefix);
+    loaded = OpenEventA(EVENT_MODIFY_STATE, FALSE, name);
+    sprintf(name, "%s_quit", event_prefix);
+    quit = OpenEventA(SYNCHRONIZE, FALSE, name);
+    ok(loaded && quit, "Failed to open the events.\n");
+    SetEvent(loaded);
+    WaitForSingleObject(quit, 30000);
+}
+
+static BOOL runtime_listed(IEnumUnknown *runtimes, const WCHAR *version)
+{
+    IUnknown *unk;
+    ULONG fetched;
+    BOOL found = FALSE;
+
+    IEnumUnknown_Reset(runtimes);
+    while (IEnumUnknown_Next(runtimes, 1, &unk, &fetched) == S_OK && fetched)
+    {
+        ICLRRuntimeInfo *info;
+        WCHAR v[32];
+        DWORD len = ARRAY_SIZE(v);
+
+        if (SUCCEEDED(IUnknown_QueryInterface(unk, &IID_ICLRRuntimeInfo, (void **)&info)))
+        {
+            if (SUCCEEDED(ICLRRuntimeInfo_GetVersionString(info, v, &len)) && !lstrcmpW(v, version)) found = TRUE;
+            ICLRRuntimeInfo_Release(info);
+        }
+        IUnknown_Release(unk);
+    }
+    return found;
+}
+
+static void run_child(const char *dll_a, const char *dll_b, BOOL expect_v4, BOOL expect_v2, BOOL expect_v1)
+{
+    char cmd[3 * MAX_PATH], prefix[64], name[100], **argv;
+    PROCESS_INFORMATION pi;
+    STARTUPINFOA si = { sizeof(si) };
+    HANDLE loaded, quit;
+    ICLRMetaHost *host;
+    ICLRRuntimeInfo *v4, *v2, *v1;
+    IEnumUnknown *runtimes;
+    BOOL ret, is_loaded;
+    HRESULT hr;
+
+    winetest_get_mainargs(&argv);
+    sprintf(prefix, "sgmscoree_%lu_%lu", GetCurrentProcessId(), GetTickCount());
+    sprintf(name, "%s_loaded", prefix);
+    loaded = CreateEventA(NULL, TRUE, FALSE, name);
+    sprintf(name, "%s_quit", prefix);
+    quit = CreateEventA(NULL, TRUE, FALSE, name);
+    sprintf(cmd, "\"%s\" sgcalls child_load %s \"%s\" \"%s\"", argv[0], prefix, dll_a, dll_b);
+    ret = CreateProcessA(NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi);
+    ok(ret, "CreateProcess failed %lu.\n", GetLastError());
+    if (!ret) goto done;
+    ok(WaitForSingleObject(loaded, 30000) == WAIT_OBJECT_0, "The child did not load its modules.\n");
+
+    hr = pCLRCreateInstance(&CLSID_CLRMetaHost, &IID_ICLRMetaHost, (void **)&host);
+    ok(hr == S_OK, "CLRCreateInstance failed, hr=%#lx.\n", hr);
+    ICLRMetaHost_GetRuntime(host, L"v4.0.30319", &IID_ICLRRuntimeInfo, (void **)&v4);
+    ICLRMetaHost_GetRuntime(host, L"v2.0.50727", &IID_ICLRRuntimeInfo, (void **)&v2);
+    ICLRMetaHost_GetRuntime(host, L"v1.1.4322", &IID_ICLRRuntimeInfo, (void **)&v1);
+
+    is_loaded = 0xdead;
+    hr = ICLRRuntimeInfo_IsLoaded(v4, pi.hProcess, &is_loaded);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(is_loaded == expect_v4, "v4 loaded: %d, expected %d.\n", is_loaded, expect_v4);
+    is_loaded = 0xdead;
+    hr = ICLRRuntimeInfo_IsLoaded(v2, pi.hProcess, &is_loaded);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(is_loaded == expect_v2, "v2 loaded: %d, expected %d.\n", is_loaded, expect_v2);
+    is_loaded = 0xdead;
+    hr = ICLRRuntimeInfo_IsLoaded(v1, pi.hProcess, &is_loaded);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(is_loaded == expect_v1, "v1.1 loaded: %d, expected %d.\n", is_loaded, expect_v1);
+
+    hr = ICLRMetaHost_EnumerateLoadedRuntimes(host, pi.hProcess, &runtimes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(runtime_listed(runtimes, L"v4.0.30319") == expect_v4, "v4 listing wrong.\n");
+        ok(runtime_listed(runtimes, L"v2.0.50727") == expect_v2, "v2 listing wrong.\n");
+        ok(runtime_listed(runtimes, L"v1.1.4322") == expect_v1, "v1.1 listing wrong.\n");
+        IEnumUnknown_Release(runtimes);
+    }
+
+    /* this process has none of them loaded */
+    is_loaded = 0xdead;
+    hr = ICLRRuntimeInfo_IsLoaded(v2, GetCurrentProcess(), &is_loaded);
+    ok(hr == S_OK && !is_loaded, "Got hr %#lx, %d.\n", hr, is_loaded);
+
+    ICLRRuntimeInfo_Release(v4);
+    ICLRRuntimeInfo_Release(v2);
+    ICLRRuntimeInfo_Release(v1);
+    ICLRMetaHost_Release(host);
+
+    SetEvent(quit);
+    ok(WaitForSingleObject(pi.hProcess, 30000) == WAIT_OBJECT_0, "The child did not exit.\n");
+    CloseHandle(pi.hProcess);
+    CloseHandle(pi.hThread);
+done:
+    CloseHandle(loaded);
+    CloseHandle(quit);
+}
+
+static void test_other_process(void)
+{
+    char a[MAX_PATH], b[MAX_PATH], c[MAX_PATH], src[MAX_PATH];
+
+    sprintf(src, "%ssgrc.dll", tmpdir);
+    if (!build_resource_dll(src))
+    {
+        skip("Cannot build a dll on this architecture.\n");
+        return;
+    }
+    sprintf(a, "%sclr.dll", tmpdir);
+    sprintf(b, "%smscorwks.dll", tmpdir);
+    sprintf(c, "%sunrelated.dll", tmpdir);
+    CopyFileA(src, a, FALSE);
+    CopyFileA(src, b, FALSE);
+    CopyFileA(src, c, FALSE);
+
+    run_child(c, "", FALSE, FALSE, FALSE);
+    run_child(a, "", TRUE, FALSE, FALSE);
+    run_child(b, "", FALSE, TRUE, TRUE);
+    run_child(a, b, TRUE, TRUE, TRUE);
+
+    DeleteFileA(src);
+    DeleteFileA(a);
+    DeleteFileA(b);
+    DeleteFileA(c);
+}
