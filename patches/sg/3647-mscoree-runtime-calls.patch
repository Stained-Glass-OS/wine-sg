+/* Loads a string from the resources of the runtime (mscorrc.dll of the given version, the default one
+ * when NULL).  culture -1 is the current user interface language.  If len is negative or buffer is NULL,
+ * only the length is returned. */
+HRESULT load_runtime_string(LPCWSTR version, LCID culture, UINT id, WCHAR *buffer, int buflen, int *length)
+{
+    HMODULE module;
+    HRESULT hr;
+    const WCHAR *str = NULL;
+    int i, len = 0;
+
+    hr = LoadLibraryShim(L"mscorrc.dll", version, NULL, &module);
+    if (FAILED(hr))
+        return HRESULT_FROM_WIN32(ERROR_MOD_NOT_FOUND);
+
+    if (culture != (LCID)-1)
+    {
+        HRSRC res = FindResourceExW(module, (LPCWSTR)RT_STRING, MAKEINTRESOURCEW(id / 16 + 1), LANGIDFROMLCID(culture));
+        const WCHAR *p;
+
+        if (res && (p = LoadResource(module, res)))
+        {
+            for (i = 0; i < id % 16; i++) p += *p + 1;
+            str = p + 1;
+            len = *p;
+        }
+    }
+    if (!str)
+    {
+        HRSRC res = FindResourceW(module, MAKEINTRESOURCEW(id / 16 + 1), (LPCWSTR)RT_STRING);
+        const WCHAR *p;
+
+        if (res && (p = LoadResource(module, res)))
+        {
+            for (i = 0; i < id % 16; i++) p += *p + 1;
+            str = p + 1;
+            len = *p;
+        }
+    }
+    if (!str || !len)
+    {
+        hr = HRESULT_FROM_WIN32(ERROR_RESOURCE_NAME_NOT_FOUND);
+        goto done;
+    }
+
+    if (buffer && buflen > 0)
+    {
+        int n = min(len, buflen - 1);
+#ifdef SG_MUTANT_LOADSTR_LEN
+        n = len;
+#endif
+
+        memcpy(buffer, str, n * sizeof(WCHAR));
+        buffer[n] = 0;
+        len = n;
+    }
+    *length = len;
+    hr = S_OK;
+done:
+    FreeLibrary(module);
+    return hr;
+}
