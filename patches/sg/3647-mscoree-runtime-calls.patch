+static void test_load_string(void)
+{
+    static const char *versions[] = { "v4.0.30319", "v2.0.50727", "v1.1.4322", "v1.0.3705" };
+    char root[MAX_PATH], dir[MAX_PATH], path[MAX_PATH], old[MAX_PATH];
+    DWORD old_size = sizeof(old);
+    BOOL had_old, have_dll = FALSE;
+    ICLRMetaHost *host;
+    ICLRRuntimeInfo *info;
+    WCHAR buffer[64];
+    DWORD size, i;
+    int len;
+    HRESULT hr;
+
+    if (!pLoadStringRC || !pLoadStringRCEx)
+    {
+        win_skip("LoadStringRC not available\n");
+        return;
+    }
+
+    sprintf(root, "%ssgfw\\", tmpdir);
+    CreateDirectoryA(root, NULL);
+    if (!set_install_root(root, old, &old_size, &had_old))
+    {
+        skip("Cannot change the install root.\n");
+        RemoveDirectoryA(root);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(versions); i++)
+    {
+        sprintf(dir, "%s%s", root, versions[i]);
+        CreateDirectoryA(dir, NULL);
+        sprintf(path, "%s\\mscorrc.dll", dir);
+        have_dll = build_resource_dll(path);
+        if (!have_dll) break;
+    }
+    if (!have_dll)
+    {
+        skip("Cannot build the resource dll on this architecture.\n");
+        goto cleanup;
+    }
+
+    memset(buffer, 0xcc, sizeof(buffer));
+    len = -1;
+    hr = pLoadStringRCEx(-1, TEST_STRING_ID, buffer, ARRAY_SIZE(buffer), TRUE, &len);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!lstrcmpW(buffer, test_string), "Got %s.\n", wine_dbgstr_w(buffer));
+    ok(len == lstrlenW(test_string), "Got length %d.\n", len);
+
+    memset(buffer, 0xcc, sizeof(buffer));
+    hr = pLoadStringRCEx(0x0409, TEST_STRING_ID, buffer, ARRAY_SIZE(buffer), TRUE, NULL);
+    ok(hr == S_OK && !lstrcmpW(buffer, test_string), "Got hr %#lx, %s.\n", hr, wine_dbgstr_w(buffer));
+
+    /* a buffer that is too short gets the start of the string */
+    memset(buffer, 0xcc, sizeof(buffer));
+    len = -1;
+    hr = pLoadStringRCEx(-1, TEST_STRING_ID, buffer, 5, TRUE, &len);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!lstrcmpW(buffer, L"SG t") && len == 4, "Got %s, length %d.\n", wine_dbgstr_w(buffer), len);
+
+    memset(buffer, 0xcc, sizeof(buffer));
+    hr = pLoadStringRC(TEST_STRING_ID, buffer, ARRAY_SIZE(buffer), TRUE);
+    ok(hr == S_OK && !lstrcmpW(buffer, test_string), "Got hr %#lx, %s.\n", hr, wine_dbgstr_w(buffer));
+
+    /* missing string */
+    buffer[0] = 0xcccc;
+    len = -1;
+    hr = pLoadStringRCEx(-1, TEST_STRING_ID + 1, buffer, ARRAY_SIZE(buffer), TRUE, &len);
+    ok(FAILED(hr), "Got hr %#lx.\n", hr);
+    ok(!buffer[0] && !len, "Got %s, length %d.\n", wine_dbgstr_w(buffer), len);
+
+    hr = pLoadStringRCEx(-1, TEST_STRING_ID, NULL, 10, TRUE, &len);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = pLoadStringRCEx(-1, TEST_STRING_ID, buffer, 0, TRUE, &len);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    /* ICLRRuntimeInfo::LoadErrorString */
+    hr = pCLRCreateInstance(&CLSID_CLRMetaHost, &IID_ICLRMetaHost, (void **)&host);
+    ok(hr == S_OK, "CLRCreateInstance failed, hr=%#lx.\n", hr);
+    hr = ICLRMetaHost_GetRuntime(host, L"v2.0.50727", &IID_ICLRRuntimeInfo, (void **)&info);
+    ok(hr == S_OK, "GetRuntime failed, hr=%#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        size = 0;
+        hr = ICLRRuntimeInfo_LoadErrorString(info, TEST_STRING_ID, NULL, &size, 0x0409);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ok(size == lstrlenW(test_string) + 1, "Got size %lu.\n", size);
+
+        memset(buffer, 0xcc, sizeof(buffer));
+        size = 4;
+        hr = ICLRRuntimeInfo_LoadErrorString(info, TEST_STRING_ID, buffer, &size, 0x0409);
+        ok(hr == E_NOT_SUFFICIENT_BUFFER, "Got hr %#lx.\n", hr);
+        ok(size == lstrlenW(test_string) + 1, "Got size %lu.\n", size);
+
+        memset(buffer, 0xcc, sizeof(buffer));
+        size = ARRAY_SIZE(buffer);
+        hr = ICLRRuntimeInfo_LoadErrorString(info, TEST_STRING_ID, buffer, &size, 0x0409);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ok(!lstrcmpW(buffer, test_string) && size == lstrlenW(test_string) + 1, "Got %s, size %lu.\n",
+                wine_dbgstr_w(buffer), size);
+
+        size = ARRAY_SIZE(buffer);
+        hr = ICLRRuntimeInfo_LoadErrorString(info, TEST_STRING_ID + 1, buffer, &size, 0x0409);
+        ok(FAILED(hr), "Got hr %#lx.\n", hr);
+        hr = ICLRRuntimeInfo_LoadErrorString(info, TEST_STRING_ID, buffer, NULL, 0x0409);
+        ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+        ICLRRuntimeInfo_Release(info);
+    }
+    ICLRMetaHost_Release(host);
+
+cleanup:
+    restore_install_root(old, old_size, had_old);
+    for (i = 0; i < ARRAY_SIZE(versions); i++)
+    {
+        sprintf(dir, "%s%s", root, versions[i]);
+        sprintf(path, "%s\\mscorrc.dll", dir);
+        DeleteFileA(path);
+        RemoveDirectoryA(dir);
+    }
+    RemoveDirectoryA(root);
+}
