+static BOOL is_runtime_module_name(const WCHAR *name, const CLRRuntimeInfo *info)
+{
+    static const WCHAR *const mono_dlls[] = { L"libmono-2.0-x86_64.dll", L"libmono-2.0-x86.dll", L"mono-2.0.dll",
+                                              L"libmono-2.0.dll" };
+    unsigned int i;
+
+    if (info->major >= 4)
+    {
+#ifndef SG_MUTANT_REMOTE_CLR
+        if (!wcsicmp(name, L"clr.dll")) return TRUE;
+#endif
+    }
+    else if (!wcsicmp(name, L"mscorwks.dll"))
+#ifdef SG_MUTANT_REMOTE_V2
+        return info->major == 2;
+#else
+        return TRUE;
+#endif
+
+    /* Wine Mono is the runtime that serves the newest version */
+    if (info->major == 4)
+        for (i = 0; i < ARRAY_SIZE(mono_dlls); i++)
+            if (!wcsicmp(name, mono_dlls[i])) return TRUE;
+    return FALSE;
+}
+
+/* a runtime of another process is detected by the runtime library it has loaded */
+static HRESULT process_has_runtime(HANDLE process, const CLRRuntimeInfo *info, BOOL *loaded)
+{
+    HMODULE *modules = NULL;
+    DWORD size = 64 * sizeof(*modules), needed, i;
+    WCHAR name[MAX_PATH];
+
+    *loaded = FALSE;
+    for (;;)
+    {
+        if (!(modules = realloc(modules, size))) return E_OUTOFMEMORY;
+        if (!K32EnumProcessModulesEx(process, modules, size, &needed, LIST_MODULES_ALL))
+        {
+            free(modules);
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+        if (needed <= size) break;
+        size = needed;
+    }
+    for (i = 0; i < needed / sizeof(*modules) && !*loaded; i++)
+        if (K32GetModuleBaseNameW(process, modules[i], name, ARRAY_SIZE(name)) && is_runtime_module_name(name, info))
+            *loaded = TRUE;
+    free(modules);
+    return S_OK;
+}
