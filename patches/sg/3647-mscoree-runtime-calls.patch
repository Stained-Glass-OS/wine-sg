+#define TEST_STRING_ID 1001
+static const WCHAR test_string[] = L"SG test string";
+
+static void put32(BYTE *p, DWORD v) { memcpy(p, &v, 4); }
+static void put16(BYTE *p, WORD v) { memcpy(p, &v, 2); }
+
+/* a DLL that holds only a string table resource */
+static BOOL build_resource_dll(const char *path)
+{
+    BYTE *f = calloc(1, 0x400);
+    IMAGE_DOS_HEADER *dos = (void *)f;
+    IMAGE_NT_HEADERS *nt = (void *)(f + 0x40);
+    IMAGE_SECTION_HEADER *sec;
+    BYTE *rs = f + 0x200;
+    DWORD idx = TEST_STRING_ID % 16, i, put;
+    BYTE *strings = rs + 0x60, *p;
+    HANDLE h;
+    BOOL ret;
+
+    dos->e_magic = IMAGE_DOS_SIGNATURE;
+    dos->e_lfanew = 0x40;
+    nt->Signature = IMAGE_NT_SIGNATURE;
+#ifdef _WIN64
+    nt->FileHeader.Machine = IMAGE_FILE_MACHINE_AMD64;
+    nt->OptionalHeader.Magic = IMAGE_NT_OPTIONAL_HDR64_MAGIC;
+    nt->OptionalHeader.ImageBase = 0x180000000ull;
+#elif defined(__i386__)
+    nt->FileHeader.Machine = IMAGE_FILE_MACHINE_I386;
+    nt->OptionalHeader.Magic = IMAGE_NT_OPTIONAL_HDR32_MAGIC;
+    nt->OptionalHeader.ImageBase = 0x10000000;
+#else
+    free(f);
+    return FALSE;
+#endif
+    nt->FileHeader.NumberOfSections = 1;
+    nt->FileHeader.SizeOfOptionalHeader = sizeof(nt->OptionalHeader);
+    nt->FileHeader.Characteristics = IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_DLL;
+    nt->OptionalHeader.SizeOfInitializedData = 0x200;
+    nt->OptionalHeader.SectionAlignment = 0x1000;
+    nt->OptionalHeader.FileAlignment = 0x200;
+    nt->OptionalHeader.MajorOperatingSystemVersion = 4;
+    nt->OptionalHeader.MajorSubsystemVersion = 4;
+    nt->OptionalHeader.SizeOfImage = 0x2000;
+    nt->OptionalHeader.SizeOfHeaders = 0x200;
+    nt->OptionalHeader.Subsystem = IMAGE_SUBSYSTEM_WINDOWS_GUI;
+    nt->OptionalHeader.NumberOfRvaAndSizes = 16;
+    nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_RESOURCE].VirtualAddress = 0x1000;
+    nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_RESOURCE].Size = 0x200;
+    sec = IMAGE_FIRST_SECTION(nt);
+    strcpy((char *)sec->Name, ".rsrc");
+    sec->VirtualAddress = 0x1000;
+    sec->Misc.VirtualSize = 0x200;
+    sec->SizeOfRawData = 0x200;
+    sec->PointerToRawData = 0x200;
+    sec->Characteristics = 0x40000040;
+
+    /* type directory -> name (string table page) directory -> language directory -> data entry */
+    put16(rs + 14, 1);                                 /* NumberOfIdEntries */
+    put32(rs + 16, 6);                                 /* RT_STRING */
+    put32(rs + 20, 0x80000000 | 0x18);
+    put16(rs + 0x18 + 14, 1);
+    put32(rs + 0x18 + 16, TEST_STRING_ID / 16 + 1);    /* the page */
+    put32(rs + 0x18 + 20, 0x80000000 | 0x30);
+    put16(rs + 0x30 + 14, 1);
+    put32(rs + 0x30 + 16, 0x0409);                     /* English (United States) */
+    put32(rs + 0x30 + 20, 0x48);
+    p = strings;
+    for (i = 0; i < 16; i++)
+    {
+        if (i == idx)
+        {
+            put16(p, lstrlenW(test_string));
+            memcpy(p + 2, test_string, lstrlenW(test_string) * sizeof(WCHAR));
+            p += 2 + lstrlenW(test_string) * sizeof(WCHAR);
+        }
+        else
+        {
+            put16(p, 0);
+            p += 2;
+        }
+    }
+    put32(rs + 0x48, 0x1000 + 0x60);
+    put32(rs + 0x4c, p - strings);
+
+    h = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, 0);
+    ret = h != INVALID_HANDLE_VALUE && WriteFile(h, f, 0x400, &put, NULL) && put == 0x400;
+    if (h != INVALID_HANDLE_VALUE) CloseHandle(h);
+    free(f);
+    return ret;
+}
