+static void test_lock_server(void)
+{
+    IClassFactory *cf;
+    HRESULT hr;
+
+    if (!pDllGetClassObject || !pDllCanUnloadNow) return;
+
+    hr = pDllGetClassObject(&CLSID_CorRuntimeHost, &IID_IClassFactory, (void **)&cf);
+    if (FAILED(hr))
+    {
+        win_skip("No class factory for CorRuntimeHost: %#lx.\n", hr);
+        return;
+    }
+    hr = IClassFactory_LockServer(cf, TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(pDllCanUnloadNow() == S_FALSE, "A locked server can be unloaded.\n");
+    hr = IClassFactory_LockServer(cf, FALSE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    /* unbalanced */
+    hr = IClassFactory_LockServer(cf, FALSE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IClassFactory_Release(cf);
+}
+
+static int lock_callback_calls;
+
+static HRESULT WINAPI lock_callback(void)
+{
+    lock_callback_calls++;
+    return S_OK;
+}
+
+static void test_lock_clr_version(void)
+{
+    FLockClrVersionCallback begin = NULL, end = NULL;
+    ICLRMetaHost *host;
+    ICLRRuntimeInfo *info;
+    BOOL loadable = FALSE;
+    void *unk;
+    HRESULT hr;
+
+    if (!pLockClrVersion)
+    {
+        win_skip("LockClrVersion not available\n");
+        return;
+    }
+
+    hr = pLockClrVersion(lock_callback, NULL, &end);
+    ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+    hr = pLockClrVersion(lock_callback, &begin, NULL);
+    ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+
+    hr = pLockClrVersion(lock_callback, &begin, &end);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(begin && end && begin != end, "Got callbacks %p, %p.\n", begin, end);
+    if (begin && end)
+    {
+        ok(begin() == S_OK, "BeginHostSetup failed.\n");
+        ok(end() == S_OK, "EndHostSetup failed.\n");
+    }
+    ok(!lock_callback_calls, "The host callback was called early.\n");
+
+    hr = pCLRCreateInstance(&CLSID_CLRMetaHost, &IID_ICLRMetaHost, (void **)&host);
+    ok(hr == S_OK, "CLRCreateInstance failed, hr=%#lx.\n", hr);
+    hr = ICLRMetaHost_GetRuntime(host, L"v4.0.30319", &IID_ICLRRuntimeInfo, (void **)&info);
+    ok(hr == S_OK, "GetRuntime failed, hr=%#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = ICLRRuntimeInfo_IsLoadable(info, &loadable);
+        ok(hr == S_OK, "IsLoadable failed, hr=%#lx.\n", hr);
+        ok(!lock_callback_calls, "The host callback was called without loading.\n");
+        if (loadable)
+        {
+            hr = ICLRRuntimeInfo_GetInterface(info, &CLSID_CorRuntimeHost, &IID_ICorRuntimeHost, &unk);
+            if (SUCCEEDED(hr))
+            {
+                ok(lock_callback_calls == 1, "The host callback was called %d times.\n", lock_callback_calls);
+                IUnknown_Release((IUnknown *)unk);
+                hr = ICLRRuntimeInfo_GetInterface(info, &CLSID_CLRRuntimeHost, &IID_ICLRRuntimeHost, &unk);
+                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                if (SUCCEEDED(hr)) IUnknown_Release((IUnknown *)unk);
+                ok(lock_callback_calls == 1, "The host callback was called %d times.\n", lock_callback_calls);
+            }
+        }
+        ICLRRuntimeInfo_Release(info);
+    }
+    ICLRMetaHost_Release(host);
+}
