+    pLoadStringRC = (void *)GetProcAddress(hmscoree, "LoadStringRC");
+    pLoadStringRCEx = (void *)GetProcAddress(hmscoree, "LoadStringRCEx");
+    pDllCanUnloadNow = (void *)GetProcAddress(hmscoree, "DllCanUnloadNow");
+    pDllGetClassObject = (void *)GetProcAddress(hmscoree, "DllGetClassObject");
+    pCLRCreateInstance = (void *)GetProcAddress(hmscoree, "CLRCreateInstance");
+    if (!pCLRCreateInstance)
+    {
+        win_skip("CLRCreateInstance not available\n");
+        return FALSE;
+    }
+    return TRUE;
+}
