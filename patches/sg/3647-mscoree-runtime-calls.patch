+HRESULT WINAPI LockClrVersion(FLockClrVersionCallback host_callback, FLockClrVersionCallback *begin_host_setup,
+        FLockClrVersionCallback *end_host_setup)
+{
+    TRACE("(%p %p %p)\n", host_callback, begin_host_setup, end_host_setup);
