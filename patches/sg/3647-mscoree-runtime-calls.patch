+static void test_legacy_binding_and_proc(void)
+{
+    ICLRMetaHost *host;
+    ICLRRuntimeInfo *v2, *v4, *got;
+    void *proc = NULL;
+    BOOL loadable = FALSE;
+    HRESULT hr;
+
+    hr = pCLRCreateInstance(&CLSID_CLRMetaHost, &IID_ICLRMetaHost, (void **)&host);
+    ok(hr == S_OK, "CLRCreateInstance failed, hr=%#lx.\n", hr);
+    ICLRMetaHost_GetRuntime(host, L"v2.0.50727", &IID_ICLRRuntimeInfo, (void **)&v2);
+    ICLRMetaHost_GetRuntime(host, L"v4.0.30319", &IID_ICLRRuntimeInfo, (void **)&v4);
+
+    got = (void *)0xdeadbeef;
+    hr = ICLRMetaHost_QueryLegacyV2RuntimeBinding(host, &IID_ICLRRuntimeInfo, (void **)&got);
+    ok(hr == CLR_E_SHIM_RUNTIMELOAD, "Got hr %#lx.\n", hr);
+    ok(!got, "Got %p.\n", got);
+    hr = ICLRMetaHost_QueryLegacyV2RuntimeBinding(host, &IID_ICLRRuntimeInfo, NULL);
+    ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+
+    hr = ICLRRuntimeInfo_BindAsLegacyV2Runtime(v2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    got = NULL;
+    hr = ICLRMetaHost_QueryLegacyV2RuntimeBinding(host, &IID_ICLRRuntimeInfo, (void **)&got);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(got == v2, "Got %p, expected %p.\n", got, v2);
+    if (got) ICLRRuntimeInfo_Release(got);
+    hr = ICLRRuntimeInfo_BindAsLegacyV2Runtime(v4);
+    ok(hr == CLR_E_SHIM_LEGACYRUNTIMEALREADYBOUND, "Got hr %#lx.\n", hr);
+
+    hr = ICLRRuntimeInfo_IsLoadable(v4, &loadable);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (loadable)
+    {
+        hr = ICLRRuntimeInfo_GetProcAddress(v4, "CorBindToRuntimeEx", &proc);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ok(proc && proc == GetProcAddress(hmscoree, "CorBindToRuntimeEx"), "Got %p.\n", proc);
+        proc = (void *)0xdeadbeef;
+        hr = ICLRRuntimeInfo_GetProcAddress(v4, "NoSuchExportSG", &proc);
+        ok(hr == CLR_E_SHIM_RUNTIMEEXPORT, "Got hr %#lx.\n", hr);
+        ok(!proc, "Got %p.\n", proc);
+        hr = ICLRRuntimeInfo_GetProcAddress(v4, NULL, &proc);
+        ok(hr == E_POINTER, "Got hr %#lx.\n", hr);
+    }
+
+    ICLRRuntimeInfo_Release(v2);
+    ICLRRuntimeInfo_Release(v4);
+    ICLRMetaHost_Release(host);
+}
+
+START_TEST(sgcalls)
+{
+    char **argv;
+    int argc;
+
+    argc = winetest_get_mainargs(&argv);
+    if (!init_pointers())
+        return;
+
+    if (argc >= 5 && !strcmp(argv[2], "child_load"))
+    {
+        child_load(argv[3], argv[4], argc >= 6 ? argv[5] : "");
+        return;
+    }
+
+    GetTempPathA(sizeof(tmpdir), tmpdir);
+
+    test_lock_server();
+    test_lock_clr_version();
+    test_load_string();
+    test_other_process();
+    test_legacy_binding_and_proc();
+
+    FreeLibrary(hmscoree);
+}
