+    if (!begin_host_setup || !end_host_setup)
+        return E_POINTER;
+
+    *begin_host_setup = BeginHostSetup;
+    *end_host_setup = EndHostSetup;
+    InterlockedExchangePointer((void **)&lock_clr_callback, host_callback);
+    return S_OK;
+}
