+#define CM_CREATE_DEVNODE_NO_WAIT_INSTALL 0x1
+#define CM_CREATE_DEVNODE_PHANTOM         0x2
+#define CM_CREATE_DEVNODE_GENERATE_ID     0x4
+#define CM_CREATE_DEVNODE_DO_NOT_INSTALL  0x8
+
+/***********************************************************************
+ *      CM_Create_DevNode_ExW (SETUPAPI.@)
+ *
+ * Create the device instance key under Enum (with its Control key unless it is a phantom, the
+ * mark of a present device) and return the devnode of the new instance.
+ */
+CONFIGRET WINAPI CM_Create_DevNode_ExW(DEVINST *devnode, DEVINSTID_W id, DEVINST parent, ULONG flags, HMACHINE machine)
+{
+    static const DEVPROPKEY parent_key = {{0x4340a6c5,0x93fa,0x4706,{0x97,0x2c,0x7b,0x64,0x80,0x08,0xa5,0xa7}}, 8};
+    WCHAR full[MAX_DEVICE_ID_LEN], parent_id[MAX_DEVICE_ID_LEN];
+    SP_DEVINFO_DATA data = {sizeof(data)};
+    HKEY key, enum_key;
+    unsigned int slashes = 0, n;
+    const WCHAR *p;
+    CONFIGRET cr;
+    LONG ret;
+
+    TRACE("%p %s %lu %#lx %p\n", devnode, debugstr_w(id), parent, flags, machine);
+
+    if (!devnode || !id) return CR_INVALID_POINTER;
+    *devnode = 0;
+    if (flags & ~(CM_CREATE_DEVNODE_NO_WAIT_INSTALL | CM_CREATE_DEVNODE_PHANTOM | CM_CREATE_DEVNODE_GENERATE_ID |
+                  CM_CREATE_DEVNODE_DO_NOT_INSTALL))
+        return CR_INVALID_FLAG;
+    if ((cr = devnode_id(parent, parent_id))) return cr;
+    if (!*id || id[0] == '\\' || wcslen(id) >= MAX_DEVICE_ID_LEN - 6) return CR_INVALID_DEVICE_ID;
+    for (p = id; *p; p++)
+        if (*p == '\\') slashes++;
+    /* ENUMERATOR\DEVICE\INSTANCE, or without the instance when it is to be generated */
+    if (slashes != ((flags & CM_CREATE_DEVNODE_GENERATE_ID) ? 1 : 2) || id[wcslen(id) - 1] == '\\')
+        return CR_INVALID_DEVICE_ID;
+
+    if (flags & CM_CREATE_DEVNODE_GENERATE_ID)
+    {
+        for (n = 0; n < 10000; n++)
+        {
+            swprintf(full, ARRAY_SIZE(full), L"%ls\\%04u", id, n);
+            if (!open_enum_subkey(full, NULL)) break;
+        }
+        if (n == 10000) return CR_FAILURE;
+    }
+    else
+    {
+        wcscpy(full, id);
+#ifdef SG_MUTANT_SUAPI_DUP
+        if (0)
+#else
+        if ((key = open_enum_subkey(full, NULL)))
+#endif
+        {
+            RegCloseKey(key);
+            return CR_ALREADY_SUCH_DEVNODE;
+        }
+    }
+
+    if ((ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, Enum, 0, KEY_CREATE_SUB_KEY, &enum_key)))
+        return ret == ERROR_ACCESS_DENIED ? CR_ACCESS_DENIED : CR_REGISTRY_ERROR;
+    ret = RegCreateKeyExW(enum_key, full, 0, NULL, 0, KEY_CREATE_SUB_KEY | KEY_SET_VALUE, NULL, &key, NULL);
+    RegCloseKey(enum_key);
+    if (ret) return ret == ERROR_ACCESS_DENIED ? CR_ACCESS_DENIED : CR_REGISTRY_ERROR;
+    /* a new devnode is of the Unknown class until a driver is installed */
+    RegSetValueExW(key, L"ClassGUID", 0, REG_SZ, (BYTE *)L"{4D36E97E-E325-11CE-BFC1-08002BE10318}",
+                   sizeof(L"{4D36E97E-E325-11CE-BFC1-08002BE10318}"));
+    if (!(flags & CM_CREATE_DEVNODE_PHANTOM))
+    {
+        HKEY control;
+        if (!RegCreateKeyExW(key, L"Control", 0, NULL, 0, KEY_SET_VALUE, NULL, &control, NULL)) RegCloseKey(control);
+    }
+    RegCloseKey(key);
+
+    if (!get_tree_set() || !SetupDiOpenDeviceInfoW(get_tree_set(), full, NULL, 0, &data)) return CR_REGISTRY_ERROR;
+    /* the root of the tree is the parent of an instance without one */
+    if (parent != ROOT_DEVNODE)
+        SetupDiSetDevicePropertyW(get_tree_set(), &data, &parent_key, DEVPROP_TYPE_STRING, (BYTE *)parent_id,
+                                  (wcslen(parent_id) + 1) * sizeof(WCHAR), 0);
+    *devnode = data.DevInst;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Create_DevNodeW(DEVINST *devnode, DEVINSTID_W id, DEVINST parent, ULONG flags)
+{
+    return CM_Create_DevNode_ExW(devnode, id, parent, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Create_DevNode_ExA(DEVINST *devnode, DEVINSTID_A id, DEVINST parent, ULONG flags, HMACHINE machine)
+{
+    WCHAR idW[MAX_DEVICE_ID_LEN];
+
+    if (!devnode || !id) return CR_INVALID_POINTER;
+    if (!MultiByteToWideChar(CP_ACP, 0, id, -1, idW, ARRAY_SIZE(idW))) return CR_INVALID_DEVICE_ID;
+    return CM_Create_DevNode_ExW(devnode, idW, parent, flags, machine);
+}
+
+CONFIGRET WINAPI CM_Create_DevNodeA(DEVINST *devnode, DEVINSTID_A id, DEVINST parent, ULONG flags)
+{
+    return CM_Create_DevNode_ExA(devnode, id, parent, flags, NULL);
+}
