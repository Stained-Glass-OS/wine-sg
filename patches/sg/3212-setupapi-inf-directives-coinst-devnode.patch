+            DWORD dirs_size = sizeof(dirs) - sizeof(WCHAR), type;
+
+            if (RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion", L"DevicePath",
+                    RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, &type, dirs, &dirs_size))
+                wcscpy(dirs, L"%SystemRoot%\\inf");
+            for (p = dirs; p && *p && !found; p = next)
+            {
+                WCHAR expanded[MAX_PATH];
+
+                if ((next = wcschr(p, ';'))) *next++ = 0;
+                if (!ExpandEnvironmentStringsW(p, expanded, ARRAY_SIZE(expanded)) || wcslen(expanded) + 1 + wcslen(inf) >= MAX_PATH)
+                    continue;
+                swprintf(dir, ARRAY_SIZE(dir), L"%ls\\%ls", expanded, inf);
+                if (GetFileAttributesW(dir) != INVALID_FILE_ATTRIBUTES)
+                {
+                    wcscpy(found_path, dir);
+                    found = TRUE;
+                }
+            }
+        }
+        if (!found)
+        {
+            SetLastError(ERROR_FILE_NOT_FOUND);
+            return FALSE;
+        }
+        inf = found_path;
     }
 
     if (!class_guid || !class_name || !size)
