+
+/* Run the co-installers that asked for post-processing, last called first, giving them the result of
+ * the install function. Their return value replaces the result. */
+static DWORD run_postprocessing(struct postprocess **pending, DI_FUNCTION function, HDEVINFO devinfo,
+        SP_DEVINFO_DATA *device_data, DWORD result)
+{
+    struct postprocess *post;
+
+    while ((post = *pending))
+    {
+        *pending = post->next;
+        post->ctx.PostProcessing = TRUE;
+        post->ctx.InstallResult = result;
+        TRACE("Calling co-installer %p for post-processing, result %#lx.\n", post->proc, result);
+        result = post->proc(function, devinfo, device_data, &post->ctx);
+        TRACE("Co-installer %p returned %#lx.\n", post->proc, result);
+        FreeLibrary(post->module);
+        free(post);
+    }
+    return result;
+}
+
