+        }
+        if (RegCreateKeyExW( root, subkey, 0, NULL, 0, KEY_SET_VALUE, NULL, &hkey, &disp )) continue;
+
+        if (*key)
+        {
+            WCHAR value[MAX_INF_STRING_LENGTH];
+            static const WCHAR missing[] = L"\x01missing\x02";
+
+            GetPrivateProfileStringW( section, key, missing, value, ARRAY_SIZE(value), file );
+            if (wcscmp( value, missing ))
+            {
+                RegSetValueExW( hkey, key, 0, REG_SZ, (BYTE *)value, (lstrlenW( value ) + 1) * sizeof(WCHAR) );
+                if (flags & 1) WritePrivateProfileStringW( section, key, NULL, file );
+            }
+        }
+        else
+        {
+            WCHAR *buffer = NULL, *p;
+            DWORD size = 1024, got;
+
+            for (;;)
+            {
