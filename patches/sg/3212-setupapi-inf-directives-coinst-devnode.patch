+/* The .pnf beside an installed INF records the path the INF was copied from: for an oemN.inf that is
+ * its driver store copy, named like the original file. */
+static BOOL get_pnf_source( const WCHAR *inf_path, WCHAR *source )
+{
+    WCHAR pnf_path[MAX_PATH], line[MAX_PATH];
+    FILE *pnf;
+    BOOL ret = FALSE;
+
+    if (wcslen( inf_path ) >= MAX_PATH) return FALSE;
+    wcscpy( pnf_path, inf_path );
+    PathRemoveExtensionW( pnf_path );
+    PathAddExtensionW( pnf_path, L".pnf" );
+    if (!(pnf = _wfopen( pnf_path, L"r" ))) return FALSE;
+    if (fgetws( line, MAX_PATH, pnf ) && !wcscmp( line, PNF_HEADER ) && fgetws( source, MAX_PATH, pnf ))
+    {
+        size_t len = wcslen( source );
+        while (len && (source[len - 1] == '\n' || source[len - 1] == '\r')) source[--len] = 0;
+        ret = len != 0;
+    }
+    fclose( pnf );
+    return ret;
+}
