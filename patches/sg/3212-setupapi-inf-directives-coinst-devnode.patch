+/* Tell the user a file operation failed and ask what to do. The buttons are Retry, Skip and Cancel;
+ * IDF_NOSKIP leaves Skip out, and a skip the caller asked to be warned about (IDF_WARNIFSKIP) is
+ * confirmed first. Returns the DPROMPT_* answer. */
+static UINT file_error_prompt( HWND parent, const WCHAR *title, const WCHAR *what, UINT error, DWORD style )
+{
+    WCHAR *text, *message = NULL;
+#ifdef SG_MUTANT_SUAPI_NOSKIP
+    UINT type = MB_ABORTRETRYIGNORE;
+#else
+    UINT type = (style & IDF_NOSKIP) ? MB_RETRYCANCEL : MB_ABORTRETRYIGNORE;
+#endif
+    size_t len;
+    int answer;
+
+    FormatMessageW( FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
+                    NULL, error, 0, (WCHAR *)&message, 0, NULL );
+    len = wcslen( what ) + (message ? wcslen( message ) : 0) + 64;
+    if (!(text = malloc( len * sizeof(WCHAR) )))
+    {
+        LocalFree( message );
+        return DPROMPT_OUTOFMEMORY;
+    }
+    swprintf( text, len, L"%ls\n\n%ls (%u)", what, message ? message : L"", error );
+    LocalFree( message );
+
+    for (;;)
+    {
+        if (!(style & IDF_NOBEEP)) MessageBeep( MB_ICONERROR );
+        answer = MessageBoxW( parent, text, title ? title : L"Setup", type | MB_ICONERROR |
+                              ((style & IDF_NOFOREGROUND) ? 0 : MB_SETFOREGROUND) );
+        if (answer == IDIGNORE && (style & IDF_WARNIFSKIP) &&
+            MessageBoxW( parent, L"If you skip this file, the program may not work correctly. Skip it anyway?",
+                         title ? title : L"Setup", MB_YESNO | MB_ICONWARNING ) != IDYES)
+            continue;
+        break;
+    }
+    free( text );
+    switch (answer)
+    {
+    case IDRETRY: return DPROMPT_SUCCESS;
+    case IDIGNORE: return DPROMPT_SKIPFILE;
+    default: return DPROMPT_CANCEL;
+    }
+}
