+/* a co-installer that asked to run again once the install function was carried out */
+struct postprocess
+{
+    struct postprocess *next;
+    HMODULE module;
+    DWORD (CALLBACK *proc)(DI_FUNCTION, HDEVINFO, SP_DEVINFO_DATA *, COINSTALLER_CONTEXT_DATA *);
+    COINSTALLER_CONTEXT_DATA ctx;
