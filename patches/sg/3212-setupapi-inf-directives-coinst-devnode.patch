+/* case insensitive match of name against pattern, where a '*' stands for any run of characters */
+static BOOL field_matches( const WCHAR *pattern, const WCHAR *name, BOOL wildcard )
+{
+    if (!wildcard) return !wcsicmp( pattern, name );
+    while (*pattern)
+    {
+        if (*pattern == '*')
+        {
+            while (*pattern == '*') pattern++;
+            if (!*pattern) return TRUE;
+            for (; *name; name++) if (field_matches( pattern, name, TRUE )) return TRUE;
+            return FALSE;
+        }
+        if (towlower( *pattern ) != towlower( *name )) return FALSE;
+        pattern++;
+        name++;
+    }
+    return !*name;
+}
+
+/* The fields of an INI line are separated by spaces, tabs and commas. Find the span of the first
+ * field matching pattern. */
+static BOOL find_line_field( const WCHAR *line, const WCHAR *pattern, BOOL wildcard, size_t *start, size_t *end )
+{
+    size_t i = 0, len = wcslen( line );
+
+    while (i < len)
+    {
+        size_t j;
+        WCHAR *field;
+        BOOL match;
+
+        while (i < len && (line[i] == ' ' || line[i] == '\t' || line[i] == ',')) i++;
+        for (j = i; j < len && line[j] != ' ' && line[j] != '\t' && line[j] != ','; j++) ;
+        if (j == i) break;
+        if (!(field = malloc( (j - i + 1) * sizeof(WCHAR) ))) return FALSE;
+        memcpy( field, line + i, (j - i) * sizeof(WCHAR) );
+        field[j - i] = 0;
+        match = field_matches( pattern, field, wildcard );
+        free( field );
+        if (match) { *start = i; *end = j; return TRUE; }
+        i = j;
+    }
+    return FALSE;
+}
+
+/* UpdateIniFields: ini-file,ini-section,profile-name[,old-field][,new-field][,flags] */
 static BOOL update_ini_fields_callback( HINF hinf, PCWSTR field, void *arg )
 {
-    FIXME( "should update ini fields %s\n", debugstr_w(field) );
+    INFCONTEXT context;
+    BOOL ok = SetupFindFirstLineW( hinf, field, NULL, &context );
+
+    for (; ok; ok = SetupFindNextLine( &context, &context ))
+    {
+        WCHAR file[MAX_INF_STRING_LENGTH], section[MAX_INF_STRING_LENGTH], name[MAX_INF_STRING_LENGTH];
+        WCHAR old_field[MAX_INF_STRING_LENGTH], new_field[MAX_INF_STRING_LENGTH];
+        WCHAR line[MAX_INF_STRING_LENGTH * 2], result[MAX_INF_STRING_LENGTH * 3];
+        size_t start, end;
+        INT flags = 0;
+        BOOL wildcard, comma;
+
+        if (!SetupGetStringFieldW( &context, 1, file, ARRAY_SIZE(file), NULL ) ||
+            !SetupGetStringFieldW( &context, 2, section, ARRAY_SIZE(section), NULL ) ||
+            !SetupGetStringFieldW( &context, 3, name, ARRAY_SIZE(name), NULL ))
+            continue;
+        if (!SetupGetStringFieldW( &context, 4, old_field, ARRAY_SIZE(old_field), NULL )) *old_field = 0;
+        if (!SetupGetStringFieldW( &context, 5, new_field, ARRAY_SIZE(new_field), NULL )) *new_field = 0;
+        if (!*old_field && !*new_field) continue;
+        if (!SetupGetIntField( &context, 6, &flags )) flags = 0;
+        wildcard = flags & 1;
+        comma = flags & 2;
+
+        GetPrivateProfileStringW( section, name, L"", line, ARRAY_SIZE(line), file );
+        TRACE( "%s [%s] %s = %s: old %s new %s flags %#x\n", debugstr_w(file), debugstr_w(section),
+               debugstr_w(name), debugstr_w(line), debugstr_w(old_field), debugstr_w(new_field), flags );
+
+#ifdef SG_MUTANT_SUAPI_UIF
+        if (0)
+#else
+        if (*old_field && find_line_field( line, old_field, wildcard, &start, &end ))
+#endif
+        {
+            /* replace the field, or delete it together with the separator after it (before it for the last) */
+            if (*new_field)
+                swprintf( result, ARRAY_SIZE(result), L"%.*ls%ls%ls", (int)start, line, new_field, line + end );
+            else
+            {
+                size_t after = end;
+                while (line[after] == ' ' || line[after] == '\t' || line[after] == ',') after++;
+                if (!line[after])
+                    while (start && (line[start - 1] == ' ' || line[start - 1] == '\t' || line[start - 1] == ',')) start--;
+                swprintf( result, ARRAY_SIZE(result), L"%.*ls%ls", (int)start, line, line + after );
+            }
+        }
+        else if (*new_field && !*old_field)
+        {
+            /* an addition: skipped when the field is there already */
+            if (find_line_field( line, new_field, FALSE, &start, &end )) continue;
+            if (*line) swprintf( result, ARRAY_SIZE(result), L"%ls%ls%ls", line, comma ? L"," : L" ", new_field );
+            else lstrcpyW( result, new_field );
+        }
+        else continue;   /* nothing to replace or delete */
+
+        WritePrivateProfileStringW( section, name, result, file );
+    }
     return TRUE;
 }
 
+/* Ini2Reg: ini-file,ini-section,[ini-key],reg-root,subkey[,flags] */
 static BOOL ini2reg_callback( HINF hinf, PCWSTR field, void *arg )
 {
-    FIXME( "should do ini2reg %s\n", debugstr_w(field) );
+    struct registry_callback_info *info = arg;
+    INFCONTEXT context;
+    BOOL ok = SetupFindFirstLineW( hinf, field, NULL, &context );
+
+    for (; ok; ok = SetupFindNextLine( &context, &context ))
+    {
+        WCHAR file[MAX_INF_STRING_LENGTH], section[MAX_INF_STRING_LENGTH], key[MAX_INF_STRING_LENGTH];
+        WCHAR root_name[MAX_INF_STRING_LENGTH], subkey[MAX_INF_STRING_LENGTH];
