+            !SetupGetStringFieldW( &context, 4, root_name, ARRAY_SIZE(root_name), NULL ))
+            continue;
+        if (!SetupGetStringFieldW( &context, 3, key, ARRAY_SIZE(key), NULL )) *key = 0;
+        if (!SetupGetStringFieldW( &context, 5, subkey, ARRAY_SIZE(subkey), NULL )) *subkey = 0;
+        if (!SetupGetIntField( &context, 6, &flags )) flags = 0;
