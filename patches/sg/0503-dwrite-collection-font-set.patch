From: Stained Glass OS <dev@stained-glass.example>
Subject: dwrite: a font collection's font set; family and face names of font set entries

IDWriteFontCollection1::GetFontSet and IDWriteFontCollection2::GetFontSet
returned E_NOTIMPL; Office's text layout asks the system collection for its
set. The set holds every face of every family. Its entries now answer the
weight-stretch-style and typographic family and face names (they knew only
the full, PostScript and Win32 names), so a set made from a collection
matches by family; an unsupported property no longer returns an
uninitialized value.

Gate: test/dwfontset-gate.sh (make test-dwfontset).

--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -3425,11 +3425,38 @@
     return hr;
 }
 
+/* Stained Glass OS: a collection's fonts as a font set, every face of every
+ * family (Office's text layout asks the system collection for one and drew
+ * no text without it). */
+static HRESULT fontcollection_get_fontset(struct dwrite_fontcollection *collection, IDWriteFontSet1 **fontset)
+{
+    struct dwrite_font_data **fonts;
+    size_t i, j, count = 0;
+    HRESULT hr;
+
+    for (i = 0; i < collection->count; ++i)
+        count += collection->family_data[i]->count;
+    if (!(fonts = calloc(count ? count : 1, sizeof(*fonts))))
+        return E_OUTOFMEMORY;
+    count = 0;
+    for (i = 0; i < collection->count; ++i)
+    {
+        for (j = 0; j < collection->family_data[i]->count; ++j)
+            fonts[count++] = collection->family_data[i]->fonts[j];
+    }
+    hr = fontset_create_from_font_data(collection->factory, fonts, count, fontset);
+    free(fonts);
+    return hr;
+}
+
 static HRESULT WINAPI dwritefontcollection1_GetFontSet(IDWriteFontCollection3 *iface, IDWriteFontSet **fontset)
 {
-    FIXME("%p, %p.\n", iface, fontset);
+    struct dwrite_fontcollection *collection = impl_from_IDWriteFontCollection3(iface);
 
-    return E_NOTIMPL;
+    TRACE("%p, %p.\n", iface, fontset);
+
+    if (!fontset) return E_INVALIDARG;
+    return fontcollection_get_fontset(collection, (IDWriteFontSet1 **)fontset);
 }
 
 static HRESULT WINAPI dwritefontcollection1_GetFontFamily(IDWriteFontCollection3 *iface, UINT32 index,
@@ -3492,9 +3519,12 @@
 
