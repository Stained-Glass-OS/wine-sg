index 2b8c99c..89fbd2c 100644
--- a/dlls/msvcp90/misc.c
+++ b/dlls/msvcp90/misc.c
@@ -19,6 +19,8 @@
 #include <stdarg.h>
 #include <limits.h>
 #include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
 
 #include "msvcp90.h"
 
@@ -1886,3 +1888,110 @@ void __cdecl _ReportUnobservedException(void)
     terminate();
 }
 #endif
+
+#if _MSVCP_VER >= 90
+/* The multiprecision arithmetic of <random>'s engines with a 64-bit
+ * modulus: _MP_Mul sets the number to a product, _MP_Add adds, _MP_Rem
+ * reduces it modulo m and _MP_Get returns its low 64 bits. The number is
+ * kept in the caller's array of five unsigned 64-bit cells, a 32-bit digit
+ * in each, least significant first. */
+#define MP_LEN 5
+
+/* ?_MP_Mul@std@@YAXQA_K_K1@Z */
+/* ?_MP_Mul@std@@YAXQEA_K_K1@Z */
+/* ?_MP_Mul@tr1@std@@YAXQA_K_K1@Z */
+/* ?_MP_Mul@tr1@std@@YAXQEA_K_K1@Z */
+void __cdecl _MP_Mul(ULONGLONG *w, ULONGLONG u, ULONGLONG v)
+{
+    ULONGLONG a[2] = {u & 0xffffffff, u >> 32}, b[2] = {v & 0xffffffff, v >> 32}, carry;
+    int i, j;
+
+    TRACE("(%p %s %s)\n", w, wine_dbgstr_longlong(u), wine_dbgstr_longlong(v));
+
+    memset(w, 0, MP_LEN * sizeof(*w));
+    for (i = 0; i < 2; i++)
+    {
+        carry = 0;
+        for (j = 0; j < 2; j++)
+        {
+            ULONGLONG t = a[i] * b[j] + w[i + j] + carry;
+            w[i + j] = t & 0xffffffff;
+            carry = t >> 32;
+        }
+        w[i + 2] += carry;
+    }
+}
+
+/* ?_MP_Add@std@@YAXQA_K_K@Z */
+/* ?_MP_Add@std@@YAXQEA_K_K@Z */
+/* ?_MP_Add@tr1@std@@YAXQA_K_K@Z */
+/* ?_MP_Add@tr1@std@@YAXQEA_K_K@Z */
+void __cdecl _MP_Add(ULONGLONG *w, ULONGLONG v)
+{
+    ULONGLONG carry = 0;
+    int i;
+
+    TRACE("(%p %s)\n", w, wine_dbgstr_longlong(v));
+
+    for (i = 0; i < MP_LEN; i++)
+    {
+        ULONGLONG t = w[i] + (v & 0xffffffff) + carry;
+        w[i] = t & 0xffffffff;
+        carry = t >> 32;
+        v >>= 32;
+    }
+}
+
+/* ?_MP_Rem@std@@YAXQA_K_K@Z */
+/* ?_MP_Rem@std@@YAXQEA_K_K@Z */
+/* ?_MP_Rem@tr1@std@@YAXQA_K_K@Z */
+/* ?_MP_Rem@tr1@std@@YAXQEA_K_K@Z */
+void __cdecl _MP_Rem(ULONGLONG *w, ULONGLONG m)
+{
+    ULONGLONG r = 0;
+    int i, bit;
+
+    TRACE("(%p %s)\n", w, wine_dbgstr_longlong(m));
+
+    if (!m) return;
+    for (i = MP_LEN - 1; i >= 0; i--)
+    {
+        for (bit = 31; bit >= 0; bit--)
+        {
+            ULONGLONG top = r >> 63;
+
+            r = (r << 1) | ((w[i] >> bit) & 1);
+#ifndef SG_MUTANT_MP_REM_NO_OVERFLOW
+            if (top || r >= m) r -= m;
+#else
+            if (r >= m) r -= m;
+#endif
+        }
+    }
+    memset(w, 0, MP_LEN * sizeof(*w));
+    w[0] = r & 0xffffffff;
+    w[1] = r >> 32;
+}
+
+/* ?_MP_Get@std@@YA_KQA_K@Z */
+/* ?_MP_Get@std@@YA_KQEA_K@Z */
+/* ?_MP_Get@tr1@std@@YA_KQA_K@Z */
+/* ?_MP_Get@tr1@std@@YA_KQEA_K@Z */
+ULONGLONG __cdecl _MP_Get(ULONGLONG *w)
+{
+    TRACE("(%p)\n", w);
+    return w[0] | (w[1] << 32);
+}
+
+/* ?_Rng_abort@std@@YAXPBD@Z */
+/* ?_Rng_abort@std@@YAXPEBD@Z */
+/* ?_Rng_abort@tr1@std@@YAXPBD@Z */
+/* ?_Rng_abort@tr1@std@@YAXPEBD@Z */
+/* a random number engine or distribution got an invalid parameter */
+void __cdecl _Rng_abort(const char *msg)
+{
+    fputs(msg, stderr);
+    fputc('\n', stderr);
+    abort();
+}
+#endif
