+/* The bytes a writer saves. */
+HRESULT md_writer_save_bytes(IWICMetadataWriter *writer, BYTE **bytes, UINT *len)
+{
+    IWICPersistStream *persist;
+    IStream *stream;
+    LARGE_INTEGER zero = {{0}};
+    STATSTG stat;
+    ULONG read;
+    HRESULT hr;
+
+    *bytes = NULL;
+    *len = 0;
+    if (FAILED(hr = IWICMetadataWriter_QueryInterface(writer, &IID_IWICPersistStream, (void **)&persist)))
+        return hr;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream)))
+    {
+        IWICPersistStream_Release(persist);
+        return hr;
+    }
+    if (SUCCEEDED(hr = IWICPersistStream_Save(persist, stream, FALSE))
+            && SUCCEEDED(hr = IStream_Stat(stream, &stat, STATFLAG_NONAME))
+            && SUCCEEDED(hr = IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL)))
+    {
+        if (!stat.cbSize.LowPart)
+            hr = S_OK;
+        else if (!(*bytes = malloc(stat.cbSize.LowPart)))
+            hr = E_OUTOFMEMORY;
+        else if (SUCCEEDED(hr = IStream_Read(stream, *bytes, stat.cbSize.LowPart, &read)) && read == stat.cbSize.LowPart)
+            *len = read;
+        else
+        {
+            free(*bytes);
+            *bytes = NULL;
+            if (SUCCEEDED(hr)) hr = E_FAIL;
+        }
+    }
+    IStream_Release(stream);
+    IWICPersistStream_Release(persist);
+    return hr;
+}
