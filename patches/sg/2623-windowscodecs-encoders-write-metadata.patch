From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: encoders write the metadata of the frame's writers

The metadata writers of a frame (added to the block writer or made by the query
writer) were kept but never reached the file. Now, when the frame is created at the
first WritePixels:
 - PNG: the text, gamma, chromaticity, histogram and time writers become tEXt, gAMA,
   cHRM, hIST (palette images) and tIME chunks; values libpng rejects are left out
   instead of failing the image.
 - JPEG: the Exif App1 writers become APP1 segments, before the ICC profile.
 - GIF: the graphic control (delay, disposal, transparency), comment and application
   extension writers are written before the image, the image descriptor writer sets the
   image position.
The writers are saved with the Save methods of the previous patches; the records
reach the unix side in the frame description. A GIF frame's writer list is
initialised (the block writer of the previous patch read it uninitialised).
---
--- a/dlls/windowscodecs/encoder.c
+++ b/dlls/windowscodecs/encoder.c
@@ -434,6 +434,69 @@ static HRESULT WINAPI CommonEncoderFrame_SetThumbnail(IWICBitmapFrameEncode *ifa
     return hr;
 }
 
+/* The writers the file type has a place for: the PNG chunks of the text, gamma, chromaticities, histogram
+ * and time writers, the JPEG Exif APP1 segments. */
+static BOOL frame_writer_wanted(const GUID *container, const GUID *format)
+{
+    if (IsEqualGUID(container, &GUID_ContainerFormatPng))
+        return IsEqualGUID(format, &GUID_MetadataFormatChunktEXt) || IsEqualGUID(format, &GUID_MetadataFormatChunkgAMA)
+                || IsEqualGUID(format, &GUID_MetadataFormatChunkcHRM) || IsEqualGUID(format, &GUID_MetadataFormatChunkhIST)
+                || IsEqualGUID(format, &GUID_MetadataFormatChunktIME);
+    if (IsEqualGUID(container, &GUID_ContainerFormatJpeg))
+        return IsEqualGUID(format, &GUID_MetadataFormatApp1);
+    return FALSE;
+}
+
+static HRESULT frame_collect_metadata(CommonEncoderFrame *This, BYTE **metadata, UINT *metadata_len)
+{
+    const GUID *container = &This->parent->encoder_info.container_format;
+    UINT i, total = 0;
+    BYTE *out, *p;
+    struct { BYTE *bytes; UINT len; } *records;
+
+    *metadata = NULL;
+    *metadata_len = 0;
+#ifdef SG_MUTANT_MDE_FRAME_IGNORES_BLOCKS
+    return S_OK;
+#endif
+    if (!This->blocks.count) return S_OK;
+
+    if (!(records = calloc(This->blocks.count, sizeof(*records)))) return E_OUTOFMEMORY;
+
+    for (i = 0; i < This->blocks.count; ++i)
+    {
+        GUID format;
+
+        if (FAILED(IWICMetadataWriter_GetMetadataFormat(This->blocks.writers[i], &format))
+                || !frame_writer_wanted(container, &format))
+            continue;
+        if (FAILED(md_writer_save_bytes(This->blocks.writers[i], &records[i].bytes, &records[i].len)))
+        {
+            WARN("Writer %u could not be saved, leaving it out.\n", i);
+            continue;
+        }
+        if (records[i].len) total += sizeof(UINT) + records[i].len;
+    }
+
+    if (total && (out = malloc(total)))
+    {
+        p = out;
+        for (i = 0; i < This->blocks.count; ++i)
+        {
+            if (!records[i].len) continue;
+            memcpy(p, &records[i].len, sizeof(UINT));
+            memcpy(p + sizeof(UINT), records[i].bytes, records[i].len);
+            p += sizeof(UINT) + records[i].len;
+        }
+        *metadata = out;
+        *metadata_len = total;
+    }
+    for (i = 0; i < This->blocks.count; ++i)
+        free(records[i].bytes);
+    free(records);
+    return total && !*metadata ? E_OUTOFMEMORY : S_OK;
+}
