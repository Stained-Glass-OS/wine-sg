+/* The chunks of the frame's metadata writers: records of a length and one PNG chunk (length, type, data, CRC). */
+static void png_encoder_set_metadata(struct png_encoder *This, const struct encoder_frame *frame)
+{
+    const BYTE *p = frame->metadata, *end = p + frame->metadata_len;
+    UINT num_colors = frame->num_colors;
+
+    /* values libpng finds wrong are left out with a warning, they are not worth the whole image */
+    png_set_benign_errors(This->png_ptr, 1);
+
+    while (frame->metadata && end - p > (int)sizeof(UINT))
+    {
+        UINT len, size;
+        const BYTE *chunk, *data;
+
+        memcpy(&len, p, sizeof(len));
+        p += sizeof(len);
+        if (len < 12 || len > end - p) break;
+        chunk = p;
+        p += len;
+
+        size = (chunk[0] << 24) | (chunk[1] << 16) | (chunk[2] << 8) | chunk[3];
+        if (size + 12 > len) continue;
+        data = chunk + 8;
+
+        if (!memcmp(chunk + 4, "tEXt", 4))
+        {
+            const BYTE *nul = memchr(data, 0, size);
+            png_text text;
+            char *key, *value;
+
+            if (!nul) continue;
+            if (!(key = malloc(size + 1))) continue;
+            memcpy(key, data, size);
+            key[size] = 0;
+            value = key + (nul - data) + 1;
+            memset(&text, 0, sizeof(text));
+            text.compression = PNG_TEXT_COMPRESSION_NONE;
+            text.key = key;
+            text.text = value;
+            text.text_length = size - (nul - data) - 1;
+            png_set_text(This->png_ptr, This->info_ptr, &text, 1);
+            free(key);
+        }
+        else if (!memcmp(chunk + 4, "gAMA", 4) && size == 4)
+        {
+            png_set_gAMA_fixed(This->png_ptr, This->info_ptr,
+                    (data[0] << 24) | (data[1] << 16) | (data[2] << 8) | data[3]);
+        }
+        else if (!memcmp(chunk + 4, "cHRM", 4) && size == 32)
+        {
+            png_fixed_point v[8];
+            int i;
+
+            for (i = 0; i < 8; ++i)
+                v[i] = (data[i * 4] << 24) | (data[i * 4 + 1] << 16) | (data[i * 4 + 2] << 8) | data[i * 4 + 3];
+            png_set_cHRM_fixed(This->png_ptr, This->info_ptr, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+        }
+        else if (!memcmp(chunk + 4, "tIME", 4) && size == 7)
+        {
+            png_time time;
+
+            time.year = (data[0] << 8) | data[1];
+            time.month = data[2];
+            time.day = data[3];
+            time.hour = data[4];
+            time.minute = data[5];
+            time.second = data[6];
+            png_set_tIME(This->png_ptr, This->info_ptr, &time);
+        }
+        else if (!memcmp(chunk + 4, "hIST", 4) && This->format->color_type == PNG_COLOR_TYPE_PALETTE
+                && size == 2 * min(num_colors, 1u << This->format->bit_depth))
+        {
+            png_uint_16 hist[256];
+            UINT i;
+
+            for (i = 0; i < size / 2; ++i)
+                hist[i] = (data[i * 2] << 8) | data[i * 2 + 1];
+            png_set_hIST(This->png_ptr, This->info_ptr, hist);
+        }
+    }
+
+    png_set_benign_errors(This->png_ptr, 0);
+}
