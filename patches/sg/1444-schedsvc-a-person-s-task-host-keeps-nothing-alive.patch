From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] schedsvc: a person's task host keeps nothing alive

The host of a person's scheduled tasks (1173), started by the shell at each
sign-in, was an ordinary program with a window that never ends. While it
ran, the shell's desktop never closed and "wineserver -w" never returned:
a script that starts Wine and waits for it to finish (a prefix's first
start, an installer wrapper, sg-shell's start-check, which hung 25 minutes)
waited forever, and a session's Wine never went away on its own.

The host is now a system process, like the Task Scheduler service it
stands for: it holds neither the desktop nor the wineserver, and it ends
when the person's last program does. The tasks it starts are ordinary
programs of the person's, as before.

Test: test/taskhost-gate.sh (mutant SG_MUTANT_TASKHOST_KEEPS_SESSION in
taskrun.c fails it); test/taskrun-gate.sh and test/logoff-gate.sh pass.
---
--- a/dlls/schedsvc/Makefile.in
+++ b/dlls/schedsvc/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = schedsvc.dll
-IMPORTS   = rpcrt4 advapi32 ole32 xmllite
+IMPORTS   = rpcrt4 advapi32 ole32 xmllite ntdll
 DELAYIMPORTS = user32
 
 SOURCES = \
--- a/dlls/schedsvc/taskrun.c
+++ b/dlls/schedsvc/taskrun.c
@@ -49,11 +49,14 @@
 #include <stdarg.h>
 
 #define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
 
 #include "windef.h"
 #include "winbase.h"
 #include "winreg.h"
 #include "winuser.h"
+#include "winternl.h"
 #include "sddl.h"
 #include "objbase.h"
 #include "xmllite.h"
@@ -1281,10 +1284,18 @@
      * the host's own that answers the session's end. */
     {
         WNDCLASSW wc = {0};
-        HANDLE thread;
+        HANDLE thread, session_end = NULL;
         MSG msg;
 
         if (hwnd) DestroyWindow(hwnd);
+#ifndef SG_MUTANT_TASKHOST_KEEPS_SESSION
+        /* Like the service it stands for, the host is a system process: it
+         * keeps neither the desktop nor the wineserver alive (a script's
+         * "wineserver -w", a prefix's first start, waited on it forever; the
+         * desktop never closed), and it ends when the person's last program
+         * does. The tasks it starts are the person's programs as any. */
+        NtSetInformationProcess(GetCurrentProcess(), ProcessWineMakeProcessSystem, &session_end, sizeof(HANDLE *));
+#endif
         if ((thread = CreateThread(NULL, 0, scheduler_proc, never, 0, NULL)))
         {
             CloseHandle(thread);
@@ -1293,12 +1304,21 @@
             wc.lpszClassName = L"SgUserTaskHost";
             RegisterClassW(&wc);
             CreateWindowExW(0, L"SgUserTaskHost", L"SgUserTaskHost", WS_POPUP, 0, 0, 0, 0, NULL, NULL, wc.hInstance, NULL);
-            while (GetMessageW(&msg, NULL, 0, 0) > 0)
+            for (;;)
             {
-                TranslateMessage(&msg);
-                DispatchMessageW(&msg);
+                DWORD ret = MsgWaitForMultipleObjects(session_end ? 1 : 0, &session_end, FALSE, INFINITE, QS_ALLINPUT);
+                if (session_end && ret == WAIT_OBJECT_0)
+                {
+                    TRACE("the person's last program ended\n");
+                    ExitProcess(0);
+                }
+                while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE))
+                {
+                    if (msg.message == WM_QUIT) return;
+                    TranslateMessage(&msg);
+                    DispatchMessageW(&msg);
+                }
             }
-            return;
         }
     }
 #endif
