From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sechost: SDDL object ACE strings (OA OD OU OL) (3661)

sechost: SDDL object ACE strings (OA, OD, OU, OL)

ConvertStringSecurityDescriptorToSecurityDescriptor now builds object ACEs
from the object and inherited-object GUID fields of the ACE string, and
ConvertSecurityDescriptorToStringSecurityDescriptor writes them back. A
GUID on a non-object ACE or a malformed GUID is ERROR_INVALID_ACL as before.
---
diff --git a/dlls/advapi32/tests/Makefile.in b/dlls/advapi32/tests/Makefile.in
index 766a228..fe9870a 100644
--- a/dlls/advapi32/tests/Makefile.in
+++ b/dlls/advapi32/tests/Makefile.in
@@ -14,4 +14,5 @@ SOURCES = \
 	registry.c \
 	rsrc.rc \
 	security.c \
-	service.c
+	service.c \
+	sgcalls.c
diff --git a/dlls/advapi32/tests/sgcalls.c b/dlls/advapi32/tests/sgcalls.c
new file mode 100644
index 0000000..512ee46
--- /dev/null
+++ b/dlls/advapi32/tests/sgcalls.c
@@ -0,0 +1,94 @@
+/*
+ * Stained Glass OS additions: SDDL object ACEs.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <windows.h>
+#include <sddl.h>
+#include "wine/test.h"
+
+static void test_object_aces(void)
+{
+    static const WCHAR sddl[] = L"D:(OA;;RP;bf967aba-0de6-11d0-a285-00aa003049e2;;WD)"
+        L"(OD;CI;WP;;bf967a86-0de6-11d0-a285-00aa003049e2;BA)"
+        L"(OA;;CC;bf967aba-0de6-11d0-a285-00aa003049e2;bf967a86-0de6-11d0-a285-00aa003049e2;SY)"
+        L"(OA;;DC;;;WD)(A;;LC;;;WD)";
+    static const GUID g1 = { 0xbf967aba, 0x0de6, 0x11d0, { 0xa2, 0x85, 0x00, 0xaa, 0x00, 0x30, 0x49, 0xe2 } };
+    static const GUID g2 = { 0xbf967a86, 0x0de6, 0x11d0, { 0xa2, 0x85, 0x00, 0xaa, 0x00, 0x30, 0x49, 0xe2 } };
+    PSECURITY_DESCRIPTOR sd;
+    BOOL ret, present, defaulted;
+    ACL *dacl;
+    void *ace;
+    ACE_HEADER *h;
+    DWORD sdsize, len;
+    ACCESS_ALLOWED_OBJECT_ACE *oa;
+    WCHAR *back;
+    SID *sid;
+
+    ret = ConvertStringSecurityDescriptorToSecurityDescriptorW( sddl, SDDL_REVISION_1, &sd, &sdsize );
+    ok( ret, "got error %lu\n", GetLastError() );
+    if (!ret) return;
+    ret = GetSecurityDescriptorDacl( sd, &present, &dacl, &defaulted );
+    ok( ret && present && dacl, "no DACL\n" );
+    ok( dacl->AceCount == 5, "ace count %u\n", dacl->AceCount );
+
+    ret = GetAce( dacl, 0, &ace );
+    ok( ret, "GetAce failed\n" );
+    h = ace;
+    oa = ace;
+    ok( h->AceType == ACCESS_ALLOWED_OBJECT_ACE_TYPE, "type %u\n", h->AceType );
+    ok( oa->Mask == 0x10, "mask %#lx\n", oa->Mask );
+    ok( oa->Flags == ACE_OBJECT_TYPE_PRESENT, "flags %#lx\n", oa->Flags );
+    ok( IsEqualGUID( &oa->ObjectType, &g1 ), "object type mismatch\n" );
+    ok( h->AceSize == 12 + 16 + 12, "size %u\n", h->AceSize );
+    sid = (SID *)((BYTE *)ace + 12 + 16);
+    ok( IsValidSid( sid ) && EqualSid( sid, (SID *)((BYTE *)ace + 28) ), "bad sid\n" );
+
+    GetAce( dacl, 1, &ace );
+    h = ace;
+    oa = ace;
+    ok( h->AceType == ACCESS_DENIED_OBJECT_ACE_TYPE, "type %u\n", h->AceType );
+    ok( h->AceFlags == CONTAINER_INHERIT_ACE, "ace flags %#x\n", h->AceFlags );
+    ok( oa->Flags == ACE_INHERITED_OBJECT_TYPE_PRESENT, "flags %#lx\n", oa->Flags );
+    ok( IsEqualGUID( &oa->ObjectType, &g2 ), "inherited object type mismatch\n" );
+
+    GetAce( dacl, 2, &ace );
+    oa = ace;
+    ok( oa->Flags == (ACE_OBJECT_TYPE_PRESENT | ACE_INHERITED_OBJECT_TYPE_PRESENT), "flags %#lx\n", oa->Flags );
+    ok( IsEqualGUID( &oa->ObjectType, &g1 ), "object type mismatch\n" );
+    ok( IsEqualGUID( &oa->InheritedObjectType, &g2 ), "inherited object type mismatch\n" );
+    ok( ((ACE_HEADER *)ace)->AceSize == 12 + 32 + 12, "size %u\n", ((ACE_HEADER *)ace)->AceSize );
+
+    GetAce( dacl, 3, &ace );
+    oa = ace;
+    ok( ((ACE_HEADER *)ace)->AceType == ACCESS_ALLOWED_OBJECT_ACE_TYPE && oa->Flags == 0, "no-guid object ace\n" );
+    ok( ((ACE_HEADER *)ace)->AceSize == 12 + 12, "size %u\n", ((ACE_HEADER *)ace)->AceSize );
+
+    GetAce( dacl, 4, &ace );
+    ok( ((ACE_HEADER *)ace)->AceType == ACCESS_ALLOWED_ACE_TYPE, "plain ace type\n" );
+
+    ret = ConvertSecurityDescriptorToStringSecurityDescriptorW( sd, SDDL_REVISION_1, DACL_SECURITY_INFORMATION, &back, &len );
+    ok( ret, "convert back failed %lu\n", GetLastError() );
+    if (ret)
+    {
+        ok( !wcscmp( back, sddl ), "round trip: %s\n", wine_dbgstr_w( back ) );
+        LocalFree( back );
+    }
+    LocalFree( sd );
+
+    /* an object GUID on a plain ACE, a bad GUID, a GUID that is too long */
+    ret = ConvertStringSecurityDescriptorToSecurityDescriptorW( L"D:(A;;0x10;bf967aba-0de6-11d0-a285-00aa003049e2;;WD)",
+                                                                SDDL_REVISION_1, &sd, NULL );
+    ok( !ret, "plain ACE with object GUID accepted\n" );
+    ret = ConvertStringSecurityDescriptorToSecurityDescriptorW( L"D:(OA;;0x10;not-a-guid;;WD)", SDDL_REVISION_1, &sd, NULL );
+    ok( !ret, "bad GUID accepted\n" );
+}
+
+START_TEST(sgcalls)
+{
+    test_object_aces();
+}
diff --git a/dlls/sechost/security.c b/dlls/sechost/security.c
index 90e227b..6397a2c 100644
--- a/dlls/sechost/security.c
+++ b/dlls/sechost/security.c
@@ -348,10 +348,22 @@ static inline BOOL is_object_ace(BYTE type)
     }
 }
 
+static void print_object_guid(const GUID *guid, WCHAR **pwptr, ULONG *plen)
+{
+    WCHAR buf[40];
+
+    if (!guid) return;
+    swprintf( buf, ARRAY_SIZE(buf), L"%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x", guid->Data1, guid->Data2,
+              guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4],
+              guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+    print_string( buf, -1, pwptr, plen );
+}
+
 static BOOL print_ace(void *pace, WCHAR **pwptr, ULONG *plen)
 {
     ACCESS_ALLOWED_ACE *piace; /* all the supported ACEs have the same memory layout */
     DWORD *sid_start;
+    const GUID *object_guid = NULL, *inherit_guid = NULL;
 
     piace = pace;
 
@@ -376,6 +388,20 @@ static BOOL print_ace(void *pace, WCHAR **pwptr, ULONG *plen)
         case SYSTEM_ALARM_ACE_TYPE:
             print_string(L"AL", -1, pwptr, plen);
             break;
+#ifndef SG_MUTANT_SDDL_OBJECT
+        case ACCESS_ALLOWED_OBJECT_ACE_TYPE:
+            print_string(L"OA", -1, pwptr, plen);
+            break;
+        case ACCESS_DENIED_OBJECT_ACE_TYPE:
+            print_string(L"OD", -1, pwptr, plen);
+            break;
+        case ACCESS_AUDIT_OBJECT_ACE_TYPE:
+            print_string(L"OU", -1, pwptr, plen);
+            break;
+        case ACCESS_ALARM_OBJECT_ACE_TYPE:
+            print_string(L"OL", -1, pwptr, plen);
+            break;
+#endif
     }
     print_string(L";", -1, pwptr, plen);
 
@@ -403,13 +429,19 @@ static BOOL print_ace(void *pace, WCHAR **pwptr, ULONG *plen)
 
         sid_start++; /* Flags */
         if (objace->Flags & ACE_OBJECT_TYPE_PRESENT)
+        {
+            object_guid = (const GUID *)sid_start;
             sid_start += sizeof(GUID) / sizeof(*sid_start); /* ObjectType */
+        }
         if (objace->Flags & ACE_INHERITED_OBJECT_TYPE_PRESENT)
+        {
+            inherit_guid = (const GUID *)sid_start;
             sid_start += sizeof(GUID) / sizeof(*sid_start); /* InheritedObjectType */
+        }
     }
-    /* objects not supported */
+    print_object_guid( object_guid, pwptr, plen );
     print_string(L";", -1, pwptr, plen);
-    /* objects not supported */
+    print_object_guid( inherit_guid, pwptr, plen );
     print_string(L";", -1, pwptr, plen);
     if (!print_sid(sid_start, pwptr, plen))
         return FALSE;
@@ -842,12 +874,12 @@ static BYTE parse_ace_type( const WCHAR **string_ptr )
         { L"A",  ACCESS_ALLOWED_ACE_TYPE },
         { L"D",  ACCESS_DENIED_ACE_TYPE },
         { L"ML", SYSTEM_MANDATORY_LABEL_ACE_TYPE },
-        /*
-        { ACCESS_ALLOWED_OBJECT_ACE_TYPE },
-        { ACCESS_DENIED_OBJECT_ACE_TYPE },
-        { SYSTEM_ALARM_OBJECT_ACE_TYPE },
-        { SYSTEM_AUDIT_OBJECT_ACE_TYPE },
-        */
+#ifndef SG_MUTANT_SDDL_OBJECT
+        { L"OA", ACCESS_ALLOWED_OBJECT_ACE_TYPE },
+        { L"OD", ACCESS_DENIED_OBJECT_ACE_TYPE },
+        { L"OU", ACCESS_AUDIT_OBJECT_ACE_TYPE },
+        { L"OL", ACCESS_ALARM_OBJECT_ACE_TYPE },
+#endif
     };
 
     const WCHAR *string = *string_ptr;
@@ -961,12 +993,12 @@ static BOOL parse_acl( const WCHAR *string, DWORD *flags, ACL *acl, DWORD *ret_s
     DWORD length = sizeof(ACL);
     DWORD acesize = 0;
     DWORD acecount = 0;
-    ACCESS_ALLOWED_ACE *ace = NULL; /* pointer to current ACE */
+    BYTE *ace = NULL; /* pointer to current ACE */
 
     TRACE("%s\n", debugstr_w(string));
 
     if (acl) /* ace is only useful if we're setting values */
-        ace = (ACCESS_ALLOWED_ACE *)(acl + 1);
+        ace = (BYTE *)(acl + 1);
 
     /* Parse ACL flags */
     *flags = parse_acl_flags( &string );
@@ -974,12 +1006,20 @@ static BOOL parse_acl( const WCHAR *string, DWORD *flags, ACL *acl, DWORD *ret_s
     /* Parse ACE */
     while (*string == '(')
     {
+        ACE_HEADER *hdr = (ACE_HEADER *)ace;
+        GUID guids[2];
+        DWORD oflags = 0, offset;
+        BOOL object;
+        int k;
+
         string++;
 
         /* Parse ACE type */
         val = parse_ace_type( &string );
         if (ace)
-            ace->Header.AceType = val;
+            hdr->AceType = val;
+        object = val == ACCESS_ALLOWED_OBJECT_ACE_TYPE || val == ACCESS_DENIED_OBJECT_ACE_TYPE ||
+                 val == ACCESS_AUDIT_OBJECT_ACE_TYPE || val == ACCESS_ALARM_OBJECT_ACE_TYPE;
         if (*string != ';')
         {
             SetLastError( RPC_S_INVALID_STRING_UUID );
@@ -990,7 +1030,7 @@ static BOOL parse_acl( const WCHAR *string, DWORD *flags, ACL *acl, DWORD *ret_s
         /* Parse ACE flags */
         val = parse_ace_flags( &string );
         if (ace)
-            ace->Header.AceFlags = val;
+            hdr->AceFlags = val;
         if (*string != ';')
             goto err;
         string++;
@@ -998,33 +1038,48 @@ static BOOL parse_acl( const WCHAR *string, DWORD *flags, ACL *acl, DWORD *ret_s
         /* Parse ACE rights */
         val = parse_ace_rights( &string );
         if (ace)
-            ace->Mask = val;
+            ((ACCESS_ALLOWED_ACE *)ace)->Mask = val;
         if (*string != ';')
             goto err;
         string++;
 
-        /* Parse ACE object guid */
-        while (*string == ' ')
-            string++;
-        if (*string != ';')
+        /* Parse ACE object guid, then ACE inherit object guid */
+        for (k = 0; k < 2; k++)
         {
-            FIXME("Support for *_OBJECT_ACE_TYPE not implemented\n");
-            goto err;
+            while (*string == ' ')
+                string++;
+            if (*string != ';')
+            {
+                WCHAR buf[40];
+                const WCHAR *end = wcschr( string, ';' );
+
+                if (!object || !end || end - string >= ARRAY_SIZE(buf)) goto err;
+                memcpy( buf, string, (end - string) * sizeof(WCHAR) );
+                buf[end - string] = 0;
+                if (UuidFromStringW( buf, &guids[k] )) goto err;
+                oflags |= k ? ACE_INHERITED_OBJECT_TYPE_PRESENT : ACE_OBJECT_TYPE_PRESENT;
+                string = end;
+            }
+            string++;
         }
-        string++;
 
-        /* Parse ACE inherit object guid */
-        while (*string == ' ')
-            string++;
-        if (*string != ';')
+        if (object)
         {
-            FIXME("Support for *_OBJECT_ACE_TYPE not implemented\n");
-            goto err;
+            offset = 12 + ((oflags & ACE_OBJECT_TYPE_PRESENT) ? sizeof(GUID) : 0)
+                        + ((oflags & ACE_INHERITED_OBJECT_TYPE_PRESENT) ? sizeof(GUID) : 0);
+            if (ace)
+            {
+                BYTE *p = ace + 12;
+
+                *(DWORD *)(ace + 8) = oflags;
+                if (oflags & ACE_OBJECT_TYPE_PRESENT) { memcpy( p, &guids[0], sizeof(GUID) ); p += sizeof(GUID); }
+                if (oflags & ACE_INHERITED_OBJECT_TYPE_PRESENT) memcpy( p, &guids[1], sizeof(GUID) );
+            }
         }
-        string++;
+        else offset = FIELD_OFFSET( ACCESS_ALLOWED_ACE, SidStart );
 
         /* Parse ACE account sid */
-        if (!parse_sid( string, &string, ace ? (SID *)&ace->SidStart : NULL, &sidlen ))
+        if (!parse_sid( string, &string, ace ? (SID *)(ace + offset) : NULL, &sidlen ))
             goto err;
 
         while (*string == ' ')
@@ -1034,12 +1089,12 @@ static BOOL parse_acl( const WCHAR *string, DWORD *flags, ACL *acl, DWORD *ret_s
             goto err;
         string++;
 
-        acesize = sizeof(ACCESS_ALLOWED_ACE) - sizeof(DWORD) + sidlen;
+        acesize = offset + sidlen;
         length += acesize;
         if (ace)
         {
-            ace->Header.AceSize = acesize;
-            ace = (ACCESS_ALLOWED_ACE *)((BYTE *)ace + acesize);
+            hdr->AceSize = acesize;
+            ace += acesize;
         }
         acecount++;
     }
