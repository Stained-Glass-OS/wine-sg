From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32: schannel supported algorithms, certificate without a key, cipher suite number, key exchange group, endpoint binding hash

Ground truth from Wine's schannel test (9 todo_wine marks removed): QueryCredentialsAttributes SECPKG_ATTR_SUPPORTED_ALGS lists the algorithms; a good certificate that names no private key makes AcquireCredentialsHandle fail with SEC_E_NO_CREDENTIALS (a bogus one stays SEC_E_UNKNOWN_CREDENTIALS); SECPKG_ATTR_CIPHER_INFO gives the IANA cipher suite number (0xc02c ...) and the key exchange group (0x17, 0x1d ...); the endpoint binding hash follows the certificate's signature hash also when only CNG names it (ECDSA with SHA-384 binds with SHA-384).
---
--- a/dlls/secur32/schannel.c
+++ b/dlls/secur32/schannel.c
@@ -18,6 +18,7 @@
  * This file implements the schannel provider, or, the SSL/TLS implementations.
  */
 
+#define CRYPT_OID_INFO_HAS_EXTRA_FIELDS
 #include <assert.h>
 #include <stdarg.h>
 #include <stdlib.h>
@@ -284,9 +285,29 @@ static SECURITY_STATUS schan_QueryCredentialsAttributes(
     case SECPKG_ATTR_SUPPORTED_ALGS:
         if (pBuffer)
         {
-            /* FIXME: get from CryptoAPI */
-            FIXME("SECPKG_ATTR_SUPPORTED_ALGS: stub\n");
-            ret = SEC_E_UNSUPPORTED_FUNCTION;
+            /* what the TLS stack underneath offers, as CryptoAPI algorithm ids */
+            static const ALG_ID algs[] =
+            {
+                CALG_RSA_SIGN, CALG_RSA_KEYX, CALG_DSS_SIGN, CALG_ECDSA, CALG_DH_EPHEM, CALG_ECDH_EPHEM,
+                CALG_AES_128, CALG_AES_256, CALG_3DES, CALG_RC4,
+                CALG_MD5, CALG_SHA1, CALG_SHA_256, CALG_SHA_384, CALG_SHA_512,
+            };
+            SecPkgCred_SupportedAlgs *out = pBuffer;
+            ALG_ID *list;
+
+#ifdef SG_MUTANT_SCH_NO_ALGS
+            return SEC_E_UNSUPPORTED_FUNCTION;
+#endif
+
+            /* freed with FreeContextBuffer */
+            if (!(list = RtlAllocateHeap(GetProcessHeap(), 0, sizeof(algs)))) ret = SEC_E_INSUFFICIENT_MEMORY;
+            else
+            {
+                memcpy(list, algs, sizeof(algs));
+                out->cSupportedAlgs = ARRAY_SIZE(algs);
+                out->palgSupportedAlgs = list;
+                ret = SEC_E_OK;
+            }
         }
         else
             ret = SEC_E_INTERNAL_ERROR;
@@ -361,6 +382,9 @@ static SECURITY_STATUS SEC_ENTRY schan_QueryCredentialsAttributesW(
     return ret;
 }
 
+/* get_cert's own status: the certificate is fine and has no private key (SEC_E_NO_CREDENTIALS to the caller) */
+#define SEC_E_NO_CREDENTIALS_KEY 0xdeadc0de
+
 static SECURITY_STATUS get_cert(const void *credentials, CERT_CONTEXT const **cert)
 {
     SECURITY_STATUS status;
@@ -431,7 +455,16 @@ static SECURITY_STATUS get_cert(const void *credentials, CERT_CONTEXT const **ce
             *cert = cert_list[0];
             status = SEC_E_OK;
         }
-        else status = SEC_E_UNKNOWN_CREDENTIALS;
+        else if (cert_list[0]->pCertInfo->SubjectPublicKeyInfo.PublicKey.cbData &&
+                 !CertGetCertificateContextProperty(cert_list[0], CERT_KEY_PROV_INFO_PROP_ID, NULL, &spec) &&
+                 !CertGetCertificateContextProperty(cert_list[0], CERT_KEY_CONTEXT_PROP_ID, NULL, &spec))
+#ifdef SG_MUTANT_SCH_NO_KEYCRED
+            status = SEC_E_UNKNOWN_CREDENTIALS;
+#else
+            status = SEC_E_NO_CREDENTIALS_KEY;   /* a good certificate that names no private key at all */
+#endif
+        else
+            status = SEC_E_UNKNOWN_CREDENTIALS;
     }
 
     return status;
@@ -581,6 +614,7 @@ static SECURITY_STATUS acquire_credentials_handle(ULONG fCredentialUse,
         const unsigned non_dtls_protocols = (SP_PROT_X_CLIENTS | SP_PROT_X_SERVERS) & ~SP_PROT_DTLS1_X;
 
         status = get_cert(schanCred, &cert);
+        if (status == SEC_E_NO_CREDENTIALS_KEY) return SEC_E_NO_CREDENTIALS;
         if (status != SEC_E_OK && status != SEC_E_NO_CREDENTIALS)
             return status;
 
@@ -1250,7 +1284,16 @@ static SECURITY_STATUS SEC_ENTRY schan_QueryContextAttributesW(
 
         /* RFC 5929 */
         info = CryptFindOIDInfo(CRYPT_OID_INFO_OID_KEY, ctx->cert->pCertInfo->SignatureAlgorithm.pszObjId, 0);
-        if (info && info->Algid != CALG_SHA1 && info->Algid != CALG_MD5) hash_alg = info->Algid;
+        if (info && info->Algid != CALG_SHA1 && info->Algid != CALG_MD5)
+        {
+            /* ECDSA and some others name the hash only through CNG */
+            if (info->Algid == CALG_OID_INFO_CNG_ONLY || info->Algid == CALG_OID_INFO_PARAMETERS)
+            {
+                if (info->pwszCNGAlgid && !wcsicmp( info->pwszCNGAlgid, L"SHA384" )) hash_alg = CALG_SHA_384;
+                else if (info->pwszCNGAlgid && !wcsicmp( info->pwszCNGAlgid, L"SHA512" )) hash_alg = CALG_SHA_512;
+            }
+            else hash_alg = info->Algid;
+        }
 
         hash_size = sizeof(hash);
         ret = CryptHashCertificate(0, hash_alg, 0, ctx->cert->pbCertEncoded, ctx->cert->cbCertEncoded, hash, &hash_size);
--- a/dlls/secur32/schannel_gnutls.c
+++ b/dlls/secur32/schannel_gnutls.c
@@ -91,9 +91,11 @@ MAKE_FUNCPTR(gnutls_certificate_get_peers);
 MAKE_FUNCPTR(gnutls_certificate_set_x509_key);
 MAKE_FUNCPTR(gnutls_cipher_get);
 MAKE_FUNCPTR(gnutls_cipher_get_key_size);
+MAKE_FUNCPTR(gnutls_cipher_suite_info);
 MAKE_FUNCPTR(gnutls_credentials_set);
 MAKE_FUNCPTR(gnutls_deinit);
 MAKE_FUNCPTR(gnutls_global_deinit);
+MAKE_FUNCPTR(gnutls_group_get);
 MAKE_FUNCPTR(gnutls_global_init);
 MAKE_FUNCPTR(gnutls_global_set_log_function);
 MAKE_FUNCPTR(gnutls_global_set_log_level);
@@ -999,6 +1001,49 @@ static const WCHAR *get_chaining_mode_str( gnutls_session_t session )
     }
 }
 
+/* the IANA number of the named group of the key exchange (0x1d x25519, 0x17 secp256r1), 0 for none */
+static DWORD get_group_id( gnutls_session_t session )
+{
+    switch (pgnutls_group_get( session ))
+    {
+    case GNUTLS_GROUP_SECP192R1: return 0x13;
+    case GNUTLS_GROUP_SECP224R1: return 0x15;
+    case GNUTLS_GROUP_SECP256R1: return 0x17;
+    case GNUTLS_GROUP_SECP384R1: return 0x18;
+    case GNUTLS_GROUP_SECP521R1: return 0x19;
+    case GNUTLS_GROUP_X25519:    return 0x1d;
+    case GNUTLS_GROUP_X448:      return 0x1e;
+    case GNUTLS_GROUP_FFDHE2048: return 0x100;
+    case GNUTLS_GROUP_FFDHE3072: return 0x101;
+    case GNUTLS_GROUP_FFDHE4096: return 0x102;
+    case GNUTLS_GROUP_FFDHE6144: return 0x103;
+    case GNUTLS_GROUP_FFDHE8192: return 0x104;
+    default: return 0;
+    }
+}
+
+/* the IANA number of the negotiated cipher suite, e.g. 0xc02c for TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 */
+static DWORD get_cipher_suite_id( gnutls_session_t session )
+{
+    gnutls_kx_algorithm_t kx = pgnutls_kx_get( session );
+    gnutls_cipher_algorithm_t cipher = pgnutls_cipher_get( session );
+    gnutls_mac_algorithm_t mac = pgnutls_mac_get( session );
+    unsigned char id[2];
+    size_t i;
+
+    for (i = 0; ; i++)
+    {
+        gnutls_kx_algorithm_t k;
+        gnutls_cipher_algorithm_t c;
+        gnutls_mac_algorithm_t m;
+        gnutls_protocol_t min;
+
+        if (!pgnutls_cipher_suite_info( i, id, &k, &c, &m, &min )) break;
+        if (k == kx && c == cipher && m == mac) return (id[0] << 8) | id[1];
+    }
+    return 0;
+}
+
 static NTSTATUS schan_get_cipher_info( void *args )
 {
     static const WCHAR tlsW[] = {'T','L','S','_',0};
@@ -1014,8 +1059,12 @@ static NTSTATUS schan_get_cipher_info( void *args )
     int len;
 
     info->dwProtocol = get_protocol_version( session );
-    info->dwCipherSuite = 0; /* FIXME */
-    info->dwBaseCipherSuite = 0; /* FIXME */
+#ifdef SG_MUTANT_SCH_SUITE
+    info->dwCipherSuite = 0;
+#else
+    info->dwCipherSuite = get_cipher_suite_id( session );
+#endif
+    info->dwBaseCipherSuite = info->dwCipherSuite;
     wcscpy( info->szCipher, get_cipher_str( session ) );
     info->dwCipherLen = get_cipher_len( session );
     info->dwCipherBlockLen = get_cipher_block_len( session );
@@ -1025,7 +1074,7 @@ static NTSTATUS schan_get_cipher_info( void *args )
     info->dwMinExchangeLen = 0;
     info->dwMaxExchangeLen = 65536;
     wcscpy( info->szCertificate, get_certificate_str( session ) );
-    info->dwKeyType = 0; /* FIXME */
+    info->dwKeyType = get_group_id( session );
 
     wcscpy( info->szCipherSuite, tlsW );
     wcscat( info->szCipherSuite, get_exchange_str( session, TRUE ) );
@@ -1507,9 +1556,11 @@ static NTSTATUS process_attach( void *args )
     LOAD_FUNCPTR(gnutls_certificate_set_x509_key)
     LOAD_FUNCPTR(gnutls_cipher_get)
     LOAD_FUNCPTR(gnutls_cipher_get_key_size)
+    LOAD_FUNCPTR(gnutls_cipher_suite_info)
     LOAD_FUNCPTR(gnutls_credentials_set)
     LOAD_FUNCPTR(gnutls_deinit)
     LOAD_FUNCPTR(gnutls_global_deinit)
+    LOAD_FUNCPTR(gnutls_group_get)
     LOAD_FUNCPTR(gnutls_global_init)
     LOAD_FUNCPTR(gnutls_global_set_log_function)
     LOAD_FUNCPTR(gnutls_global_set_log_level)
--- a/dlls/secur32/tests/schannel.c
+++ b/dlls/secur32/tests/schannel.c
@@ -217,7 +217,7 @@ static void test_supported_algs(CredHandle *handle)
     unsigned i;
 
     status = QueryCredentialsAttributesA(handle, SECPKG_ATTR_SUPPORTED_ALGS, &algs);
-    todo_wine ok(status == SEC_E_OK, "QueryCredentialsAttributes failed: %08lx\n", status);
+    ok(status == SEC_E_OK, "QueryCredentialsAttributes failed: %08lx\n", status);
     if(status != SEC_E_OK)
         return;
 
@@ -407,10 +407,10 @@ static void testAcquireSecurityContext(void)
     schanCred.paCred = &certs[1];
     st = AcquireCredentialsHandleA(NULL, unisp_name_a, SECPKG_CRED_OUTBOUND,
      NULL, &schanCred, NULL, NULL, &cred, NULL);
-    todo_wine ok(st == SEC_E_NO_CREDENTIALS, "Expected SEC_E_NO_CREDENTIALS, got %08lx\n", st);
+    ok(st == SEC_E_NO_CREDENTIALS, "Expected SEC_E_NO_CREDENTIALS, got %08lx\n", st);
     st = AcquireCredentialsHandleA(NULL, unisp_name_a, SECPKG_CRED_INBOUND,
      NULL, &schanCred, NULL, NULL, NULL, NULL);
-    todo_wine ok(st == SEC_E_NO_CREDENTIALS, "Expected SEC_E_NO_CREDENTIALS, got %08lx\n", st);
+    ok(st == SEC_E_NO_CREDENTIALS, "Expected SEC_E_NO_CREDENTIALS, got %08lx\n", st);
 
     /* Good cert, with CRYPT_KEY_PROV_INFO set before it's had a key loaded. */
     ret = CertSetCertificateContextProperty(certs[1],
@@ -1203,7 +1203,6 @@ static void test_communication(void)
         test_remote_cert(cert);
 
         status = QueryContextAttributesA(&context, SECPKG_ATTR_ENDPOINT_BINDINGS, &bindings);
-        todo_wine
         ok(status == SEC_E_OK, "QueryContextAttributesW(SECPKG_ATTR_ENDPOINT_BINDINGS) failed: %08lx\n", status);
         if (status == SEC_E_OK)
         {
@@ -1276,10 +1275,8 @@ static void test_communication(void)
     if (status == SEC_E_OK)
     {
         ok(cipher.dwProtocol == 0x303, "got %lx\n", cipher.dwProtocol);
-        todo_wine
         ok(cipher.dwCipherSuite == 0xc02c || broken(cipher.dwCipherSuite == 0x9f) /* <= win8 */,
            "got %lx\n", cipher.dwCipherSuite);
-        todo_wine
         ok(cipher.dwBaseCipherSuite == 0xc02c || broken(cipher.dwCipherSuite == 0x9f) /* <= win8 */,
            "got %lx\n", cipher.dwBaseCipherSuite);
         ok(!wcscmp(cipher.szCipherSuite, L"TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384") ||
@@ -1297,7 +1294,6 @@ static void test_communication(void)
         ok(cipher.dwMaxExchangeLen == 65536 || cipher.dwMaxExchangeLen == 256 /* < win10 */ ||
            cipher.dwMinExchangeLen == 384 /* <= win8 */, "got %lu\n", cipher.dwMaxExchangeLen);
         ok(!wcscmp(cipher.szCertificate, L"ECDSA"), "got %s\n", wine_dbgstr_w(cipher.szCertificate));
-        todo_wine
         ok(cipher.dwKeyType == 0x1d || cipher.dwKeyType == 0x17 || cipher.dwKeyType == 0x18 /* < win10 */ ||
            broken(!cipher.dwKeyType) /* <= win8 */, "got %#lx\n", cipher.dwKeyType);
     }
