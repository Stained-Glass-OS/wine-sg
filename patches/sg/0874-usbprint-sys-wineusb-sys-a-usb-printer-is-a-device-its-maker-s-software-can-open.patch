+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winioctl.h"
+#include "ddk/wdm.h"
+#include "ddk/usb.h"
+#include "ddk/usbioctl.h"
+#include "ddk/usbdlib.h"
+#include "initguid.h"
+#include "wine/asm.h"
+#include "wine/debug.h"
+#include <stdio.h>
+#include <string.h>
+
+WINE_DEFAULT_DEBUG_CHANNEL(usbprint);
+
+#ifdef __ASM_USE_FASTCALL_WRAPPER
+extern void * WINAPI wrap_fastcall_func1( void *func, const void *a );
+__ASM_STDCALL_FUNC( wrap_fastcall_func1, 8,
+                   "popl %ecx\n\t"
+                   "popl %eax\n\t"
+                   "xchgl (%esp),%ecx\n\t"
+                   "jmp *%eax" );
+#define call_fastcall_func1(func,a) wrap_fastcall_func1(func,a)
+#else
+#define call_fastcall_func1(func,a) func(a)
+#endif
+
+DEFINE_GUID( GUID_DEVINTERFACE_USBPRINT, 0x28d78fad, 0x5a12, 0x11d1, 0xae, 0x5b, 0x00, 0x00, 0xf8, 0x03, 0xa8, 0xc2 );
+
+/* usbprint.h */
+#define USBPRINT_IOCTL(n) CTL_CODE( FILE_DEVICE_UNKNOWN, (n), METHOD_BUFFERED, FILE_ANY_ACCESS )
+#define IOCTL_USBPRINT_GET_LPT_STATUS       USBPRINT_IOCTL(12)
+#define IOCTL_USBPRINT_GET_1284_ID          USBPRINT_IOCTL(13)
+#define IOCTL_USBPRINT_VENDOR_SET_COMMAND   USBPRINT_IOCTL(14)
+#define IOCTL_USBPRINT_VENDOR_GET_COMMAND   USBPRINT_IOCTL(15)
+#define IOCTL_USBPRINT_SOFT_RESET           USBPRINT_IOCTL(16)
+#define IOCTL_USBPRINT_GET_PROTOCOL         USBPRINT_IOCTL(17)
+#define IOCTL_USBPRINT_SET_PROTOCOL         USBPRINT_IOCTL(18)
+#define IOCTL_USBPRINT_GET_INTERFACE_TYPE   USBPRINT_IOCTL(19)
+
+/* the printer class's requests (USB Device Class Definition for Printing Devices 1.1) */
+#define PRINTER_GET_DEVICE_ID  0
+#define PRINTER_GET_PORT_STATUS 1
+#define PRINTER_SOFT_RESET     2
+
+#define READ_TIMEOUT_MS  5000
+#define WRITE_TIMEOUT_MS 30000
+
+/* the printer device usbprint makes for the printer (USBPRINT\<model>), whose
+ * class is Printer: a program finds the printer among the Printer class's
+ * devices (DYMO Connect: "printerDevice lookup failure ... seems like not
+ * enumerated as printer" without it) */
+struct child
+{
+    BOOL is_child;          /* first, as in struct printer */
+    struct printer *printer;
+    WCHAR hardware_id[96];  /* USBPRINT\<MFG><MDL>XXXX */
+    WCHAR plain_id[96];     /* USBPRINT\<MFG><MDL> */
+    WCHAR instance_id[64];
+    WCHAR description[128];
+    BOOL removed;
+};
+
+struct printer
+{
+    BOOL is_child;
+    DEVICE_OBJECT *fdo, *pdo, *next, *child;
+    UNICODE_STRING iface;
+    BOOL started;
+    USB_DEVICE_DESCRIPTOR device_desc;
+    UCHAR interface_number, alternate_setting, protocol;
+    USBD_PIPE_HANDLE bulk_in, bulk_out;
+    LONG opened;
+};
+
+static NTSTATUS WINAPI sync_completion( DEVICE_OBJECT *device, IRP *irp, void *context )
+{
+    if (irp->PendingReturned) KeSetEvent( context, IO_NO_INCREMENT, FALSE );
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static NTSTATUS submit_urb( struct printer *printer, URB *urb, ULONG timeout );
+
+/* the transfers outstanding on a pipe ended (wineusb cancels them) */
+static void abort_pipe( struct printer *printer, USBD_PIPE_HANDLE pipe )
+{
+    struct _URB_PIPE_REQUEST urb = {{0}};
+
+    urb.Hdr.Function = URB_FUNCTION_ABORT_PIPE;
+    urb.Hdr.Length = sizeof(urb);
+    urb.PipeHandle = pipe;
+    submit_urb( printer, (URB *)&urb, 0 );
+}
+
+/* an URB to the USB device, waited for at most TIMEOUT ms (0: no limit):
+ * then the transfer is aborted and the result is STATUS_IO_TIMEOUT */
+static NTSTATUS submit_urb( struct printer *printer, URB *urb, ULONG timeout )
+{
+    BOOL timed_out = FALSE;
+    IO_STACK_LOCATION *stack;
+    LARGE_INTEGER wait;
+    NTSTATUS status;
+    KEVENT event;
+    IRP *irp;
+
+    if (!(irp = IoAllocateIrp( printer->next->StackSize, FALSE ))) return STATUS_NO_MEMORY;
+    KeInitializeEvent( &event, NotificationEvent, FALSE );
+    stack = IoGetNextIrpStackLocation( irp );
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = urb;
+    IoSetCompletionRoutine( irp, sync_completion, &event, TRUE, TRUE, TRUE );
+    if (IoCallDriver( printer->next, irp ) == STATUS_PENDING)
+    {
+        wait.QuadPart = -(LONGLONG)timeout * 10000;
+        if (KeWaitForSingleObject( &event, Executive, KernelMode, FALSE, timeout ? &wait : NULL ) == STATUS_TIMEOUT)
+        {
+            TRACE( "urb %#x timed out after %lu ms\n", urb->UrbHeader.Function, timeout );
+            timed_out = TRUE;
+            abort_pipe( printer, urb->UrbHeader.Function == URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER
+                        ? urb->UrbBulkOrInterruptTransfer.PipeHandle : NULL );
+            KeWaitForSingleObject( &event, Executive, KernelMode, FALSE, NULL );
+        }
+    }
+    status = irp->IoStatus.Status;
+    IoFreeIrp( irp );
+    if (timed_out) return STATUS_IO_TIMEOUT;
+    if (!status && !USBD_SUCCESS( urb->UrbHeader.Status )) status = STATUS_UNSUCCESSFUL;
+    return status;
+}
+
+static NTSTATUS get_descriptor( struct printer *printer, UCHAR type, void *buffer, ULONG *length )
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST urb = {{0}};
+    NTSTATUS status;
+
+    urb.Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    urb.Hdr.Length = sizeof(urb);
+    urb.DescriptorType = type;
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = *length;
+    if (!(status = submit_urb( printer, (URB *)&urb, 0 ))) *length = urb.TransferBufferLength;
+    return status;
+}
+
+/* a class or vendor request to the printer's interface */
+static NTSTATUS interface_request( struct printer *printer, USHORT function, BOOL in, UCHAR request,
+                                   USHORT value, USHORT index, void *buffer, ULONG *length )
+{
+    struct _URB_CONTROL_VENDOR_OR_CLASS_REQUEST urb = {{0}};
+    NTSTATUS status;
+
+    urb.Hdr.Function = function;
+    urb.Hdr.Length = sizeof(urb);
+    urb.TransferFlags = in ? USBD_TRANSFER_DIRECTION_IN : 0;
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = *length;
+    urb.Request = request;
+    urb.Value = value;
+    urb.Index = index;
+    if (!(status = submit_urb( printer, (URB *)&urb, READ_TIMEOUT_MS ))) *length = urb.TransferBufferLength;
+    TRACE( "request %#x/%u value %#x index %#x: %#lx, %lu bytes\n", function, request, value, index, status, *length );
+    return status;
+}
+
+static NTSTATUS bulk_transfer( struct printer *printer, BOOL in, void *buffer, ULONG *length )
+{
+    struct _URB_BULK_OR_INTERRUPT_TRANSFER urb = {{0}};
+    NTSTATUS status;
+
+    if (!(in ? printer->bulk_in : printer->bulk_out)) return STATUS_INVALID_DEVICE_REQUEST;
+    urb.Hdr.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+    urb.Hdr.Length = sizeof(urb);
+    urb.PipeHandle = in ? printer->bulk_in : printer->bulk_out;
+    urb.TransferFlags = in ? USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK : 0;
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = *length;
+    status = submit_urb( printer, (URB *)&urb, in ? READ_TIMEOUT_MS : WRITE_TIMEOUT_MS );
+    *length = status ? 0 : urb.TransferBufferLength;
+    TRACE( "%s %lu bytes: %#lx\n", in ? "read" : "wrote", *length, status );
+    /* nothing to read within the time: no data, as usbprint answers */
+    if (in && status == STATUS_IO_TIMEOUT) status = STATUS_SUCCESS;
+    return status;
+}
+
+/* the interface given back (wineusb releases it; the kernel's usblp takes it again) */
+static void release_interface( struct printer *printer )
+{
+    struct _URB_SELECT_CONFIGURATION urb = {{0}};
+
+    urb.Hdr.Function = URB_FUNCTION_SELECT_CONFIGURATION;
+    urb.Hdr.Length = sizeof(urb);
+    urb.ConfigurationDescriptor = NULL;
+    submit_urb( printer, (URB *)&urb, 0 );
+}
+
+/* a field of an IEEE 1284 device ID ("MFG:DYMO;MDL:LabelWriter 550;..."), or "" */
+static void id_field( const char *id, const char *key, const char *alt, char *out, size_t size )
+{
+    const char *p = id;
+
+    out[0] = 0;
+    while (p && *p)
+    {
+        size_t klen = strlen( key ), alen = alt ? strlen( alt ) : 0;
+        const char *v = NULL, *end;
+
+        while (*p == ' ') p++;
+        if (!_strnicmp( p, key, klen ) && p[klen] == ':') v = p + klen + 1;
+        else if (alt && !_strnicmp( p, alt, alen ) && p[alen] == ':') v = p + alen + 1;
+        if (v)
+        {
+            size_t n;
+            if (!(end = strchr( v, ';' ))) end = v + strlen( v );
+            n = min( (size_t)(end - v), size - 1 );
+            memcpy( out, v, n );
+            out[n] = 0;
+            while (n && out[n - 1] == ' ') out[--n] = 0;
+            return;
+        }
+        if ((p = strchr( p, ';' ))) p++;
+    }
+}
+
+/* the device's USB serial number (its iSerialNumber string), or "" */
+static void usb_serial( struct printer *printer, char *out, size_t size )
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST urb = {{0}};
+    WCHAR str[128];
+    size_t i, n;
+
+    out[0] = 0;
+    if (!printer->device_desc.iSerialNumber) return;
+    urb.Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    urb.Hdr.Length = sizeof(urb);
+    urb.DescriptorType = USB_STRING_DESCRIPTOR_TYPE;
+    urb.Index = printer->device_desc.iSerialNumber;
+    urb.LanguageId = 0x0409;
+    urb.TransferBuffer = str;
+    urb.TransferBufferLength = sizeof(str);
+    if (submit_urb( printer, (URB *)&urb, 0 ) || urb.TransferBufferLength < 4) return;
+    n = min( (urb.TransferBufferLength - 2) / sizeof(WCHAR), size - 1 );
+    for (i = 0; i < n; i++) out[i] = str[i + 1] < 0x80 ? str[i + 1] : '_';
+    out[n] = 0;
+}
+
+/* a CRC-16 (0xA001) of the name, which keeps different models apart once the
+ * name is cut to 20 characters (Stained Glass OS's own; device INFs that name
+ * a Windows checksum do not match it, the compatible ID GENPRINTER does) */
+static USHORT name_checksum( const char *name )
+{
+    USHORT crc = 0;
+    int i;
+
+    for (; *name; name++)
+    {
+        crc ^= (UCHAR)*name;
+        for (i = 0; i < 8; i++) crc = (crc & 1) ? (crc >> 1) ^ 0xa001 : crc >> 1;
+    }
+    return crc;
+}
+
+static void create_child( struct printer *printer, const char *device_id )
+{
+    char mfg[64], mdl[64], sern[64], name[160];
+    DEVICE_OBJECT *child_obj;
+    struct child *child;
+    NTSTATUS status;
+    int i, n;
+
+    id_field( device_id, "MFG", "MANUFACTURER", mfg, sizeof(mfg) );
+    id_field( device_id, "MDL", "MODEL", mdl, sizeof(mdl) );
+    /* the serial number as CUPS's usb backend takes it (its device URIs
+     * carry it): the ID's SERIALNUMBER, SERN or SN, else the USB one */
+    id_field( device_id, "SERIALNUMBER", "SERN", sern, sizeof(sern) );
+    if (!sern[0]) id_field( device_id, "SN", NULL, sern, sizeof(sern) );
+    if (!sern[0]) usb_serial( printer, sern, sizeof(sern) );
+    if (!mdl[0]) return;
+
+    if ((status = IoCreateDevice( printer->fdo->DriverObject, sizeof(*child), NULL, FILE_DEVICE_PRINTER,
+                                  FILE_AUTOGENERATED_DEVICE_NAME, FALSE, &child_obj )))
+    {
+        ERR( "no printer device: %#lx\n", status );
+        return;
+    }
+    child = child_obj->DeviceExtension;
+    memset( child, 0, sizeof(*child) );
+    child->is_child = TRUE;
+    child->printer = printer;
+
+    snprintf( name, sizeof(name), "%s%s", mfg, mdl );
+    for (i = n = 0; name[i] && n < 20; i++)
+        if ((UCHAR)name[i] > ' ' || name[i] == ' ') name[n++] = name[i] == ' ' ? '_' : name[i];
+    name[n] = 0;
+    swprintf( child->plain_id, ARRAY_SIZE(child->plain_id), L"USBPRINT\\%S", name );
+    {
+        char full[160];
+        snprintf( full, sizeof(full), "%s%s", mfg, mdl );
+        swprintf( child->hardware_id, ARRAY_SIZE(child->hardware_id), L"USBPRINT\\%S%04X", name, name_checksum( full ) );
+    }
+    /* the printer's serial number (winspool pairs a CUPS queue on
+     * usb://...?serial=X with the printer device so); USB001 without one */
+    swprintf( child->instance_id, ARRAY_SIZE(child->instance_id), L"%S", sern[0] ? sern : "USB001" );
+    for (i = 0; child->instance_id[i]; i++)
+        if (child->instance_id[i] <= ' ' || child->instance_id[i] == '\\' || child->instance_id[i] == '&') child->instance_id[i] = '_';
+    swprintf( child->description, ARRAY_SIZE(child->description), L"%S %S", mfg, mdl );
+
+    child_obj->Flags &= ~DO_DEVICE_INITIALIZING;
+    printer->child = child_obj;
+    TRACE( "printer device %s (%s)\n", debugstr_w(child->hardware_id), debugstr_w(child->instance_id) );
+    IoInvalidateDeviceRelations( printer->pdo, BusRelations );
+}
+
+/* a multi-string from strings */
+static WCHAR *multi_sz( const WCHAR *a, const WCHAR *b )
+{
+    size_t la = a ? wcslen( a ) + 1 : 0, lb = b ? wcslen( b ) + 1 : 0;
+    WCHAR *out = ExAllocatePool( PagedPool, (la + lb + 1) * sizeof(WCHAR) );
+
+    if (!out) return NULL;
+    if (a) memcpy( out, a, la * sizeof(WCHAR) );
+    if (b) memcpy( out + la, b, lb * sizeof(WCHAR) );
+    out[la + lb] = 0;
+    return out;
+}
+
+static NTSTATUS WINAPI child_pnp( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct child *child = device->DeviceExtension;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    NTSTATUS status = irp->IoStatus.Status;
+    WCHAR *id = NULL;
+
+    switch (stack->MinorFunction)
+    {
+    case IRP_MN_QUERY_ID:
+        switch (stack->Parameters.QueryId.IdType)
+        {
+        case BusQueryDeviceID: id = multi_sz( child->plain_id, NULL ); break;
+        case BusQueryHardwareIDs: id = multi_sz( child->hardware_id, child->plain_id ); break;
+        case BusQueryCompatibleIDs: id = multi_sz( L"GENPRINTER", NULL ); break;
+        case BusQueryInstanceID: id = multi_sz( child->instance_id, NULL ); break;
+        default: break;
+        }
+        if (id)
+        {
+            irp->IoStatus.Information = (ULONG_PTR)id;
+            status = STATUS_SUCCESS;
+        }
+        break;
+
+    case IRP_MN_QUERY_DEVICE_TEXT:
+        if (stack->Parameters.QueryDeviceText.DeviceTextType == DeviceTextDescription &&
+            (id = multi_sz( child->description, NULL )))
+        {
+            irp->IoStatus.Information = (ULONG_PTR)id;
+            status = STATUS_SUCCESS;
+        }
+        break;
+
+    case IRP_MN_QUERY_CAPABILITIES:
+    {
+        DEVICE_CAPABILITIES *caps = stack->Parameters.DeviceCapabilities.Capabilities;
+        caps->RawDeviceOK = 1;
+        caps->SilentInstall = 1;
+        caps->SurpriseRemovalOK = 1;
+        status = STATUS_SUCCESS;
+        break;
+    }
+
+    case IRP_MN_START_DEVICE:
+    case IRP_MN_QUERY_REMOVE_DEVICE:
+    case IRP_MN_CANCEL_REMOVE_DEVICE:
+    case IRP_MN_STOP_DEVICE:
+    case IRP_MN_QUERY_STOP_DEVICE:
+    case IRP_MN_CANCEL_STOP_DEVICE:
+    case IRP_MN_SURPRISE_REMOVAL:
+        status = STATUS_SUCCESS;
+        break;
+
+    case IRP_MN_REMOVE_DEVICE:
+        status = STATUS_SUCCESS;
+        if (child->removed)
+        {
+            irp->IoStatus.Status = status;
+            IoCompleteRequest( irp, IO_NO_INCREMENT );
+            IoDeleteDevice( device );
+            return status;
+        }
+        break;
+    }
+
+    irp->IoStatus.Status = status;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return status;
+}
+
+static NTSTATUS device_ioctl( struct printer *printer, IRP *irp )
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_size = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    UCHAR *buffer = irp->AssociatedIrp.SystemBuffer;
+    USHORT index = (printer->interface_number << 8) | printer->alternate_setting;
+    NTSTATUS status;
+    ULONG length;
+
+    irp->IoStatus.Information = 0;
+    switch (code)
+    {
+    case IOCTL_USBPRINT_GET_1284_ID:
+        /* the 2-byte big-endian length, then the ID, as the printer sends it */
+        length = out_size;
+        status = interface_request( printer, URB_FUNCTION_CLASS_INTERFACE, TRUE, PRINTER_GET_DEVICE_ID,
+                                    0, index, buffer, &length );
+        if (!status) irp->IoStatus.Information = length;
+        return status;
+
+    case IOCTL_USBPRINT_GET_LPT_STATUS:
+        if (out_size < 1) return STATUS_BUFFER_TOO_SMALL;
+        length = 1;
+        status = interface_request( printer, URB_FUNCTION_CLASS_INTERFACE, TRUE, PRINTER_GET_PORT_STATUS,
+                                    0, printer->interface_number, buffer, &length );
+        if (!status) irp->IoStatus.Information = length;
+        return status;
+
+    case IOCTL_USBPRINT_SOFT_RESET:
+        length = 0;
+        return interface_request( printer, URB_FUNCTION_CLASS_INTERFACE, FALSE, PRINTER_SOFT_RESET,
+                                  0, printer->interface_number, NULL, &length );
+
+    case IOCTL_USBPRINT_VENDOR_SET_COMMAND:
+    case IOCTL_USBPRINT_VENDOR_GET_COMMAND:
+        /* the input: the request, then its value, high byte first */
+        if (in_size < 3) return STATUS_INVALID_PARAMETER;
+        {
+            UCHAR request = buffer[0];
+            USHORT value = (buffer[1] << 8) | buffer[2];
+            BOOL in = code == IOCTL_USBPRINT_VENDOR_GET_COMMAND;
+
+            length = in ? out_size : in_size - 3;
+            if (!in) memmove( buffer, buffer + 3, length );
+            status = interface_request( printer, URB_FUNCTION_VENDOR_INTERFACE, in, request, value,
+                                        printer->interface_number, length ? buffer : NULL, &length );
+            if (!status && in) irp->IoStatus.Information = length;
+            return status;
+        }
+
+    case IOCTL_USBPRINT_GET_PROTOCOL:
+        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+        *(ULONG *)buffer = printer->protocol;
+        irp->IoStatus.Information = sizeof(ULONG);
+        return STATUS_SUCCESS;
+
+    case IOCTL_USBPRINT_SET_PROTOCOL:
+        return STATUS_SUCCESS;
+
+    default:
+        FIXME( "unhandled ioctl %#lx\n", code );
+        return STATUS_NOT_SUPPORTED;
+    }
+}
+
+static NTSTATUS WINAPI driver_ioctl( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct printer *printer = device->DeviceExtension;
+    NTSTATUS status;
+
+    if (printer->is_child) printer = ((struct child *)printer)->printer;
+    status = printer->started ? device_ioctl( printer, irp ) : STATUS_DEVICE_NOT_READY;
+
+    irp->IoStatus.Status = status;
+    if (status) irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return status;
+}
+
+static NTSTATUS WINAPI driver_read_write( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct printer *printer = device->DeviceExtension;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    BOOL read = stack->MajorFunction == IRP_MJ_READ;
+    ULONG length = read ? stack->Parameters.Read.Length : stack->Parameters.Write.Length;
+    void *buffer = irp->AssociatedIrp.SystemBuffer ? irp->AssociatedIrp.SystemBuffer : irp->UserBuffer;
+    NTSTATUS status;
+
+    if (printer->is_child) printer = ((struct child *)printer)->printer;
+    if (!printer->started) status = STATUS_DEVICE_NOT_READY;
+    else status = bulk_transfer( printer, read, buffer, &length );
+    irp->IoStatus.Status = status;
+    irp->IoStatus.Information = status ? 0 : length;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return status;
+}
+
+static NTSTATUS WINAPI driver_create( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct printer *printer = device->DeviceExtension;
+
+    if (printer->is_child) printer = ((struct child *)printer)->printer;
+    InterlockedIncrement( &printer->opened );
+    TRACE( "%04x:%04x opened (%ld)\n", printer->device_desc.idVendor, printer->device_desc.idProduct, printer->opened );
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS WINAPI driver_cleanup( DEVICE_OBJECT *device, IRP *irp )
+{
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS WINAPI driver_close( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct printer *printer = device->DeviceExtension;
+
+    if (printer->is_child) printer = ((struct child *)printer)->printer;
+#ifndef SG_MUTANT_USBPRINT_SHARE
+    /* the last handle closed: the printer goes back to the Linux side */
+    if (!InterlockedDecrement( &printer->opened ) && printer->started) release_interface( printer );
+#else
+    InterlockedDecrement( &printer->opened );
+#endif
+    TRACE( "closed (%ld)\n", printer->opened );
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return STATUS_SUCCESS;
+}
+
+/* the device's descriptors, and the printer interface's pipes */
+static NTSTATUS start_printer( struct printer *printer )
+{
+    USB_CONFIGURATION_DESCRIPTOR header, *config = NULL;
+    USBD_INTERFACE_LIST_ENTRY list[2] = {{0}};
+    USB_INTERFACE_DESCRIPTOR *iface;
+    NTSTATUS status;
+    ULONG length, i;
+    URB *urb;
+
+    length = sizeof(printer->device_desc);
+    if ((status = get_descriptor( printer, USB_DEVICE_DESCRIPTOR_TYPE, &printer->device_desc, &length )))
+        return status;
+    length = sizeof(header);
+    if ((status = get_descriptor( printer, USB_CONFIGURATION_DESCRIPTOR_TYPE, &header, &length )))
+        return status;
+    if (!(config = ExAllocatePool( NonPagedPool, header.wTotalLength ))) return STATUS_NO_MEMORY;
+    length = header.wTotalLength;
+    if ((status = get_descriptor( printer, USB_CONFIGURATION_DESCRIPTOR_TYPE, config, &length )))
+        goto done;
+
+    /* the printer class interface; any interface when there is none */
+    if (!(iface = USBD_ParseConfigurationDescriptorEx( config, config, -1, -1, 7, 1, -1 )) &&
+        !(iface = USBD_ParseConfigurationDescriptorEx( config, config, -1, -1, -1, -1, -1 )))
+    {
+        status = STATUS_DEVICE_CONFIGURATION_ERROR;
+        goto done;
+    }
+    printer->interface_number = iface->bInterfaceNumber;
+    printer->alternate_setting = iface->bAlternateSetting;
+    printer->protocol = iface->bInterfaceProtocol;
+    list[0].InterfaceDescriptor = iface;
+    if (!(urb = USBD_CreateConfigurationRequestEx( config, list )))
+    {
+        status = STATUS_NO_MEMORY;
+        goto done;
+    }
+    if (!(status = submit_urb( printer, urb, 0 )))
+    {
+        USBD_INTERFACE_INFORMATION *info = list[0].Interface;
+
+        for (i = 0; i < info->NumberOfPipes; i++)
+        {
+            USBD_PIPE_INFORMATION *pipe = &info->Pipes[i];
+
+            if (pipe->PipeType != UsbdPipeTypeBulk) continue;
+            if ((pipe->EndpointAddress & 0x80) && !printer->bulk_in) printer->bulk_in = pipe->PipeHandle;
+            else if (!(pipe->EndpointAddress & 0x80) && !printer->bulk_out) printer->bulk_out = pipe->PipeHandle;
+        }
+        TRACE( "%04x:%04x: interface %u, protocol %u, bulk in %p, out %p\n", printer->device_desc.idVendor,
+               printer->device_desc.idProduct, printer->interface_number, printer->protocol,
+               printer->bulk_in, printer->bulk_out );
+        {
+            /* the printer device, named after the printer's IEEE 1284 ID */
+            char id[1024];
+            ULONG len = sizeof(id) - 1;
+            USHORT index = (printer->interface_number << 8) | printer->alternate_setting;
+
+            if (!interface_request( printer, URB_FUNCTION_CLASS_INTERFACE, TRUE, PRINTER_GET_DEVICE_ID,
+                                    0, index, id, &len ) && len > 2)
+            {
+                id[len] = 0;
+                create_child( printer, id + 2 );
+            }
+        }
+        /* nothing is held until a program opens the printer */
+        release_interface( printer );
+    }
+    ExFreePool( urb );
+
+done:
+    ExFreePool( config );
+    return status;
+}
+
+static NTSTATUS forward_sync( struct printer *printer, IRP *irp )
+{
+    KEVENT event;
+
+    KeInitializeEvent( &event, NotificationEvent, FALSE );
+    IoCopyCurrentIrpStackLocationToNext( irp );
+    IoSetCompletionRoutine( irp, sync_completion, &event, TRUE, TRUE, TRUE );
+    if (IoCallDriver( printer->next, irp ) == STATUS_PENDING)
+        KeWaitForSingleObject( &event, Executive, KernelMode, FALSE, NULL );
+    return irp->IoStatus.Status;
+}
+
+static NTSTATUS WINAPI driver_pnp( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct printer *printer = device->DeviceExtension;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    NTSTATUS status;
+
+    if (printer->is_child) return child_pnp( device, irp );
+
+    switch (stack->MinorFunction)
+    {
+    case IRP_MN_QUERY_DEVICE_RELATIONS:
+        if (stack->Parameters.QueryDeviceRelations.Type == BusRelations)
+        {
+            DEVICE_RELATIONS *relations;
+
+            if (!(relations = ExAllocatePool( PagedPool, offsetof( DEVICE_RELATIONS, Objects[1] ) )))
+                status = STATUS_NO_MEMORY;
+            else
+            {
+                relations->Count = 0;
+                if (printer->child && printer->started)
+                {
+                    relations->Objects[relations->Count++] = printer->child;
+                    call_fastcall_func1( ObfReferenceObject, printer->child );
+                }
+                irp->IoStatus.Information = (ULONG_PTR)relations;
+                status = STATUS_SUCCESS;
+            }
+            irp->IoStatus.Status = status;
+            IoCompleteRequest( irp, IO_NO_INCREMENT );
+            return status;
+        }
+        break;
+
+    case IRP_MN_START_DEVICE:
+        if (!(status = forward_sync( printer, irp )))
+        {
+            if (!(status = start_printer( printer )))
+            {
+                printer->started = TRUE;
+                IoSetDeviceInterfaceState( &printer->iface, TRUE );
+            }
+            else ERR( "the printer could not be configured: %#lx\n", status );
+        }
+        irp->IoStatus.Status = status;
+        IoCompleteRequest( irp, IO_NO_INCREMENT );
+        return status;
+
+    case IRP_MN_SURPRISE_REMOVAL:
+        printer->started = FALSE;
+        IoSetDeviceInterfaceState( &printer->iface, FALSE );
+        break;
+
+    case IRP_MN_REMOVE_DEVICE:
+        if (printer->started) IoSetDeviceInterfaceState( &printer->iface, FALSE );
+        printer->started = FALSE;
+        if (printer->child)
+        {
+            ((struct child *)printer->child->DeviceExtension)->removed = TRUE;
+            printer->child = NULL;
+        }
+        RtlFreeUnicodeString( &printer->iface );
+        IoSkipCurrentIrpStackLocation( irp );
+        status = IoCallDriver( printer->next, irp );
+        IoDetachDevice( printer->next );
+        IoDeleteDevice( device );
+        return status;
+    }
+
+    IoSkipCurrentIrpStackLocation( irp );
+    return IoCallDriver( printer->next, irp );
+}
+
+static NTSTATUS WINAPI driver_add_device( DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo )
+{
+    struct printer *printer;
+    DEVICE_OBJECT *fdo;
+    NTSTATUS status;
+
+    if ((status = IoCreateDevice( driver, sizeof(*printer), NULL, FILE_DEVICE_UNKNOWN, 0, FALSE, &fdo )))
+    {
+        ERR( "no device: %#lx\n", status );
+        return status;
+    }
+    printer = fdo->DeviceExtension;
+    memset( printer, 0, sizeof(*printer) );
+    printer->fdo = fdo;
+    printer->pdo = pdo;
+    if ((status = IoRegisterDeviceInterface( pdo, &GUID_DEVINTERFACE_USBPRINT, NULL, &printer->iface )))
+        ERR( "no device interface: %#lx\n", status );
+    printer->next = IoAttachDeviceToDeviceStack( fdo, pdo );
+    fdo->Flags &= ~DO_DEVICE_INITIALIZING;
+    TRACE( "pdo %p: %s\n", pdo, debugstr_w(printer->iface.Buffer) );
+    return STATUS_SUCCESS;
+}
+
+static void WINAPI driver_unload( DRIVER_OBJECT *driver )
+{
+}
+
+NTSTATUS WINAPI DriverEntry( DRIVER_OBJECT *driver, UNICODE_STRING *path )
+{
+    TRACE( "driver %p, path %s.\n", driver, debugstr_w(path->Buffer) );
+
+    driver->MajorFunction[IRP_MJ_CREATE] = driver_create;
+    driver->MajorFunction[IRP_MJ_CLOSE] = driver_close;
+    driver->MajorFunction[IRP_MJ_CLEANUP] = driver_cleanup;
+    driver->MajorFunction[IRP_MJ_READ] = driver_read_write;
+    driver->MajorFunction[IRP_MJ_WRITE] = driver_read_write;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL] = driver_ioctl;
+    driver->MajorFunction[IRP_MJ_PNP] = driver_pnp;
+    driver->DriverExtension->AddDevice = driver_add_device;
+    driver->DriverUnload = driver_unload;
+    return STATUS_SUCCESS;
+}
