--- /dev/null
+++ b/dlls/usbprint.sys/usbprint.c
@@ -0,0 +1,777 @@
+/*
+ * usbprint.sys: the USB printing class driver
+ *
+ * A function driver over a USB printer (wineusb's PDO for a device or
+ * interface of class 07, subclass 01; usbprint.inf). It registers the
+ * printer's device interface, GUID_DEVINTERFACE_USBPRINT, through which a
+ * printer maker's software reads the printer's status and writes commands to
+ * it: WriteFile writes the bulk-out pipe, ReadFile reads the bulk-in pipe
+ * (giving up after a few seconds, as the printer may have nothing to say),
+ * and the usbprint.h IOCTLs: the IEEE 1284 device ID, the port status, a
+ * soft reset, vendor requests. DYMO Connect reads a LabelWriter 5xx's label
+ * roll so; without it the printer showed "Empty" and nothing printed.
+ *
+ * The printer is shared with the Linux side, whose CUPS queue prints to it:
+ * the interface is held (wineusb claims it, the kernel's usblp let go) only
+ * while a program has the device open, and given back when the last handle
+ * is closed.
+ *
