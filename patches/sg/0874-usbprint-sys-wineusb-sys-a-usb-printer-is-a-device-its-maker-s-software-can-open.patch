+/* Stained Glass OS: the device's interface claimed before a transfer on it --
+ * a kernel driver bound to it (usblp for a printer) detached for the while,
+ * as CUPS's usb backend does. Without, usbfs refused every transfer on an
+ * interface a kernel driver had (the submit failed and the IRP never
+ * completed). Given back by release_interface(). */
+static int claim_interface(struct unix_device *device)
+{
+    int ret;
+
+#ifndef SG_MUTANT_USBCLAIM
+    if (device->interface < 0 || device->claimed) return 0;
+    libusb_set_auto_detach_kernel_driver(device->handle, 1);
+    if ((ret = libusb_claim_interface(device->handle, device->interface)) < 0)
+    {
+        WARN("Failed to claim interface %d: %s\n", device->interface, libusb_strerror(ret));
+        return ret;
+    }
+    TRACE("Claimed interface %d.\n", device->interface);
+    device->claimed = true;
+#endif
+    return 0;
+}
+
+static void release_interface(struct unix_device *device)
+{
+    int ret;
+
+    if (!device->claimed) return;
+    if ((ret = libusb_release_interface(device->handle, device->interface)) < 0)
+        WARN("Failed to release interface %d: %s\n", device->interface, libusb_strerror(ret));
+    else
+        TRACE("Released interface %d.\n", device->interface);
+    device->claimed = false;
+}
