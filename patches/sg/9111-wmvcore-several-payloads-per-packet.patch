 }
 
+/* the packet being filled goes out: its parsing information, its payloads, padding to the size */
+static HRESULT flush_packet(struct asf_mux *mux)
+{
+    WORD padding, packet_duration = 0;
+    DWORD pos = 0;
+    HRESULT hr;
+
+    if (!mux->packet_open) return S_OK;
+    mux->packet_open = FALSE;
+    padding = PAYLOAD_AREA - mux->packet_used;
+    /* error correction data: present, two bytes */
+    mux->packet[pos++] = 0x82;
+    mux->packet[pos++] = 0;
+    mux->packet[pos++] = 0;
+    /* multiple payloads; padding length a WORD; packet length and sequence absent (fixed size) */
+    mux->packet[pos++] = 0x11;
+    /* replicated data length a BYTE, offset a DWORD, object number a BYTE, stream number a BYTE */
+    mux->packet[pos++] = 0x5d;
+    memcpy(mux->packet + pos, &padding, 2); pos += 2;
+    memcpy(mux->packet + pos, &mux->packet_send, 4); pos += 4;
+    memcpy(mux->packet + pos, &packet_duration, 2); pos += 2;
+    /* the payload count; payload lengths are WORDs */
+    mux->packet[pos++] = 0x80 | mux->packet_payloads;
+    memset(mux->packet + PACKET_HEADER + mux->packet_used, 0, padding);
+
+    if (FAILED(hr = write_bytes(mux, mux->packet, PACKET_SIZE))) return hr;
+    if (FAILED(hr = sinks_send(mux, mux->packet, PACKET_SIZE, FALSE))) return hr;
+    mux->packets++;
+    return S_OK;
+}
