     UINT64 end_time, send_time;
     BOOL started, header_written;
+
+    /* the packet being filled */
+    BYTE packet[PACKET_SIZE];
+    DWORD packet_used;      /* bytes of its payload area in use */
+    BYTE packet_payloads;
+    DWORD packet_send;      /* ms, its first payload's */
+    BOOL packet_open;
 };
 
 static struct mux_stream *find_stream(struct asf_mux *mux, WORD number)
@@ -383,6 +395,7 @@
