From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: cancel-safe IRP queues.

IoCsqInitialize returned success without filling the IO_CSQ and
IoCsqInsertIrp, IoCsqRemoveIrp and IoCsqRemoveNextIrp were unimplemented
exports. IoCsqInitialize and IoCsqInitializeEx fill the dispatch table,
IoCsqInsertIrp / IoCsqInsertIrpEx insert under the queue's lock, mark the
irp pending and set a cancel routine that removes a canceled irp and
completes it through CsqCompleteCanceledIrp; an irp canceled before the
insert is not inserted. IoCsqRemoveIrp returns NULL for a canceled irp and
IoCsqRemoveNextIrp passes PeekContext to the peek routine. The IO_CSQ
structures are in ddk/csq.h now.

Gate: test/ntoskrnl-csq-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4542,9 +4542,170 @@
                                 PIO_CSQ_PEEK_NEXT_IRP peek_irp, PIO_CSQ_ACQUIRE_LOCK acquire_lock,
                                 PIO_CSQ_RELEASE_LOCK release_lock, PIO_CSQ_COMPLETE_CANCELED_IRP complete_irp)
 {
-    FIXME("(%p %p %p %p %p %p %p) stub\n",
-          csq, insert_irp, remove_irp, peek_irp, acquire_lock, release_lock, complete_irp);
+    TRACE( "(%p %p %p %p %p %p %p)\n", csq, insert_irp, remove_irp, peek_irp, acquire_lock, release_lock, complete_irp );
+
+    if (!csq) return STATUS_INVALID_PARAMETER;
+#ifndef SG_MUTANT_CSQ_NO_INIT
+    csq->Type = IO_TYPE_CSQ;
+#endif
+    csq->CsqInsertIrp = insert_irp;
+    csq->CsqRemoveIrp = remove_irp;
+    csq->CsqPeekNextIrp = peek_irp;
+    csq->CsqAcquireLock = acquire_lock;
+    csq->CsqReleaseLock = release_lock;
+    csq->CsqCompleteCanceledIrp = complete_irp;
+    csq->ReservePointer = NULL;
+    return STATUS_SUCCESS;
+}
+
+/*****************************************************
+ *           IoCsqInitializeEx  (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoCsqInitializeEx(PIO_CSQ csq, PIO_CSQ_INSERT_IRP_EX insert_irp, PIO_CSQ_REMOVE_IRP remove_irp,
+                                  PIO_CSQ_PEEK_NEXT_IRP peek_irp, PIO_CSQ_ACQUIRE_LOCK acquire_lock,
+                                  PIO_CSQ_RELEASE_LOCK release_lock, PIO_CSQ_COMPLETE_CANCELED_IRP complete_irp)
+{
+    NTSTATUS status = IoCsqInitialize( csq, (PIO_CSQ_INSERT_IRP)insert_irp, remove_irp, peek_irp, acquire_lock,
+                                       release_lock, complete_irp );
+    if (!status) csq->Type = IO_TYPE_CSQ_EX;
+    return status;
+}
+
+/* the queue an irp was inserted in is kept in DriverContext[3], either the IO_CSQ itself or the
+ * IO_CSQ_IRP_CONTEXT given to IoCsqInsertIrp */
+static IO_CSQ *csq_from_irp( IRP *irp )
+{
+    IO_CSQ_IRP_CONTEXT *context = irp->Tail.Overlay.DriverContext[3];
+
+    if (!context) return NULL;
+    return context->Type == IO_TYPE_CSQ_IRP_CONTEXT ? context->Csq : (IO_CSQ *)context;
+}
+
+static void WINAPI csq_cancel_routine( DEVICE_OBJECT *device, IRP *irp )
+{
+    IO_CSQ *csq = csq_from_irp( irp );
+    KIRQL irql;
+
+    IoReleaseCancelSpinLock( irp->CancelIrql );
+    csq->CsqAcquireLock( csq, &irql );
+    csq->CsqRemoveIrp( csq, irp );
+    csq->CsqReleaseLock( csq, irql );
+    irp->Tail.Overlay.DriverContext[3] = NULL;
+    csq->CsqCompleteCanceledIrp( csq, irp );
+}
+
+/*****************************************************
+ *           IoCsqInsertIrpEx  (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoCsqInsertIrpEx(PIO_CSQ csq, PIRP irp, PIO_CSQ_IRP_CONTEXT context, PVOID insert_context)
+{
+    NTSTATUS status = STATUS_SUCCESS;
+    KIRQL irql;
+
+    TRACE( "(%p %p %p %p)\n", csq, irp, context, insert_context );
+
+    if (context)
+    {
+        context->Type = IO_TYPE_CSQ_IRP_CONTEXT;
+        context->Irp = irp;
+        context->Csq = csq;
+        irp->Tail.Overlay.DriverContext[3] = context;
+    }
+    else irp->Tail.Overlay.DriverContext[3] = csq;
+
+    csq->CsqAcquireLock( csq, &irql );
+    if (irp->Cancel)
+    {
+        /* already canceled: not inserted, completed as a canceled irp */
+        csq->CsqReleaseLock( csq, irql );
+        irp->Tail.Overlay.DriverContext[3] = NULL;
+        csq->CsqCompleteCanceledIrp( csq, irp );
+        return csq->Type == IO_TYPE_CSQ_EX ? STATUS_CANCELLED : STATUS_SUCCESS;
+    }
+    if (csq->Type == IO_TYPE_CSQ_EX)
+        status = ((PIO_CSQ_INSERT_IRP_EX)csq->CsqInsertIrp)( csq, irp, insert_context );
+    else
+        csq->CsqInsertIrp( csq, irp );
+    if (NT_SUCCESS(status))
+    {
+        IoMarkIrpPending( irp );
+#ifndef SG_MUTANT_CSQ_NO_CANCEL_ROUTINE
+        IoSetCancelRoutine( irp, csq_cancel_routine );
+#endif
+        if (irp->Cancel && IoSetCancelRoutine( irp, NULL ))
+        {
+            /* canceled while it was being inserted */
+            csq->CsqRemoveIrp( csq, irp );
+            csq->CsqReleaseLock( csq, irql );
+            irp->Tail.Overlay.DriverContext[3] = NULL;
+            csq->CsqCompleteCanceledIrp( csq, irp );
+            return csq->Type == IO_TYPE_CSQ_EX ? status : STATUS_SUCCESS;
+        }
+    }
+    csq->CsqReleaseLock( csq, irql );
+#ifdef SG_MUTANT_CSQ_EX_STATUS
     return STATUS_SUCCESS;
+#endif
+    return csq->Type == IO_TYPE_CSQ_EX ? status : STATUS_SUCCESS;
+}
+
+/*****************************************************
+ *           IoCsqInsertIrp  (NTOSKRNL.EXE.@)
+ */
+void WINAPI IoCsqInsertIrp(PIO_CSQ csq, PIRP irp, PIO_CSQ_IRP_CONTEXT context)
+{
+    IoCsqInsertIrpEx( csq, irp, context, NULL );
+}
+
+/*****************************************************
+ *           IoCsqRemoveIrp  (NTOSKRNL.EXE.@)
+ */
+PIRP WINAPI IoCsqRemoveIrp(PIO_CSQ csq, PIO_CSQ_IRP_CONTEXT context)
+{
+    IRP *irp = context->Irp;
+    KIRQL irql;
+
+    TRACE( "(%p %p)\n", csq, context );
+
+    csq->CsqAcquireLock( csq, &irql );
+    /* the cancel routine is gone when the irp was canceled: it is the cancel routine's */
+#ifndef SG_MUTANT_CSQ_REMOVE_CANCELED
+    if (!IoSetCancelRoutine( irp, NULL ))
+    {
+        csq->CsqReleaseLock( csq, irql );
+        return NULL;
+    }
+#endif
+    csq->CsqRemoveIrp( csq, irp );
+    csq->CsqReleaseLock( csq, irql );
+    irp->Tail.Overlay.DriverContext[3] = NULL;
+    return irp;
+}
+
+/*****************************************************
+ *           IoCsqRemoveNextIrp  (NTOSKRNL.EXE.@)
+ */
+PIRP WINAPI IoCsqRemoveNextIrp(PIO_CSQ csq, PVOID peek_context)
+{
+    KIRQL irql;
+    IRP *irp;
+
+    TRACE( "(%p %p)\n", csq, peek_context );
+
+    csq->CsqAcquireLock( csq, &irql );
+    for (irp = csq->CsqPeekNextIrp( csq, NULL, peek_context ); irp;
+         irp = csq->CsqPeekNextIrp( csq, irp, peek_context ))
+    {
+        /* skip an irp that is being canceled */
+        if (IoSetCancelRoutine( irp, NULL ))
+        {
+            csq->CsqRemoveIrp( csq, irp );
+            irp->Tail.Overlay.DriverContext[3] = NULL;
+            break;
+        }
+    }
+    csq->CsqReleaseLock( csq, irql );
+    return irp;
 }
 
 /***********************************************************************
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -371,9 +371,11 @@
 @ stdcall IoCreateSynchronizationEvent(ptr ptr)
 @ stdcall IoCreateUnprotectedSymbolicLink(ptr ptr)
 @ stdcall IoCsqInitialize(ptr ptr ptr ptr ptr ptr ptr)
-@ stub IoCsqInsertIrp
-@ stub IoCsqRemoveIrp
-@ stub IoCsqRemoveNextIrp
+@ stdcall IoCsqInitializeEx(ptr ptr ptr ptr ptr ptr ptr)
+@ stdcall IoCsqInsertIrp(ptr ptr ptr)
+@ stdcall IoCsqInsertIrpEx(ptr ptr ptr ptr)
+@ stdcall IoCsqRemoveIrp(ptr ptr)
+@ stdcall IoCsqRemoveNextIrp(ptr ptr)
 @ stub IoDeleteController
 @ stdcall IoDeleteDevice(ptr)
 @ stdcall IoDeleteDriver(ptr)
diff --git a/include/ddk/csq.h b/include/ddk/csq.h
--- a/include/ddk/csq.h
+++ b/include/ddk/csq.h
@@ -29,4 +29,27 @@
 typedef VOID (WINAPI *PIO_CSQ_RELEASE_LOCK)(PIO_CSQ Csq, KIRQL Irql);
 typedef VOID (WINAPI *PIO_CSQ_REMOVE_IRP)(PIO_CSQ Csq, PIRP Irp);
 
+#define IO_TYPE_CSQ_IRP_CONTEXT 1
+#define IO_TYPE_CSQ             2
+#define IO_TYPE_CSQ_EX          3
+
+typedef NTSTATUS (WINAPI *PIO_CSQ_INSERT_IRP_EX)(struct _IO_CSQ *Csq, PIRP Irp, PVOID InsertContext);
+
+typedef struct _IO_CSQ_IRP_CONTEXT {
+    ULONG Type;
+    PIRP Irp;
+    PIO_CSQ Csq;
+} IO_CSQ_IRP_CONTEXT, *PIO_CSQ_IRP_CONTEXT;
+
+struct _IO_CSQ {
+    ULONG Type;
+    PIO_CSQ_INSERT_IRP CsqInsertIrp;  /* a PIO_CSQ_INSERT_IRP_EX when Type is IO_TYPE_CSQ_EX */
+    PIO_CSQ_REMOVE_IRP CsqRemoveIrp;
+    PIO_CSQ_PEEK_NEXT_IRP CsqPeekNextIrp;
+    PIO_CSQ_ACQUIRE_LOCK CsqAcquireLock;
+    PIO_CSQ_RELEASE_LOCK CsqReleaseLock;
+    PIO_CSQ_COMPLETE_CANCELED_IRP CsqCompleteCanceledIrp;
+    PVOID ReservePointer;
+};
+
 #endif  /* __WINE_CSQ_H */
-- 
2.47.0
