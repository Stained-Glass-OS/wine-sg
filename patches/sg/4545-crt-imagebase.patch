index a08181d..0ac05e7 100644
--- a/dlls/msvcrt/mbcs.c
+++ b/dlls/msvcrt/mbcs.c
@@ -183,6 +183,19 @@ unsigned char* CDECL __p__mbctype(void)
   return get_mbcinfo()->mbctype;
 }
 
+#if _MSVCR_VER >= 80
+/*********************************************************************
+ *		__p__mbcasemap (MSVCR80.@)
+ */
+unsigned char* CDECL __p__mbcasemap(void)
+{
+#ifdef SG_MUTANT_MBCASEMAP_MBCTYPE
+  return get_mbcinfo()->mbctype;
+#endif
+  return get_mbcinfo()->mbcasemap;
+}
+#endif
+
 /*********************************************************************
  *		__p___mb_cur_max(MSVCRT.@)
  */
diff --git a/dlls/msvcrt/misc.c b/dlls/msvcrt/misc.c
index 40a6502..fb4cdb8 100644
--- a/dlls/msvcrt/misc.c
+++ b/dlls/msvcrt/misc.c
@@ -883,3 +883,39 @@ int CDECL _ValidateExecute(FARPROC f)
     return f && !IsBadCodePtr(f);
 }
 #endif
+
+#if _MSVCR_VER >= 80
+/*********************************************************************
+ * _SetImageBase (MSVCR80.@)
+ *
+ * The image base the exception handling of the thread decodes RVAs with.
+ */
+void CDECL _SetImageBase(ULONG_PTR base)
+{
+    msvcrt_get_thread_data()->image_base = base;
+}
+
+/*********************************************************************
+ * _GetImageBase (MSVCR80.@)
+ */
+ULONG_PTR CDECL _GetImageBase(void)
+{
+    return msvcrt_get_thread_data()->image_base;
+}
+
+/*********************************************************************
+ * _SetThrowImageBase (MSVCR80.@)
+ */
+void CDECL _SetThrowImageBase(ULONG_PTR base)
+{
+    msvcrt_get_thread_data()->throw_image_base = base;
+}
+
+/*********************************************************************
+ * _GetThrowImageBase (MSVCR80.@)
+ */
+ULONG_PTR CDECL _GetThrowImageBase(void)
+{
+    return msvcrt_get_thread_data()->throw_image_base;
+}
+#endif
