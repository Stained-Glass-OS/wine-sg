+/* ---- zip.c: a ZIP (and ZIP64) archive read from an IStream -------------- */
+
+struct zip_entry
+{
+    WCHAR *name;          /* the part name: percent-decoded, '\\'-separated */
+    char *raw_name;       /* as stored */
+    UINT16 method;        /* 0 stored, 8 deflated */
+    UINT32 crc;
+    UINT64 compressed_size;
+    UINT64 size;
+    UINT64 local_header_offset;
+};
+
+struct zip_archive
+{
+    IStream *stream;
+    CRITICAL_SECTION cs;  /* the stream's position is shared */
+    UINT64 stream_size;
+    unsigned int count;
+    struct zip_entry *entries;
+};
+
+HRESULT zip_open( IStream *stream, struct zip_archive **archive );
+void zip_close( struct zip_archive *archive );
+const struct zip_entry *zip_find( const struct zip_archive *archive, const WCHAR *name );
+/* Reads and decompresses an entry into a new buffer (free()d by the caller),
+ * checking its CRC-32. */
+HRESULT zip_read( struct zip_archive *archive, const struct zip_entry *entry, BYTE **data );
+/* The offset of an entry's data, after its local header. */
+HRESULT zip_data_offset( struct zip_archive *archive, const struct zip_entry *entry, UINT64 *offset );
+
+/* ---- manifest.c ------------------------------------------------------- */
+
+struct package_identity
+{
+    WCHAR *name, *publisher, *resource_id;
+    UINT64 version;
+    APPX_PACKAGE_ARCHITECTURE architecture;
+};
+
+HRESULT manifest_reader_create( const BYTE *data, SIZE_T size, IAppxManifestReader **reader );
+HRESULT package_id_create( const struct package_identity *identity, IAppxManifestPackageId **out );
+HRESULT identity_parse_version( const WCHAR *text, UINT64 *version );
+
+/* ---- package.c -------------------------------------------------------- */
+
+HRESULT package_reader_create( IStream *stream, IAppxPackageReader **reader );
+HRESULT bundle_reader_create( IStream *stream, IAppxBundleReader **reader );
+
+/* ---- helpers ---------------------------------------------------------- */
+
+static inline WCHAR *co_strdupW( const WCHAR *s )
+{
+    WCHAR *ret;
+    SIZE_T len;
+    if (!s) s = L"";
+    len = (wcslen( s ) + 1) * sizeof(WCHAR);
+    if ((ret = CoTaskMemAlloc( len ))) memcpy( ret, s, len );
+    return ret;
+}
+
+static inline WCHAR *strdupW( const WCHAR *s )
+{
+    WCHAR *ret;
+    SIZE_T len;
+    if (!s) return NULL;
+    len = (wcslen( s ) + 1) * sizeof(WCHAR);
+    if ((ret = malloc( len ))) memcpy( ret, s, len );
+    return ret;
+}
