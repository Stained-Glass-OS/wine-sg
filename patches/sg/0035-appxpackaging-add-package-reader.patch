+static HRESULT WINAPI app_enum_GetCurrent( IAppxManifestApplicationsEnumerator *iface, IAppxManifestApplication **out )
+{
+    struct app_enum *impl = impl_from_IAppxManifestApplicationsEnumerator( iface );
+    struct app *app;
+
+    if (!out) return E_POINTER;
+    if (impl->index >= impl->manifest->app_count) return APPX_E_INVALID_MANIFEST;
+    if (!(app = calloc( 1, sizeof(*app) ))) return E_OUTOFMEMORY;
+    app->IAppxManifestApplication_iface.lpVtbl = &app_vtbl;
+    app->ref = 1;
+    app->manifest = impl->manifest;
+    app->index = impl->index;
+    IAppxManifestReader_AddRef( &impl->manifest->IAppxManifestReader_iface );
+    *out = &app->IAppxManifestApplication_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_enum_GetHasCurrent( IAppxManifestApplicationsEnumerator *iface, BOOL *has_current )
+{
+    struct app_enum *impl = impl_from_IAppxManifestApplicationsEnumerator( iface );
+    if (!has_current) return E_POINTER;
+    *has_current = impl->index < impl->manifest->app_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_enum_MoveNext( IAppxManifestApplicationsEnumerator *iface, BOOL *has_next )
+{
+    struct app_enum *impl = impl_from_IAppxManifestApplicationsEnumerator( iface );
+    if (!has_next) return E_POINTER;
+    if (impl->index < impl->manifest->app_count) impl->index++;
+    *has_next = impl->index < impl->manifest->app_count;
+    return S_OK;
+}
