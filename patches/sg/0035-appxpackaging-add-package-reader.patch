+static ULONG WINAPI manifest_AddRef( IAppxManifestReader *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxManifestReader( iface )->ref );
+}
+
+static ULONG WINAPI manifest_Release( IAppxManifestReader *iface )
+{
+    struct manifest *m = impl_from_IAppxManifestReader( iface );
+    ULONG ref = InterlockedDecrement( &m->ref );
+    unsigned int i;
+
+    if (!ref)
+    {
+        free( m->data );
+        free( m->identity.name );
+        free( m->identity.publisher );
+        free( m->identity.resource_id );
+        free_values( m->props, m->prop_count );
+        for (i = 0; i < m->app_count; i++) free_values( m->apps[i].values, m->apps[i].count );
+        free( m->apps );
+        free( m->os_min_version );
+        free( m->os_max_version_tested );
+        free( m );
+    }
+    return ref;
+}
