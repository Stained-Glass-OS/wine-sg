+static HRESULT WINAPI app_GetStringValue( IAppxManifestApplication *iface, LPCWSTR name, LPWSTR *value )
+{
+    struct app *impl = impl_from_IAppxManifestApplication( iface );
+    const struct application *a = &impl->manifest->apps[impl->index];
+    const WCHAR *v;
+
+    TRACE( "iface %p, name %s, value %p.\n", iface, debugstr_w( name ), value );
+    if (!name || !value) return E_POINTER;
+    if (!(v = find_value( a->values, a->count, name ))) { *value = NULL; return S_OK; }
+    return (*value = co_strdupW( v )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI app_GetAppUserModelId( IAppxManifestApplication *iface, LPWSTR *aumid )
+{
+    struct app *impl = impl_from_IAppxManifestApplication( iface );
+    const struct application *a = &impl->manifest->apps[impl->index];
+    IAppxManifestPackageId *id;
+    const WCHAR *app_id = find_value( a->values, a->count, L"Id" );
+    WCHAR *family, *buf;
+    SIZE_T len;
+    HRESULT hr;
+
+    TRACE( "iface %p, aumid %p.\n", iface, aumid );
+    if (!aumid) return E_POINTER;
+    if (FAILED(hr = package_id_create( &impl->manifest->identity, &id ))) return hr;
+    hr = IAppxManifestPackageId_GetPackageFamilyName( id, &family );
+    IAppxManifestPackageId_Release( id );
+    if (FAILED(hr)) return hr;
+    len = wcslen( family ) + (app_id ? wcslen( app_id ) : 0) + 2;
+    if ((buf = CoTaskMemAlloc( len * sizeof(WCHAR) ))) swprintf( buf, len, L"%s!%s", family, app_id ? app_id : L"" );
+    CoTaskMemFree( family );
+    *aumid = buf;
+    return buf ? S_OK : E_OUTOFMEMORY;
+}
