+static HRESULT WINAPI package_GetFootprintFile( IAppxPackageReader *iface, APPX_FOOTPRINT_FILE_TYPE type, IAppxFile **file )
+{
+    struct package *pkg = impl_from_IAppxPackageReader( iface );
+    const struct zip_entry *e;
+
+    TRACE( "iface %p, type %d, file %p.\n", iface, type, file );
+    if (!file) return E_POINTER;
+    *file = NULL;
+    if ((unsigned int)type >= ARRAY_SIZE(footprint_names)) return E_INVALIDARG;
+    if (!(e = zip_find( pkg->zip, footprint_names[type] ))) return APPX_E_MISSING_REQUIRED_FILE;
+    return file_create( pkg, e, file );
