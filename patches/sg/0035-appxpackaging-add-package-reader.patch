+static HRESULT WINAPI manifest_GetStream( IAppxManifestReader *iface, IStream **stream )
+{
+    struct manifest *m = impl_from_IAppxManifestReader( iface );
+    HGLOBAL mem;
+    HRESULT hr;
+
+    TRACE( "iface %p, stream %p.\n", iface, stream );
+    if (!stream) return E_POINTER;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, m->size ? m->size : 1 ))) return E_OUTOFMEMORY;
+    memcpy( GlobalLock( mem ), m->data, m->size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, stream ))) { GlobalFree( mem ); return hr; }
+    /* an HGLOBAL stream reports the allocation's size; trim it to the data */
+    {
+        ULARGE_INTEGER size;
+        size.QuadPart = m->size;
+        IStream_SetSize( *stream, size );
+    }
+    return S_OK;
+}
