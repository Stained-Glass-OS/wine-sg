+static void package_free( struct package *pkg )
+{
+    unsigned int i;
+    for (i = 0; i < pkg->file_count; i++) { free( pkg->files[i].name ); free( pkg->files[i].hashes ); }
+    free( pkg->files );
+    for (i = 0; i < pkg->type_count; i++) { free( pkg->types[i].key ); free( pkg->types[i].type ); }
+    free( pkg->types );
+    if (pkg->manifest) IAppxManifestReader_Release( pkg->manifest );
+    zip_close( pkg->zip );
+    free( pkg );
+}
