+HRESULT identity_parse_version( const WCHAR *text, UINT64 *version )
+{
+    UINT64 v = 0;
+    int part, digits;
+
+    if (!text) return APPX_E_INVALID_MANIFEST;
+    for (part = 0; part < 4; part++)
+    {
+        UINT32 n = 0;
+        for (digits = 0; *text >= '0' && *text <= '9'; text++, digits++)
+            if ((n = n * 10 + (*text - '0')) > 0xffff) return APPX_E_INVALID_MANIFEST;
+        if (!digits) return APPX_E_INVALID_MANIFEST;
+        v = (v << 16) | n;
+        if (part < 3 && *text++ != '.') return APPX_E_INVALID_MANIFEST;
+    }
+    if (*text) return APPX_E_INVALID_MANIFEST;
+    *version = v;
+    return S_OK;
+}
+
+static const WCHAR *architecture_name( APPX_PACKAGE_ARCHITECTURE arch )
+{
+    switch (arch)
+    {
+    case APPX_PACKAGE_ARCHITECTURE_X86: return L"x86";
+    case APPX_PACKAGE_ARCHITECTURE_ARM: return L"arm";
+    case APPX_PACKAGE_ARCHITECTURE_X64: return L"x64";
+    case APPX_PACKAGE_ARCHITECTURE_ARM64: return L"arm64";
+    default: return L"neutral";
+    }
+}
+
+static HRESULT parse_architecture( const WCHAR *text, APPX_PACKAGE_ARCHITECTURE *arch )
+{
+    if (!text || !text[0] || !wcsicmp( text, L"neutral" )) *arch = APPX_PACKAGE_ARCHITECTURE_NEUTRAL;
+    else if (!wcsicmp( text, L"x86" )) *arch = APPX_PACKAGE_ARCHITECTURE_X86;
+    else if (!wcsicmp( text, L"x64" )) *arch = APPX_PACKAGE_ARCHITECTURE_X64;
+    else if (!wcsicmp( text, L"arm" )) *arch = APPX_PACKAGE_ARCHITECTURE_ARM;
+    else if (!wcsicmp( text, L"arm64" )) *arch = APPX_PACKAGE_ARCHITECTURE_ARM64;
+    else return APPX_E_INVALID_MANIFEST;
+    return S_OK;
+}
+
+/* The publisher ID in a family name: the first 64 bits of the SHA-256 of the
+ * publisher (UTF-16LE), in 13 base-32 digits (Crockford's alphabet). */
+static HRESULT publisher_id( const WCHAR *publisher, WCHAR out[14] )
+{
+    static const char digits[] = "0123456789abcdefghjkmnpqrstvwxyz";
+    BYTE hash[32];
+    UINT64 bits = 0;
+    int i;
+
+    if (BCryptHash( BCRYPT_SHA256_ALG_HANDLE, NULL, 0, (BYTE *)publisher, wcslen( publisher ) * sizeof(WCHAR),
+                    hash, sizeof(hash) ))
+        return E_FAIL;
+    for (i = 0; i < 8; i++) bits = (bits << 8) | hash[i];
+    /* 64 bits and a zero bit appended make 13 groups of five */
+    for (i = 0; i < 13; i++)
+    {
+        int shift = 59 - 5 * i;
+        UINT64 v = shift >= 0 ? bits >> shift : bits << -shift;
+        out[i] = digits[v & 31];
+    }
+    out[13] = 0;
+    return S_OK;
+}
