+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAppxManifestApplicationsEnumerator_iface.lpVtbl = &app_enum_vtbl;
+    impl->ref = 1;
+    impl->manifest = m;
+    IAppxManifestReader_AddRef( iface );
+    *out = &impl->IAppxManifestApplicationsEnumerator_iface;
+    return S_OK;
