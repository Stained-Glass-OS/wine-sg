+static HRESULT parse_manifest( struct manifest *m )
+{
+    const WCHAR *path[8] = {0};
+    WCHAR *pending_prop = NULL, *version = NULL, *arch = NULL;
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    HGLOBAL mem;
+    XmlNodeType type;
+    BOOL have_identity = FALSE;
+    HRESULT hr;
+
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, m->size ? m->size : 1 ))) return E_OUTOFMEMORY;
+    memcpy( GlobalLock( mem ), m->data, m->size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, &stream ))) { GlobalFree( mem ); return hr; }
+    if (FAILED(hr = CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL ))) goto done;
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (FAILED(hr = IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+
+    while ((hr = IXmlReader_Read( reader, &type )) == S_OK)
+    {
+        const WCHAR *name, *text;
+        UINT depth;
+
+        if (type == XmlNodeType_Text && pending_prop)
+        {
+            if (FAILED(hr = IXmlReader_GetValue( reader, &text, NULL ))) break;
+            if (FAILED(hr = add_value( &m->props, &m->prop_count, pending_prop, text ))) break;
+            free( pending_prop );
+            pending_prop = NULL;
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        free( pending_prop );
+        pending_prop = NULL;
+        if (FAILED(hr = IXmlReader_GetLocalName( reader, &name, NULL ))) break;
+        if (FAILED(hr = IXmlReader_GetDepth( reader, &depth ))) break;
+        if (depth >= ARRAY_SIZE(path)) continue;
+        /* path[] holds the element names of the current branch; the reader
+         * keeps the strings valid only until the next Read, so only compare
+         * against constants below. */
+        if (!depth)
+        {
+            if (wcscmp( name, L"Package" )) { hr = APPX_E_INVALID_MANIFEST; break; }
+            path[0] = L"Package";
+            continue;
+        }
+        path[depth] = !wcscmp( name, L"Identity" ) ? L"Identity" : !wcscmp( name, L"Properties" ) ? L"Properties" :
+                      !wcscmp( name, L"Applications" ) ? L"Applications" : !wcscmp( name, L"Application" ) ? L"Application" :
+                      !wcscmp( name, L"Capabilities" ) ? L"Capabilities" : !wcscmp( name, L"Dependencies" ) ? L"Dependencies" : L"";
+
+        if (depth == 1 && !wcscmp( name, L"Identity" ))
+        {
+            if (have_identity) { hr = APPX_E_INVALID_MANIFEST; break; }
+            have_identity = TRUE;
+            if (FAILED(hr = attribute( reader, L"Name", &m->identity.name ))) break;
+            if (FAILED(hr = attribute( reader, L"Publisher", &m->identity.publisher ))) break;
+            if (FAILED(hr = attribute( reader, L"Version", &version ))) break;
+            if (FAILED(hr = attribute( reader, L"ProcessorArchitecture", &arch ))) break;
+            if (FAILED(hr = attribute( reader, L"ResourceId", &m->identity.resource_id ))) break;
+        }
+        else if (depth == 2 && !wcscmp( path[1], L"Properties" ))
+        {
+            if (!(pending_prop = strdupW( name ))) { hr = E_OUTOFMEMORY; break; }
+        }
+        else if (depth == 2 && !wcscmp( path[1], L"Applications" ) && !wcscmp( name, L"Application" ))
+        {
+            struct application *apps;
+            if (m->app_count >= 100) { hr = APPX_E_INVALID_MANIFEST; break; }
+            if (!(apps = realloc( m->apps, (m->app_count + 1) * sizeof(*apps) ))) { hr = E_OUTOFMEMORY; break; }
+            m->apps = apps;
+            memset( &apps[m->app_count], 0, sizeof(*apps) );
+            m->app_count++;
+            if (FAILED(hr = all_attributes( reader, &apps[m->app_count - 1] ))) break;
+        }
+        else if (depth == 3 && !wcscmp( path[2], L"Application" ) && !wcscmp( name, L"VisualElements" ) && m->app_count)
+        {
+            if (FAILED(hr = all_attributes( reader, &m->apps[m->app_count - 1] ))) break;
+        }
+        else if (depth == 2 && !wcscmp( path[1], L"Capabilities" ) && !wcscmp( name, L"Capability" ))
+        {
+            WCHAR *cap = NULL;
+            unsigned int i;
+            if (FAILED(hr = attribute( reader, L"Name", &cap ))) break;
+            for (i = 0; cap && i < ARRAY_SIZE(capability_names); i++)
+                if (!wcscmp( cap, capability_names[i].name )) m->capabilities |= capability_names[i].flag;
+            free( cap );
+        }
+        else if (depth == 2 && !wcscmp( path[1], L"Dependencies" ) && !wcscmp( name, L"TargetDeviceFamily" ) &&
+                 !m->os_min_version)
+        {
+            if (FAILED(hr = attribute( reader, L"MinVersion", &m->os_min_version ))) break;
+            if (FAILED(hr = attribute( reader, L"MaxVersionTested", &m->os_max_version_tested ))) break;
+        }
+    }
+    free( pending_prop );
+    if (hr == S_FALSE) hr = S_OK;   /* end of input */
+    if (FAILED(hr))
+    {
+        WARN( "manifest parse failed, hr %#lx\n", hr );
+        if (hr != E_OUTOFMEMORY) hr = APPX_E_INVALID_MANIFEST;
+        goto done;
+    }
+    if (!have_identity || !m->identity.name || !m->identity.name[0] || !m->identity.publisher ||
+        !m->identity.publisher[0] || FAILED(identity_parse_version( version, &m->identity.version )) ||
+        FAILED(parse_architecture( arch, &m->identity.architecture )))
+    {
+        WARN( "manifest has no valid identity\n" );
+        hr = APPX_E_INVALID_MANIFEST;
+    }
+
+done:
+    free( version );
+    free( arch );
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return hr;
+}
