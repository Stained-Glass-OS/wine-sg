+/* ---- IAppxFilesEnumerator (payload files) ------------------------------- */
+
+struct files_enum
+{
+    IAppxFilesEnumerator IAppxFilesEnumerator_iface;
+    LONG ref;
+    struct package *pkg;
+    unsigned int index;       /* into the archive's entries */
+};
+
+static inline struct files_enum *impl_from_IAppxFilesEnumerator( IAppxFilesEnumerator *iface )
+{
+    return CONTAINING_RECORD( iface, struct files_enum, IAppxFilesEnumerator_iface );
+}
+
+static void skip_footprint( struct files_enum *impl )
+{
+    while (impl->index < impl->pkg->zip->count && is_footprint( impl->pkg->zip->entries[impl->index].name ))
+        impl->index++;
+}
+
+static HRESULT WINAPI files_enum_QueryInterface( IAppxFilesEnumerator *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxFilesEnumerator ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI files_enum_AddRef( IAppxFilesEnumerator *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxFilesEnumerator( iface )->ref );
+}
+
+static ULONG WINAPI files_enum_Release( IAppxFilesEnumerator *iface )
+{
+    struct files_enum *impl = impl_from_IAppxFilesEnumerator( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IAppxPackageReader_Release( &impl->pkg->IAppxPackageReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI files_enum_GetCurrent( IAppxFilesEnumerator *iface, IAppxFile **file )
+{
+    struct files_enum *impl = impl_from_IAppxFilesEnumerator( iface );
+    if (!file) return E_POINTER;
+    if (impl->index >= impl->pkg->zip->count) return APPX_E_CORRUPT_CONTENT;
+    return file_create( impl->pkg, &impl->pkg->zip->entries[impl->index], file );
+}
+
+static HRESULT WINAPI files_enum_GetHasCurrent( IAppxFilesEnumerator *iface, BOOL *has_current )
+{
+    struct files_enum *impl = impl_from_IAppxFilesEnumerator( iface );
+    if (!has_current) return E_POINTER;
+    *has_current = impl->index < impl->pkg->zip->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI files_enum_MoveNext( IAppxFilesEnumerator *iface, BOOL *has_next )
+{
+    struct files_enum *impl = impl_from_IAppxFilesEnumerator( iface );
+    if (!has_next) return E_POINTER;
+    if (impl->index < impl->pkg->zip->count)
+    {
+        impl->index++;
+        skip_footprint( impl );
+    }
+    *has_next = impl->index < impl->pkg->zip->count;
+    return S_OK;
+}
+
+static const IAppxFilesEnumeratorVtbl files_enum_vtbl =
+{
+    files_enum_QueryInterface,
+    files_enum_AddRef,
+    files_enum_Release,
+    files_enum_GetCurrent,
+    files_enum_GetHasCurrent,
+    files_enum_MoveNext,
+};
