+static ULONG WINAPI app_Release( IAppxManifestApplication *iface )
+{
+    struct app *impl = impl_from_IAppxManifestApplication( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IAppxManifestReader_Release( &impl->manifest->IAppxManifestReader_iface );
+        free( impl );
+    }
+    return ref;
