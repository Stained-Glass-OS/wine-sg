+/*
+ * The block map (AppxBlockMap.xml) lists every file of the package but the
+ * footprint files it cannot cover (itself, [Content_Types].xml and the
+ * signature), with the hash of each 64 KiB block of the file's content. The
+ * package signature covers the block map, so the block map is what makes a
+ * signature cover the payload: every file is checked against it as it is
+ * read, as Windows does, and a package whose archive and block map disagree
+ * is refused when it is opened.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "bcrypt.h"
+#include "xmllite.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+#define BLOCK_SIZE 65536
+#define MAX_HASH   64
+
+struct blockmap_file
+{
+    WCHAR *name;
+    UINT64 size;
+    unsigned int block_count;
+    BYTE *hashes;                 /* block_count * hash_size */
+};
+
+struct content_type
+{
+    WCHAR *key;                   /* an extension (Default) or a part name (Override) */
+    WCHAR *type;
+    BOOL is_override;
+};
+
+struct package
+{
+    IAppxPackageReader IAppxPackageReader_iface;
+    LONG ref;
+    struct zip_archive *zip;
+    IAppxManifestReader *manifest;
+    BCRYPT_ALG_HANDLE hash_alg;
+    ULONG hash_size;
+    unsigned int file_count;
+    struct blockmap_file *files;
+    unsigned int type_count;
+    struct content_type *types;
+};
+
+static const WCHAR *footprint_names[] =
+{
+    L"AppxManifest.xml",                    /* APPX_FOOTPRINT_FILE_TYPE_MANIFEST */
+    L"AppxBlockMap.xml",                    /* APPX_FOOTPRINT_FILE_TYPE_BLOCKMAP */
+    L"AppxSignature.p7x",                   /* APPX_FOOTPRINT_FILE_TYPE_SIGNATURE */
+    L"AppxMetadata\\CodeIntegrity.cat",     /* APPX_FOOTPRINT_FILE_TYPE_CODEINTEGRITY */
+    L"AppxMetadata\\ContentGroupMap.xml",   /* APPX_FOOTPRINT_FILE_TYPE_CONTENTGROUPMAP */
+};
+
+/* Files the block map does not (and cannot) describe. */
+static BOOL outside_blockmap( const WCHAR *name )
+{
+    return !wcsicmp( name, L"[Content_Types].xml" ) || !wcsicmp( name, L"AppxBlockMap.xml" ) ||
+           !wcsicmp( name, L"AppxSignature.p7x" );
+}
+
+static BOOL is_footprint( const WCHAR *name )
+{
+    unsigned int i;
+    if (!wcsicmp( name, L"[Content_Types].xml" )) return TRUE;
+    for (i = 0; i < ARRAY_SIZE(footprint_names); i++) if (!wcsicmp( name, footprint_names[i] )) return TRUE;
+    return FALSE;
+}
+
+static const struct blockmap_file *blockmap_find( const struct package *pkg, const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < pkg->file_count; i++) if (!wcsicmp( pkg->files[i].name, name )) return &pkg->files[i];
+    return NULL;
+}
+
+static int b64val( WCHAR c )
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+/* Decodes exactly `size` bytes of base64; anything else is an error. */
+static BOOL base64_decode( const WCHAR *s, BYTE *out, ULONG size )
+{
+    ULONG n = 0;
+    UINT32 acc = 0;
+    int bits = 0, v;
+
+    for (; *s && *s != '='; s++)
+    {
+        if ((v = b64val( *s )) < 0) return FALSE;
+        acc = (acc << 6) | v;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            if (n >= size) return FALSE;
+            out[n++] = acc >> bits;
+        }
+    }
+    return n == size;
+}
+
+/* Checks data against a file's block hashes. */
+static HRESULT verify_blocks( const struct package *pkg, const struct blockmap_file *bm, const BYTE *data, UINT64 size )
+{
+    BYTE hash[MAX_HASH];
+    unsigned int i;
+
+    if (size != bm->size) return APPX_E_BLOCK_HASH_INVALID;
+    for (i = 0; i < bm->block_count; i++)
+    {
+        UINT64 off = (UINT64)i * BLOCK_SIZE;
+        ULONG len = size - off < BLOCK_SIZE ? size - off : BLOCK_SIZE;
+        if (BCryptHash( pkg->hash_alg, NULL, 0, (BYTE *)data + off, len, hash, pkg->hash_size ) ||
+            memcmp( hash, bm->hashes + (SIZE_T)i * pkg->hash_size, pkg->hash_size ))
+        {
+            WARN( "block %u of %s does not match the block map\n", i, debugstr_w( bm->name ) );
+            return APPX_E_BLOCK_HASH_INVALID;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT xml_reader_on( const BYTE *data, SIZE_T size, IXmlReader **reader, IStream **stream )
+{
+    HGLOBAL mem;
+    HRESULT hr;
+
+    *reader = NULL;
+    *stream = NULL;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, size ? size : 1 ))) return E_OUTOFMEMORY;
+    memcpy( GlobalLock( mem ), data, size );
+    GlobalUnlock( mem );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, stream ))) { GlobalFree( mem ); return hr; }
+    if (SUCCEEDED(hr = CreateXmlReader( &IID_IXmlReader, (void **)reader, NULL )))
+    {
+        IXmlReader_SetProperty( *reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+        hr = IXmlReader_SetInput( *reader, (IUnknown *)*stream );
+    }
+    if (FAILED(hr))
+    {
+        if (*reader) IXmlReader_Release( *reader );
+        IStream_Release( *stream );
+        *reader = NULL;
+        *stream = NULL;
+    }
+    return hr;
+}
+
+static HRESULT get_attr( IXmlReader *reader, const WCHAR *name, const WCHAR **value )
+{
+    HRESULT hr = IXmlReader_MoveToAttributeByName( reader, name, NULL );
+    *value = NULL;
+    if (hr != S_OK) return S_FALSE;
+    return IXmlReader_GetValue( reader, value, NULL );
+}
+
+static HRESULT parse_blockmap( struct package *pkg, const BYTE *data, SIZE_T size )
+{
+    IXmlReader *reader;
+    IStream *stream;
+    XmlNodeType type;
+    struct blockmap_file *cur = NULL;
+    unsigned int blocks_seen = 0;
+    BOOL have_root = FALSE;
+    HRESULT hr;
+
+    if (FAILED(hr = xml_reader_on( data, size, &reader, &stream ))) return hr;
+    while ((hr = IXmlReader_Read( reader, &type )) == S_OK)
+    {
+        const WCHAR *name, *value;
+        UINT depth;
+
+        if (type == XmlNodeType_EndElement && cur)
+        {
+            if (FAILED(IXmlReader_GetDepth( reader, &depth ))) break;
+            if (depth == 1)
+            {
+                if (blocks_seen != cur->block_count) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+                cur = NULL;
+            }
+            continue;
+        }
+        if (type != XmlNodeType_Element) continue;
+        if (FAILED(hr = IXmlReader_GetLocalName( reader, &name, NULL ))) break;
+        if (FAILED(hr = IXmlReader_GetDepth( reader, &depth ))) break;
+
+        if (depth == 0)
+        {
+            if (wcscmp( name, L"BlockMap" )) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            have_root = TRUE;
+            if (FAILED(hr = get_attr( reader, L"HashMethod", &value ))) break;
+            if (value && !wcscmp( value, L"http://www.w3.org/2001/04/xmlenc#sha256" ))
+            { pkg->hash_alg = BCRYPT_SHA256_ALG_HANDLE; pkg->hash_size = 32; }
+            else if (value && !wcscmp( value, L"http://www.w3.org/2001/04/xmldsig-more#sha384" ))
+            { pkg->hash_alg = BCRYPT_SHA384_ALG_HANDLE; pkg->hash_size = 48; }
+            else if (value && !wcscmp( value, L"http://www.w3.org/2001/04/xmlenc#sha512" ))
+            { pkg->hash_alg = BCRYPT_SHA512_ALG_HANDLE; pkg->hash_size = 64; }
+            else { WARN( "hash method %s\n", debugstr_w( value ) ); hr = APPX_E_INVALID_BLOCKMAP; break; }
+        }
+        else if (depth == 1 && !wcscmp( name, L"File" ))
+        {
+            struct blockmap_file *files;
+            const WCHAR *size_text;
+            WCHAR *end;
+            UINT64 file_size;
+            BOOL empty = IXmlReader_IsEmptyElement( reader );
+
+            if (FAILED(hr = get_attr( reader, L"Size", &size_text )) || !size_text) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            file_size = _wcstoui64( size_text, &end, 10 );
+            if (*end || !size_text[0]) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (FAILED(hr = get_attr( reader, L"Name", &value )) || !value || !value[0]) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (blockmap_find( pkg, value ) || pkg->file_count >= 0x100000) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (!(files = realloc( pkg->files, (pkg->file_count + 1) * sizeof(*files) ))) { hr = E_OUTOFMEMORY; break; }
+            pkg->files = files;
+            cur = &files[pkg->file_count];
+            memset( cur, 0, sizeof(*cur) );
+            if (!(cur->name = strdupW( value ))) { hr = E_OUTOFMEMORY; break; }
+            pkg->file_count++;
+            cur->size = file_size;
+            cur->block_count = (file_size + BLOCK_SIZE - 1) / BLOCK_SIZE;
+            if (file_size > ((UINT64)1 << 40) ||
+                !(cur->hashes = malloc( (SIZE_T)cur->block_count * pkg->hash_size + 1 )))
+            { hr = E_OUTOFMEMORY; break; }
+            blocks_seen = 0;
+            if (empty)
+            {
+                if (cur->block_count) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+                cur = NULL;
+            }
+        }
+        else if (depth == 2 && cur && !wcscmp( name, L"Block" ))
+        {
+            if (blocks_seen >= cur->block_count) { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            if (FAILED(hr = get_attr( reader, L"Hash", &value )) || !value ||
+                !base64_decode( value, cur->hashes + (SIZE_T)blocks_seen * pkg->hash_size, pkg->hash_size ))
+            { hr = APPX_E_INVALID_BLOCKMAP; break; }
+            blocks_seen++;
+        }
+    }
+    if (hr == S_FALSE) hr = S_OK;
+    if (SUCCEEDED(hr) && (cur || !have_root)) hr = APPX_E_INVALID_BLOCKMAP;
+    if (FAILED(hr) && hr != E_OUTOFMEMORY) hr = APPX_E_INVALID_BLOCKMAP;
+    IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return hr;
+}
+
+static HRESULT add_type( struct package *pkg, const WCHAR *key, const WCHAR *type, BOOL is_override )
+{
+    struct content_type *t;
+    if (pkg->type_count >= 4096) return APPX_E_CORRUPT_CONTENT;
+    if (!(t = realloc( pkg->types, (pkg->type_count + 1) * sizeof(*t) ))) return E_OUTOFMEMORY;
+    pkg->types = t;
+    t += pkg->type_count;
+    t->key = strdupW( key );
+    t->type = strdupW( type );
+    t->is_override = is_override;
+    if (!t->key || !t->type) { free( t->key ); free( t->type ); return E_OUTOFMEMORY; }
+    pkg->type_count++;
+    return S_OK;
+}
+
+static HRESULT parse_content_types( struct package *pkg, const BYTE *data, SIZE_T size )
+{
+    IXmlReader *reader;
+    IStream *stream;
+    XmlNodeType type;
+    HRESULT hr;
+
+    if (FAILED(hr = xml_reader_on( data, size, &reader, &stream ))) return hr;
+    while ((hr = IXmlReader_Read( reader, &type )) == S_OK)
+    {
+        const WCHAR *name, *key, *ctype;
+        if (type != XmlNodeType_Element) continue;
+        if (FAILED(hr = IXmlReader_GetLocalName( reader, &name, NULL ))) break;
+        if (!wcscmp( name, L"Default" ) || !wcscmp( name, L"Override" ))
+        {
+            BOOL is_override = name[0] == 'O';
+            WCHAR *k;
+            if (FAILED(hr = get_attr( reader, is_override ? L"PartName" : L"Extension", &key )) || !key) continue;
+            if (!(k = strdupW( key ))) { hr = E_OUTOFMEMORY; break; }
+            if (SUCCEEDED(hr = get_attr( reader, L"ContentType", &ctype )) && ctype)
+                hr = add_type( pkg, k, ctype, is_override );
+            free( k );
+            if (FAILED(hr)) break;
+        }
+    }
+    if (hr == S_FALSE) hr = S_OK;
+    IXmlReader_Release( reader );
+    IStream_Release( stream );
+    return FAILED(hr) && hr != E_OUTOFMEMORY ? APPX_E_CORRUPT_CONTENT : hr;
+}
+
+static const WCHAR *content_type_of( const struct package *pkg, const struct zip_entry *e )
+{
+    const WCHAR *ext = wcsrchr( e->name, '.' );
+    unsigned int i;
+
+    for (i = 0; i < pkg->type_count; i++)
+    {
+        const WCHAR *part = pkg->types[i].key, *name = e->name;
+        if (!pkg->types[i].is_override) continue;
+        if (*part == '/') part++;
+        for (;; part++, name++)
+        {
+            WCHAR a = *part == '/' ? '\\' : towlower( *part ), b = towlower( *name );
+            if (a != b) break;
+            if (!a) return pkg->types[i].type;
+        }
+    }
+    for (i = 0; ext && i < pkg->type_count; i++)
+        if (!pkg->types[i].is_override && !wcsicmp( pkg->types[i].key, ext + 1 )) return pkg->types[i].type;
+    return L"application/octet-stream";
+}
+
+/* ---- IAppxFile ---------------------------------------------------------- */
+
+struct appx_file
+{
+    IAppxFile IAppxFile_iface;
+    LONG ref;
+    struct package *pkg;
+    const struct zip_entry *entry;
+    const struct blockmap_file *blockmap;   /* NULL for files the block map cannot cover */
+};
+
+static inline struct appx_file *impl_from_IAppxFile( IAppxFile *iface )
+{
+    return CONTAINING_RECORD( iface, struct appx_file, IAppxFile_iface );
+}
+
+static HRESULT WINAPI file_QueryInterface( IAppxFile *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxFile ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    WARN( "%s not implemented.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI file_AddRef( IAppxFile *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppxFile( iface )->ref );
+}
+
+static ULONG WINAPI file_Release( IAppxFile *iface )
+{
+    struct appx_file *impl = impl_from_IAppxFile( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IAppxPackageReader_Release( &impl->pkg->IAppxPackageReader_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI file_GetCompressionOption( IAppxFile *iface, APPX_COMPRESSION_OPTION *option )
+{
+    if (!option) return E_POINTER;
+    *option = impl_from_IAppxFile( iface )->entry->method ? APPX_COMPRESSION_OPTION_NORMAL : APPX_COMPRESSION_OPTION_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_GetContentType( IAppxFile *iface, LPWSTR *content_type )
+{
+    struct appx_file *impl = impl_from_IAppxFile( iface );
+    if (!content_type) return E_POINTER;
+    return (*content_type = co_strdupW( content_type_of( impl->pkg, impl->entry ) )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI file_GetName( IAppxFile *iface, LPWSTR *name )
+{
+    if (!name) return E_POINTER;
+    return (*name = co_strdupW( impl_from_IAppxFile( iface )->entry->name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI file_GetSize( IAppxFile *iface, UINT64 *size )
+{
+    if (!size) return E_POINTER;
+    *size = impl_from_IAppxFile( iface )->entry->size;
+    return S_OK;
+}
+
+static HRESULT read_verified( struct package *pkg, const struct zip_entry *e, const struct blockmap_file *bm, BYTE **data )
+{
+    HRESULT hr;
+
+    if (FAILED(hr = zip_read( pkg->zip, e, data ))) return hr;
+    if (bm && FAILED(hr = verify_blocks( pkg, bm, *data, e->size )))
+    {
+        free( *data );
+        *data = NULL;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI file_GetStream( IAppxFile *iface, IStream **stream )
+{
+    struct appx_file *impl = impl_from_IAppxFile( iface );
+    ULARGE_INTEGER size;
+    HGLOBAL mem;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE( "iface %p, stream %p (%s).\n", iface, stream, debugstr_w( impl->entry->name ) );
+    if (!stream) return E_POINTER;
+    *stream = NULL;
+    if (FAILED(hr = read_verified( impl->pkg, impl->entry, impl->blockmap, &data ))) return hr;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE, impl->entry->size ? impl->entry->size : 1 )))
+    {
+        free( data );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( GlobalLock( mem ), data, impl->entry->size );
+    GlobalUnlock( mem );
+    free( data );
+    if (FAILED(hr = CreateStreamOnHGlobal( mem, TRUE, stream ))) { GlobalFree( mem ); return hr; }
+    size.QuadPart = impl->entry->size;
+    IStream_SetSize( *stream, size );
+    return S_OK;
+}
+
+static const IAppxFileVtbl file_vtbl =
+{
+    file_QueryInterface,
+    file_AddRef,
+    file_Release,
+    file_GetCompressionOption,
+    file_GetContentType,
+    file_GetName,
+    file_GetSize,
+    file_GetStream,
+};
+
+static HRESULT file_create( struct package *pkg, const struct zip_entry *e, IAppxFile **out )
+{
+    struct appx_file *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAppxFile_iface.lpVtbl = &file_vtbl;
+    impl->ref = 1;
+    impl->pkg = pkg;
+    impl->entry = e;
+    impl->blockmap = outside_blockmap( e->name ) ? NULL : blockmap_find( pkg, e->name );
+    IAppxPackageReader_AddRef( &pkg->IAppxPackageReader_iface );
+    *out = &impl->IAppxFile_iface;
+    return S_OK;
+}
