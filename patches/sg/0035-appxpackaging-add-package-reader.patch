+HRESULT manifest_reader_create( const BYTE *data, SIZE_T size, IAppxManifestReader **reader )
+{
+    struct manifest *m;
+    HRESULT hr;
+
+    *reader = NULL;
+    if (!(m = calloc( 1, sizeof(*m) ))) return E_OUTOFMEMORY;
+    m->IAppxManifestReader_iface.lpVtbl = &manifest_vtbl;
+    m->IAppxManifestProperties_iface.lpVtbl = &properties_vtbl;
+    m->ref = 1;
+    if (!(m->data = malloc( size ? size : 1 )))
+    {
+        free( m );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( m->data, data, size );
+    m->size = size;
+    if (FAILED(hr = parse_manifest( m )))
+    {
+        IAppxManifestReader_Release( &m->IAppxManifestReader_iface );
+        return hr;
+    }
+    TRACE( "package %s version %s\n", debugstr_w( m->identity.name ), wine_dbgstr_longlong( m->identity.version ) );
+    *reader = &m->IAppxManifestReader_iface;
+    return S_OK;
+}
