+static HRESULT WINAPI appx_factory_QueryInterface( IAppxFactory *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppxFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI appx_factory_AddRef( IAppxFactory *iface ) { return 2; }
+static ULONG WINAPI appx_factory_Release( IAppxFactory *iface ) { return 1; }
+
+static HRESULT WINAPI appx_factory_CreatePackageWriter( IAppxFactory *iface, IStream *output,
+                                                        APPX_PACKAGE_SETTINGS *settings, IAppxPackageWriter **writer )
+{
+    FIXME( "iface %p, output %p, settings %p, writer %p stub!\n", iface, output, settings, writer );
+    return E_NOTIMPL;
+}
