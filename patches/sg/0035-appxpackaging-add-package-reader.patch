+/*
+ * An AppX package is a ZIP file (PKWARE APPNOTE), usually with ZIP64
+ * records, whose entries are stored or deflated. Part names follow OPC:
+ * '/'-separated in the archive and percent-encoded where needed; the AppX API
+ * names files with '\\' and decoded. Everything here reads untrusted input,
+ * so every size and offset is checked against the stream.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "zlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+#define SIG_LOCAL        0x04034b50
+#define SIG_CENTRAL      0x02014b50
+#define SIG_END          0x06054b50
+#define SIG_END64        0x06064b50
+#define SIG_END64_LOC    0x07064b50
+
+#define MAX_ENTRIES      0x100000
+#define MAX_ENTRY_SIZE   ((UINT64)1 << 31)   /* entries are decompressed into memory */
+
+/* Wine's zlib has no default allocator. */
+static voidpf zip_zalloc( voidpf opaque, uInt items, uInt size )
+{
+    return (UINT64)items * size > 0x7fffffff ? NULL : malloc( items * size );
+}
+
+static void zip_zfree( voidpf opaque, voidpf address )
+{
+    free( address );
+}
+
+static UINT16 get16( const BYTE *p ) { return p[0] | (p[1] << 8); }
+static UINT32 get32( const BYTE *p ) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((UINT32)p[3] << 24); }
+static UINT64 get64( const BYTE *p ) { return get32( p ) | ((UINT64)get32( p + 4 ) << 32); }
+
+static HRESULT read_at( struct zip_archive *zip, UINT64 offset, void *buf, ULONG size )
+{
+    LARGE_INTEGER pos;
+    ULONG done = 0;
+    HRESULT hr;
+
+    if (offset > zip->stream_size || size > zip->stream_size - offset) return APPX_E_CORRUPT_CONTENT;
+    pos.QuadPart = offset;
+    EnterCriticalSection( &zip->cs );
+    if (SUCCEEDED(hr = IStream_Seek( zip->stream, pos, STREAM_SEEK_SET, NULL )))
+        hr = IStream_Read( zip->stream, buf, size, &done );
+    LeaveCriticalSection( &zip->cs );
+    if (FAILED(hr)) return hr;
+    return done == size ? S_OK : APPX_E_CORRUPT_CONTENT;
+}
+
+static int hexval( char c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* OPC part name -> AppX file name: percent-decode (as UTF-8), '/' -> '\\'. */
+static WCHAR *decode_name( const char *raw, UINT16 len )
+{
+    char *bytes = malloc( len + 1 );
+    WCHAR *name;
+    int n = 0, i, wlen;
+
+    if (!bytes) return NULL;
+    for (i = 0; i < len; i++)
+    {
+        int hi, lo;
+        if (raw[i] == '%' && i + 2 < len && (hi = hexval( raw[i + 1] )) >= 0 && (lo = hexval( raw[i + 2] )) >= 0)
+        {
+            bytes[n++] = (hi << 4) | lo;
+            i += 2;
+        }
+        else bytes[n++] = raw[i] == '/' ? '\\' : raw[i];
+    }
+    bytes[n] = 0;
+    wlen = MultiByteToWideChar( CP_UTF8, 0, bytes, n + 1, NULL, 0 );
+    if (wlen <= 0 || !(name = malloc( wlen * sizeof(WCHAR) )))
+    {
+        free( bytes );
+        return NULL;
+    }
+    MultiByteToWideChar( CP_UTF8, 0, bytes, n + 1, name, wlen );
+    free( bytes );
+    return name;
+}
+
+static HRESULT find_central_directory( struct zip_archive *zip, UINT64 *offset, UINT64 *size, UINT64 *count )
+{
+    BYTE *tail;
+    ULONG tail_size = zip->stream_size < 0x10000 + 22 ? zip->stream_size : 0x10000 + 22;
+    UINT64 tail_start = zip->stream_size - tail_size;
+    int i;
+    HRESULT hr;
+
+    if (tail_size < 22) return APPX_E_CORRUPT_CONTENT;
+    if (!(tail = malloc( tail_size ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = read_at( zip, tail_start, tail, tail_size ))) goto done;
+
+    hr = APPX_E_CORRUPT_CONTENT;
+    for (i = tail_size - 22; i >= 0; i--)
+    {
+        if (get32( tail + i ) != SIG_END) continue;
+        /* the comment must run exactly to the end of the file */
+        if (i + 22 + get16( tail + i + 20 ) != tail_size) continue;
+        if (get16( tail + i + 4 ) || get16( tail + i + 6 )) { hr = APPX_E_CORRUPT_CONTENT; break; }  /* multi-disk */
+        *count = get16( tail + i + 10 );
+        *size = get32( tail + i + 12 );
+        *offset = get32( tail + i + 16 );
+        hr = S_OK;
+        /* ZIP64: a locator right before the end record points at the real one */
+        if (tail_start + i >= 20)
+        {
+            BYTE loc[20], end64[56];
+            if (SUCCEEDED(read_at( zip, tail_start + i - 20, loc, 20 )) && get32( loc ) == SIG_END64_LOC)
+            {
+                if (FAILED(hr = read_at( zip, get64( loc + 8 ), end64, 56 ))) break;
+                if (get32( end64 ) != SIG_END64) { hr = APPX_E_CORRUPT_CONTENT; break; }
+                *count = get64( end64 + 32 );
+                *size = get64( end64 + 40 );
+                *offset = get64( end64 + 48 );
+            }
+        }
+        break;
+    }
+done:
+    free( tail );
+    return hr;
+}
+
+void zip_close( struct zip_archive *zip )
+{
+    unsigned int i;
+    if (!zip) return;
+    for (i = 0; i < zip->count; i++)
+    {
+        free( zip->entries[i].name );
+        free( zip->entries[i].raw_name );
+    }
+    free( zip->entries );
+    if (zip->stream) IStream_Release( zip->stream );
+    zip->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &zip->cs );
+    free( zip );
+}
+
+HRESULT zip_open( IStream *stream, struct zip_archive **out )
+{
+    struct zip_archive *zip;
+    STATSTG stat;
+    UINT64 cd_offset, cd_size, cd_count, pos;
+    BYTE *cd = NULL;
+    unsigned int i;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = IStream_Stat( stream, &stat, STATFLAG_NONAME ))) return hr;
+    if (!(zip = calloc( 1, sizeof(*zip) ))) return E_OUTOFMEMORY;
+    InitializeCriticalSectionEx( &zip->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    zip->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": zip_archive.cs");
+    zip->stream = stream;
+    IStream_AddRef( stream );
+    zip->stream_size = stat.cbSize.QuadPart;
+
+    if (FAILED(hr = find_central_directory( zip, &cd_offset, &cd_size, &cd_count ))) goto fail;
+    hr = APPX_E_CORRUPT_CONTENT;
+    if (cd_count > MAX_ENTRIES || cd_size > zip->stream_size || cd_offset > zip->stream_size - cd_size) goto fail;
+    if (!(cd = malloc( cd_size ? cd_size : 1 )) || !(zip->entries = calloc( cd_count + 1, sizeof(*zip->entries) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    if (FAILED(hr = read_at( zip, cd_offset, cd, cd_size ))) goto fail;
+
+    hr = APPX_E_CORRUPT_CONTENT;
+    for (i = 0, pos = 0; i < cd_count; i++)
+    {
+        struct zip_entry *e = &zip->entries[i];
+        UINT16 name_len, extra_len, comment_len, flags;
+        const BYTE *h = cd + pos, *extra;
+        UINT32 csize32, usize32, offset32;
+
+        if (cd_size - pos < 46 || get32( h ) != SIG_CENTRAL) goto fail;
+        flags = get16( h + 8 );
+        e->method = get16( h + 10 );
+        e->crc = get32( h + 16 );
+        csize32 = get32( h + 20 );
+        usize32 = get32( h + 24 );
+        name_len = get16( h + 28 );
+        extra_len = get16( h + 30 );
+        comment_len = get16( h + 32 );
+        offset32 = get32( h + 42 );
+        if (cd_size - pos - 46 < (UINT64)name_len + extra_len + comment_len) goto fail;
+        if (flags & 1) goto fail;                                  /* encrypted */
+        if (e->method != 0 && e->method != 8) goto fail;
+        e->compressed_size = csize32;
+        e->size = usize32;
+        e->local_header_offset = offset32;
+
+        /* ZIP64 extended information: present fields follow in this order */
+        extra = h + 46 + name_len;
+        while (extra + 4 <= h + 46 + name_len + extra_len)
+        {
+            UINT16 id = get16( extra ), len = get16( extra + 2 );
+            const BYTE *f = extra + 4, *end = extra + 4 + len;
+            if (end > h + 46 + name_len + extra_len) goto fail;
+            if (id == 1)
+            {
+                if (usize32 == 0xffffffff) { if (f + 8 > end) goto fail; e->size = get64( f ); f += 8; }
+                if (csize32 == 0xffffffff) { if (f + 8 > end) goto fail; e->compressed_size = get64( f ); f += 8; }
+                if (offset32 == 0xffffffff) { if (f + 8 > end) goto fail; e->local_header_offset = get64( f ); }
+            }
+            extra = end;
+        }
+        if (e->local_header_offset > zip->stream_size || e->compressed_size > zip->stream_size ||
+            e->size > MAX_ENTRY_SIZE)
+            goto fail;
+        if (!(e->raw_name = malloc( name_len + 1 ))) { hr = E_OUTOFMEMORY; goto fail; }
+        memcpy( e->raw_name, h + 46, name_len );
+        e->raw_name[name_len] = 0;
+        if (strlen( e->raw_name ) != name_len || !(e->name = decode_name( e->raw_name, name_len ))) goto fail;
+        zip->count = i + 1;
+        pos += 46 + (UINT64)name_len + extra_len + comment_len;
+    }
+    free( cd );
+    TRACE( "%u entries\n", zip->count );
+    *out = zip;
+    return S_OK;
+
+fail:
+    free( cd );
+    zip_close( zip );
+    return hr;
+}
+
+const struct zip_entry *zip_find( const struct zip_archive *zip, const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < zip->count; i++)
+    {
+        const WCHAR *a = zip->entries[i].name, *b = name;
+        /* part names compare case-insensitively (OPC); '/' and '\\' alike */
+        for (;; a++, b++)
+        {
+            WCHAR ca = *a == '/' ? '\\' : towlower( *a ), cb = *b == '/' ? '\\' : towlower( *b );
+            if (ca != cb) break;
+            if (!ca) return &zip->entries[i];
+        }
+    }
+    return NULL;
+}
+
+HRESULT zip_data_offset( struct zip_archive *zip, const struct zip_entry *e, UINT64 *offset )
+{
+    BYTE h[30];
+    HRESULT hr;
+
+    if (FAILED(hr = read_at( zip, e->local_header_offset, h, 30 ))) return hr;
+    if (get32( h ) != SIG_LOCAL) return APPX_E_CORRUPT_CONTENT;
+    *offset = e->local_header_offset + 30 + get16( h + 26 ) + get16( h + 28 );
+    if (*offset > zip->stream_size || e->compressed_size > zip->stream_size - *offset) return APPX_E_CORRUPT_CONTENT;
+    return S_OK;
+}
+
+HRESULT zip_read( struct zip_archive *zip, const struct zip_entry *e, BYTE **data )
+{
+    BYTE *out;
+    UINT64 offset;
+    HRESULT hr;
+
+    *data = NULL;
+    if (FAILED(hr = zip_data_offset( zip, e, &offset ))) return hr;
+    if (!(out = malloc( e->size ? e->size : 1 ))) return E_OUTOFMEMORY;
+
+    if (e->method == 0)
+    {
+        if (e->compressed_size != e->size) { free( out ); return APPX_E_CORRUPT_CONTENT; }
+        if (FAILED(hr = read_at( zip, offset, out, e->size ))) { free( out ); return hr; }
+    }
+    else
+    {
+        z_stream z = {0};
+        UINT64 left = e->compressed_size;
+        BYTE chunk[65536];
+        int ret = Z_OK;
+
+        z.zalloc = zip_zalloc;
+        z.zfree = zip_zfree;
+        if (inflateInit2( &z, -MAX_WBITS ) != Z_OK) { free( out ); return E_OUTOFMEMORY; }
+        z.next_out = out;
+        z.avail_out = e->size;
+        while (left && ret != Z_STREAM_END)
+        {
+            ULONG n = left < sizeof(chunk) ? left : sizeof(chunk);
+            if (FAILED(hr = read_at( zip, offset, chunk, n ))) break;
+            offset += n;
+            left -= n;
+            z.next_in = chunk;
+            z.avail_in = n;
+            ret = inflate( &z, Z_NO_FLUSH );
+            if (ret != Z_OK && ret != Z_STREAM_END && !(ret == Z_BUF_ERROR && !z.avail_out && !z.avail_in))
+            {
+                hr = APPX_E_CORRUPT_CONTENT;
+                break;
+            }
+            /* output full but input remains: more data than the header says */
+            if (!z.avail_out && z.avail_in && ret != Z_STREAM_END) { hr = APPX_E_CORRUPT_CONTENT; break; }
+        }
+        if (SUCCEEDED(hr) && z.total_out != e->size) hr = APPX_E_CORRUPT_CONTENT;
+        inflateEnd( &z );
+        if (FAILED(hr)) { free( out ); return hr; }
+    }
+    if (crc32( 0, out, e->size ) != e->crc)
+    {
+        WARN( "CRC mismatch in %s\n", debugstr_w( e->name ) );
+        free( out );
+        return APPX_E_CORRUPT_CONTENT;
+    }
+    *data = out;
+    return S_OK;
+}
