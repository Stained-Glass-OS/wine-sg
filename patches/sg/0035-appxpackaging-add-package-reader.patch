+static HRESULT WINAPI package_GetPayloadFile( IAppxPackageReader *iface, LPCWSTR name, IAppxFile **file )
+{
+    struct package *pkg = impl_from_IAppxPackageReader( iface );
+    const struct zip_entry *e;
+
+    TRACE( "iface %p, name %s, file %p.\n", iface, debugstr_w( name ), file );
+    if (!name || !file) return E_POINTER;
+    *file = NULL;
+    if (is_footprint( name ) || !(e = zip_find( pkg->zip, name ))) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    return file_create( pkg, e, file );
+}
+
+static HRESULT WINAPI package_GetPayloadFiles( IAppxPackageReader *iface, IAppxFilesEnumerator **files )
+{
+    struct package *pkg = impl_from_IAppxPackageReader( iface );
+    struct files_enum *impl;
+
+    TRACE( "iface %p, files %p.\n", iface, files );
+    if (!files) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAppxFilesEnumerator_iface.lpVtbl = &files_enum_vtbl;
+    impl->ref = 1;
+    impl->pkg = pkg;
+    IAppxPackageReader_AddRef( iface );
+    skip_footprint( impl );
+    *files = &impl->IAppxFilesEnumerator_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI package_GetManifest( IAppxPackageReader *iface, IAppxManifestReader **manifest )
+{
+    struct package *pkg = impl_from_IAppxPackageReader( iface );
+
+    TRACE( "iface %p, manifest %p.\n", iface, manifest );
+    if (!manifest) return E_POINTER;
+    *manifest = pkg->manifest;
+    IAppxManifestReader_AddRef( pkg->manifest );
+    return S_OK;
+}
+
+static const IAppxPackageReaderVtbl package_vtbl =
+{
+    package_QueryInterface,
+    package_AddRef,
+    package_Release,
+    package_GetBlockMap,
+    package_GetFootprintFile,
+    package_GetPayloadFile,
+    package_GetPayloadFiles,
+    package_GetManifest,
+};
+
+HRESULT package_reader_create( IStream *stream, IAppxPackageReader **out )
+{
+    const struct zip_entry *manifest, *blockmap, *types;
+    struct package *pkg;
+    BYTE *data;
+    unsigned int i;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(pkg = calloc( 1, sizeof(*pkg) ))) return E_OUTOFMEMORY;
+    pkg->IAppxPackageReader_iface.lpVtbl = &package_vtbl;
+    pkg->ref = 1;
+    if (FAILED(hr = zip_open( stream, &pkg->zip ))) goto fail;
+
+    /* A bundle has no AppxManifest.xml: telling the two apart is what
+     * APPX_E_MISSING_REQUIRED_FILE is for. */
+    manifest = zip_find( pkg->zip, L"AppxManifest.xml" );
+    blockmap = zip_find( pkg->zip, L"AppxBlockMap.xml" );
+    types = zip_find( pkg->zip, L"[Content_Types].xml" );
+    if (!manifest || !blockmap || !types) { hr = APPX_E_MISSING_REQUIRED_FILE; goto fail; }
+
+    if (FAILED(hr = zip_read( pkg->zip, blockmap, &data ))) goto fail;
+    hr = parse_blockmap( pkg, data, blockmap->size );
+    free( data );
+    if (FAILED(hr)) goto fail;
+
+    /* The archive and the block map must describe the same files. */
+    for (i = 0; i < pkg->zip->count; i++)
+    {
+        const struct zip_entry *e = &pkg->zip->entries[i];
+        const struct blockmap_file *bm;
+        if (outside_blockmap( e->name )) continue;
+        if (!(bm = blockmap_find( pkg, e->name )) || bm->size != e->size)
+        {
+            WARN( "%s is not in the block map as stored\n", debugstr_w( e->name ) );
+            hr = APPX_E_INVALID_BLOCKMAP;
+            goto fail;
+        }
+    }
+    for (i = 0; i < pkg->file_count; i++)
+        if (!zip_find( pkg->zip, pkg->files[i].name ))
+        {
+            WARN( "%s is in the block map but not the package\n", debugstr_w( pkg->files[i].name ) );
+            hr = APPX_E_INVALID_BLOCKMAP;
+            goto fail;
+        }
+
+    if (FAILED(hr = zip_read( pkg->zip, types, &data ))) goto fail;
+    hr = parse_content_types( pkg, data, types->size );
+    free( data );
+    if (FAILED(hr)) goto fail;
+
+    if (FAILED(hr = read_verified( pkg, manifest, blockmap_find( pkg, manifest->name ), &data ))) goto fail;
+    hr = manifest_reader_create( data, manifest->size, &pkg->manifest );
+    free( data );
+    if (FAILED(hr)) goto fail;
+
+    TRACE( "opened a package of %u files\n", pkg->zip->count );
+    *out = &pkg->IAppxPackageReader_iface;
+    return S_OK;
+
+fail:
+    WARN( "cannot read the package, hr %#lx\n", hr );
+    package_free( pkg );
+    return hr;
+}
+
+HRESULT bundle_reader_create( IStream *stream, IAppxBundleReader **out )
+{
+    struct zip_archive *zip;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = zip_open( stream, &zip ))) return hr;
+    if (!zip_find( zip, L"AppxMetadata\\AppxBundleManifest.xml" )) hr = APPX_E_MISSING_REQUIRED_FILE;
+    else
+    {
+        FIXME( "bundles are not supported yet\n" );
+        hr = E_NOTIMPL;
+    }
+    zip_close( zip );
+    return hr;
+}
