+
+struct name_value
+{
+    WCHAR *name, *value;
+};
+
+struct application
+{
+    unsigned int count;
+    struct name_value *values;    /* Application's and VisualElements' attributes */
+};
+
+struct manifest
+{
+    IAppxManifestReader IAppxManifestReader_iface;
+    IAppxManifestProperties IAppxManifestProperties_iface;
+    LONG ref;
+    BYTE *data;
+    SIZE_T size;
+    struct package_identity identity;
+    unsigned int prop_count;
+    struct name_value *props;
+    unsigned int app_count;
+    struct application *apps;
+    APPX_CAPABILITIES capabilities;
+    WCHAR *os_min_version, *os_max_version_tested;
+};
+
+static void free_values( struct name_value *v, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) { free( v[i].name ); free( v[i].value ); }
+    free( v );
+}
+
+static HRESULT add_value( struct name_value **list, unsigned int *count, const WCHAR *name, const WCHAR *value )
+{
+    struct name_value *n;
+    if (*count >= 1024) return APPX_E_INVALID_MANIFEST;
+    if (!(n = realloc( *list, (*count + 1) * sizeof(**list) ))) return E_OUTOFMEMORY;
+    *list = n;
+    n[*count].name = strdupW( name );
+    n[*count].value = strdupW( value ? value : L"" );
+    if (!n[*count].name || !n[*count].value)
+    {
+        free( n[*count].name );
+        free( n[*count].value );
+        return E_OUTOFMEMORY;
+    }
+    (*count)++;
+    return S_OK;
+}
+
+static const WCHAR *find_value( const struct name_value *v, unsigned int count, const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) if (!wcscmp( v[i].name, name )) return v[i].value;
+    return NULL;
+}
+
+static HRESULT attribute( IXmlReader *reader, const WCHAR *name, WCHAR **value )
+{
+    const WCHAR *v;
+    HRESULT hr;
+
+    *value = NULL;
+    hr = IXmlReader_MoveToAttributeByName( reader, name, NULL );
+    if (hr != S_OK) return S_OK;
+    if (FAILED(hr = IXmlReader_GetValue( reader, &v, NULL ))) return hr;
+    if (!(*value = strdupW( v ))) return E_OUTOFMEMORY;
+    IXmlReader_MoveToElement( reader );
+    return S_OK;
+}
+
+static HRESULT all_attributes( IXmlReader *reader, struct application *app )
+{
+    const WCHAR *name, *value;
+    HRESULT hr;
+
+    for (hr = IXmlReader_MoveToFirstAttribute( reader ); hr == S_OK; hr = IXmlReader_MoveToNextAttribute( reader ))
+    {
+        if (FAILED(hr = IXmlReader_GetLocalName( reader, &name, NULL ))) return hr;
+        if (FAILED(hr = IXmlReader_GetValue( reader, &value, NULL ))) return hr;
+        if (FAILED(hr = add_value( &app->values, &app->count, name, value ))) return hr;
+    }
+    IXmlReader_MoveToElement( reader );
+    return FAILED(hr) ? hr : S_OK;
+}
