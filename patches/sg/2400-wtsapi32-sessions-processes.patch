+            array[i].pUserSid = p;
+            p += sid_size;
+        }
+        else array[i].pUserSid = NULL;
+    }
+    WTSFreeMemoryExW(WTSTypeProcessInfoLevel0, arrayW, *count);
+    *(WTS_PROCESS_INFOA **)info = array;
+    return TRUE;
 }
 
