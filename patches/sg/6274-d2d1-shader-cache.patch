From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: the device contexts' shaders compiled once in a process

Every Direct2D device context compiled the same nine shaders with D3DCompile; they are compiled once in a process and the code kept. Windows.UI.Xaml makes render targets often, and with vkd3d 2.1's compiler (6273) each took about 100 ms longer: XAML's frames slowed down enough that a RepeatButton held for 30 ms repeated (test-xamlscrollparts).
---
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index e9a6240..c1b9454 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -4748,6 +4748,37 @@ static const struct ID2D1GdiInteropRenderTargetVtbl d2d_gdi_interop_render_targe
     d2d_gdi_interop_render_target_ReleaseDC,
 };
 
+/* Stained Glass OS: the shaders every device context compiles are the same; they are compiled once in
+ * a process and the compiled code kept (wine-sg 6274). A program -- Windows.UI.Xaml -- that makes
+ * render targets often compiled them every time, and vkd3d 2.1's compiler takes longer at it. */
+static CRITICAL_SECTION d2d_shader_cache_cs;
+static CRITICAL_SECTION_DEBUG d2d_shader_cache_cs_debug =
+{
+    0, 0, &d2d_shader_cache_cs,
+    { &d2d_shader_cache_cs_debug.ProcessLocksList, &d2d_shader_cache_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": d2d_shader_cache_cs") }
+};
+static CRITICAL_SECTION d2d_shader_cache_cs = { &d2d_shader_cache_cs_debug, -1, 0, 0, 0, 0 };
+static ID3D10Blob *d2d_shader_cache[16];
+
+static HRESULT d2d_compile_cached(unsigned int slot, const void *code, SIZE_T size, const char *name,
+        const char *profile, ID3D10Blob **out)
+{
+    HRESULT hr = S_OK;
+
+    if (slot >= ARRAY_SIZE(d2d_shader_cache))
+        return D3DCompile(code, size, name, NULL, NULL, "main", profile, 0, 0, out, NULL);
+    EnterCriticalSection(&d2d_shader_cache_cs);
+#ifdef SG_MUTANT_D2D_NO_SHADER_CACHE
+    if (d2d_shader_cache[slot]) { ID3D10Blob_Release(d2d_shader_cache[slot]); d2d_shader_cache[slot] = NULL; }
+#endif
+    if (!d2d_shader_cache[slot])
+        hr = D3DCompile(code, size, name, NULL, NULL, "main", profile, 0, 0, &d2d_shader_cache[slot], NULL);
+    if (SUCCEEDED(hr)) ID3D10Blob_AddRef((*out = d2d_shader_cache[slot]));
+    LeaveCriticalSection(&d2d_shader_cache_cs);
+    return hr;
+}
+
 static HRESULT d2d_device_context_init(struct d2d_device_context *render_target,
         struct d2d_device *device, IUnknown *outer_unknown, const struct d2d_device_context_ops *ops)
 {
@@ -5307,8 +5338,7 @@ static HRESULT d2d_device_context_init(struct d2d_device_context *render_target,
     {
         const struct shape_info *si = &shape_info[i];
 
-        if (FAILED(hr = D3DCompile(si->vs_code, si->vs_code_size, si->name, NULL, NULL,
-                "main", "vs_4_0", 0, 0, &compiled, NULL)))
+        if (FAILED(hr = d2d_compile_cached(1 + i, si->vs_code, si->vs_code_size, si->name, "vs_4_0", &compiled)))
         {
             WARN("Failed to compile shader for shape type %#x, hr %#lx.\n", si->shape_type, hr);
             goto err;
@@ -5348,7 +5378,7 @@ static HRESULT d2d_device_context_init(struct d2d_device_context *render_target,
         goto err;
     }
 
-    if (FAILED(hr = D3DCompile(ps_code, sizeof(ps_code) - 1, "ps", NULL, NULL, "main", "ps_4_0", 0, 0, &compiled, NULL)))
+    if (FAILED(hr = d2d_compile_cached(0, ps_code, sizeof(ps_code) - 1, "ps", "ps_4_0", &compiled)))
     {
         WARN("Failed to compile the pixel shader, hr %#lx.\n", hr);
         goto err;
