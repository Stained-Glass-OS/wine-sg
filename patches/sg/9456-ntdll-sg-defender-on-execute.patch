+/***********************************************************************
+ *           __wine_sg_defender_scan (NTDLL.@)
+ *
+ * Stained Glass OS: ask SG Defender about an open file (FILE; KIND 1 an
+ * installer package, 2 a script) or about AMSI's text (BUFFER, SIZE, NAME)
+ * before it runs. STATUS_VIRUS_INFECTED if it must not.
+ */
+NTSTATUS CDECL __wine_sg_defender_scan( HANDLE file, const void *buffer, ULONG size, const WCHAR *name, ULONG kind )
+{
+    struct sg_defender_scan_params params = { file, buffer, size, name, kind };
+
+    return WINE_UNIX_CALL( unix_sg_defender_scan, &params );
+}
