--- /dev/null
+++ b/dlls/ntdll/unix/sgdefender.c
@@ -0,0 +1,379 @@
+/*
+ * SG Defender's real-time protection on execute: before an image is mapped
+ * (a program or a DLL), before msiexec opens a package, before cmd, wscript
+ * and cscript run a script, and for AMSI's script text, the file is handed
+ * to the sg-defender service (sg-session), which asks ClamAV.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Security: the service runs as root and reads for whoever asks, so it is
+ * never told a path to open. The file goes over an AF_UNIX socket as an
+ * open descriptor (SCM_RIGHTS) -- a new one, opened here, with this
+ * process's own rights -- and the service learns who asks from SO_PEERCRED.
+ * It reads only what this process could already read. AMSI's text goes in
+ * a sealed memfd. The socket is root's, open to the Windows-side group.
+ *
+ * If the service is not there, or does not answer within the time limit,
+ * the program runs: as on Windows with Defender off, and a stuck scan never
+ * hangs a start. A detection is ERROR_VIRUS_INFECTED (225), the way Windows
+ * fails CreateProcess and LoadLibrary for one; the file has been kept in the
+ * quarantine and is removed here, as this user, if it is still the file
+ * that was scanned.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <dlfcn.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <sys/mman.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "unix_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(sgdefender);
+
+#define SG_DEFENDER_SOCKET "/run/stained-glass/defender/socket"
+
+static const char *kinds[] = { "image", "msi", "script", "amsi" };
+
+/* Wine's own install (lib/wine above ntdll.so), root's: its builtin DLLs are
+ * the package's, mapped into every process -- not asked about each time */
+static BOOL is_wine_own( const char *path, const struct stat *st )
+{
+    static char libdir[PATH_MAX];
+    static int done;
+    Dl_info info;
+    size_t len;
+
+    if (!done)
+    {
+        char *p;
+        done = 1;
+        if (dladdr( (void *)is_wine_own, &info ) && info.dli_fname && strlen( info.dli_fname ) < sizeof(libdir))
+        {
+            strcpy( libdir, info.dli_fname );
+            /* .../lib/wine/x86_64-unix/ntdll.so -> .../lib/wine/ */
+            if ((p = strrchr( libdir, '/' ))) *p = 0;
+            if ((p = strrchr( libdir, '/' ))) p[1] = 0;
+            else libdir[0] = 0;
+        }
+    }
+    /* a build tree: its own objects (a developer's, made with their umask) */
+    if (build_dir && !strncmp( path, build_dir, strlen( build_dir ) ) && path[strlen( build_dir )] == '/' &&
+        (st->st_uid == getuid() || !st->st_uid)) return TRUE;
+    if (!libdir[0] || st->st_uid || (st->st_mode & (S_IWGRP | S_IWOTH))) return FALSE;
+    len = strlen( libdir );
+    return !strncmp( path, libdir, len );
+}
+
+/* An image with Wine's builtin signature is not mapped when Wine has a
+ * builtin of that name: Wine's own is (load_builtin) -- the prefix's copies
+ * of Wine's DLLs, which every process loads. One of another name is mapped
+ * from the file, and scanned. */
+static BOOL builtin_replaces( const char *path, USHORT machine )
+{
+    const char *base = strrchr( path, '/' ), *arch;
+    char lower[256], mod[256], name[PATH_MAX], *dot;
+    struct stat st;
+    unsigned int i, n;
+
+    if (!base || !base[1] || strlen( base + 1 ) >= sizeof(lower)) return FALSE;
+    switch (machine)
+    {
+    case IMAGE_FILE_MACHINE_I386: arch = "i386-windows"; break;
+    case IMAGE_FILE_MACHINE_AMD64: arch = "x86_64-windows"; break;
+    default: return FALSE;
+    }
+    for (n = 0, base++; base[n]; n++) lower[n] = (base[n] >= 'A' && base[n] <= 'Z') ? base[n] + 32 : base[n];
+    lower[n] = 0;
+    strcpy( mod, lower );     /* a build tree's module folder: "kernel32", "notepad", "winex11.drv" */
+    if ((dot = strrchr( mod, '.' )) && (!strcmp( dot, ".dll" ) || !strcmp( dot, ".exe" ))) *dot = 0;
+    for (i = 0; dll_paths[i]; i++)
+    {
+        /* an install (lib/wine/<arch>-windows/), and a build tree (dlls/<module>/<arch>-windows/) */
+        if (snprintf( name, sizeof(name), "%s/%s/%s", dll_paths[i], arch, lower ) < (int)sizeof(name) &&
+            !stat( name, &st ) && S_ISREG( st.st_mode ) && is_wine_own( name, &st )) return TRUE;
+        if (snprintf( name, sizeof(name), "%s/%s/%s/%s", dll_paths[i], mod, arch, lower ) < (int)sizeof(name) &&
+            !stat( name, &st ) && S_ISREG( st.st_mode ) && is_wine_own( name, &st )) return TRUE;
+    }
+    if (build_dir)      /* a build tree's own: dlls/<module>/<arch>-windows/, programs/<module>/... */
+    {
+        if (snprintf( name, sizeof(name), "%s/dlls/%s/%s/%s", build_dir, mod, arch, lower ) < (int)sizeof(name) &&
+            !stat( name, &st ) && S_ISREG( st.st_mode ) && is_wine_own( name, &st )) return TRUE;
+        if (snprintf( name, sizeof(name), "%s/programs/%s/%s/%s", build_dir, mod, arch, lower ) < (int)sizeof(name) &&
+            !stat( name, &st ) && S_ISREG( st.st_mode ) && is_wine_own( name, &st )) return TRUE;
+    }
+    return FALSE;
+}
+
+static int timeout_ms(void)
+{
+    const char *t = getenv( "SG_DEFENDER_TIMEOUT_MS" );
+    int v = t ? atoi( t ) : 0;
+    return v > 0 && v < 30000 ? v : 30000;
+}
+
+/* the reply, a line: "ALLOW" or "BLOCK <id> <signature>" */
+static BOOL ask_service( int fd, const char *kind, const char *hint, char *sig, size_t sig_size )
+{
+    const char *path = getenv( "SG_DEFENDER_SOCKET" );
+    struct sockaddr_un addr = { AF_UNIX };
+    struct msghdr msg = { 0 };
+    struct iovec iov;
+    struct timeval tv;
+    union { struct cmsghdr h; char buf[CMSG_SPACE(sizeof(int))]; } ctl;
+    struct cmsghdr *cmsg;
+    char line[1200], reply[256];
+    int s, n, got = 0, ms = timeout_ms();
+    BOOL blocked = FALSE;
+
+    if (!path || !path[0]) path = SG_DEFENDER_SOCKET;
+    if (strlen( path ) >= sizeof(addr.sun_path)) return FALSE;
+    strcpy( addr.sun_path, path );
+    if ((s = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) == -1) return FALSE;
+    tv.tv_sec = ms / 1000;
+    tv.tv_usec = (ms % 1000) * 1000;
+    setsockopt( s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    setsockopt( s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv) );
+    if (connect( s, (struct sockaddr *)&addr, sizeof(addr) ) == -1)
+    {
+        /* not running, not ours to use (another group's machine), or busy: the program runs */
+        TRACE( "no SG Defender (%s): %s\n", path, strerror( errno ));
+        close( s );
+        return FALSE;
+    }
+    snprintf( line, sizeof(line), "SCAN1 %s %.1000s\n", kind, hint ? hint : "" );
+    for (n = 6; line[n]; n++) if (line[n] == '\n' && line[n + 1]) line[n] = '?';
+    iov.iov_base = line;
+    iov.iov_len = strlen( line );
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    memset( &ctl, 0, sizeof(ctl) );
+    msg.msg_control = ctl.buf;
+    msg.msg_controllen = sizeof(ctl.buf);
+    cmsg = CMSG_FIRSTHDR( &msg );
+    cmsg->cmsg_level = SOL_SOCKET;
+    cmsg->cmsg_type = SCM_RIGHTS;
+    cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+    memcpy( CMSG_DATA(cmsg), &fd, sizeof(int) );
+    if (sendmsg( s, &msg, MSG_NOSIGNAL ) == -1)
+    {
+        close( s );
+        return FALSE;
+    }
+    while (got < (int)sizeof(reply) - 1)
+    {
+        n = recv( s, reply + got, sizeof(reply) - 1 - got, 0 );
+        if (n <= 0) break;     /* the time limit, or the service went away: allowed */
+        got += n;
+        if (memchr( reply, '\n', got )) break;
+    }
+    close( s );
+    reply[got] = 0;
+    if (!strncmp( reply, "BLOCK ", 6 ))
+    {
+        const char *p = strchr( reply + 6, ' ' );
+        blocked = TRUE;
+        if (sig && sig_size)
+        {
+            snprintf( sig, sig_size, "%s", p ? p + 1 : "unknown" );
+            sig[strcspn( sig, "\r\n" )] = 0;
+        }
+    }
+    else if (got == 0 || !memchr( reply, '\n', got ))
+        WARN( "SG Defender did not answer in %d ms: allowed\n", ms );
+    return blocked;
+}
+
+/* a descriptor of our own on the same file (its own file offset: the
+ * caller's handle keeps reading where it was) */
+static int own_descriptor( int fd )
+{
+    char proc[64];
+    int ret;
+    snprintf( proc, sizeof(proc), "/proc/self/fd/%d", fd );
+    if ((ret = open( proc, O_RDONLY | O_CLOEXEC | O_NOCTTY | O_NONBLOCK )) != -1) return ret;
+    return -1;
+}
+
+/***********************************************************************
+ *           sg_defender_check_fd
+ *
+ * STATUS_VIRUS_INFECTED if the file open on FD must not run.
+ */
+NTSTATUS sg_defender_check_fd( int fd, unsigned int kind )
+{
+    return sg_defender_check_image( fd, kind, FALSE, 0 );
+}
+
+NTSTATUS sg_defender_check_image( int fd, unsigned int kind, BOOL wine_builtin, USHORT machine )
+{
+    char path[PATH_MAX], proc[64], sig[160] = "";
+    struct stat st, now;
+    ssize_t len;
+    int mine;
+
+#ifdef SG_MUTANT_DEFENDER_OFF
+    return STATUS_SUCCESS;
+#endif
+    if (fstat( fd, &st ) == -1 || !S_ISREG( st.st_mode )) return STATUS_SUCCESS;
+    snprintf( proc, sizeof(proc), "/proc/self/fd/%d", fd );
+    if ((len = readlink( proc, path, sizeof(path) - 1 )) <= 0) len = 0;
+    path[len] = 0;
+    if (kind == 0 && path[0] == '/' && is_wine_own( path, &st )) return STATUS_SUCCESS;
+#ifndef SG_MUTANT_DEFENDER_SCAN_FAKES
+    if (kind == 0 && wine_builtin && path[0] == '/' && builtin_replaces( path, machine )) return STATUS_SUCCESS;
+#endif
+    if ((mine = own_descriptor( fd )) == -1) return STATUS_SUCCESS;
+    if (!ask_service( mine, kinds[kind < ARRAY_SIZE(kinds) ? kind : 0], path, sig, sizeof(sig) ))
+    {
+        close( mine );
+        return STATUS_SUCCESS;
+    }
+    close( mine );
+    ERR( "SG Defender: %s contains %s: not run\n", path[0] ? path : "the file", sig );
+    /* kept in the quarantine: removed here, as this user, if it is still that file */
+    if (path[0] == '/' && !lstat( path, &now ) && now.st_dev == st.st_dev && now.st_ino == st.st_ino
+#ifdef SG_MUTANT_DEFENDER_KEEP
+        && 0
+#endif
+        )
+        unlink( path );
+    return STATUS_VIRUS_INFECTED;
+}
+
+/***********************************************************************
+ *           sg_defender_check_handle
+ */
+NTSTATUS sg_defender_check_handle( HANDLE file, unsigned int kind )
+{
+    return sg_defender_check_image_handle( file, kind, FALSE, 0 );
+}
+
+NTSTATUS sg_defender_check_image_handle( HANDLE file, unsigned int kind, BOOL wine_builtin, USHORT machine )
+{
+    int unix_fd, needs_close;
+    NTSTATUS status;
+
+    if (!file || server_get_unix_fd( file, FILE_READ_DATA, &unix_fd, &needs_close, NULL, NULL ))
+        return STATUS_SUCCESS;
+    status = sg_defender_check_image( unix_fd, kind, wine_builtin, machine );
+    if (needs_close) close( unix_fd );
+    return status;
+}
+
+/***********************************************************************
+ *           sg_defender_check_buffer
+ *
+ * AMSI: a script's text, in a sealed memfd.
+ */
+NTSTATUS sg_defender_check_buffer( const void *buf, SIZE_T size, const char *name )
+{
+    char sig[160] = "";
+    int fd;
+    BOOL blocked;
+
+#ifdef SG_MUTANT_DEFENDER_OFF
+    return STATUS_SUCCESS;
+#endif
+    if (!buf || !size || size > 16 * 1024 * 1024) return STATUS_SUCCESS;
+#ifdef MFD_CLOEXEC
+    fd = memfd_create( "sg-defender-amsi", MFD_CLOEXEC | MFD_ALLOW_SEALING );
+#else
+    fd = -1;
+#endif
+    if (fd == -1) return STATUS_SUCCESS;
+    if (write( fd, buf, size ) != (ssize_t)size)
+    {
+        close( fd );
+        return STATUS_SUCCESS;
+    }
+#ifdef F_ADD_SEALS
+    fcntl( fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL );
+#endif
+    blocked = ask_service( fd, "amsi", name, sig, sizeof(sig) );
+    close( fd );
+    if (!blocked) return STATUS_SUCCESS;
+    ERR( "SG Defender: script text (%s) contains %s: not run\n", name ? name : "", sig );
+    return STATUS_VIRUS_INFECTED;
+}
+
+/***********************************************************************
+ *           sg_defender_scan  (unix call from __wine_sg_defender_scan)
+ */
+NTSTATUS sg_defender_scan( void *args )
+{
+    struct sg_defender_scan_params *params = args;
+    char name[512] = "";
+
+    if (params->buffer)
+    {
+        if (params->name)
+        {
+            DWORD n = 0;
+            int len;
+            while (n < 255 && params->name[n]) n++;
+            if ((len = ntdll_wcstoumbs( params->name, n, name, sizeof(name) - 1, FALSE )) > 0) name[len] = 0;
+        }
+        return sg_defender_check_buffer( params->buffer, params->size, name );
+    }
+    return sg_defender_check_handle( params->file, params->kind );
+}
+
+#ifdef _WIN64
+
+NTSTATUS wow64_sg_defender_scan( void *args )
+{
+    struct
+    {
+        ULONG file;
+        ULONG buffer;
+        ULONG size;
+        ULONG name;
+        ULONG kind;
+    } const *params32 = args;
+    struct sg_defender_scan_params params;
+
+    params.file = ULongToHandle( params32->file );
+    params.buffer = ULongToPtr( params32->buffer );
+    params.size = params32->size;
+    params.name = ULongToPtr( params32->name );
+    params.kind = params32->kind;
+    return sg_defender_scan( &params );
+}
+
+#endif
