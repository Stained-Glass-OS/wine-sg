+/* Stained Glass OS: the scroll region (CSI r) a full-screen program sets --
+ * htop, vim, less: what scrolls when a line is added at its bottom. None set,
+ * or no longer inside the window (resized): the window. */
+static BOOL vt_region( struct screen_buffer *sb, unsigned int *top, unsigned int *bottom )
+{
+#ifndef SG_MUTANT_VT_NO_REGION
+    if (sb->vt_region_bottom && sb->vt_region_top >= (unsigned int)sb->win.top &&
+        sb->vt_region_bottom <= (unsigned int)sb->win.bottom && sb->vt_region_top < sb->vt_region_bottom)
+    {
+        *top = sb->vt_region_top;
+        *bottom = sb->vt_region_bottom;
+        return TRUE;
+    }
+#endif
+    *top = sb->win.top;
+    *bottom = sb->win.bottom;
+    return FALSE;
+}
