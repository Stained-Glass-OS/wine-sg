+/* ---- bash on a terminal of its own --------------------------------------
+ *
+ * In a console with no Unix terminal under it -- a Terminal tab, a console
+ * window (David 2026-10-04: PowerShell opened from the Start menu, "bash"
+ * did not work) -- there is no terminal to hand over. An interactive bash
+ * gets one of its own: script(1) runs it on a pseudo-terminal, what is typed
+ * goes to it as a terminal sends keys, and what it writes is shown with the
+ * console's escape sequences (ENABLE_VIRTUAL_TERMINAL_PROCESSING). The
+ * terminal's size follows the console's (stty). */
+
+struct bridge { HANDLE out_r, conout; volatile LONG done; };
+
+static DWORD WINAPI bridge_output(void *arg)
+{
+    struct bridge *b = arg;
+    char buf[8192], pend[8];
+    WCHAR wbuf[8192 + 8];
+    DWORD n, w;
+    int np = 0;
+    while (ReadFile(b->out_r, buf + 0, sizeof(buf) - 8, &n, NULL) && n) {
+        char all[8192 + 8];
+        int len = np + (int)n, keep = 0, k, wn;
+        memcpy(all, pend, np);
+        memcpy(all + np, buf, n);
+        /* a character split between two reads waits for its other half */
+        for (k = len - 1; k >= 0 && k >= len - 4; k--) {
+            unsigned char c = all[k];
+            if ((c & 0xc0) == 0x80) continue;
+            if (c >= 0xc0) {
+                int need = c >= 0xf0 ? 4 : c >= 0xe0 ? 3 : 2;
+                if (len - k < need) keep = len - k;
+            }
+            break;
+        }
+        wn = MultiByteToWideChar(CP_UTF8, 0, all, len - keep, wbuf, ARRAYSIZE(wbuf));
+        if (wn > 0) WriteConsoleW(b->conout, wbuf, wn, &w, NULL);
+        memcpy(pend, all + len - keep, keep);
+        np = keep;
+    }
+    InterlockedExchange(&b->done, 1);
+    return 0;
+}
+
+static int put(char *o, const char *s) { int n = (int)strlen(s); memcpy(o, s, n); return n; }
+
+/* a key as a terminal (xterm) sends it */
+static int key_bytes(const KEY_EVENT_RECORD *k, char *o)
+{
+    static const struct { WORD vk; const char *seq; char final; } keys[] = {
+        { VK_UP, NULL, 'A' }, { VK_DOWN, NULL, 'B' }, { VK_RIGHT, NULL, 'C' }, { VK_LEFT, NULL, 'D' },
+        { VK_HOME, NULL, 'H' }, { VK_END, NULL, 'F' },
+        { VK_INSERT, "2", '~' }, { VK_DELETE, "3", '~' }, { VK_PRIOR, "5", '~' }, { VK_NEXT, "6", '~' },
+        { VK_F1, "P", 0 }, { VK_F2, "Q", 0 }, { VK_F3, "R", 0 }, { VK_F4, "S", 0 },
+        { VK_F5, "15", '~' }, { VK_F6, "17", '~' }, { VK_F7, "18", '~' }, { VK_F8, "19", '~' },
+        { VK_F9, "20", '~' }, { VK_F10, "21", '~' }, { VK_F11, "23", '~' }, { VK_F12, "24", '~' },
+    };
+    DWORD st = k->dwControlKeyState;
+    BOOL shift = !!(st & SHIFT_PRESSED), alt = !!(st & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED)),
+         ctrl = !!(st & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED));
+    int mod = 1 + shift + 2 * alt + 4 * ctrl, n = 0;
+    unsigned int i;
+    WCHAR c = k->uChar.UnicodeChar;
+
+    for (i = 0; i < ARRAYSIZE(keys); i++) {
+        if (keys[i].vk != k->wVirtualKeyCode) continue;
+        if (!keys[i].final) {                       /* F1-F4: SS3 */
+            if (mod > 1) return sprintf(o, "\x1b[1;%d%s", mod, keys[i].seq);
+            return sprintf(o, "\x1bO%s", keys[i].seq);
+        }
+        if (!keys[i].seq)                            /* cursor keys, Home, End */
+            return mod > 1 ? sprintf(o, "\x1b[1;%d%c", mod, keys[i].final) : sprintf(o, "\x1b[%c", keys[i].final);
+        return mod > 1 ? sprintf(o, "\x1b[%s;%d~", keys[i].seq, mod) : sprintf(o, "\x1b[%s~", keys[i].seq);
+    }
+    switch (k->wVirtualKeyCode) {
+    case VK_BACK: if (alt) o[n++] = 0x1b; o[n++] = ctrl ? 0x08 : 0x7f; return n;
+    case VK_RETURN: if (alt) o[n++] = 0x1b; o[n++] = '\r'; return n;
+    case VK_TAB: return shift ? put(o, "\x1b[Z") : put(o, "\t");
+    case VK_ESCAPE: o[0] = 0x1b; return 1;
+    case VK_SPACE: if (ctrl) { o[0] = 0; return 1; } break;
+    }
+    if (!c) return 0;
+    if (alt && !ctrl) o[n++] = 0x1b;                 /* Alt+key: ESC first (Ctrl+Alt is AltGr) */
+    n += WideCharToMultiByte(CP_UTF8, 0, &c, 1, o + n, 8, NULL, NULL);
+    return n;
+}
+
+static void set_size(const WCHAR *tty, HANDLE conout, SHORT *cols, SHORT *rows)
+{
+    CONSOLE_SCREEN_BUFFER_INFO info;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR cmd[200];
+    SHORT c, r;
+    if (!tty[0] || !GetConsoleScreenBufferInfo(conout, &info)) return;
+    c = info.srWindow.Right - info.srWindow.Left + 1;
+    r = info.srWindow.Bottom - info.srWindow.Top + 1;
+    if (c == *cols && r == *rows) return;
+    *cols = c; *rows = r;
+    /* the terminal's size: its foreground program is told (SIGWINCH) */
+    swprintf(cmd, ARRAYSIZE(cmd), L"Z:\\bin\\stty -F %ls cols %d rows %d", tty, c, r);
+    if (CreateProcessW(NULL, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi)) {
+        WaitForSingleObject(pi.hProcess, 2000);
+        CloseHandle(pi.hThread); CloseHandle(pi.hProcess);
+    }
+}
+
+static int run_bridged(const WCHAR *rcfile, const WCHAR *dosrc, HANDLE conin)
+{
+    HANDLE in_w, out_r, conout, thread;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    CONSOLE_SCREEN_BUFFER_INFO info;
+    DWORD in_mode = 0, out_mode = 0, n, code = 1;
+    UINT out_cp = GetConsoleOutputCP();
+    WCHAR cmd[1400], tty[64] = L"", dostty[96], dosin[96], dosout[96];
+    SHORT cols = 80, rows = 25;
+    struct bridge b;
+    BOOL home;
+    FILE *f;
+    int i;
+
+    conout = CreateFileW(L"CONOUT$", GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (conout == INVALID_HANDLE_VALUE) return -1;
+    if (GetConsoleScreenBufferInfo(conout, &info)) {
+        cols = info.srWindow.Right - info.srWindow.Left + 1;
+        rows = info.srWindow.Bottom - info.srWindow.Top + 1;
+    }
+    swprintf(dostty, ARRAYSIZE(dostty), L"%ls.tty", dosrc);
+    swprintf(dosin, ARRAYSIZE(dosin), L"%ls.in", dosrc);
+    swprintf(dosout, ARRAYSIZE(dosout), L"%ls.out", dosrc);
+    /* Wine's pipes are the server's, which a Unix program cannot use: two
+     * FIFOs carry the keys in and the output out. bash, a login shell, on
+     * script's pseudo-terminal at the console's size; the terminal's name and
+     * bash's status where this reads them back. */
+    /* started in the user's Windows profile (a new Terminal tab, PowerShell's
+     * start): bash in the user's home, as a Linux terminal opens */
+    {
+        WCHAR here[MAX_PATH], profile[MAX_PATH];
+        DWORD hn = GetCurrentDirectoryW(MAX_PATH, here), pn = GetEnvironmentVariableW(L"USERPROFILE", profile, MAX_PATH);
+        if (hn && hn < MAX_PATH && here[hn - 1] == '\\' && hn > 3) here[--hn] = 0;
+        home = pn && pn < MAX_PATH && !wcsicmp(here, profile);
+    }
+    swprintf(cmd, ARRAYSIZE(cmd),
+             L"Z:\\bin\\sh -c \"mkfifo -m 600 %ls.in %ls.out && exec /usr/bin/script -q -f -c '%ls"
+             L"stty cols %d rows %d 2>/dev/null; tty > %ls.tty; TERM=xterm-256color bash -l; "
+             L"echo $? > %ls.tmp && mv %ls.tmp %ls' /dev/null < %ls.in > %ls.out 2>&1\"",
+             rcfile, rcfile, home ? L"cd 2>/dev/null; " : L"", cols, rows, rcfile, rcfile, rcfile, rcfile, rcfile, rcfile);
+    if (!CreateProcessW(NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi)) return -1;
+    CloseHandle(pi.hThread); CloseHandle(pi.hProcess);
+    for (i = 0; i < 100 && GetFileAttributesW(dosout) == INVALID_FILE_ATTRIBUTES; i++) Sleep(20);
+    /* opened in the order the shell opens them: each open waits for the other end */
+    in_w = CreateFileW(dosin, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);
+    out_r = in_w == INVALID_HANDLE_VALUE ? INVALID_HANDLE_VALUE : CreateFileW(dosout, GENERIC_READ, 0, NULL, OPEN_EXISTING, 0, NULL);
+    if (out_r == INVALID_HANDLE_VALUE) {
+        if (in_w != INVALID_HANDLE_VALUE) CloseHandle(in_w);
+        DeleteFileW(dosin); DeleteFileW(dosout);
+        CloseHandle(conout);
+        return -1;
+    }
+
+    GetConsoleMode(conin, &in_mode);
+    GetConsoleMode(conout, &out_mode);
+    /* keys as they are (Ctrl+C is bash's), the window's size changes too */
+    SetConsoleMode(conin, ENABLE_WINDOW_INPUT | ENABLE_EXTENDED_FLAGS);
+    SetConsoleMode(conout, ENABLE_PROCESSED_OUTPUT | ENABLE_WRAP_AT_EOL_OUTPUT | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
+    SetConsoleOutputCP(CP_UTF8);
+    b.out_r = out_r; b.conout = conout; b.done = 0;
+    thread = CreateThread(NULL, 0, bridge_output, &b, 0, NULL);
+
+    while (!b.done) {
+        INPUT_RECORD rec[64];
+        char bytes[64 * 16], *o = bytes;
+        DWORD k, w;
+        if (!tty[0] && (f = _wfopen(dostty, L"r"))) {
+            char t[64] = "";
+            if (fscanf(f, "%63s", t) == 1 && !strncmp(t, "/dev/", 5)) {
+                MultiByteToWideChar(CP_UTF8, 0, t, -1, tty, ARRAYSIZE(tty));
+                cols = rows = 0;
+            }
+            fclose(f);
+        }
+        set_size(tty, conout, &cols, &rows);
+        if (WaitForSingleObject(conin, 100) != WAIT_OBJECT_0) continue;
+        if (!ReadConsoleInputW(conin, rec, ARRAYSIZE(rec), &n)) break;
+        for (k = 0; k < n; k++) {
+            const KEY_EVENT_RECORD *key = &rec[k].Event.KeyEvent;
+            WORD r;
+            if (rec[k].EventType != KEY_EVENT || !key->bKeyDown) continue;
+            for (r = 0; r < (key->wRepeatCount ? key->wRepeatCount : 1) && o - bytes < (int)sizeof(bytes) - 16; r++)
+                o += key_bytes(key, o);
+        }
+        if (o > bytes && !WriteFile(in_w, bytes, (DWORD)(o - bytes), &w, NULL)) break;
+    }
+    CloseHandle(in_w);
+    WaitForSingleObject(thread, 2000);
+    CloseHandle(thread);
+    CloseHandle(out_r);
+    SetConsoleMode(conin, in_mode);
+    SetConsoleMode(conout, out_mode);
+    SetConsoleOutputCP(out_cp);
+    CloseHandle(conout);
+    for (i = 0; i < 40 && !(f = _wfopen(dosrc, L"r")); i++) Sleep(50);
+    if (f) { int rc; if (fscanf(f, "%d", &rc) == 1) code = rc; fclose(f); }
+    DeleteFileW(dostty); DeleteFileW(dosin); DeleteFileW(dosout);
+    return (int)code;
 }
 
