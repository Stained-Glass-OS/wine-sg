From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: security descriptions and header auth templates
 for service proxies

N-WEBSERVICES transports, step 2 (wine-sg 7812). WsCreateServiceProxy
ignored its security description; it is now the channel's (7811 honors
it). WsCreateServiceProxyFromTemplate takes WS_HTTP_HEADER_AUTH_BINDING_TEMPLATE
and WS_HTTP_SSL_HEADER_AUTH_BINDING_TEMPLATE (E_NOTIMPL before): the
template's channel properties, its header auth binding properties and
credential (none: the user's own, which goes only to Negotiate and NTLM),
and for the SSL one an SSL transport binding. include/webservices.h gets
the template structures.
---
 dlls/webservices/proxy.c | 69 ++++++++++++++++++++++++++++++++++++++--
 include/webservices.h    | 18 +++++++++++
 2 files changed, 84 insertions(+), 3 deletions(-)

diff --git a/dlls/webservices/proxy.c b/dlls/webservices/proxy.c
index d105590..9b3b0dc 100644
--- a/dlls/webservices/proxy.c
+++ b/dlls/webservices/proxy.c
@@ -124,12 +124,16 @@ static HRESULT WsCreateServiceProxy_impl( const WS_CHANNEL_TYPE type, const WS_C
 
     TRACE( "%u %u %p %p %lu %p %lu %p %p\n", type, binding, desc, proxy_props, proxy_props_count,
            channel_props, channel_props_count, handle, error );
-    if (desc) FIXME( "ignoring security description\n" );
-
     if (!handle) return E_INVALIDARG;
 
+    /* (the security description is the channel's: wine-sg 7812) */
+#ifndef SG_MUTANT_WS_PROXY_NO_DESC
+    if ((hr = WsCreateChannel( type, binding, channel_props, channel_props_count, desc, &channel,
+                               NULL )) != S_OK) return hr;
+#else
     if ((hr = WsCreateChannel( type, binding, channel_props, channel_props_count, NULL, &channel,
                                NULL )) != S_OK) return hr;
+#endif
 
     if ((hr = create_proxy( channel, proxy_props, proxy_props_count, handle )) != S_OK)
     {
@@ -165,6 +169,14 @@ static HRESULT WsCreateServiceProxyFromTemplate_impl( WS_CHANNEL_TYPE channel_ty
     WS_CHANNEL_BINDING binding;
     WS_CHANNEL *channel;
     HRESULT hr;
+    /* the header authentication templates' security description (wine-sg 7812) */
+    static WS_DEFAULT_WINDOWS_INTEGRATED_AUTH_CREDENTIAL default_cred = { { WS_DEFAULT_WINDOWS_INTEGRATED_AUTH_CREDENTIAL_TYPE } };
+    const WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE *auth = NULL;
+    WS_HTTP_HEADER_AUTH_SECURITY_BINDING auth_binding;
+    WS_SSL_TRANSPORT_SECURITY_BINDING ssl_binding;
+    WS_SECURITY_BINDING *bindings[2];
+    WS_SECURITY_DESCRIPTION sec_desc, *sec = NULL;
+    BOOL ssl = FALSE;
 
     TRACE( "%u %p %lu %u %p %lu %p %lu %p %p\n", channel_type, properties, count, type, value, size, desc,
            desc_size, handle, error );
@@ -196,6 +208,33 @@ static HRESULT WsCreateServiceProxyFromTemplate_impl( WS_CHANNEL_TYPE channel_ty
         binding = WS_HTTP_CHANNEL_BINDING;
         break;
     }
+    case WS_HTTP_HEADER_AUTH_BINDING_TEMPLATE_TYPE:
+    {
+        static const WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE none;
+        WS_HTTP_HEADER_AUTH_BINDING_TEMPLATE *http = value;
+        if (http)
+        {
+            channel_props = http->channelProperties.properties;
+            channel_props_count = http->channelProperties.propertyCount;
+        }
+        auth = http ? &http->httpHeaderAuthSecurityBinding : &none;
+        binding = WS_HTTP_CHANNEL_BINDING;
+        break;
+    }
+    case WS_HTTP_SSL_HEADER_AUTH_BINDING_TEMPLATE_TYPE:
+    {
+        static const WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE none;
+        WS_HTTP_SSL_HEADER_AUTH_BINDING_TEMPLATE *https = value;
+        if (https)
+        {
+            channel_props = https->channelProperties.properties;
+            channel_props_count = https->channelProperties.propertyCount;
+        }
+        auth = https ? &https->httpHeaderAuthSecurityBinding : &none;
+        ssl = TRUE;
+        binding = WS_HTTP_CHANNEL_BINDING;
+        break;
+    }
 #ifndef SG_MUTANT_WS2_TCPTMPL
     case WS_TCP_BINDING_TEMPLATE_TYPE:
     {
@@ -215,7 +254,31 @@ static HRESULT WsCreateServiceProxyFromTemplate_impl( WS_CHANNEL_TYPE channel_ty
         return E_NOTIMPL;
     }
 
-    if ((hr = WsCreateChannel( channel_type, binding, channel_props, channel_props_count, NULL,
+    if (auth)
+    {
+        ULONG n = 0;
+
+        memset( &auth_binding, 0, sizeof(auth_binding) );
+        auth_binding.binding.bindingType   = WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TYPE;
+        auth_binding.binding.properties    = auth->securityBindingProperties.properties;
+        auth_binding.binding.propertyCount = auth->securityBindingProperties.propertyCount;
+        /* no credential given: the user's own */
+        auth_binding.clientCredential = auth->clientCredential ? auth->clientCredential
+                                                               : &default_cred.credential;
+        if (ssl)
+        {
+            memset( &ssl_binding, 0, sizeof(ssl_binding) );
+            ssl_binding.binding.bindingType = WS_SSL_TRANSPORT_SECURITY_BINDING_TYPE;
+            bindings[n++] = &ssl_binding.binding;
+        }
+        bindings[n++] = &auth_binding.binding;
+        memset( &sec_desc, 0, sizeof(sec_desc) );
+        sec_desc.securityBindings     = bindings;
+        sec_desc.securityBindingCount = n;
+        sec = &sec_desc;
+    }
+
+    if ((hr = WsCreateChannel( channel_type, binding, channel_props, channel_props_count, sec,
                                &channel, NULL )) != S_OK) return hr;
 
     if ((hr = create_proxy( channel, properties, count, handle )) != S_OK)
diff --git a/include/webservices.h b/include/webservices.h
index fd5cea8..4132f0a 100644
--- a/include/webservices.h
+++ b/include/webservices.h
@@ -1089,6 +1089,24 @@ typedef struct _WS_HTTP_HEADER_AUTH_SECURITY_BINDING {
     WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL *clientCredential;
 } WS_HTTP_HEADER_AUTH_SECURITY_BINDING;
 
+typedef struct _WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE {
+    WS_SECURITY_BINDING_PROPERTIES securityBindingProperties;
+    WS_WINDOWS_INTEGRATED_AUTH_CREDENTIAL *clientCredential;
+} WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE;
+
+typedef struct _WS_HTTP_HEADER_AUTH_BINDING_TEMPLATE {
+    WS_CHANNEL_PROPERTIES channelProperties;
+    WS_SECURITY_PROPERTIES securityProperties;
+    WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE httpHeaderAuthSecurityBinding;
+} WS_HTTP_HEADER_AUTH_BINDING_TEMPLATE;
+
+typedef struct _WS_HTTP_SSL_HEADER_AUTH_BINDING_TEMPLATE {
+    WS_CHANNEL_PROPERTIES channelProperties;
+    WS_SECURITY_PROPERTIES securityProperties;
+    WS_SSL_TRANSPORT_SECURITY_BINDING_TEMPLATE sslTransportSecurityBinding;
+    WS_HTTP_HEADER_AUTH_SECURITY_BINDING_TEMPLATE httpHeaderAuthSecurityBinding;
+} WS_HTTP_SSL_HEADER_AUTH_BINDING_TEMPLATE;
+
 struct _WS_HTTP_BINDING_TEMPLATE {
     WS_CHANNEL_PROPERTIES channelProperties;
 };
-- 
2.47.3

