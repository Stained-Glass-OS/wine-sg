From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer, win32u: an appbar's space comes off the work area

On Windows an appbar (SHAppBarMessage ABM_SETPOS) reserves its edge of the
screen: the work area shrinks, so maximized and snapped windows make room --
the docked Magnifier and the docked On-Screen Keyboard rely on it. Wine's
explorer kept the appbars' rectangles and never touched the work area. Now
every ABM_SETPOS and ABM_REMOVE sets it (0074's global SPI_SETWORKAREA) to
the screen less the taskbar and every appbar's space; an appbar whose window
is gone is dropped and gives its space back.

win32u answered SPI_GETWORKAREA from a value cached for the life of the
process, so a running program never saw the work area change after its
first query (0074 made the change global; the cache hid it). It now reads
the primary monitor's work area each time -- the monitors themselves are
re-read only when their serial says they changed.

Gate: test/a11y-gate.sh (make test-a11y).
---
--- a/programs/explorer/appbar.c
+++ b/programs/explorer/appbar.c
@@ -132,6 +132,40 @@
     }
 }
 
+/* Stained Glass OS: an appbar's reserved space comes off the work area, as
+ * on Windows, so maximized and snapped windows make room for it (the docked
+ * Magnifier, a toolbar). The work area is the screen less the taskbar and
+ * every appbar's space; appbars whose window is gone give theirs back. */
+static void update_work_area(void)
+{
+    struct appbar_data *data, *next;
+    HWND tray = FindWindowW( L"Shell_TrayWnd", NULL );
+    RECT work, rc;
+
+    SetRect( &work, 0, 0, GetSystemMetrics( SM_CXSCREEN ), GetSystemMetrics( SM_CYSCREEN ) );
+    if (tray && IsWindowVisible( tray ) && GetWindowRect( tray, &rc ) && rc.top > work.top && rc.bottom >= work.bottom)
+        work.bottom = min( work.bottom, rc.top );
+    LIST_FOR_EACH_ENTRY_SAFE( data, next, &appbars, struct appbar_data, entry )
+    {
+        if (!IsWindow( data->hwnd ))
+        {
+            list_remove( &data->entry );
+            free( data );
+            continue;
+        }
+        if (!data->space_reserved) continue;
+        switch (data->edge)
+        {
+        case ABE_TOP: work.top = max( work.top, data->rc.bottom ); break;
+        case ABE_BOTTOM: work.bottom = min( work.bottom, data->rc.top ); break;
+        case ABE_LEFT: work.left = max( work.left, data->rc.right ); break;
+        case ABE_RIGHT: work.right = min( work.right, data->rc.left ); break;
+        }
+    }
+    TRACE( "work area %s\n", wine_dbgstr_rect( &work ) );
+    SystemParametersInfoW( SPI_SETWORKAREA, 0, &work, SPIF_SENDCHANGE );
+}
+
 static UINT_PTR handle_appbarmessage(DWORD msg, struct appbar_data_msg *abd)
 {
     struct appbar_data* data;
@@ -166,6 +200,7 @@
             send_poschanged(hwnd);
 
             free( data );
+            update_work_area();
         }
         else WARN( "removing hwnd %p not on the list\n", hwnd );
         return TRUE;
@@ -191,6 +226,7 @@
             data->edge = abd->uEdge;
             data->rc = abd->rc;
             data->space_reserved = TRUE;
+            update_work_area();
         }
         else
         {
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5924,7 +5924,10 @@
         if (!ptr) return FALSE;
 
         spi_idx = SPI_SETWORKAREA_IDX;
-        if (!spi_loaded[spi_idx])
+        /* Stained Glass OS: not cached for the life of the process -- the shell
+         * changes the work area (the taskbar, appbars such as the docked
+         * Magnifier) and every process must see the current one; the monitors
+         * are re-read only when their serial says they changed */
         {
             struct monitor *monitor;
 
