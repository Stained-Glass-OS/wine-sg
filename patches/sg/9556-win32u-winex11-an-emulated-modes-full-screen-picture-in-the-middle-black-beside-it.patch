From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winex11: an emulated mode's full-screen picture in the middle of the monitor, black beside it (9556)

With an emulated display mode (9555 in the shell's desktop, Wine's
EmulateModeset elsewhere) a full-screen window is made the whole
monitor (map_window_rects_virt_to_raw), while its window and client
rectangles are the mode's shape scaled into the middle of it -- 640x480
on a 1280x720 monitor: 960x720 at x 160. Two things were left out:

- the window's surface was put in its X window's corner: a GDI or
  DirectDraw picture was drawn at x 0..960 and its right edge cut off.
  create_window_surface now offsets the surface by where the window
  rectangle lies in the visible one, and the scaled surface its clip
  region the same way (else the picture's right part was clipped away);
- nothing painted the rest: beside the picture the monitor kept the
  program's own earlier picture, a game's windowed frame, the taskbar.
  winex11 gives such a window a black background and clears the sides
  (sg_update_letterbox), as a monitor is black beside a scaled mode on
  Windows; an ordinary window goes back to no background.

Direct3D (DXVK, Vulkan offscreen copy) already drew into the client
rectangle; only its sides were stale.

Gate: test/emufs-gate.sh (Xvfb, EmulateModeset=Y). Mutants
SG_MUTANT_EMULATED_SURFACE_CORNER (win32u/dce.c),
SG_MUTANT_EMULATED_NO_BARS (winex11.drv/window.c).
---
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -147,6 +147,7 @@ struct scaled_surface
     UINT dpi_from;
     UINT dpi_to;
     struct window_surface *shaped;  /* Stained Glass OS: the target given the shape and layering */
+    POINT inset;                    /* Stained Glass OS (9556): where the window lies in the target's window */
 };
 
 static struct scaled_surface *get_scaled_surface( struct window_surface *window_surface )
@@ -158,6 +159,10 @@ static void scaled_surface_set_clip( struct window_surface *window_surface, cons
 {
     struct scaled_surface *surface = get_scaled_surface( window_surface );
     HRGN hrgn = map_dpi_region( window_surface->clip_region, surface->dpi_from, surface->dpi_to );
+#ifndef SG_MUTANT_EMULATED_SURFACE_CORNER
+    /* the clip is the window's; the window is inset in its X window (9556) */
+    if (hrgn && (surface->inset.x || surface->inset.y)) NtGdiOffsetRgn( hrgn, surface->inset.x, surface->inset.y );
+#endif
     window_surface_set_clip( surface->target_surface, hrgn );
     if (hrgn) NtGdiDeleteObjectApp( hrgn );
 }
@@ -409,7 +414,7 @@ static RECT get_surface_rect( RECT rect )
 }
 
 void create_window_surface( HWND hwnd, BOOL create_layered, const RECT *surface_rect, UINT monitor_dpi,
-                            struct window_surface **window_surface )
+                            POINT inset, struct window_surface **window_surface )
 {
     struct window_surface *previous, *driver_surface;
     UINT dpi = get_dpi_for_window( hwnd );
@@ -417,6 +422,13 @@ void create_window_surface( HWND hwnd, BOOL create_layered, const RECT *surface_
 
 
     monitor_rect = get_surface_rect( map_dpi_rect( *surface_rect, dpi, monitor_dpi ) );
+#ifndef SG_MUTANT_EMULATED_SURFACE_CORNER
+    /* Stained Glass OS (wine-sg 9556): a full-screen window of an emulated
+     * display mode covers the whole monitor and shows the mode's picture
+     * scaled in the middle of it (map_window_rects_virt_to_raw): its surface
+     * goes there, not into the window's corner */
+    OffsetRect( &monitor_rect, inset.x, inset.y );
+#endif
     if ((driver_surface = get_driver_window_surface( *window_surface, monitor_dpi )))
     {
         /* reuse the underlying driver surface only if it also matches the target monitor rect */
@@ -446,13 +458,17 @@ void create_window_surface( HWND hwnd, BOOL create_layered, const RECT *surface_
     if ((previous = *window_surface) && previous->funcs == &scaled_surface_funcs)
     {
         struct scaled_surface *surface = get_scaled_surface( previous );
+        BOOL moved = surface->inset.x != inset.x || surface->inset.y != inset.y;
         scaled_surface_set_target( surface, driver_surface, monitor_dpi );
+        surface->inset = inset;
+        if (moved && previous->clip_region) scaled_surface_set_clip( previous, NULL, 0 );
         window_surface_release( driver_surface );
         return;
     }
     if (previous) window_surface_release( previous );
 
     *window_surface = scaled_surface_create( hwnd, surface_rect, dpi, monitor_dpi, driver_surface );
+    if (*window_surface) get_scaled_surface( *window_surface )->inset = inset;
     window_surface_release( driver_surface );
 }
 
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -50,6 +50,7 @@ extern int sg_frame_look(void);
 /* dce.c */
 extern struct window_surface dummy_surface;
 extern void create_window_surface( HWND hwnd, BOOL create_layered, const RECT *surface_rect, UINT monitor_dpi,
+                                   POINT inset,
                                    struct window_surface **window_surface );
 extern struct window_surface *get_driver_window_surface( struct window_surface *surface, UINT monitor_dpi );
 extern void erase_now( HWND hwnd, UINT rdw_flags );
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2255,7 +2255,20 @@ static struct window_surface *get_window_surface( HWND hwnd, UINT swp_flags, BOO
     else if (create_layered || is_layered) needs_surface = TRUE;
 
     if (needs_surface)
-        create_window_surface( hwnd, create_layered, surface_rect, raw_dpi, &new_surface );
+    {
+        /* Stained Glass OS (wine-sg 9556): where the window's picture lies in
+         * its X window when that is the whole monitor around an emulated mode */
+        POINT inset = {0, 0};
+        if (!is_child && monitor_rects.visible.left <= monitor_rects.window.left &&
+            monitor_rects.visible.top <= monitor_rects.window.top &&
+            monitor_rects.visible.right >= monitor_rects.window.right &&
+            monitor_rects.visible.bottom >= monitor_rects.window.bottom)
+        {
+            inset.x = monitor_rects.window.left - monitor_rects.visible.left;
+            inset.y = monitor_rects.window.top - monitor_rects.visible.top;
+        }
+        create_window_surface( hwnd, create_layered, surface_rect, raw_dpi, inset, &new_surface );
+    }
     else if (new_surface && new_surface != &dummy_surface)
     {
         window_surface_release( new_surface );
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3546,6 +3546,38 @@ static void sg_set_frame_prop( struct x11drv_win_data *data, UINT style )
     data->sg_frame_set = TRUE;
 }
 
+/* Stained Glass OS (wine-sg 9556): a full-screen window of an emulated display
+ * mode is the whole monitor, with the mode's picture scaled in the middle of it
+ * (win32u's map_window_rects_virt_to_raw); beside the picture it is black, as a
+ * monitor is beside a scaled mode on Windows. It was never painted there: a
+ * game's sides showed its own window from before, the taskbar, the desktop. */
+static void sg_update_letterbox( struct x11drv_win_data *data )
+{
+    const RECT *v = &data->rects.visible, *w = &data->rects.window;
+    BOOL bars = data->whole_window && data->whole_window != root_window && !data->embedded &&
+                v->left <= w->left && v->top <= w->top && v->right >= w->right && v->bottom >= w->bottom &&
+                !EqualRect( v, w ) && !IsRectEmpty( w );
+
+#ifdef SG_MUTANT_EMULATED_NO_BARS
+    bars = FALSE;
+#endif
+    if (!bars && !data->sg_bars) return;
+    if (bars)
+    {
+        int x = w->left - v->left, y = w->top - v->top, cx = w->right - w->left, cy = w->bottom - w->top;
+        int vw = v->right - v->left, vh = v->bottom - v->top;
+
+        /* opaque black in the window's own visual (an ARGB one has alpha) */
+        XSetWindowBackground( data->display, data->whole_window, data->vis.depth == 32 ? 0xff000000 : 0 );
+        if (y > 0) XClearArea( data->display, data->whole_window, 0, 0, vw, y, False );
+        if (vh - y - cy > 0) XClearArea( data->display, data->whole_window, 0, y + cy, vw, vh - y - cy, False );
+        if (x > 0) XClearArea( data->display, data->whole_window, 0, y, x, cy, False );
+        if (vw - x - cx > 0) XClearArea( data->display, data->whole_window, x + cx, y, vw - x - cx, cy, False );
+    }
+    else XSetWindowBackgroundPixmap( data->display, data->whole_window, None );
+    data->sg_bars = bars;
+}
+
 void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags, BOOL fullscreen,
                               const struct window_rects *new_rects, struct window_surface *surface )
 {
@@ -3638,6 +3670,7 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     if (!(data->managed && (swp_flags & SWP_STATECHANGED) && (new_style & (WS_MINIMIZE|WS_MAXIMIZE))))
     {
         sync_window_position( data, swp_flags, &old_rects );
+        sg_update_letterbox( data );
 #ifdef HAVE_LIBXSHAPE
         if (IsRectEmpty( &old_rects.window ) != IsRectEmpty( &new_rects->window ))
             sync_empty_window_shape( data, surface );
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -760,6 +760,7 @@ struct x11drv_win_data
     UINT        net_wm_fullscreen_monitors_set : 1; /* is _NET_WM_FULLSCREEN_MONITORS set */
     UINT        is_fullscreen : 1; /* is the window visible rect fullscreen */
     UINT        is_offscreen : 1; /* has been moved offscreen by the window manager */
+    UINT        sg_bars : 1;    /* Stained Glass OS: black beside an emulated mode's picture */
     UINT        parent_invalid : 1; /* is the parent host window possibly invalid */
     Window      embedder;       /* window id of embedder */
     Pixmap         icon_pixmap;
