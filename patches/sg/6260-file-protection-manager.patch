+    TRACE( "%p -> %p\n", source, target );
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!source || !target) return E_INVALIDARG;
+    return async_boolean_create_( TRUE, result );
+}
+
+static HRESULT WINAPI fpm_GetProtectionInfoAsync( IFileProtectionManagerStatics *iface, IInspectable *source,
+                                                  IAsyncOperation_FileProtectionInfo **result )
+{
