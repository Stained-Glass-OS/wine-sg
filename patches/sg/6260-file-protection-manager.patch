+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#define WIDL_using_Windows_Security_EnterpriseData
+#include "edp.h"
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(edp);
+
+/* ---- FileProtectionInfo ---- */
+
+struct info
+{
+    IFileProtectionInfo IFileProtectionInfo_iface;
+    IFileProtectionInfo2 IFileProtectionInfo2_iface;
+    LONG ref;
+    FileProtectionStatus status;
+};
+
+static inline struct info *impl_from_IFileProtectionInfo( IFileProtectionInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct info, IFileProtectionInfo_iface );
+}
+
+static HRESULT WINAPI info_QueryInterface( IFileProtectionInfo *iface, REFIID iid, void **out )
+{
+    struct info *impl = impl_from_IFileProtectionInfo( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IFileProtectionInfo ))
+        *out = &impl->IFileProtectionInfo_iface;
+    else if (IsEqualGUID( iid, &IID_IFileProtectionInfo2 ))
+        *out = &impl->IFileProtectionInfo2_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI info_AddRef( IFileProtectionInfo *iface )
+{
+    return InterlockedIncrement( &impl_from_IFileProtectionInfo( iface )->ref );
+}
+
+static ULONG WINAPI info_Release( IFileProtectionInfo *iface )
+{
+    struct info *impl = impl_from_IFileProtectionInfo( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI info_GetIids( IFileProtectionInfo *iface, ULONG *count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IFileProtectionInfo, &IID_IFileProtectionInfo2 };
+    return get_iids( count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( IFileProtectionInfo *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Security_EnterpriseData_FileProtectionInfo,
+                                wcslen( RuntimeClass_Windows_Security_EnterpriseData_FileProtectionInfo ), name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( IFileProtectionInfo *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Status( IFileProtectionInfo *iface, FileProtectionStatus *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IFileProtectionInfo( iface )->status;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_IsRoamable( IFileProtectionInfo *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Identity( IFileProtectionInfo *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;  /* no identity: an empty string */
+    return S_OK;
+}
+
+static const struct IFileProtectionInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release, info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Status, info_get_IsRoamable, info_get_Identity,
+};
+
+static inline struct info *impl_from_IFileProtectionInfo2( IFileProtectionInfo2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct info, IFileProtectionInfo2_iface );
+}
+
+static HRESULT WINAPI info2_QueryInterface( IFileProtectionInfo2 *iface, REFIID iid, void **out )
+{ return info_QueryInterface( &impl_from_IFileProtectionInfo2( iface )->IFileProtectionInfo_iface, iid, out ); }
+static ULONG WINAPI info2_AddRef( IFileProtectionInfo2 *iface )
+{ return info_AddRef( &impl_from_IFileProtectionInfo2( iface )->IFileProtectionInfo_iface ); }
+static ULONG WINAPI info2_Release( IFileProtectionInfo2 *iface )
+{ return info_Release( &impl_from_IFileProtectionInfo2( iface )->IFileProtectionInfo_iface ); }
+static HRESULT WINAPI info2_GetIids( IFileProtectionInfo2 *iface, ULONG *count, IID **iids )
+{ return info_GetIids( &impl_from_IFileProtectionInfo2( iface )->IFileProtectionInfo_iface, count, iids ); }
+static HRESULT WINAPI info2_GetRuntimeClassName( IFileProtectionInfo2 *iface, HSTRING *name )
+{ return info_GetRuntimeClassName( &impl_from_IFileProtectionInfo2( iface )->IFileProtectionInfo_iface, name ); }
+static HRESULT WINAPI info2_GetTrustLevel( IFileProtectionInfo2 *iface, TrustLevel *level )
+{ return info_GetTrustLevel( &impl_from_IFileProtectionInfo2( iface )->IFileProtectionInfo_iface, level ); }
+
+static HRESULT WINAPI info2_get_IsProtectWhileOpenSupported( IFileProtectionInfo2 *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct IFileProtectionInfo2Vtbl info2_vtbl =
+{
+    info2_QueryInterface, info2_AddRef, info2_Release, info2_GetIids, info2_GetRuntimeClassName, info2_GetTrustLevel,
+    info2_get_IsProtectWhileOpenSupported,
+};
+
+static HRESULT info_async( const char *what, IInspectable *item, IAsyncOperation_FileProtectionInfo **result )
+{
+    struct info *impl;
+
+    TRACE( "%s %p: unprotected, no identity is managed.\n", what, item );
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!item) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IFileProtectionInfo_iface.lpVtbl = &info_vtbl;
+    impl->IFileProtectionInfo2_iface.lpVtbl = &info2_vtbl;
+    impl->ref = 1;
+#ifndef SG_MUTANT_FPM_UNDETERMINED
+    impl->status = FileProtectionStatus_Unprotected;
+#else
+    impl->status = FileProtectionStatus_Undetermined;
+#endif
+    return async_protection_info_create( &impl->IFileProtectionInfo_iface, result );
+}
+
+static HRESULT not_supported( const char *what, IInspectable **result )
+{
+    /* containers and protected files need a managed identity, which there is none of */
+    FIXME( "%s: no protected containers without a managed identity.\n", what );
+    if (result) *result = NULL;
+    return E_NOTIMPL;
+}
+
+/* ---- the activation factory, which has the statics ---- */
+
+struct fpm_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IFileProtectionManagerStatics IFileProtectionManagerStatics_iface;
+    IFileProtectionManagerStatics2 IFileProtectionManagerStatics2_iface;
+    IFileProtectionManagerStatics3 IFileProtectionManagerStatics3_iface;
+};
+
+static inline struct fpm_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct fpm_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct fpm_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IFileProtectionManagerStatics ))
+        *out = &impl->IFileProtectionManagerStatics_iface;
+    else if (IsEqualGUID( iid, &IID_IFileProtectionManagerStatics2 ))
+        *out = &impl->IFileProtectionManagerStatics2_iface;
+    else if (IsEqualGUID( iid, &IID_IFileProtectionManagerStatics3 ))
+        *out = &impl->IFileProtectionManagerStatics3_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IFileProtectionManagerStatics, &IID_IFileProtectionManagerStatics2,
+                                       &IID_IFileProtectionManagerStatics3, &IID_IActivationFactory };
+    return get_iids( count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Security_EnterpriseData_FileProtectionManager,
+                                wcslen( RuntimeClass_Windows_Security_EnterpriseData_FileProtectionManager ), name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* a static class */
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release, factory_GetIids, factory_GetRuntimeClassName,
+    factory_GetTrustLevel, factory_ActivateInstance,
+};
+
+#define STATICS_IINSPECTABLE( pfx, type ) \
+    static inline struct fpm_factory *impl_from_##type( type *iface ) { return CONTAINING_RECORD( iface, struct fpm_factory, type##_iface ); } \
+    static HRESULT WINAPI pfx##_QueryInterface( type *iface, REFIID iid, void **out ) \
+    { return factory_QueryInterface( &impl_from_##type( iface )->IActivationFactory_iface, iid, out ); } \
+    static ULONG WINAPI pfx##_AddRef( type *iface ) { return 2; } \
+    static ULONG WINAPI pfx##_Release( type *iface ) { return 1; } \
+    static HRESULT WINAPI pfx##_GetIids( type *iface, ULONG *count, IID **iids ) \
+    { return factory_GetIids( &impl_from_##type( iface )->IActivationFactory_iface, count, iids ); } \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( type *iface, HSTRING *name ) \
+    { return factory_GetRuntimeClassName( &impl_from_##type( iface )->IActivationFactory_iface, name ); } \
+    static HRESULT WINAPI pfx##_GetTrustLevel( type *iface, TrustLevel *level ) \
+    { return factory_GetTrustLevel( &impl_from_##type( iface )->IActivationFactory_iface, level ); }
+
+STATICS_IINSPECTABLE( fpm, IFileProtectionManagerStatics )
+
+static HRESULT WINAPI fpm_ProtectAsync( IFileProtectionManagerStatics *iface, IInspectable *target, HSTRING identity,
+                                        IAsyncOperation_FileProtectionInfo **result )
+{
+    TRACE( "identity %s\n", debugstr_hstring( identity ) );
+    return info_async( "ProtectAsync", target, result );
+}
+
+static HRESULT WINAPI fpm_CopyProtectionAsync( IFileProtectionManagerStatics *iface, IInspectable *source,
+                                               IInspectable *target, IAsyncOperation_boolean **result )
+{
