From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.enterprisedata: FileProtectionManager, files unprotected

Windows.Security.EnterpriseData.FileProtectionManager was missing, and OneDrive looks it up. It now answers as Windows does where Windows Information Protection manages no identity: a file's protection information says it is unprotected, with no identity and not roamable; protecting or unprotecting a file leaves it unprotected; copying protection succeeds; no file is a protected container. Saving and loading protected containers need a managed identity and are not supported.
---
diff --git a/dlls/windows.security.enterprisedata/Makefile.in b/dlls/windows.security.enterprisedata/Makefile.in
index fde039e..6acb6fd 100644
--- a/dlls/windows.security.enterprisedata/Makefile.in
+++ b/dlls/windows.security.enterprisedata/Makefile.in
@@ -4,4 +4,5 @@ IMPORTS = combase uuid
 SOURCES = \
 	async.c \
 	edp.idl \
+	fileprotection.c \
 	main.c
diff --git a/dlls/windows.security.enterprisedata/async.c b/dlls/windows.security.enterprisedata/async.c
index 27f8026..986c4fb 100644
--- a/dlls/windows.security.enterprisedata/async.c
+++ b/dlls/windows.security.enterprisedata/async.c
@@ -233,6 +233,18 @@ DEFINE_ASYNC_OPERATION( boolean, L"Boolean", boolean, (void)0, *out = impl->resu
 DEFINE_ASYNC_OPERATION( HSTRING, L"String", HSTRING, WindowsDeleteString( impl->result ),
                         return WindowsDuplicateString( impl->result, out ) )
 
+DEFINE_ASYNC_OPERATION( FileProtectionInfo, L"Windows.Foundation.IAsyncOperation`1<Windows.Security.EnterpriseData.FileProtectionInfo>",
+                        IFileProtectionInfo *, if (impl->result) IFileProtectionInfo_Release( impl->result ),
+                        { *out = impl->result; if (*out) IFileProtectionInfo_AddRef( *out ); } )
+
+/* 6260: an operation whose result is a file's protection information (taken over) */
+HRESULT async_protection_info_create( IFileProtectionInfo *value, IAsyncOperation_FileProtectionInfo **out )
+{
+    HRESULT hr = async_FileProtectionInfo_create( value, out );
+    if (FAILED(hr) && value) IFileProtectionInfo_Release( value );
+    return hr;
+}
+
 /* the results every operation here has: no identity is managed */
 HRESULT async_evaluation_create( ProtectionPolicyEvaluationResult value, IAsyncOperation_ProtectionPolicyEvaluationResult **out )
 {
