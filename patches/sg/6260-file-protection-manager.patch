+/* Stained Glass OS 6260: FileProtectionManager as Windows answers it where Windows Information
+ * Protection manages no identity: every file is unprotected, protecting or unprotecting one
+ * leaves it so, nothing is a protected container.  OneDrive asks for it (activation failed). */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "activation.h"
