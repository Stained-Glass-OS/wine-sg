From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a program's display mode in the shell's desktop stays set, emulated (9555)

The session's desktop spans the host's monitors (HostMonitors=Y, 7749):
the monitors are the host's, their modes come from the X server, and a
program's ChangeDisplaySettings in the virtual desktop changes no host
mode -- it is answered DISP_CHANGE_SUCCESSFUL and recorded as the
source's current mode. The display change that follows looks at the
devices again (display_mode_changed -> update_display_cache(TRUE)), and
add_modes wrote the driver's current mode -- the monitor's own -- back
as the current one. A game asking for 640x480 was told the change
succeeded and still found the monitor's 1920x1080: its picture drawn
for 640x480 in a corner (GDI, DirectDraw), its own checks failing.

Now the mode a program set is kept while the monitor's own mode is the
one it was set on (recorded with it, SgModeBase) and the driver still
lists it; the monitor's mode is then the source's physical one, as for a
driver with a single mode. Wine's emulation then does the rest: the program
sees 640x480 everywhere, its windows are mapped onto the monitor and
their pictures scaled (monitor_virt_to_raw_ratio), keeping the shape as
Windows' display scaling does. Also, in that desktop:

- a mode asked for at a refresh rate the monitor does not run is taken
  at the monitor's own (640x480 at 60 Hz on a 144 Hz monitor, whose
  emulated modes are listed at 144, was refused; Windows' monitor would
  take 60);
- the driver is told the primary monitor's own size
  (NtUserCallOneParam_GetPrimaryMonitorRect), so the desktop window
  stays full screen while a smaller mode is emulated on it.

Gate: test/emumode-gate.sh, run in a session (the QA VM,
SG_SESSION_GATE=1): Xvfb offers one mode, the >1-mode path is the
session's Xwayland's. Mutant SG_MUTANT_EMULATED_MODE_DROPPED
(win32u/sysparams.c) caught; SG_MUTANT_EMULATED_RATE_STRICT and
SG_MUTANT_DESKTOP_FULLSCREEN_VIRT switch off the other two parts.
---
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -40,6 +40,7 @@
 WINE_DEFAULT_DEBUG_CHANNEL(system);
 
 #define WINE_ENUM_PHYSICAL_SETTINGS  ((DWORD) -3)
+#define SG_ENUM_MODE_BASE            ((DWORD) -4)  /* Stained Glass OS (9555): the monitor's mode an emulated one was set on */
 
 static LONG dpi_context; /* process DPI awareness context */
 
@@ -486,11 +487,13 @@ static BOOL write_source_mode( HKEY hkey, UINT index, const DEVMODEW *mode )
 {
     WCHAR bufferW[MAX_PATH] = {0};
 
-    assert( index == ENUM_CURRENT_SETTINGS || index == ENUM_REGISTRY_SETTINGS || index == WINE_ENUM_PHYSICAL_SETTINGS );
+    assert( index == ENUM_CURRENT_SETTINGS || index == ENUM_REGISTRY_SETTINGS || index == WINE_ENUM_PHYSICAL_SETTINGS ||
+            index == SG_ENUM_MODE_BASE );
 
     if (index == ENUM_CURRENT_SETTINGS) asciiz_to_unicode( bufferW, "Current" );
     else if (index == ENUM_REGISTRY_SETTINGS) asciiz_to_unicode( bufferW, "Registry" );
     else if (index == WINE_ENUM_PHYSICAL_SETTINGS) asciiz_to_unicode( bufferW, "Physical" );
+    else if (index == SG_ENUM_MODE_BASE) asciiz_to_unicode( bufferW, "SgModeBase" );
     else return FALSE;
 
     return set_reg_value( hkey, bufferW, REG_BINARY, &mode->dmFields, sizeof(*mode) - offsetof(DEVMODEW, dmFields) );
@@ -502,11 +505,13 @@ static BOOL read_source_mode( HKEY hkey, UINT index, DEVMODEW *mode )
     KEY_VALUE_PARTIAL_INFORMATION *value = (void *)value_buf;
     const char *key;
 
-    assert( index == ENUM_CURRENT_SETTINGS || index == ENUM_REGISTRY_SETTINGS || index == WINE_ENUM_PHYSICAL_SETTINGS );
+    assert( index == ENUM_CURRENT_SETTINGS || index == ENUM_REGISTRY_SETTINGS || index == WINE_ENUM_PHYSICAL_SETTINGS ||
+            index == SG_ENUM_MODE_BASE );
 
     if (index == ENUM_CURRENT_SETTINGS) key = "Current";
     else if (index == ENUM_REGISTRY_SETTINGS) key = "Registry";
     else if (index == WINE_ENUM_PHYSICAL_SETTINGS) key = "Physical";
+    else if (index == SG_ENUM_MODE_BASE) key = "SgModeBase";
     else return FALSE;
 
     if (!query_reg_ascii_value( hkey, key, value, sizeof(value_buf) )) return FALSE;
@@ -2007,6 +2012,40 @@ static DEVMODEW *get_virtual_modes( const DEVMODEW *current, const DEVMODEW *ini
     return modes;
 }
 
+/* Stained Glass OS (wine-sg 9555): the mode a program set on this source in the
+ * shell's desktop (add_modes), kept when the monitor's own mode (PHYSICAL) is
+ * the one recorded with it -- the monitor changed, a mode set on another is
+ * dropped -- and the driver still lists it. The record is written again. */
+static BOOL sg_keep_emulated_mode( HKEY key, const DEVMODEW *physical, UINT count, const DEVMODEW *modes,
+                                   DEVMODEW *virtual )
+{
+    DEVMODEW old = {.dmSize = sizeof(DEVMODEW)};
+    BOOL ret = FALSE;
+    UINT i;
+
+    virtual->dmSize = sizeof(*virtual);
+    if (read_source_mode( key, SG_ENUM_MODE_BASE, &old ) &&
+        old.dmPelsWidth == physical->dmPelsWidth && old.dmPelsHeight == physical->dmPelsHeight &&
+        old.dmDisplayFrequency == physical->dmDisplayFrequency &&
+        old.dmDisplayOrientation == physical->dmDisplayOrientation &&
+        read_source_mode( key, ENUM_CURRENT_SETTINGS, virtual ) &&
+        (virtual->dmPelsWidth != physical->dmPelsWidth || virtual->dmPelsHeight != physical->dmPelsHeight))
+    {
+        for (i = 0; i < count && !ret; i++)
+            ret = modes[i].dmPelsWidth == virtual->dmPelsWidth && modes[i].dmPelsHeight == virtual->dmPelsHeight &&
+                  modes[i].dmDisplayOrientation == virtual->dmDisplayOrientation;
+    }
+    if (ret)
+    {
+        /* where it is and what it shows are the monitor's */
+        virtual->dmPosition = physical->dmPosition;
+        virtual->dmDisplayOrientation = physical->dmDisplayOrientation;
+        virtual->dmFields |= DM_POSITION;
+    }
+    write_source_mode( key, SG_ENUM_MODE_BASE, physical );
+    return ret;
+}
+
 static void add_modes( const DEVMODEW *current, UINT modes_count, const DEVMODEW *modes, void *param )
 {
     struct device_manager_ctx *ctx = param;
@@ -2034,6 +2073,25 @@ static void add_modes( const DEVMODEW *current, UINT modes_count, const DEVMODEW
 
     if (modes_count > 1 || current == &detached)
     {
+#ifndef SG_MUTANT_EMULATED_MODE_DROPPED
+        /* Stained Glass OS (wine-sg 9555): the shell's desktop over the host's
+         * monitors (7749) changes no host mode -- a program's mode change in it
+         * is emulated, the picture scaled to the monitor as Windows' display
+         * scaling does (monitor_virt_to_raw_ratio). Each new look at the
+         * devices (every display change, the program's own included) wrote the
+         * driver's mode back as the current one: a game asking for 640x480 was
+         * told the change succeeded and still found the monitor's size. The
+         * mode set stays while the monitor's own mode is the one it was set on. */
+        if (current != &detached && sg_desktop_spans_host() &&
+            sg_keep_emulated_mode( source->key, current, modes_count, modes, &virtual ))
+        {
+            /* the monitor's own mode is the physical one, as for a driver
+             * with a single mode (get_virtual_modes below) */
+            write_source_mode( source->key, WINE_ENUM_PHYSICAL_SETTINGS, &physical );
+            current = &virtual;
+        }
+        else
+#endif
         reg_delete_value( source->key, physicalW );
         virtual_modes = NULL;
     }
@@ -3400,6 +3458,24 @@ RECT get_display_rect( const WCHAR *display )
     return rect;
 }
 
+/* Stained Glass OS (wine-sg 9555): the primary monitor in raw pixels, the
+ * monitor's own mode even while a program's mode is emulated on it */
+static RECT sg_primary_monitor_raw_rect(void)
+{
+    struct monitor *monitor;
+    RECT rect = {0};
+
+    if (!lock_display_devices( FALSE )) return rect;
+    LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+    {
+        if (!is_monitor_primary( monitor )) continue;
+        rect = monitor_get_rect( monitor, 0, MDT_RAW_DPI );
+        break;
+    }
+    unlock_display_devices();
+    return rect;
+}
+
 RECT get_primary_monitor_rect( UINT dpi )
 {
     struct monitor *monitor;
@@ -4163,7 +4239,20 @@ static BOOL source_get_full_mode( const struct source *source, const DEVMODEW *d
         }
     }
 
-    if ((source_mode = find_display_mode( source->modes, full_mode )) && source_mode != full_mode)
+    source_mode = find_display_mode( source->modes, full_mode );
+#ifndef SG_MUTANT_EMULATED_RATE_STRICT
+    /* Stained Glass OS (wine-sg 9555): in the shell's desktop the mode is
+     * emulated and the monitor keeps its own refresh rate: a game asking for
+     * 640x480 at 60 Hz on a 144 Hz monitor (whose emulated modes are listed at
+     * 144) was refused -- on Windows the monitor would take 60 */
+    if (!source_mode && (full_mode->dmFields & DM_DISPLAYFREQUENCY) && sg_desktop_spans_host())
+    {
+        DEVMODEW any_rate = *full_mode;
+        any_rate.dmFields &= ~DM_DISPLAYFREQUENCY;
+        if ((source_mode = find_display_mode( source->modes, &any_rate )) == &any_rate) source_mode = full_mode;
+    }
+#endif
+    if (source_mode && source_mode != full_mode)
     {
         POINTL position = full_mode->dmPosition;
         *full_mode = *source_mode;
@@ -8076,6 +8165,17 @@ ULONG_PTR WINAPI NtUserCallOneParam( ULONG_PTR arg, ULONG code )
         return realize_palette( UlongToHandle(arg) );
 
     case NtUserCallOneParam_GetPrimaryMonitorRect:
+#ifndef SG_MUTANT_DESKTOP_FULLSCREEN_VIRT
+        /* Stained Glass OS (wine-sg 9555): asked by the driver, whose desktop
+         * window is full screen when the primary monitor is the host's: the
+         * monitor's own size, not that of a mode emulated on it -- in a game's
+         * 640x480 the shell's desktop gave up being full screen */
+        if (sg_desktop_spans_host())
+        {
+            *(RECT *)arg = sg_primary_monitor_raw_rect();
+            return 1;
+        }
+#endif
         *(RECT *)arg = get_primary_monitor_rect( 0 );
         return 1;
 
