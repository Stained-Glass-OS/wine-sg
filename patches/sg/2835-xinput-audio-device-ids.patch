From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] xinput1_3, xinput1_4: XInputGetDSoundAudioDeviceGuids and XInputGetAudioDeviceIds

XInputGetDSoundAudioDeviceGuids (FIXME, ERROR_NOT_SUPPORTED) and
XInputGetAudioDeviceIds (an "@ stub" export of xinput1_4): a connected
controller has no headset, so the DirectSound guids are GUID_NULL and the
sound device ids are empty strings with length 0; ERROR_BAD_ARGUMENTS for a
user out of range or a NULL guid, ERROR_DEVICE_NOT_CONNECTED for a user
without a controller.

---
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
index 28f57e9..0783dc5 100644
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -1098,13 +1098,43 @@ DWORD WINAPI DECLSPEC_HOTPATCH XInputGetCapabilities(DWORD index, DWORD flags, X
 
 DWORD WINAPI DECLSPEC_HOTPATCH XInputGetDSoundAudioDeviceGuids(DWORD index, GUID *render_guid, GUID *capture_guid)
 {
-    FIXME("index %lu, render_guid %s, capture_guid %s stub!\n", index, debugstr_guid(render_guid),
-          debugstr_guid(capture_guid));
+    TRACE("index %lu, render_guid %p, capture_guid %p.\n", index, render_guid, capture_guid);
 
     if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
     if (!controllers[index].device) return ERROR_DEVICE_NOT_CONNECTED;
+    if (!render_guid || !capture_guid) return ERROR_BAD_ARGUMENTS;
 
-    return ERROR_NOT_SUPPORTED;
+    /* the controllers have no headset: there is no sound device to name */
+#ifndef SG_MUTANT_XINPUT_AUDIO
+    memset(render_guid, 0, sizeof(*render_guid));
+    memset(capture_guid, 0, sizeof(*capture_guid));
+#endif
+
+    return ERROR_SUCCESS;
+}
+
+DWORD WINAPI DECLSPEC_HOTPATCH XInputGetAudioDeviceIds(DWORD index, WCHAR *render_id, UINT *render_count,
+                                                       WCHAR *capture_id, UINT *capture_count)
+{
+    TRACE("index %lu, render_id %p, render_count %p, capture_id %p, capture_count %p.\n", index, render_id,
+          render_count, capture_id, capture_count);
+
+    if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+    if (!controllers[index].device) return ERROR_DEVICE_NOT_CONNECTED;
+
+    /* the controllers have no headset: the ids are empty strings, of length 0 */
+    if (render_count)
+    {
+        if (render_id && *render_count) render_id[0] = 0;
+        *render_count = 0;
+    }
+    if (capture_count)
+    {
+        if (capture_id && *capture_count) capture_id[0] = 0;
+        *capture_count = 0;
+    }
+
+    return ERROR_SUCCESS;
 }
 
 DWORD WINAPI DECLSPEC_HOTPATCH XInputGetBatteryInformation(DWORD index, BYTE type, XINPUT_BATTERY_INFORMATION* battery)
diff --git a/dlls/xinput1_4/xinput1_4.spec b/dlls/xinput1_4/xinput1_4.spec
index 22c5112..e62a336 100644
--- a/dlls/xinput1_4/xinput1_4.spec
+++ b/dlls/xinput1_4/xinput1_4.spec
@@ -5,6 +5,6 @@
 5 stdcall XInputEnable(long)
 7 stdcall XInputGetBatteryInformation(long long ptr)
 8 stdcall XInputGetKeystroke(long long ptr)
-10 stub XInputGetAudioDeviceIds(long ptr ptr ptr ptr)
+10 stdcall XInputGetAudioDeviceIds(long ptr ptr ptr ptr)
 100 stdcall XInputGetStateEx(long ptr)
 108 stdcall XInputGetCapabilitiesEx(long long long ptr)
