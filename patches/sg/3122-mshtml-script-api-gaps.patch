+static inline DOMSelection *DOMSelection_from_DispatchEx(DispatchEx *iface)
+{
+    return CONTAINING_RECORD(iface, DOMSelection, dispex);
+}
+
+static void *DOMSelection_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    DOMSelection *This = DOMSelection_from_DispatchEx(dispex);
+
+    if(IsEqualGUID(&IID_IHTMLSelection, riid))
+        return &This->IHTMLSelection_iface;
+    return NULL;
+}
+
+static void DOMSelection_traverse(DispatchEx *dispex, nsCycleCollectionTraversalCallback *cb)
+{
+    DOMSelection *This = DOMSelection_from_DispatchEx(dispex);
+    if(This->nsselection)
+        note_cc_edge((nsISupports*)This->nsselection, "nsselection", cb);
+}
+
+static void DOMSelection_unlink(DispatchEx *dispex)
+{
+    DOMSelection *This = DOMSelection_from_DispatchEx(dispex);
+    unlink_ref(&This->nsselection);
+    if(This->doc) {
+        This->doc = NULL;
+        list_remove(&This->entry);
+    }
+}
