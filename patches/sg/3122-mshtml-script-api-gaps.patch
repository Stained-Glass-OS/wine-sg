+
+HRESULT create_dom_selection(HTMLDocumentNode *doc, IHTMLSelection **ret)
+{
+    DOMSelection *selection;
+    nsISelection *nsselection;
+    nsresult nsres;
+
+    *ret = NULL;
+    if(!doc->html_document) {
+        FIXME("Not implemented for XML document\n");
+        return E_NOTIMPL;
+    }
+    nsres = nsIDOMHTMLDocument_GetSelection(doc->html_document, &nsselection);
+    if(NS_FAILED(nsres) || !nsselection)
+        return E_FAIL;
+
+    if(!(selection = calloc(1, sizeof(*selection)))) {
+        nsISelection_Release(nsselection);
+        return E_OUTOFMEMORY;
+    }
+    init_dispatch(&selection->dispex, &Selection_dispex, doc->script_global,
+                  dispex_compat_mode(&doc->node.event_target.dispex));
+    selection->IHTMLSelection_iface.lpVtbl = &DOMSelectionVtbl;
+    selection->nsselection = nsselection;
+    selection->doc = doc;
+    list_add_head(&doc->dom_selection_list, &selection->entry);
+
+    *ret = &selection->IHTMLSelection_iface;
+    return S_OK;
+}
+
+void detach_dom_selection(HTMLDocumentNode *This)
+{
+    DOMSelection *iter, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(iter, next, &This->dom_selection_list, DOMSelection, entry) {
+        iter->doc = NULL;
+        list_remove(&iter->entry);
+    }
+}
