+static HRESULT WINAPI DOMSelection_getRangeAt(IHTMLSelection *iface, LONG index, IHTMLDOMRange **ppRange)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    nsIDOMRange *nsrange = NULL;
+    LONG count = 0;
+    HRESULT hres;
+
+    TRACE("(%p)->(%ld %p)\n", This, index, ppRange);
+
+    nsISelection_GetRangeCount(This->nsselection, &count);
+    if(index < 0 || index >= count || !This->doc)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_SEL_NORANGE
+    return E_FAIL;
+#endif
+    if(NS_FAILED(nsISelection_GetRangeAt(This->nsselection, index, &nsrange)) || !nsrange)
+        return E_FAIL;
+    hres = create_dom_range(nsrange, This->doc, ppRange);
+    nsIDOMRange_Release(nsrange);
+    return hres;
+}
