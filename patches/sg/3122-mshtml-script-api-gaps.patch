+static inline HTMLPerformance *impl_from_IWineMSHTMLPerformance(IWineMSHTMLPerformance *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLPerformance, IWineMSHTMLPerformance_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(WineMSHTMLPerformance, IWineMSHTMLPerformance,
+                      impl_from_IWineMSHTMLPerformance(iface)->dispex)
+
+static double precise_time_stamp(void)
+{
+    FILETIME ft;
+    ULONGLONG now;
+
+    GetSystemTimePreciseAsFileTime(&ft);
+    /* 100ns units since 1601 to milliseconds since 1970, as get_time_stamp() has them */
+    now = (((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime) - (ULONGLONG)(369 * 365 + 89) * 86400 * 10000000;
+    return (double)now / 10000.0;
+}
+
+/* milliseconds since the start of the navigation, with the fraction */
+static HRESULT WINAPI WineMSHTMLPerformance_now(IWineMSHTMLPerformance *iface, double *p)
+{
+    HTMLPerformance *This = impl_from_IWineMSHTMLPerformance(iface);
+    double start = This->window ? (double)This->window->navigation_start_time : 0;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!start)
+        start = This->created;
+    *p = precise_time_stamp() - start;
+#ifdef SG_MUTANT_PERF_NONOW
+    *p = 0;
+#endif
+    if(*p < 0)
+        *p = 0;
+    return S_OK;
+}
+
