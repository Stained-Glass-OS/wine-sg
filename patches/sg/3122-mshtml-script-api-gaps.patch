+/* The Gecko range of a script Range object. */
+HRESULT dom_range_get_nsrange(IDispatch *disp, nsIDOMRange **ret)
+{
+    IHTMLDOMRange *range;
+    HTMLDOMRange *obj;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!disp)
+        return E_INVALIDARG;
+    hres = IDispatch_QueryInterface(disp, &IID_IHTMLDOMRange, (void**)&range);
+    if(FAILED(hres))
+        return E_INVALIDARG;
+    if(range->lpVtbl != &HTMLDOMRangeVtbl) {
+        IHTMLDOMRange_Release(range);
+        return E_INVALIDARG;
+    }
+    obj = impl_from_IHTMLDOMRange(range);
+    nsIDOMRange_AddRef(obj->nsrange);
+    *ret = obj->nsrange;
+    IHTMLDOMRange_Release(range);
+    return S_OK;
+}
