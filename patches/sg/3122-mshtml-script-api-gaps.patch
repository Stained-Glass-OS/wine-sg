+/* The browser of the host that shows the window, if the host has one. */
+static IWebBrowser2 *get_host_browser(HTMLWindow *window)
+{
+    HTMLOuterWindow *outer = window->outer_window;
+    IWebBrowser2 *wb = NULL;
+
+    if(!outer->browser || !outer->browser->doc->client || outer != outer->browser->doc->window)
+        return NULL;
+    if(FAILED(do_query_service((IUnknown*)outer->browser->doc->client, &IID_IWebBrowserApp, &IID_IWebBrowser2,
+                               (void**)&wb)))
+        return NULL;
+    return wb;
+}
+
+/* moves or resizes the host window, to a position or by an amount */
+static HRESULT move_resize_host(HTMLWindow *window, BOOL resize, BOOL relative, LONG x, LONG y)
+{
+    IWebBrowser2 *wb = get_host_browser(window);
+    LONG a, b;
+
+#ifdef SG_MUTANT_WINDOW_NOMOVE
+    if(wb) IWebBrowser2_Release(wb);
+    return S_FALSE;
+#endif
+    if(!wb)
+        return S_FALSE; /* nothing to move (the tests of Windows have S_FALSE for moveBy and resizeBy) */
+
+    if(resize) {
+        if(relative) {
+            IWebBrowser2_get_Width(wb, &a);
+            IWebBrowser2_get_Height(wb, &b);
+            x += a;
+            y += b;
+        }
+        IWebBrowser2_put_Width(wb, x);
+        IWebBrowser2_put_Height(wb, y);
+    }else {
+        if(relative) {
+            IWebBrowser2_get_Left(wb, &a);
+            IWebBrowser2_get_Top(wb, &b);
+            x += a;
+            y += b;
+        }
+        IWebBrowser2_put_Left(wb, x);
+        IWebBrowser2_put_Top(wb, y);
+    }
+    IWebBrowser2_Release(wb);
+    return S_OK;
+}
+
 static HRESULT WINAPI HTMLWindow2_moveTo(IHTMLWindow2 *iface, LONG x, LONG y)
 {
     HTMLWindow *This = impl_from_IHTMLWindow2(iface);
-    FIXME("(%p)->(%ld %ld)\n", This, x, y);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld %ld)\n", This, x, y);
+
+    return move_resize_host(This, 0, 0, x, y);
 }
 
