+/* The Selection object of the script interface (window.getSelection, document.getSelection). */
+typedef struct {
+    DispatchEx dispex;
+    IHTMLSelection IHTMLSelection_iface;
+
+    nsISelection *nsselection;
+    HTMLDocumentNode *doc;
+
+    struct list entry;
+} DOMSelection;
+
+static inline DOMSelection *impl_from_IHTMLSelection(IHTMLSelection *iface)
+{
+    return CONTAINING_RECORD(iface, DOMSelection, IHTMLSelection_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(DOMSelection, IHTMLSelection, impl_from_IHTMLSelection(iface)->dispex)
+
+static HRESULT dom_selection_node(DOMSelection *This, nsIDOMNode *nsnode, IHTMLDOMNode **ret)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    if(!nsnode) {
+        *ret = NULL;
+        return S_OK;
+    }
+    hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return hres;
+    *ret = &node->IHTMLDOMNode_iface;
+    return S_OK;
+}
+
+static nsIDOMNode *dom_selection_arg_node(IDispatch *disp)
+{
+    IHTMLDOMNode *node;
+    HTMLDOMNode *obj;
+    nsIDOMNode *ret;
+
+    if(!disp || FAILED(IDispatch_QueryInterface(disp, &IID_IHTMLDOMNode, (void**)&node)))
+        return NULL;
+    obj = unsafe_impl_from_IHTMLDOMNode(node);
+    ret = obj ? obj->nsnode : NULL;
+    if(ret)
+        nsIDOMNode_AddRef(ret);
+    IHTMLDOMNode_Release(node);
+    return ret;
+}
+
+static HRESULT WINAPI DOMSelection_get_anchorNode(IHTMLSelection *iface, IHTMLDOMNode **p)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    nsIDOMNode *nsnode = NULL;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsISelection_GetAnchorNode(This->nsselection, &nsnode);
+    return dom_selection_node(This, nsnode, p);
+}
+
+static HRESULT WINAPI DOMSelection_get_anchorOffset(IHTMLSelection *iface, LONG *p)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    LONG off = 0;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsISelection_GetAnchorOffset(This->nsselection, &off);
+    *p = off;
+    return S_OK;
+}
+
+static HRESULT WINAPI DOMSelection_get_focusNode(IHTMLSelection *iface, IHTMLDOMNode **p)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    nsIDOMNode *nsnode = NULL;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsISelection_GetFocusNode(This->nsselection, &nsnode);
+    return dom_selection_node(This, nsnode, p);
+}
+
+static HRESULT WINAPI DOMSelection_get_focusOffset(IHTMLSelection *iface, LONG *p)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    LONG off = 0;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsISelection_GetFocusOffset(This->nsselection, &off);
+    *p = off;
+    return S_OK;
+}
+
+static HRESULT WINAPI DOMSelection_get_isCollapsed(IHTMLSelection *iface, VARIANT_BOOL *p)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    cpp_bool collapsed = TRUE;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsISelection_GetIsCollapsed(This->nsselection, &collapsed);
+    *p = collapsed ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI DOMSelection_collapse(IHTMLSelection *iface, IDispatch *parentNode, LONG offset)
+{
+    DOMSelection *This = impl_from_IHTMLSelection(iface);
+    nsIDOMNode *nsnode;
+    nsresult nsres;
+
+    TRACE("(%p)->(%p %ld)\n", This, parentNode, offset);
+
+    if(!(nsnode = dom_selection_arg_node(parentNode)))
+        return E_INVALIDARG;
+    nsres = nsISelection_Collapse(This->nsselection, nsnode, offset);
+    nsIDOMNode_Release(nsnode);
+    return NS_SUCCEEDED(nsres) ? S_OK : E_INVALIDARG;
+}
