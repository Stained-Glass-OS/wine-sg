From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: real LZNT1 compression in RtlCompressBuffer

RtlCompressBuffer for COMPRESSION_FORMAT_LZNT1 stored every chunk
uncompressed (a valid but useless stream).  It now compresses: per 4096-byte
chunk a greedy hash-chain match finder emits literals and back references
using the length/displacement split the decoder reads, and falls back to a
stored chunk when the data does not shrink.  Output space is checked per
chunk (STATUS_BUFFER_TOO_SMALL).  The test's todo_wine on the compressed
size is removed.

---
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -818,28 +818,143 @@ NTSTATUS WINAPI RtlGetCompressionWorkSpaceSize(USHORT format, PULONG compress_wo
     }
 }
 
-/* compress data using LZNT1, currently only a stub */
+/* LZNT1 compression.  A stream is a sequence of chunks of up to 4096 bytes
+ * of input, each with a 16-bit header (bit 15: compressed, bits 12-14: 3,
+ * bits 0-11: stored size - 1).  A compressed chunk is a series of groups, each
+ * a flag byte followed by up to 8 items: a literal byte (flag bit 0) or a
+ * 16-bit back reference (flag bit 1) whose split between displacement and
+ * length depends on how many bytes of the chunk precede it, the same split
+ * lznt1_decompress_chunk() reads. */
+#define LZNT1_HASH_BITS 12
+
+static inline ULONG lznt1_hash(const UCHAR *p)
+{
+    return ((p[0] << 8) ^ (p[1] << 4) ^ p[2]) & ((1 << LZNT1_HASH_BITS) - 1);
+}
+
+static inline ULONG lznt1_displacement_bits(ULONG pos)
+{
+    ULONG bits;
+
+    for (bits = 12; bits > 4; bits--)
+        if ((1u << (bits - 1)) < pos) break;
+    return bits;
+}
+
+/* compress one chunk; dst must hold 4096 + 4096/8 + 2 bytes */
+static ULONG lznt1_compress_chunk(const UCHAR *src, ULONG src_len, UCHAR *dst)
+{
+    USHORT head[1 << LZNT1_HASH_BITS], prev[0x1000];
+    ULONG pos = 0, out = 0, flag_pos = 0, flag_count = 8, i;
+    UCHAR flags = 0;
+
+    memset(head, 0xff, sizeof(head));
+
+    while (pos < src_len)
+    {
+        ULONG best_len = 0, best_disp = 0;
+
+        if (flag_count == 8)
+        {
+            if (out) dst[flag_pos] = flags;
+            flag_pos = out++;
+            flags = 0;
+            flag_count = 0;
+        }
+
+        if (pos + 3 <= src_len)
+        {
+            ULONG db = lznt1_displacement_bits(pos);
+#ifdef SG_MUTANT_LZNT1_BAD_BITS
+            ULONG max_len = (1u << (16 - db)) + 2 + 1;
+#else
+            ULONG max_len = (1u << (16 - db)) + 2;
+#endif
+            ULONG cand = head[lznt1_hash(src + pos)], chain;
+
+            max_len = min(max_len, src_len - pos);
+            for (chain = 0; cand != 0xffff && chain < 64; chain++, cand = prev[cand])
+            {
+                ULONG len = 0;
+                while (len < max_len && src[cand + len] == src[pos + len]) len++;
+                if (len > best_len)
+                {
+                    best_len = len;
+                    best_disp = pos - cand;
+                    if (len == max_len) break;
+                }
+            }
+        }
+
+        if (best_len >= 3)
+        {
+            ULONG length_bits = 16 - lznt1_displacement_bits(pos);
+            USHORT code = ((best_disp - 1) << length_bits) | (best_len - 3);
+
+            dst[out++] = code & 0xff;
+            dst[out++] = code >> 8;
+            flags |= 1 << flag_count;
+        }
+        else
+        {
+            dst[out++] = src[pos];
+            best_len = 1;
+        }
+
+        for (i = 0; i < best_len; i++, pos++)
+        {
+            if (pos + 3 <= src_len)
+            {
+                ULONG h = lznt1_hash(src + pos);
+                prev[pos] = head[h];
+                head[h] = pos;
+            }
+        }
+        flag_count++;
+    }
+    dst[flag_pos] = flags;
+    return out;
+}
+
+/* compress data using LZNT1 */
 static NTSTATUS lznt1_compress(UCHAR *src, ULONG src_size, UCHAR *dst, ULONG dst_size,
                                ULONG chunk_size, ULONG *final_size, UCHAR *workspace)
 {
     UCHAR *src_cur = src, *src_end = src + src_size;
     UCHAR *dst_cur = dst, *dst_end = dst + dst_size;
-    ULONG block_size;
+    UCHAR tmp[0x1000 + 0x1000 / 8 + 2];
+    ULONG block_size, packed;
 
     while (src_cur < src_end)
     {
         /* determine size of current chunk */
         block_size = min(0x1000, src_end - src_cur);
-        if (dst_cur + sizeof(WORD) + block_size > dst_end)
-            return STATUS_BUFFER_TOO_SMALL;
-
-        /* write (uncompressed) chunk header */
-        *(WORD *)dst_cur = 0x3000 | (block_size - 1);
-        dst_cur += sizeof(WORD);
+#ifdef SG_MUTANT_LZNT1_STORED
+        packed = block_size;
+#else
+        packed = lznt1_compress_chunk(src_cur, block_size, tmp);
+#endif
 
-        /* write chunk content */
-        memcpy(dst_cur, src_cur, block_size);
-        dst_cur += block_size;
+        if (packed < block_size)
+        {
+            /* compressed chunk */
+            if (dst_cur + sizeof(WORD) + packed > dst_end)
+                return STATUS_BUFFER_TOO_SMALL;
+            *(WORD *)dst_cur = 0xb000 | (packed - 1);
+            dst_cur += sizeof(WORD);
+            memcpy(dst_cur, tmp, packed);
+            dst_cur += packed;
+        }
+        else
+        {
+            /* the data does not shrink: store it (uncompressed chunk) */
+            if (dst_cur + sizeof(WORD) + block_size > dst_end)
+                return STATUS_BUFFER_TOO_SMALL;
+            *(WORD *)dst_cur = 0x3000 | (block_size - 1);
+            dst_cur += sizeof(WORD);
+            memcpy(dst_cur, src_cur, block_size);
+            dst_cur += block_size;
+        }
         src_cur += block_size;
     }
 
