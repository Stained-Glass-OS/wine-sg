From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:19:12 -0700
Subject: [PATCH] jscript, mshtml: typed arrays only from IE10 document mode,
 no ES6 Math in IE modes

Native IE has ArrayBuffer, DataView and the typed arrays from document mode 10
on, not in mode 9; mshtml passes a private NOTYPED flag (0x800, HTML mode
only) for mode 9 and jscript then leaves them out. The ES6 Math functions
(trunc, sign, cbrt, ...) do not exist in any IE document mode (IE11 lacks
them), so they move to a Wine-only language version (0x104) that mshtml never
selects. documentmode.js checks the typed array names per mode and the absence
of the Math functions.

diff --git a/dlls/jscript/arraybuf.c b/dlls/jscript/arraybuf.c
index 4f47cbe..0aa276b 100644
--- a/dlls/jscript/arraybuf.c
+++ b/dlls/jscript/arraybuf.c
@@ -1315,7 +1315,11 @@ HRESULT init_arraybuf_constructors(script_ctx_t *ctx)
     HRESULT hres;
     unsigned i;
 
+#ifdef SG_MUTANT_JS_TYPED_ALWAYS
     if(ctx->version < SCRIPTLANGUAGEVERSION_ES5)
+#else
+    if(ctx->version < SCRIPTLANGUAGEVERSION_ES5 || ctx->no_typed)
+#endif
         return S_OK;
 
     if(!(arraybuf = calloc(1, FIELD_OFFSET(ArrayBufferInstance, buf[0]))))
diff --git a/dlls/jscript/jscript.c b/dlls/jscript/jscript.c
index 7f70cfc..c2429c1 100644
--- a/dlls/jscript/jscript.c
+++ b/dlls/jscript/jscript.c
@@ -57,6 +57,7 @@ typedef struct {
     LCID lcid;
     DWORD version;
     BOOL html_mode;
+    BOOL no_typed;
     BOOL is_encode;
     BOOL is_initialized;
 
@@ -753,6 +754,7 @@ static HRESULT WINAPI JScript_SetScriptSite(IActiveScript *iface,
         ctx->safeopt = This->safeopt;
         ctx->version = This->version;
         ctx->html_mode = This->html_mode;
+        ctx->no_typed = This->no_typed;
         ctx->acc = jsval_undefined();
         list_init(&ctx->named_items);
         heap_pool_init(&ctx->tmp_heap);
@@ -1293,6 +1295,7 @@ static HRESULT WINAPI JScriptProperty_SetProperty(IActiveScriptProperty *iface,
 
         This->version = V_I4(pvarValue) & 0x1ff;
         This->html_mode = (V_I4(pvarValue) & SCRIPTLANGUAGEVERSION_HTML) != 0;
+        This->no_typed = This->html_mode && (V_I4(pvarValue) & SCRIPTLANGUAGEVERSION_NOTYPED);
         break;
     default:
         FIXME("Unimplemented property %lx\n", dwProperty);
diff --git a/dlls/jscript/jscript.h b/dlls/jscript/jscript.h
index ddaefd7..dab8d42 100644
--- a/dlls/jscript/jscript.h
+++ b/dlls/jscript/jscript.h
@@ -47,6 +47,10 @@
  */
 #define SCRIPTLANGUAGEVERSION_ES5  0x102
 #define SCRIPTLANGUAGEVERSION_ES6  0x103
+/* Features native IE never had (ES6 Math functions): not used by mshtml. */
+#define SCRIPTLANGUAGEVERSION_ESNEXT 0x104
+/* HTML mode flag: no ArrayBuffer/typed arrays/DataView, as in IE9 document mode. */
+#define SCRIPTLANGUAGEVERSION_NOTYPED 0x800
 
 typedef struct _jsval_t jsval_t;
 typedef struct _jsstr_t jsstr_t;
@@ -83,6 +87,7 @@ HRESULT get_dispatch_typeinfo(ITypeInfo**);
 #define PROPF_VERSION_SHIFT 16
 #define PROPF_HTML          (SCRIPTLANGUAGEVERSION_HTML << PROPF_VERSION_SHIFT)
 #define PROPF_ES5           ((SCRIPTLANGUAGEVERSION_HTML|SCRIPTLANGUAGEVERSION_ES5) << PROPF_VERSION_SHIFT)
+#define PROPF_ESNEXT        ((SCRIPTLANGUAGEVERSION_HTML|SCRIPTLANGUAGEVERSION_ESNEXT) << PROPF_VERSION_SHIFT)
 #define PROPF_ES6           ((SCRIPTLANGUAGEVERSION_HTML|SCRIPTLANGUAGEVERSION_ES6) << PROPF_VERSION_SHIFT)
 
 /*
@@ -390,6 +395,7 @@ struct _script_ctx_t {
     DWORD safeopt;
     DWORD version;
     BOOL html_mode;
+    BOOL no_typed;
     LCID lcid;
     cc_ctx_t *cc;
     JSCaller *jscaller;
diff --git a/dlls/jscript/math.c b/dlls/jscript/math.c
index 10282d3..1ef237f 100644
--- a/dlls/jscript/math.c
+++ b/dlls/jscript/math.c
@@ -569,39 +569,39 @@ static HRESULT Math_imul(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned
 static const builtin_prop_t Math_props[] = {
     {L"abs",      Math_abs,      PROPF_METHOD|1},
     {L"acos",     Math_acos,     PROPF_METHOD|1},
-    {L"acosh",    Math_acosh,    PROPF_METHOD|PROPF_ES6|1},
+    {L"acosh",    Math_acosh,    PROPF_METHOD|PROPF_ESNEXT|1},
     {L"asin",     Math_asin,     PROPF_METHOD|1},
-    {L"asinh",    Math_asinh,    PROPF_METHOD|PROPF_ES6|1},
+    {L"asinh",    Math_asinh,    PROPF_METHOD|PROPF_ESNEXT|1},
     {L"atan",     Math_atan,     PROPF_METHOD|1},
     {L"atan2",    Math_atan2,    PROPF_METHOD|2},
-    {L"atanh",    Math_atanh,    PROPF_METHOD|PROPF_ES6|1},
-    {L"cbrt",     Math_cbrt,     PROPF_METHOD|PROPF_ES6|1},
+    {L"atanh",    Math_atanh,    PROPF_METHOD|PROPF_ESNEXT|1},
+    {L"cbrt",     Math_cbrt,     PROPF_METHOD|PROPF_ESNEXT|1},
     {L"ceil",     Math_ceil,     PROPF_METHOD|1},
-    {L"clz32",    Math_clz32,    PROPF_METHOD|PROPF_ES6|1},
+    {L"clz32",    Math_clz32,    PROPF_METHOD|PROPF_ESNEXT|1},
     {L"cos",      Math_cos,      PROPF_METHOD|1},
-    {L"cosh",     Math_cosh,     PROPF_METHOD|PROPF_ES6|1},
+    {L"cosh",     Math_cosh,     PROPF_METHOD|PROPF_ESNEXT|1},
     {L"exp",      Math_exp,      PROPF_METHOD|1},
-    {L"expm1",    Math_expm1,    PROPF_METHOD|PROPF_ES6|1},
+    {L"expm1",    Math_expm1,    PROPF_METHOD|PROPF_ESNEXT|1},
     {L"floor",    Math_floor,    PROPF_METHOD|1},
-    {L"fround",   Math_fround,   PROPF_METHOD|PROPF_ES6|1},
-    {L"hypot",    Math_hypot,    PROPF_METHOD|PROPF_ES6|2},
-    {L"imul",     Math_imul,     PROPF_METHOD|PROPF_ES6|2},
+    {L"fround",   Math_fround,   PROPF_METHOD|PROPF_ESNEXT|1},
+    {L"hypot",    Math_hypot,    PROPF_METHOD|PROPF_ESNEXT|2},
+    {L"imul",     Math_imul,     PROPF_METHOD|PROPF_ESNEXT|2},
     {L"log",      Math_log,      PROPF_METHOD|1},
-    {L"log10",    Math_log10,    PROPF_METHOD|PROPF_ES6|1},
-    {L"log1p",    Math_log1p,    PROPF_METHOD|PROPF_ES6|1},
-    {L"log2",     Math_log2,     PROPF_METHOD|PROPF_ES6|1},
+    {L"log10",    Math_log10,    PROPF_METHOD|PROPF_ESNEXT|1},
+    {L"log1p",    Math_log1p,    PROPF_METHOD|PROPF_ESNEXT|1},
+    {L"log2",     Math_log2,     PROPF_METHOD|PROPF_ESNEXT|1},
     {L"max",      Math_max,      PROPF_METHOD|2},
     {L"min",      Math_min,      PROPF_METHOD|2},
     {L"pow",      Math_pow,      PROPF_METHOD|2},
     {L"random",   Math_random,   PROPF_METHOD},
     {L"round",    Math_round,    PROPF_METHOD|1},
-    {L"sign",     Math_sign,     PROPF_METHOD|PROPF_ES6|1},
+    {L"sign",     Math_sign,     PROPF_METHOD|PROPF_ESNEXT|1},
     {L"sin",      Math_sin,      PROPF_METHOD|1},
-    {L"sinh",     Math_sinh,     PROPF_METHOD|PROPF_ES6|1},
+    {L"sinh",     Math_sinh,     PROPF_METHOD|PROPF_ESNEXT|1},
     {L"sqrt",     Math_sqrt,     PROPF_METHOD|1},
     {L"tan",      Math_tan,      PROPF_METHOD|1},
-    {L"tanh",     Math_tanh,     PROPF_METHOD|PROPF_ES6|1},
-    {L"trunc",    Math_trunc,    PROPF_METHOD|PROPF_ES6|1}
+    {L"tanh",     Math_tanh,     PROPF_METHOD|PROPF_ESNEXT|1},
+    {L"trunc",    Math_trunc,    PROPF_METHOD|PROPF_ESNEXT|1}
 };
 
 static const builtin_info_t Math_info = {
diff --git a/dlls/mshtml/script.c b/dlls/mshtml/script.c
index 4a86fe3..dedc0e8 100644
--- a/dlls/mshtml/script.c
+++ b/dlls/mshtml/script.c
@@ -66,6 +66,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
 #define SCRIPTLANGUAGEVERSION_HTML 0x400
 #define SCRIPTLANGUAGEVERSION_ES5  0x102
 #define SCRIPTLANGUAGEVERSION_ES6  0x103
+#define SCRIPTLANGUAGEVERSION_NOTYPED 0x800
 
 struct ScriptHost {
     IActiveScriptSite              IActiveScriptSite_iface;
@@ -158,8 +159,10 @@ static BOOL init_script_engine(ScriptHost *script_host, IActiveScript *script)
     if(IsEqualGUID(&script_host->guid, &CLSID_JScript)) {
         if(compat_mode >= COMPAT_MODE_IE11)
             script_mode = SCRIPTLANGUAGEVERSION_ES6;
-        else if(compat_mode >= COMPAT_MODE_IE9)
+        else if(compat_mode >= COMPAT_MODE_IE10)
             script_mode = SCRIPTLANGUAGEVERSION_ES5;
+        else if(compat_mode >= COMPAT_MODE_IE9)
+            script_mode = SCRIPTLANGUAGEVERSION_ES5 | SCRIPTLANGUAGEVERSION_NOTYPED;
         script_mode |= SCRIPTLANGUAGEVERSION_HTML;
     }
     V_VT(&var) = VT_I4;
diff --git a/dlls/mshtml/tests/documentmode.js b/dlls/mshtml/tests/documentmode.js
index 1a78fcb..3ef8295 100644
--- a/dlls/mshtml/tests/documentmode.js
+++ b/dlls/mshtml/tests/documentmode.js
@@ -3416,7 +3416,15 @@ async_test("MutationObserver_records", function() {
 });
 
 sync_test("typed_arrays", function() {
-    if(!window.Uint8Array)
+    var v = document.documentMode, names = [ "ArrayBuffer", "DataView", "Int8Array", "Uint8Array", "Uint8ClampedArray",
+                                             "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", "Float32Array", "Float64Array" ], i;
+    for(i = 0; i < names.length; i++) {
+        if(v >= 10)
+            ok(names[i] in window, names[i] + " not found in window.");
+        else
+            ok(!(names[i] in window), names[i] + " found in window.");
+    }
+    if(v < 10)
         return;
 
     var buf = new ArrayBuffer(8), bytes = new Uint8Array(buf), words = new Uint32Array(buf);
@@ -3464,16 +3472,11 @@ sync_test("array_reduceright_math", function() {
         ok(false, "reduceRight of empty array did not throw");
     }catch(e) {}
 
-    if(!Math.trunc)
-        return;
-    ok(Math.trunc(-4.7) === -4, "trunc");
-    ok(Math.sign(-3) === -1 && Math.sign(0) === 0, "sign");
-    ok(Math.cbrt(27) === 3, "cbrt");
-    ok(Math.log2(8) === 3, "log2");
-    ok(Math.hypot(3, 4) === 5, "hypot");
-    ok(Math.imul(65536, 65536) === 0, "imul");
-    ok(Math.clz32(1) === 31, "clz32");
-    ok(Math.fround(5.5) === 5.5, "fround");
+    /* No IE document mode has the ES6 Math functions. */
+    var names = [ "acosh", "asinh", "atanh", "cbrt", "clz32", "cosh", "expm1", "fround", "hypot", "imul", "log10", "log1p",
+                  "log2", "sign", "sinh", "tanh", "trunc" ], i;
+    for(i = 0; i < names.length; i++)
+        ok(!(names[i] in Math), "Math." + names[i] + " found.");
 });
 
 sync_test("initMessageEvent", function() {
