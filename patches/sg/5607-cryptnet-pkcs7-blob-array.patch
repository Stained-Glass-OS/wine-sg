From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptnet: CryptRetrieveObjectByUrl returns the certificates of every blob

cryptnet: CryptRetrieveObjectByUrl returns the certificates of every blob

When a scheme provider returns several blobs, a PKCS #7 object is a store
holding the certificates and CRLs of all of them, not just the first. The
scheme name given to a provider is also NUL terminated now.
---
--- a/dlls/cryptnet/cryptnet_main.c
+++ b/dlls/cryptnet/cryptnet_main.c
@@ -1096,7 +1096,7 @@ static BOOL CRYPT_GetRetrieveFunction(LPCWSTR pszURL,
 
             if (len)
             {
-                LPSTR scheme = CryptMemAlloc(len);
+                LPSTR scheme = CryptMemAlloc(len + 1);
 
                 if (scheme)
                 {
@@ -1107,6 +1107,7 @@ static BOOL CRYPT_GetRetrieveFunction(LPCWSTR pszURL,
                          SCHEME_OID_RETRIEVE_ENCODED_OBJECTW_FUNC, 0);
                     WideCharToMultiByte(CP_ACP, 0, components.lpszScheme,
                      components.dwSchemeLength, scheme, len, NULL, NULL);
+                    scheme[len] = 0;
                     ret = CryptGetOIDFunctionAddress(set, X509_ASN_ENCODING,
                      scheme, 0, (void **)pFunc, phFunc);
                     CryptMemFree(scheme);
@@ -1297,8 +1298,38 @@ static BOOL WINAPI CRYPT_CreatePKCS7(LPCSTR pszObjectOid,
          0, NULL, NULL, NULL, ppvContext, NULL, NULL);
     else
     {
-        FIXME("multiple messages unimplemented\n");
-        ret = FALSE;
+        /* several messages: their certificates are all in one collection */
+        HCERTSTORE collection = CertOpenStore(CERT_STORE_PROV_COLLECTION, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL);
+        DWORD i;
+
+        ret = collection != NULL;
+#ifdef SG_MUTANT_PKCS7_FIRST_ONLY
+        for (i = 0; ret && i < 1; i++)
+#else
+        for (i = 0; ret && i < pObject->cBlob; i++)
+#endif
+        {
+            HCERTSTORE store = NULL;
+
+            ret = CryptQueryObject(CERT_QUERY_OBJECT_BLOB, &pObject->rgBlob[i],
+             CERT_QUERY_CONTENT_FLAG_PKCS7_SIGNED | CERT_QUERY_CONTENT_FLAG_PKCS7_UNSIGNED,
+             CERT_QUERY_FORMAT_FLAG_BINARY, 0, NULL, NULL, NULL, &store, NULL, NULL);
+            if (ret)
+            {
+                ret = CertAddStoreToCollection(collection, store, CERT_PHYSICAL_STORE_ADD_ENABLE_FLAG, 0);
+                CertCloseStore(store, 0);
+            }
+#ifdef SG_MUTANT_PKCS7_IGNORE_BAD
+            else ret = TRUE;
+#endif
+        }
+        if (ret)
+            *ppvContext = collection;
+        else
+        {
+            if (collection) CertCloseStore(collection, 0);
+            *ppvContext = NULL;
+        }
     }
     return ret;
 }
--- a/dlls/cryptnet/tests/Makefile.in
+++ b/dlls/cryptnet/tests/Makefile.in
@@ -1,5 +1,5 @@
 TESTDLL   = cryptnet.dll
-IMPORTS   = cryptnet crypt32
+IMPORTS   = cryptnet crypt32 advapi32
 
 SOURCES = \
 	cryptnet.c
--- a/dlls/cryptnet/tests/cryptnet.c
+++ b/dlls/cryptnet/tests/cryptnet.c
@@ -870,9 +870,158 @@ static void test_verifyRevocation(void)
     CertFreeCertificateContext(certs[0]);
 }
 
+static CRYPT_BLOB_ARRAY scheme_blobs;
+static BOOL scheme_free_called;
+
+static void WINAPI scheme_free_object(LPCSTR oid, PCRYPT_BLOB_ARRAY object, void *context)
+{
+    scheme_free_called = TRUE;
+}
+
+static BOOL WINAPI scheme_retrieve(const WCHAR *url, const char *oid, DWORD flags, DWORD timeout,
+        CRYPT_BLOB_ARRAY *object, PFN_FREE_ENCODED_OBJECT_FUNC *free_func, void **free_context,
+        HCRYPTASYNC async, CRYPT_CREDENTIALS *credentials, CRYPT_RETRIEVE_AUX_INFO *aux)
+{
+    *object = scheme_blobs;
+    *free_func = scheme_free_object;
+    *free_context = NULL;
+    return TRUE;
+}
+
+static BYTE *make_pkcs7(const char *name, DWORD *size)
+{
+    CERT_NAME_BLOB subject = { 0, NULL };
+    CERT_RDN_ATTR attr = { (char *)szOID_COMMON_NAME, CERT_RDN_PRINTABLE_STRING, { strlen(name), (BYTE *)name } };
+    CERT_RDN rdn = { 1, &attr };
+    CERT_NAME_INFO info = { 1, &rdn };
+    HCRYPTPROV prov = 0;
+    const CERT_CONTEXT *cert;
+    HCERTSTORE store;
+    BYTE *ret = NULL;
+
+    CryptEncodeObjectEx(X509_ASN_ENCODING, X509_NAME, &info, CRYPT_ENCODE_ALLOC_FLAG, NULL, &subject.pbData, &subject.cbData);
+    CryptAcquireContextA(&prov, "wine_cryptnet_test", MS_DEF_PROV_A, PROV_RSA_FULL, CRYPT_NEWKEYSET);
+    if (!prov) CryptAcquireContextA(&prov, "wine_cryptnet_test", MS_DEF_PROV_A, PROV_RSA_FULL, 0);
+    {
+        HCRYPTKEY key = 0;
+
+        ok(CryptGenKey(prov, AT_SIGNATURE, 0x02000000, &key), "CryptGenKey failed: %08lx\n", GetLastError());
+        if (key) CryptDestroyKey(key);
+    }
+    cert = CertCreateSelfSignCertificate(prov, &subject, 0, NULL, NULL, NULL, NULL, NULL);
+    ok(!!cert, "CertCreateSelfSignCertificate failed: %08lx\n", GetLastError());
+    LocalFree(subject.pbData);
+    CryptReleaseContext(prov, 0);
+    CryptAcquireContextA(&prov, "wine_cryptnet_test", MS_DEF_PROV_A, PROV_RSA_FULL, CRYPT_DELETEKEYSET);
+    if (!cert) return NULL;
+
+    store = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL);
+    CertAddCertificateContextToStore(store, cert, CERT_STORE_ADD_ALWAYS, NULL);
+    CertFreeCertificateContext(cert);
+    *size = 0;
+    {
+        CRYPT_DATA_BLOB blob = { 0, NULL };
+
+        CertSaveStore(store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, CERT_STORE_SAVE_AS_PKCS7,
+                CERT_STORE_SAVE_TO_MEMORY, &blob, 0);
+        blob.pbData = malloc(blob.cbData);
+        if (CertSaveStore(store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, CERT_STORE_SAVE_AS_PKCS7,
+                CERT_STORE_SAVE_TO_MEMORY, &blob, 0))
+        {
+            ret = blob.pbData;
+            *size = blob.cbData;
+        }
+        else free(blob.pbData);
+    }
+    CertCloseStore(store, 0);
+    return ret;
+}
+
+static void test_retrieveObjectByUrl_pkcs7_array(void)
+{
+    static CRYPT_OID_FUNC_ENTRY entry = { "wineschemetest", scheme_retrieve };
+    DWORD size1 = 0, size2 = 0, count;
+    BYTE *msg1, *msg2;
+    HCERTSTORE store;
+    const CERT_CONTEXT *cert = NULL;
+    BOOL ret;
+
+    msg1 = make_pkcs7("Wine Cryptnet One", &size1);
+    msg2 = make_pkcs7("Wine Cryptnet Two", &size2);
+    if (!msg1 || !msg2)
+    {
+        skip("could not make the test messages\n");
+        free(msg1);
+        free(msg2);
+        return;
+    }
+
+    ret = CryptInstallOIDFunctionAddress(NULL, X509_ASN_ENCODING, SCHEME_OID_RETRIEVE_ENCODED_OBJECTW_FUNC, 1, &entry, 0);
+    ok(ret, "CryptInstallOIDFunctionAddress failed: %08lx\n", GetLastError());
+
+    /* one message: its store */
+    scheme_blobs.cBlob = 1;
+    scheme_blobs.rgBlob = (CRYPT_DATA_BLOB[2]){ { size1, msg1 }, { size2, msg2 } };
+    store = NULL;
+    scheme_free_called = FALSE;
+    ret = CryptRetrieveObjectByUrlW(L"wineschemetest://host/object", CONTEXT_OID_PKCS7, 0, 1000, (void **)&store, NULL, NULL, NULL, NULL);
+    ok(ret, "CryptRetrieveObjectByUrlW failed: %08lx\n", GetLastError());
+    ok(scheme_free_called, "the scheme provider's free function was not called\n");
+    count = 0;
+    while ((cert = CertEnumCertificatesInStore(store, cert))) count++;
+    ok(count == 1, "got %lu certificates\n", count);
+    CertCloseStore(store, 0);
+
+    /* several messages: the certificates of all of them */
+    scheme_blobs.cBlob = 2;
+    store = NULL;
+    scheme_free_called = FALSE;
+    ret = CryptRetrieveObjectByUrlW(L"wineschemetest://host/object", CONTEXT_OID_PKCS7, 0, 1000, (void **)&store, NULL, NULL, NULL, NULL);
+    ok(ret, "CryptRetrieveObjectByUrlW failed: %08lx\n", GetLastError());
+    ok(scheme_free_called, "the scheme provider's free function was not called\n");
+    ok(!!store, "no store\n");
+    if (store)
+    {
+        char text[2][128];
+
+        count = 0;
+        cert = NULL;
+        while ((cert = CertEnumCertificatesInStore(store, cert)))
+        {
+            if (count < 2)
+                CertGetNameStringA(cert, CERT_NAME_SIMPLE_DISPLAY_TYPE, 0, NULL, text[count], sizeof(text[0]));
+            count++;
+        }
+        ok(count == 2, "got %lu certificates\n", count);
+        if (count == 2)
+            ok((!strcmp(text[0], "Wine Cryptnet One") && !strcmp(text[1], "Wine Cryptnet Two")) ||
+               (!strcmp(text[1], "Wine Cryptnet One") && !strcmp(text[0], "Wine Cryptnet Two")),
+               "got %s and %s\n", text[0], text[1]);
+        CertCloseStore(store, 0);
+    }
+
+    /* a message that is not PKCS #7 fails them all */
+    scheme_blobs.rgBlob[1].cbData = 4;
+    store = (HCERTSTORE)0xdeadbeef;
+    SetLastError(0xdeadbeef);
+    ret = CryptRetrieveObjectByUrlW(L"wineschemetest://host/object", CONTEXT_OID_PKCS7, 0, 1000, (void **)&store, NULL, NULL, NULL, NULL);
+    ok(!ret, "CryptRetrieveObjectByUrlW succeeded\n");
+    ok(!store, "got %p\n", store);
+
+    /* none at all */
+    scheme_blobs.cBlob = 0;
+    SetLastError(0xdeadbeef);
+    ret = CryptRetrieveObjectByUrlW(L"wineschemetest://host/object", CONTEXT_OID_PKCS7, 0, 1000, (void **)&store, NULL, NULL, NULL, NULL);
+    ok(!ret && GetLastError() == ERROR_INVALID_DATA, "got %d, error %08lx\n", ret, GetLastError());
+
+    free(msg1);
+    free(msg2);
+}
+
 START_TEST(cryptnet)
 {
     test_getObjectUrl();
     test_retrieveObjectByUrl();
+    test_retrieveObjectByUrl_pkcs7_array();
     test_verifyRevocation();
 }
