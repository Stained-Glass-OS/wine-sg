+/* Stained Glass OS: rich text of a range in memory and back (TOM
+ * GetFormattedText / SetFormattedText) */
+struct rtf_buffer
+{
+    char *data;
+    LONG len, size, pos;
+};
+
+static DWORD CALLBACK rtf_buffer_write( DWORD_PTR cookie, BYTE *buf, LONG cb, LONG *done )
+{
+    struct rtf_buffer *b = (struct rtf_buffer *)cookie;
+
+    if (b->len + cb + 1 > b->size)
+    {
+        LONG size = max( b->size * 2, b->len + cb + 1024 );
+        char *data = realloc( b->data, size );
+        if (!data) return 1;
+        b->data = data;
+        b->size = size;
+    }
+    memcpy( b->data + b->len, buf, cb );
+    b->len += cb;
+    b->data[b->len] = 0;
+    *done = cb;
+    return 0;
+}
+
+static DWORD CALLBACK rtf_buffer_read( DWORD_PTR cookie, BYTE *buf, LONG cb, LONG *done )
+{
+    struct rtf_buffer *b = (struct rtf_buffer *)cookie;
+    LONG n = min( cb, b->len - b->pos );
+
+    memcpy( buf, b->data + b->pos, n );
+    b->pos += n;
+    *done = n;
+    return 0;
+}
+
+char *editor_range_rtf( ME_TextEditor *editor, LONG start, LONG end, LONG *len )
+{
+    struct rtf_buffer b = { 0 };
+    EDITSTREAM es = { (DWORD_PTR)&b, 0, rtf_buffer_write };
+    ME_Cursor cursor;
+
+    if (end < start) { LONG t = start; start = end; end = t; }
+    cursor_from_char_ofs( editor, start, &cursor );
+    ME_StreamOutRange( editor, SF_RTF, &cursor, end - start, &es );
+    if (es.dwError || !b.data)
+    {
+        free( b.data );
+        return NULL;
+    }
+    *len = b.len;
+    return b.data;
+}
+
+/* the text from start to end is replaced by the rich text; the selection keeps
+ * its place around the change */
+HRESULT editor_replace_with_rtf( ME_TextEditor *editor, LONG start, LONG end, const char *rtf, LONG len, LONG *new_end )
+{
+    struct rtf_buffer b = { (char *)rtf, len, len, 0 };
+    EDITSTREAM es = { (DWORD_PTR)&b, 0, rtf_buffer_read };
+    LONG sel_from, sel_to, before = ME_GetTextLength( editor ), change;
+
+    if (editor->props & TXTBIT_READONLY) return E_ACCESSDENIED;
+    if (end < start) { LONG t = start; start = end; end = t; }
+    ME_GetSelectionOfs( editor, &sel_from, &sel_to );
+    set_selection_cursors( editor, start, end );
+    ME_StreamIn( editor, SF_RTF | SFF_SELECTION, &es, FALSE );
+    if (es.dwError) return E_FAIL;
+    change = ME_GetTextLength( editor ) - before;
+    if (new_end) *new_end = end + change;
+    if (sel_from >= end) sel_from += change;
+    else if (sel_from > start) sel_from = start;
+    if (sel_to >= end) sel_to += change;
+    else if (sel_to > start) sel_to = start;
+    set_selection_cursors( editor, sel_from, sel_to );
+    ME_CommitUndo( editor );
+    ME_UpdateRepaint( editor, FALSE );
+    return S_OK;
+}
