+/* Stained Glass OS: TOM ranges and selections of this module, and what they are */
+static const ITextRangeVtbl trvt;
+static const ITextSelectionVtbl tsvt;
+
+static ME_TextEditor *tom_range_editor( ITextRange *range )
+{
+    if (range->lpVtbl == &trvt)
+    {
+        ITextRangeImpl *impl = impl_from_ITextRange( range );
+        return impl->child.reole ? impl->child.reole->editor : NULL;
+    }
+    if (range->lpVtbl == (const ITextRangeVtbl *)&tsvt)
+    {
+        struct text_selection *sel = impl_from_ITextSelection( (ITextSelection *)range );
+        return sel->services ? sel->services->editor : NULL;
+    }
+    return NULL;
+}
+
+/* SetFormattedText: the text of src, with its formatting, replaces start..end */
+static HRESULT tom_set_formatted_text( ME_TextEditor *editor, LONG start, LONG end, ITextRange *src, LONG *new_end )
+{
+    ME_TextEditor *src_editor;
+    LONG s, e, len;
+    HRESULT hr;
+    char *rtf;
+    BSTR text;
+
+    if (!src) return E_INVALIDARG;
+    ITextRange_GetStart( src, &s );
+    ITextRange_GetEnd( src, &e );
+    if (!(src_editor = tom_range_editor( src )))
+    {
+        /* another program's range: its plain text */
+        if (FAILED(hr = ITextRange_GetText( src, &text ))) return hr;
+        rtf = NULL;
+        len = SysStringLen( text );
+        {
+            ME_Cursor cursor;
+            LONG from = min( start, end ), to = max( start, end );
+            cursor_from_char_ofs( editor, from, &cursor );
+            ME_InternalDeleteText( editor, &cursor, to - from, FALSE );
+            if (len) ME_InsertTextFromCursor( editor, 0, text, len, editor->pBuffer->pDefaultStyle );
+            set_selection_cursors( editor, from, from );
+        }
+        SysFreeString( text );
+        if (new_end) *new_end = min( start, end ) + len;
+        ME_CommitUndo( editor );
+        ME_UpdateRepaint( editor, FALSE );
+        return S_OK;
+    }
+#ifdef SG_MUTANT_TOM_FORMATTED_PLAIN
+    return E_NOTIMPL;
+#endif
+    if (!(rtf = editor_range_rtf( src_editor, s, e, &len ))) return E_OUTOFMEMORY;
+    hr = editor_replace_with_rtf( editor, start, end, rtf, len, new_end );
+    free( rtf );
+    return hr;
+}
+
+/* the embedded object at cp, if one is there */
+static HRESULT tom_embedded_object( ME_TextEditor *editor, LONG start, LONG end, IUnknown **ppv )
+{
+    ME_Cursor cursor;
+
+    if (!ppv) return E_INVALIDARG;
+    *ppv = NULL;
+    cursor_from_char_ofs( editor, min( start, end ), &cursor );
+#ifndef SG_MUTANT_TOM_NO_EMBEDDED
+    if (cursor.run->reobj && cursor.run->reobj->obj.poleobj && abs( end - start ) <= 1)
+    {
+        IOleObject_QueryInterface( cursor.run->reobj->obj.poleobj, &IID_IUnknown, (void **)ppv );
+        return *ppv ? S_OK : E_FAIL;
+    }
+#endif
+    return S_FALSE;
+}
+
+/* the character position at a point (screen coordinates unless tomClientCoord) */
+static LONG tom_cp_from_point( ME_TextEditor *editor, LONG x, LONG y, LONG type )
+{
+    ME_Cursor cursor;
+    POINT pt = { x, y };
+
+    if (!(type & tomClientCoord)) ITextHost_TxScreenToClient( editor->texthost, &pt );
+    cursor_from_coords( editor, pt.x, pt.y, &cursor );
+    return ME_GetCursorOfs( &cursor );
+}
+
+/* SetPoint: an insertion point at the point, or (extend) the end that type
+ * names moved there */
+static void tom_set_point( LONG cp, LONG type, LONG extend, LONG *start, LONG *end )
+{
+    if (!extend)
+    {
+        *start = *end = cp;
+        return;
+    }
+#ifndef SG_MUTANT_TOM_SETPOINT_EXTEND
+    if (type & tomStart)
+    {
+        *start = cp;
+        if (*end < cp) *end = cp;
+    }
+    else
+#endif
+    {
+        *end = cp;
+        if (*start > cp) *start = cp;
+    }
+}
