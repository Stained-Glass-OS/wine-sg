+/* Stained Glass OS: MoveUp/MoveDown by paragraph (as Ctrl+Up/Down: to the start
+ * of the paragraph, then of the one before), screen (Page Up/Down) and window
+ * (to the first or last line in view) */
+static HRESULT selection_move_vertical( ITextSelection *me, ME_TextEditor *editor, BOOL up, LONG unit,
+                                        LONG count, LONG extend, LONG *delta )
+{
+    LONG moved = 0, from, to, active, anchor, d;
+    ME_Cursor cursor;
+    HRESULT hr;
+
+    switch (unit)
+    {
+    case tomLine:
+        return selection_move( editor, up ? VK_UP : VK_DOWN, FALSE, count, extend, delta );
+    case tomScreen:
+        return selection_move( editor, up ? VK_PRIOR : VK_NEXT, FALSE, count, extend, delta );
+    case tomParagraph:
+        if (!extend)
+        {
+            /* a selection collapses to its start (up) or end (down) first */
+            hr = ITextSelection_Move( me, tomParagraph, up ? -count : count, &d );
+            if (delta) *delta = up ? -d : d;
+            return hr;
+        }
+        hr = up ? ITextSelection_MoveStart( me, tomParagraph, -count, &d )
+                : ITextSelection_MoveEnd( me, tomParagraph, count, &d );
+        if (delta) *delta = up ? -d : d;
+        return hr;
+    case tomWindow:
+        /* the first or last line in view; once there, a screen further */
+        if (delta) *delta = 0;
+        if (!count) return S_FALSE;
+        ME_GetSelectionOfs( editor, &from, &to );
+        active = ME_GetCursorOfs( &editor->pCursors[0] );
+        anchor = ME_GetCursorOfs( &editor->pCursors[1] );
+        cursor_from_coords( editor, editor->rcFormat.left, up ? editor->rcFormat.top : editor->rcFormat.bottom - 1, &cursor );
+#ifdef SG_MUTANT_TOM_WINDOW_UNIT
+        cursor = editor->pCursors[0];
+#endif
+        if (ME_GetCursorOfs( &cursor ) != active) moved = 1;
+        if (moved < count)
+        {
+            selection_move( editor, up ? VK_PRIOR : VK_NEXT, FALSE, count - moved, extend, &d );
+            moved += abs( d );
+            active = ME_GetCursorOfs( &editor->pCursors[0] );
+        }
+        else active = ME_GetCursorOfs( &cursor );
+        set_selection_cursors( editor, extend ? anchor : active, active );
+        ME_InvalidateSelection( editor );
+        ME_Repaint( editor );
+        update_caret( editor );
+        ME_SendSelChange( editor );
+        if (delta) *delta = moved;
+        return moved == count ? S_OK : S_FALSE;
+    }
+    if (delta) *delta = 0;
+    return E_INVALIDARG;
+}
