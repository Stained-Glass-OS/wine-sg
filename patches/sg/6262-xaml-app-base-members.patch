From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: program members of base types, program enums from text

Markup on a program's own types now finds a member its metadata gives on a base type, as XAML does, takes an enum member written as digits (as compiled markup writes it) or by name, passing it as a reference of the enum, and has a value of the program's own type made by that type from its text. Windows Terminal's 74 WinUI reveal brushes were left without their colour and theme, and its corner-radius converters without their filter.
---
diff --git a/dlls/windows.ui.xaml/markup.c b/dlls/windows.ui.xaml/markup.c
index 58f8f0b..47e6e93 100644
--- a/dlls/windows.ui.xaml/markup.c
+++ b/dlls/windows.ui.xaml/markup.c
@@ -56,7 +56,7 @@ static const GUID IID_IUriRuntimeClassFactory_x = { 0x44a9796f, 0x723e, 0x4fdf,
 static const GUID IID_IXamlReaderStatics_x = { 0x9891c6bd, 0x534f, 0x4955, { 0xb8, 0x5a, 0x8a, 0x8d, 0xc0, 0xdc, 0xa6, 0x02 } };
 
 /* IXamlType and IXamlMember slots (windows-rs 0.30.0) */
-enum { XT_ContentProperty = 7, XT_FullName = 8, XT_IsCollection = 10, XT_ActivateInstance = 18, XT_CreateFromString = 19,
+enum { XT_BaseType = 6, XT_ContentProperty = 7, XT_FullName = 8, XT_IsCollection = 10, XT_ActivateInstance = 18, XT_CreateFromString = 19,
        XT_GetMember = 20, XT_AddToVector = 21 };
 enum { XM_IsReadOnly = 8, XM_Type = 11, XM_GetValue = 12, XM_SetValue = 13 };
 #define CALL(o, slot, type) ((type)(((void **)((IUnknown *)(o))->lpVtbl)[slot]))
@@ -374,6 +374,32 @@ static IInspectable *app_type( const WCHAR *full_name )
     return type;
 }
 
+/* a value of a type of the program's (WinUI 2's CornerRadiusFilterKind) from text: the type makes it */
+static HRESULT xtype_value_from_string( IInspectable *xtype, const WCHAR *str, IInspectable **value )
+{
+    HSTRING text;
+    HRESULT hr;
+
+    *value = NULL;
+    if (FAILED(hr = WindowsCreateString( str, wcslen( str ), &text ))) return hr;
+    hr = CALL( xtype, XT_CreateFromString, HRESULT (WINAPI *)( IInspectable *, HSTRING, IInspectable ** ) )( xtype, text, value );
+    WindowsDeleteString( text );
+    TRACE( "the program's type made %s: %#lx\n", debugstr_w( str ), hr );
+    if (SUCCEEDED(hr) && !*value) hr = E_INVALIDARG;
+    return hr;
+}
+
+static HRESULT app_value_from_string( const WCHAR *type, const WCHAR *str, IInspectable **value )
+{
+    IInspectable *xtype = app_type( type );
+    HRESULT hr;
+
+    if (!xtype) return E_NOTIMPL;
+    hr = xtype_value_from_string( xtype, str, value );
+    IInspectable_Release( xtype );
+    return hr;
+}
+
 /* a member named with its owner (compiled markup's AutomationProperties.Name): the owner's property
  * (an attached one), or the object's own when the owner is its type or one of its bases */
 struct xaml_property *xaml_find_owned_member( struct dobj *d, const WCHAR *owner, const WCHAR *name )
@@ -546,7 +572,7 @@ static const struct { const WCHAR *type; const GUID *iid; const WCHAR *names[8];
     { L"Windows.UI.Xaml.Media.PenLineJoin", NULL, { L"Miter", L"Bevel", L"Round" } },
     { L"Windows.UI.Xaml.Media.AcrylicBackgroundSource", NULL, { L"HostBackdrop", L"Backdrop" } },
     { L"Windows.UI.Xaml.Automation.Peers.AccessibilityView", NULL, { L"Raw", L"Control", L"Content" } },
-    { L"Windows.UI.Xaml.ApplicationTheme", NULL, { L"Light", L"Dark" } },
+    { L"Windows.UI.Xaml.ApplicationTheme", &IID_IReference_ApplicationTheme, { L"Light", L"Dark" } },
     { L"Windows.UI.Xaml.Controls.LightDismissOverlayMode", NULL, { L"Auto", L"On", L"Off" } },
     { L"Windows.UI.Xaml.ElementSoundMode", NULL, { L"Default", L"FocusOnly", L"Off" } },
     { L"Windows.UI.Xaml.Media.Animation.FillBehavior", NULL, { L"HoldEnd", L"Stop" } },
@@ -660,10 +686,14 @@ static HRESULT value_from_string( const WCHAR *type, const WCHAR *str, IInspecta
         for (i = 0; i < ARRAY_SIZE(enums); i++)
         {
             if (wcscmp( enums[i].type, type )) continue;
+#ifndef SG_MUTANT_ENUM_NO_DIGITS
+            if (!wcsncmp( str, L"#enum", 5 ) || (str[0] >= '0' && str[0] <= '9'))
+#else
             if (!wcsncmp( str, L"#enum", 5 ))
+#endif
             {
-                /* compiled markup's value: the number */
-                INT32 v = wcstol( str + 5, NULL, 10 );
+                /* compiled markup's value: the number (a program's member gets it as digits) */
+                INT32 v = wcstol( str[0] == '#' ? str + 5 : str, NULL, 10 );
                 *value = enums[i].iid ? xbox_ref( enums[i].iid, &v, sizeof(v) ) : xbox_int32( v );
                 return *value ? S_OK : E_OUTOFMEMORY;
             }
@@ -704,13 +734,52 @@ static HRESULT set_app_member( IInspectable *obj, IInspectable *type, const WCHA
 
     if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &hname ))) return hr;
     hr = CALL( type, XT_GetMember, HRESULT (WINAPI *)( IInspectable *, HSTRING, IInspectable ** ) )( type, hname, &member );
+#ifndef SG_MUTANT_APP_MEMBER_NO_BASE
+    {
+        /* a type's metadata has its own members: one of a base class is the base type's
+         * (WinUI 2's RevealBackgroundBrush.TargetTheme is RevealBrush's) */
+        IInspectable *base = NULL, *next;
+        unsigned int depth = 0;
+
+        if (SUCCEEDED(hr) && !member)
+            CALL( type, XT_BaseType, HRESULT (WINAPI *)( IInspectable *, IInspectable ** ) )( type, &base );
+        while (base && !member && depth++ < 32)
+        {
+            /* a framework type's metadata in the program's provider may have no members at all
+             * (E_NOTIMPL): the member is not there, as before the walk */
+            if (FAILED(hr = CALL( base, XT_GetMember, HRESULT (WINAPI *)( IInspectable *, HSTRING, IInspectable ** ) )( base, hname, &member )))
+            {
+#ifdef SG_MUTANT_APP_BASE_FAILS
+                break;
+#endif
+                member = NULL;
+                hr = S_OK;
+            }
+            if (member) break;
+            next = NULL;
+            CALL( base, XT_BaseType, HRESULT (WINAPI *)( IInspectable *, IInspectable ** ) )( base, &next );
+            IInspectable_Release( base );
+            base = next;
+        }
+        if (base) IInspectable_Release( base );
+    }
+#endif
     WindowsDeleteString( hname );
-    if (FAILED(hr) || !member) return FAILED(hr) ? hr : E_INVALIDARG;
+    if (FAILED(hr) || !member)
+    {
+        TRACE( "no member %s of the program's type: %#lx\n", debugstr_w( name ), hr );
+        return FAILED(hr) ? hr : E_INVALIDARG;
+    }
     if (str)
     {
         CALL( member, XM_Type, HRESULT (WINAPI *)( IInspectable *, IInspectable ** ) )( member, &member_type );
         if (member_type) CALL( member_type, XT_FullName, HRESULT (WINAPI *)( IInspectable *, HSTRING * ) )( member_type, &full );
         hr = value_from_string( full ? WindowsGetStringRawBuffer( full, NULL ) : L"String", str, &boxed );
+        TRACE( "%s = %s as %s: %#lx\n", debugstr_w( name ), debugstr_w( str ),
+               debugstr_w( full ? WindowsGetStringRawBuffer( full, NULL ) : L"String" ), hr );
+#ifndef SG_MUTANT_APP_NO_CREATE_FROM_STRING
+        if (hr == E_NOTIMPL && member_type) hr = xtype_value_from_string( member_type, str, &boxed );
+#endif
         WindowsDeleteString( full );
         if (member_type) IInspectable_Release( member_type );
         value = boxed;
@@ -741,7 +810,10 @@ static HRESULT set_app_member( IInspectable *obj, IInspectable *type, const WCHA
         }
     }
     if (SUCCEEDED(hr))
+    {
         hr = CALL( member, XM_SetValue, HRESULT (WINAPI *)( IInspectable *, IInspectable *, IInspectable * ) )( member, obj, value );
+        if (FAILED(hr)) TRACE( "the program's SetValue of %s failed: %#lx\n", debugstr_w( name ), hr );
+    }
     if (boxed) IInspectable_Release( boxed );
     IInspectable_Release( member );
     return hr;
@@ -1102,7 +1174,11 @@ HRESULT xaml_writer_set( struct xaml_writer *writer, IInspectable *obj, const WC
     {
         if (str)
         {
-            if (FAILED(hr = value_from_string( prop->type, str, &boxed )))
+            hr = value_from_string( prop->type, str, &boxed );
+#ifndef SG_MUTANT_APP_NO_CREATE_FROM_STRING
+            if (hr == E_NOTIMPL) hr = app_value_from_string( prop->type, str, &boxed );
+#endif
+            if (FAILED(hr))
             {
                 WARN( "%s: %s is not a %s\n", debugstr_w( name ), debugstr_w( str ), debugstr_w( prop->type ) );
                 return hr;
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index dff54fc..7faa36f 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -226,7 +226,8 @@ struct xrect { FLOAT x, y, width, height; };
 struct xthickness { DOUBLE left, top, right, bottom; };
 
 extern const GUID IID_IReference_Thickness, IID_IReference_Visibility, IID_IReference_HorizontalAlignment,
-                  IID_IReference_VerticalAlignment, IID_IReference_FlowDirection, IID_IReference_ElementTheme;
+                  IID_IReference_VerticalAlignment, IID_IReference_FlowDirection, IID_IReference_ElementTheme,
+                  IID_IReference_ApplicationTheme;
 
 IInspectable *xbox_double( DOUBLE value );
 void *xaml_pv_statics(void);
diff --git a/dlls/windows.ui.xaml/value.c b/dlls/windows.ui.xaml/value.c
index adc75f2..c37882b 100644
--- a/dlls/windows.ui.xaml/value.c
+++ b/dlls/windows.ui.xaml/value.c
@@ -44,6 +44,8 @@ const GUID IID_IReference_GridLength = { 0xb5ecd72b, 0x991b, 0x5ec7, { 0xba, 0xc
 const GUID IID_IReference_Orientation = { 0xa55a825e, 0xe87d, 0x54f1, { 0xae, 0x28, 0x38, 0x9a, 0x02, 0x38, 0xd9, 0xe1 } };
 const GUID IID_IReference_FlowDirection = { 0x72ea6754, 0x2418, 0x5ded, { 0x91, 0x88, 0x86, 0x65, 0xf5, 0x98, 0x7a, 0xd2 } };
 const GUID IID_IReference_ElementTheme = { 0x0e1d2a39, 0xfeb3, 0x5913, { 0x8a, 0x73, 0x21, 0xab, 0x23, 0xab, 0x9d, 0x48 } };
+/* IReference<ApplicationTheme> (WinUI 2's RevealBrush.TargetTheme) */
+const GUID IID_IReference_ApplicationTheme = { 0x08c245e1, 0x6ea8, 0x581c, { 0x98, 0xa2, 0xfa, 0xc6, 0xbe, 0x82, 0xce, 0xcf } };
 static const GUID IID_IPropertyValue_box = { 0x4bd682dd, 0x7554, 0x40e9, { 0x9a, 0x9b, 0x82, 0x65, 0x4e, 0xde, 0x7e, 0x62 } };
 static const GUID IID_IPropertyValueStatics_box = { 0x629bdbc8, 0xd932, 0x4ff4, { 0x96, 0xb9, 0x8d, 0x96, 0xc5, 0xc1, 0xe8, 0x58 } };
 
