                                        unsigned int attr, struct object *root );
@@ -203,7 +204,7 @@ static const struct object_ops key_ops =
     no_get_fd,               /* get_fd */
     key_map_access,          /* map_access */
     key_get_sd,              /* get_sd */
-    default_set_sd,          /* set_sd */
+    key_set_sd,              /* set_sd */
     key_get_full_name,       /* get_full_name */
     key_lookup_name,         /* lookup_name */
     key_link_name,           /* link_name */
@@ -829,6 +830,27 @@ static int sg_is_display_config_key( struct object *obj )
     return ret;
 }
 
+/* Stained Glass OS: a key of the display configuration or of Click-to-Run Office's machine hive
+ * that has no descriptor is writable by users (sg_key_default_sd). Office's Click-to-Run service,
+ * as SYSTEM, sets an owner on the keys of its hive (SetSecurityInfo with the owner only), and the
+ * DACL the key then took came from the token's default: the machine's ("users read") since the
+ * admin token has it (7805). Word's virtual registry, inside WINWORD.EXE as the user, was refused
+ * KEY_ALL_ACCESS on them again and could not save a new document ("The save failed due to out of
+ * memory or disk space"), as before 5942. Such a key takes the users-writable DACL instead, as
+ * when it is created there. */
+static int key_set_sd( struct object *obj, const struct security_descriptor *sd, unsigned int set_info )
+{
+    int had_sd = obj->sd != NULL;
+    int dacl_given = (set_info & DACL_SECURITY_INFORMATION) && (sd->control & SE_DACL_PRESENT);
+
+    if (!default_set_sd( obj, sd, set_info )) return 0;
+#ifndef SG_MUTANT_C2R_SETSD_TOKEN_DACL
+    if (sg_system_prefix && !had_sd && !dacl_given && sg_is_display_config_key( obj ))
+        sg_make_key_user_writable( obj );
+#endif
+    return 1;
+}
