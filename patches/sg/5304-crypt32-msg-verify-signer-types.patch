From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: verify message signatures against a chain or a bare hash

crypt32: CMSG_CTRL_VERIFY_SIGNATURE_EX handles the two signer types it did
not: CMSG_VERIFY_SIGNER_CHAIN takes the signer's public key from the end
certificate of the first chain of the CERT_CHAIN_CONTEXT, and
CMSG_VERIFY_SIGNER_NULL checks a signature that is only the unencrypted hash
octets (the documentation's remark) against the hash of the content (or of the
authenticated attributes). A wrong key or a wrong hash fails.
---
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -3490,6 +3490,31 @@ static BOOL CDecodeSignedMsg_VerifySignatureWithKey(CDecodeMsg *msg,
     return ret;
 }
 
+/* A signature that is only the unencrypted hash octets (CMSG_VERIFY_SIGNER_NULL) */
+static BOOL CDecodeSignedMsg_VerifyHash(CDecodeMsg *msg, DWORD signerIndex)
+{
+    const CMSG_CMS_SIGNER_INFO *signer = &msg->u.signed_data.info->rgSignerInfo[signerIndex];
+    HCRYPTHASH hash;
+    BYTE *value;
+    DWORD size;
+    BOOL ret;
+
+    if (signer->AuthAttrs.cAttr)
+        hash = msg->u.signed_data.signerHandles[signerIndex].authAttrHash;
+    else
+        hash = msg->u.signed_data.signerHandles[signerIndex].contentHash;
+
+    if (!extract_hash(hash, &value, &size)) return FALSE;
+#ifndef SG_MUTANT_VERIFY_NULL_ACCEPTS
+    ret = size == signer->EncryptedHash.cbData && !memcmp(value, signer->EncryptedHash.pbData, size);
+#else
+    ret = TRUE;
+#endif
+    if (!ret) SetLastError(NTE_BAD_SIGNATURE);
+    CryptMemFree(value);
+    return ret;
+}
+
 static BOOL CDecodeSignedMsg_VerifySignature(CDecodeMsg *msg, PCERT_INFO info)
 {
     BOOL ret = FALSE;
@@ -3560,6 +3585,25 @@ static BOOL CDecodeSignedMsg_VerifySignatureEx(CDecodeMsg *msg,
              para->dwSignerIndex, &cert->pCertInfo->SubjectPublicKeyInfo);
             break;
         }
+        case CMSG_VERIFY_SIGNER_CHAIN:
+        {
+            PCCERT_CHAIN_CONTEXT chain = para->pvSigner;
+
+            /* the signer is the end certificate of the first chain */
+            if (!chain || chain->cbSize < sizeof(*chain) || !chain->cChain || !chain->rgpChain[0]->cElement)
+                SetLastError(CRYPT_E_SIGNER_NOT_FOUND);
+            else
+#ifdef SG_MUTANT_VERIFY_CHAIN_ACCEPTS
+                ret = TRUE;
+#else
+                ret = CDecodeSignedMsg_VerifySignatureWithKey(msg, para->hCryptProv, para->dwSignerIndex,
+                 &chain->rgpChain[0]->rgpElement[0]->pCertContext->pCertInfo->SubjectPublicKeyInfo);
+#endif
+            break;
+        }
+        case CMSG_VERIFY_SIGNER_NULL:
+            ret = CDecodeSignedMsg_VerifyHash(msg, para->dwSignerIndex);
+            break;
         default:
             FIXME("unimplemented for signer type %ld\n", para->dwSignerType);
             SetLastError(CRYPT_E_SIGNER_NOT_FOUND);
--- a/dlls/crypt32/tests/msg.c
+++ b/dlls/crypt32/tests/msg.c
@@ -3680,6 +3680,34 @@ static void test_verify_ecc_signature(void)
     bret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify_para);
     ok(bret, "failed, error %#lx.\n", GetLastError());
 
+    /* the signer given as a chain is the end certificate of the first chain */
+    {
+        CERT_CHAIN_ELEMENT element = { sizeof(element), cert };
+        PCERT_CHAIN_ELEMENT elements[1] = { &element };
+        CERT_SIMPLE_CHAIN simple = { sizeof(simple), {0}, 1, elements };
+        PCERT_SIMPLE_CHAIN simples[1] = { &simple };
+        CERT_CHAIN_CONTEXT chain = { sizeof(chain), {0}, 1, simples };
+
+        verify_para.dwSignerType = CMSG_VERIFY_SIGNER_CHAIN;
+        verify_para.pvSigner = &chain;
+        bret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify_para);
+        ok(bret, "failed, error %#lx.\n", GetLastError());
+
+        /* another certificate's key does not verify it */
+        element.pCertContext = CertCreateCertificateContext(X509_ASN_ENCODING, v1CertWithValidPubKey,
+                sizeof(v1CertWithValidPubKey));
+        ok(!!element.pCertContext, "failed, error %#lx.\n", GetLastError());
+        SetLastError(0xdeadbeef);
+        bret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify_para);
+        ok(!bret, "succeeded.\n");
+        CertFreeCertificateContext(element.pCertContext);
+
+        simple.cElement = 0;
+        SetLastError(0xdeadbeef);
+        bret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify_para);
+        ok(!bret && GetLastError() == CRYPT_E_SIGNER_NOT_FOUND, "got ret %d, error %#lx.\n", bret, GetLastError());
+    }
+
     free(signer_info);
     free(cert_info);
     CertFreeCertificateContext(cert);
@@ -3687,6 +3715,132 @@ static void test_verify_ecc_signature(void)
     CryptMsgClose(msg);
 }
 
+struct der
+{
+    BYTE data[512];
+    DWORD len;
+};
+
+static void der_add(struct der *der, const void *data, DWORD len)
+{
+    memcpy(der->data + der->len, data, len);
+    der->len += len;
+}
+
+/* tag and length, then the content */
+static void der_add_wrapped(struct der *der, BYTE tag, const struct der *content)
+{
+    der->data[der->len++] = tag;
+    if (content->len >= 0x80) der->data[der->len++] = 0x81;
+    der->data[der->len++] = content->len;
+    der_add(der, content->data, content->len);
+}
+
+static void test_verify_hash_only_signature(void)
+{
+    static const BYTE md5_alg[] = { 0x30,0x0c,0x06,0x08,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x02,0x05,0x05,0x00 };
+    static const BYTE rsa_alg[] = { 0x30,0x0d,0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x01,0x01,0x05,0x00 };
+    static const BYTE data_oid[] = { 0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x07,0x01 };
+    static const BYTE signed_oid[] = { 0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x07,0x02 };
+    static const BYTE integer1[] = { 0x02,0x01,0x01 };
+    CMSG_CTRL_VERIFY_SIGNATURE_EX_PARA verify_para = { sizeof(verify_para) };
+    DWORD i;
+    struct der issuer, signer, signer_set, signed_data, content, content_info, tmp, tmp2;
+    BYTE hash_value[16];
+    DWORD hash_size = sizeof(hash_value);
+    HCRYPTPROV prov;
+    HCRYPTHASH h;
+    HCRYPTMSG msg;
+    BOOL ret;
+
+    ret = CryptAcquireContextA(&prov, NULL, MS_DEF_PROV_A, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ret = CryptCreateHash(prov, CALG_MD5, 0, 0, &h);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ret = CryptHashData(h, msgData, sizeof(msgData), 0);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    ret = CryptGetHashParam(h, HP_HASHVAL, hash_value, &hash_size, 0);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    CryptDestroyHash(h);
+    CryptReleaseContext(prov, 0);
+
+    for (i = 0; i < 2; ++i)
+    {
+        /* the second message has a hash that is not the content's */
+        if (i) hash_value[0] ^= 0xff;
+
+        memset(&tmp, 0, sizeof(tmp));
+        der_add(&tmp, encodedCommonName, sizeof(encodedCommonName));
+        der_add(&tmp, integer1, sizeof(integer1));
+        memset(&issuer, 0, sizeof(issuer));
+        der_add_wrapped(&issuer, 0x30, &tmp);              /* IssuerAndSerialNumber */
+
+        /* SignerInfo: version, issuer and serial number, hash algorithm, signature algorithm and the hash itself */
+        memset(&tmp, 0, sizeof(tmp));
+        der_add(&tmp, integer1, sizeof(integer1));
+        der_add(&tmp, issuer.data, issuer.len);
+        der_add(&tmp, md5_alg, sizeof(md5_alg));
+        der_add(&tmp, rsa_alg, sizeof(rsa_alg));
+        memset(&tmp2, 0, sizeof(tmp2));
+        der_add(&tmp2, hash_value, sizeof(hash_value));
+        der_add_wrapped(&tmp, 0x04, &tmp2);
+        memset(&signer, 0, sizeof(signer));
+        der_add_wrapped(&signer, 0x30, &tmp);
+        memset(&signer_set, 0, sizeof(signer_set));
+        der_add_wrapped(&signer_set, 0x31, &signer);
+
+        /* SignedData: version, digest algorithms, content, signer infos */
+        memset(&content, 0, sizeof(content));
+        der_add(&content, data_oid, sizeof(data_oid));
+        memset(&tmp, 0, sizeof(tmp));
+        memset(&tmp2, 0, sizeof(tmp2));
+        der_add(&tmp2, msgData, sizeof(msgData));
+        der_add_wrapped(&tmp, 0x04, &tmp2);
+        der_add_wrapped(&content, 0xa0, &tmp);
+        memset(&signed_data, 0, sizeof(signed_data));
+        memset(&tmp, 0, sizeof(tmp));
+        der_add(&tmp, integer1, sizeof(integer1));
+        der_add(&tmp, md5_alg, sizeof(md5_alg));
+        memset(&tmp2, 0, sizeof(tmp2));
+        der_add_wrapped(&tmp2, 0x31, &tmp);
+        der_add(&signed_data, integer1, sizeof(integer1));
+        der_add(&signed_data, tmp2.data, tmp2.len);
+        memset(&tmp, 0, sizeof(tmp));
+        der_add_wrapped(&tmp, 0x30, &content);
+        der_add(&signed_data, tmp.data, tmp.len);
+        der_add(&signed_data, signer_set.data, signer_set.len);
+
+        memset(&tmp, 0, sizeof(tmp));
+        der_add_wrapped(&tmp, 0x30, &signed_data);
+        memset(&tmp2, 0, sizeof(tmp2));
+        der_add(&tmp2, signed_oid, sizeof(signed_oid));
+        der_add_wrapped(&tmp2, 0xa0, &tmp);
+        memset(&content_info, 0, sizeof(content_info));
+        der_add_wrapped(&content_info, 0x30, &tmp2);
+
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+        ok(!!msg, "got error %#lx.\n", GetLastError());
+        ret = CryptMsgUpdate(msg, content_info.data, content_info.len, TRUE);
+        ok(ret, "message %lu: got error %#lx.\n", i, GetLastError());
+
+        verify_para.dwSignerType = CMSG_VERIFY_SIGNER_NULL;
+        verify_para.pvSigner = NULL;
+        verify_para.dwSignerIndex = 0;
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify_para);
+        if (!i)
+            ok(ret, "got error %#lx.\n", GetLastError());
+        else
+            ok(!ret && GetLastError() == NTE_BAD_SIGNATURE, "got ret %d, error %#lx.\n", ret, GetLastError());
+
+        verify_para.dwSignerIndex = 1;
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &verify_para);
+        ok(!ret && GetLastError() == CRYPT_E_SIGNER_NOT_FOUND, "got ret %d, error %#lx.\n", ret, GetLastError());
+        CryptMsgClose(msg);
+    }
+}
+
 START_TEST(msg)
 {
     /* Basic parameter checking tests */
@@ -3705,4 +3859,5 @@ START_TEST(msg)
 
     test_msg_get_and_verify_signer();
     test_verify_ecc_signature();
+    test_verify_hash_only_signature();
 }
