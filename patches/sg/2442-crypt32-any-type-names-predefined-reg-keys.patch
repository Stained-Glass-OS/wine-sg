From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: Unicode names infer CERT_RDN_ANY_TYPE, registry stores open on predefined keys

Ground truth from Wine's crypt32 tests (4 todo_wine marks removed): in X509_UNICODE_NAME a value of type CERT_RDN_ANY_TYPE takes the type from its text (PrintableString when every character is printable, BMPString otherwise); X509_UNICODE_NAME_VALUE alone still refuses it. CertOpenStore(CERT_STORE_PROV_REG) on a predefined key such as HKEY_CURRENT_USER opens the key again instead of failing to duplicate a pseudo handle.
---
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -1375,14 +1375,33 @@ static BOOL WINAPI CRYPT_AsnEncodeUnicodeNameValue(DWORD dwCertEncodingType,
  LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
  PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded);
 
+static inline BOOL isprintableW(WCHAR wc);
+
 static BOOL WINAPI CRYPT_AsnEncodeOrCopyUnicodeNameValue(
  DWORD dwCertEncodingType, LPCSTR lpszStructType, const void *pvStructInfo,
  DWORD dwFlags, PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded,
  DWORD *pcbEncoded)
 {
     const CERT_NAME_VALUE *value = pvStructInfo;
+    CERT_NAME_VALUE inferred;
     BOOL ret;
 
+    if (value->dwValueType == CERT_RDN_ANY_TYPE)
+    {
+        /* a Unicode name infers the type: PrintableString when every
+         * character is printable, otherwise BMPString */
+        const WCHAR *str = (const WCHAR *)value->Value.pbData;
+        DWORD i, len = value->Value.cbData ? value->Value.cbData / sizeof(WCHAR) : (str ? lstrlenW(str) : 0);
+        BOOL printable = TRUE;
+
+#ifndef SG_MUTANT_NAME_ANY_TYPE
+        for (i = 0; i < len; i++)
+            if (!isprintableW(str[i])) { printable = FALSE; break; }
+        inferred = *value;
+        inferred.dwValueType = printable ? CERT_RDN_PRINTABLE_STRING : CERT_RDN_BMP_STRING;
+        value = &inferred;
+#endif
+    }
     if (value->dwValueType == CERT_RDN_ENCODED_BLOB)
         ret = CRYPT_CopyEncodedBlob(dwCertEncodingType, NULL, &value->Value,
          dwFlags, pEncodePara, pbEncoded, pcbEncoded);
--- a/dlls/crypt32/regstore.c
+++ b/dlls/crypt32/regstore.c
@@ -724,11 +724,18 @@ WINECRYPT_CERTSTORE *CRYPT_RegOpenStore(HCRYPTPROV hCryptProv, DWORD dwFlags,
     else
     {
         HKEY key;
-
-        if (DuplicateHandle(GetCurrentProcess(), (HANDLE)pvPara,
-         GetCurrentProcess(), (LPHANDLE)&key,
-         dwFlags & CERT_STORE_READONLY_FLAG ? KEY_READ : KEY_ALL_ACCESS,
-         TRUE, 0))
+        BOOL have_key;
+        REGSAM access = dwFlags & CERT_STORE_READONLY_FLAG ? KEY_READ : KEY_ALL_ACCESS;
+        ULONG_PTR predefined = (ULONG_PTR)(LONG)(LONG_PTR)pvPara;
+
+        have_key = DuplicateHandle(GetCurrentProcess(), (HANDLE)pvPara, GetCurrentProcess(), (LPHANDLE)&key,
+                                   access, TRUE, 0);
+#ifndef SG_MUTANT_REGSTORE_PREDEFINED
+        /* a predefined key such as HKEY_CURRENT_USER is no handle to duplicate: open it again */
+        if (!have_key && predefined >= (ULONG_PTR)(LONG)0x80000000 && predefined <= (ULONG_PTR)(LONG)0x80000006)
+            have_key = !RegOpenKeyExW((HKEY)pvPara, NULL, 0, access, &key);
+#endif
+        if (have_key)
         {
             WINECRYPT_CERTSTORE *memStore;
 
