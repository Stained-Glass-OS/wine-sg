From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 22:48:24 -0700
Subject: [PATCH] webservices: descriptions of float, double, string, wsz,
 bytes, xml string, qname and date

WsReadType checks the limits of the description (WS_E_INVALID_FORMAT outside)
and WsWriteType now accepts descriptions for the integer, double, date, string,
wsz, bytes, xml string, unique id and qname types instead of failing with
E_NOTIMPL and applies the same limits. Bool and guid descriptions are accepted
and ignored.

diff --git a/dlls/webservices/reader.c b/dlls/webservices/reader.c
index 8fb236b..78e9fd1 100644
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -4627,11 +4627,7 @@ static HRESULT read_type_bool( struct reader *reader, WS_TYPE_MAPPING mapping,
     HRESULT hr;
     BOOL val = FALSE;
 
-    if (desc)
-    {
-        FIXME( "description not supported\n" );
-        return E_NOTIMPL;
-    }
+    if (desc) FIXME( "ignoring description\n" );
     if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_bool( text, &val )) != S_OK) return hr;
 
@@ -5362,10 +5358,9 @@ static HRESULT read_type_float( struct reader *reader, WS_TYPE_MAPPING mapping,
     HRESULT hr;
     float val = 0.0;
 
-    if (desc) FIXME( "ignoring description\n" );
-
     if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_float( text, &val )) != S_OK) return hr;
+    if (*found && desc && (val < desc->minValue || val > desc->maxValue)) return WS_E_INVALID_FORMAT;
 
     switch (option)
     {
@@ -5439,10 +5434,9 @@ static HRESULT read_type_double( struct reader *reader, WS_TYPE_MAPPING mapping,
