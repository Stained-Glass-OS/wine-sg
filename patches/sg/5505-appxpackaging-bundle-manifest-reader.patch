From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxpackaging: IAppxBundleFactory::CreateBundleManifestReader

CreateBundleManifestReader returned E_NOTIMPL. It now reads the bundle
manifest XML from the stream (the stream must support Read, Seek and Stat;
their errors are returned) and gives the IAppxBundleManifestReader the bundle
reader already hands out for a bundle's own manifest: the bundle's identity,
the payload package infos (type, file name, offset, size, resources) and the
manifest's XML as a stream. A stream that does not hold a valid bundle
manifest is APPX_E_INVALID_MANIFEST, as the page documents.
---
--- a/dlls/appxpackaging/main.c
+++ b/dlls/appxpackaging/main.c
@@ -141,8 +141,29 @@ static HRESULT WINAPI bundle_factory_CreateBundleReader( IAppxBundleFactory *ifa
 static HRESULT WINAPI bundle_factory_CreateBundleManifestReader( IAppxBundleFactory *iface, IStream *input,
                                                                  IAppxBundleManifestReader **reader )
 {
-    FIXME( "iface %p, input %p, reader %p stub!\n", iface, input, reader );
+    STATSTG stat;
+    BYTE *data;
+    ULONG read;
+    HRESULT hr;
+
+    TRACE( "iface %p, input %p, reader %p.\n", iface, input, reader );
+#ifdef SG_MUTANT_BM_STUB
     return E_NOTIMPL;
+#endif
+    if (!input || !reader) return E_POINTER;
+    *reader = NULL;
+    /* "The stream must support Read, Seek, and Stat. If these methods fail, their
+     * error codes might be passed to and returned by this method." */
+    if (FAILED(hr = IStream_Stat( input, &stat, STATFLAG_NONAME ))) return hr;
+    if (stat.cbSize.QuadPart > 16 * 1024 * 1024) return APPX_E_INVALID_MANIFEST;
+    if (!(data = malloc( stat.cbSize.QuadPart + 1 ))) return E_OUTOFMEMORY;
+    hr = IStream_Read( input, data, stat.cbSize.QuadPart, &read );
+    if (SUCCEEDED(hr)) hr = bundle_manifest_reader_create( data, read, reader );
+#ifdef SG_MUTANT_BM_ACCEPT_INVALID
+    if (hr == APPX_E_INVALID_MANIFEST) hr = S_OK;
+#endif
+    free( data );
+    return hr;
 }
 
 static const IAppxBundleFactoryVtbl bundle_factory_vtbl =
--- a/dlls/appxpackaging/package.c
+++ b/dlls/appxpackaging/package.c
@@ -1397,6 +1397,18 @@ static HRESULT parse_bundle_manifest( const BYTE *data, SIZE_T size, struct bund
     return APPX_E_INVALID_MANIFEST;
 }
 
+/* IAppxBundleFactory::CreateBundleManifestReader: a bundle manifest read from a stream */
+HRESULT bundle_manifest_reader_create( const BYTE *data, SIZE_T size, IAppxBundleManifestReader **reader )
+{
+    struct bundle_manifest *m;
+    HRESULT hr;
+
+    *reader = NULL;
+    if (FAILED(hr = parse_bundle_manifest( data, size, &m ))) return hr;
+    *reader = &m->IAppxBundleManifestReader_iface;
+    return S_OK;
+}
+
 struct bundle
 {
     IAppxBundleReader IAppxBundleReader_iface;
--- a/dlls/appxpackaging/private.h
+++ b/dlls/appxpackaging/private.h
@@ -79,6 +79,7 @@ HRESULT identity_parse_architecture( const WCHAR *text, APPX_PACKAGE_ARCHITECTUR
 
 HRESULT package_reader_create( IStream *stream, IAppxPackageReader **reader );
 HRESULT bundle_reader_create( IStream *stream, IAppxBundleReader **reader );
+HRESULT bundle_manifest_reader_create( const BYTE *data, SIZE_T size, IAppxBundleManifestReader **reader );
 
 /* ---- helpers ---------------------------------------------------------- */
 
