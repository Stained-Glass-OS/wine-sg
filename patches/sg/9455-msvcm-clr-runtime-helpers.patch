From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcm80, msvcm90: the C++/CLI runtime's helpers: the C++ library forwards, the managed handlers, the default application domain.

Stubs a mixed-mode module could call and abort on. _Mtxinit/_Mtxlock/_Mtxunlock/_Mtxdst, _Once, __Wcrtomb_lk, _Xfsopen and (msvcm80) _Cosh/_Sinh/_FCosh/_FSinh/_LCosh/_LSinh are msvcp80's/msvcp90's; std::_uncaught_exception_m is the C runtime's __uncaught_exception. The managed handlers (_set_new_handler/__query_new_handler_m, std::set_new_handler, set_terminate, set_unexpected for __clrcall functions) are kept and handed back: only managed code calls them, and the CRT keeps them for each application domain, here for the process. __get_default_appdomain gives the loaded runtime's default domain (ICorRuntimeHost::GetDefaultDomain), __release_appdomain releases it. Left as stubs: msvcm80's Dinkumware math internals (_Dnorm, _Dtentox, _Poly, _Stoflt ... whose msvcp80 targets are stubs too), _Atexit, _Debug_message, std::_Throw.
---
--- a/dlls/msvcm80/msvcm_main.c
+++ b/dlls/msvcm80/msvcm_main.c
@@ -125,3 +125,90 @@
 {
     FIXME("%p %p: stub\n", inner, nested);
 }
+
+/* Stained Glass OS (wine-sg 9455): the C++/CLI runtime's own handlers. Managed code gives them as
+ * __clrcall function pointers, which only managed code calls (operator new of a /clr module asks
+ * __query_new_handler_m for its handler), so they are kept, and handed back, here: for the process
+ * (the CRT keeps them for each application domain). */
+static void *new_handler_m, *std_new_handler_m, *terminate_m, *unexpected_m;
+
+/* _PNH __clrcall __query_new_handler_m(void) */
+void * __cdecl msvcm_query_new_handler_m(void)
+{
+    return InterlockedCompareExchangePointer( &new_handler_m, NULL, NULL );
+}
+
+/* _PNH __clrcall _set_new_handler(_PNH) */
+void * __cdecl msvcm__set_new_handler_m( void *handler )
+{
+    TRACE( "%p\n", handler );
+    return InterlockedExchangePointer( &new_handler_m, handler );
+}
+
+/* new_handler std::set_new_handler(new_handler) for managed code */
+void * __cdecl msvcm_set_new_handler_m( void *handler )
+{
+    TRACE( "%p\n", handler );
+    return InterlockedExchangePointer( &std_new_handler_m, handler );
+}
+
+/* terminate_function set_terminate(terminate_function) for managed code */
+void * __cdecl msvcm_set_terminate_m( void *handler )
+{
+    TRACE( "%p\n", handler );
+    return InterlockedExchangePointer( &terminate_m, handler );
+}
+
+/* unexpected_function set_unexpected(unexpected_function) for managed code */
+void * __cdecl msvcm_set_unexpected_m( void *handler )
+{
+    TRACE( "%p\n", handler );
+    return InterlockedExchangePointer( &unexpected_m, handler );
+}
+
+/* HRESULT __get_default_appdomain(IUnknown **): the default application domain of the runtime this
+ * process runs (ICorRuntimeHost::GetDefaultDomain) */
+HRESULT __cdecl msvcm_get_default_appdomain( IUnknown **domain )
+{
+    HRESULT (WINAPI *create)( REFCLSID, REFIID, void ** );
+    ICLRRuntimeInfo *info = NULL;
+    ICorRuntimeHost *host;
+    ICLRMetaHost *metahost;
+    IEnumUnknown *runtimes;
+    IUnknown *unk = NULL;
+    HMODULE mscoree;
+    HRESULT hr;
+
+    TRACE( "%p\n", domain );
+
+    if (!domain) return E_POINTER;
+    *domain = NULL;
+#ifdef SG_MUTANT_MSVCM_NO_APPDOMAIN
+    return E_NOTIMPL;
+#endif
+    if (!(mscoree = GetModuleHandleW( L"mscoree.dll" ))) return CO_E_NOTINITIALIZED;
+    if (!(create = (void *)GetProcAddress( mscoree, "CLRCreateInstance" ))) return E_NOTIMPL;
+    if (FAILED(hr = create( &CLSID_CLRMetaHost, &IID_ICLRMetaHost, (void **)&metahost ))) return hr;
+    hr = ICLRMetaHost_EnumerateLoadedRuntimes( metahost, GetCurrentProcess(), &runtimes );
+    ICLRMetaHost_Release( metahost );
+    if (FAILED(hr)) return hr;
+    hr = IEnumUnknown_Next( runtimes, 1, &unk, NULL );
+    IEnumUnknown_Release( runtimes );
+    if (hr != S_OK) return CO_E_NOTINITIALIZED;
+    hr = IUnknown_QueryInterface( unk, &IID_ICLRRuntimeInfo, (void **)&info );
+    IUnknown_Release( unk );
+    if (FAILED(hr)) return hr;
+    hr = ICLRRuntimeInfo_GetInterface( info, &CLSID_CorRuntimeHost, &IID_ICorRuntimeHost, (void **)&host );
+    ICLRRuntimeInfo_Release( info );
+    if (FAILED(hr)) return hr;
+    hr = ICorRuntimeHost_GetDefaultDomain( host, domain );
+    ICorRuntimeHost_Release( host );
+    return hr;
+}
+
+/* void __release_appdomain(IUnknown *) */
+void __cdecl msvcm_release_appdomain( IUnknown *domain )
+{
+    TRACE( "%p\n", domain );
+    if (domain) IUnknown_Release( domain );
+}
