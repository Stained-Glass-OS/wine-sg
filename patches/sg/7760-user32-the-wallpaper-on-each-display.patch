-    case 2:   /* stretch */
-    case 22:  /* span: one picture across the whole desktop */
+    if (wallpaper_style == 22)  /* span: one picture across the whole desktop */
         StretchBlt( dst, 0, 0, w, h, src, 0, 0, bitmapSize.cx, bitmapSize.cy, SRCCOPY );
-        break;
-    case 6:   /* fit: all of it, letterboxed */
-    case 10:  /* fill: cover the desktop, cropped */
-        if ((wallpaper_style == 10) == ((double)w / h > (double)bitmapSize.cx / bitmapSize.cy))
-        {
-            dw = w; dh = MulDiv( bitmapSize.cy, w, bitmapSize.cx );
-        }
-        else
-        {
-            dh = h; dw = MulDiv( bitmapSize.cx, h, bitmapSize.cy );
-        }
-        StretchBlt( dst, (w - dw) / 2, (h - dh) / 2, dw, dh, src, 0, 0, bitmapSize.cx, bitmapSize.cy, SRCCOPY );
-        break;
-    default:
-        if (fTileWallPaper)
-        {
