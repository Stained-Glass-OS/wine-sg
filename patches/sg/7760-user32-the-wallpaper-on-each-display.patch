-                     bitmapSize.cx, bitmapSize.cy, src, 0, 0, SRCCOPY );
-        break;
+    else if (fTileWallPaper && wallpaper_style == 0)
+    {
+        for (y = 0; y < h; y += bitmapSize.cy)
+            for (x = 0; x < w; x += bitmapSize.cx)
+                BitBlt( dst, x, y, bitmapSize.cx, bitmapSize.cy, src, 0, 0, SRCCOPY );
     }
+    else if (!m.count) place_picture( dst, src, 0, 0, w, h );
+    else
+        for (i = 0; i < m.count; i++)
+            place_picture( dst, src, m.rect[i].left, m.rect[i].top, m.rect[i].right - m.rect[i].left,
+                           m.rect[i].bottom - m.rect[i].top );
     DeleteDC( src );
     DeleteDC( dst );
     scaled_wallpaper = bitmap;
     scaled_size.cx = w;
     scaled_size.cy = h;
+    scaled_nmonitors = m.count;
+    memcpy( scaled_monitors, m.rect, m.count * sizeof(RECT) );
     return bitmap;
 }
 
