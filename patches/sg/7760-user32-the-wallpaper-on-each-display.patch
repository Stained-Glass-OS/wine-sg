From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: the wallpaper on each display

Over several displays (the shell's desktop over every monitor, 7749) the wallpaper was laid out
once for the whole desktop: "Fill" filled them all as one picture, a strip of it on each. As on
Windows, Fill, Fit, Stretch and Centre are laid out on each display now; Span (WallpaperStyle 22)
and tiling still go across them. The layout is kept until the displays change.
---
diff --git a/dlls/user32/desktop.c b/dlls/user32/desktop.c
--- a/dlls/user32/desktop.c
+++ b/dlls/user32/desktop.c
@@ -38,6 +38,8 @@
 static int wallpaper_style;          /* WallpaperStyle: 0 center/tile, 2 stretch, 6 fit, 10 fill, 22 span */
 static HBITMAP scaled_wallpaper;     /* the wallpaper laid out for the desktop at scaled_size */
 static SIZE scaled_size;
+static RECT scaled_monitors[16];     /* and for these displays, in the desktop's coordinates */
+static int scaled_nmonitors;
 
 /* Any picture Windows Imaging Components can read (JPEG, PNG, BMP, GIF,
  * TIFF...), as a 32 bpp top-down DIB section. Only the desktop's process
@@ -96,17 +98,76 @@
     return bitmap;
 }
 
+/* the picture in one display's rectangle, in the wallpaper's style */
+static void place_picture( HDC dst, HDC src, int left, int top, int w, int h )
+{
+    int dw, dh;
+    HRGN clip = CreateRectRgn( left, top, left + w, top + h );
+
+    SelectClipRgn( dst, clip );
+    DeleteObject( clip );
+    switch (wallpaper_style)
+    {
+    case 2:   /* stretch */
+        StretchBlt( dst, left, top, w, h, src, 0, 0, bitmapSize.cx, bitmapSize.cy, SRCCOPY );
+        break;
+    case 6:   /* fit: all of it, letterboxed */
+    case 10:  /* fill: cover the display, cropped */
+        if ((wallpaper_style == 10) == ((double)w / h > (double)bitmapSize.cx / bitmapSize.cy))
+        {
+            dw = w; dh = MulDiv( bitmapSize.cy, w, bitmapSize.cx );
+        }
+        else
+        {
+            dh = h; dw = MulDiv( bitmapSize.cx, h, bitmapSize.cy );
+        }
+        StretchBlt( dst, left + (w - dw) / 2, top + (h - dh) / 2, dw, dh, src, 0, 0, bitmapSize.cx, bitmapSize.cy, SRCCOPY );
+        break;
+    default:  /* centre */
+        BitBlt( dst, left + (w - bitmapSize.cx) / 2, top + (h - bitmapSize.cy) / 2,
+                bitmapSize.cx, bitmapSize.cy, src, 0, 0, SRCCOPY );
+        break;
+    }
+    SelectClipRgn( dst, NULL );
+}
+
+struct monitors { RECT rect[16]; int count; POINT origin; };
+
+static BOOL CALLBACK add_monitor( HMONITOR monitor, HDC hdc, RECT *rect, LPARAM lparam )
+{
+    struct monitors *m = (struct monitors *)lparam;
+    MONITORINFO info = { sizeof(info) };
+    if (m->count < ARRAY_SIZE(m->rect) && GetMonitorInfoW( monitor, &info ))
+    {
+        m->rect[m->count] = info.rcMonitor;
+        OffsetRect( &m->rect[m->count], -m->origin.x, -m->origin.y );
+        m->count++;
+    }
+    return TRUE;
+}
+
 /* Lay the wallpaper out for a desktop of this size, once: the desktop is
- * repainted often, and stretching a large picture each time is slow. */
+ * repainted often, and stretching a large picture each time is slow.
+ * Stained Glass OS: on each display, as Windows lays it out -- over several
+ * displays (wine-sg 7749) "Fill" filled them all as one picture, a strip of it
+ * on each; only "Span" (22) and tiling go across them (wine-sg 7760). */
 static HBITMAP layout_wallpaper( HDC hdc, const RECT *rect )
 {
-    int w = rect->right - rect->left, h = rect->bottom - rect->top, x, y, dw, dh;
+    int w = rect->right - rect->left, h = rect->bottom - rect->top, x, y, i;
     HDC src, dst;
     HBITMAP bitmap;
     HBRUSH background;
     RECT all;
+    struct monitors m = { .count = 0 };
 
-    if (scaled_wallpaper && scaled_size.cx == w && scaled_size.cy == h) return scaled_wallpaper;
+    /* the desktop window starts at the virtual screen's corner */
+    m.origin.x = GetSystemMetrics( SM_XVIRTUALSCREEN );
+    m.origin.y = GetSystemMetrics( SM_YVIRTUALSCREEN );
+#ifndef SG_MUTANT_WALLPAPER_ONE_PICTURE
+    NtUserEnumDisplayMonitors( 0, NULL, add_monitor, (LPARAM)&m );
+#endif
+    if (scaled_wallpaper && scaled_size.cx == w && scaled_size.cy == h && scaled_nmonitors == m.count &&
+        !memcmp( scaled_monitors, m.rect, m.count * sizeof(RECT) )) return scaled_wallpaper;
     if (scaled_wallpaper) DeleteObject( scaled_wallpaper );
     scaled_wallpaper = 0;
     if (!hbitmapWallPaper || w <= 0 || h <= 0) return 0;
@@ -123,40 +184,26 @@
     SetStretchBltMode( dst, HALFTONE );
     SetBrushOrgEx( dst, 0, 0, NULL );
 
-    switch (wallpaper_style)
