From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wintrust: cache state actions and two certificate helpers

- WinVerifyTrust and the certificate action treated WTD_STATEACTION_AUTO_CACHE
  and AUTO_CACHE_FLUSH as unimplemented: the call logged a FIXME and returned
  success without verifying anything. AUTO_CACHE now verifies and keeps the
  state like VERIFY (callers in the cache style call it for every file and
  must see the real result), and AUTO_CACHE_FLUSH releases it like CLOSE.
- WTHelperCertCheckValidSignature always said S_OK. It now checks, for every
  signer, that each certificate in the chain carries a valid signature from
  the next one up (the last against itself), and answers
  TRUST_E_CERT_SIGNATURE, recording it as the final-certprov step error,
  otherwise; NULL provider data is E_INVALIDARG.
- WTHelperCertIsSelfSigned was not exported. It is: subject and issuer name
  equal, ERROR_INVALID_PARAMETER for a NULL CERT_INFO.

Gate: test/wintrusthelp-gate.sh (64- and 32-bit, test/wintrusthelp-probe.c).
Mutants SG_MUTANT_WT_NOCACHE/SIGOK/SELFSIGN (wintrust/wintrust_main.c).
---
--- a/dlls/wintrust/wintrust.spec
+++ b/dlls/wintrust/wintrust.spec
@@ -90,7 +90,7 @@
 #@ stub WTGetSignatureInfo
 @ stdcall WTHelperCertCheckValidSignature(ptr)
 @ stub WTHelperCertFindIssuerCertificate
-@ stub WTHelperCertIsSelfSigned
+@ stdcall WTHelperCertIsSelfSigned(long ptr)
 @ stub WTHelperCheckCertUsage
 @ stub WTHelperGetAgencyInfo
 @ stdcall WTHelperGetFileHandle(ptr)
--- a/dlls/wintrust/wintrust_main.c
+++ b/dlls/wintrust/wintrust_main.c
@@ -523,9 +523,13 @@ static LONG WINTRUST_CertActionVerify(HWND hwnd, GUID *actionID,
         err = WINTRUST_CertVerifyAndClose(hwnd, actionID, data);
         break;
     case WTD_STATEACTION_VERIFY:
+#ifndef SG_MUTANT_WT_NOCACHE
+    case WTD_STATEACTION_AUTO_CACHE:
+#endif
         err = WINTRUST_CertVerify(hwnd, actionID, data);
         break;
     case WTD_STATEACTION_CLOSE:
+    case WTD_STATEACTION_AUTO_CACHE_FLUSH:
         err = WINTRUST_DefaultClose(hwnd, actionID, data);
         break;
     default:
@@ -705,9 +709,13 @@ LONG WINAPI WinVerifyTrust( HWND hwnd, GUID *ActionID, LPVOID ActionData )
             err = WINTRUST_DefaultVerifyAndClose(hwnd, ActionID, ActionData);
             break;
         case WTD_STATEACTION_VERIFY:
+#ifndef SG_MUTANT_WT_NOCACHE
+        case WTD_STATEACTION_AUTO_CACHE:
+#endif
             err = WINTRUST_DefaultVerify(hwnd, ActionID, ActionData);
             break;
         case WTD_STATEACTION_CLOSE:
+        case WTD_STATEACTION_AUTO_CACHE_FLUSH:
             err = WINTRUST_DefaultClose(hwnd, ActionID, ActionData);
             break;
         default:
@@ -1135,10 +1143,61 @@ BOOL WINAPI OpenPersonalTrustDBDialog(HWND hwnd)
  */
 HRESULT WINAPI WTHelperCertCheckValidSignature(CRYPT_PROVIDER_DATA *pProvData)
 {
-    FIXME("Stub\n");
+    DWORD i, j;
+
+    TRACE("(%p)\n", pProvData);
+
+    if (!pProvData || pProvData->cbStruct < FIELD_OFFSET(CRYPT_PROVIDER_DATA, pasSigners))
+        return E_INVALIDARG;
+
+    /* Every certificate in every signer's chain must carry a valid signature
+     * from the next certificate up; the last one is checked against itself
+     * (a root signs itself), as the chain's own validity check does. */
+    for (i = 0; i < pProvData->csSigners; i++)
+    {
+        CRYPT_PROVIDER_SGNR *sgnr = &pProvData->pasSigners[i];
+
+        for (j = 0; j < sgnr->csCertChain; j++)
+        {
+            PCCERT_CONTEXT cert = sgnr->pasCertChain[j].pCert;
+            PCCERT_CONTEXT issuer = (j + 1 < sgnr->csCertChain) ? sgnr->pasCertChain[j + 1].pCert : cert;
+
+#ifdef SG_MUTANT_WT_SIGOK
+            continue;
+#endif
+            if (!cert || !issuer ||
+                !CryptVerifyCertificateSignatureEx(0, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_CERT,
+                        (void *)cert, CRYPT_VERIFY_CERT_SIGN_ISSUER_CERT, (void *)issuer, 0, NULL))
+            {
+                if (pProvData->padwTrustStepErrors)
+                    pProvData->padwTrustStepErrors[TRUSTERROR_STEP_FINAL_CERTPROV] = TRUST_E_CERT_SIGNATURE;
+                return TRUST_E_CERT_SIGNATURE;
+            }
+        }
+    }
     return S_OK;
 }
 
+/***********************************************************************
+ *		WTHelperCertIsSelfSigned
+ *
+ * A certificate is self-signed when its issuer and subject name are the same.
+ */
+BOOL WINAPI WTHelperCertIsSelfSigned(DWORD dwEncoding, CERT_INFO *pCert)
+{
+    TRACE("(%#lx, %p)\n", dwEncoding, pCert);
+
+    if (!pCert)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+#ifdef SG_MUTANT_WT_SELFSIGN
+    return TRUE;
+#endif
+    return CertCompareCertificateName(dwEncoding, &pCert->Subject, &pCert->Issuer);
+}
