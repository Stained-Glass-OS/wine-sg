+void * CDECL u_strFromUTF8(void * dest, int destCapacity, void * pDestLength, void * src, int srcLength, void * pErrorCode)
+{
+    struct icu_call icu_c = {{0}};
+    TRACE("\n");
+    icu_c.a[0] = (ULONG_PTR)dest;
+    icu_c.a[1] = (INT64)destCapacity;
+    icu_c.a[2] = (ULONG_PTR)pDestLength;
+    icu_c.a[3] = (ULONG_PTR)src;
+    icu_c.a[4] = (INT64)srcLength;
+    icu_c.a[5] = (ULONG_PTR)pErrorCode;
+    if (!host_ok && pErrorCode) *(int *)pErrorCode = 16;
+    icu_call(unix_u_strFromUTF8, &icu_c);
+    return icu_c.ret ? dest : NULL;
+}
