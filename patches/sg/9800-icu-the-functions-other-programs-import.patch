     f.write('''/* icu.dll: the ICU C API that .NET's System.Globalization.Native binds (every name on its list,
  * as Windows' icu.dll exports them all), forwarded to the host's ICU (wine-sg 6268). Generated by
@@ -377,6 +388,8 @@
