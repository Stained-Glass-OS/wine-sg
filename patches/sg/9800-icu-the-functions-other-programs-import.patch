+int CDECL ulistfmt_format(void * listfmt, void * strings, void * stringLengths, int stringCount, void * result, int resultCapacity, void * status)
+{
+    struct icu_call icu_c = {{0}};
+#ifndef _WIN64
+    UINT64 *wide_strings = NULL;
+    int i;
+#endif
+    TRACE("\n");
+    icu_c.a[0] = h_in(listfmt);
+    icu_c.a[1] = (ULONG_PTR)strings;
+    icu_c.a[2] = (ULONG_PTR)stringLengths;
+    icu_c.a[3] = (INT64)stringCount;
+    icu_c.a[4] = (ULONG_PTR)result;
+    icu_c.a[5] = (INT64)resultCapacity;
+    icu_c.a[6] = (ULONG_PTR)status;
+#ifndef _WIN64
+    if (strings && stringCount > 0 && (wide_strings = malloc(stringCount * sizeof(UINT64))))
+        for (i = 0; i < stringCount; i++) wide_strings[i] = (ULONG_PTR)((void **)strings)[i];
+    if (wide_strings) icu_c.a[1] = (ULONG_PTR)wide_strings;
+#endif
+    if (!host_ok && status) *(int *)status = 16;
+    icu_call(unix_ulistfmt_format, &icu_c);
+#ifndef _WIN64
+    free(wide_strings);
+#endif
+    return (int)icu_c.ret;
+}
