From: Stained Glass OS contributors
Subject: shell32: ShellExecute of a URL longer than MAX_PATH does not overrun the stack

SHELL_FindExecutable copied the "file" into a MAX_PATH buffer on the stack
to look for it on disk. A URL is passed the same way, and a mailto: link
with a body of a few thousand characters overran it: the caller crashed on
return (Report a problem's Email button). A string that long is no file;
the search is skipped and the URL goes to its handler whole.

--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -754,7 +754,9 @@
                 found = TRUE;
             }
         }
-        if (!found)
+        /* Stained Glass OS: a "file" longer than a path -- a long URL, as a
+         * mailto: with a body -- is no file here, and would overrun xlpFile */
+        if (!found && lstrlenW(lpFile) < ARRAY_SIZE(xlpFile))
         {
             lstrcpyW(xlpFile, lpFile);
             if (PathFileExistsDefExtW(xlpFile, 0xbf) || PathFileExistsW(xlpFile))
@@ -780,9 +782,9 @@
         }
         else
             search_paths[0] = curdir;
-        lstrcpyW(xlpFile, lpFile);
-        if (PathResolveW(xlpFile, search_paths, PRF_TRYPROGRAMEXTENSIONS | PRF_VERIFYEXISTS) ||
-            PathFindOnPathW(xlpFile, search_paths))
+        if (lstrlenW(lpFile) < ARRAY_SIZE(xlpFile) && (lstrcpyW(xlpFile, lpFile),
+            PathResolveW(xlpFile, search_paths, PRF_TRYPROGRAMEXTENSIONS | PRF_VERIFYEXISTS) ||
+            PathFindOnPathW(xlpFile, search_paths)))
         {
             TRACE("PathResolveAW returned non-zero\n");
             lpFile = xlpFile;
