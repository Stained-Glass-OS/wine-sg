+/* The per-process error record of MsiGetLastErrorRecord: set or cleared by the database functions the
+ * MsiGetLastErrorRecord topic lists.  Field 0 is the format string, field 1 the installer error code, field 2
+ * the database and the others the parameters of the message (Windows Installer Error Messages). */
+static CRITICAL_SECTION last_error_cs;
+static CRITICAL_SECTION_DEBUG last_error_cs_debug =
+{
+    0, 0, &last_error_cs,
+    { &last_error_cs_debug.ProcessLocksList, &last_error_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": last_error_cs") }
+};
+static CRITICAL_SECTION last_error_cs = { &last_error_cs_debug, -1, 0, 0, 0, 0 };
+static MSIRECORD *last_error_record;
+
+static const struct { UINT code; const WCHAR *text; } last_error_texts[] =
+{
+    { 2203, L"Database: [2]. Cannot open database file. System error [3]." },
+    { 2204, L"Database: [2]. Table already exists: [3]." },
+    { 2214, L"Database: [2]. Error writing export file: [3]." },
+    { 2215, L"Database: [2]. Cannot open import file: [3]." },
+    { 2219, L"Database: [2]. Invalid Installer database format." },
+    { 2228, L"Database: [2]. Unknown table '[3]' in SQL query: [4]." },
+    { 2232, L"Database: [2]. Unexpected token '[3]' in SQL query: [4]." },
+    { 2235, L"Database: [2]. Column '[3]' not present or ambiguous in SQL query: [4]." },
+    { 2246, L"Database: [2]. Invalid Installer transform format." },
+    { 2268, L"Database: [2]. Merge: There were merge conflicts reported in [3] tables." },
+};
+
+void msi_clear_last_error(void)
+{
+    MSIRECORD *old;
+
+#ifdef SG_MUTANT_MSIB2_NOCLEAR
+    return;
+#endif
+
+    EnterCriticalSection( &last_error_cs );
+    old = last_error_record;
+    last_error_record = NULL;
+    LeaveCriticalSection( &last_error_cs );
+    if (old) msiobj_release( &old->hdr );
+}
+
+static MSIRECORD *make_last_error( const WCHAR *dbpath, UINT code, const WCHAR *arg3, const WCHAR *arg4, int count )
+{
+    MSIRECORD *rec = MSI_CreateRecord( count );
+    unsigned int i;
+
+    if (!rec) return NULL;
+    for (i = 0; i < ARRAY_SIZE(last_error_texts); i++)
+        if (last_error_texts[i].code == code) MSI_RecordSetStringW( rec, 0, last_error_texts[i].text );
+    MSI_RecordSetInteger( rec, 1, code );
+    MSI_RecordSetStringW( rec, 2, dbpath ? dbpath : L"" );
+    if (arg3) MSI_RecordSetStringW( rec, 3, arg3 );
+    if (arg4) MSI_RecordSetStringW( rec, 4, arg4 );
+    return rec;
+}
+
+static void store_last_error( MSIRECORD *rec, BOOL only_if_none )
+{
+    MSIRECORD *old;
+
+    if (!rec) return;
+    EnterCriticalSection( &last_error_cs );
+    if (only_if_none && last_error_record)
+    {
+        LeaveCriticalSection( &last_error_cs );
+        msiobj_release( &rec->hdr );
+        return;
+    }
+    old = last_error_record;
+    last_error_record = rec;
+    LeaveCriticalSection( &last_error_cs );
+    if (old) msiobj_release( &old->hdr );
+}
+
+void msi_set_last_error( const WCHAR *dbpath, UINT code, const WCHAR *arg3, const WCHAR *arg4 )
+{
+    store_last_error( make_last_error( dbpath, code, arg3, arg4, arg4 ? 4 : arg3 ? 3 : 2 ), FALSE );
+}
+
+/* only when nothing more specific was recorded while the function ran */
+void msi_set_last_error_default( const WCHAR *dbpath, UINT code, const WCHAR *arg3, const WCHAR *arg4 )
+{
+    store_last_error( make_last_error( dbpath, code, arg3, arg4, arg4 ? 4 : arg3 ? 3 : 2 ), TRUE );
+}
+
+void msi_set_last_error_int( const WCHAR *dbpath, UINT code, int arg3 )
+{
+    MSIRECORD *rec = make_last_error( dbpath, code, NULL, NULL, 3 );
+
+    if (rec) MSI_RecordSetInteger( rec, 3, arg3 );
+    store_last_error( rec, FALSE );
+}
+
