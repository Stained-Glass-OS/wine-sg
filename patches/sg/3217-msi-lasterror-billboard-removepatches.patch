+/******************** Billboard ********************************************/
+
+/* A Billboard control hosts the Text, Bitmap and Icon controls of one row of the Billboard table (the
+ * BBControl table).  The billboard is chosen by the progress messages of the actions listed in the Billboard
+ * table (EventMapping SetProgress -> Progress), or by name (MsiPreviewBillboard). */
+
+struct billboard_request
+{
+    msi_dialog *dialog;
+    struct control *control;
+    const WCHAR *name;
+    UINT result;
+};
+
+static UINT billboard_add_control( MSIRECORD *row, void *param )
+{
+    struct billboard_request *req = param;
+    msi_dialog *dialog = req->dialog;
+    const WCHAR *type = MSI_RecordGetString( row, 3 );
+    MSIRECORD *rec;
+    WCHAR *name;
+    unsigned int i;
+
+    if (!type) return ERROR_SUCCESS;
+#ifndef SG_MUTANT_MSIB2_BBTYPE
+    if (wcsicmp( type, L"Text" ) && wcsicmp( type, L"Bitmap" ) && wcsicmp( type, L"Icon" ))
+#else
+    if (0)
+#endif
+    {
+        WARN( "billboard control type %s is not allowed\n", debugstr_w(type) );
+        return ERROR_SUCCESS;
+    }
+
+    /* the BBControl row has the columns of a Control row up to Attributes, then the text */
+    if (!(rec = MSI_CreateRecord( 12 ))) return ERROR_OUTOFMEMORY;
+    name = malloc( (wcslen( req->control->name ) + wcslen( MSI_RecordGetString( row, 2 ) ) + 2) * sizeof(WCHAR) );
+    if (!name)
+    {
+        msiobj_release( &rec->hdr );
+        return ERROR_OUTOFMEMORY;
+    }
+    swprintf( name, wcslen( req->control->name ) + wcslen( MSI_RecordGetString( row, 2 ) ) + 2, L"%s/%s",
+              req->control->name, MSI_RecordGetString( row, 2 ) );
+    MSI_RecordSetStringW( rec, 1, dialog->name );
+    MSI_RecordSetStringW( rec, 2, name );
+    MSI_RecordSetStringW( rec, 3, type );
+    for (i = 4; i <= 8; i++) MSI_RecordSetInteger( rec, i, MSI_RecordGetInteger( row, i ) );
+    MSI_RecordSetStringW( rec, 10, MSI_RecordGetString( row, 9 ) );
+    free( name );
+
+    dialog_create_control_type( dialog, rec, type );
+    msiobj_release( &rec->hdr );
+    return ERROR_SUCCESS;
+}
+
+static void billboard_clear( msi_dialog *dialog, struct control *host )
+{
+    struct control *c, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( c, next, &dialog->controls, struct control, entry )
+    {
+#ifdef SG_MUTANT_MSIB2_BBCLEAR
+        break;
+#endif
+        if (c->bb_host != host->hwnd) continue;
+        if (c->hwnd) DestroyWindow( c->hwnd );
+        destroy_control( c );
+    }
+    free( host->bb_current );
+    host->bb_current = NULL;
+}
+
+static void billboard_show_ui( struct billboard_request *req )
+{
+    msi_dialog *dialog = req->dialog;
+    struct control *host = req->control;
+    MSIQUERY *view;
+    MSIRECORD *row;
+
+    req->result = ERROR_SUCCESS;
+    if (req->name && !(row = MSI_QueryGetRecord( dialog->package->db, L"SELECT * FROM `Billboard` WHERE `Billboard` = '%s'",
+                                                 req->name )))
+    {
+        req->result = ERROR_FUNCTION_FAILED;
+        return;
+    }
+    if (req->name) msiobj_release( &row->hdr );
+
+    billboard_clear( dialog, host );
+    if (!req->name) return;
+
+    host->bb_current = wcsdup( req->name );
+    host->bb_tick = GetTickCount();
+    dialog->bb_host = host->hwnd;
+    if (!MSI_OpenQuery( dialog->package->db, &view, L"SELECT * FROM `BBControl` WHERE `Billboard_` = '%s'", req->name ))
+    {
+        MSI_IterateRecords( view, NULL, billboard_add_control, req );
+        msiobj_release( &view->hdr );
+    }
+    dialog->bb_host = NULL;
+    InvalidateRect( host->hwnd, NULL, TRUE );
+}
+
+static UINT billboard_show( msi_dialog *dialog, struct control *host, const WCHAR *name )
+{
+    struct billboard_request req = { dialog, host, name, ERROR_SUCCESS };
+
+    if (!hMsiHiddenWindow) dialog_register_class();
+    if (uiThreadId != GetCurrentThreadId())
+        SendMessageW( hMsiHiddenWindow, WM_MSI_BILLBOARD, 0, (LPARAM)&req );
+    else
+        billboard_show_ui( &req );
+    return req.result;
+}
+
+struct billboard_choice
+{
+    msi_dialog *dialog;
+    WCHAR *names[32];
+    unsigned int count;
+};
+
+static UINT billboard_collect( MSIRECORD *row, void *param )
+{
+    struct billboard_choice *choice = param;
+    const WCHAR *feature = MSI_RecordGetString( row, 2 );
+    MSIFEATURE *f;
+
+    /* only when the feature of the billboard is being installed */
+    f = feature ? msi_get_loaded_feature( choice->dialog->package, feature ) : NULL;
+#ifndef SG_MUTANT_MSIB2_BBFEAT
+    if (!f || (f->ActionRequest != INSTALLSTATE_LOCAL && f->ActionRequest != INSTALLSTATE_SOURCE)) return ERROR_SUCCESS;
+#endif
+    if (choice->count < ARRAY_SIZE(choice->names)) choice->names[choice->count++] = wcsdup( MSI_RecordGetString( row, 1 ) );
+    return ERROR_SUCCESS;
+}
+
+/* a progress message of the action being run: show the billboards of that action in turn (a slide show,
+ * one every second at most) */
+static void billboard_progress( msi_dialog *dialog, struct control *host )
+{
+    struct billboard_choice choice = { dialog };
+    MSIQUERY *view;
+    unsigned int i, pick = 0;
+
+#ifdef SG_MUTANT_MSIB2_BBPROG
+    return;
+#endif
+    if (!dialog->package->LastAction) return;
+    if (!MSI_OpenQuery( dialog->package->db, &view,
+                        L"SELECT `Billboard`, `Feature_` FROM `Billboard` WHERE `Action` = '%s' ORDER BY `Ordering`",
+                        dialog->package->LastAction ))
+    {
+        MSI_IterateRecords( view, NULL, billboard_collect, &choice );
+        msiobj_release( &view->hdr );
+    }
+
+    if (!choice.count)
+    {
+        if (host->bb_current) billboard_show( dialog, host, NULL );
+        return;
+    }
+    for (i = 0; i < choice.count; i++)
+        if (host->bb_current && !wcscmp( host->bb_current, choice.names[i] )) break;
+    if (i < choice.count)
+    {
+#ifndef SG_MUTANT_MSIB2_BBTICK
+        if (GetTickCount() - host->bb_tick < 1000) goto done;
+#endif
+        pick = (i + 1) % choice.count;
+    }
+    billboard_show( dialog, host, choice.names[pick] );
+
+done:
+    for (i = 0; i < choice.count; i++) free( choice.names[i] );
+}
+
+static UINT dialog_billboard_control( msi_dialog *dialog, MSIRECORD *rec )
+{
+    struct control *control = dialog_add_control( dialog, rec, L"Static", WS_VISIBLE | WS_CLIPCHILDREN );
+
+    return control ? ERROR_SUCCESS : ERROR_FUNCTION_FAILED;
+}
