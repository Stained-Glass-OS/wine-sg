+/* MsiRemovePatches reinstalls the product without the patches being removed: they stay registered while
+ * the package opens, but are not applied */
+static CRITICAL_SECTION removal_cs;
+static CRITICAL_SECTION_DEBUG removal_cs_debug =
+{
+    0, 0, &removal_cs,
+    { &removal_cs_debug.ProcessLocksList, &removal_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": removal_cs") }
+};
+static CRITICAL_SECTION removal_cs = { &removal_cs_debug, -1, 0, 0, 0, 0 };
+static WCHAR **removal_codes;
+static unsigned int removal_count;
+
+BOOL msi_patch_is_being_removed( const WCHAR *patch_code )
+{
+    BOOL ret = FALSE;
+    unsigned int i;
+
+    EnterCriticalSection( &removal_cs );
+    for (i = 0; i < removal_count; i++)
+        if (!wcsicmp( removal_codes[i], patch_code )) { ret = TRUE; break; }
+    LeaveCriticalSection( &removal_cs );
+    return ret;
+}
+
+void msi_set_patches_being_removed( WCHAR **codes, unsigned int count )
+{
+    unsigned int i;
+
+    EnterCriticalSection( &removal_cs );
+    for (i = 0; i < removal_count; i++) free( removal_codes[i] );
+    free( removal_codes );
+    removal_codes = NULL;
+    removal_count = 0;
+    if (count && (removal_codes = calloc( count, sizeof(*removal_codes) )))
+    {
+        for (i = 0; i < count; i++) removal_codes[i] = wcsdup( codes[i] );
+        removal_count = count;
+    }
+    LeaveCriticalSection( &removal_cs );
+}
+
+/* the patch code and the product list (the template property) of a patch package */
+UINT msi_get_patch_file_info( const WCHAR *file, WCHAR *code, WCHAR **products )
+{
+    MSIDATABASE *patch_db;
+    MSISUMMARYINFO *si;
+    MSIPATCHINFO *info;
+    UINT r;
+
+    if (MSI_OpenDatabaseW( file, MSIDBOPEN_READONLY + MSIDBOPEN_PATCHFILE, &patch_db ) != ERROR_SUCCESS)
+        return ERROR_PATCH_PACKAGE_OPEN_FAILED;
+    r = msi_get_suminfo( patch_db->storage, 0, &si );
+    msiobj_release( &patch_db->hdr );
+    if (r != ERROR_SUCCESS) return ERROR_PATCH_PACKAGE_INVALID;
+    r = parse_patch_summary( si, &info );
+    msiobj_release( &si->hdr );
+    if (r != ERROR_SUCCESS) return r == ERROR_OUTOFMEMORY ? r : ERROR_PATCH_PACKAGE_INVALID;
+    lstrcpyW( code, info->patchcode );
+    if (products) *products = wcsdup( info->products );
+    msi_free_patchinfo( info );
+    return ERROR_SUCCESS;
+}
+
+static void remove_from_multisz( HKEY key, const WCHAR *name, const WCHAR *item )
+{
+    DWORD size = 0, type, len, i, o = 0;
+    WCHAR *data, *out;
+
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, &size ) || type != REG_MULTI_SZ) return;
+    len = size / sizeof(WCHAR);
+    if (!(data = calloc( len + 2, sizeof(WCHAR) )) || !(out = calloc( len + 2, sizeof(WCHAR) )))
+    {
+        free( data );
+        return;
+    }
+    if (!RegQueryValueExW( key, name, NULL, &type, (BYTE *)data, &size ))
+    {
+        for (i = 0; i < len && data[i]; i += lstrlenW( data + i ) + 1)
+        {
+            if (!wcsicmp( data + i, item )) continue;
+            lstrcpyW( out + o, data + i );
+            o += lstrlenW( data + i ) + 1;
+        }
+        if (o)
+            RegSetValueExW( key, name, 0, REG_MULTI_SZ, (const BYTE *)out, (o + 1) * sizeof(WCHAR) );
+        else
+            RegDeleteValueW( key, name );
+    }
+    free( data );
+    free( out );
+}
+
+/* forget a patch that was removed from a product (the files were put back by the reinstall) */
+UINT msi_unregister_patch( const WCHAR *product, MSIINSTALLCONTEXT context, const WCHAR *patch_code )
+{
+    WCHAR squashed[GUID_SIZE], local[MAX_PATH], *products = NULL, file[MAX_PATH];
+    HKEY key, patches;
+    DWORD len = ARRAY_SIZE(local);
+    BOOL only_this_product = FALSE;
+
+    if (!squash_guid( patch_code, squashed )) return ERROR_INVALID_PARAMETER;
+
+    if (!MsiGetPatchInfoExW( patch_code, product, NULL, context, INSTALLPROPERTY_LOCALPACKAGEW, local, &len ))
+    {
+        WCHAR code[GUID_SIZE];
+
+        if (!msi_get_patch_file_info( local, code, &products ) && products)
+            only_this_product = !wcsicmp( products, product );
+        lstrcpyW( file, local );
+    }
+    else file[0] = 0;
+    free( products );
+
+    if (!MSIREG_OpenProductKey( product, NULL, context, &key, FALSE ))
+    {
+        if (!RegOpenKeyExW( key, L"Patches", 0, KEY_ALL_ACCESS, &patches ))
+        {
+            RegDeleteValueW( patches, squashed );
+            remove_from_multisz( patches, L"Patches", squashed );
+            RegCloseKey( patches );
+        }
+        RegCloseKey( key );
+    }
+    if (!MSIREG_OpenUserDataProductPatchesKey( product, context, &patches, FALSE ))
+    {
+        RegDeleteTreeW( patches, squashed );
+        remove_from_multisz( patches, L"AllPatches", squashed );
+        RegCloseKey( patches );
+    }
+    if (only_this_product)
+    {
+        MSIREG_DeleteUserDataPatchKey( patch_code, context );
+        if (file[0]) DeleteFileW( file );
+    }
+    return ERROR_SUCCESS;
+}
