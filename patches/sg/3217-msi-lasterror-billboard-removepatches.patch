+        return 0;
     case WM_MSI_DIALOG_CREATE:
         return dialog_run_message_loop( dialog );
     case WM_MSI_DIALOG_DESTROY:
@@ -4335,14 +4552,38 @@ UINT WINAPI MsiPreviewDialogA( MSIHANDLE hPreview, LPCSTR szDialogName )
 
 UINT WINAPI MsiPreviewBillboardW( MSIHANDLE hPreview, const WCHAR *szControlName, const WCHAR *szBillboard )
 {
-    FIXME( "%lu %s %s\n", hPreview, debugstr_w(szControlName), debugstr_w(szBillboard) );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    MSIPREVIEW *preview;
+    struct control *control;
+    UINT r;
+
+    TRACE( "%lu %s %s\n", hPreview, debugstr_w(szControlName), debugstr_w(szBillboard) );
+
+    if (!(preview = msihandle2msiinfo( hPreview, MSIHANDLETYPE_PREVIEW ))) return ERROR_INVALID_HANDLE;
+
+    /* the billboard goes into a Billboard control of the dialog being previewed */
+    if (!szControlName || !preview->dialog ||
+        !(control = dialog_find_control( preview->dialog, szControlName )) || wcsicmp( control->type, L"Billboard" ))
+        r = ERROR_FUNCTION_FAILED;
+    else
+        r = billboard_show( preview->dialog, control, szBillboard );   /* a NULL billboard removes the current one */
+    msiobj_release( &preview->hdr );
+    return r;
 }
 
 UINT WINAPI MsiPreviewBillboardA( MSIHANDLE hPreview, const char *szControlName, const char *szBillboard )
 {
-    FIXME( "%lu %s %s\n", hPreview, debugstr_a(szControlName), debugstr_a(szBillboard) );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    WCHAR *control = NULL, *billboard = NULL;
+    UINT r = ERROR_OUTOFMEMORY;
+
+    TRACE( "%lu %s %s\n", hPreview, debugstr_a(szControlName), debugstr_a(szBillboard) );
+
+    if (szControlName && !(control = strdupAtoW( szControlName ))) goto done;
+    if (szBillboard && !(billboard = strdupAtoW( szBillboard ))) goto done;
+    r = MsiPreviewBillboardW( hPreview, control, billboard );
+done:
+    free( control );
+    free( billboard );
+    return r;
 }
 
