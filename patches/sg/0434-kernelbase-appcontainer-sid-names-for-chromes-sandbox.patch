+/* AppContainer SID names, kept where Windows keeps them: the user's
+ * AppContainer\Mappings\<SID> key, with the moniker and the display name. */
+static const WCHAR appcontainer_mappingsW[] =
+    L"Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\CurrentVersion\\AppContainer\\Mappings";
+
+static BOOL appcontainer_key_name( PSID psid, WCHAR *buf, DWORD len )
+{
+    SID *sid = psid;
+    DWORD i, n;
+    ULONGLONG auth = 0;
+
+    if (!psid || !IsValidSid( psid )) return FALSE;
+    for (i = 0; i < 6; i++) auth = (auth << 8) | sid->IdentifierAuthority.Value[i];
+    n = swprintf( buf, len, L"%s\\S-%u-%I64u", appcontainer_mappingsW, sid->Revision, auth );
+    for (i = 0; i < sid->SubAuthorityCount && n < len; i++)
+        n += swprintf( buf + n, len - n, L"-%lu", sid->SubAuthority[i] );
+    return n < len;
+}
+
+/******************************************************************************
+ *           AppContainerRegisterSid   (kernelbase.@)
+ *
+ * Chromium's sandbox names its AppContainer SIDs this way when it creates a
+ * profile, and stops the browser (a CHECK) when the export is missing.
+ */
+HRESULT WINAPI AppContainerRegisterSid( PSID sid, const WCHAR *moniker, const WCHAR *display_name )
+{
+    WCHAR name[512];
+    LSTATUS ret;
+    HKEY key;
+
+    TRACE( "%p %s %s\n", sid, debugstr_w(moniker), debugstr_w(display_name) );
+
+    if (!moniker || !appcontainer_key_name( sid, name, ARRAY_SIZE(name) )) return E_INVALIDARG;
+    if ((ret = RegCreateKeyExW( HKEY_CURRENT_USER, name, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( ret );
+    ret = RegSetValueExW( key, L"Moniker", 0, REG_SZ, (const BYTE *)moniker, (lstrlenW( moniker ) + 1) * sizeof(WCHAR) );
+    if (!ret && display_name)
+        ret = RegSetValueExW( key, L"DisplayName", 0, REG_SZ, (const BYTE *)display_name,
+                              (lstrlenW( display_name ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return HRESULT_FROM_WIN32( ret );
+}
+
+/******************************************************************************
+ *           AppContainerUnregisterSid   (kernelbase.@)
+ */
+HRESULT WINAPI AppContainerUnregisterSid( PSID sid )
+{
+    WCHAR name[512];
+    LSTATUS ret;
+
+    TRACE( "%p\n", sid );
+
+    if (!appcontainer_key_name( sid, name, ARRAY_SIZE(name) )) return E_INVALIDARG;
+    ret = RegDeleteTreeW( HKEY_CURRENT_USER, name );
+    if (!ret) ret = RegDeleteKeyExW( HKEY_CURRENT_USER, name, 0, 0 );
+    return ret == ERROR_FILE_NOT_FOUND ? S_OK : HRESULT_FROM_WIN32( ret );
+}
+
+/******************************************************************************
+ *           AppContainerLookupMoniker   (kernelbase.@)
+ *
+ * The moniker a SID was registered with, allocated for AppContainerFreeMemory.
+ */
+HRESULT WINAPI AppContainerLookupMoniker( PSID sid, WCHAR **moniker )
+{
+    WCHAR name[512];
+    DWORD size = 0;
+    LSTATUS ret;
+
+    TRACE( "%p %p\n", sid, moniker );
+
+    if (!moniker) return E_INVALIDARG;
+    *moniker = NULL;
+    if (!appcontainer_key_name( sid, name, ARRAY_SIZE(name) )) return E_INVALIDARG;
+    if ((ret = RegGetValueW( HKEY_CURRENT_USER, name, L"Moniker", RRF_RT_REG_SZ, NULL, NULL, &size )))
+        return HRESULT_FROM_WIN32( ret == ERROR_FILE_NOT_FOUND ? ERROR_NOT_FOUND : ret );
+    if (!(*moniker = HeapAlloc( GetProcessHeap(), 0, size ))) return E_OUTOFMEMORY;
+    if ((ret = RegGetValueW( HKEY_CURRENT_USER, name, L"Moniker", RRF_RT_REG_SZ, NULL, *moniker, &size )))
+    {
+        HeapFree( GetProcessHeap(), 0, *moniker );
+        *moniker = NULL;
+        return HRESULT_FROM_WIN32( ret );
+    }
+    return S_OK;
+}
+
+/******************************************************************************
+ *           AppContainerFreeMemory   (kernelbase.@)
+ */
+void WINAPI AppContainerFreeMemory( void *ptr )
+{
+    HeapFree( GetProcessHeap(), 0, ptr );
+}
