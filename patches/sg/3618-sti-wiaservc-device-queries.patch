@@ -101,10 +262,38 @@ static HRESULT WINAPI stillimagew_CreateDevice(IStillImageW *iface, LPWSTR pwszD
 static HRESULT WINAPI stillimagew_GetDeviceValue(IStillImageW *iface, LPWSTR pwszDeviceName, LPWSTR pValueName,
                                                  LPDWORD pType, LPBYTE pData, LPDWORD cbData)
 {
-    stillimage *This = impl_from_IStillImageW(iface);
-    FIXME("(%p, %s, %s, %p, %p, %p): stub\n", This, debugstr_w(pwszDeviceName), debugstr_w(pValueName),
-        pType, pData, cbData);
-    return E_NOTIMPL;
+    struct sti_device *devices;
+    WCHAR keyname[64], path[256];
+    HKEY class_key, key;
+    DWORD count, i, index = 0;
+    HRESULT hr;
+    LONG ret = ERROR_FILE_NOT_FOUND;
+
+    TRACE("(%p, %s, %s, %p, %p, %p)\n", iface, debugstr_w(pwszDeviceName), debugstr_w(pValueName), pType, pData, cbData);
+
+    if (!pwszDeviceName || !pValueName || !pType || !cbData) return E_INVALIDARG;
+    if (FAILED(hr = read_devices(&devices, &count))) return hr;
+    for (i = 0; i < count; i++)
+        if (!wcsicmp(devices[i].info.szDeviceInternalName, pwszDeviceName)) break;
+    free_devices(devices, count);
+    if (i == count) return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+
+    /* the value lives in the device's key (the i'th subkey of the class) */
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, imaging_class_path, 0, KEY_READ, &class_key))
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    for (; !RegEnumKeyW(class_key, index, keyname, ARRAY_SIZE(keyname)); index++)
+    {
+        if (index != i) continue;
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s", imaging_class_path, keyname);
+        if (!(ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key)))
+        {
+            ret = RegQueryValueExW(key, pValueName, NULL, pType, pData, cbData);
+            RegCloseKey(key);
+        }
+        break;
+    }
+    RegCloseKey(class_key);
+    return HRESULT_FROM_WIN32(ret);
 }
 
