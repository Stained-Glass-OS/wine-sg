From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sti, wiaservc: read-only device queries (3618)

sti, wiaservc: read-only device queries

IStillImageW::GetDeviceList, GetDeviceInfo and GetDeviceValue read the
registered imaging devices (the imaging device class key; none are registered
by default), GetSTILaunchInformation reads the /StiDevice: and /StiEvent:
values of the command line a registered launch application is started with,
GetHwNotificationState reports a registered device's notifications as on and
WriteToErrorLog writes to the event log. wiaservc's device enumerator now
behaves as an empty list (Next, Skip, Reset, Clone, GetCount) and the device
selection calls answer WIA_S_NO_DEVICE_AVAILABLE with no devices; three
todo_wine marks of its test are removed. Nothing that creates devices, changes
device state or registers event handlers is touched (the scanner path is
unchanged).

Scanner-facing: David's Ambir scanner goes through TWAIN/SANE, not these calls.
---
diff --git a/dlls/sti/sti.c b/dlls/sti/sti.c
index e079b9f..5816c8a 100644
--- a/dlls/sti/sti.c
+++ b/dlls/sti/sti.c
@@ -48,6 +48,130 @@ static inline stillimage *impl_from_IStillImageW(IStillImageW *iface)
     return CONTAINING_RECORD(iface, stillimage, IStillImageW_iface);
 }
 
+/* The registered still image devices: the subkeys of the imaging device class. */
+static const WCHAR imaging_class_path[] =
+    L"SYSTEM\\CurrentControlSet\\Control\\Class\\{6bdd1fc6-810f-11d0-bec7-08002be2092f}";
+
+static WCHAR *query_string(HKEY key, const WCHAR *name)
+{
+    DWORD type, len = 0;
+    WCHAR *str;
+
+    if (RegQueryValueExW(key, name, NULL, &type, NULL, &len) || type != REG_SZ) return NULL;
+    if (!(str = calloc(1, len + sizeof(WCHAR)))) return NULL;
+    if (RegQueryValueExW(key, name, NULL, NULL, (BYTE *)str, &len))
+    {
+        free(str);
+        return NULL;
+    }
+    return str;
+}
+
+static DWORD query_dword(HKEY key, const WCHAR *name)
+{
+    DWORD type, value, len = sizeof(value);
+
+    if (RegQueryValueExW(key, name, NULL, &type, (BYTE *)&value, &len) || type != REG_DWORD) return 0;
+    return value;
+}
+
+struct sti_device
+{
+    STI_DEVICE_INFORMATIONW info;
+    WCHAR *strings[5]; /* vendor, description, port, property provider, local name */
+};
+
+static const WCHAR *const device_value_names[5] =
+    { L"Vendor", L"DriverDesc", L"PortName", L"PropertyProvider", L"FriendlyName" };
+
+static void free_devices(struct sti_device *devices, DWORD count)
+{
+    DWORD i, j;
+
+    for (i = 0; i < count; i++)
+        for (j = 0; j < 5; j++) free(devices[i].strings[j]);
+    free(devices);
+}
+
+/* A buffer for the application: the structures in a row, then their strings; LocalFree frees it. */
+static HRESULT pack_devices(const struct sti_device *devices, DWORD count, void **buffer)
+{
+    SIZE_T size = count * sizeof(STI_DEVICE_INFORMATIONW);
+    STI_DEVICE_INFORMATIONW *out;
+    WCHAR *text;
+    DWORD i, j;
+
+    for (i = 0; i < count; i++)
+        for (j = 0; j < 5; j++)
+            if (devices[i].strings[j]) size += (wcslen(devices[i].strings[j]) + 1) * sizeof(WCHAR);
+    if (!(out = LocalAlloc(LPTR, size))) return E_OUTOFMEMORY;
+    text = (WCHAR *)(out + count);
+    for (i = 0; i < count; i++)
+    {
+        LPWSTR *fields[5] = { &out[i].pszVendorDescription, &out[i].pszDeviceDescription, &out[i].pszPortName,
+                              &out[i].pszPropProvider, &out[i].pszLocalName };
+
+        out[i] = devices[i].info;
+        for (j = 0; j < 5; j++)
+        {
+            if (!devices[i].strings[j]) continue;
+            wcscpy(text, devices[i].strings[j]);
+            *fields[j] = text;
+            text += wcslen(text) + 1;
+        }
+    }
+    *buffer = out;
+    return S_OK;
+}
+
+static HRESULT read_devices(struct sti_device **devices, DWORD *count)
+{
+    HKEY class_key;
+    WCHAR keyname[64];
+    DWORD index = 0, n = 0, i;
+    LONG ret;
+
+    *devices = NULL;
+    *count = 0;
+    if ((ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, imaging_class_path, 0, KEY_READ, &class_key)))
+        return ret == ERROR_FILE_NOT_FOUND ? S_OK : HRESULT_FROM_WIN32(ret);
+
+    while (!RegEnumKeyW(class_key, index++, keyname, ARRAY_SIZE(keyname)))
+    {
+        struct sti_device *dev, *grown;
+        WCHAR *id;
+        HKEY key;
+
+        if (RegOpenKeyExW(class_key, keyname, 0, KEY_READ, &key)) continue;
+        if (!(grown = realloc(*devices, (n + 1) * sizeof(**devices))))
+        {
+            RegCloseKey(key);
+            free_devices(*devices, n);
+            RegCloseKey(class_key);
+            *devices = NULL;
+            return E_OUTOFMEMORY;
+        }
+        *devices = grown;
+        dev = &grown[n++];
+        memset(dev, 0, sizeof(*dev));
+        dev->info.dwSize = sizeof(dev->info);
+        dev->info.DeviceType = query_dword(key, L"DeviceType");
+        dev->info.DeviceCapabilities.dwGeneric = query_dword(key, L"Capabilities");
+        dev->info.dwHardwareConfiguration = query_dword(key, L"HardwareConfig");
+        if ((id = query_string(key, L"DeviceID")))
+        {
+            lstrcpynW(dev->info.szDeviceInternalName, id, ARRAY_SIZE(dev->info.szDeviceInternalName));
+            free(id);
+        }
+        else lstrcpynW(dev->info.szDeviceInternalName, keyname, ARRAY_SIZE(dev->info.szDeviceInternalName));
+        for (i = 0; i < 5; i++) dev->strings[i] = query_string(key, device_value_names[i]);
+        RegCloseKey(key);
+    }
+    RegCloseKey(class_key);
+    *count = n;
+    return S_OK;
+}
+
 static HRESULT WINAPI stillimagew_QueryInterface(IStillImageW *iface, REFIID riid, void **ppvObject)
 {
     stillimage *This = impl_from_IStillImageW(iface);
@@ -77,17 +201,54 @@ static HRESULT WINAPI stillimagew_Initialize(IStillImageW *iface, HINSTANCE hins
 static HRESULT WINAPI stillimagew_GetDeviceList(IStillImageW *iface, DWORD dwType, DWORD dwFlags,
                                                 DWORD *pdwItemsReturned, LPVOID *ppBuffer)
 {
-    stillimage *This = impl_from_IStillImageW(iface);
-    FIXME("(%p, %lu, 0x%lX, %p, %p): stub\n", This, dwType, dwFlags, pdwItemsReturned, ppBuffer);
-    return E_NOTIMPL;
+    struct sti_device *devices, *match;
+    DWORD count, n = 0, i;
+    HRESULT hr;
+
+    TRACE("(%p, %lu, 0x%lX, %p, %p)\n", iface, dwType, dwFlags, pdwItemsReturned, ppBuffer);
+
+    if (!pdwItemsReturned || !ppBuffer) return E_INVALIDARG;
+    *pdwItemsReturned = 0;
+    *ppBuffer = NULL;
+    if (FAILED(hr = read_devices(&devices, &count))) return hr;
+    if (!count) return S_OK;
+
+    /* keep the devices of the major type asked for (0: all of them) */
+    if (!(match = malloc(count * sizeof(*match))))
+    {
+        free_devices(devices, count);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+#ifdef SG_MUTANT_STI_FILTER
+        match[n++] = devices[i];
+#else
+        if (!dwType || GET_STIDEVICE_TYPE(devices[i].info.DeviceType) == dwType) match[n++] = devices[i];
+#endif
+    hr = n ? pack_devices(match, n, ppBuffer) : S_OK;
+    if (SUCCEEDED(hr)) *pdwItemsReturned = n;
+    free(match);
+    free_devices(devices, count);
+    return hr;
 }
 
 static HRESULT WINAPI stillimagew_GetDeviceInfo(IStillImageW *iface, LPWSTR pwszDeviceName,
                                                 LPVOID *ppBuffer)
 {
-    stillimage *This = impl_from_IStillImageW(iface);
-    FIXME("(%p, %s, %p): stub\n", This, debugstr_w(pwszDeviceName), ppBuffer);
-    return E_NOTIMPL;
+    struct sti_device *devices;
+    DWORD count, i;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %p)\n", iface, debugstr_w(pwszDeviceName), ppBuffer);
+
+    if (!pwszDeviceName || !ppBuffer) return E_INVALIDARG;
+    *ppBuffer = NULL;
+    if (FAILED(hr = read_devices(&devices, &count))) return hr;
+    for (i = 0; i < count; i++)
+        if (!wcsicmp(devices[i].info.szDeviceInternalName, pwszDeviceName)) break;
+    hr = i < count ? pack_devices(&devices[i], 1, ppBuffer) : HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    free_devices(devices, count);
+    return hr;
 }
 
