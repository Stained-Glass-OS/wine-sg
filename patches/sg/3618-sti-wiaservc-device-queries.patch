+    const WCHAR *cmd = GetCommandLineW(), *p;
+    static const WCHAR device_opt[] = L"/StiDevice:", event_opt[] = L"/StiEvent:";
+    BOOL found = FALSE;
+
+    TRACE("(%p, %p, %p, %p)\n", iface, pwszDeviceName, pdwEventCode, pwszEventName);
+
+    if (!pwszDeviceName || !pdwEventCode || !pwszEventName) return E_INVALIDARG;
+
+    /* an application registered for launching is started with the device and the event on its command line */
+    pwszDeviceName[0] = pwszEventName[0] = 0;
+    *pdwEventCode = 0;
+    if ((p = wcsstr(cmd, device_opt)))
+    {
+        size_t len = wcscspn(p += ARRAY_SIZE(device_opt) - 1, L" \t");
+        lstrcpynW(pwszDeviceName, p, min(len + 1, STI_MAX_INTERNAL_NAME_LENGTH));
+        found = TRUE;
+    }
+#ifdef SG_MUTANT_STI_LAUNCH
+    if (0)
+#else
+    if ((p = wcsstr(cmd, event_opt)))
+#endif
+    {
+        size_t len = wcscspn(p += ARRAY_SIZE(event_opt) - 1, L" \t");
+        lstrcpynW(pwszEventName, p, min(len + 1, 39));
+        *pdwEventCode = 1;
+        found = TRUE;
+    }
+    return found ? S_OK : HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
 }
 
