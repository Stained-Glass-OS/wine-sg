             render_mesh_builder(r, world, builder);
         IDirect3DRMMeshBuilder3_Release(builder);
     }
+    else if (SUCCEEDED(d3drm_progressive_mesh_get_builder((IUnknown *)visual, &builder)))
+    {
+        render_mesh_builder(r, world, builder);
+        IDirect3DRMMeshBuilder3_Release(builder);
+    }
     else if (SUCCEEDED(IDirect3DRMVisual_QueryInterface(visual, &IID_IDirect3DRMMesh, (void **)&mesh)))
     {
         render_mesh(r, world, mesh);
diff --git a/dlls/d3drm/tests/d3drm.c b/dlls/d3drm/tests/d3drm.c
index d01a47e..019d35e 100644
--- a/dlls/d3drm/tests/d3drm.c
+++ b/dlls/d3drm/tests/d3drm.c
@@ -8740,6 +8740,94 @@ static void test_sg_gap2_visuals(void)
     }
     IDirect3DRMProgressiveMesh_Release(pmesh);
 
+    /* detail: a flat 4x4 grid (32 triangles) loses faces by edge collapse */
+    {
+        IDirect3DRMMeshBuilder3 *grid;
+        IDirect3DRMMesh *rmesh;
+        D3DVECTOR gv[25], gn;
+        DWORD fd[32 * 7 + 1], p = 0, x, y, fdsize, face;
+        unsigned int nv, nf, vpf;
+        char path[MAX_PATH];
+        D3DRMBOX box;
+        float detail;
+
+        for (y = 0; y < 5; ++y)
+            for (x = 0; x < 5; ++x)
+            {
+                gv[y * 5 + x].x = x;
+                gv[y * 5 + x].y = y;
+                gv[y * 5 + x].z = 0.0f;
+            }
+        gn.x = gn.y = 0.0f; gn.z = 1.0f;
+        for (y = 0; y < 4; ++y)
+            for (x = 0; x < 4; ++x)
+            {
+                DWORD a = y * 5 + x, b = a + 1, c = a + 5, d = c + 1, tri[2][3] = {{a, b, d}, {a, d, c}}, t2, k;
+
+                for (t2 = 0; t2 < 2; ++t2)
+                {
+                    fd[p++] = 3;
+                    for (k = 0; k < 3; ++k)
+                    {
+                        fd[p++] = tri[t2][k];
+                        fd[p++] = 0;
+                    }
+                }
+            }
+        fd[p] = 0;
+        IDirect3DRM3_CreateMeshBuilder(d3drm3, &grid);
+        hr = IDirect3DRMMeshBuilder3_AddFaces(grid, 25, gv, 1, &gn, fd, NULL);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        GetTempPathA(sizeof(path), path);
+        strcat(path, "sg_gap2_pmesh.x");
+        hr = IDirect3DRMMeshBuilder3_Save(grid, path, D3DRMXOF_TEXT, D3DRMXOFSAVE_ALL);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMMeshBuilder3_Release(grid);
+
+        hr = IDirect3DRM3_CreateProgressiveMesh(d3drm3, &pmesh);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        hr = IDirect3DRMProgressiveMesh_Load(pmesh, path, NULL, D3DRMLOAD_FROMFILE, NULL, NULL);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        DeleteFileA(path);
+        hr = IDirect3DRMProgressiveMesh_GetFaceDetail(pmesh, &face);
+        ok(hr == D3DRM_OK && face == 32, "Got hr %#lx, %lu faces.\n", hr, face);
+        hr = IDirect3DRMProgressiveMesh_CreateMesh(pmesh, &rmesh);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMMesh_GetGroup(rmesh, 0, &nv, &nf, &vpf, &fdsize, NULL);
+        ok(nf == 32, "Got %u faces at full detail.\n", nf);
+        IDirect3DRMMesh_Release(rmesh);
+
+        hr = IDirect3DRMProgressiveMesh_SetDetail(pmesh, 0.5f);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        hr = IDirect3DRMProgressiveMesh_CreateMesh(pmesh, &rmesh);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMMesh_GetGroup(rmesh, 0, &nv, &nf, &vpf, &fdsize, NULL);
+        ok(nf <= 16 && nf >= 8, "Got %u faces at half detail.\n", nf);
+        ok(nv < 25, "Got %u vertices at half detail.\n", nv);
+        IDirect3DRMMesh_Release(rmesh);
+        hr = IDirect3DRMProgressiveMesh_GetBox(pmesh, &box);
+        ok(hr == D3DRM_OK && box.max.x == 4.0f, "Got hr %#lx.\n", hr);
+
+        hr = IDirect3DRMProgressiveMesh_SetFaceDetail(pmesh, 4);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMProgressiveMesh_GetDetail(pmesh, &detail);
+        ok(compare_float(detail, 0.125f, 2), "Got detail %f.\n", detail);
+        hr = IDirect3DRMProgressiveMesh_CreateMesh(pmesh, &rmesh);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMMesh_GetGroup(rmesh, 0, &nv, &nf, &vpf, &fdsize, NULL);
+        ok(nf <= 4 && nf >= 1, "Got %u faces at 4 faces.\n", nf);
+        IDirect3DRMMesh_Release(rmesh);
+
+        hr = IDirect3DRMProgressiveMesh_SetVertexDetail(pmesh, 25);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        hr = IDirect3DRMProgressiveMesh_CreateMesh(pmesh, &rmesh);
+        ok(hr == D3DRM_OK, "Got hr %#lx.\n", hr);
+        IDirect3DRMMesh_GetGroup(rmesh, 0, &nv, &nf, &vpf, &fdsize, NULL);
+        ok(nf == 32 && nv == 25, "Got %u faces, %u vertices back at full detail.\n", nf, nv);
+        IDirect3DRMMesh_Release(rmesh);
+        IDirect3DRMProgressiveMesh_Release(pmesh);
+    }
+
     IDirect3DRMLight_Release(light);
     IDirect3DRMMeshBuilder3_Release(builder);
     IDirect3DRM3_Release(d3drm3);
