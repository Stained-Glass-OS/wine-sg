@@ -1588,6 +1588,8 @@ static void d3drm_progressive_mesh_destroy(struct d3drm_progressive_mesh *pmesh)
     d3drm_object_cleanup((IDirect3DRMObject *)&pmesh->IDirect3DRMProgressiveMesh_iface, &pmesh->obj);
     if (pmesh->builder)
         IDirect3DRMMeshBuilder3_Release(pmesh->builder);
+    if (pmesh->reduced)
+        IDirect3DRMMeshBuilder3_Release(pmesh->reduced);
     IDirect3DRM_Release(pmesh->d3drm);
     free(pmesh);
 }
@@ -1681,6 +1683,9 @@ static HRESULT WINAPI d3drm_pmesh_Load(IDirect3DRMProgressiveMesh *iface, void *
     if (pmesh->builder)
         IDirect3DRMMeshBuilder3_Release(pmesh->builder);
     pmesh->builder = builder;
+    if (pmesh->reduced)
+        IDirect3DRMMeshBuilder3_Release(pmesh->reduced);
+    pmesh->reduced = NULL;
     pmesh->flags = D3DRMPMESHSTATUS_VALID | D3DRMPMESHSTATUS_BASEMESHCOMPLETE | D3DRMPMESHSTATUS_COMPLETE
             | D3DRMPMESHSTATUS_RENDERABLE;
     pmesh_signal(pmesh);
@@ -1849,9 +1854,13 @@ static HRESULT WINAPI d3drm_pmesh_RegisterEvents(IDirect3DRMProgressiveMesh *ifa
     return D3DRM_OK;
 }
 
+static HRESULT pmesh_get_reduced(struct d3drm_progressive_mesh *pmesh, IDirect3DRMMeshBuilder3 **out);
+
 static HRESULT WINAPI d3drm_pmesh_CreateMesh(IDirect3DRMProgressiveMesh *iface, IDirect3DRMMesh **mesh)
 {
     struct d3drm_progressive_mesh *pmesh = impl_from_IDirect3DRMProgressiveMesh(iface);
+    IDirect3DRMMeshBuilder3 *builder;
+    HRESULT hr;
 
     TRACE("iface %p, mesh %p.\n", iface, mesh);
 
@@ -1860,7 +1869,63 @@ static HRESULT WINAPI d3drm_pmesh_CreateMesh(IDirect3DRMProgressiveMesh *iface,
     *mesh = NULL;
     if (!pmesh->builder)
         return D3DRMERR_BADOBJECT;
-    return IDirect3DRMMeshBuilder3_CreateMesh(pmesh->builder, mesh);
+    if (FAILED(hr = pmesh_get_reduced(pmesh, &builder)))
+        return hr;
+    hr = IDirect3DRMMeshBuilder3_CreateMesh(builder, mesh);
+    IDirect3DRMMeshBuilder3_Release(builder);
+    return hr;
+}
+
+/* The mesh at the current detail: edges are collapsed (shortest first) until the face count is
+ * ceil(faces * detail); the result is kept until the detail changes. */
+static HRESULT pmesh_get_reduced(struct d3drm_progressive_mesh *pmesh, IDirect3DRMMeshBuilder3 **out)
+{
+    IDirect3DRMMeshBuilder3 *clone;
+    DWORD faces, vertices;
+    HRESULT hr;
+
+    if (pmesh->reduced && pmesh->reduced_detail == pmesh->detail)
+    {
+        *out = pmesh->reduced;
+        IDirect3DRMMeshBuilder3_AddRef(*out);
+        return D3DRM_OK;
+    }
+    if (FAILED(hr = IDirect3DRMMeshBuilder3_Clone(pmesh->builder, NULL, &IID_IDirect3DRMMeshBuilder3,
+            (void **)&clone)))
+        return hr;
+    if (pmesh->detail < 1.0f)
+    {
+        faces = ceilf(pmesh_face_count(pmesh) * pmesh->detail);
+        vertices = ceilf(pmesh_vertex_count(pmesh) * pmesh->detail);
+        if (FAILED(hr = d3drm_mesh_builder_simplify(clone, faces, vertices)))
+        {
+            IDirect3DRMMeshBuilder3_Release(clone);
+            return hr;
+        }
+    }
+    if (pmesh->reduced)
+        IDirect3DRMMeshBuilder3_Release(pmesh->reduced);
+    pmesh->reduced = clone;
+    pmesh->reduced_detail = pmesh->detail;
+    *out = clone;
+    IDirect3DRMMeshBuilder3_AddRef(clone);
+    return D3DRM_OK;
+}
+
+/* For the renderer: the builder to draw for a visual that is a progressive mesh. */
+HRESULT d3drm_progressive_mesh_get_builder(IUnknown *visual, IDirect3DRMMeshBuilder3 **builder)
+{
+    IDirect3DRMProgressiveMesh *iface;
+    HRESULT hr;
+
+    if (FAILED(IUnknown_QueryInterface(visual, &IID_IDirect3DRMProgressiveMesh, (void **)&iface)))
+        return E_NOINTERFACE;
+    if (!impl_from_IDirect3DRMProgressiveMesh(iface)->builder)
+        hr = D3DRMERR_BADOBJECT;
+    else
+        hr = pmesh_get_reduced(impl_from_IDirect3DRMProgressiveMesh(iface), builder);
+    IDirect3DRMProgressiveMesh_Release(iface);
+    return hr;
 }
 
 static HRESULT WINAPI d3drm_pmesh_Duplicate(IDirect3DRMProgressiveMesh *iface, IDirect3DRMProgressiveMesh **out)
@@ -1910,6 +1975,9 @@ static HRESULT WINAPI d3drm_pmesh_SetQuality(IDirect3DRMProgressiveMesh *iface,
 
     if (!pmesh->builder)
         return D3DRMERR_BADOBJECT;
+    if (pmesh->reduced)
+        IDirect3DRMMeshBuilder3_Release(pmesh->reduced);
+    pmesh->reduced = NULL;
     return IDirect3DRMMeshBuilder3_SetQuality(pmesh->builder, quality);
 }
 
