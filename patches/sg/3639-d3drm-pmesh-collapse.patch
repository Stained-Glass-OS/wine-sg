diff --git a/dlls/d3drm/meshbuilder.c b/dlls/d3drm/meshbuilder.c
index f59e363..ab97706 100644
--- a/dlls/d3drm/meshbuilder.c
+++ b/dlls/d3drm/meshbuilder.c
@@ -19,6 +19,7 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <float.h>
 #include "d3drm_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(d3drm);
@@ -3145,6 +3146,109 @@ static HRESULT mesh_builder_optimize(struct d3drm_mesh_builder *mb)
     return D3DRM_OK;
 }
 
+/* Progressive mesh detail: collapses the shortest edge (its far end moves onto the near end, which goes to the
+ * middle) until at most max_faces faces or max_vertices used vertices are left, dropping the faces that become
+ * degenerate.  At least one face is kept. */
+HRESULT d3drm_mesh_builder_simplify(IDirect3DRMMeshBuilder3 *iface, DWORD max_faces, DWORD max_vertices)
+{
+    struct d3drm_mesh_builder *mb = impl_from_IDirect3DRMMeshBuilder3(iface);
+
+#ifdef SG_MUTANT_DRM_PMESH
+    max_faces = mb->nb_faces;
+#endif
+    if (max_faces < 1)
+        max_faces = 1;
+    while (mb->nb_faces > max_faces)
+    {
+        DWORD *ptr, n, i, j, a = 0, b = 0, used = 0, *w, *rd, keep, kept_total;
+        float best = FLT_MAX;
+        BOOL found = FALSE;
+        BYTE *seen;
+
+        if (!(seen = calloc(mb->nb_vertices ? mb->nb_vertices : 1, 1)))
+            return E_OUTOFMEMORY;
+        for (ptr = mb->pFaceData, i = 0; i < mb->nb_faces; ++i, ptr += 1 + n * 2)
+        {
+            n = *ptr;
+            for (j = 0; j < n; ++j)
+            {
+                DWORD v0 = ptr[1 + j * 2], v1 = ptr[1 + ((j + 1) % n) * 2];
+                float dx, dy, dz, len;
+
+                if (v0 >= mb->nb_vertices || v1 >= mb->nb_vertices)
+                    continue;
+                if (!seen[v0]) { seen[v0] = 1; ++used; }
+                if (v0 == v1)
+                    continue;
+                dx = mb->vertices[v0].x - mb->vertices[v1].x;
+                dy = mb->vertices[v0].y - mb->vertices[v1].y;
+                dz = mb->vertices[v0].z - mb->vertices[v1].z;
+                len = dx * dx + dy * dy + dz * dz;
+                if (len < best)
+                {
+                    best = len;
+                    a = v0;
+                    b = v1;
+                    found = TRUE;
+                }
+            }
+        }
+        free(seen);
+        if (!found || used <= max_vertices)
+            break;
+
+        mb->vertices[a].x = (mb->vertices[a].x + mb->vertices[b].x) * 0.5f;
+        mb->vertices[a].y = (mb->vertices[a].y + mb->vertices[b].y) * 0.5f;
+        mb->vertices[a].z = (mb->vertices[a].z + mb->vertices[b].z) * 0.5f;
+
+        /* b becomes a; repeated corners go; faces left with fewer than 3 corners go */
+        rd = w = mb->pFaceData;
+        kept_total = 0;
+        keep = 0;
+        for (i = 0; i < mb->nb_faces; ++i)
+        {
+            DWORD *out = w + 1, m = 0, count = *rd;
+
+            for (j = 0; j < count; ++j)
+            {
+                DWORD v = rd[1 + j * 2], nm = rd[2 + j * 2];
+
+                if (v == b)
+                    v = a;
+                if (m && out[-2] == v)
+                    continue;
+                *out++ = v;
+                *out++ = nm;
+                ++m;
+            }
+            if (m > 1 && out[-2] == w[1])
+            {
+                out -= 2;
+                --m;
+            }
+            rd += 1 + count * 2;
+            if (m < 3)
+            {
+                if (mb->material_indices)
+                    mb->material_indices[i] = ~0u;
+                continue;
+            }
+            *w = m;
+            w = out;
+            if (mb->material_indices)
+                mb->material_indices[keep] = mb->material_indices[i];
+            ++keep;
+        }
+        if (!keep)
+            break;
+        *w++ = 0;
+        kept_total = w - (DWORD *)mb->pFaceData;
+        mb->nb_faces = keep;
+        mb->face_data_size = kept_total;
+    }
+    return mesh_builder_optimize(mb);
+}
+
 /* AddFacesIndexed: faces of vertex (and normal) indices of the builder itself, ended by a face of 0 vertices. */
 static HRESULT mesh_builder_add_faces_indexed(struct d3drm_mesh_builder *mb, DWORD flags, const DWORD *indices,
         DWORD *first, DWORD *count)
