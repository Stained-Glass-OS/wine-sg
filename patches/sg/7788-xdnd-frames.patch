From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: the virtual desktop and a Linux program's frame are no XDND targets, as a window manager's frames are not

An XDND source looks for the first XdndAware window from the root down.
The desktop's X window, which holds every Wine window and every Linux
program framed in one (sg_embed.c), was XdndAware, and so was each frame:
every drag a Linux program made over its own window was offered to Wine.
A clip dragged onto Kdenlive's timeline went nowhere (David 2026-11-15),
and nothing could be dragged from one Linux program to another.

Like a window manager's frame, the desktop window and a frame holding a
Linux program are no longer XdndAware: a source finds the program's own
window, and Qt sees a drag within its own window as its own. Wine's
windows keep theirs. Drops on the desktop's own picture (its icons) still
reach Wine through an XdndAware InputOnly window, the lowest of the
desktop's children: it covers only what no window covers, selects no
events (the pointer's go on to the desktop window), and carries the
desktop's context and the Wine window mark.
---
diff --git a/dlls/winex11.drv/sg_dragsrc.c b/dlls/winex11.drv/sg_dragsrc.c
index 5fca9a3..367ff3b 100644
--- a/dlls/winex11.drv/sg_dragsrc.c
+++ b/dlls/winex11.drv/sg_dragsrc.c
@@ -52,6 +52,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
+#include <unistd.h>
 #include <X11/Xlib.h>
 #include <X11/Xutil.h>
 #include <X11/Xatom.h>
@@ -511,6 +512,49 @@ static void free_drag( Display *display, struct sg_drag *d )
     free( d );
 }
 
+/***********************************************************************
+ * The virtual desktop as an XDND target, the way a window manager's frames are
+ * (wine-sg 7788)
+ *
+ * An XDND source looks for the first XdndAware window from the root down.
+ * The desktop's X window held every Wine window and every Linux program's
+ * window framed in one (sg_embed.c), and was XdndAware itself: every drag a
+ * Linux program made over its own framed window was offered to Wine -- a clip
+ * dragged onto Kdenlive's timeline went nowhere (David 2026-11-15). Like a
+ * window manager's frame, the desktop window and a frame holding a Linux
+ * program now are not XdndAware; a source finds the program's own window
+ * (and Qt sees a drag inside its own window as its own). Wine's windows keep
+ * theirs, and drops on the desktop's own picture (its icons) still reach
+ * Wine through an XdndAware InputOnly window lowest of the desktop's
+ * children: it covers only what no window covers, takes no input (the
+ * pointer's events go on to the desktop window) and is the desktop's for
+ * the drop's messages; Wine finds the drop target by the point anyway.
+ */
+void sg_desktop_dnd_init( Display *display, Window desktop, HWND hwnd )
+{
+    unsigned long version = WINE_XDND_VERSION;
+    long pid = getpid();
+    XSetWindowAttributes attr;
+    Window win;
+
+    if (desktop == DefaultRootWindow( display )) return;
+    attr.do_not_propagate_mask = 0;
+    attr.event_mask = 0;
+    win = XCreateWindow( display, desktop, 0, 0, 16384, 16384, 0, 0, InputOnly, CopyFromParent,
+                         CWEventMask | CWDontPropagate, &attr );
+    if (!win) return;
+    XStoreName( display, win, "Wine desktop drop target" );
+    XChangeProperty( display, win, x11drv_atom(XdndAware), XA_ATOM, 32, PropModeReplace,
+                     (unsigned char *)&version, 1 );
+    XChangeProperty( display, win, sg_wine_window_atom( display ), XA_CARDINAL, 32, PropModeReplace,
+                     (unsigned char *)&pid, 1 );
+    XSaveContext( display, win, winContext, (char *)hwnd );
+    XMapWindow( display, win );
+    XLowerWindow( display, win );
+    XDeleteProperty( display, desktop, x11drv_atom(XdndAware) );
+    TRACE( "desktop %lx drop target %lx\n", desktop, win );
+}
+
 INT sg_drag_escape( const void *in, INT in_count, void *out, INT out_count )
 {
     const struct sg_drag_escape *esc = in;
diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
index 96b872c..5a525b4 100644
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -580,6 +580,11 @@ LRESULT sg_embed_attach( HWND hwnd, Window child )
     XSelectInput( data->display, child, StructureNotifyMask | PropertyChangeMask );
 #endif
     XReparentWindow( data->display, child, data->whole_window, x, y );
+#ifndef SG_MUTANT_DND_FRAME_AWARE
+    /* a frame is no XDND target, as a window manager's is not: a drag over the
+     * program's window is offered to the program (wine-sg 7788, sg_dragsrc.c) */
+    XDeleteProperty( data->display, data->whole_window, x11drv_atom(XdndAware) );
+#endif
     /* full screen already: kept at its size -- sized to the frame first, an
      * SFML game took that for a new video mode and began again */
 #ifdef SG_MUTANT_EMBED_PRE_FULLSCREEN_RESIZED
@@ -1468,5 +1473,8 @@ void sg_embed_destroy( HWND hwnd )
     XSelectInput( copy.display, copy.child, 0 );
     XReparentWindow( copy.display, copy.child, DefaultRootWindow( copy.display ), x, y );
     XRemoveFromSaveSet( copy.display, copy.child );
+    if (copy.frame)  /* a Wine window again: a drop target (wine-sg 7788) */
+        XChangeProperty( copy.display, copy.frame, x11drv_atom(XdndAware), XA_ATOM, 32, PropModeReplace,
+                         (unsigned char *)&(Atom){WINE_XDND_VERSION}, 1 );
     X11DRV_check_error();
 }
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 11ec857..b6e6a56 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2795,6 +2795,9 @@ static BOOL create_desktop_win_data( Window win, HWND hwnd )
     data->managed = TRUE;
     NtUserSetProp( data->hwnd, whole_window_prop, (HANDLE)win );
     set_initial_wm_hints( display, win );
+#ifndef SG_MUTANT_DND_DESKTOP_AWARE
+    sg_desktop_dnd_init( display, win, hwnd );  /* Stained Glass OS (wine-sg 7788) */
+#endif
     release_win_data( data );
     if (thread_data->clip_window) XReparentWindow( display, thread_data->clip_window, win, 0, 0 );
     return TRUE;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 7fd6cec..b30cf76 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -303,6 +303,7 @@ extern BOOL sg_drag_export( Display *display, Window win, Atom prop, Atom target
                             void *data, size_t size );
 extern char *sg_drag_unix_file_name( const WCHAR *dos );
 extern Atom sg_wine_window_atom( Display *display );
+extern void sg_desktop_dnd_init( Display *display, Window desktop, HWND hwnd );
 extern struct format_entry *import_xdnd_selection( Display *display, Window win, Atom selection,
                                                    Atom *targets, UINT count,
                                                    size_t *size );
