Subject: [PATCH] hhctrl: HtmlHelp keyword lookup, window handle, initialize
 and safe display (3010)

HH_KEYWORD_LOOKUP and HH_ALINK_LOOKUP (HH_ALINK) open the topic of the first
keyword found in the help file's index; a keyword with several topics shows the
topic list. When nothing matches, fIndexOnFail opens the Index tab and
pszMsgText is shown otherwise. The ANSI entry point converts the structure.
HH_DISPLAY_INDEX with a keyword selects it in the index list. HH_INITIALIZE
hands back a cookie, HH_UNINITIALIZE succeeds, HH_GET_WIN_HANDLE returns the
help window with the given name, and HH_SAFE_DISPLAY_TOPIC is treated as
HH_DISPLAY_TOPIC.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/hhctrl.ocx/help.c b/dlls/hhctrl.ocx/help.c
index 98ac768..5c360e7 100644
--- a/dlls/hhctrl.ocx/help.c
+++ b/dlls/hhctrl.ocx/help.c
@@ -674,6 +674,48 @@ static LRESULT OnTopicChange(HHInfo *info, void *user_data)
     return 0;
 }
 
+static IndexItem *find_index_keyword(HHInfo *info, const WCHAR *keyword)
+{
+    IndexItem *item;
+
+    if (!info->index) return NULL;
+    for (item = info->index->next; item; item = item->next)
+        if (item->keyword && !wcsicmp(item->keyword, keyword)) return item;
+    return NULL;
+}
+
+/* Opens the topic of an index keyword; a keyword with several topics shows the topic list. */
+BOOL JumpToIndexKeyword(HHInfo *info, const WCHAR *keyword)
+{
+    DWORD tab = info->current_tab;
+    IndexItem *item = find_index_keyword(info, keyword);
+
+    if (!item || !item->nItems) return FALSE;
+
+    info->current_tab = TAB_INDEX;
+    OnTopicChange(info, item);
+    info->current_tab = tab;
+    return TRUE;
+}
+
+/* Selects a keyword in the index list. */
+BOOL SelectIndexKeyword(HHInfo *info, const WCHAR *keyword)
+{
+    IndexItem *item = find_index_keyword(info, keyword);
+    HWND list = info->tabs[TAB_INDEX].hwnd;
+    LVITEMW lvi = { 0 };
+    int pos;
+
+    if (!item || !list) return FALSE;
+
+    pos = (int)(INT_PTR)item->id;
+    lvi.stateMask = LVIS_SELECTED | LVIS_FOCUSED;
+    lvi.state = LVIS_SELECTED | LVIS_FOCUSED;
+    SendMessageW(list, LVM_SETITEMSTATE, pos, (LPARAM)&lvi);
+    SendMessageW(list, LVM_ENSUREVISIBLE, pos, FALSE);
+    return TRUE;
+}
+
 /* Capture the Enter/Return key and send it up to Child_WndProc as an NM_RETURN message */
 static LRESULT CALLBACK EditChild_WndProc(HWND hWnd, UINT message, WPARAM wParam, LPARAM lParam)
 {
