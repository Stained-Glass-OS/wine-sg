+        return 0;
+    }
+    case HH_UNINITIALIZE:
+        return 0;
+    case HH_GET_WIN_HANDLE: {
+        HHInfo *info;
+
+        if (!data || !(info = find_window((const WCHAR *)data)))
+            return NULL;
         return info->WinType.hwndHelp;
     }
+    case HH_KEYWORD_LOOKUP:
+    case HH_ALINK_LOOKUP: {
+        const HH_ALINKW *link = (const HH_ALINKW *)data;
+        WCHAR *window = NULL, *keywords, *kw, *ctx = NULL;
+        BOOL found = FALSE;
+        HHInfo *info;
+
+        if (!filename || !link || link->cbStruct < sizeof(*link) || !link->pszKeywords)
+            return NULL;
+
+        if (!resolve_filename(filename, fullname, MAX_PATH, NULL, &window))
+        {
+            WARN("can't find %s\n", debugstr_w(filename));
+            return NULL;
+        }
+
+        info = window ? find_window(window) : NULL;
+        info = CreateHelpViewer(info, fullname, caller);
+        if (!info)
+        {
+            free(window);
+            return NULL;
+        }
+        if (!info->WinType.pszType)
+            info->WinType.pszType = info->stringsW.pszType = window;
+        else
+            free(window);
+
+        if ((keywords = wcsdup(link->pszKeywords)))
+        {
+            for (kw = wcstok(keywords, L";", &ctx); kw && !found; kw = wcstok(NULL, L";", &ctx))
