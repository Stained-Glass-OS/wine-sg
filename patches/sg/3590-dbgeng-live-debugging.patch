+static void debug_client_remove_replacements(struct debug_client *debug_client)
+{
+    unsigned int i;
+
+    for (i = 0; i < debug_client->replacement_count; ++i)
+    {
+        free(debug_client->replacements[i].src);
+        free(debug_client->replacements[i].dst);
+    }
+    free(debug_client->replacements);
+    debug_client->replacements = NULL;
+    debug_client->replacement_count = 0;
+}
+
+static HRESULT debug_client_set_replacement(struct debug_client *debug_client, const char *src, const char *dst)
+{
+    unsigned int i;
+    char *copy;
+
+    if (!src || !*src)
+        return E_INVALIDARG;
+    for (i = 0; i < debug_client->replacement_count; ++i)
+        if (!strcmp(debug_client->replacements[i].src, src))
+            break;
+    if (!dst)
+    {
+        if (i == debug_client->replacement_count)
+            return S_OK;
+        free(debug_client->replacements[i].src);
+        free(debug_client->replacements[i].dst);
+        memmove(&debug_client->replacements[i], &debug_client->replacements[i + 1],
+                (--debug_client->replacement_count - i) * sizeof(*debug_client->replacements));
+        return S_OK;
+    }
+    if (!(copy = strdup(dst)))
+        return E_OUTOFMEMORY;
+    if (i < debug_client->replacement_count)
+    {
+        free(debug_client->replacements[i].dst);
+        debug_client->replacements[i].dst = copy;
+        return S_OK;
+    }
+    {
+        struct text_replacement *tmp = realloc(debug_client->replacements, (i + 1) * sizeof(*tmp));
+
+        if (!tmp || !(tmp[i].src = strdup(src)))
+        {
+            free(copy);
+            return E_OUTOFMEMORY;
+        }
+        tmp[i].dst = copy;
+        debug_client->replacements = tmp;
+        debug_client->replacement_count = i + 1;
+    }
+    return S_OK;
+}
