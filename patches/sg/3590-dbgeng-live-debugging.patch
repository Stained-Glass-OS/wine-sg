+/* ---- command interpreter ---- */
+static void debug_printf(struct debug_client *debug_client, ULONG mask, const char *format, ...)
+{
+    va_list args;
+    char *text;
+
+    va_start(args, format);
+    text = debug_vformat(format, args);
+    va_end(args);
+    if (text)
+        debug_client_output(debug_client, mask, text);
+    free(text);
+}
+
+static char *debug_skip_blanks(char *s)
+{
+    while (*s == ' ' || *s == '\t')
+        ++s;
+    return s;
+}
+
+static void debug_trim_end(char *s)
+{
+    size_t len = strlen(s);
+
+    while (len && (s[len - 1] == ' ' || s[len - 1] == '\t' || s[len - 1] == '\r' || s[len - 1] == '\n'))
+        s[--len] = 0;
+}
+
+static HRESULT debug_eval_value(struct debug_client *debug_client, const char *text, ULONG64 *value)
+{
+    DEBUG_VALUE v;
+    ULONG rem = 0;
+    HRESULT hr = debug_client_evaluate(debug_client, text, DEBUG_VALUE_INT64, &v, &rem);
+
+    if (FAILED(hr))
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "Couldn't resolve error at '%s'\n", text);
+        return hr;
+    }
+    *value = v.I64;
+    return S_OK;
+}
+
+/* evaluates the first expression of the text; the rest is returned after the remainder index */
+
+static HRESULT debug_eval_prefix(struct debug_client *debug_client, const char *text, ULONG64 *value, const char **rest)
+{
+    DEBUG_VALUE v;
+    ULONG rem = 0;
+    HRESULT hr = debug_client_evaluate(debug_client, text, DEBUG_VALUE_INT64, &v, &rem);
+
+    if (FAILED(hr))
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "Couldn't resolve error at '%s'\n", text);
+        return hr;
+    }
+    *value = v.I64;
+    if (rest)
+        *rest = text + rem;
+    return S_OK;
+}
+
+static void debug_format_value64(BOOL is64, ULONG64 v, char *buffer, size_t size)
+{
+    debug_format_address(is64, v, buffer, size);
+}
+
+static HRESULT debug_cmd_registers(struct debug_client *debug_client, char *args)
+{
+    BOOL is64 = debug_client_is_64(debug_client);
+    CONTEXT ctx;
+    HRESULT hr;
+    unsigned int i;
+    ULONG64 v;
+
+    if (FAILED(hr = debug_client_get_context(debug_client, &ctx)))
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "Unable to get the thread context\n");
+        return hr;
+    }
+    args = debug_skip_blanks(args);
+    if (*args)
+    {
+        char *eq = strchr(args, '=');
+        char name[32];
+        ULONG64 value;
+
+        if (!eq)
+        {
+            char *space = args;
+
+            while (*space && *space != ' ' && *space != '\t')
+                ++space;
+            if (*space)
+            {
+                eq = space;
+                *eq = '=';
+            }
+        }
+        if (eq)
+        {
+            snprintf(name, sizeof(name), "%.*s", (int)min((size_t)(eq - args), sizeof(name) - 1), args);
+            debug_trim_end(name);
+            if (FAILED(hr = debug_eval_value(debug_client, eq + 1, &value)))
+                return hr;
+            if (!debug_ctx_set_register(&ctx, name, value))
+                return E_FAIL;
+            return debug_client_set_context(debug_client, &ctx);
+        }
+        debug_trim_end(args);
+        if (!debug_ctx_get_register(&ctx, args, &v))
+        {
+            debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "Bad register error at '%s'\n", args);
+            return E_FAIL;
+        }
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%s=%0*I64x\n", args[0] == '@' ? args + 1 : args,
+                is64 ? 16 : 8, v);
+        return S_OK;
+    }
+    for (i = 0; i < ARRAY_SIZE(ctx_general_names); ++i)
+    {
+        if (!ctx_general_names[i][0] || !debug_ctx_get_register(&ctx, ctx_general_names[i], &v))
+            continue;
+        if (!strcmp(ctx_general_names[i], "eflags"))
+            continue;
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%3s=%0*I64x%s", ctx_general_names[i], is64 ? 16 : 8, v,
+                (i % 3 == 2 || i == ARRAY_SIZE(ctx_general_names) - 1) ? "\n" : " ");
+    }
+    {
+        ULONG64 cs = 0, ss = 0, ds = 0, es = 0, fs = 0, gs = 0, efl = 0;
+
+        debug_ctx_get_register(&ctx, "cs", &cs);
+        debug_ctx_get_register(&ctx, "ss", &ss);
+        debug_ctx_get_register(&ctx, "ds", &ds);
+        debug_ctx_get_register(&ctx, "es", &es);
+        debug_ctx_get_register(&ctx, "fs", &fs);
+        debug_ctx_get_register(&ctx, "gs", &gs);
+        debug_ctx_get_register(&ctx, "eflags", &efl);
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "\ncs=%04x  ss=%04x  ds=%04x  es=%04x  fs=%04x  gs=%04x             efl=%08x\n",
+                (unsigned int)cs, (unsigned int)ss, (unsigned int)ds, (unsigned int)es, (unsigned int)fs,
+                (unsigned int)gs, (unsigned int)efl);
+    }
+    return S_OK;
+}
