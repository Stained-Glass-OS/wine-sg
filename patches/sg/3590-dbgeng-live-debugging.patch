+static void debug_client_free_engine_state(struct debug_client *debug_client)
+{
+    struct dbg_breakpoint *bp, *bp2;
+    struct dbg_extension *ext, *ext2;
+    struct sym_match *match, *match2;
+    unsigned int i;
+
+    debug_client_close_log(debug_client);
+    for (i = 0; i < ARRAY_SIZE(debug_client->text_macros); ++i)
+        free(debug_client->text_macros[i]);
+    debug_client_remove_replacements(debug_client);
+    debug_client_free_filters(debug_client);
+    free(debug_client->pending_input);
+    free(debug_client->client_context);
+    LIST_FOR_EACH_ENTRY_SAFE(bp, bp2, &debug_client->breakpoints, struct dbg_breakpoint, entry)
+        debug_client_free_breakpoint(bp);
+    LIST_FOR_EACH_ENTRY_SAFE(ext, ext2, &debug_client->extensions, struct dbg_extension, entry)
+    {
+        void (WINAPI *uninit)(void);
+
+        if ((uninit = (void *)GetProcAddress(ext->module, "DebugExtensionUninitialize")))
+            uninit();
+        list_remove(&ext->entry);
+        FreeLibrary(ext->module);
+        free(ext->path);
+        free(ext);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(match, match2, &debug_client->matches, struct sym_match, entry)
+    {
+        list_remove(&match->entry);
+        sym_collect_free(&match->c);
+        free(match);
+    }
+    while (debug_client->prefixes)
+    {
+        struct output_prefix *prefix = debug_client->prefixes;
+
+        debug_client->prefixes = prefix->next;
+        free(prefix->saved);
+        free(prefix);
+    }
+    for (i = 0; i < debug_client->source_name_count; ++i)
+        free(debug_client->source_names[i]);
+    free(debug_client->source_names);
+}
