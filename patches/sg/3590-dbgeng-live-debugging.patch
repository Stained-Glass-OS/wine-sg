+static HRESULT debug_cmd_edit(struct debug_client *debug_client, const char *cmd, char *args)
+{
+    struct target_process *target = debug_client_get_target(debug_client);
+    unsigned int unit = cmd[1] == 'b' ? 1 : cmd[1] == 'w' ? 2 : cmd[1] == 'd' ? 4 : cmd[1] == 'q' ? 8 : 0;
+    ULONG64 address, value;
+    const char *rest;
+    HRESULT hr;
+
+    if (!unit || !target || !target->handle)
+        return E_INVALIDARG;
+    args = debug_skip_blanks(args);
+    if (FAILED(hr = debug_eval_prefix(debug_client, args, &address, &rest)))
+        return hr;
+    for (;;)
+    {
+        while (*rest == ' ' || *rest == '\t')
+            ++rest;
+        if (!*rest)
+            return S_OK;
+        if (FAILED(hr = debug_eval_prefix(debug_client, rest, &value, &rest)))
+            return hr;
+        if (!WriteProcessMemory(target->handle, (void *)(ULONG_PTR)address, &value, unit, NULL))
+            return HRESULT_FROM_WIN32(GetLastError());
+        address += unit;
+    }
+}
