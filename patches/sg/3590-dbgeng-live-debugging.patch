+static HRESULT STDMETHODCALLTYPE sym_group_OutputAsType(IDebugSymbolGroup2 *iface, ULONG index, const char *type)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    struct debug_client *debug_client = impl_from_IDebugClient((IDebugClient7 *)group->client);
+    struct sym_buffer buf;
+    HANDLE process;
+
+    TRACE("%p, %lu, %s.\n", iface, index, debugstr_a(type));
+
+    if (index >= group->count || !type)
+        return E_INVALIDARG;
+    if (!(process = debug_client_sym_handle(debug_client, NULL)))
+        return E_UNEXPECTED;
+    sym_buffer_init(&buf);
+    if (!SymGetTypeFromName(process, group->items[index].module, type, &buf.info))
+        return E_FAIL;
+    group->items[index].type_id = buf.info.TypeIndex;
+    group->items[index].size = buf.info.Size;
+    sym_group_fill_children(group, process, &group->items[index]);
+    return S_OK;
+}
