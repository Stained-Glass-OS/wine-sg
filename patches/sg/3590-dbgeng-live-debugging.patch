+/* ---- registers of a thread context ---- */
+struct ctx_reg
+{
+    const char *name;
+    size_t offset;
+    unsigned int size;      /* bytes of the register */
+    unsigned int shift;     /* bit position inside the field */
+};
+
+#ifdef __x86_64__
+#define CR(n, f, sz, sh) { n, FIELD_OFFSET(CONTEXT, f), sz, sh }
+static const struct ctx_reg ctx_registers[] =
+{
+    CR("rax", Rax, 8, 0), CR("rbx", Rbx, 8, 0), CR("rcx", Rcx, 8, 0), CR("rdx", Rdx, 8, 0),
+    CR("rsi", Rsi, 8, 0), CR("rdi", Rdi, 8, 0), CR("rbp", Rbp, 8, 0), CR("rsp", Rsp, 8, 0),
+    CR("r8", R8, 8, 0), CR("r9", R9, 8, 0), CR("r10", R10, 8, 0), CR("r11", R11, 8, 0),
+    CR("r12", R12, 8, 0), CR("r13", R13, 8, 0), CR("r14", R14, 8, 0), CR("r15", R15, 8, 0),
+    CR("rip", Rip, 8, 0), CR("eflags", EFlags, 4, 0),
+    CR("eax", Rax, 4, 0), CR("ebx", Rbx, 4, 0), CR("ecx", Rcx, 4, 0), CR("edx", Rdx, 4, 0),
+    CR("esi", Rsi, 4, 0), CR("edi", Rdi, 4, 0), CR("ebp", Rbp, 4, 0), CR("esp", Rsp, 4, 0),
+    CR("eip", Rip, 4, 0),
+    CR("ax", Rax, 2, 0), CR("bx", Rbx, 2, 0), CR("cx", Rcx, 2, 0), CR("dx", Rdx, 2, 0),
+    CR("si", Rsi, 2, 0), CR("di", Rdi, 2, 0), CR("bp", Rbp, 2, 0), CR("sp", Rsp, 2, 0),
+    CR("al", Rax, 1, 0), CR("bl", Rbx, 1, 0), CR("cl", Rcx, 1, 0), CR("dl", Rdx, 1, 0),
+    CR("ah", Rax, 1, 8), CR("bh", Rbx, 1, 8), CR("ch", Rcx, 1, 8), CR("dh", Rdx, 1, 8),
+    CR("cs", SegCs, 2, 0), CR("ds", SegDs, 2, 0), CR("es", SegEs, 2, 0), CR("fs", SegFs, 2, 0),
+    CR("gs", SegGs, 2, 0), CR("ss", SegSs, 2, 0),
+};
+static const char *const ctx_general_names[] = { "rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rip", "rsp", "rbp",
+        "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15", "eflags" };
+#elif defined(__i386__)
+#define CR(n, f, sz, sh) { n, FIELD_OFFSET(CONTEXT, f), sz, sh }
+static const struct ctx_reg ctx_registers[] =
+{
+    CR("eax", Eax, 4, 0), CR("ebx", Ebx, 4, 0), CR("ecx", Ecx, 4, 0), CR("edx", Edx, 4, 0),
+    CR("esi", Esi, 4, 0), CR("edi", Edi, 4, 0), CR("ebp", Ebp, 4, 0), CR("esp", Esp, 4, 0),
+    CR("eip", Eip, 4, 0), CR("eflags", EFlags, 4, 0),
+    CR("ax", Eax, 2, 0), CR("bx", Ebx, 2, 0), CR("cx", Ecx, 2, 0), CR("dx", Edx, 2, 0),
+    CR("si", Esi, 2, 0), CR("di", Edi, 2, 0), CR("bp", Ebp, 2, 0), CR("sp", Esp, 2, 0),
+    CR("al", Eax, 1, 0), CR("bl", Ebx, 1, 0), CR("cl", Ecx, 1, 0), CR("dl", Edx, 1, 0),
+    CR("ah", Eax, 1, 8), CR("bh", Ebx, 1, 8), CR("ch", Ecx, 1, 8), CR("dh", Edx, 1, 8),
+    CR("cs", SegCs, 4, 0), CR("ds", SegDs, 4, 0), CR("es", SegEs, 4, 0), CR("fs", SegFs, 4, 0),
+    CR("gs", SegGs, 4, 0), CR("ss", SegSs, 4, 0),
+};
+static const char *const ctx_general_names[] = { "eax", "ebx", "ecx", "edx", "esi", "edi", "eip", "esp", "ebp", "eflags" };
+#else
+static const struct ctx_reg ctx_registers[1];
+static const char *const ctx_general_names[] = { "" };
