+static BOOL debug_client_is_64(struct debug_client *debug_client)
+{
+    ULONG cpu = debug_client_effective_cpu(debug_client);
+
+    return cpu == IMAGE_FILE_MACHINE_AMD64 || cpu == IMAGE_FILE_MACHINE_ARM64;
+}
+
+static ULONG64 debug_cs_register_value(const CONTEXT *ctx, x86_reg reg, BOOL *ok)
+{
+    static const struct { x86_reg reg; const char *name; } regs[] =
+    {
+        { X86_REG_RAX, "rax" }, { X86_REG_RBX, "rbx" }, { X86_REG_RCX, "rcx" }, { X86_REG_RDX, "rdx" },
+        { X86_REG_RSI, "rsi" }, { X86_REG_RDI, "rdi" }, { X86_REG_RBP, "rbp" }, { X86_REG_RSP, "rsp" },
+        { X86_REG_RIP, "rip" }, { X86_REG_EAX, "eax" }, { X86_REG_EBX, "ebx" }, { X86_REG_ECX, "ecx" },
+        { X86_REG_EDX, "edx" }, { X86_REG_ESI, "esi" }, { X86_REG_EDI, "edi" }, { X86_REG_EBP, "ebp" },
+        { X86_REG_ESP, "esp" }, { X86_REG_EIP, "eip" },
+        { X86_REG_R8, "r8" }, { X86_REG_R9, "r9" }, { X86_REG_R10, "r10" }, { X86_REG_R11, "r11" },
+        { X86_REG_R12, "r12" }, { X86_REG_R13, "r13" }, { X86_REG_R14, "r14" }, { X86_REG_R15, "r15" },
+    };
+    unsigned int i;
+    ULONG64 value;
+
+    for (i = 0; i < ARRAY_SIZE(regs); ++i)
+    {
+        if (regs[i].reg == reg && ctx && debug_ctx_get_register(ctx, regs[i].name, &value))
+            return value;
+    }
+    *ok = FALSE;
+    return 0;
+}
+
+/* decodes the instruction at the offset; text is lower case, comma separated without blanks like the debugger prints it */
+static HRESULT debug_client_disasm_one(struct debug_client *debug_client, ULONG64 offset, struct disasm_insn *out,
+        const CONTEXT *ctx)
+{
+    static csh handle64, handle32;
+    struct target_process *target = debug_client_get_target(debug_client);
+    BOOL is64 = debug_client_is_64(debug_client);
+    csh *handle = is64 ? &handle64 : &handle32;
+    unsigned char buffer[16];
+    SIZE_T len = 0;
+    cs_insn *insn;
+    size_t count;
+    char *p, *q;
+
+    if (!target || !target->handle)
+        return E_UNEXPECTED;
+    if (!ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)offset, buffer, sizeof(buffer), &len) || !len)
+    {
+        /* near the end of a mapping a shorter read may still hold an instruction */
+        len = 0;
+        while (len < sizeof(buffer) && ReadProcessMemory(target->handle, (const char *)(ULONG_PTR)offset + len,
+                buffer + len, 1, NULL))
+            ++len;
+        if (!len)
+            return HRESULT_FROM_WIN32(ERROR_NOACCESS);
+    }
+    if (!*handle)
+    {
+        cs_option(0, CS_OPT_MEM, (size_t)&debug_cs_mem);
+        if (cs_open(CS_ARCH_X86, is64 ? CS_MODE_64 : CS_MODE_32, handle) != CS_ERR_OK)
+        {
+            *handle = 0;
+            return E_FAIL;
+        }
+        cs_option(*handle, CS_OPT_SYNTAX, CS_OPT_SYNTAX_MASM);
+        cs_option(*handle, CS_OPT_DETAIL, CS_OPT_ON);
+    }
+    memset(out, 0, sizeof(*out));
+    count = cs_disasm(*handle, buffer, len, offset, 1, &insn);
+    if (!count)
+    {
+        out->size = 1;
+        out->bytes[0] = buffer[0];
+        strcpy(out->mnemonic, "???");
+        return S_OK;
+    }
+    out->size = insn[0].size;
+    memcpy(out->bytes, insn[0].bytes, min(insn[0].size, sizeof(out->bytes)));
+    snprintf(out->mnemonic, sizeof(out->mnemonic), "%s", insn[0].mnemonic);
+    snprintf(out->operands, sizeof(out->operands), "%s", insn[0].op_str);
+    /* the debugger prints operands with ',' and no blanks around the address arithmetic */
+    for (p = q = out->operands; *p; ++p)
+    {
+        if (*p == ' ' && (p == out->operands || p[-1] == ',' || p[-1] == '+' || p[-1] == '-' || p[-1] == '*' || p[-1] == '['
+                || p[1] == '+' || p[1] == '-' || p[1] == '*' || p[1] == ']' || p[1] == ','))
+            continue;
+        *q++ = *p;
+    }
+    *q = 0;
+    out->is_call = cs_insn_group(*handle, &insn[0], X86_GRP_CALL);
+    {
+        int i;
+
+        for (i = 0; i < insn[0].detail->x86.op_count; ++i)
+        {
+            const cs_x86_op *op = &insn[0].detail->x86.operands[i];
+            BOOL ok = TRUE;
+            ULONG64 addr;
+
+            if (op->type != X86_OP_MEM || !strcmp(insn[0].mnemonic, "lea"))
+                continue;
+            addr = op->mem.disp;
+            if (op->mem.base == X86_REG_RIP)
+                addr += offset + insn[0].size;
+            else if (op->mem.base != X86_REG_INVALID)
+                addr += debug_cs_register_value(ctx, op->mem.base, &ok);
+            if (op->mem.index != X86_REG_INVALID)
+                addr += debug_cs_register_value(ctx, op->mem.index, &ok) * op->mem.scale;
+            if (ok)
+            {
+                if (!is64)
+                    addr = (ULONG)addr;
+                out->has_effective = TRUE;
+                out->effective = addr;
+            }
+            break;
+        }
+    }
+    cs_free(insn, count);
+    return S_OK;
+}
+
+static void debug_format_address(BOOL is64, ULONG64 address, char *buffer, size_t size)
+{
+    if (is64)
+        snprintf(buffer, size, "%08lx`%08lx", (ULONG)(address >> 32), (ULONG)address);
+    else
+        snprintf(buffer, size, "%08lx", (ULONG)address);
+}
+
+/* the text of one disassembled instruction as WaitForEvent users see it in a prompt */
+static HRESULT debug_client_disasm_text(struct debug_client *debug_client, ULONG64 offset, ULONG flags,
+        struct strbuf *sb, ULONG64 *next, ULONG64 *effective)
+{
+    struct disasm_insn insn;
+    CONTEXT ctx, *pctx = NULL;
+    char addr[32], bytes[40];
+    unsigned int i;
+    HRESULT hr;
+
+    if (SUCCEEDED(debug_client_get_context(debug_client, &ctx)))
+        pctx = &ctx;
+    if (FAILED(hr = debug_client_disasm_one(debug_client, offset, &insn, pctx)))
+        return hr;
+    if (flags & DEBUG_DISASM_MATCHING_SYMBOLS)
+    {
+        char *name;
+        ULONG64 disp;
+
+        if (SUCCEEDED(sym_name_by_offset(debug_client, offset, &name, &disp)))
+        {
+            if (!disp)
+                strbuf_append(sb, "%s:\n", name);
+            free(name);
+        }
+    }
+    debug_format_address(debug_client_is_64(debug_client), offset, addr, sizeof(addr));
+    bytes[0] = 0;
+    for (i = 0; i < insn.size && i < 8; ++i)
+        snprintf(bytes + 2 * i, sizeof(bytes) - 2 * i, "%02x", insn.bytes[i]);
+    strbuf_append(sb, "%s %-16s %-7s %s", addr, bytes, insn.mnemonic, insn.operands);
+    if (next)
+        *next = offset + insn.size;
+    if (effective)
+        *effective = insn.has_effective ? insn.effective : DEBUG_INVALID_OFFSET;
+    return S_OK;
+}
+
+/* the offset of an instruction boundary delta instructions away */
+static HRESULT debug_client_near_instruction(struct debug_client *debug_client, ULONG64 offset, LONG delta,
+        ULONG64 *result)
+{
+    struct disasm_insn insn;
+    HRESULT hr;
+    LONG i;
+
+    if (delta >= 0)
+    {
+        for (i = 0; i < delta; ++i)
+        {
+            if (FAILED(hr = debug_client_disasm_one(debug_client, offset, &insn, NULL)))
+                return hr;
+            offset += insn.size;
+        }
+        *result = offset;
+        return S_OK;
+    }
+    else
+    {
+        ULONG64 starts[64];
+        ULONG want = -delta, k, n;
+
+        if (want > ARRAY_SIZE(starts))
+            return E_INVALIDARG;
+        /* decode forward from a start far enough behind until an instruction ends exactly at the offset */
+        for (k = want * 8 + 16; k >= want; --k)
+        {
+            ULONG64 pos = offset - k;
+
+            n = 0;
+            while (pos < offset)
+            {
+                if (FAILED(debug_client_disasm_one(debug_client, pos, &insn, NULL)))
+                    break;
+                starts[n++ % ARRAY_SIZE(starts)] = pos;
+                pos += insn.size;
+            }
+            if (pos == offset && n >= want)
+            {
+                *result = starts[(n - want) % ARRAY_SIZE(starts)];
+                return S_OK;
+            }
+        }
+        return E_FAIL;
+    }
+}
+
+/* ---- stack traces ---- */
+static HRESULT debug_client_walk_stack(struct debug_client *debug_client, const CONTEXT *start, ULONG64 frame_offset,
+        ULONG64 stack_offset, ULONG64 instr_offset, DEBUG_STACK_FRAME *frames, ULONG frames_size, ULONG *filled,
+        CONTEXT *contexts, ULONG context_entry_size)
+{
+    struct target_process *target;
+    STACKFRAME64 frame;
+    CONTEXT ctx;
+    HANDLE process, thread;
+    DWORD sysid, machine;
+    ULONG n = 0;
+    HRESULT hr;
+
+    if (!(process = debug_client_sym_handle(debug_client, &target)))
+        return E_UNEXPECTED;
+    if (start)
+        ctx = *start;
+    else if (FAILED(hr = debug_client_get_context(debug_client, &ctx)))
+        return hr;
+    if (FAILED(hr = debug_client_get_thread_sysid(debug_client, debug_client->current_thread, &sysid)))
+        return hr;
+    if (!(thread = OpenThread(THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, sysid)))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    memset(&frame, 0, sizeof(frame));
+    frame.AddrPC.Offset = instr_offset ? instr_offset : CTX_IP(&ctx);
+    frame.AddrFrame.Offset = frame_offset ? frame_offset : CTX_FP(&ctx);
+    frame.AddrStack.Offset = stack_offset ? stack_offset : CTX_SP(&ctx);
+    frame.AddrPC.Mode = frame.AddrFrame.Mode = frame.AddrStack.Mode = AddrModeFlat;
+    if (instr_offset)
+        CTX_IP(&ctx) = instr_offset;
+    if (stack_offset)
+        CTX_SP(&ctx) = stack_offset;
+    if (frame_offset)
+        CTX_FP(&ctx) = frame_offset;
+    machine = debug_client_is_64(debug_client) ? IMAGE_FILE_MACHINE_AMD64 : IMAGE_FILE_MACHINE_I386;
+
+    while (n < frames_size)
+    {
+        if (n && !StackWalk64(machine, process, thread, &frame, &ctx, NULL, SymFunctionTableAccess64,
+                SymGetModuleBase64, NULL))
+            break;
+        if (n && !frame.AddrPC.Offset)
+            break;
+        memset(&frames[n], 0, sizeof(frames[n]));
+        frames[n].InstructionOffset = frame.AddrPC.Offset;
+        frames[n].ReturnOffset = frame.AddrReturn.Offset;
+        frames[n].FrameOffset = frame.AddrFrame.Offset;
+        frames[n].StackOffset = frame.AddrStack.Offset;
+        frames[n].Params[0] = frame.Params[0];
+        frames[n].Params[1] = frame.Params[1];
+        frames[n].Params[2] = frame.Params[2];
+        frames[n].Params[3] = frame.Params[3];
+        frames[n].FrameNumber = n;
+        if (contexts)
+        {
+            CONTEXT *c = (CONTEXT *)((char *)contexts + n * context_entry_size);
+
+            memset(c, 0, context_entry_size);
+            memcpy(c, &ctx, min(sizeof(ctx), context_entry_size));
+        }
+        ++n;
+        if (n == 1 && !frame.AddrReturn.Offset)
+        {
+            /* the first walk step only reports the starting frame */
+            if (!StackWalk64(machine, process, thread, &frame, &ctx, NULL, SymFunctionTableAccess64, SymGetModuleBase64, NULL))
+                break;
+            frames[0].ReturnOffset = frame.AddrReturn.Offset;
+            frames[0].FrameOffset = frame.AddrFrame.Offset;
+            /* the walk moved to the caller; give its frame as the second entry */
+            if (n < frames_size && frame.AddrPC.Offset)
+            {
+                memset(&frames[n], 0, sizeof(frames[n]));
+                frames[n].InstructionOffset = frame.AddrPC.Offset;
+                frames[n].ReturnOffset = frame.AddrReturn.Offset;
+                frames[n].FrameOffset = frame.AddrFrame.Offset;
+                frames[n].StackOffset = frame.AddrStack.Offset;
+                frames[n].FrameNumber = n;
+                ++n;
+            }
+        }
+    }
+    CloseHandle(thread);
+    if (filled)
+        *filled = n;
+    return S_OK;
+}
+
+static void debug_output_stack(struct debug_client *debug_client, DEBUG_STACK_FRAME *frames, ULONG count, ULONG flags)
+{
+    BOOL is64 = debug_client_is_64(debug_client);
+    struct strbuf sb = { 0 };
+    ULONG i;
+
+    if (flags & DEBUG_STACK_COLUMN_NAMES)
+    {
+        if (flags & DEBUG_STACK_FRAME_NUMBERS)
+            strbuf_append(&sb, " # ");
+        if (flags & DEBUG_STACK_FRAME_ADDRESSES)
+            strbuf_append(&sb, is64 ? "Child-SP          RetAddr           " : "ChildEBP RetAddr  ");
+        if (flags & DEBUG_STACK_ARGUMENTS)
+            strbuf_append(&sb, "Args to Child                                  ");
+        strbuf_append(&sb, "Call Site\n");
+    }
+    for (i = 0; i < count; ++i)
+    {
+        char a1[32], a2[32], *name = NULL;
+        ULONG64 disp = 0;
+        IMAGEHLP_LINE64 line = { sizeof(line) };
+        DWORD ldisp;
+        HANDLE process = debug_client_sym_handle(debug_client, NULL);
+
+        if (flags & DEBUG_STACK_FRAME_NUMBERS)
+            strbuf_append(&sb, "%02lx ", frames[i].FrameNumber);
+        if (flags & DEBUG_STACK_FRAME_ADDRESSES)
+        {
+            debug_format_address(is64, frames[i].StackOffset, a1, sizeof(a1));
+            debug_format_address(is64, frames[i].ReturnOffset, a2, sizeof(a2));
+            strbuf_append(&sb, "%s %s ", a1, a2);
+        }
+        if ((flags & DEBUG_STACK_ARGUMENTS) && !is64)
+            strbuf_append(&sb, "%08lx %08lx %08lx ", (ULONG)frames[i].Params[0], (ULONG)frames[i].Params[1],
+                    (ULONG)frames[i].Params[2]);
+        if (SUCCEEDED(sym_name_by_offset(debug_client, frames[i].InstructionOffset, &name, &disp)))
+        {
+            if (disp)
+                strbuf_append(&sb, "%s+0x%I64x", name, disp);
+            else
+                strbuf_append(&sb, "%s", name);
+            free(name);
+        }
+        else
+        {
+            debug_format_address(is64, frames[i].InstructionOffset, a1, sizeof(a1));
+            strbuf_append(&sb, "%s", a1);
+        }
+        if ((flags & DEBUG_STACK_SOURCE_LINE) && process
+                && SymGetLineFromAddr64(process, frames[i].InstructionOffset, &ldisp, &line))
+            strbuf_append(&sb, " [%s @ %lu]", line.FileName, line.LineNumber);
+        strbuf_append(&sb, "\n");
+    }
+    if (sb.data)
+        debug_client_output(debug_client, DEBUG_OUTPUT_NORMAL, sb.data);
+    free(sb.data);
+}
+
+/* ---- expression evaluation ---- */
+struct expr
+{
+    struct debug_client *client;
+    const char *start, *p;
+    CONTEXT ctx;
+    BOOL have_ctx, ctx_tried;
+    int radix;
+    BOOL cpp;
+    BOOL failed;
+    HRESULT error;
+};
+
+static void expr_skip(struct expr *e)
+{
+    while (*e->p == ' ' || *e->p == '\t')
+        ++e->p;
+}
+
+static BOOL expr_load_context(struct expr *e)
+{
+    if (!e->ctx_tried)
+    {
+        e->ctx_tried = TRUE;
+        e->have_ctx = SUCCEEDED(debug_client_get_context(e->client, &e->ctx));
+    }
+    return e->have_ctx;
+}
+
+static ULONG64 expr_read_memory(struct expr *e, ULONG64 address, unsigned int size)
+{
+    struct target_process *target = debug_client_get_target(e->client);
+    ULONG64 value = 0;
+    SIZE_T read = 0;
+
+    if (!target || !target->handle || !ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)address, &value, size, &read)
+            || read != size)
+    {
+        e->failed = TRUE;
+        e->error = HRESULT_FROM_WIN32(ERROR_NOACCESS);
+        return 0;
+    }
+    return value;
+}
+
+static BOOL expr_is_digit(int c, int radix)
+{
+    int v;
+
+    if (c >= '0' && c <= '9')
+        v = c - '0';
+    else if (c >= 'a' && c <= 'f')
+        v = c - 'a' + 10;
+    else if (c >= 'A' && c <= 'F')
+        v = c - 'A' + 10;
+    else
+        return FALSE;
+    return v < radix;
+}
+
+static BOOL expr_is_ident(int c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '$'
+            || c == '@' || c == '?' || c == '!' || c == '.' || c == '`' || c == '#';
+}
+
+static ULONG64 expr_conditional(struct expr *e, int level);
+
+static ULONG64 expr_find_module(struct expr *e, const char *name, size_t len, BOOL *found)
+{
+    struct target_process *target = debug_client_get_target(e->client);
+    unsigned int i;
+
+    *found = FALSE;
+    if (!target || FAILED(debug_target_init_modules_info(target)))
+        return 0;
+    for (i = 0; i < target->modules.loaded; ++i)
+    {
+        const char *image = target->modules.info[i].image_name, *base = image, *dot, *q;
+        size_t n;
+
+        for (q = image; *q; ++q)
+            if (*q == '\\' || *q == '/')
+                base = q + 1;
+        dot = strrchr(base, '.');
+        n = dot ? dot - base : strlen(base);
+        if (n == len && !strnicmp(base, name, len))
+        {
+            *found = TRUE;
+            return target->modules.info[i].params.Base;
+        }
+    }
+    return 0;
+}
+
+static ULONG64 expr_primary(struct expr *e)
+{
+    ULONG64 value = 0;
+    const char *tok;
+    size_t len;
+    char buf[SYM_MAX_NAME];
+    int radix = e->radix;
+    BOOL is_number;
+    unsigned int i;
+
+    expr_skip(e);
+    if (*e->p == '(')
+    {
+        ++e->p;
+        value = expr_conditional(e, 0);
+        expr_skip(e);
+        if (*e->p == ')')
+            ++e->p;
+        else if (!e->failed)
+        {
+            e->failed = TRUE;
+            e->error = E_FAIL;
+        }
+        return value;
+    }
+    if (*e->p == '\'' && e->p[1] && e->p[2] == '\'')
+    {
+        value = (unsigned char)e->p[1];
+        e->p += 3;
+        return value;
+    }
+    if (!expr_is_ident(*e->p))
+    {
+        e->failed = TRUE;
+        e->error = E_FAIL;
+        return 0;
+    }
+    tok = e->p;
+    while (expr_is_ident(*e->p))
+        ++e->p;
+    len = e->p - tok;
+
+    /* keyword operators with a parenthesised operand */
+    {
+        static const struct { const char *name; unsigned int size; } derefs[] =
+        {
+            { "by", 1 }, { "wo", 2 }, { "dwo", 4 }, { "qwo", 8 }, { "poi", 0 },
+        };
+
+        for (i = 0; i < ARRAY_SIZE(derefs); ++i)
+        {
+            if (len == strlen(derefs[i].name) && !strnicmp(tok, derefs[i].name, len))
+            {
+                const char *save = e->p;
+
+                expr_skip(e);
+                if (*e->p == '(')
+                {
+                    unsigned int size = derefs[i].size ? derefs[i].size : (debug_client_is_64(e->client) ? 8 : 4);
+
+                    ++e->p;
+                    value = expr_conditional(e, 0);
+                    expr_skip(e);
+                    if (*e->p == ')')
+                        ++e->p;
+                    return e->failed ? 0 : expr_read_memory(e, value, size);
+                }
+                e->p = save;
+            }
+        }
+        if ((len == 2 && !strnicmp(tok, "hi", 2)) || (len == 3 && !strnicmp(tok, "low", 3)))
+        {
+            const char *save = e->p;
+
+            expr_skip(e);
+            if (*e->p == '(')
+            {
+                ++e->p;
+                value = expr_conditional(e, 0);
+                expr_skip(e);
+                if (*e->p == ')')
+                    ++e->p;
+                return len == 2 ? (value >> 16) & 0xffff : value & 0xffff;
+            }
+            e->p = save;
+        }
+    }
+
+    /* numeric prefixes */
+    if (len > 2 && tok[0] == '0' && (tok[1] == 'x' || tok[1] == 'X' || tok[1] == 'n' || tok[1] == 'N'
+            || tok[1] == 't' || tok[1] == 'T' || tok[1] == 'y' || tok[1] == 'Y'))
+    {
+        radix = (tok[1] == 'x' || tok[1] == 'X') ? 16 : (tok[1] == 'n' || tok[1] == 'N') ? 10
+                : (tok[1] == 't' || tok[1] == 'T') ? 8 : 2;
+        is_number = TRUE;
+        for (i = 2; i < len; ++i)
+            if (tok[i] != '`' && !expr_is_digit(tok[i], radix))
+                is_number = FALSE;
+        if (is_number)
+        {
+            for (i = 2; i < len; ++i)
+                if (tok[i] != '`')
+                    value = value * radix + (tok[i] <= '9' ? tok[i] - '0' : (tok[i] | 0x20) - 'a' + 10);
+            return value;
+        }
+    }
+    if (e->cpp)
+        radix = 10;
+    is_number = TRUE;
+    for (i = 0; i < len; ++i)
+        if (tok[i] != '`' && !expr_is_digit(tok[i], radix))
+            is_number = FALSE;
+    /* a name made of digits of the radix is a number when it starts with a digit, else a symbol is preferred */
+    if (is_number && tok[0] >= '0' && tok[0] <= '9')
+    {
+        for (i = 0; i < len; ++i)
+            if (tok[i] != '`')
+                value = value * radix + (tok[i] <= '9' ? tok[i] - '0' : (tok[i] | 0x20) - 'a' + 10);
+        return value;
+    }
+
+    snprintf(buf, sizeof(buf), "%.*s", (int)min(len, sizeof(buf) - 1), tok);
+    if (expr_load_context(e) && debug_ctx_get_register(&e->ctx, buf, &value))
+        return value;
+    {
+        BOOL found;
+
+        value = expr_find_module(e, tok, len, &found);
+        if (found)
+            return value;
+    }
+    {
+        struct sym_buffer sb;
+
+        if (SUCCEEDED(sym_lookup_name(e->client, buf, &sb, NULL)))
+            return sb.info.Address;
+    }
+    if (is_number)
+    {
+        for (i = 0; i < len; ++i)
+            if (tok[i] != '`')
+                value = value * radix + (tok[i] <= '9' ? tok[i] - '0' : (tok[i] | 0x20) - 'a' + 10);
+        return value;
+    }
+    e->failed = TRUE;
+    e->error = E_FAIL;
+    return 0;
+}
+
+static ULONG64 expr_unary(struct expr *e)
+{
+    expr_skip(e);
+    switch (*e->p)
+    {
+    case '-': ++e->p; return -expr_unary(e);
+    case '+': ++e->p; return expr_unary(e);
+    case '~': ++e->p; return ~expr_unary(e);
+    case '!': ++e->p; return !expr_unary(e);
+    case '*': /* pointer dereference (C++ syntax) */
+        ++e->p;
+        return expr_read_memory(e, expr_unary(e), debug_client_is_64(e->client) ? 8 : 4);
+    default:
+        return expr_primary(e);
+    }
+}
+
+struct expr_op
+{
+    const char *text;
+    int level;
+};
+
+static const struct expr_op expr_ops[] =
+{
+    { "||", 1 }, { "&&", 2 }, { "|", 3 }, { "^", 4 }, { "&", 5 }, { "==", 6 }, { "!=", 6 },
+    { "<=", 7 }, { ">=", 7 }, { "<<", 8 }, { ">>>", 8 }, { ">>", 8 }, { "<", 7 }, { ">", 7 },
+    { "+", 9 }, { "-", 9 }, { "*", 10 }, { "/", 10 }, { "%", 10 },
+};
+
+/* returns the operator at the current position and its length (0 when none) */
+static const struct expr_op *expr_peek_op(struct expr *e, size_t *len)
+{
+    unsigned int i;
+
+    expr_skip(e);
+    for (i = 0; i < ARRAY_SIZE(expr_ops); ++i)
+    {
+        size_t n = strlen(expr_ops[i].text);
+
+        if (!strncmp(e->p, expr_ops[i].text, n))
+        {
+            /* "&&" must not be read as "&" and so on: the table lists longer operators first for each leading character */
+            *len = n;
+            return &expr_ops[i];
+        }
+    }
+    if (!strnicmp(e->p, "and", 3) && !expr_is_ident(e->p[3])) { static const struct expr_op op = { "&", 5 }; *len = 3; return &op; }
+    if (!strnicmp(e->p, "xor", 3) && !expr_is_ident(e->p[3])) { static const struct expr_op op = { "^", 4 }; *len = 3; return &op; }
+    if (!strnicmp(e->p, "or", 2) && !expr_is_ident(e->p[2])) { static const struct expr_op op = { "|", 3 }; *len = 2; return &op; }
+    if (!strnicmp(e->p, "mod", 3) && !expr_is_ident(e->p[3])) { static const struct expr_op op = { "%", 10 }; *len = 3; return &op; }
+    *len = 0;
+    return NULL;
+}
+
+static ULONG64 expr_conditional(struct expr *e, int level)
+{
+    ULONG64 left = expr_unary(e);
+
+    for (;;)
+    {
+        const struct expr_op *op;
+        const char *save = e->p;
+        size_t len;
+        ULONG64 right;
+
+        if (e->failed || !(op = expr_peek_op(e, &len)) || op->level <= level)
+        {
+            e->p = save;
+            return left;
+        }
+        e->p += len;
+        right = expr_conditional(e, op->level);
+        if (e->failed)
+            return 0;
+        switch (op->text[0])
+        {
+        case '|': left = op->text[1] ? (left || right) : (left | right); break;
+        case '&': left = op->text[1] ? (left && right) : (left & right); break;
+        case '^': left ^= right; break;
+        case '=': left = left == right; break;
+        case '!': left = left != right; break;
+        case '<': left = op->text[1] == '<' ? left << right : op->text[1] == '=' ? left <= right : left < right; break;
+        case '>':
+            if (op->text[1] == '>' && op->text[2] == '>')
+                left = (LONG64)left >> right;
+            else if (op->text[1] == '>')
+                left >>= right;
+            else
+                left = op->text[1] == '=' ? left >= right : left > right;
+            break;
+        case '+': left += right; break;
+        case '-': left -= right; break;
+        case '*': left *= right; break;
+        case '/':
+            if (!right)
+            {
+                e->failed = TRUE;
+                e->error = E_FAIL;
+                return 0;
+            }
+            left /= right;
+            break;
+        case '%':
+            if (!right)
+            {
+                e->failed = TRUE;
+                e->error = E_FAIL;
+                return 0;
+            }
+            left %= right;
+            break;
+        }
+    }
+}
+
+static HRESULT debug_coerce_value(const DEBUG_VALUE *in, ULONG type, DEBUG_VALUE *out)
+{
+    ULONG64 integer = 0;
+    double real = 0;
+    BOOL is_float = FALSE;
+
+    switch (in->Type)
+    {
+    case DEBUG_VALUE_INT8: integer = in->I8; break;
+    case DEBUG_VALUE_INT16: integer = in->I16; break;
+    case DEBUG_VALUE_INT32: integer = in->I32; break;
+    case DEBUG_VALUE_INT64: integer = in->I64; break;
+    case DEBUG_VALUE_FLOAT32: real = in->F32; is_float = TRUE; break;
+    case DEBUG_VALUE_FLOAT64: real = in->F64; is_float = TRUE; break;
+    case DEBUG_VALUE_FLOAT80:
+    {
+        long double ld = 0;
+
+        memcpy(&ld, in->F80Bytes, 10);
+        real = ld;
+        is_float = TRUE;
+        break;
+    }
+    default:
+        return E_INVALIDARG;
+    }
+    if (type == DEBUG_VALUE_INVALID || type >= DEBUG_VALUE_TYPES)
+        return E_INVALIDARG;
+    if (is_float)
+        integer = real < 0 ? (ULONG64)(LONG64)real : (ULONG64)real;
+    else
+        real = (double)integer;
+    memset(out, 0, sizeof(*out));
+    switch (type)
+    {
+    case DEBUG_VALUE_INT8: out->I8 = integer; break;
+    case DEBUG_VALUE_INT16: out->I16 = integer; break;
+    case DEBUG_VALUE_INT32: out->I32 = integer; break;
+    case DEBUG_VALUE_INT64: out->I64 = integer; break;
+    case DEBUG_VALUE_FLOAT32: out->F32 = real; break;
+    case DEBUG_VALUE_FLOAT64: out->F64 = real; break;
+    case DEBUG_VALUE_FLOAT80:
+    {
+        long double ld = real;
+
+        memcpy(out->F80Bytes, &ld, 10);
+        break;
+    }
+    default:
+        return E_NOTIMPL;
+    }
+    out->Type = type;
+    return S_OK;
+}
+
+static HRESULT debug_client_evaluate(struct debug_client *debug_client, const char *expression, ULONG desired_type,
+        DEBUG_VALUE *value, ULONG *remainder_index)
+{
+    struct expr e = { 0 };
+    DEBUG_VALUE result = { { 0 } };
+    ULONG64 v;
+
+    if (!expression || !value)
+        return E_INVALIDARG;
+    e.client = debug_client;
+    e.start = e.p = expression;
+    e.radix = debug_client->radix ? debug_client->radix : 16;
+    e.cpp = debug_client->expression_syntax == DEBUG_EXPR_CPLUSPLUS;
+    v = expr_conditional(&e, 0);
+    if (e.failed)
+        return e.error ? e.error : E_FAIL;
+    expr_skip(&e);
+    if (remainder_index)
+        *remainder_index = e.p - e.start;
+    else if (*e.p)
+        return E_FAIL;
+    result.I64 = v;
+    result.Type = DEBUG_VALUE_INT64;
+    if (desired_type == DEBUG_VALUE_INVALID || desired_type == DEBUG_VALUE_INT64)
+    {
+        *value = result;
+        return S_OK;
+    }
+    return debug_coerce_value(&result, desired_type, value);
+}
