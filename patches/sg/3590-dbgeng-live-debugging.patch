+static HRESULT debug_cmd_symbols(struct debug_client *debug_client, char *args)
+{
+    BOOL is64 = debug_client_is_64(debug_client);
+    struct sym_collect c;
+    HANDLE process;
+    unsigned int i;
+    char mask[SYM_MAX_NAME];
+
+    args = debug_skip_blanks(args);
+    debug_trim_end(args);
+    if (!*args)
+        return E_INVALIDARG;
+    if (!(process = debug_client_sym_handle(debug_client, NULL)))
+        return E_UNEXPECTED;
+    snprintf(mask, sizeof(mask), strchr(args, '!') ? "%s" : "*!%s", args);
+    if (!sym_enum_mask(process, mask, TRUE, &c))
+        return E_FAIL;
+    for (i = 0; i < c.count; ++i)
+    {
+        char addr[32];
+
+        debug_format_address(is64, c.items[i].address, addr, sizeof(addr));
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%s %s\n", addr, c.items[i].name);
+    }
+    sym_collect_free(&c);
+    return S_OK;
+}
