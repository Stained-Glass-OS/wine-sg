+/* replaces the aliases in a command line */
+
+static char *debug_expand_aliases(struct debug_client *debug_client, const char *text)
+{
+    struct strbuf sb = { 0 };
+    const char *p = text;
+    unsigned int i;
+
+    while (*p)
+    {
+        BOOL replaced = FALSE;
+
+        if (!p[0] || (p > text && expr_is_ident(p[-1]) && p[-1] != '$'))
+            goto copy;
+        for (i = 0; i < debug_client->replacement_count; ++i)
+        {
+            size_t len = strlen(debug_client->replacements[i].src);
+
+            if (!strncmp(p, debug_client->replacements[i].src, len) && !expr_is_ident(p[len]))
+            {
+                strbuf_append(&sb, "%s", debug_client->replacements[i].dst);
+                p += len;
+                replaced = TRUE;
+                break;
+            }
+        }
+        if (replaced)
+            continue;
+copy:
+        strbuf_append(&sb, "%c", *p++);
+    }
+    return sb.data ? sb.data : strdup("");
+}
+
+static HRESULT debug_execute_command(struct debug_client *debug_client, char *cmd)
+{
+    char name[16], *args;
+    size_t n = 0;
+    HRESULT hr = S_OK;
+
+    cmd = debug_skip_blanks(cmd);
+    debug_trim_end(cmd);
+    if (!*cmd || *cmd == '*' || !strncmp(cmd, "$$", 2))
+        return S_OK;
+    if (*cmd == '!')
+        return debug_execute_extension(debug_client, cmd);
+    if (*cmd == '?' || *cmd == '~' || *cmd == '|')
+    {
+        name[n++] = *cmd++;
+        if (name[0] == '?' && *cmd == '?')
+            name[n++] = *cmd++;
+    }
+    else
+    {
+        if (*cmd == '.')
+            name[n++] = *cmd++;
+        while (n < sizeof(name) - 1 && ((*cmd >= 'a' && *cmd <= 'z') || (*cmd >= 'A' && *cmd <= 'Z')
+                || (*cmd >= '0' && *cmd <= '9' && n > 1 && (name[0] == 'b' || name[0] == 'e' || name[0] == 'd'))
+                || (name[0] == '.' && *cmd == '_')))
+            name[n++] = *cmd++;
+        /* "bp1", "r eax" and "kb 5": the letters up to the first blank or digit are the command */
+    }
+    name[n] = 0;
+    args = cmd;
+
+    if (!strcmp(name, "?") || !strcmp(name, "??"))
+    {
+        BOOL is64 = debug_client_is_64(debug_client);
+        ULONG64 v;
+        char hex[32];
+
+        if (FAILED(hr = debug_eval_value(debug_client, debug_skip_blanks(args), &v)))
+            return hr;
+        debug_format_value64(is64, v, hex, sizeof(hex));
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Evaluate expression: %I64d = %s\n", v, hex);
+        return S_OK;
+    }
+    if (!strcmp(name, ".echo"))
+    {
+        char *text = debug_skip_blanks(args);
+        size_t len = strlen(text);
+
+        if (len >= 2 && text[0] == '"' && text[len - 1] == '"')
+        {
+            text[len - 1] = 0;
+            ++text;
+        }
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%s\n", text);
+        return S_OK;
+    }
+    if (!strcmp(name, "r"))
+        return debug_cmd_registers(debug_client, args);
+    if (!strcmp(name, "lm"))
+        return debug_cmd_modules(debug_client);
+    if (name[0] == 'k' && !strpbrk(name + 1, "ADEFGHIJKLMNOQRSTUWXYZaceghijlmoqrstuwxyz") )
+        return debug_cmd_stack(debug_client, name, args);
+    if (name[0] == 'd' && n == 2 && strchr("bwdqcpau", name[1]))
+        return debug_cmd_dump(debug_client, name, args);
+    if (name[0] == 'e' && n == 2 && strchr("bwdq", name[1]))
+        return debug_cmd_edit(debug_client, name, args);
+    if (!strcmp(name, "u"))
+        return debug_cmd_disasm(debug_client, args);
+    if (!strcmp(name, "x"))
+        return debug_cmd_symbols(debug_client, args);
+    if (!strcmp(name, "ln"))
+        return debug_cmd_near(debug_client, args);
+    if (!strcmp(name, "dt"))
+        return debug_cmd_type(debug_client, args);
+    if (name[0] == 'b' && strchr("pumlcde", name[1]) && (n == 2 || (n == 3 && name[2] >= '0' && name[2] <= '9')))
+        return debug_cmd_breakpoint(debug_client, name, args);
+    if (!strcmp(name, "g") || !strcmp(name, "gh") || !strcmp(name, "gn") || !strcmp(name, "p") || !strcmp(name, "t"))
+    {
+        ULONG status = !strcmp(name, "g") ? DEBUG_STATUS_GO : !strcmp(name, "gh") ? DEBUG_STATUS_GO_HANDLED
+                : !strcmp(name, "gn") ? DEBUG_STATUS_GO_NOT_HANDLED : !strcmp(name, "p") ? DEBUG_STATUS_STEP_OVER
+                : DEBUG_STATUS_STEP_INTO;
+
+        return debugcontrol_SetExecutionStatus(&debug_client->IDebugControl4_iface, status);
+    }
+    if (!strcmp(name, "as") || !strcmp(name, "aS") || !strcmp(name, "ad") || !strcmp(name, "al"))
+        return debug_cmd_alias(debug_client, name, args);
+    if (name[0] == 's' && name[1] == 'x' && n <= 3 && name[0] == 's')
+        return debug_cmd_filters(debug_client, name, args);
+    if (!strcmp(name, "~") )
+        return debug_cmd_threads(debug_client, args, FALSE);
+    if (!strcmp(name, "|"))
+        return debug_cmd_threads(debug_client, args, TRUE);
+    if (!strcmp(name, ".reload"))
+        return debugsymbols_Reload(&debug_client->IDebugSymbols3_iface, debug_skip_blanks(args));
+    if (!strcmp(name, ".sympath") || !strcmp(name, ".srcpath") || !strcmp(name, ".exepath"))
+    {
+        char *value = debug_skip_blanks(args);
+        char **field = name[1] == 's' && name[2] == 'y' ? &debug_client->symbol_path
+                : name[1] == 's' ? &debug_client->source_path : &debug_client->image_path;
+        char *copy;
+
+        debug_trim_end(value);
+        if (*value)
+        {
+            if (*value == '+')
+            {
+                size_t len = strlen(*field ? *field : "") + strlen(value) + 2;
+
+                if (!(copy = malloc(len)))
+                    return E_OUTOFMEMORY;
+                snprintf(copy, len, "%s;%s", *field ? *field : "", value + 1);
+            }
+            else if (!(copy = strdup(value)))
+                return E_OUTOFMEMORY;
+            free(*field);
+            *field = copy;
+        }
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%s search path is: %s\n",
+                name[1] == 's' && name[2] == 'y' ? "Symbol" : name[1] == 's' ? "Source" : "Executable image",
+                *field ? *field : "");
+        return S_OK;
+    }
+    if (!strcmp(name, ".logopen") || !strcmp(name, ".logappend"))
+    {
+        char *file = debug_skip_blanks(args);
+
+        debug_trim_end(file);
+        if (!strncmp(file, "/u", 2))
+            file = debug_skip_blanks(file + 2);
+        if (SUCCEEDED(hr = debug_client_open_log(debug_client, file, (name[4] == 'a' ? DEBUG_LOG_APPEND : 0))))
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Opened log file '%s'\n", file);
+        return hr;
+    }
+    if (!strcmp(name, ".logclose"))
+    {
+        if (debug_client->log_name)
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Closing open log file %s\n", debug_client->log_name);
+        debug_client_close_log(debug_client);
+        return S_OK;
+    }
+    if (!strcmp(name, ".logfile"))
+    {
+        if (debug_client->log_name)
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Log '%s' open\n", debug_client->log_name);
+        else
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "No log file open\n");
+        return S_OK;
+    }
+    if (!strcmp(name, ".load") || !strcmp(name, ".unload"))
+    {
+        ULONG64 handle;
+        char *path = debug_skip_blanks(args);
+
+        debug_trim_end(path);
+        if (name[1] == 'l')
+            return debugcontrol_AddExtension(&debug_client->IDebugControl4_iface, path, 0, &handle);
+        if (FAILED(hr = debugcontrol_GetExtensionByPath(&debug_client->IDebugControl4_iface, path, &handle)))
+            return hr;
+        return debugcontrol_RemoveExtension(&debug_client->IDebugControl4_iface, handle);
+    }
+    if (!strcmp(name, ".expr"))
+    {
+        char *syntax = strstr(args, "/s");
+
+        if (syntax)
+        {
+            syntax = debug_skip_blanks(syntax + 2);
+            debug_trim_end(syntax);
+            return debugcontrol_SetExpressionSyntaxByName(&debug_client->IDebugControl4_iface, syntax);
+        }
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Current expression evaluator: %s\n",
+                debug_client->expression_syntax == DEBUG_EXPR_CPLUSPLUS ? "C++ source expressions"
+                : "Microsoft Assembler expressions");
+        return S_OK;
+    }
+    if (!strcmp(name, ".sleep"))
+    {
+        ULONG64 ms;
+
+        if (FAILED(hr = debug_eval_value(debug_client, debug_skip_blanks(args), &ms)))
+            return hr;
+        Sleep(ms);
+        return S_OK;
+    }
+    if (!strcmp(name, ".symopt") || !strcmp(name, ".symopt+") || !strcmp(name, ".symopt-"))
+    {
+        ULONG64 v;
+
+        if (FAILED(hr = debug_eval_value(debug_client, debug_skip_blanks(args), &v)))
+            return hr;
+        if (name[7] == '-')
+            debug_client->symbol_options &= ~v;
+        else
+            debug_client->symbol_options |= v;
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Symbol options are %#lx:\n", debug_client->symbol_options);
+        return S_OK;
+    }
+    if (!strcmp(name, ".effmach"))
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Effective machine: %s\n",
+                debug_client_is_64(debug_client) ? "x64 (AMD64)" : "x86 compatible (x86)");
+        return S_OK;
+    }
+    if (!strcmp(name, "version"))
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Stained Glass debugger engine version 10.0\n");
+        return S_OK;
+    }
+    if (!strcmp(name, "vertarget"))
+    {
+        RTL_OSVERSIONINFOEXW version = { sizeof(version) };
+
+        RtlGetVersion(&version);
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "Operating system version %lu.%lu build %lu\n",
+                version.dwMajorVersion, version.dwMinorVersion, version.dwBuildNumber);
+        return S_OK;
+    }
+    if (!strcmp(name, ".cls") || !strcmp(name, ".lines") || !strcmp(name, ".enable_unicode") || !strcmp(name, ".chain"))
+        return S_OK;
+    if (!strcmp(name, "q") || !strcmp(name, "qq") || !strcmp(name, ".kill") || !strcmp(name, "qd") || !strcmp(name, ".detach"))
+    {
+        BOOL detach = name[1] == 'd' || !strcmp(name, ".detach");
+
+        return debugclient_EndSession(&debug_client->IDebugClient_iface,
+                detach ? DEBUG_END_ACTIVE_DETACH : DEBUG_END_ACTIVE_TERMINATE);
+    }
+    debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "^ Syntax error in '%s'\n", name);
+    return E_FAIL;
+}
+
+static HRESULT debug_execute_text(struct debug_client *debug_client, const char *text)
+{
+    char *expanded, *cur, *p;
+    HRESULT hr = S_OK;
+    BOOL quoted = FALSE;
+
+    if (!(expanded = debug_expand_aliases(debug_client, text)))
+        return E_OUTOFMEMORY;
+    cur = expanded;
+    for (p = expanded; ; ++p)
+    {
+        if (*p == '"')
+            quoted = !quoted;
+        if ((*p == ';' && !quoted) || !*p)
+        {
+            BOOL last = !*p;
+
+            *p = 0;
+            if (FAILED(hr = debug_execute_command(debug_client, cur)))
+                break;
+            cur = p + 1;
+            if (last)
+                break;
+        }
+    }
+    free(expanded);
+    return hr;
+}
