+static HRESULT debug_cmd_alias(struct debug_client *debug_client, const char *cmd, char *args)
+{
+    unsigned int i;
+    char *value;
+
+    args = debug_skip_blanks(args);
+    if (!strcmp(cmd, "al"))
+    {
+        if (!debug_client->replacement_count)
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "No user-named aliases found.\n");
+        else
+        {
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "  Alias            Value \n -------           ------- \n");
+            for (i = 0; i < debug_client->replacement_count; ++i)
+                debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%-16s %s\n", debug_client->replacements[i].src,
+                        debug_client->replacements[i].dst);
+        }
+        return S_OK;
+    }
+    if (!strcmp(cmd, "ad"))
+    {
+        debug_trim_end(args);
+        if (!strcmp(args, "*"))
+        {
+            debug_client_remove_replacements(debug_client);
+            return S_OK;
+        }
+        return debug_client_set_replacement(debug_client, args, NULL);
+    }
+    /* as name value, aS name value */
+    if (!(value = strpbrk(args, " \t")))
+        return E_INVALIDARG;
+    *value++ = 0;
+    value = debug_skip_blanks(value);
+    debug_trim_end(value);
+    return debug_client_set_replacement(debug_client, args, value);
+}
