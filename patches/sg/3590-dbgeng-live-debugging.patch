+static HRESULT STDMETHODCALLTYPE sym_group_OutputSymbols(IDebugSymbolGroup2 *iface, ULONG control, ULONG flags,
+        ULONG start, ULONG count)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    struct debug_client *debug_client = impl_from_IDebugClient((IDebugClient7 *)group->client);
+    ULONG i;
+
+    TRACE("%p, %#lx, %#lx, %lu, %lu.\n", iface, control, flags, start, count);
+
+    if (start > group->count || count > group->count - start)
+        return E_INVALIDARG;
+    for (i = start; i < start + count; ++i)
+    {
+        struct strbuf sb = { 0 };
+        char *value = sym_group_value_text(group, i);
+        unsigned int depth = 0, p = group->items[i].parent;
+
+        while (p != DEBUG_ANY_ID && depth < 16)
+        {
+            ++depth;
+            p = group->items[p].parent;
+        }
+        strbuf_append(&sb, "%*s%s = %s\n", depth * 3, "", group->items[i].name, value ? value : "??");
+        if (sb.data)
+            debug_client_output(debug_client, DEBUG_OUTPUT_NORMAL, sb.data);
+        free(sb.data);
+        free(value);
+    }
+    return S_OK;
+}
