+static HRESULT STDMETHODCALLTYPE dbg_breakpoint_SetOffsetExpression(IDebugBreakpoint2 *iface, const char *expression)
+{
+    struct dbg_breakpoint *bp = impl_from_IDebugBreakpoint2(iface);
+    char *copy = NULL;
+    DEBUG_VALUE value;
+
+    TRACE("%p, %s.\n", iface, debugstr_a(expression));
+    if (!expression)
+        return E_INVALIDARG;
+    if (!(copy = strdup(expression)))
+        return E_OUTOFMEMORY;
+    free(bp->offset_expression);
+    bp->offset_expression = copy;
+    /* an expression that cannot be resolved yet leaves the breakpoint deferred */
+    if (SUCCEEDED(debug_client_evaluate(bp->client, expression, DEBUG_VALUE_INT64, &value, NULL)))
