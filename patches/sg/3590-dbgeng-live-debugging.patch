+/* the text also goes to the log file when one is open and the log mask asks for it */
+static void debug_client_log_write(struct debug_client *debug_client, const char *text)
+{
+    DWORD written;
+
+    if (!debug_client->log_file || debug_client->log_file == INVALID_HANDLE_VALUE)
+        return;
+    if (debug_client->log_flags & DEBUG_LOG_UNICODE)
+    {
+        WCHAR *wide = debug_strdup_acp(text);
+
+        if (wide)
+            WriteFile(debug_client->log_file, wide, wcslen(wide) * sizeof(WCHAR), &written, NULL);
+        free(wide);
+    }
+    else
+        WriteFile(debug_client->log_file, text, strlen(text), &written, NULL);
+}
+
+static void debug_client_close_log(struct debug_client *debug_client)
+{
+    if (debug_client->log_file && debug_client->log_file != INVALID_HANDLE_VALUE)
+        CloseHandle(debug_client->log_file);
+    debug_client->log_file = NULL;
+    free(debug_client->log_name);
+    debug_client->log_name = NULL;
+    debug_client->log_flags = 0;
+}
+
+static HRESULT debug_client_open_log(struct debug_client *debug_client, const char *name, ULONG flags)
+{
+    DWORD written;
+    HANDLE file;
+
+    if (!name)
+        return E_INVALIDARG;
+    file = CreateFileA(name, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+            (flags & DEBUG_LOG_APPEND) ? OPEN_ALWAYS : CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (SetFilePointer(file, 0, NULL, FILE_END) == 0 && (flags & DEBUG_LOG_UNICODE))
+    {
+        WCHAR bom = 0xfeff;
+
+        WriteFile(file, &bom, sizeof(bom), &written, NULL);
+    }
+    debug_client_close_log(debug_client);
+    debug_client->log_file = file;
+    debug_client->log_flags = flags;
+    if (!(debug_client->log_name = strdup(name)))
+    {
+        debug_client_close_log(debug_client);
+        return E_OUTOFMEMORY;
+    }
+    return S_OK;
+}
