+static void debug_dump_line_prefix(struct strbuf *sb, BOOL is64, ULONG64 address)
+{
+    char buf[32];
+
+    debug_format_address(is64, address, buf, sizeof(buf));
+    strbuf_append(sb, "%s  ", buf);
+}
+
+static HRESULT debug_cmd_dump(struct debug_client *debug_client, const char *cmd, char *args)
+{
+    struct target_process *target = debug_client_get_target(debug_client);
+    BOOL is64 = debug_client_is_64(debug_client);
+    unsigned int unit, per_line;
+    ULONG64 address, count = 0;
+    struct strbuf sb = { 0 };
+    const char *rest;
+    char type = cmd[1];
+    HRESULT hr;
+    char *l;
+
+    if (!target || !target->handle)
+        return E_UNEXPECTED;
+    args = debug_skip_blanks(args);
+    if (!*args)
+        return E_INVALIDARG;
+    /* a count follows an "L" word */
+    if ((l = strstr(args, " L")) || (l = strstr(args, "\tL")))
+    {
+        *l = 0;
+        if (FAILED(hr = debug_eval_value(debug_client, l + 2, &count)))
+            return hr;
+    }
+    if (FAILED(hr = debug_eval_prefix(debug_client, args, &address, &rest)))
+        return hr;
+    switch (type)
+    {
+    case 'b': unit = 1; per_line = 16; if (!count) count = 128; break;
+    case 'w': unit = 2; per_line = 8; if (!count) count = 64; break;
+    case 'c': unit = 4; per_line = 4; if (!count) count = 32; break;
+    case 'd': unit = 4; per_line = 4; if (!count) count = 32; break;
+    case 'q': unit = 8; per_line = 2; if (!count) count = 16; break;
+    case 'p': unit = is64 ? 8 : 4; per_line = is64 ? 2 : 4; if (!count) count = is64 ? 16 : 32; break;
+    case 'a':
+    case 'u':
+    {
+        char data[260];
+        SIZE_T got = 0;
+        unsigned int i, max = 256;
+
+        if (type == 'u')
+        {
+            WCHAR w[130];
+            char line[300];
+
+            if (!ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)address, w, sizeof(w) - sizeof(WCHAR), &got))
+                got = 0;
+            got /= sizeof(WCHAR);
+            w[got] = 0;
+            debug_dump_line_prefix(&sb, is64, address);
+            WideCharToMultiByte(CP_ACP, 0, w, -1, line, sizeof(line), NULL, NULL);
+            strbuf_append(&sb, got ? "\"%s\"\n" : "????\n", line);
+        }
+        else
+        {
+            if (!ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)address, data, max, &got))
+                got = 0;
+            data[got] = 0;
+            for (i = 0; i < got; ++i)
+                if (data[i] && (data[i] < 32 || data[i] > 126))
+                    data[i] = '.';
+            debug_dump_line_prefix(&sb, is64, address);
+            strbuf_append(&sb, got ? "\"%s\"\n" : "????\n", data);
+        }
+        debug_client_output(debug_client, DEBUG_OUTPUT_NORMAL, sb.data);
+        free(sb.data);
+        return S_OK;
+    }
+    default:
+        return E_INVALIDARG;
+    }
+    {
+        ULONG64 total = count * unit, pos;
+
+        for (pos = 0; pos < total; )
+        {
+            unsigned char line[16];
+            unsigned int i, avail;
+            SIZE_T got = 0;
+            unsigned int n = min((ULONG64)unit * per_line, total - pos);
+
+            debug_dump_line_prefix(&sb, is64, address + pos);
+            memset(line, 0, sizeof(line));
+            ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)(address + pos), line, n, &got);
+            avail = got;
+            for (i = 0; i < n; i += unit)
+            {
+                if (i + unit > avail)
+                {
+                    strbuf_append(&sb, "%.*s ", unit * 2, "????????????????");
+                    continue;
+                }
+                if (unit == 1)
+                    strbuf_append(&sb, "%02x%s", line[i], i == 7 ? "-" : " ");
+                else if (unit == 2)
+                    strbuf_append(&sb, "%04x ", *(unsigned short *)&line[i]);
+                else if (unit == 4)
+                    strbuf_append(&sb, "%08x ", *(unsigned int *)&line[i]);
+                else
+                    strbuf_append(&sb, "%08x`%08x ", *(unsigned int *)&line[i + 4], *(unsigned int *)&line[i]);
+            }
+            if (type == 'b' || type == 'c')
+            {
+                strbuf_append(&sb, " ");
+                for (i = 0; i < n; ++i)
+                    strbuf_append(&sb, "%c", i < avail && line[i] >= 32 && line[i] < 127 ? line[i] : '.');
+            }
+            strbuf_append(&sb, "\n");
+            pos += n;
+        }
+    }
+    debug_client_output(debug_client, DEBUG_OUTPUT_NORMAL, sb.data);
+    free(sb.data);
+    return S_OK;
+}
