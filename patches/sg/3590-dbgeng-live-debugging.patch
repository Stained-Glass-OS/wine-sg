+static BOOL debug_ctx_get_register(const CONTEXT *ctx, const char *name, ULONG64 *value)
+{
+    unsigned int i;
+
+    if (*name == '@')
+        ++name;
+    if (!stricmp(name, "$ip") || !stricmp(name, "$exentry"))
+    {
+        *value = CTX_IP(ctx);
+        return TRUE;
+    }
+    if (!stricmp(name, "$sp") || !stricmp(name, "$csp"))
+    {
+        *value = CTX_SP(ctx);
+        return TRUE;
+    }
+    if (!stricmp(name, "$fp"))
+    {
+        *value = CTX_FP(ctx);
+        return TRUE;
+    }
+    for (i = 0; i < ARRAY_SIZE(ctx_registers); ++i)
+    {
+        ULONG64 v = 0;
+
+        if (!ctx_registers[i].name || stricmp(ctx_registers[i].name, name))
+            continue;
+        memcpy(&v, (const char *)ctx + ctx_registers[i].offset, min(ctx_registers[i].size, sizeof(v)));
+        if (ctx_registers[i].size == 1 && ctx_registers[i].shift)
+            v >>= ctx_registers[i].shift;
+        *value = ctx_registers[i].size == 1 ? v & 0xff : ctx_registers[i].size == 2 ? v & 0xffff : v;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL debug_ctx_set_register(CONTEXT *ctx, const char *name, ULONG64 value)
+{
+    unsigned int i;
+
+    if (*name == '@')
+        ++name;
+    for (i = 0; i < ARRAY_SIZE(ctx_registers); ++i)
+    {
+        char *field;
+
+        if (!ctx_registers[i].name || stricmp(ctx_registers[i].name, name))
+            continue;
+        field = (char *)ctx + ctx_registers[i].offset;
+        if (ctx_registers[i].size == 1)
+        {
+            field += ctx_registers[i].shift ? 1 : 0;
+            *field = value;
+        }
+        else
+        {
+            ULONG64 zero = 0;
+
+            /* writing a 32-bit register clears the upper half like the processor does */
+            if (ctx_registers[i].size == 4 && sizeof(void *) == 8 && name[0] == 'e' && stricmp(name, "eflags"))
+                memcpy(field + 4, &zero, 4);
+            memcpy(field, &value, ctx_registers[i].size);
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
