+/* ---- live debugging ---- */
+static void debug_target_invalidate_modules(struct target_process *target)
+{
+    free(target->modules.info);
+    target->modules.info = NULL;
+    target->modules.loaded = target->modules.unloaded = 0;
+    target->modules.initialized = FALSE;
+}
+
+static void debug_target_remove_breakpoints(struct target_process *target)
+{
+    struct dbg_breakpoint *bp;
+
+    if (!target->client || !target->handle)
+        return;
+    LIST_FOR_EACH_ENTRY(bp, &target->client->breakpoints, struct dbg_breakpoint, entry)
+    {
+        if (!bp->inserted)
+            continue;
+        WriteProcessMemory(target->handle, (void *)(ULONG_PTR)bp->offset, &bp->original, 1, NULL);
+        FlushInstructionCache(target->handle, (void *)(ULONG_PTR)bp->offset, 1);
+        bp->inserted = FALSE;
+        bp->was_inserted = TRUE;
+    }
+}
+
+static void debug_target_insert_breakpoints(struct target_process *target)
+{
+    struct dbg_breakpoint *bp;
+    static const unsigned char int3 = 0xcc;
+
+    if (!target->client || !target->handle)
+        return;
+    LIST_FOR_EACH_ENTRY(bp, &target->client->breakpoints, struct dbg_breakpoint, entry)
+    {
+        bp->was_inserted = FALSE;
+        if (bp->inserted || bp->type != DEBUG_BREAKPOINT_CODE || !(bp->flags & DEBUG_BREAKPOINT_ENABLED)
+                || (bp->flags & DEBUG_BREAKPOINT_DEFERRED) || bp->offset == DEBUG_INVALID_OFFSET)
+            continue;
+        if (!ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)bp->offset, &bp->original, 1, NULL))
+            continue;
+        if (!WriteProcessMemory(target->handle, (void *)(ULONG_PTR)bp->offset, &int3, 1, NULL))
+            continue;
+        FlushInstructionCache(target->handle, (void *)(ULONG_PTR)bp->offset, 1);
+        bp->inserted = TRUE;
+    }
+}
+
+struct dll_info
+{
+    char path[MAX_PATH];
+    char name[64];
+    ULONG size, checksum, timestamp;
+};
+
+static void debug_path_to_module_name(const char *path, char *name, size_t size)
+{
+    const char *base = path, *p, *dot;
+    size_t n;
+
+    for (p = path; *p; ++p)
+        if (*p == '\\' || *p == '/')
+            base = p + 1;
+    dot = strrchr(base, '.');
+    n = dot && dot > base ? dot - base : strlen(base);
+    snprintf(name, size, "%.*s", (int)n, base);
+}
+
+static void debug_target_image_info(struct target_process *target, ULONG64 base, HANDLE file, struct dll_info *info)
+{
+    IMAGE_DOS_HEADER dos;
+    DWORD pe_offset;
+    unsigned char header[0x60];
+
+    memset(info, 0, sizeof(*info));
+    if (file && file != INVALID_HANDLE_VALUE)
+    {
+        DWORD len = GetFinalPathNameByHandleA(file, info->path, sizeof(info->path), 0);
+
+        if (len && len < sizeof(info->path))
+        {
+            if (!strncmp(info->path, "\\\\?\\", 4))
+                memmove(info->path, info->path + 4, strlen(info->path + 4) + 1);
+        }
+        else
+            info->path[0] = 0;
+    }
+    if (!info->path[0] && base && target->handle)
+    {
+        HMODULE module = (HMODULE)(ULONG_PTR)base;
+
+        GetModuleFileNameExA(target->handle, module, info->path, sizeof(info->path));
+    }
+    debug_path_to_module_name(info->path, info->name, sizeof(info->name));
+    if (!base || !target->handle || !ReadProcessMemory(target->handle, (void *)(ULONG_PTR)base, &dos, sizeof(dos), NULL)
+            || dos.e_magic != IMAGE_DOS_SIGNATURE)
+        return;
+    pe_offset = dos.e_lfanew;
+    if (!ReadProcessMemory(target->handle, (char *)(ULONG_PTR)base + pe_offset, header, sizeof(header), NULL))
+        return;
+    info->timestamp = *(DWORD *)(header + 8);
+    info->size = *(DWORD *)(header + 24 + 56);
+    info->checksum = *(DWORD *)(header + 24 + 64);
+}
+
+/* the callbacks of the client, preferring the context flavour, then the wide one */
+struct event_sink
+{
+    IDebugEventCallbacks *a;
+    IDebugEventCallbacksWide *w;
+    IDebugEventContextCallbacks *x;
+    ULONG mask;
+};
+
+static void debug_client_get_sink(struct debug_client *debug_client, struct event_sink *sink)
+{
+    memset(sink, 0, sizeof(*sink));
+    if (debug_client->event_context_callbacks)
+    {
+        sink->x = debug_client->event_context_callbacks;
+        sink->x->lpVtbl->GetInterestMask(sink->x, &sink->mask);
+    }
+    else if (debug_client->event_callbacks_wide)
+    {
+        sink->w = debug_client->event_callbacks_wide;
+        sink->w->lpVtbl->GetInterestMask(sink->w, &sink->mask);
+    }
+    else if (debug_client->event_callbacks)
+    {
+        sink->a = debug_client->event_callbacks;
+        sink->a->lpVtbl->GetInterestMask(sink->a, &sink->mask);
+    }
+}
+
+static BOOL debug_sink_wants(const struct event_sink *sink, ULONG event)
+{
+    return (sink->a || sink->w || sink->x) && (sink->mask & event);
+}
+
+static void debug_exception_record64(const EXCEPTION_RECORD *src, EXCEPTION_RECORD64 *dst)
+{
+    unsigned int i;
+
+    memset(dst, 0, sizeof(*dst));
+    dst->ExceptionCode = src->ExceptionCode;
+    dst->ExceptionFlags = src->ExceptionFlags;
+    dst->ExceptionRecord = (ULONG_PTR)src->ExceptionRecord;
+    dst->ExceptionAddress = (ULONG_PTR)src->ExceptionAddress;
+    dst->NumberParameters = src->NumberParameters;
+    for (i = 0; i < src->NumberParameters && i < EXCEPTION_MAXIMUM_PARAMETERS; ++i)
+        dst->ExceptionInformation[i] = src->ExceptionInformation[i];
+}
+
+static const char *debug_exception_name(struct debug_client *debug_client, ULONG code, char *tmp, size_t size)
+{
+    unsigned int i;
+
+    for (i = ARRAY_SIZE(debug_default_events); i < debug_client->filter_count; ++i)
+        if (debug_client->filters[i].code == code && debug_client->filters[i].text)
+            return debug_client->filters[i].text;
+    snprintf(tmp, size, "Exception");
+    return tmp;
+}
+
+static void debug_client_set_current_thread(struct debug_client *debug_client, DWORD tid)
+{
+    ULONG id;
+
+    if (SUCCEEDED(debug_client_get_thread_id_by_sysid(debug_client, tid, &id)))
+        debug_client->current_thread = id;
+}
+
+static HRESULT debug_target_set_trap_flag(struct target_process *target, DWORD tid)
+{
+    HANDLE thread;
+    CONTEXT ctx;
+    HRESULT hr = S_OK;
+
+    if (!(thread = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.ContextFlags = CONTEXT_CONTROL;
+    if (!GetThreadContext(thread, &ctx))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+    {
+        ctx.EFlags |= 0x100;
+        if (!SetThreadContext(thread, &ctx))
+            hr = HRESULT_FROM_WIN32(GetLastError());
+    }
+    CloseHandle(thread);
+    return hr;
+}
+
+static ULONG64 debug_thread_ip(DWORD tid, BOOL set, ULONG64 value)
+{
+    HANDLE thread;
+    CONTEXT ctx;
+    ULONG64 ip = 0;
+
+    if (!(thread = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid)))
+        return 0;
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.ContextFlags = CONTEXT_CONTROL;
+    if (GetThreadContext(thread, &ctx))
+    {
+        ip = CTX_IP(&ctx);
+        if (set)
+        {
+            CTX_IP(&ctx) = value;
+            SetThreadContext(thread, &ctx);
+        }
+    }
+    CloseHandle(thread);
+    return ip;
+}
