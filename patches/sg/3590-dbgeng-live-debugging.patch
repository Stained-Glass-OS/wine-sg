+/* ---- symbol groups ---- */
+struct sym_group_item
+{
+    char *name;
+    ULONG64 module;
+    ULONG type_id;
+    ULONG64 address;
+    ULONG size;
+    ULONG flags;
+    ULONG parent;
+    ULONG sub;
+    ULONG reg;
+    BOOL is_register;
+};
+
+struct sym_group
+{
+    IDebugSymbolGroup2 IDebugSymbolGroup2_iface;
+    LONG refcount;
+    IDebugClient7 *client;
+    struct sym_group_item *items;
+    unsigned int count, capacity;
+};
+
+static const IDebugSymbolGroup2Vtbl sym_group_vtbl;
+
+static struct sym_group *impl_from_IDebugSymbolGroup2(IDebugSymbolGroup2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct sym_group, IDebugSymbolGroup2_iface);
+}
+
+static HRESULT sym_group_insert(struct sym_group *group, unsigned int pos, const struct sym_group_item *item)
+{
+    if (group->count == group->capacity)
+    {
+        unsigned int cap = group->capacity ? group->capacity * 2 : 16;
+        void *tmp = realloc(group->items, cap * sizeof(*group->items));
+
+        if (!tmp)
+            return E_OUTOFMEMORY;
+        group->items = tmp;
+        group->capacity = cap;
+    }
+    if (pos > group->count)
+        pos = group->count;
+    memmove(&group->items[pos + 1], &group->items[pos], (group->count - pos) * sizeof(*group->items));
+    group->items[pos] = *item;
+    ++group->count;
+    /* the parents after the new item moved down */
+    {
+        unsigned int i;
+
+        for (i = pos + 1; i < group->count; ++i)
+            if (group->items[i].parent != DEBUG_ANY_ID && group->items[i].parent >= pos)
+                ++group->items[i].parent;
+    }
+    return S_OK;
+}
+
+static void sym_group_remove(struct sym_group *group, unsigned int index)
+{
+    unsigned int end = index + 1, i;
+
+    /* children follow their parent */
+    while (end < group->count && group->items[end].parent != DEBUG_ANY_ID && group->items[end].parent >= index
+            && group->items[end].parent < end)
+        ++end;
+    for (i = index; i < end; ++i)
+        free(group->items[i].name);
+    memmove(&group->items[index], &group->items[end], (group->count - end) * sizeof(*group->items));
+    group->count -= end - index;
+    for (i = index; i < group->count; ++i)
+        if (group->items[i].parent != DEBUG_ANY_ID && group->items[i].parent >= end)
+            group->items[i].parent -= end - index;
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_QueryInterface(IDebugSymbolGroup2 *iface, REFIID riid, void **obj)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDebugSymbolGroup))
+    {
+        *obj = &group->IDebugSymbolGroup2_iface;
+        InterlockedIncrement(&group->refcount);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE sym_group_AddRef(IDebugSymbolGroup2 *iface)
+{
+    return InterlockedIncrement(&impl_from_IDebugSymbolGroup2(iface)->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE sym_group_Release(IDebugSymbolGroup2 *iface)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    ULONG refcount = InterlockedDecrement(&group->refcount);
+    unsigned int i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < group->count; ++i)
+            free(group->items[i].name);
+        free(group->items);
+        if (group->client)
+            group->client->lpVtbl->Release(group->client);
+        free(group);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_GetNumberSymbols(IDebugSymbolGroup2 *iface, ULONG *number)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+
+    TRACE("%p, %p.\n", iface, number);
+
+    if (!number)
+        return E_POINTER;
+    *number = group->count;
+    return S_OK;
+}
+
+static void sym_group_fill_children(struct sym_group *group, HANDLE process, struct sym_group_item *item)
+{
+    DWORD count = 0, tag, resolved = sym_resolve_typedef(process, item->module, item->type_id);
+    DWORD elem = 0;
+
+    item->sub = 0;
+    tag = sym_type_tag(process, item->module, resolved);
+    if (tag == SymTagUDT && SymGetTypeInfo(process, item->module, resolved, TI_GET_CHILDRENCOUNT, &count))
+    {
+        TI_FINDCHILDREN_PARAMS *children;
+        DWORD i;
+
+        if (count && (children = calloc(1, sizeof(*children) + count * sizeof(DWORD))))
+        {
+            children->Count = count;
+            if (SymGetTypeInfo(process, item->module, resolved, TI_FINDCHILDREN, children))
+                for (i = 0; i < count; ++i)
+                    if (sym_type_tag(process, item->module, children->ChildId[i]) == 7)
+                        ++item->sub;
+            free(children);
+        }
+    }
+    else if (tag == SymTagPointerType && SymGetTypeInfo(process, item->module, resolved, TI_GET_TYPE, &elem))
+        item->sub = sym_type_tag(process, item->module, sym_resolve_typedef(process, item->module, elem)) == SymTagUDT;
+    else if (tag == SymTagArrayType && SymGetTypeInfo(process, item->module, resolved, TI_GET_COUNT, &count))
+        item->sub = count > 64 ? 64 : count;
+    if (tag == SymTagArrayType)
+        item->flags |= 4; /* DEBUG_SYMBOL_IS_ARRAY */
+    if (tag == SymTagBaseType)
+    {
+        DWORD basic = 0;
+
+        SymGetTypeInfo(process, item->module, resolved, TI_GET_BASETYPE, &basic);
+        if (basic == 8)
+            item->flags |= 8; /* DEBUG_SYMBOL_IS_FLOAT */
+    }
+}
+
+static HRESULT sym_group_add_name(struct sym_group *group, const char *name, ULONG *index)
+{
+    struct debug_client *debug_client = impl_from_IDebugClient((IDebugClient7 *)group->client);
+    struct sym_group_item item = { 0 };
+    struct sym_buffer buf;
+    HANDLE process;
+    HRESULT hr;
+    ULONG pos = index && *index != DEBUG_ANY_ID ? *index : group->count;
+
+    if (!name || !*name)
+        return E_INVALIDARG;
+    if (FAILED(hr = sym_lookup_name(debug_client, name, &buf, &process)))
+        return hr;
+    if (pos > group->count)
+        pos = group->count;
+    item.name = strdup(name);
+    item.module = buf.info.ModBase;
+    item.type_id = buf.info.TypeIndex;
+    item.address = buf.info.Address;
+    item.size = buf.info.Size;
+    item.parent = DEBUG_ANY_ID;
+    if (!item.name)
+        return E_OUTOFMEMORY;
+    if (buf.info.TypeIndex)
+        sym_group_fill_children(group, process, &item);
+    if (FAILED(hr = sym_group_insert(group, pos, &item)))
+    {
+        free(item.name);
+        return hr;
+    }
+    if (index)
+        *index = pos;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_AddSymbol(IDebugSymbolGroup2 *iface, const char *name, ULONG *index)
+{
+    TRACE("%p, %s, %p.\n", iface, debugstr_a(name), index);
+
+    return sym_group_add_name(impl_from_IDebugSymbolGroup2(iface), name, index);
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_RemoveSymbolByName(IDebugSymbolGroup2 *iface, const char *name)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    unsigned int i;
+
+    TRACE("%p, %s.\n", iface, debugstr_a(name));
+
+    if (!name)
+        return E_INVALIDARG;
+    for (i = 0; i < group->count; ++i)
+    {
+        if (group->items[i].parent == DEBUG_ANY_ID && !strcmp(group->items[i].name, name))
+        {
+            sym_group_remove(group, i);
+            return S_OK;
+        }
+    }
+    return E_NOINTERFACE;
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_RemoveSymbolByIndex(IDebugSymbolGroup2 *iface, ULONG index)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+
+    TRACE("%p, %lu.\n", iface, index);
+
+    if (index >= group->count)
+        return E_INVALIDARG;
+    sym_group_remove(group, index);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_GetSymbolName(IDebugSymbolGroup2 *iface, ULONG index, char *buffer,
+        ULONG buffer_size, ULONG *name_size)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+
+    TRACE("%p, %lu, %p, %lu, %p.\n", iface, index, buffer, buffer_size, name_size);
+
+    if (index >= group->count)
+        return E_INVALIDARG;
+    return debug_target_return_string(group->items[index].name, buffer, buffer_size, name_size);
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_GetSymbolParameters(IDebugSymbolGroup2 *iface, ULONG start, ULONG count,
+        DEBUG_SYMBOL_PARAMETERS *params)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    ULONG i;
+
+    TRACE("%p, %lu, %lu, %p.\n", iface, start, count, params);
+
+    if (!params)
+        return E_POINTER;
+    if (start > group->count || count > group->count - start)
+        return E_INVALIDARG;
+    for (i = 0; i < count; ++i)
+    {
+        const struct sym_group_item *item = &group->items[start + i];
+        BOOL expanded = start + i + 1 < group->count && group->items[start + i + 1].parent == start + i;
+
+        memset(&params[i], 0, sizeof(params[i]));
+        params[i].Module = item->module;
+        params[i].TypeId = item->type_id;
+        params[i].ParentSymbol = item->parent;
+        params[i].SubElements = item->sub;
+        params[i].Flags = item->flags | (expanded ? 1 : 0);
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE sym_group_ExpandSymbol(IDebugSymbolGroup2 *iface, ULONG index, BOOL expand)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    struct debug_client *debug_client = impl_from_IDebugClient((IDebugClient7 *)group->client);
+    BOOL expanded;
+    HANDLE process;
+
+    TRACE("%p, %lu, %d.\n", iface, index, expand);
+
+    if (index >= group->count)
+        return E_INVALIDARG;
+    expanded = index + 1 < group->count && group->items[index + 1].parent == index;
+    if (!expand)
+    {
+        while (index + 1 < group->count && group->items[index + 1].parent == index)
+            sym_group_remove(group, index + 1);
+        return S_OK;
+    }
+    if (expanded)
+        return S_OK;
+    if (!group->items[index].sub)
+        return E_INVALIDARG;
+    if (!(process = debug_client_sym_handle(debug_client, NULL)))
+        return E_UNEXPECTED;
+    {
+        struct sym_group_item parent = group->items[index];
+        DWORD tag, resolved = sym_resolve_typedef(process, parent.module, parent.type_id);
+        unsigned int pos = index + 1;
+
+        tag = sym_type_tag(process, parent.module, resolved);
+        if (tag == SymTagUDT)
+        {
+            TI_FINDCHILDREN_PARAMS *children;
+            DWORD count = 0, i;
+
+            SymGetTypeInfo(process, parent.module, resolved, TI_GET_CHILDRENCOUNT, &count);
+            if (!count || !(children = calloc(1, sizeof(*children) + count * sizeof(DWORD))))
+                return E_FAIL;
+            children->Count = count;
+            if (SymGetTypeInfo(process, parent.module, resolved, TI_FINDCHILDREN, children))
+            {
+                for (i = 0; i < count; ++i)
+                {
+                    struct sym_group_item child = { 0 };
+                    DWORD off = 0, member_type = 0;
+
+                    if (sym_type_tag(process, parent.module, children->ChildId[i]) != 7
+                            || !SymGetTypeInfo(process, parent.module, children->ChildId[i], TI_GET_OFFSET, &off)
+                            || !SymGetTypeInfo(process, parent.module, children->ChildId[i], TI_GET_TYPEID, &member_type))
+                        continue;
+                    child.name = sym_member_name(process, parent.module, children->ChildId[i]);
+                    child.module = parent.module;
+                    child.type_id = member_type;
+                    child.address = parent.address + off;
+                    child.size = sym_type_length(process, parent.module, member_type);
+                    child.parent = index;
+                    sym_group_fill_children(group, process, &child);
+                    if (!child.name || FAILED(sym_group_insert(group, pos, &child)))
+                    {
+                        free(child.name);
+                        continue;
+                    }
+                    ++pos;
+                }
+            }
+            free(children);
+        }
+        else if (tag == SymTagPointerType)
+        {
+            struct target_process *target = debug_client_get_target(debug_client);
+            struct sym_group_item child = { 0 };
+            DWORD pointed = 0;
+            ULONG64 pointer = 0;
+
+            SymGetTypeInfo(process, parent.module, resolved, TI_GET_TYPE, &pointed);
+            ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)parent.address, &pointer,
+                    min(parent.size, sizeof(pointer)), NULL);
+            child.name = strdup("*");
+            child.module = parent.module;
+            child.type_id = pointed;
+            child.address = pointer;
+            child.size = sym_type_length(process, parent.module, pointed);
+            child.parent = index;
+            sym_group_fill_children(group, process, &child);
+            if (child.name && FAILED(sym_group_insert(group, pos, &child)))
+                free(child.name);
+        }
+        else if (tag == SymTagArrayType)
+        {
+            DWORD elem = 0, i, count = 0;
+            ULONG elem_size;
+
+            SymGetTypeInfo(process, parent.module, resolved, TI_GET_TYPE, &elem);
+            SymGetTypeInfo(process, parent.module, resolved, TI_GET_COUNT, &count);
+            elem_size = sym_type_length(process, parent.module, elem);
+            for (i = 0; i < count && i < 64; ++i)
+            {
+                struct sym_group_item child = { 0 };
+                char name[16];
+
+                snprintf(name, sizeof(name), "[%lu]", i);
+                child.name = strdup(name);
+                child.module = parent.module;
+                child.type_id = elem;
+                child.address = parent.address + i * elem_size;
+                child.size = elem_size;
+                child.parent = index;
+                sym_group_fill_children(group, process, &child);
+                if (!child.name || FAILED(sym_group_insert(group, pos, &child)))
+                {
+                    free(child.name);
+                    continue;
+                }
+                ++pos;
+            }
+        }
+    }
+    return S_OK;
+}
