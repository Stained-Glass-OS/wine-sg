+static HRESULT debug_cmd_near(struct debug_client *debug_client, char *args)
+{
+    BOOL is64 = debug_client_is_64(debug_client);
+    ULONG64 address, disp;
+    char *name, addr[32];
+    HRESULT hr;
+
+    if (FAILED(hr = debug_eval_value(debug_client, debug_skip_blanks(args), &address)))
+        return hr;
+    if (FAILED(hr = sym_name_by_offset(debug_client, address, &name, &disp)))
+        return hr;
+    debug_format_address(is64, address - disp, addr, sizeof(addr));
+    if (disp)
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "(%s)   %s+0x%I64x\n", addr, name, disp);
+    else
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "(%s)   %s\n", addr, name);
+    free(name);
+    return S_OK;
+}
