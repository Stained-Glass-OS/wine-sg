+static void sym_fill_entry(const SYMBOL_INFO *info, DEBUG_SYMBOL_ENTRY *entry)
+{
+    memset(entry, 0, sizeof(*entry));
+    entry->ModuleBase = info->ModBase;
+    entry->Offset = info->Address;
+    entry->Id = info->Index;
+    entry->Size = info->Size;
+    entry->TypeId = info->TypeIndex;
+    entry->NameSize = info->NameLen + 1;
+    entry->Tag = info->Tag;
+}
+
+static HRESULT debug_client_find_source(struct debug_client *debug_client, ULONG start, const char *file, ULONG flags,
+        ULONG *found_element, char **found)
+{
+    char *paths, *element, *save = NULL, *candidate;
+    const char *base_name, *p;
+    unsigned int index = 0;
+
+    if (!file || !*file)
+        return E_INVALIDARG;
+    if (!debug_client->source_path || !(paths = strdup(debug_client->source_path)))
+        paths = strdup("");
+    if (!paths)
+        return E_OUTOFMEMORY;
+    base_name = file;
+    for (p = file; *p; ++p)
+        if (*p == '\\' || *p == '/')
+            base_name = p + 1;
+
+    for (element = strtok_s(paths, ";", &save); element; element = strtok_s(NULL, ";", &save), ++index)
+    {
+        const char *attempts[2] = { file, base_name };
+        unsigned int a;
+
+        if (index < start)
+            continue;
+        for (a = 0; a < 2; ++a)
+        {
+            const char *rel = attempts[a];
+            size_t len = strlen(element) + strlen(rel) + 2;
+
+            if (a == 0 && (flags & 1 /* DEBUG_FIND_SOURCE_FULL_PATH */) == 0 && (rel[1] == ':' || rel[0] == '\\' || rel[0] == '/'))
+                continue;
+            if (!(candidate = malloc(len)))
+                continue;
+            snprintf(candidate, len, "%s\\%s", element, rel);
+            if (GetFileAttributesA(candidate) != INVALID_FILE_ATTRIBUTES)
+            {
+                if (found_element)
+                    *found_element = index;
+                *found = candidate;
+                free(paths);
+                return S_OK;
+            }
+            free(candidate);
+            if (a == 0 && !(flags & 2 /* DEBUG_FIND_SOURCE_BEST_MATCH */) && !(flags & 1))
+                break;
+        }
+    }
+    free(paths);
+    /* a file that exists at its own path is found as is */
+    if (GetFileAttributesA(file) != INVALID_FILE_ATTRIBUTES && (*found = strdup(file)))
+    {
+        if (found_element)
+            *found_element = DEBUG_ANY_ID;
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
