+static HRESULT debug_cmd_disasm(struct debug_client *debug_client, char *args)
+{
+    ULONG64 address = 0, count = 8, end;
+    HRESULT hr;
+    char *l;
+
+    args = debug_skip_blanks(args);
+    if ((l = strstr(args, " L")))
+    {
+        *l = 0;
+        if (FAILED(hr = debug_eval_value(debug_client, l + 2, &count)))
+            return hr;
+    }
+    if (*args)
+    {
+        if (FAILED(hr = debug_eval_value(debug_client, args, &address)))
+            return hr;
+    }
+    else
+    {
+        CONTEXT ctx;
+
+        if (FAILED(hr = debug_client_get_context(debug_client, &ctx)))
+            return hr;
+        address = CTX_IP(&ctx);
+    }
+    while (count--)
+    {
+        struct strbuf sb = { 0 };
+
+        if (FAILED(hr = debug_client_disasm_text(debug_client, address, DEBUG_DISASM_MATCHING_SYMBOLS, &sb, &end, NULL)))
+        {
+            free(sb.data);
+            return hr;
+        }
+        strbuf_append(&sb, "\n");
+        debug_client_output(debug_client, DEBUG_OUTPUT_NORMAL, sb.data);
+        free(sb.data);
+        address = end;
+    }
+    return S_OK;
+}
