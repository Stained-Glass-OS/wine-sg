+static HRESULT STDMETHODCALLTYPE sym_group_WriteSymbol(IDebugSymbolGroup2 *iface, ULONG index, const char *value)
+{
+    struct sym_group *group = impl_from_IDebugSymbolGroup2(iface);
+    struct debug_client *debug_client = impl_from_IDebugClient((IDebugClient7 *)group->client);
+    struct target_process *target = debug_client_get_target(debug_client);
+    ULONG64 v;
+    char *end;
+
+    TRACE("%p, %lu, %s.\n", iface, index, debugstr_a(value));
+
+    if (index >= group->count || !value)
+        return E_INVALIDARG;
+    if (!target || !target->handle)
+        return E_UNEXPECTED;
+    if (group->items[index].size > sizeof(v) || !group->items[index].size)
+        return E_INVALIDARG;
+    v = strtoull(value, &end, 0);
+    if (*end)
+        return E_INVALIDARG;
+    if (!WriteProcessMemory(target->handle, (void *)(ULONG_PTR)group->items[index].address, &v,
+            group->items[index].size, NULL))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return S_OK;
+}
