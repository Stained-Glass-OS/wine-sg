+/* ---- disassembly through capstone ---- */
+static cs_opt_mem debug_cs_mem =
+{
+    .malloc = malloc,
+    .calloc = calloc,
+    .realloc = realloc,
+    .free = free,
+    .vsnprintf = vsnprintf,
+};
+
+struct disasm_insn
+{
+    unsigned int size;
+    char mnemonic[32];
+    char operands[160];
+    unsigned char bytes[16];
+    BOOL has_effective;
+    ULONG64 effective;
+    BOOL is_call;
+};
