+static HRESULT debug_client_add_breakpoint(struct debug_client *debug_client, ULONG type, ULONG desired_id,
+        struct dbg_breakpoint **ret)
+{
+    struct dbg_breakpoint *bp;
+    ULONG id = desired_id;
+
+    if (type != DEBUG_BREAKPOINT_CODE && type != DEBUG_BREAKPOINT_DATA)
+        return E_INVALIDARG;
+    if (id == DEBUG_ANY_ID)
+    {
+        id = debug_client->next_breakpoint_id;
+        while (debug_client_find_breakpoint(debug_client, id))
+            ++id;
+        debug_client->next_breakpoint_id = id + 1;
+    }
+    else if (debug_client_find_breakpoint(debug_client, id))
+        return E_INVALIDARG;
+    if (!(bp = calloc(1, sizeof(*bp))))
+        return E_OUTOFMEMORY;
+    bp->client = debug_client;
+    bp->IDebugBreakpoint2_iface.lpVtbl = &dbg_breakpoint_vtbl;
+    bp->id = id;
+    bp->type = type;
+    bp->offset = DEBUG_INVALID_OFFSET;
+    bp->pass_count = bp->current_pass = 1;
+    bp->match_thread = DEBUG_ANY_ID;
+    list_add_tail(&debug_client->breakpoints, &bp->entry);
+    *ret = bp;
+    return S_OK;
+}
+
+static void debug_client_free_breakpoint(struct dbg_breakpoint *bp)
+{
+    list_remove(&bp->entry);
+    free(bp->command);
+    free(bp->offset_expression);
+    free(bp);
+}
