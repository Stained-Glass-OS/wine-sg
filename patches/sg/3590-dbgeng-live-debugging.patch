+static HRESULT debug_cmd_type(struct debug_client *debug_client, char *args)
+{
+    struct target_process *target;
+    struct sym_buffer buf;
+    HANDLE process;
+    ULONG64 base = 0, address = 0;
+    char *name, *sp, *bang;
+    unsigned int i;
+    HRESULT hr;
+
+    args = debug_skip_blanks(args);
+    while (args[0] == '-')
+    {
+        while (*args && *args != ' ')
+            ++args;
+        args = debug_skip_blanks(args);
+    }
+    if (!(process = debug_client_sym_handle(debug_client, &target)))
+        return E_UNEXPECTED;
+    name = args;
+    if ((sp = strpbrk(args, " \t")))
+    {
+        *sp++ = 0;
+        sp = debug_skip_blanks(sp);
+    }
+    if ((bang = strchr(name, '!')))
+    {
+        char module[128];
+
+        snprintf(module, sizeof(module), "%.*s", (int)min((size_t)(bang - name), sizeof(module) - 1), name);
+        if (FAILED(hr = debug_eval_value(debug_client, module, &base)))
+            return hr;
+        name = bang + 1;
+    }
+    sym_buffer_init(&buf);
+    if (base)
+        SymGetTypeFromName(process, base, name, &buf.info);
+    else
+    {
+        for (i = 0; i < target->modules.loaded && !buf.info.TypeIndex; ++i)
+        {
+            sym_buffer_init(&buf);
+            if (SymGetTypeFromName(process, target->modules.info[i].params.Base, name, &buf.info))
+                break;
+            buf.info.TypeIndex = 0;
+        }
+    }
+    if (!buf.info.TypeIndex)
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "Symbol %s not found.\n", name);
+        return E_FAIL;
+    }
+    if (sp && *sp)
+    {
+        if (FAILED(hr = debug_eval_value(debug_client, sp, &address)))
+            return hr;
+        return debugsymbols_OutputTypedDataVirtual(&debug_client->IDebugSymbols3_iface, 0, address, buf.info.ModBase,
+                buf.info.TypeIndex, 0);
+    }
+    {
+        struct strbuf sb = { 0 };
+        TI_FINDCHILDREN_PARAMS *children;
+        DWORD count = 0;
+        char *tname = sym_type_name(process, buf.info.ModBase, buf.info.TypeIndex, 0);
+
+        strbuf_append(&sb, "%s\n", tname ? tname : name);
+        free(tname);
+        if (SymGetTypeInfo(process, buf.info.ModBase, buf.info.TypeIndex, TI_GET_CHILDRENCOUNT, &count) && count
+                && (children = calloc(1, sizeof(*children) + count * sizeof(DWORD))))
+        {
+            children->Count = count;
+            if (SymGetTypeInfo(process, buf.info.ModBase, buf.info.TypeIndex, TI_FINDCHILDREN, children))
+            {
+                for (i = 0; i < count; ++i)
+                {
+                    DWORD off = 0, member_type = 0;
+                    char *member = sym_member_name(process, buf.info.ModBase, children->ChildId[i]);
+                    char *member_type_name;
+
+                    if (sym_type_tag(process, buf.info.ModBase, children->ChildId[i]) != 7
+                            || !SymGetTypeInfo(process, buf.info.ModBase, children->ChildId[i], TI_GET_OFFSET, &off)
+                            || !SymGetTypeInfo(process, buf.info.ModBase, children->ChildId[i], TI_GET_TYPEID, &member_type))
+                    {
+                        free(member);
+                        continue;
+                    }
+                    member_type_name = sym_type_name(process, buf.info.ModBase, member_type, 0);
+                    strbuf_append(&sb, "   +0x%03lx %-20s : %s\n", off, member ? member : "?",
+                            member_type_name ? member_type_name : "?");
+                    free(member);
+                    free(member_type_name);
+                }
+            }
+            free(children);
+        }
+        debug_client_output(debug_client, DEBUG_OUTPUT_NORMAL, sb.data);
+        free(sb.data);
+    }
+    return S_OK;
+}
