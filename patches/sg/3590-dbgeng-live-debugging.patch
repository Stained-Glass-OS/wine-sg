+static HRESULT debug_client_init_filters(struct debug_client *debug_client)
+{
+    unsigned int i, n_events = ARRAY_SIZE(debug_default_events), n_exc = ARRAY_SIZE(debug_default_exceptions);
+
+    if (debug_client->filters)
+        return S_OK;
+    if (!(debug_client->filters = calloc(n_events + n_exc, sizeof(*debug_client->filters))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < n_events + n_exc; ++i)
+    {
+        const struct default_filter *def = i < n_events ? &debug_default_events[i]
+                : &debug_default_exceptions[i - n_events];
+
+        debug_client->filters[i].exec = def->exec;
+        debug_client->filters[i].cont = def->cont;
+        debug_client->filters[i].code = def->code;
+        debug_client->filters[i].abbrev = def->abbrev;
+        debug_client->filters[i].text = def->text;
+    }
+    debug_client->filter_count = n_events + n_exc;
+    debug_client->filter_exceptions = n_exc;
+    return S_OK;
+}
