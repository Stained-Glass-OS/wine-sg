+static char *sym_group_value_text(struct sym_group *group, unsigned int index)
+{
+    struct debug_client *debug_client = impl_from_IDebugClient((IDebugClient7 *)group->client);
+    const struct sym_group_item *item = &group->items[index];
+    struct target_process *target = debug_client_get_target(debug_client);
+    struct strbuf sb = { 0 };
+    unsigned char data[64] = { 0 };
+    HANDLE process;
+    SIZE_T read = 0;
+
+    if (!(process = debug_client_sym_handle(debug_client, NULL)) || !target)
+        return NULL;
+    if (!item->type_id || !item->size || item->size > sizeof(data)
+            || !ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)item->address, data, item->size, &read)
+            || read != item->size)
+        return strdup("??");
+    sym_format_value(process, item->module, item->type_id, data, item->size, &sb);
+    return sb.data ? sb.data : strdup("");
+}
