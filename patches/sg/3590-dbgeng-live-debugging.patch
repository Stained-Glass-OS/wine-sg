+static struct dbg_breakpoint *debug_client_breakpoint_at(struct debug_client *debug_client, ULONG64 address)
+{
+    struct dbg_breakpoint *bp;
+
+    LIST_FOR_EACH_ENTRY(bp, &debug_client->breakpoints, struct dbg_breakpoint, entry)
+        if (bp->was_inserted && bp->offset == address)
+            return bp;
+    return NULL;
+}
+
+/* what the engine does with an event the callbacks did not decide */
+static BOOL debug_filter_breaks(struct debug_client *debug_client, unsigned int index, BOOL first_chance)
+{
+    const struct event_filter *filter;
+
+    if (FAILED(debug_client_init_filters(debug_client)))
+        return FALSE;
+    filter = &debug_client->filters[index];
+    if (filter->exec == DEBUG_FILTER_BREAK)
+        return TRUE;
+    return filter->exec == DEBUG_FILTER_SECOND_CHANCE_BREAK && !first_chance;
+}
+
+static void debug_client_record_event(struct debug_client *debug_client, ULONG type, DWORD pid, DWORD tid,
+        const char *description)
+{
+    struct dbg_last_event *ev = &debug_client->last_event;
+
+    memset(ev, 0, sizeof(*ev));
+    ev->valid = TRUE;
+    ev->type = type;
+    ev->pid = pid;
+    ev->tid = tid;
+    snprintf(ev->description, sizeof(ev->description), "%s", description);
+}
+
+/* handles one debug event; returns TRUE when the engine stops (the caller reports it) */
+static BOOL debug_client_handle_event(struct debug_client *debug_client, struct target_process *target,
+        DEBUG_EVENT *ev, DWORD *cont)
+{
+    struct event_sink sink;
+    ULONG status = DEBUG_STATUS_NO_CHANGE;
+    BOOL stop = FALSE;
+    struct dll_info info;
+    char text[300];
+
+    *cont = DBG_CONTINUE;
+    debug_client_get_sink(debug_client, &sink);
+    debug_client_init_filters(debug_client);
+
+    switch (ev->dwDebugEventCode)
+    {
+    case CREATE_PROCESS_DEBUG_EVENT:
+    {
+        const CREATE_PROCESS_DEBUG_INFO *i = &ev->u.CreateProcessInfo;
+        HANDLE thread_copy = NULL;
+
+        if (!target->handle)
+            DuplicateHandle(GetCurrentProcess(), i->hProcess, GetCurrentProcess(), &target->handle, 0, FALSE,
+                    DUPLICATE_SAME_ACCESS);
+        if (i->hThread)
+            DuplicateHandle(GetCurrentProcess(), i->hThread, GetCurrentProcess(), &thread_copy, 0, FALSE,
+                    DUPLICATE_SAME_ACCESS);
+        target->main_thread = thread_copy;
+        target->image_base = (ULONG_PTR)i->lpBaseOfImage;
+        target->created = TRUE;
+        debug_target_invalidate_modules(target);
+        debug_target_image_info(target, (ULONG_PTR)i->lpBaseOfImage, i->hFile, &info);
+        debug_client_set_current_thread(debug_client, ev->dwThreadId);
+        snprintf(text, sizeof(text), "Create process %s", info.path);
+        debug_client_record_event(debug_client, DEBUG_EVENT_CREATE_PROCESS, ev->dwProcessId, ev->dwThreadId, text);
+        if (debug_sink_wants(&sink, DEBUG_EVENT_CREATE_PROCESS))
+        {
+            if (sink.x)
+                status = sink.x->lpVtbl->CreateProcess(sink.x, (ULONG_PTR)i->hFile, (ULONG_PTR)target->handle,
+                        (ULONG_PTR)i->lpBaseOfImage, info.size, NULL, NULL, info.checksum, info.timestamp,
+                        (ULONG_PTR)i->hThread, (ULONG_PTR)i->lpThreadLocalBase, (ULONG_PTR)i->lpStartAddress, NULL, 0);
+            else if (sink.w)
+            {
+                WCHAR *name = debug_strdup_acp(info.name), *path = debug_strdup_acp(info.path);
+
+                status = sink.w->lpVtbl->CreateProcess(sink.w, (ULONG_PTR)i->hFile, (ULONG_PTR)target->handle,
+                        (ULONG_PTR)i->lpBaseOfImage, info.size, name, path, info.checksum, info.timestamp,
+                        (ULONG_PTR)i->hThread, (ULONG_PTR)i->lpThreadLocalBase, (ULONG_PTR)i->lpStartAddress);
+                free(name);
+                free(path);
+            }
+            else
+                status = sink.a->lpVtbl->CreateProcess(sink.a, (ULONG_PTR)i->hFile, (ULONG_PTR)target->handle,
+                        (ULONG_PTR)i->lpBaseOfImage, info.size, info.name, info.path, info.checksum, info.timestamp,
+                        (ULONG_PTR)i->hThread, (ULONG_PTR)i->lpThreadLocalBase, (ULONG_PTR)i->lpStartAddress);
+        }
+        if (i->hFile)
+            CloseHandle(i->hFile);
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_CREATE_PROCESS, TRUE);
+        break;
+    }
+    case CREATE_THREAD_DEBUG_EVENT:
+    {
+        const CREATE_THREAD_DEBUG_INFO *i = &ev->u.CreateThread;
+
+        snprintf(text, sizeof(text), "Create thread %lx", ev->dwThreadId);
+        debug_client_record_event(debug_client, DEBUG_EVENT_CREATE_THREAD, ev->dwProcessId, ev->dwThreadId, text);
+        if (debug_sink_wants(&sink, DEBUG_EVENT_CREATE_THREAD))
+        {
+            if (sink.x)
+                status = sink.x->lpVtbl->CreateThread(sink.x, (ULONG_PTR)i->hThread, (ULONG_PTR)i->lpThreadLocalBase,
+                        (ULONG_PTR)i->lpStartAddress, NULL, 0);
+            else if (sink.w)
+                status = sink.w->lpVtbl->CreateThread(sink.w, (ULONG_PTR)i->hThread, (ULONG_PTR)i->lpThreadLocalBase,
+                        (ULONG_PTR)i->lpStartAddress);
+            else
+                status = sink.a->lpVtbl->CreateThread(sink.a, (ULONG_PTR)i->hThread, (ULONG_PTR)i->lpThreadLocalBase,
+                        (ULONG_PTR)i->lpStartAddress);
+        }
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_CREATE_THREAD, TRUE);
+        break;
+    }
+    case EXIT_THREAD_DEBUG_EVENT:
+        snprintf(text, sizeof(text), "Exit thread %lx, code %lx", ev->dwThreadId, ev->u.ExitThread.dwExitCode);
+        debug_client_record_event(debug_client, DEBUG_EVENT_EXIT_THREAD, ev->dwProcessId, ev->dwThreadId, text);
+        if (debug_sink_wants(&sink, DEBUG_EVENT_EXIT_THREAD))
+        {
+            if (sink.x)
+                status = sink.x->lpVtbl->ExitThread(sink.x, ev->u.ExitThread.dwExitCode, NULL, 0);
+            else if (sink.w)
+                status = sink.w->lpVtbl->ExitThread(sink.w, ev->u.ExitThread.dwExitCode);
+            else
+                status = sink.a->lpVtbl->ExitThread(sink.a, ev->u.ExitThread.dwExitCode);
+        }
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_EXIT_THREAD, TRUE);
+        break;
+    case EXIT_PROCESS_DEBUG_EVENT:
+        target->exit_code = ev->u.ExitProcess.dwExitCode;
+        snprintf(text, sizeof(text), "Exit process %lx, code %lx", ev->dwProcessId, ev->u.ExitProcess.dwExitCode);
+        debug_client_record_event(debug_client, DEBUG_EVENT_EXIT_PROCESS, ev->dwProcessId, ev->dwThreadId, text);
+        if (debug_sink_wants(&sink, DEBUG_EVENT_EXIT_PROCESS))
+        {
+            if (sink.x)
+                status = sink.x->lpVtbl->ExitProcess(sink.x, ev->u.ExitProcess.dwExitCode, NULL, 0);
+            else if (sink.w)
+                status = sink.w->lpVtbl->ExitProcess(sink.w, ev->u.ExitProcess.dwExitCode);
+            else
+                status = sink.a->lpVtbl->ExitProcess(sink.a, ev->u.ExitProcess.dwExitCode);
+        }
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_EXIT_PROCESS, TRUE)
+                || (debug_client->engine_options & DEBUG_ENGOPT_FINAL_BREAK);
+        target->exited = TRUE;
+        break;
+    case LOAD_DLL_DEBUG_EVENT:
+    {
+        const LOAD_DLL_DEBUG_INFO *i = &ev->u.LoadDll;
+        BOOL first_module = !target->seen_initial_module;
+
+        debug_target_invalidate_modules(target);
+        debug_target_image_info(target, (ULONG_PTR)i->lpBaseOfDll, i->hFile, &info);
+        target->seen_initial_module = TRUE;
+        snprintf(text, sizeof(text), "Load module %s at %p", info.path, i->lpBaseOfDll);
+        debug_client_record_event(debug_client, DEBUG_EVENT_LOAD_MODULE, ev->dwProcessId, ev->dwThreadId, text);
+        if (target->dll_count < ARRAY_SIZE(target->dll_bases))
+        {
+            target->dll_bases[target->dll_count] = (ULONG_PTR)i->lpBaseOfDll;
+            snprintf(target->dll_names[target->dll_count], sizeof(target->dll_names[0]), "%s", info.name);
+            ++target->dll_count;
+        }
+        if (debug_sink_wants(&sink, DEBUG_EVENT_LOAD_MODULE))
+        {
+            if (sink.x)
+            {
+                WCHAR *name = debug_strdup_acp(info.name), *path = debug_strdup_acp(info.path);
+
+                status = sink.x->lpVtbl->LoadModule(sink.x, (ULONG_PTR)i->hFile, (ULONG_PTR)i->lpBaseOfDll, info.size,
+                        name, path, info.checksum, info.timestamp, NULL, 0);
+                free(name);
+                free(path);
+            }
+            else if (sink.w)
+            {
+                WCHAR *name = debug_strdup_acp(info.name), *path = debug_strdup_acp(info.path);
+
+                status = sink.w->lpVtbl->LoadModule(sink.w, (ULONG_PTR)i->hFile, (ULONG_PTR)i->lpBaseOfDll, info.size,
+                        name, path, info.checksum, info.timestamp);
+                free(name);
+                free(path);
+            }
+            else
+                status = sink.a->lpVtbl->LoadModule(sink.a, (ULONG_PTR)i->hFile, (ULONG_PTR)i->lpBaseOfDll, info.size,
+                        info.name, info.path, info.checksum, info.timestamp);
+        }
+        if (i->hFile)
+            CloseHandle(i->hFile);
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_LOAD_MODULE, TRUE)
+                || (first_module && ((debug_client->engine_options & DEBUG_ENGOPT_INITIAL_MODULE_BREAK)
+                || debug_filter_breaks(debug_client, DEBUG_FILTER_INITIAL_MODULE_LOAD, TRUE)));
+        if (debug_client->filters[DEBUG_FILTER_LOAD_MODULE].exec == DEBUG_FILTER_OUTPUT)
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "ModLoad: %p %s\n", i->lpBaseOfDll, info.path);
+        break;
+    }
+    case UNLOAD_DLL_DEBUG_EVENT:
+    {
+        ULONG64 base = (ULONG_PTR)ev->u.UnloadDll.lpBaseOfDll;
+        const char *name = "";
+        unsigned int k;
+
+        for (k = 0; k < target->dll_count; ++k)
+            if (target->dll_bases[k] == base)
+                name = target->dll_names[k];
+        snprintf(text, sizeof(text), "Unload module %s at %I64x", name, base);
+        debug_client_record_event(debug_client, DEBUG_EVENT_UNLOAD_MODULE, ev->dwProcessId, ev->dwThreadId, text);
+        if (debug_sink_wants(&sink, DEBUG_EVENT_UNLOAD_MODULE))
+        {
+            if (sink.x || sink.w)
+            {
+                WCHAR *wname = debug_strdup_acp(name);
+
+                if (sink.x)
+                    status = sink.x->lpVtbl->UnloadModule(sink.x, wname, base, NULL, 0);
+                else
+                    status = sink.w->lpVtbl->UnloadModule(sink.w, wname, base);
+                free(wname);
+            }
+            else
+                status = sink.a->lpVtbl->UnloadModule(sink.a, name, base);
+        }
+        if (target->sym_init)
+            SymUnloadModule64(target->handle, base);
+        debug_target_invalidate_modules(target);
+        target->sym_loaded = 0;
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_UNLOAD_MODULE, TRUE);
+        break;
+    }
+    case OUTPUT_DEBUG_STRING_EVENT:
+    {
+        const OUTPUT_DEBUG_STRING_INFO *i = &ev->u.DebugString;
+        unsigned int len = i->nDebugStringLength;
+        char *buf;
+
+        if (len > 0x10000)
+            len = 0x10000;
+        if ((buf = calloc(1, len * 2 + 4)))
+        {
+            SIZE_T got = 0;
+
+            ReadProcessMemory(target->handle, i->lpDebugStringData, buf, len * (i->fUnicode ? 2 : 1), &got);
+            if (i->fUnicode)
+            {
+                char *narrow = debug_strdup_acp_from_w((WCHAR *)buf);
+
+                free(buf);
+                buf = narrow;
+            }
+            if (buf && debug_client->filters[DEBUG_FILTER_DEBUGGEE_OUTPUT].exec != DEBUG_FILTER_IGNORE)
+                debug_client_output(debug_client, DEBUG_OUTPUT_DEBUGGEE, buf);
+            free(buf);
+        }
+        break;
+    }
+    case RIP_EVENT:
+        snprintf(text, sizeof(text), "System error %lx level %lx", ev->u.RipInfo.dwError, ev->u.RipInfo.dwType);
+        debug_client_record_event(debug_client, DEBUG_EVENT_SYSTEM_ERROR, ev->dwProcessId, ev->dwThreadId, text);
+        if (debug_sink_wants(&sink, DEBUG_EVENT_SYSTEM_ERROR))
+        {
+            if (sink.x)
+                status = sink.x->lpVtbl->SystemError(sink.x, ev->u.RipInfo.dwError, ev->u.RipInfo.dwType, NULL, 0);
+            else if (sink.w)
+                status = sink.w->lpVtbl->SystemError(sink.w, ev->u.RipInfo.dwError, ev->u.RipInfo.dwType);
+            else
+                status = sink.a->lpVtbl->SystemError(sink.a, ev->u.RipInfo.dwError, ev->u.RipInfo.dwType);
+        }
+        stop = debug_filter_breaks(debug_client, DEBUG_FILTER_SYSTEM_ERROR, TRUE);
+        break;
+    case EXCEPTION_DEBUG_EVENT:
+    {
+        const EXCEPTION_RECORD *rec = &ev->u.Exception.ExceptionRecord;
+        BOOL first_chance = ev->u.Exception.dwFirstChance;
+        struct dbg_breakpoint *bp = NULL;
+        EXCEPTION_RECORD64 rec64;
+        unsigned int index, i;
+        const char *name;
+        char tmp[32];
+
+        debug_exception_record64(rec, &rec64);
+        debug_client_set_current_thread(debug_client, ev->dwThreadId);
+
+        /* a single step that only gets over a breakpoint is not reported */
+        if (rec->ExceptionCode == EXCEPTION_SINGLE_STEP && target->step_over_bp)
+        {
+            target->step_over_bp = FALSE;
+            if (!target->stepping)
+                return FALSE;
+        }
+        if (rec->ExceptionCode == EXCEPTION_BREAKPOINT && first_chance)
+        {
+            ULONG64 address = (ULONG_PTR)rec->ExceptionAddress;
+
+            if ((bp = debug_client_breakpoint_at(debug_client, address)))
+            {
+                /* the instruction pointer is behind the int3 */
+                debug_thread_ip(ev->dwThreadId, TRUE, address);
+            }
+            else if (!target->seen_initial_break)
+            {
+                /* the loader's breakpoint: the engine stops on it only when asked to */
+                BOOL attach_stop = !(target->attach_flags & DEBUG_ATTACH_INVASIVE_NO_INITIAL_BREAK) && target->attached;
+
+                target->seen_initial_break = TRUE;
+                debug_client_record_event(debug_client, DEBUG_EVENT_EXCEPTION, ev->dwProcessId, ev->dwThreadId,
+                        "Break instruction exception - code 80000003 (first chance)");
+                debug_client->last_event.exception = rec64;
+                debug_client->last_event.first_chance = first_chance;
+                if (debug_sink_wants(&sink, DEBUG_EVENT_EXCEPTION))
+                {
+                    if (sink.x)
+                        status = sink.x->lpVtbl->Exception(sink.x, &rec64, first_chance, NULL, 0);
+                    else if (sink.w)
+                        status = sink.w->lpVtbl->Exception(sink.w, &rec64, first_chance);
+                    else
+                        status = sink.a->lpVtbl->Exception(sink.a, &rec64, first_chance);
+                }
+                stop = attach_stop || (debug_client->engine_options & DEBUG_ENGOPT_INITIAL_BREAK)
+                        || debug_filter_breaks(debug_client, DEBUG_FILTER_INITIAL_BREAKPOINT, TRUE);
+                *cont = DBG_CONTINUE;
+                goto decided;
+            }
+        }
+        if (bp)
+        {
+            BOOL hit = TRUE;
+
+            snprintf(text, sizeof(text), "Breakpoint %lu hit", bp->id);
+            debug_client_record_event(debug_client, DEBUG_EVENT_BREAKPOINT, ev->dwProcessId, ev->dwThreadId, text);
+            if (bp->match_thread != DEBUG_ANY_ID)
+            {
+                ULONG id;
+
+                hit = SUCCEEDED(debug_client_get_thread_id_by_sysid(debug_client, ev->dwThreadId, &id))
+                        && id == bp->match_thread;
+            }
+            if (hit && bp->current_pass > 1)
+            {
+                --bp->current_pass;
+                hit = FALSE;
+            }
+            if (!hit)
+            {
+                target->step_over_bp = TRUE;
+                target->stepping = FALSE;
+                debug_target_set_trap_flag(target, ev->dwThreadId);
+                return FALSE;
+            }
+            bp->current_pass = bp->pass_count;
+            if (debug_sink_wants(&sink, DEBUG_EVENT_BREAKPOINT))
+            {
+                if (sink.x)
+                    status = sink.x->lpVtbl->Breakpoint(sink.x, &bp->IDebugBreakpoint2_iface, NULL, 0);
+                else if (sink.w)
+                    status = sink.w->lpVtbl->Breakpoint(sink.w, (IDebugBreakpoint *)&bp->IDebugBreakpoint2_iface);
+                else
+                    status = sink.a->lpVtbl->Breakpoint(sink.a, (IDebugBreakpoint *)&bp->IDebugBreakpoint2_iface);
+            }
+            stop = !(bp->flags & DEBUG_BREAKPOINT_GO_ONLY) || TRUE;
+            if (bp->command)
+            {
+                debug_client->exec_status = DEBUG_STATUS_BREAK;
+                debug_execute_text(debug_client, bp->command);
+                if (debug_client->exec_status == DEBUG_STATUS_GO || debug_client->exec_status == DEBUG_STATUS_GO_HANDLED
+                        || debug_client->exec_status == DEBUG_STATUS_GO_NOT_HANDLED)
+                    stop = FALSE;
+            }
+            if (bp->flags & DEBUG_BREAKPOINT_ONE_SHOT)
+                bp->flags &= ~DEBUG_BREAKPOINT_ENABLED;
+            *cont = DBG_CONTINUE;
+            goto decided;
+        }
+
+        name = debug_exception_name(debug_client, rec->ExceptionCode, tmp, sizeof(tmp));
+        snprintf(text, sizeof(text), "%s - code %08lx (%s chance)", name, rec->ExceptionCode,
+                first_chance ? "first" : "second");
+        debug_client_record_event(debug_client, DEBUG_EVENT_EXCEPTION, ev->dwProcessId, ev->dwThreadId, text);
+        debug_client->last_event.exception = rec64;
+        debug_client->last_event.first_chance = first_chance;
+        if (debug_sink_wants(&sink, DEBUG_EVENT_EXCEPTION))
+        {
+            if (sink.x)
+                status = sink.x->lpVtbl->Exception(sink.x, &rec64, first_chance, NULL, 0);
+            else if (sink.w)
+                status = sink.w->lpVtbl->Exception(sink.w, &rec64, first_chance);
+            else
+                status = sink.a->lpVtbl->Exception(sink.a, &rec64, first_chance);
+        }
+        index = 0;
+        for (i = ARRAY_SIZE(debug_default_events); i < debug_client->filter_count; ++i)
+            if (debug_client->filters[i].code == rec->ExceptionCode)
+                index = i;
+        if (index)
+        {
+            stop = debug_filter_breaks(debug_client, index, first_chance);
+            if (debug_client->filters[index].exec == DEBUG_FILTER_OUTPUT)
+                debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "(%lx.%lx): %s\n", ev->dwProcessId, ev->dwThreadId, text);
+            *cont = debug_client->filters[index].cont == DEBUG_FILTER_GO_HANDLED ? DBG_CONTINUE
+                    : DBG_EXCEPTION_NOT_HANDLED;
+        }
+        else
+        {
+            stop = !first_chance;
+            *cont = DBG_EXCEPTION_NOT_HANDLED;
+        }
+        if (stop)
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "(%lx.%lx): %s\n", ev->dwProcessId, ev->dwThreadId, text);
+        break;
+    }
+    default:
+        break;
+    }
+decided:
+    /* a callback's answer overrides the filters */
+    if (status == DEBUG_STATUS_BREAK)
+        stop = TRUE;
+    else if (status == DEBUG_STATUS_GO || status == DEBUG_STATUS_GO_HANDLED || status == DEBUG_STATUS_IGNORE_EVENT)
+    {
+        stop = FALSE;
+        if (status != DEBUG_STATUS_GO)
+            *cont = DBG_CONTINUE;
+    }
+    else if (status == DEBUG_STATUS_GO_NOT_HANDLED)
+    {
+        stop = FALSE;
+        *cont = DBG_EXCEPTION_NOT_HANDLED;
+    }
+    else if (status == DEBUG_STATUS_STEP_INTO || status == DEBUG_STATUS_STEP_OVER || status == DEBUG_STATUS_STEP_BRANCH)
+    {
+        stop = FALSE;
+        target->stepping = TRUE;
+        debug_target_set_trap_flag(target, ev->dwThreadId);
+    }
+    return stop;
+}
+
+static HRESULT debug_client_wait_live(struct debug_client *debug_client, struct target_process *target, ULONG timeout)
+{
+    DEBUG_EVENT ev;
+
+    if (target->exited && !target->stopped)
+        return E_UNEXPECTED;
+
+    if (target->stopped)
+    {
+        DWORD cont = target->continue_status;
+
+        if (debug_client->exec_status == DEBUG_STATUS_BREAK || debug_client->exec_status == DEBUG_STATUS_NO_CHANGE)
+            return S_OK;
+        if (debug_client->exec_status == DEBUG_STATUS_GO_HANDLED)
+            cont = DBG_CONTINUE;
+        else if (debug_client->exec_status == DEBUG_STATUS_GO_NOT_HANDLED)
+            cont = DBG_EXCEPTION_NOT_HANDLED;
+        target->stepping = debug_client->exec_status == DEBUG_STATUS_STEP_INTO
+                || debug_client->exec_status == DEBUG_STATUS_STEP_OVER || debug_client->exec_status == DEBUG_STATUS_STEP_BRANCH;
+        if (!target->exited)
+        {
+            /* leaving a breakpoint takes one instruction executed without it */
+            if (debug_client->last_event.type == DEBUG_EVENT_BREAKPOINT)
+                target->step_over_bp = TRUE;
+            if (target->stepping || target->step_over_bp)
+                debug_target_set_trap_flag(target, target->stop_tid);
+            if (!target->step_over_bp)
+                debug_target_insert_breakpoints(target);
+        }
+        target->stopped = FALSE;
+        if (!ContinueDebugEvent(target->stop_pid, target->stop_tid, cont))
+            return HRESULT_FROM_WIN32(GetLastError());
+        if (target->exited)
+        {
+            debug_client->exec_status = DEBUG_STATUS_NO_DEBUGGEE;
+            return S_OK;
+        }
+        debug_client->exec_status = DEBUG_STATUS_GO;
+    }
+
+    for (;;)
+    {
+        DWORD cont;
+        BOOL stop;
+
+        if (!WaitForDebugEvent(&ev, timeout))
+        {
+            if (GetLastError() == ERROR_SEM_TIMEOUT || GetLastError() == WAIT_TIMEOUT)
+                return S_FALSE;
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+        debug_target_remove_breakpoints(target);
+        target->stop_pid = ev.dwProcessId;
+        target->stop_tid = ev.dwThreadId;
+        stop = debug_client_handle_event(debug_client, target, &ev, &cont);
+        target->continue_status = cont;
+        if (stop)
+        {
+            target->stopped = TRUE;
+            debug_client->exec_status = DEBUG_STATUS_BREAK;
+            if (ev.dwDebugEventCode == EXIT_PROCESS_DEBUG_EVENT)
+                debug_client->exec_status = DEBUG_STATUS_BREAK;
+            return S_OK;
+        }
+        if (debug_client->exec_status == DEBUG_STATUS_BREAK && target->stopped)
+            return S_OK;
+        if (target->stepping)
+        {
+            debug_target_set_trap_flag(target, ev.dwThreadId);
+        }
+        if (!target->exited)
+            debug_target_insert_breakpoints(target);
+        ContinueDebugEvent(ev.dwProcessId, ev.dwThreadId, cont);
+        if (target->exited)
+        {
+            debug_client->exec_status = DEBUG_STATUS_NO_DEBUGGEE;
+            return S_OK;
+        }
+    }
+}
