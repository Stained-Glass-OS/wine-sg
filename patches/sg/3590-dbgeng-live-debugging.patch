+static ULONG64 debug_client_source_name_id(struct debug_client *debug_client, const char *name)
+{
+    unsigned int i;
+    char **tmp;
+
+    for (i = 0; i < debug_client->source_name_count; ++i)
+        if (!stricmp(debug_client->source_names[i], name))
+            return i + 1;
+    if (!(tmp = realloc(debug_client->source_names, (i + 1) * sizeof(*tmp))))
+        return 0;
+    debug_client->source_names = tmp;
+    if (!(tmp[i] = strdup(name)))
+        return 0;
+    debug_client->source_name_count = i + 1;
+    return i + 1;
+}
