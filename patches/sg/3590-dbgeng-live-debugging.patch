+/* the locals and arguments of the current scope */
+struct scope_collect
+{
+    struct sym_group *group;
+    ULONG flags;
+    ULONG64 frame, stack;
+};
+
+static BOOL CALLBACK scope_collect_cb(SYMBOL_INFO *info, ULONG size, void *context)
+{
+    struct scope_collect *sc = context;
+    struct sym_group_item item = { 0 };
+
+    if (info->Flags & SYMFLAG_PARAMETER)
+    {
+        if (!(sc->flags & 1))
+            return TRUE;
+        item.flags |= 0x10; /* DEBUG_SYMBOL_IS_ARGUMENT */
+    }
+    else if (info->Flags & SYMFLAG_LOCAL)
+    {
+        if (!(sc->flags & 2))
+            return TRUE;
+        item.flags |= 0x20; /* DEBUG_SYMBOL_IS_LOCAL */
+    }
+    else
+        return TRUE;
+    item.name = strdup(info->Name);
+    item.module = info->ModBase;
+    item.type_id = info->TypeIndex;
+    item.size = info->Size;
+    item.parent = DEBUG_ANY_ID;
+    if (info->Flags & SYMFLAG_REGISTER)
+    {
+        item.is_register = TRUE;
+        item.reg = info->Register;
+    }
+    else if (info->Flags & SYMFLAG_FRAMEREL)
+        item.address = sc->frame + (LONG64)info->Address;
+    else if (info->Flags & SYMFLAG_REGREL)
+        item.address = ((info->Register == 22 || info->Register == 334) ? sc->frame : sc->stack) + (LONG64)info->Address;
+    else
+        item.address = info->Address;
+    if (!item.name || FAILED(sym_group_insert(sc->group, sc->group->count, &item)))
+        free(item.name);
+    return TRUE;
+}
+
+static HRESULT debug_client_scope_group(struct debug_client *debug_client, ULONG flags, struct sym_group **ret)
+{
+    struct scope_collect sc = { 0 };
+    struct sym_group *group;
+    IMAGEHLP_STACK_FRAME ihframe = { 0 };
+    HANDLE process;
+    CONTEXT ctx;
+    HRESULT hr;
+
+    if (!(process = debug_client_sym_handle(debug_client, NULL)))
+        return E_UNEXPECTED;
+    if (FAILED(hr = sym_group_create(debug_client, &group)))
+        return hr;
+    if (debug_client->scope_set)
+    {
+        ihframe.InstructionOffset = debug_client->scope_ip;
+        ihframe.StackOffset = debug_client->scope_stack;
+        ihframe.FrameOffset = debug_client->scope_frame;
+    }
+    else if (SUCCEEDED(debug_client_get_context(debug_client, &ctx)))
+    {
+        ihframe.InstructionOffset = CTX_IP(&ctx);
+        ihframe.StackOffset = CTX_SP(&ctx);
+        ihframe.FrameOffset = CTX_FP(&ctx);
+    }
+    sc.group = group;
+    sc.flags = flags ? flags : 3;
+    sc.frame = ihframe.FrameOffset;
+    sc.stack = ihframe.StackOffset;
+    if (ihframe.InstructionOffset)
+    {
+        SymSetContext(process, &ihframe, NULL);
+        SymEnumSymbols(process, 0, "*", scope_collect_cb, &sc);
+    }
+    {
+        unsigned int i;
+
+        for (i = 0; i < group->count; ++i)
+            sym_group_fill_children(group, process, &group->items[i]);
+    }
+    *ret = group;
+    return S_OK;
+}
