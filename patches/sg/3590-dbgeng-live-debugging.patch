+static HRESULT debug_cmd_breakpoint(struct debug_client *debug_client, const char *cmd, char *args)
+{
+    struct dbg_breakpoint *bp, *next;
+    BOOL is64 = debug_client_is_64(debug_client);
+    HRESULT hr;
+
+    args = debug_skip_blanks(args);
+    if (cmd[1] == 'l' && !cmd[2])
+    {
+        LIST_FOR_EACH_ENTRY(bp, &debug_client->breakpoints, struct dbg_breakpoint, entry)
+        {
+            char addr[32], *name = NULL;
+            ULONG64 disp;
+
+            debug_format_address(is64, bp->offset, addr, sizeof(addr));
+            if (bp->offset != DEBUG_INVALID_OFFSET && FAILED(sym_name_by_offset(debug_client, bp->offset, &name, &disp)))
+                name = NULL;
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%2lu %c %s     %04lx (%04lx)  %s\n", bp->id,
+                    (bp->flags & DEBUG_BREAKPOINT_ENABLED) ? 'e' : 'd', addr, bp->pass_count, bp->current_pass,
+                    name ? name : (bp->offset_expression ? bp->offset_expression : ""));
+            free(name);
+        }
+        return S_OK;
+    }
+    if ((cmd[1] == 'c' || cmd[1] == 'd' || cmd[1] == 'e') && !cmd[2])
+    {
+        BOOL all = *args == '*';
+
+        LIST_FOR_EACH_ENTRY_SAFE(bp, next, &debug_client->breakpoints, struct dbg_breakpoint, entry)
+        {
+            ULONG64 id;
+
+            if (!all)
+            {
+                const char *p = args;
+
+                while (*p)
+                {
+                    char *end;
+
+                    id = strtoul(p, &end, 10);
+                    if (end == p)
+                        break;
+                    if (id == bp->id)
+                        break;
+                    p = debug_skip_blanks((char *)end);
+                    if (*p == ',')
+                        ++p;
+                    if (end == p)
+                        break;
+                }
+                if (!*p || strtoul(p, NULL, 10) != bp->id)
+                    continue;
+            }
+            if (cmd[1] == 'c')
+                debug_client_free_breakpoint(bp);
+            else if (cmd[1] == 'd')
+                bp->flags &= ~DEBUG_BREAKPOINT_ENABLED;
+            else
+                bp->flags |= DEBUG_BREAKPOINT_ENABLED;
+        }
+        return S_OK;
+    }
+    /* bp, bu, bm: set a code breakpoint at an address expression */
+    if (!*args)
+        return E_INVALIDARG;
+    {
+        char *expr = args, *end = args;
+        ULONG desired = DEBUG_ANY_ID;
+        const char *p = cmd + 2;
+
+        if (*p >= '0' && *p <= '9')
+            desired = atoi(p);
+        while (*end && *end != ' ' && *end != '\t')
+            ++end;
+        if (*end)
+            *end++ = 0;
+        if (FAILED(hr = debug_client_add_breakpoint(debug_client, DEBUG_BREAKPOINT_CODE, desired, &bp)))
+            return hr;
+        {
+            DEBUG_VALUE v;
+
+            if (SUCCEEDED(debug_client_evaluate(debug_client, expr, DEBUG_VALUE_INT64, &v, NULL)))
+                bp->offset = v.I64;
+            else if (cmd[1] == 'u' || cmd[1] == 'm')
+                bp->flags |= DEBUG_BREAKPOINT_DEFERRED;
+            else
+            {
+                debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "Couldn't resolve error at '%s'\n", expr);
+                debug_client_free_breakpoint(bp);
+                return E_FAIL;
+            }
+        }
+        bp->offset_expression = strdup(expr);
+        end = debug_skip_blanks(end);
+        if (*end)
+            bp->command = strdup(end);
+        bp->flags |= DEBUG_BREAKPOINT_ENABLED;
+    }
+    return S_OK;
+}
+
+static HRESULT debug_cmd_filters(struct debug_client *debug_client, const char *cmd, char *args)
+{
+    unsigned int i;
+    char tmp[32];
+    HRESULT hr;
+
+    if (FAILED(hr = debug_client_init_filters(debug_client)))
+        return hr;
+    args = debug_skip_blanks(args);
+    if (!cmd[2])
+    {
+        static const char *const exec_names[] = { "break", "second-chance break", "output", "ignore" };
+
+        for (i = 0; i < debug_client->filter_count; ++i)
+        {
+            const struct event_filter *f = &debug_client->filters[i];
+
+            debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%4s - %s - %s%s\n", f->abbrev ? f->abbrev : "",
+                    debug_filter_text(f, tmp, sizeof(tmp)), exec_names[min(f->exec, 3)],
+                    !debug_filter_is_event(i) && f->cont ? " - not handled" : "");
+        }
+        return S_OK;
+    }
+    if (cmd[2] == 'r' && !cmd[3])
+    {
+        debug_client_free_filters(debug_client);
+        return debug_client_init_filters(debug_client);
+    }
+    {
+        ULONG exec = cmd[2] == 'e' ? DEBUG_FILTER_BREAK : cmd[2] == 'd' ? DEBUG_FILTER_SECOND_CHANCE_BREAK
+                : cmd[2] == 'n' ? DEBUG_FILTER_OUTPUT : DEBUG_FILTER_IGNORE;
+        char *end;
+
+        if (cmd[2] != 'e' && cmd[2] != 'd' && cmd[2] != 'n' && cmd[2] != 'i')
+            return E_INVALIDARG;
+        end = args;
+        while (*end && *end != ' ')
+            ++end;
+        if (*end)
+            *end++ = 0;
+        for (i = 0; i < debug_client->filter_count; ++i)
+        {
+            if (debug_client->filters[i].abbrev && !strcmp(debug_client->filters[i].abbrev, args))
+            {
+                debug_client->filters[i].exec = exec;
+                if (debug_filter_is_event(i) && exec == DEBUG_FILTER_SECOND_CHANCE_BREAK)
+                    debug_client->filters[i].exec = DEBUG_FILTER_BREAK;
+                return S_OK;
+            }
+        }
+        {
+            ULONG64 code;
+
+            if (FAILED(hr = debug_eval_value(debug_client, args, &code)))
+                return hr;
+            for (i = ARRAY_SIZE(debug_default_events); i < debug_client->filter_count; ++i)
+                if (debug_client->filters[i].code == code)
+                {
+                    debug_client->filters[i].exec = exec;
+                    return S_OK;
+                }
+            {
+                DEBUG_EXCEPTION_FILTER_PARAMETERS p = { exec, DEBUG_FILTER_GO_NOT_HANDLED, 0, 0, 0, code };
+
+                return debugcontrol_SetExceptionFilterParameters(&debug_client->IDebugControl4_iface, 1, &p);
+            }
+        }
+    }
+}
