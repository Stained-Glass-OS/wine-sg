+    while (sym_type_info(process, base, type_id, TI_GET_SYMTAG, &tag) && (tag == SymTagTypedef || tag == SymTagPointerType))
+    {
+        if (!sym_type_info(process, base, type_id, TI_GET_TYPE, &pointed))
+            return E_FAIL;
+        type_id = pointed;
+    }
+    if (!(dot = strchr(field, '.')))
+        dot = field + strlen(field);
+    len = dot - field;
+    if (!sym_type_info(process, base, type_id, TI_GET_CHILDRENCOUNT, &count) || !count)
+        return E_FAIL;
+    if (!(children = calloc(1, sizeof(*children) + count * sizeof(DWORD))))
+        return E_OUTOFMEMORY;
+    children->Count = count;
+    if (!sym_type_info(process, base, type_id, TI_FINDCHILDREN, children))
+    {
+        free(children);
+        return E_FAIL;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        WCHAR *wname = NULL;
+        char name[256];
+        DWORD off = 0, member_type = 0;
+
+        if (!sym_type_info(process, base, children->ChildId[i], TI_GET_SYMNAME, &wname) || !wname)
+            continue;
+        WideCharToMultiByte(CP_ACP, 0, wname, -1, name, sizeof(name), NULL, NULL);
+        LocalFree(wname);
+        if (strlen(name) != len || strncmp(name, field, len))
+            continue;
+        sym_type_info(process, base, children->ChildId[i], TI_GET_OFFSET, &off);
+        sym_type_info(process, base, children->ChildId[i], TI_GET_TYPEID, &member_type);
+        if (*dot == '.')
+        {
+            ULONG inner_off;
+
+            if (SUCCEEDED(hr = sym_find_field(process, base, member_type, dot + 1, field_type, &inner_off)))
+                *offset = total + off + inner_off;
+        }
+        else
+        {
+            *offset = total + off;
+            if (field_type)
+                *field_type = member_type;
+            hr = S_OK;
+        }
+        break;
+    }
+    free(children);
+    return hr;
+}
+
+/* ---- thread context of the current thread ---- */
+#ifdef __x86_64__
+#define CTX_IP(c) ((c)->Rip)
+#define CTX_SP(c) ((c)->Rsp)
+#define CTX_FP(c) ((c)->Rbp)
+#elif defined(__i386__)
+#define CTX_IP(c) ((c)->Eip)
+#define CTX_SP(c) ((c)->Esp)
+#define CTX_FP(c) ((c)->Ebp)
+#else
+#define CTX_IP(c) ((c)->Pc)
+#define CTX_SP(c) ((c)->Sp)
+#define CTX_FP(c) ((c)->Fp)
+#endif
+
+static HRESULT debug_client_get_context(struct debug_client *debug_client, CONTEXT *ctx)
+{
+    struct target_process *target = debug_client_get_target(debug_client);
+    DWORD sysid;
+    HANDLE thread;
+    HRESULT hr;
+
+    if (!target || !target->handle)
+        return E_UNEXPECTED;
+    if (FAILED(hr = debug_client_get_thread_sysid(debug_client, debug_client->current_thread, &sysid)))
+        return hr;
+    if (!(thread = OpenThread(THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, sysid)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    memset(ctx, 0, sizeof(*ctx));
+    ctx->ContextFlags = CONTEXT_FULL;
+    if (!GetThreadContext(thread, ctx))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle(thread);
+    return hr;
+}
+
+static HRESULT debug_client_set_context(struct debug_client *debug_client, CONTEXT *ctx)
+{
+    DWORD sysid;
+    HANDLE thread;
+    HRESULT hr;
+
+    if (FAILED(hr = debug_client_get_thread_sysid(debug_client, debug_client->current_thread, &sysid)))
+        return hr;
+    if (!(thread = OpenThread(THREAD_SET_CONTEXT | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, sysid)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!SetThreadContext(thread, ctx))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle(thread);
+    return hr;
+}
+
+/* ---- growing text buffer ---- */
+struct strbuf
+{
+    char *data;
+    size_t len, cap;
+};
+
+static void strbuf_append(struct strbuf *sb, const char *format, ...)
+{
+    va_list args;
+    char *text;
+    size_t n;
+
+    va_start(args, format);
+    text = debug_vformat(format, args);
+    va_end(args);
+    if (!text)
+        return;
+    n = strlen(text);
+    if (sb->len + n + 1 > sb->cap)
+    {
+        size_t cap = max(sb->cap * 2, sb->len + n + 256);
+        char *tmp = realloc(sb->data, cap);
+
+        if (!tmp)
+        {
+            free(text);
+            return;
+        }
+        sb->data = tmp;
+        sb->cap = cap;
+    }
+    memcpy(sb->data + sb->len, text, n + 1);
+    sb->len += n;
+    free(text);
+}
+
+/* ---- values of typed data ---- */
+static char *sym_name_from_wide(WCHAR *wname)
+{
+    char *name;
+    int len;
+
+    if (!wname)
+        return NULL;
+    len = WideCharToMultiByte(CP_ACP, 0, wname, -1, NULL, 0, NULL, NULL);
+    if ((name = malloc(len)))
+        WideCharToMultiByte(CP_ACP, 0, wname, -1, name, len, NULL, NULL);
+    LocalFree(wname);
+    return name;
+}
+
+static char *sym_member_name(HANDLE process, ULONG64 base, ULONG id)
+{
+    WCHAR *wname = NULL;
+
+    if (!SymGetTypeInfo(process, base, id, TI_GET_SYMNAME, &wname))
+        return NULL;
+    return sym_name_from_wide(wname);
+}
+
+static DWORD sym_type_tag(HANDLE process, ULONG64 base, ULONG id)
+{
+    DWORD tag = 0;
+
+    SymGetTypeInfo(process, base, id, TI_GET_SYMTAG, &tag);
+    return tag;
+}
+
+/* remove typedefs on the way to the real type */
+static ULONG sym_resolve_typedef(HANDLE process, ULONG64 base, ULONG id)
+{
+    DWORD type, n = 0;
+
+    while (sym_type_tag(process, base, id) == SymTagTypedef && n++ < 16)
+    {
+        if (!SymGetTypeInfo(process, base, id, TI_GET_TYPE, &type))
+            break;
+        id = type;
+    }
+    return id;
+}
+
+static ULONG sym_type_length(HANDLE process, ULONG64 base, ULONG id)
+{
+    ULONG64 length = 0;
+
+    SymGetTypeInfo(process, base, id, TI_GET_LENGTH, &length);
+    return length;
+}
+
+static void sym_format_value(HANDLE process, ULONG64 base, ULONG id, const unsigned char *data, ULONG size,
+        struct strbuf *sb)
+{
+    DWORD tag, basic = 0;
+    ULONG64 v = 0;
+    char *name;
+
+    id = sym_resolve_typedef(process, base, id);
+    tag = sym_type_tag(process, base, id);
+    switch (tag)
+    {
+    case SymTagBaseType:
+        SymGetTypeInfo(process, base, id, TI_GET_BASETYPE, &basic);
+        memcpy(&v, data, min(size, sizeof(v)));
+        if (basic == 8 && size == 4)
+        {
+            float f;
+
+            memcpy(&f, data, sizeof(f));
+            strbuf_append(sb, "%g", (double)f);
+        }
+        else if (basic == 8 && size == 8)
+        {
+            double d;
+
+            memcpy(&d, data, sizeof(d));
+            strbuf_append(sb, "%g", d);
+        }
+        else if (basic == 2 && size == 1)
+            strbuf_append(sb, "%d '%c'", (signed char)v, (v >= 32 && v < 127) ? (int)v : '.');
+        else if (basic == 10)
+            strbuf_append(sb, "%s", v ? "true" : "false");
+        else if (basic == 6 || basic == 13)
+            strbuf_append(sb, "0n%I64d", size == 1 ? (LONG64)(signed char)v : size == 2 ? (LONG64)(short)v
+                    : size == 4 ? (LONG64)(int)v : (LONG64)v);
+        else
+            strbuf_append(sb, "0x%I64x", v);
+        break;
+    case SymTagPointerType:
+        memcpy(&v, data, min(size, sizeof(v)));
+        if (size > 4)
+            strbuf_append(sb, "0x%08lx`%08lx", (ULONG)(v >> 32), (ULONG)v);
+        else
+            strbuf_append(sb, "0x%08lx", (ULONG)v);
+        break;
+    case SymTagEnum:
+    {
+        TI_FINDCHILDREN_PARAMS *children;
+        DWORD count = 0, i;
+        BOOL found = FALSE;
+
+        memcpy(&v, data, min(size, sizeof(v)));
+        if (SymGetTypeInfo(process, base, id, TI_GET_CHILDRENCOUNT, &count) && count
+                && (children = calloc(1, sizeof(*children) + count * sizeof(DWORD))))
+        {
+            children->Count = count;
+            if (SymGetTypeInfo(process, base, id, TI_FINDCHILDREN, children))
+            {
+                for (i = 0; i < count && !found; ++i)
+                {
+                    VARIANT var;
+
+                    V_VT(&var) = VT_EMPTY;
+                    if (SymGetTypeInfo(process, base, children->ChildId[i], TI_GET_VALUE, &var)
+                            && (ULONG)V_UI4(&var) == (ULONG)v && (name = sym_member_name(process, base, children->ChildId[i])))
+                    {
+                        strbuf_append(sb, "%s", name);
+                        free(name);
+                        found = TRUE;
+                    }
+                }
+            }
+            free(children);
+        }
+        if (!found)
+            strbuf_append(sb, "0n%ld", (LONG)v);
+        break;
+    }
+    case SymTagArrayType:
+    {
+        DWORD elem_type = 0, count = 0;
+        ULONG elem_size;
+
+        SymGetTypeInfo(process, base, id, TI_GET_TYPE, &elem_type);
+        elem_size = sym_type_length(process, base, elem_type);
+        if (elem_size == 1 && sym_type_tag(process, base, sym_resolve_typedef(process, base, elem_type)) == SymTagBaseType)
+        {
+            ULONG i;
+
+            strbuf_append(sb, "\"");
+            for (i = 0; i < size && data[i]; ++i)
+                strbuf_append(sb, "%c", data[i] >= 32 && data[i] < 127 ? data[i] : '.');
+            strbuf_append(sb, "\"");
+        }
+        else
+        {
+            SymGetTypeInfo(process, base, id, TI_GET_COUNT, &count);
+            strbuf_append(sb, "[%lu]", count);
+        }
+        break;
+    }
+    case SymTagUDT:
+        name = sym_type_name(process, base, id, 0);
+        strbuf_append(sb, "%s", name ? name : "<struct>");
+        free(name);
+        break;
+    default:
+        strbuf_append(sb, "<?>");
+        break;
+    }
+}
+
+static void sym_dump_value(struct debug_client *debug_client, HANDLE process, ULONG64 base, ULONG id, ULONG64 address,
+        const unsigned char *data, ULONG size, unsigned int indent, unsigned int depth, struct strbuf *sb)
+{
+    id = sym_resolve_typedef(process, base, id);
+    if (sym_type_tag(process, base, id) == SymTagUDT)
+    {
+        TI_FINDCHILDREN_PARAMS *children;
+        DWORD count = 0, i;
+
+        if (!SymGetTypeInfo(process, base, id, TI_GET_CHILDRENCOUNT, &count) || !count
+                || !(children = calloc(1, sizeof(*children) + count * sizeof(DWORD))))
+            return;
+        children->Count = count;
+        if (SymGetTypeInfo(process, base, id, TI_FINDCHILDREN, children))
+        {
+            for (i = 0; i < count; ++i)
+            {
+                DWORD off = 0, member_type = 0, tag;
+                char *name = sym_member_name(process, base, children->ChildId[i]);
+                ULONG member_size;
+
+                if (!SymGetTypeInfo(process, base, children->ChildId[i], TI_GET_SYMTAG, &tag) || tag != 7 /* SymTagData */
+                        || !SymGetTypeInfo(process, base, children->ChildId[i], TI_GET_OFFSET, &off)
+                        || !SymGetTypeInfo(process, base, children->ChildId[i], TI_GET_TYPEID, &member_type))
+                {
+                    free(name);
+                    continue;
+                }
+                member_size = sym_type_length(process, base, member_type);
+                strbuf_append(sb, "%*s+0x%03lx %s : ", indent, "", off, name ? name : "?");
+                if (off + member_size <= size)
+                {
+                    sym_format_value(process, base, member_type, data + off, member_size, sb);
+                    strbuf_append(sb, "\n");
+                    if (depth && sym_type_tag(process, base, sym_resolve_typedef(process, base, member_type)) == SymTagUDT)
+                        sym_dump_value(debug_client, process, base, member_type, address + off, data + off, member_size,
+                                indent + 3, depth - 1, sb);
+                }
+                else
+                    strbuf_append(sb, "??\n");
+                free(name);
+            }
+        }
+        free(children);
+    }
+    else
+    {
+        sym_format_value(process, base, id, data, size, sb);
+        strbuf_append(sb, "\n");
+    }
+}
+
+static HRESULT debug_client_read_typed(struct debug_client *debug_client, ULONG64 offset, ULONG64 base, ULONG type_id,
+        void *buffer, ULONG buffer_size, ULONG *read_len)
+{
+    struct target_process *target;
+    HANDLE process;
+    ULONG size;
+    SIZE_T read = 0;
+
+    if (!(process = debug_client_sym_handle(debug_client, &target)))
+        return E_UNEXPECTED;
+    if (!(size = sym_type_length(process, base, type_id)))
+        return E_FAIL;
+    if (buffer_size < size)
+        return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    if (!ReadProcessMemory(target->handle, (const void *)(ULONG_PTR)offset, buffer, size, &read))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (read_len)
+        *read_len = read;
+    return S_OK;
+}
