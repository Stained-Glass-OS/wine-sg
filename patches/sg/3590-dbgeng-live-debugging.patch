+static HRESULT STDMETHODCALLTYPE debugsymbols_GetNameByOffset(IDebugSymbols3 *iface, ULONG64 offset, char *buffer,
+        ULONG buffer_size, ULONG *name_size, ULONG64 *displacement)
+{
+    struct debug_client *debug_client = impl_from_IDebugSymbols3(iface);
+    ULONG64 disp = 0;
+    char *name;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p, %lu, %p, %p.\n", iface, wine_dbgstr_longlong(offset), buffer, buffer_size, name_size, displacement);
+
+    if (FAILED(hr = sym_name_by_offset(debug_client, offset, &name, &disp)))
+        return hr;
+    if (displacement)
+        *displacement = disp;
+    hr = debug_target_return_string(name, buffer, buffer_size, name_size);
+    free(name);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE debugsymbols_GetOffsetByName(IDebugSymbols3 *iface, const char *symbol,
+        ULONG64 *offset)
+{
+    struct debug_client *debug_client = impl_from_IDebugSymbols3(iface);
+    struct sym_buffer buf;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_a(symbol), offset);
+
+    if (!offset)
+        return E_POINTER;
+    if (FAILED(hr = sym_lookup_name(debug_client, symbol, &buf, NULL)))
+        return hr;
+    *offset = buf.info.Address;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE debugsymbols_GetNearNameByOffset(IDebugSymbols3 *iface, ULONG64 offset, LONG delta,
+        char *buffer, ULONG buffer_size, ULONG *name_size, ULONG64 *displacement)
+{
+    struct debug_client *debug_client = impl_from_IDebugSymbols3(iface);
+    struct sym_collect c;
+    HANDLE process;
+    int index;
+    LONG i;
+    HRESULT hr;
+
+    TRACE("%p, %s, %ld, %p, %lu, %p, %p.\n", iface, wine_dbgstr_longlong(offset), delta, buffer, buffer_size,
+            name_size, displacement);
+
+    if (!delta)
+        return debugsymbols_GetNameByOffset(iface, offset, buffer, buffer_size, name_size, displacement);
+
+    if (!(process = debug_client_sym_handle(debug_client, NULL)))
+        return E_UNEXPECTED;
