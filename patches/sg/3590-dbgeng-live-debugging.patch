+static HRESULT debug_execute_extension(struct debug_client *debug_client, char *cmd)
+{
+    struct dbg_extension *ext;
+    char *args, *dot, *name = cmd + 1;
+    char *module = NULL;
+
+    if ((args = strpbrk(name, " \t")))
+        *args++ = 0;
+    else
+        args = (char *)"";
+    if ((dot = strchr(name, '.')))
+    {
+        *dot = 0;
+        module = name;
+        name = dot + 1;
+    }
+    LIST_FOR_EACH_ENTRY(ext, &debug_client->extensions, struct dbg_extension, entry)
+    {
+        HRESULT (WINAPI *proc)(IDebugClient *client, const char *args);
+
+        if (module)
+        {
+            const char *base = strrchr(ext->path, '\\');
+
+            base = base ? base + 1 : ext->path;
+            if (strnicmp(base, module, strlen(module)))
+                continue;
+        }
+        if ((proc = (void *)GetProcAddress(ext->module, name)))
+            return proc((IDebugClient *)&debug_client->IDebugClient_iface, debug_skip_blanks(args));
+    }
+    debug_printf(debug_client, DEBUG_OUTPUT_ERROR, "No export %s found\n", name);
+    return E_FAIL;
+}
