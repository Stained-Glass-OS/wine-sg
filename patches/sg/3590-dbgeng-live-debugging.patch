+static HRESULT debug_cmd_stack(struct debug_client *debug_client, const char *cmd, char *args)
+{
+    DEBUG_STACK_FRAME frames[128];
+    ULONG filled = 0, flags = DEBUG_STACK_FRAME_ADDRESSES | DEBUG_STACK_COLUMN_NAMES | DEBUG_STACK_FRAME_NUMBERS;
+    ULONG64 count = 20;
+    HRESULT hr;
+
+    for (++cmd; *cmd; ++cmd)
+    {
+        if (*cmd == 'b' || *cmd == 'p' || *cmd == 'P' || *cmd == 'v')
+            flags |= DEBUG_STACK_ARGUMENTS;
+        else if (*cmd == 'f')
+            flags |= DEBUG_STACK_FRAME_MEMORY_USAGE;
+    }
+    args = debug_skip_blanks(args);
+    if (*args && FAILED(hr = debug_eval_value(debug_client, args, &count)))
+        return hr;
+    if (count > ARRAY_SIZE(frames))
+        count = ARRAY_SIZE(frames);
+    if (FAILED(hr = debug_client_walk_stack(debug_client, NULL, 0, 0, 0, frames, count, &filled, NULL, 0)))
+        return hr;
+    debug_output_stack(debug_client, frames, filled, flags);
+    return S_OK;
+}
