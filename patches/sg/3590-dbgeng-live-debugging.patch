+static HRESULT debug_cmd_modules(struct debug_client *debug_client)
+{
+    struct target_process *target = debug_client_get_target(debug_client);
+    BOOL is64 = debug_client_is_64(debug_client);
+    unsigned int i;
+
+    if (!target || FAILED(debug_target_init_modules_info(target)))
+        return E_UNEXPECTED;
+    debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, is64 ? "start             end                 module name\n"
+            : "start    end        module name\n");
+    for (i = 0; i < target->modules.loaded; ++i)
+    {
+        const struct module_info *module = &target->modules.info[i];
+        const char *base = module->image_name, *q, *dot;
+        char start[32], end[32], name[MAX_PATH];
+        size_t n;
+
+        for (q = module->image_name; *q; ++q)
+            if (*q == '\\' || *q == '/')
+                base = q + 1;
+        dot = strrchr(base, '.');
+        n = dot && dot > base ? dot - base : strlen(base);
+        snprintf(name, sizeof(name), "%.*s", (int)n, base);
+        debug_format_address(is64, module->params.Base, start, sizeof(start));
+        debug_format_address(is64, module->params.Base + module->params.Size, end, sizeof(end));
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%s %s   %-10s (deferred)\n", start, end, name);
+    }
+    return S_OK;
+}
