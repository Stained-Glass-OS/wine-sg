+static HRESULT debug_cmd_threads(struct debug_client *debug_client, char *args, BOOL processes)
+{
+    struct target_process *target = debug_client_get_target(debug_client);
+    DWORD *ids;
+    unsigned int count, i;
+    HRESULT hr;
+
+    args = debug_skip_blanks(args);
+    if (!target)
+        return E_UNEXPECTED;
+    if (processes)
+    {
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, ".  0\tid: %lx\tattach\tname: %s\n", (ULONG)target->pid,
+                target->modules.initialized && target->modules.loaded ? target->modules.info[0].image_name : "");
+        return S_OK;
+    }
+    if (FAILED(hr = debug_target_get_threads(target, &ids, &count)))
+        return hr;
+    if (*args >= '0' && *args <= '9' && strchr(args, 's'))
+    {
+        ULONG n = strtoul(args, NULL, 10);
+
+        free(ids);
+        if (n >= count)
+            return E_INVALIDARG;
+        debug_client->current_thread = n;
+        return S_OK;
+    }
+    for (i = 0; i < count; ++i)
+        debug_printf(debug_client, DEBUG_OUTPUT_NORMAL, "%c%3u  Id: %lx.%lx Suspend: 0\n",
+                i == debug_client->current_thread ? '.' : ' ', i, (ULONG)target->pid, ids[i]);
+    free(ids);
+    return S_OK;
+}
