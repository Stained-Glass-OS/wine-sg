+/* ---- breakpoints ---- */
+struct dbg_breakpoint
+{
+    struct list entry;
+    struct debug_client *client;
+    IDebugBreakpoint2 IDebugBreakpoint2_iface;
+    ULONG id, type, flags, access, size, pass_count, current_pass, match_thread;
+    ULONG64 offset;
+    char *command;
+    char *offset_expression;
+    BOOL inserted, was_inserted;
+    unsigned char original;
+};
+
+static const IDebugBreakpoint2Vtbl dbg_breakpoint_vtbl;
+
+static struct dbg_breakpoint *impl_from_IDebugBreakpoint2(IDebugBreakpoint2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct dbg_breakpoint, IDebugBreakpoint2_iface);
+}
+
+static struct dbg_breakpoint *debug_client_find_breakpoint(struct debug_client *debug_client, ULONG id)
+{
+    struct dbg_breakpoint *bp;
+
+    LIST_FOR_EACH_ENTRY(bp, &debug_client->breakpoints, struct dbg_breakpoint, entry)
+        if (bp->id == id)
+            return bp;
+    return NULL;
+}
+
+static HRESULT STDMETHODCALLTYPE dbg_breakpoint_QueryInterface(IDebugBreakpoint2 *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDebugBreakpoint) || IsEqualIID(riid, &IID_IDebugBreakpoint2))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the engine owns breakpoints, references are not counted */
+static ULONG STDMETHODCALLTYPE dbg_breakpoint_AddRef(IDebugBreakpoint2 *iface)
+{
+    return 1;
+}
+
+static ULONG STDMETHODCALLTYPE dbg_breakpoint_Release(IDebugBreakpoint2 *iface)
+{
+    return 1;
+}
+
+static HRESULT STDMETHODCALLTYPE dbg_breakpoint_GetId(IDebugBreakpoint2 *iface, ULONG *id)
+{
+    TRACE("%p, %p.\n", iface, id);
+    if (!id)
+        return E_POINTER;
+    *id = impl_from_IDebugBreakpoint2(iface)->id;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE dbg_breakpoint_GetType(IDebugBreakpoint2 *iface, ULONG *type, ULONG *proc)
