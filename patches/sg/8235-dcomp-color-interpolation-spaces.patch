From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: colour animations in the colour space asked for

ColorKeyFrameAnimation.InterpolationColorSpace: Hsl interpolates hue (the shorter way round), saturation and lightness, RgbLinear the channels in linear light (sRGB transfer undone and redone), HslLinear HSL over linear values; Rgb and Auto as before; alpha always straight. A value beyond RgbLinear is E_INVALIDARG. Colours were interpolated in RGB whatever was asked for.
---
--- a/dlls/dcomp/animation.c
+++ b/dlls/dcomp/animation.c
@@ -1528,9 +1528,11 @@
 
 static HRESULT WINAPI color_put_InterpolationColorSpace( IColorKeyFrameAnimation *iface, CompositionColorSpace value )
 {
-    /* colours are interpolated in RGB whichever is asked for */
+#ifdef SG_MUTANT_COLOR_SPACE_RGB_ONLY
     if (value != CompositionColorSpace_Auto && value != CompositionColorSpace_Rgb)
         FIXME( "colour space %u, interpolating in RGB.\n", value );
+#endif
+    if (value > CompositionColorSpace_RgbLinear) return E_INVALIDARG;
     impl_from_IColorKeyFrameAnimation( iface )->color_space = value;
     return S_OK;
 }
@@ -2156,6 +2158,7 @@
     ICompositionObject *target_object;  /* this.Target */
     struct animation *probe;    /* finds referenced objects' properties */
     struct controller *controller;      /* its AnimationController, once asked for */
+    CompositionColorSpace color_space;  /* (wine-sg 8235) a colour animation's */
 };
 
 /* ---- AnimationController: a running animation paused and driven by its Progress (wine-sg 6265) ---- */
@@ -2342,6 +2345,104 @@
     for (i = 0; i < 4; i++) out[i] = wa * a[i] + sign * wb * b[i];
 }
 
+#ifndef SG_MUTANT_COLOR_SPACE_RGB_ONLY
+/* (wine-sg 8235) the colour spaces of ColorKeyFrameAnimation.InterpolationColorSpace: sRGB channels (0-255)
+ * to linear light and back, RGB to HSL and back */
+static float srgb_to_linear( float v )
+{
+    v /= 255.0f;
+    return v <= 0.04045f ? v / 12.92f : powf( (v + 0.055f) / 1.055f, 2.4f );
+}
+
+static float linear_to_srgb( float v )
+{
+    v = v <= 0.0031308f ? v * 12.92f : 1.055f * powf( v, 1.0f / 2.4f ) - 0.055f;
+    return v * 255.0f;
+}
+
+/* r, g, b in 0-1 to h (0-360), s, l (0-1) */
+static void rgb_to_hsl( const float *rgb, float *hsl )
+{
+    float mx = max( rgb[0], max( rgb[1], rgb[2] ) ), mn = min( rgb[0], min( rgb[1], rgb[2] ) ), d = mx - mn;
+
+    hsl[2] = (mx + mn) / 2.0f;
+    if (d <= 0.0f)
+    {
+        hsl[0] = hsl[1] = 0.0f;
+        return;
+    }
+    hsl[1] = hsl[2] > 0.5f ? d / (2.0f - mx - mn) : d / (mx + mn);
+    if (mx == rgb[0]) hsl[0] = (rgb[1] - rgb[2]) / d + (rgb[1] < rgb[2] ? 6.0f : 0.0f);
+    else if (mx == rgb[1]) hsl[0] = (rgb[2] - rgb[0]) / d + 2.0f;
+    else hsl[0] = (rgb[0] - rgb[1]) / d + 4.0f;
+    hsl[0] *= 60.0f;
+}
+
+static float hue_channel( float p, float q, float t )
+{
+    if (t < 0.0f) t += 1.0f;
+    if (t > 1.0f) t -= 1.0f;
+    if (t < 1.0f / 6.0f) return p + (q - p) * 6.0f * t;
+    if (t < 0.5f) return q;
+    if (t < 2.0f / 3.0f) return p + (q - p) * (2.0f / 3.0f - t) * 6.0f;
+    return p;
+}
+
+static void hsl_to_rgb( const float *hsl, float *rgb )
+{
+    float h = hsl[0] / 360.0f, s = hsl[1], l = hsl[2], q, p;
+
+    if (s <= 0.0f)
+    {
+        rgb[0] = rgb[1] = rgb[2] = l;
+        return;
+    }
+    q = l < 0.5f ? l * (1.0f + s) : l + s - l * s;
+    p = 2.0f * l - q;
+    rgb[0] = hue_channel( p, q, h + 1.0f / 3.0f );
+    rgb[1] = hue_channel( p, q, h );
+    rgb[2] = hue_channel( p, q, h - 1.0f / 3.0f );
+}
+
+/* a and b as A, R, G, B (0-255); alpha always straight */
+static void interpolate_color( CompositionColorSpace space, const float *a, const float *b, float t, float *out )
+{
+    BOOL linear = space == CompositionColorSpace_RgbLinear || space == CompositionColorSpace_HslLinear;
+    BOOL hsl = space == CompositionColorSpace_Hsl || space == CompositionColorSpace_HslLinear;
+    float ca[3], cb[3], c[3];
+    UINT i;
+
+    out[0] = a[0] + (b[0] - a[0]) * t;
+    for (i = 0; i < 3; i++)
+    {
+        ca[i] = linear ? srgb_to_linear( a[i + 1] ) : a[i + 1] / 255.0f;
+        cb[i] = linear ? srgb_to_linear( b[i + 1] ) : b[i + 1] / 255.0f;
+    }
+    if (hsl)
+    {
+        float ha[3], hb[3], hc[3], dh;
+
+        rgb_to_hsl( ca, ha );
+        rgb_to_hsl( cb, hb );
+        /* a grey has no hue: it takes the other colour's */
+        if (ha[1] <= 0.0f) ha[0] = hb[0];
+        if (hb[1] <= 0.0f) hb[0] = ha[0];
+        /* the hue the shorter way round (GUESS) */
+        dh = hb[0] - ha[0];
+        if (dh > 180.0f) dh -= 360.0f;
+        else if (dh < -180.0f) dh += 360.0f;
+        hc[0] = ha[0] + dh * t;
+        if (hc[0] < 0.0f) hc[0] += 360.0f;
+        else if (hc[0] >= 360.0f) hc[0] -= 360.0f;
+        hc[1] = ha[1] + (hb[1] - ha[1]) * t;
+        hc[2] = ha[2] + (hb[2] - ha[2]) * t;
+        hsl_to_rgb( hc, c );
+    }
+    else for (i = 0; i < 3; i++) c[i] = ca[i] + (cb[i] - ca[i]) * t;
+    for (i = 0; i < 3; i++) out[i + 1] = linear ? linear_to_srgb( c[i] ) : c[i] * 255.0f;
+}
+#endif
+
 static void interpolate( const struct running *r, const float *a, const float *b, float t, float *out )
 {
     UINT i, size = kind_size( r->kind );
@@ -2357,6 +2458,14 @@
         anim_slerp( a, b, t, out );
         return;
     }
+#ifndef SG_MUTANT_COLOR_SPACE_RGB_ONLY
+    if (r->kind == ANIM_COLOR && r->color_space != CompositionColorSpace_Auto &&
+        r->color_space != CompositionColorSpace_Rgb && !r->prop.comp_count)
+    {
+        interpolate_color( r->color_space, a, b, t, out );
+        return;
+    }
+#endif
     for (i = 0; i < size; i++) out[i] = a[i] + (b[i] - a[i]) * t;
 }
 
@@ -2750,6 +2859,7 @@
     r->duration = anim->duration.Duration;
     r->iterations = anim->iteration_behavior == AnimationIterationBehavior_Forever ? 0 : anim->iteration_count;
     r->stop_behavior = anim->stop_behavior;
+    r->color_space = anim->color_space;
     r->frame = clock->frame;
     LIST_FOR_EACH_ENTRY( batch, &clock->scoped, struct batch, entry ) running_join( r, batch );
     if (clock->commit) running_join( r, clock->commit );
