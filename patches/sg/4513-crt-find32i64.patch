 }
 
+/*********************************************************************
+ *		_wfindfirst32i64 (MSVCR80.@)
+ *
+ * Unicode version of _findfirst32i64.
+ */
+intptr_t CDECL _wfindfirst32i64(const wchar_t *fspec, struct _wfinddata32i64_t *ft)
+{
+  WIN32_FIND_DATAW find_data;
+  HANDLE hfind;
+
+  hfind  = FindFirstFileW(fspec, &find_data);
+  if (hfind == INVALID_HANDLE_VALUE)
+  {
+    msvcrt_set_errno(GetLastError());
+    return -1;
+  }
+  msvcrt_wfttofd32i64(&find_data, ft);
+  TRACE(":got handle %p\n", hfind);
+  return (intptr_t)hfind;
+}
+
+static int finddata32i64_wtoa(const struct _wfinddata32i64_t *wfd, struct _finddata32i64_t *fd)
+{
+    fd->attrib = wfd->attrib;
+    fd->time_create = wfd->time_create;
+    fd->time_access = wfd->time_access;
+    fd->time_write = wfd->time_write;
+    fd->size = wfd->size;
+    return convert_wcs_to_acp_utf8(wfd->name, fd->name, ARRAY_SIZE(fd->name));
+}
+
+/*********************************************************************
+ *		_findfirst32i64 (MSVCR80.@)
+ *
+ * 32-bit time, 64-bit size version of _findfirst.
+ */
+intptr_t CDECL _findfirst32i64(const char *fspec, struct _finddata32i64_t *ft)
+{
+    struct _wfinddata32i64_t wft;
+    wchar_t *fspecW = NULL;
+    intptr_t ret;
+
+    if (fspec && !(fspecW = wstrdupa_utf8(fspec))) return -1;
+    ret = _wfindfirst32i64(fspecW, &wft);
+    free(fspecW);
+    if (ret != -1 && !finddata32i64_wtoa(&wft, ft))
+    {
+        _findclose(ret);
+        return -1;
+    }
+    return ret;
+}
+
+/*********************************************************************
+ *		_wfindnext32i64 (MSVCR80.@)
+ *
+ * Unicode version of _findnext32i64.
+ */
+int CDECL _wfindnext32i64(intptr_t hand, struct _wfinddata32i64_t *ft)
+{
+  WIN32_FIND_DATAW find_data;
+
+  if (!FindNextFileW((HANDLE)hand, &find_data))
+  {
+    *_errno() = ENOENT;
+    return -1;
+  }
+
+  msvcrt_wfttofd32i64(&find_data, ft);
+  return 0;
+}
+
+/*********************************************************************
+ *		_findnext32i64 (MSVCR80.@)
+ */
+int CDECL _findnext32i64(intptr_t hand, struct _finddata32i64_t *ft)
+{
+    struct _wfinddata32i64_t wft;
+    int ret;
+
+    ret = _wfindnext32i64(hand, &wft);
+    if (!ret && !finddata32i64_wtoa(&wft, ft)) ret = -1;
+    return ret;
+}
+
