From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, win32u, wine.inf: layout-id keyboard layouts (KLIDs such as 00010409 US-Dvorak)

wine.inf lists the layout-id KLIDs winex11 builds from XKB (HKLM Keyboard Layouts, Layout Id/Layout Text), so LoadKeyboardLayout("00010409") gives HKL 0xf0020409 and GetKeyboardLayoutName gives the KLID back. winex11 resolves a 0xfXXX HKL through that catalogue to the KLID's XKB variant (us dvorak/intl/dvorak-l/-r, ca fr-legacy/multix, cz/sk qwerty, pl qwertz, ru typewriter/phonetic, tr f, th pat); Dvorak names its punctuation keys by character (VK_OEM_7 on scan 0x10, as Windows). An unknown layout id is still the X map. GetKeyboardLayoutList with nothing loaded no longer lists the catalogue. Before, LoadKeyboardLayout("00010409") gave plain US and a 0xfXXX HKL always answered with the X map.
---
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1532,6 +1532,10 @@
         if (count == size) return count;
     }
 
+    /* Stained Glass OS (8212): "Keyboard Layouts" is the catalogue of installed layouts (wine.inf
+     * lists the layout-id ones winex11 can build), not the user's loaded list; with nothing loaded
+     * the list is the locale's layout, as on a fresh Windows profile. */
+#ifdef SG_MUTANT_KBD_NO_KLID
     if ((hkey = reg_open_key( NULL, keyboard_layouts_keyW, sizeof(keyboard_layouts_keyW) )))
     {
         while (!NtEnumerateKey( hkey, i++, KeyNodeInformation, key_info,
@@ -1557,6 +1561,9 @@
         }
         NtClose( hkey );
     }
+#else
+    (void)hkey; (void)subkey; (void)i; (void)tmp; (void)key_info; (void)value_info;
+#endif
 
     return count;
 }
--- a/dlls/winex11.drv/xkbtables.c
+++ b/dlls/winex11.drv/xkbtables.c
@@ -85,6 +85,66 @@
     { 0x043e, "my" },     { 0x0441, "ke" },     { 0x0436, "za" },     { 0x043a, "mt" },
 };
 
+#ifndef SG_MUTANT_KBD_NO_KLID
+/* (wine-sg 8212) the XKB variants of the layout-id layouts (KLIDs with a "Layout Id" in
+ * HKLM\System\CurrentControlSet\Control\Keyboard Layouts, wine.inf SgKeyboardLayouts) */
+static const struct
+{
+    DWORD klid;
+    const char *layout;
+    const char *variant;
+} xkb_klids[] =
+{
+    { 0x00020409, "us", "intl" },     { 0x00010409, "us", "dvorak" },   { 0x00030409, "us", "dvorak-l" },
+    { 0x00040409, "us", "dvorak-r" }, { 0x00010c0c, "ca", "fr-legacy" }, { 0x00011009, "ca", "multix" },
+    { 0x00010405, "cz", "qwerty" },   { 0x0001041b, "sk", "qwerty" },   { 0x00010415, "pl", "qwertz" },
+    { 0x00010419, "ru", "typewriter" }, { 0x00020419, "ru", "phonetic" }, { 0x0001041f, "tr", "f" },
+    { 0x0001041e, "th", "pat" },
+};
+
+/* the KLID whose "Layout Id" is id, 0 if none */
+static DWORD klid_from_layout_id( UINT id )
+{
+    static const WCHAR keyboard_layouts_keyW[] =
+    {
+        '\\','R','e','g','i','s','t','r','y','\\','M','a','c','h','i','n','e','\\',
+        'S','y','s','t','e','m','\\','C','u','r','r','e','n','t','C','o','n','t','r','o','l','S','e','t','\\',
+        'C','o','n','t','r','o','l','\\','K','e','y','b','o','a','r','d',' ','L','a','y','o','u','t','s'
+    };
+    static const WCHAR layout_idW[] = {'L','a','y','o','u','t',' ','I','d',0};
+    char buffer[4096];
+    KEY_NODE_INFORMATION *key = (KEY_NODE_INFORMATION *)buffer;
+    KEY_VALUE_PARTIAL_INFORMATION *value = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    WCHAR name[16], *end;
+    HKEY hkey, subkey;
+    ULONG len, i = 0;
+    DWORD klid = 0;
+
+    if (!(hkey = reg_open_key( NULL, keyboard_layouts_keyW, sizeof(keyboard_layouts_keyW) ))) return 0;
+    while (!klid && !NtEnumerateKey( hkey, i++, KeyNodeInformation, key, sizeof(buffer) - sizeof(WCHAR), &len ))
+    {
+        if (key->NameLength >= sizeof(name)) continue;
+        memcpy( name, key->Name, key->NameLength );
+        name[key->NameLength / sizeof(WCHAR)] = 0;
+        if (!(subkey = reg_open_key( hkey, name, key->NameLength ))) continue;
+        if (query_reg_value( subkey, layout_idW, value, sizeof(buffer) ) && value->Type == REG_SZ &&
+            (ntdll_wcstoul( (const WCHAR *)value->Data, &end, 16 ) & 0xfff) == id)
+            klid = ntdll_wcstoul( name, &end, 16 );
+        NtClose( subkey );
+    }
+    NtClose( hkey );
+    return klid;
+}
+
+static int find_xkb_klid( DWORD klid )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(xkb_klids); i++) if (xkb_klids[i].klid == klid) return i;
+    return -1;
+}
+#endif
+
 static int find_xkb_name( LANGID lang )
 {
     unsigned int i;
@@ -178,7 +238,7 @@
 struct foreign_layout
 {
     struct list entry;
-    LANGID lang;
+    DWORD key;             /* the LANGID, or (8212) the KLID of a layout-id layout */
     BOOL valid;            /* FALSE: the layout could not be built, the X map answers */
     KBDTABLES tables;
     USHORT vsc2vk[0x80];
@@ -235,15 +295,25 @@
     TRACE( "X keyboard map: layout %s variant %s\n", debugstr_a(x_layout), debugstr_a(x_variant) );
 }
 
-static WORD vkey_for_key( struct xkb_state *state, xkb_keycode_t keyc, BYTE scan, const USHORT *base )
+static WORD vkey_for_key( struct xkb_state *state, xkb_keycode_t keyc, BYTE scan, const USHORT *base, BOOL by_char )
 {
+    /* (8212) the US punctuation keys' virtual keys, for the layouts that name every key by what it types */
+    static const struct { char ch; BYTE vk; } oem_by_char[] =
+    {
+        { '\'', VK_OEM_7 }, { ',', VK_OEM_COMMA }, { '.', VK_OEM_PERIOD }, { ';', VK_OEM_1 }, { '/', VK_OEM_2 },
+        { '`', VK_OEM_3 }, { '[', VK_OEM_4 }, { '\\', VK_OEM_5 }, { ']', VK_OEM_6 }, { '-', VK_OEM_MINUS },
+        { '=', VK_OEM_PLUS },
+    };
     uint32_t ch;
+    unsigned int i;
 
     xkb_state_update_mask( state, 0, 0, 0, 0, 0, 0 );
     ch = xkb_state_key_get_utf32( state, keyc );
     /* Windows names a key by the letter it types */
     if (ch >= 'a' && ch <= 'z') return ch - 'a' + 'A';
     if (ch >= 'A' && ch <= 'Z') return ch;
+    if (by_char)
+        for (i = 0; i < ARRAY_SIZE(oem_by_char); i++) if (ch == (BYTE)oem_by_char[i].ch) return oem_by_char[i].vk;
     return base[scan];
 }
 
@@ -396,7 +466,7 @@
     TRACE( "%u dead-key compositions\n", count );
 }
 
-static void build_layout( struct foreign_layout *layout, int name )
+static void build_layout( struct foreign_layout *layout, const char *xkb_layout, const char *xkb_variant )
 {
     struct xkb_rule_names names = {.rules = "evdev", .model = "pc105"};
     const USHORT *base = scan2vk_us;
@@ -404,11 +474,12 @@
     struct xkb_keymap *keymap;
     struct xkb_state *state;
     USHORT vk_fr[0x80], vk_de[0x80];
+    BOOL by_char = FALSE;
     unsigned int i, mod;
     BYTE scan;
 
-    names.layout = xkb_names[name].layout;
-    names.variant = xkb_names[name].variant;
+    names.layout = xkb_layout;
+    names.variant = xkb_variant;
 
     if (!xkb_context && !(xkb_context = xkb_context_new( XKB_CONTEXT_NO_FLAGS ))) return;
     if (!(keymap = xkb_keymap_new_from_names( xkb_context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS )))
@@ -428,10 +499,14 @@
     for (i = 0; oem_de[i].scan; i++) vk_de[oem_de[i].scan] = oem_de[i].vk;
     if (!strcmp( names.layout, "fr" ) && !names.variant) base = vk_fr;
     else if ((!strcmp( names.layout, "de" ) || !strcmp( names.layout, "at" )) && !names.variant) base = vk_de;
+#ifndef SG_MUTANT_KBD_NO_KLID
+    /* Windows' Dvorak layouts name the punctuation keys by the character too, as US does */
+    by_char = names.variant && !strncmp( names.variant, "dvorak", 6 );
+#endif
 
     /* the main block and keypad: evdev key codes there are the scan codes */
     for (scan = 0; scan < 0x59; scan++)
-        layout->vsc2vk[scan] = scan ? vkey_for_key( state, scan + 8, scan, base ) | (base[scan] & 0xff00) : 0;
+        layout->vsc2vk[scan] = scan ? vkey_for_key( state, scan + 8, scan, base, by_char ) | (base[scan] & 0xff00) : 0;
     for (; scan < 0x80; scan++) layout->vsc2vk[scan] = scan2vk_us[scan];
 #ifdef SG_MUTANT_KBD_US_VKEYS
     memcpy( layout->vsc2vk, scan2vk_us, sizeof(layout->vsc2vk) );
@@ -517,19 +592,39 @@
 {
     struct foreign_layout *layout;
     LANGID lang = HIWORD( (UINT_PTR)hkl );
+    const char *xkb_layout, *xkb_variant;
+    DWORD key;
     LCID locale;
     int name;
 
-    if (!hkl || (lang & 0xf000) == 0xf000) return NULL; /* layout ids: the X map */
-    NtQueryDefaultLocale( TRUE, &locale );
-    if (lang == LANGIDFROMLCID( locale )) return NULL; /* the session's own layout is the X map */
-    if ((name = find_xkb_name( lang )) < 0) return NULL;
+    if (!hkl) return NULL;
+    if ((lang & 0xf000) == 0xf000)
+    {
+#ifndef SG_MUTANT_KBD_NO_KLID
+        /* a layout id: the KLID that has it, and that KLID's XKB variant (8212) */
+        DWORD klid = klid_from_layout_id( lang & 0xfff );
+        if ((name = find_xkb_klid( klid )) < 0) return NULL; /* not one of ours: the X map */
+        key = klid;
+        xkb_layout = xkb_klids[name].layout;
+        xkb_variant = xkb_klids[name].variant;
+#else
+        return NULL; /* layout ids: the X map */
+#endif
+    }
+    else
+    {
+        NtQueryDefaultLocale( TRUE, &locale );
+        if (lang == LANGIDFROMLCID( locale )) return NULL; /* the session's own layout is the X map */
+        if ((name = find_xkb_name( lang )) < 0) return NULL;
+        key = xkb_names[name].lang;
+        xkb_layout = xkb_names[name].layout;
+        xkb_variant = xkb_names[name].variant;
+    }
 
     pthread_mutex_lock( &foreign_mutex );
     if (!x_names_known) read_x_layout_names();
 #ifndef SG_MUTANT_KBD_ALWAYS_X
-    if (x_layout[0] && !strcmp( x_layout, xkb_names[name].layout ) &&
-        !strcmp( x_variant, xkb_names[name].variant ? xkb_names[name].variant : "" ))
+    if (x_layout[0] && !strcmp( x_layout, xkb_layout ) && !strcmp( x_variant, xkb_variant ? xkb_variant : "" ))
 #endif
     {
         pthread_mutex_unlock( &foreign_mutex );
@@ -537,15 +632,15 @@
     }
 
     LIST_FOR_EACH_ENTRY( layout, &foreign_layouts, struct foreign_layout, entry )
-        if (layout->lang == xkb_names[name].lang) goto done;
+        if (layout->key == key) goto done;
 
     if ((layout = calloc( 1, sizeof(*layout) )))
     {
-        layout->lang = xkb_names[name].lang;
-        build_layout( layout, name );
+        layout->key = key;
+        build_layout( layout, xkb_layout, xkb_variant );
         list_add_tail( &foreign_layouts, &layout->entry );
-        TRACE( "hkl %p: layout %s(%s) %s\n", hkl, xkb_names[name].layout,
-               debugstr_a(xkb_names[name].variant), layout->valid ? "built" : "unavailable" );
+        TRACE( "hkl %p: layout %s(%s) %s\n", hkl, xkb_layout, debugstr_a(xkb_variant),
+               layout->valid ? "built" : "unavailable" );
     }
 done:
     pthread_mutex_unlock( &foreign_mutex );
