From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: device class keys, global state, dock station (2035)

The device class key calls: CM_Open_Class_Key(_Ex) (A and W; the installer
key under Control\Class or, with the flag, DeviceClasses; open existing or
always, the root of the classes without a GUID; a key made here is given its
Class name), CM_Delete_Class_Key(_Ex) (a class with subkeys needs the
subkeys flag), CM_Get_Class_Name(_Ex) (A and W), CM_Get_Global_State(_Ex),
CM_Get_Version_Ex and CM_Is_Dock_Station_Present, exported from setupapi
and forwarded by cfgmgr32.
---
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -5117,6 +5117,233 @@
     return CM_Get_Class_Key_Name_ExA(class, name, len, flags, NULL);
 }
 
+/* Class keys: Control\Class\{guid} (the installer's) or Control\DeviceClasses\{guid} */
+static CONFIGRET class_key_path(const GUID *class, ULONG flags, WCHAR *path)
+{
+    lstrcpyW(path, L"SYSTEM\\CurrentControlSet\\Control\\");
+    lstrcatW(path, (flags & 1) ? L"DeviceClasses" : L"Class");
+    if (class)
+    {
+        lstrcatW(path, L"\\");
+        SETUPDI_GuidToString(class, path + lstrlenW(path));
+    }
+    return CR_SUCCESS;
+}
+
+static CONFIGRET registry_error_to_cr(LONG err)
+{
+    switch (err)
+    {
+    case ERROR_SUCCESS: return CR_SUCCESS;
+    case ERROR_FILE_NOT_FOUND:
+    case ERROR_PATH_NOT_FOUND: return CR_NO_SUCH_REGISTRY_KEY;
+    case ERROR_ACCESS_DENIED: return CR_ACCESS_DENIED;
+    default: return CR_REGISTRY_ERROR;
+    }
+}
+
+/***********************************************************************
+ *      CM_Open_Class_Key_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Open_Class_Key_ExW(GUID *class, const WCHAR *class_name, REGSAM access,
+        REGDISPOSITION disposition, HKEY *key, ULONG flags, HMACHINE machine)
+{
+    WCHAR path[128];
+    DWORD created;
+    LONG err;
+    HKEY ret;
+
+    TRACE("%s, %s, %#lx, %lu, %p, %#lx, %p\n", debugstr_guid(class), debugstr_w(class_name), access,
+            disposition, key, flags, machine);
+
+    if (!key) return CR_INVALID_POINTER;
+    *key = NULL;
+    if (flags & ~1) return CR_INVALID_FLAG;
+    if (disposition != RegDisposition_OpenAlways && disposition != RegDisposition_OpenExisting) return CR_INVALID_DATA;
+
+    class_key_path(class, flags, path);
+    if (disposition == RegDisposition_OpenExisting)
+        err = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, access, &ret);
+    else
+        err = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, access, NULL, &ret, &created);
+    if (err) return registry_error_to_cr(err);
+
+    /* a class key made here is named */
+#ifndef SG_MUTANT_CLASSKEY_NAME
+    if (disposition == RegDisposition_OpenAlways && created == REG_CREATED_NEW_KEY && class && class_name && !(flags & 1))
+        RegSetValueExW(ret, Class, 0, REG_SZ, (const BYTE *)class_name, (lstrlenW(class_name) + 1) * sizeof(WCHAR));
+#endif
+    *key = ret;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Open_Class_KeyW(GUID *class, const WCHAR *class_name, REGSAM access,
+        REGDISPOSITION disposition, HKEY *key, ULONG flags)
+{
+    return CM_Open_Class_Key_ExW(class, class_name, access, disposition, key, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Open_Class_Key_ExA(GUID *class, const char *class_name, REGSAM access,
+        REGDISPOSITION disposition, HKEY *key, ULONG flags, HMACHINE machine)
+{
+    WCHAR nameW[MAX_CLASS_NAME_LEN];
+
+    if (class_name && !MultiByteToWideChar(CP_ACP, 0, class_name, -1, nameW, ARRAY_SIZE(nameW)))
+    {
+        if (key) *key = NULL;
+        return CR_INVALID_DATA;
+    }
+    return CM_Open_Class_Key_ExW(class, class_name ? nameW : NULL, access, disposition, key, flags, machine);
+}
+
+CONFIGRET WINAPI CM_Open_Class_KeyA(GUID *class, const char *class_name, REGSAM access,
+        REGDISPOSITION disposition, HKEY *key, ULONG flags)
+{
+    return CM_Open_Class_Key_ExA(class, class_name, access, disposition, key, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Delete_Class_Key_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Delete_Class_Key_Ex(GUID *class, ULONG flags, HMACHINE machine)
+{
+    WCHAR path[128];
+    HKEY key;
+    LONG err;
+
+    TRACE("%s, %#lx, %p\n", debugstr_guid(class), flags, machine);
+
+    if (!class) return CR_INVALID_POINTER;
+    if (flags > 1) return CR_INVALID_FLAG;
+
+    class_key_path(class, 0, path);
+    if ((err = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key))) return registry_error_to_cr(err);
+    RegCloseKey(key);
+
+    /* only the class (its subkeys make it fail), or the class with its subkeys */
+    if (flags) err = RegDeleteTreeW(HKEY_LOCAL_MACHINE, path);
+    else err = RegDeleteKeyW(HKEY_LOCAL_MACHINE, path);
+    if (!err) return CR_SUCCESS;
+    if (err == ERROR_ACCESS_DENIED && !flags)
+    {
+        /* a key with subkeys cannot be deleted without them */
+        if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key))
+        {
+            DWORD subkeys = 0;
+            RegQueryInfoKeyW(key, NULL, NULL, NULL, &subkeys, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+            RegCloseKey(key);
+            if (subkeys) return CR_REGISTRY_ERROR;
+        }
+    }
+    return registry_error_to_cr(err);
+}
+
+CONFIGRET WINAPI CM_Delete_Class_Key(GUID *class, ULONG flags)
+{
+    return CM_Delete_Class_Key_Ex(class, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Get_Class_Name_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Class_Name_ExW(GUID *class, WCHAR *name, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    WCHAR path[128];
+    DWORD size, type;
+    HKEY key;
+    LONG err;
+
+    TRACE("%s, %p, %p, %#lx, %p\n", debugstr_guid(class), name, len, flags, machine);
+
+    if (!class || !len || (!name && *len)) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+
+    class_key_path(class, 0, path);
+    if ((err = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key))) return registry_error_to_cr(err);
+
+    size = *len * sizeof(WCHAR);
+    err = RegQueryValueExW(key, Class, NULL, &type, (BYTE *)name, &size);
+    RegCloseKey(key);
+    if (err == ERROR_MORE_DATA || (!err && !name))
+    {
+        *len = size / sizeof(WCHAR);
+        return CR_BUFFER_SMALL;
+    }
+    if (err || type != REG_SZ) return CR_REGISTRY_ERROR;
+    *len = size / sizeof(WCHAR);
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_Class_NameW(GUID *class, WCHAR *name, ULONG *len, ULONG flags)
+{
+    return CM_Get_Class_Name_ExW(class, name, len, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_Class_Name_ExA(GUID *class, char *name, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    WCHAR nameW[MAX_CLASS_NAME_LEN];
+    ULONG lenW = ARRAY_SIZE(nameW);
+    CONFIGRET cr;
+    int need;
+
+    if (!len || (!name && *len)) return CR_INVALID_POINTER;
+    if ((cr = CM_Get_Class_Name_ExW(class, nameW, &lenW, flags, machine))) return cr;
+    need = WideCharToMultiByte(CP_ACP, 0, nameW, -1, NULL, 0, NULL, NULL);
+    if (*len < need)
+    {
+        *len = need;
+        return CR_BUFFER_SMALL;
+    }
+    WideCharToMultiByte(CP_ACP, 0, nameW, -1, name, *len, NULL, NULL);
+    *len = need;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_Class_NameA(GUID *class, char *name, ULONG *len, ULONG flags)
+{
+    return CM_Get_Class_Name_ExA(class, name, len, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Get_Global_State_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Global_State_Ex(ULONG *state, ULONG flags, HMACHINE machine)
+{
+    TRACE("%p, %#lx, %p\n", state, flags, machine);
+
+    if (!state) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    /* user interface can be shown and the PnP services are there */
+    *state = 0x1 | 0x4; /* CM_GLOBAL_STATE_CAN_DO_UI | CM_GLOBAL_STATE_SERVICES_AVAILABLE */
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_Global_State(ULONG *state, ULONG flags)
+{
+    return CM_Get_Global_State_Ex(state, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Get_Version_Ex (SETUPAPI.@)
+ */
+WORD WINAPI CM_Get_Version_Ex(HMACHINE machine)
+{
+    TRACE("%p\n", machine);
+    return 0x0400;
+}
+
+/***********************************************************************
+ *      CM_Is_Dock_Station_Present (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Is_Dock_Station_Present(BOOL *present)
+{
+    TRACE("%p\n", present);
+
+    if (!present) return CR_INVALID_POINTER;
+    *present = FALSE;
+    return CR_SUCCESS;
+}
+
