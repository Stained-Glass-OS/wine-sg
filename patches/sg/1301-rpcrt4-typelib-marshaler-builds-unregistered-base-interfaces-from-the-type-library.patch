From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: the type library marshaler marshals inherited methods of unregistered base interfaces from the type library

Microsoft Edge's elevation service (the service behind its App-Bound
cookie encryption) registers one interface for marshaling, IElevatorEdge,
with the type library marshaler; IElevatorEdge adds no methods of its own
and derives from IElevator2 : IElevator : IElevatorEdgeBase : IUnknown,
none of which is registered. Wine's typelib proxies and stubs delegated
the inherited methods to the base interface's own registered proxy/stub,
found none, and failed: the service's stub could not be made ("Failed to
create an IRpcStubBuffer from IPSFactory for {c9c2b807-...} with error
0x80040155", REGDB_E_IIDNOTREG) and no call ever reached the service.
Windows builds such an interface's whole vtable from its type library. Now
a base interface without its own proxy/stub registration is marshaled from
the type library too, down to the nearest base that is registered (or
IUnknown), which the proxy and stub still delegate to.

Test: test/tlbbase-gate.sh with test/tlbbase.idl and test/tlbbase-probe.c
(mutant SG_MUTANT_TLB_UNREGISTERED_BASE).
---
--- a/dlls/rpcrt4/ndr_typelib.c
+++ b/dlls/rpcrt4/ndr_typelib.c
@@ -1317,20 +1317,60 @@
 }
 
 static HRESULT write_iface_fs(ITypeInfo *typeinfo, WORD funcs, WORD parentfuncs,
+        WORD basefuncs, WORD ptrsize, unsigned char *type, size_t *typelen,
+        unsigned char *proc, size_t *proclen, unsigned short *offset);
+
+/* Stained Glass OS: the methods typeinfo inherits from its parent, down to
+ * vtable slot basefuncs, written from the type library like its own (see
+ * get_iface_info). An interface's own methods are the last cFuncs slots of
+ * its vtable. */
+static HRESULT write_parent_fs(ITypeInfo *typeinfo, WORD basefuncs, WORD ptrsize,
         unsigned char *type, size_t *typelen, unsigned char *proc,
         size_t *proclen, unsigned short *offset)
 {
+    ITypeInfo *parentinfo;
+    TYPEATTR *typeattr;
+    HREFTYPE reftype;
+    WORD own, first;
+    HRESULT hr;
+
+    hr = ITypeInfo_GetRefTypeOfImplType(typeinfo, 0, &reftype);
+    if (FAILED(hr)) return hr;
+    hr = ITypeInfo_GetRefTypeInfo(typeinfo, reftype, &parentinfo);
+    if (FAILED(hr)) return hr;
+    hr = ITypeInfo_GetTypeAttr(parentinfo, &typeattr);
+    if (SUCCEEDED(hr))
+    {
+        own = typeattr->cFuncs;
+        first = typeattr->cbSizeVft / ptrsize - own;
+        ITypeInfo_ReleaseTypeAttr(parentinfo, typeattr);
+        hr = write_iface_fs(parentinfo, own, first, basefuncs, ptrsize, type, typelen, proc, proclen, offset);
+    }
+    ITypeInfo_Release(parentinfo);
+    return hr;
+}
+
+static HRESULT write_iface_fs(ITypeInfo *typeinfo, WORD funcs, WORD parentfuncs,
+        WORD basefuncs, WORD ptrsize, unsigned char *type, size_t *typelen,
+        unsigned char *proc, size_t *proclen, unsigned short *offset)
+{
     unsigned short stack_offset;
     WORD proc_idx, param_idx;
     FUNCDESC *desc;
     HRESULT hr;
 
-    for (proc_idx = 3; proc_idx < parentfuncs; proc_idx++)
+    for (proc_idx = 3; proc_idx < basefuncs; proc_idx++)
     {
         if (offset)
             offset[proc_idx - 3] = -1;
     }
 
+    if (parentfuncs > basefuncs)
+    {
+        hr = write_parent_fs(typeinfo, basefuncs, ptrsize, type, typelen, proc, proclen, offset);
+        if (FAILED(hr)) return hr;
+    }
+
     for (proc_idx = 0; proc_idx < funcs; proc_idx++)
     {
         TRACE("Writing procedure %d.\n", proc_idx);
@@ -1366,7 +1406,7 @@
 }
 
 static HRESULT build_format_strings(ITypeInfo *typeinfo, WORD funcs,
-        WORD parentfuncs, const unsigned char **type_ret,
+        WORD parentfuncs, WORD basefuncs, WORD ptrsize, const unsigned char **type_ret,
         const unsigned char **proc_ret, unsigned short **offset_ret)
 {
     size_t tfs_size;
@@ -1376,7 +1416,7 @@
     unsigned short *offset;
     HRESULT hr;
 
-    hr = write_iface_fs(typeinfo, funcs, parentfuncs, NULL, &typelen, NULL, &proclen, NULL);
+    hr = write_iface_fs(typeinfo, funcs, parentfuncs, basefuncs, ptrsize, NULL, &typelen, NULL, &proclen, NULL);
     if (FAILED(hr)) return hr;
 
     type = malloc(typelen);
@@ -1393,7 +1433,7 @@
     typelen = tfs_size;
     proclen = 0;
 
-    hr = write_iface_fs(typeinfo, funcs, parentfuncs, type, &typelen, proc, &proclen, offset);
+    hr = write_iface_fs(typeinfo, funcs, parentfuncs, basefuncs, ptrsize, type, &typelen, proc, &proclen, offset);
     if (SUCCEEDED(hr))
     {
         *type_ret = type;
@@ -1409,9 +1449,12 @@
     return hr;
 }
 
-/* Common helper for Create{Proxy,Stub}FromTypeInfo(). */
+/* Common helper for Create{Proxy,Stub}FromTypeInfo(). *basefuncs is the
+ * number of vtable slots of *parentiid, the base interface the proxy or
+ * stub delegates to; the slots between it and *parentfuncs are inherited
+ * methods marshaled from the type library. */
 static HRESULT get_iface_info(ITypeInfo *typeinfo, WORD *funcs, WORD *parentfuncs,
-        GUID *parentiid, ITypeInfo **real_typeinfo)
+        WORD *basefuncs, WORD *ptrsize, GUID *parentiid, ITypeInfo **real_typeinfo)
 {
     ITypeInfo *parentinfo;
     TYPEATTR *typeattr;
@@ -1471,12 +1514,41 @@
     if (FAILED(hr))
         goto err;
 
+    *ptrsize = syskind == SYS_WIN64 ? 8 : 4;
+    *basefuncs = *parentfuncs;
     hr = ITypeInfo_GetTypeAttr(parentinfo, &typeattr);
     if (SUCCEEDED(hr))
     {
         *parentiid = typeattr->guid;
         ITypeInfo_ReleaseTypeAttr(parentinfo, typeattr);
     }
+#ifndef SG_MUTANT_TLB_UNREGISTERED_BASE
+    /* Stained Glass OS: a base interface with no proxy/stub of its own
+     * registered (Edge's elevation service registers IElevatorEdge only, not
+     * the IElevator2 -> IElevator -> IElevatorEdgeBase it derives from) is
+     * marshaled from the type library too, down to the nearest base that is
+     * registered, or IUnknown. Delegating to it failed with
+     * REGDB_E_IIDNOTREG, and no call to the service could be made. */
+    while (SUCCEEDED(hr) && !IsEqualGUID(parentiid, &IID_IUnknown) && !IsEqualGUID(parentiid, &IID_IDispatch))
+    {
+        CLSID clsid;
+        ITypeInfo *grandinfo;
+
+        if (SUCCEEDED(CoGetPSClsid(parentiid, &clsid))) break;
+        TRACE("base %s has no proxy/stub registered: from the type library\n", debugstr_guid(parentiid));
+        if (FAILED(ITypeInfo_GetRefTypeOfImplType(parentinfo, 0, &reftype))) break;
+        if (FAILED(ITypeInfo_GetRefTypeInfo(parentinfo, reftype, &grandinfo))) break;
+        ITypeInfo_Release(parentinfo);
+        parentinfo = grandinfo;
+        hr = ITypeInfo_GetTypeAttr(parentinfo, &typeattr);
+        if (SUCCEEDED(hr))
+        {
+            *parentiid = typeattr->guid;
+            *basefuncs = typeattr->cbSizeVft / *ptrsize;
+            ITypeInfo_ReleaseTypeAttr(parentinfo, typeattr);
+        }
+    }
+#endif
     ITypeInfo_Release(parentinfo);
     if (SUCCEEDED(hr))
         return hr;
@@ -1570,7 +1642,7 @@
         REFIID iid, IRpcProxyBuffer **proxy_buffer, void **out)
 {
     struct typelib_proxy *proxy;
-    WORD funcs, parentfuncs, i;
+    WORD funcs, parentfuncs, basefuncs, ptrsize, i;
     ITypeInfo *real_typeinfo;
     GUID parentiid;
     HRESULT hr;
@@ -1578,7 +1650,7 @@
     TRACE("typeinfo %p, outer %p, iid %s, proxy_buffer %p, out %p.\n",
             typeinfo, outer, debugstr_guid(iid), proxy_buffer, out);
 
-    hr = get_iface_info(typeinfo, &funcs, &parentfuncs, &parentiid, &real_typeinfo);
+    hr = get_iface_info(typeinfo, &funcs, &parentfuncs, &basefuncs, &ptrsize, &parentiid, &real_typeinfo);
     if (FAILED(hr))
         return hr;
 
@@ -1603,11 +1675,11 @@
     proxy->proxy_vtbl->header.pStublessProxyInfo = &proxy->proxy_info;
     proxy->iid = *iid;
     proxy->proxy_vtbl->header.piid = &proxy->iid;
-    fill_delegated_proxy_table((IUnknownVtbl *)proxy->proxy_vtbl->Vtbl, parentfuncs);
-    for (i = 0; i < funcs; i++)
-        proxy->proxy_vtbl->Vtbl[parentfuncs + i] = (void *)-1;
+    fill_delegated_proxy_table((IUnknownVtbl *)proxy->proxy_vtbl->Vtbl, basefuncs);
+    for (i = basefuncs; i < funcs + parentfuncs; i++)
+        proxy->proxy_vtbl->Vtbl[i] = (void *)-1;
 
-    hr = build_format_strings(real_typeinfo, funcs, parentfuncs, &proxy->stub_desc.pFormatTypes,
+    hr = build_format_strings(real_typeinfo, funcs, parentfuncs, basefuncs, ptrsize, &proxy->stub_desc.pFormatTypes,
             &proxy->proxy_info.ProcFormatString, &proxy->offset_table);
     ITypeInfo_Release(real_typeinfo);
     if (FAILED(hr))
@@ -1706,7 +1778,7 @@
 HRESULT WINAPI CreateStubFromTypeInfo(ITypeInfo *typeinfo, REFIID iid,
         IUnknown *server, IRpcStubBuffer **stub_buffer)
 {
-    WORD funcs, parentfuncs, i;
+    WORD funcs, parentfuncs, basefuncs, ptrsize, i;
     struct typelib_stub *stub;
     ITypeInfo *real_typeinfo;
     GUID parentiid;
@@ -1715,7 +1787,7 @@
     TRACE("typeinfo %p, iid %s, server %p, stub_buffer %p.\n",
             typeinfo, debugstr_guid(iid), server, stub_buffer);
 
-    hr = get_iface_info(typeinfo, &funcs, &parentfuncs, &parentiid, &real_typeinfo);
+    hr = get_iface_info(typeinfo, &funcs, &parentfuncs, &basefuncs, &ptrsize, &parentiid, &real_typeinfo);
     if (FAILED(hr))
         return hr;
 
@@ -1729,7 +1801,7 @@
     init_stub_desc(&stub->stub_desc);
     stub->server_info.pStubDesc = &stub->stub_desc;
 
-    hr = build_format_strings(real_typeinfo, funcs, parentfuncs, &stub->stub_desc.pFormatTypes,
+    hr = build_format_strings(real_typeinfo, funcs, parentfuncs, basefuncs, ptrsize, &stub->stub_desc.pFormatTypes,
             &stub->server_info.ProcString, &stub->offset_table);
     ITypeInfo_Release(real_typeinfo);
     if (FAILED(hr))
@@ -1747,7 +1819,7 @@
     if (!IsEqualGUID(&parentiid, &IID_IUnknown))
     {
         stub->dispatch_table = malloc((funcs + parentfuncs) * sizeof(void *));
-        for (i = 3; i < parentfuncs; i++)
+        for (i = 3; i < basefuncs; i++)
             stub->dispatch_table[i - 3] = NdrStubForwardingFunction;
         for (; i < funcs + parentfuncs; i++)
             stub->dispatch_table[i - 3] = (PRPC_STUB_FUNCTION)NdrStubCall2;
