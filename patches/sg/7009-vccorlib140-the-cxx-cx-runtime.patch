@@ -22874,6 +22875,7 @@ wine_fn_config_makefile dlls/uxtheme enable_uxtheme
 wine_fn_config_makefile dlls/uxtheme/tests enable_tests
 wine_fn_config_makefile dlls/vbscript enable_vbscript
