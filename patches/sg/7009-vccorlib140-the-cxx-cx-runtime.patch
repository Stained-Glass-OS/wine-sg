diff --git a/dlls/vccorlib140/vccorlib.c b/dlls/vccorlib140/vccorlib.c
new file mode 100644
index 0000000..87cdd11
--- /dev/null
+++ b/dlls/vccorlib140/vccorlib.c
@@ -0,0 +1,415 @@
+/*
+ * C++/CX runtime support (vccorlib140)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Programs written in C++/CX import the Platform runtime from this dll: module
+ * start-up (Platform::Details::InitializeData), class activation by name and the
+ * raisers the compiler calls when a Windows Runtime call fails, which throw a
+ * Platform::Exception^ the program catches by its handle type.
+ *
+ * A thrown Platform::Exception^ is a C++ exception whose object is the handle (an
+ * IInspectable pointer).  Its catchable types are the handle types of the class
+ * and its bases ("Platform::OutOfMemoryException^", "Platform::COMException^",
+ * "Platform::Exception^", "Platform::Object^"), matched by their decorated names.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "initguid.h"
+#include "winstring.h"
+#include "roapi.h"
+#include "inspectable.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(vccorlib);
+
+extern void WINAPI _CxxThrowException(void *object, const void *type);
+
+/* exception object: the handle a Platform::Exception^ holds */
+struct platform_exception
+{
+    IInspectable IInspectable_iface;
+    LONG ref;
+    HRESULT hr;
+    HSTRING message;
+    const WCHAR *class_name;
+};
+
+static inline struct platform_exception *impl_from_IInspectable(IInspectable *iface)
+{
+    return CONTAINING_RECORD(iface, struct platform_exception, IInspectable_iface);
+}
+
+static HRESULT WINAPI exception_QueryInterface(IInspectable *iface, REFIID iid, void **out)
+{
+    TRACE("(%p, %s, %p)\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject))
+    {
+        IInspectable_AddRef((*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI exception_AddRef(IInspectable *iface)
+{
+    struct platform_exception *impl = impl_from_IInspectable(iface);
+    return InterlockedIncrement(&impl->ref);
+}
+
+static ULONG WINAPI exception_Release(IInspectable *iface)
+{
+    struct platform_exception *impl = impl_from_IInspectable(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        WindowsDeleteString(impl->message);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI exception_GetIids(IInspectable *iface, ULONG *count, IID **iids)
+{
+    *count = 0;
+    *iids = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI exception_GetRuntimeClassName(IInspectable *iface, HSTRING *name)
+{
+    struct platform_exception *impl = impl_from_IInspectable(iface);
+    return WindowsCreateString(impl->class_name, wcslen(impl->class_name), name);
+}
+
+static HRESULT WINAPI exception_GetTrustLevel(IInspectable *iface, TrustLevel *level)
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const IInspectableVtbl exception_vtbl =
+{
+    exception_QueryInterface,
+    exception_AddRef,
+    exception_Release,
+    exception_GetIids,
+    exception_GetRuntimeClassName,
+    exception_GetTrustLevel,
+};
+
+/* C++ exception data, as the C++ runtime reads it (offsets from the image base on 64-bit) */
+#ifdef _WIN64
+typedef int eh_ref;
+#define EH_REF(ptr) ((int)((char *)(ptr) - (char *)module_base))
+#else
+typedef const void *eh_ref;
+#define EH_REF(ptr) ((const void *)(ptr))
+#endif
+
+#define CLASS_IS_SIMPLE_TYPE 1
+
+struct eh_type_info
+{
+    const void *vtable;
+    char *name;
+    char mangled[64];
+};
+
+struct eh_catchable_type
+{
+    UINT flags;
+    eh_ref type_info;
+    int this_offset, vbase_descr, vbase_offset;
+    UINT size;
+    eh_ref copy_ctor;
+};
+
+#define MAX_CATCHABLE 4
+
+struct eh_catchable_table
+{
+    UINT count;
+    eh_ref info[MAX_CATCHABLE];
+};
+
+struct eh_throw_info
+{
+    UINT flags;
+    eh_ref destructor;
+    eh_ref custom_handler;
+    eh_ref table;
+};
+
+static HMODULE module_base;
+static const void *type_info_vtable[2];
+
+enum exception_class
+{
+    CLASS_OUTOFMEMORY,
+    CLASS_INVALIDARGUMENT,
+    CLASS_INVALIDCAST,
+    CLASS_NULLREFERENCE,
+    CLASS_NOTIMPLEMENTED,
+    CLASS_ACCESSDENIED,
+    CLASS_FAILURE,
+    CLASS_OUTOFBOUNDS,
+    CLASS_CHANGEDSTATE,
+    CLASS_CLASSNOTREGISTERED,
+    CLASS_DISCONNECTED,
+    CLASS_OPERATIONCANCELED,
+    CLASS_WRONGTHREAD,
+    CLASS_OBJECTDISPOSED,
+    CLASS_COMEXCEPTION,     /* the base of the classes above */
+    CLASS_EXCEPTION,        /* Platform::Exception */
+    CLASS_OBJECT,           /* Platform::Object */
+    CLASS_COUNT,
+    CLASS_THROWABLE = CLASS_EXCEPTION
+};
+
+static const struct
+{
+    const char *mangled;
+    const WCHAR *runtime_name;
+    HRESULT hr;
+}
+classes[CLASS_COUNT] =
+{
+    { ".PE$AAVOutOfMemoryException@Platform@@", L"Platform.OutOfMemoryException", E_OUTOFMEMORY },
+    { ".PE$AAVInvalidArgumentException@Platform@@", L"Platform.InvalidArgumentException", E_INVALIDARG },
+    { ".PE$AAVInvalidCastException@Platform@@", L"Platform.InvalidCastException", E_NOINTERFACE },
+    { ".PE$AAVNullReferenceException@Platform@@", L"Platform.NullReferenceException", E_POINTER },
+    { ".PE$AAVNotImplementedException@Platform@@", L"Platform.NotImplementedException", E_NOTIMPL },
+    { ".PE$AAVAccessDeniedException@Platform@@", L"Platform.AccessDeniedException", E_ACCESSDENIED },
+    { ".PE$AAVFailureException@Platform@@", L"Platform.FailureException", E_FAIL },
+    { ".PE$AAVOutOfBoundsException@Platform@@", L"Platform.OutOfBoundsException", E_BOUNDS },
+    { ".PE$AAVChangedStateException@Platform@@", L"Platform.ChangedStateException", E_CHANGED_STATE },
+    { ".PE$AAVClassNotRegisteredException@Platform@@", L"Platform.ClassNotRegisteredException", REGDB_E_CLASSNOTREG },
+    { ".PE$AAVDisconnectedException@Platform@@", L"Platform.DisconnectedException", RPC_E_DISCONNECTED },
+    { ".PE$AAVOperationCanceledException@Platform@@", L"Platform.OperationCanceledException", E_ABORT },
+    { ".PE$AAVWrongThreadException@Platform@@", L"Platform.WrongThreadException", RPC_E_WRONG_THREAD },
+    { ".PE$AAVObjectDisposedException@Platform@@", L"Platform.ObjectDisposedException", RO_E_CLOSED },
+    { ".PE$AAVCOMException@Platform@@", L"Platform.COMException", 0 },
+    { ".PE$AAVException@Platform@@", L"Platform.Exception", 0 },
+    { ".PE$AAVObject@Platform@@", L"Platform.Object", 0 },
+};
+
+static struct eh_type_info type_infos[CLASS_COUNT];
+static struct eh_catchable_type catchable_types[CLASS_COUNT];
+static struct eh_catchable_table catchable_tables[CLASS_THROWABLE];
+static struct eh_throw_info throw_infos[CLASS_THROWABLE];
+
+/* the catch block's copy of the handle holds its own reference */
+static void * __cdecl handle_copy_ctor(void **dst, void **src)
+{
+    *dst = *src;
+    if (*dst) IInspectable_AddRef((IInspectable *)*dst);
+    return dst;
+}
+
+/* the thrown object releases its reference once the exception is handled */
+static void __cdecl handle_dtor(void **obj)
+{
+    if (*obj) IInspectable_Release((IInspectable *)*obj);
+}
+
+static void init_exception_data(void)
+{
+    unsigned int i, n;
+
+    for (i = 0; i < CLASS_COUNT; i++)
+    {
+        type_infos[i].vtable = type_info_vtable;
+        strcpy(type_infos[i].mangled, classes[i].mangled);
+        catchable_types[i].flags = 0;
+        catchable_types[i].type_info = EH_REF(&type_infos[i]);
+        catchable_types[i].vbase_descr = -1;
+        catchable_types[i].size = sizeof(void *);
+        catchable_types[i].copy_ctor = EH_REF(handle_copy_ctor);
+    }
+    for (i = 0; i < CLASS_THROWABLE; i++)
+    {
+        n = 0;
+        catchable_tables[i].info[n++] = EH_REF(&catchable_types[i]);
+        if (i != CLASS_COMEXCEPTION) catchable_tables[i].info[n++] = EH_REF(&catchable_types[CLASS_COMEXCEPTION]);
+#ifndef SG_MUTANT_VCCORLIB_NO_BASE_CLASS
+        catchable_tables[i].info[n++] = EH_REF(&catchable_types[CLASS_EXCEPTION]);
+#endif
+        catchable_tables[i].info[n++] = EH_REF(&catchable_types[CLASS_OBJECT]);
+        catchable_tables[i].count = n;
+        throw_infos[i].destructor = EH_REF(handle_dtor);
+        throw_infos[i].table = EH_REF(&catchable_tables[i]);
+    }
+}
+
+static HSTRING message_from_hresult(HRESULT hr)
+{
+    WCHAR buffer[512];
+    HSTRING str = NULL;
+    DWORD len;
+
+    len = FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, hr, 0,
+                         buffer, ARRAY_SIZE(buffer), NULL);
+    while (len && (buffer[len - 1] == '\r' || buffer[len - 1] == '\n' || buffer[len - 1] == ' ')) len--;
+    if (!len) len = swprintf(buffer, ARRAY_SIZE(buffer), L"Exception 0x%08x", hr);
+    WindowsCreateString(buffer, len, &str);
+    return str;
+}
+
+static void DECLSPEC_NORETURN throw_platform_exception(enum exception_class class, HRESULT hr)
+{
+    struct platform_exception *impl;
+    IInspectable *object;
+
+    TRACE("throwing %s, hr %#lx\n", debugstr_w(classes[class].runtime_name), hr);
+
+    if (!(impl = calloc(1, sizeof(*impl))))
+    {
+        ERR("out of memory\n");
+        RaiseException(STATUS_NO_MEMORY, EXCEPTION_NONCONTINUABLE, 0, NULL);
+    }
+    impl->IInspectable_iface.lpVtbl = &exception_vtbl;
+    impl->ref = 1;
+    impl->hr = hr;
+    impl->class_name = classes[class].runtime_name;
+    impl->message = message_from_hresult(hr);
+
+    object = &impl->IInspectable_iface;
+    _CxxThrowException(&object, &throw_infos[class]);
+    for (;;);
+}
+
+static void DECLSPEC_NORETURN throw_class(enum exception_class class)
+{
+    throw_platform_exception(class, classes[class].hr);
+}
+
+/***********************************************************************
+ *      ?__abi_WinRTraiseCOMException@@YAXJ@Z
+ *
+ * Throws the exception class that belongs to the HRESULT, COMException otherwise.
+ */
+void __cdecl __abi_WinRTraiseCOMException(HRESULT hr)
+{
+    unsigned int i;
+
+    for (i = 0; i < CLASS_COMEXCEPTION; i++)
+        if (classes[i].hr == hr) throw_class(i);
+    throw_platform_exception(CLASS_COMEXCEPTION, hr);
+}
+
+void __cdecl __abi_WinRTraiseOutOfMemoryException(void) { throw_class(CLASS_OUTOFMEMORY); }
+void __cdecl __abi_WinRTraiseInvalidArgumentException(void) { throw_class(CLASS_INVALIDARGUMENT); }
+void __cdecl __abi_WinRTraiseInvalidCastException(void) { throw_class(CLASS_INVALIDCAST); }
+void __cdecl __abi_WinRTraiseNullReferenceException(void) { throw_class(CLASS_NULLREFERENCE); }
+void __cdecl __abi_WinRTraiseNotImplementedException(void) { throw_class(CLASS_NOTIMPLEMENTED); }
+void __cdecl __abi_WinRTraiseAccessDeniedException(void) { throw_class(CLASS_ACCESSDENIED); }
+void __cdecl __abi_WinRTraiseFailureException(void) { throw_class(CLASS_FAILURE); }
+void __cdecl __abi_WinRTraiseOutOfBoundsException(void) { throw_class(CLASS_OUTOFBOUNDS); }
+void __cdecl __abi_WinRTraiseChangedStateException(void) { throw_class(CLASS_CHANGEDSTATE); }
+void __cdecl __abi_WinRTraiseClassNotRegisteredException(void) { throw_class(CLASS_CLASSNOTREGISTERED); }
+void __cdecl __abi_WinRTraiseDisconnectedException(void) { throw_class(CLASS_DISCONNECTED); }
+void __cdecl __abi_WinRTraiseOperationCanceledException(void) { throw_class(CLASS_OPERATIONCANCELED); }
+void __cdecl __abi_WinRTraiseWrongThreadException(void) { throw_class(CLASS_WRONGTHREAD); }
+void __cdecl __abi_WinRTraiseObjectDisposedException(void) { throw_class(CLASS_OBJECTDISPOSED); }
+
+/***********************************************************************
+ *      ?get@Message@Exception@Platform@@QE$AAAPE$AAVString@3@XZ
+ *
+ * Exception::Message; the caller owns the returned string.
+ */
+HSTRING __cdecl Exception_get_Message(IInspectable *this)
+{
+    struct platform_exception *impl = impl_from_IInspectable(this);
+    HSTRING ret = NULL;
+
+    TRACE("(%p)\n", this);
+    if (this && this->lpVtbl == &exception_vtbl) WindowsDuplicateString(impl->message, &ret);
+    return ret;
+}
+
+/***********************************************************************
+ *      ?get@HResult@Exception@Platform@@QE$AAAHXZ
+ */
+HRESULT __cdecl Exception_get_HResult(IInspectable *this)
+{
+    TRACE("(%p)\n", this);
+    if (!this || this->lpVtbl != &exception_vtbl) return E_FAIL;
+    return impl_from_IInspectable(this)->hr;
+}
+
+/***********************************************************************
+ *      ?InitializeData@Details@Platform@@YAJH@Z
+ *
+ * Called from a C++/CX module's start-up code.
+ */
+HRESULT __cdecl InitializeData(int type)
+{
+    TRACE("(%d)\n", type);
+    return S_OK;
+}
+
+/***********************************************************************
+ *      ?UninitializeData@Details@Platform@@YAXH@Z
+ */
+void __cdecl UninitializeData(int type)
+{
+    TRACE("(%d)\n", type);
+}
+
+/***********************************************************************
+ *      ?GetActivationFactoryByPCWSTR@@YAJPEAXAEAVGuid@Platform@@PEAPEAX@Z
+ */
+HRESULT __cdecl GetActivationFactoryByPCWSTR(void *name, GUID *iid, void **factory)
+{
+    HSTRING_HEADER header;
+    HSTRING str;
+    HRESULT hr;
+
+    TRACE("(%s, %s, %p)\n", debugstr_w(name), debugstr_guid(iid), factory);
+
+    if (!factory) return E_POINTER;
+    *factory = NULL;
+    if (!name) return E_INVALIDARG;
+    if (FAILED(hr = WindowsCreateStringReference(name, wcslen(name), &header, &str))) return hr;
+    return RoGetActivationFactory(str, iid, factory);
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls(instance);
+        module_base = instance;
+        init_exception_data();
+    }
+    return TRUE;
+}
diff --git a/dlls/vccorlib140/vccorlib140.spec b/dlls/vccorlib140/vccorlib140.spec
new file mode 100644
index 0000000..dc14992
--- /dev/null
+++ b/dlls/vccorlib140/vccorlib140.spec
@@ -0,0 +1,21 @@
+# C++/CX runtime (Platform namespace). The names are the 64-bit mangled ones.
+@ cdecl -arch=win64 ?InitializeData@Details@Platform@@YAJH@Z(long) InitializeData
+@ cdecl -arch=win64 ?UninitializeData@Details@Platform@@YAXH@Z(long) UninitializeData
+@ cdecl -arch=win64 ?GetActivationFactoryByPCWSTR@@YAJPEAXAEAVGuid@Platform@@PEAPEAX@Z(ptr ptr ptr) GetActivationFactoryByPCWSTR
+@ cdecl -arch=win64 ?get@Message@Exception@Platform@@QE$AAAPE$AAVString@3@XZ(ptr) Exception_get_Message
+@ cdecl -arch=win64 ?get@HResult@Exception@Platform@@QE$AAAHXZ(ptr) Exception_get_HResult
+@ cdecl -arch=win64 ?__abi_WinRTraiseCOMException@@YAXJ@Z(long) __abi_WinRTraiseCOMException
+@ cdecl -arch=win64 ?__abi_WinRTraiseAccessDeniedException@@YAXXZ() __abi_WinRTraiseAccessDeniedException
+@ cdecl -arch=win64 ?__abi_WinRTraiseChangedStateException@@YAXXZ() __abi_WinRTraiseChangedStateException
+@ cdecl -arch=win64 ?__abi_WinRTraiseClassNotRegisteredException@@YAXXZ() __abi_WinRTraiseClassNotRegisteredException
+@ cdecl -arch=win64 ?__abi_WinRTraiseDisconnectedException@@YAXXZ() __abi_WinRTraiseDisconnectedException
+@ cdecl -arch=win64 ?__abi_WinRTraiseFailureException@@YAXXZ() __abi_WinRTraiseFailureException
+@ cdecl -arch=win64 ?__abi_WinRTraiseInvalidArgumentException@@YAXXZ() __abi_WinRTraiseInvalidArgumentException
+@ cdecl -arch=win64 ?__abi_WinRTraiseInvalidCastException@@YAXXZ() __abi_WinRTraiseInvalidCastException
+@ cdecl -arch=win64 ?__abi_WinRTraiseNotImplementedException@@YAXXZ() __abi_WinRTraiseNotImplementedException
+@ cdecl -arch=win64 ?__abi_WinRTraiseNullReferenceException@@YAXXZ() __abi_WinRTraiseNullReferenceException
+@ cdecl -arch=win64 ?__abi_WinRTraiseObjectDisposedException@@YAXXZ() __abi_WinRTraiseObjectDisposedException
+@ cdecl -arch=win64 ?__abi_WinRTraiseOperationCanceledException@@YAXXZ() __abi_WinRTraiseOperationCanceledException
+@ cdecl -arch=win64 ?__abi_WinRTraiseOutOfBoundsException@@YAXXZ() __abi_WinRTraiseOutOfBoundsException
+@ cdecl -arch=win64 ?__abi_WinRTraiseOutOfMemoryException@@YAXXZ() __abi_WinRTraiseOutOfMemoryException
+@ cdecl -arch=win64 ?__abi_WinRTraiseWrongThreadException@@YAXXZ() __abi_WinRTraiseWrongThreadException
