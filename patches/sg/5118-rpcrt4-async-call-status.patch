From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] rpcrt4: implement RpcAsyncGetCallStatus for client async calls

Return PENDING while a call is in flight, OK after the reply, and
INVALID_BINDING for handles that never started a call.
---

diff --git a/dlls/rpcrt4/rpc_async.c b/dlls/rpcrt4/rpc_async.c
--- a/dlls/rpcrt4/rpc_async.c
+++ b/dlls/rpcrt4/rpc_async.c
@@ -91,8 +91,20 @@
  */
 RPC_STATUS WINAPI RpcAsyncGetCallStatus(PRPC_ASYNC_STATE pAsync)
 {
-    FIXME("(%p): stub\n", pAsync);
-    return RPC_S_INVALID_ASYNC_HANDLE;
+    struct async_call_data *data;
+
+    TRACE("(%p)\n", pAsync);
+
+    if (!pAsync) return RPC_S_INVALID_ASYNC_HANDLE;
+
+    /* a handle with no call behind it (a fresh one, or one that is not initialised at all): the
+     * binding of the call is what is missing, as on Windows (tests/rpc_async.c) */
+    if (!(data = pAsync->StubInfo)) return RPC_S_INVALID_BINDING;
+
+    /* only a client call has a reply to wait for */
+    if (!data->pStubMsg->IsClient) return RPC_S_INVALID_ASYNC_HANDLE;
+
+    return data->call_status;
 }
 
 /***********************************************************************
diff --git a/dlls/rpcrt4/rpc_message.c b/dlls/rpcrt4/rpc_message.c
--- a/dlls/rpcrt4/rpc_message.c
+++ b/dlls/rpcrt4/rpc_message.c
@@ -41,6 +41,7 @@
 #include "rpc_message.h"
 #include "rpc_assoc.h"
 #include "ncastatus.h"
+#include "ndr_stubless.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(rpc);
 
@@ -1721,8 +1722,17 @@
     RpcConnection *conn = p;
     RPC_ASYNC_STATE *state = conn->async_state;
 
-    if (state && conn->ops->wait_for_incoming_data(conn) != -1)
+    if (state)
     {
+        struct async_call_data *data = state->StubInfo;
+
+        if (conn->ops->wait_for_incoming_data(conn) == -1)
+        {
+            /* the connection failed: RpcAsyncGetCallStatus says so */
+            if (data) InterlockedExchange(&data->call_status, RPC_S_CALL_FAILED);
+            return 0;
+        }
+        if (data) InterlockedExchange(&data->call_status, RPC_S_OK);
         state->Event = RpcCallComplete;
         switch (state->NotificationType)
         {
diff --git a/dlls/rpcrt4/ndr_stubless.c b/dlls/rpcrt4/ndr_stubless.c
--- a/dlls/rpcrt4/ndr_stubless.c
+++ b/dlls/rpcrt4/ndr_stubless.c
@@ -1584,6 +1584,7 @@
     memcpy(pStubMsg->StackTop, stack_top, async_call_data->stack_size);
 
     pAsync = *(RPC_ASYNC_STATE **)pStubMsg->StackTop;
+    async_call_data->call_status = RPC_S_ASYNC_CALL_PENDING;
     pAsync->StubInfo = async_call_data;
     async_call_data->pHandleFormat = pFormat;
 
diff --git a/dlls/rpcrt4/ndr_stubless.h b/dlls/rpcrt4/ndr_stubless.h
--- a/dlls/rpcrt4/ndr_stubless.h
+++ b/dlls/rpcrt4/ndr_stubless.h
@@ -237,6 +237,9 @@
     unsigned int number_of_params;
     /* location to put retval into */
     LONG_PTR *retval_ptr;
+    /* client: the call's progress, set when the reply arrives or the connection fails
+     * (RPC_S_ASYNC_CALL_PENDING, RPC_S_OK, or an error) */
+    volatile LONG call_status;
     /* correlation cache */
     ULONG_PTR NdrCorrCache[256];
 };
diff --git a/dlls/rpcrt4/tests/rpc_async.c b/dlls/rpcrt4/tests/rpc_async.c
--- a/dlls/rpcrt4/tests/rpc_async.c
+++ b/dlls/rpcrt4/tests/rpc_async.c
@@ -66,12 +66,10 @@
     ok(status == RPC_S_OK, "RpcAsyncInitializeHandle failed with error %ld\n", status);
 
     status = RpcAsyncGetCallStatus(&async);
-    todo_wine
     ok(status == RPC_S_INVALID_BINDING, "RpcAsyncGetCallStatus should have returned RPC_S_INVALID_BINDING instead of %ld\n", status);
 
     memset(&async, 0, sizeof(async));
     status = RpcAsyncGetCallStatus(&async);
-    todo_wine
     ok(status == RPC_S_INVALID_BINDING, "RpcAsyncGetCallStatus should have returned RPC_S_INVALID_BINDING instead of %ld\n", status);
 }
 
