From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ole32: OleCreateStaticFromData render options (patch 5112)

OLERENDER_DRAW picks the data objects picture format; NONE and ASIS are errors;
gap-CORE item 519. Gate with two mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ole32/ole2.c b/dlls/ole32/ole2.c
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -2938,16 +2938,43 @@
     DWORD connection;
     STGMEDIUM stgmedium;
     LPOLESTR ole_typename;
+    FORMATETC draw_fmt = {0};
 
     TRACE("%p, %s, %#lx, %p, %p, %p, %p.\n", data, debugstr_guid(iid), renderopt, fmt, client_site, stg, obj);
 
     if (!obj || !stg)
         return E_INVALIDARG;
 
-    if (renderopt != OLERENDER_FORMAT)
+    /* "It is an error to pass the render options OLERENDER_NONE or OLERENDER_ASIS to this function" */
+#ifndef SG_MUTANT_STATIC_NONE
+    if (renderopt != OLERENDER_FORMAT && renderopt != OLERENDER_DRAW)
+        return E_INVALIDARG;
+#endif
+
+    if (renderopt == OLERENDER_DRAW)
     {
-        FIXME("semi-stub\n");
-        return OleCreateFromData(data, iid, renderopt, fmt, client_site, stg, obj);
+        /* the picture format is the data object's choice: the first of the OLE-rendered formats it offers */
+        static const struct { CLIPFORMAT cf; DWORD tymed; } formats[] =
+        {
+            { CF_METAFILEPICT, TYMED_MFPICT }, { CF_DIB, TYMED_HGLOBAL },
+            { CF_BITMAP, TYMED_GDI }, { CF_ENHMETAFILE, TYMED_ENHMF },
+        };
+        unsigned int i;
+
+        if (!data) return E_INVALIDARG;
+        for (i = 0; i < ARRAY_SIZE(formats); i++)
+        {
+            draw_fmt.cfFormat = formats[i].cf;
+            draw_fmt.dwAspect = DVASPECT_CONTENT;
+            draw_fmt.lindex = -1;
+            draw_fmt.tymed = formats[i].tymed;
+#ifdef SG_MUTANT_STATIC_DRAW
+            break;
+#endif
+            if (IDataObject_QueryGetData(data, &draw_fmt) == S_OK) break;
+        }
+        if (i == ARRAY_SIZE(formats)) return DV_E_CLIPFORMAT;
+        fmt = &draw_fmt;
     }
 
     if (!fmt)
-- 
