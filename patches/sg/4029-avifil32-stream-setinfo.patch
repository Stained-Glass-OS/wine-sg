From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] avifil32: Implement IAVIStream::SetInfo of AVI, WAV, ACM and ICM streams.

AVI file streams change the members EditStreamSetInfo changes (language,
priority, start, rate and scale, quality, frame, name) and count the
edit; they refuse short structures and read-only files. The change does
not by itself rewrite the file: saving an existing file whose header
space is smaller than the one written can damage it (noted for review).
WAV streams and the ACM/ICM compressor streams change their descriptive
members; the ICM stream's quality is the one used for compressing.
---
 dlls/avifil32/acmstream.c | 21 +++++++++++++++++++--
 dlls/avifil32/avifile.c   | 28 ++++++++++++++++++++++++++--
 dlls/avifil32/icmstream.c | 21 +++++++++++++++++++--
 dlls/avifil32/wavfile.c   | 20 ++++++++++++++++++--
 4 files changed, 82 insertions(+), 8 deletions(-)

diff --git a/dlls/avifil32/acmstream.c b/dlls/avifil32/acmstream.c
index 09db400..5d16298 100644
--- a/dlls/avifil32/acmstream.c
+++ b/dlls/avifil32/acmstream.c
@@ -673,9 +673,26 @@ static HRESULT WINAPI ACMStream_fnWriteData(IAVIStream *iface, DWORD fcc,
 static HRESULT WINAPI ACMStream_fnSetInfo(IAVIStream *iface,
 					   LPAVISTREAMINFOW info, LONG infolen)
 {
-  FIXME("(%p,%p,%ld): stub\n", iface, info, infolen);
+  IAVIStreamImpl *This = impl_from_IAVIStream(iface);
+
+  TRACE("(%p,%p,%ld)\n", iface, info, infolen);
 
-  return E_FAIL;
+  if (info == NULL)
+    return AVIERR_BADPARAM;
+  if (infolen < sizeof(AVISTREAMINFOW))
+    return AVIERR_BADSIZE;
+
+  /* The compressed stream's timing and sizes come from its source and
+   * format; what describes it can change (the quality is the one used for
+   * compressing). */
+  This->sInfo.wLanguage = info->wLanguage;
+  This->sInfo.wPriority = info->wPriority;
+  This->sInfo.dwQuality = info->dwQuality;
+  This->sInfo.rcFrame   = info->rcFrame;
+  memcpy(This->sInfo.szName, info->szName, sizeof(info->szName));
+  This->sInfo.dwEditCount++;
+
+  return AVIERR_OK;
 }
 
 static const struct IAVIStreamVtbl iacmst = {
diff --git a/dlls/avifil32/avifile.c b/dlls/avifil32/avifile.c
index 719d96e..4e43169 100644
--- a/dlls/avifil32/avifile.c
+++ b/dlls/avifil32/avifile.c
@@ -1307,9 +1307,33 @@ static HRESULT WINAPI IAVIStream_fnWriteData(IAVIStream *iface, DWORD fcc, void
 
 static HRESULT WINAPI IAVIStream_fnSetInfo(IAVIStream *iface, AVISTREAMINFOW *info, LONG infolen)
 {
-  FIXME("(%p,%p,%ld): stub\n", iface, info, infolen);
+  IAVIStreamImpl *This = impl_from_IAVIStream(iface);
+
+  TRACE("(%p,%p,%ld)\n", iface, info, infolen);
+
+  if (info == NULL)
+    return AVIERR_BADPARAM;
+  if (infolen < sizeof(AVISTREAMINFOW))
+    return AVIERR_BADSIZE;
+  if ((This->paf->uMode & MMIO_RWMODE) == 0)
+    return AVIERR_READONLY;
+  if (info->dwScale == 0 || info->dwRate == 0)
+    return AVIERR_BADPARAM;
 
-  return E_FAIL;
+  /* The members EditStreamSetInfo changes. They go into the header when the
+   * file is saved for written data; the change alone does not rewrite the
+   * file, whose header space may be smaller than the one written here. */
+  This->sInfo.wLanguage = info->wLanguage;
+  This->sInfo.wPriority = info->wPriority;
+  This->sInfo.dwStart   = info->dwStart;
+  This->sInfo.dwRate    = info->dwRate;
+  This->sInfo.dwScale   = info->dwScale;
+  This->sInfo.dwQuality = info->dwQuality;
+  This->sInfo.rcFrame   = info->rcFrame;
+  memcpy(This->sInfo.szName, info->szName, sizeof(info->szName));
+  This->sInfo.dwEditCount++;
+
+  return AVIERR_OK;
 }
 
