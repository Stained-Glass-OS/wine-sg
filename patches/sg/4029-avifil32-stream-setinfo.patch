diff --git a/dlls/avifil32/wavfile.c b/dlls/avifil32/wavfile.c
index 7f6fc73..06ef65f 100644
--- a/dlls/avifil32/wavfile.c
+++ b/dlls/avifil32/wavfile.c
@@ -953,9 +953,25 @@ static HRESULT WINAPI IAVIStream_fnWriteData(IAVIStream *iface, DWORD fcc, void
 static HRESULT WINAPI IAVIStream_fnSetInfo(IAVIStream *iface,
 					   LPAVISTREAMINFOW info, LONG infolen)
 {
-  FIXME("(%p,%p,%ld): stub\n", iface, info, infolen);
+  IAVIFileImpl *This = impl_from_IAVIStream(iface);
