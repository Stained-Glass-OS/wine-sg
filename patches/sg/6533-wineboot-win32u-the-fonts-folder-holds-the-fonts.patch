From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineboot, win32u: The fonts folder holds the fonts (6533)

On Windows, C:\Windows\Fonts holds the system's fonts. Wine loads its
own fonts and the host's (fontconfig) from their own directories, and
left the folder empty. Programs that read the folder themselves found
no font and drew no text: fontconfig and Pango in Inkscape, GIMP and
Krita. Inkscape's exports had no text at all.

When wineboot creates or updates the prefix, it now puts a symbolic link
in the folder for each font win32u registered under HKLM\...\Fonts with a
full path outside it (Wine's own fonts and the host's TrueType and
OpenType files). It records the links it made under
HKLM\Software\Stained Glass\Fonts\Links. An update removes only its own
links, when their font is gone, and never touches a file a user or an
installer put there. win32u does not load these links again from the
folder, so GDI and DirectWrite see the same families as before. The
registry's font list is unchanged.
---
diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index c7d7030..382e018 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -6758,6 +6758,44 @@ static void load_system_bitmap_fonts(void)
     NtClose( hkey );
 }
 
+/* Stained Glass OS (wine-sg 6533): the links wineboot puts in the fonts folder for fonts loaded from
+ * elsewhere (Wine's own, the host's) are not loaded again from the folder */
+static WCHAR **skip_names;
+static unsigned int skip_count;
+
+static BOOL skip_font_file( const WCHAR *name, unsigned int len )
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_FONT_LINKS_LOADED
+    return FALSE;
+#endif
+    for (i = 0; i < skip_count; i++)
+        if (lstrlenW( skip_names[i] ) == len && !wcsnicmp( skip_names[i], name, len )) return TRUE;
+    return FALSE;
+}
+
+static void load_font_link_names(void)
+{
+
+    char buffer[2048];
+    KEY_VALUE_FULL_INFORMATION *info = (KEY_VALUE_FULL_INFORMATION *)buffer;
+    WCHAR value[MAX_PATH];
+    HKEY hkey;
+    DWORD i = 0;
+
+    if (!(hkey = reg_open_ascii_key( NULL, "\\Registry\\Machine\\Software\\Stained Glass\\Fonts\\Links" ))) return;
+    while (reg_enum_value( hkey, i++, info, sizeof(buffer), value, sizeof(value) ))
+    {
+        WCHAR **names = realloc( skip_names, (skip_count + 1) * sizeof(*names) );
+        if (!names) break;
+        skip_names = names;
+        if (!(skip_names[skip_count] = malloc( (lstrlenW( value ) + 1) * sizeof(WCHAR) ))) break;
+        lstrcpyW( skip_names[skip_count++], value );
+    }
+    NtClose( hkey );
+}
+
 static void load_directory_fonts( WCHAR *path, UINT flags )
 {
     IO_STATUS_BLOCK io = {{0}};
@@ -6794,7 +6832,8 @@ static void load_directory_fonts( WCHAR *path, UINT flags )
         FILE_BOTH_DIR_INFORMATION *info = (FILE_BOTH_DIR_INFORMATION *)buf;
         for (;;)
         {
-            if (!(info->FileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+            if (!(info->FileAttributes & FILE_ATTRIBUTE_DIRECTORY) &&
+                !(skip_count && skip_font_file( info->FileName, info->FileNameLength / sizeof(WCHAR) )))
             {
                 memcpy( path + len, info->FileName, info->FileNameLength );
                 path[len + info->FileNameLength / sizeof(WCHAR)] = 0;
@@ -6815,6 +6854,7 @@ static void load_file_system_fonts(void)
     WCHAR *ptr, *next, path[MAX_PATH];
 
     /* Windows directory */
+    load_font_link_names();
     get_fonts_win_dir_path( NULL, path );
     load_directory_fonts( path, 0 );
 
diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
index c22d7c3..feab4f2 100644
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1787,6 +1787,140 @@ static void create_msc_files(void)
     }
 }
 
+/* Stained Glass OS (wine-sg 6533): the fonts in the system's fonts folder, as on Windows. Wine's own
+ * fonts and the host's (fontconfig) are loaded from their own directories, and C:\windows\Fonts stayed
+ * empty: programs that read the folder themselves (fontconfig in Inkscape, GIMP and Krita, Pango) found
+ * no font and drew no text. Each font win32u registered under HKLM\...\Fonts with a full path outside
+ * the folder gets a symbolic link there; the links made are listed under
+ * HKLM\Software\Stained Glass\Fonts\Links, so that win32u does not load them twice and so that a later
+ * update removes only its own links (for fonts gone) and never a file a user or an installer put there.
+ * The registry's font list is not changed: DirectWrite and GDI see the same families as before. */
+static const WCHAR font_links_keyW[] = L"Software\\Stained Glass\\Fonts\\Links";
+
+static BOOL is_font_link_ext( const WCHAR *path )
+{
+    const WCHAR *ext = wcsrchr( path, '.' );
+    return ext && (!wcsicmp( ext, L".ttf" ) || !wcsicmp( ext, L".otf" ) || !wcsicmp( ext, L".ttc" ) ||
+                   !wcsicmp( ext, L".otc" ));
+}
+
+/* a link of ours: a symbolic link, or one whose target is gone (dangling); never a file */
+static BOOL is_our_link( const WCHAR *path )
+{
+    DWORD attr = GetFileAttributesW( path );
+    return attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_REPARSE_POINT);
+}
+
+static void link_system_fonts(void)
+{
+    WCHAR fonts_dir[MAX_PATH], name[512], data[MAX_PATH], link[MAX_PATH], target[MAX_PATH];
+    DWORD i, name_len, data_len, type, dir_len, linked = 0, removed = 0;
+    HKEY fonts_key, links_key;
+    HDC dc;
+
+#ifdef SG_MUTANT_NO_FONT_LINKS
+    return;
+#endif
+    /* the fonts loaded (and registered) by this process */
+    if ((dc = CreateCompatibleDC( 0 ))) DeleteDC( dc );
+
+    GetWindowsDirectoryW( fonts_dir, MAX_PATH );
+    lstrcatW( fonts_dir, L"\\Fonts" );
+    CreateDirectoryW( fonts_dir, NULL );
+    dir_len = lstrlenW( fonts_dir );
+
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, font_links_keyW, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &links_key, NULL ))
+        return;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts", 0, KEY_READ,
+                       &fonts_key ))
+    {
+        RegCloseKey( links_key );
+        return;
+    }
+
+    /* links whose target is gone, or that no font is registered for any more */
+    for (i = 0;;)
+    {
+        DWORD j, found = 0;
+
+        name_len = ARRAY_SIZE(name);
+        data_len = sizeof(target);
+        if (RegEnumValueW( links_key, i, name, &name_len, NULL, &type, (BYTE *)target, &data_len )) break;
+        for (j = 0;; j++)
+        {
+            WCHAR fname[512];
+            DWORD flen = ARRAY_SIZE(fname), dlen = sizeof(data);
+            if (RegEnumValueW( fonts_key, j, fname, &flen, NULL, &type, (BYTE *)data, &dlen )) break;
+            if (type == REG_SZ && !wcsicmp( data, target )) { found = 1; break; }
+        }
+        swprintf( link, ARRAY_SIZE(link), L"%s\\%s", fonts_dir, name );
+        if (!found || GetFileAttributesW( target ) == INVALID_FILE_ATTRIBUTES)
+        {
+            if (is_our_link( link )) DeleteFileW( link );
+            RegDeleteValueW( links_key, name );
+            removed++;
+            continue;   /* (the next value is now at i) */
+        }
+        i++;
+    }
+
+    /* a link for each registered font with a full path outside the folder */
+    for (i = 0;; i++)
+    {
+        const WCHAR *base;
+        WCHAR link_name[MAX_PATH], *dot;
+        DWORD n;
+
+        name_len = ARRAY_SIZE(name);
+        data_len = sizeof(data) - sizeof(WCHAR);
+        if (RegEnumValueW( fonts_key, i, name, &name_len, NULL, &type, (BYTE *)data, &data_len )) break;
+        if (type != REG_SZ) continue;
+        data[data_len / sizeof(WCHAR)] = 0;
+        if (!data[0] || data[1] != ':' || data[2] != '\\') continue;      /* a bare name: in the folder */
+        if (!wcsnicmp( data, fonts_dir, dir_len ) && data[dir_len] == '\\') continue;
+        if (!is_font_link_ext( data ) || GetFileAttributesW( data ) == INVALID_FILE_ATTRIBUTES) continue;
+        if (!(base = wcsrchr( data, '\\' ))) continue;
+        base++;
+
+        /* the file's own name, or with a number when another file has it */
+        for (n = 1; n < 100; n++)
+        {
+            DWORD rtype, rlen = sizeof(target);
+
+            if (n == 1) lstrcpynW( link_name, base, ARRAY_SIZE(link_name) );
+            else
+            {
+                lstrcpynW( link_name, base, ARRAY_SIZE(link_name) - 8 );
+                if ((dot = wcsrchr( link_name, '.' ))) *dot = 0;
+                swprintf( link_name + lstrlenW( link_name ), 8, L"_%u", n );
+                lstrcatW( link_name, wcsrchr( base, '.' ) );
+            }
+            swprintf( link, ARRAY_SIZE(link), L"%s\\%s", fonts_dir, link_name );
+            if (!RegQueryValueExW( links_key, link_name, NULL, &rtype, (BYTE *)target, &rlen ))
+            {
+                if (!wcsicmp( target, data ))
+                {
+                    if (GetFileAttributesW( link ) == INVALID_FILE_ATTRIBUTES && CreateSymbolicLinkW( link, data, 0 ))
+                        linked++;
+                    break;   /* ours already */
+                }
+                continue;    /* ours, for another font */
+            }
+            if (GetFileAttributesW( link ) != INVALID_FILE_ATTRIBUTES) continue;   /* a file not ours */
+            if (CreateSymbolicLinkW( link, data, 0 ))
+            {
+                RegSetValueExW( links_key, link_name, 0, REG_SZ, (const BYTE *)data, (lstrlenW( data ) + 1) * sizeof(WCHAR) );
+                linked++;
+            }
+            else WARN( "could not link %s to %s: %lu\n", debugstr_w(link), debugstr_w(data), GetLastError() );
+            break;
+        }
+    }
+    TRACE( "%lu font links made, %lu removed\n", linked, removed );
+    RegCloseKey( fonts_key );
+    RegCloseKey( links_key );
+}
+
 static void update_wineprefix( BOOL force )
 {
     const WCHAR *config_dir = _wgetenv( L"WINECONFIGDIR" );
@@ -1846,6 +1980,7 @@ static void update_wineprefix( BOOL force )
         }
         install_root_pnp_devices();
         update_user_profile();
+        link_system_fonts();
 
         TRACE( "wine: configuration in %s has been updated.\n", debugstr_w(prettyprint_configdir()) );
     }
