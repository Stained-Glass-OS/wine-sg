From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a shell item's items, BHID_EnumItems

IShellItem::BindToHandler knew BHID_SFObject, BHID_SFUIObject and BHID_DataObject
only; BHID_EnumItems -- the usual way a program lists a folder through the shell since
Windows 7 -- failed with MK_E_NOOBJECT ('Unsupported BHID {94f60519-...}'). It now
gives the folder's items as IEnumShellItems, as Windows does: the folder's
EnumObjects with SHCONTF_FOLDERS | SHCONTF_NONFOLDERS, each a shell item under the
folder's own ID list; an empty folder gives an enumerator with no items (the item
enumerator takes no array for it). Blender's Quick access list needs it (9754).

Gate: test/enumitems-gate.sh; mutant SG_MUTANT_NO_BHID_ENUMITEMS.
---
--- a/dlls/shell32/shellitem.c
+++ b/dlls/shell32/shellitem.c
@@ -192,6 +192,8 @@
     return ret;
 }
 
+static HRESULT IEnumShellItems_Constructor(IShellItemArray *array, IEnumShellItems **ppesi);
+
 static HRESULT WINAPI ShellItem_BindToHandler(IShellItem2 *iface, IBindCtx *pbc,
     REFGUID rbhid, REFIID riid, void **ppvOut)
 {
@@ -232,6 +234,57 @@
         return ShellItem_BindToHandler(&This->IShellItem2_iface, pbc, &BHID_SFUIObject,
                                        &IID_IDataObject, ppvOut);
     }
+#ifndef SG_MUTANT_NO_BHID_ENUMITEMS
+    else if (IsEqualGUID(rbhid, &BHID_EnumItems))
+    {
+        /* Stained Glass OS (wine-sg 9753): the folder's items as shell items, as Windows gives them
+         * (IEnumShellItems; the folder's EnumObjects with SHCONTF_FOLDERS | SHCONTF_NONFOLDERS) */
+        IShellItemArray *array = NULL;
+        LPITEMIDLIST *children = NULL, *grown, child;
+        IEnumIDList *enum_list = NULL;
+        IShellFolder *psf;
+        ULONG count = 0, cap = 0, i;
+
+        if (FAILED(ret = ShellItem_get_shellfolder(This, pbc, &psf))) return ret;
+        ret = IShellFolder_EnumObjects(psf, NULL, SHCONTF_FOLDERS | SHCONTF_NONFOLDERS, &enum_list);
+        if (ret == S_OK && enum_list)
+        {
+            while (IEnumIDList_Next(enum_list, 1, &child, NULL) == S_OK)
+            {
+                if (count == cap)
+                {
+                    cap = cap ? cap * 2 : 32;
+                    if (!(grown = realloc(children, cap * sizeof(*children))))
+                    {
+                        ILFree(child);
+                        ret = E_OUTOFMEMORY;
+                        break;
+                    }
+                    children = grown;
+                }
+                children[count++] = child;
+            }
+            IEnumIDList_Release(enum_list);
+        }
+        else if (SUCCEEDED(ret)) ret = S_OK;   /* S_FALSE, no list: no items */
+        if (SUCCEEDED(ret) && count)
+            ret = SHCreateShellItemArray(This->pidl, psf, count, (PCUITEMID_CHILD_ARRAY)children, &array);
+        for (i = 0; i < count; i++) ILFree(children[i]);
+        free(children);
+        IShellFolder_Release(psf);
+        if (FAILED(ret)) return ret;
+        ret = IEnumShellItems_Constructor(array, (IEnumShellItems **)ppvOut);
+        if (array) IShellItemArray_Release(array);
+        if (SUCCEEDED(ret) && !IsEqualIID(riid, &IID_IEnumShellItems))
+        {
+            IEnumShellItems *items = *ppvOut;
+            *ppvOut = NULL;
+            ret = IEnumShellItems_QueryInterface(items, riid, ppvOut);
+            IEnumShellItems_Release(items);
+        }
+        return ret;
+    }
+#endif
 
     FIXME("Unsupported BHID %s.\n", debugstr_guid(rbhid));
 
@@ -1530,7 +1583,7 @@
     if(!ref)
     {
         TRACE("Freeing.\n");
-        IShellItemArray_Release(This->array);
+        if (This->array) IShellItemArray_Release(This->array);
         free(This);
         return 0;
     }
@@ -1629,8 +1682,12 @@
     This->array = array;
     This->position = 0;
 
-    IShellItemArray_AddRef(This->array);
-    IShellItemArray_GetCount(This->array, &This->count);
+    This->count = 0;
+    if (This->array)   /* none: an empty folder's items (BHID_EnumItems) */
+    {
+        IShellItemArray_AddRef(This->array);
+        IShellItemArray_GetCount(This->array, &This->count);
+    }
 
     ret = IEnumShellItems_QueryInterface(&This->IEnumShellItems_iface, &IID_IEnumShellItems, (void**)ppesi);
     IEnumShellItems_Release(&This->IEnumShellItems_iface);
