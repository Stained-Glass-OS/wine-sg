From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: EndTask, DisableProcessWindowsGhosting without an error

EndTask was an exported stub. It now ends the program a window belongs to as
Task Manager's End Task does: it posts WM_CLOSE to a window that can
answer, and terminates the owning process when forced or when the program
is hung (never the caller's own process). DisableProcessWindowsGhosting no
longer sets ERROR_CALL_NOT_IMPLEMENTED: no window is ghosted here, so it
has nothing to do and is not an error.

---
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -460,9 +460,12 @@ LRESULT WINAPI SendIMEMessageExW(HWND hwnd, LPARAM lparam)
  */
 VOID WINAPI DisableProcessWindowsGhosting(VOID)
 {
-  FIXME(": stub\n");
+  /* no window is ever ghosted here, so there is nothing to disable; it is
+   * not an error either */
+  TRACE("\n");
+#ifdef SG_MUTANT_GHOSTING_ERROR
   SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-  return;
+#endif
 }
 
 /**********************************************************************
@@ -740,6 +743,44 @@ BOOL WINAPI UnregisterSuspendResumeNotification(HPOWERNOTIFY handle)
 #endif
 }
 
+/**********************************************************************
+ * EndTask [USER32.@]
+ *
+ * Ends the program a top-level window belongs to, as Task Manager's End
+ * Task does: by asking its window to close, or, when FORCE is set or the
+ * program does not answer (it is hung), by terminating its process.
+ */
+BOOL WINAPI EndTask( HWND hwnd, BOOL shutdown, BOOL force )
+{
+    DWORD pid = 0;
+    HANDLE process;
+    BOOL ret = TRUE;
+
+    TRACE("(%p %d %d)\n", hwnd, shutdown, force);
+
+    if (!IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+
+    if (!force && !IsHungAppWindow( hwnd ))
+        return PostMessageW( hwnd, WM_CLOSE, 0, 0 );
+
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (!pid || pid == GetCurrentProcessId())
+    {
+        /* never terminate the caller on behalf of its own window */
+        return PostMessageW( hwnd, WM_CLOSE, 0, 0 );
+    }
+    if (!(process = OpenProcess( PROCESS_TERMINATE, FALSE, pid ))) return FALSE;
+#ifndef SG_MUTANT_ENDTASK_NO_TERMINATE
+    ret = TerminateProcess( process, 1 );
+#endif
+    CloseHandle( process );
+    return ret;
+}
+
 /**********************************************************************
  * IsWindowRedirectedForPrint [USER32.@]
  */
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -463,7 +463,7 @@
 @ stdcall EndDialog(long long)
 @ stdcall EndMenu() NtUserEndMenu
 @ stdcall EndPaint(long ptr) NtUserEndPaint
-@ stub EndTask
+@ stdcall EndTask(long long long)
 # @ stub EnterReaderModeHelper
 @ stdcall EnumChildWindows(long ptr long)
 @ stdcall EnumClipboardFormats(long)
