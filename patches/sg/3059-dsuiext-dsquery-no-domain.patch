From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 15:17:54 -0700
Subject: [PATCH] dsuiext, dsquery: behaviour without a domain

- IDsDisplaySpecifier SetServer/SetLanguageID store their arguments; friendly class and attribute names
  fall back to the names themselves, attribute types come from a table of well-known attributes (case
  ignore string otherwise), IsClassContainer is FALSE, EnumClassAttributes lists nothing; calls that need
  the directory (GetDisplaySpecifier, GetIconLocation, GetClassCreationInfo) fail with ERROR_NO_SUCH_DOMAIN
- DsGetFriendlyClassName and DsGetIcon exports
- ICommonQuery::OpenQueryWindow checks its argument and fails with ERROR_NO_SUCH_DOMAIN instead of E_NOTIMPL

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/dsquery/main.c b/dlls/dsquery/main.c
index 06fe1e6..aace85e 100644
--- a/dlls/dsquery/main.c
+++ b/dlls/dsquery/main.c
@@ -56,7 +56,7 @@ static HRESULT WINAPI ClassFactory_QueryInterface(IClassFactory *iface, REFIID r
         return S_OK;
     }
 
-    FIXME("interface %s not implemented\n", debugstr_guid(riid));
+    WARN("interface %s not implemented\n", debugstr_guid(riid));
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -96,7 +96,7 @@ static HRESULT WINAPI ClassFactory_CreateInstance(IClassFactory *iface,
 
 static HRESULT WINAPI ClassFactory_LockServer(IClassFactory *iface, BOOL dolock)
 {
-    FIXME("(%p)->(%d)\n", iface, dolock);
+    TRACE("(%p)->(%d)\n", iface, dolock);
 
     return S_OK;
 }
@@ -134,7 +134,7 @@ static HRESULT WINAPI CommonQuery_QueryInterface(ICommonQuery *iface, REFIID rii
         return S_OK;
     }
 
-    FIXME("interface %s not implemented\n", debugstr_guid(riid));
+    WARN("interface %s not implemented\n", debugstr_guid(riid));
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -165,9 +165,14 @@ static ULONG WINAPI CommonQuery_Release(ICommonQuery *iface)
 static HRESULT WINAPI CommonQuery_OpenQueryWindow(ICommonQuery *iface,
         HWND parent, LPOPENQUERYWINDOW query_window, IDataObject **data_object)
 {
-    FIXME("(%p)->(%p, %p, %p) stub!\n", iface, parent, query_window, data_object);
+    TRACE("(%p)->(%p, %p, %p)\n", iface, parent, query_window, data_object);
 
-    return E_NOTIMPL;
+    if (!query_window || query_window->cbStruct < sizeof(*query_window))
+        return E_INVALIDARG;
+    if (data_object) *data_object = NULL;
+
+    /* the query form searches a directory; without a domain there is nothing to search */
+    return HRESULT_FROM_WIN32(ERROR_NO_SUCH_DOMAIN);
 }
 
 static const ICommonQueryVtbl CommonQuery_vtbl =
@@ -204,7 +209,7 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, void **out)
     if (!IsEqualGUID( &IID_IClassFactory, riid)
         && !IsEqualGUID( &IID_IUnknown, riid))
     {
-        FIXME("interface %s not implemented\n", debugstr_guid(riid));
+        WARN("interface %s not implemented\n", debugstr_guid(riid));
         *out = NULL;
         return E_NOINTERFACE;
     }
@@ -221,7 +226,7 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, void **out)
         return S_OK;
     }
 
-    FIXME("%s: no class found\n", debugstr_guid(rclsid));
+    WARN("%s: no class found\n", debugstr_guid(rclsid));
     *out = NULL;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
diff --git a/dlls/dsuiext/dsuiext.c b/dlls/dsuiext/dsuiext.c
index 5867c67..23a8e79 100644
--- a/dlls/dsuiext/dsuiext.c
+++ b/dlls/dsuiext/dsuiext.c
@@ -36,8 +36,13 @@ typedef struct
 {
     IDsDisplaySpecifier IDsDisplaySpecifier_iface;
     LONG ref;
+    WCHAR *server;
+    LANGID lang;
 } DisplaySpec;
 
+/* There is no directory service: the display specifiers of a domain cannot be read. */
+#define E_NO_DOMAIN HRESULT_FROM_WIN32(ERROR_NO_SUCH_DOMAIN)
+
 static inline DisplaySpec *impl_from_IDsDisplaySpecifier(IDsDisplaySpecifier *iface)
 {
     return CONTAINING_RECORD(iface, DisplaySpec, IDsDisplaySpecifier_iface);
@@ -57,7 +62,8 @@ static HRESULT WINAPI dispspec_QueryInterface(IDsDisplaySpecifier *iface, REFIID
         return S_OK;
     }
 
-    FIXME("interface %s is not implemented\n", debugstr_guid(iid));
+    WARN("interface %s is not implemented\n", debugstr_guid(iid));
+    *obj = NULL;
     return E_NOINTERFACE;
 }
 
@@ -75,6 +81,7 @@ static ULONG WINAPI dispspec_Release(IDsDisplaySpecifier *iface)
     if (!ref)
     {
         TRACE("destroying %p\n", iface);
+        free(dispspec->server);
         free(dispspec);
     }
 
@@ -84,76 +91,135 @@ static ULONG WINAPI dispspec_Release(IDsDisplaySpecifier *iface)
 static HRESULT WINAPI dispspec_SetServer(IDsDisplaySpecifier *iface, LPCWSTR server, LPCWSTR user,
                                          LPCWSTR password, DWORD flags)
 {
-    FIXME("%p,%s,%s,%p,%08lx: stub\n", iface, debugstr_w(server), debugstr_w(user), password, flags);
-    return E_NOTIMPL;
+    DisplaySpec *dispspec = impl_from_IDsDisplaySpecifier(iface);
+    WCHAR *copy = NULL;
+
+    TRACE("%p,%s,%s,%p,%08lx\n", iface, debugstr_w(server), debugstr_w(user), password, flags);
+
+    /* the credentials are only needed when a directory is contacted */
+    if (server && !(copy = wcsdup(server))) return E_OUTOFMEMORY;
+    free(dispspec->server);
+    dispspec->server = copy;
+    return S_OK;
 }
 
 static HRESULT WINAPI dispspec_SetLanguageID(IDsDisplaySpecifier *iface, LANGID lang)
 {
-    FIXME("%p,%08x: stub\n", iface, lang);
-    return E_NOTIMPL;
+    DisplaySpec *dispspec = impl_from_IDsDisplaySpecifier(iface);
+
+    TRACE("%p,%08x\n", iface, lang);
+
+    dispspec->lang = lang;
+    return S_OK;
 }
 
 static HRESULT WINAPI dispspec_GetDisplaySpecifier(IDsDisplaySpecifier *iface, LPCWSTR object,
                                                    REFIID iid, void **obj)
 {
-    FIXME("%p,%s,%s,%p: stub\n", iface, debugstr_w(object), debugstr_guid(iid), obj);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%s,%p\n", iface, debugstr_w(object), debugstr_guid(iid), obj);
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!object || !iid) return E_INVALIDARG;
+    return E_NO_DOMAIN;
 }
 
 static HRESULT WINAPI dispspec_GetIconLocation(IDsDisplaySpecifier *iface, LPCWSTR object,
                                                DWORD flags, LPWSTR buffer, INT size, INT *id)
 {
-    FIXME("%p,%s,%08lx,%p,%d,%p: stub\n", iface, debugstr_w(object), flags, buffer, size, id);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%08lx,%p,%d,%p\n", iface, debugstr_w(object), flags, buffer, size, id);
+
+    if (!object || !buffer || size <= 0 || !id) return E_INVALIDARG;
+    buffer[0] = 0;
+    *id = 0;
+    return E_NO_DOMAIN;
 }
 
 static HICON WINAPI dispspec_GetIcon(IDsDisplaySpecifier *iface, LPCWSTR object,
                                      DWORD flags, INT cx, INT cy)
 {
-    FIXME("%p,%s,%08lx,%dx%d: stub\n", iface, debugstr_w(object), flags, cx, cy);
+    TRACE("%p,%s,%08lx,%dx%d\n", iface, debugstr_w(object), flags, cx, cy);
+
+    /* no display specifier has an icon without a directory */
     return 0;
 }
 
 static HRESULT WINAPI dispspec_GetFriendlyClassName(IDsDisplaySpecifier *iface, LPCWSTR object,
                                                     LPWSTR buffer, INT size)
 {
-    FIXME("%p,%s,%p,%d: stub\n", iface, debugstr_w(object), buffer, size);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%p,%d\n", iface, debugstr_w(object), buffer, size);
+
+    if (!object || !buffer || size <= 0) return E_INVALIDARG;
+
+    /* without a display specifier the class name is its own friendly name */
+    lstrcpynW(buffer, object, size);
+    return S_OK;
 }
 
 static HRESULT WINAPI dispspec_GetFriendlyAttributeName(IDsDisplaySpecifier *iface, LPCWSTR object,
                                                         LPCWSTR name, LPWSTR buffer, UINT size)
 {
-    FIXME("%p,%s,%s,%p,%d: stub\n", iface, debugstr_w(object), debugstr_w(name), buffer, size);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%s,%p,%d\n", iface, debugstr_w(object), debugstr_w(name), buffer, size);
+
+    if (!object || !name || !buffer || !size) return E_INVALIDARG;
+
+    /* without a display specifier the attribute name is its own friendly name */
+    lstrcpynW(buffer, name, size);
+    return S_OK;
 }
 
 static BOOL WINAPI dispspec_IsClassContainer(IDsDisplaySpecifier *iface, LPCWSTR object,
                                              LPCWSTR path, DWORD flags)
 {
-    FIXME("%p,%s,%s,%08lx: stub\n", iface, debugstr_w(object), debugstr_w(path), flags);
+    TRACE("%p,%s,%s,%08lx\n", iface, debugstr_w(object), debugstr_w(path), flags);
+
     return FALSE;
 }
 
 static HRESULT WINAPI dispspec_GetClassCreationInfo(IDsDisplaySpecifier *iface, LPCWSTR object,
                                                     LPDSCLASSCREATIONINFO *info)
 {
-    FIXME("%p,%s,%p: stub\n", iface, debugstr_w(object), info);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%p\n", iface, debugstr_w(object), info);
+
+    if (!info) return E_INVALIDARG;
+    *info = NULL;
+    return E_NO_DOMAIN;
 }
 
 static HRESULT WINAPI dispspec_EnumClassAttributes(IDsDisplaySpecifier *iface, LPCWSTR object,
                                                    LPDSENUMATTRIBUTES cb, LPARAM param)
 {
-    FIXME("%p,%s,%p,%08Ix: stub\n", iface, debugstr_w(object), cb, param);
-    return E_NOTIMPL;
+    TRACE("%p,%s,%p,%08Ix\n", iface, debugstr_w(object), cb, param);
+
+    if (!object || !cb) return E_INVALIDARG;
+    /* a class without a display specifier has no attributes to list */
+    return S_OK;
 }
 
 static ADSTYPE WINAPI dispspec_GetAttributeADsType(IDsDisplaySpecifier *iface, LPCWSTR name)
 {
-    FIXME("%p,%s: stub\n", iface, debugstr_w(name));
-    return ADSTYPE_INVALID;
+    static const struct { const WCHAR *name; ADSTYPE type; } types[] =
+    {
+        { L"objectGUID", ADSTYPE_OCTET_STRING }, { L"objectSid", ADSTYPE_OCTET_STRING },
+        { L"nTSecurityDescriptor", ADSTYPE_NT_SECURITY_DESCRIPTOR },
+        { L"whenCreated", ADSTYPE_UTC_TIME }, { L"whenChanged", ADSTYPE_UTC_TIME },
+        { L"userAccountControl", ADSTYPE_INTEGER }, { L"groupType", ADSTYPE_INTEGER },
+        { L"primaryGroupID", ADSTYPE_INTEGER }, { L"sAMAccountType", ADSTYPE_INTEGER },
+        { L"uSNCreated", ADSTYPE_LARGE_INTEGER }, { L"uSNChanged", ADSTYPE_LARGE_INTEGER },
+        { L"lastLogon", ADSTYPE_LARGE_INTEGER }, { L"pwdLastSet", ADSTYPE_LARGE_INTEGER },
+        { L"accountExpires", ADSTYPE_LARGE_INTEGER },
+        { L"distinguishedName", ADSTYPE_DN_STRING }, { L"member", ADSTYPE_DN_STRING },
+        { L"memberOf", ADSTYPE_DN_STRING }, { L"manager", ADSTYPE_DN_STRING },
+        { L"adminCount", ADSTYPE_INTEGER },
+    };
+    unsigned int i;
+
+    TRACE("%p,%s\n", iface, debugstr_w(name));
+
+    if (!name) return ADSTYPE_INVALID;
+    for (i = 0; i < ARRAY_SIZE(types); i++)
+        if (!wcsicmp(name, types[i].name)) return types[i].type;
+    return ADSTYPE_CASE_IGNORE_STRING;
 }
 
 static const IDsDisplaySpecifierVtbl IDsDisplaySpecifier_vtbl =
@@ -179,7 +245,7 @@ static HRESULT DsDisplaySpecifier_create(REFIID iid, void **obj)
     DisplaySpec *dispspec;
     HRESULT hr;
 
-    dispspec = malloc(sizeof(*dispspec));
+    dispspec = calloc(1, sizeof(*dispspec));
     if (!dispspec) return E_OUTOFMEMORY;
 
     dispspec->IDsDisplaySpecifier_iface.lpVtbl = &IDsDisplaySpecifier_vtbl;
@@ -191,6 +257,23 @@ static HRESULT DsDisplaySpecifier_create(REFIID iid, void **obj)
     return hr;
 }
 
+HRESULT WINAPI DsGetFriendlyClassName(LPCWSTR object, LPWSTR buffer, UINT size)
+{
+    TRACE("%s,%p,%u\n", debugstr_w(object), buffer, size);
+
+    if (!object || !buffer || !size) return E_INVALIDARG;
+    lstrcpynW(buffer, object, size);
+    return S_OK;
+}
+
+HICON WINAPI DsGetIcon(DWORD flags, LPCWSTR object, INT cx, INT cy)
+{
+    TRACE("%08lx,%s,%dx%d\n", flags, debugstr_w(object), cx, cy);
+
+    /* no display specifier has an icon without a directory */
+    return 0;
+}
+
 static const struct class_info
 {
     const CLSID *clsid;
@@ -227,7 +310,7 @@ static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID iid, L
     }
 
     *obj = NULL;
-    FIXME("interface %s is not implemented\n", debugstr_guid(iid));
+    WARN("interface %s is not implemented\n", debugstr_guid(iid));
     return E_NOINTERFACE;
 }
 
@@ -270,7 +353,7 @@ static HRESULT WINAPI factory_CreateInstance(IClassFactory *iface, IUnknown *out
 
 static HRESULT WINAPI factory_LockServer(IClassFactory *iface, BOOL lock)
 {
-    FIXME("%p,%d: stub\n", iface, lock);
+    TRACE("%p,%d\n", iface, lock);
     return S_OK;
 }
 
@@ -317,6 +400,6 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, LPVOID *obj)
             return factory_constructor(&class_info[i], iid, obj);
     }
 
-    FIXME("class %s/%s is not implemented\n", debugstr_guid(clsid), debugstr_guid(iid));
+    WARN("class %s/%s is not implemented\n", debugstr_guid(clsid), debugstr_guid(iid));
     return CLASS_E_CLASSNOTAVAILABLE;
 }
diff --git a/dlls/dsuiext/dsuiext.spec b/dlls/dsuiext/dsuiext.spec
index 5b1ac2a..c3d1571 100644
--- a/dlls/dsuiext/dsuiext.spec
+++ b/dlls/dsuiext/dsuiext.spec
@@ -5,5 +5,5 @@
 @ stdcall -private DllUnregisterServer()
 @ stub DsBrowseForContainerA
 @ stub DsBrowseForContainerW
-@ stub DsGetFriendlyClassName
-@ stub DsGetIcon
+@ stdcall DsGetFriendlyClassName(wstr ptr long)
+@ stdcall DsGetIcon(long wstr long long)
