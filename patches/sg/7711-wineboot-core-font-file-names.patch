From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineboot: the core fonts' file names in the fonts folder, for the Liberation fonts

---
diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
index d24dd4b..e17379d 100644
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1865,6 +1865,66 @@ static BOOL make_font_link( const WCHAR *link, const WCHAR *path )
     return CreateSymbolicLinkW( link, target, 0 );
 }
 
+/* Stained Glass OS (wine-sg 7711): the file names of Windows' core fonts, for the metric-compatible
+ * fonts the system has. Programs that open the core fonts by file name rather than through GDI --
+ * Java's runtime on Windows, whose logical fonts (Dialog, SansSerif, Serif, Monospaced) are
+ * ARIAL.TTF, TIMES.TTF and COUR.TTF in the fonts folder -- found none of them and drew every letter
+ * as a box (Charles through the Store, 2026-11-08). A link of that name to the Liberation font, made
+ * only where the folder has no such file; the font keeps its own family name, and the link is
+ * recorded like the others (win32u does not load it twice, an installer's own file replaces it). */
+static const struct
+{
+    const WCHAR *file;      /* the name in the fonts folder */
+    const WCHAR *value;     /* the registered font it links to (HKLM ...\Fonts value) */
+} font_aliases[] =
+{
+    { L"arial.ttf",   L"Liberation Sans (TrueType)" },
+    { L"arialbd.ttf", L"Liberation Sans Bold (TrueType)" },
+    { L"ariali.ttf",  L"Liberation Sans Italic (TrueType)" },
+    { L"arialbi.ttf", L"Liberation Sans Bold Italic (TrueType)" },
+    { L"times.ttf",   L"Liberation Serif (TrueType)" },
+    { L"timesbd.ttf", L"Liberation Serif Bold (TrueType)" },
+    { L"timesi.ttf",  L"Liberation Serif Italic (TrueType)" },
+    { L"timesbi.ttf", L"Liberation Serif Bold Italic (TrueType)" },
+    { L"cour.ttf",    L"Liberation Mono (TrueType)" },
+    { L"courbd.ttf",  L"Liberation Mono Bold (TrueType)" },
+    { L"couri.ttf",   L"Liberation Mono Italic (TrueType)" },
+    { L"courbi.ttf",  L"Liberation Mono Bold Italic (TrueType)" },
+};
+
+static DWORD link_font_aliases( const WCHAR *fonts_dir, HKEY fonts_key, HKEY links_key )
+{
+    WCHAR data[MAX_PATH], link[MAX_PATH], target[MAX_PATH];
+    DWORD i, type, len, linked = 0;
+
+    for (i = 0; i < ARRAY_SIZE(font_aliases); i++)
+    {
+        len = sizeof(data) - sizeof(WCHAR);
+        if (RegQueryValueExW( fonts_key, font_aliases[i].value, NULL, &type, (BYTE *)data, &len ) || type != REG_SZ)
+            continue;
+        data[len / sizeof(WCHAR)] = 0;
+        if (!is_full_font_path( data ) || GetFileAttributesW( data ) == INVALID_FILE_ATTRIBUTES) continue;
+        swprintf( link, ARRAY_SIZE(link), L"%s\\%s", fonts_dir, font_aliases[i].file );
+        len = sizeof(target);
+        if (!RegQueryValueExW( links_key, font_aliases[i].file, NULL, &type, (BYTE *)target, &len ))
+        {
+            /* ours: for this font still, made again if it went */
+            if (!wcsicmp( target, data ) && GetFileAttributesW( link ) != INVALID_FILE_ATTRIBUTES) continue;
+            if (!is_our_link( link )) continue;
+        }
+        else if (GetFileAttributesW( link ) != INVALID_FILE_ATTRIBUTES) continue;   /* the real font, or not ours */
+        if (is_our_link( link ) && GetFileAttributesW( link ) != INVALID_FILE_ATTRIBUTES) DeleteFileW( link );
+        if (make_font_link( link, data ))
+        {
+            RegSetValueExW( links_key, font_aliases[i].file, 0, REG_SZ, (const BYTE *)data,
+                            (lstrlenW( data ) + 1) * sizeof(WCHAR) );
+            linked++;
+        }
+        else WARN( "could not link %s to %s: %lu\n", debugstr_w(link), debugstr_w(data), GetLastError() );
+    }
+    return linked;
+}
+
 static void link_system_fonts(void)
 {
     WCHAR fonts_dir[MAX_PATH], name[512], data[MAX_PATH], link[MAX_PATH], target[MAX_PATH];
@@ -1908,6 +1968,16 @@ static void link_system_fonts(void)
             if (type == REG_SZ && !wcsicmp( data, target )) { found = 1; break; }
         }
         swprintf( link, ARRAY_SIZE(link), L"%s\\%s", fonts_dir, name );
+#ifndef SG_MUTANT_FONT_ALIAS_KEEP_FILE
+        /* Stained Glass OS (wine-sg 7711): a file put in its place (an installer's own Arial over our
+         * alias) is not ours: its record goes (win32u would otherwise skip it), the file stays */
+        if (!is_our_link( link ))
+        {
+            RegDeleteValueW( links_key, name );
+            removed++;
+            continue;
+        }
+#endif
         if (!found || GetFileAttributesW( target ) == INVALID_FILE_ATTRIBUTES)
         {
             if (is_our_link( link )) DeleteFileW( link );
@@ -1975,6 +2045,9 @@ static void link_system_fonts(void)
             break;
         }
     }
+#ifndef SG_MUTANT_NO_FONT_ALIASES
+    linked += link_font_aliases( fonts_dir, fonts_key, links_key );
+#endif
     TRACE( "%lu font links made, %lu removed\n", linked, removed );
     RegCloseKey( fonts_key );
     RegCloseKey( links_key );
