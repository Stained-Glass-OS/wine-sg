+static void _test_dispatch_prop(unsigned line, IDispatch *disp, const WCHAR *name, const WCHAR *value, const WCHAR *expected)
+{
+    DISPID dispid, propput = DISPID_PROPERTYPUT;
+    DISPPARAMS dp = { NULL, NULL, 0, 0 };
+    VARIANT arg, res;
+    BSTR bstr_name;
+    HRESULT hres;
+
+    bstr_name = SysAllocString(name);
+    hres = IDispatch_GetIDsOfNames(disp, &IID_NULL, &bstr_name, 1, LOCALE_NEUTRAL, &dispid);
+    SysFreeString(bstr_name);
+    ok_(__FILE__,line)(hres == S_OK, "GetIDsOfNames(%s) failed: %08lx\n", wine_dbgstr_w(name), hres);
+    if(FAILED(hres))
+        return;
+
+    V_VT(&arg) = VT_BSTR;
+    V_BSTR(&arg) = SysAllocString(value);
+    dp.rgvarg = &arg;
+    dp.cArgs = 1;
+    dp.rgdispidNamedArgs = &propput;
+    dp.cNamedArgs = 1;
+    hres = IDispatch_Invoke(disp, dispid, &IID_NULL, LOCALE_NEUTRAL, DISPATCH_PROPERTYPUT, &dp, NULL, NULL, NULL);
+    ok_(__FILE__,line)(hres == S_OK, "put %s failed: %08lx\n", wine_dbgstr_w(name), hres);
+    VariantClear(&arg);
+
+    dp.cArgs = dp.cNamedArgs = 0;
+    dp.rgvarg = NULL;
+    dp.rgdispidNamedArgs = NULL;
+    V_VT(&res) = VT_EMPTY;
+    hres = IDispatch_Invoke(disp, dispid, &IID_NULL, LOCALE_NEUTRAL, DISPATCH_PROPERTYGET, &dp, &res, NULL, NULL);
+    ok_(__FILE__,line)(hres == S_OK, "get %s failed: %08lx\n", wine_dbgstr_w(name), hres);
+    if(hres == S_OK) {
+        ok_(__FILE__,line)(V_VT(&res) == VT_BSTR && V_BSTR(&res) && !lstrcmpW(V_BSTR(&res), expected),
+                "%s = %s, expected %s\n", wine_dbgstr_w(name), wine_dbgstr_variant(&res), wine_dbgstr_w(expected));
+        VariantClear(&res);
+    }
+}
