diff --git a/dlls/sgdbgsock/main.c b/dlls/sgdbgsock/main.c
new file mode 100644
index 0000000..955238f
--- /dev/null
+++ b/dlls/sgdbgsock/main.c
@@ -0,0 +1,109 @@
+/*
+ * Stained Glass OS: a debugger's connection to Wine Mono's debugger agent,
+ * private to the user (wine-sg 7791)
+ *
+ * Wine Mono's soft debugger agent (debugger-agent.c, transport "dt_unix")
+ * and a debugger in another process meet on a Unix socket in the user's own
+ * runtime directory ($XDG_RUNTIME_DIR/wine-mono-debug/NAME.sock): the
+ * directory and the socket are the user's alone (0700, 0600), and each end
+ * takes a connection only from a process of the same user (SO_PEERCRED). The
+ * agent runs whatever the debugger asks in the process, so no other user may
+ * reach it -- a TCP port, even on loopback, every local user can.
+ *
+ * The socket is the calling process's own, opened by the Unix side of this
+ * DLL in that process: never the wineserver's (shared by every user of a
+ * shared prefix, it is not the user).
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "unixlib.h"
+
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( instance );
+        if (__wine_init_unix_call()) return FALSE;
+    }
+    return TRUE;
+}
+
+/* the agent's end: listens on NAME (letters, digits, '-' and '_') */
+BOOL WINAPI SgDbgListen( const char *name, UINT64 *listener )
+{
+    struct sgdbg_params params = { .name = (ULONG_PTR)name };
+
+    if (!name || !listener || WINE_UNIX_CALL( unix_sgdbg_listen, &params )) return FALSE;
+    *listener = params.handle;
+    return TRUE;
+}
+
+/* waits for a debugger of this user; the socket's name is gone after */
+BOOL WINAPI SgDbgAccept( UINT64 listener, UINT64 *conn )
+{
+    struct sgdbg_params params = { .handle = listener };
+
+    if (!conn || WINE_UNIX_CALL( unix_sgdbg_accept, &params )) return FALSE;
+    *conn = params.handle;
+    return TRUE;
+}
+
+/* the debugger's end: connects to the agent listening on NAME, if it is this user's */
+BOOL WINAPI SgDbgConnect( const char *name, UINT64 *conn )
+{
+    struct sgdbg_params params = { .name = (ULONG_PTR)name };
+
+    if (!name || !conn || WINE_UNIX_CALL( unix_sgdbg_connect, &params )) return FALSE;
+    *conn = params.handle;
+    return TRUE;
+}
+
+/* all of BUF, or -1 */
+int WINAPI SgDbgSend( UINT64 conn, const void *buf, int len )
+{
+    struct sgdbg_params params = { .handle = conn, .buf = (ULONG_PTR)buf, .len = len };
+
+    if (len < 0 || WINE_UNIX_CALL( unix_sgdbg_send, &params )) return -1;
+    return (int)params.len;
+}
+
+/* LEN bytes, fewer at the end of the stream (0: closed), or -1 */
+int WINAPI SgDbgRecv( UINT64 conn, void *buf, int len )
+{
+    struct sgdbg_params params = { .handle = conn, .buf = (ULONG_PTR)buf, .len = len };
+
+    if (len < 0 || WINE_UNIX_CALL( unix_sgdbg_recv, &params )) return -1;
+    return (int)params.len;
+}
+
+void WINAPI SgDbgShutdown( UINT64 conn, int how )
+{
+    struct sgdbg_params params = { .handle = conn, .how = how };
+    WINE_UNIX_CALL( unix_sgdbg_shutdown, &params );
+}
+
+void WINAPI SgDbgClose( UINT64 conn )
+{
+    struct sgdbg_params params = { .handle = conn };
+    WINE_UNIX_CALL( unix_sgdbg_close, &params );
+}
