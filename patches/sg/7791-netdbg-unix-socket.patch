+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mscoree);
+
+#define MAX_LISTENERS 8
+
+/* the listening sockets' paths, taken away once a debugger came */
+static struct { int fd; char path[sizeof(((struct sockaddr_un *)0)->sun_path)]; } listeners[MAX_LISTENERS];
+static pthread_mutex_t listeners_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* a directory of this user's alone: theirs, and nobody else's to enter or write */
+static BOOL private_dir( const char *dir )
+{
+    struct stat st;
+
+    if (lstat( dir, &st ) || !S_ISDIR( st.st_mode )) return FALSE;
+    if (st.st_uid != geteuid())
+    {
+        WARN( "%s is not this user's\n", dir );
+        return FALSE;
+    }
+    if (st.st_mode & 077)
+    {
+        WARN( "%s is open to others (%o)\n", dir, st.st_mode & 0777 );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* $XDG_RUNTIME_DIR/wine-mono-debug/NAME.sock, the directory made if needed */
+static BOOL socket_path( const char *name, struct sockaddr_un *addr )
+{
+    const char *runtime = getenv( "XDG_RUNTIME_DIR" );
+    char dir[sizeof(addr->sun_path)];
+    size_t i, len;
+
+    len = strlen( name );
+    if (!len || len > 64) return FALSE;
+    for (i = 0; i < len; i++)
+        if (!((name[i] >= 'a' && name[i] <= 'z') || (name[i] >= 'A' && name[i] <= 'Z') ||
+              (name[i] >= '0' && name[i] <= '9') || name[i] == '-' || name[i] == '_')) return FALSE;
+
+    /* no runtime directory, no socket: never one in a place others share (/tmp) */
+    if (!runtime || runtime[0] != '/' || !private_dir( runtime ))
+    {
+        WARN( "no private runtime directory (XDG_RUNTIME_DIR %s)\n", debugstr_a(runtime) );
+        return FALSE;
+    }
+    if (snprintf( dir, sizeof(dir), "%s/wine-mono-debug", runtime ) >= sizeof(dir)) return FALSE;
+#ifndef SG_MUTANT_DBGSOCK_OPEN_PERMS
+    if (mkdir( dir, 0700 ) && errno != EEXIST) return FALSE;
+#else
+    if (mkdir( dir, 0755 ) && errno != EEXIST) return FALSE;
+    chmod( dir, 0755 );
+#endif
+#ifndef SG_MUTANT_DBGSOCK_OPEN_PERMS
+    if (!private_dir( dir )) return FALSE;
+#endif
+
+    memset( addr, 0, sizeof(*addr) );
+    addr->sun_family = AF_UNIX;
+    if (snprintf( addr->sun_path, sizeof(addr->sun_path), "%s/%s.sock", dir, name ) >= sizeof(addr->sun_path))
+        return FALSE;
+    return TRUE;
+}
+
+/* the other end is this user's */
+static BOOL peer_is_us( int fd )
+{
+    struct ucred cred;
+    socklen_t len = sizeof(cred);
+
+    if (getsockopt( fd, SOL_SOCKET, SO_PEERCRED, &cred, &len ) || len != sizeof(cred)) return FALSE;
+#ifdef SG_MUTANT_DBGSOCK_ANY_PEER
+    return TRUE;
+#endif
+    if (cred.uid != geteuid())
+    {
+        WARN( "refused: the other end is uid %u, pid %d\n", cred.uid, cred.pid );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static NTSTATUS sgdbg_listen( void *args )
+{
+    struct sgdbg_params *params = args;
+    struct sockaddr_un addr;
+    struct stat st;
+    int fd, i;
+
+    if (!socket_path( (const char *)(ULONG_PTR)params->name, &addr )) return STATUS_ACCESS_DENIED;
+    /* one left by a process gone (the name is the agent's process id) */
+    if (!lstat( addr.sun_path, &st ))
+    {
+        if (!S_ISSOCK( st.st_mode ) || st.st_uid != geteuid()) return STATUS_OBJECT_NAME_COLLISION;
+        unlink( addr.sun_path );
+    }
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) == -1) return STATUS_TOO_MANY_OPENED_FILES;
+    if (bind( fd, (struct sockaddr *)&addr, sizeof(addr) ))
+    {
+        close( fd );
+        return STATUS_ACCESS_DENIED;
+    }
+#ifndef SG_MUTANT_DBGSOCK_OPEN_PERMS
+    chmod( addr.sun_path, 0600 );
+#else
+    chmod( addr.sun_path, 0666 );
+#endif
+    if (listen( fd, 4 ))
+    {
+        unlink( addr.sun_path );
+        close( fd );
+        return STATUS_UNSUCCESSFUL;
+    }
+    pthread_mutex_lock( &listeners_mutex );
+    for (i = 0; i < MAX_LISTENERS; i++)
+        if (!listeners[i].path[0])
+        {
+            listeners[i].fd = fd;
+            strcpy( listeners[i].path, addr.sun_path );
+            break;
+        }
+    pthread_mutex_unlock( &listeners_mutex );
+    TRACE( "listening on %s\n", debugstr_a(addr.sun_path) );
+    params->handle = fd;
+    return STATUS_SUCCESS;
+}
+
+static void forget_listener( int fd )
+{
+    int i;
+
+    pthread_mutex_lock( &listeners_mutex );
+    for (i = 0; i < MAX_LISTENERS; i++)
+        if (listeners[i].path[0] && listeners[i].fd == fd)
+        {
+            unlink( listeners[i].path );
+            listeners[i].path[0] = 0;
+        }
+    pthread_mutex_unlock( &listeners_mutex );
+}
+
+static NTSTATUS sgdbg_accept( void *args )
+{
+    struct sgdbg_params *params = args;
+    int listener = params->handle, fd;
+
+    for (;;)
+    {
+        if ((fd = accept4( listener, NULL, NULL, SOCK_CLOEXEC )) == -1)
+        {
+            if (errno == EINTR || errno == ECONNABORTED) continue;
+            forget_listener( listener );
+            close( listener );
+            return STATUS_UNSUCCESSFUL;
+        }
+        if (peer_is_us( fd )) break;
+        close( fd );   /* another user's: not even the handshake */
+    }
+    forget_listener( listener );
+    close( listener );
+    params->handle = fd;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sgdbg_connect( void *args )
+{
+    struct sgdbg_params *params = args;
+    struct sockaddr_un addr;
+    int fd;
+
+    if (!socket_path( (const char *)(ULONG_PTR)params->name, &addr )) return STATUS_ACCESS_DENIED;
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) == -1) return STATUS_TOO_MANY_OPENED_FILES;
+    while (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ))
+    {
+        if (errno == EINTR) continue;
+        close( fd );
+        return STATUS_CONNECTION_REFUSED;
+    }
+    if (!peer_is_us( fd ))
+    {
+        close( fd );
+        return STATUS_ACCESS_DENIED;
+    }
+    params->handle = fd;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sgdbg_send( void *args )
+{
+    struct sgdbg_params *params = args;
+    const char *buf = (const char *)(ULONG_PTR)params->buf;
+    size_t done = 0, len = params->len;
+    ssize_t ret;
+
+    while (done < len)
+    {
+        ret = send( params->handle, buf + done, len - done, MSG_NOSIGNAL );
+        if (ret == -1 && errno == EINTR) continue;
+        if (ret <= 0)
+        {
+            params->len = (UINT64)-1;
+            return STATUS_SUCCESS;
+        }
+        done += ret;
+    }
+    params->len = done;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sgdbg_recv( void *args )
+{
+    struct sgdbg_params *params = args;
+    char *buf = (char *)(ULONG_PTR)params->buf;
+    size_t done = 0, len = params->len;
+    ssize_t ret;
+
+    while (done < len)
+    {
+        ret = recv( params->handle, buf + done, len - done, 0 );
+        if (ret == -1 && errno == EINTR) continue;
+        if (ret == -1 && !done)
+        {
+            params->len = (UINT64)-1;
+            return STATUS_SUCCESS;
+        }
+        if (ret <= 0) break;
+        done += ret;
+    }
+    params->len = done;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sgdbg_shutdown( void *args )
+{
+    struct sgdbg_params *params = args;
+    shutdown( params->handle, params->how == 0 ? SHUT_RD : params->how == 1 ? SHUT_WR : SHUT_RDWR );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS sgdbg_close( void *args )
+{
+    struct sgdbg_params *params = args;
+    forget_listener( params->handle );
+    close( params->handle );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    sgdbg_listen,
+    sgdbg_accept,
+    sgdbg_connect,
+    sgdbg_send,
+    sgdbg_recv,
+    sgdbg_shutdown,
+    sgdbg_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_sgdbg_count );
+
+#ifdef _WIN64
+/* the parameters are all 64-bit fields: a 32-bit caller's are the same */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    sgdbg_listen,
+    sgdbg_accept,
+    sgdbg_connect,
+    sgdbg_send,
+    sgdbg_recv,
+    sgdbg_shutdown,
+    sgdbg_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_sgdbg_count );
+#endif
