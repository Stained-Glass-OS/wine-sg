 /* Stained Glass OS: Mono's soft debugger agent, for debuggers that speak its protocol (and ICorDebug), when
- * WINE_MONO_DEBUGGER_AGENT holds its options: transport=dt_socket,address=127.0.0.1:PORT[,server=y][,suspend=y].
- * The agent runs the debugger's requests in the process, so it is only ever given a loopback address. */
-static BOOL agent_address_is_loopback(const char *options)
-{
-    const char *address = strstr(options, "address="), *end;
-    char host[64];
-    size_t len;
-
-    if (!address || !strstr(options, "transport=dt_socket")) return FALSE;
-    address += 8;
-    if (!(end = strrchr(address, ':')) || (strchr(address, ',') && strchr(address, ',') < end)) return FALSE;
-    len = end - address;
-    if (!len || len >= sizeof(host)) return FALSE;
-    memcpy(host, address, len);
-    host[len] = 0;
-#ifdef SG_MUTANT_AGENT_ANY_ADDRESS
-    return TRUE;
-#endif
-    return !strcmp(host, "localhost") || !strcmp(host, "[::1]") || !strcmp(host, "::1") || !strncmp(host, "127.", 4);
+ * WINE_MONO_DEBUGGER_AGENT holds its options: transport=dt_unix[,server=y|n][,suspend=y|n][,address=NAME].
+ *
+ * The agent runs the debugger's requests in the process, so only the user's own processes may reach it: its
+ * one transport is dt_unix (Wine Mono's debugger-agent.c over sgdbgsock.dll), a Unix socket in the user's
+ * runtime directory, theirs alone (0700/0600), that takes a connection from the same user only (SO_PEERCRED).
+ * A server's socket is named after this process's id (ICorDebug finds it so); with server=n the agent
+ * connects to the debugger's socket NAME. There is no TCP transport at all, not even on loopback: every
+ * local user can reach a loopback port (wine-sg 6074 had one, opt-in; 7791 took it away). */
+static BOOL agent_option(const char *options, const char *key, char *value, size_t size)
+{
+    size_t klen = strlen(key);
+    const char *p = options, *end;
+
+    while (*p)
+    {
+        end = strchr(p, ',');
+        if (!end) end = p + strlen(p);
+        if ((size_t)(end - p) > klen && !strncmp(p, key, klen) && p[klen] == '=')
+        {
+            size_t len = end - p - klen - 1;
+            if (len >= size) return FALSE;
+            memcpy(value, p + klen + 1, len);
+            value[len] = 0;
+            return TRUE;
+        }
+        p = *end ? end + 1 : end;
+    }
+    return FALSE;
 }
 
 static void start_debugger_agent(void)
 {
-    char options[512], arg[600], *argv[1] = { arg };
+    char options[512], arg[600], transport[32], server[8] = "y", suspend[8] = "n", address[80], *argv[1] = { arg };
     DWORD len = GetEnvironmentVariableA("WINE_MONO_DEBUGGER_AGENT", options, sizeof(options));
 
     if (!len) return;
@@ -400,13 +411,41 @@ static void start_debugger_agent(void)
         ERR("cannot start the debugger agent\n");
         return;
     }
-    if (!agent_address_is_loopback(options))
+#ifndef SG_MUTANT_AGENT_TCP
+    if (!agent_option(options, "transport", transport, sizeof(transport)) || strcmp(transport, "dt_unix"))
+    {
+        ERR("the debugger agent's only transport is dt_unix (the user's own Unix socket): %s\n", debugstr_a(options));
+        return;
+    }
+    if (!mono_sg_debugger_unix_transport)
+    {
+        ERR("this Wine Mono has no dt_unix debugger transport: no agent\n");
+        return;
+    }
+#else
+    if (!strstr(options, "transport=dt_unix") || !mono_sg_debugger_unix_transport)
     {
-        ERR("the debugger agent takes a loopback address only: %s\n", debugstr_a(options));
+        snprintf(arg, sizeof(arg), "--debugger-agent=%s", options);
+        mono_jit_parse_options(1, argv);
+        mono_debug_init(1 /* MONO_DEBUG_FORMAT_MONO */);
         return;
     }
-    TRACE("debugger agent %s\n", debugstr_a(options));
-    snprintf(arg, sizeof(arg), "--debugger-agent=%s", options);
+    (void)transport;
+#endif
+    agent_option(options, "server", server, sizeof(server));
+    agent_option(options, "suspend", suspend, sizeof(suspend));
+    if (server[0] == 'n')
+    {
+        if (!agent_option(options, "address", address, sizeof(address)) || !address[0])
+        {
+            ERR("server=n needs the debugger's socket name (address=NAME)\n");
+            return;
+        }
+    }
+    else snprintf(address, sizeof(address), "%lu", GetCurrentProcessId());
+    snprintf(arg, sizeof(arg), "--debugger-agent=transport=dt_unix,address=%s,server=%s,suspend=%s",
+             address, server[0] == 'n' ? "n" : "y", suspend[0] == 'y' ? "y" : "n");
+    TRACE("%s\n", debugstr_a(arg));
     mono_jit_parse_options(1, argv);
     mono_debug_init(1 /* MONO_DEBUG_FORMAT_MONO */);
 }
