+static void set_process_affinity( struct process *process, affinity_t affinity );
+
+/* whether a job, or one it is nested in, is at its active process limit;
+ * the job's owner hears of it on its completion port */
+static int job_at_process_limit( struct job *job, struct process *process )
+{
+    struct job *j;
+
+#ifdef SG_MUTANT_NO_JOB_PROCESS_LIMIT
+    return 0;
+#endif
+    for (j = job; j; j = j->parent)
+    {
+        if (process && process->job == j) break;  /* already counted there */
+        if ((j->limit_flags & JOB_OBJECT_LIMIT_ACTIVE_PROCESS) && j->num_processes >= j->limits.active_processes)
+        {
+            add_job_completion( j, JOB_OBJECT_MSG_ACTIVE_PROCESS_LIMIT, 0 );
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* a job's priority class and affinity limits, applied to a process in it */
+static void apply_job_limits( struct job *job, struct process *process )
+{
+    if ((job->limit_flags & JOB_OBJECT_LIMIT_PRIORITY_CLASS) && job->limits.priority_class)
+        process->priority = job->limits.priority_class;
+    if ((job->limit_flags & JOB_OBJECT_LIMIT_AFFINITY) && job->limits.affinity)
+        set_process_affinity( process, process->affinity & job->limits.affinity ?
+                              process->affinity & job->limits.affinity : job->limits.affinity );
+}
+
 static void add_job_process( struct job *job, struct process *process )
 {
     struct job *j, *common_parent;
