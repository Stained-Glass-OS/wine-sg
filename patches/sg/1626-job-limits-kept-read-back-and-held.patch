+/* Stained Glass OS: job limits between the Win32 structures and the server's */
+static unsigned int priority_class_to_server( ULONG class )
+{
+    switch (class)
+    {
+    case IDLE_PRIORITY_CLASS:         return PROCESS_PRIOCLASS_IDLE;
+    case BELOW_NORMAL_PRIORITY_CLASS: return PROCESS_PRIOCLASS_BELOW_NORMAL;
+    case NORMAL_PRIORITY_CLASS:       return PROCESS_PRIOCLASS_NORMAL;
+    case ABOVE_NORMAL_PRIORITY_CLASS: return PROCESS_PRIOCLASS_ABOVE_NORMAL;
+    case HIGH_PRIORITY_CLASS:         return PROCESS_PRIOCLASS_HIGH;
+    case REALTIME_PRIORITY_CLASS:     return PROCESS_PRIOCLASS_REALTIME;
+    }
+    return 0;
+}
+
+static ULONG priority_class_from_server( unsigned int class )
+{
+    switch (class)
+    {
+    case PROCESS_PRIOCLASS_IDLE:         return IDLE_PRIORITY_CLASS;
+    case PROCESS_PRIOCLASS_BELOW_NORMAL: return BELOW_NORMAL_PRIORITY_CLASS;
+    case PROCESS_PRIOCLASS_NORMAL:       return NORMAL_PRIORITY_CLASS;
+    case PROCESS_PRIOCLASS_ABOVE_NORMAL: return ABOVE_NORMAL_PRIORITY_CLASS;
+    case PROCESS_PRIOCLASS_HIGH:         return HIGH_PRIORITY_CLASS;
+    case PROCESS_PRIOCLASS_REALTIME:     return REALTIME_PRIORITY_CLASS;
+    }
+    return 0;
+}
+
+static NTSTATUS get_job_limits( HANDLE handle, JOBOBJECT_EXTENDED_LIMIT_INFORMATION *info, ULONG *ui )
+{
+    struct job_limits limits;
+    unsigned int status;
+
+    memset( info, 0, sizeof(*info) );
+    memset( &limits, 0, sizeof(limits) );
+    SERVER_START_REQ( get_job_limits )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        wine_server_set_reply( req, &limits, sizeof(limits) );
+        if (!(status = wine_server_call( req )))
+        {
+            info->BasicLimitInformation.LimitFlags = reply->limit_flags;
+            if (ui) *ui = reply->ui_restrictions;
+        }
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+#ifndef SG_MUTANT_NO_JOB_LIMIT_VALUES
+    info->BasicLimitInformation.PerProcessUserTimeLimit.QuadPart = limits.per_process_user_time;
+    info->BasicLimitInformation.PerJobUserTimeLimit.QuadPart = limits.per_job_user_time;
+    info->BasicLimitInformation.MinimumWorkingSetSize = limits.min_working_set;
+    info->BasicLimitInformation.MaximumWorkingSetSize = limits.max_working_set;
+    info->BasicLimitInformation.ActiveProcessLimit = limits.active_processes;
+    info->BasicLimitInformation.Affinity = limits.affinity;
+    info->BasicLimitInformation.PriorityClass = priority_class_from_server( limits.priority_class );
+    info->BasicLimitInformation.SchedulingClass = limits.scheduling_class;
+    info->ProcessMemoryLimit = limits.process_memory;
+    info->JobMemoryLimit = limits.job_memory;
+#endif
+    return STATUS_SUCCESS;
+}
