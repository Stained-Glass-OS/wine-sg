@@ -1893,6 +1952,36 @@ DECL_HANDLER(set_job_limits)
     if (!job) return;
 
     job->limit_flags = req->limit_flags;
+    if (get_req_data_size() == sizeof(job->limits))
+    {
+        struct process *process;
+
+        memcpy( &job->limits, get_req_data(), sizeof(job->limits) );
+        LIST_FOR_EACH_ENTRY( process, &job->process_list, struct process, job_entry )
+            apply_job_limits( job, process );
+    }
+    release_object( job );
+}
