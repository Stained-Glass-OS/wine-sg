+/* ---- completed asynchronous operations ---- */
+
+static HRESULT WINAPI op_put_Completed( void *iface, IUnknown *handler )
+{
+    struct sobj *op = obj_of( iface );
+
+    if (!handler) return E_POINTER;
+    if (op->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    op->handler = handler;
+    IUnknown_AddRef( handler );
+    /* AsyncOperationCompletedHandler<T>.Invoke( operation, status ) */
+    return ((HRESULT (WINAPI *)( IUnknown *, void *, INT32 ))((void **)handler->lpVtbl)[3])( handler, iface, STATUS_COMPLETED );
+}
+
+static HRESULT WINAPI op_get_Completed( void *iface, IUnknown **handler )
+{
+    struct sobj *op = obj_of( iface );
+
+    if (!handler) return E_POINTER;
+    if ((*handler = op->handler)) IUnknown_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults( void *iface, void **result )
+{
+    struct sobj *op = obj_of( iface );
+
+    if (!result) return E_POINTER;
+    if ((*result = op->result)) IUnknown_AddRef( op->result );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults_string( void *iface, HSTRING *result )
+{
+    if (!result) return E_POINTER;
+    return WindowsDuplicateString( obj_of( iface )->string, result );
+}
+
+static const void *op_vtbl[] = { SOBJ_COMMON, op_put_Completed, op_get_Completed, op_GetResults };
+static const void *op_string_vtbl[] = { SOBJ_COMMON, op_put_Completed, op_get_Completed, op_GetResults_string };
+
+static HRESULT WINAPI info_get_Id( void *iface, UINT32 *id ) { if (!id) return E_POINTER; *id = 1; return S_OK; }
+static HRESULT WINAPI info_get_Status( void *iface, INT32 *status ) { if (!status) return E_POINTER; *status = STATUS_COMPLETED; return S_OK; }
+static HRESULT WINAPI info_get_ErrorCode( void *iface, HRESULT *code ) { if (!code) return E_POINTER; *code = S_OK; return S_OK; }
+static HRESULT WINAPI info_Cancel( void *iface ) { return S_OK; }
+static HRESULT WINAPI info_Close( void *iface ) { return S_OK; }
+static const void *info_vtbl[] = { SOBJ_COMMON, info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close };
+
+static HRESULT complete( const GUID *op_iid, const WCHAR *class_name, IUnknown *result, HSTRING string, void **out )
+{
+    struct sobj *op;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(op = sobj_new( class_name ))) return E_OUTOFMEMORY;
+    sobj_add( op, op_iid, op_iid == &IID_IAsyncOperation_STRING ? op_string_vtbl : op_vtbl );
+    sobj_add( op, &IID_IAsyncInfo_x, info_vtbl );
+    if ((op->result = result)) IUnknown_AddRef( result );
+    op->string = string;
+    *out = sobj_iface( op );
+    return S_OK;
+}
+
+/* a completed operation whose result is a new object of one interface */
+static HRESULT complete_with( const GUID *op_iid, const WCHAR *class_name, const GUID *iid, const void **vtbl, void **out )
+{
+    IUnknown *result;
+    HRESULT hr;
+
+    if (FAILED(hr = result_object( class_name, iid, vtbl, &result ))) return hr;
+    hr = complete( op_iid, L"Windows.Foundation.IAsyncOperation`1", result, NULL, out );
+    IUnknown_Release( result );
+    return hr;
+}
