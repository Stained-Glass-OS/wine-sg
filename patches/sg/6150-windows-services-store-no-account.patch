+/*
+ * Programs from the Microsoft Store ask StoreContext about their licence and add-ons (NanaZip asks
+ * whether its sponsor add-on was bought, on a thread of its own, and ends when the class is missing).
+ * There is no Microsoft Store here: StoreContext answers as a Windows machine signed in to no Store
+ * account would -- no products, an empty collection, an unlicensed non-trial app licence, no
+ * updates, purchases not made -- each call logged.  Every answer is a completed asynchronous
+ * operation.  Interface identity (IIDs, vtable order) per windows-rs (MIT); parameterized IIDs
+ * computed from the type signatures; the implementation is ours.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "objbase.h"
+#include "initguid.h"
+#include "activation.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(store);
+
+static const GUID IID_IAsyncInfo_x = { 0x00000036, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const GUID IID_IStoreContext = { 0xac98b6be, 0xf4fd, 0x4912, { 0xba, 0xbd, 0x50, 0x35, 0xe5, 0xe8, 0xbc, 0xab } };
+static const GUID IID_IStoreContextStatics = { 0x9c06ee5f, 0x15c0, 0x4e72, { 0x93, 0x30, 0xd6, 0x19, 0x1c, 0xeb, 0xd1, 0x9c } };
+static const GUID IID_IStoreProductQueryResult = { 0xd805e6c5, 0xd456, 0x4ff6, { 0x80, 0x49, 0x90, 0x76, 0xd5, 0x16, 0x5f, 0x73 } };
+static const GUID IID_IStoreProductPagedQueryResult = { 0xc92718c5, 0x4dd5, 0x4869, { 0xa4, 0x62, 0xec, 0xc6, 0x87, 0x2e, 0x43, 0xc5 } };
+static const GUID IID_IStoreProductResult = { 0xb7674f73, 0x3c87, 0x4ee1, { 0x82, 0x01, 0xf4, 0x28, 0x35, 0x9b, 0xd3, 0xaf } };
+static const GUID IID_IStorePurchaseResult = { 0xadd28552, 0xf96a, 0x463d, { 0xa7, 0xbb, 0xc2, 0x0b, 0x4f, 0xca, 0x69, 0x52 } };
+static const GUID IID_IStoreAppLicense = { 0xf389f9de, 0x73c0, 0x45ce, { 0x9b, 0xab, 0xb2, 0xfe, 0x3e, 0x5e, 0xaf, 0xd3 } };
+static const GUID IID_IStoreAppLicense2 = { 0xb4666e91, 0x4443, 0x40b3, { 0x99, 0x3f, 0x28, 0x90, 0x44, 0x35, 0xbd, 0xc6 } };
+
+/* parameterized interfaces of the results */
+static const GUID IID_IAsyncOperation_LICENSE = { 0x3866370b, 0xafc6, 0x5d01, { 0x84, 0xc2, 0x45, 0x74, 0x62, 0x8d, 0xe5, 0x39 } };
+static const GUID IID_IAsyncOperation_QUERY = { 0x9699e7bb, 0xea1f, 0x5e03, { 0x94, 0x39, 0xc8, 0x0e, 0x69, 0x77, 0xb7, 0x11 } };
+static const GUID IID_IAsyncOperation_PAGED = { 0x3079e7db, 0x1ba4, 0x5b9e, { 0x85, 0x6a, 0x65, 0x76, 0xbf, 0x7f, 0x9c, 0x8a } };
+static const GUID IID_IAsyncOperation_PRODUCT = { 0x9e61e86b, 0x6afb, 0x50ae, { 0xaf, 0xc1, 0xc5, 0x9f, 0x54, 0x51, 0x08, 0xdd } };
+static const GUID IID_IAsyncOperation_PURCHASE = { 0x33d8cc30, 0x78f5, 0x5f81, { 0xaa, 0x2d, 0xa4, 0xfa, 0x2a, 0x3b, 0x1c, 0x68 } };
+static const GUID IID_IAsyncOperation_STRING = { 0x3e1fe603, 0xf897, 0x5263, { 0xb3, 0x28, 0x08, 0x06, 0x42, 0x6b, 0x8a, 0x79 } };
+static const GUID IID_IAsyncOperation_UPDATES = { 0x0ac66c33, 0x45b8, 0x546b, { 0xaa, 0xaf, 0xd5, 0x8d, 0x62, 0xa4, 0xc5, 0xc5 } };
+static const GUID IID_IMapView_String_StoreProduct = { 0xdbaac6e5, 0x61a4, 0x5c88, { 0xb5, 0xd8, 0x3a, 0x3e, 0x16, 0x1c, 0x3e, 0x4a } };
+static const GUID IID_IIterable_KVP_StoreProduct = { 0x78a33722, 0xabfb, 0x57c0, { 0x85, 0x3f, 0x56, 0x16, 0xa3, 0xab, 0x8d, 0x57 } };
+static const GUID IID_IIterator_KVP_StoreProduct = { 0x0edb142c, 0x9d04, 0x532b, { 0x81, 0xe9, 0x4c, 0x84, 0xab, 0x09, 0xb3, 0x4b } };
+static const GUID IID_IMapView_String_StoreLicense = { 0x7d0d74f5, 0x4020, 0x54aa, { 0x9f, 0x3d, 0x0f, 0x17, 0x12, 0x7a, 0xcd, 0xdf } };
+static const GUID IID_IIterable_KVP_StoreLicense = { 0xca8ba445, 0x6f4d, 0x5da9, { 0x95, 0xee, 0x42, 0xcf, 0x11, 0x8d, 0xef, 0x63 } };
+static const GUID IID_IIterator_KVP_StoreLicense = { 0xa1509348, 0x6522, 0x5062, { 0xae, 0x86, 0xcf, 0x59, 0x54, 0x75, 0x92, 0x6d } };
+static const GUID IID_IVectorView_StorePackageUpdate = { 0x971c3ea6, 0x4388, 0x5a38, { 0xae, 0x13, 0x49, 0x29, 0xb6, 0xd6, 0xd7, 0x80 } };
+static const GUID IID_IIterable_StorePackageUpdate = { 0x6b076c51, 0x849e, 0x5ec5, { 0xae, 0xd5, 0x9b, 0x05, 0x85, 0x59, 0x19, 0x02 } };
+static const GUID IID_IIterator_StorePackageUpdate = { 0xb75dd77b, 0x87ca, 0x5956, { 0x89, 0x02, 0x84, 0xe9, 0xff, 0xc9, 0x7d, 0x83 } };
+
+enum { STATUS_COMPLETED = 1 };                     /* AsyncStatus.Completed */
+enum { PURCHASE_NOT_PURCHASED = 2 };              /* StorePurchaseStatus.NotPurchased */
+
+/* ---- objects of a few interfaces each ---- */
+
+#define MAX_IFACES 4
+
+struct sobj;
+struct iface { const void **vtbl; struct sobj *obj; };
+
+struct sobj
+{
+    LONG ref;
+    const WCHAR *class_name;
+    const GUID *iids[MAX_IFACES];
+    struct iface ifaces[MAX_IFACES];
+    unsigned int count;
+    IUnknown *result;               /* an operation's result (a reference), or its string */
+    HSTRING string;
+    IUnknown *handler;              /* an operation's Completed handler */
+    const GUID *empty_iids[3];      /* a result's empty collection: its view, iterable, iterator */
+};
+
+static struct sobj *obj_of( void *iface ) { return ((struct iface *)iface)->obj; }
+
+static HRESULT WINAPI sobj_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct sobj *obj = obj_of( iface );
+    unsigned int i;
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        *out = &obj->ifaces[0];
+        InterlockedIncrement( &obj->ref );
+        return S_OK;
+    }
+    for (i = 0; i < obj->count; i++)
+    {
+        if (!IsEqualGUID( iid, obj->iids[i] )) continue;
+        *out = &obj->ifaces[i];
+        InterlockedIncrement( &obj->ref );
+        return S_OK;
+    }
+    TRACE( "%s: %s not implemented\n", debugstr_w( obj->class_name ), debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sobj_AddRef( void *iface ) { return InterlockedIncrement( &obj_of( iface )->ref ); }
+
+static ULONG WINAPI sobj_Release( void *iface )
+{
+    struct sobj *obj = obj_of( iface );
+    ULONG ref = InterlockedDecrement( &obj->ref );
+
+    if (!ref)
+    {
+        if (obj->result) IUnknown_Release( obj->result );
+        if (obj->handler) IUnknown_Release( obj->handler );
+        WindowsDeleteString( obj->string );
+        free( obj );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI sobj_GetIids( void *iface, ULONG *count, IID **iids )
+{
+    struct sobj *obj = obj_of( iface );
+    unsigned int i;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( obj->count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < obj->count; i++) (*iids)[i] = *obj->iids[i];
+    *count = obj->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI sobj_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    const WCHAR *class_name = obj_of( iface )->class_name;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI sobj_GetTrustLevel( void *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define SOBJ_COMMON sobj_QueryInterface, sobj_AddRef, sobj_Release, sobj_GetIids, sobj_GetRuntimeClassName, sobj_GetTrustLevel
+
+static struct sobj *sobj_new( const WCHAR *class_name )
+{
+    struct sobj *obj = calloc( 1, sizeof(*obj) );
+
+    if (!obj) return NULL;
+    obj->ref = 1;
+    obj->class_name = class_name;
+    return obj;
+}
+
+static void sobj_add( struct sobj *obj, const GUID *iid, const void **vtbl )
+{
+    obj->iids[obj->count] = iid;
+    obj->ifaces[obj->count].vtbl = vtbl;
+    obj->ifaces[obj->count].obj = obj;
+    obj->count++;
+}
+
+static IUnknown *sobj_iface( struct sobj *obj ) { return (IUnknown *)&obj->ifaces[0]; }
+
+/* ---- empty collections: a map view or vector view, its iterable, an iterator ---- */
+
+static HRESULT WINAPI empty_iterator_Current( void *iface, void **value ) { if (value) *value = NULL; return E_BOUNDS; }
+static HRESULT WINAPI empty_iterator_HasCurrent( void *iface, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT WINAPI empty_iterator_MoveNext( void *iface, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT WINAPI empty_iterator_GetMany( void *iface, UINT32 size, void **items, UINT32 *count ) { if (!count) return E_POINTER; *count = 0; return S_OK; }
+static const void *empty_iterator_vtbl[] =
+{
+    SOBJ_COMMON, empty_iterator_Current, empty_iterator_HasCurrent, empty_iterator_MoveNext, empty_iterator_GetMany,
+};
+
+static HRESULT WINAPI empty_First( void *iface, void **value )
+{
+    struct sobj *obj = obj_of( iface ), *it;
+
+    if (!value) return E_POINTER;
+    if (!(it = sobj_new( L"Windows.Foundation.Collections.IIterator`1" ))) return E_OUTOFMEMORY;
+    sobj_add( it, obj->empty_iids[2], empty_iterator_vtbl );
+    *value = sobj_iface( it );
+    return S_OK;
+}
+static const void *empty_iterable_vtbl[] = { SOBJ_COMMON, empty_First };
+
+static HRESULT WINAPI empty_map_Lookup( void *iface, HSTRING key, void **value ) { if (value) *value = NULL; return E_BOUNDS; }
+static HRESULT WINAPI empty_Size( void *iface, UINT32 *value ) { if (!value) return E_POINTER; *value = 0; return S_OK; }
+static HRESULT WINAPI empty_map_HasKey( void *iface, HSTRING key, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT WINAPI empty_map_Split( void *iface, void **first, void **second )
+{
+    if (!first || !second) return E_POINTER;
+    *first = *second = NULL;
+    return S_OK;
+}
+static const void *empty_map_vtbl[] = { SOBJ_COMMON, empty_map_Lookup, empty_Size, empty_map_HasKey, empty_map_Split };
+
+static HRESULT WINAPI empty_vector_GetAt( void *iface, UINT32 index, void **value ) { if (value) *value = NULL; return E_BOUNDS; }
+static HRESULT WINAPI empty_vector_IndexOf( void *iface, void *value, UINT32 *index, boolean *found )
+{
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI empty_vector_GetMany( void *iface, UINT32 start, UINT32 size, void **items, UINT32 *count )
+{
+    if (!count) return E_POINTER;
+    *count = 0;
+    return S_OK;
+}
+static const void *empty_vector_vtbl[] = { SOBJ_COMMON, empty_vector_GetAt, empty_Size, empty_vector_IndexOf, empty_vector_GetMany };
+
+static IUnknown *empty_collection( BOOL map, const GUID *view, const GUID *iterable, const GUID *iterator )
+{
+    struct sobj *obj = sobj_new( map ? L"Windows.Foundation.Collections.IMapView`2" : L"Windows.Foundation.Collections.IVectorView`1" );
+
+    if (!obj) return NULL;
+#ifdef SG_MUTANT_STORE_NO_EMPTY
+    return NULL;
+#endif
+    sobj_add( obj, view, map ? empty_map_vtbl : empty_vector_vtbl );
+    sobj_add( obj, iterable, empty_iterable_vtbl );
+    obj->empty_iids[0] = view;
+    obj->empty_iids[1] = iterable;
+    obj->empty_iids[2] = iterator;
+    return sobj_iface( obj );
+}
+
+/* ---- results ---- */
+
+static HRESULT WINAPI result_get_Products( void *iface, void **value )
+{
+    if (!value) return E_POINTER;
+    *value = empty_collection( TRUE, &IID_IMapView_String_StoreProduct, &IID_IIterable_KVP_StoreProduct, &IID_IIterator_KVP_StoreProduct );
+    return *value ? S_OK : E_OUTOFMEMORY;
+}
+static HRESULT WINAPI result_get_ExtendedError( void *iface, HRESULT *value ) { if (!value) return E_POINTER; *value = S_OK; return S_OK; }
+static const void *query_result_vtbl[] = { SOBJ_COMMON, result_get_Products, result_get_ExtendedError };
+
+static HRESULT complete( const GUID *op_iid, const WCHAR *class_name, IUnknown *result, HSTRING string, void **out );
+
+static HRESULT WINAPI paged_get_HasMoreResults( void *iface, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT paged_result( IUnknown **out );
+static HRESULT WINAPI paged_GetNextAsync( void *iface, void **operation )
+{
+    IUnknown *result;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    if (FAILED(hr = paged_result( &result ))) return hr;
+    hr = complete( &IID_IAsyncOperation_PAGED, L"Windows.Foundation.IAsyncOperation`1", result, NULL, operation );
+    IUnknown_Release( result );
+    return hr;
+}
+static const void *paged_result_vtbl[] =
+{
+    SOBJ_COMMON, result_get_Products, paged_get_HasMoreResults, result_get_ExtendedError, paged_GetNextAsync,
+};
+
+static HRESULT WINAPI product_result_get_Product( void *iface, void **value ) { if (!value) return E_POINTER; *value = NULL; return S_OK; }
+static const void *product_result_vtbl[] = { SOBJ_COMMON, product_result_get_Product, result_get_ExtendedError };
+
+static HRESULT WINAPI purchase_result_get_Status( void *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = PURCHASE_NOT_PURCHASED;
+    return S_OK;
+}
+static const void *purchase_result_vtbl[] = { SOBJ_COMMON, purchase_result_get_Status, result_get_ExtendedError };
+
+static HRESULT WINAPI license_get_string( void *iface, HSTRING *value ) { if (!value) return E_POINTER; *value = NULL; return S_OK; }
+static HRESULT WINAPI license_get_false( void *iface, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT WINAPI license_get_time( void *iface, INT64 *value ) { if (!value) return E_POINTER; *value = 0; return S_OK; }
+static HRESULT WINAPI license_get_AddOnLicenses( void *iface, void **value )
+{
+    if (!value) return E_POINTER;
+    *value = empty_collection( TRUE, &IID_IMapView_String_StoreLicense, &IID_IIterable_KVP_StoreLicense, &IID_IIterator_KVP_StoreLicense );
+    return *value ? S_OK : E_OUTOFMEMORY;
+}
+/* SkuStoreId, IsActive, IsTrial, ExpirationDate, ExtendedJsonData, AddOnLicenses, TrialTimeRemaining,
+ * IsTrialOwnedByThisUser, TrialUniqueId */
+static const void *license_vtbl[] =
+{
+    SOBJ_COMMON, license_get_string, license_get_false, license_get_false, license_get_time, license_get_string,
+    license_get_AddOnLicenses, license_get_time, license_get_false, license_get_string,
+};
+static const void *license2_vtbl[] = { SOBJ_COMMON, license_get_false };
+
+static HRESULT result_object( const WCHAR *class_name, const GUID *iid, const void **vtbl, IUnknown **out )
+{
+    struct sobj *obj = sobj_new( class_name );
+
+    if (!obj) return E_OUTOFMEMORY;
+    sobj_add( obj, iid, vtbl );
+    *out = sobj_iface( obj );
+    return S_OK;
+}
