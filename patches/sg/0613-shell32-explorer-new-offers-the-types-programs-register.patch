+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_SGSHELLNEW_H
+#define __WINE_SGSHELLNEW_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <windef.h>
+#include <winbase.h>
+#include <winreg.h>
+
+#define SG_SHELLNEW_MAX 24
+
+struct sg_shellnew
+{
+    WCHAR ext[16];      /* ".docx" */
+    WCHAR name[96];     /* "Word Document" */
+};
+
+/* HKCR\.ext\ProgID\ShellNew or HKCR\.ext\ShellNew, if it says how to make a file */
+static inline HKEY sg_shellnew_key( const WCHAR *ext, WCHAR *progid, DWORD progid_len )
+{
+    static const WCHAR *kinds[] = { L"NullFile", L"Data", L"FileName" };
+    WCHAR sub[300];
+    DWORD size = progid_len * sizeof(WCHAR);
+    HKEY key;
+    unsigned int i, pass;
+
+    progid[0] = 0;
+    if (RegGetValueW( HKEY_CLASSES_ROOT, ext, NULL, RRF_RT_REG_SZ, NULL, progid, &size )) progid[0] = 0;
+    for (pass = 0; pass < 2; pass++)
+    {
+        if (pass == 0 && !progid[0]) continue;
+        if (pass == 0) swprintf( sub, ARRAY_SIZE(sub), L"%s\\%s\\ShellNew", ext, progid );
+        else swprintf( sub, ARRAY_SIZE(sub), L"%s\\ShellNew", ext );
+        if (RegOpenKeyExW( HKEY_CLASSES_ROOT, sub, 0, KEY_READ, &key )) continue;
+        for (i = 0; i < ARRAY_SIZE(kinds); i++)
+            if (!RegQueryValueExW( key, kinds[i], NULL, NULL, NULL, NULL )) return key;
+        RegCloseKey( key );
+    }
+    /* another ProgID's: SG Office's while the type opens in WordPad */
+    if (!RegOpenKeyExW( HKEY_CLASSES_ROOT, ext, 0, KEY_READ, &key ))
+    {
+        WCHAR name[200];
+        DWORD j, len;
+        HKEY found = NULL;
+        for (j = 0; !found && (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, j, name, &len, NULL, NULL, NULL, NULL )); j++)
+        {
+            HKEY sn;
+            if (!wcsicmp( name, L"ShellNew" ) || !wcsicmp( name, L"OpenWithProgids" ) || !wcsicmp( name, L"ShellEx" )) continue;
+            swprintf( sub, ARRAY_SIZE(sub), L"%s\\ShellNew", name );
+            if (RegOpenKeyExW( key, sub, 0, KEY_READ, &sn )) continue;
+            for (i = 0; i < ARRAY_SIZE(kinds) && !found; i++)
+                if (!RegQueryValueExW( sn, kinds[i], NULL, NULL, NULL, NULL )) found = sn;
+            if (found) lstrcpynW( progid, name, progid_len );
+            else RegCloseKey( sn );
+        }
+        RegCloseKey( key );
+        if (found) return found;
+    }
+    return NULL;
+}
+
+/* the types with a ShellNew, by name; .txt is left out (the menus have Text Document) */
+static inline int sg_shellnew_list( struct sg_shellnew *items, int max )
+{
+    WCHAR ext[64], progid[200], name[96];
+    DWORD i, len, size;
+    int n = 0, j;
+    HKEY key;
+
+    for (i = 0; len = ARRAY_SIZE(ext), !RegEnumKeyExW( HKEY_CLASSES_ROOT, i, ext, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        if (ext[0] != '.') continue;
+        if (len >= ARRAY_SIZE(items[0].ext) || !wcsicmp( ext, L".txt" )) continue;
+        if (!(key = sg_shellnew_key( ext, progid, ARRAY_SIZE(progid) ))) continue;
+        RegCloseKey( key );
+        size = sizeof(name);
+        if (!progid[0] || RegGetValueW( HKEY_CLASSES_ROOT, progid, NULL, RRF_RT_REG_SZ, NULL, name, &size ) || !name[0])
+        {
+            swprintf( name, ARRAY_SIZE(name), L"%s File", ext + 1 );
+            CharUpperBuffW( name, wcslen( ext + 1 ) );
+        }
+        if (wcspbrk( name, L"\\/:*?\"<>|" )) continue;
+        for (j = 0; j < n; j++) if (!wcsicmp( items[j].ext, ext )) break;
+        if (j < n) continue;
+        /* by name */
+        for (j = n; j > 0 && wcsicmp( items[j - 1].name, name ) > 0; j--)
+            if (j < max) items[j] = items[j - 1];
+        if (j >= max) continue;
+        lstrcpynW( items[j].ext, ext, ARRAY_SIZE(items[j].ext) );
+        lstrcpynW( items[j].name, name, ARRAY_SIZE(items[j].name) );
+        if (n < max) n++;
+    }
+    return n;
+}
+
+/* "New <name>.ext" in DIR, made as its ShellNew says; PATH (MAX_PATH) is the file */
+static inline BOOL sg_shellnew_create( const struct sg_shellnew *item, const WCHAR *dir, WCHAR *path )
+{
+    WCHAR progid[200], tmpl[MAX_PATH], full[MAX_PATH];
+    BYTE *data = NULL;
+    DWORD size = 0, type, put;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    HKEY key;
+    BOOL ok = TRUE;
+    int i;
+
+    if (!(key = sg_shellnew_key( item->ext, progid, ARRAY_SIZE(progid) ))) return FALSE;
+    for (i = 1; i < 1000 && file == INVALID_HANDLE_VALUE; i++)
+    {
+        if (i == 1) swprintf( path, MAX_PATH, L"%s\\New %s%s", dir, item->name, item->ext );
+        else swprintf( path, MAX_PATH, L"%s\\New %s (%d)%s", dir, item->name, i, item->ext );
+        file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+        if (file == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_EXISTS) break;
+    }
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        RegCloseKey( key );
+        return FALSE;
+    }
+    if (!RegQueryValueExW( key, L"Data", NULL, &type, NULL, &size ) && size && (data = malloc( size )) &&
+        !RegQueryValueExW( key, L"Data", NULL, &type, data, &size ))
+    {
+        /* a string is written as its characters, without the terminator */
+        if (type == REG_SZ || type == REG_EXPAND_SZ)
+        {
+            char *a = malloc( size );
+            int n = a ? WideCharToMultiByte( CP_ACP, 0, (WCHAR *)data, -1, a, size, NULL, NULL ) : 0;
+            if (n > 1) ok = WriteFile( file, a, n - 1, &put, NULL );
+            free( a );
+        }
+        else ok = WriteFile( file, data, size, &put, NULL );
+        CloseHandle( file );
+    }
+    else
+    {
+        CloseHandle( file );
+        size = sizeof(tmpl);
+        if (!RegQueryValueExW( key, L"FileName", NULL, NULL, (BYTE *)tmpl, &size ) && tmpl[0])
+        {
+            if (tmpl[1] == ':' || tmpl[0] == '\\') lstrcpynW( full, tmpl, MAX_PATH );
+            else
+            {
+                GetWindowsDirectoryW( full, MAX_PATH );
+                lstrcatW( full, L"\\ShellNew\\" );
+                lstrcatW( full, tmpl );
+            }
+            ok = CopyFileW( full, path, FALSE );
+        }
+    }
+    free( data );
+    RegCloseKey( key );
+    if (!ok) DeleteFileW( path );
+    return ok;
+}
+
+#endif /* __WINE_SGSHELLNEW_H */
