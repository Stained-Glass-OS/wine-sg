+/* New > a program's file type: "New <type>.ext", made as its ShellNew says, then renamed */
+static void new_type(int index)
+{
+    struct sg_shellnew types[SG_SHELLNEW_MAX];
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    ITEMIDLIST *pidl;
+
+    if (fe.content != CONTENT_FOLDER || !pidl_path(fe.pidl, dir)) return;
+    if (index >= sg_shellnew_list(types, ARRAY_SIZE(types))) return;
+    if (!sg_shellnew_create(&types[index], dir, path)) return;
+    if ((pidl = ILCreateFromPathW(path)))
+    {
+        SHChangeNotify(SHCNE_CREATE, SHCNF_IDLIST | SHCNF_FLUSH, pidl, NULL);
+        ILFree(pidl);
+    }
+    TRACE("created %s\n", debugstr_w(path));
+    lstrcpyW(fe.new_item, path);
+    fe.new_item_tries = 0;
+    SetFocus(get_view_list());
+    if (!rename_new_item()) SetTimer(fe.hwnd, TIMER_NEWITEM, 100, NULL);
+}
