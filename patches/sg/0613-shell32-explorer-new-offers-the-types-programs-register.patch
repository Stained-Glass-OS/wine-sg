 /* Background menu implementation */
+/* Stained Glass OS: New > the file types programs offer (their ShellNew
+ * keys, wine/sgshellnew.h), after Text Document */
+#define SG_FCIDM_NEWTYPE 0x7180
+
+static HMENU find_submenu_of( HMENU menu, UINT id )
+{
+    int i, count = GetMenuItemCount( menu );
+    for (i = 0; i < count; i++)
+    {
+        HMENU sub = GetSubMenu( menu, i ), found;
+        if (!sub) continue;
+        if (GetMenuState( sub, id, MF_BYCOMMAND ) != (UINT)-1)
+        {
+            int j, n = GetMenuItemCount( sub );
+            for (j = 0; j < n; j++) if (GetMenuItemID( sub, j ) == id) return sub;
+            if ((found = find_submenu_of( sub, id ))) return found;
+        }
+    }
+    return NULL;
+}
+
+/* the highest ID used, plus one, or 0 */
+static UINT add_new_types( HMENU menu, UINT offset, UINT last )
+{
+    struct sg_shellnew items[SG_SHELLNEW_MAX];
+    HMENU sub = find_submenu_of( menu, offset + FCIDM_SHVIEW_NEWTEXT );
+    int i, n;
+    UINT top = 0;
+
+    if (!sub) return 0;
+    n = sg_shellnew_list( items, ARRAY_SIZE(items) );
+    for (i = 0; i < n; i++)
+    {
+        UINT id = offset + SG_FCIDM_NEWTYPE + i;
+        if (id > last) break;
+        AppendMenuW( sub, MF_STRING, id, items[i].name );
+        top = id + 1;
+    }
+    return top;
+}
+
+/* New > a program's file type: "New <type>.ext" made as its ShellNew says,
+ * selected for renaming */
+static void DoNewType(ContextMenu *This, IShellView *view, int index)
+{
+    struct sg_shellnew items[SG_SHELLNEW_MAX];
+    IPersistFolder2 *pf;
+    LPITEMIDLIST folder = NULL, pidl = NULL;
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+
+    if (index >= sg_shellnew_list( items, ARRAY_SIZE(items) )) return;
+    if (FAILED(IShellFolder_QueryInterface(This->parent, &IID_IPersistFolder2, (void **)&pf))) return;
+    IPersistFolder2_GetCurFolder(pf, &folder);
+    IPersistFolder2_Release(pf);
+    if (!folder || !SHGetPathFromIDListW(folder, dir)) { ILFree(folder); return; }
+    ILFree(folder);
+    if (!sg_shellnew_create( &items[index], dir, path )) return;
+    SHChangeNotify(SHCNE_CREATE, SHCNF_PATHW, path, NULL);
+    if (view && SUCCEEDED(IShellFolder_ParseDisplayName(This->parent, NULL, NULL, PathFindFileNameW(path), NULL, &pidl, NULL)))
+    {
+        IShellView_Refresh(view);
+        IShellView_SelectItem(view, pidl, SVSI_DESELECTOTHERS | SVSI_EDIT | SVSI_ENSUREVISIBLE | SVSI_FOCUSED | SVSI_SELECT);
+        ILFree(pidl);
+    }
+}
+
