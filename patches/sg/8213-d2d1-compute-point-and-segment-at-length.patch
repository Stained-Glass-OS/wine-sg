From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: ID2D1PathGeometry1::ComputePointAndSegmentAtLength

The point at a length from a start segment, its unit tangent, and the segment (numbered across figures, a closed figure's closing line included) and figure it lies on, with the length up to that segment. Segments are those Simplify keeps with lines and cubics; Beziers are measured by chords within the tolerance. It returned E_NOTIMPL.
---
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -787,6 +787,8 @@
         float *area);
 HRESULT d2d_geometry_ops_compute_length(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform,
         float tolerance, float *length);
+HRESULT d2d_geometry_ops_compute_point_and_segment_at_length(ID2D1Geometry *geometry, float length,
+        UINT32 start_segment, const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_DESCRIPTION *desc);
 HRESULT d2d_geometry_ops_compute_point_at_length(ID2D1Geometry *geometry, float length,
         const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F *point, D2D1_POINT_2F *tangent);
 HRESULT d2d_geometry_ops_outline(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -4065,10 +4065,18 @@
         float length, UINT32 start_segment, const D2D1_MATRIX_3X2_F *transform, float tolerance,
         D2D1_POINT_DESCRIPTION *point_desc)
 {
+#ifndef SG_MUTANT_D2D_NO_POINT_SEGMENT
+    TRACE("iface %p, length %.8e, start_segment %u, transform %p, tolerance %.8e, point_desc %p.\n",
+            iface, length, start_segment, transform, tolerance, point_desc);
+
+    return d2d_geometry_ops_compute_point_and_segment_at_length((ID2D1Geometry *)iface, length, start_segment,
+            transform, tolerance, point_desc);
+#else
     FIXME("iface %p, length %.8e, start_segment %u, transform %p, tolerance %.8e, point_desc %p.\n",
             iface, length, start_segment, transform, tolerance, point_desc);
 
     return E_NOTIMPL;
+#endif
 }
 
 static const struct ID2D1PathGeometry1Vtbl d2d_path_geometry_vtbl =
--- a/dlls/d2d1/geometry_ops.c
+++ b/dlls/d2d1/geometry_ops.c
@@ -455,6 +455,221 @@
     return hr;
 }
 
+/* (wine-sg 8213) the path's segments as Simplify gives them with lines and cubics kept: one per line or
+ * Bézier, numbered across the figures, a closed figure's closing line included */
+struct seg_item
+{
+    D2D1_POINT_2F p[4];
+    BOOL bezier;
+    UINT32 figure;
+};
+
+struct seg_sink
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    struct seg_item *items;
+    size_t count, size;
+    UINT32 figure_count;
+    D2D1_POINT_2F start, current;
+    HRESULT hr;
+};
+
+static struct seg_sink *seg_from_sink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct seg_sink, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static void seg_add(struct seg_sink *sink, const D2D1_POINT_2F *p, BOOL bezier)
+{
+    struct seg_item *item;
+
+    if (!d2d_array_reserve((void **)&sink->items, &sink->size, sink->count + 1, sizeof(*sink->items)))
+    {
+        sink->hr = E_OUTOFMEMORY;
+        return;
+    }
+    item = &sink->items[sink->count++];
+    item->p[0] = sink->current;
+    if (bezier)
+    {
+        item->p[1] = p[0];
+        item->p[2] = p[1];
+        item->p[3] = p[2];
+    }
+    else
+        item->p[1] = item->p[2] = item->p[3] = p[0];
+    item->bezier = bezier;
+    item->figure = sink->figure_count - 1;
+    sink->current = item->p[3];
+}
+
+static void STDMETHODCALLTYPE seg_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+}
+
+static void STDMETHODCALLTYPE seg_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct seg_sink *sink = seg_from_sink(iface);
+
+    sink->figure_count++;
+    sink->start = sink->current = start;
+}
+
+static void STDMETHODCALLTYPE seg_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        seg_add(seg_from_sink(iface), &points[i], FALSE);
+}
+
+static void STDMETHODCALLTYPE seg_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        seg_add(seg_from_sink(iface), &beziers[i].point1, TRUE);
+}
+
+static void STDMETHODCALLTYPE seg_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct seg_sink *sink = seg_from_sink(iface);
+
+    if (end == D2D1_FIGURE_END_CLOSED && (sink->current.x != sink->start.x || sink->current.y != sink->start.y))
+        seg_add(sink, &sink->start, FALSE);
+}
+
+static const ID2D1SimplifiedGeometrySinkVtbl seg_sink_vtbl =
+{
+    flat_QueryInterface,
+    flat_AddRef,
+    flat_Release,
+    seg_SetFillMode,
+    flat_SetSegmentFlags,
+    seg_BeginFigure,
+    seg_AddLines,
+    seg_AddBeziers,
+    seg_EndFigure,
+    flat_Close,
+};
+
+static D2D1_POINT_2F seg_point(const struct seg_item *item, double t)
+{
+    D2D1_POINT_2F r;
+    double u = 1.0 - t;
+
+    if (!item->bezier)
+    {
+        r.x = item->p[0].x + (item->p[3].x - item->p[0].x) * t;
+        r.y = item->p[0].y + (item->p[3].y - item->p[0].y) * t;
+        return r;
+    }
+    r.x = u * u * u * item->p[0].x + 3 * u * u * t * item->p[1].x + 3 * u * t * t * item->p[2].x + t * t * t * item->p[3].x;
+    r.y = u * u * u * item->p[0].y + 3 * u * u * t * item->p[1].y + 3 * u * t * t * item->p[2].y + t * t * t * item->p[3].y;
+    return r;
+}
+
+/* how many straight pieces approximate the segment within the tolerance */
+static unsigned int seg_pieces(const struct seg_item *item, float tolerance)
+{
+    double dx, dy, d;
+    unsigned int n;
+
+    if (!item->bezier)
+        return 1;
+    /* the second differences bound the distance of the chords from the curve */
+    dx = fabs(item->p[0].x - 2 * item->p[1].x + item->p[2].x) + fabs(item->p[1].x - 2 * item->p[2].x + item->p[3].x);
+    dy = fabs(item->p[0].y - 2 * item->p[1].y + item->p[2].y) + fabs(item->p[1].y - 2 * item->p[2].y + item->p[3].y);
+    d = sqrt(dx * dx + dy * dy);
+    n = (unsigned int)ceil(sqrt(0.75 * d / tolerance));
+    return min(max(n, 1), 1024);
+}
+
+HRESULT d2d_geometry_ops_compute_point_and_segment_at_length(ID2D1Geometry *geometry, float length,
+        UINT32 start_segment, const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_DESCRIPTION *desc)
+{
+    struct seg_sink sink;
+    double left = max(length, 0.0f), before = 0.0;
+    D2D1_POINT_2F a, b, tangent = {1.0f, 0.0f};
+    BOOL found = FALSE, any = FALSE;
+    unsigned int k, n;
+    size_t i;
+    HRESULT hr;
+
+    if (!desc)
+        return E_INVALIDARG;
+    memset(&sink, 0, sizeof(sink));
+    sink.ID2D1SimplifiedGeometrySink_iface.lpVtbl = &seg_sink_vtbl;
+    if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES, transform,
+            fix_tolerance(tolerance), &sink.ID2D1SimplifiedGeometrySink_iface)) || FAILED(hr = sink.hr))
+        goto done;
+    if (!sink.count)
+    {
+        hr = D2DERR_BAD_NUMBER;
+        goto done;
+    }
+    if (start_segment >= sink.count)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    memset(desc, 0, sizeof(*desc));
+    desc->point = sink.items[start_segment].p[0];
+    desc->unitTangentVector = tangent;
+    for (i = start_segment; i < sink.count && !found; ++i)
+    {
+        const struct seg_item *item = &sink.items[i];
+        double seg_len = 0.0;
+
+        n = seg_pieces(item, fix_tolerance(tolerance));
+        /* the segment's length, then where the point falls on it */
+        for (k = 0, a = item->p[0]; k < n; ++k, a = b)
+        {
+            b = seg_point(item, (double)(k + 1) / n);
+            seg_len += sqrt((double)(b.x - a.x) * (b.x - a.x) + (double)(b.y - a.y) * (b.y - a.y));
+        }
+        desc->endSegment = i;
+        desc->endFigure = item->figure;
+        desc->lengthToEndSegment = before;
+        for (k = 0, a = item->p[0]; k < n && !found; ++k, a = b)
+        {
+            double dx, dy, d;
+
+            b = seg_point(item, (double)(k + 1) / n);
+            dx = b.x - a.x;
+            dy = b.y - a.y;
+            if ((d = sqrt(dx * dx + dy * dy)) <= 0.0)
+                continue;
+            any = TRUE;
+            tangent.x = dx / d;
+            tangent.y = dy / d;
+            desc->unitTangentVector = tangent;
+            if (left <= d)
+            {
+                desc->point.x = a.x + dx * (left / d);
+                desc->point.y = a.y + dy * (left / d);
+                found = TRUE;
+            }
+            else
+            {
+                left -= d;
+                desc->point = b;
+            }
+        }
+        before += seg_len;
+    }
+    /* beyond the end: the end point, on the last segment */
+    if (!any)
+        hr = D2DERR_BAD_NUMBER;
+done:
+    free(sink.items);
+    return hr;
+}
+
 HRESULT d2d_geometry_ops_compute_point_at_length(ID2D1Geometry *geometry, float length,
         const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F *point, D2D1_POINT_2F *tangent)
 {
