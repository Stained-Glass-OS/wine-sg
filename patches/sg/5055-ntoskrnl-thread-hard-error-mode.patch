From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl: Keep the thread hard error mode.

IoSetThreadHardErrorMode keeps the mode per thread and "returns TRUE if hard
errors were previously enabled" (enabled at first); it always returned
FALSE. Nothing here raises hard errors, so the mode only answers callers.

Gate: test/ntoskrnl-harderror-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c         | 14 ++++++++++++--
 dlls/ntoskrnl.exe/ntoskrnl_private.h |  1 +
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index f320e55..d54f553 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3642,8 +3642,18 @@ NTSTATUS WINAPI PsSetLoadImageNotifyRoutineEx(PLOAD_IMAGE_NOTIFY_ROUTINE routine
  */
 BOOLEAN WINAPI IoSetThreadHardErrorMode(BOOLEAN EnableHardErrors)
 {
-    FIXME("stub\n");
-    return FALSE;
+    PKTHREAD thread = KeGetCurrentThread();
+    BOOLEAN previous;
+
+    TRACE("%u\n", EnableHardErrors);
+
+    /* "returns TRUE if hard errors were previously enabled": the mode is
+     * kept per thread; nothing here raises hard errors */
+    previous = !thread->hard_errors_disabled;
+#ifndef SG_MUTANT_HARDERROR_NO_STATE
+    thread->hard_errors_disabled = !EnableHardErrors;
+#endif
+    return previous;
 }
 
 /*****************************************************
diff --git a/dlls/ntoskrnl.exe/ntoskrnl_private.h b/dlls/ntoskrnl.exe/ntoskrnl_private.h
index b83f9fa..fde9a89 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl_private.h
+++ b/dlls/ntoskrnl.exe/ntoskrnl_private.h
@@ -65,6 +65,7 @@ struct _KTHREAD
     CLIENT_ID id;
     unsigned int critical_region;
     KAFFINITY user_affinity;
+    BOOLEAN hard_errors_disabled;   /* IoSetThreadHardErrorMode */
 };
 
 struct _ETHREAD
