From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wineps: CFF fonts print, and exclusive clipping (6507)

Text in an OpenType font with CFF outlines (no 'glyf'/'loca') printed
as nothing through the PostScript driver: the glyphs were downloaded
empty. Their outlines are now asked of GDI (the font at one font unit
per pixel, cubic Beziers) and written as the Type 1 charstrings.
CLIP_TO_PATH(CLIP_EXCLUSIVE) clips to everything but the path (an
outside rectangle and the even-odd rule); CLIP_INCLUSIVE follows the
path's fill mode from END_PATH, and END_PATH's RENDERMODE_OPEN/CLOSED
stroke the path.
---
diff --git a/dlls/wineps.drv/escape.c b/dlls/wineps.drv/escape.c
index 33d5c9d..fde0ef9 100644
--- a/dlls/wineps.drv/escape.c
+++ b/dlls/wineps.drv/escape.c
@@ -137,12 +137,22 @@ INT PSDRV_ExtEscape( print_ctx *ctx, INT nEscape, INT cbInput, LPCVOID in_data,
         }
         TRACE("RenderMode = %d, FillMode = %d, BkMode = %d\n",
                 info->RenderMode, info->FillMode, info->BkMode);
+        /* Stained Glass OS (wine-sg 6507): the path is kept for CLIP_TO_PATH, with its fill
+         * mode; RENDERMODE_OPEN strokes it as it is, RENDERMODE_CLOSED closed (the program's
+         * pen is the current one) */
+        ctx->path_fill_mode = info->FillMode;
         switch(info->RenderMode) {
         case RENDERMODE_NO_DISPLAY:
             PSDRV_WriteClosePath(ctx); /* not sure if this is necessary, but it can't hurt */
             break;
-        case RENDERMODE_OPEN:
         case RENDERMODE_CLOSED:
+            PSDRV_WriteClosePath(ctx);
+            /* fall through */
+        case RENDERMODE_OPEN:
+            PSDRV_WriteGSave(ctx);
+            PSDRV_WriteStroke(ctx);
+            PSDRV_WriteGRestore(ctx);
+            break;
         default:
             FIXME("END_PATH: RenderMode %d, not yet supported\n", info->RenderMode);
             break;
@@ -165,13 +175,26 @@ INT PSDRV_ExtEscape( print_ctx *ctx, INT nEscape, INT cbInput, LPCVOID in_data,
             return 1;
         case CLIP_INCLUSIVE:
             TRACE("CLIP_TO_PATH: CLIP_INCLUSIVE\n");
-            /* FIXME to clip or eoclip ? (see PATH_INFO.FillMode) */
-            PSDRV_WriteClip(ctx);
+            /* the path's own fill mode (6507) */
+            if (ctx->path_fill_mode == ALTERNATE) PSDRV_WriteEOClip(ctx);
+            else PSDRV_WriteClip(ctx);
             PSDRV_WriteNewPath(ctx);
             return 1;
         case CLIP_EXCLUSIVE:
-            FIXME("CLIP_EXCLUSIVE: not implemented\n");
+        {
+            /* Stained Glass OS (wine-sg 6507): everything but the path -- a rectangle beyond
+             * any page added to it and the even-odd rule */
+            static const char outside[] = "-1000000 -1000000 moveto 2000000 0 rlineto 0 2000000 rlineto "
+                                          "-2000000 0 rlineto closepath\n";
+            TRACE("CLIP_TO_PATH: CLIP_EXCLUSIVE\n");
+#ifdef SG_MUTANT_PS_CLIP_EXCLUSIVE_NONE
             return 0;
+#endif
+            PSDRV_WriteSpool(ctx, outside, sizeof(outside) - 1);
+            PSDRV_WriteEOClip(ctx);
+            PSDRV_WriteNewPath(ctx);
+            return 1;
+        }
         default:
             FIXME("Unknown CLIP_TO_PATH mode %d\n", mode);
             return 0;
diff --git a/dlls/wineps.drv/psdrv.h b/dlls/wineps.drv/psdrv.h
index 0d61530..05b525a 100644
--- a/dlls/wineps.drv/psdrv.h
+++ b/dlls/wineps.drv/psdrv.h
@@ -403,6 +403,7 @@ typedef struct
     PSDRV_DEVMODE	*Devmode;
     PRINTERINFO		*pi;
     int                 pathdepth;
+    INT                 path_fill_mode;  /* END_PATH's PATH_INFO.FillMode (6507) */
     RECT                bbox;
     struct ps_plugins  *plugins;   /* the maker's render plug-ins (oemps.c) */
 } print_ctx;
diff --git a/dlls/wineps.drv/type1.c b/dlls/wineps.drv/type1.c
index 1e69a51..08ac5be 100644
--- a/dlls/wineps.drv/type1.c
+++ b/dlls/wineps.drv/type1.c
@@ -530,6 +530,105 @@ static inline BOOL on_point(const glyph_outline *outline, WORD pt)
     return outline->flags[pt] & 1;
 }
 
+/* Stained Glass OS (wine-sg 6507): a font whose outlines are CFF (an OpenType "OTTO" font: no
+ * 'glyf'/'loca') had no outline here, and every glyph went to the printer empty: text in
+ * such fonts printed as nothing. Its outline is asked of GDI instead -- the font at a size of
+ * one em to the font unit, the curves as cubic Beziers -- and written as the charstring. */
+static BOOL is_cff_font(HDC hdc)
+{
+#ifdef SG_MUTANT_PS_CFF_EMPTY
+    return FALSE;
+#endif
+    return GetFontData(hdc, MS_MAKE_TAG('l','o','c','a'), 0, NULL, 0) == GDI_ERROR &&
+           GetFontData(hdc, MS_MAKE_TAG('C','F','F',' '), 0, NULL, 0) != GDI_ERROR;
+}
+
+static int fixed_to_int(FIXED f)
+{
+    double v = f.value + f.fract / 65536.0;
+    return v < 0 ? (int)(v - 0.5) : (int)(v + 0.5);
+}
+
+static void cff_charstring(HDC hdc, DWORD index, DWORD emsize, STR *charstring, POINT *curpos)
+{
+    static const MAT2 identity = { {0, 1}, {0, 0}, {0, 0}, {0, 1} };
+    LOGFONTW lf;
+    GLYPHMETRICS gm;
+    HFONT font, old;
+    HDC mem;
+    DWORD size;
+    BYTE *buf, *p, *end;
+
+    if (!GetObjectW(GetCurrentObject(hdc, OBJ_FONT), sizeof(lf), &lf)) return;
+    lf.lfHeight = -(LONG)emsize;
+    lf.lfWidth = 0;
+    lf.lfEscapement = lf.lfOrientation = 0;
+    if (!(mem = CreateCompatibleDC(NULL))) return;
+    if (!(font = CreateFontIndirectW(&lf)))
+    {
+        DeleteDC(mem);
+        return;
+    }
+    old = SelectObject(mem, font);
+    size = GetGlyphOutlineW(mem, index, GGO_GLYPH_INDEX | GGO_BEZIER | GGO_UNHINTED, &gm, 0, NULL, &identity);
+    if (size != GDI_ERROR && size && (buf = HeapAlloc(GetProcessHeap(), 0, size)))
+    {
+        if (GetGlyphOutlineW(mem, index, GGO_GLYPH_INDEX | GGO_BEZIER | GGO_UNHINTED, &gm, size, buf, &identity) != GDI_ERROR)
+        {
+            for (p = buf, end = buf + size; p + sizeof(TTPOLYGONHEADER) <= end; )
+            {
+                TTPOLYGONHEADER *header = (TTPOLYGONHEADER *)p;
+                BYTE *next = p + header->cb, *c;
+                POINT pt;
+
+                if (header->cb < sizeof(*header) || next > end) break;
+                pt.x = fixed_to_int(header->pfxStart.x);
+                pt.y = fixed_to_int(header->pfxStart.y);
+                str_add_point(charstring, pt, curpos);
+                str_add_cmd(charstring, rmoveto);
+                for (c = p + sizeof(*header); c + FIELD_OFFSET(TTPOLYCURVE, apfx) <= next; )
+                {
+                    TTPOLYCURVE *curve = (TTPOLYCURVE *)c;
+                    WORD i;
+
+                    if (c + FIELD_OFFSET(TTPOLYCURVE, apfx[curve->cpfx]) > next) break;
+                    if (curve->wType == TT_PRIM_CSPLINE)
+                    {
+                        for (i = 0; i + 2 < curve->cpfx; i += 3)
+                        {
+                            int k;
+                            for (k = 0; k < 3; k++)
+                            {
+                                pt.x = fixed_to_int(curve->apfx[i + k].x);
+                                pt.y = fixed_to_int(curve->apfx[i + k].y);
+                                str_add_point(charstring, pt, curpos);
+                            }
+                            str_add_cmd(charstring, rrcurveto);
+                        }
+                    }
+                    else
+                    {
+                        for (i = 0; i < curve->cpfx; i++)
+                        {
+                            pt.x = fixed_to_int(curve->apfx[i].x);
+                            pt.y = fixed_to_int(curve->apfx[i].y);
+                            str_add_point(charstring, pt, curpos);
+                            str_add_cmd(charstring, rlineto);
+                        }
+                    }
+                    c += FIELD_OFFSET(TTPOLYCURVE, apfx[curve->cpfx]);
+                }
+                str_add_cmd(charstring, closepath);
+                p = next;
+            }
+        }
+        HeapFree(GetProcessHeap(), 0, buf);
+    }
+    SelectObject(mem, old);
+    DeleteObject(font);
+    DeleteDC(mem);
+}
+
 BOOL T1_download_glyph(print_ctx *ctx, DOWNLOAD *pdl, DWORD index, char *glyph_name)
 {
     DWORD len;
@@ -570,7 +669,7 @@ BOOL T1_download_glyph(print_ctx *ctx, DOWNLOAD *pdl, DWORD index, char *glyph_n
     outline.pts = NULL;
     get_hmetrics(ctx->hdc, index, &outline.lsb, &outline.advance);
 
-    if(!append_glyph_outline(ctx->hdc, index, &outline)) return FALSE;
+    if(!is_cff_font(ctx->hdc) && !append_glyph_outline(ctx->hdc, index, &outline)) return FALSE;
 
     charstring = str_init(100);
     curpos.x = outline.lsb;
@@ -580,6 +679,9 @@ BOOL T1_download_glyph(print_ctx *ctx, DOWNLOAD *pdl, DWORD index, char *glyph_n
     str_add_num(charstring, outline.advance);
     str_add_cmd(charstring, hsbw);
 
+    if (is_cff_font(ctx->hdc))
+        cff_charstring(ctx->hdc, index, t1->emsize, charstring, &curpos);
+
     for(cur_pt = 0, cont = 0; cont < outline.num_conts; cont++)
     {
         POINT start_pos = outline.pts[cur_pt++];
