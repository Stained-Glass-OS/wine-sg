From: Stained Glass OS contributors
Subject: shell32: a folder's right-click menu has New > Folder, Shortcut and Text Document

The background menu of a folder view merged its submenus (View, Arrange
Icons, New) with their own IDs; with the view's idCmdFirst of 0 those IDs
went below zero, wrapped past idCmdLast, and all three submenus were
dropped: right-clicking a folder's empty space offered no way to make a
folder or a file. They are merged without IDs of their own now.

New holds what Windows' does first -- Folder, Shortcut -- and Text Document,
which makes an empty "New Text Document.txt" (numbered when taken) and
selects it for renaming.

Gate: test/newtext-gate.sh (make test-newtext).
---
--- a/dlls/shell32/shell32.rc
+++ b/dlls/shell32/shell32.rc
@@ -65,8 +65,10 @@
 	  MENUITEM SEPARATOR
 	  POPUP "New",                  0x42
 	  BEGIN
-	    MENUITEM "New &Folder",	FCIDM_SHVIEW_NEWFOLDER
-	    MENUITEM "New &Link",	FCIDM_SHVIEW_NEWLINK
+	    MENUITEM "&Folder",	FCIDM_SHVIEW_NEWFOLDER
+	    MENUITEM "&Shortcut",	FCIDM_SHVIEW_NEWLINK
+	    MENUITEM SEPARATOR
+	    MENUITEM "&Text Document",	FCIDM_SHVIEW_NEWTEXT
 	    MENUITEM SEPARATOR
 	  END
 	  MENUITEM SEPARATOR
--- a/dlls/shell32/shresdef.h
+++ b/dlls/shell32/shresdef.h
@@ -117,6 +117,8 @@
 #define IDS_OVERWRITEFOLDER_TEXT    141
 
 #define IDS_NEWFOLDER 142
+/* Stained Glass OS: New > Text Document in a folder's background menu */
+#define FCIDM_SHVIEW_NEWTEXT 0x7054
 
 #define IDS_CPANEL_TITLE            143
 #define IDS_CPANEL_NAME             144
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -1489,8 +1489,12 @@
     }
     else
     {
+        /* Stained Glass OS: the submenus (View, Arrange Icons, New) without
+         * IDs of their own. With the view's idCmdFirst of 0 their IDs
+         * (0x40-0x42) moved below zero, wrapped past idCmdLast and all three
+         * were dropped: the right-click menu had no New at all. */
         Shell_MergeMenus (hMenu, GetSubMenu(hMyMenu,0), indexMenu,
-                          idCmdFirst - FCIDM_BASE, idCmdLast, MM_SUBMENUSHAVEIDS);
+                          idCmdFirst - FCIDM_BASE, idCmdLast, 0);
         idMax = max_menu_id(GetSubMenu(hMyMenu, 0), idCmdFirst - FCIDM_BASE, idCmdLast);
         hr =  MAKE_HRESULT(SEVERITY_SUCCESS, FACILITY_NULL, idMax-idCmdFirst);
     }
@@ -1526,6 +1530,40 @@
     }
 }
 
+/* Stained Glass OS: New > Text Document -- an empty "New Text Document.txt"
+ * (numbered if taken), selected for renaming, as on Windows. */
+static void DoNewTextDocument(ContextMenu *This, IShellView *view)
+{
+    IPersistFolder2 *pf;
+    LPITEMIDLIST folder = NULL, pidl = NULL;
+    WCHAR dir[MAX_PATH], path[MAX_PATH], name[MAX_PATH];
+    HANDLE file = INVALID_HANDLE_VALUE;
+    int i;
+
+    if (FAILED(IShellFolder_QueryInterface(This->parent, &IID_IPersistFolder2, (void **)&pf))) return;
+    IPersistFolder2_GetCurFolder(pf, &folder);
+    IPersistFolder2_Release(pf);
+    if (!folder || !SHGetPathFromIDListW(folder, dir)) { ILFree(folder); return; }
+    ILFree(folder);
+    for (i = 1; i < 1000 && file == INVALID_HANDLE_VALUE; i++)
+    {
+        if (i == 1) lstrcpyW(name, L"New Text Document.txt");
+        else swprintf(name, ARRAY_SIZE(name), L"New Text Document (%d).txt", i);
+        PathCombineW(path, dir, name);
+        file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_EXISTS) return;
+    }
+    if (file == INVALID_HANDLE_VALUE) return;
+    CloseHandle(file);
+    SHChangeNotify(SHCNE_CREATE, SHCNF_PATHW, path, NULL);
+    if (view && SUCCEEDED(IShellFolder_ParseDisplayName(This->parent, NULL, NULL, name, NULL, &pidl, NULL)))
+    {
+        IShellView_Refresh(view);
+        IShellView_SelectItem(view, pidl, SVSI_DESELECTOTHERS | SVSI_EDIT | SVSI_ENSUREVISIBLE | SVSI_FOCUSED | SVSI_SELECT);
+        ILFree(pidl);
+    }
+}
+
 static HRESULT WINAPI BackgroundMenu_InvokeCommand(
 	IContextMenu3 *iface,
 	LPCMINVOKECOMMANDINFO lpcmi)
@@ -1581,6 +1619,10 @@
                 DoNewFolder(This, view);
                 break;
 
+            case FCIDM_SHVIEW_NEWTEXT:
+                DoNewTextDocument(This, view);
+                break;
+
             case FCIDM_SHVIEW_INSERT:
                 do_paste(This, lpcmi->hwnd);
                 break;
