 /***********************************************************************
+ * Private namespaces
+ *
+ * A private namespace is an object directory that only holders of the SIDs
+ * (and at least the integrity level) in its boundary descriptor may create
+ * or open. It is a directory beside the other named objects, called the
+ * alias: "alias\name" then resolves through the ordinary name lookup in
+ * every Create and Open call, so no call needs to know about it. The
+ * boundary is enforced here, against the caller's token, when the
+ * namespace is created or opened.
+ ***********************************************************************/
+
+
+/***********************************************************************
+ *           CreateBoundaryDescriptorW    (kernelbase.@)
+ */
+HANDLE WINAPI CreateBoundaryDescriptorW( const WCHAR *name, ULONG flags )
+{
+    UNICODE_STRING str;
+    void *desc;
+
+    TRACE( "(%s, %#lx)\n", debugstr_w(name), flags );
+
+    if (!name || (flags & ~CREATE_BOUNDARY_DESCRIPTOR_ADD_APPCONTAINER_SID))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    RtlInitUnicodeString( &str, name );
+    if (!(desc = RtlCreateBoundaryDescriptor( &str, flags ))) SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+    return desc;
+}
+
+
+/***********************************************************************
+ *           AddSIDToBoundaryDescriptor    (kernelbase.@)
+ */
+BOOL WINAPI AddSIDToBoundaryDescriptor( HANDLE *desc, PSID sid )
+{
+    TRACE( "(%p, %p)\n", desc, sid );
+    return set_ntstatus( RtlAddSIDToBoundaryDescriptor( (void **)desc, sid ));
+}
+
+
+/***********************************************************************
+ *           AddIntegrityLabelToBoundaryDescriptor    (kernelbase.@)
+ */
+BOOL WINAPI AddIntegrityLabelToBoundaryDescriptor( HANDLE *desc, PSID sid )
+{
+    TRACE( "(%p, %p)\n", desc, sid );
+    return set_ntstatus( RtlAddIntegrityLabelToBoundaryDescriptor( (void **)desc, sid ));
+}
+
+
+/***********************************************************************
+ *           DeleteBoundaryDescriptor    (kernelbase.@)
+ */
+void WINAPI DeleteBoundaryDescriptor( HANDLE desc )
+{
+    TRACE( "(%p)\n", desc );
+    RtlDeleteBoundaryDescriptor( desc );
+}
+
+
+/* whether the calling token (the thread's impersonation token, else the
+ * process's) carries the SID as its user or as an enabled group */
+static BOOL token_has_sid( PSID sid, BOOL *found )
+{
+    HANDLE token;
+    TOKEN_USER *user;
+    TOKEN_GROUPS *groups;
+    DWORD len, i;
+
+    *found = FALSE;
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        !OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+        return FALSE;
+
+    if (!GetTokenInformation( token, TokenUser, NULL, 0, &len ) && GetLastError() == ERROR_INSUFFICIENT_BUFFER &&
+        (user = HeapAlloc( GetProcessHeap(), 0, len )))
+    {
+        if (GetTokenInformation( token, TokenUser, user, len, &len ) && EqualSid( user->User.Sid, sid )) *found = TRUE;
+        HeapFree( GetProcessHeap(), 0, user );
+    }
+    if (!*found && !GetTokenInformation( token, TokenGroups, NULL, 0, &len ) &&
+        GetLastError() == ERROR_INSUFFICIENT_BUFFER && (groups = HeapAlloc( GetProcessHeap(), 0, len )))
+    {
+        if (GetTokenInformation( token, TokenGroups, groups, len, &len ))
+        {
+            for (i = 0; i < groups->GroupCount; i++)
+            {
+                if ((groups->Groups[i].Attributes & (SE_GROUP_ENABLED | SE_GROUP_USE_FOR_DENY_ONLY)) != SE_GROUP_ENABLED)
+                    continue;
+                if (EqualSid( groups->Groups[i].Sid, sid )) { *found = TRUE; break; }
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, groups );
+    }
+    CloseHandle( token );
+    return TRUE;
+}
+
+
+/* checks the block is a well-formed boundary descriptor and that the
+ * calling token belongs to it; returns the Win32 error to fail with */
+static DWORD check_boundary_descriptor( const OBJECT_BOUNDARY_DESCRIPTOR *desc )
+{
+    const OBJECT_BOUNDARY_ENTRY *entry;
+    ULONG i, size;
+    DWORD ret = ERROR_SUCCESS;
+
+    if (!desc || desc->Version != OBJECT_BOUNDARY_DESCRIPTOR_VERSION || desc->TotalSize < sizeof(*desc) ||
+        !desc->Items)
+        return ERROR_INVALID_PARAMETER;
+
+    /* first pass: the layout */
+    entry = (const OBJECT_BOUNDARY_ENTRY *)(desc + 1);
+    for (i = 0, size = sizeof(*desc); i < desc->Items; i++)
+    {
+        if (desc->TotalSize - size < sizeof(*entry) || entry->EntrySize < sizeof(*entry) ||
+            (entry->EntrySize & 7) || entry->EntrySize > desc->TotalSize - size)
+            return ERROR_INVALID_PARAMETER;
+        if (!i && entry->EntryType != OBNS_Name) return ERROR_INVALID_PARAMETER;
+        if (i && entry->EntryType != OBNS_SID && entry->EntryType != OBNS_IL) return ERROR_INVALID_PARAMETER;
+        size += entry->EntrySize;
+        entry = (const OBJECT_BOUNDARY_ENTRY *)((const char *)entry + entry->EntrySize);
+    }
+
+    /* second pass: membership */
+#ifdef SG_MUTANT_NO_BOUNDARY_CHECK
+    return ERROR_SUCCESS;
+#endif
+    entry = (const OBJECT_BOUNDARY_ENTRY *)(desc + 1);
+    for (i = 0; i < desc->Items && !ret; i++)
+    {
+        PSID sid = (PSID)(entry + 1);
+        BOOL member;
+
+        if (entry->EntryType == OBNS_SID)
+        {
+            if (!token_has_sid( sid, &member )) ret = GetLastError();
+            else if (!member) ret = ERROR_ACCESS_DENIED;
+        }
+        else if (entry->EntryType == OBNS_IL)
+        {
+            TOKEN_MANDATORY_LABEL *label;
+            HANDLE token;
+            DWORD len;
+
+            if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+            {
+                if (!GetTokenInformation( token, TokenIntegrityLevel, NULL, 0, &len ) &&
+                    GetLastError() == ERROR_INSUFFICIENT_BUFFER && (label = HeapAlloc( GetProcessHeap(), 0, len )))
+                {
+                    if (GetTokenInformation( token, TokenIntegrityLevel, label, len, &len ))
+                    {
+                        DWORD have = *GetSidSubAuthority( label->Label.Sid, *GetSidSubAuthorityCount( label->Label.Sid ) - 1 );
+                        DWORD need = *GetSidSubAuthority( sid, *GetSidSubAuthorityCount( sid ) - 1 );
+                        if (have < need) ret = ERROR_ACCESS_DENIED;
+                    }
+                    HeapFree( GetProcessHeap(), 0, label );
+                }
+                CloseHandle( token );
+            }
+        }
+        entry = (const OBJECT_BOUNDARY_ENTRY *)((const char *)entry + entry->EntrySize);
+    }
+    return ret;
+}
+
+
+/***********************************************************************
+ *           CreatePrivateNamespaceW    (kernelbase.@)
+ */
+HANDLE WINAPI CreatePrivateNamespaceW( SECURITY_ATTRIBUTES *sa, void *boundary, const WCHAR *alias )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    HANDLE ret;
+    DWORD err;
+
+    TRACE( "(%p, %p, %s)\n", sa, boundary, debugstr_w(alias) );
+
+    if (!alias || !*alias)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if ((err = check_boundary_descriptor( boundary )))
+    {
+        SetLastError( err );
+        return NULL;
+    }
+    get_create_object_attributes( &attr, &str, sa, alias );
+#ifndef SG_MUTANT_NAMESPACE_OPENIF
+    attr.Attributes &= ~OBJ_OPENIF;  /* an existing namespace is an error, not a shared one */
+#endif
+    if (!set_ntstatus( NtCreateDirectoryObject( &ret, DIRECTORY_ALL_ACCESS, &attr ))) return NULL;
+    return ret;
+}
+
+
+/***********************************************************************
+ *           OpenPrivateNamespaceW    (kernelbase.@)
+ */
+HANDLE WINAPI OpenPrivateNamespaceW( void *boundary, const WCHAR *alias )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    HANDLE ret;
+    DWORD err;
+
+    TRACE( "(%p, %s)\n", boundary, debugstr_w(alias) );
+
+    if (!alias || !*alias)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if ((err = check_boundary_descriptor( boundary )))
+    {
+        SetLastError( err );
+        return NULL;
+    }
+    if (!get_open_object_attributes( &attr, &str, FALSE, alias )) return NULL;
+    if (!set_ntstatus( NtOpenDirectoryObject( &ret, DIRECTORY_CREATE_OBJECT | DIRECTORY_TRAVERSE, &attr )))
+        return NULL;
+    return ret;
+}
+
+
+/***********************************************************************
+ *           ClosePrivateNamespace    (kernelbase.@)
+ */
+BOOLEAN WINAPI ClosePrivateNamespace( HANDLE handle, ULONG flags )
+{
+    TRACE( "(%p, %#lx)\n", handle, flags );
+
+    if (flags & ~PRIVATE_NAMESPACE_FLAG_DESTROY)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* a namespace is a plain directory object that goes away with its last
+     * handle once nothing is left in it, which is what _DESTROY asks for */
+    return set_ntstatus( NtClose( handle ));
+}
+
