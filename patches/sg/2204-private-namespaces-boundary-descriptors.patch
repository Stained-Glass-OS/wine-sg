From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, kernelbase, kernel32: boundary descriptors and private namespaces

- RtlCreateBoundaryDescriptor, RtlAddSIDToBoundaryDescriptor,
  RtlAddIntegrityLabelToBoundaryDescriptor, RtlDeleteBoundaryDescriptor and
  the kernel32 wrappers (Create/Add/AddIntegrityLabel/DeleteBoundaryDescriptor,
  A and W): a descriptor is one flat heap block (name entry, SID entries, at
  most one S-1-16-x integrity label); bad flags, a NULL name, a malformed SID
  or a second label are errors.
- CreatePrivateNamespaceA/W, OpenPrivateNamespaceA/W, ClosePrivateNamespace:
  a private namespace is an object directory beside the other named objects,
  called the alias, so "alias\name" resolves through the ordinary name lookup
  in every Create and Open call and no other function needs a hook. The
  boundary is enforced when the namespace is created or opened: every SID
  entry must be the caller's user or an enabled group, and the integrity
  label no higher than the caller's. Creating an existing alias is
  ERROR_ALREADY_EXISTS; the namespace goes away with its last handle.
  Needs no wineserver change.

---
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1636,3 +1636,105 @@
     memcpy(device_form, unknown_form, form_length);
     return STATUS_SUCCESS;
 }
+
+
+/******************************************************************************
+ * Boundary descriptors (private namespaces)
+ *
+ * A boundary descriptor names a private namespace and lists who may enter it
+ * (SIDs, an integrity label). It is one flat heap block, grown in place as
+ * entries are added, and the handle CreateBoundaryDescriptor returns is that
+ * block's address -- nothing here reaches the server; the kernelbase
+ * namespace functions read the block back.
+ */
+
+static OBJECT_BOUNDARY_ENTRY *add_boundary_entry( OBJECT_BOUNDARY_DESCRIPTOR **desc, OBJECT_BOUNDARY_ENTRY_TYPE type,
+                                                  const void *data, ULONG data_len )
+{
+    ULONG entry_size = sizeof(OBJECT_BOUNDARY_ENTRY) + ((data_len + 7) & ~7);
+    OBJECT_BOUNDARY_DESCRIPTOR *new;
+    OBJECT_BOUNDARY_ENTRY *entry;
+
+    if (!(new = RtlReAllocateHeap( GetProcessHeap(), 0, *desc, (*desc)->TotalSize + entry_size ))) return NULL;
+    *desc = new;
+    entry = (OBJECT_BOUNDARY_ENTRY *)((char *)new + new->TotalSize);
+    memset( entry, 0, entry_size );
+    entry->EntryType = type;
+    entry->EntrySize = entry_size;
+    if (data_len) memcpy( entry + 1, data, data_len );
+    new->TotalSize += entry_size;
+    new->Items++;
+    return entry;
+}
+
+/******************************************************************************
+ *  RtlCreateBoundaryDescriptor   [NTDLL.@]
+ */
+void * WINAPI RtlCreateBoundaryDescriptor( const UNICODE_STRING *name, ULONG flags )
+{
+    OBJECT_BOUNDARY_DESCRIPTOR *desc;
+
+    TRACE( "(%s, %#lx)\n", debugstr_us(name), flags );
+
+    if (!name || (flags & ~1u)) return NULL;
+    if (!(desc = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*desc) ))) return NULL;
+    desc->Version = OBJECT_BOUNDARY_DESCRIPTOR_VERSION;
+    desc->TotalSize = sizeof(*desc);
+    desc->Flags = flags;
+    if (!add_boundary_entry( &desc, OBNS_Name, name->Buffer, name->Length ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, desc );
+        return NULL;
+    }
+    return desc;
+}
+
+/******************************************************************************
+ *  RtlAddSIDToBoundaryDescriptor   [NTDLL.@]
+ */
+NTSTATUS WINAPI RtlAddSIDToBoundaryDescriptor( void **desc, PSID sid )
+{
+    TRACE( "(%p, %p)\n", desc, sid );
+
+    if (!desc || !*desc) return STATUS_INVALID_PARAMETER;
+    if (!sid || !RtlValidSid( sid )) return STATUS_INVALID_SID;
+    if (!add_boundary_entry( (OBJECT_BOUNDARY_DESCRIPTOR **)desc, OBNS_SID, sid, RtlLengthSid( sid )))
+        return STATUS_NO_MEMORY;
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ *  RtlAddIntegrityLabelToBoundaryDescriptor   [NTDLL.@]
+ */
+NTSTATUS WINAPI RtlAddIntegrityLabelToBoundaryDescriptor( void **desc, PSID sid )
+{
+    static const SID_IDENTIFIER_AUTHORITY label_authority = {SECURITY_MANDATORY_LABEL_AUTHORITY};
+    OBJECT_BOUNDARY_DESCRIPTOR *header;
+    OBJECT_BOUNDARY_ENTRY *entry;
+    ULONG i;
+
+    TRACE( "(%p, %p)\n", desc, sid );
+
+    if (!desc || !*desc) return STATUS_INVALID_PARAMETER;
+    if (!sid || !RtlValidSid( sid )) return STATUS_INVALID_SID;
+    /* only a mandatory label SID (S-1-16-x), and only one of them */
+    if (*RtlSubAuthorityCountSid( sid ) != 1 ||
+        memcmp( RtlIdentifierAuthoritySid( sid ), &label_authority, sizeof(label_authority) ))
+        return STATUS_INVALID_PARAMETER;
+    header = *desc;
+    entry = (OBJECT_BOUNDARY_ENTRY *)(header + 1);
+    for (i = 0; i < header->Items; i++, entry = (OBJECT_BOUNDARY_ENTRY *)((char *)entry + entry->EntrySize))
+        if (entry->EntryType == OBNS_IL) return STATUS_INVALID_PARAMETER;
+    if (!add_boundary_entry( (OBJECT_BOUNDARY_DESCRIPTOR **)desc, OBNS_IL, sid, RtlLengthSid( sid )))
+        return STATUS_NO_MEMORY;
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ *  RtlDeleteBoundaryDescriptor   [NTDLL.@]
+ */
+void WINAPI RtlDeleteBoundaryDescriptor( void *desc )
+{
+    TRACE( "(%p)\n", desc );
+    RtlFreeHeap( GetProcessHeap(), 0, desc );
+}
