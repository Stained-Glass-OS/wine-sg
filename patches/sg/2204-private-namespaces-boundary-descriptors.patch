+/* a boundary descriptor (private namespaces) is one flat block: this header,
+ * then Items entries, each an OBJECT_BOUNDARY_ENTRY followed by its data and
+ * padded to 8 bytes (EntrySize covers all of it) */
+#define OBJECT_BOUNDARY_DESCRIPTOR_VERSION 1
+typedef struct _OBJECT_BOUNDARY_DESCRIPTOR
+{
+    ULONG Version;
+    ULONG Items;
+    ULONG TotalSize;
+    ULONG Flags;
+} OBJECT_BOUNDARY_DESCRIPTOR, *POBJECT_BOUNDARY_DESCRIPTOR;
+
+typedef enum _OBJECT_BOUNDARY_ENTRY_TYPE
+{
+    OBNS_Invalid,
+    OBNS_Name,
+    OBNS_SID,
+    OBNS_IL,
+} OBJECT_BOUNDARY_ENTRY_TYPE;
+
+typedef struct _OBJECT_BOUNDARY_ENTRY
+{
+    OBJECT_BOUNDARY_ENTRY_TYPE EntryType;
+    ULONG EntrySize;
+} OBJECT_BOUNDARY_ENTRY, *POBJECT_BOUNDARY_ENTRY;
 
