From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: a printer's security descriptor (SE_PRINTER).

GetSecurityInfo of an SE_PRINTER handle failed with ERROR_CALL_NOT_IMPLEMENTED, GetNamedSecurityInfo
by printer name returned success with nothing, and SetSecurityInfo/SetNamedSecurityInfo reported
success without setting anything. They now read and write the spooler's descriptor, PRINTER_INFO_3
(GetPrinterW/SetPrinterW level 3, winspool loaded on first use as advapi32 does not link to it);
the parts a Set does not name are kept from the printer's current descriptor. Who may change a
printer's descriptor is the spooler's and its registry key's to decide, as before.
---
diff --git a/dlls/advapi32/security.c b/dlls/advapi32/security.c
index f09e23f..88517d4 100644
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -2007,6 +2007,104 @@ BOOL WINAPI PrivilegedServiceAuditAlarmA( LPCSTR SubsystemName, LPCSTR ServiceNa
 #define HKEY_SPECIAL_ROOT_FIRST   HKEY_CLASSES_ROOT
 #define HKEY_SPECIAL_ROOT_LAST    HKEY_DYN_DATA
 
+/* Stained Glass OS: a printer's security descriptor is the spooler's (PRINTER_INFO_3); winspool is
+ * loaded when a printer is asked for, as advapi32 does not link to it */
+typedef struct { void *pDatatype; void *pDevMode; ACCESS_MASK DesiredAccess; } sg_printer_defaults;
+static BOOL (WINAPI *pOpenPrinterW)( WCHAR *, HANDLE *, sg_printer_defaults * );
+static BOOL (WINAPI *pClosePrinter)( HANDLE );
+static BOOL (WINAPI *pGetPrinterW)( HANDLE, DWORD, BYTE *, DWORD, DWORD * );
+static BOOL (WINAPI *pSetPrinterW)( HANDLE, DWORD, BYTE *, DWORD );
+
+static BOOL load_winspool( void )
+{
+    static HMODULE module;
+    if (!module && !(module = LoadLibraryW( L"winspool.drv" ))) return FALSE;
+    pOpenPrinterW = (void *)GetProcAddress( module, "OpenPrinterW" );
+    pClosePrinter = (void *)GetProcAddress( module, "ClosePrinter" );
+    pGetPrinterW = (void *)GetProcAddress( module, "GetPrinterW" );
+    pSetPrinterW = (void *)GetProcAddress( module, "SetPrinterW" );
+    return pOpenPrinterW && pClosePrinter && pGetPrinterW && pSetPrinterW;
+}
+
+/* the printer's descriptor, LocalAlloc'd, self relative */
+static DWORD get_printer_sd( HANDLE printer, PSECURITY_DESCRIPTOR *ret )
+{
+    DWORD size = 0, len;
+    BYTE *buf;
+    PSECURITY_DESCRIPTOR sd;
+
+    if (!load_winspool()) return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!pGetPrinterW( printer, 3, NULL, 0, &size ) && GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+        return GetLastError();
+    if (!(buf = malloc( size ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!pGetPrinterW( printer, 3, buf, size, &size ))
+    {
+        free( buf );
+        return GetLastError();
+    }
+    sd = ((PSECURITY_DESCRIPTOR *)buf)[0];   /* PRINTER_INFO_3.pSecurityDescriptor */
+    if (!sd || !IsValidSecurityDescriptor( sd ))
+    {
+        free( buf );
+        return ERROR_INVALID_SECURITY_DESCR;
+    }
+    len = GetSecurityDescriptorLength( sd );
+    if (!(*ret = LocalAlloc( 0, len )))
+    {
+        free( buf );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    memcpy( *ret, sd, len );
+    free( buf );
+    return ERROR_SUCCESS;
+}
+
+/* the parts the caller sets replace the printer's; the others are kept */
+static DWORD set_printer_sd( HANDLE printer, SECURITY_INFORMATION info, PSECURITY_DESCRIPTOR parts )
+{
+    PSECURITY_DESCRIPTOR cur, rel = NULL;
+    SECURITY_DESCRIPTOR merged;
+    PSID owner = NULL, group = NULL;
+    PACL dacl = NULL, sacl = NULL;
+    BOOL present = FALSE, defaulted;
+    DWORD err, len = 0;
+    PSECURITY_DESCRIPTOR from;
+
+    if ((err = get_printer_sd( printer, &cur ))) return err;
+    InitializeSecurityDescriptor( &merged, SECURITY_DESCRIPTOR_REVISION );
+    from = (info & OWNER_SECURITY_INFORMATION) ? parts : cur;
+    GetSecurityDescriptorOwner( from, &owner, &defaulted );
+    SetSecurityDescriptorOwner( &merged, owner, FALSE );
+    from = (info & GROUP_SECURITY_INFORMATION) ? parts : cur;
+    GetSecurityDescriptorGroup( from, &group, &defaulted );
+    SetSecurityDescriptorGroup( &merged, group, FALSE );
+    from = (info & DACL_SECURITY_INFORMATION) ? parts : cur;
+    present = FALSE;
+    GetSecurityDescriptorDacl( from, &present, &dacl, &defaulted );
+    SetSecurityDescriptorDacl( &merged, present, dacl, FALSE );
+    from = (info & SACL_SECURITY_INFORMATION) ? parts : cur;
+    present = FALSE;
+    GetSecurityDescriptorSacl( from, &present, &sacl, &defaulted );
+    SetSecurityDescriptorSacl( &merged, present, sacl, FALSE );
+
+    MakeSelfRelativeSD( &merged, NULL, &len );
+    if (!len || !(rel = malloc( len ))) err = ERROR_NOT_ENOUGH_MEMORY;
+    else if (!MakeSelfRelativeSD( &merged, rel, &len )) err = GetLastError();
+    else if (!pSetPrinterW( printer, 3, (BYTE *)&rel, 0 )) err = GetLastError();
+    free( rel );
+    LocalFree( cur );
+    return err;
+}
+
+static DWORD open_printer( const WCHAR *name, ACCESS_MASK access, HANDLE *printer )
+{
+    sg_printer_defaults defaults = { NULL, NULL, access };
+
+    if (!load_winspool()) return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!pOpenPrinterW( (WCHAR *)name, printer, &defaults )) return GetLastError();
+    return ERROR_SUCCESS;
+}
+
 /******************************************************************************
  * GetSecurityInfo [ADVAPI32.@]
  *
@@ -2125,6 +2223,15 @@ DWORD WINAPI GetSecurityInfo( HANDLE handle, SE_OBJECT_TYPE type, SECURITY_INFOR
         RegCloseKey( key );
         break;
 
+#ifndef SG_MUTANT_PRINTER_SD
+    case SE_PRINTER:
+    {
+        DWORD err;
+        if ((err = get_printer_sd( handle, &sd ))) return err;
+        break;
+    }
+#endif
+
     default:
         FIXME("unimplemented type %u\n", type);
         return ERROR_CALL_NOT_IMPLEMENTED;
@@ -3101,6 +3208,15 @@ DWORD WINAPI SetNamedSecurityInfoW(LPWSTR pObjectName,
             CloseHandle( handle );
         }
         break;
+#ifndef SG_MUTANT_PRINTER_SD
+    case SE_PRINTER:
+        if (!(err = open_printer( pObjectName, access | READ_CONTROL, &handle )))
+        {
+            err = SetSecurityInfo( handle, ObjectType, SecurityInfo, psidOwner, psidGroup, pDacl, pSacl );
+            pClosePrinter( handle );
+        }
+        break;
+#endif
     default:
         FIXME( "Object type %d is not currently supported.\n", ObjectType );
         return ERROR_SUCCESS;
@@ -3614,6 +3730,15 @@ DWORD WINAPI GetNamedSecurityInfoW( const WCHAR *name, SE_OBJECT_TYPE type,
             CloseHandle( handle );
         }
         break;
+#ifndef SG_MUTANT_PRINTER_SD
+    case SE_PRINTER:
+        if (!(err = open_printer( name, access, &handle )))
+        {
+            err = GetSecurityInfo( handle, type, info, owner, group, dacl, sacl, descriptor );
+            pClosePrinter( handle );
+        }
+        break;
+#endif
     default:
         FIXME( "Object type %d is not currently supported.\n", type );
         if (owner) *owner = NULL;
@@ -4107,6 +4232,15 @@ DWORD WINAPI SetSecurityInfo(HANDLE handle, SE_OBJECT_TYPE ObjectType,
         }
         break;
 
+#ifndef SG_MUTANT_PRINTER_SD
+    case SE_PRINTER:
+    {
+        DWORD err = set_printer_sd( handle, SecurityInfo, &sd );
+        if (dacl != pDacl) free(dacl);
+        return err;
+    }
+#endif
+
     default:
         FIXME("unimplemented type %u, returning success\n", ObjectType);
         status = STATUS_SUCCESS;
