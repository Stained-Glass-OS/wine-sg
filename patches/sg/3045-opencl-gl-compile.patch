From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 14:08:01 -0700
Subject: [PATCH] opencl: GL sharing entry points, program compile and link,
 extension lookup

- clCreateFromGL* return CL_INVALID_CONTEXT in errcode_ret and the GL object calls return CL_INVALID_GL_OBJECT,
  because contexts are never created with GL sharing
- clCompileProgram and clLinkProgram call the driver (synchronously, the notify callback is not called)
- extension function lookup returns NULL without logging a FIXME

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/opencl/pe_wrappers.c b/dlls/opencl/pe_wrappers.c
index 3b68460..42b772b 100644
--- a/dlls/opencl/pe_wrappers.c
+++ b/dlls/opencl/pe_wrappers.c
@@ -176,11 +176,7 @@ void * WINAPI clGetExtensionFunctionAddress( const char *func_name )
 {
     void * ret = 0;
     TRACE("(%s)\n",func_name);
-#if 0
-    ret = clGetExtensionFunctionAddress(func_name);
-#else
-    FIXME("extensions not implemented\n");
-#endif
+    /* no extension function is made available to applications */
     TRACE("(%s)=%p\n",func_name, ret);
     return ret;
 }
@@ -196,14 +192,16 @@ cl_int WINAPI clSetCommandQueueProperty( cl_command_queue command_queue, cl_comm
 
 void * WINAPI clGetExtensionFunctionAddressForPlatform( cl_platform_id platform, const char *func_name )
 {
-    FIXME( "(%p, %s) stub!\n", platform, debugstr_a(func_name) );
+    TRACE( "(%p, %s): no extension functions\n", platform, debugstr_a(func_name) );
     return NULL;
 }
 
 
 cl_mem WINAPI clCreateFromGLBuffer( cl_context *context, cl_mem_flags flags, GLuint bufobj, int *errcode_ret )
 {
-    FIXME( "(%p, %s, %u, %p) stub!\n", context, wine_dbgstr_longlong(flags), bufobj, errcode_ret );
+    /* contexts are never created with GL sharing */
+    TRACE( "(%p, %s, %u, %p)\n", context, wine_dbgstr_longlong(flags), bufobj, errcode_ret );
+    if (errcode_ret) *errcode_ret = CL_INVALID_CONTEXT;
     return NULL;
 }
 
@@ -211,7 +209,9 @@ cl_mem WINAPI clCreateFromGLBuffer( cl_context *context, cl_mem_flags flags, GLu
 cl_mem WINAPI clCreateFromGLRenderbuffer( cl_context *context,
         cl_mem_flags flags, GLuint renderbuffer, int *errcode_ret )
 {
-    FIXME( "(%p, %s, %u, %p) stub!\n", context, wine_dbgstr_longlong(flags), renderbuffer, errcode_ret );
+    /* contexts are never created with GL sharing */
+    TRACE( "(%p, %s, %u, %p)\n", context, wine_dbgstr_longlong(flags), renderbuffer, errcode_ret );
+    if (errcode_ret) *errcode_ret = CL_INVALID_CONTEXT;
     return NULL;
 }
 
@@ -219,8 +219,10 @@ cl_mem WINAPI clCreateFromGLRenderbuffer( cl_context *context,
 cl_mem WINAPI clCreateFromGLTexture( cl_context *context, cl_mem_flags flags,
         GLenum target, GLint miplevel, GLuint texture, cl_int *errcode_ret )
 {
-    FIXME( "(%p, %s, %u, %d, %u, %p) stub!\n",
+    /* contexts are never created with GL sharing */
+    TRACE( "(%p, %s, %u, %d, %u, %p) \n",
             context, wine_dbgstr_longlong(flags), target, miplevel, texture, errcode_ret );
+    if (errcode_ret) *errcode_ret = CL_INVALID_CONTEXT;
     return NULL;
 }
 
@@ -228,8 +230,10 @@ cl_mem WINAPI clCreateFromGLTexture( cl_context *context, cl_mem_flags flags,
 cl_mem WINAPI clCreateFromGLTexture2D( cl_context *context, cl_mem_flags flags,
         GLenum target, GLint miplevel, GLuint texture, cl_int *errcode_ret )
 {
-    FIXME( "(%p, %s, %u, %d, %u, %p) stub!\n",
+    /* contexts are never created with GL sharing */
+    TRACE( "(%p, %s, %u, %d, %u, %p) \n",
             context, wine_dbgstr_longlong(flags), target, miplevel, texture, errcode_ret );
+    if (errcode_ret) *errcode_ret = CL_INVALID_CONTEXT;
     return NULL;
 }
 
@@ -237,8 +241,10 @@ cl_mem WINAPI clCreateFromGLTexture2D( cl_context *context, cl_mem_flags flags,
 cl_mem WINAPI clCreateFromGLTexture3D( cl_context *context, cl_mem_flags flags,
         GLenum target, GLint miplevel, GLuint texture, cl_int *errcode_ret )
 {
-    FIXME( "(%p, %s, %u, %d, %u, %p) stub!\n",
+    /* contexts are never created with GL sharing */
+    TRACE( "(%p, %s, %u, %d, %u, %p) \n",
             context, wine_dbgstr_longlong(flags), target, miplevel, texture, errcode_ret );
+    if (errcode_ret) *errcode_ret = CL_INVALID_CONTEXT;
     return NULL;
 }
 
@@ -246,34 +252,36 @@ cl_mem WINAPI clCreateFromGLTexture3D( cl_context *context, cl_mem_flags flags,
 cl_int WINAPI clEnqueueAcquireGLObjects( cl_command_queue queue, cl_uint num_objects, const cl_mem *mem_objects,
         cl_uint num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
 {
-    FIXME( "(%p, %u, %p, %u, %p, %p) stub!\n",
+    /* no memory object is shared with GL */
+    TRACE( "(%p, %u, %p, %u, %p, %p) \n",
             queue, num_objects, mem_objects, num_events_in_wait_list, event_wait_list, event );
-    return CL_INVALID_DEVICE;
+    return CL_INVALID_GL_OBJECT;
 }
 
 
 cl_int WINAPI clEnqueueReleaseGLObjects( cl_command_queue queue, cl_uint num_objects, const cl_mem *mem_objects,
         cl_uint num_events_in_wait_list, const cl_event *event_wait_list, cl_event *event )
 {
-    FIXME( "(%p, %u, %p, %u, %p, %p) stub!\n",
+    /* no memory object is shared with GL */
+    TRACE( "(%p, %u, %p, %u, %p, %p) \n",
             queue, num_objects, mem_objects, num_events_in_wait_list, event_wait_list, event );
-    return CL_INVALID_DEVICE;
+    return CL_INVALID_GL_OBJECT;
 }
 
 
 cl_int WINAPI clGetGLObjectInfo( cl_mem memobj, cl_gl_object_type *gl_object_type, GLuint *gl_object_name )
 {
-    FIXME( "(%p, %p, %p) stub!\n", memobj, gl_object_type, gl_object_name );
-    return CL_INVALID_DEVICE;
+    TRACE( "(%p, %p, %p) \n", memobj, gl_object_type, gl_object_name );
+    return CL_INVALID_GL_OBJECT;
 }
 
 
 cl_int WINAPI clGetGLTextureInfo( cl_mem memobj, cl_gl_texture_info param_name,
         size_t param_value_size, void *param_value, size_t param_value_size_ret )
 {
-    FIXME( "(%p, %#x, %Iu, %p, %Iu) stub!\n",
+    TRACE( "(%p, %#x, %Iu, %p, %Iu) \n",
             memobj, param_name, param_value_size, param_value, param_value_size_ret );
-    return CL_INVALID_DEVICE;
+    return CL_INVALID_GL_OBJECT;
 }
 
 
diff --git a/dlls/opencl/unix_wrappers.c b/dlls/opencl/unix_wrappers.c
index 5967979..15ce8c3 100644
--- a/dlls/opencl/unix_wrappers.c
+++ b/dlls/opencl/unix_wrappers.c
@@ -57,34 +57,42 @@ NTSTATUS wrap_clCreateContextFromType( void *args )
 
 NTSTATUS wrap_clEnqueueNativeKernel( void *args )
 {
-    /* we have no clear way to wrap user_func */
-    FIXME( "not implemented\n" );
+    /* native kernels are PE code the driver cannot run; CL_EXEC_NATIVE_KERNEL is hidden
+     * from the device capabilities, so the device does not support them */
+    TRACE( "native kernels are not supported\n" );
     return CL_INVALID_OPERATION;
 }
 
 NTSTATUS wrap_clSetEventCallback( void *args )
 {
-    FIXME( "not yet implemented\n" );
+    WARN( "event callbacks cannot call back into the application\n" );
     return CL_INVALID_OPERATION;
 }
 
 NTSTATUS wrap_clSetMemObjectDestructorCallback( void *args )
 {
-    FIXME( "not yet implemented\n" );
+    WARN( "destructor callbacks cannot call back into the application\n" );
     return CL_INVALID_OPERATION;
 }
 
 NTSTATUS wrap_clCompileProgram( void *args )
 {
-    FIXME( "not yet implemented\n" );
-    return CL_INVALID_OPERATION;
+    struct clCompileProgram_params *params = args;
+
+    /* the compilation is synchronous, the callback of the caller is not called */
+    if (params->pfn_notify) WARN( "notify callback not supported\n" );
+    return clCompileProgram( params->program, params->num_devices, params->device_list,
+                             params->options, params->num_input_headers, params->input_headers,
+                             params->header_include_names, NULL, NULL );
 }
 
 NTSTATUS wrap_clLinkProgram( void *args )
 {
     struct clLinkProgram_params *params = args;
 
-    FIXME( "not yet implemented\n" );
-    *params->errcode_ret = CL_INVALID_OPERATION;
+    if (params->pfn_notify) WARN( "notify callback not supported\n" );
+    *params->__retval = clLinkProgram( params->context, params->num_devices, params->device_list,
+                                       params->options, params->num_input_programs,
+                                       params->input_programs, NULL, NULL, params->errcode_ret );
     return STATUS_SUCCESS;
 }
