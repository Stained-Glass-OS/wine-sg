From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] userenv, d3dx9_36/tests: fixes for the build with conformance tests (5914)

Two errors of the build with conformance tests (the release build has
--disable-tests and does not see them):
- userenv: CreateAppContainerProfile (fast-b 3710) takes PSID * as the
  prototype in include/userenv.h does (drafter 7's 5512 test needs it).
- d3dx9_36 tests: fast-b's test_sg_fragments calls D3DXGatherFragments and
  D3DXCreateFragmentLinker, which the d3dx9 import library (d3dx9_43) does
  not export (the fragment linker is gone from d3dx9_42 on); it is built for
  D3DX_SDK_VERSION <= 41 like Wine's own test_fragment_linker.

Integration patch (integ-2026-10).
---
diff --git a/dlls/d3dx9_36/tests/shader.c b/dlls/d3dx9_36/tests/shader.c
--- a/dlls/d3dx9_36/tests/shader.c
+++ b/dlls/d3dx9_36/tests/shader.c
@@ -6788,6 +6788,8 @@ static void test_shader_semantics(void)
     }
 }
 
+#if D3DX_SDK_VERSION <= 41
+/* the fragment linker is gone from d3dx9_42 on: like test_fragment_linker, only for older SDKs */
 static void test_sg_fragments(IDirect3DDevice9 *device)
 {
     static const char fragments_source[] =
@@ -6993,6 +6995,7 @@ static void test_sg_fragments_device(void)
     IDirect3D9_Release(d3d);
     DestroyWindow(window);
 }
+#endif
 
 #if D3DX_SDK_VERSION <= 41
 
@@ -7121,7 +7124,7 @@ START_TEST(shader)
     test_shader_semantics();
 #if D3DX_SDK_VERSION <= 41
     test_fragment_linker();
-#endif
     test_sg_fragments_device();
+#endif
     test_hlsl_double();
 }
diff --git a/dlls/userenv/userenv_main.c b/dlls/userenv/userenv_main.c
--- a/dlls/userenv/userenv_main.c
+++ b/dlls/userenv/userenv_main.c
@@ -1364,7 +1364,7 @@ static void delete_tree( const WCHAR *dir )
 
 HRESULT WINAPI CreateAppContainerProfile(PCWSTR container_name, PCWSTR display_name, PCWSTR description,
                                          SID_AND_ATTRIBUTES *capabilities, DWORD capability_count,
-                                         SID **container_sid)
+                                         PSID *container_sid)
 {
     static const WCHAR *subdirs[] = { L"AC", L"AC\\INetCache", L"AC\\INetCookies", L"AC\\INetHistory", L"AC\\Temp" };
     WCHAR key_name[MAX_PATH], dir[MAX_PATH], sub[MAX_PATH], *sid_str = NULL, *user_str = NULL, *caps = NULL, *p;
