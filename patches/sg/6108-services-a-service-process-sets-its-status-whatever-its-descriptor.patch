From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] services: a service's own process sets its status whatever the service's descriptor says

CCleaner 7 gives its service a security descriptor that grants SERVICE_SET_STATUS to nobody. Windows does not check it when the service's process reports its status; Wine's dispatcher opens the service for SERVICE_SET_STATUS and was refused, so the service never reported running (StartService: 1053). services.exe lets the service's own process (the RPC caller's pid) have that right; rpcrt4's ncacn_np reports the caller's pid as ncalrpc does.
---
diff --git a/dlls/rpcrt4/rpc_transport.c b/dlls/rpcrt4/rpc_transport.c
index c428e96..fc6f0c0 100644
--- a/dlls/rpcrt4/rpc_transport.c
+++ b/dlls/rpcrt4/rpc_transport.c
@@ -3155,7 +3155,9 @@ static const struct connection_ops conn_protseq_list[] = {
     rpcrt4_conn_np_impersonate_client,
     rpcrt4_conn_np_revert_to_self,
     RPCRT4_default_inquire_auth_client,
-    NULL
+    /* Stained Glass OS: a local pipe knows its client's process (the
+       service manager tells a service's own process by it) */
+    rpcrt4_ncalrpc_inquire_client_pid
   },
   { "ncalrpc",
     { EPM_PROTOCOL_NCALRPC, EPM_PROTOCOL_PIPE },
diff --git a/programs/services/rpc.c b/programs/services/rpc.c
index 6ed6711..5d4c157 100644
--- a/programs/services/rpc.c
+++ b/programs/services/rpc.c
@@ -628,6 +628,25 @@ static DWORD create_handle_for_service(struct service_entry *entry, DWORD dwDesi
     return ERROR_SUCCESS;
 }
 
+/* Stained Glass OS: a service's own process reports its status (the
+ * dispatcher opens it for SERVICE_SET_STATUS, what a status handle is here).
+ * Windows does not check the service's security descriptor for that: a
+ * service whose descriptor grants SERVICE_SET_STATUS to nobody (CCleaner 7's:
+ * SYSTEM, Administrators, Interactive, Service, none of them that right) never
+ * got to say it was running, and its start failed with 1053. */
+static BOOL is_own_status_handle(struct service_entry *entry, DWORD access)
+{
+    ULONG pid = 0;
+
+#ifdef SG_MUTANT_SET_STATUS_BY_SD
+    return FALSE;
+#endif
+    if (access != SERVICE_SET_STATUS || !entry->process) return FALSE;
+    if (I_RpcBindingInqLocalClientPID(NULL, &pid) != RPC_S_OK) return FALSE;
+    WINE_TRACE("caller %lu, service process %lu\n", pid, entry->process->process_id);
+    return pid == entry->process->process_id;
+}
+
 DWORD __cdecl svcctl_OpenServiceW(
     SC_RPC_HANDLE hSCManager,
     LPCWSTR lpServiceName,
@@ -653,7 +672,8 @@ DWORD __cdecl svcctl_OpenServiceW(
         return ERROR_SERVICE_DOES_NOT_EXIST;
 
     service_lock(entry);
-    err = check_caller_access(service_sd(entry), &g_svc_generic, &dwDesiredAccess);
+    if (is_own_status_handle(entry, dwDesiredAccess)) err = ERROR_SUCCESS;
+    else err = check_caller_access(service_sd(entry), &g_svc_generic, &dwDesiredAccess);
     service_unlock(entry);
     if (err != ERROR_SUCCESS)
     {
