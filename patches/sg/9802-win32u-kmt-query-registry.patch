From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: D3DKMTQueryAdapterInfo KMTQAITYPE_QUERYREGISTRY

The adapter's registry values (ADAPTERKEY: its Control\Class driver key; SERVICEKEY: its service's key), with the BUFFER_OVERFLOW size protocol, the type check, TranslatePath and STATUS_FAIL for a missing value, as the Khronos Vulkan loader Chromium bundles asks for VulkanDriverName. It was not supported (a FIXME ~60 times in each of 7 Electron programs). DRIVERSTOREPATH/DRIVERIMAGEPATH answer STATUS_FAIL: Wine's drivers are in no driver store.
---
--- a/include/ddk/d3dkmthk.h
+++ b/include/ddk/d3dkmthk.h
@@ -259,6 +259,56 @@
     KMTQAITYPE_WDDM_3_1_CAPS
 } KMTQUERYADAPTERINFOTYPE;
 
+/* the private data of KMTQAITYPE_QUERYREGISTRY (d3dukmdt.h) */
+typedef enum _D3DDDI_QUERYREGISTRY_TYPE
+{
+    D3DDDI_QUERYREGISTRY_SERVICEKEY      = 0,
+    D3DDDI_QUERYREGISTRY_ADAPTERKEY      = 1,
+    D3DDDI_QUERYREGISTRY_DRIVERSTOREPATH = 2,
+    D3DDDI_QUERYREGISTRY_DRIVERIMAGEPATH = 3,
+    D3DDDI_QUERYREGISTRY_MAX,
+} D3DDDI_QUERYREGISTRY_TYPE;
+
+typedef enum _D3DDDI_QUERYREGISTRY_STATUS
+{
+    D3DDDI_QUERYREGISTRY_STATUS_SUCCESS         = 0,
+    D3DDDI_QUERYREGISTRY_STATUS_BUFFER_OVERFLOW = 1,
+    D3DDDI_QUERYREGISTRY_STATUS_FAIL            = 2,
+    D3DDDI_QUERYREGISTRY_STATUS_MAX,
+} D3DDDI_QUERYREGISTRY_STATUS;
+
+typedef struct _D3DDDI_QUERYREGISTRY_FLAGS
+{
+    union
+    {
+        struct
+        {
+            UINT TranslatePath : 1;
+            UINT MutableValue  : 1;
+            UINT Reserved      : 30;
+        } DUMMYSTRUCTNAME;
+        UINT Value;
+    } DUMMYUNIONNAME;
+} D3DDDI_QUERYREGISTRY_FLAGS;
+
+typedef struct _D3DDDI_QUERYREGISTRY_INFO
+{
+    D3DDDI_QUERYREGISTRY_TYPE   QueryType;
+    D3DDDI_QUERYREGISTRY_FLAGS  QueryFlags;
+    WCHAR                       ValueName[MAX_PATH];
+    ULONG                       ValueType;
+    ULONG                       PhysicalAdapterIndex;
+    ULONG                       OutputValueSize;
+    D3DDDI_QUERYREGISTRY_STATUS Status;
+    union
+    {
+        DWORD  OutputDword;
+        UINT64 OutputQword;
+        WCHAR  OutputString[1];
+        BYTE   OutputBinary[1];
+    } DUMMYUNIONNAME;
+} D3DDDI_QUERYREGISTRY_INFO;
+
 typedef struct _D3DKMT_QUERYADAPTERINFO
 {
     D3DKMT_HANDLE           hAdapter;
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -494,6 +494,194 @@
     return STATUS_SUCCESS;
 }
 
+/* Stained Glass OS (wine-sg 9802): KMTQAITYPE_QUERYREGISTRY, a value of the adapter's registry keys, as
+ * user-mode drivers and the Khronos Vulkan loader read them: ADAPTERKEY is the adapter's driver key
+ * (Control\Class\{4d36e968-...}\NNNN, where the loader looks for VulkanDriverName/VulkanDriverNameWow),
+ * SERVICEKEY the key of the service its device names (Services\<Service>). A value of another type than
+ * asked fails the call (the loader then asks again for REG_SZ); a missing value or key answers
+ * D3DDDI_QUERYREGISTRY_STATUS_FAIL; a value larger than the room after the header answers
+ * D3DDDI_QUERYREGISTRY_STATUS_BUFFER_OVERFLOW with OutputValueSize, the size to ask again with.
+ * TranslatePath turns a leading \SystemRoot\ of a string value into the Windows directory. Wine's display
+ * drivers live in no driver store, so DRIVERSTOREPATH and DRIVERIMAGEPATH have nothing to answer. */
+static const char display_class_keyA[] =
+    "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Class\\{4d36e968-e325-11ce-bfc1-08002be10318}";
+
+static KEY_VALUE_PARTIAL_INFORMATION *query_value_alloc( HKEY key, const WCHAR *name )
+{
+    UNICODE_STRING str;
+    KEY_VALUE_PARTIAL_INFORMATION *info = NULL;
+    ULONG size = 256;
+    NTSTATUS status;
+
+    RtlInitUnicodeString( &str, name );
+    for (;;)
+    {
+        free( info );
+        if (!(info = malloc( size ))) return NULL;
+        status = NtQueryValueKey( key, &str, KeyValuePartialInformation, info, size, &size );
+        if (!status) return info;
+        if (status != STATUS_BUFFER_OVERFLOW && status != STATUS_BUFFER_TOO_SMALL) break;
+    }
+    free( info );
+    return NULL;
+}
+
+/* the Windows directory without a terminator, as \SystemRoot\ names it */
+static UINT system_root( WCHAR *root, UINT count )
+{
+    static const char keyA[] = "\\Registry\\Machine\\Software\\Microsoft\\Windows NT\\CurrentVersion";
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UINT len = 0;
+    HKEY key;
+
+    if ((key = reg_open_ascii_key( NULL, keyA )))
+    {
+        static const WCHAR system_rootW[] = {'S','y','s','t','e','m','R','o','o','t',0};
+        if ((info = query_value_alloc( key, system_rootW )) && info->Type == REG_SZ)
+        {
+            len = info->DataLength / sizeof(WCHAR);
+            while (len && !((WCHAR *)info->Data)[len - 1]) len--;
+            if (len > count) len = 0;
+            memcpy( root, info->Data, len * sizeof(WCHAR) );
+        }
+        free( info );
+        NtClose( key );
+    }
+    if (!len)
+    {
+        static const WCHAR windows[] = {'C',':','\\','w','i','n','d','o','w','s'};
+        len = ARRAY_SIZE(windows);
+        memcpy( root, windows, sizeof(windows) );
+    }
+    return len;
+}
+
+/* string data with each string's leading \SystemRoot\ replaced; the new data's size in bytes */
+static WCHAR *translate_paths( const WCHAR *data, UINT bytes, BOOL multi, UINT *out_bytes )
+{
+    static const WCHAR prefix[] = {'\\','S','y','s','t','e','m','R','o','o','t','\\'};
+    UINT count = bytes / sizeof(WCHAR), strings = 1, i, root_len, out = 0;
+    WCHAR root[MAX_PATH], *ret;
+
+    for (i = 0; i < count; i++) if (!data[i]) strings++;
+    root_len = system_root( root, ARRAY_SIZE(root) );
+    if (!(ret = malloc( (count + strings * root_len + 1) * sizeof(WCHAR) ))) return NULL;
+    i = 0;
+    while (i < count)
+    {
+        UINT end = i;
+        while (end < count && data[end]) end++;
+        if (end - i >= ARRAY_SIZE(prefix) && !wcsnicmp( data + i, prefix, ARRAY_SIZE(prefix) ))
+        {
+            memcpy( ret + out, root, root_len * sizeof(WCHAR) );
+            out += root_len;
+            i += ARRAY_SIZE(prefix) - 1;   /* keep the backslash after the root */
+        }
+        memcpy( ret + out, data + i, (end - i) * sizeof(WCHAR) );
+        out += end - i;
+        if (end < count) ret[out++] = 0;
+        i = end + 1;
+        if (!multi) break;
+    }
+    if (!multi && count && !data[count - 1] && (!out || ret[out - 1])) ret[out++] = 0;
+    *out_bytes = out * sizeof(WCHAR);
+    return ret;
+}
+
+static NTSTATUS query_registry( const LUID *luid, D3DDDI_QUERYREGISTRY_INFO *info, UINT size )
+{
+    const UINT header = offsetof( D3DDDI_QUERYREGISTRY_INFO, OutputDword );
+    KEY_VALUE_PARTIAL_INFORMATION *value = NULL;
+    char path[MAX_PATH + 160], enum_path[MAX_PATH];
+    WCHAR name[MAX_PATH], *translated = NULL;
+    const void *data;
+    UINT index, bytes;
+    HKEY key = 0;
+
+    info->Status = D3DDDI_QUERYREGISTRY_STATUS_FAIL;
+    if (info->QueryType >= D3DDDI_QUERYREGISTRY_MAX || info->PhysicalAdapterIndex) return STATUS_INVALID_PARAMETER;
+    if (!get_gpu_keys_from_luid( luid, &index, enum_path, sizeof(enum_path) )) return STATUS_SUCCESS;
+
+    memcpy( name, info->ValueName, sizeof(name) );
+    name[MAX_PATH - 1] = 0;
+
+    switch (info->QueryType)
+    {
+    case D3DDDI_QUERYREGISTRY_ADAPTERKEY:
+        snprintf( path, sizeof(path), "%s\\%04X", display_class_keyA, index );
+        key = reg_open_ascii_key( NULL, path );
+        break;
+    case D3DDDI_QUERYREGISTRY_SERVICEKEY:
+    {
+        static const WCHAR serviceW[] = {'S','e','r','v','i','c','e',0};
+        HKEY device;
+        snprintf( path, sizeof(path), "\\Registry\\Machine\\System\\CurrentControlSet\\Enum\\%s", enum_path );
+        if (strlen( path ) >= MAX_PATH || !(device = reg_open_ascii_key( NULL, path ))) break;
+        if ((value = query_value_alloc( device, serviceW )) && value->Type == REG_SZ &&
+            value->DataLength > sizeof(WCHAR) && value->DataLength < 200 * sizeof(WCHAR))
+        {
+            static const WCHAR servicesW[] = {'\\','R','e','g','i','s','t','r','y','\\','M','a','c','h','i','n','e',
+                '\\','S','y','s','t','e','m','\\','C','u','r','r','e','n','t','C','o','n','t','r','o','l','S','e','t',
+                '\\','S','e','r','v','i','c','e','s','\\'};
+            WCHAR full[ARRAY_SIZE(servicesW) + 200];
+            UINT len = value->DataLength / sizeof(WCHAR);
+            memcpy( full, servicesW, sizeof(servicesW) );
+            memcpy( full + ARRAY_SIZE(servicesW), value->Data, len * sizeof(WCHAR) );
+            len += ARRAY_SIZE(servicesW);
+            while (len && !full[len - 1]) len--;
+            key = reg_open_key( NULL, full, len * sizeof(WCHAR) );
+        }
+        free( value );
+        value = NULL;
+        NtClose( device );
+        break;
+    }
+    default:
+        FIXME( "query type %u: no driver store path for Wine's display drivers\n", info->QueryType );
+        return STATUS_SUCCESS;
+    }
+    if (!key)
+    {
+        TRACE( "type %u: no key for adapter %04X\n", info->QueryType, index );
+        return STATUS_SUCCESS;
+    }
+
+    value = query_value_alloc( key, name );
+    NtClose( key );
+    if (!value)
+    {
+        TRACE( "type %u: no value %s\n", info->QueryType, debugstr_w(name) );
+        return STATUS_SUCCESS;
+    }
+#ifndef SG_MUTANT_QUERYREGISTRY_ANY_TYPE
+    if (value->Type != info->ValueType)
+    {
+        TRACE( "%s is type %u, not %u\n", debugstr_w(name), (int)value->Type, (int)info->ValueType );
+        free( value );
+        return STATUS_INVALID_PARAMETER;
+    }
+#endif
+    data = value->Data;
+    bytes = value->DataLength;
+    if (info->QueryFlags.TranslatePath &&
+        (value->Type == REG_SZ || value->Type == REG_EXPAND_SZ || value->Type == REG_MULTI_SZ) &&
+        (translated = translate_paths( (const WCHAR *)value->Data, value->DataLength, value->Type == REG_MULTI_SZ, &bytes )))
+        data = translated;
+
+    info->OutputValueSize = bytes;
+    if (bytes > size - header)
+        info->Status = D3DDDI_QUERYREGISTRY_STATUS_BUFFER_OVERFLOW;
+    else
+    {
+        memcpy( info->OutputBinary, data, bytes );
+        info->Status = D3DDDI_QUERYREGISTRY_STATUS_SUCCESS;
+    }
+    TRACE( "type %u %s: %u bytes, status %u\n", info->QueryType, debugstr_w(name), bytes, info->Status );
+    free( translated );
+    free( value );
+    return STATUS_SUCCESS;
+}
+
 /******************************************************************************
  *           NtGdiDdDDIQueryAdapterInfo    (win32u.@)
  */
@@ -514,6 +702,7 @@
     case KMTQAITYPE_PHYSICALADAPTERCOUNT: size = sizeof(UINT); break;
     case KMTQAITYPE_GETSEGMENTSIZE:      size = sizeof(struct kmt_segment_size_info); break;
     case KMTQAITYPE_CURRENTDISPLAYMODE:  size = sizeof(struct kmt_current_display_mode); break;
+    case KMTQAITYPE_QUERYREGISTRY:       size = sizeof(D3DDDI_QUERYREGISTRY_INFO); break;
     default:
         FIXME( "desc %p, type %d not supported\n", desc, desc->Type );
         return STATUS_NOT_IMPLEMENTED;
@@ -580,6 +769,9 @@
     case KMTQAITYPE_CURRENTDISPLAYMODE:
         status = query_current_display_mode( &adapter->luid, desc->pPrivateDriverData );
         break;
+    case KMTQAITYPE_QUERYREGISTRY:
+        status = query_registry( &adapter->luid, desc->pPrivateDriverData, desc->PrivateDriverDataSize );
+        break;
     default:
         break;
     }
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -8216,6 +8216,29 @@
     return status;
 }
 
+/* Stained Glass OS: the GPU with this LUID: its driver key's index (Control\Class\{display}\NNNN)
+ * and its device key's path under Enum (D3DKMTQueryAdapterInfo's KMTQAITYPE_QUERYREGISTRY) */
+BOOL get_gpu_keys_from_luid( const LUID *luid, UINT *index, char *enum_path, size_t size )
+{
+    BOOL found = FALSE;
+    struct gpu *gpu;
+
+    if (!lock_display_devices( FALSE )) return FALSE;
+
+    LIST_FOR_EACH_ENTRY( gpu, &gpus, struct gpu, entry )
+    {
+        if ((found = !memcmp( &gpu->luid, luid, sizeof(*luid) )))
+        {
+            *index = gpu->index;
+            snprintf( enum_path, size, "%s", gpu->path );
+            break;
+        }
+    }
+
+    unlock_display_devices();
+    return found;
+}
+
 /* Find the Vulkan device UUID corresponding to a LUID */
 BOOL get_vulkan_uuid_from_luid( const LUID *luid, GUID *uuid )
 {
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -246,6 +246,7 @@
 extern BOOL get_vulkan_gpus( struct list *gpus );
 extern void free_vulkan_gpu( struct vulkan_gpu *gpu );
 extern BOOL get_vulkan_uuid_from_luid( const LUID *luid, GUID *uuid );
+extern BOOL get_gpu_keys_from_luid( const LUID *luid, UINT *index, char *enum_path, size_t size );
 
 /* winstation.c */
 
