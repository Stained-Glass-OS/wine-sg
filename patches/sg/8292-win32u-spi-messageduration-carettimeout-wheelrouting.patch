From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: SystemParametersInfo message duration, caret timeout and wheel routing

SPI_GET/SETMESSAGEDURATION, SPI_GET/SETCARETTIMEOUT and SPI_GET/SETMOUSEWHEELROUTING were unknown actions (Qt programs and Firefox ask at start; windows.ui's UISettings.MessageDuration reads the first). They are kept as Control Panel\Accessibility MessageDuration (seconds, 5 by default), Control Panel\Desktop CaretTimeout (ms, 5000) and MouseWheelRouting; the routing is MOUSEWHEEL_ROUTING_MOUSE_POS by default, which is what Wine does: wheel messages go to the window under the pointer.
---
--- a/include/winuser.h
+++ b/include/winuser.h
@@ -2503,10 +2503,16 @@
 #define SPI_SETFOCUSBORDERHEIGHT       0x2011
 #define SPI_GETFONTSMOOTHINGORIENTATION 0x2012
 #define SPI_SETFONTSMOOTHINGORIENTATION 0x2013
+#define SPI_GETMINIMUMHITRADIUS        0x2014
+#define SPI_SETMINIMUMHITRADIUS        0x2015
+#define SPI_GETMESSAGEDURATION         0x2016
+#define SPI_SETMESSAGEDURATION         0x2017
 #define SPI_GETCONTACTVISUALIZATION    0x2018
 #define SPI_SETCONTACTVISUALIZATION    0x2019
 #define SPI_GETGESTUREVISUALIZATION    0x201A
 #define SPI_SETGESTUREVISUALIZATION    0x201B
+#define SPI_GETMOUSEWHEELROUTING       0x201C
+#define SPI_SETMOUSEWHEELROUTING       0x201D
 #define SPI_GETPENVISUALIZATION        0x201E
 #define SPI_SETPENVISUALIZATION        0x201F
 #define SPI_GETPENARBITRATIONTYPE      0x2020
@@ -2516,6 +2522,11 @@
 #define SPI_GETHANDEDNESS              0x2024
 #define SPI_SETHANDEDNESS              0x2025
 
+/* SPI_GETMOUSEWHEELROUTING */
+#define MOUSEWHEEL_ROUTING_FOCUS       0
+#define MOUSEWHEEL_ROUTING_HYBRID      1
+#define MOUSEWHEEL_ROUTING_MOUSE_POS   2
+
 #define FE_FONTSMOOTHINGSTANDARD       0x0001
 #define FE_FONTSMOOTHINGCLEARTYPE      0x0002
 #define FE_FONTSMOOTHINGDOCKING        0x8000
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -194,6 +194,7 @@
     SOUNDSENTRY_KEY,
     SERIALKEYS_KEY,
     HIGHCONTRAST_KEY,
+    ACCESSIBILITY_KEY,
     NB_PARAM_KEYS
 };
 
@@ -218,6 +219,7 @@
     "Control Panel\\Accessibility\\SoundSentry",
     "Control Panel\\Accessibility\\SerialKeys",
     "Control Panel\\Accessibility\\HighContrast",
+    "Control Panel\\Accessibility",
 };
 
 /* System parameters storage */
@@ -5587,6 +5589,11 @@
 static DWORD_ENTRY( FOREGROUNDLOCKTIMEOUT, 0, DESKTOP_KEY, "ForegroundLockTimeout" );
 static DWORD_ENTRY( LOGPIXELS, 0, DESKTOP_KEY, "LogPixels" );
 static DWORD_ENTRY( MOUSECLICKLOCKTIME, 1200, DESKTOP_KEY, "ClickLockTime" );
+/* (wine-sg 8292) how long notifications stay (seconds), the caret blinks before it stops (ms), where
+ * the wheel goes: Wine sends wheel messages to the window under the pointer */
+static DWORD_ENTRY( MESSAGEDURATION, 5, ACCESSIBILITY_KEY, "MessageDuration" );
+static DWORD_ENTRY( CARETTIMEOUT, 5000, DESKTOP_KEY, "CaretTimeout" );
+static DWORD_ENTRY( MOUSEWHEELROUTING, MOUSEWHEEL_ROUTING_MOUSE_POS, DESKTOP_KEY, "MouseWheelRouting" );
 static DWORD_ENTRY( AUDIODESC_LOCALE, 0, AUDIODESC_KEY, "Locale" );
 
 static WCHAR desk_pattern_path[MAX_PATH];
@@ -6993,6 +7000,31 @@
     case SPI_SETFONTSMOOTHINGORIENTATION:
         ret = set_entry( &entry_FONTSMOOTHINGORIENTATION, val, ptr, winini );
         break;
+#ifndef SG_MUTANT_NO_NEW_SPI
+    case SPI_GETMESSAGEDURATION:
+        ret = get_entry( &entry_MESSAGEDURATION, val, ptr );
+        break;
+    case SPI_SETMESSAGEDURATION:
+        ret = set_entry( &entry_MESSAGEDURATION, val, ptr, winini );
+        break;
+    case SPI_GETCARETTIMEOUT:
+        ret = get_entry( &entry_CARETTIMEOUT, val, ptr );
+        break;
+    case SPI_SETCARETTIMEOUT:
+        ret = set_entry( &entry_CARETTIMEOUT, val, ptr, winini );
+        break;
+    case SPI_GETMOUSEWHEELROUTING:
+        ret = get_entry( &entry_MOUSEWHEELROUTING, val, ptr );
+        break;
+    case SPI_SETMOUSEWHEELROUTING:
+        if (PtrToUlong( ptr ) > MOUSEWHEEL_ROUTING_MOUSE_POS)
+        {
+            RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+            ret = FALSE;
+        }
+        else ret = set_entry( &entry_MOUSEWHEELROUTING, val, ptr, winini );
+        break;
+#endif
     case SPI_GETAUDIODESCRIPTION:
     {
         AUDIODESCRIPTION *audio = ptr;
