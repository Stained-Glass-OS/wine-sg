From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: ECDSA verify accepts a 64-byte hash

bcrypt: BCryptVerifySignature with an ECDSA key accepts a 64-byte hash, as
BCryptSignHash already does, so a signature made over a SHA-512 sized hash
can be verified.
---
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -2362,6 +2362,9 @@ static NTSTATUS key_asymmetric_verify( void *args )
         case 20: hash_alg = GNUTLS_DIG_SHA1; break;
         case 32: hash_alg = GNUTLS_DIG_SHA256; break;
         case 48: hash_alg = GNUTLS_DIG_SHA384; break;
+#ifndef SG_MUTANT_BCRYPT_ECDSA_SHA512
+        case 64: hash_alg = GNUTLS_DIG_SHA512; break; /* signing accepts it, so verifying must */
+#endif
 
         default:
             FIXME( "hash size %u not yet supported\n", params->hash_len );
--- a/dlls/bcrypt/tests/bcrypt.c
+++ b/dlls/bcrypt/tests/bcrypt.c
@@ -3536,6 +3536,21 @@ static void test_BCryptSignHash(void)
     ret = BCryptVerifySignature(key, NULL, hash, sizeof(hash), sig, len, 0);
     ok(!ret, "got %#lx\n", ret);
 
+    /* a 64 byte (SHA-512 sized) hash signs and verifies */
+    {
+        UCHAR hash64[64];
+        memset(hash64, 0x5a, sizeof(hash64));
+        len = 0;
+        ret = BCryptSignHash(key, NULL, hash64, sizeof(hash64), sig, sizeof(sig), &len, 0);
+        ok(!ret, "got %#lx\n", ret);
+        ok(len == 64, "got %lu\n", len);
+        ret = BCryptVerifySignature(key, NULL, hash64, sizeof(hash64), sig, len, 0);
+        ok(!ret, "got %#lx\n", ret);
+        hash64[0] ^= 1;
+        ret = BCryptVerifySignature(key, NULL, hash64, sizeof(hash64), sig, len, 0);
+        ok(ret == STATUS_INVALID_SIGNATURE, "got %#lx\n", ret);
+    }
+
     /* mismatch info (SHA-1 != SHA-256) */
     ret  = BCryptSignHash(key, &pad, hash_sha256, sizeof(hash_sha256), sig, sizeof(sig), &len, BCRYPT_PAD_PKCS1);
     ok (ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
