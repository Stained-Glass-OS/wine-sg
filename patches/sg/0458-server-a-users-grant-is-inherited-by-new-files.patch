From: Stained Glass OS contributors
Subject: server: what is made in a folder granted to the users is theirs too

0456 put a folder granted to the machine's users in their group and made
it setgid, so what is made in it later is the group's -- but not writable
by it: the maker's umask decided that. Steam, started by its installer as
an administrator (umask 022), made package\ 0755, and Steam run by a user
found it not writable again. A folder granted to the users now gets a
default ACL (group rwx) as well -- Windows' inherited ACE as the file system
has it -- and so does each folder under it.

Gate: test/usersacl-gate.sh (make test-usersacl).
---
--- a/server/file.c
+++ b/server/file.c
@@ -30,6 +30,7 @@
 #include <sys/stat.h>
 #include <grp.h>
 #include <ftw.h>
+#include <sys/xattr.h>
 #include <sys/time.h>
 #include <sys/types.h>
 #include <time.h>
@@ -457,11 +458,36 @@
 
 static gid_t sg_tree_gid;
 
+/* A directory's default ACL (system.posix_acl_default): what is made in it
+ * gets the users' group's rights whatever its maker's umask -- Windows'
+ * inherited ACE, as the file system has it. Setgid alone passed on the group,
+ * not the right to write: Steam run as an administrator made package\ 0755,
+ * and Steam run by a user again found it not writable. */
+static void sg_default_acl( int fd, const char *path )
+{
+    struct { unsigned short tag, perm; unsigned int id; } __attribute__((packed)) e[3] = {
+        { 0x01, 7, ~0u },   /* ACL_USER_OBJ rwx */
+        { 0x04, 7, ~0u },   /* ACL_GROUP_OBJ rwx */
+        { 0x20, 5, ~0u },   /* ACL_OTHER r-x */
+    };
+    unsigned char buf[4 + sizeof(e)];
+    unsigned int version = 2;   /* POSIX_ACL_XATTR_VERSION */
+
+    memcpy( buf, &version, 4 );
+    memcpy( buf + 4, e, sizeof(e) );
+    if (fd != -1) fsetxattr( fd, "system.posix_acl_default", buf, sizeof(buf), 0 );
+    else setxattr( path, "system.posix_acl_default", buf, sizeof(buf), 0 );
+}
+
 static int sg_users_tree( const char *path, const struct stat *st, int type, struct FTW *ftw )
 {
     if (type == FTW_SL || st->st_uid != getuid()) return 0;
     if (st->st_gid != sg_tree_gid && lchown( path, -1, sg_tree_gid ) == -1) return 0;
-    if (type == FTW_D) chmod( path, (st->st_mode & 07777) | S_ISGID | S_IRGRP | S_IWGRP | S_IXGRP );
+    if (type == FTW_D)
+    {
+        chmod( path, (st->st_mode & 07777) | S_ISGID | S_IRGRP | S_IWGRP | S_IXGRP );
+        sg_default_acl( -1, path );
+    }
     else if (type == FTW_F) chmod( path, (st->st_mode & 07777) | S_IRGRP | S_IWGRP );
     return 0;
 }
@@ -491,6 +517,7 @@
         ssize_t len;
 
         fchmod( unix_fd, (st->st_mode & 07777) | S_ISGID | S_IWGRP | S_IRGRP | S_IXGRP );
+        sg_default_acl( unix_fd, NULL );
         /* what is in it already gets the grant too, as SetNamedSecurityInfo
          * passes an inheritable grant on (an installer sets it after
          * unpacking) -- what this account owns, not through links */
