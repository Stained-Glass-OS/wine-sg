index 13f10e7..39b6b28 100644
--- a/dlls/wiaservc/wiadevmgr.c
+++ b/dlls/wiaservc/wiadevmgr.c
@@ -26,6 +26,7 @@
 #include "wiaservc_private.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wia);
 
@@ -256,30 +257,186 @@ static HRESULT WINAPI wiadevmgr_GetImageDlg(IWiaDevMgr *iface, HWND hwndParent,
                                             BSTR bstrFilename, GUID *pguidFormat)
 {
     wiadevmgr *This = impl_from_IWiaDevMgr(iface);
-    FIXME("(%p, %p, %ld, 0x%lx, %ld, %p, %s, %s): stub\n", This, hwndParent, lDeviceType, lFlags,
+    TRACE("(%p, %p, %ld, 0x%lx, %ld, %p, %s, %s)\n", This, hwndParent, lDeviceType, lFlags,
         lIntent, pItemRoot, debugstr_w(bstrFilename), debugstr_guid(pguidFormat));
-    return E_NOTIMPL;
+    /* the acquisition dialog needs a device, and none is registered */
+    return WIA_S_NO_DEVICE_AVAILABLE;
 }
 
-static HRESULT WINAPI wiadevmgr_RegisterEventCallbackProgram(IWiaDevMgr *iface, LONG lFlags, BSTR bstrDeviceID,
-                                                             const GUID *pEventGUID, BSTR bstrCommandline,
-                                                             BSTR bstrName, BSTR bstrDescription, BSTR bstrIcon)
+#define WIA_REGISTER_EVENT_CALLBACK   0x01
+#define WIA_UNREGISTER_EVENT_CALLBACK 0x02
+#define WIA_SET_DEFAULT_HANDLER       0x04
+
+/* Callbacks registered through an interface live as long as the registration
+ * object returned to the caller; no event ever fires without a device. */
+struct event_registration
 {
-    wiadevmgr *This = impl_from_IWiaDevMgr(iface);
-    FIXME("(%p, 0x%lx, %s, %s, %s, %s, %s, %s): stub\n", This, lFlags, debugstr_w(bstrDeviceID),
-        debugstr_guid(pEventGUID), debugstr_w(bstrCommandline), debugstr_w(bstrName),
-        debugstr_w(bstrDescription), debugstr_w(bstrIcon));
-    return E_NOTIMPL;
+    IUnknown IUnknown_iface;
+    LONG ref;
+    struct list entry;
+    GUID event;
+    WCHAR *device;
+    IWiaEventCallback *callback;
+};
+
+static struct list event_registrations = LIST_INIT(event_registrations);
+static CRITICAL_SECTION event_registrations_cs;
+static CRITICAL_SECTION_DEBUG event_registrations_cs_debug =
+{
+    0, 0, &event_registrations_cs,
+    { &event_registrations_cs_debug.ProcessLocksList, &event_registrations_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": event_registrations_cs") }
+};
+static CRITICAL_SECTION event_registrations_cs = { &event_registrations_cs_debug, -1, 0, 0, 0, 0 };
+
+static inline struct event_registration *impl_from_event_registration(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct event_registration, IUnknown_iface);
 }
 
+static HRESULT WINAPI event_registration_QueryInterface(IUnknown *iface, REFIID riid, void **out)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IUnknown_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI event_registration_AddRef(IUnknown *iface)
+{
+    return InterlockedIncrement(&impl_from_event_registration(iface)->ref);
+}
+
+static ULONG WINAPI event_registration_Release(IUnknown *iface)
+{
+    struct event_registration *reg = impl_from_event_registration(iface);
+    ULONG ref = InterlockedDecrement(&reg->ref);
+
+    if (!ref)
+    {
+        EnterCriticalSection(&event_registrations_cs);
+        list_remove(&reg->entry);
+        LeaveCriticalSection(&event_registrations_cs);
+        IWiaEventCallback_Release(reg->callback);
+        free(reg->device);
+        free(reg);
+    }
+    return ref;
+}
+
+static const IUnknownVtbl event_registration_vtbl =
+{
+    event_registration_QueryInterface,
+    event_registration_AddRef,
+    event_registration_Release,
+};
+
 static HRESULT WINAPI wiadevmgr_RegisterEventCallbackInterface(IWiaDevMgr *iface, LONG lFlags, BSTR bstrDeviceID,
                                                                const GUID *pEventGUID, IWiaEventCallback *pIWiaEventCallback,
                                                                IUnknown **pEventObject)
 {
     wiadevmgr *This = impl_from_IWiaDevMgr(iface);
-    FIXME("(%p, 0x%lx, %s, %s, %p, %p): stub\n", This, lFlags, debugstr_w(bstrDeviceID),
+    struct event_registration *reg;
+
+    TRACE("(%p, 0x%lx, %s, %s, %p, %p)\n", This, lFlags, debugstr_w(bstrDeviceID),
         debugstr_guid(pEventGUID), pIWiaEventCallback, pEventObject);
-    return E_NOTIMPL;
+
+    if (!pEventObject) return E_POINTER;
+    *pEventObject = NULL;
+    if (!pEventGUID || !pIWiaEventCallback) return E_POINTER;
+    /* an interface callback can only be registered, and it is not a default handler */
+    if (lFlags != WIA_REGISTER_EVENT_CALLBACK) return E_INVALIDARG;
+    if (!(reg = calloc(1, sizeof(*reg)))) return E_OUTOFMEMORY;
+    reg->IUnknown_iface.lpVtbl = &event_registration_vtbl;
+    reg->ref = 1;
+    reg->event = *pEventGUID;
+    if (bstrDeviceID && !(reg->device = wcsdup(bstrDeviceID)))
+    {
+        free(reg);
+        return E_OUTOFMEMORY;
+    }
+    IWiaEventCallback_AddRef(reg->callback = pIWiaEventCallback);
+    EnterCriticalSection(&event_registrations_cs);
+    list_add_tail(&event_registrations, &reg->entry);
+    LeaveCriticalSection(&event_registrations_cs);
+    *pEventObject = &reg->IUnknown_iface;
+    return S_OK;
+}
+
+static const WCHAR events_key[] = L"System\\CurrentControlSet\\Control\\StillImage\\Events";
+
+/* Program and CLSID handlers are kept in the registry, per device and event, so they
+ * outlive the process; registering needs write access to HKLM (administrators). */
+static HRESULT register_persistent_handler(LONG flags, const WCHAR *device, const GUID *event,
+        const WCHAR *handler, const WCHAR *name, const WCHAR *desc, const WCHAR *icon,
+        const WCHAR *command, const GUID *clsid)
+{
+    WCHAR path[512], guid[40];
+    HKEY key;
+    LONG res;
+
+    if (!event) return E_POINTER;
+    if (!(flags & (WIA_REGISTER_EVENT_CALLBACK | WIA_UNREGISTER_EVENT_CALLBACK | WIA_SET_DEFAULT_HANDLER))
+            || (flags & ~(WIA_REGISTER_EVENT_CALLBACK | WIA_UNREGISTER_EVENT_CALLBACK | WIA_SET_DEFAULT_HANDLER))
+            || ((flags & WIA_REGISTER_EVENT_CALLBACK) && (flags & WIA_UNREGISTER_EVENT_CALLBACK)))
+        return E_INVALIDARG;
+    swprintf(guid, ARRAY_SIZE(guid), L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", event->Data1,
+            event->Data2, event->Data3, event->Data4[0], event->Data4[1], event->Data4[2], event->Data4[3],
+            event->Data4[4], event->Data4[5], event->Data4[6], event->Data4[7]);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s\\%s\\%s", events_key,
+            device && *device && wcsicmp(device, L"All") ? device : L"STIDeviceEvents", guid, handler);
+
+    if (flags & WIA_UNREGISTER_EVENT_CALLBACK)
+    {
+#ifndef SG_MUTANT_WIA_UNREG
+        res = RegDeleteTreeW(HKEY_LOCAL_MACHINE, path);
+#else
+        res = 0;
+#endif
+        if (res == ERROR_FILE_NOT_FOUND) return S_FALSE;
+        return HRESULT_FROM_WIN32(res);
+    }
+    if ((res = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL)))
+        return HRESULT_FROM_WIN32(res);
+    if (name) RegSetValueExW(key, L"Name", 0, REG_SZ, (const BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR));
+    if (desc) RegSetValueExW(key, L"Desc", 0, REG_SZ, (const BYTE *)desc, (wcslen(desc) + 1) * sizeof(WCHAR));
+    if (icon) RegSetValueExW(key, L"Icon", 0, REG_SZ, (const BYTE *)icon, (wcslen(icon) + 1) * sizeof(WCHAR));
+    if (command)
+        RegSetValueExW(key, L"CommandLine", 0, REG_SZ, (const BYTE *)command, (wcslen(command) + 1) * sizeof(WCHAR));
+    if (clsid)
+    {
+        WCHAR str[40];
+        swprintf(str, ARRAY_SIZE(str), L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", clsid->Data1,
+                clsid->Data2, clsid->Data3, clsid->Data4[0], clsid->Data4[1], clsid->Data4[2], clsid->Data4[3],
+                clsid->Data4[4], clsid->Data4[5], clsid->Data4[6], clsid->Data4[7]);
+        RegSetValueExW(key, L"CLSID", 0, REG_SZ, (const BYTE *)str, (wcslen(str) + 1) * sizeof(WCHAR));
+    }
+    if (flags & WIA_SET_DEFAULT_HANDLER)
+    {
+        DWORD one = 1;
+        RegSetValueExW(key, L"Default", 0, REG_DWORD, (const BYTE *)&one, sizeof(one));
+    }
+    RegCloseKey(key);
+    return S_OK;
+}
+
+static HRESULT WINAPI wiadevmgr_RegisterEventCallbackProgram(IWiaDevMgr *iface, LONG lFlags, BSTR bstrDeviceID,
+                                                             const GUID *pEventGUID, BSTR bstrCommandline,
+                                                             BSTR bstrName, BSTR bstrDescription, BSTR bstrIcon)
+{
+    wiadevmgr *This = impl_from_IWiaDevMgr(iface);
+
+    TRACE("(%p, 0x%lx, %s, %s, %s, %s, %s, %s)\n", This, lFlags, debugstr_w(bstrDeviceID),
+        debugstr_guid(pEventGUID), debugstr_w(bstrCommandline), debugstr_w(bstrName),
+        debugstr_w(bstrDescription), debugstr_w(bstrIcon));
+
+    if (!bstrCommandline || !bstrName) return E_POINTER;
+    return register_persistent_handler(lFlags, bstrDeviceID, pEventGUID, bstrName, bstrName, bstrDescription,
+            bstrIcon, bstrCommandline, NULL);
 }
 
 static HRESULT WINAPI wiadevmgr_RegisterEventCallbackCLSID(IWiaDevMgr *iface, LONG lFlags, BSTR bstrDeviceID,
@@ -287,10 +444,18 @@ static HRESULT WINAPI wiadevmgr_RegisterEventCallbackCLSID(IWiaDevMgr *iface, LO
                                                            BSTR bstrDescription, BSTR bstrIcon)
 {
     wiadevmgr *This = impl_from_IWiaDevMgr(iface);
-    FIXME("(%p, 0x%lx, %s, %s, %s, %s, %s, %s): stub\n", This, lFlags, debugstr_w(bstrDeviceID),
+    WCHAR handler[40];
+
+    TRACE("(%p, 0x%lx, %s, %s, %s, %s, %s, %s)\n", This, lFlags, debugstr_w(bstrDeviceID),
         debugstr_guid(pEventGUID), debugstr_guid(pClsID), debugstr_w(bstrName),
         debugstr_w(bstrDescription), debugstr_w(bstrIcon));
-    return E_NOTIMPL;
+
+    if (!pClsID) return E_POINTER;
+    swprintf(handler, ARRAY_SIZE(handler), L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", pClsID->Data1,
+            pClsID->Data2, pClsID->Data3, pClsID->Data4[0], pClsID->Data4[1], pClsID->Data4[2], pClsID->Data4[3],
+            pClsID->Data4[4], pClsID->Data4[5], pClsID->Data4[6], pClsID->Data4[7]);
+    return register_persistent_handler(lFlags, bstrDeviceID, pEventGUID, handler, bstrName, bstrDescription,
+            bstrIcon, NULL, pClsID);
 }
 
 static HRESULT WINAPI wiadevmgr_AddDeviceDlg(IWiaDevMgr *iface, HWND hwndParent, LONG lFlags)
