 #include "wine/test.h"
 
@@ -67,6 +71,53 @@ static void test_SelectDeviceDlg(void)
     ok(hr == S_OK || hr == WIA_S_NO_DEVICE_AVAILABLE, "got 0x%08lx\n", hr);
 }
 
+static void test_RegisterEventCallback(void)
+{
+    static const GUID event = {0x9d8f0ca8, 0x1a57, 0x4f2b, {0x9a, 0x1b, 0x5e, 0x77, 0x01, 0x02, 0x03, 0x04}};
+    static const GUID clsid = {0x6d8f0ca8, 0x1a57, 0x4f2b, {0x9a, 0x1b, 0x5e, 0x77, 0x01, 0x02, 0x03, 0x05}};
+    static const WCHAR key_path[] = L"System\\CurrentControlSet\\Control\\StillImage\\Events\\STIDeviceEvents\\"
+            L"{9D8F0CA8-1A57-4F2B-9A1B-5E7701020304}\\{6D8F0CA8-1A57-4F2B-9A1B-5E7701020305}";
+    BSTR bname = SysAllocString(L"sg test"), bdesc = SysAllocString(L"desc"), bicon = SysAllocString(L"icon");
+    IUnknown *obj = (IUnknown *)0xdeadbeef;
+    WCHAR name[64];
+    DWORD size;
+    HKEY key;
+    HRESULT hr;
+    LONG res;
+
+    hr = IWiaDevMgr_RegisterEventCallbackInterface(devmanager, WIA_REGISTER_EVENT_CALLBACK, NULL, &event, NULL, &obj);
+    ok(hr == E_POINTER, "got 0x%08lx\n", hr);
+    ok(!obj, "got %p\n", obj);
+
+    hr = IWiaDevMgr_RegisterEventCallbackCLSID(devmanager, 0, NULL, &event, &clsid, bname, bdesc, bicon);
+    ok(hr == E_INVALIDARG, "got 0x%08lx\n", hr);
+
+    hr = IWiaDevMgr_RegisterEventCallbackCLSID(devmanager, WIA_REGISTER_EVENT_CALLBACK, NULL, &event, &clsid,
+            bname, bdesc, bicon);
+    ok(hr == S_OK, "got 0x%08lx\n", hr);
+    res = RegOpenKeyExW(HKEY_LOCAL_MACHINE, key_path, 0, KEY_READ, &key);
+    ok(!res, "got %ld\n", res);
+    if (!res)
+    {
+        size = sizeof(name);
+        res = RegQueryValueExW(key, L"Name", NULL, NULL, (BYTE *)name, &size);
+        ok(!res && !wcscmp(name, L"sg test"), "got %ld %s\n", res, wine_dbgstr_w(name));
+        RegCloseKey(key);
+    }
+
+    hr = IWiaDevMgr_RegisterEventCallbackCLSID(devmanager, WIA_UNREGISTER_EVENT_CALLBACK, NULL, &event, &clsid,
+            bname, bdesc, bicon);
+    ok(hr == S_OK, "got 0x%08lx\n", hr);
+    res = RegOpenKeyExW(HKEY_LOCAL_MACHINE, key_path, 0, KEY_READ, &key);
+    ok(res == ERROR_FILE_NOT_FOUND, "got %ld\n", res);
+    hr = IWiaDevMgr_RegisterEventCallbackCLSID(devmanager, WIA_UNREGISTER_EVENT_CALLBACK, NULL, &event, &clsid,
+            bname, bdesc, bicon);
+    ok(hr == S_FALSE, "got 0x%08lx\n", hr);
+    SysFreeString(bname);
+    SysFreeString(bdesc);
+    SysFreeString(bicon);
+}
+
 START_TEST(wia)
 {
     HRESULT hr;
@@ -82,6 +133,7 @@ START_TEST(wia)
 
     test_EnumDeviceInfo();
     test_SelectDeviceDlg();
+    test_RegisterEventCallback();
 
     IWiaDevMgr_Release(devmanager);
     CoUninitialize();
