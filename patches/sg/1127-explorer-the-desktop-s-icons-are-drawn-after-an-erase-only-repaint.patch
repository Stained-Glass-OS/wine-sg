From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the desktop's icons are drawn after an erase-only repaint

wineserver validates the desktop window as soon as it is erased outside a
BeginPaint (the desktop "only gets erased, not repainted"), so after
UpdateWindow or RDW_ERASENOW on it -- SetSysColors repaints everything that
way -- the WM_PAINT that draws explorer's icons never came. On the shell's
first start after a scale or look change, uxtheme sets the colours while the
taskbar is being made, before the desktop was ever painted: the desktop
stayed empty, no icons, until something else drew it, for minutes (gates
restarted the shell to get past it; the main thread sat idle in its message
loop, last seen in the pager's paint).

The desktop now notes what an erase outside its own BeginPaint covered and
invalidates it again once the erase is done, so its WM_PAINT draws the
icons there. Nothing changes for the erase inside BeginPaint.

Test: test/deskerase-gate.sh (the shell's first start after a scale and look
change shows its icons within 20 s -- it was 1 s; an erase-only repaint by
SetSysColors leaves the icons); mutant SG_MUTANT_DESKTOP_ERASE_ONLY
(explorer desktop.c).
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -77,6 +77,9 @@
  * HideIcons, Shell\Bags\1\Desktop IconSize; the sort order in
  * Software\Stained Glass\Desktop SortBy. */
 #define WM_SG_DESKTOP_RESCAN (WM_USER + 0x5344)
+#define WM_SG_DESKTOP_REPAINT (WM_USER + 0x5348)
+static BOOL sg_in_paint;          /* inside the desktop's own BeginPaint */
+static RECT sg_erased;            /* erased outside it, its icons to draw again */
 #define SG_RESCAN_TIMER      0x5345
 static int sg_selected = -1;         /* the focused icon: the last one clicked */
 /* Stained Glass OS: selecting and dragging, as Windows' desktop: a rubber band
@@ -2846,8 +2849,33 @@
 
     case WM_ERASEBKGND:
         if (!using_root) PaintDesktop( (HDC)wp );
+#ifndef SG_MUTANT_DESKTOP_ERASE_ONLY
+        /* Stained Glass OS: an erase outside the desktop's own BeginPaint
+         * (UpdateWindow, RDW_ERASENOW: SetSysColors' repaint of everything,
+         * which uxtheme makes as the taskbar is built after a look change) is
+         * all the desktop window gets -- wineserver validates it at once (the
+         * desktop "only gets erased") -- so the WM_PAINT that draws the icons
+         * never came: the shell started with an empty desktop, for minutes,
+         * until something else drew it. What was erased is drawn again. */
+        if (!using_root && !sg_in_paint)
+        {
+            RECT clip;
+            BOOL posted = !IsRectEmpty( &sg_erased );
+
+            if (GetClipBox( (HDC)wp, &clip ) != NULLREGION && !IsRectEmpty( &clip ))
+            {
+                UnionRect( &sg_erased, &sg_erased, &clip );
+                if (!posted) PostMessageW( hwnd, WM_SG_DESKTOP_REPAINT, 0, 0 );
+            }
+        }
+#endif
         return TRUE;
 
+    case WM_SG_DESKTOP_REPAINT:
+        if (!IsRectEmpty( &sg_erased )) InvalidateRect( hwnd, &sg_erased, FALSE );
+        SetRectEmpty( &sg_erased );
+        return 0;
+
     case WM_SETTINGCHANGE:
 #ifndef SG_MUTANT_DESKTOP_ICONS_FIXED
         /* Stained Glass OS: a new display scale (explorer follows it, wine-sg
@@ -3078,7 +3106,9 @@
     case WM_PAINT:
         {
             PAINTSTRUCT ps;
+            sg_in_paint = TRUE;
             BeginPaint( hwnd, &ps );
+            sg_in_paint = FALSE;
             if (!using_root)
             {
                 /* drawn off screen and put into the desktop's picture at
