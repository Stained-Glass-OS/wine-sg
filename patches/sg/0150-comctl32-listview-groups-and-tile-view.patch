+/***
+ * Stained Glass: draws the headers of the groups: the header text in the
+ * accent colour, then a thin line to the right edge, and a chevron for a
+ * collapsible group.
+ */
+static void LISTVIEW_DrawGroupHeaders(const LISTVIEW_INFO *infoPtr, HDC hdc)
+{
+    COLORREF bk = infoPtr->clrBk == CLR_NONE ? comctl32_color.clrWindow : infoPtr->clrBk;
+    /* the selection colour, darkened: the accent, as Windows' headers show it */
+    COLORREF text = (infoPtr->groupMetrics.mask & LVGMF_TEXTCOLOR) ? infoPtr->groupMetrics.crRightHeader
+                                                                   : blend_color(comctl32_color.clrHighlight, RGB(0, 0, 0), 78);
+    HFONT font = infoPtr->hFont ? infoPtr->hFont : infoPtr->hDefaultFont;
+    RECT rc, clip, t, calc;
+    INT i;
+
+    if (!is_group_view(infoPtr)) return;
+    if (GetClipBox(hdc, &clip) == NULLREGION) return;
+    SelectObject(hdc, font);
+    SetBkMode(hdc, TRANSPARENT);
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        GROUP_INFO *group = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        UINT format = DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS;
+        HBRUSH brush;
+        INT mid;
+
+        if (IsRectEmpty(&group->rcHeader)) continue;
+        LISTVIEW_GetGroupHeaderRect(infoPtr, group, &rc);
+        if (!IntersectRect(&t, &rc, &clip)) continue;
+
+        t = rc;
+        t.left += GROUP_PADDING;
+        t.right -= GROUP_PADDING + ((group->state & LVGS_COLLAPSIBLE) ? infoPtr->ntmHeight : 0);
+        t.top += GROUP_PADDING / 2;
+        if (group->align & LVGA_HEADER_CENTER) format |= DT_CENTER;
+        else if (group->align & LVGA_HEADER_RIGHT) format |= DT_RIGHT;
+        SetTextColor(hdc, text);
+        calc = t;
+        if (group->header)
+        {
+            DrawTextW(hdc, group->header, -1, &t, format);
+            DrawTextW(hdc, group->header, -1, &calc, format | DT_CALCRECT);
+        }
+        else calc.right = calc.left;
+
+        /* the line, after the text */
+        mid = (t.top + t.bottom) / 2;
+        SetRect(&t, min(calc.right + GROUP_PADDING, rc.right), mid, rc.right - GROUP_PADDING, mid + 1);
+        if (t.right > t.left && !(group->align & (LVGA_HEADER_CENTER | LVGA_HEADER_RIGHT)))
+        {
+            brush = CreateSolidBrush(blend_color(text, bk, 18));
+            FillRect(hdc, &t, brush);
+            DeleteObject(brush);
+        }
+
+        if (group->state & LVGS_COLLAPSIBLE)
+        {
+            /* a chevron: down when open, right when collapsed */
+            INT x = rc.right - GROUP_PADDING - infoPtr->ntmHeight / 2, y = mid, k, size = max(infoPtr->ntmHeight / 4, 2);
+            HPEN pen = CreatePen(PS_SOLID, 1, text), oldpen = SelectObject(hdc, pen);
+            for (k = 0; k < 2; k++)
+            {
+                if (group->state & LVGS_COLLAPSED)
+                {
+                    MoveToEx(hdc, x - size / 2 + k, y - size, NULL);
+                    LineTo(hdc, x + size / 2 + k, y);
+                    LineTo(hdc, x - size / 2 + k - 1, y + size + 1);
+                }
+                else
+                {
+                    MoveToEx(hdc, x - size, y - size / 2 + k, NULL);
+                    LineTo(hdc, x, y + size / 2 + k);
+                    LineTo(hdc, x + size + 1, y - size / 2 + k - 1);
+                }
+            }
+            SelectObject(hdc, oldpen);
+            DeleteObject(pen);
+        }
+    }
+}
