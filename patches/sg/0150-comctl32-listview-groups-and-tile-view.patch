+/* Stained Glass: the group an item is in, asking the application when it said it would tell */
+static INT LISTVIEW_GetItemGroupId(const LISTVIEW_INFO *infoPtr, INT nItem)
+{
+    ITEM_INFO *item = LISTVIEW_GetItemInfo(infoPtr, nItem);
+    NMLVDISPINFOW dispInfo;
+
+    if (!item) return I_GROUPIDNONE;
+    if (item->iGroupId != I_GROUPIDCALLBACK) return item->iGroupId;
+    memset(&dispInfo, 0, sizeof(dispInfo));
+    dispInfo.item.mask = LVIF_GROUPID;
+    dispInfo.item.iItem = nItem;
+    dispInfo.item.lParam = item->lParam;
+    dispInfo.item.iGroupId = I_GROUPIDNONE;
+    notify_dispinfoT(infoPtr, LVN_GETDISPINFOW, &dispInfo, TRUE);
+    return dispInfo.item.iGroupId;
+}
