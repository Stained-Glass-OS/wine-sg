+/* Stained Glass: keeps a copy of the subitems a tile shows (LVIF_COLUMNS, LVM_SETTILEINFO) */
+static BOOL LISTVIEW_SetItemColumns(ITEM_INFO *item, UINT count, const UINT *columns, const INT *formats)
+{
+    UINT *copy = NULL;
+    INT *fmt = NULL;
+
+    if (count == I_COLUMNSCALLBACK) count = 0;
+    if (count && !columns) return FALSE;
+    if (count && (!(copy = Alloc(count * sizeof(UINT))) || !(fmt = Alloc(count * sizeof(INT)))))
+    {
+        Free(copy);
+        return FALSE;
+    }
+    if (count)
+    {
+        memcpy(copy, columns, count * sizeof(UINT));
+        if (formats) memcpy(fmt, formats, count * sizeof(INT));
+    }
+    Free(item->puColumns);
+    Free(item->piColFmt);
+    item->puColumns = copy;
+    item->piColFmt = fmt;
+    item->cColumns = count;
+    return TRUE;
+}
