+/* Stained Glass: in group view, the nearest item in a direction, by where items are */
+static INT LISTVIEW_GetNearestItem(const LISTVIEW_INFO *infoPtr, INT nItem, UINT uFlags, UINT uMask)
+{
+    LONGLONG best_distance = 0, distance;
+    INT i, best = -1, dx, dy;
+    POINT from, pt;
+
+    if (nItem < 0 || (LONG_PTR)DPA_GetPtr(infoPtr->hdpaPosX, nItem) == LV_HIDDEN_POS)
+        return infoPtr->nDisplayOrder ? infoPtr->displayOrder[0] : -1;
+    LISTVIEW_GetItemOrigin(infoPtr, nItem, &from);
+    for (i = 0; i < infoPtr->nItemCount; i++)
+    {
+        if (i == nItem || (LONG_PTR)DPA_GetPtr(infoPtr->hdpaPosX, i) == LV_HIDDEN_POS) continue;
+        LISTVIEW_GetItemOrigin(infoPtr, i, &pt);
+        dx = pt.x - from.x;
+        dy = pt.y - from.y;
+        if (uFlags & LVNI_ABOVE)
+        {
+            if (dy >= 0) continue;
+            distance = (LONGLONG)-dy * 100000 + abs(dx);
+        }
+        else if (uFlags & LVNI_BELOW)
+        {
+            if (dy <= 0) continue;
+            distance = (LONGLONG)dy * 100000 + abs(dx);
+        }
+        else if (uFlags & LVNI_TOLEFT)
+        {
+            if (dy || dx >= 0) continue;
+            distance = -dx;
+        }
+        else
+        {
+            if (dy || dx <= 0) continue;
+            distance = dx;
+        }
+        if ((LISTVIEW_GetItemState(infoPtr, i, uMask) & uMask) != uMask) continue;
+        if (best == -1 || distance < best_distance)
+        {
+            best = i;
+            best_distance = distance;
+        }
+    }
+    return best;
+}
