+/***
+ * Stained Glass: lays the groups out top to bottom -- a header, then the
+ * group's items placed as the view places them (rows of icons or tiles, or one
+ * per line in details) -- and gives an item in no shown group no place at all,
+ * as Windows does. Positions are in list coordinates, as icon positions are.
+ */
+static void LISTVIEW_ArrangeGroups(LISTVIEW_INFO *infoPtr)
+{
+    INT width = infoPtr->rcList.right - infoPtr->rcList.left;
+    INT ngroups = DPA_GetPtrCount(infoPtr->hdpaGroups);
+    BOOL details = infoPtr->uView == LV_VIEW_DETAILS;
+    INT g, i, y, col, perRow, n = 0, *ids;
+
+    infoPtr->nGroupHeaderHeight = infoPtr->ntmHeight + 2 * GROUP_PADDING + 2;
+    Free(infoPtr->displayOrder);
+    infoPtr->displayOrder = Alloc(max(infoPtr->nItemCount, 1) * sizeof(INT));
+    ids = Alloc(max(infoPtr->nItemCount, 1) * sizeof(INT));
+    if (!infoPtr->displayOrder || !ids)
+    {
+        Free(ids);
+        return;
+    }
+
+    while (DPA_GetPtrCount(infoPtr->hdpaPosX) > infoPtr->nItemCount)
+        DPA_DeletePtr(infoPtr->hdpaPosX, DPA_GetPtrCount(infoPtr->hdpaPosX) - 1);
+    while (DPA_GetPtrCount(infoPtr->hdpaPosY) > infoPtr->nItemCount)
+        DPA_DeletePtr(infoPtr->hdpaPosY, DPA_GetPtrCount(infoPtr->hdpaPosY) - 1);
+    for (i = 0; i < infoPtr->nItemCount; i++)
+    {
+        DPA_SetPtr(infoPtr->hdpaPosX, i, (void *)(LONG_PTR)LV_HIDDEN_POS);
+        DPA_SetPtr(infoPtr->hdpaPosY, i, (void *)(LONG_PTR)LV_HIDDEN_POS);
+        ids[i] = LISTVIEW_GetItemGroupId(infoPtr, i);
+    }
+
+    perRow = details ? 1 : max(width / max(infoPtr->nItemWidth, 1), 1);
+    y = GROUP_PADDING / 2;
+    for (g = 0; g < ngroups; g++)
+    {
+        GROUP_INFO *group = DPA_GetPtr(infoPtr->hdpaGroups, g);
+
+        SetRectEmpty(&group->rcHeader);
+        group->count = 0;
+        group->first = n;
+        for (i = 0; i < infoPtr->nItemCount; i++)
+            if (ids[i] == group->id) group->count++;
+        if (!group->count || (group->state & LVGS_HIDDEN)) continue;
+
+        if (!(group->state & LVGS_NOHEADER))
+        {
+            SetRect(&group->rcHeader, 0, y, max(width, 1), y + infoPtr->nGroupHeaderHeight);
+            y += infoPtr->nGroupHeaderHeight;
+        }
+        if (group->state & LVGS_COLLAPSED)
+        {
+            y += GROUP_PADDING;
+            continue;
+        }
+        col = 0;
+        for (i = 0; i < infoPtr->nItemCount; i++)
+        {
+            if (ids[i] != group->id) continue;
+            infoPtr->displayOrder[n++] = i;
+            DPA_SetPtr(infoPtr->hdpaPosX, i, (void *)(LONG_PTR)(details ? 0 : col * infoPtr->nItemWidth));
+            DPA_SetPtr(infoPtr->hdpaPosY, i, (void *)(LONG_PTR)y);
+            if (details || ++col == perRow)
+            {
+                col = 0;
+                y += infoPtr->nItemHeight;
+            }
+        }
+        if (col) y += infoPtr->nItemHeight;
+        y += GROUP_PADDING;
+    }
+    infoPtr->nDisplayOrder = n;
+    infoPtr->nGroupsHeight = y;
+    Free(ids);
+    LISTVIEW_InvalidateList(infoPtr);
+}
