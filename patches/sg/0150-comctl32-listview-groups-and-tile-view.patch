+/******** Stained Glass: groups and tiles ************************************/
+
+static void group_set_text(WCHAR **dst, const WCHAR *src)
+{
+    Free(*dst);
+    *dst = NULL;
+    if (src && src != LPSTR_TEXTCALLBACKW && (*dst = Alloc((lstrlenW(src) + 1) * sizeof(WCHAR))))
+        lstrcpyW(*dst, src);
+}
+
+static void group_get_text(const WCHAR *src, WCHAR *dst, INT len)
+{
+    if (!dst || len <= 0) return;
+    lstrcpynW(dst, src ? src : L"", len);
+}
+
+static void LISTVIEW_FreeGroup(GROUP_INFO *group)
+{
+    Free(group->header);
+    Free(group->footer);
+    Free(group->subtitle);
+    Free(group->task);
+    Free(group->descTop);
+    Free(group->descBottom);
+    Free(group->subsetTitle);
+    Free(group);
+}
+
+/* lays the items out again after the groups changed */
+static void LISTVIEW_GroupsChanged(LISTVIEW_INFO *infoPtr)
+{
+    if (is_group_view(infoPtr)) LISTVIEW_ArrangeGroups(infoPtr);
+    else if (is_icon_view(infoPtr)) LISTVIEW_Arrange(infoPtr, LVA_DEFAULT);
+    LISTVIEW_UpdateScroll(infoPtr);
+    LISTVIEW_InvalidateList(infoPtr);
+}
+
+static void LISTVIEW_SetGroupFields(GROUP_INFO *group, const LVGROUP *info)
+{
+    if (info->mask & LVGF_HEADER) group_set_text(&group->header, info->pszHeader);
+    if (info->mask & LVGF_FOOTER) group_set_text(&group->footer, info->pszFooter);
+    if (info->mask & LVGF_STATE) group->state = (group->state & ~info->stateMask) | (info->state & info->stateMask);
+    if (info->mask & LVGF_ALIGN) group->align = info->uAlign;
+    if (info->cbSize < sizeof(LVGROUP)) return;
+    if (info->mask & LVGF_SUBTITLE) group_set_text(&group->subtitle, info->pszSubtitle);
+    if (info->mask & LVGF_TASK) group_set_text(&group->task, info->pszTask);
+    if (info->mask & LVGF_DESCRIPTIONTOP) group_set_text(&group->descTop, info->pszDescriptionTop);
+    if (info->mask & LVGF_DESCRIPTIONBOTTOM) group_set_text(&group->descBottom, info->pszDescriptionBottom);
+    if (info->mask & LVGF_TITLEIMAGE) group->iTitleImage = info->iTitleImage;
+    if (info->mask & LVGF_EXTENDEDIMAGE) group->iExtendedImage = info->iExtendedImage;
+    if (info->mask & LVGF_SUBSET) group_set_text(&group->subsetTitle, info->pszSubsetTitle);
+}
+
+static BOOL LISTVIEW_GetGroupFields(const LISTVIEW_INFO *infoPtr, const GROUP_INFO *group, LVGROUP *info)
+{
+    if (!info || info->cbSize < LVGROUP_V5_SIZE) return FALSE;
+    if (info->mask & LVGF_HEADER) group_get_text(group->header, info->pszHeader, info->cchHeader);
+    if (info->mask & LVGF_FOOTER) group_get_text(group->footer, info->pszFooter, info->cchFooter);
+    if (info->mask & LVGF_STATE) info->state = group->state & info->stateMask;
+    if (info->mask & LVGF_ALIGN) info->uAlign = group->align;
+    if (info->mask & LVGF_GROUPID) info->iGroupId = group->id;
+    if (info->cbSize < sizeof(LVGROUP)) return TRUE;
+    if (info->mask & LVGF_SUBTITLE) group_get_text(group->subtitle, info->pszSubtitle, info->cchSubtitle);
+    if (info->mask & LVGF_TASK) group_get_text(group->task, info->pszTask, info->cchTask);
+    if (info->mask & LVGF_DESCRIPTIONTOP) group_get_text(group->descTop, info->pszDescriptionTop, info->cchDescriptionTop);
+    if (info->mask & LVGF_DESCRIPTIONBOTTOM) group_get_text(group->descBottom, info->pszDescriptionBottom, info->cchDescriptionBottom);
+    if (info->mask & LVGF_TITLEIMAGE) info->iTitleImage = group->iTitleImage;
+    if (info->mask & LVGF_EXTENDEDIMAGE) info->iExtendedImage = group->iExtendedImage;
+    if (info->mask & LVGF_SUBSET) group_get_text(group->subsetTitle, info->pszSubsetTitle, info->cchSubsetTitle);
+    if (info->mask & LVGF_ITEMS)
+    {
+        INT i;
+        info->iFirstItem = -1;
+        info->cItems = 0;
+        for (i = 0; i < infoPtr->nItemCount; i++)
+        {
+            if (LISTVIEW_GetItemGroupId(infoPtr, i) != group->id) continue;
+            if (info->iFirstItem == -1) info->iFirstItem = i;
+            info->cItems++;
+        }
+    }
+    return TRUE;
+}
+
+static LRESULT LISTVIEW_EnableGroupView(LISTVIEW_INFO *infoPtr, BOOL enable)
+{
+    if (infoPtr->dwStyle & LVS_OWNERDATA) return -1;
+    if (!!enable == infoPtr->bGroupView) return 0;
+    infoPtr->bGroupView = !!enable;
+    LISTVIEW_GroupsChanged(infoPtr);
+    return 1;
+}
+
+static INT LISTVIEW_InsertGroup(LISTVIEW_INFO *infoPtr, INT index, const LVGROUP *info)
+{
+    GROUP_INFO *group;
+
+    if (!info || info->cbSize < LVGROUP_V5_SIZE || !(info->mask & LVGF_GROUPID)) return -1;
+    if (LISTVIEW_GetGroup(infoPtr, info->iGroupId, NULL)) return -1;
+    if (!(group = Alloc(sizeof(*group)))) return -1;
+    group->id = info->iGroupId;
+    LISTVIEW_SetGroupFields(group, info);
+    if (index < 0 || index > DPA_GetPtrCount(infoPtr->hdpaGroups)) index = DPA_GetPtrCount(infoPtr->hdpaGroups);
+    if ((index = DPA_InsertPtr(infoPtr->hdpaGroups, index, group)) == -1)
+    {
+        LISTVIEW_FreeGroup(group);
+        return -1;
+    }
+    LISTVIEW_GroupsChanged(infoPtr);
+    return index;
+}
+
+static INT LISTVIEW_InsertGroupSorted(LISTVIEW_INFO *infoPtr, const LVINSERTGROUPSORTED *sorted)
+{
+    INT i;
+
+    if (!sorted || !sorted->pfnGroupCompare) return -1;
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        GROUP_INFO *group = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        if (sorted->pfnGroupCompare(sorted->lvGroup.iGroupId, group->id, sorted->pvData) < 0) break;
+    }
+    return LISTVIEW_InsertGroup(infoPtr, i, &sorted->lvGroup);
+}
+
+static INT LISTVIEW_SetGroupInfo(LISTVIEW_INFO *infoPtr, INT id, const LVGROUP *info)
+{
+    GROUP_INFO *group;
+
+    if (!info || info->cbSize < LVGROUP_V5_SIZE || !(group = LISTVIEW_GetGroup(infoPtr, id, NULL))) return -1;
+    if ((info->mask & LVGF_GROUPID) && info->iGroupId != id)
+    {
+        if (LISTVIEW_GetGroup(infoPtr, info->iGroupId, NULL)) return -1;
+        group->id = info->iGroupId;
+    }
+    LISTVIEW_SetGroupFields(group, info);
+    LISTVIEW_GroupsChanged(infoPtr);
+    return group->id;
+}
+
+static INT LISTVIEW_RemoveGroup(LISTVIEW_INFO *infoPtr, INT id)
+{
+    GROUP_INFO *group;
+    INT index;
+
+    if (!(group = LISTVIEW_GetGroup(infoPtr, id, &index))) return -1;
+    DPA_DeletePtr(infoPtr->hdpaGroups, index);
+    LISTVIEW_FreeGroup(group);
+    LISTVIEW_GroupsChanged(infoPtr);
+    return index;
+}
+
+static void LISTVIEW_RemoveAllGroups(LISTVIEW_INFO *infoPtr)
+{
+    INT i;
+
+    for (i = DPA_GetPtrCount(infoPtr->hdpaGroups) - 1; i >= 0; i--)
+        LISTVIEW_FreeGroup(DPA_DeletePtr(infoPtr->hdpaGroups, i));
+    LISTVIEW_GroupsChanged(infoPtr);
+}
