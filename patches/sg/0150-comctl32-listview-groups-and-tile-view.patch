+struct group_sort
+{
+    PFNLVGROUPCOMPARE compare;
+    void *data;
+};
+
+static INT CALLBACK LISTVIEW_GroupSortCompare(void *a, void *b, LPARAM param)
+{
+    const struct group_sort *sort = (const struct group_sort *)param;
+    return sort->compare(((GROUP_INFO *)a)->id, ((GROUP_INFO *)b)->id, sort->data);
+}
+
+static BOOL LISTVIEW_SortGroups(LISTVIEW_INFO *infoPtr, PFNLVGROUPCOMPARE compare, void *data)
+{
+    struct group_sort sort = { compare, data };
+
+    if (!compare) return FALSE;
+    DPA_Sort(infoPtr->hdpaGroups, LISTVIEW_GroupSortCompare, (LPARAM)&sort);
+    LISTVIEW_GroupsChanged(infoPtr);
+    return TRUE;
+}
