+/* Stained Glass: a group header's rectangle in client coordinates */
+static void LISTVIEW_GetGroupHeaderRect(const LISTVIEW_INFO *infoPtr, const GROUP_INFO *group, RECT *rc)
+{
+    POINT Origin;
+
+    LISTVIEW_GetOrigin(infoPtr, &Origin);
+    *rc = group->rcHeader;
+    if (infoPtr->uView == LV_VIEW_DETAILS)
+        OffsetRect(rc, infoPtr->rcList.left, Origin.y);
+    else
+        OffsetRect(rc, Origin.x, Origin.y);
+}
