+static inline COLORREF blend_color(COLORREF a, COLORREF b, int pct)
+{
+    return RGB((GetRValue(a) * pct + GetRValue(b) * (100 - pct)) / 100,
+               (GetGValue(a) * pct + GetGValue(b) * (100 - pct)) / 100,
+               (GetBValue(a) * pct + GetBValue(b) * (100 - pct)) / 100);
+}
