+static BOOL LISTVIEW_SetTileViewInfo(LISTVIEW_INFO *infoPtr, const LVTILEVIEWINFO *info)
+{
+    if (!info || info->cbSize < sizeof(*info)) return FALSE;
+    if (info->dwMask & LVTVIM_TILESIZE)
+    {
+        infoPtr->tileFlags = info->dwFlags;
+        infoPtr->tileSize = info->sizeTile;
+    }
+    if (info->dwMask & LVTVIM_COLUMNS) infoPtr->tileLines = max(info->cLines, 0);
+    if (info->dwMask & LVTVIM_LABELMARGIN) infoPtr->tileMargin = info->rcLabelMargin;
+    LISTVIEW_TileChanged(infoPtr);
+    return TRUE;
+}
+
+static BOOL LISTVIEW_GetTileViewInfo(const LISTVIEW_INFO *infoPtr, LVTILEVIEWINFO *info)
+{
+    if (!info || info->cbSize < sizeof(*info)) return FALSE;
+    if (info->dwMask & LVTVIM_TILESIZE)
+    {
+        info->dwFlags = infoPtr->tileFlags;
+        info->sizeTile = infoPtr->tileSize;
+        if (infoPtr->uView == LV_VIEW_TILE)
+        {
+            info->sizeTile.cx = infoPtr->nItemWidth;
+            info->sizeTile.cy = infoPtr->nItemHeight;
+        }
+    }
+    if (info->dwMask & LVTVIM_COLUMNS) info->cLines = infoPtr->tileLines;
+    if (info->dwMask & LVTVIM_LABELMARGIN) info->rcLabelMargin = infoPtr->tileMargin;
+    return TRUE;
+}
+
+static BOOL LISTVIEW_SetTileInfo(LISTVIEW_INFO *infoPtr, const LVTILEINFO *info)
+{
+    ITEM_INFO *item;
+
+    if (!info || info->cbSize < offsetof(LVTILEINFO, piColFmt)) return FALSE;
+    if (!(item = LISTVIEW_GetItemInfo(infoPtr, info->iItem))) return FALSE;
+    if (!LISTVIEW_SetItemColumns(item, info->cColumns, info->puColumns,
+                                 info->cbSize >= sizeof(LVTILEINFO) ? info->piColFmt : NULL)) return FALSE;
+    LISTVIEW_InvalidateItem(infoPtr, info->iItem);
+    return TRUE;
+}
+
+static BOOL LISTVIEW_GetTileInfo(const LISTVIEW_INFO *infoPtr, LVTILEINFO *info)
+{
+    ITEM_INFO *item;
+    UINT n;
+
+    if (!info || info->cbSize < offsetof(LVTILEINFO, piColFmt)) return FALSE;
+    if (!(item = LISTVIEW_GetItemInfo(infoPtr, info->iItem))) return FALSE;
+    n = min(info->cColumns, item->cColumns);
+    if (n && info->puColumns) memcpy(info->puColumns, item->puColumns, n * sizeof(UINT));
+    if (n && info->cbSize >= sizeof(LVTILEINFO) && info->piColFmt) memcpy(info->piColFmt, item->piColFmt, n * sizeof(INT));
+    info->cColumns = item->cColumns;
+    return TRUE;
+}
