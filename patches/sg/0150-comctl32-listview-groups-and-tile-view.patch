+static GROUP_INFO *LISTVIEW_GetGroup(const LISTVIEW_INFO *infoPtr, INT id, INT *index)
+{
+    INT i;
+
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        GROUP_INFO *group = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        if (group->id == id)
+        {
+            if (index) *index = i;
+            return group;
+        }
+    }
+    return NULL;
+}
