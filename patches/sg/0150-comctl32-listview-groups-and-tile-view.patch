+/* the bottom of a group's last row, list coordinates */
+static INT LISTVIEW_GroupBottom(const LISTVIEW_INFO *infoPtr, const GROUP_INFO *group)
+{
+    INT i, bottom = group->rcHeader.bottom;
+
+    for (i = group->first; i < group->first + group->count && i < infoPtr->nDisplayOrder; i++)
+        bottom = max(bottom, (LONG_PTR)DPA_GetPtr(infoPtr->hdpaPosY, infoPtr->displayOrder[i]) + infoPtr->nItemHeight);
+    return bottom;
+}
+
+static BOOL LISTVIEW_GetGroupRect(const LISTVIEW_INFO *infoPtr, INT id, RECT *rc)
+{
+    GROUP_INFO *group;
+    LONG type;
+
+    if (!rc || !(group = LISTVIEW_GetGroup(infoPtr, id, NULL)) || !is_group_view(infoPtr)) return FALSE;
+    type = rc->top;
+    LISTVIEW_GetGroupHeaderRect(infoPtr, group, rc);
+    if (type == LVGGR_GROUP) rc->bottom += LISTVIEW_GroupBottom(infoPtr, group) - group->rcHeader.bottom;
+    else if (type == LVGGR_LABEL) InflateRect(rc, -GROUP_PADDING, 0);
+    return TRUE;
+}
+
+static INT LISTVIEW_GetFocusedGroup(const LISTVIEW_INFO *infoPtr)
+{
+    INT index;
+
+    if (infoPtr->nFocusedItem < 0 || !LISTVIEW_GetGroup(infoPtr, LISTVIEW_GetItemGroupId(infoPtr, infoPtr->nFocusedItem), &index))
+        return -1;
+    return index;
+}
+
+/* the group whose header is at a point, client coordinates */
+static GROUP_INFO *LISTVIEW_GroupHeaderAt(const LISTVIEW_INFO *infoPtr, POINT pt, RECT *header)
+{
+    INT i;
+
+    if (!is_group_view(infoPtr)) return NULL;
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        GROUP_INFO *group = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        if (IsRectEmpty(&group->rcHeader)) continue;
+        LISTVIEW_GetGroupHeaderRect(infoPtr, group, header);
+        if (PtInRect(header, pt)) return group;
+    }
+    return NULL;
+}
+
+/* a click on a group's header selects the group's items; on its chevron, folds it */
+static BOOL LISTVIEW_ClickGroupHeader(LISTVIEW_INFO *infoPtr, WORD keys, POINT pt)
+{
+    GROUP_INFO *group;
+    RECT header;
+    LVITEMW item;
+    INT i, first = -1;
+
+    if (!(group = LISTVIEW_GroupHeaderAt(infoPtr, pt, &header))) return FALSE;
+    if (!infoPtr->bFocus) SetFocus(infoPtr->hwndSelf);
+    if ((group->state & LVGS_COLLAPSIBLE) && pt.x >= header.right - GROUP_PADDING - infoPtr->ntmHeight - 4)
+    {
+        group->state ^= LVGS_COLLAPSED;
+        LISTVIEW_GroupsChanged(infoPtr);
+        return TRUE;
+    }
+    if (infoPtr->dwStyle & LVS_SINGLESEL) return TRUE;
+    if (!(keys & MK_CONTROL)) LISTVIEW_DeselectAll(infoPtr);
+    item.state = item.stateMask = LVIS_SELECTED;
+    for (i = group->first; i < group->first + group->count && i < infoPtr->nDisplayOrder; i++)
+    {
+        if (first == -1) first = infoPtr->displayOrder[i];
+        LISTVIEW_SetItemState(infoPtr, infoPtr->displayOrder[i], &item);
+    }
+    if (first != -1)
+    {
+        LISTVIEW_SetItemFocus(infoPtr, first);
+        infoPtr->nSelectionMark = first;
+    }
+    return TRUE;
+}
