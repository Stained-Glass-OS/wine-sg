+    DWORD       anim_start;     /* the windows fly into place when it opens */
+    BOOL        animating;
 };
 static struct tv_state tv;
 
+/* Stained Glass OS: opening, each window flies from where it is on the screen
+ * to its place in the grid -- it changed in one frame (David 2026-09-29). As
+ * Windows does, only with "Show animations in Windows" on
+ * (SPI_GETCLIENTAREAANIMATION). SG_TASKVIEW_ANIM_MS sets the length (gates). */
+static int tv_anim_ms(void)
+{
+    const char *e = getenv( "SG_TASKVIEW_ANIM_MS" );
+    int ms = e ? atoi( e ) : 220;
+    return ms > 0 ? ms : 220;
+}
+
+static BOOL tv_animations(void)
+{
+    BOOL on = TRUE;
+    if (!SystemParametersInfoW( SPI_GETCLIENTAREAANIMATION, 0, &on, 0 )) on = TRUE;
+    return on;
+}
+
+/* where item i is drawn now: its grid place, or on its way there */
+static RECT tv_item_rect( HWND hwnd, int i )
+{
+    RECT to = tv.items[i].rect, from;
+    double t, e;
+
+    if (!tv.animating || IsIconic( tv.items[i].hwnd ) || !GetWindowRect( tv.items[i].hwnd, &from )) return to;
+    MapWindowPoints( HWND_DESKTOP, hwnd, (POINT *)&from, 2 );
+    t = (double)(GetTickCount() - tv.anim_start) / tv_anim_ms();
+    if (t >= 1.0) return to;
+    e = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);   /* ease out */
+    SetRect( &from, from.left + (int)((to.left - from.left) * e), from.top + (int)((to.top - from.top) * e),
+             from.right + (int)((to.right - from.right) * e), from.bottom + (int)((to.bottom - from.bottom) * e) );
+    return from;
+}
+
