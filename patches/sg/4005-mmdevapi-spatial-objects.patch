+
+    if(!active)
+        return E_POINTER;
+
+    EnterCriticalSection(&This->sa_stream->lock);
+    *active = !This->invalid;
+    LeaveCriticalSection(&This->sa_stream->lock);
+
+    return S_OK;
 }
 
