+    if(SUCCEEDED(hr = SAO_check_update(This)) && This->type != AudioObjectType_Dynamic)
+        hr = SPTLAUDCLNT_E_PROPERTY_NOT_SUPPORTED;
+    LeaveCriticalSection(&This->sa_stream->lock);
