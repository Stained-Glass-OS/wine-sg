 }
 
 static HRESULT WINAPI SAC_GetNativeStaticObjectTypeMask(ISpatialAudioClient *iface,
         AudioObjectType *mask)
 {
+    static const struct
+    {
+        DWORD speaker;
+        AudioObjectType type;
+    }
+    speaker_types[] =
+    {
+        {SPEAKER_FRONT_LEFT, AudioObjectType_FrontLeft},
+        {SPEAKER_FRONT_RIGHT, AudioObjectType_FrontRight},
+        {SPEAKER_FRONT_CENTER, AudioObjectType_FrontCenter},
+        {SPEAKER_LOW_FREQUENCY, AudioObjectType_LowFrequency},
+        {SPEAKER_SIDE_LEFT, AudioObjectType_SideLeft},
+        {SPEAKER_SIDE_RIGHT, AudioObjectType_SideRight},
+        {SPEAKER_BACK_LEFT, AudioObjectType_BackLeft},
+        {SPEAKER_BACK_RIGHT, AudioObjectType_BackRight},
+        {SPEAKER_TOP_FRONT_LEFT, AudioObjectType_TopFrontLeft},
+        {SPEAKER_TOP_FRONT_RIGHT, AudioObjectType_TopFrontRight},
+        {SPEAKER_TOP_BACK_LEFT, AudioObjectType_TopBackLeft},
+        {SPEAKER_TOP_BACK_RIGHT, AudioObjectType_TopBackRight},
+        {SPEAKER_BACK_CENTER, AudioObjectType_BackCenter},
+    };
     SpatialAudioImpl *This = impl_from_ISpatialAudioClient(iface);
-    FIXME("(%p)->(%p)\n", This, mask);
-    return E_NOTIMPL;
+    WAVEFORMATEXTENSIBLE *fmtex;
+    IAudioClient *client;
+    unsigned int i;
+    DWORD speakers;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, mask);
+
+    if(!mask)
+        return E_POINTER;
+
+    /* The channels the endpoint itself has. */
+    if(FAILED(hr = IMMDevice_Activate(This->mmdev, &IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client)))
+        return hr;
+    if(SUCCEEDED(hr = IAudioClient_GetMixFormat(client, (WAVEFORMATEX **)&fmtex))){
+        if(fmtex->Format.wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+            speakers = fmtex->dwChannelMask;
+        else
+            speakers = fmtex->Format.nChannels == 1 ? SPEAKER_FRONT_CENTER : SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT;
+        CoTaskMemFree(fmtex);
+
+        *mask = 0;
+        for(i = 0; i < ARRAY_SIZE(speaker_types); ++i)
+            if(speakers & speaker_types[i].speaker)
+                *mask |= speaker_types[i].type;
+    }
+    IAudioClient_Release(client);
+
+    return hr;
 }
 
