+    {AudioObjectType_FrontRight,     0.5f,       0.0f,       -0.8660254f},
+    {AudioObjectType_FrontCenter,    0.0f,       0.0f,       -1.0f},
+    {AudioObjectType_LowFrequency,   0.0f,       0.0f,        0.0f},
+    {AudioObjectType_SideLeft,      -1.0f,       0.0f,        0.0f},
+    {AudioObjectType_SideRight,      1.0f,       0.0f,        0.0f},
+    {AudioObjectType_BackLeft,      -0.7071068f, 0.0f,        0.7071068f},
+    {AudioObjectType_BackRight,      0.7071068f, 0.0f,        0.7071068f},
+    {AudioObjectType_TopFrontLeft,  -0.3535534f, 0.7071068f, -0.6123724f},
+    {AudioObjectType_TopFrontRight,  0.3535534f, 0.7071068f, -0.6123724f},
+    {AudioObjectType_TopBackLeft,   -0.5f,       0.7071068f,  0.5f},
+    {AudioObjectType_TopBackRight,   0.5f,       0.7071068f,  0.5f},
+    {AudioObjectType_BottomFrontLeft,  -0.3535534f, -0.7071068f, -0.6123724f},
+    {AudioObjectType_BottomFrontRight,  0.3535534f, -0.7071068f, -0.6123724f},
+    {AudioObjectType_BottomBackLeft,   -0.5f,       -0.7071068f,  0.5f},
+    {AudioObjectType_BottomBackRight,   0.5f,       -0.7071068f,  0.5f},
+    {AudioObjectType_BackCenter,     0.0f,       0.0f,        1.0f},
+};
