 static HRESULT WINAPI SAC_GetStaticObjectPosition(ISpatialAudioClient *iface,
         AudioObjectType type, float *x, float *y, float *z)
 {
     SpatialAudioImpl *This = impl_from_ISpatialAudioClient(iface);
-    FIXME("(%p)->(0x%x, %p, %p, %p)\n", This, type, x, y, z);
-    return E_NOTIMPL;
+    unsigned int i;
+
+    TRACE("(%p)->(0x%x, %p, %p, %p)\n", This, type, x, y, z);
+
+    if(!x || !y || !z)
+        return E_POINTER;
+
+    for(i = 0; i < ARRAY_SIZE(static_positions); ++i){
+        if(static_positions[i].type == type){
+            *x = static_positions[i].x;
+            *y = static_positions[i].y;
+            *z = static_positions[i].z;
+            return S_OK;
+        }
+    }
