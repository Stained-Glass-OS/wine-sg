From: Stained Glass OS <dev@stained-glass.example>
Subject: dwrite: CreateFontFromLOGFONT finds the font GDI uses for a substituted name

IDWriteGdiInterop::CreateFontFromLOGFONT looked the LOGFONT's face name up
only as a family of the system collection. "Segoe UI", "MS Shell Dlg" and
the other names a machine knows by FontSubstitutes (on Stained Glass, the
UI fonts sg-shell maps to Inter) failed with DWRITE_E_NOFONT, so programs
that shape text with DirectWrite and draw it with GDI or cairo (WPF,
Chromium, Pango) lost their UI font or used another font than GDI draws.

When the name is no family, the font GDI selects for it -- only when GDI
knows the name, not its default for an unknown one -- is found in the
collection: by its file, else by its family, weight, stretch and style.

Gate: test/dwlogfont-gate.sh. dwrite:font, layout, analyzer unchanged.
---
--- a/dlls/dwrite/gdiinterop.c
+++ b/dlls/dwrite/gdiinterop.c
@@ -875,7 +875,63 @@
         goto done;
 
     if (!exists) {
+        /* A name GDI knows by substitution or linking ("MS Shell Dlg", a
+         * FontSubstitutes entry): the font GDI chooses for it, if the
+         * collection has that file. Programs that shape with DirectWrite and
+         * draw with GDI (Pango and cairo) otherwise use two different fonts. */
         hr = DWRITE_E_NOFONT;
+        if (logfont->lfFaceName[0])
+        {
+            HFONT hfont = CreateFontIndirectW(logfont);
+            HDC hdc = CreateCompatibleDC(0);
+            IDWriteFontFace *fontface = NULL;
+
+            if (hfont && hdc)
+            {
+                HGDIOBJ old = SelectObject(hdc, hfont);
+                WCHAR face[LF_FACESIZE];
+
+                /* only a name GDI knows: for an unknown one it picks some
+                 * default font, and DirectWrite has no such font */
+                if (GetTextFaceW(hdc, ARRAY_SIZE(face), face) && !wcsicmp(face, logfont->lfFaceName) &&
+                    SUCCEEDED(gdiinterop_CreateFontFaceFromHdc(iface, hdc, &fontface)))
+                {
+                    IDWriteFontFace3 *fontface3;
+
+                    if (FAILED(IDWriteFontCollection_GetFontFromFontFace(collection, fontface, font)))
+                        *font = NULL;
+                    /* the file is named differently here: the same family,
+                     * weight, stretch and style */
+                    if (!*font && SUCCEEDED(IDWriteFontFace_QueryInterface(fontface, &IID_IDWriteFontFace3,
+                            (void **)&fontface3)))
+                    {
+                        IDWriteLocalizedStrings *names;
+                        WCHAR name[LF_FACESIZE];
+
+                        if (SUCCEEDED(IDWriteFontFace3_GetFamilyNames(fontface3, &names)))
+                        {
+                            if (SUCCEEDED(IDWriteLocalizedStrings_GetString(names, 0, name, ARRAY_SIZE(name))) &&
+                                SUCCEEDED(IDWriteFontCollection_FindFamilyName(collection, name, &index, &exists)) &&
+                                exists &&
+                                SUCCEEDED(IDWriteFontCollection_GetFontFamily(collection, index, &family)))
+                            {
+                                if (FAILED(IDWriteFontFamily_GetFirstMatchingFont(family, IDWriteFontFace3_GetWeight(fontface3),
+                                        IDWriteFontFace3_GetStretch(fontface3), IDWriteFontFace3_GetStyle(fontface3), font)))
+                                    *font = NULL;
+                                IDWriteFontFamily_Release(family);
+                            }
+                            IDWriteLocalizedStrings_Release(names);
+                        }
+                        IDWriteFontFace3_Release(fontface3);
+                    }
+                    IDWriteFontFace_Release(fontface);
+                }
+                SelectObject(hdc, old);
+            }
+            if (hdc) DeleteDC(hdc);
+            if (hfont) DeleteObject(hfont);
+            if (*font) hr = S_OK;
+        }
         goto done;
     }
 
