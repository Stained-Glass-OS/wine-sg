From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: a locale's sort lookup may re-enter

The first time a locale's sort is needed, kernelbase reads its id from the
registry. App-V's virtual registry (Click-to-Run Office) hooks the registry
and lower-cases key names with LCMapString, which asks for the same sort
before it is known: the lookup recursed until the stack ran out (Word, at
"Sign in" on its older sign-in).

The lookup is serialized; a nested call on the same thread gets the default
sort, uncached, and the outer call finds and keeps the locale's own.

--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -433,6 +433,16 @@
 };
 static CRITICAL_SECTION locale_section = { &critsect_debug, -1, 0, 0, 0, 0 };
 
+/* guards the lookup of a locale's sort, which can re-enter (get_language_sort) */
+static CRITICAL_SECTION sort_section;
+static CRITICAL_SECTION_DEBUG sort_section_debug =
+{
+    0, 0, &sort_section,
+    { &sort_section_debug.ProcessLocksList, &sort_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": sort_section") }
+};
+static CRITICAL_SECTION sort_section = { &sort_section_debug, -1, 0, 0, 0, 0 };
+
 
 static void load_locale_nls(void)
 {
@@ -689,6 +699,19 @@
     }
     if ((ret = locale_sorts[entry - lcnames_index])) return ret;
 
+    /* The lookup reads the registry, and a hook on the registry may map
+     * strings on the way -- App-V's virtual registry (Click-to-Run Office)
+     * lower-cases key names with LCMapString -- and so ask for a sort again
+     * before this one is known. The nested call gets the default sort,
+     * uncached, instead of recursing until the stack runs out. */
+    if (sort_section.OwningThread == ULongToHandle( GetCurrentThreadId() )) return &sort.guids[0];
+    RtlEnterCriticalSection( &sort_section );
+    if ((ret = locale_sorts[entry - lcnames_index]))
+    {
+        RtlLeaveCriticalSection( &sort_section );
+        return ret;
+    }
+
     lcid = entry->id;
     name = locale_strings + entry->name + 1;
     locale = get_locale_data( entry->idx );
@@ -711,6 +734,7 @@
     }
     if (!ret) ret = &sort.guids[0];
     locale_sorts[entry - lcnames_index] = ret;
+    RtlLeaveCriticalSection( &sort_section );
     return ret;
 }
 
