From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: File Access Denied names the item (5969)

Deleting (or renaming) an item in a folder the user may not change asks
for an administrator; the dialog showed the folder ("C:\users\Public\Desktop").
Windows names the item: its icon, name, type and date modified, and says
"delete this file" / "this folder". One item is named so; several show
their folder, as before. Gate test/fileopadmin-gate.sh (mutant
DENIED_FOLDER_ONLY).
---
--- a/dlls/shell32/fileopdlg.c
+++ b/dlls/shell32/fileopdlg.c
@@ -750,9 +750,48 @@
 {
     HFONT font, big;
     const WCHAR *heading, *what, *dir;
+    HICON icon;  /* the item's, when one item is deleted or renamed */
     int result;
 };
 
+/* the item a delete or rename is denied for, as Windows names it: its icon, name, type
+ * and date in static controls (IDs 200-202) under the question */
+static void denied_item(HWND hwnd, struct denied *d, const WCHAR *item, int w)
+{
+    SHFILEINFOW sfi = { 0 };
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+    WCHAR text[MAX_PATH + 64], date[64], time[64];
+    FILETIME local;
+    SYSTEMTIME st;
+    const WCHAR *lines[3];
+    int i, n = 0;
+
+    SHGetFileInfoW(item, 0, &sfi, sizeof(sfi), SHGFI_ICON | SHGFI_LARGEICON | SHGFI_DISPLAYNAME | SHGFI_TYPENAME);
+    d->icon = sfi.hIcon;
+    lines[n++] = sfi.szDisplayName[0] ? sfi.szDisplayName : PathFindFileNameW(item);
+    if (sfi.szTypeName[0])
+    {
+        swprintf(text, ARRAY_SIZE(text), L"Type: %s", sfi.szTypeName);
+        lines[n++] = wcsdup(text);
+    }
+    if (GetFileAttributesExW(item, GetFileExInfoStandard, &fad) &&
+        FileTimeToLocalFileTime(&fad.ftLastWriteTime, &local) && FileTimeToSystemTime(&local, &st))
+    {
+        GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, date, ARRAY_SIZE(date));
+        GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, time, ARRAY_SIZE(time));
+        swprintf(text, ARRAY_SIZE(text), L"Date modified: %s %s", date, time);
+        lines[n++] = wcsdup(text);
+    }
+    for (i = 0; i < n; i++)
+    {
+        HWND c = CreateWindowExW(0, L"Static", lines[i], WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOPREFIX | SS_ENDELLIPSIS,
+                                 scale(112), scale(104) + i * scale(20), w - scale(132), scale(20), hwnd,
+                                 (HMENU)(INT_PTR)(200 + i), shell32_hInstance, NULL);
+        SendMessageW(c, WM_SETFONT, (WPARAM)d->font, FALSE);
+        if (i) free((void *)lines[i]);
+    }
+}
+
 static LRESULT CALLBACK denied_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
     struct denied *d = (struct denied *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
@@ -790,13 +829,22 @@
         OffsetRect(&rc, 0, scale(44));
         rc.bottom = rc.top + scale(40);
         DrawTextW(hdc, d->what, -1, &rc, DT_WORDBREAK);
-        SetTextColor(hdc, C_MUTED);
-        OffsetRect(&rc, 0, scale(44));
-        rc.bottom = rc.top + scale(20);
-        DrawTextW(hdc, d->dir, -1, &rc, DT_SINGLELINE | DT_PATH_ELLIPSIS);
+        if (d->icon) DrawIconEx(hdc, scale(64), scale(106), d->icon, scale(32), scale(32), 0, NULL, DI_NORMAL);
+        else
+        {
+            SetTextColor(hdc, C_MUTED);
+            OffsetRect(&rc, 0, scale(44));
+            rc.bottom = rc.top + scale(20);
+            DrawTextW(hdc, d->dir, -1, &rc, DT_SINGLELINE | DT_PATH_ELLIPSIS);
+        }
         EndPaint(hwnd, &ps);
         return 0;
     }
+    case WM_CTLCOLORSTATIC:
+    case WM_CTLCOLORBTN:
+        SetBkColor((HDC)wp, C_BG);
+        SetTextColor((HDC)wp, C_TEXT);
+        return (LRESULT)GetStockObject(WHITE_BRUSH);
     case WM_COMMAND:
         if (LOWORD(wp) == IDOK || LOWORD(wp) == IDCANCEL) d->result = LOWORD(wp);
         return 0;
@@ -808,7 +856,7 @@
 }
 
 /* TRUE to go on as an administrator */
-BOOL fileop_access_denied(HWND owner, UINT func, const WCHAR *dir)
+BOOL fileop_access_denied(HWND owner, UINT func, const WCHAR *dir, const WCHAR *item)
 {
     struct denied d = { 0 };
     WNDCLASSW wc = { 0 };
@@ -837,6 +885,21 @@
         break;
     }
     d.dir = dir;
+#ifdef SG_MUTANT_DENIED_FOLDER_ONLY
+    item = NULL;
+#endif
+    if (item && (func == FO_DELETE || func == FO_RENAME))
+    {
+        BOOL folder = PathIsDirectoryW(item);
+        if (func == FO_DELETE)
+            d.what = folder ? L"You'll need to provide administrator permission to delete this folder."
+                            : L"You'll need to provide administrator permission to delete this file.";
+        else
+            d.what = folder ? L"You'll need to provide administrator permission to rename this folder."
+                            : L"You'll need to provide administrator permission to rename this file.";
+        h += scale(48);
+    }
+    else item = NULL;
 
     wc.lpfnWndProc = denied_proc;
     wc.hInstance = shell32_hInstance;
@@ -863,6 +926,7 @@
                              w - scale(20) - scale(88), h - scale(16) - scale(28), scale(88), scale(28), hwnd,
                              (HMENU)IDCANCEL, shell32_hInstance, NULL);
     SendMessageW(button, WM_SETFONT, (WPARAM)d.font, FALSE);
+    if (item) denied_item(hwnd, &d, item, w);
 
     if (owner) EnableWindow(owner, FALSE);
     ShowWindow(hwnd, SW_SHOWNORMAL);
@@ -878,5 +942,6 @@
     DestroyWindow(hwnd);
     DeleteObject(d.font);
     DeleteObject(d.big);
+    if (d.icon) DestroyIcon(d.icon);
     return d.result == IDOK;
 }
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1966,8 +1966,11 @@
 
     if (!(lpFileOp->fFlags & FOF_NOERRORUI) && fileop_denied_dir(lpFileOp, denied) && !process_elevated())
     {
+        const WCHAR *item = lpFileOp->pFrom;
+        /* one item: the dialog names it; several: their folder */
+        if (item && item[lstrlenW(item) + 1]) item = NULL;
         lpFileOp->fAnyOperationsAborted = FALSE;
-        if (!fileop_access_denied(lpFileOp->hwnd, lpFileOp->wFunc & FO_MASK, denied))
+        if (!fileop_access_denied(lpFileOp->hwnd, lpFileOp->wFunc & FO_MASK, denied, item))
         {
             lpFileOp->fAnyOperationsAborted = TRUE;
             return ERROR_CANCELLED;
