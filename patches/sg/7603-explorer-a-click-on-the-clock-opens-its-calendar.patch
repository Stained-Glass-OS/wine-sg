From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a click on the clock opens its calendar (7603)

As on Windows: a click on the taskbar clock opens the calendar flyout
(sg-shell's sg-calendar, SgCalendarToggle to SgCalendarHost, or started
with --show when none runs); a second click closes it.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3837,6 +3837,24 @@
     }
 }
 
+/* Stained Glass OS 7603: the clock's calendar, as Windows' (David 2026-10-28):
+ * sg-shell's sg-calendar, which the session keeps running hidden, opens or
+ * closes on SgCalendarToggle; when none runs yet it is started to show. The
+ * flyout may take the foreground: the click was the person's. */
+static void sg_toggle_calendar(void)
+{
+    static UINT toggle;
+    HWND host;
+
+#ifdef SG_MUTANT_CLOCK_NO_CALENDAR
+    return;
+#endif
+    if (!toggle) toggle = RegisterWindowMessageW( L"SgCalendarToggle" );
+    AllowSetForegroundWindow( ASFW_ANY );
+    if ((host = FindWindowW( L"SgCalendarHost", NULL ))) PostMessageW( host, toggle, 0, 0 );
+    else ShellExecuteW( NULL, NULL, L"Z:\\usr\\libexec\\stained-glass\\shell\\sg-calendar64.exe", L"--show", NULL, SW_SHOWNORMAL );
+}
+
 /* Stained Glass OS: the taskbar clock -- time over date, right-aligned;
  * the time alone with small buttons; centred on a vertical bar. */
 static void sg_draw_clock( HDC hdc, const RECT *rect )
@@ -5885,6 +5903,19 @@
             click_taskbar_button( (HWND)lparam );
         break;
 
+    case WM_LBUTTONUP:
+    {
+        /* Stained Glass OS 7603: a click on the clock opens its calendar */
+        RECT rc;
+        POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+
+        GetClientRect( hwnd, &rc );
+        if (sg_vertical()) rc.top = rc.bottom - sg_clock_len();
+        else rc.left = rc.right - sg_clock_len();
+        if (PtInRect( &rc, pt )) sg_toggle_calendar();
+        break;
+    }
+
     case WM_CONTEXTMENU:
         show_taskbar_contextmenu( (HWND)wparam, lparam );
         break;
