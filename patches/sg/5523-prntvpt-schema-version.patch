From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] prntvpt: PTQuerySchemaVersionSupport reports Print Schema version 1

The function returned E_NOTIMPL, so callers could not learn which Print
Schema version to ask PTOpenProvider for. The documentation says the first
version of the Print Schema is 1 and the function returns the highest
supported one: this implementation supports only 1. A NULL printer or output
is E_INVALIDARG, a print queue that cannot be opened gives that error, and
the output is untouched on failure. The prototype joins prntvpt.h.
---
--- a/dlls/prntvpt/main.c
+++ b/dlls/prntvpt/main.c
@@ -40,8 +40,19 @@ HRESULT WINAPI PTReleaseMemory(PVOID mem)
 
 HRESULT WINAPI PTQuerySchemaVersionSupport(PCWSTR printer, DWORD *version)
 {
-    FIXME("stub:%s %p\n", debugstr_w(printer), version);
-    return E_NOTIMPL;
+    HANDLE hprn;
+
+    TRACE("%s %p\n", debugstr_w(printer), version);
+
+#ifndef SG_MUTANT_PTQSV_NOCHECK
+    if (!printer || !version) return E_INVALIDARG;
+#endif
+    if (!OpenPrinterW((WCHAR *)printer, &hprn, NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    ClosePrinter(hprn);
+
+    /* the first version of the Print Schema is 1, and it is the only one */
+    *version = 1;
+    return S_OK;
 }
 
 HRESULT WINAPI PTCloseProvider(HPTPROVIDER provider)
--- a/dlls/prntvpt/tests/prntvpt.c
+++ b/dlls/prntvpt/tests/prntvpt.c
@@ -126,12 +126,41 @@ static void test_PTOpenProviderEx(void)
     }
 }
 
+static void test_PTQuerySchemaVersionSupport_args(void)
+{
+    DWORD version = 0xdeadbeef;
+    HRESULT hr;
+
+    hr = PTQuerySchemaVersionSupport(NULL, &version);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = PTQuerySchemaVersionSupport(L"no such printer queue", NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+}
+
+static void test_PTQuerySchemaVersionSupport(void)
+{
+    DWORD version;
+    HRESULT hr;
+
+    version = 0xdeadbeef;
+    hr = PTQuerySchemaVersionSupport(default_name, &version);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(version == 1, "got version %lu\n", version);
+
+    version = 0xdeadbeef;
+    hr = PTQuerySchemaVersionSupport(L"no such printer queue", &version);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    ok(version == 0xdeadbeef, "version modified: %lu\n", version);
+}
+
 START_TEST(prntvpt)
 {
     DWORD size;
 
     CoInitializeEx(NULL, COINIT_MULTITHREADED);
 
+    test_PTQuerySchemaVersionSupport_args();
+
     size = ARRAY_SIZE(default_name);
     if (!GetDefaultPrinterW(default_name, &size))
     {
@@ -141,6 +170,7 @@ START_TEST(prntvpt)
 
     trace("default printer: %s\n", wine_dbgstr_w(default_name));
 
+    test_PTQuerySchemaVersionSupport();
     test_PTOpenProvider();
     test_PTOpenProviderEx();
 
--- a/include/prntvpt.h
+++ b/include/prntvpt.h
@@ -45,6 +45,7 @@ typedef enum
 HRESULT WINAPI PTOpenProvider(const WCHAR *printer, DWORD version, HPTPROVIDER *provider);
 HRESULT WINAPI PTOpenProviderEx(const WCHAR *printer, DWORD max_version, DWORD pref_version, HPTPROVIDER *provider, DWORD *used_version);
 HRESULT WINAPI PTCloseProvider(HPTPROVIDER);
+HRESULT WINAPI PTQuerySchemaVersionSupport(PCWSTR printer, DWORD *max_version);
 HRESULT WINAPI PTConvertDevModeToPrintTicket(HPTPROVIDER, ULONG, PDEVMODEW, EPrintTicketScope, IStream *);
 HRESULT WINAPI PTConvertPrintTicketToDevMode(HPTPROVIDER, IStream *, EDefaultDevmodeType, EPrintTicketScope, ULONG *, PDEVMODEW *, BSTR *);
 HRESULT WINAPI PTGetPrintCapabilities(HPTPROVIDER, IStream *, IStream *, BSTR *);
