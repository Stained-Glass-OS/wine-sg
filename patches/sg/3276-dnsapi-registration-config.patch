From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:55:55 -0700
Subject: [PATCH] dnsapi: DnsQueryConfig registration settings (3276)

DnsConfigPrimaryHostNameRegistrationEnabled, DnsConfigAdapterHostNameRegistrationEnabled and DnsConfigAddressRegistrationMaxCount return a DWORD (1, 1, 1: GUESS, the values are not documented); ERROR_INSUFFICIENT_BUFFER with the size for a short buffer. The adapter domain name and adapter info types stay unimplemented as documented.

diff --git a/dlls/dnsapi/query.c b/dlls/dnsapi/query.c
index d1e3d92..cdae8e9 100644
--- a/dlls/dnsapi/query.c
+++ b/dlls/dnsapi/query.c
@@ -599,13 +599,27 @@ DNS_STATUS WINAPI DnsQueryConfig( DNS_CONFIG_TYPE config, DWORD flag, const WCHA
     case DnsConfigPrimaryDomainName_W:
         return get_hostname_w( ComputerNameDnsDomain, buffer, len );
 
+    case DnsConfigPrimaryHostNameRegistrationEnabled:
+    case DnsConfigAdapterHostNameRegistrationEnabled:
+    case DnsConfigAddressRegistrationMaxCount:
+        /* a DWORD; GUESS: registration is on, one address per name (the values are not documented) */
+#ifdef SG_MUTANT_DNSAPI
+        break;
+#endif
+        if (!buffer || *len < sizeof(DWORD))
+        {
+            *len = sizeof(DWORD);
+            return ERROR_INSUFFICIENT_BUFFER;
+        }
+        *(DWORD *)buffer = 1;
+        *len = sizeof(DWORD);
+        return ERROR_SUCCESS;
+
     case DnsConfigAdapterDomainName_A:
     case DnsConfigAdapterDomainName_W:
     case DnsConfigAdapterDomainName_UTF8:
     case DnsConfigAdapterInfo:
-    case DnsConfigPrimaryHostNameRegistrationEnabled:
-    case DnsConfigAdapterHostNameRegistrationEnabled:
-    case DnsConfigAddressRegistrationMaxCount:
+        /* documented as not implemented */
         FIXME( "unimplemented config type %d\n", config );
         break;
 
