+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "d3dxof_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3dxof);
+
+#define TOKEN_NAME        1
+#define TOKEN_WORD        40
+#define TOKEN_DWORD       41
+#define TOKEN_FLOAT       42
+#define TOKEN_DOUBLE      43
+#define TOKEN_CHAR        44
+#define TOKEN_UCHAR       45
+#define TOKEN_SWORD       46
+#define TOKEN_SDWORD      47
+#define TOKEN_LPSTR       49
+
+struct tb
+{
+    char *data;
+    size_t len, cap;
+    BOOL fail;
+};
+
+static void tb_put(struct tb *b, const char *s, size_t n)
+{
+    if (b->fail) return;
+    if (b->len + n + 1 > b->cap)
+    {
+        size_t cap = max(b->cap * 2, b->len + n + 256);
+        char *p = realloc(b->data, cap);
+        if (!p) { b->fail = TRUE; return; }
+        b->data = p;
+        b->cap = cap;
+    }
+    memcpy(b->data + b->len, s, n);
+    b->len += n;
+    b->data[b->len] = 0;
+}
+
+static void tb_printf(struct tb *b, const char *fmt, ...)
+{
+    char tmp[512];
+    va_list args;
+    int n;
+
+    va_start(args, fmt);
+    n = vsnprintf(tmp, sizeof(tmp), fmt, args);
+    va_end(args);
+    if (n < 0 || n >= (int)sizeof(tmp)) { b->fail = TRUE; return; }
+    tb_put(b, tmp, n);
+}
+
+static void tb_guid(struct tb *b, const GUID *g)
+{
+    tb_printf(b, "<%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x>", g->Data1, g->Data2, g->Data3,
+            g->Data4[0], g->Data4[1], g->Data4[2], g->Data4[3], g->Data4[4], g->Data4[5], g->Data4[6], g->Data4[7]);
+}
+
+static void tb_indent(struct tb *b, int level)
+{
+    tb_put(b, "\r\n", 2);
+    while (level-- > 0) tb_put(b, " ", 1);
+}
+
+static const char *type_keyword(DWORD token)
+{
+    switch (token)
+    {
+    case TOKEN_WORD: return "WORD";
+    case TOKEN_DWORD: return "DWORD";
+    case TOKEN_FLOAT: return "FLOAT";
+    case TOKEN_DOUBLE: return "DOUBLE";
+    case TOKEN_CHAR: return "CHAR";
+    case TOKEN_UCHAR: return "UCHAR";
+    case TOKEN_SWORD: return "SWORD";
+    case TOKEN_SDWORD: return "SDWORD";
+    case TOKEN_LPSTR: return "STRING";
+    }
+    return NULL;
+}
+
+static const xtemplate *find_template_by_guid(const IDirectXFileImpl *dxf, const GUID *guid)
+{
+    ULONG i;
+
+    for (i = 1; i < dxf->nb_xtemplates; i++)
+        if (IsEqualGUID(&dxf->xtemplates[i].class_id, guid)) return &dxf->xtemplates[i];
+    return NULL;
+}
+
+/* ---- templates ---- */
+
+static void write_template(const IDirectXFileImpl *dxf, const xtemplate *t, struct tb *out)
+{
+    ULONG i, d;
+
+    tb_printf(out, "template %s {\r\n ", t->name);
+    tb_guid(out, &t->class_id);
+    tb_put(out, "\r\n", 2);
+    for (i = 0; i < t->nb_members; i++)
+    {
+        const member *m = &t->members[i];
+        const char *type = m->type == TOKEN_NAME ? dxf->xtemplates[m->idx_template].name : type_keyword(m->type);
+
+        tb_put(out, " ", 1);
+        if (m->nb_dims) tb_put(out, "array ", 6);
+        tb_printf(out, "%s %s", type ? type : "VOID", m->name);
+        for (d = 0; d < m->nb_dims; d++)
+        {
+            if (m->dim_fixed[d]) tb_printf(out, "[%lu]", m->dim_value[d]);
+            else tb_printf(out, "[%s]", t->members[m->dim_value[d]].name);
+        }
+        tb_put(out, ";\r\n", 3);
+    }
+    if (t->open) tb_put(out, " [...]\r\n", 8);
+    else if (t->nb_children)
+    {
+        tb_put(out, " [", 2);
+        for (i = 0; i < t->nb_children; i++)
+            tb_printf(out, "%s%s", i ? "," : "", t->children[i]);
+        tb_put(out, "]\r\n", 3);
+    }
+    tb_put(out, "}\r\n\r\n", 5);
+}
+
+/* ---- walking object data through its template ---- */
+
+struct walk
+{
+    const IDirectXFileImpl *dxf;
+    const BYTE *data;
+    DWORD size, pos;
+    struct tb *out;          /* NULL: only measure */
+    BYTE *fixed;             /* same layout as data, strings replaced by copies in the arena */
+    char *arena;
+    DWORD strbytes;
+    xobject *record;         /* fills the top-level member offsets */
+    BOOL bad;
+};
+
+static DWORD prim_size(DWORD type)
+{
+    switch (type)
+    {
+    case TOKEN_WORD: case TOKEN_SWORD: return 2;
+    case TOKEN_DWORD: case TOKEN_SDWORD: case TOKEN_FLOAT: return 4;
+    case TOKEN_DOUBLE: return 8;
+    case TOKEN_CHAR: case TOKEN_UCHAR: return 1;
+    case TOKEN_LPSTR: return sizeof(char *);
+    }
+    return 0;
+}
+
+static void walk_struct(struct walk *w, const xtemplate *t, int indent, BOOL top);
+
+static void walk_prim(struct walk *w, const member *m)
+{
+    DWORD size = prim_size(m->type);
+    const BYTE *p = w->data + w->pos;
+
+    if (!size || w->pos + size > w->size) { w->bad = TRUE; return; }
+
+    switch (m->type)
+    {
+    case TOKEN_WORD: if (w->out) tb_printf(w->out, "%u", *(const WORD *)p); break;
+    case TOKEN_SWORD: if (w->out) tb_printf(w->out, "%d", *(const SHORT *)p); break;
+    case TOKEN_DWORD: if (w->out) tb_printf(w->out, "%lu", *(const DWORD *)p); break;
+    case TOKEN_SDWORD: if (w->out) tb_printf(w->out, "%ld", *(const LONG *)p); break;
+    case TOKEN_FLOAT: if (w->out) tb_printf(w->out, "%f", *(const float *)p); break;
+    case TOKEN_DOUBLE: if (w->out) tb_printf(w->out, "%f", *(const double *)p); break;
+    case TOKEN_CHAR: if (w->out) tb_printf(w->out, "%d", *(const signed char *)p); break;
+    case TOKEN_UCHAR: if (w->out) tb_printf(w->out, "%u", *p); break;
+    case TOKEN_LPSTR:
+    {
+        const char *s = *(const char *const *)p;
+        size_t len = s ? strlen(s) : 0;
+
+        if (w->out) tb_printf(w->out, "\"%s\"", s ? s : "");
+        if (w->fixed)
+        {
+            char *copy = w->arena + w->strbytes;
+
+            memcpy(copy, s ? s : "", len + 1);
+#ifndef SG_MUTANT_XOF_NOSTRCOPY
+            *(char **)(w->fixed + w->pos) = copy;
+#endif
+        }
+        w->strbytes += len + 1;
+        break;
+    }
+    }
+    w->pos += size;
+}
+
+static void walk_element(struct walk *w, const member *m, int indent)
+{
+    if (m->type == TOKEN_NAME) walk_struct(w, &w->dxf->xtemplates[m->idx_template], indent, FALSE);
+    else walk_prim(w, m);
+}
+
+static void walk_struct(struct walk *w, const xtemplate *t, int indent, BOOL top)
+{
+    DWORD vals[MAX_MEMBERS] = {0};
+    ULONG i, d;
+
+    for (i = 0; i < t->nb_members && !w->bad; i++)
+    {
+        const member *m = &t->members[i];
+        DWORD start = w->pos;
+
+        if (top && w->out && !(m->nb_dims && m->type == TOKEN_NAME)) tb_indent(w->out, indent);
+
+        if (!m->nb_dims)
+        {
+            if (m->type == TOKEN_DWORD && w->pos + 4 <= w->size) vals[i] = *(const DWORD *)(w->data + w->pos);
+            walk_element(w, m, indent);
+            if (w->out) tb_put(w->out, ";", 1);
+        }
+        else
+        {
+            DWORD count = 1, k;
+
+            for (d = 0; d < m->nb_dims; d++)
+                count *= m->dim_fixed[d] ? m->dim_value[d] : vals[m->dim_value[d]];
+            if (count > w->size) { w->bad = TRUE; break; }
+            for (k = 0; k < count && !w->bad; k++)
+            {
+                if (w->out && m->type == TOKEN_NAME) tb_indent(w->out, indent + 1);
+                walk_element(w, m, indent + 1);
+                if (w->out) tb_put(w->out,
+#ifdef SG_MUTANT_XOF_SEP
+                    ";",
+#else
+                    k == count - 1 ? ";" : ",",
+#endif
+                    1);
+            }
+            if (!count && w->out) tb_put(w->out, ";", 1);
+        }
+
+        if (top && w->record && i < MAX_MEMBERS)
+        {
+            w->record->members[i].name = (char *)m->name;
+            w->record->members[i].start = start;
+            w->record->members[i].size = w->pos - start;
+        }
+    }
+}
+
+/* ---- objects ---- */
+
+static void write_object(const IDirectXFileImpl *dxf, const xobject *obj, struct tb *out, int indent, HRESULT *hr);
+
+static void write_object_children(const IDirectXFileImpl *dxf, const xobject *obj, struct tb *out, int indent,
+        HRESULT *hr)
+{
+    ULONG i;
+
+    for (i = 0; i < obj->nb_children && SUCCEEDED(*hr); i++)
+    {
+        const xobject *child = obj->children[i];
+
+        if (child->binary) continue;
+        if (child->ptarget)
+        {
+            tb_indent(out, indent);
+            tb_put(out, "{", 1);
+            if (child->ptarget->name[0]) tb_printf(out, " %s", child->ptarget->name);
+            if (!IsEqualGUID(&child->ptarget->class_id, &GUID_NULL))
+            {
+                tb_put(out, " ", 1);
+                tb_guid(out, &child->ptarget->class_id);
+            }
+            tb_put(out, " }", 2);
+        }
+        else
+            write_object(dxf, child, out, indent, hr);
+    }
+}
+
+static void write_object(const IDirectXFileImpl *dxf, const xobject *obj, struct tb *out, int indent, HRESULT *hr)
+{
+    const xtemplate *t = find_template_by_guid(dxf, &obj->type);
+    struct walk w = {0};
+
+    if (!t) { *hr = DXFILEERR_NOTEMPLATE; return; }
+
+    tb_indent(out, indent);
+    tb_printf(out, "%s", t->name);
+    if (obj->name[0]) tb_printf(out, " %s", obj->name);
+    tb_put(out, " {", 2);
+    if (!IsEqualGUID(&obj->class_id, &GUID_NULL))
+    {
+        tb_indent(out, indent + 1);
+        tb_guid(out, &obj->class_id);
+    }
+
+    w.dxf = dxf;
+    w.data = obj->root->pdata + obj->pos_data;
+    w.size = obj->size;
+    w.out = out;
+    walk_struct(&w, t, indent + 1, TRUE);
+    if (w.bad) { *hr = DXFILEERR_BADVALUE; return; }
+
+    write_object_children(dxf, obj, out, indent + 1, hr);
+    tb_indent(out, indent);
+    tb_put(out, "}", 1);
+    if (!indent) tb_put(out, "\r\n", 2);
+}
+
+/* ---- the save object ---- */
+
+HRESULT save_object_create(IDirectXFileImpl *dxf, const char *filename, DXFILEFORMAT format,
+        IDirectXFileSaveObjectImpl **out)
+{
+    IDirectXFileSaveObjectImpl *object;
+
+    if (format != DXFILEFORMAT_TEXT)
+    {
+        FIXME("Format %lu not supported, only text files can be written.\n", format);
+        return DXFILEERR_NOTDONEYET;
+    }
+
+    if (!(object = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*object))))
+        return DXFILEERR_BADALLOC;
+
+    object->file = CreateFileA(filename, GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS,
+            FILE_ATTRIBUTE_NORMAL, NULL);
+    if (object->file == INVALID_HANDLE_VALUE)
+    {
+        WARN("Cannot create %s, error %lu.\n", debugstr_a(filename), GetLastError());
+        HeapFree(GetProcessHeap(), 0, object);
+        return DXFILEERR_BADFILE;
+    }
+
+    object->IDirectXFileSaveObject_iface.lpVtbl = &IDirectXFileSaveObject_Vtbl;
+    object->ref = 1;
+    object->dxf = dxf;
+    IDirectXFile_AddRef(&dxf->IDirectXFile_iface);
+    *out = object;
+    return S_OK;
+}
+
+void save_object_destroy(IDirectXFileSaveObjectImpl *object)
+{
+    CloseHandle(object->file);
+    IDirectXFile_Release(&object->dxf->IDirectXFile_iface);
+    HeapFree(GetProcessHeap(), 0, object);
+}
+
+static HRESULT save_write(IDirectXFileSaveObjectImpl *object, struct tb *text)
+{
+    static const char header[] = "xof 0303txt 0032\r\n\r\n";
+    DWORD written;
+
+    if (text->fail) return DXFILEERR_BADALLOC;
+    if (!object->header_written)
+    {
+        if (!WriteFile(object->file, header, sizeof(header) - 1, &written, NULL)) return DXFILEERR_BADFILE;
+        object->header_written = TRUE;
+    }
+    if (!WriteFile(object->file, text->data, text->len, &written, NULL) || written != text->len)
+        return DXFILEERR_BADFILE;
+    return DXFILE_OK;
+}
+
+HRESULT save_templates(IDirectXFileSaveObjectImpl *object, DWORD count, const GUID **guids)
+{
+    struct tb text = {0};
+    const xtemplate *t;
+    HRESULT hr;
+    DWORD i;
+
+    if (count && !guids) return DXFILEERR_BADVALUE;
+
+    for (i = 0; i < count; i++)
+    {
+        if (!guids[i]) { free(text.data); return DXFILEERR_BADVALUE; }
+        if (!(t = find_template_by_guid(object->dxf, guids[i])))
+        {
+            WARN("Template %s is not registered.\n", debugstr_guid(guids[i]));
+            free(text.data);
+            return DXFILEERR_NOTEMPLATE;
+        }
+        write_template(object->dxf, t, &text);
+    }
+    hr = save_write(object, &text);
+    free(text.data);
+    return hr;
+}
+
+HRESULT save_create_data_object(IDirectXFileSaveObjectImpl *object, REFGUID template, const char *name,
+        const GUID *guid, DWORD size, void *data, IDirectXFileData **out)
+{
+    IDirectXFileDataImpl *impl;
+    const xtemplate *t;
+    struct walk w = {0};
+    xobject *obj;
+    HRESULT hr;
+
+    if (!out) return DXFILEERR_BADVALUE;
+    *out = NULL;
+    if (!template || (size && !data)) return DXFILEERR_BADVALUE;
+    if (name && strlen(name) >= MAX_NAME_LEN) return DXFILEERR_BADVALUE;
+    if (!(t = find_template_by_guid(object->dxf, template))) return DXFILEERR_NOTEMPLATE;
+
+    w.dxf = object->dxf;
+    w.data = data;
+    w.size = size;
+    walk_struct(&w, t, 0, TRUE);
+    if (w.bad)
+    {
+        WARN("Data does not fit template %s.\n", t->name);
+        return DXFILEERR_BADVALUE;
+    }
+
+    if (FAILED(hr = IDirectXFileDataImpl_Create(&impl))) return hr;
+    obj = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*obj));
+    if (!obj)
+    {
+        IDirectXFileData_Release(&impl->IDirectXFileData_iface);
+        return DXFILEERR_BADALLOC;
+    }
+    impl->pobj = obj;
+
+    obj->pdata = HeapAlloc(GetProcessHeap(), 0, max(w.pos, 1));
+    impl->pstrings = HeapAlloc(GetProcessHeap(), 0, max(w.strbytes, 1));
+    if (!obj->pdata || !impl->pstrings)
+    {
+        IDirectXFileData_Release(&impl->IDirectXFileData_iface);
+        return DXFILEERR_BADALLOC;
+    }
+    memcpy(obj->pdata, data, w.pos);
+
+    /* second pass: own copies of the strings, and the member offsets */
+    memset(&w, 0, sizeof(w));
+    w.dxf = object->dxf;
+    w.data = obj->pdata;
+    w.size = size;
+    w.fixed = obj->pdata;
+    w.arena = (char *)impl->pstrings;
+    w.record = obj;
+    {
+        BYTE *copy = HeapAlloc(GetProcessHeap(), 0, max(size, 1));
+        if (!copy)
+        {
+            IDirectXFileData_Release(&impl->IDirectXFileData_iface);
+            return DXFILEERR_BADALLOC;
+        }
+        memcpy(copy, data, size);
+        w.data = copy;
+        walk_struct(&w, t, 0, TRUE);
+        HeapFree(GetProcessHeap(), 0, copy);
+    }
+    obj->nb_members = t->nb_members;
+
+    if (name) strcpy(obj->name, name);
+    if (guid) obj->class_id = *guid;
+    obj->type = t->class_id;
+    obj->root = obj;
+    obj->pos_data = 0;
+    obj->size = w.pos;
+    obj->nb_subobjects = 1;
+    impl->level = 0;
+    impl->from_ref = FALSE;
+
+    *out = &impl->IDirectXFileData_iface;
+    return DXFILE_OK;
+}
+
+HRESULT save_data(IDirectXFileSaveObjectImpl *object, IDirectXFileData *data)
+{
+    IDirectXFileDataImpl *impl;
+    struct tb text = {0};
+    HRESULT hr = DXFILE_OK;
+
+    if (!data) return DXFILEERR_BADVALUE;
+    impl = CONTAINING_RECORD(data, IDirectXFileDataImpl, IDirectXFileData_iface);
+    if (!impl->pobj) return DXFILEERR_BADOBJECT;
+
+    write_object(object->dxf, impl->pobj, &text, 0, &hr);
+    if (SUCCEEDED(hr)) hr = save_write(object, &text);
+    free(text.data);
+    return hr;
+}
+
+HRESULT data_add_object(IDirectXFileDataImpl *parent, IDirectXFileData *child)
+{
+    IDirectXFileDataImpl *impl;
+    IDirectXFileData **slot;
+
+    if (!child || !parent->pobj) return DXFILEERR_BADVALUE;
+    impl = CONTAINING_RECORD(child, IDirectXFileDataImpl, IDirectXFileData_iface);
+    if (impl == parent || !impl->pobj) return DXFILEERR_BADVALUE;
+    if (parent->pobj->nb_children >= MAX_CHILDREN) return DXFILEERR_BADALLOC;
+
+    slot = realloc(parent->added, (parent->nb_added + 1) * sizeof(*slot));
+    if (!slot) return DXFILEERR_BADALLOC;
+    parent->added = slot;
+    IDirectXFileData_AddRef(child);
+    parent->added[parent->nb_added++] = child;
+    parent->pobj->children[parent->pobj->nb_children++] = impl->pobj;
+    return DXFILE_OK;
+}
+
+HRESULT data_add_reference(IDirectXFileDataImpl *parent, const char *name, const GUID *guid)
+{
+    xobject *target, *ref, **list;
+
+    if (!parent->pobj || (!name && !guid)) return DXFILEERR_BADVALUE;
+    if (name && strlen(name) >= MAX_NAME_LEN) return DXFILEERR_BADVALUE;
+    if (parent->pobj->nb_children >= MAX_CHILDREN) return DXFILEERR_BADALLOC;
+
+    /* a reference is a child that points at a placeholder carrying the name and id */
+    target = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*target));
+    ref = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*ref));
+    list = realloc(parent->ref_objs, (parent->nb_ref_objs + 2) * sizeof(*list));
+    if (!target || !ref || !list)
+    {
+        HeapFree(GetProcessHeap(), 0, target);
+        HeapFree(GetProcessHeap(), 0, ref);
+        if (list) parent->ref_objs = list;
+        return DXFILEERR_BADALLOC;
+    }
+    parent->ref_objs = list;
+    parent->ref_objs[parent->nb_ref_objs++] = target;
+    parent->ref_objs[parent->nb_ref_objs++] = ref;
+
+    if (name) strcpy(target->name, name);
+    if (guid) target->class_id = *guid;
+    target->root = target;
+    ref->ptarget = target;
+    ref->root = ref;
+    parent->pobj->children[parent->pobj->nb_children++] = ref;
+    return DXFILE_OK;
+}
+
+void data_free_owned(IDirectXFileDataImpl *data)
+{
+    ULONG i;
+
+    for (i = 0; i < data->nb_added; i++) IDirectXFileData_Release(data->added[i]);
+    for (i = 0; i < data->nb_ref_objs; i++) HeapFree(GetProcessHeap(), 0, data->ref_objs[i]);
+    free(data->added);
+    free(data->ref_objs);
+}
