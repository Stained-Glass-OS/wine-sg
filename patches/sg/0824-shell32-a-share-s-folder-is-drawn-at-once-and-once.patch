             return FALSE;
+
+#ifndef SG_MUTANT_REMOTE_DESKTOP_INI
+        /* Stained Glass OS: a folder on a network share is customized by a
+         * desktop.ini only when it is marked read-only or system, the rule
+         * Windows follows everywhere: the file server says which folders are
+         * (wine-sg 0822 gives the server's attributes). Looking for a
+         * desktop.ini in every folder shown meant listing each one over the
+         * network, a folder at a time, as File Explorer drew the list (David:
+         * a share's icons were drawn slowly, then again). Wine's own disks keep
+         * no such attributes, so they are looked in as before. */
+        if (folder_is_remote(wszFolderPath) &&
+            !(_ILGetFileAttributes(ILFindLastID(pidl), NULL, 0) & (FILE_ATTRIBUTE_SYSTEM | FILE_ATTRIBUTE_READONLY)))
+        {
+            if (cchValue) pwszValue[0] = 0;
+            return FALSE;
+        }
+#endif
 
         return SHELL32_GetCustomFolderAttributeFromPath(wszFolderPath, pwszHeading, 
                                                 pwszAttribute, pwszValue, cchValue);
