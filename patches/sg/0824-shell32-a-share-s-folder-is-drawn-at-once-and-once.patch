+/* Stained Glass OS: icons read beside the view on a network share.
+ *
+ * A file whose icon is its own (a program's, an .ico, a shortcut's) is read
+ * to find it. In a folder on a share that is several network round trips a
+ * file, and the view read them one by one as it drew, on its own thread:
+ * the window drew row by row and stood still meanwhile (David: a share's
+ * icons were drawn slowly at first). Up to a tenth of a second in each half
+ * second goes on reading them in place, so that on a fast network a folder
+ * is drawn once with its icons; past that, as Windows' File Explorer does on
+ * a slow share, such an icon is read on the view's picture thread while the
+ * item shows a plain icon, and put in when it has been read. Folders on
+ * Wine's own disks are read as before. */
+static BOOL ShellView_IsRemote(IShellViewImpl *This)
+{
+    WCHAR path[MAX_PATH], root[4] = L"A:\\";
+
+    if (This->remote >= 0) return This->remote;
+    This->remote = 0;
+    if (!ShellView_FolderPidl(This) || !SHGetPathFromIDListW(This->folder_pidl, path)) return FALSE;
+    if (path[0] == '\\' && path[1] == '\\' && path[2] != '?' && path[2] != '.') This->remote = 1;
+    else if (path[0] && path[1] == ':')
+    {
+        root[0] = path[0];
+        This->remote = GetDriveTypeW(root) == DRIVE_REMOTE;
+    }
+    return This->remote;
+}
+
+/* whether a file type's icon is the file's own (read from the file);
+ * remembered per extension */
+static BOOL ShellView_IconPerFile(LPCITEMIDLIST pidl)
+{
+    static struct { WCHAR ext[16]; BOOL own; } cache[64];
+    static int ncache;
+    WCHAR name[MAX_PATH], progid[MAX_PATH], key[MAX_PATH], value[MAX_PATH];
+    const WCHAR *ext;
+    LONG size;
+    BOOL own = FALSE;
+    int i;
+
+    if (!_ILIsValue(pidl)) return FALSE;
+    _ILSimpleGetTextW(pidl, name, MAX_PATH);
+    ext = PathFindExtensionW(name);
+    if (!ext[0] || lstrlenW(ext) >= 16) return FALSE;
+    for (i = 0; i < ncache; i++)
+        if (!wcsicmp(cache[i].ext, ext)) return cache[i].own;
+    size = sizeof(progid);
+    if (RegQueryValueW(HKEY_CLASSES_ROOT, ext, progid, &size) || !progid[0]) lstrcpynW(progid, ext, MAX_PATH);
+    /* the type's DefaultIcon is the file itself ("%1"), or a handler gives each file its icon */
+    swprintf(key, ARRAY_SIZE(key), L"%s\\DefaultIcon", progid);
+    size = sizeof(value);
+    if (!RegQueryValueW(HKEY_CLASSES_ROOT, key, value, &size) && wcsstr(value, L"%1")) own = TRUE;
+    swprintf(key, ARRAY_SIZE(key), L"%s\\shellex\\IconHandler", progid);
+    size = sizeof(value);
+    if (!own && !RegQueryValueW(HKEY_CLASSES_ROOT, key, value, &size) && value[0]) own = TRUE;
+    /* a shortcut's icon is its target's */
+    swprintf(key, ARRAY_SIZE(key), L"%s", progid);
+    if (!own)
+    {
+        HKEY hkey;
+        if (!RegOpenKeyExW(HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey))
+        {
+            own = !RegQueryValueExW(hkey, L"IsShortcut", NULL, NULL, NULL, NULL);
+            RegCloseKey(hkey);
+        }
+    }
+    if (ncache < ARRAY_SIZE(cache))
+    {
+        lstrcpyW(cache[ncache].ext, ext);
+        cache[ncache++].own = own;
+    }
+    return own;
+}
+
+/* the system image index to show for an item now: its icon when that needs
+ * no reading of a file on a share, else a plain one while its own is read on
+ * the picture thread; -2 when the view should find it as before */
+static int ShellView_RemoteIcon(IShellViewImpl *This, LPCITEMIDLIST pidl)
+{
+    struct thumb_request *req;
+    struct thumb_queue *queue;
+    WCHAR name[MAX_PATH];
+    const WCHAR *ext;
+    ITEMIDLIST *folder;
+    BOOL found;
+
+#ifdef SG_MUTANT_SYNC_REMOTE_ICONS
+    return -2;
+#endif
+    if (!ShellView_IsRemote(This) || !ShellView_IconPerFile(pidl) || !(folder = ShellView_FolderPidl(This)))
+        return -2;
+    /* asked for already: the plain icon until it comes */
+    sorted_find(This->icon_requested, This->n_icon_requested, (LPARAM)pidl, &found);
+    if (!found)
+    {
+        DWORD now = GetTickCount();
+        int index;
+
+        /* in place while that costs little */
+        if (now - This->icon_burst > 500)
+        {
+            This->icon_burst = now;
+            This->icon_burst_ms = 0;
+        }
+        if (This->icon_burst_ms < 100)
+        {
+            index = SHMapPIDLToSystemImageListIndex(This->pSFParent, pidl, 0);
+            This->icon_burst_ms += GetTickCount() - now;
+            return index;
+        }
+        if (!sorted_add(&This->icon_requested, &This->n_icon_requested, &This->max_icon_requested, (LPARAM)pidl) ||
+            !(queue = ShellView_Queue(This)) || !(req = calloc(1, sizeof(*req))))
+            return -2;
+        req->abs = ILCombine(folder, pidl);
+        req->child = ILClone(pidl);
+        req->gen = This->thumb_gen;
+        req->icon = TRUE;
+        EnterCriticalSection(&queue->cs);
+        list_add_head(&queue->requests, &req->entry);
+        LeaveCriticalSection(&queue->cs);
+        SetEvent(queue->event);
+    }
+    _ILSimpleGetTextW(pidl, name, MAX_PATH);
+    ext = PathFindExtensionW(name);
+    return SIC_GetIconIndex(swShell32Name, (!wcsicmp(ext, L".exe") || !wcsicmp(ext, L".com") || !wcsicmp(ext, L".scr"))
+                            ? -IDI_SHELL_WINDOW : -IDI_SHELL_FILE, 0);
+}
+
+/* an icon read on the picture thread has come */
+static void ShellView_OnIcon(IShellViewImpl *This, struct thumb_result *result)
+{
+    LVITEMW lvItem;
+    int item;
+
+    if (result->gen == This->thumb_gen && (item = LV_FindItemByPidl(This, result->child)) >= 0)
+    {
+        /* a picture of the file asked for too comes in its own time */
+        if (!(This->thumbnails && This->own_icons && ShellView_HasThumbnail(result->child)))
+        {
+            lvItem.mask = LVIF_IMAGE;
+            lvItem.iItem = item;
+            lvItem.iSubItem = 0;
+            lvItem.iImage = This->own_icons ? ShellView_OwnIcon(This, result->icon) : result->icon;
+            SendMessageW(This->hWndList, LVM_SETITEMW, 0, (LPARAM)&lvItem);
+        }
+    }
+    ILFree(result->child);
+    free(result);
+}
