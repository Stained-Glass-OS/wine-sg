+        if (array[mid] == item) { *found = TRUE; return mid; }
+        if (array[mid] < item) lo = mid + 1;
         else hi = mid;
     }
     *found = FALSE;
     return lo;
+}
+
+static int requested_find(IShellViewImpl *This, LPARAM item, BOOL *found)
+{
+    return sorted_find(This->requested, This->n_requested, item, found);
+}
+
+/* adds an item to a sorted array once; FALSE when it was there already */
+static BOOL sorted_add(LPARAM **array, int *count, int *max_count, LPARAM item)
+{
+    BOOL found;
+    int at = sorted_find(*array, *count, item, &found);
+
+    if (found) return FALSE;
+    if (*count == *max_count)
+    {
+        int max = max(64, *max_count * 2);
+        LPARAM *grown = realloc(*array, max * sizeof(*grown));
+        if (!grown) return FALSE;
+        *array = grown;
+        *max_count = max;
+    }
+    memmove(*array + at + 1, *array + at, (*count - at) * sizeof(LPARAM));
+    (*array)[at] = item;
+    (*count)++;
+    return TRUE;
+}
