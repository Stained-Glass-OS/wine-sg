+/* Stained Glass OS: whether a folder is on a network share -- a UNC path or a
+ * drive letter mapped to one (each letter's type remembered for 30 s, as
+ * asking costs a request to the server). */
+static BOOL folder_is_remote( const WCHAR *path )
+{
+    static DWORD types[26], when[26];
+    DWORD now = GetTickCount(), type;
+    WCHAR root[] = L"A:\\";
+    int i;
+
+    if (path[0] == '\\' && path[1] == '\\') return path[2] != '?' && path[2] != '.';
+    if (!path[0] || path[1] != ':') return FALSE;
+    i = towupper( path[0] ) - 'A';
+    if (i < 0 || i >= 26) return FALSE;
+    if (!when[i] || now - when[i] > 30000)
+    {
+        root[0] = 'A' + i;
+        types[i] = GetDriveTypeW( root );
+        when[i] = now ? now : 1;
+    }
+    type = types[i];
+    return type == DRIVE_REMOTE;
+}
+
