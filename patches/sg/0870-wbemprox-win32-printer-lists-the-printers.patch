From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemprox: Win32_Printer lists the printers

Win32_Printer asked EnumPrinters for the size of the list and took the
count that call reported for the number of printers. A sizing call (no
buffer) leaves the count at 0 -- on Windows as in Wine; only the size
says something -- so SELECT * FROM Win32_Printer was always empty,
whatever printers there were. DYMO Connect looks for its label printers
that way and said "No label printer found" (David's LabelWriter 550,
2026-10-05). The sizing call's size decides now, and a printer without a
default DEVMODE no longer crashes the query (its resolution is 0).

Test: test/wmiprinter-gate.sh with test/wmiprinter-probe.c, 64- and
32-bit (mutant SG_MUTANT_WMIPRINTER).
---
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -3314,8 +3314,17 @@
     UINT num_rows = 0;
     WCHAR id[20];
 
+    /* Stained Glass OS: the sizing call reports no printers (count is only
+     * set when the buffer is big enough, as on Windows); what it reports is
+     * the size. Win32_Printer was always empty, and programs that list
+     * printers through WMI (DYMO Connect) found none. */
+#ifndef SG_MUTANT_WMIPRINTER
+    if (EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, NULL, 0, &size, &count ) ||
+        GetLastError() != ERROR_INSUFFICIENT_BUFFER || !size) return FILL_STATUS_UNFILTERED;
+#else
     EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, NULL, 0, &size, &count );
     if (!count) return FILL_STATUS_UNFILTERED;
+#endif
 
     if (!(info = malloc( size ))) return FILL_STATUS_FAILED;
     if (!EnumPrintersW( PRINTER_ENUM_LOCAL, NULL, 2, (BYTE *)info, size, &size, &count ))
@@ -3336,7 +3345,7 @@
         swprintf( id, ARRAY_SIZE( id ), L"Printer%u", i );
         rec->device_id            = wcsdup( id );
         rec->drivername           = wcsdup( info[i].pDriverName );
-        rec->horizontalresolution = info[i].pDevMode->dmPrintQuality;
+        rec->horizontalresolution = info[i].pDevMode ? info[i].pDevMode->dmPrintQuality : 0;
         rec->local                = -1;
         rec->location             = wcsdup( info[i].pLocation );
         rec->name                 = wcsdup( info[i].pPrinterName );
