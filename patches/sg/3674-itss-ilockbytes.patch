+HRESULT ITSS_StgOpenStorageOnILockBytes( ILockBytes *lockbytes, IStorage **ppstgOpen )
+{
+    struct chmFile *chmfile;
+
+    TRACE("%p %p\n", lockbytes, ppstgOpen);
+
+    if (!ppstgOpen) return STG_E_INVALIDPOINTER;
+    *ppstgOpen = NULL;
+#ifndef ITSS_MUT_NULL
+    if (!lockbytes) return STG_E_INVALIDPOINTER;
+#endif
+
+    chmfile = chm_open_lockbytes( lockbytes );
+    if (!chmfile)
+        return E_FAIL;
+
+    return ITSS_create_chm_storage( chmfile, L"/", ppstgOpen );
+}
+
+/* a CHM archive starts with the signature "ITSF" */
+static BOOL is_itsf_header( const BYTE *buf, ULONG len )
+{
+    return len >= 4 && !memcmp( buf, "ITSF", 4 );
+}
+
+HRESULT ITSS_IsStorageILockBytes( ILockBytes *lockbytes )
+{
+    ULARGE_INTEGER pos;
+    BYTE buf[4];
+    ULONG got = 0;
+    HRESULT hr;
+
+    if (!lockbytes) return STG_E_INVALIDPOINTER;
+    pos.QuadPart = 0;
+    hr = ILockBytes_ReadAt( lockbytes, pos, buf, sizeof(buf), &got );
+    if (FAILED(hr)) return hr;
+#ifdef ITSS_MUT_SIG
+    return S_OK;
+#endif
+    return is_itsf_header( buf, got ) ? S_OK : S_FALSE;
+}
+
+HRESULT ITSS_IsStorageFile( const WCHAR *name )
+{
+    BYTE buf[4];
+    DWORD got = 0;
+    HANDLE file;
+    BOOL ok;
+
+    if (!name) return STG_E_INVALIDPOINTER;
+    file = CreateFileW( name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        DWORD err = GetLastError();
+#ifdef ITSS_MUT_NOTFOUND
+        return STG_E_ACCESSDENIED;
+#endif
+        return (err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND) ? STG_E_FILENOTFOUND : STG_E_ACCESSDENIED;
+    }
+    ok = ReadFile( file, buf, sizeof(buf), &got, NULL );
+    CloseHandle( file );
+    if (!ok) return STG_E_READFAULT;
+    return is_itsf_header( buf, got ) ? S_OK : S_FALSE;
+}
