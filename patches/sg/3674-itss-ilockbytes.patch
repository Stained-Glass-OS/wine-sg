@@ -544,10 +547,25 @@ static Int64 _chm_fetch_bytes(struct chmFile *h,
                               Int64 len)
 {
     Int64 readLen=0;
-    if (h->fd  ==  CHM_NULL_FD)
+    if (h->fd  ==  CHM_NULL_FD && !h->lockbytes)
         return readLen;
 
