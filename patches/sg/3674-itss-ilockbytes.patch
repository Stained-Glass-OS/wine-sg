     /* allocate handle */
     newHandle = HeapAlloc(GetProcessHeap(), 0, sizeof(struct chmFile));
     newHandle->fd = CHM_NULL_FD;
+    newHandle->lockbytes = NULL;
     newHandle->lzx_state = NULL;
     newHandle->cache_blocks = NULL;
     newHandle->cache_block_indices = NULL;
@@ -685,6 +696,41 @@ struct chmFile *chm_openW(const WCHAR *filename)
         return NULL;
     }
 
+    return chm_open_handle(newHandle);
+}
+
+/* open an ITS archive stored in an ILockBytes */
+struct chmFile *chm_open_lockbytes(ILockBytes *lockbytes)
+{
+    struct chmFile             *newHandle=NULL;
+
+    newHandle = HeapAlloc(GetProcessHeap(), 0, sizeof(struct chmFile));
+    newHandle->fd = CHM_NULL_FD;
+    newHandle->lockbytes = lockbytes;
+#ifndef ITSS_MUT_LEAK
+    ILockBytes_AddRef(lockbytes);
+#endif
+    newHandle->lzx_state = NULL;
+    newHandle->cache_blocks = NULL;
+    newHandle->cache_block_indices = NULL;
+    newHandle->cache_num_blocks = 0;
+
+    return chm_open_handle(newHandle);
+}
+
+static struct chmFile *chm_open_handle(struct chmFile *newHandle)
+{
+    unsigned char               sbuffer[256];
+    unsigned int                sremain;
+    unsigned char              *sbufpos;
+    struct chmItsfHeader        itsfHeader;
+    struct chmItspHeader        itspHeader;
+#if 0
+    struct chmUnitInfo          uiSpan;
+#endif
+    struct chmUnitInfo          uiLzxc;
+    struct chmLzxcControlData   ctlData;
+
     /* initialize mutexes, if needed */
     InitializeCriticalSectionEx(&newHandle->mutex, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     newHandle->mutex.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": chmFile.mutex");
@@ -807,10 +853,13 @@ struct chmFile *chm_dup(struct chmFile *oldHandle)
     newHandle = HeapAlloc(GetProcessHeap(), 0, sizeof(struct chmFile));
     *newHandle = *oldHandle;
 
-    /* duplicate fd handle */
-    DuplicateHandle(GetCurrentProcess(), oldHandle->fd,
-                    GetCurrentProcess(), &(newHandle->fd),
-                    0, FALSE, DUPLICATE_SAME_ACCESS);
+    /* duplicate fd handle, or share the ILockBytes */
+    if (oldHandle->lockbytes)
+        ILockBytes_AddRef(newHandle->lockbytes);
+    else
+        DuplicateHandle(GetCurrentProcess(), oldHandle->fd,
+                        GetCurrentProcess(), &(newHandle->fd),
+                        0, FALSE, DUPLICATE_SAME_ACCESS);
     newHandle->lzx_state = NULL;
     newHandle->cache_blocks = NULL;
     newHandle->cache_block_indices = NULL;
@@ -839,6 +888,9 @@ void chm_close(struct chmFile *h)
         if (h->fd != CHM_NULL_FD)
             CHM_CLOSE_FILE(h->fd);
         h->fd = CHM_NULL_FD;
+        if (h->lockbytes)
+            ILockBytes_Release(h->lockbytes);
+        h->lockbytes = NULL;
 
         h->mutex.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection(&h->mutex);
