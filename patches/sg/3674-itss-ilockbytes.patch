+            readLen = got;
+        CHM_RELEASE_LOCK(h->mutex);
+        return readLen;
+    }
     /* NOTE: this might be better done with CreateFileMapping, et cetera... */
     {
         LARGE_INTEGER old_pos, new_pos;
@@ -649,24 +667,17 @@ static void chm_set_param(struct chmFile *h,
