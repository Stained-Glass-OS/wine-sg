From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp: _Xregex_error throws std::regex_error

The regex code compiled into programs (MSVC's <regex>) calls
std::_Xregex_error(regex_constants::error_type) when a pattern does not
parse or a match grows too complex or too deep. Windows throws a
std::regex_error -- a runtime_error that keeps the error code and says
what went wrong -- and the program catches it. It was a stub in msvcp110,
msvcp120 and msvcp140: Outlook died ("unimplemented function
msvcp140.dll._Xregex_error") as it showed an HTML mail (it raises
error_stack there, catches it and goes on).

Gate: test/xregex-gate.sh (calls it in msvcp140 64/32-bit and msvcp120 and
reads the C++ exception: catchable types regex_error and runtime_error,
the code, what()). Mutant SG_MUTANT_XREGEX_ERROR_ABORTS.
---
--- a/dlls/msvcp90/exception.c
+++ b/dlls/msvcp90/exception.c
@@ -77,6 +77,8 @@
 extern const vtable_ptr range_error_vtable;
 /* ??_7bad_function_call@std@@6B@ */
 extern const vtable_ptr bad_function_call_vtable;
+/* ??_7regex_error@std@@6B@ */
+extern const vtable_ptr regex_error_vtable;
 
 /* ??0exception@@QAE@ABQBD@Z */
 /* ??0exception@@QEAA@AEBQEBD@Z */
@@ -985,6 +987,96 @@
     _CxxThrowException(&e, &runtime_error_exception_type);
 }
 
+#if _MSVCP_VER >= 110
+/* Stained Glass OS (wine-sg 1520): std::regex_error, which the regex code
+ * compiled into programs raises through _Xregex_error when a pattern does
+ * not parse or a match grows too complex. Windows throws it; it was a stub,
+ * so Outlook died ("unimplemented function") reading an HTML mail. */
+typedef struct {
+    runtime_error base;
+    int code; /* regex_constants::error_type */
+} regex_error;
+
+static const char * const regex_error_messages[] = {
+    "regex_error(error_collate): The expression contained an invalid collating element name.",
+    "regex_error(error_ctype): The expression contained an invalid character class name.",
+    "regex_error(error_escape): The expression contained an invalid escaped character, or a trailing escape.",
+    "regex_error(error_backref): The expression contained an invalid back reference.",
+    "regex_error(error_brack): The expression contained mismatched [ and ].",
+    "regex_error(error_paren): The expression contained mismatched ( and ).",
+    "regex_error(error_brace): The expression contained mismatched { and }.",
+    "regex_error(error_badbrace): The expression contained an invalid range in a { expression }.",
+    "regex_error(error_range): The expression contained an invalid character range, such as [b-a] in most encodings.",
+    "regex_error(error_space): There was insufficient memory to convert the expression into a finite state machine.",
+    "regex_error(error_badrepeat): One of *?+{ was not preceded by a valid regular expression.",
+    "regex_error(error_complexity): The complexity of an attempted match against a regular expression exceeded a pre-set level.",
+    "regex_error(error_stack): There was insufficient memory to determine whether the regular expression could match the specified character sequence.",
+    "regex_error(error_parse): Failed to parse regular expression.",
+    "regex_error(error_syntax): Failed to parse regular expression.",
+};
+
+static regex_error* MSVCP_regex_error_ctor( regex_error *this, int code )
+{
+    const char *str = code >= 0 && code < ARRAY_SIZE(regex_error_messages)
+            ? regex_error_messages[code] : "regex_error";
+    exception_name name = EXCEPTION_NAME(str);
+
+    TRACE("%p %d\n", this, code);
+    MSVCP_runtime_error_ctor(&this->base, name);
+    this->code = code;
+    this->base.e.vtable = &regex_error_vtable;
+    return this;
+}
+
+DEFINE_THISCALL_WRAPPER(regex_error_copy_ctor, 8)
+regex_error* __thiscall regex_error_copy_ctor(regex_error *this, const regex_error *rhs)
+{
+    TRACE("%p %p\n", this, rhs);
+    runtime_error_copy_ctor(&this->base, &rhs->base);
+    this->code = rhs->code;
+    this->base.e.vtable = &regex_error_vtable;
+    return this;
+}
+
+DEFINE_THISCALL_WRAPPER(MSVCP_regex_error_vector_dtor, 8)
+void* __thiscall MSVCP_regex_error_vector_dtor(regex_error *this, unsigned int flags)
+{
+    TRACE("%p %x\n", this, flags);
+    if (flags & 2)
+    {
+        /* we have an array, with the number of elements stored before the first object */
+        INT_PTR i, *ptr = (INT_PTR *)this - 1;
+
+        for (i = *ptr - 1; i >= 0; i--) MSVCP_runtime_error_dtor(&this[i].base);
+        operator_delete(ptr);
+    }
+    else
+    {
+        MSVCP_runtime_error_dtor(&this->base);
+        if (flags & 1) operator_delete(this);
+    }
+    return this;
+}
+
+DEFINE_RTTI_DATA2(regex_error, 0, &runtime_error_rtti_base_descriptor,
+        &exception_rtti_base_descriptor, ".?AVregex_error@std@@")
+DEFINE_CXX_DATA2(regex_error, &runtime_error_cxx_type_info,
+        &exception_cxx_type_info, MSVCP_runtime_error_dtor)
+
+/* ?_Xregex_error@std@@YAXW4error_type@regex_constants@1@@Z */
+void __cdecl DECLSPEC_NORETURN _Xregex_error(int code)
+{
+    regex_error e;
+
+    TRACE("(%d)\n", code);
+#ifdef SG_MUTANT_XREGEX_ERROR_ABORTS
+    abort();
+#endif
+    MSVCP_regex_error_ctor(&e, code);
+    _CxxThrowException(&e, &regex_error_exception_type);
+}
+#endif
+
 #if _MSVCP_VER > 90
 /* ?_Xbad_function_call@std@@YAXXZ() */
 void __cdecl _Xbad_function_call(void)
@@ -1453,6 +1545,11 @@
             VTABLE_ADD_FUNC(MSVCP_exception_vector_dtor)
             VTABLE_ADD_FUNC(MSVCP_exception_what));
 #endif
+#if _MSVCP_VER >= 110
+    EXCEPTION_VTABLE(regex_error,
+            VTABLE_ADD_FUNC(MSVCP_regex_error_vector_dtor)
+            VTABLE_ADD_FUNC(MSVCP_runtime_error_what));
+#endif
     EXCEPTION_VTABLE(failure,
             VTABLE_ADD_FUNC(MSVCP_failure_vector_dtor)
             VTABLE_ADD_FUNC(MSVCP_failure_what));
@@ -1516,6 +1613,9 @@
     init_system_error_rtti(base);
     init_bad_function_call_rtti(base);
 #endif
+#if _MSVCP_VER >= 110
+    init_regex_error_rtti(base);
+#endif
     init_failure_rtti(base);
     init_bad_cast_rtti(base);
     init_range_error_rtti(base);
@@ -1541,6 +1641,9 @@
 #if _MSVCP_VER > 90
     init_bad_function_call_cxx(base);
 #endif
+#if _MSVCP_VER >= 110
+    init_regex_error_cxx(base);
+#endif
     init_failure_cxx(base);
     init_range_error_cxx(base);
 #endif
