From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msctf: TF_CreateCategoryMgr, TF_CreateDisplayAttributeMgr

TF_CreateCategoryMgr and TF_CreateDisplayAttributeMgr, the helpers text
services (IMEs, Office) call to get the category and display attribute
managers without going through COM activation, were exported stubs. They now
return the manager (ITfCategoryMgr, ITfDisplayAttributeMgr) the classes'
constructors make, E_INVALIDARG for a NULL out pointer.

---
--- a/dlls/msctf/msctf.c
+++ b/dlls/msctf/msctf.c
@@ -592,6 +592,45 @@ HRESULT WINAPI TF_CreateThreadMgr(ITfThreadMgr **pptim)
     return ThreadMgr_Constructor(NULL,(IUnknown**)pptim);
 }
 
+/***********************************************************************
+ *              TF_CreateCategoryMgr (MSCTF.@)
+ */
+HRESULT WINAPI TF_CreateCategoryMgr(ITfCategoryMgr **ppcat)
+{
+    IUnknown *obj;
+    HRESULT hr;
+
+    TRACE("(%p)\n", ppcat);
+
+    if (!ppcat) return E_INVALIDARG;
+    *ppcat = NULL;
+#ifdef SG_MUTANT_TF_CREATE_NO_QI
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = CategoryMgr_Constructor(NULL, &obj))) return hr;
+    hr = IUnknown_QueryInterface(obj, &IID_ITfCategoryMgr, (void **)ppcat);
+    IUnknown_Release(obj);
+    return hr;
+}
+
+/***********************************************************************
+ *              TF_CreateDisplayAttributeMgr (MSCTF.@)
+ */
+HRESULT WINAPI TF_CreateDisplayAttributeMgr(ITfDisplayAttributeMgr **ppdam)
+{
+    IUnknown *obj;
+    HRESULT hr;
+
+    TRACE("(%p)\n", ppdam);
+
+    if (!ppdam) return E_INVALIDARG;
+    *ppdam = NULL;
+    if (FAILED(hr = DisplayAttributeMgr_Constructor(NULL, &obj))) return hr;
+    hr = IUnknown_QueryInterface(obj, &IID_ITfDisplayAttributeMgr, (void **)ppdam);
+    IUnknown_Release(obj);
+    return hr;
+}
+
 /***********************************************************************
  *              TF_GetThreadMgr (MSCTF.@)
  */
--- a/dlls/msctf/msctf.spec
+++ b/dlls/msctf/msctf.spec
@@ -8,9 +8,9 @@
 @ stub TF_CUASAppFix
 @ stub TF_CheckThreadInputIdle
 @ stub TF_ClearLangBarAddIns
-@ stub TF_CreateCategoryMgr
+@ stdcall TF_CreateCategoryMgr(ptr)
 @ stub TF_CreateCicLoadMutex
-@ stub TF_CreateDisplayAttributeMgr
+@ stdcall TF_CreateDisplayAttributeMgr(ptr)
 @ stdcall TF_CreateInputProcessorProfiles(ptr)
 @ stdcall TF_CreateLangBarItemMgr(ptr)
 @ stdcall TF_CreateLangBarMgr(ptr)
