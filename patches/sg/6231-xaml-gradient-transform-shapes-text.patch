From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: gradient RelativeTransform, shape and text gradients

Three things gradients (6229, 6230) still lacked. A brush's RelativeTransform now moves a gradient's ends in the area's relative space (WinUI 2's ControlElevationBorderBrush is flipped so, the light edge at the bottom of buttons and boxes). A Shape's Fill and Stroke are drawn as gradients (Rectangle, Ellipse, Path, Line), and a TextBlock's Foreground as a gradient over the text's area. Fill and stroke are drawn one after the other (each a gradient, an image or a colour).
---
diff --git a/dlls/windows.ui.xaml/media.c b/dlls/windows.ui.xaml/media.c
index c32da32..8619a34 100644
--- a/dlls/windows.ui.xaml/media.c
+++ b/dlls/windows.ui.xaml/media.c
@@ -1024,6 +1024,17 @@ BOOL xaml_brush_gradient( IInspectable *brush_iface, struct xgradient *gradient
     dobj_get_value( &brush->d, prop_brush_opacity, &box );
     gradient->opacity = fmin( fmax( xunbox_double( box, 1.0 ), 0 ), 1 );
     if (box) IInspectable_Release( box );
+    box = NULL;
+    gradient->has_relative = FALSE;
+#ifndef SG_MUTANT_NO_RELATIVE_TRANSFORM
+    dobj_get_value( &brush->d, prop_brush_relative_transform, &box );
+    if (box)
+    {
+        xaml_transform_matrix( box, &gradient->relative );
+        gradient->has_relative = TRUE;
+        IInspectable_Release( box );
+    }
+#endif
     return TRUE;
 }
 
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index c0343a4..8fe2b69 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -266,6 +266,8 @@ struct xgradient
     struct xpoint start, end;
     INT32 mapping, spread;
     DOUBLE opacity;
+    BOOL has_relative;          /* its RelativeTransform, in the area's relative space (0..1) */
+    struct xmatrix relative;
 };
 BOOL xaml_brush_gradient( IInspectable *brush, struct xgradient *gradient );
 BOOL xaml_brush_image( IInspectable *brush, IInspectable **source, INT32 *stretch, INT32 *align_x, INT32 *align_y,
@@ -517,6 +519,8 @@ BOOL xaml_text_caret( struct uielem *text_block, UINT32 index, FLOAT *x, FLOAT *
 struct xcorner;
 void xdraw_fill( struct xdraw *draw, const struct xrect *rect, struct xcolor color, const struct xcorner *corner );
 BOOL xdraw_fill_brush( struct xdraw *draw, const struct xrect *rect, IInspectable *brush, const struct xcorner *corner );
+BOOL xdraw_use_brush( struct xdraw *draw, IInspectable *brush, const struct xrect *rect );
+void xdraw_end_brush( struct xdraw *draw );
 BOOL xdraw_border_brush( struct xdraw *draw, const struct xrect *rect, const struct xthickness *t, IInspectable *brush,
                          const struct xcorner *corner );
 void xdraw_border( struct xdraw *draw, const struct xrect *rect, const struct xthickness *thickness, struct xcolor color,
diff --git a/dlls/windows.ui.xaml/render.c b/dlls/windows.ui.xaml/render.c
index 9e12c4b..a0c6138 100644
--- a/dlls/windows.ui.xaml/render.c
+++ b/dlls/windows.ui.xaml/render.c
@@ -122,20 +122,27 @@ static ID2D1Brush *gradient_brush( struct xdraw *draw, IInspectable *brush, cons
     if (FAILED(ID2D1RenderTarget_CreateGradientStopCollection( draw->target, stops, g.count, D2D1_GAMMA_2_2,
             extend[g.spread >= 0 && g.spread < 3 ? g.spread : 0], &collection )))
         return NULL;
-    /* its ends: in the area's size (relative to the bounding box) or in pixels from its corner */
-    if (g.mapping)
+    /* its ends: in the area's size (relative to the bounding box) or in pixels from its corner; a
+     * RelativeTransform moves them in the area's relative space (WinUI's control borders flip so) */
     {
-        props.startPoint.x = ox + g.start.x * rect->width;
-        props.startPoint.y = oy + g.start.y * rect->height;
-        props.endPoint.x = ox + g.end.x * rect->width;
-        props.endPoint.y = oy + g.end.y * rect->height;
-    }
-    else
-    {
-        props.startPoint.x = ox + g.start.x;
-        props.startPoint.y = oy + g.start.y;
-        props.endPoint.x = ox + g.end.x;
-        props.endPoint.y = oy + g.end.y;
+        DOUBLE w = rect->width > 0 ? rect->width : 1, h = rect->height > 0 ? rect->height : 1;
+        DOUBLE sx = g.mapping ? g.start.x : g.start.x / w, sy = g.mapping ? g.start.y : g.start.y / h;
+        DOUBLE ex = g.mapping ? g.end.x : g.end.x / w, ey = g.mapping ? g.end.y : g.end.y / h;
+
+        if (g.has_relative)
+        {
+            const struct xmatrix *m = &g.relative;
+            DOUBLE x = sx, y = sy;
+            sx = x * m->m11 + y * m->m21 + m->dx;
+            sy = x * m->m12 + y * m->m22 + m->dy;
+            x = ex; y = ey;
+            ex = x * m->m11 + y * m->m21 + m->dx;
+            ey = x * m->m12 + y * m->m22 + m->dy;
+        }
+        props.startPoint.x = ox + sx * w;
+        props.startPoint.y = oy + sy * h;
+        props.endPoint.x = ox + ex * w;
+        props.endPoint.y = oy + ey * h;
     }
     brush_props.opacity = g.opacity;
     ID2D1RenderTarget_CreateLinearGradientBrush( draw->target, &props, &brush_props, collection, &linear );
@@ -143,6 +150,19 @@ static ID2D1Brush *gradient_brush( struct xdraw *draw, IInspectable *brush, cons
     return (ID2D1Brush *)linear;
 }
 
+/* a brush drawn as itself (a gradient) over an area: what is drawn until xdraw_end_brush uses it; FALSE: none */
+BOOL xdraw_use_brush( struct xdraw *draw, IInspectable *brush, const struct xrect *rect )
+{
+    if (!brush || draw->brush || !(draw->brush = gradient_brush( draw, brush, rect ))) return FALSE;
+    return TRUE;
+}
+
+void xdraw_end_brush( struct xdraw *draw )
+{
+    if (draw->brush) ID2D1Brush_Release( draw->brush );
+    draw->brush = NULL;
+}
+
 /* an area filled with a brush drawn as itself (a gradient); FALSE: none such */
 BOOL xdraw_fill_brush( struct xdraw *draw, const struct xrect *rect, IInspectable *brush, const struct xcorner *corner )
 {
diff --git a/dlls/windows.ui.xaml/shapes.c b/dlls/windows.ui.xaml/shapes.c
index e9cb8ad..2e90739 100644
--- a/dlls/windows.ui.xaml/shapes.c
+++ b/dlls/windows.ui.xaml/shapes.c
@@ -149,32 +149,23 @@ static void image_fill( struct shape *shape, struct xdraw *draw, const struct xr
     IInspectable_Release( brush );
 }
 
-static void shape_render( struct uielem *elem, struct xdraw *draw )
+/* its geometry drawn with a fill and/or a stroke */
+static void shape_geometry( struct shape *shape, struct xdraw *draw, const struct xrect *rect, const struct xcolor *fill,
+                            const struct xcolor *stroke, FLOAT thickness )
 {
-    struct shape *shape = CONTAINING_RECORD( elem, struct shape, e );
-    struct xcolor fill, stroke;
-    BOOL has_fill = brush_color( shape, prop_fill, &fill ), has_stroke = brush_color( shape, prop_stroke, &stroke );
-    FLOAT thickness = has_stroke ? get_dbl( shape, prop_stroke_thickness, 1 ) : 0;
-    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
-
-#ifdef SG_MUTANT_SHAPE_NO_FILL
-    has_fill = FALSE;
-#endif
     switch (shape->kind)
     {
     case SHAPE_LINE:
-        if (has_stroke)
+        if (stroke)
             xdraw_line( draw, get_dbl( shape, prop_x1, 0 ), get_dbl( shape, prop_y1, 0 ), get_dbl( shape, prop_x2, 0 ),
-                        get_dbl( shape, prop_y2, 0 ), stroke, thickness );
+                        get_dbl( shape, prop_y2, 0 ), *stroke, thickness );
         break;
     case SHAPE_RECTANGLE:
-        if (!has_fill) image_fill( shape, draw, &rect, FALSE );
-        xdraw_shape( draw, FALSE, &rect, get_dbl( shape, prop_radius_x, 0 ), get_dbl( shape, prop_radius_y, 0 ),
-                     has_fill ? &fill : NULL, has_stroke ? &stroke : NULL, thickness );
+        xdraw_shape( draw, FALSE, rect, get_dbl( shape, prop_radius_x, 0 ), get_dbl( shape, prop_radius_y, 0 ),
+                     fill, stroke, thickness );
         break;
     case SHAPE_ELLIPSE:
-        if (!has_fill) image_fill( shape, draw, &rect, TRUE );
-        xdraw_shape( draw, TRUE, &rect, 0, 0, has_fill ? &fill : NULL, has_stroke ? &stroke : NULL, thickness );
+        xdraw_shape( draw, TRUE, rect, 0, 0, fill, stroke, thickness );
         break;
     case SHAPE_PATH:
     {
@@ -188,19 +179,62 @@ static void shape_render( struct uielem *elem, struct xdraw *draw )
         if (stretch && w > 0 && h > 0)
         {
             /* Fill 1, Uniform 2, UniformToFill 3: its bounds scaled to the size it has */
-            sx = (rect.width - thickness) / w;
-            sy = (rect.height - thickness) / h;
+            sx = (rect->width - thickness) / w;
+            sy = (rect->height - thickness) / h;
             if (stretch == 2) sx = sy = fminf( sx, sy );
             else if (stretch == 3) sx = sy = fmaxf( sx, sy );
             ox = thickness / 2 - path->left * sx;
             oy = thickness / 2 - path->top * sy;
         }
-        xdraw_path( draw, path, sx, sy, ox, oy, has_fill ? &fill : NULL, has_stroke ? &stroke : NULL, thickness );
+        xdraw_path( draw, path, sx, sy, ox, oy, fill, stroke, thickness );
         break;
     }
     }
 }
 
+/* a Fill or Stroke drawn as itself (a gradient, 6231) */
+static BOOL gradient_part( struct shape *shape, struct xaml_property *prop, struct xdraw *draw, const struct xrect *rect )
+{
+    IInspectable *brush = NULL;
+    BOOL ret;
+
+#ifdef SG_MUTANT_SHAPE_GRADIENT_FLAT
+    return FALSE;
+#endif
+    dobj_get_value( &shape->e.d, prop, &brush );
+    ret = brush && xdraw_use_brush( draw, brush, rect );
+    if (brush) IInspectable_Release( brush );
+    return ret;
+}
+
+static void shape_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct shape *shape = CONTAINING_RECORD( elem, struct shape, e );
+    struct xcolor fill, stroke, any = { 0xff, 0, 0, 0 };
+    BOOL has_fill = brush_color( shape, prop_fill, &fill ), has_stroke = brush_color( shape, prop_stroke, &stroke );
+    FLOAT thickness = has_stroke ? get_dbl( shape, prop_stroke_thickness, 1 ) : 0;
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+
+#ifdef SG_MUTANT_SHAPE_NO_FILL
+    has_fill = FALSE;
+#endif
+    /* the fill, then the stroke over it: each a gradient, an image or a colour */
+    if (shape->kind != SHAPE_LINE && gradient_part( shape, prop_fill, draw, &rect ))
+    {
+        shape_geometry( shape, draw, &rect, &any, NULL, thickness );
+        xdraw_end_brush( draw );
+    }
+    else if (has_fill) shape_geometry( shape, draw, &rect, &fill, NULL, thickness );
+    else if (shape->kind == SHAPE_RECTANGLE || shape->kind == SHAPE_ELLIPSE)
+        image_fill( shape, draw, &rect, shape->kind == SHAPE_ELLIPSE );
+    if (has_stroke && gradient_part( shape, prop_stroke, draw, &rect ))
+    {
+        shape_geometry( shape, draw, &rect, NULL, &any, thickness );
+        xdraw_end_brush( draw );
+    }
+    else if (has_stroke) shape_geometry( shape, draw, &rect, NULL, &stroke, thickness );
+}
+
 static const struct elem_ops shape_ops = { shape_measure, shape_arrange, shape_render };
 
 /* ---- IShape ---- */
diff --git a/dlls/windows.ui.xaml/text.c b/dlls/windows.ui.xaml/text.c
index 8d40b6c..accd298 100644
--- a/dlls/windows.ui.xaml/text.c
+++ b/dlls/windows.ui.xaml/text.c
@@ -432,6 +432,20 @@ static void text_render( struct uielem *elem, struct xdraw *draw )
     get_padding( elem, &padding );
     brush = text_value( elem, prop_foreground, XINHERIT_FOREGROUND );
     if (!brush || !xaml_brush_color( brush, &color )) color = xaml_theme_color( XTHEME_TEXT );
+#ifndef SG_MUTANT_TEXT_GRADIENT_FLAT
+    {
+        /* a gradient Foreground: the text drawn with it, over the element's area (6231) */
+        struct xrect area = { 0, 0, elem->render.width, elem->render.height };
+        if (brush && xdraw_use_brush( draw, brush, &area ))
+        {
+            color.a = 0xff;
+            xdraw_text( draw, (IUnknown *)text->layout, padding.left, padding.top, color );
+            xdraw_end_brush( draw );
+            IInspectable_Release( brush );
+            return;
+        }
+    }
+#endif
     if (brush) IInspectable_Release( brush );
     xdraw_text( draw, (IUnknown *)text->layout, padding.left, padding.top, color );
 }
