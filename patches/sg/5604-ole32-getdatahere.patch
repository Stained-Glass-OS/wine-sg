From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: IDataObject::GetDataHere for the data cache and default handler

ole32: IDataObject::GetDataHere for the data cache and the default handler

The data cache copies a cached format into the caller's medium (global
memory in place, stream at the current position, file, storage); the default
handler asks its cache first and then the running object.

Rebased at integration (integ-2026-10) onto 5107 (stubs-6): DefaultHandler_GetDataHere kept from 5107, 5604's argument checks added to it; 5604's mutant SG_MUTANT_HANDLER_GDH_NO_NOTRUNNING dropped (5107's SG_MUTANT_HANDLER_GETDATAHERE covers the running-object path).
---
diff --git a/dlls/ole32/datacache.c b/dlls/ole32/datacache.c
--- a/dlls/ole32/datacache.c
+++ b/dlls/ole32/datacache.c
@@ -1537,13 +1537,130 @@ static HRESULT WINAPI DataCache_GetData(
     return DataCacheEntry_GetData(cache_entry, This->presentationStorage, pformatetcIn, pmedium);
 }
 
+static HRESULT WINAPI DataCache_Save(IPersistStorage *iface, IStorage *stg, BOOL same_as_load);
+
+/* the bytes of a cached format, as they are written into a caller's medium */
+static HRESULT get_cached_bytes(const STGMEDIUM *src, CLIPFORMAT cf, BYTE **data, SIZE_T *size, BOOL *free_data)
+{
+    *free_data = FALSE;
+    switch (src->tymed)
+    {
+    case TYMED_HGLOBAL:
+    {
+        void *ptr = GlobalLock(src->hGlobal);
+        if (!ptr) return DV_E_STGMEDIUM;
+        *size = GlobalSize(src->hGlobal);
+        *data = ptr;
+        return S_OK;
+    }
+    case TYMED_ENHMF:
+    {
+        UINT len = GetEnhMetaFileBits(src->hEnhMetaFile, 0, NULL);
+        if (!len || !(*data = HeapAlloc(GetProcessHeap(), 0, len))) return DV_E_STGMEDIUM;
+        GetEnhMetaFileBits(src->hEnhMetaFile, len, *data);
+        *size = len;
+        *free_data = TRUE;
+        return S_OK;
+    }
+    default:
+        /* a placeable metafile or a bitmap handle has no byte image to copy */
+        return DV_E_TYMED;
+    }
+}
+
 static HRESULT WINAPI DataCache_GetDataHere(
 	    IDataObject*     iface,
 	    LPFORMATETC      pformatetc,
 	    STGMEDIUM*       pmedium)
 {
-  FIXME("stub\n");
-  return E_NOTIMPL;
+    DataCache *This = impl_from_IDataObject(iface);
+    DataCacheEntry *cache_entry;
+    STGMEDIUM src;
+    BYTE *data = NULL;
+    SIZE_T size = 0;
+    BOOL free_data = FALSE;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %p)\n", iface, debugstr_formatetc(pformatetc), pmedium);
+
+    if (!pformatetc || !pmedium)
+        return E_INVALIDARG;
+#ifndef SG_MUTANT_GDH_NO_LINDEX
+    if (pformatetc->lindex != -1)
+        return DV_E_LINDEX;
+#endif
+    if (pmedium->tymed != TYMED_ISTORAGE && pmedium->tymed != TYMED_ISTREAM &&
+        pmedium->tymed != TYMED_HGLOBAL && pmedium->tymed != TYMED_FILE)
+        return DV_E_TYMED;
+
+    cache_entry = DataCache_GetEntryForFormatEtc(This, pformatetc);
+    if (!cache_entry)
+        return DV_E_FORMATETC;
+
+    /* a storage receives the cache as it would save it */
+    if (pmedium->tymed == TYMED_ISTORAGE)
+    {
+        if (!pmedium->pstg) return E_INVALIDARG;
+        if (cache_entry->stgmedium.tymed == TYMED_NULL && cache_entry->load_stream_num != STREAM_NUMBER_NOT_SET)
+        {
+            hr = DataCacheEntry_LoadData(cache_entry, This->presentationStorage);
+            if (FAILED(hr)) return hr;
+        }
+        if (cache_entry->stgmedium.tymed == TYMED_NULL) return OLE_E_BLANK;
+        return DataCache_Save(&This->IPersistStorage_iface, pmedium->pstg, FALSE);
+    }
+
+    memset(&src, 0, sizeof(src));
+    hr = DataCacheEntry_GetData(cache_entry, This->presentationStorage, pformatetc, &src);
+    if (FAILED(hr)) return hr;
+
+    hr = get_cached_bytes(&src, cache_entry->fmtetc.cfFormat, &data, &size, &free_data);
+    if (SUCCEEDED(hr))
+    {
+        switch (pmedium->tymed)
+        {
+        case TYMED_HGLOBAL:
+        {
+            void *dest;
+            if (!pmedium->hGlobal) { hr = E_INVALIDARG; break; }
+#ifdef SG_MUTANT_GDH_TRUNCATE
+            if (GlobalSize(pmedium->hGlobal) < size) size = GlobalSize(pmedium->hGlobal);
+#endif
+            if (GlobalSize(pmedium->hGlobal) < size) { hr = STG_E_MEDIUMFULL; break; }
+            if (!(dest = GlobalLock(pmedium->hGlobal))) { hr = DV_E_STGMEDIUM; break; }
+            memcpy(dest, data, size);
+            GlobalUnlock(pmedium->hGlobal);
+            break;
+        }
+        case TYMED_ISTREAM:
+        {
+            ULONG written = 0;
+            if (!pmedium->pstm) { hr = E_INVALIDARG; break; }
+#ifdef SG_MUTANT_GDH_STREAM_REWIND
+            { LARGE_INTEGER zero = {{0}}; IStream_Seek(pmedium->pstm, zero, STREAM_SEEK_SET, NULL); }
+#endif
+            hr = IStream_Write(pmedium->pstm, data, size, &written);
+            if (SUCCEEDED(hr) && written != size) hr = STG_E_MEDIUMFULL;
+            break;
+        }
+        case TYMED_FILE:
+        {
+            HANDLE file;
+            DWORD written = 0;
+            if (!pmedium->lpszFileName) { hr = E_INVALIDARG; break; }
+            file = CreateFileW(pmedium->lpszFileName, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+            if (file == INVALID_HANDLE_VALUE) { hr = HRESULT_FROM_WIN32(GetLastError()); break; }
+            if (!WriteFile(file, data, size, &written, NULL) || written != size)
+                hr = HRESULT_FROM_WIN32(GetLastError() ? GetLastError() : ERROR_DISK_FULL);
+            CloseHandle(file);
+            break;
+        }
+        }
+        if (free_data) HeapFree(GetProcessHeap(), 0, data);
+        else if (src.tymed == TYMED_HGLOBAL) GlobalUnlock(src.hGlobal);
+    }
+    ReleaseStgMedium(&src);
+    return hr;
 }
 
 static HRESULT WINAPI DataCache_QueryGetData( IDataObject *iface, FORMATETC *fmt )
diff --git a/dlls/ole32/defaulthandler.c b/dlls/ole32/defaulthandler.c
--- a/dlls/ole32/defaulthandler.c
+++ b/dlls/ole32/defaulthandler.c
@@ -1162,6 +1162,15 @@ static HRESULT WINAPI DefaultHandler_GetDataHere(
 
   TRACE("(%p, %p, %p)\n", iface, pformatetc, pmedium);
 
+  if (!pformatetc || !pmedium)
+    return E_INVALIDARG;
+  if (pformatetc->lindex != -1)
+    return DV_E_LINDEX;
+  /* the caller allocates the medium: only storage, stream, global memory and file */
+  if (pmedium->tymed != TYMED_ISTORAGE && pmedium->tymed != TYMED_ISTREAM &&
+      pmedium->tymed != TYMED_HGLOBAL && pmedium->tymed != TYMED_FILE)
+    return DV_E_TYMED;
+
   hres = IUnknown_QueryInterface(This->dataCache, &IID_IDataObject, (void**)&cacheDataObject);
   if (FAILED(hres))
     return E_UNEXPECTED;
diff --git a/dlls/ole32/tests/ole2.c b/dlls/ole32/tests/ole2.c
--- a/dlls/ole32/tests/ole2.c
+++ b/dlls/ole32/tests/ole2.c
@@ -2809,6 +2809,200 @@ static void test_data_cache_updatecache( void )
     IOleCache2_Release( cache );
 }
 
+static void test_data_cache_getdatahere(void)
+{
+    static const WCHAR file_name[] = L"wine_getdatahere.tmp";
+    IOleCache2 *cache;
+    IDataObject *data;
+    IStream *stream;
+    IStorage *storage;
+    FORMATETC fmt = { CF_DIB, 0, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med, here;
+    LARGE_INTEGER zero = {{0}};
+    DWORD conn, size, len;
+    HRESULT hr;
+    HGLOBAL hglobal;
+    char *ptr, *buf;
+    WCHAR path[MAX_PATH];
+    HANDLE file;
+
+    hr = CreateDataCache(NULL, &CLSID_NULL, &IID_IOleCache2, (void **)&cache);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = IOleCache2_QueryInterface(cache, &IID_IDataObject, (void **)&data);
+    ok(hr == S_OK, "got %08lx\n", hr);
+
+    hr = IOleCache2_Cache(cache, &fmt, 0, &conn);
+    ok(hr == S_OK, "got %08lx\n", hr);
+
+    memset(&here, 0, sizeof(here));
+    here.tymed = TYMED_HGLOBAL;
+    here.hGlobal = GlobalAlloc(GMEM_MOVEABLE, 1024);
+
+    /* nothing is cached yet */
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == OLE_E_BLANK, "got %08lx\n", hr);
+
+    create_dib(&med);
+    hr = IOleCache2_SetData(cache, &fmt, &med, TRUE);
+    ok(hr == S_OK, "got %08lx\n", hr);
+
+    hr = IDataObject_GetData(data, &fmt, &med);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    size = GlobalSize(med.hGlobal);
+
+    /* arguments */
+    hr = IDataObject_GetDataHere(data, NULL, &here);
+    ok(hr == E_INVALIDARG, "got %08lx\n", hr);
+    hr = IDataObject_GetDataHere(data, &fmt, NULL);
+    ok(hr == E_INVALIDARG, "got %08lx\n", hr);
+    fmt.lindex = 0;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_LINDEX, "got %08lx\n", hr);
+    fmt.lindex = -1;
+    here.tymed = TYMED_GDI;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_TYMED, "got %08lx\n", hr);
+    here.tymed = TYMED_HGLOBAL | TYMED_ISTREAM;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_TYMED, "got %08lx\n", hr);
+    here.tymed = TYMED_NULL;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_TYMED, "got %08lx\n", hr);
+    here.tymed = TYMED_HGLOBAL;
+    fmt.cfFormat = CF_TEXT;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_FORMATETC, "got %08lx\n", hr);
+    fmt.cfFormat = CF_DIB;
+
+    /* global memory: filled in place, never resized */
+    GlobalFree(here.hGlobal);
+    here.hGlobal = GlobalAlloc(GMEM_MOVEABLE, size - 1);
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == STG_E_MEDIUMFULL, "got %08lx\n", hr);
+    ok(GlobalSize(here.hGlobal) == size - 1, "size changed to %Iu\n", GlobalSize(here.hGlobal));
+    GlobalFree(here.hGlobal);
+    here.hGlobal = GlobalAlloc(GMEM_MOVEABLE | GMEM_ZEROINIT, size + 100);
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(GlobalSize(here.hGlobal) == size + 100, "size changed to %Iu\n", GlobalSize(here.hGlobal));
+    ptr = GlobalLock(here.hGlobal);
+    buf = GlobalLock(med.hGlobal);
+    ok(!memcmp(ptr, buf, size), "wrong data\n");
+    ok(!ptr[size] && !ptr[size + 99], "wrote past the data\n");
+    GlobalUnlock(here.hGlobal);
+    GlobalUnlock(med.hGlobal);
+    GlobalFree(here.hGlobal);
+
+    /* stream: from the stream's position */
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = IStream_Write(stream, "prefix", 6, NULL);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    here.tymed = TYMED_ISTREAM;
+    here.pstm = stream;
+    here.pUnkForRelease = NULL;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = IStream_Seek(stream, zero, STREAM_SEEK_CUR, NULL);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = GetHGlobalFromStream(stream, &hglobal);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ptr = GlobalLock(hglobal);
+    buf = GlobalLock(med.hGlobal);
+    ok(!memcmp(ptr, "prefix", 6), "the position was not kept\n");
+    ok(!memcmp(ptr + 6, buf, size), "wrong data\n");
+    GlobalUnlock(hglobal);
+    GlobalUnlock(med.hGlobal);
+    IStream_Release(stream);
+
+    /* file */
+    GetTempPathW(MAX_PATH, path);
+    lstrcatW(path, file_name);
+    here.tymed = TYMED_FILE;
+    here.lpszFileName = path;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    file = CreateFileW(path, GENERIC_READ, 0, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    len = GetFileSize(file, NULL);
+    ok(len == size, "got size %lu, expected %lu\n", len, size);
+    CloseHandle(file);
+    DeleteFileW(path);
+
+    /* storage */
+    hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_SHARE_EXCLUSIVE | STGM_CREATE | STGM_DELETEONRELEASE, 0, &storage);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    here.tymed = TYMED_ISTORAGE;
+    here.pstg = storage;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = IStorage_OpenStream(storage, L"\2OlePres000", NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &stream);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    if (hr == S_OK) IStream_Release(stream);
+    IStorage_Release(storage);
+
+    ReleaseStgMedium(&med);
+    IDataObject_Release(data);
+    IOleCache2_Release(cache);
+}
+
+static void test_default_handler_getdatahere(void)
+{
+    IOleObject *object;
+    IOleCache *cache;
+    IDataObject *data;
+    FORMATETC fmt = { CF_DIB, 0, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med, here;
+    DWORD conn;
+    HRESULT hr;
+
+    hr = OleCreateDefaultHandler(&CLSID_WineTest, NULL, &IID_IOleObject, (void **)&object);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = IOleObject_QueryInterface(object, &IID_IOleCache, (void **)&cache);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    hr = IOleObject_QueryInterface(object, &IID_IDataObject, (void **)&data);
+    ok(hr == S_OK, "got %08lx\n", hr);
+
+    memset(&here, 0, sizeof(here));
+    here.tymed = TYMED_HGLOBAL;
+    here.hGlobal = GlobalAlloc(GMEM_MOVEABLE, 1024);
+
+    hr = IDataObject_GetDataHere(data, NULL, &here);
+    ok(hr == E_INVALIDARG, "got %08lx\n", hr);
+    hr = IDataObject_GetDataHere(data, &fmt, NULL);
+    ok(hr == E_INVALIDARG, "got %08lx\n", hr);
+    fmt.lindex = 0;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_LINDEX, "got %08lx\n", hr);
+    fmt.lindex = -1;
+    here.tymed = TYMED_GDI;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == DV_E_TYMED, "got %08lx\n", hr);
+    here.tymed = TYMED_HGLOBAL;
+
+    /* not cached and not running */
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == OLE_E_NOTRUNNING, "got %08lx\n", hr);
+
+    hr = IOleCache_Cache(cache, &fmt, 0, &conn);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    create_dib(&med);
+    hr = IOleCache_SetData(cache, &fmt, &med, TRUE);
+    ok(hr == S_OK, "got %08lx\n", hr);
+
+    /* cached: answered by the cache, even though the object is not running */
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    fmt.cfFormat = CF_TEXT;
+    hr = IDataObject_GetDataHere(data, &fmt, &here);
+    ok(hr == OLE_E_NOTRUNNING, "got %08lx\n", hr);
+
+    GlobalFree(here.hGlobal);
+    IDataObject_Release(data);
+    IOleCache_Release(cache);
+    IOleObject_Release(object);
+}
+
 static void test_default_handler(void)
 {
     HRESULT hr;
@@ -4655,6 +4849,8 @@ START_TEST(ole2)
     test_data_cache_init();
     test_data_cache_initnew();
     test_data_cache_updatecache();
+    test_data_cache_getdatahere();
+    test_default_handler_getdatahere();
     test_default_handler();
     test_runnable();
     test_OleRun();
