+/* Modules loaded through MLLoadLibrary, one entry per load */
+static CRITICAL_SECTION ml_cs = { NULL, -1, 0, 0, 0, 0 };
+static HMODULE *ml_modules;
+static unsigned int ml_count, ml_size;
+
+static void ml_track_module(HMODULE module)
+{
+    EnterCriticalSection(&ml_cs);
+    if (ml_count == ml_size)
+    {
+        unsigned int new_size = ml_size ? ml_size * 2 : 8;
+        HMODULE *new_array = realloc(ml_modules, new_size * sizeof(*new_array));
+
+        if (!new_array)
+        {
+            LeaveCriticalSection(&ml_cs);
+            return;
+        }
+        ml_modules = new_array;
+        ml_size = new_size;
+    }
+    ml_modules[ml_count++] = module;
+    LeaveCriticalSection(&ml_cs);
+}
+
+static BOOL ml_find_module(HMODULE module, BOOL remove)
+{
+    unsigned int i;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection(&ml_cs);
+    for (i = 0; i < ml_count; i++)
+    {
+        if (ml_modules[i] != module) continue;
+        ret = TRUE;
+        if (remove) ml_modules[i] = ml_modules[--ml_count];
+        break;
+    }
+    LeaveCriticalSection(&ml_cs);
+    return ret;
+}
