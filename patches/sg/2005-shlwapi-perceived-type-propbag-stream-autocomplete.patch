From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shlwapi: implement the remaining genuine stubs

shlwapi: implement the remaining genuine stubs

AssocGetPerceivedType (built-in list, the PerceivedType registry value,
the major part of Content Type; UNSPECIFIED otherwise), the
SHCreateStreamWrapper stream methods CopyTo, Commit, Revert,
Lock/UnlockRegion and Clone (clones share the data), MLLoadLibraryA/W,
MLFreeLibrary and MLIsMLHInstance (list of modules loaded through ML),
SHSetDefaultDialogFont, SHGetInverseCMAP (argument checks and a real
table address instead of a bogus one), SHRegisterValidateTemplate (reads
the template file, fails if it cannot), SHCreatePropertyBagOnRegKey (an
IPropertyBag over a registry key), SHAutoComplete (file system source
through CLSID_ACListISF and CLSID_AutoComplete) and SHWinHelpOnDemandA/W
(forwarded to WinHelp). The StopWatch functions keep their documented
disabled behaviour and no longer log FIXMEs.
---
--- a/dlls/shlwapi/assoc.c
+++ b/dlls/shlwapi/assoc.c
@@ -100,6 +100,75 @@ HRESULT WINAPI AssocCreate(CLSID clsid, REFIID refiid, void **lpInterface)
   return SHCoCreateInstance( NULL, &clsid, NULL, refiid, lpInterface );
 }
 
+struct perceived_name
+{
+    const WCHAR *name;
+    PERCEIVED type;
+};
+
+static const struct perceived_name perceived_names[] =
+{
+    { L"text",        PERCEIVED_TYPE_TEXT },
+    { L"image",       PERCEIVED_TYPE_IMAGE },
+    { L"audio",       PERCEIVED_TYPE_AUDIO },
+    { L"video",       PERCEIVED_TYPE_VIDEO },
+    { L"compressed",  PERCEIVED_TYPE_COMPRESSED },
+    { L"document",    PERCEIVED_TYPE_DOCUMENT },
+    { L"system",      PERCEIVED_TYPE_SYSTEM },
+    { L"application", PERCEIVED_TYPE_APPLICATION },
+    { L"gamemedia",   PERCEIVED_TYPE_GAMEMEDIA },
+    { L"contacts",    PERCEIVED_TYPE_CONTACTS },
+};
+
+/* Extensions whose perceived type is built in rather than read from the
+ * registry. */
+static const struct { const WCHAR *ext; PERCEIVED type; } perceived_builtin[] =
+{
+    { L".txt", PERCEIVED_TYPE_TEXT },
+    { L".bmp", PERCEIVED_TYPE_IMAGE }, { L".dib", PERCEIVED_TYPE_IMAGE },
+    { L".gif", PERCEIVED_TYPE_IMAGE }, { L".jpg", PERCEIVED_TYPE_IMAGE },
+    { L".jpeg", PERCEIVED_TYPE_IMAGE }, { L".jpe", PERCEIVED_TYPE_IMAGE },
+    { L".png", PERCEIVED_TYPE_IMAGE }, { L".tif", PERCEIVED_TYPE_IMAGE },
+    { L".tiff", PERCEIVED_TYPE_IMAGE }, { L".ico", PERCEIVED_TYPE_IMAGE },
+    { L".wav", PERCEIVED_TYPE_AUDIO }, { L".mp3", PERCEIVED_TYPE_AUDIO },
+    { L".mid", PERCEIVED_TYPE_AUDIO }, { L".midi", PERCEIVED_TYPE_AUDIO },
+    { L".wma", PERCEIVED_TYPE_AUDIO }, { L".aif", PERCEIVED_TYPE_AUDIO },
+    { L".aiff", PERCEIVED_TYPE_AUDIO }, { L".au", PERCEIVED_TYPE_AUDIO },
+    { L".avi", PERCEIVED_TYPE_VIDEO }, { L".mpg", PERCEIVED_TYPE_VIDEO },
+    { L".mpeg", PERCEIVED_TYPE_VIDEO }, { L".wmv", PERCEIVED_TYPE_VIDEO },
+    { L".asf", PERCEIVED_TYPE_VIDEO },
+    { L".zip", PERCEIVED_TYPE_COMPRESSED },
+    { L".dll", PERCEIVED_TYPE_SYSTEM }, { L".sys", PERCEIVED_TYPE_SYSTEM },
+    { L".exe", PERCEIVED_TYPE_APPLICATION }, { L".com", PERCEIVED_TYPE_APPLICATION },
+};
+
+static const WCHAR *perceived_type_name(PERCEIVED type)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(perceived_names); i++)
+        if (perceived_names[i].type == type) return perceived_names[i].name;
+    return NULL;
+}
+
+static HRESULT perceived_result(PERCEIVED type, const WCHAR *name, int flags, PERCEIVED *out_type,
+                                INT *out_flags, LPWSTR *out_name)
+{
+    if (out_name)
+    {
+        *out_name = NULL;
+        if (name)
+        {
+            SIZE_T size = (lstrlenW(name) + 1) * sizeof(WCHAR);
+            if (!(*out_name = CoTaskMemAlloc(size))) return E_OUTOFMEMORY;
+            memcpy(*out_name, name, size);
+        }
+    }
+    *out_type = type;
+    *out_flags = flags;
+    return S_OK;
+}
