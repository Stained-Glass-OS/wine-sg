  */
 HRESULT WINAPI AssocGetPerceivedType(LPCWSTR lpszExt, PERCEIVED *lpType,
                                      INT *lpFlag, LPWSTR *lppszType)
 {
-  FIXME("(%s, %p, %p, %p) not supported\n", debugstr_w(lpszExt), lpType, lpFlag, lppszType);
+    WCHAR buf[128];
+    DWORD size;
+    unsigned int i;
+
+    TRACE("(%s, %p, %p, %p)\n", debugstr_w(lpszExt), lpType, lpFlag, lppszType);
+
+    if (lpszExt == NULL)
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    if (!lpType || !lpFlag)
+        return E_INVALIDARG;
+
+    *lpType = PERCEIVED_TYPE_UNSPECIFIED;
+    *lpFlag = PERCEIVEDFLAG_UNDEFINED;
+    if (lppszType) *lppszType = NULL;
 
-  if (lpszExt == NULL)
-    return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    if (lpszExt[0] != '.' || !lpszExt[1])
+        return perceived_result(PERCEIVED_TYPE_UNSPECIFIED, NULL, PERCEIVEDFLAG_UNDEFINED,
+                                lpType, lpFlag, lppszType);
+
+    for (i = 0; i < ARRAY_SIZE(perceived_builtin); i++)
+    {
+        if (!wcsicmp(lpszExt, perceived_builtin[i].ext))
+            return perceived_result(perceived_builtin[i].type, perceived_type_name(perceived_builtin[i].type),
+                                    PERCEIVEDFLAG_HARDCODED, lpType, lpFlag, lppszType);
+    }
