+struct reg_property_bag
+{
+    IPropertyBag IPropertyBag_iface;
+    LONG ref;
+    HKEY key;
+    BOOL writable;
+};
+
+static struct reg_property_bag *impl_from_IPropertyBag(IPropertyBag *iface)
+{
+    return CONTAINING_RECORD(iface, struct reg_property_bag, IPropertyBag_iface);
+}
+
+static HRESULT WINAPI reg_bag_QueryInterface(IPropertyBag *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IPropertyBag))
+    {
+        *obj = iface;
+        IPropertyBag_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI reg_bag_AddRef(IPropertyBag *iface)
+{
+    struct reg_property_bag *bag = impl_from_IPropertyBag(iface);
+    return InterlockedIncrement(&bag->ref);
+}
+
+static ULONG WINAPI reg_bag_Release(IPropertyBag *iface)
+{
+    struct reg_property_bag *bag = impl_from_IPropertyBag(iface);
+    ULONG ref = InterlockedDecrement(&bag->ref);
+
+    if (!ref)
+    {
+        RegCloseKey(bag->key);
+        free(bag);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI reg_bag_Read(IPropertyBag *iface, const WCHAR *name, VARIANT *var, IErrorLog *log)
+{
+    struct reg_property_bag *bag = impl_from_IPropertyBag(iface);
+    DWORD type, size = 0, err;
+    VARTYPE wanted;
+    VARIANT src;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("(%p)->(%s, %p, %p)\n", bag, debugstr_w(name), var, log);
+
+    if (!name || !var)
+        return E_POINTER;
+
+    wanted = V_VT(var);
+    err = RegQueryValueExW(bag->key, name, NULL, &type, NULL, &size);
+    if (err)
+        return HRESULT_FROM_WIN32(err);
+    if (!(data = calloc(1, size + sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    err = RegQueryValueExW(bag->key, name, NULL, &type, data, &size);
+    if (err)
+    {
+        free(data);
+        return HRESULT_FROM_WIN32(err);
+    }
+
+    VariantInit(&src);
+    switch (type)
+    {
+    case REG_SZ:
+    case REG_EXPAND_SZ:
+        V_VT(&src) = VT_BSTR;
+        V_BSTR(&src) = SysAllocString((WCHAR *)data);
+        hr = V_BSTR(&src) ? S_OK : E_OUTOFMEMORY;
+        break;
+    case REG_DWORD:
+        V_VT(&src) = VT_I4;
+        V_I4(&src) = size >= sizeof(DWORD) ? *(DWORD *)data : 0;
+        hr = S_OK;
+        break;
+    default:
+        hr = HRESULT_FROM_WIN32(ERROR_UNSUPPORTED_TYPE);
+        break;
+    }
+    free(data);
+    if (FAILED(hr))
+        return hr;
+
+#ifdef SG_MUTANT_PROPBAGREAD
+    wanted = VT_EMPTY;
+#endif
+    if (wanted == VT_EMPTY || wanted == V_VT(&src))
+    {
+        *var = src;
+        return S_OK;
+    }
+    VariantInit(var);
+    hr = VariantChangeType(var, &src, 0, wanted);
+    VariantClear(&src);
+    return hr;
+}
+
+static HRESULT WINAPI reg_bag_Write(IPropertyBag *iface, const WCHAR *name, VARIANT *var)
+{
+    struct reg_property_bag *bag = impl_from_IPropertyBag(iface);
+    VARIANT tmp;
+    HRESULT hr;
+    DWORD err;
+
+    TRACE("(%p)->(%s, %p)\n", bag, debugstr_w(name), var);
+
+    if (!name || !var)
+        return E_POINTER;
+    if (!bag->writable)
+        return STG_E_ACCESSDENIED;
+
+    VariantInit(&tmp);
+    switch (V_VT(var))
+    {
+    case VT_BOOL:
+    {
+        DWORD value = V_BOOL(var) != VARIANT_FALSE;
+        err = RegSetValueExW(bag->key, name, 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+        return HRESULT_FROM_WIN32(err);
+    }
+    case VT_I1: case VT_UI1: case VT_I2: case VT_UI2:
+    case VT_I4: case VT_UI4: case VT_INT: case VT_UINT:
+    {
+        DWORD value;
+
+        if (FAILED(hr = VariantChangeType(&tmp, var, 0, VT_UI4)))
+            return hr;
+        value = V_UI4(&tmp);
+        err = RegSetValueExW(bag->key, name, 0, REG_DWORD, (BYTE *)&value, sizeof(value));
+        return HRESULT_FROM_WIN32(err);
+    }
+    default:
+        if (FAILED(hr = VariantChangeType(&tmp, var, 0, VT_BSTR)))
+            return hr;
+        err = RegSetValueExW(bag->key, name, 0, REG_SZ, (BYTE *)V_BSTR(&tmp),
+                             (SysStringLen(V_BSTR(&tmp)) + 1) * sizeof(WCHAR));
