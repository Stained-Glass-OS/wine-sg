+#ifdef SG_MUTANT_PERCEIVED
+    return perceived_result(PERCEIVED_TYPE_UNSPECIFIED, NULL, PERCEIVEDFLAG_UNDEFINED,
+                            lpType, lpFlag, lppszType);
+#endif
+    size = sizeof(buf);
+    if (!RegGetValueW(HKEY_CLASSES_ROOT, lpszExt, L"PerceivedType", RRF_RT_REG_SZ, NULL, buf, &size)
+        && buf[0])
+    {
