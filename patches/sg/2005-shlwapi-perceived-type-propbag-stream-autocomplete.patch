+                return perceived_result(perceived_names[i].type, perceived_names[i].name,
+                                        PERCEIVEDFLAG_SOFTCODED, lpType, lpFlag, lppszType);
+        }
+        return perceived_result(PERCEIVED_TYPE_CUSTOM, buf, PERCEIVEDFLAG_SOFTCODED,
+                                lpType, lpFlag, lppszType);
+    }
+
+    size = sizeof(buf);
+    if (!RegGetValueW(HKEY_CLASSES_ROOT, lpszExt, L"Content Type", RRF_RT_REG_SZ, NULL, buf, &size))
+    {
+        WCHAR *slash = wcschr(buf, '/');
+
+        if (slash)
+        {
+            *slash = 0;
+            for (i = 0; i < ARRAY_SIZE(perceived_names); i++)
+            {
+                if (perceived_names[i].type > PERCEIVED_TYPE_VIDEO) break;
+                if (!wcsicmp(buf, perceived_names[i].name))
+                    return perceived_result(perceived_names[i].type, perceived_names[i].name,
+                                            PERCEIVEDFLAG_SOFTCODED, lpType, lpFlag, lppszType);
+            }
+        }
+    }
 
-  return E_NOTIMPL;
+    return perceived_result(PERCEIVED_TYPE_UNSPECIFIED, NULL, PERCEIVEDFLAG_UNDEFINED,
+                            lpType, lpFlag, lppszType);
 }
 
