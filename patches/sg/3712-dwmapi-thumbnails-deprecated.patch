+
+/**********************************************************************
+ * DWM thumbnails
+ *
+ * A thumbnail relationship shows a live picture of a top-level source window
+ * inside a destination window of the calling process.  There is no desktop
+ * compositor to draw it over the destination, so the process draws it itself:
+ * a thread copies the source window (PrintWindow) and paints it into the
+ * destination's client area in the rectangle the properties name, about
+ * twenty times a second while the thumbnail is visible, and has the destination
+ * repaint when it goes away or is hidden.
+ *
+ * The registry (under thumbnail_cs) holds the properties; the thread keeps the
+ * pictures in state of its own and never holds the lock while it draws, since
+ * printing a window sends messages to the window's thread, which may be waiting
+ * for the lock in one of the calls below.
+ */
+struct thumbnail
+{
+    struct list entry;
+    HTHUMBNAIL id;
+    HWND dest, src;
+    DWORD flags;               /* the DWM_TNP_* members that were set */
+    RECT dest_rect, src_rect;
+    BYTE opacity;
+    BOOL visible, client_only;
+    DWORD generation;          /* changes with every update of the properties */
+};
+
+/* the thread's view of one thumbnail */
+struct picture
+{
+    struct list entry;
+    HTHUMBNAIL id;
+    DWORD generation;
+    BOOL client_only;
+    HBITMAP bitmap;            /* the last picture of the source (a DIB section) */
+    BYTE *bits;
+    int width, height;
+    BOOL picture_new;          /* the picture changed since it was painted */
+    BYTE *composite;           /* the destination's pixels in composite_rect after painting */
+    RECT composite_rect;
+    BYTE *stale;               /* a picture that was painted and has to go before the next is */
+    RECT stale_rect;
+    int stale_wait;
+};
+
+static struct list thumbnails = LIST_INIT( thumbnails );
+static struct list pictures = LIST_INIT( pictures );   /* the thread's only */
+static CRITICAL_SECTION thumbnail_cs;
+static CRITICAL_SECTION_DEBUG thumbnail_cs_debug =
+{
+    0, 0, &thumbnail_cs,
+    { &thumbnail_cs_debug.ProcessLocksList, &thumbnail_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": thumbnail_cs") }
+};
+static CRITICAL_SECTION thumbnail_cs = { &thumbnail_cs_debug, -1, 0, 0, 0, 0 };
+static HANDLE thumbnail_thread;
+static ULONG_PTR next_thumbnail = 0x100;
+
+static struct thumbnail *find_thumbnail( HTHUMBNAIL id )
+{
+    struct thumbnail *t;
+
+    LIST_FOR_EACH_ENTRY( t, &thumbnails, struct thumbnail, entry )
+        if (t->id == id) return t;
+    return NULL;
+}
+
+static BOOL is_top_level( HWND hwnd )
+{
+    return IsWindow( hwnd ) && GetAncestor( hwnd, GA_PARENT ) == GetDesktopWindow();
+}
+
+static BOOL source_size( const struct thumbnail *t, SIZE *size )
+{
+    RECT rect;
+
+    if (!IsWindow( t->src )) return FALSE;
+#ifdef SG_MUTANT_THUMB_SIZE_WINDOW
+    if (0)
+#else
+    if (t->client_only)
+#endif
+        GetClientRect( t->src, &rect );
+    else GetWindowRect( t->src, &rect );
+    size->cx = rect.right - rect.left;
+    size->cy = rect.bottom - rect.top;
+    return TRUE;
+}
+
+/* the destination rectangle: the one set, or the source's size at the corner */
+static RECT thumbnail_dest_rect( const struct thumbnail *t )
+{
+    RECT rect;
+    SIZE size = { 0, 0 };
+
+    if (t->flags & DWM_TNP_RECTDESTINATION) return t->dest_rect;
+    source_size( t, &size );
+    SetRect( &rect, 0, 0, size.cx, size.cy );
+    return rect;
+}
+
+static HBITMAP create_dib( HDC dc, int width, int height, BYTE **bits )
+{
+    BITMAPINFO info = { { sizeof(BITMAPINFOHEADER), width, -height, 1, 32, BI_RGB } };
+    void *ptr = NULL;
+    HBITMAP bitmap = CreateDIBSection( dc, &info, DIB_RGB_COLORS, &ptr, NULL, 0 );
+
+    *bits = ptr;
+    return bitmap;
+}
+
+static BOOL same_pixels( const BYTE *a, const BYTE *b, int count )
+{
+    const DWORD *x = (const DWORD *)a, *y = (const DWORD *)b;
+    int i;
+
+    for (i = 0; i < count; i++) if ((x[i] ^ y[i]) & 0x00ffffff) return FALSE;
+    return TRUE;
+}
+
+static void free_picture( struct picture *pic )
+{
+    list_remove( &pic->entry );
+    if (pic->bitmap) DeleteObject( pic->bitmap );
+    free( pic->composite );
+    free( pic->stale );
+    free( pic );
+}
+
+/* take a new picture of the source; picture_new is set when it differs */
+static void refresh_picture( struct picture *pic, const struct thumbnail *t )
+{
+    SIZE size;
+    HDC screen, mem;
+    HBITMAP bitmap;
+    HGDIOBJ old;
+    BYTE *bits;
+
+    if (!source_size( t, &size ) || size.cx <= 0 || size.cy <= 0 || IsIconic( t->src ) || !IsWindowVisible( t->src ))
+        return;
+    screen = GetDC( 0 );
+    mem = CreateCompatibleDC( screen );
+    bitmap = create_dib( screen, size.cx, size.cy, &bits );
+    ReleaseDC( 0, screen );
+    if (!bitmap)
+    {
+        DeleteDC( mem );
+        return;
+    }
+    old = SelectObject( mem, bitmap );
+    if (PrintWindow( t->src, mem, (t->client_only ? PW_CLIENTONLY : 0) | PW_RENDERFULLCONTENT ))
+    {
+        if (!pic->bitmap || pic->width != size.cx || pic->height != size.cy ||
+            !same_pixels( bits, pic->bits, size.cx * size.cy ))
+            pic->picture_new = TRUE;
+        if (pic->bitmap) DeleteObject( pic->bitmap );
+        pic->bitmap = bitmap;
+        pic->bits = bits;
+        pic->width = size.cx;
+        pic->height = size.cy;
+        bitmap = NULL;
+    }
+    SelectObject( mem, old );
+    if (bitmap) DeleteObject( bitmap );
+    DeleteDC( mem );
+}
+
+/* what the destination shows in a rectangle, as 32-bit pixels */
+static BYTE *capture_dest( HDC dc, const RECT *rect )
+{
+    int width = rect->right - rect->left, height = rect->bottom - rect->top;
+    HDC mem = CreateCompatibleDC( dc );
+    HBITMAP bitmap;
+    HGDIOBJ old;
+    BYTE *bits, *copy = NULL;
+
+    if ((bitmap = create_dib( dc, width, height, &bits )))
+    {
+        old = SelectObject( mem, bitmap );
+        if (BitBlt( mem, 0, 0, width, height, dc, rect->left, rect->top, SRCCOPY ) && (copy = malloc( width * height * 4 )))
+            memcpy( copy, bits, width * height * 4 );
+        SelectObject( mem, old );
+        DeleteObject( bitmap );
+    }
+    DeleteDC( mem );
+    return copy;
+}
+
+static void draw_thumbnail( const struct picture *pic, BYTE opacity, HDC dc, const RECT *dest, const RECT *src )
+{
+    HDC mem = CreateCompatibleDC( dc );
+    HGDIOBJ old = SelectObject( mem, pic->bitmap );
+    int mode;
+
+#ifdef SG_MUTANT_THUMB_NO_OPACITY
+    opacity = 255;
+#endif
+    if (opacity == 255)
+    {
+        mode = SetStretchBltMode( dc, HALFTONE );
+        StretchBlt( dc, dest->left, dest->top, dest->right - dest->left, dest->bottom - dest->top,
+                    mem, src->left, src->top, src->right - src->left, src->bottom - src->top, SRCCOPY );
+        SetStretchBltMode( dc, mode );
+    }
+    else if (opacity)
+    {
+        BLENDFUNCTION blend = { AC_SRC_OVER, 0, opacity, 0 };
+        HDC scaled = CreateCompatibleDC( dc );
+        HBITMAP bmp = CreateCompatibleBitmap( dc, dest->right - dest->left, dest->bottom - dest->top );
+        HGDIOBJ old2 = SelectObject( scaled, bmp );
+
+        mode = SetStretchBltMode( scaled, HALFTONE );
+        StretchBlt( scaled, 0, 0, dest->right - dest->left, dest->bottom - dest->top,
+                    mem, src->left, src->top, src->right - src->left, src->bottom - src->top, SRCCOPY );
+        SetStretchBltMode( scaled, mode );
+        GdiAlphaBlend( dc, dest->left, dest->top, dest->right - dest->left, dest->bottom - dest->top,
+                       scaled, 0, 0, dest->right - dest->left, dest->bottom - dest->top, blend );
+        SelectObject( scaled, old2 );
+        DeleteObject( bmp );
+        DeleteDC( scaled );
+    }
+    SelectObject( mem, old );
+    DeleteDC( mem );
+}
+
+/* Paint the picture when the destination does not show the last thing painted
+ * (the destination drew over it, or the picture changed).  Blending a
+ * translucent picture twice over itself would add up, so a changed translucent
+ * picture first has the destination redraw its background and is blended on the
+ * next pass. */
+static void paint_thumbnail( struct picture *pic, const struct thumbnail *t )
+{
+    RECT dest = thumbnail_dest_rect( t ), src, full = { 0, 0, pic->width, pic->height }, client;
+    HDC dc;
+    BYTE *now;
+    BOOL same;
+
+    if (!pic->bitmap || !IsWindow( t->dest ) || !IsWindowVisible( t->dest ) || IsIconic( t->dest )) return;
+#ifndef SG_MUTANT_THUMB_NO_SRCRECT
+    if (t->flags & DWM_TNP_RECTSOURCE) src = t->src_rect;
+    else
+#endif
+    src = full;
+    IntersectRect( &src, &src, &full );
+    GetClientRect( t->dest, &client );
+    IntersectRect( &dest, &dest, &client );
+    if (IsRectEmpty( &src ) || IsRectEmpty( &dest )) return;
+
+    if (!(dc = GetDC( t->dest ))) return;
+    if (pic->stale)
+    {
+        /* the destination redraws under the old picture before the new one is
+         * blended: until what it shows differs from that, it has not */
+        now = capture_dest( dc, &pic->stale_rect );
+        if (now && same_pixels( now, pic->stale, (pic->stale_rect.right - pic->stale_rect.left) *
+                                                (pic->stale_rect.bottom - pic->stale_rect.top) ) && ++pic->stale_wait < 10)
+        {
+            InvalidateRect( t->dest, &pic->stale_rect, TRUE );
+            free( now );
+            ReleaseDC( t->dest, dc );
+            return;
+        }
+        free( now );
+        free( pic->stale );
+        pic->stale = NULL;
+    }
+    now = capture_dest( dc, &dest );
+    same = now && pic->composite && EqualRect( &dest, &pic->composite_rect ) &&
+           same_pixels( now, pic->composite, (dest.right - dest.left) * (dest.bottom - dest.top) );
+    free( now );
+    if (same && !pic->picture_new)
+    {
+        ReleaseDC( t->dest, dc );
+        return;
+    }
+#ifdef SG_MUTANT_THUMB_ACCUM
+    if (0)
+#else
+    if (same && t->opacity < 255)
+#endif
+    {
+        /* our own blend is what is there: have the destination draw under it again */
+        InvalidateRect( t->dest, &dest, TRUE );
+        free( pic->composite );
+        pic->composite = NULL;
+        ReleaseDC( t->dest, dc );
+        return;
+    }
+    draw_thumbnail( pic, t->opacity, dc, &dest, &src );
+    free( pic->composite );
+    pic->composite = capture_dest( dc, &dest );
+    pic->composite_rect = dest;
+    pic->picture_new = FALSE;
+    ReleaseDC( t->dest, dc );
+}
+
+static struct picture *find_picture( HTHUMBNAIL id )
+{
+    struct picture *pic;
+
+    LIST_FOR_EACH_ENTRY( pic, &pictures, struct picture, entry )
+        if (pic->id == id) return pic;
+    return NULL;
+}
+
+static DWORD WINAPI thumbnail_thread_proc( void *arg )
+{
+    DWORD tick = 0;
+
+    for (;;)
+    {
+        struct thumbnail work[16], *t;
+        struct picture *pic, *next;
+        unsigned int count = 0, i;
+        BOOL idle;
+
+        Sleep( 50 );
+
+        EnterCriticalSection( &thumbnail_cs );
+        LIST_FOR_EACH_ENTRY( t, &thumbnails, struct thumbnail, entry )
+            if (t->visible && count < ARRAY_SIZE(work)) work[count++] = *t;
+        idle = list_empty( &thumbnails );
+        if (idle)
+        {
+            CloseHandle( thumbnail_thread );
+            thumbnail_thread = NULL;
+        }
+        LeaveCriticalSection( &thumbnail_cs );
+
+        /* pictures of thumbnails that are gone or hidden */
+        LIST_FOR_EACH_ENTRY_SAFE( pic, next, &pictures, struct picture, entry )
+        {
+            for (i = 0; i < count; i++) if (work[i].id == pic->id) break;
+            if (i == count) free_picture( pic );
+        }
+        if (idle) return 0;
+
+        for (i = 0; i < count; i++)
+        {
+            RECT rect;
+            BOOL gone;
+
+            pic = find_picture( work[i].id );
+            if (!pic)
+            {
+                if (!(pic = calloc( 1, sizeof(*pic) ))) continue;
+                pic->id = work[i].id;
+                pic->generation = work[i].generation;
+                pic->client_only = work[i].client_only;
+                list_add_tail( &pictures, &pic->entry );
+            }
+            if (pic->generation != work[i].generation)
+            {
+                /* new properties: the picture is taken again and painted afresh */
+                pic->generation = work[i].generation;
+                free( pic->stale );
+                pic->stale = pic->composite;     /* what is on the destination now */
+                pic->stale_rect = pic->composite_rect;
+                pic->stale_wait = 0;
+                pic->composite = NULL;
+                pic->picture_new = TRUE;
+                if (pic->stale && IsWindow( work[i].dest )) InvalidateRect( work[i].dest, &pic->stale_rect, TRUE );
+                if (pic->client_only != work[i].client_only && pic->bitmap)
+                {
+                    DeleteObject( pic->bitmap );
+                    pic->bitmap = NULL;
+                }
+                pic->client_only = work[i].client_only;
+            }
+            if (!pic->bitmap || !(tick % 2)) refresh_picture( pic, &work[i] );
+            paint_thumbnail( pic, &work[i] );
+
+            /* unregistered or hidden while it was drawn: take it back */
+            EnterCriticalSection( &thumbnail_cs );
+            t = find_thumbnail( work[i].id );
+            gone = !t || !t->visible || t->generation != work[i].generation;
+            if (gone && !t) rect = thumbnail_dest_rect( &work[i] );
+            LeaveCriticalSection( &thumbnail_cs );
+#ifndef SG_MUTANT_THUMB_NO_INVALIDATE
+            if (gone && !t && IsWindow( work[i].dest )) InvalidateRect( work[i].dest, &rect, TRUE );
+#endif
+        }
+        tick++;
+    }
+}
+
+/**********************************************************************
+ *           DwmRegisterThumbnail         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmRegisterThumbnail(HWND dest, HWND src, PHTHUMBNAIL thumbnail_id)
+{
+    struct thumbnail *t;
+    DWORD pid = 0;
+
+    TRACE("(%p %p %p)\n", dest, src, thumbnail_id);
+
+    if (!thumbnail_id) return E_INVALIDARG;
+    if (!is_top_level( src )) return E_INVALIDARG;
+    if (dest != GetDesktopWindow())
+    {
+        if (!is_top_level( dest )) return E_INVALIDARG;
+        /* only the owner's own windows can show thumbnails */
+        GetWindowThreadProcessId( dest, &pid );
+#ifndef SG_MUTANT_THUMB_ANY_DEST
+        if (pid != GetCurrentProcessId()) return E_ACCESSDENIED;
+#endif
+    }
+
+    if (!(t = calloc( 1, sizeof(*t) ))) return E_OUTOFMEMORY;
+    t->dest = dest;
+    t->src = src;
+    t->opacity = 255;
+#ifdef SG_MUTANT_THUMB_VISIBLE_DEFAULT
+    t->visible = TRUE;
+#endif
+
+    EnterCriticalSection( &thumbnail_cs );
+    t->id = (HTHUMBNAIL)(next_thumbnail += 4);
+    list_add_tail( &thumbnails, &t->entry );
+    *thumbnail_id = t->id;
+#ifdef SG_MUTANT_THUMB_VISIBLE_DEFAULT
+    if (!thumbnail_thread) thumbnail_thread = CreateThread( NULL, 0, thumbnail_thread_proc, NULL, 0, NULL );
+#endif
+    LeaveCriticalSection( &thumbnail_cs );
+    return S_OK;
+}
+
+/**********************************************************************
+ *           DwmUnregisterThumbnail         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmUnregisterThumbnail(HTHUMBNAIL thumbnail)
+{
+    struct thumbnail *t;
+    HRESULT hr = E_INVALIDARG;
+    RECT rect = { 0 };
+    HWND dest = NULL;
+
+    TRACE("(%p)\n", thumbnail);
+
+    EnterCriticalSection( &thumbnail_cs );
+    if ((t = find_thumbnail( thumbnail )))
+    {
+        if (t->visible)
+        {
+            dest = t->dest;
+            rect = thumbnail_dest_rect( t );
+        }
+        list_remove( &t->entry );
+        free( t );
+        hr = S_OK;
+    }
+    LeaveCriticalSection( &thumbnail_cs );
+    /* what it covered is the destination's to draw again */
+#ifndef SG_MUTANT_THUMB_NO_INVALIDATE
+    if (dest && IsWindow( dest )) InvalidateRect( dest, &rect, TRUE );
+#endif
+    return hr;
+}
+
+/**********************************************************************
+ *           DwmUpdateThumbnailProperties         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmUpdateThumbnailProperties(HTHUMBNAIL thumbnail, const DWM_THUMBNAIL_PROPERTIES *props)
+{
+    struct thumbnail *t;
+    HRESULT hr = E_INVALIDARG;
+    RECT old_rect = { 0 };
+    HWND dest = NULL;
+
+    TRACE("(%p, %p)\n", thumbnail, props);
+
+    if (!props) return E_INVALIDARG;
+    EnterCriticalSection( &thumbnail_cs );
+    if ((t = find_thumbnail( thumbnail )) && !(props->dwFlags & ~0x1f))
+    {
+        if (t->visible)
+        {
+            dest = t->dest;
+            old_rect = thumbnail_dest_rect( t );
+        }
+        if (props->dwFlags & DWM_TNP_RECTDESTINATION) { t->dest_rect = props->rcDestination; t->flags |= DWM_TNP_RECTDESTINATION; }
+        if (props->dwFlags & DWM_TNP_RECTSOURCE) { t->src_rect = props->rcSource; t->flags |= DWM_TNP_RECTSOURCE; }
+        if (props->dwFlags & DWM_TNP_OPACITY) t->opacity = props->opacity;
+        if (props->dwFlags & DWM_TNP_VISIBLE) t->visible = !!props->fVisible;
+        if (props->dwFlags & DWM_TNP_SOURCECLIENTAREAONLY) t->client_only = !!props->fSourceClientAreaOnly;
+        t->generation++;
+        if (t->visible && !thumbnail_thread)
+            thumbnail_thread = CreateThread( NULL, 0, thumbnail_thread_proc, NULL, 0, NULL );
+        hr = S_OK;
+    }
+    LeaveCriticalSection( &thumbnail_cs );
+    /* what it covered before (moved, hidden, less opaque) is the destination's again */
+    if (dest && IsWindow( dest )) InvalidateRect( dest, &old_rect, TRUE );
+    return hr;
+}
+
+/**********************************************************************
+ *           DwmQueryThumbnailSourceSize         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmQueryThumbnailSourceSize(HTHUMBNAIL thumbnail, SIZE *size)
+{
+    struct thumbnail *t;
+    HRESULT hr = E_INVALIDARG;
+
+    TRACE("(%p, %p)\n", thumbnail, size);
+
+    if (!size) return E_INVALIDARG;
+    EnterCriticalSection( &thumbnail_cs );
+    if ((t = find_thumbnail( thumbnail )) && source_size( t, size )) hr = S_OK;
+    LeaveCriticalSection( &thumbnail_cs );
+    return hr;
+}
