 }
 
 static HRESULT WINAPI mpeg_audio_decoder_get_AudioFormat(IMpegAudioDecoder *iface, MPEG1WAVEFORMAT *format)
 {
-    FIXME("iface %p, format %p, stub!\n", iface, format);
-    return E_NOTIMPL;
+    struct transform *filter = impl_from_IMpegAudioDecoder(iface);
+    const AM_MEDIA_TYPE *mt = &filter->sink.pin.mt;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, format %p.\n", iface, format);
+
+    if (!format)
+        return E_POINTER;
+
+    /* The format of the stream on the input pin; there is none until the
+     * pin is connected. */
+    EnterCriticalSection(&filter->filter.filter_cs);
+#ifdef SG_MUTANT_MPEGAUDIOFMT
+    if (0)
+#else
+    if (!filter->sink.pin.peer)
+#endif
+        hr = VFW_E_NOT_CONNECTED;
+    else if (!IsEqualGUID(&mt->formattype, &FORMAT_WaveFormatEx) || mt->cbFormat < sizeof(WAVEFORMATEX))
+        hr = VFW_E_TYPE_NOT_ACCEPTED;
+    else
+    {
+        memset(format, 0, sizeof(*format));
+        memcpy(format, mt->pbFormat, min(mt->cbFormat, sizeof(*format)));
+    }
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return hr;
 }
 
 static const IMpegAudioDecoderVtbl mpeg_audio_decoder_vtbl =
@@ -764,6 +860,12 @@ HRESULT mpeg_audio_codec_create(IUnknown *outer, IUnknown **out)
     wcscpy(object->source.pin.name, L"XForm Out");
 
     object->IMpegAudioDecoder_iface.lpVtbl = &mpeg_audio_decoder_vtbl;
+    object->mpeg_audio.divider = 1;
+#ifdef SG_MUTANT_MPEGDEFAULT
+    object->mpeg_audio.word_size = 8;
+#else
+    object->mpeg_audio.word_size = 16;
+#endif
 
     TRACE("Created MPEG audio decoder %p.\n", object);
     *out = &object->filter.IUnknown_inner;
