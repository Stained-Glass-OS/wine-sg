From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winegstreamer: IMpegAudioDecoder settings of the MPEG audio decoder

The DirectShow MPEG audio decoder's IMpegAudioDecoder get_/put_
FrequencyDivider (1, 2, 4; default 1), DecoderAccuracy, Stereo,
DecoderWordSize (8 or 16; default 16), IntegerDecode (0 or 1; default 0) and
DualMode (merge, left, right: 0..2; default 0) keep their values and
reject others with E_INVALIDARG (NULL out pointers: E_POINTER; they were
E_NOTIMPL). get_AudioFormat returns the MPEG1WAVEFORMAT of the connected
input pin, VFW_E_NOT_CONNECTED before that. The GStreamer decoder does not
act on the settings.

---
diff --git a/dlls/winegstreamer/quartz_transform.c b/dlls/winegstreamer/quartz_transform.c
index ff57ea0..b2426d8 100644
--- a/dlls/winegstreamer/quartz_transform.c
+++ b/dlls/winegstreamer/quartz_transform.c
@@ -44,6 +44,12 @@ struct transform
     struct wg_sample_queue *sample_queue;
 
     const struct transform_ops *ops;
+
+    /* IMpegAudioDecoder settings; the GStreamer decoder does not use them. */
+    struct
+    {
+        ULONG divider, accuracy, stereo, word_size, integer_decode, dual_mode;
+    } mpeg_audio;
 };
 
 struct transform_ops
@@ -171,82 +177,172 @@ static ULONG WINAPI mpeg_audio_decoder_Release(IMpegAudioDecoder *iface)
     return IUnknown_Release(filter->filter.outer_unk);
 }
 
+/* The settings of the DirectShow MPEG audio decoder: values that are not
+ * valid for a setting are rejected with E_INVALIDARG, NULL pointers with
+ * E_POINTER. They are only stored; the decoder behind this filter always
+ * decodes at the full rate, to 16 bit samples. */
+static HRESULT mpeg_audio_get(struct transform *filter, ULONG *dst, const ULONG *src)
+{
+    if (!dst)
+        return E_POINTER;
+    EnterCriticalSection(&filter->filter.filter_cs);
+    *dst = *src;
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return S_OK;
+}
+
+static HRESULT mpeg_audio_put(struct transform *filter, ULONG *dst, ULONG value, BOOL valid)
+{
+    if (!valid)
+        return E_INVALIDARG;
+    EnterCriticalSection(&filter->filter.filter_cs);
+    *dst = value;
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return S_OK;
+}
+
 static HRESULT WINAPI mpeg_audio_decoder_get_FrequencyDivider(IMpegAudioDecoder *iface, ULONG *divider)
 {
-    FIXME("iface %p, divider %p, stub!\n", iface, divider);
-    return E_NOTIMPL;
+    struct transform *filter = impl_from_IMpegAudioDecoder(iface);
+
+    TRACE("iface %p, divider %p.\n", iface, divider);
+
+    return mpeg_audio_get(filter, divider, &filter->mpeg_audio.divider);
 }
 
 static HRESULT WINAPI mpeg_audio_decoder_put_FrequencyDivider(IMpegAudioDecoder *iface, ULONG divider)
 {
-    FIXME("iface %p, divider %lu, stub!\n", iface, divider);
-    return E_NOTIMPL;
+    struct transform *filter = impl_from_IMpegAudioDecoder(iface);
+
+    TRACE("iface %p, divider %lu.\n", iface, divider);
+
+#ifdef SG_MUTANT_MPEGDIV
+    return mpeg_audio_put(filter, &filter->mpeg_audio.divider, divider, TRUE);
+#else
+    return mpeg_audio_put(filter, &filter->mpeg_audio.divider, divider, divider == 1 || divider == 2 || divider == 4);
+#endif
 }
 
