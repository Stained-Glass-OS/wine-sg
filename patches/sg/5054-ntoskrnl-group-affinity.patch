From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl: Implement KeQueryGroupAffinity.

KeQueryGroupAffinity gives the active processor set for group 0 and an empty
set for other groups (all processors are in group 0 here); it returned 0.
KeGetCurrentProcessorNumberEx was complete for one group: its FIXME becomes
a TRACE.

Gate: test/ntoskrnl-procgroup-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 9e25dbd..f320e55 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3545,7 +3545,8 @@ ULONG WINAPI KeGetCurrentProcessorNumberEx(PPROCESSOR_NUMBER process_number)
 {
     ULONG cur_number = NtGetCurrentProcessorNumber();
 
-    FIXME("%p semi-stub\n", process_number);
+    /* all processors are in group 0 here */
+    TRACE("%p\n", process_number);
 
     if (process_number)
     {
@@ -3562,8 +3563,13 @@ ULONG WINAPI KeGetCurrentProcessorNumberEx(PPROCESSOR_NUMBER process_number)
  */
 KAFFINITY WINAPI KeQueryGroupAffinity(USHORT group_number)
 {
-    FIXME("%u stub\n", group_number);
+    TRACE("%u\n", group_number);
+    /* "the set of active processors in the group"; there is one group */
+#ifndef SG_MUTANT_GROUP_AFFINITY_ZERO
+    return group_number ? 0 : KeQueryActiveProcessors();
+#else
     return 0;
+#endif
 }
 
