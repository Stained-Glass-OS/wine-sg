From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: config stream Seek, Stat, CopyTo, Commit (3598)

mscoree: config stream Seek, Stat, CopyTo, Commit

The stream returned by CreateConfigStream is a read-only view of a file;
it can now be repositioned, queried for its size and times, copied to
another stream, and committed (a no-op for a read-only stream).
---
diff --git a/dlls/mscoree/config.c b/dlls/mscoree/config.c
index 770facf..92680ef 100644
--- a/dlls/mscoree/config.c
+++ b/dlls/mscoree/config.c
@@ -145,10 +145,28 @@ static HRESULT WINAPI ConfigStream_Seek(IStream *iface, LARGE_INTEGER dlibMove,
                                         DWORD dwOrigin, ULARGE_INTEGER *pNewPos)
 {
     ConfigStream *This = impl_from_IStream(iface);
-    TRACE("(%p)->(%ld %ld %p)\n", This, dlibMove.u.LowPart, dwOrigin, pNewPos);
-    return E_NOTIMPL;
-}
+    LARGE_INTEGER pos;
+    DWORD method;
+
+    TRACE("(%p)->(%I64d %ld %p)\n", This, dlibMove.QuadPart, dwOrigin, pNewPos);
+
+    switch (dwOrigin)
+    {
+    case STREAM_SEEK_SET: method = FILE_BEGIN; break;
+    case STREAM_SEEK_CUR: method = FILE_CURRENT; break;
+    case STREAM_SEEK_END: method = FILE_END; break;
+    default: return STG_E_INVALIDFUNCTION;
+    }
+
+    if (!SetFilePointerEx(This->file, dlibMove, &pos, method))
+        return STG_E_INVALIDFUNCTION;
 
+    if (pNewPos) pNewPos->QuadPart = pos.QuadPart;
+#ifdef SG_MUTANT_CONFIGSTREAM_SEEK
+    if (pNewPos) pNewPos->QuadPart = 0;
+#endif
+    return S_OK;
+}
 static HRESULT WINAPI ConfigStream_SetSize(IStream *iface, ULARGE_INTEGER libNewSize)
 {
     ConfigStream *This = impl_from_IStream(iface);
@@ -160,17 +178,48 @@ static HRESULT WINAPI ConfigStream_CopyTo(IStream *iface, IStream *stream, ULARG
                                           ULARGE_INTEGER *read, ULARGE_INTEGER *written)
 {
     ConfigStream *This = impl_from_IStream(iface);
-    FIXME("(%p)->(%p %ld %p %p)\n", This, stream, size.u.LowPart, read, written);
-    return E_NOTIMPL;
-}
+    ULARGE_INTEGER total_read = {{0}}, total_written = {{0}};
+    HRESULT hr = S_OK;
+    BYTE buf[4096];
+
+    TRACE("(%p)->(%p %I64u %p %p)\n", This, stream, size.QuadPart, read, written);
+
+    if (!stream)
+        return STG_E_INVALIDPOINTER;
+
+    while (total_read.QuadPart < size.QuadPart)
+    {
+        ULONGLONG left = size.QuadPart - total_read.QuadPart;
+        DWORD want = left < sizeof(buf) ? (DWORD)left : sizeof(buf), got = 0, put = 0;
+
+        if (!ReadFile(This->file, buf, want, &got, NULL))
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            break;
+        }
+        if (!got) break;
+        total_read.QuadPart += got;
+
+        hr = IStream_Write(stream, buf, got, &put);
+        total_written.QuadPart += put;
+        if (FAILED(hr) || put != got)
+        {
+            if (SUCCEEDED(hr)) hr = STG_E_MEDIUMFULL;
+            break;
+        }
+    }
 
+    if (read) *read = total_read;
+    if (written) *written = total_written;
+    return hr;
+}
 static HRESULT WINAPI ConfigStream_Commit(IStream *iface, DWORD flags)
 {
     ConfigStream *This = impl_from_IStream(iface);
-    FIXME("(%p,%ld)\n", This, flags);
-    return E_NOTIMPL;
+    TRACE("(%p,%ld)\n", This, flags);
+    /* nothing is ever pending on a read-only stream */
+    return S_OK;
 }
-
 static HRESULT WINAPI ConfigStream_Revert(IStream *iface)
 {
     ConfigStream *This = impl_from_IStream(iface);
@@ -189,10 +238,27 @@ static HRESULT WINAPI ConfigStream_LockUnlockRegion(IStream *iface, ULARGE_INTEG
 static HRESULT WINAPI ConfigStream_Stat(IStream *iface, STATSTG *lpStat, DWORD grfStatFlag)
 {
     ConfigStream *This = impl_from_IStream(iface);
-    FIXME("(%p,%p,%ld)\n", This, lpStat, grfStatFlag);
-    return E_NOTIMPL;
-}
+    BY_HANDLE_FILE_INFORMATION info;
+
+    TRACE("(%p,%p,%ld)\n", This, lpStat, grfStatFlag);
+
+    if (!lpStat)
+        return STG_E_INVALIDPOINTER;
 
+    memset(lpStat, 0, sizeof(*lpStat));
+
+    if (!GetFileInformationByHandle(This->file, &info))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    lpStat->type = STGTY_STREAM;
+    lpStat->cbSize.u.LowPart = info.nFileSizeLow;
+    lpStat->cbSize.u.HighPart = info.nFileSizeHigh;
+    lpStat->mtime = info.ftLastWriteTime;
+    lpStat->ctime = info.ftCreationTime;
+    lpStat->atime = info.ftLastAccessTime;
+    lpStat->grfMode = STGM_READ | STGM_SHARE_DENY_WRITE;
+    return S_OK;
+}
 static HRESULT WINAPI ConfigStream_Clone(IStream *iface, IStream **ppstm)
 {
     ConfigStream *This = impl_from_IStream(iface);
