+/* WTInfo values of a cursor that a manager has changed; 0 if the driver's value stands */
+UINT TABLET_CursorInfo(UINT category, UINT index, void *out)
+{
+    const void *src = NULL;
+    UINT size = 0;
+    struct cursor_settings *c;
+    UINT csr;
+
+    if (category < WTI_CURSORS || category >= WTI_CURSORS + MAX_CURSORS) return 0;
+    csr = category - WTI_CURSORS;
+    c = &cursors[csr];
+
+    EnterCriticalSection(&csTablet);
+    switch (index)
+    {
+    case CSR_BUTTONMAP: if (c->has_map) { src = c->btn_map; size = 32; } break;
+    case CSR_SYSBTNMAP: if (c->has_sysmap) { src = c->sys_map; size = 32; } break;
+    case CSR_NPBTNMARKS: if (c->has_np_marks) { src = c->np_marks; size = sizeof(c->np_marks); } break;
+    case CSR_TPBTNMARKS: if (c->has_tp_marks) { src = c->tp_marks; size = sizeof(c->tp_marks); } break;
+    case CSR_NPRESPONSE: if (c->has_np_resp) { src = c->np_resp; size = sizeof(c->np_resp); } break;
+    case CSR_TPRESPONSE: if (c->has_tp_resp) { src = c->tp_resp; size = sizeof(c->tp_resp); } break;
+    }
+#ifdef SG_MUTANT_WINTAB_INFO
+    size = 0;
+#endif
+    if (src && out) memcpy(out, src, size);
+    LeaveCriticalSection(&csTablet);
+    return size;
+}
+
+static UINT response_value(const UINT *table, UINT value, UINT index)
+{
+    AXIS axis;
+    LONGLONG pos;
+
+    if (!pWTInfoW || pWTInfoW(WTI_DEVICES, index, &axis) != sizeof(axis) || axis.axMax <= axis.axMin)
+        return value;
+#ifdef SG_MUTANT_WINTAB_RESP
+    pos = (LONGLONG)((LONG)value - axis.axMin) * (RESPONSE_ENTRIES - 1) / (axis.axMax - axis.axMin) / 2;
+#else
+    pos = (LONGLONG)((LONG)value - axis.axMin) * (RESPONSE_ENTRIES - 1) / (axis.axMax - axis.axMin);
+#endif
+    if (pos < 0) pos = 0;
+    if (pos > RESPONSE_ENTRIES - 1) pos = RESPONSE_ENTRIES - 1;
+    return table[pos];
 }
 
+static void pressure_button(BOOL *down, const UINT marks[2], UINT pressure, DWORD bit, DWORD *buttons)
+{
+#ifndef SG_MUTANT_WINTAB_MARKS
+    if (marks[1] <= marks[0]) return;
+#endif   /* invalid marks switch the button events off */
+    if (!*down && pressure > marks[1]) *down = TRUE;
+    else if (*down && pressure < marks[0]) *down = FALSE;
+    if (*down) *buttons |= 1u << bit; else *buttons &= ~(1u << bit);
+}
+
+/* Applies the manager's cursor settings to a packet and runs the record hooks.
+ * Returns FALSE when the packet is to be dropped. */
+BOOL TABLET_FilterPacket(WTPACKET *packet)
+{
+    struct cursor_settings *c;
+    struct packet_hook *h;
+    WTHOOKPROC proc = NULL;
+    UINT csr = packet->pkCursor;
+
+    if (csr < MAX_CURSORS)
+    {
+        c = &cursors[csr];
+        EnterCriticalSection(&csTablet);
+#ifndef SG_MUTANT_WINTAB_ENABLE
+        if (c->disabled)
+#else
+        if (0)
+#endif
+        {
+            LeaveCriticalSection(&csTablet);
+            return FALSE;
+        }
+#ifndef SG_MUTANT_WINTAB_MAP
+        if (c->has_map)
+#else
+        if (0)
+#endif
+        {
+            DWORD in = packet->pkButtons, out = 0;
+            UINT i;
+            for (i = 0; i < 32; i++)
+                if ((in & (1u << i)) && c->btn_map[i] < 32) out |= 1u << c->btn_map[i];
+            packet->pkButtons = out;
+        }
+        if (c->has_np_marks || c->has_tp_marks)
+        {
+            BYTE bit;
+            if (c->has_np_marks && pWTInfoW && pWTInfoW(WTI_CURSORS + csr, CSR_NPBUTTON, &bit) == sizeof(bit) && bit < 32)
+                pressure_button(&c->np_down, c->np_marks, packet->pkNormalPressure, bit, &packet->pkButtons);
+            if (c->has_tp_marks && pWTInfoW && pWTInfoW(WTI_CURSORS + csr, CSR_TPBUTTON, &bit) == sizeof(bit) && bit < 32)
+                pressure_button(&c->tp_down, c->tp_marks, packet->pkTangentPressure, bit, &packet->pkButtons);
+        }
+        if (c->has_np_resp)
+            packet->pkNormalPressure = response_value(c->np_resp, packet->pkNormalPressure, DVC_NPRESSURE);
+        if (c->has_tp_resp)
+            packet->pkTangentPressure = response_value(c->tp_resp, packet->pkTangentPressure, DVC_TPRESSURE);
+        LeaveCriticalSection(&csTablet);
+    }
+
+    EnterCriticalSection(&csTablet);
+    for (h = hooks; h; h = h->next)
+        if (h->type == WTH_RECORD) { proc = h->proc; break; }
+    LeaveCriticalSection(&csTablet);
+    if (proc) proc(HC_ACTION, 0, (LPARAM)packet);
+    return TRUE;
+}
