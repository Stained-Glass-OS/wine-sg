+/* ---- packet hooks ---- */
+
+struct packet_hook
+{
+    struct packet_hook *next;  /* next older hook (of any type) */
+    HWTHOOK handle;
+    HMGR mgr;
+    int type;
+    HMODULE module;
+    WTHOOKPROC proc;
+};
+
+static struct packet_hook *hooks;
+static HWTHOOK top_hook = (HWTHOOK)0xe00;
+
+static HWTHOOK install_hook(HMGR hMgr, int nType, HMODULE module, const char *proc_name)
+{
+    struct packet_hook *h;
+    WTHOOKPROC proc;
+    BOOL ok;
+
+    EnterCriticalSection(&csTablet);
+    ok = find_manager(hMgr) != NULL;
+    LeaveCriticalSection(&csTablet);
+    if (!ok)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return NULL;
+    }
+    if (nType != WTH_PLAYBACK && nType != WTH_RECORD)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    if (!module || !proc_name || !(proc = (WTHOOKPROC)GetProcAddress(module, proc_name)))
+    {
+        if (module) FreeLibrary(module);
+        SetLastError(ERROR_PROC_NOT_FOUND);
+        return NULL;
+    }
+    if (!(h = calloc(1, sizeof(*h))))
+    {
+        FreeLibrary(module);
+        return NULL;
+    }
+    h->mgr = hMgr;
+    h->type = nType;
+    h->module = module;
+    h->proc = proc;
+
+    EnterCriticalSection(&csTablet);
+    h->handle = top_hook;
+    top_hook = (HWTHOOK)((UINT_PTR)top_hook + 1);
+    h->next = hooks;
+    hooks = h;
+    LeaveCriticalSection(&csTablet);
+    return h->handle;
+}
+
+static void remove_manager_hooks(HMGR mgr)
+{
+    for (;;)
+    {
+        struct packet_hook *h;
+        HWTHOOK victim = NULL;
+        EnterCriticalSection(&csTablet);
+        for (h = hooks; h; h = h->next)
+            if (h->mgr == mgr) { victim = h->handle; break; }
+        LeaveCriticalSection(&csTablet);
+        if (!victim) break;
+        WTMgrPacketUnhook(victim);
+    }
+}
