 /***********************************************************************
  *		WTMgrPacketHookNext (WINTAB32.205)
+ *
+ * Calls the next older hook of the same type, if there is one.
  */
 LRESULT WINAPI WTMgrPacketHookNext(HWTHOOK hHook, int nCode,
 				   WPARAM wParam, LPARAM lParam)
 {
-    FIXME("(%p, %d, %Iu, %Iu): stub\n", hHook, nCode, wParam, lParam);
+    struct packet_hook *h, *next = NULL;
+    WTHOOKPROC proc = NULL;
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    TRACE("(%p, %d, %Iu, %Iu)\n", hHook, nCode, wParam, lParam);
 
+    EnterCriticalSection(&csTablet);
+    for (h = hooks; h; h = h->next)
+        if (h->handle == hHook) break;
+    if (h)
+        for (next = h->next; next; next = next->next)
+            if (next->type == h->type) { proc = next->proc; break; }
+    LeaveCriticalSection(&csTablet);
+
+    if (!h)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return 0;
+    }
+#ifdef SG_MUTANT_WINTAB_NEXT
     return 0;
+#else
+    return proc ? proc(nCode, wParam, lParam) : 0;
+#endif
 }
 
+/* ---- cursor settings made by tablet managers ---- */
+
+#define MAX_CURSORS 32
+#define RESPONSE_ENTRIES 256
+#define DEFAULT_PTR ((void *)-1)
+
+struct cursor_settings
+{
+    BOOL disabled;
+    BOOL has_map, has_sysmap;
+    BYTE btn_map[32], sys_map[32];
+    BOOL has_np_marks, has_tp_marks;
+    UINT np_marks[2], tp_marks[2];   /* release, press */
+    BOOL has_np_resp, has_tp_resp;
+    UINT np_resp[RESPONSE_ENTRIES], tp_resp[RESPONSE_ENTRIES];
+    BOOL np_down, tp_down;
+};
+
+static struct cursor_settings cursors[MAX_CURSORS];
+
+static BOOL cursor_valid(HMGR hMgr, UINT csr)
+{
+    UINT count = MAX_CURSORS;
+    BOOL ok;
+
+    EnterCriticalSection(&csTablet);
+    ok = find_manager(hMgr) != NULL;
+    LeaveCriticalSection(&csTablet);
+    if (!ok)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (pWTInfoW)
+    {
+        UINT n = 0;
+        if (pWTInfoW(WTI_INTERFACE, IFC_NCURSORS, &n) == sizeof(n)) count = min(n, MAX_CURSORS);
+    }
+    if (csr >= count)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    return TRUE;
+}
 
