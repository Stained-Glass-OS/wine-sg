From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: another process's cursor can be drawn, read and set (9107)

On Windows a cursor is a session-wide object. Under Wine its bitmaps lived in the
process that made it, so the handle GetCursorInfo gives (another program's cursor,
whatever window is under the mouse) could not be drawn: screen recorders
(screen-capture-recorder through ffmpeg's dshow input, gdigrab, ShareX) and remote
desktop programs captured no pointer ("Error retrieving icon frame" per frame),
GetIconInfo failed, SetCursor returned 0 for it. A process now publishes the image
of each cursor it makes (an animated one by its first frame) in a section named for
the handle in its session's namespace; another process meeting the handle reads it
into a copy of its own, cached while the publication's serial stays the same.
Icons stay the process's own (6083 covers the switcher's program icons); sessions
are per person, so nothing crosses users.
---
--- a/dlls/win32u/cursoricon.c
+++ b/dlls/win32u/cursoricon.c
@@ -51,6 +51,7 @@
     BOOL                    is_shared;  /* whether this object is shared */
     BOOL                    is_icon;    /* whether icon or cursor */
     BOOL                    is_ani;     /* whether this object is a static cursor or an animated cursor */
+    HANDLE                  published;  /* wine-sg 9107: the section other processes read the image from */
     UINT                    delay;      /* delay between this frame and the next (in jiffies) */
     union
     {
@@ -77,6 +78,219 @@
     return obj;
 }
 
+/*
+ * Stained Glass OS (wine-sg 9107): on Windows a cursor is a session-wide object -- any process of
+ * the session can draw it, ask its bitmaps, set it. Under Wine its bitmaps lived in the process
+ * that made it, so the handle GetCursorInfo gives (the cursor of whatever window is under the
+ * mouse, another program's) could not be drawn: screen recorders (screen-capture-recorder, ShareX,
+ * ffmpeg's gdigrab) and remote desktop programs captured no pointer ("Error retrieving icon
+ * frame"), GetIconInfo failed, SetCursor of it returned 0. Each process now publishes the image of
+ * every cursor it makes (static ones; an animated one by its first frame) in a section named for
+ * the handle in its session's namespace, as the session's other objects are; another process that
+ * meets the handle reads the image from there into a copy of its own, kept in a small cache while
+ * the publication's serial number stays the same. Icons stay the process's own.
+ */
+#define CURSOR_IMAGE_MAGIC 0x52534347   /* "GCSR" */
+#define CURSOR_IMAGE_BITMAPS 3          /* color, alpha, mask */
+
+struct cursor_image_bitmap
+{
+    UINT width, height, planes, bpp, width_bytes;
+    UINT offset, size;                  /* the bits (GetBitmapBits layout) in the section */
+};
+
+struct cursor_image
+{
+    UINT magic;
+    UINT is_icon;
+    UINT64 serial;
+    UINT width, height;
+    POINT hotspot;
+    struct cursor_image_bitmap bitmaps[CURSOR_IMAGE_BITMAPS];
+};
+
+static void cursor_image_name( HICON handle, UNICODE_STRING *name, WCHAR *buffer )
+{
+    char text[96];
+    unsigned int i;
+
+    snprintf( text, sizeof(text), "\\Sessions\\%u\\BaseNamedObjects\\WineSgCursorImage%08x",
+              (unsigned int)NtCurrentTeb()->Peb->SessionId, (unsigned int)(UINT_PTR)handle );
+    for (i = 0; text[i]; i++) buffer[i] = (unsigned char)text[i];
+    buffer[i] = 0;
+    name->Buffer = buffer;
+    name->Length = i * sizeof(WCHAR);
+    name->MaximumLength = (i + 1) * sizeof(WCHAR);
+}
+
+/* the image of a cursor this process made, for the session's other processes */
+static void publish_cursor_image( HICON handle, struct cursoricon_object *obj, const struct cursoricon_frame *frame )
+{
+    static LONG counter;
+    HBITMAP bitmaps[CURSOR_IMAGE_BITMAPS] = { frame->color, frame->alpha, frame->mask };
+    struct cursor_image header = { CURSOR_IMAGE_MAGIC };
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    WCHAR buffer[96];
+    LARGE_INTEGER size;
+    SIZE_T view = 0;
+    HANDLE section;
+    BYTE *base = NULL;
+    UINT i, total = sizeof(header);
+    BITMAP bm;
+
+#ifdef SG_MUTANT_CURSOR_NO_PUBLISH
+    return;
+#endif
+    if (obj->published) NtClose( obj->published );
+    obj->published = 0;
+    if (!frame->width || !frame->mask) return;
+
+    header.is_icon = obj->is_icon;
+    header.serial = ((UINT64)HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ) << 32) | (UINT)InterlockedIncrement( &counter );
+    header.width = frame->width;
+    header.height = frame->height;
+    header.hotspot = frame->hotspot;
+    for (i = 0; i < CURSOR_IMAGE_BITMAPS; i++)
+    {
+        struct cursor_image_bitmap *b = &header.bitmaps[i];
+
+        if (!bitmaps[i] || !NtGdiExtGetObjectW( bitmaps[i], sizeof(bm), &bm )) continue;
+        b->width = bm.bmWidth;
+        b->height = bm.bmHeight;
+        b->planes = bm.bmPlanes;
+        b->bpp = bm.bmBitsPixel;
+        b->width_bytes = bm.bmWidthBytes;
+        b->size = bm.bmWidthBytes * bm.bmHeight;
+        b->offset = total;
+        total += (b->size + 15) & ~15;
+    }
+    if (total > 16 * 1024 * 1024) return;
+
+    cursor_image_name( handle, &name, buffer );
+    /* a name still held open by a reader of a freed cursor of the same handle: not published */
+    InitializeObjectAttributes( &attr, &name, 0, 0, NULL );
+    size.QuadPart = total;
+    if (NtCreateSection( &section, SECTION_ALL_ACCESS, &attr, &size, PAGE_READWRITE, SEC_COMMIT, 0 )) return;
+    if (NtMapViewOfSection( section, NtCurrentProcess(), (void **)&base, 0, 0, NULL, &view, ViewShare, 0,
+                            PAGE_READWRITE ))
+    {
+        NtClose( section );
+        return;
+    }
+    for (i = 0; i < CURSOR_IMAGE_BITMAPS; i++)
+    {
+        struct cursor_image_bitmap *b = &header.bitmaps[i];
+        if (b->size && NtGdiGetBitmapBits( bitmaps[i], b->size, base + b->offset ) != b->size)
+            memset( b, 0, sizeof(*b) );
+    }
+    memcpy( base, &header, sizeof(header) );
+    NtUnmapViewOfSection( NtCurrentProcess(), base );
+    obj->published = section;   /* open while the cursor lives: the image goes with it */
+}
+
+/* copies of other processes' cursors, by handle; user_lock must be held */
+static struct
+{
+    HICON handle;
+    UINT64 serial;
+    struct cursoricon_object *obj;
+} foreign_cursors[8];
+static unsigned int foreign_cursor_next;
+
+static void free_foreign_cursor( struct cursoricon_object *obj )
+{
+    if (!obj) return;
+    if (obj->frame.alpha) NtGdiDeleteObjectApp( obj->frame.alpha );
+    if (obj->frame.color) NtGdiDeleteObjectApp( obj->frame.color );
+    if (obj->frame.mask)  NtGdiDeleteObjectApp( obj->frame.mask );
+    free( obj );
+}
+
+/* another process's cursor, from its published image: returned with user_lock held, as
+ * get_user_handle_ptr returns an object, to be released with release_user_handle_ptr */
+static struct cursoricon_object *get_foreign_cursor( HICON handle )
+{
+    struct cursoricon_object *obj = NULL;
+    const struct cursor_image *image;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    WCHAR buffer[96];
+    SIZE_T view = 0;
+    HANDLE section;
+    BYTE *base = NULL;
+    HBITMAP bitmaps[CURSOR_IMAGE_BITMAPS] = { 0 };
+    UINT i;
+
+    if (!handle) return NULL;
+    cursor_image_name( handle, &name, buffer );
+    InitializeObjectAttributes( &attr, &name, 0, 0, NULL );
+    if (NtOpenSection( &section, SECTION_MAP_READ | SECTION_QUERY, &attr )) return NULL;
+    if (NtMapViewOfSection( section, NtCurrentProcess(), (void **)&base, 0, 0, NULL, &view, ViewShare, 0,
+                            PAGE_READONLY ))
+    {
+        NtClose( section );
+        return NULL;
+    }
+    image = (const struct cursor_image *)base;
+    if (view < sizeof(*image) || image->magic != CURSOR_IMAGE_MAGIC) goto done;
+
+    user_lock();
+    for (i = 0; i < ARRAY_SIZE(foreign_cursors); i++)
+    {
+        if (foreign_cursors[i].handle == handle && foreign_cursors[i].serial == image->serial)
+        {
+            obj = foreign_cursors[i].obj;   /* user_lock stays held for the caller */
+            goto done;
+        }
+    }
+    user_unlock();
+
+    for (i = 0; i < CURSOR_IMAGE_BITMAPS; i++)
+    {
+        const struct cursor_image_bitmap *b = &image->bitmaps[i];
+        if (!b->size) continue;
+        if (b->offset > view || b->size > view - b->offset || b->size < b->width_bytes * b->height) goto fail;
+        if (!(bitmaps[i] = NtGdiCreateBitmap( b->width, b->height, b->planes, b->bpp, base + b->offset )))
+            goto fail;
+    }
+    if (!bitmaps[2] || !(obj = calloc( 1, sizeof(*obj) ))) goto fail;
+    obj->obj.handle = handle;
+    obj->obj.type = NTUSER_OBJ_ICON;
+    obj->is_icon = image->is_icon;
+    obj->frame.width = image->width;
+    obj->frame.height = image->height;
+    obj->frame.hotspot = image->hotspot;
+    obj->frame.color = bitmaps[0];
+    obj->frame.alpha = bitmaps[1];
+    obj->frame.mask = bitmaps[2];
+
+    user_lock();
+    i = foreign_cursor_next++ % ARRAY_SIZE(foreign_cursors);
+    free_foreign_cursor( foreign_cursors[i].obj );
+    foreign_cursors[i].handle = handle;
+    foreign_cursors[i].serial = image->serial;
+    foreign_cursors[i].obj = obj;   /* user_lock stays held for the caller */
+    goto done;
+
+fail:
+    for (i = 0; i < CURSOR_IMAGE_BITMAPS; i++) if (bitmaps[i]) NtGdiDeleteObjectApp( bitmaps[i] );
+    obj = NULL;
+done:
+    NtUnmapViewOfSection( NtCurrentProcess(), base );
+    NtClose( section );
+    return obj;
+}
+
+/* a cursor or icon of this process, or a cursor of another process of the session (read only) */
+static struct cursoricon_object *get_any_icon_ptr( HICON handle )
+{
+    struct cursoricon_object *obj = get_user_handle_ptr( handle, NTUSER_OBJ_ICON );
+    if (obj == OBJ_OTHER_PROCESS && !(obj = get_foreign_cursor( handle )))
+        WARN( "icon handle %p from other process\n", handle );
+    return obj;
+}
+
 BOOL process_wine_setcursor( HWND hwnd, HWND window, HCURSOR handle )
 {
     TRACE( "hwnd %p, window %p, hcursor %p\n", hwnd, window, handle );
@@ -126,7 +340,7 @@
     SERVER_END_REQ;
     if (!ret) return 0;
 
-    if (!(obj = get_icon_ptr( old_cursor ))) return 0;
+    if (!(obj = get_any_icon_ptr( old_cursor ))) return 0;
     release_user_handle_ptr( obj );
     return old_cursor;
 }
@@ -163,7 +377,7 @@
 {
     struct cursoricon_object *obj, *ret;
 
-    if (!(obj = get_icon_ptr( handle ))) return NULL;
+    if (!(obj = get_any_icon_ptr( handle ))) return NULL;
     if (!obj->is_ani) return obj;
     if (step >= obj->ani.num_steps)
     {
@@ -189,6 +403,8 @@
 
         assert( !obj->rsrc );  /* shared icons can't be freed */
 
+        if (obj->published) NtClose( obj->published );
+
         if (!obj->is_ani)
         {
             if (obj->frame.alpha) NtGdiDeleteObjectApp( obj->frame.alpha );
@@ -260,6 +476,7 @@
 
         obj->frame = desc->frames[0];
         obj->delay = desc->delay;
+        if (!obj->is_icon) publish_cursor_image( cursor, obj, &obj->frame );
         release_user_handle_ptr( obj );
         if (old.alpha) NtGdiDeleteObjectApp( old.alpha );
         if (old.color) NtGdiDeleteObjectApp( old.color );
@@ -357,6 +574,12 @@
         }
     }
 
+    if (!obj->is_icon)
+    {
+        if (!obj->is_ani) publish_cursor_image( cursor, obj, &obj->frame );
+        else if (desc->num_frames) publish_cursor_image( cursor, obj, &desc->frames[desc->frame_seq ? desc->frame_seq[0] : 0] );
+    }
+
     release_user_handle_ptr( obj );
     return TRUE;
 }
@@ -495,7 +718,7 @@
     struct cursoricon_object *obj, *frame_obj;
     BOOL ret = TRUE;
 
-    if (!(obj = get_icon_ptr( icon )))
+    if (!(obj = get_any_icon_ptr( icon )))
     {
         RtlSetLastWin32Error( ERROR_INVALID_CURSOR_HANDLE );
         return FALSE;
