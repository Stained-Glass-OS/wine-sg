From: Stained Glass OS <dev@stained-glass.example>
Subject: user32: IsWindowArranged, GetPointerDevice, GetPointerPenInfo

Microsoft Edge delay-loads these; a delay-loaded export that does not exist
is a deliberate crash (Chromium's delay-load failure hook), and the browser
died at start. Consistent with the rest of Wine's pointer support: there are
no pointer devices and no pen pointers, so no handle or id names one; and
nothing arranges (snaps) windows, so none is arranged.

--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -532,6 +532,45 @@
     return FALSE;
 }
 
+/**********************************************************************
+ * GetPointerPenInfo [USER32.@]
+ *
+ * There are no pen pointers (GetPointerInfo knows no pointer at all), so no
+ * id names one.
+ */
+BOOL WINAPI GetPointerPenInfo(UINT32 id, POINTER_PEN_INFO *info)
+{
+    TRACE("(%d %p)\n", id, info);
+
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/**********************************************************************
+ * GetPointerDevice [USER32.@]
+ *
+ * GetPointerDevices enumerates no pointer devices, so no handle names one.
+ */
+BOOL WINAPI GetPointerDevice(HANDLE device, POINTER_DEVICE_INFO *info)
+{
+    TRACE("(%p %p)\n", device, info);
+
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/**********************************************************************
+ * IsWindowArranged [USER32.@]
+ *
+ * Whether a window is snapped (arranged) by the shell. Nothing arranges
+ * windows here, so none is.
+ */
+BOOL WINAPI IsWindowArranged(HWND hwnd)
+{
+    TRACE("(%p)\n", hwnd);
+    return FALSE;
+}
+
 LRESULT WINAPI ImeWndProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
 {
     if (!imm_ime_wnd_proc) return DefWindowProcA(hwnd, msg, wParam, lParam);
