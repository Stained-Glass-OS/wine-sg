From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: NtSetInformationThread(ThreadPriority), the CD-ROM device number and media types (3749)

ntdll: NtSetInformationThread(ThreadPriority), the CD-ROM device number and media types

ThreadPriority takes the absolute priority 1..31 and sets the relative one
through the base of the process class. IOCTL_STORAGE_GET_DEVICE_NUMBER on a
CD-ROM goes on to the mount manager instead of answering FILE_DEVICE_DISK 1,
and the media type ioctls give the documented structures.
---
diff --git a/dlls/ntdll/unix/cdrom.c b/dlls/ntdll/unix/cdrom.c
index 9e65141..e59761c 100644
--- a/dlls/ntdll/unix/cdrom.c
+++ b/dlls/ntdll/unix/cdrom.c
@@ -724,11 +724,9 @@ static NTSTATUS CDROM_GetControl(int dev, int fd, CDROM_AUDIO_CONTROL* cac)
  */
 static NTSTATUS CDROM_GetDeviceNumber(int dev, STORAGE_DEVICE_NUMBER* devnum)
 {
-    FIXME( "stub\n" );
-    devnum->DeviceType = FILE_DEVICE_DISK;
-    devnum->DeviceNumber = 1;
-    devnum->PartitionNumber = 1;
-    return STATUS_SUCCESS;
+    /* the number of \Device\CdRom<n> belongs to the mount manager, which numbers the devices
+     * (FILE_DEVICE_CD_ROM, no partition): let the ioctl go on to it */
+    return STATUS_NOT_SUPPORTED;
 }
 
 /******************************************************************
@@ -758,12 +756,46 @@ static NTSTATUS CDROM_GetDriveGeometry(int dev, int fd, DISK_GEOMETRY* dg)
  *		CDROM_GetMediaType
  *
  */
-static NTSTATUS CDROM_GetMediaType(int dev, GET_MEDIA_TYPES* medtype)
+static NTSTATUS CDROM_GetMediaType(int dev, int fd, BOOL ex, void *buffer, ULONG size, DWORD *sz)
 {
-    FIXME(": faking success\n");
-    medtype->DeviceType = FILE_DEVICE_CD_ROM;
-    medtype->MediaInfoCount = 0;
-    return STATUS_SUCCESS;
+    DISK_GEOMETRY geometry;
+    NTSTATUS status;
+
+    /* the medium that is in the drive; no medium: the status of the geometry query */
+    status = CDROM_GetDriveGeometry( dev, fd, &geometry );
+    if (!ex)
+    {
+        /* IOCTL_STORAGE_GET_MEDIA_TYPES / IOCTL_DISK_GET_MEDIA_TYPES: an array of geometries */
+        *sz = sizeof(geometry);
+        if (status) return status;
+        if (size < sizeof(geometry)) return STATUS_BUFFER_TOO_SMALL;
+        memcpy( buffer, &geometry, sizeof(geometry) );
+        return STATUS_SUCCESS;
+    }
+    else
+    {
+        GET_MEDIA_TYPES *types = buffer;
+
+        *sz = sizeof(*types);
+        if (size < sizeof(*types)) return STATUS_BUFFER_TOO_SMALL;
+        memset( types, 0, sizeof(*types) );
+        types->DeviceType = FILE_DEVICE_CD_ROM;
+        if (status == STATUS_SUCCESS)
+        {
+            /* GUESS: one entry, the medium that is in the drive, read-only and mounted; Windows lists
+             * every medium type the drive can handle */
+            types->MediaInfoCount = 1;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.Cylinders = geometry.Cylinders;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.MediaType = CD_ROM;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.TracksPerCylinder = geometry.TracksPerCylinder;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.SectorsPerTrack = geometry.SectorsPerTrack;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.BytesPerSector = geometry.BytesPerSector;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.NumberMediaSides = 1;
+            types->MediaInfo[0].DeviceSpecific.RemovableDiskInfo.MediaCharacteristics =
+                MEDIA_READ_ONLY | MEDIA_CURRENTLY_MOUNTED;
+        }
+        return STATUS_SUCCESS;
+    }
 }
 
 /**************************************************************************
@@ -2905,10 +2937,10 @@ NTSTATUS cdrom_DeviceIoControl( HANDLE device, HANDLE event, PIO_APC_ROUTINE apc
     case IOCTL_DISK_GET_MEDIA_TYPES:
     case IOCTL_STORAGE_GET_MEDIA_TYPES:
     case IOCTL_STORAGE_GET_MEDIA_TYPES_EX:
-        sz = sizeof(GET_MEDIA_TYPES);
+        sz = 0;
         if (in_buffer != NULL || in_size != 0) status = STATUS_INVALID_PARAMETER;
-        else if (out_size < sz) status = STATUS_BUFFER_TOO_SMALL;
-        else status = CDROM_GetMediaType(dev, out_buffer);
+        else status = CDROM_GetMediaType(dev, fd, code == IOCTL_STORAGE_GET_MEDIA_TYPES_EX, out_buffer, out_size, &sz);
+        if (status == STATUS_BUFFER_TOO_SMALL) sz = 0;
         break;
 
     case IOCTL_STORAGE_GET_DEVICE_NUMBER:
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index c083480..d12006a 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -2848,9 +2848,64 @@ NTSTATUS WINAPI NtSetInformationThread( HANDLE handle, THREADINFOCLASS class,
 #endif
     }
 
+    case ThreadPriority:
+    {
+        /* Stained Glass OS: the absolute (kernel) priority, 1..31 (GUESS: the semantics are not documented by
+         * Microsoft).  The server keeps the thread's priority relative to its process' class, so the value
+         * is turned into the difference to the class' base priority (kept to the range of relative priorities, -2..2, or -7..6 in the realtime class): THREAD_PRIORITY_IDLE (1, or 16 in the
+         * realtime class) and THREAD_PRIORITY_TIME_CRITICAL (15, or 31) are the extreme values. */
+        static const struct { ULONG class; LONG base; } classes[] =
+        {
+            { PROCESS_PRIOCLASS_IDLE, 4 }, { PROCESS_PRIOCLASS_BELOW_NORMAL, 6 }, { PROCESS_PRIOCLASS_NORMAL, 8 },
+            { PROCESS_PRIOCLASS_ABOVE_NORMAL, 10 }, { PROCESS_PRIOCLASS_HIGH, 13 }, { PROCESS_PRIOCLASS_REALTIME, 24 },
+        };
+        THREAD_BASIC_INFORMATION tbi;
+        PROCESS_PRIORITY_CLASS pclass;
+        OBJECT_ATTRIBUTES attr;
+        CLIENT_ID cid;
+        HANDLE process;
+        LONG priority, base = 8, delta;
+        BOOL realtime = FALSE;
+        unsigned int i;
+
+        if (length != sizeof(LONG)) return STATUS_INFO_LENGTH_MISMATCH;
+        if (!data) return STATUS_ACCESS_VIOLATION;
+        priority = *(const LONG *)data;
+        if (priority < 1 || priority > 31) return STATUS_INVALID_PARAMETER;
+
+        if ((status = NtQueryInformationThread( handle, ThreadBasicInformation, &tbi, sizeof(tbi), NULL ))) return status;
+        if (handle == GetCurrentThread() || tbi.ClientId.UniqueProcess == NtCurrentTeb()->ClientId.UniqueProcess)
+            process = NtCurrentProcess();
+        else
+        {
+            InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+            cid.UniqueProcess = tbi.ClientId.UniqueProcess;
+            cid.UniqueThread = 0;
+            if ((status = NtOpenProcess( &process, PROCESS_QUERY_INFORMATION, &attr, &cid ))) return status;
+        }
+        if (!NtQueryInformationProcess( process, ProcessPriorityClass, &pclass, sizeof(pclass), NULL ))
+        {
+            for (i = 0; i < ARRAY_SIZE(classes); i++)
+                if (classes[i].class == pclass.PriorityClass) { base = classes[i].base; realtime = (i == 5); break; }
+        }
+        if (process != NtCurrentProcess()) NtClose( process );
+
+        if (priority == (realtime ? 16 : 1)) delta = -15;                /* THREAD_PRIORITY_IDLE */
+        else if (priority == (realtime ? 31 : 15)) delta = 15;           /* THREAD_PRIORITY_TIME_CRITICAL */
+        else delta = max( realtime ? -7 : -2, min( realtime ? 6 : 2, priority - base ));   /* what the server accepts */
+        SERVER_START_REQ( set_thread_info )
+        {
+            req->handle   = wine_server_obj_handle( handle );
+            req->priority = delta;
+            req->mask     = SET_THREAD_INFO_PRIORITY;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        return status;
+    }
+
     case ThreadBasicInformation:
     case ThreadTimes:
-    case ThreadPriority:
     case ThreadDescriptorTableEntry:
     case ThreadEventPair_Reusable:
     case ThreadPerformanceCount:
