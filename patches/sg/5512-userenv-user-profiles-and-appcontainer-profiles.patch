--- a/dlls/userenv/userenv_main.c
+++ b/dlls/userenv/userenv_main.c
@@ -661,17 +661,70 @@ BOOL WINAPI GetProfileType( DWORD *pdwFlags )
     return TRUE;
 }
 
+/* the root of the hive of the user the token names, opened with full access */
+static BOOL open_user_hive( HANDLE token, HKEY *key )
+{
+    TOKEN_USER *user;
+    DWORD len, err;
+    WCHAR *sid_str;
+    BOOL ret = FALSE;
+
+    if (!token || token == INVALID_HANDLE_VALUE)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (GetTokenInformation( token, TokenUser, NULL, 0, &len ) || GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+        return FALSE;
+    if (!(user = HeapAlloc( GetProcessHeap(), 0, len ))) return FALSE;
+    if (GetTokenInformation( token, TokenUser, user, len, &len ) && ConvertSidToStringSidW( user->User.Sid, &sid_str ))
+    {
+        err = RegOpenKeyExW( HKEY_USERS, sid_str, 0, KEY_ALL_ACCESS, key );
+        if (err) SetLastError( err );
+        else ret = TRUE;
+        LocalFree( sid_str );
+    }
+    HeapFree( GetProcessHeap(), 0, user );
+    return ret;
+}
+
 BOOL WINAPI LoadUserProfileA( HANDLE hToken, LPPROFILEINFOA lpProfileInfo )
 {
-    FIXME("%p %p\n", hToken, lpProfileInfo );
-    lpProfileInfo->hProfile = HKEY_CURRENT_USER;
+    HKEY key;
+
+    TRACE( "%p %p\n", hToken, lpProfileInfo );
+
+    if (!lpProfileInfo || lpProfileInfo->dwSize != sizeof(*lpProfileInfo) || !lpProfileInfo->lpUserName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!open_user_hive( hToken, &key )) return FALSE;
+    lpProfileInfo->hProfile = key;
     return TRUE;
 }
 
 BOOL WINAPI LoadUserProfileW( HANDLE hToken, LPPROFILEINFOW lpProfileInfo )
 {
-    FIXME("%p %p\n", hToken, lpProfileInfo );
-    lpProfileInfo->hProfile = HKEY_CURRENT_USER;
+    HKEY key;
+
+    TRACE( "%p %p\n", hToken, lpProfileInfo );
+
+    /* "fails and returns ERROR_INVALID_PARAMETER if the dwSize member ... is not
+     * set to sizeof(PROFILEINFO) or if the lpUserName member is NULL"; on success
+     * hProfile is "a registry key handle opened to the root of the user's hive",
+     * which UnloadUserProfile closes */
+    if (!lpProfileInfo || lpProfileInfo->dwSize != sizeof(*lpProfileInfo) || !lpProfileInfo->lpUserName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!open_user_hive( hToken, &key )) return FALSE;
+#ifdef SG_MUTANT_LOAD_FAKE
+    RegCloseKey( key );
+    key = HKEY_CURRENT_USER;
+#endif
+    lpProfileInfo->hProfile = key;
     return TRUE;
 }
 
@@ -832,8 +885,24 @@ BOOL WINAPI RefreshPolicy( BOOL machine )
 
 BOOL WINAPI UnloadUserProfile( HANDLE hToken, HANDLE hProfile )
 {
-    FIXME("(%p, %p): stub\n", hToken, hProfile);
-    return FALSE;
+    DWORD err;
+
+    TRACE( "(%p, %p)\n", hToken, hProfile );
+
+    if (!hToken || hToken == INVALID_HANDLE_VALUE || !hProfile)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    /* the hive stays loaded for the other users of it; the handle LoadUserProfile
+     * gave is closed */
+    if (hProfile == HKEY_CURRENT_USER) return TRUE;
+    if ((err = RegCloseKey( hProfile )))
+    {
+        SetLastError( err );
+        return FALSE;
+    }
+    return TRUE;
 }
 
 /* the policy section: a named mutex held while policy is read or applied */
@@ -969,12 +1038,199 @@ HRESULT WINAPI DeriveAppContainerSidFromAppContainerName(PCWSTR name, PSID *sid)
     return S_OK;
 }
 
+#define APPCONTAINER_MAPPINGS L"Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\CurrentVersion\\AppContainer\\Mappings"
+
+static BOOL valid_container_name( const WCHAR *name )
+{
+    size_t i, len;
+
+    if (!name) return FALSE;
+    len = wcslen( name );
+    if (!len || len > 64) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        WCHAR c = name[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
+              || c == '-' || c == '_' || c == '.' || c == ' ')) return FALSE;
+    }
+    return TRUE;
+}
+
+/* "%LOCALAPPDATA%\\Packages\\<name>": the per-user, per-container folder */
+static BOOL container_folder( const WCHAR *name, WCHAR *path, DWORD size )
+{
+    WCHAR local[MAX_PATH];
+    DWORD len = GetEnvironmentVariableW( L"LOCALAPPDATA", local, ARRAY_SIZE(local) );
+
+    if (!len || len >= ARRAY_SIZE(local)) return FALSE;
+    return swprintf( path, size, L"%s\\Packages\\%s", local, name ) > 0;
+}
+
+/* The profile is the folder of the container's data under the user's
+ * Packages folder and its registration under the user's Mappings key, from
+ * the container's SID to its name. */
 HRESULT WINAPI CreateAppContainerProfile(PCWSTR container_name, PCWSTR display_name, PCWSTR description,
-                                         SID_AND_ATTRIBUTES *capabilities, DWORD capability_count,
-                                         SID **container_sid)
+                                         PSID_AND_ATTRIBUTES capabilities, DWORD capability_count,
+                                         PSID *container_sid)
 {
-    FIXME("(%s, %s, %s, %p, %ld, %p): stub\n", debugstr_w(container_name), debugstr_w(display_name),
+    WCHAR folder[MAX_PATH + 64], *sid_str = NULL;
+    HKEY mappings = NULL, key = NULL;
+    SID *sid = NULL;
+    HRESULT hr;
+    DWORD err, i;
+
+    TRACE("(%s, %s, %s, %p, %ld, %p)\n", debugstr_w(container_name), debugstr_w(display_name),
           debugstr_w(description), capabilities, capability_count, container_sid);
 
-    return E_NOTIMPL;
+    if (!valid_container_name( container_name )
+        || (display_name && wcslen( display_name ) > 512) || (description && wcslen( description ) > 2048)
+        || !container_sid || (capability_count && !capabilities))
+        return E_INVALIDARG;
+    *container_sid = NULL;
+
+    if (FAILED(hr = DeriveAppContainerSidFromAppContainerName( container_name, (PSID *)&sid ))) return hr;
+    if (!ConvertSidToStringSidW( sid, &sid_str ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+
+    if ((err = RegCreateKeyExW( HKEY_CURRENT_USER, APPCONTAINER_MAPPINGS, 0, NULL, 0, KEY_ALL_ACCESS, NULL,
+                                &mappings, NULL )))
+    {
+        hr = err == ERROR_ACCESS_DENIED ? E_ACCESSDENIED : HRESULT_FROM_WIN32( err );
+        goto done;
+    }
+    if ((err = RegCreateKeyExW( mappings, sid_str, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, &i )))
+    {
+        hr = err == ERROR_ACCESS_DENIED ? E_ACCESSDENIED : HRESULT_FROM_WIN32( err );
+        goto done;
+    }
+#ifdef SG_MUTANT_AC_NOEXIST
+    if (0)
+#else
+    if (i == REG_OPENED_EXISTING_KEY)
+#endif
+    {
+        hr = HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+        goto done;
+    }
+
+    RegSetValueExW( key, L"Moniker", 0, REG_SZ, (const BYTE *)container_name,
+                    (wcslen( container_name ) + 1) * sizeof(WCHAR) );
+    if (!display_name) display_name = L"";
+    RegSetValueExW( key, L"DisplayName", 0, REG_SZ, (const BYTE *)display_name,
+                    (wcslen( display_name ) + 1) * sizeof(WCHAR) );
+    if (!description) description = L"";
+    RegSetValueExW( key, L"Description", 0, REG_SZ, (const BYTE *)description,
+                    (wcslen( description ) + 1) * sizeof(WCHAR) );
+    if (capability_count)
+    {
+        /* the capabilities, as SID strings: a multi-string */
+        WCHAR **strings = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, capability_count * sizeof(*strings) );
+        size_t total = 1;
+        WCHAR *list, *out;
+
+        if (strings)
+        {
+            for (i = 0; i < capability_count; i++)
+                if (ConvertSidToStringSidW( capabilities[i].Sid, &strings[i] )) total += wcslen( strings[i] ) + 1;
+            if ((out = list = HeapAlloc( GetProcessHeap(), 0, total * sizeof(WCHAR) )))
+            {
+                for (i = 0; i < capability_count; i++)
+                {
+                    if (!strings[i]) continue;
+                    wcscpy( out, strings[i] );
+                    out += wcslen( out ) + 1;
+                }
+                *out = 0;
+                RegSetValueExW( key, L"Capabilities", 0, REG_MULTI_SZ, (const BYTE *)list, total * sizeof(WCHAR) );
+                HeapFree( GetProcessHeap(), 0, list );
+            }
+            for (i = 0; i < capability_count; i++) LocalFree( strings[i] );
+            HeapFree( GetProcessHeap(), 0, strings );
+        }
+    }
+
+    if (container_folder( container_name, folder, ARRAY_SIZE(folder) ))
+    {
+        WCHAR packages[MAX_PATH + 16];
+
+        wcscpy( packages, folder );
+        *wcsrchr( packages, '\\' ) = 0;
+        CreateDirectoryW( packages, NULL );
+        if (!CreateDirectoryW( folder, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
+        {
+            RegCloseKey( key );
+            key = NULL;
+            RegDeleteTreeW( mappings, sid_str );
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            goto done;
+        }
+    }
+
+    *container_sid = sid;
+    sid = NULL;
+    hr = S_OK;
+
+done:
+    if (key) RegCloseKey( key );
+    if (mappings) RegCloseKey( mappings );
+    if (sid) FreeSid( sid );
+    LocalFree( sid_str );
+    return hr;
+}
+
+static void remove_directory_tree( WCHAR *path )
+{
+    WIN32_FIND_DATAW data;
+    size_t len = wcslen( path );
+    HANDLE find;
+
+    if (len + 3 > MAX_PATH + 64) return;
+    wcscpy( path + len, L"\\*" );
+    if ((find = FindFirstFileW( path, &data )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( data.cFileName, L"." ) || !wcscmp( data.cFileName, L".." )) continue;
+            if (len + 1 + wcslen( data.cFileName ) + 3 > MAX_PATH + 64) continue;
+            path[len] = '\\';
+            wcscpy( path + len + 1, data.cFileName );
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) remove_directory_tree( path );
+            else DeleteFileW( path );
+        } while (FindNextFileW( find, &data ));
+        FindClose( find );
+    }
+    path[len] = 0;
+    RemoveDirectoryW( path );
+}
+
+HRESULT WINAPI DeleteAppContainerProfile(PCWSTR container_name)
+{
+    WCHAR folder[MAX_PATH + 64], *sid_str = NULL;
+    HKEY mappings;
+    SID *sid = NULL;
+    HRESULT hr;
+
+    TRACE("(%s)\n", debugstr_w(container_name));
+
+    if (!valid_container_name( container_name )) return E_INVALIDARG;
+    if (FAILED(hr = DeriveAppContainerSidFromAppContainerName( container_name, (PSID *)&sid ))) return hr;
+    if (!ConvertSidToStringSidW( sid, &sid_str ))
+    {
+        FreeSid( sid );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, APPCONTAINER_MAPPINGS, 0, KEY_ALL_ACCESS, &mappings ))
+    {
+#ifndef SG_MUTANT_AC_NODELETE
+        RegDeleteTreeW( mappings, sid_str );
+#endif
+        RegCloseKey( mappings );
+    }
+    if (container_folder( container_name, folder, ARRAY_SIZE(folder) )) remove_directory_tree( folder );
+    LocalFree( sid_str );
+    FreeSid( sid );
+    return S_OK;
 }
--- a/include/userenv.h
+++ b/include/userenv.h
@@ -108,6 +108,8 @@ USERENVAPI BOOL WINAPI RefreshPolicyEx(BOOL,DWORD);
 USERENVAPI BOOL WINAPI RegisterGPNotification(HANDLE,BOOL);
 USERENVAPI BOOL WINAPI UnloadUserProfile(HANDLE,HANDLE);
 USERENVAPI BOOL WINAPI UnregisterGPNotification(HANDLE);
+USERENVAPI HRESULT WINAPI CreateAppContainerProfile(PCWSTR,PCWSTR,PCWSTR,PSID_AND_ATTRIBUTES,DWORD,PSID*);
+USERENVAPI HRESULT WINAPI DeleteAppContainerProfile(PCWSTR);
 USERENVAPI HRESULT WINAPI DeriveAppContainerSidFromAppContainerName(PCWSTR,PSID*);
 
 #ifdef __cplusplus
