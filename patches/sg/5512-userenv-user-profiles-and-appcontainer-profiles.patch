From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] userenv: LoadUserProfile, UnloadUserProfile, AppContainer profiles

LoadUserProfileA/W claimed success and put HKEY_CURRENT_USER in hProfile
whoever the token was for. They now check the PROFILEINFO (dwSize,
lpUserName: ERROR_INVALID_PARAMETER) and open the root of the hive of the
token's user (HKEY_USERS\<SID>, which the server loads on demand) as the
documentation describes; UnloadUserProfile, which always failed, closes that
handle. A token that is not a handle fails with ERROR_INVALID_HANDLE.

CreateAppContainerProfile returned E_NOTIMPL. It validates the name
("[-_. A-Za-z0-9]+", 64 characters), display name (512) and description
(2048) with E_INVALIDARG, creates the profile for the current user -- the
folder %LOCALAPPDATA%\Packages\<name> and the registration under the user's
AppContainer Mappings key (moniker, display name, description, capabilities)
-- and returns the container's SID; a second profile of the name is
HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS). DeleteAppContainerProfile
(new export) removes both.

Rebased at integration (integ-2026-10) onto fast-b 3710 (RECONCILE-CLOUD userenv KEEP-A: 3710 enforces the documented privileges). Only 5512's conformance tests and the two prototypes they need in include/userenv.h (CreateAppContainerProfile, DeleteAppContainerProfile) are kept (they pass on 3710).
---
--- a/dlls/userenv/tests/userenv.c
+++ b/dlls/userenv/tests/userenv.c
@@ -26,6 +26,8 @@
 #include "winbase.h"
 #include "winnls.h"
 #include "winreg.h"
+#include "sddl.h"
+#include "profinfo.h"
 
 #include "userenv.h"
 
@@ -457,6 +459,161 @@ static void test_get_user_profile_dir(void)
     CloseHandle( token );
 }
 
+static void test_load_user_profile(void)
+{
+    WCHAR name[] = L"wine-test";
+    PROFILEINFOW info = {sizeof(info)};
+    PROFILEINFOA infoA = {sizeof(infoA)};
+    char nameA[] = "wine-test";
+    HANDLE token;
+    HKEY key, key2;
+    DWORD ret, value, size;
+    BOOL bret;
+
+    bret = OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_IMPERSONATE | TOKEN_DUPLICATE, &token);
+    ok(bret, "OpenProcessToken failed: %lu\n", GetLastError());
+
+    info.lpUserName = NULL;
+    SetLastError(0xdeadbeef);
+    bret = LoadUserProfileW(token, &info);
+    ok(!bret, "LoadUserProfileW succeeded without a user name\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
+
+    info.lpUserName = name;
+    info.dwSize = sizeof(info) - 1;
+    SetLastError(0xdeadbeef);
+    bret = LoadUserProfileW(token, &info);
+    ok(!bret, "LoadUserProfileW succeeded with a wrong size\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
+    info.dwSize = sizeof(info);
+
+    infoA.lpUserName = NULL;
+    SetLastError(0xdeadbeef);
+    bret = LoadUserProfileA(token, &infoA);
+    ok(!bret, "LoadUserProfileA succeeded without a user name\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
+
+    info.hProfile = NULL;
+    SetLastError(0xdeadbeef);
+    bret = LoadUserProfileW(token, &info);
+    if (!bret && (GetLastError() == ERROR_PRIVILEGE_NOT_HELD || GetLastError() == ERROR_ACCESS_DENIED))
+    {
+        win_skip("not allowed to load a profile: %lu\n", GetLastError());
+        CloseHandle(token);
+        return;
+    }
+    ok(bret, "LoadUserProfileW failed: %lu\n", GetLastError());
+    ok(info.hProfile != NULL, "no profile key\n");
+
+    /* "a registry key handle opened to the root of the user's hive", the same
+     * hive as HKEY_CURRENT_USER */
+    ret = RegCreateKeyExA(info.hProfile, "Software\\WineTestUserenv", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL);
+    ok(!ret, "RegCreateKeyEx failed: %lu\n", ret);
+    value = 0x1234;
+    ret = RegSetValueExA(key, "Value", 0, REG_DWORD, (const BYTE *)&value, sizeof(value));
+    ok(!ret, "RegSetValueEx failed: %lu\n", ret);
+    RegCloseKey(key);
+    ret = RegOpenKeyExA(HKEY_CURRENT_USER, "Software\\WineTestUserenv", 0, KEY_READ, &key2);
+    ok(!ret, "the value is not in HKEY_CURRENT_USER: %lu\n", ret);
+    value = 0;
+    size = sizeof(value);
+    ret = RegQueryValueExA(key2, "Value", NULL, NULL, (BYTE *)&value, &size);
+    ok(!ret && value == 0x1234, "got %lu, %#lx\n", ret, value);
+    RegCloseKey(key2);
+    RegDeleteKeyA(HKEY_CURRENT_USER, "Software\\WineTestUserenv");
+
+    SetLastError(0xdeadbeef);
+    bret = UnloadUserProfile(NULL, info.hProfile);
+    ok(!bret, "UnloadUserProfile succeeded without a token\n");
+    ok(GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError());
+
+    bret = UnloadUserProfile(token, info.hProfile);
+    ok(bret, "UnloadUserProfile failed: %lu\n", GetLastError());
+    /* it closed the handle */
+    ret = RegCloseKey(info.hProfile);
+    ok(ret == ERROR_INVALID_HANDLE, "got %lu\n", ret);
+
+    infoA.lpUserName = nameA;
+    infoA.hProfile = NULL;
+    bret = LoadUserProfileA(token, &infoA);
+    ok(bret, "LoadUserProfileA failed: %lu\n", GetLastError());
+    ok(infoA.hProfile != NULL, "no profile key\n");
+    bret = UnloadUserProfile(token, infoA.hProfile);
+    ok(bret, "UnloadUserProfile failed: %lu\n", GetLastError());
+
+    CloseHandle(token);
+}
+
+static void test_app_container_profile(void)
+{
+    static const WCHAR *name = L"wine.test.profile-1";
+    PSID sid = NULL, derived = NULL;
+    HRESULT hr;
+    WCHAR *sid_str, *sid_str2;
+    DWORD len;
+
+    hr = CreateAppContainerProfile(NULL, L"Display", L"Description", NULL, 0, &sid);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = CreateAppContainerProfile(L"bad/name", L"Display", L"Description", NULL, 0, &sid);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = CreateAppContainerProfile(L"", L"Display", L"Description", NULL, 0, &sid);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    {
+        WCHAR longname[70];
+        for (len = 0; len < 65; len++) longname[len] = 'a';
+        longname[65] = 0;
+        hr = CreateAppContainerProfile(longname, L"Display", L"Description", NULL, 0, &sid);
+        ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    }
+    {
+        WCHAR *longtext = HeapAlloc(GetProcessHeap(), 0, 3000 * sizeof(WCHAR));
+        for (len = 0; len < 2999; len++) longtext[len] = 'a';
+        longtext[2999] = 0;
+        hr = CreateAppContainerProfile(name, longtext, L"Description", NULL, 0, &sid);
+        ok(hr == E_INVALIDARG, "got %#lx for a long display name\n", hr);
+        hr = CreateAppContainerProfile(name, L"Display", longtext, NULL, 0, &sid);
+        ok(hr == E_INVALIDARG, "got %#lx for a long description\n", hr);
+        HeapFree(GetProcessHeap(), 0, longtext);
+    }
+    hr = DeleteAppContainerProfile(NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    DeleteAppContainerProfile(name);
+    hr = CreateAppContainerProfile(name, L"Display", L"Description", NULL, 0, &sid);
+    if (hr == E_ACCESSDENIED)
+    {
+        win_skip("not allowed to create a profile\n");
+        return;
+    }
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr != S_OK) return;
+
+    hr = DeriveAppContainerSidFromAppContainerName(name, &derived);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ConvertSidToStringSidW(sid, &sid_str);
+    ConvertSidToStringSidW(derived, &sid_str2);
+    ok(!wcscmp(sid_str, sid_str2), "got %s, expected the derived %s\n", wine_dbgstr_w(sid_str), wine_dbgstr_w(sid_str2));
+    LocalFree(sid_str);
+    LocalFree(sid_str2);
+    FreeSid(derived);
+    FreeSid(sid);
+
+    /* a second profile of that name */
+    sid = (PSID)0xdeadbeef;
+    hr = CreateAppContainerProfile(name, L"Display", L"Description", NULL, 0, &sid);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS), "got %#lx\n", hr);
+
+    hr = DeleteAppContainerProfile(name);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* and it can be made again */
+    hr = CreateAppContainerProfile(name, L"Display", L"Description", NULL, 0, &sid);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK) FreeSid(sid);
+    hr = DeleteAppContainerProfile(name);
+    ok(hr == S_OK, "got %#lx\n", hr);
+}
+
 START_TEST(userenv)
 {
     pIsWow64Process = (void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "IsWow64Process");
@@ -464,4 +621,6 @@ START_TEST(userenv)
     test_create_env();
     test_get_profiles_dir();
     test_get_user_profile_dir();
+    test_load_user_profile();
+    test_app_container_profile();
 }
--- a/include/userenv.h
+++ b/include/userenv.h
@@ -108,6 +108,8 @@ USERENVAPI BOOL WINAPI RefreshPolicyEx(BOOL,DWORD);
 USERENVAPI BOOL WINAPI RegisterGPNotification(HANDLE,BOOL);
 USERENVAPI BOOL WINAPI UnloadUserProfile(HANDLE,HANDLE);
 USERENVAPI BOOL WINAPI UnregisterGPNotification(HANDLE);
+USERENVAPI HRESULT WINAPI CreateAppContainerProfile(PCWSTR,PCWSTR,PCWSTR,PSID_AND_ATTRIBUTES,DWORD,PSID*);
+USERENVAPI HRESULT WINAPI DeleteAppContainerProfile(PCWSTR);
 USERENVAPI HRESULT WINAPI DeriveAppContainerSidFromAppContainerName(PCWSTR,PSID*);
 
 #ifdef __cplusplus
