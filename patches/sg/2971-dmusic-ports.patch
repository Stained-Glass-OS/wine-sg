diff --git a/dlls/dmusic/buffer.c b/dlls/dmusic/buffer.c
index 7f6087f..405fd98 100644
--- a/dlls/dmusic/buffer.c
+++ b/dlls/dmusic/buffer.c
@@ -83,6 +83,7 @@ static HRESULT WINAPI IDirectMusicBufferImpl_Flush(LPDIRECTMUSICBUFFER iface)
     TRACE("(%p)->()\n", iface);
 
     This->write_pos = 0;
+    This->read_pos = 0;
 
     return S_OK;
 }
@@ -91,7 +92,22 @@ static HRESULT WINAPI IDirectMusicBufferImpl_TotalTime(LPDIRECTMUSICBUFFER iface
 {
     IDirectMusicBufferImpl *This = impl_from_IDirectMusicBuffer(iface);
 
-    FIXME("(%p, %p): stub\n", This, prtTime);
+    DWORD pos = 0;
+
+    TRACE("(%p, %p)\n", This, prtTime);
+
+    if (!prtTime) return E_POINTER;
+
+    /* the span of the buffer is the offset of its last event from the buffer start */
+    *prtTime = 0;
+    while (pos + sizeof(DMUS_EVENTHEADER) <= This->write_pos)
+    {
+        DMUS_EVENTHEADER *header = (DMUS_EVENTHEADER *)&This->data[pos];
+#ifndef SG_MUTANT_BUF_TOTAL
+        *prtTime = header->rtDelta;
+#endif
+        pos += DMUS_EVENT_SIZE(header->cbEvent);
+    }
 
     return S_OK;
 }
@@ -161,7 +177,11 @@ static HRESULT WINAPI IDirectMusicBufferImpl_ResetReadPtr(LPDIRECTMUSICBUFFER if
 {
     IDirectMusicBufferImpl *This = impl_from_IDirectMusicBuffer(iface);
 
-    FIXME("(%p): stub\n", This);
+    TRACE("(%p)\n", This);
+
+#ifndef SG_MUTANT_BUF_RESET
+    This->read_pos = 0;
+#endif
 
     return S_OK;
 }
@@ -170,7 +190,23 @@ static HRESULT WINAPI IDirectMusicBufferImpl_GetNextEvent(LPDIRECTMUSICBUFFER if
 {
     IDirectMusicBufferImpl *This = impl_from_IDirectMusicBuffer(iface);
 
-    FIXME("(%p, %p, %p, %p, %p): stub\n", This, prt, pdwChannelGroup, pdwLength, ppData);
+    DMUS_EVENTHEADER *header;
+
+    TRACE("(%p, %p, %p, %p, %p)\n", This, prt, pdwChannelGroup, pdwLength, ppData);
+
+#ifdef SG_MUTANT_BUF_NEXT
+    return S_FALSE;
+#endif
+    if (This->read_pos + sizeof(DMUS_EVENTHEADER) > This->write_pos) return S_FALSE;
+
+    header = (DMUS_EVENTHEADER *)&This->data[This->read_pos];
+    if (This->read_pos + DMUS_EVENT_SIZE(header->cbEvent) > This->write_pos) return S_FALSE;
+
+    if (prt) *prt = This->start_time + header->rtDelta;
+    if (pdwChannelGroup) *pdwChannelGroup = header->dwChannelGroup;
+    if (pdwLength) *pdwLength = header->cbEvent;
+    if (ppData) *ppData = (BYTE *)(header + 1);
+    This->read_pos += DMUS_EVENT_SIZE(header->cbEvent);
 
     return S_OK;
 }
@@ -267,6 +303,7 @@ static HRESULT WINAPI IDirectMusicBufferImpl_SetUsedBytes(LPDIRECTMUSICBUFFER if
         return DMUS_E_BUFFER_FULL;
 
     This->write_pos = used_bytes;
+    This->read_pos = 0;
 
     return S_OK;
 }
