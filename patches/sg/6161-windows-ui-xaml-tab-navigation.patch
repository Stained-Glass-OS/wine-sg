+/* Tab past the island's last focus target (Shift+Tab before its first): the host takes the focus --
+ * TakeFocusRequested (reason First going forward, Last going back) when the host listens, else the
+ * next (previous) tab stop of the host's window, as a dialog would; FALSE: the island keeps it */
+BOOL xaml_source_leave_focus( HWND island, BOOL back )
+{
+    struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( island, GWLP_USERDATA );
+    HWND root, next;
+
+    if (!source) return FALSE;
+    if (!list_empty( &source->take_focus_requested.entries ))
+    {
+        struct take_focus_args *args = calloc( 1, sizeof(*args) );
+        if (!args) return FALSE;
+        args->iface.vtbl = take_focus_args_vtbl;
+        args->request = nav_request_create( back ? 4 : 3, NULL, NULL );   /* Last, First */
+        xobj_init( &args->obj, &take_focus_args_class, NULL );
+        TRACE( "%p: TakeFocusRequested (%s)\n", source, back ? "Last" : "First" );
+        xaml_focus_element( NULL, NULL );
+        IInspectable_AddRef( (IInspectable *)&source->IDesktopWindowXamlSource_iface );
+        xaml_raise_routed( &source->take_focus_requested, (IInspectable *)&source->IDesktopWindowXamlSource_iface,
+                           (IInspectable *)&args->iface );
+        IInspectable_Release( (IInspectable *)&source->IDesktopWindowXamlSource_iface );
+        IInspectable_Release( (IInspectable *)&args->iface );
+        return TRUE;
+    }
+    if (!(root = GetAncestor( island, GA_ROOT )) || root == island) return FALSE;
+    next = GetNextDlgTabItem( root, island, back );
+    if (!next || next == island || next == root || IsChild( island, next )) return FALSE;
+    TRACE( "%p: the focus to %p\n", source, next );
+    xaml_focus_element( NULL, NULL );
+    SetFocus( next );
+    return TRUE;
+}
+
+/* NavigateFocus: the host gives the island the focus -- its first (First, Programmatic, a direction)
+ * or last (Last) focus target, or the one it had (Restore) */
 static HRESULT WINAPI source_NavigateFocus( struct xiface *iface, IInspectable *request, IInspectable **result )
 {
-    FIXME( "%p, %p, %p stub!\n", iface, request, result );
-    return E_NOTIMPL;
+    struct xaml_source *source = source_from_iface( iface );
+    IInspectable *req = NULL;
+    INT32 reason = 0;
+    boolean moved;
+
+    TRACE( "%p, %p, %p\n", source, request, result );
+    if (!result) return E_POINTER;
+    if (request && SUCCEEDED(IInspectable_QueryInterface( request, &IID_IXamlSourceFocusNavigationRequest, (void **)&req )))
+    {
+        ((HRESULT (WINAPI *)( IInspectable *, INT32 * ))((void **)req->lpVtbl)[IXamlSourceFocusNavigationRequest_Reason])( req, &reason );
+        IInspectable_Release( req );
+    }
+    moved = source->window && source->content && xaml_focus_navigate( source->window, source->content, reason );
+    if (moved) SetFocus( source->window );
+    return (*result = nav_result_create( moved )) ? S_OK : E_OUTOFMEMORY;
 }
 
