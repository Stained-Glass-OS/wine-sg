+#ifndef SV2GV_CURRENTVIEW
+#define SV2GV_CURRENTVIEW ((ULONG)-1)
+#define SV2GV_DEFAULTVIEW ((ULONG)-2)
+#endif
+
+/* Stained Glass OS: the view state written into the stream of the browser. */
+struct view_state
+{
+    DWORD magic;
+    DWORD version;
+    DWORD view_mode;
+    DWORD flags;
+};
+#define VIEW_STATE_MAGIC 0x53475653 /* 'SGVS' */
+
 static HRESULT WINAPI IShellView_fnSaveViewState(IShellView3 *iface)
 {
     IShellViewImpl *This = impl_from_IShellView3(iface);
-    FIXME("(%p) stub\n", This);
+    struct view_state state;
+    IStream *stream;
+    HRESULT hr;
+
+    TRACE("(%p)\n", This);
+
+#ifdef SG_MUTANT_VIEW_SAVESTATE
     return S_OK;
+#endif
+    if (!This->pShellBrowser) return S_OK;
+    hr = IShellBrowser_GetViewStateStream(This->pShellBrowser, STGM_WRITE, &stream);
+    if (FAILED(hr) || !stream) return S_OK;   /* the browser keeps no state */
+
+    state.magic = VIEW_STATE_MAGIC;
+    state.version = 1;
+    state.view_mode = This->FolderSettings.ViewMode;
+    state.flags = This->FolderSettings.fFlags;
+    hr = IStream_Write(stream, &state, sizeof(state), NULL);
+    IStream_Release(stream);
+    return SUCCEEDED(hr) ? S_OK : hr;
+}
+
+/* the view mode that was saved by the view this browser had before */
+static BOOL load_view_state(IShellViewImpl *This, FOLDERVIEWMODE *mode)
+{
+    struct view_state state;
+    IStream *stream;
+    ULONG read = 0;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_VIEW_LOADSTATE
+    return FALSE;
+#endif
+    if (!This->pShellBrowser) return FALSE;
+    hr = IShellBrowser_GetViewStateStream(This->pShellBrowser, STGM_READ, &stream);
+    if (FAILED(hr) || !stream) return FALSE;
+    hr = IStream_Read(stream, &state, sizeof(state), &read);
+    IStream_Release(stream);
+    if (FAILED(hr) || read != sizeof(state) || state.magic != VIEW_STATE_MAGIC || state.version != 1) return FALSE;
+    *mode = state.view_mode;
+    return TRUE;
 }
 
 static HRESULT WINAPI IShellView_fnSelectItem(IShellView3 *iface, LPCITEMIDLIST pidl, UINT flags)
@@ -3519,8 +3582,30 @@ static HRESULT WINAPI IShellView_fnGetItemObject(IShellView3 *iface, UINT uItem,
 
 static HRESULT WINAPI IShellView2_fnGetView(IShellView3 *iface, SHELLVIEWID *view_guid, ULONG view_type)
 {
-    FIXME("(%p)->(%s, %#lx) stub!\n", iface, debugstr_guid(view_guid), view_type);
+    IShellViewImpl *This = impl_from_IShellView3(iface);
+    FOLDERVIEWMODE mode;
+
+    TRACE("(%p)->(%p, %#lx)\n", This, view_guid, view_type);
+
+#ifdef SG_MUTANT_VIEW_GETVIEW
     return E_NOTIMPL;
+#endif
+    if (!view_guid) return E_INVALIDARG;
+    if (view_type == SV2GV_CURRENTVIEW) mode = This->FolderSettings.ViewMode;
+    else if (view_type == SV2GV_DEFAULTVIEW) mode = FVM_ICON; /* GUESS: the default of the shell view */
+    else return E_INVALIDARG;
+
+    switch (mode)
+    {
+    case FVM_SMALLICON: *view_guid = VID_SmallIcons; break;
+    case FVM_LIST: *view_guid = VID_List; break;
+    case FVM_DETAILS: *view_guid = VID_Details; break;
+    case FVM_THUMBNAIL: *view_guid = VID_Thumbnails; break;
+    case FVM_TILE: *view_guid = VID_Tile; break;
+    case FVM_THUMBSTRIP: *view_guid = VID_ThumbStrip; break;
+    default: *view_guid = VID_LargeIcons; break;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI IShellView2_fnCreateViewWindow2(IShellView3 *iface, SV2CVW2_PARAMS *view_params)
@@ -3576,7 +3661,9 @@ static HRESULT WINAPI IShellView3_fnCreateViewWindow3(IShellView3 *iface, IShell
     This->FolderSettings.ViewMode = mode;
     This->FolderSettings.fFlags = mask & flags;
 
-    if (view_id)
+    /* the view mode that the browser kept from the view before comes first */
+    if (load_view_state(This, &mode)) This->FolderSettings.ViewMode = mode;
+    else if (view_id)
     {
         if (IsEqualGUID(view_id, &VID_LargeIcons))
             This->FolderSettings.ViewMode = FVM_ICON;
