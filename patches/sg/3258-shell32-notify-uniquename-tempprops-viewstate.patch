diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index 827a367..43b0493 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -485,24 +485,12 @@ BOOL WINAPI IsLFNDriveAW(LPCVOID lpszPath)
 /*
 	########## Creating Something Unique ##########
 */
-/*************************************************************************
- * PathMakeUniqueNameA	[internal]
- */
-static BOOL PathMakeUniqueNameA(
-	LPSTR lpszBuffer,
-	DWORD dwBuffSize,
-	LPCSTR lpszShortName,
-	LPCSTR lpszLongName,
-	LPCSTR lpszPathName)
-{
-	FIXME("%p %lu %s %s %s stub\n",
-	 lpszBuffer, dwBuffSize, debugstr_a(lpszShortName),
-	 debugstr_a(lpszLongName), debugstr_a(lpszPathName));
-	return TRUE;
-}
-
 /*************************************************************************
  * PathMakeUniqueNameW	[internal]
+ *
+ * The long template (when the drive supports long names) gets " (n)" appended,
+ * counting from 1 until no such name exists in the directory; the short
+ * template (8.3 drives) gets the number in place of its last characters.
  */
 static BOOL PathMakeUniqueNameW(
 	LPWSTR lpszBuffer,
@@ -511,10 +499,87 @@ static BOOL PathMakeUniqueNameW(
 	LPCWSTR lpszLongName,
 	LPCWSTR lpszPathName)
 {
-	FIXME("%p %lu %s %s %s stub\n",
-	 lpszBuffer, dwBuffSize, debugstr_w(lpszShortName),
-	 debugstr_w(lpszLongName), debugstr_w(lpszPathName));
+	WCHAR path[MAX_PATH], name[MAX_PATH], full[MAX_PATH];
+	BOOL lfn = TRUE;
+	const WCHAR *templ;
+	int n;
+
+	TRACE("%p %lu %s %s %s\n", lpszBuffer, dwBuffSize, debugstr_w(lpszShortName),
+	      debugstr_w(lpszLongName), debugstr_w(lpszPathName));
+
+#ifdef SG_MUTANT_PMUN
 	return TRUE;
+#endif
+	if (!lpszBuffer || !dwBuffSize) return FALSE;
+	if (lpszPathName && *lpszPathName)
+	{
+	    if (wcslen(lpszPathName) >= MAX_PATH) return FALSE;
+	    wcscpy(path, lpszPathName);
+	    {
+	        /* long names are supported when the volume of the directory allows components longer than 8.3 */
+	        WCHAR root[MAX_PATH];
+	        DWORD max_component;
+
+	        wcscpy(root, path);
+	        if (PathStripToRootW(root)) PathAddBackslashW(root);
+	        if (GetVolumeInformationW(root, NULL, 0, NULL, &max_component, NULL, NULL, 0))
+	            lfn = max_component > 12;
+	    }
+	}
+	else path[0] = 0;
+
+	templ = (lfn && lpszLongName && *lpszLongName) ? lpszLongName : lpszShortName;
+	if (!templ || !*templ || wcslen(templ) >= MAX_PATH - 16) return FALSE;
+
+	for (n = 1; n < 1000; n++)
+	{
+	    if (templ == lpszLongName)
+	        swprintf(name, ARRAY_SIZE(name), L"%s (%d)", templ, n);
+	    else
+	    {
+	        WCHAR digits[8];
+	        int len = swprintf(digits, ARRAY_SIZE(digits), L"%d", n);
+	        int keep = min((int)wcslen(templ), 8 - len);
+	        memcpy(name, templ, keep * sizeof(WCHAR));
+	        wcscpy(name + keep, digits);
+	    }
+	    if (path[0])
+	    {
+	        wcscpy(full, path);
+	        PathAppendW(full, name);
+	    }
+	    else wcscpy(full, name);
+	    if (GetFileAttributesW(full) == INVALID_FILE_ATTRIBUTES)
+	    {
+	        if (wcslen(full) >= dwBuffSize) return FALSE;
+	        wcscpy(lpszBuffer, full);
+	        return TRUE;
+	    }
+	}
+	return FALSE;
+}
+
+/*************************************************************************
+ * PathMakeUniqueNameA	[internal]
+ */
+static BOOL PathMakeUniqueNameA(
+	LPSTR lpszBuffer,
+	DWORD dwBuffSize,
+	LPCSTR lpszShortName,
+	LPCSTR lpszLongName,
+	LPCSTR lpszPathName)
+{
+	WCHAR shortW[MAX_PATH], longW[MAX_PATH], pathW[MAX_PATH], resultW[MAX_PATH];
+	BOOL ret;
+
+	if (!lpszBuffer || !dwBuffSize) return FALSE;
+	shortW[0] = longW[0] = pathW[0] = 0;
+	if (lpszShortName) MultiByteToWideChar(CP_ACP, 0, lpszShortName, -1, shortW, MAX_PATH);
+	if (lpszLongName) MultiByteToWideChar(CP_ACP, 0, lpszLongName, -1, longW, MAX_PATH);
+	if (lpszPathName) MultiByteToWideChar(CP_ACP, 0, lpszPathName, -1, pathW, MAX_PATH);
+	ret = PathMakeUniqueNameW(resultW, MAX_PATH, shortW, longW, pathW);
+	if (ret && !WideCharToMultiByte(CP_ACP, 0, resultW, -1, lpszBuffer, dwBuffSize, NULL, NULL)) ret = FALSE;
+	return ret;
 }
 
 /*************************************************************************
@@ -4044,9 +4109,18 @@ static HRESULT WINAPI knownfolder_GetRedirectionCapabilities(
     IKnownFolder *iface,
     KF_REDIRECTION_CAPABILITIES *pCapabilities)
 {
-    FIXME("%p stub\n", pCapabilities);
+    struct knownfolder *knownfolder = impl_from_IKnownFolder(iface);
+    KF_CATEGORY category;
+
+    TRACE("%p, %p\n", knownfolder, pCapabilities);
     if(!pCapabilities) return E_INVALIDARG;
     *pCapabilities = KF_REDIRECTION_CAPABILITIES_DENY_ALL;
+#ifdef SG_MUTANT_KF_REDIRCAPS
+    return S_OK;
+#endif
+    /* a fixed folder (the Windows directory) cannot be redirected: no capability and no denial are set */
+    if(SUCCEEDED(knownfolder_GetCategory(iface, &category)) && category == KF_CATEGORY_FIXED)
