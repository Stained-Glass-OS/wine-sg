+static HRESULT item_temp_store(struct shell_item *This)
+{
+    if (!This->temp_store)
+    {
+        IPropertyStore *store;
+        HRESULT hr = PSCreateMemoryPropertyStore(&IID_IPropertyStore, (void **)&store);
+
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer((void **)&This->temp_store, store, NULL))
+            IPropertyStore_Release(store);
+    }
+    return S_OK;
+}
+
 static HRESULT WINAPI ShellItem2_GetPropertyStore(IShellItem2 *iface, GETPROPERTYSTOREFLAGS flags,
     REFIID riid, void **ppv)
 {
     struct shell_item *This = impl_from_IShellItem2(iface);
+    HRESULT hr;
+
+    TRACE("%p (%d, %s, %p)\n", This, flags, shdebugstr_guid(riid), ppv);
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (flags & GPS_TEMPORARY)
+    {
+        /* the temporary store, created when the first value is set or read */
+        hr = item_temp_store(This);
+        if (FAILED(hr)) return hr;
+        return IPropertyStore_QueryInterface(This->temp_store, riid, ppv);
+    }
     FIXME("Stub: %p (%d, %s, %p)\n", This, flags, shdebugstr_guid(riid), ppv);
     return E_NOTIMPL;
 }
@@ -589,6 +618,7 @@ HRESULT WINAPI IShellItem_Constructor(IUnknown *pUnkOuter, REFIID riid, void **p
     This->pidl = NULL;
     This->IPersistIDList_iface.lpVtbl = &ShellItem_IPersistIDList_Vtbl;
     This->IShellItemImageFactory_iface.lpVtbl = &ShellItem_IShellItemImageFactory_Vtbl;
+    This->temp_store = NULL;
 
     ret = IShellItem2_QueryInterface(&This->IShellItem2_iface, riid, ppv);
     IShellItem2_Release(&This->IShellItem2_iface);
@@ -1492,9 +1522,47 @@ HRESULT WINAPI SHGetPropertyStoreFromParsingName(const WCHAR *path, IBindCtx *pb
     return hr;
 }
 
+static struct shell_item *shell_item_from_interface(IShellItem *psi)
+{
+    IShellItem2 *item2;
+    struct shell_item *item = NULL;
+
+    /* only the items of this module keep a temporary store */
+    if (SUCCEEDED(IShellItem_QueryInterface(psi, &IID_IShellItem2, (void **)&item2)))
+    {
+        if (item2->lpVtbl == &ShellItem2_Vtbl) item = impl_from_IShellItem2(item2);
+        IShellItem2_Release(item2);   /* the caller holds its own reference */
+    }
+    return item;
+}
+
 HRESULT WINAPI SHSetTemporaryPropertyForItem(IShellItem *psi, REFPROPERTYKEY propkey, REFPROPVARIANT propvar)
 {
-    FIXME("%p %p %p: stub\n", psi, propkey, propvar);
+    struct shell_item *item;
+    HRESULT hr;
 
+    TRACE("%p %p %p\n", psi, propkey, propvar);
+
+#ifdef SG_MUTANT_SHI_TEMPPROP
     return E_NOTIMPL;
+#endif
+    if (!psi || !propkey || !propvar) return E_INVALIDARG;
+    if (!(item = shell_item_from_interface(psi))) return E_NOINTERFACE;  /* GUESS: items of other modules */
+    if (FAILED(hr = item_temp_store(item))) return hr;
+    hr = IPropertyStore_SetValue(item->temp_store, propkey, propvar);
+    if (SUCCEEDED(hr)) hr = IPropertyStore_Commit(item->temp_store);
+    return hr;
+}
+
+HRESULT WINAPI SHGetTemporaryPropertyForItem(IShellItem *psi, REFPROPERTYKEY propkey, PROPVARIANT *ppropvar)
+{
+    struct shell_item *item;
+    HRESULT hr;
+
+    TRACE("%p %p %p\n", psi, propkey, ppropvar);
+
+    if (!psi || !propkey || !ppropvar) return E_INVALIDARG;
+    if (!(item = shell_item_from_interface(psi))) return E_NOINTERFACE;
+    if (FAILED(hr = item_temp_store(item))) return hr;
+    return IPropertyStore_GetValue(item->temp_store, propkey, ppropvar);
 }
