+/* A location that is not a file system item has no shell item id list of its own; the
+ * browser represents it by a list holding the address, which only it can read back. */
+#include <pshpack1.h>
+typedef struct {
+    USHORT cb;
+    BYTE type;
+    BYTE magic[3];
+    WCHAR url[1];
+} url_pidl;
+#include <poppack.h>
+
+static const BYTE url_pidl_magic[3] = {'S','G','U'};
+
+static HRESULT url_to_pidl(const WCHAR *url, PIDLIST_ABSOLUTE *ret)
+{
+    WCHAR path[MAX_PATH];
+    DWORD len = ARRAY_SIZE(path);
+    size_t size, chars;
+    url_pidl *pidl;
+
+    *ret = NULL;
+    if(!url || !*url)
+        return E_INVALIDARG;
+
+    /* items of the file system have real shell item id lists */
+    if(!wcsnicmp(url, L"file:", 5)) {
+        if(SUCCEEDED(PathCreateFromUrlW(url, path, &len, 0)) && SUCCEEDED(SHParseDisplayName(path, NULL, ret, 0, NULL)))
+            return S_OK;
+    }else if(((url[0] >= 'A' && url[0] <= 'Z') || (url[0] >= 'a' && url[0] <= 'z')) && url[1] == ':' && url[2] == '\\') {
+        if(SUCCEEDED(SHParseDisplayName(url, NULL, ret, 0, NULL)))
+            return S_OK;
+    }
+
+    chars = wcslen(url) + 1;
+    size = offsetof(url_pidl, url) + chars * sizeof(WCHAR);
+    pidl = CoTaskMemAlloc(size + sizeof(USHORT));
+    if(!pidl)
+        return E_OUTOFMEMORY;
+    pidl->cb = size;
+    pidl->type = 0xcf;
+    memcpy(pidl->magic, url_pidl_magic, sizeof(url_pidl_magic));
+    memcpy(pidl->url, url, chars * sizeof(WCHAR));
+    *(USHORT*)((BYTE*)pidl + size) = 0;
+    *ret = (PIDLIST_ABSOLUTE)pidl;
+    return S_OK;
+}
+
+/* the address as a CoTaskMem string */
+static HRESULT pidl_to_url(PCIDLIST_ABSOLUTE pidl, UINT flags, WCHAR **ret)
+{
+    const url_pidl *p = (const url_pidl*)pidl;
+    SIGDN sigdn = SIGDN_URL;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!pidl)
+        return E_INVALIDARG;
+
+    if(p->cb > offsetof(url_pidl, url) && !memcmp(p->magic, url_pidl_magic, sizeof(url_pidl_magic))) {
+        *ret = co_strdupW(p->url);
+        return *ret ? S_OK : E_OUTOFMEMORY;
+    }
+
+    if(flags & SHGDN_FORPARSING)
+        sigdn = SIGDN_DESKTOPABSOLUTEPARSING;
+    else if(flags & SHGDN_FORADDRESSBAR)
+        sigdn = SIGDN_DESKTOPABSOLUTEEDITING;
+    hres = SHGetNameFromIDList(pidl, sigdn, ret);
+    if(FAILED(hres) && sigdn == SIGDN_URL) {
+        /* a file system item: its path as an address */
+        WCHAR *path, url[INTERNET_MAX_URL_LENGTH];
+        DWORD len = ARRAY_SIZE(url);
+
+        if(SUCCEEDED(SHGetNameFromIDList(pidl, SIGDN_FILESYSPATH, &path))) {
+            if(SUCCEEDED(UrlCreateFromPathW(path, url, &len, 0))) {
+                *ret = co_strdupW(url);
+                hres = *ret ? S_OK : E_OUTOFMEMORY;
+            }
+            CoTaskMemFree(path);
+        }
+    }
+    return hres;
+}
