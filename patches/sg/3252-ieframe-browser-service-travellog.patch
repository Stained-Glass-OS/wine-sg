+/* The ITravelLog handed out is a view of the log the document host keeps; it is fixed to the
+ * browser, not to the host, because the document keeps it beyond the life of the host. */
+typedef struct {
+    ITravelLog ITravelLog_iface;
+    LONG ref;
+    ShellBrowser *sb;
+} TravelLog;
+
+typedef struct {
+    ITravelEntry ITravelEntry_iface;
+    LONG ref;
+    ShellBrowser *sb;
+    WCHAR *url;
+    int offset;     /* from the current entry when the entry was looked up */
+    unsigned index;
+} TravelEntry;
+
+static inline TravelEntry *impl_from_ITravelEntry(ITravelEntry *iface)
+{
+    return CONTAINING_RECORD(iface, TravelEntry, ITravelEntry_iface);
+}
+
+static HRESULT WINAPI TravelEntry_QueryInterface(ITravelEntry *iface, REFIID riid, void **ppv)
+{
+    TravelEntry *This = impl_from_ITravelEntry(iface);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ITravelEntry)) {
+        *ppv = &This->ITravelEntry_iface;
+        IUnknown_AddRef((IUnknown*)*ppv);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI TravelEntry_AddRef(ITravelEntry *iface)
+{
+    TravelEntry *This = impl_from_ITravelEntry(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI TravelEntry_Release(ITravelEntry *iface)
+{
+    TravelEntry *This = impl_from_ITravelEntry(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        IShellBrowser_Release(&This->sb->IShellBrowser_iface);
+        free(This->url);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI TravelEntry_Invoke(ITravelEntry *iface, IUnknown *punk)
+{
+    TravelEntry *This = impl_from_ITravelEntry(iface);
+    const WCHAR *url;
+
+    TRACE("%p %p\n", This, punk);
+
+    if(!This->sb->doc_host)
+        return E_FAIL;
+    /* the entry has to be still where it was found */
+    url = travellog_url(This->sb->doc_host, This->index);
+    if(!url || wcscmp(url, This->url))
+        return E_FAIL;
+    return travel_to_entry(This->sb->doc_host, This->index);
+}
+
+static HRESULT WINAPI TravelEntry_Update(ITravelEntry *iface, IUnknown *punk, BOOL fIsLocalAnchor)
+{
+    TravelEntry *This = impl_from_ITravelEntry(iface);
+    TRACE("%p %p %d\n", This, punk, fIsLocalAnchor);
+    /* the host saves the state of the page itself when the page is left */
+    return S_OK;
+}
+
+static HRESULT WINAPI TravelEntry_GetPidl(ITravelEntry *iface, LPITEMIDLIST *ppidl)
+{
+    TravelEntry *This = impl_from_ITravelEntry(iface);
+    TRACE("%p %p\n", This, ppidl);
+
+    if(!ppidl)
+        return E_POINTER;
+    return url_to_pidl(This->url, ppidl);
+}
