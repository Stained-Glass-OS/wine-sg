+/* Select the text asked for by IShellUIHelper::NavigateAndFind in the document that was loaded. */
+void run_pending_find(DocHost *This)
+{
+    IHTMLDocument2 *doc;
+    IHTMLElement *body_elem;
+    IHTMLBodyElement *body;
+    IHTMLTxtRange *range;
+    VARIANT_BOOL found = VARIANT_FALSE;
+    BSTR text = This->pending_find;
+
+    if(!text)
+        return;
+    This->pending_find = NULL;
+
+    if(This->document && SUCCEEDED(IUnknown_QueryInterface(This->document, &IID_IHTMLDocument2, (void**)&doc))) {
+        if(SUCCEEDED(IHTMLDocument2_get_body(doc, &body_elem)) && body_elem) {
+            if(SUCCEEDED(IHTMLElement_QueryInterface(body_elem, &IID_IHTMLBodyElement, (void**)&body))) {
+                if(SUCCEEDED(IHTMLBodyElement_createTextRange(body, &range)) && range) {
+                    if(SUCCEEDED(IHTMLTxtRange_findText(range, text, 0x7fffffff, 0, &found)) && found)
+                        IHTMLTxtRange_select(range);
+                    IHTMLTxtRange_Release(range);
+                }
+                IHTMLBodyElement_Release(body);
+            }
+            IHTMLElement_Release(body_elem);
+        }
+        IHTMLDocument2_Release(doc);
+    }
+    SysFreeString(text);
+}
