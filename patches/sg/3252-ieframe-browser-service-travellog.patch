+
+static HRESULT travel_index(TravelLog *This, int offset, unsigned *index)
+{
+    DocHost *doc_host = This->sb->doc_host;
+    LONGLONG target;
+
+    if(!doc_host)
+        return E_FAIL;
+    target = (LONGLONG)doc_host->travellog.position + offset;
+    if(target < 1 || target > travellog_count(doc_host))
+        return E_FAIL;
+    *index = target;
+    return S_OK;
+}
+
+static HRESULT WINAPI TravelLog_Travel(ITravelLog *iface, IUnknown *punk, int iOffset)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    unsigned index;
+    HRESULT hres;
+
+    TRACE("%p %p %d\n", This, punk, iOffset);
+
+    hres = travel_index(This, iOffset, &index);
+    if(FAILED(hres))
+        return hres;
+    return travel_to_entry(This->sb->doc_host, index);
+}
+
+static HRESULT WINAPI TravelLog_GetTravelEntry(ITravelLog *iface, IUnknown *punk, int iOffset, ITravelEntry **ppte)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    unsigned index;
+    HRESULT hres;
+
+    TRACE("%p %p %d %p\n", This, punk, iOffset, ppte);
+
+    if(ppte)
+        *ppte = NULL;
+    hres = travel_index(This, iOffset, &index);
+    if(FAILED(hres))
+        return hres;
+    return create_travel_entry(This->sb, index, iOffset, ppte);
+}
+
+static HRESULT WINAPI TravelLog_FindTravelEntry(ITravelLog *iface, IUnknown *punk, LPCITEMIDLIST pidl, ITravelEntry **ppte)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    unsigned i, count;
+    WCHAR *url;
+    HRESULT hres;
+
+    TRACE("%p %p %p %p\n", This, punk, pidl, ppte);
+
+    if(!ppte)
+        return E_POINTER;
+    *ppte = NULL;
+    if(!This->sb->doc_host)
+        return E_FAIL;
+
+    hres = pidl_to_url(pidl, 0, &url);
+    if(FAILED(hres))
+        return hres;
+
+    hres = E_FAIL;
+    count = travellog_count(This->sb->doc_host);
+    for(i = 1; i <= count; i++) {
+        const WCHAR *entry_url = travellog_url(This->sb->doc_host, i);
+        if(entry_url && !wcsicmp(entry_url, url)) {
+            hres = create_travel_entry(This->sb, i, (int)i - (int)This->sb->doc_host->travellog.position, ppte);
+            break;
+        }
+    }
+    CoTaskMemFree(url);
+    return hres;
+}
+
+static HRESULT WINAPI TravelLog_GetToolTipText(ITravelLog *iface, IUnknown *punk, int iOffset, int idsTemplate,
+        LPWSTR pwzText, DWORD cchText)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    unsigned index;
+    HRESULT hres;
+
+    TRACE("%p %p %d %d %p %ld\n", This, punk, iOffset, idsTemplate, pwzText, cchText);
+
+    if(!pwzText || !cchText)
+        return E_INVALIDARG;
+    hres = travel_index(This, iOffset, &index);
+    if(FAILED(hres))
+        return hres;
+    lstrcpynW(pwzText, travellog_url(This->sb->doc_host, index), cchText);
+    return S_OK;
+}
+
+static HRESULT insert_travel_menu_item(HMENU menu, int *pos, int *id, const WCHAR *url, UINT state)
+{
+    MENUITEMINFOW mii;
+
+    memset(&mii, 0, sizeof(mii));
+    mii.cbSize = sizeof(mii);
+    mii.fMask = MIIM_ID | MIIM_STRING | MIIM_STATE;
+    mii.wID = (*id)++;
+    mii.fState = state;
+    mii.dwTypeData = (WCHAR*)url;
+    if(!InsertMenuItemW(menu, (*pos)++, TRUE, &mii))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return S_OK;
+}
+
+/* The forward entries are listed first, the furthest on top, then the current entry, then the
+ * entries back from the nearest. At most idLast - idFirst + 1 entries are inserted. */
+static HRESULT WINAPI TravelLog_InsertMenuEntries(ITravelLog *iface, IUnknown *punk, HMENU hmenu, int nPos,
+        int idFirst, int idLast, DWORD dwFlags)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    DocHost *doc_host = This->sb->doc_host;
+    int i, id = idFirst, pos = nPos, current;
+    HRESULT hres = S_OK;
+
+    TRACE("%p %p %p %d %d %d %lx\n", This, punk, hmenu, nPos, idFirst, idLast, dwFlags);
+
+    if(!hmenu || idLast < idFirst)
+        return E_INVALIDARG;
+    if(!doc_host)
+        return E_FAIL;
+
+    current = doc_host->travellog.position;
+    if(dwFlags & TLMENUF_FORE) {
+        for(i = travellog_count(doc_host); i > current && id <= idLast && SUCCEEDED(hres); i--)
+            hres = insert_travel_menu_item(hmenu, &pos, &id, travellog_url(doc_host, i), 0);
+    }
+    if((dwFlags & TLMENUF_INCLUDECURRENT) && id <= idLast && SUCCEEDED(hres) && travellog_url(doc_host, current))
+        hres = insert_travel_menu_item(hmenu, &pos, &id, travellog_url(doc_host, current),
+                (dwFlags & TLMENUF_CHECKCURRENT) == TLMENUF_CHECKCURRENT ? MFS_CHECKED : 0);
+    if(dwFlags & TLMENUF_BACK) {
+#ifdef SG_MUTANT_IEBS_MENU
+        for(i = 1; i < current && id <= idLast && SUCCEEDED(hres); i++)
+#else
+        for(i = current - 1; i >= 1 && id <= idLast && SUCCEEDED(hres); i--)
+#endif
+            hres = insert_travel_menu_item(hmenu, &pos, &id, travellog_url(doc_host, i), 0);
+    }
+    return hres;
+}
+
+static HRESULT create_travel_log(ShellBrowser *sb, ITravelLog **ret);
