+static HRESULT create_travel_entry(ShellBrowser *sb, unsigned index, int offset, ITravelEntry **ret)
+{
+    const WCHAR *url = travellog_url(sb->doc_host, index);
+    TravelEntry *entry;
+
+    if(!url)
+        return E_FAIL;
+    if(!ret)
+        return S_OK;
+
+    entry = calloc(1, sizeof(*entry));
+    if(!entry)
+        return E_OUTOFMEMORY;
+    entry->url = wcsdup(url);
+    if(!entry->url) {
+        free(entry);
+        return E_OUTOFMEMORY;
+    }
+    entry->ITravelEntry_iface.lpVtbl = &TravelEntryVtbl;
+    entry->ref = 1;
+    entry->sb = sb;
+    IShellBrowser_AddRef(&sb->IShellBrowser_iface);
+    entry->index = index;
+    entry->offset = offset;
+    *ret = &entry->ITravelEntry_iface;
+    return S_OK;
+}
+
+static inline TravelLog *impl_from_ITravelLog(ITravelLog *iface)
+{
+    return CONTAINING_RECORD(iface, TravelLog, ITravelLog_iface);
+}
+
+static HRESULT WINAPI TravelLog_QueryInterface(ITravelLog *iface, REFIID riid, void **ppv)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ITravelLog)) {
+        *ppv = &This->ITravelLog_iface;
+        IUnknown_AddRef((IUnknown*)*ppv);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI TravelLog_AddRef(ITravelLog *iface)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI TravelLog_Release(ITravelLog *iface)
+{
+    TravelLog *This = impl_from_ITravelLog(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        IShellBrowser_Release(&This->sb->IShellBrowser_iface);
+        free(This);
+    }
+    return ref;
+}
