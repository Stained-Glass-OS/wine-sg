+static const ITravelEntryVtbl TravelEntryVtbl = {
+    TravelEntry_QueryInterface,
+    TravelEntry_AddRef,
+    TravelEntry_Release,
+    TravelEntry_Invoke,
+    TravelEntry_Update,
+    TravelEntry_GetPidl
+};
