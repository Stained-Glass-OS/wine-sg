From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptRetrieveTimeStamp and CryptVerifyTimeStampSignature (RFC 3161 time stamps).

CryptRetrieveTimeStamp hashes the data (or takes the hash with TIMESTAMP_DONT_HASH_DATA), posts an
RFC 3161 TimeStampReq (message imprint, optional policy, nonce, certReq, extensions) to the
time-stamping authority over HTTP(S) (winhttp, delay-loaded), checks the response's status, and
with TIMESTAMP_VERIFY_CONTEXT_SIGNATURE verifies the token; a nonce asked for must come back.
CryptVerifyTimeStampSignature checks a token: CMS SignedData whose content is a TSTInfo, signed by
a certificate from the token or the caller's store, its message imprint the data's hash. Both give
the token and its TSTInfo as one CRYPT_TIMESTAMP_CONTEXT (CryptMemFree). wincrypt.h gains the
RFC 3161 types, flags and prototypes. LibreOffice imports both (document signatures with a time
stamp ended at 'unimplemented function').
---
diff --git a/dlls/crypt32/Makefile.in b/dlls/crypt32/Makefile.in
index 4c92b33..7005696 100644
--- a/dlls/crypt32/Makefile.in
+++ b/dlls/crypt32/Makefile.in
@@ -3,7 +3,7 @@ MODULE    = crypt32.dll
 UNIXLIB   = crypt32.so
 IMPORTLIB = crypt32
 IMPORTS   = user32 advapi32 bcrypt
-DELAYIMPORTS = cryptnet ncrypt
+DELAYIMPORTS = cryptnet ncrypt winhttp
 UNIX_LIBS    = $(SECURITY_LIBS)
 UNIX_CFLAGS  = $(GNUTLS_CFLAGS)
 
@@ -35,4 +35,5 @@ SOURCES = \
 	sip.c \
 	store.c \
 	str.c \
+	timestamp.c \
 	unixlib.c
diff --git a/dlls/crypt32/crypt32.spec b/dlls/crypt32/crypt32.spec
index c8a4b24..79a8570 100644
--- a/dlls/crypt32/crypt32.spec
+++ b/dlls/crypt32/crypt32.spec
@@ -169,6 +169,7 @@
 @ stdcall CryptProtectMemory(ptr long long)
 @ stdcall CryptQueryObject(long ptr long long long ptr ptr ptr ptr ptr ptr)
 @ stdcall CryptRegisterDefaultOIDFunction(long str long wstr)
+@ stdcall CryptRetrieveTimeStamp(wstr long long str ptr ptr long ptr ptr ptr)
 @ stdcall CryptRegisterOIDFunction(long str str wstr str)
 @ stdcall CryptRegisterOIDInfo(ptr long)
 @ stdcall CryptSIPAddProvider(ptr)
@@ -204,6 +205,7 @@
 @ stdcall CryptVerifyDetachedMessageSignature(ptr long ptr long long ptr ptr ptr)
 @ stdcall CryptVerifyMessageHash(ptr ptr long ptr ptr ptr ptr)
 @ stdcall CryptVerifyMessageSignature(ptr long ptr long ptr ptr ptr)
+@ stdcall CryptVerifyTimeStampSignature(ptr long ptr long ptr ptr ptr ptr)
 @ stdcall CryptVerifyMessageSignatureWithKey(ptr ptr ptr long ptr ptr)
 @ stdcall CryptVerifySignatureU(long ptr long long wstr long) advapi32.CryptVerifySignatureW
 @ stdcall I_CertUpdateStore(ptr ptr long long)
diff --git a/dlls/crypt32/timestamp.c b/dlls/crypt32/timestamp.c
new file mode 100644
index 0000000..4dc30b6
--- /dev/null
+++ b/dlls/crypt32/timestamp.c
@@ -0,0 +1,639 @@
