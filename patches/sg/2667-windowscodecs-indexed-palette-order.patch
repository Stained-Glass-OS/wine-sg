From: Stained Glass OS <ke7oxh@gmail.com>
windowscodecs: palettes made from a paletted image list its colors by first appearance

InitializeFromBitmap on a 1, 2, 4 or 8 bpp indexed source whose colors fit
the wanted count lists them in the order they first appear, instead of
splitting the color space; converting a paletted image to another paletted
format then numbers its colors as native does. Removes the three
todo_wine pixel checks of those conversions.
---
--- a/dlls/windowscodecs/palette.c
+++ b/dlls/windowscodecs/palette.c
@@ -646,6 +646,29 @@ static int median_cut(unsigned char *image, unsigned int width, unsigned int hei
 }
 
 
+/* The colors of an image that has no more than 'desired' of them, in the order they first appear
+ * (row by row); returns 0 when there are more. */
+static int first_appearance_colors(const unsigned char *image, unsigned int width, unsigned int height,
+        unsigned int stride, unsigned int desired, unsigned int *colors)
+{
+    unsigned int x, y, i, count = 0, color;
+    const unsigned char *p;
+
+    for (y = 0; y < height; y++)
+    {
+        for (x = 0, p = image + y * stride; x < width; x++, p += 3)
+        {
+            color = 0xff000000 | p[2] << 16 | p[1] << 8 | p[0];
+            for (i = 0; i < count; i++)
+                if (colors[i] == color) break;
+            if (i < count) continue;
+            if (count == desired) return 0;
+            colors[count++] = color;
+        }
+    }
+    return count;
+}
+
 static HRESULT WINAPI PaletteImpl_InitializeFromBitmap(IWICPalette *palette,
     IWICBitmapSource *source, UINT desired, BOOL add_transparent)
 {
@@ -692,7 +715,17 @@ static HRESULT WINAPI PaletteImpl_InitializeFromBitmap(IWICPalette *palette,
     IWICBitmapLock_GetStride(lock, &stride);
     IWICBitmapLock_GetDataPointer(lock, &size, &src);
 
-    actual_number_of_colors = median_cut(src, width, height, stride, add_transparent ? desired - 1 : desired, colors);
+    actual_number_of_colors = 0;
+#ifndef SG_MUTANT_WIC_PALETTE_MEDIAN_ONLY
+    /* A paletted image keeps the order of its colors as they first appear when they fit. */
+    if (IsEqualGUID(&format, &GUID_WICPixelFormat1bppIndexed) || IsEqualGUID(&format, &GUID_WICPixelFormat2bppIndexed)
+            || IsEqualGUID(&format, &GUID_WICPixelFormat4bppIndexed)
+            || IsEqualGUID(&format, &GUID_WICPixelFormat8bppIndexed))
+        actual_number_of_colors = first_appearance_colors(src, width, height, stride,
+                add_transparent ? desired - 1 : desired, colors);
+#endif
+    if (!actual_number_of_colors)
+        actual_number_of_colors = median_cut(src, width, height, stride, add_transparent ? desired - 1 : desired, colors);
     TRACE("actual number of colors: %u\n", actual_number_of_colors);
 
     if (actual_number_of_colors)
