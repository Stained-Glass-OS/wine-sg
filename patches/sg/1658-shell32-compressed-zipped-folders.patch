+/* Stained Glass OS 1658: sources that are not files -- items of a
+ * compressed folder, "C:\a.zip\docs\x.txt" -- are taken as their folder's
+ * data object gives them (CF_HDROP: extracted to a temporary folder) */
+static WCHAR *files_of_items(WCHAR *sources)
+{
+    WCHAR *list = NULL, *p;
+    size_t len = 0;
+
+    for (p = sources; *p; p += wcslen(p) + 1)
+    {
+        WCHAR *files = NULL;
+        size_t n;
+
+        if (GetFileAttributesW(p) == INVALID_FILE_ATTRIBUTES)
+        {
+            FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+            LPITEMIDLIST pidl;
+            IShellFolder *parent;
+            LPCITEMIDLIST child;
+            IDataObject *data;
+            STGMEDIUM medium;
+
+            if (SUCCEEDED(SHParseDisplayName(p, NULL, &pidl, 0, NULL)))
+            {
+                if (SUCCEEDED(SHBindToParent(pidl, &IID_IShellFolder, (void **)&parent, &child)))
+                {
+                    if (SUCCEEDED(IShellFolder_GetUIObjectOf(parent, NULL, 1, &child, &IID_IDataObject, NULL,
+                                                             (void **)&data)))
+                    {
+                        if (SUCCEEDED(IDataObject_GetData(data, &fmt, &medium)))
+                        {
+                            UINT count = DragQueryFileW(medium.hGlobal, ~0u, NULL, 0), i, size = 0;
+                            for (i = 0; i < count; i++) size += DragQueryFileW(medium.hGlobal, i, NULL, 0) + 1;
+                            if ((files = calloc(size + 1, sizeof(WCHAR))))
+                            {
+                                WCHAR *q = files;
+                                for (i = 0; i < count; i++)
+                                    q += DragQueryFileW(medium.hGlobal, i, q, size + 1 - (q - files)) + 1;
+                            }
+                            ReleaseStgMedium(&medium);
+                        }
+                        IDataObject_Release(data);
+                    }
+                    IShellFolder_Release(parent);
+                }
+                ILFree(pidl);
+            }
+        }
+        if (!files)
+        {
+            if (!(files = calloc(wcslen(p) + 2, sizeof(WCHAR)))) continue;
+            wcscpy(files, p);
+        }
+        for (n = 0; files[n]; n += wcslen(files + n) + 1) ;
+        if (n)
+        {
+            WCHAR *grown = realloc(list, (len + n + 1) * sizeof(WCHAR));
+            if (grown)
+            {
+                list = grown;
+                memcpy(list + len, files, n * sizeof(WCHAR));
+                len += n;
+                list[len] = 0;
+            }
+        }
+        free(files);
+    }
+    free(sources);
+    return list;
+}
