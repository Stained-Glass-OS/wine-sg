+/* ------------------------------------------------------------------------ */
+/* the folder                                                               */
+
+typedef struct
+{
+    IShellFolder2 IShellFolder2_iface;
+    IPersistFolder3 IPersistFolder3_iface;
+    LONG ref;
+    LPITEMIDLIST pidl;      /* absolute */
+    WCHAR zip[MAX_PATH * 4];
+    WCHAR prefix[MAX_PATH * 4];   /* the folder inside the archive, or empty */
+} ZipFolder;
+
+static const IShellFolder2Vtbl zipfolder_vtbl;
+static const IPersistFolder3Vtbl zipfolder_persist_vtbl;
+
+static inline ZipFolder *impl_from_IShellFolder2( IShellFolder2 *iface )
+{
+    return CONTAINING_RECORD( iface, ZipFolder, IShellFolder2_iface );
+}
+
+static inline ZipFolder *impl_from_IPersistFolder3( IPersistFolder3 *iface )
+{
+    return CONTAINING_RECORD( iface, ZipFolder, IPersistFolder3_iface );
+}
+
+static HRESULT create_zipfolder( const WCHAR *zip, const WCHAR *prefix, LPCITEMIDLIST pidl, REFIID riid, void **ppv )
+{
+    ZipFolder *This;
+    HRESULT hr;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->IShellFolder2_iface.lpVtbl = &zipfolder_vtbl;
+    This->IPersistFolder3_iface.lpVtbl = &zipfolder_persist_vtbl;
+    This->ref = 1;
+    if (zip) lstrcpynW( This->zip, zip, ARRAY_SIZE(This->zip) );
+    if (prefix) lstrcpynW( This->prefix, prefix, ARRAY_SIZE(This->prefix) );
+    This->pidl = pidl ? ILClone( pidl ) : NULL;
+    hr = IShellFolder2_QueryInterface( &This->IShellFolder2_iface, riid, ppv );
+    IShellFolder2_Release( &This->IShellFolder2_iface );
+    return hr;
+}
+
+HRESULT WINAPI CompressedFolder_Constructor( IUnknown *outer, REFIID riid, void **ppv )
+{
+    TRACE( "(%p %s %p)\n", outer, debugstr_guid(riid), ppv );
+    if (outer) return CLASS_E_NOAGGREGATION;
+    return create_zipfolder( NULL, NULL, NULL, riid, ppv );
+}
+
+/* the archive's entry names as children of this folder: each child once,
+ * folders implied by deeper names too */
+struct child
+{
+    WCHAR *name;
+    BOOL is_dir;
+    const struct zip_entry *entry;
+};
+
+static unsigned int list_children( const ZipFolder *This, const struct zip_archive *ar, struct child **out )
+{
+    struct child *children = NULL, *grown;
+    unsigned int count = 0, i, j;
+
+    for (i = 0; i < ar->count; i++)
+    {
+        const struct zip_entry *e = &ar->entries[i];
+        const WCHAR *rest;
+        WCHAR *slash, part[MAX_PATH * 4];
+        BOOL is_dir;
+
+        if (!e->name || !(rest = under_prefix( e->name, This->prefix ))) continue;
+        lstrcpynW( part, rest, ARRAY_SIZE(part) );
+        if ((slash = wcschr( part, '\\' ))) *slash = 0;
+        is_dir = slash || e->is_dir;
+        for (j = 0; j < count; j++) if (!wcsicmp( children[j].name, part )) break;
+        if (j < count)
+        {
+            if (!slash && !children[j].entry) children[j].entry = e;
+            continue;
+        }
+        if (!(grown = realloc( children, (count + 1) * sizeof(*children) ))) break;
+        children = grown;
+        children[count].name = wcsdup( part );
+        children[count].is_dir = is_dir;
+        children[count].entry = slash ? NULL : e;
+        count++;
+    }
+    *out = children;
+    return count;
+}
+
+static void free_children( struct child *children, unsigned int count )
+{
+    while (count--) free( children[count].name );
+    free( children );
+}
+
+/* the entry name of a child */
+static void child_inner( const ZipFolder *This, const struct zip_pidl *z, WCHAR *buf, size_t len )
+{
+    swprintf( buf, len, This->prefix[0] ? L"%s\\%s" : L"%s%s", This->prefix, z->name );
+}
+
+static HRESULT WINAPI ZipFolder_QueryInterface( IShellFolder2 *iface, REFIID riid, void **ppv )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IShellFolder ) ||
+        IsEqualIID( riid, &IID_IShellFolder2 ))
+        *ppv = &This->IShellFolder2_iface;
+    else if (IsEqualIID( riid, &IID_IPersist ) || IsEqualIID( riid, &IID_IPersistFolder ) ||
+             IsEqualIID( riid, &IID_IPersistFolder2 ) || IsEqualIID( riid, &IID_IPersistFolder3 ))
+        *ppv = &This->IPersistFolder3_iface;
+    else
+    {
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*ppv );
+    return S_OK;
+}
+
+static ULONG WINAPI ZipFolder_AddRef( IShellFolder2 *iface )
+{
+    return InterlockedIncrement( &impl_from_IShellFolder2( iface )->ref );
+}
+
+static ULONG WINAPI ZipFolder_Release( IShellFolder2 *iface )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    LONG ref = InterlockedDecrement( &This->ref );
+    if (!ref)
+    {
+        ILFree( This->pidl );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI ZipFolder_ParseDisplayName( IShellFolder2 *iface, HWND hwnd, IBindCtx *bc, LPOLESTR name,
+                                                  ULONG *eaten, LPITEMIDLIST *pidl, ULONG *attrs )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    struct zip_archive ar;
+    struct child *children;
+    unsigned int count, i;
+    WCHAR part[MAX_PATH * 4];
+    const WCHAR *next;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s)\n", This, debugstr_w(name) );
+
+    if (!name || !pidl) return E_INVALIDARG;
+    *pidl = NULL;
+    while (*name == '\\') name++;
+    if (!*name) return E_INVALIDARG;
+    next = wcschr( name, '\\' );
+    lstrcpynW( part, name, next ? min( next - name + 1, ARRAY_SIZE(part) ) : ARRAY_SIZE(part) );
+    while (next && *next == '\\') next++;
+
+    if (FAILED(hr = read_archive( This->zip, &ar ))) return hr;
+    count = list_children( This, &ar, &children );
+    for (i = 0; i < count; i++) if (!wcsicmp( children[i].name, part )) break;
+    if (i == count) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else if (!(*pidl = make_pidl( children[i].name, children[i].is_dir, children[i].entry ))) hr = E_OUTOFMEMORY;
+    free_children( children, count );
+    free_archive( &ar );
+    if (FAILED(hr)) return hr;
+
+    if (next && *next)
+    {
+        IShellFolder *sub;
+        LPITEMIDLIST rest = NULL, full;
+        if (SUCCEEDED(hr = IShellFolder2_BindToObject( iface, *pidl, bc, &IID_IShellFolder, (void **)&sub )))
+        {
+            hr = IShellFolder_ParseDisplayName( sub, hwnd, bc, (WCHAR *)next, NULL, &rest, attrs );
+            IShellFolder_Release( sub );
+        }
+        if (SUCCEEDED(hr))
+        {
+            full = ILCombine( *pidl, rest );
+            ILFree( *pidl );
+            *pidl = full;
+        }
+        else
+        {
+            ILFree( *pidl );
+            *pidl = NULL;
+        }
+        ILFree( rest );
+        return hr;
+    }
+    if (eaten) *eaten = wcslen( name );
+    if (attrs && *attrs) IShellFolder2_GetAttributesOf( iface, 1, (LPCITEMIDLIST *)pidl, attrs );
+    return S_OK;
+}
+
+static HRESULT WINAPI ZipFolder_EnumObjects( IShellFolder2 *iface, HWND hwnd, SHCONTF flags, IEnumIDList **ret )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    IEnumIDListImpl *list;
+    struct zip_archive ar;
+    struct child *children;
+    unsigned int count, i;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%#lx)\n", This, flags );
+
+    if (!ret) return E_POINTER;
+    *ret = NULL;
+    if (FAILED(hr = read_archive( This->zip, &ar ))) return hr;
+    if (!(list = IEnumIDList_Constructor()))
+    {
+        free_archive( &ar );
+        return E_OUTOFMEMORY;
+    }
+    count = list_children( This, &ar, &children );
+    for (i = 0; i < count; i++)
+    {
+        if (children[i].is_dir ? !(flags & SHCONTF_FOLDERS) : !(flags & SHCONTF_NONFOLDERS)) continue;
+        AddToEnumList( list, make_pidl( children[i].name, children[i].is_dir, children[i].entry ) );
+    }
+    free_children( children, count );
+    free_archive( &ar );
+    *ret = &list->IEnumIDList_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI ZipFolder_BindToObject( IShellFolder2 *iface, LPCITEMIDLIST pidl, IBindCtx *bc,
+                                              REFIID riid, void **ppv )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    const struct zip_pidl *z = zip_pidl( pidl );
+    WCHAR inner[MAX_PATH * 4];
+    LPITEMIDLIST first, abs;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p %s)\n", This, pidl, debugstr_guid(riid) );
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!z) return E_INVALIDARG;
+    child_inner( This, z, inner, ARRAY_SIZE(inner) );
+
+    if (!z->is_dir)
+    {
+        IStream *stream;
+        if (!IsEqualIID( riid, &IID_IStream ) || !_ILIsPidlSimple( pidl )) return E_NOINTERFACE;
+        hr = IShellFolder2_BindToStorage( iface, pidl, bc, riid, (void **)&stream );
+        if (SUCCEEDED(hr)) *ppv = stream;
+        return hr;
+    }
+
+    first = ILCloneFirst( pidl );
+    abs = This->pidl ? ILCombine( This->pidl, first ) : NULL;
+    ILFree( first );
+    if (_ILIsPidlSimple( pidl ))
+        hr = create_zipfolder( This->zip, inner, abs, riid, ppv );
+    else
+    {
+        IShellFolder *sub;
+        hr = create_zipfolder( This->zip, inner, abs, &IID_IShellFolder, (void **)&sub );
+        if (SUCCEEDED(hr))
+        {
+            hr = IShellFolder_BindToObject( sub, ILGetNext( pidl ), bc, riid, ppv );
+            IShellFolder_Release( sub );
+        }
+    }
+    ILFree( abs );
+    return hr;
+}
+
+static HRESULT WINAPI ZipFolder_BindToStorage( IShellFolder2 *iface, LPCITEMIDLIST pidl, IBindCtx *bc,
+                                               REFIID riid, void **ppv )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    const struct zip_pidl *z = zip_pidl( pidl );
+    WCHAR inner[MAX_PATH * 4];
+    struct zip_archive ar;
+    IStream *stream = NULL;
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p %s)\n", This, pidl, debugstr_guid(riid) );
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (!z || z->is_dir || !_ILIsPidlSimple( pidl )) return E_INVALIDARG;
+    if (!IsEqualIID( riid, &IID_IStream ) && !IsEqualIID( riid, &IID_ISequentialStream )) return E_NOINTERFACE;
+    child_inner( This, z, inner, ARRAY_SIZE(inner) );
+    if (FAILED(hr = read_archive( This->zip, &ar ))) return hr;
+    for (i = 0; i < ar.count; i++)
+        if (ar.entries[i].name && !ar.entries[i].is_dir && !wcsicmp( ar.entries[i].name, inner )) break;
+    if (i == ar.count) hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    else if (!(stream = SHCreateMemStream( NULL, 0 ))) hr = E_OUTOFMEMORY;
+    else if (SUCCEEDED(hr = read_entry( This->zip, &ar.entries[i], stream_sink, stream )))
+    {
+        LARGE_INTEGER zero = {{0}};
+        IStream_Seek( stream, zero, STREAM_SEEK_SET, NULL );
+        hr = IStream_QueryInterface( stream, riid, ppv );
+    }
+    if (stream) IStream_Release( stream );
+    free_archive( &ar );
+    return hr;
+}
+
+static HRESULT WINAPI ZipFolder_CompareIDs( IShellFolder2 *iface, LPARAM lparam, LPCITEMIDLIST pidl1, LPCITEMIDLIST pidl2 )
+{
+    const struct zip_pidl *a = zip_pidl( pidl1 ), *b = zip_pidl( pidl2 );
+    int ret;
+
+    if (!a || !b) return E_INVALIDARG;
+    if (a->is_dir != b->is_dir) ret = a->is_dir ? -1 : 1;
+    else switch (LOWORD(lparam))
+    {
+    case 2: ret = a->csize < b->csize ? -1 : a->csize > b->csize; break;
+    case 4: ret = a->usize < b->usize ? -1 : a->usize > b->usize; break;
+    case 6: ret = CompareFileTime( &a->mtime, &b->mtime ); break;
+    default: ret = 0;
+    }
+    if (!ret) ret = lstrcmpiW( a->name, b->name );
+    if (!ret && (!_ILIsPidlSimple( pidl1 ) || !_ILIsPidlSimple( pidl2 )))
+    {
+        IShellFolder *sub;
+        HRESULT hr;
+        if (_ILIsPidlSimple( pidl1 )) return MAKE_HRESULT( SEVERITY_SUCCESS, 0, (USHORT)-1 );
+        if (_ILIsPidlSimple( pidl2 )) return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 1 );
+        if (FAILED(hr = IShellFolder2_BindToObject( iface, pidl1, NULL, &IID_IShellFolder, (void **)&sub ))) return hr;
+        hr = IShellFolder_CompareIDs( sub, lparam, ILGetNext( pidl1 ), ILGetNext( pidl2 ) );
+        IShellFolder_Release( sub );
+        return hr;
+    }
+    return MAKE_HRESULT( SEVERITY_SUCCESS, 0, (USHORT)(ret < 0 ? -1 : ret > 0 ? 1 : 0) );
+}
+
+/* the drop target of a folder in the archive: dropped files are added */
+struct zip_drop
+{
+    IDropTarget IDropTarget_iface;
+    LONG ref;
+    WCHAR zip[MAX_PATH * 4];
+    WCHAR prefix[MAX_PATH * 4];
+    BOOL accept;
+};
+
+static inline struct zip_drop *impl_from_IDropTarget( IDropTarget *iface )
+{
+    return CONTAINING_RECORD( iface, struct zip_drop, IDropTarget_iface );
+}
+
+static HRESULT WINAPI zipdrop_QueryInterface( IDropTarget *iface, REFIID riid, void **ppv )
+{
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IDropTarget ))
+    {
+        *ppv = iface;
+        IDropTarget_AddRef( iface );
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI zipdrop_AddRef( IDropTarget *iface )
+{
+    return InterlockedIncrement( &impl_from_IDropTarget( iface )->ref );
+}
+
+static ULONG WINAPI zipdrop_Release( IDropTarget *iface )
+{
+    struct zip_drop *This = impl_from_IDropTarget( iface );
+    LONG ref = InterlockedDecrement( &This->ref );
+    if (!ref) free( This );
+    return ref;
+}
+
+static HRESULT WINAPI zipdrop_DragEnter( IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect )
+{
+    struct zip_drop *This = impl_from_IDropTarget( iface );
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+
+    This->accept = data && IDataObject_QueryGetData( data, &fmt ) == S_OK;
+    *effect = This->accept ? DROPEFFECT_COPY : DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI zipdrop_DragOver( IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect )
+{
+    *effect = impl_from_IDropTarget( iface )->accept ? DROPEFFECT_COPY : DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI zipdrop_DragLeave( IDropTarget *iface )
+{
+    impl_from_IDropTarget( iface )->accept = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI zipdrop_Drop( IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect )
+{
+    struct zip_drop *This = impl_from_IDropTarget( iface );
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    WCHAR *list = NULL;
+    size_t len = 0;
+    STGMEDIUM medium;
+    UINT count, i;
+    HRESULT hr;
+
+    *effect = DROPEFFECT_NONE;
+    if (!data || FAILED(hr = IDataObject_GetData( data, &fmt, &medium ))) return S_OK;
+    count = DragQueryFileW( medium.hGlobal, ~0u, NULL, 0 );
+    for (i = 0; i < count; i++)
+    {
+        UINT n = DragQueryFileW( medium.hGlobal, i, NULL, 0 );
+        WCHAR *grown = realloc( list, (len + n + 2) * sizeof(WCHAR) );
+        if (!grown) break;
+        list = grown;
+        DragQueryFileW( medium.hGlobal, i, list + len, n + 1 );
+        len += n + 1;
+        list[len] = 0;
+    }
+    ReleaseStgMedium( &medium );
+    if (!list) return S_OK;
+    TRACE( "adding %u files to %s\\%s\n", count, debugstr_w(This->zip), debugstr_w(This->prefix) );
+#ifdef SG_MUTANT_NO_ZIP_ADD
+    hr = E_FAIL;
+#else
+    hr = rewrite_archive( This->zip, This->prefix, list, NULL, NULL, NULL );
+#endif
+    free( list );
+    if (SUCCEEDED(hr)) *effect = DROPEFFECT_COPY;
+    return hr;
+}
+
+static const IDropTargetVtbl zipdrop_vtbl =
+{
+    zipdrop_QueryInterface,
+    zipdrop_AddRef,
+    zipdrop_Release,
+    zipdrop_DragEnter,
+    zipdrop_DragOver,
+    zipdrop_DragLeave,
+    zipdrop_Drop
+};
+
+static HRESULT create_drop_target( const WCHAR *zip, const WCHAR *prefix, void **ppv )
+{
+    struct zip_drop *drop;
+    if (!(drop = calloc( 1, sizeof(*drop) ))) return E_OUTOFMEMORY;
+    drop->IDropTarget_iface.lpVtbl = &zipdrop_vtbl;
+    drop->ref = 1;
+    lstrcpynW( drop->zip, zip, ARRAY_SIZE(drop->zip) );
+    lstrcpynW( drop->prefix, prefix, ARRAY_SIZE(drop->prefix) );
+    *ppv = &drop->IDropTarget_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI ZipFolder_CreateViewObject( IShellFolder2 *iface, HWND hwnd, REFIID riid, void **ppv )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+
+    TRACE( "(%p)->(%s)\n", This, debugstr_guid(riid) );
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    if (IsEqualIID( riid, &IID_IDropTarget )) return create_drop_target( This->zip, This->prefix, ppv );
+    if (IsEqualIID( riid, &IID_IShellView ))
+    {
+        SFV_CREATE sfv = { sizeof(sfv), (IShellFolder *)iface };
+        return SHCreateShellFolderView( &sfv, (IShellView **)ppv );
+    }
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI ZipFolder_GetAttributesOf( IShellFolder2 *iface, UINT count, LPCITEMIDLIST *pidls, SFGAOF *attrs )
+{
+    SFGAOF all = ~0u;
+    UINT i;
+
+    if (!attrs) return E_POINTER;
+    if (!count)
+    {
+        *attrs &= SFGAO_FOLDER | SFGAO_BROWSABLE | SFGAO_HASSUBFOLDER | SFGAO_DROPTARGET | SFGAO_STORAGE;
+        return S_OK;
+    }
+    for (i = 0; i < count; i++)
+    {
+        const struct zip_pidl *z = zip_pidl( pidls[i] );
+        if (!z) return E_INVALIDARG;
+        if (z->is_dir)
+            all &= SFGAO_FOLDER | SFGAO_BROWSABLE | SFGAO_HASSUBFOLDER | SFGAO_CANCOPY | SFGAO_CANDELETE |
+                   SFGAO_CANRENAME | SFGAO_DROPTARGET | SFGAO_STORAGE;
+        else
+            all &= SFGAO_STREAM | SFGAO_CANCOPY | SFGAO_CANDELETE | SFGAO_CANRENAME |
+                   (z->encrypted ? SFGAO_ENCRYPTED : 0);
+    }
+    *attrs &= all;
+    return S_OK;
+}
+
+static HRESULT extract_children_to_temp( ZipFolder *This, UINT count, LPCITEMIDLIST *pidls, WCHAR **list_out, size_t *len_out )
+{
+    WCHAR temp[MAX_PATH], dir[MAX_PATH * 4], inner[MAX_PATH * 4];
+    const WCHAR *zipname = wcsrchr( This->zip, '\\' ) ? wcsrchr( This->zip, '\\' ) + 1 : This->zip;
+    struct zip_archive ar;
+    WCHAR *list = NULL;
+    size_t len = 0;
+    unsigned int n;
+    HRESULT hr;
+    UINT i;
+
+    if (FAILED(hr = read_archive( This->zip, &ar ))) return hr;
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    /* a folder of its own each time, as Windows' "Temp1_<name>" */
+    for (n = 1; n < 1000; n++)
+    {
+        swprintf( dir, ARRAY_SIZE(dir), L"%sTemp%u_%s", temp, n, zipname );
+        if (CreateDirectoryW( dir, NULL )) break;
+    }
+    if (This->prefix[0])
+    {
+        lstrcatW( dir, L"\\" );
+        lstrcatW( dir, This->prefix );
+        create_directories( dir );
+    }
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        const struct zip_pidl *z = zip_pidl( pidls[i] );
+        WCHAR target[MAX_PATH * 4], *grown;
+        size_t tl;
+
+        if (!z) { hr = E_INVALIDARG; break; }
+        child_inner( This, z, inner, ARRAY_SIZE(inner) );
+        hr = extract_tree( This->zip, &ar, inner, dir );
+        swprintf( target, ARRAY_SIZE(target), L"%s\\%s", dir, z->name );
+        tl = wcslen( target );
+        if (!(grown = realloc( list, (len + tl + 2) * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; break; }
+        list = grown;
+        memcpy( list + len, target, (tl + 1) * sizeof(WCHAR) );
+        len += tl + 1;
+        list[len] = 0;
+    }
+    free_archive( &ar );
+    if (FAILED(hr) || !list)
+    {
+        free( list );
+        return FAILED(hr) ? hr : E_INVALIDARG;
+    }
+    *list_out = list;
+    *len_out = len;
+    return S_OK;
+}
