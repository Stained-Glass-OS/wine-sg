+#include <stdlib.h>
+#include <string.h>
+
+#include "zlib.h"
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "objbase.h"
+#include "ole2.h"
+#include "shlobj.h"
+#include "shobjidl.h"
+#include "shlwapi.h"
+#include "propkey.h"
+
+#include "shell32_main.h"
+#include "pidl.h"
+#include "shresdef.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+const CLSID CLSID_CompressedFolder = { 0xe88dcce0, 0xb7b3, 0x11d1, { 0xa9, 0xf0, 0x00, 0xaa, 0x00, 0x60, 0xfa, 0x31 } };
+
+/* ------------------------------------------------------------------------ */
+/* the archive                                                              */
+
+struct zip_entry
+{
+    WCHAR *name;            /* '\' separated, no leading or trailing one */
+    char *raw_name;         /* as stored */
+    WORD raw_len;
+    WORD made_by, needed, flags, method, time, date;
+    DWORD crc, external;
+    ULONGLONG csize, usize, offset;
+    BOOL is_dir;
+};
+
+struct zip_archive
+{
+    struct zip_entry *entries;
+    unsigned int count;
+};
+
+static void free_archive( struct zip_archive *ar )
+{
+    unsigned int i;
+    for (i = 0; i < ar->count; i++)
+    {
+        free( ar->entries[i].name );
+        free( ar->entries[i].raw_name );
+    }
+    free( ar->entries );
+    ar->entries = NULL;
+    ar->count = 0;
+}
+
+static inline WORD get16( const BYTE *p ) { return p[0] | (p[1] << 8); }
+static inline DWORD get32( const BYTE *p ) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((DWORD)p[3] << 24); }
+static inline ULONGLONG get64( const BYTE *p ) { return get32( p ) | ((ULONGLONG)get32( p + 4 ) << 32); }
+static inline void put16( BYTE *p, WORD v ) { p[0] = v; p[1] = v >> 8; }
+static inline void put32( BYTE *p, DWORD v ) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+static inline void put64( BYTE *p, ULONGLONG v ) { put32( p, (DWORD)v ); put32( p + 4, (DWORD)(v >> 32) ); }
+
+static BOOL read_at( HANDLE file, ULONGLONG offset, void *buf, DWORD size )
+{
+    LARGE_INTEGER pos;
+    DWORD got;
+    pos.QuadPart = offset;
+    return SetFilePointerEx( file, pos, NULL, FILE_BEGIN ) && ReadFile( file, buf, size, &got, NULL ) && got == size;
+}
+
+/* a stored name as the shell shows it, or NULL when it may not be extracted:
+ * absolute, with a drive or a stream, or climbing out with ".." */
+static WCHAR *decode_name( const char *raw, int len, WORD flags, const BYTE *extra, int extra_len )
+{
+    WCHAR *name, *p, *s, *d;
+    int n, i;
+
+    /* Info-ZIP's Unicode path extra field, when the name is not marked UTF-8 */
+    for (i = 0; !(flags & 0x800) && i + 4 <= extra_len; i += 4 + get16( extra + i + 2 ))
+    {
+        if (get16( extra + i ) == 0x7075 && get16( extra + i + 2 ) > 5 && i + 4 + get16( extra + i + 2 ) <= extra_len)
+        {
+            raw = (const char *)extra + i + 9;
+            len = get16( extra + i + 2 ) - 5;
+            flags |= 0x800;
+            break;
+        }
+    }
+    n = MultiByteToWideChar( (flags & 0x800) ? CP_UTF8 : 437, 0, raw, len, NULL, 0 );
+    if (!(name = calloc( n + 1, sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( (flags & 0x800) ? CP_UTF8 : 437, 0, raw, len, name, n );
+    for (p = name; *p; p++) if (*p == '/') *p = '\\';
+    /* no leading separators, no doubled ones, no trailing one */
+    for (s = d = name; *s; s++)
+    {
+        if (*s == '\\' && (d == name || d[-1] == '\\')) continue;
+        *d++ = *s;
+    }
+    while (d > name && d[-1] == '\\') d--;
+    *d = 0;
+    if (!name[0] || wcschr( name, ':' ))
+    {
+        free( name );
+        return NULL;
+    }
+    for (p = name; p; p = wcschr( p, '\\' ) ? wcschr( p, '\\' ) + 1 : NULL)
+    {
+        if (p[0] == '.' && p[1] == '.' && (!p[2] || p[2] == '\\'))
+        {
+            free( name );
+            return NULL;
+        }
+    }
+    return name;
+}
+
+static HRESULT read_archive( const WCHAR *path, struct zip_archive *ar )
+{
+    BYTE tail[65557 + 20], *p, *cd = NULL;
+    ULONGLONG size, cd_offset, cd_size, count, i;
+    LARGE_INTEGER li;
+    DWORD tail_len;
+    HANDLE file;
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+    int pos;
+
+    ar->entries = NULL;
+    ar->count = 0;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (!GetFileSizeEx( file, &li )) goto done;
+    size = li.QuadPart;
+    tail_len = (DWORD)min( size, (ULONGLONG)sizeof(tail) );
+    if (tail_len < 22 || !read_at( file, size - tail_len, tail, tail_len )) goto done;
+
+    /* the end of central directory record, the last one */
+    for (pos = tail_len - 22; pos >= 0; pos--)
+        if (get32( tail + pos ) == 0x06054b50) break;
+    if (pos < 0) goto done;
+    p = tail + pos;
+    count = get16( p + 10 );
+    cd_size = get32( p + 12 );
+    cd_offset = get32( p + 16 );
+    if (pos >= 20 && get32( p - 20 ) == 0x07064b50)  /* ZIP64 locator */
+    {
+        BYTE z64[56];
+        if (read_at( file, get64( p - 20 + 8 ), z64, sizeof(z64) ) && get32( z64 ) == 0x06064b50)
+        {
+            count = get64( z64 + 32 );
+            cd_size = get64( z64 + 40 );
+            cd_offset = get64( z64 + 48 );
+        }
+    }
+    if (cd_offset + cd_size > size || cd_size > 512 * 1024 * 1024 || count > cd_size / 46) goto done;
+    if (!count)
+    {
+        hr = S_OK;
+        goto done;
+    }
+    if (!(cd = malloc( cd_size )) || !read_at( file, cd_offset, cd, cd_size )) goto done;
+    if (!(ar->entries = calloc( count, sizeof(*ar->entries) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    for (i = 0, p = cd; i < count; i++)
+    {
+        struct zip_entry *e = &ar->entries[ar->count];
+        WORD name_len, extra_len, comment_len;
+        const BYTE *extra;
+        int k;
+
+        if (p + 46 > cd + cd_size || get32( p ) != 0x02014b50) break;
+        name_len = get16( p + 28 );
+        extra_len = get16( p + 30 );
+        comment_len = get16( p + 32 );
+        if (p + 46 + name_len + extra_len + comment_len > cd + cd_size) break;
+        e->made_by = get16( p + 4 );
+        e->needed = get16( p + 6 );
+        e->flags = get16( p + 8 );
+        e->method = get16( p + 10 );
+        e->time = get16( p + 12 );
+        e->date = get16( p + 14 );
+        e->crc = get32( p + 16 );
+        e->csize = get32( p + 20 );
+        e->usize = get32( p + 24 );
+        e->external = get32( p + 38 );
+        e->offset = get32( p + 42 );
+        extra = p + 46 + name_len;
+        for (k = 0; k + 4 <= extra_len; k += 4 + get16( extra + k + 2 ))
+        {
+            const BYTE *z = extra + k + 4;
+            int zlen = get16( extra + k + 2 );
+            if (get16( extra + k ) != 0x0001) continue;
+#ifdef SG_MUTANT_NO_ZIP64
+            continue;
+#endif
+            if (e->usize == 0xffffffff && zlen >= 8) { e->usize = get64( z ); z += 8; zlen -= 8; }
+            if (e->csize == 0xffffffff && zlen >= 8) { e->csize = get64( z ); z += 8; zlen -= 8; }
+            if (e->offset == 0xffffffff && zlen >= 8) { e->offset = get64( z ); }
+        }
+        e->raw_len = name_len;
+        e->raw_name = malloc( name_len + 1 );
+        if (e->raw_name)
+        {
+            memcpy( e->raw_name, p + 46, name_len );
+            e->raw_name[name_len] = 0;
+        }
+        e->is_dir = (name_len && (p[46 + name_len - 1] == '/' || p[46 + name_len - 1] == '\\')) ||
+                    (((e->made_by >> 8) == 0 || (e->made_by >> 8) == 10) && (e->external & FILE_ATTRIBUTE_DIRECTORY));
+        e->name = decode_name( (const char *)p + 46, name_len, e->flags, extra, extra_len );
+        if (e->raw_name) ar->count++;
+        else free( e->name );
+        p += 46 + name_len + extra_len + comment_len;
+    }
+    hr = S_OK;
+
+done:
+    free( cd );
+    CloseHandle( file );
+    if (FAILED(hr)) free_archive( ar );
+    return hr;
+}
+
+static void dos_to_filetime( WORD date, WORD time, FILETIME *ft )
+{
+    FILETIME local;
+    if (!DosDateTimeToFileTime( date, time, &local ) || !LocalFileTimeToFileTime( &local, ft ))
+        ft->dwLowDateTime = ft->dwHighDateTime = 0;
+}
+
+/* where an entry's data begins */
+static BOOL entry_data_offset( HANDLE file, const struct zip_entry *e, ULONGLONG *offset )
+{
+    BYTE local[30];
+    if (!read_at( file, e->offset, local, sizeof(local) ) || get32( local ) != 0x04034b50) return FALSE;
+    *offset = e->offset + 30 + get16( local + 26 ) + get16( local + 28 );
+    return TRUE;
+}
+
+/* zlib takes its allocator from us */
+static void *zip_zalloc( void *opaque, unsigned int items, unsigned int size )
+{
+    return malloc( (size_t)items * size );
+}
+
+static void zip_zfree( void *opaque, void *ptr )
+{
+    free( ptr );
+}
+
+typedef HRESULT (*sink_func)( void *ctx, const BYTE *data, DWORD size );
+
+/* inflate (or copy) an entry into sink, checking its CRC */
+static HRESULT read_entry( const WCHAR *zip, const struct zip_entry *e, sink_func sink, void *ctx )
+{
+    BYTE in[65536], out[65536];
+    ULONGLONG offset, left;
+    z_stream zs;
+    DWORD crc = 0, got;
+    HANDLE file;
+    HRESULT hr = S_OK;
+    int zret = Z_OK;
+
+    if (e->flags & 1) return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);   /* password protected */
+    if (e->method != 0 && e->method != 8) return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
+    file = CreateFileW( zip, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (!entry_data_offset( file, e, &offset ) || !read_at( file, offset, in, 0 ))
+    {
+        CloseHandle( file );
+        return HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+    }
+
+    memset( &zs, 0, sizeof(zs) );
+    zs.zalloc = zip_zalloc;
+    zs.zfree = zip_zfree;
+    if (e->method == 8 && inflateInit2( &zs, -MAX_WBITS ) != Z_OK)
+    {
+        CloseHandle( file );
+        return E_OUTOFMEMORY;
+    }
+    left = e->csize;
+    while (SUCCEEDED(hr) && (left || (e->method == 8 && zret != Z_STREAM_END && zs.avail_in)))
+    {
+        DWORD chunk = (DWORD)min( left, (ULONGLONG)sizeof(in) );
+        if (chunk)
+        {
+            if (!ReadFile( file, in, chunk, &got, NULL ) || got != chunk)
+            {
+                hr = HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+                break;
+            }
+            left -= chunk;
+        }
+        if (e->method == 0)
+        {
+            crc = crc32( crc, in, chunk );
+            hr = sink( ctx, in, chunk );
+            continue;
+        }
+        zs.next_in = in;
+        zs.avail_in = chunk;
+        do
+        {
+            zs.next_out = out;
+            zs.avail_out = sizeof(out);
+            zret = inflate( &zs, Z_NO_FLUSH );
+            if (zret != Z_OK && zret != Z_STREAM_END && zret != Z_BUF_ERROR)
+            {
+                WARN( "%s: inflate %d\n", debugstr_w(e->name), zret );
+                hr = HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+                break;
+            }
+            if (sizeof(out) - zs.avail_out)
+            {
+                crc = crc32( crc, out, sizeof(out) - zs.avail_out );
+                hr = sink( ctx, out, sizeof(out) - zs.avail_out );
+            }
+        } while (SUCCEEDED(hr) && zret != Z_STREAM_END && (zs.avail_in || !zs.avail_out));
+        if (zret == Z_STREAM_END) break;
+    }
+    if (e->method == 8) inflateEnd( &zs );
+    CloseHandle( file );
+    if (SUCCEEDED(hr) && crc != e->crc)
+    {
+        WARN( "%s: CRC %08lx, expected %08lx\n", debugstr_w(e->name), crc, e->crc );
+        hr = HRESULT_FROM_WIN32(ERROR_CRC);
+    }
+    return hr;
+}
+
+static HRESULT file_sink( void *ctx, const BYTE *data, DWORD size )
+{
+    DWORD written;
+    if (!size) return S_OK;
+    return WriteFile( ctx, data, size, &written, NULL ) && written == size ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+}
+
+static HRESULT stream_sink( void *ctx, const BYTE *data, DWORD size )
+{
+    ULONG written;
+    if (!size) return S_OK;
+    return IStream_Write( (IStream *)ctx, data, size, &written );
+}
+
+/* an entry to a file, with its date */
+static HRESULT extract_entry_to_file( const WCHAR *zip, const struct zip_entry *e, const WCHAR *dest )
+{
+    FILETIME ft;
+    HANDLE file;
+    HRESULT hr;
+
+    file = CreateFileW( dest, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    hr = read_entry( zip, e, file_sink, file );
+    dos_to_filetime( e->date, e->time, &ft );
+    SetFileTime( file, NULL, NULL, &ft );
+    CloseHandle( file );
+    if (FAILED(hr)) DeleteFileW( dest );
+    else if (e->external & FILE_ATTRIBUTE_READONLY && ((e->made_by >> 8) == 0 || (e->made_by >> 8) == 10))
+        SetFileAttributesW( dest, FILE_ATTRIBUTE_READONLY );
+    return hr;
+}
+
+static BOOL create_directories( const WCHAR *path )
+{
+    WCHAR buf[MAX_PATH * 4], *p;
+    lstrcpynW( buf, path, ARRAY_SIZE(buf) );
+    for (p = buf + 3; (p = wcschr( p, '\\' )); p++)
+    {
+        *p = 0;
+        CreateDirectoryW( buf, NULL );
+        *p = '\\';
+    }
+    return CreateDirectoryW( buf, NULL ) || GetLastError() == ERROR_ALREADY_EXISTS;
+}
+
+/* "prefix\name" is inside prefix (or prefix is empty) */
+static const WCHAR *under_prefix( const WCHAR *name, const WCHAR *prefix )
+{
+    int len = wcslen( prefix );
+    if (!len) return name;
+    if (wcsnicmp( name, prefix, len ) || name[len] != '\\') return NULL;
+    return name + len + 1;
+}
+
+/* extract the entry (or the folder) "inner" into the directory dest */
+static HRESULT extract_tree( const WCHAR *zip, const struct zip_archive *ar, const WCHAR *inner, const WCHAR *dest )
+{
+    const WCHAR *base = wcsrchr( inner, '\\' ) ? wcsrchr( inner, '\\' ) + 1 : inner;
+    WCHAR target[MAX_PATH * 4];
+    HRESULT hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    unsigned int i;
+
+    for (i = 0; i < ar->count; i++)
+    {
+        const struct zip_entry *e = &ar->entries[i];
+        const WCHAR *rest;
+        HRESULT r;
+
+        if (!e->name) continue;
+        if (!wcsicmp( e->name, inner )) rest = L"";
+        else if (!(rest = under_prefix( e->name, inner ))) continue;
+        swprintf( target, ARRAY_SIZE(target), *rest ? L"%s\\%s\\%s" : L"%s\\%s", dest, base, rest );
+        if (e->is_dir)
+        {
+            r = create_directories( target ) ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+        }
+        else
+        {
+            WCHAR *slash;
+            WCHAR dir[MAX_PATH * 4];
+            lstrcpyW( dir, target );
+            if ((slash = wcsrchr( dir, '\\' ))) *slash = 0;
+            create_directories( dir );
+            r = extract_entry_to_file( zip, e, target );
+        }
+        if (FAILED(r)) WARN( "%s: %#lx\n", debugstr_w(target), r );
+        if (hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND) || FAILED(r)) hr = r;
+    }
+    /* a folder only implied by its files' names */
+    if (hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND))
+    {
+        for (i = 0; i < ar->count; i++)
+            if (ar->entries[i].name && under_prefix( ar->entries[i].name, inner )) break;
+        if (i < ar->count) hr = S_OK;
+    }
+    return hr;
+}
+
+/* ------------------------------------------------------------------------ */
+/* writing: the archive is rewritten beside itself and moved into place      */
+
+struct zip_add
+{
+    WCHAR *source;      /* a file or directory, or NULL for an explicit folder entry */
+    WCHAR *name;        /* its name in the archive, '\' separated */
+};
+
+struct central
+{
+    BYTE *data;
+    size_t len, size;
+    ULONGLONG count;
+};
+
+static BOOL central_append( struct central *c, const void *data, size_t len )
+{
+    if (c->len + len > c->size)
+    {
+        size_t size = max( c->size * 2, c->len + len + 4096 );
+        BYTE *grown = realloc( c->data, size );
+        if (!grown) return FALSE;
+        c->data = grown;
+        c->size = size;
+    }
+    memcpy( c->data + c->len, data, len );
+    c->len += len;
+    return TRUE;
+}
+
+static BOOL write_all( HANDLE file, const void *data, DWORD size )
+{
+    DWORD written;
+    return WriteFile( file, data, size, &written, NULL ) && written == size;
+}
+
+static ULONGLONG file_pos( HANDLE file )
+{
+    LARGE_INTEGER zero = {{0}}, pos;
+    SetFilePointerEx( file, zero, &pos, FILE_CURRENT );
+    return pos.QuadPart;
+}
+
+/* the central directory record of an entry written at offset */
+static BOOL add_central( struct central *c, const struct zip_entry *e, const char *name, WORD name_len, ULONGLONG offset )
+{
+    BYTE hdr[46], z64[28];
+    WORD z64_len = 0;
+
+    put32( hdr, 0x02014b50 );
+    put16( hdr + 4, e->made_by );
+    put16( hdr + 6, e->needed );
+    put16( hdr + 8, e->flags );
+    put16( hdr + 10, e->method );
+    put16( hdr + 12, e->time );
+    put16( hdr + 14, e->date );
+    put32( hdr + 16, e->crc );
+    put16( z64, 0x0001 );
+    if (e->usize >= 0xffffffff) { put64( z64 + 4 + z64_len, e->usize ); z64_len += 8; }
+    if (e->csize >= 0xffffffff) { put64( z64 + 4 + z64_len, e->csize ); z64_len += 8; }
+    if (offset >= 0xffffffff) { put64( z64 + 4 + z64_len, offset ); z64_len += 8; }
+    put16( z64 + 2, z64_len );
+    put32( hdr + 20, e->csize >= 0xffffffff ? 0xffffffff : (DWORD)e->csize );
+    put32( hdr + 24, e->usize >= 0xffffffff ? 0xffffffff : (DWORD)e->usize );
+    put16( hdr + 28, name_len );
+    put16( hdr + 30, z64_len ? z64_len + 4 : 0 );
+    put16( hdr + 32, 0 );
+    put16( hdr + 34, 0 );
+    put16( hdr + 36, 0 );
+    put32( hdr + 38, e->external );
+    put32( hdr + 42, offset >= 0xffffffff ? 0xffffffff : (DWORD)offset );
+    c->count++;
+    return central_append( c, hdr, sizeof(hdr) ) && central_append( c, name, name_len ) &&
+           (!z64_len || central_append( c, z64, z64_len + 4 ));
+}
+
+static BOOL write_local_header( HANDLE file, const struct zip_entry *e, const char *name, WORD name_len, BOOL zip64 )
+{
+    BYTE hdr[30], z64[20];
+
+    put32( hdr, 0x04034b50 );
+    put16( hdr + 4, e->needed );
+    put16( hdr + 6, e->flags );
+    put16( hdr + 8, e->method );
+    put16( hdr + 10, e->time );
+    put16( hdr + 12, e->date );
+    put32( hdr + 14, e->crc );
+    put32( hdr + 18, zip64 ? 0xffffffff : (DWORD)e->csize );
+    put32( hdr + 22, zip64 ? 0xffffffff : (DWORD)e->usize );
+    put16( hdr + 26, name_len );
+    put16( hdr + 28, zip64 ? sizeof(z64) : 0 );
+    put16( z64, 0x0001 );
+    put16( z64 + 2, 16 );
+    put64( z64 + 4, e->usize );
+    put64( z64 + 12, e->csize );
+    return write_all( file, hdr, sizeof(hdr) ) && write_all( file, name, name_len ) &&
+           (!zip64 || write_all( file, z64, sizeof(z64) ));
+}
+
+/* an existing entry, copied with its data as it is (renamed when new_name) */
+static HRESULT copy_entry( HANDLE out, HANDLE in, const struct zip_entry *e, const WCHAR *new_name, struct central *c )
+{
+    struct zip_entry copy = *e;
+    ULONGLONG data, left, offset = file_pos( out );
+    char *name = e->raw_name;
+    WORD name_len = e->raw_len;
+    BYTE buf[65536];
+    BOOL zip64 = e->usize >= 0xffffffff || e->csize >= 0xffffffff, ok;
+    DWORD got;
+
+    if (!entry_data_offset( in, e, &data )) return HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+    if (new_name)
+    {
+        int len = WideCharToMultiByte( CP_UTF8, 0, new_name, -1, NULL, 0, NULL, NULL );
+        if (!(name = malloc( len + 1 ))) return E_OUTOFMEMORY;
+        WideCharToMultiByte( CP_UTF8, 0, new_name, -1, name, len, NULL, NULL );
+        for (len = 0; name[len]; len++) if (name[len] == '\\') name[len] = '/';
+        if (e->is_dir) name[len++] = '/';
+        name_len = len;
+        copy.flags |= 0x800;
+    }
+    /* a data descriptor goes, but an encrypted entry's check needs its flag */
+    if (!(copy.flags & 1)) copy.flags &= ~8;
+    if (zip64 && copy.needed < 45) copy.needed = 45;
+    ok = write_local_header( out, &copy, name, name_len, zip64 );
+    if (ok && read_at( in, data, buf, 0 ))
+    {
+        for (left = e->csize; ok && left; left -= got)
+        {
+            DWORD chunk = (DWORD)min( left, (ULONGLONG)sizeof(buf) );
+            ok = ReadFile( in, buf, chunk, &got, NULL ) && got == chunk && write_all( out, buf, chunk );
+        }
+    }
+    else ok = FALSE;
+    if (ok && (copy.flags & 8))
+    {
+        BYTE desc[24];
+        put32( desc, 0x08074b50 );
+        put32( desc + 4, copy.crc );
+        if (zip64) { put64( desc + 8, copy.csize ); put64( desc + 16, copy.usize ); }
+        else { put32( desc + 8, (DWORD)copy.csize ); put32( desc + 12, (DWORD)copy.usize ); }
+        ok = write_all( out, desc, zip64 ? 24 : 16 );
+    }
+    if (ok) ok = add_central( c, &copy, name, name_len, offset );
+    if (name != e->raw_name) free( name );
+    return ok ? S_OK : HRESULT_FROM_WIN32(GetLastError() ? GetLastError() : ERROR_WRITE_FAULT);
+}
+
+/* a new entry from a file (or a folder entry), deflated */
+static HRESULT write_new_entry( HANDLE out, const WCHAR *source, const WCHAR *name, BOOL is_dir, struct central *c )
+{
+    struct zip_entry e = {0};
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+    ULONGLONG offset = file_pos( out ), data_start;
+    BYTE in[65536], buf[65536];
+    char *raw;
+    int len, i;
+    BOOL zip64 = FALSE, ok = TRUE, ascii = TRUE;
+    FILETIME local;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    DWORD got;
+    z_stream zs;
+
+    len = WideCharToMultiByte( CP_UTF8, 0, name, -1, NULL, 0, NULL, NULL );
+    if (!(raw = malloc( len + 1 ))) return E_OUTOFMEMORY;
+    WideCharToMultiByte( CP_UTF8, 0, name, -1, raw, len, NULL, NULL );
+    for (i = 0; raw[i]; i++)
+    {
+        if (raw[i] == '\\') raw[i] = '/';
+        if ((BYTE)raw[i] >= 0x80) ascii = FALSE;
+    }
+    if (is_dir) raw[i++] = '/';
+    len = i;
+
+    memset( &fad, 0, sizeof(fad) );
+    if (source && !GetFileAttributesExW( source, GetFileExInfoStandard, &fad ))
+    {
+        free( raw );
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    if (!source) GetSystemTimeAsFileTime( &fad.ftLastWriteTime );
+    FileTimeToLocalFileTime( &fad.ftLastWriteTime, &local );
+    FileTimeToDosDateTime( &local, &e.date, &e.time );
+    e.made_by = 20;                 /* MS-DOS attributes, version 2.0 */
+    e.needed = 20;
+    e.flags = ascii ? 0 : 0x800;
+    e.method = is_dir ? 0 : 8;
+    e.external = is_dir ? FILE_ATTRIBUTE_DIRECTORY : (fad.dwFileAttributes & (FILE_ATTRIBUTE_READONLY |
+                 FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM | FILE_ATTRIBUTE_ARCHIVE));
+    if (!is_dir && ((ULONGLONG)fad.nFileSizeHigh << 32 | fad.nFileSizeLow) >= 0xf0000000ull)
+    {
+        zip64 = TRUE;
+        e.needed = 45;
+    }
+
+    if (!is_dir)
+    {
+        file = CreateFileW( source, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+        if (file == INVALID_HANDLE_VALUE)
+        {
+            free( raw );
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+    }
+    ok = write_local_header( out, &e, raw, len, zip64 );
+    data_start = file_pos( out );
+    if (ok && !is_dir)
+    {
+        int zret = Z_OK;
+        memset( &zs, 0, sizeof(zs) );
+        zs.zalloc = zip_zalloc;
+        zs.zfree = zip_zfree;
+        if (deflateInit2( &zs, Z_DEFAULT_COMPRESSION, Z_DEFLATED, -MAX_WBITS, 8, Z_DEFAULT_STRATEGY ) != Z_OK)
+            ok = FALSE;
+        while (ok && zret != Z_STREAM_END)
+        {
+            int flush;
+            if (!ReadFile( file, in, sizeof(in), &got, NULL )) { ok = FALSE; break; }
+            e.crc = crc32( e.crc, in, got );
+            e.usize += got;
+            flush = got ? Z_NO_FLUSH : Z_FINISH;
+            zs.next_in = in;
+            zs.avail_in = got;
+            do
+            {
+                zs.next_out = buf;
+                zs.avail_out = sizeof(buf);
+                zret = deflate( &zs, flush );
+                if (zret == Z_STREAM_ERROR) { ok = FALSE; break; }
+                ok = write_all( out, buf, sizeof(buf) - zs.avail_out );
+            } while (ok && zs.avail_out == 0);
+        }
+        deflateEnd( &zs );
+        e.csize = file_pos( out ) - data_start;
+    }
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+
+    /* the sizes and CRC, now known, into the local header */
+    if (ok && !is_dir)
+    {
+        LARGE_INTEGER pos;
+        BYTE fix[12];
+        put32( fix, e.crc );
+        put32( fix + 4, zip64 ? 0xffffffff : (DWORD)e.csize );
+        put32( fix + 8, zip64 ? 0xffffffff : (DWORD)e.usize );
+        pos.QuadPart = offset + 14;
+        ok = SetFilePointerEx( out, pos, NULL, FILE_BEGIN ) && write_all( out, fix, sizeof(fix) );
+        if (ok && zip64)
+        {
+            BYTE z64[16];
+            put64( z64, e.usize );
+            put64( z64 + 8, e.csize );
+            pos.QuadPart = offset + 30 + len + 4;
+            ok = SetFilePointerEx( out, pos, NULL, FILE_BEGIN ) && write_all( out, z64, sizeof(z64) );
+        }
+        pos.QuadPart = 0;
+        if (ok) ok = SetFilePointerEx( out, pos, NULL, FILE_END );
+    }
+    if (ok) ok = add_central( c, &e, raw, len, offset );
+    free( raw );
+    return ok ? S_OK : HRESULT_FROM_WIN32(GetLastError() ? GetLastError() : ERROR_WRITE_FAULT);
+}
+
+static BOOL write_end( HANDLE out, struct central *c )
+{
+    ULONGLONG cd_offset = file_pos( out );
+    BYTE eocd[22];
+    BOOL zip64 = c->count >= 0xffff || cd_offset >= 0xffffffff || c->len >= 0xffffffff;
+
+    if (!write_all( out, c->data, c->len )) return FALSE;
+    if (zip64)
+    {
+        BYTE rec[56], loc[20];
+        ULONGLONG rec_offset = file_pos( out );
+        put32( rec, 0x06064b50 );
+        put64( rec + 4, 44 );
+        put16( rec + 12, 45 );
+        put16( rec + 14, 45 );
+        put32( rec + 16, 0 );
+        put32( rec + 20, 0 );
+        put64( rec + 24, c->count );
+        put64( rec + 32, c->count );
+        put64( rec + 40, c->len );
+        put64( rec + 48, cd_offset );
+        put32( loc, 0x07064b50 );
+        put32( loc + 4, 0 );
+        put64( loc + 8, rec_offset );
+        put32( loc + 16, 1 );
+        if (!write_all( out, rec, sizeof(rec) ) || !write_all( out, loc, sizeof(loc) )) return FALSE;
+    }
+    put32( eocd, 0x06054b50 );
+    put16( eocd + 4, 0 );
+    put16( eocd + 6, 0 );
+    put16( eocd + 8, c->count >= 0xffff ? 0xffff : (WORD)c->count );
+    put16( eocd + 10, c->count >= 0xffff ? 0xffff : (WORD)c->count );
+    put32( eocd + 12, zip64 ? 0xffffffff : (DWORD)c->len );
+    put32( eocd + 16, zip64 ? 0xffffffff : (DWORD)cd_offset );
+    put16( eocd + 20, 0 );
+    return write_all( out, eocd, sizeof(eocd) );
+}
+
+/* the names "dir\file" a source file or directory adds under prefix */
+static BOOL list_adds( const WCHAR *source, const WCHAR *name, struct zip_add **adds, unsigned int *count )
+{
+    struct zip_add *grown;
+    DWORD attrs = GetFileAttributesW( source );
+
+    if (attrs == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (!(grown = realloc( *adds, (*count + 1) * sizeof(**adds) ))) return FALSE;
+    *adds = grown;
+    grown[*count].source = wcsdup( source );
+    grown[*count].name = wcsdup( name );
+    (*count)++;
+    if (attrs & FILE_ATTRIBUTE_DIRECTORY)
+    {
+        WCHAR pattern[MAX_PATH * 4], child[MAX_PATH * 4], child_name[MAX_PATH * 4];
+        WIN32_FIND_DATAW fd;
+        HANDLE find;
+
+        swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*", source );
+        if ((find = FindFirstFileW( pattern, &fd )) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+                swprintf( child, ARRAY_SIZE(child), L"%s\\%s", source, fd.cFileName );
+                swprintf( child_name, ARRAY_SIZE(child_name), L"%s\\%s", name, fd.cFileName );
+                list_adds( child, child_name, adds, count );
+            } while (FindNextFileW( find, &fd ));
+            FindClose( find );
+        }
+    }
+    return TRUE;
+}
+
+/* rewrite the archive: drop the entries named in remove (folders with what
+ * they hold), rename (old\0new\0 pairs), add sources (double-null list) under
+ * prefix. A missing archive is created. */
+static HRESULT rewrite_archive( const WCHAR *zip, const WCHAR *prefix, const WCHAR *sources,
+                                const WCHAR *remove, const WCHAR *rename_from, const WCHAR *rename_to )
+{
+    struct zip_archive ar = {0};
+    struct zip_add *adds = NULL;
+    unsigned int add_count = 0, i, j;
+    struct central c = {0};
+    WCHAR temp[MAX_PATH * 4], name[MAX_PATH * 4];
+    const WCHAR *src, *r;
+    HANDLE in = INVALID_HANDLE_VALUE, out;
+    HRESULT hr = S_OK;
+
+    if (GetFileAttributesW( zip ) != INVALID_FILE_ATTRIBUTES && FAILED(hr = read_archive( zip, &ar ))) return hr;
+
+    for (src = sources; src && *src; src += wcslen( src ) + 1)
+    {
+        const WCHAR *base = wcsrchr( src, '\\' ) ? wcsrchr( src, '\\' ) + 1 : src;
+        WCHAR full[MAX_PATH * 4];
+        GetFullPathNameW( src, ARRAY_SIZE(full), full, NULL );
+        if (!wcsicmp( full, zip )) continue;   /* not the archive into itself */
+        swprintf( name, ARRAY_SIZE(name), *prefix ? L"%s\\%s" : L"%s%s", prefix, base );
+        if (!list_adds( full, name, &adds, &add_count ))
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+            goto done;
+        }
+    }
+
+    swprintf( temp, ARRAY_SIZE(temp), L"%s.sgzip~", zip );
+    out = CreateFileW( temp, GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (out == INVALID_HANDLE_VALUE)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        goto done;
+    }
+    if (ar.count)
+        in = CreateFileW( zip, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+
+    for (i = 0; SUCCEEDED(hr) && i < ar.count; i++)
+    {
+        const struct zip_entry *e = &ar.entries[i];
+        const WCHAR *new_name = NULL;
+
+        if (e->name)
+        {
+            BOOL drop = FALSE;
+            for (r = remove; r && *r && !drop; r += wcslen( r ) + 1)
+                drop = !wcsicmp( e->name, r ) || under_prefix( e->name, r );
+            /* replaced by an added file of the same name */
+            for (j = 0; j < add_count && !drop; j++) drop = !wcsicmp( e->name, adds[j].name ) && !e->is_dir;
+            if (drop) continue;
+            if (rename_from && *rename_from)
+            {
+                const WCHAR *rest;
+                if (!wcsicmp( e->name, rename_from )) new_name = rename_to;
+                else if ((rest = under_prefix( e->name, rename_from )))
+                {
+                    swprintf( name, ARRAY_SIZE(name), L"%s\\%s", rename_to, rest );
+                    new_name = name;
+                }
+            }
+            /* a folder entry an added folder already has */
+            for (j = 0; j < add_count && e->is_dir; j++)
+                if (!wcsicmp( e->name, adds[j].name )) break;
+            if (e->is_dir && j < add_count) continue;
+        }
+        if (in == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32(GetLastError());
+        else hr = copy_entry( out, in, e, new_name, &c );
+    }
+    for (j = 0; SUCCEEDED(hr) && j < add_count; j++)
+    {
+        BOOL is_dir = !!(GetFileAttributesW( adds[j].source ) & FILE_ATTRIBUTE_DIRECTORY);
+        hr = write_new_entry( out, adds[j].source, adds[j].name, is_dir, &c );
+    }
+    if (SUCCEEDED(hr) && !write_end( out, &c )) hr = HRESULT_FROM_WIN32(GetLastError());
+    if (in != INVALID_HANDLE_VALUE) CloseHandle( in );
+    CloseHandle( out );
+    if (SUCCEEDED(hr) && !MoveFileExW( temp, zip, MOVEFILE_REPLACE_EXISTING ))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    if (FAILED(hr)) DeleteFileW( temp );
+    else SHChangeNotify( SHCNE_UPDATEITEM, SHCNF_PATHW, zip, NULL );
+
+done:
+    for (j = 0; j < add_count; j++)
+    {
+        free( adds[j].source );
+        free( adds[j].name );
+    }
+    free( adds );
+    free( c.data );
+    free_archive( &ar );
+    return hr;
+}
+
+/* ------------------------------------------------------------------------ */
+/* item IDs                                                                 */
+
+#define ZIP_PIDL_TYPE  0xa5
+#define ZIP_PIDL_MAGIC 0x465a4753   /* "SGZF" */
+
+#include "pshpack1.h"
+struct zip_pidl
+{
+    WORD cb;
+    BYTE type;
+    BYTE is_dir;
+    DWORD magic;
+    ULONGLONG usize, csize;
+    FILETIME mtime;
+    BYTE encrypted;
+    WORD method;
+    WCHAR name[1];
+};
+#include "poppack.h"
+
+static const struct zip_pidl *zip_pidl( LPCITEMIDLIST pidl )
+{
+    const struct zip_pidl *z = (const struct zip_pidl *)pidl;
+    if (!pidl || pidl->mkid.cb < offsetof(struct zip_pidl, name) + sizeof(WCHAR) ||
+        z->type != ZIP_PIDL_TYPE || z->magic != ZIP_PIDL_MAGIC) return NULL;
+    return z;
+}
+
+static LPITEMIDLIST make_pidl( const WCHAR *name, BOOL is_dir, const struct zip_entry *e )
+{
+    size_t len = (wcslen( name ) + 1) * sizeof(WCHAR), size = offsetof(struct zip_pidl, name) + len;
+    struct zip_pidl *z = SHAlloc( size + sizeof(WORD) );
+
+    if (!z) return NULL;
+    memset( z, 0, size + sizeof(WORD) );
+    z->cb = size;
+    z->type = ZIP_PIDL_TYPE;
+    z->is_dir = is_dir;
+    z->magic = ZIP_PIDL_MAGIC;
+    memcpy( z->name, name, len );
+    if (e)
+    {
+        z->usize = e->usize;
+        z->csize = e->csize;
+        z->encrypted = e->flags & 1;
+        z->method = e->method;
+        dos_to_filetime( e->date, e->time, &z->mtime );
+    }
+    return (LPITEMIDLIST)z;
+}
