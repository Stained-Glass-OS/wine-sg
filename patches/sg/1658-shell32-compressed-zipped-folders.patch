+/* the root of an archive: the pidl of the .zip file */
+static HRESULT WINAPI ZipPersist_Initialize( IPersistFolder3 *iface, LPCITEMIDLIST pidl )
+{
+    ZipFolder *This = impl_from_IPersistFolder3( iface );
+    WCHAR path[MAX_PATH * 4];
+
+    TRACE( "(%p)->(%p)\n", This, pidl );
+
+    if (!pidl || !SHGetPathFromIDListW( pidl, path )) return E_INVALIDARG;
+    ILFree( This->pidl );
+    This->pidl = ILClone( pidl );
+    lstrcpynW( This->zip, path, ARRAY_SIZE(This->zip) );
+    This->prefix[0] = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI ZipPersist_GetCurFolder( IPersistFolder3 *iface, LPITEMIDLIST *pidl )
+{
+    ZipFolder *This = impl_from_IPersistFolder3( iface );
+    if (!pidl) return E_POINTER;
+    *pidl = This->pidl ? ILClone( This->pidl ) : NULL;
+    return *pidl ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI ZipPersist_InitializeEx( IPersistFolder3 *iface, IBindCtx *bc, LPCITEMIDLIST root,
+                                               const PERSIST_FOLDER_TARGET_INFO *info )
+{
+    ZipFolder *This = impl_from_IPersistFolder3( iface );
+    if (info && info->szTargetParsingName[0])
+    {
+        ILFree( This->pidl );
+        This->pidl = root ? ILClone( root ) : NULL;
+        lstrcpynW( This->zip, info->szTargetParsingName, ARRAY_SIZE(This->zip) );
+        This->prefix[0] = 0;
+        return S_OK;
+    }
+    return ZipPersist_Initialize( iface, root );
+}
+
+static HRESULT WINAPI ZipPersist_GetFolderTargetInfo( IPersistFolder3 *iface, PERSIST_FOLDER_TARGET_INFO *info )
+{
+    ZipFolder *This = impl_from_IPersistFolder3( iface );
+    memset( info, 0, sizeof(*info) );
+    swprintf( info->szTargetParsingName, ARRAY_SIZE(info->szTargetParsingName),
+              This->prefix[0] ? L"%s\\%s" : L"%s%s", This->zip, This->prefix );
+    info->dwAttributes = -1;
+    info->csidl = -1;
+    return S_OK;
+}
