+static const IDataObjectVtbl hdrop_vtbl =
+{
+    hdrop_QueryInterface,
+    hdrop_AddRef,
+    hdrop_Release,
+    hdrop_GetData,
+    hdrop_GetDataHere,
+    hdrop_QueryGetData,
+    hdrop_GetCanonicalFormatEtc,
+    hdrop_SetData,
+    hdrop_EnumFormatEtc,
+    hdrop_DAdvise,
+    hdrop_DUnadvise,
+    hdrop_EnumDAdvise
+};
+
+/* a data object of files (a double-null list) */
+HRESULT SHELL_CreateHDropDataObject( const WCHAR *paths, IDataObject **ret )
+{
+    struct hdrop_object *obj;
+    const WCHAR *p;
+
+    if (!(obj = calloc( 1, sizeof(*obj) ))) return E_OUTOFMEMORY;
+    for (p = paths; *p; p += wcslen( p ) + 1) ;
+    obj->len = p - paths + 1;
+    if (!(obj->paths = malloc( obj->len * sizeof(WCHAR) )))
+    {
+        free( obj );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( obj->paths, paths, obj->len * sizeof(WCHAR) );
+    obj->IDataObject_iface.lpVtbl = &hdrop_vtbl;
+    obj->ref = 1;
+    *ret = &obj->IDataObject_iface;
+    return S_OK;
+}
