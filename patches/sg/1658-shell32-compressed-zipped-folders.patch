+/* the shell folder a file of this name opens as: its type's CLSID, when that
+ * class is registered as a ShellFolder (Stained Glass OS 1658) */
+static BOOL file_junction_clsid( const WCHAR *name, CLSID *clsid )
+{
+    const WCHAR *ext = PathFindExtensionW( name );
+    WCHAR progid[256], value[CHARS_IN_GUID], key[300];
+    DWORD size;
+    HKEY hkey;
+
+    if (!ext || !*ext) return FALSE;
+    size = sizeof(progid);
+    if (RegGetValueW( HKEY_CLASSES_ROOT, ext, NULL, RRF_RT_REG_SZ, NULL, progid, &size )) return FALSE;
+    swprintf( key, ARRAY_SIZE(key), L"%.200s\\CLSID", progid );
+    size = sizeof(value);
+    if (RegGetValueW( HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, value, &size ) ||
+        FAILED(CLSIDFromString( value, clsid ))) return FALSE;
+    swprintf( key, ARRAY_SIZE(key), L"CLSID\\%s\\ShellFolder", value );
+    if (RegOpenKeyExW( HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey )) return FALSE;
+    RegCloseKey( hkey );
+    return TRUE;
+}
