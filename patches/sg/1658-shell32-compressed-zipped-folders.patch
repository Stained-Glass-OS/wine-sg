+/* a minimal shortcut menu: open (from a temporary copy), copy, delete */
+struct zip_menu
+{
+    IContextMenu IContextMenu_iface;
+    LONG ref;
+    ZipFolder *folder;
+    LPITEMIDLIST *pidls;
+    UINT count;
+};
+
+static inline struct zip_menu *impl_from_IContextMenu( IContextMenu *iface )
+{
+    return CONTAINING_RECORD( iface, struct zip_menu, IContextMenu_iface );
+}
+
+static HRESULT WINAPI zipmenu_QueryInterface( IContextMenu *iface, REFIID riid, void **ppv )
+{
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IContextMenu ))
+    {
+        *ppv = iface;
+        IContextMenu_AddRef( iface );
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI zipmenu_AddRef( IContextMenu *iface )
+{
+    return InterlockedIncrement( &impl_from_IContextMenu( iface )->ref );
+}
+
+static ULONG WINAPI zipmenu_Release( IContextMenu *iface )
+{
+    struct zip_menu *This = impl_from_IContextMenu( iface );
+    LONG ref = InterlockedDecrement( &This->ref );
+    if (!ref)
+    {
+        UINT i;
+        for (i = 0; i < This->count; i++) ILFree( This->pidls[i] );
+        free( This->pidls );
+        IShellFolder2_Release( &This->folder->IShellFolder2_iface );
+        free( This );
+    }
+    return ref;
+}
+
+static const WCHAR *zipmenu_verbs[] = { L"open", L"copy", L"delete" };
+
+static HRESULT WINAPI zipmenu_QueryContextMenu( IContextMenu *iface, HMENU menu, UINT index, UINT first, UINT last, UINT flags )
+{
+    static const WCHAR *labels[] = { L"&Open", L"&Copy", L"&Delete" };
+    UINT i;
+
+    if (flags & CMF_DEFAULTONLY)
+    {
+        InsertMenuW( menu, index, MF_BYPOSITION | MF_STRING, first, labels[0] );
+        SetMenuDefaultItem( menu, first, FALSE );
+        return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 1 );
+    }
+    for (i = 0; i < ARRAY_SIZE(labels) && first + i <= last; i++)
+        InsertMenuW( menu, index + i, MF_BYPOSITION | MF_STRING, first + i, labels[i] );
+    SetMenuDefaultItem( menu, first, FALSE );
+    return MAKE_HRESULT( SEVERITY_SUCCESS, 0, i );
+}
+
+static HRESULT WINAPI zipmenu_InvokeCommand( IContextMenu *iface, CMINVOKECOMMANDINFO *info )
+{
+    struct zip_menu *This = impl_from_IContextMenu( iface );
+    UINT id = ~0u, i;
+    HRESULT hr;
+
+    if (IS_INTRESOURCE( info->lpVerb )) id = LOWORD(info->lpVerb);
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(zipmenu_verbs); i++)
+        {
+            char verb[16];
+            WideCharToMultiByte( CP_ACP, 0, zipmenu_verbs[i], -1, verb, sizeof(verb), NULL, NULL );
+            if (!lstrcmpiA( info->lpVerb, verb )) id = i;
+        }
+    }
+    switch (id)
+    {
+    case 0:   /* open: folders are browsed; files from a temporary copy */
+    {
+        WCHAR *list;
+        size_t len;
+        if (FAILED(hr = extract_children_to_temp( This->folder, This->count, (LPCITEMIDLIST *)This->pidls, &list, &len )))
+            return hr;
+        ShellExecuteW( info->hwnd, NULL, list, NULL, NULL, info->nShow ? info->nShow : SW_SHOWNORMAL );
+        free( list );
+        return S_OK;
+    }
+    case 1:   /* copy */
+    {
+        IDataObject *data;
+        if (FAILED(hr = IShellFolder2_GetUIObjectOf( &This->folder->IShellFolder2_iface, info->hwnd, This->count,
+                                                     (LPCITEMIDLIST *)This->pidls, &IID_IDataObject, NULL, (void **)&data )))
+            return hr;
+        hr = OleSetClipboard( data );
+        IDataObject_Release( data );
+        return hr;
+    }
+    case 2:   /* delete */
+    {
+        WCHAR *list = NULL, inner[MAX_PATH * 4];
+        size_t len = 0;
+        for (i = 0; i < This->count; i++)
+        {
+            const struct zip_pidl *z = zip_pidl( This->pidls[i] );
+            size_t n;
+            WCHAR *grown;
+            if (!z) continue;
+            child_inner( This->folder, z, inner, ARRAY_SIZE(inner) );
+            n = wcslen( inner );
+            if (!(grown = realloc( list, (len + n + 2) * sizeof(WCHAR) ))) break;
+            list = grown;
+            memcpy( list + len, inner, (n + 1) * sizeof(WCHAR) );
+            len += n + 1;
+            list[len] = 0;
+        }
+        if (!list) return E_INVALIDARG;
+        hr = rewrite_archive( This->folder->zip, L"", NULL, list, NULL, NULL );
+        free( list );
+        return hr;
+    }
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI zipmenu_GetCommandString( IContextMenu *iface, UINT_PTR cmd, UINT type, UINT *reserved,
+                                                char *name, UINT len )
+{
+    if (cmd >= ARRAY_SIZE(zipmenu_verbs)) return E_INVALIDARG;
+    if (type == GCS_VERBW) lstrcpynW( (WCHAR *)name, zipmenu_verbs[cmd], len );
+    else if (type == GCS_VERBA) WideCharToMultiByte( CP_ACP, 0, zipmenu_verbs[cmd], -1, name, len, NULL, NULL );
+    else return E_NOTIMPL;
+    return S_OK;
+}
+
+static const IContextMenuVtbl zipmenu_vtbl =
+{
+    zipmenu_QueryInterface,
+    zipmenu_AddRef,
+    zipmenu_Release,
+    zipmenu_QueryContextMenu,
+    zipmenu_InvokeCommand,
+    zipmenu_GetCommandString
+};
