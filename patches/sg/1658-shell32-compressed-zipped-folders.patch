+++ b/dlls/shell32/zipfolder.c
@@ -0,0 +1,2185 @@
+/*
+ * Compressed (zipped) Folders: the CompressedFolder shell folder
+ * (Stained Glass OS 1658)
+ *
+ * A .zip file is a shell folder of its own, as on Windows: binding to the
+ * file (its type's CLSID has a ShellFolder key) gives this folder, and paths
+ * through it ("C:\a.zip\docs\readme.txt") parse. Scripts and installers use
+ * it through Shell.Application -- NameSpace(zip).Items() to list,
+ * dest.CopyHere(items) to extract, NameSpace(zip).CopyHere(file) to add -- and
+ * programs through IShellFolder: listing, details, streams of the files, a
+ * data object whose CF_HDROP is the files extracted to a temporary folder,
+ * and a drop target that adds files. Reading takes stored and deflated
+ * entries and ZIP64; writing rewrites the archive beside it and replaces it.
+ * File Explorer's own window for .zip files stays sg-zip.
+ *
+ * Our own work from PKWARE's published .ZIP format description and
+ * Windows' documented shell interfaces; no Microsoft code.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
