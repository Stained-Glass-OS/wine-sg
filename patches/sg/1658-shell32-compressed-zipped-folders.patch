+        if (SUCCEEDED(hr))
+        {
+            if (SUCCEEDED(hr = SHELL_CreateHDropDataObject(sources, &data)))
+            {
+                IDropTarget_DragEnter(target, data, MK_LBUTTON, pt, &effect);
+                effect = DROPEFFECT_COPY;
+                hr = IDropTarget_Drop(target, data, MK_LBUTTON, pt, &effect);
+                if (SUCCEEDED(hr) && effect == DROPEFFECT_NONE) hr = E_FAIL;
+                IDataObject_Release(data);
+            }
+            IDropTarget_Release(target);
+        }
+        if (SUCCEEDED(hr) && func == FO_MOVE)
+        {
+            op.wFunc = FO_DELETE;
+            op.pFrom = sources;
+            op.fFlags = FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI;
+            SHFileOperationW(&op);
+        }
+        free(sources);
+        return hr;
+    }
+
     if (!(dest = calloc(wcslen(This->path) + 2, sizeof(WCHAR))))
     {
         free(sources);
