+/* ------------------------------------------------------------------------ */
+/* a CF_HDROP data object                                                   */
+
+struct hdrop_object
+{
+    IDataObject IDataObject_iface;
+    LONG ref;
+    WCHAR *paths;       /* double-null list */
+    size_t len;         /* in WCHARs, both nulls included */
+    WCHAR *temp_dir;    /* removed with the object, when files were extracted */
+};
+
+static inline struct hdrop_object *impl_from_hdrop( IDataObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct hdrop_object, IDataObject_iface );
+}
+
+static HRESULT WINAPI hdrop_QueryInterface( IDataObject *iface, REFIID riid, void **ppv )
+{
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IDataObject ))
+    {
+        *ppv = iface;
+        IDataObject_AddRef( iface );
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI hdrop_AddRef( IDataObject *iface )
+{
+    return InterlockedIncrement( &impl_from_hdrop( iface )->ref );
+}
+
+static ULONG WINAPI hdrop_Release( IDataObject *iface )
+{
+    struct hdrop_object *This = impl_from_hdrop( iface );
+    LONG ref = InterlockedDecrement( &This->ref );
+    if (!ref)
+    {
+        free( This->paths );
+        free( This->temp_dir );
+        free( This );
+    }
+    return ref;
+}
+
+static BOOL hdrop_format( const FORMATETC *fmt )
+{
+    return fmt->cfFormat == CF_HDROP && (fmt->tymed & TYMED_HGLOBAL) && (!fmt->ptd);
+}
+
+static HRESULT WINAPI hdrop_GetData( IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium )
+{
+    struct hdrop_object *This = impl_from_hdrop( iface );
+    DROPFILES *df;
+    HGLOBAL mem;
+
+    if (!hdrop_format( fmt )) return DV_E_FORMATETC;
+    if (!(mem = GlobalAlloc( GMEM_MOVEABLE | GMEM_ZEROINIT, sizeof(DROPFILES) + This->len * sizeof(WCHAR) )))
+        return E_OUTOFMEMORY;
+    df = GlobalLock( mem );
+    df->pFiles = sizeof(DROPFILES);
+    df->fWide = TRUE;
+    memcpy( df + 1, This->paths, This->len * sizeof(WCHAR) );
+    GlobalUnlock( mem );
+    medium->tymed = TYMED_HGLOBAL;
+    medium->hGlobal = mem;
+    medium->pUnkForRelease = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI hdrop_GetDataHere( IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI hdrop_QueryGetData( IDataObject *iface, FORMATETC *fmt )
+{
+    return hdrop_format( fmt ) ? S_OK : DV_E_FORMATETC;
+}
+
+static HRESULT WINAPI hdrop_GetCanonicalFormatEtc( IDataObject *iface, FORMATETC *in, FORMATETC *out )
+{
+    *out = *in;
+    out->ptd = NULL;
+    return DATA_S_SAMEFORMATETC;
+}
+
+static HRESULT WINAPI hdrop_SetData( IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium, BOOL release )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI hdrop_EnumFormatEtc( IDataObject *iface, DWORD dir, IEnumFORMATETC **enumfmt )
+{
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    if (dir != DATADIR_GET) return E_NOTIMPL;
+    return SHCreateStdEnumFmtEtc( 1, &fmt, enumfmt );
+}
+
+static HRESULT WINAPI hdrop_DAdvise( IDataObject *iface, FORMATETC *fmt, DWORD advf, IAdviseSink *sink, DWORD *conn )
+{
+    return OLE_E_ADVISENOTSUPPORTED;
+}
+
+static HRESULT WINAPI hdrop_DUnadvise( IDataObject *iface, DWORD conn )
+{
+    return OLE_E_ADVISENOTSUPPORTED;
+}
+
+static HRESULT WINAPI hdrop_EnumDAdvise( IDataObject *iface, IEnumSTATDATA **enumadvise )
+{
+    return OLE_E_ADVISENOTSUPPORTED;
+}
