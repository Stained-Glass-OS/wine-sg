+/* the icon of an item: its type's, as for a file of that name */
+static HRESULT get_extract_icon( const struct zip_pidl *z, REFIID riid, void **ppv )
+{
+    SHFILEINFOW info;
+    IDefaultExtractIconInit *init;
+    HRESULT hr;
+
+    if (FAILED(hr = SHCreateDefaultExtractIcon( &IID_IDefaultExtractIconInit, (void **)&init ))) return hr;
+    if (SHGetFileInfoW( z->name, z->is_dir ? FILE_ATTRIBUTE_DIRECTORY : FILE_ATTRIBUTE_NORMAL, &info, sizeof(info),
+                        SHGFI_USEFILEATTRIBUTES | SHGFI_ICONLOCATION ) && info.szDisplayName[0])
+        IDefaultExtractIconInit_SetNormalIcon( init, info.szDisplayName, info.iIcon );
+    else
+        IDefaultExtractIconInit_SetNormalIcon( init, L"shell32.dll", z->is_dir ? 3 : 0 );
+    hr = IDefaultExtractIconInit_QueryInterface( init, riid, ppv );
+    IDefaultExtractIconInit_Release( init );
+    return hr;
+}
+
+static HRESULT WINAPI ZipFolder_GetUIObjectOf( IShellFolder2 *iface, HWND hwnd, UINT count, LPCITEMIDLIST *pidls,
+                                               REFIID riid, UINT *reserved, void **ppv )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    HRESULT hr;
+    UINT i;
+
+    TRACE( "(%p)->(%u %s)\n", This, count, debugstr_guid(riid) );
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+    for (i = 0; i < count; i++) if (!zip_pidl( pidls[i] )) return E_INVALIDARG;
+    if (!count) return E_INVALIDARG;
+
+    if (IsEqualIID( riid, &IID_IDataObject ))
+    {
+        WCHAR *list;
+        size_t len;
+        if (FAILED(hr = extract_children_to_temp( This, count, pidls, &list, &len ))) return hr;
+        hr = SHELL_CreateHDropDataObject( list, (IDataObject **)ppv );
+        free( list );
+        return hr;
+    }
+    if ((IsEqualIID( riid, &IID_IExtractIconW ) || IsEqualIID( riid, &IID_IExtractIconA )) && count == 1)
+        return get_extract_icon( zip_pidl( pidls[0] ), riid, ppv );
+    if (IsEqualIID( riid, &IID_IDropTarget ) && count == 1 && zip_pidl( pidls[0] )->is_dir)
+    {
+        WCHAR inner[MAX_PATH * 4];
+        child_inner( This, zip_pidl( pidls[0] ), inner, ARRAY_SIZE(inner) );
+        return create_drop_target( This->zip, inner, ppv );
+    }
+    if (IsEqualIID( riid, &IID_IContextMenu ))
+    {
+        struct zip_menu *menu = calloc( 1, sizeof(*menu) );
+        if (!menu || !(menu->pidls = calloc( count, sizeof(*menu->pidls) )))
+        {
+            free( menu );
+            return E_OUTOFMEMORY;
+        }
+        menu->IContextMenu_iface.lpVtbl = &zipmenu_vtbl;
+        menu->ref = 1;
+        menu->folder = This;
+        IShellFolder2_AddRef( iface );
+        for (i = 0; i < count; i++) menu->pidls[i] = ILClone( pidls[i] );
+        menu->count = count;
+        *ppv = &menu->IContextMenu_iface;
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI ZipFolder_GetDisplayNameOf( IShellFolder2 *iface, LPCITEMIDLIST pidl, SHGDNF flags, STRRET *name )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    const struct zip_pidl *z = zip_pidl( pidl );
+    WCHAR buf[MAX_PATH * 4];
+
+    if (!name) return E_POINTER;
+    if (_ILIsEmpty( pidl ))
+    {
+        swprintf( buf, ARRAY_SIZE(buf), This->prefix[0] ? L"%s\\%s" : L"%s%s", This->zip, This->prefix );
+    }
+    else
+    {
+        if (!z) return E_INVALIDARG;
+        if (!_ILIsPidlSimple( pidl ))
+        {
+            /* the last item's folder answers it */
+            IShellFolder *parent;
+            LPITEMIDLIST head = ILClone( pidl );
+            HRESULT hr;
+
+            ILRemoveLastID( head );
+            hr = IShellFolder2_BindToObject( iface, head, NULL, &IID_IShellFolder, (void **)&parent );
+            ILFree( head );
+            if (FAILED(hr)) return hr;
+            hr = IShellFolder_GetDisplayNameOf( parent, ILFindLastID( pidl ), flags, name );
+            IShellFolder_Release( parent );
+            return hr;
+        }
+        if ((flags & SHGDN_FORPARSING) && !(flags & SHGDN_INFOLDER))
+            swprintf( buf, ARRAY_SIZE(buf), This->prefix[0] ? L"%s\\%s\\%s" : L"%s%s\\%s", This->zip, This->prefix, z->name );
+        else
+            lstrcpynW( buf, z->name, ARRAY_SIZE(buf) );
+    }
+    name->uType = STRRET_WSTR;
+    return SHStrDupW( buf, &name->pOleStr );
+}
+
+static HRESULT WINAPI ZipFolder_SetNameOf( IShellFolder2 *iface, HWND hwnd, LPCITEMIDLIST pidl, LPCOLESTR new_name,
+                                           SHGDNF flags, LPITEMIDLIST *out )
+{
+    ZipFolder *This = impl_from_IShellFolder2( iface );
+    const struct zip_pidl *z = zip_pidl( pidl );
+    WCHAR from[MAX_PATH * 4], to[MAX_PATH * 4];
+    HRESULT hr;
+
+    if (out) *out = NULL;
+    if (!z || !_ILIsPidlSimple( pidl ) || !new_name || !*new_name || wcspbrk( new_name, L"\\/:*?\"<>|" ))
+        return E_INVALIDARG;
+    child_inner( This, z, from, ARRAY_SIZE(from) );
+    swprintf( to, ARRAY_SIZE(to), This->prefix[0] ? L"%s\\%s" : L"%s%s", This->prefix, new_name );
+    hr = rewrite_archive( This->zip, L"", NULL, NULL, from, to );
+    if (SUCCEEDED(hr) && out)
+    {
+        struct zip_pidl *copy = (struct zip_pidl *)make_pidl( new_name, z->is_dir, NULL );
+        if (copy)
+        {
+            copy->usize = z->usize;
+            copy->csize = z->csize;
+            copy->mtime = z->mtime;
+            copy->encrypted = z->encrypted;
+            copy->method = z->method;
+        }
+        *out = (LPITEMIDLIST)copy;
+    }
+    return hr;
+}
