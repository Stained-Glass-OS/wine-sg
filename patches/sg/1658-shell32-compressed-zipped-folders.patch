+}
+
+/* the columns Windows shows for a compressed folder */
+static const struct
+{
+    const WCHAR *title;
+    int fmt, width;
+    const PROPERTYKEY *key;
+}
+zip_columns[] =
+{
+    { L"Name",               LVCFMT_LEFT,  30, &PKEY_ItemNameDisplay },
+    { L"Type",               LVCFMT_LEFT,  20, &PKEY_ItemTypeText },
+    { L"Compressed size",    LVCFMT_RIGHT, 12, NULL },
+    { L"Password protected", LVCFMT_LEFT,  10, NULL },
+    { L"Size",               LVCFMT_RIGHT, 12, &PKEY_Size },
+    { L"Ratio",              LVCFMT_RIGHT,  8, NULL },
+    { L"Date modified",      LVCFMT_LEFT,  20, &PKEY_DateModified },
+};
+
+static HRESULT WINAPI ZipFolder_GetDefaultColumnState( IShellFolder2 *iface, UINT column, SHCOLSTATEF *flags )
+{
+    if (column >= ARRAY_SIZE(zip_columns)) return E_INVALIDARG;
+    *flags = SHCOLSTATE_ONBYDEFAULT | (column == 2 || column == 4 || column == 5 ? SHCOLSTATE_TYPE_INT :
+             column == 6 ? SHCOLSTATE_TYPE_DATE : SHCOLSTATE_TYPE_STR);
+    return S_OK;
+}
+
+static HRESULT WINAPI ZipFolder_GetDetailsEx( IShellFolder2 *iface, LPCITEMIDLIST pidl, const SHCOLUMNID *key, VARIANT *v )
+{
+    const struct zip_pidl *z = zip_pidl( pidl );
+
+    if (!z || !key || !v) return E_INVALIDARG;
+    if (IsEqualPropertyKey( *key, PKEY_Size ))
+    {
+        V_VT(v) = VT_UI8;
+        V_UI8(v) = z->usize;
+        return S_OK;
+    }
+    if (IsEqualPropertyKey( *key, PKEY_DateModified ))
+    {
+        SYSTEMTIME st;
+        FILETIME local;
+        FileTimeToLocalFileTime( &z->mtime, &local );
+        FileTimeToSystemTime( &local, &st );
+        V_VT(v) = VT_DATE;
+        return SystemTimeToVariantTime( &st, &V_DATE(v) ) ? S_OK : E_FAIL;
+    }
+    if (IsEqualPropertyKey( *key, PKEY_ItemNameDisplay ))
+    {
+        V_VT(v) = VT_BSTR;
+        return (V_BSTR(v) = SysAllocString( z->name )) ? S_OK : E_OUTOFMEMORY;
+    }
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ZipFolder_GetDetailsOf( IShellFolder2 *iface, LPCITEMIDLIST pidl, UINT column, SHELLDETAILS *details )
+{
+    const struct zip_pidl *z = zip_pidl( pidl );
+    WCHAR buf[128];
+
+    if (!details || column >= ARRAY_SIZE(zip_columns)) return E_INVALIDARG;
+    details->fmt = zip_columns[column].fmt;
+    details->cxChar = zip_columns[column].width;
+    if (!pidl) return SHStrDupW( zip_columns[column].title, &details->str.pOleStr ) == S_OK ?
+                      (details->str.uType = STRRET_WSTR, S_OK) : E_OUTOFMEMORY;
+    if (!z) return E_INVALIDARG;
+    buf[0] = 0;
+    switch (column)
+    {
+    case 0: lstrcpynW( buf, z->name, ARRAY_SIZE(buf) ); break;
+    case 1:
+    {
+        SHFILEINFOW info;
+        if (SHGetFileInfoW( z->name, z->is_dir ? FILE_ATTRIBUTE_DIRECTORY : FILE_ATTRIBUTE_NORMAL, &info,
+                            sizeof(info), SHGFI_USEFILEATTRIBUTES | SHGFI_TYPENAME ))
+            lstrcpynW( buf, info.szTypeName, ARRAY_SIZE(buf) );
+        break;
+    }
+    case 2: if (!z->is_dir) StrFormatKBSizeW( z->csize, buf, ARRAY_SIZE(buf) ); break;
+    case 3: if (!z->is_dir) lstrcpyW( buf, z->encrypted ? L"Yes" : L"No" ); break;
+    case 4: if (!z->is_dir) StrFormatKBSizeW( z->usize, buf, ARRAY_SIZE(buf) ); break;
+    case 5:
+        if (!z->is_dir)
+            swprintf( buf, ARRAY_SIZE(buf), L"%u%%", z->usize ? (UINT)(100 - min( 100, z->csize * 100 / z->usize )) : 0 );
+        break;
+    case 6:
+    {
+        FILETIME local;
+        SYSTEMTIME st;
+        WCHAR t[64];
+        if (!z->mtime.dwLowDateTime && !z->mtime.dwHighDateTime) break;
+        FileTimeToLocalFileTime( &z->mtime, &local );
+        FileTimeToSystemTime( &local, &st );
+        GetDateFormatW( LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, buf, ARRAY_SIZE(buf) );
+        GetTimeFormatW( LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, t, ARRAY_SIZE(t) );
+        lstrcatW( buf, L" " );
+        lstrcatW( buf, t );
+        break;
+    }
+    }
+    details->str.uType = STRRET_WSTR;
+    return SHStrDupW( buf, &details->str.pOleStr );
+}
+
+static HRESULT WINAPI ZipFolder_MapColumnToSCID( IShellFolder2 *iface, UINT column, SHCOLUMNID *scid )
+{
+    if (column >= ARRAY_SIZE(zip_columns) || !zip_columns[column].key) return E_INVALIDARG;
+    memcpy( scid, zip_columns[column].key, sizeof(*scid) );
+    return S_OK;
+}
