+/* GUID description / DWORD values live at
+ * HKLM\...\CTF\TIP\<clsid>\Category\Item\<guid> (values "Description"/"Dword").
+ * The exact value names are our choice (the docs only say "the registry"). */
+static HRESULT open_item_key(REFCLSID rclsid, REFGUID rguid, BOOL create, HKEY *key)
+{
+    WCHAR path[200], c[39], g[39];
+    LSTATUS r;
+
+    StringFromGUID2(rclsid, c, 39);
+    StringFromGUID2(rguid, g, 39);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s\\Category\\Item\\%s", szwSystemTIPKey, c, g);
+    if (create)
+        r = RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_READ | KEY_WRITE, NULL, key, NULL);
+    else
+        r = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ | KEY_WRITE, key);
+    return r ? E_FAIL : S_OK;
+}
