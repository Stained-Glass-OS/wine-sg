+static HRESULT WINAPI MemStore_GetFormattedText(ITextStoreACP *iface, LONG start, LONG end, IDataObject **obj)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    TextData *d;
+
+    TRACE("(%p) %ld %ld %p\n", This, start, end, obj);
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!This->lock) return TS_E_NOLOCK;
+    if (end == -1) end = This->len;
+    if (start < 0 || end < start || end > This->len) return TS_E_INVALIDPOS;
+    if (!(d = calloc(1, sizeof(*d)))) return E_OUTOFMEMORY;
+    if (!(d->text = malloc((end - start + 1) * sizeof(WCHAR))))
+    {
+        free(d);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(d->text, This->text + start, (end - start) * sizeof(WCHAR));
+    d->cch = end - start;
+    d->IDataObject_iface.lpVtbl = &TextDataVtbl;
+    d->ref = 1;
+    *obj = &d->IDataObject_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_GetEmbedded(ITextStoreACP *iface, LONG pos, REFGUID service, REFIID riid, IUnknown **obj)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %ld %s %s %p\n", This, pos, debugstr_guid(service), debugstr_guid(riid), obj);
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!This->lock) return TS_E_NOLOCK;
+    if (pos < 0 || pos > This->len) return TS_E_INVALIDPOS;
+    /* the text holds no embedded objects */
+    return TS_E_NOSERVICE;
+}
+
+static HRESULT WINAPI MemStore_QueryInsertEmbedded(ITextStoreACP *iface, const GUID *service,
+        const FORMATETC *fe, BOOL *insertable)
+{
+    TRACE("(%p) %s %p %p\n", iface, debugstr_guid(service), fe, insertable);
+
+    if (!insertable) return E_INVALIDARG;
+    /* text only: a Unicode text format can be taken in */
+    *insertable = fe && format_ok(fe);
+    return S_OK;
+}
+
+static HRESULT data_text(IDataObject *obj, WCHAR **text, ULONG *cch)
+{
+    FORMATETC fe;
+    STGMEDIUM med;
+    const WCHAR *p;
+    HRESULT hr;
+
+    fill_format(&fe);
+    if (FAILED(IDataObject_QueryGetData(obj, &fe))) return TS_E_FORMAT;
+    if (FAILED(hr = IDataObject_GetData(obj, &fe, &med))) return TS_E_FORMAT;
+    if (med.tymed != TYMED_HGLOBAL)
+    {
+        ReleaseStgMedium(&med);
+        return TS_E_FORMAT;
+    }
+    if ((p = GlobalLock(med.hGlobal)))
+    {
+        SIZE_T max = GlobalSize(med.hGlobal) / sizeof(WCHAR);
+        ULONG n = 0;
+
+        while (n < max && p[n]) n++;
+        if ((*text = malloc((n + 1) * sizeof(WCHAR)))) memcpy(*text, p, n * sizeof(WCHAR));
+        *cch = n;
+        GlobalUnlock(med.hGlobal);
+        hr = *text ? S_OK : E_OUTOFMEMORY;
+    }
+    else
+        hr = E_FAIL;
+    ReleaseStgMedium(&med);
+    return hr;
+}
+
+static HRESULT WINAPI MemStore_InsertEmbedded(ITextStoreACP *iface, DWORD flags, LONG start, LONG end,
+        IDataObject *obj, TS_TEXTCHANGE *change)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    WCHAR *text = NULL;
+    ULONG cch = 0;
+    HRESULT hr;
+
+    TRACE("(%p) %#lx %ld %ld %p %p\n", This, flags, start, end, obj, change);
+
+    if (!obj || !change) return E_INVALIDARG;
+    if ((This->lock & TS_LF_READWRITE) != TS_LF_READWRITE) return TS_E_NOLOCK;
+    if (end == -1) end = This->len;
+    if (start < 0 || end < start || end > This->len) return TS_E_INVALIDPOS;
+    if (FAILED(hr = data_text(obj, &text, &cch))) return hr;
+    hr = replace_text(This, start, end, text, cch, change);
+    free(text);
+    if (SUCCEEDED(hr)) notify_text(This, change->acpStart, change->acpOldEnd, change->acpNewEnd, 0);
+    return hr;
+}
+
+static HRESULT insert_at_selection(MemStore *This, DWORD flags, const WCHAR *text, ULONG cch, LONG *pstart,
+        LONG *pend, TS_TEXTCHANGE *change)
+{
+    LONG start = This->sel.acpStart, end = This->sel.acpEnd;
+    HRESULT hr;
+
+    if ((This->lock & TS_LF_READWRITE) != TS_LF_READWRITE) return TS_E_NOLOCK;
+    if (flags & TS_IAS_QUERYONLY)
+    {
+        if (pstart) *pstart = start;
+        if (pend) *pend = start + cch;
+        if (change) change->acpStart = change->acpOldEnd = change->acpNewEnd = 0;
+        return S_OK;
+    }
+    if (!change) return E_INVALIDARG;
+#ifdef SG_MUTANT_MSCTFB1_MEMINS
+    cch = 0;
+#endif
+    if (FAILED(hr = replace_text(This, start, end, text, cch, change))) return hr;
+    /* the inserted text is selected (or just the end after it) */
+    This->sel.acpStart = start;
+    This->sel.acpEnd = start + cch;
+    if (pstart) *pstart = start;
+    if (pend) *pend = start + cch;
+    notify_text(This, change->acpStart, change->acpOldEnd, change->acpNewEnd, 0);
+    notify_sel(This);
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_InsertTextAtSelection(ITextStoreACP *iface, DWORD flags, const WCHAR *text,
+        ULONG cch, LONG *start, LONG *end, TS_TEXTCHANGE *change)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %#lx %s %lu %p %p %p\n", This, flags, debugstr_wn(text, cch), cch, start, end, change);
+
+    if (cch && !text) return E_INVALIDARG;
+    if ((flags & (TS_IAS_NOQUERY | TS_IAS_QUERYONLY)) == (TS_IAS_NOQUERY | TS_IAS_QUERYONLY)) return E_INVALIDARG;
+    return insert_at_selection(This, flags, text, cch, start, end, change);
+}
+
+static HRESULT WINAPI MemStore_InsertEmbeddedAtSelection(ITextStoreACP *iface, DWORD flags, IDataObject *obj,
+        LONG *start, LONG *end, TS_TEXTCHANGE *change)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    WCHAR *text = NULL;
+    ULONG cch = 0;
+    HRESULT hr;
+
+    TRACE("(%p) %#lx %p %p %p %p\n", This, flags, obj, start, end, change);
+
+    if (!obj) return E_INVALIDARG;
+    if ((flags & (TS_IAS_NOQUERY | TS_IAS_QUERYONLY)) == (TS_IAS_NOQUERY | TS_IAS_QUERYONLY)) return E_INVALIDARG;
+    if (FAILED(hr = data_text(obj, &text, &cch))) return hr;
+    hr = insert_at_selection(This, flags, text, cch, start, end, change);
+    free(text);
+    return hr;
+}
+
+static HRESULT WINAPI MemStore_RequestSupportedAttrs(ITextStoreACP *iface, DWORD flags, ULONG count,
+        const TS_ATTRID *attrs)
+{
+    TRACE("(%p) %#lx %lu %p\n", iface, flags, count, attrs);
+    if (count && !attrs) return E_INVALIDARG;
+    return S_OK;    /* no attribute is supported: none is ever returned */
+}
+
+static HRESULT WINAPI MemStore_RequestAttrsAtPosition(ITextStoreACP *iface, LONG pos, ULONG count,
+        const TS_ATTRID *attrs, DWORD flags)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %ld %lu %p %#lx\n", This, pos, count, attrs, flags);
+    if (count && !attrs) return E_INVALIDARG;
+    if (!This->lock) return TS_E_NOLOCK;
+    if (pos < 0 || pos > This->len) return TS_E_INVALIDPOS;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_RequestAttrsTransitioningAtPosition(ITextStoreACP *iface, LONG pos, ULONG count,
+        const TS_ATTRID *attrs, DWORD flags)
+{
+    return MemStore_RequestAttrsAtPosition(iface, pos, count, attrs, flags);
+}
+
+static HRESULT WINAPI MemStore_FindNextAttrTransition(ITextStoreACP *iface, LONG start, LONG halt, ULONG count,
+        const TS_ATTRID *attrs, DWORD flags, LONG *next, BOOL *found, LONG *offset)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %ld %ld %lu %p %#lx %p %p %p\n", This, start, halt, count, attrs, flags, next, found, offset);
+
+    if (!next || !found || !offset || (count && !attrs)) return E_INVALIDARG;
+    if (!This->lock) return TS_E_NOLOCK;
+    if (start < 0 || start > This->len) return TS_E_INVALIDPOS;
+    /* the text has no attributes, so no transition: stop at the halt position */
+    *found = FALSE;
+    *offset = 0;
+    *next = halt < 0 || halt > This->len ? This->len : halt;
+    if (flags & TS_ATTR_FIND_BACKWARDS) *next = halt < 0 ? 0 : halt;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_RetrieveRequestedAttrs(ITextStoreACP *iface, ULONG count, TS_ATTRVAL *vals,
+        ULONG *fetched)
+{
+    TRACE("(%p) %lu %p %p\n", iface, count, vals, fetched);
+    if (!vals || !fetched) return E_INVALIDARG;
+    *fetched = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_GetEndACP(ITextStoreACP *iface, LONG *acp)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %p\n", This, acp);
+
+    if (!acp) return E_INVALIDARG;
+    if (!This->lock) return TS_E_NOLOCK;
+    *acp = This->len;
+    return S_OK;
+}
