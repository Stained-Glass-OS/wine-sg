+static HRESULT check_profile_args(DWORD type, REFCLSID clsid, REFGUID guid, HKL hkl)
+{
+    if (type == TF_PROFILETYPE_KEYBOARDLAYOUT)
+        return IsEqualGUID(clsid, &GUID_NULL) && IsEqualGUID(guid, &GUID_NULL) && hkl ? S_OK : E_INVALIDARG;
+    if (type == TF_PROFILETYPE_INPUTPROCESSOR)
+        return !IsEqualGUID(clsid, &GUID_NULL) && !hkl ? S_OK : E_INVALIDARG;
+    return E_INVALIDARG;
+}
