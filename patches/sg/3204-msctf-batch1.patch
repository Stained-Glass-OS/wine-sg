+/* ITfContext::GetAppProperty: a read-only property kept by the context owner;
+ * here its values are the owner's text store attributes (the property GUID is
+ * the attribute id). ITfContext::TrackProperties: a read-only property over
+ * several text and application properties; GetValue gives an
+ * IEnumTfPropertyValue (VT_UNKNOWN) of their values over a range, EnumRanges
+ * the stretches of the target where any of them has a value. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "wine/debug.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "objbase.h"
+#include "oleauto.h"
+
+#include "msctf.h"
+#include "msctf_internal.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msctf);
+
+typedef struct
+{
+    ITfReadOnlyProperty ITfReadOnlyProperty_iface;
+    LONG ref;
+    ITfContext *context;
+    GUID guid;
+} AppProp;
+
+static inline AppProp *impl_from_AppProp(ITfReadOnlyProperty *iface)
+{
+    return CONTAINING_RECORD(iface, AppProp, ITfReadOnlyProperty_iface);
+}
+
+static HRESULT WINAPI AppProp_QueryInterface(ITfReadOnlyProperty *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITfReadOnlyProperty))
+    {
+        *obj = iface;
+        ITfReadOnlyProperty_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI AppProp_AddRef(ITfReadOnlyProperty *iface)
+{
+    return InterlockedIncrement(&impl_from_AppProp(iface)->ref);
+}
+
+static ULONG WINAPI AppProp_Release(ITfReadOnlyProperty *iface)
+{
+    AppProp *This = impl_from_AppProp(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        ITfContext_Release(This->context);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI AppProp_GetType(ITfReadOnlyProperty *iface, GUID *guid)
+{
+    AppProp *This = impl_from_AppProp(iface);
+
+    if (!guid) return E_INVALIDARG;
+    *guid = This->guid;
+    return S_OK;
+}
+
+/* the value of the attribute at pos: VT_EMPTY when the text has none there */
+static HRESULT attr_value(ITextStoreACP *store, LONG pos, const GUID *guid, VARIANT *value)
+{
+    TS_ATTRVAL val;
+    ULONG fetched = 0;
+    HRESULT hr;
+
+    VariantInit(value);
+    if (FAILED(hr = ITextStoreACP_RequestAttrsAtPosition(store, pos, 1, guid, TS_ATTR_FIND_WANT_VALUE))) return hr;
+    memset(&val, 0, sizeof(val));
+    if (FAILED(hr = ITextStoreACP_RetrieveRequestedAttrs(store, 1, &val, &fetched))) return hr;
+    if (fetched && IsEqualGUID(&val.idAttr, guid))
+    {
+        hr = VariantCopy(value, &val.varValue);
+        VariantClear(&val.varValue);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI AppProp_GetValue(ITfReadOnlyProperty *iface, TfEditCookie ec, ITfRange *range, VARIANT *value)
+{
+    AppProp *This = impl_from_AppProp(iface);
+    ITextStoreACP *store = Context_GetTextStore(This->context);
+    LONG start, end;
+    HRESULT hr;
+
+    TRACE("(%p) %li %p %p\n", This, ec, range, value);
+
+    if (!value || !range) return E_INVALIDARG;
+    VariantInit(value);
+    if (FAILED(hr = Context_CheckCookie(This->context, ec, FALSE))) return hr;
+    if (FAILED(Range_GetAnchors(range, &start, &end))) return E_INVALIDARG;
+    hr = attr_value(store, min(start, end), &This->guid, value);
+    return hr == TS_E_NOLOCK ? TF_E_NOLOCK : hr;
+}
+
+static HRESULT WINAPI AppProp_GetContext(ITfReadOnlyProperty *iface, ITfContext **context)
+{
+    AppProp *This = impl_from_AppProp(iface);
+
+    if (!context) return E_INVALIDARG;
+    *context = This->context;
+    ITfContext_AddRef(*context);
+    return S_OK;
+}
+
+static HRESULT WINAPI AppProp_EnumRanges(ITfReadOnlyProperty *iface, TfEditCookie ec, IEnumTfRanges **ret,
+        ITfRange *target)
+{
+    AppProp *This = impl_from_AppProp(iface);
+    ITextStoreACP *store = Context_GetTextStore(This->context);
+    ITfRange **ranges = NULL;
+    ULONG count = 0, i, cap = 0;
+    LONG pos, stop;
+    HRESULT hr;
+
+    TRACE("(%p) %li %p %p\n", This, ec, ret, target);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (FAILED(hr = Context_CheckCookie(This->context, ec, FALSE))) return hr;
+    if (target)
+    {
+        LONG a, b;
+        if (FAILED(Range_GetAnchors(target, &a, &b))) return E_INVALIDARG;
+        pos = min(a, b);
+        stop = max(a, b);
+    }
+    else
+    {
+        pos = 0;
+        if (FAILED(hr = ITextStoreACP_GetEndACP(store, &stop))) return hr == TS_E_NOLOCK ? TF_E_NOLOCK : hr;
+    }
+
+    hr = S_OK;
+    while (pos < stop)
+    {
+        VARIANT v;
+        LONG next = stop, off = 0;
+        BOOL found = FALSE;
+
+        if (FAILED(hr = attr_value(store, pos, &This->guid, &v))) break;
+        hr = ITextStoreACP_FindNextAttrTransition(store, pos, stop, 1, &This->guid, 0, &next, &found, &off);
+        if (FAILED(hr))
+        {
+            VariantClear(&v);
+            break;
+        }
+        if (!found || next > stop) next = stop;
+        if (next <= pos) next = stop;
+        if (V_VT(&v) != VT_EMPTY)
+        {
+            if (count == cap)
+            {
+                ITfRange **n = realloc(ranges, (cap ? cap * 2 : 4) * sizeof(*ranges));
+                if (!n)
+                {
+                    VariantClear(&v);
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                ranges = n;
+                cap = cap ? cap * 2 : 4;
+            }
+            if (FAILED(hr = Range_Constructor(This->context, pos, next, &ranges[count])))
+            {
+                VariantClear(&v);
+                break;
+            }
+            count++;
+        }
+        VariantClear(&v);
+        pos = next;
+    }
+    if (SUCCEEDED(hr)) hr = PropRanges_Create(ranges, count, ret);
+    else if (hr == TS_E_NOLOCK) hr = TF_E_NOLOCK;
+    for (i = 0; i < count; i++) ITfRange_Release(ranges[i]);
+    free(ranges);
+    return hr;
+}
+
+static const ITfReadOnlyPropertyVtbl AppPropVtbl =
+{
+    AppProp_QueryInterface,
+    AppProp_AddRef,
+    AppProp_Release,
+    AppProp_GetType,
+    AppProp_EnumRanges,
+    AppProp_GetValue,
+    AppProp_GetContext
+};
+
+HRESULT AppProperty_Create(ITfContext *context, REFGUID guid, ITfReadOnlyProperty **ret)
+{
+    ITextStoreACP *store = Context_GetTextStore(context);
+    TS_ATTRVAL val;
+    ULONG fetched = 0;
+    AppProp *p;
+    HRESULT hr;
+
+    *ret = NULL;
+    /* does the context owner support the attribute? */
+    if (FAILED(hr = ITextStoreACP_RequestSupportedAttrs(store, TS_ATTR_FIND_WANT_VALUE, 1, guid)))
+        return hr == E_NOTIMPL ? E_NOTIMPL : S_FALSE;
+    memset(&val, 0, sizeof(val));
+    if (FAILED(hr = ITextStoreACP_RetrieveRequestedAttrs(store, 1, &val, &fetched))) return S_FALSE;
+    if (fetched) VariantClear(&val.varValue);
+    if (!fetched || !IsEqualGUID(&val.idAttr, guid)) return S_FALSE;
+
+    if (!(p = calloc(1, sizeof(*p)))) return E_OUTOFMEMORY;
+    p->ITfReadOnlyProperty_iface.lpVtbl = &AppPropVtbl;
+    p->ref = 1;
+    p->context = context;
+    ITfContext_AddRef(context);
+    p->guid = *guid;
+    *ret = &p->ITfReadOnlyProperty_iface;
+    return S_OK;
+}
+
+/* ---- tracked properties ---- */
+
+typedef struct
+{
+    ITfReadOnlyProperty ITfReadOnlyProperty_iface;
+    LONG ref;
+    ITfContext *context;
+    ITfReadOnlyProperty **props;    /* NULL entry: the owner does not support it */
+    GUID *guids;
+    ULONG count;
+} TrackProp;
+
+static inline TrackProp *impl_from_TrackProp(ITfReadOnlyProperty *iface)
+{
+    return CONTAINING_RECORD(iface, TrackProp, ITfReadOnlyProperty_iface);
+}
+
+typedef struct
+{
+    IEnumTfPropertyValue IEnumTfPropertyValue_iface;
+    LONG ref;
+    TF_PROPERTYVAL *vals;
+    ULONG count, pos;
+} ValEnum;
+
+static inline ValEnum *impl_from_ValEnum(IEnumTfPropertyValue *iface)
+{
+    return CONTAINING_RECORD(iface, ValEnum, IEnumTfPropertyValue_iface);
+}
+
+static HRESULT WINAPI ValEnum_QueryInterface(IEnumTfPropertyValue *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumTfPropertyValue))
+    {
+        *obj = iface;
+        IEnumTfPropertyValue_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ValEnum_AddRef(IEnumTfPropertyValue *iface)
+{
+    return InterlockedIncrement(&impl_from_ValEnum(iface)->ref);
+}
+
+static ULONG WINAPI ValEnum_Release(IEnumTfPropertyValue *iface)
+{
+    ValEnum *This = impl_from_ValEnum(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) VariantClear(&This->vals[i].varValue);
+        free(This->vals);
+        free(This);
+    }
+    return ref;
+}
+
+static const IEnumTfPropertyValueVtbl ValEnumVtbl;
+
+static HRESULT valenum_create(const TF_PROPERTYVAL *vals, ULONG count, ULONG pos, IEnumTfPropertyValue **out)
+{
+    ValEnum *e = calloc(1, sizeof(*e));
+    ULONG i;
+
+    if (!e) return E_OUTOFMEMORY;
+    if (count && !(e->vals = calloc(count, sizeof(*vals))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        e->vals[i].guidId = vals[i].guidId;
+        VariantInit(&e->vals[i].varValue);
+        VariantCopy(&e->vals[i].varValue, (VARIANT *)&vals[i].varValue);
+    }
+    e->IEnumTfPropertyValue_iface.lpVtbl = &ValEnumVtbl;
+    e->count = count;
+    e->pos = pos;
+    e->ref = 1;
+    *out = &e->IEnumTfPropertyValue_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI ValEnum_Clone(IEnumTfPropertyValue *iface, IEnumTfPropertyValue **out)
+{
+    ValEnum *This = impl_from_ValEnum(iface);
+
+    if (!out) return E_INVALIDARG;
+    return valenum_create(This->vals, This->count, This->pos, out);
+}
+
+static HRESULT WINAPI ValEnum_Next(IEnumTfPropertyValue *iface, ULONG count, TF_PROPERTYVAL *vals, ULONG *fetched)
+{
+    ValEnum *This = impl_from_ValEnum(iface);
+    ULONG n = 0;
+
+    if (!vals || (!fetched && count != 1)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        vals[n].guidId = This->vals[This->pos].guidId;
+        VariantInit(&vals[n].varValue);
+        VariantCopy(&vals[n].varValue, &This->vals[This->pos].varValue);
+        This->pos++;
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI ValEnum_Reset(IEnumTfPropertyValue *iface)
+{
+    impl_from_ValEnum(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI ValEnum_Skip(IEnumTfPropertyValue *iface, ULONG count)
+{
+    ValEnum *This = impl_from_ValEnum(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const IEnumTfPropertyValueVtbl ValEnumVtbl =
+{
+    ValEnum_QueryInterface,
+    ValEnum_AddRef,
+    ValEnum_Release,
+    ValEnum_Clone,
+    ValEnum_Next,
+    ValEnum_Reset,
+    ValEnum_Skip
+};
+
+static HRESULT values_enum(TrackProp *This, TfEditCookie ec, ITfRange *range, IEnumTfPropertyValue **out)
+{
+    TF_PROPERTYVAL *vals;
+    ULONG i;
+    HRESULT hr;
+
+    if (!(vals = calloc(max(This->count, 1), sizeof(*vals)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        vals[i].guidId = This->guids[i];
+        VariantInit(&vals[i].varValue);
+        if (range && This->props[i]) ITfReadOnlyProperty_GetValue(This->props[i], ec, range, &vals[i].varValue);
+    }
+    hr = valenum_create(vals, This->count, 0, out);
+    for (i = 0; i < This->count; i++) VariantClear(&vals[i].varValue);
+    free(vals);
+    return hr;
+}
+
+static HRESULT WINAPI TrackProp_QueryInterface(ITfReadOnlyProperty *iface, REFIID riid, void **obj)
+{
+    TrackProp *This = impl_from_TrackProp(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITfReadOnlyProperty))
+    {
+        *obj = iface;
+        ITfReadOnlyProperty_AddRef(iface);
+        return S_OK;
+    }
+    if (IsEqualIID(riid, &IID_IEnumTfPropertyValue))
+        /* the values, before any range is given: all empty */
+        return values_enum(This, 0, NULL, (IEnumTfPropertyValue **)obj);
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI TrackProp_AddRef(ITfReadOnlyProperty *iface)
+{
+    return InterlockedIncrement(&impl_from_TrackProp(iface)->ref);
+}
+
+static ULONG WINAPI TrackProp_Release(ITfReadOnlyProperty *iface)
+{
+    TrackProp *This = impl_from_TrackProp(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++)
+            if (This->props[i]) ITfReadOnlyProperty_Release(This->props[i]);
+        ITfContext_Release(This->context);
+        free(This->props);
+        free(This->guids);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI TrackProp_GetType(ITfReadOnlyProperty *iface, GUID *guid)
+{
+    if (!guid) return E_INVALIDARG;
+    *guid = GUID_NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI TrackProp_GetValue(ITfReadOnlyProperty *iface, TfEditCookie ec, ITfRange *range, VARIANT *value)
+{
+    TrackProp *This = impl_from_TrackProp(iface);
+    IEnumTfPropertyValue *e;
+    HRESULT hr;
+
+    TRACE("(%p) %li %p %p\n", This, ec, range, value);
+
+    if (!value || !range) return E_INVALIDARG;
+    VariantInit(value);
+    if (FAILED(hr = Context_CheckCookie(This->context, ec, FALSE))) return hr;
+    if (FAILED(hr = values_enum(This, ec, range, &e))) return hr;
+    V_VT(value) = VT_UNKNOWN;
+    V_UNKNOWN(value) = (IUnknown *)e;
+    return S_OK;
+}
+
+static HRESULT WINAPI TrackProp_GetContext(ITfReadOnlyProperty *iface, ITfContext **context)
+{
+    TrackProp *This = impl_from_TrackProp(iface);
+
+    if (!context) return E_INVALIDARG;
+    *context = This->context;
+    ITfContext_AddRef(*context);
+    return S_OK;
+}
+
+static int cmp_long(const void *a, const void *b)
+{
+    LONG x = *(const LONG *)a, y = *(const LONG *)b;
+    return x < y ? -1 : x > y;
+}
+
+static HRESULT WINAPI TrackProp_EnumRanges(ITfReadOnlyProperty *iface, TfEditCookie ec, IEnumTfRanges **ret,
+        ITfRange *target)
+{
+    TrackProp *This = impl_from_TrackProp(iface);
+    LONG *points = NULL, lo = LONG_MIN, hi = LONG_MAX;
+    ULONG npoints = 0, cap = 0, i, j, count = 0;
+    ITfRange **ranges = NULL;
+    HRESULT hr;
+
+    TRACE("(%p) %li %p %p\n", This, ec, ret, target);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (FAILED(hr = Context_CheckCookie(This->context, ec, FALSE))) return hr;
+    if (target)
+    {
+        LONG a, b;
+        if (FAILED(Range_GetAnchors(target, &a, &b))) return E_INVALIDARG;
+        lo = min(a, b);
+        hi = max(a, b);
+    }
+
+    /* every place where one of the properties starts or stops having a value */
+    for (i = 0; i < This->count && SUCCEEDED(hr = S_OK); i++)
+    {
+        IEnumTfRanges *e;
+        ITfRange *r;
+        ULONG fetched;
+
+        if (!This->props[i]) continue;
+        if (FAILED(ITfReadOnlyProperty_EnumRanges(This->props[i], ec, &e, target))) continue;
+        while (IEnumTfRanges_Next(e, 1, &r, &fetched) == S_OK)
+        {
+            LONG a, b, pt[2];
+
+            if (SUCCEEDED(Range_GetAnchors(r, &a, &b)))
+            {
+                pt[0] = min(a, b);
+                pt[1] = max(a, b);
+                for (j = 0; j < 2; j++)
+                {
+                    if (pt[j] < lo || pt[j] > hi) continue;
+                    if (npoints == cap)
+                    {
+                        LONG *n = realloc(points, (cap ? cap * 2 : 8) * sizeof(*points));
+                        if (!n) break;
+                        points = n;
+                        cap = cap ? cap * 2 : 8;
+                    }
+                    points[npoints++] = pt[j];
+                }
+            }
+            ITfRange_Release(r);
+        }
+        IEnumTfRanges_Release(e);
+    }
+    qsort(points, npoints, sizeof(*points), cmp_long);
+
+    hr = S_OK;
+    if (npoints > 1 && !(ranges = calloc(npoints, sizeof(*ranges)))) hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i + 1 < npoints; i++)
+    {
+        ITfRange *seg;
+        BOOL any = FALSE;
+
+        if (points[i] == points[i + 1]) continue;
+        if (FAILED(hr = Range_Constructor(This->context, points[i], points[i + 1], &seg))) break;
+        for (j = 0; j < This->count && !any; j++)
+        {
+            VARIANT v;
+
+            if (!This->props[j]) continue;
+            VariantInit(&v);
+            if (SUCCEEDED(ITfReadOnlyProperty_GetValue(This->props[j], ec, seg, &v)) && V_VT(&v) != VT_EMPTY)
+                any = TRUE;
+            VariantClear(&v);
+        }
+        if (any) ranges[count++] = seg;
+        else ITfRange_Release(seg);
+    }
+#ifdef SG_MUTANT_MSCTFB1_TRACK
+    count = 0;
+#endif
+    if (SUCCEEDED(hr)) hr = PropRanges_Create(ranges, count, ret);
+    for (i = 0; i < count; i++) ITfRange_Release(ranges[i]);
+    free(ranges);
+    free(points);
+    return hr;
+}
+
+static const ITfReadOnlyPropertyVtbl TrackPropVtbl =
+{
+    TrackProp_QueryInterface,
+    TrackProp_AddRef,
+    TrackProp_Release,
+    TrackProp_GetType,
+    TrackProp_EnumRanges,
+    TrackProp_GetValue,
+    TrackProp_GetContext
+};
+
+HRESULT TrackProperty_Create(ITfContext *context, const GUID **props, ULONG nprops, const GUID **appprops,
+        ULONG napp, ITfReadOnlyProperty **ret)
+{
+    TrackProp *p;
+    ULONG i;
+    HRESULT hr = S_OK;
+
+    if (!(p = calloc(1, sizeof(*p)))) return E_OUTOFMEMORY;
+    p->ITfReadOnlyProperty_iface.lpVtbl = &TrackPropVtbl;
+    p->ref = 1;
+    p->context = context;
+    ITfContext_AddRef(context);
+    p->count = nprops + napp;
+    p->props = calloc(max(p->count, 1), sizeof(*p->props));
+    p->guids = calloc(max(p->count, 1), sizeof(*p->guids));
+    if (!p->props || !p->guids)
+    {
+        TrackProp_Release(&p->ITfReadOnlyProperty_iface);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < nprops && SUCCEEDED(hr); i++)
+    {
+        ITfProperty *prop;
+
+        p->guids[i] = *props[i];
+        if (SUCCEEDED(hr = ITfContext_GetProperty(context, props[i], &prop)))
+        {
+            p->props[i] = (ITfReadOnlyProperty *)prop;
+        }
+    }
+    for (i = 0; i < napp && SUCCEEDED(hr); i++)
+    {
+        p->guids[nprops + i] = *appprops[i];
+        hr = ITfContext_GetAppProperty(context, appprops[i], &p->props[nprops + i]);
+        if (hr == S_FALSE || hr == E_NOTIMPL) hr = S_OK;    /* the owner does not have it: always empty */
+    }
+    if (FAILED(hr))
+    {
+        TrackProp_Release(&p->ITfReadOnlyProperty_iface);
+        return hr;
+    }
+    *ret = &p->ITfReadOnlyProperty_iface;
+    return S_OK;
+}
