+/* IEnumTfProperties over the properties the context has made so far */
+typedef struct
+{
+    IEnumTfProperties IEnumTfProperties_iface;
+    LONG ref;
+    ITfProperty **props;
+    ULONG count, pos;
+} PropsEnum;
+
+static inline PropsEnum *impl_from_IEnumTfProperties(IEnumTfProperties *iface)
+{
+    return CONTAINING_RECORD(iface, PropsEnum, IEnumTfProperties_iface);
+}
+
+static HRESULT WINAPI PropsEnum_QueryInterface(IEnumTfProperties *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumTfProperties))
+    {
+        *ppv = iface;
+        IEnumTfProperties_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI PropsEnum_AddRef(IEnumTfProperties *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumTfProperties(iface)->ref);
+}
+
+static ULONG WINAPI PropsEnum_Release(IEnumTfProperties *iface)
+{
+    PropsEnum *This = impl_from_IEnumTfProperties(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    ULONG i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) ITfProperty_Release(This->props[i]);
+        free(This->props);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT PropsEnum_Create(ITfProperty **props, ULONG count, ULONG pos, IEnumTfProperties **ret);
+
+static HRESULT WINAPI PropsEnum_Clone(IEnumTfProperties *iface, IEnumTfProperties **ret)
+{
+    PropsEnum *This = impl_from_IEnumTfProperties(iface);
+
+    if (!ret) return E_INVALIDARG;
+    return PropsEnum_Create(This->props, This->count, This->pos, ret);
+}
+
+static HRESULT WINAPI PropsEnum_Next(IEnumTfProperties *iface, ULONG count, ITfProperty **props, ULONG *fetched)
+{
+    PropsEnum *This = impl_from_IEnumTfProperties(iface);
+    ULONG n = 0;
+
+    if (!props || (!fetched && count != 1)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        props[n] = This->props[This->pos++];
+        ITfProperty_AddRef(props[n++]);
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI PropsEnum_Reset(IEnumTfProperties *iface)
+{
+    impl_from_IEnumTfProperties(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI PropsEnum_Skip(IEnumTfProperties *iface, ULONG count)
+{
+    PropsEnum *This = impl_from_IEnumTfProperties(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const IEnumTfPropertiesVtbl PropsEnumVtbl =
+{
+    PropsEnum_QueryInterface,
+    PropsEnum_AddRef,
+    PropsEnum_Release,
+    PropsEnum_Clone,
+    PropsEnum_Next,
+    PropsEnum_Reset,
+    PropsEnum_Skip
+};
+
+static HRESULT PropsEnum_Create(ITfProperty **props, ULONG count, ULONG pos, IEnumTfProperties **ret)
+{
+    PropsEnum *e = calloc(1, sizeof(*e));
+    ULONG i;
+
+    if (!e) return E_OUTOFMEMORY;
+    if (count && !(e->props = calloc(count, sizeof(*props))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumTfProperties_iface.lpVtbl = &PropsEnumVtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        e->props[i] = props[i];
+        ITfProperty_AddRef(props[i]);
+    }
+    *ret = &e->IEnumTfProperties_iface;
+    return S_OK;
+}
+
+HRESULT Property_EnumAll(struct list *properties, IEnumTfProperties **ret)
+{
+    ITfProperty **props = NULL;
+    ULONG count = 0;
+    Property *p;
+    HRESULT hr;
+
+    LIST_FOR_EACH_ENTRY(p, properties, Property, entry) count++;
+    if (count && !(props = calloc(count, sizeof(*props)))) return E_OUTOFMEMORY;
+    count = 0;
+    LIST_FOR_EACH_ENTRY(p, properties, Property, entry) props[count++] = &p->ITfProperty_iface;
+    hr = PropsEnum_Create(props, count, 0, ret);
+    free(props);
+    return hr;
+}
+
+/* ---- persistence (ITextStoreACPServices::Serialize / Unserialize) ----
+ * The stream holds one VARIANT: a 16 bit type then the value. The data format
+ * belongs to the text service's property in Windows; this one is ours. */
+
+static HRESULT write_variant(IStream *stream, const VARIANT *v, ULONG *cb)
+{
+    WORD vt = V_VT(v);
+    const void *data = NULL;
+    ULONG size = 0, written;
+    BSTR bstr;
+    HRESULT hr;
+    UINT len;
+
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1: data = &V_UI1(v); size = 1; break;
+    case VT_I2: case VT_UI2: case VT_BOOL: data = &V_UI2(v); size = 2; break;
+    case VT_I4: case VT_UI4: case VT_INT: case VT_UINT: case VT_R4: case VT_ERROR:
+        data = &V_UI4(v); size = 4; break;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_CY: case VT_DATE: data = &V_UI8(v); size = 8; break;
+    case VT_BSTR: break;
+    default: return S_FALSE;
+    }
+    if (FAILED(hr = IStream_Write(stream, &vt, sizeof(vt), &written))) return hr;
+    *cb = sizeof(vt);
+    if (vt == VT_BSTR)
+    {
+        bstr = V_BSTR(v);
+        len = SysStringLen(bstr);
+        if (FAILED(hr = IStream_Write(stream, &len, sizeof(len), &written))) return hr;
+        if (len && FAILED(hr = IStream_Write(stream, bstr, len * sizeof(WCHAR), &written))) return hr;
+        *cb += sizeof(len) + len * sizeof(WCHAR);
+        return S_OK;
+    }
+    if (FAILED(hr = IStream_Write(stream, data, size, &written))) return hr;
+    *cb += size;
+    return S_OK;
+}
+
+static HRESULT read_variant(IStream *stream, ULONG cb, VARIANT *v)
+{
+    WORD vt;
+    ULONG got, size = 0;
+    HRESULT hr;
+
+    VariantInit(v);
+    if (cb < sizeof(vt)) return E_FAIL;
+    if (FAILED(hr = IStream_Read(stream, &vt, sizeof(vt), &got)) || got != sizeof(vt)) return E_FAIL;
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1: size = 1; break;
+    case VT_I2: case VT_UI2: case VT_BOOL: size = 2; break;
+    case VT_I4: case VT_UI4: case VT_INT: case VT_UINT: case VT_R4: case VT_ERROR: size = 4; break;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_CY: case VT_DATE: size = 8; break;
+    case VT_BSTR: break;
+    default: return E_FAIL;
+    }
+    if (vt == VT_BSTR)
+    {
+        UINT len;
+        BSTR b;
+
+        if (cb < sizeof(vt) + sizeof(len)) return E_FAIL;
+        if (FAILED(IStream_Read(stream, &len, sizeof(len), &got)) || got != sizeof(len)) return E_FAIL;
+        if (cb != sizeof(vt) + sizeof(len) + len * sizeof(WCHAR)) return E_FAIL;
+        if (!(b = SysAllocStringLen(NULL, len))) return E_OUTOFMEMORY;
+        if (len && (FAILED(IStream_Read(stream, b, len * sizeof(WCHAR), &got)) || got != len * sizeof(WCHAR)))
+        {
+            SysFreeString(b);
+            return E_FAIL;
+        }
+        V_VT(v) = VT_BSTR;
+        V_BSTR(v) = b;
+        return S_OK;
+    }
+    if (cb != sizeof(vt) + size) return E_FAIL;
+    V_VT(v) = vt;
+    if (FAILED(IStream_Read(stream, &V_UI8(v), size, &got)) || got != size)
+    {
+        V_VT(v) = VT_EMPTY;
+        return E_FAIL;
+    }
+    return S_OK;
+}
+
+static Property *property_from(ITfProperty *iface)
+{
+    return iface && iface->lpVtbl == &PropertyVtbl ? impl_from_ITfProperty(iface) : NULL;
+}
+
+HRESULT Property_Serialize(ITfProperty *prop, ITfRange *range, TF_PERSISTENT_PROPERTY_HEADER_ACP *hdr,
+        IStream *stream)
+{
+    Property *This = property_from(prop);
+    LONG start, end;
+    VARIANT v;
+    ULONG cb = 0;
+    HRESULT hr;
+
+    if (!This || !range || !hdr || !stream) return E_FAIL;
+    if (FAILED(range_extent(range, &start, &end))) return E_FAIL;
+    load_pending(This);
+    VariantInit(&v);
+    if (FAILED(hr = Property_GetValue(&This->ITfProperty_iface, 0, range, &v))) return E_FAIL;
+    if (V_VT(&v) == VT_EMPTY) return S_FALSE;
+    hr = write_variant(stream, &v, &cb);
+    VariantClear(&v);
+    if (hr != S_OK) return hr == S_FALSE ? S_FALSE : E_FAIL;
+    memset(hdr, 0, sizeof(*hdr));
+    hdr->guidType = This->guid;
+    hdr->ichStart = start;
+    hdr->cch = end - start;
+#ifdef SG_MUTANT_MSCTFB1_SERIAL
+    hdr->cb = 0;
+#else
+    hdr->cb = cb;
+#endif
+    return S_OK;
+}
+
+static HRESULT apply_header(Property *This, const TF_PERSISTENT_PROPERTY_HEADER_ACP *hdr, IStream *stream)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    if (FAILED(hr = read_variant(stream, hdr->cb, &v))) return hr;
+    hr = add_span(This, hdr->ichStart, hdr->ichStart + hdr->cch, &v);
+    VariantClear(&v);
+    return hr;
+}
+
+static void load_pending(Property *This)
+{
+    struct pending_load *pl, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(pl, next, &This->pending, struct pending_load, entry)
+    {
+        IStream *stream = NULL;
+
+        list_remove(&pl->entry);
+        if (SUCCEEDED(ITfPersistentPropertyLoaderACP_LoadProperty(pl->loader, &pl->hdr, &stream)) && stream)
+        {
+            apply_header(This, &pl->hdr, stream);
+            IStream_Release(stream);
+        }
+        ITfPersistentPropertyLoaderACP_Release(pl->loader);
+        free(pl);
+    }
+}
+
+HRESULT Property_Unserialize(ITfProperty *prop, const TF_PERSISTENT_PROPERTY_HEADER_ACP *hdr, IStream *stream,
+        ITfPersistentPropertyLoaderACP *loader)
+{
+    Property *This = property_from(prop);
+    struct pending_load *pl;
+
+    if (!This || !hdr || (!stream && !loader)) return E_FAIL;
+    if (!IsEqualGUID(&hdr->guidType, &This->guid)) return E_FAIL;
+    if (loader)
+    {
+        /* the data is fetched when the property is next used */
+        if (!(pl = calloc(1, sizeof(*pl)))) return E_OUTOFMEMORY;
+        pl->hdr = *hdr;
+        pl->loader = loader;
+        ITfPersistentPropertyLoaderACP_AddRef(loader);
+        list_add_tail(&This->pending, &pl->entry);
+        return TS_S_ASYNC;
+    }
+    return apply_header(This, hdr, stream);
+}
+
+HRESULT Property_ForceLoad(ITfProperty *prop)
+{
+    Property *This = property_from(prop);
+
+    if (!This) return E_FAIL;
+#ifndef SG_MUTANT_MSCTFB1_FORCELOAD
+    load_pending(This);
+#endif
+    return S_OK;
+}
