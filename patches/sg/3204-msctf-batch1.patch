+static HRESULT WINAPI CompositionView_QueryInterface(ITfCompositionView *iface, REFIID riid, void **obj)
+{
+    return comp_qi(impl_from_ITfCompositionView(iface), riid, obj);
+}
+
+static ULONG WINAPI CompositionView_AddRef(ITfCompositionView *iface)
+{
+    return InterlockedIncrement(&impl_from_ITfCompositionView(iface)->ref);
+}
+
+static ULONG WINAPI CompositionView_Release(ITfCompositionView *iface)
+{
+    return comp_release(impl_from_ITfCompositionView(iface));
+}
+
+static HRESULT WINAPI CompositionView_GetOwnerClsid(ITfCompositionView *iface, CLSID *clsid)
+{
+    struct composition *This = impl_from_ITfCompositionView(iface);
+
+    TRACE("(%p) %p\n", This, clsid);
+
+    if (!clsid) return E_INVALIDARG;
+    if (!This->set) return E_UNEXPECTED;
+    *clsid = This->owner;
+    return S_OK;
+}
+
+static HRESULT WINAPI CompositionView_GetRange(ITfCompositionView *iface, ITfRange **range)
+{
+    struct composition *This = impl_from_ITfCompositionView(iface);
+
+    TRACE("(%p) %p\n", This, range);
+    return comp_range(This, range);
+}
+
+static const ITfCompositionViewVtbl CompositionViewVtbl =
+{
+    CompositionView_QueryInterface,
+    CompositionView_AddRef,
+    CompositionView_Release,
+    CompositionView_GetOwnerClsid,
+    CompositionView_GetRange
+};
+
+/* the compositions of one context */
+struct composition_set
+{
+    struct list list;
+    ITfContextOwnerCompositionSink *(*owner_sink)(void *ctx);
+    void *ctx;
+    ITfContext *context;
+    BOOL busy;      /* inside a composition operation */
+};
+
+static void owner_update(struct composition *This, ITfRange *range)
+{
+    ITfContextOwnerCompositionSink *owner;
+
+    if (!This->set || !(owner = This->set->owner_sink(This->set->ctx))) return;
+    ITfContextOwnerCompositionSink_OnUpdateComposition(owner, &This->ITfCompositionView_iface, range);
+}
+
+static void terminate(struct composition *This, TfEditCookie ec, BOOL notify_sink)
+{
+    struct composition_set *set = This->set;
+    ITfContextOwnerCompositionSink *owner;
+
+    if (!set) return;
+    This->set = NULL;
+    list_remove(&This->entry);
+#ifndef SG_MUTANT_MSCTFB1_COMPEND
+    if (notify_sink && This->sink)
+#endif
+        ITfCompositionSink_OnCompositionTerminated(This->sink, ec, &This->ITfComposition_iface);
+    /* the sink is released when the composition ends */
+    if (This->sink)
+    {
+        ITfCompositionSink_Release(This->sink);
+        This->sink = NULL;
+    }
+    if ((owner = set->owner_sink(set->ctx)))
+        ITfContextOwnerCompositionSink_OnEndComposition(owner, &This->ITfCompositionView_iface);
+    comp_release(This);     /* the set's reference */
+}
+
+struct composition_set *CompositionSet_Create(ITfContext *context,
+        ITfContextOwnerCompositionSink *(*owner_sink)(void *ctx), void *ctx)
+{
+    struct composition_set *set = calloc(1, sizeof(*set));
+
+    if (!set) return NULL;
+    list_init(&set->list);
+    set->owner_sink = owner_sink;
+    set->ctx = ctx;
+    set->context = context;
+    return set;
+}
+
+void CompositionSet_Free(struct composition_set *set)
+{
+    struct composition *c, *next;
+
+    if (!set) return;
+    LIST_FOR_EACH_ENTRY_SAFE(c, next, &set->list, struct composition, entry)
+    {
+        list_remove(&c->entry);
+        c->set = NULL;
+        c->context = NULL;
+        comp_release(c);
+    }
+    free(set);
+}
+
+HRESULT CompositionSet_Start(struct composition_set *set, TfClientId tid, TfEditCookie ec, ITfRange *range,
+        ITfCompositionSink *sink, ITfComposition **out)
+{
+    ITfContextOwnerCompositionSink *owner;
+    struct composition *c;
+    LONG a, b;
+    BOOL ok = TRUE;
+    HRESULT hr;
+
+    if (!out || !range) return E_INVALIDARG;
+    *out = NULL;
+    if (set->busy) return E_UNEXPECTED;
+#ifndef SG_MUTANT_MSCTFB1_COMPLOCK
+    if (FAILED(hr = Context_CheckCookie(set->context, ec, TRUE))) return hr;
+#endif
+    if (FAILED(Range_GetAnchors(range, &a, &b))) return E_INVALIDARG;
+    if (!(c = calloc(1, sizeof(*c)))) return E_OUTOFMEMORY;
+    c->ITfComposition_iface.lpVtbl = &CompositionVtbl;
+    c->ITfCompositionView_iface.lpVtbl = &CompositionViewVtbl;
+    c->ref = 2;                         /* the set's and the caller's */
+    c->set = set;
+    c->context = set->context;
+    c->owner = get_textservice_clsid(tid);
+    c->start = min(a, b);
+    c->end = max(a, b);
+    if (sink)
+    {
+        c->sink = sink;
+        ITfCompositionSink_AddRef(sink);
+    }
+
+    if ((owner = set->owner_sink(set->ctx)))
+    {
+        set->busy = TRUE;
+        hr = ITfContextOwnerCompositionSink_OnStartComposition(owner, &c->ITfCompositionView_iface, &ok);
+        set->busy = FALSE;
+        if (FAILED(hr)) ok = FALSE;
+    }
+    if (!ok)
+    {
+        /* the context owner refused: S_OK with no composition */
+        c->set = NULL;
+        comp_release(c);
+        comp_release(c);
+        return S_OK;
+    }
+    list_add_tail(&set->list, &c->entry);
+    *out = &c->ITfComposition_iface;
+    return S_OK;
+}
+
+/* views enumeration (a snapshot) */
+typedef struct
+{
+    IEnumITfCompositionView IEnumITfCompositionView_iface;
+    LONG ref;
+    ITfCompositionView **views;
+    ULONG count, pos;
+} EnumViews;
+
+static inline EnumViews *impl_from_IEnumITfCompositionView(IEnumITfCompositionView *iface)
+{
+    return CONTAINING_RECORD(iface, EnumViews, IEnumITfCompositionView_iface);
+}
+
+static HRESULT WINAPI EnumViews_QueryInterface(IEnumITfCompositionView *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumITfCompositionView))
+    {
+        *obj = iface;
+        IEnumITfCompositionView_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumViews_AddRef(IEnumITfCompositionView *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumITfCompositionView(iface)->ref);
+}
+
+static ULONG WINAPI EnumViews_Release(IEnumITfCompositionView *iface)
+{
+    EnumViews *This = impl_from_IEnumITfCompositionView(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) ITfCompositionView_Release(This->views[i]);
+        free(This->views);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT enum_views_create(ITfCompositionView **views, ULONG count, ULONG pos, IEnumITfCompositionView **out);
+
+static HRESULT WINAPI EnumViews_Clone(IEnumITfCompositionView *iface, IEnumITfCompositionView **out)
+{
+    EnumViews *This = impl_from_IEnumITfCompositionView(iface);
+
+    if (!out) return E_INVALIDARG;
+    return enum_views_create(This->views, This->count, This->pos, out);
+}
+
+static HRESULT WINAPI EnumViews_Next(IEnumITfCompositionView *iface, ULONG count, ITfCompositionView **views,
+        ULONG *fetched)
+{
+    EnumViews *This = impl_from_IEnumITfCompositionView(iface);
+    ULONG n = 0;
+
+    if (!views || (!fetched && count != 1)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        views[n] = This->views[This->pos++];
+        ITfCompositionView_AddRef(views[n++]);
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumViews_Reset(IEnumITfCompositionView *iface)
+{
+    impl_from_IEnumITfCompositionView(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumViews_Skip(IEnumITfCompositionView *iface, ULONG count)
+{
+    EnumViews *This = impl_from_IEnumITfCompositionView(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const IEnumITfCompositionViewVtbl EnumViewsVtbl =
+{
+    EnumViews_QueryInterface,
+    EnumViews_AddRef,
+    EnumViews_Release,
+    EnumViews_Clone,
+    EnumViews_Next,
+    EnumViews_Reset,
+    EnumViews_Skip
+};
+
+static HRESULT enum_views_create(ITfCompositionView **views, ULONG count, ULONG pos, IEnumITfCompositionView **out)
+{
+    EnumViews *e = calloc(1, sizeof(*e));
+    ULONG i;
+
+    if (!e) return E_OUTOFMEMORY;
+    if (count && !(e->views = calloc(count, sizeof(*views))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        e->views[i] = views[i];
+        ITfCompositionView_AddRef(views[i]);
+    }
+    e->IEnumITfCompositionView_iface.lpVtbl = &EnumViewsVtbl;
+    e->ref = 1;
+    e->count = count;
+    e->pos = pos;
+    *out = &e->IEnumITfCompositionView_iface;
+    return S_OK;
+}
+
+/* the compositions that intersect [start, end], or all with test == NULL */
+HRESULT CompositionSet_Enum(struct composition_set *set, ITfRange *test, IEnumITfCompositionView **out)
+{
+    ITfCompositionView **views = NULL;
+    struct composition *c;
+    ULONG count = 0;
+    LONG a = 0, b = 0;
+    HRESULT hr;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (test)
+    {
+        if (FAILED(Range_GetAnchors(test, &a, &b))) return E_INVALIDARG;
+        if (a > b) { LONG t = a; a = b; b = t; }
+    }
+    LIST_FOR_EACH_ENTRY(c, &set->list, struct composition, entry) count++;
+    if (count && !(views = calloc(count, sizeof(*views)))) return E_OUTOFMEMORY;
+    count = 0;
+    LIST_FOR_EACH_ENTRY(c, &set->list, struct composition, entry)
+    {
+        if (test
+#ifdef SG_MUTANT_MSCTFB1_COMPFIND
+            && 0
+#endif
+           )
+        {
+            BOOL match;
+
+            if (a == b) match = c->start <= a && a <= c->end;
+            else if (c->start == c->end) match = a <= c->start && c->start <= b;
+            else match = c->start < b && a < c->end;
+            if (!match) continue;
+        }
+        views[count++] = &c->ITfCompositionView_iface;
+    }
+    hr = enum_views_create(views, count, 0, out);
+    free(views);
+    return hr;
+}
+
+/* ends the composition (NULL view: all of them) under the caller's write lock */
+HRESULT CompositionSet_Terminate(struct composition_set *set, ITfCompositionView *view, TfEditCookie ec)
+{
+    struct composition *c, *next;
+    struct composition *only = NULL;
+
+    if (view)
+    {
+        LIST_FOR_EACH_ENTRY(c, &set->list, struct composition, entry)
+            if (&c->ITfCompositionView_iface == view)
+            {
+                only = c;
+                break;
+            }
+        if (!only)
+        {
+            /* a view from this implementation that already ended is fine; others are not ours */
+            if (view->lpVtbl != &CompositionViewVtbl) return E_INVALIDARG;
+            return S_OK;
+        }
+    }
+    if (set->busy) return E_UNEXPECTED;
+    set->busy = TRUE;
+    LIST_FOR_EACH_ENTRY_SAFE(c, next, &set->list, struct composition, entry)
+    {
+        if (only && c != only) continue;
+        InterlockedIncrement(&c->ref);      /* keep c alive across the callbacks */
+        terminate(c, ec, TRUE);
+        comp_release(c);
+    }
+    set->busy = FALSE;
+    return S_OK;
+}
