+
+/* A composition is a span of a context's text that a text service marks as
+ * still changing. The context keeps the list of live compositions
+ * (ITfContextComposition / ITfContextOwnerCompositionServices); a text service
+ * holds the ITfComposition, the context owner and enumerations the
+ * ITfCompositionView. The span keeps character positions (like ranges in this
+ * implementation). The GUID_PROP_COMPOSING property is not set on the text:
+ * the property's identifier is not published in a source we may use. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "objbase.h"
+
+#include "msctf.h"
+#include "msctf_internal.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msctf);
+
+struct composition
+{
+    ITfComposition ITfComposition_iface;
+    ITfCompositionView ITfCompositionView_iface;
+    LONG ref;
+    struct list entry;
+    struct composition_set *set;    /* NULL once terminated */
+    ITfContext *context;            /* not held */
+    ITfCompositionSink *sink;
+    CLSID owner;
+    LONG start, end;
+};
+
+static inline struct composition *impl_from_ITfComposition(ITfComposition *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition, ITfComposition_iface);
+}
+
+static inline struct composition *impl_from_ITfCompositionView(ITfCompositionView *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition, ITfCompositionView_iface);
+}
+
+static HRESULT comp_qi(struct composition *This, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITfComposition))
+        *obj = &This->ITfComposition_iface;
+    else if (IsEqualIID(riid, &IID_ITfCompositionView))
+        *obj = &This->ITfCompositionView_iface;
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&This->ref);
+    return S_OK;
+}
+
+static ULONG comp_release(struct composition *This)
+{
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        if (This->sink) ITfCompositionSink_Release(This->sink);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI Composition_QueryInterface(ITfComposition *iface, REFIID riid, void **obj)
+{
+    return comp_qi(impl_from_ITfComposition(iface), riid, obj);
+}
+
+static ULONG WINAPI Composition_AddRef(ITfComposition *iface)
+{
+    return InterlockedIncrement(&impl_from_ITfComposition(iface)->ref);
+}
+
+static ULONG WINAPI Composition_Release(ITfComposition *iface)
+{
+    return comp_release(impl_from_ITfComposition(iface));
+}
+
+static HRESULT comp_range(struct composition *This, ITfRange **range)
+{
+    if (!range) return E_INVALIDARG;
+    *range = NULL;
+    if (!This->set) return E_UNEXPECTED;
+    return Range_Constructor(This->context, This->start, This->end, range);
+}
+
+static HRESULT WINAPI Composition_GetRange(ITfComposition *iface, ITfRange **range)
+{
+    struct composition *This = impl_from_ITfComposition(iface);
+
+    TRACE("(%p) %p\n", This, range);
+    return comp_range(This, range);
+}
+
+static void owner_update(struct composition *This, ITfRange *range);
+
+static HRESULT shift_anchor(struct composition *This, TfEditCookie ec, ITfRange *range, BOOL start)
+{
+    LONG a, b, lo, hi;
+    HRESULT hr;
+
+    if (!range) return E_INVALIDARG;
+    if (!This->set) return E_UNEXPECTED;
+    if (FAILED(hr = Context_CheckCookie(This->context, ec, TRUE))) return hr;
+    if (FAILED(Range_GetAnchors(range, &a, &b))) return E_INVALIDARG;
+    lo = min(a, b);
+    hi = max(a, b);
+    if (start)
+    {
+        /* the new start is the start anchor of the range; it may not pass the end */
+        if (lo > This->end) return E_INVALIDARG;
+        This->start = lo;
+    }
+    else
+    {
+        /* the new end is the end anchor of the range; it may not pass before the start */
+        if (hi < This->start) return E_INVALIDARG;
+        This->end = hi;
+    }
+    owner_update(This, range);
+    return S_OK;
+}
+
+static HRESULT WINAPI Composition_ShiftStart(ITfComposition *iface, TfEditCookie ec, ITfRange *range)
+{
+    struct composition *This = impl_from_ITfComposition(iface);
+
+    TRACE("(%p) %li %p\n", This, ec, range);
+    return shift_anchor(This, ec, range, TRUE);
+}
+
+static HRESULT WINAPI Composition_ShiftEnd(ITfComposition *iface, TfEditCookie ec, ITfRange *range)
+{
+    struct composition *This = impl_from_ITfComposition(iface);
+
+    TRACE("(%p) %li %p\n", This, ec, range);
+    return shift_anchor(This, ec, range, FALSE);
+}
+
+static void terminate(struct composition *This, TfEditCookie ec, BOOL notify_sink);
+
+static HRESULT WINAPI Composition_EndComposition(ITfComposition *iface, TfEditCookie ec)
+{
+    struct composition *This = impl_from_ITfComposition(iface);
+    HRESULT hr;
+
+    TRACE("(%p) %li\n", This, ec);
+
+    if (!This->set) return E_UNEXPECTED;
+    if (FAILED(hr = Context_CheckCookie(This->context, ec, TRUE))) return hr;
+    /* the text service ended it: no OnCompositionTerminated */
+    terminate(This, ec, FALSE);
+    return S_OK;
+}
