+/* ITfDocumentMgr::CreateContext accepts a NULL text store (or an object that
+ * only implements ITfContextOwnerCompositionSink): the context then keeps its
+ * own text, which a text service uses through ranges and edit sessions. The
+ * context here gets an ITextStoreACP that holds the text, one selection and
+ * the lock state, so every context call has one store to go through. The store
+ * has no window and no layout. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "wine/debug.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "objbase.h"
+#include "olectl.h"
+
+#include "msctf.h"
+#include "msctf_internal.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msctf);
+
+typedef struct
+{
+    ITextStoreACP ITextStoreACP_iface;
+    LONG ref;
+    WCHAR *text;
+    LONG len, cap;
+    TS_SELECTION_ACP sel;
+    ITextStoreACPSink *sink;
+    DWORD mask;
+    DWORD lock;            /* TS_LF_* of the lock held now, 0: none */
+    DWORD pending;         /* an asynchronous lock waiting for the current one */
+    DWORD status;
+} MemStore;
+
+static inline MemStore *impl_from_ITextStoreACP(ITextStoreACP *iface)
+{
+    return CONTAINING_RECORD(iface, MemStore, ITextStoreACP_iface);
+}
+
+static HRESULT WINAPI MemStore_QueryInterface(ITextStoreACP *iface, REFIID riid, void **obj)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITextStoreACP))
+    {
+        *obj = &This->ITextStoreACP_iface;
+        ITextStoreACP_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI MemStore_AddRef(ITextStoreACP *iface)
+{
+    return InterlockedIncrement(&impl_from_ITextStoreACP(iface)->ref);
+}
+
+static ULONG WINAPI MemStore_Release(ITextStoreACP *iface)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        if (This->sink) ITextStoreACPSink_Release(This->sink);
+        free(This->text);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI MemStore_AdviseSink(ITextStoreACP *iface, REFIID riid, IUnknown *punk, DWORD mask)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    ITextStoreACPSink *sink;
+
+    TRACE("(%p) %s %p %#lx\n", This, debugstr_guid(riid), punk, mask);
+
+    if (!riid || !punk) return E_INVALIDARG;
+    if (!IsEqualIID(riid, &IID_ITextStoreACPSink)) return E_INVALIDARG;
+    if (This->sink)
+    {
+        /* the same sink again only changes the mask; another one is refused */
+        IUnknown *a = NULL, *b = NULL;
+        BOOL same;
+
+        ITextStoreACPSink_QueryInterface(This->sink, &IID_IUnknown, (void **)&a);
+        IUnknown_QueryInterface(punk, &IID_IUnknown, (void **)&b);
+        same = a == b;
+        if (a) IUnknown_Release(a);
+        if (b) IUnknown_Release(b);
+        if (!same) return CONNECT_E_ADVISELIMIT;
+        This->mask = mask;
+        return S_OK;
+    }
+    if (FAILED(IUnknown_QueryInterface(punk, &IID_ITextStoreACPSink, (void **)&sink))) return E_NOINTERFACE;
+    This->sink = sink;
+    This->mask = mask;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_UnadviseSink(ITextStoreACP *iface, IUnknown *punk)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    IUnknown *a = NULL, *b = NULL;
+    BOOL same;
+
+    TRACE("(%p) %p\n", This, punk);
+
+    if (!punk) return E_INVALIDARG;
+    if (!This->sink) return CONNECT_E_NOCONNECTION;
+    ITextStoreACPSink_QueryInterface(This->sink, &IID_IUnknown, (void **)&a);
+    IUnknown_QueryInterface(punk, &IID_IUnknown, (void **)&b);
+    same = a == b;
+    if (a) IUnknown_Release(a);
+    if (b) IUnknown_Release(b);
+    if (!same) return CONNECT_E_NOCONNECTION;
+    ITextStoreACPSink_Release(This->sink);
+    This->sink = NULL;
+    This->mask = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_RequestLock(ITextStoreACP *iface, DWORD flags, HRESULT *phr)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    DWORD want;
+
+    TRACE("(%p) %#lx %p\n", This, flags, phr);
+
+    if (!phr) return E_INVALIDARG;
+    want = flags & TS_LF_READWRITE;
+    if (want != TS_LF_READ && want != TS_LF_READWRITE) return E_INVALIDARG;
+    if (!This->sink) return E_UNEXPECTED;
+
+    if (This->lock)
+    {
+        /* a lock is held: a synchronous request cannot wait, an asynchronous
+         * one is granted when the lock is given back */
+        if (flags & TS_LF_SYNC)
+        {
+            *phr = TS_E_SYNCHRONOUS;
+            return S_OK;
+        }
+        This->pending |= want;
+        *phr = TS_S_ASYNC;
+        return S_OK;
+    }
+
+    if ((want & 4) && (This->status & TS_SD_READONLY))
+    {
+        *phr = TS_E_READONLY;
+        return S_OK;
+    }
+
+    ITextStoreACP_AddRef(iface);
+    This->lock = want;
+    *phr = ITextStoreACPSink_OnLockGranted(This->sink, want);
+    This->lock = 0;
+    while (This->pending && This->sink)
+    {
+        DWORD next = This->pending;
+        This->pending = 0;
+        This->lock = next;
+        ITextStoreACPSink_OnLockGranted(This->sink, next);
+        This->lock = 0;
+    }
+    ITextStoreACP_Release(iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_GetStatus(ITextStoreACP *iface, TS_STATUS *status)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %p\n", This, status);
+
+    if (!status) return E_INVALIDARG;
+    status->dwDynamicFlags = This->status;
+    status->dwStaticFlags = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_QueryInsert(ITextStoreACP *iface, LONG start, LONG end, ULONG cch,
+        LONG *res_start, LONG *res_end)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %ld %ld %lu %p %p\n", This, start, end, cch, res_start, res_end);
+
+    if (!res_start || !res_end) return E_INVALIDARG;
+    if (start < 0 || start > end || end > This->len) return E_INVALIDARG;
+    *res_start = start;
+    *res_end = start + cch;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_GetSelection(ITextStoreACP *iface, ULONG index, ULONG count,
+        TS_SELECTION_ACP *sel, ULONG *fetched)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %lu %lu %p %p\n", This, index, count, sel, fetched);
+
+    if (!sel || !fetched) return E_INVALIDARG;
+    *fetched = 0;
+    if (!This->lock) return TS_E_NOLOCK;
+    if (index == TS_DEFAULT_SELECTION) index = 0;
+    if (index > 0) return TS_E_NOSELECTION;
+    if (count)
+    {
+        *sel = This->sel;
+        *fetched = 1;
+    }
+    return S_OK;
+}
+
+static void notify_text(MemStore *This, LONG start, LONG old_end, LONG new_end, DWORD flags)
+{
+    TS_TEXTCHANGE change = { start, old_end, new_end };
+
+    if (This->sink && (This->mask & TS_AS_TEXT_CHANGE))
+        ITextStoreACPSink_OnTextChange(This->sink, flags, &change);
+}
+
+static void notify_sel(MemStore *This)
+{
+    if (This->sink && (This->mask & TS_AS_SEL_CHANGE)) ITextStoreACPSink_OnSelectionChange(This->sink);
+}
+
+static HRESULT WINAPI MemStore_SetSelection(ITextStoreACP *iface, ULONG count, const TS_SELECTION_ACP *sel)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+
+    TRACE("(%p) %lu %p\n", This, count, sel);
+
+    if (!sel || count != 1) return E_INVALIDARG;
+    if ((This->lock & TS_LF_READWRITE) != TS_LF_READWRITE) return TS_E_NOLOCK;
+    if (sel->acpStart < 0 || sel->acpEnd < sel->acpStart || sel->acpEnd > This->len) return TS_E_INVALIDPOS;
+    This->sel = *sel;
+    notify_sel(This);
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_GetText(ITextStoreACP *iface, LONG start, LONG end, WCHAR *plain,
+        ULONG plain_req, ULONG *plain_ret, TS_RUNINFO *runs, ULONG runs_req, ULONG *runs_ret, LONG *next)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    ULONG n;
+
+    TRACE("(%p) %ld %ld %p %lu %p %p %lu %p %p\n", This, start, end, plain, plain_req, plain_ret,
+          runs, runs_req, runs_ret, next);
+
+    if (!plain_ret || !runs_ret || !next) return E_INVALIDARG;
+    *plain_ret = *runs_ret = 0;
+    if (!This->lock) return TS_E_NOLOCK;
+    if (end == -1) end = This->len;
+    if (start < 0 || start > This->len || end < start || end > This->len) return TS_E_INVALIDPOS;
+    n = end - start;
+    if (plain)
+    {
+        if (n > plain_req) n = plain_req;
+        memcpy(plain, This->text + start, n * sizeof(WCHAR));
+        *plain_ret = n;
+    }
+    else
+        n = min(n, plain_req);
+    if (runs && runs_req && n)
+    {
+        runs[0].uCount = n;
+        runs[0].type = TS_RT_PLAIN;
+        *runs_ret = 1;
+    }
+    *next = start + n;
+    return S_OK;
+}
+
+/* replaces [start, end) with the text; keeps the selection where it was,
+ * moved by the length change as a text store does for text before it */
+static HRESULT replace_text(MemStore *This, LONG start, LONG end, const WCHAR *text, ULONG cch, TS_TEXTCHANGE *change)
+{
+    LONG delta = (LONG)cch - (end - start);
+    WCHAR *n;
+
+    if (This->len + delta + 1 > This->cap)
+    {
+        LONG cap = max(This->len + delta + 1, This->cap * 2);
+        if (!(n = realloc(This->text, cap * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        This->text = n;
+        This->cap = cap;
+    }
+    memmove(This->text + start + cch, This->text + end, (This->len - end) * sizeof(WCHAR));
+    if (cch) memcpy(This->text + start, text, cch * sizeof(WCHAR));
+    This->len += delta;
+    This->text[This->len] = 0;
+
+    if (This->sel.acpStart >= end) This->sel.acpStart += delta;
+    else if (This->sel.acpStart > start) This->sel.acpStart = start + cch;
+    if (This->sel.acpEnd >= end) This->sel.acpEnd += delta;
+    else if (This->sel.acpEnd > start) This->sel.acpEnd = start + cch;
+
+    change->acpStart = start;
+    change->acpOldEnd = end;
+    change->acpNewEnd = start + cch;
+    return S_OK;
+}
+
+static HRESULT WINAPI MemStore_SetText(ITextStoreACP *iface, DWORD flags, LONG start, LONG end,
+        const WCHAR *text, ULONG cch, TS_TEXTCHANGE *change)
+{
+    MemStore *This = impl_from_ITextStoreACP(iface);
+    HRESULT hr;
+
+    TRACE("(%p) %#lx %ld %ld %s %lu %p\n", This, flags, start, end, debugstr_wn(text, cch), cch, change);
+
+    if (!change || (cch && !text)) return E_INVALIDARG;
+    if ((This->lock & TS_LF_READWRITE) != TS_LF_READWRITE) return TS_E_NOLOCK;
+    if (end == -1) end = This->len;
+    if (start < 0 || end < start || end > This->len) return TS_E_INVALIDPOS;
+    if (FAILED(hr = replace_text(This, start, end, text, cch, change))) return hr;
+    notify_text(This, change->acpStart, change->acpOldEnd, change->acpNewEnd, flags & TS_ST_CORRECTION);
+    return S_OK;
+}
+
+/* a data object with one Unicode text format, for formatted text */
+typedef struct
+{
+    IDataObject IDataObject_iface;
+    LONG ref;
+    WCHAR *text;
+    ULONG cch;
+} TextData;
+
+static inline TextData *impl_from_IDataObject(IDataObject *iface)
+{
+    return CONTAINING_RECORD(iface, TextData, IDataObject_iface);
+}
+
+typedef struct
+{
+    IEnumFORMATETC IEnumFORMATETC_iface;
+    LONG ref;
+    ULONG pos;
+} FmtEnum;
+
+static inline FmtEnum *impl_from_IEnumFORMATETC(IEnumFORMATETC *iface)
+{
+    return CONTAINING_RECORD(iface, FmtEnum, IEnumFORMATETC_iface);
+}
+
+static HRESULT WINAPI FmtEnum_QueryInterface(IEnumFORMATETC *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumFORMATETC))
+    {
+        *obj = iface;
+        IEnumFORMATETC_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI FmtEnum_AddRef(IEnumFORMATETC *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumFORMATETC(iface)->ref);
+}
+
+static ULONG WINAPI FmtEnum_Release(IEnumFORMATETC *iface)
+{
+    FmtEnum *This = impl_from_IEnumFORMATETC(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref) free(This);
+    return ref;
+}
+
+static void fill_format(FORMATETC *fe)
+{
+    fe->cfFormat = CF_UNICODETEXT;
+    fe->ptd = NULL;
+    fe->dwAspect = DVASPECT_CONTENT;
+    fe->lindex = -1;
+    fe->tymed = TYMED_HGLOBAL;
+}
+
+static HRESULT WINAPI FmtEnum_Next(IEnumFORMATETC *iface, ULONG count, FORMATETC *fe, ULONG *fetched)
+{
+    FmtEnum *This = impl_from_IEnumFORMATETC(iface);
+    ULONG n = 0;
+
+    if (!fe || (!fetched && count != 1)) return E_INVALIDARG;
+    if (count && This->pos == 0)
+    {
+        fill_format(fe);
+        This->pos = 1;
+        n = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI FmtEnum_Skip(IEnumFORMATETC *iface, ULONG count)
+{
+    FmtEnum *This = impl_from_IEnumFORMATETC(iface);
+    BOOL ok = This->pos + count <= 1;
+
+    This->pos = min(1, This->pos + count);
+    return ok ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI FmtEnum_Reset(IEnumFORMATETC *iface)
+{
+    impl_from_IEnumFORMATETC(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI FmtEnum_Clone(IEnumFORMATETC *iface, IEnumFORMATETC **out)
+{
+    FmtEnum *This = impl_from_IEnumFORMATETC(iface), *e;
+
+    if (!out) return E_INVALIDARG;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
+    e->IEnumFORMATETC_iface.lpVtbl = This->IEnumFORMATETC_iface.lpVtbl;
+    e->ref = 1;
+    e->pos = This->pos;
+    *out = &e->IEnumFORMATETC_iface;
+    return S_OK;
+}
+
+static const IEnumFORMATETCVtbl FmtEnumVtbl =
+{
+    FmtEnum_QueryInterface,
+    FmtEnum_AddRef,
+    FmtEnum_Release,
+    FmtEnum_Next,
+    FmtEnum_Skip,
+    FmtEnum_Reset,
+    FmtEnum_Clone
+};
+
+static HRESULT WINAPI TextData_QueryInterface(IDataObject *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDataObject))
+    {
+        *obj = iface;
+        IDataObject_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI TextData_AddRef(IDataObject *iface)
+{
+    return InterlockedIncrement(&impl_from_IDataObject(iface)->ref);
+}
+
+static ULONG WINAPI TextData_Release(IDataObject *iface)
+{
+    TextData *This = impl_from_IDataObject(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        free(This->text);
+        free(This);
+    }
+    return ref;
+}
+
+static BOOL format_ok(const FORMATETC *fe)
+{
+    return fe->cfFormat == CF_UNICODETEXT && (fe->dwAspect == DVASPECT_CONTENT) && (fe->tymed & TYMED_HGLOBAL);
+}
+
+static HRESULT WINAPI TextData_GetData(IDataObject *iface, FORMATETC *fe, STGMEDIUM *med)
+{
+    TextData *This = impl_from_IDataObject(iface);
+    HGLOBAL h;
+    WCHAR *p;
+
+    if (!fe || !med) return E_INVALIDARG;
+    if (fe->cfFormat != CF_UNICODETEXT) return DV_E_FORMATETC;
+    if (!format_ok(fe)) return DV_E_TYMED;
+    if (!(h = GlobalAlloc(GMEM_MOVEABLE, (This->cch + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    p = GlobalLock(h);
+    memcpy(p, This->text, This->cch * sizeof(WCHAR));
+    p[This->cch] = 0;
+    GlobalUnlock(h);
+    med->tymed = TYMED_HGLOBAL;
+    med->hGlobal = h;
+    med->pUnkForRelease = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI TextData_GetDataHere(IDataObject *iface, FORMATETC *fe, STGMEDIUM *med)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI TextData_QueryGetData(IDataObject *iface, FORMATETC *fe)
+{
+    if (!fe) return E_INVALIDARG;
+    if (fe->cfFormat != CF_UNICODETEXT) return DV_E_FORMATETC;
+    return format_ok(fe) ? S_OK : DV_E_TYMED;
+}
+
+static HRESULT WINAPI TextData_GetCanonicalFormatEtc(IDataObject *iface, FORMATETC *in, FORMATETC *out)
+{
+    if (!out) return E_INVALIDARG;
+    out->ptd = NULL;
+    return DATA_S_SAMEFORMATETC;
+}
+
+static HRESULT WINAPI TextData_SetData(IDataObject *iface, FORMATETC *fe, STGMEDIUM *med, BOOL release)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI TextData_EnumFormatEtc(IDataObject *iface, DWORD dir, IEnumFORMATETC **out)
+{
+    FmtEnum *e;
+
+    if (!out) return E_INVALIDARG;
+    if (dir != DATADIR_GET) return E_NOTIMPL;
+    if (!(e = calloc(1, sizeof(*e)))) return E_OUTOFMEMORY;
