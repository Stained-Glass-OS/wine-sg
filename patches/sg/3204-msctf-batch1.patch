+static BOOL find_value_cb(HKEY key, void *ctx)
+{
+    struct value_find *v = ctx;
+    DWORD size = v->size, type;
+
+    if (RegQueryValueExW(key, v->name, NULL, &type, v->data, &size)) return FALSE;
+    if (type != v->type) return FALSE;
+    v->size = size;
+    v->found = TRUE;
+    return TRUE;
+}
