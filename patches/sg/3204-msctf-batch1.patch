+/* ---- generic IEnumGUID over an array, and registry scans (SG) ---- */
+typedef struct {
+    IEnumGUID IEnumGUID_iface;
+    LONG ref;
+    GUID *guids;
+    ULONG count, pos;
+} GuidArrayEnum;
+
+static inline GuidArrayEnum *impl_from_GuidArrayEnum(IEnumGUID *iface)
+{
+    return CONTAINING_RECORD(iface, GuidArrayEnum, IEnumGUID_iface);
+}
+
+static HRESULT WINAPI GuidArrayEnum_QueryInterface(IEnumGUID *iface, REFIID iid, void **out)
+{
+    GuidArrayEnum *This = impl_from_GuidArrayEnum(iface);
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumGUID))
+    {
+        *out = &This->IEnumGUID_iface;
+        IEnumGUID_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI GuidArrayEnum_AddRef(IEnumGUID *iface)
+{
+    return InterlockedIncrement(&impl_from_GuidArrayEnum(iface)->ref);
+}
+
+static ULONG WINAPI GuidArrayEnum_Release(IEnumGUID *iface)
+{
+    GuidArrayEnum *This = impl_from_GuidArrayEnum(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        free(This->guids);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI GuidArrayEnum_Next(IEnumGUID *iface, ULONG celt, GUID *rgelt, ULONG *fetched)
+{
+    GuidArrayEnum *This = impl_from_GuidArrayEnum(iface);
+    ULONG n = 0;
+
+    if (!rgelt || (!fetched && celt != 1)) return E_INVALIDARG;
+    while (n < celt && This->pos < This->count) rgelt[n++] = This->guids[This->pos++];
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI GuidArrayEnum_Skip(IEnumGUID *iface, ULONG celt)
+{
+    GuidArrayEnum *This = impl_from_GuidArrayEnum(iface);
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI GuidArrayEnum_Reset(IEnumGUID *iface)
+{
+    impl_from_GuidArrayEnum(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_guid_array_enum(const GUID *guids, ULONG count, ULONG pos, IEnumGUID **out);
+
+static HRESULT WINAPI GuidArrayEnum_Clone(IEnumGUID *iface, IEnumGUID **out)
+{
+    GuidArrayEnum *This = impl_from_GuidArrayEnum(iface);
+    if (!out) return E_INVALIDARG;
+    return create_guid_array_enum(This->guids, This->count, This->pos, out);
+}
+
+static const IEnumGUIDVtbl GuidArrayEnumVtbl =
+{
+    GuidArrayEnum_QueryInterface,
+    GuidArrayEnum_AddRef,
+    GuidArrayEnum_Release,
+    GuidArrayEnum_Next,
+    GuidArrayEnum_Skip,
+    GuidArrayEnum_Reset,
+    GuidArrayEnum_Clone
+};
+
+static HRESULT create_guid_array_enum(const GUID *guids, ULONG count, ULONG pos, IEnumGUID **out)
+{
+    GuidArrayEnum *e = calloc(1, sizeof(*e));
+    if (!e) return E_OUTOFMEMORY;
+    if (count && !(e->guids = malloc(count * sizeof(GUID))))
+    {
+        free(e);
+        return E_OUTOFMEMORY;
+    }
+    if (count) memcpy(e->guids, guids, count * sizeof(GUID));
+    e->count = count;
+    e->pos = pos;
+    e->ref = 1;
+    e->IEnumGUID_iface.lpVtbl = &GuidArrayEnumVtbl;
+    *out = &e->IEnumGUID_iface;
+    return S_OK;
+}
+
+/* Calls fn for the registry key HKLM\<TIP>\<each tip clsid>\<subpath>, if it exists. */
+typedef BOOL (*tip_cb)(HKEY key, void *ctx);
+
+static void for_each_tip_key(const WCHAR *subpath, tip_cb cb, void *ctx)
+{
+    HKEY tips;
+    DWORD i;
+    WCHAR name[39];
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, szwSystemTIPKey, 0, KEY_READ, &tips)) return;
+    for (i = 0; ; i++)
+    {
+        DWORD len = ARRAY_SIZE(name);
+        WCHAR path[200];
+        HKEY key;
+        LSTATUS r = RegEnumKeyExW(tips, i, name, &len, NULL, NULL, NULL, NULL);
+        BOOL stop;
+
+        if (r == ERROR_MORE_DATA) continue;
+        if (r) break;
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s", name, subpath);
+        if (RegOpenKeyExW(tips, path, 0, KEY_READ, &key)) continue;
+        stop = cb(key, ctx);
+        RegCloseKey(key);
+        if (stop) break;
+    }
+    RegCloseKey(tips);
+}
+
+struct guid_list { GUID *guids; ULONG count, cap; BOOL oom; };
+
+static BOOL collect_subkey_guids(HKEY key, void *ctx)
+{
+    struct guid_list *l = ctx;
+    DWORD i;
+    WCHAR name[39];
+
+    for (i = 0; ; i++)
+    {
+        DWORD len = ARRAY_SIZE(name);
+        LSTATUS r = RegEnumKeyExW(key, i, name, &len, NULL, NULL, NULL, NULL);
+        GUID g;
+        ULONG j;
+
+        if (r == ERROR_MORE_DATA) continue;
+        if (r) break;
+        if (FAILED(CLSIDFromString(name, &g))) continue;
+        for (j = 0; j < l->count; j++) if (IsEqualGUID(&l->guids[j], &g)) break;
+        if (j < l->count) continue;
+        if (l->count == l->cap)
+        {
+            GUID *n = realloc(l->guids, (l->cap ? l->cap * 2 : 8) * sizeof(GUID));
+            if (!n) { l->oom = TRUE; return TRUE; }
+            l->guids = n;
+            l->cap = l->cap ? l->cap * 2 : 8;
+        }
+        l->guids[l->count++] = g;
+    }
+    return FALSE;
+}
+
+static HRESULT enum_guids_under(const WCHAR *subpath, IEnumGUID **ppEnum)
+{
+    struct guid_list l = {0};
+    HRESULT hr;
+
+    if (!ppEnum) return E_INVALIDARG;
+    *ppEnum = NULL;
+#ifndef SG_MUTANT_MSCTFB1_CATENUM
+    for_each_tip_key(subpath, collect_subkey_guids, &l);
+#endif
+    if (l.oom) hr = E_OUTOFMEMORY;
+    else hr = create_guid_array_enum(l.guids, l.count, 0, ppEnum);
+    free(l.guids);
+    return hr;
+}
