+ITextStoreACP *MemStore_Create(void)
+{
+    MemStore *This = calloc(1, sizeof(*This));
+
+    if (!This) return NULL;
+    This->cap = 64;
+    if (!(This->text = calloc(This->cap, sizeof(WCHAR))))
+    {
+        free(This);
+        return NULL;
+    }
+    This->ITextStoreACP_iface.lpVtbl = &MemStoreVtbl;
+    This->ref = 1;
+    This->sel.style.ase = TS_AE_END;
+    return &This->ITextStoreACP_iface;
+}
