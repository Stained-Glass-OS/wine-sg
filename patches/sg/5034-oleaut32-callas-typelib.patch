From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleaut32: Implement call_as wrappers for IsName, FindName, GetLibStatistics, CreateInstance.

The call_as proxy and stub wrappers of ITypeLib::IsName and FindName (the
name comes back as a BSTR in the library's spelling and is copied over the
caller's buffer), ITypeLib2::GetLibStatistics (the change count may be NULL
locally) and ITypeInfo::CreateInstance (CLASS_E_NOAGGREGATION for an outer
object, which cannot cross the call) forward to the remote methods; they
returned E_FAIL.

Gate: test/oleaut32-tlcallas-gate.sh (64/32).
---
 dlls/oleaut32/usrmarshal.c | 101 ++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 85 insertions(+), 16 deletions(-)

diff --git a/dlls/oleaut32/usrmarshal.c b/dlls/oleaut32/usrmarshal.c
index 42cf7f1..96883db 100644
--- a/dlls/oleaut32/usrmarshal.c
+++ b/dlls/oleaut32/usrmarshal.c
@@ -1933,8 +1933,19 @@ HRESULT CALLBACK ITypeInfo_CreateInstance_Proxy(
     REFIID riid,
     PVOID* ppvObj)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    TRACE("%p, %p, %s, %p.\n", This, pUnkOuter, debugstr_guid(riid), ppvObj);
+
+    /* an outer object cannot aggregate across the call */
+    if (pUnkOuter)
+    {
+        if (ppvObj) *ppvObj = NULL;
+        return CLASS_E_NOAGGREGATION;
+    }
+#ifndef SG_MUTANT_TL_CALLAS
+    return ITypeInfo_RemoteCreateInstance_Proxy(This, riid, (IUnknown **)ppvObj);
+#else
+    return E_FAIL;
+#endif
 }
 
 HRESULT __RPC_STUB ITypeInfo_CreateInstance_Stub(
@@ -1942,8 +1953,8 @@ HRESULT __RPC_STUB ITypeInfo_CreateInstance_Stub(
     REFIID riid,
     IUnknown** ppvObj)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    TRACE("%p, %s, %p.\n", This, debugstr_guid(riid), ppvObj);
+    return ITypeInfo_CreateInstance(This, NULL, riid, (void **)ppvObj);
 }
 
 HRESULT CALLBACK ITypeInfo_GetContainingTypeLib_Proxy(
@@ -2191,14 +2202,33 @@ HRESULT __RPC_STUB ITypeLib_GetDocumentation_Stub(ITypeLib *This, INT index, DWO
     return ITypeLib_GetDocumentation(This, index, name, doc_string, help_context, help_file);
 }
 
+/* IsName and FindName give back the name as the library spells it: it
+ * crosses as a BSTR, copied over the caller's buffer (the same length). */
+static void copy_lib_name(LPOLESTR buf, BSTR name)
+{
+    if (name && SysStringLen(name) == lstrlenW(buf))
+        memcpy(buf, name, SysStringLen(name) * sizeof(WCHAR));
+}
+
 HRESULT CALLBACK ITypeLib_IsName_Proxy(
     ITypeLib* This,
     LPOLESTR szNameBuf,
     ULONG lHashVal,
     BOOL* pfName)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    BSTR name = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %s, %#lx, %p.\n", This, debugstr_w(szNameBuf), lHashVal, pfName);
+
+#ifndef SG_MUTANT_TL_CALLAS
+    hr = ITypeLib_RemoteIsName_Proxy(This, szNameBuf, lHashVal, pfName, &name);
+#else
+    hr = E_FAIL;
+#endif
+    if (SUCCEEDED(hr) && *pfName) copy_lib_name(szNameBuf, name);
+    SysFreeString(name);
+    return hr;
 }
 
 HRESULT __RPC_STUB ITypeLib_IsName_Stub(
@@ -2208,8 +2238,14 @@ HRESULT __RPC_STUB ITypeLib_IsName_Stub(
     BOOL* pfName,
     BSTR* pBstrLibName)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    HRESULT hr;
+
+    TRACE("%p, %s, %#lx, %p, %p.\n", This, debugstr_w(szNameBuf), lHashVal, pfName, pBstrLibName);
+
+    *pBstrLibName = NULL;
+    hr = ITypeLib_IsName(This, szNameBuf, lHashVal, pfName);
+    if (SUCCEEDED(hr) && *pfName) *pBstrLibName = SysAllocString(szNameBuf);
+    return hr;
 }
 
 HRESULT CALLBACK ITypeLib_FindName_Proxy(
@@ -2220,8 +2256,19 @@ HRESULT CALLBACK ITypeLib_FindName_Proxy(
     MEMBERID* rgMemId,
     USHORT* pcFound)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    BSTR name = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %s, %#lx, %p, %p, %p.\n", This, debugstr_w(szNameBuf), lHashVal, ppTInfo, rgMemId, pcFound);
+
+#ifndef SG_MUTANT_TL_CALLAS
+    hr = ITypeLib_RemoteFindName_Proxy(This, szNameBuf, lHashVal, ppTInfo, rgMemId, pcFound, &name);
+#else
+    hr = E_FAIL;
+#endif
+    if (SUCCEEDED(hr) && *pcFound) copy_lib_name(szNameBuf, name);
+    SysFreeString(name);
+    return hr;
 }
 
 HRESULT __RPC_STUB ITypeLib_FindName_Stub(
@@ -2233,8 +2280,15 @@ HRESULT __RPC_STUB ITypeLib_FindName_Stub(
     USHORT* pcFound,
     BSTR* pBstrLibName)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    HRESULT hr;
+
+    TRACE("%p, %s, %#lx, %p, %p, %p, %p.\n", This, debugstr_w(szNameBuf), lHashVal, ppTInfo, rgMemId, pcFound,
+          pBstrLibName);
+
+    *pBstrLibName = NULL;
+    hr = ITypeLib_FindName(This, szNameBuf, lHashVal, ppTInfo, rgMemId, pcFound);
+    if (SUCCEEDED(hr) && *pcFound) *pBstrLibName = SysAllocString(szNameBuf);
+    return hr;
 }
 
 void CALLBACK ITypeLib_ReleaseTLibAttr_Proxy(
@@ -2260,8 +2314,23 @@ HRESULT CALLBACK ITypeLib2_GetLibStatistics_Proxy(
     ULONG* pcUniqueNames,
     ULONG* pcchUniqueNames)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    ULONG names, chars;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", This, pcUniqueNames, pcchUniqueNames);
+
+    /* both are [out] on the wire; the change count may be NULL locally */
+#ifndef SG_MUTANT_TL_CALLAS
+    hr = ITypeLib2_RemoteGetLibStatistics_Proxy(This, &names, &chars);
+#else
+    hr = E_FAIL;
+#endif
+    if (SUCCEEDED(hr))
+    {
+        if (pcUniqueNames) *pcUniqueNames = names;
+        if (pcchUniqueNames) *pcchUniqueNames = chars;
+    }
+    return hr;
 }
 
 HRESULT __RPC_STUB ITypeLib2_GetLibStatistics_Stub(
@@ -2269,8 +2338,8 @@ HRESULT __RPC_STUB ITypeLib2_GetLibStatistics_Stub(
     ULONG* pcUniqueNames,
     ULONG* pcchUniqueNames)
 {
-  FIXME("not implemented\n");
-  return E_FAIL;
+    TRACE("%p, %p, %p.\n", This, pcUniqueNames, pcchUniqueNames);
+    return ITypeLib2_GetLibStatistics(This, pcUniqueNames, pcchUniqueNames);
 }
 
 HRESULT CALLBACK ITypeLib2_GetDocumentation2_Proxy(ITypeLib2 *This, INT index,
