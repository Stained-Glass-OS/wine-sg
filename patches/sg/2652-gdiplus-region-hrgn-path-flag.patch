From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: the data of a region made from a GDI region has the path flag 0x2000

The Wine test (todo) records that GdipGetRegionData of a region made by GdipCreateRegionHrgn
(a rectangle or an ellipse) writes the path flags 0x6000, where a path of integers has 0x4000.
The flag stays with the path through clones and through the data read back (GdipCreateRegionRgnData),
and is accepted when reading instead of being reported as an unhandled flag.
---
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -351,6 +351,7 @@ struct GpPath{
     GpPathData pathdata;
     BOOL newfigure; /* whether the next drawing action starts a new figure */
     INT datalen; /* size of the arrays in pathdata */
+    BOOL from_hrgn; /* made of the rectangles of a GDI region: its data carries a flag for that */
 };
 
 struct GpPathIterator{
--- a/dlls/gdiplus/graphicspath.c
+++ b/dlls/gdiplus/graphicspath.c
@@ -1250,8 +1250,14 @@ GpStatus WINGDIPAPI GdipClonePath(GpPath* path, GpPath **clone)
         return InvalidParameter;
 
     if (path->pathdata.Count)
-      return GdipCreatePath2(path->pathdata.Points, path->pathdata.Types, path->pathdata.Count,
+    {
+        GpStatus status = GdipCreatePath2(path->pathdata.Points, path->pathdata.Types, path->pathdata.Count,
                              path->fill, clone);
+
+        if (status == Ok)
+            (*clone)->from_hrgn = path->from_hrgn;
+        return status;
+    }
     else
     {
         *clone = calloc(1, sizeof(GpPath));
@@ -2834,6 +2840,7 @@ GpStatus WINGDIPAPI GdipWindingModeOutline(GpPath *path, GpMatrix *matrix, REAL
 }
 
 #define FLAGS_INTPATH 0x4000
+#define FLAGS_HRGNPATH 0x2000
 
 struct path_header
 {
@@ -2879,6 +2886,10 @@ DWORD write_path_data(GpPath *path, void *data)
     header->version = VERSION_MAGIC2;
     header->count = path->pathdata.Count;
     header->flags = integer_path ? FLAGS_INTPATH : 0;
+#ifndef SG_MUTANT_GPREGION_NO_HRGN_FLAG
+    if (path->from_hrgn)
+        header->flags |= FLAGS_HRGNPATH;
+#endif
 
     if (integer_path)
     {
--- a/dlls/gdiplus/region.c
+++ b/dlls/gdiplus/region.c
@@ -76,6 +76,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(gdiplus);
  */
 
 #define FLAGS_INTPATH   0x4000
+#define FLAGS_HRGNPATH  0x2000
 
 struct region_header
 {
@@ -555,6 +556,8 @@ GpStatus WINGDIPAPI GdipCreateRegionHrgn(HRGN hrgn, GpRegion **region)
     }
 
     stat = GdipCreateRegionPath(path, region);
+    if (stat == Ok && (*region)->node.type == RegionDataPath)
+        (*region)->node.elementdata.path->from_hrgn = TRUE;
 
     free(buf);
     GdipDeletePath(path);
@@ -866,8 +869,9 @@ static GpStatus read_element(struct memory_buffer *mbuf, GpRegion *region, regio
 
         path->pathdata.Count = path_header->count;
 
-        if (path_header->flags & ~FLAGS_INTPATH)
+        if (path_header->flags & ~(FLAGS_INTPATH | FLAGS_HRGNPATH))
             FIXME("unhandled path flags %#lx\n", path_header->flags);
+        path->from_hrgn = !!(path_header->flags & FLAGS_HRGNPATH);
 
         if (path_header->flags & FLAGS_INTPATH)
         {
--- a/dlls/gdiplus/tests/region.c
+++ b/dlls/gdiplus/tests/region.c
@@ -1061,7 +1061,7 @@ static void test_fromhrgn(void)
     expect_dword(buf + 5, 0x00000020);
     expect_magic(buf + 6);
     expect_dword(buf + 7, 0x00000004);
-    todo_wine expect_dword(buf + 8, 0x00006000); /* ?? */
+    expect_dword(buf + 8, 0x00006000); /* ?? */
 
     point = (RegionDataPoint*)buf + 9;
 
@@ -1108,7 +1108,7 @@ static void test_fromhrgn(void)
     expect_dword(buf + 5, 0x000000C0);
     expect_magic(buf + 6);
     expect_dword(buf + 7, 0x00000024);
-    todo_wine expect_dword(buf + 8, 0x00006000); /* ?? */
+    expect_dword(buf + 8, 0x00006000); /* ?? */
     }
 
     GdipDeleteRegion(region);
