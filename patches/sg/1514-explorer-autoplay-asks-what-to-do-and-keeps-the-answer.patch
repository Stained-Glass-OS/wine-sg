From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: AutoPlay asks what to do and keeps the answer

As Windows 10: a drive that arrives is announced "USB Drive (E:) --
Select to choose what happens with removable drives.", and selecting it
asks (Open folder to view files / Take no action). The answer is kept
where Windows keeps it, Explorer\AutoplayHandlers\UserChosenExecuteHandlers
StorageOnArrival (MSOpenFolder, MSTakeNoAction): with Open folder kept, the
next drive opens in File Explorer at once with no notification; with Take
no action nothing happens; AutoplayHandlers DisableAutoplay = 1 (AutoPlay
off) does nothing at all. 0748 opened every drive it was asked about, and
could not be told to stop.
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -3447,6 +3447,80 @@
 #define WM_SG_AUTOPLAY_TRAY (WM_APP + 0x53)
 static HWND autoplay_window;
 
+/* Stained Glass OS (wine-sg 1514): what the person chose, kept where
+ * Windows keeps it -- Explorer\AutoplayHandlers\UserChosenExecuteHandlers
+ * StorageOnArrival: MSOpenFolder (File Explorer at once), MSTakeNoAction
+ * (nothing), none (the notification, and selecting it asks); and
+ * AutoplayHandlers DisableAutoplay = 1, Settings' "Use AutoPlay for all
+ * media and devices" off: nothing at all. */
+#define AUTOPLAY_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\AutoplayHandlers"
+#define AUTOPLAY_CHOSEN_KEY AUTOPLAY_KEY L"\\UserChosenExecuteHandlers"
+
+static void autoplay_chosen( WCHAR *out, DWORD size )
+{
+    out[0] = 0;
+    if (RegGetValueW( HKEY_CURRENT_USER, AUTOPLAY_CHOSEN_KEY, L"StorageOnArrival", RRF_RT_REG_SZ, NULL, out, &size ))
+        out[0] = 0;
+}
+
+static BOOL autoplay_disabled(void)
+{
+    DWORD value = 0, size = sizeof(value);
+    if (RegGetValueW( HKEY_CURRENT_USER, AUTOPLAY_KEY, L"DisableAutoplay", RRF_RT_REG_DWORD, NULL, &value, &size ))
+        return FALSE;
+    return value != 0;
+}
+
+static void autoplay_open( const WCHAR *root )
+{
+    WINE_TRACE( "drive %c: opened\n", root[0] );
+    ShellExecuteW( NULL, L"open", L"explorer.exe", root, NULL, SW_SHOWNORMAL );
+}
+
+/* the notification selected: Windows' question, its answer kept. In a
+ * thread of its own: the desktop's thread goes on with its work meanwhile */
+static DWORD WINAPI autoplay_ask_thread( void *arg )
+{
+    WCHAR root[] = { 'A' + (WCHAR)(ULONG_PTR)arg, ':', '\\', 0 }, label[MAX_PATH] = L"";
+    static const TASKDIALOG_BUTTON buttons[] =
+    {
+        { 100, L"Open folder to view files\nFile Explorer" },
+        { 101, L"Take no action" },
+    };
+    TASKDIALOGCONFIG tc = { sizeof(tc) };
+    SHFILEINFOW sfi = { 0 };
+    int button = 0;
+    HKEY key;
+
+    if (SHGetFileInfoW( root, 0, &sfi, sizeof(sfi), SHGFI_DISPLAYNAME ))
+        lstrcpynW( label, sfi.szDisplayName, ARRAY_SIZE(label) );
+    if (!label[0])
+        swprintf( label, ARRAY_SIZE(label), L"%s (%c:)",
+                  GetDriveTypeW( root ) == DRIVE_CDROM ? L"DVD Drive" : L"USB Drive", root[0] );
+    tc.dwFlags = TDF_USE_COMMAND_LINKS | TDF_ALLOW_DIALOG_CANCELLATION;
+    tc.pszWindowTitle = L"AutoPlay";
+    tc.pszMainInstruction = label;
+    tc.pszContent = GetDriveTypeW( root ) == DRIVE_CDROM ? L"Choose what to do with this disc."
+                                                         : L"Choose what to do with removable drives.";
+    tc.pszMainIcon = TD_INFORMATION_ICON;
+    tc.pButtons = buttons;
+    tc.cButtons = ARRAY_SIZE(buttons);
+    if (FAILED(TaskDialogIndirect( &tc, &button, NULL, NULL )) || (button != 100 && button != 101))
+        return 0;   /* closed without an answer: asked again next time */
+#ifndef SG_MUTANT_AUTOPLAY_NOT_KEPT
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, AUTOPLAY_CHOSEN_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+    {
+        const WCHAR *v = button == 100 ? L"MSOpenFolder" : L"MSTakeNoAction";
+        RegSetValueExW( key, L"StorageOnArrival", 0, REG_SZ, (const BYTE *)v, (lstrlenW( v ) + 1) * sizeof(WCHAR) );
+        RegCloseKey( key );
+    }
+#else
+    (void)key;
+#endif
+    if (button == 100) autoplay_open( root );
+    return 0;
+}
+
 static void autoplay_remove( HWND hwnd, UINT id )
 {
     NOTIFYICONDATAW nid = { sizeof(nid) };
@@ -3465,8 +3539,28 @@
         WCHAR root[] = { 'A' + (WCHAR)wparam, ':', '\\', 0 };
         NOTIFYICONDATAW nid = { sizeof(nid) };
         SHFILEINFOW sfi = { 0 };
-        WCHAR label[MAX_PATH] = L"";
+        WCHAR label[MAX_PATH] = L"", chosen[64];
 
+#ifndef SG_MUTANT_AUTOPLAY_IGNORES_CHOICE
+        if (autoplay_disabled())
+        {
+            WINE_TRACE( "drive %c: AutoPlay is off\n", root[0] );
+            return 0;
+        }
+        autoplay_chosen( chosen, sizeof(chosen) );
+        if (!wcsicmp( chosen, L"MSOpenFolder" ))
+        {
+            autoplay_open( root );
+            return 0;
+        }
+        if (!wcsicmp( chosen, L"MSTakeNoAction" ))
+        {
+            WINE_TRACE( "drive %c: no action, as chosen\n", root[0] );
+            return 0;
+        }
+#else
+        (void)chosen;
+#endif
         nid.hWnd = hwnd;
         nid.uID = wparam + 1;
         nid.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP | NIF_INFO;
@@ -3481,7 +3575,8 @@
                       GetDriveTypeW( root ) == DRIVE_CDROM ? L"DVD Drive" : L"USB Drive", root[0] );
         lstrcpynW( nid.szTip, label, ARRAY_SIZE(nid.szTip) );
         lstrcpynW( nid.szInfoTitle, label, ARRAY_SIZE(nid.szInfoTitle) );
-        lstrcpynW( nid.szInfo, L"Select to open it in File Explorer.", ARRAY_SIZE(nid.szInfo) );
+        lstrcpynW( nid.szInfo, GetDriveTypeW( root ) == DRIVE_CDROM ? L"Select to choose what happens with this disc."
+                                     : L"Select to choose what happens with removable drives.", ARRAY_SIZE(nid.szInfo) );
         nid.uTimeout = 15000;
         autoplay_remove( hwnd, nid.uID );
         Shell_NotifyIconW( NIM_ADD, &nid );
@@ -3504,9 +3599,13 @@
         case NIN_BALLOONUSERCLICK:
         case NIN_SELECT:
         case NIN_KEYSELECT:
-            ShellExecuteW( NULL, L"open", L"explorer.exe", root, NULL, SW_SHOWNORMAL );
+        {
+            HANDLE thread = CreateThread( NULL, 0, autoplay_ask_thread, (void *)(ULONG_PTR)(id - 1), 0, NULL );
+            if (thread) CloseHandle( thread );
+            else autoplay_open( root );
             autoplay_remove( hwnd, id );
             break;
+        }
         case NIN_BALLOONTIMEOUT:
             autoplay_remove( hwnd, id );
             break;
