From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:46:25 -0700
Subject: [PATCH] wpcap: pcap_parsesrcstr, source handling in pcap_open /
 pcap_findalldevs_ex (3247)

pcap_parsesrcstr understands the WinPcap source forms: rpcap://name (local),
rpcap://host[:port]/name and rpcap://[ipv6]:port/name (remote), file://path
and a bare device name; the name is required. pcap_open and
pcap_findalldevs_ex use it and report an error for a remote or file source
instead of silently using or listing the local devices; pcap_findalldevs_ex
requires an rpcap:// or file:// source.

diff --git a/dlls/wpcap/wpcap.c b/dlls/wpcap/wpcap.c
index de4bac3..2dd511d 100644
--- a/dlls/wpcap/wpcap.c
+++ b/dlls/wpcap/wpcap.c
@@ -682,9 +682,39 @@ int CDECL pcap_findalldevs( struct pcap_interface **devs, char *errbuf )
     return find_all_devices( NULL, devs, errbuf );
 }
 
+int CDECL pcap_parsesrcstr( const char *source, int *ret_type, char *host, char *port, char *name, char *errbuf );
+#define PCAP_SRC_FILE     2
+#define PCAP_SRC_IFLOCAL  3
+#define PCAP_SRC_IFREMOTE 4
+#define PCAP_BUF_SIZE     1024
+
 int CDECL pcap_findalldevs_ex( char *source, void *auth, struct pcap_interface **devs, char *errbuf )
 {
-    FIXME( "%s, %p, %p, %p: partial stub\n", debugstr_a(source), auth, devs, errbuf );
+    char name[1024], host[1024];
+    int type;
+
+    TRACE( "%s, %p, %p, %p\n", debugstr_a(source), auth, devs, errbuf );
+
+    if (!source || (strncmp( source, "rpcap://", 8 ) && strncmp( source, "file://", 7 )))
+    {
+        if (errbuf) sprintf( errbuf, "The source must start with rpcap:// or file://." );
+        return PCAP_ERROR;
+    }
+    /* "rpcap://" alone is the local machine's devices */
+    if (strcmp( source, "rpcap://" ))
+    {
+        if (pcap_parsesrcstr( source, &type, host, NULL, name, errbuf )) return PCAP_ERROR;
+        if (type == PCAP_SRC_IFREMOTE)
+        {
+            if (errbuf) sprintf( errbuf, "Remote capture (rpcap) is not supported." );
+            return PCAP_ERROR;
+        }
+        if (type == PCAP_SRC_FILE)
+        {
+            if (errbuf) sprintf( errbuf, "Listing capture files is not supported." );
+            return PCAP_ERROR;
+        }
+    }
     return find_all_devices( source, devs, errbuf );
 }
 
@@ -1081,11 +1111,32 @@ static struct pcap *open_live( const char *source, int snaplen, int promisc, int
     return ret;
 }
 
+int CDECL pcap_parsesrcstr( const char *source, int *ret_type, char *host, char *port, char *name, char *errbuf );
 #define PCAP_OPENFLAG_PROMISCUOUS 1
+#define PCAP_BUF_SIZE_OPEN 1024
 struct pcap * CDECL pcap_open( const char *source, int snaplen, int flags, int timeout, void *auth, char *errbuf )
 {
-    FIXME( "%s, %d, %d, %d, %p, %p: partial stub\n", debugstr_a(source), snaplen, flags, timeout, auth, errbuf );
-    return open_live( source, snaplen, flags & PCAP_OPENFLAG_PROMISCUOUS, timeout, errbuf );
+    char name[PCAP_BUF_SIZE_OPEN], host[PCAP_BUF_SIZE_OPEN];
+    int type;
+
+    TRACE( "%s, %d, %d, %d, %p, %p\n", debugstr_a(source), snaplen, flags, timeout, auth, errbuf );
+
+    if (pcap_parsesrcstr( source, &type, host, NULL, name, errbuf )) return NULL;
+#ifdef SG_MUTANT_PCAP_NOREMOTE
+    if (0)
+#else
+    if (type == PCAP_SRC_IFREMOTE)
+#endif
+    {
+        if (errbuf) sprintf( errbuf, "Remote capture (rpcap) is not supported." );
+        return NULL;
+    }
+    if (type == PCAP_SRC_FILE)
+    {
+        if (errbuf) sprintf( errbuf, "Capture files cannot be opened with pcap_open." );
+        return NULL;
+    }
+    return open_live( name, snaplen, flags & PCAP_OPENFLAG_PROMISCUOUS, timeout, errbuf );
 }
 
 struct pcap * CDECL pcap_open_live( const char *source, int snaplen, int promisc, int to_ms, char *errbuf )
@@ -1094,21 +1145,76 @@ struct pcap * CDECL pcap_open_live( const char *source, int snaplen, int promisc
     return open_live( source, snaplen, promisc, to_ms, errbuf );
 }
 
-#define PCAP_SRC_FILE    2
-#define PCAP_SRC_IFLOCAL 3
 
+/* rpcap://[host[:port]/]name, file://path, or a bare local device name */
 int CDECL pcap_parsesrcstr( const char *source, int *ret_type, char *host, char *port, char *name, char *errbuf )
 {
     int type = PCAP_SRC_IFLOCAL;
-    const char *ptr = source;
+    const char *ptr = source, *slash, *colon;
+    size_t len;
 
-    FIXME( "%s, %p, %p, %p, %p, %p: partial stub\n", debugstr_a(source), ret_type, host, port, name, errbuf );
+    TRACE( "%s, %p, %p, %p, %p, %p\n", debugstr_a(source), ret_type, host, port, name, errbuf );
 
     if (host) *host = 0;
     if (port) *port = 0;
     if (name) *name = 0;
 
-    if (!strncmp( ptr, "rpcap://", strlen("rpcap://"))) ptr += strlen( "rpcap://" );
+    if (!source || strlen( source ) >= PCAP_BUF_SIZE)
+    {
+        if (errbuf) sprintf( errbuf, "The source string is %s.", source ? "too long" : "missing" );
+        return PCAP_ERROR;
+    }
+
+    if (!strncmp( ptr, "rpcap://", strlen("rpcap://") ))
+    {
+        ptr += strlen( "rpcap://" );
+#ifdef SG_MUTANT_PCAP_NOV6
+        if (0)
+#else
+        if (*ptr == '[')
+#endif
+        {
+            /* a bracketed IPv6 address, then an optional :port, then the name */
+            const char *end = strchr( ptr, ']' );
+            if (end && (end[1] == '/' || end[1] == ':'))
+            {
+                len = end - ptr - 1;
+                if (host) { memcpy( host, ptr + 1, len ); host[len] = 0; }
+                ptr = end + 1;
+                if (*ptr == ':')
+                {
+                    slash = strchr( ptr, '/' );
+                    if (!slash) goto noname;
+                    len = slash - ptr - 1;
+                    if (port) { memcpy( port, ptr + 1, len ); port[len] = 0; }
+                    ptr = slash;
+                }
+                ptr++; /* the slash */
+                type = PCAP_SRC_IFREMOTE;
+            }
+        }
+        else if ((slash = strchr( ptr, '/' )))
+        {
+            /* host[:port]/name; an empty host is the local machine */
+            colon = memchr( ptr, ':', slash - ptr );
+            len = (colon ? colon : slash) - ptr;
+#ifdef SG_MUTANT_PCAP_NOHOST
+            if (0)
+#else
+            if (len)
+#endif
+            {
+                if (host) { memcpy( host, ptr, len ); host[len] = 0; }
+                type = PCAP_SRC_IFREMOTE;
+            }
+            if (colon && port)
+            {
+                memcpy( port, colon + 1, slash - colon - 1 );
+                port[slash - colon - 1] = 0;
+            }
+            ptr = slash + 1;
+        }
+    }
     else if (!strncmp( ptr, "file://", strlen("file://") ))
     {
         ptr += strlen( "file://" );
@@ -1118,6 +1224,7 @@ int CDECL pcap_parsesrcstr( const char *source, int *ret_type, char *host, char
     if (ret_type) *ret_type = type;
     if (!*ptr)
     {
+noname:
         if (errbuf) sprintf( errbuf, "The name has not been specified in the source string." );
         return PCAP_ERROR;
     }
