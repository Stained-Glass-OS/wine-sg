From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase, shell32: a requireAdministrator program asks for consent

Installers declare requireAdministrator. Wine's loader elevated inside the new
process, which 0019 forbids in a shared prefix, so they ran as the user and
failed on Program Files ("Access denied") without any prompt. As on Windows,
CreateProcess now refuses such an image with ERROR_ELEVATION_REQUIRED (740)
when the caller is not elevated and has no linked token to elevate with, and
ShellExecuteEx (Explorer, PowerShell's Start-Process) answers 740 by handing
the command to the elevation broker (0022's path, now a helper). Only where
the broker exists; never inside a program the broker started (SG_IN_BROKER);
highestAvailable runs as the invoker, as for a standard user on Windows.
SG_ELEVATE names a stand-in broker client (an absolute Unix path) for gates.

Found by the 2026-09-26 ISO QA pass. Gate: test/elevreq-gate.sh
(make test-elevreq).
---
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -559,6 +559,74 @@
     return ret;
 }
 
+/* Stained Glass OS (ADR 0012): does starting app_name need an administrator?
+ *
+ * On Windows, CreateProcess of a program whose manifest says
+ * requireAdministrator fails with ERROR_ELEVATION_REQUIRED unless the caller
+ * is elevated, and ShellExecute answers that by asking for consent. Wine's
+ * loader instead elevated inside the new process, which wine-sg 0019 rightly
+ * forbids in a shared prefix -- so installers (7-Zip, VLC, ...) ran as the
+ * user and failed on Program Files with "Access denied", no prompt at all.
+ * Only where the elevation broker exists (sg-elevate), only for a caller that
+ * is not elevated and has no linked token of its own to elevate with, and
+ * never inside a program the broker started. highestAvailable runs as the
+ * invoker, as it does for a standard user on Windows. */
+static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token )
+{
+    static const char tag[] = "requestedexecutionlevel", level[] = "requireadministrator";
+    HANDLE tok = token ? token : GetCurrentThreadEffectiveToken();
+    TOKEN_ELEVATION_TYPE type;
+    TOKEN_ELEVATION elevation;
+    const char *xml;
+    DWORD size, len, i, j;
+    BOOL in_tag = FALSE, ret = FALSE;
+    HMODULE module;
+    HRSRC res;
+
+    WCHAR broker[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate", *p;
+
+    if (!app_name || GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 )) return FALSE;
+    /* SG_ELEVATE names a stand-in broker client (an absolute Unix path), for gates */
+    if (GetEnvironmentVariableW( L"SG_ELEVATE", broker + 8, MAX_PATH ) && broker[8] == '/')
+    {
+        for (p = broker + 8; *p; p++) if (*p == '/') *p = '\\';
+    }
+    else lstrcpyW( broker, L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate" );
+    if (GetFileAttributesW( broker ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (GetTokenInformation( tok, TokenElevation, &elevation, sizeof(elevation), &size ) &&
+        elevation.TokenIsElevated) return FALSE;
+    if (GetTokenInformation( tok, TokenElevationType, &type, sizeof(type), &size ) &&
+        type == TokenElevationTypeLimited) return FALSE;  /* the loader elevates with the linked token */
+
+    if (!(module = LoadLibraryExW( app_name, 0, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE )))
+        return FALSE;
+    /* RT_MANIFEST (24), CREATEPROCESS_MANIFEST_RESOURCE_ID (1): winuser.h is not ours here */
+    if ((res = FindResourceW( module, (const WCHAR *)(ULONG_PTR)1, (const WCHAR *)(ULONG_PTR)24 )) &&
+        (xml = LoadResource( module, res )) && (len = SizeofResource( module, res )))
+    {
+        /* level="requireAdministrator" inside <requestedExecutionLevel ...> */
+        for (i = 0; i < len && !ret; i++)
+        {
+            if (xml[i] == '<') in_tag = FALSE;
+            if (!in_tag && len - i >= sizeof(tag) - 1)
+            {
+                for (j = 0; j < sizeof(tag) - 1 && (xml[i + j] | 0x20) == tag[j]; j++);
+                if (j == sizeof(tag) - 1) { in_tag = TRUE; i += j - 1; continue; }
+            }
+            if (in_tag && xml[i] == '>') in_tag = FALSE;
+            if (in_tag && len - i >= sizeof(level) - 1)
+            {
+                for (j = 0; j < sizeof(level) - 1 && (xml[i + j] | 0x20) == level[j]; j++);
+                if (j == sizeof(level) - 1) ret = TRUE;
+            }
+        }
+    }
+    FreeLibrary( module );
+    if (ret) TRACE( "%s requires an administrator\n", debugstr_w(app_name) );
+    return ret;
+}
