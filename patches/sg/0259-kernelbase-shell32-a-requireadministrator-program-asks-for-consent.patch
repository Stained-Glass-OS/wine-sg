+/* Stained Glass OS (ADR 0012): start lpCmd through the elevation broker, which
+ * prompts on the secure surface and runs it as the SYSTEM account. sg-elevate
+ * (its client) and the broker are Unix programs, reached through \\?\unix\;
+ * --wine tells sg-elevate the rest is a Windows command to run under Wine as
+ * SYSTEM. Only with the client installed, and never inside a program the
+ * broker itself launched (SG_IN_BROKER). */
+static BOOL sg_execute_via_broker( const WCHAR *lpCmd, DWORD flags, void *env,
+                                   STARTUPINFOW *startup, PROCESS_INFORMATION *info )
+{
+    WCHAR broker[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate", *broker_cmd, *p;
+    BOOL ret;
+
+    if (GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 )) return FALSE;
+    /* SG_ELEVATE names a stand-in broker client (an absolute Unix path), for gates */
+    if (GetEnvironmentVariableW( L"SG_ELEVATE", broker + 8, MAX_PATH ) && broker[8] == '/')
+    {
+        for (p = broker + 8; *p; p++) if (*p == '/') *p = '\\';
+    }
+    else wcscpy( broker, L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate" );
+    if (GetFileAttributesW( broker ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    if (!(broker_cmd = malloc( (wcslen( broker ) + wcslen( L" --wine " ) + wcslen( lpCmd ) + 1) * sizeof(WCHAR) ))) return FALSE;
+    wcscpy( broker_cmd, broker );
+    wcscat( broker_cmd, L" --wine " );
+    wcscat( broker_cmd, lpCmd );
+    ret = CreateProcessW( NULL, broker_cmd, NULL, NULL, FALSE, flags, env, NULL, startup, info );
+    free( broker_cmd );
+    return ret;
+}
