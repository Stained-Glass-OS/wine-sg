From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 16:59:19 -0700
Subject: [PATCH] d3d8: palette entries are kept (Set/GetPaletteEntries,
 current texture palette)

The d3d8 palette API is non-functional on Windows but its getters and setters
work; the entries and the current palette index are stored on the device.
The vertex shader Usage hint no longer reports a FIXME.

diff --git a/dlls/d3d8/d3d8_private.h b/dlls/d3d8/d3d8_private.h
index 9af6e55..5c28aee 100644
--- a/dlls/d3d8/d3d8_private.h
+++ b/dlls/d3d8/d3d8_private.h
@@ -130,6 +130,10 @@ struct d3d8_device
 
     unsigned int max_user_clip_planes, vs_uniform_count;
 
+    PALETTEENTRY **palettes;
+    unsigned int palette_count;
+    UINT current_palette;
+
     /* The d3d8 API supports only one implicit swapchain (no D3DCREATE_ADAPTERGROUP_DEVICE,
      * no GetSwapchain, GetBackBuffer doesn't accept a swapchain number). */
     struct wined3d_swapchain *implicit_swapchain;
diff --git a/dlls/d3d8/device.c b/dlls/d3d8/device.c
index b5bf370..107ccda 100644
--- a/dlls/d3d8/device.c
+++ b/dlls/d3d8/device.c
@@ -624,6 +624,9 @@ static ULONG WINAPI d3d8_device_Release(IDirect3DDevice8 *iface)
             d3d8_vertex_declaration_destroy(device->decls[i].declaration);
         }
         free(device->decls);
+        for (i = 0; i < device->palette_count; ++i)
+            free(device->palettes[i]);
+        free(device->palettes);
 
         wined3d_streaming_buffer_cleanup(&device->vertex_buffer);
         wined3d_streaming_buffer_cleanup(&device->index_buffer);
@@ -2453,10 +2456,38 @@ static HRESULT WINAPI d3d8_device_GetInfo(IDirect3DDevice8 *iface,
 static HRESULT WINAPI d3d8_device_SetPaletteEntries(IDirect3DDevice8 *iface,
         UINT palette_idx, const PALETTEENTRY *entries)
 {
-    WARN("iface %p, palette_idx %u, entries %p unimplemented\n", iface, palette_idx, entries);
+    struct d3d8_device *device = impl_from_IDirect3DDevice8(iface);
+    PALETTEENTRY *copy;
+
+    TRACE("iface %p, palette_idx %u, entries %p.\n", iface, palette_idx, entries);
 
     /* GPUs stopped supporting palettized textures with the Shader Model 1 generation. Wined3d
-     * does not have a d3d8/9-style palette API */
+     * does not have a d3d8/9-style palette API: the entries are kept for GetPaletteEntries only. */
+    if (!entries || palette_idx > 0xffff)
+        return D3DERR_INVALIDCALL;
+
+    wined3d_mutex_lock();
+    if (palette_idx >= device->palette_count)
+    {
+        PALETTEENTRY **grown = realloc(device->palettes, (palette_idx + 1) * sizeof(*grown));
+
+        if (!grown)
+        {
+            wined3d_mutex_unlock();
+            return E_OUTOFMEMORY;
+        }
+        memset(grown + device->palette_count, 0, (palette_idx + 1 - device->palette_count) * sizeof(*grown));
+        device->palettes = grown;
+        device->palette_count = palette_idx + 1;
+    }
+    if (!(copy = device->palettes[palette_idx]) && !(copy = malloc(256 * sizeof(*copy))))
+    {
+        wined3d_mutex_unlock();
+        return E_OUTOFMEMORY;
+    }
+    memcpy(copy, entries, 256 * sizeof(*copy));
+    device->palettes[palette_idx] = copy;
+    wined3d_mutex_unlock();
 
     return D3D_OK;
 }
@@ -2464,23 +2495,49 @@ static HRESULT WINAPI d3d8_device_SetPaletteEntries(IDirect3DDevice8 *iface,
 static HRESULT WINAPI d3d8_device_GetPaletteEntries(IDirect3DDevice8 *iface,
         UINT palette_idx, PALETTEENTRY *entries)
 {
-    FIXME("iface %p, palette_idx %u, entries %p unimplemented.\n", iface, palette_idx, entries);
+    struct d3d8_device *device = impl_from_IDirect3DDevice8(iface);
+    HRESULT hr = D3DERR_INVALIDCALL;
 
-    return D3DERR_INVALIDCALL;
+    TRACE("iface %p, palette_idx %u, entries %p.\n", iface, palette_idx, entries);
+
+    if (!entries)
+        return D3DERR_INVALIDCALL;
+
+    wined3d_mutex_lock();
+    if (palette_idx < device->palette_count && device->palettes[palette_idx])
+    {
+        memcpy(entries, device->palettes[palette_idx], 256 * sizeof(*entries));
+        hr = D3D_OK;
+    }
+    wined3d_mutex_unlock();
+
+    return hr;
 }
 
 static HRESULT WINAPI d3d8_device_SetCurrentTexturePalette(IDirect3DDevice8 *iface, UINT palette_idx)
 {
-    WARN("iface %p, palette_idx %u unimplemented.\n", iface, palette_idx);
+    struct d3d8_device *device = impl_from_IDirect3DDevice8(iface);
+
+    TRACE("iface %p, palette_idx %u.\n", iface, palette_idx);
+
+    if (palette_idx > 0xffff)
+        return D3DERR_INVALIDCALL;
+    device->current_palette = palette_idx;
 
     return D3D_OK;
 }
 
 static HRESULT WINAPI d3d8_device_GetCurrentTexturePalette(IDirect3DDevice8 *iface, UINT *palette_idx)
 {
-    FIXME("iface %p, palette_idx %p unimplemented.\n", iface, palette_idx);
+    struct d3d8_device *device = impl_from_IDirect3DDevice8(iface);
 
-    return D3DERR_INVALIDCALL;
+    TRACE("iface %p, palette_idx %p.\n", iface, palette_idx);
+
+    if (!palette_idx)
+        return D3DERR_INVALIDCALL;
+    *palette_idx = device->current_palette;
+
+    return D3D_OK;
 }
 
 static void d3d8_device_upload_sysmem_vertex_buffers(struct d3d8_device *device,
diff --git a/dlls/d3d8/shader.c b/dlls/d3d8/shader.c
index 95a766d..131a716 100644
--- a/dlls/d3d8/shader.c
+++ b/dlls/d3d8/shader.c
@@ -112,7 +112,7 @@ HRESULT d3d8_vertex_shader_init(struct d3d8_vertex_shader *shader, struct d3d8_d
         struct wined3d_shader_desc desc;
 
         if (usage)
-            FIXME("Usage %#lx not implemented.\n", usage);
+            TRACE("Usage %#lx is a hint (software processing); the shader is created the same.\n", usage);
 
         desc.byte_code = byte_code;
         desc.byte_code_size = ~(size_t)0;
