+/* Stained Glass OS: the C++ interfaces overload their setters (SetOffsetX(float) and
+ * SetOffsetX(IDCompositionAnimation *), ...). MSVC lays out an overload set in reverse order of
+ * declaration, so in every vtable here the animation (or object) overload comes before the value
+ * overload; callers built with MSVC (Edge, WebView2, Office) call them so. */
+
 typedef struct _D3DMATRIX
 {
     float m[4][4];
@@ -85,30 +90,30 @@ interface IDCompositionClip : IUnknown
 ]
