From: Stained Glass OS <ke7oxh@gmail.com>
Subject: icu: the locale list has no en_US_POSIX, as Windows' icu.dll

Visual Studio 2022 said "Could not start Visual Studio due to an error"
(StreamJsonRpc.ConnectionLostException) after its sign-in window came up.
Its ServiceHub service discovery runs in ServiceHub.VSDetouredHost (.NET 10,
ICU globalization through icu.dll), and the VSIX discovery there threw
"Culture is not supported ... en-us-posix is an invalid culture identifier"
from CultureInfo.GetCultures: .NET's IcuEnumCultures builds a CultureInfo for
every locale icu.dll lists, and on Windows that name is not a culture. The
host's ICU lists en_US_POSIX among its installed locales; Windows' icu.dll
does not. uloc_countAvailable and uloc_getAvailable now leave it out (the
later indexes move down one). Written in make_host.py, which generates
unixlib.c.

Gate: test-icuposix (no en_US_POSIX; en_US once; every index named, in
order). Mutant SG_MUTANT_ICU_LISTS_POSIX.

--- a/dlls/icu/make_host.py
+++ b/dlls/icu/make_host.py
@@ -60,6 +60,49 @@
          'b': 'signed char', 'i': 'int', 'v': 'void'}
 SPEC = {'h': 'ptr', 'p': 'ptr', 'd': 'double', 'b': 'long', 'i': 'long'}
 fwd = [p for p in protos if p[0] not in NATIVE]
+# Calls whose unix side is written here. The locale list leaves out ICU's
+# "en_US_POSIX", as Windows' icu.dll has none: .NET builds a CultureInfo for
+# every listed locale (CultureInfo.GetCultures), and on Windows that name is
+# "an invalid culture identifier" -- Visual Studio's ServiceHub service
+# discovery stopped there (wine-sg 7806).
+CUSTOM_UNIX = {
+    'uloc_countAvailable': """/* the host's index of en_US_POSIX in its locale list, or -1 */
+static int32_t posix_index(void)
+{
+#ifdef SG_MUTANT_ICU_LISTS_POSIX
+    return -1;
+#else
+    static int32_t index = -2;
+    if (index == -2)
+    {
+        int32_t i, count = uloc_countAvailable();
+        index = -1;
+        for (i = 0; i < count; i++)
+            if (!strcmp( uloc_getAvailable( i ), "en_US_POSIX" )) { index = i; break; }
+    }
+    return index;
+#endif
+}
+
+static NTSTATUS call_uloc_countAvailable(void *args)
+{
+    struct icu_call *c = args;
+    c->ret = (UINT64)(INT64)(uloc_countAvailable() - (posix_index() >= 0 ? 1 : 0));
+    return STATUS_SUCCESS;
+}
+
+""",
+    'uloc_getAvailable': """static NTSTATUS call_uloc_getAvailable(void *args)
+{
+    struct icu_call *c = args;
+    int32_t n = (int32_t)c->a[0], skip = posix_index();
+    if (skip >= 0 && n >= skip) n++;
+    c->ret = (UINT64)(uintptr_t)uloc_getAvailable(n);
+    return STATUS_SUCCESS;
+}
+
+""",
+}
 
 # unixlib.h
 with open(out + '/icu_host.h', 'w') as f:
@@ -140,6 +183,9 @@
 
 ''')
     for n, r, p in fwd:
+        if n in CUSTOM_UNIX:
+            f.write(CUSTOM_UNIX[n])
+            continue
         args = []
         for i, (t, pn) in enumerate(p):
             c = cls(t)
