+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "shellapi.h"
+#include "shlwapi.h"
+#include "shell32_main.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+#define C_BG        RGB(0xff, 0xff, 0xff)
+#define C_TEXT      RGB(0x1b, 0x1b, 0x1b)
+#define C_MUTED     RGB(0x60, 0x60, 0x60)
+#define C_ACCENT    RGB(0x7b, 0x2f, 0xbe)
+#define C_ACCENT_DK RGB(0x5f, 0x24, 0x96)
+#define C_TRACK     RGB(0xe6, 0xe6, 0xe6)
+#define C_HOT       RGB(0xf0, 0xe8, 0xfa)
+
+#define PROGRESS_DELAY 500   /* ms before the window appears */
+
+struct fileop_progress
+{
+    UINT func;
+    HWND owner;
+    WCHAR from_name[MAX_PATH], to_name[MAX_PATH];
+    LONG items_total, items_done;
+    LONGLONG bytes_total, bytes_done, file_bytes;
+    CRITICAL_SECTION cs;
+    WCHAR current[MAX_PATH];
+    volatile LONG cancelled;
+    HANDLE done, thread;
+    HWND hwnd;
+    DWORD start, paused, pause_start;
+    volatile LONG pausing;
+    int depth;
+
+    /* conflicts */
+    int conflict_all;        /* the answer for every conflict, once chosen */
+    LONG conflicts_left;
+};
+
+static DWORD progress_tls = TLS_OUT_OF_INDEXES;
+
+static int scale(int x)
+{
+    HDC dc = GetDC(0);
+    int dpi = GetDeviceCaps(dc, LOGPIXELSY);
+    ReleaseDC(0, dc);
+    return MulDiv(x, dpi, 96);
+}
+
+static HFONT ui_font(int points_x10, int weight)
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    LOGFONTW lf;
+    HDC dc = GetDC(0);
+
+    SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0);
+    lf = ncm.lfMessageFont;
+    if (points_x10) lf.lfHeight = -MulDiv(points_x10, GetDeviceCaps(dc, LOGPIXELSY), 720);
+    if (weight) lf.lfWeight = weight;
+    ReleaseDC(0, dc);
+    return CreateFontIndirectW(&lf);
+}
+
+static void fill_rect(HDC dc, const RECT *rc, COLORREF color)
+{
+    HBRUSH brush = CreateSolidBrush(color);
+    FillRect(dc, rc, brush);
+    DeleteObject(brush);
+}
+
+static void draw_text(HDC dc, const WCHAR *str, RECT *rc, COLORREF color, UINT flags)
+{
+    SetTextColor(dc, color);
+    SetBkMode(dc, TRANSPARENT);
+    DrawTextW(dc, str, -1, rc, flags | DT_NOPREFIX);
+}
+
+/* the name the dialogs show for where items come from and go to: the folder's own name */
+static void folder_name(const WCHAR *path, WCHAR *out, BOOL parent)
+{
+    WCHAR buf[MAX_PATH];
+
+    lstrcpynW(buf, path, MAX_PATH);
+    PathRemoveBackslashW(buf);
+    if (parent) PathRemoveFileSpecW(buf);
+    PathRemoveBackslashW(buf);
+    if (PathIsRootW(buf) || !*PathFindFileNameW(buf)) lstrcpyW(out, buf);
+    else lstrcpyW(out, PathFindFileNameW(buf));
+}
+
+static void count_path(struct fileop_progress *p, const WCHAR *spec, int depth)
+{
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    WCHAR dir[MAX_PATH], sub[MAX_PATH];
+
+    if (depth > 32 || p->items_total > 200000 || lstrlenW(spec) >= MAX_PATH) return;
+    lstrcpyW(dir, spec);
+    PathRemoveFileSpecW(dir);
+    if ((find = FindFirstFileW(spec, &fd)) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+        p->items_total++;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) continue;
+            if (lstrlenW(dir) + lstrlenW(fd.cFileName) + 4 >= MAX_PATH) continue;
+            PathCombineW(sub, dir, fd.cFileName);
+            PathAppendW(sub, L"*");
+            count_path(p, sub, depth + 1);
+        }
+        else p->bytes_total += ((LONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+    } while (FindNextFileW(find, &fd));
+    FindClose(find);
+}
+
+static DWORD elapsed(struct fileop_progress *p)
+{
+    return GetTickCount() - p->start - p->paused;
+}
+
+static void progress_texts(struct fileop_progress *p, WCHAR *title, WCHAR *headline, WCHAR *pct_text,
+                           WCHAR *name, WCHAR *items, WCHAR *remaining, int *percent)
+{
+    const WCHAR *verb = p->func == FO_MOVE ? L"Moving" : p->func == FO_DELETE ? L"Deleting" : L"Copying";
+    LONGLONG bytes_done = p->bytes_done + p->file_bytes;
+    double fraction = 0;
+    WCHAR size[32];
+    DWORD ms = elapsed(p);
+
+    if (p->bytes_total > 0 && p->func == FO_COPY) fraction = (double)bytes_done / p->bytes_total;
+    else if (p->items_total > 0) fraction = (double)p->items_done / p->items_total;
+    if (fraction > 1) fraction = 1;
+    *percent = (int)(fraction * 100);
+
+    if (p->func == FO_DELETE)
+        swprintf(headline, 256, L"%s %ld item%s from %s", verb, p->items_total, p->items_total == 1 ? L"" : L"s", p->from_name);
+    else
+        swprintf(headline, 256, L"%s %ld item%s from %s to %s", verb, p->items_total, p->items_total == 1 ? L"" : L"s",
+                 p->from_name, p->to_name);
+    if (p->cancelled)
+    {
+        lstrcpyW(title, L"Cancelling...");
+        lstrcpyW(pct_text, L"Cancelling...");
+    }
+    else
+    {
+        swprintf(title, 64, L"%d%% complete", *percent);
+        swprintf(pct_text, 64, L"%d%% complete", *percent);
+    }
+    EnterCriticalSection(&p->cs);
+    swprintf(name, MAX_PATH + 16, L"Name:  %s", p->current);
+    LeaveCriticalSection(&p->cs);
+    StrFormatByteSizeW(max(0, p->bytes_total - bytes_done), size, ARRAY_SIZE(size));
+    swprintf(items, 128, L"Items remaining:  %ld (%s)", max(0, p->items_total - p->items_done), size);
+    if (fraction > 0.02 && ms > 1000)
+    {
+        DWORD left = (DWORD)(ms / fraction * (1 - fraction) / 1000);
+        if (left < 60) swprintf(remaining, 64, L"Time remaining:  About %lu second%s", left + 1, left ? L"s" : L"");
+        else if (left < 3600) swprintf(remaining, 64, L"Time remaining:  About %lu minute%s", left / 60 + 1, L"s");
+        else swprintf(remaining, 64, L"Time remaining:  About %lu hours", left / 3600 + 1);
+    }
+    else lstrcpyW(remaining, L"Time remaining:  Calculating...");
+}
+
+static LRESULT CALLBACK progress_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct fileop_progress *p = (struct fileop_progress *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CREATE:
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)((CREATESTRUCTW *)lp)->lpCreateParams);
+        SetTimer(hwnd, 1, 200, NULL);
+        return 0;
+    case WM_TIMER:
+    {
+        WCHAR title[64], headline[256], pct[64], name[MAX_PATH + 16], items[128], remaining[64];
+        int percent;
+        progress_texts(p, title, headline, pct, name, items, remaining, &percent);
+        SetWindowTextW(hwnd, title);
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC wdc = BeginPaint(hwnd, &ps), dc;
+        RECT client, rc, bar;
+        HBITMAP bmp, old_bmp;
+        HFONT font = ui_font(0, 0), big = ui_font(135, FW_NORMAL), old;
+        WCHAR title[64], headline[256], pct[64], name[MAX_PATH + 16], items[128], remaining[64];
+        int percent, m = scale(20);
+
+        progress_texts(p, title, headline, pct, name, items, remaining, &percent);
+        GetClientRect(hwnd, &client);
+        dc = CreateCompatibleDC(wdc);
+        bmp = CreateCompatibleBitmap(wdc, client.right, client.bottom);
+        old_bmp = SelectObject(dc, bmp);
+        fill_rect(dc, &client, C_BG);
+        old = SelectObject(dc, font);
+
+        SetRect(&rc, m, scale(14), client.right - m, scale(34));
+        draw_text(dc, headline, &rc, C_TEXT, DT_SINGLELINE | DT_END_ELLIPSIS);
+        SelectObject(dc, big);
+        SetRect(&rc, m, scale(40), client.right - m, scale(70));
+        draw_text(dc, pct, &rc, C_ACCENT_DK, DT_SINGLELINE);
+        SelectObject(dc, font);
+
+        SetRect(&bar, m, scale(78), client.right - m, scale(90));
+        fill_rect(dc, &bar, C_TRACK);
+        rc = bar;
+        rc.right = bar.left + (bar.right - bar.left) * percent / 100;
+        fill_rect(dc, &rc, C_ACCENT);
+
+        SetRect(&rc, m, scale(102), client.right - m, scale(120));
+        draw_text(dc, name, &rc, C_MUTED, DT_SINGLELINE | DT_PATH_ELLIPSIS);
+        OffsetRect(&rc, 0, scale(20));
+        draw_text(dc, remaining, &rc, C_MUTED, DT_SINGLELINE);
+        OffsetRect(&rc, 0, scale(20));
+        draw_text(dc, items, &rc, C_MUTED, DT_SINGLELINE);
+
+        BitBlt(wdc, 0, 0, client.right, client.bottom, dc, 0, 0, SRCCOPY);
+        SelectObject(dc, old);
+        SelectObject(dc, old_bmp);
+        DeleteObject(bmp);
+        DeleteDC(dc);
+        DeleteObject(font);
+        DeleteObject(big);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDCANCEL)
+        {
+            InterlockedExchange(&p->cancelled, 1);
+            EnableWindow((HWND)lp, FALSE);
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        return 0;
+    case WM_CLOSE:
+        if (WaitForSingleObject(p->done, 0) == WAIT_OBJECT_0) DestroyWindow(hwnd);
+        else InterlockedExchange(&p->cancelled, 1);
+        return 0;
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static DWORD WINAPI progress_thread(void *arg)
+{
+    struct fileop_progress *p = arg;
+    WNDCLASSW wc = { 0 };
+    RECT rc, owner;
+    HWND cancel;
+    MSG msg;
+    HFONT font;
+    int w = scale(480), h = scale(236);
+
+    /* a quick operation shows nothing, as on Windows; nor does one waiting on a question */
+    for (;;)
+    {
+        if (WaitForSingleObject(p->done, 50) == WAIT_OBJECT_0) return 0;
+        if (!p->pausing && elapsed(p) >= PROGRESS_DELAY) break;
+    }
+
+    wc.lpfnWndProc = progress_proc;
+    wc.hInstance = shell32_hInstance;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.lpszClassName = L"SGFileOperation";
+    RegisterClassW(&wc);
+
+    SetRect(&rc, 0, 0, w, h);
+    AdjustWindowRectEx(&rc, WS_CAPTION | WS_SYSMENU, FALSE, 0);
+    if (p->owner && GetWindowRect(p->owner, &owner))
+    {
+        owner.left += (owner.right - owner.left - (rc.right - rc.left)) / 2;
+        owner.top += (owner.bottom - owner.top - (rc.bottom - rc.top)) / 3;
+    }
+    else
+    {
+        SystemParametersInfoW(SPI_GETWORKAREA, 0, &owner, 0);
+        owner.left += (owner.right - owner.left - (rc.right - rc.left)) / 2;
+        owner.top += (owner.bottom - owner.top - (rc.bottom - rc.top)) / 3;
+    }
+    p->hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGFileOperation", L"0% complete",
+                              WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                              max(0, owner.left), max(0, owner.top), rc.right - rc.left, rc.bottom - rc.top,
+                              NULL, NULL, shell32_hInstance, p);
+    font = ui_font(0, 0);
+    cancel = CreateWindowExW(0, L"Button", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
+                             w - scale(20) - scale(88), h - scale(16) - scale(28), scale(88), scale(28),
+                             p->hwnd, (HMENU)IDCANCEL, shell32_hInstance, NULL);
+    SendMessageW(cancel, WM_SETFONT, (WPARAM)font, FALSE);
+    TRACE("showing the progress window %p\n", p->hwnd);
+    ShowWindow(p->hwnd, SW_SHOWNORMAL);
+    UpdateWindow(p->hwnd);
+    while (GetMessageW(&msg, NULL, 0, 0))
+    {
+        if (IsDialogMessageW(p->hwnd, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    DeleteObject(font);
+    return 0;
+}
+
+/* the progress of the operation this thread runs, or NULL */
+struct fileop_progress *fileop_progress_current(void)
+{
+    if (progress_tls == TLS_OUT_OF_INDEXES) return NULL;
+    return TlsGetValue(progress_tls);
+}
+
+struct fileop_progress *fileop_progress_begin(const SHFILEOPSTRUCTW *req)
+{
+    struct fileop_progress *p;
+    const WCHAR *spec;
+
+    if (progress_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD tls = TlsAlloc();
+        if (InterlockedCompareExchange((LONG *)&progress_tls, tls, TLS_OUT_OF_INDEXES) != TLS_OUT_OF_INDEXES)
+            TlsFree(tls);
+    }
+    /* a nested call (a folder's contents) belongs to the operation already running */
+    if ((p = TlsGetValue(progress_tls)))
+    {
+        p->depth++;
+        return p;
+    }
+    if (req->fFlags & FOF_SILENT) return NULL;
+    if (req->wFunc != FO_COPY && req->wFunc != FO_MOVE && req->wFunc != FO_DELETE) return NULL;
+    if (!req->pFrom || !req->pFrom[0]) return NULL;
+
+    p = calloc(1, sizeof(*p));
+    p->func = req->wFunc;
+    p->owner = req->hwnd ? GetAncestor(req->hwnd, GA_ROOT) : GetActiveWindow();
+    InitializeCriticalSection(&p->cs);
+    for (spec = req->pFrom; *spec; spec += lstrlenW(spec) + 1)
+        count_path(p, spec, 0);
+    folder_name(req->pFrom, p->from_name, TRUE);
+    if (req->pTo && req->pTo[0]) folder_name(req->pTo, p->to_name, !PathIsDirectoryW(req->pTo));
+    p->start = GetTickCount();
+    p->done = CreateEventW(NULL, TRUE, FALSE, NULL);
+    p->thread = CreateThread(NULL, 0, progress_thread, p, 0, NULL);
+    TlsSetValue(progress_tls, p);
+    TRACE("%u: %ld items, %s bytes\n", p->func, p->items_total, wine_dbgstr_longlong(p->bytes_total));
+    return p;
+}
+
+void fileop_progress_end(struct fileop_progress *p)
+{
+    if (!p) return;
+    if (p->depth) { p->depth--; return; }
+    TlsSetValue(progress_tls, NULL);
+    SetEvent(p->done);
+    if (p->hwnd) PostMessageW(p->hwnd, WM_CLOSE, 0, 0);
+    if (p->thread)
+    {
+        WaitForSingleObject(p->thread, INFINITE);
+        CloseHandle(p->thread);
+    }
+    CloseHandle(p->done);
+    DeleteCriticalSection(&p->cs);
+    free(p);
+}
+
+void fileop_progress_pause(struct fileop_progress *p, BOOL pause)
+{
+    if (!p) return;
+    if (pause && !p->pausing++) p->pause_start = GetTickCount();
+    else if (!pause && !--p->pausing) p->paused += GetTickCount() - p->pause_start;
+}
+
+void fileop_progress_item(struct fileop_progress *p, const WCHAR *path)
+{
+    if (!p) return;
+    EnterCriticalSection(&p->cs);
+    lstrcpynW(p->current, PathFindFileNameW(path), MAX_PATH);
+    LeaveCriticalSection(&p->cs);
+}
+
+void fileop_progress_done_item(struct fileop_progress *p, LONGLONG bytes)
+{
+    if (!p) return;
+    InterlockedIncrement(&p->items_done);
+    p->bytes_done += bytes;
+    p->file_bytes = 0;
+}
+
+BOOL fileop_progress_cancelled(struct fileop_progress *p)
+{
+    return p && p->cancelled;
+}
+
+static DWORD CALLBACK copy_progress_routine(LARGE_INTEGER total, LARGE_INTEGER transferred, LARGE_INTEGER stream_size,
+                                           LARGE_INTEGER stream_transferred, DWORD stream, DWORD reason,
+                                           HANDLE src, HANDLE dst, void *ctx)
+{
+    struct fileop_progress *p = ctx;
+    p->file_bytes = transferred.QuadPart;
+    return p->cancelled ? PROGRESS_CANCEL : PROGRESS_CONTINUE;
+}
+
+/* CopyFile, reporting its bytes as it goes */
+BOOL fileop_copy_file(struct fileop_progress *p, const WCHAR *src, const WCHAR *dst, BOOL fail_if_exists)
+{
+    BOOL ret;
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+    LONGLONG size = 0;
+
+    if (!p) return CopyFileW(src, dst, fail_if_exists);
+    fileop_progress_item(p, src);
+    if (GetFileAttributesExW(src, GetFileExInfoStandard, &fad))
+        size = ((LONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+    ret = CopyFileExW(src, dst, copy_progress_routine, p, NULL, fail_if_exists ? COPY_FILE_FAIL_IF_EXISTS : 0);
+    fileop_progress_done_item(p, size);
+    return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Replace or Skip Files                                                    */
+
+struct conflict
+{
+    struct fileop_progress *p;
+    const WCHAR *src, *dst;
+    int result;
+    BOOL all;
+    HWND check;
+    HFONT font, big;
+};
+
+#define ID_REPLACE 101
+#define ID_SKIP    102
+#define ID_KEEP    103
+#define ID_ALL     104
+
+static void draw_option_glyph(HDC dc, int id, int x, int y, int s)
+{
+    HPEN pen = CreatePen(PS_SOLID, max(1, s / 8), C_ACCENT), old = SelectObject(dc, pen);
+
+    switch (id)
+    {
+    case ID_REPLACE:  /* a tick */
+        MoveToEx(dc, x + s / 8, y + s / 2, NULL); LineTo(dc, x + s * 3 / 8, y + s * 3 / 4); LineTo(dc, x + s * 7 / 8, y + s / 4);
+        break;
+    case ID_SKIP:     /* an arrow going past */
+        MoveToEx(dc, x + s / 8, y + s / 2, NULL); LineTo(dc, x + s * 7 / 8, y + s / 2);
+        MoveToEx(dc, x + s * 5 / 8, y + s / 4, NULL); LineTo(dc, x + s * 7 / 8, y + s / 2); LineTo(dc, x + s * 5 / 8, y + s * 3 / 4);
+        break;
+    case ID_KEEP:     /* two sheets */
+        Rectangle(dc, x + s / 8, y + s / 8, x + s * 5 / 8, y + s * 3 / 4);
+        Rectangle(dc, x + s * 3 / 8, y + s / 4, x + s * 7 / 8, y + s * 7 / 8);
+        break;
+    }
+    SelectObject(dc, old);
+    DeleteObject(pen);
+}
+
+static LRESULT CALLBACK conflict_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct conflict *c = (struct conflict *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CREATE:
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)((CREATESTRUCTW *)lp)->lpCreateParams);
+        return 0;
+    case WM_ERASEBKGND:
+    {
+        RECT rc;
+        GetClientRect(hwnd, &rc);
+        fill_rect((HDC)wp, &rc, C_BG);
+        return 1;
+    }
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint(hwnd, &ps);
+        RECT client, rc;
+        WCHAR line[MAX_PATH + 128], from[MAX_PATH], to[MAX_PATH];
+        HFONT old;
+        int m = scale(20);
+
+        GetClientRect(hwnd, &client);
+        folder_name(c->src, from, TRUE);
+        folder_name(c->dst, to, TRUE);
+        old = SelectObject(dc, c->font);
+        swprintf(line, ARRAY_SIZE(line), L"%s %ld item%s from %s to %s",
+                 c->p && c->p->func == FO_MOVE ? L"Moving" : L"Copying",
+                 c->p ? max(1, c->p->items_total) : 1, c->p && c->p->items_total > 1 ? L"s" : L"", from, to);
+        SetRect(&rc, m, scale(14), client.right - m, scale(34));
+        draw_text(dc, line, &rc, C_TEXT, DT_SINGLELINE | DT_END_ELLIPSIS);
+        SelectObject(dc, c->big);
+        swprintf(line, ARRAY_SIZE(line), L"The destination already has a file named \"%s\"", PathFindFileNameW(c->dst));
+        SetRect(&rc, m, scale(40), client.right - m, scale(92));
+        draw_text(dc, line, &rc, C_ACCENT_DK, DT_WORDBREAK);
+        SelectObject(dc, old);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_CTLCOLORSTATIC:
+    case WM_CTLCOLORBTN:
+        SetBkColor((HDC)wp, C_BG);
+        return (LRESULT)GetStockObject(WHITE_BRUSH);
+    case WM_DRAWITEM:
+    {
+        DRAWITEMSTRUCT *di = (DRAWITEMSTRUCT *)lp;
+        WCHAR label[128];
+        RECT rc = di->rcItem;
+        int s = scale(22);
+
+        fill_rect(di->hDC, &rc, (di->itemState & (ODS_FOCUS | ODS_SELECTED)) ? C_HOT : C_BG);
+        draw_option_glyph(di->hDC, di->CtlID, rc.left + scale(8), rc.top + (rc.bottom - rc.top - s) / 2, s);
+        GetWindowTextW(di->hwndItem, label, ARRAY_SIZE(label));
+        rc.left += scale(8) + s + scale(12);
+        SelectObject(di->hDC, c->font);
+        SetTextColor(di->hDC, C_TEXT);
+        SetBkMode(di->hDC, TRANSPARENT);
+        DrawTextW(di->hDC, label, -1, &rc, DT_SINGLELINE | DT_VCENTER | DT_HIDEPREFIX);
+        return TRUE;
+    }
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case ID_REPLACE: c->result = CONFLICT_REPLACE; break;
+        case ID_SKIP: c->result = CONFLICT_SKIP; break;
+        case ID_KEEP: c->result = CONFLICT_KEEP_BOTH; break;
+        case IDCANCEL: c->result = CONFLICT_CANCEL; break;
+        default: return 0;
+        }
+        c->all = c->check && SendMessageW(c->check, BM_GETCHECK, 0, 0) == BST_CHECKED;
+        return 0;
+    case WM_CLOSE:
+        c->result = CONFLICT_CANCEL;
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+/* what to do about copying src onto dst, which exists: asks, or answers as asked before */
+int fileop_conflict(struct fileop_progress *p, HWND owner, const WCHAR *src, const WCHAR *dst)
+{
+    struct conflict c = { p, src, dst, 0 };
+    WNDCLASSW wc = { 0 };
+    RECT rc, orc;
+    HWND hwnd, button;
+    MSG msg;
+    int w = scale(460), h, y, i;
+    static const struct { int id; const WCHAR *label; } options[] =
+    {
+        { ID_REPLACE, L"&Replace the file in the destination" },
+        { ID_SKIP, L"&Skip this file" },
+        { ID_KEEP, L"&Keep both files" },
+    };
+
+    if (p && p->conflict_all) return p->conflict_all;
+    if (p && p->hwnd) owner = p->hwnd;
+    else if (p && p->owner) owner = p->owner;
+
+    wc.lpfnWndProc = conflict_proc;
+    wc.hInstance = shell32_hInstance;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.lpszClassName = L"SGFileConflict";
+    RegisterClassW(&wc);
+
+    c.font = ui_font(0, 0);
+    c.big = ui_font(120, FW_NORMAL);
+    h = scale(100) + ARRAY_SIZE(options) * scale(46) + scale(96);
+    SetRect(&rc, 0, 0, w, h);
+    AdjustWindowRectEx(&rc, WS_CAPTION | WS_SYSMENU, FALSE, WS_EX_DLGMODALFRAME);
+    if (!owner || !GetWindowRect(owner, &orc)) SystemParametersInfoW(SPI_GETWORKAREA, 0, &orc, 0);
+    hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGFileConflict", L"Replace or Skip Files",
+                           WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                           max(0, orc.left + (orc.right - orc.left - (rc.right - rc.left)) / 2),
+                           max(0, orc.top + (orc.bottom - orc.top - (rc.bottom - rc.top)) / 3),
+                           rc.right - rc.left, rc.bottom - rc.top, owner, NULL, shell32_hInstance, &c);
+    y = scale(100);
+    for (i = 0; i < ARRAY_SIZE(options); i++, y += scale(46))
+    {
+        button = CreateWindowExW(0, L"Button", options[i].label, WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_OWNERDRAW,
+                                 scale(12), y, w - scale(24), scale(42), hwnd, (HMENU)(INT_PTR)options[i].id,
+                                 shell32_hInstance, NULL);
+        SendMessageW(button, WM_SETFONT, (WPARAM)c.font, FALSE);
+        if (!i) SetFocus(button);
+    }
+    y += scale(10);
+    if (p && p->items_total > 1)
+    {
+        c.check = CreateWindowExW(0, L"Button", L"Do this for &all conflicts", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX,
+                                  scale(20), y, w - scale(140), scale(24), hwnd, (HMENU)ID_ALL, shell32_hInstance, NULL);
+        SendMessageW(c.check, WM_SETFONT, (WPARAM)c.font, FALSE);
+    }
+    button = CreateWindowExW(0, L"Button", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
+                             w - scale(20) - scale(88), h - scale(16) - scale(28), scale(88), scale(28), hwnd,
+                             (HMENU)IDCANCEL, shell32_hInstance, NULL);
+    SendMessageW(button, WM_SETFONT, (WPARAM)c.font, FALSE);
+
+    fileop_progress_pause(p, TRUE);
+    if (owner) EnableWindow(owner, FALSE);
+    ShowWindow(hwnd, SW_SHOWNORMAL);
+    SetForegroundWindow(hwnd);
+    TRACE("asking about %s\n", debugstr_w(dst));
+    while (!c.result && GetMessageW(&msg, NULL, 0, 0))
+    {
+        if ((msg.message == WM_CHAR || msg.message == WM_SYSCHAR) && (msg.hwnd == hwnd || IsChild(hwnd, msg.hwnd)))
+        {
+            WCHAR ch = towlower(msg.wParam);
+            if (ch == 'r') { SendMessageW(hwnd, WM_COMMAND, ID_REPLACE, 0); continue; }
+            if (ch == 's') { SendMessageW(hwnd, WM_COMMAND, ID_SKIP, 0); continue; }
+            if (ch == 'k') { SendMessageW(hwnd, WM_COMMAND, ID_KEEP, 0); continue; }
+            if (ch == 'a' && c.check)
+            {
+                SendMessageW(c.check, BM_SETCHECK, SendMessageW(c.check, BM_GETCHECK, 0, 0) == BST_CHECKED ? BST_UNCHECKED : BST_CHECKED, 0);
+                continue;
+            }
+        }
+        if (IsDialogMessageW(hwnd, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    if (owner) EnableWindow(owner, TRUE);
+    DestroyWindow(hwnd);
+    DeleteObject(c.font);
+    DeleteObject(c.big);
+    if (!c.result) c.result = CONFLICT_CANCEL;
+    if (p)
+    {
+        fileop_progress_pause(p, FALSE);
+        if (c.all && c.result != CONFLICT_CANCEL) p->conflict_all = c.result;
+        if (c.result == CONFLICT_CANCEL) InterlockedExchange(&p->cancelled, 1);
+    }
+    TRACE("answer %d%s\n", c.result, c.all ? " for all" : "");
+    return c.result;
+}
+
+/* "name (2).ext": the first name beside dst that is free */
+void fileop_unique_name(const WCHAR *dst, WCHAR *out)
+{
+    WCHAR base[MAX_PATH], ext[MAX_PATH];
+    const WCHAR *dot;
+    int i;
+
+    lstrcpynW(base, dst, MAX_PATH);
+    dot = PathFindExtensionW(dst);
+    lstrcpynW(ext, dot, MAX_PATH);
+    base[dot - dst] = 0;
+    for (i = 2; i < 10000; i++)
+    {
+        swprintf(out, MAX_PATH, L"%s (%d)%s", base, i, ext);
+        if (GetFileAttributesW(out) == INVALID_FILE_ATTRIBUTES) return;
+    }
+}
