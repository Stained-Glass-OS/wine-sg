+/* returns 0 to go on, else the action that ends the copy */
+static int report_copy( struct copy_progress *cp, DWORD reason, LONGLONG total, LONGLONG done, LONGLONG chunk,
+                        LONGLONG chunk_size, HANDLE h1, HANDLE h2 )
+{
+    if (cp->cancel && *cp->cancel) return PROGRESS_CANCEL;
+    if (cp->quiet) return 0;
+    if (cp->routine)
+    {
+        LARGE_INTEGER t, d;
+        DWORD ret;
+        t.QuadPart = total;
+        d.QuadPart = done;
+        ret = cp->routine( t, d, t, d, 1, reason, h1, h2, cp->param );
+        if (ret == PROGRESS_QUIET) cp->quiet = TRUE;
+        else if (ret == PROGRESS_CANCEL || ret == PROGRESS_STOP) return ret;
+    }
+    if (cp->routine2)
+    {
+        COPYFILE2_MESSAGE msg;
+        COPYFILE2_MESSAGE_ACTION ret;
+
+        memset( &msg, 0, sizeof(msg) );
+        if (reason == CALLBACK_STREAM_SWITCH)
+        {
+            msg.Type = COPYFILE2_CALLBACK_STREAM_STARTED;
+            msg.Info.StreamStarted.dwStreamNumber = 1;
+            msg.Info.StreamStarted.hSourceFile = h1;
+            msg.Info.StreamStarted.hDestinationFile = h2;
+            msg.Info.StreamStarted.uliStreamSize.QuadPart = total;
+            msg.Info.StreamStarted.uliTotalFileSize.QuadPart = total;
+        }
+        else
+        {
+            msg.Type = COPYFILE2_CALLBACK_CHUNK_FINISHED;
+            msg.Info.ChunkFinished.dwStreamNumber = 1;
+            msg.Info.ChunkFinished.hSourceFile = h1;
+            msg.Info.ChunkFinished.hDestinationFile = h2;
+            msg.Info.ChunkFinished.uliChunkNumber.QuadPart = chunk;
+            msg.Info.ChunkFinished.uliChunkSize.QuadPart = chunk_size;
+            msg.Info.ChunkFinished.uliStreamSize.QuadPart = total;
+            msg.Info.ChunkFinished.uliStreamBytesTransferred.QuadPart = done;
+            msg.Info.ChunkFinished.uliTotalFileSize.QuadPart = total;
+            msg.Info.ChunkFinished.uliTotalBytesTransferred.QuadPart = done;
+        }
+        ret = cp->routine2( &msg, cp->context2 );
+        if (ret == COPYFILE2_PROGRESS_QUIET) cp->quiet = TRUE;
+        else if (ret == COPYFILE2_PROGRESS_CANCEL) return PROGRESS_CANCEL;
+        else if (ret == COPYFILE2_PROGRESS_STOP) return PROGRESS_STOP;
+    }
+    return 0;
+}
