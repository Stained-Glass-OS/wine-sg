From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 22:48:24 -0700
Subject: [PATCH] inetcomm: IMimeMessage::InsertBody and DeleteBody

InsertBody creates an empty body as the root, first or last child of a pivot,
or before/after it; DeleteBody removes a body with its children (flags other
than 0 give MIME_E_INVALID_DELETE_TYPE: their names are not in a source we may
use). Deleting changes what is saved. GetBody on an empty tree no longer
returns a bad handle.

diff --git a/dlls/inetcomm/mimeole.c b/dlls/inetcomm/mimeole.c
index 7aa6949..ddaa523 100644
--- a/dlls/inetcomm/mimeole.c
+++ b/dlls/inetcomm/mimeole.c
@@ -3521,11 +3521,14 @@ static HRESULT WINAPI MimeMessage_SaveBody(
 
 static HRESULT get_body(MimeMessage *msg, BODYLOCATION location, HBODY pivot, body_t **out)
 {
-    body_t *root = LIST_ENTRY(list_head(&msg->body_tree), body_t, entry);
+    body_t *root;
     body_t *body;
     HRESULT hr;
     struct list *list;
 
+    if(list_empty(&msg->body_tree)) return MIME_E_NOT_FOUND;
+    root = LIST_ENTRY(list_head(&msg->body_tree), body_t, entry);
+
     if(location == IBL_ROOT)
     {
         *out = root;
@@ -3593,8 +3596,67 @@ static HRESULT WINAPI MimeMessage_InsertBody(
     HBODY hPivot,
     LPHBODY phBody)
 {
-    FIXME("(%p)->(%d, %p, %p)\n", iface, location, hPivot, phBody);
-    return E_NOTIMPL;
+    MimeMessage *This = impl_from_IMimeMessage(iface);
+    body_t *pivot = NULL, *body, *parent = NULL;
+    struct list *where;
+    MimeBody *mime_body;
+
+    TRACE("(%p)->(%d, %p, %p)\n", iface, location, hPivot, phBody);
+
+    if (phBody) *phBody = NULL;
+
+    if (location == IBL_ROOT)
+    {
+        /* the tree has a single root */
+        if (!list_empty(&This->body_tree)) return MIME_E_INVALID_HANDLE;
+        where = &This->body_tree;
+    }
+    else
+    {
+        if (list_empty(&This->body_tree) || find_body(&This->body_tree, hPivot, &pivot) != S_OK)
+            return MIME_E_INVALID_HANDLE;
+        switch (location)
+        {
+        case IBL_FIRST:
+            parent = pivot;
+            where = &pivot->children;
+            break;
+        case IBL_LAST:
+            parent = pivot;
+            where = list_tail(&pivot->children);
+            if (!where) where = &pivot->children;
+            break;
+        case IBL_NEXT:
+            if (!pivot->parent) return MIME_E_INVALID_HANDLE;
+            parent = pivot->parent;
+            where = &pivot->entry;
+            break;
+        case IBL_PREVIOUS:
+            if (!pivot->parent) return MIME_E_INVALID_HANDLE;
+            parent = pivot->parent;
+#ifdef SG_MUTANT_INET_INSERTORDER
+            where = &pivot->entry;
+#else
+            where = pivot->entry.prev;
+#endif
+            break;
+        default:
+            return E_INVALIDARG;
+        }
+    }
+
+    if (!(mime_body = mimebody_create())) return E_OUTOFMEMORY;
+    if (!(body = new_body_entry(mime_body, This->next_index++, parent)))
+    {
+        IMimeBody_Release(&mime_body->IMimeBody_iface);
+        return E_OUTOFMEMORY;
+    }
+    mime_body->dirty = TRUE;
+    if (location == IBL_FIRST) list_add_head(&pivot->children, &body->entry);
+    else list_add_after(where, &body->entry);
+    if (parent) parent->mime_body->dirty = TRUE;
+    if (phBody) *phBody = UlongToHandle(body->index);
+    return S_OK;
 }
 
 static HRESULT WINAPI MimeMessage_GetBody(IMimeMessage *iface, BODYLOCATION location, HBODY hPivot,
@@ -3623,8 +3685,28 @@ static HRESULT WINAPI MimeMessage_DeleteBody(
     HBODY hBody,
     DWORD dwFlags)
 {
-    FIXME("(%p)->(%p, %08lx)\n", iface, hBody, dwFlags);
-    return E_NOTIMPL;
+    MimeMessage *This = impl_from_IMimeMessage(iface);
+    body_t *body;
+    struct list one;
+
+    TRACE("(%p)->(%p, %08lx)\n", iface, hBody, dwFlags);
+
+    /* only the plain deletion (the body and everything below it) is known */
+    if (dwFlags) return MIME_E_INVALID_DELETE_TYPE;
+    if (list_empty(&This->body_tree) || find_body(&This->body_tree, hBody, &body) != S_OK) return MIME_E_INVALID_HANDLE;
+
+    /* what is saved no longer matches the text it was loaded from */
+    if (body->parent) body->parent->mime_body->dirty = TRUE;
+    else if (This->stream) { IStream_Release(This->stream); This->stream = NULL; }
+
+#ifdef SG_MUTANT_INET_NODELETE
+    return S_OK;
+#endif
+    list_init(&one);
+    list_remove(&body->entry);
+    list_add_tail(&one, &body->entry);
+    empty_body_list(&one);
+    return S_OK;
 }
 
 static HRESULT WINAPI MimeMessage_MoveBody(
