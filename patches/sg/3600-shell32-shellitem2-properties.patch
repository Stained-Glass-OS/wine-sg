+/* The properties a shell item can answer itself, from its names and, for file system
+ * items, from the file's attributes.  Anything else is asked of the parent folder. */
+static BOOL shellitem_fs_path(struct shell_item *This, WCHAR *path)
+{
+    WCHAR *str;
+    BOOL ret = FALSE;
+
+    if (SUCCEEDED(SHGetNameFromIDList(This->pidl, SIGDN_FILESYSPATH, &str)))
+    {
+        ret = lstrlenW(str) < MAX_PATH;
+        if (ret) lstrcpyW(path, str);
+        CoTaskMemFree(str);
+    }
+    return ret;
+}
+
+static HRESULT shellitem_set_string(PROPVARIANT *var, const WCHAR *str)
+{
+    HRESULT hr = SHStrDupW(str, &var->pwszVal);
+
+    if (SUCCEEDED(hr)) var->vt = VT_LPWSTR;
+    return hr;
+}
+
+static HRESULT shellitem_set_name(struct shell_item *This, PROPVARIANT *var, SIGDN sigdn)
+{
+    WCHAR *str;
+    HRESULT hr = SHGetNameFromIDList(This->pidl, sigdn, &str);
+
+    if (SUCCEEDED(hr))
+    {
+        hr = shellitem_set_string(var, str);
+        CoTaskMemFree(str);
+    }
+    return hr;
+}
+
+static HRESULT shellitem_get_value(struct shell_item *This, const PROPERTYKEY *key, PROPVARIANT *var)
+{
+    WIN32_FILE_ATTRIBUTE_DATA data;
+    WCHAR path[MAX_PATH], *p;
+    BOOL has_path;
+
+    PropVariantInit(var);
+
+    if (IsEqualPropertyKey(*key, SI_ItemNameDisplay))
+        return shellitem_set_name(This, var, SIGDN_NORMALDISPLAY);
+    if (IsEqualPropertyKey(*key, SI_ItemPathDisplay))
+        return shellitem_set_name(This, var, SIGDN_DESKTOPABSOLUTEEDITING);
+    if (IsEqualPropertyKey(*key, SI_ItemFolderPathDisplay))
+    {
+        WCHAR *str;
+        HRESULT hr = SHGetNameFromIDList(This->pidl, SIGDN_DESKTOPABSOLUTEEDITING, &str);
+
+        if (FAILED(hr)) return hr;
+        if ((p = wcsrchr(str, '\\'))) *p = 0;
+        hr = shellitem_set_string(var, str);
+        CoTaskMemFree(str);
+        return hr;
+    }
+
+    has_path = shellitem_fs_path(This, path);
+    if (!has_path || !GetFileAttributesExW(path, GetFileExInfoStandard, &data))
+        return S_OK; /* not a file system item: no value from here */
+
+    p = wcsrchr(path, '\\');
+    p = p ? p + 1 : path;
+
+    if (IsEqualPropertyKey(*key, SI_FileName))
+        return shellitem_set_string(var, p);
+    if (IsEqualPropertyKey(*key, SI_ItemNameDisplayWithoutExtension))
+    {
+        WCHAR name[MAX_PATH], *ext;
+
+        lstrcpyW(name, p);
+        if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) && (ext = wcsrchr(name, '.')) && ext != name)
+            *ext = 0;
+        return shellitem_set_string(var, name);
+    }
+    if (IsEqualPropertyKey(*key, SI_FileExtension))
+    {
+        WCHAR *ext = wcsrchr(p, '.');
+
+        if (!ext || (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) return S_OK;
+        return shellitem_set_string(var, ext);
+    }
+    if (IsEqualPropertyKey(*key, SI_ItemType))
+    {
+        WCHAR *ext = wcsrchr(p, '.');
+
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) return shellitem_set_string(var, L"Directory");
+        if (!ext) return S_OK;
+        return shellitem_set_string(var, ext);
+    }
+    if (IsEqualPropertyKey(*key, SI_FileAttributes))
+    {
+        var->vt = VT_UI4;
+        var->ulVal = data.dwFileAttributes;
+        return S_OK;
+    }
+    if (IsEqualPropertyKey(*key, SI_Size))
+    {
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) return S_OK;
+        var->vt = VT_UI8;
+        var->uhVal.QuadPart = ((ULONGLONG)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+#ifdef SG_MUTANT_SHITEM_SIZE
+        var->uhVal.QuadPart = data.nFileSizeHigh;
+#endif
+        return S_OK;
+    }
+    if (IsEqualPropertyKey(*key, SI_DateModified))
+    {
+        var->vt = VT_FILETIME;
+        var->filetime = data.ftLastWriteTime;
+        return S_OK;
+    }
+    if (IsEqualPropertyKey(*key, SI_DateCreated))
+    {
+        var->vt = VT_FILETIME;
+        var->filetime = data.ftCreationTime;
+        return S_OK;
+    }
+    if (IsEqualPropertyKey(*key, SI_DateAccessed))
+    {
+        var->vt = VT_FILETIME;
+        var->filetime = data.ftLastAccessTime;
+        return S_OK;
+    }
+
+    return S_OK;
+}
+
+static HRESULT shellitem_get_variant(struct shell_item *This, const PROPERTYKEY *key, PROPVARIANT *var)
+{
+    IShellFolder2 *folder;
+    LPCITEMIDLIST child;
+    HRESULT hr;
+
+    hr = shellitem_get_value(This, key, var);
+    if (FAILED(hr) || var->vt != VT_EMPTY || _ILIsDesktop(This->pidl))
+        return hr;
+
+    /* the folder the item is in may know it */
+    if (SUCCEEDED(SHBindToParent(This->pidl, &IID_IShellFolder2, (void **)&folder, &child)))
+    {
+        VARIANT v;
+
+        VariantInit(&v);
+        if (SUCCEEDED(IShellFolder2_GetDetailsEx(folder, child, (const SHCOLUMNID *)key, &v)) && V_VT(&v) != VT_EMPTY)
+        {
+            PropVariantInit(var);
+            if (FAILED(VariantToPropVariant(&v, var))) PropVariantInit(var);
+        }
+        VariantClear(&v);
+        IShellFolder2_Release(folder);
+    }
+    return S_OK;
+}
+
+static HRESULT shellitem_create_store(struct shell_item *This, const PROPERTYKEY *keys, UINT count,
+    GETPROPERTYSTOREFLAGS flags, REFIID riid, void **ppv)
+{
+    static const PROPERTYKEY *all[] =
+    {
+        &SI_ItemNameDisplay, &SI_ItemNameDisplayWithoutExtension, &SI_ItemPathDisplay,
+        &SI_ItemFolderPathDisplay, &SI_FileName, &SI_FileExtension, &SI_ItemType,
+        &SI_FileAttributes, &SI_Size, &SI_DateModified, &SI_DateCreated, &SI_DateAccessed,
+    };
+    IPropertyStore *store;
+    HRESULT hr;
+    UINT i;
+
+    if (!ppv) return E_POINTER;
+    *ppv = NULL;
+
+#ifndef SG_MUTANT_SHITEM_RW
+    if (flags & GPS_READWRITE) return STG_E_ACCESSDENIED;
+#endif
+
+    if (FAILED(hr = PSCreateMemoryPropertyStore(&IID_IPropertyStore, (void **)&store)))
+        return hr;
+
+    for (i = 0; SUCCEEDED(hr) && i < (keys ? count : ARRAY_SIZE(all)); i++)
+    {
+        const PROPERTYKEY *key = keys ? &keys[i] : all[i];
+        PROPVARIANT var;
+
+        if (FAILED(hr = shellitem_get_variant(This, key, &var))) break;
+#ifdef SG_MUTANT_SHITEM_STORE
+        var.vt = VT_EMPTY;
+#endif
+        if (var.vt != VT_EMPTY) hr = IPropertyStore_SetValue(store, key, &var);
+        PropVariantClear(&var);
+    }
+
+    if (SUCCEEDED(hr)) hr = IPropertyStore_QueryInterface(store, riid, ppv);
+    IPropertyStore_Release(store);
+    return hr;
+}
+
+static HRESULT shellitem_get_typed(IShellItem2 *iface, const PROPERTYKEY *key, PROPVARIANT *var)
+{
+    if (!key) return E_INVALIDARG;
+    return shellitem_get_variant(impl_from_IShellItem2(iface), key, var);
+}
