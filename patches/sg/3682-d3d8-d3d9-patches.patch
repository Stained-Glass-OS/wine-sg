+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "d3d8_private.h"
+#include "../d3d9/patch_eval.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d8);
+
+struct d3d8_patch
+{
+    struct list entry;
+    UINT handle;
+    struct patch_mesh mesh;
+};
+
+void d3d8_device_free_patches(struct d3d8_device *device)
+{
+    struct d3d8_patch *patch, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(patch, next, &device->patches, struct d3d8_patch, entry)
+    {
+        list_remove(&patch->entry);
+        patch_free_mesh(&patch->mesh);
+        free(patch);
+    }
+}
+
+static struct d3d8_patch *find_patch(struct d3d8_device *device, UINT handle)
+{
+    struct d3d8_patch *patch;
+
+    LIST_FOR_EACH_ENTRY(patch, &device->patches, struct d3d8_patch, entry)
+        if (patch->handle == handle)
+            return patch;
+    return NULL;
+}
+
+static unsigned int type_size(unsigned int type)
+{
+    switch (type)
+    {
+        case D3DVSDT_FLOAT1: return 4;
+        case D3DVSDT_FLOAT2: return 8;
+        case D3DVSDT_FLOAT3: return 12;
+        case D3DVSDT_FLOAT4: return 16;
+        case D3DVSDT_D3DCOLOR: case D3DVSDT_UBYTE4: case D3DVSDT_SHORT2: return 4;
+        case D3DVSDT_SHORT4: return 8;
+        default: return 0;
+    }
+}
+
+/* the layout of the vertices of stream 0: an FVF, or the stream data tokens of a vertex shader declaration */
+static HRESULT get_elements(struct d3d8_device *device, UINT stride, struct patch_element **out, unsigned int *count)
+{
+    struct wined3d_vertex_declaration *wined3d_declaration;
+    struct d3d8_vertex_declaration *declaration;
+    struct patch_element *elements;
+    unsigned int k = 0, offset = 0;
+
+    *out = NULL;
+    *count = 0;
+    if (!(wined3d_declaration = device->stateblock_state->vertex_declaration))
+        return D3DERR_INVALIDCALL;
+    declaration = wined3d_vertex_declaration_get_parent(wined3d_declaration);
+    if (!(elements = calloc(64, sizeof(*elements))))
+        return E_OUTOFMEMORY;
+
+    if (!declaration->elements)
+    {
+        DWORD fvf = declaration->shader_handle, pos = fvf & D3DFVF_POSITION_MASK;
+        unsigned int i, tex = (fvf & D3DFVF_TEXCOUNT_MASK) >> D3DFVF_TEXCOUNT_SHIFT;
+
+        if (pos == D3DFVF_XYZRHW)
+        {
+            elements[k].offset = offset; elements[k++].type = D3DVSDT_FLOAT4; offset += 16;
+        }
+        else if (pos >= D3DFVF_XYZ && pos <= D3DFVF_XYZB5)
+        {
+            unsigned int blend = pos == D3DFVF_XYZ ? 0 : (pos - D3DFVF_XYZB1) / 2 + 1;
+
+            elements[k].offset = offset; elements[k++].type = D3DVSDT_FLOAT3; offset += 12;
+            for (i = 0; i < blend; ++i)
+            {
+                elements[k].offset = offset; elements[k++].type = D3DVSDT_FLOAT1; offset += 4;
+            }
+        }
+        if (fvf & D3DFVF_NORMAL)
+        {
+            elements[k].offset = offset; elements[k++].type = D3DVSDT_FLOAT3; offset += 12;
+        }
+        if (fvf & D3DFVF_PSIZE)
+        {
+            elements[k].offset = offset; elements[k++].type = D3DVSDT_FLOAT1; offset += 4;
+        }
+        if (fvf & D3DFVF_DIFFUSE)
+        {
+            elements[k].offset = offset; elements[k++].type = D3DVSDT_D3DCOLOR; offset += 4;
+        }
+        if (fvf & D3DFVF_SPECULAR)
+        {
+            elements[k].offset = offset; elements[k++].type = D3DVSDT_D3DCOLOR; offset += 4;
+        }
+        for (i = 0; i < tex && k < 60; ++i)
+        {
+            static const unsigned int types[4] = {D3DVSDT_FLOAT2, D3DVSDT_FLOAT3, D3DVSDT_FLOAT4, D3DVSDT_FLOAT1};
+            unsigned int t = (fvf >> (16 + i * 2)) & 3;
+
+            elements[k].offset = offset; elements[k++].type = types[t]; offset += type_size(types[t]);
+        }
+    }
+    else
+    {
+        const DWORD *token = declaration->elements;
+        unsigned int stream = 0;
+
+        while (*token != D3DVSD_END() && k < 63)
+        {
+            DWORD token_type = (*token & D3DVSD_TOKENTYPEMASK) >> D3DVSD_TOKENTYPESHIFT;
+
+            if (token_type == D3DVSD_TOKEN_STREAM && !(*token & D3DVSD_STREAMTESSMASK))
+            {
+                stream = (*token & D3DVSD_STREAMNUMBERMASK) >> D3DVSD_STREAMNUMBERSHIFT;
+                offset = 0;
+            }
+            else if (token_type == D3DVSD_TOKEN_STREAMDATA && !(*token & D3DVSD_DATALOADTYPEMASK))
+            {
+                DWORD type = (*token & D3DVSD_DATATYPEMASK) >> D3DVSD_DATATYPESHIFT;
+
+                if (!stream && type_size(type))
+                {
+                    elements[k].offset = offset;
+                    elements[k++].type = type;
+                }
+                offset += type_size(type);
+            }
+            else if (token_type == D3DVSD_TOKEN_STREAMDATA)
+                offset += sizeof(DWORD) * ((*token & D3DVSD_SKIPCOUNTMASK) >> D3DVSD_SKIPCOUNTSHIFT);
+            token += parse_token(token);
+        }
+    }
+    /* components the vertex does not have room for are not evaluated */
+    {
+        unsigned int i, n = 0;
+
+        for (i = 0; i < k; ++i)
+            if (elements[i].offset + type_size(elements[i].type) <= stride)
+                elements[n++] = elements[i];
+        k = n;
+    }
+    *out = elements;
+    *count = k;
+    return S_OK;
+}
+
+static HRESULT draw_mesh(IDirect3DDevice8 *iface, const struct patch_mesh *mesh)
+{
+    IDirect3DVertexBuffer8 *vb = NULL;
+    IDirect3DIndexBuffer8 *ib = NULL;
+    UINT stride = 0, base = 0;
+    HRESULT hr;
+
+    IDirect3DDevice8_GetStreamSource(iface, 0, &vb, &stride);
+    IDirect3DDevice8_GetIndices(iface, &ib, &base);
+    hr = IDirect3DDevice8_DrawIndexedPrimitiveUP(iface, D3DPT_TRIANGLELIST, 0, mesh->vertex_count,
+            mesh->index_count / 3, mesh->indices, D3DFMT_INDEX32, mesh->vertices, mesh->stride);
+    /* a patch leaves the caller's bindings alone, a user-pointer draw does not */
+#ifndef PATCH_MUT_NORESTORE
+    IDirect3DDevice8_SetStreamSource(iface, 0, vb, stride);
+    IDirect3DDevice8_SetIndices(iface, ib, base);
+#endif
+    if (vb) IDirect3DVertexBuffer8_Release(vb);
+    if (ib) IDirect3DIndexBuffer8_Release(ib);
+    return hr;
+}
+
+/* the control points: a read-only copy of stream 0 */
+static HRESULT read_stream(IDirect3DDevice8 *iface, unsigned char **data, SIZE_T *size, UINT *stride)
+{
+    IDirect3DVertexBuffer8 *vb = NULL;
+    D3DVERTEXBUFFER_DESC desc;
+    BYTE *ptr;
+    HRESULT hr;
+
+    *data = NULL;
+    if (FAILED(hr = IDirect3DDevice8_GetStreamSource(iface, 0, &vb, stride)) || !vb || !*stride)
+    {
+        if (vb) IDirect3DVertexBuffer8_Release(vb);
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DVertexBuffer8_GetDesc(vb, &desc);
+    *size = desc.Size;
+    if (!(*data = malloc(*size)))
+    {
+        IDirect3DVertexBuffer8_Release(vb);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = IDirect3DVertexBuffer8_Lock(vb, 0, 0, &ptr, D3DLOCK_READONLY)))
+    {
+        free(*data);
+        *data = NULL;
+    }
+    else
+    {
+        memcpy(*data, ptr, *size);
+        IDirect3DVertexBuffer8_Unlock(vb);
+    }
+    IDirect3DVertexBuffer8_Release(vb);
+    return hr;
+}
+
+static HRESULT store_and_draw(struct d3d8_device *device, UINT handle, struct patch_mesh *mesh)
+{
+    HRESULT hr = draw_mesh(&device->IDirect3DDevice8_iface, mesh);
+
+#ifdef PATCH_MUT_NOCACHE
+    if (0)
+#else
+    if (handle)
+#endif
+    {
+        struct d3d8_patch *patch = find_patch(device, handle);
+
+        if (!patch)
+        {
+            if (!(patch = calloc(1, sizeof(*patch))))
+            {
+                patch_free_mesh(mesh);
+                return E_OUTOFMEMORY;
+            }
+            patch->handle = handle;
+            list_add_tail(&device->patches, &patch->entry);
+        }
+        else patch_free_mesh(&patch->mesh);
+        patch->mesh = *mesh;
+        memset(mesh, 0, sizeof(*mesh));
+    }
+    else patch_free_mesh(mesh);
+    return hr;
+}
+
+HRESULT d3d8_device_draw_patch(struct d3d8_device *device, UINT handle, const float *segments,
+        const D3DRECTPATCH_INFO *rect, const D3DTRIPATCH_INFO *tri)
+{
+    IDirect3DDevice8 *iface = &device->IDirect3DDevice8_iface;
+    struct patch_element *elements = NULL;
+    unsigned int element_count = 0, ok;
+    unsigned char *data = NULL;
+    struct patch_mesh mesh;
+    struct d3d8_patch *cached;
+    struct patch_basis_info basis;
+    SIZE_T size;
+    UINT stride;
+    HRESULT hr;
+
+    if (!rect && !tri)
+    {
+        /* no description: draw the patch remembered for the handle */
+        if (!handle || !(cached = find_patch(device, handle)))
+        {
+            WARN("No patch cached for handle %#x.\n", handle);
+            return D3DERR_INVALIDCALL;
+        }
+        return draw_mesh(iface, &cached->mesh);
+    }
+    if (!segments)
+        return D3DERR_INVALIDCALL;
+
+    if (FAILED(hr = read_stream(iface, &data, &size, &stride)))
+        return hr;
+    if (FAILED(hr = get_elements(device, stride, &elements, &element_count)))
+    {
+        free(data);
+        return hr;
+    }
+
+    if (rect)
+    {
+        basis.basis = rect->Basis;
+        basis.degree = rect->Order;
+        if (!rect->Width || !rect->Height || rect->Stride < rect->Width
+                || ((SIZE_T)(rect->StartVertexOffsetHeight + rect->Height - 1) * rect->Stride + rect->StartVertexOffsetWidth
+                + rect->Width) * stride > size)
+            ok = 0;
+        else
+            ok = patch_tessellate_rect(elements, element_count, stride, data, rect->StartVertexOffsetWidth,
+                    rect->StartVertexOffsetHeight, rect->Width, rect->Height, rect->Stride, &basis, segments, &mesh);
+    }
+    else
+    {
+        basis.basis = tri->Basis;
+        basis.degree = tri->Order;
+        if (((SIZE_T)tri->StartVertexOffset + tri->NumVertices) * stride > size)
+            ok = 0;
+        else
+            ok = patch_tessellate_tri(elements, element_count, stride, data, tri->StartVertexOffset, tri->NumVertices,
+                    &basis, segments, &mesh);
+    }
+    free(elements);
+    free(data);
+    if (!ok)
+    {
+        WARN("Invalid patch description.\n");
+        return D3DERR_INVALIDCALL;
+    }
+    return store_and_draw(device, handle, &mesh);
+}
+
+HRESULT d3d8_device_delete_patch(struct d3d8_device *device, UINT handle)
+{
+    struct d3d8_patch *patch = find_patch(device, handle);
+
+    if (!patch)
+        return D3DERR_INVALIDCALL;
+    list_remove(&patch->entry);
+    patch_free_mesh(&patch->mesh);
+    free(patch);
+    return D3D_OK;
+}
