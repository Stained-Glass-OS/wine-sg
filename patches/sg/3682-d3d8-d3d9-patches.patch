--- /dev/null
+++ b/dlls/d3d8/patch.c
@@ -0,0 +1,340 @@
+/*
+ * IDirect3DDevice8::DrawRectPatch, DrawTriPatch and DeletePatch
+ *
+ * The control points are read from stream 0 with the current vertex declaration, the patch is tessellated
+ * on the CPU (../d3d9/patch_eval.h) and drawn as an indexed triangle list; the stream and index bindings the caller
+ * had are put back afterwards. A patch with a non-zero handle is remembered, so that a later call with the
+ * same handle and no patch description draws it again until DeletePatch (or a device Reset) drops it.
+ *
+ * Copyright 2026 Stained Glass OS contributors
