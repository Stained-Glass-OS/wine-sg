diff --git a/dlls/d3d9/patch.c b/dlls/d3d9/patch.c
new file mode 100644
index 0000000..81e6eb6
--- /dev/null
+++ b/dlls/d3d9/patch.c
@@ -0,0 +1,291 @@
+/*
+ * IDirect3DDevice9::DrawRectPatch, DrawTriPatch and DeletePatch
+ *
+ * The control points are read from stream 0 with the current vertex declaration, the patch is tessellated
+ * on the CPU (patch_eval.h) and drawn as an indexed triangle list; the stream and index bindings the caller
+ * had are put back afterwards. A patch with a non-zero handle is remembered, so that a later call with the
+ * same handle and no patch description draws it again until DeletePatch (or a device Reset) drops it.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "d3d9_private.h"
+#include "patch_eval.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d9);
+
+struct d3d9_patch
+{
+    struct list entry;
+    UINT handle;
+    struct patch_mesh mesh;
+};
+
+void d3d9_device_free_patches(struct d3d9_device *device)
+{
+    struct d3d9_patch *patch, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(patch, next, &device->patches, struct d3d9_patch, entry)
+    {
+        list_remove(&patch->entry);
+        patch_free_mesh(&patch->mesh);
+        free(patch);
+    }
+}
+
+static struct d3d9_patch *find_patch(struct d3d9_device *device, UINT handle)
+{
+    struct d3d9_patch *patch;
+
+    LIST_FOR_EACH_ENTRY(patch, &device->patches, struct d3d9_patch, entry)
+        if (patch->handle == handle)
+            return patch;
+    return NULL;
+}
+
+static unsigned int element_size(unsigned int type)
+{
+    switch (type)
+    {
+        case D3DDECLTYPE_FLOAT1: return 4;
+        case D3DDECLTYPE_FLOAT2: return 8;
+        case D3DDECLTYPE_FLOAT3: return 12;
+        case D3DDECLTYPE_FLOAT4: return 16;
+        case D3DDECLTYPE_D3DCOLOR: case D3DDECLTYPE_UBYTE4: case D3DDECLTYPE_UBYTE4N:
+        case D3DDECLTYPE_SHORT2: case D3DDECLTYPE_SHORT2N: case D3DDECLTYPE_USHORT2N: return 4;
+        case D3DDECLTYPE_SHORT4: case D3DDECLTYPE_SHORT4N: case D3DDECLTYPE_USHORT4N: return 8;
+        default: return 0;
+    }
+}
+
+/* the stream 0 elements of the current vertex declaration that a patch can evaluate */
+static HRESULT get_elements(IDirect3DDevice9Ex *iface, UINT stride, struct patch_element **out, unsigned int *count)
+{
+    IDirect3DVertexDeclaration9 *decl = NULL;
+    D3DVERTEXELEMENT9 *decl_elements = NULL;
+    struct patch_element *elements;
+    UINT n = 0, i, k = 0;
+    HRESULT hr;
+
+    *out = NULL;
+    *count = 0;
+    if (FAILED(hr = IDirect3DDevice9Ex_GetVertexDeclaration(iface, &decl)) || !decl)
+        return D3DERR_INVALIDCALL;
+    if (FAILED(hr = IDirect3DVertexDeclaration9_GetDeclaration(decl, NULL, &n)))
+        goto done;
+    if (!(decl_elements = malloc(n * sizeof(*decl_elements))) || !(elements = malloc(n * sizeof(*elements))))
+    {
+        free(decl_elements);
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (FAILED(hr = IDirect3DVertexDeclaration9_GetDeclaration(decl, decl_elements, &n)))
+    {
+        free(decl_elements);
+        free(elements);
+        goto done;
+    }
+    for (i = 0; i < n; ++i)
+    {
+        if (decl_elements[i].Stream == 0xff || decl_elements[i].Stream != 0)
+            continue;
+        if (!element_size(decl_elements[i].Type) || decl_elements[i].Offset + element_size(decl_elements[i].Type) > stride)
+            continue;
+        elements[k].offset = decl_elements[i].Offset;
+        elements[k].type = decl_elements[i].Type;
+        ++k;
+    }
+    free(decl_elements);
+    *out = elements;
+    *count = k;
+    hr = S_OK;
+done:
+    IDirect3DVertexDeclaration9_Release(decl);
+    return hr;
+}
+
+static HRESULT draw_mesh(IDirect3DDevice9Ex *iface, const struct patch_mesh *mesh)
+{
+    IDirect3DVertexBuffer9 *vb = NULL;
+    IDirect3DIndexBuffer9 *ib = NULL;
+    UINT offset = 0, stride = 0;
+    HRESULT hr;
+
+    IDirect3DDevice9Ex_GetStreamSource(iface, 0, &vb, &offset, &stride);
+    IDirect3DDevice9Ex_GetIndices(iface, &ib);
+    hr = IDirect3DDevice9Ex_DrawIndexedPrimitiveUP(iface, D3DPT_TRIANGLELIST, 0, mesh->vertex_count,
+            mesh->index_count / 3, mesh->indices, D3DFMT_INDEX32, mesh->vertices, mesh->stride);
+    /* a patch leaves the caller's bindings alone, a user-pointer draw does not */
+#ifndef PATCH_MUT_NORESTORE
+    IDirect3DDevice9Ex_SetStreamSource(iface, 0, vb, offset, stride);
+    IDirect3DDevice9Ex_SetIndices(iface, ib);
+#endif
+    if (vb) IDirect3DVertexBuffer9_Release(vb);
+    if (ib) IDirect3DIndexBuffer9_Release(ib);
+    return hr;
+}
+
+/* the control points: a read-only copy of stream 0 behind the stream offset */
+static HRESULT read_stream(IDirect3DDevice9Ex *iface, unsigned char **data, SIZE_T *size, UINT *stride)
+{
+    IDirect3DVertexBuffer9 *vb = NULL;
+    D3DVERTEXBUFFER_DESC desc;
+    UINT offset;
+    void *ptr;
+    HRESULT hr;
+
+    *data = NULL;
+    if (FAILED(hr = IDirect3DDevice9Ex_GetStreamSource(iface, 0, &vb, &offset, stride)) || !vb || !*stride)
+    {
+        if (vb) IDirect3DVertexBuffer9_Release(vb);
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DVertexBuffer9_GetDesc(vb, &desc);
+    if (offset >= desc.Size)
+    {
+        IDirect3DVertexBuffer9_Release(vb);
+        return D3DERR_INVALIDCALL;
+    }
+    *size = desc.Size - offset;
+    if (!(*data = malloc(*size)))
+    {
+        IDirect3DVertexBuffer9_Release(vb);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = IDirect3DVertexBuffer9_Lock(vb, 0, 0, &ptr, D3DLOCK_READONLY)))
+    {
+        free(*data);
+        *data = NULL;
+    }
+    else
+    {
+        memcpy(*data, (char *)ptr + offset, *size);
+        IDirect3DVertexBuffer9_Unlock(vb);
+    }
+    IDirect3DVertexBuffer9_Release(vb);
+    return hr;
+}
+
+static HRESULT store_and_draw(struct d3d9_device *device, UINT handle, struct patch_mesh *mesh)
+{
+    HRESULT hr = draw_mesh(&device->IDirect3DDevice9Ex_iface, mesh);
+
+#ifdef PATCH_MUT_NOCACHE
+    if (0)
+#else
+    if (handle)
+#endif
+    {
+        struct d3d9_patch *patch = find_patch(device, handle);
+
+        if (!patch)
+        {
+            if (!(patch = calloc(1, sizeof(*patch))))
+            {
+                patch_free_mesh(mesh);
+                return E_OUTOFMEMORY;
+            }
+            patch->handle = handle;
+            list_add_tail(&device->patches, &patch->entry);
+        }
+        else patch_free_mesh(&patch->mesh);
+        patch->mesh = *mesh;
+        memset(mesh, 0, sizeof(*mesh));
+    }
+    else patch_free_mesh(mesh);
+    return hr;
+}
+
+HRESULT d3d9_device_draw_patch(struct d3d9_device *device, UINT handle, const float *segments,
+        const D3DRECTPATCH_INFO *rect, const D3DTRIPATCH_INFO *tri)
+{
+    IDirect3DDevice9Ex *iface = &device->IDirect3DDevice9Ex_iface;
+    struct patch_element *elements = NULL;
+    unsigned int element_count = 0, ok;
+    unsigned char *data = NULL;
+    struct patch_mesh mesh;
+    struct d3d9_patch *cached;
+    struct patch_basis_info basis;
+    SIZE_T size, needed;
+    UINT stride;
+    HRESULT hr;
+
+    if (!rect && !tri)
+    {
+        /* no description: draw the patch remembered for the handle */
+        if (!handle || !(cached = find_patch(device, handle)))
+        {
+            WARN("No patch cached for handle %#x.\n", handle);
+            return D3DERR_INVALIDCALL;
+        }
+        return draw_mesh(iface, &cached->mesh);
+    }
+    if (!segments)
+        return D3DERR_INVALIDCALL;
+
+    if (FAILED(hr = read_stream(iface, &data, &size, &stride)))
+        return hr;
+    if (FAILED(hr = get_elements(iface, stride, &elements, &element_count)))
+    {
+        free(data);
+        return hr;
+    }
+
+    if (rect)
+    {
+        basis.basis = rect->Basis;
+        basis.degree = rect->Degree;
+        needed = ((SIZE_T)(rect->StartVertexOffsetHeight + rect->Height - 1) * rect->Stride
+                + rect->StartVertexOffsetWidth + rect->Width) * stride;
+        if (!rect->Width || !rect->Height || rect->Stride < rect->Width || needed > size)
+            ok = 0;
+        else
+            ok = patch_tessellate_rect(elements, element_count, stride, data, rect->StartVertexOffsetWidth,
+                    rect->StartVertexOffsetHeight, rect->Width, rect->Height, rect->Stride, &basis, segments, &mesh);
+    }
+    else
+    {
+        basis.basis = tri->Basis;
+        basis.degree = tri->Degree;
+        needed = ((SIZE_T)tri->StartVertexOffset + tri->NumVertices) * stride;
+        if (needed > size)
+            ok = 0;
+        else
+            ok = patch_tessellate_tri(elements, element_count, stride, data, tri->StartVertexOffset, tri->NumVertices,
+                    &basis, segments, &mesh);
+    }
+    free(elements);
+    free(data);
+    if (!ok)
+    {
+        WARN("Invalid patch description.\n");
+        return D3DERR_INVALIDCALL;
+    }
+    return store_and_draw(device, handle, &mesh);
+}
+
+HRESULT d3d9_device_delete_patch(struct d3d9_device *device, UINT handle)
+{
+    struct d3d9_patch *patch = find_patch(device, handle);
+
+    if (!patch)
+        return D3DERR_INVALIDCALL;
+    list_remove(&patch->entry);
+    patch_free_mesh(&patch->mesh);
+    free(patch);
+    return D3D_OK;
+}
diff --git a/dlls/d3d9/patch_eval.h b/dlls/d3d9/patch_eval.h
new file mode 100644
index 0000000..ec58615
--- /dev/null
+++ b/dlls/d3d9/patch_eval.h
@@ -0,0 +1,367 @@
+/*
+ * Tessellation of the higher-order primitives drawn by IDirect3DDevice9::DrawRectPatch/DrawTriPatch
+ * (and the Direct3D 8 versions): the control points are vertices, every vertex component the layout
+ * describes as floating point, colour or normalised integer is evaluated with the patch's basis.
+ * Shared by d3d8 and d3d9 (both include this header).
+ *
+ * Written from the documented structures (D3DRECTPATCH_INFO, D3DTRIPATCH_INFO); the parts the documentation
+ * leaves open are marked GUESS.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_D3D9_PATCH_EVAL_H
+#define __WINE_D3D9_PATCH_EVAL_H
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* the components of a vertex: byte offset and a D3DDECLTYPE_* code (the D3D9 numbering) */
+struct patch_element
+{
+    unsigned int offset;
+    unsigned int type;
+};
+
+struct patch_mesh
+{
+    unsigned char *vertices;
+    unsigned int stride;
+    unsigned int vertex_count;
+    unsigned int *indices;      /* triangle list */
+    unsigned int index_count;
+};
+
+struct patch_basis_info
+{
+    unsigned int basis;         /* D3DBASIS_BEZIER 0, D3DBASIS_BSPLINE 1, D3DBASIS_INTERPOLATE (Catmull-Rom) 2 */
+    unsigned int degree;        /* 1, 2, 3 or 5 */
+};
+
+static inline void patch_free_mesh(struct patch_mesh *mesh)
+{
+    free(mesh->vertices);
+    free(mesh->indices);
+    memset(mesh, 0, sizeof(*mesh));
+}
+
+/* the weights of the (degree + 1) control points that shape the segment at local parameter t (0..1) */
+static inline void patch_weights(unsigned int basis, unsigned int degree, float t, float *w)
+{
+    unsigned int i, r, j;
+
+#ifdef PATCH_MUT_BSPLINE_AS_BEZIER
+    if (basis == 1) basis = 0;
+#endif
+    switch (basis)
+    {
+        case 0: /* Bezier: Bernstein polynomials */
+        {
+            float a = 1.0f - t;
+            float binom = 1.0f;
+
+            for (i = 0; i <= degree; ++i)
+            {
+#ifdef PATCH_MUT_LINEAR
+                w[i] = 1.0f / (degree + 1);
+#else
+                w[i] = binom * powf(t, i) * powf(a, degree - i);
+#endif
+                binom = binom * (degree - i) / (i + 1);
+            }
+            break;
+        }
+        case 1: /* uniform B-spline */
+        {
+            float b[8] = {1.0f}, c[8];
+
+            for (r = 1; r <= degree; ++r)
+            {
+                for (j = 0; j <= r; ++j)
+                    c[j] = (j > 0 ? b[j - 1] * (t + r - j) / r : 0.0f) + (j < r ? b[j] * (j + 1 - t) / r : 0.0f);
+                memcpy(b, c, (r + 1) * sizeof(float));
+            }
+            memcpy(w, b, (degree + 1) * sizeof(float));
+            break;
+        }
+        default: /* Catmull-Rom (cubic only) */
+            w[0] = (-t * t * t + 2.0f * t * t - t) * 0.5f;
+            w[1] = (3.0f * t * t * t - 5.0f * t * t + 2.0f) * 0.5f;
+            w[2] = (-3.0f * t * t * t + 4.0f * t * t + t) * 0.5f;
+            w[3] = (t * t * t - t * t) * 0.5f;
+            break;
+    }
+}
+
+/* how many patches a row of count control points holds, 0 when the combination is invalid */
+static inline unsigned int patch_segments(unsigned int basis, unsigned int degree, unsigned int count)
+{
+    if (degree != 1 && degree != 2 && degree != 3 && degree != 5)
+        return 0;
+    switch (basis)
+    {
+        case 0: return count > degree && !((count - 1) % degree) ? (count - 1) / degree : 0;
+        case 1: return count > degree ? count - degree : 0;
+        case 2: return degree == 3 && count > 3 ? count - 3 : 0;
+        default: return 0;
+    }
+}
+
+static inline float patch_read_component(const unsigned char *p, unsigned int type, unsigned int c)
+{
+#ifdef PATCH_MUT_COLOR
+    if (type == 4)
+        return 0.0f;
+#endif
+    switch (type)
+    {
+        case 0: case 1: case 2: case 3: return ((const float *)p)[c];
+        case 4: /* D3DCOLOR is BGRA in memory, components in the order a, r, g, b */
+        {
+            static const unsigned int order[4] = {3, 2, 1, 0};
+            return p[order[c]];
+        }
+        case 5: case 8: return p[c];
+        case 6: case 7: case 9: case 10: return ((const short *)p)[c];
+        case 11: case 12: return ((const unsigned short *)p)[c];
+        default: return 0.0f;
+    }
+}
+
+static inline unsigned int patch_component_count(unsigned int type)
+{
+    switch (type)
+    {
+        case 0: return 1;
+        case 1: case 6: case 9: case 11: return 2;
+        case 2: return 3;
+        case 3: case 4: case 5: case 7: case 8: case 10: case 12: return 4;
+        default: return 0;
+    }
+}
+
+static inline void patch_write_component(unsigned char *p, unsigned int type, unsigned int c, float v)
+{
+    switch (type)
+    {
+        case 0: case 1: case 2: case 3: ((float *)p)[c] = v; break;
+        case 4: case 5: case 8:
+        {
+            static const unsigned int order[4] = {3, 2, 1, 0};
+            long r = lrintf(v);
+
+            p[type == 4 ? order[c] : c] = r < 0 ? 0 : r > 255 ? 255 : r;
+            break;
+        }
+        case 6: case 7: case 9: case 10:
+        {
+            long r = lrintf(v);
+
+            ((short *)p)[c] = r < -32768 ? -32768 : r > 32767 ? 32767 : r;
+            break;
+        }
+        case 11: case 12:
+        {
+            long r = lrintf(v);
+
+            ((unsigned short *)p)[c] = r < 0 ? 0 : r > 65535 ? 65535 : r;
+            break;
+        }
+    }
+}
+
+/* one evaluated vertex: control[i] points at the i-th control point, weight[i] is its weight */
+static inline void patch_eval_vertex(const struct patch_element *elements, unsigned int element_count,
+        unsigned int stride, const unsigned char *const *control, const float *weight, unsigned int count,
+        const unsigned char *nearest, unsigned char *out)
+{
+    unsigned int e, c, i, n;
+
+    memcpy(out, nearest, stride);   /* components the layout cannot interpolate keep the nearest control point's */
+    for (e = 0; e < element_count; ++e)
+    {
+        n = patch_component_count(elements[e].type);
+        for (c = 0; c < n; ++c)
+        {
+            float v = 0.0f;
+
+            for (i = 0; i < count; ++i)
+                v += weight[i] * patch_read_component(control[i] + elements[e].offset, elements[e].type, c);
+            patch_write_component(out + elements[e].offset, elements[e].type, c, v);
+        }
+    }
+}
+
+static inline unsigned int patch_level(const float *segs, unsigned int n)
+{
+    float m = 1.0f;
+    unsigned int i;
+
+    for (i = 0; i < n; ++i)
+        if (segs[i] > m) m = segs[i];
+    m = ceilf(m);
+    return m > 256.0f ? 256 : (unsigned int)m;
+}
+
+/* A rectangular patch group: width x height control points (rows of stride vertices), tessellated into
+ * level x level quads per patch (GUESS: the largest of the four edge levels, the same on every edge). */
+static inline int patch_tessellate_rect(const struct patch_element *elements, unsigned int element_count,
+        unsigned int stride, const unsigned char *base, unsigned int start_w, unsigned int start_h,
+        unsigned int width, unsigned int height, unsigned int row_stride, const struct patch_basis_info *info,
+        const float *segs, struct patch_mesh *mesh)
+{
+    unsigned int nu = patch_segments(info->basis, info->degree, width), nv = patch_segments(info->basis, info->degree, height);
+    unsigned int level = patch_level(segs, 4), pu, pv, i, j, a, b, deg = info->degree;
+#ifdef PATCH_MUT_STEP
+    unsigned int step = 1, per_row, v = 0, t = 0;
+#else
+    unsigned int step = info->basis == 0 ? deg : 1, per_row, v = 0, t = 0;
+#endif
+    float wu[8], wv[8];
+    const unsigned char *control[36];
+    float weight[36];
+
+    memset(mesh, 0, sizeof(*mesh));
+    if (!nu || !nv || !width || !height)
+        return 0;
+    per_row = level + 1;
+    mesh->stride = stride;
+    mesh->vertex_count = nu * nv * per_row * per_row;
+    mesh->index_count = nu * nv * level * level * 6;
+    if (!(mesh->vertices = malloc((size_t)mesh->vertex_count * stride)) || !(mesh->indices = malloc((size_t)mesh->index_count * sizeof(unsigned int))))
+    {
+        patch_free_mesh(mesh);
+        return 0;
+    }
+
+    for (pv = 0; pv < nv; ++pv)
+        for (pu = 0; pu < nu; ++pu)
+        {
+            unsigned int first = v;
+
+            for (b = 0; b <= level; ++b)
+            {
+                patch_weights(info->basis, deg, (float)b / level, wv);
+                for (a = 0; a <= level; ++a)
+                {
+                    unsigned int ci = 0, ni, nj;
+                    float best = -1.0f;
+
+                    patch_weights(info->basis, deg, (float)a / level, wu);
+                    for (j = 0; j <= deg; ++j)
+                        for (i = 0; i <= deg; ++i)
+                        {
+                            control[ci] = base + ((size_t)(start_h + pv * step + j) * row_stride + start_w + pu * step + i) * stride;
+                            weight[ci++] = wu[i] * wv[j];
+                        }
+                    /* the control point with the largest weight stands in for what cannot be interpolated */
+                    ni = 0;
+                    for (i = 0; i < ci; ++i)
+                        if (weight[i] > best) { best = weight[i]; ni = i; }
+                    (void)nj;
+                    patch_eval_vertex(elements, element_count, stride, control, weight, ci, control[ni],
+                            mesh->vertices + (size_t)v * stride);
+                    ++v;
+                }
+            }
+            for (b = 0; b < level; ++b)
+                for (a = 0; a < level; ++a)
+                {
+                    unsigned int v00 = first + b * per_row + a, v10 = v00 + 1, v01 = v00 + per_row, v11 = v01 + 1;
+
+                    /* GUESS: winding; the documentation does not say which way a patch faces */
+                    mesh->indices[t++] = v00; mesh->indices[t++] = v10; mesh->indices[t++] = v01;
+                    mesh->indices[t++] = v10; mesh->indices[t++] = v11; mesh->indices[t++] = v01;
+                }
+        }
+    return 1;
+}
+
+/* A triangular patch of control points ((d+1)(d+2)/2 of them, Bezier basis only). GUESS: the order of the
+ * control points is row by row from the corner with weight u^d: row r holds r+1 points with
+ * barycentric exponents (d - r, r - c, c). */
+static inline int patch_tessellate_tri(const struct patch_element *elements, unsigned int element_count,
+        unsigned int stride, const unsigned char *base, unsigned int start, unsigned int num_vertices,
+        const struct patch_basis_info *info, const float *segs, struct patch_mesh *mesh)
+{
+    unsigned int deg = info->degree, level = patch_level(segs, 3), a, b, r, c, v = 0, t = 0, count = (deg + 1) * (deg + 2) / 2;
+    unsigned int row_start[8];
+    float fact[8] = {1, 1, 2, 6, 24, 120, 720, 5040};
+    const unsigned char *control[21];
+    float weight[21];
+
+    memset(mesh, 0, sizeof(*mesh));
+    if (info->basis != 0 || (deg != 1 && deg != 2 && deg != 3 && deg != 5) || num_vertices < count)
+        return 0;
+    for (r = 0, a = 0; r <= deg; ++r)
+    {
+        row_start[r] = a;
+        a += r + 1;
+    }
+    mesh->stride = stride;
+    mesh->vertex_count = (level + 1) * (level + 2) / 2;
+    mesh->index_count = level * level * 3;
+    if (!(mesh->vertices = malloc((size_t)mesh->vertex_count * stride)) || !(mesh->indices = malloc((size_t)mesh->index_count * sizeof(unsigned int))))
+    {
+        patch_free_mesh(mesh);
+        return 0;
+    }
+    for (a = 0; a <= level; ++a)
+        for (b = 0; b <= level - a; ++b)
+        {
+            float u = (float)(level - a - b) / level, vv = (float)a / level, ww = (float)b / level, best = -1.0f;
+            unsigned int ni = 0;
+
+            for (r = 0; r <= deg; ++r)
+                for (c = 0; c <= r; ++c)
+                {
+                    unsigned int i = deg - r, j = r - c, k = c, idx = row_start[r] + c;
+
+                    control[idx] = base + (size_t)(start + idx) * stride;
+#ifdef PATCH_MUT_TRI_COEFF
+                    weight[idx] = powf(u, i) * powf(vv, j) * powf(ww, k);
+#else
+                    weight[idx] = fact[deg] / (fact[i] * fact[j] * fact[k]) * powf(u, i) * powf(vv, j) * powf(ww, k);
+#endif
+                    if (weight[idx] > best) { best = weight[idx]; ni = idx; }
+                }
+            patch_eval_vertex(elements, element_count, stride, control, weight, count, control[ni], mesh->vertices + (size_t)v * stride);
+            ++v;
+        }
+    /* triangles: row a holds level + 1 - a vertices */
+    {
+        unsigned int row = 0;
+
+        for (a = 0; a < level; ++a)
+        {
+            unsigned int next = row + (level + 1 - a);
+
+            for (b = 0; b < level - a; ++b)
+            {
+                mesh->indices[t++] = row + b; mesh->indices[t++] = row + b + 1; mesh->indices[t++] = next + b;
+                if (b + 1 < level - a)
+                {
+                    mesh->indices[t++] = row + b + 1; mesh->indices[t++] = next + b + 1; mesh->indices[t++] = next + b;
+                }
+            }
+            row = next;
+        }
+        mesh->index_count = t;
+    }
+    return 1;
+}
+
+#endif
