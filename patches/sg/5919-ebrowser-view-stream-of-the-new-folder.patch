From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: the view being made reads the view state stream of its own folder

Found at integration (gate fastb-ebstate): fast-a 3258 made the folder view
save its state through IShellBrowser::GetViewStateStream when it is
destroyed and read it back when it is created; fast-b 3705 made the
ExplorerBrowser keep that stream per folder. The new view is created while
the browser's current folder is still the one being left, so it read the
old folder's stream (back in a folder, the view mode of the folder just
left came back). While the new view is made, the stream is now the one of
the folder being browsed to; the old view still saves into its own.

Mutant: SG_MUTANT_EB_STREAM_OLDPIDL (fastb-ebstate).
---
diff --git a/dlls/shell32/ebrowser.c b/dlls/shell32/ebrowser.c
--- a/dlls/shell32/ebrowser.c
+++ b/dlls/shell32/ebrowser.c
@@ -97,6 +97,8 @@ typedef struct _ExplorerBrowserImpl {
     IShellView *psv;
     RECT sv_rc;
     LPITEMIDLIST current_pidl;
+    PCIDLIST_ABSOLUTE pending_pidl; /* the folder being browsed to, while its view is made */
+    PCIDLIST_ABSOLUTE stream_pidl;  /* the folder whose view state stream the view being made reads */
 
     IUnknown *punk_site;
     ICommDlgBrowser *pcdb_site;
@@ -586,12 +588,18 @@ static HRESULT create_view_for_folder(ExplorerBrowserImpl *This, IShellFolder *p
     {
         if(This->hwnd_sv)
         {
+            /* the old view saves its state in its own folder's stream */
             IShellView_DestroyViewWindow(This->psv);
             This->hwnd_sv = NULL;
         }
 
         This->fs.fFlags |= FWF_USESEARCHFOLDER | FWF_FULLROWSELECT | FWF_NOCLIENTEDGE;
+        /* the new view reads the stream of the folder it shows, not the one being left */
+#ifndef SG_MUTANT_EB_STREAM_OLDPIDL
+        This->stream_pidl = This->pending_pidl;
+#endif
         hr = IShellView_CreateViewWindow(psv, This->psv, &This->fs, psb, &This->sv_rc, &hwnd_new);
+        This->stream_pidl = NULL;
         if(SUCCEEDED(hr))
         {
             /* Replace the old shellview */
@@ -1463,7 +1471,9 @@ static HRESULT WINAPI IExplorerBrowser_fnBrowseToIDList(IExplorerBrowser *iface,
         hr = SHCreateItemFromIDList(absolute_pidl, &IID_IShellItem, (void**)&psi);
         if(SUCCEEDED(hr))
         {
+            This->pending_pidl = absolute_pidl;
             hr = create_new_shellview(This, psi);
+            This->pending_pidl = NULL;
             if(FAILED(hr))
             {
                 events_NavigationFailed(This, absolute_pidl);
@@ -2009,7 +2019,7 @@ static HRESULT WINAPI IShellBrowser_fnGetViewStateStream(IShellBrowser *iface,
     if(!ppStrm)
         return E_INVALIDARG;
     *ppStrm = NULL;
-    if(!This->current_pidl)
+    if(!This->current_pidl && !This->stream_pidl)
         return E_FAIL;
 
     if(!(stream = calloc(1, sizeof(*stream))))
@@ -2017,7 +2027,8 @@ static HRESULT WINAPI IShellBrowser_fnGetViewStateStream(IShellBrowser *iface,
     stream->IStream_iface.lpVtbl = &view_stream_vtbl;
     stream->ref = 1;
     stream->write = (grfMode & (STGM_WRITE | STGM_READWRITE)) != 0;
-    hr = SHGetViewStatePropertyBag(This->current_pidl, This->propbag_name ? This->propbag_name : L"Shell", SHGVSPB_FOLDER,
+    hr = SHGetViewStatePropertyBag(This->stream_pidl ? This->stream_pidl : This->current_pidl,
+                                   This->propbag_name ? This->propbag_name : L"Shell", SHGVSPB_FOLDER,
                                    &IID_IPropertyBag, (void **)&stream->bag);
     if(SUCCEEDED(hr))
         hr = CreateStreamOnHGlobal(NULL, TRUE, &stream->mem);
