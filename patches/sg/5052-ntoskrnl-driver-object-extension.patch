From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl: Implement driver object extensions.

IoAllocateDriverObjectExtension and IoGetDriverObjectExtension keep
zero-filled per-driver context areas, found by the caller's identifier and
freed with the driver object; the same identifier again fails with
STATUS_OBJECT_NAME_COLLISION and a NULL pointer. Both were stubs. Removes
four todo_wine in the ntoskrnl driver test.

Gate: test/ntoskrnl-drvext-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c         | 66 +++++++++++++++++++++++++++++++++---
 dlls/ntoskrnl.exe/ntoskrnl_private.h |  1 +
 dlls/ntoskrnl.exe/tests/driver.c     |  8 ++---
 3 files changed, 67 insertions(+), 8 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index d179e58..b2ec279 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1065,14 +1065,56 @@ done:
 /***********************************************************************
  *           IoAllocateDriverObjectExtension  (NTOSKRNL.EXE.@)
  */
+/* a per-driver context area, found by the caller's identifier; freed with
+ * the driver object */
+struct driver_object_extension
+{
+    struct list entry;
+    void *id;
+    void *data;
+};
+
+static struct driver_object_extension *find_driver_object_extension( struct wine_driver *driver, void *id )
+{
+    struct driver_object_extension *ext;
+
+    LIST_FOR_EACH_ENTRY( ext, &driver->object_extensions, struct driver_object_extension, entry )
+        if (ext->id == id) return ext;
+    return NULL;
+}
+
 NTSTATUS WINAPI IoAllocateDriverObjectExtension( PDRIVER_OBJECT DriverObject,
                                                  PVOID ClientIdentificationAddress,
                                                  ULONG DriverObjectExtensionSize,
                                                  PVOID *DriverObjectExtension )
 {
-    FIXME( "stub: %p, %p, %lu, %p\n", DriverObject, ClientIdentificationAddress,
-            DriverObjectExtensionSize, DriverObjectExtension );
+    struct wine_driver *driver = CONTAINING_RECORD( DriverObject, struct wine_driver, driver_obj );
+    struct driver_object_extension *ext;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%p, %p, %lu, %p\n", DriverObject, ClientIdentificationAddress,
+           DriverObjectExtensionSize, DriverObjectExtension );
+
+    *DriverObjectExtension = NULL;
+#ifdef SG_MUTANT_DRVEXT_STUB
     return STATUS_NOT_IMPLEMENTED;
+#endif
+    EnterCriticalSection( &drivers_cs );
+    if (find_driver_object_extension( driver, ClientIdentificationAddress ))
+        status = STATUS_OBJECT_NAME_COLLISION;
+    else if (!(ext = malloc( sizeof(*ext) )) || !(ext->data = calloc( 1, max( DriverObjectExtensionSize, 1 ) )))
+    {
+        free( ext );
+        status = STATUS_INSUFFICIENT_RESOURCES;
+    }
+    else
+    {
+        ext->id = ClientIdentificationAddress;
+        list_add_tail( &driver->object_extensions, &ext->entry );
+        *DriverObjectExtension = ext->data;
+    }
+    LeaveCriticalSection( &drivers_cs );
+    return status;
 }
 
 
@@ -1082,8 +1124,16 @@ NTSTATUS WINAPI IoAllocateDriverObjectExtension( PDRIVER_OBJECT DriverObject,
 PVOID WINAPI IoGetDriverObjectExtension( PDRIVER_OBJECT DriverObject,
                                          PVOID ClientIdentificationAddress )
 {
-    FIXME( "stub: %p, %p\n", DriverObject, ClientIdentificationAddress );
-    return NULL;
+    struct wine_driver *driver = CONTAINING_RECORD( DriverObject, struct wine_driver, driver_obj );
+    struct driver_object_extension *ext;
+    void *ret;
+
+    TRACE( "%p, %p\n", DriverObject, ClientIdentificationAddress );
+
+    EnterCriticalSection( &drivers_cs );
+    ret = (ext = find_driver_object_extension( driver, ClientIdentificationAddress )) ? ext->data : NULL;
+    LeaveCriticalSection( &drivers_cs );
+    return ret;
 }
 
 
@@ -1515,6 +1565,13 @@ static NTSTATUS WINAPI unhandled_irp( DEVICE_OBJECT *device, IRP *irp )
 static void free_driver_object( void *obj )
 {
     struct wine_driver *driver = obj;
+    struct driver_object_extension *ext, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( ext, next, &driver->object_extensions, struct driver_object_extension, entry )
+    {
+        free( ext->data );
+        free( ext );
+    }
     RtlFreeUnicodeString( &driver->driver_obj.DriverName );
     RtlFreeUnicodeString( &driver->driver_obj.DriverExtension->ServiceKeyName );
     free_kernel_object( driver );
@@ -1560,6 +1617,7 @@ NTSTATUS WINAPI IoCreateDriver( UNICODE_STRING *name, PDRIVER_INITIALIZE init )
     for (i = 0; i <= IRP_MJ_MAXIMUM_FUNCTION; i++)
         driver->driver_obj.MajorFunction[i] = unhandled_irp;
     list_init( &driver->root_pnp_devices );
+    list_init( &driver->object_extensions );
 
     EnterCriticalSection( &drivers_cs );
     if (wine_rb_put( &wine_drivers, &driver->driver_obj.DriverName, &driver->entry ))
diff --git a/dlls/ntoskrnl.exe/ntoskrnl_private.h b/dlls/ntoskrnl.exe/ntoskrnl_private.h
index 472dc46..b83f9fa 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl_private.h
+++ b/dlls/ntoskrnl.exe/ntoskrnl_private.h
@@ -98,6 +98,7 @@ struct wine_driver
     SERVICE_STATUS_HANDLE service_handle;
     struct wine_rb_entry entry;
     struct list root_pnp_devices;
+    struct list object_extensions;  /* IoAllocateDriverObjectExtension (drivers_cs) */
 };
 
 void ObReferenceObject( void *obj );
diff --git a/dlls/ntoskrnl.exe/tests/driver.c b/dlls/ntoskrnl.exe/tests/driver.c
index f82e34f..a556bf1 100644
--- a/dlls/ntoskrnl.exe/tests/driver.c
+++ b/dlls/ntoskrnl.exe/tests/driver.c
@@ -2339,14 +2339,14 @@ static void test_driver_object_extension(void)
     }
 
     status = pIoAllocateDriverObjectExtension(driver_obj, NULL, 100, &driver_obj_ext);
-    todo_wine ok(status == STATUS_SUCCESS, "got %#lx\n", status);
-    todo_wine ok(driver_obj_ext != NULL, "got NULL\n");
+    ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    ok(driver_obj_ext != NULL, "got NULL\n");
 
     get_obj_ext = pIoGetDriverObjectExtension(driver_obj, NULL);
-    todo_wine ok(get_obj_ext == driver_obj_ext && get_obj_ext != NULL, "got %p != %p\n", get_obj_ext, driver_obj_ext);
+    ok(get_obj_ext == driver_obj_ext && get_obj_ext != NULL, "got %p != %p\n", get_obj_ext, driver_obj_ext);
 
     status = pIoAllocateDriverObjectExtension(driver_obj, NULL, 100, &driver_obj_ext);
-    todo_wine ok(status == STATUS_OBJECT_NAME_COLLISION, "got %#lx\n", status);
+    ok(status == STATUS_OBJECT_NAME_COLLISION, "got %#lx\n", status);
     ok(driver_obj_ext == NULL, "got %p\n", driver_obj_ext);
 
     get_obj_ext = pIoGetDriverObjectExtension(driver_obj, (void *)0xdead);
