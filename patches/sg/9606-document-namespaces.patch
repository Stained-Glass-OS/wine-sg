From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mshtml: document.namespaces (9606)

Pages with VML or Office markup declare or add XML namespaces:
<html xmlns:v="urn:schemas-microsoft-com:vml"> and
document.namespaces.add("v", "urn:schemas-microsoft-com:vml"). The
collection's length was always 0 and add/item were E_NOTIMPL, so those
scripts threw. The collection is now the root element's xmlns:
declarations followed by the namespaces scripts added (adding a name
again changes its urn); item takes an index or a name; a namespace object
has name, urn, readyState ("complete"), tagNames, onreadystatechange,
doImport, attachEvent/detachEvent. Element behaviors a namespace imports
(HTC files, doImport) are not loaded.
---
--- a/dlls/mshtml/mshtml_private.h
+++ b/dlls/mshtml/mshtml_private.h
@@ -1257,6 +1259,7 @@
 HRESULT create_performance(HTMLInnerWindow*,IHTMLPerformance**);
 HRESULT create_history(HTMLInnerWindow*,OmHistory**);
 HRESULT create_namespace_collection(HTMLDocumentNode*,IHTMLNamespaceCollection**);
+void detach_namespace_collection(IHTMLNamespaceCollection*);
 HRESULT create_dom_implementation(HTMLDocumentNode*,IHTMLDOMImplementation**);
 void detach_dom_implementation(IHTMLDOMImplementation*);
 HRESULT create_html_storage(HTMLInnerWindow*,BOOL,IHTMLStorage**);
--- a/dlls/mshtml/omnavigator.c
+++ b/dlls/mshtml/omnavigator.c
@@ -2884,9 +2884,17 @@
     return S_OK;
 }
 
+struct ns_entry {
+    WCHAR *name;
+    WCHAR *urn;
+};
+
 typedef struct {
     DispatchEx dispex;
     IHTMLNamespaceCollection IHTMLNamespaceCollection_iface;
+    HTMLDocumentNode *doc;      /* Stained Glass OS: whose xmlns: declarations count too (no reference) */
+    struct ns_entry *added;     /* the namespaces scripts added */
+    unsigned added_cnt;
 } HTMLNamespaceCollection;
 
 static inline HTMLNamespaceCollection *impl_from_IHTMLNamespaceCollection(IHTMLNamespaceCollection *iface)
@@ -2897,28 +2905,360 @@
 DISPEX_IDISPATCH_IMPL(HTMLNamespaceCollection, IHTMLNamespaceCollection,
                       impl_from_IHTMLNamespaceCollection(iface)->dispex)
 
+#ifndef SG_MUTANT_NO_NAMESPACES
+/* Stained Glass OS (wine-sg 9606): document.namespaces as Internet Explorer 5.5-9 have it: the
+ * namespaces the document declares (xmlns:prefix on its root element) and those scripts add
+ * (document.namespaces.add("v", "urn:schemas-microsoft-com:vml")). A namespace object has its name
+ * and urn; the behaviors (element implementations) a namespace can import are not loaded, so it is
+ * complete at once. */
+typedef struct {
+    IDispatch IDispatch_iface;
+    LONG ref;
+    WCHAR *name;
+    WCHAR *urn;
+    VARIANT onreadystatechange;
+} HTMLNamespace;
+
+#define NS_DISPID_NAME       1
+#define NS_DISPID_URN        2
+#define NS_DISPID_TAGNAMES   3
+#define NS_DISPID_READYSTATE 4
+#define NS_DISPID_ONRSC      5
+#define NS_DISPID_DOIMPORT   6
+#define NS_DISPID_ATTACH     7
+#define NS_DISPID_DETACH     8
+
+static inline HTMLNamespace *impl_from_ns_IDispatch(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLNamespace, IDispatch_iface);
+}
+
+static HRESULT WINAPI HTMLNamespace_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch)) {
+        *ppv = iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI HTMLNamespace_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&impl_from_ns_IDispatch(iface)->ref);
+}
+
+static ULONG WINAPI HTMLNamespace_Release(IDispatch *iface)
+{
+    HTMLNamespace *This = impl_from_ns_IDispatch(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        free(This->name);
+        free(This->urn);
+        VariantClear(&This->onreadystatechange);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI HTMLNamespace_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLNamespace_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **ti)
+{
+    *ti = NULL;
+    return DISP_E_BADINDEX;
+}
+
+static HRESULT WINAPI HTMLNamespace_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    static const struct { const WCHAR *name; DISPID id; } members[] = {
+        { L"name", NS_DISPID_NAME }, { L"urn", NS_DISPID_URN }, { L"tagNames", NS_DISPID_TAGNAMES },
+        { L"readyState", NS_DISPID_READYSTATE }, { L"onreadystatechange", NS_DISPID_ONRSC },
+        { L"doImport", NS_DISPID_DOIMPORT }, { L"attachEvent", NS_DISPID_ATTACH },
+        { L"detachEvent", NS_DISPID_DETACH },
+    };
+    HRESULT hres = S_OK;
+    UINT i, j;
+
+    for(i = 0; i < count; i++) {
+        ids[i] = DISPID_UNKNOWN;
+        for(j = 0; !i && j < ARRAY_SIZE(members); j++)
+            if(!wcsicmp(names[0], members[j].name))
+                ids[0] = members[j].id;
+        if(ids[i] == DISPID_UNKNOWN)
+            hres = DISP_E_UNKNOWNNAME;
+    }
+    return hres;
+}
+
+static HRESULT WINAPI HTMLNamespace_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *argerr)
+{
+    HTMLNamespace *This = impl_from_ns_IDispatch(iface);
+    BOOL get = (flags & DISPATCH_PROPERTYGET) != 0;
+
+    switch(id) {
+    case NS_DISPID_NAME:
+    case NS_DISPID_URN:
+    case NS_DISPID_READYSTATE:
+        if(!get || !res)
+            return DISP_E_MEMBERNOTFOUND;
+        V_VT(res) = VT_BSTR;
+        V_BSTR(res) = SysAllocString(id == NS_DISPID_NAME ? This->name : id == NS_DISPID_URN ? This->urn : L"complete");
+        return V_BSTR(res) ? S_OK : E_OUTOFMEMORY;
+    case NS_DISPID_TAGNAMES:
+        if(!get || !res)
+            return DISP_E_MEMBERNOTFOUND;
+        V_VT(res) = VT_NULL;    /* no element behaviors were imported */
+        return S_OK;
+    case NS_DISPID_ONRSC:
+        if(flags & DISPATCH_PROPERTYPUT) {
+            if(!dp || !dp->cArgs)
+                return DISP_E_PARAMNOTOPTIONAL;
+            VariantClear(&This->onreadystatechange);
+            return VariantCopy(&This->onreadystatechange, &dp->rgvarg[0]);
+        }
+        if(!get || !res)
+            return DISP_E_MEMBERNOTFOUND;
+        V_VT(res) = VT_EMPTY;
+        if(V_VT(&This->onreadystatechange) == VT_EMPTY) {
+            V_VT(res) = VT_NULL;
+            return S_OK;
+        }
+        return VariantCopy(res, &This->onreadystatechange);
+    case NS_DISPID_DOIMPORT:
+        if(!(flags & DISPATCH_METHOD))
+            return DISP_E_MEMBERNOTFOUND;
+        FIXME("doImport: element behaviors are not loaded\n");
+        return S_OK;
+    case NS_DISPID_ATTACH:
+    case NS_DISPID_DETACH:
+        if(!(flags & DISPATCH_METHOD))
+            return DISP_E_MEMBERNOTFOUND;
+        /* readystatechange: the namespace is complete already, the handler is not called */
+        if(res && id == NS_DISPID_ATTACH) {
+            V_VT(res) = VT_BOOL;
+            V_BOOL(res) = VARIANT_TRUE;
+        }
+        return S_OK;
+    }
+    return DISP_E_MEMBERNOTFOUND;
+}
+
+static const IDispatchVtbl HTMLNamespaceVtbl = {
+    HTMLNamespace_QueryInterface,
+    HTMLNamespace_AddRef,
+    HTMLNamespace_Release,
+    HTMLNamespace_GetTypeInfoCount,
+    HTMLNamespace_GetTypeInfo,
+    HTMLNamespace_GetIDsOfNames,
+    HTMLNamespace_Invoke
+};
+
+static HRESULT create_namespace(const WCHAR *name, const WCHAR *urn, IDispatch **ret)
+{
+    HTMLNamespace *ns;
+
+    if(!(ns = calloc(1, sizeof(*ns))))
+        return E_OUTOFMEMORY;
+    ns->IDispatch_iface.lpVtbl = &HTMLNamespaceVtbl;
+    ns->ref = 1;
+    ns->name = wcsdup(name ? name : L"");
+    ns->urn = wcsdup(urn ? urn : L"");
+    if(!ns->name || !ns->urn) {
+        IDispatch_Release(&ns->IDispatch_iface);
+        return E_OUTOFMEMORY;
+    }
+    *ret = &ns->IDispatch_iface;
+    return S_OK;
+}
+
+static void free_ns_entries(struct ns_entry *e, unsigned cnt)
+{
+    unsigned i;
+
+    for(i = 0; i < cnt; i++) {
+        free(e[i].name);
+        free(e[i].urn);
+    }
+    free(e);
+}
+
+static BOOL has_entry(struct ns_entry *e, unsigned cnt, const WCHAR *name)
+{
+    unsigned i;
+
+    for(i = 0; i < cnt; i++)
+        if(!wcsicmp(e[i].name, name))
+            return TRUE;
+    return FALSE;
+}
+
+static BOOL push_entry(struct ns_entry **e, unsigned *cnt, const WCHAR *name, const WCHAR *urn)
+{
+    struct ns_entry *n;
+
+    if(!(n = realloc(*e, (*cnt + 1) * sizeof(*n))))
+        return FALSE;
+    *e = n;
+    n[*cnt].name = wcsdup(name);
+    n[*cnt].urn = wcsdup(urn);
+    if(!n[*cnt].name || !n[*cnt].urn) {
+        free(n[*cnt].name);
+        free(n[*cnt].urn);
+        return FALSE;
+    }
+    (*cnt)++;
+    return TRUE;
+}
+
+/* the document's xmlns: declarations, then what scripts added */
+static HRESULT get_namespaces(HTMLNamespaceCollection *This, struct ns_entry **ret, unsigned *ret_cnt)
+{
+    nsIDOMMozNamedAttrMap *attrs = NULL;
+    nsIDOMElement *root = NULL;
+    struct ns_entry *e = NULL;
+    unsigned cnt = 0, i;
+    UINT32 len = 0, j;
+
+    if(This->doc && This->doc->dom_document &&
+       NS_SUCCEEDED(nsIDOMDocument_GetDocumentElement(This->doc->dom_document, &root)) && root) {
+        if(NS_SUCCEEDED(nsIDOMElement_GetAttributes(root, &attrs)) && attrs) {
+            nsIDOMMozNamedAttrMap_GetLength(attrs, &len);
+            for(j = 0; j < len; j++) {
+                nsAString name_str, value_str;
+                const PRUnichar *name, *value;
+                nsIDOMAttr *attr;
+
+                if(NS_FAILED(nsIDOMMozNamedAttrMap_Item(attrs, j, &attr)) || !attr)
+                    continue;
+                nsAString_Init(&name_str, NULL);
+                nsAString_Init(&value_str, NULL);
+                nsIDOMAttr_GetName(attr, &name_str);
+                nsIDOMAttr_GetValue(attr, &value_str);
+                nsAString_GetData(&name_str, &name);
+                nsAString_GetData(&value_str, &value);
+                if(!wcsnicmp(name, L"xmlns:", 6) && name[6] && !has_entry(e, cnt, name + 6))
+                    push_entry(&e, &cnt, name + 6, value);
+                nsAString_Finish(&name_str);
+                nsAString_Finish(&value_str);
+                nsIDOMAttr_Release(attr);
+            }
+            nsIDOMMozNamedAttrMap_Release(attrs);
+        }
+        nsIDOMElement_Release(root);
+    }
+    for(i = 0; i < This->added_cnt; i++)
+        if(!has_entry(e, cnt, This->added[i].name))
+            push_entry(&e, &cnt, This->added[i].name, This->added[i].urn);
+    *ret = e;
+    *ret_cnt = cnt;
+    return S_OK;
+}
+
 static HRESULT WINAPI HTMLNamespaceCollection_get_length(IHTMLNamespaceCollection *iface, LONG *p)
 {
     HTMLNamespaceCollection *This = impl_from_IHTMLNamespaceCollection(iface);
-    FIXME("(%p)->(%p) returning 0\n", This, p);
-    *p = 0;
+    struct ns_entry *e;
+    unsigned cnt;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+    get_namespaces(This, &e, &cnt);
+    free_ns_entries(e, cnt);
+    *p = cnt;
     return S_OK;
 }
 
 static HRESULT WINAPI HTMLNamespaceCollection_item(IHTMLNamespaceCollection *iface, VARIANT index, IDispatch **p)
 {
     HTMLNamespaceCollection *This = impl_from_IHTMLNamespaceCollection(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_variant(&index), p);
-    return E_NOTIMPL;
+    struct ns_entry *e;
+    unsigned cnt, i;
+    HRESULT hres;
+    VARIANT idx;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_variant(&index), p);
+
+    if(!p)
+        return E_POINTER;
+    *p = NULL;
+    get_namespaces(This, &e, &cnt);
+    hres = S_OK;
+    if(V_VT(&index) == VT_BSTR) {
+        /* by name */
+        for(i = 0; i < cnt; i++)
+            if(V_BSTR(&index) && !wcsicmp(e[i].name, V_BSTR(&index)))
+                break;
+    }else {
+        V_VT(&idx) = VT_EMPTY;
+        hres = VariantChangeType(&idx, &index, 0, VT_I4);
+        i = SUCCEEDED(hres) && V_I4(&idx) >= 0 ? V_I4(&idx) : cnt;
+    }
+    if(SUCCEEDED(hres) && i < cnt)
+        hres = create_namespace(e[i].name, e[i].urn, p);
+    else if(SUCCEEDED(hres))
+        hres = E_INVALIDARG;
+    free_ns_entries(e, cnt);
+    return hres;
 }
 
 static HRESULT WINAPI HTMLNamespaceCollection_add(IHTMLNamespaceCollection *iface, BSTR namespace, BSTR urn,
                                                   VARIANT implementation_url, IDispatch **p)
 {
     HTMLNamespaceCollection *This = impl_from_IHTMLNamespaceCollection(iface);
-    FIXME("(%p)->(%s %s %s %p)\n", This, debugstr_w(namespace), debugstr_w(urn), debugstr_variant(&implementation_url), p);
+    unsigned i;
+
+    TRACE("(%p)->(%s %s %s %p)\n", This, debugstr_w(namespace), debugstr_w(urn), debugstr_variant(&implementation_url), p);
+
+    if(!namespace || !*namespace)
+        return E_INVALIDARG;
+    if(V_VT(&implementation_url) == VT_BSTR && V_BSTR(&implementation_url) && *V_BSTR(&implementation_url))
+        FIXME("implementation %s is not imported\n", debugstr_w(V_BSTR(&implementation_url)));
+    /* adding a name again changes its urn */
+    for(i = 0; i < This->added_cnt; i++)
+        if(!wcsicmp(This->added[i].name, namespace)) {
+            WCHAR *new_urn = wcsdup(urn ? urn : L"");
+            if(!new_urn)
+                return E_OUTOFMEMORY;
+            free(This->added[i].urn);
+            This->added[i].urn = new_urn;
+            break;
+        }
+    if(i == This->added_cnt && !push_entry(&This->added, &This->added_cnt, namespace, urn ? urn : L""))
+        return E_OUTOFMEMORY;
+    if(!p)
+        return S_OK;
+    return create_namespace(namespace, urn, p);
+}
+#else
+static HRESULT WINAPI HTMLNamespaceCollection_get_length(IHTMLNamespaceCollection *iface, LONG *p)
+{
+    *p = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLNamespaceCollection_item(IHTMLNamespaceCollection *iface, VARIANT index, IDispatch **p)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI HTMLNamespaceCollection_add(IHTMLNamespaceCollection *iface, BSTR namespace, BSTR urn,
+                                                  VARIANT implementation_url, IDispatch **p)
+{
     return E_NOTIMPL;
 }
+static void free_ns_entries(struct ns_entry *e, unsigned cnt) {}
+#endif
 
 static const IHTMLNamespaceCollectionVtbl HTMLNamespaceCollectionVtbl = {
     HTMLNamespaceCollection_QueryInterface,
@@ -2951,6 +3291,7 @@
 static void HTMLNamespaceCollection_destructor(DispatchEx *dispex)
 {
     HTMLNamespaceCollection *This = HTMLNamespaceCollection_from_DispatchEx(dispex);
+    free_ns_entries(This->added, This->added_cnt);
     free(This);
 }
 
@@ -2971,6 +3312,12 @@
     .max_compat_mode = COMPAT_MODE_IE9,
 };
 
+/* the document is going: its declarations no longer count */
+void detach_namespace_collection(IHTMLNamespaceCollection *iface)
+{
+    impl_from_IHTMLNamespaceCollection(iface)->doc = NULL;
+}
+
 HRESULT create_namespace_collection(HTMLDocumentNode *doc, IHTMLNamespaceCollection **ret)
 {
     HTMLNamespaceCollection *namespaces;
@@ -2979,6 +3326,7 @@
         return E_OUTOFMEMORY;
 
     namespaces->IHTMLNamespaceCollection_iface.lpVtbl = &HTMLNamespaceCollectionVtbl;
+    namespaces->doc = doc;
     init_dispatch(&namespaces->dispex, &MSNamespaceInfoCollection_dispex, doc->script_global,
                   dispex_compat_mode(&doc->node.event_target.dispex));
     *ret = &namespaces->IHTMLNamespaceCollection_iface;
--- a/dlls/mshtml/htmldoc.c
+++ b/dlls/mshtml/htmldoc.c
@@ -7087,6 +7087,8 @@
         detach_dom_implementation(doc->dom_implementation);
 
     unlink_ref(&doc->dom_implementation);
+    if(doc->namespaces)
+        detach_namespace_collection(doc->namespaces);
     unlink_ref(&doc->namespaces);
     detach_events(doc);
     detach_selection(doc);
