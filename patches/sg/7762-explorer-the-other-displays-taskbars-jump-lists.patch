From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the other displays' taskbars: jump lists

A right click on a button of another display's taskbar gave the window's system menu. As on the
main bar (and Windows): a window's jump list, a pinned program's, and Start's quick link menu
(Win+X); the system menu only where the main bar falls back to it.
---
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -5890,20 +5890,24 @@
         if (bar)
         {
             int i = sg_second_hit( bar, pt );
+            struct taskbar_button *win;
+            LPARAM at;
             ClientToScreen( hwnd, &pt );
-            if (i >= 0 && i < 64 && bar->button_pin[i] < 0)
+            at = MAKELPARAM( pt.x, pt.y );
+            sg_hide_thumbnails();
+            /* the main bar's menus: Start's quick links, a pinned program's jump list, a
+             * window's (its system menu when there is none: shift held, an elevated window) */
+            if (i == 64) shell_quick_link();
+            else if (i >= 0 && bar->button_pin[i] >= 0) sg_pin_menu( bar->button_pin[i], hwnd, at );
+            else if (i >= 0)
             {
-                /* the window's own menu (Restore, Move, Size, Minimize, Maximize, Close) */
-                HWND target = bar->button_hwnd[i];
-                HMENU menu = GetSystemMenu( target, FALSE );
-                int cmd;
-                if (!menu) return 0;
-                SetForegroundWindow( hwnd );
-                cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_BOTTOMALIGN, pt.x, pt.y, 0, hwnd, NULL );
-                if (cmd) PostMessageW( target, WM_SYSCOMMAND, cmd, 0 );
+                win = find_taskbar_button( bar->button_hwnd[i] );
+#ifndef SG_MUTANT_SECOND_SYSTEM_MENU
+                if (!win || win->elevated || !sg_button_menu( win, hwnd, at ))
+#endif
+                    SendNotifyMessageW( bar->button_hwnd[i], WM_POPUPSYSTEMMENU, 0, at );
             }
-            else if (i < 0) sg_taskbar_menu( MAKELPARAM( pt.x, pt.y ) );
-            /* (a pinned program's menu is the main bar's: its jump list there) */
+            else sg_taskbar_menu( at );
         }
         return 0;
     case WM_MOUSEACTIVATE:
