From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Support KeyValueFullInformationAlign64.

NtQueryValueKey and NtEnumerateValueKey take KeyValueFullInformationAlign64:
the KEY_VALUE_FULL_INFORMATION layout in a buffer that must start on an
8-byte boundary, STATUS_DATATYPE_MISALIGNMENT otherwise (WDK
KEY_VALUE_INFORMATION_CLASS).

Gate: test/ntdll-regalign64-gate.sh (64/32).
---
 dlls/ntdll/unix/registry.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/dlls/ntdll/unix/registry.c b/dlls/ntdll/unix/registry.c
index e897da6..3f1c1f9 100644
--- a/dlls/ntdll/unix/registry.c
+++ b/dlls/ntdll/unix/registry.c
@@ -544,6 +544,15 @@ NTSTATUS WINAPI NtEnumerateValueKey( HANDLE handle, ULONG index, KEY_VALUE_INFOR
 
     TRACE( "(%p,%u,%d,%p,%d)\n", handle, (int)index, info_class, info, (int)length );
 
+    /* the full layout, in a buffer that must start on an 8-byte boundary */
+    if (info_class == KeyValueFullInformationAlign64)
+    {
+#ifndef SG_MUTANT_ALIGN64_NO_CHECK
+        if ((ULONG_PTR)info & 7) return STATUS_DATATYPE_MISALIGNMENT;
+#endif
+        info_class = KeyValueFullInformation;
+    }
+
     /* compute the length we want to retrieve */
     switch (info_class)
     {
@@ -593,6 +602,15 @@ NTSTATUS WINAPI NtQueryValueKey( HANDLE handle, const UNICODE_STRING *name,
 
     if (name->Length > MAX_VALUE_LENGTH) return STATUS_OBJECT_NAME_NOT_FOUND;
 
+    /* the full layout, in a buffer that must start on an 8-byte boundary */
+    if (info_class == KeyValueFullInformationAlign64)
+    {
+#ifndef SG_MUTANT_ALIGN64_NO_CHECK
+        if ((ULONG_PTR)info & 7) return STATUS_DATATYPE_MISALIGNMENT;
+#endif
+        info_class = KeyValueFullInformation;
+    }
+
     /* compute the length we want to retrieve */
     switch(info_class)
     {
