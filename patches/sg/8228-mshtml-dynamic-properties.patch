+#ifndef SG_MUTANT_NO_CSS_EXPRESSIONS
+/* Stained Glass OS (wine-sg 8228): dynamic properties (style.setExpression): the expression is evaluated by the
+ * page's script engine when it is set and again at document.recalc, and the property set to its value as a
+ * script assignment would. Expressions written in style sheets (expression() values) are not read. */
+struct style_expression
+{
+    struct list entry;
+    WCHAR *prop;
+    WCHAR *expr;
+    WCHAR *lang;
+};
+
+static void free_style_expression(struct style_expression *e)
+{
+    list_remove(&e->entry);
+    free(e->prop);
+    free(e->expr);
+    free(e->lang);
+    free(e);
+}
+
+static struct style_expression *find_style_expression(HTMLStyle *style, const WCHAR *prop)
+{
+    struct style_expression *e;
+
+    if(!style->expressions.next) return NULL;
+    LIST_FOR_EACH_ENTRY(e, &style->expressions, struct style_expression, entry)
+        if(!wcsicmp(e->prop, prop)) return e;
+    return NULL;
+}
+
+static void evaluate_style_expression(HTMLStyle *style, struct style_expression *e)
+{
+    HTMLInnerWindow *window = style->elem && style->elem->node.doc ? style->elem->node.doc->window : NULL;
+    DISPPARAMS dp = { NULL, NULL, 1, 1 };
+    DISPID put_id = DISPID_PROPERTYPUT, dispid;
+    VARIANT value;
+    BSTR name;
+    HRESULT hres;
+
+    if(!window) return;
+    V_VT(&value) = VT_EMPTY;
+    hres = exec_script_expr_lang(window, e->expr, e->lang, &value);
+    if(FAILED(hres)) {
+        WARN("expression %s failed: %08lx\n", debugstr_w(e->expr), hres);
+        return;
+    }
+    name = SysAllocString(e->prop);
+    hres = IHTMLStyle_GetIDsOfNames(&style->IHTMLStyle_iface, &IID_NULL, &name, 1, 0, &dispid);
+    SysFreeString(name);
+    if(SUCCEEDED(hres)) {
+        dp.rgvarg = &value;
+        dp.rgdispidNamedArgs = &put_id;
+        hres = IHTMLStyle_Invoke(&style->IHTMLStyle_iface, dispid, &IID_NULL, 0, DISPATCH_PROPERTYPUT, &dp, NULL,
+                                 NULL, NULL);
+    }
+    if(FAILED(hres))
+        WARN("setting %s from %s failed: %08lx\n", debugstr_w(e->prop), debugstr_w(e->expr), hres);
+    VariantClear(&value);
+}
+
+static void free_style_expressions(HTMLStyle *style)
+{
+    struct style_expression *e, *next;
+
+    if(!style->expressions.next) return;
+    LIST_FOR_EACH_ENTRY_SAFE(e, next, &style->expressions, struct style_expression, entry)
+        free_style_expression(e);
+}
+
+/* document.recalc: every element style's expressions evaluated again */
+void recalc_style_expressions(HTMLDocumentNode *doc)
+{
+    nsIDOMNodeList *list = NULL;
+    nsAString name;
+    UINT32 count = 0, i;
+    nsresult nsres;
+
+    if(!doc->dom_document) return;
+    nsAString_InitDepend(&name, L"*");
+    nsres = nsIDOMDocument_GetElementsByTagName(doc->dom_document, &name, &list);
+    nsAString_Finish(&name);
+    if(NS_FAILED(nsres) || !list) return;
+    nsIDOMNodeList_GetLength(list, &count);
+    for(i = 0; i < count; i++) {
+        nsIDOMNode *nsnode = NULL;
+        HTMLDOMNode *node = NULL;
+        IHTMLElement *elem_iface = NULL;
+        HTMLElement *elem;
+        struct style_expression *e;
+
+        if(NS_FAILED(nsIDOMNodeList_Item(list, i, &nsnode)) || !nsnode) continue;
+        /* only elements a script has reached can carry expressions: no new wrappers */
+        if(SUCCEEDED(get_node(nsnode, FALSE, &node)) && node) {
+            if(SUCCEEDED(IHTMLDOMNode_QueryInterface(&node->IHTMLDOMNode_iface, &IID_IHTMLElement, (void**)&elem_iface))) {
+                elem = unsafe_impl_from_IHTMLElement(elem_iface);
+                if(elem && elem->style && elem->style->expressions.next) {
+                    LIST_FOR_EACH_ENTRY(e, &elem->style->expressions, struct style_expression, entry)
+                        evaluate_style_expression(elem->style, e);
+                }
+                IHTMLElement_Release(elem_iface);
+            }
+            node_release(node);
+        }
+        nsIDOMNode_Release(nsnode);
+    }
+    nsIDOMNodeList_Release(list);
+}
+
+static HRESULT WINAPI HTMLStyle2_setExpression(IHTMLStyle2 *iface, BSTR propname, BSTR expression, BSTR language)
+{
+    HTMLStyle *This = impl_from_IHTMLStyle2(iface);
+    struct style_expression *e;
+
+    TRACE("(%p)->(%s %s %s)\n", This, debugstr_w(propname), debugstr_w(expression), debugstr_w(language));
+
+    if(!propname || !*propname || !expression)
+        return E_INVALIDARG;
+    if(!This->expressions.next) list_init(&This->expressions);
+    if(!(e = find_style_expression(This, propname))) {
+        if(!(e = calloc(1, sizeof(*e))) || !(e->prop = wcsdup(propname))) {
+            free(e);
+            return E_OUTOFMEMORY;
+        }
+        list_add_tail(&This->expressions, &e->entry);
+    }
+    free(e->expr);
+    free(e->lang);
+    e->expr = wcsdup(expression);
+    e->lang = language && *language ? wcsdup(language) : NULL;
+    if(!e->expr) {
+        free_style_expression(e);
+        return E_OUTOFMEMORY;
+    }
+    evaluate_style_expression(This, e);
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLStyle2_getExpression(IHTMLStyle2 *iface, BSTR propname, VARIANT *expression)
+{
+    HTMLStyle *This = impl_from_IHTMLStyle2(iface);
+    struct style_expression *e;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(propname), expression);
+
+    if(!expression)
+        return E_POINTER;
+    V_VT(expression) = VT_EMPTY;
+    if(propname && (e = find_style_expression(This, propname))) {
+        V_VT(expression) = VT_BSTR;
+        if(!(V_BSTR(expression) = SysAllocString(e->expr))) {
+            V_VT(expression) = VT_EMPTY;
+            return E_OUTOFMEMORY;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI HTMLStyle2_removeExpression(IHTMLStyle2 *iface, BSTR propname, VARIANT_BOOL *pfSuccess)
+{
+    HTMLStyle *This = impl_from_IHTMLStyle2(iface);
+    struct style_expression *e;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(propname), pfSuccess);
+
+    e = propname ? find_style_expression(This, propname) : NULL;
+    if(e) free_style_expression(e);
+    if(pfSuccess) *pfSuccess = e ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+#else
+static void free_style_expressions(HTMLStyle *style) {}
+void recalc_style_expressions(HTMLDocumentNode *doc) {}
+
 static HRESULT WINAPI HTMLStyle2_setExpression(IHTMLStyle2 *iface, BSTR propname, BSTR expression, BSTR language)
 {
     HTMLStyle *This = impl_from_IHTMLStyle2(iface);
@@ -4374,6 +4549,7 @@
     FIXME("(%p)->(%s %p)\n", This, debugstr_w(propname), pfSuccess);
     return E_NOTIMPL;
 }
+#endif
 
