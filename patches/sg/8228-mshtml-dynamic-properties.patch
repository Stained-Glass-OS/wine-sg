+/* (wine-sg 8228) an expression in the given script language (JScript when none), its value in ret */
+HRESULT exec_script_expr_lang(HTMLInnerWindow *window, const WCHAR *code, const WCHAR *lang, VARIANT *ret)
+{
+    ScriptHost *script_host;
+    EXCEPINFO ei;
+    GUID guid;
+
+    if(!get_guid_from_language(lang && *lang ? lang : L"jscript", &guid))
+        return CO_E_CLASSSTRING;
+
+    script_host = get_script_host(window, &guid);
+    if(!script_host || !script_host->parse)
+        return E_FAIL;
+
+    memset(&ei, 0, sizeof(ei));
+    return IActiveScriptParse_ParseScriptText(script_host->parse, code, NULL, NULL, L"\"", 0, 0,
+                                              SCRIPTTEXT_ISVISIBLE | SCRIPTTEXT_ISEXPRESSION, ret, &ei);
+}
+
 IDispatch *get_script_disp(ScriptHost *script_host)
 {
     IDispatch *disp;
