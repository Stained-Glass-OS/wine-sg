+    LIST_FOR_EACH_ENTRY(entity, &reader->entities, struct entity, entry)
+    {
+        if (entity->name_len == name->len && !memcmp(entity->name, str, name->len * sizeof(WCHAR)))
+            return entity;
+    }
+
+    return NULL;
+}
