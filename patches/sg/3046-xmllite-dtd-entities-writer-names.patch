+/* Records the attribute in the open start tag, fails on duplicates. */
+static HRESULT writer_track_attribute(xmlwriter *writer, const WCHAR *prefix, int prefix_len,
+        const WCHAR *local, int local_len)
+{
+    struct element *element;
+    unsigned int i, len;
+    WCHAR *qname;
+
+    if (!(element = LIST_ENTRY(list_head(&writer->elements), struct element, entry)))
+        return S_OK;
+
+    len = (prefix_len ? prefix_len + 1 : 0) + local_len;
+    if (!(qname = writer_alloc(writer, (len + 1) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    if (prefix_len)
+    {
+        memcpy(qname, prefix, prefix_len * sizeof(WCHAR));
+        qname[prefix_len] = ':';
+    }
+    memcpy(qname + (prefix_len ? prefix_len + 1 : 0), local, local_len * sizeof(WCHAR));
+    qname[len] = 0;
+
+    for (i = 0; i < element->attr_count; ++i)
+    {
+        if (!wcscmp(element->attrs[i], qname))
+        {
+            writer_free(writer, qname);
+            return WR_E_DUPLICATEATTRIBUTE;
+        }
+    }
+
+    if (element->attr_count == element->attr_size)
+    {
+        unsigned int new_size = element->attr_size ? element->attr_size * 2 : 8;
+        WCHAR **new_attrs = writer_alloc(writer, new_size * sizeof(*new_attrs));
+
+        if (!new_attrs)
+        {
+            writer_free(writer, qname);
+            return E_OUTOFMEMORY;
+        }
+        if (element->attrs)
+            memcpy(new_attrs, element->attrs, element->attr_count * sizeof(*new_attrs));
+        writer_free(writer, element->attrs);
+        element->attrs = new_attrs;
+        element->attr_size = new_size;
+    }
+    element->attrs[element->attr_count++] = qname;
+    return S_OK;
+}
