+static void test_internal_subset(void)
+{
+    static const char *xml =
+        "<!DOCTYPE doc [\n"
+        "<!-- a comment with > in it -->\n"
+        "<!ELEMENT doc (#PCDATA)>\n"
+        "<!ATTLIST doc a CDATA \"x>y\">\n"
+        "<!ENTITY e1 \"hello\">\n"
+        "<!ENTITY e2 \"[&e1;]\">\n"
+        "<!ENTITY % pe \"ignored\">\n"
+        "<!ENTITY ext SYSTEM \"file.xml\">\n"
+        "]>\n"
+        "<doc a=\"&e1;!\">&e1; &e2;&amp;</doc>";
+    const WCHAR *str;
+    IXmlReader *reader;
+    XmlNodeType type;
+    LONG_PTR value;
+    UINT len;
+    HRESULT hr;
+
+    hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlReader_SetProperty(reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Parse);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    set_input_string(reader, xml);
+
+    read_node(reader, XmlNodeType_DocumentType);
+    read_node(reader, XmlNodeType_Whitespace);
+    read_node(reader, XmlNodeType_Element);
+
+    hr = IXmlReader_MoveToFirstAttribute(reader);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlReader_GetValue(reader, &str, &len);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!wcscmp(str, L"hello!"), "Unexpected value %s.\n", wine_dbgstr_w(str));
+
+    read_node(reader, XmlNodeType_Text);
+    hr = IXmlReader_GetValue(reader, &str, &len);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!wcscmp(str, L"hello [hello]&"), "Unexpected value %s.\n", wine_dbgstr_w(str));
+    read_node(reader, XmlNodeType_EndElement);
+
+    /* Entity expansion limit. */
+    hr = IXmlReader_SetProperty(reader, XmlReaderProperty_MaxEntityExpansion, 3);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    value = 0;
+    hr = IXmlReader_GetProperty(reader, XmlReaderProperty_MaxEntityExpansion, &value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(value == 3, "Unexpected value %Id.\n", value);
+
+    set_input_string(reader, xml);
+    read_node(reader, XmlNodeType_DocumentType);
+    read_node(reader, XmlNodeType_Whitespace);
+    hr = IXmlReader_Read(reader, &type);
+    ok(hr == SC_E_MAXENTITYEXPANSION, "Unexpected hr %#lx.\n", hr);
+
+    /* Prohibited by default. */
+    IXmlReader_Release(reader);
+    CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    set_input_string(reader, xml);
+    hr = IXmlReader_Read(reader, &type);
+    ok(hr == WC_E_DTDPROHIBITED, "Unexpected hr %#lx.\n", hr);
+
+    /* Base URI. */
+    hr = IXmlReader_GetBaseUri(reader, &str, &len);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    IXmlReader_Release(reader);
+}
+
 START_TEST(reader)
 {
