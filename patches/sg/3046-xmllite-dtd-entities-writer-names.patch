+static HRESULT reader_add_entity(xmlreader *reader, const WCHAR *name, UINT name_len, const WCHAR *value, UINT value_len)
+{
+    struct entity *entity;
+
+    /* first declaration wins */
+    LIST_FOR_EACH_ENTRY(entity, &reader->entities, struct entity, entry)
+        if (entity->name_len == name_len && !memcmp(entity->name, name, name_len * sizeof(WCHAR)))
+            return S_OK;
+
+    if (!(entity = reader_alloc_zero(reader, sizeof(*entity)))) return E_OUTOFMEMORY;
+    entity->name = reader_alloc(reader, (name_len + 1) * sizeof(WCHAR));
+    entity->value = reader_alloc(reader, (value_len + 1) * sizeof(WCHAR));
+    if (!entity->name || !entity->value)
+    {
+        reader_free(reader, entity->name);
+        reader_free(reader, entity->value);
+        reader_free(reader, entity);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(entity->name, name, name_len * sizeof(WCHAR));
+    entity->name[name_len] = 0;
+    entity->name_len = name_len;
+    memcpy(entity->value, value, value_len * sizeof(WCHAR));
+    entity->value[value_len] = 0;
+    entity->value_len = value_len;
+    list_add_tail(&reader->entities, &entity->entry);
+    return S_OK;
+}
