+/* skips a quoted literal, optionally collecting it (character references are resolved) */
+static HRESULT reader_intsubset_literal(xmlreader *reader, WCHAR **out, UINT *out_len)
+{
+    WCHAR *ptr = reader_get_ptr(reader), quote = *ptr, *buf = NULL;
+    UINT len = 0, alloc = 0;
+
+    if (quote != '"' && quote != '\'') return WC_E_QUOTE;
+    reader_skipn(reader, 1);
+
+    for (;;)
+    {
+        WCHAR ch;
+
+        ptr = reader_get_ptr(reader);
+        ch = *ptr;
+        if (!ch)
+        {
+            reader_free(reader, buf);
+            return WC_E_QUOTE;
+        }
+        if (ch == quote)
+        {
+            reader_skipn(reader, 1);
+            break;
+        }
+        if (out)
+        {
+            if (ch == '&' && ptr[1] == '#')
+            {
+                UINT code = 0, base = 10, i = 2;
+
+                if (ptr[i] == 'x') { base = 16; i++; }
+                while (ptr[i] && ptr[i] != ';')
+                {
+                    WCHAR c = ptr[i];
+                    UINT d = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 :
+                             (c >= 'A' && c <= 'F') ? c - 'A' + 10 : 16;
+                    if (d >= base) { reader_free(reader, buf); return WC_E_DIGIT; }
+                    code = code * base + d;
+                    if (code > 0xffff) { reader_free(reader, buf); return WC_E_XMLCHARACTER; }
+                    i++;
+                }
+                if (ptr[i] != ';' || !is_char(code)) { reader_free(reader, buf); return WC_E_SEMICOLON; }
+                reader_skipn(reader, i);
+                ch = code;
+            }
+            if (len + 1 > alloc)
+            {
+                WCHAR *new = reader_alloc(reader, (alloc = alloc ? alloc * 2 : 64) * sizeof(WCHAR));
+                if (!new) { reader_free(reader, buf); return E_OUTOFMEMORY; }
+                if (buf) memcpy(new, buf, len * sizeof(WCHAR));
+                reader_free(reader, buf);
+                buf = new;
+            }
+            buf[len++] = ch;
+        }
+        reader_skipn(reader, 1);
+    }
+
+    if (out)
+    {
+        if (!buf && !(buf = reader_alloc(reader, sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        *out = buf;
+        *out_len = len;
+    }
+    return S_OK;
+}
+
+/* Skips the remainder of a markup declaration up to and including '>' */
+static HRESULT reader_intsubset_skip_decl(xmlreader *reader)
+{
+    for (;;)
+    {
+        WCHAR *ptr = reader_get_ptr(reader);
+        HRESULT hr;
+
+        if (!*ptr) return WC_E_SYNTAX;
+        if (*ptr == '"' || *ptr == '\'')
+        {
+            if (FAILED(hr = reader_intsubset_literal(reader, NULL, NULL))) return hr;
+            continue;
+        }
+        reader_skipn(reader, 1);
+        if (*ptr == '>') return S_OK;
+    }
+}
+
+/* [28b] intSubset ::= (markupdecl | DeclSep)* , after '[' and up to and including ']' */
+static HRESULT reader_parse_intsubset(xmlreader *reader)
+{
+    HRESULT hr;
+
+    for (;;)
+    {
+        WCHAR *ptr;
+
+        reader_skipspaces(reader);
+        ptr = reader_get_ptr(reader);
+
+        if (!*ptr) return WC_E_SYNTAX;
+        if (*ptr == ']')
+        {
+            reader_skipn(reader, 1);
+            return S_OK;
+        }
+        if (*ptr == '%')
+        {
+            /* parameter entity reference as declaration separator */
+            while (*ptr && *ptr != ';') { reader_skipn(reader, 1); ptr = reader_get_ptr(reader); }
+            if (*ptr != ';') return WC_E_SEMICOLON;
+            reader_skipn(reader, 1);
+            continue;
+        }
+        if (!reader_cmp(reader, L"<!--"))
+        {
+            reader_skipn(reader, 4);
+            while (reader_cmp(reader, L"-->"))
+            {
+                if (!*reader_get_ptr(reader)) return WC_E_COMMENT;
+                reader_skipn(reader, 1);
+            }
+            reader_skipn(reader, 3);
+            continue;
+        }
+        if (!reader_cmp(reader, L"<?"))
+        {
+            reader_skipn(reader, 2);
+            while (reader_cmp(reader, L"?>"))
+            {
+                if (!*reader_get_ptr(reader)) return WC_E_PI;
+                reader_skipn(reader, 1);
+            }
+            reader_skipn(reader, 2);
+            continue;
+        }
+        if (!reader_cmp(reader, L"<!ENTITY"))
+        {
+            BOOL parameter = FALSE;
+            WCHAR *value = NULL;
+            UINT value_len = 0;
+            strval name;
+
+            reader_skipn(reader, 8);
+            if (!reader_skipspaces(reader)) return WC_E_WHITESPACE;
+            if (*reader_get_ptr(reader) == '%')
+            {
+                parameter = TRUE;
+                reader_skipn(reader, 1);
+                if (!reader_skipspaces(reader)) return WC_E_WHITESPACE;
+            }
+            if (FAILED(hr = reader_parse_name(reader, &name))) return WC_E_DECLENTITY;
+            if (!reader_skipspaces(reader)) return WC_E_WHITESPACE;
+
+            ptr = reader_get_ptr(reader);
+            if (*ptr == '"' || *ptr == '\'')
+            {
+                if (FAILED(hr = reader_intsubset_literal(reader, &value, &value_len))) return hr;
+                if (!parameter && !get_predefined_entity(reader, &name))
+                    hr = reader_add_entity(reader, reader_get_strptr(reader, &name), name.len, value, value_len);
+                reader_free(reader, value);
+                if (FAILED(hr)) return hr;
+            }
+            /* external and unparsed entities are not expanded, skip them */
+            if (FAILED(hr = reader_intsubset_skip_decl(reader))) return hr;
+            continue;
+        }
+        if (!reader_cmp(reader, L"<!"))
+        {
+            if (FAILED(hr = reader_intsubset_skip_decl(reader))) return hr;
+            continue;
+        }
+
+        return WC_E_SYNTAX;
+    }
+}
