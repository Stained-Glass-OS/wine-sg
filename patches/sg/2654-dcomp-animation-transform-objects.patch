+        return E_OUTOFMEMORY;
+    clip->object.vtbl = &clip_vtbl;
+    clip->object.refcount = 1;
+    clip->object.iids = clip_iids;
+    clip->object.destroy = clip_destroy;
+    *out = (IDCompositionRectangleClip *)&clip->object;
+    return S_OK;
+}
+
+/* Effect groups */
+
+struct dc_effect
+{
+    struct dc_object object;
+    struct dc_value opacity;
+    IDCompositionTransform3D *transform3d;
+};
+
+static const IDCompositionEffectGroupVtbl effect_vtbl;
+static const GUID *const effect_iids[] = { &IID_IDCompositionEffect, &IID_IDCompositionEffectGroup, NULL };
+
+static struct dc_effect *unsafe_effect(void *iface)
+{
+    if (!iface || *(const void **)iface != &effect_vtbl)
+        return NULL;
+    return CONTAINING_RECORD(iface, struct dc_effect, object.vtbl);
+}
+
+BOOL dc_is_effect(IDCompositionEffect *effect)
+{
+    return !!unsafe_effect(effect) || !!unsafe_transform((IUnknown *)effect);
+}
+
+static void effect_destroy(struct dc_object *object)
+{
+    struct dc_effect *effect = CONTAINING_RECORD(object, struct dc_effect, object);
+
+    value_clear(&effect->opacity);
+    if (effect->transform3d)
+        IDCompositionTransform3D_Release(effect->transform3d);
+    free(effect);
+}
+
+IUNKNOWN_METHODS(effect, IDCompositionEffectGroup)
+
+static HRESULT STDMETHODCALLTYPE effect_SetOpacity(IDCompositionEffectGroup *iface, float opacity)
+{
+    struct dc_effect *effect = unsafe_effect(iface);
+
+    TRACE("iface %p, opacity %.8e.\n", iface, opacity);
+
+    return value_set(&effect->opacity, opacity);
+}
+
+static HRESULT STDMETHODCALLTYPE effect_SetOpacityAnimation(IDCompositionEffectGroup *iface,
+        IDCompositionAnimation *animation)
+{
+    struct dc_effect *effect = unsafe_effect(iface);
+
+    TRACE("iface %p, animation %p.\n", iface, animation);
+
+    return value_set_animation(&effect->opacity, animation);
+}
+
+static HRESULT STDMETHODCALLTYPE effect_SetTransform3D(IDCompositionEffectGroup *iface,
+        IDCompositionTransform3D *transform)
+{
+    struct dc_effect *effect = unsafe_effect(iface);
+
+    TRACE("iface %p, transform %p.\n", iface, transform);
+
+    if (transform && !unsafe_transform((IUnknown *)transform))
+        return E_INVALIDARG;
+    if (transform)
+        IDCompositionTransform3D_AddRef(transform);
+    if (effect->transform3d)
+        IDCompositionTransform3D_Release(effect->transform3d);
+    effect->transform3d = transform;
+    return S_OK;
+}
+
+static const IDCompositionEffectGroupVtbl effect_vtbl =
+{
+    effect_QueryInterface, effect_AddRef, effect_Release,
+    effect_SetOpacity,
+    effect_SetOpacityAnimation,
+    effect_SetTransform3D,
+};
+
+HRESULT dc_create_effect_group(IDCompositionEffectGroup **out)
+{
+    struct dc_effect *effect;
+
+    if (!(effect = calloc(1, sizeof(*effect))))
+        return E_OUTOFMEMORY;
+    effect->object.vtbl = &effect_vtbl;
+    effect->object.refcount = 1;
+    effect->object.iids = effect_iids;
+    effect->object.destroy = effect_destroy;
+    effect->opacity.value = 1.0f;
+    *out = (IDCompositionEffectGroup *)&effect->object;
+    return S_OK;
+}
