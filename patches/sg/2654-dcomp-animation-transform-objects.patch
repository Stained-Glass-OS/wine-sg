+HRESULT dc_create_animation(IDCompositionAnimation **out)
+{
+    struct dc_animation *animation;
+
+    if (!(animation = calloc(1, sizeof(*animation))))
+        return E_OUTOFMEMORY;
+    animation->object.vtbl = &animation_vtbl;
+    animation->object.refcount = 1;
+    animation->object.iids = animation_iids;
+    animation->object.destroy = animation_destroy;
+    *out = (IDCompositionAnimation *)&animation->object;
+    return S_OK;
+}
+
+static float segment_value(const struct segment *segment, double t)
+{
+    double dt = t - segment->offset;
+
+    switch (segment->type)
+    {
+        case SEGMENT_CUBIC:
+            return segment->a + dt * (segment->b + dt * (segment->c + dt * segment->d));
+        case SEGMENT_SINUSOIDAL:
+            /* bias + amplitude * sin(2 pi frequency t + phase), the phase in degrees */
+            return segment->a + segment->b * sin(2.0 * M_PI * segment->c * dt + segment->d * M_PI / 180.0);
+        default:
+            return segment->a;
+    }
+}
+
+float dc_animation_value(IDCompositionAnimation *iface, LONGLONG now)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+    LARGE_INTEGER frequency;
+    unsigned int i, pass;
+    double t;
+
+    if (!animation || !animation->count)
+        return 0.0f;
+    if (!animation->begin_set)
+    {
+        animation->begin_set = TRUE;
+        animation->begin = now;
+    }
+    QueryPerformanceFrequency(&frequency);
+    t = (double)(now - animation->begin) / frequency.QuadPart;
+    if (t < animation->segments[0].offset)
+        t = animation->segments[0].offset;
+
+    for (pass = 0; pass < 16; ++pass)
+    {
+        BOOL again = FALSE;
+
+        for (i = animation->count; i--;)
+        {
+            const struct segment *segment = &animation->segments[i];
+
+            if (segment->offset > t)
+                continue;
+            if (segment->type == SEGMENT_REPEAT)
+            {
+                /* the animation replays the stretch of time before the repeat */
+                t = segment->offset - segment->duration + fmod(t - segment->offset, segment->duration);
+                if (t < animation->segments[0].offset)
+                    t = animation->segments[0].offset;
+                again = TRUE;
+                break;
+            }
+            return segment_value(segment, t);
+        }
+        if (!again)
+            break;
+    }
+    return segment_value(&animation->segments[0], animation->segments[0].offset);
+}
+
+/* An animatable number. */
+
+struct dc_value
+{
+    float value;
+    IDCompositionAnimation *animation;
+};
+
+static void value_clear(struct dc_value *v)
+{
+    if (v->animation)
+        IDCompositionAnimation_Release(v->animation);
+    v->animation = NULL;
+}
+
+static HRESULT value_set(struct dc_value *v, float value)
+{
+    if (!dc_finite(value))
+        return E_INVALIDARG;
+    value_clear(v);
+    v->value = value;
+    return S_OK;
+}
+
+static HRESULT value_set_animation(struct dc_value *v, IDCompositionAnimation *animation)
+{
+#ifndef SG_MUTANT_DC_FOREIGN_ANIM
+    if (!dc_is_animation(animation))
+        return E_INVALIDARG;
+#else
+    if (!animation)
+        return E_INVALIDARG;
+#endif
+    IDCompositionAnimation_AddRef(animation);
+    value_clear(v);
+    v->animation = animation;
+    return S_OK;
+}
+
+static float value_get(const struct dc_value *v, LONGLONG now)
+{
+    return v->animation ? dc_animation_value(v->animation, now) : v->value;
+}
+
+/* Matrices; a point is a row vector, so "a then b" is a * b. */
+
+void dc_matrix_multiply(const D2D_MATRIX_3X2_F *a, const D2D_MATRIX_3X2_F *b, D2D_MATRIX_3X2_F *out)
+{
+    D2D_MATRIX_3X2_F r;
+
+    r._11 = a->_11 * b->_11 + a->_12 * b->_21;
+    r._12 = a->_11 * b->_12 + a->_12 * b->_22;
+    r._21 = a->_21 * b->_11 + a->_22 * b->_21;
+    r._22 = a->_21 * b->_12 + a->_22 * b->_22;
+    r._31 = a->_31 * b->_11 + a->_32 * b->_21 + b->_31;
+    r._32 = a->_31 * b->_12 + a->_32 * b->_22 + b->_32;
+    *out = r;
+}
+
+static void matrix_identity(D2D_MATRIX_3X2_F *m)
+{
+    m->_11 = 1.0f; m->_12 = 0.0f;
+    m->_21 = 0.0f; m->_22 = 1.0f;
+    m->_31 = 0.0f; m->_32 = 0.0f;
+}
+
+/* m, applied about the point (cx, cy) */
+static void matrix_about(D2D_MATRIX_3X2_F *m, float cx, float cy)
+{
+    D2D_MATRIX_3X2_F to_origin, back;
+
+    matrix_identity(&to_origin);
+    to_origin._31 = -cx;
+    to_origin._32 = -cy;
+    matrix_identity(&back);
+    back._31 = cx;
+    back._32 = cy;
+    dc_matrix_multiply(&to_origin, m, m);
+    dc_matrix_multiply(m, &back, m);
+}
+
+/* Transforms */
+
+enum transform_kind { TRANSFORM_TRANSLATE, TRANSFORM_SCALE, TRANSFORM_ROTATE, TRANSFORM_SKEW, TRANSFORM_MATRIX,
+        TRANSFORM_GROUP };
+
+struct dc_transform
+{
+    struct dc_object object;
+    enum transform_kind kind;
+    struct dc_value v[6];
+    IDCompositionTransform **children;
+    UINT count;
+};
