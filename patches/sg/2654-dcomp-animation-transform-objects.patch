+HRESULT dc_create_transform_group(IDCompositionTransform **transforms, UINT count, IDCompositionTransform **out)
+{
+    struct dc_transform *t;
+    UINT i;
+
+    if (!transforms || !count)
+        return E_INVALIDARG;
+    for (i = 0; i < count; ++i)
+        if (!unsafe_transform((IUnknown *)transforms[i]))
+            return E_INVALIDARG;
+    if (!(t = transform_alloc(TRANSFORM_GROUP, &group_vtbl, group_iids)))
+        return E_OUTOFMEMORY;
+    if (!(t->children = calloc(count, sizeof(*t->children))))
+    {
+        free(t);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        IDCompositionTransform_AddRef(transforms[i]);
+        t->children[i] = transforms[i];
+    }
+    t->count = count;
+    *out = (IDCompositionTransform *)&t->object;
+    return S_OK;
+}
