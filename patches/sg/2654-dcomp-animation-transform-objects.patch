+static struct dc_transform *unsafe_transform(IUnknown *iface)
+{
+    const void *vtbl;
+
+    if (!iface)
+        return NULL;
+    vtbl = *(const void **)iface;
+    if (vtbl != &translate_vtbl && vtbl != &scale_vtbl && vtbl != &rotate_vtbl && vtbl != &skew_vtbl
+            && vtbl != &matrix_vtbl && vtbl != &group_vtbl)
+        return NULL;
+    return CONTAINING_RECORD(iface, struct dc_transform, object.vtbl);
+}
+
+BOOL dc_is_transform(IUnknown *object)
+{
+    return !!unsafe_transform(object);
+}
+
+static void transform_destroy(struct dc_object *object)
+{
+    struct dc_transform *transform = CONTAINING_RECORD(object, struct dc_transform, object);
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(transform->v); ++i)
+        value_clear(&transform->v[i]);
+    for (i = 0; i < transform->count; ++i)
+        IDCompositionTransform_Release(transform->children[i]);
+    free(transform->children);
+    free(transform);
+}
+
+void dc_transform_matrix(IUnknown *iface, LONGLONG now, D2D_MATRIX_3X2_F *m)
+{
+    struct dc_transform *t = unsafe_transform(iface);
+    float x, y, cx, cy, angle;
+    unsigned int i;
+
+    matrix_identity(m);
+    if (!t)
+        return;
+    switch (t->kind)
+    {
+        case TRANSFORM_TRANSLATE:
+            m->_31 = value_get(&t->v[0], now);
+            m->_32 = value_get(&t->v[1], now);
+            break;
+        case TRANSFORM_SCALE:
+            m->_11 = value_get(&t->v[0], now);
+            m->_22 = value_get(&t->v[1], now);
+            matrix_about(m, value_get(&t->v[2], now), value_get(&t->v[3], now));
+            break;
+        case TRANSFORM_ROTATE:
+            angle = value_get(&t->v[0], now) * (float)M_PI / 180.0f;
+            m->_11 = cosf(angle);
+            m->_12 = sinf(angle);
+            m->_21 = -sinf(angle);
+            m->_22 = cosf(angle);
+            matrix_about(m, value_get(&t->v[1], now), value_get(&t->v[2], now));
+            break;
+        case TRANSFORM_SKEW:
+            x = value_get(&t->v[0], now) * (float)M_PI / 180.0f;
+            y = value_get(&t->v[1], now) * (float)M_PI / 180.0f;
+            cx = value_get(&t->v[2], now);
+            cy = value_get(&t->v[3], now);
+            m->_12 = tanf(y);
+            m->_21 = tanf(x);
+            matrix_about(m, cx, cy);
+            break;
+        case TRANSFORM_MATRIX:
+            m->_11 = value_get(&t->v[0], now);
+            m->_12 = value_get(&t->v[1], now);
+            m->_21 = value_get(&t->v[2], now);
+            m->_22 = value_get(&t->v[3], now);
+            m->_31 = value_get(&t->v[4], now);
+            m->_32 = value_get(&t->v[5], now);
+            break;
+        case TRANSFORM_GROUP:
+            for (i = 0; i < t->count; ++i)
+            {
+                D2D_MATRIX_3X2_F child;
+
+                dc_transform_matrix((IUnknown *)t->children[i], now, &child);
+                dc_matrix_multiply(m, &child, m);
+            }
+            break;
+    }
+}
+
+#define TRANSFORM_PROP(type, iface_type, name, index) \
+static HRESULT STDMETHODCALLTYPE type##_Set##name(iface_type *iface, float value) \
+{ \
+    struct dc_transform *t = unsafe_transform((IUnknown *)iface); \
