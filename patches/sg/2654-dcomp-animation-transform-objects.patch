+/*
+ * The objects only hold values: an animation is a list of segments evaluated
+ * for a point in time, a transform is turned into a matrix, and the version 1
+ * device uses them when it commits a visual tree (the offset of a visual's
+ * content follows the visual's transform and animated offsets).  Clips and
+ * effects are kept and validated; nothing draws with them yet.
+ */
+
+#include <math.h>
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objidl.h"
+#include "dcomp.h"
+#include "wine/debug.h"
+
+#include "dcomp_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+BOOL dc_finite(float value)
+{
+#ifdef SG_MUTANT_DC_NOFINITE
+    return TRUE;
+#else
+    return isfinite(value);
+#endif
+}
+
+/* Shared by every object: IUnknown. */
+
+struct dc_object
+{
+    const void *vtbl;
+    LONG refcount;
+    const GUID *const *iids;
+    void (*destroy)(struct dc_object *object);
+};
+
+static HRESULT dc_object_query_interface(struct dc_object *object, REFIID iid, void **out)
+{
+    unsigned int i;
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown))
+        goto found;
+    for (i = 0; object->iids[i]; ++i)
+        if (IsEqualGUID(iid, object->iids[i]))
+            goto found;
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    return E_NOINTERFACE;
+found:
+    InterlockedIncrement(&object->refcount);
+    *out = object;
+    return S_OK;
+}
+
+static ULONG dc_object_release(struct dc_object *object)
+{
+    ULONG refcount = InterlockedDecrement(&object->refcount);
+
+    if (!refcount)
+        object->destroy(object);
+    return refcount;
+}
+
+#define IUNKNOWN_METHODS(prefix, type) \
+static HRESULT STDMETHODCALLTYPE prefix##_QueryInterface(type *iface, REFIID iid, void **out) \
+{ \
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out); \
+    return dc_object_query_interface((struct dc_object *)iface, iid, out); \
+} \
+static ULONG STDMETHODCALLTYPE prefix##_AddRef(type *iface) \
+{ \
+    return InterlockedIncrement(&((struct dc_object *)iface)->refcount); \
+} \
+static ULONG STDMETHODCALLTYPE prefix##_Release(type *iface) \
+{ \
+    TRACE("iface %p.\n", iface); \
+    return dc_object_release((struct dc_object *)iface); \
+}
+
+/* Animations */
+
+enum segment_type { SEGMENT_CUBIC, SEGMENT_SINUSOIDAL, SEGMENT_REPEAT, SEGMENT_END };
+
+struct segment
+{
+    enum segment_type type;
+    double offset;
+    float a, b, c, d;
+    double duration;
+};
+
+struct dc_animation
+{
+    struct dc_object object;
+    struct segment *segments;
+    unsigned int count, capacity;
+    BOOL ended;
+    BOOL begin_set;
+    LONGLONG begin;
+};
+
+static const IDCompositionAnimationVtbl animation_vtbl;
+static const GUID *const animation_iids[] = { &IID_IDCompositionAnimation, NULL };
+
+static struct dc_animation *impl_from_animation(IDCompositionAnimation *iface)
+{
+    if (!iface || iface->lpVtbl != &animation_vtbl)
+        return NULL;
+    return CONTAINING_RECORD(iface, struct dc_animation, object.vtbl);
+}
+
+BOOL dc_is_animation(IDCompositionAnimation *animation)
+{
+    return !!impl_from_animation(animation);
+}
+
+IUNKNOWN_METHODS(animation, IDCompositionAnimation)
+
+static void animation_destroy(struct dc_object *object)
+{
+    struct dc_animation *animation = CONTAINING_RECORD(object, struct dc_animation, object);
+
+    free(animation->segments);
+    free(animation);
+}
+
+static HRESULT STDMETHODCALLTYPE animation_Reset(IDCompositionAnimation *iface)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    animation->count = 0;
+    animation->ended = FALSE;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_SetAbsoluteBeginTime(IDCompositionAnimation *iface, LARGE_INTEGER time)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+
+    TRACE("iface %p, time %I64d.\n", iface, time.QuadPart);
+
+    animation->begin_set = TRUE;
+    animation->begin = time.QuadPart;
+    return S_OK;
+}
+
+static BOOL dc_finite_double(double value)
+{
+    return isfinite(value);
+}
+
+static HRESULT animation_add(struct dc_animation *animation, const struct segment *segment)
+{
+#ifndef SG_MUTANT_DC_ANIM_ENDED
+    if (animation->ended)
+        return E_INVALIDARG;
+#endif
+    if (!dc_finite_double(segment->offset) || segment->offset < 0.0)
+        return E_INVALIDARG;
+#ifndef SG_MUTANT_DC_ANIM_ORDER
+    if (animation->count && segment->offset < animation->segments[animation->count - 1].offset)
+        return E_INVALIDARG;
+#endif
+    if (animation->count == animation->capacity)
+    {
+        unsigned int capacity = max(8, animation->capacity * 2);
+        struct segment *segments;
+
+        if (!(segments = realloc(animation->segments, capacity * sizeof(*segments))))
+            return E_OUTOFMEMORY;
+        animation->segments = segments;
+        animation->capacity = capacity;
+    }
+    animation->segments[animation->count++] = *segment;
+    if (segment->type == SEGMENT_END)
+        animation->ended = TRUE;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_AddCubic(IDCompositionAnimation *iface, double offset,
+        float constant, float linear, float quadratic, float cubic)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+    struct segment segment = { SEGMENT_CUBIC, offset, constant, linear, quadratic, cubic };
+
+    TRACE("iface %p, offset %.8e, %.8e, %.8e, %.8e, %.8e.\n", iface, offset, constant, linear, quadratic, cubic);
+
+    if (!dc_finite(constant) || !dc_finite(linear) || !dc_finite(quadratic) || !dc_finite(cubic))
+        return E_INVALIDARG;
+    return animation_add(animation, &segment);
+}
+
+static HRESULT STDMETHODCALLTYPE animation_AddSinusoidal(IDCompositionAnimation *iface, double offset,
+        float bias, float amplitude, float frequency, float phase)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+    struct segment segment = { SEGMENT_SINUSOIDAL, offset, bias, amplitude, frequency, phase };
+
+    TRACE("iface %p, offset %.8e, %.8e, %.8e, %.8e, %.8e.\n", iface, offset, bias, amplitude, frequency, phase);
+
+    if (!dc_finite(bias) || !dc_finite(amplitude) || !dc_finite(frequency) || !dc_finite(phase) || frequency < 0.0f)
+        return E_INVALIDARG;
+    return animation_add(animation, &segment);
+}
+
+static HRESULT STDMETHODCALLTYPE animation_AddRepeat(IDCompositionAnimation *iface, double offset, double duration)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+    struct segment segment = { SEGMENT_REPEAT, offset };
+
+    TRACE("iface %p, offset %.8e, duration %.8e.\n", iface, offset, duration);
+
+    if (!dc_finite_double(duration) || duration <= 0.0)
+        return E_INVALIDARG;
+    segment.duration = duration;
+    return animation_add(animation, &segment);
+}
+
+static HRESULT STDMETHODCALLTYPE animation_End(IDCompositionAnimation *iface, double offset, float value)
+{
+    struct dc_animation *animation = impl_from_animation(iface);
+    struct segment segment = { SEGMENT_END, offset, value };
+
+    TRACE("iface %p, offset %.8e, value %.8e.\n", iface, offset, value);
+
+    if (!dc_finite(value))
+        return E_INVALIDARG;
+    return animation_add(animation, &segment);
+}
