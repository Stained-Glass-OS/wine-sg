+        { translate_iids, scale_iids, rotate_iids, skew_iids, matrix_iids };
+
+static struct dc_transform *transform_alloc(enum transform_kind kind, const void *vtbl, const GUID *const *iids)
+{
+    struct dc_transform *t;
+
+    if (!(t = calloc(1, sizeof(*t))))
+        return NULL;
+    t->object.vtbl = vtbl;
+    t->object.refcount = 1;
+    t->object.iids = iids;
+    t->object.destroy = transform_destroy;
+    t->kind = kind;
+    switch (kind)
+    {
+        case TRANSFORM_SCALE:
+            t->v[0].value = t->v[1].value = 1.0f;
+            break;
+        case TRANSFORM_MATRIX:
+            t->v[0].value = t->v[3].value = 1.0f;
+            break;
+        default:
+            break;
+    }
+    return t;
+}
+
+HRESULT dc_create_transform(enum dc_transform_kind kind, void **out)
+{
+    struct dc_transform *t;
+
+    if (!(t = transform_alloc((enum transform_kind)kind, transform_vtbls[kind], transform_iid_lists[kind])))
+        return E_OUTOFMEMORY;
+    *out = t;
+    return S_OK;
+}
