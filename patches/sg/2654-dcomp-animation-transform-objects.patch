+#define BASE_TRANSFORM_IIDS &IID_IDCompositionEffect, &IID_IDCompositionTransform3D, &IID_IDCompositionTransform
+static const GUID *const translate_iids[] = { BASE_TRANSFORM_IIDS, &IID_IDCompositionTranslateTransform, NULL };
+static const GUID *const scale_iids[] = { BASE_TRANSFORM_IIDS, &IID_IDCompositionScaleTransform, NULL };
+static const GUID *const rotate_iids[] = { BASE_TRANSFORM_IIDS, &IID_IDCompositionRotateTransform, NULL };
+static const GUID *const skew_iids[] = { BASE_TRANSFORM_IIDS, &IID_IDCompositionSkewTransform, NULL };
+static const GUID *const matrix_iids[] = { BASE_TRANSFORM_IIDS, &IID_IDCompositionMatrixTransform, NULL };
+static const GUID *const group_iids[] = { BASE_TRANSFORM_IIDS, NULL };
