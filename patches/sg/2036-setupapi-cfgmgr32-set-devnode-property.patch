From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: CM_Set_DevNode_Registry_Property (2036)

CM_Set_DevNode_Registry_Property (A, W and the Ex forms) writes a device
node's registry property (strings converted from ANSI, multi-strings,
numbers with their size checked), and deletes it when given no data; bad
flags, properties and device nodes get the matching CR_ errors. Exported
from setupapi and forwarded by cfgmgr32.
---
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -9137,6 +9137,75 @@
 #endif
 }
 
+/***********************************************************************
+ *      CM_Set_DevNode_Registry_Property_ExW (SETUPAPI.@)
+ *
+ * A NULL buffer (or no data) deletes the property.
+ */
+CONFIGRET WINAPI CM_Set_DevNode_Registry_Property_ExW(DEVINST devnode, ULONG prop, void *buffer, ULONG len,
+        ULONG flags, HMACHINE machine)
+{
+    struct device *device = get_devnode_device(devnode);
+    LONG l;
+
+    TRACE("%lu, %lu, %p, %lu, %#lx, %p\n", devnode, prop, buffer, len, flags, machine);
+
+    if (!device) return CR_NO_SUCH_DEVNODE;
+    if (flags) return CR_INVALID_FLAG;
+    if (!prop || prop - 1 >= ARRAY_SIZE(PropertyMap) || !PropertyMap[prop - 1].nameW) return CR_INVALID_PROPERTY;
+
+    if (!buffer || !len)
+    {
+        l = RegDeleteValueW(device->key, PropertyMap[prop - 1].nameW);
+        if (l == ERROR_FILE_NOT_FOUND) l = ERROR_SUCCESS;
+    }
+    else
+    {
+        if (PropertyMap[prop - 1].regType == REG_DWORD && len != sizeof(DWORD)) return CR_INVALID_DATA;
+        l = RegSetValueExW(device->key, PropertyMap[prop - 1].nameW, 0, PropertyMap[prop - 1].regType, buffer, len);
+    }
+    if (l == ERROR_ACCESS_DENIED) return CR_ACCESS_DENIED;
+    return l ? CR_REGISTRY_ERROR : CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Set_DevNode_Registry_PropertyW(DEVINST devnode, ULONG prop, void *buffer, ULONG len, ULONG flags)
+{
+    return CM_Set_DevNode_Registry_Property_ExW(devnode, prop, buffer, len, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Set_DevNode_Registry_Property_ExA (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Set_DevNode_Registry_Property_ExA(DEVINST devnode, ULONG prop, void *buffer, ULONG len,
+        ULONG flags, HMACHINE machine)
+{
+    CONFIGRET cr;
+    WCHAR *data;
+    int count;
+
+    TRACE("%lu, %lu, %p, %lu, %#lx, %p\n", devnode, prop, buffer, len, flags, machine);
+
+    /* strings are converted, numbers and bytes go as they are */
+    if (!buffer || !len || !prop || prop - 1 >= ARRAY_SIZE(PropertyMap) ||
+            (PropertyMap[prop - 1].regType != REG_SZ && PropertyMap[prop - 1].regType != REG_MULTI_SZ))
+        return CM_Set_DevNode_Registry_Property_ExW(devnode, prop, buffer, len, flags, machine);
+
+#ifdef SG_MUTANT_NODEPROP_ANSI
+    return CM_Set_DevNode_Registry_Property_ExW(devnode, prop, buffer, len, flags, machine);
+#endif
+    count = MultiByteToWideChar(CP_ACP, 0, buffer, len, NULL, 0);
+    if (!(data = malloc(count * sizeof(WCHAR)))) return CR_OUT_OF_MEMORY;
+    MultiByteToWideChar(CP_ACP, 0, buffer, len, data, count);
+    cr = CM_Set_DevNode_Registry_Property_ExW(devnode, prop, data, count * sizeof(WCHAR), flags, machine);
+    free(data);
+    return cr;
+}
+
+CONFIGRET WINAPI CM_Set_DevNode_Registry_PropertyA(DEVINST devnode, ULONG prop, void *buffer, ULONG len, ULONG flags)
+{
+    return CM_Set_DevNode_Registry_Property_ExA(devnode, prop, buffer, len, flags, NULL);
+}
+
 static const struct class_property
 {
     DWORD prop;  /* SPCRP_*, which share the SPDRP_* numbers */
