From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a ptrace attach whose stop does not come in time is let go when it comes

To read a process's memory the server attaches to its first thread and waits up to three seconds for it to stop. A thread that cannot stop that soon (in a vfork, or an uninterruptible wait) kept the attach's SIGSTOP pending; detaching from a running thread fails, which the server took for the thread having died, and the late stop then left the process stopped for good (state T, SYSTEM's processes on qa5). Now the server stays attached and, when the stop comes, lets the thread go without it; an attach meanwhile waits for that same stop. The thread is never marked dead and the process is never left stopped.
---
diff --git a/server/ptrace.c b/server/ptrace.c
index f72b549..db02a91 100644
--- a/server/ptrace.c
+++ b/server/ptrace.c
@@ -142,6 +142,14 @@ static int handle_child_status( struct thread *thread, int pid, int status, int
         int sig = WSTOPSIG(status);
         if (debug_level && thread)
             fprintf( stderr, "%04x: *signal* %s\n", thread->id, get_signal_name( sig ));
+        /* 6259: the stop of an attach that was given up on: let the thread go, without the stop */
+        if (thread && thread->sg_ptrace_pending && want_sig != SIGSTOP)
+        {
+            thread->sg_ptrace_pending = 0;
+            if (debug_level) fprintf( stderr, "%04x: *ptrace* late stop, detached\n", thread->id );
+            ptrace( PTRACE_DETACH, pid, (caddr_t)1, sig == SIGSTOP ? 0 : sig );
+            return sig;
+        }
         if (sig != want_sig)
         {
             /* ignore other signals for now */
@@ -493,6 +501,18 @@ static int suspend_for_ptrace( struct thread *thread )
     if (thread->unix_pid == -1 || !is_process_init_done(thread->process)) goto error;
 
     /* this may fail if the client is already being debugged */
+    if (thread->sg_ptrace_pending)
+    {
+        /* 6259: still attached from before, its SIGSTOP on the way */
+        if (waitpid_thread( thread, SIGSTOP ))
+        {
+            thread->sg_ptrace_pending = 0;
+            return 1;
+        }
+        if (thread->unix_pid != -1) goto error;   /* still pending */
+        thread->sg_ptrace_pending = 0;
+        goto error;
+    }
     ret = ptrace( PTRACE_ATTACH, get_ptrace_pid(thread), 0, 0 );
     if (ret == -1 && errno == EPERM && !sg_ptrace_own( thread->process, 1 ))
     {
@@ -507,7 +527,25 @@ static int suspend_for_ptrace( struct thread *thread )
         if (errno == ESRCH) thread->unix_pid = thread->unix_tid = -1;  /* thread got killed */
         goto error;
     }
-    if (waitpid_thread( thread, SIGSTOP )) return 1;
+    if (waitpid_thread( thread, SIGSTOP ))
+    {
+        thread->sg_ptrace_pending = 0;
+        return 1;
+    }
+    /* Stained Glass OS 6259: the thread did not stop in time (the watchdog ended the wait: it is
+     * in a vfork, an uninterruptible wait, ...). It is still attached and its SIGSTOP still
+     * pending; PTRACE_DETACH fails on a running tracee (ESRCH), which marked a live thread dead,
+     * and the late stop then stopped the process for good (state T on qa5). Keep it attached
+     * and let it go when the stop comes (handle_child_status), with the stop suppressed: a
+     * process is never left stopped by being looked at, as on Windows. */
+#ifndef SG_MUTANT_PTRACE_STOP_PENDING
+    if (thread->unix_pid != -1)
+    {
+        if (debug_level) fprintf( stderr, "%04x: *ptrace* stop did not come, detach when it does\n", thread->id );
+        thread->sg_ptrace_pending = 1;
+        goto error;
+    }
+#endif
     resume_after_ptrace( thread );
  error:
     set_error( STATUS_ACCESS_DENIED );
diff --git a/server/thread.c b/server/thread.c
index 7fc0eb0..c39b72f 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -223,6 +223,7 @@ static inline void init_thread_structure( struct thread *thread )
 
     thread->unix_pid        = -1;  /* not known yet */
     thread->unix_tid        = -1;  /* not known yet */
+    thread->sg_ptrace_pending = 0;
     thread->context         = NULL;
     thread->teb             = 0;
     thread->entry_point     = 0;
diff --git a/server/thread.h b/server/thread.h
index aebf026..c6f3af9 100644
--- a/server/thread.h
+++ b/server/thread.h
@@ -76,6 +76,7 @@ struct thread
     int                    exit_code;     /* thread exit code */
     int                    unix_pid;      /* Unix pid of client */
     int                    unix_tid;      /* Unix tid of client */
+    int                    sg_ptrace_pending; /* Stained Glass OS 6259: attached, its stop not come yet: detach when it does */
     struct context        *context;       /* current context */
     client_ptr_t           suspend_cookie;/* wait cookie of suspending select */
     client_ptr_t           teb;           /* TEB address (in client address space) */
