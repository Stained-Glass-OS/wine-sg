+static WCHAR *wdup_n( const WCHAR *s, size_t n )
+{
+    WCHAR *r = malloc( (n + 1) * sizeof(WCHAR) );
+    if (!r) exit( 1 );
+    memcpy( r, s, n * sizeof(WCHAR) );
+    r[n] = 0;
+    return r;
+}
+
+/* ---- reading a script ---- */
+
+static WCHAR *read_script( const WCHAR *name )
+{
+    HANDLE file = CreateFileW( name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0 );
+    DWORD size, got, i;
+    BYTE *data;
+    WCHAR *text;
+    int len;
+
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        error( L"regini: cannot open %ls (error %lu)\n", name, GetLastError() );
+        return NULL;
+    }
+    size = GetFileSize( file, NULL );
+    if (!(data = malloc( size + 4 ))) exit( 1 );
+    if (!ReadFile( file, data, size, &got, NULL )) got = 0;
+    CloseHandle( file );
+    memset( data + got, 0, 4 );
+
+#ifdef SG_MUTANT_REGINI_BOM
+    if (0)
+#else
+    if (got >= 2 && data[0] == 0xff && data[1] == 0xfe)
+#endif
+    {
+        text = wdup_n( (WCHAR *)(data + 2), (got - 2) / 2 );
+    }
+    else if (got >= 2 && data[0] == 0xfe && data[1] == 0xff)
+    {
+        text = wdup_n( (WCHAR *)(data + 2), (got - 2) / 2 );
+        for (i = 0; text[i]; i++) text[i] = (text[i] >> 8) | (text[i] << 8);
+    }
+    else
+    {
+        UINT cp = CP_ACP;
+        const BYTE *p = data;
+        BOOL has_nul = FALSE;
+
+        if (got >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) { cp = CP_UTF8; p += 3; got -= 3; }
+        for (i = 0; i < got; i++) if (!p[i]) has_nul = TRUE;
+        if (has_nul) text = wdup_n( (const WCHAR *)p, got / 2 );        /* UTF-16 without a mark */
+        else
+        {
+            len = MultiByteToWideChar( cp, 0, (const char *)p, got, NULL, 0 );
+            text = malloc( (len + 1) * sizeof(WCHAR) );
+            if (!text) exit( 1 );
+            MultiByteToWideChar( cp, 0, (const char *)p, got, text, len );
+            text[len] = 0;
+        }
+    }
+    free( data );
+    return text;
+}
+
+/* ---- the registry ---- */
+
+static WCHAR *current_user_path(void)
+{
+    HANDLE token;
+    TOKEN_USER *user;
+    DWORD size = 0;
+    WCHAR *sid = NULL, *path = NULL;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return NULL;
+    GetTokenInformation( token, TokenUser, NULL, 0, &size );
+    if ((user = malloc( size )) && GetTokenInformation( token, TokenUser, user, size, &size ) &&
+        ConvertSidToStringSidW( user->User.Sid, &sid ))
+    {
+        path = malloc( (lstrlenW( sid ) + 32) * sizeof(WCHAR) );
+        if (path) swprintf( path, lstrlenW( sid ) + 32, L"\\Registry\\User\\%ls", sid );
+        LocalFree( sid );
+    }
+    free( user );
+    CloseHandle( token );
+    return path;
+}
+
+/* An absolute registry name as a kernel path (malloc'd), NULL when the name is relative. */
+static WCHAR *absolute_path( const WCHAR *name )
+{
+    static const struct { const WCHAR *prefix; const WCHAR *nt; } roots[] =
+    {
+#ifndef SG_MUTANT_REGINI_HKEY
+        { L"HKEY_LOCAL_MACHINE", L"\\Registry\\Machine" },
+#endif
+        { L"HKEY_USERS", L"\\Registry\\User" },
+        { L"HKEY_CLASSES_ROOT", L"\\Registry\\Machine\\Software\\Classes" },
+        { L"HKLM", L"\\Registry\\Machine" },
+        { L"HKU", L"\\Registry\\User" },
+        { L"HKCR", L"\\Registry\\Machine\\Software\\Classes" },
+    };
+    unsigned int i;
+
+    if (name[0] == '\\') return wdup_n( name, lstrlenW( name ) );
+    for (i = 0; i < ARRAY_SIZE(roots); i++)
+    {
+        size_t len = lstrlenW( roots[i].prefix );
+        if (!wcsnicmp( name, roots[i].prefix, len ) && (!name[len] || name[len] == '\\'))
+        {
+            WCHAR *p = malloc( (lstrlenW( roots[i].nt ) + lstrlenW( name + len ) + 1) * sizeof(WCHAR) );
+            if (p) { lstrcpyW( p, roots[i].nt ); lstrcatW( p, name + len ); }
+            return p;
+        }
+    }
+    if (!wcsnicmp( name, L"HKEY_CURRENT_USER", 17 ) || !wcsnicmp( name, L"HKCU", 4 ))
+    {
+        size_t len = name[1] == 'K' && name[2] == 'C' ? 4 : 17;
+        WCHAR *user = current_user_path(), *p;
+        if (!user || (name[len] && name[len] != '\\')) { free( user ); return NULL; }
+        p = malloc( (lstrlenW( user ) + lstrlenW( name + len ) + 1) * sizeof(WCHAR) );
+        if (p) { lstrcpyW( p, user ); lstrcatW( p, name + len ); }
+        free( user );
+        return p;
+    }
+    return NULL;
+}
+
+static NTSTATUS open_key( const WCHAR *path, BOOL create, HANDLE *key )
+{
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    ULONG disp;
+
+    RtlInitUnicodeString( &name, path );
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (create) return NtCreateKey( key, KEY_ALL_ACCESS, &attr, 0, NULL, REG_OPTION_NON_VOLATILE, &disp );
+    return NtOpenKey( key, KEY_ALL_ACCESS, &attr );
+}
+
+/* ---- parsing ---- */
+
+static BOOL is_space( WCHAR c ) { return c == ' ' || c == '\t'; }
+
+static WCHAR *trim_dup( const WCHAR *s, size_t len )
+{
+    while (len && is_space( *s )) { s++; len--; }
+    while (len && is_space( s[len - 1] )) len--;
+    return wdup_n( s, len );
+}
+
+/* position of the first '=' outside double quotes, or NULL */
+static const WCHAR *find_equals( const WCHAR *s )
+{
+    BOOL quoted = FALSE;
+    for (; *s; s++)
+    {
+        if (*s == '"') quoted = !quoted;
+        else if (*s == '=' && !quoted) return s;
+    }
+    return NULL;
+}
+
+static WCHAR *unquote_dup( const WCHAR *s )
+{
+    size_t len = lstrlenW( s );
+#ifndef SG_MUTANT_REGINI_QUOTE
+    if (len >= 2 && s[0] == '"' && s[len - 1] == '"') return wdup_n( s + 1, len - 2 );
+#endif
+    return wdup_n( s, len );
+}
+
+/* next whitespace separated token (quoted strings are one token, without quotes); returns the rest */
+static const WCHAR *next_token( const WCHAR *s, WCHAR **token )
+{
+    const WCHAR *start;
+
+    while (is_space( *s )) s++;
+    if (!*s) { *token = NULL; return s; }
+    if (*s == '"')
+    {
+        start = ++s;
+        while (*s && *s != '"') s++;
+        *token = wdup_n( start, s - start );
+        if (*s == '"') s++;
+        return s;
+    }
+    start = s;
+    while (*s && !is_space( *s )) s++;
+    *token = wdup_n( start, s - start );
+    return s;
+}
+
+static BOOL parse_number( const WCHAR *s, ULONGLONG *value )
+{
+    WCHAR *end;
+    if (!*s) return FALSE;
+#ifdef SG_MUTANT_REGINI_RADIX
+    *value = _wcstoui64( s, &end, 10 );
+#else
+    *value = _wcstoui64( s, &end, (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) ? 16 : 10 );
+#endif
+    return !*end;
+}
+
+static const struct { const WCHAR *name; DWORD type; } type_names[] =
+{
+    { L"REG_NONE", REG_NONE }, { L"REG_SZ", REG_SZ }, { L"REG_EXPAND_SZ", REG_EXPAND_SZ },
+    { L"REG_BINARY", REG_BINARY }, { L"REG_DWORD", REG_DWORD }, { L"REG_DWORD_BIG_ENDIAN", REG_DWORD_BIG_ENDIAN },
+    { L"REG_LINK", REG_LINK }, { L"REG_MULTI_SZ", REG_MULTI_SZ }, { L"REG_RESOURCE_LIST", REG_RESOURCE_LIST },
+    { L"REG_FULL_RESOURCE_DESCRIPTOR", REG_FULL_RESOURCE_DESCRIPTOR },
+    { L"REG_RESOURCE_REQUIREMENTS_LIST", REG_RESOURCE_REQUIREMENTS_LIST }, { L"REG_QWORD", REG_QWORD },
+};
+
+static BOOL type_by_name( const WCHAR *name, DWORD *type )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(type_names); i++)
+        if (!wcsicmp( name, type_names[i].name )) { *type = type_names[i].type; return TRUE; }
+    return FALSE;
+}
+
+/* The data of a value line (the text after '='). On success data is malloc'd (may be NULL for size 0). */
+static BOOL parse_data( const WCHAR *text, DWORD *type, BYTE **data, DWORD *size, BOOL *is_delete )
+{
+    WCHAR *tok;
+    const WCHAR *rest;
+
+    *data = NULL; *size = 0; *is_delete = FALSE; *type = REG_SZ;
+    rest = next_token( text, &tok );
+    if (!tok) { *data = (BYTE *)wdup_n( L"", 0 ); *size = sizeof(WCHAR); return TRUE; }
+
+    if (!wcsicmp( tok, L"DELETE" )) { free( tok ); *is_delete = TRUE; return TRUE; }
+    if (!type_by_name( tok, type ))
+    {
+        /* no type keyword: the whole text is a string */
+        WCHAR *s = trim_dup( text, lstrlenW( text ) ), *u;
+        free( tok );
+        u = unquote_dup( s );
+        free( s );
+        *type = REG_SZ;
+        *data = (BYTE *)u;
+        *size = (lstrlenW( u ) + 1) * sizeof(WCHAR);
+        return TRUE;
+    }
+    free( tok );
+
+    switch (*type)
+    {
+    case REG_SZ:
+    case REG_EXPAND_SZ:
+    case REG_LINK:
+    {
+        WCHAR *s = trim_dup( rest, lstrlenW( rest ) ), *u = unquote_dup( s );
+        free( s );
+        *data = (BYTE *)u;
+        *size = (lstrlenW( u ) + 1) * sizeof(WCHAR);
+        return TRUE;
+    }
+    case REG_MULTI_SZ:
+    {
+        WCHAR *buf = calloc( lstrlenW( rest ) + 3, sizeof(WCHAR) ), *item, *dst = buf;
+        if (!buf) exit( 1 );
+        while ((rest = next_token( rest, &item )), item)
+        {
+            lstrcpyW( dst, item );
+            dst += lstrlenW( item ) + 1;
+            free( item );
+        }
+        *dst++ = 0;
+        *data = (BYTE *)buf;
+        *size = (dst - buf) * sizeof(WCHAR);
+        if (dst - buf == 1) *size = 2 * sizeof(WCHAR);          /* an empty list is two terminators */
+        return TRUE;
+    }
+    case REG_DWORD:
+    case REG_DWORD_BIG_ENDIAN:
+    {
+        ULONGLONG v;
+        DWORD d;
+        WCHAR *s;
+        rest = next_token( rest, &s );
+        if (!s || !parse_number( s, &v ) || v > 0xffffffff) { free( s ); return FALSE; }
+        free( s );
+        d = (DWORD)v;
+        if (*type == REG_DWORD_BIG_ENDIAN) d = RtlUlongByteSwap( d );
+        *data = malloc( sizeof(d) );
+        memcpy( *data, &d, sizeof(d) );
+        *size = sizeof(d);
+        return TRUE;
+    }
+    case REG_QWORD:
+    {
+        ULONGLONG v;
+        WCHAR *s;
+        rest = next_token( rest, &s );
+        if (!s || !parse_number( s, &v )) { free( s ); return FALSE; }
+        free( s );
+        *data = malloc( sizeof(v) );
+        memcpy( *data, &v, sizeof(v) );
+        *size = sizeof(v);
+        return TRUE;
+    }
+    default:
+    {
+        /* binary data: a byte count, then the bytes as 32-bit words (as regdmp writes them) */
+        ULONGLONG count, v;
+        WCHAR *s;
+        DWORD pos = 0;
+        BYTE *buf;
+
+        rest = next_token( rest, &s );
+        if (!s) return TRUE;                                      /* no data */
+        if (!parse_number( s, &count ) || count > 0x1000000) { free( s ); return FALSE; }
+        free( s );
+        if (!(buf = calloc( 1, count + 4 ))) exit( 1 );
+        while ((rest = next_token( rest, &s )), s)
+        {
+            if (!parse_number( s, &v ) || v > 0xffffffff) { free( s ); free( buf ); return FALSE; }
+            free( s );
+#ifdef SG_MUTANT_REGINI_BINWORDS
+            if (pos < count) { DWORD d = (DWORD)v; memcpy( buf + pos, &d, 1 ); }
+#else
+            if (pos < count) { DWORD d = (DWORD)v; memcpy( buf + pos, &d, min( 4, count - pos ) ); }
+#endif
+            pos += 4;
+        }
+        *data = buf;
+        *size = count;
+        return TRUE;
+    }
+    }
+}
+
+static void print_value( int depth, const WCHAR *name, DWORD type, const BYTE *data, DWORD size )
+{
+    const WCHAR *tname = L"REG_BINARY";
+    unsigned int i;
+    DWORD j;
+
+    for (i = 0; i < ARRAY_SIZE(type_names); i++) if (type_names[i].type == type) tname = type_names[i].name;
+    outputf( L"%*ls%ls = %ls", depth * indent_step, L"", name[0] ? name : L"@", tname );
+    switch (type)
+    {
+    case REG_SZ: case REG_EXPAND_SZ: case REG_LINK:
+        outputf( L" %ls", (const WCHAR *)data );
+        break;
+    case REG_DWORD: case REG_DWORD_BIG_ENDIAN:
+        outputf( L" 0x%08lx", *(const DWORD *)data );
+        break;
+    case REG_QWORD:
+        outputf( L" 0x%I64x", *(const ULONGLONG *)data );
+        break;
+    case REG_MULTI_SZ:
+    {
+        const WCHAR *p = (const WCHAR *)data;
+        while (*p) { outputf( L" \"%ls\"", p ); p += lstrlenW( p ) + 1; }
+        break;
+    }
+    default:
+        outputf( L" 0x%08lx", size );
+        for (j = 0; j < size; j += 4)
+        {
+            DWORD d = 0;
+            memcpy( &d, data + j, min( 4, size - j ) );
+            outputf( L" 0x%08lx", d );
+        }
+    }
+    output( L"\n" );
+}
+
+/* ---- running a script ---- */
+
+#define MAX_DEPTH 64
+struct keystate
+{
+    int indent[MAX_DEPTH];
+    WCHAR *path[MAX_DEPTH];
+    int depth;                 /* number of keys on the stack */
+    HANDLE key;                /* the open handle of the innermost key */
+    BOOL echoed;
+};
+
+static void close_current( struct keystate *ks )
+{
+    if (ks->key) { NtClose( ks->key ); ks->key = NULL; }
+}
+
+static void pop_to( struct keystate *ks, int depth )
+{
+    while (ks->depth > depth) free( ks->path[--ks->depth] );
+}
+
+/* make the key named by a key line current (creating it); delete it when requested */
+static void do_key( struct keystate *ks, int indent, const WCHAR *name, BOOL remove_key, const WCHAR *file, int lineno )
+{
+    WCHAR *abs = absolute_path( name ), *path;
+    NTSTATUS status;
+    HANDLE key;
+
+    close_current( ks );
+    if (abs)
+    {
+        pop_to( ks, 0 );
+        path = abs;
+    }
+    else
+    {
+#ifndef SG_MUTANT_REGINI_INDENT
+        while (ks->depth && ks->indent[ks->depth - 1] >= indent) free( ks->path[--ks->depth] );
+#endif
+        if (!ks->depth)
+        {
+            error( L"regini: %ls(%d): the key '%ls' has no parent key\n", file, lineno, name );
+            return;
+        }
+        path = malloc( (lstrlenW( ks->path[ks->depth - 1] ) + lstrlenW( name ) + 2) * sizeof(WCHAR) );
+        swprintf( path, lstrlenW( ks->path[ks->depth - 1] ) + lstrlenW( name ) + 2, L"%ls\\%ls", ks->path[ks->depth - 1], name );
+    }
+    if (ks->depth == MAX_DEPTH) { free( path ); error( L"regini: %ls(%d): keys nested too deeply\n", file, lineno ); return; }
+
+    outputf( L"%*ls%ls%ls\n", ks->depth * indent_step, L"", path, remove_key ? L" DELETE" : L"" );
+    if (remove_key)
+    {
+#ifdef SG_MUTANT_REGINI_DELKEY
+        status = 0;
+#else
+        if (!(status = open_key( path, FALSE, &key ))) { status = NtDeleteKey( key ); NtClose( key ); }
+#endif
+        if (status && status != STATUS_OBJECT_NAME_NOT_FOUND)
+            error( L"regini: %ls(%d): cannot delete %ls (status %08lx)\n", file, lineno, path, status );
+        free( path );
+        return;
+    }
+    if ((status = open_key( path, TRUE, &key )))
+    {
+        error( L"regini: %ls(%d): cannot create %ls (status %08lx)\n", file, lineno, path, status );
+        free( path );
+        return;
+    }
+    ks->indent[ks->depth] = indent;
+    ks->path[ks->depth++] = path;
+    ks->key = key;
+}
+
+static void do_value( struct keystate *ks, const WCHAR *name, const WCHAR *text, const WCHAR *file, int lineno )
+{
+    DWORD type, size;
+    BYTE *data;
+    BOOL del;
+    UNICODE_STRING uname;
+    NTSTATUS status;
+
+    if (!ks->key)
+    {
+        if (!ks->depth) error( L"regini: %ls(%d): a value outside of any key\n", file, lineno );
+        return;           /* the key could not be created; already reported */
+    }
+    if (!parse_data( text, &type, &data, &size, &del ))
+    {
+        error( L"regini: %ls(%d): invalid data for '%ls'\n", file, lineno, name );
+        return;
+    }
+    RtlInitUnicodeString( &uname, name );
+    if (del)
+    {
+        outputf( L"%*ls%ls = DELETE\n", ks->depth * indent_step, L"", name[0] ? name : L"@" );
+#ifdef SG_MUTANT_REGINI_DELVAL
+        status = 0;
+#else
+        status = NtDeleteValueKey( ks->key, &uname );
+#endif
+        if (status && status != STATUS_OBJECT_NAME_NOT_FOUND)
+            error( L"regini: %ls(%d): cannot delete '%ls' (status %08lx)\n", file, lineno, name, status );
+        return;
+    }
+    print_value( ks->depth, name, type, data, size );
+    status = NtSetValueKey( ks->key, &uname, 0, type, data, size );
+    if (status) error( L"regini: %ls(%d): cannot set '%ls' (status %08lx)\n", file, lineno, name, status );
+    free( data );
+}
+
+/* "key" or "key [permissions]" or "key DELETE" */
+static void key_line( struct keystate *ks, int indent, const WCHAR *content, const WCHAR *file, int lineno )
+{
+    WCHAR *name = trim_dup( content, lstrlenW( content ) );
+    size_t len = lstrlenW( name );
+    BOOL remove_key = FALSE;
+
+    if (len > 1 && name[len - 1] == ']')
+    {
+        WCHAR *open = wcsrchr( name, '[' );
+        if (open)
+        {
+            /* permissions are not applied (the codes are defined by the Resource Kit documentation only) */
+            outputf( L"regini: %ls(%d): ignoring the permissions %ls\n", file, lineno, open );
+            *open = 0;
+            while (open > name && is_space( open[-1] )) *--open = 0;
+        }
+    }
+    len = lstrlenW( name );
+    if (len > 7 && is_space( name[len - 7] ) && !wcsicmp( name + len - 6, L"DELETE" ))
+    {
+        remove_key = TRUE;
+        name[len - 7] = 0;
+    }
+    do_key( ks, indent, name, remove_key, file, lineno );
+    free( name );
+}
+
+static void run_line( struct keystate *ks, int indent, const WCHAR *content, const WCHAR *file, int lineno )
+{
+    const WCHAR *eq = find_equals( content );
+
+    if (!eq)
+    {
+        key_line( ks, indent, content, file, lineno );
+        return;
+    }
+#ifdef SG_MUTANT_REGINI_ONELINE
+    if (0)
+#else
+    if (content[0] == '\\' || !wcsnicmp( content, L"HKEY_", 5 ) || !wcsnicmp( content, L"HK", 2 ))
+#endif
+    {
+        /* "key valuename = data" on one line */
+        WCHAR *left = trim_dup( content, eq - content ), *key, *name;
+        size_t len = lstrlenW( left ), split;
+
+        if (len && left[len - 1] == '"')
+        {
+            size_t start = len - 1;
+            while (start && left[start - 1] != '"') start--;
+            split = start ? start - 1 : 0;
+            name = wdup_n( left + start, len - 1 - start );
+        }
+        else
+        {
+            split = len;
+            while (split && !is_space( left[split - 1] )) split--;
+            name = wdup_n( left + split, len - split );
+        }
+        if (split && absolute_path( left ))
+        {
+            key = trim_dup( left, split );
+            key_line( ks, indent, key, file, lineno );
+            free( key );
+        }
+        else
+        {
+            free( name );
+            name = wdup_n( L"", 0 );
+            key_line( ks, indent, left, file, lineno );
+        }
+        do_value( ks, name, eq + 1, file, lineno );
+        free( name );
+        free( left );
+        return;
+    }
+    {
+        WCHAR *left = trim_dup( content, eq - content ), *name = unquote_dup( left );
+        if (!lstrcmpW( name, L"@" )) { name[0] = 0; }
+        do_value( ks, name, eq + 1, file, lineno );
+        free( name );
+        free( left );
+    }
+}
+
+static void run_script( const WCHAR *file )
+{
+    WCHAR *text = read_script( file ), *line, *p, *next;
+    struct keystate ks = {0};
+    int lineno = 0;
+    WCHAR *joined = NULL;
+    int joined_indent = 0;
+
+    if (!text) return;
+    for (p = text; *p; p = next)
+    {
+        size_t len;
+        const WCHAR *s;
+        int indent = 0;
+        BOOL cont = FALSE;
+
+        line = p;
+        next = wcschr( p, '\n' );
+        len = next ? (size_t)(next - p) : lstrlenW( p );
+        next = next ? next + 1 : p + len;
+        lineno++;
+        while (len && (line[len - 1] == '\r')) len--;
+
+        s = line;
+        if (!joined)
+        {
+            /* indentation: every blank counts as one column */
+            while (len && is_space( *s )) { indent++; s++; len--; }
+            if (!len || *s == ';') continue;
+            joined_indent = indent;
+        }
+        else
+        {
+            /* after a continuation, leading blanks of the next line are dropped */
+            while (len && is_space( *s )) { s++; len--; }
+        }
+
+        /* a backslash that ends the line (blanks may follow) continues it; a key path that
+         * happens to end in a backslash is not a continuation */
+        {
+            size_t end = len;
+            while (end && is_space( s[end - 1] )) end--;
+#ifdef SG_MUTANT_REGINI_CONT
+            if (0)
+#else
+            if (end && s[end - 1] == '\\' && (end == 1 || is_space( s[end - 2] ) || find_equals( s )))
+#endif
+            {
+                cont = TRUE;
+                len = end - 1;
+                while (len && is_space( s[len - 1] )) len--;
+            }
+        }
+        {
+            size_t old = joined ? lstrlenW( joined ) : 0;
+            WCHAR *grown = realloc( joined, (old + len + 2) * sizeof(WCHAR) );
+            if (!grown) exit( 1 );
+            joined = grown;
+            if (old && len) joined[old++] = ' ';
+            memcpy( joined + old, s, len * sizeof(WCHAR) );
+            joined[old + len] = 0;
+        }
+        if (cont) continue;
+        run_line( &ks, joined_indent, joined, file, lineno );
+        free( joined );
+        joined = NULL;
+    }
+    if (joined) { run_line( &ks, joined_indent, joined, file, lineno ); free( joined ); }
+    close_current( &ks );
+    pop_to( &ks, 0 );
+    free( text );
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    int i = 1, files = 0;
 
+    for (; i < argc; i++)
+    {
+        if (argv[i][0] == '-' || argv[i][0] == '/')
+        {
+            switch (towlower( argv[i][1] ))
+            {
+            case 'i':
+                if (i + 1 < argc) indent_step = max( 0, _wtoi( argv[++i] ) );
+                continue;
+            case 'o':
+                if (i + 1 < argc) i++;            /* output width: nothing wraps */
+                continue;
+            case 'b':
+                continue;
+            case 'm':
+                error( L"regini: changing the registry of another computer is not supported\n" );
+                return 1;
+            case 'h':
+                error( L"regini: loading a hive file is not supported\n" );
+                return 1;
+            case '?':
+                output( L"REGINI [-m \\\\machinename | -h hivefile hiveroot] [-i n] [-o outputwidth] [-b] textfiles...\n" );
+                return 0;
+            default:
+                error( L"regini: unknown option %ls\n", argv[i] );
+                return 1;
+            }
+        }
+        run_script( argv[i] );
+        files++;
+    }
+    if (!files)
+    {
+        output( L"REGINI [-m \\\\machinename | -h hivefile hiveroot] [-i n] [-o outputwidth] [-b] textfiles...\n" );
+        return 1;
+    }
+#ifdef SG_MUTANT_REGINI_EXIT
     return 0;
+#endif
+    return errors ? 1 : 0;
 }
