+/* The other domains the workstation browses: the value OtherDomains of the workstation service,
+ * the names separated by blanks (or a list of strings, then the blanks are put in).  Allocated. */
+static WCHAR *get_other_domains(void)
+{
+    DWORD type, size = 0, i;
+    WCHAR *data;
+    HKEY key;
+
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
+                        0, KEY_READ, &key ))
+    {
+        if (!RegQueryValueExW( key, L"OtherDomains", NULL, &type, NULL, &size ) && (type == REG_SZ || type == REG_MULTI_SZ) &&
+            (data = malloc( size + 2 * sizeof(WCHAR) )))
+        {
+            if (!RegQueryValueExW( key, L"OtherDomains", NULL, &type, (BYTE *)data, &size ))
+            {
+                data[size / sizeof(WCHAR)] = 0;
+                data[size / sizeof(WCHAR) + 1] = 0;
+                if (type == REG_MULTI_SZ)
+                {
+                    for (i = 0; data[i] || data[i + 1]; i++) if (!data[i]) data[i] = ' ';
+                    data[i] = 0;
+                }
+                RegCloseKey( key );
+                return data;
+            }
+            free( data );
+        }
+        RegCloseKey( key );
+    }
+    return wcsdup( L"" );
+}
