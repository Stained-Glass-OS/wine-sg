+#ifdef SG_MUTANT_NA_SRV102
+            info->sv102_disc = 0;
+#else
+            info->sv102_disc = 15;             /* minutes before an idle session is disconnected */
+#endif
+            info->sv102_hidden = FALSE;
+            info->sv102_announce = 240;        /* seconds between announcements */
+            info->sv102_anndelta = 3000;       /* milliseconds of announcement variation */
+            info->sv102_licenses = 0;
