From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 09:03:35 -0700
Subject: [PATCH] 3225 netapi32: server and workstation information, display
 information, domain controller queries, global groups, NetBIOS name table

 - NetServerEnum lists the servers of the domain this computer is in (itself,
   as there is no browser service), filtered by type and domain, levels 100
   and 101, ERROR_MORE_DATA for a short buffer, ERROR_NO_BROWSER_SERVERS_FOUND
   for another domain.  NetServerGetInfo gets the levels 102, 1005, 1010,
   1016, 1017, 1018 and 1107, and the type now says workstation and server.
 - NetWkstaGetInfo reports the workgroup as langroup (it reported the
   computer name); NetWkstaUserGetInfo fills the other domains (the
   OtherDomains value of the workstation service) and the logon server of
   level 1 and implements 1101; NetWkstaTransportEnum has a resume handle and
   gives ERROR_BAD_NETPATH for another computer.
 - NetQueryDisplayInformation honors Index, EntriesRequested and the preferred
   length (ERROR_MORE_DATA, next_index) and has levels 2 (no machine accounts)
   and 3 (the group None).
 - NetGetDCName / NetGetAnyDCName and NetGroupEnum / NetGroupGetInfo give the
   documented answers of a computer that is in no domain; NetGroupEnum and
   NetGroupGetInfo check their arguments.
 - DsRoleGetPrimaryDomainInformation reports the workgroup name and fails for
   another computer.
 - Netbios keeps a local name table per adapter: NCBADDNAME, NCBADDGRNAME
   (name numbers 0x02 to 0xfe, duplicates, a full table) and NCBDELNAME, and
   NCBASTAT lists the names (NCBADDNAME was a stub that answered success).

diff --git a/dlls/netapi32/netapi32.c b/dlls/netapi32/netapi32.c
index 2a0d5a0..7d040dc 100644
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -110,8 +110,18 @@ BOOL WINAPI DllMain (HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
     return TRUE;
 }
 
+extern BOOL sg_is_administrator(void);
+static void get_workgroup( WCHAR *name, DWORD size );
+static NET_API_STATUS NETAPI_ValidateServername(LPCWSTR ServerName);
+
+/* what this computer is: a workstation and a server (file and printer sharing) of the NT family */
+#define LOCAL_SERVER_TYPE (SV_TYPE_WORKSTATION | SV_TYPE_SERVER | SV_TYPE_NT)
+
 /************************************************************
  *                NetServerEnum (NETAPI32.@)
+ *
+ * The servers that are visible in a domain.  There is no browser service here: the visible
+ * servers of the domain this computer is in are the computer itself.
  */
 NET_API_STATUS  WINAPI NetServerEnum(
   LMCSTR servername,
@@ -125,11 +135,59 @@ NET_API_STATUS  WINAPI NetServerEnum(
   LPDWORD resume_handle
 )
 {
-    FIXME("Stub (%s %ld %p %ld %p %p %ld %s %p)\n", debugstr_w(servername),
-     level, bufptr, prefmaxlen, entriesread, totalentries, servertype,
-     debugstr_w(domain), resume_handle);
+    WCHAR workgroup[MAX_COMPUTERNAME_LENGTH * 2 + 1], computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD len = ARRAY_SIZE(computer), entry_size;
+    SERVER_INFO_101 *info;
+    NET_API_STATUS status;
+    OSVERSIONINFOW ver;
 
-    return ERROR_NO_BROWSER_SERVERS_FOUND;
+    TRACE("(%s %ld %p %ld %p %p %#lx %s %p)\n", debugstr_w(servername), level, bufptr, prefmaxlen,
+          entriesread, totalentries, servertype, debugstr_w(domain), resume_handle);
+
+    if (!bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    *bufptr = NULL;
+    *entriesread = *totalentries = 0;
+    /* reserved: the computer that runs the call */
+    if (servername && servername[0] && !NETAPI_IsLocalComputer( servername )) return ERROR_INVALID_PARAMETER;
+    if (level != 100 && level != 101) return ERROR_INVALID_LEVEL;
+    if (resume_handle) *resume_handle = 0;
+
+    get_workgroup( workgroup, ARRAY_SIZE(workgroup) );
+#ifndef SG_MUTANT_NA_ENUMDOM
+    if (domain && domain[0] && wcsicmp( domain, workgroup )) return ERROR_NO_BROWSER_SERVERS_FOUND;
+#endif
+
+    /* nothing of the types asked for is in the domain */
+#ifndef SG_MUTANT_NA_ENUMTYPE
+    if (!(servertype & LOCAL_SERVER_TYPE) && servertype != SV_TYPE_ALL) return NERR_Success;
+#endif
+
+    GetComputerNameW( computer, &len );
+    entry_size = (level == 100 ? sizeof(SERVER_INFO_100) : sizeof(SERVER_INFO_101)) + (len + 1) * sizeof(WCHAR) +
+                 (level == 101 ? sizeof(WCHAR) : 0);
+    *totalentries = 1;
+#ifndef SG_MUTANT_NA_ENUMMORE
+    if (prefmaxlen != MAX_PREFERRED_LENGTH && prefmaxlen < entry_size) return ERROR_MORE_DATA;
+#endif
+
+    if ((status = NetApiBufferAllocate( entry_size, (void **)&info ))) return status;
+    memset( &ver, 0, sizeof(ver) );
+    ver.dwOSVersionInfoSize = sizeof(ver);
+    GetVersionExW( &ver );
+    info->sv101_platform_id = PLATFORM_ID_NT;
+    info->sv101_name = (WCHAR *)((BYTE *)info + (level == 100 ? sizeof(SERVER_INFO_100) : sizeof(SERVER_INFO_101)));
+    wcscpy( info->sv101_name, computer );
+    if (level == 101)
+    {
+        info->sv101_version_major = ver.dwMajorVersion;
+        info->sv101_version_minor = ver.dwMinorVersion;
+        info->sv101_type = LOCAL_SERVER_TYPE;
+        info->sv101_comment = info->sv101_name + len + 1;
+        info->sv101_comment[0] = 0;
+    }
+    *bufptr = (BYTE *)info;
+    *entriesread = 1;
+    return NERR_Success;
 }
 
