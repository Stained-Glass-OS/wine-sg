From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mf: standard quality manager NotifyQualityEvent, NotifyProcessInput, NotifyProcessOutput

The three notifications were E_NOTIMPL (NotifyQualityEvent with a FIXME). The
standard quality manager does not adapt the pipeline to them: while running
they return S_OK (E_POINTER for a NULL event), after Shutdown MF_E_SHUTDOWN.

Gate: test/mf-sequencer-gate.sh.
---
diff --git a/dlls/mf/quality.c b/dlls/mf/quality.c
index a611d6f..a58b634 100644
--- a/dlls/mf/quality.c
+++ b/dlls/mf/quality.c
@@ -175,28 +175,48 @@ static HRESULT WINAPI standard_quality_manager_NotifyPresentationClock(IMFQualit
     return hr;
 }
 
+/* The standard quality manager does not adjust the pipeline in response to per-sample or quality
+ * notifications: it accepts them while running and reports the shut down state afterwards. */
+static HRESULT standard_quality_manager_notify(IMFQualityManager *iface, IMFTopologyNode *node)
+{
+    struct quality_manager *manager = impl_from_IMFQualityManager(iface);
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&manager->cs);
+#ifndef SG_MUTANT_QM_NOSHUTDOWN
+    if (manager->state == QUALITY_MANAGER_SHUT_DOWN)
+        hr = MF_E_SHUTDOWN;
+#endif
+    LeaveCriticalSection(&manager->cs);
+
+    return hr;
+}
+
 static HRESULT WINAPI standard_quality_manager_NotifyProcessInput(IMFQualityManager *iface, IMFTopologyNode *node,
         LONG input_index, IMFSample *sample)
 {
-    TRACE("%p, %p, %ld, %p stub.\n", iface, node, input_index, sample);
+    TRACE("%p, %p, %ld, %p.\n", iface, node, input_index, sample);
 
-    return E_NOTIMPL;
+    return standard_quality_manager_notify(iface, node);
 }
 
 static HRESULT WINAPI standard_quality_manager_NotifyProcessOutput(IMFQualityManager *iface, IMFTopologyNode *node,
         LONG output_index, IMFSample *sample)
 {
-    TRACE("%p, %p, %ld, %p stub.\n", iface, node, output_index, sample);
+    TRACE("%p, %p, %ld, %p.\n", iface, node, output_index, sample);
 
-    return E_NOTIMPL;
+    return standard_quality_manager_notify(iface, node);
 }
 
 static HRESULT WINAPI standard_quality_manager_NotifyQualityEvent(IMFQualityManager *iface, IUnknown *object,
         IMFMediaEvent *event)
 {
-    FIXME("%p, %p, %p stub.\n", iface, object, event);
+    TRACE("%p, %p, %p.\n", iface, object, event);
+
+    if (!event)
+        return E_POINTER;
 
-    return E_NOTIMPL;
+    return standard_quality_manager_notify(iface, NULL);
 }
 
 static HRESULT WINAPI standard_quality_manager_Shutdown(IMFQualityManager *iface)
