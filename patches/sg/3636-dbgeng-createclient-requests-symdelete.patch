+static void test_sg_delete_symbol(void)
+{
+    char buffer[sizeof(SYMBOL_INFO) + MAX_SYM_NAME];
+    SYMBOL_INFO *info = (SYMBOL_INFO *)buffer;
+    HANDLE dummy = (HANDLE)0xdeadbeef;
+    DWORD64 base, addr, disp;
+    BOOL ret;
+
+    ret = SymInitialize(dummy, NULL, FALSE);
+    ok(ret, "SymInitialize failed: %lu\n", GetLastError());
+    base = SymLoadModuleEx(dummy, NULL, "c:\\windows\\system32\\kernel32.dll", NULL, 0x10000000, 0, NULL, 0);
+    ok(base == 0x10000000, "SymLoadModuleEx failed: %lu\n", GetLastError());
+    addr = base + 0x100;
+
+    ret = SymAddSymbol(dummy, base, "winetest_delete_me", addr, 8, 0);
+    ok(ret, "SymAddSymbol failed: %lu\n", GetLastError());
+    memset(buffer, 0, sizeof(buffer));
+    info->SizeOfStruct = sizeof(*info);
+    info->MaxNameLen = MAX_SYM_NAME;
+    ret = SymFromAddr(dummy, addr, &disp, info);
+    ok(ret && !strcmp(info->Name, "winetest_delete_me"), "got %d %s\n", ret, info->Name);
+
+    SetLastError(0xdeadbeef);
+    ret = SymDeleteSymbol(dummy, base, "winetest_other", addr, 0);
+    ok(!ret, "SymDeleteSymbol with another name succeeded\n");
+    ret = SymDeleteSymbol(dummy, base, "winetest_delete_me", addr + 1, 0);
+    ok(!ret, "SymDeleteSymbol with another address succeeded\n");
+    ret = SymDeleteSymbol(dummy, base, "winetest_delete_me", addr, 0);
+    ok(ret, "SymDeleteSymbol failed: %lu\n", GetLastError());
+
+    info->SizeOfStruct = sizeof(*info);
+    info->MaxNameLen = MAX_SYM_NAME;
+    info->Name[0] = 0;
+    SymFromAddr(dummy, addr, &disp, info);
+    ok(strcmp(info->Name, "winetest_delete_me"), "the deleted symbol is still found\n");
+    ret = SymDeleteSymbol(dummy, base, "winetest_delete_me", addr, 0);
+    ok(!ret, "deleting twice succeeded\n");
+
+    /* without a name the address selects the symbol */
+    ret = SymAddSymbol(dummy, base, "winetest_delete_me2", addr, 8, 0);
+    ok(ret, "SymAddSymbol failed: %lu\n", GetLastError());
+    ret = SymDeleteSymbol(dummy, base, NULL, addr, 0);
+    ok(ret, "SymDeleteSymbol by address failed: %lu\n", GetLastError());
+
+    ret = SymCleanup(dummy);
+    ok(ret, "SymCleanup failed: %lu\n", GetLastError());
+}
