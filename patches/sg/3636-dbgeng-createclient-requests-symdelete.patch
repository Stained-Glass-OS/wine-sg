+/******************************************************************
+ *		SymDeleteSymbol (DBGHELP.@)
+ *
+ * Removes a symbol added with SymAddSymbol; the symbol is found by its name
+ * (when given) and address.
+ */
+BOOL WINAPI SymDeleteSymbol(HANDLE hProcess, ULONG64 BaseOfDll, PCSTR name,
+                            DWORD64 addr, DWORD flags)
+{
+    struct module_pair          pair;
+    struct hash_table_iter      hti;
+    void*                       ptr;
+
+    TRACE("(%p %s %s %I64x %lx)\n", hProcess, wine_dbgstr_longlong(BaseOfDll), debugstr_a(name), addr, flags);
+
+    if (!module_init_pair(&pair, hProcess, BaseOfDll)) return FALSE;
+
+    hash_table_iter_init(&pair.effective->ht_symbols, &hti, NULL);
+    while ((ptr = hash_table_iter_up(&hti)))
+    {
+        struct symt_ht* sym = CONTAINING_RECORD(ptr, struct symt_ht, hash_elt);
+        struct symt_custom* custom = (struct symt_custom*)sym;
+        unsigned int i;
+
+        if (sym->symt.tag != SymTagCustom) continue;
+        if (name && strcmp(custom->hash_elt.name, name)) continue;
+        if (custom->address != addr) continue;
+#ifndef SG_MUTANT_DELSYM
+        hash_table_remove(&pair.effective->ht_symbols, &custom->hash_elt);
+#endif
+        /* and from the address sorted list */
+        for (i = 0; i < pair.effective->num_symbols; i++)
+        {
+            if (pair.effective->addr_sorttab[i] != sym) continue;
+            memmove(&pair.effective->addr_sorttab[i], &pair.effective->addr_sorttab[i + 1],
+                    (pair.effective->num_symbols - i - 1) * sizeof(*pair.effective->addr_sorttab));
+            pair.effective->num_symbols--;
+            break;
+        }
+        pair.effective->sortlist_valid = FALSE;
+        return TRUE;
+    }
+    SetLastError(ERROR_NOT_FOUND);
+    return FALSE;
+}
+
+/******************************************************************
+ *		SymDeleteSymbolW (DBGHELP.@)
+ *
+ */
+BOOL WINAPI SymDeleteSymbolW(HANDLE hProcess, ULONG64 BaseOfDll, PCWSTR nameW,
+                             DWORD64 addr, DWORD flags)
+{
+    char       name[MAX_SYM_NAME];
+
+    TRACE("(%p %s %s %I64x %lx)\n", hProcess, wine_dbgstr_longlong(BaseOfDll), debugstr_w(nameW), addr, flags);
+
+    if (!nameW) return SymDeleteSymbol(hProcess, BaseOfDll, NULL, addr, flags);
+    WideCharToMultiByte(CP_ACP, 0, nameW, -1, name, ARRAY_SIZE(name), NULL, NULL);
+
+    return SymDeleteSymbol(hProcess, BaseOfDll, name, addr, flags);
+}
