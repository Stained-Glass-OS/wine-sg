+    void *p;
+
+    if (c->count == c->capacity)
+    {
+        unsigned int cap = c->capacity ? c->capacity * 2 : 64;
+
+        if (!(p = realloc(c->offsets, cap * sizeof(*c->offsets))))
+            return FALSE;
+        c->offsets = p;
+        c->capacity = cap;
+    }
+    if (!(p = realloc(c->names, c->names_len + len + 2)))
+        return FALSE;
+    c->names = p;
+    memcpy(c->names + c->names_len, info->Name, len);
+    c->names[c->names_len + len] = 0;
+    c->names[c->names_len + len + 1] = 0;
+    c->names_len += len + 2;
+    c->offsets[c->count++] = (ULONG)(info->Address - c->base);
+    return TRUE;
+}
