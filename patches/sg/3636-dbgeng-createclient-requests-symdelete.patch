+void hash_table_remove(struct hash_table* ht, struct hash_table_elt* elt)
+{
+    unsigned                    hash = hash_table_hash(elt->name, ht->num_buckets);
+    struct hash_table_elt*      prev = NULL;
+    struct hash_table_elt*      cur;
+
+    if (!ht->buckets) return;
+    for (cur = ht->buckets[hash].first; cur; prev = cur, cur = cur->next)
+    {
+        if (cur != elt) continue;
+        if (prev) prev->next = cur->next;
+        else ht->buckets[hash].first = cur->next;
+        if (ht->buckets[hash].last == cur) ht->buckets[hash].last = prev;
+        cur->next = NULL;
+        ht->num_elts--;
+        return;
+    }
+}
