From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32/tests: AccessCheckByType (3740)

advapi32/tests: AccessCheckByType

Without an object type list the function is AccessCheck: a right in the ACL is
granted with TRUE status and a right that is not gives FALSE status,
ERROR_ACCESS_DENIED and nothing granted. Wine returned FALSE with a
"granted" status.
---
diff --git a/dlls/advapi32/tests/security.c b/dlls/advapi32/tests/security.c
index 2d5a0de..032a4f8 100644
--- a/dlls/advapi32/tests/security.c
+++ b/dlls/advapi32/tests/security.c
@@ -6843,6 +6843,74 @@ static void test_system_security_access(void)
     CloseHandle( token );
 }
 
+static void test_AccessCheckByType(void)
+{
+    BOOL (WINAPI *pAccessCheckByType)(PSECURITY_DESCRIPTOR, PSID, HANDLE, DWORD, POBJECT_TYPE_LIST, DWORD,
+                                      PGENERIC_MAPPING, PPRIVILEGE_SET, LPDWORD, LPDWORD, LPBOOL);
+    GENERIC_MAPPING mapping = {0x1, 0x2, 0x4, 0xffff};
+    SID_IDENTIFIER_AUTHORITY world_auth = {SECURITY_WORLD_SID_AUTHORITY};
+    SECURITY_DESCRIPTOR sd;
+    PRIVILEGE_SET priv;
+    DWORD priv_len, granted;
+    HANDLE process, token;
+    PSID world, user;
+    char buffer[256];
+    BOOL ret, status;
+    ACL *acl;
+
+    pAccessCheckByType = (void *)GetProcAddress(hmod, "AccessCheckByType");
+    if (!pAccessCheckByType)
+    {
+        win_skip("AccessCheckByType is not available\n");
+        return;
+    }
+    ret = AllocateAndInitializeSid(&world_auth, 1, SECURITY_WORLD_RID, 0, 0, 0, 0, 0, 0, 0, &world);
+    ok(ret, "AllocateAndInitializeSid failed %lu\n", GetLastError());
+
+    ret = OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY, &process);
+    ok(ret, "OpenProcessToken failed %lu\n", GetLastError());
+    ret = DuplicateToken(process, SecurityImpersonation, &token);
+    ok(ret, "DuplicateToken failed %lu\n", GetLastError());
+    ret = GetTokenInformation(process, TokenUser, buffer, sizeof(buffer), &priv_len);
+    ok(ret, "GetTokenInformation failed %lu\n", GetLastError());
+    user = ((TOKEN_USER *)buffer)->User.Sid;
+    CloseHandle(process);
+
+    acl = calloc(1, 256);
+    ret = InitializeAcl(acl, 256, ACL_REVISION);
+    ok(ret, "InitializeAcl failed %lu\n", GetLastError());
+    ret = AddAccessAllowedAce(acl, ACL_REVISION, 0x1, world);
+    ok(ret, "AddAccessAllowedAce failed %lu\n", GetLastError());
+    InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION);
+    SetSecurityDescriptorOwner(&sd, user, FALSE);
+    SetSecurityDescriptorGroup(&sd, user, FALSE);
+    SetSecurityDescriptorDacl(&sd, TRUE, acl, FALSE);
+
+    /* without an object type list it is AccessCheck */
+    priv_len = sizeof(priv);
+    granted = 0xdeadbeef;
+    status = 0xdeadbeef;
+    SetLastError(0xdeadbeef);
+    ret = pAccessCheckByType(&sd, NULL, token, 0x1, NULL, 0, &mapping, &priv, &priv_len, &granted, &status);
+    ok(ret, "AccessCheckByType failed %lu\n", GetLastError());
+    ok(status == TRUE, "status = %d\n", status);
+    ok(granted == 0x1, "granted = %#lx\n", granted);
+
+    priv_len = sizeof(priv);
+    granted = 0xdeadbeef;
+    status = 0xdeadbeef;
+    SetLastError(0xdeadbeef);
+    ret = pAccessCheckByType(&sd, NULL, token, 0x2, NULL, 0, &mapping, &priv, &priv_len, &granted, &status);
+    ok(ret, "AccessCheckByType failed %lu\n", GetLastError());
+    ok(status == FALSE, "status = %d\n", status);
+    ok(GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError());
+    ok(granted == 0, "granted = %#lx\n", granted);
+
+    free(acl);
+    CloseHandle(token);
+    FreeSid(world);
+}
+
 static void test_GetWindowsAccountDomainSid(void)
 {
     char *user, buffer1[SECURITY_MAX_SID_SIZE], buffer2[SECURITY_MAX_SID_SIZE];
@@ -8718,6 +8786,7 @@ START_TEST(security)
     test_PrivateObjectSecurity();
     test_InitializeAcl();
     test_GetWindowsAccountDomainSid();
+    test_AccessCheckByType();
     test_EqualDomainSid();
     test_GetSecurityInfo();
     test_GetSidSubAuthority();
