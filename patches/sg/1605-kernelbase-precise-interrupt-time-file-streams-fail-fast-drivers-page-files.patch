+/* the system's modules (NtQuerySystemInformation's SystemModuleInformation):
+ * the kernel and drivers, as EnumDeviceDrivers lists them */
+static RTL_PROCESS_MODULES *get_system_modules(void)
+{
+    RTL_PROCESS_MODULES *modules;
+    ULONG size = 0x1000;
+    NTSTATUS status;
+
+    for (;;)
+    {
+        if (!(modules = HeapAlloc( GetProcessHeap(), 0, size )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return NULL;
+        }
+        status = NtQuerySystemInformation( SystemModuleInformation, modules, size, &size );
+        if (status != STATUS_INFO_LENGTH_MISMATCH) break;
+        HeapFree( GetProcessHeap(), 0, modules );
+    }
+    if (status)
+    {
+        HeapFree( GetProcessHeap(), 0, modules );
+        SetLastError( RtlNtStatusToDosError( status ));
+        return NULL;
+    }
+    return modules;
+}
+
+static const RTL_PROCESS_MODULE_INFORMATION *find_system_module( RTL_PROCESS_MODULES *modules, void *base )
+{
+    ULONG i;
+
+    for (i = 0; i < modules->ModulesCount; i++)
+        if (modules->Modules[i].ImageBaseAddress == base) return &modules->Modules[i];
+    SetLastError( ERROR_INVALID_HANDLE );
+    return NULL;
+}
+
 BOOL WINAPI EnumDeviceDrivers( void **image_base, DWORD count, DWORD *needed )
 {
+#ifndef SG_MUTANT_NO_DEVICE_DRIVERS
+    RTL_PROCESS_MODULES *modules;
+    ULONG i;
+
+    TRACE( "(%p, %ld, %p)\n", image_base, count, needed );
+
+    if (!(modules = get_system_modules())) return FALSE;
+    for (i = 0; i < modules->ModulesCount && (i + 1) * sizeof(void *) <= count; i++)
+        image_base[i] = modules->Modules[i].ImageBaseAddress;
+    if (needed) *needed = modules->ModulesCount * sizeof(void *);
+    HeapFree( GetProcessHeap(), 0, modules );
+    return TRUE;
+#else
     FIXME( "(%p, %ld, %p): stub\n", image_base, count, needed );
     if (needed) *needed = 0;
     return TRUE;
+#endif
 }
 
 
