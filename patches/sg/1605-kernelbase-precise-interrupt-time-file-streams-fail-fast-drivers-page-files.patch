+/* a system module's name: its file name, or the whole path */
+static DWORD get_device_driver_name( void *image_base, char *name, DWORD size, BOOL base_only )
+{
+    RTL_PROCESS_MODULES *modules;
+    const RTL_PROCESS_MODULE_INFORMATION *module;
+    const char *src;
+    DWORD len = 0;
+
+    if (name && size) name[0] = 0;
+    if (!(modules = get_system_modules())) return 0;
+    if ((module = find_system_module( modules, image_base )))
+    {
+        src = (const char *)module->Name + (base_only ? module->NameOffset : 0);
+        len = strlen( src );
+        if (len >= size) len = size ? size - 1 : 0;
+        if (name && size)
+        {
+            memcpy( name, src, len );
+            name[len] = 0;
+        }
+    }
+    HeapFree( GetProcessHeap(), 0, modules );
+    return len;
+}
+
+static DWORD get_device_driver_nameW( void *image_base, WCHAR *name, DWORD size, BOOL base_only )
+{
+    char buf[256];
+    DWORD len;
+
+    if (name && size) name[0] = 0;
+    if (!(len = get_device_driver_name( image_base, buf, sizeof(buf), base_only ))) return 0;
+    len = MultiByteToWideChar( CP_ACP, 0, buf, len, name, size ? size - 1 : 0 );
+    if (name && size) name[len] = 0;
+    return len;
+}
+
 DWORD WINAPI DECLSPEC_HOTPATCH GetDeviceDriverBaseNameA( void *image_base, char *name, DWORD size )
 {
+#ifndef SG_MUTANT_NO_DEVICE_DRIVERS
+    TRACE( "(%p, %p, %ld)\n", image_base, name, size );
