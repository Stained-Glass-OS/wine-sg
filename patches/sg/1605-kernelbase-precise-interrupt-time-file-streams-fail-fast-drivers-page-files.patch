  */
+static BOOL next_stream( struct find_stream_info *info, WIN32_FIND_STREAM_DATA *data )
+{
+    FILE_STREAM_INFORMATION *stream;
+    ULONG len;
+
+    if (info->pos >= info->len)
+    {
+        SetLastError( ERROR_HANDLE_EOF );
+        return FALSE;
+    }
+    stream = (FILE_STREAM_INFORMATION *)(info->data + info->pos);
+    len = min( stream->StreamNameLength / sizeof(WCHAR), ARRAY_SIZE(data->cStreamName) - 1 );
+    data->StreamSize = stream->StreamSize;
+    memcpy( data->cStreamName, stream->StreamName, len * sizeof(WCHAR) );
+    data->cStreamName[len] = 0;
+    info->pos = stream->NextEntryOffset ? info->pos + stream->NextEntryOffset : info->len;
+    return TRUE;
+}
+
 HANDLE WINAPI FindFirstStreamW( const WCHAR *filename, STREAM_INFO_LEVELS level, void *data, DWORD flags )
 {
+#ifndef SG_MUTANT_NO_FILE_STREAMS
+    struct find_stream_info *info = NULL;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    ULONG size = 1024;
+    HANDLE file;
+
+    TRACE( "(%s, %d, %p, %lx)\n", debugstr_w(filename), level, data, flags );
+
+    if (level != FindStreamInfoStandard)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+    if (flags)
+    {
+        SetLastError( ERROR_INVALID_FLAGS );
+        return INVALID_HANDLE_VALUE;
+    }
+    file = CreateFileW( filename, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, 0 );
+    if (file == INVALID_HANDLE_VALUE) return INVALID_HANDLE_VALUE;
+    for (;;)
+    {
+        if (!(info = HeapAlloc( GetProcessHeap(), 0, offsetof( struct find_stream_info, data[size] ))))
+        {
+            CloseHandle( file );
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return INVALID_HANDLE_VALUE;
+        }
+        status = NtQueryInformationFile( file, &io, info->data, size, FileStreamInformation );
+        if (status != STATUS_BUFFER_OVERFLOW && status != STATUS_BUFFER_TOO_SMALL) break;
+        HeapFree( GetProcessHeap(), 0, info );
+        size *= 4;
+    }
+    CloseHandle( file );
+    if (status)
+    {
+        HeapFree( GetProcessHeap(), 0, info );
+        SetLastError( RtlNtStatusToDosError( status ));
+        return INVALID_HANDLE_VALUE;
+    }
+    info->magic = FIND_STREAM_MAGIC;
+    info->pos = 0;
+    info->len = io.Information;
+    if (!next_stream( info, data ))
+    {
+        HeapFree( GetProcessHeap(), 0, info );
+        return INVALID_HANDLE_VALUE;
+    }
+    return info;
+#else
     FIXME("(%s, %d, %p, %lx): stub!\n", debugstr_w(filename), level, data, flags);
     SetLastError( ERROR_HANDLE_EOF );
     return INVALID_HANDLE_VALUE;
+#endif
 }
 
 
