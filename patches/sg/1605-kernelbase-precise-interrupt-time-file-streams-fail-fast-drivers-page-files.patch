+/* The swap space, as Windows' one page file: what a page file holds here.
+ * Task managers and system information tools list it; the stub failed. */
+static BOOL get_page_file( ENUM_PAGE_FILE_INFORMATION *info )
+{
+    MEMORYSTATUSEX status;
+    SYSTEM_BASIC_INFORMATION basic;
+    ULONGLONG swap, used;
+
+    status.dwLength = sizeof(status);
+    if (!GlobalMemoryStatusEx( &status )) return FALSE;
+    if (NtQuerySystemInformation( SystemBasicInformation, &basic, sizeof(basic), NULL )) return FALSE;
+    if (status.ullTotalPageFile <= status.ullTotalPhys) return FALSE;  /* no swap */
+    swap = status.ullTotalPageFile - status.ullTotalPhys;
+    used = (status.ullTotalPageFile - status.ullAvailPageFile) - (status.ullTotalPhys - status.ullAvailPhys);
+    if ((LONGLONG)used < 0) used = 0;
+    if (used > swap) used = swap;
+    info->cb = sizeof(*info);
+    info->Reserved = 0;
+    info->TotalSize = swap / basic.PageSize;
+    info->TotalInUse = used / basic.PageSize;
+    info->PeakUsage = info->TotalInUse;
+    return TRUE;
+}
+
 BOOL WINAPI /* DECLSPEC_HOTPATCH */ EnumPageFilesA( PENUM_PAGE_FILE_CALLBACKA callback, void *context )
 {
+#ifndef SG_MUTANT_NO_PAGE_FILES
+    ENUM_PAGE_FILE_INFORMATION info;
+
+    TRACE( "(%p, %p)\n", callback, context );
+    if (get_page_file( &info )) callback( context, &info, "C:\\pagefile.sys" );
+    return TRUE;
+#else
     FIXME( "(%p, %p) stub\n", callback, context );
     return FALSE;
+#endif
 }
 
 
