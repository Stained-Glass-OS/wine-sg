+/* An event sink handed to WMI. System.Management's sinks implement its own
+ * IWmiEventSource (Indicate one object, SetStatus); on Windows the stub made
+ * here is an IWbemObjectSink of the unsecured apartment that calls them. This
+ * one calls them directly. Handing back the managed object itself, a
+ * ManagementEventWatcher threw InvalidCastException at Start(). */
+typedef struct IWmiEventSource IWmiEventSource;
+typedef struct
+{
+    HRESULT (WINAPI *QueryInterface)( IWmiEventSource *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( IWmiEventSource * );
+    ULONG (WINAPI *Release)( IWmiEventSource * );
+    HRESULT (WINAPI *Indicate)( IWmiEventSource *, IWbemClassObject * );
+    HRESULT (WINAPI *SetStatus)( IWmiEventSource *, LONG, HRESULT, BSTR, IWbemClassObject * );
+} IWmiEventSourceVtbl;
+struct IWmiEventSource { const IWmiEventSourceVtbl *lpVtbl; };
+
+static const GUID IID_IWmiEventSource = {0x87a5ad68,0xa38a,0x43ef,{0xac,0xa9,0xef,0xe9,0x10,0xe5,0xd2,0x4c}};
+
+struct event_stub
+{
+    IWbemObjectSink IWbemObjectSink_iface;
+    LONG refs;
+    IWmiEventSource *source;
+};
+
+static inline struct event_stub *impl_from_IWbemObjectSink( IWbemObjectSink *iface )
+{
+    return CONTAINING_RECORD( iface, struct event_stub, IWbemObjectSink_iface );
+}
+
+static HRESULT WINAPI event_stub_QueryInterface( IWbemObjectSink *iface, REFIID riid, void **obj )
+{
+    struct event_stub *stub = impl_from_IWbemObjectSink( iface );
+
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IWbemObjectSink ))
+    {
+        *obj = &stub->IWbemObjectSink_iface;
+        IWbemObjectSink_AddRef( iface );
+        return S_OK;
+    }
+    if (IsEqualGUID( riid, &IID_IWmiEventSource ))
+        return stub->source->lpVtbl->QueryInterface( stub->source, riid, obj );
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI event_stub_AddRef( IWbemObjectSink *iface )
+{
+    struct event_stub *stub = impl_from_IWbemObjectSink( iface );
+    return InterlockedIncrement( &stub->refs );
+}
+
+static ULONG WINAPI event_stub_Release( IWbemObjectSink *iface )
+{
+    struct event_stub *stub = impl_from_IWbemObjectSink( iface );
+    LONG refs = InterlockedDecrement( &stub->refs );
+
+    if (!refs)
+    {
+        stub->source->lpVtbl->Release( stub->source );
+        free( stub );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI event_stub_Indicate( IWbemObjectSink *iface, LONG count, IWbemClassObject **objs )
+{
+    struct event_stub *stub = impl_from_IWbemObjectSink( iface );
+    LONG i;
+
+    TRACE( "%p %ld\n", iface, count );
+    for (i = 0; i < count; i++) stub->source->lpVtbl->Indicate( stub->source, objs[i] );
+    return WBEM_S_NO_ERROR;
+}
+
+static HRESULT WINAPI event_stub_SetStatus( IWbemObjectSink *iface, LONG flags, HRESULT hr, BSTR param,
+                                            IWbemClassObject *obj )
+{
+    struct event_stub *stub = impl_from_IWbemObjectSink( iface );
+
+    TRACE( "%p %#lx %#lx\n", iface, flags, hr );
+    stub->source->lpVtbl->SetStatus( stub->source, flags, hr, param, obj );
+    return WBEM_S_NO_ERROR;
+}
+
+static const IWbemObjectSinkVtbl event_stub_vtbl =
+{
+    event_stub_QueryInterface,
+    event_stub_AddRef,
+    event_stub_Release,
+    event_stub_Indicate,
+    event_stub_SetStatus,
+};
+
+HRESULT WINAPI GetDemultiplexedStub( IUnknown *obj, BOOL local, IUnknown **result )
+{
+    struct event_stub *stub;
+    IWmiEventSource *source;
+    HRESULT hr;
+
+    TRACE( "%p %d\n", obj, local );
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!obj) return E_INVALIDARG;
+#ifdef SG_MUTANT_WMINET_SELF_STUB
+    IUnknown_AddRef( obj );
+    *result = obj;
+    return S_OK;
+#endif
+    if (FAILED(hr = IUnknown_QueryInterface( obj, &IID_IWmiEventSource, (void **)&source ))) return hr;
+    if (!(stub = malloc( sizeof(*stub) )))
+    {
+        source->lpVtbl->Release( source );
+        return E_OUTOFMEMORY;
+    }
+    stub->IWbemObjectSink_iface.lpVtbl = &event_stub_vtbl;
+    stub->refs = 1;
+    stub->source = source;
+    *result = (IUnknown *)&stub->IWbemObjectSink_iface;
+    return S_OK;
+}
