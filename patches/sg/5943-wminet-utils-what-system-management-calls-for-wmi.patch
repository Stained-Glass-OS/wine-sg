+/* ---- namespaces and queries --------------------------------------------- */
+
+static BSTR bstr( const WCHAR *str )
+{
+    return str ? SysAllocString( str ) : NULL;
+}
+
+HRESULT WINAPI ConnectServerWmi( const WCHAR *resource, const WCHAR *user, const WCHAR *password, const WCHAR *locale,
+                                 LONG flags, const WCHAR *authority, IWbemContext *ctx, IWbemServices **services,
+                                 DWORD imp, DWORD authn )
+{
+    BSTR b_resource = bstr( resource ), b_user = bstr( user ), b_password = bstr( password );
+    BSTR b_locale = bstr( locale ), b_authority = bstr( authority );
+    IWbemLocator *locator;
+    HRESULT hr;
+
+    TRACE( "%s %#lx\n", debugstr_w(resource), flags );
+    if (!services) return E_POINTER;
+    *services = NULL;
+    hr = CoCreateInstance( &CLSID_WbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemLocator, (void **)&locator );
+    if (SUCCEEDED(hr))
+    {
+        hr = IWbemLocator_ConnectServer( locator, b_resource, b_user, b_password, b_locale, flags, b_authority,
+                                         ctx, services );
+        IWbemLocator_Release( locator );
+        if (SUCCEEDED(hr)) set_blanket( (IUnknown *)*services, authn, imp );
+    }
+    SysFreeString( b_resource ); SysFreeString( b_user ); SysFreeString( b_password );
+    SysFreeString( b_locale ); SysFreeString( b_authority );
+    return hr;
+}
+
+HRESULT WINAPI ExecQueryWmi( const WCHAR *language, const WCHAR *query, LONG flags, IWbemContext *ctx,
+                             IEnumWbemClassObject **result, DWORD imp, DWORD authn, IWbemServices *services,
+                             const WCHAR *user, const WCHAR *password, const WCHAR *authority )
+{
+    BSTR b_language = bstr( language ), b_query = bstr( query );
+    HRESULT hr;
+
+    TRACE( "%s %s %#lx\n", debugstr_w(language), debugstr_w(query), flags );
+    if (!services) return E_INVALIDARG;
+#ifdef SG_MUTANT_WMINET_NO_QUERY
+    SysFreeString( b_language ); SysFreeString( b_query );
+    return WBEM_E_FAILED;
+#endif
+    hr = IWbemServices_ExecQuery( services, b_language, b_query, flags, ctx, result );
+    SysFreeString( b_language ); SysFreeString( b_query );
+    return hr;
+}
