+HRESULT WINAPI CreateClassEnumWmi( const WCHAR *superclass, LONG flags, IWbemContext *ctx, IEnumWbemClassObject **result,
+                                   DWORD imp, DWORD authn, IWbemServices *services, const WCHAR *user,
