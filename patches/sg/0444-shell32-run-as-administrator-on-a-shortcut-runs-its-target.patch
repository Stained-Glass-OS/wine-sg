From: Stained Glass OS <dev@stained-glass.example>
Subject: shell32: Run as administrator on a shortcut runs its target

ShellExecute("runas") on a shortcut -- the Start menu's "Run as administrator"
on PowerShell 7 -- found no "runas" item in the shortcut's context menu and
fell back to handing the elevation broker the shortcut's own path, unquoted:
split at its first space ("C:\\ProgramData\\Microsoft\\Windows\\Start"), and
nothing ran. A verb the menu does not list by name is now passed to
InvokeCommand by name, as Windows' ShellExecute passes canonical verbs, and
the shortcut's InvokeCommand takes "open" and "runas" by name and starts
its target with that verb. Gate: make test-elevreq.
---
--- a/dlls/shell32/shelllink.c
+++ b/dlls/shell32/shelllink.c
@@ -2450,6 +2450,7 @@
     HWND hwnd = NULL; /* FIXME: get using interface set from IObjectWithSite */
     LPWSTR args = NULL;
     LPWSTR path = NULL;
+    const WCHAR *verb = L"Open";
     HRESULT r;
 
     TRACE("%p %p\n", This, lpici );
@@ -2457,10 +2458,33 @@
     if ( lpici->cbSize < sizeof (CMINVOKECOMMANDINFO) )
         return E_INVALIDARG;
 
-    if ( lpici->lpVerb != MAKEINTRESOURCEA(This->iIdOpen) )
+    if ( IS_INTRESOURCE( lpici->lpVerb ) )
     {
-        ERR("Unknown id %p != %d\n", lpici->lpVerb, This->iIdOpen );
-        return E_INVALIDARG;
+        if ( lpici->lpVerb != MAKEINTRESOURCEA(This->iIdOpen) )
+        {
+            ERR("Unknown id %p != %d\n", lpici->lpVerb, This->iIdOpen );
+            return E_INVALIDARG;
+        }
+    }
+    else
+    {
+        /* Stained Glass OS: the verbs by name, as ShellExecute passes them.
+         * "runas" -- Run as administrator on a shortcut -- starts the target
+         * elevated; it was refused, and the shortcut's own path went to the
+         * elevation broker instead (split at its first space: "Run as
+         * administrator" on the Start menu's PowerShell 7 did nothing). */
+        WCHAR name[16];
+        const LPCMINVOKECOMMANDINFOEX iciex = (LPCMINVOKECOMMANDINFOEX)lpici;
+        if ( lpici->cbSize == sizeof (CMINVOKECOMMANDINFOEX) && (lpici->fMask & CMIC_MASK_UNICODE) && iciex->lpVerbW )
+            lstrcpynW( name, iciex->lpVerbW, ARRAY_SIZE(name) );
+        else
+            MultiByteToWideChar( CP_ACP, 0, lpici->lpVerb, -1, name, ARRAY_SIZE(name) ), name[ARRAY_SIZE(name) - 1] = 0;
+        if ( !wcsicmp( name, L"runas" ) ) verb = L"runas";
+        else if ( wcsicmp( name, L"open" ) )
+        {
+            TRACE("verb %s not supported\n", debugstr_w(name) );
+            return E_INVALIDARG;
+        }
     }
 
     r = IShellLinkW_Resolve(&This->IShellLinkW_iface, hwnd, 0);
@@ -2506,7 +2530,7 @@
     sei.lpIDList = This->pPidl;
     sei.lpDirectory = This->sWorkDir;
     sei.lpParameters = args;
-    sei.lpVerb = L"Open";
+    sei.lpVerb = verb;
 
     if( ShellExecuteExW( &sei ) )
         r = S_OK;
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -1334,6 +1334,7 @@
     CMINVOKECOMMANDINFOEX ici;
     MENUITEMINFOW info;
     WCHAR string[0x80];
+    char verb[64];
     INT i, n, def = -1;
     HMENU hmenu = 0;
     HRESULT r;
@@ -1374,15 +1375,23 @@
         }
     }
 
+    memset( &ici, 0, sizeof ici );
     r = E_FAIL;
     if ( def == -1 )
-        goto end;
+    {
+        /* Stained Glass OS: a verb the menu does not list by name -- "runas"
+         * on a shortcut -- is passed by name, as Windows' ShellExecute passes
+         * canonical verbs; the handler says whether it knows it. */
+        if ( !sei->lpVerb || !WideCharToMultiByte( CP_ACP, 0, sei->lpVerb, -1, verb, sizeof(verb), NULL, NULL ) )
+            goto end;
+        ici.lpVerb = verb;
+        ici.lpVerbW = sei->lpVerb;
+    }
+    else ici.lpVerb = MAKEINTRESOURCEA( def );
 
-    memset( &ici, 0, sizeof ici );
     ici.cbSize = sizeof ici;
     ici.fMask = CMIC_MASK_UNICODE | (sei->fMask & (SEE_MASK_NO_CONSOLE|SEE_MASK_NOASYNC|SEE_MASK_ASYNCOK|SEE_MASK_FLAG_NO_UI));
     ici.nShow = sei->nShow;
-    ici.lpVerb = MAKEINTRESOURCEA( def );
     ici.hwnd = sei->hwnd;
     ici.lpParametersW = sei->lpParameters;
     
