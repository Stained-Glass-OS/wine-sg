From: Stained Glass OS <dev@stained-glass.example>
Subject: light.msstyles, uxtheme: Rounded and Rounded Dark colour schemes

The Rounded style (0483, Settings > Personalization > Colors > Window
style) is newer Windows' look; its controls are rounder, with a blue
accent and lighter edges. light.msstyles carries two more colour schemes,
"Rounded" and "RoundedDark" (COLORNAMES, FILERESNAMES, display names),
whose INIs and images are generated, never drawn: wine-sg's
theme/rounded.py derives them from the Light style's SVGs and INI
(rounded.rc, which light.rc now includes; build.sh runs it after dark.py).

uxtheme's RefreshImmersiveColorPolicyState -- the shell calls it on
"ImmersiveColorSet" -- selects Rounded, or Rounded Dark in the dark app
mode, while HKCU\Software\Stained Glass\Style Rounded is 1 and the style
has them; Blue and Dark otherwise, as before.

Gate: test/darkmode-gate.sh (the schemes, light and dark, live).
---
--- a/dlls/light.msstyles/light.rc
+++ b/dlls/light.msstyles/light.rc
@@ -27,6 +27,8 @@
 {
     IDS_COLOR_DISPLAY_NAME_BLUE         "Blue"
     IDS_COLOR_DISPLAY_NAME_DARK         "Dark"
+    IDS_COLOR_DISPLAY_NAME_ROUNDED      "Rounded"
+    IDS_COLOR_DISPLAY_NAME_ROUNDEDDARK  "Rounded Dark"
 }
 
 /* Theme color tooltips */
@@ -34,6 +36,8 @@
 {
     IDS_COLOR_TOOLTIP_BLUE         "Blue"
     IDS_COLOR_TOOLTIP_DARK         "Dark"
+    IDS_COLOR_TOOLTIP_ROUNDED      "Rounded"
+    IDS_COLOR_TOOLTIP_ROUNDEDDARK  "Rounded Dark"
 }
 
 /* Theme size display names */
@@ -58,6 +62,8 @@
 {
 "Blue\0"
 "Dark\0"
+"Rounded\0"
+"RoundedDark\0"
 "\0"
 }
 
@@ -73,6 +79,8 @@
 {
 "BLUE_INI\0"
 "DARK_INI\0"
+"ROUNDED_INI\0"
+"ROUNDEDDARK_INI\0"
 "\0"
 }
 
@@ -4578,6 +4586,10 @@
  * and the rendered Light images (build.sh runs it after the series). */
 #include "dark.rc"
 
+/* The Rounded and Rounded Dark colour schemes (the Rounded style): generated
+ * by wine-sg theme/rounded.py from BLUE_INI and the Light images. */
+#include "rounded.rc"
+
 /* File version */
 #define WINE_FILEDESCRIPTION_STR "Light Theme"
 #define WINE_FILENAME_STR "light.msstyles"
--- a/dlls/light.msstyles/resources.h
+++ b/dlls/light.msstyles/resources.h
@@ -20,7 +20,11 @@
 
 #define IDS_COLOR_DISPLAY_NAME_BLUE            1000
 #define IDS_COLOR_DISPLAY_NAME_DARK            1001
+#define IDS_COLOR_DISPLAY_NAME_ROUNDED         1002
+#define IDS_COLOR_DISPLAY_NAME_ROUNDEDDARK     1003
 #define IDS_COLOR_TOOLTIP_BLUE                 2000
 #define IDS_COLOR_TOOLTIP_DARK                 2001
+#define IDS_COLOR_TOOLTIP_ROUNDED              2002
+#define IDS_COLOR_TOOLTIP_ROUNDEDDARK          2003
 #define IDS_SIZE_DISPLAY_NAME_NORMAL           3000
 #define IDS_SIZE_TOOLTIP_NORMAL                4000
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -644,21 +644,28 @@
 void WINAPI RefreshImmersiveColorPolicyState(void)
 {
     WCHAR theme[MAX_PATH], color[64], size[64];
-    PTHEME_FILE light = NULL, dark = NULL, want;
-    BOOL active;
+    PTHEME_FILE light = NULL, dark = NULL, rounded = NULL, want;
+    DWORD style = 0, len = sizeof(style);
+    BOOL active, dark_mode;
 
     UXTHEME_FollowThemeChange();
     read_theme_config(&active, theme, color, sizeof(color), size, sizeof(size));
     if (!active || !theme[0]) return;
     if (FAILED(MSSTYLES_OpenThemeFile(theme, L"Dark", size[0] ? size : NULL, &dark)))
         return;   /* this style has no dark scheme */
+    dark_mode = ShouldAppsUseDarkMode();
+    /* Stained Glass OS: the Rounded style (HKCU\Software\Stained Glass\Style
+     * Rounded) takes the style's Rounded or Rounded Dark scheme, if it has them */
+    RegGetValueW(HKEY_CURRENT_USER, L"Software\\Stained Glass\\Style", L"Rounded", RRF_RT_REG_DWORD, NULL, &style, &len);
+    if (style) MSSTYLES_OpenThemeFile(theme, dark_mode ? L"RoundedDark" : L"Rounded", size[0] ? size : NULL, &rounded);
     if (SUCCEEDED(MSSTYLES_OpenThemeFile(theme, NULL, size[0] ? size : NULL, &light)))
     {
-        want = ShouldAppsUseDarkMode() ? dark : light;
+        want = rounded ? rounded : dark_mode ? dark : light;
         if (lstrcmpiW(color, want->pszSelectedColor) || lstrcmpiW(szCurrentColor, want->pszSelectedColor))
             UXTHEME_ApplyColorScheme(want);
         MSSTYLES_CloseThemeFile(light);
     }
+    if (rounded) MSSTYLES_CloseThemeFile(rounded);
     MSSTYLES_CloseThemeFile(dark);
 }
 
