From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: D3DXSaveSurfaceToFile* writes TGA and PPM files

D3DXSaveSurfaceToFile{A,W,InMemory} answered E_NOTIMPL for TGA and PPM. The Wine test
(todo) records that native accepts both ("PPM and TGA are supported, even though MSDN
claims they aren't").

 - TGA: an uncompressed true colour image of 32 bits (B, G, R, A), top-left origin, with
   the size of the surface or of the source rectangle; the file is read back by
   D3DXGetImageInfoFromFileInMemory and D3DXLoadSurfaceFromFileInMemory.
 - PPM: a binary P6 file (8 bit RGB, maximum 255) of the surface or the rectangle.
 - The surface is converted to A8R8G8B8 first, with its palette if it has one.
 - HDR and PFM are still not written.
---
--- a/dlls/d3dx9_36/surface.c
+++ b/dlls/d3dx9_36/surface.c
@@ -3156,6 +3156,109 @@ HRESULT WINAPI D3DXSaveSurfaceToFileW(const WCHAR *dst_filename, D3DXIMAGE_FILEF
     return hr;
 }
 
+/* TGA (uncompressed true colour, 32 bit, top-left origin) and PPM (binary, 8 bit) of a surface */
+static HRESULT save_tga_ppm_surface_to_memory(ID3DXBuffer **dst_buffer, D3DXIMAGE_FILEFORMAT file_format,
+        IDirect3DSurface9 *src_surface, const PALETTEENTRY *src_palette, const RECT *src_rect)
+{
+    D3DSURFACE_DESC desc;
+    IDirect3DSurface9 *temp;
+    IDirect3DDevice9 *device;
+    D3DLOCKED_RECT locked;
+    ID3DXBuffer *buffer;
+    unsigned int width, height, x, y, header_size;
+    char header[64];
+    BYTE *out;
+    HRESULT hr;
+
+    IDirect3DSurface9_GetDesc(src_surface, &desc);
+    if (src_rect)
+    {
+        if (src_rect->left < 0 || src_rect->top < 0 || src_rect->left >= src_rect->right
+                || src_rect->top >= src_rect->bottom || src_rect->right > desc.Width || src_rect->bottom > desc.Height)
+            return D3DERR_INVALIDCALL;
+        width = src_rect->right - src_rect->left;
+        height = src_rect->bottom - src_rect->top;
+    }
+    else
+    {
+        width = desc.Width;
+        height = desc.Height;
+    }
+
+    if (FAILED(hr = IDirect3DSurface9_GetDevice(src_surface, &device)))
+        return hr;
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, width, height, D3DFMT_A8R8G8B8, D3DPOOL_SYSTEMMEM,
+            &temp, NULL);
+    IDirect3DDevice9_Release(device);
+    if (FAILED(hr))
+        return hr;
+
+    if (FAILED(hr = D3DXLoadSurfaceFromSurface(temp, NULL, NULL, src_surface, src_palette, src_rect,
+            D3DX_FILTER_NONE, 0)))
+        goto done;
+    if (FAILED(hr = IDirect3DSurface9_LockRect(temp, &locked, NULL, D3DLOCK_READONLY)))
+        goto done;
+
+    if (file_format == D3DXIFF_PPM)
+    {
+        header_size = snprintf(header, sizeof(header), "P6\n%u %u\n255\n", width, height);
+        hr = D3DXCreateBuffer(header_size + width * height * 3, &buffer);
+    }
+    else
+    {
+        header_size = 18;
+        memset(header, 0, header_size);
+        header[2] = 2; /* uncompressed true colour */
+        header[12] = width & 0xff; header[13] = width >> 8;
+        header[14] = height & 0xff; header[15] = height >> 8;
+        header[16] = 32;
+        header[17] = 0x20 | 8; /* top-left origin, 8 alpha bits */
+        hr = D3DXCreateBuffer(header_size + width * height * 4, &buffer);
+    }
+    if (FAILED(hr))
+    {
+        IDirect3DSurface9_UnlockRect(temp);
+        goto done;
+    }
+
+    out = ID3DXBuffer_GetBufferPointer(buffer);
+    memcpy(out, header, header_size);
+    out += header_size;
+    for (y = 0; y < height; ++y)
+    {
+        const BYTE *row = (const BYTE *)locked.pBits + y * locked.Pitch;
+
+        for (x = 0; x < width; ++x)
+        {
+            const BYTE *p = row + x * 4; /* B, G, R, A */
+
+            if (file_format == D3DXIFF_PPM)
+            {
+#ifdef SG_MUTANT_D3DXSAVE_PPM_BGR
+                *out++ = p[0];
+                *out++ = p[1];
+                *out++ = p[2];
+#else
+                *out++ = p[2];
+                *out++ = p[1];
+                *out++ = p[0];
+#endif
+            }
+            else
+            {
+                memcpy(out, p, 4);
+                out += 4;
+            }
+        }
+    }
+    IDirect3DSurface9_UnlockRect(temp);
+    *dst_buffer = buffer;
+
+done:
+    IDirect3DSurface9_Release(temp);
+    return hr;
+}
+
 HRESULT WINAPI D3DXSaveSurfaceToFileInMemory(ID3DXBuffer **dst_buffer, D3DXIMAGE_FILEFORMAT file_format,
         IDirect3DSurface9 *src_surface, const PALETTEENTRY *src_palette, const RECT *src_rect)
 {
@@ -3204,10 +3307,14 @@ HRESULT WINAPI D3DXSaveSurfaceToFileInMemory(ID3DXBuffer **dst_buffer, D3DXIMAGE
             break;
         case D3DXIFF_DDS:
             return save_dds_surface_to_memory(dst_buffer, src_surface, src_palette, src_rect);
-        case D3DXIFF_HDR:
-        case D3DXIFF_PFM:
         case D3DXIFF_TGA:
         case D3DXIFF_PPM:
+#ifdef SG_MUTANT_D3DXSAVE_TGA_PPM_REFUSED
+            return E_NOTIMPL;
+#endif
+            return save_tga_ppm_surface_to_memory(dst_buffer, file_format, src_surface, src_palette, src_rect);
+        case D3DXIFF_HDR:
+        case D3DXIFF_PFM:
             FIXME("File format %#x is not supported yet\n", file_format);
             return E_NOTIMPL;
         default:
--- a/dlls/d3dx9_36/tests/surface.c
+++ b/dlls/d3dx9_36/tests/surface.c
@@ -4029,13 +4029,10 @@ static void test_D3DXSaveSurfaceToFile(IDirect3DDevice9 *device)
     ok(hr == D3DERR_INVALIDCALL, "Got unexpected hr %#lx.\n", hr);
 
     /* PPM and TGA are supported, even though MSDN claims they aren't */
-    todo_wine
-    {
-        hr = D3DXSaveSurfaceToFileA("saved_surface.ppm", D3DXIFF_PPM, surface, NULL, NULL);
-        ok(hr == D3D_OK, "Got unexpected hr %#lx.\n", hr);
-        hr = D3DXSaveSurfaceToFileA("saved_surface.tga", D3DXIFF_TGA, surface, NULL, NULL);
-        ok(hr == D3D_OK, "Got unexpected hr %#lx.\n", hr);
-    }
+    hr = D3DXSaveSurfaceToFileA("saved_surface.ppm", D3DXIFF_PPM, surface, NULL, NULL);
+    ok(hr == D3D_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = D3DXSaveSurfaceToFileA("saved_surface.tga", D3DXIFF_TGA, surface, NULL, NULL);
+    ok(hr == D3D_OK, "Got unexpected hr %#lx.\n", hr);
 
     hr = D3DXSaveSurfaceToFileA("saved_surface.dds", D3DXIFF_DDS, surface, NULL, NULL);
     ok(hr == D3D_OK, "Got unexpected hr %#lx.\n", hr);
