From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sechost, services, winlogon: services are told of session events (SERVICE_CONTROL_SESSIONCHANGE)

No service was ever told of a session event: nothing sent
SERVICE_CONTROL_SESSIONCHANGE. A service that starts its program on each
person's desktop when they sign in never did for anyone who signed in after it
had started -- WireGuard for Windows' manager service, started at boot, never
started its tray window (i1011).

As Windows' session manager has the SCM tell them, the services that accept
SERVICE_ACCEPT_SESSIONCHANGE now get WTS_CONSOLE_CONNECT and WTS_SESSION_LOGON
when a person signs in to a session and WTS_SESSION_LOGOFF when it ends, with a
WTSSESSION_NOTIFICATION naming the session (HandlerEx's event type and data).
winlogon.exe, which sg-lockd starts as SYSTEM in each session and whose input
ends with it, tells the SCM through sechost's I_ScSendTSMessage (a new
services.exe call, svcctl_SgSessionEvent, SYSTEM only). The sign-in screen's
session, whose account is a system one, is no logon. Services in a shared
process (svchost) are not told yet.

Test: test/sessionchange-gate.sh (QA VM): a test service is told of the
connect, logon and logoff of the person's session, nothing for the sign-in
screen's, and a person's own program cannot send events. Mutants
SG_MUTANT_NO_SESSION_EVENTS and SG_MUTANT_SESSION_EVENT_ANY
(programs/services/rpc.c) fail it.
---
--- a/include/wine/svcctl.idl
+++ b/include/wine/svcctl.idl
@@ -881,4 +881,12 @@
         [in] DWORD info_level,
         [out] SC_RPC_CONFIG_INFOW *info
     );
+
+    /* Stained Glass OS (i1011): a session event for the services (I_ScSendTSMessage),
+     * SYSTEM only. Not a Windows function. */
+    DWORD svcctl_SgSessionEvent(
+        [in,unique] MACHINE_HANDLEW machine,
+        [in] DWORD event,
+        [in] DWORD session_id
+    );
 }
--- a/programs/services/Makefile.in
+++ b/programs/services/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = services.exe
-IMPORTS   = rpcrt4 advapi32 userenv setupapi
+IMPORTS   = rpcrt4 advapi32 userenv setupapi ntdll
 
 EXTRADLLFLAGS = -mwindows
 
--- a/programs/winlogon/Makefile.in
+++ b/programs/winlogon/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = winlogon.exe
+IMPORTS   = sechost
 
 EXTRADLLFLAGS = -mconsole -municode
 
--- a/programs/winlogon/main.c
+++ b/programs/winlogon/main.c
@@ -31,15 +31,29 @@
  */
 
 #include <windows.h>
+#include <wtsapi32.h>
+
+/* sechost: not in the SDK headers */
+DWORD WINAPI I_ScSendTSMessage( DWORD event, DWORD session_id, DWORD size, void *data );
 
 int __cdecl wmain( int argc, WCHAR *argv[] )
 {
     HANDLE in = GetStdHandle( STD_INPUT_HANDLE );
+    DWORD got, session = 0;
     char buf[64];
-    DWORD got;
 
     /* no standard input to wait on: nobody holds us, so do not linger */
     if (!in || in == INVALID_HANDLE_VALUE) return 0;
+
+    /* (i1011) the person has signed in to this session: the services that want to know are told,
+     * as Windows' session manager has the SCM tell them -- and that they signed out, when the
+     * session ends */
+    ProcessIdToSessionId( GetCurrentProcessId(), &session );
+    if (session == WTSGetActiveConsoleSessionId()) I_ScSendTSMessage( WTS_CONSOLE_CONNECT, session, 0, NULL );
+    I_ScSendTSMessage( WTS_SESSION_LOGON, session, 0, NULL );
+
     while (ReadFile( in, buf, sizeof(buf), &got, NULL ) && got) ;
+
+    I_ScSendTSMessage( WTS_SESSION_LOGOFF, session, 0, NULL );
     return 0;
 }
--- a/dlls/sechost/sechost.spec
+++ b/dlls/sechost/sechost.spec
@@ -114,7 +114,7 @@
 @ stub I_ScRpcBindA
 @ stub I_ScRpcBindW
 @ stub I_ScSendPnPMessage
-@ stub I_ScSendTSMessage
+@ stdcall I_ScSendTSMessage(long long long ptr)
 @ stdcall I_ScUnregisterDeviceNotification(ptr)
 @ stub I_ScValidatePnPService
 @ stub LocalGetConditionForString
--- a/dlls/sechost/service.c
+++ b/dlls/sechost/service.c
@@ -2238,6 +2238,31 @@
     subscription_release( sub );
 }
 
+/******************************************************************************
+ *     I_ScSendTSMessage   (sechost.@)
+ *
+ * Stained Glass OS (i1011): a session event (WTS_SESSION_LOGON, _LOGOFF,
+ * WTS_CONSOLE_CONNECT...) for every service that accepts
+ * SERVICE_CONTROL_SESSIONCHANGE, as Windows' session manager tells the SCM.
+ * winlogon.exe, which sg-lockd starts in each session, sends them. SYSTEM only.
+ */
+DWORD WINAPI I_ScSendTSMessage( DWORD event, DWORD session_id, DWORD size, void *data )
+{
+    DWORD err;
+
+    TRACE( "%#lx %lu\n", event, session_id );
+    __TRY
+    {
+        err = svcctl_SgSessionEvent( NULL, event, session_id );
+    }
+    __EXCEPT(rpc_filter)
+    {
+        err = map_exception_code( GetExceptionCode() );
+    }
+    __ENDTRY
+    return err;
+}
+
 /* thunk for calling the RegisterServiceCtrlHandler handler function */
 static DWORD WINAPI ctrl_handler_thunk( DWORD control, DWORD type, void *data, void *context )
 {
@@ -2489,6 +2514,12 @@
 
     if (control == SERVICE_CONTROL_START)
         ret = service_handle_start( service, data, data_size );
+    else if (control == SERVICE_CONTROL_SESSIONCHANGE && data_size == 3 * sizeof(DWORD))
+    {
+        /* services.exe sends the event type ahead of the WTSSESSION_NOTIFICATION (cbSize, session; i1011) */
+        if (service->handler)
+            ret = service->handler( control, *(const DWORD *)data, (BYTE *)data + sizeof(DWORD), service->context );
+    }
     else if (service->handler)
         ret = service->handler( control, 0, (void *)data, service->context );
     return ret;
--- a/programs/services/rpc.c
+++ b/programs/services/rpc.c
@@ -34,6 +34,7 @@
 #include "wine/list.h"
 #include "wine/debug.h"
 
+#include "wine/server.h"
 #include "services.h"
 #include "svcctl.h"
 
@@ -2541,6 +2542,110 @@
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
+/* Stained Glass OS (i1011): session events for the services that accept them
+ * (SERVICE_ACCEPT_SESSIONCHANGE), as Windows' session manager has the SCM tell
+ * them: a person signing in (WTS_SESSION_LOGON) or out, a session reaching the
+ * console. Nobody told them: a service that starts its program on each person's
+ * desktop when they sign in (WireGuard's manager its tray window) never did for
+ * anyone who signed in after it started. winlogon.exe, which sg-lockd starts as
+ * SYSTEM in each session, sends them through I_ScSendTSMessage; the sign-in
+ * screen's session, whose user is no person, is no logon. */
+struct session_event
+{
+    DWORD event;                                   /* WTS_SESSION_LOGON... */
+    struct { DWORD cbSize, dwSessionId; } notification;  /* WTSSESSION_NOTIFICATION */
+};
+
+static DWORD WINAPI session_event_thread(void *arg)
+{
+    struct session_event *ev = arg;
+    struct service_entry **list = NULL, *service;
+    unsigned int count = 0, size = 0, i;
+
+    scmdatabase_lock(active_database);
+    LIST_FOR_EACH_ENTRY(service, &active_database->services, struct service_entry, entry)
+    {
+        if (!service->process || service->shared_process || service->status.dwCurrentState != SERVICE_RUNNING ||
+            !(service->status.dwControlsAccepted & SERVICE_ACCEPT_SESSIONCHANGE)) continue;
+        if (count == size)
+        {
+            struct service_entry **new_list = realloc(list, (size = size ? size * 2 : 8) * sizeof(*list));
+            if (!new_list) break;
+            list = new_list;
+        }
+        list[count++] = grab_service(service);
+    }
+    scmdatabase_unlock(active_database);
+
+    for (i = 0; i < count; i++)
+    {
+        struct process_entry *process;
+        DWORD result;
+
+        service = list[i];
+        service_lock(service);
+        process = grab_process(service->process);
+        service_unlock(service);
+        if (!process) continue;
+        WINE_TRACE("session event %#lx (%lu) to %s\n", ev->event, ev->notification.dwSessionId, wine_dbgstr_w(service->name));
+        if (WaitForSingleObject(process->control_mutex, 10000) == WAIT_OBJECT_0)
+        {
+            process_send_control(process, FALSE, service->name, SERVICE_CONTROL_SESSIONCHANGE,
+                                 (const BYTE *)ev, sizeof(*ev), &result);
+            ReleaseMutex(process->control_mutex);
+        }
+        release_process(process);
+    }
+    for (i = 0; i < count; i++) release_service(list[i]);
+    free(list);
+    free(ev);
+    return 0;
+}
+
+DWORD __cdecl svcctl_SgSessionEvent(MACHINE_HANDLEW machine, DWORD event, DWORD session_id)
+{
+    struct session_event *ev;
+    HANDLE token, thread;
+    NTSTATUS status;
+    unsigned int uid = 0;
+    BOOL system;
+
+    WINE_TRACE("%#lx %lu\n", event, session_id);
+    if (RpcImpersonateClient(NULL) != RPC_S_OK) return ERROR_ACCESS_DENIED;
+    system = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &token) && is_system_token(token);
+    if (system) CloseHandle(token);
+    RpcRevertToSelf();
+    if (!system) return ERROR_ACCESS_DENIED;
+    if (event < WTS_CONSOLE_CONNECT || event > WTS_SESSION_TERMINATE) return ERROR_INVALID_PARAMETER;
+
+    /* a person's session (the sign-in screen's account is a system one) */
+    SERVER_START_REQ(get_session_uid)
+    {
+        req->session_id = session_id;
+        if (!(status = wine_server_call(req))) uid = reply->uid;
+    }
+    SERVER_END_REQ;
+#ifndef SG_MUTANT_SESSION_EVENT_ANY
+    if (!status && uid < 1000) return ERROR_SUCCESS;
+#endif
+
+    if (!(ev = malloc(sizeof(*ev)))) return ERROR_NOT_ENOUGH_SERVER_MEMORY;
+    ev->event = event;
+    ev->notification.cbSize = sizeof(ev->notification);
+    ev->notification.dwSessionId = session_id;
+#ifdef SG_MUTANT_NO_SESSION_EVENTS
+    free(ev);
+    return ERROR_SUCCESS;
+#endif
+    if (!(thread = CreateThread(NULL, 0, session_event_thread, ev, 0, NULL)))
+    {
+        free(ev);
+        return GetLastError();
+    }
+    CloseHandle(thread);
+    return ERROR_SUCCESS;
+}
+
 DWORD __cdecl svcctl_QueryServiceConfigEx(
     SC_RPC_HANDLE hService,
     DWORD info_level,
