@@ -0,0 +1,332 @@
+/*
+ * The COM port database (msports.dll)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Stained Glass OS (wine-sg 8013): the database that hands out COM port numbers to port installers, as the
+ * WDK describes it: a bit per port number (bit 0 of byte 0 is COM1) kept in the "ComDB" value of
+ * HKLM\System\CurrentControlSet\Control\COM Name Arbiter, at least COMDB_MIN_PORTS_ARBITRATED (256) ports
+ * long, grown in steps of 1024 up to COMDB_MAX_PORTS_ARBITRATED (4096). Each access holds a named mutex
+ * ("the database is protected by mutual exclusion during any continuous database access"); the database
+ * is read and written whole on every call, so other processes' claims are seen at once. Opening it needs
+ * write access to the key: administrators. */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "msports.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msports);
+
+#define COMDB_KEY L"System\\CurrentControlSet\\Control\\COM Name Arbiter"
+#define COMDB_VALUE L"ComDB"
+#define COMDB_MUTEX L"Global\\ComPortDatabaseMutex"
+
+struct comdb
+{
+    struct list entry;
+    HKEY   key;
+    HANDLE mutex;
+};
+
+/* the handles this process opened: a handle is checked against them */
+static struct list comdbs = LIST_INIT( comdbs );
+static CRITICAL_SECTION comdb_cs;
+static CRITICAL_SECTION_DEBUG comdb_cs_debug =
+{
+    0, 0, &comdb_cs,
+    { &comdb_cs_debug.ProcessLocksList, &comdb_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": comdb_cs") }
+};
+static CRITICAL_SECTION comdb_cs = { &comdb_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct comdb *get_comdb( HCOMDB handle )
+{
+    struct comdb *db, *ret = NULL;
+
+    EnterCriticalSection( &comdb_cs );
+    LIST_FOR_EACH_ENTRY( db, &comdbs, struct comdb, entry )
+        if ((HCOMDB)db == handle) { ret = db; break; }
+    LeaveCriticalSection( &comdb_cs );
+    return ret;
+}
+
+/* read the bit array under the mutex; *ports is the number of port numbers it arbitrates */
+static LONG comdb_lock_read( struct comdb *db, BYTE **bits, DWORD *ports )
+{
+    DWORD type, size = 0;
+    LONG ret;
+
+    WaitForSingleObject( db->mutex, INFINITE );
+    *bits = NULL;
+    ret = RegQueryValueExW( db->key, COMDB_VALUE, NULL, &type, NULL, &size );
+    if (ret == ERROR_FILE_NOT_FOUND || (!ret && (type != REG_BINARY || !size)))
+        size = 0;
+    else if (ret)
+        goto fail;
+    if (size < COMDB_MIN_PORTS_ARBITRATED / 8) size = COMDB_MIN_PORTS_ARBITRATED / 8;
+    if (size > COMDB_MAX_PORTS_ARBITRATED / 8) size = COMDB_MAX_PORTS_ARBITRATED / 8;
+    if (!(*bits = calloc( 1, size ))) { ret = ERROR_NOT_ENOUGH_MEMORY; goto fail; }
+    {
+        DWORD got = size;
+        if (RegQueryValueExW( db->key, COMDB_VALUE, NULL, &type, *bits, &got ) == ERROR_MORE_DATA)
+        {
+            BYTE *all = malloc( got );
+            if (all && !RegQueryValueExW( db->key, COMDB_VALUE, NULL, &type, all, &got ))
+                memcpy( *bits, all, size );
+            free( all );
+        }
+        else if (type != REG_BINARY) memset( *bits, 0, size );
+    }
+    *ports = size * 8;
+    return ERROR_SUCCESS;
+
+fail:
+    ReleaseMutex( db->mutex );
+    return ret;
+}
+
+static LONG comdb_write_unlock( struct comdb *db, BYTE *bits, DWORD ports )
+{
+    LONG ret = ERROR_SUCCESS;
+    if (bits) ret = RegSetValueExW( db->key, COMDB_VALUE, 0, REG_BINARY, bits, ports / 8 );
+    free( bits );
+    ReleaseMutex( db->mutex );
+    return ret;
+}
+
+static void comdb_unlock( struct comdb *db, BYTE *bits )
+{
+    free( bits );
+    ReleaseMutex( db->mutex );
+}
+
+/***********************************************************************
+ *      ComDBOpen   (MSPORTS.@)
+ */
+LONG WINAPI ComDBOpen( HCOMDB *handle )
+{
+    struct comdb *db;
+    LONG ret;
+
+    TRACE( "%p\n", handle );
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    *handle = HCOMDB_INVALID_HANDLE_VALUE;
+    if (!(db = calloc( 1, sizeof(*db) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if ((ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, COMDB_KEY, 0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE,
+                                NULL, &db->key, NULL )))
+    {
+        free( db );
+        return ret;
+    }
+    if (!(db->mutex = CreateMutexW( NULL, FALSE, COMDB_MUTEX )))
+    {
+        ret = GetLastError();
+        RegCloseKey( db->key );
+        free( db );
+        return ret;
+    }
+    EnterCriticalSection( &comdb_cs );
+    list_add_tail( &comdbs, &db->entry );
+    LeaveCriticalSection( &comdb_cs );
+    *handle = (HCOMDB)db;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *      ComDBClose   (MSPORTS.@)
+ */
+LONG WINAPI ComDBClose( HCOMDB handle )
+{
+    struct comdb *db = get_comdb( handle );
+
+    TRACE( "%p\n", handle );
+
+    if (!db) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &comdb_cs );
+    list_remove( &db->entry );
+    LeaveCriticalSection( &comdb_cs );
+    RegCloseKey( db->key );
+    CloseHandle( db->mutex );
+    free( db );
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *      ComDBGetCurrentPortUsage   (MSPORTS.@)
+ *
+ * Without a buffer: the number of port numbers in the database. With one: as many of them as fit, as bits
+ * (CDB_REPORT_BITS, eight per byte) or bytes (CDB_REPORT_BYTES, 1 for a port in use), and how many.
+ */
+LONG WINAPI ComDBGetCurrentPortUsage( HCOMDB handle, BYTE *buffer, DWORD size, ULONG type, DWORD *reported )
+{
+    struct comdb *db = get_comdb( handle );
+    DWORD ports, i, n;
+    BYTE *bits;
+    LONG ret;
+
+    TRACE( "%p %p %lu %lu %p\n", handle, buffer, size, type, reported );
+
+    if (!db) return ERROR_INVALID_PARAMETER;
+    if (type != CDB_REPORT_BITS && type != CDB_REPORT_BYTES) return ERROR_INVALID_PARAMETER;
+    if (!buffer && !reported) return ERROR_INVALID_PARAMETER;
+    if ((ret = comdb_lock_read( db, &bits, &ports ))) return ret;
+    if (!buffer)
+    {
+        *reported = ports;
+        comdb_unlock( db, bits );
+        return ERROR_SUCCESS;
+    }
+    if (type == CDB_REPORT_BITS)
+    {
+        n = min( size, ports / 8 );
+        memcpy( buffer, bits, n );
+        n *= 8;
+    }
+    else
+    {
+        n = min( size, ports );
+        for (i = 0; i < n; i++) buffer[i] = (bits[i / 8] >> (i % 8)) & 1;
+    }
+    if (reported) *reported = n;
+    comdb_unlock( db, bits );
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *      ComDBClaimNextFreePort   (MSPORTS.@)
+ */
+LONG WINAPI ComDBClaimNextFreePort( HCOMDB handle, DWORD *number )
+{
+    struct comdb *db = get_comdb( handle );
+    DWORD ports, i;
+    BYTE *bits;
+    LONG ret;
+
+    TRACE( "%p %p\n", handle, number );
+
+    if (!db || !number) return ERROR_INVALID_PARAMETER;
+    if ((ret = comdb_lock_read( db, &bits, &ports ))) return ret;
+    for (i = 0; i < ports; i++) if (!(bits[i / 8] & (1 << (i % 8)))) break;
+    if (i == ports)
+    {
+        comdb_unlock( db, bits );
+        return ERROR_NO_LOG_SPACE;
+    }
+#ifndef SG_MUTANT_NO_COMDB_CLAIM
+    bits[i / 8] |= 1 << (i % 8);
+#endif
+    if (!(ret = comdb_write_unlock( db, bits, ports ))) *number = i + 1;
+    return ret;
+}
+
+/***********************************************************************
+ *      ComDBClaimPort   (MSPORTS.@)
+ *
+ * A port number in use is claimed only with ForceClaim (and *Forced says so); otherwise
+ * ERROR_SHARING_VIOLATION.
+ */
+LONG WINAPI ComDBClaimPort( HCOMDB handle, DWORD number, BOOL force, BOOL *forced )
+{
+    struct comdb *db = get_comdb( handle );
+    DWORD ports, i = number - 1;
+    BYTE *bits;
+    LONG ret;
+
+    TRACE( "%p %lu %d %p\n", handle, number, force, forced );
+
+    if (forced) *forced = FALSE;
+    if (!db || !number || number > COMDB_MAX_PORTS_ARBITRATED) return ERROR_INVALID_PARAMETER;
+    if ((ret = comdb_lock_read( db, &bits, &ports ))) return ret;
+    if (number > ports)
+    {
+        comdb_unlock( db, bits );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (bits[i / 8] & (1 << (i % 8)))
+    {
+        comdb_unlock( db, bits );
+        if (!force) return ERROR_SHARING_VIOLATION;
+        if (forced) *forced = TRUE;
+        return ERROR_SUCCESS;
+    }
+    bits[i / 8] |= 1 << (i % 8);
+    return comdb_write_unlock( db, bits, ports );
+}
+
+/***********************************************************************
+ *      ComDBReleasePort   (MSPORTS.@)
+ */
+LONG WINAPI ComDBReleasePort( HCOMDB handle, DWORD number )
+{
+    struct comdb *db = get_comdb( handle );
+    DWORD ports, i = number - 1;
+    BYTE *bits;
+    LONG ret;
+
+    TRACE( "%p %lu\n", handle, number );
+
+    if (!db || !number || number > COMDB_MAX_PORTS_ARBITRATED) return ERROR_INVALID_PARAMETER;
+    if ((ret = comdb_lock_read( db, &bits, &ports ))) return ret;
+    if (number > ports)
+    {
+        comdb_unlock( db, bits );
+        return ERROR_INVALID_PARAMETER;
+    }
+    bits[i / 8] &= ~(1 << (i % 8));
+    return comdb_write_unlock( db, bits, ports );
+}
+
+/***********************************************************************
+ *      ComDBResizeDatabase   (MSPORTS.@)
+ *
+ * The database only grows, in multiples of 1024 port numbers, to COMDB_MAX_PORTS_ARBITRATED at most;
+ * a size not larger than the current one is ERROR_BAD_LENGTH.
+ */
+LONG WINAPI ComDBResizeDatabase( HCOMDB handle, DWORD new_size )
+{
+    struct comdb *db = get_comdb( handle );
+    DWORD ports;
+    BYTE *bits, *grown;
+    LONG ret;
+
+    TRACE( "%p %lu\n", handle, new_size );
+
+    if (!db) return ERROR_INVALID_PARAMETER;
+    if (new_size % 1024 || new_size > COMDB_MAX_PORTS_ARBITRATED) return ERROR_BAD_LENGTH;
+    if ((ret = comdb_lock_read( db, &bits, &ports ))) return ret;
+    if (new_size <= ports)
+    {
+        comdb_unlock( db, bits );
+        return ERROR_BAD_LENGTH;
+    }
+    if (!(grown = calloc( 1, new_size / 8 )))
+    {
+        comdb_unlock( db, bits );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    memcpy( grown, bits, ports / 8 );
+    free( bits );
+    return comdb_write_unlock( db, grown, new_size );
+}
