From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winepulse, mmdevapi: Programs hear the default output change (9419)

Windows tells programs when the person picks another default output or
input (IMMNotificationClient::OnDefaultDeviceChanged, for every role, with
the default device's ID); players, games and voice chat follow it there.
Wine told them only when its own registry default changed (winecfg), never
when the sound server's did.

winepulse watches the server's default sink and source, and the
session_volume_wait call reports their changes; mmdevapi tells the
registered notification clients, unless winecfg set Wine's default apart.
The watch starts with RegisterEndpointNotificationCallback too, starting
the driver's main loop and connection (with the program's name, as its
streams have it), so a program with no stream yet is told.
---
--- a/dlls/mmdevapi/unixlib.h
+++ b/dlls/mmdevapi/unixlib.h
@@ -231,8 +231,16 @@
     float level;
     BOOL mute;
     HRESULT result;
+    /* wine-sg 9419: what happened (SESSION_EVENT_*), and the program's name for the
+     * sound server when the wait has to connect to it first */
+    UINT32 kind;
+    WCHAR name[64];
 };
 
+#define SESSION_EVENT_VOLUME          0
+#define SESSION_EVENT_DEFAULT_RENDER  1   /* the sound server's default output changed */
+#define SESSION_EVENT_DEFAULT_CAPTURE 2   /* its default input */
+
 struct set_event_handle_params
 {
     stream_handle stream;
--- a/dlls/mmdevapi/session.c
+++ b/dlls/mmdevapi/session.c
@@ -175,18 +175,37 @@
         notify_simple_volume(found, &GUID_NULL);
 }
 
+extern WCHAR *get_application_name(void);
+extern void notify_default_device_changed(EDataFlow flow);
+extern HRESULT main_loop_start(void);
+
 static DWORD WINAPI session_volume_thread(void *arg)
 {
     struct session_volume_wait_params params;
+    WCHAR *name = get_application_name();
 
     SetThreadDescription(GetCurrentThread(), L"wine_mmdevapi_session_volume");
+    /* the driver's main loop, which a program with no stream yet has not started
+     * (under the sessions lock, as IAudioClient::Initialize starts it) */
+    sessions_lock();
+    main_loop_start();
+    sessions_unlock();
     for (;;)
     {
+        memset(&params, 0, sizeof(params));
+        if (name) lstrcpynW(params.name, name, ARRAY_SIZE(params.name));
         params.result = E_NOTIMPL;
         if (__wine_unix_call(drvs.module_unixlib, session_volume_wait, &params) || params.result != S_OK)
             break;
-        session_external_volume(params.stream, params.level, params.mute);
+        /* wine-sg 9419: the sound server's default output or input changed */
+        if (params.kind == SESSION_EVENT_DEFAULT_RENDER)
+            notify_default_device_changed(eRender);
+        else if (params.kind == SESSION_EVENT_DEFAULT_CAPTURE)
+            notify_default_device_changed(eCapture);
+        else
+            session_external_volume(params.stream, params.level, params.mute);
     }
+    free(name);
     return 0;
 }
 
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -1154,6 +1154,36 @@
         notify_clients(flow, eMultimedia, id);
 }
 
+/* Stained Glass OS (wine-sg 9419): the sound server's default output or input
+ * changed (the person chose another in the volume flyout or Settings): Windows
+ * tells programs (IMMNotificationClient::OnDefaultDeviceChanged, every role, with
+ * the default device's ID), unless Wine's own default was set apart (winecfg's
+ * DefaultOutput/DefaultInput), which the sound server's change does not move */
+void notify_default_device_changed(EDataFlow flow)
+{
+    WCHAR reg_key[256], value[64];
+    IMMDevice *def;
+    WCHAR *id = NULL;
+    DWORD size = sizeof(value);
+
+    lstrcpyW(reg_key, drv_keyW);
+    lstrcatW(reg_key, L"\\");
+    lstrcatW(reg_key, drvs.module_name);
+    if (!RegGetValueW(HKEY_CURRENT_USER, reg_key, flow == eRender ? L"DefaultOutput" : L"DefaultInput",
+            RRF_RT_REG_SZ, NULL, value, &size) && value[0])
+        return;
+
+    EnterCriticalSection(&g_notif_lock);
+    def = flow == eRender ? &MMDevice_def_play->IMMDevice_iface : &MMDevice_def_rec->IMMDevice_iface;
+    if (def && FAILED(IMMDevice_GetId(def, &id)))
+        id = NULL;
+    TRACE("flow %d, default %s\n", flow, debugstr_w(id));
+    notify_clients(flow, eConsole, id);    /* and eMultimedia */
+    notify_clients(flow, eCommunications, id);
+    CoTaskMemFree(id);
+    LeaveCriticalSection(&g_notif_lock);
+}
+
 static BOOL notify_if_changed(EDataFlow flow, ERole role, HKEY key,
                               const WCHAR *val_name, WCHAR *old_val, IMMDevice *def_dev)
 {
@@ -1308,6 +1338,9 @@
 
     LeaveCriticalSection(&g_notif_lock);
 
+    /* wine-sg 9419: the sound server's default device changes reach it too */
+    session_volume_watch();
+
     return S_OK;
 }
 
--- a/dlls/mmdevapi/mmdevapi_private.h
+++ b/dlls/mmdevapi/mmdevapi_private.h
@@ -79,6 +79,7 @@
 extern void main_loop_stop(void);
 
 extern const WCHAR drv_keyW[];
+extern void session_volume_watch(void);
 
 extern HRESULT get_audio_sessions(IMMDevice *device, GUID **ret, int *ret_count);
 
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -131,6 +131,11 @@
 static pthread_cond_t volume_cond = PTHREAD_COND_INITIALIZER;
 static BOOL volume_quit;
 
+/* wine-sg 9419: the sound server's default output and input, to tell programs when
+ * they change (IMMNotificationClient::OnDefaultDeviceChanged) */
+static char *default_sink_name, *default_source_name;
+static BOOL default_known, default_render_changed, default_capture_changed;
+
 static ULONG_PTR zero_bits = 0;
 
 static NTSTATUS pulse_not_implemented(void *args)
@@ -488,10 +493,45 @@
     pthread_cond_broadcast(&volume_cond);
 }
 
+static void pulse_server_info_cb(pa_context *c, const pa_server_info *info, void *user)
+{
+    const char *sink, *source;
+
+    if (!info)
+        return;
+    sink = info->default_sink_name ? info->default_sink_name : "";
+    source = info->default_source_name ? info->default_source_name : "";
+    if (default_known)
+    {
+        if (strcmp(sink, default_sink_name ? default_sink_name : ""))
+            default_render_changed = TRUE;
+        if (strcmp(source, default_source_name ? default_source_name : ""))
+            default_capture_changed = TRUE;
+        if (default_render_changed || default_capture_changed)
+        {
+            TRACE("default output %s, input %s\n", debugstr_a(sink), debugstr_a(source));
+            pthread_cond_broadcast(&volume_cond);
+        }
+    }
+    free(default_sink_name);
+    free(default_source_name);
+    default_sink_name = strdup(sink);
+    default_source_name = strdup(source);
+    default_known = TRUE;
+}
+
 static void pulse_subscribe_cb(pa_context *c, pa_subscription_event_type_t t, uint32_t index, void *user)
 {
     pa_operation *o;
 
+#ifndef SG_MUTANT_PULSE_NO_DEFAULT_NOTIFY
+    if ((t & PA_SUBSCRIPTION_EVENT_FACILITY_MASK) == PA_SUBSCRIPTION_EVENT_SERVER)
+    {
+        if ((o = pa_context_get_server_info(c, pulse_server_info_cb, NULL)))
+            pa_operation_unref(o);
+        return;
+    }
+#endif
     if ((t & PA_SUBSCRIPTION_EVENT_FACILITY_MASK) != PA_SUBSCRIPTION_EVENT_SINK_INPUT
             || (t & PA_SUBSCRIPTION_EVENT_TYPE_MASK) != PA_SUBSCRIPTION_EVENT_CHANGE
             || !volume_stream_by_sink_input(index))
@@ -537,7 +577,10 @@
         pa_operation *o;
 
         pa_context_set_subscribe_callback(pulse_ctx, pulse_subscribe_cb, NULL);
-        if ((o = pa_context_subscribe(pulse_ctx, PA_SUBSCRIPTION_MASK_SINK_INPUT, NULL, NULL)))
+        if ((o = pa_context_subscribe(pulse_ctx, PA_SUBSCRIPTION_MASK_SINK_INPUT | PA_SUBSCRIPTION_MASK_SERVER, NULL, NULL)))
+            pa_operation_unref(o);
+        default_known = FALSE;
+        if ((o = pa_context_get_server_info(pulse_ctx, pulse_server_info_cb, NULL)))
             pa_operation_unref(o);
     }
 #endif
@@ -2640,12 +2683,32 @@
     struct pulse_stream *stream;
 
     pulse_lock();
+    /* a program listening for default device changes may have no stream yet: the
+     * connection (with the program's name, as its streams will have it) */
+    if (pulse_ml && (!pulse_ctx || !PA_CONTEXT_IS_GOOD(pa_context_get_state(pulse_ctx))))
+    {
+        char *name;
+        params->name[ARRAY_SIZE(params->name) - 1] = 0;
+        name = wstr_to_str(params->name);
+        pulse_connect(name);
+        free(name);
+    }
     for (;;)
     {
+        if (default_render_changed || default_capture_changed)
+        {
+            params->kind = default_render_changed ? SESSION_EVENT_DEFAULT_RENDER : SESSION_EVENT_DEFAULT_CAPTURE;
+            if (default_render_changed) default_render_changed = FALSE;
+            else default_capture_changed = FALSE;
+            params->result = S_OK;
+            pulse_unlock();
+            return STATUS_SUCCESS;
+        }
         LIST_FOR_EACH_ENTRY(stream, &g_volume_streams, struct pulse_stream, volume_entry)
         {
             if (!stream->volume_pending) continue;
             stream->volume_pending = FALSE;
+            params->kind = SESSION_EVENT_VOLUME;
             params->stream = (stream_handle)(UINT_PTR)stream;
             params->level = stream->want_level;
             params->mute = stream->want_mute;
