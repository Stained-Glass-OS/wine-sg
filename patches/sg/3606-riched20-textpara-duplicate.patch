--- a/dlls/riched20/para.c
+++ b/dlls/riched20/para.c
@@ -459,13 +459,13 @@ static void para_num_clear_list( ME_TextEditor *editor, ME_Paragraph *para, cons
     } while (para_num_same_list( &para->fmt, orig_fmt ));
 }
 
-static BOOL para_set_fmt( ME_TextEditor *editor, ME_Paragraph *para, const PARAFORMAT2 *pFmt )
+/* Stained Glass OS: the part of para_set_fmt that changes a paragraph format,
+ * also used for a paragraph format that belongs to no paragraph (ITextPara
+ * duplicates) */
+BOOL para_fmt_merge( PARAFORMAT2 *fmt, const PARAFORMAT2 *pFmt )
 {
-  PARAFORMAT2 copy;
-  DWORD dwMask;
+  DWORD dwMask = pFmt->dwMask;
 
-  assert(para->fmt.cbSize == sizeof(PARAFORMAT2));
-  dwMask = pFmt->dwMask;
   if (pFmt->cbSize < sizeof(PARAFORMAT))
     return FALSE;
   else if (pFmt->cbSize < sizeof(PARAFORMAT2))
@@ -473,28 +473,24 @@ static BOOL para_set_fmt( ME_TextEditor *editor, ME_Paragraph *para, const PARAF
   else
     dwMask &= PFM_ALL2;
 
-  add_undo_set_para_fmt( editor, para );
-
-  copy = para->fmt;
-
 #define COPY_FIELD(m, f) \
   if (dwMask & (m)) {                           \
-    para->fmt.dwMask |= m;                      \
-    para->fmt.f = pFmt->f;                      \
+    fmt->dwMask |= m;                      \
+    fmt->f = pFmt->f;                      \
   }
 
   COPY_FIELD(PFM_NUMBERING, wNumbering);
   COPY_FIELD(PFM_STARTINDENT, dxStartIndent);
   if (dwMask & PFM_OFFSETINDENT)
-    para->fmt.dxStartIndent += pFmt->dxStartIndent;
+    fmt->dxStartIndent += pFmt->dxStartIndent;
   COPY_FIELD(PFM_RIGHTINDENT, dxRightIndent);
   COPY_FIELD(PFM_OFFSET, dxOffset);
   COPY_FIELD(PFM_ALIGNMENT, wAlignment);
   if (dwMask & PFM_TABSTOPS)
   {
     /* Clamp between 0 and MAX_TAB_STOPS */
-    para->fmt.cTabCount = max(0, min(pFmt->cTabCount, MAX_TAB_STOPS));
-    memcpy(para->fmt.rgxTabs, pFmt->rgxTabs, para->fmt.cTabCount * sizeof(LONG));
+    fmt->cTabCount = max(0, min(pFmt->cTabCount, MAX_TAB_STOPS));
+    memcpy(fmt->rgxTabs, pFmt->rgxTabs, fmt->cTabCount * sizeof(LONG));
   }
 
 #define EFFECTS_MASK (PFM_RTLPARA|PFM_KEEP|PFM_KEEPNEXT|PFM_PAGEBREAKBEFORE| \
@@ -503,9 +499,9 @@ static BOOL para_set_fmt( ME_TextEditor *editor, ME_Paragraph *para, const PARAF
   /* we take for granted that PFE_xxx is the hiword of the corresponding PFM_xxx */
   if (dwMask & EFFECTS_MASK)
   {
-    para->fmt.dwMask |= dwMask & EFFECTS_MASK;
-    para->fmt.wEffects &= ~HIWORD(dwMask);
-    para->fmt.wEffects |= pFmt->wEffects & HIWORD(dwMask);
+    fmt->dwMask |= dwMask & EFFECTS_MASK;
+    fmt->wEffects &= ~HIWORD(dwMask);
+    fmt->wEffects |= pFmt->wEffects & HIWORD(dwMask);
   }
 #undef EFFECTS_MASK
 
@@ -523,9 +519,30 @@ static BOOL para_set_fmt( ME_TextEditor *editor, ME_Paragraph *para, const PARAF
   COPY_FIELD(PFM_BORDER, wBorderWidth);
   COPY_FIELD(PFM_BORDER, wBorders);
 
-  para->fmt.dwMask |= dwMask;
+  fmt->dwMask |= dwMask;
 #undef COPY_FIELD
+  return TRUE;
+}
+
+static BOOL para_set_fmt( ME_TextEditor *editor, ME_Paragraph *para, const PARAFORMAT2 *pFmt )
+{
+  PARAFORMAT2 copy;
+  DWORD dwMask;
+
+  assert(para->fmt.cbSize == sizeof(PARAFORMAT2));
+  dwMask = pFmt->dwMask;
+  if (pFmt->cbSize < sizeof(PARAFORMAT))
+    return FALSE;
+  else if (pFmt->cbSize < sizeof(PARAFORMAT2))
+    dwMask &= PFM_ALL;
+  else
+    dwMask &= PFM_ALL2;
+
+  add_undo_set_para_fmt( editor, para );
+
+  copy = para->fmt;
 
+  para_fmt_merge( &para->fmt, pFmt );
   if (memcmp(&copy, &para->fmt, sizeof(PARAFORMAT2)))
   {
     para_mark_rewrap( editor, para );
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index ddce98e..900bb7d 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -232,7 +232,8 @@ typedef struct ITextParaImpl {
     ITextPara ITextPara_iface;
     LONG ref;
 
-    ITextRange *range;
+    ITextRange *range;   /* NULL for a duplicate: it then keeps its own format in fmt */
+    PARAFORMAT2 fmt;
 } ITextParaImpl;
 
 struct IOleClientSiteImpl {
@@ -4112,6 +4113,11 @@ static HRESULT textpara_get_fmt(ITextParaImpl *para, PARAFORMAT2 *fmt)
     ME_Cursor saved[2], from, to;
     LONG start, end;
 
+    if (!para->range)
+    {
+        *fmt = para->fmt;
+        return S_OK;
+    }
     if (!(services = get_range_reole(para->range))) return CO_E_RELEASED;
 
     memset(fmt, 0, sizeof(*fmt));
@@ -4136,6 +4142,11 @@ static HRESULT textpara_set_fmt(ITextParaImpl *para, const PARAFORMAT2 *fmt)
     ME_Cursor saved[2], from, to;
     LONG start, end;
 
+    if (!para->range)
+    {
+        para_fmt_merge( &para->fmt, fmt );
+        return S_OK;
+    }
     if (!(services = get_range_reole(para->range))) return CO_E_RELEASED;
 
     ITextRange_GetStart(para->range, &start);
@@ -4422,7 +4433,7 @@ static ULONG WINAPI TextPara_Release(ITextPara *iface)
 
     if (!ref)
     {
-        ITextRange_Release(This->range);
+        if (This->range) ITextRange_Release(This->range);
         free(This);
     }
 
@@ -4492,39 +4503,125 @@ static HRESULT WINAPI TextPara_Invoke(
     return hr;
 }
 
+static HRESULT create_textpara_duplicate(const PARAFORMAT2 *fmt, ITextPara **ret);
+
+static ITextParaVtbl textparavtbl;
+
+static BOOL is_our_textpara(ITextPara *para)
+{
+    return para->lpVtbl == &textparavtbl;
+}
+
 static HRESULT WINAPI TextPara_GetDuplicate(ITextPara *iface, ITextPara **ret)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%p)\n", This, ret);
-    return E_NOTIMPL;
+    PARAFORMAT2 fmt;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if (!ret) return E_INVALIDARG;
+    *ret = NULL;
+    if (FAILED(hr = textpara_get_fmt( This, &fmt ))) return hr;
+#ifdef SG_MUTANT_PARADUP_SHARED
+    if (This->range) return create_textpara( This->range, ret );
+#endif
+    return create_textpara_duplicate( &fmt, ret );
 }
 
 static HRESULT WINAPI TextPara_SetDuplicate(ITextPara *iface, ITextPara *para)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%p)\n", This, para);
-    return E_NOTIMPL;
+    PARAFORMAT2 fmt;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, para);
+
+    if (!para) return E_INVALIDARG;
+    if (!is_our_textpara( para ))
+    {
+        FIXME("(%p)->(%p): formats of other ITextPara implementations\n", This, para);
+        return E_NOTIMPL;
+    }
+    if (FAILED(hr = textpara_get_fmt( impl_from_ITextPara( para ), &fmt ))) return hr;
+    fmt.dwMask &= ~PFM_OFFSETINDENT;
+    return textpara_set_fmt( This, &fmt );
 }
 
 static HRESULT WINAPI TextPara_CanChange(ITextPara *iface, LONG *ret)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%p)\n", This, ret);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ret);
+
+    if (!ret) return E_INVALIDARG;
+    if (!This->range)
+    {
+        *ret = tomTrue;
+        return S_OK;
+    }
+    return ITextRange_CanEdit( This->range, ret );
 }
 
 static HRESULT WINAPI TextPara_IsEqual(ITextPara *iface, ITextPara *para, LONG *ret)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%p %p)\n", This, para, ret);
-    return E_NOTIMPL;
+    PARAFORMAT2 a, b;
+    LONG v;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p %p)\n", This, para, ret);
+
+    if (!ret) ret = &v;
+    *ret = tomFalse;
+    if (!para) return S_FALSE;
+    if (!is_our_textpara( para ))
+    {
+        FIXME("(%p)->(%p %p): other ITextPara implementations\n", This, para, ret);
+        return S_FALSE;
+    }
+    if (FAILED(hr = textpara_get_fmt( This, &a ))) return hr;
+    if (FAILED(hr = textpara_get_fmt( impl_from_ITextPara( para ), &b ))) return hr;
+
+    /* the same values for everything that is defined in either of them */
+    if (a.dwMask == b.dwMask && a.wNumbering == b.wNumbering && a.dxStartIndent == b.dxStartIndent &&
+        a.dxRightIndent == b.dxRightIndent && a.dxOffset == b.dxOffset && a.wAlignment == b.wAlignment &&
+        a.cTabCount == b.cTabCount && !memcmp( a.rgxTabs, b.rgxTabs, a.cTabCount * sizeof(a.rgxTabs[0]) ) &&
+        a.wEffects == b.wEffects && a.dySpaceBefore == b.dySpaceBefore && a.dySpaceAfter == b.dySpaceAfter &&
+        a.dyLineSpacing == b.dyLineSpacing && a.sStyle == b.sStyle && a.bLineSpacingRule == b.bLineSpacingRule &&
+        a.wNumberingStart == b.wNumberingStart && a.wNumberingStyle == b.wNumberingStyle &&
+        a.wNumberingTab == b.wNumberingTab)
+        *ret = tomTrue;
+#ifdef SG_MUTANT_PARADUP_ISEQUAL_TRUE
+    *ret = tomTrue;
+#endif
+    return *ret == tomTrue ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI TextPara_Reset(ITextPara *iface, LONG value)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%ld)\n", This, value);
-    return E_NOTIMPL;
+    PARAFORMAT2 fmt;
+
+    TRACE("(%p)->(%ld)\n", This, value);
+
+    if (value != tomDefault)
+    {
+        FIXME("(%p)->(%ld): reset mode not supported\n", This, value);
+        return E_NOTIMPL;
+    }
+
+    /* the paragraph format of a new paragraph (editor_set_default_para_fmt without a host's alignment) */
+    memset( &fmt, 0, sizeof(fmt) );
+    fmt.cbSize = sizeof(fmt);
+    fmt.dwMask = PFM_ALL2 & ~PFM_OFFSETINDENT;
+    fmt.wAlignment = PFA_LEFT;
+    fmt.sStyle = -1;
+    fmt.bOutlineLevel = TRUE;
+#ifdef SG_MUTANT_PARADUP_RESET_NONE
+    return S_OK;
+#endif
+    return textpara_set_fmt( This, &fmt );
 }
 
 static HRESULT WINAPI TextPara_GetStyle(ITextPara *iface, LONG *value)
@@ -5010,6 +5107,21 @@ static HRESULT create_textpara(ITextRange *range, ITextPara **ret)
     return S_OK;
 }
 
+static HRESULT create_textpara_duplicate(const PARAFORMAT2 *fmt, ITextPara **ret)
+{
+    ITextParaImpl *para;
+
+    *ret = NULL;
+    if (!(para = calloc(1, sizeof(*para)))) return E_OUTOFMEMORY;
+
+    para->ITextPara_iface.lpVtbl = &textparavtbl;
+    para->ref = 1;
+    para->fmt = *fmt;
+
+    *ret = &para->ITextPara_iface;
+    return S_OK;
+}
+
 /* ITextDocument */
 static HRESULT WINAPI ITextDocument2Old_fnQueryInterface(ITextDocument2Old* iface, REFIID riid,
                                                          void **ppvObject)
