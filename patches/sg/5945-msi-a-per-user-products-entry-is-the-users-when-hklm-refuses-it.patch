From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: a per-user product's Apps & features entry is the user's when HKLM refuses it (5945)

msi: a per-user product's Apps & features entry is the user's when HKLM refuses it

Windows keeps even a per-user product's Apps & features entry under
HKLM\...\Uninstall, written there by the Installer service as SYSTEM.
Wine's msi runs as the installing user, whom the machine keys of a shared
prefix (3764) refuse it: RegisterProduct failed with ERROR_ACCESS_DENIED
(Python 3.13's per-user packages, after 5944). A user may not write an entry
every user sees (an administrator's Uninstall would run the user's command),
so a per-user product the user may not register in HKLM now gets its entry
in the user's own HKCU\...\Uninstall, which Apps & features and the SG Store
read as well; it is found there and removed from there too. A machine
product, or one the user may register in HKLM, is as before. Gate
test-msiperuser; mutant SG_MUTANT_MSI_NO_USER_ARP.
---
--- a/dlls/msi/registry.c
+++ b/dlls/msi/registry.c
@@ -319,10 +319,20 @@
     return res;
 }
 
-UINT MSIREG_OpenUninstallKey(const WCHAR *product, enum platform platform, HKEY *key, BOOL create)
+/* Stained Glass OS: a product's Apps & features entry. Windows keeps even a per-user ("just for me")
+ * product's under HKLM, written there by the Installer service as SYSTEM; Wine's msi runs as the
+ * installing user, whom the machine keys of a shared prefix (3764) refuse it -- Python 3.13 from the
+ * SG Store failed with ERROR_ACCESS_DENIED at RegisterProduct. A user may not write an entry everyone
+ * sees (an administrator's Uninstall would run the user's command), so a per-user product the user
+ * may not register there gets its entry in the user's own HKCU\...\Uninstall, where Apps & features
+ * and the SG Store look as well. A machine product, or one the user may register in HKLM, is as
+ * before. */
+UINT MSIREG_OpenUninstallKey(const WCHAR *product, enum platform platform, MSIINSTALLCONTEXT context,
+                             HKEY *key, BOOL create)
 {
     REGSAM access = KEY_ALL_ACCESS;
     WCHAR keypath[0x200];
+    UINT r;
 
     TRACE("%s\n", debugstr_w(product));
 
@@ -332,26 +342,51 @@
         access |= KEY_WOW64_64KEY;
     lstrcpyW(keypath, L"Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\");
     lstrcatW(keypath, product);
-    if (create) return RegCreateKeyExW(HKEY_LOCAL_MACHINE, keypath, 0, NULL, 0, access, NULL, key, NULL);
-    return msi_reg_open_key(HKEY_LOCAL_MACHINE, keypath, 0, access, key);
+    if (create)
+    {
+        r = RegCreateKeyExW(HKEY_LOCAL_MACHINE, keypath, 0, NULL, 0, access, NULL, key, NULL);
+#ifndef SG_MUTANT_MSI_NO_USER_ARP
+        if (r == ERROR_ACCESS_DENIED && context != MSIINSTALLCONTEXT_MACHINE)
+        {
+            TRACE("not in HKLM: the user's own entry\n");
+            r = RegCreateKeyExW(HKEY_CURRENT_USER, keypath, 0, NULL, 0, access, NULL, key, NULL);
+        }
+#endif
+        return r;
+    }
+    r = msi_reg_open_key(HKEY_LOCAL_MACHINE, keypath, 0, access, key);
+    if (r == ERROR_FILE_NOT_FOUND && context != MSIINSTALLCONTEXT_MACHINE)
+        r = RegOpenKeyExW(HKEY_CURRENT_USER, keypath, 0, access, key);
+    return r;
 }
 
-UINT MSIREG_DeleteUninstallKey(const WCHAR *product, enum platform platform)
+static UINT delete_uninstall_key(HKEY root, const WCHAR *product, REGSAM access)
 {
-    REGSAM access = KEY_ALL_ACCESS;
     HKEY parent;
     LONG r;
 
+    if ((r = msi_reg_open_key(root, L"Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\",
+                              0, access, &parent))) return r;
+    r = RegDeleteTreeW(parent, product);
+    RegCloseKey(parent);
+    return r;
+}
+
+UINT MSIREG_DeleteUninstallKey(const WCHAR *product, enum platform platform, MSIINSTALLCONTEXT context)
+{
+    REGSAM access = KEY_ALL_ACCESS;
+    UINT r;
+
     TRACE("%s\n", debugstr_w(product));
 
     if (platform == PLATFORM_INTEL)
         access |= KEY_WOW64_32KEY;
     else
         access |= KEY_WOW64_64KEY;
-    if ((r = msi_reg_open_key(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\",
-                           0, access, &parent))) return r;
-    r = RegDeleteTreeW(parent, product);
-    RegCloseKey(parent);
+    r = delete_uninstall_key(HKEY_LOCAL_MACHINE, product, access);
+    /* the user's own entry (MSIREG_OpenUninstallKey) */
+    if (context != MSIINSTALLCONTEXT_MACHINE && !delete_uninstall_key(HKEY_CURRENT_USER, product, access))
+        r = ERROR_SUCCESS;
     return r;
 }
 
--- a/dlls/msi/action.c
+++ b/dlls/msi/action.c
@@ -5130,7 +5130,7 @@
     if (!msi_get_property_int( package->db, L"ProductToBeRegistered", 0 ) && !check_publish(package))
         return ERROR_SUCCESS;
 
-    rc = MSIREG_OpenUninstallKey(package->ProductCode, package->platform, &hkey, TRUE);
+    rc = MSIREG_OpenUninstallKey(package->ProductCode, package->platform, package->Context, &hkey, TRUE);
     if (rc != ERROR_SUCCESS)
         return rc;
 
@@ -5257,7 +5257,7 @@
 
     MSIREG_DeleteProductKey(package->ProductCode);
     MSIREG_DeleteUserDataProductKey(package->ProductCode, package->Context);
-    MSIREG_DeleteUninstallKey(package->ProductCode, package->platform);
+    MSIREG_DeleteUninstallKey(package->ProductCode, package->platform, package->Context);
 
     MSIREG_DeleteLocalClassesProductKey(package->ProductCode);
     MSIREG_DeleteLocalClassesFeaturesKey(package->ProductCode);
--- a/dlls/msi/package.c
+++ b/dlls/msi/package.c
@@ -467,7 +467,7 @@
 
     if (!package->ProductCode) return ERROR_FUNCTION_FAILED;
 
-    r = MSIREG_OpenUninstallKey( package->ProductCode, package->platform, &hkey, FALSE );
+    r = MSIREG_OpenUninstallKey( package->ProductCode, package->platform, package->Context, &hkey, FALSE );
     if (r == ERROR_SUCCESS)
     {
         RegCloseKey( hkey );
--- a/dlls/msi/msipriv.h
+++ b/dlls/msi/msipriv.h
@@ -962,8 +962,8 @@
 extern BOOL squash_guid(LPCWSTR in, LPWSTR out);
 extern BOOL encode_base85_guid(GUID *,LPWSTR);
 extern BOOL decode_base85_guid(LPCWSTR,GUID*);
-extern UINT MSIREG_OpenUninstallKey(const WCHAR *, enum platform, HKEY *, BOOL);
-extern UINT MSIREG_DeleteUninstallKey(const WCHAR *, enum platform);
+extern UINT MSIREG_OpenUninstallKey(const WCHAR *, enum platform, MSIINSTALLCONTEXT, HKEY *, BOOL);
+extern UINT MSIREG_DeleteUninstallKey(const WCHAR *, enum platform, MSIINSTALLCONTEXT);
 extern UINT MSIREG_OpenProductKey(LPCWSTR szProduct, LPCWSTR szUserSid,
                                   MSIINSTALLCONTEXT context, HKEY* key, BOOL create);
 extern UINT MSIREG_OpenFeaturesKey(LPCWSTR szProduct, LPCWSTR szUserSid, MSIINSTALLCONTEXT context,
