+/* Tcpip6\Parameters\Interfaces\{GUID} (9211, i0511): what Windows' DHCPv6 client keeps there --
+ * the identity association's Dhcpv6Iaid, the lease's name servers (Dhcpv6DNSServers, 16-byte
+ * addresses) and search list (Dhcpv6DomainSearchList) -- from NetworkManager's [dhcp6]. Every
+ * adapter has the key, as on Windows; without a lease it holds none of them. */
+static void update_interface6( HKEY interfaces6, const WCHAR *guid, const struct nsi_dhcp4_info *info )
+{
+    static const WCHAR *const lease6_values[] = { L"Dhcpv6Iaid", L"Dhcpv6DNSServers", L"Dhcpv6DomainSearchList", NULL };
+    HKEY key;
+
+    if (!(key = create_key( interfaces6, guid ))) return;
+    if (!info->dhcp6)
+    {
+        delete_values( key, lease6_values );
+        RegCloseKey( key );
+        return;
+    }
+    if (info->have_iaid) set_dword( key, L"Dhcpv6Iaid", info->iaid );
+    else RegDeleteValueW( key, L"Dhcpv6Iaid" );
+    if (info->dns6_count) set_value( key, L"Dhcpv6DNSServers", REG_BINARY, info->dns6, info->dns6_count * 16 );
+    else RegDeleteValueW( key, L"Dhcpv6DNSServers" );
+    if (info->search6[0])
+    {
+        WCHAR buf[256], *p;
+
+        MultiByteToWideChar( CP_UTF8, 0, info->search6, -1, buf, ARRAY_SIZE(buf) );
+        buf[ARRAY_SIZE(buf) - 1] = 0;
+        for (p = buf; *p; p++) if (*p == ' ' || *p == '\t') *p = ',';
+        set_sz( key, L"Dhcpv6DomainSearchList", buf );
+    }
+    else RegDeleteValueW( key, L"Dhcpv6DomainSearchList" );
+    RegCloseKey( key );
+}
+
