+/* "00:01:00:01:..." (or without the colons): the bytes, at most MAX; their number */
+static UINT parse_hex_bytes( const char *text, BYTE *out, UINT max )
+{
+    UINT n = 0;
+
+    while (*text && n < max)
+    {
+        char pair[3];
+
+        if (*text == ':' || *text == '-' || *text == ' ') { text++; continue; }
+        if (!isxdigit( (unsigned char)text[0] ) || !isxdigit( (unsigned char)text[1] )) return 0;
+        pair[0] = text[0]; pair[1] = text[1]; pair[2] = 0;
+        out[n++] = strtoul( pair, NULL, 16 );
+        text += 2;
+    }
+    return n;
+}
+
+/* an IAID as NetworkManager writes it: 0x7b2e9964, 7b:2e:99:64, or decimal */
+static BOOL parse_iaid( const char *text, UINT *iaid )
+{
+    BYTE b[4];
+    char *end;
+
+    if (strchr( text, ':' ))
+    {
+        if (parse_hex_bytes( text, b, 4 ) != 4) return FALSE;
+        *iaid = (b[0] << 24) | (b[1] << 16) | (b[2] << 8) | b[3];
+        return TRUE;
+    }
+    *iaid = strtoul( text, &end, (text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) ? 16 : 10 );
+    return end != text && !*end;
+}
+
+/* one line of NetworkManager's [dhcp6]: the lease's name servers, search list, DUID and IAID */
+static void read_nm_dhcp6_option( const char *name, char *value, struct nsi_dhcp4_info *info )
+{
+    char *tok, *save = NULL;
+
+    if (!strncmp( name, "dhcp6.", 6 )) name += 6;
+    if (!strcmp( name, "dhcp6_name_servers" ))
+    {
+        for (tok = strtok_r( value, " ,\t", &save ); tok; tok = strtok_r( NULL, " ,\t", &save ))
+        {
+            struct in6_addr a;
+            UINT i;
+
+            if (info->dns6_count >= ARRAY_SIZE(info->dns6) || inet_pton( AF_INET6, tok, &a ) != 1) continue;
+            for (i = 0; i < info->dns6_count; i++) if (!memcmp( info->dns6[i], &a, 16 )) break;
+            if (i == info->dns6_count) memcpy( info->dns6[info->dns6_count++], &a, 16 );
+        }
+    }
+    else if (!strcmp( name, "dhcp6_domain_search" )) copy_str( info->search6, value, sizeof(info->search6) );
+    else if (!strcmp( name, "dhcp6_client_id" )) info->duid_len = parse_hex_bytes( value, info->duid, sizeof(info->duid) );
+    else if (!strcmp( name, "iaid" )) info->have_iaid = parse_iaid( value, &info->iaid );
+}
+
