From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:53:29 -0700
Subject: [PATCH] tbs: argument checks and TBS_E_TPM_NOT_FOUND without a TPM
 (3237)

Tbsi_Context_Create and Tbsi_GetDeviceInfo now validate their arguments as
the documented error tables say (NULL params, NULL output pointer, unknown
context version, too-small device-info buffer) and report
TBS_E_TPM_NOT_FOUND, as a computer without a TPM does, without a FIXME.
No TPM is exposed to programs. CORE review: security.

diff --git a/dlls/tbs/tbs.c b/dlls/tbs/tbs.c
index 986a3c4..233aeef 100644
--- a/dlls/tbs/tbs.c
+++ b/dlls/tbs/tbs.c
@@ -24,15 +24,39 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(tbs);
 
+#define TBS_CONTEXT_VERSION_ONE 1
+#define TBS_CONTEXT_VERSION_TWO 2
+
+/* There is no TPM on this system and no TBS service: report what the TBS
+ * client library reports on a computer without a TPM, after the argument
+ * checks that do not depend on the device. */
 TBS_RESULT WINAPI Tbsi_Context_Create(const TBS_CONTEXT_PARAMS *params, TBS_HCONTEXT *out)
 {
-    FIXME("(%p, %p) stub\n", params, out);
+    TRACE("(%p, %p)\n", params, out);
+
+#ifdef SG_MUTANT_TBS_NOARGS
+    if (!out) return TBS_E_TPM_NOT_FOUND;
+#endif
+    if (!params) return TBS_E_BAD_PARAMETER;
+    if (!out) return TBS_E_INVALID_OUTPUT_POINTER;
+    *out = NULL;
+    if (params->version != TBS_CONTEXT_VERSION_ONE && params->version != TBS_CONTEXT_VERSION_TWO)
+        return TBS_E_INVALID_CONTEXT_PARAM;
+    WARN("no TPM present\n");
+#ifdef SG_MUTANT_TBS_FAKE
+    *out = (TBS_HCONTEXT)1;
+    return 0;
+#endif
     return TBS_E_TPM_NOT_FOUND;
 }
 
 TBS_RESULT WINAPI Tbsi_GetDeviceInfo(UINT32 size, void *info)
 {
-    FIXME("(%u, %p) stub\n", size, info);
+    TRACE("(%u, %p)\n", size, info);
+
+    /* TPM_DEVICE_INFO: four 32-bit values */
+    if (!info || size < 4 * sizeof(UINT32)) return TBS_E_BAD_PARAMETER;
+    WARN("no TPM present\n");
     return TBS_E_TPM_NOT_FOUND;
 }
 
