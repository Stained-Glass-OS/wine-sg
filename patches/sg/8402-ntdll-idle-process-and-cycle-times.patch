From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: SystemProcessInformation lists the System Idle Process and cycle times

Windows lists process 0, the System Idle Process, first in SystemProcessInformation (so
EnumProcesses, toolhelp and WTSEnumerateProcesses have it): no name, a thread per processor,
the processors' idle time as its kernel time and their idle cycles as its cycle time. Every
process's CycleTime is its CPU time in TSC cycles. Wine had neither; cycle-based CPU usage
(System Informer, Process Explorer: each process's share of the sum of all processes' cycle
deltas, the idle one included) came out as 100% total or negative (-1604%).

The idle entry comes first; each process's CycleTime is its kernel + user time in cycles,
the measure ProcessCycleTime already gives.
---
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2922,6 +2922,46 @@
     else WARN( "can't open /dev/urandom\n" );
 }
 
+/* Stained Glass OS (wine-sg 8402): the System Idle Process, process id 0, which Windows lists
+ * first in SystemProcessInformation (and so EnumProcesses, toolhelp and WTSEnumerateProcesses
+ * have it): no name, one thread per processor, the processors' idle time as its kernel time and
+ * their idle cycles as its cycle time. With every process's CycleTime it is what cycle-based CPU
+ * usage is computed from (System Informer, Process Explorer: the share of each process's cycles
+ * in the sum over all processes, the idle one included); without them System Informer showed
+ * the total as 100% or a negative percentage (-1604%). */
+static ULONG sg_idle_process_len( ULONG thread_info_size )
+{
+#ifdef SG_MUTANT_NO_IDLE_PROCESS
+    return 0;
+#endif
+    return sizeof(SYSTEM_PROCESS_INFORMATION) + peb->NumberOfProcessors * thread_info_size;
+}
+
+static void sg_fill_idle_process( void *info, ULONG thread_info_size, BOOL more )
+{
+    SYSTEM_PROCESS_INFORMATION *idle = info;
+    ULONG64 *cycles, frequency = get_tsc_frequency(), total = 0;
+    unsigned int i, cpus = peb->NumberOfProcessors;
+
+    memset( idle, 0, sg_idle_process_len( thread_info_size ));
+    if (more) idle->NextEntryOffset = sg_idle_process_len( thread_info_size );
+    idle->dwThreadCount = cpus;
+    if (!(cycles = calloc( cpus, sizeof(*cycles) ))) return;
+    get_cpu_idle_cycle_times( cycles );
+    for (i = 0; i < cpus; i++)
+    {
+        SYSTEM_THREAD_INFORMATION *ti = (SYSTEM_THREAD_INFORMATION *)((BYTE *)idle->ti + i * thread_info_size);
+        ULONG64 time = frequency ? cycles[i] / frequency * 10000000 + cycles[i] % frequency * 10000000 / frequency : 0;
+
+        ti->KernelTime.QuadPart = time;
+        ti->dwThreadState = 2;  /* running */
+        idle->KernelTime.QuadPart += time;
+        total += cycles[i];
+    }
+    idle->CycleTime = total;
+    free( cycles );
+}
+
 static unsigned int get_system_process_info( SYSTEM_INFORMATION_CLASS class, void *info, ULONG size, ULONG *len )
 {
     unsigned int process_count, total_thread_count, total_name_len, i, j;
@@ -2956,12 +2996,19 @@
         if (ret == STATUS_INFO_LENGTH_MISMATCH)
             *len = sizeof(SYSTEM_PROCESS_INFORMATION) * process_count
                   + (total_name_len + process_count) * sizeof(WCHAR)
-                  + total_thread_count * thread_info_size;
+                  + total_thread_count * thread_info_size
+                  + sg_idle_process_len( thread_info_size );
 
         free( buffer );
         return ret;
     }
 
+#ifndef SG_MUTANT_NO_IDLE_PROCESS
+    /* Stained Glass OS (wine-sg 8402): the System Idle Process first, as Windows lists it */
+    *len = sg_idle_process_len( thread_info_size );
+    if (*len <= size) sg_fill_idle_process( info, thread_info_size, process_count != 0 );
+#endif
+
     for (i = 0; i < process_count; i++)
     {
         SYSTEM_PROCESS_INFORMATION *nt_process = (SYSTEM_PROCESS_INFORMATION *)((char *)info + *len);
@@ -3000,6 +3047,10 @@
             nt_process->SessionId = server_process->session_id;
             nt_process->HandleCount = server_process->handle_count;
             get_thread_times( server_process->unix_pid, -1, &nt_process->KernelTime, &nt_process->UserTime );
+#ifndef SG_MUTANT_NO_PROCESS_CYCLES
+            /* its CPU time as TSC cycles, as ProcessCycleTime gives it (8402) */
+            nt_process->CycleTime = cycles_from_ns( (nt_process->KernelTime.QuadPart + nt_process->UserTime.QuadPart) * 100 );
+#endif
             fill_vm_counters( &nt_process->vmCounters, server_process->unix_pid );
         }
 
