From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: a printer added to CUPS during a session reaches Windows programs

The desktop keeps winspool loaded (0609), so Windows' printers were made
from CUPS's once a session, by the first program, and every later program
found that done. A printer added to CUPS afterwards -- a DYMO LabelWriter
plugged in, whose queue sg-session makes then -- reached no Windows program
(DYMO Connect: "No label printer found") before the next sign-in.

The CUPS server's printers now carry a stamp, cheap for every process: the
modification times of printers.conf and of the ppd directory in CUPS's
ServerRoot (CUPS_SERVERROOT, else /etc/cups) -- asking cupsd itself costs
tens to hundreds of milliseconds a process. The stamp the printers were
last made from is kept per user (HKCU\Software\Wine\Printing\CupsStamp);
when CUPS's differs, the next program to load winspool makes them again,
under the same lock, once.

Test: test/cupsrefresh-gate.sh with test/wmiprinter-probe.c -- a CUPS
server of the gate's own, winspool held loaded as the desktop holds it, a
queue added with lpadmin, listed in a new program, 64- and 32-bit (mutant
SG_MUTANT_CUPSREFRESH).
---
--- a/dlls/winspool.drv/cups.c
+++ b/dlls/winspool.drv/cups.c
@@ -34,6 +34,7 @@
 #include <errno.h>
 #include <signal.h>
 #include <sys/wait.h>
+#include <sys/stat.h>
 #ifdef HAVE_CUPS_CUPS_H
 #include <cups/cups.h>
 #endif
@@ -432,12 +433,38 @@
 #endif
 }
 
+/* Stained Glass OS: a stamp of the CUPS server's printers, cheap enough for
+ * every process: the modification times of its printers.conf (written when a
+ * queue is added, changed or deleted, within cupsd's dirty-clean interval)
+ * and of its ppd directory (written at once when a queue with a PPD is
+ * added), in CUPS's ServerRoot (CUPS_SERVERROOT, else /etc/cups). Asking
+ * cupsd itself costs tens to hundreds of milliseconds a process. */
+static NTSTATUS get_printers_stamp( void *args )
+{
+    const struct get_printers_stamp_params *params = args;
+    const char *root = getenv( "CUPS_SERVERROOT" );
+    char path[4096];
+    struct stat st;
+    ULONGLONG stamp = 0;
+
+    if (!root || !*root) root = "/etc/cups";
+    snprintf( path, sizeof(path), "%s/printers.conf", root );
+    if (!stat( path, &st ))
+        stamp += (ULONGLONG)st.st_mtim.tv_sec * 1000000000 + st.st_mtim.tv_nsec + st.st_size;
+    snprintf( path, sizeof(path), "%s/ppd", root );
+    if (!stat( path, &st ))
+        stamp = stamp * 31 + (ULONGLONG)st.st_mtim.tv_sec * 1000000000 + st.st_mtim.tv_nsec;
+    *params->stamp = stamp;
+    return STATUS_SUCCESS;
+}
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     process_attach,
     enum_printers,
     get_default_page_size,
     get_ppd,
+    get_printers_stamp,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
@@ -526,12 +553,24 @@
     return get_ppd( &params );
 }
 
+static NTSTATUS wow64_get_printers_stamp( void *args )
+{
+    struct
+    {
+        PTR32 stamp;
+    } const *params32 = args;
+    struct get_printers_stamp_params params = { ULongToPtr( params32->stamp ) };
+
+    return get_printers_stamp( &params );
+}
+
 const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
 {
     process_attach,
     wow64_enum_printers,
     wow64_get_default_page_size,
     wow64_get_ppd,
+    wow64_get_printers_stamp,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -1109,11 +1109,41 @@
 
 static HANDLE init_mutex;
 
+/* Stained Glass OS: the stamp of CUPS's printers this user's Windows printers
+ * were last made from (HKCU\Software\Wine\Printing\CupsStamp). */
+static ULONGLONG cups_printers_stamp( void )
+{
+    ULONGLONG stamp = 0;
+    struct get_printers_stamp_params params = { &stamp };
+
+    if (UNIX_CALL( get_printers_stamp, &params )) return 0;
+    return stamp;
+}
+
+static ULONGLONG get_seen_stamp( void )
+{
+    ULONGLONG stamp = 0;
+    DWORD size = sizeof(stamp);
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Wine\\Printing", L"CupsStamp", RRF_RT_REG_QWORD, NULL, &stamp, &size );
+    return stamp;
+}
+
+static void set_seen_stamp( ULONGLONG stamp )
+{
+    HKEY key;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, L"Software\\Wine\\Printing", 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )) return;
+    RegSetValueExW( key, L"CupsStamp", 0, REG_QWORD, (BYTE *)&stamp, sizeof(stamp) );
+    RegCloseKey( key );
+}
+
 void WINSPOOL_LoadSystemPrinters(void)
 {
     HKEY printers_key, printer_key;
     DWORD               needed, num, i;
     WCHAR               PrinterName[256];
+    ULONGLONG           stamp;
 
     /* FIXME: The init code should be moved to spoolsv.exe */
     init_mutex = CreateMutexW( NULL, TRUE, L"__WINE_WINSPOOL_MUTEX__" );
@@ -1125,6 +1155,22 @@
     if (GetLastError() == ERROR_ALREADY_EXISTS)
     {
         WaitForSingleObject( init_mutex, INFINITE );
+#ifndef SG_MUTANT_CUPSREFRESH
+        /* Stained Glass OS: the desktop keeps winspool loaded (0609), so the
+         * printers were made from CUPS's once a session and a printer
+         * plugged in later (sg-session makes its queue then) reached no
+         * Windows program before the next sign-in. When CUPS's printers
+         * changed since, they are made again, once, by the next program. */
+        stamp = cups_printers_stamp();
+        if (stamp && stamp != get_seen_stamp())
+        {
+            TRACE( "CUPS printers changed, loading them again\n" );
+            old_printer_check( FALSE );
+            init_unix_printers();
+            old_printer_check( TRUE );
+            set_seen_stamp( stamp );
+        }
+#endif
         ReleaseMutex( init_mutex );
         TRACE( "Init already done\n" );
         return;
@@ -1147,9 +1193,11 @@
         RegCloseKey( printers_key );
     }
 
+    stamp = cups_printers_stamp();
     old_printer_check( FALSE );
     init_unix_printers();
     old_printer_check( TRUE );
+    set_seen_stamp( stamp );
 
     ReleaseMutex( init_mutex );
     return;
--- a/dlls/winspool.drv/wspool.h
+++ b/dlls/winspool.drv/wspool.h
@@ -65,6 +65,12 @@
     const WCHAR *ppd;
 };
 
+/* Stained Glass OS: when CUPS's printers last changed, 0 when unknown */
+struct get_printers_stamp_params
+{
+    ULONGLONG *stamp;
+};
+
 #define UNIX_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
 enum cups_funcs
@@ -73,5 +79,6 @@
     unix_enum_printers,
     unix_get_default_page_size,
     unix_get_ppd,
+    unix_get_printers_stamp,
     unix_funcs_count,
 };
