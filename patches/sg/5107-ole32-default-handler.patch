From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ole32: default handler GetDataHere, GetRunningClass, Update (patch 5107)

GetDataHere reaches the object, Update runs it, GetRunningClass gives the class;
gap-CORE items 493, 869, 987. Gate with three mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ole32/defaulthandler.c b/dlls/ole32/defaulthandler.c
--- a/dlls/ole32/defaulthandler.c
+++ b/dlls/ole32/defaulthandler.c
@@ -713,6 +713,8 @@
     return hr;
 }
 
+static HRESULT WINAPI DefaultHandler_Run(IRunnableObject *iface, IBindCtx *pbc);
+
 static HRESULT WINAPI DefaultHandler_Update(
 	    IOleObject*        iface)
 {
@@ -723,8 +725,12 @@
 
     if (!object_is_running(This))
     {
-        FIXME("Should run object\n");
+        /* the object has to run to bring its caches up to date, and fails the way running it fails */
+#ifdef SG_MUTANT_HANDLER_UPDATE
         return E_NOTIMPL;
+#endif
+        hr = DefaultHandler_Run(&This->IRunnableObject_iface, NULL);
+        if (FAILED(hr)) return hr;
     }
 
     start_object_call( This );
@@ -1138,13 +1144,47 @@
   return hres;
 }
 
+/************************************************************************
+ * DefaultHandler_GetDataHere
+ *
+ * Like GetData, but the caller allocated the medium: the cache is asked
+ * first, then the object if it is running.
+ */
 static HRESULT WINAPI DefaultHandler_GetDataHere(
 	    IDataObject*     iface,
 	    LPFORMATETC      pformatetc,
 	    STGMEDIUM*       pmedium)
 {
-  FIXME(": Stub\n");
-  return E_NOTIMPL;
+  IDataObject* cacheDataObject = NULL;
+  HRESULT      hres;
+
+  DefaultHandler *This = impl_from_IDataObject(iface);
+
+  TRACE("(%p, %p, %p)\n", iface, pformatetc, pmedium);
+
+  hres = IUnknown_QueryInterface(This->dataCache, &IID_IDataObject, (void**)&cacheDataObject);
+  if (FAILED(hres))
+    return E_UNEXPECTED;
+
+  hres = IDataObject_GetDataHere(cacheDataObject, pformatetc, pmedium);
+  IDataObject_Release(cacheDataObject);
+  if (hres == S_OK) return hres;
+
+#ifndef SG_MUTANT_HANDLER_GETDATAHERE
+  if (object_is_running( This ))
+  {
+    start_object_call(This);
+    hres = IDataObject_GetDataHere(This->pDataDelegate, pformatetc, pmedium);
+    end_object_call(This);
+    if (hres == S_OK) return hres;
+  }
+#endif
+
+  /* Query running state again, as the object may have closed during the call */
+  if (!object_is_running( This ))
+    hres = OLE_E_NOTRUNNING;
+
+  return hres;
 }
 
 /************************************************************************
@@ -1433,7 +1473,16 @@
             IRunnableObject*     iface,
 	    LPCLSID              lpClsid)
 {
-  FIXME("()\n");
+  DefaultHandler *This = impl_from_IRunnableObject(iface);
+
+  TRACE("(%p)\n", lpClsid);
+
+  if (!lpClsid) return E_INVALIDARG;
+#ifdef SG_MUTANT_HANDLER_CLASS
+  return S_OK;
+#endif
+  /* the class this handler stands for (the emulated one after CoTreatAsClass) */
+  *lpClsid = This->clsid;
   return S_OK;
 }
 
@@ -1542,8 +1591,16 @@
 	    BOOL                 fLock,
 	    BOOL                 fLastUnlockCloses)
 {
-  FIXME("()\n");
+  DefaultHandler *This = impl_from_IRunnableObject(iface);
+
+  TRACE("(%d, %d)\n", fLock, fLastUnlockCloses);
+
+  /* "Most implementations of IRunnableObject::LockRunning call CoLockObjectExternal": the object
+   * the container holds is kept alive by an external connection until it is unlocked */
+#ifdef SG_MUTANT_HANDLER_LOCK
   return S_OK;
+#endif
+  return CoLockObjectExternal(This->outerUnknown, fLock, fLastUnlockCloses);
 }
 
 /************************************************************************
@@ -1555,7 +1612,10 @@
             IRunnableObject*     iface,
 	    BOOL                 fContained)
 {
-  FIXME("()\n");
+  /* The call makes the container's reference weak, which matters for what keeps a running object
+   * alive across processes (CoLockObjectExternal, see LockRunning); a handler that is not running has
+   * nothing to weaken and answers S_OK (ole32/tests/ole2.c checks it). */
+  TRACE("(%d)\n", fContained);
   return S_OK;
 }
 
diff --git a/dlls/ole32/tests/ole2.c b/dlls/ole32/tests/ole2.c
--- a/dlls/ole32/tests/ole2.c
+++ b/dlls/ole32/tests/ole2.c
@@ -2913,7 +2913,6 @@
     ok(hr == E_FAIL, "IOleObject_GetMoniker should have returned E_FAIL instead of 0x%08lx\n", hr);
 
     hr = IOleObject_Update(pObject);
-    todo_wine
     ok(hr == REGDB_E_CLASSNOTREG, "IOleObject_Update should have returned REGDB_E_CLASSNOTREG instead of 0x%08lx\n", hr);
 
     hr = IOleObject_QueryInterface(pObject, &IID_IDataObject, (void **)&pDataObject);
