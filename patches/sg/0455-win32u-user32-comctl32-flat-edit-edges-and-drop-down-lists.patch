From: Stained Glass OS contributors
Subject: win32u, user32, comctl32: edit boxes' edges and drop-down lists as Windows 10 draws them

A client edge (edit boxes, lists: WS_EX_CLIENTEDGE) and a combo box's border
were Windows 95's sunken 3D edge, and a drop-down list's button a raised
grey button with a black triangle. They are the same two pixels now drawn
flat -- a line of the shadow colour, then one of the window colour -- and
the drop button is flat with a chevron. With 0454's buttons, Setup's first
page (three drop-down lists and Next) no longer looks like Windows 95.

Gate: test/flatbuttons-gate.sh (make test-flatbuttons).
---
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1962,7 +1962,22 @@
     TRACE( "rect after menu %s\n", wine_dbgstr_rect( &rect ));
 
     if (ex_style & WS_EX_CLIENTEDGE)
-        draw_rect_edge( hdc, &rect, EDGE_SUNKEN, BF_RECT | BF_ADJUST, 1 );
+    {
+        /* Stained Glass OS: a client edge as Windows 10 draws an edit box's
+         * or a list's -- one line of the shadow colour, then one of the window
+         * colour (the same two pixels as the sunken 3D edge it was) */
+        HBRUSH brushes[2] = { get_sys_color_brush( COLOR_BTNSHADOW ), get_sys_color_brush( COLOR_WINDOW ) };
+        RECT r;
+        int i;
+        for (i = 0; i < 2; i++)
+        {
+            r = rect; r.bottom = r.top + 1; fill_rect( hdc, &r, brushes[i] );
+            r = rect; r.top = r.bottom - 1; fill_rect( hdc, &r, brushes[i] );
+            r = rect; r.right = r.left + 1; fill_rect( hdc, &r, brushes[i] );
+            r = rect; r.left = r.right - 1; fill_rect( hdc, &r, brushes[i] );
+            InflateRect( &rect, -1, -1 );
+        }
+    }
 
     /* Draw the scroll-bars */
     draw_nc_scrollbar( hwnd, hdc, style & WS_HSCROLL, style & WS_VSCROLL );
--- a/dlls/user32/combo.c
+++ b/dlls/user32/combo.c
@@ -565,13 +565,27 @@
       return;
 
 
-    if (lphc->wState & CBF_BUTTONDOWN)
-	buttonState |= DFCS_PUSHED;
-
-    if (CB_DISABLED(lphc))
-	buttonState |= DFCS_INACTIVE;
-
-    DrawFrameControl(hdc, &lphc->buttonRect, DFC_SCROLL, buttonState);
+    /* Stained Glass OS: a flat drop button with a chevron, as Windows 10
+     * draws it, not a raised 3D button with a black triangle */
+    {
+        RECT r = lphc->buttonRect;
+        COLORREF ink = GetSysColor( CB_DISABLED(lphc) ? COLOR_GRAYTEXT : COLOR_BTNTEXT );
+        HBRUSH fill = GetSysColorBrush( (lphc->wState & CBF_BUTTONDOWN) ? COLOR_BTNFACE : COLOR_WINDOW );
+        HPEN pen = CreatePen( PS_SOLID, 1, ink ), old;
+        int cx = (r.left + r.right) / 2, cy = (r.top + r.bottom) / 2, w = 4, i;
+
+        (void)buttonState;
+        FillRect( hdc, &r, fill );
+        old = SelectObject( hdc, pen );
+        for (i = 0; i < 2; i++)   /* two rows: a chevron of some weight */
+        {
+            MoveToEx( hdc, cx - w, cy - 2 + i, NULL );
+            LineTo( hdc, cx, cy + 2 + i );
+            LineTo( hdc, cx + w + 1, cy - 3 + i );
+        }
+        SelectObject( hdc, old );
+        DeleteObject( pen );
+    }
 }
 
 /***********************************************************************
@@ -759,7 +773,11 @@
     InflateRect(&clientRect, COMBO_XBORDERSIZE(), COMBO_YBORDERSIZE());
   }
 
-  DrawEdge(hdc, &clientRect, EDGE_SUNKEN, BF_RECT);
+  /* Stained Glass OS: one line of the shadow colour, then one of the
+   * window colour -- the two pixels of the sunken edge it was, flat */
+  FrameRect(hdc, &clientRect, GetSysColorBrush(COLOR_BTNSHADOW));
+  InflateRect(&clientRect, -1, -1);
+  FrameRect(hdc, &clientRect, GetSysColorBrush(COLOR_WINDOW));
 }
 
