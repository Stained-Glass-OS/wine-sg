-
-    DrawFrameControl(hdc, &lphc->buttonRect, DFC_SCROLL, buttonState);
+    /* Stained Glass OS: a flat drop button with a chevron, as Windows 10
+     * draws it, not a raised 3D button with a black triangle */
+    {
+        RECT r = lphc->buttonRect;
+        COLORREF ink = GetSysColor( CB_DISABLED(lphc) ? COLOR_GRAYTEXT : COLOR_BTNTEXT );
+        HBRUSH fill = GetSysColorBrush( (lphc->wState & CBF_BUTTONDOWN) ? COLOR_BTNFACE : COLOR_WINDOW );
+        HPEN pen = CreatePen( PS_SOLID, 1, ink ), old;
+        int cx = (r.left + r.right) / 2, cy = (r.top + r.bottom) / 2, w = 4, i;
+
+        (void)buttonState;
+        FillRect( hdc, &r, fill );
+        old = SelectObject( hdc, pen );
+        for (i = 0; i < 2; i++)   /* two rows: a chevron of some weight */
+        {
+            MoveToEx( hdc, cx - w, cy - 2 + i, NULL );
+            LineTo( hdc, cx, cy + 2 + i );
+            LineTo( hdc, cx + w + 1, cy - 3 + i );
+        }
+        SelectObject( hdc, old );
+        DeleteObject( pen );
+    }
 }
 
