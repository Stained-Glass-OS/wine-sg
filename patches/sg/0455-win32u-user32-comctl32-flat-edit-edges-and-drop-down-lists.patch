@@ -752,7 +766,11 @@
     InflateRect(&clientRect, COMBO_XBORDERSIZE(), COMBO_YBORDERSIZE());
   }
 
-  DrawEdge(hdc, &clientRect, EDGE_SUNKEN, BF_RECT);
+  /* Stained Glass OS: one line of the shadow colour, then one of the
+   * window colour -- the two pixels of the sunken edge it was, flat */
+  FrameRect(hdc, &clientRect, GetSysColorBrush(COLOR_BTNSHADOW));
+  InflateRect(&clientRect, -1, -1);
+  FrameRect(hdc, &clientRect, GetSysColorBrush(COLOR_WINDOW));
