+/* the driver's paper for a Linux job: "[P<id>][:<width>x<height>]", the
+ * paper the job chose (a PPD PageSize) and the document's page in points.
+ * The page wins: a paper of its size, turned when the page is (a label laid
+ * out across), the chosen one first among papers of that size; a page no
+ * paper fits prints on the chosen paper. */
+static void choose_paper( const WCHAR *name, const WCHAR *paper, DEVMODEW *dm )
+{
+    int count = DeviceCapabilitiesW( name, NULL, DC_PAPERS, NULL, NULL ), i, best = -1;
+    const WCHAR *size = paper ? wcschr( paper, ':' ) : NULL;  /* the page's size */
+    WORD chosen = 0, *ids;
+    POINT *sizes;
+    double pw = 0, ph = 0;
+    BOOL turn = FALSE;
+
+    if (paper && paper[0] == 'P' && iswdigit( paper[1] )) chosen = wcstoul( paper + 1, NULL, 10 );
+    if (chosen)
+    {
+        dm->dmFields = (dm->dmFields & ~DM_FORMNAME) | DM_PAPERSIZE;
+        dm->dmPaperSize = chosen;
+    }
+    if (size) size++;
+    else if (paper && iswdigit( paper[0] )) size = paper;
+    if (!size || swscanf( size, L"%lfx%lf", &pw, &ph ) != 2 || pw <= 0 || ph <= 0 || count <= 0) return;
+#ifndef SG_MUTANT_PAGEPAPER
+    ids = calloc( count, sizeof(*ids) );
+    sizes = calloc( count, sizeof(*sizes) );
+    DeviceCapabilitiesW( name, NULL, DC_PAPERS, (WCHAR *)ids, NULL );
+    DeviceCapabilitiesW( name, NULL, DC_PAPERSIZE, (WCHAR *)sizes, NULL );
+    pw *= 254 / 72.0;  /* tenths of a millimetre */
+    ph *= 254 / 72.0;
+    for (i = 0; i < count; i++)
+    {
+        /* within 2 mm, as a PDF's points round a label's size */
+        BOOL upright = fabs( sizes[i].x - pw ) <= 20 && fabs( sizes[i].y - ph ) <= 20;
+        BOOL across = fabs( sizes[i].x - ph ) <= 20 && fabs( sizes[i].y - pw ) <= 20;
+        if (!upright && !across) continue;
+        if (best < 0 || ids[i] == chosen)
+        {
+            best = i;
+            turn = !upright;
+        }
+    }
+    if (best >= 0)
+    {
+        dm->dmFields = (dm->dmFields & ~DM_FORMNAME) | DM_PAPERSIZE | DM_ORIENTATION;
+        dm->dmPaperSize = ids[best];
+        dm->dmOrientation = turn ? DMORIENT_LANDSCAPE : DMORIENT_PORTRAIT;
+    }
+    free( ids );
+    free( sizes );
+#endif
+}
+
