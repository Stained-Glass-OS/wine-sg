From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: the desktop's children, the views, an element's properties

UI Automation's desktop had no children: a window's provider answered
"unimplemented" for its first and last child and its siblings, so walking
or searching from the root found nothing (Opera's installer looks for the
desktop's icon list so; accessibility and automation tools walk it). A
window's children are now, as Windows has them: for the desktop its
visible unowned top-level windows; for a top-level window its visible
child windows, then the visible windows it owns (whose parent is their
owner, as Navigate(Parent) already said); for a child window its visible
child windows -- in Z order, and siblings in the same order.

The view walkers (raw, control, content) and the content view's condition
were stubs; they are walkers on each view's condition. 43 of an element's
get_Current* getters and GetCurrentPropertyValue were stubs -- a program
reading an element's class name, automation id or state got nothing; the
scalar ones give the providers' value, or the default where none gives it.

Test: test/progman-gate.sh with test/uiadesktop-probe.c (mutants
SG_MUTANT_UIA_NO_CHILDREN, SG_MUTANT_UIA_STUBS).
---
--- a/dlls/uiautomationcore/uia_com_client.c
+++ b/dlls/uiautomationcore/uia_com_client.c
@@ -1997,11 +1997,79 @@
     return S_OK;
 }
 
+/* Stained Glass OS: the element's current properties (43 of the getters
+ * were stubs: a program reading a window's class name, automation id or
+ * state through UI Automation got nothing) -- from the providers, or the
+ * default where none gives the property */
+static HRESULT element_get_value(struct uia_element *element, PROPERTYID prop_id, VARIANT *v)
+{
+    HRESULT hr;
+    IUnknown *not_supported = NULL;
+
+    VariantInit(v);
+#ifdef SG_MUTANT_UIA_STUBS
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = UiaGetPropertyValue(element->node, prop_id, v))) return hr;
+    UiaGetReservedNotSupportedValue(&not_supported);
+    if (V_VT(v) == VT_UNKNOWN && V_UNKNOWN(v) == not_supported)
+    {
+        VariantClear(v);
+        VariantInit(v);
+    }
+    return S_OK;
+}
+
+static HRESULT element_get_bstr(struct uia_element *element, PROPERTYID prop_id, BSTR *ret_val)
+{
+    VARIANT v;
+    HRESULT hr;
+    if (!ret_val) return E_POINTER;
+    *ret_val = NULL;
+    if (FAILED(hr = element_get_value(element, prop_id, &v))) return hr;
+    *ret_val = SysAllocString(V_VT(&v) == VT_BSTR && V_BSTR(&v) ? V_BSTR(&v) : L"");
+    VariantClear(&v);
+    return *ret_val ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT element_get_bool(struct uia_element *element, PROPERTYID prop_id, BOOL *ret_val)
+{
+    VARIANT v;
+    HRESULT hr;
+    if (!ret_val) return E_POINTER;
+    *ret_val = FALSE;
+    if (FAILED(hr = element_get_value(element, prop_id, &v))) return hr;
+    if (V_VT(&v) == VT_BOOL) *ret_val = V_BOOL(&v) != VARIANT_FALSE;
+    VariantClear(&v);
+    return S_OK;
+}
+
+static HRESULT element_get_int(struct uia_element *element, PROPERTYID prop_id, int *ret_val)
+{
+    VARIANT v;
+    HRESULT hr;
+    if (!ret_val) return E_POINTER;
+    *ret_val = 0;
+    if (FAILED(hr = element_get_value(element, prop_id, &v))) return hr;
+    if (V_VT(&v) == VT_I4) *ret_val = V_I4(&v);
+    VariantClear(&v);
+    return S_OK;
+}
+
+static HRESULT element_get_hwnd(struct uia_element *element, PROPERTYID prop_id, UIA_HWND *ret_val)
+{
+    int h = 0;
+    HRESULT hr = element_get_int(element, prop_id, &h);
+    if (ret_val) *ret_val = (UIA_HWND)(LONG_PTR)h;
+    return hr;
+}
+
