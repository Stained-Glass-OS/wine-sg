+/* the content view: the control view's elements that are content elements */
+static HRESULT content_view_condition(IUIAutomationCondition **out)
+{
+    IUIAutomationCondition *control = NULL, *not_content = NULL, *is_content = NULL, *arr[2];
+    HRESULT hr;
+    VARIANT v;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = create_control_view_condition_iface(&control))) return hr;
+    V_VT(&v) = VT_BOOL;
+    V_BOOL(&v) = VARIANT_FALSE;
+    hr = create_uia_property_condition_iface(&not_content, UIA_IsContentElementPropertyId, v, PropertyConditionFlags_None);
+    if (SUCCEEDED(hr)) hr = create_uia_not_condition_iface(&is_content, not_content);
+    if (SUCCEEDED(hr))
+    {
+        arr[0] = control;
+        arr[1] = is_content;
+        hr = create_uia_and_or_condition_iface(out, arr, 2, ConditionType_And);
+    }
+    if (control) IUIAutomationCondition_Release(control);
+    if (not_content) IUIAutomationCondition_Release(not_content);
+    if (is_content) IUIAutomationCondition_Release(is_content);
+    return hr;
+}
