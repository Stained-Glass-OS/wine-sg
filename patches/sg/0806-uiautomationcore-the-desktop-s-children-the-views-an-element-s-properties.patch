+/* Stained Glass OS: the three views' walkers (they were stubs, and a
+ * program that walked the desktop's windows got NULL) -- a walker on each
+ * view's condition */
+static HRESULT content_view_condition(IUIAutomationCondition **out);
+
+static HRESULT walker_on(IUIAutomationTreeWalker **out_walker, HRESULT hr, IUIAutomationCondition *cond)
+{
+    if (!out_walker) { if (cond) IUIAutomationCondition_Release(cond); return E_POINTER; }
+    *out_walker = NULL;
+    if (FAILED(hr)) return hr;
+    hr = create_uia_tree_walker(out_walker, cond);
+    IUIAutomationCondition_Release(cond);
+    return hr;
+}
