+/* Stained Glass OS: a window's UI Automation children, in order -- for
+ * the desktop its visible unowned top-level windows; for a top-level window
+ * its visible child windows, then the visible windows it owns (whose parent
+ * is their owner, as Navigate(Parent) has it); for a child window its
+ * visible child windows. The desktop had no children: walking it found
+ * nothing (Opera's installer looked for its icon list so, 2026-10-04). */
+static int uia_hwnd_children(HWND parent, HWND *out, int max)
+{
+    HWND desktop = GetDesktopWindow(), w;
+    int n = 0;
+
+    for (w = GetWindow(parent, GW_CHILD); w && n < max; w = GetWindow(w, GW_HWNDNEXT))
+    {
+        if (!IsWindowVisible(w)) continue;
+        if (parent == desktop && GetWindow(w, GW_OWNER)) continue;
+        out[n++] = w;
+    }
+    if (parent != desktop && uia_is_top_level_hwnd(parent))
+    {
+        for (w = GetWindow(desktop, GW_CHILD); w && n < max; w = GetWindow(w, GW_HWNDNEXT))
+            if (IsWindowVisible(w) && GetWindow(w, GW_OWNER) == parent) out[n++] = w;
+    }
+    return n;
+}
+
+static HWND uia_hwnd_parent(HWND hwnd)
+{
+    HWND owner;
+    if (uia_is_top_level_hwnd(hwnd) && (owner = GetWindow(hwnd, GW_OWNER))) return owner;
+    return GetAncestor(hwnd, GA_PARENT);
+}
