From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfsrcsnk: Sink factory interfaces delegate to the gstreamer sinks.

The IMFSinkClassFactory of the MP3 and MPEG-4 sink class objects creates
its sink through winegstreamer's factory instead of failing. (MF itself
creates these sinks through IClassFactory::CreateInstance, which already
returned winegstreamer's factory; this closes the remaining stub.)
---
 dlls/mfsrcsnk/media_sink.c | 31 +++++++++++++++++++++++++------
 1 file changed, 25 insertions(+), 6 deletions(-)

diff --git a/dlls/mfsrcsnk/media_sink.c b/dlls/mfsrcsnk/media_sink.c
index 2927859..788b6d0 100644
--- a/dlls/mfsrcsnk/media_sink.c
+++ b/dlls/mfsrcsnk/media_sink.c
@@ -22,11 +22,32 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
 
+static const GUID CLSID_wg_mp3_sink_factory = {0x1f302877,0xaaab,0x40a3,{0xb9,0xe0,0x9f,0x48,0xda,0xf3,0x5b,0xc8}};
+static const GUID CLSID_wg_mpeg4_sink_factory = {0x5d5407d9,0xc6ca,0x4770,{0xa7,0xcc,0x27,0xc0,0xcb,0x8a,0x76,0x27}};
+
+/* The sinks are written by winegstreamer's muxers. */
+static HRESULT create_wg_media_sink(const GUID *clsid, IMFByteStream *bytestream,
+        IMFMediaType *video_type, IMFMediaType *audio_type, IMFMediaSink **out)
+{
+    IMFSinkClassFactory *factory;
+    HRESULT hr;
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+
+    if (FAILED(hr = CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IMFSinkClassFactory, (void **)&factory)))
+        return hr;
+    hr = IMFSinkClassFactory_CreateMediaSink(factory, bytestream, video_type, audio_type, out);
+    IMFSinkClassFactory_Release(factory);
+    return hr;
+}
+
 static HRESULT WINAPI mp3_sink_factory_CreateMediaSink(IMFSinkClassFactory *iface, IMFByteStream *bytestream,
         IMFMediaType *video_type, IMFMediaType *audio_type, IMFMediaSink **out)
 {
-    FIXME("stub!\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %p, %p.\n", iface, bytestream, video_type, audio_type, out);
+    return create_wg_media_sink(&CLSID_wg_mp3_sink_factory, bytestream, video_type, audio_type, out);
 }
 
 static const IMFSinkClassFactoryVtbl mp3_sink_factory_vtbl =
@@ -39,7 +60,6 @@ static const IMFSinkClassFactoryVtbl mp3_sink_factory_vtbl =
 
 static HRESULT WINAPI mp3_sink_class_factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
 {
-    static const GUID CLSID_wg_mp3_sink_factory = {0x1f302877,0xaaab,0x40a3,{0xb9,0xe0,0x9f,0x48,0xda,0xf3,0x5b,0xc8}};
     return CoCreateInstance(&CLSID_wg_mp3_sink_factory, outer, CLSCTX_INPROC_SERVER, riid, out);
 }
 
@@ -63,8 +83,8 @@ IClassFactory *mp3_sink_class_factory = &mp3_sink_factory.IClassFactory_iface;
 static HRESULT WINAPI mpeg4_sink_factory_CreateMediaSink(IMFSinkClassFactory *iface, IMFByteStream *bytestream,
         IMFMediaType *video_type, IMFMediaType *audio_type, IMFMediaSink **out)
 {
-    FIXME("stub!\n");
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %p, %p.\n", iface, bytestream, video_type, audio_type, out);
+    return create_wg_media_sink(&CLSID_wg_mpeg4_sink_factory, bytestream, video_type, audio_type, out);
 }
 
 static const IMFSinkClassFactoryVtbl mpeg4_sink_factory_vtbl =
@@ -77,7 +97,6 @@ static const IMFSinkClassFactoryVtbl mpeg4_sink_factory_vtbl =
 
 static HRESULT WINAPI mpeg4_sink_class_factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
 {
-    static const GUID CLSID_wg_mpeg4_sink_factory = {0x5d5407d9,0xc6ca,0x4770,{0xa7,0xcc,0x27,0xc0,0xcb,0x8a,0x76,0x27}};
     return CoCreateInstance(&CLSID_wg_mpeg4_sink_factory, outer, CLSCTX_INPROC_SERVER, riid, out);
 }
 
