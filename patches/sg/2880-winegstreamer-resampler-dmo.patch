+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+
+void dmo_state_init(struct dmo_state *state)
+{
+    InitializeCriticalSectionEx(&state->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    state->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": dmo_state.cs");
+    state->max_latency = 0;
+}
+
+void dmo_state_destroy(struct dmo_state *state)
+{
+    size_t i;
+
+    for (i = 0; i < state->bag_count; ++i)
+    {
+        free(state->bag[i].name);
+        VariantClear(&state->bag[i].value);
+    }
+    free(state->bag);
+    for (i = 0; i < state->store_count; ++i)
+        PropVariantClear(&state->store[i].value);
+    free(state->store);
+
+    state->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection(&state->cs);
+}
+
+/* Both objects have exactly one input and one output stream. */
+HRESULT dmo_get_stream_count(DWORD *input, DWORD *output)
+{
+    if (!input || !output)
+        return E_POINTER;
+    *input = *output = 1;
+    return S_OK;
+}
+
+HRESULT dmo_get_stream_info(DWORD index, DWORD *flags, DWORD value)
+{
+#ifndef SG_MUTANT_DMO_STREAMIDX
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+#endif
+    if (!flags)
+        return E_POINTER;
+    *flags = value;
+    return S_OK;
+}
+
+HRESULT dmo_get_max_latency(struct dmo_state *state, DWORD index, REFERENCE_TIME *latency)
+{
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+    if (!latency)
+        return E_POINTER;
+    EnterCriticalSection(&state->cs);
+    *latency = state->max_latency;
+    LeaveCriticalSection(&state->cs);
+    return S_OK;
+}
+
+HRESULT dmo_set_max_latency(struct dmo_state *state, DWORD index, REFERENCE_TIME latency)
+{
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+    EnterCriticalSection(&state->cs);
+#ifndef SG_MUTANT_DMO_LATENCY
+    state->max_latency = latency;
+#endif
+    LeaveCriticalSection(&state->cs);
+    return S_OK;
+}
+
+/* IMediaObject::Lock takes the object's mutex until it is called again with
+ * FALSE; every other DMO call made from another thread waits for it. */
+HRESULT dmo_lock(struct dmo_state *state, LONG lock)
+{
+#ifdef SG_MUTANT_DMO_LOCK
+    return S_OK;
+#endif
+    if (lock)
+        EnterCriticalSection(&state->cs);
+    else if (state->cs.RecursionCount && state->cs.OwningThread == ULongToHandle(GetCurrentThreadId()))
+        LeaveCriticalSection(&state->cs);
+    return S_OK;
+}
+
+/* The transforms allocate what they need when the types are set, and free it
+ * with the object: there is nothing to do for an explicit request. */
+HRESULT dmo_streaming_resources(void)
+{
+    return S_OK;
+}
+
+static HRESULT mf_to_dmo_error(HRESULT hr)
+{
+    if (hr == MF_E_TRANSFORM_TYPE_NOT_SET)
+        return DMO_E_TYPE_NOT_SET;
+    if (hr == MF_E_NOTACCEPTING)
+        return DMO_E_NOTACCEPTING;
+    return hr;
+}
+
+static BOOL has_item(IMFMediaType *type, const GUID *key)
+{
+    return SUCCEEDED(IMFMediaType_GetItem(type, key, NULL));
+}
+
+static UINT32 get_uint32(IMFMediaType *type, const GUID *key)
+{
+    UINT32 value = 0;
+    IMFMediaType_GetUINT32(type, key, &value);
+    return value;
+}
+
+/* The types the transforms advertise before a format is chosen only have a
+ * major type and a subtype: they are returned as such, without a format block. */
+static HRESULT complete_output_video_type(IMFTransform *mft, IMFMediaType *type)
+{
+    UINT32 stride, size, width, height;
+    IMFMediaType *input_type;
+    UINT64 frame_size;
+    GUID subtype;
+    UINT i;
+
+    static const GUID *const copied[] =
+    {
+        &MF_MT_FRAME_RATE, &MF_MT_PIXEL_ASPECT_RATIO, &MF_MT_INTERLACE_MODE,
+    };
+
+#ifdef SG_MUTANT_DMO_OUTCOMPLETE
+    return S_OK;
+#endif
+    if (FAILED(IMFTransform_GetInputCurrentType(mft, 0, &input_type)))
+        return S_OK;
+
+    if (FAILED(IMFMediaType_GetUINT64(input_type, &MF_MT_FRAME_SIZE, &frame_size))
+            || FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+        goto done;
+
+    width = frame_size >> 32;
+    height = frame_size;
+    IMFMediaType_SetUINT64(type, &MF_MT_FRAME_SIZE, frame_size);
+
+    for (i = 0; i < ARRAY_SIZE(copied); ++i)
+    {
+        PROPVARIANT value;
+
+        if (SUCCEEDED(IMFMediaType_GetItem(input_type, copied[i], &value)))
+        {
+            IMFMediaType_SetItem(type, copied[i], &value);
+            PropVariantClear(&value);
+        }
+    }
+
+    if (SUCCEEDED(MFGetStrideForBitmapInfoHeader(subtype.Data1, width, (LONG *)&stride)))
+        IMFMediaType_SetUINT32(type, &MF_MT_DEFAULT_STRIDE, abs((INT32)stride));
+    if (SUCCEEDED(MFCalculateImageSize(&subtype, width, height, &size)))
+        IMFMediaType_SetUINT32(type, &MF_MT_SAMPLE_SIZE, size);
+
+done:
+    IMFMediaType_Release(input_type);
+    return S_OK;
+}
+
+static HRESULT mf_type_to_dmo(IMFMediaType *type, DMO_MEDIA_TYPE *dmo)
+{
+    GUID major, subtype;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaType_GetMajorType(type, &major))
+            || FAILED(hr = IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype)))
+        return hr;
+
+    memset(dmo, 0, sizeof(*dmo));
+
+    if (IsEqualGUID(&major, &MFMediaType_Audio))
+    {
+        if (has_item(type, &MF_MT_AUDIO_NUM_CHANNELS) && has_item(type, &MF_MT_AUDIO_SAMPLES_PER_SECOND)
+                && has_item(type, &MF_MT_AUDIO_BITS_PER_SAMPLE))
+            return MFInitAMMediaTypeFromMFMediaType(type, FORMAT_WaveFormatEx, dmo);
+
+        dmo->majortype = MEDIATYPE_Audio;
+        dmo->subtype = subtype;
+        dmo->bFixedSizeSamples = !!get_uint32(type, &MF_MT_FIXED_SIZE_SAMPLES);
+        dmo->bTemporalCompression = !get_uint32(type, &MF_MT_ALL_SAMPLES_INDEPENDENT);
+        return S_OK;
+    }
+
+    if (IsEqualGUID(&major, &MFMediaType_Video))
+    {
+        if (FAILED(hr = MFInitAMMediaTypeFromMFMediaType(type, FORMAT_VideoInfo, dmo)))
+            return hr;
+        if (!has_item(type, &MF_MT_FRAME_SIZE))
+        {
+            CoTaskMemFree(dmo->pbFormat);
+            dmo->pbFormat = NULL;
+            dmo->cbFormat = 0;
+            dmo->formattype = GUID_NULL;
+        }
+        return S_OK;
+    }
+
+    TRACE("Unsupported major type %s.\n", debugstr_guid(&major));
+    return DMO_E_TYPE_NOT_ACCEPTED;
+}
+
+static HRESULT dmo_to_mf_type(const DMO_MEDIA_TYPE *dmo, IMFMediaType **type)
+{
+    HRESULT hr;
+
+    if (IsEqualGUID(&dmo->majortype, &MEDIATYPE_Audio))
+    {
+        const WAVEFORMATEX *format = (const WAVEFORMATEX *)dmo->pbFormat;
+
+        if (!IsEqualGUID(&dmo->formattype, &FORMAT_WaveFormatEx) || !format
+                || dmo->cbFormat < sizeof(*format) || dmo->cbFormat < sizeof(*format) + format->cbSize)
+            return DMO_E_TYPE_NOT_ACCEPTED;
+    }
+    else if (IsEqualGUID(&dmo->majortype, &MEDIATYPE_Video))
+    {
+        if (!dmo->pbFormat)
+            return DMO_E_TYPE_NOT_ACCEPTED;
+        if (IsEqualGUID(&dmo->formattype, &FORMAT_VideoInfo))
+        {
+            if (dmo->cbFormat < sizeof(VIDEOINFOHEADER))
+                return DMO_E_TYPE_NOT_ACCEPTED;
+        }
+        else if (IsEqualGUID(&dmo->formattype, &FORMAT_VideoInfo2))
+        {
+            if (dmo->cbFormat < sizeof(VIDEOINFOHEADER2))
+                return DMO_E_TYPE_NOT_ACCEPTED;
+        }
+        else
+            return DMO_E_TYPE_NOT_ACCEPTED;
+    }
+    else
+        return DMO_E_TYPE_NOT_ACCEPTED;
+
+    if (FAILED(hr = MFCreateMediaType(type)))
+        return hr;
+    if (FAILED(hr = MFInitMediaTypeFromAMMediaType(*type, dmo)))
+    {
+        IMFMediaType_Release(*type);
+        *type = NULL;
+        return DMO_E_TYPE_NOT_ACCEPTED;
+    }
+
+    return S_OK;
+}
+
+HRESULT dmo_mft_get_type(IMFTransform *mft, BOOL output, DWORD index, DWORD type_index, DMO_MEDIA_TYPE *type)
+{
+    IMFMediaType *media_type;
+    HRESULT hr;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+
+    if (output)
+        hr = IMFTransform_GetOutputAvailableType(mft, 0, type_index, &media_type);
+    else
+        hr = IMFTransform_GetInputAvailableType(mft, 0, type_index, &media_type);
+#ifdef SG_MUTANT_DMO_NOMORE
+    if (hr == MF_E_NO_MORE_TYPES)
+        return E_FAIL;
+#endif
+    if (hr == MF_E_NO_MORE_TYPES)
+        return DMO_E_NO_MORE_ITEMS;
+    if (FAILED(hr))
+        return mf_to_dmo_error(hr);
+
+    if (type)
+    {
+        if (output)
+            complete_output_video_type(mft, media_type);
+        hr = mf_type_to_dmo(media_type, type);
+    }
+    IMFMediaType_Release(media_type);
+
+    return hr;
+}
+
+HRESULT dmo_mft_set_type(struct dmo_state *state, IMFTransform *mft, BOOL output, DWORD index,
+        const DMO_MEDIA_TYPE *type, DWORD flags)
+{
+    IMFMediaType *media_type, *input_type;
+    HRESULT hr;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+
+    if (flags & DMO_SET_TYPEF_CLEAR)
+    {
+        if (flags != DMO_SET_TYPEF_CLEAR)
+            return E_INVALIDARG;
+        EnterCriticalSection(&state->cs);
+        if (output)
+            hr = IMFTransform_SetOutputType(mft, 0, NULL, 0);
+        else
+            hr = IMFTransform_SetInputType(mft, 0, NULL, 0);
+        LeaveCriticalSection(&state->cs);
+        return hr;
+    }
+    if (!type)
+        return E_POINTER;
+#ifndef SG_MUTANT_DMO_FLAGS
+    if (flags & ~DMO_SET_TYPEF_TEST_ONLY)
+        return E_INVALIDARG;
+#endif
+
+    if (FAILED(hr = dmo_to_mf_type(type, &media_type)))
+        return hr;
+
+    EnterCriticalSection(&state->cs);
+
+    if (output)
+    {
+        if (FAILED(IMFTransform_GetInputCurrentType(mft, 0, &input_type)))
+        {
+            hr = DMO_E_TYPE_NOT_SET;
+            goto done;
+        }
+        IMFMediaType_Release(input_type);
+    }
+
+    if (output)
+        hr = IMFTransform_SetOutputType(mft, 0, media_type, flags);
+    else
+        hr = IMFTransform_SetInputType(mft, 0, media_type, flags);
+    if (FAILED(hr) && hr != E_OUTOFMEMORY)
+        hr = DMO_E_TYPE_NOT_ACCEPTED;
+
+done:
+    LeaveCriticalSection(&state->cs);
+    IMFMediaType_Release(media_type);
+    return hr;
+}
+
+HRESULT dmo_mft_get_current_type(IMFTransform *mft, BOOL output, DWORD index, DMO_MEDIA_TYPE *type)
+{
+    IMFMediaType *media_type;
+    HRESULT hr;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+
+    if (output)
+        hr = IMFTransform_GetOutputCurrentType(mft, 0, &media_type);
+    else
+        hr = IMFTransform_GetInputCurrentType(mft, 0, &media_type);
+    if (FAILED(hr))
+        return mf_to_dmo_error(hr);
+
+    if (!type)
+        hr = E_POINTER;
+    else
+        hr = mf_type_to_dmo(media_type, type);
+    IMFMediaType_Release(media_type);
+
+    return hr;
+}
+
+HRESULT dmo_mft_get_size_info(IMFTransform *mft, BOOL output, DWORD index, DWORD *size,
+        DWORD *lookahead, DWORD *alignment)
+{
+    MFT_OUTPUT_STREAM_INFO output_info;
+    MFT_INPUT_STREAM_INFO input_info;
+    HRESULT hr;
+
+    if (!size || !alignment || (!output && !lookahead))
+        return E_POINTER;
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+
+    if (output)
+    {
+        if (FAILED(hr = IMFTransform_GetOutputStreamInfo(mft, 0, &output_info)))
+            return mf_to_dmo_error(hr);
+        *size = output_info.cbSize;
+        *alignment = output_info.cbAlignment;
+    }
+    else
+    {
+        if (FAILED(hr = IMFTransform_GetInputStreamInfo(mft, 0, &input_info)))
+            return mf_to_dmo_error(hr);
+        *size = input_info.cbSize;
+        *lookahead = 0;
+        *alignment = input_info.cbAlignment;
+    }
+
+    return S_OK;
+}
+
+HRESULT dmo_get_input_status(wg_transform_t transform, DWORD index, DWORD *flags)
+{
+    bool accepts_input;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+    if (!flags)
+        return E_POINTER;
+    if (!transform)
+        return DMO_E_TYPE_NOT_SET;
+    if (!wg_transform_get_status(transform, &accepts_input))
+        return E_FAIL;
+
+#ifdef SG_MUTANT_DMO_STATUS
+    accepts_input = TRUE;
+#endif
+    *flags = accepts_input ? DMO_INPUT_STATUSF_ACCEPT_DATA : 0;
+    return S_OK;
+}
+
+/* A discontinuity means no more data until what is pending has been processed:
+ * the same thing as draining the transform. */
+HRESULT dmo_discontinuity(struct dmo_state *state, wg_transform_t transform, DWORD index)
+{
+    HRESULT hr = S_OK;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+
+    EnterCriticalSection(&state->cs);
+    if (transform)
+        hr = wg_transform_drain(transform);
+    LeaveCriticalSection(&state->cs);
+
+    return hr;
+}
+
+HRESULT dmo_flush(struct dmo_state *state, wg_transform_t transform, struct wg_sample_queue *queue)
+{
+    HRESULT hr = DMO_E_TYPE_NOT_SET;
+
+    EnterCriticalSection(&state->cs);
+    if (transform && SUCCEEDED(hr = wg_transform_flush(transform)))
+        wg_sample_queue_flush(queue, TRUE);
+    LeaveCriticalSection(&state->cs);
+
+    return hr;
+}
+
+HRESULT dmo_process_input(struct dmo_state *state, wg_transform_t transform, struct wg_sample_queue *queue,
+        DWORD index, IMediaBuffer *buffer, DWORD flags, REFERENCE_TIME timestamp, REFERENCE_TIME timelength)
+{
+    HRESULT hr;
+
+    if (index)
+        return DMO_E_INVALIDSTREAMINDEX;
+    if (!buffer)
+        return E_POINTER;
+    if (!transform)
+        return DMO_E_TYPE_NOT_SET;
+
+    EnterCriticalSection(&state->cs);
+    hr = wg_transform_push_dmo(transform, buffer, flags, timestamp, timelength, queue);
+    LeaveCriticalSection(&state->cs);
+
+    return mf_to_dmo_error(hr);
+}
+
+/* A buffer of our own to read into when the client discards the output. */
+struct discard_buffer
+{
+    IMediaBuffer IMediaBuffer_iface;
+    LONG refcount;
+    DWORD length, max_length;
+    BYTE *data;
+};
+
+static struct discard_buffer *impl_from_IMediaBuffer(IMediaBuffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct discard_buffer, IMediaBuffer_iface);
+}
+
+static HRESULT WINAPI discard_buffer_QueryInterface(IMediaBuffer *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IMediaBuffer))
+    {
+        IMediaBuffer_AddRef((*out = iface));
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI discard_buffer_AddRef(IMediaBuffer *iface)
+{
+    return InterlockedIncrement(&impl_from_IMediaBuffer(iface)->refcount);
+}
+
+static ULONG WINAPI discard_buffer_Release(IMediaBuffer *iface)
+{
+    struct discard_buffer *buffer = impl_from_IMediaBuffer(iface);
+    ULONG refcount = InterlockedDecrement(&buffer->refcount);
+
+    if (!refcount)
+    {
+        free(buffer->data);
+        free(buffer);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI discard_buffer_SetLength(IMediaBuffer *iface, DWORD length)
+{
+    struct discard_buffer *buffer = impl_from_IMediaBuffer(iface);
+
+    if (length > buffer->max_length)
+        return E_INVALIDARG;
+    buffer->length = length;
+    return S_OK;
+}
+
+static HRESULT WINAPI discard_buffer_GetMaxLength(IMediaBuffer *iface, DWORD *length)
+{
+    if (!length)
+        return E_POINTER;
+    *length = impl_from_IMediaBuffer(iface)->max_length;
+    return S_OK;
+}
+
+static HRESULT WINAPI discard_buffer_GetBufferAndLength(IMediaBuffer *iface, BYTE **data, DWORD *length)
+{
+    struct discard_buffer *buffer = impl_from_IMediaBuffer(iface);
+
+    if (!data && !length)
+        return E_POINTER;
+    if (data)
+        *data = buffer->data;
+    if (length)
+        *length = buffer->length;
+    return S_OK;
+}
+
+static const IMediaBufferVtbl discard_buffer_vtbl =
+{
+    discard_buffer_QueryInterface,
+    discard_buffer_AddRef,
+    discard_buffer_Release,
+    discard_buffer_SetLength,
+    discard_buffer_GetMaxLength,
+    discard_buffer_GetBufferAndLength,
+};
+
+static HRESULT discard_buffer_create(DWORD size, IMediaBuffer **out)
+{
+    struct discard_buffer *buffer;
+
+    if (!(buffer = calloc(1, sizeof(*buffer))))
+        return E_OUTOFMEMORY;
+    if (!(buffer->data = calloc(1, size)))
+    {
+        free(buffer);
+        return E_OUTOFMEMORY;
+    }
+    buffer->IMediaBuffer_iface.lpVtbl = &discard_buffer_vtbl;
+    buffer->refcount = 1;
+    buffer->max_length = size;
+    *out = &buffer->IMediaBuffer_iface;
+    return S_OK;
+}
+
+HRESULT dmo_process_output(struct dmo_state *state, IMFTransform *mft, wg_transform_t transform,
+        struct wg_sample_queue *queue, DWORD flags, DWORD count, DMO_OUTPUT_DATA_BUFFER *buffers,
+        DWORD *status, DWORD extra_status)
+{
+    IMediaBuffer *discard = NULL;
+    MFT_OUTPUT_STREAM_INFO info;
+    HRESULT hr;
+
+    if (!buffers)
+        return E_POINTER;
+    if (count != 1)
+        return E_INVALIDARG;
+    if (!transform)
+        return DMO_E_TYPE_NOT_SET;
+#ifdef SG_MUTANT_DMO_DISCARD
+    if (!buffers->pBuffer)
+        return E_INVALIDARG;
+#endif
+    if (!buffers->pBuffer && !(flags & DMO_PROCESS_OUTPUT_DISCARD_WHEN_NO_BUFFER))
+        return E_INVALIDARG;
+
+    if (status)
+        *status = 0;
+
+    EnterCriticalSection(&state->cs);
+
+    if (!buffers->pBuffer)
+    {
+        if (FAILED(IMFTransform_GetOutputStreamInfo(mft, 0, &info)) || !info.cbSize)
+            info.cbSize = 4096;
+        if (FAILED(hr = discard_buffer_create(info.cbSize, &discard)))
+            goto done;
+        buffers->pBuffer = discard;
+    }
+
+    hr = wg_transform_read_dmo(transform, buffers);
+    if (hr == MF_E_TRANSFORM_STREAM_CHANGE)
+        hr = wg_transform_read_dmo(transform, buffers);
+
+    if (SUCCEEDED(hr))
+    {
+        buffers->dwStatus |= extra_status;
+        wg_sample_queue_flush(queue, false);
+    }
+    else if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT)
+    {
+        buffers->dwStatus = 0;
+#ifndef SG_MUTANT_DMO_SFALSE
+        hr = S_FALSE;
+#endif
+    }
+
+    if (discard)
+    {
+        buffers->pBuffer = NULL;
+        buffers->dwStatus = 0;
+        IMediaBuffer_Release(discard);
+    }
+
+done:
+    LeaveCriticalSection(&state->cs);
+    return hr;
+}
+
+/* IPropertyBag: values the client writes are kept and read back by name. */
+HRESULT dmo_bag_read(struct dmo_state *state, const WCHAR *name, VARIANT *value, IErrorLog *error_log)
+{
+    HRESULT hr = E_INVALIDARG;
+    size_t i;
+
+    if (!name || !value)
+        return E_POINTER;
+
+    EnterCriticalSection(&state->cs);
+    for (i = 0; i < state->bag_count; ++i)
+    {
+        if (wcsicmp(state->bag[i].name, name))
+            continue;
+
+        if (V_VT(value) == VT_EMPTY || V_VT(value) == V_VT(&state->bag[i].value))
+            hr = VariantCopy(value, &state->bag[i].value);
+        else
+            hr = VariantChangeType(value, &state->bag[i].value, 0, V_VT(value));
+        break;
+    }
+    LeaveCriticalSection(&state->cs);
+#ifdef SG_MUTANT_DMO_BAG
+    if (hr == E_INVALIDARG)
+        hr = S_OK;
+#endif
+
+    return hr;
+}
+
+HRESULT dmo_bag_write(struct dmo_state *state, const WCHAR *name, VARIANT *value)
+{
+    struct dmo_bag_entry *entry = NULL;
+    HRESULT hr = S_OK;
+    size_t i;
+
+    if (!name || !value)
+        return E_POINTER;
+
+    EnterCriticalSection(&state->cs);
+    for (i = 0; i < state->bag_count; ++i)
+        if (!wcsicmp(state->bag[i].name, name))
+            entry = &state->bag[i];
+
+    if (entry)
+        hr = VariantCopy(&entry->value, value);
+    else if (!array_reserve((void **)&state->bag, &state->bag_capacity, state->bag_count + 1, sizeof(*state->bag)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        entry = &state->bag[state->bag_count];
+        VariantInit(&entry->value);
+        if (!(entry->name = malloc((wcslen(name) + 1) * sizeof(WCHAR))))
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            wcscpy(entry->name, name);
+            if (FAILED(hr = VariantCopy(&entry->value, value)))
+                free(entry->name);
+            else
+                state->bag_count++;
+        }
+    }
+    LeaveCriticalSection(&state->cs);
+
+    return hr;
+}
+
+/* IPropertyStore: the same, keyed by PROPERTYKEY. */
+HRESULT dmo_store_get_count(struct dmo_state *state, DWORD *count)
+{
+    if (!count)
+        return E_POINTER;
+    EnterCriticalSection(&state->cs);
+    *count = state->store_count;
+    LeaveCriticalSection(&state->cs);
+    return S_OK;
+}
+
+HRESULT dmo_store_get_at(struct dmo_state *state, DWORD index, PROPERTYKEY *key)
+{
+    HRESULT hr = E_INVALIDARG;
+
+    if (!key)
+        return E_POINTER;
+    EnterCriticalSection(&state->cs);
+    if (index < state->store_count)
+    {
+        *key = state->store[index].key;
+        hr = S_OK;
+    }
+    LeaveCriticalSection(&state->cs);
+    return hr;
+}
+
+HRESULT dmo_store_get_value(struct dmo_state *state, REFPROPERTYKEY key, PROPVARIANT *value)
+{
+    HRESULT hr = S_OK;
+    size_t i;
+
+    if (!key || !value)
+        return E_POINTER;
+
+    PropVariantInit(value);
+
+    EnterCriticalSection(&state->cs);
+    for (i = 0; i < state->store_count; ++i)
+    {
+        if (IsEqualGUID(&state->store[i].key.fmtid, &key->fmtid) && state->store[i].key.pid == key->pid)
+        {
+            hr = PropVariantCopy(value, &state->store[i].value);
+            break;
+        }
+    }
+    LeaveCriticalSection(&state->cs);
+
+    return hr;
+}
+
+HRESULT dmo_store_set_value(struct dmo_state *state, REFPROPERTYKEY key, REFPROPVARIANT value)
+{
+    struct dmo_store_entry *entry = NULL;
+    HRESULT hr = S_OK;
+    size_t i;
+
+    if (!key || !value)
+        return E_POINTER;
+
+#ifdef SG_MUTANT_DMO_STORE
+    return S_OK;
+#endif
+    EnterCriticalSection(&state->cs);
+    for (i = 0; i < state->store_count; ++i)
+        if (IsEqualGUID(&state->store[i].key.fmtid, &key->fmtid) && state->store[i].key.pid == key->pid)
+            entry = &state->store[i];
+
+    if (entry)
+    {
+        PropVariantClear(&entry->value);
+        hr = PropVariantCopy(&entry->value, value);
+    }
+    else if (!array_reserve((void **)&state->store, &state->store_capacity, state->store_count + 1,
+            sizeof(*state->store)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        entry = &state->store[state->store_count];
+        entry->key = *key;
+        PropVariantInit(&entry->value);
+        if (SUCCEEDED(hr = PropVariantCopy(&entry->value, value)))
+            state->store_count++;
+    }
+    LeaveCriticalSection(&state->cs);
+
+    return hr;
+}
