index 63ca3f6..05c4fc3 100644
--- a/dlls/winegstreamer/Makefile.in
+++ b/dlls/winegstreamer/Makefile.in
@@ -9,6 +9,7 @@ UNIX_LIBS    = $(GSTREAMER_LIBS) $(PTHREAD_LIBS)
 SOURCES = \
 	aac_decoder.c \
 	color_convert.c \
+	dmo_transform.c \
 	main.c \
 	media_sink.c \
 	media_source.c \
