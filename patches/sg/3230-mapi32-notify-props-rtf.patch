+        }
+    }
+    IMAPIPROP_Unlock(This);
+    IMAPIProp_Release(dst);
+
+    if (probs)
+    {
+        if (count)
+        {
+            probs->cProblem = count;
+            *lppProbs = probs;
+        }
+        else MAPIFreeBuffer(probs);
+    }
+    return S_OK;
+}
