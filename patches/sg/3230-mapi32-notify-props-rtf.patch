+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winerror.h"
+#include "objbase.h"
+#include "mapival.h"
+#include "mapiutil.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+#include "util.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mapi);
+
+/* The utility functions are in use between ScInitMapiUtil and DeinitMapiUtil. */
+static LONG util_init_count;
+
+/* A packet: the notifications sent to a sink from another thread, waiting for the thread of the sink */
+struct packet
+{
+    struct list entry;
+    IMAPIAdviseSink *sink;
+    ULONG count;
+    NOTIFICATION *notifs;   /* one MAPI allocation, with all it points to */
+};
+
+/* The queue of a thread, with the window that wakes the thread up */
+struct thread_queue
+{
+    struct list entry;
+    DWORD tid;
+    HWND hwnd;
+    struct list packets;
+};
+
+static CRITICAL_SECTION notify_cs;
+static CRITICAL_SECTION_DEBUG notify_cs_debug =
+{
+    0, 0, &notify_cs,
+    { &notify_cs_debug.ProcessLocksList, &notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": notify_cs") }
+};
+static CRITICAL_SECTION notify_cs = { &notify_cs_debug, -1, 0, 0, 0, 0 };
+static struct list queues = LIST_INIT(queues);
+
+#define WM_MAPI_NOTIFY (WM_USER + 0x4d4e)
+
+/* NOTIFICATION copy: the allocations are linked to the first, so MAPIFreeBuffer frees them all */
+static HRESULT copy_bytes(void *orig, const void *src, ULONG size, void **dst)
+{
+    HRESULT hr;
+
+    *dst = NULL;
+    if (!src) return S_OK;
+    if (FAILED(hr = MAPIAllocateMore(size ? size : 1, orig, dst))) return hr;
+    memcpy(*dst, src, size);
+    return S_OK;
+}
+
+static HRESULT copy_proptags(void *orig, const SPropTagArray *src, SPropTagArray **dst)
+{
+    return copy_bytes(orig, src, src ? CbNewSPropTagArray(src->cValues) : 0, (void **)dst);
+}
+
+static HRESULT copy_props(void *orig, const SPropValue *src, ULONG count, SPropValue **dst)
+{
+    HRESULT hr;
+    ULONG i;
+
+    *dst = NULL;
+    if (!src) return S_OK;
+    if (FAILED(hr = MAPIAllocateMore(count * sizeof(SPropValue), orig, (void **)dst))) return hr;
+    for (i = 0; i < count; i++)
+        if (FAILED(hr = PropCopyMore(&(*dst)[i], (SPropValue *)&src[i], MAPIAllocateMore, orig))) return hr;
+    return S_OK;
+}
+
+static HRESULT copy_notification(void *orig, NOTIFICATION *dst, const NOTIFICATION *src)
+{
+    HRESULT hr = S_OK;
+
+    *dst = *src;
+    switch (src->ulEventType)
+    {
+    case fnevCriticalError:
+#ifndef SG_MUTANT_MAPI_CPERR
+        if (FAILED(hr = copy_bytes(orig, src->info.err.lpEntryID, src->info.err.cbEntryID,
+                                   (void **)&dst->info.err.lpEntryID))) break;
+#endif
+        if (src->info.err.lpMAPIError)
+        {
+            const MAPIERROR *e = src->info.err.lpMAPIError;
+            MAPIERROR *copy;
+            BOOL unicode = (src->info.err.ulFlags & MAPI_UNICODE) != 0;
+
+            if (FAILED(hr = copy_bytes(orig, e, sizeof(*e), (void **)&copy))) break;
+            if (FAILED(hr = copy_bytes(orig, e->lpszError, e->lpszError ? (unicode ? (lstrlenW((WCHAR *)e->lpszError) + 1) * 2 :
+                                       strlen((char *)e->lpszError) + 1) : 0, (void **)&copy->lpszError))) break;
+            if (FAILED(hr = copy_bytes(orig, e->lpszComponent, e->lpszComponent ? (unicode ?
+                                       (lstrlenW((WCHAR *)e->lpszComponent) + 1) * 2 : strlen((char *)e->lpszComponent) + 1) : 0,
+                                       (void **)&copy->lpszComponent))) break;
+            dst->info.err.lpMAPIError = copy;
+        }
+        break;
+
+    case fnevNewMail:
+#ifndef SG_MUTANT_MAPI_CPMAIL
+        if (FAILED(hr = copy_bytes(orig, src->info.newmail.lpEntryID, src->info.newmail.cbEntryID,
+                                   (void **)&dst->info.newmail.lpEntryID))) break;
+#endif
+        if (FAILED(hr = copy_bytes(orig, src->info.newmail.lpParentID, src->info.newmail.cbParentID,
+                                   (void **)&dst->info.newmail.lpParentID))) break;
+        /* the class name is an ASCII or a Unicode string; the flags say which */
+        if (src->info.newmail.lpszMessageClass)
+        {
+            BOOL unicode = (src->info.newmail.ulFlags & MAPI_UNICODE) != 0;
+            ULONG len = unicode ? (lstrlenW((WCHAR *)src->info.newmail.lpszMessageClass) + 1) * 2 :
+                                  strlen((char *)src->info.newmail.lpszMessageClass) + 1;
+            hr = copy_bytes(orig, src->info.newmail.lpszMessageClass, len, (void **)&dst->info.newmail.lpszMessageClass);
+        }
+        break;
+
+    case fnevObjectCreated:
+    case fnevObjectDeleted:
+    case fnevObjectModified:
+    case fnevObjectMoved:
+    case fnevObjectCopied:
+    case fnevSearchComplete:
+        if (FAILED(hr = copy_bytes(orig, src->info.obj.lpEntryID, src->info.obj.cbEntryID,
+                                   (void **)&dst->info.obj.lpEntryID))) break;
+        if (FAILED(hr = copy_bytes(orig, src->info.obj.lpParentID, src->info.obj.cbParentID,
+                                   (void **)&dst->info.obj.lpParentID))) break;
+        if (FAILED(hr = copy_bytes(orig, src->info.obj.lpOldID, src->info.obj.cbOldID,
+                                   (void **)&dst->info.obj.lpOldID))) break;
+        if (FAILED(hr = copy_bytes(orig, src->info.obj.lpOldParentID, src->info.obj.cbOldParentID,
+                                   (void **)&dst->info.obj.lpOldParentID))) break;
+#ifndef SG_MUTANT_MAPI_CPOBJ
+        hr = copy_proptags(orig, src->info.obj.lpPropTagArray, &dst->info.obj.lpPropTagArray);
+#endif
+        break;
+
+    case fnevTableModified:
+        if (src->info.tab.propIndex.ulPropTag &&
+            FAILED(hr = PropCopyMore(&dst->info.tab.propIndex, (SPropValue *)&src->info.tab.propIndex,
+                                     MAPIAllocateMore, orig))) break;
+        if (src->info.tab.propPrior.ulPropTag &&
+            FAILED(hr = PropCopyMore(&dst->info.tab.propPrior, (SPropValue *)&src->info.tab.propPrior,
+                                     MAPIAllocateMore, orig))) break;
+#ifndef SG_MUTANT_MAPI_CPTAB
+        hr = copy_props(orig, src->info.tab.row.lpProps, src->info.tab.row.cValues, &dst->info.tab.row.lpProps);
+#endif
+        break;
+
+    case fnevStatusObjectModified:
+        if (FAILED(hr = copy_bytes(orig, src->info.statobj.lpEntryID, src->info.statobj.cbEntryID,
+                                   (void **)&dst->info.statobj.lpEntryID))) break;
+#ifndef SG_MUTANT_MAPI_CPSTAT
+        hr = copy_props(orig, src->info.statobj.lpPropVals, src->info.statobj.cValues, &dst->info.statobj.lpPropVals);
+#endif
+        break;
+
+    case fnevExtended:
+#ifndef SG_MUTANT_MAPI_CPEXT
+        hr = copy_bytes(orig, src->info.ext.pbEventParameters, src->info.ext.cb,
+                        (void **)&dst->info.ext.pbEventParameters);
+#endif
+        break;
+
+    default:
+        break;
+    }
+    return hr;
+}
+
+static struct thread_queue *find_queue(DWORD tid)
+{
+    struct thread_queue *q;
+
+    LIST_FOR_EACH_ENTRY(q, &queues, struct thread_queue, entry)
+        if (q->tid == tid) return q;
+    return NULL;
+}
+
+/* deliver what is queued for the thread, on the thread */
+static void dispatch_queue(void)
+{
+    struct thread_queue *q;
+
+    for (;;)
+    {
+        struct packet *packet = NULL;
+
+        EnterCriticalSection(&notify_cs);
+        if ((q = find_queue(GetCurrentThreadId())) && !list_empty(&q->packets))
+        {
+            packet = LIST_ENTRY(list_head(&q->packets), struct packet, entry);
+            list_remove(&packet->entry);
+        }
+        LeaveCriticalSection(&notify_cs);
+        if (!packet) return;
+
+        IMAPIAdviseSink_OnNotify(packet->sink, packet->count, packet->notifs);
+        IMAPIAdviseSink_Release(packet->sink);
+        MAPIFreeBuffer(packet->notifs);
+        free(packet);
+    }
+}
+
+static LRESULT CALLBACK notify_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_MAPI_NOTIFY)
+    {
+        dispatch_queue();
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static const WCHAR notify_class[] = L"WineMapiNotifyWindow";
+
+static ATOM register_notify_class(void)
+{
+    WNDCLASSW wc = {0};
+
+    wc.lpfnWndProc = notify_wndproc;
+    wc.hInstance = GetModuleHandleW(L"mapi32.dll");
+    wc.lpszClassName = notify_class;
+    if (!RegisterClassW(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) return 0;
+    return 1;
+}
+
+/* the queue of the calling thread, made if there is none */
+static struct thread_queue *get_queue(void)
+{
+    struct thread_queue *q;
+
+    EnterCriticalSection(&notify_cs);
+    if (!(q = find_queue(GetCurrentThreadId())))
+    {
+        if (register_notify_class() && (q = calloc(1, sizeof(*q))))
+        {
+            q->tid = GetCurrentThreadId();
+            list_init(&q->packets);
+            q->hwnd = CreateWindowExW(0, notify_class, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                                      GetModuleHandleW(L"mapi32.dll"), NULL);
+            if (!q->hwnd)
+            {
+                free(q);
+                q = NULL;
+            }
+            else list_add_tail(&queues, &q->entry);
+        }
+    }
+    LeaveCriticalSection(&notify_cs);
+    return q;
+}
+
+/* The sink that goes to the other threads */
+struct thread_sink
+{
+    IMAPIAdviseSink IMAPIAdviseSink_iface;
+    LONG ref;
+    IMAPIAdviseSink *inner;
+    DWORD tid;
+};
+
+static struct thread_sink *impl_from_sink(IMAPIAdviseSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct thread_sink, IMAPIAdviseSink_iface);
+}
+
+static HRESULT WINAPI sink_QueryInterface(IMAPIAdviseSink *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IMAPIAdviseSink))
+    {
+        *obj = iface;
+        IMAPIAdviseSink_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_AddRef(IMAPIAdviseSink *iface)
+{
+    return InterlockedIncrement(&impl_from_sink(iface)->ref);
+}
+
+static ULONG WINAPI sink_Release(IMAPIAdviseSink *iface)
+{
+    struct thread_sink *sink = impl_from_sink(iface);
+    ULONG ref = InterlockedDecrement(&sink->ref);
+
+    if (!ref)
+    {
+        IMAPIAdviseSink_Release(sink->inner);
+        free(sink);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI sink_OnNotify(IMAPIAdviseSink *iface, ULONG count, LPNOTIFICATION notifs)
+{
+    struct thread_sink *sink = impl_from_sink(iface);
+    struct packet *packet;
+    struct thread_queue *q;
+    NOTIFICATION *copy;
+    ULONG i;
+
+    TRACE("(%p, %lu, %p)\n", iface, count, notifs);
+
+    /* on the thread of the sink the notification goes straight through */
+#ifdef SG_MUTANT_MAPI_ALWAYSDIRECT
+    if (TRUE)
+#else
+    if (GetCurrentThreadId() == sink->tid)
+#endif
+        return IMAPIAdviseSink_OnNotify(sink->inner, count, notifs);
+
+    if (!count || !notifs) return 0;
+    if (FAILED(MAPIAllocateBuffer(count * sizeof(NOTIFICATION), (void **)&copy))) return 0;
+    for (i = 0; i < count; i++)
+        if (FAILED(copy_notification(copy, &copy[i], &notifs[i])))
+        {
+            MAPIFreeBuffer(copy);
+            return 0;
+        }
+    if (!(packet = calloc(1, sizeof(*packet))))
+    {
+        MAPIFreeBuffer(copy);
+        return 0;
+    }
+    packet->sink = sink->inner;
+    IMAPIAdviseSink_AddRef(packet->sink);
+    packet->count = count;
+    packet->notifs = copy;
+
+    EnterCriticalSection(&notify_cs);
+    q = find_queue(sink->tid);
+    if (q) list_add_tail(&q->packets, &packet->entry);
+    LeaveCriticalSection(&notify_cs);
+    if (!q)
+    {
+        /* the thread has no window any more */
+        IMAPIAdviseSink_Release(packet->sink);
+        MAPIFreeBuffer(copy);
+        free(packet);
+        return 0;
+    }
+#ifndef SG_MUTANT_MAPI_NOWAKE
+    PostMessageW(q->hwnd, WM_MAPI_NOTIFY, 0, 0);
+#endif
+    return 0;
+}
+
+static const IMAPIAdviseSinkVtbl sink_vtbl =
+{
+    sink_QueryInterface,
+    sink_AddRef,
+    sink_Release,
+    sink_OnNotify
+};
+
+/*************************************************************************
+ * HrThisThreadAdviseSink@8 (MAPI32.42)
+ *
+ * Ensure that an advise sink is only notified in its originating thread.
+ *
+ * PARAMS
+ *  lpSink     [I] IMAPIAdviseSink interface to be protected
+ *  lppNewSink [I] Destination for wrapper IMAPIAdviseSink interface
+ *
+ * RETURNS
+ * Success: S_OK. *lppNewSink contains a new sink to use in place of lpSink.
+ * Failure: E_INVALIDARG, if any parameter is invalid.
+ *
+ * NOTES
+ *  A notification sent to the new sink on another thread is copied and queued
+ *  for the thread that made the sink; the thread gets it when it handles its
+ *  messages, or when it calls HrDispatchNotifications().
+ */
+HRESULT WINAPI HrThisThreadAdviseSink(LPMAPIADVISESINK lpSink, LPMAPIADVISESINK* lppNewSink)
+{
+    struct thread_sink *sink;
+
+    if (mapiFunctions.HrThisThreadAdviseSink)
+        return mapiFunctions.HrThisThreadAdviseSink(lpSink, lppNewSink);
+
+    TRACE("(%p,%p)\n", lpSink, lppNewSink);
+
+    if (!lpSink || !lppNewSink)
+        return E_INVALIDARG;
+
+    /* the queue and its window are made for this thread now */
+    if (!get_queue()) return MAPI_E_NOT_ENOUGH_MEMORY;
+    if (!(sink = calloc(1, sizeof(*sink)))) return MAPI_E_NOT_ENOUGH_MEMORY;
+    sink->IMAPIAdviseSink_iface.lpVtbl = &sink_vtbl;
+    sink->ref = 1;
+    sink->inner = lpSink;
+    IMAPIAdviseSink_AddRef(lpSink);
+    sink->tid = GetCurrentThreadId();
+    *lppNewSink = &sink->IMAPIAdviseSink_iface;
+    return S_OK;
+}
+
+/*************************************************************************
+ * HrDispatchNotifications@4 (MAPI32.239)
+ *
+ * Deliver the notifications queued for the calling thread.
+ *
+ * PARAMS
+ *  flags [I] Reserved, 0
+ *
+ * RETURNS
+ *  S_OK: the notifications have been delivered.
+ *  MAPI_E_USER_CANCEL: the thread has a WM_QUIT or an end session message.
+ *  MAPI_E_NOT_INITIALIZED: MAPI is not initialized.
+ *  MAPI_E_INVALID_PARAMETER: flags is not 0.
+ */
+HRESULT WINAPI HrDispatchNotifications(ULONG flags)
+{
+    MSG msg;
+
+    TRACE("(%08lx)\n", flags);
+
+#ifndef SG_MUTANT_MAPI_DISPFLAGS
+    if (flags) return MAPI_E_INVALID_PARAMETER;
+#endif
+#ifndef SG_MUTANT_MAPI_NOINIT
+    if (util_init_count <= 0 && !mapiFunctions.MAPIInitialize) return MAPI_E_NOT_INITIALIZED;
+#endif
+
+    dispatch_queue();
+
+    if (PeekMessageW(&msg, NULL, WM_QUIT, WM_QUIT, PM_NOREMOVE) ||
+        PeekMessageW(&msg, NULL, WM_QUERYENDSESSION, WM_QUERYENDSESSION, PM_NOREMOVE) ||
+        PeekMessageW(&msg, NULL, WM_ENDSESSION, WM_ENDSESSION, PM_NOREMOVE))
+    {
+#ifndef SG_MUTANT_MAPI_QUIT
+        return MAPI_E_USER_CANCEL;
+#endif
+    }
+    return S_OK;
+}
+
+/**************************************************************************
+ *  ScInitMapiUtil (MAPI32.33)
+ *
+ * Initialise Mapi utility functions.
+ *
+ * PARAMS
+ *  ulReserved [I] Reserved, pass 0.
+ *
+ * RETURNS
+ *  Success: S_OK. Mapi utility functions may be called.
+ *  Failure: MAPI_E_INVALID_PARAMETER, if ulReserved is not 0.
+ *
+ * NOTES
+ *  Your application does not need to call this function unless it does not
+ *  call MAPIInitialize()/MAPIUninitialize().
+ */
+SCODE WINAPI ScInitMapiUtil(ULONG ulReserved)
+{
+    if (mapiFunctions.ScInitMapiUtil)
+        return mapiFunctions.ScInitMapiUtil(ulReserved);
+
+    TRACE("(0x%08lx)\n", ulReserved);
+#ifndef SG_MUTANT_MAPI_INITRES
+    if (ulReserved)
+        return MAPI_E_INVALID_PARAMETER;
+#endif
+    InterlockedIncrement(&util_init_count);
+    return S_OK;
+}
+
+/**************************************************************************
+ *  DeinitMapiUtil (MAPI32.34)
+ *
+ * Uninitialise Mapi utility functions.
+ *
+ * PARAMS
+ *  None.
+ *
+ * RETURNS
+ *  Nothing.
+ *
+ * NOTES
+ *  Your application does not need to call this function unless it does not
+ *  call MAPIInitialize()/MAPIUninitialize().
+ */
+VOID WINAPI DeinitMapiUtil(void)
+{
+    if (mapiFunctions.DeinitMapiUtil)
+        mapiFunctions.DeinitMapiUtil();
+    else
+    {
+        TRACE("()\n");
+        /* calls that were not matched by an initialization are ignored */
+#ifdef SG_MUTANT_MAPI_DEINIT
+        InterlockedExchange(&util_init_count, 0);
+#else
+        if (InterlockedDecrement(&util_init_count) < 0) InterlockedExchange(&util_init_count, 0);
+#endif
+    }
+}
