+/* A stream over the value of a binary or string property: the data is read
+ * when it is opened, and written back to the property when it is committed or
+ * released after a change */
+typedef struct
+{
+    IStream IStream_iface;
+    LONG ref;
+    IPropDataImpl *data;
+    ULONG tag;
+    IStream *mem;
+    BOOL modify, dirty;
+} PropStream;
+
+static inline PropStream *impl_from_PropStream(IStream *iface)
+{
+    return CONTAINING_RECORD(iface, PropStream, IStream_iface);
+}
+
+static HRESULT PropStream_Store(PropStream *s)
+{
+    HRESULT hr;
+    HGLOBAL global;
+    SPropValue value;
+    STATSTG stat;
+    SIZE_T size;
+    BYTE *bytes, *copy;
+    LPSPropProblemArray probs = NULL;
+
+#ifdef SG_MUTANT_MAPI_NOSTORE
+    return S_OK;
+#endif
+    if (!s->dirty) return S_OK;
+    if (FAILED(hr = IStream_Stat(s->mem, &stat, STATFLAG_NONAME))) return hr;
+    size = stat.cbSize.LowPart;
+    if (FAILED(hr = GetHGlobalFromStream(s->mem, &global))) return hr;
+    if (!(bytes = GlobalLock(global))) return E_FAIL;
+
+    memset(&value, 0, sizeof(value));
+    value.ulPropTag = s->tag;
+    switch (PROP_TYPE(s->tag))
+    {
+    case PT_BINARY:
+        if (FAILED(hr = MAPIAllocateBuffer(size ? size : 1, (void **)&copy))) break;
+        memcpy(copy, bytes, size);
+        value.Value.bin.cb = size;
+        value.Value.bin.lpb = copy;
+        break;
+    case PT_STRING8:
+        if (FAILED(hr = MAPIAllocateBuffer(size + 1, (void **)&copy))) break;
+        memcpy(copy, bytes, size);
+        copy[size] = 0;
+        value.Value.lpszA = (char *)copy;
+        break;
+    default: /* PT_UNICODE */
+        if (FAILED(hr = MAPIAllocateBuffer(size + sizeof(WCHAR), (void **)&copy))) break;
+        memcpy(copy, bytes, size);
+        *(WCHAR *)(copy + (size & ~1)) = 0;
+        value.Value.lpszW = (WCHAR *)copy;
+        break;
+    }
+    GlobalUnlock(global);
+    if (FAILED(hr)) return hr;
+
+    hr = IPropData_SetProps(&s->data->IPropData_iface, 1, &value, &probs);
+    MAPIFreeBuffer(copy);
+    if (probs) MAPIFreeBuffer(probs);
+    if (SUCCEEDED(hr)) s->dirty = FALSE;
+    return hr;
+}
