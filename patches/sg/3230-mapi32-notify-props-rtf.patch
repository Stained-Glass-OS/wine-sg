+#ifdef SG_MUTANT_MAPI_SELF
+    hr = S_OK;
+#else
+    hr = (src_unk == dst_unk) ? MAPI_E_NO_ACCESS : S_OK;
+#endif
+    IUnknown_Release(src_unk);
+    IUnknown_Release(dst_unk);
+    if (FAILED(hr))
