+static HRESULT WINAPI PropStream_QueryInterface(IStream *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ISequentialStream) || IsEqualIID(riid, &IID_IStream))
+    {
+        *obj = iface;
+        IStream_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI PropStream_AddRef(IStream *iface)
+{
+    return InterlockedIncrement(&impl_from_PropStream(iface)->ref);
+}
+
+static ULONG WINAPI PropStream_Release(IStream *iface)
+{
+    PropStream *s = impl_from_PropStream(iface);
+    ULONG ref = InterlockedDecrement(&s->ref);
+
+    if (!ref)
+    {
+        PropStream_Store(s);
+        IStream_Release(s->mem);
+        IPropData_Release(&s->data->IPropData_iface);
+        free(s);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI PropStream_Read(IStream *iface, void *buf, ULONG cb, ULONG *read)
+{
+    return IStream_Read(impl_from_PropStream(iface)->mem, buf, cb, read);
+}
+
+static HRESULT WINAPI PropStream_Write(IStream *iface, const void *buf, ULONG cb, ULONG *written)
+{
+    PropStream *s = impl_from_PropStream(iface);
+
+#ifndef SG_MUTANT_MAPI_STREAMRO
+    if (!s->modify) return STG_E_ACCESSDENIED;
+#endif
+    s->dirty = TRUE;
+    return IStream_Write(s->mem, buf, cb, written);
+}
+
+static HRESULT WINAPI PropStream_Seek(IStream *iface, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *pos)
+{
+    return IStream_Seek(impl_from_PropStream(iface)->mem, move, origin, pos);
+}
+
+static HRESULT WINAPI PropStream_SetSize(IStream *iface, ULARGE_INTEGER size)
+{
+    PropStream *s = impl_from_PropStream(iface);
+
+    if (!s->modify) return STG_E_ACCESSDENIED;
+    s->dirty = TRUE;
+    return IStream_SetSize(s->mem, size);
+}
+
+static HRESULT WINAPI PropStream_CopyTo(IStream *iface, IStream *dest, ULARGE_INTEGER cb, ULARGE_INTEGER *read,
+                                        ULARGE_INTEGER *written)
+{
+    return IStream_CopyTo(impl_from_PropStream(iface)->mem, dest, cb, read, written);
+}
+
+static HRESULT WINAPI PropStream_Commit(IStream *iface, DWORD flags)
+{
+    return PropStream_Store(impl_from_PropStream(iface));
+}
+
+static HRESULT WINAPI PropStream_Revert(IStream *iface)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI PropStream_LockRegion(IStream *iface, ULARGE_INTEGER off, ULARGE_INTEGER cb, DWORD type)
+{
+    return STG_E_INVALIDFUNCTION;
+}
+
+static HRESULT WINAPI PropStream_UnlockRegion(IStream *iface, ULARGE_INTEGER off, ULARGE_INTEGER cb, DWORD type)
+{
+    return STG_E_INVALIDFUNCTION;
+}
+
+static HRESULT WINAPI PropStream_Stat(IStream *iface, STATSTG *stat, DWORD flags)
+{
+    return IStream_Stat(impl_from_PropStream(iface)->mem, stat, flags);
+}
+
+static HRESULT WINAPI PropStream_Clone(IStream *iface, IStream **clone)
+{
+    *clone = NULL;
+    return E_NOTIMPL;
+}
+
+static const IStreamVtbl PropStream_vtbl =
+{
+    PropStream_QueryInterface,
+    PropStream_AddRef,
+    PropStream_Release,
+    PropStream_Read,
+    PropStream_Write,
+    PropStream_Seek,
+    PropStream_SetSize,
+    PropStream_CopyTo,
+    PropStream_Commit,
+    PropStream_Revert,
+    PropStream_LockRegion,
+    PropStream_UnlockRegion,
+    PropStream_Stat,
+    PropStream_Clone
+};
