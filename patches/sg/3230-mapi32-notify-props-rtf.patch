+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "objbase.h"
+#include "mapival.h"
+#include "mapiutil.h"
+#include "wine/debug.h"
+#include "util.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mapi);
+
+#define RTF_HEADER_SIZE 16
+#define RTF_DICT_SIZE   4096
+
+static const char rtf_prebuf[] =
+    "{\\rtf1\\ansi\\mac\\deff0\\deftab720{\\fonttbl;}{\\f0\\fnil \\froman \\fswiss \\fmodern \\fscript \\fdecor "
+    "MS Sans SerifSymbolArialTimes New RomanCourier{\\colortbl\\red0\\green0\\blue0\r\n\\par \\pard\\plain\\f0"
+    "\\fs20\\b\\i\\u\\tab\\tx";
+#define RTF_PREBUF_SIZE (sizeof(rtf_prebuf) - 1)
+
+static DWORD read_dword(const BYTE *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((DWORD)p[3] << 24);
+}
+
+static void write_dword(BYTE *p, DWORD v)
+{
+    p[0] = v;
+    p[1] = v >> 8;
+    p[2] = v >> 16;
+    p[3] = v >> 24;
+}
+
+static DWORD rtf_crc32(const BYTE *data, SIZE_T size)
+{
+    static DWORD table[256];
+    static BOOL init;
+    DWORD crc = 0;
+    SIZE_T i;
+
+    if (!init)
+    {
+        DWORD n, k, c;
+        for (n = 0; n < 256; n++)
+        {
+            c = n;
+            for (k = 0; k < 8; k++) c = (c & 1) ? 0xedb88320 ^ (c >> 1) : c >> 1;
+            table[n] = c;
+        }
+        init = TRUE;
+    }
+    for (i = 0; i < size; i++) crc = table[(crc ^ data[i]) & 0xff] ^ (crc >> 8);
+    return crc;
+}
+
+/* The raw text of the compressed data. *OUT is allocated. */
+static HRESULT rtf_decompress(const BYTE *in, SIZE_T in_size, BYTE **out, SIZE_T *out_size)
+{
+    BYTE dict[RTF_DICT_SIZE];
+    DWORD comp_size, raw_size, type;
+    SIZE_T pos, end, n = 0;
+    unsigned int wp;
+    BOOL done = FALSE;
+    BYTE *buf;
+
+    *out = NULL;
+    *out_size = 0;
+    if (in_size < RTF_HEADER_SIZE) return MAPI_E_CORRUPT_DATA;
+    comp_size = read_dword(in);
+    raw_size = read_dword(in + 4);
+    type = read_dword(in + 8);
+    /* the size counts what follows its own field */
+    if (comp_size < 12 || comp_size > in_size - 4) comp_size = in_size - 4;
+
+    if (type == 0x414c454d)   /* "MELA": the text is not compressed */
+    {
+        SIZE_T have = comp_size - 12;
+
+        if (raw_size > have) return MAPI_E_CORRUPT_DATA;
+        if (!(buf = malloc(raw_size ? raw_size : 1))) return MAPI_E_NOT_ENOUGH_MEMORY;
+        memcpy(buf, in + RTF_HEADER_SIZE, raw_size);
+        *out = buf;
+        *out_size = raw_size;
+        return S_OK;
+    }
+#ifndef SG_MUTANT_MAPI_BADTYPE
+    if (type != 0x75465a4c) return MAPI_E_CORRUPT_DATA;   /* "LZFu" */
+#endif
+    if (raw_size > 0x40000000) return MAPI_E_CORRUPT_DATA;
+
+    if (!(buf = malloc(raw_size ? raw_size : 1))) return MAPI_E_NOT_ENOUGH_MEMORY;
+#ifdef SG_MUTANT_MAPI_PREBUF
+    memset(dict, ' ', RTF_PREBUF_SIZE);
+#else
+    memcpy(dict, rtf_prebuf, RTF_PREBUF_SIZE);
+#endif
+    memset(dict + RTF_PREBUF_SIZE, 0, RTF_DICT_SIZE - RTF_PREBUF_SIZE);
+    wp = RTF_PREBUF_SIZE;
+
+    end = comp_size + 4;
+    pos = RTF_HEADER_SIZE;
+    while (pos < end && !done)
+    {
+        BYTE flags = in[pos++];
+        int bit;
+
+        for (bit = 0; bit < 8 && pos < end; bit++, flags >>= 1)
+        {
+            if (!(flags & 1))
+            {
+                BYTE c = in[pos++];
+
+                if (n < raw_size) buf[n++] = c;
+                dict[wp] = c;
+                wp = (wp + 1) & (RTF_DICT_SIZE - 1);
+            }
+            else
+            {
+                unsigned int off, len, i;
+
+                if (pos + 2 > end)
+                {
+                    pos = end;
+                    break;
+                }
+                off = (in[pos] << 4) | (in[pos + 1] >> 4);
+                len = (in[pos + 1] & 0xf) + 2;
+                pos += 2;
+                /* a reference to the write position is the end */
+                if (off == wp)
+                {
+                    done = TRUE;
+                    break;
+                }
+                for (i = 0; i < len; i++)
+                {
+                    BYTE c = dict[off];
+
+                    if (n < raw_size) buf[n++] = c;
+                    dict[wp] = c;
+                    wp = (wp + 1) & (RTF_DICT_SIZE - 1);
+                    off = (off + 1) & (RTF_DICT_SIZE - 1);
+                }
+            }
+        }
+    }
+#ifdef SG_MUTANT_MAPI_SIZECHECK
+    if (FALSE)
+#else
+    if (n != raw_size)
+#endif
+    {
+        free(buf);
+        return MAPI_E_CORRUPT_DATA;
+    }
+    *out = buf;
+    *out_size = n;
+    return S_OK;
+}
+
+/* The compressed form of the text, with the header; or the text as it is, with a header of
+ * the other type. *OUT is allocated. */
+static HRESULT rtf_compress(const BYTE *raw, SIZE_T raw_size, BOOL store_raw, BYTE **out, SIZE_T *out_size)
+{
+    BYTE *buf, *p, *flags_at;
+    BYTE *lin;             /* the dictionary text followed by the raw data: positions are in it */
+    int *head, *prev;
+    SIZE_T i, lin_size = RTF_PREBUF_SIZE + raw_size, max;
+    int flag_bit = 0;
+
+    *out = NULL;
+    *out_size = 0;
+
+    if (store_raw)
+    {
+        if (!(buf = malloc(RTF_HEADER_SIZE + raw_size))) return MAPI_E_NOT_ENOUGH_MEMORY;
+        write_dword(buf, raw_size + 12);
+        write_dword(buf + 4, raw_size);
+#ifdef SG_MUTANT_MAPI_MELA
+        write_dword(buf + 8, 0x75465a4c);
+#else
+        write_dword(buf + 8, 0x414c454d);
+#endif
+        write_dword(buf + 12, 0);
+        memcpy(buf + RTF_HEADER_SIZE, raw, raw_size);
+        *out = buf;
+        *out_size = RTF_HEADER_SIZE + raw_size;
+        return S_OK;
+    }
+
+    /* the worst case is a flag byte for every 8 literals, and the end token */
+    max = RTF_HEADER_SIZE + raw_size + raw_size / 8 + 8;
+    if (!(buf = malloc(max)) || !(lin = malloc(lin_size ? lin_size : 1)) ||
+        !(head = malloc(65536 * sizeof(int))) || !(prev = malloc((lin_size ? lin_size : 1) * sizeof(int))))
+    {
+        free(buf);
+        return MAPI_E_NOT_ENOUGH_MEMORY;
+    }
+    memcpy(lin, rtf_prebuf, RTF_PREBUF_SIZE);
+    memcpy(lin + RTF_PREBUF_SIZE, raw, raw_size);
+    for (i = 0; i < 65536; i++) head[i] = -1;
+
+    /* chains of the positions that start with the same three bytes */
+#define HASH3(q) ((((q)[0] << 8) ^ ((q)[1] << 4) ^ (q)[2]) & 0xffff)
+    for (i = 0; i + 2 < RTF_PREBUF_SIZE; i++)
+    {
+        unsigned int h = HASH3(lin + i);
+        prev[i] = head[h];
+        head[h] = i;
+    }
+
+    p = buf + RTF_HEADER_SIZE;
+    flags_at = p++;
+    *flags_at = 0;
+    for (i = RTF_PREBUF_SIZE; i < lin_size;)
+    {
+        int best_len = 0, best_pos = 0, cand, tries = 0;
+
+        if (i + 2 < lin_size)
+        {
+            for (cand = head[HASH3(lin + i)]; cand >= 0 && tries < 64; cand = prev[cand], tries++)
+            {
+                int len = 0;
+
+                if (i - cand >= RTF_DICT_SIZE - 1) break;
+                while (len < 17 && i + len < lin_size && lin[cand + len] == lin[i + len]) len++;
+                if (len > best_len)
+                {
+                    best_len = len;
+                    best_pos = cand;
+                    if (len == 17) break;
+                }
+            }
+        }
+        if (flag_bit == 8)
+        {
+            flags_at = p++;
+            *flags_at = 0;
+            flag_bit = 0;
+        }
+        if (best_len >= 3)
+        {
+            unsigned int off = best_pos & (RTF_DICT_SIZE - 1), k;
+
+            *flags_at |= 1 << flag_bit;
+            *p++ = off >> 4;
+            *p++ = ((off & 0xf) << 4) | (best_len - 2);
+            for (k = 0; k < best_len; k++, i++)
+                if (i + 2 < lin_size)
+                {
+                    unsigned int h = HASH3(lin + i);
+                    prev[i] = head[h];
+                    head[h] = i;
+                }
+        }
+        else
+        {
+            *p++ = lin[i];
+            if (i + 2 < lin_size)
+            {
+                unsigned int h = HASH3(lin + i);
+                prev[i] = head[h];
+                head[h] = i;
+            }
+            i++;
+        }
+        flag_bit++;
+    }
+    /* the end: a reference to the position that is written next */
+    if (flag_bit == 8)
+    {
+        flags_at = p++;
+        *flags_at = 0;
+        flag_bit = 0;
+    }
+    {
+        unsigned int off = lin_size & (RTF_DICT_SIZE - 1);
+
+        *flags_at |= 1 << flag_bit;
+        *p++ = off >> 4;
+#ifdef SG_MUTANT_MAPI_ENDMARK
+        *p++ = ((off + 1) & 0xf) << 4;
+#else
+        *p++ = (off & 0xf) << 4;
+#endif
+    }
+
+    *out_size = p - buf;
+#ifdef SG_MUTANT_MAPI_COMPSIZE
+    write_dword(buf, *out_size);
+#else
+    write_dword(buf, *out_size - 4);
+#endif
+    write_dword(buf + 4, raw_size);
+    write_dword(buf + 8, 0x75465a4c);
+#ifdef SG_MUTANT_MAPI_CRC
+    write_dword(buf + 12, 0);
+#else
+    write_dword(buf + 12, rtf_crc32(buf + RTF_HEADER_SIZE, *out_size - RTF_HEADER_SIZE));
+#endif
+    free(lin);
+    free(head);
+    free(prev);
+    *out = buf;
+    return S_OK;
+}
+
+/* the stream of the text */
+struct rtf_stream
+{
+    IStream IStream_iface;
+    LONG ref;
+    IStream *compressed;
+    BOOL modify, uncompressed, dirty;
+    BYTE *data;
+    SIZE_T size, cap, pos;
+};
+
+static struct rtf_stream *impl_from_rtf(IStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct rtf_stream, IStream_iface);
+}
+
+/* put the text back in the stream of the property, in the compressed form */
+static HRESULT rtf_flush(struct rtf_stream *s)
+{
+    BYTE *out;
+    SIZE_T out_size;
+    ULARGE_INTEGER size;
+    LARGE_INTEGER zero = {{0}};
+    ULONG written;
+    HRESULT hr;
+
+    if (!s->modify || !s->dirty) return S_OK;
+    if (FAILED(hr = rtf_compress(s->data, s->size, s->uncompressed, &out, &out_size))) return hr;
+    size.QuadPart = 0;
+    if (SUCCEEDED(hr = IStream_Seek(s->compressed, zero, STREAM_SEEK_SET, NULL)) &&
+        SUCCEEDED(hr = IStream_SetSize(s->compressed, size)))
+        hr = IStream_Write(s->compressed, out, out_size, &written);
+    if (SUCCEEDED(hr) && written != out_size) hr = STG_E_MEDIUMFULL;
+    free(out);
+    if (SUCCEEDED(hr)) s->dirty = FALSE;
+    return hr;
+}
+
+static HRESULT WINAPI rtf_QueryInterface(IStream *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ISequentialStream) || IsEqualIID(riid, &IID_IStream))
+    {
+        *obj = iface;
+        IStream_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI rtf_AddRef(IStream *iface)
+{
+    return InterlockedIncrement(&impl_from_rtf(iface)->ref);
+}
+
+static ULONG WINAPI rtf_Release(IStream *iface)
+{
+    struct rtf_stream *s = impl_from_rtf(iface);
+    ULONG ref = InterlockedDecrement(&s->ref);
+
+    if (!ref)
+    {
+        rtf_flush(s);
+        IStream_Release(s->compressed);
+        free(s->data);
+        free(s);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI rtf_Read(IStream *iface, void *buf, ULONG cb, ULONG *read)
+{
+    struct rtf_stream *s = impl_from_rtf(iface);
+    SIZE_T n;
+
+    if (s->modify) return STG_E_ACCESSDENIED;
+    n = s->pos < s->size ? s->size - s->pos : 0;
+    if (n > cb) n = cb;
+    memcpy(buf, s->data + s->pos, n);
+    s->pos += n;
+    if (read) *read = n;
+    return n == cb ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI rtf_Write(IStream *iface, const void *buf, ULONG cb, ULONG *written)
+{
+    struct rtf_stream *s = impl_from_rtf(iface);
+
+#ifndef SG_MUTANT_MAPI_RTFRO
+    if (!s->modify) return STG_E_ACCESSDENIED;
+#endif
+    if (s->pos + cb > s->cap)
+    {
+        SIZE_T cap = max(s->cap * 2, s->pos + cb + 4096);
+        BYTE *data = realloc(s->data, cap);
+
+        if (!data) return STG_E_MEDIUMFULL;
+        s->data = data;
+        s->cap = cap;
+    }
+    memcpy(s->data + s->pos, buf, cb);
+    s->pos += cb;
+    if (s->pos > s->size) s->size = s->pos;
+    s->dirty = TRUE;
+    if (written) *written = cb;
+    return S_OK;
+}
+
+static HRESULT WINAPI rtf_Seek(IStream *iface, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *pos)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rtf_SetSize(IStream *iface, ULARGE_INTEGER size)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rtf_CopyTo(IStream *iface, IStream *dest, ULARGE_INTEGER cb, ULARGE_INTEGER *read,
+                                 ULARGE_INTEGER *written)
+{
+    struct rtf_stream *s = impl_from_rtf(iface);
+    SIZE_T n;
+    ULONG put = 0;
+    HRESULT hr;
+
+    if (s->modify) return STG_E_ACCESSDENIED;
+    n = s->pos < s->size ? s->size - s->pos : 0;
+    if (n > cb.QuadPart) n = cb.QuadPart;
+    hr = n ? IStream_Write(dest, s->data + s->pos, n, &put) : S_OK;
+    s->pos += n;
+    if (read) read->QuadPart = n;
+    if (written) written->QuadPart = put;
+    return hr;
+}
+
+static HRESULT WINAPI rtf_Commit(IStream *iface, DWORD flags)
+{
+    return rtf_flush(impl_from_rtf(iface));
+}
+
+static HRESULT WINAPI rtf_Revert(IStream *iface)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rtf_LockRegion(IStream *iface, ULARGE_INTEGER off, ULARGE_INTEGER cb, DWORD type)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rtf_UnlockRegion(IStream *iface, ULARGE_INTEGER off, ULARGE_INTEGER cb, DWORD type)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rtf_Stat(IStream *iface, STATSTG *stat, DWORD flags)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI rtf_Clone(IStream *iface, IStream **clone)
+{
+    return E_NOTIMPL;
+}
+
+static const IStreamVtbl rtf_vtbl =
+{
+    rtf_QueryInterface,
+    rtf_AddRef,
+    rtf_Release,
+    rtf_Read,
+    rtf_Write,
+    rtf_Seek,
+    rtf_SetSize,
+    rtf_CopyTo,
+    rtf_Commit,
+    rtf_Revert,
+    rtf_LockRegion,
+    rtf_UnlockRegion,
+    rtf_Stat,
+    rtf_Clone
+};
+
+/**************************************************************************
+ *  WrapCompressedRTFStream   (MAPI32.186)
+ *
+ * Wrap the stream of PR_RTF_COMPRESSED in a stream of the RTF text.
+ *
+ * PARAMS
+ *  compressed   [I] The stream of the compressed text, at its start
+ *  flags        [I] MAPI_MODIFY: the new text is written to the stream returned,
+ *                   STORE_UNCOMPRESSED_RTF: and kept as it is
+ *  uncompressed [O] The stream of the text
+ *
+ * RETURNS
+ *  Success: S_OK.
+ *  Failure: MAPI_E_INVALID_PARAMETER, MAPI_E_CORRUPT_DATA (the compressed data is not valid),
+ *           MAPI_E_NOT_ENOUGH_MEMORY.
+ *
+ * NOTES
+ *  The returned stream can be read, or written when MAPI_MODIFY is set, and not
+ *  both. It does not support Seek, SetSize, Stat, Clone, Revert and the locks.
+ */
+HRESULT WINAPI WrapCompressedRTFStream(LPSTREAM compressed, ULONG flags, LPSTREAM *uncompressed)
+{
+    struct rtf_stream *s;
+    BYTE *raw = NULL, *comp = NULL;
+    SIZE_T raw_size = 0, comp_size = 0, cap = 0;
+    HRESULT hr = S_OK;
+
+    if (mapiFunctions.WrapCompressedRTFStream)
+        return mapiFunctions.WrapCompressedRTFStream(compressed, flags, uncompressed);
+
+    TRACE("(%p, 0x%08lx, %p)\n", compressed, flags, uncompressed);
+
+    if (!compressed || !uncompressed || (flags & ~(MAPI_MODIFY | STORE_UNCOMPRESSED_RTF)))
+        return MAPI_E_INVALID_PARAMETER;
+    *uncompressed = NULL;
+
+    if (!(s = calloc(1, sizeof(*s)))) return MAPI_E_NOT_ENOUGH_MEMORY;
+    s->modify = (flags & MAPI_MODIFY) != 0;
+    s->uncompressed = (flags & STORE_UNCOMPRESSED_RTF) != 0;
+
+    if (!s->modify)
+    {
+        /* the whole stream is read and expanded */
+        for (;;)
+        {
+            ULONG got = 0;
+
+            if (comp_size + 4096 > cap)
+            {
+                BYTE *grown = realloc(comp, cap = max(cap * 2, comp_size + 8192));
+
+                if (!grown)
+                {
+                    hr = MAPI_E_NOT_ENOUGH_MEMORY;
+                    break;
+                }
+                comp = grown;
+            }
+            hr = IStream_Read(compressed, comp + comp_size, 4096, &got);
+            if (FAILED(hr)) break;
+            comp_size += got;
+            if (got < 4096)
+            {
+                hr = S_OK;
+                break;
+            }
+        }
+        if (SUCCEEDED(hr)) hr = rtf_decompress(comp, comp_size, &raw, &raw_size);
+        free(comp);
+        if (FAILED(hr))
+        {
+            free(s);
+            return hr;
+        }
+        s->data = raw;
+        s->size = s->cap = raw_size;
+    }
+
+    s->IStream_iface.lpVtbl = &rtf_vtbl;
+    s->ref = 1;
+    s->compressed = compressed;
+    IStream_AddRef(compressed);
+    *uncompressed = &s->IStream_iface;
+    return S_OK;
+}
