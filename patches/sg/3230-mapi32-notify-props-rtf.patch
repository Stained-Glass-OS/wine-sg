+            LPSPropValue existing = NULL;
+
+            if (SUCCEEDED(IMAPIProp_GetProps(dst, &one, 0, &got, &existing)) && existing)
+            {
+                BOOL there = PROP_TYPE(existing[0].ulPropTag) != PT_ERROR;
+                MAPIFreeBuffer(existing);
+                if (there) continue;
+            }
+        }
+
+        {
+            LPSPropProblemArray dprobs = NULL;
+            SPropValue copy = *value;
+
+            sc = IMAPIProp_SetProps(dst, 1, &copy, &dprobs);
+            if (SUCCEEDED(sc) && dprobs && dprobs->cProblem) sc = dprobs->aProblem[0].scode;
