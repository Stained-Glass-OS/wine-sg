+/* Internal - the properties of the object to copy: those of the include list, or
+ * all but those of the exclude list. A problem is added to the array when a
+ * property cannot go. */
+static HRESULT IPropData_CopyInternal(IPropDataImpl *This, LPSPropTagArray lpIncl, LPSPropTagArray lpExcl,
+                                      LPCIID lpIface, LPVOID lpDstObj, ULONG ulFlags,
+                                      LPSPropProblemArray *lppProbs)
+{
