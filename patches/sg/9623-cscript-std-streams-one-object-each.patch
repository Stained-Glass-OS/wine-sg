From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cscript: WScript.StdIn, StdOut and StdErr are one stream each (9623)

The filter loop console scripts use,
  Do Until WScript.StdIn.AtEndOfStream : line = WScript.StdIn.ReadLine : Loop
failed at its first ReadLine with "Input past end of file" when the input came
from a file or a pipe (type x.txt | cscript filter.vbs, WshShell.Exec's
StdIn): every WScript.StdIn made a new text stream, so what AtEndOfStream had
read ahead into the first one's buffer was lost and the next stream started at
the end. As on Windows, each of the three is one object for the script's run.
---
--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -945,6 +945,8 @@
 }
 
 /* the process's standard streams as text streams of the scripting runtime */
+static ITextStream *std_streams[3];
+
 static HRESULT get_std_stream(int type, ITextStream **out)
 {
     static const WCHAR *method = L"GetStandardStream";
@@ -961,6 +963,17 @@
 #ifdef SG_MUTANT_WSH_NOSTD
     return E_NOTIMPL;
 #endif
+    /* WScript.StdIn, StdOut and StdErr are one object each, as on Windows: a script that asks
+     * WScript.StdIn.AtEndOfStream and then WScript.StdIn.ReadLine reads what the first one
+     * buffered (a new stream each time lost it: input from a file or a pipe read as empty,
+     * wine-sg 9623) */
+#ifndef SG_MUTANT_WSH_STD_NEW_EACH_TIME
+    if(std_streams[type]) {
+        ITextStream_AddRef(std_streams[type]);
+        *out = std_streams[type];
+        return S_OK;
+    }
+#endif
 #ifndef CSCRIPT_BUILD
     /* the GUI host has no console streams */
     return HRESULT_FROM_WIN32(ERROR_INVALID_HANDLE);
@@ -992,6 +1005,10 @@
         }
     }
     IDispatch_Release(fso);
+    if(SUCCEEDED(hres) && *out) {
+        ITextStream_AddRef(*out);
+        std_streams[type] = *out;
+    }
     return hres;
 }
 
