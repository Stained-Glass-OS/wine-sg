From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: Task View and Alt+Tab picture every window

Task View's and Alt+Tab's thumbnails came from the screen while a window
was in front, so a window never active showed only its icon. With
PrintWindow across processes (0076) each window is pictured from what it
last drew -- on another desktop, covered, or never active -- when Task View
or Alt+Tab opens; the screen remains the fallback.
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -77,10 +77,9 @@
 
 /* ---- thumbnails ------------------------------------------------------- */
 
-/* The last picture of each window, taken from the screen while it was the
- * foreground window (so on top and unobscured): cross-process PrintWindow
- * does not exist in Wine, a cloaked window has no pixels on the screen, and
- * this keeps a recent picture of every window that was ever active. */
+/* A picture of each window: what it last drew, through PrintWindow with
+ * PW_RENDERFULLCONTENT (other processes' windows too, wine-sg 0076), taken
+ * when Task View or Alt+Tab opens and while a window is in front. */
 struct thumb
 {
     struct list entry;
@@ -101,13 +100,12 @@
 {
     struct thumb *t;
     RECT rc, screen;
-    HDC sdc, mdc;
-    HBITMAP bmp;
+    HDC sdc, mdc, full;
+    HBITMAP bmp, whole;
     int w, h, tw, th;
+    BOOL printed = FALSE;
 
     if (!GetWindowRect( hwnd, &rc ) || IsIconic( hwnd )) return;
-    SetRect( &screen, 0, 0, GetSystemMetrics( SM_CXSCREEN ), GetSystemMetrics( SM_CYSCREEN ));
-    if (!IntersectRect( &rc, &rc, &screen )) return;
     w = rc.right - rc.left; h = rc.bottom - rc.top;
     if (w < 16 || h < 16) return;
     /* keep them small: 480 px on the long side */
@@ -119,7 +117,27 @@
     bmp = CreateCompatibleBitmap( sdc, tw, th );
     SelectObject( mdc, bmp );
     SetStretchBltMode( mdc, HALFTONE );
-    StretchBlt( mdc, 0, 0, tw, th, sdc, rc.left, rc.top, w, h, SRCCOPY );
+
+    /* what the window last drew -- even cloaked on another desktop, or
+     * covered (cross-process PrintWindow, wine-sg 0076) */
+    full = CreateCompatibleDC( sdc );
+    whole = CreateCompatibleBitmap( sdc, w, h );
+    SelectObject( full, whole );
+    if (PrintWindow( hwnd, full, PW_RENDERFULLCONTENT ))
+    {
+        StretchBlt( mdc, 0, 0, tw, th, full, 0, 0, w, h, SRCCOPY );
+        printed = TRUE;
+    }
+    DeleteDC( full );
+    DeleteObject( whole );
+
+    if (!printed)
+    {
+        /* from the screen, where it is on top */
+        SetRect( &screen, 0, 0, GetSystemMetrics( SM_CXSCREEN ), GetSystemMetrics( SM_CYSCREEN ));
+        if (!IntersectRect( &rc, &rc, &screen )) { DeleteDC( mdc ); DeleteObject( bmp ); ReleaseDC( 0, sdc ); return; }
+        StretchBlt( mdc, 0, 0, tw, th, sdc, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SRCCOPY );
+    }
     DeleteDC( mdc );
     ReleaseDC( 0, sdc );
 
@@ -517,6 +535,7 @@
     tv.n = 0;
     EnumWindows( collect_proc, tv.shown );
     if (!tv.n) return;
+    for (i = 0; i < tv.n; i++) if (!find_thumb( tv.items[i].hwnd )) capture_thumb( tv.items[i].hwnd );
     cols = 1;
     while (cols * cols < tv.n) cols++;
     rows = (tv.n + cols - 1) / cols;
@@ -912,14 +931,18 @@
     return DefWindowProcW( hwnd, msg, wp, lp );
 }
 
+static BOOL CALLBACK refresh_thumb_proc( HWND hwnd, LPARAM lparam )
+{
+    if (IsWindowVisible( hwnd ) && is_app_window( hwnd )) capture_thumb( hwnd );
+    return TRUE;
+}
+
 void vd_taskview( BOOL toggle )
 {
     RECT work;
-    HWND fg;
 
     if (taskview) { if (toggle) tv_close(); return; }
-    if ((fg = GetForegroundWindow()) && (fg = GetAncestor( fg, GA_ROOTOWNER )) && is_app_window( fg ))
-        capture_thumb( fg );
+    EnumWindows( refresh_thumb_proc, 0 );
     SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
     taskview = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW, L"SgTaskView", L"Task View", WS_POPUP,
                                 work.left, work.top, work.right - work.left, work.bottom - work.top,
@@ -1071,7 +1094,7 @@
 void vd_alttab( BOOL back )
 {
     HWND fg;
-    int w, h;
+    int w, h, i;
 
     if (switcher)
     {
@@ -1085,6 +1108,7 @@
     sw.n = 0;
     EnumWindows( switcher_collect, 0 );
     if (sw.n < 1) return;
+    for (i = 0; i < sw.n; i++) capture_thumb( sw.items[i] );
     /* the first press already moves to the previous window, as on Windows */
     sw.sel = sw.n > 1 ? (back ? sw.n - 1 : 1) : 0;
     w = min( sw.n, (GetSystemMetrics( SM_CXSCREEN ) - 64) / SW_CELL_W ) * SW_CELL_W + 32;
