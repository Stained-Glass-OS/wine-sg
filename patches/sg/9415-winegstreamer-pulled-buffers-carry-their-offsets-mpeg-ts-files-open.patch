From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winegstreamer: Pulled buffers carry their offsets -- MPEG-TS files open (9415)

GStreamer's MPEG-TS demuxer takes the stream's sync point from the offset
its source writes on each buffer. Wine's source pad left the offset unset
(-1): the demuxer began reading at offset -1, reached the end at once
("No program activated before EOS"), and no .ts/.m2ts/.mts file opened
in Media Foundation (MF_E_UNSUPPORTED_BYTESTREAM_TYPE) or DirectShow
(VFW_E_CANNOT_RENDER). The buffers the pad hands out now carry their
offset and end offset, as GStreamer's own sources' do.
---
--- a/dlls/winegstreamer/wg_parser.c
+++ b/dlls/winegstreamer/wg_parser.c
@@ -1240,6 +1240,7 @@
         guint64 offset, guint size, GstBuffer **buffer)
 {
     struct wg_parser *parser = gst_pad_get_element_private(pad);
+    GstFlowReturn ret;
 
     GST_LOG("pad %p, offset %" G_GINT64_MODIFIER "u, size %u, buffer %p.", pad, offset, size, *buffer);
 
@@ -1260,15 +1261,29 @@
     }
 
     if (size >= input_cache_chunk_size || sizeof(void*) == 4)
-        return issue_read_request(parser, offset, size, buffer);
-
-    if (offset >= parser->file_size)
+        ret = issue_read_request(parser, offset, size, buffer);
+    else if (offset >= parser->file_size)
         return GST_FLOW_EOS;
+    else
+    {
+        if ((offset + size) >= parser->file_size)
+            size = parser->file_size - offset;
+        ret = read_input_cache(parser, offset, size, buffer);
+    }
 
-    if ((offset + size) >= parser->file_size)
-        size = parser->file_size - offset;
-
-    return read_input_cache(parser, offset, size, buffer);
+    /* Stained Glass OS (wine-sg 9415): the buffer says where in the stream it
+     * is, as a GStreamer source's do. The MPEG-TS demuxer takes the stream's
+     * sync point from it: without, it began reading at offset -1, reached the
+     * end at once ("No program activated before EOS"), and no .ts/.m2ts file
+     * could be opened. */
+#ifndef SG_MUTANT_PULL_NO_OFFSET
+    if (ret == GST_FLOW_OK && *buffer)
+    {
+        GST_BUFFER_OFFSET(*buffer) = offset;
+        GST_BUFFER_OFFSET_END(*buffer) = offset + gst_buffer_get_size(*buffer);
+    }
+#endif
+    return ret;
 }
 
 static gboolean src_query_cb(GstPad *pad, GstObject *parent, GstQuery *query)
