+static inline struct media_control *impl_from_IWeakReference( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct media_control, IWeakReference_iface );
+}
+
+static HRESULT WINAPI media_control_weak_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    struct media_control *impl = impl_from_IWeakReference( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference ))
+    {
+        *out = &impl->IWeakReference_iface;
+        IWeakReference_AddRef( &impl->IWeakReference_iface );
+        return S_OK;
+    }
