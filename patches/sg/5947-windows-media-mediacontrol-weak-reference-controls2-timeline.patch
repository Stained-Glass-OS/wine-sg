+}
+
+static ULONG WINAPI media_control_weak_Release( IWeakReference *iface )
+{
+    struct media_control *impl = impl_from_IWeakReference( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref_weak );
+    if (!ref) free( impl );
     return ref;
 }
 
+/* the object, while someone still holds it (else NULL, as Windows answers) */
+static HRESULT WINAPI media_control_weak_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    struct media_control *impl = impl_from_IWeakReference( iface );
+    HRESULT hr;
+    LONG ref;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    *out = NULL;
+    do
+    {
+        if (!(ref = ReadNoFence( &impl->ref ))) return S_OK;
+    } while (ref != InterlockedCompareExchange( &impl->ref, ref + 1, ref ));
+    IWeakReference_AddRef( &impl->IWeakReference_iface );   /* as media_control_AddRef */
+
+    hr = ISystemMediaTransportControls_QueryInterface( &impl->ISystemMediaTransportControls_iface, iid, (void **)out );
+    ISystemMediaTransportControls_Release( &impl->ISystemMediaTransportControls_iface );
+    return hr;
+}
