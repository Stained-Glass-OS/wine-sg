+/* a mitigation policy's flags from the options the process was created with
+ * (CreateProcess's PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY and
+ * CHILD_PROCESS_POLICY), as the server keeps them */
+static ULONG creation_mitigation_flags( HANDLE handle, PROCESS_MITIGATION_POLICY which )
+{
+    ULONG64 opts = 0, opts2 = 0;
+    unsigned int child = 0, status;
+    ULONG flags = 0;
+
+#define OPT(mask, value) ((opts & (mask)) == (value))
+    SERVER_START_REQ( get_process_creation_policy )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        if (!(status = wine_server_call( req )))
+        {
+            child = reply->child_policy;
+            opts  = reply->mitigation;
+            opts2 = reply->mitigation2;
+        }
+    }
+    SERVER_END_REQ;
+    if (status) return 0;
+
+    switch (which)
+    {
+    case ProcessASLRPolicy:
+        if (OPT( 3ull << 16, 1ull << 16 )) flags |= 1;   /* EnableBottomUpRandomization */
+        if (OPT( 3ull << 8, 1ull << 8 ) || OPT( 3ull << 8, 3ull << 8 )) flags |= 2;   /* EnableForceRelocateImages */
+        if (OPT( 3ull << 20, 1ull << 20 )) flags |= 4;   /* EnableHighEntropy */
+        if (OPT( 3ull << 8, 3ull << 8 )) flags |= 8;     /* DisallowStrippedImages */
+        break;
+    case ProcessDynamicCodePolicy:
+        if (OPT( 3ull << 36, 1ull << 36 )) flags |= 1;   /* ProhibitDynamicCode */
+        if (OPT( 3ull << 36, 3ull << 36 )) flags |= 1 | 2;   /* ... AllowThreadOptOut */
+        if ((opts2 & (3ull << 20)) == (1ull << 20)) flags |= 4;   /* AllowRemoteDowngrade */
+        break;
+    case ProcessStrictHandleCheckPolicy:
+        if (OPT( 3ull << 24, 1ull << 24 )) flags |= 1 | 2;
+        break;
+    case ProcessSystemCallDisablePolicy:
+        if (OPT( 3ull << 28, 1ull << 28 )) flags |= 1;   /* DisallowWin32kSystemCalls */
+        break;
+    case ProcessExtensionPointDisablePolicy:
+        if (OPT( 3ull << 32, 1ull << 32 )) flags |= 1;
+        break;
+    case ProcessSignaturePolicy:
+        if (OPT( 3ull << 44, 1ull << 44 )) flags |= 1;   /* MicrosoftSignedOnly */
+        if (OPT( 3ull << 44, 3ull << 44 )) flags |= 2;   /* StoreSignedOnly */
+        break;
+    case ProcessFontDisablePolicy:
+        if (OPT( 3ull << 48, 1ull << 48 )) flags |= 1;   /* DisableNonSystemFonts */
+        if (OPT( 3ull << 48, 3ull << 48 )) flags |= 2;   /* AuditNonSystemFontLoading */
+        break;
+    case ProcessImageLoadPolicy:
+        if (OPT( 3ull << 52, 1ull << 52 )) flags |= 1;   /* NoRemoteImages */
+        if (OPT( 3ull << 56, 1ull << 56 )) flags |= 2;   /* NoLowMandatoryLabelImages */
+        if (OPT( 3ull << 60, 1ull << 60 )) flags |= 4;   /* PreferSystem32Images */
+        break;
+    case ProcessChildProcessPolicy:
+        if (child & PROCESS_CREATION_CHILD_PROCESS_RESTRICTED) flags |= 1;   /* NoChildProcessCreation */
+        if (child & PROCESS_CREATION_CHILD_PROCESS_RESTRICTED_UNLESS_SECURE) flags |= 4;   /* AllowSecureProcessCreation */
+        break;
+    default:
+        break;
+    }
+#undef OPT
+#ifdef SG_MUTANT_NO_CREATION_POLICY
+    flags = 0;
+#endif
+    return flags;
+}
