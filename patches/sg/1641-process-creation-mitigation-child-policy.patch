-        if (mitigation_policies[policy->Policy] & ~policy->Flags) return STATUS_ACCESS_DENIED;
+        if ((mitigation_policies[policy->Policy] | creation_mitigation_flags( handle, policy->Policy )) & ~policy->Flags)
+            return STATUS_ACCESS_DENIED;
+        if (policy->Policy == ProcessChildProcessPolicy && (policy->Flags & 1 /* NoChildProcessCreation */))
+        {
+            /* the server holds it to it */
+            SERVER_START_REQ( set_process_info )
+            {
+                req->handle       = wine_server_obj_handle( handle );
+                req->mask         = SET_PROCESS_INFO_CHILD_POLICY;
+                req->child_policy = PROCESS_CREATION_CHILD_PROCESS_RESTRICTED;
+                ret = wine_server_call( req );
+            }
+            SERVER_END_REQ;
+            if (ret) return ret;
+        }
         mitigation_policies[policy->Policy] |= policy->Flags;
         break;
     }
