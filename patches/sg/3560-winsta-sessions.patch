 }
 
+HANDLE WINAPI WinStationOpenServerW( WCHAR *name )
+{
+    TRACE( "%s\n", debugstr_w( name ) );
+    return WTSOpenServerW( name );
+}
+
+HANDLE WINAPI WinStationOpenServerA( char *name )
+{
+    TRACE( "%s\n", debugstr_a( name ) );
+    return WTSOpenServerA( name );
+}
+
+BOOLEAN WINAPI WinStationCloseServer( HANDLE server )
+{
+    TRACE( "%p\n", server );
+    WTSCloseServer( server );
+    return TRUE;
+}
+
+BOOLEAN WINAPI WinStationFreeMemory( void *ptr )
+{
+    TRACE( "%p\n", ptr );
+    LocalFree( ptr );
+    return TRUE;
+}
+
 BOOLEAN WINAPI WinStationEnumerateW( HANDLE server, PSESSIONIDW *sessionids, ULONG *count )
 {
-    FIXME( "%p %p %p\n", server, sessionids, count );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    WTS_SESSION_INFOW *sessions;
+    SESSIONIDW *ids;
+    DWORD n, i;
+
+    TRACE( "%p %p %p\n", server, sessionids, count );
+
+    if (!sessionids || !count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!WTSEnumerateSessionsW( server, 0, 1, &sessions, &n )) return FALSE;
+
+    if (!(ids = LocalAlloc( LMEM_ZEROINIT, max( n, 1 ) * sizeof(*ids) )))
+    {
+        WTSFreeMemory( sessions );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    for (i = 0; i < n; i++)
+    {
+        ids[i].SessionId = sessions[i].SessionId;
+        lstrcpynW( ids[i].WinStationName, sessions[i].pWinStationName, ARRAY_SIZE(ids[i].WinStationName) );
+        /* WTS_CONNECTSTATE_CLASS and WINSTATIONSTATECLASS list the states in the same order */
+        ids[i].State = sessions[i].State;
+    }
+    WTSFreeMemory( sessions );
+    *sessionids = ids;
+    *count = n;
+    return TRUE;
+}
+
+static BOOLEAN find_session( HANDLE server, const SESSIONIDW *match_by_id, const WCHAR *match_name, SESSIONIDW *found )
+{
+    SESSIONIDW *ids;
+    ULONG count, i;
+    BOOLEAN ret = FALSE;
+
+    if (!WinStationEnumerateW( server, &ids, &count )) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        if (match_by_id ? ids[i].SessionId == match_by_id->SessionId : !wcsicmp( ids[i].WinStationName, match_name ))
+        {
+            *found = ids[i];
+            ret = TRUE;
+            break;
+        }
+    }
+    WinStationFreeMemory( ids );
+    if (!ret) SetLastError( ERROR_CTX_WINSTATION_NOT_FOUND );
+    return ret;
+}
+
+BOOLEAN WINAPI WinStationNameFromLogonIdW( HANDLE server, ULONG logon_id, WCHAR *name )
+{
+    SESSIONIDW key = { { logon_id } }, session;
+
+    TRACE( "%p %lu %p\n", server, logon_id, name );
+
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!find_session( server, &key, NULL, &session )) return FALSE;
+    /* the buffer is a WINSTATIONNAME */
+    wcscpy( name, session.WinStationName );
+    return TRUE;
+}
+
+BOOLEAN WINAPI WinStationNameFromLogonIdA( HANDLE server, ULONG logon_id, char *name )
+{
+    WINSTATIONNAME nameW;
+
+    TRACE( "%p %lu %p\n", server, logon_id, name );
+
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!WinStationNameFromLogonIdW( server, logon_id, nameW )) return FALSE;
+    return !!WideCharToMultiByte( CP_ACP, 0, nameW, -1, name, ARRAY_SIZE(nameW), NULL, NULL );
+}
+
+BOOLEAN WINAPI LogonIdFromWinStationNameW( HANDLE server, const WCHAR *name, ULONG *logon_id )
+{
+    SESSIONIDW session;
+
+    TRACE( "%p %s %p\n", server, debugstr_w( name ), logon_id );
+
+    if (!name || !logon_id)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!find_session( server, NULL, name, &session )) return FALSE;
+    *logon_id = session.SessionId;
+    return TRUE;
+}
+
+BOOLEAN WINAPI LogonIdFromWinStationNameA( HANDLE server, const char *name, ULONG *logon_id )
+{
+    WCHAR nameW[WINSTATIONNAME_LENGTH + 1];
+
+    TRACE( "%p %s %p\n", server, debugstr_a( name ), logon_id );
+
+    if (!name || !MultiByteToWideChar( CP_ACP, 0, name, -1, nameW, ARRAY_SIZE(nameW) ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return LogonIdFromWinStationNameW( server, nameW, logon_id );
+}
+
+BOOLEAN WINAPI WinStationIsHelpAssistantSession( HANDLE server, ULONG session_id )
+{
+    TRACE( "%p %lu\n", server, session_id );
+    /* there is no Remote Assistance session */
     return FALSE;
 }
+
+BOOLEAN WINAPI WinStationDisconnect( HANDLE server, ULONG session_id, BOOLEAN wait )
+{
+    TRACE( "%p %lu %d\n", server, session_id, wait );
+    return WTSDisconnectSession( server, session_id, wait );
+}
+
+BOOLEAN WINAPI WinStationReset( HANDLE server, ULONG session_id, BOOLEAN wait )
+{
+    TRACE( "%p %lu %d\n", server, session_id, wait );
+    return WTSLogoffSession( server, session_id, wait );
+}
+
+BOOLEAN WINAPI WinStationTerminateProcess( HANDLE server, ULONG process_id, ULONG exit_code )
+{
+    TRACE( "%p %lu %lu\n", server, process_id, exit_code );
+    return WTSTerminateProcess( server, process_id, exit_code );
+}
+
+BOOLEAN WINAPI WinStationSendMessageW( HANDLE server, ULONG session_id, WCHAR *title, ULONG title_len,
+                                       WCHAR *message, ULONG message_len, ULONG style, ULONG timeout,
+                                       ULONG *response, BOOLEAN wait )
+{
+    TRACE( "%p %lu %s %s\n", server, session_id, debugstr_w( title ), debugstr_w( message ) );
+    return WTSSendMessageW( server, session_id, title, title_len, message, message_len, style, timeout,
+                            response, wait );
+}
+
+BOOLEAN WINAPI WinStationSendMessageA( HANDLE server, ULONG session_id, char *title, ULONG title_len,
+                                       char *message, ULONG message_len, ULONG style, ULONG timeout,
+                                       ULONG *response, BOOLEAN wait )
+{
+    TRACE( "%p %lu %s %s\n", server, session_id, debugstr_a( title ), debugstr_a( message ) );
+    return WTSSendMessageA( server, session_id, title, title_len, message, message_len, style, timeout,
+                            response, wait );
+}
