 BOOLEAN WINAPI WinStationGetAllProcesses( HANDLE server, ULONG level,
@@ -69,11 +80,60 @@
 BOOLEAN WINAPI WinStationGetProcessSid( HANDLE server, ULONG process_id, FILETIME process_start_time,
                                         PVOID process_user_sid, PULONG sid_size )
 {
-    FIXME( "(%p, %ld, %I64x, %p, %p): stub\n", server, process_id,
+    FILETIME created, exited, kernel, user;
+    TOKEN_USER *token_user;
+    HANDLE process, token;
+    DWORD size = 0;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "(%p, %ld, %I64x, %p, %p)\n", server, process_id,
            ((UINT64)process_start_time.dwHighDateTime << 32) | process_start_time.dwLowDateTime,
-           process_user_sid, sid_size);
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+           process_user_sid, sid_size );
+
+    if (!sid_size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!is_local_server( server ))
+    {
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return FALSE;
+    }
+
+    if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, process_id ))) return FALSE;
+    /* the start time tells a process from a later one that reused its id */
+    if (!GetProcessTimes( process, &created, &exited, &kernel, &user ) ||
+        CompareFileTime( &created, &process_start_time ))
+    {
+        if (!GetLastError()) SetLastError( ERROR_INVALID_PARAMETER );
+        CloseHandle( process );
+        return FALSE;
+    }
+    if (!OpenProcessToken( process, TOKEN_QUERY, &token ))
+    {
+        CloseHandle( process );
+        return FALSE;
+    }
+    CloseHandle( process );
+
+    GetTokenInformation( token, TokenUser, NULL, 0, &size );
+    if (size && (token_user = malloc( size )))
+    {
+        if (GetTokenInformation( token, TokenUser, token_user, size, &size ))
+        {
+            DWORD sid_len = GetLengthSid( token_user->User.Sid );
+
+            if (*sid_size < sid_len || !process_user_sid)
+                SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            else
+                ret = CopySid( *sid_size, process_user_sid, token_user->User.Sid );
+            *sid_size = sid_len;
+        }
+        free( token_user );
+    }
+    CloseHandle( token );
+    return ret;
 }
 
 BOOL WINAPI WinStationVirtualOpen( PVOID a, PVOID b, PVOID c )
