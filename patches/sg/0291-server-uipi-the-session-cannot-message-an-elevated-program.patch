 /* send a message to a thread queue */
+/* Stained Glass OS (ADR 0012): user interface privilege isolation, as
+ * Windows' UIPI. An elevated program runs as SYSTEM in this same wineserver,
+ * so without this any program in the user's session could post it keys or
+ * commands (WM_CHAR, WM_COMMAND, WM_PASTE...) through the server, going round
+ * its own display -- which is otherwise out of the session's reach
+ * (sg-compositor, sg-elevated-run). A process below high integrity may send a
+ * process at high integrity or above only the messages UIPI lets through;
+ * everything else is refused with access denied, as SendMessage and
+ * PostMessage fail on Windows. Scoped to the administrator boundary on
+ * purpose: low and medium integrity processes talk to each other as before. */
+int uipi_allows( struct process *sender, struct process *receiver, unsigned int msg )
+{
+    if (sender == receiver || !sender || !receiver) return 1;
+    if (token_get_integrity( receiver->token ) < SECURITY_MANDATORY_HIGH_RID) return 1;
+    if (token_get_integrity( sender->token ) >= token_get_integrity( receiver->token )) return 1;
+    switch (msg)
+    {
+    /* what UIPI lets through on Windows */
+    case WM_NULL: case WM_MOVE: case WM_SIZE: case WM_GETTEXT: case WM_GETTEXTLENGTH:
+    case WM_GETHOTKEY: case WM_GETICON: case WM_RENDERFORMAT: case WM_DRAWCLIPBOARD:
+    case WM_CHANGECBCHAIN: case WM_THEMECHANGED:
+    /* the notifications of the window station's shared clipboard, which its
+     * owner and viewers are sent whoever changed it */
+    case WM_DESTROYCLIPBOARD: case WM_RENDERALLFORMATS: case WM_CLIPBOARDUPDATE:
+        return 1;
+    }
+    return 0;
+}
+
 DECL_HANDLER(send_message)
 {
     struct message *msg;
