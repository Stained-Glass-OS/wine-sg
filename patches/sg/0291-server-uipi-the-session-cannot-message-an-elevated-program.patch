+/* Stained Glass OS: the integrity level of a token, for UIPI (user.h) */
+unsigned int token_get_integrity( struct token *token )
+{
+    const struct sid *label = token ? token_get_integrity_label( token ) : NULL;
+    return label ? label->sub_auth[label->sub_count - 1] : SECURITY_MANDATORY_MEDIUM_RID;
