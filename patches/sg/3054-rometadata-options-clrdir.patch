From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 15:03:00 -0700
Subject: [PATCH] rometadata: dispenser options and the runtime directory

- IMetaDataDispenserEx SetOption/GetOption keep the values that are set (an option that was not set reads as 0)
- GetCORSystemDirectory returns the .NET Framework 4 runtime directory
- the dispenser is allocated zeroed

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/rometadata/Makefile.in b/dlls/rometadata/Makefile.in
index 7a9940a..80d5fd5 100644
--- a/dlls/rometadata/Makefile.in
+++ b/dlls/rometadata/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = rometadata.dll
 IMPORTLIB = rometadata
-IMPORTS   = combase
+IMPORTS   = combase oleaut32
 
 SOURCES = \
 	main.c
diff --git a/dlls/rometadata/main.c b/dlls/rometadata/main.c
index 2530cdf..9cf65d2 100644
--- a/dlls/rometadata/main.c
+++ b/dlls/rometadata/main.c
@@ -25,10 +25,18 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(rometadata);
 
+struct dispenser_option
+{
+    GUID id;
+    VARIANT value;
+};
+
 struct metadata_dispenser
 {
     IMetaDataDispenserEx IMetaDataDispenserEx_iface;
     LONG refcount;
+    struct dispenser_option *options;
+    unsigned int option_count;
 };
 
 static inline struct metadata_dispenser *impl_from_IMetaDataDispenserEx(IMetaDataDispenserEx *iface)
@@ -49,7 +57,8 @@ static HRESULT WINAPI MetaDataDispenser_QueryInterface(IMetaDataDispenserEx *ifa
         return S_OK;
     }
 
-    FIXME("Unsupported interface %s\n", debugstr_guid(riid));
+    WARN("Unsupported interface %s\n", debugstr_guid(riid));
+    *obj = NULL;
     return E_NOINTERFACE;
 }
 
@@ -71,7 +80,14 @@ static ULONG WINAPI MetaDataDispenser_Release(IMetaDataDispenserEx *iface)
     TRACE("%p ref=%lu\n", this, ref);
 
     if (ref == 0)
+    {
+        unsigned int i;
+
+        for (i = 0; i < this->option_count; i++)
+            VariantClear(&this->options[i].value);
+        free(this->options);
         free(this);
+    }
 
     return ref;
 }
@@ -79,7 +95,7 @@ static ULONG WINAPI MetaDataDispenser_Release(IMetaDataDispenserEx *iface)
 static HRESULT WINAPI MetaDataDispenser_DefineScope(IMetaDataDispenserEx *iface, REFCLSID rclsid,
                                                     DWORD create_flags, REFIID riid, IUnknown **obj)
 {
-    FIXME("%p %s %lx %s %p\n", iface, debugstr_guid(rclsid), create_flags, debugstr_guid(riid),
+    WARN("%p %s %lx %s %p: no metadata engine\n", iface, debugstr_guid(rclsid), create_flags, debugstr_guid(riid),
             obj);
     return E_NOTIMPL;
 }
@@ -101,14 +117,59 @@ static HRESULT WINAPI MetaDataDispenser_OpenScopeOnMemory(IMetaDataDispenserEx *
 
 static HRESULT WINAPI MetaDataDispenser_SetOption(IMetaDataDispenserEx *iface, REFGUID option_id, const VARIANT *value)
 {
-    FIXME("%p %s %p\n", iface, debugstr_guid(option_id), debugstr_variant(value));
-    return E_NOTIMPL;
+    struct metadata_dispenser *this = impl_from_IMetaDataDispenserEx(iface);
+    struct dispenser_option *option, *options;
+    unsigned int i;
+    VARIANT copy;
+    HRESULT hr;
+
+    TRACE("%p %s %s\n", iface, debugstr_guid(option_id), debugstr_variant(value));
+
+    if (!option_id || !value) return E_INVALIDARG;
+
+    VariantInit(&copy);
+    if (FAILED(hr = VariantCopy(&copy, value))) return hr;
+
+    for (i = 0; i < this->option_count; i++)
+    {
+        if (IsEqualGUID(&this->options[i].id, option_id))
+        {
+            VariantClear(&this->options[i].value);
+            this->options[i].value = copy;
+            return S_OK;
+        }
+    }
+
+    if (!(options = realloc(this->options, (this->option_count + 1) * sizeof(*options))))
+    {
+        VariantClear(&copy);
+        return E_OUTOFMEMORY;
+    }
+    this->options = options;
+    option = &this->options[this->option_count++];
+    option->id = *option_id;
+    option->value = copy;
+    return S_OK;
 }
 
 static HRESULT WINAPI MetaDataDispenser_GetOption(IMetaDataDispenserEx *iface, REFGUID optionid, VARIANT *value)
 {
-    FIXME("%p %s %s\n", iface, debugstr_guid(optionid), debugstr_variant(value));
-    return E_NOTIMPL;
+    struct metadata_dispenser *this = impl_from_IMetaDataDispenserEx(iface);
+    unsigned int i;
+
+    TRACE("%p %s %p\n", iface, debugstr_guid(optionid), value);
+
+    if (!optionid || !value) return E_INVALIDARG;
+
+    VariantInit(value);
+    for (i = 0; i < this->option_count; i++)
+        if (IsEqualGUID(&this->options[i].id, optionid))
+            return VariantCopy(value, &this->options[i].value);
+
+    /* an option that was not set reads as zero */
+    V_VT(value) = VT_UI4;
+    V_UI4(value) = 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI MetaDataDispenser_OpenScopeOnITypeInfo(IMetaDataDispenserEx *iface, ITypeInfo *type_info,
@@ -121,8 +182,24 @@ static HRESULT WINAPI MetaDataDispenser_OpenScopeOnITypeInfo(IMetaDataDispenserE
 static HRESULT WINAPI MetaDataDispenser_GetCORSystemDirectory(IMetaDataDispenserEx *iface, WCHAR *buffer,
                                                               DWORD buffer_size, DWORD *return_length)
 {
-    FIXME("%p %p %lu %p\n", iface, buffer, buffer_size, return_length);
-    return E_NOTIMPL;
+    WCHAR path[MAX_PATH];
+    UINT len;
+
+    TRACE("%p %p %lu %p\n", iface, buffer, buffer_size, return_length);
+
+    /* the directory of the .NET Framework runtime, with a trailing backslash */
+    len = GetWindowsDirectoryW(path, ARRAY_SIZE(path));
+    if (!len || len >= ARRAY_SIZE(path) - 48) return E_FAIL;
+#ifdef _WIN64
+    wcscpy(path + len, L"\\Microsoft.NET\\Framework64\\v4.0.30319\\");
+#else
+    wcscpy(path + len, L"\\Microsoft.NET\\Framework\\v4.0.30319\\");
+#endif
+    len = wcslen(path) + 1;
+    if (return_length) *return_length = len;
+    if (!buffer || buffer_size < len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    memcpy(buffer, path, len * sizeof(WCHAR));
+    return S_OK;
 }
 
 static HRESULT WINAPI MetaDataDispenser_FindAssembly(IMetaDataDispenserEx *iface, const WCHAR *app_base,
@@ -171,7 +248,7 @@ STDAPI MetaDataGetDispenser(REFCLSID rclsid, REFIID riid, void **obj)
     if (!IsEqualGUID(rclsid, &CLSID_CorMetaDataDispenser))
         return CLASS_E_CLASSNOTAVAILABLE;
 
-    dispenser = malloc(sizeof(*dispenser));
+    dispenser = calloc(1, sizeof(*dispenser));
     if (!dispenser)
         return E_OUTOFMEMORY;
 
diff --git a/dlls/rometadata/tests/Makefile.in b/dlls/rometadata/tests/Makefile.in
index 58813ae..a7a5ba8 100644
--- a/dlls/rometadata/tests/Makefile.in
+++ b/dlls/rometadata/tests/Makefile.in
@@ -1,5 +1,5 @@
 TESTDLL = rometadata.dll
-IMPORTS = combase rometadata
+IMPORTS = combase oleaut32 rometadata
 
 SOURCES = \
 	rometadata.c
diff --git a/dlls/rometadata/tests/rometadata.c b/dlls/rometadata/tests/rometadata.c
index b4adcd9..76b19db 100644
--- a/dlls/rometadata/tests/rometadata.c
+++ b/dlls/rometadata/tests/rometadata.c
@@ -57,6 +57,35 @@ static void test_MetaDataGetDispenser(void)
         IMetaDataDispenserEx_Release(dispenser_ex);
 }
 
+static void test_dispenser_options(void)
+{
+    IMetaDataDispenserEx *dispenser;
+    WCHAR buffer[MAX_PATH];
+    DWORD length = 0;
+    VARIANT value;
+    HRESULT hr;
+    GUID id = { 0x1234, 0x5678, 0x9abc, { 1, 2, 3, 4, 5, 6, 7, 8 } };
+
+    hr = MetaDataGetDispenser(&CLSID_CorMetaDataDispenser, &IID_IMetaDataDispenserEx, (void **)&dispenser);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    VariantInit(&value);
+    V_VT(&value) = VT_UI4;
+    V_UI4(&value) = 7;
+    hr = IMetaDataDispenserEx_SetOption(dispenser, &id, &value);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    VariantInit(&value);
+    hr = IMetaDataDispenserEx_GetOption(dispenser, &id, &value);
+    ok(hr == S_OK && V_VT(&value) == VT_UI4 && V_UI4(&value) == 7, "Got unexpected hr %#lx.\n", hr);
+
+    hr = IMetaDataDispenserEx_GetCORSystemDirectory(dispenser, NULL, 0, &length);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER) && length > 1, "Got unexpected hr %#lx, length %lu.\n", hr, length);
+    hr = IMetaDataDispenserEx_GetCORSystemDirectory(dispenser, buffer, ARRAY_SIZE(buffer), &length);
+    ok(hr == S_OK && length == wcslen(buffer) + 1 && buffer[length - 2] == '\\', "Got unexpected hr %#lx, %s.\n", hr, wine_dbgstr_w(buffer));
+
+    IMetaDataDispenserEx_Release(dispenser);
+}
+
 START_TEST(rometadata)
 {
     HRESULT hr;
@@ -65,6 +94,7 @@ START_TEST(rometadata)
     ok(hr == S_OK, "RoInitialize failed, hr %#lx\n", hr);
 
     test_MetaDataGetDispenser();
+    test_dispenser_options();
 
     RoUninitialize();
 }
