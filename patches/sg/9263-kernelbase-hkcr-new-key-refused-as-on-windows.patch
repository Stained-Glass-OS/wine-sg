From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: a standard program's new key under HKEY_CLASSES_ROOT is refused, as on Windows; RegOverridePredefKey(HKCR) (9263)

0178 put a new key the machine's classes refuse into the user's
(HKCU\Software\Classes) for every program. Windows does that only for a
program UAC virtualizes (3764: a 32-bit program with no run level, run by a
standard user); any other gets ERROR_ACCESS_DENIED. Programs decide by it:
gvim's first start creates HKCR\Vim.Application, and because that worked
here it asked "Cannot load registered type library. Do you want to register
Vim now?", where on Windows it stays quiet (apps11, ledger i0702). The
fallback is now kept for virtualized processes and virtualized machine keys.

Programs that register for the user alone do it as Windows lets them:
RegOverridePredefKey(HKEY_CLASSES_ROOT, <HKCU\Software\Classes>) (regsvr32
/n /i:user, per-user DllRegisterServer). That override was ignored: the
merged view took HKCR whatever it was given. While HKCR is overridden it is
now the given key alone; keys opened through the merged view before keep
the machine's classes under them. Wine msi registered a per-user package's
classes through HKCR; it now uses the user's classes (9264).

Gate: test/hkcr-gate.sh (the standard user's create is refused; created
under an override; the view back afterwards). Mutants:
SG_MUTANT_HKCR_ANY_FALLBACK, SG_MUTANT_HKCR_IGNORE_OVERRIDE.
---
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -63,6 +63,8 @@
 
 static HKEY special_root_keys[ARRAY_SIZE(root_key_names)];
 static BOOL cache_disabled[ARRAY_SIZE(root_key_names)];
+/* Stained Glass OS (wine-sg 9263): HKEY_CLASSES_ROOT given another key by RegOverridePredefKey */
+static LONG classes_root_overridden;
 
 static CRITICAL_SECTION reg_mui_cs;
 static CRITICAL_SECTION_DEBUG reg_mui_cs_debug =
@@ -559,6 +561,22 @@
     }
 }
 
+/* the machine's classes, also while RegOverridePredefKey has given HKEY_CLASSES_ROOT another key (9263):
+ * keys opened through the merged view before keep seeing it */
+static HKEY machine_classes_root(void)
+{
+    static HKEY real;
+    UNICODE_STRING name;
+    HKEY hkey;
+
+    if (!classes_root_overridden) return get_special_root_hkey( HKEY_CLASSES_ROOT );
+    if (real) return real;
+    RtlInitUnicodeString( &name, root_key_names[0] );
+    if (create_key( &hkey, 0, name, 0, MAXIMUM_ALLOWED, NULL, NULL )) return 0;
+    if (InterlockedCompareExchangePointer( (void **)&real, hkey, 0 )) NtClose( hkey );
+    return real;
+}
+
 /* Stained Glass OS: the size of the key's security descriptor, as
  * RegQueryInfoKey reports it; 0 when it cannot be read (no READ_CONTROL). */
 static DWORD get_key_sd_size( HKEY hkey )
@@ -602,6 +620,7 @@
 
     old_key = InterlockedExchangePointer( (void **)&special_root_keys[idx], override );
     if (old_key) NtClose( old_key );
+    if (HandleToUlong(hkey) == HandleToUlong(HKEY_CLASSES_ROOT)) classes_root_overridden = override != NULL;
     return STATUS_SUCCESS;
 }
 
@@ -667,7 +686,15 @@
 {
     struct classes_key *key;
 
-    if (HandleToUlong( hkey ) == HandleToUlong( HKEY_CLASSES_ROOT )) return &classes_root_view;
+    if (HandleToUlong( hkey ) == HandleToUlong( HKEY_CLASSES_ROOT ))
+    {
+#ifndef SG_MUTANT_HKCR_IGNORE_OVERRIDE
+        /* RegOverridePredefKey: HKEY_CLASSES_ROOT is that key alone (a per-user registration's
+         * HKCU\Software\Classes, regsvr32 /n /i:user, OaEnablePerUserTLibRegistration), as on Windows */
+        if (classes_root_overridden) return NULL;
+#endif
+        return &classes_root_view;
+    }
     LIST_FOR_EACH_ENTRY( key, &classes_keys, struct classes_key, entry )
         if (key->hkey == hkey) return key;
     return NULL;
@@ -833,7 +860,7 @@
     *user_path = *machine_path = NULL;
     if (path[0] != '\\')
     {
-        *machine_root = get_special_root_hkey( HKEY_CLASSES_ROOT );
+        *machine_root = machine_classes_root();
         *user_path = user_classes_path( path );
         if ((*machine_path = heap_alloc( (lstrlenW( path ) + 1) * sizeof(WCHAR) ))) lstrcpyW( *machine_path, path );
     }
@@ -884,6 +911,8 @@
     heap_free( machine_path );
 }
 
+static BOOL virt_enabled(void);
+
 /* open (or create) a key of the merged view */
 static NTSTATUS open_classes_key( HKEY *retkey, const WCHAR *base, const UNICODE_STRING *name, DWORD options,
                                   ACCESS_MASK access, BOOL create, const UNICODE_STRING *class, DWORD *dispos,
@@ -927,7 +956,14 @@
         else if (create)
         {
             status = create_key( retkey, machine_root, pathW, options, access, class, dispos );
+            /* Stained Glass OS (wine-sg 9263): a new key the machine's classes refuse goes to the user's
+             * only for a process UAC virtualizes (an old 32-bit program with no run level, run by a
+             * standard user) and for a virtualized machine key; any other program is refused, as on
+             * Windows -- gvim's first start found HKCR writable and asked to register its type library */
             if (status == STATUS_ACCESS_DENIED && user_path &&
+#ifndef SG_MUTANT_HKCR_ANY_FALLBACK
+                (path[0] == '\\' || virt_enabled()) &&
+#endif
                 !(status = create_key( retkey, user_root, userW, options, user_access, class, dispos )))
                 user_bound = TRUE;
         }
