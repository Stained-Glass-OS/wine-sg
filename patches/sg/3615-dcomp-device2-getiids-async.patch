+/* An action that is already done: every commit here is drawn before Commit returns. */
+struct done_action
+{
+    IAsyncAction IAsyncAction_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    UINT32 id;
+    IAsyncActionCompletedHandler *handler;
+    BOOL closed;
+};
+
+static inline struct done_action *impl_from_IAsyncAction( IAsyncAction *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_action, IAsyncAction_iface );
+}
+
+static inline struct done_action *impl_from_IAsyncInfo( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_action, IAsyncInfo_iface );
+}
+
+static HRESULT WINAPI done_action_QueryInterface( IAsyncAction *iface, REFIID iid, void **out )
+{
+    struct done_action *impl = impl_from_IAsyncAction( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncAction ))
+        *out = &impl->IAsyncAction_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI done_action_AddRef( IAsyncAction *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncAction( iface )->ref );
+}
+
+static ULONG WINAPI done_action_Release( IAsyncAction *iface )
+{
+    struct done_action *impl = impl_from_IAsyncAction( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncActionCompletedHandler_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI done_action_GetIids( IAsyncAction *iface, ULONG *iid_count, IID **iids )
+{
+    static const IID *const list[] = { &IID_IAsyncAction, &IID_IAsyncInfo };
+    return get_iids( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI done_action_GetRuntimeClassName( IAsyncAction *iface, HSTRING *class_name )
+{
+    return runtime_class_name( L"Windows.Foundation.IAsyncAction", class_name );
+}
+
+static HRESULT WINAPI done_action_GetTrustLevel( IAsyncAction *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI done_action_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct done_action *impl = impl_from_IAsyncAction( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    IAsyncActionCompletedHandler_AddRef( impl->handler = handler );
+    /* the action is complete: the handler runs now */
+    IAsyncActionCompletedHandler_Invoke( handler, iface, Completed );
+    return S_OK;
+}
+
+static HRESULT WINAPI done_action_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct done_action *impl = impl_from_IAsyncAction( iface );
+
+    if (!handler) return E_POINTER;
+    if ((*handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI done_action_GetResults( IAsyncAction *iface )
+{
+    return S_OK;
+}
+
+static const IAsyncActionVtbl done_action_vtbl =
+{
+    done_action_QueryInterface,
+    done_action_AddRef,
+    done_action_Release,
+    done_action_GetIids,
+    done_action_GetRuntimeClassName,
+    done_action_GetTrustLevel,
+    done_action_put_Completed,
+    done_action_get_Completed,
+    done_action_GetResults,
+};
+
+static HRESULT WINAPI done_info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return done_action_QueryInterface( &impl_from_IAsyncInfo( iface )->IAsyncAction_iface, iid, out );
+}
+
+static ULONG WINAPI done_info_AddRef( IAsyncInfo *iface )
+{
+    return done_action_AddRef( &impl_from_IAsyncInfo( iface )->IAsyncAction_iface );
+}
+
+static ULONG WINAPI done_info_Release( IAsyncInfo *iface )
+{
+    return done_action_Release( &impl_from_IAsyncInfo( iface )->IAsyncAction_iface );
+}
+
+static HRESULT WINAPI done_info_GetIids( IAsyncInfo *iface, ULONG *iid_count, IID **iids )
+{
+    return done_action_GetIids( &impl_from_IAsyncInfo( iface )->IAsyncAction_iface, iid_count, iids );
+}
+
+static HRESULT WINAPI done_info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *class_name )
+{
+    return done_action_GetRuntimeClassName( &impl_from_IAsyncInfo( iface )->IAsyncAction_iface, class_name );
+}
+
+static HRESULT WINAPI done_info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *trust_level )
+{
+    return done_action_GetTrustLevel( &impl_from_IAsyncInfo( iface )->IAsyncAction_iface, trust_level );
+}
+
+static HRESULT WINAPI done_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    struct done_action *impl = impl_from_IAsyncInfo( iface );
+    if (!id) return E_POINTER;
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *id = impl->id;
+    return S_OK;
+}
+
+static HRESULT WINAPI done_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct done_action *impl = impl_from_IAsyncInfo( iface );
+    if (!status) return E_POINTER;
+#ifdef SG_MUTANT_ASYNC_STARTED
+    *status = Started;
+    return S_OK;
+#endif
+    *status = impl->closed ? (AsyncStatus)4 : Completed;
+    return S_OK;
+}
+
+static HRESULT WINAPI done_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code )
+{
+    struct done_action *impl = impl_from_IAsyncInfo( iface );
+    if (!code) return E_POINTER;
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *code = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI done_info_Cancel( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI done_info_Close( IAsyncInfo *iface )
+{
+    impl_from_IAsyncInfo( iface )->closed = TRUE;
+    return S_OK;
+}
+
+static const IAsyncInfoVtbl done_info_vtbl =
+{
+    done_info_QueryInterface,
+    done_info_AddRef,
+    done_info_Release,
+    done_info_GetIids,
+    done_info_GetRuntimeClassName,
+    done_info_GetTrustLevel,
+    done_info_get_Id,
+    done_info_get_Status,
+    done_info_get_ErrorCode,
+    done_info_Cancel,
+    done_info_Close,
+};
+
 static HRESULT WINAPI controller_EnsurePreviousCommitCompletedAsync( ICompositorController *iface,
         IAsyncAction **action )
 {
-    FIXME( "iface %p, action %p stub!\n", iface, action );
-    return E_NOTIMPL;
+    static LONG next_id;
+    struct done_action *impl;
+
+    TRACE( "iface %p, action %p.\n", iface, action );
+
+    if (!action) return E_POINTER;
+    *action = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncAction_iface.lpVtbl = &done_action_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &done_info_vtbl;
+    impl->ref = 1;
+    impl->id = InterlockedIncrement( &next_id );
+    *action = &impl->IAsyncAction_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI controller_add_CommitNeeded( ICompositorController *iface,
@@ -2809,12 +3104,14 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
 
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
