+/* A surface factory makes surfaces on the device it was given. */
+struct surface_factory
+{
+    IDCompositionSurfaceFactory IDCompositionSurfaceFactory_iface;
+    LONG refcount;
+    IDXGIDevice *dxgi_device;
+};
+
+static inline struct surface_factory *impl_from_IDCompositionSurfaceFactory(IDCompositionSurfaceFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct surface_factory, IDCompositionSurfaceFactory_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE factory_QueryInterface(IDCompositionSurfaceFactory *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionSurfaceFactory))
+    {
+        IDCompositionSurfaceFactory_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE factory_AddRef(IDCompositionSurfaceFactory *iface)
+{
+    struct surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    return InterlockedIncrement(&factory->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE factory_Release(IDCompositionSurfaceFactory *iface)
+{
+    struct surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+    ULONG refcount = InterlockedDecrement(&factory->refcount);
+
+    if (!refcount)
+    {
+        if (factory->dxgi_device) IDXGIDevice_Release(factory->dxgi_device);
+        free(factory);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE factory_CreateSurface(IDCompositionSurfaceFactory *iface, UINT width, UINT height,
+        DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionSurface **surface)
+{
+    struct surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+
+    TRACE("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p.\n",
+            iface, width, height, format, alpha_mode, surface);
+
+    return dc_create_surface(factory->dxgi_device, width, height, format, alpha_mode, FALSE, (void **)surface);
+}
+
+static HRESULT STDMETHODCALLTYPE factory_CreateVirtualSurface(IDCompositionSurfaceFactory *iface, UINT width,
+        UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionVirtualSurface **surface)
+{
+    struct surface_factory *factory = impl_from_IDCompositionSurfaceFactory(iface);
+
+    TRACE("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p.\n",
+            iface, width, height, format, alpha_mode, surface);
+
+    return dc_create_surface(factory->dxgi_device, width, height, format, alpha_mode, TRUE, (void **)surface);
+}
+
+static const IDCompositionSurfaceFactoryVtbl surface_factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateSurface,
+    factory_CreateVirtualSurface,
+};
+
+/* The rendering device is a DXGI device, or a Direct2D device whose Direct3D device we ask for. */
+static HRESULT get_dxgi_device(IUnknown *rendering_device, IDXGIDevice **dxgi_device)
+{
+    *dxgi_device = NULL;
+    if (!rendering_device)
+        return S_OK;
+    if (SUCCEEDED(IUnknown_QueryInterface(rendering_device, &IID_IDXGIDevice, (void **)dxgi_device)))
+        return S_OK;
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE desktop_device_CreateSurfaceFactory(IDCompositionDesktopDevice *iface,
+        IUnknown *rendering_device, IDCompositionSurfaceFactory **out)
+{
+    struct surface_factory *factory;
+    HRESULT hr;
+
+    TRACE("iface %p, rendering_device %p, out %p.\n", iface, rendering_device, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!(factory = calloc(1, sizeof(*factory))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = get_dxgi_device(rendering_device, &factory->dxgi_device)))
+    {
+        free(factory);
+        return hr;
+    }
+    factory->IDCompositionSurfaceFactory_iface.lpVtbl = &surface_factory_vtbl;
+    factory->refcount = 1;
+    *out = &factory->IDCompositionSurfaceFactory_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE desktop_device_CreateSurface(IDCompositionDesktopDevice *iface, UINT width,
