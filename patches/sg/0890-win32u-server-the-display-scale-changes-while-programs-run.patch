 /* keep in sync with user32 */
 UINT set_thread_dpi_awareness_context( UINT context )
 {
@@ -5590,6 +5623,87 @@
     return ret;
 }
 
+/* Stained Glass OS: the display scale, as the user has it now: LogPixels
+ * (HKCU\\Control Panel\\Desktop, Settings > Display > Scale), or the machine's
+ * fallback. system_dpi is the one the process started with, as on Windows,
+ * where a running program's system DPI does not change either. */
+static UINT read_logpixels(void)
+{
+    DWORD dpi = 0;
+
+    entry_LOGPIXELS.hdr.loaded = FALSE;
+    get_dword_entry( (union sysparam_all_entry *)&entry_LOGPIXELS, 0, &dpi, 0 );
+    if (!dpi)
+    {
+        HKEY hkey;
+
+        if (config_key && (hkey = reg_open_ascii_key( config_key, "Software\\Fonts" )))
+        {
+            char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+            KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+
+            if (query_reg_ascii_value( hkey, "LogPixels", value, sizeof(buffer) ) && value->Type == REG_DWORD)
+                dpi = *(const DWORD *)value->Data;
+            NtClose( hkey );
+        }
+    }
+    if (!dpi) dpi = system_dpi ? system_dpi : USER_DEFAULT_SCREEN_DPI;
+#ifndef SG_MUTANT_NO_LOGPIXELS_ENV
+    /* the scale handed to this process (SG_LOGPIXELS, the login screen's
+     * and Setup's, 0882) is its monitors' too */
+    {
+        const char *env = getenv( "SG_LOGPIXELS" );
+        UINT env_dpi = env ? strtoul( env, NULL, 10 ) : 0;
+        if (env_dpi >= USER_DEFAULT_SCREEN_DPI && env_dpi <= 480) dpi = env_dpi;
+    }
+#endif
+    return min( max( dpi, USER_DEFAULT_SCREEN_DPI ), USER_DEFAULT_SCREEN_DPI * 5 );
+}
+
+/* Stained Glass OS: the display scale changed while programs run (Settings
+ * writes LogPixels and broadcasts WM_SETTINGCHANGE): the monitors take the
+ * new DPI, in their registry records, and the monitor serial tells every
+ * process to read them again -- as a scale change does on Windows, where
+ * the monitor's DPI is what changes. Per-monitor aware windows are then
+ * told (WM_DPICHANGED), and the others are scaled by Wine at the new
+ * monitor DPI (window_check_dpi_change). Cheap when nothing changed. */
+void sync_monitor_dpi(void)
+{
+    static const WCHAR serialW[] = {'W','i','n','e','D','p','i','S','e','r','i','a','l',0};
+    static DWORD serial;
+    struct source *source;
+    UINT dpi = read_logpixels();
+    BOOL changed = FALSE;
+    HKEY hkey;
+
+#ifdef SG_MUTANT_DPI_LIVE
+    return;
+#endif
+    if (!lock_display_devices( FALSE )) return;
+    LIST_FOR_EACH_ENTRY( source, &sources, struct source, entry )
+    {
+        if (source->dpi == dpi) continue;
+        if (!source->dpi) continue;  /* none of its own: sources_dpi */
+        TRACE( "source %s dpi %u -> %u\n", debugstr_a(source->path), source->dpi, dpi );
+        source->dpi = dpi;
+        if ((hkey = reg_open_ascii_key( config_key, source->path )))
+        {
+            set_reg_value( hkey, dpiW, REG_DWORD, &source->dpi, sizeof(source->dpi) );
+            NtClose( hkey );
+        }
+        changed = TRUE;
+    }
+    if (sources_dpi != dpi) changed = TRUE;
+    sources_dpi = dpi;
+    if (changed && video_key)
+    {
+        serial++;
+        set_reg_value( video_key, serialW, REG_DWORD, &serial, sizeof(serial) );
+        set_winstation_monitors( TRUE );
+    }
+    unlock_display_devices();
+}
