+/* Stained Glass OS: the system metrics (frame sizes, the caption's font)
+ * at DPI on this thread, or as usual (0); returns the previous one */
+UINT set_thread_metrics_dpi( UINT dpi )
+{
+    struct user_thread_info *info = get_user_thread_info();
+    UINT prev = info->metrics_dpi;
+    info->metrics_dpi = dpi;
+    return prev;
