+
+
+/* Stained Glass OS: a DPI change for the window's descendants, in the order
+ * Windows documents: WM_DPICHANGED_BEFOREPARENT from the bottom of the tree
+ * up, WM_DPICHANGED_AFTERPARENT from the top down. */
+static void send_dpi_change_to_children( HWND parent, UINT msg )
+{
+    HWND *list;
+    int i;
+
+    if (!(list = list_window_children( parent ))) return;
+    for (i = 0; list[i]; i++)
+    {
+        if (msg == WM_DPICHANGED_AFTERPARENT) send_message( list[i], msg, 0, 0 );
+        send_dpi_change_to_children( list[i], msg );
+        if (msg == WM_DPICHANGED_BEFOREPARENT) send_message( list[i], msg, 0, 0 );
+    }
+    free( list );
+}
+
+/* the rectangle Windows suggests in WM_DPICHANGED: the window at the new
+ * DPI where it is -- its client area scaled, its frame the new DPI's
+ * (per-monitor v2) or as it is (v1, whose frame is not scaled) -- kept on
+ * its monitor's work area */
+static RECT dpi_changed_rect( HWND hwnd, UINT context, UINT old_dpi, UINT new_dpi )
+{
+    struct window_rects rects;
+    MONITORINFO info;
+    DWORD style = get_window_long( hwnd, GWL_STYLE ), ex_style = get_window_long( hwnd, GWL_EXSTYLE );
+    RECT rect;
+    int w, h;
+
+    get_window_rects( hwnd, COORDS_SCREEN, &rects, 0 );
+    if (style & (WS_MAXIMIZE | WS_MINIMIZE)) return rects.window;
+
+    if (NTUSER_DPI_CONTEXT_GET_VERSION( context ) >= 2)
+    {
+        SetRect( &rect, 0, 0, muldiv( rects.client.right - rects.client.left, new_dpi, old_dpi ),
+                 muldiv( rects.client.bottom - rects.client.top, new_dpi, old_dpi ) );
+        adjust_window_rect( &rect, style, !(style & WS_CHILD) && get_menu( hwnd ), ex_style, new_dpi );
+        w = rect.right - rect.left;
+        h = rect.bottom - rect.top;
+    }
+    else
+    {
+        /* v1: the frame stays the process's; the client area scaled */
+        w = muldiv( rects.client.right - rects.client.left, new_dpi, old_dpi ) +
+            (rects.window.right - rects.window.left) - (rects.client.right - rects.client.left);
+        h = muldiv( rects.client.bottom - rects.client.top, new_dpi, old_dpi ) +
+            (rects.window.bottom - rects.window.top) - (rects.client.bottom - rects.client.top);
+    }
+    SetRect( &rect, rects.window.left, rects.window.top, rects.window.left + w, rects.window.top + h );
+
+    info = monitor_info_from_rect( rects.window, 0 );
+    if (!IsRectEmpty( &info.rcWork ))
+    {
+        RECT work = info.rcWork;
+        if (rect.right > work.right) OffsetRect( &rect, max( work.right - rect.right, work.left - rect.left ), 0 );
+        if (rect.bottom > work.bottom) OffsetRect( &rect, 0, max( work.bottom - rect.bottom, work.top - rect.top ) );
+    }
+    return rect;
+}
+
+/* a layered window's picture (it hands it over with UpdateLayeredWindow, it
+ * is not asked to paint): taken from the surface it was shown on, handed over
+ * again once the window is at its new scale, as the program would */
+static HBITMAP save_layered_picture( struct window_surface *surface, UINT *flags, COLORREF *key )
+{
+    char buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buf;
+    HBITMAP bitmap = 0;
+    void *bits;
+
+    window_surface_lock( surface );
+    if ((bits = window_surface_get_color( surface, info )) && info->bmiHeader.biBitCount == 32 &&
+        info->bmiHeader.biHeight < 0)
+        bitmap = NtGdiCreateBitmap( info->bmiHeader.biWidth, -info->bmiHeader.biHeight, 1, 32, bits );
+    *key = surface->color_key;
+    if (surface->alpha_mask) *flags = ULW_ALPHA;
+    else if (surface->color_key != CLR_INVALID) *flags = ULW_COLORKEY;
+    else *flags = ULW_OPAQUE;
+    window_surface_unlock( surface );
+    return bitmap;
+}
+
+static void restore_layered_picture( HWND hwnd, HBITMAP bitmap, UINT flags, COLORREF key )
+{
+    BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    struct window_rects rects;
+    POINT zero = {0, 0};
+    SIZE size;
+    HDC hdc;
+
+    if (!get_window_rects( hwnd, COORDS_SCREEN, &rects, get_thread_dpi() )) return;
+    size.cx = rects.window.right - rects.window.left;
+    size.cy = rects.window.bottom - rects.window.top;
+    if (!(hdc = NtGdiCreateCompatibleDC( 0 ))) return;
+    NtGdiSelectBitmap( hdc, bitmap );
+    NtUserUpdateLayeredWindow( hwnd, 0, NULL, &size, hdc, &zero, key, &blend, flags, NULL );
+    NtGdiDeleteObjectApp( hdc );
+}
+
+/***********************************************************************
+ *           window_check_dpi_change
+ *
+ * Stained Glass OS: the display scale changes while programs run. A
+ * top-level window told of a settings change (WM_SETTINGCHANGE, which
+ * Settings broadcasts after it writes LogPixels) finds its monitor's DPI
+ * changed (sync_monitor_dpi) and does what Windows does then: a
+ * per-monitor aware window is sent WM_DPICHANGED with the new DPI and the
+ * suggested rectangle (v2: and its children WM_DPICHANGED_BEFOREPARENT and
+ * _AFTERPARENT), and its frame is laid out at the new DPI; a window that
+ * is not (DPI unaware, system aware) keeps its own DPI and is scaled at the
+ * new monitor DPI. Either way it is drawn again at once.
+ */
+void window_check_dpi_change( HWND hwnd )
+{
+    UINT old_dpi, new_dpi, raw_dpi, context, thread_context;
+    HWND parent;
+    WND *win;
+
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    parent = win->parent;
+    old_dpi = win->sg_monitor_dpi;
+    context = win->dpi_context;
+    release_win_ptr( win );
+    if (parent != get_desktop_window()) return;
+
+    sync_monitor_dpi();
+    if (!(new_dpi = get_win_monitor_dpi( hwnd, &raw_dpi ))) return;
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    win->sg_monitor_dpi = new_dpi;
+    release_win_ptr( win );
+    if (!old_dpi || old_dpi == new_dpi) return;
+
+    TRACE( "%p context %#x monitor dpi %u -> %u\n", hwnd, context, old_dpi, new_dpi );
+    thread_context = set_thread_dpi_awareness_context( context );
+
+    if (NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( context ))
+    {
+        RECT rect = dpi_changed_rect( hwnd, context, old_dpi, new_dpi );
+        BOOL v2 = NTUSER_DPI_CONTEXT_GET_VERSION( context ) >= 2;
+
+        if (v2)
+        {
+            SIZE size = {rect.right - rect.left, rect.bottom - rect.top};
+            send_dpi_change_to_children( hwnd, WM_DPICHANGED_BEFOREPARENT );
+            /* the window may size itself for the new DPI */
+            if (!(get_window_long( hwnd, GWL_STYLE ) & (WS_MAXIMIZE | WS_MINIMIZE)) &&
+                send_message( hwnd, WM_GETDPISCALEDSIZE, new_dpi, (LPARAM)&size ) &&
+                size.cx > 0 && size.cy > 0)
+            {
+                rect.right = rect.left + size.cx;
+                rect.bottom = rect.top + size.cy;
+            }
+        }
+        send_message( hwnd, WM_DPICHANGED, MAKEWPARAM( new_dpi, new_dpi ), (LPARAM)&rect );
+        /* the frame (title bar, borders, menu bar) at the new DPI */
+        NtUserSetWindowPos( hwnd, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER |
+                            SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_FRAMECHANGED );
+        update_surface_region( hwnd );
+        if (v2) send_dpi_change_to_children( hwnd, WM_DPICHANGED_AFTERPARENT );
+    }
+    else
+    {
+        COLORREF key = CLR_INVALID, attr_key;
+        HBITMAP picture = 0;
+        UINT ulw_flags = 0;
+        DWORD attr_flags;
+        BYTE alpha;
+
+        /* a layered window drawn with UpdateLayeredWindow keeps its picture
+         * (one with SetLayeredWindowAttributes paints itself again) */
+        if ((get_window_long( hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED) &&
+            !NtUserGetLayeredWindowAttributes( hwnd, &attr_key, &alpha, &attr_flags ) &&
+            (win = get_win_ptr( hwnd )) && win != WND_OTHER_PROCESS && win != WND_DESKTOP)
+        {
+            struct window_surface *surface = win->surface;
+            if (surface) window_surface_add_ref( surface );
+            release_win_ptr( win );
+            if (surface)
+            {
+                picture = save_layered_picture( surface, &ulw_flags, &key );
+                window_surface_release( surface );
+            }
+        }
+        /* its own DPI is kept, its pixels are scaled to the monitor's new one */
+        NtUserSetWindowPos( hwnd, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER |
+                            SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_FRAMECHANGED | SWP_NOCOPYBITS );
+        /* its visible region again, now that the server knows the new DPI
+         * (the surface was made before it did) */
+        update_surface_region( hwnd );
+        if (picture)
+        {
+            restore_layered_picture( hwnd, picture, ulw_flags, key );
+            NtGdiDeleteObjectApp( picture );
+        }
+    }
+
+    /* a maximized window fills the work area, which is another size at the new DPI */
+    if (is_zoomed( hwnd ))
+    {
+        MINMAXINFO minmax = get_min_max_info( hwnd );
+        NtUserSetWindowPos( hwnd, 0, minmax.ptMaxPosition.x, minmax.ptMaxPosition.y,
+                            minmax.ptMaxSize.x, minmax.ptMaxSize.y,
+                            SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_NOCOPYBITS );
+    }
+
+    NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    set_thread_dpi_awareness_context( thread_context );
+}
