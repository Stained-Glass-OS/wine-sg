From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dllhost: IMarshal::GetMarshalSizeMax for the class factory

The surrogate marshals the DLL's own class factory to its client;
GetMarshalSizeMax was E_NOTIMPL. It now asks CoGetMarshalSizeMax for the
DLL's factory with the caller's context and flags.
---
--- a/programs/dllhost/dllhost.c
+++ b/programs/dllhost/dllhost.c
@@ -161,9 +161,19 @@ static HRESULT WINAPI marshal_GetUnmarshalClass(IMarshal *iface, REFIID iid, voi
 static HRESULT WINAPI marshal_GetMarshalSizeMax(IMarshal *iface, REFIID iid, void *pv,
         DWORD dwDestContext, void *pvDestContext, DWORD mshlflags, DWORD *size)
 {
-    FIXME("(%p,%s,%p,%08lx,%p,%08lx,%p): stub\n", iface, wine_dbgstr_guid(iid), pv,
+    struct factory *factory = impl_from_IMarshal(iface);
+    HRESULT hr;
+
+    TRACE("(%p,%s,%p,%08lx,%p,%08lx,%p)\n", iface, wine_dbgstr_guid(iid), pv,
           dwDestContext, pvDestContext, mshlflags, size);
+
+    /* what is marshalled is the DLL's own class factory (MarshalInterface below) */
+#ifdef SG_MUTANT_DLLHOST_SIZE
     return E_NOTIMPL;
+#endif
+    hr = CoGetMarshalSizeMax(size, iid, (IUnknown *)factory->dll_factory, dwDestContext, pvDestContext, mshlflags);
+    TRACE("returning %#lx, size %lu\n", hr, hr == S_OK ? *size : 0);
+    return hr;
 }
 
 static HRESULT WINAPI marshal_MarshalInterface(IMarshal *iface, IStream *stream, REFIID iid,
