+    IPropertyStore *dest;
+    DWORD count, i;
+    HRESULT hr;
+    TRACE("%p (%p, %p, %p, %p)\n", This, psi, pStore, hwnd, pSink);
+
+    /* Native crashes on a NULL item. */
+    if(!psi)
+        return E_INVALIDARG;
+    if(!pStore)
+        return S_OK;
+
+    hr = IShellItem_BindToHandler(psi, NULL, &BHID_PropertyStore, &IID_IPropertyStore, (void**)&dest);
+    if(FAILED(hr))
+        return hr;
+
+    hr = IPropertyStore_GetCount(pStore, &count);
+    for(i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        PROPERTYKEY key;
+        PROPVARIANT value;
+
+        hr = IPropertyStore_GetAt(pStore, i, &key);
+        if(FAILED(hr))
+            break;
+        PropVariantInit(&value);
+        hr = IPropertyStore_GetValue(pStore, &key, &value);
+        if(SUCCEEDED(hr))
+            hr = IPropertyStore_SetValue(dest, &key, &value);
+        PropVariantClear(&value);
+    }
+    if(SUCCEEDED(hr))
+        hr = IPropertyStore_Commit(dest);
+    IPropertyStore_Release(dest);
+
+    return hr;
 }
 
