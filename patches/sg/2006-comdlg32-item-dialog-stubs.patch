 {
     FileDialogImpl *This = impl_from_IFileDialog2(iface);
-    FIXME("stub - %p (%p, %d)\n", This, psi, fdap);
+    struct place *places;
+    UINT i;
+    TRACE("%p (%p, %d)\n", This, psi, fdap);
+
+    /* Native crashes on a NULL item; reject it instead. */
+#ifdef SG_MUTANT_PLACE
+    if(!psi)
+#else
+    if(!psi || (UINT)fdap > FDAP_TOP)
+#endif
+        return E_INVALIDARG;
+
+    if(This->places)
+        places = HeapReAlloc(GetProcessHeap(), 0, This->places, (This->place_count + 1) * sizeof(*places));
+    else
+        places = HeapAlloc(GetProcessHeap(), 0, sizeof(*places));
+    if(!places)
+        return E_OUTOFMEMORY;
+    This->places = places;
+
+    /* Places added at the top come first, most recently added nearest the top.
+     * Places added at the bottom keep their insertion order after them. */
+    if(fdap == FDAP_TOP)
+    {
+        for(i = This->place_count; i > 0; i--)
+            places[i] = places[i - 1];
+        i = 0;
+    }
+    else
+        i = This->place_count;
+    IShellItem_AddRef(psi);
+    places[i].psi = psi;
+    places[i].fdap = fdap;
+    This->place_count++;
+
     return S_OK;
 }
 
