--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -130,8 +130,23 @@ struct taskbar_button
      * Alt+Tab, Task View and the rest treat it as any Wine window */
     unsigned long embedded;
     int         embed_tries;   /* framing it failed this often (tried again, a few times) */
+    /* Stained Glass OS (1639): what the program told ITaskbarList3 about
+     * its button (explorerframe sends it, see handle_taskbar_list) */
+    int         progress_state;   /* SG_TBPF_* */
+    ULONGLONG   progress_done, progress_total;
+    HICON       overlay;          /* SetOverlayIcon, made here from its bits */
+    BOOL        fullscreen;       /* MarkFullscreenWindow */
+    BOOL        created_sent;     /* "TaskbarButtonCreated" posted to the window */
 };
 
+/* ITaskbarList3 progress states, as shobjidl.h */
+#define SG_TBPF_NOPROGRESS    0
+#define SG_TBPF_INDETERMINATE 1
+#define SG_TBPF_NORMAL        2
+#define SG_TBPF_ERROR         4
+#define SG_TBPF_PAUSED        8
+#define SG_PROGRESS_TIMER     0xC1A2   /* an indeterminate progress bar moves */
+
 static struct list taskbar_buttons = LIST_INIT( taskbar_buttons );
 
 /* Stained Glass OS: another window of a running program, as Windows' taskbar
@@ -1317,6 +1332,8 @@ static int sg_search_len(void)
 }
 
 /* update the taskbar buttons when something changed */
+static void sg_taskbar_list_active( HWND foreground );
+
 static void sync_taskbar_buttons(void)
 {
     struct taskbar_button *win, *other, *start = NULL;
@@ -1350,7 +1367,20 @@ static void sync_taskbar_buttons(void)
                        ((GetWindowLongW( win->hwnd, GWL_EXSTYLE ) & (WS_EX_TOOLWINDOW | WS_EX_APPWINDOW)) != WS_EX_TOOLWINDOW) &&
                        (win->elevated || vd_on_current( win->hwnd ));
         if (win->visible) count++;
+#ifndef SG_MUTANT_NO_BUTTON_CREATED
+        /* as Windows' taskbar tells a window its button is there: programs
+         * wait for it before they use ITaskbarList3 (WPF's TaskbarItemInfo,
+         * Qt's QWinTaskbarButton, Chromium, Electron) */
+        if (win->visible && !win->created_sent && !win->xwin && !win->embedded)
+        {
+            static UINT button_created;
+            if (!button_created) button_created = RegisterWindowMessageW( L"TaskbarButtonCreated" );
+            win->created_sent = TRUE;
+            PostMessageW( win->hwnd, button_created, 0, 0 );
+        }
+#endif
     }
+    sg_taskbar_list_active( foreground );
     /* one application's windows are a group, led by its first button */
     LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
     {
@@ -1702,9 +1732,218 @@ static void remove_taskbar_button( HWND hwnd )
     DestroyWindow( win->button );
     if (win->exe_icon) DestroyIcon( win->exe_icon );
     if (win->exe_icon_big) DestroyIcon( win->exe_icon_big );
+    if (win->overlay) DestroyIcon( win->overlay );
     free( win );
 }
 
+/* Stained Glass OS (1639): ITaskbarList3 (explorerframe) tells the taskbar
+ * about a window's button by WM_COPYDATA: its progress, an overlay icon (as
+ * bits: another process's icon handles cannot be drawn here), that it is a
+ * full-screen window, or that its button is to show as the active one. */
+#define SG_TASKBAR_LIST_DATA 0x53470101
+
+enum sg_taskbar_list_cmd
+{
+    SG_TBL_PROGRESS_STATE = 1,
+    SG_TBL_PROGRESS_VALUE,
+    SG_TBL_OVERLAY,
+    SG_TBL_FULLSCREEN,
+    SG_TBL_ACTIVATE,
+    SG_TBL_ACTIVE_ALT,
+};
+
+struct sg_taskbar_list_data  /* platform-independent, as struct notify_data */
+{
+    DWORD     cmd;
+    DWORD     hwnd;
+    DWORD     state;
+    DWORD     pad;
+    ULONGLONG done, total;
+    UINT      width, height, planes, bpp;   /* the overlay icon; width 0: none */
+    BYTE      icon_data[];
+};
+
+static HWND sg_tab_active;      /* ActivateTab: shown as the active one ... */
+static HWND sg_tab_active_fg;   /* ... while this is still the foreground window */
+static HWND sg_alt_active;      /* SetActiveAlt */
+
+static void sg_stack_bar(void);
+
+static BOOL sg_any_indeterminate(void)
+{
+    struct taskbar_button *win;
+
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+        if (win->hwnd && win->progress_state == SG_TBPF_INDETERMINATE) return TRUE;
+    return FALSE;
+}
+
+static void sg_repaint_progress(void)
+{
+    struct taskbar_button *win;
+
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (!win->hwnd || !win->visible || win->progress_state != SG_TBPF_INDETERMINATE) continue;
+        InvalidateRect( (win->group && win->group->combined ? win->group : win)->button, NULL, TRUE );
+    }
+}
+
+static LRESULT handle_taskbar_list( const COPYDATASTRUCT *cds )
+{
+    const struct sg_taskbar_list_data *data = cds->lpData;
+    struct taskbar_button *win;
+    HWND hwnd;
+
+    if (cds->cbData < sizeof(*data)) return FALSE;
+    hwnd = LongToHandle( data->hwnd );
+    /* no button (yet): as on Windows, programs wait for TaskbarButtonCreated */
+    if (!hwnd || !(win = find_taskbar_button( hwnd ))) return FALSE;
+
+    switch (data->cmd)
+    {
+    case SG_TBL_PROGRESS_STATE:
+        win->progress_state = data->state;
+        if (data->state == SG_TBPF_NOPROGRESS) win->progress_done = win->progress_total = 0;
+        break;
+    case SG_TBL_PROGRESS_VALUE:
+        win->progress_done = min( data->done, data->total );
+        win->progress_total = data->total;
+        /* a value means progress unless the bar is held paused or in error */
+        if (win->progress_state != SG_TBPF_ERROR && win->progress_state != SG_TBPF_PAUSED)
+            win->progress_state = SG_TBPF_NORMAL;
+        break;
+    case SG_TBL_OVERLAY:
+    {
+        HICON icon = NULL;
+        if (data->width)
+        {
+            LONG mask_bits = (data->width * data->height + 15) / 16 * 2;
+            LONG color_bits = (data->planes * data->width * data->height * data->bpp + 15) / 16 * 2;
+            if (data->width > 256 || data->height > 256 || data->bpp > 32 ||
+                cds->cbData < sizeof(*data) + mask_bits + color_bits) return FALSE;
+            icon = CreateIcon( NULL, data->width, data->height, data->planes, data->bpp,
+                               data->icon_data, data->icon_data + mask_bits );
+        }
+        if (win->overlay) DestroyIcon( win->overlay );
+        win->overlay = icon;
+        break;
+    }
+    case SG_TBL_FULLSCREEN:
+        win->fullscreen = data->state != 0;
+        sg_stack_bar();
+        break;
+    case SG_TBL_ACTIVATE:
+        sg_tab_active = hwnd;
+        sg_tab_active_fg = GetAncestor( GetForegroundWindow(), GA_ROOTOWNER );
+        sync_taskbar_buttons();
+        break;
+    case SG_TBL_ACTIVE_ALT:
+        sg_alt_active = hwnd;
+        sync_taskbar_buttons();
+        break;
+    default:
+        return FALSE;
+    }
+
+    if (sg_any_indeterminate()) SetTimer( tray_window, SG_PROGRESS_TIMER, 50, NULL );
+    InvalidateRect( win->button, NULL, TRUE );
+    if (win->group && win->group != win) InvalidateRect( win->group->button, NULL, TRUE );
+    return TRUE;
+}
+
+/* which button shows as the active one: the foreground window's, unless
+ * ActivateTab named another (until the foreground changes), or, when the
+ * foreground window has none, the one SetActiveAlt named */
+static void sg_taskbar_list_active( HWND foreground )
+{
+    struct taskbar_button *win, *shown = NULL;
+
+    if (sg_tab_active && (foreground != sg_tab_active_fg || !IsWindow( sg_tab_active ))) sg_tab_active = NULL;
+    if (sg_alt_active && !IsWindow( sg_alt_active )) sg_alt_active = NULL;
+    if (sg_tab_active && (shown = find_taskbar_button( sg_tab_active )) && shown->visible) ;
+    else
+    {
+        shown = NULL;
+        if (!sg_alt_active) return;
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+            if (win->hwnd && win->visible && win->active) return;
+        if (!(shown = find_taskbar_button( sg_alt_active )) || !shown->visible) return;
+    }
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+        if (win->hwnd && !win->xwin && !win->elevated) win->active = (win == shown);
+}
+
+/* the button whose progress a button shows: its own, or for a combined
+ * button the first of its windows that has some */
+static struct taskbar_button *sg_progress_source( struct taskbar_button *button )
+{
+    struct taskbar_button *win;
+
+    if (button->progress_state != SG_TBPF_NOPROGRESS || !button->combined || button->group_count < 2) return button;
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+        if (win->hwnd && win->visible && win->group == button && win->progress_state != SG_TBPF_NOPROGRESS) return win;
+    return button;
+}
+
+/* the progress under a button's icon and title, as Windows' taskbar fills the
+ * button: green, yellow when paused, red on an error; a moving band when
+ * indeterminate */
+static void sg_paint_progress( HDC hdc, const RECT *rect, struct taskbar_button *button )
+{
+    struct taskbar_button *win = sg_progress_source( button );
+    COLORREF color;
+    RECT fill = *rect;
+    int width = rect->right - rect->left;
+    HBRUSH brush;
+
+#ifdef SG_MUTANT_NO_PROGRESS_PAINT
+    return;
+#endif
+    switch (win->progress_state)
+    {
+    case SG_TBPF_NORMAL:        color = RGB(0x06,0xB0,0x25); break;
+    case SG_TBPF_INDETERMINATE: color = RGB(0x06,0xB0,0x25); break;
+    case SG_TBPF_ERROR:         color = RGB(0xE8,0x11,0x23); break;
+    case SG_TBPF_PAUSED:        color = RGB(0xFF,0xC1,0x07); break;
+    default: return;
+    }
+    if (width <= 0) return;
+    if (win->progress_state == SG_TBPF_INDETERMINATE)
+    {
+        int band = max( width / 4, 8 ), pos = (GetTickCount() / 6) % (width + band);
+        fill.left = rect->left + pos - band;
+        fill.right = fill.left + band;
+        fill.left = max( fill.left, rect->left );
+        fill.right = min( fill.right, rect->right );
+    }
+    else
+    {
+        if (!win->progress_total) return;
+        fill.right = rect->left + (int)(width * (double)win->progress_done / win->progress_total);
+    }
+    if (fill.right <= fill.left) return;
+    brush = CreateSolidBrush( color );
+    FillRect( hdc, &fill, brush );
+    DeleteObject( brush );
+}
