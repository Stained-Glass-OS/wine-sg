 #define WM_WINE_DELETE_TAB      (WM_USER + 1)
 #define WM_WINE_ADD_TAB         (WM_USER + 2)
 
+/* Stained Glass OS (1639): what a program says about its taskbar button goes
+ * to the taskbar (explorer's Shell_TrayWnd) by WM_COPYDATA; it is drawn
+ * there. As programs/explorer/systray.c's handle_taskbar_list. */
+#define SG_TASKBAR_LIST_DATA 0x53470101
+
+enum sg_taskbar_list_cmd
+{
+    SG_TBL_PROGRESS_STATE = 1,
+    SG_TBL_PROGRESS_VALUE,
+    SG_TBL_OVERLAY,
+    SG_TBL_FULLSCREEN,
+    SG_TBL_ACTIVATE,
+    SG_TBL_ACTIVE_ALT,
+};
+
+struct sg_taskbar_list_data  /* platform-independent, as struct notify_data */
+{
+    DWORD     cmd;
+    DWORD     hwnd;
+    DWORD     state;
+    DWORD     pad;
+    ULONGLONG done, total;
+    UINT      width, height, planes, bpp;   /* the overlay icon; width 0: none */
+    BYTE      icon_data[];
+};
+
+/* an elevated program (ADR 0012) runs on a Wine desktop of its own; its
+ * buttons are on the session's shell's taskbar, on another desktop of the
+ * window station (as shell32's notification icons) */
+struct tray_search { HWND tray; };
+
+static BOOL CALLBACK find_tray_window( HWND hwnd, LPARAM lparam )
+{
+    struct tray_search *search = (struct tray_search *)lparam;
+    WCHAR class[32];
+
+    if (!GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) || wcscmp( class, L"Shell_TrayWnd" )) return TRUE;
+    if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE)) return TRUE;
+    search->tray = hwnd;
+    return FALSE;
+}
+
+static BOOL CALLBACK find_tray_desktop( WCHAR *name, LPARAM lparam )
+{
+    struct tray_search *search = (struct tray_search *)lparam;
+    HDESK desk;
+
+    if (!wcsnicmp( name, L"sg-elevated-", 12 )) return TRUE;
+    if (!(desk = OpenDesktopW( name, 0, FALSE, DESKTOP_READOBJECTS | DESKTOP_ENUMERATE ))) return TRUE;
+    EnumDesktopWindows( desk, find_tray_window, lparam );
+    CloseDesktop( desk );
+    return !search->tray;
+}
+
+static HWND find_tray(void)
+{
+    struct tray_search search = { NULL };
+    WCHAR name[64];
+
+    if (GetUserObjectInformationW( GetThreadDesktop( GetCurrentThreadId() ), UOI_NAME, name, sizeof(name), NULL ) &&
+        !wcsnicmp( name, L"sg-elevated-", 12 ))
+    {
+        EnumDesktopsW( GetProcessWindowStation(), find_tray_desktop, (LPARAM)&search );
+        if (search.tray) return search.tray;
+    }
+    return FindWindowExW( 0, NULL, L"Shell_TrayWnd", NULL );
+}
+
+static void send_taskbar_data( struct sg_taskbar_list_data *data, DWORD size )
+{
+    COPYDATASTRUCT cds;
+    DWORD_PTR result;
+    HWND tray;
+
+#ifdef SG_MUTANT_NO_TASKBAR_DATA
+    return;
+#endif
+    if (!(tray = find_tray())) return;  /* no taskbar: nothing shows it */
+    cds.dwData = SG_TASKBAR_LIST_DATA;
+    cds.cbData = size;
+    cds.lpData = data;
+    SendMessageTimeoutW( tray, WM_COPYDATA, 0, (LPARAM)&cds, SMTO_ABORTIFHUNG, 2000, &result );
+}
+
+static void send_taskbar_cmd( DWORD cmd, HWND hwnd, DWORD state, ULONGLONG done, ULONGLONG total )
+{
+    struct sg_taskbar_list_data data = { 0 };
+
+    if (!hwnd || !IsWindow( hwnd )) return;
+    data.cmd = cmd;
+    data.hwnd = HandleToLong( hwnd );
+    data.state = state;
+    data.done = done;
+    data.total = total;
+    send_taskbar_data( &data, sizeof(data) );
+}
+
+/* an icon as bits the taskbar makes its own icon from: icon handles are per
+ * process */
+static void send_overlay_icon( HWND hwnd, HICON icon )
+{
+    struct sg_taskbar_list_data *data;
+    BITMAP color, mask;
+    ICONINFO info;
+    LONG mask_size = 0, color_size = 0;
+
+    if (!hwnd || !IsWindow( hwnd )) return;
+    if (!icon || !GetIconInfo( icon, &info ))
+    {
+        send_taskbar_cmd( SG_TBL_OVERLAY, hwnd, 0, 0, 0 );
+        return;
+    }
+    if (!info.hbmColor || !GetObjectW( info.hbmColor, sizeof(color), &color ) ||
+        !GetObjectW( info.hbmMask, sizeof(mask), &mask ))
+    {
+        /* a monochrome icon: none */
+        WARN( "icon %p has no colour bitmap\n", icon );
+        if (info.hbmColor) DeleteObject( info.hbmColor );
+        DeleteObject( info.hbmMask );
+        send_taskbar_cmd( SG_TBL_OVERLAY, hwnd, 0, 0, 0 );
+        return;
+    }
+    mask_size = (color.bmWidth * color.bmHeight + 15) / 16 * 2;
+    color_size = (color.bmPlanes * color.bmWidth * color.bmHeight * color.bmBitsPixel + 15) / 16 * 2;
+    if ((data = calloc( 1, sizeof(*data) + mask_size + color_size )))
+    {
+        data->cmd = SG_TBL_OVERLAY;
+        data->hwnd = HandleToLong( hwnd );
+        data->width = color.bmWidth;
+        data->height = color.bmHeight;
+        data->planes = color.bmPlanes;
+        data->bpp = color.bmBitsPixel;
+        GetBitmapBits( info.hbmMask, mask_size, data->icon_data );
+        GetBitmapBits( info.hbmColor, color_size, data->icon_data + mask_size );
+        send_taskbar_data( data, sizeof(*data) + mask_size + color_size );
+        free( data );
+    }
+    DeleteObject( info.hbmColor );
+    DeleteObject( info.hbmMask );
+}
+
