 }
 
 /* ITaskbarList3 methods */
@@ -144,10 +290,10 @@ static HRESULT STDMETHODCALLTYPE taskbar_list_SetProgressValue(ITaskbarList4 *if
                                                                ULONGLONG ullCompleted,
                                                                ULONGLONG ullTotal)
 {
-    static BOOL fixme_once;
-    if(!fixme_once++) FIXME("iface %p, hwnd %p, ullCompleted %s, ullTotal %s stub!\n", iface, hwnd,
-                            wine_dbgstr_longlong(ullCompleted), wine_dbgstr_longlong(ullTotal));
+    TRACE("iface %p, hwnd %p, ullCompleted %s, ullTotal %s\n", iface, hwnd,
+          wine_dbgstr_longlong(ullCompleted), wine_dbgstr_longlong(ullTotal));
 
+    send_taskbar_cmd(SG_TBL_PROGRESS_VALUE, hwnd, 0, ullCompleted, ullTotal);
     return S_OK;
 }
 
@@ -155,9 +301,20 @@ static HRESULT STDMETHODCALLTYPE taskbar_list_SetProgressState(ITaskbarList4 *if
                                                                HWND hwnd,
                                                                TBPFLAG tbpFlags)
 {
-    static BOOL fixme_once;
-    if(!fixme_once++) FIXME("iface %p, hwnd %p, flags %x stub!\n", iface, hwnd, tbpFlags);
+    TRACE("iface %p, hwnd %p, flags %x\n", iface, hwnd, tbpFlags);
 
+    switch (tbpFlags)
+    {
+    case TBPF_NOPROGRESS:
+    case TBPF_INDETERMINATE:
+    case TBPF_NORMAL:
+    case TBPF_ERROR:
+    case TBPF_PAUSED:
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    send_taskbar_cmd(SG_TBL_PROGRESS_STATE, hwnd, tbpFlags, 0, 0);
     return S_OK;
 }
 
@@ -228,9 +385,11 @@ static HRESULT STDMETHODCALLTYPE taskbar_list_SetOverlayIcon(ITaskbarList4 *ifac
                                                              HICON hIcon,
                                                              LPCWSTR pszDescription)
 {
-    FIXME("iface %p, hwnd %p, hIcon %p, pszDescription %s stub!\n", iface, hwnd, hIcon,
+    TRACE("iface %p, hwnd %p, hIcon %p, pszDescription %s\n", iface, hwnd, hIcon,
           debugstr_w(pszDescription));
 
+    /* NULL takes the overlay away; the description is for accessibility */
+    send_overlay_icon(hwnd, hIcon);
     return S_OK;
 }
 
