-    FIXME("iface %p, hwnd %p, fullscreen %s stub!\n", iface, hwnd, (fullscreen)?"true":"false");
+    TRACE("iface %p, hwnd %p, fullscreen %s\n", iface, hwnd, (fullscreen)?"true":"false");
 
-    return E_NOTIMPL;
