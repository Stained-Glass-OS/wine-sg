+/* SetOverlayIcon's icon at the bottom right of the button's icon */
+static void sg_paint_overlay( HDC hdc, int x, int y, int cx, struct taskbar_button *button )
+{
+    struct taskbar_button *win = button;
+    int size = max( cx * 5 / 8, 10 );
+
+    if (!win->overlay && button->combined && button->group_count > 1)
+    {
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+            if (win->hwnd && win->visible && win->group == button && win->overlay) break;
+        if (&win->entry == &taskbar_buttons) return;
+    }
+    if (!win->overlay) return;
+    DrawIconEx( hdc, x + cx - size + 2, y + cx - size + 2, win->overlay, size, size, 0, 0, DI_NORMAL );
+}
