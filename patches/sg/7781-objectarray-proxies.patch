From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] actxprxy: proxies for IObjectArray and IObjectCollection

IObjectArray and IObjectCollection had no proxy, so they could not cross
apartments: Office logged "CoMarshalInterface failed" for {92ca9dcd-...} at
every start. actxprxy now builds and registers their proxies, as on Windows.
---
diff --git a/dlls/actxprxy/Makefile.in b/dlls/actxprxy/Makefile.in
index ba170c4..4d4bdd5 100644
--- a/dlls/actxprxy/Makefile.in
+++ b/dlls/actxprxy/Makefile.in
@@ -10,6 +10,7 @@ SOURCES = \
 	actxprxy_htiframe.idl \
 	actxprxy_netlistmgr.idl \
 	actxprxy_notification.idl \
+	actxprxy_objectarray.idl \
 	actxprxy_objsafe.idl \
 	actxprxy_ocmm.idl \
 	actxprxy_servprov.idl \
diff --git a/dlls/actxprxy/actxprxy_objectarray.idl b/dlls/actxprxy/actxprxy_objectarray.idl
new file mode 100644
index 0000000..6aa3839
--- /dev/null
+++ b/dlls/actxprxy/actxprxy_objectarray.idl
@@ -0,0 +1,31 @@
+/*
+ * Proxies for IObjectArray and IObjectCollection (Stained Glass OS)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Office hands object arrays (jump list and sharing items) to other apartments: on Windows
+ * actxprxy marshals them; here CoMarshalInterface failed with E_NOINTERFACE. */
+
+#pragma makedep proxy
+#pragma makedep register
+
+#include "objectarray.idl"
+
+[
+    threading(both),
+    uuid(b8da6310-e19b-11d0-933c-00a0c90dcaa9)  /* IActiveScriptStats */
+]
+coclass PSFactoryBuffer { interface IPSFactoryBuffer; }
