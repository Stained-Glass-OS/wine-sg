+/* Stained Glass OS: the foreground window fills its monitor -- a game, a
+ * video, a browser's full screen */
+static BOOL sg_fullscreen_foreground( HWND fg )
+{
+    MONITORINFO mi = { sizeof(mi) };
+    DWORD pid;
+    RECT rc;
+
+    if (!fg || fg == tray_window || !IsWindowVisible( fg )) return FALSE;
+    GetWindowThreadProcessId( fg, &pid );
+    if (pid == GetCurrentProcessId()) return FALSE;   /* the desktop, Start, Task View */
+    if (!GetWindowRect( fg, &rc )) return FALSE;
+    if (!GetMonitorInfoW( MonitorFromWindow( fg, MONITOR_DEFAULTTONEAREST ), &mi )) return FALSE;
+    return rc.left <= mi.rcMonitor.left && rc.top <= mi.rcMonitor.top &&
+           rc.right >= mi.rcMonitor.right && rc.bottom >= mi.rcMonitor.bottom;
+}
+
+/* Stained Glass OS: the bar is above the windows, as Windows' is -- a window
+ * dragged over it went over it (it was among them unless it hid itself) --
+ * but behind a full-screen window in the foreground. Asked again whenever a
+ * window comes forward: in the virtual desktop X stacks a newly shown window
+ * of another program above it, whatever Wine's order says. */
+static void sg_stack_bar(void)
+{
+    const UINT flags = SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER;
+    HWND fg = GetForegroundWindow();
+
+    if (!tray_window) return;
+    if (!sg_bar.autohide && sg_fullscreen_foreground( fg ))
+    {
+        SetWindowPos( tray_window, HWND_NOTOPMOST, 0, 0, 0, 0, flags );
+        SetWindowPos( tray_window, fg, 0, 0, 0, 0, flags );
+        /* and the full-screen window above it in X too: its own process
+         * restacks it (X stacking below another program's window is left
+         * alone) */
+        SetWindowPos( fg, HWND_TOP, 0, 0, 0, 0, flags | SWP_ASYNCWINDOWPOS );
+    }
+    else
+    {
+        /* already topmost changes nothing, and X keeps a newly shown window of
+         * another program above it: a change of order makes the driver
+         * restack the bar's X window on top */
+        if (GetWindowLongW( tray_window, GWL_EXSTYLE ) & WS_EX_TOPMOST)
+            SetWindowPos( tray_window, HWND_NOTOPMOST, 0, 0, 0, 0, flags );
+        SetWindowPos( tray_window, HWND_TOPMOST, 0, 0, 0, 0, flags );
+    }
+}
