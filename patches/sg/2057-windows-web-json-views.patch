From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.web: JSON array and object views (2057)

windows.web: IVector::GetView and IMap::GetView of JSON arrays and objects.

JsonArray's GetView gives an IVectorView<IJsonValue> (GetAt, Size, IndexOf,
GetMany, and the iterable) and JsonObject's an IMapView<HSTRING,IJsonValue>
(Lookup, Size, HasKey, Split, and the iterable of pairs). A view follows its
array or object and keeps it alive. They were E_NOTIMPL.
---
--- a/dlls/windows.web/json_value.c
+++ b/dlls/windows.web/json_value.c
@@ -1478,6 +1478,205 @@
     json_iterable_map_First,
 };
 
+/* ---- IVectorView<IJsonValue> and IMapView<HSTRING,IJsonValue>: read-only looks at an array or object ---- */
+
+struct json_view
+{
+    IVectorView_IJsonValue IVectorView_iface;
+    IMapView_HSTRING_IJsonValue IMapView_iface;
+    LONG ref;
+    struct json_value *parent;
+    BOOL map;
+};
+
+static inline struct json_view *view_from_vector( IVectorView_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_view, IVectorView_iface );
+}
+
+static inline struct json_view *view_from_map( IMapView_HSTRING_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_view, IMapView_iface );
+}
+
+static HRESULT view_qi( struct json_view *impl, REFIID iid, void **out )
+{
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = impl->map ? (void *)&impl->IMapView_iface : (void *)&impl->IVectorView_iface;
+    else if (!impl->map && IsEqualGUID( iid, &IID_IVectorView_IJsonValue )) *out = &impl->IVectorView_iface;
+    else if (impl->map && IsEqualGUID( iid, &IID_IMapView_HSTRING_IJsonValue )) *out = &impl->IMapView_iface;
+    else if (!impl->map && IsEqualGUID( iid, &IID_IIterable_IJsonValue )) *out = &impl->parent->IIterable_IJsonValue_iface;
+    else if (impl->map && IsEqualGUID( iid, &IID_IIterable_IKeyValuePair_HSTRING_IJsonValue ))
+        *out = &impl->parent->IIterable_IKeyValuePair_HSTRING_IJsonValue_iface;
+    if (!*out) return E_NOINTERFACE;
+    if (*out == (void *)&impl->parent->IIterable_IJsonValue_iface ||
+        *out == (void *)&impl->parent->IIterable_IKeyValuePair_HSTRING_IJsonValue_iface)
+        IJsonValue_AddRef( &impl->parent->IJsonValue_iface );
+    else
+        InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG view_release( struct json_view *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IJsonValue_Release( &impl->parent->IJsonValue_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI vview_QueryInterface( IVectorView_IJsonValue *iface, REFIID iid, void **out )
+{
+    return view_qi( view_from_vector( iface ), iid, out );
+}
+
+static ULONG WINAPI vview_AddRef( IVectorView_IJsonValue *iface )
+{
+    return InterlockedIncrement( &view_from_vector( iface )->ref );
+}
+
+static ULONG WINAPI vview_Release( IVectorView_IJsonValue *iface )
+{
+    return view_release( view_from_vector( iface ) );
+}
+
+static HRESULT WINAPI vview_GetIids( IVectorView_IJsonValue *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI vview_GetRuntimeClassName( IVectorView_IJsonValue *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI vview_GetTrustLevel( IVectorView_IJsonValue *iface, TrustLevel *level )
+{
+    if (level) *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI vview_GetAt( IVectorView_IJsonValue *iface, UINT32 index, IJsonValue **value )
+{
+    return IVector_IJsonValue_GetAt( &view_from_vector( iface )->parent->IVector_IJsonValue_iface, index, value );
+}
+
+static HRESULT WINAPI vview_get_Size( IVectorView_IJsonValue *iface, UINT32 *value )
+{
+    return IVector_IJsonValue_get_Size( &view_from_vector( iface )->parent->IVector_IJsonValue_iface, value );
+}
+
+static HRESULT WINAPI vview_IndexOf( IVectorView_IJsonValue *iface, IJsonValue *element, UINT32 *index, boolean *found )
+{
+    return IVector_IJsonValue_IndexOf( &view_from_vector( iface )->parent->IVector_IJsonValue_iface, element, index, found );
+}
+
+static HRESULT WINAPI vview_GetMany( IVectorView_IJsonValue *iface, UINT32 start, UINT32 capacity, IJsonValue **items, UINT32 *actual )
+{
+    return IVector_IJsonValue_GetMany( &view_from_vector( iface )->parent->IVector_IJsonValue_iface, start, capacity, items, actual );
+}
+
+static const IVectorView_IJsonValueVtbl vview_vtbl =
+{
+    vview_QueryInterface,
+    vview_AddRef,
+    vview_Release,
+    vview_GetIids,
+    vview_GetRuntimeClassName,
+    vview_GetTrustLevel,
+    vview_GetAt,
+    vview_get_Size,
+    vview_IndexOf,
+    vview_GetMany,
+};
+
+static HRESULT WINAPI mview_QueryInterface( IMapView_HSTRING_IJsonValue *iface, REFIID iid, void **out )
+{
+    return view_qi( view_from_map( iface ), iid, out );
+}
+
+static ULONG WINAPI mview_AddRef( IMapView_HSTRING_IJsonValue *iface )
+{
+    return InterlockedIncrement( &view_from_map( iface )->ref );
+}
+
+static ULONG WINAPI mview_Release( IMapView_HSTRING_IJsonValue *iface )
+{
+    return view_release( view_from_map( iface ) );
+}
+
+static HRESULT WINAPI mview_GetIids( IMapView_HSTRING_IJsonValue *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI mview_GetRuntimeClassName( IMapView_HSTRING_IJsonValue *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI mview_GetTrustLevel( IMapView_HSTRING_IJsonValue *iface, TrustLevel *level )
+{
+    if (level) *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI mview_Lookup( IMapView_HSTRING_IJsonValue *iface, HSTRING key, IJsonValue **value )
+{
+    return IMap_HSTRING_IJsonValue_Lookup( &view_from_map( iface )->parent->IMap_HSTRING_IJsonValue_iface, key, value );
+}
+
+static HRESULT WINAPI mview_get_Size( IMapView_HSTRING_IJsonValue *iface, UINT32 *value )
+{
+    return IMap_HSTRING_IJsonValue_get_Size( &view_from_map( iface )->parent->IMap_HSTRING_IJsonValue_iface, value );
+}
+
+static HRESULT WINAPI mview_HasKey( IMapView_HSTRING_IJsonValue *iface, HSTRING key, boolean *found )
+{
+    return IMap_HSTRING_IJsonValue_HasKey( &view_from_map( iface )->parent->IMap_HSTRING_IJsonValue_iface, key, found );
+}
+
+static HRESULT WINAPI mview_Split( IMapView_HSTRING_IJsonValue *iface, IMapView_HSTRING_IJsonValue **first,
+                                   IMapView_HSTRING_IJsonValue **second )
+{
+    /* a collection that cannot be divided gives two nothings */
+    if (!first || !second) return E_POINTER;
+    *first = *second = NULL;
+    return S_OK;
+}
+
+static const IMapView_HSTRING_IJsonValueVtbl mview_vtbl =
+{
+    mview_QueryInterface,
+    mview_AddRef,
+    mview_Release,
+    mview_GetIids,
+    mview_GetRuntimeClassName,
+    mview_GetTrustLevel,
+    mview_Lookup,
+    mview_get_Size,
+    mview_HasKey,
+    mview_Split,
+};
+
+static struct json_view *view_create( struct json_value *parent, BOOL map )
+{
+    struct json_view *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IVectorView_iface.lpVtbl = &vview_vtbl;
+    impl->IMapView_iface.lpVtbl = &mview_vtbl;
+    impl->ref = 1;
+    impl->parent = parent;
+    impl->map = map;
+    IJsonValue_AddRef( &parent->IJsonValue_iface );
+    return impl;
+}
+
 /* ---- IVector<IJsonValue> ---- */
 
 DEFINE_IINSPECTABLE( json_vector, IVector_IJsonValue, struct json_value, IJsonValue_iface )
@@ -1509,9 +1708,19 @@
 
 static HRESULT WINAPI json_vector_GetView( IVector_IJsonValue *iface, IVectorView_IJsonValue **value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    if (value) *value = NULL;
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IVector_IJsonValue_iface );
+    struct json_view *view;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+#ifdef SG_MUTANT_JSON_VIEW
     return E_NOTIMPL;
+#endif
+    if (!(view = view_create( impl, FALSE ))) return E_OUTOFMEMORY;
+    *value = &view->IVectorView_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI json_vector_IndexOf( IVector_IJsonValue *iface, IJsonValue *value, UINT32 *index, boolean *found )
@@ -1721,9 +1930,16 @@
 
 static HRESULT WINAPI json_map_GetView( IMap_HSTRING_IJsonValue *iface, IMapView_HSTRING_IJsonValue **value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    if (value) *value = NULL;
-    return E_NOTIMPL;
+    struct json_value *impl = CONTAINING_RECORD( iface, struct json_value, IMap_HSTRING_IJsonValue_iface );
+    struct json_view *view;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(view = view_create( impl, TRUE ))) return E_OUTOFMEMORY;
+    *value = &view->IMapView_iface;
+    return S_OK;
 }
 
