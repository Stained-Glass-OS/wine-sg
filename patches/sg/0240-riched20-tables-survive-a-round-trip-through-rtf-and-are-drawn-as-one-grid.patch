From: Stained Glass OS <dev@stained-glass.example>
Subject: riched20: tables survive a round trip through RTF and are drawn as one grid

Found adding tables to sg-shell's WordPad (a table inserted by streaming RTF
in, saved as RTF, and opened again); every RichEdit 4.1 program with tables
benefits:

- The writer skips a paragraph's properties when they equal the previous
  paragraph's. A row's first cell follows the row's start paragraph, whose
  format it shares, so its \intbl was never written: reopened, the first
  row lost its cells and the table fell apart. The skip no longer applies
  after a row's start or end.
- A row's \trowd is written after \pard (4.1 mode), so the row does not
  inherit the paragraph before it's spacing.
- The reader's \cell (4.1) did not apply the cell's paragraph format as
  \par does, so a cell kept the format of the paragraph it was split from
  (the one before the table: its space before/after opened gaps between
  the rows). It is applied, and reset, as at \par.
- A row's start and end paragraphs are delimiters only: their space before
  and after (inherited from the paragraph they were split from) is not
  laid out, as on Windows, so the rows of a table touch.

riched20:editor, richole and txtsrv conformance tests: no new failures.
---
diff --git a/dlls/riched20/editor.c b/dlls/riched20/editor.c
index 3b4069f..add24f0 100644
--- a/dlls/riched20/editor.c
+++ b/dlls/riched20/editor.c
@@ -948,6 +948,12 @@ void ME_RTFSpecialCharHook(RTF_Info *info)
       RTFFlushOutputBuffer(info);
       if (!info->editor->bEmulateVersion10) /* v4.1 */
       {
+        /* the cell's paragraph takes its own format, as \par gives one:
+         * otherwise it keeps the format of the paragraph it was split from
+         * (the one before the table), spacing and all */
+        editor_set_selection_para_fmt( info->editor, &info->fmt );
+        memset( &info->fmt, 0, sizeof(info->fmt) );
+        info->fmt.cbSize = sizeof(info->fmt);
         if (tableDef->row_start)
         {
           if (!info->nestingLevel && tableDef->row_start->nFlags & MEPF_ROWEND)
diff --git a/dlls/riched20/wrap.c b/dlls/riched20/wrap.c
index a4d638a..3b401cf 100644
--- a/dlls/riched20/wrap.c
+++ b/dlls/riched20/wrap.c
@@ -877,7 +877,9 @@ static void ME_WrapTextParagraph( ME_TextEditor *editor, ME_Context *c, ME_Parag
   }
   wc.nRow = 0;
   wc.pt.y = 0;
-  if (para->fmt.dwMask & PFM_SPACEBEFORE)
+  /* a table row's start and end paragraphs are only its delimiters: they
+   * take the spacing of the paragraph they were split from, but have none */
+  if (para->fmt.dwMask & PFM_SPACEBEFORE && !(para->nFlags & (MEPF_ROWSTART | MEPF_ROWEND)))
     wc.pt.y += ME_twips2pointsY( c, para->fmt.dySpaceBefore );
   if (!(para->fmt.dwMask & PFM_TABLE && para->fmt.wEffects & PFE_TABLE) &&
       para->fmt.dwMask & PFM_BORDER)
@@ -905,7 +907,7 @@ static void ME_WrapTextParagraph( ME_TextEditor *editor, ME_Context *c, ME_Parag
   if (!(para->fmt.dwMask & PFM_TABLE && para->fmt.wEffects & PFE_TABLE) &&
       (para->fmt.dwMask & PFM_BORDER) && (para->fmt.wBorders & 8))
     wc.pt.y += border;
-  if (para->fmt.dwMask & PFM_SPACEAFTER)
+  if (para->fmt.dwMask & PFM_SPACEAFTER && !(para->nFlags & (MEPF_ROWSTART | MEPF_ROWEND)))
       wc.pt.y += ME_twips2pointsY( c, para->fmt.dySpaceAfter );
 
   para->nFlags &= ~MEPF_REWRAP;
diff --git a/dlls/riched20/writer.c b/dlls/riched20/writer.c
index 2f7f2b5..6ad8ed1 100644
--- a/dlls/riched20/writer.c
+++ b/dlls/riched20/writer.c
@@ -390,7 +390,8 @@ static BOOL stream_out_table_props( ME_TextEditor *editor, ME_OutStream *pStream
   int i;
   const char sideChar[4] = {'t','l','b','r'};
 
-  if (!ME_StreamOutPrint(pStream, "\\trowd"))
+  /* \pard first: a row does not take the paragraph before it's spacing */
+  if (!ME_StreamOutPrint(pStream, editor->bEmulateVersion10 ? "\\trowd" : "\\pard\\trowd"))
     return FALSE;
   if (!editor->bEmulateVersion10) /* v4.1 */
   {
@@ -565,7 +566,10 @@ static BOOL stream_out_para_props( ME_TextEditor *editor, ME_OutStream *pStream,
       if (!stream_out_table_props( editor, pStream, para )) return FALSE;
   }
 
-  if (prev_para && !memcmp( fmt, &prev_para->fmt, sizeof(*fmt) ))
+  /* a row's first cell follows the row's start, whose format it shares:
+   * write it anyway, or \intbl is lost and the table with it */
+  if (prev_para && !(prev_para->nFlags & (MEPF_ROWSTART | MEPF_ROWEND)) &&
+      !memcmp( fmt, &prev_para->fmt, sizeof(*fmt) ))
   {
     if (fmt->wNumbering)
       return stream_out_para_num( pStream, para, FALSE );
