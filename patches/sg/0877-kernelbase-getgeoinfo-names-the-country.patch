From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: GetGeoInfo names the country (GEO_NAME, GEO_FRIENDLYNAME)

GetGeoInfo(GEO_FRIENDLYNAME) was "not supported". DYMO Connect places the
user by it to choose its label catalogue: the failure read as Europe, and the
United States' labels -- the 30336 loaded in the printer among them -- were
missing. GEO_NAME is the ISO 3166 code; GEO_FRIENDLYNAME and GEO_OFFICIALNAME
the country's English name, from a locale of that country.

Test: test/usbprint-gate.sh (mutant SG_MUTANT_GEONAME).
---
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -1840,13 +1840,45 @@
     case GEO_CURRENCYSYMBOL:
         str = geo->currsymbol;
         break;
+#ifndef SG_MUTANT_GEONAME
+    case GEO_NAME:
+        str = geo->iso2;
+        break;
+    case GEO_FRIENDLYNAME:
+    case GEO_OFFICIALNAME:
+    {
+        /* Stained Glass OS: the country's English name, from a locale of the
+         * country. Was "not supported": programs that ask it to place the
+         * user (DYMO Connect's label catalogue: the United States' labels
+         * were missing, the European ones shown) took the failure for
+         * another region. */
+        UINT i;
+
+        str = NULL;
+        for (i = 0; i < locale_table->nb_lcnames && !str; i++)
+        {
+            const NLS_LOCALE_DATA *locale = get_locale_data( lcnames_index[i].idx );
+            if (!wcsicmp( locale_strings + locale->siso3166ctryname + 1, geo->iso2 ) &&
+                locale_strings[locale->sengcountry])
+                str = locale_strings + locale->sengcountry + 1;
+        }
+        if (!str)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return 0;
+        }
+        break;
+    }
+#endif
     case GEO_RFC1766:
     case GEO_LCID:
+#ifdef SG_MUTANT_GEONAME
     case GEO_FRIENDLYNAME:
     case GEO_OFFICIALNAME:
+    case GEO_NAME:
+#endif
     case GEO_TIMEZONES:
     case GEO_OFFICIALLANGUAGES:
-    case GEO_NAME:
         FIXME( "type %u is not supported\n", type );
         SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
         return 0;
