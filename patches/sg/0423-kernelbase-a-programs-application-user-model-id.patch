+/* An application's user model ID is its package family and its
+ * application's id. The package's app execution aliases record both for an
+ * executable, so the one whose target is this image names it. */
+static LONG application_user_model_id( const WCHAR *image, UINT32 *length, WCHAR *id )
+{
+    WCHAR name[256], path[MAX_PATH], key[MAX_PATH], aliases[4096];
+    WCHAR text[APPEXECLINK_MAX_SIZE / sizeof(WCHAR) + 1];
+    const WCHAR *family, *aumid, *target, *alias;
+    DWORD len, index = 0, plen, bytes, read;
+    LONG ret = APPMODEL_ERROR_NO_APPLICATION;
+    LARGE_INTEGER size;
+    HANDLE file;
+    HKEY packages;
+
+    if (!length) return ERROR_INVALID_PARAMETER;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, deployed_packagesW, 0, KEY_READ, &packages )) return ret;
+    while (ret == APPMODEL_ERROR_NO_APPLICATION &&
+           (len = ARRAY_SIZE(name), !RegEnumKeyExW( packages, index++, name, &len, NULL, NULL, NULL, NULL )))
+    {
+        if (!package_location( name, path, ARRAY_SIZE(path) ) || !(plen = wcslen( path ))) continue;
+        if (wcslen( image ) <= plen || wcsnicmp( image, path, plen ) || image[plen] != '\\') continue;
+
+        swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, name );
+        bytes = sizeof(aliases) - 2 * sizeof(WCHAR);
+        memset( aliases, 0, sizeof(aliases) );
+        if (RegGetValueW( HKEY_CURRENT_USER, key, L"Aliases", RRF_RT_REG_MULTI_SZ, NULL, aliases, &bytes )) continue;
+        for (alias = aliases; *alias && ret == APPMODEL_ERROR_NO_APPLICATION; alias += wcslen( alias ) + 1)
+        {
+            file = CreateFileW( alias, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, 0 );
+            if (file == INVALID_HANDLE_VALUE) continue;
+            read = 0;
+            if (GetFileSizeEx( file, &size ) && size.QuadPart <= APPEXECLINK_MAX_SIZE)
+                ReadFile( file, text, size.u.LowPart, &read, NULL );
+            CloseHandle( file );
+            text[read / sizeof(WCHAR)] = 0;
+            if (appexeclink_parse( text, &family, &aumid, &target ) && aumid && aumid[0] && !wcsicmp( target, image ))
+                ret = copy_package_string( aumid, length, id );
+        }
+    }
+    RegCloseKey( packages );
+    return ret;
+}
+
+
+/***********************************************************************
+ *         GetCurrentApplicationUserModelId   (kernelbase.@)
+ */
+LONG WINAPI GetCurrentApplicationUserModelId( UINT32 *length, WCHAR *id )
+{
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    WCHAR path[MAX_PATH];
+
+    TRACE( "(%p %p)\n", length, id );
+
+    if (image->Length >= sizeof(path)) return APPMODEL_ERROR_NO_APPLICATION;
+    memcpy( path, image->Buffer, image->Length );
+    path[image->Length / sizeof(WCHAR)] = 0;
+    return application_user_model_id( path, length, id );
+}
+
+
+/***********************************************************************
+ *         GetApplicationUserModelId   (kernelbase.@)
+ */
+LONG WINAPI GetApplicationUserModelId( HANDLE process, UINT32 *length, WCHAR *id )
+{
+    WCHAR path[MAX_PATH];
+    DWORD size = ARRAY_SIZE(path);
+
+    TRACE( "(%p %p %p)\n", process, length, id );
+
+    if (!QueryFullProcessImageNameW( process, 0, path, &size )) return GetLastError();
+    return application_user_model_id( path, length, id );
+}
