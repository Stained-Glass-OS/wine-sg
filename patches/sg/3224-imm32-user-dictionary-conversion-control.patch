+        info->dwSize = size;
+        info->dwCount = count;
+        dst = copy + sizeof(*info);
+        for (i = 0; i < count; i++)
+        {
+            if (!lists[i]) continue;
+            info->dwOffset[i] = dst - copy;
+            memcpy( dst, lists[i], lists[i]->dwSize );
