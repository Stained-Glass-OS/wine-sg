+/* NI_COMPOSITIONSTR with CPS_CONVERT or CPS_REVERT: the user dictionary converts the reading,
+ * and the reading comes back with the revert */
+static BOOL ime_convert_composition( HIMC himc, INPUTCONTEXT *ctx, BOOL revert )
+{
+    struct comp_data data, new = {0};
+    CANDIDATELIST *list = NULL;
+    WCHAR *reading = NULL;
+    BYTE *attr = NULL;
+    UINT size, flags;
+    BOOL ret = FALSE;
+
+    if (!input_context_get_comp_data( ctx, &data )) return FALSE;
+    if (!data.len) goto done;
+
+    if (revert)
+    {
+        if (!data.read_len)
+        {
+            ret = TRUE; /* nothing was converted */
+            goto done;
+        }
+        new.str = data.read;
+        new.len = data.read_len;
+#ifdef SG_MUTANT_IMM_REVERTKEEP
+        new.read = data.read;
+        new.read_len = data.read_len;
+#endif
+    }
+    else
+    {
+        const WCHAR *src = data.read_len ? data.read : data.str;
+        UINT src_len = data.read_len ? data.read_len : data.len;
+
+        if (!(reading = malloc( (src_len + 1) * sizeof(WCHAR) ))) goto done;
+        memcpy( reading, src, src_len * sizeof(WCHAR) );
+        reading[src_len] = 0;
+
+        if ((list = dict_candidates( reading, FALSE, &size )))
+        {
+            new.str = candidate_string( list, 0 );
+            new.len = wcslen( new.str );
+        }
+        else
+        {
+            new.str = data.str; /* a reading without a word converts to itself */
+            new.len = data.len;
+        }
+        if (!(attr = malloc( new.len ))) goto done;
+#ifdef SG_MUTANT_IMM_CONVATTR
+        memset( attr, ATTR_INPUT, new.len );
+#else
+        memset( attr, ATTR_CONVERTED, new.len );
+#endif
+        new.attr = attr;
+        new.attr_len = new.len;
+        new.read = reading;
+        new.read_len = src_len;
+    }
+
+    if (!input_context_set_comp_data( ctx, &new )) goto done;
+    flags = GCS_COMPSTR | GCS_COMPATTR | GCS_COMPCLAUSE | GCS_CURSORPOS | GCS_DELTASTART |
+            GCS_COMPREADSTR | GCS_COMPREADATTR | GCS_COMPREADCLAUSE;
+    ime_send_message( himc, WM_IME_COMPOSITION, new.str[0], flags );
+    ret = TRUE;
+
+done:
+    free( attr );
+    free( list );
+    free( reading );
+    comp_data_free( &data );
+    return ret;
+}
+
+static BOOL ime_open_candidates( HIMC himc, INPUTCONTEXT *ctx, UINT index )
+{
+    struct comp_data data;
+    CANDIDATELIST *list;
+    WCHAR *reading;
+    UINT size;
+    BOOL ret = FALSE;
+
+    if (!input_context_get_comp_data( ctx, &data )) return FALSE;
+    if (data.len)
+    {
+        const WCHAR *src = data.read_len ? data.read : data.str;
+        UINT src_len = data.read_len ? data.read_len : data.len;
+
+        if ((reading = malloc( (src_len + 1) * sizeof(WCHAR) )))
+        {
+            memcpy( reading, src, src_len * sizeof(WCHAR) );
+            reading[src_len] = 0;
+            if ((list = dict_candidates( reading, FALSE, &size )))
+            {
+                if ((ret = input_context_set_candidates( ctx, index, list )))
+#ifdef SG_MUTANT_IMM_OPENMSG
+                    (void)0;
+#else
+                    ime_send_message( himc, WM_IME_NOTIFY, IMN_OPENCANDIDATE, 1 << index );
+#endif
+                free( list );
+            }
+            free( reading );
+        }
+    }
+    comp_data_free( &data );
+    return ret;
+}
+
+static BOOL ime_candidates_action( HIMC himc, INPUTCONTEXT *ctx, DWORD action, DWORD index, DWORD value )
+{
+    CANDIDATELIST *list;
+    BOOL ret = FALSE;
+
+    if (action == NI_OPENCANDIDATE) return ime_open_candidates( himc, ctx, index );
+    if (!(list = input_context_get_candidates( ctx, index ))) return FALSE;
+
+    switch (action)
+    {
+    case NI_CLOSECANDIDATE:
+        if ((ret = input_context_set_candidates( ctx, index, NULL )))
+            ime_send_message( himc, WM_IME_NOTIFY, IMN_CLOSECANDIDATE, 1 << index );
+        break;
+
+    case NI_SELECTCANDIDATESTR:
+    case NI_CHANGECANDIDATELIST:
+        if (action == NI_SELECTCANDIDATESTR)
+        {
+            struct comp_data data;
+            const WCHAR *text;
+
+#ifndef SG_MUTANT_IMM_SELECTRANGE
+            if (value >= list->dwCount) break;
+#endif
+            list->dwSelection = value;
+            if (!input_context_set_candidates( ctx, index, list )) break;
+
+            /* the selected candidate is the composition string, converted from the reading */
+            text = candidate_string( list, value );
+            if (input_context_get_comp_data( ctx, &data ))
+            {
+                struct comp_data new = {.str = text, .len = wcslen( text ), .read = data.read, .read_len = data.read_len};
+                BYTE *attr = malloc( new.len );
+
+                if (attr)
+                {
+                    memset( attr, ATTR_CONVERTED, new.len );
+                    new.attr = attr;
+                    new.attr_len = new.len;
+                    if (input_context_set_comp_data( ctx, &new ))
+                        ime_send_message( himc, WM_IME_COMPOSITION, text[0],
+                                          GCS_COMPSTR | GCS_COMPATTR | GCS_COMPCLAUSE | GCS_CURSORPOS | GCS_DELTASTART );
+                    free( attr );
+                }
+                comp_data_free( &data );
+            }
+        }
+        ime_send_message( himc, WM_IME_NOTIFY, IMN_CHANGECANDIDATE, 1 << index );
+        ret = TRUE;
+        break;
+
+    case NI_SETCANDIDATE_PAGESTART:
+        if (index > 3 || value >= list->dwCount) break;
+        list->dwPageStart = value;
+        if ((ret = input_context_set_candidates( ctx, index, list )))
+            ime_send_message( himc, WM_IME_NOTIFY, IMN_CHANGECANDIDATE, 1 << index );
+        break;
+
+    case NI_SETCANDIDATE_PAGESIZE:
+#ifdef SG_MUTANT_IMM_PAGESIZE
+        if (!value) break;
+#else
+        if (index > 3 || !value) break;
+#endif
+        list->dwPageSize = value;
+        if ((ret = input_context_set_candidates( ctx, index, list )))
+            ime_send_message( himc, WM_IME_NOTIFY, IMN_CHANGECANDIDATE, 1 << index );
+        break;
+    }
+
+    free( list );
+    return ret;
 }
 
