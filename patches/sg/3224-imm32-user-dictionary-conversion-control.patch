+/* WM_IME_CONTROL: the commands an application sends to the IME window */
+static LRESULT ime_ui_control( HIMC himc, WPARAM wparam, LPARAM lparam )
+{
+    POINT pt;
+
+    switch (wparam)
+    {
+    case IMC_GETCANDIDATEPOS:
+    {
+        CANDIDATEFORM *form = (CANDIDATEFORM *)lparam;
+#ifdef SG_MUTANT_IMM_CTLCAND
+        return 1;
+#endif
+        if (!himc || !form) return 1;
+        return !ImmGetCandidateWindow( himc, form->dwIndex, form );
+    }
+    case IMC_SETCANDIDATEPOS:
+        if (!himc || !lparam) return 1;
+        return !ImmSetCandidateWindow( himc, (CANDIDATEFORM *)lparam );
+    case IMC_GETCOMPOSITIONFONT:
+        if (!himc || !lparam) return 1;
+        return !ImmGetCompositionFontW( himc, (LOGFONTW *)lparam );
+    case IMC_SETCOMPOSITIONFONT:
+#ifdef SG_MUTANT_IMM_CTLFONT
+        return 0;
+#endif
+        if (!himc || !lparam) return 1;
+        return !ImmSetCompositionFontW( himc, (LOGFONTW *)lparam );
+    case IMC_GETCOMPOSITIONWINDOW:
+        if (!himc || !lparam) return 1;
+        return !ImmGetCompositionWindow( himc, (COMPOSITIONFORM *)lparam );
+    case IMC_SETCOMPOSITIONWINDOW:
+        if (!himc || !lparam) return 1;
+        return !ImmSetCompositionWindow( himc, (COMPOSITIONFORM *)lparam );
+    case IMC_GETSTATUSWINDOWPOS:
+        if (!himc || !ImmGetStatusWindowPos( himc, &pt )) return 0;
+#ifdef SG_MUTANT_IMM_CTLSTATUS
+        return MAKELONG( pt.y, pt.x );
+#endif
+        return MAKELONG( pt.x, pt.y );
+    case IMC_SETSTATUSWINDOWPOS:
+    {
+        POINTS *pos = (POINTS *)lparam;
+        if (!himc || !pos) return 1;
+        pt.x = pos->x;
+        pt.y = pos->y;
+        return !ImmSetStatusWindowPos( himc, &pt );
+    }
+    case IMC_OPENSTATUSWINDOW:
+    case IMC_CLOSESTATUSWINDOW:
+        /* the IME has no status window, there is nothing to show or to hide */
