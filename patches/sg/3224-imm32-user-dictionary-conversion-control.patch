+ * offsets it holds.  A NULL list closes the list at the index. */
+static BOOL input_context_set_candidates( INPUTCONTEXT *ctx, UINT index, const CANDIDATELIST *list )
+{
+    CANDIDATEINFO *old, *info;
+    const CANDIDATELIST *lists[ARRAY_SIZE(info->dwOffset)] = {0};
+    UINT i, count = 0, size = sizeof(*info);
+    HIMCC himcc;
+    BYTE *dst;
 
