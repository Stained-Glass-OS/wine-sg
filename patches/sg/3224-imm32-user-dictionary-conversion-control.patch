-static void input_context_set_comp_str( INPUTCONTEXT *ctx, const WCHAR *str, UINT len )
+/* The user dictionary of the IME: words registered with ImmRegisterWord, that the IME offers as
+ * the conversion of their reading.  It is kept in the registry of the user, one value per word:
+ * the name of the value is the style as 8 hex digits, a \001, the reading, a \001 and the word. */
+
+#define IME_KEY_NAME     L"Software\\Wine\\IME"
+#define IME_DICT_KEY     L"Software\\Wine\\IME\\UserDictionary"
+#define IME_EUDC_VALUE   L"EudcDictionary"
+#define IME_NAME         L"Wine IME"
+#define IME_DICT_SEP     L'\001'
+#define IME_DICT_NAME_MAX 16383
+#define IME_EUDC_PATH_MAX 80
+
+struct dict_word
+{
+    DWORD style;
+    WCHAR *reading;
+    WCHAR *string;
+};
+
+static WCHAR *dict_strdup( const WCHAR *str )
+{
+    UINT size = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = malloc( size );
+    if (ret) memcpy( ret, str, size );
+    return ret;
+}
+
+static void dict_free( struct dict_word *words, UINT count )
+{
+    UINT i;
+    for (i = 0; i < count; i++)
+    {
+        free( words[i].reading );
+        free( words[i].string );
+    }
+    free( words );
+}
+
+static BOOL dict_valid_style( DWORD style )
+{
+#ifdef SG_MUTANT_IMM_STYLE
+    return TRUE;
+#endif
+    return style == IME_REGWORD_STYLE_EUDC || style >= IME_REGWORD_STYLE_USER_FIRST;
+}
+
+static BOOL dict_valid_text( const WCHAR *text )
+{
+    return text && *text && !wcschr( text, IME_DICT_SEP );
+}
+
+static WCHAR *dict_value_name( DWORD style, const WCHAR *reading, const WCHAR *string )
+{
+    UINT len = 8 + 1 + wcslen( reading ) + 1 + wcslen( string ) + 1, i;
+    WCHAR *name, *ptr;
+
+    if (len - 1 > IME_DICT_NAME_MAX || !(name = malloc( len * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < 8; i++) name[i] = L"0123456789ABCDEF"[(style >> (28 - 4 * i)) & 0xf];
+    ptr = name + 8;
+    *ptr++ = IME_DICT_SEP;
+    wcscpy( ptr, reading );
+    ptr += wcslen( reading );
+    *ptr++ = IME_DICT_SEP;
+    wcscpy( ptr, string );
+    return name;
+}
+
+static UINT dict_load( struct dict_word **ret )
+{
+    struct dict_word *words = NULL;
+    UINT count = 0, capacity = 0, index;
+    WCHAR *name;
+    HKEY key;
+
+    *ret = NULL;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, IME_DICT_KEY, 0, KEY_READ, &key )) return 0;
+    if (!(name = malloc( (IME_DICT_NAME_MAX + 1) * sizeof(WCHAR) )))
+    {
+        RegCloseKey( key );
+        return 0;
+    }
+
+    for (index = 0;; index++)
+    {
+        DWORD len = IME_DICT_NAME_MAX + 1, style;
+        WCHAR *end, *reading, *string;
+        struct dict_word *tmp;
+
+        if (RegEnumValueW( key, index, name, &len, NULL, NULL, NULL, NULL )) break;
+        style = wcstoul( name, &end, 16 );
+        if (end != name + 8 || *end != IME_DICT_SEP) continue;
+        reading = end + 1;
+        if (!(string = wcschr( reading, IME_DICT_SEP ))) continue;
+        *string++ = 0;
+        if (!*reading || !*string) continue;
+
+        if (count == capacity)
+        {
+            capacity = capacity ? capacity * 2 : 16;
+            if (!(tmp = realloc( words, capacity * sizeof(*words) ))) break;
+            words = tmp;
+        }
+        words[count].style = style;
+        words[count].reading = dict_strdup( reading );
+        words[count].string = dict_strdup( string );
+        if (!words[count].reading || !words[count].string)
+        {
+            free( words[count].reading );
+            free( words[count].string );
+            break;
+        }
+        count++;
+    }
+
+    free( name );
+    RegCloseKey( key );
+    *ret = words;
+    return count;
+}
+
+static BOOL dict_register( DWORD style, const WCHAR *reading, const WCHAR *string )
+{
+    WCHAR *name;
+    HKEY key;
+    LSTATUS ret;
+
+    if (!dict_valid_text( reading ) || !dict_valid_text( string ) || !dict_valid_style( style ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(name = dict_value_name( style, reading, string )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(ret = RegCreateKeyExW( HKEY_CURRENT_USER, IME_DICT_KEY, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL )))
+    {
+        ret = RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)L"", sizeof(WCHAR) );
+        RegCloseKey( key );
+    }
+    free( name );
+    if (ret) SetLastError( ret );
+    return !ret;
+}
+
+static BOOL dict_unregister( DWORD style, const WCHAR *reading, const WCHAR *string )
+{
+    WCHAR *name;
+    HKEY key;
+    LSTATUS ret;
+
+    if (!dict_valid_text( reading ) || !dict_valid_text( string ) || !dict_valid_style( style ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(name = dict_value_name( style, reading, string )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(ret = RegOpenKeyExW( HKEY_CURRENT_USER, IME_DICT_KEY, 0, KEY_WRITE, &key )))
+    {
+        ret = RegDeleteValueW( key, name );
+        RegCloseKey( key );
+    }
+    free( name );
+    if (ret) SetLastError( ret );
+    return !ret;
+}
+
+/* the candidates for a reading (or for a word, for the reverse conversion) */
+static CANDIDATELIST *dict_candidates( const WCHAR *source, BOOL reverse, UINT *ret_size )
+{
+    struct dict_word *words;
+    CANDIDATELIST *list = NULL;
+    UINT i, count, found = 0, size;
+    WCHAR *dst;
+
+    if (!source || !*source || !(count = dict_load( &words ))) return NULL;
+
+    size = offsetof( CANDIDATELIST, dwOffset );
+    for (i = 0; i < count; i++)
+    {
+        const WCHAR *key = reverse ? words[i].string : words[i].reading;
+        const WCHAR *val = reverse ? words[i].reading : words[i].string;
+        if (wcscmp( key, source )) continue;
+        size += sizeof(DWORD) + (wcslen( val ) + 1) * sizeof(WCHAR);
+        found++;
+    }
+
+    if (found && (list = calloc( 1, size )))
+    {
+        DWORD *offset = list->dwOffset;
+
+        list->dwSize = size;
+        list->dwStyle = IME_CAND_UNKNOWN;
+        list->dwCount = found;
+        list->dwPageSize = 9;
+        dst = (WCHAR *)((BYTE *)list + offsetof( CANDIDATELIST, dwOffset ) + found * sizeof(DWORD));
+        for (i = 0; i < count; i++)
+        {
+            const WCHAR *key = reverse ? words[i].string : words[i].reading;
+            const WCHAR *val = reverse ? words[i].reading : words[i].string;
+            if (wcscmp( key, source )) continue;
+            *offset++ = (BYTE *)dst - (BYTE *)list;
+            wcscpy( dst, val );
+            dst += wcslen( val ) + 1;
+        }
+        *ret_size = size;
+    }
+
+    dict_free( words, count );
+    return list;
+}
+
+static const WCHAR *candidate_string( const CANDIDATELIST *list, UINT index )
+{
+    return (const WCHAR *)((const BYTE *)list + list->dwOffset[index]);
+}
