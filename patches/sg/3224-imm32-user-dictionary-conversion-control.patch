+static CANDIDATELIST *input_context_get_candidates( INPUTCONTEXT *ctx, UINT index )
+{
+    CANDIDATEINFO *info;
+    CANDIDATELIST *list = NULL;
+
+    if (index >= ARRAY_SIZE(info->dwOffset) || !(info = ImmLockIMCC( ctx->hCandInfo ))) return NULL;
+    if (index < info->dwCount && info->dwOffset[index])
+    {
+        CANDIDATELIST *src = (CANDIDATELIST *)((BYTE *)info + info->dwOffset[index]);
+        if (src->dwSize && (list = malloc( src->dwSize ))) memcpy( list, src, src->dwSize );
+    }
+    ImmUnlockIMCC( ctx->hCandInfo );
+    return list;
+}
