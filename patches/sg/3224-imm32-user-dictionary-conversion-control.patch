+static WORD *dialog_align( WORD *ptr )
+{
+    return (WORD *)(((ULONG_PTR)ptr + 3) & ~(ULONG_PTR)3);
+}
+
+static WORD *dialog_add_item( WORD *ptr, DWORD style, short x, short y, short cx, short cy, WORD id, WORD class,
+                              const WCHAR *text )
+{
+    DLGITEMTEMPLATE *item;
+
+    item = (DLGITEMTEMPLATE *)dialog_align( ptr );
+    item->style = style | WS_CHILD | WS_VISIBLE;
+    item->dwExtendedStyle = 0;
+    item->x = x;
+    item->y = y;
+    item->cx = cx;
+    item->cy = cy;
+    item->id = id;
+    ptr = (WORD *)(item + 1);
+    *ptr++ = 0xffff;
+    *ptr++ = class;
+    wcscpy( (WCHAR *)ptr, text );
+    ptr += wcslen( text ) + 1;
+    *ptr++ = 0;
