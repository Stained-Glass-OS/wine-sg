+/* The dictionary dialog.  It registers words, lists the registered ones and removes them. */
+
+#define IDC_DICT_READING  101
+#define IDC_DICT_WORD     102
+#define IDC_DICT_REGISTER 103
+#define IDC_DICT_LIST     104
+#define IDC_DICT_REMOVE   105
+#define IME_DICT_DIALOG_TITLE L"Wine IME User Dictionary"
+
+struct dict_dialog
+{
+    struct dict_word *words;
+    UINT count;
+};
+
+static void dict_dialog_fill( HWND hwnd, struct dict_dialog *dlg )
+{
+    HWND list = GetDlgItem( hwnd, IDC_DICT_LIST );
+    UINT i;
+
+    dict_free( dlg->words, dlg->count );
+    dlg->count = dict_load( &dlg->words );
+    SendMessageW( list, LB_RESETCONTENT, 0, 0 );
+    for (i = 0; i < dlg->count; i++)
+    {
+        WCHAR *text = malloc( (wcslen( dlg->words[i].reading ) + wcslen( dlg->words[i].string ) + 4) * sizeof(WCHAR) );
+        if (!text) continue;
+        wcscpy( text, dlg->words[i].reading );
+        wcscat( text, L" = " );
+        wcscat( text, dlg->words[i].string );
+        SendMessageW( list, LB_SETITEMDATA, SendMessageW( list, LB_ADDSTRING, 0, (LPARAM)text ), i );
+        free( text );
+    }
+}
+
+static INT_PTR CALLBACK dict_dialog_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct dict_dialog *dlg = (struct dict_dialog *)GetWindowLongPtrW( hwnd, DWLP_USER );
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        REGISTERWORDW *word = (REGISTERWORDW *)lparam;
+        if (!(dlg = calloc( 1, sizeof(*dlg) )))
+        {
+            EndDialog( hwnd, 0 );
+            return TRUE;
+        }
+        SetWindowLongPtrW( hwnd, DWLP_USER, (LONG_PTR)dlg );
+#ifdef SG_MUTANT_IMM_DIALOGPRESET
+        if (0)
+#else
+        if (word)
+#endif
+        {
+            if (word->lpReading) SetDlgItemTextW( hwnd, IDC_DICT_READING, word->lpReading );
+            if (word->lpWord) SetDlgItemTextW( hwnd, IDC_DICT_WORD, word->lpWord );
+        }
+        dict_dialog_fill( hwnd, dlg );
+        return TRUE;
+    }
+    case WM_DESTROY:
+        if (dlg)
+        {
+            dict_free( dlg->words, dlg->count );
+            free( dlg );
+            SetWindowLongPtrW( hwnd, DWLP_USER, 0 );
+        }
+        return TRUE;
+    case WM_COMMAND:
+        switch (LOWORD( wparam ))
+        {
+        case IDC_DICT_REGISTER:
+        {
+            WCHAR reading[128], word[128];
+            GetDlgItemTextW( hwnd, IDC_DICT_READING, reading, ARRAY_SIZE(reading) );
+            GetDlgItemTextW( hwnd, IDC_DICT_WORD, word, ARRAY_SIZE(word) );
+            if (!ImeRegisterWord( reading, IME_REGWORD_STYLE_USER_FIRST, word )) MessageBeep( MB_ICONEXCLAMATION );
+            else
+            {
+                SetDlgItemTextW( hwnd, IDC_DICT_READING, L"" );
+                SetDlgItemTextW( hwnd, IDC_DICT_WORD, L"" );
+                dict_dialog_fill( hwnd, dlg );
+            }
+            return TRUE;
+        }
+        case IDC_DICT_REMOVE:
+        {
+            HWND list = GetDlgItem( hwnd, IDC_DICT_LIST );
+            LRESULT sel = SendMessageW( list, LB_GETCURSEL, 0, 0 ), idx;
+            if (sel == LB_ERR || (idx = SendMessageW( list, LB_GETITEMDATA, sel, 0 )) == LB_ERR || idx >= dlg->count) return TRUE;
+#ifndef SG_MUTANT_IMM_DIALOGREMOVE
+            ImeUnregisterWord( dlg->words[idx].reading, dlg->words[idx].style, dlg->words[idx].string );
+#endif
+            dict_dialog_fill( hwnd, dlg );
+            return TRUE;
+        }
+        case IDOK:
+        case IDCANCEL:
+            EndDialog( hwnd, 1 );
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
