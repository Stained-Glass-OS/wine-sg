-            compstr->dwCompAttrOffset = compstr->dwSize;
-            dst = (BYTE *)compstr + compstr->dwCompAttrOffset;
-            memset( dst, ATTR_INPUT, compstr->dwCompAttrLen );
-            compstr->dwSize += compstr->dwCompAttrLen;
+    if (index >= ARRAY_SIZE(info->dwOffset)) return FALSE;
+    if (!(old = ImmLockIMCC( ctx->hCandInfo ))) return FALSE;
+    for (i = 0; i < old->dwCount && i < ARRAY_SIZE(lists); i++)
+    {
+        const CANDIDATELIST *cand = (const CANDIDATELIST *)((BYTE *)old + old->dwOffset[i]);
+        if (old->dwOffset[i] && cand->dwSize) lists[i] = cand;
+    }
+    lists[index] = list;
+    for (i = 0; i < ARRAY_SIZE(lists); i++)
+    {
