+/* a PowerShell script's digest: the signature must say it signs one */
+static DWORD SOFTPUB_VerifyPsScriptHash(CRYPT_PROVIDER_DATA *data, HANDLE file)
+{
+    SPC_INDIRECT_DATA_CONTENT *indirect = (SPC_INDIRECT_DATA_CONTENT *)data->pPDSip->psIndirectData;
+    HCRYPTPROV prov = data->hProv;
+    GUID sip;
+    DWORD err;
+
+    if (!SOFTPUB_SipInfoGuid(&indirect->Data, &sip) || !IsEqualGUID(&sip, &WINTRUST_PsScriptSipGuid))
+        return TRUST_E_BAD_DIGEST;
+    if (!prov && !CryptAcquireContextW(&prov, NULL, MS_ENH_RSA_AES_PROV_W, PROV_RSA_AES, CRYPT_VERIFYCONTEXT))
+        return GetLastError();
+    err = WINTRUST_VerifyPsScriptDigest(file, &indirect->DigestAlgorithm, &indirect->Digest, prov);
+    if (prov != data->hProv) CryptReleaseContext(prov, 0);
+    TRACE("returning %#lx\n", err);
+    return err;
+}
