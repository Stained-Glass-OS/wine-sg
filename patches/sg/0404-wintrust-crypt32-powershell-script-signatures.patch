+/*
+ * A signed script (.ps1, .psm1, .psd1) carries its PKCS #7 signature at its
+ * end, base64 in comment lines:
+ *
+ *     ...script...
+ *     # SIG # Begin signature block
+ *     # MIIxxx...
+ *     # SIG # End signature block
+ *
+ * The signed digest is over the script as UTF-16LE text -- a byte-order mark
+ * the file has counts as its first character -- up to the line break before
+ * the signature block. (Established by checking the digests of signed modules
+ * from the PowerShell Gallery.)
+ */
+
+#include <stdarg.h>
+#include <wchar.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "wincrypt.h"
+#include "wintrust.h"
+#include "mssip.h"
+#include "wintrust_priv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wintrust);
+
+#define PS_MAX_SCRIPT (64 * 1024 * 1024)
+
+static const WCHAR begin_mark[] = L"# SIG # Begin signature block";
+static const WCHAR end_mark[] = L"# SIG # End signature block";
+
+/* the whole script as UTF-16 text, a byte-order mark kept as U+FEFF */
+static WCHAR *read_script( HANDLE file, DWORD *len )
+{
+    LARGE_INTEGER size, zero = {{ 0 }};
+    BYTE *raw;
+    WCHAR *text = NULL;
+    DWORD got, i;
+    int n;
+
+    *len = 0;
+    if (!GetFileSizeEx( file, &size ) || size.QuadPart > PS_MAX_SCRIPT) return NULL;
+    if (!(raw = malloc( size.QuadPart + 2 ))) return NULL;
+    if (!SetFilePointerEx( file, zero, NULL, FILE_BEGIN ) || !ReadFile( file, raw, size.LowPart, &got, NULL ) ||
+        got != size.LowPart)
+        goto done;
+
+    if (got >= 2 && raw[0] == 0xff && raw[1] == 0xfe)
+    {
+        if (!(text = malloc( got + 2 ))) goto done;
+        memcpy( text, raw, got & ~1 );
+        *len = got / 2;
+    }
+    else if (got >= 2 && raw[0] == 0xfe && raw[1] == 0xff)
+    {
+        if (!(text = malloc( got + 2 ))) goto done;
+        for (i = 0; i < got / 2; i++) text[i] = (raw[2 * i] << 8) | raw[2 * i + 1];
+        *len = got / 2;
+    }
+    else
+    {
+        UINT cp = CP_UTF8;
+        if (!(n = MultiByteToWideChar( cp, MB_ERR_INVALID_CHARS, (char *)raw, got, NULL, 0 )) && got)
+            n = MultiByteToWideChar( (cp = CP_ACP), 0, (char *)raw, got, NULL, 0 );
+        if (!(text = malloc( (n + 1) * sizeof(WCHAR) ))) goto done;
+        *len = MultiByteToWideChar( cp, 0, (char *)raw, got, text, n );
+    }
+    if (text) text[*len] = 0;
+done:
+    free( raw );
+    return text;
+}
+
+static BOOL line_is( const WCHAR *line, const WCHAR *end, const WCHAR *mark )
+{
+    size_t n = wcslen( mark );
+    while (line < end && (*line == ' ' || *line == '\t')) line++;
+    if ((size_t)(end - line) < n || memcmp( line, mark, n * sizeof(WCHAR) )) return FALSE;
+    for (line += n; line < end; line++) if (*line != ' ' && *line != '\t' && *line != '\r') return FALSE;
+    return TRUE;
+}
+
+/* the signature block: where the signed content ends, and the base64 text */
+static BOOL find_block( const WCHAR *text, DWORD len, DWORD *content_end, WCHAR **b64 )
+{
+    const WCHAR *p = text, *end = text + len, *line_end, *start = NULL;
+    size_t used = 0;
+
+    *b64 = NULL;
+    for (; p < end; p = line_end + 1)
+    {
+        if (!(line_end = wmemchr( p, '\n', end - p ))) line_end = end;
+        if (!start)
+        {
+            if (line_is( p, line_end, begin_mark ))
+            {
+                start = p;
+                *content_end = p - text;
+                /* the line break before the block is the signature's, not the script's */
+                if (*content_end && text[*content_end - 1] == '\n') (*content_end)--;
+                if (*content_end && text[*content_end - 1] == '\r') (*content_end)--;
+                if (!(*b64 = malloc( (end - p + 1) * sizeof(WCHAR) ))) return FALSE;
+            }
+            if (line_end == end) break;
+            continue;
+        }
+        if (line_is( p, line_end, end_mark ))
+        {
+            (*b64)[used] = 0;
+            return used != 0;
+        }
+        /* "# " then base64 */
+        if (line_end - p >= 2 && p[0] == '#' && p[1] == ' ')
+        {
+            const WCHAR *q;
+            for (q = p + 2; q < line_end; q++) if (*q != '\r' && *q != ' ') (*b64)[used++] = *q;
+        }
+        else break;
+        if (line_end == end) break;
+    }
+    free( *b64 );
+    *b64 = NULL;
+    return FALSE;
+}
+
+static HANDLE open_subject( SIP_SUBJECTINFO *subject, BOOL *opened )
+{
+    HANDLE file = subject->hFile;
+
+    *opened = FALSE;
+    if (file && file != INVALID_HANDLE_VALUE) return file;
+    file = CreateFileW( subject->pwsFileName, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file != INVALID_HANDLE_VALUE) *opened = TRUE;
+    return file;
+}
+
+BOOL WINTRUST_GetSignedMsgFromPsScript( SIP_SUBJECTINFO *subject, DWORD *encoding, DWORD index,
+                                        DWORD *size, BYTE *msg )
+{
+    DWORD len, content_end, need = 0;
+    WCHAR *text, *b64 = NULL;
+    BOOL opened, ret = FALSE;
+    HANDLE file;
+
+    TRACE( "(%p %p %ld %p %p)\n", subject, encoding, index, size, msg );
+
+    if (index)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((file = open_subject( subject, &opened )) == INVALID_HANDLE_VALUE) return FALSE;
+    text = read_script( file, &len );
+    if (opened) CloseHandle( file );
+    if (!text) return FALSE;
+
+    if (!find_block( text, len, &content_end, &b64 ) ||
+        !CryptStringToBinaryW( b64, 0, CRYPT_STRING_BASE64, NULL, &need, NULL, NULL ))
+    {
+        SetLastError( TRUST_E_NOSIGNATURE );
+        goto done;
+    }
+    if (!msg)
+    {
+        *size = need;
+        ret = TRUE;
+    }
+    else if (*size < need)
+    {
+        *size = need;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+    }
+    else if ((ret = CryptStringToBinaryW( b64, 0, CRYPT_STRING_BASE64, msg, size, NULL, NULL )))
+        *encoding = X509_ASN_ENCODING | PKCS_7_ASN_ENCODING;
+done:
+    free( b64 );
+    free( text );
+    return ret;
+}
+
+/* 0, or why the script's digest is not the one signed */
+DWORD WINTRUST_VerifyPsScriptDigest( HANDLE file, const CRYPT_ALGORITHM_IDENTIFIER *digest_alg,
+                                     const CRYPT_DATA_BLOB *digest, HCRYPTPROV prov )
+{
+    DWORD len, content_end, size, err = TRUST_E_BAD_DIGEST;
+    HCRYPTHASH hash = 0;
+    WCHAR *text, *b64 = NULL;
+    BYTE out[64];
+    ALG_ID alg;
+
+    if (!(alg = CertOIDToAlgId( digest_alg->pszObjId ))) return TRUST_E_BAD_DIGEST;
+    if (!(text = read_script( file, &len ))) return GetLastError() ? GetLastError() : TRUST_E_NOSIGNATURE;
+    if (!find_block( text, len, &content_end, &b64 )) err = TRUST_E_NOSIGNATURE;
+    else if (CryptCreateHash( prov, alg, 0, 0, &hash ) &&
+             CryptHashData( hash, (BYTE *)text, content_end * sizeof(WCHAR), 0 ) &&
+             (size = sizeof(out), CryptGetHashParam( hash, HP_HASHVAL, out, &size, 0 )))
+    {
+        if (size == digest->cbData && !memcmp( out, digest->pbData, size )) err = ERROR_SUCCESS;
+        else TRACE( "digest differs\n" );
+    }
+    if (hash) CryptDestroyHash( hash );
+    free( b64 );
+    free( text );
+    return err;
+}
