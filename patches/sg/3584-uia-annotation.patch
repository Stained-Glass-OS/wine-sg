+/*
+ * Dynamic Annotation check of an IAccessible: does it support IAccIdentity?
+ * The IAccessible that comes back from AccessibleObjectFromWindow is checked
+ * further when it does not: the call looks at its parent too.
+ */
+static BOOL msaa_probe_identity(IAccessible *acc, BOOL check_parent)
+{
+    IAccIdentity *ident;
+    IAccessible *parent_acc;
+    IDispatch *parent;
+
+    if (SUCCEEDED(IAccessible_QueryInterface(acc, &IID_IAccIdentity, (void **)&ident)))
+    {
+        IAccIdentity_Release(ident);
+        return TRUE;
+    }
+
+    if (check_parent && SUCCEEDED(IAccessible_get_accParent(acc, &parent)) && parent)
+    {
+        if (SUCCEEDED(IDispatch_QueryInterface(parent, &IID_IAccessible, (void **)&parent_acc)))
+        {
+            if (SUCCEEDED(IAccessible_QueryInterface(parent_acc, &IID_IAccIdentity, (void **)&ident)))
+                IAccIdentity_Release(ident);
+            IAccessible_Release(parent_acc);
+        }
+        IDispatch_Release(parent);
+    }
+    return FALSE;
+}
+
 static BOOL msaa_check_root_acc(struct msaa_provider *msaa_prov)
