     return S_OK;
 }
 
+/*
+ * Dynamic Annotation provider.  MSAA Dynamic Annotation lets a program (or
+ * an assistive tool) override or add properties of an IAccessible element
+ * that it does not own, through IAccPropServices; the elements are named by
+ * an identity string that the element's IAccessible hands out through
+ * IAccIdentity.  When the MSAA proxy for an element is made and the element
+ * supports IAccIdentity, the node also gets one of these: it is queried
+ * before the proxy itself, so the annotated values win.  The annotation
+ * table lives in oleacc (WineAccPropGetValue, Wine-private).
+ */
+struct annotation_provider {
+    IRawElementProviderSimple IRawElementProviderSimple_iface;
+    LONG refcount;
+
+    IAccessible *acc;
+    LONG cid;
+    HWND hwnd;
+};
+
+/* The MSAA predefined property GUIDs (PROPID_ACC_*). */
+static const GUID annot_acc_name = { 0x608d3df8, 0x8128, 0x4aa7, { 0xa4, 0x28, 0xf5, 0x5e, 0x49, 0x26, 0x72, 0x91 } };
+static const GUID annot_acc_role = { 0xcb905ff2, 0x7bd1, 0x4c05, { 0xb3, 0xc8, 0xe6, 0xc2, 0x41, 0x36, 0x4d, 0x70 } };
+static const GUID annot_acc_help = { 0xc831e11f, 0x44db, 0x4a99, { 0x97, 0x68, 0xcb, 0x8f, 0x97, 0x8b, 0x72, 0x31 } };
+
+static HRESULT (WINAPI *annot_get_prop_value)(const BYTE *, DWORD, const GUID *, VARIANT *);
+
+static BOOL annot_init_reader(void)
+{
+    static LONG init;
+    HMODULE oleacc;
+
+    if (init)
+        return annot_get_prop_value != NULL;
+    if ((oleacc = LoadLibraryW(L"oleacc.dll")))
+        annot_get_prop_value = (void *)GetProcAddress(oleacc, "WineAccPropGetValue");
+    InterlockedExchange(&init, 1);
+    return annot_get_prop_value != NULL;
+}
+
+static inline struct annotation_provider *impl_from_annotation_provider(IRawElementProviderSimple *iface)
+{
+    return CONTAINING_RECORD(iface, struct annotation_provider, IRawElementProviderSimple_iface);
+}
+
+static HRESULT WINAPI annotation_provider_QueryInterface(IRawElementProviderSimple *iface, REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IRawElementProviderSimple) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+
+    IRawElementProviderSimple_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI annotation_provider_AddRef(IRawElementProviderSimple *iface)
+{
+    struct annotation_provider *prov = impl_from_annotation_provider(iface);
+    return InterlockedIncrement(&prov->refcount);
+}
+
+static ULONG WINAPI annotation_provider_Release(IRawElementProviderSimple *iface)
+{
+    struct annotation_provider *prov = impl_from_annotation_provider(iface);
+    ULONG refcount = InterlockedDecrement(&prov->refcount);
+
+    if (!refcount)
+    {
+        IAccessible_Release(prov->acc);
+        free(prov);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI annotation_provider_get_ProviderOptions(IRawElementProviderSimple *iface,
+        enum ProviderOptions *ret_val)
+{
+    *ret_val = ProviderOptions_ClientSideProvider;
+    return S_OK;
+}
+
+static HRESULT WINAPI annotation_provider_GetPatternProvider(IRawElementProviderSimple *iface,
+        PATTERNID pattern_id, IUnknown **ret_val)
+{
+    *ret_val = NULL;
+    return S_OK;
+}
+
+/* Fetch an annotation by its MSAA/UI Automation property GUID. */
+static HRESULT annotation_get_value(struct annotation_provider *prov, const GUID *guid, VARIANT *ret_val)
+{
+    IAccIdentity *ident;
+    BYTE *id = NULL;
+    DWORD id_len = 0;
+    HRESULT hr;
+
+    if (!annot_init_reader())
+        return S_FALSE;
+
+    hr = IAccessible_QueryInterface(prov->acc, &IID_IAccIdentity, (void **)&ident);
+    if (FAILED(hr))
+        return S_FALSE;
+
+    hr = IAccIdentity_GetIdentityString(ident, prov->cid, &id, &id_len);
+    IAccIdentity_Release(ident);
+    if (FAILED(hr) || !id || !id_len)
+    {
+        CoTaskMemFree(id);
+        return S_FALSE;
+    }
+
+    hr = annot_get_prop_value(id, id_len, guid, ret_val);
+    CoTaskMemFree(id);
+    return hr;
+}
+
+static const struct {
+    PROPERTYID prop_id;
+    const GUID *guid;
+    VARTYPE vt;
+} annot_msaa_props[] = {
+    { UIA_NamePropertyId,                              &annot_acc_name,       VT_BSTR },
+    { UIA_HelpTextPropertyId,                          &annot_acc_help,       VT_BSTR },
+};
+
+static HRESULT WINAPI annotation_provider_GetPropertyValue(IRawElementProviderSimple *iface,
+        PROPERTYID prop_id, VARIANT *ret_val)
+{
+    struct annotation_provider *prov = impl_from_annotation_provider(iface);
+    const struct uia_prop_info *prop_info;
+    VARIANT v;
+    HRESULT hr;
+    int i;
+
+    TRACE("%p, %d, %p\n", iface, prop_id, ret_val);
+
+    VariantInit(ret_val);
+    if (prop_id == UIA_ProviderDescriptionPropertyId)
+    {
+        V_VT(ret_val) = VT_BSTR;
+        V_BSTR(ret_val) = SysAllocString(L"Wine: Annotation Proxy");
+        return V_BSTR(ret_val) ? S_OK : E_OUTOFMEMORY;
+    }
+
+    /* The element's role annotated as an MSAA role also decides the control type. */
+    if (prop_id == UIA_ControlTypePropertyId)
+    {
+        LONG type;
+
+        VariantInit(&v);
+        hr = annotation_get_value(prov, &annot_acc_role, &v);
+        if (hr == S_OK && V_VT(&v) == VT_I4 && (type = msaa_role_to_uia_control_type(V_I4(&v))))
+            variant_init_i4(ret_val, type);
+        VariantClear(&v);
+        return S_OK;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(annot_msaa_props); i++)
+    {
+        if (annot_msaa_props[i].prop_id != prop_id)
+            continue;
+
+        VariantInit(&v);
+        hr = annotation_get_value(prov, annot_msaa_props[i].guid, &v);
+        if (hr == S_OK && V_VT(&v) == annot_msaa_props[i].vt)
+        {
+            *ret_val = v;
+            return S_OK;
+        }
+        VariantClear(&v);
+        break;
+    }
+
+    /* Annotators may also name a UI Automation property by its own GUID. */
+    if ((prop_info = uia_prop_info_from_id(prop_id)))
+    {
+        VariantInit(&v);
+        hr = annotation_get_value(prov, prop_info->guid, &v);
+        if (hr == S_OK && V_VT(&v) != VT_EMPTY)
+        {
+            *ret_val = v;
+            return S_OK;
+        }
+        VariantClear(&v);
+    }
+
+    return S_OK;
+}
+
+static HRESULT WINAPI annotation_provider_get_HostRawElementProvider(IRawElementProviderSimple *iface,
+        IRawElementProviderSimple **ret_val)
+{
+    *ret_val = NULL;
+    return S_OK;
+}
+
+static const IRawElementProviderSimpleVtbl annotation_provider_vtbl = {
+    annotation_provider_QueryInterface,
+    annotation_provider_AddRef,
+    annotation_provider_Release,
+    annotation_provider_get_ProviderOptions,
+    annotation_provider_GetPatternProvider,
+    annotation_provider_GetPropertyValue,
+    annotation_provider_get_HostRawElementProvider,
+};
+
+/*
+ * Make the annotation provider for an MSAA proxy.  Returns S_FALSE and no
+ * provider when the proxy's element does not support IAccIdentity (a
+ * parent's identity names the parent, not the element, so it does not count).
+ */
+/*
+ * The proxy for the window's own IAccessible (from AccessibleObjectFromWindow)
+ * is probed with the parent check.
+ */
+void msaa_provider_probe_root_identity(IRawElementProviderSimple *elprov)
+{
+    struct msaa_provider *msaa_prov;
+
+    if (elprov->lpVtbl != &msaa_provider_vtbl)
+        return;
+    msaa_prov = impl_from_msaa_provider(elprov);
+    msaa_prov->identity = msaa_probe_identity(msaa_prov->acc, TRUE) ? 1 : 2;
+}
+
+HRESULT create_annotation_provider(IRawElementProviderSimple *msaa_elprov, IRawElementProviderSimple **out)
+{
+    struct msaa_provider *msaa_prov;
+    struct annotation_provider *prov;
+
+    *out = NULL;
+#ifdef SG_MUTANT_NO_ANNOTATION
+    return S_FALSE;
+#endif
+    if (msaa_elprov->lpVtbl != &msaa_provider_vtbl)
+        return S_FALSE;
+    msaa_prov = impl_from_msaa_provider(msaa_elprov);
+
+    if (!msaa_prov->identity)
+        msaa_prov->identity = msaa_probe_identity(msaa_prov->acc, FALSE) ? 1 : 2;
+    if (msaa_prov->identity != 1)
+        return S_FALSE;
+
+    if (!(prov = calloc(1, sizeof(*prov))))
+        return E_OUTOFMEMORY;
+    prov->IRawElementProviderSimple_iface.lpVtbl = &annotation_provider_vtbl;
+    prov->refcount = 1;
+    prov->acc = msaa_prov->acc;
+    IAccessible_AddRef(prov->acc);
+    prov->cid = V_I4(&msaa_prov->cid);
+    prov->hwnd = msaa_prov->hwnd;
+
+    *out = &prov->IRawElementProviderSimple_iface;
+    return S_OK;
+}
