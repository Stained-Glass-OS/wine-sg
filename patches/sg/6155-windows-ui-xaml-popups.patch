From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: popups shown -- a Popup's child in a window over its island, light dismiss

Popups were kept but never shown, so NanaZip's address bar suggestions (and every flyout, which is shown through one) could not appear. An open Popup now shows its child in a window of its own (no activation, so the island keeps the keyboard; above its owner; a drop shadow) at the popup's place in its island plus HorizontalOffset/VerticalOffset, sized to the child; it opens when IsOpen becomes true (or when it is first laid out in an island, if opened before) and raises Opened; IsOpen false closes it and raises Closed; a new Child is shown anew. A click elsewhere -- in an island or in another popup -- closes the open popups that have IsLightDismissEnabled. FindName/GetTemplateChild already found a popup's child; the child is laid out and drawn as the root of its window. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/hosting.c b/dlls/windows.ui.xaml/hosting.c
index 593cc55..54468a6 100644
--- a/dlls/windows.ui.xaml/hosting.c
+++ b/dlls/windows.ui.xaml/hosting.c
@@ -23,6 +23,7 @@
  * window of a Win32 window (AttachToWindow), the island the host positions.
  */
 
+#include <math.h>
 #include <stdlib.h>
 #include "private.h"
 #include "winuser.h"
@@ -310,6 +311,7 @@ static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
     case WM_CAPTURECHANGED:
     {
         struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+        if (msg == WM_LBUTTONDOWN) xaml_popups_light_dismiss( hwnd );
         if (source && xaml_input_message( hwnd, msg, wparam, lparam, source->content )) return 0;
         break;
     }
@@ -321,7 +323,8 @@ static BOOL CALLBACK invalidate_island( HWND hwnd, LPARAM param )
 {
     WCHAR name[32];
 
-    if (GetClassNameW( hwnd, name, ARRAY_SIZE(name) ) && !wcscmp( name, L"Windows.UI.Core.CoreWindow" ))
+    if (GetClassNameW( hwnd, name, ARRAY_SIZE(name) ) &&
+        (!wcscmp( name, L"Windows.UI.Core.CoreWindow" ) || !wcscmp( name, L"SgXamlPopup" )))
         InvalidateRect( hwnd, NULL, FALSE );
     return TRUE;
 }
@@ -339,6 +342,118 @@ void xaml_invalidate_visuals(void)
     EnumThreadWindows( GetCurrentThreadId(), invalidate_thread_window, 0 );
 }
 
+/* ---- popup windows: a Popup's child over its island ---- */
+
+static LRESULT CALLBACK popup_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    IInspectable *child = (IInspectable *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+
+    switch (msg)
+    {
+    case WM_MOUSEACTIVATE:
+        return MA_NOACTIVATE;   /* the island keeps the keyboard */
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint( hwnd, &ps );
+        xaml_render_window( hwnd, hdc, child );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_MOUSEMOVE:
+    case WM_MOUSELEAVE:
+    case WM_LBUTTONDOWN:
+    case WM_LBUTTONUP:
+    case WM_CAPTURECHANGED:
+        if (msg == WM_LBUTTONDOWN) xaml_popups_light_dismiss( hwnd );
+        if (child && xaml_input_message( hwnd, msg, wparam, lparam, child )) return 0;
+        break;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static ATOM popup_window_class(void)
+{
+    static ATOM atom;
+    WNDCLASSEXW cls = { sizeof(cls) };
+
+    if (atom) return atom;
+    cls.style = CS_DROPSHADOW;
+    cls.lpfnWndProc = popup_window_proc;
+    cls.hInstance = GetModuleHandleW( L"windows.ui.xaml.dll" );
+    cls.hCursor = LoadCursorW( NULL, (const WCHAR *)IDC_ARROW );
+    cls.lpszClassName = L"SgXamlPopup";
+    atom = RegisterClassExW( &cls );
+    return atom;
+}
+
+/* a window showing a popup's child (its reference is the caller's), sized to it, at a screen point */
+HWND xaml_popup_window_open( IInspectable *child, HWND owner, POINT pt )
+{
+    struct uielem *elem = uielem_from_inspectable( child );
+    struct xsize infinite = { INFINITY, INFINITY };
+    int width = 1, height = 1;
+    HWND hwnd;
+
+    if (!popup_window_class()) return NULL;
+    if (elem)
+    {
+        uielem_measure( elem, infinite );
+        width = max( 1, (int)ceil( elem->desired.width ) );
+        height = max( 1, (int)ceil( elem->desired.height ) );
+    }
+    hwnd = CreateWindowExW( WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW | WS_EX_TOPMOST, L"SgXamlPopup", L"", WS_POPUP,
+                            pt.x, pt.y, width, height, owner ? GetAncestor( owner, GA_ROOT ) : NULL, NULL,
+                            GetModuleHandleW( L"windows.ui.xaml.dll" ), NULL );
+    if (!hwnd) return NULL;
+    SetWindowLongPtrW( hwnd, GWLP_USERDATA, (LONG_PTR)child );
+    ShowWindow( hwnd, SW_SHOWNOACTIVATE );
+    return hwnd;
+}
+
+void xaml_popup_window_close( HWND hwnd )
+{
+    if (!hwnd) return;
+    SetWindowLongPtrW( hwnd, GWLP_USERDATA, 0 );
+    DestroyWindow( hwnd );
+}
+
+/* the window an element is drawn in: its root's island or popup window */
+struct find_window { struct uielem *root; HWND found; };
+
+static BOOL CALLBACK find_window_proc( HWND hwnd, LPARAM param )
+{
+    struct find_window *find = (struct find_window *)param;
+    WCHAR name[32];
+
+    if (find->found) return FALSE;
+    if (!GetClassNameW( hwnd, name, ARRAY_SIZE(name) )) return TRUE;
+    if (!wcscmp( name, L"Windows.UI.Core.CoreWindow" ))
+    {
+        struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+        if (source && source->content && uielem_from_inspectable( source->content ) == find->root) find->found = hwnd;
+    }
+    else if (!wcscmp( name, L"SgXamlPopup" ))
+    {
+        IInspectable *child = (IInspectable *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+        if (child && uielem_from_inspectable( child ) == find->root) find->found = hwnd;
+    }
+    if (!find->found) EnumChildWindows( hwnd, find_window_proc, param );
+    return !find->found;
+}
+
+HWND xaml_element_window( struct uielem *elem )
+{
+    struct find_window find = { elem, NULL };
+
+    while (find.root && find.root->parent) find.root = find.root->parent;
+    if (!find.root) return NULL;
+    EnumThreadWindows( GetCurrentThreadId(), find_window_proc, (LPARAM)&find );
+    return find.found;
+}
+
 static ATOM island_class(void)
 {
     static ATOM atom;
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index f4d9d17..196bc2f 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -354,6 +354,11 @@ BOOL xaml_is_focus_target( struct uielem *elem );
 /* a text box (textinput.c) */
 BOOL xaml_is_text_box( struct uielem *elem );
 struct uielem *xaml_popup_child( struct uielem *elem );   /* no reference */
+HWND xaml_popup_window_open( IInspectable *child, HWND owner, POINT pt );
+void xaml_popup_window_close( HWND hwnd );
+HWND xaml_element_window( struct uielem *elem );
+void xaml_popups_light_dismiss( HWND clicked );
+void xaml_popup_check( struct uielem *popup );
 BOOL xaml_text_box_key( struct uielem *elem, UINT vk );
 BOOL xaml_text_box_char( struct uielem *elem, WCHAR ch );
 void xaml_text_box_focus( struct uielem *elem, BOOL focused );
diff --git a/dlls/windows.ui.xaml/textinput.c b/dlls/windows.ui.xaml/textinput.c
index 00b196e..586a217 100644
--- a/dlls/windows.ui.xaml/textinput.c
+++ b/dlls/windows.ui.xaml/textinput.c
@@ -828,8 +828,13 @@ struct popup
     struct uielem e;
     struct xiface IPopup_iface;
     struct handler_list opened, closed;
+    HWND window;                    /* showing its child while it is open */
+    struct list entry;              /* in open_popups while it has a window */
 };
 
+static struct list open_popups = LIST_INIT( open_popups );
+static const struct xclass popup_class;
+
 static struct popup *popup_from_iface( struct xiface *iface )
 {
     return CONTAINING_RECORD( iface->obj, struct popup, e.d.obj );
@@ -840,9 +845,103 @@ static void popup_measure( struct uielem *elem, struct xsize available, struct x
     desired->width = desired->height = 0;   /* it takes no room in its parent */
 }
 
+static void popup_raise( struct popup *popup, struct handler_list *list )
+{
+    IInspectable *sender = NULL;
+
+    if (list_empty( &list->entries )) return;
+    if (FAILED(IUnknown_QueryInterface( popup->e.d.obj.outer, &IID_IInspectable, (void **)&sender ))) return;
+    xaml_raise_routed( list, sender, NULL );   /* EventHandler<Object>( sender, null ) */
+    IInspectable_Release( sender );
+}
+
+static DOUBLE get_dbl( struct dobj *obj, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_double( box, 0 );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+/* open: a window with its child over its island, at the popup's place and offsets; closed: none */
+void xaml_popup_check( struct uielem *elem )
+{
+    struct popup *popup = CONTAINING_RECORD( elem, struct popup, e );
+    IInspectable *child = NULL;
+    BOOL open = get_bool( &elem->d, prop_popup_is_open );
+    struct uielem *e;
+    POINT pt = { 0, 0 };
+    HWND owner;
+
+    if (open && !popup->window)
+    {
+        dobj_get_value( &elem->d, prop_popup_child, &child );
+        if (!child) return;
+        IInspectable_Release( child );   /* the popup keeps it */
+#ifdef SG_MUTANT_POPUP_NOT_SHOWN
+        return;
+#endif
+        if (!(owner = xaml_element_window( elem ))) return;   /* when it is laid out in an island */
+        for (e = elem; e; e = e->parent)
+        {
+            pt.x += e->offset.x;
+            pt.y += e->offset.y;
+        }
+        pt.x += get_dbl( &elem->d, prop_popup_hoffset );
+        pt.y += get_dbl( &elem->d, prop_popup_voffset );
+        ClientToScreen( owner, &pt );
+        if (!(popup->window = xaml_popup_window_open( child, owner, pt ))) return;
+        IUnknown_AddRef( popup->e.d.obj.outer );   /* open popups are kept */
+        list_add_tail( &open_popups, &popup->entry );
+        TRACE( "%p: open in %p at %ld,%ld\n", popup, popup->window, pt.x, pt.y );
+        popup_raise( popup, &popup->opened );
+    }
+    else if (!open && popup->window)
+    {
+        HWND window = popup->window;
+        popup->window = NULL;
+        list_remove( &popup->entry );
+        xaml_popup_window_close( window );
+        TRACE( "%p: closed\n", popup );
+        popup_raise( popup, &popup->closed );
+        IUnknown_Release( popup->e.d.obj.outer );
+    }
+}
+
+/* a click elsewhere closes the open popups that close on it */
+void xaml_popups_light_dismiss( HWND clicked )
+{
+    struct popup *popup, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( popup, next, &open_popups, struct popup, entry )
+    {
+        if (popup->window == clicked || !get_bool( &popup->e.d, prop_popup_light_dismiss )) continue;
+        put_box( &popup->e.d, prop_popup_is_open, xbox_boolean( FALSE ) );
+    }
+}
+
 static void popup_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
 {
     used->width = used->height = 0;
+    xaml_popup_check( elem );   /* opened before it was laid out */
+}
+
+static void popup_state_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct uielem *elem = CONTAINING_RECORD( obj, struct uielem, d );
+    struct popup *popup = CONTAINING_RECORD( elem, struct popup, e );
+
+    if (prop == prop_popup_child && popup->window)
+    {
+        /* a new child: shown anew */
+        put_box( obj, prop_popup_is_open, xbox_boolean( FALSE ) );
+        put_box( obj, prop_popup_is_open, xbox_boolean( TRUE ) );
+        return;
+    }
+    xaml_popup_check( elem );
 }
 
 static const struct elem_ops popup_ops = { popup_measure, popup_arrange, NULL };
@@ -867,7 +966,6 @@ static HRESULT WINAPI popup_get_IsOpen( struct xiface *iface, boolean *value )
 
 static HRESULT WINAPI popup_put_IsOpen( struct xiface *iface, boolean value )
 {
-    if (value) FIXME( "%p: popups are not shown yet\n", popup_from_iface( iface ) );
     return put_box( &popup_from_iface( iface )->e.d, prop_popup_is_open, xbox_boolean( value ) );
 }
 
@@ -1251,8 +1349,8 @@ static BOOL WINAPI init_text_input( INIT_ONCE *once, void *param, void **context
     prop_selection_highlight = xaml_property_register( box, L"SelectionHighlightColor", L"Windows.UI.Xaml.Media.SolidColorBrush",
                                                        NULL, FALSE, NULL );
 
-    prop_popup_child = xaml_property_register( popup, L"Child", L"Windows.UI.Xaml.UIElement", NULL, FALSE, NULL );
-    prop_popup_is_open = xaml_property_register( popup, L"IsOpen", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
+    prop_popup_child = xaml_property_register( popup, L"Child", L"Windows.UI.Xaml.UIElement", NULL, FALSE, popup_state_changed );
+    prop_popup_is_open = xaml_property_register( popup, L"IsOpen", L"Boolean", xbox_boolean( FALSE ), FALSE, popup_state_changed );
     prop_popup_hoffset = xaml_property_register( popup, L"HorizontalOffset", L"Double", xbox_double( 0 ), FALSE, NULL );
     prop_popup_voffset = xaml_property_register( popup, L"VerticalOffset", L"Double", xbox_double( 0 ), FALSE, NULL );
     prop_popup_light_dismiss = xaml_property_register( popup, L"IsLightDismissEnabled", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
