From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 22:09:22 -0700
Subject: [PATCH] dnsapi: DnsQueryConfig registration settings come from the
 TCP/IP parameters (3284)

The host-name registration switch, the per-adapter RegistrationEnabled and the address count come from the TCP/IP parameters key (DisableDynamicUpdate, Interfaces\{adapter}\RegistrationEnabled, DefaultRegistrationMaxAddressCount, MaxNumberOfAddressesToRegister) with the Windows defaults (on, one address) instead of a constant 1 for all three.

diff --git a/dlls/dnsapi/Makefile.in b/dlls/dnsapi/Makefile.in
index 207c77c..d346be2 100644
--- a/dlls/dnsapi/Makefile.in
+++ b/dlls/dnsapi/Makefile.in
@@ -1,6 +1,7 @@
 MODULE    = dnsapi.dll
 UNIXLIB   = dnsapi.so
 IMPORTLIB = dnsapi
+IMPORTS      = advapi32
 DELAYIMPORTS = netapi32
 UNIX_LIBS    = $(RESOLV_LIBS)
 
diff --git a/dlls/dnsapi/query.c b/dlls/dnsapi/query.c
index cdae8e9..fb509cc 100644
--- a/dlls/dnsapi/query.c
+++ b/dlls/dnsapi/query.c
@@ -23,6 +23,7 @@
 #include "winbase.h"
 #include "winternl.h"
 #include "winerror.h"
+#include "winreg.h"
 #include "winnls.h"
 #include "windns.h"
 #include "nb30.h"
@@ -560,6 +561,15 @@ err:
     return ret;
 }
 
+static void make_adapter_key( WCHAR *key, unsigned int size, const WCHAR *params_key, const WCHAR *adapter )
+{
+    key[0] = 0;
+    if (wcslen( params_key ) + wcslen( adapter ) + 13 > size) return;
+    wcscpy( key, params_key );
+    wcscat( key, L"\\Interfaces\\" );
+    wcscat( key, adapter );
+}
+
 /******************************************************************************
  * DnsQueryConfig          [DNSAPI.@]
  *
@@ -602,18 +612,60 @@ DNS_STATUS WINAPI DnsQueryConfig( DNS_CONFIG_TYPE config, DWORD flag, const WCHA
     case DnsConfigPrimaryHostNameRegistrationEnabled:
     case DnsConfigAdapterHostNameRegistrationEnabled:
     case DnsConfigAddressRegistrationMaxCount:
-        /* a DWORD; GUESS: registration is on, one address per name (the values are not documented) */
-#ifdef SG_MUTANT_DNSAPI
-        break;
-#endif
+    {
+        /* a DWORD from the TCP/IP parameters: the global switch DisableDynamicUpdate, the adapter's
+         * RegistrationEnabled and the number of addresses registered (DefaultRegistrationMaxAddressCount, or
+         * the adapter's MaxNumberOfAddressesToRegister) */
+        static const WCHAR params_key[] = L"System\\CurrentControlSet\\Services\\Tcpip\\Parameters";
+        WCHAR key[256];
+        DWORD value, size = sizeof(value), disabled = 0;
+
         if (!buffer || *len < sizeof(DWORD))
         {
             *len = sizeof(DWORD);
             return ERROR_INSUFFICIENT_BUFFER;
         }
-        *(DWORD *)buffer = 1;
+        if (config == DnsConfigAddressRegistrationMaxCount)
+        {
+            value = 1;
+            if (adapter && *adapter)
+            {
+                make_adapter_key( key, ARRAY_SIZE(key), params_key, adapter );
+                if (RegGetValueW( HKEY_LOCAL_MACHINE, key, L"MaxNumberOfAddressesToRegister", RRF_RT_REG_DWORD, NULL, &value, &size ))
+                    value = 1, size = sizeof(value);
+            }
+            if (!adapter || !*adapter || size != sizeof(value))
+            {
+                size = sizeof(value);
+                if (RegGetValueW( HKEY_LOCAL_MACHINE, params_key, L"DefaultRegistrationMaxAddressCount", RRF_RT_REG_DWORD, NULL, &value, &size ))
+                    value = 1;
+            }
+        }
+        else
+        {
+            size = sizeof(disabled);
+            if (RegGetValueW( HKEY_LOCAL_MACHINE, params_key, L"DisableDynamicUpdate", RRF_RT_REG_DWORD, NULL, &disabled, &size ))
+                disabled = 0;
+            value = !disabled;
+            if (config == DnsConfigAdapterHostNameRegistrationEnabled)
+            {
+                DWORD enabled = 1;
+
+                if (!adapter || !*adapter) return ERROR_INVALID_PARAMETER;
+                make_adapter_key( key, ARRAY_SIZE(key), params_key, adapter );
+                size = sizeof(enabled);
+                if (RegGetValueW( HKEY_LOCAL_MACHINE, key, L"RegistrationEnabled", RRF_RT_REG_DWORD, NULL, &enabled, &size ))
+                    enabled = 1;
+                value = value && enabled;
+            }
+        }
+#ifdef SG_MUTANT_DNSAPI
+        value = 1;
+#endif
+        *(DWORD *)buffer = value;
         *len = sizeof(DWORD);
         return ERROR_SUCCESS;
+    }
 
     case DnsConfigAdapterDomainName_A:
     case DnsConfigAdapterDomainName_W:
