From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: device types, names and properties as dinput's conformance tests record them

dinput's tests (joystick8.c, device8.c, force_feedback.c) record what
DirectInput answers for the system mouse and keyboard and for a HID joystick
and had todo_wine marks where dinput.dll differed. Now matched:

- The system mouse is DIDEVTYPEMOUSE_UNKNOWN / DI8DEVTYPEMOUSE_UNKNOWN, the
  system mouse and keyboard are named "Mouse" and "Keyboard", and neither
  reports a firmware or hardware revision.
- DirectInput before 8: a HID joystick is DIDEVTYPEJOYSTICK_RUDDER when it has
  a simulation rudder axis and DIDEVTYPEJOYSTICK_UNKNOWN otherwise.
- GetProperty: DIPROP_AXISMODE (absolute, or relative after SetDataFormat with
  DIDF_RELAXIS or SetProperty), DIPROP_USERNAME (empty string with DI_NOEFFECT),
  DIPROP_TYPENAME of a HID device ("VID_xxxx&PID_xxxx", DirectInput 8 only,
  unsupported for the mouse and keyboard), DIPROP_JOYSTICKID (the position of
  the device in the joystick enumeration, not a constant), DIPROP_APPDATA
  (DIERR_NOTINITIALIZED until a data format or action map exists).
- SetProperty: DIPROP_PRODUCTNAME is accepted and changes nothing,
  DIPROP_CALIBRATION is DIERR_INVALIDPARAM, DIPROP_JOYSTICKID and DIPROP_APPDATA
  are DIERR_ACQUIRED while the device is acquired (JOYSTICKID is otherwise
  DIERR_UNSUPPORTED without a FIXME).
- IDirectInputEffect::Initialize checks the version against the one of the
  DirectInput object (DIERR_NOTINITIALIZED for 0, DIERR_BETADIRECTINPUTVERSION /
  DIERR_OLDDIRECTINPUTVERSION); IDirectInputEffect::Escape is
  DIERR_UNSUPPORTED (a PID device has no escape commands) without a FIXME.

The todo_wine marks of the tests that now pass are removed.

---
diff --git a/dlls/dinput/device.c b/dlls/dinput/device.c
index 66ac2fa..199fb7d 100644
--- a/dlls/dinput/device.c
+++ b/dlls/dinput/device.c
@@ -915,6 +915,8 @@ static HRESULT check_property( struct dinput_device *impl, const GUID *guid, con
         case (DWORD_PTR)DIPROP_BUFFERSIZE:
         case (DWORD_PTR)DIPROP_PHYSICALRANGE:
         case (DWORD_PTR)DIPROP_LOGICALRANGE:
+        case (DWORD_PTR)DIPROP_JOYSTICKID:
+        case (DWORD_PTR)DIPROP_APPDATA:
             if (impl->status == STATUS_ACQUIRED) return DIERR_ACQUIRED;
             break;
         case (DWORD_PTR)DIPROP_FFLOAD:
@@ -987,6 +989,7 @@ static HRESULT check_property( struct dinput_device *impl, const GUID *guid, con
         case (DWORD_PTR)DIPROP_VIDPID:
         case (DWORD_PTR)DIPROP_JOYSTICKID:
         case (DWORD_PTR)DIPROP_GUIDANDPATH:
+        case (DWORD_PTR)DIPROP_TYPENAME:
             if (!impl->vtbl->get_property) return DIERR_UNSUPPORTED;
             break;
         }
@@ -1102,8 +1105,19 @@ static HRESULT dinput_device_get_property( IDirectInputDevice8W *iface, const GU
     case (DWORD_PTR)DIPROP_JOYSTICKID:
     case (DWORD_PTR)DIPROP_GUIDANDPATH:
     case (DWORD_PTR)DIPROP_FFLOAD:
+    case (DWORD_PTR)DIPROP_TYPENAME:
         return impl->vtbl->get_property( iface, LOWORD( guid ), header, NULL );
 
+    case (DWORD_PTR)DIPROP_APPDATA:
+        /* object app data only exists once a data format or action map was set */
+#ifndef SG_MUTANT_DIT_APPDATA
+        if (!impl->user_format.rgodf) return DIERR_NOTINITIALIZED;
+#endif
+        hr = impl->vtbl->enum_objects( iface, &filter, object_mask, get_object_property, &params );
+        if (FAILED(hr)) return hr;
+        if (hr == DIENUM_CONTINUE) return DIERR_NOTFOUND;
+        return DI_OK;
+
     case (DWORD_PTR)DIPROP_RANGE:
     case (DWORD_PTR)DIPROP_PHYSICALRANGE:
     case (DWORD_PTR)DIPROP_LOGICALRANGE:
@@ -1112,7 +1126,6 @@ static HRESULT dinput_device_get_property( IDirectInputDevice8W *iface, const GU
     case (DWORD_PTR)DIPROP_GRANULARITY:
     case (DWORD_PTR)DIPROP_KEYNAME:
     case (DWORD_PTR)DIPROP_CALIBRATIONMODE:
-    case (DWORD_PTR)DIPROP_APPDATA:
     case (DWORD_PTR)DIPROP_SCANCODE:
         hr = impl->vtbl->enum_objects( iface, &filter, object_mask, get_object_property, &params );
         if (FAILED(hr)) return hr;
@@ -1145,7 +1158,10 @@ static HRESULT dinput_device_get_property( IDirectInputDevice8W *iface, const GU
                 return DI_OK;
             }
         }
-        return S_FALSE;
+#ifndef SG_MUTANT_DIT_USERNAME
+        value->wsz[0] = 0;
+#endif
+        return DI_NOEFFECT;
     }
     case (DWORD_PTR)DIPROP_FFGAIN:
     {
@@ -1153,6 +1169,16 @@ static HRESULT dinput_device_get_property( IDirectInputDevice8W *iface, const GU
         value->dwData = impl->device_gain;
         return DI_OK;
     }
+    case (DWORD_PTR)DIPROP_AXISMODE:
+    {
+        DIPROPDWORD *value = (DIPROPDWORD *)header;
+#ifdef SG_MUTANT_DIT_AXISMODE
+        value->dwData = DIPROPAXISMODE_ABS;
+#else
+        value->dwData = (impl->user_format.dwFlags & DIDF_RELAXIS) ? DIPROPAXISMODE_REL : DIPROPAXISMODE_ABS;
+#endif
+        return DI_OK;
+    }
     case (DWORD_PTR)DIPROP_CALIBRATION:
         return DIERR_INVALIDPARAM;
     default:
@@ -1349,6 +1375,17 @@ static HRESULT dinput_device_set_property( IDirectInputDevice8W *iface, const GU
         if (FAILED(hr)) return hr;
         return DI_OK;
     }
+    case (DWORD_PTR)DIPROP_PRODUCTNAME:
+        /* accepted, but the product name does not change */
+        return DI_OK;
+    case (DWORD_PTR)DIPROP_JOYSTICKID:
+    case (DWORD_PTR)DIPROP_INSTANCENAME:
+        return DIERR_UNSUPPORTED;
+    case (DWORD_PTR)DIPROP_CALIBRATION:
+#ifdef SG_MUTANT_DIT_CALIBRATION
+        return DIERR_UNSUPPORTED;
+#endif
+        return DIERR_INVALIDPARAM;
     default:
         FIXME( "Unknown property %s\n", debugstr_guid( guid ) );
         return DIERR_UNSUPPORTED;
diff --git a/dlls/dinput/joystick_hid.c b/dlls/dinput/joystick_hid.c
index 367d635..3b27f39 100644
--- a/dlls/dinput/joystick_hid.c
+++ b/dlls/dinput/joystick_hid.c
@@ -814,8 +814,34 @@ static HRESULT hid_joystick_get_property( IDirectInputDevice8W *iface, DWORD pro
     case (DWORD_PTR)DIPROP_JOYSTICKID:
     {
         DIPROPDWORD *value = (DIPROPDWORD *)header;
+        DIDEVICEINSTANCEW tmp = {.dwSize = sizeof(tmp)};
+        int i;
+
+        /* the id is the position of the device in the joystick enumeration */
+        value->dwData = 0;
+#ifdef SG_MUTANT_DIT_JOYID
         value->dwData = impl->base.instance.guidInstance.Data3;
         return DI_OK;
+#endif
+        for (i = 0; SUCCEEDED(hid_joystick_enum_device( 0, 0, &tmp, impl->base.dinput->dwVersion, i )); i++)
+        {
+            if (!IsEqualGUID( &tmp.guidInstance, &impl->base.instance.guidInstance )) continue;
+            value->dwData = i;
+            break;
+        }
+        return DI_OK;
+    }
+    case (DWORD_PTR)DIPROP_TYPENAME:
+    {
+        DIPROPSTRING *value = (DIPROPSTRING *)header;
+#ifdef SG_MUTANT_DIT_TYPENAME
+        return DIERR_UNSUPPORTED;
+#endif
+        if (impl->base.dinput->dwVersion < 0x0800 || !impl->attrs.VendorID || !impl->attrs.ProductID)
+            return DIERR_UNSUPPORTED;
+        swprintf( value->wsz, ARRAY_SIZE(value->wsz), L"VID_%04X&PID_%04X", impl->attrs.VendorID,
+                  impl->attrs.ProductID );
+        return DI_OK;
     }
     case (DWORD_PTR)DIPROP_GUIDANDPATH:
     {
@@ -1356,16 +1382,15 @@ static const struct dinput_device_vtbl hid_joystick_vtbl =
     hid_joystick_enum_created_effect_objects,
 };
 
-static DWORD device_type_for_version( DWORD type, DWORD version )
+static DWORD device_type_for_version( DWORD type, DWORD version, BOOL has_rudder )
 {
     if (version >= 0x0800) return type;
 
     switch (GET_DIDEVICE_TYPE( type ))
     {
     case DI8DEVTYPE_JOYSTICK:
-        if (GET_DIDEVICE_SUBTYPE( type ) == DI8DEVTYPEJOYSTICK_LIMITED)
-            return DIDEVTYPE_JOYSTICK | (DIDEVTYPEJOYSTICK_UNKNOWN << 8) | DIDEVTYPE_HID;
-        return DIDEVTYPE_JOYSTICK | (DIDEVTYPEJOYSTICK_TRADITIONAL << 8) | DIDEVTYPE_HID;
+        if (has_rudder) return DIDEVTYPE_JOYSTICK | (DIDEVTYPEJOYSTICK_RUDDER << 8) | DIDEVTYPE_HID;
+        return DIDEVTYPE_JOYSTICK | (DIDEVTYPEJOYSTICK_UNKNOWN << 8) | DIDEVTYPE_HID;
 
     case DI8DEVTYPE_GAMEPAD:
         return DIDEVTYPE_JOYSTICK | (DIDEVTYPEJOYSTICK_GAMEPAD << 8) | DIDEVTYPE_HID;
@@ -1395,7 +1420,7 @@ static HRESULT hid_joystick_device_try_open( const WCHAR *path, HANDLE *device,
                                              HIDD_ATTRIBUTES *attrs, HIDP_CAPS *caps, DIDEVICEINSTANCEW *instance,
                                              DWORD version )
 {
-    BOOL has_accelerator, has_brake, has_clutch, has_z, has_pov;
+    BOOL has_accelerator, has_brake, has_clutch, has_z, has_pov, has_rudder;
     PHIDP_PREPARSED_DATA preparsed_data = NULL;
     HIDP_LINK_COLLECTION_NODE nodes[256];
     DWORD type, size, button_count = 0;
@@ -1536,7 +1561,12 @@ static HRESULT hid_joystick_device_try_open( const WCHAR *path, HANDLE *device,
         break;
     }
 
-    instance->dwDevType = device_type_for_version( type, version ) | DIDEVTYPE_HID;
+    count = 1;
+    status = HidP_GetSpecificValueCaps( HidP_Input, HID_USAGE_PAGE_SIMULATION, 0, HID_USAGE_SIMULATION_RUDDER,
+                                        &value, &count, preparsed_data );
+    has_rudder = (status == HIDP_STATUS_SUCCESS && count);
+
+    instance->dwDevType = device_type_for_version( type, version, has_rudder ) | DIDEVTYPE_HID;
     TRACE("detected device type %#lx\n", instance->dwDevType);
 
     *device = device_file;
@@ -2160,6 +2190,9 @@ static HRESULT WINAPI hid_joystick_effect_Initialize( IDirectInputEffect *iface,
 
     TRACE( "iface %p, inst %p, version %#lx, guid %s\n", iface, inst, version, debugstr_guid( guid ) );
 
+    if (version == 0) return DIERR_NOTINITIALIZED;
+    if (version < joystick->base.dinput->dwVersion) return DIERR_BETADIRECTINPUTVERSION;
+    if (version > joystick->base.dinput->dwVersion) return DIERR_OLDDIRECTINPUTVERSION;
     if (!inst) return DIERR_INVALIDPARAM;
     if (!guid) return E_POINTER;
     if (!(type = effect_guid_to_usage( guid ))) return DIERR_DEVICENOTREG;
@@ -3098,7 +3131,8 @@ static HRESULT WINAPI hid_joystick_effect_Unload( IDirectInputEffect *iface )
 
 static HRESULT WINAPI hid_joystick_effect_Escape( IDirectInputEffect *iface, DIEFFESCAPE *escape )
 {
-    FIXME( "iface %p, escape %p stub!\n", iface, escape );
+    TRACE( "iface %p, escape %p\n", iface, escape );
+    /* a PID device has no driver specific escape commands */
     return DIERR_UNSUPPORTED;
 }
 
