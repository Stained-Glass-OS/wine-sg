From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: RtlInsert/Delete/Lookup/Enumerate/Get...GenericTable (non-AVL generic tables)

- The RTL_GENERIC_TABLE family (non-AVL) was half stubs: RtlInsert-
  ElementGenericTable, RtlDeleteElementGenericTable, RtlEnumerateGenericTable
  and RtlIsGenericTableEmpty were "@ stub" (a table never held anything) and
  RtlLookupElementGenericTable, RtlEnumerateGenericTableWithoutSplaying and
  RtlGetElementGenericTable returned NULL unconditionally.
- A splay tree of the caller's elements ordered by the caller's compare
  routine (inserts and lookups splay the node to the root, exactly as the
  table's documented "with splaying" behaviour), plus the table's
  InsertOrderList so RtlEnumerateGenericTableWithoutSplaying and
  RtlGetElementGenericTable(i) walk in insertion order. The caller's
  allocate/free routines hold each element (RTL_SPLAY_LINKS and list links
  in front of the user data); a duplicate key is not inserted and reports
  NewElement = FALSE; an allocation failure returns NULL.
- ntddk.h: the prototypes; the spec stubs become stdcall exports.

---
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -251,6 +251,137 @@
 }
 
 
+/* Stained Glass OS: the (non-AVL) generic tables (Rtl*GenericTable) were
+ * stubs or returned NULL/FALSE -- callers that keep anything in one (observed:
+ * App-V subsystem component maps) found it always empty. RTL_SPLAY_LINKS
+ * names a real splay tree: a lookup, insertion or "with splaying" enumeration
+ * step moves the node it lands on to the root (the amortised-cost rebalancing
+ * a splay tree is for); RtlEnumerateGenericTableWithoutSplaying and
+ * RtlGetElementGenericTable do not disturb the tree and instead walk
+ * InsertOrderList, the doubly-linked list every element also sits on in the
+ * order it was inserted -- the one piece of RTL_GENERIC_TABLE a plain splay
+ * tree would not need. Each element is allocated by the caller's routine as
+ * a struct generic_node header (the splay links plus the list entry) in
+ * front of its data, exactly as the AVL table below puts RTL_BALANCED_LINKS
+ * in front of its data. */
+struct generic_node
+{
+    RTL_SPLAY_LINKS splay;
+    LIST_ENTRY order;
+};
+
+static inline void *generic_data( RTL_SPLAY_LINKS *splay )
+{
+    return splay ? (char *)CONTAINING_RECORD( splay, struct generic_node, splay ) + sizeof(struct generic_node) : NULL;
+}
+
+static inline struct generic_node *generic_node_from_data( void *data )
+{
+    return data ? (struct generic_node *)((char *)data - sizeof(struct generic_node)) : NULL;
+}
+
+/* promotes child over its parent with one rotation, relinking the
+ * grandparent (if any); the direction follows which side child is on */
+static void generic_rotate_up( RTL_SPLAY_LINKS *parent, RTL_SPLAY_LINKS *child )
+{
+    RTL_SPLAY_LINKS *grandparent = parent->Parent;
+
+    if (parent->LeftChild == child)
+    {
+        parent->LeftChild = child->RightChild;
+        if (child->RightChild) child->RightChild->Parent = parent;
+        child->RightChild = parent;
+    }
+    else
+    {
+        parent->RightChild = child->LeftChild;
+        if (child->LeftChild) child->LeftChild->Parent = parent;
+        child->LeftChild = parent;
+    }
+    parent->Parent = child;
+    child->Parent = grandparent;
+    if (grandparent)
+    {
+        if (grandparent->LeftChild == parent) grandparent->LeftChild = child;
+        else grandparent->RightChild = child;
+    }
+}
+
+/* moves node to the root of whatever tree it is in (*root is that tree's
+ * current root on entry) via zig / zig-zig / zig-zag rotations */
+static void generic_splay( RTL_SPLAY_LINKS **root, RTL_SPLAY_LINKS *node )
+{
+    while (node->Parent)
+    {
+        RTL_SPLAY_LINKS *parent = node->Parent, *grandparent = parent->Parent;
+
+        if (!grandparent) generic_rotate_up( parent, node );
+        else if ((grandparent->LeftChild == parent) == (parent->LeftChild == node))
+        {
+            generic_rotate_up( grandparent, parent );
+            generic_rotate_up( parent, node );
+        }
+        else
+        {
+            generic_rotate_up( parent, node );
+            generic_rotate_up( grandparent, node );
+        }
+    }
+    *root = node;
+}
+
+static RTL_SPLAY_LINKS *generic_min( RTL_SPLAY_LINKS *node )
+{
+    if (node) while (node->LeftChild) node = node->LeftChild;
+    return node;
+}
+
+/* the node's successor in sorted (CompareRoutine) order, independent of the
+ * tree's current shape */
+static RTL_SPLAY_LINKS *generic_successor( RTL_SPLAY_LINKS *node )
+{
+    if (node->RightChild) return generic_min( node->RightChild );
+    while (node->Parent && node->Parent->RightChild == node) node = node->Parent;
+    return node->Parent;
+}
+
+static RTL_SPLAY_LINKS *generic_find( RTL_GENERIC_TABLE *table, void *buffer )
+{
+    RTL_SPLAY_LINKS *node = table->TableRoot;
+
+    while (node)
+    {
+        switch (table->CompareRoutine( table, buffer, generic_data( node ) ))
+        {
+        case GenericLessThan: node = node->LeftChild; break;
+        case GenericGreaterThan: node = node->RightChild; break;
+        default: return node;
+        }
+    }
+    return NULL;
+}
+
+/* finds buffer's place in the tree; if not present, returns the leaf it
+ * would hang from (*parent) and which side (*is_left), for the caller to
+ * link a freshly allocated node into */
+static RTL_SPLAY_LINKS *generic_find_insert_point( RTL_GENERIC_TABLE *table, void *buffer,
+                                                    RTL_SPLAY_LINKS **parent, BOOLEAN *is_left )
+{
+    RTL_SPLAY_LINKS *node = table->TableRoot;
+
+    *parent = NULL;
+    while (node)
+    {
+        switch (table->CompareRoutine( table, buffer, generic_data( node ) ))
+        {
+        case GenericLessThan: *parent = node; *is_left = TRUE; node = node->LeftChild; break;
+        case GenericGreaterThan: *parent = node; *is_left = FALSE; node = node->RightChild; break;
+        default: return node;
+        }
+    }
+    return NULL;
+}
+
 /******************************************************************************
  *  RtlInitializeGenericTable           [NTDLL.@]
  */
@@ -273,15 +404,134 @@
 }
 
 /******************************************************************************
+ *  RtlInsertElementGenericTable           [NTDLL.@]
+ */
+void * WINAPI RtlInsertElementGenericTable( RTL_GENERIC_TABLE *table, void *buffer, ULONG size, BOOLEAN *new_element )
+{
+    RTL_SPLAY_LINKS *parent, *found;
+    struct generic_node *node;
+    BOOLEAN is_left = FALSE;
+
+    TRACE( "(%p, %p, %lu, %p)\n", table, buffer, size, new_element );
+
+    if ((found = generic_find_insert_point( table, buffer, &parent, &is_left )))
+    {
+        generic_splay( &table->TableRoot, found );
+        if (new_element) *new_element = FALSE;
+        return generic_data( found );
+    }
+    if (!(node = table->AllocateRoutine( table, sizeof(*node) + size )))
+    {
+        if (new_element) *new_element = FALSE;
+        return NULL;
+    }
+    node->splay.Parent = parent;
+    node->splay.LeftChild = node->splay.RightChild = NULL;
+    memcpy( generic_data( &node->splay ), buffer, size );
+    if (!parent) table->TableRoot = &node->splay;
+    else if (is_left) parent->LeftChild = &node->splay;
+    else parent->RightChild = &node->splay;
+    generic_splay( &table->TableRoot, &node->splay );
+#ifndef SG_MUTANT_NO_INSERT_ORDER
+    InsertTailList( &table->InsertOrderList, &node->order );
+#endif
+    table->NumberGenericTableElements++;
+    table->OrderedPointer = &table->InsertOrderList;
+    table->WhichOrderedElement = 0;
+    if (new_element) *new_element = TRUE;
+    return generic_data( &node->splay );
+}
+
+/******************************************************************************
+ *  RtlDeleteElementGenericTable           [NTDLL.@]
+ */
+BOOLEAN WINAPI RtlDeleteElementGenericTable( RTL_GENERIC_TABLE *table, void *buffer )
+{
+    RTL_SPLAY_LINKS *node, *new_root;
+    struct generic_node *entry;
+
+    TRACE( "(%p, %p)\n", table, buffer );
+
+    if (!(node = generic_find( table, buffer ))) return FALSE;
+#ifndef SG_MUTANT_BAD_DELETE
+    generic_splay( &table->TableRoot, node );  /* node is now the root */
+#endif
+
+    if (!node->LeftChild)
+    {
+        new_root = node->RightChild;
+        if (new_root) new_root->Parent = NULL;
+    }
+    else
+    {
+        RTL_SPLAY_LINKS *left = node->LeftChild, *max;
+
+        left->Parent = NULL;
+        for (max = left; max->RightChild; max = max->RightChild) {}
+        generic_splay( &left, max );  /* max.RightChild is now NULL */
+        new_root = max;
+        new_root->RightChild = node->RightChild;
+        if (node->RightChild) node->RightChild->Parent = new_root;
+    }
+    table->TableRoot = new_root;
+
+    entry = CONTAINING_RECORD( node, struct generic_node, splay );
+    RemoveEntryList( &entry->order );
+    table->NumberGenericTableElements--;
+    table->OrderedPointer = &table->InsertOrderList;
+    table->WhichOrderedElement = 0;
+    table->FreeRoutine( table, entry );
+    return TRUE;
+}
+
+/******************************************************************************
+ *  RtlLookupElementGenericTable           [NTDLL.@]
+ */
+void * WINAPI RtlLookupElementGenericTable(RTL_GENERIC_TABLE *table, void *buffer)
+{
+    RTL_SPLAY_LINKS *node;
+
+    TRACE( "(%p, %p)\n", table, buffer );
+
+    if (!(node = generic_find( table, buffer ))) return NULL;
+    generic_splay( &table->TableRoot, node );
+    return generic_data( node );
+}
+
+/******************************************************************************
+ *  RtlEnumerateGenericTable           [NTDLL.@]
+ */
+void * WINAPI RtlEnumerateGenericTable( RTL_GENERIC_TABLE *table, BOOLEAN restart )
+{
+    RTL_SPLAY_LINKS *node;
+
+    TRACE( "(%p, %d)\n", table, restart );
+
+    if (restart) node = generic_min( table->TableRoot );
+    else node = table->TableRoot ? generic_successor( table->TableRoot ) : NULL;
+    if (!node) return NULL;
+    generic_splay( &table->TableRoot, node );
+    return generic_data( node );
+}
+
+/******************************************************************************
  *  RtlEnumerateGenericTableWithoutSplaying           [NTDLL.@]
  */
 void * WINAPI RtlEnumerateGenericTableWithoutSplaying(RTL_GENERIC_TABLE *table, PVOID *previous)
 {
-    static int warn_once;
-
-    if (!warn_once++)
-        FIXME("(%p, %p) stub!\n", table, previous);
-    return NULL;
+    LIST_ENTRY *entry;
+
+    TRACE( "(%p, %p)\n", table, previous );
+
+    entry = *previous ? ((struct generic_node *)generic_node_from_data( *previous ))->order.Flink
+                       : table->InsertOrderList.Flink;
+    if (entry == &table->InsertOrderList)
+    {
+        *previous = NULL;
+        return NULL;
+    }
+    *previous = generic_data( &CONTAINING_RECORD( entry, struct generic_node, order )->splay );
+    return *previous;
 }
 
 /******************************************************************************
@@ -298,17 +548,23 @@
  */
 void * WINAPI RtlGetElementGenericTable(RTL_GENERIC_TABLE *table, ULONG index)
 {
-    FIXME("(%p, %lu) stub!\n", table, index);
-    return NULL;
-}
-
-/******************************************************************************
- *  RtlLookupElementGenericTable           [NTDLL.@]
- */
-void * WINAPI RtlLookupElementGenericTable(RTL_GENERIC_TABLE *table, void *buffer)
-{
-    FIXME("(%p, %p) stub!\n", table, buffer);
-    return NULL;
+    LIST_ENTRY *entry;
+    ULONG i;
+
+    TRACE( "(%p, %lu)\n", table, index );
+
+    if (index >= table->NumberGenericTableElements) return NULL;
+    for (entry = table->InsertOrderList.Flink, i = 0; i < index; i++) entry = entry->Flink;
+    return generic_data( &CONTAINING_RECORD( entry, struct generic_node, order )->splay );
+}
+
+/******************************************************************************
+ *  RtlIsGenericTableEmpty           [NTDLL.@]
+ */
+BOOLEAN WINAPI RtlIsGenericTableEmpty( RTL_GENERIC_TABLE *table )
+{
+    TRACE( "(%p)\n", table );
+    return !table->TableRoot;
 }
 
