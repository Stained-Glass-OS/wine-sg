From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptui: CryptUIDlgViewSignerInfo, chooser Location column (3722)

cryptui: CryptUIDlgViewSignerInfo, Location column of the certificate chooser

The signer's certificate is found by issuer and serial number and shown;
the chooser's Location column names the system store holding the
certificate. Details in notes/3722.txt.
---
diff --git a/dlls/cryptui/cryptui.spec b/dlls/cryptui/cryptui.spec
index 173451a..7712477 100644
--- a/dlls/cryptui/cryptui.spec
+++ b/dlls/cryptui/cryptui.spec
@@ -17,7 +17,7 @@
 17 stdcall CryptUIDlgViewCertificateW(ptr ptr)
 18 stdcall CryptUIDlgViewContext(long ptr ptr wstr long ptr)
 19 stdcall CryptUIDlgViewSignerInfoA(ptr)
-20 stub CryptUIDlgViewSignerInfoW
+20 stdcall CryptUIDlgViewSignerInfoW(ptr)
 21 stub CryptUIFreeCertificatePropertiesPagesA
 22 stub CryptUIFreeCertificatePropertiesPagesW
 23 stub CryptUIFreeViewSignaturesPagesA
diff --git a/dlls/cryptui/main.c b/dlls/cryptui/main.c
index 2bd6b0b..320e230 100644
--- a/dlls/cryptui/main.c
+++ b/dlls/cryptui/main.c
@@ -6939,10 +6939,97 @@ BOOL WINAPI CryptUIWizExport(DWORD dwFlags, HWND hwndParent,
     return ret;
 }
 
+/* The signer is named by issuer and serial number; its certificate is looked
+ * for in the message and in the stores the caller lists. */
+BOOL WINAPI CryptUIDlgViewSignerInfoW(CRYPTUI_VIEWSIGNERINFO_STRUCTW *pcvsi)
+{
+    CRYPTUI_VIEWCERTIFICATE_STRUCTW view;
+    HCERTSTORE collection, msg_store = NULL;
+    PCCERT_CONTEXT cert;
+    CERT_INFO info;
+    DWORD i;
+    BOOL ret;
+
+    TRACE("(%p)\n", pcvsi);
+
+#ifdef SG_MUTANT_CU_NOARGS
+    if (!pcvsi)
+#else
+    if (!pcvsi || pcvsi->dwSize < sizeof(*pcvsi) || !pcvsi->pSignerInfo)
+#endif
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!(collection = CertOpenStore(CERT_STORE_PROV_COLLECTION, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL)))
+        return FALSE;
+    if (pcvsi->hMsg && (msg_store = CertOpenStore(CERT_STORE_PROV_MSG, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING,
+                                                  0, 0, pcvsi->hMsg)))
+        CertAddStoreToCollection(collection, msg_store, 0, 0);
+#ifndef SG_MUTANT_CU_NOSTORES
+    for (i = 0; i < pcvsi->cStores; i++)
+        CertAddStoreToCollection(collection, pcvsi->rghStores[i], 0, 0);
+#endif
+
+    memset(&info, 0, sizeof(info));
+    info.Issuer = pcvsi->pSignerInfo->Issuer;
+#ifndef SG_MUTANT_CU_NOSERIAL
+    info.SerialNumber = pcvsi->pSignerInfo->SerialNumber;
+#endif
+    cert = CertGetSubjectCertificateFromStore(collection, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, &info);
+    if (!cert)
+    {
+        SetLastError(CRYPT_E_NOT_FOUND);
+        ret = FALSE;
+    }
+    else
+    {
+        memset(&view, 0, sizeof(view));
+        view.dwSize = sizeof(view);
+        view.hwndParent = pcvsi->hwndParent;
+        view.szTitle = pcvsi->szTitle;
+        view.pCertContext = cert;
+        view.cStores = pcvsi->cStores;
+        view.rghStores = pcvsi->rghStores;
+        view.cPropSheetPages = pcvsi->cPropSheetPages;
+        view.rgPropSheetPages = pcvsi->rgPropSheetPages;
+        ret = CryptUIDlgViewCertificateW(&view, NULL);
+        CertFreeCertificateContext(cert);
+    }
+    CertCloseStore(collection, 0);
+    if (msg_store) CertCloseStore(msg_store, 0);
+    return ret;
+}
+
 BOOL WINAPI CryptUIDlgViewSignerInfoA(CRYPTUI_VIEWSIGNERINFO_STRUCTA *pcvsi)
 {
-    FIXME("%p: stub\n", pcvsi);
-    return FALSE;
+    CRYPTUI_VIEWSIGNERINFO_STRUCTW view;
+    WCHAR *title = NULL;
+    BOOL ret;
+
+    TRACE("(%p)\n", pcvsi);
+
+    if (!pcvsi || pcvsi->dwSize < sizeof(*pcvsi))
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    memcpy(&view, pcvsi, sizeof(view));
+    view.rgPropSheetPages = NULL;
+    view.cPropSheetPages = 0;
+    if (pcvsi->szTitle)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, pcvsi->szTitle, -1, NULL, 0);
+
+        if (!(title = malloc(len * sizeof(WCHAR)))) return FALSE;
+        MultiByteToWideChar(CP_ACP, 0, pcvsi->szTitle, -1, title, len);
+        view.szTitle = title;
+    }
+    if (pcvsi->cPropSheetPages)
+        FIXME("ignoring additional prop sheet pages\n");
+    ret = CryptUIDlgViewSignerInfoW(&view);
+    free(title);
+    return ret;
 }
 
