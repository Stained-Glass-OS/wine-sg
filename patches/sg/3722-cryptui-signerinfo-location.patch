+/* The Location column names the system store (of the current user) that holds
+ * the certificate: Windows keeps no such name on an opened store, so the
+ * certificate is looked for in the user's system stores. */
+struct location_stores
+{
+    HCERTSTORE *stores;
+    WCHAR **names;
+    DWORD count, cap;
+};
+
+static BOOL WINAPI collect_system_store(const void *name, DWORD flags, PCERT_SYSTEM_STORE_INFO info,
+ void *reserved, void *ctx)
+{
+    struct location_stores *l = ctx;
+    HCERTSTORE store;
+
+    if (l->count == l->cap)
+    {
+        DWORD cap = l->cap ? l->cap * 2 : 8;
+        HCERTSTORE *stores = realloc(l->stores, cap * sizeof(*stores));
+        WCHAR **names = realloc(l->names, cap * sizeof(*names));
+
+        if (stores) l->stores = stores;
+        if (names) l->names = names;
+        if (!stores || !names) return TRUE;
+        l->cap = cap;
+    }
+    store = CertOpenStore(CERT_STORE_PROV_SYSTEM_W, 0, 0,
+     CERT_SYSTEM_STORE_CURRENT_USER | CERT_STORE_READONLY_FLAG | CERT_STORE_OPEN_EXISTING_FLAG, name);
+    if (store)
+    {
+        LPCWSTR localized = CryptFindLocalizedName(name);
+
+        l->stores[l->count] = store;
+        l->names[l->count] = wcsdup(localized ? localized : name);
+        l->count++;
+    }
+    return TRUE;
+}
+
+static void free_location_stores(struct location_stores *l)
+{
+    DWORD i;
+
+    for (i = 0; i < l->count; i++)
+    {
+        CertCloseStore(l->stores[i], 0);
+        free(l->names[i]);
+    }
+    free(l->stores);
+    free(l->names);
+}
+
+static const WCHAR *find_cert_location(struct location_stores *l, PCCERT_CONTEXT cert)
+{
+    DWORD i;
+
+#ifdef SG_MUTANT_CU_NOLOC
+    return NULL;
+#endif
+    for (i = 0; i < l->count; i++)
+    {
+        PCCERT_CONTEXT found = CertFindCertificateInStore(l->stores[i], X509_ASN_ENCODING, 0,
+         CERT_FIND_EXISTING, cert, NULL);
+        if (found)
+        {
+            CertFreeCertificateContext(found);
+            return l->names[i];
+        }
+    }
+    return NULL;
+}
+
+static void add_cert_to_list(HWND lv, PCCERT_CONTEXT cert, struct location_stores *stores, DWORD flags,
+ DWORD *allocatedLen, LPWSTR *str)
 {
     DWORD len;
     LVITEMW item;
@@ -7106,10 +7266,9 @@ static void add_cert_to_list(HWND lv, PCCERT_CONTEXT cert, DWORD flags, DWORD *a
     }
     if (!(flags & CRYPTUI_SELECT_LOCATION_COLUMN))
     {
-        static int show_fixme;
-        if (!show_fixme++)
-            FIXME("showing location is not implemented\n");
-        LoadStringW(hInstance, IDS_NO_IMPL, buf, ARRAY_SIZE(buf));
+        const WCHAR *location = find_cert_location(stores, cert);
+
+        item.pszText = (WCHAR *)(location ? location : L"");
         if (!item.iSubItem)
             SendMessageW(lv, LVM_INSERTITEMW, 0, (LPARAM)&item);
         else
@@ -7124,12 +7283,16 @@ static void add_store_certs(HWND lv, HCERTSTORE store, DWORD flags, PFNCFILTERPR
     BOOL select = FALSE;
     DWORD allocatedLen = 0;
     LPWSTR str = NULL;
+    struct location_stores stores = {0};
 
+    if (!(flags & CRYPTUI_SELECT_LOCATION_COLUMN))
+        CertEnumSystemStore(CERT_SYSTEM_STORE_CURRENT_USER, NULL, &stores, collect_system_store);
     do {
         cert = CertEnumCertificatesInStore(store, cert);
         if (cert && (!filter || filter(cert, &select, callback_data)))
-            add_cert_to_list(lv, cert, flags, &allocatedLen, &str);
+            add_cert_to_list(lv, cert, &stores, flags, &allocatedLen, &str);
     } while (cert);
+    free_location_stores(&stores);
     free(str);
 }
 
