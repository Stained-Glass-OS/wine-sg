From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: MsiGetFileSignatureInformation errors

Ground truth from Wine's msi test (2 todo_wine marks removed): a file that is not there is CRYPT_E_FILE_ERROR, and a file with no signature HRESULT_FROM_WIN32(ERROR_FUNCTION_FAILED) (not the trust errors); the certificate comes back NULL in both.
---
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -2608,6 +2608,12 @@ HRESULT WINAPI MsiGetFileSignatureInformationW( const WCHAR *path, DWORD flags,
 
     if (!path || !cert) return E_INVALIDARG;
 
+#ifndef SG_MUTANT_MSI_SIGNATURE_ERRORS
+    /* a file that cannot be read is a file error, and one with no signature a failure */
+    *cert = NULL;
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return CRYPT_E_FILE_ERROR;
+#endif
+
     info.cbStruct       = sizeof(info);
     info.pcwszFilePath  = path;
     info.hFile          = NULL;
@@ -2624,6 +2630,9 @@ HRESULT WINAPI MsiGetFileSignatureInformationW( const WCHAR *path, DWORD flags,
 
     hr = WinVerifyTrustEx( INVALID_HANDLE_VALUE, &generic_verify_v2, &data );
     *cert = NULL;
+#ifndef SG_MUTANT_MSI_SIGNATURE_ERRORS
+    if (hr == TRUST_E_NOSIGNATURE || hr == TRUST_E_SUBJECT_FORM_UNKNOWN) hr = HRESULT_FROM_WIN32( ERROR_FUNCTION_FAILED );
+#endif
     if (FAILED(hr)) goto done;
 
     if (!(signer = WTHelperGetProvSignerFromChain( data.hWVTStateData, 0, FALSE, 0 )))
--- a/dlls/msi/tests/msi.c
+++ b/dlls/msi/tests/msi.c
@@ -12054,7 +12054,7 @@ static void test_MsiGetFileSignatureInformation(void)
     ok(hr == E_INVALIDARG, "expected E_INVALIDARG got %#lx\n", hr);
 
     hr = MsiGetFileSignatureInformationA( "signature.bin", 0, &cert, NULL, &len );
-    todo_wine ok(hr == CRYPT_E_FILE_ERROR, "expected CRYPT_E_FILE_ERROR got %#lx\n", hr);
+    ok(hr == CRYPT_E_FILE_ERROR, "expected CRYPT_E_FILE_ERROR got %#lx\n", hr);
 
     create_file_data( "signature.bin", "signature", sizeof("signature") );
 
@@ -12066,7 +12066,7 @@ static void test_MsiGetFileSignatureInformation(void)
 
     cert = (const CERT_CONTEXT *)0xdeadbeef;
     hr = MsiGetFileSignatureInformationA( "signature.bin", 0, &cert, NULL, &len );
-    todo_wine ok(hr == HRESULT_FROM_WIN32(ERROR_FUNCTION_FAILED), "got %#lx\n", hr);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_FUNCTION_FAILED), "got %#lx\n", hr);
     ok(cert == NULL, "got %p\n", cert);
 
     DeleteFileA( "signature.bin" );
