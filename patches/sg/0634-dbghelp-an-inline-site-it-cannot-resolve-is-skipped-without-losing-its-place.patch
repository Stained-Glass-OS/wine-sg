From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: an inline site it cannot resolve is skipped without losing its place

An S_INLINESITE whose inlinee is not in the PDB's IPI stream (LTCG builds
reference other modules' ids: OBS Studio) is skipped to its paired
S_INLINESITE_END. The jump read the END offset again through the END
record's bytes and left out the record's length field, so the walk went on
in the middle of records: obs.dll's PDB gave 10.7 million bogus symbols,
gigabytes and two minutes, then an assertion on a "function" whose type was
an enum -- which aborted the program loading the symbols (OBS's crash
handler, winedbg). The skip now lands after the END record (and gives up on
the site if its pEnd is not one), and a signature that is not a function
type is left out with a warning instead of asserted on. OBS's 40 PDBs load
in 3 seconds.
---
--- a/dlls/dbghelp/msc.c
+++ b/dlls/dbghelp/msc.c
@@ -2693,10 +2693,24 @@
                 }
                 else
                 {
-                    /* skip all records until paired S_INLINESITE_END */
-                    sym = (const union codeview_symbol*)(root + sym->inline_site_v3.pEnd);
-                    if (sym->generic.id != S_INLINESITE_END) FIXME("complete wreckage\n");
-                    length = sym->inline_site_v3.pEnd - i + sym->generic.len;
+                    /* skip all records until paired S_INLINESITE_END, and it:
+                     * its offset is the site's pEnd (not a field of the END
+                     * record), and a record's size counts its length field.
+                     * Off by a few bytes, the walk read garbage from there on
+                     * (OBS Studio's LTCG PDBs: millions of bogus symbols,
+                     * gigabytes, then an assertion). */
+                    unsigned end = sym->inline_site_v3.pEnd;
+                    const union codeview_symbol* end_sym = (const union codeview_symbol*)(root + end);
+                    if (end <= i || end + 4 > size || end_sym->generic.id != S_INLINESITE_END)
+                    {
+                        FIXME("complete wreckage\n");
+                        break;
+                    }
+#ifndef SG_MUTANT_INLINESKIP
+                    length = end - i + end_sym->generic.len + 2;
+#else
+                    length = end_sym->inline_site_v3.pEnd - i + end_sym->generic.len;
+#endif
                 }
             }
             break;
@@ -2714,10 +2728,24 @@
                 }
                 else
                 {
-                    /* skip all records until paired S_INLINESITE_END */
-                    sym = (const union codeview_symbol*)(root + sym->inline_site2_v3.pEnd);
-                    if (sym->generic.id != S_INLINESITE_END) FIXME("complete wreckage\n");
-                    length = sym->inline_site2_v3.pEnd - i + sym->generic.len;
+                    /* skip all records until paired S_INLINESITE_END, and it:
+                     * its offset is the site's pEnd (not a field of the END
+                     * record), and a record's size counts its length field.
+                     * Off by a few bytes, the walk read garbage from there on
+                     * (OBS Studio's LTCG PDBs: millions of bogus symbols,
+                     * gigabytes, then an assertion). */
+                    unsigned end = sym->inline_site2_v3.pEnd;
+                    const union codeview_symbol* end_sym = (const union codeview_symbol*)(root + end);
+                    if (end <= i || end + 4 > size || end_sym->generic.id != S_INLINESITE_END)
+                    {
+                        FIXME("complete wreckage\n");
+                        break;
+                    }
+#ifndef SG_MUTANT_INLINESKIP
+                    length = end - i + end_sym->generic.len + 2;
+#else
+                    length = end_sym->inline_site2_v3.pEnd - i + end_sym->generic.len;
+#endif
                 }
             }
             break;
--- a/dlls/dbghelp/symbol.c
+++ b/dlls/dbghelp/symbol.c
@@ -326,7 +326,15 @@
 {
     struct symt_function* sym;
 
-    assert(!sig_type || sig_type->tag == SymTagFunctionType);
+    /* A signature that is not a function type (records of newer compilers
+     * this reader does not know) is left out rather than asserted on: the
+     * assertion aborted the program that loaded the symbols -- OBS Studio's
+     * crash handler, winedbg on OBS's PDBs. */
+    if (sig_type && sig_type->tag != SymTagFunctionType)
+    {
+        WARN("%s: signature with tag %u, not a function type; left out\n", debugstr_a(name), sig_type->tag);
+        sig_type = NULL;
+    }
     if ((sym = pool_alloc(&module->pool, offsetof(struct symt_function, ranges[num_ranges]))))
     {
         sym->symt.tag  = tag;
