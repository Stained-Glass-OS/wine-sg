From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorerframe: item custom state and SetTheme (3563)

explorerframe: item custom state and SetTheme

INameSpaceTreeControl::GetItemCustomState / SetItemCustomState keep a per-item state (four bits, 0 for
an item never given one, E_INVALIDARG for an item that is not in the tree) and SetTheme applies the
theme class to the tree view (S_OK for any name, NULL for the default), as recorded by the
conformance test's todo_wine blocks, which are removed together with two itemstate todo marks that
already pass.
---
--- a/dlls/explorerframe/nstc.c
+++ b/dlls/explorerframe/nstc.c
@@ -47,6 +47,12 @@
     struct list entry;
 } nstc_root;
 
+typedef struct nstc_custom_state {
+    HTREEITEM htreeitem;
+    int state;
+    struct list entry;
+} nstc_custom_state;
+
 typedef struct {
     INameSpaceTreeControl2 INameSpaceTreeControl2_iface;
     IOleWindow IOleWindow_iface;
@@ -60,6 +66,7 @@
     NSTCSTYLE style;
     NSTCSTYLE2 style2;
     struct list roots;
+    struct list custom_states;
 
     INameSpaceTreeControlCustomDraw *customdraw;
     INameSpaceTreeControlDropHandler *dragdrop;
@@ -550,8 +557,15 @@
 static LRESULT on_tvn_deleteitemw(NSTC2Impl *This, LPARAM lParam)
 {
     NMTREEVIEWW *nmtv = (NMTREEVIEWW*)lParam;
+    nstc_custom_state *cs, *cs2;
     TRACE("%p\n", This);
 
+    LIST_FOR_EACH_ENTRY_SAFE(cs, cs2, &This->custom_states, nstc_custom_state, entry)
+    {
+        if (cs->htreeitem != nmtv->itemOld.hItem) continue;
+        list_remove(&cs->entry);
+        free(cs);
+    }
     IShellItem_Release((IShellItem*)nmtv->itemOld.lParam);
     return TRUE;
 }
@@ -854,7 +868,14 @@
 
     if(!ref)
     {
+        nstc_custom_state *cs, *cs2;
+
         TRACE("Freeing.\n");
+        LIST_FOR_EACH_ENTRY_SAFE(cs, cs2, &This->custom_states, nstc_custom_state, entry)
+        {
+            list_remove(&cs->entry);
+            free(cs);
+        }
         free(This);
         EFRAME_UnlockModule();
     }
@@ -1266,8 +1287,23 @@
                                                  int *piStateNumber)
 {
     NSTC2Impl *This = impl_from_INameSpaceTreeControl2(iface);
-    FIXME("stub, %p (%p, %p)\n", This, psi, piStateNumber);
-    return E_NOTIMPL;
+    nstc_custom_state *cs;
+    HTREEITEM hitem;
+
+    TRACE("%p (%p, %p)\n", This, psi, piStateNumber);
+
+    hitem = treeitem_from_shellitem(This, psi);
+    if(!hitem) return E_INVALIDARG;
+
+    /* an item that was never given a state is unchecked */
+    *piStateNumber = 0;
+    LIST_FOR_EACH_ENTRY(cs, &This->custom_states, nstc_custom_state, entry)
+    {
+        if (cs->htreeitem != hitem) continue;
+        *piStateNumber = cs->state;
+        break;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI NSTC2_fnSetItemCustomState(INameSpaceTreeControl2* iface,
@@ -1275,8 +1311,28 @@
                                                  int iStateNumber)
 {
     NSTC2Impl *This = impl_from_INameSpaceTreeControl2(iface);
-    FIXME("stub, %p (%p, %d)\n", This, psi, iStateNumber);
-    return E_NOTIMPL;
+    nstc_custom_state *cs;
+    HTREEITEM hitem;
+
+    TRACE("%p (%p, %d)\n", This, psi, iStateNumber);
+
+    hitem = treeitem_from_shellitem(This, psi);
+    if(!hitem) return E_INVALIDARG;
+
+    /* only four bits of state are kept (the tree view's state image index) */
+    iStateNumber &= 0xF;
+    LIST_FOR_EACH_ENTRY(cs, &This->custom_states, nstc_custom_state, entry)
+    {
+        if (cs->htreeitem != hitem) continue;
+        cs->state = iStateNumber;
+        return S_OK;
+    }
+
+    if(!(cs = malloc(sizeof(*cs)))) return E_OUTOFMEMORY;
+    cs->htreeitem = hitem;
+    cs->state = iStateNumber;
+    list_add_tail(&This->custom_states, &cs->entry);
+    return S_OK;
 }
 
 static HRESULT WINAPI NSTC2_fnEnsureItemVisible(INameSpaceTreeControl2* iface,
@@ -1301,8 +1357,12 @@
                                        LPCWSTR pszTheme)
 {
     NSTC2Impl *This = impl_from_INameSpaceTreeControl2(iface);
-    FIXME("stub, %p (%p)\n", This, pszTheme);
-    return E_NOTIMPL;
+
+    TRACE("%p (%s)\n", This, debugstr_w(pszTheme));
+
+    /* the theme class is applied to the tree view; an unknown one only means no theme data (NULL: the default) */
+    SetWindowTheme(This->hwnd_tv, pszTheme, NULL);
+    return S_OK;
 }
 
 static HRESULT WINAPI NSTC2_fnGetNextItem(INameSpaceTreeControl2* iface,
@@ -1610,6 +1670,7 @@
     nstc->IOleWindow_iface.lpVtbl = &vt_IOleWindow;
 
     list_init(&nstc->roots);
+    list_init(&nstc->custom_states);
 
     ret = INameSpaceTreeControl2_QueryInterface(&nstc->INameSpaceTreeControl2_iface, riid, ppv);
     INameSpaceTreeControl2_Release(&nstc->INameSpaceTreeControl2_iface);
