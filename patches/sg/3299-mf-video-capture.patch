+    struct capture_source *capture = stream->source;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, token);
+
+    EnterCriticalSection(&capture->cs);
+    if (capture->state == CAPTURE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (capture->state != CAPTURE_STARTED || !stream->active)
+        hr = MF_E_MEDIA_SOURCE_WRONGSTATE;
+    else if (!array_reserve((void **)&stream->tokens, &stream->token_capacity, stream->token_count + 1,
+            sizeof(*stream->tokens)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        if (token) IUnknown_AddRef(token);
+        stream->tokens[stream->token_count++] = token;
+    }
+    LeaveCriticalSection(&capture->cs);
+    return hr;
+}
