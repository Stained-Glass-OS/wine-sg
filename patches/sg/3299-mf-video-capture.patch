+/***********************************************************************
+ *      MFCreateDeviceSource (mf.@)
+ */
+HRESULT WINAPI MFCreateDeviceSource(IMFAttributes *attributes, IMFMediaSource **source)
+{
+    GUID source_type;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", attributes, source);
+
+    if (!attributes || !source)
+        return E_INVALIDARG;
+    *source = NULL;
+
+    if (FAILED(hr = IMFAttributes_GetGUID(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE, &source_type)))
+        return hr;
+
+    if (IsEqualGUID(&source_type, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID))
+        return create_video_capture_source(attributes, source);
+    if (IsEqualGUID(&source_type, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_GUID))
+    {
+        FIXME("Audio capture sources are not implemented.\n");
+        return E_NOTIMPL;
+    }
+
+    return E_INVALIDARG;
+}
+
+/***********************************************************************
+ *      MFCreateDeviceSourceActivate (mf.@)
+ */
+HRESULT WINAPI MFCreateDeviceSourceActivate(IMFAttributes *attributes, IMFActivate **activate)
+{
+    GUID source_type;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", attributes, activate);
+
+    if (!attributes || !activate)
+        return E_INVALIDARG;
+    *activate = NULL;
+
+    if (FAILED(hr = IMFAttributes_GetGUID(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE, &source_type)))
+        return hr;
+
+    if (IsEqualGUID(&source_type, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID))
+        return create_video_capture_activate(attributes, activate);
+    if (IsEqualGUID(&source_type, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_GUID))
+        return create_audio_capture_activate(attributes, activate);
+
+    return E_INVALIDARG;
+}
+
 struct simple_type_handler
 {
     IMFMediaTypeHandler IMFMediaTypeHandler_iface;
