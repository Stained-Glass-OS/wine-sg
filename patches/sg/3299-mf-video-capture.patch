diff --git a/dlls/mf/vidcap.c b/dlls/mf/vidcap.c
new file mode 100644
index 0000000..acaf1b7
--- /dev/null
+++ b/dlls/mf/vidcap.c
@@ -0,0 +1,205 @@
+/*
+ * Media Foundation video capture devices
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include "mfapi.h"
+#include "mferror.h"
+#include "mfidl.h"
+#include "mf_private.h"
+
+#include "initguid.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+
+/* KSCATEGORY_VIDEO_CAMERA and KSCATEGORY_CAPTURE, the categories a camera is in */
+DEFINE_GUID(vidcap_category_camera, 0xe5323777, 0xf976, 0x4f5b, 0x9b, 0x55, 0xb9, 0x46, 0x99, 0xc4, 0x6e, 0x44);
+DEFINE_GUID(vidcap_category_capture, 0x65e8773d, 0x8f56, 0x11d0, 0xa3, 0xb9, 0x00, 0xa0, 0xc9, 0x22, 0x31, 0x96);
+
+/* the two functions winegstreamer exports for the cameras */
+struct vidcap_device
+{
+    WCHAR link[64];
+    WCHAR name[128];
+};
+
+typedef HRESULT (WINAPI *enum_devices_func)(struct vidcap_device **devices, UINT32 *count);
+typedef HRESULT (WINAPI *create_source_func)(const WCHAR *link, IMFAttributes *attributes, IMFMediaSource **source);
+
+static HRESULT get_gst_funcs(enum_devices_func *enum_devices, create_source_func *create_source)
+{
+    HMODULE module;
+
+    if (!(module = LoadLibraryW(L"winegstreamer.dll")))
+        return HRESULT_FROM_WIN32(ERROR_MOD_NOT_FOUND);
+    *enum_devices = (enum_devices_func)GetProcAddress(module, "winegstreamer_enum_video_capture_devices");
+    *create_source = (create_source_func)GetProcAddress(module, "winegstreamer_create_video_capture_source");
+    if (!*enum_devices || !*create_source)
+        return HRESULT_FROM_WIN32(ERROR_PROC_NOT_FOUND);
+    return S_OK;
+}
+
+HRESULT create_video_capture_source(IMFAttributes *attributes, IMFMediaSource **source)
+{
+    enum_devices_func enum_devices;
+    create_source_func create_source;
+    WCHAR *link;
+    UINT32 len;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFAttributes_GetStringLength(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK, &len)))
+        return hr == MF_E_ATTRIBUTENOTFOUND ? E_INVALIDARG : hr;
+    if (!(link = malloc((len + 1) * sizeof(*link))))
+        return E_OUTOFMEMORY;
+    if (SUCCEEDED(hr = IMFAttributes_GetString(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK,
+            link, len + 1, NULL)) && SUCCEEDED(hr = get_gst_funcs(&enum_devices, &create_source)))
+        hr = create_source(link, attributes, source);
+    free(link);
+    return hr;
+}
+
+static HRESULT video_capture_create_object(IMFAttributes *attributes, void *user_context, IUnknown **obj)
+{
+    IMFMediaSource *source;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p.\n", attributes, user_context, obj);
+
+    if (SUCCEEDED(hr = create_video_capture_source(attributes, &source)))
+        *obj = (IUnknown *)source;
+    return hr;
+}
+
+static void video_capture_shutdown_object(void *user_context, IUnknown *obj)
+{
+    IMFMediaSource *source;
+
+    TRACE("%p, %p.\n", user_context, obj);
+
+    /* a source is shut down through IMFMediaSource, it has no IMFShutdown */
+#ifdef SG_MUTANT_VC_NOSHUT
+    return;
+#endif
+    if (SUCCEEDED(IUnknown_QueryInterface(obj, &IID_IMFMediaSource, (void **)&source)))
+    {
+        IMFMediaSource_Shutdown(source);
+        IMFMediaSource_Release(source);
+    }
+}
+
+static void video_capture_free_private(void *user_context)
+{
+}
+
+static const struct activate_funcs video_capture_activate_funcs =
+{
+    video_capture_create_object,
+    video_capture_shutdown_object,
+    video_capture_free_private,
+};
+
+HRESULT create_video_capture_activate(IMFAttributes *attributes, IMFActivate **activate)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = create_activation_object(NULL, &video_capture_activate_funcs, activate)))
+        return hr;
+    if (attributes && FAILED(hr = IMFAttributes_CopyAllItems(attributes, (IMFAttributes *)*activate)))
+    {
+        IMFActivate_Release(*activate);
+        *activate = NULL;
+    }
+    return hr;
+}
+
+HRESULT enum_video_capture_sources(IMFAttributes *attributes, IMFActivate ***ret_sources, UINT32 *ret_count)
+{
+    enum_devices_func enum_devices;
+    create_source_func create_source;
+    struct vidcap_device *devices = NULL;
+    IMFActivate **sources = NULL;
+    UINT32 count = 0, i, created = 0;
+    GUID category;
+    HRESULT hr;
+
+    *ret_count = 0;
+
+    /* a category other than the cameras' has no device here */
+    if (SUCCEEDED(IMFAttributes_GetGUID(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_CATEGORY, &category))
+#ifdef SG_MUTANT_VC_NOCAT
+            && 0
+#endif
+            && !IsEqualGUID(&category, &vidcap_category_camera) && !IsEqualGUID(&category, &vidcap_category_capture))
+    {
+        *ret_sources = NULL;
+        return S_OK;
+    }
+
+    if (FAILED(hr = get_gst_funcs(&enum_devices, &create_source)))
+    {
+        /* no GStreamer support: no cameras */
+        *ret_sources = NULL;
+        return S_OK;
+    }
+    if (FAILED(hr = enum_devices(&devices, &count)))
+    {
+        WARN("Failed to enumerate the cameras, hr %#lx.\n", hr);
+        *ret_sources = NULL;
+        return S_OK;
+    }
+    if (!count)
+    {
+#ifndef SG_MUTANT_MF_ENUM_EMPTY
+        *ret_sources = NULL;
+#endif
+        return S_OK;
+    }
+
+    if (!(sources = CoTaskMemAlloc(count * sizeof(*sources))))
+    {
+        CoTaskMemFree(devices);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = create_activation_object(NULL, &video_capture_activate_funcs, &sources[i])))
+            goto done;
+        ++created;
+        IMFActivate_SetGUID(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID);
+        IMFActivate_SetGUID(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_CATEGORY, &vidcap_category_camera);
+        IMFActivate_SetString(sources[i], &MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME, devices[i].name);
+        IMFActivate_SetString(sources[i], &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK, devices[i].link);
+    }
+    *ret_sources = sources;
+    *ret_count = count;
+    hr = S_OK;
+
+done:
+    if (FAILED(hr))
+    {
+        for (i = 0; i < created; ++i)
+            IMFActivate_Release(sources[i]);
+        CoTaskMemFree(sources);
+    }
+    CoTaskMemFree(devices);
+    return hr;
+}
