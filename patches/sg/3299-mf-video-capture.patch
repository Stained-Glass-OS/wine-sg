+/* ---- delivery ---- */
+
+static void capture_deliver(struct capture_source *source, const void *data, UINT32 size, UINT64 pts,
+        UINT64 duration, UINT32 flags)
+{
+    struct capture_stream *stream;
+    IUnknown *token = NULL;
+    IMFSample *sample;
+    IMFMediaBuffer *buffer;
+    BYTE *dest;
+    HRESULT hr;
+
+    EnterCriticalSection(&source->cs);
+    stream = source->stream;
+#ifdef SG_MUTANT_VC_PUSH
+    if (source->state == CAPTURE_STARTED && !stream->token_count && !stream->tokens)
+        stream->tokens = calloc(1, sizeof(*stream->tokens)), stream->token_capacity = 1, stream->token_count = 1;
+#endif
+    if (source->state != CAPTURE_STARTED || !stream->token_count)
+    {
+        /* nobody asked for a frame: a live camera does not queue them up */
+        LeaveCriticalSection(&source->cs);
+        return;
+    }
+    token = stream->tokens[0];
+    memmove(stream->tokens, stream->tokens + 1, --stream->token_count * sizeof(*stream->tokens));
+    IMFMediaStream_AddRef(&stream->IMFMediaStream_iface);
+    LeaveCriticalSection(&source->cs);
+
+    if (SUCCEEDED(hr = MFCreateSample(&sample)))
+    {
+        if (SUCCEEDED(hr = MFCreateMemoryBuffer(size, &buffer)))
+        {
+            if (SUCCEEDED(hr = IMFMediaBuffer_Lock(buffer, &dest, NULL, NULL)))
+            {
+                memcpy(dest, data, size);
+                IMFMediaBuffer_Unlock(buffer);
+                IMFMediaBuffer_SetCurrentLength(buffer, size);
+                IMFSample_AddBuffer(sample, buffer);
+            }
+            IMFMediaBuffer_Release(buffer);
+        }
+        if (SUCCEEDED(hr))
+        {
+            if (flags & WG_CAPTURE_FRAME_HAS_PTS) IMFSample_SetSampleTime(sample, pts);
+            if (flags & WG_CAPTURE_FRAME_HAS_DURATION) IMFSample_SetSampleDuration(sample, duration);
+            IMFSample_SetUINT32(sample, &MFSampleExtension_CleanPoint, 1);
+            if (flags & WG_CAPTURE_FRAME_DISCONTINUITY) IMFSample_SetUINT32(sample, &MFSampleExtension_Discontinuity, 1);
+            if (token) IMFSample_SetUnknown(sample, &MFSampleExtension_Token, token);
+            hr = IMFMediaEventQueue_QueueEventParamUnk(stream->event_queue, MEMediaSample, &GUID_NULL, S_OK,
+                    (IUnknown *)sample);
+        }
+        IMFSample_Release(sample);
+    }
+    if (FAILED(hr))
+        WARN("Failed to deliver a frame, hr %#lx.\n", hr);
+    if (token) IUnknown_Release(token);
+    IMFMediaStream_Release(&stream->IMFMediaStream_iface);
+}
+
+static DWORD CALLBACK capture_thread(void *arg)
+{
+    struct capture_source *source = arg;
+    wg_capture_t capture = source->capture;
+    struct wg_capture_read_params params = {.capture = capture, .timeout_ms = 100};
+    void *buffer;
+
+    if (!(buffer = malloc(source->frame_size)))
+        return 0;
+    params.buffer = buffer;
+    params.buffer_size = source->frame_size;
+
+    TRACE("Capture thread for %p started.\n", source);
+
+    while (!source->stop_thread)
+    {
+        NTSTATUS status = WINE_UNIX_CALL(unix_wg_capture_read, &params);
+
+        if (status == STATUS_TIMEOUT)
+            continue;
+        if (status == STATUS_CANCELLED || status == STATUS_END_OF_FILE)
+            break;
+        if (status)
+        {
+            WARN("Capture failed, status %#lx.\n", status);
+            IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MEError, &GUID_NULL,
+                    MF_E_HW_MFT_FAILED_START_STREAMING, NULL);
+            break;
+        }
+        capture_deliver(source, buffer, params.size, params.pts, params.duration, params.flags);
+    }
+
+    free(buffer);
+    TRACE("Capture thread for %p exiting.\n", source);
+    return 0;
+}
+
+/* stops the device and its thread; the caller does not hold the lock */
+static void capture_halt(struct capture_source *source, HANDLE thread)
+{
+    InterlockedExchange(&source->stop_thread, 1);
+#ifndef SG_MUTANT_VC_NOSTOP
+    if (source->capture)
+        capture_call(unix_wg_capture_stop, &source->capture);
+#endif
+    if (thread)
+    {
+        WaitForSingleObject(thread, INFINITE);
+        CloseHandle(thread);
+    }
+}
