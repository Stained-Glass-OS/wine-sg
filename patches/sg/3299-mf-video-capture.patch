+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <assert.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#ifdef __linux__
+#include <linux/videodev2.h>
+#endif
+
+#include <gst/gst.h>
+#include <gst/video/video.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winternl.h"
+
+#include "unix_private.h"
+
+/* Test hook: WINE_SG_FAKE_CAMERAS is a comma separated list of "raw" and
+ * "jpeg". When it is set the listed fake cameras (a live videotestsrc, which
+ * delivers either raw frames or JPEG pictures) are the only capture devices:
+ * no /dev/video* node is looked at or opened. The negotiation, the format
+ * list and the frame delivery are the same code as for a real V4L2 device;
+ * only the element that produces the frames and the device's capability
+ * caps differ. */
+#define FAKE_ENV "WINE_SG_FAKE_CAMERAS"
+#define FAKE_PREFIX "fake:"
+
+#define QUEUE_MAX 4
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
+
+struct capture_frame
+{
+    void *data;
+    uint32_t size;
+    uint64_t pts, duration;
+    bool has_pts, has_duration, discontinuity;
+};
+
+struct wg_capture
+{
+    GstElement *pipeline;
+    GstPad *my_sink;
+    GstBus *bus;
+
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    struct capture_frame frames[QUEUE_MAX];
+    unsigned int head, count;
+    bool running, error, eos, cancelled;
+    bool dropped;
+    uint32_t frame_size;
+};
+
+static struct wg_capture *get_capture(wg_capture_t capture)
+{
+    return (struct wg_capture *)(ULONG_PTR)capture;
+}
+
+static const char *fake_kinds(void)
+{
+    const char *env = getenv(FAKE_ENV);
+    return env && env[0] ? env : NULL;
+}
+
+/* the capability caps of a fake camera, written like the caps of a V4L2 source */
+static const char *fake_caps_string(const char *path)
+{
+    if (strstr(path, FAKE_PREFIX "jpeg"))
+        return "image/jpeg,width=1280,height=720,framerate=30/1;"
+               "image/jpeg,width=640,height=480,framerate=15/1";
+    return "video/x-raw,format=YUY2,width=320,height=240,framerate=(fraction){15/1,30/1};"
+           "video/x-raw,format=YUY2,width=640,height=480,framerate=30/1";
+}
+
+static bool is_fake(const char *path)
+{
+    return !strncmp(path, FAKE_PREFIX, strlen(FAKE_PREFIX));
+}
+
+NTSTATUS wg_capture_enum(void *args)
+{
+    struct wg_capture_enum_params *params = args;
+    const char *fake = fake_kinds();
+    unsigned int count = 0;
+
+    memset(params->devices, 0, sizeof(params->devices));
+
+    if (fake)
+    {
+        char *list = strdup(fake), *tok, *save = NULL;
+        unsigned int index = 0;
+
+        if (!list) return STATUS_NO_MEMORY;
+        for (tok = strtok_r(list, ",", &save); tok && count < WG_CAPTURE_MAX_DEVICES;
+                tok = strtok_r(NULL, ",", &save), ++index)
+        {
+            if (strcmp(tok, "raw") && strcmp(tok, "jpeg")) continue;
+            snprintf(params->devices[count].path, sizeof(params->devices[count].path),
+                    FAKE_PREFIX "%.8s%u", tok, index);
+            snprintf(params->devices[count].name, sizeof(params->devices[count].name),
+                    "Fake %s camera %u", tok, index);
+            ++count;
+        }
+        free(list);
+        params->count = count;
+        return STATUS_SUCCESS;
+    }
+
+#ifdef V4L2_CAP_VIDEO_CAPTURE
+    {
+        struct dirent **names = NULL;
+        int i, n = scandir("/dev", &names, NULL, alphasort);
+
+        for (i = 0; i < n; ++i)
+        {
+            const char *name = names[i]->d_name;
+            char path[64];
+            struct v4l2_capability cap;
+            uint32_t caps;
+            int fd;
+
+            if (count < WG_CAPTURE_MAX_DEVICES && !strncmp(name, "video", 5) && name[5] >= '0' && name[5] <= '9')
+            {
+                snprintf(path, sizeof(path), "/dev/%s", name);
+                if ((fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC)) >= 0)
+                {
+                    memset(&cap, 0, sizeof(cap));
+                    if (!ioctl(fd, VIDIOC_QUERYCAP, &cap))
+                    {
+                        caps = (cap.capabilities & V4L2_CAP_DEVICE_CAPS) ? cap.device_caps : cap.capabilities;
+                        /* uvc cameras have a second node for metadata: only nodes that capture video */
+                        if (caps & (V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_VIDEO_CAPTURE_MPLANE))
+                        {
+                            strcpy(params->devices[count].path, path);
+                            snprintf(params->devices[count].name, sizeof(params->devices[count].name),
+                                    "%s", (const char *)cap.card);
+                            ++count;
+                        }
+                    }
+                    close(fd);
+                }
+            }
+            free(names[i]);
+        }
+        free(names);
+    }
+#endif
+    params->count = count;
+    return STATUS_SUCCESS;
+}
+
+static void add_format(struct wg_capture_formats_params *params, uint32_t w, uint32_t h,
+        uint32_t fps_n, uint32_t fps_d, bool jpeg)
+{
+    unsigned int i;
+
+    if (!w || !h || !fps_n || !fps_d) return;
+    for (i = 0; i < params->count; ++i)
+    {
+        struct wg_capture_format *f = &params->formats[i];
+        if (f->width == w && f->height == h && (uint64_t)f->fps_num * fps_d == (uint64_t)fps_n * f->fps_den)
+        {
+            /* a raw mode wins over a JPEG one: no decoding */
+            if (f->jpeg && !jpeg) f->jpeg = 0;
+            return;
+        }
+    }
+    if (params->count >= WG_CAPTURE_MAX_FORMATS) return;
+    params->formats[params->count++] = (struct wg_capture_format){w, h, fps_n, fps_d, jpeg};
+}
+
+static const int standard_sizes[][2] =
+    {{160, 120}, {320, 240}, {640, 360}, {640, 480}, {800, 600}, {1024, 768}, {1280, 720}, {1920, 1080}};
+
+/* all the values an int field of a caps structure can take, within bounds */
+static unsigned int field_ints(const GstStructure *s, const char *name, int *out, unsigned int max)
+{
+    const GValue *v = gst_structure_get_value(s, name);
+    unsigned int n = 0, i;
+
+    if (!v) return 0;
+    if (G_VALUE_HOLDS_INT(v))
+        out[n++] = g_value_get_int(v);
+    else if (GST_VALUE_HOLDS_LIST(v))
+    {
+        for (i = 0; i < gst_value_list_get_size(v) && n < max; ++i)
+        {
+            const GValue *e = gst_value_list_get_value(v, i);
+            if (G_VALUE_HOLDS_INT(e)) out[n++] = g_value_get_int(e);
+        }
+    }
+    else if (GST_VALUE_HOLDS_INT_RANGE(v))
+    {
+        int lo = gst_value_get_int_range_min(v), hi = gst_value_get_int_range_max(v);
+        /* a continuous range: the standard sizes are offered; the two fields are matched by the caller */
+        out[n++] = lo;
+        if (hi != lo) out[n++] = hi;
+    }
+    return n;
+}
+
+static unsigned int field_fractions(const GstStructure *s, const char *name, int (*out)[2], unsigned int max)
+{
+    const GValue *v = gst_structure_get_value(s, name);
+    unsigned int n = 0, i;
+
+    if (!v) return 0;
+    if (GST_VALUE_HOLDS_FRACTION(v))
+    {
+        out[n][0] = gst_value_get_fraction_numerator(v);
+        out[n++][1] = gst_value_get_fraction_denominator(v);
+    }
+    else if (GST_VALUE_HOLDS_LIST(v))
+    {
+        for (i = 0; i < gst_value_list_get_size(v) && n < max; ++i)
+        {
+            const GValue *e = gst_value_list_get_value(v, i);
+            if (!GST_VALUE_HOLDS_FRACTION(e)) continue;
+            out[n][0] = gst_value_get_fraction_numerator(e);
+            out[n++][1] = gst_value_get_fraction_denominator(e);
+        }
+    }
+    else if (GST_VALUE_HOLDS_FRACTION_RANGE(v))
+    {
+        /* a continuous range: the usual rates inside it */
+        static const int rates[] = {30, 25, 24, 15, 10, 5};
+        const GValue *lo = gst_value_get_fraction_range_min(v), *hi = gst_value_get_fraction_range_max(v);
+        gdouble dlo = (gdouble)gst_value_get_fraction_numerator(lo) / gst_value_get_fraction_denominator(lo);
+        gdouble dhi = (gdouble)gst_value_get_fraction_numerator(hi) / gst_value_get_fraction_denominator(hi);
+        for (i = 0; i < ARRAY_SIZE(rates) && n < max; ++i)
+            if (rates[i] >= dlo && rates[i] <= dhi) { out[n][0] = rates[i]; out[n++][1] = 1; }
+    }
+    return n;
+}
+
+/* turn the capability caps of a source into the list of modes */
+static void formats_from_caps(struct wg_capture_formats_params *params, GstCaps *caps)
+{
+    unsigned int i, a, b, c;
+
+    for (i = 0; i < gst_caps_get_size(caps); ++i)
+    {
+        const GstStructure *s = gst_caps_get_structure(caps, i);
+        const char *name = gst_structure_get_name(s);
+        bool jpeg = !strcmp(name, "image/jpeg");
+        int ws[64], hs[64], rates[16][2];
+        unsigned int nw, nh, nr;
+
+        if (!jpeg && strcmp(name, "video/x-raw")) continue;
+#ifdef SG_MUTANT_VC_NOJPEG
+        if (jpeg) continue;
+#endif
+
+        nw = field_ints(s, "width", ws, ARRAY_SIZE(ws));
+        nh = field_ints(s, "height", hs, ARRAY_SIZE(hs));
+        nr = field_fractions(s, "framerate", rates, ARRAY_SIZE(rates));
+        if (!nw || !nh || !nr) continue;
+
+        if (gst_structure_get_value(s, "width") && GST_VALUE_HOLDS_INT_RANGE(gst_structure_get_value(s, "width")))
+        {
+            /* a stepwise device: the standard sizes inside the range */
+            for (a = 0; a < ARRAY_SIZE(standard_sizes); ++a)
+            {
+                int sw = standard_sizes[a][0], sh = standard_sizes[a][1];
+                if (sw < ws[0] || sw > ws[nw - 1] || sh < hs[0] || sh > hs[nh - 1]) continue;
+                for (c = 0; c < nr; ++c) add_format(params, sw, sh, rates[c][0], rates[c][1], jpeg);
+            }
+            continue;
+        }
+        /* width and height lists in one structure pair up by position (V4L2 sources give one structure per size) */
+        for (a = 0; a < nw; ++a)
+        {
+            b = nh == nw ? a : 0;
+            for (c = 0; c < nr; ++c) add_format(params, ws[a], hs[b], rates[c][0], rates[c][1], jpeg);
+            if (nh != nw) for (b = 1; b < nh; ++b)
+                for (c = 0; c < nr; ++c) add_format(params, ws[a], hs[b], rates[c][0], rates[c][1], jpeg);
+        }
+    }
+}
+
+NTSTATUS wg_capture_get_formats(void *args)
+{
+    struct wg_capture_formats_params *params = args;
+    GstCaps *caps = NULL;
+
+    params->count = 0;
+    memset(params->formats, 0, sizeof(params->formats));
+    params->path[sizeof(params->path) - 1] = 0;
+
+    if (is_fake(params->path))
+    {
+        if (!fake_kinds()) return STATUS_NO_SUCH_DEVICE;
+        caps = gst_caps_from_string(fake_caps_string(params->path));
+    }
+    else
+    {
+        GstElement *src;
+        GstPad *pad;
+
+        if (fake_kinds()) return STATUS_NO_SUCH_DEVICE; /* real nodes are not touched under the test hook */
+        if (!(src = create_element("v4l2src", "good"))) return STATUS_UNSUCCESSFUL;
+        g_object_set(src, "device", params->path, NULL);
+        if (gst_element_set_state(src, GST_STATE_READY) == GST_STATE_CHANGE_FAILURE)
+        {
+            gst_element_set_state(src, GST_STATE_NULL);
+            gst_object_unref(src);
+            return STATUS_NO_SUCH_DEVICE;
+        }
+        if ((pad = gst_element_get_static_pad(src, "src")))
+        {
+            caps = gst_pad_query_caps(pad, NULL);
+            gst_object_unref(pad);
+        }
+        gst_element_set_state(src, GST_STATE_NULL);
+        gst_object_unref(src);
+    }
+
+    if (!caps) return STATUS_UNSUCCESSFUL;
+    formats_from_caps(params, caps);
+    gst_caps_unref(caps);
+    return params->count ? STATUS_SUCCESS : STATUS_NO_SUCH_DEVICE;
+}
+
+static GstFlowReturn sink_chain_cb(GstPad *pad, GstObject *parent, GstBuffer *buffer)
+{
+    struct wg_capture *capture = gst_pad_get_element_private(pad);
+    struct capture_frame *frame;
+    GstMapInfo map;
+
+    if (!gst_buffer_map(buffer, &map, GST_MAP_READ))
+    {
+        gst_buffer_unref(buffer);
+        return GST_FLOW_OK;
+    }
+
+    pthread_mutex_lock(&capture->mutex);
+    if (capture->running)
+    {
+        if (capture->count == QUEUE_MAX)
+        {
+            /* a live source: the oldest frame goes when the consumer is slow */
+            free(capture->frames[capture->head].data);
+            capture->head = (capture->head + 1) % QUEUE_MAX;
+            capture->count--;
+            capture->dropped = true;
+        }
+        frame = &capture->frames[(capture->head + capture->count) % QUEUE_MAX];
+        frame->data = malloc(map.size);
+        if (frame->data)
+        {
+            memcpy(frame->data, map.data, map.size);
+            frame->size = map.size;
+            frame->has_pts = GST_BUFFER_PTS_IS_VALID(buffer);
+#ifdef SG_MUTANT_VC_NOPTS
+            frame->has_pts = false;
+#endif
+            frame->pts = frame->has_pts ? GST_BUFFER_PTS(buffer) / 100 : 0;
+            frame->has_duration = GST_BUFFER_DURATION_IS_VALID(buffer);
+            frame->duration = frame->has_duration ? GST_BUFFER_DURATION(buffer) / 100 : 0;
+            frame->discontinuity = capture->dropped || GST_BUFFER_FLAG_IS_SET(buffer, GST_BUFFER_FLAG_DISCONT);
+            capture->dropped = false;
+            capture->count++;
+            pthread_cond_signal(&capture->cond);
+        }
+    }
+    pthread_mutex_unlock(&capture->mutex);
+
+    gst_buffer_unmap(buffer, &map);
+    gst_buffer_unref(buffer);
+    return GST_FLOW_OK;
+}
+
+static gboolean sink_event_cb(GstPad *pad, GstObject *parent, GstEvent *event)
+{
+    struct wg_capture *capture = gst_pad_get_element_private(pad);
+
+    if (GST_EVENT_TYPE(event) == GST_EVENT_EOS)
+    {
+        pthread_mutex_lock(&capture->mutex);
+        capture->eos = true;
+        pthread_cond_broadcast(&capture->cond);
+        pthread_mutex_unlock(&capture->mutex);
+    }
+    gst_event_unref(event);
+    return TRUE;
+}
+
+static GstBusSyncReply bus_handler_cb(GstBus *bus, GstMessage *message, gpointer user)
+{
+    struct wg_capture *capture = user;
+
+    if (GST_MESSAGE_TYPE(message) == GST_MESSAGE_ERROR)
+    {
+        GError *err;
+        gchar *debug;
+
+        gst_message_parse_error(message, &err, &debug);
+        GST_ERROR("capture error: %s: %s", err->message, debug);
+        g_error_free(err);
+        g_free(debug);
+        pthread_mutex_lock(&capture->mutex);
+        capture->error = true;
+        pthread_cond_broadcast(&capture->cond);
+        pthread_mutex_unlock(&capture->mutex);
+    }
+    gst_message_unref(message);
+    return GST_BUS_DROP;
+}
+
+static void clear_frames(struct wg_capture *capture)
+{
+    while (capture->count)
+    {
+        free(capture->frames[capture->head].data);
+        capture->head = (capture->head + 1) % QUEUE_MAX;
+        capture->count--;
+    }
+}
+
+static GstElement *add_element(struct wg_capture *capture, const char *name, const char *set)
+{
+    GstElement *element = create_element(name, set);
+
+    if (element && !gst_bin_add(GST_BIN(capture->pipeline), element))
+    {
+        gst_object_unref(element);
+        element = NULL;
+    }
+    return element;
+}
+
+NTSTATUS wg_capture_create(void *args)
+{
+    struct wg_capture_create_params *params = args;
+    struct wg_capture *capture;
+    GstElement *e, *last = NULL;
+    GstCaps *caps;
+    GstVideoInfo info;
+    GstPad *pad;
+    const char *format;
+    char caps_str[512];
+    bool fake;
+
+    params->path[sizeof(params->path) - 1] = 0;
+    fake = is_fake(params->path);
+    if (fake != !!fake_kinds()) return STATUS_NO_SUCH_DEVICE;
+
+    if (params->subtype == WG_CAPTURE_SUBTYPE_YUY2) format = "YUY2";
+#ifdef SG_MUTANT_VC_NV12
+    else if (params->subtype == WG_CAPTURE_SUBTYPE_NV12) format = "YUY2";
+#else
+    else if (params->subtype == WG_CAPTURE_SUBTYPE_NV12) format = "NV12";
+#endif
+    else return STATUS_INVALID_PARAMETER;
+    if (!params->width || !params->height || !params->fps_num || !params->fps_den)
+        return STATUS_INVALID_PARAMETER;
+
+    gst_video_info_init(&info);
+    if (!gst_video_info_set_format(&info, gst_video_format_from_string(format), params->width, params->height))
+        return STATUS_INVALID_PARAMETER;
+
+    if (!(capture = calloc(1, sizeof(*capture)))) return STATUS_NO_MEMORY;
+    pthread_mutex_init(&capture->mutex, NULL);
+    pthread_cond_init(&capture->cond, NULL);
+    capture->frame_size = GST_VIDEO_INFO_SIZE(&info);
+    params->frame_size = capture->frame_size;
+
+    capture->pipeline = gst_pipeline_new(NULL);
+    capture->bus = gst_bus_new();
+    gst_bus_set_sync_handler(capture->bus, bus_handler_cb, capture, NULL);
+    gst_element_set_bus(capture->pipeline, capture->bus);
+
+#define LINK(elem) do { \
+        if (!(e = (elem))) goto fail; \
+        if (last && !gst_element_link(last, e)) { GST_ERROR("Failed to link capture elements."); goto fail; } \
+        last = e; } while (0)
+#define FILTER(...) do { \
+        snprintf(caps_str, sizeof(caps_str), __VA_ARGS__); \
+        caps = gst_caps_from_string(caps_str); \
+        LINK(add_element(capture, "capsfilter", "coreelements")); \
+        g_object_set(e, "caps", caps, NULL); gst_caps_unref(caps); } while (0)
+
+    if (fake)
+    {
+        LINK(add_element(capture, "videotestsrc", "base"));
+        g_object_set(e, "is-live", TRUE, NULL);
+        FILTER("video/x-raw,width=%u,height=%u,framerate=%u/%u", params->width, params->height,
+                params->fps_num, params->fps_den);
+        /* a camera that delivers JPEG pictures only: the test pattern is encoded */
+        if (params->jpeg) LINK(add_element(capture, "jpegenc", "jpeg"));
+    }
+    else
+    {
+        LINK(add_element(capture, "v4l2src", "good"));
+        g_object_set(e, "device", params->path, NULL);
+        if (params->jpeg)
+            FILTER("image/jpeg,width=%u,height=%u,framerate=%u/%u", params->width, params->height,
+                    params->fps_num, params->fps_den);
+        else
+            FILTER("video/x-raw,width=%u,height=%u,framerate=%u/%u", params->width, params->height,
+                    params->fps_num, params->fps_den);
+    }
+#ifndef SG_MUTANT_VC_NODECODE
+    if (params->jpeg) LINK(add_element(capture, "jpegdec", "jpeg"));
+#endif
+    LINK(add_element(capture, "videoconvert", "videoconvertscale"));
+    FILTER("video/x-raw,format=%s,width=%u,height=%u,framerate=%u/%u", format, params->width,
+            params->height, params->fps_num, params->fps_den);
+#undef FILTER
+#undef LINK
+
+    {
+        GstStaticPadTemplate tmpl = GST_STATIC_PAD_TEMPLATE("capture_sink", GST_PAD_SINK, GST_PAD_ALWAYS, GST_STATIC_CAPS_ANY);
+        capture->my_sink = gst_pad_new_from_static_template(&tmpl, "capture-sink");
+    }
+    gst_pad_set_element_private(capture->my_sink, capture);
+    gst_pad_set_chain_function(capture->my_sink, sink_chain_cb);
+    gst_pad_set_event_function(capture->my_sink, sink_event_cb);
+    gst_pad_set_active(capture->my_sink, TRUE);
+    pad = gst_element_get_static_pad(last, "src");
+    if (gst_pad_link(pad, capture->my_sink) != GST_PAD_LINK_OK)
+    {
+        gst_object_unref(pad);
+        goto fail;
+    }
+    gst_object_unref(pad);
+
+    /* PAUSED opens the device and negotiates; a live source delivers nothing until PLAYING */
+    if (gst_element_set_state(capture->pipeline, GST_STATE_PAUSED) == GST_STATE_CHANGE_FAILURE
+            || gst_element_get_state(capture->pipeline, NULL, NULL, 5 * GST_SECOND) == GST_STATE_CHANGE_FAILURE
+            || capture->error)
+    {
+        GST_ERROR("Failed to open the capture pipeline.");
+        goto fail;
+    }
+
+    params->capture = (ULONG_PTR)capture;
+    return STATUS_SUCCESS;
+
+fail:
+    gst_element_set_state(capture->pipeline, GST_STATE_NULL);
+    if (capture->my_sink) gst_object_unref(capture->my_sink);
+    gst_object_unref(capture->pipeline);
+    gst_object_unref(capture->bus);
+    pthread_mutex_destroy(&capture->mutex);
+    pthread_cond_destroy(&capture->cond);
+    free(capture);
+    return STATUS_UNSUCCESSFUL;
+}
+
+NTSTATUS wg_capture_start(void *args)
+{
+    struct wg_capture *capture = get_capture(*(wg_capture_t *)args);
+
+    pthread_mutex_lock(&capture->mutex);
+    clear_frames(capture);
+    capture->cancelled = false;
+    capture->eos = false;
+    capture->running = true;
+    pthread_mutex_unlock(&capture->mutex);
+
+    if (gst_element_set_state(capture->pipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE)
+        return STATUS_UNSUCCESSFUL;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wg_capture_stop(void *args)
+{
+    struct wg_capture *capture = get_capture(*(wg_capture_t *)args);
+
+    pthread_mutex_lock(&capture->mutex);
+    capture->running = false;
+    capture->cancelled = true;
+    clear_frames(capture);
+    pthread_cond_broadcast(&capture->cond);
+    pthread_mutex_unlock(&capture->mutex);
+
+    /* back to PAUSED: the streaming threads end and, for a real camera, no frames are produced */
+    gst_element_set_state(capture->pipeline, GST_STATE_PAUSED);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wg_capture_read(void *args)
+{
+    struct wg_capture_read_params *params = args;
+    struct wg_capture *capture = get_capture(params->capture);
+    struct capture_frame *frame;
+    struct timespec ts;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_nsec += (long)params->timeout_ms * 1000000L;
+    ts.tv_sec += ts.tv_nsec / 1000000000L;
+    ts.tv_nsec %= 1000000000L;
+
+    pthread_mutex_lock(&capture->mutex);
+    while (!capture->count && !capture->cancelled && !capture->error && !capture->eos)
+    {
+        if (pthread_cond_timedwait(&capture->cond, &capture->mutex, &ts) == ETIMEDOUT)
+        {
+            status = STATUS_TIMEOUT;
+            break;
+        }
+    }
+    if (status) {}
+    else if (capture->cancelled) status = STATUS_CANCELLED;
+    else if (capture->count)
+    {
+        frame = &capture->frames[capture->head];
+        if (frame->size > params->buffer_size)
+        {
+            params->size = frame->size;
+            status = STATUS_BUFFER_TOO_SMALL;
+        }
+        else
+        {
+            memcpy(params->buffer, frame->data, frame->size);
+            params->size = frame->size;
+            params->pts = frame->pts;
+            params->duration = frame->duration;
+            params->flags = (frame->has_pts ? WG_CAPTURE_FRAME_HAS_PTS : 0)
+                    | (frame->has_duration ? WG_CAPTURE_FRAME_HAS_DURATION : 0)
+                    | (frame->discontinuity ? WG_CAPTURE_FRAME_DISCONTINUITY : 0);
+            free(frame->data);
+            capture->head = (capture->head + 1) % QUEUE_MAX;
+            capture->count--;
+        }
+    }
+    else if (capture->error) status = STATUS_UNSUCCESSFUL;
+    else status = STATUS_END_OF_FILE;
+    pthread_mutex_unlock(&capture->mutex);
+    return status;
+}
+
+NTSTATUS wg_capture_destroy(void *args)
+{
+    struct wg_capture *capture = get_capture(*(wg_capture_t *)args);
+
+    pthread_mutex_lock(&capture->mutex);
+    capture->running = false;
+    capture->cancelled = true;
+    pthread_cond_broadcast(&capture->cond);
+    pthread_mutex_unlock(&capture->mutex);
+
+    gst_element_set_state(capture->pipeline, GST_STATE_NULL);
+    gst_object_unref(capture->my_sink);
+    gst_object_unref(capture->pipeline);
+    gst_object_unref(capture->bus);
+
+    clear_frames(capture);
+    pthread_mutex_destroy(&capture->mutex);
+    pthread_cond_destroy(&capture->cond);
+    free(capture);
+    return STATUS_SUCCESS;
+}
