+
+static HRESULT WINAPI capture_source_Start(IMFMediaSourceEx *iface, IMFPresentationDescriptor *descriptor,
+        const GUID *time_format, const PROPVARIANT *position)
+{
+    struct capture_source *source = impl_from_IMFMediaSourceEx(iface);
+    IMFMediaTypeHandler *handler, *own;
+    IMFStreamDescriptor *sd;
+    IMFMediaType *current = NULL;
+    BOOL selected;
+    unsigned int i, index = ~0u;
+    HANDLE old_thread = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %p, %s, %p.\n", iface, descriptor, debugstr_guid(time_format), position);
+
+    if (!descriptor || !position)
+        return E_INVALIDARG;
+    if (time_format && !IsEqualGUID(time_format, &GUID_NULL))
+        return MF_E_UNSUPPORTED_TIME_FORMAT;
+
+    if (FAILED(hr = IMFPresentationDescriptor_GetStreamDescriptorByIndex(descriptor, 0, &selected, &sd)))
+        return MF_E_INVALIDREQUEST;
+
+    /* the type chosen by the application is the current type of the descriptor it passes */
+    hr = IMFStreamDescriptor_GetMediaTypeHandler(sd, &handler);
+    IMFStreamDescriptor_Release(sd);
+    if (FAILED(hr))
+        return hr;
+    hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, &current);
+    IMFMediaTypeHandler_Release(handler);
+    if (FAILED(hr) || !current)
+        return MF_E_INVALIDREQUEST;
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUTDOWN)
+    {
+        hr = MF_E_SHUTDOWN;
+        goto done;
+    }
+    if (!selected)
+    {
+        hr = MF_E_INVALIDREQUEST;
+        goto done;
+    }
+
+    for (i = 0; i < source->type_count; ++i)
+    {
+        if (type_matches(source->types[i], current))
+        {
+            index = i;
+            break;
+        }
+    }
+    if (index == ~0u)
+    {
+        hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+
+    if (source->state == CAPTURE_STARTED)
+    {
+        /* a new start: the device runs again, with the type asked for now */
+        old_thread = source->thread;
+        source->thread = NULL;
+        source->state = CAPTURE_STOPPED;
+        LeaveCriticalSection(&source->cs);
+        capture_halt(source, old_thread);
+        EnterCriticalSection(&source->cs);
+        if (source->state == CAPTURE_SHUTDOWN)
+        {
+            hr = MF_E_SHUTDOWN;
+            goto done;
+        }
+    }
+
+    if (source->capture && source->capture_type != index)
+        capture_close(source);
+    if (!source->capture && FAILED(hr = capture_open(source, index)))
+        goto done;
+
+    if (FAILED(hr = capture_call(unix_wg_capture_start, &source->capture)))
+        goto done;
+
+    source->stop_thread = 0;
+    if (!(source->thread = CreateThread(NULL, 0, capture_thread, source, 0, NULL)))
+    {
+        capture_call(unix_wg_capture_stop, &source->capture);
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    source->state = CAPTURE_STARTED;
+    source->stream->active = TRUE;
+
+    if (SUCCEEDED(IMFStreamDescriptor_GetMediaTypeHandler(source->sd, &own)))
+    {
+        IMFMediaTypeHandler_SetCurrentMediaType(own, source->types[index]);
+        IMFMediaTypeHandler_Release(own);
+    }
+
+    if (!source->stream_announced)
+    {
+        source->stream_announced = TRUE;
+        IMFMediaEventQueue_QueueEventParamUnk(source->event_queue, MENewStream, &GUID_NULL, S_OK,
+                (IUnknown *)&source->stream->IMFMediaStream_iface);
+    }
+    else
+        IMFMediaEventQueue_QueueEventParamUnk(source->event_queue, MEUpdatedStream, &GUID_NULL, S_OK,
+                (IUnknown *)&source->stream->IMFMediaStream_iface);
+    IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStarted, &GUID_NULL, S_OK, position);
+    IMFMediaEventQueue_QueueEventParamVar(source->stream->event_queue, MEStreamStarted, &GUID_NULL, S_OK, position);
+    hr = S_OK;
+
+done:
+    LeaveCriticalSection(&source->cs);
+    if (current) IMFMediaType_Release(current);
+    return hr;
+}
+
+static HRESULT WINAPI capture_source_Stop(IMFMediaSourceEx *iface)
+{
+    struct capture_source *source = impl_from_IMFMediaSourceEx(iface);
+    struct capture_stream *stream;
+    HANDLE thread;
+    unsigned int i;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUTDOWN)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    if (source->state != CAPTURE_STARTED)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_INVALID_STATE_TRANSITION;
+    }
+    thread = source->thread;
+    source->thread = NULL;
+    source->state = CAPTURE_STOPPED;
+    stream = source->stream;
+    IMFMediaStream_AddRef(&stream->IMFMediaStream_iface);
+    stream->active = FALSE;
+    for (i = 0; i < stream->token_count; ++i)
+        if (stream->tokens[i]) IUnknown_Release(stream->tokens[i]);
+    stream->token_count = 0;
+    LeaveCriticalSection(&source->cs);
+
+    capture_halt(source, thread);
+
+    IMFMediaEventQueue_QueueEventParamVar(stream->event_queue, MEStreamStopped, &GUID_NULL, S_OK, NULL);
+    IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStopped, &GUID_NULL, S_OK, NULL);
+    IMFMediaStream_Release(&stream->IMFMediaStream_iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI capture_source_Pause(IMFMediaSourceEx *iface)
+{
+    struct capture_source *source = impl_from_IMFMediaSourceEx(iface);
+    HRESULT hr;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    /* a live camera cannot be paused (its characteristics do not include MFMEDIASOURCE_CAN_PAUSE) */
+    hr = source->state == CAPTURE_SHUTDOWN ? MF_E_SHUTDOWN : MF_E_INVALID_STATE_TRANSITION;
+#ifdef SG_MUTANT_VC_PAUSEOK
+    if (hr == MF_E_INVALID_STATE_TRANSITION) hr = S_OK;
+#endif
+    LeaveCriticalSection(&source->cs);
+    return hr;
+}
+
+static HRESULT WINAPI capture_source_Shutdown(IMFMediaSourceEx *iface)
+{
+    struct capture_source *source = impl_from_IMFMediaSourceEx(iface);
+    struct capture_stream *stream;
+    HANDLE thread;
+    unsigned int i;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == CAPTURE_SHUTDOWN)
+    {
+        LeaveCriticalSection(&source->cs);
+        return MF_E_SHUTDOWN;
+    }
+    thread = source->thread;
+    source->thread = NULL;
+    source->state = CAPTURE_SHUTDOWN;
+    stream = source->stream;
+    stream->active = FALSE;
+    for (i = 0; i < stream->token_count; ++i)
+        if (stream->tokens[i]) IUnknown_Release(stream->tokens[i]);
+    stream->token_count = 0;
+    LeaveCriticalSection(&source->cs);
+
+    capture_halt(source, thread);
+    capture_close(source);
+
+    IMFMediaEventQueue_Shutdown(stream->event_queue);
+    IMFMediaEventQueue_Shutdown(source->event_queue);
+
+    /* the source gives up its stream: the stream holds the source, so the pair is freed when the
+     * application lets go of the stream */
+    EnterCriticalSection(&source->cs);
+    source->stream = NULL;
+    LeaveCriticalSection(&source->cs);
+    IMFMediaStream_Release(&stream->IMFMediaStream_iface);
+    return S_OK;
+}
