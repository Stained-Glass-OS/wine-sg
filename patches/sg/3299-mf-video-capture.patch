+static const IMFMediaSourceExVtbl capture_source_vtbl =
+{
+    capture_source_QueryInterface,
+    capture_source_AddRef,
+    capture_source_Release,
+    capture_source_GetEvent,
+    capture_source_BeginGetEvent,
+    capture_source_EndGetEvent,
+    capture_source_QueueEvent,
+    capture_source_GetCharacteristics,
+    capture_source_CreatePresentationDescriptor,
+    capture_source_Start,
+    capture_source_Stop,
+    capture_source_Pause,
+    capture_source_Shutdown,
+    capture_source_GetSourceAttributes,
+    capture_source_GetStreamAttributes,
+    capture_source_SetD3DManager,
+};
+
+static unsigned int default_type_index(struct capture_source *source)
+{
+    unsigned int i;
+
+    /* 640x480 at 30 frames per second in YUY2 when the camera has it, else its first mode */
+    for (i = 0; i < source->type_count; ++i)
+        if (type_describes(source->types[i], &MFVideoFormat_YUY2, 640, 480, 30, 1))
+            return i;
+    return 0;
+}
+
+/* the source of one camera, the symbolic link is what enumeration gave */
+HRESULT WINAPI winegstreamer_create_video_capture_source(const WCHAR *link, IMFAttributes *activate_attributes,
+        IMFMediaSource **out)
+{
+    struct wg_capture_formats_params params = {0};
+    struct capture_source *source;
+    struct capture_stream *stream;
+    IMFMediaTypeHandler *handler;
+    struct sg_vidcap_device *devices = NULL;
+    UINT32 count = 0, i;
+    WCHAR *name = NULL;
+    HRESULT hr;
+
+    TRACE("%s, %p, %p.\n", debugstr_w(link), activate_attributes, out);
+
+    if (!link || !out)
+        return E_POINTER;
+    *out = NULL;
+
+    if (FAILED(hr = winegstreamer_enum_video_capture_devices(&devices, &count)))
+        return hr;
+    for (i = 0; i < count; ++i)
+        if (!wcscmp(devices[i].link, link))
+            break;
+    if (i == count)
+    {
+        CoTaskMemFree(devices);
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    }
+    name = wcsdup(devices[i].name);
+    WideCharToMultiByte(CP_UTF8, 0, devices[i].link, -1, params.path, sizeof(params.path), NULL, NULL);
+    CoTaskMemFree(devices);
+
+    if (FAILED(hr = capture_call(unix_wg_capture_get_formats, &params)))
+    {
+        free(name);
+        return hr == HRESULT_FROM_NT(STATUS_NO_SUCH_DEVICE) ? HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND) : hr;
+    }
+
+    if (!(source = calloc(1, sizeof(*source))))
+    {
+        free(name);
+        return E_OUTOFMEMORY;
+    }
+    source->IMFMediaSourceEx_iface.lpVtbl = &capture_source_vtbl;
+    source->refcount = 1;
+    strcpy(source->path, params.path);
+    InitializeCriticalSectionEx(&source->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    source->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": cs");
+
+    source->format_count = params.count;
+    source->formats = malloc(params.count * sizeof(*source->formats));
+    source->types = calloc(params.count * 2, sizeof(*source->types));
+    if (!source->formats || !source->types)
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    memcpy(source->formats, params.formats, params.count * sizeof(*source->formats));
+    for (i = 0; i < params.count * 2; ++i)
+    {
+        if (FAILED(hr = create_capture_media_type(&source->formats[i / 2],
+                (i & 1) ? WG_CAPTURE_SUBTYPE_NV12 : WG_CAPTURE_SUBTYPE_YUY2, &source->types[i])))
+            goto fail;
+        source->type_count++;
+    }
+
+    if (FAILED(hr = MFCreateEventQueue(&source->event_queue))
+            || FAILED(hr = MFCreateAttributes(&source->attributes, 4))
+            || FAILED(hr = MFCreateStreamDescriptor(0, source->type_count, source->types, &source->sd))
+            || FAILED(hr = MFCreatePresentationDescriptor(1, &source->sd, &source->pd))
+            || FAILED(hr = IMFPresentationDescriptor_SelectStream(source->pd, 0)))
+        goto fail;
+
+    IMFAttributes_SetGUID(source->attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE,
+            &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID);
+    IMFAttributes_SetString(source->attributes, &MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME, name);
+    IMFAttributes_SetString(source->attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK, link);
+
+    if (SUCCEEDED(IMFStreamDescriptor_GetMediaTypeHandler(source->sd, &handler)))
+    {
+        IMFMediaTypeHandler_SetCurrentMediaType(handler, source->types[default_type_index(source)]);
+        IMFMediaTypeHandler_Release(handler);
+    }
+    /* the presentation descriptor shares the stream descriptor: its clones carry the current type */
+
+    if (!(stream = calloc(1, sizeof(*stream))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    stream->IMFMediaStream_iface.lpVtbl = &capture_stream_vtbl;
+    stream->refcount = 1;
+    stream->source = source;
+    if (FAILED(hr = MFCreateEventQueue(&stream->event_queue)))
+    {
+        free(stream);
+        goto fail;
+    }
+    IMFMediaSourceEx_AddRef(&source->IMFMediaSourceEx_iface);
+    source->stream = stream;
+
+    free(name);
+    *out = (IMFMediaSource *)&source->IMFMediaSourceEx_iface;
+    TRACE("Created capture source %p for %s.\n", source, debugstr_a(source->path));
+    return S_OK;
+
+fail:
+    free(name);
+    IMFMediaSourceEx_Release(&source->IMFMediaSourceEx_iface);
+    return hr;
+}
