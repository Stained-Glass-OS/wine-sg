diff --git a/dlls/winegstreamer/capture_source.c b/dlls/winegstreamer/capture_source.c
new file mode 100644
index 0000000..b16eb8a
--- /dev/null
+++ b/dlls/winegstreamer/capture_source.c
@@ -0,0 +1,986 @@
+/* Media Foundation video capture source (V4L2 cameras through GStreamer)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "gst_private.h"
+#include "winternl.h"
+
+#include "mfapi.h"
+#include "mferror.h"
+#include "mfidl.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+
+/* shared with mf.dll's MFEnumDeviceSources */
+struct sg_vidcap_device
+{
+    WCHAR link[64];
+    WCHAR name[128];
+};
+
+enum capture_state
+{
+    CAPTURE_STOPPED,
+    CAPTURE_STARTED,
+    CAPTURE_SHUTDOWN,
+};
+
+struct capture_source;
+
+struct capture_stream
+{
+    IMFMediaStream IMFMediaStream_iface;
+    LONG refcount;
+    struct capture_source *source;
+    IMFMediaEventQueue *event_queue;
+    IUnknown **tokens;      /* outstanding sample requests (a request without token is a NULL entry) */
+    unsigned int token_count;
+    size_t token_capacity;
+    BOOL active;
+};
+
+struct capture_source
+{
+    IMFMediaSourceEx IMFMediaSourceEx_iface;
+    LONG refcount;
+    IMFMediaEventQueue *event_queue;
+    IMFAttributes *attributes;
+    IMFPresentationDescriptor *pd;
+    IMFStreamDescriptor *sd;
+    struct capture_stream *stream;
+    CRITICAL_SECTION cs;
+    enum capture_state state;
+    BOOL stream_announced;
+
+    char path[64];
+    struct wg_capture_format *formats;
+    unsigned int format_count;
+    /* the types offered, two (YUY2, NV12) for each format */
+    IMFMediaType **types;
+    unsigned int type_count;
+
+    wg_capture_t capture;
+    unsigned int capture_type;      /* index in types the open capture was made for */
+    UINT32 frame_size;
+    HANDLE thread;
+    LONG stop_thread;
+};
+
+static struct capture_source *impl_from_IMFMediaSourceEx(IMFMediaSourceEx *iface)
+{
+    return CONTAINING_RECORD(iface, struct capture_source, IMFMediaSourceEx_iface);
+}
+
+static struct capture_stream *impl_from_IMFMediaStream(IMFMediaStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct capture_stream, IMFMediaStream_iface);
+}
+
+/* ---- the unix side ---- */
+
+static HRESULT capture_call(unsigned int code, void *params)
+{
+    NTSTATUS status;
+
+    if (!init_gstreamer())
+        return E_FAIL;
+    status = WINE_UNIX_CALL(code, params);
+
+    if (status == STATUS_NO_MEMORY) return E_OUTOFMEMORY;
+    return status ? HRESULT_FROM_NT(status) : S_OK;
+}
+
+/* the devices, for mf.dll: an array of sg_vidcap_device in CoTaskMem */
+HRESULT WINAPI winegstreamer_enum_video_capture_devices(struct sg_vidcap_device **devices, UINT32 *count)
+{
+    struct wg_capture_enum_params params = {0};
+    HRESULT hr;
+    UINT32 i;
+
+    TRACE("%p, %p.\n", devices, count);
+
+    if (!devices || !count)
+        return E_POINTER;
+    *devices = NULL;
+    *count = 0;
+
+    if (FAILED(hr = capture_call(unix_wg_capture_enum, &params)))
+        return hr;
+    if (!params.count)
+        return S_OK;
+
+    if (!(*devices = CoTaskMemAlloc(params.count * sizeof(**devices))))
+        return E_OUTOFMEMORY;
+    memset(*devices, 0, params.count * sizeof(**devices));
+    for (i = 0; i < params.count; ++i)
+    {
+        MultiByteToWideChar(CP_UTF8, 0, params.devices[i].path, -1, (*devices)[i].link, ARRAY_SIZE((*devices)[i].link));
+        MultiByteToWideChar(CP_UTF8, 0, params.devices[i].name, -1, (*devices)[i].name, ARRAY_SIZE((*devices)[i].name));
+    }
+    *count = params.count;
+    return S_OK;
+}
+
+static HRESULT create_capture_media_type(const struct wg_capture_format *format, unsigned int subtype,
+        IMFMediaType **type)
+{
+    const GUID *guid = subtype == WG_CAPTURE_SUBTYPE_NV12 ? &MFVideoFormat_NV12 : &MFVideoFormat_YUY2;
+    UINT32 stride = subtype == WG_CAPTURE_SUBTYPE_NV12 ? format->width : format->width * 2;
+    UINT32 size = subtype == WG_CAPTURE_SUBTYPE_NV12 ? format->width * format->height * 3 / 2
+            : format->width * format->height * 2;
+    IMFMediaType *mt;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&mt)))
+        return hr;
+
+    IMFMediaType_SetGUID(mt, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+    IMFMediaType_SetGUID(mt, &MF_MT_SUBTYPE, guid);
+    IMFMediaType_SetUINT64(mt, &MF_MT_FRAME_SIZE, ((UINT64)format->width << 32) | format->height);
+    IMFMediaType_SetUINT64(mt, &MF_MT_FRAME_RATE, ((UINT64)format->fps_num << 32) | format->fps_den);
+    IMFMediaType_SetUINT64(mt, &MF_MT_FRAME_RATE_RANGE_MAX, ((UINT64)format->fps_num << 32) | format->fps_den);
+    IMFMediaType_SetUINT64(mt, &MF_MT_FRAME_RATE_RANGE_MIN, ((UINT64)format->fps_num << 32) | format->fps_den);
+    IMFMediaType_SetUINT64(mt, &MF_MT_PIXEL_ASPECT_RATIO, ((UINT64)1 << 32) | 1);
+    IMFMediaType_SetUINT32(mt, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+    IMFMediaType_SetUINT32(mt, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1);
+    IMFMediaType_SetUINT32(mt, &MF_MT_FIXED_SIZE_SAMPLES, 1);
+    IMFMediaType_SetUINT32(mt, &MF_MT_DEFAULT_STRIDE, stride);
+    IMFMediaType_SetUINT32(mt, &MF_MT_SAMPLE_SIZE, size);
+
+    *type = mt;
+    return S_OK;
+}
+
+static BOOL type_matches(IMFMediaType *type, IMFMediaType *other)
+{
+    DWORD flags = 0;
+
+    if (!type || !other) return FALSE;
+    return IMFMediaType_IsEqual(type, other, &flags) == S_OK
+            || (flags & (MF_MEDIATYPE_EQUAL_MAJOR_TYPES | MF_MEDIATYPE_EQUAL_FORMAT_TYPES
+            | MF_MEDIATYPE_EQUAL_FORMAT_DATA)) == (MF_MEDIATYPE_EQUAL_MAJOR_TYPES
+            | MF_MEDIATYPE_EQUAL_FORMAT_TYPES | MF_MEDIATYPE_EQUAL_FORMAT_DATA);
+}
+
+static BOOL type_describes(IMFMediaType *type, REFGUID subtype, UINT32 w, UINT32 h, UINT32 fn, UINT32 fd)
+{
+    UINT64 size, rate;
+    GUID guid;
+
+    if (FAILED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &guid)) || !IsEqualGUID(&guid, subtype))
+        return FALSE;
+    if (FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_SIZE, &size)) || size != (((UINT64)w << 32) | h))
+        return FALSE;
+    if (FAILED(IMFMediaType_GetUINT64(type, &MF_MT_FRAME_RATE, &rate)))
+        return FALSE;
+    return (rate >> 32) * fd == (UINT32)rate * (UINT64)fn;
+}
+
+static HRESULT capture_open(struct capture_source *source, unsigned int type_index)
+{
+    unsigned int format_index = type_index / 2;
+    struct wg_capture_create_params params = {0};
+    HRESULT hr;
+
+    params.subtype = (type_index & 1) ? WG_CAPTURE_SUBTYPE_NV12 : WG_CAPTURE_SUBTYPE_YUY2;
+    strcpy(params.path, source->path);
+    params.width = source->formats[format_index].width;
+    params.height = source->formats[format_index].height;
+    params.fps_num = source->formats[format_index].fps_num;
+    params.fps_den = source->formats[format_index].fps_den;
+    params.jpeg = source->formats[format_index].jpeg;
+
+    if (FAILED(hr = capture_call(unix_wg_capture_create, &params)))
+    {
+        WARN("Failed to open the capture device %s, hr %#lx.\n", debugstr_a(source->path), hr);
+        return hr;
+    }
+    source->capture = params.capture;
+    source->capture_type = type_index;
+    source->frame_size = params.frame_size;
+    return S_OK;
+}
