From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: Ignore hImportKey in BCryptImportKeyPair.

BCryptImportKeyPair ignores hImportKey ("This parameter is not currently used
and should be NULL") instead of failing with STATUS_NOT_IMPLEMENTED: no key
pair blob is encrypted.

Gate: test/bcrypt-importpair-gate.sh (64/32).
---
 dlls/bcrypt/bcrypt_main.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 2ef24e9..bb6de88 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -2169,11 +2169,12 @@ NTSTATUS WINAPI BCryptImportKeyPair( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY_HANDLE
     if (!alg) return STATUS_INVALID_HANDLE;
     if (!ret_handle || !input || !(type = resolve_blob_type( type, input, input_len )))
         return STATUS_INVALID_PARAMETER;
-    if (decrypt_key_handle)
-    {
-        FIXME( "decryption of key not yet supported\n" );
-        return STATUS_NOT_IMPLEMENTED;
-    }
+    /* "This parameter is not currently used and should be NULL": no key
+     * pair blob is encrypted */
+#ifdef SG_MUTANT_IMPORTPAIR_KEY_NOTIMPL
+    if (decrypt_key_handle) return STATUS_NOT_IMPLEMENTED;
+#endif
+    if (decrypt_key_handle) TRACE( "ignoring import key %p\n", decrypt_key_handle );
 
     if ((status = key_import_pair( alg, type, ret_handle, input, input_len ))) return status;
     TRACE( "returning handle %p\n", *ret_handle );
