+/* is unix_fd the same file as fd? */
+int sg_fd_is_same_file( struct fd *fd, int unix_fd )
+{
+    struct stat st;
+
+    if (!fd->inode || fstat( unix_fd, &st ) == -1) return 0;
+    return st.st_dev == fd->inode->device->dev && st.st_ino == fd->inode->ino;
