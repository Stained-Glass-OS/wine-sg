+static void sg_queue_client_unlink( struct inode *inode, const char *name )
+{
+    struct sg_client_unlink rec;
+    data_size_t len = strlen( name ), size = (sizeof(rec) + len + 7) & ~7;
+    char *buf;
+
+    if (!(buf = realloc( sg_unlinks, sg_unlinks_size + size ))) return;
+    memset( &rec, 0, sizeof(rec) );
+    rec.dev     = inode->device->dev;
+    rec.ino     = inode->ino;
+    rec.namelen = len;
+    memset( buf + sg_unlinks_size, 0, size );
+    memcpy( buf + sg_unlinks_size, &rec, sizeof(rec) );
+    memcpy( buf + sg_unlinks_size + sizeof(rec), name, len );
+    sg_unlinks = buf;
+    sg_unlinks_size += size;
+}
+
+/* drop anything queued outside a close_handle request */
+void sg_discard_client_unlinks(void)
+{
+    free( sg_unlinks );
+    sg_unlinks = NULL;
+    sg_unlinks_size = 0;
+}
