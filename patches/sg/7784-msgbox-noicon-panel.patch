From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: a message box without an icon has its white panel and no empty icon

A message box without an icon had a white panel a few pixels high. The
text ran onto the grey button strip as a white band, and the empty icon
control drew a white square on the strip. LibreHardwareMonitor's first
box showed it. Now the box has no icon control then, the panel is at
least an icon's height, and the text ends above the strip, also when it
has several lines.
---
diff --git a/dlls/user32/msgbox.c b/dlls/user32/msgbox.c
index 56d3a42..7f8a784 100644
--- a/dlls/user32/msgbox.c
+++ b/dlls/user32/msgbox.c
@@ -66,7 +66,7 @@ static void MSGBOX_OnInit(HWND hwnd, LPMSGBOXPARAMSW lpmb)
     HDC hdc;
     int i, buttons;
     int bspace, bw, bh, theight, tleft, wwidth, wheight, wleft, wtop, bpos;
-    int borheight, borwidth, iheight, ileft, iwidth, twidth, tiheight;
+    int borheight, borwidth, iheight, ileft, iwidth, twidth, tiheight, imin = 0;
     NONCLIENTMETRICSW nclm;
     HMONITOR monitor;
     MONITORINFO mon_info;
@@ -232,6 +232,17 @@ static void MSGBOX_OnInit(HWND hwnd, LPMSGBOXPARAMSW lpmb)
     iheight = rect.bottom - rect.top;
     ileft = rect.left;
     iwidth = rect.right - ileft;
+#ifndef SG_MUTANT_MSGBOX_NOICON_PANEL
+    /* Stained Glass OS: without an icon there is no icon control (it drew an
+     * empty square of the window colour on the button strip), and the
+     * message still has the white panel an icon's height gives it: the panel
+     * was a few pixels high and the text ran onto the strip */
+    if (!(lpmb->dwStyle & MB_ICONMASK))
+    {
+        NtUserShowWindow( GetDlgItem(hwnd, MSGBOX_IDICON), SW_HIDE );
+        imin = GetSystemMetrics( SM_CYICON );
+    }
+#endif
 
     hdc = NtUserGetDC(hwnd);
     hPrevFont = SelectObject( hdc, (HFONT)SendMessageW( hwnd, WM_GETFONT, 0, 0 ));
@@ -277,7 +288,13 @@ static void MSGBOX_OnInit(HWND hwnd, LPMSGBOXPARAMSW lpmb)
     SelectObject(hdc, hPrevFont);
     NtUserReleaseDC( hwnd, hdc );
 
+#ifndef SG_MUTANT_MSGBOX_NOICON_PANEL
+    /* the strip begins 11 px above the buttons (MSGBOX_DlgProc): the text
+     * ends above it, with 12 px (at 96 dpi) above and below it */
+    tiheight = 2 * MulDiv( 12, GetDpiForWindow( hwnd ), 96 ) + max(max(iheight, imin), theight);
+#else
     tiheight = 16 + max(iheight, theight);
+#endif
     wwidth  = tleft + twidth + ileft + borwidth;
     wheight = 8 + tiheight + bh + borheight;
 
