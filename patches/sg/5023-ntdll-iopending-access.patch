From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Check access for ThreadIsIoPending.

NtQueryInformationThread(ThreadIsIoPending) checks that the handle has
THREAD_QUERY_INFORMATION, so a THREAD_QUERY_LIMITED_INFORMATION handle gets
STATUS_ACCESS_DENIED as on Windows (kernel32 thread test; a todo_wine
removed). The flag itself is still always FALSE (FIXME kept).

Gate: test/ntdll-iopending-gate.sh (64/32).
---
 dlls/kernel32/tests/thread.c |  1 -
 dlls/ntdll/unix/thread.c     | 11 +++++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/dlls/kernel32/tests/thread.c b/dlls/kernel32/tests/thread.c
index d37253f..9f38344 100644
--- a/dlls/kernel32/tests/thread.c
+++ b/dlls/kernel32/tests/thread.c
@@ -2343,7 +2343,6 @@ static void test_thread_info(void)
             break;
 
         case ThreadIsIoPending:
-            todo_wine
             ok(status == STATUS_ACCESS_DENIED, "for info %lu expected STATUS_ACCESS_DENIED, got %08lx (ret_len %lu)\n", i, status, ret_len);
             break;
 
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index c083480..b4224c6 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -2324,6 +2324,17 @@ NTSTATUS WINAPI NtQueryInformationThread( HANDLE handle, THREADINFOCLASS class,
         FIXME( "ThreadIsIoPending info class not supported yet\n" );
         if (length != sizeof(BOOL)) return STATUS_INFO_LENGTH_MISMATCH;
         if (!data) return STATUS_ACCESS_DENIED;
+#ifndef SG_MUTANT_IOPENDING_NO_ACCESS
+        /* the handle needs THREAD_QUERY_INFORMATION, as on Windows */
+        SERVER_START_REQ( get_thread_info )
+        {
+            req->handle = wine_server_obj_handle( handle );
+            req->access = THREAD_QUERY_INFORMATION;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        if (status) return status;
+#endif
         *(BOOL*)data = FALSE;
         if (ret_len) *ret_len = sizeof(BOOL);
         return STATUS_SUCCESS;
