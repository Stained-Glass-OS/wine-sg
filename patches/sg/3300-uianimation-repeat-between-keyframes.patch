From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Thu, 15 Oct 2026 02:12:38 -0700
Subject: [PATCH] uianimation: RepeatBetweenKeyframes loops, Conclude (3300)

IUIAnimationStoryboard::RepeatBetweenKeyframes played the storyboard once
(FIXME). A storyboard now keeps its loops: the layout between two
keyframes plays again the given number of times before the rest (time into
the storyboard maps to a time in the layout; an indefinite loop, count -1,
goes on until the storyboard is concluded or truncated, then finishes the
pass it is in). Finish, FinishAllStoryboards and GetFinalValue take an
indefinite loop as ended after its first pass. Errors as documented:
UI_E_START_KEYFRAME_AFTER_END, UI_E_END_KEYFRAME_NOT_DETERMINED (the end
depends on a transition whose duration is known only when it starts),
UI_E_LOOPS_OVERLAP, UI_E_STORYBOARD_ACTIVE, E_INVALIDARG. Conclude, a
no-op before, ends indefinite loops.

Test: test/fastuiarepeat-gate.sh (mutants SG_MUTANT_UIA_*).

diff --git a/dlls/uianimation/main.c b/dlls/uianimation/main.c
index 7e5f728..837bb80 100644
--- a/dlls/uianimation/main.c
+++ b/dlls/uianimation/main.c
@@ -510,6 +510,13 @@ struct sb_keyframe
     UI_ANIMATION_SECONDS time;
 };
 
+struct sb_loop
+{
+    int start_key, end_key;
+    INT32 count;                        /* repetitions, or UI_ANIMATION_REPEAT_INDEFINITELY */
+    UI_ANIMATION_SECONDS ts, te;        /* where the loop is in the layout */
+};
+
 struct animation_storyboard
 {
     IUIAnimationStoryboard IUIAnimationStoryboard_iface;
@@ -521,7 +528,11 @@ struct animation_storyboard
     unsigned int item_count, item_size;
     struct sb_keyframe *keys;           /* keys[0] is the start */
     unsigned int key_count, key_size;
-    UI_ANIMATION_SECONDS start_time, end, elapsed;
+    struct sb_loop *loops;              /* sorted by ts once resolved */
+    unsigned int loop_count, loop_size;
+    BOOL concluded;                     /* indefinite loops finish their iteration */
+    UI_ANIMATION_SECONDS conclude_time; /* when, into the storyboard */
+    UI_ANIMATION_SECONDS start_time, end, elapsed;   /* end: the layout's, without repetitions */
     IUnknown *tag_object;
     UINT32 tag_id;
     IUIAnimationStoryboardEventHandler *handler;
@@ -712,6 +723,82 @@ static void storyboard_stop( struct animation_storyboard *sb, UI_ANIMATION_STORY
     IUIAnimationStoryboard_Release( &sb->IUIAnimationStoryboard_iface );   /* the manager's */
 }
 
+/* Loops: the storyboard plays the layout between two keyframes again some
+ * number of times before the rest. Time into the storyboard (virtual) maps
+ * to a time in the layout; every pass of a loop shows the layout from its
+ * start. An indefinite loop goes on until the storyboard is concluded (or
+ * truncated), then finishes the pass it is in. */
+
+/* how many more passes a loop makes, given where it starts in virtual time */
+static double loop_passes( struct animation_storyboard *sb, struct sb_loop *loop, UI_ANIMATION_SECONDS vstart )
+{
+    UI_ANIMATION_SECONDS len = loop->te - loop->ts;
+
+    if (loop->count >= 0) return loop->count;
+    if (!sb->concluded) return INFINITY;
+    if (sb->conclude_time <= vstart) return 0;
+    return floor( (sb->conclude_time - vstart) / len );
+}
+
+static UI_ANIMATION_SECONDS storyboard_map_time( struct animation_storyboard *sb, UI_ANIMATION_SECONDS t )
+{
+    UI_ANIMATION_SECONDS shift = 0;
+    unsigned int i;
+
+    for (i = 0; i < sb->loop_count; i++)
+    {
+        struct sb_loop *loop = &sb->loops[i];
+        UI_ANIMATION_SECONDS len = loop->te - loop->ts, v = t - shift;
+        double passes;
+
+        if (len <= 0 || !loop->count) continue;
+#ifdef SG_MUTANT_UIA_NOLOOP
+        continue;
+#endif
+        if (v < loop->te) break;
+        passes = loop_passes( sb, loop, loop->ts + shift );
+        if (v < loop->te + passes * len) return loop->ts + fmod( v - loop->ts, len );
+#ifndef SG_MUTANT_UIA_NOSHIFT
+        shift += passes * len;
+#endif
+    }
+    return t - shift;
+}
+
+/* the storyboard's length with its repetitions: infinite while a loop is open */
+static UI_ANIMATION_SECONDS storyboard_total( struct animation_storyboard *sb )
+{
+    UI_ANIMATION_SECONDS shift = 0;
+    unsigned int i;
+
+    for (i = 0; i < sb->loop_count; i++)
+    {
+        struct sb_loop *loop = &sb->loops[i];
+        UI_ANIMATION_SECONDS len = loop->te - loop->ts;
+
+        if (len <= 0 || !loop->count) continue;
+        shift += loop_passes( sb, loop, loop->ts + shift ) * len;
+    }
+    return sb->end + shift;
+}
+
+/* the time into the storyboard now, as far as the manager has been updated */
+static UI_ANIMATION_SECONDS storyboard_now( struct animation_storyboard *sb )
+{
+    if (sb->status != UI_ANIMATION_STORYBOARD_SCHEDULED && sb->status != UI_ANIMATION_STORYBOARD_PLAYING) return 0;
+    return max( 0, sb->manager->last_time - sb->start_time );
+}
+
+static void storyboard_conclude( struct animation_storyboard *sb )
+{
+#ifdef SG_MUTANT_UIA_NOCONCLUDE
+    return;
+#endif
+    if (sb->concluded) return;
+    sb->concluded = TRUE;
+    sb->conclude_time = storyboard_now( sb );
+}
+
 /* the value of a variable the storyboard animates, at a time into it */
 static BOOL storyboard_value( struct animation_storyboard *sb, struct animation_var *var,
                               UI_ANIMATION_SECONDS elapsed, double *value )
@@ -719,6 +806,7 @@ static BOOL storyboard_value( struct animation_storyboard *sb, struct animation_
     struct sb_item *item = NULL;
     unsigned int i;
 
+    elapsed = storyboard_map_time( sb, elapsed );
     for (i = 0; i < sb->item_count; i++)
     {
         struct sb_item *it = &sb->items[i];
@@ -740,8 +828,10 @@ static BOOL storyboard_advance( struct animation_storyboard *sb, UI_ANIMATION_SE
     unsigned int i, j;
     double value;
 
+    UI_ANIMATION_SECONDS total = storyboard_total( sb );
+
     if (elapsed < 0) elapsed = 0;
-    if (elapsed > sb->end) elapsed = sb->end;
+    if (elapsed > total) elapsed = total;
     sb->elapsed = elapsed;
     for (i = 0; i < sb->item_count; i++)
     {
@@ -759,7 +849,7 @@ static BOOL storyboard_advance( struct animation_storyboard *sb, UI_ANIMATION_SE
         what.storyboard = &sb->IUIAnimationStoryboard_iface;
         notify_add( n, &what );
     }
-    return elapsed >= sb->end;
+    return elapsed >= total;
 }
 
 static void manager_update( struct manager *manager, UI_ANIMATION_SECONDS now, UI_ANIMATION_UPDATE_RESULT *result,
@@ -832,6 +922,7 @@ static ULONG WINAPI animation_storyboard_Release( IUIAnimationStoryboard *iface
         }
         free( This->items );
         free( This->keys );
+        free( This->loops );
         if (This->tag_object) IUnknown_Release( This->tag_object );
         if (This->handler) IUIAnimationStoryboardEventHandler_Release( This->handler );
         IUIAnimationManager_Release( &This->manager->IUIAnimationManager_iface );
@@ -993,11 +1084,144 @@ static HRESULT WINAPI animation_storyboard_AddTransitionBetweenKeyframes( IUIAni
     return hr;
 }
 
+/* How a storyboard's moments relate, without knowing what a transition's
+ * duration will be. A node is a keyframe (>= 0) or the end of an item (-1 - index). */
+static void item_duration_range( struct sb_item *item, double *lo, double *hi )
+{
+    switch (item->tr->kind)
+    {
+    case TR_LINEAR_FROM_SPEED:
+    case TR_PARABOLIC:
+    case TR_CUSTOM:
+        *lo = 0;                       /* known only once its initial value is */
+        *hi = INFINITY;
+        break;
+    default:
+        *lo = *hi = item->tr->duration;
+        break;
+    }
+}
+
+/* node - stop as a range; FALSE when node does not follow from stop (the range is then to the start) */
+static BOOL node_relative( struct animation_storyboard *sb, int node, int stop, double *lo, double *hi )
+{
+    int depth;
+
+    *lo = *hi = 0;
+    for (depth = 0; depth < 256; depth++)
+    {
+        if (node == stop) return TRUE;
+        if (node == 0) return FALSE;
+        if (node > 0)
+        {
+            struct sb_keyframe *kf = &sb->keys[node];
+            if (kf->after >= 0) node = -1 - kf->after;
+            else
+            {
+                *lo += kf->offset;
+                *hi += kf->offset;
+                node = kf->base;
+            }
+        }
+        else
+        {
+            struct sb_item *item = &sb->items[-1 - node];
+            double dlo, dhi;
+
+            if (item->end_key >= 0) { node = item->end_key; continue; }
+            item_duration_range( item, &dlo, &dhi );
+            *lo += dlo;
+            *hi += dhi;
+            node = item->after >= 0 ? -1 - item->after : item->start_key;
+        }
+    }
+    return FALSE;
+}
+
+/* TRUE when a moment is certainly not before another */
+static BOOL key_not_before( struct animation_storyboard *sb, int later, int earlier )
+{
+    double lo, hi, lo_e, hi_e;
+
+    if (node_relative( sb, later, earlier, &lo, &hi )) return lo >= 0;
+    node_relative( sb, earlier, 0, &lo_e, &hi_e );
+    node_relative( sb, later, 0, &lo, &hi );
+    return lo >= hi_e;
+}
+
 static HRESULT WINAPI animation_storyboard_RepeatBetweenKeyframes( IUIAnimationStoryboard *iface,
         UI_ANIMATION_KEYFRAME start_key, UI_ANIMATION_KEYFRAME end_key, INT32 count )
 {
-    FIXME( "(%p)->(%p, %p, %d): played once\n", iface, start_key, end_key, count );
-    return S_OK;
+    struct animation_storyboard *This = impl_from_IUIAnimationStoryboard( iface );
+    struct sb_loop *loop;
+    double lo, hi, lo2, hi2;
+    HRESULT hr = S_OK;
+    unsigned int i;
+    int start, end;
+
+    TRACE( "(%p)->(%p, %p, %d)\n", This, start_key, end_key, count );
+    EnterCriticalSection( &anim_cs );
+    if ((start = key_index( This, start_key )) < 0 || (end = key_index( This, end_key )) < 0 || count < -1)
+        hr = E_INVALIDARG;
+    else if (This->status != UI_ANIMATION_STORYBOARD_BUILDING)
+        hr = UI_E_STORYBOARD_ACTIVE;
+#ifndef SG_MUTANT_UIA_NOORDER
+    else if (!key_not_before( This, end, start ))
+        hr = UI_E_START_KEYFRAME_AFTER_END;
+#endif
+    else
+    {
+        /* the end must be a fixed time after the start (or both fixed from the beginning) */
+        BOOL known;
+        if (node_relative( This, end, start, &lo, &hi )) known = lo == hi;
+        else
+        {
+            node_relative( This, start, 0, &lo, &hi );
+            node_relative( This, end, 0, &lo2, &hi2 );
+            known = lo == hi && lo2 == hi2;
+        }
+#ifdef SG_MUTANT_UIA_NODETERM
+        known = TRUE;
+#endif
+        if (!known) hr = UI_E_END_KEYFRAME_NOT_DETERMINED;
+    }
+    if (hr == S_OK)
+    {
+        for (i = 0; i < This->loop_count; i++)
+        {
+            struct sb_loop *other = &This->loops[i];
+            if (!key_not_before( This, start, other->end_key ) && !key_not_before( This, other->start_key, end )
+#ifdef SG_MUTANT_UIA_NOOVERLAP
+                && 0
+#endif
+                )
+            {
+                hr = UI_E_LOOPS_OVERLAP;
+                break;
+            }
+        }
+    }
+    if (hr == S_OK && This->loop_count == This->loop_size)
+    {
+        unsigned int size = max( 4, This->loop_size * 2 );
+        struct sb_loop *loops = realloc( This->loops, size * sizeof(*loops) );
+        if (!loops) hr = E_OUTOFMEMORY;
+        else
+        {
+            This->loops = loops;
+            This->loop_size = size;
+        }
+    }
+    if (hr == S_OK)
+    {
+        loop = &This->loops[This->loop_count++];
+        memset( loop, 0, sizeof(*loop) );
+        loop->start_key = start;
+        loop->end_key = end;
+        loop->count = count;
+    }
+    LeaveCriticalSection( &anim_cs );
+    return hr;
 }
 
 static HRESULT WINAPI animation_storyboard_HoldVariable( IUIAnimationStoryboard *iface, IUIAnimationVariable *variable )
@@ -1064,6 +1288,22 @@ static void storyboard_resolve( struct animation_storyboard *sb )
         sb->keys[i].time = resolve_key( sb, i, 0 );
         if (sb->keys[i].time > sb->end) sb->end = sb->keys[i].time;
     }
+    for (i = 0; i < sb->loop_count; i++)
+    {
+        struct sb_loop *loop = &sb->loops[i];
+        loop->ts = resolve_key( sb, loop->start_key, 0 );
+        loop->te = resolve_key( sb, loop->end_key, 0 );
+        if (loop->te < loop->ts) loop->te = loop->ts;
+    }
+    /* by where they start (insertion sort: a few at most) */
+    for (i = 1; i < sb->loop_count; i++)
+    {
+        struct sb_loop tmp = sb->loops[i];
+        for (j = i; j > 0 && sb->loops[j - 1].ts > tmp.ts; j--) sb->loops[j] = sb->loops[j - 1];
+        sb->loops[j] = tmp;
+    }
+    sb->concluded = FALSE;
+    sb->conclude_time = 0;
 }
 
 static HRESULT storyboard_schedule( struct animation_storyboard *sb, UI_ANIMATION_SECONDS now,
@@ -1093,7 +1333,14 @@ static HRESULT storyboard_schedule( struct animation_storyboard *sb, UI_ANIMATIO
         sb->items[i].var->storyboard = NULL;
         for (j = 0; j < other->item_count; j++) if (other->items[j].live) left = TRUE;
         if (!left) storyboard_stop( other, UI_ANIMATION_STORYBOARD_CANCELLED, n );
-        else storyboard_set_status( other, UI_ANIMATION_STORYBOARD_TRUNCATED, n );
+        else
+        {
+            /* a truncated storyboard that loops indefinitely ends its loop */
+#ifndef SG_MUTANT_UIA_NOTRUNC
+            storyboard_conclude( other );
+#endif
+            storyboard_set_status( other, UI_ANIMATION_STORYBOARD_TRUNCATED, n );
+        }
     }
     for (i = 0; i < sb->item_count; i++)
     {
@@ -1113,7 +1360,8 @@ static HRESULT storyboard_schedule( struct animation_storyboard *sb, UI_ANIMATIO
     if (manager->mode == UI_ANIMATION_MODE_DISABLED || sb->end <= 0)
     {
         storyboard_set_status( sb, UI_ANIMATION_STORYBOARD_PLAYING, n );
-        storyboard_advance( sb, sb->end, n );
+        storyboard_conclude( sb );
+        storyboard_advance( sb, storyboard_total( sb ), n );
         storyboard_stop( sb, UI_ANIMATION_STORYBOARD_FINISHED, n );
     }
     else if (now <= manager->last_time)
@@ -1141,7 +1389,12 @@ static HRESULT WINAPI animation_storyboard_Schedule( IUIAnimationStoryboard *ifa
 
 static HRESULT WINAPI animation_storyboard_Conclude( IUIAnimationStoryboard *iface )
 {
-    TRACE( "(%p)\n", iface );
+    struct animation_storyboard *This = impl_from_IUIAnimationStoryboard( iface );
+
+    TRACE( "(%p)\n", This );
+    EnterCriticalSection( &anim_cs );
+    storyboard_conclude( This );
+    LeaveCriticalSection( &anim_cs );
     return S_OK;
 }
 
@@ -1154,7 +1407,10 @@ static HRESULT WINAPI animation_storyboard_Finish( IUIAnimationStoryboard *iface
     EnterCriticalSection( &anim_cs );
     if (!list_empty( &This->entry ))
     {
-        storyboard_advance( This, This->end, &n );
+#ifndef SG_MUTANT_UIA_NOFINISH
+        storyboard_conclude( This );
+#endif
+        storyboard_advance( This, storyboard_total( This ), &n );
         storyboard_stop( This, UI_ANIMATION_STORYBOARD_FINISHED, &n );
     }
     LeaveCriticalSection( &anim_cs );
@@ -1347,7 +1603,21 @@ static double var_final( struct animation_var *var )
     struct animation_storyboard *sb = var->storyboard;
     double value = var->value;
 
-    if (sb && storyboard_value( sb, var, sb->end, &value )) return var_bound( var, value );
+    if (sb)
+    {
+        /* with its indefinite loops ended after their first pass */
+        BOOL concluded = sb->concluded, found;
+        UI_ANIMATION_SECONDS conclude_time = sb->conclude_time;
+
+#ifndef SG_MUTANT_UIA_NOFINAL
+        sb->concluded = TRUE;
+        sb->conclude_time = 0;
+#endif
+        found = storyboard_value( sb, var, storyboard_total( sb ), &value );
+        sb->concluded = concluded;
+        sb->conclude_time = conclude_time;
+        if (found) return var_bound( var, value );
+    }
     return var->value;
 }
 
@@ -1653,7 +1923,11 @@ static void manager_stop_all( struct manager *manager, BOOL finish, struct notif
 
     LIST_FOR_EACH_ENTRY_SAFE( sb, next, &manager->storyboards, struct animation_storyboard, entry )
     {
-        if (finish) storyboard_advance( sb, sb->end, n );
+        if (finish)
+        {
+            storyboard_conclude( sb );
+            storyboard_advance( sb, storyboard_total( sb ), n );
+        }
         storyboard_stop( sb, finish ? UI_ANIMATION_STORYBOARD_FINISHED : UI_ANIMATION_STORYBOARD_CANCELLED, n );
     }
 }
