-# @ stub EnumerateTraceGuidsEx
+@ stdcall -import EnumerateTraceGuidsEx(long ptr long ptr long ptr)
 @ stdcall -import EqualDomainSid(ptr ptr ptr)
 @ stdcall -import EqualPrefixSid(ptr ptr)
 @ stdcall -import EqualSid(ptr ptr)
