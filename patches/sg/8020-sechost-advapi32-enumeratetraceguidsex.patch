From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sechost, advapi32: EnumerateTraceGuidsEx

sechost's was a spec stub and advapi32 had no export at all: .NET's EventSource calls it (TraceGuidQueryInfo, through advapi32) when a session enables it, to learn which sessions do, and SG's ETW (StartTrace/EnableTraceEx2, the shared session table) has real sessions. As Learn gives the classes: TraceGuidQueryProcess, the providers this process registered (ntdll's list, through a private __wine_sg_etw_registered); TraceGuidQueryList, those and the providers the sessions enable; TraceGuidQueryInfo, a TRACE_GUID_INFO with this process's instance (TRACE_PROVIDER_INSTANCE_INFO, Pid) and a TRACE_ENABLE_INFO per session enabling it (logger id, level, keywords, enable property), ERROR_WMI_GUID_NOT_FOUND for a provider neither registered nor enabled. Other processes' registrations are not known here (only that they have providers), so they are not listed. ERROR_INSUFFICIENT_BUFFER with the length needed; other classes ERROR_NOT_SUPPORTED. evntrace.h gains the structures and the prototype.
---
--- a/include/evntrace.h
+++ b/include/evntrace.h
@@ -331,6 +331,32 @@
     MaxTraceSetInfoClass
 } TRACE_QUERY_INFO_CLASS, TRACE_INFO_CLASS;
 
+typedef struct _TRACE_ENABLE_INFO
+{
+    ULONG     IsEnabled;
+    UCHAR     Level;
+    UCHAR     Reserved1;
+    USHORT    LoggerId;
+    ULONG     EnableProperty;
+    ULONG     Reserved2;
+    ULONGLONG MatchAnyKeyword;
+    ULONGLONG MatchAllKeyword;
+} TRACE_ENABLE_INFO, *PTRACE_ENABLE_INFO;
+
+typedef struct _TRACE_PROVIDER_INSTANCE_INFO
+{
+    ULONG NextOffset;
+    ULONG EnableCount;
+    ULONG Pid;
+    ULONG Flags;
+} TRACE_PROVIDER_INSTANCE_INFO, *PTRACE_PROVIDER_INSTANCE_INFO;
+
+typedef struct _TRACE_GUID_INFO
+{
+    ULONG InstanceCount;
+    ULONG Reserved;
+} TRACE_GUID_INFO, *PTRACE_GUID_INFO;
+
 #define INVALID_PROCESSTRACE_HANDLE ((TRACEHANDLE)~(ULONG_PTR)0)
 
 ULONG WMIAPI CloseTrace(TRACEHANDLE);
@@ -349,6 +375,7 @@
 ULONG WMIAPI RemoveTraceCallback(LPCGUID);
 ULONG WMIAPI SetTraceCallback(LPCGUID,PEVENT_CALLBACK);
 ULONG WMIAPI EnableTraceEx2(TRACEHANDLE,LPCGUID,ULONG,UCHAR,ULONGLONG,ULONGLONG,ULONG,PENABLE_TRACE_PARAMETERS);
+ULONG WMIAPI EnumerateTraceGuidsEx(TRACE_QUERY_INFO_CLASS,PVOID,ULONG,PVOID,ULONG,PULONG);
 ULONG WMIAPI FlushTraceA(TRACEHANDLE,LPCSTR,PEVENT_TRACE_PROPERTIES);
 ULONG WMIAPI FlushTraceW(TRACEHANDLE,LPCWSTR,PEVENT_TRACE_PROPERTIES);
 #define      FlushTrace WINELIB_NAME_AW(FlushTrace)
--- a/dlls/ntdll/etw.c
+++ b/dlls/ntdll/etw.c
@@ -872,3 +872,31 @@
     va_end( valist );
     return ret;
 }
+
+/***********************************************************************
+ *           __wine_sg_etw_registered   (NTDLL.@)
+ *
+ * (wine-sg 8020) The provider GUIDs registered in this process (each once), for sechost's
+ * EnumerateTraceGuidsEx: up to count of them in guids; the number there are.
+ */
+ULONG CDECL __wine_sg_etw_registered( GUID *guids, ULONG count )
+{
+    struct etw_reg *reg, *other;
+    ULONG n = 0;
+
+    RtlEnterCriticalSection( &etw_cs );
+    LIST_FOR_EACH_ENTRY( reg, &registrations, struct etw_reg, entry )
+    {
+        BOOL seen = FALSE;
+        LIST_FOR_EACH_ENTRY( other, &registrations, struct etw_reg, entry )
+        {
+            if (other == reg) break;
+            if (IsEqualGUID( &other->guid, &reg->guid )) { seen = TRUE; break; }
+        }
+        if (seen) continue;
+        if (n < count) guids[n] = reg->guid;
+        n++;
+    }
+    RtlLeaveCriticalSection( &etw_cs );
+    return n;
+}
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -1774,6 +1774,7 @@
 @ cdecl wine_server_fd_to_handle(long long long ptr)
 @ cdecl wine_server_handle_to_fd(long long ptr ptr)
 @ cdecl __wine_sg_defender_scan(long ptr long ptr long)
+@ cdecl __wine_sg_etw_registered(ptr long)
 
 # Unix interface
 @ stdcall __wine_unix_spawnvp(long ptr)
--- a/dlls/sechost/trace.c
+++ b/dlls/sechost/trace.c
@@ -1399,6 +1399,121 @@
 }
 
 /******************************************************************************
+ *     EnumerateTraceGuidsEx   (sechost.@)
+ *
+ * (wine-sg 8020) The providers registered and what the sessions enable for them, as Learn gives the
+ * TraceGuidQueryList, TraceGuidQueryProcess and TraceGuidQueryInfo classes. A process's registrations
+ * are its own (ntdll's list): the list of all providers is this process's and those the sessions
+ * enable, and a provider's instances are this process's -- what an EventSource asks for (the sessions
+ * that enable it in its own process). Other classes are ERROR_NOT_SUPPORTED.
+ */
+ULONG CDECL __wine_sg_etw_registered( GUID *guids, ULONG count );
+
+static BOOL guid_in( const GUID *list, ULONG n, const GUID *guid )
+{
+    ULONG i;
+    for (i = 0; i < n; i++) if (IsEqualGUID( &list[i], guid )) return TRUE;
+    return FALSE;
+}
+
+ULONG WINAPI EnumerateTraceGuidsEx( TRACE_QUERY_INFO_CLASS class, void *in, ULONG in_size,
+                                    void *out, ULONG out_size, ULONG *ret_len )
+{
+    GUID *guids = NULL;
+    ULONG n = 0, own, size, i, s, p, enables = 0;
+    ULONG ret = ERROR_SUCCESS;
+
+    TRACE("%d, %p, %lu, %p, %lu, %p\n", class, in, in_size, out, out_size, ret_len);
+
+    if (!ret_len || (out_size && !out)) return ERROR_INVALID_PARAMETER;
+    if (class != TraceGuidQueryList && class != TraceGuidQueryInfo && class != TraceGuidQueryProcess)
+        return ERROR_NOT_SUPPORTED;
+    if (class == TraceGuidQueryInfo && (!in || in_size < sizeof(GUID))) return ERROR_INVALID_PARAMETER;
+    if (class != TraceGuidQueryInfo && (in || in_size)) return ERROR_INVALID_PARAMETER;
+
+    own = __wine_sg_etw_registered( NULL, 0 );
+    if (!(guids = malloc( (own + SG_ETW_MAX_SESSIONS * SG_ETW_MAX_PROVIDERS + 1) * sizeof(GUID) )))
+        return ERROR_OUTOFMEMORY;
+    n = min( own, __wine_sg_etw_registered( guids, own ) );
+
+    if (class == TraceGuidQueryList)
+    {
+        if (map_shared())
+        {
+            lock_shared();
+            for (s = 0; s < SG_ETW_MAX_SESSIONS; s++)
+            {
+                const struct sg_etw_session *session = &shared->sessions[s];
+                if (!session->in_use) continue;
+                for (p = 0; p < session->provider_count && p < SG_ETW_MAX_PROVIDERS; p++)
+                    if (!guid_in( guids, n, &session->providers[p].guid )) guids[n++] = session->providers[p].guid;
+            }
+            unlock_shared();
+        }
+    }
+    if (class != TraceGuidQueryInfo)
+    {
+        size = n * sizeof(GUID);
+        *ret_len = size;
+        if (out_size < size) ret = ERROR_INSUFFICIENT_BUFFER;
+        else memcpy( out, guids, size );
+        free( guids );
+        return ret;
+    }
+
+    {
+        const GUID *guid = in;
+        BOOL registered = guid_in( guids, n, guid );
+        TRACE_ENABLE_INFO info[SG_ETW_MAX_SESSIONS];
+        TRACE_GUID_INFO *guid_info = out;
+        TRACE_PROVIDER_INSTANCE_INFO *inst;
+
+        free( guids );
+        memset( info, 0, sizeof(info) );
+        if (map_shared())
+        {
+            lock_shared();
+            for (s = 0; s < SG_ETW_MAX_SESSIONS; s++)
+            {
+                const struct sg_etw_session *session = &shared->sessions[s];
+                if (!session->in_use) continue;
+                for (p = 0; p < session->provider_count && p < SG_ETW_MAX_PROVIDERS; p++)
+                {
+                    const struct sg_etw_provider *prov = &session->providers[p];
+                    if (!IsEqualGUID( &prov->guid, guid ) || enables >= ARRAY_SIZE(info)) continue;
+                    info[enables].IsEnabled = TRUE;
+                    info[enables].Level = prov->level;
+                    info[enables].LoggerId = session->logger_id;
+                    info[enables].EnableProperty = prov->enable_property;
+                    info[enables].MatchAnyKeyword = prov->any;
+                    info[enables].MatchAllKeyword = prov->all;
+                    enables++;
+                }
+            }
+            unlock_shared();
+        }
+#ifdef SG_MUTANT_NO_TRACE_GUID_INFO
+        registered = FALSE;
+#endif
+        if (!registered && !enables) return ERROR_WMI_GUID_NOT_FOUND;
+        size = sizeof(TRACE_GUID_INFO);
+        if (registered) size += sizeof(TRACE_PROVIDER_INSTANCE_INFO) + enables * sizeof(TRACE_ENABLE_INFO);
+        *ret_len = size;
+        if (out_size < size) return ERROR_INSUFFICIENT_BUFFER;
+        guid_info->InstanceCount = registered ? 1 : 0;
+        guid_info->Reserved = 0;
+        if (!registered) return ERROR_SUCCESS;
+        inst = (TRACE_PROVIDER_INSTANCE_INFO *)(guid_info + 1);
+        inst->NextOffset = 0;
+        inst->EnableCount = enables;
+        inst->Pid = GetCurrentProcessId();
+        inst->Flags = 0;
+        for (i = 0; i < enables; i++) ((TRACE_ENABLE_INFO *)(inst + 1))[i] = info[i];
+        return ERROR_SUCCESS;
+    }
+}
+
+/******************************************************************************
  *     CloseTrace   (sechost.@)
  */
 ULONG WINAPI CloseTrace( TRACEHANDLE handle )
--- a/dlls/sechost/sechost.spec
+++ b/dlls/sechost/sechost.spec
@@ -89,7 +89,7 @@
