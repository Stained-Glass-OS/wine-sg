From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, server: a maximized window fills the work area a new display scale leaves

A maximized window refitted when the display scale changed (0890) took the
work area from before the taskbar grew to the new scale: at 175% on a
Surface Pro 7 its bottom 30 px were under the taskbar (David 2026-10-06),
and back at 100% it stopped 30 px short of it. Three things:

- A new work area is told to every window, as on Windows: SPI_SETWORKAREA
  with SPIF_SENDCHANGE broadcasts WM_SETTINGCHANGE (Wine broadcast it only
  with SPIF_UPDATEINIFILE, which the taskbar does not pass), and a
  maximized top-level window fills the new work area before it hears of it
  (window_fit_work_area). The taskbar's size or edge changing, an appbar
  coming or going, do the same.
- A process that read the monitors while another changed them (the
  maximized window reading the new scale while the taskbar wrote its new
  work area) took the other's serial as read and kept the old work area
  until the next change: the serial is now taken as read only when no
  change came in between.
- The wineserver scaled a negative coordinate (a maximized window's border
  off the screen's edge, -4) between DPIs in unsigned arithmetic: to
  44739235 at 175% (GetWindowRect of a DPI-unaware maximized window from a
  per-monitor aware program).

At 100% with nothing changing, nothing changes.

Test: test/dpifollow-gate.sh part 1 (mutants SG_MUTANT_WORKAREA_NOT_TOLD,
SG_MUTANT_WORKAREA_STALE_SERIAL in sysparams.c, SG_MUTANT_WORKAREA_NO_REFIT
in window.c, SG_MUTANT_SCALE_NEGATIVE_UNSIGNED in server/user.h).
---
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2235,6 +2235,9 @@ static LRESULT call_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lpar
      * broadcasts WM_SETTINGCHANGE after it writes LogPixels): the window
      * is laid out for it before it hears of the change */
     if (msg == WM_SETTINGCHANGE) window_check_dpi_change( hwnd );
+    /* and a maximized window fills a new work area (the taskbar's size or
+     * edge changed, an appbar came or went) before it hears of it */
+    if (msg == WM_SETTINGCHANGE && wparam == SPI_SETWORKAREA) window_fit_work_area( hwnd );
 
     packed_size = user_message_size( hwnd, msg, wparam, lparam, type == MSG_OTHER_PROCESS, ansi, &reply_size );
 
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -2039,6 +2039,8 @@ static struct monitor *find_monitor_from_path( const char *path )
     return NULL;
 }
 
+static UINT64 get_monitor_update_serial(void);
+
 static BOOL update_display_cache_from_registry( UINT64 serial )
 {
     char path[MAX_PATH];
@@ -2128,7 +2130,20 @@ static BOOL update_display_cache_from_registry( UINT64 serial )
     if ((ret = !list_empty( &sources ) && !list_empty( &monitors )))
         last_query_display_time = key.LastWriteTime.QuadPart;
 
-    set_winstation_monitors( FALSE );
+    {
+        UINT64 now = get_monitor_update_serial();
+        set_winstation_monitors( FALSE );
+#ifndef SG_MUTANT_WORKAREA_STALE_SERIAL
+        /* Stained Glass OS: another process changed the monitors while this
+         * one read them (the taskbar's new work area as a maximized window
+         * read the new display scale): their serial is not taken as read --
+         * the change was missed until the next one, the window under the
+         * grown taskbar */
+        if (now != serial) monitor_update_serial = serial;
+#else
+        (void)now;
+#endif
+    }
     release_display_device_init_mutex( mutex );
     return ret;
 }
@@ -5584,7 +5599,7 @@ void sysparams_init(void)
  * registry record; the monitor serial tells the other processes to read the
  * monitors again, and the video key changing makes them read the registry. A mode change gives the monitor the driver's work area
  * back; the shell sets it again on WM_DISPLAYCHANGE. */
-static BOOL set_monitor_work_area( RECT rect, UINT dpi )
+static BOOL set_monitor_work_area( RECT rect, UINT dpi, BOOL *changed )
 {
     static const WCHAR serialW[] = {'W','i','n','e','W','o','r','k','A','r','e','a','S','e','r','i','a','l',0};
     static DWORD serial;
@@ -5596,10 +5611,11 @@ static BOOL set_monitor_work_area( RECT rect, UINT dpi )
     if (!lock_display_devices( FALSE )) return FALSE;
     if ((monitor = get_monitor_from_rect( rect, MONITOR_DEFAULTTOPRIMARY, dpi, MDT_DEFAULT )))
     {
-        RECT raw = monitor_get_rect( monitor, 0, MDT_RAW_DPI );
+        RECT raw = monitor_get_rect( monitor, 0, MDT_RAW_DPI ), old_work = monitor->rc_work;
 
         monitor->rc_work = map_dpi_rect( rect, dpi, monitor_get_dpi( monitor, MDT_DEFAULT, &x, &y ) );
         intersect_rect( &monitor->rc_work, &monitor->rc_work, &raw );
+        if (changed) *changed = !EqualRect( &old_work, &monitor->rc_work );
         save_work_area_insets( monitor->path, &raw, &monitor->rc_work );
         if (enum_key && (hkey = reg_open_ascii_key( enum_key, monitor->path )))
         {
@@ -6050,12 +6066,27 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
     }
     case SPI_SETWORKAREA:
     {
+        BOOL changed = FALSE;
+
         if (!ptr) return FALSE;
         spi_idx = SPI_SETWORKAREA_IDX;
         work_area = *(RECT*)ptr;
         spi_loaded[spi_idx] = TRUE;
-        set_monitor_work_area( work_area, get_thread_dpi() );
+        set_monitor_work_area( work_area, get_thread_dpi(), &changed );
         ret = TRUE;
+#ifndef SG_MUTANT_WORKAREA_NOT_TOLD
+        /* Stained Glass OS: every window is told of a new work area, as on
+         * Windows (SPIF_SENDCHANGE broadcasts it; Wine did with
+         * SPIF_UPDATEINIFILE only): a maximized window fills it again
+         * (window_fit_work_area) -- the taskbar grown with a new display
+         * scale, after the windows were laid out at it, left them under it */
+        if (changed && (winini & SPIF_SENDCHANGE) && !(winini & SPIF_UPDATEINIFILE))
+        {
+            static const WCHAR emptyW[1];
+            send_message_timeout( HWND_BROADCAST, WM_SETTINGCHANGE, SPI_SETWORKAREA, (LPARAM)emptyW,
+                                  SMTO_ABORTIFHUNG, 2000, FALSE );
+        }
+#endif
         break;
     }
     case SPI_GETWORKAREA:
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -272,6 +272,7 @@ extern BOOL is_window_unicode( HWND hwnd );
 extern BOOL is_window_visible( HWND hwnd );
 extern BOOL is_zoomed( HWND hwnd );
 extern void window_check_dpi_change( HWND hwnd );
+extern void window_fit_work_area( HWND hwnd );
 extern DWORD get_window_long( HWND hwnd, INT offset );
 extern ULONG_PTR get_window_long_ptr( HWND hwnd, INT offset, BOOL ansi );
 extern BOOL get_window_rect( HWND hwnd, RECT *rect, UINT dpi );
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -6751,3 +6751,44 @@ void window_check_dpi_change( HWND hwnd )
     NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
     set_thread_dpi_awareness_context( thread_context );
 }
+
+/***********************************************************************
+ *           window_fit_work_area
+ *
+ * Stained Glass OS: the work area changed (SPI_SETWORKAREA, broadcast to
+ * every window): a maximized top-level window fills it again, as on
+ * Windows. The taskbar grows with a new display scale after the windows
+ * were laid out at it: maximized ones had the old work area (about 30 px of
+ * them under the taskbar at 175%).
+ */
+void window_fit_work_area( HWND hwnd )
+{
+    UINT context, thread_context;
+    MINMAXINFO minmax;
+    RECT rect, want;
+    HWND parent;
+    WND *win;
+
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    parent = win->parent;
+    context = win->dpi_context;
+    release_win_ptr( win );
+    if (parent != get_desktop_window()) return;
+    if (!is_zoomed( hwnd ) || is_iconic( hwnd )) return;
+
+#ifndef SG_MUTANT_WORKAREA_NO_REFIT
+    thread_context = set_thread_dpi_awareness_context( context );
+    minmax = get_min_max_info( hwnd );
+    SetRect( &want, minmax.ptMaxPosition.x, minmax.ptMaxPosition.y,
+             minmax.ptMaxPosition.x + minmax.ptMaxSize.x, minmax.ptMaxPosition.y + minmax.ptMaxSize.y );
+    if (get_window_rect( hwnd, &rect, get_thread_dpi() ) && !EqualRect( &rect, &want ))
+    {
+        TRACE( "%p %s -> %s\n", hwnd, wine_dbgstr_rect( &rect ), wine_dbgstr_rect( &want ) );
+        NtUserSetWindowPos( hwnd, 0, want.left, want.top, want.right - want.left, want.bottom - want.top,
+                            SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER | SWP_NOCOPYBITS );
+    }
+    set_thread_dpi_awareness_context( thread_context );
+#else
+    (void)context; (void)thread_context; (void)minmax; (void)rect; (void)want;
+#endif
+}
--- a/server/user.h
+++ b/server/user.h
@@ -246,7 +246,14 @@ static inline int point_in_rect( const struct rectangle *rect, int x, int y )
 static inline int scale_dpi( int val, unsigned int dpi_from, unsigned int dpi_to )
 {
     if (val >= 0) return (val * dpi_to + (dpi_from / 2)) / dpi_from;
+#ifndef SG_MUTANT_SCALE_NEGATIVE_UNSIGNED
+    /* Stained Glass OS: in signed arithmetic -- the unsigned DPI made a
+     * negative coordinate (a maximized window's border off the screen's
+     * edge) a huge one, 44739235 for -4 at 175% */
+    return (val * (int)dpi_to - (int)(dpi_from / 2)) / (int)dpi_from;
+#else
     return (val * dpi_to - (dpi_from / 2)) / dpi_from;
+#endif
 }
 
 static inline void scale_dpi_rect( struct rectangle *rect, unsigned int dpi_from, unsigned int dpi_to )
