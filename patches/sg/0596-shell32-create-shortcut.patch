From: Stained Glass OS <ke7oxh@gmail.com>
Subject: shell32: Create shortcut

David: "the current Create link does not seem to do anything in the SMB
share." It did nothing anywhere: the menu's Create shortcut had no handler.
Now it makes "name - Shortcut.lnk" beside each item, as Windows does
("name - Shortcut (2).lnk" when taken); where the folder cannot be written
(a read-only share) it asks whether to put the shortcut on the desktop
instead.

Gate: make test-shortcut.
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -1108,6 +1108,83 @@
     return S_OK;
 }
 
+/* Stained Glass OS: Create shortcut -- "name - Shortcut.lnk" beside each item,
+ * as Windows makes them; where the folder cannot be written (a read-only
+ * network share), on the desktop if the user agrees. It did nothing at all
+ * (David: Create link did nothing on an SMB share). */
+static BOOL make_link(const ITEMIDLIST *target, const WCHAR *dir, const WCHAR *name, DWORD *err)
+{
+    WCHAR path[MAX_PATH], base[MAX_PATH];
+    IShellLinkW *link;
+    IPersistFile *file;
+    HRESULT hr;
+    int n;
+
+    for (n = 1; n < 100; n++)
+    {
+        if (n == 1) swprintf(base, ARRAY_SIZE(base), L"%s - Shortcut.lnk", name);
+        else swprintf(base, ARRAY_SIZE(base), L"%s - Shortcut (%d).lnk", name, n);
+        if (!PathCombineW(path, dir, base)) { *err = ERROR_FILENAME_EXCED_RANGE; return FALSE; }
+        if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) break;
+    }
+    if (FAILED(hr = CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&link)))
+    {
+        *err = hr;
+        return FALSE;
+    }
+    IShellLinkW_SetIDList(link, target);
+    hr = IShellLinkW_QueryInterface(link, &IID_IPersistFile, (void **)&file);
+    if (SUCCEEDED(hr))
+    {
+        hr = IPersistFile_Save(file, path, TRUE);
+        IPersistFile_Release(file);
+    }
+    IShellLinkW_Release(link);
+    *err = HRESULT_FACILITY(hr) == FACILITY_WIN32 ? HRESULT_CODE(hr) : (DWORD)hr;
+    if (SUCCEEDED(hr)) SHChangeNotify(SHCNE_CREATE, SHCNF_PATHW, path, NULL);
+    return SUCCEEDED(hr);
+}
+
+static HRESULT create_links(ContextMenu *This, HWND hwnd)
+{
+    WCHAR dir[MAX_PATH], desktop[MAX_PATH], name[MAX_PATH];
+    BOOL to_desktop = FALSE, asked = FALSE;
+    UINT i;
+
+    if (!SHGetPathFromIDListW(This->pidl, dir)) dir[0] = 0;
+    for (i = 0; i < This->cidl; i++)
+    {
+        ITEMIDLIST *full = ILCombine(This->pidl, This->apidl[i]);
+        STRRET str;
+        DWORD err = 0;
+
+        if (!full) continue;
+        name[0] = 0;
+        if (SUCCEEDED(IShellFolder_GetDisplayNameOf(This->parent, This->apidl[i], SHGDN_INFOLDER, &str)))
+            StrRetToBufW(&str, This->apidl[i], name, ARRAY_SIZE(name));
+        if (!name[0]) lstrcpyW(name, L"Shortcut");
+        if (to_desktop || !dir[0] || !make_link(full, dir, name, &err))
+        {
+            if (!to_desktop && !asked)
+            {
+                asked = TRUE;
+                if (MessageBoxW(hwnd, L"A shortcut cannot be created here.\n\n"
+                                L"Do you want the shortcut to be placed on the desktop instead?",
+                                L"Shortcut", MB_YESNO | MB_ICONQUESTION) != IDYES)
+                {
+                    ILFree(full);
+                    return S_OK;
+                }
+                to_desktop = TRUE;
+            }
+            if (to_desktop && SHGetSpecialFolderPathW(hwnd, desktop, CSIDL_DESKTOPDIRECTORY, TRUE))
+                make_link(full, desktop, name, &err);
+        }
+        ILFree(full);
+    }
+    return S_OK;
+}
+
