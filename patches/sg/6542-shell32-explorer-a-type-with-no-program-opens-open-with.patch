--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -2336,7 +2336,8 @@ static HRESULT ShellView_OpenSelectedItems(IShellViewImpl * This)
 	    shexinfo.nShow = SW_NORMAL;
 	    shexinfo.lpIDList = ILCombine(parent_pidl, pidl);
 
-	    ShellExecuteExW(&shexinfo);    /* Discard error/success info */
+	    /* Stained Glass OS: a type with no program asks which, as Windows does */
+	    SGShellExecuteFromShell(&shexinfo, GetAncestor(This->hWnd, GA_ROOT));    /* Discard error/success info */
 	    /* Stained Glass: Quick access's recent files */
 	    SHAddToRecentDocs(SHARD_PIDL, shexinfo.lpIDList);
 
diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
index 7a3ea06..8ab3e96 100644
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -339,6 +339,28 @@ static int launcher_index_from_point( int x, int y )
     return -1;
 }
 
+/* Stained Glass OS: a desktop icon opens as Windows opens it: a file whose
+ * type has no program asks which (Open with), where ShellExecute shows an error */
+static void open_launcher( const struct launcher *launcher )
+{
+    static BOOL (WINAPI *from_shell)( SHELLEXECUTEINFOW *, HWND );
+    static BOOL looked;
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+
+    if (!looked)
+    {
+        HMODULE shell32 = LoadLibraryW( L"shell32.dll" );
+        if (shell32) from_shell = (void *)GetProcAddress( shell32, "SGShellExecuteFromShell" );
+        looked = TRUE;
+    }
+    sei.lpVerb = L"open";
+    sei.lpFile = launcher->path;
+    sei.lpParameters = launcher->args;
+    sei.nShow = SW_SHOWNORMAL;
+    if (from_shell) from_shell( &sei, NULL );
+    else ShellExecuteExW( &sei );
+}
+
 static const struct launcher *launcher_from_point( int x, int y )
 {
     int index = launcher_index_from_point( x, y );
@@ -3127,7 +3149,7 @@ static LRESULT WINAPI desktop_wnd_proc( HWND hwnd, UINT message, WPARAM wp, LPAR
             unsigned int i;
             for (i = 0; i < nb_launchers; i++)    /* every selected icon opens */
                 if (launchers[i]->selected)
-                    ShellExecuteW( NULL, L"open", launchers[i]->path, launchers[i]->args, NULL, SW_SHOWNORMAL );
+                    open_launcher( launchers[i] );
             return 0;
         }
         break;
@@ -3140,7 +3162,7 @@ static LRESULT WINAPI desktop_wnd_proc( HWND hwnd, UINT message, WPARAM wp, LPAR
         if (!using_root)
         {
             const struct launcher *launcher = launcher_from_point( (short)LOWORD(lp), (short)HIWORD(lp) );
-            if (launcher) ShellExecuteW( NULL, L"open", launcher->path, launcher->args, NULL, SW_SHOWNORMAL );
+            if (launcher) open_launcher( launcher );
         }
         return 0;
 
