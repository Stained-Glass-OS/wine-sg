+BOOL WINAPI SGShellExecuteFromShell(SHELLEXECUTEINFOW *sei, HWND owner);
 BOOL SHELL_MakeAssocHandlerInfo(const WCHAR *progid, struct assoc_handler_info *info);
 
 /* IEnumIDList stuff */
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index f320fb3..947f2e4 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -2048,12 +2048,30 @@ have_class:
     return retval;
 }
 
+/* Stained Glass OS: the shell's own open (a double-click in File Explorer or
+ * on the desktop) of a file whose type has no program shows Open with, as
+ * Windows does ("How do you want to open this file?"), not the error box. A
+ * program's own ShellExecute keeps the error. The thread opening for the shell
+ * is marked here, and the no-association error is noted instead of shown. */
+static DWORD open_as_tls = TLS_OUT_OF_INDEXES;
+#define OPEN_AS_ACTIVE  ((void *)1)
+#define OPEN_AS_NOASSOC ((void *)2)
+
+static BOOL open_as_noassoc( UINT_PTR retval )
+{
+    if (retval != SE_ERR_NOASSOC || open_as_tls == TLS_OUT_OF_INDEXES) return FALSE;
+    if (!TlsGetValue( open_as_tls )) return FALSE;
+    TlsSetValue( open_as_tls, OPEN_AS_NOASSOC );
+    return TRUE;
+}
+
 static void do_error_dialog( UINT_PTR retval, HWND hwnd )
 {
     WCHAR msg[2048];
     int error_code=GetLastError();
 
     if (error_code == ERROR_CANCELLED) return;   /* Stained Glass OS: the consent was refused; it said so */
+    if (open_as_noassoc( retval )) { SetLastError( error_code ); return; }
     if (retval == SE_ERR_NOASSOC)
         LoadStringW(shell32_hInstance, IDS_SHLEXEC_NOASSOC, msg, ARRAY_SIZE(msg));
     else
@@ -2673,6 +2691,74 @@ BOOL WINAPI DECLSPEC_HOTPATCH ShellExecuteExW (LPSHELLEXECUTEINFOW sei)
     return SHELL_execute( sei, SHELL_ExecuteW );
 }
 
+/*************************************************************************
+ * SGShellExecuteFromShell        [SHELL32.@]
+ *
+ * Stained Glass OS: ShellExecuteEx for the shell's own open of an item (File
+ * Explorer's and the desktop's double-click, Enter): when the item's type has
+ * no program, the Open with dialog asks which one ("Always use this app" makes
+ * it the type's), owned by OWNER, where ShellExecuteEx shows an error.
+ */
+BOOL WINAPI SGShellExecuteFromShell( SHELLEXECUTEINFOW *sei, HWND owner )
+{
+    OPENASINFO info = { NULL, NULL, OAIF_ALLOW_REGISTRATION | OAIF_REGISTER_EXT | OAIF_EXEC };
+    WCHAR path[MAX_PATH];
+    void *prev;
+    DWORD attr;
+    HRESULT hr;
+    BOOL ret;
+
+    if (open_as_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD tls = TlsAlloc();
+        if (tls != TLS_OUT_OF_INDEXES && InterlockedCompareExchange( (LONG *)&open_as_tls, tls, TLS_OUT_OF_INDEXES )
+            != TLS_OUT_OF_INDEXES)
+            TlsFree( tls );
+    }
+    if (open_as_tls == TLS_OUT_OF_INDEXES || (sei->fMask & SEE_MASK_FLAG_NO_UI)) return ShellExecuteExW( sei );
+
+    prev = TlsGetValue( open_as_tls );
+#ifndef SG_MUTANT_NOASSOC_ERROR_BOX
+    TlsSetValue( open_as_tls, OPEN_AS_ACTIVE );
+#endif
+    ret = ShellExecuteExW( sei );
+    if (ret || TlsGetValue( open_as_tls ) != OPEN_AS_NOASSOC)
+    {
+        TlsSetValue( open_as_tls, prev );
+        return ret;
+    }
+    TlsSetValue( open_as_tls, prev );
+
+    path[0] = 0;
+    if (sei->fMask & SEE_MASK_IDLIST && sei->lpIDList) SHGetPathFromIDListW( sei->lpIDList, path );
+    else if (sei->lpFile) lstrcpynW( path, sei->lpFile, ARRAY_SIZE(path) );
+    attr = path[0] ? GetFileAttributesW( path ) : INVALID_FILE_ATTRIBUTES;
+    TRACE( "no program for %s, attr %#lx: Open with\n", debugstr_w(path), attr );
+    if (attr == INVALID_FILE_ATTRIBUTES || (attr & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        SetLastError( ERROR_NO_ASSOCIATION );
+        do_error_dialog( SE_ERR_NOASSOC, sei->hwnd ? sei->hwnd : owner );
+        return FALSE;
+    }
+    /* the desktop is never disabled under the dialog */
+    if (owner && (owner == GetDesktopWindow() || owner == GetShellWindow())) owner = NULL;
+    info.pcszFile = path;
+    hr = SHOpenWithDialog( owner, &info );
+    if (SUCCEEDED(hr))
+    {
+        sei->hInstApp = (HINSTANCE)33;
+        return TRUE;
+    }
+    if (hr != HRESULT_FROM_WIN32(ERROR_CANCELLED))
+    {
+        WCHAR msg[1024];
+        FormatMessageW( FORMAT_MESSAGE_FROM_SYSTEM, NULL, hr, 0, msg, ARRAY_SIZE(msg), NULL );
+        MessageBoxW( owner, msg, NULL, MB_ICONERROR );
+    }
+    SetLastError( HRESULT_CODE(hr) );
+    return FALSE;
+}
+
