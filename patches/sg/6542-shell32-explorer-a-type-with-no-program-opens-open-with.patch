From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, explorer: A type with no program opens Open with (6542)

Double-clicking a file whose type has no program, in File Explorer or on
the desktop, showed "There is no program configured to open this type of
file." Windows asks "How do you want to open this file?" (Open with).

SGShellExecuteFromShell (a private shell32 export) is ShellExecuteEx for
the shell's own open of an item: the shell view's double-click and Enter,
and the desktop's icons, use it. When the type has no program
(SE_ERR_NOASSOC), the error is noted instead of shown and Open with comes
up, owned by the folder's window (never the desktop). A program's own
ShellExecuteEx keeps the error box.

Open with gains "Look for an app in the Store" (SG Store, its App Paths
program sg-store.exe, searching for the type: --search heic), clicked or
chosen with OK. "Always use this app" also sets the user's class for the
type (HKCU\Software\Classes\.ext), as Settings' Default apps sets it,
beside FileExts UserChoice. The rows carry
their words (LBS_HASSTRINGS) for screen readers.
---
diff --git a/dlls/shell32/openwith.c b/dlls/shell32/openwith.c
index 6d1f97e..0a65cb9 100644
--- a/dlls/shell32/openwith.c
+++ b/dlls/shell32/openwith.c
@@ -45,7 +45,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(shell);
 #define ROW_HEIGHT 44
 #define MAX_APPS   64
 
-enum { ROW_HEADING, ROW_APP, ROW_MORE, ROW_BROWSE };
+enum { ROW_HEADING, ROW_APP, ROW_MORE, ROW_STORE, ROW_BROWSE };
 
 struct app
 {
@@ -260,6 +260,36 @@ static void collect_apps(struct openwith *ow)
     if (find_app(ow, L"notepad.exe") < 0) add_app(ow, L"txtfile");
 }
 
+/* SG Store, where "Look for an app in the Store" goes (searching for the type): its App Paths program */
+static BOOL store_command(WCHAR *exe, DWORD len)
+{
+    WCHAR buf[MAX_PATH];
+    DWORD size = sizeof(buf);
+
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\sg-store.exe",
+                     NULL, RRF_RT_REG_SZ, NULL, buf, &size) || !buf[0])
+        return FALSE;
+    PathUnquoteSpacesW(buf);
+    if (exe) lstrcpynW(exe, buf, len);
+    return TRUE;
+}
+
+static void open_store(struct openwith *ow)
+{
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+    WCHAR exe[MAX_PATH], params[96];
+
+    if (!store_command(exe, ARRAY_SIZE(exe))) return;
+    /* the Store searches for the type: --search heic */
+    swprintf(params, ARRAY_SIZE(params), L"--search \"%s\"", ow->ext[0] == '.' ? ow->ext + 1 : ow->ext);
+    sei.fMask = SEE_MASK_FLAG_NO_UI;
+    sei.hwnd = ow->hwnd;
+    sei.lpFile = exe;
+    sei.lpParameters = params;
+    sei.nShow = SW_SHOWNORMAL;
+    ShellExecuteExW(&sei);
+}
+
 static void build_rows(struct openwith *ow)
 {
     int i;
@@ -276,10 +306,15 @@ static void build_rows(struct openwith *ow)
         if (i != ow->current && ow->nrows < ARRAY_SIZE(ow->rows) - 2)
             ow->rows[ow->nrows++] = (struct row){ ROW_APP, NULL, i };
     if (!ow->more && ow->first_more < ow->count) ow->rows[ow->nrows++] = (struct row){ ROW_MORE, L"More apps" };
+    if (store_command(NULL, 0))
+        ow->rows[ow->nrows++] = (struct row){ ROW_STORE, L"Look for an app in the Store" };
     ow->rows[ow->nrows++] = (struct row){ ROW_BROWSE, L"Look for another app on this PC" };
 
     SendMessageW(ow->list, LB_RESETCONTENT, 0, 0);
-    for (i = 0; i < ow->nrows; i++) SendMessageW(ow->list, LB_ADDSTRING, 0, i);
+    /* each row's words, for a screen reader (the rows are drawn by their index) */
+    for (i = 0; i < ow->nrows; i++)
+        SendMessageW(ow->list, LB_ADDSTRING, 0, (LPARAM)(ow->rows[i].kind == ROW_APP ? ow->apps[ow->rows[i].app].name :
+                                                         ow->rows[i].text));
     for (i = 0; i < ow->nrows; i++)
         if (ow->rows[i].kind == ROW_APP) { SendMessageW(ow->list, LB_SETCURSEL, i, 0); break; }
 }
@@ -399,6 +434,10 @@ static LRESULT CALLBACK openwith_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
             case ROW_BROWSE:
                 if (!browse_for_app(ow)) build_rows(ow);
                 break;
+            case ROW_STORE:
+                /* the Store, in place of the dialog: clicked (not reached with the arrow keys), or OK */
+                if (HIWORD(wp) == LBN_DBLCLK || GetKeyState(VK_LBUTTON) < 0) ow->result = IDOK;
+                break;
             case ROW_APP:
                 if (HIWORD(wp) == LBN_DBLCLK) ow->result = IDOK;
                 break;
@@ -447,7 +486,7 @@ static int run_openwith(struct openwith *ow, HWND owner, BOOL *always)
                                max(0, orc.top + (orc.bottom - orc.top - (rc.bottom - rc.top)) / 3),
                                rc.right - rc.left, rc.bottom - rc.top, owner, NULL, shell32_hInstance, ow);
     ow_control(ow, L"Static", L"How do you want to open this file?", 0, 20, 16, 380, 32, 0, ow->big);
-    ow->list = ow_control(ow, L"ListBox", NULL, LBS_OWNERDRAWFIXED | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL |
+    ow->list = ow_control(ow, L"ListBox", NULL, LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL |
                           WS_TABSTOP, 12, 56, 396, 368, 100, ow->font);
     swprintf(label, ARRAY_SIZE(label), L"&Always use this app to open %s files", ow->ext);
     ow->always = ow_control(ow, L"Button", label, BS_AUTOCHECKBOX | WS_TABSTOP, 20, 434, 380, 24, 101, ow->font);
@@ -467,6 +506,7 @@ static int run_openwith(struct openwith *ow, HWND owner, BOOL *always)
     }
     sel = SendMessageW(ow->list, LB_GETCURSEL, 0, 0);
     if (ow->result == IDOK && sel >= 0 && sel < ow->nrows && ow->rows[sel].kind == ROW_APP) app = ow->rows[sel].app;
+    if (ow->result == IDOK && sel >= 0 && sel < ow->nrows && ow->rows[sel].kind == ROW_STORE) open_store(ow);
     *always = SendMessageW(ow->always, BM_GETCHECK, 0, 0) == BST_CHECKED;
     if (owner) EnableWindow(owner, TRUE);
     DestroyWindow(ow->hwnd);
@@ -540,6 +580,9 @@ HRESULT WINAPI SHOpenWithDialog(HWND parent, const OPENASINFO *info)
             WCHAR key[MAX_PATH];
             swprintf(key, ARRAY_SIZE(key), L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\%s\\UserChoice", ow->ext);
             RegSetKeyValueW(HKEY_CURRENT_USER, key, L"ProgId", REG_SZ, a->progid, (lstrlenW(a->progid) + 1) * sizeof(WCHAR));
+            /* and the user's class for the type, as Settings' Default apps sets it */
+            swprintf(key, ARRAY_SIZE(key), L"Software\\Classes\\%s", ow->ext);
+            RegSetKeyValueW(HKEY_CURRENT_USER, key, NULL, REG_SZ, a->progid, (lstrlenW(a->progid) + 1) * sizeof(WCHAR));
             SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, NULL, NULL);
         }
         hr = S_OK;
