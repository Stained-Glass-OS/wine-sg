diff --git a/dlls/crypt32/msg.c b/dlls/crypt32/msg.c
--- a/dlls/crypt32/msg.c
+++ b/dlls/crypt32/msg.c
@@ -241,6 +241,7 @@ static BOOL sg_ber_convert(const BYTE *p, DWORD avail, DWORD depth, BOOL implici
     }
     if (len == 0xffffffff) *indef = TRUE;
     strings = tag == 0x24 || implicit_string;
+    if (strings) *indef = TRUE;   /* "changed": a constructed string is rewritten as a primitive one */
     end = len == 0xffffffff ? avail : hdr + len;
     if (end > avail) return FALSE;
 
@@ -2637,9 +2638,39 @@ typedef struct _CEnvelopedDecodeMsg
     int                   decrypt_index;  /* the key transport recipient that decrypted, or -1 */
 } CEnvelopedDecodeMsg;
 
+/* Stained Glass OS 3758: where a streamed decode is in the message: the inner content is found
+ * with a walk over the BER headers, and handed to the stream output as it arrives. */
+typedef struct _CSgStreamScan   /* the part that is restored when an update fails */
+{
+    DWORD pos;        /* msg_data offset of the next byte to parse */
+    DWORD step;       /* 0: SEQUENCE, 1: content type, 2: [0], 3: the ops of the kind */
+    DWORD op;         /* the next op of the kind's table */
+    DWORD kind;       /* CMSG_DATA, CMSG_SIGNED, CMSG_ENVELOPED; 0: not known yet */
+    DWORD env_start, eci_start, eci_content;   /* enveloped: offsets of the header parts */
+    DWORD prim_rem;   /* content octets left in the current primitive string */
+    DWORD queue_len;  /* enveloped, no key yet: the cipher text held back */
+    int   depth;
+    int   phase;      /* 0 header, 1 content, 2 content complete */
+    BOOL  skip;       /* a type with no streamed output (hashed, unknown) */
+    BOOL  header_ready;
+    struct { BOOL indef; DWORD rem; } stack[8];
+} CSgStreamScan;
+
+typedef struct _CSgStreamDec
+{
+    CSgStreamScan scan;
+    BYTE         *queue;      /* enveloped, no key yet: the cipher text */
+    DWORD         queue_cap;
+    BYTE         *pend;       /* cipher text that does not fill a block yet */
+    DWORD         pend_len;
+    HCRYPTKEY     key;
+    BOOL          have_key;
+} CSgStreamDec;
+
 typedef struct _CDecodeMsg
 {
     CryptMsgBase           base;
+    CSgStreamDec           sd;
     DWORD                  type;
     HCRYPTPROV             crypt_prov;
     union {
@@ -2700,6 +2731,11 @@ static void CDecodeMsg_Close(HCRYPTMSG hCryptMsg)
         CryptMemFree(msg->added_attrs);
         CryptMemFree(msg->owned_attr_arrays);
     }
+    if (!msg->type && msg->sd.scan.header_ready && msg->sd.scan.kind == CMSG_ENVELOPED)
+        LocalFree(msg->u.enveloped_data.data);   /* the header of a streamed message that never ended */
+    if (msg->sd.have_key) CryptDestroyKey(msg->sd.key);
+    CryptMemFree(msg->sd.queue);
+    CryptMemFree(msg->sd.pend);
     CryptMemFree(msg->msg_data.pbData);
     CryptMemFree(msg->detached_data.pbData);
     ContextPropertyList_Free(msg->properties);
@@ -3038,7 +3074,10 @@ static BOOL CDecodeMsg_DecodeEnvelopedContent(CDecodeMsg *msg,
      CRYPT_DECODE_ALLOC_FLAG, NULL, (CRYPT_ENVELOPED_DATA *)&envelopedData,
      &size);
     if (ret)
+    {
+        LocalFree(msg->u.enveloped_data.data);   /* the header of a streamed message was decoded early */
         msg->u.enveloped_data.data = envelopedData;
+    }
     CryptMemFree(rebuilt);
     return ret;
 }
@@ -3181,6 +3220,7 @@ static BOOL CDecodeMsg_FinalizeEnvelopedContent(CDecodeMsg *msg,
 {
     CRYPT_DATA_BLOB *content;
 
+    if (msg->sd.have_key) return TRUE;   /* the plain text went to the stream output as it was decrypted */
     if (msg->base.open_flags & CMSG_DETACHED_FLAG)
         content = &msg->detached_data;
     else
@@ -3275,6 +3315,389 @@ static BOOL CDecodeMsg_FinalizeContent(CDecodeMsg *msg, CRYPT_DER_BLOB *blob)
     return ret;
 }
 
+/* 1: a header, 0: more bytes are needed, -1: not BER */
+static int sg_scan_peek(const BYTE *p, DWORD avail, BYTE *tag, DWORD *hdr, DWORD *len)
+{
+    DWORD n, i;
+
+    if (avail < 2) return 0;
+    if ((p[0] & 0x1f) == 0x1f) return -1;
+    *tag = p[0];
+    if (p[1] < 0x80) { *hdr = 2; *len = p[1]; }
+    else if (p[1] == 0x80) { *hdr = 2; *len = 0xffffffff; }
+    else
+    {
+        n = p[1] & 0x7f;
+        if (n > 4) return -1;
+        if (avail < 2 + n) return 0;
+        *len = 0;
+        for (i = 0; i < n; i++) *len = (*len << 8) | p[2 + i];
+        *hdr = 2 + n;
+    }
+    return 1;
+}
+
+/* the plain text of enveloped content, or the content itself, goes to the callback; the
+ * cipher text is held until a key is known (CMSG_CTRL_DECRYPT) */
+static BOOL CDecodeMsg_StreamDecrypt(CDecodeMsg *msg, const BYTE *data, DWORD n, BOOL final)
+{
+    CSgStreamDec *sd = &msg->sd;
+    DWORD block = 0, bits = 0, bsize = sizeof(bits), avail, take, size;
+    BYTE *buf;
+    BOOL ret = TRUE;
+
+    if (CryptGetKeyParam(sd->key, KP_BLOCKLEN, (BYTE *)&bits, &bsize, 0)) block = bits / 8;
+    avail = sd->pend_len + n;
+    /* a block cipher keeps its last block back: the padding is only known once the end is */
+    take = final || !block ? avail : (avail ? (avail - 1) / block * block : 0);
+    if (!take && !final) goto hold;
+    if (!(buf = CryptMemAlloc(avail + 1)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    if (sd->pend_len) memcpy(buf, sd->pend, sd->pend_len);
+    if (n) memcpy(buf + sd->pend_len, data, n);
+    size = take;
+    ret = (!block && !take) || CryptDecrypt(sd->key, 0, final, 0, buf, &size);   /* a stream cipher has nothing to end */
+    if (!block && !take) size = 0;
+    if (ret && (size || final)) ret = CryptMsgBase_StreamOut(&msg->base, buf, size, final);
+    if (ret)
+    {
+        CryptMemFree(sd->pend);
+        sd->pend = NULL;
+        sd->pend_len = avail - take;
+        if (sd->pend_len && (sd->pend = CryptMemAlloc(sd->pend_len))) memcpy(sd->pend, buf + take, sd->pend_len);
+        else sd->pend_len = 0;
+    }
+    CryptMemFree(buf);
+    return ret;
+hold:
+    {
+        BYTE *np = CryptMemAlloc(avail);
+
+        if (!np) { SetLastError(ERROR_OUTOFMEMORY); return FALSE; }
+        if (sd->pend_len) memcpy(np, sd->pend, sd->pend_len);
+        memcpy(np + sd->pend_len, data, n);
+        CryptMemFree(sd->pend);
+        sd->pend = np;
+        sd->pend_len = avail;
+    }
+    return TRUE;
+}
+
+static BOOL CDecodeMsg_StreamEmit(CDecodeMsg *msg, const BYTE *data, DWORD n, BOOL final)
+{
+    CSgStreamDec *sd = &msg->sd;
+
+    if (sd->scan.kind != CMSG_ENVELOPED) return CryptMsgBase_StreamOut(&msg->base, data, n, final);
+    if (sd->have_key) return CDecodeMsg_StreamDecrypt(msg, data, n, final);
+    if (n)   /* no key yet: keep the cipher text */
+    {
+        if (sd->scan.queue_len + n > sd->queue_cap)
+        {
+            DWORD cap = max(sd->queue_cap * 2, sd->scan.queue_len + n + 256);
+            BYTE *q = CryptMemRealloc(sd->queue, cap);
+
+            if (!q) { SetLastError(ERROR_OUTOFMEMORY); return FALSE; }
+            sd->queue = q;
+            sd->queue_cap = cap;
+        }
+        memcpy(sd->queue + sd->scan.queue_len, data, n);
+        sd->scan.queue_len += n;
+    }
+    return TRUE;
+}
+
+/* decodes the header of a streamed enveloped message once its encrypted content info has begun,
+ * so that the algorithm and the recipients can be asked for */
+static BOOL CDecodeMsg_StreamEnvelopedHeader(CDecodeMsg *msg)
+{
+    CSgStreamScan *sc = &msg->sd.scan;
+    const BYTE *p = msg->msg_data.pbData;
+    CSgBer body = { 0 }, eci = { 0 }, all = { 0 };
+    CRYPT_ENVELOPED_DATA *data = NULL;
+    BYTE lenbuf[8];
+    DWORD pos, used, size;
+    BOOL ret = TRUE, indef = FALSE;
+
+    /* version and recipient infos, then { content type, algorithm }, each as DER */
+    for (pos = sc->env_start; ret && pos < sc->eci_start; pos += used)
+        ret = sg_ber_convert(p + pos, sc->eci_start - pos, 0, FALSE, &body, &used, &indef);
+    for (pos = sc->eci_content; ret && pos < sc->pos; pos += used)
+        ret = sg_ber_convert(p + pos, sc->pos - pos, 0, FALSE, &eci, &used, &indef);
+    if (ret)
+    {
+        sg_ber_add(&all, "\x30", 1);
+        sg_ber_add(&all, lenbuf, sg_ber_length(lenbuf, body.len + eci.len + 1 + sg_ber_length(lenbuf, eci.len)));
+        sg_ber_add(&all, body.p, body.len);
+        sg_ber_add(&all, "\x30", 1);
+        sg_ber_add(&all, lenbuf, sg_ber_length(lenbuf, eci.len));
+        sg_ber_add(&all, eci.p, eci.len);
+        if (all.fail) { SetLastError(ERROR_OUTOFMEMORY); ret = FALSE; }
+    }
+    else SetLastError(CRYPT_E_ASN1_BADTAG);
+    if (ret && (ret = CRYPT_AsnDecodePKCSEnvelopedData(all.p, all.len, CRYPT_DECODE_ALLOC_FLAG, NULL, (CRYPT_ENVELOPED_DATA *)&data, &size)))
+        msg->u.enveloped_data.data = data;
+    CryptMemFree(body.p);
+    CryptMemFree(eci.p);
+    CryptMemFree(all.p);
+    return ret;
+}
+
+/* The ops after the content info header of each kind of message. */
+enum { OP_ENTER, OP_SKIP, OP_ENTER_OPT, OP_MARK_ENV, OP_MARK_ECI, OP_READY, OP_CONTENT };
+struct sg_op { BYTE op, tag; };
+static const struct sg_op sg_ops_data[] = { { OP_CONTENT, 0x04 } };
+static const struct sg_op sg_ops_signed[] =
+{
+    { OP_ENTER, 0x30 }, { OP_SKIP, 0x02 }, { OP_SKIP, 0x31 }, { OP_ENTER, 0x30 }, { OP_SKIP, 0x06 },
+    { OP_ENTER_OPT, 0xa0 }, { OP_CONTENT, 0x04 }
+};
+static const struct sg_op sg_ops_enveloped[] =
+{
+    { OP_ENTER, 0x30 }, { OP_MARK_ENV, 0 }, { OP_SKIP, 0x02 }, { OP_SKIP, 0x31 }, { OP_MARK_ECI, 0 },
+    { OP_ENTER, 0x30 }, { OP_SKIP, 0x06 }, { OP_SKIP, 0x30 }, { OP_READY, 0 }, { OP_CONTENT, 0x80 }
+};
+
+static BOOL sg_scan_bad(void)
+{
+    SetLastError(CRYPT_E_ASN1_BADTAG);
+    return FALSE;
+}
+
+/* a finished definite container is closed; returns whether the string is complete */
+static BOOL sg_scan_complete(CSgStreamScan *sc)
+{
+    while (sc->depth && !sc->stack[sc->depth - 1].indef && !sc->stack[sc->depth - 1].rem) sc->depth--;
+    return sc->depth == 0;
+}
+
+static BOOL sg_scan_consume(CSgStreamScan *sc, DWORD n)
+{
+    int i;
+
+    sc->pos += n;
+    for (i = 0; i < sc->depth; i++)
+    {
+        if (sc->stack[i].indef) continue;
+        if (sc->stack[i].rem < n) return FALSE;
+        sc->stack[i].rem -= n;
+    }
+    return TRUE;
+}
+
+/* Walks the bytes that arrived since the last call.  A message of a kind that is streamed
+ * (data, signed, enveloped) has its inner content handed on; a bad header fails with
+ * CRYPT_E_ASN1_BADTAG; with "final", a content that has not ended fails with
+ * CRYPT_E_STREAM_INSUFFICIENT_DATA. */
+static BOOL CDecodeMsg_StreamScan(CDecodeMsg *msg, BOOL final)
+{
+    CSgStreamScan *sc = &msg->sd.scan;
+    const BYTE *p = msg->msg_data.pbData;
+    DWORD size = msg->msg_data.cbData;
+    BYTE tag;
+    DWORD hdr, len;
+    int r;
+
+    if (sc->skip) return TRUE;
+    if (!sc->kind && sc->step == 0 && msg->type)   /* a typed message has no content info around it */
+    {
+        sc->kind = msg->type;
+        sc->step = 3;
+        if (sc->kind != CMSG_DATA && sc->kind != CMSG_SIGNED && sc->kind != CMSG_ENVELOPED) sc->skip = TRUE;
+        if (sc->skip) return TRUE;
+    }
+    while (sc->phase == 0)
+    {
+        if (sc->step < 3)
+        {
+            r = sg_scan_peek(p + sc->pos, size - sc->pos, &tag, &hdr, &len);
+            if (r < 0) return sg_scan_bad();
+            if (!r) goto more;
+            if (sc->step == 0)
+            {
+                if (tag != 0x30) return sg_scan_bad();
+                sc->pos += hdr;
+                sc->step = 1;
+            }
+            else if (sc->step == 1)
+            {
+                static const BYTE oid_prefix[] = { 0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x07 };
+
+                if (tag != 0x06) return sg_scan_bad();
+                if (size - sc->pos < hdr + len) goto more;
+                if (hdr + len == 11 && !memcmp(p + sc->pos, oid_prefix, sizeof(oid_prefix)) && p[sc->pos + 10] >= 1 && p[sc->pos + 10] <= 3)
+                    sc->kind = p[sc->pos + 10] == 1 ? CMSG_DATA : p[sc->pos + 10] == 2 ? CMSG_SIGNED : CMSG_ENVELOPED;
+                else
+                {
+                    sc->skip = TRUE;   /* digested data, another content type: nothing is streamed */
+                    return TRUE;
+                }
+                sc->pos += hdr + len;
+                sc->step = 2;
+            }
+            else
+            {
+                if (tag != 0xa0) return sg_scan_bad();
+                sc->pos += hdr;
+                sc->step = 3;
+            }
+        }
+        else
+        {
+            const struct sg_op *ops = sc->kind == CMSG_DATA ? sg_ops_data : sc->kind == CMSG_SIGNED ? sg_ops_signed : sg_ops_enveloped;
+            const struct sg_op *op = &ops[sc->op];
+
+            switch (op->op)
+            {
+            case OP_MARK_ENV: sc->env_start = sc->pos; sc->op++; continue;
+            case OP_MARK_ECI: sc->eci_start = sc->pos; sc->op++; continue;
+            case OP_READY:
+                sc->header_ready = TRUE;
+                if (!CDecodeMsg_StreamEnvelopedHeader(msg))
+                {
+                    sc->header_ready = FALSE;
+                    return FALSE;
+                }
+                sc->op++;
+                continue;
+            }
+            r = sg_scan_peek(p + sc->pos, size - sc->pos, &tag, &hdr, &len);
+            if (r < 0) return sg_scan_bad();
+            if (!r) goto more;
+            switch (op->op)
+            {
+            case OP_ENTER:
+            case OP_ENTER_OPT:
+                if (tag != op->tag)
+                {
+                    if (op->op == OP_ENTER_OPT && (tag == 0x00 || tag == 0x31 || (tag & 0xe0) == 0xa0))
+                    {
+                        sc->phase = 2;   /* a signed message with no content in it */
+                        return TRUE;
+                    }
+                    return sg_scan_bad();
+                }
+                if (sc->kind == CMSG_ENVELOPED && sc->op == 5) sc->eci_content = sc->pos + hdr;
+                sc->pos += hdr;
+                sc->op++;
+                break;
+            case OP_SKIP:
+            {
+                DWORD ext;
+
+                if (tag != op->tag) return sg_scan_bad();
+                if (!sg_ber_extent(p + sc->pos, size - sc->pos, 0, &ext)) goto more;
+                sc->pos += ext;
+                sc->op++;
+                break;
+            }
+            case OP_CONTENT:
+            {
+                BYTE want = sc->kind == CMSG_ENVELOPED ? 0x80 : 0x04;
+
+                if ((tag & ~0x20) != want)
+                {
+                    if (sc->kind == CMSG_ENVELOPED ? (tag == 0 || (tag & 0xe0) != 0x80) : sc->kind == CMSG_SIGNED)
+                    {
+                        sc->phase = 2;   /* no (encrypted) content: what follows is something else */
+                        return TRUE;
+                    }
+                    return sg_scan_bad();
+                }
+                if (tag & 0x20)
+                {
+                    sc->stack[0].indef = len == 0xffffffff;
+                    sc->stack[0].rem = len;
+                    sc->depth = 1;
+                    sc->pos += hdr;
+                    if (!sc->stack[0].indef && !len)
+                    {
+                        sc->depth = 0;
+                        sc->phase = 2;
+                        return CDecodeMsg_StreamEmit(msg, p + sc->pos, 0, TRUE);
+                    }
+                }
+                else
+                {
+                    if (len == 0xffffffff) return sg_scan_bad();
+                    sc->depth = 0;
+                    sc->pos += hdr;
+                    sc->prim_rem = len;
+                    if (!len)
+                    {
+                        sc->phase = 2;
+                        return CDecodeMsg_StreamEmit(msg, p + sc->pos, 0, TRUE);
+                    }
+                }
+                sc->phase = 1;
+                break;
+            }
+            }
+        }
+    }
+    while (sc->phase == 1)
+    {
+        DWORD avail = size - sc->pos;
+
+        if (sc->prim_rem)
+        {
+            DWORD n = min(avail, sc->prim_rem);
+            BOOL done;
+
+            if (!n) goto more;
+            if (!sg_scan_consume(sc, n)) return sg_scan_bad();
+            sc->prim_rem -= n;
+            done = !sc->prim_rem && sg_scan_complete(sc);
+            if (done) sc->phase = 2;
+            if (!CDecodeMsg_StreamEmit(msg, p + sc->pos - n, n, done)) return FALSE;
+            if (done) return TRUE;
+            continue;
+        }
+        if (sg_scan_complete(sc))
+        {
+            sc->phase = 2;
+            return CDecodeMsg_StreamEmit(msg, p + sc->pos, 0, TRUE);
+        }
+        r = sg_scan_peek(p + sc->pos, avail, &tag, &hdr, &len);
+        if (r < 0) return sg_scan_bad();
+        if (!r) goto more;
+        if (!tag && !len && hdr == 2 && sc->stack[sc->depth - 1].indef)   /* end of contents */
+        {
+            if (!sg_scan_consume(sc, 2)) return sg_scan_bad();
+            sc->depth--;
+            if (sg_scan_complete(sc))
+            {
+                sc->phase = 2;
+                return CDecodeMsg_StreamEmit(msg, p + sc->pos, 0, TRUE);
+            }
+            continue;
+        }
+        if (tag == 0x04)
+        {
+            if (len == 0xffffffff || !sg_scan_consume(sc, hdr)) return sg_scan_bad();
+            sc->prim_rem = len;
+        }
+        else if (tag == 0x24)
+        {
+            if (sc->depth >= ARRAY_SIZE(sc->stack) || !sg_scan_consume(sc, hdr)) return sg_scan_bad();
+            sc->stack[sc->depth].indef = len == 0xffffffff;
+            sc->stack[sc->depth].rem = len;
+            sc->depth++;
+        }
+        else
+            return sg_scan_bad();
+    }
+more:
+    if (final && sc->phase != 2)
+    {
+        SetLastError(CRYPT_E_STREAM_INSUFFICIENT_DATA);
+        return FALSE;
+    }
+    return TRUE;
+}
