From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qmgr: the versioned BackgroundCopyManager classes

Only CLSID_BackgroundCopyManager was registered and served. Newer clients create the versioned classes (BackgroundCopyManager1_5, 2_0, 2_5, 3_0); OneDrive asks for 3_0 and got "class not registered". The BITS service now serves them with the same manager, and they are registered with the BITS AppID.
---
diff --git a/dlls/qmgr/qmgr.rgs b/dlls/qmgr/qmgr.rgs
index 675505e..bb542ba 100644
--- a/dlls/qmgr/qmgr.rgs
+++ b/dlls/qmgr/qmgr.rgs
@@ -11,5 +11,21 @@ HKCR
         {
             val AppID = s '{69AD4AEE-51BE-439B-A92C-86AE490E8B30}'
         }
+        '{F087771F-D74F-4C1A-BB8A-E16ACA9124EA}'
+        {
+            val AppID = s '{69AD4AEE-51BE-439B-A92C-86AE490E8B30}'
+        }
+        '{6D18AD12-BDE3-4393-B311-099C346E6DF9}'
+        {
+            val AppID = s '{69AD4AEE-51BE-439B-A92C-86AE490E8B30}'
+        }
+        '{03CA98D6-FF5D-49B8-ABC6-03DD84127020}'
+        {
+            val AppID = s '{69AD4AEE-51BE-439B-A92C-86AE490E8B30}'
+        }
+        '{659CDEA7-489E-11D9-A9CD-000D56965251}'
+        {
+            val AppID = s '{69AD4AEE-51BE-439B-A92C-86AE490E8B30}'
+        }
     }
 }
diff --git a/dlls/qmgr/service.c b/dlls/qmgr/service.c
index 635e134..2fdd4c3 100644
--- a/dlls/qmgr/service.c
+++ b/dlls/qmgr/service.c
@@ -97,6 +97,20 @@ StartCount(void)
     if (FAILED(hr))
         return FALSE;
 
+    /* Stained Glass OS (wine-sg 6223): the versioned classes newer clients create (OneDrive asks
+     * for BackgroundCopyManager3_0) are the same manager */
+#ifndef SG_MUTANT_BITS_VERSIONED_CLASSES
+    {
+        static const CLSID *versions[] = { &CLSID_BackgroundCopyManager1_5, &CLSID_BackgroundCopyManager2_0,
+                                           &CLSID_BackgroundCopyManager2_5, &CLSID_BackgroundCopyManager3_0 };
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(versions); i++)
+            CoRegisterClassObject(versions[i], (IUnknown *)&BITS_ClassFactory.IClassFactory_iface,
+                                  CLSCTX_LOCAL_SERVER, REGCLS_MULTIPLEUSE, &dwReg);
+    }
+#endif
+
     return TRUE;
 }
 
