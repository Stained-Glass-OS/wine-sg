From: Stained Glass OS <dev@stained-glass.example>
Subject: wintrust: never skip the chain policy in SoftpubAuthenticode

Security. The disallowed-certificate check fetched the signer's
CERT_SIGNATURE_HASH_PROP_ID into a 20-byte buffer and shared its return value
with the chain check: for any certificate with a SHA-256 signature -- nearly
all of them -- the fetch failed, the chain policy was skipped, no error was
recorded, and WinVerifyTrust reported the signature trusted whatever signed
it. A signature from an unknown issuer verified.

Size the buffer for any hash, pass CertFindCertificateInStore the
CRYPT_HASH_BLOB it expects, and always run the chain policy; the disallowed
check can refuse a certificate but can no longer excuse one.

--- a/dlls/wintrust/softpub.c
+++ b/dlls/wintrust/softpub.c
@@ -1315,13 +1315,17 @@
         ret = TRUE;
         for (i = 0; ret && i < data->csSigners; i++)
         {
-            BYTE hash[20];
+            BYTE hash[64];
             DWORD size = sizeof(hash);
 
-            /* First make sure cert isn't disallowed */
-            if ((ret = CertGetCertificateContextProperty(
+            /* First make sure cert isn't disallowed. The chain policy below
+             * runs whatever happens here: this used to share its result, so a
+             * certificate whose signature hash did not fit a SHA-1-sized
+             * buffer -- any SHA-256 certificate -- skipped the chain check
+             * altogether and verified as trusted. */
+            if (CertGetCertificateContextProperty(
              data->pasSigners[i].pasCertChain[0].pCert,
-             CERT_SIGNATURE_HASH_PROP_ID, hash, &size)))
+             CERT_SIGNATURE_HASH_PROP_ID, hash, &size))
             {
                 static const WCHAR disallowedW[] =
                  { 'D','i','s','a','l','l','o','w','e','d',0 };
@@ -1331,9 +1335,10 @@
 
                 if (disallowed)
                 {
+                    CRYPT_HASH_BLOB blob = { size, hash };
                     PCCERT_CONTEXT found = CertFindCertificateInStore(
                      disallowed, X509_ASN_ENCODING, 0, CERT_FIND_SIGNATURE_HASH,
-                     hash, NULL);
+                     &blob, NULL);
 
                     if (found)
                     {
