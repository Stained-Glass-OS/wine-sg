From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tests: restore one todo_wine of combase roapi, drop marks that pass now (3612)

tests: restore one todo_wine of combase roapi, drop marks that pass now

roapi.c: 1676 removed the todo_wine of ok(factory == NULL) after RoGetActivationFactory
for Wine.Test.Class, but our build (like stock) returns S_OK with a factory there (the hr
check right above stays todo): put the mark back. Marks that now pass because of earlier
sg patches: dinput hid.c and ntoskrnl.c catalog writes (CryptCATPersistStore,
CryptCATPutCatAttrInfo), regedit export value order and slashes, mcicda STOP all.
---
diff --git a/dlls/combase/tests/roapi.c b/dlls/combase/tests/roapi.c
index e26855f..65a45f3 100644
--- a/dlls/combase/tests/roapi.c
+++ b/dlls/combase/tests/roapi.c
@@ -122,6 +122,7 @@ static void test_ActivationFactories(void)
     todo_wine
     ok(hr == E_NOTIMPL || broken(hr == REGDB_E_CLASSNOTREG) /* <= w1064v1809 */,
             "RoGetActivationFactory returned %#lx.\n", hr);
+    todo_wine
     ok(factory == NULL, "got factory %p.\n", factory);
     if (factory) IActivationFactory_Release(factory);
     WindowsDeleteString(str);
diff --git a/dlls/dinput/tests/hid.c b/dlls/dinput/tests/hid.c
index 5e48050..feac3bd 100644
--- a/dlls/dinput/tests/hid.c
+++ b/dlls/dinput/tests/hid.c
@@ -639,7 +639,6 @@ BOOL bus_device_start(void)
     add_file_to_catalog( catalog, L"winetest.inf" );
 
     ret = CryptCATPersistStore( catalog );
-    todo_wine
     ok( ret, "Failed to write catalog, error %lu\n", GetLastError() );
 
     ret = CryptCATClose( catalog );
diff --git a/dlls/ntoskrnl.exe/tests/ntoskrnl.c b/dlls/ntoskrnl.exe/tests/ntoskrnl.c
index 48deda7..c515037 100644
--- a/dlls/ntoskrnl.exe/tests/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/tests/ntoskrnl.c
@@ -1774,18 +1774,18 @@ static void test_pnp_driver(struct testsign_context *ctx)
     ret = !!CryptCATPutCatAttrInfo(catalog, (WCHAR *)L"HWID1",
             CRYPTCAT_ATTR_NAMEASCII | CRYPTCAT_ATTR_DATAASCII | CRYPTCAT_ATTR_AUTHENTICATED,
             sizeof(L"test_hardware_id"), (BYTE *)L"test_hardware_id");
-    todo_wine ok(ret, "failed to add attribute, error %#lx\n", GetLastError());
+    ok(ret, "failed to add attribute, error %#lx\n", GetLastError());
 
     ret = !!CryptCATPutCatAttrInfo(catalog, (WCHAR *)L"OS",
             CRYPTCAT_ATTR_NAMEASCII | CRYPTCAT_ATTR_DATAASCII | CRYPTCAT_ATTR_AUTHENTICATED,
             sizeof(L"VistaX64"), (BYTE *)L"VistaX64");
-    todo_wine ok(ret, "failed to add attribute, error %#lx\n", GetLastError());
+    ok(ret, "failed to add attribute, error %#lx\n", GetLastError());
 
     add_file_to_catalog(catalog, L"winetest.sys");
     add_file_to_catalog(catalog, L"winetest.inf");
 
     ret = CryptCATPersistStore(catalog);
-    todo_wine ok(ret, "Failed to write catalog, error %lu\n", GetLastError());
+    ok(ret, "Failed to write catalog, error %lu\n", GetLastError());
 
     ret = CryptCATClose(catalog);
     ok(ret, "Failed to close catalog, error %lu\n", GetLastError());
diff --git a/dlls/winmm/tests/mcicda.c b/dlls/winmm/tests/mcicda.c
index c59c62a..ef32af0 100644
--- a/dlls/winmm/tests/mcicda.c
+++ b/dlls/winmm/tests/mcicda.c
@@ -603,7 +603,7 @@ START_TEST(mcicda)
     test_play(hwnd);
     test_openclose(hwnd);
     err = mciSendCommandA(MCI_ALL_DEVICE_ID, MCI_STOP, 0, 0);
-    todo_wine ok(!err || broken(err == MCIERR_HARDWARE /* blank CD or testbot without CD-ROM */),
+    ok(!err || broken(err == MCIERR_HARDWARE /* blank CD or testbot without CD-ROM */),
        "STOP all returned %s\n", dbg_mcierr(err));
     err = mciSendStringA("close all", NULL, 0, hwnd);
     ok(!err, "final close all returned %s\n", dbg_mcierr(err));
diff --git a/programs/regedit/tests/regedit.c b/programs/regedit/tests/regedit.c
index 7dde63b..1451a02 100644
--- a/programs/regedit/tests/regedit.c
+++ b/programs/regedit/tests/regedit.c
@@ -3647,7 +3647,7 @@ static void test_export(void)
     close_key(hkey);
 
     run_regedit_exe("regedit.exe /e file.reg HKEY_CURRENT_USER\\" KEY_BASE);
-    ok(compare_export("file.reg", value_order_test, TODO_REG_COMPARE), "compare_export() failed\n");
+    ok(compare_export("file.reg", value_order_test, 0), "compare_export() failed\n");
     delete_key(HKEY_CURRENT_USER, KEY_BASE);
 
     /* Test registry export with empty hex data */
@@ -3740,7 +3740,7 @@ static void test_export(void)
     close_key(hkey);
 
     run_regedit_exe("regedit.exe /e file.reg HKEY_CURRENT_USER\\" KEY_BASE);
-    ok(compare_export("file.reg", slashes_test, TODO_REG_COMPARE), "compare_export() failed\n");
+    ok(compare_export("file.reg", slashes_test, 0), "compare_export() failed\n");
     delete_tree(HKEY_CURRENT_USER, KEY_BASE);
 
     /* Test registry export with escaped null characters */
