From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:54:41 -0700
Subject: [PATCH] msident: ManageIdentities cancels like Logon (3270)

ManageIdentities returned E_NOTIMPL, which is not a documented result; with no identity management dialog it returns E_USER_CANCELLED as Logon does (GUESS).

diff --git a/dlls/msident/msident.c b/dlls/msident/msident.c
index 86c0553..79db017 100644
--- a/dlls/msident/msident.c
+++ b/dlls/msident/msident.c
@@ -178,8 +178,12 @@ static HRESULT WINAPI UserIdentityManager_EnumIdentities(IUserIdentityManager *i
 
 static HRESULT WINAPI UserIdentityManager_ManageIdentities(IUserIdentityManager *iface, HWND hwndParent, DWORD dwFlags)
 {
-    FIXME("(%p %lx)\n", hwndParent, dwFlags);
+    FIXME("(%p %lx) no identity management UI\n", hwndParent, dwFlags);
+    /* the dialog is not there to be left with a change: as for Logon, the user cancels */
+#ifdef SG_MUTANT_MSIDENT
     return E_NOTIMPL;
+#endif
+    return E_USER_CANCELLED;
 }
 
 static HRESULT WINAPI UserIdentityManager_Logon(IUserIdentityManager *iface, HWND hwndParent,
