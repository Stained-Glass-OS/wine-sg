 static HRESULT WINAPI RecycleBin_GetDetailsEx(IShellFolder2 *iface, LPCITEMIDLIST pidl, const SHCOLUMNID *pscid, VARIANT *pv)
 {
-    FIXME("stub\n");
-    return E_NOTIMPL;
+    const WIN32_FIND_DATAW *data;
+    SHELLDETAILS details;
+    SYSTEMTIME st;
+    FILETIME local;
+    UINT i;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p, %p)\n", iface, pidl, pscid, pv);
+
+    if (!pscid || !pv) return E_INVALIDARG;
+    VariantInit(pv);
+    if (!pidl || !(data = get_trash_item_data(pidl))) return E_INVALIDARG;
+
+    for (i = 0; i < COLUMNS_COUNT; i++)
+        if (IsEqualGUID(&pscid->fmtid, RecycleBinColumns[i].fmtid) && pscid->pid == RecycleBinColumns[i].pid)
+            break;
+    if (i == COLUMNS_COUNT) return E_FAIL;
+
+    switch (i)
+    {
+    case COLUMN_SIZE:
+        V_VT(pv) = VT_UI8;
+        V_UI8(pv) = ((ULONGLONG)data->nFileSizeHigh << 32) | data->nFileSizeLow;
+#ifdef SG_MUTANT_RB_SIZE
+        V_UI8(pv) = data->nFileSizeHigh;
+#endif
+        return S_OK;
+    case COLUMN_DATEDEL:
+    case COLUMN_MTIME:
+        /* a date as a variant date, in local time */
+        FileTimeToLocalFileTime(i == COLUMN_DATEDEL ? &data->ftLastAccessTime : &data->ftLastWriteTime, &local);
+        if (!FileTimeToSystemTime(&local, &st) || !SystemTimeToVariantTime(&st, &V_DATE(pv))) return E_FAIL;
+        V_VT(pv) = VT_DATE;
+        return S_OK;
+    }
+    /* the rest are the strings the columns show */
+    if (FAILED(hr = RecycleBin_GetDetailsOf(iface, pidl, i, &details))) return hr;
+    if (FAILED(hr = StrRetToBSTR(&details.str, pidl, &V_BSTR(pv)))) return hr;
+    V_VT(pv) = VT_BSTR;
+    return S_OK;
 }
 
