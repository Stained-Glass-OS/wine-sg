-static HRESULT WINAPI RecycleBin_ParseDisplayName(IShellFolder2 *This, HWND hwnd, LPBC pbc,
+/* the file of an item in the trash directory (malloc'd) */
+static WCHAR *trash_item_path(LPCITEMIDLIST pidl)
+{
+    const WIN32_FIND_DATAW *data = get_trash_item_data(pidl);
+    const WCHAR *filename;
+    WCHAR *path;
+    ULONG len;
+
+    if (!data || !trash_dir) return NULL;
+    filename = (const WCHAR *)(data + 1);
+    len = lstrlenW(trash_dir) + lstrlenW(filename) + 2;
+    if (!(path = malloc(len * sizeof(WCHAR)))) return NULL;
+    swprintf(path, len, L"%s\\%s", trash_dir, filename);
+    return path;
+}
+
+/* the file system pidl of an item, followed by what is left of the pidl after the item's own id */
+static LPITEMIDLIST trash_item_fs_pidl(LPCITEMIDLIST pidl)
+{
+    LPITEMIDLIST fs, full;
+    LPCITEMIDLIST next = ILGetNext(pidl);
+    WCHAR *path = trash_item_path(pidl);
+
+    if (!path) return NULL;
+    fs = ILCreateFromPathW(path);
+    free(path);
+    if (fs && next && next->mkid.cb)
+    {
+        full = ILCombine(fs, next);
+        ILFree(fs);
+        fs = full;
+    }
+    return fs;
+}
+
+static HRESULT WINAPI RecycleBin_ParseDisplayName(IShellFolder2 *iface, HWND hwnd, LPBC pbc,
             LPOLESTR pszDisplayName, ULONG *pchEaten, LPITEMIDLIST *ppidl,
             ULONG *pdwAttributes)
 {
-    FIXME("stub\n");
-    return E_NOTIMPL;
+    RecycleBin *This = impl_from_IShellFolder2(iface);
+    LPITEMIDLIST *pidls;
+    int count = 0, i, found = -1;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p, %s, %p, %p, %p)\n", This, hwnd, pbc, debugstr_w(pszDisplayName), pchEaten, ppidl, pdwAttributes);
+
+    if (!ppidl) return E_INVALIDARG;
+    *ppidl = NULL;
+    if (!pszDisplayName || !pszDisplayName[0]) return E_INVALIDARG;
+    if (pchEaten) *pchEaten = 0;
+
+    /* an item is named by its name in the bin or by the path it was deleted from */
+    if (FAILED(hr = enum_trash_items(&pidls, &count))) return hr;
+    for (i = 0; i < count; i++)
+    {
+        const WIN32_FIND_DATAW *data = get_trash_item_data(pidls[i]);
+
+        if (found < 0 && data && (!lstrcmpiW(pszDisplayName, data->cFileName)
+#ifndef SG_MUTANT_RB_PARSE_NAME
+                || !lstrcmpiW(pszDisplayName, PathFindFileNameW(data->cFileName))
+#endif
+                ))
+            found = i;
+    }
+    if (found >= 0 && (*ppidl = ILClone(pidls[found])))
+    {
+        if (pchEaten) *pchEaten = lstrlenW(pszDisplayName);
+        if (pdwAttributes) hr = IShellFolder2_GetAttributesOf(iface, 1, (LPCITEMIDLIST *)ppidl, pdwAttributes);
+        else hr = S_OK;
+    }
+    else hr = found >= 0 ? E_OUTOFMEMORY : HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    for (i = 0; i < count; i++) ILFree(pidls[i]);
+    SHFree(pidls);
+    return hr;
 }
 
