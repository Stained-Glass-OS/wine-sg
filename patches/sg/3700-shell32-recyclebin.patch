+    /* a verb can be asked for by name (validation) or by the offset of its command */
+    for (i = 0; i < ARRAY_SIZE(commands); i++)
+    {
+        if ((uType == GCS_VALIDATEA || uType == GCS_VALIDATEW) && HIWORD(idCmd))
+        {
+            if (uType == GCS_VALIDATEA)
+            {
+                WCHAR name[32];
+                MultiByteToWideChar(CP_ACP, 0, (const char *)idCmd, -1, name, ARRAY_SIZE(name));
+                found = !lstrcmpiW(name, commands[i].verb);
+            }
+            else found = !lstrcmpiW((const WCHAR *)idCmd, commands[i].verb);
+        }
+        else found = idCmd == commands[i].id;
+        if (found) { verb = commands[i].verb; help_id = commands[i].help; break; }
+    }
+
+    switch (uType)
+    {
+    case GCS_VALIDATEA:
+    case GCS_VALIDATEW:
+        return found ? S_OK : S_FALSE;
+    case GCS_VERBA:
+    case GCS_VERBW:
+    case GCS_HELPTEXTA:
+    case GCS_HELPTEXTW:
+        if (!found || !pszName) return E_INVALIDARG;
+        if (uType == GCS_HELPTEXTA || uType == GCS_HELPTEXTW)
+        {
+            if (!LoadStringW(shell32_hInstance, help_id, help, ARRAY_SIZE(help))) return E_FAIL;
+            verb = help;
+        }
+        if (uType == GCS_VERBA || uType == GCS_HELPTEXTA)
+            WideCharToMultiByte(CP_ACP, 0, verb, -1, pszName, cchMax, NULL, NULL);
+        else
+            lstrcpynW((WCHAR *)pszName, verb, cchMax);
+        return S_OK;
+    }
+    return E_INVALIDARG;
 }
 
