-    return E_NOTIMPL;
+    static const struct { UINT id; const WCHAR *verb; UINT help; } commands[] =
+    {
+#ifdef SG_MUTANT_RB_VERB
+        { IDM_RECYCLEBIN_RESTORE, L"restore", IDS_RECYCLEBIN_RESTORE_HELP },
+#else
+        { IDM_RECYCLEBIN_RESTORE, L"undelete", IDS_RECYCLEBIN_RESTORE_HELP },
+#endif
+        { IDM_RECYCLEBIN_ERASE,   L"delete",   IDS_RECYCLEBIN_ERASE_HELP },
+    };
+    const WCHAR *verb = NULL;
+    WCHAR help[128];
+    unsigned int i;
+    BOOL found = FALSE;
+    UINT help_id = 0;
