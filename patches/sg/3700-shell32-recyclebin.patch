+/*************************************************************************
+ * SHCreateFileExtractIconW        [SHELL32.743]
+ *
+ * An IExtractIcon for a file system object: the icon of its type, as the extension and the
+ * attributes give it.
+ */
 HRESULT WINAPI SHCreateFileExtractIconW(LPCWSTR file, DWORD attribs, REFIID riid, void **ppv)
 {
-  FIXME("%s, %lx, %s, %p\n", debugstr_w(file), attribs, debugstr_guid(riid), ppv);
-  *ppv = NULL;
-  return E_NOTIMPL;
+    IDefaultExtractIconInit *init;
+    SHFILEINFOW info;
+    HRESULT hr;
+
+    TRACE("%s, %lx, %s, %p\n", debugstr_w(file), attribs, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    *ppv = NULL;
+    if (!file) return E_INVALIDARG;
+    if (!IsEqualIID(riid, &IID_IExtractIconA) && !IsEqualIID(riid, &IID_IExtractIconW)) return E_NOINTERFACE;
+
+    if (FAILED(hr = SHCreateDefaultExtractIcon(&IID_IDefaultExtractIconInit, (void **)&init))) return hr;
+    if (SHGetFileInfoW(file, attribs, &info, sizeof(info), SHGFI_USEFILEATTRIBUTES | SHGFI_ICONLOCATION)
+            && info.szDisplayName[0])
+        IDefaultExtractIconInit_SetNormalIcon(init, info.szDisplayName, info.iIcon);
+    else
+        IDefaultExtractIconInit_SetNormalIcon(init, L"shell32.dll", (attribs & FILE_ATTRIBUTE_DIRECTORY) ? 3 : 0);
+    hr = IDefaultExtractIconInit_QueryInterface(init, riid, ppv);
+    IDefaultExtractIconInit_Release(init);
+    return hr;
 }
 
 /*************************************************************************
