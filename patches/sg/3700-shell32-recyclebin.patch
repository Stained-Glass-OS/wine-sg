-static HRESULT WINAPI RecycleBin_BindToStorage(IShellFolder2 *This, LPCITEMIDLIST pidl, LPBC pbc, REFIID riid, void **ppv)
+/* The storage of an item is the stream of its file. */
+static HRESULT WINAPI RecycleBin_BindToStorage(IShellFolder2 *iface, LPCITEMIDLIST pidl, LPBC pbc, REFIID riid, void **ppv)
 {
-    FIXME("(%p, %p, %p, %s, %p) - stub\n", This, pidl, pbc, debugstr_guid(riid), ppv);
-    return E_NOTIMPL;
+    const WIN32_FIND_DATAW *data;
+    LPCITEMIDLIST next;
+    IStream *stream;
+    WCHAR *path;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p, %s, %p)\n", iface, pidl, pbc, debugstr_guid(riid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    *ppv = NULL;
+    if (!pidl || !pidl->mkid.cb || !(data = get_trash_item_data(pidl))) return E_INVALIDARG;
+    next = ILGetNext(pidl);
+    if (next && next->mkid.cb)
+    {
+        /* inside a deleted folder: the folder has the item */
+        IShellFolder *parent;
+        LPCITEMIDLIST child;
+        LPITEMIDLIST fs = trash_item_fs_pidl(pidl);
+
+        if (!fs) return HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
+        hr = SHBindToParent(fs, &IID_IShellFolder, (void **)&parent, &child);
+        if (SUCCEEDED(hr))
+        {
+            hr = IShellFolder_BindToStorage(parent, child, pbc, riid, ppv);
+            IShellFolder_Release(parent);
+        }
+        ILFree(fs);
+        return hr;
+    }
+    if (!IsEqualIID(riid, &IID_IStream) && !IsEqualIID(riid, &IID_ISequentialStream) && !IsEqualIID(riid, &IID_IUnknown))
+        return E_NOINTERFACE;
+    if (data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) return E_FAIL;
+    if (!(path = trash_item_path(pidl))) return E_OUTOFMEMORY;
+    hr = SHCreateStreamOnFileEx(path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream);
+    free(path);
+    if (FAILED(hr)) return hr;
+    hr = IStream_QueryInterface(stream, riid, ppv);
+    IStream_Release(stream);
+    return hr;
 }
 
 static HRESULT WINAPI RecycleBin_CompareIDs(IShellFolder2 *iface, LPARAM lParam, LPCITEMIDLIST pidl1, LPCITEMIDLIST pidl2)
 {
     RecycleBin *This = impl_from_IShellFolder2(iface);
-    int ret;
+    const WIN32_FIND_DATAW *d1 = get_trash_item_data(pidl1), *d2 = get_trash_item_data(pidl2);
+    UINT column = LOWORD(lParam);
+    LONGLONG s1, s2;
+    int ret = 0;
 
-    /* TODO */
     TRACE("(%p, %p, %p, %p)\n", This, (void *)lParam, pidl1, pidl2);
-    if (pidl1->mkid.cb != pidl2->mkid.cb)
-        return MAKE_HRESULT(SEVERITY_SUCCESS, 0, pidl1->mkid.cb - pidl2->mkid.cb);
-    /* Looks too complicated, but in optimized memcpy we might get
-     * a 32bit wide difference and would truncate it to 16 bit, so
-     * erroneously returning equality. */
-    ret = memcmp(pidl1->mkid.abID, pidl2->mkid.abID, pidl1->mkid.cb);
-    if (ret < 0) ret = -1;
-    if (ret > 0) ret =  1;
-    return MAKE_HRESULT(SEVERITY_SUCCESS, 0, (unsigned short)ret);
+
+    if (!d1 || !d2)
+    {
+        /* not our items: the bytes decide */
+        if (pidl1->mkid.cb != pidl2->mkid.cb)
+            return MAKE_HRESULT(SEVERITY_SUCCESS, 0, (unsigned short)(pidl1->mkid.cb < pidl2->mkid.cb ? -1 : 1));
+        ret = memcmp(pidl1->mkid.abID, pidl2->mkid.abID, pidl1->mkid.cb);
+        return MAKE_HRESULT(SEVERITY_SUCCESS, 0, (unsigned short)(ret < 0 ? -1 : ret > 0 ? 1 : 0));
+    }
+
+    /* the column asked for decides, then the name, then where it was deleted from */
+    switch (column)
+    {
+    case COLUMN_DELFROM:
+        ret = lstrcmpiW(d1->cFileName, d2->cFileName);
+        break;
+    case COLUMN_DATEDEL:
+        ret = CompareFileTime(&d1->ftLastAccessTime, &d2->ftLastAccessTime);
+        break;
+    case COLUMN_SIZE:
+        s1 = ((LONGLONG)d1->nFileSizeHigh << 32) | d1->nFileSizeLow;
+        s2 = ((LONGLONG)d2->nFileSizeHigh << 32) | d2->nFileSizeLow;
+        ret = s1 < s2 ? -1 : s1 > s2 ? 1 : 0;
+        break;
+    case COLUMN_TYPE:
+        ret = lstrcmpiW(PathFindExtensionW(d1->cFileName), PathFindExtensionW(d2->cFileName));
+        break;
+    case COLUMN_MTIME:
+        ret = CompareFileTime(&d1->ftLastWriteTime, &d2->ftLastWriteTime);
+        break;
+    }
+    if (!ret) ret = lstrcmpiW(PathFindFileNameW(d1->cFileName), PathFindFileNameW(d2->cFileName));
+    if (!ret) ret = lstrcmpiW(d1->cFileName, d2->cFileName);
+    return MAKE_HRESULT(SEVERITY_SUCCESS, 0, (unsigned short)(ret < 0 ? -1 : ret > 0 ? 1 : 0));
 }
 
