-HRESULT WINAPI SHStartNetConnectionDialog(HWND hwnd, LPCSTR pszRemoteName, DWORD dwType)
+/*************************************************************************
+ * SHInvokePrinterCommandW [SHELL32.@]
+ *
+ * Stained Glass OS (wine-sg 9923): the printer commands as Microsoft documents them (a spec stub, so a
+ * caller crashed), done with the spooler's own calls: PRINTACTION_PROPERTIES shows the printer's
+ * properties (PrinterProperties), PRINTACTION_DOCUMENTDEFAULTS its printing preferences (the person's
+ * own defaults, kept as Windows keeps them: SetPrinter level 9), PRINTACTION_TESTPAGE prints a test page
+ * with the printer's name, driver and port, PRINTACTION_NETINSTALL connects a network printer
+ * (AddPrinterConnection), PRINTACTION_NETINSTALLLINK makes a shortcut to an installed printer in the
+ * folder lpBuf2. PRINTACTION_OPEN and PRINTACTION_OPENNETPRN open the printer's place in Settings
+ * (Printers & scanners: its status, jobs and buttons; there is no separate queue window).
+ * PRINTACTION_SERVERPROPERTIES has no counterpart: ERROR_NOT_SUPPORTED. A printer that does not open
+ * is FALSE with the spooler's error. fModal FALSE returns once the command has started.
+ */
+struct printer_command
+{
+    HWND   hwnd;
+    UINT   action;
+    WCHAR *name;
+    WCHAR *arg;
+};
+
+struct spool_funcs
+{
+    HMODULE module;
+    BOOL (WINAPI *OpenPrinterW)(WCHAR *, HANDLE *, PRINTER_DEFAULTSW *);
+    BOOL (WINAPI *ClosePrinter)(HANDLE);
+    BOOL (WINAPI *PrinterProperties)(HWND, HANDLE);
+    LONG (WINAPI *DocumentPropertiesW)(HWND, HANDLE, WCHAR *, DEVMODEW *, DEVMODEW *, DWORD);
+    BOOL (WINAPI *SetPrinterW)(HANDLE, DWORD, BYTE *, DWORD);
+    BOOL (WINAPI *GetPrinterW)(HANDLE, DWORD, BYTE *, DWORD, DWORD *);
+    BOOL (WINAPI *AddPrinterConnectionW)(WCHAR *);
+};
+
+static BOOL load_spool(struct spool_funcs *f)
+{
+    if (!(f->module = LoadLibraryW(L"winspool.drv"))) return FALSE;
+#define GETFN(n) if (!(f->n = (void *)GetProcAddress(f->module, #n))) { FreeLibrary(f->module); return FALSE; }
+    GETFN(OpenPrinterW) GETFN(ClosePrinter) GETFN(PrinterProperties) GETFN(DocumentPropertiesW)
+    GETFN(SetPrinterW) GETFN(GetPrinterW) GETFN(AddPrinterConnectionW)
+#undef GETFN
+    return TRUE;
+}
+
+/* the printing preferences dialog; what the person chooses becomes their defaults for the printer */
+static BOOL printer_document_defaults(struct spool_funcs *f, HWND hwnd, HANDLE printer, WCHAR *name)
+{
+    DEVMODEW *dm;
+    LONG size, r;
+    BOOL ret = FALSE;
+
+    if ((size = f->DocumentPropertiesW(hwnd, printer, name, NULL, NULL, 0)) <= 0) return FALSE;
+    if (!(dm = calloc(1, size))) return FALSE;
+    if (f->DocumentPropertiesW(hwnd, printer, name, dm, NULL, DM_OUT_BUFFER) == IDOK)
+    {
+        r = f->DocumentPropertiesW(hwnd, printer, name, dm, dm, DM_IN_BUFFER | DM_IN_PROMPT | DM_OUT_BUFFER);
+        if (r == IDOK)
+        {
+            PRINTER_INFO_9W pi9 = { dm };
+            ret = f->SetPrinterW(printer, 9, (BYTE *)&pi9, 0);
+        }
+        else ret = (r == IDCANCEL);
+    }
+    free(dm);
+    return ret;
+}
+
+/* a page with the printer's name, driver and port on it, through its driver */
+static BOOL printer_test_page(struct spool_funcs *f, HANDLE printer, WCHAR *name)
+{
+    DOCINFOW di = { sizeof(di), L"Test Page" };
+    PRINTER_INFO_2W *pi = NULL;
+    WCHAR lines[5][300];
+    DWORD size = 0;
+    HFONT font, old;
+    TEXTMETRICW tm;
+    int i, y, w, h;
+    BOOL ok;
+    HDC dc;
+
+    f->GetPrinterW(printer, 2, NULL, 0, &size);
+    if (size && (pi = malloc(size)) && !f->GetPrinterW(printer, 2, (BYTE *)pi, size, &size))
+    {
+        free(pi);
+        pi = NULL;
+    }
+    lstrcpynW(lines[0], L"Printer test page", 300);
+    swprintf(lines[1], 300, L"Printer: %s", name);
+    swprintf(lines[2], 300, L"Driver: %s", pi && pi->pDriverName ? pi->pDriverName : L"");
+    swprintf(lines[3], 300, L"Port: %s", pi && pi->pPortName ? pi->pPortName : L"");
+    lstrcpynW(lines[4], L"If you can read this, the printer prints.", 300);
+    dc = CreateDCW(L"WINSPOOL", name, NULL, pi ? pi->pDevMode : NULL);
+    free(pi);
+    if (!dc) return FALSE;
+    w = GetDeviceCaps(dc, HORZRES);
+    h = GetDeviceCaps(dc, VERTRES);
+    font = CreateFontW(-max(h / 50, 4), 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, ANTIALIASED_QUALITY, 0,
+                       L"Segoe UI");
+    ok = StartDocW(dc, &di) > 0 && StartPage(dc) > 0;
+    if (ok)
+    {
+        old = SelectObject(dc, font);
+        GetTextMetricsW(dc, &tm);
+        for (i = 0, y = h / 10; i < ARRAY_SIZE(lines); i++, y += tm.tmHeight * 3 / 2)
+            TextOutW(dc, w / 10, y, lines[i], lstrlenW(lines[i]));
+        SelectObject(dc, old);
+        ok = EndPage(dc) > 0 && EndDoc(dc) > 0;
+    }
+    else AbortDoc(dc);
+    DeleteObject(font);
+    DeleteDC(dc);
+    return ok;
+}
+
+/* a shortcut to the printer (its item in the Printers folder) in the folder given */
+static BOOL printer_link(const WCHAR *name, const WCHAR *folder)
+{
+    LPITEMIDLIST printers = NULL, child = NULL, full = NULL;
+    IShellFolder *desktop = NULL, *pf = NULL;
+    IShellLinkW *sl = NULL;
+    IPersistFile *file = NULL;
+    WCHAR path[MAX_PATH], base[MAX_PATH], *p;
+    const WCHAR *server;
+    HRESULT hr;
+
+    if (!folder || !*folder) return FALSE;
+    /* \\server\printer is named "printer on server", as Windows names it */
+    if (name[0] == '\\' && name[1] == '\\' && (p = wcschr(name + 2, '\\')))
+    {
+        server = name + 2;
+        swprintf(base, ARRAY_SIZE(base), L"%s on %.*s", p + 1, (int)(p - server), server);
+    }
+    else lstrcpynW(base, name, ARRAY_SIZE(base));
+    for (p = base; *p; p++) if (wcschr(L"\\/:*?\"<>|", *p)) *p = '_';
+    if (swprintf(path, ARRAY_SIZE(path), L"%s\\%s.lnk", folder, base) < 0) return FALSE;
+
+    hr = SHGetSpecialFolderLocation(NULL, CSIDL_PRINTERS, &printers);
+    if (SUCCEEDED(hr)) hr = SHGetDesktopFolder(&desktop);
+    if (SUCCEEDED(hr)) hr = IShellFolder_BindToObject(desktop, printers, NULL, &IID_IShellFolder, (void **)&pf);
+    if (SUCCEEDED(hr)) hr = IShellFolder_ParseDisplayName(pf, NULL, NULL, (WCHAR *)name, NULL, &child, NULL);
+    if (SUCCEEDED(hr)) hr = (full = ILCombine(printers, child)) ? S_OK : E_OUTOFMEMORY;
+    if (SUCCEEDED(hr)) hr = CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&sl);
+    if (SUCCEEDED(hr)) hr = IShellLinkW_SetIDList(sl, full);
+    if (SUCCEEDED(hr)) hr = IShellLinkW_QueryInterface(sl, &IID_IPersistFile, (void **)&file);
+    if (SUCCEEDED(hr)) hr = IPersistFile_Save(file, path, TRUE);
+    if (file) IPersistFile_Release(file);
+    if (sl) IShellLinkW_Release(sl);
+    if (pf) IShellFolder_Release(pf);
+    if (desktop) IShellFolder_Release(desktop);
+    ILFree(full);
+    ILFree(child);
+    ILFree(printers);
+    if (FAILED(hr)) SetLastError(HRESULT_CODE(hr));
+    return SUCCEEDED(hr);
+}
+
+static BOOL run_printer_command(struct printer_command *cmd)
+{
+    struct spool_funcs f;
+    HANDLE printer = NULL;
+    BOOL ret = FALSE, com;
+    DWORD err;
+
+    if (!load_spool(&f)) return FALSE;
+    com = SUCCEEDED(CoInitializeEx(NULL, COINIT_APARTMENTTHREADED));
+    if (cmd->action == PRINTACTION_NETINSTALL)
+        ret = f.AddPrinterConnectionW(cmd->name);
+    else if (f.OpenPrinterW(cmd->name, &printer, NULL))
+    {
+        switch (cmd->action)
+        {
+        case PRINTACTION_OPEN:
+        case PRINTACTION_OPENNETPRN:
+            ret = (INT_PTR)ShellExecuteW(cmd->hwnd, NULL, L"ms-settings:printers", NULL, NULL, SW_SHOWNORMAL) > 32;
+            break;
+        case PRINTACTION_PROPERTIES:
+            if (cmd->arg) FIXME("page %s is not chosen\n", debugstr_w(cmd->arg));
+            ret = f.PrinterProperties(cmd->hwnd, printer);
+            break;
+        case PRINTACTION_DOCUMENTDEFAULTS:
+            ret = printer_document_defaults(&f, cmd->hwnd, printer, cmd->name);
+            break;
+        case PRINTACTION_TESTPAGE:
+#ifndef SG_MUTANT_PRINTCMD_NO_TESTPAGE
+            ret = printer_test_page(&f, printer, cmd->name);
+#endif
+            break;
+        case PRINTACTION_NETINSTALLLINK:
+            ret = printer_link(cmd->name, cmd->arg);
+            break;
+        }
+    }
+    err = GetLastError();
+    if (printer) f.ClosePrinter(printer);
+    if (com) CoUninitialize();
+    FreeLibrary(f.module);
+    SetLastError(ret ? ERROR_SUCCESS : err);
+    return ret;
+}
+
+static void free_printer_command(struct printer_command *cmd)
+{
+    free(cmd->name);
+    free(cmd->arg);
+    free(cmd);
+}
+
+static DWORD WINAPI printer_command_thread(void *arg)
+{
+    struct printer_command *cmd = arg;
+    BOOL ret = run_printer_command(cmd);
+
+    free_printer_command(cmd);
+    return ret;
+}
+
+BOOL WINAPI SHInvokePrinterCommandW(HWND hwnd, UINT action, LPCWSTR buf1, LPCWSTR buf2, BOOL modal)
+{
+    struct printer_command *cmd;
+    HANDLE thread;
+    BOOL ret;
+
+    TRACE("%p, %u, %s, %s, %d\n", hwnd, action, debugstr_w(buf1),
+          IS_INTRESOURCE(buf2) ? wine_dbg_sprintf("#%Iu", (ULONG_PTR)buf2) : debugstr_w(buf2), modal);
+
+    if (action > PRINTACTION_SERVERPROPERTIES || !buf1 || !*buf1)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (action == PRINTACTION_SERVERPROPERTIES)
+    {
+        FIXME("print server properties of %s: no such dialog\n", debugstr_w(buf1));
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (!(cmd = calloc(1, sizeof(*cmd))) || !(cmd->name = wcsdup(buf1)))
+    {
+        free(cmd);
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    cmd->hwnd = hwnd;
+    cmd->action = action;
+    /* lpBuf2 is a page index (high word zero) for PRINTACTION_PROPERTIES */
+    if (buf2 && !IS_INTRESOURCE(buf2)) cmd->arg = wcsdup(buf2);
+
+    if (modal)
+    {
+        ret = run_printer_command(cmd);
+        free_printer_command(cmd);
+        return ret;
+    }
+    /* started: the printer must exist (the spooler's error otherwise), the rest runs on its own */
+    if (action != PRINTACTION_NETINSTALL)
+    {
+        struct spool_funcs f;
+        HANDLE printer;
+
+        if (!load_spool(&f))
+        {
+            free_printer_command(cmd);
+            return FALSE;
+        }
+        ret = f.OpenPrinterW(cmd->name, &printer, NULL);
+        if (ret) f.ClosePrinter(printer);
+        FreeLibrary(f.module);
+        if (!ret)
+        {
+            free_printer_command(cmd);
+            return FALSE;
+        }
+    }
+    if (!(thread = CreateThread(NULL, 0, printer_command_thread, cmd, 0, NULL)))
+    {
+        free_printer_command(cmd);
+        return FALSE;
+    }
+    CloseHandle(thread);
+    return TRUE;
+}
+
+/*************************************************************************
+ * SHInvokePrinterCommandA [SHELL32.@]
+ */
+BOOL WINAPI SHInvokePrinterCommandA(HWND hwnd, UINT action, LPCSTR buf1, LPCSTR buf2, BOOL modal)
+{
+    WCHAR *w1 = NULL, *w2 = NULL;
+    BOOL ret;
+    int len;
+
+    if (buf1 && (len = MultiByteToWideChar(CP_ACP, 0, buf1, -1, NULL, 0)) && (w1 = malloc(len * sizeof(WCHAR))))
+        MultiByteToWideChar(CP_ACP, 0, buf1, -1, w1, len);
+    if (buf2 && IS_INTRESOURCE(buf2)) w2 = (WCHAR *)buf2;
+    else if (buf2 && (len = MultiByteToWideChar(CP_ACP, 0, buf2, -1, NULL, 0)) && (w2 = malloc(len * sizeof(WCHAR))))
+        MultiByteToWideChar(CP_ACP, 0, buf2, -1, w2, len);
+    ret = SHInvokePrinterCommandW(hwnd, action, w1, w2, modal);
+    free(w1);
+    if (!IS_INTRESOURCE(w2)) free(w2);
+    return ret;
+}
