+/*************************************************************************
+ * SHStartNetConnectionDialogA [SHELL32.12]
+ * SHStartNetConnectionDialog  [SHELL32.215]
+ */
+HRESULT WINAPI SHStartNetConnectionDialog(HWND hwnd, LPCSTR pszRemoteName, DWORD dwType)
+{
+    WCHAR remote[MAX_PATH];
+
+    TRACE("%p, %s, 0x%08lx\n", hwnd, debugstr_a(pszRemoteName), dwType);
+
+    if (!pszRemoteName) return SHStartNetConnectionDialogW(hwnd, NULL, dwType);
+    MultiByteToWideChar(CP_ACP, 0, pszRemoteName, -1, remote, ARRAY_SIZE(remote));
+    remote[ARRAY_SIZE(remote) - 1] = 0;
+    return SHStartNetConnectionDialogW(hwnd, remote, dwType);
 }
 
