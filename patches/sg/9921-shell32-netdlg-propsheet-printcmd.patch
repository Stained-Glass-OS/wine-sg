     }
     if (pszRemoteName && *pszRemoteName)
     {
-        MultiByteToWideChar(CP_ACP, 0, pszRemoteName, -1, remote, ARRAY_SIZE(remote));
+        lstrcpynW(remote, pszRemoteName, ARRAY_SIZE(remote));
         res.lpRemoteName = remote;
     }
-    res.dwType = dwType ? dwType : RESOURCETYPE_DISK;
