+/* Stained Glass OS (wine-sg 9922): SHOpenPropSheetW / SHOpenPropSheetA, as Microsoft documents them (spec
+ * stubs, and the W name was not exported, so a program importing it did not start). The pages are the
+ * default CLSID's (when given) and those of the PropertySheetHandlers under each key, each handler
+ * initialized with the data object and its key; the sheet opens modally at the named start page and
+ * the result is whether it was made. */
+#define SG_PROPSHEET_MAX_PAGES 64
+
+struct open_propsheet
+{
+    PROPSHEETHEADERW psh;
+    HPROPSHEETPAGE   pages[SG_PROPSHEET_MAX_PAGES];
+};
+
+static BOOL CALLBACK open_propsheet_add(HPROPSHEETPAGE page, LPARAM lparam)
+{
+    struct open_propsheet *ops = (struct open_propsheet *)lparam;
+
+    if (ops->psh.nPages >= SG_PROPSHEET_MAX_PAGES) return FALSE;
+    ops->pages[ops->psh.nPages++] = page;
+    return TRUE;
+}
+
+static void open_propsheet_default(struct open_propsheet *ops, const CLSID *clsid, IDataObject *dobj, HKEY key)
+{
+    IShellPropSheetExt *ext;
+    IShellExtInit *init;
+
+    if (FAILED(CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IShellPropSheetExt, (void **)&ext)))
+    {
+        WARN("no property sheet handler %s\n", debugstr_guid(clsid));
+        return;
+    }
+    if (SUCCEEDED(IShellPropSheetExt_QueryInterface(ext, &IID_IShellExtInit, (void **)&init)))
+    {
+        if (SUCCEEDED(IShellExtInit_Initialize(init, NULL, dobj, key)))
+            IShellPropSheetExt_AddPages(ext, open_propsheet_add, (LPARAM)ops);
+        IShellExtInit_Release(init);
+    }
+    IShellPropSheetExt_Release(ext);
+}
+
+BOOL WINAPI SHOpenPropSheetW(LPCWSTR caption, HKEY keys[], UINT count, const CLSID *default_clsid,
+                             IDataObject *dobj, IShellBrowser *browser, LPCWSTR start_page)
+{
+    struct open_propsheet *ops;
+    HPSXA exts[16] = { 0 };
+    UINT i, nexts = 0;
+    INT_PTR ret;
+
+    TRACE("%s, %p, %u, %s, %p, %p, %s\n", debugstr_w(caption), keys, count, debugstr_guid(default_clsid),
+          dobj, browser, debugstr_w(start_page));
+
+    if (!(ops = calloc(1, sizeof(*ops)))) return FALSE;
+    ops->psh.dwSize = sizeof(ops->psh);
+    ops->psh.dwFlags = PSH_PROPTITLE;
+    ops->psh.hwndParent = NULL;
+    ops->psh.pszCaption = caption ? caption : L"";
+    ops->psh.phpage = ops->pages;
+
+    if (default_clsid) open_propsheet_default(ops, default_clsid, dobj, count && keys ? keys[0] : NULL);
+    for (i = 0; keys && i < count && nexts < ARRAY_SIZE(exts); i++)
+    {
+        if (!keys[i]) continue;
+        if (!(exts[nexts] = SHCreatePropSheetExtArrayEx(keys[i], NULL, SG_PROPSHEET_MAX_PAGES, dobj))) continue;
+        SHAddFromPropSheetExtArray(exts[nexts], open_propsheet_add, (LPARAM)ops);
+        nexts++;
+    }
+#ifdef SG_MUTANT_PROPSHEET_NO_HANDLERS
+    for (i = 0; i < ops->psh.nPages; i++) DestroyPropertySheetPage(ops->pages[i]);
+    ops->psh.nPages = 0;
+#endif
+
+    if (!ops->psh.nPages) ret = -1;
+    else
+    {
+        if (start_page && *start_page)
+        {
+            ops->psh.dwFlags |= PSH_USEPSTARTPAGE;
+            ops->psh.pStartPage = start_page;
+        }
+        ret = PropertySheetW(&ops->psh);
+    }
+    for (i = 0; i < nexts; i++) SHDestroyPropSheetExtArray(exts[i]);
+    free(ops);
+    TRACE("-> %Id\n", ret);
+    return ret >= 0;
+}
+
+BOOL WINAPI SHOpenPropSheetA(LPCSTR caption, HKEY keys[], UINT count, const CLSID *default_clsid,
+                             IDataObject *dobj, IShellBrowser *browser, LPCSTR start_page)
+{
+    WCHAR *wcaption = NULL, *wstart = NULL;
+    BOOL ret;
+    int len;
+
+    if (caption && (len = MultiByteToWideChar(CP_ACP, 0, caption, -1, NULL, 0)) &&
+        (wcaption = malloc(len * sizeof(WCHAR))))
+        MultiByteToWideChar(CP_ACP, 0, caption, -1, wcaption, len);
+    if (start_page && (len = MultiByteToWideChar(CP_ACP, 0, start_page, -1, NULL, 0)) &&
+        (wstart = malloc(len * sizeof(WCHAR))))
+        MultiByteToWideChar(CP_ACP, 0, start_page, -1, wstart, len);
+    ret = SHOpenPropSheetW(wcaption, keys, count, default_clsid, dobj, browser, wstart);
+    free(wcaption);
+    free(wstart);
+    return ret;
+}
