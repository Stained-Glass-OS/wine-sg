-    if (!(mpr = LoadLibraryW(L"mpr.dll"))) return HRESULT_FROM_WIN32(GetLastError());
+    if (!(mpr = LoadLibraryW(L"mpr.dll"))) return S_OK;
     if (!(connect_dialog = (void *)GetProcAddress(mpr, "WNetConnectionDialog1W")))
     {
         FreeLibrary(mpr);
-        return E_NOTIMPL;
