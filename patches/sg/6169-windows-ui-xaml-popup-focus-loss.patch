From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: light-dismiss popups close when their island loses the focus

A Popup with IsLightDismissEnabled now also closes when the island it was opened from loses the keyboard to a window outside it, as on Windows; before, only a click elsewhere closed it. NanaZip's address bar suggestions stayed open over the file list after Enter navigated and the list took the focus. A popup without light dismiss, and popups of other islands, stay. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/hosting.c b/dlls/windows.ui.xaml/hosting.c
index 969a68e..1dba236 100644
--- a/dlls/windows.ui.xaml/hosting.c
+++ b/dlls/windows.ui.xaml/hosting.c
@@ -555,6 +555,7 @@ static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
     case WM_KILLFOCUS:
     {
         struct xaml_source *source = (struct xaml_source *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+        if (msg == WM_KILLFOCUS) xaml_popups_focus_lost( hwnd, (HWND)wparam );
         if (source && xaml_key_message( hwnd, msg, wparam, lparam, source->content )) return 0;
         break;
     }
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index 70dd26c..d1a1692 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -390,6 +390,7 @@ HWND xaml_popup_window_open( IInspectable *child, HWND owner, POINT pt );
 void xaml_popup_window_close( HWND hwnd );
 HWND xaml_element_window( struct uielem *elem );
 void xaml_popups_light_dismiss( HWND clicked );
+void xaml_popups_focus_lost( HWND island, HWND focus );
 void xaml_popup_check( struct uielem *popup );
 IInspectable *xaml_context_flyout( struct uielem *elem );
 BOOL xaml_flyout_show( IInspectable *flyout, struct uielem *target, const POINT *at );
diff --git a/dlls/windows.ui.xaml/textinput.c b/dlls/windows.ui.xaml/textinput.c
index 88f6cb9..973be19 100644
--- a/dlls/windows.ui.xaml/textinput.c
+++ b/dlls/windows.ui.xaml/textinput.c
@@ -858,6 +858,7 @@ struct popup
     struct xiface IPopup_iface;
     struct handler_list opened, closed;
     HWND window;                    /* showing its child while it is open */
+    HWND island;                    /* the island it was opened from */
     struct list entry;              /* in open_popups while it has a window */
 };
 
@@ -923,6 +924,7 @@ void xaml_popup_check( struct uielem *elem )
         pt.y += get_dbl( &elem->d, prop_popup_voffset );
         ClientToScreen( owner, &pt );
         if (!(popup->window = xaml_popup_window_open( child, owner, pt ))) return;
+        popup->island = owner;
         IUnknown_AddRef( popup->e.d.obj.outer );   /* open popups are kept */
         list_add_tail( &open_popups, &popup->entry );
         TRACE( "%p: open in %p at %ld,%ld\n", popup, popup->window, pt.x, pt.y );
@@ -953,6 +955,25 @@ void xaml_popups_light_dismiss( HWND clicked )
     xaml_flyouts_light_dismiss( clicked );
 }
 
+/* an island lost the keyboard to a window that is neither one of its popups nor inside it: its
+ * light-dismiss popups close, as they do when it loses the focus on Windows */
+void xaml_popups_focus_lost( HWND island, HWND focus )
+{
+    struct popup *popup, *next;
+
+    if (focus && (focus == island || IsChild( island, focus ))) return;
+    LIST_FOR_EACH_ENTRY_SAFE( popup, next, &open_popups, struct popup, entry )
+    {
+        if (popup->island != island || !get_bool( &popup->e.d, prop_popup_light_dismiss )) continue;
+        if (focus && (focus == popup->window || IsChild( popup->window, focus ))) continue;
+#ifdef SG_MUTANT_POPUP_STAYS_ON_FOCUS_LOSS
+        continue;
+#endif
+        TRACE( "%p: closed, the focus went to %p\n", popup, focus );
+        put_box( &popup->e.d, prop_popup_is_open, xbox_boolean( FALSE ) );
+    }
+}
+
 static void popup_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
 {
     used->width = used->height = 0;
