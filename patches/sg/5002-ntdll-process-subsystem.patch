From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Answer ProcessSubsystemInformation.

NtQueryInformationProcess answers ProcessSubsystemInformation (75), which
the documentation describes as the process's SUBSYSTEM_INFORMATION_TYPE:
every process here is a Win32 one (SubsystemInformationTypeWin32, 0). The
buffer must be a ULONG and the handle valid. wow64 passes the class through.

Gate: test/ntdll-subsystem-gate.sh (64/32).
---
 dlls/ntdll/unix/process.c | 23 +++++++++++++++++++++++
 dlls/wow64/process.c      |  1 +
 2 files changed, 24 insertions(+)

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 6b2b2b1..5bcd09a 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -2332,6 +2332,29 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
             break;
         }
 
+    case ProcessSubsystemInformation:
+        /* every process here is a Win32 one (SubsystemInformationTypeWin32) */
+        len = sizeof(ULONG);
+        if (size != sizeof(ULONG))
+        {
+            ret = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        SERVER_START_REQ(get_process_info)
+        {
+            req->handle = wine_server_obj_handle( handle );
+            ret = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        if (ret) break;
+        if (!info) ret = STATUS_ACCESS_VIOLATION;
+#ifndef SG_MUTANT_SUBSYSTEM_WRONG
+        else *(ULONG *)info = 0;
+#else
+        else *(ULONG *)info = 1;
+#endif
+        break;
+
     default:
         FIXME("(%p,info_class=%d,%p,0x%08x,%p) Unknown information class\n",
               handle, class, info, (int)size, ret_len );
diff --git a/dlls/wow64/process.c b/dlls/wow64/process.c
index a644c16..0175f79 100644
--- a/dlls/wow64/process.c
+++ b/dlls/wow64/process.c
@@ -559,6 +559,7 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
     case ProcessHandleCount:  /* ULONG */
     case ProcessSessionInformation:  /* ULONG */
     case ProcessDebugFlags:  /* ULONG */
+    case ProcessSubsystemInformation:  /* ULONG (SUBSYSTEM_INFORMATION_TYPE) */
     case ProcessExecuteFlags:  /* ULONG */
     case ProcessCookie:  /* ULONG */
     case ProcessCycleTime:  /* PROCESS_CYCLE_TIME_INFORMATION */
