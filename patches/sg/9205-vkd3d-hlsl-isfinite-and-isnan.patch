From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vkd3d-shader: the HLSL intrinsics isfinite() and isnan()

The HLSL compiler knew isinf() only: "Function "isfinite" is not defined".
Paint.NET 5.2 compiles its effects' compute shaders at run time (Auto-Level,
Levels) and they use isfinite(). As the HLSL reference documents them, per
component: isfinite is true for a value neither infinite nor NaN, isnan for
NaN; integers are always finite and never NaN. Shader model 4 and later test
the exponent bits (as isinf is lowered); earlier models compare abs(x) with
FLT_MAX and x with itself.
---
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.y
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.y
@@ -4237,6 +4237,69 @@
     return !!add_expr(ctx, params->instrs, HLSL_OP1_ISINF, args, bool_type, loc);
 }
 
+#ifndef SG_MUTANT_HLSL_NO_ISFINITE
+/* wine-sg 9205: isfinite() and isnan(), as the HLSL reference documents them: per component, whether the
+ * value is neither infinite nor NaN, and whether it is NaN (Paint.NET's effects compile shaders using them
+ * at run time). Integers are always finite and never NaN. */
+static bool write_float_class(struct hlsl_ctx *ctx, const struct parse_initializer *params,
+        const struct vkd3d_shader_location *loc, const char *name, bool nan)
+{
+    struct hlsl_type *type = params->args[0]->data_type, *bool_type;
+    struct hlsl_ir_function_decl *func;
+    char *body;
+
+    static const char template_sm4[] =
+            "%s %s(%s x)\n"
+            "{\n"
+            "    return (asuint(x) & 0x7fffffff) %s 0x7f800000;\n"
+            "}";
+    static const char template_sm2[] =
+            "%s %s(%s x)\n"
+            "{\n"
+            "    return %s;\n"
+            "}";
+
+    if (hlsl_type_is_integer(type))
+    {
+        struct hlsl_ir_node *c;
+
+        bool_type = hlsl_change_base_type(ctx, type, HLSL_TYPE_BOOL);
+        c = hlsl_block_add_bool_constant(ctx, params->instrs, !nan, loc);
+        return !!add_implicit_conversion(ctx, params->instrs, c, bool_type, loc);
+    }
+    if (!elementwise_intrinsic_float_convert_args(ctx, params, loc))
+        return false;
+    type = params->args[0]->data_type;
+    bool_type = hlsl_change_base_type(ctx, type, HLSL_TYPE_BOOL);
+
+    if (hlsl_version_ge(ctx, 4, 0))
+        body = hlsl_sprintf_alloc(ctx, template_sm4, bool_type->name, name, type->name, nan ? ">" : "<");
+    else
+        body = hlsl_sprintf_alloc(ctx, template_sm2, bool_type->name, name, type->name,
+                nan ? "x != x" : "abs(x) <= 3.402823466e+38");
+    if (!body)
+        return false;
+    func = hlsl_compile_internal_function(ctx, name, body);
+    vkd3d_free(body);
+    if (!func)
+        return false;
+
+    return !!add_user_call(ctx, func, params, loc);
+}
+
+static bool intrinsic_isfinite(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    return write_float_class(ctx, params, loc, "isfinite", false);
+}
+
+static bool intrinsic_isnan(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    return write_float_class(ctx, params, loc, "isnan", true);
+}
+#endif
+
 static bool intrinsic_ldexp(struct hlsl_ctx *ctx,
         const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
 {
@@ -5620,7 +5683,13 @@
     {"frac",                                1, true,  intrinsic_frac},
     {"frexp",                               2, true,  intrinsic_frexp},
     {"fwidth",                              1, true,  intrinsic_fwidth},
+#ifndef SG_MUTANT_HLSL_NO_ISFINITE
+    {"isfinite",                            1, true,  intrinsic_isfinite},
+#endif
     {"isinf",                               1, true,  intrinsic_isinf},
+#ifndef SG_MUTANT_HLSL_NO_ISFINITE
+    {"isnan",                               1, true,  intrinsic_isnan},
+#endif
     {"ldexp",                               2, true,  intrinsic_ldexp},
     {"length",                              1, true,  intrinsic_length},
     {"lerp",                                3, true,  intrinsic_lerp},
