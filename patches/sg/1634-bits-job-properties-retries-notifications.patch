+/* Stained Glass OS: the job was changed */
+void job_touch(BackgroundCopyJobImpl *job)
+{
+    GetSystemTimeAsFileTime(&job->modified);
+}
+
+/* the caller's account, integrity level and elevation, for a job it makes
+ * or takes */
+HRESULT job_caller_owner(WCHAR **sid, ULONG *il, BOOL *elevated)
+{
+    BYTE buf[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)], label[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_MANDATORY_LABEL)];
+    TOKEN_ELEVATION elevation;
+    BOOL impersonating;
+    HANDLE token;
+    WCHAR *str;
+    DWORD len;
+    BOOL ret;
+
+    *sid = NULL;
+    *il = SECURITY_MANDATORY_MEDIUM_RID;
+    *elevated = FALSE;
+    impersonating = SUCCEEDED(CoImpersonateClient());
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &token);
+    if (impersonating) CoRevertToSelf();
+    if (!ret && !OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return HRESULT_FROM_WIN32(GetLastError());
+    if (GetTokenInformation(token, TokenUser, buf, sizeof(buf), &len) &&
+        ConvertSidToStringSidW(((TOKEN_USER *)buf)->User.Sid, &str))
+    {
+        *sid = wcsdup(str);
+        LocalFree(str);
+    }
+    if (GetTokenInformation(token, TokenIntegrityLevel, label, sizeof(label), &len))
+    {
+        PSID ilsid = ((TOKEN_MANDATORY_LABEL *)label)->Label.Sid;
+        *il = *GetSidSubAuthority(ilsid, *GetSidSubAuthorityCount(ilsid) - 1);
+    }
+    if (GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &len))
+        *elevated = elevation.TokenIsElevated;
+    CloseHandle(token);
+    return *sid ? S_OK : E_OUTOFMEMORY;
+}
+
+static void run_notify_cmdline(BackgroundCopyJobImpl *job)
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR *line;
+
+    if (!job->notify_prog) return;
+    /* the parameters begin with the program's name, as a command line does */
+    line = wcsdup(job->notify_params ? job->notify_params : job->notify_prog);
+    TRACE("running %s %s\n", debugstr_w(job->notify_prog), debugstr_w(line));
+    if (line && CreateProcessW(job->notify_prog, line, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi))
+    {
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+    }
+    else WARN("could not run %s, error %lu\n", debugstr_w(job->notify_prog), GetLastError());
+    free(line);
+}
+
+static HRESULT create_copy_error(BG_ERROR_CONTEXT context, HRESULT code, IBackgroundCopyFile2 *file,
+                                 IBackgroundCopyError **obj);
+
+/* errors a retry may get past: the network, a busy server */
+static BOOL is_transient_error(HRESULT hr)
+{
+    static const DWORD win32[] = { ERROR_WINHTTP_TIMEOUT, ERROR_WINHTTP_NAME_NOT_RESOLVED, ERROR_WINHTTP_CANNOT_CONNECT,
+                                   ERROR_WINHTTP_CONNECTION_ERROR, ERROR_WINHTTP_RESEND_REQUEST };
+    unsigned int i;
+
+    if (hr == BG_E_HTTP_ERROR_503 || hr == BG_E_HTTP_ERROR_504 || hr == BG_E_NETWORK_DISCONNECTED) return TRUE;
+    for (i = 0; i < ARRAY_SIZE(win32); i++)
+        if (hr == HRESULT_FROM_WIN32(win32[i])) return TRUE;
+    return FALSE;
+}
+
+static void job_error_final(BackgroundCopyJobImpl *job)
+{
+    IBackgroundCopyError *error;
+
+    if (job->notify_flags & BG_NOTIFY_DISABLE) return;
+    if (!(job->notify_flags & BG_NOTIFY_JOB_ERROR)) return;
+    if (job->callback && SUCCEEDED(create_copy_error(job->error.context, job->error.code, job->error.file, &error)))
+    {
+        TRACE("Calling JobError -->\n");
+        IBackgroundCopyCallback2_JobError(job->callback, (IBackgroundCopyJob *)&job->IBackgroundCopyJob4_iface, error);
+        TRACE("Called JobError <--\n");
+        IBackgroundCopyError_Release(error);
+    }
+    else run_notify_cmdline(job);
+}
+
+/* a transfer failed: retried later when the error may pass, else the job
+ * is in error and its owner is told */
+void job_failed(BackgroundCopyJobImpl *job)
+{
+    BOOL transient;
+
+    EnterCriticalSection(&globalMgr.cs);
+    if (job->state != BG_JOB_STATE_ERROR && job->state != BG_JOB_STATE_TRANSIENT_ERROR)
+    {
+        LeaveCriticalSection(&globalMgr.cs);
+        return;
+    }
+    job->error_count++;
+    if (!job->error.context) job->error.context = BG_ERROR_CONTEXT_REMOTE_FILE;
+    transient = job->state == BG_JOB_STATE_TRANSIENT_ERROR || is_transient_error(job->error.code);
+#ifdef SG_MUTANT_NO_BITS_RETRY
+    transient = FALSE;
+#endif
+    if (transient)
+    {
+        job->state = BG_JOB_STATE_TRANSIENT_ERROR;
+        job->retry_at = GetTickCount64() + job->retry_delay * 1000ull;
+        TRACE("job %p: transient error %#lx, retried in %lu s\n", job, job->error.code, job->retry_delay);
+    }
+    else job->state = BG_JOB_STATE_ERROR;
+    GetSystemTimeAsFileTime(&job->modified);
+    LeaveCriticalSection(&globalMgr.cs);
+    if (!transient) job_error_final(job);
+}
+
+/* transient errors due for a retry go back in the queue, unless the job has
+ * gone without progress (or past its download time) too long; the time
+ * until the next one is due */
+ULONGLONG job_due_retries(void)
+{
+    BackgroundCopyJobImpl *job, *failed[64];
+    ULONGLONG now = GetTickCount64(), next = ~0ull;
+    unsigned int n = 0, i;
+
+    EnterCriticalSection(&globalMgr.cs);
+    LIST_FOR_EACH_ENTRY(job, &globalMgr.jobs, BackgroundCopyJobImpl, entryFromQmgr)
+    {
+        if (job->state != BG_JOB_STATE_TRANSIENT_ERROR) continue;
+        if ((job->max_download_time && job->transfer_start &&
+             now - job->transfer_start >= job->max_download_time * 1000ull) ||
+            (job->last_progress && now - job->last_progress >= job->no_progress_timeout * 1000ull))
+        {
+            if (job->max_download_time && job->transfer_start &&
+                now - job->transfer_start >= job->max_download_time * 1000ull)
+                job->error.code = BG_E_MAXDOWNLOAD_TIMEOUT;
+            job->state = BG_JOB_STATE_ERROR;
+            if (n < ARRAY_SIZE(failed))
+            {
+                IBackgroundCopyJob4_AddRef(&job->IBackgroundCopyJob4_iface);
+                failed[n++] = job;
+            }
+        }
+        else if (job->retry_at <= now)
+        {
+            job->state = BG_JOB_STATE_QUEUED;
+            SetEvent(globalMgr.jobEvent);
+        }
+        else if (job->retry_at - now < next) next = job->retry_at - now;
+    }
+    LeaveCriticalSection(&globalMgr.cs);
+    for (i = 0; i < n; i++)
+    {
+        job_error_final(failed[i]);
+        IBackgroundCopyJob4_Release(&failed[i]->IBackgroundCopyJob4_iface);
+    }
+    return next;
+}
+
+/* the job is transferred: its owner is told */
+void job_notify_transferred(BackgroundCopyJobImpl *job)
+{
+    GetSystemTimeAsFileTime(&job->completed);
+    job->modified = job->completed;
+    if (job->notify_flags & BG_NOTIFY_DISABLE) return;
+    if (!(job->notify_flags & BG_NOTIFY_JOB_TRANSFERRED)) return;
+    if (job->callback)
+    {
+        TRACE("Calling JobTransferred -->\n");
+        IBackgroundCopyCallback2_JobTransferred(job->callback, (IBackgroundCopyJob*)&job->IBackgroundCopyJob4_iface);
+        TRACE("Called JobTransferred <--\n");
+    }
+    else run_notify_cmdline(job);
+}
