From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a key of a user's hive is the user's (5950)

server: a key of a user's hive is the user's

Opera would not install for a standard user: its installer stopped with
code 101 ("Failed creating key" for every key under HKCU\Software), and
every Burn bundle the user ran after it (Python 3.13, the .NET Desktop
Runtime) stopped with code 5. Opera's installer, like Chromium's, adds an
entry to the DACL of HKCU\Software: GetNamedSecurityInfo, SetEntriesInAcl,
SetNamedSecurityInfo. A hive's keys are loaded from its file without
descriptors, and Wine reported its generic one for them -- owner
Administrators, "Users read (below), Administrators full" -- which the
installer wrote back with its entry: the user had lost their own
HKCU\Software until the server restarted.

A key of \Registry\User\<SID> (or <SID>_Classes) without a descriptor now
reports the one Windows gives HKCU: owner the user, and the user, SYSTEM and
Administrators full control, inherited. It is also what access is checked
against, so another standard user can no longer write someone else's
HKCU. Keys outside users' hives keep the defaults they had. Gate
test-userhive; mutant SG_MUTANT_USERKEY_GENERIC_SD.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -458,6 +458,82 @@
     return access & ~(KEY_WOW64_64KEY | KEY_WOW64_32KEY);
 }
 
+/* Stained Glass OS: the descriptor of a key of a user's hive that has none.
+ *
+ * A hive's keys are loaded from its file without descriptors, and Wine reported
+ * its generic one for them: owner Administrators, "Users read (below), Administrators
+ * full". A program that adds an entry to the DACL of HKCU\Software reads that and
+ * writes it back -- Opera's installer does (SetNamedSecurityInfo, as Chromium's) -- and
+ * a standard user then could not create a key in their own HKCU\Software: Opera
+ * stopped with code 101, and every Burn bundle after it (Python, .NET) with 5 (qa4
+ * 2026-10-21). Windows gives HKCU the user's: owner the user; the user, SYSTEM and
+ * Administrators full, inherited. The user's SID is the hive's name. */
+static const struct security_descriptor *sg_user_key_default_sd( struct object *obj )
+{
+    static const WCHAR userW[] = {'\\','R','e','g','i','s','t','r','y','\\','U','s','e','r','\\'};
+    static struct { struct sid sid; struct security_descriptor *sd; } cache[32];
+    static unsigned int cached;
+    struct sid user = { SID_REVISION };
+    struct security_descriptor *sd;
+    const struct sid *sids[3];
+    data_size_t len = 0, dacl_len, i;
+    unsigned long long auth;
+    WCHAR *name, *p, *end;
+    struct acl *dacl;
+    struct ace *ace;
+
+#ifdef SG_MUTANT_USERKEY_GENERIC_SD
+    return NULL;
+#endif
+    if (!(name = obj->ops->get_full_name( obj, &len ))) { clear_error(); return NULL; }
+    len /= sizeof(WCHAR);
+    if (len <= ARRAY_SIZE(userW) + 4 || memicmp_strW( name, userW, sizeof(userW) )) { free( name ); return NULL; }
+    p = name + ARRAY_SIZE(userW);
+    end = name + len;
+    /* "S-1-<authority>-<sub>..." up to the end, a backslash or "_Classes" */
+    if (end - p < 4 || (p[0] != 'S' && p[0] != 's') || p[1] != '-' || p[2] != '1' || p[3] != '-') { free( name ); return NULL; }
+    p += 4;
+    for (auth = 0; p < end && *p >= '0' && *p <= '9'; p++) auth = auth * 10 + (*p - '0');
+    for (i = 0; i < 6; i++) user.id_auth[5 - i] = (auth >> (8 * i)) & 0xff;
+    while (p < end && *p == '-' && user.sub_count < ARRAY_SIZE(user.sub_auth))
+    {
+        unsigned long long v = 0;
+        WCHAR *start = ++p;
+        for (; p < end && *p >= '0' && *p <= '9'; p++) v = v * 10 + (*p - '0');
+        if (p == start || v > 0xffffffffu) { free( name ); return NULL; }
+        user.sub_auth[user.sub_count++] = v;
+    }
+    i = p < end && *p != '\\' && *p != '_';
+    free( name );
+    if (i || !user.sub_count) return NULL;
+
+    for (i = 0; i < cached; i++) if (equal_sid( &cache[i].sid, &user )) return cache[i].sd;
+    if (cached == ARRAY_SIZE(cache)) return NULL;
+
+    sids[0] = &user; sids[1] = &local_system_sid; sids[2] = &builtin_admins_sid;
+    dacl_len = sizeof(*dacl);
+    for (i = 0; i < 3; i++) dacl_len += sizeof(*ace) + sid_len( sids[i] );
+    if (!(sd = mem_alloc( sizeof(*sd) + 2 * sid_len( &user ) + dacl_len ))) return NULL;
+    sd->control   = SE_DACL_PRESENT;
+    sd->owner_len = sid_len( &user );
+    sd->group_len = sid_len( &user );
+    sd->sacl_len  = 0;
+    sd->dacl_len  = dacl_len;
+    copy_sid( copy_sid( (struct sid *)(sd + 1), &user ), &user );
+    dacl = (struct acl *)((char *)(sd + 1) + 2 * sid_len( &user ));
+    dacl->revision = ACL_REVISION;
+    dacl->pad1     = 0;
+    dacl->size     = dacl_len;
+    dacl->count    = 3;
+    dacl->pad2     = 0;
+    ace = ace_first( dacl );
+    for (i = 0; i < 3; i++)
+        ace = ace_next( set_ace( ace, sids[i], ACCESS_ALLOWED_ACE_TYPE, CONTAINER_INHERIT_ACE, KEY_ALL_ACCESS ) );
+    cache[cached].sid = user;
+    cache[cached++].sd = sd;
+    return sd;
+}
+
 static struct security_descriptor *key_get_sd( struct object *obj )
 {
     static struct security_descriptor *key_default_sd;
@@ -465,6 +541,7 @@
 
     if (obj->sd) return obj->sd;
     if (sg_system_prefix && (machine_sd = sg_key_default_sd( obj ))) return (struct security_descriptor *)machine_sd;
+    if (sg_system_prefix && (machine_sd = sg_user_key_default_sd( obj ))) return (struct security_descriptor *)machine_sd;
 
     if (!key_default_sd)
     {
