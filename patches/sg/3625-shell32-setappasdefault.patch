From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SetAppAsDefault publisher rule, MIME types and client kinds (3625)

shell32: SetAppAsDefault follows the documented publisher rule, adds MIME types and client kinds

IApplicationAssociationRegistration::SetAppAsDefault now returns E_ACCESSDENIED
when another program is the current default and the new program's publisher
(the CompanyName of the executable its open command runs) differs, as the
documentation says. AT_MIMETYPE records the user's MIMEAssociations choice from
the app's Capabilities\MimeAssociations; AT_STARTMENUCLIENT sets the default
client of a kind (HKCU\Software\Clients\<kind>). Explorer-facing: the Default
apps settings page does not go through this call.
---
diff --git a/dlls/shell32/assoc.c b/dlls/shell32/assoc.c
index 01f3d82..34bde92 100644
--- a/dlls/shell32/assoc.c
+++ b/dlls/shell32/assoc.c
@@ -1120,6 +1120,64 @@ static HRESULT WINAPI ApplicationAssociationRegistration_QueryAppIsDefaultAll(IA
     return E_NOTIMPL;
 }
 
+/* The publisher of a ProgId's program: the CompanyName of the executable its open command runs. */
+static BOOL progid_publisher(const WCHAR *progid, WCHAR *out, DWORD len)
+{
+    WCHAR key[MAX_PATH + 32], cmd[MAX_PATH * 2], exe[MAX_PATH], *p, *q;
+    DWORD size = sizeof(cmd), vsize, handle;
+    void *data;
+    struct { WORD lang, cp; } *trans;
+    UINT tlen;
+    WCHAR sub[64], *value;
+    BOOL ret = FALSE;
+
+    out[0] = 0;
+    swprintf(key, ARRAY_SIZE(key), L"%s\\shell\\open\\command", progid);
+    if (RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, cmd, &size)) return FALSE;
+    p = cmd;
+    while (*p == ' ') p++;
+    if (*p == '"')
+    {
+        p++;
+        if (!(q = wcschr(p, '"'))) return FALSE;
+    }
+    else if (!(q = wcschr(p, ' '))) q = p + wcslen(p);
+    if (q - p >= MAX_PATH) return FALSE;
+    memcpy(exe, p, (q - p) * sizeof(WCHAR));
+    exe[q - p] = 0;
+    if (!(vsize = GetFileVersionInfoSizeW(exe, &handle))) return FALSE;
+    if (!(data = malloc(vsize))) return FALSE;
+    if (GetFileVersionInfoW(exe, 0, vsize, data) && VerQueryValueW(data, L"\\VarFileInfo\\Translation", (void **)&trans, &tlen)
+            && tlen >= 4)
+    {
+        swprintf(sub, ARRAY_SIZE(sub), L"\\StringFileInfo\\%04x%04x\\CompanyName", trans->lang, trans->cp);
+        if (VerQueryValueW(data, sub, (void **)&value, &tlen) && *value)
+        {
+            lstrcpynW(out, value, len);
+            ret = TRUE;
+        }
+    }
+    free(data);
+    return ret;
+}
+
+/* The ProgId the user's choice (or else the class default) gives an association now. */
+static BOOL current_default_progid(const WCHAR *assoc, WCHAR *progid, DWORD len)
+{
+    DWORD size = len * sizeof(WCHAR);
+    WCHAR path[MAX_PATH + 96];
+
+    if (*assoc == '.')
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\%s\\UserChoice", assoc);
+    else
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations\\%s\\UserChoice", assoc);
+    if (!RegGetValueW(HKEY_CURRENT_USER, path, L"ProgId", RRF_RT_REG_SZ, NULL, progid, &size) && *progid) return TRUE;
+    size = len * sizeof(WCHAR);
+    if (*assoc == '.' && !RegGetValueW(HKEY_CLASSES_ROOT, assoc, NULL, RRF_RT_REG_SZ, NULL, progid, &size) && *progid)
+        return TRUE;
+    return FALSE;
+}
+
 static HRESULT WINAPI ApplicationAssociationRegistration_SetAppAsDefault(IApplicationAssociationRegistration* This, LPCWSTR appname,
                                                                          LPCWSTR set, ASSOCIATIONTYPE set_type)
 {
@@ -1131,19 +1189,81 @@ static HRESULT WINAPI ApplicationAssociationRegistration_SetAppAsDefault(IApplic
     return E_NOTIMPL;
 #else
     {
-        WCHAR progid[MAX_PATH];
+        WCHAR progid[MAX_PATH], cur[MAX_PATH], pub_new[128], pub_cur[128], path[MAX_PATH + 96];
         HRESULT hr;
 
-        if (set_type != AT_FILEEXTENSION && set_type != AT_URLPROTOCOL)
+        if (set_type == AT_STARTMENUCLIENT)
         {
-            FIXME("association type %d not supported\n", set_type);
-            return E_NOTIMPL;
+            /* the default client of a kind (StartMenuInternet, Mail...) is the one named in
+             * HKCU\Software\Clients\<kind>; it must be installed for the machine or the user */
+            HKEY key;
+            LONG res;
+
+            swprintf(path, ARRAY_SIZE(path), L"Software\\Clients\\%s\\%s", set, appname);
+            if (!*set || wcschr(set, '\\') || !*appname || wcschr(appname, '\\'))
+                return E_INVALIDARG;
+            if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key)
+                    && RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_READ, &key))
+                return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+            RegCloseKey(key);
+            swprintf(path, ARRAY_SIZE(path), L"Software\\Clients\\%s", set);
+            if ((res = RegSetKeyValueW(HKEY_CURRENT_USER, path, NULL, REG_SZ, appname, (lstrlenW(appname) + 1) * sizeof(WCHAR))))
+                return HRESULT_FROM_WIN32(res);
+            return S_OK;
+        }
+        if (set_type != AT_FILEEXTENSION && set_type != AT_URLPROTOCOL && set_type != AT_MIMETYPE)
+        {
+            WARN("unknown association type %d\n", set_type);
+            return E_INVALIDARG;
+        }
+
+        if (set_type == AT_MIMETYPE)
+        {
+            /* the app's Capabilities\MimeAssociations names the ProgId; the choice is the user's
+             * MIMEAssociations UserChoice that QueryCurrentDefault reads */
+            static const WCHAR reg_apps[] = L"Software\\RegisteredApplications";
+            static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+            WCHAR caps[MAX_PATH], assoc_path[MAX_PATH + 32];
+            DWORD size, i;
+            BOOL found = FALSE;
+
+            for (i = 0; i < ARRAY_SIZE(roots) && !found; i++)
+            {
+                size = sizeof(caps);
+                if (RegGetValueW(roots[i], reg_apps, appname, RRF_RT_REG_SZ, NULL, caps, &size)) continue;
+                swprintf(assoc_path, ARRAY_SIZE(assoc_path), L"%s\\MimeAssociations", caps);
+                size = sizeof(progid);
+                found = !RegGetValueW(HKEY_LOCAL_MACHINE, assoc_path, set, RRF_RT_REG_SZ, NULL, progid, &size) && *progid;
+                size = sizeof(progid);
+                if (!found)
+                    found = !RegGetValueW(HKEY_CURRENT_USER, assoc_path, set, RRF_RT_REG_SZ, NULL, progid, &size) && *progid;
+            }
+            if (!found) return HRESULT_FROM_WIN32(ERROR_NO_ASSOCIATION);
+            swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\Shell\\Associations\\MIMEAssociations\\%s\\UserChoice", set);
+            if (RegSetKeyValueW(HKEY_CURRENT_USER, path, L"Progid", REG_SZ, progid, (lstrlenW(progid) + 1) * sizeof(WCHAR)))
+                return E_FAIL;
+            SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, NULL, NULL);
+            return S_OK;
         }
 
         hr = lookup_registered_app_progid(appname, set_type == AT_URLPROTOCOL, set, progid, ARRAY_SIZE(progid));
         if (FAILED(hr))
             return hr;
 
+        /* Documented: the application becomes the default only if its publisher matches
+         * the current default's (E_ACCESSDENIED otherwise). Nothing to protect when no
+         * other program is the default. */
+#ifndef SG_MUTANT_SETAPP_PUBLISHER
+        if (current_default_progid(set, cur, ARRAY_SIZE(cur)) && wcsicmp(cur, progid))
+#else
+        if (0)
+#endif
+        {
+            if (!progid_publisher(cur, pub_cur, ARRAY_SIZE(pub_cur))
+                    || !progid_publisher(progid, pub_new, ARRAY_SIZE(pub_new)) || wcsicmp(pub_cur, pub_new))
+                return E_ACCESSDENIED;
+        }
+
         return SHELL_SetUserChoice(set, progid) ? S_OK : E_FAIL;
     }
 #endif
