From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: SPI_GETCURSORSIZE

SystemParametersInfo(0x2028), undocumented but named by Microsoft (Mozilla bug 1712669), answers the
mouse pointer size (HKCU\Control Panel\Cursors CursorBaseSize, 32 by default; SG's Settings writes
it). Firefox and Tor Browser place tooltips below the pointer by it (runtime census set 7, gaps15).
---
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -195,6 +195,7 @@
     SERIALKEYS_KEY,
     HIGHCONTRAST_KEY,
     ACCESSIBILITY_KEY,
+    CURSORS_KEY,
     NB_PARAM_KEYS
 };
 
@@ -220,6 +221,7 @@
     "Control Panel\\Accessibility\\SerialKeys",
     "Control Panel\\Accessibility\\HighContrast",
     "Control Panel\\Accessibility",
+    "Control Panel\\Cursors",
 };
 
 /* System parameters storage */
@@ -5593,6 +5595,9 @@
  * the wheel goes: Wine sends wheel messages to the window under the pointer */
 static DWORD_ENTRY( MESSAGEDURATION, 5, ACCESSIBILITY_KEY, "MessageDuration" );
 static DWORD_ENTRY( CARETTIMEOUT, 5000, DESKTOP_KEY, "CaretTimeout" );
+/* Stained Glass OS 9811: the mouse pointer size (Settings > Accessibility > Mouse pointer; SG's
+ * Settings writes it), 32 by default */
+static DWORD_ENTRY( CURSORSIZE, 32, CURSORS_KEY, "CursorBaseSize" );
 static DWORD_ENTRY( MOUSEWHEELROUTING, MOUSEWHEEL_ROUTING_MOUSE_POS, DESKTOP_KEY, "MouseWheelRouting" );
 static DWORD_ENTRY( AUDIODESC_LOCALE, 0, AUDIODESC_KEY, "Locale" );
 
@@ -7019,6 +7024,12 @@
     case SPI_SETCARETTIMEOUT:
         ret = set_entry( &entry_CARETTIMEOUT, val, ptr, winini );
         break;
+#ifndef SG_MUTANT_NO_CURSORSIZE
+    case 0x2028:  /* SPI_GETCURSORSIZE: undocumented, but named by Microsoft (Mozilla bug 1712669);
+                   * Firefox places tooltips below the pointer by it */
+        ret = get_entry( &entry_CURSORSIZE, val, ptr );
+        break;
+#endif
     case SPI_GETMOUSEWHEELROUTING:
         ret = get_entry( &entry_MOUSEWHEELROUTING, val, ptr );
         break;
