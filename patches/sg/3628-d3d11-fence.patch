+ */
+
+#include "d3d11_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d11);
+
+/* ID3D11Fence: a counter that only goes up.  The value lives in a shared memory
+ * section, so a fence made with D3D11_FENCE_FLAG_SHARED can be opened by another
+ * device (or process) through its handle; waiting is done by polling the value. */
+
+#define FENCE_MAGIC 0x53474645 /* "SGFE" */
+
+struct fence_data
+{
+    DWORD magic;
+    DWORD pad;
+    volatile LONG64 value;
+};
+
+struct d3d11_fence
+{
+    ID3D11Fence ID3D11Fence_iface;
+    LONG refcount;
+    ID3D11Device5 *device;
+    struct wined3d_private_store private_store;
+    HANDLE section;
+    struct fence_data *data;
+    D3D11_FENCE_FLAG flags;
+};
+
+static inline struct d3d11_fence *impl_from_ID3D11Fence(ID3D11Fence *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d11_fence, ID3D11Fence_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_fence_QueryInterface(ID3D11Fence *iface, REFIID riid, void **object)
+{
+    TRACE("iface %p, riid %s, object %p.\n", iface, debugstr_guid(riid), object);
+
+    if (IsEqualGUID(riid, &IID_ID3D11Fence) || IsEqualGUID(riid, &IID_ID3D11DeviceChild)
+            || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        ID3D11Fence_AddRef(iface);
+        *object = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(riid));
+    *object = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d3d11_fence_AddRef(ID3D11Fence *iface)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+    ULONG refcount = InterlockedIncrement(&fence->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", fence, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE d3d11_fence_Release(ID3D11Fence *iface)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+    ULONG refcount = InterlockedDecrement(&fence->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", fence, refcount);
+
+    if (!refcount)
+    {
+        ID3D11Device5 *device = fence->device;
+
+        wined3d_private_store_cleanup(&fence->private_store);
+        UnmapViewOfFile(fence->data);
+        CloseHandle(fence->section);
+        free(fence);
+        ID3D11Device5_Release(device);
+    }
+    return refcount;
+}
+
+static void STDMETHODCALLTYPE d3d11_fence_GetDevice(ID3D11Fence *iface, ID3D11Device **device)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+
+    TRACE("iface %p, device %p.\n", iface, device);
+    ID3D11Device5_AddRef(fence->device);
+    *device = (ID3D11Device *)fence->device;
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_fence_GetPrivateData(ID3D11Fence *iface, REFGUID guid, UINT *data_size, void *data)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+
+    TRACE("iface %p, guid %s, data_size %p, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+    return d3d_get_private_data(&fence->private_store, guid, data_size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_fence_SetPrivateData(ID3D11Fence *iface, REFGUID guid, UINT data_size,
+        const void *data)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+
+    TRACE("iface %p, guid %s, data_size %u, data %p.\n", iface, debugstr_guid(guid), data_size, data);
+    return d3d_set_private_data(&fence->private_store, guid, data_size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_fence_SetPrivateDataInterface(ID3D11Fence *iface, REFGUID guid,
+        const IUnknown *data)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+
+    TRACE("iface %p, guid %s, data %p.\n", iface, debugstr_guid(guid), data);
+    return d3d_set_private_data_interface(&fence->private_store, guid, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_fence_CreateSharedHandle(ID3D11Fence *iface,
+        const SECURITY_ATTRIBUTES *attributes, DWORD access, const WCHAR *name, HANDLE *handle)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+    HANDLE dup;
+
+    TRACE("iface %p, attributes %p, access %#lx, name %s, handle %p.\n", iface, attributes, access,
+            debugstr_w(name), handle);
+
+    if (!handle)
+        return E_INVALIDARG;
+    *handle = NULL;
+    if (!(fence->flags & D3D11_FENCE_FLAG_SHARED))
+        return E_INVALIDARG;
+    if (name)
+    {
+        /* a named handle: a second section view of the same value under the name */
+        HANDLE named = CreateFileMappingW(INVALID_HANDLE_VALUE, (SECURITY_ATTRIBUTES *)attributes, PAGE_READWRITE,
+                0, sizeof(struct fence_data), name);
+        struct fence_data *data;
+
+        if (!named)
+            return HRESULT_FROM_WIN32(GetLastError());
+        if (GetLastError() == ERROR_ALREADY_EXISTS)
+        {
+            CloseHandle(named);
+            return HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS);
+        }
+        if (!(data = MapViewOfFile(named, FILE_MAP_WRITE, 0, 0, sizeof(*data))))
+        {
+            CloseHandle(named);
+            return E_OUTOFMEMORY;
+        }
+        data->magic = FENCE_MAGIC;
+        data->value = fence->data->value;
+        UnmapViewOfFile(data);
+        /* only the starting value is carried over: the named section is a snapshot */
+        *handle = named;
+        return S_OK;
+    }
+    if (!DuplicateHandle(GetCurrentProcess(), fence->section, GetCurrentProcess(), &dup, 0,
+            attributes && attributes->bInheritHandle, DUPLICATE_SAME_ACCESS))
+        return HRESULT_FROM_WIN32(GetLastError());
+    *handle = dup;
+    return S_OK;
+}
+
+static UINT64 STDMETHODCALLTYPE d3d11_fence_GetCompletedValue(ID3D11Fence *iface)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+
+    TRACE("iface %p.\n", iface);
+    return InterlockedCompareExchange64(&fence->data->value, 0, 0);
+}
+
+struct fence_waiter
+{
+    struct d3d11_fence *fence;
+    UINT64 value;
+    HANDLE event;
+};
+
+static DWORD WINAPI fence_waiter_thread(void *arg)
+{
+    struct fence_waiter *waiter = arg;
+
+    while ((UINT64)InterlockedCompareExchange64(&waiter->fence->data->value, 0, 0) < waiter->value)
+        Sleep(1);
+    /* give the fence (and with it the device) back before the event can wake the waiter */
+    ID3D11Fence_Release(&waiter->fence->ID3D11Fence_iface);
+    SetEvent(waiter->event);
+    CloseHandle(waiter->event);
+    free(waiter);
+    return 0;
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_fence_SetEventOnCompletion(ID3D11Fence *iface, UINT64 value, HANDLE event)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+    struct fence_waiter *waiter;
+    HANDLE thread, own_event;
+
+    TRACE("iface %p, value %s, event %p.\n", iface, wine_dbgstr_longlong(value), event);
+
+    if ((UINT64)InterlockedCompareExchange64(&fence->data->value, 0, 0) >= value)
+    {
+        if (event)
+            SetEvent(event);
+        return S_OK;
+    }
+    if (!event)
+    {
+        /* no event: return once the value is reached */
+        while ((UINT64)InterlockedCompareExchange64(&fence->data->value, 0, 0) < value)
+            Sleep(1);
+        return S_OK;
+    }
+    if (!DuplicateHandle(GetCurrentProcess(), event, GetCurrentProcess(), &own_event, 0, FALSE, DUPLICATE_SAME_ACCESS))
+        return E_INVALIDARG;
+    if (!(waiter = malloc(sizeof(*waiter))))
+    {
+        CloseHandle(own_event);
+        return E_OUTOFMEMORY;
+    }
+    waiter->fence = fence;
+    waiter->value = value;
+    waiter->event = own_event;
+    ID3D11Fence_AddRef(iface);
+    if (!(thread = CreateThread(NULL, 0, fence_waiter_thread, waiter, 0, NULL)))
+    {
+        ID3D11Fence_Release(iface);
+        CloseHandle(own_event);
+        free(waiter);
+        return E_OUTOFMEMORY;
+    }
+    CloseHandle(thread);
+    return S_OK;
+}
+
+static const struct ID3D11FenceVtbl d3d11_fence_vtbl =
+{
+    d3d11_fence_QueryInterface,
+    d3d11_fence_AddRef,
+    d3d11_fence_Release,
+    d3d11_fence_GetDevice,
+    d3d11_fence_GetPrivateData,
+    d3d11_fence_SetPrivateData,
+    d3d11_fence_SetPrivateDataInterface,
+    d3d11_fence_CreateSharedHandle,
+    d3d11_fence_GetCompletedValue,
+    d3d11_fence_SetEventOnCompletion,
+};
+
+static HRESULT fence_init(struct d3d_device *device, HANDLE section, UINT64 value, BOOL set_value,
+        D3D11_FENCE_FLAG flags, REFIID iid, void **out)
+{
+    struct d3d11_fence *fence;
+    HRESULT hr;
+
+    if (!(fence = calloc(1, sizeof(*fence))))
+        return E_OUTOFMEMORY;
+    fence->ID3D11Fence_iface.lpVtbl = &d3d11_fence_vtbl;
+    fence->refcount = 1;
+    fence->flags = flags;
+    wined3d_private_store_init(&fence->private_store);
+    if (!section)
+        section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(struct fence_data), NULL);
+    if (!section || !(fence->data = MapViewOfFile(section, FILE_MAP_WRITE, 0, 0, sizeof(*fence->data))))
+    {
+        if (section)
+            CloseHandle(section);
+        wined3d_private_store_cleanup(&fence->private_store);
+        free(fence);
+        return E_OUTOFMEMORY;
+    }
+    fence->section = section;
+    if (set_value)
+    {
+        fence->data->magic = FENCE_MAGIC;
+        fence->data->value = value;
+    }
+    ID3D11Device5_AddRef(fence->device = (ID3D11Device5 *)&device->ID3D11Device2_iface);
+
+    hr = ID3D11Fence_QueryInterface(&fence->ID3D11Fence_iface, iid, out);
+    ID3D11Fence_Release(&fence->ID3D11Fence_iface);
+    return hr;
+}
+
+HRESULT d3d11_fence_create(struct d3d_device *device, UINT64 value, D3D11_FENCE_FLAG flags, REFIID iid, void **out)
+{
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+#ifndef SG_MUTANT_FENCE_FLAGS
+    if (flags & ~(D3D11_FENCE_FLAG_SHARED | D3D11_FENCE_FLAG_SHARED_CROSS_ADAPTER | D3D11_FENCE_FLAG_NON_MONITORED))
+#else
+    if (0)
+#endif
+        return E_INVALIDARG;
+    return fence_init(device, NULL, value, TRUE, flags, iid, out);
+}
+
+HRESULT d3d11_fence_open(struct d3d_device *device, HANDLE handle, REFIID iid, void **out)
+{
+    struct fence_data *data;
+    HANDLE section;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (!handle || !(data = MapViewOfFile(handle, FILE_MAP_READ, 0, 0, sizeof(*data))))
+        return E_INVALIDARG;
+    if (data->magic != FENCE_MAGIC)
+    {
+        UnmapViewOfFile(data);
+        return E_INVALIDARG;
+    }
+    UnmapViewOfFile(data);
+    if (!DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), &section, 0, FALSE, DUPLICATE_SAME_ACCESS))
+        return E_INVALIDARG;
+    return fence_init(device, section, 0, FALSE, D3D11_FENCE_FLAG_SHARED, iid, out);
+}
+
+/* The immediate context runs its commands in order; a signal is reached when everything
+ * before it has been handed over, so the context is flushed first. */
+void d3d11_fence_signal(ID3D11Fence *iface, UINT64 value)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
+    LONG64 old;
+
+    do
+        old = InterlockedCompareExchange64(&fence->data->value, 0, 0);
+    while ((UINT64)old < value && InterlockedCompareExchange64(&fence->data->value, value, old) != old);
+}
+
+void d3d11_fence_wait(ID3D11Fence *iface, UINT64 value)
+{
+    d3d11_fence_SetEventOnCompletion(iface, value, NULL);
+}
+
+BOOL d3d11_fence_check(ID3D11Fence *iface)
+{
+    return iface && iface->lpVtbl == &d3d11_fence_vtbl;
+}
diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index f727547..9e49765 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -36582,6 +36582,82 @@ static void test_nv12(void)
     release_test_context(&test_context);
 }
 
+static void test_sg_fence(void)
+{
+    ID3D11DeviceContext4 *context4;
+    ID3D11DeviceContext *context;
+    ID3D11Fence *fence, *shared;
+    ID3D11Device5 *device5;
+    ID3D11Device *device;
+    HANDLE handle, event;
+    HRESULT hr;
+    ULONG rc;
+
+    if (!(device = create_device(NULL)))
+    {
+        skip("Failed to create device.\n");
+        return;
+    }
+    if (FAILED(ID3D11Device_QueryInterface(device, &IID_ID3D11Device5, (void **)&device5)))
+    {
+        win_skip("ID3D11Device5 is not supported.\n");
+        ID3D11Device_Release(device);
+        return;
+    }
+    ID3D11Device_GetImmediateContext(device, &context);
+    hr = ID3D11DeviceContext_QueryInterface(context, &IID_ID3D11DeviceContext4, (void **)&context4);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = ID3D11Device5_CreateFence(device5, 5, 0x80, &IID_ID3D11Fence, (void **)&fence);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = ID3D11Device5_CreateFence(device5, 5, D3D11_FENCE_FLAG_NONE, &IID_ID3D11Fence, (void **)&fence);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(ID3D11Fence_GetCompletedValue(fence) == 5, "Got value %I64u.\n", ID3D11Fence_GetCompletedValue(fence));
+    hr = ID3D11Fence_CreateSharedHandle(fence, NULL, GENERIC_ALL, NULL, &handle);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    hr = ID3D11Fence_SetEventOnCompletion(fence, 5, event);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(WaitForSingleObject(event, 0) == WAIT_OBJECT_0, "Event not signaled.\n");
+    hr = ID3D11Fence_SetEventOnCompletion(fence, 9, event);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(WaitForSingleObject(event, 20) == WAIT_TIMEOUT, "Event signaled early.\n");
+    hr = ID3D11DeviceContext4_Signal(context4, fence, 9);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(ID3D11Fence_GetCompletedValue(fence) == 9, "Got value %I64u.\n", ID3D11Fence_GetCompletedValue(fence));
+    ok(WaitForSingleObject(event, 2000) == WAIT_OBJECT_0, "Event not signaled.\n");
+    hr = ID3D11DeviceContext4_Signal(context4, fence, 3);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(ID3D11Fence_GetCompletedValue(fence) == 9, "Value went down.\n");
+    hr = ID3D11DeviceContext4_Wait(context4, fence, 9);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    CloseHandle(event);
+    ID3D11Fence_Release(fence);
+
+    hr = ID3D11Device5_CreateFence(device5, 1, D3D11_FENCE_FLAG_SHARED, &IID_ID3D11Fence, (void **)&fence);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = ID3D11Fence_CreateSharedHandle(fence, NULL, GENERIC_ALL, NULL, &handle);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
