+#else
     HPEN pen = CreatePen( PS_SOLID, 2, color ), oldp = SelectObject( hdc, pen );
     HBRUSH oldb = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
     Ellipse( hdc, cx - 7, cy - 7, cx + 4, cy + 4 );
@@ -2589,6 +2686,7 @@
