+/* Stained Glass OS: smooth drawing. GDI draws lines, ellipses, polygons and
+ * clip paths without antialiasing: the magnifier, the Glass orb and the Start
+ * mark came out jagged, the more so on a scaled bar (David 2026-10-05). The
+ * art is drawn SG_SS times larger on black and averaged down to pixels: a
+ * pixel is as opaque as the share of it drawn on, in the average of what was
+ * drawn (art never draws pure black), then blended in. */
+#define SG_SS 4
+struct sg_art { int w, h; float s; };   /* its size, and big pixels per pixel at 100% */
+typedef void (*sg_art_draw)( HDC hdc, const struct sg_art *art, const void *arg );
+
+static void sg_smooth( HDC hdc, int x, int y, int w, int h, sg_art_draw draw, const void *arg )
+{
+    BITMAPINFO bi = { { sizeof(BITMAPINFOHEADER), w * SG_SS, -h * SG_SS, 1, 32, BI_RGB } };
+    struct sg_art art = { w, h, SG_SS * sg_s8 / 8.0f };
+    BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    HDC dcs[2] = { 0 };
+    HBITMAP bmps[2] = { 0 }, olds[2] = { 0 };
+    BYTE *bits[2] = { 0 };
+    int i, px, py, sx, sy, n = SG_SS * SG_SS, W = w * SG_SS;
+
+    if (w <= 0 || h <= 0) return;
+    for (i = 0; i < 2; i++)
+    {
+        if (i == 1) { bi.bmiHeader.biWidth = w; bi.bmiHeader.biHeight = -h; }
+        dcs[i] = CreateCompatibleDC( hdc );
+        bmps[i] = CreateDIBSection( hdc, &bi, DIB_RGB_COLORS, (void **)&bits[i], NULL, 0 );
+        if (!dcs[i] || !bmps[i]) goto done;
+        olds[i] = SelectObject( dcs[i], bmps[i] );
+        memset( bits[i], 0, (size_t)bi.bmiHeader.biWidth * -bi.bmiHeader.biHeight * 4 );
+    }
+    draw( dcs[0], &art, arg );
+    GdiFlush();
+    for (py = 0; py < h; py++)
+        for (px = 0; px < w; px++)
+        {
+            unsigned int c[3] = { 0, 0, 0 }, a = 0;
+            BYTE *out = bits[1] + (py * w + px) * 4;
+            for (sy = 0; sy < SG_SS; sy++)
+                for (sx = 0; sx < SG_SS; sx++)
+                {
+                    const BYTE *col = bits[0] + ((py * SG_SS + sy) * W + px * SG_SS + sx) * 4;
+                    c[0] += col[0]; c[1] += col[1]; c[2] += col[2];
+                    if (col[0] | col[1] | col[2]) a += 255;
+                }
+            a /= n;   /* premultiplied: the colours drawn on black are their share already */
+            out[0] = min( c[0] / n, a ); out[1] = min( c[1] / n, a ); out[2] = min( c[2] / n, a ); out[3] = a;
+        }
+    GdiAlphaBlend( hdc, x, y, w, h, dcs[1], 0, 0, w, h, bf );
+done:
+    for (i = 0; i < 2; i++)
+    {
+        if (olds[i]) SelectObject( dcs[i], olds[i] );
+        if (bmps[i]) DeleteObject( bmps[i] );
+        if (dcs[i]) DeleteDC( dcs[i] );
+    }
+}
+
+static void sg_start_mark_art( HDC hdc, const struct sg_art *a, const void *arg )
+{
+    RECT big = { 0, 0, a->w * SG_SS, a->h * SG_SS };
+    sg_draw_start_mark_raw( hdc, &big, SG_SS );
+}
+
+/* the Start mark: four panes of glass, drawn smooth */
+static void sg_draw_start_mark( HDC hdc, const RECT *rect )
+{
+#ifndef SG_MUTANT_JAGGED_MARK
+    sg_smooth( hdc, rect->left, rect->top, rect->right - rect->left, rect->bottom - rect->top, sg_start_mark_art, NULL );
+#else
+    sg_draw_start_mark_raw( hdc, rect, 1.0 );
+#endif
+}
+
+/* the search button's magnifier: a lens and its handle, on a 20 pixel square */
+static void sg_magnifier_art( HDC hdc, const struct sg_art *a, const void *arg )
+{
+    LOGBRUSH lb = { BS_SOLID, *(const COLORREF *)arg, 0 };
+    float s = a->s, cx = a->w * SG_SS / 2.0f, cy = a->h * SG_SS / 2.0f;
+    HPEN lens = ExtCreatePen( PS_GEOMETRIC | PS_SOLID, max( 1, lroundf( 1.5f * s ) ), &lb, 0, NULL );
+    HPEN handle = ExtCreatePen( PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_ROUND, max( 1, lroundf( 2.0f * s ) ), &lb, 0, NULL );
+    HGDIOBJ oldp = SelectObject( hdc, lens ), oldb = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+
+    Ellipse( hdc, lroundf( cx - 7.0f * s ), lroundf( cy - 7.0f * s ), lroundf( cx + 4.0f * s ), lroundf( cy + 4.0f * s ));
+    SelectObject( hdc, handle );
+    MoveToEx( hdc, lroundf( cx + 2.6f * s ), lroundf( cy + 2.6f * s ), NULL );
+    LineTo( hdc, lroundf( cx + 7.5f * s ), lroundf( cy + 7.5f * s ));
+    SelectObject( hdc, oldp );
+    SelectObject( hdc, oldb );
+    DeleteObject( lens );
+    DeleteObject( handle );
+}
+
