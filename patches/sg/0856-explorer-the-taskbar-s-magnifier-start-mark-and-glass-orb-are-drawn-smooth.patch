 /* Glass's Start: a round orb, deep blue-green, lit from above, the mark in it */
+static void sg_glass_orb_art( HDC hdc, const struct sg_art *a, const void *arg )
+{
+    const int k = SG_SS, cx = a->w * k / 2, cy = a->h * k / 2;
+    int d = min( a->w, a->h ) * k - 4 * k, rad = d / 2, i;
+    int shade = *(const int *)arg;
+    COLORREF rim = sg_shade( RGB(0x08,0x2A,0x3E), shade ), core = sg_shade( RGB(0x1C,0x8C,0xB4), shade );
+    HPEN oldp = SelectObject( hdc, GetStockObject( NULL_PEN ));
+    int saved;
+
+    /* from the rim in: a light core low in the orb, as if lit through it */
+    for (i = 0; i < rad; i++)
+    {
+        HBRUSH brush = CreateSolidBrush( sg_mix( rim, core, i * 100 / rad ) ), oldb = SelectObject( hdc, brush );
+        int r = rad - i;
+        Ellipse( hdc, cx - r, cy - r + i / 2, cx + r + k, cy + r + k );
+        SelectObject( hdc, oldb );
+        DeleteObject( brush );
+    }
+    SelectObject( hdc, oldp );
+    /* the gloss over its upper half */
+    {
+        static const struct sg_stop gloss[] = { { 0, RGB(0xE6,0xF4,0xFA) }, { 100, RGB(0x3C,0x8C,0xAE) } };
+        struct sg_stop g[2] = { { 0, sg_shade( gloss[0].color, shade / 2 ) }, { 100, sg_shade( gloss[1].color, shade ) } };
+        RECT gr = { cx - rad * 3 / 4, cy - rad + 2 * k, cx + rad * 3 / 4, cy + k };
+        saved = SaveDC( hdc );
+        BeginPath( hdc );
+        Ellipse( hdc, gr.left, gr.top, gr.right, gr.bottom + (gr.bottom - gr.top) / 3 );
+        EndPath( hdc );
+        SelectClipPath( hdc, RGN_AND );
+        if (sg_vertical())
+        {
+            /* the gradient runs down the orb on either bar */
+            TRIVERTEX v[2] = { { gr.left, gr.top }, { gr.right, gr.bottom } };
+            GRADIENT_RECT r2 = { 0, 1 };
+            v[0].Red = GetRValue( g[0].color ) << 8; v[0].Green = GetGValue( g[0].color ) << 8; v[0].Blue = GetBValue( g[0].color ) << 8;
+            v[1].Red = GetRValue( g[1].color ) << 8; v[1].Green = GetGValue( g[1].color ) << 8; v[1].Blue = GetBValue( g[1].color ) << 8;
+            GdiGradientFill( hdc, v, 2, &r2, 1, GRADIENT_FILL_RECT_V );
+        }
+        else sg_gradient( hdc, &gr, g, 2 );
+        RestoreDC( hdc, saved );
+    }
+    /* a thin light rim */
+    {
+        HPEN pen = CreatePen( PS_SOLID, k, sg_shade( RGB(0x7C,0xB8,0xD0), shade ) );
+        HBRUSH oldb = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+        oldp = SelectObject( hdc, pen );
+        Ellipse( hdc, cx - rad, cy - rad, cx + rad + k, cy + rad + k );
+        SelectObject( hdc, oldb );
+        SelectObject( hdc, oldp );
+        DeleteObject( pen );
+    }
+}
+
 static void sg_draw_glass_orb( const DRAWITEMSTRUCT *dis, const RECT *rect )
 {
+#ifndef SG_MUTANT_JAGGED_ORB
+    int cx = (rect->left + rect->right) / 2, cy = (rect->top + rect->bottom) / 2;
