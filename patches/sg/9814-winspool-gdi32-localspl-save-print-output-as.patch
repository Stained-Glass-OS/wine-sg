+/* Stained Glass OS (9814): a queue on cups-pdf (the Print to PDF printer) */
+static BOOL is_pdf_queue(const WCHAR *queue)
+{
+#ifdef SONAME_LIBCUPS
+    char name[512];
+    cups_dest_t *dests;
+    BOOL ret = FALSE;
+    int num, i;
+
+    if (!pcupsGetDests || !queue_name(queue, name, sizeof(name))) return FALSE;
+    num = pcupsGetDests(&dests);
+    for (i = 0; i < num; i++)
+    {
+        const char *uri;
+
+        if (strcmp(dests[i].name, name)) continue;
+        uri = pcupsGetOption("device-uri", dests[i].num_options, dests[i].options);
+        ret = uri && !strncmp(uri, "cups-pdf:", 9);
+        break;
+    }
+    pcupsFreeDests(num, dests);
+    return ret;
+#else
+    return FALSE;
+#endif
+}
+
+/* The PDF printer's document, saved to a file the person chose: what the
+ * printer's driver wrote is PostScript (cups-pdf's PPD), made a PDF in place
+ * by Ghostscript, as cups-pdf itself would have. Anything not PostScript is
+ * left as it is. */
+static NTSTATUS make_pdf(void *args)
+{
+    const struct make_pdf_params *params = args;
+    char head[2], *tmp;
+    int fd, status;
+    pid_t pid;
+    ssize_t got;
+
+    if (!is_pdf_queue(params->queue)) return STATUS_NOT_SUPPORTED;
+    if ((fd = open(params->path, O_RDONLY)) < 0) return STATUS_OBJECT_NAME_NOT_FOUND;
+    got = read(fd, head, 2);
+    close(fd);
+    if (got != 2 || memcmp(head, "%!", 2)) return STATUS_SUCCESS;
+    if (!(tmp = malloc(strlen(params->path) + 16))) return STATUS_NO_MEMORY;
+    sprintf(tmp, "%s.sg-pdf.tmp", params->path);
+    if (!(pid = fork()))
+    {
+        char out[4096 + 20];
+        int null = open("/dev/null", O_RDWR);
+
+        if (null >= 0) { dup2(null, 0); dup2(null, 1); dup2(null, 2); }
+        snprintf(out, sizeof(out), "-sOutputFile=%s", tmp);
+        signal(SIGPIPE, SIG_DFL);
+        execlp("gs", "gs", "-q", "-dSAFER", "-dBATCH", "-dNOPAUSE", "-sDEVICE=pdfwrite", out, "--",
+               params->path, (char *)NULL);
+        _exit(127);
+    }
+    if (pid < 0)
+    {
+        free(tmp);
+        return STATUS_UNSUCCESSFUL;
+    }
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR);
+    if (WIFEXITED(status) && !WEXITSTATUS(status) && !rename(tmp, params->path))
+    {
+        free(tmp);
+        return STATUS_SUCCESS;
+    }
+    ERR("Ghostscript could not make %s a PDF (status %#x)\n", debugstr_a(params->path), status);
+    unlink(tmp);
+    free(tmp);
+    return STATUS_UNSUCCESSFUL;
+}
