 /*****************************************************************************
+ *          Stained Glass OS (9814): Save Print Output As
+ *
+ * Windows asks where a document printed to a file goes with the Save dialog
+ * "Save Print Output As": Printer Files (*.prn) for Print to file, PDF
+ * Document (*.pdf), named after the document, for Microsoft Print to PDF.
+ * Our Print to PDF printer is the CUPS queue on cups-pdf (sg-print-setup),
+ * which on its own puts every PDF in Documents without asking.
+ */
+/* TRUE for the PDF printer when the document has no output of its own: none,
+ * or the printer's port (programs pass their DEVNAMES port to CreateDC) */
+static BOOL is_pdf_printer( HANDLE printer, const WCHAR *output )
+{
+    struct get_device_uri_params params;
+    PRINTER_INFO_5W *pi5;
+    WCHAR uri[64];
+    DWORD len = 0;
+    BOOL ret = FALSE;
+
+    GetPrinterW( printer, 5, NULL, 0, &len );
+    if (!len || !(pi5 = malloc( len ))) return FALSE;
+    if (GetPrinterW( printer, 5, (BYTE *)pi5, len, &len ) && pi5->pPortName &&
+        !wcsncmp( pi5->pPortName, L"CUPS:", 5 ) && pi5->pPortName[5] &&
+        (!output || !wcsicmp( output, pi5->pPortName )))
+    {
+        params.printer = pi5->pPortName + 5;
+        params.uri = uri;
+        params.size = ARRAY_SIZE(uri);
+        ret = !UNIX_CALL( get_device_uri, &params ) && !wcsnicmp( uri, L"cups-pdf:", 9 );
+    }
+    free( pi5 );
+    return ret;
+}
+
+/* the chosen file (heap_alloc), or NULL with ERROR_CANCELLED */
+static WCHAR *save_print_output( const WCHAR *doc_name, BOOL pdf )
+{
+    BOOL (WINAPI *pGetSaveFileNameW)( OPENFILENAMEW * );
+    HRESULT (WINAPI *pSHGetFolderPathW)( HWND, int, HANDLE, DWORD, WCHAR * );
+    HMODULE comdlg = LoadLibraryW( L"comdlg32.dll" ), shell = LoadLibraryW( L"shell32.dll" );
+    WCHAR file[MAX_PATH] = L"", dir[MAX_PATH] = L"", *ret = NULL, *p;
+    OPENFILENAMEW ofn;
+
+    pGetSaveFileNameW = comdlg ? (void *)GetProcAddress( comdlg, "GetSaveFileNameW" ) : NULL;
+    pSHGetFolderPathW = shell ? (void *)GetProcAddress( shell, "SHGetFolderPathW" ) : NULL;
+    if (pSHGetFolderPathW) pSHGetFolderPathW( NULL, CSIDL_PERSONAL, NULL, 0, dir );
+    if (pdf && doc_name)
+    {
+        /* "C:\docs\Report.txt" -> "Report" */
+        const WCHAR *base = doc_name;
+        for (p = (WCHAR *)doc_name; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+        lstrcpynW( file, base, ARRAY_SIZE(file) - 4 );
+        if ((p = wcsrchr( file, '.' )) && p != file && wcslen( p ) <= 5) *p = 0;
+        for (p = file; *p; p++) if (wcschr( L"<>:\"/\\|?*", *p ) || *p < ' ') *p = '_';
+    }
+    memset( &ofn, 0, sizeof(ofn) );
+    ofn.lStructSize = sizeof(ofn);
+    ofn.hwndOwner = GetForegroundWindow();
+    ofn.lpstrFilter = pdf ? L"PDF Document (*.pdf)\0*.pdf\0" : L"Printer Files (*.prn)\0*.prn\0All Files (*.*)\0*.*\0";
+    ofn.lpstrFile = file;
+    ofn.nMaxFile = ARRAY_SIZE(file);
+    ofn.lpstrInitialDir = dir[0] ? dir : NULL;
+    ofn.lpstrTitle = L"Save Print Output As";
+    ofn.lpstrDefExt = pdf ? L"pdf" : L"prn";
+    ofn.Flags = OFN_EXPLORER | OFN_OVERWRITEPROMPT | OFN_PATHMUSTEXIST | OFN_HIDEREADONLY | OFN_NOCHANGEDIR;
+    if (pGetSaveFileNameW && pGetSaveFileNameW( &ofn ) && (ret = heap_alloc( (wcslen( file ) + 1) * sizeof(WCHAR) )))
+        wcscpy( ret, file );
+    if (comdlg) FreeLibrary( comdlg );
+    if (shell) FreeLibrary( shell );
+    if (!ret) SetLastError( ERROR_CANCELLED );
+    return ret;
+}
