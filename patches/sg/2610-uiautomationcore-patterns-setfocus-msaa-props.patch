+static HRESULT WINAPI uia_nested_node_provider_call_pattern(IWineUiaProvider *iface, int pattern_id, int method,
+        VARIANT *in_val, VARIANT *out_val)
+{
+    struct uia_nested_node_provider *prov = impl_from_nested_node_IWineUiaProvider(iface);
+    HRESULT hr, last = UIA_E_NOTSUPPORTED;
+    int i;
+
+    TRACE("%p, %d, %d, %p, %p\n", iface, pattern_id, method, in_val, out_val);
+
+    /* The nested node has providers of its own; the first one that has the pattern answers. */
+    VariantInit(out_val);
+    for (i = 0; ; i++)
+    {
+        IWineUiaProvider *nested_prov;
+        VARIANT empty;
+
+        VariantInit(&empty);
+        hr = IWineUiaNode_get_provider(prov->nested_node, i, &nested_prov);
+        if (FAILED(hr))
+        {
+            /* out of providers: nobody has it */
+            hr = i ? last : hr;
+            break;
+        }
+
+        hr = IWineUiaProvider_call_pattern(nested_prov, pattern_id, method, in_val ? in_val : &empty, out_val);
+        IWineUiaProvider_Release(nested_prov);
+
+        if (method == PATTERN_METHOD_PROBE)
+        {
+            if (SUCCEEDED(hr) && V_VT(out_val) == VT_BOOL && V_BOOL(out_val))
+                break;
+            VariantClear(out_val);
+            hr = last = S_OK;
+        }
+        else if (hr != UIA_E_NOTSUPPORTED)
+            break;
+        else
+            last = hr;
+    }
+
+    return hr;
+}
