+++ b/dlls/uiautomationcore/uia_patterns.c
@@ -0,0 +1,660 @@
+/*
+ * UI Automation client pattern objects (UiaGetPatternProvider and the
+ * Xxx_Method calls on them).
+ *
+ * A pattern object remembers the node and the provider of the node that has
+ * the pattern. Each call goes to that provider through
+ * IWineUiaProvider::call_pattern, so it runs in the provider's apartment (or
+ * process), where the pattern provider interface is asked for and called.
+ *
+ * Stained Glass OS: written from the documented method signatures.
+ */
+#include "uia_private.h"
+#include "ocidl.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(uiautomation);
+
+/* Server side: the provider's end of a pattern call. */
+
+static BOOL get_double_pair(const VARIANT *v, double *a, double *b)
+{
+    LONG lbound, ubound, i;
+    double vals[2];
+
+    if (!(V_VT(v) == (VT_R8 | VT_ARRAY)) || !V_ARRAY(v) || SafeArrayGetDim(V_ARRAY(v)) != 1)
+        return FALSE;
+    if (FAILED(SafeArrayGetLBound(V_ARRAY(v), 1, &lbound)) || FAILED(SafeArrayGetUBound(V_ARRAY(v), 1, &ubound)))
+        return FALSE;
+    if (ubound - lbound + 1 < 2)
+        return FALSE;
+    for (i = 0; i < 2; i++)
+    {
+        LONG idx = lbound + i;
+        if (FAILED(SafeArrayGetElement(V_ARRAY(v), &idx, &vals[i])))
+            return FALSE;
+    }
+#ifdef SG_MUTANT_UIAPAT_ARGS_SWAPPED
+    *a = vals[1];
+    *b = vals[0];
+#else
+    *a = vals[0];
+    *b = vals[1];
+#endif
+    return TRUE;
+}
+
+static BOOL get_int_pair(const VARIANT *v, int *a, int *b)
+{
+    LONG lbound, ubound, i;
+    int vals[2];
+
+    if (!(V_VT(v) == (VT_I4 | VT_ARRAY)) || !V_ARRAY(v) || SafeArrayGetDim(V_ARRAY(v)) != 1)
+        return FALSE;
+    if (FAILED(SafeArrayGetLBound(V_ARRAY(v), 1, &lbound)) || FAILED(SafeArrayGetUBound(V_ARRAY(v), 1, &ubound)))
+        return FALSE;
+    if (ubound - lbound + 1 < 2)
+        return FALSE;
+    for (i = 0; i < 2; i++)
+    {
+        LONG idx = lbound + i;
+        if (FAILED(SafeArrayGetElement(V_ARRAY(v), &idx, &vals[i])))
+            return FALSE;
+    }
+#ifdef SG_MUTANT_UIAPAT_ARGS_SWAPPED
+    *a = vals[1];
+    *b = vals[0];
+#else
+    *a = vals[0];
+    *b = vals[1];
+#endif
+    return TRUE;
+}
+
+static HRESULT call_pattern_method(IUnknown *unk, int pattern_id, int method, const VARIANT *in, VARIANT *out)
+{
+    HRESULT hr;
+    void *iface;
+    double d1, d2;
+    int i1, i2;
+
+#define PATTERN_CALL(type, iid, ...) \
+    do { \
+        hr = IUnknown_QueryInterface(unk, &iid, &iface); \
+        if (FAILED(hr)) \
+            return UIA_E_NOTSUPPORTED; \
+        hr = type##_##__VA_ARGS__; \
+        type##_Release((type *)iface); \
+        return hr; \
+    } while (0)
+
+    switch (method)
+    {
+    case PATTERN_METHOD_INVOKE:
+        PATTERN_CALL(IInvokeProvider, IID_IInvokeProvider, Invoke((IInvokeProvider *)iface));
+    case PATTERN_METHOD_EXPAND:
+        PATTERN_CALL(IExpandCollapseProvider, IID_IExpandCollapseProvider, Expand((IExpandCollapseProvider *)iface));
+    case PATTERN_METHOD_COLLAPSE:
+        PATTERN_CALL(IExpandCollapseProvider, IID_IExpandCollapseProvider, Collapse((IExpandCollapseProvider *)iface));
+    case PATTERN_METHOD_TOGGLE:
+        PATTERN_CALL(IToggleProvider, IID_IToggleProvider, Toggle((IToggleProvider *)iface));
+    case PATTERN_METHOD_SET_VALUE_STR:
+        if (V_VT(in) != VT_BSTR)
+            return E_INVALIDARG;
+        PATTERN_CALL(IValueProvider, IID_IValueProvider, SetValue((IValueProvider *)iface, V_BSTR(in)));
+    case PATTERN_METHOD_SET_VALUE_DBL:
+        if (V_VT(in) != VT_R8)
+            return E_INVALIDARG;
+        PATTERN_CALL(IRangeValueProvider, IID_IRangeValueProvider, SetValue((IRangeValueProvider *)iface, V_R8(in)));
+    case PATTERN_METHOD_SELITEM_SELECT:
+        PATTERN_CALL(ISelectionItemProvider, IID_ISelectionItemProvider, Select((ISelectionItemProvider *)iface));
+    case PATTERN_METHOD_SELITEM_ADD:
+        PATTERN_CALL(ISelectionItemProvider, IID_ISelectionItemProvider, AddToSelection((ISelectionItemProvider *)iface));
+    case PATTERN_METHOD_SELITEM_REMOVE:
+        PATTERN_CALL(ISelectionItemProvider, IID_ISelectionItemProvider, RemoveFromSelection((ISelectionItemProvider *)iface));
+    case PATTERN_METHOD_SCROLL_INTO_VIEW:
+        PATTERN_CALL(IScrollItemProvider, IID_IScrollItemProvider, ScrollIntoView((IScrollItemProvider *)iface));
+    case PATTERN_METHOD_SCROLL:
+        if (!get_int_pair(in, &i1, &i2))
+            return E_INVALIDARG;
+        PATTERN_CALL(IScrollProvider, IID_IScrollProvider, Scroll((IScrollProvider *)iface, i1, i2));
+    case PATTERN_METHOD_SET_SCROLL_PERCENT:
+        if (!get_double_pair(in, &d1, &d2))
+            return E_INVALIDARG;
+        PATTERN_CALL(IScrollProvider, IID_IScrollProvider, SetScrollPercent((IScrollProvider *)iface, d1, d2));
+    case PATTERN_METHOD_DOCK:
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        PATTERN_CALL(IDockProvider, IID_IDockProvider, SetDockPosition((IDockProvider *)iface, V_I4(in)));
+    case PATTERN_METHOD_MOVE:
+        if (!get_double_pair(in, &d1, &d2))
+            return E_INVALIDARG;
+        PATTERN_CALL(ITransformProvider, IID_ITransformProvider, Move((ITransformProvider *)iface, d1, d2));
+    case PATTERN_METHOD_RESIZE:
+        if (!get_double_pair(in, &d1, &d2))
+            return E_INVALIDARG;
+        PATTERN_CALL(ITransformProvider, IID_ITransformProvider, Resize((ITransformProvider *)iface, d1, d2));
+    case PATTERN_METHOD_ROTATE:
+        if (V_VT(in) != VT_R8)
+            return E_INVALIDARG;
+        PATTERN_CALL(ITransformProvider, IID_ITransformProvider, Rotate((ITransformProvider *)iface, V_R8(in)));
+    case PATTERN_METHOD_WINDOW_CLOSE:
+        PATTERN_CALL(IWindowProvider, IID_IWindowProvider, Close((IWindowProvider *)iface));
+    case PATTERN_METHOD_WINDOW_VISUAL_STATE:
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        PATTERN_CALL(IWindowProvider, IID_IWindowProvider, SetVisualState((IWindowProvider *)iface, V_I4(in)));
+    case PATTERN_METHOD_WINDOW_WAIT_IDLE:
+    {
+        BOOL result = FALSE;
+
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        hr = IUnknown_QueryInterface(unk, &IID_IWindowProvider, &iface);
+        if (FAILED(hr))
+            return UIA_E_NOTSUPPORTED;
+        hr = IWindowProvider_WaitForInputIdle((IWindowProvider *)iface, V_I4(in), &result);
+        IWindowProvider_Release((IWindowProvider *)iface);
+        if (SUCCEEDED(hr))
+        {
+            V_VT(out) = VT_BOOL;
+            V_BOOL(out) = result ? VARIANT_TRUE : VARIANT_FALSE;
+        }
+        return hr;
+    }
+    case PATTERN_METHOD_REALIZE:
+        PATTERN_CALL(IVirtualizedItemProvider, IID_IVirtualizedItemProvider, Realize((IVirtualizedItemProvider *)iface));
+    case PATTERN_METHOD_VIEW_NAME:
+    {
+        BSTR name = NULL;
+
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        hr = IUnknown_QueryInterface(unk, &IID_IMultipleViewProvider, &iface);
+        if (FAILED(hr))
+            return UIA_E_NOTSUPPORTED;
+        hr = IMultipleViewProvider_GetViewName((IMultipleViewProvider *)iface, V_I4(in), &name);
+        IMultipleViewProvider_Release((IMultipleViewProvider *)iface);
+        if (SUCCEEDED(hr))
+        {
+            V_VT(out) = VT_BSTR;
+            V_BSTR(out) = name;
+        }
+        return hr;
+    }
+    case PATTERN_METHOD_SET_VIEW:
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        PATTERN_CALL(IMultipleViewProvider, IID_IMultipleViewProvider, SetCurrentView((IMultipleViewProvider *)iface, V_I4(in)));
+    case PATTERN_METHOD_SYNC_START:
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        PATTERN_CALL(ISynchronizedInputProvider, IID_ISynchronizedInputProvider, StartListening((ISynchronizedInputProvider *)iface, V_I4(in)));
+    case PATTERN_METHOD_SYNC_CANCEL:
+        PATTERN_CALL(ISynchronizedInputProvider, IID_ISynchronizedInputProvider, Cancel((ISynchronizedInputProvider *)iface));
+    case PATTERN_METHOD_LEGACY_SELECT:
+        if (V_VT(in) != VT_I4)
+            return E_INVALIDARG;
+        PATTERN_CALL(ILegacyIAccessibleProvider, IID_ILegacyIAccessibleProvider, Select((ILegacyIAccessibleProvider *)iface, V_I4(in)));
+    case PATTERN_METHOD_LEGACY_DEFAULT_ACTION:
+        PATTERN_CALL(ILegacyIAccessibleProvider, IID_ILegacyIAccessibleProvider, DoDefaultAction((ILegacyIAccessibleProvider *)iface));
+    case PATTERN_METHOD_LEGACY_SET_VALUE:
+        if (V_VT(in) != VT_BSTR)
+            return E_INVALIDARG;
+        PATTERN_CALL(ILegacyIAccessibleProvider, IID_ILegacyIAccessibleProvider, SetValue((ILegacyIAccessibleProvider *)iface, V_BSTR(in)));
+    case PATTERN_METHOD_LEGACY_GET_IACCESSIBLE:
+    {
+        IAccessible *acc = NULL;
+
+        hr = IUnknown_QueryInterface(unk, &IID_ILegacyIAccessibleProvider, &iface);
+        if (FAILED(hr))
+            return UIA_E_NOTSUPPORTED;
+        hr = ILegacyIAccessibleProvider_GetIAccessible((ILegacyIAccessibleProvider *)iface, &acc);
+        ILegacyIAccessibleProvider_Release((ILegacyIAccessibleProvider *)iface);
+#ifdef SG_MUTANT_UIAPAT_NO_ACC_OUT
+        if (0)
+#else
+        if (SUCCEEDED(hr) && acc)
+#endif
+        {
+            V_VT(out) = VT_UNKNOWN;
+            V_UNKNOWN(out) = (IUnknown *)acc;
+        }
+        return hr;
+    }
+    default:
+        FIXME("Unhandled pattern %d method %d\n", pattern_id, method);
+        return E_NOTIMPL;
+    }
+#undef PATTERN_CALL
+}
+
+HRESULT uia_pattern_call_provider(IRawElementProviderSimple *elprov, int pattern_id, int method, VARIANT *in_val,
+        VARIANT *out_val)
+{
+    IUnknown *unk = NULL;
+    HRESULT hr;
+
+    VariantInit(out_val);
+    if (!pattern_id)
+    {
+        IRawElementProviderFragment *frag;
+
+        if (method != PATTERN_METHOD_SET_FOCUS)
+            return E_INVALIDARG;
+
+        hr = IRawElementProviderSimple_QueryInterface(elprov, &IID_IRawElementProviderFragment, (void **)&frag);
+        if (FAILED(hr))
+#ifdef SG_MUTANT_UIAPAT_NO_FRAGMENT_CHECK
+            return S_OK;
+#else
+            return UIA_E_NOTSUPPORTED;
+#endif
+
+        hr = IRawElementProviderFragment_SetFocus(frag);
+        IRawElementProviderFragment_Release(frag);
+        return hr;
+    }
+
+    hr = IRawElementProviderSimple_GetPatternProvider(elprov, pattern_id, &unk);
+    if (method == PATTERN_METHOD_PROBE)
+    {
+        if (SUCCEEDED(hr) && unk)
+        {
+            V_VT(out_val) = VT_BOOL;
+            V_BOOL(out_val) = VARIANT_TRUE;
+        }
+        if (unk)
+            IUnknown_Release(unk);
+        return S_OK;
+    }
+
+    if (FAILED(hr))
+        return hr;
+    if (!unk)
+        return UIA_E_NOTSUPPORTED;
+
+    hr = call_pattern_method(unk, pattern_id, method, in_val, out_val);
+    IUnknown_Release(unk);
+    return hr;
+}
+
+/* Client side: pattern objects. */
+
+#define UIA_PATTERN_OBJECT_MAGIC 0x50415455
+
+struct uia_pattern_object {
+    DWORD magic;
+    PATTERNID pattern_id;
+    HUIANODE node;
+    int prov_idx;
+};
+
+static struct uia_pattern_object *unsafe_pattern_object(HUIAPATTERNOBJECT hobj)
+{
+    struct uia_pattern_object *obj = (struct uia_pattern_object *)hobj;
+
+    if (!obj || obj->magic != UIA_PATTERN_OBJECT_MAGIC)
+        return NULL;
+    return obj;
+}
+
+/***********************************************************************
+ *          UiaGetPatternProvider (uiautomationcore.@)
+ */
+HRESULT WINAPI UiaGetPatternProvider(HUIANODE huianode, PATTERNID pattern_id, HUIAPATTERNOBJECT *huiapatternobj)
+{
+    IWineUiaNode *node = uia_checked_node(huianode);
+    struct uia_pattern_object *obj;
+    int idx;
+
+    TRACE("(%p, %d, %p)\n", huianode, pattern_id, huiapatternobj);
+
+    if (!huiapatternobj)
+        return E_INVALIDARG;
+    *huiapatternobj = NULL;
+    if (!node || !pattern_id)
+        return E_INVALIDARG;
+
+    for (idx = 0; ; idx++)
+    {
+        VARIANT v;
+        HRESULT hr;
+
+        hr = call_pattern_on_node_provider(node, idx, pattern_id, PATTERN_METHOD_PROBE, NULL, &v);
+        if (FAILED(hr))
+        {
+            /* get_provider rejects an index past the last provider: not supported */
+            return idx ? S_OK : hr;
+        }
+
+#ifdef SG_MUTANT_UIAPAT_UNSUPPORTED_OBJECT
+        break;
+#endif
+        if (V_VT(&v) == VT_BOOL && V_BOOL(&v))
+            break;
+        VariantClear(&v);
+    }
+
+    if (!(obj = calloc(1, sizeof(*obj))))
+        return E_OUTOFMEMORY;
+
+    obj->magic = UIA_PATTERN_OBJECT_MAGIC;
+    obj->pattern_id = pattern_id;
+    obj->prov_idx = idx;
+    obj->node = huianode;
+    IWineUiaNode_AddRef(node);
+
+    *huiapatternobj = (HUIAPATTERNOBJECT)obj;
+    return S_OK;
+}
+
+/***********************************************************************
+ *          UiaPatternRelease (uiautomationcore.@)
+ */
+BOOL WINAPI UiaPatternRelease(HUIAPATTERNOBJECT hobj)
+{
+    struct uia_pattern_object *obj = unsafe_pattern_object(hobj);
+
+    TRACE("(%p)\n", hobj);
+
+    if (!obj)
+        return FALSE;
+
+    obj->magic = 0;
+    IWineUiaNode_Release((IWineUiaNode *)obj->node);
+    free(obj);
+    return TRUE;
+}
+
+static HRESULT pattern_object_call(HUIAPATTERNOBJECT hobj, PATTERNID pattern_id, int method, VARIANT *in_val,
+        VARIANT *out_val)
+{
+    struct uia_pattern_object *obj = unsafe_pattern_object(hobj);
+    VARIANT out;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_UIAPAT_NO_TYPE_CHECK
+    if (!obj)
+#else
+    if (!obj || obj->pattern_id != pattern_id)
+#endif
+        return E_INVALIDARG;
+
+    hr = call_pattern_on_node_provider((IWineUiaNode *)obj->node, obj->prov_idx, pattern_id, method, in_val, &out);
+#ifdef SG_MUTANT_UIAPAT_ERROR_DROPPED
+    if (FAILED(hr)) hr = S_OK;
+#endif
+    if (SUCCEEDED(hr) && out_val)
+        *out_val = out;
+    else
+        VariantClear(&out);
+
+    return hr;
+}
+
+static HRESULT pattern_call_pair_double(HUIAPATTERNOBJECT hobj, PATTERNID pattern_id, int method, double a, double b)
+{
+    SAFEARRAY *sa = SafeArrayCreateVector(VT_R8, 0, 2);
+    VARIANT in;
+    LONG idx;
+    HRESULT hr;
+
+    if (!sa)
+        return E_OUTOFMEMORY;
+    idx = 0;
+    SafeArrayPutElement(sa, &idx, &a);
+    idx = 1;
+    SafeArrayPutElement(sa, &idx, &b);
