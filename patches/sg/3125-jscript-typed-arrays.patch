From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 00:02:55 -0700
Subject: [PATCH] jscript: typed arrays

Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array,
Int32Array, Uint32Array, Float32Array and Float64Array did not exist, so
scripts that read binary data (images, sockets, crypto, WebGL) failed in the
modes that have ArrayBuffer. They are views of an ArrayBuffer with indexed
access (writes convert as the type says: wrap around, clamp or round to
single precision; a write beyond the end is ignored and a read gives
undefined) and length, byteLength, byteOffset, buffer, BYTES_PER_ELEMENT,
set and subarray. The constructors take a length, an array or typed array to
copy, or an ArrayBuffer with an offset and a length. ArrayBuffer.isView knows
them and Object.prototype.toString names the type.

diff --git a/dlls/jscript/arraybuf.c b/dlls/jscript/arraybuf.c
index eddf246..4f47cbe 100644
--- a/dlls/jscript/arraybuf.c
+++ b/dlls/jscript/arraybuf.c
@@ -18,6 +18,7 @@
 
 
 #include <limits.h>
+#include <math.h>
 
 #include "jscript.h"
 
@@ -161,12 +162,11 @@ static HRESULT ArrayBufferConstr_isView(script_ctx_t *ctx, jsval_t vthis, WORD f
     jsdisp_t *obj;
     BOOL ret = FALSE;
 
-    /* Stained Glass OS 1653: true for views of an ArrayBuffer (DataView;
-     * this engine has no typed arrays) */
+    /* Stained Glass OS 1653: true for views of an ArrayBuffer (DataView and typed arrays) */
     TRACE("\n");
 
     if(argc && is_object_instance(argv[0]) && (obj = to_jsdisp(get_object(argv[0]))))
-        ret = is_class(obj, JSCLASS_DATAVIEW);
+        ret = is_class(obj, JSCLASS_DATAVIEW) || is_class(obj, JSCLASS_TYPEDARRAY);
     if(r)
         *r = jsval_bool(ret);
     return S_OK;
@@ -693,6 +693,612 @@ static const builtin_info_t DataViewConstr_info = {
     .call  = Function_value,
 };
 
+/*
+ * Typed arrays (Int8Array ... Float64Array): views of an ArrayBuffer with indexed access.
+ */
+typedef enum {
+    TA_INT8,
+    TA_UINT8,
+    TA_UINT8C,
+    TA_INT16,
+    TA_UINT16,
+    TA_INT32,
+    TA_UINT32,
+    TA_FLOAT32,
+    TA_FLOAT64,
+    TA_COUNT
+} ta_type_t;
+
+static const struct {
+    const WCHAR *name;
+    unsigned size;
+} ta_info[TA_COUNT] = {
+    { L"Int8Array",         1 },
+    { L"Uint8Array",        1 },
+    { L"Uint8ClampedArray", 1 },
+    { L"Int16Array",        2 },
+    { L"Uint16Array",       2 },
+    { L"Int32Array",        4 },
+    { L"Uint32Array",       4 },
+    { L"Float32Array",      4 },
+    { L"Float64Array",      8 },
+};
+
+typedef struct {
+    jsdisp_t dispex;
+
+    ArrayBufferInstance *buffer; /* NULL for a prototype */
+    ta_type_t type;
+    DWORD offset;
+    DWORD length;
+} TypedArrayInstance;
+
+static inline TypedArrayInstance *typedarr_from_jsdisp(jsdisp_t *jsdisp)
+{
+    return CONTAINING_RECORD(jsdisp, TypedArrayInstance, dispex);
+}
+
+static inline TypedArrayInstance *typedarr_this(jsval_t vthis)
+{
+    jsdisp_t *jsdisp = is_object_instance(vthis) ? to_jsdisp(get_object(vthis)) : NULL;
+    return (jsdisp && is_class(jsdisp, JSCLASS_TYPEDARRAY)) ? typedarr_from_jsdisp(jsdisp) : NULL;
+}
+
+static double ta_round_clamped(double d)
+{
+    double f;
+
+    if(isnan(d) || d <= 0.0)
+        return 0.0;
+    if(d >= 255.0)
+        return 255.0;
+    f = floor(d);
+    if(d - f < 0.5)
+        return f;
+    if(d - f > 0.5)
+        return f + 1.0;
+    return fmod(f, 2.0) == 0.0 ? f : f + 1.0;
+}
+
+static double ta_read(const TypedArrayInstance *ta, DWORD idx)
+{
+    const BYTE *p = ta->buffer->buf + ta->offset + idx * ta_info[ta->type].size;
+
+    switch(ta->type) {
+    case TA_INT8:    return *(const INT8*)p;
+    case TA_UINT8:
+    case TA_UINT8C:  return *p;
+    case TA_INT16:   return *(const INT16*)p;
+    case TA_UINT16:  return *(const UINT16*)p;
+    case TA_INT32:   return *(const INT32*)p;
+    case TA_UINT32:  return *(const UINT32*)p;
+    case TA_FLOAT32: return *(const float*)p;
+    default:         return *(const double*)p;
+    }
+}
+
+static void ta_write(script_ctx_t *ctx, TypedArrayInstance *ta, DWORD idx, double d)
+{
+    BYTE *p = ta->buffer->buf + ta->offset + idx * ta_info[ta->type].size;
+    INT32 i32 = 0;
+
+    if(ta->type != TA_FLOAT32 && ta->type != TA_FLOAT64 && ta->type != TA_UINT8C) {
+        /* ToInt32: modulo 2^32 */
+        if(isfinite(d)) {
+            double m = fmod(trunc(d), 4294967296.0);
+            if(m < 0.0)
+                m += 4294967296.0;
+            i32 = (INT32)(UINT32)m;
+        }
+    }
+
+    switch(ta->type) {
+    case TA_INT8:    *(INT8*)p = i32; break;
+#ifdef SG_MUTANT_JS_TA_NOWRAP
+    case TA_UINT8:   *p = d > 255.0 ? 255 : (BYTE)d; break;
+#else
+    case TA_UINT8:   *p = i32; break;
+#endif
+    case TA_UINT8C:  *p = ta_round_clamped(d); break;
+    case TA_INT16:   *(INT16*)p = i32; break;
+    case TA_UINT16:  *(UINT16*)p = i32; break;
+    case TA_INT32:
+    case TA_UINT32:  *(INT32*)p = i32; break;
+    case TA_FLOAT32: *(float*)p = d; break;
+    default:         *(double*)p = d; break;
+    }
+}
+
+static HRESULT TypedArray_get_buffer(script_ctx_t *ctx, jsdisp_t *jsthis, jsval_t *r)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsthis);
+
+    TRACE("%p\n", jsthis);
+
+    *r = ta->buffer ? jsval_obj(jsdisp_addref(&ta->buffer->dispex)) : jsval_undefined();
+    return S_OK;
+}
+
+static HRESULT TypedArray_get_byteLength(script_ctx_t *ctx, jsdisp_t *jsthis, jsval_t *r)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsthis);
+
+    *r = jsval_number(ta->length * ta_info[ta->type].size);
+    return S_OK;
+}
+
+static HRESULT TypedArray_get_byteOffset(script_ctx_t *ctx, jsdisp_t *jsthis, jsval_t *r)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsthis);
+
+    *r = jsval_number(ta->offset);
+    return S_OK;
+}
+
+static HRESULT TypedArray_get_length(script_ctx_t *ctx, jsdisp_t *jsthis, jsval_t *r)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsthis);
+
+    *r = jsval_number(ta->length);
+    return S_OK;
+}
+
+static HRESULT TypedArray_get_BYTES_PER_ELEMENT(script_ctx_t *ctx, jsdisp_t *jsthis, jsval_t *r)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsthis);
+
+    *r = jsval_number(ta_info[ta->type].size);
+    return S_OK;
+}
+
+static HRESULT TypedArray_lookup_prop(jsdisp_t *jsdisp, const WCHAR *name, unsigned flags, struct property_info *desc)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsdisp);
+
+    const WCHAR *ptr;
+    unsigned idx = 0;
+
+    if(!ta->buffer)
+        return DISP_E_UNKNOWNNAME;
+
+    /* an index beyond the end is a property that reads as undefined and ignores writes */
+    for(ptr = name; is_digit(*ptr); ptr++) {
+        if(ptr - name >= 9)
+            return DISP_E_UNKNOWNNAME;
+        idx = idx * 10 + (*ptr - '0');
+    }
+    if(ptr == name || *ptr || (ptr - name > 1 && name[0] == '0'))
+        return DISP_E_UNKNOWNNAME;
+
+    desc->id = idx;
+    desc->flags = PROPF_WRITABLE | (idx < ta->length ? PROPF_ENUMERABLE : 0);
+    desc->name = NULL;
+    desc->index = idx;
+    desc->iid = 0;
+    return S_OK;
+}
+
+static HRESULT TypedArray_next_prop(jsdisp_t *jsdisp, unsigned id, struct property_info *desc)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsdisp);
+
+    if(!ta->buffer)
+        return S_FALSE;
+    return jsdisp_next_index(jsdisp, ta->length, id, desc);
+}
+
+static HRESULT TypedArray_prop_get(jsdisp_t *jsdisp, unsigned idx, jsval_t *r)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsdisp);
+
+#ifdef SG_MUTANT_JS_TA_NOOOB
+    if(idx >= ta->length) return DISP_E_UNKNOWNNAME;
+#endif
+    *r = idx < ta->length ? jsval_number(ta_read(ta, idx)) : jsval_undefined();
+    return S_OK;
+}
+
+static HRESULT TypedArray_prop_put(jsdisp_t *jsdisp, unsigned idx, jsval_t val)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsdisp);
+    double d;
+    HRESULT hres;
+
+    hres = to_number(jsdisp->ctx, val, &d);
+    if(FAILED(hres))
+        return hres;
+    if(idx < ta->length)
+        ta_write(jsdisp->ctx, ta, idx, d);
+    return S_OK;
+}
+
+static void TypedArray_destructor(jsdisp_t *dispex)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(dispex);
+    if(ta->buffer)
+        jsdisp_release(&ta->buffer->dispex);
+}
+
+static HRESULT TypedArray_gc_traverse(struct gc_ctx *gc_ctx, enum gc_traverse_op op, jsdisp_t *dispex)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(dispex);
+
+    if(!ta->buffer)
+        return S_OK;
+    return gc_process_linked_obj(gc_ctx, op, dispex, &ta->buffer->dispex, (void**)&ta->buffer);
+}
+
+/* the values of an array-like or typed array, as numbers */
+static HRESULT ta_collect_source(script_ctx_t *ctx, jsval_t src, double **vals, DWORD *count)
+{
+    TypedArrayInstance *src_ta;
+    jsdisp_t *obj;
+    jsval_t v;
+    double len, *buf;
+    HRESULT hres;
+    DWORD i;
+
+    *vals = NULL;
+    *count = 0;
+
+    if((src_ta = typedarr_this(src)) && src_ta->buffer) {
+        if(!(buf = malloc((src_ta->length + 1) * sizeof(*buf))))
+            return E_OUTOFMEMORY;
+        for(i = 0; i < src_ta->length; i++)
+            buf[i] = ta_read(src_ta, i);
+        *vals = buf;
+        *count = src_ta->length;
+        return S_OK;
+    }
+
+    if(!is_object_instance(src) || !(obj = to_jsdisp(get_object(src))))
+        return JS_E_INVALID_LENGTH;
+
+    hres = jsdisp_propget_name(obj, L"length", &v);
+    if(FAILED(hres))
+        return hres;
+    hres = to_number(ctx, v, &len);
+    jsval_release(v);
+    if(FAILED(hres))
+        return hres;
+    if(isnan(len) || len < 0.0)
+        len = 0.0;
+    if(len > 0x7fffffff)
+        return JS_E_INVALID_LENGTH;
+
+    if(!(buf = malloc(((DWORD)len + 1) * sizeof(*buf))))
+        return E_OUTOFMEMORY;
+    for(i = 0; i < (DWORD)len; i++) {
+        hres = jsdisp_get_idx(obj, i, &v);
+        if(hres == DISP_E_UNKNOWNNAME) {
+            buf[i] = NAN;
+            continue;
+        }
+        if(SUCCEEDED(hres)) {
+            hres = to_number(ctx, v, &buf[i]);
+            jsval_release(v);
+        }
+        if(FAILED(hres)) {
+            free(buf);
+            return hres;
+        }
+    }
+    *vals = buf;
+    *count = len;
+    return S_OK;
+}
+
+static HRESULT create_typedarr(script_ctx_t *ctx, ta_type_t type, ArrayBufferInstance *buffer, DWORD offset,
+                               DWORD length, TypedArrayInstance **ret);
+
+static HRESULT TypedArray_set(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv, jsval_t *r)
+{
+    TypedArrayInstance *ta;
+    double *vals, off = 0.0;
+    DWORD count, i;
+    HRESULT hres;
+
+    TRACE("\n");
+
+    if(!(ta = typedarr_this(vthis)) || !ta->buffer)
+        return JS_E_INVALID_LENGTH;
+    if(!argc)
+        return JS_E_DATAVIEW_NO_ARGUMENT;
+    if(argc > 1) {
+        hres = to_integer(ctx, argv[1], &off);
+        if(FAILED(hres))
+            return hres;
+    }
+
+    hres = ta_collect_source(ctx, argv[0], &vals, &count);
+    if(FAILED(hres))
+        return hres;
+    if(off < 0.0 || off + count > ta->length) {
+        free(vals);
+        return JS_E_DATAVIEW_INVALID_OFFSET;
+    }
+    for(i = 0; i < count; i++)
+        ta_write(ctx, ta, (DWORD)off + i, vals[i]);
+    free(vals);
+
+    if(r) *r = jsval_undefined();
+    return S_OK;
+}
+
+static HRESULT TypedArray_subarray(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    TypedArrayInstance *ta, *ret;
+    double begin = 0.0, end;
+    HRESULT hres;
+
+    TRACE("\n");
+
+    if(!(ta = typedarr_this(vthis)) || !ta->buffer)
+        return JS_E_INVALID_LENGTH;
+    end = ta->length;
+
+    if(argc) {
+        hres = to_integer(ctx, argv[0], &begin);
+        if(FAILED(hres))
+            return hres;
+        if(argc > 1 && !is_undefined(argv[1])) {
+            hres = to_integer(ctx, argv[1], &end);
+            if(FAILED(hres))
+                return hres;
+        }
+    }
+    if(begin < 0.0) begin += ta->length;
+    if(end < 0.0) end += ta->length;
+    if(begin < 0.0) begin = 0.0;
+    if(end > ta->length) end = ta->length;
+    if(begin > ta->length) begin = ta->length;
+    if(end < begin) end = begin;
+
+    if(!r)
+        return S_OK;
+    hres = create_typedarr(ctx, ta->type, ta->buffer, ta->offset + (DWORD)begin * ta_info[ta->type].size,
+                           (DWORD)(end - begin), &ret);
+    if(FAILED(hres))
+        return hres;
+    *r = jsval_obj(&ret->dispex);
+    return S_OK;
+}
+
+static const builtin_prop_t TypedArray_props[] = {
+    {L"BYTES_PER_ELEMENT",     NULL, 0,                    TypedArray_get_BYTES_PER_ELEMENT},
+    {L"set",                   TypedArray_set,             PROPF_METHOD|2},
+    {L"subarray",              TypedArray_subarray,        PROPF_METHOD|2},
+};
+
+static const builtin_prop_t TypedArrayInst_props[] = {
+    {L"BYTES_PER_ELEMENT",     NULL, 0,                    TypedArray_get_BYTES_PER_ELEMENT},
+    {L"buffer",                NULL, 0,                    TypedArray_get_buffer},
+    {L"byteLength",            NULL, 0,                    TypedArray_get_byteLength},
+    {L"byteOffset",            NULL, 0,                    TypedArray_get_byteOffset},
+    {L"length",                NULL, 0,                    TypedArray_get_length},
+};
+
+static HRESULT TypedArray_to_string(jsdisp_t *jsdisp, jsstr_t **ret)
+{
+    TypedArrayInstance *ta = typedarr_from_jsdisp(jsdisp);
+    WCHAR buf[40];
+
+    swprintf(buf, ARRAY_SIZE(buf), L"[object %s]", ta_info[ta->type].name);
+    return (*ret = jsstr_alloc(buf)) ? S_OK : E_OUTOFMEMORY;
+}
+
+static const builtin_info_t TypedArray_info = {
+    .class       = JSCLASS_TYPEDARRAY,
+    .props_cnt   = ARRAY_SIZE(TypedArray_props),
+    .props       = TypedArray_props,
+    .destructor  = TypedArray_destructor,
+    .lookup_prop = TypedArray_lookup_prop,
+    .next_prop   = TypedArray_next_prop,
+    .prop_get    = TypedArray_prop_get,
+    .prop_put    = TypedArray_prop_put,
+    .to_string   = TypedArray_to_string,
+    .gc_traverse = TypedArray_gc_traverse
+};
+
+static const builtin_info_t TypedArrayInst_info = {
+    .class       = JSCLASS_TYPEDARRAY,
+    .props_cnt   = ARRAY_SIZE(TypedArrayInst_props),
+    .props       = TypedArrayInst_props,
+    .destructor  = TypedArray_destructor,
+    .lookup_prop = TypedArray_lookup_prop,
+    .next_prop   = TypedArray_next_prop,
+    .prop_get    = TypedArray_prop_get,
+    .prop_put    = TypedArray_prop_put,
+    .to_string   = TypedArray_to_string,
+    .gc_traverse = TypedArray_gc_traverse
+};
+
+static HRESULT create_typedarr(script_ctx_t *ctx, ta_type_t type, ArrayBufferInstance *buffer, DWORD offset,
+                               DWORD length, TypedArrayInstance **ret)
+{
+    TypedArrayInstance *ta;
+    HRESULT hres;
+
+    if(!(ta = calloc(1, sizeof(*ta))))
+        return E_OUTOFMEMORY;
+
+    hres = init_dispex_from_constr(&ta->dispex, ctx, &TypedArrayInst_info, ctx->typedarr_constr[type]);
+    if(FAILED(hres)) {
+        free(ta);
+        return hres;
+    }
+    jsdisp_addref(&buffer->dispex);
+    ta->buffer = buffer;
+    ta->type = type;
+    ta->offset = offset;
+    ta->length = length;
+    *ret = ta;
+    return S_OK;
+}
+
+static HRESULT TypedArrayConstr_construct(script_ctx_t *ctx, ta_type_t type, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    const unsigned size = ta_info[type].size;
+    ArrayBufferInstance *buffer;
+    TypedArrayInstance *ta;
+    DWORD offset = 0, length = 0, i;
+    double n, *vals;
+    HRESULT hres;
+
+    TRACE("%s\n", debugstr_w(ta_info[type].name));
+
+    if(flags != DISPATCH_METHOD && flags != DISPATCH_CONSTRUCT) {
+        FIXME("unimplemented flags: %x\n", flags);
+        return E_NOTIMPL;
+    }
+
+    if(argc && (buffer = arraybuf_this(argv[0]))) {
+        DWORD bytes;
+
+        if(argc > 1 && !is_undefined(argv[1])) {
+            hres = to_integer(ctx, argv[1], &n);
+            if(FAILED(hres))
+                return hres;
+            if(n < 0.0 || n > buffer->size || fmod(n, size) != 0.0)
+                return JS_E_DATAVIEW_INVALID_OFFSET;
+            offset = n;
+        }
+        bytes = buffer->size - offset;
+        if(argc > 2 && !is_undefined(argv[2])) {
+            hres = to_integer(ctx, argv[2], &n);
+            if(FAILED(hres))
+                return hres;
+            if(n < 0.0 || n * size > bytes)
+                return JS_E_INVALID_LENGTH;
+            length = n;
+        }else {
+            if(bytes % size)
+                return JS_E_INVALID_LENGTH;
+            length = bytes / size;
+        }
+        if(!r)
+            return S_OK;
+        hres = create_typedarr(ctx, type, buffer, offset, length, &ta);
+        if(FAILED(hres))
+            return hres;
+        *r = jsval_obj(&ta->dispex);
+        return S_OK;
+    }
+
+    vals = NULL;
+    if(argc && is_object_instance(argv[0])) {
+        hres = ta_collect_source(ctx, argv[0], &vals, &length);
+        if(FAILED(hres))
+            return hres;
+    }else if(argc && !is_undefined(argv[0])) {
+        hres = to_integer(ctx, argv[0], &n);
+        if(FAILED(hres))
+            return hres;
+        if(n < 0.0 || n * size > INT_MAX)
+            return JS_E_INVALID_LENGTH;
+        length = n;
+    }
+
+    if(!r) {
+        free(vals);
+        return S_OK;
+    }
+
+    hres = create_arraybuf(ctx, length * size, &buffer);
+    if(SUCCEEDED(hres)) {
+        hres = create_typedarr(ctx, type, buffer, 0, length, &ta);
+        jsdisp_release(&buffer->dispex);
+    }
+    if(FAILED(hres)) {
+        free(vals);
+        return hres;
+    }
+    for(i = 0; vals && i < length; i++)
+        ta_write(ctx, ta, i, vals[i]);
+    free(vals);
+
+    *r = jsval_obj(&ta->dispex);
+    return S_OK;
+}
+
+#define TYPEDARR_CONSTR(id) \
+static HRESULT TypedArrayConstr_value_##id(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, \
+        jsval_t *argv, jsval_t *r) \
+{ \
+    return TypedArrayConstr_construct(ctx, id, flags, argc, argv, r); \
+} \
+static HRESULT TypedArrayConstr_get_BPE_##id(script_ctx_t *ctx, jsdisp_t *jsthis, jsval_t *r) \
+{ \
+    *r = jsval_number(ta_info[id].size); \
+    return S_OK; \
+} \
+static const builtin_prop_t TypedArrayConstr_props_##id[] = { \
+    {L"BYTES_PER_ELEMENT", NULL, 0, TypedArrayConstr_get_BPE_##id}, \
+}; \
+static const builtin_info_t TypedArrayConstr_info_##id = { \
+    .class     = JSCLASS_FUNCTION, \
+    .call      = Function_value, \
+    .props_cnt = ARRAY_SIZE(TypedArrayConstr_props_##id), \
+    .props     = TypedArrayConstr_props_##id, \
+};
+
+TYPEDARR_CONSTR(TA_INT8)
+TYPEDARR_CONSTR(TA_UINT8)
+TYPEDARR_CONSTR(TA_UINT8C)
+TYPEDARR_CONSTR(TA_INT16)
+TYPEDARR_CONSTR(TA_UINT16)
+TYPEDARR_CONSTR(TA_INT32)
+TYPEDARR_CONSTR(TA_UINT32)
+TYPEDARR_CONSTR(TA_FLOAT32)
+TYPEDARR_CONSTR(TA_FLOAT64)
+
+static HRESULT init_typedarr_constructors(script_ctx_t *ctx)
+{
+    static const struct {
+        builtin_invoke_t value;
+        const builtin_info_t *info;
+    } constrs[TA_COUNT] = {
+        { TypedArrayConstr_value_TA_INT8,    &TypedArrayConstr_info_TA_INT8 },
+        { TypedArrayConstr_value_TA_UINT8,   &TypedArrayConstr_info_TA_UINT8 },
+        { TypedArrayConstr_value_TA_UINT8C,  &TypedArrayConstr_info_TA_UINT8C },
+        { TypedArrayConstr_value_TA_INT16,   &TypedArrayConstr_info_TA_INT16 },
