From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: a face of a replaced font gives the replaced name as its family (7006)

Our font Replacements and the machine's FontSubstitutes make "Consolas"
Cascadia Mono, "Courier New" Liberation Mono, "Segoe UI" Inter. Chromium
makes each font a collection of its own from the font's file and checks
that the face it got is the family the page asked for, by the face's
family names (IDWriteFontFace3::GetFamilyNames) and the file's name
table; both said Cascadia Mono, so every Chromium and Electron program
fell back to a proportional font for Consolas -- VS Code's editor and
terminal were spaced wide. A face of a font some name stands for now
gives the first such name as its English family name; the font's family,
name table and informational strings keep its own names.
---
diff --git a/dlls/dwrite/font.c b/dlls/dwrite/font.c
index 8e871df..30dad72 100644
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -5880,6 +5880,112 @@ static UINT64 dwrite_fontface_get_font_object(struct dwrite_fontface *fontface)
     return fontface->font_object;
 }
 
+
+/* Stained Glass OS (wine-sg 7006): the names our font Replacements and the machine's
+ * FontSubstitutes give a font ("Consolas" -> Cascadia Mono, "Courier New" -> Liberation
+ * Mono) is the English family name a face of it reports (IDWriteFontFace3::GetFamilyNames;
+ * the font's family, its file's name table and its informational strings keep its own). Chromium makes each font a collection of its own from the font's file
+ * and then checks that the face it got is the family the page asked for -- by the face's
+ * family names, which only said "Cascadia Mono": every Chromium program (VS Code's editor and
+ * terminal, web pages asking for Consolas) fell back to a proportional font. */
+struct sg_font_alias
+{
+    WCHAR alias[LF_FACESIZE];
+    WCHAR target[LF_FACESIZE];
+};
+
+static struct sg_font_alias *sg_font_aliases;
+static size_t sg_font_alias_count;
+static INIT_ONCE sg_font_aliases_once = INIT_ONCE_STATIC_INIT;
+
+static void sg_add_font_alias(const WCHAR *alias, const WCHAR *target)
+{
+    struct sg_font_alias *aliases;
+
+    if (!alias[0] || !target[0] || wcslen(alias) >= LF_FACESIZE || wcslen(target) >= LF_FACESIZE) return;
+    if (!(aliases = realloc(sg_font_aliases, (sg_font_alias_count + 1) * sizeof(*aliases)))) return;
+    sg_font_aliases = aliases;
+    wcscpy(aliases[sg_font_alias_count].alias, alias);
+    wcscpy(aliases[sg_font_alias_count].target, target);
+    sg_font_alias_count++;
+}
+
+static BOOL WINAPI sg_load_font_aliases(INIT_ONCE *once, void *param, void **context)
+{
+    static const WCHAR * const gdi_only[] = { L"MS Shell Dlg", L"MS Shell Dlg 2", L"Helv", L"Tms Rmn", L"Times",
+        L"Helvetica", L"Courier" };
+    WCHAR name[256], data[512];
+    DWORD i, j, type, namelen, datalen;
+    HKEY hkey;
+
+    if (!RegOpenKeyA(HKEY_CURRENT_USER, "Software\\Wine\\Fonts\\Replacements", &hkey))
+    {
+        for (i = 0;; i++)
+        {
+            namelen = ARRAY_SIZE(name);
+            datalen = sizeof(data) - 2 * sizeof(WCHAR);
+            if (RegEnumValueW(hkey, i, name, &namelen, NULL, &type, (BYTE *)data, &datalen)) break;
+            data[datalen / sizeof(WCHAR)] = data[datalen / sizeof(WCHAR) + 1] = 0;
+            if (type == REG_SZ || type == REG_MULTI_SZ) sg_add_font_alias(name, data); /* the first choice */
+        }
+        RegCloseKey(hkey);
+    }
+    if (!RegOpenKeyA(HKEY_LOCAL_MACHINE, "Software\\Microsoft\\Windows NT\\CurrentVersion\\FontSubstitutes", &hkey))
+    {
+        for (i = 0;; i++)
+        {
+            BOOL skip;
+
+            namelen = ARRAY_SIZE(name);
+            datalen = sizeof(data) - sizeof(WCHAR);
+            if (RegEnumValueW(hkey, i, name, &namelen, NULL, &type, (BYTE *)data, &datalen)) break;
+            data[datalen / sizeof(WCHAR)] = 0;
+            skip = type != REG_SZ || wcschr(name, ',') || wcschr(data, ',');
+            for (j = 0; j < ARRAY_SIZE(gdi_only) && !skip; j++)
+                if (!wcsicmp(name, gdi_only[j])) skip = TRUE;
+            if (!skip) sg_add_font_alias(name, data);
+        }
+        RegCloseKey(hkey);
+    }
+    return TRUE;
+}
+
+/* the face's family names: the first name that stands for its family, then its own names
+ * in other languages */
+static IDWriteLocalizedStrings *sg_face_family_names(IDWriteLocalizedStrings *own)
+{
+    IDWriteLocalizedStrings *names;
+    WCHAR family[LF_FACESIZE], locale[LOCALE_NAME_MAX_LENGTH], string[256];
+    UINT32 i, count;
+    BOOL any = FALSE;
+    size_t k;
+
+    if (!own) return NULL;
+    InitOnceExecuteOnce(&sg_font_aliases_once, sg_load_font_aliases, NULL, NULL);
+    if (!sg_font_alias_count) return NULL;
+    fontstrings_get_en_string(own, family, ARRAY_SIZE(family));
+    if (!family[0]) return NULL;
+    for (k = 0; k < sg_font_alias_count && !any; k++)
+        if (!wcsicmp(sg_font_aliases[k].target, family) && wcsicmp(sg_font_aliases[k].alias, family)) any = TRUE;
+    if (!any || FAILED(create_localizedstrings(&names))) return NULL;
+    /* one name per locale: the first name standing for the font is its English one (a name
+     * standing for it is English); its names in other languages stay */
+    for (k = 0; k < sg_font_alias_count; k++)
+        if (!wcsicmp(sg_font_aliases[k].target, family) && wcsicmp(sg_font_aliases[k].alias, family))
+        {
+            add_localizedstring(names, L"en-us", sg_font_aliases[k].alias);
+            break;
+        }
+    count = IDWriteLocalizedStrings_GetCount(own);
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(IDWriteLocalizedStrings_GetLocaleName(own, i, locale, ARRAY_SIZE(locale)))) continue;
+        if (FAILED(IDWriteLocalizedStrings_GetString(own, i, string, ARRAY_SIZE(string)))) continue;
+        add_localizedstring(names, locale, string);
+    }
+    return names;
+}
+
 HRESULT create_fontface(const struct fontface_desc *desc, struct list *cached_list, IDWriteFontFace5 **ret)
 {
     struct file_stream_desc stream_desc;
@@ -5956,9 +6062,14 @@ HRESULT create_fontface(const struct fontface_desc *desc, struct list *cached_li
     fontface->names = font_data->names;
     if (fontface->names)
         IDWriteLocalizedStrings_AddRef(fontface->names);
-    fontface->family_names = font_data->family_names;
-    if (fontface->family_names)
-        IDWriteLocalizedStrings_AddRef(fontface->family_names);
+#ifndef SG_MUTANT_ALIAS_FACE_NAMES
+    if (!(fontface->family_names = sg_face_family_names(font_data->family_names)))
+#endif
+    {
+        fontface->family_names = font_data->family_names;
+        if (fontface->family_names)
+            IDWriteLocalizedStrings_AddRef(fontface->family_names);
+    }
     memcpy(fontface->info_strings, font_data->info_strings, sizeof(fontface->info_strings));
     for (i = 0; i < ARRAY_SIZE(fontface->info_strings); ++i)
     {
