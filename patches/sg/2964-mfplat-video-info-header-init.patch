From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: MFInitMediaTypeFromVideoInfoHeader/Header2 validation, bit rates, aspect ratio, palette

MFInitMediaTypeFromVideoInfoHeader and ...Header2 now follow
dlls/mfplat/tests (their todo_wine marks are removed):
- a header shorter than the structure is E_INVALIDARG;
- the frame size, pixel aspect ratio and interlace mode are only set for a
  non-empty frame (width and height);
- dwBitRate / dwBitErrorRate become MF_MT_AVG_BITRATE / MF_MT_AVG_BIT_ERROR_RATE
  when non-zero;
- VIDEOINFOHEADER2: the pixel aspect ratio is the display aspect ratio
  (dwPictAspectRatioX/Y) divided by the frame's aspect ratio, absent when
  either part is zero; VIDEOINFOHEADER keeps 1:1;
- 8-bit and 1-bit RGB: the color table behind bmiHeader.biSize becomes
  MF_MT_PALETTE (MF_E_INVALIDMEDIATYPE when it is not all there, no user data
  then); 1-bit RGB without a table gets a black/white palette;
- the DIB stride of RGB1/RGB4 is padded to a DWORD (-4 for 16 pixels of RGB1).
The two initializers share one helper.

---
diff --git a/dlls/mfplat/mediatype.c b/dlls/mfplat/mediatype.c
index c30ede9..2c85124 100644
--- a/dlls/mfplat/mediatype.c
+++ b/dlls/mfplat/mediatype.c
@@ -4334,20 +4334,28 @@ HRESULT WINAPI MFInitMediaTypeFromMFVideoFormat(IMFMediaType *media_type, const
     return hr;
 }
 
-/***********************************************************************
- *      MFInitMediaTypeFromVideoInfoHeader2 (mfplat.@)
- */
-HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader2(IMFMediaType *media_type, const VIDEOINFOHEADER2 *vih, UINT32 size,
-        const GUID *subtype)
+static UINT64 media_type_gcd(UINT64 a, UINT64 b)
+{
+    while (b)
+    {
+        UINT64 t = a % b;
+        a = b;
+        b = t;
+    }
+    return a;
+}
+
+/* Shared by the VIDEOINFOHEADER and VIDEOINFOHEADER2 initializers. The caller has checked that the header
+ * is complete; the bytes behind it (extra, extra_size) hold either the user data or, for the palettized
+ * RGB formats, the color table. */
+static HRESULT init_media_type_from_video_info(IMFMediaType *media_type, const VIDEOINFOHEADER2 *vih,
+        BOOL is_vih2, const BYTE *extra, UINT32 extra_size, const GUID *subtype)
 {
     HRESULT hr = S_OK;
-    DWORD height;
+    BOOL has_palette = FALSE;
+    DWORD width, height;
     LONG stride;
 
-    TRACE("%p, %p, %u, %s.\n", media_type, vih, size, debugstr_guid(subtype));
-
-    IMFMediaType_DeleteAllItems(media_type);
-
     if (!subtype)
     {
         switch (vih->bmiHeader.biBitCount)
@@ -4362,15 +4370,78 @@ HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader2(IMFMediaType *media_type, con
         }
     }
 
+    /* The color table of a palettized format sits behind bmiHeader.biSize; the user data cannot be there too. */
+    if ((IsEqualGUID(subtype, &MFVideoFormat_RGB8) || IsEqualGUID(subtype, &MFVideoFormat_RGB1))
+            && vih->bmiHeader.biClrUsed)
+    {
+        UINT64 offset = vih->bmiHeader.biSize > sizeof(BITMAPINFOHEADER) ? vih->bmiHeader.biSize - sizeof(BITMAPINFOHEADER) : 0;
+        UINT64 palette_size = (UINT64)vih->bmiHeader.biClrUsed * 4;
+
+#ifdef SG_MUTANT_MFVIH_PALETTE_NO_CHECK
+        if (0)
+#endif
+        if (offset + palette_size > extra_size)
+            return MF_E_INVALIDMEDIATYPE;
+        extra += offset;
+        extra_size = palette_size;
+        has_palette = TRUE;
+    }
+
+    IMFMediaType_DeleteAllItems(media_type);
+
+    width = vih->bmiHeader.biWidth;
     height = abs(vih->bmiHeader.biHeight);
 
     mediatype_set_guid(media_type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video, &hr);
     mediatype_set_guid(media_type, &MF_MT_SUBTYPE, subtype, &hr);
-    mediatype_set_uint64(media_type, &MF_MT_PIXEL_ASPECT_RATIO, 1, 1, &hr);
-    mediatype_set_uint64(media_type, &MF_MT_FRAME_SIZE, vih->bmiHeader.biWidth, height, &hr);
+
+    /* The frame geometry and everything derived from it needs a non-empty frame. */
+#ifdef SG_MUTANT_MFVIH_EMPTY_FRAME
+    if (1)
+#else
+    if (width && height)
+#endif
+    {
+        mediatype_set_uint64(media_type, &MF_MT_FRAME_SIZE, width, height, &hr);
+
+        if (is_vih2)
+        {
+            if (vih->dwPictAspectRatioX && vih->dwPictAspectRatioY)
+            {
+                /* pixel aspect ratio = display aspect ratio / frame aspect ratio */
+                UINT64 num = (UINT64)vih->dwPictAspectRatioX * height, den = (UINT64)vih->dwPictAspectRatioY * width;
+                UINT64 gcd = media_type_gcd(num, den);
+#ifdef SG_MUTANT_MFVIH_PAR_RAW
+                num = vih->dwPictAspectRatioX; den = vih->dwPictAspectRatioY; gcd = 1;
+#endif
+
+                mediatype_set_uint64(media_type, &MF_MT_PIXEL_ASPECT_RATIO, num / gcd, den / gcd, &hr);
+            }
+        }
+        else
+            mediatype_set_uint64(media_type, &MF_MT_PIXEL_ASPECT_RATIO, 1, 1, &hr);
+
+        if (!(vih->dwInterlaceFlags & AMINTERLACE_IsInterlaced))
+            mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive, &hr);
+        else if (vih->dwInterlaceFlags & AMINTERLACE_DisplayModeBobOrWeave)
+            mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_MixedInterlaceOrProgressive, &hr);
+        else
+            FIXME("dwInterlaceFlags %#lx not implemented\n", vih->dwInterlaceFlags);
+    }
 
     if (SUCCEEDED(mf_get_stride_for_bitmap_info_header(subtype->Data1, &vih->bmiHeader, &stride)))
     {
+        if (IsEqualGUID(subtype, &MFVideoFormat_RGB1) || IsEqualGUID(subtype, &MFVideoFormat_RGB4))
+        {
+            unsigned int bpp = IsEqualGUID(subtype, &MFVideoFormat_RGB1) ? 1 : 4;
+
+            /* the rows of the packed formats are padded to a DWORD */
+            stride = ((width * bpp + 31) / 32) * 4;
+#ifdef SG_MUTANT_MFVIH_STRIDE_PLAIN
+            stride = width * bpp / 8;
+#endif
+            if (vih->bmiHeader.biHeight >= 0) stride = -stride;
+        }
         mediatype_set_uint32(media_type, &MF_MT_DEFAULT_STRIDE, stride, &hr);
         mediatype_set_uint32(media_type, &MF_MT_SAMPLE_SIZE, abs(stride) * height, &hr);
         mediatype_set_uint32(media_type, &MF_MT_FIXED_SIZE_SAMPLES, 1, &hr);
@@ -4380,6 +4451,14 @@ HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader2(IMFMediaType *media_type, con
     if (vih->bmiHeader.biSizeImage)
         mediatype_set_uint32(media_type, &MF_MT_SAMPLE_SIZE, vih->bmiHeader.biSizeImage, &hr);
 
+#ifdef SG_MUTANT_MFVIH_NO_BITRATE
+    if (0)
+#endif
+    if (vih->dwBitRate)
+        mediatype_set_uint32(media_type, &MF_MT_AVG_BITRATE, vih->dwBitRate, &hr);
+    if (vih->dwBitErrorRate)
+        mediatype_set_uint32(media_type, &MF_MT_AVG_BIT_ERROR_RATE, vih->dwBitErrorRate, &hr);
+
     if (vih->rcSource.left || vih->rcSource.top || vih->rcSource.right || vih->rcSource.bottom)
     {
         MFVideoArea aperture = {{0}};
@@ -4401,7 +4480,7 @@ HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader2(IMFMediaType *media_type, con
             mediatype_set_uint64(media_type, &MF_MT_FRAME_RATE, num, den, &hr);
     }
 
-    if (vih->dwControlFlags & AMCONTROL_COLORINFO_PRESENT)
+    if (is_vih2 && (vih->dwControlFlags & AMCONTROL_COLORINFO_PRESENT))
     {
         DXVA_ExtendedFormat *format = (DXVA_ExtendedFormat *)&vih->dwControlFlags;
 
@@ -4419,17 +4498,45 @@ HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader2(IMFMediaType *media_type, con
             mediatype_set_uint32(media_type, &MF_MT_TRANSFER_FUNCTION, format->VideoTransferFunction, &hr);
     }
 
-    if (!(vih->dwInterlaceFlags & AMINTERLACE_IsInterlaced))
-        mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive, &hr);
-    else if (vih->dwInterlaceFlags & AMINTERLACE_DisplayModeBobOrWeave)
-        mediatype_set_uint32(media_type, &MF_MT_INTERLACE_MODE, MFVideoInterlace_MixedInterlaceOrProgressive, &hr);
+    if (has_palette)
+    {
+        mediatype_set_blob(media_type, &MF_MT_PALETTE, extra, extra_size, &hr);
+#ifdef SG_MUTANT_MFVIH_PALETTE_USERDATA
+        mediatype_set_blob(media_type, &MF_MT_USER_DATA, extra, extra_size, &hr);
+#endif
+    }
     else
-        FIXME("dwInterlaceFlags %#lx not implemented\n", vih->dwInterlaceFlags);
-
-    if (size > sizeof(*vih)) mediatype_set_blob(media_type, &MF_MT_USER_DATA, (BYTE *)(vih + 1), size - sizeof(*vih), &hr);
+    {
+        if (IsEqualGUID(subtype, &MFVideoFormat_RGB1))
+        {
+            /* monochrome: black and white */
+            static const BYTE mono[] = {0,0,0,0, 255,255,255,0};
+            mediatype_set_blob(media_type, &MF_MT_PALETTE, mono, sizeof(mono), &hr);
+        }
+        if (extra_size)
+            mediatype_set_blob(media_type, &MF_MT_USER_DATA, extra, extra_size, &hr);
+    }
     return hr;
 }
 
+/***********************************************************************
+ *      MFInitMediaTypeFromVideoInfoHeader2 (mfplat.@)
+ */
+HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader2(IMFMediaType *media_type, const VIDEOINFOHEADER2 *vih, UINT32 size,
+        const GUID *subtype)
+{
+    TRACE("%p, %p, %u, %s.\n", media_type, vih, size, debugstr_guid(subtype));
+
+#ifndef SG_MUTANT_MFVIH_NO_SIZE_CHECK
+    if (size < sizeof(*vih))
+        return E_INVALIDARG;
+#else
+    if (size < sizeof(*vih)) size = sizeof(*vih);
+#endif
+
+    return init_media_type_from_video_info(media_type, vih, TRUE, (const BYTE *)(vih + 1), size - sizeof(*vih), subtype);
+}
+
 /***********************************************************************
  *      MFInitMediaTypeFromVideoInfoHeader (mfplat.@)
  */
@@ -4445,13 +4552,13 @@ HRESULT WINAPI MFInitMediaTypeFromVideoInfoHeader(IMFMediaType *media_type, cons
         .AvgTimePerFrame = vih->AvgTimePerFrame,
         .bmiHeader = vih->bmiHeader,
     };
-    HRESULT hr;
 
     TRACE("%p, %p, %u, %s.\n", media_type, vih, size, debugstr_guid(subtype));
 
-    hr = MFInitMediaTypeFromVideoInfoHeader2(media_type, &vih2, sizeof(vih2), subtype);
-    if (size > sizeof(*vih)) mediatype_set_blob(media_type, &MF_MT_USER_DATA, (BYTE *)(vih + 1), size - sizeof(*vih), &hr);
-    return hr;
+    if (size < sizeof(*vih))
+        return E_INVALIDARG;
+
+    return init_media_type_from_video_info(media_type, &vih2, FALSE, (const BYTE *)(vih + 1), size - sizeof(*vih), subtype);
 }
 
