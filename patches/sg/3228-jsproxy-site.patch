From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 10:30:15 -0700
Subject: [PATCH] jsproxy: the global object and script site (3228)

IDispatch/IDispatchEx of the global functions object (type info, names,
invoke, delete, properties, member names, enumeration) and the
IActiveScriptSite notifications (LCID, item info, document version,
state, script errors, enter/leave, terminate).

diff --git a/dlls/jsproxy/main.c b/dlls/jsproxy/main.c
index 9506b71..6907ab8 100644
--- a/dlls/jsproxy/main.c
+++ b/dlls/jsproxy/main.c
@@ -154,6 +154,7 @@ BOOL WINAPI JSPROXY_InternetInitializeAutoProxyDll( DWORD version, LPSTR tmpfile
     return ret;
 }
 
+/* SG-SLICE-BEGIN: the global object and the site, cut out by test/fastjsproxy-gate.sh */
 static HRESULT WINAPI dispex_QueryInterface(
     IDispatchEx *iface, REFIID riid, void **ppv )
 {
@@ -181,77 +182,166 @@ static ULONG WINAPI dispex_Release(
     return 1;
 }
 
+#define DISPID_GLOBAL_DNSRESOLVE  0x1000
+
+static HRESULT WINAPI dispex_InvokeEx(
+    IDispatchEx *iface, DISPID id, LCID lcid, WORD flags, DISPPARAMS *params,
+    VARIANT *result, EXCEPINFO *exep, IServiceProvider *caller );
+static HRESULT WINAPI dispex_GetDispID(
+    IDispatchEx *iface, BSTR name, DWORD flags, DISPID *id );
+
+/* the object has no type information */
 static HRESULT WINAPI dispex_GetTypeInfoCount(
     IDispatchEx *iface, UINT *info )
 {
-    return E_NOTIMPL;
+    if (!info) return E_POINTER;
+#ifdef SG_MUTANT_JSP_TICOUNT
+    *info = 1;
+#else
+    *info = 0;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI dispex_GetTypeInfo(
     IDispatchEx *iface, UINT info, LCID lcid, ITypeInfo **type_info )
 {
-    return E_NOTIMPL;
+    if (!type_info) return E_POINTER;
+    *type_info = NULL;
+#ifdef SG_MUTANT_JSP_TIBAD
+    return TYPE_E_ELEMENTNOTFOUND;
+#else
+    return info ? DISP_E_BADINDEX : TYPE_E_ELEMENTNOTFOUND;
+#endif
 }
 
 static HRESULT WINAPI dispex_GetIDsOfNames(
     IDispatchEx *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *id )
 {
-    return E_NOTIMPL;
+    HRESULT hr;
+    UINT i;
+
+#ifndef SG_MUTANT_JSP_RIID
+    if (!IsEqualGUID( riid, &IID_NULL )) return DISP_E_UNKNOWNINTERFACE;
+#endif
+    if (!names || !id) return E_POINTER;
+    if (!count) return E_INVALIDARG;
+
+    hr = dispex_GetDispID( iface, names[0], fdexNameCaseSensitive, &id[0] );
+    /* the members are not methods with named arguments */
+    for (i = 1; i < count; i++)
+    {
+#ifndef SG_MUTANT_JSP_NAMEDARGS
+        id[i] = DISPID_UNKNOWN;
+        hr = DISP_E_UNKNOWNNAME;
+#endif
+    }
+    return hr;
 }
 
 static HRESULT WINAPI dispex_Invoke(
     IDispatchEx *iface, DISPID member, REFIID riid, LCID lcid, WORD flags,
     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *err )
 {
+    if (!IsEqualGUID( riid, &IID_NULL )) return DISP_E_UNKNOWNINTERFACE;
+    if (err) *err = 0;
+#ifdef SG_MUTANT_JSP_INVOKE
     return E_NOTIMPL;
+#endif
+    return dispex_InvokeEx( iface, member, lcid, flags, params, result, excep, NULL );
 }
 
+/* the members are built in: they cannot be deleted, and there is no other */
 static HRESULT WINAPI dispex_DeleteMemberByName(
     IDispatchEx *iface, BSTR name, DWORD flags )
 {
-    return E_NOTIMPL;
+    DISPID id;
+
+    if (!name) return E_INVALIDARG;
+    if (dispex_GetDispID( iface, name, flags & (fdexNameCaseSensitive | fdexNameCaseInsensitive), &id ) != S_OK)
+#ifdef SG_MUTANT_JSP_DELETE
+        return S_OK;
+    return S_OK;
+#else
+        return S_OK;
+    return S_FALSE;
+#endif
 }
 
 static HRESULT WINAPI dispex_DeleteMemberByDispID(
     IDispatchEx *iface, DISPID id )
 {
-    return E_NOTIMPL;
+#ifdef SG_MUTANT_JSP_DELID
+    return S_OK;
+#endif
+    return id == DISPID_GLOBAL_DNSRESOLVE ? S_FALSE : DISP_E_MEMBERNOTFOUND;
 }
 
 static HRESULT WINAPI dispex_GetMemberProperties(
     IDispatchEx *iface, DISPID id, DWORD flags_fetch, DWORD *flags )
 {
-    return E_NOTIMPL;
+    if (!flags) return E_POINTER;
+    *flags = 0;
+    if (id != DISPID_GLOBAL_DNSRESOLVE) return DISP_E_MEMBERNOTFOUND;
+    /* a function: it can be called and nothing else */
+#ifdef SG_MUTANT_JSP_PROPS
+    *flags = flags_fetch & fdexPropCanGet;
+#else
+    *flags = flags_fetch & (fdexPropCanCall | fdexPropCannotGet | fdexPropCannotPut | fdexPropCannotPutRef |
+                            fdexPropCannotConstruct | fdexPropCannotSourceEvents);
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI dispex_GetMemberName(
     IDispatchEx *iface, DISPID id, BSTR *name )
 {
-    return E_NOTIMPL;
+    if (!name) return E_POINTER;
+    *name = NULL;
+    if (id != DISPID_GLOBAL_DNSRESOLVE) return DISP_E_MEMBERNOTFOUND;
+#ifdef SG_MUTANT_JSP_MEMBERNAME
+    return (*name = SysAllocString( L"dnsresolve" )) ? S_OK : E_OUTOFMEMORY;
+#else
+    return (*name = SysAllocString( L"dns_resolve" )) ? S_OK : E_OUTOFMEMORY;
+#endif
 }
 
 static HRESULT WINAPI dispex_GetNextDispID(
     IDispatchEx *iface, DWORD flags, DISPID id, DISPID *next )
 {
-    return E_NOTIMPL;
+    if (!next) return E_POINTER;
+    if (id == DISPID_STARTENUM)
+    {
+        *next = DISPID_GLOBAL_DNSRESOLVE;
+        return S_OK;
+    }
+    *next = DISPID_UNKNOWN;
+#ifdef SG_MUTANT_JSP_NEXT
+    return S_OK;
+#endif
+    return id == DISPID_GLOBAL_DNSRESOLVE ? S_FALSE : DISP_E_MEMBERNOTFOUND;
 }
 
+/* the global members have no parent namespace */
 static HRESULT WINAPI dispex_GetNameSpaceParent(
     IDispatchEx *iface, IUnknown **unk )
 {
-    return E_NOTIMPL;
+    if (!unk) return E_POINTER;
+    *unk = NULL;
+    return S_OK;
 }
 
-#define DISPID_GLOBAL_DNSRESOLVE  0x1000
 
 static HRESULT WINAPI dispex_GetDispID(
     IDispatchEx *iface, BSTR name, DWORD flags, DISPID *id )
 {
-    if (!lstrcmpW( name, L"dns_resolve" ))
+    if (!name) return E_INVALIDARG;
+    if (!((flags & fdexNameCaseInsensitive) ? lstrcmpiW( name, L"dns_resolve" ) : lstrcmpW( name, L"dns_resolve" )))
     {
         *id = DISPID_GLOBAL_DNSRESOLVE;
         return S_OK;
     }
+    *id = DISPID_UNKNOWN;
     return DISP_E_UNKNOWNNAME;
 }
 
@@ -317,9 +407,17 @@ static HRESULT WINAPI dispex_InvokeEx(
 {
     if (id == DISPID_GLOBAL_DNSRESOLVE)
     {
-        if (params->cArgs != 1) return DISP_E_BADPARAMCOUNT;
+        if (!params || params->cArgs != 1) return DISP_E_BADPARAMCOUNT;
+        if (params->cNamedArgs) return DISP_E_NONAMEDARGS;
         if (V_VT(&params->rgvarg[0]) != VT_BSTR) return DISP_E_BADVARTYPE;
-        return dns_resolve( V_BSTR(&params->rgvarg[0]), result );
+        {
+            VARIANT tmp;
+            HRESULT hr;
+
+            hr = dns_resolve( V_BSTR(&params->rgvarg[0]), result ? result : &tmp );
+            if (!result && hr == S_OK) VariantClear( &tmp );
+            return hr;
+        }
     }
     return DISP_E_MEMBERNOTFOUND;
 }
@@ -373,58 +471,116 @@ static ULONG WINAPI site_Release(
     return 1;
 }
 
+/* the scripts are locale neutral: the language of the system */
 static HRESULT WINAPI site_GetLCID(
     IActiveScriptSite *iface, LCID *lcid )
 {
+    if (!lcid) return E_POINTER;
+#ifdef SG_MUTANT_JSP_LCID
     return E_NOTIMPL;
+#endif
+    *lcid = LOCALE_SYSTEM_DEFAULT;
+    return S_OK;
 }
 
 static HRESULT WINAPI site_GetItemInfo(
     IActiveScriptSite *iface, LPCOLESTR name, DWORD mask,
     IUnknown **item, ITypeInfo **type_info )
 {
-    if (!lstrcmpW( name, L"global_funcs" ) && mask == SCRIPTINFO_IUNKNOWN)
+    if (item) *item = NULL;
+    if (type_info) *type_info = NULL;
+    if (!name) return E_POINTER;
+
+#ifndef SG_MUTANT_JSP_ITEM
+    if (lstrcmpW( name, L"global_funcs" )) return TYPE_E_ELEMENTNOTFOUND;
+#endif
+    if (mask & SCRIPTINFO_IUNKNOWN)
     {
+        if (!item) return E_POINTER;
         *item = (IUnknown *)&global_dispex;
-        return S_OK;
+        IUnknown_AddRef( *item );
     }
-    return E_NOTIMPL;
+    /* the object has no type information, so the engine gets none */
+    if (mask & SCRIPTINFO_ITYPEINFO)
+    {
+        if (!type_info) return E_POINTER;
+        return TYPE_E_ELEMENTNOTFOUND;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI site_GetDocVersionString(
     IActiveScriptSite *iface, BSTR *version )
 {
+    if (!version) return E_POINTER;
+    /* one version of the document: the script as it was loaded */
+#ifdef SG_MUTANT_JSP_DOCVER
     return E_NOTIMPL;
+#endif
+    return (*version = SysAllocString( L"1" )) ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI site_OnScriptTerminate(
     IActiveScriptSite *iface, const VARIANT *result, const EXCEPINFO *info )
 {
+#ifdef SG_MUTANT_JSP_TERMINATE
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI site_OnStateChange(
     IActiveScriptSite *iface, SCRIPTSTATE state )
 {
+    TRACE( "state %d\n", state );
+#ifdef SG_MUTANT_JSP_STATE
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
+/* a script error is reported in the log, and the call fails in the engine */
 static HRESULT WINAPI site_OnScriptError(
     IActiveScriptSite *iface, IActiveScriptError *error )
 {
+    EXCEPINFO info;
+    DWORD context;
+    ULONG line;
+    LONG pos;
+
+    memset( &info, 0, sizeof(info) );
+    if (error && IActiveScriptError_GetExceptionInfo( error, &info ) == S_OK)
+    {
+        context = 0; line = 0; pos = 0;
+        IActiveScriptError_GetSourcePosition( error, &context, &line, &pos );
+        WARN( "script error 0x%08lx at line %lu, column %ld: %s\n", info.scode, line, pos,
+              debugstr_w(info.bstrDescription) );
+        SysFreeString( info.bstrSource );
+        SysFreeString( info.bstrDescription );
+        SysFreeString( info.bstrHelpFile );
+    }
+#ifdef SG_MUTANT_JSP_ONERROR
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI site_OnEnterScript(
     IActiveScriptSite *iface )
 {
+#ifdef SG_MUTANT_JSP_ENTER
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI site_OnLeaveScript(
     IActiveScriptSite *iface )
 {
+#ifdef SG_MUTANT_JSP_LEAVE
     return E_NOTIMPL;
+#endif
+    return S_OK;
 }
 
 static const IActiveScriptSiteVtbl site_vtbl =
@@ -443,6 +599,7 @@ static const IActiveScriptSiteVtbl site_vtbl =
 };
 
 static IActiveScriptSite script_site = { &site_vtbl };
