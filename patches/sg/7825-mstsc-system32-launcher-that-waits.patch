From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mstsc: a system32 launcher for Remote Desktop Connection that
 lasts as long as it

---
 configure                  |  2 ++
 configure.ac               |  1 +
 programs/calc/handoff.c    | 17 +++++++++++++++--
 programs/mstsc/Makefile.in |  8 ++++++++
 4 files changed, 26 insertions(+), 2 deletions(-)
 create mode 100644 programs/mstsc/Makefile.in

diff --git a/configure b/configure
index 5b2d989..5efe08d 100755
--- a/configure
+++ b/configure
@@ -1732,6 +1732,7 @@ enable_msidb
 enable_msiexec
 enable_msinfo32
 enable_mspaint
+enable_mstsc
 enable_net
 enable_netsh
 enable_netstat
@@ -23228,6 +23229,7 @@ wine_fn_config_makefile programs/msidb enable_msidb
 wine_fn_config_makefile programs/msiexec enable_msiexec
 wine_fn_config_makefile programs/msinfo32 enable_msinfo32
 wine_fn_config_makefile programs/mspaint enable_mspaint
+wine_fn_config_makefile programs/mstsc enable_mstsc
 wine_fn_config_makefile programs/net enable_net
 wine_fn_config_makefile programs/net/tests enable_tests
 wine_fn_config_makefile programs/netsh enable_netsh
diff --git a/configure.ac b/configure.ac
index 2c1c2e0..5947a27 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3521,6 +3521,7 @@ WINE_CONFIG_MAKEFILE(programs/msidb)
 WINE_CONFIG_MAKEFILE(programs/msiexec)
 WINE_CONFIG_MAKEFILE(programs/msinfo32)
 WINE_CONFIG_MAKEFILE(programs/mspaint)
+WINE_CONFIG_MAKEFILE(programs/mstsc)
 WINE_CONFIG_MAKEFILE(programs/net)
 WINE_CONFIG_MAKEFILE(programs/net/tests)
 WINE_CONFIG_MAKEFILE(programs/netsh)
diff --git a/programs/calc/handoff.c b/programs/calc/handoff.c
index 5c44a08..cd7de0d 100644
--- a/programs/calc/handoff.c
+++ b/programs/calc/handoff.c
@@ -1,5 +1,5 @@
 /*
- * Stained Glass OS: calc.exe, charmap.exe, magnify.exe, mspaint.exe, osk.exe,
+ * Stained Glass OS: calc.exe, charmap.exe, magnify.exe, mspaint.exe, mstsc.exe, osk.exe,
  * snippingtool.exe and wt.exe
  *
  * Windows ships these in system32 (wt.exe as an app execution alias on the
@@ -11,6 +11,10 @@
  * Terminal) with the same arguments
  * and exits, as Windows' own calc.exe is a launcher for the Calculator app.
  *
+ * mstsc.exe (wine-sg 7825) is the exception that waits: it starts sg-shell's Remote Desktop
+ * Connection and returns when it does, with its exit code, as mstsc lasts as long as its session --
+ * Remote Desktop Manager's "Open (external)" looks for system32's mstsc.exe and watches it.
+ *
  * Copyright 2026 Stained Glass OS contributors
  *
  * This library is free software; you can redistribute it and/or
@@ -91,10 +95,19 @@ int WINAPI wWinMain( HINSTANCE inst, HINSTANCE prev, WCHAR *args, int show )
             TRACE( "%s -> %s\n", debugstr_w(name), debugstr_w(cmd) );
             if (CreateProcessW( target, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
             {
+                DWORD code = 0;
+
                 CloseHandle( pi.hThread );
+#ifndef SG_MUTANT_MSTSC_NO_WAIT
+                if (!wcsicmp( name, L"mstsc.exe" ))
+                {
+                    WaitForSingleObject( pi.hProcess, INFINITE );
+                    GetExitCodeProcess( pi.hProcess, &code );
+                }
+#endif
                 CloseHandle( pi.hProcess );
                 free( cmd );
-                return 0;
+                return code;
             }
             WARN( "could not start %s: %lu\n", debugstr_w(target), GetLastError() );
             free( cmd );
diff --git a/programs/mstsc/Makefile.in b/programs/mstsc/Makefile.in
new file mode 100644
index 0000000..d384e2c
--- /dev/null
+++ b/programs/mstsc/Makefile.in
@@ -0,0 +1,8 @@
+MODULE    = mstsc.exe
+IMPORTS   = advapi32 user32
+PARENTSRC = ../calc
+
+EXTRADLLFLAGS = -mwindows -municode
+
+SOURCES = \
+	handoff.c
-- 
2.47.3

