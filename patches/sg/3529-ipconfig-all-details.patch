+    STRING_DNS_SERVERS, "DNS servers"
+    STRING_MEDIA_STATE, "Media state"
+    STRING_MEDIA_DISCONNECTED, "Media disconnected"
+    STRING_AUTOCONF, "Autoconfiguration enabled"
+    STRING_DHCP_SERVER, "DHCP server"
+    STRING_LEASE_OBTAINED, "Lease obtained"
+    STRING_LEASE_EXPIRES, "Lease expires"
