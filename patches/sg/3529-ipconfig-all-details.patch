     STRING_INVALID_CMDLINE, "Error: Unknown or invalid command line parameters specified\n"
     STRING_ADAPTER_FRIENDLY, "%1 adapter %2\n"
     STRING_ETHERNET, "Ethernet"
@@ -48,4 +48,12 @@
     STRING_NO, "No"
     STRING_DEFAULT_GATEWAY, "Default gateway"
