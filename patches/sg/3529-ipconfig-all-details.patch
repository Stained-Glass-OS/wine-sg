From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ipconfig: subnet mask, DNS servers, DHCP lease, media state (3529)

ipconfig: subnet mask, DNS servers, DHCP lease, media state

ipconfig and ipconfig /all print the subnet mask after each IPv4 address, /all adds DNS servers, autoconfiguration, DHCP server and lease times (from GetAdaptersInfo) and the media state of a disconnected adapter; usage lists /release /renew /flushdns (already backed by sg-netctl).
---
--- a/programs/ipconfig/ipconfig.c
+++ b/programs/ipconfig/ipconfig.c
@@ -20,6 +20,7 @@
  */
 
 #include <stdio.h>
+#include <time.h>
 #include <winsock2.h>
 #include <windows.h>
 #include <iphlpapi.h>
@@ -157,6 +158,85 @@
     return NULL;
 }
 
+/* "255.255.255.0" for a prefix length */
+static void prefix_to_mask(UINT8 prefix, WCHAR *buf, size_t size)
+{
+    UINT32 mask = prefix >= 32 ? 0xffffffff : prefix ? ~(0xffffffffu >> prefix) : 0;
+
+    swprintf(buf, size, L"%u.%u.%u.%u", mask >> 24, (mask >> 16) & 255, (mask >> 8) & 255, mask & 255);
+}
+
+static void print_dns_servers(IP_ADAPTER_ADDRESSES *p)
+{
+    IP_ADAPTER_DNS_SERVER_ADDRESS *dns;
+    WCHAR addr_buf[54];
+    BOOL first = TRUE;
+
+    for (dns = p->FirstDnsServerAddress; dns; dns = dns->Next)
+    {
+        if (!socket_address_to_string(addr_buf, ARRAY_SIZE(addr_buf), &dns->Address)) continue;
+        if (first) print_field(STRING_DNS_SERVERS, addr_buf);
+        else print_value(addr_buf);
+        first = FALSE;
+    }
+}
+
+static void format_lease_time(time_t t, WCHAR *buf, size_t size)
+{
+    FILETIME ft;
+    SYSTEMTIME st, local;
+    ULARGE_INTEGER u;
+
+    u.QuadPart = ((ULONGLONG)t + 11644473600ULL) * 10000000ULL;
+    ft.dwLowDateTime = u.LowPart;
+    ft.dwHighDateTime = u.HighPart;
+    FileTimeToSystemTime(&ft, &st);
+    SystemTimeToTzSpecificLocalTime(NULL, &st, &local);
+    swprintf(buf, size, L"%04u-%02u-%02u %02u:%02u:%02u", local.wYear, local.wMonth, local.wDay, local.wHour,
+             local.wMinute, local.wSecond);
+}
+
+/* the DHCP server and lease of an adapter, from the IPv4 adapter table */
+static void print_dhcp_details(IP_ADAPTER_ADDRESSES *p)
+{
+    IP_ADAPTER_INFO *info = NULL, *a;
+    ULONG size = 0;
+    WCHAR buf[64];
+
+    if (GetAdaptersInfo(NULL, &size) != ERROR_BUFFER_OVERFLOW || !(info = malloc(size))) return;
+    if (GetAdaptersInfo(info, &size) == ERROR_SUCCESS)
+    {
+        for (a = info; a; a = a->Next)
+        {
+            if (a->Index != p->IfIndex || !a->DhcpEnabled) continue;
+            if (a->DhcpServer.IpAddress.String[0] && strcmp(a->DhcpServer.IpAddress.String, "0.0.0.0"))
+            {
+                MultiByteToWideChar(CP_ACP, 0, a->DhcpServer.IpAddress.String, -1, buf, ARRAY_SIZE(buf));
+                print_field(STRING_DHCP_SERVER, buf);
+            }
+            if (a->LeaseObtained)
+            {
+                format_lease_time(a->LeaseObtained, buf, ARRAY_SIZE(buf));
+                print_field(STRING_LEASE_OBTAINED, buf);
+            }
+            if (a->LeaseExpires)
+            {
+                format_lease_time(a->LeaseExpires, buf, ARRAY_SIZE(buf));
+                print_field(STRING_LEASE_EXPIRES, buf);
+            }
+        }
+    }
+    free(info);
+}
+
+static void print_ipv4_mask(IP_ADAPTER_UNICAST_ADDRESS *addr)
+{
+    WCHAR mask[20];
+
+    prefix_to_mask(addr->OnLinkPrefixLength, mask, ARRAY_SIZE(mask));
+    print_field(STRING_SUBNET_MASK, mask);
+}
+
 static void print_basic_information(void)
 {
     IP_ADAPTER_ADDRESSES *adapters, *p;
@@ -179,11 +259,13 @@
         {
             if (addr->Address.lpSockaddr->sa_family == AF_INET &&
                 socket_address_to_string(addr_buf, ARRAY_SIZE(addr_buf), &addr->Address))
+            {
                 print_field(STRING_IP_ADDRESS, addr_buf);
+                print_ipv4_mask(addr);
+            }
             else if (addr->Address.lpSockaddr->sa_family == AF_INET6 &&
                      socket_address_to_string(addr_buf, ARRAY_SIZE(addr_buf), &addr->Address))
                 print_field(STRING_IP6_ADDRESS, addr_buf);
-            /* FIXME: Output corresponding subnet mask. */
         }
 
         if (p->FirstGatewayAddress)
@@ -264,6 +346,14 @@
     return msg_buffer;
 }
 
+static const WCHAR *ipconfig_media_disconnected(void)
+{
+    static WCHAR msg_buffer[50];
+
+    LoadStringW(GetModuleHandleW(NULL), STRING_MEDIA_DISCONNECTED, msg_buffer, ARRAY_SIZE(msg_buffer));
+    return msg_buffer;
+}
+
 static void print_full_information(void)
 {
     FIXED_INFO *info;
@@ -315,17 +405,25 @@
         print_field(STRING_PHYS_ADDR, physaddr_to_string(physaddr_buf, p->PhysicalAddress, p->PhysicalAddressLength));
         print_field(STRING_DHCP_ENABLED, boolean_to_string(p->Flags & IP_ADAPTER_DHCP_ENABLED));
 
-        /* FIXME: Output autoconfiguration status. */
+        if (p->OperStatus == IfOperStatusDown)
+            print_field(STRING_MEDIA_STATE, ipconfig_media_disconnected());
+        if (p->Flags & IP_ADAPTER_DHCP_ENABLED)
+        {
+            print_field(STRING_AUTOCONF, boolean_to_string(TRUE));
+            print_dhcp_details(p);
+        }
 
         for (addr = p->FirstUnicastAddress; addr; addr = addr->Next)
         {
             if (addr->Address.lpSockaddr->sa_family == AF_INET &&
                 socket_address_to_string(addr_buf, ARRAY_SIZE(addr_buf), &addr->Address))
+            {
                 print_field(STRING_IP_ADDRESS, addr_buf);
+                print_ipv4_mask(addr);
+            }
             else if (addr->Address.lpSockaddr->sa_family == AF_INET6 &&
                      socket_address_to_string(addr_buf, ARRAY_SIZE(addr_buf), &addr->Address))
                 print_field(STRING_IP6_ADDRESS, addr_buf);
-            /* FIXME: Output corresponding subnet mask. */
         }
 
         if (p->FirstGatewayAddress)
@@ -342,6 +440,7 @@
         else
             print_field(STRING_DEFAULT_GATEWAY, L"");
 
+        print_dns_servers(p);
         ipconfig_printfW(L"\n");
     }
     free(adapters);
--- a/programs/ipconfig/ipconfig.h
+++ b/programs/ipconfig/ipconfig.h
@@ -43,3 +43,11 @@
 #define STRING_DEFAULT_GATEWAY  120
 #define STRING_IP6_ADDRESS      121
