+#define STRING_DNS_SERVERS      124
+#define STRING_MEDIA_STATE      125
+#define STRING_MEDIA_DISCONNECTED 126
+#define STRING_AUTOCONF         127
+#define STRING_DHCP_SERVER      128
+#define STRING_LEASE_OBTAINED   129
+#define STRING_LEASE_EXPIRES    130
