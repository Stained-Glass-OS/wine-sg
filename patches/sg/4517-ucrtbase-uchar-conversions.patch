From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ucrtbase: Implement mbrtoc16, mbrtoc32, c16rtomb and c32rtomb.

ucrtbase's mbrtoc16, mbrtoc32, c16rtomb and c32rtomb (and the _o_ forms)
were spec stubs. They convert between UTF-8 and UTF-16/UTF-32 whatever the
locale, as the UCRT documents: partial characters are kept in the
mbstate_t, mbrtoc16 returns a supplementary character as a surrogate pair
(the low half with (size_t)-3), c16rtomb takes a pair over two calls, and
overlong forms, surrogates and values past U+10FFFF fail with EILSEQ.
---
 dlls/msvcrt/mbcs.c          | 207 ++++++++++++++++++++++++++++++++++++++++++++
 dlls/ucrtbase/ucrtbase.spec |  12 +--
 2 files changed, 213 insertions(+), 6 deletions(-)

diff --git a/dlls/msvcrt/mbcs.c b/dlls/msvcrt/mbcs.c
index e78a8fe..a08181d 100644
--- a/dlls/msvcrt/mbcs.c
+++ b/dlls/msvcrt/mbcs.c
@@ -4023,3 +4023,210 @@ int CDECL _mbsncat_s(unsigned char *dst, size_t size, const unsigned char *src,
 }
 #endif
 
+
+#if _MSVCR_VER>=140
+/* The char16_t and char32_t conversions always use UTF-8. The state keeps
+ * a partial character (value, bytes left, length), a low surrogate still to
+ * be returned by mbrtoc16, or a high surrogate seen by c16rtomb. */
+#define U8_VALUE_MASK   0x1fffff
+#define U8_LEFT_SHIFT   24
+#define U8_LEN_SHIFT    26
+#define U16_LOW_PENDING 0x80000000
+#define U16_HIGH_SEEN   0x40000000
+
+static size_t utf8_decode(unsigned int *ret, const char *str, size_t n, unsigned int *state)
+{
+    unsigned int value, left, len;
+    size_t i = 0;
+
+    if (!n) return -2;
+    if (!*state)
+    {
+        unsigned char c = str[0];
+
+        if (c < 0x80)
+        {
+            *ret = c;
+            return c ? 1 : 0;
+        }
+        if (c >= 0xc2 && c <= 0xdf) { len = 2; value = c & 0x1f; }
+        else if (c >= 0xe0 && c <= 0xef) { len = 3; value = c & 0x0f; }
+        else if (c >= 0xf0 && c <= 0xf4) { len = 4; value = c & 0x07; }
+        else goto ilseq;
+        left = len - 1;
+        i = 1;
+    }
+    else
+    {
+        value = *state & U8_VALUE_MASK;
+        left = (*state >> U8_LEFT_SHIFT) & 3;
+        len = (*state >> U8_LEN_SHIFT) & 7;
+    }
+
+    for (; left && i < n; i++, left--)
+    {
+        unsigned char c = str[i];
+
+        if ((c & 0xc0) != 0x80) goto ilseq;
+        value = (value << 6) | (c & 0x3f);
+    }
+    if (left)
+    {
+        *state = value | (left << U8_LEFT_SHIFT) | (len << U8_LEN_SHIFT);
+        return -2;
+    }
+    if ((len == 3 && value < 0x800) || (len == 4 && (value < 0x10000 || value > 0x10ffff)) ||
+            (value >= 0xd800 && value <= 0xdfff))
+        goto ilseq;
+    *state = 0;
+    *ret = value;
+    return i;
+
+ilseq:
+    *state = 0;
+    *_errno() = EILSEQ;
+    return -1;
+}
+
+static size_t utf8_encode(char *dst, unsigned int c)
+{
+    if (c < 0x80)
+    {
+        dst[0] = c;
+        return 1;
+    }
+    if (c < 0x800)
+    {
+        dst[0] = 0xc0 | (c >> 6);
+        dst[1] = 0x80 | (c & 0x3f);
+        return 2;
+    }
+    if (c < 0x10000)
+    {
+        if (c >= 0xd800 && c <= 0xdfff) goto ilseq;
+        dst[0] = 0xe0 | (c >> 12);
+        dst[1] = 0x80 | ((c >> 6) & 0x3f);
+        dst[2] = 0x80 | (c & 0x3f);
+        return 3;
+    }
+    if (c > 0x10ffff) goto ilseq;
+    dst[0] = 0xf0 | (c >> 18);
+    dst[1] = 0x80 | ((c >> 12) & 0x3f);
+    dst[2] = 0x80 | ((c >> 6) & 0x3f);
+    dst[3] = 0x80 | (c & 0x3f);
+    return 4;
+
+ilseq:
+    *_errno() = EILSEQ;
+    return -1;
+}
+
+/*********************************************************************
+ *              mbrtoc32 (UCRTBASE.@)
+ */
+size_t CDECL mbrtoc32(unsigned int *dst, const char *str, size_t n, mbstate_t *state)
+{
+    static mbstate_t internal;
+    unsigned int *st = (unsigned int *)(state ? state : &internal), c;
+    size_t ret;
+
+    TRACE("(%p %p %Iu %p)\n", dst, str, n, state);
+
+    if (!str)
+    {
+        str = "";
+        n = 1;
+        dst = NULL;
+    }
+    ret = utf8_decode(&c, str, n, st);
+    if (ret < (size_t)-2 && dst) *dst = c;
+    return ret;
+}
+
+/*********************************************************************
+ *              mbrtoc16 (UCRTBASE.@)
+ */
+size_t CDECL mbrtoc16(unsigned short *dst, const char *str, size_t n, mbstate_t *state)
+{
+    static mbstate_t internal;
+    unsigned int *st = (unsigned int *)(state ? state : &internal), c;
+    size_t ret;
+
+    TRACE("(%p %p %Iu %p)\n", dst, str, n, state);
+
+    if (!str)
+    {
+        str = "";
+        n = 1;
+        dst = NULL;
+    }
+    if (*st & U16_LOW_PENDING)
+    {
+        if (dst) *dst = *st & 0xffff;
+        *st = 0;
+        return -3;
+    }
+    ret = utf8_decode(&c, str, n, st);
+    if (ret >= (size_t)-2) return ret;
+#ifndef SG_MUTANT_MBRTOC16_NO_SURROGATES
+    if (c >= 0x10000)
+    {
+        c -= 0x10000;
+        *st = U16_LOW_PENDING | 0xdc00 | (c & 0x3ff);
+        c = 0xd800 | (c >> 10);
+    }
+#endif
+    if (dst) *dst = c;
+    return ret;
+}
+
+/*********************************************************************
+ *              c32rtomb (UCRTBASE.@)
+ */
+size_t CDECL c32rtomb(char *dst, unsigned int c, mbstate_t *state)
+{
+    static mbstate_t internal;
+    unsigned int *st = (unsigned int *)(state ? state : &internal);
+
+    TRACE("(%p %#x %p)\n", dst, c, state);
+
+    *st = 0;
+    if (!dst) return 1;
+    return utf8_encode(dst, c);
+}
+
+/*********************************************************************
+ *              c16rtomb (UCRTBASE.@)
+ */
+size_t CDECL c16rtomb(char *dst, unsigned short c, mbstate_t *state)
+{
+    static mbstate_t internal;
+    unsigned int *st = (unsigned int *)(state ? state : &internal);
+
+    TRACE("(%p %#x %p)\n", dst, c, state);
+
+    if (!dst)
+    {
+        *st = 0;
+        return 1;
+    }
+    if (*st & U16_HIGH_SEEN)
+    {
+        unsigned int high = *st & 0x3ff;
+
+        *st = 0;
+        if (c < 0xdc00 || c > 0xdfff)
+        {
+            *_errno() = EILSEQ;
+            return -1;
+        }
+        return utf8_encode(dst, 0x10000 + (high << 10) + (c - 0xdc00));
+    }
+    if (c >= 0xd800 && c <= 0xdbff)
+    {
+        *st = U16_HIGH_SEEN | (c & 0x3ff);
+        return 0;
+    }
+    return utf8_encode(dst, c);
+}
+#endif
diff --git a/dlls/ucrtbase/ucrtbase.spec b/dlls/ucrtbase/ucrtbase.spec
index 6233c38..7c0d02e 100644
--- a/dlls/ucrtbase/ucrtbase.spec
+++ b/dlls/ucrtbase/ucrtbase.spec
@@ -1712,8 +1712,8 @@
 @ cdecl _o_malloc(long) malloc
 @ cdecl _o_mblen(ptr long) mblen
 @ cdecl _o_mbrlen(ptr long ptr) mbrlen
-@ stub _o_mbrtoc16
-@ stub _o_mbrtoc32
+@ cdecl _o_mbrtoc16(ptr ptr long ptr) mbrtoc16
+@ cdecl _o_mbrtoc32(ptr ptr long ptr) mbrtoc32
 @ cdecl _o_mbrtowc(ptr str long ptr) mbrtowc
 @ cdecl _o_mbsrtowcs(ptr ptr long ptr) mbsrtowcs
 @ cdecl _o_mbsrtowcs_s(ptr ptr long ptr long ptr) mbsrtowcs_s
@@ -2180,8 +2180,8 @@
 @ cdecl bsearch(ptr ptr long long ptr)
 @ cdecl bsearch_s(ptr ptr long long ptr ptr)
 @ cdecl btowc(long)
-@ stub c16rtomb
-@ stub c32rtomb
+@ cdecl c16rtomb(ptr long ptr)
+@ cdecl c32rtomb(ptr long ptr)
 @ cdecl cabs(int128) MSVCR120_cabs
 @ cdecl cabsf(int64) MSVCR120_cabsf
 @ cdecl cabsl(int128) MSVCR120_cabs
@@ -2415,8 +2415,8 @@
 @ cdecl malloc(long)
 @ cdecl mblen(ptr long)
 @ cdecl mbrlen(ptr long ptr)
-@ stub mbrtoc16
-@ stub mbrtoc32
+@ cdecl mbrtoc16(ptr ptr long ptr)
+@ cdecl mbrtoc32(ptr ptr long ptr)
 @ cdecl mbrtowc(ptr str long ptr)
 @ cdecl mbsrtowcs(ptr ptr long ptr)
 @ cdecl mbsrtowcs_s(ptr ptr long ptr long ptr)
