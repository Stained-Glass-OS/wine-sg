 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3dx9_line *line = impl_from_ID3DXLine(iface);
 
-    return 1.0f;
+    TRACE("iface %p.\n", iface);
+
+    return line->pattern_scale;
 }
 
