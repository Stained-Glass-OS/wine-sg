From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: ID3DXLine draws lines

ID3DXLine::Draw and DrawTransform returned E_NOTIMPL, so the lines games draw for
their HUDs, boxes and graphs with D3DXCreateLine never appeared.

 - Draw takes screen coordinates, DrawTransform vertices that go through a matrix into
   the viewport. A line is a rectangle as wide as SetWidth says for every segment (with the
   projection Begin sets up, one unit is a pixel); the pattern (SetPattern, 32 bits, a bit
   as long as SetPatternScale along the line) leaves gaps. Called outside Begin and End the
   line is drawn with its own state, which the device gets back.
 - Begin also sets what lines are drawn with: no culling or depth test, no shaders or
   textures, the vertex colour.
 - The pattern, its scale (positive), the antialias and GL line flags are kept and
   returned; OnLostDevice and OnResetDevice succeed.
Antialiasing and GL line mode are only remembered. The length of a pattern bit is not
documented and is a guess.
---
--- a/dlls/d3dx9_36/line.c
+++ b/dlls/d3dx9_36/line.c
@@ -30,6 +30,15 @@ struct d3dx9_line
     IDirect3DDevice9 *device;
     IDirect3DStateBlock9 *state;
     float width;
+    DWORD pattern;
+    float pattern_scale;
+    BOOL antialias, gl_lines;
+};
+
+struct line_vertex
+{
+    float x, y, z;
+    DWORD color;
 };
 
 static inline struct d3dx9_line *impl_from_ID3DXLine(ID3DXLine *iface)
@@ -136,6 +145,28 @@ static HRESULT WINAPI d3dx9_line_Begin(ID3DXLine *iface)
     if (FAILED(IDirect3DDevice9_SetRenderState(line->device, D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA)))
         goto failed;
 
+    /* what the lines are drawn with: the colour of their vertices, nothing else */
+    if (FAILED(IDirect3DDevice9_SetRenderState(line->device, D3DRS_CULLMODE, D3DCULL_NONE)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetRenderState(line->device, D3DRS_ZENABLE, D3DZB_FALSE)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetVertexShader(line->device, NULL)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetPixelShader(line->device, NULL)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetTexture(line->device, 0, NULL)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetTextureStageState(line->device, 0, D3DTSS_COLOROP, D3DTOP_SELECTARG1)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetTextureStageState(line->device, 0, D3DTSS_COLORARG1, D3DTA_DIFFUSE)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetTextureStageState(line->device, 0, D3DTSS_ALPHAOP, D3DTOP_SELECTARG1)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetTextureStageState(line->device, 0, D3DTSS_ALPHAARG1, D3DTA_DIFFUSE)))
+        goto failed;
+    if (FAILED(IDirect3DDevice9_SetTextureStageState(line->device, 1, D3DTSS_COLOROP, D3DTOP_DISABLE)))
+        goto failed;
+
     return D3D_OK;
 
 failed:
@@ -145,50 +176,203 @@ failed:
     return D3DXERR_INVALIDDATA;
 }
 
+/* The quads of a polyline in screen coordinates: a rectangle as wide as the line for every
+ * stretch of a segment the pattern lets through. */
+static HRESULT WINAPI d3dx9_line_Begin(ID3DXLine *iface);
+static HRESULT WINAPI d3dx9_line_End(ID3DXLine *iface);
+
+static HRESULT d3dx9_line_draw_screen(struct d3dx9_line *line, const D3DXVECTOR2 *points, DWORD count, D3DCOLOR color)
+{
+#ifdef SG_MUTANT_D3DXLINE_NARROW
+    const float half = line->width / 4.0f;
+#else
+    const float half = line->width / 2.0f;
+#endif
+    const float unit = line->pattern_scale;
+    struct line_vertex *vertices;
+    DWORD i, max_vertices, n = 0;
+    float distance = 0.0f;
+    HRESULT hr;
+
+    if (count < 2)
+        return D3D_OK;
+
+    /* every stretch is a quad of six vertices; a pattern cuts segments into at most 32 per unit run */
+    max_vertices = 0;
+    for (i = 0; i + 1 < count; ++i)
+    {
+        float dx = points[i + 1].x - points[i].x, dy = points[i + 1].y - points[i].y;
+        float length = sqrtf(dx * dx + dy * dy);
+
+        max_vertices += 6 * (line->pattern == 0xffffffff ? 1 : (DWORD)(length / unit) + 2);
+    }
+    if (!(vertices = malloc(max_vertices * sizeof(*vertices))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i + 1 < count; ++i)
+    {
+        float dx = points[i + 1].x - points[i].x, dy = points[i + 1].y - points[i].y;
+        float length = sqrtf(dx * dx + dy * dy), start, end;
+
+        if (length == 0.0f)
+            continue;
+        dx /= length; dy /= length;
+
+        for (start = 0.0f; start < length; start = end)
+        {
+            BOOL solid = TRUE;
+            float nx = -dy * half, ny = dx * half, x0, y0, x1, y1;
+
+            end = length;
+#ifdef SG_MUTANT_D3DXLINE_NO_PATTERN
+            if (0)
+#else
+            if (line->pattern != 0xffffffff)
+#endif
+            {
+                /* the unit the pattern bit covers along the whole polyline */
+                float position = distance + start;
+                DWORD bit = (DWORD)(position / unit) & 31;
+                float stop = (floor(position / unit) + 1.0f) * unit - distance;
+
+                solid = (line->pattern >> bit) & 1;
+                end = min(length, stop);
+                if (end <= start)
+                    end = length;
+            }
+            if (!solid)
+                continue;
+
+            x0 = points[i].x + dx * start; y0 = points[i].y + dy * start;
+            x1 = points[i].x + dx * end; y1 = points[i].y + dy * end;
+            vertices[n++] = (struct line_vertex){x0 + nx, y0 + ny, 0.0f, color};
+            vertices[n++] = (struct line_vertex){x0 - nx, y0 - ny, 0.0f, color};
+            vertices[n++] = (struct line_vertex){x1 + nx, y1 + ny, 0.0f, color};
+            vertices[n++] = (struct line_vertex){x1 + nx, y1 + ny, 0.0f, color};
+            vertices[n++] = (struct line_vertex){x0 - nx, y0 - ny, 0.0f, color};
+            vertices[n++] = (struct line_vertex){x1 - nx, y1 - ny, 0.0f, color};
+        }
+        distance += length;
+    }
+
+    hr = D3D_OK;
+    if (n)
+    {
+        if (SUCCEEDED(hr = IDirect3DDevice9_SetFVF(line->device, D3DFVF_XYZ | D3DFVF_DIFFUSE)))
+            hr = IDirect3DDevice9_DrawPrimitiveUP(line->device, D3DPT_TRIANGLELIST, n / 3, vertices,
+                    sizeof(*vertices));
+    }
+    free(vertices);
+    return FAILED(hr) ? D3DXERR_INVALIDDATA : D3D_OK;
+}
+
+static HRESULT d3dx9_line_draw(struct d3dx9_line *line, const D3DXVECTOR2 *points, DWORD count, D3DCOLOR color)
+{
+    BOOL implicit = !line->state;
+    HRESULT hr;
+
+    /* outside Begin and End the lines are drawn with their own state */
+    if (implicit && FAILED(hr = d3dx9_line_Begin(&line->ID3DXLine_iface)))
+        return hr;
+    hr = d3dx9_line_draw_screen(line, points, count, color);
+#ifndef SG_MUTANT_D3DXLINE_KEEPS_STATE
+    if (implicit)
+        d3dx9_line_End(&line->ID3DXLine_iface);
+#endif
+    return hr;
+}
+
 static HRESULT WINAPI d3dx9_line_Draw(ID3DXLine *iface, const D3DXVECTOR2 *vertex_list,
         DWORD vertex_list_count, D3DCOLOR color)
 {
-    FIXME("iface %p, vertex_list %p, vertex_list_count %lu, color 0x%08lx stub!\n",
+    struct d3dx9_line *line = impl_from_ID3DXLine(iface);
+
+    TRACE("iface %p, vertex_list %p, vertex_list_count %lu, color 0x%08lx.\n",
             iface, vertex_list, vertex_list_count, color);
 
+    if (!vertex_list || vertex_list_count < 2)
+        return D3DERR_INVALIDCALL;
+
+#ifdef SG_MUTANT_D3DXLINE_NO_DRAW
     return E_NOTIMPL;
+#endif
+    return d3dx9_line_draw(line, vertex_list, vertex_list_count, color);
 }
 
 static HRESULT WINAPI d3dx9_line_DrawTransform(ID3DXLine *iface, const D3DXVECTOR3 *vertex_list,
         DWORD vertex_list_count, const D3DXMATRIX *transform, D3DCOLOR color)
 {
-    FIXME("iface %p, vertex_list %p, vertex_list_count %lu, transform %p, color 0x%08lx stub!\n",
+    struct d3dx9_line *line = impl_from_ID3DXLine(iface);
+    D3DXVECTOR2 *points;
+    D3DVIEWPORT9 vp;
+    HRESULT hr;
+    DWORD i;
+
+    TRACE("iface %p, vertex_list %p, vertex_list_count %lu, transform %p, color 0x%08lx.\n",
             iface, vertex_list, vertex_list_count, transform, color);
 
-    return E_NOTIMPL;
+    if (!vertex_list || vertex_list_count < 2 || !transform)
+        return D3DERR_INVALIDCALL;
+
+    if (FAILED(IDirect3DDevice9_GetViewport(line->device, &vp)))
+        return D3DXERR_INVALIDDATA;
+    if (!(points = malloc(vertex_list_count * sizeof(*points))))
+        return E_OUTOFMEMORY;
+
+    /* through the matrix to the clip space, from there to the pixels of the viewport */
+    for (i = 0; i < vertex_list_count; ++i)
+    {
+        D3DXVECTOR3 v;
+
+        D3DXVec3TransformCoord(&v, &vertex_list[i], transform);
+        points[i].x = vp.X + (v.x + 1.0f) * vp.Width / 2.0f;
+        points[i].y = vp.Y + (1.0f - v.y) * vp.Height / 2.0f;
+    }
+
+    hr = d3dx9_line_draw(line, points, vertex_list_count, color);
+    free(points);
+    return hr;
 }
 
