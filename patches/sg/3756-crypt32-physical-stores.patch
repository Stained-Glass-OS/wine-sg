From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CertRegisterPhysicalStore, CertUnregisterPhysicalStore and registered physical stores (3756)

CertRegisterPhysicalStore returned FALSE and CertUnregisterPhysicalStore
returned TRUE without doing anything. Physical stores are now registered under
the system store's PhysicalStores key, listed by CertEnumPhysicalStore, opened
into the system store's collection (with their priority, add and disable
flags), and unregistered (with CERT_STORE_DELETE_FLAG the store behind them is
deleted). A physical store named .Default replaces the implicit one. The
machine's locations need an administrator. CORE review: security
(patches/notes/3756.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---
diff --git a/dlls/crypt32/store.c b/dlls/crypt32/store.c
index de5eb6b..f2648f4 100644
--- a/dlls/crypt32/store.c
+++ b/dlls/crypt32/store.c
@@ -672,6 +672,217 @@ static void sg_add_policy_stores(HCERTSTORE collection, DWORD flags, const WCHAR
     }
 }
 
+/* Stained Glass OS 3756: physical stores registered with CertRegisterPhysicalStore.
+ * A system store's key holds them under "PhysicalStores\<name>": the values
+ * OpenStoreProvider (REG_SZ, or a REG_DWORD provider number), OpenEncodingType, OpenFlags, Flags,
+ * Priority (REG_DWORD) and OpenParameters (REG_BINARY), the members of CERT_PHYSICAL_STORE_INFO.
+ * Opening the system store opens each of them (unless CERT_PHYSICAL_STORE_OPEN_DISABLE_FLAG)
+ * into its collection; a physical store named ".Default" replaces the implicit one. */
+struct sg_regphys
+{
+    WCHAR name[MAX_PATH];
+    CERT_PHYSICAL_STORE_INFO info;
+    char provider_str[64];
+    BYTE *params;
+};
+
+static LONG sg_phys_depth;   /* registered stores opening the system store they belong to */
+
+static BOOL sg_physical_stores_path(DWORD flags, const WCHAR *name, HKEY *root, WCHAR *path, DWORD len)
+{
+    WCHAR base[512], who[256];
+    const WCHAR *slash = NULL;
+
+    switch (flags & CERT_SYSTEM_STORE_LOCATION_MASK)
+    {
+    case CERT_SYSTEM_STORE_LOCAL_MACHINE:
+        *root = HKEY_LOCAL_MACHINE;
+        lstrcpynW(base, CERT_LOCAL_MACHINE_SYSTEM_STORE_REGPATH, ARRAY_SIZE(base));
+        break;
+    case CERT_SYSTEM_STORE_CURRENT_USER:
+        *root = HKEY_CURRENT_USER;
+        lstrcpynW(base, CERT_LOCAL_MACHINE_SYSTEM_STORE_REGPATH, ARRAY_SIZE(base));
+        break;
+    case CERT_SYSTEM_STORE_CURRENT_SERVICE:
+    case CERT_SYSTEM_STORE_SERVICES:
+    case CERT_SYSTEM_STORE_USERS:
+        if ((flags & CERT_SYSTEM_STORE_LOCATION_MASK) != CERT_SYSTEM_STORE_CURRENT_SERVICE)
+        {
+            if (!(slash = wcschr(name, '\\')) || slash - name >= ARRAY_SIZE(who)) return FALSE;
+            lstrcpynW(who, name, slash - name + 1);
+            name = slash + 1;
+        }
+        if (!system_store_base(flags & CERT_SYSTEM_STORE_LOCATION_MASK, slash ? who : NULL, root, base,
+                               ARRAY_SIZE(base)))
+            return FALSE;
+        break;
+    case CERT_SYSTEM_STORE_CURRENT_USER_GROUP_POLICY:
+        *root = HKEY_CURRENT_USER;
+        lstrcpynW(base, CERT_GROUP_POLICY_SYSTEM_STORE_REGPATH, ARRAY_SIZE(base));
+        break;
+    case CERT_SYSTEM_STORE_LOCAL_MACHINE_GROUP_POLICY:
+        *root = HKEY_LOCAL_MACHINE;
+        lstrcpynW(base, CERT_GROUP_POLICY_SYSTEM_STORE_REGPATH, ARRAY_SIZE(base));
+        break;
+    case CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE:
+        if (!system_store_base(CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE, NULL, root, base, ARRAY_SIZE(base)))
+            return FALSE;
+        break;
+    default:
+        return FALSE;
+    }
+    if (!*name || wcschr(name, '\\')) return FALSE;
+    if (lstrlenW(base) + lstrlenW(name) + lstrlenW(L"\\PhysicalStores") + 2 > len) return FALSE;
+    swprintf(path, len, L"%s\\%s\\PhysicalStores", base, name);
+    return TRUE;
+}
+
+/* the machine's stores are the administrators' (a token that has the group only to deny does not count) */
+static BOOL sg_is_admin(void)
+{
+    BYTE sid[SECURITY_MAX_SID_SIZE];
+    DWORD size = sizeof(sid);
+    BOOL member;
+
+#ifdef SG_MUTANT_PHYSICAL_ANY_USER
+    return TRUE;
+#endif
+    if (!CreateWellKnownSid(WinBuiltinAdministratorsSid, NULL, sid, &size)) return FALSE;
+    return CheckTokenMembership(NULL, sid, &member) && member;
+}
+
+static void sg_free_regphys(struct sg_regphys *phys)
+{
+    free(phys->params);
+    phys->params = NULL;
+}
+
+/* the physical store "name" under the open PhysicalStores key */
+static BOOL sg_read_regphys(HKEY parent, const WCHAR *name, struct sg_regphys *phys)
+{
+    HKEY key;
+    DWORD type, size, value;
+    WCHAR provider[64];
+
+    memset(phys, 0, sizeof(*phys));
+    if (RegOpenKeyExW(parent, name, 0, KEY_READ, &key)) return FALSE;
+    lstrcpynW(phys->name, name, ARRAY_SIZE(phys->name));
+    phys->info.cbSize = sizeof(phys->info);
+    size = sizeof(provider) - sizeof(WCHAR);
+    memset(provider, 0, sizeof(provider));
+    if (!RegQueryValueExW(key, L"OpenStoreProvider", NULL, &type, (BYTE *)provider, &size))
+    {
+        if (type == REG_SZ)
+        {
+            WideCharToMultiByte(CP_ACP, 0, provider, -1, phys->provider_str, sizeof(phys->provider_str), NULL, NULL);
+            phys->info.pszOpenStoreProvider = phys->provider_str;
+        }
+        else if (type == REG_DWORD && size == sizeof(DWORD))
+            phys->info.pszOpenStoreProvider = (LPSTR)(ULONG_PTR)LOWORD(*(DWORD *)provider);
+    }
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"OpenEncodingType", NULL, &type, (BYTE *)&value, &size) && type == REG_DWORD)
+        phys->info.dwOpenEncodingType = value;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"OpenFlags", NULL, &type, (BYTE *)&value, &size) && type == REG_DWORD)
+        phys->info.dwOpenFlags = value;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"Flags", NULL, &type, (BYTE *)&value, &size) && type == REG_DWORD)
+        phys->info.dwFlags = value;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"Priority", NULL, &type, (BYTE *)&value, &size) && type == REG_DWORD)
+        phys->info.dwPriority = value;
+    size = 0;
+    if (!RegQueryValueExW(key, L"OpenParameters", NULL, &type, NULL, &size) && type == REG_BINARY && size)
+    {
+        /* two bytes more: a string parameter is terminated whatever was stored */
+        if ((phys->params = calloc(1, size + sizeof(WCHAR))))
+        {
+            if (!RegQueryValueExW(key, L"OpenParameters", NULL, &type, phys->params, &size))
+            {
+                phys->info.OpenParameters.cbData = size;
+                phys->info.OpenParameters.pbData = phys->params;
+            }
+            else sg_free_regphys(phys);
+        }
+    }
+    RegCloseKey(key);
+    return phys->info.pszOpenStoreProvider != NULL;
+}
+
+static HKEY sg_open_physical_key(DWORD flags, const void *system_store, REGSAM sam)
+{
+    WCHAR path[1024];
+    HKEY root, key;
+
+    if (!sg_physical_stores_path(flags, system_store, &root, path, ARRAY_SIZE(path))) return NULL;
+    if (RegOpenKeyExW(root, path, 0, sam, &key)) return NULL;
+    return key;
+}
+
+/* is a physical store registered under the name? (".Default": the implicit registry store is replaced) */
+static BOOL sg_has_registered_physical(DWORD flags, const void *system_store, const WCHAR *name)
+{
+    HKEY parent, key;
+    BOOL ret = FALSE;
+
+    if (!(parent = sg_open_physical_key(flags, system_store, KEY_READ))) return FALSE;
+    if (!RegOpenKeyExW(parent, name, 0, KEY_READ, &key))
+    {
+        RegCloseKey(key);
+        ret = TRUE;
+    }
+    RegCloseKey(parent);
+    return ret;
+}
+
+static void sg_add_registered_physical(HCERTSTORE collection, DWORD flags, const void *system_store)
+{
+    HKEY parent;
+    DWORD i;
+
+#ifdef SG_MUTANT_NO_REGISTERED_PHYSICAL
+    return;
+#endif
+    if (!(parent = sg_open_physical_key(flags, system_store, KEY_READ))) return;
+    if (InterlockedIncrement(&sg_phys_depth) <= 4)
+    {
+        for (i = 0;; i++)
+        {
+            WCHAR name[MAX_PATH];
+            DWORD size = ARRAY_SIZE(name);
+            struct sg_regphys phys;
+            HCERTSTORE store;
+            DWORD open_flags;
+
+            if (RegEnumKeyExW(parent, i, name, &size, NULL, NULL, NULL, NULL)) break;
+            if (!sg_read_regphys(parent, name, &phys)) { sg_free_regphys(&phys); continue; }
+#ifndef SG_MUTANT_PHYSICAL_DISABLE_IGNORED
+            if (phys.info.dwFlags & CERT_PHYSICAL_STORE_OPEN_DISABLE_FLAG) { sg_free_regphys(&phys); continue; }
+#endif
+            open_flags = phys.info.dwOpenFlags;
+            if (flags & CERT_STORE_READONLY_FLAG) open_flags |= CERT_STORE_READONLY_FLAG;
+            store = CertOpenStore(phys.info.pszOpenStoreProvider, phys.info.dwOpenEncodingType, 0, open_flags,
+                                  phys.info.OpenParameters.pbData);
+            if (store)
+            {
+                CertAddStoreToCollection(collection, store,
+#ifndef SG_MUTANT_PHYSICAL_ADD_ALWAYS
+                                         (phys.info.dwFlags & CERT_PHYSICAL_STORE_ADD_ENABLE_FLAG) && !(flags & CERT_STORE_READONLY_FLAG) ?
+                                         CERT_PHYSICAL_STORE_ADD_ENABLE_FLAG : 0,
+#else
+                                         CERT_PHYSICAL_STORE_ADD_ENABLE_FLAG,
+#endif
+                                         phys.info.dwPriority);
+                CertCloseStore(store, 0);
+            }
+            sg_free_regphys(&phys);
+        }
+    }
+    InterlockedDecrement(&sg_phys_depth);
+    RegCloseKey(parent);
+}
+
 static WINECRYPT_CERTSTORE *CRYPT_SysOpenStoreW(HCRYPTPROV hCryptProv,
  DWORD dwFlags, const void *pvPara)
 {
@@ -714,10 +925,13 @@ static WINECRYPT_CERTSTORE *CRYPT_SysOpenStoreW(HCRYPTPROV hCryptProv,
         {
             store = CertOpenStore(CERT_STORE_PROV_COLLECTION, 0, 0,
              CERT_STORE_CREATE_NEW_FLAG, NULL);
-            CertAddStoreToCollection(store, regStore,
-             dwFlags & CERT_STORE_READONLY_FLAG ? 0 :
-             CERT_PHYSICAL_STORE_ADD_ENABLE_FLAG, 0);
+            /* a physical store registered as ".Default" takes the implicit one's place */
+            if (!sg_has_registered_physical(dwFlags, pvPara, L".Default"))
+                CertAddStoreToCollection(store, regStore,
+                 dwFlags & CERT_STORE_READONLY_FLAG ? 0 :
+                 CERT_PHYSICAL_STORE_ADD_ENABLE_FLAG, 0);
             CertCloseStore(regStore, 0);
+            sg_add_registered_physical(store, dwFlags, pvPara);
             /* CERT_SYSTEM_STORE_CURRENT_USER returns both the HKCU and HKLM
              * stores.
              */
@@ -1626,6 +1840,7 @@ BOOL WINAPI CertEnumPhysicalStore(const void *pvSystemStore, DWORD dwFlags,
     CERT_PHYSICAL_STORE_INFO info = { sizeof(info) };
     DWORD location = dwFlags & CERT_SYSTEM_STORE_LOCATION_MASK, i;
     HCERTSTORE store;
+    HKEY registered;
     BOOL ret;
 
     TRACE("(%p, %08lx, %p, %p)\n", pvSystemStore, dwFlags, pvArg, pfnEnum);
@@ -1654,7 +1869,20 @@ BOOL WINAPI CertEnumPhysicalStore(const void *pvSystemStore, DWORD dwFlags,
     info.dwOpenEncodingType = X509_ASN_ENCODING | PKCS_7_ASN_ENCODING;
     info.dwOpenFlags = 0;
     info.dwPriority = 1;
-    ret = pfnEnum(pvSystemStore, dwFlags, L".Default", &info, NULL, pvArg);
+    registered = sg_open_physical_key(dwFlags, pvSystemStore, KEY_READ);
+    if (registered && sg_has_registered_physical(dwFlags, pvSystemStore, L".Default"))
+    {
+        struct sg_regphys def;
+
+        /* registered as ".Default": that one is the system store's own */
+        if (sg_read_regphys(registered, L".Default", &def))
+            ret = pfnEnum(pvSystemStore, dwFlags, L".Default", &def.info, NULL, pvArg);
+        else
+            ret = TRUE;
+        sg_free_regphys(&def);
+    }
+    else
+        ret = pfnEnum(pvSystemStore, dwFlags, L".Default", &info, NULL, pvArg);
     for (i = 0; ret && i < ARRAY_SIZE(sg_physical_stores); i++)
     {
         if (sg_physical_stores[i].system_location != location) continue;
@@ -1665,25 +1893,166 @@ BOOL WINAPI CertEnumPhysicalStore(const void *pvSystemStore, DWORD dwFlags,
         info.dwPriority = 0;
         ret = pfnEnum(pvSystemStore, dwFlags, sg_physical_stores[i].name, &info, NULL, pvArg);
     }
+    /* the ones CertRegisterPhysicalStore added */
+    for (i = 0; registered && ret; i++)
+    {
+        WCHAR name[MAX_PATH];
+        DWORD size = ARRAY_SIZE(name), j;
+        struct sg_regphys phys;
+        BOOL builtin = FALSE;
+
+        if (RegEnumKeyExW(registered, i, name, &size, NULL, NULL, NULL, NULL)) break;
+        if (!wcsicmp(name, L".Default")) continue;
+        for (j = 0; j < ARRAY_SIZE(sg_physical_stores); j++)
+            if (sg_physical_stores[j].system_location == location && !wcsicmp(sg_physical_stores[j].name, name)) builtin = TRUE;
+        if (builtin) continue;
+        if (sg_read_regphys(registered, name, &phys))
+            ret = pfnEnum(pvSystemStore, dwFlags, phys.name, &phys.info, NULL, pvArg);
+        sg_free_regphys(&phys);
+    }
+    if (registered) RegCloseKey(registered);
     return ret;
 }
 
 BOOL WINAPI CertRegisterPhysicalStore(const void *pvSystemStore, DWORD dwFlags,
  LPCWSTR pwszStoreName, PCERT_PHYSICAL_STORE_INFO pStoreInfo, void *pvReserved)
 {
+    WCHAR path[1024], provider[64];
+    HKEY root, key, phys;
+    DWORD disp, value;
+    LONG rc;
+
+    TRACE("(%p, %08lx, %s, %p, %p)\n", pvSystemStore, dwFlags, debugstr_w(pwszStoreName), pStoreInfo, pvReserved);
+
     if (dwFlags & CERT_SYSTEM_STORE_RELOCATE_FLAG)
-        FIXME("(%p, %08lx, %s, %p, %p): stub\n", pvSystemStore, dwFlags,
-         debugstr_w(pwszStoreName), pStoreInfo, pvReserved);
+    {
+        FIXME("relocated system stores are not supported\n");
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!pvSystemStore || !pwszStoreName || !*pwszStoreName || wcschr(pwszStoreName, '\\') || !pStoreInfo ||
+        pStoreInfo->cbSize < sizeof(*pStoreInfo) || !pStoreInfo->pszOpenStoreProvider || pvReserved ||
+        (!IS_INTOID(pStoreInfo->pszOpenStoreProvider) && strlen(pStoreInfo->pszOpenStoreProvider) >= ARRAY_SIZE(provider)) ||
+        (pStoreInfo->OpenParameters.cbData && !pStoreInfo->OpenParameters.pbData) ||
+        !sg_physical_stores_path(dwFlags, pvSystemStore, &root, path, ARRAY_SIZE(path)))
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+
+    if (root == HKEY_LOCAL_MACHINE && !sg_is_admin())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    if ((rc = RegCreateKeyExW(root, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+    {
+        SetLastError(rc);
+        return FALSE;
+    }
+    rc = RegCreateKeyExW(key, pwszStoreName, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &phys, &disp);
+    RegCloseKey(key);
+    if (rc)
+    {
+        SetLastError(rc);
+        return FALSE;
+    }
+    if ((dwFlags & CERT_STORE_CREATE_NEW_FLAG) && disp == REG_OPENED_EXISTING_KEY)
+    {
+        RegCloseKey(phys);
+        SetLastError(ERROR_FILE_EXISTS);
+        return FALSE;
+    }
+
+    if (IS_INTOID(pStoreInfo->pszOpenStoreProvider))
+    {
+        value = LOWORD(pStoreInfo->pszOpenStoreProvider);
+        rc = RegSetValueExW(phys, L"OpenStoreProvider", 0, REG_DWORD, (const BYTE *)&value, sizeof(value));
+    }
     else
-        FIXME("(%s, %08lx, %s, %p, %p): stub\n", debugstr_w(pvSystemStore),
-         dwFlags, debugstr_w(pwszStoreName), pStoreInfo, pvReserved);
-    return FALSE;
+    {
+        MultiByteToWideChar(CP_ACP, 0, pStoreInfo->pszOpenStoreProvider, -1, provider, ARRAY_SIZE(provider));
+        rc = RegSetValueExW(phys, L"OpenStoreProvider", 0, REG_SZ, (const BYTE *)provider,
+                            (lstrlenW(provider) + 1) * sizeof(WCHAR));
+    }
+    if (!rc) rc = RegSetValueExW(phys, L"OpenEncodingType", 0, REG_DWORD, (const BYTE *)&pStoreInfo->dwOpenEncodingType, sizeof(DWORD));
+    if (!rc) rc = RegSetValueExW(phys, L"OpenFlags", 0, REG_DWORD, (const BYTE *)&pStoreInfo->dwOpenFlags, sizeof(DWORD));
+    if (!rc) rc = RegSetValueExW(phys, L"Flags", 0, REG_DWORD, (const BYTE *)&pStoreInfo->dwFlags, sizeof(DWORD));
+    if (!rc) rc = RegSetValueExW(phys, L"Priority", 0, REG_DWORD, (const BYTE *)&pStoreInfo->dwPriority, sizeof(DWORD));
+    if (!rc)
+    {
+        if (pStoreInfo->OpenParameters.cbData)
+            rc = RegSetValueExW(phys, L"OpenParameters", 0, REG_BINARY, pStoreInfo->OpenParameters.pbData,
+                                pStoreInfo->OpenParameters.cbData);
+        else
+            RegDeleteValueW(phys, L"OpenParameters");   /* re-registered without parameters */
+    }
+    RegCloseKey(phys);
+    if (rc)
+    {
+        SetLastError(rc);
+        return FALSE;
+    }
+    return TRUE;
 }
 
 BOOL WINAPI CertUnregisterPhysicalStore(const void *pvSystemStore, DWORD dwFlags,
  LPCWSTR pwszStoreName)
 {
-    FIXME("(%p, %08lx, %s): stub\n", pvSystemStore, dwFlags, debugstr_w(pwszStoreName));
+    struct sg_regphys phys;
+    HKEY parent;
+    LONG rc;
+
+    TRACE("(%p, %08lx, %s)\n", pvSystemStore, dwFlags, debugstr_w(pwszStoreName));
+
+    if (dwFlags & CERT_SYSTEM_STORE_RELOCATE_FLAG)
+    {
+        FIXME("relocated system stores are not supported\n");
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!pvSystemStore || !pwszStoreName || !*pwszStoreName || wcschr(pwszStoreName, '\\'))
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    {
+        WCHAR path[1024];
+        HKEY root;
+
+        if (!sg_physical_stores_path(dwFlags, pvSystemStore, &root, path, ARRAY_SIZE(path)))
+        {
+            SetLastError(E_INVALIDARG);
+            return FALSE;
+        }
+        if (root == HKEY_LOCAL_MACHINE && !sg_is_admin())
+        {
+            SetLastError(ERROR_ACCESS_DENIED);
+            return FALSE;
+        }
+        if ((rc = RegOpenKeyExW(root, path, 0, KEY_ALL_ACCESS, &parent)))
+        {
+            SetLastError(rc);
+            return FALSE;
+        }
+    }
+
+    /* CERT_STORE_DELETE_FLAG: the store behind it goes too (system stores only) */
+    if ((dwFlags & CERT_STORE_DELETE_FLAG) && sg_read_regphys(parent, pwszStoreName, &phys))
+    {
+        if (!IS_INTOID(phys.info.pszOpenStoreProvider) && phys.info.OpenParameters.pbData &&
+            (!stricmp(phys.info.pszOpenStoreProvider, sz_CERT_STORE_PROV_SYSTEM_REGISTRY) ||
+             !stricmp(phys.info.pszOpenStoreProvider, sz_CERT_STORE_PROV_SYSTEM)))
+            CertUnregisterSystemStore(phys.info.OpenParameters.pbData, phys.info.dwOpenFlags);
+        sg_free_regphys(&phys);
+    }
+    rc = RegDeleteKeyW(parent, pwszStoreName);
+    RegCloseKey(parent);
+    if (rc)
+    {
+        SetLastError(rc);
+        return FALSE;
+    }
     return TRUE;
 }
 
