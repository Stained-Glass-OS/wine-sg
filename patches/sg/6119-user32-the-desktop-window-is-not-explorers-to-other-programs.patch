From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: the desktop window is not explorer.exe's to other programs

On Windows GetWindowThreadProcessId of the desktop window gives the system's csrss.exe, a process programs cannot open; here it gave explorer.exe. NVDA caches the desktop object at startup and so loaded its explorer app module before its IAccessible support was imported (a circular import): no explorer support for the session. Other processes are now told process 4, never a Wine process id; the thread id stays the desktop's. wineboot and the OLE/X11 drop-target lookups (the desktop window is explorer's drop target) find the real process through the thread.
---
diff --git a/dlls/ole32/ole2.c b/dlls/ole32/ole2.c
index ba9b0ee..b5c214e 100644
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -298,7 +298,21 @@ static HANDLE get_droptarget_local_handle(HWND hwnd)
         DWORD pid;
         HANDLE process;
 
-        GetWindowThreadProcessId(hwnd, &pid);
+        DWORD tid = GetWindowThreadProcessId(hwnd, &pid);
+        HANDLE thread;
+
+        /* Stained Glass OS: the process of the window's thread -- the desktop
+         * window (explorer's drop target for the desktop) is not reported as
+         * explorer's to other processes, as on Windows (6119) */
+#ifndef SG_MUTANT_DROPTARGET_BY_WINDOW_PID
+        if ((thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid)))
+        {
+            pid = GetProcessIdOfThread(thread);
+            CloseHandle(thread);
+        }
+#else
+        (void)tid; (void)thread;
+#endif
         process = OpenProcess(PROCESS_DUP_HANDLE, FALSE, pid);
         if(process)
         {
diff --git a/dlls/user32/clipboard.c b/dlls/user32/clipboard.c
index 9aafa1e..10946f9 100644
--- a/dlls/user32/clipboard.c
+++ b/dlls/user32/clipboard.c
@@ -1066,7 +1066,9 @@ static HANDLE get_droptarget_local_handle(HWND hwnd)
         DWORD pid;
         HANDLE process;
 
-        GetWindowThreadProcessId(hwnd, &pid);
+        /* the window's real process: GetWindowThreadProcessId does not name
+         * explorer for the desktop window, a drop target (6119) */
+        NtUserGetWindowThread(hwnd, &pid);
         process = OpenProcess(PROCESS_DUP_HANDLE, FALSE, pid);
         if (process)
         {
diff --git a/dlls/user32/win.c b/dlls/user32/win.c
index 1d71a42..e0c1b81 100644
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -1353,7 +1353,21 @@ BOOL WINAPI IsWindow( HWND hwnd )
  */
 DWORD WINAPI GetWindowThreadProcessId( HWND hwnd, LPDWORD process )
 {
-    return NtUserGetWindowThread( hwnd, process );
+    DWORD pid = 0, tid = NtUserGetWindowThread( hwnd, &pid );
+
+    /* Stained Glass OS: on Windows the desktop window is the system's (csrss.exe,
+     * a process programs cannot open), not the shell's. Here explorer.exe owns
+     * it, and a program asking whose it is was told explorer: NVDA, starting,
+     * caches the desktop and so loaded its explorer app module before its
+     * IAccessible support was in place (a circular import), and had none for
+     * the shell all session. Other programs are told a system process (4,
+     * never a Wine process id); the thread id stays the desktop's. */
+#ifndef SG_MUTANT_DESKTOP_OWNER_EXPLORER
+    if (tid && LOWORD(hwnd) == LOWORD(GetDesktopWindow()) && pid != GetCurrentProcessId())
+        pid = 4;
+#endif
+    if (tid && process) *process = pid;
+    return tid;
 }
 
 
diff --git a/programs/wineboot/shutdown.c b/programs/wineboot/shutdown.c
index 335eaa8..4226edc 100644
--- a/programs/wineboot/shutdown.c
+++ b/programs/wineboot/shutdown.c
@@ -304,6 +304,21 @@ static DWORD_PTR send_end_session_messages( struct window_info *win, UINT count,
     return 1;
 }
 
+/* the desktop's process: explorer.exe, which GetWindowThreadProcessId does not
+ * name to other processes (on Windows the desktop window is the system's) */
+static DWORD get_desktop_pid(void)
+{
+    DWORD pid = 0, tid = GetWindowThreadProcessId( GetDesktopWindow(), &pid );
+    HANDLE thread;
+
+    if (tid && (thread = OpenThread( THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid )))
+    {
+        pid = GetProcessIdOfThread( thread );
+        CloseHandle( thread );
+    }
+    return pid;
+}
+
 /* close all top-level windows and terminate processes cleanly */
 BOOL shutdown_close_windows( BOOL force )
 {
@@ -313,7 +328,7 @@ BOOL shutdown_close_windows( BOOL force )
 
     if (!get_all_windows()) return FALSE;
 
-    GetWindowThreadProcessId( GetDesktopWindow(), &desktop_pid );
+    desktop_pid = get_desktop_pid();
 
     for (i = n = 0; result && i < win_count; i++, n++)
     {
@@ -378,7 +393,7 @@ void kill_processes( BOOL kill_desktop )
     HANDLE handle, snapshot;
     PROCESSENTRY32W process;
 
-    GetWindowThreadProcessId( GetDesktopWindow(), &desktop_pid );
+    desktop_pid = get_desktop_pid();
 
     do
     {
