+/* Stained Glass OS: what Windows shows under "Are you sure you want to move
+ * this file to the Recycle Bin?": the item's icon, its name, and for a file
+ * its type, size and date modified, for a folder its date created. */
+static void confirm_item_date(const FILETIME *ft, WCHAR *out, int len)
+{
+    SYSTEMTIME utc, local;
+    int n;
+
+    out[0] = 0;
+    if (!FileTimeToSystemTime(ft, &utc) || !SystemTimeToTzSpecificLocalTime(NULL, &utc, &local)) return;
+    n = GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &local, NULL, out, len);
+    if (n <= 0 || n >= len - 1) { out[0] = 0; return; }
+    out[n - 1] = ' ';
+    if (!GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &local, NULL, out + n, len - n)) out[n - 1] = 0;
+}
+
+static void confirm_item_details(struct confirm_msg_info *info, const WCHAR *path)
+{
+    WIN32_FILE_ATTRIBUTE_DATA attr;
+    SHFILEINFOW sfi;
+    WCHAR label[64], value[MAX_PATH];
+    ULARGE_INTEGER size;
+    IImageList *list;
+    BOOL folder;
+
+    info->item_count = 0;
+    info->item_icon = NULL;
+    if (!path || !path[0] || !GetFileAttributesExW(path, GetFileExInfoStandard, &attr)) return;
+    folder = !!(attr.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+
+    memset(&sfi, 0, sizeof(sfi));
+    if (!SHGetFileInfoW(path, 0, &sfi, sizeof(sfi), SHGFI_DISPLAYNAME | SHGFI_TYPENAME | SHGFI_SYSICONINDEX))
+        sfi.iIcon = -1;
+    lstrcpynW(info->item_lines[info->item_count++], sfi.szDisplayName[0] ? sfi.szDisplayName : PathFindFileNameW(path),
+              ARRAY_SIZE(info->item_lines[0]));
+    if (!folder)
+    {
+        if (sfi.szTypeName[0])
+        {
+            LoadStringW(shell32_hInstance, IDS_CONFIRM_ITEM_TYPE, label, ARRAY_SIZE(label));
+            swprintf(info->item_lines[info->item_count++], ARRAY_SIZE(info->item_lines[0]), L"%s %s", label, sfi.szTypeName);
+        }
+        size.LowPart = attr.nFileSizeLow;
+        size.HighPart = attr.nFileSizeHigh;
+        StrFormatByteSizeW(size.QuadPart, value, ARRAY_SIZE(value));
+        LoadStringW(shell32_hInstance, IDS_CONFIRM_ITEM_SIZE, label, ARRAY_SIZE(label));
+        swprintf(info->item_lines[info->item_count++], ARRAY_SIZE(info->item_lines[0]), L"%s %s", label, value);
+    }
+    confirm_item_date(folder ? &attr.ftCreationTime : &attr.ftLastWriteTime, value, ARRAY_SIZE(value));
+    if (value[0])
+    {
+        LoadStringW(shell32_hInstance, folder ? IDS_CONFIRM_ITEM_CREATED : IDS_CONFIRM_ITEM_MODIFIED,
+                    label, ARRAY_SIZE(label));
+        swprintf(info->item_lines[info->item_count++], ARRAY_SIZE(info->item_lines[0]), L"%s %s", label, value);
+    }
+
+    /* the item's own icon, at the size Windows shows it there (the extra large one) */
+    if (sfi.iIcon >= 0 && SUCCEEDED(SHGetImageList(SHIL_EXTRALARGE, &IID_IImageList, (void **)&list)))
+    {
+        int cx = 0, cy = 0;
+        IImageList_GetIcon(list, sfi.iIcon, ILD_TRANSPARENT, &info->item_icon);
+        IImageList_GetIconSize(list, &cx, &cy);
+        info->item_icon_size = cx;
+        IImageList_Release(list);
+    }
+    if (!info->item_icon)
+    {
+        memset(&sfi, 0, sizeof(sfi));
+        if (SHGetFileInfoW(path, 0, &sfi, sizeof(sfi), SHGFI_ICON | SHGFI_LARGEICON)) info->item_icon = sfi.hIcon;
+        info->item_icon_size = GetSystemMetrics(SM_CXICON);
+    }
+}
