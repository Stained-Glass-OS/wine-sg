+static unsigned int debug_client_target_count(struct debug_client *debug_client)
+{
+    unsigned int count = 0;
+    struct list *e;
+
+    LIST_FOR_EACH(e, &debug_client->targets)
+        ++count;
+    return count;
+}
+
+/* engine process ids are positions in the target list */
+static struct target_process *debug_client_get_target_by_id(struct debug_client *debug_client, ULONG id)
+{
+    struct target_process *target;
+
+    LIST_FOR_EACH_ENTRY(target, &debug_client->targets, struct target_process, entry)
+    {
+        if (!id--)
+            return target;
+    }
+    return NULL;
+}
+
+static struct target_process *debug_client_get_current_target(struct debug_client *debug_client)
+{
+    return debug_client_get_target_by_id(debug_client, debug_client->current_process);
+}
+
+/* the system ids of the threads of a target, in the order the engine numbers them */
+static HRESULT debug_target_get_threads(struct target_process *target, DWORD **ids, unsigned int *count)
+{
+    THREADENTRY32 entry = { sizeof(entry) };
+    unsigned int size = 0;
+    HANDLE snapshot;
+    DWORD *list = NULL;
+
+    *ids = NULL;
+    *count = 0;
+
+    if ((snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0)) == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    if (Thread32First(snapshot, &entry))
+    {
+        do
+        {
+            if (entry.th32OwnerProcessID != target->pid)
+                continue;
+            if (*count == size)
+            {
+                DWORD *tmp = realloc(list, (size = size ? size * 2 : 16) * sizeof(*list));
+                if (!tmp)
+                {
+                    free(list);
+                    CloseHandle(snapshot);
+                    return E_OUTOFMEMORY;
+                }
+                list = tmp;
+            }
+            list[(*count)++] = entry.th32ThreadID;
+        } while (Thread32Next(snapshot, &entry));
+    }
+    CloseHandle(snapshot);
+
+    *ids = list;
+    return S_OK;
+}
+
+static HRESULT debug_client_get_thread_sysid(struct debug_client *debug_client, ULONG id, DWORD *sysid)
+{
+    struct target_process *target;
+    unsigned int count;
+    DWORD *ids;
+    HRESULT hr;
+
+    if (!(target = debug_client_get_current_target(debug_client)))
+        return E_UNEXPECTED;
+    if (FAILED(hr = debug_target_get_threads(target, &ids, &count)))
+        return hr;
+    if (id >= count)
+        hr = E_NOINTERFACE;
+    else
+        *sysid = ids[id];
+    free(ids);
+    return hr;
+}
+
+static HRESULT debug_client_get_thread_id_by_sysid(struct debug_client *debug_client, DWORD sysid, ULONG *id)
+{
+    struct target_process *target;
+    unsigned int count, i;
+    DWORD *ids;
+    HRESULT hr;
+
+    if (!(target = debug_client_get_current_target(debug_client)))
+        return E_UNEXPECTED;
+    if (FAILED(hr = debug_target_get_threads(target, &ids, &count)))
+        return hr;
+    hr = E_NOINTERFACE;
+    for (i = 0; i < count; ++i)
+    {
+        if (ids[i] == sysid)
+        {
+            *id = i;
+            hr = S_OK;
+            break;
+        }
+    }
+    free(ids);
+    return hr;
+}
+
+static HRESULT debug_client_open_thread(struct debug_client *debug_client, DWORD sysid, HANDLE *handle)
+{
+    HANDLE *tmp;
+
+    if (!(*handle = OpenThread(THREAD_QUERY_INFORMATION | THREAD_GET_CONTEXT | THREAD_SET_CONTEXT, FALSE, sysid)))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    /* the engine owns the handles it hands out */
+    if (!(tmp = realloc(debug_client->thread_handles, (debug_client->thread_handle_count + 1) * sizeof(*tmp))))
+    {
+        CloseHandle(*handle);
+        return E_OUTOFMEMORY;
+    }
+    debug_client->thread_handles = tmp;
+    tmp[debug_client->thread_handle_count++] = *handle;
+    return S_OK;
+}
+
+static HRESULT debug_client_get_thread_teb(struct debug_client *debug_client, DWORD sysid, ULONG64 *teb)
+{
+    THREAD_BASIC_INFORMATION info;
+    HANDLE thread;
+    NTSTATUS status;
+
+    if (!(thread = OpenThread(THREAD_QUERY_INFORMATION, FALSE, sysid)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    status = NtQueryInformationThread(thread, ThreadBasicInformation, &info, sizeof(info), NULL);
+    CloseHandle(thread);
+    if (status)
+        return HRESULT_FROM_NT(status);
+    *teb = (ULONG_PTR)info.TebBaseAddress;
+    return S_OK;
+}
