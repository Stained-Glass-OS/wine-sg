 {
-    FIXME("%p, %s, %p, %lu, %p stub.\n", iface, wine_dbgstr_longlong(server), ids, count, actual_count);
+    PROCESSENTRY32W entry = { sizeof(entry) };
+    ULONG total = 0;
+    HANDLE snapshot;
 
-    return E_NOTIMPL;
+    TRACE("%p, %s, %p, %lu, %p.\n", iface, wine_dbgstr_longlong(server), ids, count, actual_count);
+
+    if (server)
+        return E_NOTIMPL;
+    if (count && !ids)
+        return E_INVALIDARG;
+
+    if ((snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0)) == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (Process32FirstW(snapshot, &entry))
+    {
+        do
+        {
+            if (total < count)
+                ids[total] = entry.th32ProcessID;
+            ++total;
+        } while (Process32NextW(snapshot, &entry));
+    }
+    CloseHandle(snapshot);
+
+    if (actual_count)
+        *actual_count = total;
+    return S_OK;
 }
 
