+static HRESULT debug_return_wstring(const WCHAR *str, WCHAR *buffer, unsigned int buffer_size, ULONG *size)
+{
+    unsigned int len = wcslen(str), dst_len;
+
+    if (size)
+        *size = len + 1;
+
+    if (buffer && buffer_size)
+    {
+        dst_len = min(len, buffer_size - 1);
+        if (dst_len)
+            memcpy(buffer, str, dst_len * sizeof(*buffer));
+        buffer[dst_len] = 0;
+    }
+
+    return len < buffer_size ? S_OK : S_FALSE;
+}
+
+static const WCHAR *debug_wcsistr(const WCHAR *str, const WCHAR *sub)
+{
+    size_t len = wcslen(sub);
+
+    for (; *str; ++str)
+    {
+        if (!wcsnicmp(str, sub, len))
+            return str;
+    }
+    return len ? NULL : str;
+}
+
+static WCHAR *debug_strdup_acp(const char *str)
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str)
+        return NULL;
+    len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+    if ((ret = malloc(len * sizeof(*ret))))
+        MultiByteToWideChar(CP_ACP, 0, str, -1, ret, len);
+    return ret;
+}
+
+static char *debug_strdup_acp_from_w(const WCHAR *str)
+{
+    char *ret;
+    int len;
+
+    if (!str)
+        return NULL;
+    len = WideCharToMultiByte(CP_ACP, 0, str, -1, NULL, 0, NULL, NULL);
+    if ((ret = malloc(len)))
+        WideCharToMultiByte(CP_ACP, 0, str, -1, ret, len, NULL, NULL);
+    return ret;
+}
+
+/* text goes to the output callbacks when the mask asks for it */
+static void debug_client_output(struct debug_client *debug_client, ULONG mask, const char *text)
+{
+    if (!(mask & debug_client->output_mask))
+        return;
+
+    if (debug_client->output_callbacks_wide)
+    {
+        WCHAR *wide = debug_strdup_acp(text);
+
+        if (wide)
+            debug_client->output_callbacks_wide->lpVtbl->Output(debug_client->output_callbacks_wide, mask, wide);
+        free(wide);
+    }
+    else if (debug_client->output_callbacks)
+        debug_client->output_callbacks->lpVtbl->Output(debug_client->output_callbacks, mask, text);
+}
+
+static char *debug_vformat(const char *format, va_list args)
+{
+    unsigned int size = 256;
+    char *buf = NULL;
+
+    for (;;)
+    {
+        va_list copy;
+        char *tmp;
+        int ret;
+
+        if (!(tmp = realloc(buf, size)))
+        {
+            free(buf);
+            return NULL;
+        }
+        buf = tmp;
+        va_copy(copy, args);
+        ret = vsnprintf(buf, size, format, copy);
+        va_end(copy);
+        if (ret >= 0 && (unsigned int)ret < size)
+            return buf;
+        size = ret >= 0 ? ret + 1 : size * 2;
+    }
+}
