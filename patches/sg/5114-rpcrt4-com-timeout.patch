From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] rpcrt4: RpcMgmtSetComTimeout, RpcMgmtInqComTimeout (patch 5114)

The binding keeps the communications time-out hint; gap-CORE item 554. Gate with
two mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/rpcrt4/rpc_binding.c b/dlls/rpcrt4/rpc_binding.c
--- a/dlls/rpcrt4/rpc_binding.c
+++ b/dlls/rpcrt4/rpc_binding.c
@@ -96,6 +96,7 @@
   NewBinding = calloc(1, sizeof(RpcBinding));
   NewBinding->refs = 1;
   NewBinding->server = server;
+  NewBinding->ComTimeout = RPC_C_BINDING_DEFAULT_TIMEOUT;
 
   *Binding = NewBinding;
 
@@ -995,6 +996,9 @@
 
   DestBinding->ObjectUuid = SrcBinding->ObjectUuid;
   DestBinding->BlockingFn = SrcBinding->BlockingFn;
+#ifndef SG_MUTANT_COMTIMEOUT_COPY
+  DestBinding->ComTimeout = SrcBinding->ComTimeout;
+#endif
   DestBinding->Protseq = strdup(SrcBinding->Protseq);
   DestBinding->NetworkAddr = strdup(SrcBinding->NetworkAddr);
   DestBinding->Endpoint = strdup(SrcBinding->Endpoint);
@@ -1465,7 +1469,33 @@
  */
 RPC_STATUS WINAPI RpcMgmtSetComTimeout(RPC_BINDING_HANDLE BindingHandle, unsigned int Timeout)
 {
-    FIXME("(%p, %d): stub\n", BindingHandle, Timeout);
+    RpcBinding *bind = BindingHandle;
+
+    TRACE("(%p, %d)\n", BindingHandle, Timeout);
+
+    if (!bind) return RPC_S_INVALID_BINDING;
+    if (bind->server) return RPC_S_WRONG_KIND_OF_BINDING;
+#ifndef SG_MUTANT_COMTIMEOUT_RANGE
+    /* "from zero to 10": a relative scale, only a hint to the protocol sequence */
+    if (Timeout > RPC_C_BINDING_INFINITE_TIMEOUT) return RPC_S_INVALID_TIMEOUT;
+#endif
+    bind->ComTimeout = Timeout;
+    return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcMgmtInqComTimeout (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcMgmtInqComTimeout(RPC_BINDING_HANDLE BindingHandle, unsigned int *Timeout)
+{
+    RpcBinding *bind = BindingHandle;
+
+    TRACE("(%p, %p)\n", BindingHandle, Timeout);
+
+    if (!bind) return RPC_S_INVALID_BINDING;
+    if (bind->server) return RPC_S_WRONG_KIND_OF_BINDING;
+    if (!Timeout) return RPC_S_INVALID_ARG;
+    *Timeout = bind->ComTimeout;
     return RPC_S_OK;
 }
 
diff --git a/dlls/rpcrt4/rpc_binding.h b/dlls/rpcrt4/rpc_binding.h
--- a/dlls/rpcrt4/rpc_binding.h
+++ b/dlls/rpcrt4/rpc_binding.h
@@ -141,6 +141,9 @@
   RpcAuthInfo *AuthInfo;
   RpcQualityOfService *QOS;
   LPWSTR CookieAuth;
+
+  /* the communications time-out hint (RpcMgmtSetComTimeout), 0 to 10 */
+  ULONG ComTimeout;
 } RpcBinding;
 
 LPWSTR RPCRT4_strndupW(LPCWSTR src, INT len);
diff --git a/dlls/rpcrt4/rpcrt4.spec b/dlls/rpcrt4/rpcrt4.spec
--- a/dlls/rpcrt4/rpcrt4.spec
+++ b/dlls/rpcrt4/rpcrt4.spec
@@ -399,7 +399,7 @@
 @ stub RpcMgmtEpEltInqNextA
 @ stub RpcMgmtEpEltInqNextW
 @ stub RpcMgmtEpUnregister
-@ stub RpcMgmtInqComTimeout
+@ stdcall RpcMgmtInqComTimeout(ptr ptr)
 @ stub RpcMgmtInqDefaultProtectLevel
 @ stdcall RpcMgmtInqIfIds(ptr ptr)
 @ stub RpcMgmtInqServerPrincNameA
