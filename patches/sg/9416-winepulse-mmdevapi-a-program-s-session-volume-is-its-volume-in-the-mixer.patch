From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winepulse, mmdevapi: A program's session volume is its volume in the sound server's mixer (9416)

Windows' Volume Mixer shows each program's audio session: its slider is
the session's volume (ISimpleAudioVolume), a program that changes it
moves the slider, and a slider moved there is the program's volume, told
to it (IAudioSessionEvents::OnSimpleVolumeChanged). Wine applied the
session volume to the samples and left the sound server's per-program
volume at 100%: a mixer showed nothing, and a volume set there was never
the program's.

A render stream's session volume and mute are now its sink-input's volume
and mute (the stream's and the session's channel volumes stay in Wine).
winepulse watches its sink-inputs; a change made at the sound server
becomes the session's volume and mute, the session's other streams follow,
and the program is told: a mmdevapi thread waits in a new driver call,
session_volume_wait, which the other drivers answer as not implemented
(they keep the session volume in the samples, as before). A volume the
sound server restores for the program when it starts is its session's, as
Windows keeps a program's mixer volume from one run to the next.
---
--- a/dlls/mmdevapi/unixlib.h
+++ b/dlls/mmdevapi/unixlib.h
@@ -216,6 +216,21 @@
     float master_volume;
     const float *volumes;
     const float *session_volumes;
+    /* Stained Glass OS (wine-sg 9416): the session's own volume and mute, apart: a
+     * driver that has a mixer of its own (the sound server's per-program volume)
+     * carries them there instead of in master_volume */
+    float session_level;
+    BOOL session_mute;
+};
+
+/* Stained Glass OS (wine-sg 9416): waits until the sound server's mixer changes a
+ * stream's volume or mute (a per-program volume slider), or the process ends */
+struct session_volume_wait_params
+{
+    stream_handle stream;
+    float level;
+    BOOL mute;
+    HRESULT result;
 };
 
 struct set_event_handle_params
@@ -350,5 +365,6 @@
     midi_in_message,
     midi_notify_wait,
     aux_message,
+    session_volume_wait,
     funcs_count
 };
--- a/dlls/mmdevapi/session.c
+++ b/dlls/mmdevapi/session.c
@@ -144,6 +144,70 @@
     release_sinks(&set);
 }
 
+/* Stained Glass OS (wine-sg 9416): the sound server's mixer set a stream's
+ * volume or mute (a per-program volume slider): that is its session's, as the
+ * Windows Volume Mixer's slider is the session's volume. The session's other
+ * streams follow and the program hears it (IAudioSessionEvents). */
+static void session_external_volume(stream_handle stream, float level, BOOL mute)
+{
+    struct audio_session *session, *found = NULL;
+    struct audio_client *client;
+
+    sessions_lock();
+    LIST_FOR_EACH_ENTRY(session, &sessions, struct audio_session, entry)
+    {
+        LIST_FOR_EACH_ENTRY(client, &session->clients, struct audio_client, entry)
+            if (client->stream == stream) { found = session; break; }
+        if (found) break;
+    }
+    if (found && (found->master_vol != level || !found->mute != !mute))
+    {
+        found->master_vol = level;
+        found->mute = mute;
+        LIST_FOR_EACH_ENTRY(client, &found->clients, struct audio_client, entry)
+            set_stream_volumes(client);
+    }
+    else
+        found = NULL;
+    sessions_unlock();
+
+    if (found)
+        notify_simple_volume(found, &GUID_NULL);
+}
+
+static DWORD WINAPI session_volume_thread(void *arg)
+{
+    struct session_volume_wait_params params;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_mmdevapi_session_volume");
+    for (;;)
+    {
+        params.result = E_NOTIMPL;
+        if (__wine_unix_call(drvs.module_unixlib, session_volume_wait, &params) || params.result != S_OK)
+            break;
+        session_external_volume(params.stream, params.level, params.mute);
+    }
+    return 0;
+}
+
+void session_volume_watch(void)
+{
+    static LONG started;
+    HMODULE module;
+    HANDLE thread;
+
+#ifdef SG_MUTANT_PULSE_NO_MIXER_VOLUME
+    return;
+#endif
+    if (InterlockedCompareExchange(&started, 1, 0))
+        return;
+    /* the thread waits in the driver for good: the module stays */
+    GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+            (const WCHAR *)session_volume_watch, &module);
+    if ((thread = CreateThread(NULL, 0, session_volume_thread, NULL, 0, NULL)))
+        CloseHandle(thread);
+}
+
 static void notify_channel_volume(struct audio_session *session, DWORD changed, const GUID *context)
 {
     float levels[32];
