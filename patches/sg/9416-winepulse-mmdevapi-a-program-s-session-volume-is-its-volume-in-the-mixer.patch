     params.volumes         = This->vols;
     params.session_volumes = This->session->channel_vols;
+    params.session_level   = This->session->master_vol;
+    params.session_mute    = This->session->mute;
 
     wine_unix_call(set_volumes, &params);
 }
@@ -497,6 +500,7 @@
     if (SUCCEEDED(params.result)) {
         session_announce(client->session);
         session_state_changed(client->session);
+        session_volume_watch();
     }
 
     return params.result;
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -85,6 +85,15 @@
 
