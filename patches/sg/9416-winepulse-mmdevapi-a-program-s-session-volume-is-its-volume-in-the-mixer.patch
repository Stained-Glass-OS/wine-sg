     struct list packet_filled_head;
+
+    /* Stained Glass OS (wine-sg 9416): a render stream's session volume and
+     * mute are the sound server's volume and mute of its stream (the per-program
+     * volume a mixer shows), as Windows' Volume Mixer shows the session's */
+    struct list volume_entry;
+    BOOL volume_listed, volume_known, volume_pending;
+    uint32_t sink_input;
+    float want_level, pa_level;
+    BOOL want_mute, pa_mute;
 };
 
 typedef struct _ACPacket
@@ -117,6 +126,11 @@
 static pthread_mutex_t pulse_mutex;
 static pthread_cond_t pulse_cond = PTHREAD_COND_INITIALIZER;
 
+/* wine-sg 9416: the render streams whose volume follows the sound server's */
+static struct list g_volume_streams = LIST_INIT(g_volume_streams);
+static pthread_cond_t volume_cond = PTHREAD_COND_INITIALIZER;
+static BOOL volume_quit;
+
 static ULONG_PTR zero_bits = 0;
 
 static NTSTATUS pulse_not_implemented(void *args)
@@ -263,6 +277,10 @@
 
 static NTSTATUS pulse_process_detach(void *args)
 {
+    pulse_lock();
+    volume_quit = TRUE;
+    pthread_cond_broadcast(&volume_cond);
+    pulse_unlock();
     free_phys_device_lists();
     if (pulse_ctx)
     {
@@ -394,6 +412,94 @@
     return pa_stream_get_state(stream->stream) == PA_STREAM_READY;
 }
 
+static struct pulse_stream *volume_stream_by_sink_input(uint32_t index)
+{
+    struct pulse_stream *stream;
+
+    LIST_FOR_EACH_ENTRY(stream, &g_volume_streams, struct pulse_stream, volume_entry)
+        if (stream->sink_input == index)
+            return stream;
+    return NULL;
+}
+
+/* the session's volume and mute to the sound server's stream */
+static void volume_push(struct pulse_stream *stream)
+{
+    pa_operation *o;
+    pa_cvolume cv;
+
+    if (!stream->volume_known || stream->sink_input == PA_INVALID_INDEX)
+        return;
+    if (fabsf(stream->want_level - stream->pa_level) >= 0.0005f)
+    {
+        pa_cvolume_set(&cv, stream->ss.channels, pa_sw_volume_from_linear(stream->want_level));
+        if ((o = pa_context_set_sink_input_volume(pulse_ctx, stream->sink_input, &cv, NULL, NULL)))
+            pa_operation_unref(o);
+        stream->pa_level = stream->want_level;
+    }
+    if (!stream->want_mute != !stream->pa_mute)
+    {
+        if ((o = pa_context_set_sink_input_mute(pulse_ctx, stream->sink_input, stream->want_mute, NULL, NULL)))
+            pa_operation_unref(o);
+        stream->pa_mute = stream->want_mute;
+    }
+}
+
+static void pulse_sink_input_info_cb(pa_context *c, const pa_sink_input_info *info, int eol, void *user)
+{
+    struct pulse_stream *stream;
+    float level;
+
+    if (eol || !info || !(stream = volume_stream_by_sink_input(info->index)))
+        return;
+    /* a session's volume goes from silence to full; the sound server's to 150% */
+    level = pa_sw_volume_to_linear(pa_cvolume_max(&info->volume));
+    if (level > 1.f) level = 1.f;
+
+    if (!stream->volume_known)
+    {
+        stream->volume_known = TRUE;
+        stream->pa_level = level;
+        stream->pa_mute = !!info->mute;
+        if (stream->want_level != 1.f || stream->want_mute)
+        {
+            /* the program set its session's volume before the server answered */
+            volume_push(stream);
+            return;
+        }
+        /* else the volume the server keeps for this program (stream restore), as
+         * Windows' mixer keeps a program's volume from one run to the next */
+        stream->want_level = level;
+        stream->want_mute = stream->pa_mute;
+        if (level != 1.f || stream->pa_mute)
+        {
+            stream->volume_pending = TRUE;
+            pthread_cond_broadcast(&volume_cond);
+        }
+        return;
+    }
+
+    if (fabsf(level - stream->pa_level) < 0.002f && !info->mute == !stream->pa_mute)
+        return;   /* ours, coming back */
+    TRACE("stream %p: the mixer set volume %.3f mute %d\n", stream, level, info->mute);
+    stream->pa_level = stream->want_level = level;
+    stream->pa_mute = stream->want_mute = !!info->mute;
+    stream->volume_pending = TRUE;
+    pthread_cond_broadcast(&volume_cond);
+}
+
+static void pulse_subscribe_cb(pa_context *c, pa_subscription_event_type_t t, uint32_t index, void *user)
+{
+    pa_operation *o;
+
+    if ((t & PA_SUBSCRIPTION_EVENT_FACILITY_MASK) != PA_SUBSCRIPTION_EVENT_SINK_INPUT
+            || (t & PA_SUBSCRIPTION_EVENT_TYPE_MASK) != PA_SUBSCRIPTION_EVENT_CHANGE
+            || !volume_stream_by_sink_input(index))
+        return;
+    if ((o = pa_context_get_sink_input_info(c, index, pulse_sink_input_info_cb, NULL)))
+        pa_operation_unref(o);
+}
+
 static HRESULT pulse_connect(const char *name)
 {
     pa_context_state_t state;
@@ -426,6 +532,15 @@
     TRACE("Connected to server %s with protocol version: %i.\n",
         pa_context_get_server(pulse_ctx),
         pa_context_get_server_protocol_version(pulse_ctx));
+#ifndef SG_MUTANT_PULSE_NO_MIXER_VOLUME
+    {
+        pa_operation *o;
+
+        pa_context_set_subscribe_callback(pulse_ctx, pulse_subscribe_cb, NULL);
+        if ((o = pa_context_subscribe(pulse_ctx, PA_SUBSCRIPTION_MASK_SINK_INPUT, NULL, NULL)))
+            pa_operation_unref(o);
+    }
+#endif
     return S_OK;
 
 fail:
@@ -1110,6 +1225,18 @@
     if (stream->dataflow == eRender) {
         pa_stream_set_underflow_callback(stream->stream, pulse_underflow_callback, stream);
         pa_stream_set_started_callback(stream->stream, pulse_started_callback, stream);
+#ifndef SG_MUTANT_PULSE_NO_MIXER_VOLUME
+        {
+            pa_operation *o;
+
+            stream->sink_input = pa_stream_get_index(stream->stream);
+            stream->want_level = stream->pa_level = 1.f;
+            list_add_tail(&g_volume_streams, &stream->volume_entry);
+            stream->volume_listed = TRUE;
+            if ((o = pa_context_get_sink_input_info(pulse_ctx, stream->sink_input, pulse_sink_input_info_cb, NULL)))
+                pa_operation_unref(o);
+        }
+#endif
     }
     return S_OK;
 }
@@ -1241,6 +1368,8 @@
 
 exit:
     if (FAILED(params->result = hr)) {
+        if (stream->volume_listed)
+            list_remove(&stream->volume_entry);
         free(stream->local_buffer);
         if (stream->stream) {
             pa_stream_disconnect(stream->stream);
@@ -1266,6 +1395,8 @@
     }
 
     pulse_lock();
+    if (stream->volume_listed)
+        list_remove(&stream->volume_entry);
     if (PA_STREAM_IS_GOOD(pa_stream_get_state(stream->stream))) {
         pa_stream_disconnect(stream->stream);
         while (PA_STREAM_IS_GOOD(pa_stream_get_state(stream->stream)))
@@ -2484,12 +2615,53 @@
     struct pulse_stream *stream = handle_get_stream(params->stream);
     unsigned int i;
 
+    if (stream->volume_listed)
+    {
+        /* the session's volume and mute at the sound server, the rest here */
+        for (i = 0; i < stream->ss.channels; i++)
+            stream->vol[i] = params->volumes[i] * params->session_volumes[i];
+        pulse_lock();
+        stream->want_level = min(max(params->session_level, 0.f), 1.f);
+        stream->want_mute = params->session_mute;
+        volume_push(stream);
+        pulse_unlock();
+        return STATUS_SUCCESS;
+    }
+
     for (i = 0; i < stream->ss.channels; i++)
         stream->vol[i] = params->volumes[i] * params->master_volume * params->session_volumes[i];
 
     return STATUS_SUCCESS;
 }
 
+static NTSTATUS pulse_session_volume_wait(void *args)
+{
+    struct session_volume_wait_params *params = args;
+    struct pulse_stream *stream;
+
+    pulse_lock();
+    for (;;)
+    {
+        LIST_FOR_EACH_ENTRY(stream, &g_volume_streams, struct pulse_stream, volume_entry)
+        {
+            if (!stream->volume_pending) continue;
+            stream->volume_pending = FALSE;
+            params->stream = (stream_handle)(UINT_PTR)stream;
+            params->level = stream->want_level;
+            params->mute = stream->want_mute;
+            params->result = S_OK;
+            pulse_unlock();
+            return STATUS_SUCCESS;
+        }
+        if (volume_quit)
+            break;
+        pthread_cond_wait(&volume_cond, &pulse_mutex);
+    }
+    pulse_unlock();
+    params->result = S_FALSE;
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS pulse_set_event_handle(void *args)
 {
     struct set_event_handle_params *params = args;
@@ -2693,6 +2865,7 @@
     pulse_not_implemented,
     pulse_not_implemented,
     pulse_not_implemented,
+    pulse_session_volume_wait,
 };
 
