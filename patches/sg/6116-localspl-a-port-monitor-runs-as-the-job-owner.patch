From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] localspl: a port monitor's job calls run as the job's owner

The spooler impersonates the job's client when it calls a port monitor; here the monitor ran with no thread token. CutePDF Writer's monitor takes the user's SID from its thread token for its Save As helper: it passed none, the helper had no file name, no PDF was made. The thread impersonates its own process's user around StartDocPort, WritePort and EndDocPort unless it impersonates already.
---
diff --git a/dlls/localspl/provider.c b/dlls/localspl/provider.c
index 4f33bd6..6afa969 100644
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -3915,6 +3915,27 @@ static void print_proc_unload(printproc_t *pp)
     free(pp);
 }
 
+/* Stained Glass OS: the spooler talks to a port monitor as the job's owner
+ * (it impersonates the client); a monitor that asks its thread for the
+ * user's token -- CutePDF Writer's, for the user whose desktop gets the
+ * Save As window -- found none here and passed no user to its helper: no
+ * dialog, no PDF. The thread impersonates its own process's user around
+ * the monitor's job calls, unless it impersonates someone already. */
+static BOOL sg_port_impersonate(void)
+{
+    HANDLE token;
+
+#ifdef SG_MUTANT_PORT_NO_IMPERSONATION
+    return FALSE;
+#endif
+    if (OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ))
+    {
+        CloseHandle( token );
+        return FALSE;
+    }
+    return ImpersonateSelf( SecurityImpersonation );
+}
+
 static DWORD WINAPI fpStartDocPrinter(HANDLE hprinter, DWORD level, BYTE *doc_info)
 {
     printer_t *printer = (printer_t *)hprinter;
@@ -3936,6 +3957,7 @@ static DWORD WINAPI fpStartDocPrinter(HANDLE hprinter, DWORD level, BYTE *doc_in
     if (printer->header.type == HANDLE_PORT)
     {
         port_t *port = (port_t *)hprinter;
+        BOOL impersonated = sg_port_impersonate(), started;
         if (port->lm)
         {
             BOOL ret = FALSE, crashed = FALSE;
@@ -3948,16 +3970,26 @@ static DWORD WINAPI fpStartDocPrinter(HANDLE hprinter, DWORD level, BYTE *doc_in
                 crashed = TRUE;
             }
             __ENDTRY
-            if (!crashed) return ret;
+            if (!crashed)
+            {
+                if (impersonated) RevertToSelf();
+                return ret;
+            }
             /* the maker's monitor crashed: the job goes to the port itself */
             WARN("language monitor failed starting the job; the port is used directly\n");
             port->lm = NULL;
             port->hlm = NULL;
             port->mon->monitor.pfnOpenPort(port->mon->hmon, port->port_name, &port->hport);
-            if (!port->hport) return FALSE;
+            if (!port->hport)
+            {
+                if (impersonated) RevertToSelf();
+                return FALSE;
+            }
         }
-        return port->mon->monitor.pfnStartDocPort(port->hport,
+        started = port->mon->monitor.pfnStartDocPort(port->hport,
                 port->printer, port->job_id, level, doc_info);
+        if (impersonated) RevertToSelf();
+        return started;
     }
 
     if (printer->header.type != HANDLE_PRINTER)
@@ -4079,9 +4111,12 @@ static BOOL WINAPI fpWritePrinter(HANDLE hprinter, void *buf, DWORD size, DWORD
     if (header->type == HANDLE_PORT)
     {
         port_t *port = (port_t *)hprinter;
+        BOOL impersonated = sg_port_impersonate(), ret;
 
-        if (port->lm) return port->lm->monitor.pfnWritePort(port->hlm, buf, size, written);
-        return port->mon->monitor.pfnWritePort(port->hport, buf, size, written);
+        if (port->lm) ret = port->lm->monitor.pfnWritePort(port->hlm, buf, size, written);
+        else ret = port->mon->monitor.pfnWritePort(port->hport, buf, size, written);
+        if (impersonated) RevertToSelf();
+        return ret;
     }
 
     if (header->type == HANDLE_PRINTER)
@@ -4915,8 +4950,11 @@ static BOOL WINAPI fpEndDocPrinter(HANDLE hprinter)
     if (printer->header.type == HANDLE_PORT)
     {
         port_t *port = (port_t *)hprinter;
-        if (port->lm) return port->lm->monitor.pfnEndDocPort(port->hlm);
-        return port->mon->monitor.pfnEndDocPort(port->hport);
+        BOOL impersonated = sg_port_impersonate(), ret;
+        if (port->lm) ret = port->lm->monitor.pfnEndDocPort(port->hlm);
+        else ret = port->mon->monitor.pfnEndDocPort(port->hport);
+        if (impersonated) RevertToSelf();
+        return ret;
     }
 
     if (printer->header.type != HANDLE_PRINTER)
