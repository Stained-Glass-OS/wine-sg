From: Stained Glass OS <dev@stained-glass.example>
Subject: wininet: InternetGetCookieEx2 and InternetFreeCookies

The cookies InternetGetCookieEx returns for a URL, one structure each
(name, value, domain, path, flags, expiry) rather than one string. Missing
exports Microsoft Edge delay-loads.

--- a/include/wininet.h
+++ b/include/wininet.h
@@ -1341,6 +1341,19 @@
 #define INTERNET_COOKIE_NON_SCRIPT      0x00001000
 #define INTERNET_COOKIE_HTTPONLY        0x00002000
 
+typedef struct
+{
+    PWSTR pwszName;
+    PWSTR pwszValue;
+    PWSTR pwszDomain;
+    PWSTR pwszPath;
+    DWORD dwFlags;
+    FILETIME ftExpires;
+    BOOL fExpiresSet;
+} INTERNET_COOKIE2;
+
+DWORD WINAPI InternetGetCookieEx2(PCWSTR,PCWSTR,DWORD,INTERNET_COOKIE2**,PDWORD);
+VOID WINAPI InternetFreeCookies(INTERNET_COOKIE2*,DWORD);
 BOOLAPI InternetGetCookieExA(LPCSTR,LPCSTR,LPSTR,LPDWORD,DWORD,LPVOID);
 BOOLAPI InternetGetCookieExW(LPCWSTR,LPCWSTR,LPWSTR,LPDWORD,DWORD,LPVOID);
 #define InternetGetCookieEx WINELIB_NAME_AW(InternetGetCookieEx)
--- a/dlls/wininet/cookie.c
+++ b/dlls/wininet/cookie.c
@@ -781,6 +781,87 @@
 }
 
 /***********************************************************************
+ *           InternetFreeCookies (WININET.@)
+ */
+VOID WINAPI InternetFreeCookies(INTERNET_COOKIE2 *cookies, DWORD count)
+{
+    DWORD i;
+
+    TRACE("(%p, %lu)\n", cookies, count);
+
+    if (!cookies) return;
+    for (i = 0; i < count; i++)
+    {
+        free(cookies[i].pwszName);
+        free(cookies[i].pwszValue);
+        free(cookies[i].pwszDomain);
+        free(cookies[i].pwszPath);
+    }
+    free(cookies);
+}
+
+/***********************************************************************
+ *           InternetGetCookieEx2 (WININET.@)
+ *
+ * The cookies InternetGetCookieEx would return for a URL, one structure
+ * each instead of one string, with their domain, path, flags and expiry.
+ */
+DWORD WINAPI InternetGetCookieEx2(PCWSTR url, PCWSTR name, DWORD flags,
+        INTERNET_COOKIE2 **cookies, DWORD *count)
+{
+    cookie_set_t cookie_set = {0};
+    INTERNET_COOKIE2 *out;
+    substr_t host, path;
+    DWORD res = ERROR_SUCCESS, i, n = 0;
+
+    TRACE("(%s, %s, %lx, %p, %p)\n", debugstr_w(url), debugstr_w(name), flags, cookies, count);
+
+    if (!url || !cookies || !count) return ERROR_INVALID_PARAMETER;
+    *cookies = NULL;
+    *count = 0;
+    if (!cookie_parse_url(url, &host, &path)) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection(&cookie_cs);
+    res = get_cookie(host, path, flags, &cookie_set);
+    if (res == ERROR_NO_MORE_ITEMS) res = ERROR_SUCCESS;  /* no cookies is an empty list */
+    if (res == ERROR_SUCCESS && cookie_set.cnt)
+    {
+        if (!(out = calloc(cookie_set.cnt, sizeof(*out)))) res = ERROR_NOT_ENOUGH_MEMORY;
+        for (i = 0; res == ERROR_SUCCESS && i < cookie_set.cnt; i++)
+        {
+            cookie_t *cookie = cookie_set.cookies[i];
+            cookie_container_t *container = cookie->container;
+            FILETIME none = {0};
+
+            if (name && wcscmp(name, cookie->name)) continue;
+            out[n].pwszName = wcsdup(cookie->name);
+            out[n].pwszValue = wcsdup(cookie->data);
+            out[n].pwszDomain = wcsdup(container->domain->domain);
+            if ((out[n].pwszPath = malloc((container->path.len + 1) * sizeof(WCHAR))))
+            {
+                memcpy(out[n].pwszPath, container->path.str, container->path.len * sizeof(WCHAR));
+                out[n].pwszPath[container->path.len] = 0;
+            }
+            out[n].dwFlags = cookie->flags;
+            out[n].ftExpires = cookie->expiry;
+            out[n].fExpiresSet = CompareFileTime(&cookie->expiry, &none) != 0;
+            if (!out[n].pwszName || !out[n].pwszValue || !out[n].pwszDomain || !out[n].pwszPath)
+                res = ERROR_NOT_ENOUGH_MEMORY;
+            n++;
+        }
+        if (res == ERROR_SUCCESS)
+        {
+            *cookies = out;
+            *count = n;
+        }
+        else InternetFreeCookies(out, n);
+    }
+    free(cookie_set.cookies);
+    LeaveCriticalSection(&cookie_cs);
+    return res;
+}
+
