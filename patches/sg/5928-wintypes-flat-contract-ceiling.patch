From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wintypes: the flat API contract exports report no version whose classes are missing

Found at integration: Microsoft Word (Microsoft 365) hung at "Starting
Microsoft Word..." on 10.0-450 (10.0-427 started it). 3053 made
RoIsApiContractMajorVersionPresent answer from IApiInformationStatics' table
(UniversalApiContract up to 10). Office probes that contract from 15 down to
7 and, on a yes, draws through Windows.UI.Composition with its interaction
classes; RoGetActivationFactory of
Windows.UI.Composition.Interactions.VisualInteractionSource (UniversalApiContract
3) fails, mso20 stops the process on purpose (a write to address 0) and Word's
crash handler then sat in SuspendThread while the splash re-created its D3D11
device about once a second.

The flat exports (RoIsApiContractMajorVersionPresent, RoIsApiContractPresent)
now report UniversalApiContract only up to version 2; IApiInformationStatics
keeps its own table. A contract version is to be reported there only once the
activatable classes it adds exist. Arguments are still validated and the
RoIsApiContractPresent export stays.

Gate flatcontract (test-flatcontract): with VisualInteractionSource not
activatable no UniversalApiContract version >= 3 may be reported (Office's
probe), version 1 must be; mutant SG_MUTANT_FLAT_CONTRACT_10 (3053's answer)
fails it. wintypes conformance: version 2 present, version 3 todo_wine.
---
diff --git a/dlls/wintypes/main.c b/dlls/wintypes/main.c
--- a/dlls/wintypes/main.c
+++ b/dlls/wintypes/main.c
@@ -1460,15 +1460,41 @@ HRESULT WINAPI DllGetActivationFactory(HSTRING classid, IActivationFactory **fac
     return S_OK;
 }
 
+/* Stained Glass OS: the versions the flat exports (RoIsApiContractPresent,
+ * RoIsApiContractMajorVersionPresent) report. Native programs pick their code
+ * path from these: Microsoft Office probes UniversalApiContract 15 down to 7
+ * and, on a yes, draws through Windows.UI.Composition with its interaction
+ * classes (Windows.UI.Composition.Interactions.VisualInteractionSource,
+ * UniversalApiContract 3), which are not activatable here; Word then stopped
+ * itself at its splash (a deliberate crash after the failed activation,
+ * hanging in its crash handler). So these answer only up to version 2, the
+ * last whose classes we do not knowingly lack; IApiInformationStatics keeps
+ * its own table. A contract version is reported here only once the
+ * activatable classes it adds exist (test/flatcontract-gate.sh checks the
+ * Interactions class against version 3). */
+static const struct
+{
+    const WCHAR *name;
+    unsigned int max_major;
+}
+flat_contracts[] =
+{
+#ifdef SG_MUTANT_FLAT_CONTRACT_10
+    { L"Windows.Foundation.UniversalApiContract", 10, },
+#else
+    { L"Windows.Foundation.UniversalApiContract", 2, },
+#endif
+};
+
 static BOOL is_contract_present_w(const WCHAR *name, UINT16 major, UINT16 minor)
 {
     unsigned int i;
 
-    for (i = 0; i < ARRAY_SIZE(present_contracts); ++i)
+    for (i = 0; i < ARRAY_SIZE(flat_contracts); ++i)
     {
-        if (wcsicmp(name, present_contracts[i].name)) continue;
+        if (wcsicmp(name, flat_contracts[i].name)) continue;
         /* the contracts provided are provided at .0 of their highest major version */
-        return major <= present_contracts[i].max_major && (!minor || major < present_contracts[i].max_major);
+        return major <= flat_contracts[i].max_major && (!minor || major < flat_contracts[i].max_major);
     }
     return FALSE;
 }
diff --git a/dlls/wintypes/tests/wintypes.c b/dlls/wintypes/tests/wintypes.c
--- a/dlls/wintypes/tests/wintypes.c
+++ b/dlls/wintypes/tests/wintypes.c
@@ -1035,6 +1035,15 @@ static void test_api_contract_exports(void)
     present = FALSE;
     hr = pRoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract", 1, &present);
     ok(hr == S_OK && present, "Got unexpected hr %#lx, present %d.\n", hr, present);
+    /* Windows 10 1607 and later have version 3 (Windows.UI.Composition.Interactions); Wine reports
+     * the flat contract only up to version 2, so programs do not choose code paths it cannot serve */
+    present = FALSE;
+    hr = pRoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract", 2, &present);
+    ok(hr == S_OK && present, "Got unexpected hr %#lx, present %d.\n", hr, present);
+    present = FALSE;
+    hr = pRoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract", 3, &present);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    todo_wine ok(present, "Got unexpected present %d.\n", present);
     present = TRUE;
     hr = pRoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract", 4000, &present);
     ok(hr == S_OK && !present, "Got unexpected hr %#lx, present %d.\n", hr, present);
