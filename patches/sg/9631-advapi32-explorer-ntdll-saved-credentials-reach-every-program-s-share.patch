 extern NTSTATUS launch_request( void *args );
+
+/* Stained Glass OS (i0976): a name and password Credential Manager keeps for a
+ * server, handed to sg-netmountd (or forgotten), so that any program opening
+ * \\server\share is connected with it, as Windows' redirector does. request
+ * is one line ("CRED\tserver\tuser\tpassword\n", "UNCRED\tserver\n"); no
+ * pointers: the same for 32- and 64-bit callers. The caller wipes it. Returns
+ * STATUS_SUCCESS (the daemon said OK), STATUS_NO_SUCH_DEVICE (no daemon) or
+ * STATUS_UNSUCCESSFUL. */
+struct net_credential_params
+{
+    char request[1600];
+};
+
+extern NTSTATUS net_credential( void *args );
--- a/dlls/advapi32/logon_unix.c
+++ b/dlls/advapi32/logon_unix.c
@@ -33,6 +33,7 @@
 #include <unistd.h>
 #include <sys/socket.h>
 #include <sys/un.h>
+#include <sys/time.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -163,3 +164,38 @@
     if (ret != 1) return STATUS_UNSUCCESSFUL;
     return !status ? STATUS_SUCCESS : status == 1 ? STATUS_ACCESS_DENIED : STATUS_UNSUCCESSFUL;
 }
+
+/* sg-netmountd's socket: SG_NETMOUNT_SOCK in tests */
+NTSTATUS net_credential( void *args )
+{
+    struct net_credential_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    const char *path = getenv( "SG_NETMOUNT_SOCK" );
+    struct timeval tv = { 10, 0 };
+    char reply[64];
+    size_t len;
+    ssize_t r, got = 0;
+    int fd;
+
+    if (!path || !*path) path = "/run/stained-glass-net/netmount.sock";
+    if (strlen( path ) >= sizeof(addr.sun_path)) return STATUS_NO_SUCH_DEVICE;
+    strcpy( addr.sun_path, path );
+    params->request[sizeof(params->request) - 1] = 0;
+    if (!(len = strlen( params->request )) || params->request[len - 1] != '\n') return STATUS_INVALID_PARAMETER;
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return STATUS_NO_SUCH_DEVICE;
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv) );
+    setsockopt( fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv) );
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0) { close( fd ); return STATUS_NO_SUCH_DEVICE; }
+    if (write_all( fd, params->request, len )) { close( fd ); return STATUS_UNSUCCESSFUL; }
+    while (got < (ssize_t)sizeof(reply) - 1)
+    {
+        if ((r = read( fd, reply + got, sizeof(reply) - 1 - got )) < 0 && errno == EINTR) continue;
+        if (r <= 0) break;
+        got += r;
+        if (memchr( reply, '\n', got )) break;
+    }
+    close( fd );
+    reply[got] = 0;
+    return !strncmp( reply, "OK", 2 ) ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
