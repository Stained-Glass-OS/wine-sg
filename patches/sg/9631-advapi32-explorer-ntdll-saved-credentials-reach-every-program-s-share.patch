  */
-BOOL WINAPI CredDeleteW(LPCWSTR TargetName, DWORD Type, DWORD Flags)
+static BOOL cred_delete(LPCWSTR TargetName, DWORD Type, DWORD Flags)
 {
     HKEY hkeyMgr;
     DWORD ret;
@@ -1276,6 +1389,16 @@
 }
 
 /******************************************************************************
+ * CredDeleteW [ADVAPI32.@]
+ */
+BOOL WINAPI CredDeleteW(LPCWSTR TargetName, DWORD Type, DWORD Flags)
+{
+    if (!cred_delete( TargetName, Type, Flags )) return FALSE;
+    if (Type == CRED_TYPE_DOMAIN_PASSWORD) net_forget( TargetName );
+    return TRUE;
+}
+
+/******************************************************************************
  * CredEnumerateA [ADVAPI32.@]
  */
 BOOL WINAPI CredEnumerateA(LPCSTR Filter, DWORD Flags, DWORD *Count,
@@ -2283,7 +2406,7 @@
 /******************************************************************************
  * CredWriteW [ADVAPI32.@]
  */
-BOOL WINAPI CredWriteW(PCREDENTIALW Credential, DWORD Flags)
+static BOOL cred_write(PCREDENTIALW Credential, DWORD Flags)
 {
     HKEY hkeyMgr;
     HKEY hkeyCred;
@@ -2403,6 +2526,20 @@
     }
     return TRUE;
 }
+
+/******************************************************************************
+ * CredWriteW [ADVAPI32.@]
+ */
+BOOL WINAPI CredWriteW(PCREDENTIALW Credential, DWORD Flags)
+{
+    if (!cred_write( Credential, Flags )) return FALSE;
+    if (Credential->Type == CRED_TYPE_DOMAIN_PASSWORD)
+    {
+        if (Flags & CRED_PRESERVE_CREDENTIAL_BLOB) net_publish_target( Credential->TargetName );
+        else net_publish( Credential );
+    }
+    return TRUE;
+}
 
