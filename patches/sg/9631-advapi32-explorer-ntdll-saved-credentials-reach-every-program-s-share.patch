From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32, explorer, ntdll: the names and passwords kept for servers connect every program to \\server\share

A program that opened \\server\share\file directly -- no drive mapped, not File
Explorer -- was connected as a guest: the name and password Credential Manager
keeps for the server ("Remember my credentials", a Windows credential added in
Control Panel) were used by File Explorer, net use and mapped drives alone
(mpr, 9658), and a share that refuses a guest could not be opened by Word,
Notepad or a copy from cmd. On Windows every program's connection uses them:
the logon session holds the credentials and the redirector asks for them.

Now Credential Manager hands a domain credential kept for a computer (a NetBIOS
or DNS name or an address: not a generic credential, not TERMSRV/..., not a
*.domain wildcard) to sg-netmountd (sg-session), the logon session's keeper here:
CredWrite hands it over (with the kept secret when the write preserves it),
CredDelete forgets it, and CredProfileLoaded -- which Windows calls once the
user's profile is loaded, and File Explorer now calls at sign-in -- hands over
every one kept. sg-netmountd keeps them in memory, for that user alone, and
connects a share the server refuses to a guest with them; ntdll then uses that
connection, the user's own. The password goes over sg-netmountd's socket only,
never into a log or a file; a write is not held up when there is no daemon.

Test: test/netcred-gate.sh (64- and 32-bit, a stand-in daemon): what is handed
over, exactly, and what is not; preserve; sign-in; delete; no daemon. Mutant
SG_MUTANT_NO_NET_CREDENTIAL (dlls/advapi32/cred.c) fails it. The mount itself
is sg-session's test/netmount-savedcred-test.sh (QA VM).
---
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -165,7 +165,7 @@
 @ stdcall CredIsProtectedW(ptr ptr)
 @ stdcall CredMarshalCredentialA(long ptr ptr)
 @ stdcall CredMarshalCredentialW(long ptr ptr)
-@ stub CredProfileLoaded
+@ stdcall CredProfileLoaded()
 # @ stub CredProfileLoadedEx
 # @ stub CredProfileUnloaded
 @ stdcall CredProtectA(long ptr long ptr ptr ptr)
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1211,10 +1211,123 @@
     return ret ? ERROR_SUCCESS : GetLastError();
 }
 
+/* Stained Glass OS (i0976): the names and passwords kept for servers go to the logon
+ * session, as Windows' Credential Manager has LSA hold them: sg-netmountd connects any
+ * program's \\server\share with them when the server refuses a guest. It was File
+ * Explorer, net use and mapped drives alone (mpr, 9658) that used them; a program
+ * opening \\server\share\file directly was connected as a guest. Written and deleted
+ * as Credential Manager is, and all of them at sign-in (CredProfileLoaded). */
+static BOOL net_target( const WCHAR *target )
+{
+    const WCHAR *p;
+    size_t len = target ? wcslen( target ) : 0;
+
+    /* a computer: a NetBIOS or DNS name or an IPv4 address -- not "*", "Domain:...",
+     * "TERMSRV/...", a wildcard or a URL */
+    if (!len || len > 253 || target[0] == '.' || target[0] == '-' || wcsstr( target, L".." )) return FALSE;
+    for (p = target; *p; p++)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9') || *p == '.' || *p == '-'))
+            return FALSE;
+    return TRUE;
+}
+
+static void net_request( struct net_credential_params *params )
+{
+    NTSTATUS status;
+
+    InitOnceExecuteOnce( &keyring_once, keyring_init, NULL, NULL );
+    status = keyring_loaded ? WINE_UNIX_CALL( unix_net_credential, params ) : STATUS_NO_SUCH_DEVICE;
+    TRACE( "%.6s ...: %#lx\n", params->request, status );
+    SecureZeroMemory( params, sizeof(*params) );
+}
+
+/* appends str (UTF-8) and then sep to the request; FALSE when it does not fit */
+static BOOL net_append( struct net_credential_params *params, int *len, const WCHAR *str, char sep )
+{
+    int n = WideCharToMultiByte( CP_UTF8, 0, str, -1, params->request + *len,
+                                 sizeof(params->request) - *len - 2, NULL, NULL );
+    if (n <= 0) return FALSE;
+    *len += n - 1;
+    params->request[(*len)++] = sep;
+    params->request[*len] = 0;
+    return TRUE;
+}
+
+/* one domain credential, as it is kept */
+static void net_publish( const CREDENTIALW *cred )
+{
+    struct net_credential_params params;
+    WCHAR password[CRED_MAX_CREDENTIAL_BLOB_SIZE / sizeof(WCHAR) + 1];
+    int len;
+    BOOL ok;
+
+#ifdef SG_MUTANT_NO_NET_CREDENTIAL
+    return;
+#endif
+    if (!cred || cred->Type != CRED_TYPE_DOMAIN_PASSWORD || !net_target( cred->TargetName ) ||
+        !cred->UserName || !cred->UserName[0] || wcspbrk( cred->UserName, L"\t\r\n,=" ) ||
+        cred->CredentialBlobSize > sizeof(password) - sizeof(WCHAR)) return;
+    if (cred->CredentialBlobSize) memcpy( password, cred->CredentialBlob, cred->CredentialBlobSize );
+    password[cred->CredentialBlobSize / sizeof(WCHAR)] = 0;
+    strcpy( params.request, "CRED\t" );
+    len = 5;
+    ok = !wcspbrk( password, L"\r\n" ) && net_append( &params, &len, cred->TargetName, '\t' ) &&
+         net_append( &params, &len, cred->UserName, '\t' ) && net_append( &params, &len, password, '\n' );
+    SecureZeroMemory( password, sizeof(password) );
+    if (ok) net_request( &params );
+    else SecureZeroMemory( &params, sizeof(params) );
+}
+
+/* the credential now kept for target (written with its secret preserved, renamed) */
+static void net_publish_target( const WCHAR *target )
+{
+    CREDENTIALW *cred;
+
+    if (!net_target( target ) || !CredReadW( target, CRED_TYPE_DOMAIN_PASSWORD, 0, &cred )) return;
+    net_publish( cred );
+    if (cred->CredentialBlob) SecureZeroMemory( cred->CredentialBlob, cred->CredentialBlobSize );
+    CredFree( cred );
+}
+
+static void net_forget( const WCHAR *target )
+{
+    struct net_credential_params params;
+    int len = 7;
+
+#ifdef SG_MUTANT_NO_NET_CREDENTIAL
+    return;
+#endif
+    if (!net_target( target )) return;
+    strcpy( params.request, "UNCRED\t" );
+    if (net_append( &params, &len, target, '\n' )) net_request( &params );
+}
+
+/******************************************************************************
+ * CredProfileLoaded [ADVAPI32.@]
+ *
+ * The user's profile is loaded (their sign-in): the domain credentials kept for
+ * servers go to the logon session.
+ */
+BOOL WINAPI CredProfileLoaded(void)
+{
+    CREDENTIALW **creds;
+    DWORD count, i;
+
+    TRACE( "\n" );
+    if (!CredEnumerateW( NULL, 0, &count, &creds )) return TRUE;
+    for (i = 0; i < count; i++)
+    {
+        net_publish( creds[i] );
+        if (creds[i]->CredentialBlob) SecureZeroMemory( creds[i]->CredentialBlob, creds[i]->CredentialBlobSize );
+    }
+    CredFree( creds );
+    return TRUE;
+}
+
