--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2595,8 +2595,20 @@
         return buf;
     }
     snprintf( path, sizeof(path), SG_NET_UNC "%s/%s", server, share );
-    if ((stat( path, &st ) || !S_ISDIR( st.st_mode ) || !sg_net_is_mount( path )) && !sg_net_mount( server, share, status ))
-        return NULL;
+    if (stat( path, &st ) || !S_ISDIR( st.st_mode ) || !sg_net_is_mount( path ))
