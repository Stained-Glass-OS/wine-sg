+        free( wbuf );
+        if (!(wbuf = malloc( wneeded ))) { free( group ); return ERROR_NOT_ENOUGH_SERVER_MEMORY; }
+        wsize = wneeded;
+    }
+    if (!err) err = enum_to_ansi( wbuf, count, sizeof(struct enum_service_status_process), buffer, buf_size,
+                                  needed_size, services_count );
+    else { *needed_size = wneeded; *services_count = 0; }
+    free( wbuf );
+    free( group );
+    return err;
 }
 
