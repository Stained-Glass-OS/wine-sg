+/* SERVICE_CONFIG_PREFERRED_NODE: the NUMA node number, as the "PreferredNode"
+ * value of the service key.  [MS-SCMR] 3.1.1 names the setting but not its
+ * registry type: REG_DWORD is a guess. */
+DWORD set_service_preferred_node(struct service_entry *entry, USHORT node, BOOLEAN remove)
+{
+    HKEY key;
+    DWORD err;
+
+    if ((err = RegCreateKeyExW(entry->db->root_key, entry->name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+        return err;
+#ifdef SG_MUTANT_SVC_PREFNODE
+    if (0)
+#else
+    if (remove)
+#endif
+    {
+        err = RegDeleteValueW(key, L"PreferredNode");
+        if (err == ERROR_FILE_NOT_FOUND) err = ERROR_SUCCESS;
+    }
+    else err = reg_set_dword_value(key, L"PreferredNode", node);
+    RegCloseKey(key);
+    return err;
+}
+
+/* ERROR_FILE_NOT_FOUND when the service has no preferred node */
+DWORD query_service_preferred_node(struct service_entry *entry, USHORT *node)
+{
+    HKEY key;
+    DWORD err, size = sizeof(DWORD), type, value = 0;
+
+    if ((err = RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_READ, &key))) return err;
+    err = RegQueryValueExW(key, L"PreferredNode", NULL, &type, (BYTE *)&value, &size);
+    RegCloseKey(key);
+    if (!err && type != REG_DWORD) err = ERROR_FILE_NOT_FOUND;
+    if (!err) *node = value;
+    return err;
+}
