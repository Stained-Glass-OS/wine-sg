+/* ---- conversions for the ANSI entry points of the interface ---- */
+
+static WCHAR *a2w( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if (!(ret = malloc( len * sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
+static char *w2a( const WCHAR *str )
+{
+    char *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = WideCharToMultiByte( CP_ACP, 0, str, -1, NULL, 0, NULL, NULL );
+    if (!(ret = malloc( len ))) return NULL;
+    WideCharToMultiByte( CP_ACP, 0, str, -1, ret, len, NULL, NULL );
+    return ret;
+}
+
+/* an ANSI multi-string of "size" bytes as a wide one; *wsize is in bytes */
+static WCHAR *multi_a2w( const BYTE *data, DWORD size, DWORD *wsize )
+{
+    WCHAR *ret;
+    int len;
+
+    *wsize = 0;
+    if (!data) return NULL;
+    len = size ? MultiByteToWideChar( CP_ACP, 0, (const char *)data, size, NULL, 0 ) : 0;
+    if (!(ret = calloc( len + 2, sizeof(WCHAR) ))) return NULL;
+    if (len) MultiByteToWideChar( CP_ACP, 0, (const char *)data, size, ret, len );
+    *wsize = len * sizeof(WCHAR);
+    return ret;
+}
+
+/* an optional ANSI string argument: ok is cleared when it is there but cannot be converted */
+static WCHAR *opt_a2w( const char *str, BOOL *ok )
+{
+    WCHAR *ret = a2w( str );
+    if (str && !ret) *ok = FALSE;
+    return ret;
+}
+
