 DWORD __cdecl svcctl_QueryServiceConfigEx(
-    SC_RPC_HANDLE service,
+    SC_RPC_HANDLE hService,
     DWORD info_level,
     SC_RPC_CONFIG_INFOW *info)
 {
-    WINE_FIXME("\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    struct sc_service_handle *service;
+    struct service_trigger_list *list = NULL;
+    SERVICE_TRIGGER_INFO *ti;
+    DWORD err, size = 256, needed = 0, i, j;
+    BYTE *blob;
+
+    WINE_TRACE("(%p, %lu, %p)\n", hService, info_level, info);
+
+    /* the reply is marshalled even when the call fails: the union needs a valid arm */
+    info->dwInfoLevel = SERVICE_CONFIG_TRIGGER_INFO;
+    info->trigger = NULL;
+    if ((err = validate_service_handle(hService, SERVICE_QUERY_CONFIG, &service)) != 0)
+        return err;
+    /* the trigger information is the only level there is ([MS-SCMR] 3.1.4.48) */
+    if (info_level != SERVICE_CONFIG_TRIGGER_INFO) return ERROR_INVALID_LEVEL;
+
+    for (;;)
+    {
+        if (!(blob = malloc( size ))) return ERROR_NOT_ENOUGH_SERVER_MEMORY;
+        service_lock(service->service_entry);
+        err = query_service_triggers(service->service_entry, blob, size, &needed);
+        service_unlock(service->service_entry);
+        if (err != ERROR_INSUFFICIENT_BUFFER) break;
+        free( blob );
+        size = needed;
+    }
+    if (err) { free( blob ); return err; }
+
+    list = (struct service_trigger_list *)blob;
+    if (!(ti = calloc( 1, sizeof(*ti) )) || (list->count && !(ti->pTriggers = calloc( list->count, sizeof(*ti->pTriggers) ))))
+    {
+        free( ti );
+        free( blob );
+        return ERROR_NOT_ENOUGH_SERVER_MEMORY;
+    }
+    ti->cTriggers = list->count;
+    for (i = 0; i < list->count; i++)
+    {
+        const struct service_trigger *t = &list->triggers[i];
+        SERVICE_TRIGGER *out = &ti->pTriggers[i];
+        const struct service_trigger_data *items = (const struct service_trigger_data *)(blob + t->data_offset);
+
+        out->dwTriggerType = t->type;
+        out->dwAction = t->action;
+        if (t->subtype_offset && (out->pTriggerSubtype = malloc( sizeof(GUID) )))
+            memcpy( out->pTriggerSubtype, blob + t->subtype_offset, sizeof(GUID) );
+#ifdef SG_MUTANT_SVC_CFGEX
+        continue;
+#endif
+        if (!t->data_count || !(out->pDataItems = calloc( t->data_count, sizeof(*out->pDataItems) ))) continue;
+        out->cDataItems = t->data_count;
+        for (j = 0; j < t->data_count; j++)
+        {
+            out->pDataItems[j].dwDataType = items[j].data_type;
+            out->pDataItems[j].cbData = items[j].size;
+            if (items[j].size && (out->pDataItems[j].pData = malloc( items[j].size )))
+                memcpy( out->pDataItems[j].pData, blob + items[j].offset, items[j].size );
+        }
+    }
+    free( blob );
+    info->dwInfoLevel = SERVICE_CONFIG_TRIGGER_INFO;
+    info->trigger = ti;
+    return ERROR_SUCCESS;
 }
 
