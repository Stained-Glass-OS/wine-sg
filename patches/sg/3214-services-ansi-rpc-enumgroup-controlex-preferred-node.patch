+/* the ANSI name lookups: the wide function with room for any name
+ * ([MS-SCMR] limits it to 4096 characters), then the conversion; the length
+ * reported back is the ANSI one, without the terminating null */
+static DWORD name_lookup_a( SC_RPC_HANDLE manager, LPCSTR name, char *buffer, DWORD *cch,
+                            DWORD (__cdecl *lookup)( SC_RPC_HANDLE, LPCWSTR, WCHAR *, DWORD * ))
+{
+    WCHAR *wname = a2w( name ), *wbuf;
+    DWORD err, wcch = 4096, room = *cch;
+    int alen = 0;
+
+    if (!wname) return name ? ERROR_NOT_ENOUGH_SERVER_MEMORY : ERROR_INVALID_NAME;
+    if (!(wbuf = malloc( (wcch + 1) * sizeof(WCHAR) )))
+    {
+        free( wname );
+        return ERROR_NOT_ENOUGH_SERVER_MEMORY;
+    }
+    err = lookup( manager, wname, wbuf, &wcch );
+    if (!err)
+    {
+        alen = WideCharToMultiByte( CP_ACP, 0, wbuf, -1, NULL, 0, NULL, NULL ) - 1;
+        /* as for the wide functions, the buffer holds *cch characters and the null */
+#ifdef SG_MUTANT_SVC_DNAMEA
+        if ((DWORD)alen < room)
+#else
+        if ((DWORD)alen <= room)
+#endif
+            WideCharToMultiByte( CP_ACP, 0, wbuf, -1, buffer, alen + 1, NULL, NULL );
+        else err = ERROR_INSUFFICIENT_BUFFER;
+        *cch = alen;
+    }
+    else if (err == ERROR_INSUFFICIENT_BUFFER) *cch = wcch;
+    if (err) buffer[0] = 0;
+    free( wbuf );
+    free( wname );
+    return err;
 }
 
