+/* RControlServiceEx[AW]: the control, then the status of the service as the answer */
+static DWORD control_service_ex( SC_RPC_HANDLE handle, DWORD control, DWORD info_level, BOOL have_in,
+                                 DWORD reason, BOOL have_comment, PSERVICE_CONTROL_STATUS_REASON_OUT_PARAMS *out )
+{
+    struct sc_service_handle *service;
+    SERVICE_STATUS status;
+    DWORD err;
+
+    *out = NULL;
+    if (info_level != 1) return ERROR_INVALID_LEVEL;
+    if (!have_in) return ERROR_INVALID_PARAMETER;
+    /* only a stop carries a comment ([MS-SCMR] 3.1.4.47) */
+    if (control != SERVICE_CONTROL_STOP && have_comment) return ERROR_INVALID_PARAMETER;
+    if (!(*out = calloc( 1, sizeof(**out) ))) return ERROR_NOT_ENOUGH_SERVER_MEMORY;
+
+    WINE_TRACE("control %lu, reason %#lx\n", control, reason);
+    err = svcctl_ControlService( handle, control, &status );
+#ifndef SG_MUTANT_SVC_CTLEX
+    if (!validate_service_handle( handle, 0, &service ))
+#else
+    if (0)
+#endif
+    {
+        service_lock( service->service_entry );
+        fill_status_process( &(*out)->ServiceStatus, service->service_entry );
+        service_unlock( service->service_entry );
+    }
+    return err;
+}
