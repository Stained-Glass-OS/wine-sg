+/* The ANSI enumerations: the wide function's answer, converted.  Each entry
+ * starts with the offsets of its two strings (struct enum_service_status[_process]). */
+static DWORD enum_to_ansi( const BYTE *wbuf, DWORD count, DWORD esz, BYTE *out, DWORD size, DWORD *needed,
+                           DWORD *returned )
+{
+    DWORD i, total = count * esz, offset;
+    const DWORD *e;
+
+    *returned = 0;
+    for (i = 0; i < count; i++)
+    {
+        e = (const DWORD *)(wbuf + i * esz);
+        total += WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)(wbuf + e[0]), -1, NULL, 0, NULL, NULL );
+        if (e[1]) total += WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)(wbuf + e[1]), -1, NULL, 0, NULL, NULL );
+    }
+    *needed = total;
+    if (total > size) return ERROR_MORE_DATA;
+
+    offset = count * esz;
+    for (i = 0; i < count; i++)
+    {
+        DWORD *d = (DWORD *)(out + i * esz);
+
+        e = (const DWORD *)(wbuf + i * esz);
+        memcpy( d, e, esz );
+        d[0] = offset;
+        offset += WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)(wbuf + e[0]), -1, (char *)out + offset,
+                                       total - offset, NULL, NULL );
+        if (e[1])
+        {
+#ifndef SG_MUTANT_SVC_ENUMA
+            d[1] = offset;
+#endif
+            offset += WideCharToMultiByte( CP_ACP, 0, (const WCHAR *)(wbuf + e[1]), -1, (char *)out + offset,
+                                           total - offset, NULL, NULL );
+        }
+    }
+    *returned = count;
+    *needed = 0;
+    return ERROR_SUCCESS;
 }
 
