+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "uia_private.h"
+#include "ocidl.h"
+#include "servprov.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(uiautomation);
+
+struct uia_bridge
+{
+    IAccessible IAccessible_iface;
+    IServiceProvider IServiceProvider_iface;
+    IOleWindow IOleWindow_iface;
+    LONG ref;
+
+    IRawElementProviderSimple *elprov;
+    IRawElementProviderFragment *frag;
+    HWND hwnd;
+    BOOL is_root;
+};
+
+static HRESULT create_uia_bridge(IRawElementProviderSimple *elprov, HWND hwnd, BOOL is_root, IAccessible **out);
+
+static inline struct uia_bridge *impl_from_IAccessible(IAccessible *iface)
+{
+    return CONTAINING_RECORD(iface, struct uia_bridge, IAccessible_iface);
+}
+
+static HRESULT bridge_get_prop(struct uia_bridge *bridge, PROPERTYID id, VARIANT *v)
+{
+    VariantInit(v);
+    return IRawElementProviderSimple_GetPropertyValue(bridge->elprov, id, v);
+}
+
+static BOOL bridge_get_bool(struct uia_bridge *bridge, PROPERTYID id, BOOL def)
+{
+    VARIANT v;
+    BOOL ret = def;
+
+    if (SUCCEEDED(bridge_get_prop(bridge, id, &v)) && V_VT(&v) == VT_BOOL)
+        ret = V_BOOL(&v) == VARIANT_TRUE;
+    VariantClear(&v);
+    return ret;
+}
+
+static HRESULT bridge_get_bstr(struct uia_bridge *bridge, PROPERTYID id, BSTR *out)
+{
+    VARIANT v;
+
+    *out = NULL;
+    if (SUCCEEDED(bridge_get_prop(bridge, id, &v)) && V_VT(&v) == VT_BSTR && V_BSTR(&v) && *V_BSTR(&v))
+    {
+        *out = V_BSTR(&v);
+        return S_OK;
+    }
+    VariantClear(&v);
+    return S_FALSE;
+}
+
+static HRESULT bridge_get_pattern(struct uia_bridge *bridge, PATTERNID id, REFIID riid, void **out)
+{
+    IUnknown *unk = NULL;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = IRawElementProviderSimple_GetPatternProvider(bridge->elprov, id, &unk);
+    if (FAILED(hr) || !unk)
+        return E_NOINTERFACE;
+    hr = IUnknown_QueryInterface(unk, riid, out);
+    IUnknown_Release(unk);
+    return hr;
+}
+
+static BOOL bridge_check_self(VARIANT cid)
+{
+    return V_VT(&cid) == VT_I4 && V_I4(&cid) == CHILDID_SELF;
+}
+
+static HRESULT bridge_wrap_fragment(struct uia_bridge *bridge, IRawElementProviderFragment *frag, IDispatch **out)
+{
+    IRawElementProviderSimple *elprov;
+    IAccessible *acc;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = IRawElementProviderFragment_QueryInterface(frag, &IID_IRawElementProviderSimple, (void **)&elprov);
+    if (FAILED(hr))
+        return hr;
+    hr = create_uia_bridge(elprov, bridge->hwnd, FALSE, &acc);
+    IRawElementProviderSimple_Release(elprov);
+    if (SUCCEEDED(hr))
+        *out = (IDispatch *)acc;
+    return hr;
+}
+
+static HRESULT bridge_wrap_unknown(struct uia_bridge *bridge, IUnknown *unk, IDispatch **out)
+{
+    IRawElementProviderSimple *elprov;
+    IAccessible *acc;
+    HRESULT hr;
+
+    *out = NULL;
+    hr = IUnknown_QueryInterface(unk, &IID_IRawElementProviderSimple, (void **)&elprov);
+    if (FAILED(hr))
+        return hr;
+    hr = create_uia_bridge(elprov, bridge->hwnd, FALSE, &acc);
+    IRawElementProviderSimple_Release(elprov);
+    if (SUCCEEDED(hr))
+        *out = (IDispatch *)acc;
+    return hr;
+}
+
+/* the index-th child (1-based), or the number of children */
+static HRESULT bridge_child(struct uia_bridge *bridge, LONG index, LONG *count, IRawElementProviderFragment **out)
+{
+    IRawElementProviderFragment *cur = NULL, *next;
+    LONG n = 0;
+    HRESULT hr;
+
+    if (out) *out = NULL;
+    if (count) *count = 0;
+    if (!bridge->frag)
+        return S_OK;
+    hr = IRawElementProviderFragment_Navigate(bridge->frag, NavigateDirection_FirstChild, &cur);
+    while (SUCCEEDED(hr) && cur)
+    {
+        n++;
+        if (out && n == index)
+        {
+            *out = cur;
+            return S_OK;
+        }
+        next = NULL;
+        hr = IRawElementProviderFragment_Navigate(cur, NavigateDirection_NextSibling, &next);
+        IRawElementProviderFragment_Release(cur);
+        cur = next;
+        if (n > 100000) break;
+    }
+    if (count) *count = n;
+    return out ? E_INVALIDARG : S_OK;
+}
+
+static HRESULT WINAPI bridge_QueryInterface(IAccessible *iface, REFIID riid, void **obj)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IAccessible) || IsEqualIID(riid, &IID_IDispatch) || IsEqualIID(riid, &IID_IUnknown))
+        *obj = iface;
+    else if (IsEqualIID(riid, &IID_IServiceProvider))
+        *obj = &bridge->IServiceProvider_iface;
+    else if (IsEqualIID(riid, &IID_IOleWindow))
+        *obj = &bridge->IOleWindow_iface;
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IAccessible_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI bridge_AddRef(IAccessible *iface)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    return InterlockedIncrement(&bridge->ref);
+}
+
+static ULONG WINAPI bridge_Release(IAccessible *iface)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    ULONG ref = InterlockedDecrement(&bridge->ref);
+
+    if (!ref)
+    {
+        if (bridge->frag) IRawElementProviderFragment_Release(bridge->frag);
+        IRawElementProviderSimple_Release(bridge->elprov);
+        free(bridge);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI bridge_GetTypeInfoCount(IAccessible *iface, UINT *count)
+{
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_GetTypeInfo(IAccessible *iface, UINT index, LCID lcid, ITypeInfo **out)
+{
+    *out = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI bridge_GetIDsOfNames(IAccessible *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI bridge_Invoke(IAccessible *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI bridge_get_accParent(IAccessible *iface, IDispatch **out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IRawElementProviderFragment *parent = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, out);
+
+    *out = NULL;
+    if (!bridge->is_root && bridge->frag &&
+        SUCCEEDED(IRawElementProviderFragment_Navigate(bridge->frag, NavigateDirection_Parent, &parent)) && parent)
+    {
+        hr = bridge_wrap_fragment(bridge, parent, out);
+        IRawElementProviderFragment_Release(parent);
+        return hr;
+    }
+    /* the root's parent is its window */
+    if (bridge->hwnd)
+        return AccessibleObjectFromWindow(bridge->hwnd, OBJID_WINDOW, &IID_IDispatch, (void **)out);
+    return S_FALSE;
+}
+
+static HRESULT WINAPI bridge_get_accChildCount(IAccessible *iface, LONG *count)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+
+    TRACE("%p, %p\n", iface, count);
+
+    return bridge_child(bridge, 0, count, NULL);
+}
+
+static HRESULT WINAPI bridge_get_accChild(IAccessible *iface, VARIANT cid, IDispatch **out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IRawElementProviderFragment *child;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (V_VT(&cid) != VT_I4 || V_I4(&cid) <= 0)
+        return E_INVALIDARG;
+    if (FAILED(hr = bridge_child(bridge, V_I4(&cid), NULL, &child)))
+        return hr;
+    hr = bridge_wrap_fragment(bridge, child, out);
+    IRawElementProviderFragment_Release(child);
+    return hr;
+}
+
+static HRESULT WINAPI bridge_get_accName(IAccessible *iface, VARIANT cid, BSTR *out)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    return bridge_get_bstr(impl_from_IAccessible(iface), UIA_NamePropertyId, out);
+}
+
+static HRESULT WINAPI bridge_get_accValue(IAccessible *iface, VARIANT cid, BSTR *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IRangeValueProvider *range;
+    IValueProvider *value;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_ValuePatternId, &IID_IValueProvider, (void **)&value)))
+    {
+        hr = IValueProvider_get_Value(value, out);
+        IValueProvider_Release(value);
+        return FAILED(hr) ? hr : (*out ? S_OK : S_FALSE);
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_RangeValuePatternId, &IID_IRangeValueProvider, (void **)&range)))
+    {
+        double val = 0;
+        WCHAR buf[64];
+
+        hr = IRangeValueProvider_get_Value(range, &val);
+        IRangeValueProvider_Release(range);
+        if (FAILED(hr)) return hr;
+        swprintf(buf, ARRAY_SIZE(buf), L"%g", val);
+        *out = SysAllocString(buf);
+        return S_OK;
+    }
+    return S_FALSE;
+}
+
+static HRESULT WINAPI bridge_get_accDescription(IAccessible *iface, VARIANT cid, BSTR *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (bridge_get_bstr(bridge, UIA_FullDescriptionPropertyId, out) == S_OK) return S_OK;
+    return bridge_get_bstr(bridge, UIA_ItemStatusPropertyId, out);
+}
+
+static const struct { CONTROLTYPEID type; LONG role; } control_type_roles[] =
+{
+    { UIA_ButtonControlTypeId,       ROLE_SYSTEM_PUSHBUTTON },
+    { UIA_CalendarControlTypeId,     ROLE_SYSTEM_CLIENT },
+    { UIA_CheckBoxControlTypeId,     ROLE_SYSTEM_CHECKBUTTON },
+    { UIA_ComboBoxControlTypeId,     ROLE_SYSTEM_COMBOBOX },
+    { UIA_EditControlTypeId,         ROLE_SYSTEM_TEXT },
+    { UIA_HyperlinkControlTypeId,    ROLE_SYSTEM_LINK },
+    { UIA_ImageControlTypeId,        ROLE_SYSTEM_GRAPHIC },
+    { UIA_ListItemControlTypeId,     ROLE_SYSTEM_LISTITEM },
+    { UIA_ListControlTypeId,         ROLE_SYSTEM_LIST },
+    { UIA_MenuControlTypeId,         ROLE_SYSTEM_MENUPOPUP },
+    { UIA_MenuBarControlTypeId,      ROLE_SYSTEM_MENUBAR },
+    { UIA_MenuItemControlTypeId,     ROLE_SYSTEM_MENUITEM },
+    { UIA_ProgressBarControlTypeId,  ROLE_SYSTEM_PROGRESSBAR },
+    { UIA_RadioButtonControlTypeId,  ROLE_SYSTEM_RADIOBUTTON },
+    { UIA_ScrollBarControlTypeId,    ROLE_SYSTEM_SCROLLBAR },
+    { UIA_SliderControlTypeId,       ROLE_SYSTEM_SLIDER },
+    { UIA_SpinnerControlTypeId,      ROLE_SYSTEM_SPINBUTTON },
+    { UIA_StatusBarControlTypeId,    ROLE_SYSTEM_STATUSBAR },
+    { UIA_TabControlTypeId,          ROLE_SYSTEM_PAGETABLIST },
+    { UIA_TabItemControlTypeId,      ROLE_SYSTEM_PAGETAB },
+    { UIA_TextControlTypeId,         ROLE_SYSTEM_STATICTEXT },
+    { UIA_ToolBarControlTypeId,      ROLE_SYSTEM_TOOLBAR },
+    { UIA_ToolTipControlTypeId,      ROLE_SYSTEM_TOOLTIP },
+    { UIA_TreeControlTypeId,         ROLE_SYSTEM_OUTLINE },
+    { UIA_TreeItemControlTypeId,     ROLE_SYSTEM_OUTLINEITEM },
+    { UIA_CustomControlTypeId,       ROLE_SYSTEM_CLIENT },
+    { UIA_GroupControlTypeId,        ROLE_SYSTEM_GROUPING },
+    { UIA_ThumbControlTypeId,        ROLE_SYSTEM_INDICATOR },
+    { UIA_DataGridControlTypeId,     ROLE_SYSTEM_TABLE },
+    { UIA_DataItemControlTypeId,     ROLE_SYSTEM_LISTITEM },
+    { UIA_DocumentControlTypeId,     ROLE_SYSTEM_DOCUMENT },
+    { UIA_SplitButtonControlTypeId,  ROLE_SYSTEM_SPLITBUTTON },
+    { UIA_WindowControlTypeId,       ROLE_SYSTEM_WINDOW },
+    { UIA_PaneControlTypeId,         ROLE_SYSTEM_PANE },
+    { UIA_HeaderControlTypeId,       ROLE_SYSTEM_LIST },
+    { UIA_HeaderItemControlTypeId,   ROLE_SYSTEM_COLUMNHEADER },
+    { UIA_TableControlTypeId,        ROLE_SYSTEM_TABLE },
+    { UIA_TitleBarControlTypeId,     ROLE_SYSTEM_TITLEBAR },
+    { UIA_SeparatorControlTypeId,    ROLE_SYSTEM_SEPARATOR },
+    { UIA_SemanticZoomControlTypeId, ROLE_SYSTEM_LIST },
+    { UIA_AppBarControlTypeId,       ROLE_SYSTEM_TOOLBAR },
+};
+
+static HRESULT WINAPI bridge_get_accRole(IAccessible *iface, VARIANT cid, VARIANT *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    LONG role = ROLE_SYSTEM_CLIENT;
+    unsigned int i;
+    VARIANT v;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    VariantInit(out);
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (SUCCEEDED(bridge_get_prop(bridge, UIA_ControlTypePropertyId, &v)) && V_VT(&v) == VT_I4)
+    {
+        for (i = 0; i < ARRAY_SIZE(control_type_roles); i++)
+            if (control_type_roles[i].type == V_I4(&v)) role = control_type_roles[i].role;
+    }
+    VariantClear(&v);
+    V_VT(out) = VT_I4;
+    V_I4(out) = role;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_get_accState(IAccessible *iface, VARIANT cid, VARIANT *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    ISelectionItemProvider *sel_item;
+    IExpandCollapseProvider *expand;
+    IToggleProvider *toggle;
+    IValueProvider *value;
+    LONG state = 0;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    VariantInit(out);
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (!bridge_get_bool(bridge, UIA_IsEnabledPropertyId, TRUE)) state |= STATE_SYSTEM_UNAVAILABLE;
+    if (bridge_get_bool(bridge, UIA_IsKeyboardFocusablePropertyId, FALSE)) state |= STATE_SYSTEM_FOCUSABLE;
+    if (bridge_get_bool(bridge, UIA_HasKeyboardFocusPropertyId, FALSE)) state |= STATE_SYSTEM_FOCUSED;
+    if (bridge_get_bool(bridge, UIA_IsOffscreenPropertyId, FALSE)) state |= STATE_SYSTEM_OFFSCREEN;
+    if (bridge_get_bool(bridge, UIA_IsPasswordPropertyId, FALSE)) state |= STATE_SYSTEM_PROTECTED;
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_TogglePatternId, &IID_IToggleProvider, (void **)&toggle)))
+    {
+        enum ToggleState ts = ToggleState_Off;
+        IToggleProvider_get_ToggleState(toggle, &ts);
+        if (ts == ToggleState_On) state |= STATE_SYSTEM_CHECKED;
+        else if (ts == ToggleState_Indeterminate) state |= STATE_SYSTEM_MIXED;
+        IToggleProvider_Release(toggle);
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_SelectionItemPatternId, &IID_ISelectionItemProvider, (void **)&sel_item)))
+    {
+        BOOL selected = FALSE;
+        state |= STATE_SYSTEM_SELECTABLE;
+        ISelectionItemProvider_get_IsSelected(sel_item, &selected);
+        if (selected) state |= STATE_SYSTEM_SELECTED;
+        ISelectionItemProvider_Release(sel_item);
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_ExpandCollapsePatternId, &IID_IExpandCollapseProvider, (void **)&expand)))
+    {
+        enum ExpandCollapseState es = ExpandCollapseState_LeafNode;
+        IExpandCollapseProvider_get_ExpandCollapseState(expand, &es);
+        if (es == ExpandCollapseState_Expanded || es == ExpandCollapseState_PartiallyExpanded) state |= STATE_SYSTEM_EXPANDED;
+        else if (es == ExpandCollapseState_Collapsed) state |= STATE_SYSTEM_COLLAPSED;
+        IExpandCollapseProvider_Release(expand);
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_ValuePatternId, &IID_IValueProvider, (void **)&value)))
+    {
+        BOOL ro = FALSE;
+        IValueProvider_get_IsReadOnly(value, &ro);
+        if (ro) state |= STATE_SYSTEM_READONLY;
+        IValueProvider_Release(value);
+    }
+    V_VT(out) = VT_I4;
+    V_I4(out) = state;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_get_accHelp(IAccessible *iface, VARIANT cid, BSTR *out)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    return bridge_get_bstr(impl_from_IAccessible(iface), UIA_HelpTextPropertyId, out);
+}
+
+static HRESULT WINAPI bridge_get_accHelpTopic(IAccessible *iface, BSTR *file, VARIANT cid, LONG *topic)
+{
+    *file = NULL;
+    *topic = 0;
+    return S_FALSE;
+}
+
+static HRESULT WINAPI bridge_get_accKeyboardShortcut(IAccessible *iface, VARIANT cid, BSTR *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (bridge_get_bstr(bridge, UIA_AccessKeyPropertyId, out) == S_OK) return S_OK;
+    return bridge_get_bstr(bridge, UIA_AcceleratorKeyPropertyId, out);
+}
+
+/* an element of ours as a VARIANT: CHILDID_SELF when it is this one */
+static HRESULT bridge_variant_from_fragment(struct uia_bridge *bridge, IRawElementProviderFragment *frag, VARIANT *out)
+{
+    IRawElementProviderSimple *elprov;
+    IDispatch *disp;
+    HRESULT hr;
+
+    VariantInit(out);
+    if (SUCCEEDED(IRawElementProviderFragment_QueryInterface(frag, &IID_IRawElementProviderSimple, (void **)&elprov)))
+    {
+        BOOL self = elprov == bridge->elprov;
+        IRawElementProviderSimple_Release(elprov);
+        if (self)
+        {
+            V_VT(out) = VT_I4;
+            V_I4(out) = CHILDID_SELF;
+            return S_OK;
+        }
+    }
+    if (FAILED(hr = bridge_wrap_fragment(bridge, frag, &disp)))
+        return hr;
+    V_VT(out) = VT_DISPATCH;
+    V_DISPATCH(out) = disp;
+    return S_OK;
+}
+
+static HRESULT bridge_get_root(struct uia_bridge *bridge, IRawElementProviderFragmentRoot **root)
+{
+    *root = NULL;
+    if (!bridge->frag) return E_NOINTERFACE;
+    if (SUCCEEDED(IRawElementProviderSimple_QueryInterface(bridge->elprov, &IID_IRawElementProviderFragmentRoot,
+            (void **)root)))
+        return S_OK;
+    return IRawElementProviderFragment_get_FragmentRoot(bridge->frag, root);
+}
+
+static HRESULT WINAPI bridge_get_accFocus(IAccessible *iface, VARIANT *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IRawElementProviderFragmentRoot *root;
+    IRawElementProviderFragment *focus = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, out);
+
+    VariantInit(out);
+    if (bridge_get_bool(bridge, UIA_HasKeyboardFocusPropertyId, FALSE))
+    {
+        V_VT(out) = VT_I4;
+        V_I4(out) = CHILDID_SELF;
+        return S_OK;
+    }
+    if (FAILED(bridge_get_root(bridge, &root)) || !root)
+        return S_FALSE;
+    hr = IRawElementProviderFragmentRoot_GetFocus(root, &focus);
+    IRawElementProviderFragmentRoot_Release(root);
+    if (FAILED(hr) || !focus)
+        return S_FALSE;
+    hr = bridge_variant_from_fragment(bridge, focus, out);
+    IRawElementProviderFragment_Release(focus);
+    return hr;
+}
