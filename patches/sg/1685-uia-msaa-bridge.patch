+static HRESULT create_uia_bridge(IRawElementProviderSimple *elprov, HWND hwnd, BOOL is_root, IAccessible **out)
+{
+    struct uia_bridge *bridge;
+
+    *out = NULL;
+    if (!(bridge = calloc(1, sizeof(*bridge))))
+        return E_OUTOFMEMORY;
+    bridge->IAccessible_iface.lpVtbl = &bridge_vtbl;
+    bridge->IServiceProvider_iface.lpVtbl = &bridge_sp_vtbl;
+    bridge->IOleWindow_iface.lpVtbl = &bridge_ow_vtbl;
+    bridge->ref = 1;
+    bridge->elprov = elprov;
+    IRawElementProviderSimple_AddRef(elprov);
+    if (FAILED(IRawElementProviderSimple_QueryInterface(elprov, &IID_IRawElementProviderFragment, (void **)&bridge->frag)))
+        bridge->frag = NULL;
+    bridge->hwnd = hwnd;
+    bridge->is_root = is_root;
+    *out = &bridge->IAccessible_iface;
+    return S_OK;
+}
