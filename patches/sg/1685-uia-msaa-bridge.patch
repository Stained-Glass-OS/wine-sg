+/* IEnumVARIANT over a selection */
+struct bridge_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    VARIANT *items;
+    ULONG count, pos;
+};
+
+static inline struct bridge_enum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct bridge_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI bridge_enum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IEnumVARIANT) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI bridge_enum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI bridge_enum_Release(IEnumVARIANT *iface)
+{
+    struct bridge_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&e->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < e->count; i++) VariantClear(&e->items[i]);
+        free(e->items);
+        free(e);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI bridge_enum_Next(IEnumVARIANT *iface, ULONG count, VARIANT *out, ULONG *fetched)
+{
+    struct bridge_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG i;
+
+    for (i = 0; i < count && e->pos < e->count; i++, e->pos++)
+    {
+        VariantInit(&out[i]);
+        VariantCopy(&out[i], &e->items[e->pos]);
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI bridge_enum_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct bridge_enum *e = impl_from_IEnumVARIANT(iface);
+
+    if (e->pos + count > e->count)
+    {
+        e->pos = e->count;
+        return S_FALSE;
+    }
+    e->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_enum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    *out = NULL;
+    return E_NOTIMPL;
+}
+
+static const IEnumVARIANTVtbl bridge_enum_vtbl = {
+    bridge_enum_QueryInterface, bridge_enum_AddRef, bridge_enum_Release,
+    bridge_enum_Next, bridge_enum_Skip, bridge_enum_Reset, bridge_enum_Clone,
+};
+
+static HRESULT WINAPI bridge_get_accSelection(IAccessible *iface, VARIANT *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    ISelectionProvider *sel;
+    struct bridge_enum *e;
+    SAFEARRAY *sa = NULL;
+    LONG lbound, elems, i;
+    IDispatch *disp;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, out);
+
+    VariantInit(out);
+    if (FAILED(bridge_get_pattern(bridge, UIA_SelectionPatternId, &IID_ISelectionProvider, (void **)&sel)))
+        return S_FALSE;
+    hr = ISelectionProvider_GetSelection(sel, &sa);
+    ISelectionProvider_Release(sel);
+    if (FAILED(hr) || !sa)
+        return S_FALSE;
+    if (FAILED(get_safearray_bounds(sa, &lbound, &elems)) || !elems)
+    {
+        SafeArrayDestroy(sa);
+        return S_FALSE;
+    }
+    if (!(e = calloc(1, sizeof(*e))) || !(e->items = calloc(elems, sizeof(VARIANT))))
+    {
+        free(e);
+        SafeArrayDestroy(sa);
+        return E_OUTOFMEMORY;
+    }
+    e->IEnumVARIANT_iface.lpVtbl = &bridge_enum_vtbl;
+    e->ref = 1;
+    for (i = 0; i < elems; i++)
+    {
+        LONG idx = lbound + i;
+        IUnknown *unk = NULL;
+
+        SafeArrayGetElement(sa, &idx, &unk);
+        if (unk && SUCCEEDED(bridge_wrap_unknown(bridge, unk, &disp)))
+        {
+            V_VT(&e->items[e->count]) = VT_DISPATCH;
+            V_DISPATCH(&e->items[e->count]) = disp;
+            e->count++;
+        }
+        if (unk) IUnknown_Release(unk);
+    }
+    SafeArrayDestroy(sa);
+    if (e->count == 1)
+    {
+        /* one selected object: itself */
+        *out = e->items[0];
+        e->count = 0;
+        IEnumVARIANT_Release(&e->IEnumVARIANT_iface);
+        return S_OK;
+    }
+    if (!e->count)
+    {
+        IEnumVARIANT_Release(&e->IEnumVARIANT_iface);
+        return S_FALSE;
+    }
+    V_VT(out) = VT_UNKNOWN;
+    V_UNKNOWN(out) = (IUnknown *)&e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_get_accDefaultAction(IAccessible *iface, VARIANT cid, BSTR *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IUnknown *unk;
+
+    TRACE("%p, %s, %p\n", iface, debugstr_variant(&cid), out);
+
+    *out = NULL;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_InvokePatternId, &IID_IInvokeProvider, (void **)&unk)))
+        *out = SysAllocString(L"Press");
+    else if (SUCCEEDED(bridge_get_pattern(bridge, UIA_TogglePatternId, &IID_IToggleProvider, (void **)&unk)))
+        *out = SysAllocString(L"Toggle");
+    else if (SUCCEEDED(bridge_get_pattern(bridge, UIA_ExpandCollapsePatternId, &IID_IExpandCollapseProvider, (void **)&unk)))
+    {
+        enum ExpandCollapseState es = ExpandCollapseState_Collapsed;
+        IExpandCollapseProvider_get_ExpandCollapseState((IExpandCollapseProvider *)unk, &es);
+        *out = SysAllocString(es == ExpandCollapseState_Expanded ? L"Collapse" : L"Expand");
+    }
+    else if (SUCCEEDED(bridge_get_pattern(bridge, UIA_SelectionItemPatternId, &IID_ISelectionItemProvider, (void **)&unk)))
+        *out = SysAllocString(L"Select");
+    else
+        return S_FALSE;
+    IUnknown_Release(unk);
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_accSelect(IAccessible *iface, LONG flags, VARIANT cid)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    ISelectionItemProvider *sel_item = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %#lx, %s\n", iface, flags, debugstr_variant(&cid));
+
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if ((flags & SELFLAG_TAKEFOCUS) && bridge->frag)
+        hr = IRawElementProviderFragment_SetFocus(bridge->frag);
+    if (FAILED(hr)) return hr;
+    if (!(flags & (SELFLAG_TAKESELECTION | SELFLAG_ADDSELECTION | SELFLAG_REMOVESELECTION)))
+        return S_OK;
+    if (FAILED(bridge_get_pattern(bridge, UIA_SelectionItemPatternId, &IID_ISelectionItemProvider, (void **)&sel_item)))
+        return DISP_E_MEMBERNOTFOUND;
+    if (flags & SELFLAG_TAKESELECTION) hr = ISelectionItemProvider_Select(sel_item);
+    else if (flags & SELFLAG_ADDSELECTION) hr = ISelectionItemProvider_AddToSelection(sel_item);
+    else hr = ISelectionItemProvider_RemoveFromSelection(sel_item);
+    ISelectionItemProvider_Release(sel_item);
+    return hr;
+}
+
+static HRESULT WINAPI bridge_accLocation(IAccessible *iface, LONG *left, LONG *top, LONG *width, LONG *height,
+        VARIANT cid)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    struct UiaRect rect = { 0 };
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p, %p, %s\n", iface, left, top, width, height, debugstr_variant(&cid));
+
+    *left = *top = *width = *height = 0;
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+    if (bridge->frag)
+    {
+        if (FAILED(hr = IRawElementProviderFragment_get_BoundingRectangle(bridge->frag, &rect)))
+            return hr;
+    }
+    if ((!rect.width || !rect.height) && bridge->is_root && bridge->hwnd)
+    {
+        RECT rc;
+        POINT pt = { 0, 0 };
+
+        GetClientRect(bridge->hwnd, &rc);
+        ClientToScreen(bridge->hwnd, &pt);
+        rect.left = pt.x;
+        rect.top = pt.y;
+        rect.width = rc.right;
+        rect.height = rc.bottom;
+    }
+    *left = rect.left;
+    *top = rect.top;
+    *width = rect.width;
+    *height = rect.height;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_accNavigate(IAccessible *iface, LONG dir, VARIANT start, VARIANT *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IRawElementProviderFragment *frag = NULL;
+    enum NavigateDirection uia_dir;
+    HRESULT hr;
+
+    TRACE("%p, %ld, %s, %p\n", iface, dir, debugstr_variant(&start), out);
+
+    VariantInit(out);
+    if (!bridge_check_self(start)) return E_INVALIDARG;
+    switch (dir)
+    {
+    case NAVDIR_FIRSTCHILD: uia_dir = NavigateDirection_FirstChild; break;
+    case NAVDIR_LASTCHILD:  uia_dir = NavigateDirection_LastChild; break;
+    case NAVDIR_NEXT:       uia_dir = NavigateDirection_NextSibling; break;
+    case NAVDIR_PREVIOUS:   uia_dir = NavigateDirection_PreviousSibling; break;
+    default:
+        /* spatial directions: not kept by the provider */
+        return S_FALSE;
+    }
+    if (!bridge->frag || (bridge->is_root && (dir == NAVDIR_NEXT || dir == NAVDIR_PREVIOUS)))
+        return S_FALSE;
+    hr = IRawElementProviderFragment_Navigate(bridge->frag, uia_dir, &frag);
+    if (FAILED(hr) || !frag)
+        return S_FALSE;
+    V_VT(out) = VT_DISPATCH;
+    hr = bridge_wrap_fragment(bridge, frag, &V_DISPATCH(out));
+    if (FAILED(hr)) V_VT(out) = VT_EMPTY;
+    IRawElementProviderFragment_Release(frag);
+    return hr;
+}
+
+static HRESULT WINAPI bridge_accHitTest(IAccessible *iface, LONG x, LONG y, VARIANT *out)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    IRawElementProviderFragmentRoot *root;
+    IRawElementProviderFragment *frag = NULL;
+    LONG left, top, width, height;
+    VARIANT self;
+    HRESULT hr;
+
+    TRACE("%p, %ld, %ld, %p\n", iface, x, y, out);
+
+    VariantInit(out);
+    V_VT(&self) = VT_I4;
+    V_I4(&self) = CHILDID_SELF;
+    if (FAILED(bridge_accLocation(iface, &left, &top, &width, &height, self)) ||
+        x < left || y < top || x >= left + width || y >= top + height)
+        return S_FALSE;
+    if (SUCCEEDED(bridge_get_root(bridge, &root)) && root)
+    {
+        hr = IRawElementProviderFragmentRoot_ElementProviderFromPoint(root, x, y, &frag);
+        IRawElementProviderFragmentRoot_Release(root);
+        if (SUCCEEDED(hr) && frag)
+        {
+            hr = bridge_variant_from_fragment(bridge, frag, out);
+            IRawElementProviderFragment_Release(frag);
+            return hr;
+        }
+    }
+    V_VT(out) = VT_I4;
+    V_I4(out) = CHILDID_SELF;
+    return S_OK;
+}
+
+static HRESULT WINAPI bridge_accDoDefaultAction(IAccessible *iface, VARIANT cid)
+{
+    struct uia_bridge *bridge = impl_from_IAccessible(iface);
+    ISelectionItemProvider *sel_item;
+    IExpandCollapseProvider *expand;
+    IInvokeProvider *invoke;
+    IToggleProvider *toggle;
+    HRESULT hr;
+
+    TRACE("%p, %s\n", iface, debugstr_variant(&cid));
+
+    if (!bridge_check_self(cid)) return E_INVALIDARG;
+#ifdef SG_MUTANT_NO_BRIDGE_ACTION
+    return S_OK;
+#endif
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_InvokePatternId, &IID_IInvokeProvider, (void **)&invoke)))
+    {
+        hr = IInvokeProvider_Invoke(invoke);
+        IInvokeProvider_Release(invoke);
+        return hr;
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_TogglePatternId, &IID_IToggleProvider, (void **)&toggle)))
+    {
+        hr = IToggleProvider_Toggle(toggle);
+        IToggleProvider_Release(toggle);
+        return hr;
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_ExpandCollapsePatternId, &IID_IExpandCollapseProvider, (void **)&expand)))
+    {
+        enum ExpandCollapseState es = ExpandCollapseState_Collapsed;
+        IExpandCollapseProvider_get_ExpandCollapseState(expand, &es);
+        hr = es == ExpandCollapseState_Expanded ? IExpandCollapseProvider_Collapse(expand)
+                                                : IExpandCollapseProvider_Expand(expand);
+        IExpandCollapseProvider_Release(expand);
+        return hr;
+    }
+    if (SUCCEEDED(bridge_get_pattern(bridge, UIA_SelectionItemPatternId, &IID_ISelectionItemProvider, (void **)&sel_item)))
+    {
+        hr = ISelectionItemProvider_Select(sel_item);
+        ISelectionItemProvider_Release(sel_item);
+        return hr;
+    }
+    return DISP_E_MEMBERNOTFOUND;
+}
