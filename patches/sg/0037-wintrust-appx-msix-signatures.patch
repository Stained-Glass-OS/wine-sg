+/* The SIP an SpcSipInfo names: SEQUENCE { INTEGER version, OCTET STRING(16) guid, ... }. */
+static BOOL SOFTPUB_SipInfoGuid(const CRYPT_ATTRIBUTE_TYPE_VALUE *data, GUID *guid)
+{
+    const BYTE *p = data->Value.pbData, *end = p + data->Value.cbData;
+    DWORD len;
+
+    if (((ULONG_PTR)data->pszObjId >> 16) == 0 || strcmp(data->pszObjId, SPC_SIGINFO_OBJID)) return FALSE;
+    if (end - p < 2 || p[0] != 0x30) return FALSE;
+    if (p[1] & 0x80)
+    {
+        DWORD n = p[1] & 0x7f, i;
+        if (n > 2 || end - p < 2 + n) return FALSE;
+        for (len = 0, i = 0; i < n; i++) len = (len << 8) | p[2 + i];
+        p += 2 + n;
+    }
+    else { len = p[1]; p += 2; }
+    if (len > end - p) return FALSE;
+    end = p + len;
+    if (end - p < 2 || p[0] != 0x02 || p[1] > end - p - 2) return FALSE;   /* INTEGER */
+    p += 2 + p[1];
+    if (end - p < 18 || p[0] != 0x04 || p[1] != 16) return FALSE;         /* OCTET STRING(16) */
+    memcpy(guid, p + 2, sizeof(*guid));
+    return TRUE;
+}
