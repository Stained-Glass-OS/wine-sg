From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: Forward all four control interfaces and fix GetPreferredAspectRatio and Step.

The filter graph forwards IBasicAudio, IBasicVideo, IBasicVideo2 and
IVideoWindow to the filter that has them, caching one entry per interface,
but the cache held three: whichever of the four was asked for last failed
with E_OUTOFMEMORY. It now holds four. IBasicVideo2::GetPreferredAspectRatio
called itself instead of the filter's method and never returned.
IVideoFrameStep::Step with no filter that can step returns
VFW_E_FRAME_STEP_UNSUPPORTED, the error the documentation lists, instead of
E_NOTIMPL.

Gate: test/quartz-graph-forward-gate.sh (64/32).
---
 dlls/quartz/filtergraph.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/dlls/quartz/filtergraph.c b/dlls/quartz/filtergraph.c
index 0a477ad..658b9eb 100644
--- a/dlls/quartz/filtergraph.c
+++ b/dlls/quartz/filtergraph.c
@@ -62,7 +62,13 @@ struct media_event
     LONG_PTR param1, param2;
 };
 
+/* one entry for each interface the graph forwards: IBasicAudio, IBasicVideo,
+ * IBasicVideo2 and IVideoWindow */
+#ifdef SG_MUTANT_ITF_CACHE_3
 #define MAX_ITF_CACHE_ENTRIES 3
+#else
+#define MAX_ITF_CACHE_ENTRIES 4
+#endif
 typedef struct _ITF_CACHE_ENTRY {
    const IID* riid;
    IBaseFilter* filter;
@@ -3097,7 +3103,7 @@ static HRESULT GetTargetInterface(struct filter_graph* pGraph, REFIID riid, LPVO
 
     if (entry >= MAX_ITF_CACHE_ENTRIES)
     {
-        FIXME("Not enough space to store interface in the cache\n");
+        ERR("Not enough space to store interface %s in the cache.\n", debugstr_guid(riid));
         return E_OUTOFMEMORY;
     }
 
@@ -4022,7 +4028,7 @@ static HRESULT WINAPI BasicVideo2_GetPreferredAspectRatio(IBasicVideo2 *iface, L
     hr = GetTargetInterface(This, &IID_IBasicVideo2, (LPVOID*)&pBasicVideo2);
 
     if (hr == S_OK)
-        hr = BasicVideo2_GetPreferredAspectRatio(iface, plAspectX, plAspectY);
+        hr = IBasicVideo2_GetPreferredAspectRatio(pBasicVideo2, plAspectX, plAspectY);
 
     LeaveCriticalSection(&This->cs);
 
@@ -6323,7 +6329,11 @@ static HRESULT WINAPI VideoFrameStep_Step(IVideoFrameStep *iface, DWORD frame_co
     TRACE("graph %p, frame_count %lu, object %p.\n", graph, frame_count, object);
 
     if (!(step = get_frame_stepper(graph, object)))
+#ifdef SG_MUTANT_STEP_NOTIMPL
         return E_NOTIMPL;
+#else
+        return VFW_E_FRAME_STEP_UNSUPPORTED;
+#endif
     hr = IVideoFrameStep_Step(step, frame_count, NULL);
     IVideoFrameStep_Release(step);
     return hr;
