From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntdll: MemoryRegionInformation for other processes (patch 5103)

Take the region of another process from its basic memory information;
gap-CORE item 443. Gate with a mutant.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -5288,13 +5288,11 @@
     if (len < FIELD_OFFSET(MEMORY_REGION_INFORMATION, CommitSize))
         return STATUS_INFO_LENGTH_MISMATCH;
 
-    if (process != NtCurrentProcess())
-    {
-        FIXME("Unimplemented for other processes.\n");
-        return STATUS_NOT_IMPLEMENTED;
-    }
-
-    if ((status = fill_basic_memory_info( addr, &basic_info ))) return status;
+    /* another process answers the same question the basic information asks, through its APC */
+#ifdef SG_MUTANT_REGION_LOCAL_ONLY
+    if (process != NtCurrentProcess()) return STATUS_NOT_IMPLEMENTED;
+#endif
+    if ((status = get_basic_memory_info( process, addr, &basic_info, sizeof(basic_info), NULL ))) return status;
 
     info->AllocationBase = basic_info.AllocationBase;
     info->AllocationProtect = basic_info.AllocationProtect;
-- 
