From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] gdi32: UpdateICMRegKey add, query and delete

UpdateICMRegKeyA/W install, query and remove a colour profile through the
colour profile store and refuse the commands it can not do (partial). CORE:
integrator must review (patches/notes/5223.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/gdi32/icm.c b/dlls/gdi32/icm.c
--- a/dlls/gdi32/icm.c
+++ b/dlls/gdi32/icm.c
@@ -233,22 +233,119 @@
     return NtGdiSetIcmProfile( hdc, filename );
 }
 
+/* Stained Glass OS: the obsolete UpdateICMRegKey.  The profile commands go through the colour
+ * profile store of mscms (InstallColorProfileW, UninstallColorProfileW, the colour directory);
+ * the other commands (default profile, CMM registration, DEVMODE query) are not supported. */
+#define SG_ICM_ADDPROFILE      1
+#define SG_ICM_DELETEPROFILE   2
+#define SG_ICM_QUERYPROFILE    3
+#define SG_ICM_SETDEFAULTPROFILE 4
+#define SG_ICM_REGISTERICMATCHER 5
+#define SG_ICM_UNREGISTERICMATCHER 6
+#define SG_ICM_QUERYMATCH      7
+
 /**********************************************************************
- *           UpdateICMRegKeyA       (GDI32.@)
+ *           UpdateICMRegKeyW       (GDI32.@)
  */
-BOOL WINAPI UpdateICMRegKeyA(DWORD reserved, LPSTR cmid, LPSTR filename, UINT command)
+BOOL WINAPI UpdateICMRegKeyW(DWORD reserved, LPWSTR cmid, LPWSTR filename, UINT command)
 {
-    FIXME("0x%08lx, %s, %s, 0x%08x stub\n", reserved, debugstr_a(cmid), debugstr_a(filename), command);
-    return TRUE;
+    BOOL (WINAPI *pInstallColorProfileW)( const WCHAR *, const WCHAR * );
+    BOOL (WINAPI *pUninstallColorProfileW)( const WCHAR *, const WCHAR *, BOOL );
+    BOOL (WINAPI *pGetColorDirectoryW)( const WCHAR *, WCHAR *, DWORD * );
+    HMODULE mscms;
+    BOOL ret = FALSE;
+
+    TRACE( "0x%08lx, %s, %s, 0x%08x\n", reserved, debugstr_w(cmid), debugstr_w(filename), command );
+
+    if (reserved || !filename)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    switch (command)
+    {
+    case SG_ICM_ADDPROFILE:
+    case SG_ICM_DELETEPROFILE:
+    case SG_ICM_QUERYPROFILE:
+        break;
+    default:
+        FIXME( "command %u not supported\n", command );
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+
+    if (!(mscms = LoadLibraryW( L"mscms.dll" ))) return FALSE;
+    pInstallColorProfileW = (void *)GetProcAddress( mscms, "InstallColorProfileW" );
+    pUninstallColorProfileW = (void *)GetProcAddress( mscms, "UninstallColorProfileW" );
+    pGetColorDirectoryW = (void *)GetProcAddress( mscms, "GetColorDirectoryW" );
+    if (pInstallColorProfileW && pUninstallColorProfileW && pGetColorDirectoryW)
+    {
+        switch (command)
+        {
+        case SG_ICM_ADDPROFILE:
+#ifdef SG_MUTANT_ICMREG_ADD
+            ret = TRUE;
+            break;
+#endif
+            ret = pInstallColorProfileW( NULL, filename );
+            break;
+        case SG_ICM_DELETEPROFILE:
+        case SG_ICM_QUERYPROFILE:
+        {
+            WCHAR dir[MAX_PATH], path[MAX_PATH * 2];
+            DWORD size = sizeof(dir);
+            const WCHAR *base = wcsrchr( filename, '\\' );
+
+            /* the installed copy is the profile's file in the colour directory; the file the caller
+             * named is not touched */
+            base = base ? base + 1 : filename;
+            if (!pGetColorDirectoryW( NULL, dir, &size ) || wcslen( dir ) + wcslen( base ) + 2 > ARRAY_SIZE(path)) break;
+            wcscpy( path, dir );
+            wcscat( path, L"\\" );
+            wcscat( path, base );
+#ifdef SG_MUTANT_ICMREG_DEL
+            if (command == SG_ICM_DELETEPROFILE) ret = TRUE;
+            else
+#endif
+            if (command == SG_ICM_DELETEPROFILE) ret = pUninstallColorProfileW( NULL, path, TRUE );
+            else
+            {
+                ret = GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES;
+                if (!ret) SetLastError( ERROR_FILE_NOT_FOUND );
+            }
+            break;
+        }
+        }
+    }
+    else SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    FreeLibrary( mscms );
+    return ret;
 }
 
 /**********************************************************************
- *           UpdateICMRegKeyW       (GDI32.@)
+ *           UpdateICMRegKeyA       (GDI32.@)
  */
-BOOL WINAPI UpdateICMRegKeyW(DWORD reserved, LPWSTR cmid, LPWSTR filename, UINT command)
+BOOL WINAPI UpdateICMRegKeyA(DWORD reserved, LPSTR cmid, LPSTR filename, UINT command)
 {
-    FIXME("0x%08lx, %s, %s, 0x%08x stub\n", reserved, debugstr_w(cmid), debugstr_w(filename), command);
-    return TRUE;
+    WCHAR *cmidW = NULL, *filenameW = NULL;
+    BOOL ret;
+
+    TRACE( "0x%08lx, %s, %s, 0x%08x\n", reserved, debugstr_a(cmid), debugstr_a(filename), command );
+
+    if (filename)
+    {
+        int len = MultiByteToWideChar( CP_ACP, 0, filename, -1, NULL, 0 );
+        if (!(filenameW = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+        MultiByteToWideChar( CP_ACP, 0, filename, -1, filenameW, len );
+    }
+    ret = UpdateICMRegKeyW( reserved, cmidW, filenameW, command );
+    HeapFree( GetProcessHeap(), 0, filenameW );
+    return ret;
 }
 
 /***********************************************************************
