+    hr = make_text_range(node, obj->prov_idx, id, &original);
+    UiaPatternRelease(pattern);
+    if (FAILED(hr))
+        return hr;
+
+    hr = TextRange_Clone(original, out);
+    range = unsafe_text_range(original);
+    range->magic = 0;
+    IWineUiaNode_Release((IWineUiaNode *)range->node);
+    free(range);
+    return hr;
