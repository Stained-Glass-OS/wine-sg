+static HRESULT WINAPI uia_proxy_entry_QueryInterface(IUIAutomationProxyFactoryEntry *iface, REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUIAutomationProxyFactoryEntry) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+
+    IUIAutomationProxyFactoryEntry_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI uia_proxy_entry_AddRef(IUIAutomationProxyFactoryEntry *iface)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
+    ULONG ref = InterlockedIncrement(&entry->ref);
+
+    TRACE("%p, refcount %ld\n", entry, ref);
+    return ref;
+}
+
+static ULONG WINAPI uia_proxy_entry_Release(IUIAutomationProxyFactoryEntry *iface)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
+    ULONG ref = InterlockedDecrement(&entry->ref);
+    int i;
+
+    TRACE("%p, refcount %ld\n", entry, ref);
+    if (!ref)
+    {
+        for (i = 0; i < entry->win_events_count; i++)
+            SafeArrayDestroy(entry->win_events[i].win_events);
+        free(entry->win_events);
+        if (entry->factory)
+            IUIAutomationProxyFactory_Release(entry->factory);
+        SysFreeString(entry->class_name);
+        SysFreeString(entry->image_name);
+        entry->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&entry->cs);
+        free(entry);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI uia_proxy_entry_get_ProxyFactory(IUIAutomationProxyFactoryEntry *iface,
+        IUIAutomationProxyFactory **factory)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
+
+    TRACE("%p, %p\n", iface, factory);
+
+    if (!factory)
+        return E_POINTER;
+    *factory = entry->factory;
+    if (*factory)
+        IUIAutomationProxyFactory_AddRef(*factory);
+    return S_OK;
+}
+
+static HRESULT proxy_entry_get_bstr(struct uia_proxy_entry *entry, BSTR *val, BSTR *ret)
+{
+    if (!ret)
+        return E_POINTER;
+    EnterCriticalSection(&entry->cs);
+    *ret = *val ? SysAllocString(*val) : NULL;
+    LeaveCriticalSection(&entry->cs);
+    return (*val && !*ret) ? E_OUTOFMEMORY : S_OK;
+}
+
+static HRESULT proxy_entry_set_bstr(struct uia_proxy_entry *entry, BSTR *val, LPCWSTR str)
+{
+    BSTR new_str = NULL;
+
+    if (str && !(new_str = SysAllocString(str)))
+        return E_OUTOFMEMORY;
+    EnterCriticalSection(&entry->cs);
+    SysFreeString(*val);
+    *val = new_str;
+    LeaveCriticalSection(&entry->cs);
+    return S_OK;
+}
+
