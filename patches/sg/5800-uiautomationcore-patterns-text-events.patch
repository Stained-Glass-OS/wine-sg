+/* An element in another thread reaches a provider as a stand-in for the node. */
+static struct tprov *g_thread_prov;
+static HWND g_thread_hwnd;
+static HANDLE g_thread_ready;
+
+static LRESULT CALLBACK thread_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_GETOBJECT && (LONG)lp == UiaRootObjectId && g_thread_prov)
+        return UiaReturnRawElementProvider(hwnd, wp, lp, &g_thread_prov->simple_iface);
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static DWORD WINAPI thread_window_proc(void *arg)
+{
+    WNDCLASSW cls = { 0 };
+    MSG msg;
+
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    cls.lpfnWndProc = thread_wndproc;
+    cls.hInstance = GetModuleHandleW(NULL);
+    cls.lpszClassName = L"sg_uia_thread_class";
+    RegisterClassW(&cls);
+    g_thread_hwnd = CreateWindowW(cls.lpszClassName, L"sg", WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL,
+            cls.hInstance, NULL);
+    SetEvent(g_thread_ready);
+    while (GetMessageW(&msg, NULL, 0, 0))
+    {
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    DestroyWindow(g_thread_hwnd);
+    UnregisterClassW(cls.lpszClassName, cls.hInstance);
+    CoUninitialize();
+    return 0;
+}
