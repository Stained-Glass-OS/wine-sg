+static void test_pattern_availability(void)
+{
+    static const struct { PROPERTYID prop; PATTERNID pattern; } avail[] =
+    {
+        { UIA_IsInvokePatternAvailablePropertyId, UIA_InvokePatternId },
+        { UIA_IsSelectionPatternAvailablePropertyId, UIA_SelectionPatternId },
+        { UIA_IsValuePatternAvailablePropertyId, UIA_ValuePatternId },
+        { UIA_IsRangeValuePatternAvailablePropertyId, UIA_RangeValuePatternId },
+        { UIA_IsScrollPatternAvailablePropertyId, UIA_ScrollPatternId },
+        { UIA_IsExpandCollapsePatternAvailablePropertyId, UIA_ExpandCollapsePatternId },
+        { UIA_IsGridPatternAvailablePropertyId, UIA_GridPatternId },
+        { UIA_IsGridItemPatternAvailablePropertyId, UIA_GridItemPatternId },
+        { UIA_IsMultipleViewPatternAvailablePropertyId, UIA_MultipleViewPatternId },
+        { UIA_IsWindowPatternAvailablePropertyId, UIA_WindowPatternId },
+        { UIA_IsSelectionItemPatternAvailablePropertyId, UIA_SelectionItemPatternId },
+        { UIA_IsDockPatternAvailablePropertyId, UIA_DockPatternId },
+        { UIA_IsTablePatternAvailablePropertyId, UIA_TablePatternId },
+        { UIA_IsTableItemPatternAvailablePropertyId, UIA_TableItemPatternId },
+        { UIA_IsTogglePatternAvailablePropertyId, UIA_TogglePatternId },
+        { UIA_IsTransformPatternAvailablePropertyId, UIA_TransformPatternId },
+        { UIA_IsScrollItemPatternAvailablePropertyId, UIA_ScrollItemPatternId },
+        { UIA_IsLegacyIAccessiblePatternAvailablePropertyId, UIA_LegacyIAccessiblePatternId },
+        { UIA_IsItemContainerPatternAvailablePropertyId, UIA_ItemContainerPatternId },
+        { UIA_IsVirtualizedItemPatternAvailablePropertyId, UIA_VirtualizedItemPatternId },
+        { UIA_IsSynchronizedInputPatternAvailablePropertyId, UIA_SynchronizedInputPatternId },
+        { UIA_IsObjectModelPatternAvailablePropertyId, UIA_ObjectModelPatternId },
+        { UIA_IsAnnotationPatternAvailablePropertyId, UIA_AnnotationPatternId },
+        { UIA_IsStylesPatternAvailablePropertyId, UIA_StylesPatternId },
+        { UIA_IsSpreadsheetPatternAvailablePropertyId, UIA_SpreadsheetPatternId },
+        { UIA_IsSpreadsheetItemPatternAvailablePropertyId, UIA_SpreadsheetItemPatternId },
+        { UIA_IsTransformPattern2AvailablePropertyId, UIA_TransformPattern2Id },
+        { UIA_IsTextPatternAvailablePropertyId, UIA_TextPatternId },
+        { UIA_IsTextPattern2AvailablePropertyId, UIA_TextPattern2Id },
+        { UIA_IsTextEditPatternAvailablePropertyId, UIA_TextEditPatternId },
+        { UIA_IsTextChildPatternAvailablePropertyId, UIA_TextChildPatternId },
+        { UIA_IsDragPatternAvailablePropertyId, UIA_DragPatternId },
+        { UIA_IsDropTargetPatternAvailablePropertyId, UIA_DropTargetPatternId },
+        { UIA_IsCustomNavigationPatternAvailablePropertyId, UIA_CustomNavigationPatternId },
+        { UIA_IsSelectionPattern2AvailablePropertyId, UIA_SelectionPattern2Id },
+    };
+    struct tprov prov;
+    struct pobj obj;
+    HUIANODE node;
+    HRESULT hr;
+    BOOL known, val;
+    unsigned int i;
+
+    init_tprov(&prov, &obj, 0);
+    hr = UiaNodeFromProvider(&prov.simple_iface, &node);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(avail); i++)
+    {
+        winetest_push_context("property %d", avail[i].prop);
+
+        prov.pattern_mask = 0;
+        val = node_prop_bool(node, avail[i].prop, &known);
+        ok(known, "no value for an unsupported pattern.\n");
+        ok(!val, "pattern available without a provider.\n");
+
+        prov.pattern_mask = PATTERN_BIT(avail[i].pattern);
+        val = node_prop_bool(node, avail[i].prop, &known);
+        ok(known, "no value for a supported pattern.\n");
+        ok(val, "pattern not available.\n");
+
+        /* No other pattern turns it on. */
+        prov.pattern_mask = ALL_PATTERNS & ~PATTERN_BIT(avail[i].pattern);
+        val = node_prop_bool(node, avail[i].prop, &known);
+        ok(known, "no value.\n");
+        ok(!val, "pattern available because of another.\n");
+
+        winetest_pop_context();
+    }
+
+    /* The provider's own answer for the property is used. */
+    prov.pattern_mask = PATTERN_BIT(UIA_InvokePatternId);
+    set_prop_bool(&prov, UIA_IsInvokePatternAvailablePropertyId, FALSE);
+    val = node_prop_bool(node, UIA_IsInvokePatternAvailablePropertyId, &known);
+    ok(known && !val, "the provider's value was not used.\n");
+    set_prop_bool(&prov, UIA_IsValuePatternAvailablePropertyId, TRUE);
+    prov.pattern_mask = 0;
+    val = node_prop_bool(node, UIA_IsValuePatternAvailablePropertyId, &known);
+    ok(known && val, "the provider's value was not used.\n");
+
+    UiaNodeRelease(node);
+}
