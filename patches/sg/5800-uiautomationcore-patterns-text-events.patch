+/* Text: one document, ranges are two offsets into it. */
+static const WCHAR doc_text[] = L"Hello, World! Second line.";
+#define DOC_LEN 26
+
+struct trange
+{
+    ITextRangeProvider iface;
+    LONG ref;
+    struct pobj *owner;
+    int start, end;
+};
+
+static const ITextRangeProviderVtbl trange_vtbl;
+
+static struct trange *impl_from_trange(ITextRangeProvider *iface)
+{
+    return CONTAINING_RECORD(iface, struct trange, iface);
+}
+
+static struct trange *trange_create(struct pobj *owner, int start, int end)
+{
+    struct trange *r = calloc(1, sizeof(*r));
+
+    r->iface.lpVtbl = &trange_vtbl;
+    r->ref = 1;
+    r->owner = owner;
+    r->start = start;
+    r->end = end;
+    return r;
+}
+
+static HRESULT WINAPI trange_QueryInterface(ITextRangeProvider *iface, REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITextRangeProvider))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+    ITextRangeProvider_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI trange_AddRef(ITextRangeProvider *iface)
+{
+    return InterlockedIncrement(&impl_from_trange(iface)->ref);
+}
+
+static ULONG WINAPI trange_Release(ITextRangeProvider *iface)
+{
+    struct trange *r = impl_from_trange(iface);
+    ULONG ref = InterlockedDecrement(&r->ref);
+
+    if (!ref)
+        free(r);
+    return ref;
+}
+
+static HRESULT WINAPI trange_Clone(ITextRangeProvider *iface, ITextRangeProvider **ret)
+{
+    struct trange *r = impl_from_trange(iface);
+
+    plog(r->owner, "Clone;");
+    *ret = &trange_create(r->owner, r->start, r->end)->iface;
+    return S_OK;
+}
+
+static BOOL is_word_char(WCHAR c)
+{
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
+}
+
+static HRESULT WINAPI trange_Compare(ITextRangeProvider *iface, ITextRangeProvider *other, BOOL *ret)
+{
+    struct trange *r = impl_from_trange(iface), *o = impl_from_trange(other);
+
+    *ret = r->start == o->start && r->end == o->end;
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_CompareEndpoints(ITextRangeProvider *iface, enum TextPatternRangeEndpoint ep,
+        ITextRangeProvider *target, enum TextPatternRangeEndpoint target_ep, int *ret)
+{
+    struct trange *r = impl_from_trange(iface), *t = impl_from_trange(target);
+
+    *ret = (ep == TextPatternRangeEndpoint_Start ? r->start : r->end) -
+            (target_ep == TextPatternRangeEndpoint_Start ? t->start : t->end);
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_ExpandToEnclosingUnit(ITextRangeProvider *iface, enum TextUnit unit)
+{
+    struct trange *r = impl_from_trange(iface);
+    int s = r->start;
+
+    plog(r->owner, "Expand(%d);", unit);
+    if (unit == TextUnit_Character)
+        r->end = min(r->start + 1, DOC_LEN);
+    else if (unit == TextUnit_Word)
+    {
+        while (s > 0 && is_word_char(doc_text[s - 1])) s--;
+        r->start = s;
+        r->end = s;
+        while (r->end < DOC_LEN && is_word_char(doc_text[r->end])) r->end++;
+        if (r->end == r->start) r->end = min(r->start + 1, DOC_LEN);
+    }
+    else
+    {
+        r->start = 0;
+        r->end = DOC_LEN;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_FindAttribute(ITextRangeProvider *iface, TEXTATTRIBUTEID id, VARIANT val, BOOL backward,
+        ITextRangeProvider **ret)
+{
+    struct trange *r = impl_from_trange(iface);
+    char buf[64];
+
+    snprintf(buf, sizeof(buf), "FindAttribute(%ld,%d,%d);", (long)id, V_VT(&val) == VT_I4 ? (int)V_I4(&val) : -1, backward);
+    plog(r->owner, "%s", buf);
+    *ret = id == UIA_FontNameAttributeId ? &trange_create(r->owner, 7, 12)->iface : NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_FindText(ITextRangeProvider *iface, BSTR text, BOOL backward, BOOL ignore_case,
+        ITextRangeProvider **ret)
+{
+    struct trange *r = impl_from_trange(iface);
+    int len = wcslen(text), i, from, to, step;
+    char buf[64];
+
+    snprintf(buf, sizeof(buf), "FindText(%ls,%d,%d);", text, backward, ignore_case);
+    plog(r->owner, "%s", buf);
+    *ret = NULL;
+    from = backward ? r->end - len : r->start;
+    to = backward ? r->start - 1 : r->end - len + 1;
+    step = backward ? -1 : 1;
+    for (i = from; i != to; i += step)
+    {
+        if (i < r->start || i + len > r->end)
+            continue;
+        if (!(ignore_case ? _wcsnicmp(doc_text + i, text, len) : wcsncmp(doc_text + i, text, len)))
+        {
+            *ret = &trange_create(r->owner, i, i + len)->iface;
+            break;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_GetAttributeValue(ITextRangeProvider *iface, TEXTATTRIBUTEID id, VARIANT *ret)
+{
+    IUnknown *ns;
+
+    VariantInit(ret);
+    if (id == UIA_FontNameAttributeId)
+    {
+        V_VT(ret) = VT_BSTR;
+        V_BSTR(ret) = SysAllocString(L"Sans");
+    }
+    else if (id == UIA_IsItalicAttributeId)
+    {
+        V_VT(ret) = VT_BOOL;
+        V_BOOL(ret) = VARIANT_TRUE;
+    }
+    else if (id == UIA_FontSizeAttributeId)
+    {
+        V_VT(ret) = VT_R8;
+        V_R8(ret) = 11.5;
+    }
+    else
+    {
+        UiaGetReservedNotSupportedValue(&ns);
+        V_VT(ret) = VT_UNKNOWN;
+        V_UNKNOWN(ret) = ns;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_GetBoundingRectangles(ITextRangeProvider *iface, SAFEARRAY **ret)
+{
+    static const double rects[8] = { 1, 2, 30, 40, 5, 6, 70, 80 };
+    LONG i;
+
+    *ret = SafeArrayCreateVector(VT_R8, 0, 8);
+    for (i = 0; i < 8; i++)
+        SafeArrayPutElement(*ret, &i, (void *)&rects[i]);
