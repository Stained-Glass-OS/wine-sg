+#define S(e) do { HRESULT hr_ = (e); ok(hr_ == S_OK, "%s: unexpected hr %#lx.\n", #e, hr_); } while (0)
+#define GI(fn, p, exp) do { int v_ = -999; HRESULT hr_ = fn(p, (void *)&v_); \
+    ok(hr_ == S_OK, "%s: unexpected hr %#lx.\n", #fn, hr_); \
+    ok(v_ == (int)(exp), "%s: got %d, expected %d.\n", #fn, v_, (int)(exp)); } while (0)
+#define GB(fn, p, exp) do { BOOL v_ = -999; HRESULT hr_ = fn(p, &v_); \
+    ok(hr_ == S_OK, "%s: unexpected hr %#lx.\n", #fn, hr_); \
+    ok(v_ == !!(exp), "%s: got %d, expected %d.\n", #fn, v_, !!(exp)); } while (0)
+#define GD(fn, p, exp) do { double v_ = -999; HRESULT hr_ = fn(p, &v_); \
+    ok(hr_ == S_OK, "%s: unexpected hr %#lx.\n", #fn, hr_); \
+    ok(v_ == (exp), "%s: got %f, expected %f.\n", #fn, v_, (double)(exp)); } while (0)
+#define GS(fn, p, exp) do { BSTR v_ = NULL; HRESULT hr_ = fn(p, &v_); \
+    ok(hr_ == S_OK, "%s: unexpected hr %#lx.\n", #fn, hr_); \
+    ok(v_ && !wcscmp(v_, exp), "%s: got %s, expected %s.\n", #fn, wine_dbgstr_w(v_), wine_dbgstr_w(exp)); \
+    SysFreeString(v_); } while (0)
+#define GE(fn, p, serial) do { IUIAutomationElement *e_ = NULL; HRESULT hr_ = fn(p, &e_); \
+    ok(hr_ == S_OK, "%s: unexpected hr %#lx.\n", #fn, hr_); \
+    ok(com_serial(e_) == (serial), "%s: got element %d, expected %d.\n", #fn, com_serial(e_), (int)(serial)); \
+    if (e_) IUIAutomationElement_Release(e_); } while (0)
+#define LOG(o, exp) do { ok(!strcmp((o)->log, exp), "got log %s, expected %s.\n", (o)->log, exp); (o)->log[0] = 0; } while (0)
+
+static int com_serial(IUIAutomationElement *el)
+{
+    SAFEARRAY *sa = NULL;
+    LONG idx = 1;
+    int val = -1;
+
+    if (!el || FAILED(IUIAutomationElement_GetRuntimeId(el, &sa)) || !sa)
+        return -1;
+    SafeArrayGetElement(sa, &idx, &val);
+    SafeArrayDestroy(sa);
+    return val;
+}
+
+static void check_elem_array(IUIAutomationElementArray *arr, int count, int s0, int s1)
+{
+    IUIAutomationElement *el;
+    int len = -1, i;
+
+    ok(!!arr, "no array.\n");
+    if (!arr) return;
+    S(IUIAutomationElementArray_get_Length(arr, &len));
+    ok(len == count, "got length %d, expected %d.\n", len, count);
+    for (i = 0; i < len && i < 2; i++)
+    {
+        el = NULL;
+        S(IUIAutomationElementArray_GetElement(arr, i, &el));
+        ok(com_serial(el) == (i ? s1 : s0), "element %d is %d.\n", i, com_serial(el));
+        if (el) IUIAutomationElement_Release(el);
+    }
+    IUIAutomationElementArray_Release(arr);
+}
+
+#define PAT(el, name, id, var) \
+    name *var = NULL; \
+    { IUnknown *u_ = NULL; HRESULT hr_ = IUIAutomationElement_GetCurrentPattern(el, id, &u_); \
+      ok(hr_ == S_OK && u_, "%s: pattern %d: hr %#lx.\n", #name, id, hr_); \
+      if (u_) { hr_ = IUnknown_QueryInterface(u_, &IID_##name, (void **)&var); \
+          ok(hr_ == S_OK, "%s: QI hr %#lx.\n", #name, hr_); IUnknown_Release(u_); } }
+
+static void check_range_text(IUIAutomationTextRange *range, const WCHAR *expected)
+{
+    BSTR text = NULL;
+    HRESULT hr;
+
+    ok(!!range, "no range, expected %s.\n", wine_dbgstr_w(expected));
+    if (!range)
+        return;
+    hr = IUIAutomationTextRange_GetText(range, -1, &text);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(text && !wcscmp(text, expected), "got %s, expected %s.\n", wine_dbgstr_w(text), wine_dbgstr_w(expected));
+    SysFreeString(text);
+}
