+    ok(hr == UIA_E_NOTSUPPORTED, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&v) == VT_EMPTY, "got vt %d.\n", V_VT(&v));
+
+    prov->simple23_supported = TRUE;
+    hr = IUIAutomationElement9_ShowContextMenu(el9);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(prov->show_menu_calls == 1, "got %d calls.\n", prov->show_menu_calls);
+    hr = IUIAutomationElement9_GetCurrentMetadataValue(el9, UIA_NamePropertyId, 7, &v);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&v) == VT_I4 && V_I4(&v) == 4242, "got vt %d.\n", V_VT(&v));
+    ok(prov->meta_target == UIA_NamePropertyId && prov->meta_id == 7, "got %d, %d.\n", prov->meta_target, prov->meta_id);
+    VariantClear(&v);
+
+    /* The target is a property id. */
+    hr = IUIAutomationElement9_GetCurrentMetadataValue(el9, 12345, 7, &v);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationElement9_GetCurrentMetadataValue(el9, UIA_NamePropertyId, 7, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    prov->simple23_supported = FALSE;
+    IUIAutomationElement9_Release(el9);
+}
