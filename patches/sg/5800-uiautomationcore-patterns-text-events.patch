+/* The array of range handles the C layer gives (variants holding the handles), as an object. Takes the array. */
+static HRESULT uia_com_text_range_array_create(struct uia_element *element, SAFEARRAY *sa,
+        IUIAutomationTextRangeArray **out)
+{
+    struct uia_com_text_range_array *arr;
+    LONG lbound = 0, elems = 0, i;
+    HRESULT hr = S_OK;
+
+    *out = NULL;
+    if (sa && FAILED(hr = get_safearray_bounds(sa, &lbound, &elems)))
+        goto fail;
+    if (!(arr = calloc(1, sizeof(*arr))) || !(arr->ranges = calloc(elems ? elems : 1, sizeof(*arr->ranges))))
+    {
+        free(arr);
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    arr->IUIAutomationTextRangeArray_iface.lpVtbl = &uia_com_text_range_array_vtbl;
+    arr->ref = 1;
+    for (i = 0; i < elems; i++)
+    {
+        LONG idx = lbound + i;
+        HUIATEXTRANGE range;
+        VARIANT v;
+
+        VariantInit(&v);
+        if (FAILED(hr = SafeArrayGetElement(sa, &idx, &v)) || FAILED(hr = UiaHTextRangeFromVariant(&v, &range)))
+            break;
+        /* the handle is now owned by the object */
+        if (FAILED(hr = uia_com_text_range_create(element, range, &arr->ranges[i])))
+            break;
+        arr->count = i + 1;
+    }
+    if (FAILED(hr))
+    {
+        /* handles after the failed one are still ours */
+        for (i = arr->count + 1; i < elems; i++)
+        {
+            LONG idx = lbound + i;
+            HUIATEXTRANGE range;
+            VARIANT v;
+
+            VariantInit(&v);
+            if (SUCCEEDED(SafeArrayGetElement(sa, &idx, &v)) && SUCCEEDED(UiaHTextRangeFromVariant(&v, &range)))
+                UiaTextRangeRelease(range);
+        }
+        IUIAutomationTextRangeArray_Release(&arr->IUIAutomationTextRangeArray_iface);
+        SafeArrayDestroy(sa);
+        return hr;
+    }
+    arr->count = elems;
+    if (sa)
+        SafeArrayDestroy(sa);
+    *out = &arr->IUIAutomationTextRangeArray_iface;
+    return S_OK;
+
+fail:
+    if (sa)
+    {
+        LONG idx;
+
+        for (idx = lbound; idx < lbound + elems; idx++)
+        {
+            HUIATEXTRANGE range;
+            VARIANT v;
+
+            VariantInit(&v);
+            if (SUCCEEDED(SafeArrayGetElement(sa, &idx, &v)) && SUCCEEDED(UiaHTextRangeFromVariant(&v, &range)))
+                UiaTextRangeRelease(range);
+        }
+        SafeArrayDestroy(sa);
+    }
+    return hr;
+}
