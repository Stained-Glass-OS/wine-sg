+static void test_substring_condition(IUIAutomation *uia, IUIAutomationElement *host, struct tprov *child)
+{
+    static const struct { const WCHAR *text; int flags; BOOL found; } tests[] = {
+        { L"lo Wo", PropertyConditionFlags_MatchSubstring, TRUE },
+        { L"lo Wo", PropertyConditionFlags_None, FALSE },
+        { L"LO WO", PropertyConditionFlags_MatchSubstring, FALSE },
+        { L"LO WO", PropertyConditionFlags_MatchSubstring | PropertyConditionFlags_IgnoreCase, TRUE },
+        { L"HELLO WORLD", PropertyConditionFlags_IgnoreCase, TRUE },
+        { L"Hello World", PropertyConditionFlags_None, TRUE },
+        { L"World!", PropertyConditionFlags_MatchSubstring, FALSE },
+        { L"", PropertyConditionFlags_MatchSubstring, TRUE },
+        { L"xHello", PropertyConditionFlags_MatchSubstring, FALSE },
+    };
+    unsigned int i;
+
+    set_prop_bstr(child, UIA_NamePropertyId, L"Hello World");
+    set_prop_bool(child, UIA_IsControlElementPropertyId, TRUE);
+    set_prop_bool(child, UIA_IsContentElementPropertyId, TRUE);
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        IUIAutomationCondition *cond;
+        IUIAutomationElement *found = NULL;
+        VARIANT v;
+        HRESULT hr;
+
+        V_VT(&v) = VT_BSTR;
+        V_BSTR(&v) = SysAllocString(tests[i].text);
+        hr = IUIAutomation_CreatePropertyConditionEx(uia, UIA_NamePropertyId, v, tests[i].flags, &cond);
+        ok(hr == S_OK, "%u: unexpected hr %#lx.\n", i, hr);
+        VariantClear(&v);
+        hr = IUIAutomationElement_FindFirst(host, TreeScope_Children, cond, &found);
+        ok(hr == S_OK, "%u: unexpected hr %#lx.\n", i, hr);
+        ok(!!found == tests[i].found, "%u: %s, found %p.\n", i, wine_dbgstr_w(tests[i].text), found);
+        if (found) IUIAutomationElement_Release(found);
+        IUIAutomationCondition_Release(cond);
+    }
+}
