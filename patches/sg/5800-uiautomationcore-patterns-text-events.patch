+static HRESULT WINAPI trange_GetText(ITextRangeProvider *iface, int max_len, BSTR *ret)
+{
+    struct trange *r = impl_from_trange(iface);
+    int len = r->end - r->start;
+
+    if (max_len >= 0 && len > max_len)
+        len = max_len;
+    *ret = SysAllocStringLen(doc_text + r->start, len);
+    return S_OK;
+}
+
+static int clamp_pos(int pos)
+{
+    return pos < 0 ? 0 : pos > DOC_LEN ? DOC_LEN : pos;
+}
+
+static HRESULT WINAPI trange_Move(ITextRangeProvider *iface, enum TextUnit unit, int count, int *moved)
+{
+    struct trange *r = impl_from_trange(iface);
+    int pos;
+
+    if (unit != TextUnit_Character)
+    {
+        *moved = 0;
+        return S_OK;
+    }
+    pos = clamp_pos(r->start + count);
+    if (pos > DOC_LEN - 1) pos = DOC_LEN - 1;
+    *moved = pos - r->start;
+    r->start = pos;
+    r->end = pos + 1;
+    return S_OK;
+}
+
+static void set_endpoint(struct trange *r, enum TextPatternRangeEndpoint ep, int pos)
+{
+    pos = clamp_pos(pos);
+    if (ep == TextPatternRangeEndpoint_Start)
+    {
+        r->start = pos;
+        if (r->end < pos) r->end = pos;
+    }
+    else
+    {
+        r->end = pos;
+        if (r->start > pos) r->start = pos;
+    }
+}
+
+static HRESULT WINAPI trange_MoveEndpointByUnit(ITextRangeProvider *iface, enum TextPatternRangeEndpoint ep,
+        enum TextUnit unit, int count, int *moved)
+{
+    struct trange *r = impl_from_trange(iface);
+    int old = ep == TextPatternRangeEndpoint_Start ? r->start : r->end;
+
+    if (unit != TextUnit_Character)
+    {
+        *moved = 0;
+        return S_OK;
+    }
+    set_endpoint(r, ep, old + count);
+    *moved = (ep == TextPatternRangeEndpoint_Start ? r->start : r->end) - old;
+    return S_OK;
+}
+
+static HRESULT WINAPI trange_MoveEndpointByRange(ITextRangeProvider *iface, enum TextPatternRangeEndpoint ep,
+        ITextRangeProvider *target, enum TextPatternRangeEndpoint target_ep)
+{
+    struct trange *r = impl_from_trange(iface), *t = impl_from_trange(target);
+
+    set_endpoint(r, ep, target_ep == TextPatternRangeEndpoint_Start ? t->start : t->end);
+    return S_OK;
+}
