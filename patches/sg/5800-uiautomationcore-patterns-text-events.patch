+
+/* The IAccessible type information is the one in oleacc's type library. */
+static HRESULT bridge_load_typeinfo(ITypeInfo **ret)
+{
+    WCHAR path[MAX_PATH];
+    ITypeInfo *info;
+    ITypeLib *lib;
+    HMODULE oleacc;
+    HRESULT hr;
+
+    if (accessible_typeinfo)
+    {
+        ITypeInfo_AddRef(accessible_typeinfo);
+        *ret = accessible_typeinfo;
+        return S_OK;
+    }
+
+    if (!(oleacc = GetModuleHandleW(L"oleacc.dll")) || !GetModuleFileNameW(oleacc, path, ARRAY_SIZE(path)))
+        return E_FAIL;
+    if (FAILED(hr = LoadTypeLibEx(path, REGKIND_NONE, &lib)))
+    {
+        WARN("Failed to load the type library, hr %#lx.\n", hr);
+        return hr;
+    }
+    hr = ITypeLib_GetTypeInfoOfGuid(lib, &IID_IAccessible, &info);
+    ITypeLib_Release(lib);
+    if (FAILED(hr))
+        return hr;
+
+    if (InterlockedCompareExchangePointer((void **)&accessible_typeinfo, info, NULL))
+        ITypeInfo_Release(info);
+    ITypeInfo_AddRef(accessible_typeinfo);
+    *ret = accessible_typeinfo;
+    return S_OK;
+}
