+/* The array of node handles a range's children come in, made elements. */
+static HRESULT uia_com_text_children_to_elements(struct uia_element *element, SAFEARRAY *sa,
+        IUIAutomationElementArray **out)
+{
+    struct uia_element_array *arr_data;
+    IUIAutomationElementArray *arr;
+    LONG lbound, elems, i;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!sa)
+        return create_uia_element_array_iface(out, 0);
+    if (FAILED(hr = get_safearray_bounds(sa, &lbound, &elems)))
+        return hr;
+    if (FAILED(hr = create_uia_element_array_iface(&arr, elems)))
+        return hr;
+    arr_data = impl_from_IUIAutomationElementArray(arr);
+    for (i = 0; i < elems; i++)
+    {
+        LONG idx = lbound + i;
+        HUIANODE node = NULL;
+        VARIANT v;
+
+        VariantInit(&v);
+        if (FAILED(hr = SafeArrayGetElement(sa, &idx, &v)) || FAILED(hr = UiaHUiaNodeFromVariant(&v, &node)) || !node)
+        {
+            if (SUCCEEDED(hr))
+                hr = E_FAIL;
+            break;
+        }
+        if (FAILED(hr = create_uia_element(&arr_data->elements[i], element->from_cui8, node)))
+        {
+            UiaNodeRelease(node);
+            break;
+        }
+    }
+    if (FAILED(hr))
+    {
+        IUIAutomationElementArray_Release(arr);
+        return hr;
+    }
+    *out = arr;
+    return S_OK;
+}
