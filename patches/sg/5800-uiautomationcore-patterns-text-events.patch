+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(scopes); i++)
+    {
+        struct UiaCacheRequest req = { 0 };
+        SAFEARRAY *out = NULL;
