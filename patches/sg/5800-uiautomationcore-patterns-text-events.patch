+static void test_default_values(IUIAutomation *uia, IUIAutomationElement *el0)
+{
+    IUIAutomationCacheRequest *creq;
+    IUIAutomationElement *cached;
+    IUnknown *ns;
+    VARIANT v;
+    HRESULT hr;
+
+    UiaGetReservedNotSupportedValue(&ns);
+
+    /* ignoreDefault TRUE: a property the provider does not give is "not supported". */
+    VariantInit(&v);
+    hr = IUIAutomationElement_GetCurrentPropertyValueEx(el0, UIA_ControlTypePropertyId, TRUE, &v);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&v) == VT_UNKNOWN && V_UNKNOWN(&v) == ns, "got vt %d.\n", V_VT(&v));
+    VariantClear(&v);
+
+    /* FALSE: the documented default, and the same as GetCurrentPropertyValue. */
+    hr = IUIAutomationElement_GetCurrentPropertyValueEx(el0, UIA_ControlTypePropertyId, FALSE, &v);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&v) == VT_I4 && V_I4(&v) == UIA_CustomControlTypeId, "got vt %d.\n", V_VT(&v));
+    VariantClear(&v);
+    hr = IUIAutomationElement_GetCurrentPropertyValue(el0, UIA_ControlTypePropertyId, &v);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&v) == VT_I4 && V_I4(&v) == UIA_CustomControlTypeId, "got vt %d.\n", V_VT(&v));
+    VariantClear(&v);
+
+    hr = IUIAutomationElement_GetCurrentPropertyValueEx(el0, UIA_ToggleToggleStatePropertyId, FALSE, &v);
+    ok(hr == S_OK && V_VT(&v) == VT_I4 && V_I4(&v) == ToggleState_Indeterminate, "got hr %#lx vt %d.\n", hr, V_VT(&v));
+    VariantClear(&v);
+    hr = IUIAutomationElement_GetCurrentPropertyValueEx(el0, UIA_NamePropertyId, FALSE, &v);
+    ok(hr == S_OK && V_VT(&v) == VT_BSTR && V_BSTR(&v) && !*V_BSTR(&v), "got hr %#lx vt %d.\n", hr, V_VT(&v));
+    VariantClear(&v);
+    hr = IUIAutomationElement_GetCurrentPropertyValueEx(el0, UIA_IsEnabledPropertyId, FALSE, &v);
+    ok(hr == S_OK && V_VT(&v) == VT_BOOL && !V_BOOL(&v), "got hr %#lx vt %d.\n", hr, V_VT(&v));
+    VariantClear(&v);
+    hr = IUIAutomationElement_GetCurrentPropertyValueEx(el0, UIA_IsControlElementPropertyId, FALSE, &v);
+    ok(hr == S_OK && V_VT(&v) == VT_BOOL && V_BOOL(&v), "got hr %#lx vt %d.\n", hr, V_VT(&v));
+    VariantClear(&v);
+
+    /* The cached forms follow the same rule. */
+    hr = IUIAutomation_CreateCacheRequest(uia, &creq);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IUIAutomationCacheRequest_AddProperty(creq, UIA_ControlTypePropertyId);
+    IUIAutomationCacheRequest_AddProperty(creq, UIA_ToggleToggleStatePropertyId);
+    hr = IUIAutomationElement_BuildUpdatedCache(el0, creq, &cached);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (cached)
+    {
+        hr = IUIAutomationElement_GetCachedPropertyValueEx(cached, UIA_ControlTypePropertyId, TRUE, &v);
+        ok(hr == S_OK && V_VT(&v) == VT_UNKNOWN && V_UNKNOWN(&v) == ns, "got hr %#lx vt %d.\n", hr, V_VT(&v));
+        VariantClear(&v);
+        hr = IUIAutomationElement_GetCachedPropertyValueEx(cached, UIA_ControlTypePropertyId, FALSE, &v);
+        ok(hr == S_OK && V_VT(&v) == VT_I4 && V_I4(&v) == UIA_CustomControlTypeId, "got hr %#lx vt %d.\n", hr, V_VT(&v));
+        VariantClear(&v);
+        hr = IUIAutomationElement_GetCachedPropertyValue(cached, UIA_ToggleToggleStatePropertyId, &v);
+        ok(hr == S_OK && V_VT(&v) == VT_I4 && V_I4(&v) == ToggleState_Indeterminate, "got hr %#lx vt %d.\n", hr, V_VT(&v));
+        VariantClear(&v);
+        IUIAutomationElement_Release(cached);
+    }
+    IUIAutomationCacheRequest_Release(creq);
+}
