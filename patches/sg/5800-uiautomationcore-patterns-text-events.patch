+static HRESULT WINAPI tprov_QueryInterface(IRawElementProviderSimple *iface, REFIID riid, void **ppv)
+{
+    struct tprov *prov = impl_from_simple(iface);
+
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IRawElementProviderSimple) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = &prov->simple_iface;
+    else if (IsEqualIID(riid, &IID_IRawElementProviderFragment) && prov->has_fragment)
+        *ppv = &prov->frag_iface;
+    else if (IsEqualIID(riid, &IID_IRawElementProviderSimple2) && prov->simple23_supported)
+        *ppv = &prov->simple2_iface;
+    else if (IsEqualIID(riid, &IID_IRawElementProviderSimple3) && prov->simple23_supported)
+        *ppv = &prov->simple3_iface;
+    else if (IsEqualIID(riid, &IID_IRawElementProviderAdviseEvents) && prov->advise_supported)
+        *ppv = &prov->advise_iface;
+    else if (IsEqualIID(riid, &IID_IRawElementProviderFragmentRoot) && prov->host_is_root)
+        *ppv = &prov->root_iface;
+    else
+        return E_NOINTERFACE;
+    IUnknown_AddRef((IUnknown *)*ppv);
+    return S_OK;
+}
