+
+static HRESULT WINAPI uia_com_text_range_GetChildrenBuildCache(IUIAutomationTextRange3 *iface,
+        IUIAutomationCacheRequest *cache_req, IUIAutomationElementArray **children)
+{
+    IUIAutomationElementArray *arr;
+    IUIAutomationElement *child, *cached;
+    struct uia_element_array *out_data;
+    IUIAutomationElementArray *out;
+    int len, i;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", iface, cache_req, children);
+
+    if (!children)
+        return E_POINTER;
+    *children = NULL;
+    if (!cache_req)
+        return E_POINTER;
+    if (FAILED(hr = uia_com_text_range_GetChildren(iface, &arr)))
+        return hr;
+    IUIAutomationElementArray_get_Length(arr, &len);
+    if (FAILED(hr = create_uia_element_array_iface(&out, len)))
+    {
+        IUIAutomationElementArray_Release(arr);
+        return hr;
+    }
+    out_data = impl_from_IUIAutomationElementArray(out);
+    for (i = 0; i < len; i++)
+    {
+        child = NULL;
+        if (FAILED(hr = IUIAutomationElementArray_GetElement(arr, i, &child)))
+            break;
+        cached = NULL;
+        hr = IUIAutomationElement_BuildUpdatedCache(child, cache_req, &cached);
+        IUIAutomationElement_Release(child);
+        if (FAILED(hr))
+            break;
+        out_data->elements[i] = cached;
+    }
+    IUIAutomationElementArray_Release(arr);
+    if (FAILED(hr))
+    {
+        IUIAutomationElementArray_Release(out);
+        return hr;
+    }
+    *children = out;
+    return S_OK;
+}
