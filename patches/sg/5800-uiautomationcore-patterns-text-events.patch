+/* ---- text: ranges, range arrays and the text pattern objects (Stained Glass OS) ---- */
+
+struct uia_com_text_range
+{
+    IUIAutomationTextRange3 IUIAutomationTextRange3_iface;
+    LONG ref;
+    struct uia_element *element;
+    HUIATEXTRANGE range;
+};
+
+static const IUIAutomationTextRange3Vtbl uia_com_text_range_vtbl;
+
+static inline struct uia_com_text_range *impl_from_IUIAutomationTextRange3(IUIAutomationTextRange3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct uia_com_text_range, IUIAutomationTextRange3_iface);
+}
+
+static struct uia_com_text_range *unsafe_impl_from_text_range(IUIAutomationTextRange *iface)
+{
+    if (!iface || (const void *)iface->lpVtbl != (const void *)&uia_com_text_range_vtbl)
+        return NULL;
+    return CONTAINING_RECORD((IUIAutomationTextRange3 *)iface, struct uia_com_text_range, IUIAutomationTextRange3_iface);
+}
+
+/* Takes the handle; releases it if no object is made. */
+static HRESULT uia_com_text_range_create(struct uia_element *element, HUIATEXTRANGE range, IUIAutomationTextRange **out)
+{
+    struct uia_com_text_range *obj;
+
+    *out = NULL;
+    if (!range)
+        return S_OK;
+    if (!(obj = calloc(1, sizeof(*obj))))
+    {
+        UiaTextRangeRelease(range);
+        return E_OUTOFMEMORY;
+    }
+    obj->IUIAutomationTextRange3_iface.lpVtbl = &uia_com_text_range_vtbl;
+    obj->ref = 1;
+    obj->element = element;
+    IUIAutomationElement9_AddRef(&element->IUIAutomationElement9_iface);
+    obj->range = range;
+    *out = (IUIAutomationTextRange *)&obj->IUIAutomationTextRange3_iface;
+    return S_OK;
+}
+
+static HRESULT uia_com_active_text_dispatch(IUIAutomationElement *elem, struct uia_com_event *com_event,
+        struct uia_event_args *args)
+{
+    IUIAutomationActiveTextPositionChangedEventHandler *handler;
+    struct uia_element *element = unsafe_impl_from_element(elem);
+    IUIAutomationTextRange *range = NULL;
+    HUIATEXTRANGE hrange = NULL;
+    HRESULT hr;
+
+    if (args->active_text_args.range_id && element && element->node &&
+            SUCCEEDED(uia_text_range_from_event(element->node, args->active_text_args.range_id, &hrange)))
+        uia_com_text_range_create(element, hrange, &range);
+#ifdef SG_MUTANT_UIA_ACTIVETEXT_NO_RANGE
+    if (range)
+    {
+        IUIAutomationTextRange_Release(range);
+        range = NULL;
+    }
+#endif
+
+    hr = get_interface_in_git(&IID_IUIAutomationActiveTextPositionChangedEventHandler, com_event->git_cookie,
+            (IUnknown **)&handler);
+    if (SUCCEEDED(hr))
+    {
+        hr = IUIAutomationActiveTextPositionChangedEventHandler_HandleActiveTextPositionChangedEvent(handler, elem,
+                range);
+        IUIAutomationActiveTextPositionChangedEventHandler_Release(handler);
+    }
+    if (range)
+        IUIAutomationTextRange_Release(range);
+    return hr;
+}
+
+static HRESULT WINAPI uia_com_text_range_QueryInterface(IUIAutomationTextRange3 *iface, REFIID riid, void **ppv)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), ppv);
+
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUIAutomationTextRange3) || IsEqualIID(riid, &IID_IUIAutomationTextRange2)
+            || IsEqualIID(riid, &IID_IUIAutomationTextRange) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+    IUIAutomationTextRange3_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI uia_com_text_range_AddRef(IUIAutomationTextRange3 *iface)
+{
+    return InterlockedIncrement(&impl_from_IUIAutomationTextRange3(iface)->ref);
+}
+
+static ULONG WINAPI uia_com_text_range_Release(IUIAutomationTextRange3 *iface)
+{
+    struct uia_com_text_range *obj = impl_from_IUIAutomationTextRange3(iface);
+    ULONG ref = InterlockedDecrement(&obj->ref);
+
+    if (!ref)
+    {
+        UiaTextRangeRelease(obj->range);
+        IUIAutomationElement9_Release(&obj->element->IUIAutomationElement9_iface);
+        free(obj);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI uia_com_text_range_Clone(IUIAutomationTextRange3 *iface, IUIAutomationTextRange **ret)
+{
+    struct uia_com_text_range *obj = impl_from_IUIAutomationTextRange3(iface);
+    HUIATEXTRANGE range;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, ret);
+
+    if (!ret)
+        return E_POINTER;
+    *ret = NULL;
+    if (FAILED(hr = TextRange_Clone(obj->range, &range)))
+        return hr;
+    return uia_com_text_range_create(obj->element, range, ret);
+}
+
+static HRESULT WINAPI uia_com_text_range_Compare(IUIAutomationTextRange3 *iface, IUIAutomationTextRange *other, BOOL *same)
+{
