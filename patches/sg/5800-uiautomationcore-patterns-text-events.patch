+static void init_tprov(struct tprov *prov, struct pobj *obj, ULONGLONG pattern_mask)
+{
+    int i;
+
+    memset(prov, 0, sizeof(*prov));
+    prov->simple_iface.lpVtbl = &tprov_vtbl;
+    prov->frag_iface.lpVtbl = &tfrag_vtbl;
+    prov->root_iface.lpVtbl = &troot_vtbl;
+    prov->advise_iface.lpVtbl = &tadvise_vtbl;
+    prov->simple2_iface.lpVtbl = &tsimple2_vtbl;
+    prov->simple3_iface.lpVtbl = &tsimple3_vtbl;
+    prov->ref = 1;
+    prov->serial = next_serial++;
+    prov->has_fragment = TRUE;
+    prov->pattern_mask = pattern_mask;
+    prov->pobj = obj;
+
+    memset(obj, 0, sizeof(*obj));
+    obj->ref = 1;
+    obj->owner = prov;
+    obj->slot_mask = 0;
+    for (i = 0; i < S_COUNT; i++)
+    {
+        obj->slots[i].vtbl = slot_vtbls[i];
+        obj->slots[i].obj = obj;
+        if (slot_vtbls[i])
+            obj->slot_mask |= 1ull << i;
+    }
+}
+
+static void set_prop(struct tprov *prov, PROPERTYID id, const VARIANT *v)
+{
+    int i;
+
+    for (i = 0; i < prov->prop_count; i++)
+        if (prov->props[i].id == id)
+            break;
+    if (i == prov->prop_count)
+        prov->prop_count++;
+    prov->props[i].id = id;
+    VariantCopy(&prov->props[i].v, v);
+}
+
+static void set_prop_bool(struct tprov *prov, PROPERTYID id, BOOL val)
+{
+    VARIANT v;
+
+    V_VT(&v) = VT_BOOL;
+    V_BOOL(&v) = val ? VARIANT_TRUE : VARIANT_FALSE;
+    set_prop(prov, id, &v);
+}
+
+static void set_prop_bstr(struct tprov *prov, PROPERTYID id, const WCHAR *val)
+{
+    VARIANT v;
+
+    V_VT(&v) = VT_BSTR;
+    V_BSTR(&v) = SysAllocString(val);
+    set_prop(prov, id, &v);
+    VariantClear(&v);
+}
