+static void test_dispatch_bridge(struct fixture *f)
+{
+    IEnumVARIANT *enum1 = NULL, *enum2 = NULL;
+    IAccessible *acc = NULL;
+    ITypeInfo *info = NULL;
+    WNDCLASSW cls = { 0 };
+    struct tprov bprov;
+    struct pobj bobj;
+    DISPPARAMS params;
+    DISPID dispid = 0;
+    VARIANT arg, res;
+    ULONG fetched;
+    UINT count;
+    HWND hwnd;
+    HRESULT hr;
+    OLECHAR *name = (OLECHAR *)L"accName";
+
+    cls.lpfnWndProc = bridge_wndproc;
+    cls.hInstance = GetModuleHandleW(NULL);
+    cls.lpszClassName = L"sg_uia_bridge_class";
+    RegisterClassW(&cls);
+    hwnd = CreateWindowW(cls.lpszClassName, L"sg", WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, cls.hInstance, NULL);
+    init_tprov(&bprov, &bobj, ALL_PATTERNS);
+    init_fixture_values(&bobj, f->e);
+    bprov.hwnd = hwnd;
+    bprov.host_is_root = TRUE;
+    set_prop_bstr(&bprov, UIA_NamePropertyId, L"bridge name");
+    g_bridge_prov = &bprov;
+
+    hr = AccessibleObjectFromWindow(hwnd, OBJID_CLIENT, &IID_IAccessible, (void **)&acc);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (FAILED(hr))
+        goto done;
+
+    hr = IAccessible_GetTypeInfoCount(acc, &count);
+    ok(hr == S_OK && count == 1, "got hr %#lx, count %u.\n", hr, count);
+    hr = IAccessible_GetTypeInfo(acc, 0, 0, &info);
+    ok(hr == S_OK && info, "Unexpected hr %#lx.\n", hr);
+    if (info)
+        ITypeInfo_Release(info);
+    hr = IAccessible_GetTypeInfo(acc, 1, 0, &info);
+    ok(hr == DISP_E_BADINDEX, "Unexpected hr %#lx.\n", hr);
+
+    hr = IAccessible_GetIDsOfNames(acc, &null_guid, &name, 1, 0, &dispid);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(dispid == DISPID_ACC_NAME, "got dispid %ld.\n", dispid);
+    hr = IAccessible_GetIDsOfNames(acc, &IID_IAccessible, &name, 1, 0, &dispid);
+    ok(hr == DISP_E_UNKNOWNINTERFACE, "Unexpected hr %#lx.\n", hr);
+
+    V_VT(&arg) = VT_I4;
+    V_I4(&arg) = CHILDID_SELF;
+    params.rgvarg = &arg;
+    params.cArgs = 1;
+    params.rgdispidNamedArgs = NULL;
+    params.cNamedArgs = 0;
+    VariantInit(&res);
+    hr = IAccessible_Invoke(acc, DISPID_ACC_NAME, &null_guid, 0, DISPATCH_PROPERTYGET, &params, &res, NULL, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&res) == VT_BSTR && !wcscmp(V_BSTR(&res), L"bridge name"), "got vt %d.\n", V_VT(&res));
+    VariantClear(&res);
+    hr = IAccessible_Invoke(acc, DISPID_ACC_NAME, &IID_IAccessible, 0, DISPATCH_PROPERTYGET, &params, &res, NULL, NULL);
+    ok(hr == DISP_E_UNKNOWNINTERFACE, "Unexpected hr %#lx.\n", hr);
+    hr = IAccessible_Invoke(acc, 123456, &null_guid, 0, DISPATCH_PROPERTYGET, &params, &res, NULL, NULL);
+    ok(hr == DISP_E_MEMBERNOTFOUND, "Unexpected hr %#lx.\n", hr);
+
+    /* A selection of several objects is an enumeration that can be cloned. */
+    VariantInit(&res);
+    hr = IAccessible_get_accSelection(acc, &res);
+    ok(hr == S_OK && V_VT(&res) == VT_UNKNOWN, "got hr %#lx, vt %d.\n", hr, V_VT(&res));
+    if (hr == S_OK && V_VT(&res) == VT_UNKNOWN)
+    {
+        hr = IUnknown_QueryInterface(V_UNKNOWN(&res), &IID_IEnumVARIANT, (void **)&enum1);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    }
+    VariantClear(&res);
+    if (enum1)
+    {
+        VARIANT item;
+
+        VariantInit(&item);
+        hr = IEnumVARIANT_Next(enum1, 1, &item, &fetched);
+        ok(hr == S_OK && fetched == 1 && V_VT(&item) == VT_DISPATCH, "got hr %#lx, vt %d.\n", hr, V_VT(&item));
+        VariantClear(&item);
+
+        hr = IEnumVARIANT_Clone(enum1, &enum2);
+        ok(hr == S_OK && enum2, "Unexpected hr %#lx.\n", hr);
+        if (enum2)
+        {
+            /* The clone continues where the original is, and moves on its own. */
+            hr = IEnumVARIANT_Next(enum2, 1, &item, &fetched);
+            ok(hr == S_OK && fetched == 1, "got hr %#lx.\n", hr);
+            VariantClear(&item);
+            hr = IEnumVARIANT_Next(enum2, 1, &item, &fetched);
+            ok(hr == S_FALSE && fetched == 0, "got hr %#lx, fetched %lu.\n", hr, fetched);
+            hr = IEnumVARIANT_Next(enum1, 1, &item, &fetched);
+            ok(hr == S_OK && fetched == 1, "got hr %#lx.\n", hr);
+            VariantClear(&item);
+            IEnumVARIANT_Release(enum2);
+        }
+        IEnumVARIANT_Release(enum1);
+    }
+    IAccessible_Release(acc);
+
+done:
+    g_bridge_prov = NULL;
+    DestroyWindow(hwnd);
+    UnregisterClassW(cls.lpszClassName, cls.hInstance);
+}
