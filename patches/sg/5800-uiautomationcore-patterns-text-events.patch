+static void test_poll_potential_support(IUIAutomation *uia, IUIAutomationElement *el)
+{
+    SAFEARRAY *ids = NULL, *names = NULL;
+    LONG lb, ub, i, idx;
+    BOOL has_invoke = FALSE, has_dock = FALSE;
+    HRESULT hr;
+
+    hr = IUIAutomation_PollForPotentialSupportedPatterns(uia, el, &ids, &names);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        SafeArrayGetLBound(ids, 1, &lb);
+        SafeArrayGetUBound(ids, 1, &ub);
+        for (i = lb; i <= ub; i++)
+        {
+            int id = 0;
+            BSTR n = NULL;
+
+            idx = i;
+            SafeArrayGetElement(ids, &idx, &id);
+            SafeArrayGetElement(names, &idx, &n);
+            ok(n && *n, "pattern %d has no name.\n", id);
+            SysFreeString(n);
+            has_invoke |= id == UIA_InvokePatternId;
+            has_dock |= id == UIA_DockPatternId;
+        }
+        ok(ub - lb + 1 > 20, "got %ld patterns.\n", ub - lb + 1);
+        ok(has_invoke && has_dock, "missing patterns: %d %d.\n", has_invoke, has_dock);
+        SafeArrayDestroy(ids);
+        SafeArrayDestroy(names);
+    }
+
+    ids = names = NULL;
+    hr = IUIAutomation_PollForPotentialSupportedProperties(uia, el, &ids, &names);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        SafeArrayGetLBound(ids, 1, &lb);
+        SafeArrayGetUBound(ids, 1, &ub);
+        ok(ub - lb + 1 > 10, "got %ld properties.\n", ub - lb + 1);
+        SafeArrayDestroy(ids);
+        SafeArrayDestroy(names);
+    }
+    hr = IUIAutomation_PollForPotentialSupportedPatterns(uia, NULL, &ids, &names);
+    ok(hr == E_POINTER || hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+}
