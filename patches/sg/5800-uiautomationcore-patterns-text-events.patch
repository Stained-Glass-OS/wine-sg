+/* The file name of the program a window belongs to. */
+static BSTR get_hwnd_image_name(HWND hwnd)
+{
+    WCHAR path[MAX_PATH], *name;
+    DWORD pid, len = ARRAY_SIZE(path);
+    HANDLE process;
+    BSTR ret = NULL;
+
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (!(process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)))
+        return NULL;
+    if (QueryFullProcessImageNameW(process, 0, path, &len))
+    {
+        name = wcsrchr(path, '\\');
+        ret = SysAllocString(name ? name + 1 : path);
+    }
+    CloseHandle(process);
+    return ret;
+}
+
+static BOOL proxy_name_matches(const WCHAR *name, const WCHAR *pattern, BOOL substring)
+{
+    size_t len = wcslen(pattern), name_len = wcslen(name);
+
+    if (!substring)
+        return !wcsicmp(name, pattern);
+
+    for (; len <= name_len; name++, name_len--)
+    {
+        if (!wcsnicmp(name, pattern, len))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/*
+ * The provider of a window as the first matching entry of the table makes it.
+ * An entry matches by window class, program, or both; one that names neither
+ * matches nothing.
+ */
+HRESULT uia_proxy_factory_create_provider(HWND hwnd, IRawElementProviderSimple **out)
+{
+    WCHAR class_name[256];
+    BSTR image_name = NULL;
+    UINT i, count;
+    HRESULT hr = S_FALSE;
+
+    *out = NULL;
+    EnterCriticalSection(&proxy_table_cs);
+    count = proxy_table.count;
+    LeaveCriticalSection(&proxy_table_cs);
+    if (!count || !GetClassNameW(hwnd, class_name, ARRAY_SIZE(class_name)))
+        return S_FALSE;
+
+    for (i = 0; i < count && hr == S_FALSE; i++)
+    {
+        IUIAutomationProxyFactoryEntry *entry = NULL;
+        IUIAutomationProxyFactory *factory = NULL;
+        BSTR entry_class = NULL, entry_image = NULL;
+        BOOL substring = FALSE, match;
+
+        EnterCriticalSection(&proxy_table_cs);
+        if (i < proxy_table.count)
+        {
+            entry = proxy_table.entries[i];
+            IUIAutomationProxyFactoryEntry_AddRef(entry);
+        }
+        LeaveCriticalSection(&proxy_table_cs);
+        if (!entry)
+            break;
+
+        IUIAutomationProxyFactoryEntry_get_ClassName(entry, &entry_class);
+        IUIAutomationProxyFactoryEntry_get_ImageName(entry, &entry_image);
+        IUIAutomationProxyFactoryEntry_get_AllowSubstringMatch(entry, &substring);
+
+        match = (entry_class && *entry_class) || (entry_image && *entry_image);
+        if (match && entry_class && *entry_class)
+            match = proxy_name_matches(class_name, entry_class, substring);
+#ifdef SG_MUTANT_UIAPROXY_ANY_CLASS
+        match = TRUE;
+#endif
+        if (match && entry_image && *entry_image)
+        {
+            if (!image_name)
+                image_name = get_hwnd_image_name(hwnd);
+            match = image_name && proxy_name_matches(image_name, entry_image, FALSE);
+        }
+        SysFreeString(entry_class);
+        SysFreeString(entry_image);
+
+        if (match && SUCCEEDED(IUIAutomationProxyFactoryEntry_get_ProxyFactory(entry, &factory)) && factory)
+        {
+            IRawElementProviderSimple *elprov = NULL;
+
+            hr = IUIAutomationProxyFactory_CreateProvider(factory, (UIA_HWND)hwnd, OBJID_CLIENT, CHILDID_SELF,
+                    &elprov);
+            if (SUCCEEDED(hr) && elprov)
+            {
+                *out = elprov;
+                hr = S_OK;
+            }
+            else
+                hr = S_FALSE;
+            IUIAutomationProxyFactory_Release(factory);
+        }
+        IUIAutomationProxyFactoryEntry_Release(entry);
+    }
+
+    SysFreeString(image_name);
+    return hr;
+}
