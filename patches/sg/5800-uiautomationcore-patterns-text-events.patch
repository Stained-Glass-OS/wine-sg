+}
+
+static HRESULT WINAPI uia_proxy_entry_put_ImageName(IUIAutomationProxyFactoryEntry *iface, LPCWSTR name)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
+
+    TRACE("%p, %s\n", iface, debugstr_w(name));
+    return proxy_entry_set_bstr(entry, &entry->image_name, name);
+}
+
+static HRESULT WINAPI uia_proxy_entry_put_AllowSubstringMatch(IUIAutomationProxyFactoryEntry *iface, BOOL val)
+{
+    TRACE("%p, %d\n", iface, val);
+    impl_from_IUIAutomationProxyFactoryEntry(iface)->allow_substring = !!val;
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_entry_put_CanCheckBaseClass(IUIAutomationProxyFactoryEntry *iface, BOOL val)
+{
+    TRACE("%p, %d\n", iface, val);
+    impl_from_IUIAutomationProxyFactoryEntry(iface)->check_base_class = !!val;
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_entry_put_NeedsAdviseEvents(IUIAutomationProxyFactoryEntry *iface, BOOL val)
+{
+    TRACE("%p, %d\n", iface, val);
+    impl_from_IUIAutomationProxyFactoryEntry(iface)->needs_advise_events = !!val;
+    return S_OK;
+}
+
+/* The WinEvents that stand for an automation event (for a property changed event, one property). */
+static HRESULT WINAPI uia_proxy_entry_SetWinEventsForAutomationEvent(IUIAutomationProxyFactoryEntry *iface,
+        EVENTID event_id, PROPERTYID prop_id, SAFEARRAY *win_events)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
+    SAFEARRAY *copy = NULL;
+    HRESULT hr = S_OK;
+    int i;
+
+    TRACE("%p, %d, %d, %p\n", iface, event_id, prop_id, win_events);
+
+    if (!uia_event_info_from_id(event_id))
+        return E_INVALIDARG;
+    if (win_events && FAILED(hr = SafeArrayCopy(win_events, &copy)))
+        return hr;
+
+    EnterCriticalSection(&entry->cs);
+    for (i = 0; i < entry->win_events_count; i++)
+    {
+        if (entry->win_events[i].event_id == event_id && entry->win_events[i].prop_id == prop_id)
+            break;
+    }
+    if (i == entry->win_events_count)
+    {
+        struct uia_win_event_map *map = realloc(entry->win_events, (i + 1) * sizeof(*map));
+
+        if (!map)
+        {
+            LeaveCriticalSection(&entry->cs);
+            SafeArrayDestroy(copy);
+            return E_OUTOFMEMORY;
+        }
+        entry->win_events = map;
+        entry->win_events[i].event_id = event_id;
+        entry->win_events[i].prop_id = prop_id;
+        entry->win_events[i].win_events = NULL;
+        entry->win_events_count++;
+    }
+    SafeArrayDestroy(entry->win_events[i].win_events);
+    entry->win_events[i].win_events = copy;
+    LeaveCriticalSection(&entry->cs);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_entry_GetWinEventsForAutomationEvent(IUIAutomationProxyFactoryEntry *iface,
+        EVENTID event_id, PROPERTYID prop_id, SAFEARRAY **win_events)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
+    HRESULT hr = S_OK;
+    int i;
+
+    TRACE("%p, %d, %d, %p\n", iface, event_id, prop_id, win_events);
+
+    if (!win_events)
+        return E_POINTER;
+    *win_events = NULL;
+    if (!uia_event_info_from_id(event_id))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&entry->cs);
+    for (i = 0; i < entry->win_events_count; i++)
+    {
+        if (entry->win_events[i].event_id == event_id && entry->win_events[i].prop_id == prop_id)
+        {
+            if (entry->win_events[i].win_events)
+                hr = SafeArrayCopy(entry->win_events[i].win_events, win_events);
+            break;
+        }
+    }
+    LeaveCriticalSection(&entry->cs);
+
+    /* nothing set: an empty list */
+    if (SUCCEEDED(hr) && !*win_events && !(*win_events = SafeArrayCreateVector(VT_UI4, 0, 0)))
+        hr = E_OUTOFMEMORY;
+    return hr;
+}
