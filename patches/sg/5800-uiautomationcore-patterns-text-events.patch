+/* Proxy factory mapping. */
+struct tfactory
+{
+    IUIAutomationProxyFactory iface;
+    struct tprov *prov;
+    int calls;
+    HWND last_hwnd;
+    LONG last_obj;
+};
+
+static HRESULT WINAPI tfactory_QueryInterface(IUIAutomationProxyFactory *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUIAutomationProxyFactory) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI tfactory_AddRef(IUIAutomationProxyFactory *iface) { return 2; }
+static ULONG WINAPI tfactory_Release(IUIAutomationProxyFactory *iface) { return 1; }
+static HRESULT WINAPI tfactory_CreateProvider(IUIAutomationProxyFactory *iface, UIA_HWND hwnd, LONG obj, LONG child,
+        IRawElementProviderSimple **ret)
+{
+    struct tfactory *f = CONTAINING_RECORD(iface, struct tfactory, iface);
+
+    f->calls++;
+    f->last_hwnd = hwnd;
+    f->last_obj = obj;
+    *ret = tprov_simple(f->prov);
+    return S_OK;
+}
+static HRESULT WINAPI tfactory_get_ProxyFactoryId(IUIAutomationProxyFactory *iface, BSTR *id)
+{
+    *id = SysAllocString(L"sg.test.factory");
+    return S_OK;
+}
+static const IUIAutomationProxyFactoryVtbl tfactory_vtbl =
+{
+    tfactory_QueryInterface, tfactory_AddRef, tfactory_Release, tfactory_CreateProvider, tfactory_get_ProxyFactoryId,
+};
+
+static void test_proxy_factory_mapping(void)
+{
+    IUIAutomationProxyFactoryMapping *map;
+    IUIAutomationProxyFactoryEntry *entry, *entry2;
+    IUIAutomationElement *el;
+    IUIAutomation6 *uia6;
+    IUIAutomation *uia;
+    struct tfactory factory;
+    struct tprov prov;
+    struct pobj obj;
+    WNDCLASSW cls = { 0 };
+    HWND hwnd;
+    BSTR str;
+    UINT count;
+    BOOL b;
+    VARIANT v;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_CUIAutomation8, NULL, CLSCTX_INPROC_SERVER, &IID_IUIAutomation6, (void **)&uia6);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (FAILED(hr))
+        return;
+
+    IUIAutomation6_QueryInterface(uia6, &IID_IUIAutomation, (void **)&uia);
+    cls.lpfnWndProc = DefWindowProcW;
+    cls.hInstance = GetModuleHandleW(NULL);
+    cls.lpszClassName = L"sg_uia_proxied_class";
+    RegisterClassW(&cls);
+    hwnd = CreateWindowW(cls.lpszClassName, L"sg", WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, cls.hInstance, NULL);
+
+    init_tprov(&prov, &obj, 0);
+    prov.hwnd = hwnd;
+    set_prop_bstr(&prov, UIA_NamePropertyId, L"proxied");
+    factory.iface.lpVtbl = &tfactory_vtbl;
+    factory.prov = &prov;
+    factory.calls = 0;
+
+    hr = IUIAutomation6_get_ProxyFactoryMapping(uia6, &map);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomation6_CreateProxyFactoryEntry(uia6, &factory.iface, &entry);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* A new entry has no names and does not match anything. */
+    str = (BSTR)0xdeadbeef;
+    hr = IUIAutomationProxyFactoryEntry_get_ClassName(entry, &str);
+    ok(hr == S_OK && (!str || !*str), "got hr %#lx, %s.\n", hr, wine_dbgstr_w(str));
+    SysFreeString(str);
+    hr = IUIAutomationProxyFactoryEntry_put_ClassName(entry, L"sg_uia_proxied_class");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationProxyFactoryEntry_get_ClassName(entry, &str);
+    ok(hr == S_OK && str && !wcscmp(str, L"sg_uia_proxied_class"), "got hr %#lx, %s.\n", hr, wine_dbgstr_w(str));
+    SysFreeString(str);
+    hr = IUIAutomationProxyFactoryEntry_put_AllowSubstringMatch(entry, TRUE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationProxyFactoryEntry_get_AllowSubstringMatch(entry, &b);
+    ok(hr == S_OK && b == TRUE, "got hr %#lx, %d.\n", hr, b);
+    hr = IUIAutomationProxyFactoryEntry_put_AllowSubstringMatch(entry, FALSE);
+    hr = IUIAutomationProxyFactoryEntry_get_AllowSubstringMatch(entry, &b);
+    ok(hr == S_OK && b == FALSE, "got hr %#lx, %d.\n", hr, b);
+
+    hr = IUIAutomationProxyFactoryMapping_ClearTable(map);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationProxyFactoryMapping_get_Count(map, &count);
+    ok(hr == S_OK && count == 0, "got hr %#lx, count %u.\n", hr, count);
+    hr = IUIAutomationProxyFactoryMapping_InsertEntry(map, 0, entry);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationProxyFactoryMapping_get_Count(map, &count);
+    ok(hr == S_OK && count == 1, "got hr %#lx, count %u.\n", hr, count);
+    hr = IUIAutomationProxyFactoryMapping_GetEntry(map, 0, &entry2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IUIAutomationProxyFactoryEntry_get_ClassName(entry2, &str);
+        ok(hr == S_OK && str && !wcscmp(str, L"sg_uia_proxied_class"), "got hr %#lx, %s.\n", hr, wine_dbgstr_w(str));
+        SysFreeString(str);
+        IUIAutomationProxyFactoryEntry_Release(entry2);
+    }
+    hr = IUIAutomationProxyFactoryMapping_GetEntry(map, 1, &entry2);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
+    /* The window has no provider of its own, so the factory is asked. */
+    hr = IUIAutomation_ElementFromHandle(uia, hwnd, &el);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(factory.calls > 0, "the factory was not asked.\n");
+    ok(factory.last_hwnd == hwnd, "got hwnd %p.\n", factory.last_hwnd);
+    ok(factory.last_obj == OBJID_CLIENT, "got object id %ld.\n", factory.last_obj);
+    if (el)
+    {
+        VariantInit(&v);
+        hr = IUIAutomationElement_GetCurrentPropertyValue(el, UIA_NamePropertyId, &v);
+        ok(hr == S_OK && V_VT(&v) == VT_BSTR && V_BSTR(&v) && !wcscmp(V_BSTR(&v), L"proxied"), "got hr %#lx, vt %d.\n", hr,
+                V_VT(&v));
+        VariantClear(&v);
+        IUIAutomationElement_Release(el);
+    }
+
+    /* A class that does not match is not asked. */
+    factory.calls = 0;
+    hr = IUIAutomationProxyFactoryEntry_put_ClassName(entry, L"some_other_class");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomation_ElementFromHandle(uia, hwnd, &el);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!factory.calls, "the factory was asked for a different class.\n");
+    if (el)
+        IUIAutomationElement_Release(el);
+
+    /* Substring matching. */
+    hr = IUIAutomationProxyFactoryEntry_put_ClassName(entry, L"proxied");
+    hr = IUIAutomationProxyFactoryEntry_put_AllowSubstringMatch(entry, TRUE);
+    hr = IUIAutomation_ElementFromHandle(uia, hwnd, &el);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(factory.calls > 0, "the factory was not asked for a substring match.\n");
+    if (el)
+        IUIAutomationElement_Release(el);
+
+    hr = IUIAutomationProxyFactoryMapping_RemoveEntry(map, 0);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationProxyFactoryMapping_get_Count(map, &count);
+    ok(hr == S_OK && count == 0, "got hr %#lx, count %u.\n", hr, count);
+    hr = IUIAutomationProxyFactoryMapping_RemoveEntry(map, 0);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
+    hr = IUIAutomationProxyFactoryMapping_RestoreDefaultTable(map);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationProxyFactoryMapping_get_Count(map, &count);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IUIAutomationProxyFactoryMapping_ClearTable(map);
+
+    IUIAutomationProxyFactoryEntry_Release(entry);
+    IUIAutomationProxyFactoryMapping_Release(map);
+    IUIAutomation_Release(uia);
+    IUIAutomation6_Release(uia6);
+    DestroyWindow(hwnd);
+    UnregisterClassW(cls.lpszClassName, cls.hInstance);
+}
