+++ b/dlls/uiautomationcore/Makefile.in
@@ -17,4 +17,5 @@ SOURCES = \
 	uia_text.c \
 	uia_main.c \
 	uia_provider.c \
+	uia_proxy.c \
 	uia_utils.c
--- a/dlls/uiautomationcore/tests/Makefile.in
+++ b/dlls/uiautomationcore/tests/Makefile.in
