+/* The ids and names of the patterns or properties an element has, as two arrays that go together. */
+static HRESULT poll_potential_support(IUIAutomationElement *elem, BOOL patterns, SAFEARRAY **out_ids,
+        SAFEARRAY **out_names)
+{
+    struct uia_element *element = unsafe_impl_from_element(elem);
+    SAFEARRAY *ids, *names;
+    int first = patterns ? UIA_InvokePatternId : 30000, last = patterns ? UIA_SelectionPattern2Id : UIA_IsDialogPropertyId;
+    int id, n = 0, *found;
+    HRESULT hr = S_OK;
+    IUnknown *not_supported = NULL;
+    LONG i;
+
+    if (!out_ids || !out_names)
+        return E_POINTER;
+    *out_ids = *out_names = NULL;
+    if (!elem)
+        return E_POINTER;
+    if (!element)
+        return E_INVALIDARG;
+    if (element->cache_only)
+        return UIA_E_NOTSUPPORTED;
+
+    if (!(found = calloc(last - first + 1, sizeof(*found))))
+        return E_OUTOFMEMORY;
+    UiaGetReservedNotSupportedValue(&not_supported);
+    for (id = first; id <= last; id++)
+    {
+        if (patterns)
+        {
+            HUIAPATTERNOBJECT obj = NULL;
