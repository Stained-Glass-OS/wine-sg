+static void test_node_standin(IUIAutomation *uia, IUIAutomationElement *host_el)
+{
+    IUIAutomationItemContainerPattern *p = NULL;
+    IUIAutomationElement *other = NULL, *found = NULL;
+    struct tprov tp, te[4];
+    struct pobj tobj, teo[4];
+    HANDLE thread;
+    IUnknown *unk = NULL;
+    VARIANT v;
+    HRESULT hr;
+    int i;
+
+    for (i = 0; i < 4; i++)
+        init_tprov(&te[i], &teo[i], 0);
+    init_tprov(&tp, &tobj, ALL_PATTERNS);
+    init_fixture_values(&tobj, te);
+    tp.hwnd = NULL;
+    tp.rect.left = 1; tp.rect.top = 2; tp.rect.width = 30; tp.rect.height = 40;
+    g_thread_prov = &tp;
+    g_thread_ready = CreateEventW(NULL, FALSE, FALSE, NULL);
+    thread = CreateThread(NULL, 0, thread_window_proc, NULL, 0, NULL);
+    WaitForSingleObject(g_thread_ready, 5000);
+    tp.hwnd = g_thread_hwnd;
+
+    hr = IUIAutomation_ElementFromHandle(uia, g_thread_hwnd, &other);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IUIAutomationElement_GetCurrentPattern(host_el, UIA_ItemContainerPatternId, &unk);
+    ok(hr == S_OK && unk, "Unexpected hr %#lx.\n", hr);
+    if (unk && other)
+    {
+        IUIAutomationItemContainerPattern_QueryInterface((IUIAutomationItemContainerPattern *)unk,
+                &IID_IUIAutomationItemContainerPattern, (void **)&p);
+        V_VT(&v) = VT_I4; V_I4(&v) = 5;
+        g_host->pobj->found = NULL;
+        g_host->pobj->log[0] = 0;
+        hr = IUIAutomationItemContainerPattern_FindItemByProperty(p, other, UIA_ControlTypePropertyId, v, &found);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(!strcmp(g_host->pobj->log, "FindItemByProperty(1,30003,5);focus=0;rect=1,2,30,40;"), "got log %s.\n",
+                g_host->pobj->log);
+        g_host->pobj->log[0] = 0;
+        if (found) IUIAutomationElement_Release(found);
+        IUIAutomationItemContainerPattern_Release(p);
+    }
+    if (unk) IUnknown_Release(unk);
+    if (other)
+    {
+        IUIAutomationSelectionPattern *sel = NULL;
+        IUIAutomationElementArray *arr = NULL;
+
+        /* Element arrays cross threads as references to the elements. */
+        VariantInit(&v);
+        hr = IUIAutomationElement_GetCurrentPropertyValue(other, UIA_SelectionSelectionPropertyId, &v);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(V_VT(&v) == VT_UNKNOWN && V_UNKNOWN(&v), "got vt %d.\n", V_VT(&v));
+        if (V_VT(&v) == VT_UNKNOWN && V_UNKNOWN(&v))
+        {
+            hr = IUnknown_QueryInterface(V_UNKNOWN(&v), &IID_IUIAutomationElementArray, (void **)&arr);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            if (arr)
+                check_elem_array(arr, 2, te[0].serial, te[1].serial);
+        }
+        VariantClear(&v);
+
+        hr = IUIAutomationElement_GetCurrentPattern(other, UIA_SelectionPatternId, &unk);
+        ok(hr == S_OK && unk, "Unexpected hr %#lx.\n", hr);
+        if (unk)
+        {
+            IUnknown_QueryInterface(unk, &IID_IUIAutomationSelectionPattern, (void **)&sel);
+            IUnknown_Release(unk);
+        }
+        if (sel)
+        {
+            S(IUIAutomationSelectionPattern_GetCurrentSelection(sel, &arr));
+            check_elem_array(arr, 2, te[0].serial, te[1].serial);
+            IUIAutomationSelectionPattern_Release(sel);
+        }
+    }
+    ok(tp.set_focus_calls > 0, "the element in the other thread was not asked to take focus.\n");
+    if (other) IUIAutomationElement_Release(other);
+
+    PostMessageW(g_thread_hwnd, WM_QUIT, 0, 0);
+    PostThreadMessageW(GetThreadId(thread), WM_QUIT, 0, 0);
+    WaitForSingleObject(thread, 5000);
+    CloseHandle(thread);
+    CloseHandle(g_thread_ready);
+    g_thread_prov = NULL;
+}
