+/*
+ * A provider hands back an array of elements as a SAFEARRAY of
+ * IRawElementProviderSimple (VT_UNKNOWN, or VT_VARIANT holding one each).
+ * For a node that is being used from another thread or process the elements
+ * leave as LRESULTs, which can be marshaled; otherwise they become HUIANODEs.
+ */
+static HRESULT uia_provider_elprov_array_to_variant(struct uia_provider *prov, SAFEARRAY *sa, VARIANT *ret_val)
+{
+    LONG lbound, elems, i, idx;
+    SAFEARRAY *out;
+    VARTYPE vt;
+    HRESULT hr;
+
+    VariantInit(ret_val);
+    if (!sa || FAILED(SafeArrayGetVartype(sa, &vt)) || SafeArrayGetDim(sa) != 1)
+        return S_OK;
+    if (vt != VT_UNKNOWN && vt != VT_DISPATCH && vt != VT_VARIANT)
+        return S_OK;
+    if (FAILED(get_safearray_bounds(sa, &lbound, &elems)))
+        return S_OK;
+
+    if (!(out = SafeArrayCreateVector(prov->return_nested_node ? VT_I4 : VT_UINT_PTR, 0, elems)))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < elems; i++)
+    {
+        IRawElementProviderSimple *elprov;
+        IUnknown *unk = NULL;
+        VARIANT v;
+
+        idx = lbound + i;
+        if (vt == VT_VARIANT)
+        {
