+/* An attribute that is a list of elements comes back from the C layer as nodes; a client gets elements. */
+static HRESULT uia_com_text_attribute_value(struct uia_element *element, TEXTATTRIBUTEID attr, VARIANT *v)
+{
+    if (attr == UIA_AnnotationObjectsAttributeId && V_VT(v) == (VT_UNKNOWN | VT_ARRAY))
+    {
+        SAFEARRAY *sa = V_ARRAY(v);
+        VARIANT ptrs;
+        LONG lbound, elems, i;
+        HRESULT hr;
+
+        if (FAILED(hr = get_safearray_bounds(sa, &lbound, &elems)))
+            return hr;
+        V_VT(&ptrs) = VT_UINT_PTR | VT_ARRAY;
+        if (!(V_ARRAY(&ptrs) = SafeArrayCreateVector(VT_UINT_PTR, 0, elems)))
+            return E_OUTOFMEMORY;
+        for (i = 0; i < elems; i++)
+        {
+            LONG idx = lbound + i;
+            IUnknown *unk = NULL;
+
+            if (FAILED(hr = SafeArrayGetElement(sa, &idx, &unk)))
+                break;
+            /* the nodes are held by the array; the array of pointers gets its own reference */
+            hr = SafeArrayPutElement(V_ARRAY(&ptrs), &i, unk);
+            if (SUCCEEDED(hr))
+                IUnknown_AddRef(unk);
+            IUnknown_Release(unk);
+            if (FAILED(hr))
+                break;
+        }
+        if (FAILED(hr))
+        {
+            SafeArrayDestroy(V_ARRAY(&ptrs));
+            return hr;
+        }
+        VariantClear(v);
+        *v = ptrs;
+        return get_element_variant_from_node_variant(v, element->from_cui8, UIAutomationType_ElementArray);
+    }
+    return S_OK;
+}
