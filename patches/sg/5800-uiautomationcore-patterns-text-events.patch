+static void test_event_remove_window(void)
+{
+    struct UiaCacheRequest req = { (struct UiaCondition *)&true_cond, TreeScope_Element, NULL, 0, NULL, 0,
+        AutomationElementMode_Full };
+    struct tprov prov[2];
+    struct pobj obj[2];
+    WNDCLASSW cls = { 0 };
+    HUIAEVENT event = NULL;
+    HUIANODE node = NULL;
+    HRESULT hr;
+    int i;
+
+    cls.lpfnWndProc = event_wndproc;
+    cls.hInstance = GetModuleHandleW(NULL);
+    cls.lpszClassName = L"sg_uia_event_class";
+    RegisterClassW(&cls);
+    for (i = 0; i < 2; i++)
+    {
+        g_event_hwnd[i] = CreateWindowW(cls.lpszClassName, L"sg", WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL,
+                cls.hInstance, NULL);
+        init_tprov(&prov[i], &obj[i], 0);
+        prov[i].hwnd = g_event_hwnd[i];
+        prov[i].host_is_root = TRUE;
+        prov[i].advise_supported = TRUE;
+        g_event_prov[i] = &prov[i];
+    }
+
+    hr = UiaNodeFromHandle(g_event_hwnd[0], &node);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = UiaAddEvent(node, UIA_AutomationFocusChangedEventId, event_remove_callback, TreeScope_Element, NULL, 0, &req,
+            &event);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    UiaNodeRelease(node);
+
+    hr = UiaEventAddWindow(event, g_event_hwnd[1]);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(prov[1].advise_added == 1, "got %ld advises for the added window.\n", prov[1].advise_added);
+
+    hr = UiaEventRemoveWindow(event, g_event_hwnd[1]);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(prov[1].advise_removed == 1, "got %ld removals for the removed window.\n", prov[1].advise_removed);
+    ok(prov[0].advise_removed == 0, "the other window lost its adviser (%ld removals).\n", prov[0].advise_removed);
+
+    /* Nothing is left to remove for it. */
+    hr = UiaEventRemoveWindow(event, g_event_hwnd[1]);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(prov[1].advise_removed == 1, "got %ld removals.\n", prov[1].advise_removed);
+
+    hr = UiaEventRemoveWindow(event, NULL);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
+    hr = UiaRemoveEvent(event);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(prov[1].advise_removed == 1, "the removed window was removed again (%ld).\n", prov[1].advise_removed);
+    ok(prov[0].advise_removed == prov[0].advise_added, "got %ld removals for %ld advises.\n", prov[0].advise_removed,
+            prov[0].advise_added);
+
+    for (i = 0; i < 2; i++)
+    {
+        g_event_prov[i] = NULL;
+        DestroyWindow(g_event_hwnd[i]);
+    }
+    UnregisterClassW(cls.lpszClassName, cls.hInstance);
+}
