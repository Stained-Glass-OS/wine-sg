+    uia_proxy_entry_get_ProxyFactory,
+    uia_proxy_entry_get_ClassName,
+    uia_proxy_entry_get_ImageName,
+    uia_proxy_entry_get_AllowSubstringMatch,
+    uia_proxy_entry_get_CanCheckBaseClass,
+    uia_proxy_entry_get_NeedsAdviseEvents,
+    uia_proxy_entry_put_ClassName,
+    uia_proxy_entry_put_ImageName,
+    uia_proxy_entry_put_AllowSubstringMatch,
+    uia_proxy_entry_put_CanCheckBaseClass,
+    uia_proxy_entry_put_NeedsAdviseEvents,
+    uia_proxy_entry_SetWinEventsForAutomationEvent,
+    uia_proxy_entry_GetWinEventsForAutomationEvent,
+};
+
+HRESULT uia_proxy_factory_entry_create(IUIAutomationProxyFactory *factory, IUIAutomationProxyFactoryEntry **out)
+{
+    struct uia_proxy_entry *entry;
+
+    *out = NULL;
+    if (!factory)
+        return E_INVALIDARG;
+    if (!(entry = calloc(1, sizeof(*entry))))
+        return E_OUTOFMEMORY;
+
+    entry->IUIAutomationProxyFactoryEntry_iface.lpVtbl = &uia_proxy_entry_vtbl;
+    entry->ref = 1;
+    entry->factory = factory;
+    IUIAutomationProxyFactory_AddRef(factory);
+    InitializeCriticalSectionEx(&entry->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    entry->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": uia_proxy_entry.cs");
+
+    *out = &entry->IUIAutomationProxyFactoryEntry_iface;
+    return S_OK;
+}
+
+/*
+ * The table of entries for the process. A mapping object is a handle to it.
+ */
+static CRITICAL_SECTION proxy_table_cs;
+static CRITICAL_SECTION_DEBUG proxy_table_cs_debug =
+{
+    0, 0, &proxy_table_cs,
+    { &proxy_table_cs_debug.ProcessLocksList, &proxy_table_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": proxy_table_cs") }
+};
+static CRITICAL_SECTION proxy_table_cs = { &proxy_table_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct
+{
+    IUIAutomationProxyFactoryEntry **entries;
+    UINT count;
+    SIZE_T size;
+} proxy_table;
+
+struct uia_proxy_mapping
+{
+    IUIAutomationProxyFactoryMapping IUIAutomationProxyFactoryMapping_iface;
+    LONG ref;
+};
+
+static inline struct uia_proxy_mapping *impl_from_IUIAutomationProxyFactoryMapping(
+        IUIAutomationProxyFactoryMapping *iface)
+{
+    return CONTAINING_RECORD(iface, struct uia_proxy_mapping, IUIAutomationProxyFactoryMapping_iface);
+}
+
+static HRESULT WINAPI uia_proxy_mapping_QueryInterface(IUIAutomationProxyFactoryMapping *iface, REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUIAutomationProxyFactoryMapping) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+
+    IUIAutomationProxyFactoryMapping_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI uia_proxy_mapping_AddRef(IUIAutomationProxyFactoryMapping *iface)
+{
+    return InterlockedIncrement(&impl_from_IUIAutomationProxyFactoryMapping(iface)->ref);
+}
+
+static ULONG WINAPI uia_proxy_mapping_Release(IUIAutomationProxyFactoryMapping *iface)
+{
+    struct uia_proxy_mapping *mapping = impl_from_IUIAutomationProxyFactoryMapping(iface);
+    ULONG ref = InterlockedDecrement(&mapping->ref);
+
+    if (!ref)
+        free(mapping);
+    return ref;
+}
+
+static HRESULT WINAPI uia_proxy_mapping_get_Count(IUIAutomationProxyFactoryMapping *iface, UINT *count)
+{
+    TRACE("%p, %p\n", iface, count);
+
+    if (!count)
+        return E_POINTER;
+    EnterCriticalSection(&proxy_table_cs);
+    *count = proxy_table.count;
+    LeaveCriticalSection(&proxy_table_cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_mapping_GetTable(IUIAutomationProxyFactoryMapping *iface, SAFEARRAY **table)
+{
+    SAFEARRAY *sa;
+    UINT i;
+
+    TRACE("%p, %p\n", iface, table);
+
+    if (!table)
+        return E_POINTER;
+    *table = NULL;
+
+    EnterCriticalSection(&proxy_table_cs);
+    if (!(sa = SafeArrayCreateVector(VT_UNKNOWN, 0, proxy_table.count)))
+    {
+        LeaveCriticalSection(&proxy_table_cs);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < proxy_table.count; i++)
+    {
+        LONG idx = i;
+
+        SafeArrayPutElement(sa, &idx, proxy_table.entries[i]);
+    }
+    LeaveCriticalSection(&proxy_table_cs);
+
+    *table = sa;
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_mapping_GetEntry(IUIAutomationProxyFactoryMapping *iface, UINT index,
+        IUIAutomationProxyFactoryEntry **entry)
+{
+    HRESULT hr = E_INVALIDARG;
+
+    TRACE("%p, %u, %p\n", iface, index, entry);
+
+    if (!entry)
+        return E_POINTER;
+    *entry = NULL;
+
+    EnterCriticalSection(&proxy_table_cs);
+    if (index < proxy_table.count)
+    {
+        *entry = proxy_table.entries[index];
+        IUIAutomationProxyFactoryEntry_AddRef(*entry);
+        hr = S_OK;
+    }
+    LeaveCriticalSection(&proxy_table_cs);
+
+    return hr;
+}
+
+/* Entries held by a SAFEARRAY of interface pointers, as new references. */
+static HRESULT proxy_entries_from_safearray(SAFEARRAY *sa, IUIAutomationProxyFactoryEntry ***out, UINT *count)
+{
+    IUIAutomationProxyFactoryEntry **entries;
+    LONG lbound, elems, i;
+    VARTYPE vt;
+    HRESULT hr;
+
+    *out = NULL;
+    *count = 0;
+    if (!sa || SafeArrayGetDim(sa) != 1 || FAILED(SafeArrayGetVartype(sa, &vt)) || vt != VT_UNKNOWN)
+        return E_INVALIDARG;
+    if (FAILED(hr = get_safearray_bounds(sa, &lbound, &elems)))
+        return hr;
+    if (!elems)
+        return S_OK;
+    if (!(entries = calloc(elems, sizeof(*entries))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0; i < elems; i++)
+    {
+        IUnknown *unk = NULL;
+        LONG idx = lbound + i;
+
+        hr = SafeArrayGetElement(sa, &idx, &unk);
+        if (SUCCEEDED(hr) && !unk)
+            hr = E_INVALIDARG;
+        if (SUCCEEDED(hr))
+        {
+            hr = IUnknown_QueryInterface(unk, &IID_IUIAutomationProxyFactoryEntry, (void **)&entries[i]);
+            IUnknown_Release(unk);
+        }
+        if (FAILED(hr))
+        {
+            while (i--)
+                IUIAutomationProxyFactoryEntry_Release(entries[i]);
+            free(entries);
+            return E_INVALIDARG;
+        }
+    }
+
+    *out = entries;
+    *count = elems;
+    return S_OK;
+}
+
+/* Puts the entries (references are taken over) in at a position. */
+static HRESULT proxy_table_insert(UINT before, IUIAutomationProxyFactoryEntry **entries, UINT count)
+{
+    HRESULT hr = S_OK;
+    UINT i;
+
+    EnterCriticalSection(&proxy_table_cs);
+    if (before > proxy_table.count)
+        hr = E_INVALIDARG;
+    else if (count && !uia_array_reserve((void **)&proxy_table.entries, &proxy_table.size, proxy_table.count + count,
+            sizeof(*proxy_table.entries)))
+        hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && count)
+    {
+        memmove(&proxy_table.entries[before + count], &proxy_table.entries[before],
+                (proxy_table.count - before) * sizeof(*proxy_table.entries));
+        for (i = 0; i < count; i++)
+            proxy_table.entries[before + i] = entries[i];
+        proxy_table.count += count;
+    }
+    LeaveCriticalSection(&proxy_table_cs);
+
+    if (FAILED(hr))
+    {
+        for (i = 0; i < count; i++)
+            IUIAutomationProxyFactoryEntry_Release(entries[i]);
+    }
+    free(entries);
+    return hr;
+}
+
+static void proxy_table_clear(void)
+{
+    UINT i;
+
+    EnterCriticalSection(&proxy_table_cs);
+    for (i = 0; i < proxy_table.count; i++)
+        IUIAutomationProxyFactoryEntry_Release(proxy_table.entries[i]);
+    proxy_table.count = 0;
+    LeaveCriticalSection(&proxy_table_cs);
+}
+
+static HRESULT WINAPI uia_proxy_mapping_SetTable(IUIAutomationProxyFactoryMapping *iface, SAFEARRAY *list)
+{
+    IUIAutomationProxyFactoryEntry **entries;
+    UINT count;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, list);
+
+    if (FAILED(hr = proxy_entries_from_safearray(list, &entries, &count)))
+        return hr;
+    proxy_table_clear();
+    return proxy_table_insert(0, entries, count);
+}
+
+static HRESULT WINAPI uia_proxy_mapping_InsertEntries(IUIAutomationProxyFactoryMapping *iface, UINT before,
+        SAFEARRAY *list)
+{
+    IUIAutomationProxyFactoryEntry **entries;
+    UINT count;
+    HRESULT hr;
+
+    TRACE("%p, %u, %p\n", iface, before, list);
+
+    if (FAILED(hr = proxy_entries_from_safearray(list, &entries, &count)))
+        return hr;
+    return proxy_table_insert(before, entries, count);
+}
+
+static HRESULT WINAPI uia_proxy_mapping_InsertEntry(IUIAutomationProxyFactoryMapping *iface, UINT before,
+        IUIAutomationProxyFactoryEntry *factory)
+{
+    IUIAutomationProxyFactoryEntry **entries;
+
+    TRACE("%p, %u, %p\n", iface, before, factory);
+
+    if (!factory)
+        return E_INVALIDARG;
+    if (!(entries = calloc(1, sizeof(*entries))))
+        return E_OUTOFMEMORY;
+    entries[0] = factory;
+    IUIAutomationProxyFactoryEntry_AddRef(factory);
+    return proxy_table_insert(before, entries, 1);
+}
+
+static HRESULT WINAPI uia_proxy_mapping_RemoveEntry(IUIAutomationProxyFactoryMapping *iface, UINT index)
+{
+    IUIAutomationProxyFactoryEntry *entry = NULL;
+
+    TRACE("%p, %u\n", iface, index);
+
+    EnterCriticalSection(&proxy_table_cs);
+    if (index < proxy_table.count)
+    {
+        entry = proxy_table.entries[index];
+        memmove(&proxy_table.entries[index], &proxy_table.entries[index + 1],
+                (proxy_table.count - index - 1) * sizeof(*proxy_table.entries));
+        proxy_table.count--;
+    }
+    LeaveCriticalSection(&proxy_table_cs);
+
+    if (!entry)
+        return E_INVALIDARG;
+    IUIAutomationProxyFactoryEntry_Release(entry);
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_mapping_ClearTable(IUIAutomationProxyFactoryMapping *iface)
+{
+    TRACE("%p\n", iface);
+    proxy_table_clear();
+    return S_OK;
+}
+
+/* The defaults come from the system's own proxies, which the table does not list. */
+static HRESULT WINAPI uia_proxy_mapping_RestoreDefaultTable(IUIAutomationProxyFactoryMapping *iface)
+{
+    TRACE("%p\n", iface);
+    proxy_table_clear();
+    return S_OK;
+}
