+static HRESULT WINAPI uia_com_itemcontainer_FindItemByProperty(IUnknown *iface, IUIAutomationElement *start_after, PROPERTYID prop_id, VARIANT value, IUIAutomationElement **found)
+{
+    struct uia_com_pattern *p = impl_from_pattern(iface);
+    struct uia_element *start = NULL;
+    HUIANODE node;
+    HRESULT hr;
+
+    if (!found)
+        return E_POINTER;
+    *found = NULL;
+    if (start_after && !(start = unsafe_impl_from_element(start_after)))
+        return E_INVALIDARG;
+    if (FAILED(hr = ItemContainerPattern_FindItemByProperty(p->obj, start ? start->node : NULL, prop_id, value, &node)) || !node)
+        return hr;
+    return uia_com_element_from_node(p->element, node, found);
+}
