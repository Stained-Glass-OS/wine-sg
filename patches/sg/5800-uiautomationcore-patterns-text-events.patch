+enum expect_kind { K_INT, K_BOOL, K_R8, K_BSTR, K_ELEM, K_ELEMS, K_INTS, K_BSTRS };
+
+struct prop_expect
+{
+    PROPERTYID id;
+    enum expect_kind kind;
+    int ival;
+    double dval;
+    const WCHAR *sval, *sval2;
+    int serials[4];
+    int count;
+};
+
+static void check_prop(struct fixture *f, const struct prop_expect *ex)
+{
+    VARIANT v;
+    HRESULT hr;
+    LONG i, lb, ub;
+    int n;
+
+    VariantInit(&v);
+    hr = UiaGetPropertyValue(f->node, ex->id, &v);
+    ok(hr == S_OK, "prop %d: unexpected hr %#lx.\n", ex->id, hr);
+    if (hr != S_OK)
+        return;
+
+    switch (ex->kind)
+    {
+    case K_INT:
+        ok(V_VT(&v) == VT_I4, "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == VT_I4)
+            ok(V_I4(&v) == ex->ival, "prop %d: got %ld, expected %d.\n", ex->id, V_I4(&v), ex->ival);
+        break;
+    case K_BOOL:
+        ok(V_VT(&v) == VT_BOOL, "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == VT_BOOL)
+            ok(!!V_BOOL(&v) == !!ex->ival, "prop %d: got %d, expected %d.\n", ex->id, V_BOOL(&v), ex->ival);
+        break;
+    case K_R8:
+        ok(V_VT(&v) == VT_R8, "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == VT_R8)
+            ok(V_R8(&v) == ex->dval, "prop %d: got %f, expected %f.\n", ex->id, V_R8(&v), ex->dval);
+        break;
+    case K_BSTR:
+        ok(V_VT(&v) == VT_BSTR, "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == VT_BSTR)
+            ok(V_BSTR(&v) && !wcscmp(V_BSTR(&v), ex->sval), "prop %d: got %s, expected %s.\n", ex->id,
+                    wine_dbgstr_w(V_BSTR(&v)), wine_dbgstr_w(ex->sval));
+        break;
+    case K_ELEM:
+        ok(V_VT(&v) == VT_I4 || V_VT(&v) == VT_I8 || V_VT(&v) == VT_UNKNOWN, "prop %d: unexpected vt %d.\n", ex->id,
+                V_VT(&v));
+        n = variant_node_serial(&v);
+        ok(n == ex->serials[0], "prop %d: wrong element %d, expected %d.\n", ex->id, n, ex->serials[0]);
+        VariantClear(&v);
+        return;
+    case K_ELEMS:
+        ok(V_VT(&v) == (VT_UNKNOWN | VT_ARRAY), "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == (VT_UNKNOWN | VT_ARRAY))
+        {
+            SafeArrayGetLBound(V_ARRAY(&v), 1, &lb);
+            SafeArrayGetUBound(V_ARRAY(&v), 1, &ub);
+            n = ub - lb + 1;
+            ok(n == ex->count, "prop %d: %d elements, expected %d.\n", ex->id, n, ex->count);
+            for (i = 0; i < n && i < ex->count; i++)
+            {
+                int got = array_node_serial(V_ARRAY(&v), lb + i);
+                ok(got == ex->serials[i], "prop %d: element %ld is %d, expected %d.\n", ex->id, i, got, ex->serials[i]);
+            }
+        }
+        break;
+    case K_INTS:
+        ok(V_VT(&v) == (VT_I4 | VT_ARRAY), "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == (VT_I4 | VT_ARRAY))
+        {
+            SafeArrayGetLBound(V_ARRAY(&v), 1, &lb);
+            SafeArrayGetUBound(V_ARRAY(&v), 1, &ub);
+            ok(ub - lb + 1 == ex->count, "prop %d: %ld values, expected %d.\n", ex->id, ub - lb + 1, ex->count);
+            for (i = 0; i < ub - lb + 1 && i < ex->count; i++)
+            {
+                int val = -1;
+                LONG idx = lb + i;
+                SafeArrayGetElement(V_ARRAY(&v), &idx, &val);
+                ok(val == ex->serials[i], "prop %d: value %ld is %d, expected %d.\n", ex->id, i, val, ex->serials[i]);
+            }
+        }
+        break;
+    case K_BSTRS:
+        ok(V_VT(&v) == (VT_BSTR | VT_ARRAY), "prop %d: unexpected vt %d.\n", ex->id, V_VT(&v));
+        if (V_VT(&v) == (VT_BSTR | VT_ARRAY))
+        {
+            BSTR b0 = NULL, b1 = NULL;
+
+            SafeArrayGetLBound(V_ARRAY(&v), 1, &lb);
+            SafeArrayGetUBound(V_ARRAY(&v), 1, &ub);
+            ok(ub - lb + 1 == 2, "prop %d: %ld values.\n", ex->id, ub - lb + 1);
+            i = lb;
+            SafeArrayGetElement(V_ARRAY(&v), &i, &b0);
+            i = lb + 1;
+            SafeArrayGetElement(V_ARRAY(&v), &i, &b1);
+            ok(b0 && !wcscmp(b0, ex->sval), "prop %d: first is %s.\n", ex->id, wine_dbgstr_w(b0));
+            ok(b1 && !wcscmp(b1, ex->sval2), "prop %d: second is %s.\n", ex->id, wine_dbgstr_w(b1));
+            SysFreeString(b0);
+            SysFreeString(b1);
+        }
+        break;
+    }
+    VariantClear(&v);
+}
