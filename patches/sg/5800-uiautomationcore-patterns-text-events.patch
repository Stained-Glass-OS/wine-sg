+/*
+ * A property nothing supplies has the default the property documents, unless
+ * the caller asked to ignore it (then the "not supported" marker stays).
+ */
+static HRESULT uia_apply_default_prop_value(const struct uia_prop_info *prop_info, VARIANT *v)
+{
+    IUnknown *not_supported = NULL;
+    VARIANT def;
+
+    if (V_VT(v) != VT_UNKNOWN)
+        return S_OK;
+    UiaGetReservedNotSupportedValue(&not_supported);
+    if (V_UNKNOWN(v) != not_supported)
+        return S_OK;
+
+    if (prop_info->type == UIAutomationType_ElementArray)
+    {
+        IUIAutomationElementArray *arr;
+        HRESULT hr;
+
+        if (FAILED(hr = create_uia_element_array_iface(&arr, 0)))
+            return hr;
+        VariantClear(v);
+        V_VT(v) = VT_UNKNOWN;
+        V_UNKNOWN(v) = (IUnknown *)arr;
+        return S_OK;
+    }
+
+    VariantInit(&def);
+    VariantClear(v);
+    if (uia_default_prop_value(prop_info, &def))
+        *v = def;
+    else
+        VariantInit(v);
+    return S_OK;
+}
