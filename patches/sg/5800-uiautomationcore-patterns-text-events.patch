+/*
+ * UI Automation client proxy factory table.
+ *
+ * A client can add proxies for window classes that have no UI Automation
+ * support: the table of IUIAutomationProxyFactoryEntry objects is kept for
+ * the process, in the order in which the factories are tried, and a window
+ * that matches an entry has its provider made by that entry's factory.
+ *
+ * Stained Glass OS: written from the documented interfaces.
+ */
+#include "uia_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(uiautomation);
