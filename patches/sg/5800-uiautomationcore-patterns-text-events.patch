+typedef HRESULT (*uia_bstr_getter)(struct uia_element *element, PROPERTYID prop_id, BSTR *ret_val);
+
+/* The extended properties of a style are a list of name=value pairs separated by semicolons. */
+static HRESULT styles_extended_properties_array(uia_bstr_getter get, struct uia_element *element,
+        struct ExtendedProperty **props, int *count)
+{
+    const WCHAR *start, *end, *eq;
+    struct ExtendedProperty *arr;
+    BSTR str = NULL;
+    int n = 0, i = 0;
+    HRESULT hr;
+
+    if (!props || !count)
+        return E_POINTER;
+    *props = NULL;
+    *count = 0;
+    if (FAILED(hr = get(element, UIA_StylesExtendedPropertiesPropertyId, &str)))
+        return hr;
+
+    for (start = str; start && *start; start = *end ? end + 1 : end)
+    {
+        end = wcschr(start, L';');
+        if (!end)
+            end = start + wcslen(start);
+        if (end > start)
+            n++;
+    }
+    if (!n || !(arr = CoTaskMemAlloc(n * sizeof(*arr))))
+    {
+        SysFreeString(str);
+        return n ? E_OUTOFMEMORY : S_OK;
+    }
+    memset(arr, 0, n * sizeof(*arr));
+
+    for (start = str; start && *start && i < n; start = *end ? end + 1 : end)
+    {
+        end = wcschr(start, L';');
+        if (!end)
+            end = start + wcslen(start);
+        if (end == start)
+            continue;
+        for (eq = start; eq < end && *eq != L'='; eq++) ;
+        if (eq == end) eq = NULL;
+        arr[i].PropertyName = SysAllocStringLen(start, (eq ? eq : end) - start);
+        arr[i].PropertyValue = SysAllocStringLen(eq ? eq + 1 : NULL, eq ? end - (eq + 1) : 0);
+        i++;
+    }
+    SysFreeString(str);
+    *props = arr;
+    *count = n;
+    return S_OK;
+}
