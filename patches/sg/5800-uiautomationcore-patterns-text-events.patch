+/* Arguments that must be real BSTRs, which are copied with their length. */
+static BSTR mkbstr(const WCHAR *str)
+{
+    static BSTR pool[64];
+    static unsigned int next;
+
+    SysFreeString(pool[next % ARRAY_SIZE(pool)]);
+    pool[next % ARRAY_SIZE(pool)] = SysAllocString(str);
+    return pool[next++ % ARRAY_SIZE(pool)];
+}
