+/* ActiveTextPositionChanged events. */
+struct thandler
+{
+    IUIAutomationActiveTextPositionChangedEventHandler iface;
+    LONG ref;
+    HANDLE event;
+    int calls;
+    BOOL has_range, has_sender;
+    WCHAR text[64];
+};
+
+static HRESULT WINAPI thandler_QueryInterface(IUIAutomationActiveTextPositionChangedEventHandler *iface, REFIID riid,
+        void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUIAutomationActiveTextPositionChangedEventHandler) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI thandler_AddRef(IUIAutomationActiveTextPositionChangedEventHandler *iface) { return 2; }
+static ULONG WINAPI thandler_Release(IUIAutomationActiveTextPositionChangedEventHandler *iface) { return 1; }
+static HRESULT WINAPI thandler_Handle(IUIAutomationActiveTextPositionChangedEventHandler *iface,
+        IUIAutomationElement *sender, IUIAutomationTextRange *range)
+{
+    struct thandler *h = CONTAINING_RECORD(iface, struct thandler, iface);
+    BSTR text = NULL;
+
+    h->has_sender = !!sender;
+    h->has_range = !!range;
+    if (range && SUCCEEDED(IUIAutomationTextRange_GetText(range, -1, &text)) && text)
+        lstrcpynW(h->text, text, ARRAY_SIZE(h->text));
+    SysFreeString(text);
+    h->calls++;
+    SetEvent(h->event);
+    return S_OK;
+}
+static const IUIAutomationActiveTextPositionChangedEventHandlerVtbl thandler_vtbl =
+{
+    thandler_QueryInterface, thandler_AddRef, thandler_Release, thandler_Handle,
+};
+
+static void test_active_text_event(struct fixture *f, HWND hwnd)
+{
+    IUIAutomationElement *el = NULL;
+    IUIAutomation6 *uia6 = NULL;
+    struct thandler h = { { &thandler_vtbl } };
+    struct trange *range;
+    DWORD res;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_CUIAutomation8, NULL, CLSCTX_INPROC_SERVER, &IID_IUIAutomation6, (void **)&uia6);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (FAILED(hr))
+        return;
+    h.event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    hr = IUIAutomation6_ElementFromHandle(uia6, hwnd, &el);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IUIAutomation6_AddActiveTextPositionChangedEventHandler(uia6, el, TreeScope_Element, NULL, &h.iface);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    range = trange_create(&f->hobj, 7, 12);
+    hr = UiaRaiseActiveTextPositionChangedEvent(&f->host.simple_iface, &range->iface);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    res = WaitForSingleObject(h.event, 5000);
+    ok(res == WAIT_OBJECT_0, "the handler was not called.\n");
+    ok(h.calls == 1, "got %d calls.\n", h.calls);
+    ok(h.has_sender && h.has_range, "sender %d, range %d.\n", h.has_sender, h.has_range);
+    ok(!wcscmp(h.text, L"World"), "got %s.\n", wine_dbgstr_w(h.text));
+
+    /* A second event reaches the handler too. */
+    hr = UiaRaiseActiveTextPositionChangedEvent(&f->host.simple_iface, &range->iface);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    res = WaitForSingleObject(h.event, 5000);
+    ok(res == WAIT_OBJECT_0 && h.calls == 2, "got %d calls.\n", h.calls);
+
+    hr = IUIAutomation6_RemoveActiveTextPositionChangedEventHandler(uia6, el, &h.iface);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = UiaRaiseActiveTextPositionChangedEvent(&f->host.simple_iface, &range->iface);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    res = WaitForSingleObject(h.event, 500);
+    ok(res == WAIT_TIMEOUT && h.calls == 2, "the removed handler was called (%d calls).\n", h.calls);
+
+    hr = UiaRaiseActiveTextPositionChangedEvent(NULL, &range->iface);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
+    ITextRangeProvider_Release(&range->iface);
+    IUIAutomationElement_Release(el);
+    IUIAutomation6_Release(uia6);
+    CloseHandle(h.event);
+}
