+/*
+ * A context menu is shown by the element, else by the first of its parents
+ * that has one.
+ */
+HRESULT uia_node_show_context_menu(HUIANODE huianode)
+{
+    HUIANODE node = huianode, parent;
+    HRESULT hr;
+    VARIANT v;
+
+    TRACE("(%p)\n", huianode);
+
+    if (!uia_checked_node(huianode))
+        return E_INVALIDARG;
+    IWineUiaNode_AddRef((IWineUiaNode *)node);
+    for (;;)
+    {
+        VariantInit(&v);
+        hr = node_call_element_method(node, PATTERN_METHOD_SHOW_CONTEXT_MENU, NULL, &v);
+        VariantClear(&v);
+        if (hr != UIA_E_NOTSUPPORTED)
+            break;
+
+        parent = NULL;
+        if (FAILED(navigate_uia_node(impl_from_IWineUiaNode((IWineUiaNode *)node), NavigateDirection_Parent,
+                &parent)) || !parent)
+            break;
+        UiaNodeRelease(node);
+        node = parent;
+    }
+    UiaNodeRelease(node);
+    return hr;
+}
