+static void test_updated_cache_scope(void)
+{
+    struct tprov prov;
+    struct pobj obj;
+    HUIANODE node;
+    static const int scopes[] = { TreeScope_Parent, TreeScope_Ancestors, 0, TreeScope_Parent | TreeScope_Element,
+        TreeScope_Element | 0x100 };
