+/*
+ * The value a property has when nothing supplies it (the "Default value" of
+ * the property identifier documentation). Returns FALSE and leaves the
+ * variant empty for the properties that have no value then, and for element
+ * arrays, which the caller makes from its own objects.
+ */
+BOOL uia_default_prop_value(const struct uia_prop_info *info, VARIANT *v)
+{
+    VariantInit(v);
+    if (!info)
+        return FALSE;
+
+    switch (info->prop_id)
+    {
+    case UIA_RuntimeIdPropertyId:
+    case UIA_ClickablePointPropertyId:
+    case UIA_CenterPointPropertyId:
+    case UIA_OutlineThicknessPropertyId:
+    case UIA_OutlineColorPropertyId:
+    case UIA_SizePropertyId:
+    case UIA_LandmarkTypePropertyId:
+        return FALSE;
+
+    case UIA_BoundingRectanglePropertyId:
+    {
+        static const double rect[4] = { 0.0, 0.0, 0.0, 0.0 };
+        SAFEARRAY *sa;
+        LONG i;
+
+        if (!(sa = SafeArrayCreateVector(VT_R8, 0, ARRAY_SIZE(rect))))
+            return FALSE;
+        for (i = 0; i < ARRAY_SIZE(rect); i++)
+            SafeArrayPutElement(sa, &i, (void *)&rect[i]);
+        V_VT(v) = VT_R8 | VT_ARRAY;
+        V_ARRAY(v) = sa;
+        return TRUE;
+    }
+
+    case UIA_ControlTypePropertyId:
+        variant_init_i4(v, UIA_CustomControlTypeId);
+        return TRUE;
+    case UIA_DockDockPositionPropertyId:
+        variant_init_i4(v, DockPosition_None);
+        return TRUE;
+    case UIA_ExpandCollapseExpandCollapseStatePropertyId:
+        variant_init_i4(v, ExpandCollapseState_LeafNode);
+        return TRUE;
+    case UIA_TableRowOrColumnMajorPropertyId:
+        variant_init_i4(v, RowOrColumnMajor_Indeterminate);
+        return TRUE;
+    case UIA_ToggleToggleStatePropertyId:
+        variant_init_i4(v, ToggleState_Indeterminate);
+        return TRUE;
+    case UIA_WindowWindowInteractionStatePropertyId:
+        variant_init_i4(v, WindowInteractionState_Running);
+        return TRUE;
+    case UIA_WindowWindowVisualStatePropertyId:
+        variant_init_i4(v, WindowVisualState_Normal);
+        return TRUE;
+    case UIA_HeadingLevelPropertyId:
+        variant_init_i4(v, HeadingLevel_None);
+        return TRUE;
+
+    case UIA_IsContentElementPropertyId:
+    case UIA_IsControlElementPropertyId:
+    case UIA_RangeValueIsReadOnlyPropertyId:
+    case UIA_ValueIsReadOnlyPropertyId:
+        variant_init_bool(v, TRUE);
+        return TRUE;
+
+    case UIA_ScrollHorizontalViewSizePropertyId:
+    case UIA_ScrollVerticalViewSizePropertyId:
+        V_VT(v) = VT_R8;
+        V_R8(v) = 100.0;
+        return TRUE;
+
+    case UIA_Transform2ZoomLevelPropertyId:
+    case UIA_Transform2ZoomMinimumPropertyId:
+    case UIA_Transform2ZoomMaximumPropertyId:
+        V_VT(v) = VT_R8;
+        V_R8(v) = 1.0;
+        return TRUE;
+
+    default:
+        break;
+    }
+
+    switch (info->type)
+    {
+    case UIAutomationType_Int:
+        variant_init_i4(v, 0);
+        return TRUE;
+
+    case UIAutomationType_Bool:
+        variant_init_bool(v, FALSE);
+        return TRUE;
+
+    case UIAutomationType_Double:
+        V_VT(v) = VT_R8;
+        V_R8(v) = 0.0;
+        return TRUE;
+
+    case UIAutomationType_String:
+        if (!(V_BSTR(v) = SysAllocString(L"")))
+            return FALSE;
+        V_VT(v) = VT_BSTR;
+        return TRUE;
+
+    case UIAutomationType_Element:
+        V_VT(v) = VT_UNKNOWN;
+        V_UNKNOWN(v) = NULL;
+        return TRUE;
+
+    case UIAutomationType_IntArray:
+    case UIAutomationType_StringArray:
+    {
+        VARTYPE vt = info->type == UIAutomationType_IntArray ? VT_I4 : VT_BSTR;
+        SAFEARRAY *sa;
+
+        if (!(sa = SafeArrayCreateVector(vt, 0, 0)))
+            return FALSE;
+        V_VT(v) = vt | VT_ARRAY;
+        V_ARRAY(v) = sa;
+        return TRUE;
+    }
+
+    default:
+        break;
+    }
+
+    return FALSE;
+}
