+static struct pobj *obj_of(void *iface) { return ((struct slot *)iface)->obj; }
+
+static void plog(struct pobj *obj, const char *fmt, ...)
+{
+    size_t len = strlen(obj->log);
+    va_list args;
+
+    va_start(args, fmt);
+    vsnprintf(obj->log + len, sizeof(obj->log) - len, fmt, args);
+    va_end(args);
+}
+
+static struct tprov *impl_from_simple(IRawElementProviderSimple *iface)
+{
+    return CONTAINING_RECORD(iface, struct tprov, simple_iface);
+}
+
+static struct tprov *impl_from_frag(IRawElementProviderFragment *iface)
+{
+    return CONTAINING_RECORD(iface, struct tprov, frag_iface);
+}
+
+static struct tprov *impl_from_root(IRawElementProviderFragmentRoot *iface)
+{
+    return CONTAINING_RECORD(iface, struct tprov, root_iface);
+}
+
+static ULONG WINAPI pobj_AddRef(IUnknown *iface)
+{
+    return InterlockedIncrement(&obj_of(iface)->ref);
+}
+
+static ULONG WINAPI pobj_Release(IUnknown *iface)
+{
+    return InterlockedDecrement(&obj_of(iface)->ref);
+}
+
+static HRESULT WINAPI pobj_QueryInterface(IUnknown *iface, REFIID riid, void **ppv)
+{
+    struct pobj *obj = obj_of(iface);
+    int i;
+
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUnknown))
+    {
+        for (i = 0; i < S_COUNT; i++)
+            if (obj->slot_mask & (1ull << i))
+                break;
+        *ppv = &obj->slots[i];
+    }
+    else
+    {
+        for (i = 0; i < S_COUNT; i++)
+        {
+            if ((obj->slot_mask & (1ull << i)) && IsEqualIID(riid, slot_infos[i].iid))
+            {
+                *ppv = &obj->slots[i];
+                break;
+            }
+        }
+    }
+    if (!*ppv)
+        return E_NOINTERFACE;
+    InterlockedIncrement(&obj->ref);
+    return S_OK;
+}
+
+static IRawElementProviderSimple *tprov_simple(struct tprov *prov)
+{
+    if (!prov)
+        return NULL;
+    IRawElementProviderSimple_AddRef(&prov->simple_iface);
+    return &prov->simple_iface;
+}
+
+static HRESULT get_elem(struct tprov *prov, IRawElementProviderSimple **ret)
+{
+    *ret = tprov_simple(prov);
+    return S_OK;
+}
+
+static HRESULT get_elem_array(struct tprov **provs, int count, SAFEARRAY **ret)
+{
+    SAFEARRAY *sa;
+    LONG i;
+
+    if (!(sa = SafeArrayCreateVector(VT_UNKNOWN, 0, count)))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+        SafeArrayPutElement(sa, &i, &provs[i]->simple_iface);
+    *ret = sa;
+    return S_OK;
+}
+
+static BSTR dup_bstr(BSTR str)
+{
+    return str ? SysAllocString(str) : NULL;
+}
+
+static SAFEARRAY *make_bstr_array(BSTR *strs, int count)
+{
+    SAFEARRAY *sa = SafeArrayCreateVector(VT_BSTR, 0, count);
+    LONG i;
+
+    for (i = 0; i < count; i++)
+        SafeArrayPutElement(sa, &i, strs[i]);
+    return sa;
+}
+
+static SAFEARRAY *make_int_array(const int *vals, int count)
+{
+    SAFEARRAY *sa = SafeArrayCreateVector(VT_I4, 0, count);
+    LONG i;
+
+    for (i = 0; i < count; i++)
+        SafeArrayPutElement(sa, &i, (void *)&vals[i]);
+    return sa;
+}
+
+#define IMPL_GETTER(name, ctype, expr) \
+    static HRESULT WINAPI name(void *iface, ctype *ret) { struct pobj *o = obj_of(iface); (void)o; *ret = (expr); return S_OK; }
+#define IMPL_BSTR_GETTER(name, expr) \
+    static HRESULT WINAPI name(void *iface, BSTR *ret) { struct pobj *o = obj_of(iface); *ret = dup_bstr(expr); return S_OK; }
+#define IMPL_ELEM_GETTER(name, expr) \
+    static HRESULT WINAPI name(void *iface, IRawElementProviderSimple **ret) { struct pobj *o = obj_of(iface); return get_elem(expr, ret); }
+#define IMPL_CALL(name, msg) \
+    static HRESULT WINAPI name(void *iface) { plog(obj_of(iface), msg ";"); return S_OK; }
+
+#define VTBL_HEAD(n) struct { void *QueryInterface, *AddRef, *Release; void *methods[n]; }
+#define VTBL_INIT { pobj_QueryInterface, pobj_AddRef, pobj_Release,
+
