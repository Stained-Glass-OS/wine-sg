+struct uia_win_event_map
+{
+    EVENTID event_id;
+    PROPERTYID prop_id;
+    SAFEARRAY *win_events;
+};
+
+struct uia_proxy_entry
+{
+    IUIAutomationProxyFactoryEntry IUIAutomationProxyFactoryEntry_iface;
+    LONG ref;
+
+    IUIAutomationProxyFactory *factory;
+    BSTR class_name;
+    BSTR image_name;
+    BOOL allow_substring;
+    BOOL check_base_class;
+    BOOL needs_advise_events;
+
+    struct uia_win_event_map *win_events;
+    int win_events_count;
+    CRITICAL_SECTION cs;
+};
+
+static inline struct uia_proxy_entry *impl_from_IUIAutomationProxyFactoryEntry(IUIAutomationProxyFactoryEntry *iface)
+{
+    return CONTAINING_RECORD(iface, struct uia_proxy_entry, IUIAutomationProxyFactoryEntry_iface);
+}
