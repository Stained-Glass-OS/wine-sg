+#define PATTERN_BIT(id) (1ull << ((id) - UIA_InvokePatternId))
+#define ALL_PATTERNS 0xffffffffffffffffull
+
+/* The element a node stands for is told by its runtime id. */
+static int node_serial(HUIANODE node)
+{
+    SAFEARRAY *sa = NULL;
+    LONG idx;
+    int serial = -1, val;
+    HRESULT hr;
+
+    hr = UiaGetRuntimeId(node, &sa);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (sa)
+    {
+        idx = 1;
+        if (SUCCEEDED(SafeArrayGetElement(sa, &idx, &val)))
+            serial = val;
+        SafeArrayDestroy(sa);
+    }
+    return serial;
+}
+
+static BOOL node_prop_bool(HUIANODE node, PROPERTYID id, BOOL *known)
+{
+    VARIANT v;
+    HRESULT hr;
+    BOOL ret = FALSE;
+
+    VariantInit(&v);
+    hr = UiaGetPropertyValue(node, id, &v);
+    ok(hr == S_OK, "prop %d: unexpected hr %#lx.\n", id, hr);
+    *known = FALSE;
+    if (V_VT(&v) == VT_BOOL)
+    {
+        *known = TRUE;
+        ret = V_BOOL(&v) == VARIANT_TRUE;
+    }
+    VariantClear(&v);
+    return ret;
+}
