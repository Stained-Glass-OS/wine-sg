+
+static HRESULT WINAPI uia_proxy_entry_get_NeedsAdviseEvents(IUIAutomationProxyFactoryEntry *iface, BOOL *val)
+{
+    TRACE("%p, %p\n", iface, val);
+
+    if (!val)
+        return E_POINTER;
+    *val = impl_from_IUIAutomationProxyFactoryEntry(iface)->needs_advise_events;
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_proxy_entry_put_ClassName(IUIAutomationProxyFactoryEntry *iface, LPCWSTR name)
+{
+    struct uia_proxy_entry *entry = impl_from_IUIAutomationProxyFactoryEntry(iface);
