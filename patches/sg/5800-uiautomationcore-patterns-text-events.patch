+static int variant_node_serial(const VARIANT *v)
+{
+    HUIANODE node;
+    VARIANT tmp = *v;
+    int serial;
+
+    if (FAILED(UiaHUiaNodeFromVariant(&tmp, &node)))
+        return -2;
+    serial = node_serial(node);
+    UiaNodeRelease(node);
+    return serial;
+}
+
+static int array_node_serial(SAFEARRAY *sa, LONG i)
+{
+    IUnknown *unk = NULL;
+    VARIANT v;
+    LONG idx = i;
+    int serial;
+
+    if (FAILED(SafeArrayGetElement(sa, &idx, &unk)))
+        return -3;
+    V_VT(&v) = VT_UNKNOWN;
+    V_UNKNOWN(&v) = unk;
+    serial = variant_node_serial(&v);
+    IUnknown_Release(unk);
+    return serial;
+}
