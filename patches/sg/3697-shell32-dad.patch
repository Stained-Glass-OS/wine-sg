From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: DAD_SetDragImage and DAD_ShowDragImage drive the image-list drag (3697)

shell32: DAD_SetDragImage and DAD_ShowDragImage drive the image-list drag

The drag-and-drop image helpers were stubs returning FALSE. They set the
dragged image from the first image of the list (the point is the hot spot,
-1 with no point clears it) and show or hide it. SHLoadOLE, documented as
ignored and returning S_OK, no longer logs a FIXME.
---
diff --git a/dlls/shell32/shellord.c b/dlls/shell32/shellord.c
index 558ea11..0d99897 100644
--- a/dlls/shell32/shellord.c
+++ b/dlls/shell32/shellord.c
@@ -1279,8 +1279,19 @@ BOOL WINAPI DAD_SetDragImage(
 	HIMAGELIST himlTrack,
 	LPPOINT lppt)
 {
-    FIXME("%p %p stub\n",himlTrack, lppt);
-    return FALSE;
+    TRACE("%p %p\n", himlTrack, lppt);
+
+    /* "You can clear the drag image by setting him to -1 and pptOffset to NULL" (docs) */
+    if (himlTrack == (HIMAGELIST)-1 && !lppt)
+    {
+#ifndef SG_MUTANT_DAD_CLEAR
+        ImageList_EndDrag();
+#endif
+        return TRUE;
+    }
+    if (!himlTrack || !lppt) return FALSE;
+    /* the zero index of the list, the point being the hot spot */
+    return ImageList_BeginDrag( himlTrack, 0, lppt->x, lppt->y );
 }
 /*************************************************************************
  * DAD_ShowDragImage				[SHELL32.137]
@@ -1290,8 +1301,11 @@ BOOL WINAPI DAD_SetDragImage(
  */
 BOOL WINAPI DAD_ShowDragImage(BOOL bShow)
 {
-    FIXME("0x%08x stub\n",bShow);
+    TRACE("0x%08x\n", bShow);
+#ifdef SG_MUTANT_DAD_SHOW
     return FALSE;
+#endif
+    return ImageList_DragShowNolock( bShow );
 }
 
 /*************************************************************************
@@ -1476,7 +1490,8 @@ HRESULT WINAPI SetAppStartingCursor(HWND u, DWORD v)
  * hack in SHCoCreateInstance)
  */
 HRESULT WINAPI SHLoadOLE(LPARAM lParam)
-{	FIXME("0x%08Ix stub\n",lParam);
+{	TRACE("0x%08Ix\n", lParam);
+	/* "lParam: Ignored. Returns S_OK." (docs: deprecated, kept for compatibility) */
 	return S_OK;
 }
 /*************************************************************************
