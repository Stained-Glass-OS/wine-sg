From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: GdipSetPenUnit and GdipCreateHalftonePalette (3595)

gdiplus: GdipSetPenUnit and GdipCreateHalftonePalette

GdipSetPenUnit is exported and stores the unit GdipGetPenUnit reports;
GdipCreateHalftonePalette returns the halftone palette of the screen.
---
diff --git a/dlls/gdiplus/gdiplus.spec b/dlls/gdiplus/gdiplus.spec
index bae1c3f..b30445b 100644
--- a/dlls/gdiplus/gdiplus.spec
+++ b/dlls/gdiplus/gdiplus.spec
@@ -557,7 +557,7 @@
 557 stdcall GdipSetPenMode(ptr long)
 558 stdcall GdipSetPenStartCap(ptr long)
 559 stdcall GdipSetPenTransform(ptr ptr)
-560 stub GdipSetPenUnit
+560 stdcall GdipSetPenUnit(ptr long)
 561 stdcall GdipSetPenWidth(ptr float)
 562 stdcall GdipSetPixelOffsetMode(ptr long)
 563 stdcall GdipSetPropertyItem(ptr ptr)
diff --git a/dlls/gdiplus/graphics.c b/dlls/gdiplus/graphics.c
index c11af0b..b70c9dd 100644
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -7822,14 +7822,16 @@ GpStatus WINGDIPAPI GdipTransformPointsI(GpGraphics *graphics, GpCoordinateSpace
 
 HPALETTE WINGDIPAPI GdipCreateHalftonePalette(void)
 {
-    static int calls;
+    HPALETTE palette;
+    HDC hdc;
 
     TRACE("\n");
 
-    if (!calls++)
-      FIXME("stub\n");
+    hdc = GetDC(0);
+    palette = CreateHalftonePalette(hdc);
+    ReleaseDC(0, hdc);
 
-    return NULL;
+    return palette;
 }
 
 /*****************************************************************************
diff --git a/dlls/gdiplus/pen.c b/dlls/gdiplus/pen.c
index 942b181..f252ade 100644
--- a/dlls/gdiplus/pen.c
+++ b/dlls/gdiplus/pen.c
@@ -411,6 +411,20 @@ GpStatus WINGDIPAPI GdipGetPenStartCap(GpPen *pen, GpLineCap *startCap)
     return Ok;
 }
 
+GpStatus WINGDIPAPI GdipSetPenUnit(GpPen *pen, GpUnit unit)
+{
+    TRACE("(%p, %d)\n", pen, unit);
+
+    if (!pen || unit < UnitWorld || unit > UnitMillimeter)
+        return InvalidParameter;
+
+#ifndef SG_MUTANT_PENUNIT
+    pen->unit = unit;
+#endif
+
+    return Ok;
+}
+
 GpStatus WINGDIPAPI GdipGetPenUnit(GpPen *pen, GpUnit *unit)
 {
     TRACE("(%p, %p)\n", pen, unit);
diff --git a/include/gdiplusflat.h b/include/gdiplusflat.h
index 372cf6b..e25aba9 100644
--- a/include/gdiplusflat.h
+++ b/include/gdiplusflat.h
@@ -669,6 +669,7 @@ GpStatus WINGDIPAPI GdipGetPenLineJoin(GpPen*,GpLineJoin*);
 GpStatus WINGDIPAPI GdipGetPenMiterLimit(GpPen*,REAL*);
 GpStatus WINGDIPAPI GdipGetPenStartCap(GpPen*,GpLineCap*);
 GpStatus WINGDIPAPI GdipGetPenUnit(GpPen*,GpUnit*);
+GpStatus WINGDIPAPI GdipSetPenUnit(GpPen*,GpUnit);
 GpStatus WINGDIPAPI GdipGetPenWidth(GpPen*,REAL*);
 GpStatus WINGDIPAPI GdipTranslatePenTransform(GpPen*,REAL,REAL,GpMatrixOrder);
 
