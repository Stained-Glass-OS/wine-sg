+
+/* the network and URL sources of a source list are the values "1", "2", ... of
+ * its Net and URL keys */
+static BOOL source_name_equal( const WCHAR *a, const WCHAR *b )
+{
+    SIZE_T la = lstrlenW( a ), lb = lstrlenW( b );
+
+    while (la && (a[la - 1] == '\\' || a[la - 1] == '/')) la--;
+    while (lb && (b[lb - 1] == '\\' || b[lb - 1] == '/')) lb--;
+    return la == lb && !wcsnicmp( a, b, la );
+}
+
+static UINT clear_sources( const WCHAR *product, MSIINSTALLCONTEXT context, DWORD options, const WCHAR *source )
+{
+    static const struct { DWORD flag; const WCHAR *name; } types[] =
+    {
+        { MSISOURCETYPE_NETWORK, L"Net" }, { MSISOURCETYPE_URL, L"URL" }
+    };
+    HKEY sourcekey, typekey;
+    UINT r, i;
+
+    r = OpenSourceKey( product, &sourcekey, options & MSICODE_PATCH, context, FALSE );
+    if (r != ERROR_SUCCESS) return r;
+
+#ifdef SG_MUTANT_MSI_NOCLEAR
+    RegCloseKey( sourcekey );
+    return ERROR_SUCCESS;
+#endif
+    for (i = 0; i < ARRAY_SIZE(types); i++)
+    {
+        WCHAR name[10], *data[64];
+        DWORD n = 0, j, size, type, index;
+
+        if (!(options & types[i].flag)) continue;
+        if (RegOpenKeyExW( sourcekey, types[i].name, 0, KEY_ALL_ACCESS, &typekey )) continue;
+
+        if (source)
+        {
+            /* keep the other sources, in order, and number them again */
+            for (index = 1; index <= ARRAY_SIZE(data); index++)
+            {
+                WCHAR value[MAX_PATH];
+
+                swprintf( name, ARRAY_SIZE(name), L"%lu", index );
+                size = sizeof(value) - sizeof(WCHAR);
+                if (RegQueryValueExW( typekey, name, NULL, &type, (BYTE *)value, &size )) continue;
+                value[size / sizeof(WCHAR)] = 0;
+                RegDeleteValueW( typekey, name );
+                if (source_name_equal( value, source )) continue;
+                if (n < ARRAY_SIZE(data)) data[n++] = wcsdup( value );
+            }
+            for (j = 0; j < n; j++)
+            {
+                swprintf( name, ARRAY_SIZE(name), L"%lu", j + 1 );
+                if (data[j]) RegSetValueExW( typekey, name, 0, REG_EXPAND_SZ, (BYTE *)data[j], (lstrlenW( data[j] ) + 1) * sizeof(WCHAR) );
+                free( data[j] );
+            }
+        }
+        else
+        {
+            /* every source of the type goes */
+            for (index = 1;; index++)
+            {
+                swprintf( name, ARRAY_SIZE(name), L"%lu", index );
+                if (RegDeleteValueW( typekey, name )) break;
+            }
+        }
+        RegCloseKey( typekey );
+    }
+    RegCloseKey( sourcekey );
+    return ERROR_SUCCESS;
+}
+
+static UINT locate_context( const WCHAR *product, MSIINSTALLCONTEXT *context )
+{
+    UINT r = msi_locate_product( product, context );
+    return r == ERROR_SUCCESS ? r : ERROR_UNKNOWN_PRODUCT;
+}
+
+static WCHAR *source_dupAtoW( const char *str )
+{
+    WCHAR *ret;
+    int len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar( CP_ACP, 0, str, -1, NULL, 0 );
+    if ((ret = malloc( len * sizeof(WCHAR) ))) MultiByteToWideChar( CP_ACP, 0, str, -1, ret, len );
+    return ret;
+}
+
