+
+    /* a product is elevated when it was installed for the machine or is managed (assigned) */
+    *pfElevated = (context == MSIINSTALLCONTEXT_MACHINE || context == MSIINSTALLCONTEXT_USERMANAGED);
+#ifdef SG_MUTANT_MSI_ELEVATED
     *pfElevated = TRUE;
+#endif
     return ERROR_SUCCESS;
 }
 
@@ -4263,10 +4274,20 @@ UINT WINAPI MsiIsProductElevatedW( LPCWSTR szProduct, BOOL *pfElevated )
  */
 UINT WINAPI MsiIsProductElevatedA( LPCSTR szProduct, BOOL *pfElevated )
 {
-    FIXME("%s %p - stub\n",
-          debugstr_a( szProduct ), pfElevated );
-    *pfElevated = TRUE;
-    return ERROR_SUCCESS;
+    WCHAR *product = NULL;
+    UINT r;
+
+    TRACE( "%s, %p\n", debugstr_a(szProduct), pfElevated );
+
+    if (szProduct)
+    {
+        int len = MultiByteToWideChar( CP_ACP, 0, szProduct, -1, NULL, 0 );
+        if (!(product = malloc( len * sizeof(WCHAR) ))) return ERROR_OUTOFMEMORY;
+        MultiByteToWideChar( CP_ACP, 0, szProduct, -1, product, len );
+    }
+    r = MsiIsProductElevatedW( product, pfElevated );
+    free( product );
+    return r;
 }
 
