 UINT WINAPI MsiIsProductElevatedW( LPCWSTR szProduct, BOOL *pfElevated )
 {
-    FIXME("%s %p - stub\n",
-          debugstr_w( szProduct ), pfElevated );
+    MSIINSTALLCONTEXT context;
