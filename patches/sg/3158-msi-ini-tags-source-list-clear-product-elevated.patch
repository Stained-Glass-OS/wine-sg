From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 04:07:54 -0700
Subject: [PATCH] msi: IniFile tags, clearing and forcing the source list,
 MsiIsProductElevated

IniFile AddTag appends a tag to a comma-separated value once; uninstall and
RemoveIniFile RemoveTag take it off (the line goes with the last tag).
MsiSourceListClearAll[Ex], MsiSourceListClearSource and MsiSourceListForceResolution
work on the Net and URL source keys and on LastUsedSource instead of reporting
success. MsiIsProductElevated answers from the install context (machine or managed)
and fails for an unknown product. Removes the todo_wine of
MsiDatabaseGenerateTransform in the custom action test.

diff --git a/dlls/msi/action.c b/dlls/msi/action.c
index 5f482fc..216304e 100644
--- a/dlls/msi/action.c
+++ b/dlls/msi/action.c
@@ -4354,6 +4354,74 @@ static WCHAR *get_ini_file_name( MSIPACKAGE *package, MSIRECORD *row )
     return ret;
 }
 
+/* A "tag" is one item of a comma-separated value: key=tag1,tag2 */
+static BOOL ini_has_tag( const WCHAR *list, const WCHAR *tag )
+{
+    SIZE_T len = lstrlenW( tag );
+    const WCHAR *p = list;
+
+    while (*p)
+    {
+        const WCHAR *end = wcschr( p, ',' );
+        SIZE_T n = end ? end - p : lstrlenW( p );
+
+        if (n == len && !wcsnicmp( p, tag, len )) return TRUE;
+        if (!end) break;
+        p = end + 1;
+    }
+    return FALSE;
+}
+
+static void ini_add_tag( const WCHAR *section, const WCHAR *key, const WCHAR *tag, const WCHAR *file )
+{
+    WCHAR list[2048], *value;
+
+    GetPrivateProfileStringW( section, key, L"", list, ARRAY_SIZE(list), file );
+    if (!list[0])
+    {
+        WritePrivateProfileStringW( section, key, tag, file );
+        return;
+    }
+    if (ini_has_tag( list, tag )) return;
+    if (!(value = malloc( (lstrlenW( list ) + lstrlenW( tag ) + 2) * sizeof(WCHAR) ))) return;
+    lstrcpyW( value, list );
+    lstrcatW( value, L"," );
+    lstrcatW( value, tag );
+    WritePrivateProfileStringW( section, key, value, file );
+    free( value );
+}
+
+static void ini_remove_tag( const WCHAR *section, const WCHAR *key, const WCHAR *tag, const WCHAR *file )
+{
+    WCHAR list[2048], *value, *out;
+    SIZE_T len = lstrlenW( tag );
+    const WCHAR *p;
+
+    GetPrivateProfileStringW( section, key, L"", list, ARRAY_SIZE(list), file );
+    if (!list[0] || !ini_has_tag( list, tag )) return;
+    if (!(value = malloc( (lstrlenW( list ) + 1) * sizeof(WCHAR) ))) return;
+    out = value;
+    *out = 0;
+    for (p = list; *p;)
+    {
+        const WCHAR *end = wcschr( p, ',' );
+        SIZE_T n = end ? end - p : lstrlenW( p );
+
+        if (n != len || wcsnicmp( p, tag, len ))
+        {
+            if (out != value) *out++ = ',';
+            memcpy( out, p, n * sizeof(WCHAR) );
+            out += n;
+            *out = 0;
+        }
+        if (!end) break;
+        p = end + 1;
+    }
+    /* the line goes when no tag is left */
+    WritePrivateProfileStringW( section, key, value[0] ? value : NULL, file );
+    free( value );
+}
+
