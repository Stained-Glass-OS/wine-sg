-    else if (action == 3)
-        FIXME("Append to existing section not yet implemented\n");
+    else if (action == msidbIniFileActionAddTag)
+    {
+        TRACE("Adding tag %s to %s in section %s of %s\n", debugstr_w(deformated_value),
+              debugstr_w(deformated_key), debugstr_w(deformated_section), debugstr_w(fullname));
+#ifndef SG_MUTANT_MSI_NOADDTAG
+        ini_add_tag( deformated_section, deformated_key, deformated_value, fullname );
+#endif
+    }
 
     uirow = MSI_CreateRecord(4);
     MSI_RecordSetStringW(uirow,1,identifier);
@@ -4489,6 +4563,16 @@ static UINT ITERATE_RemoveIniValuesOnUninstall( MSIRECORD *row, LPVOID param )
         }
         free( filename );
     }
+    else if (action == msidbIniFileActionAddTag)
+    {
+        filename = get_ini_file_name( package, row );
+        TRACE("Removing tag %s from %s in section %s of %s\n", debugstr_w(deformated_value),
+              debugstr_w(deformated_key), debugstr_w(deformated_section), debugstr_w(filename));
+#ifndef SG_MUTANT_MSI_NOADDTAG
+        ini_remove_tag( deformated_section, deformated_key, deformated_value, filename );
+#endif
+        free( filename );
+    }
     else
         FIXME("Unsupported action %d\n", action);
 
@@ -4551,6 +4635,16 @@ static UINT ITERATE_RemoveIniValuesOnInstall( MSIRECORD *row, LPVOID param )
         }
         free( filename );
     }
+    else if (action == msidbIniFileActionRemoveTag)
+    {
+        filename = get_ini_file_name( package, row );
+        TRACE("Removing tag %s from %s in section %s of %s\n", debugstr_w(deformated_value),
+              debugstr_w(deformated_key), debugstr_w(deformated_section), debugstr_w(filename));
+#ifndef SG_MUTANT_MSI_NOADDTAG
+        ini_remove_tag( deformated_section, deformated_key, deformated_value, filename );
+#endif
+        free( filename );
+    }
     else
         FIXME("Unsupported action %d\n", action);
 
