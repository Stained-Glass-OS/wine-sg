From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: the shell's desktop over every monitor

With two monitors the shell's desktop came up on one, and the other went on
showing the sign-in screen (David 2026-11-12). The session's desktop is a
Wine virtual desktop (explorer /desktop=shell), and Wine shows a virtual
desktop's programs one virtual monitor the size of the desktop, with the
host's monitors detached. With HKCU\Software\Wine\Explorer HostMonitors=Y
(sg-run-explorer sets it) the host's monitors stay: programs see each where
it is, at its size and refresh rate, the primary one primary, as on Windows;
the desktop, sized to the whole screen, reaches all of them, and a monitor
plugged in or out reaches programs as WM_DISPLAYCHANGE. A window that reaches
into another monitor too (the desktop itself) is no longer taken for one
monitor's fullscreen window and cut down to that monitor.
---
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -1451,7 +1451,8 @@
 
     /* in virtual desktop mode, report all physical sources as detached */
     is_primary = !!(state_flags & DISPLAY_DEVICE_PRIMARY_DEVICE);
-    if (is_virtual_desktop()) state_flags &= ~(DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE);
+    if (is_virtual_desktop() && !sg_desktop_spans_host())
+        state_flags &= ~(DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE);
 
     if (!(source = calloc( 1, sizeof(*source) ))) return;
     source->refcount = 1;
@@ -2251,6 +2252,46 @@
     return !*end;
 }
 
+/* Stained Glass OS: the session's desktop is the host's whole screen, every
+ * monitor of it (sg-run-explorer sets HKCU\Software\Wine\Explorer
+ * HostMonitors=Y). Its programs then see the host's monitors as they are --
+ * each where it is, at its size and refresh rate, the primary one primary --
+ * as on Windows, not one virtual monitor the size of all of them: a second
+ * screen was left out of the desktop, and a window maximized across both
+ * (David 2026-11-12). Explorer sizes the desktop's window to all of them;
+ * other programs see it as the primary monitor, as on Windows, so that what
+ * they maximize fills the monitor it is on. (wine-sg 7749) */
+BOOL sg_desktop_spans_host(void)
+{
+    char buffer[4096];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    HKEY hkey;
+    DWORD size;
+    BOOL ret = FALSE;
+
+    static int setting = -1;   /* the session sets it before the shell starts: read once */
+
+#ifdef SG_MUTANT_ONE_VIRTUAL_MONITOR
+    return FALSE;
+#endif
+    if (!is_virtual_desktop()) return FALSE;
+    if (setting < 0)
+    {
+        if ((hkey = reg_open_hkcu_key( "Software\\Wine\\Explorer" )))
+        {
+            size = query_reg_ascii_value( hkey, "HostMonitors", value, sizeof(buffer) );
+            NtClose( hkey );
+            if (size && value->Type == REG_SZ)
+            {
+                const WCHAR *str = (const WCHAR *)value->Data;
+                ret = str[0] == 'Y' || str[0] == 'y' || str[0] == '1';
+            }
+        }
+        setting = ret;
+    }
+    return setting;
+}
+
 /* retrieve the default desktop size from the registry */
 static BOOL get_default_desktop_size( DWORD *width, DWORD *height )
 {
@@ -2345,7 +2386,7 @@
 
     if (!(status = user_driver->pUpdateDisplayDevices( &device_manager, ctx )))
     {
-        if (ctx->source_count && is_virtual_desktop()) return add_virtual_source( ctx );
+        if (ctx->source_count && is_virtual_desktop() && !sg_desktop_spans_host()) return add_virtual_source( ctx );
         return status;
     }
 
@@ -2692,6 +2733,23 @@
         monitor_rect = monitor_get_rect( monitor, dpi_from, MDT_DEFAULT );
 
         is_fullscreen = intersect_rect( &rect, &monitor_rect, &rects.visible ) && EqualRect( &rect, &monitor_rect );
+#ifndef SG_MUTANT_SPAN_CLIPPED
+        /* Stained Glass OS: a window that reaches into another monitor too --
+         * the shell's desktop over every monitor (wine-sg 7749), a window
+         * stretched across two -- is not this one's fullscreen window: made
+         * this monitor's size, everything of it on the others was lost */
+        if (is_fullscreen)
+        {
+            struct monitor *other;
+            RECT other_rect, part;
+            LIST_FOR_EACH_ENTRY( other, &monitors, struct monitor, entry )
+            {
+                if (other == monitor || !is_monitor_active( other ) || other->is_clone) continue;
+                other_rect = monitor_get_rect( other, dpi_from, MDT_DEFAULT );
+                if (intersect_rect( &part, &other_rect, &rects.visible )) { is_fullscreen = FALSE; break; }
+            }
+        }
+#endif
         if (is_fullscreen) rects.visible = monitor_get_rect( monitor, 0, MDT_RAW_DPI );
         else rects.visible = map_monitor_rect( monitor, rects.visible, dpi_from, MDT_DEFAULT, 0, MDT_RAW_DPI );
 
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -202,6 +202,7 @@
 extern UINT get_thread_dpi(void);
 extern UINT set_thread_dpi_awareness_context( UINT context );
 extern UINT get_thread_dpi_awareness_context(void);
+extern BOOL sg_desktop_spans_host(void);
 extern RECT get_virtual_screen_rect( UINT dpi, MONITOR_DPI_TYPE type );
 extern BOOL is_exiting_thread( DWORD tid );
 extern BOOL is_window_rect_full_screen( const RECT *rect, UINT dpi );
