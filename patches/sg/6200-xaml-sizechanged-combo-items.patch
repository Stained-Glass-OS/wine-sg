From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: SizeChanged, combo box items from bindable vectors, early SelectedItem

FrameworkElement.SizeChanged was never raised. WinUI 2's NavigationView chooses its pane mode from it, so Windows Terminal's settings page sat under a pane drawn over it. SizeChanged is now raised after each layout pass for the elements whose RenderSize changed, with the previous and the new size. Combo boxes (and lists) now read an ItemsSource that offers only Windows.UI.Xaml.Interop's IBindableVector, IBindableVectorView or IBindableIterable (C++/WinRT's typed vectors are those to XAML), and follow an IBindableObservableVector. An item is found by object identity whatever interface it is given through, and a boxed string matches an item with the same text. A SelectedItem given to a combo box before its items arrive is kept until they do. Combo boxes without a Background of their own are drawn in a veil of their text colour, so they suit dark and light themes.
---
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index 8f091a2..af1e6f1 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -443,6 +443,7 @@ void uielem_arrange( struct uielem *elem, struct xrect final )
     if (old_render.width != elem->render.width || old_render.height != elem->render.height)
     {
         IInspectable *box;
+        elem->size_pending = TRUE;
         if ((box = xbox_double( elem->render.width ))) set_prop( elem, prop_actual_width, box );
         if ((box = xbox_double( elem->render.height ))) set_prop( elem, prop_actual_height, box );
     }
@@ -753,6 +754,103 @@ void xaml_raise_viewport_changed( struct uielem *root )
     release_subtree( items, count );
 }
 
+/* SizeChanged: after a layout pass, for the elements whose RenderSize changed in it */
+struct size_args
+{
+    struct xobj obj;
+    struct xiface ISizeChangedEventArgs_iface, IRoutedEventArgs_iface;
+    struct xsize previous, now;
+    IInspectable *source;
+};
+
+static struct size_args *size_args_from( struct xiface *iface ) { return CONTAINING_RECORD( iface->obj, struct size_args, obj ); }
+
+static HRESULT WINAPI size_args_get_PreviousSize( struct xiface *iface, struct xsize *value )
+{
+    if (!value) return E_POINTER;
+    *value = size_args_from( iface )->previous;
+    return S_OK;
+}
+
+static HRESULT WINAPI size_args_get_NewSize( struct xiface *iface, struct xsize *value )
+{
+    if (!value) return E_POINTER;
+    *value = size_args_from( iface )->now;
+    return S_OK;
+}
+
+static HRESULT WINAPI size_args_get_OriginalSource( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = size_args_from( iface )->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static const void *size_args_vtbl[] =
+{
+    ISizeChangedEventArgs_STUBS,
+    [ISizeChangedEventArgs_PreviousSize] = size_args_get_PreviousSize, [ISizeChangedEventArgs_NewSize] = size_args_get_NewSize,
+};
+static const void *size_routed_vtbl[] = { XIFACE_COMMON, size_args_get_OriginalSource };
+
+static void size_args_destroy( struct xobj *obj )
+{
+    struct size_args *args = CONTAINING_RECORD( obj, struct size_args, obj );
+    if (args->source) IInspectable_Release( args->source );
+    free( args );
+}
+
+extern const GUID IID_IRoutedEventArgs_x;
+static const struct xiface_entry size_args_ifaces[] =
+{
+    { &IID_ISizeChangedEventArgs, offsetof(struct size_args, ISizeChangedEventArgs_iface) },
+    { &IID_IRoutedEventArgs_x, offsetof(struct size_args, IRoutedEventArgs_iface) },
+};
+
+static const struct xclass size_args_class =
+{
+    L"Windows.UI.Xaml.SizeChangedEventArgs", size_args_ifaces, ARRAY_SIZE(size_args_ifaces), size_args_destroy,
+};
+
+void xaml_raise_size_changed( struct uielem *root )
+{
+    unsigned int i, count;
+    struct uielem **items;
+
+#ifdef SG_MUTANT_NO_SIZE_CHANGED
+    return;
+#endif
+    if (!(items = subtree( root, &count ))) return;
+    for (i = 0; i < count; i++)
+    {
+        struct uielem *elem = items[i];
+        struct size_args *args;
+        IInspectable *sender;
+
+        if (!elem->size_pending) continue;
+        elem->size_pending = FALSE;
+        if (elem->size_told.width == elem->render.width && elem->size_told.height == elem->render.height) continue;
+        if (list_empty( &elem->size_changed.entries ) || !(sender = sender_of( elem )) || !(args = calloc( 1, sizeof(*args) )))
+        {
+            elem->size_told = elem->render;
+            continue;
+        }
+        args->ISizeChangedEventArgs_iface.vtbl = size_args_vtbl;
+        args->IRoutedEventArgs_iface.vtbl = size_routed_vtbl;
+        args->previous = elem->size_told;
+        args->now = elem->render;
+        IInspectable_AddRef( (args->source = sender) );
+        elem->size_told = elem->render;
+        xobj_init( &args->obj, &size_args_class, NULL );
+        TRACE( "%p: SizeChanged %.1fx%.1f -> %.1fx%.1f\n", elem, args->previous.width, args->previous.height,
+               args->now.width, args->now.height );
+        xaml_raise_routed( &elem->size_changed, sender, (IInspectable *)&args->ISizeChangedEventArgs_iface );
+        IInspectable_Release( (IInspectable *)&args->ISizeChangedEventArgs_iface );
+        IInspectable_Release( sender );
+    }
+    release_subtree( items, count );
+}
+
 /* Unloaded: it left the live tree */
 static void raise_unloaded( struct uielem *root )
 {
