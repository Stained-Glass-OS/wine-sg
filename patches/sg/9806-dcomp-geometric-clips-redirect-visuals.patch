+/* CompositionGeometricClip (wine-sg 9806): a visual clipped to a geometry (through a view box), drawn as a
+ * Direct2D layer with the geometry as its mask; without a geometry it clips nothing */
+SG_VOID_IINSPECTABLE( geometric_clip, struct clip, ICompositionGeometricClip_iface, clip, ICompositionClip_iface )
+
+static HRESULT geometric_clip_get( struct clip *impl, IInspectable **field, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    compositor_lock( impl->compositor );
+    if ((*value = *field)) IInspectable_AddRef( *value );
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT geometric_clip_put( struct clip *impl, IInspectable **field, IInspectable *value )
+{
+    IInspectable *old;
+    if (value) IInspectable_AddRef( value );
+    compositor_lock( impl->compositor );
+    old = *field;
+    *field = value;
+    compositor_unlock( impl->compositor );
+    if (old) IInspectable_Release( old );
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI geometric_clip_get_Geometry( void *iface, IInspectable **value )
+{ return geometric_clip_get( geometric_clip_impl( iface ), &geometric_clip_impl( iface )->geometry, value ); }
+static HRESULT WINAPI geometric_clip_put_Geometry( void *iface, IInspectable *value )
+{ return geometric_clip_put( geometric_clip_impl( iface ), &geometric_clip_impl( iface )->geometry, value ); }
+static HRESULT WINAPI geometric_clip_get_ViewBox( void *iface, IInspectable **value )
+{ return geometric_clip_get( geometric_clip_impl( iface ), &geometric_clip_impl( iface )->view_box, value ); }
+static HRESULT WINAPI geometric_clip_put_ViewBox( void *iface, IInspectable *value )
+{ return geometric_clip_put( geometric_clip_impl( iface ), &geometric_clip_impl( iface )->view_box, value ); }
+
