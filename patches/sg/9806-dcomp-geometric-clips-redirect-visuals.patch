 /* a ShapeVisual's shapes, in its own space (the transform of the visual), within its size */
+/* the view box's area fitted into size by its stretch; FALSE when there is no (usable) view box */
+static BOOL view_box_fit( const struct shape *vb, Vector2 size, D2D1_MATRIX_3X2_F *fit )
+{
+    float sx, sy;
+
+    if (!vb || vb->kind != SHAPE_VIEW_BOX || vb->vb_size.X <= 0 || vb->vb_size.Y <= 0) return FALSE;
+    sx = size.X / vb->vb_size.X;
+    sy = size.Y / vb->vb_size.Y;
+    switch (vb->stretch)
+    {
+    case 0: sx = sy = 1.0f; break;                   /* None */
+    case 2: sx = sy = min( sx, sy ); break;          /* Uniform */
+    case 3: sx = sy = max( sx, sy ); break;          /* UniformToFill */
+    default: break;                                  /* Fill */
+    }
+    fit->_11 = sx; fit->_12 = 0; fit->_21 = 0; fit->_22 = sy;
+    fit->_31 = -vb->vb_offset.X * sx + (size.X - vb->vb_size.X * sx) * vb->h_ratio;
+    fit->_32 = -vb->vb_offset.Y * sy + (size.Y - vb->vb_size.Y * sy) * vb->v_ratio;
+    return TRUE;
+}
+
+/* (wine-sg 9806) a CompositionGeometricClip's mask in its visual's coordinates: its geometry through its view
+ * box, then moved by offset; NULL when it has no geometry of ours */
+ID2D1Geometry *shapes_clip_geometry( ID2D1Factory *factory, IInspectable *geometry, IInspectable *view_box,
+                                     Vector2 size, Vector2 offset )
+{
+    struct shape *g = unsafe_shape( (IUnknown *)geometry, NULL ), *vb = unsafe_shape( (IUnknown *)view_box, NULL );
+    D2D1_MATRIX_3X2_F m = { ._11 = 1.0f, ._22 = 1.0f };
+    ID2D1TransformedGeometry *moved;
+    ID2D1Geometry *base;
+
+    if (!g || !is_geometry( g ) || !(base = shape_d2d_geometry( factory, g ))) return NULL;
+    view_box_fit( vb, size, &m );
+    m._31 += offset.X;
+    m._32 += offset.Y;
+    if (FAILED(ID2D1Factory_CreateTransformedGeometry( factory, base, &m, &moved ))) moved = NULL;
+    ID2D1Geometry_Release( base );
+    return (ID2D1Geometry *)moved;
+}
