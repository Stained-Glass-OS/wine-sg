+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+#ifdef SG_MUTANT_NO_GEOMETRIC_CLIP
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = clip_create( compositor, 0, 0, 0, 0, &clip ))) return hr;
+    clip->geometric = TRUE;
+    clip->ICompositionGeometricClip_iface.vtbl = geometric_clip_vtbl;
+    if ((clip->geometry = geometry)) IInspectable_AddRef( geometry );
+    *out = &clip->ICompositionGeometricClip_iface;
+    return S_OK;
+}
