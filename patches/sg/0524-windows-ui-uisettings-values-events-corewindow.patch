+/* ---- change events ------------------------------------------------------- */
+
+struct changed_args
+{
+    IInspectable IInspectable_iface;
+    const IID *iid;
+    LONG ref;
+};
+
+static inline struct changed_args *impl_from_changed_args( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct changed_args, IInspectable_iface );
+}
+
+static HRESULT WINAPI changed_args_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct changed_args *impl = impl_from_changed_args( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iid ))
+    {
+        IInspectable_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI changed_args_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_changed_args( iface )->ref );
+}
+
+static ULONG WINAPI changed_args_Release( IInspectable *iface )
+{
+    struct changed_args *impl = impl_from_changed_args( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI changed_args_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    struct changed_args *impl = impl_from_changed_args( iface );
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = *impl->iid;
+    *iid_count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI changed_args_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    struct changed_args *impl = impl_from_changed_args( iface );
+    const WCHAR *name = L"Windows.UI.ViewManagement.UISettingsMessageDurationChangedEventArgs";
+
+    if (impl->iid == &IID_IUISettingsAutoHideScrollBarsChangedEventArgs)
+        name = L"Windows.UI.ViewManagement.UISettingsAutoHideScrollBarsChangedEventArgs";
+    else if (impl->iid == &IID_IUISettingsAnimationsEnabledChangedEventArgs)
+        name = L"Windows.UI.ViewManagement.UISettingsAnimationsEnabledChangedEventArgs";
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
