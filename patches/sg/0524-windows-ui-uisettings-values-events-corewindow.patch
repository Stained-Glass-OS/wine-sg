+static const struct IInspectableVtbl changed_args_vtbl =
+{
+    changed_args_QueryInterface,
+    changed_args_AddRef,
+    changed_args_Release,
+    changed_args_GetIids,
+    changed_args_GetRuntimeClassName,
+    changed_args_GetTrustLevel,
+};
+
+static IInspectable *create_changed_args( enum ui_event kind )
+{
+    struct changed_args *args;
+    const IID *iid;
+
+    switch (kind)
+    {
+    case UI_EVENT_AUTO_HIDE_SCROLLBARS: iid = &IID_IUISettingsAutoHideScrollBarsChangedEventArgs; break;
+    case UI_EVENT_ANIMATIONS: iid = &IID_IUISettingsAnimationsEnabledChangedEventArgs; break;
+    case UI_EVENT_MESSAGE_DURATION: iid = &IID_IUISettingsMessageDurationChangedEventArgs; break;
+    default: return NULL;   /* the IInspectable-args events pass none */
+    }
+    if (!(args = calloc( 1, sizeof(*args) ))) return NULL;
+    args->IInspectable_iface.lpVtbl = &changed_args_vtbl;
+    args->iid = iid;
+    args->ref = 1;
+    return &args->IInspectable_iface;
+}
+
+static void notify_handlers( enum ui_event kind )
+{
+    struct handler_entry *entry, **copies = NULL;
+    unsigned int count = 0, i;
+
+    EnterCriticalSection( &events_cs );
+    LIST_FOR_EACH_ENTRY( entry, &handlers, struct handler_entry, entry ) if (entry->kind == kind) count++;
+    if (count && (copies = calloc( count, sizeof(*copies) )))
+    {
+        count = 0;
+        LIST_FOR_EACH_ENTRY( entry, &handlers, struct handler_entry, entry )
+        {
+            if (entry->kind != kind || !(copies[count] = malloc( sizeof(*entry) ))) continue;
+            *copies[count] = *entry;
+            ITypedEventHandler_UISettings_IInspectable_AddRef( entry->handler );
+            IUISettings_AddRef( &entry->sender->IUISettings_iface );
+            count++;
+        }
+    }
+    else count = 0;
+    LeaveCriticalSection( &events_cs );
+
+    for (i = 0; i < count; i++)
+    {
+        IInspectable *args = create_changed_args( kind );
+        TRACE( "raising event %d, handler %p\n", kind, copies[i]->handler );
+        ITypedEventHandler_UISettings_IInspectable_Invoke( copies[i]->handler, &copies[i]->sender->IUISettings_iface, args );
+        if (args) IInspectable_Release( args );
+        ITypedEventHandler_UISettings_IInspectable_Release( copies[i]->handler );
+        IUISettings_Release( &copies[i]->sender->IUISettings_iface );
+        free( copies[i] );
+    }
+    free( copies );
+}
