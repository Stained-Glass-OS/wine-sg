+static DWORD reg_dword( const WCHAR *subkey, const WCHAR *name, DWORD def )
+{
+    DWORD ret = def, len = sizeof(ret), type;
+    HKEY hkey;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, subkey, 0, KEY_QUERY_VALUE, &hkey )) return def;
+    if (RegQueryValueExW( hkey, name, NULL, &type, (BYTE *)&ret, &len ) || type != REG_DWORD) ret = def;
+    RegCloseKey( hkey );
+    return ret;
+}
