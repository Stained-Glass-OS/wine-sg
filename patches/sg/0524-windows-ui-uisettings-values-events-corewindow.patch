+struct ui_state
+{
+    DWORD text_scale;
+    DWORD apps_light;
+    DWORD dwm_accent;
+    DWORD transparency;
+    DWORD dynamic_scrollbars;
+    BOOL animations;
+    UINT32 message_duration;
+    BYTE accent_palette[32];
+    COLORREF sys_colors[COLOR_MENUBAR + 1];
+};
+
+static void read_state( struct ui_state *state )
+{
+    DWORD len = sizeof(state->accent_palette);
+    HKEY hkey;
+    int i;
+
+    memset( state, 0, sizeof(*state) );
+    state->text_scale = text_scale_percent();
+    state->apps_light = get_app_theme();
+    state->dwm_accent = reg_dword( L"Software\\Microsoft\\Windows\\DWM", L"AccentColor", 0 );
+    state->transparency = reg_dword( personalize_key, L"EnableTransparency", 1 );
+    state->dynamic_scrollbars = reg_dword( cpl_accessibility_key, L"DynamicScrollbars", 1 );
+    state->animations = animations_enabled();
+    state->message_duration = message_duration();
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Accent", 0,
+                        KEY_QUERY_VALUE, &hkey ))
+    {
+        RegQueryValueExW( hkey, L"AccentPalette", NULL, NULL, state->accent_palette, &len );
+        RegCloseKey( hkey );
+    }
+    for (i = 0; i <= COLOR_MENUBAR; i++) state->sys_colors[i] = GetSysColor( i );
+}
+
+static const WCHAR *watched_keys[] =
+{
+    accessibility_key, personalize_key,
+    L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Accent",
+    L"Software\\Microsoft\\Windows\\DWM",
+    cpl_accessibility_key, L"Control Panel\\Desktop", L"Control Panel\\Colors",
+};
+
+static struct
+{
+    HKEY keys[ARRAY_SIZE(watched_keys)];
+    HANDLE events[ARRAY_SIZE(watched_keys)];
+    DWORD count;
+    struct ui_state state;
+} watcher;
+
+static DWORD WINAPI watcher_thread( void *arg )
+{
+    struct ui_state cur;
+    DWORD i, ret;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_ui_settings_watcher" );
+    for (;;)
+    {
+        ret = WaitForMultipleObjects( watcher.count, watcher.events, FALSE, INFINITE );
+        if (ret >= WAIT_OBJECT_0 + watcher.count) break;
+        i = ret - WAIT_OBJECT_0;
+        RegNotifyChangeKeyValue( watcher.keys[i], TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                                 watcher.events[i], TRUE );
+        Sleep( 50 );   /* one change often writes several values */
+        read_state( &cur );
+
+        if (cur.text_scale != watcher.state.text_scale) notify_handlers( UI_EVENT_TEXT_SCALE );
+        if (cur.apps_light != watcher.state.apps_light || cur.dwm_accent != watcher.state.dwm_accent ||
+            memcmp( cur.accent_palette, watcher.state.accent_palette, sizeof(cur.accent_palette) ) ||
+            memcmp( cur.sys_colors, watcher.state.sys_colors, sizeof(cur.sys_colors) ))
+            notify_handlers( UI_EVENT_COLOR_VALUES );
+        if (cur.transparency != watcher.state.transparency) notify_handlers( UI_EVENT_ADVANCED_EFFECTS );
+        if (cur.dynamic_scrollbars != watcher.state.dynamic_scrollbars) notify_handlers( UI_EVENT_AUTO_HIDE_SCROLLBARS );
+        if (cur.animations != watcher.state.animations) notify_handlers( UI_EVENT_ANIMATIONS );
+        if (cur.message_duration != watcher.state.message_duration) notify_handlers( UI_EVENT_MESSAGE_DURATION );
+        watcher.state = cur;
+    }
+    return 0;
+}
+
+/* Called with events_cs held. The notifications are armed and the settings
+ * read before the first add_ returns: a change right after subscribing is
+ * seen, as on Windows. */
+static void start_watcher(void)
+{
+    HMODULE module;
+    HANDLE thread;
+    DWORD i;
+
+    if (watcher_started) return;
+    /* the thread outlives any one object: keep the module loaded */
+    if (!GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                             (const WCHAR *)start_watcher, &module )) return;
+    for (i = 0; i < ARRAY_SIZE(watched_keys); i++)
+    {
+        HKEY *key = &watcher.keys[watcher.count];
+        HANDLE *event = &watcher.events[watcher.count];
+
+        if (RegCreateKeyExW( HKEY_CURRENT_USER, watched_keys[i], 0, NULL, 0, KEY_NOTIFY | KEY_QUERY_VALUE, NULL,
+                             key, NULL )) continue;
+        if (!(*event = CreateEventW( NULL, FALSE, FALSE, NULL ))) { RegCloseKey( *key ); continue; }
+        RegNotifyChangeKeyValue( *key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET, *event, TRUE );
+        watcher.count++;
+    }
+    if (!watcher.count) return;
+    read_state( &watcher.state );
+    if ((thread = CreateThread( NULL, 0, watcher_thread, NULL, 0, NULL )))
+    {
+        CloseHandle( thread );
+        watcher_started = TRUE;
+    }
+}
+
+static HRESULT add_handler( struct uisettings *impl, enum ui_event kind, void *handler, EventRegistrationToken *token )
+{
+    struct handler_entry *entry;
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->kind = kind;
+    entry->handler = handler;
+    ITypedEventHandler_UISettings_IInspectable_AddRef( entry->handler );
+    entry->sender = impl;
+    IUISettings_AddRef( &impl->IUISettings_iface );
+
+    EnterCriticalSection( &events_cs );
+    entry->token.value = ++next_token;
+    *token = entry->token;
+    list_add_tail( &handlers, &entry->entry );
+    start_watcher();
+    LeaveCriticalSection( &events_cs );
+
+    TRACE( "event %d handler %p token %#I64x\n", kind, handler, token->value );
+    return S_OK;
+}
+
+static HRESULT remove_handler( struct uisettings *impl, enum ui_event kind, EventRegistrationToken token )
+{
+    struct handler_entry *entry, *found = NULL;
+
+    EnterCriticalSection( &events_cs );
+    LIST_FOR_EACH_ENTRY( entry, &handlers, struct handler_entry, entry )
+    {
+        if (entry->kind == kind && entry->sender == impl && entry->token.value == token.value)
+        {
+            list_remove( &entry->entry );
+            found = entry;
+            break;
+        }
+    }
+    LeaveCriticalSection( &events_cs );
+
+    if (found)
+    {
+        ITypedEventHandler_UISettings_IInspectable_Release( found->handler );
+        IUISettings_Release( &found->sender->IUISettings_iface );
+        free( found );
+    }
+    return S_OK;
+}
