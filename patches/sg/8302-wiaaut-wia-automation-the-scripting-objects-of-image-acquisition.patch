+static HRESULT persistent_event(BOOL reg, BSTR command, BSTR name, BSTR description, BSTR icon, BSTR event,
+                                BSTR device)
+{
+    IWiaDevMgr *mgr;
+    GUID guid;
+    HRESULT hr;
