+/* the object base */
+
+void dispobj_init(struct dispobj *obj, const void *vtbl, tid_t tid, void (*destroy)(struct dispobj *obj))
+{
+    obj->IDispatch_iface.lpVtbl = vtbl;
+    obj->ref = 1;
+    obj->tid = tid;
+    obj->destroy = destroy;
+}
+
+HRESULT WINAPI dispobj_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    struct dispobj *obj = dispobj_from(iface);
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, tid_ids[obj->tid]))
+    {
+        IDispatch_AddRef(iface);
+        *ppv = iface;
+        return S_OK;
+    }
+    TRACE("%s not supported\n", debugstr_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+ULONG WINAPI dispobj_AddRef(IDispatch *iface)
+{
+    return InterlockedIncrement(&dispobj_from(iface)->ref);
+}
+
+ULONG WINAPI dispobj_Release(IDispatch *iface)
+{
+    struct dispobj *obj = dispobj_from(iface);
+    ULONG ref = InterlockedDecrement(&obj->ref);
+
+    if (!ref) obj->destroy(obj);
+    return ref;
+}
+
+HRESULT WINAPI dispobj_GetTypeInfoCount(IDispatch *iface, UINT *count)
+{
+    *count = 1;
+    return S_OK;
+}
+
+HRESULT WINAPI dispobj_GetTypeInfo(IDispatch *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo(dispobj_from(iface)->tid, info);
+}
+
+HRESULT WINAPI dispobj_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT count, LCID lcid,
+                                     DISPID *ids)
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo(dispobj_from(iface)->tid, &typeinfo))) return hr;
+    hr = ITypeInfo_GetIDsOfNames(typeinfo, names, count, ids);
+    ITypeInfo_Release(typeinfo);
+    return hr;
+}
+
+HRESULT WINAPI dispobj_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags, DISPPARAMS *params,
+                              VARIANT *result, EXCEPINFO *excep, UINT *arg_err)
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo(dispobj_from(iface)->tid, &typeinfo))) return hr;
+    hr = ITypeInfo_Invoke(typeinfo, iface, id, flags, params, result, excep, arg_err);
+    ITypeInfo_Release(typeinfo);
+    return hr;
