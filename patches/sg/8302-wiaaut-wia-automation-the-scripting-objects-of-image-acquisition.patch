+}
+
+static void properties_destroy(struct dispobj *obj)
+{
+    struct properties *This = CONTAINING_RECORD(obj, struct properties, obj);
+    LONG i;
+
+    for (i = 0; i < This->count; i++)
+    {
+        SysFreeString(This->entries[i].name);
+        PropVariantClear(&This->entries[i].valid);
+        VariantClear(&This->entries[i].value);
+    }
+    free(This->entries);
+    if (This->storage) IWiaPropertyStorage_Release(This->storage);
+    free(This);
+}
