+static const ICommonDialogVtbl commondialog_vtbl =
+{
+    DISPOBJ_METHODS,
+    commondialog_ShowAcquisitionWizard,
+    commondialog_ShowAcquireImage,
+    commondialog_ShowSelectDevice,
+    commondialog_ShowSelectItems,
+    commondialog_ShowDeviceProperties,
