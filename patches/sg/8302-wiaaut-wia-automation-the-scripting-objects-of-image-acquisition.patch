+static HRESULT create_filter(unsigned int kind, IFilter **out)
+{
+    struct prop_def defs[8];
+    struct filter *This;
+    unsigned int n = 0;
+    HRESULT hr;
+
+    switch (kind)
+    {
+    case FILTER_ROTATEFLIP:
+        def_long(&defs[n++], 1, L"RotationAngle", 0);
+        def_bool(&defs[n++], 2, L"FlipHorizontal", FALSE);
+        def_bool(&defs[n++], 3, L"FlipVertical", FALSE);
+        def_long(&defs[n++], 4, L"FrameIndex", 0);
+        break;
+    case FILTER_CROP:
+        def_long(&defs[n++], 1, L"Left", 0);
+        def_long(&defs[n++], 2, L"Top", 0);
+        def_long(&defs[n++], 3, L"Right", 0);
+        def_long(&defs[n++], 4, L"Bottom", 0);
+        def_long(&defs[n++], 5, L"FrameIndex", 0);
+        break;
+    case FILTER_SCALE:
+        def_long(&defs[n++], 1, L"MaximumWidth", 0);
+        def_long(&defs[n++], 2, L"MaximumHeight", 0);
+        def_bool(&defs[n++], 3, L"PreserveAspectRatio", TRUE);
+        def_long(&defs[n++], 4, L"FrameIndex", 0);
+        break;
+    case FILTER_CONVERT:
+        def_str(&defs[n++], 1, L"FormatID", L"{B96B3CAB-0728-11D3-9D7B-0000F81EF32E}");
+        def_long(&defs[n++], 2, L"Quality", 100);
+        def_str(&defs[n++], 3, L"Compression", L"LZW");
+        break;
+    default:
+        def_long(&defs[n++], 1, L"FrameIndex", 0);
+        break;
+    }
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = properties_from_defs(defs, n, &This->props)))
+    {
+        free(This);
+        return hr;
+    }
+    dispobj_init(&This->obj, &filter_vtbl, IFilter_tid, filter_destroy);
+    This->kind = kind;
+    *out = (IFilter *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
