+static HRESULT create_property(struct properties *props, LONG index, IProperty **out)
+{
+    struct property *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &property_vtbl, IProperty_tid, property_destroy);
+    This->props = props;
+    This->index = index;
+    IDispatch_AddRef(&props->obj.IDispatch_iface);
+    *out = (IProperty *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+/* a property is named by its name, or by its number */
+static LONG find_entry(struct properties *This, VARIANT *index)
+{
+    VARIANT v;
+    LONG i, id;
+
+    if (V_VT(index) == (VT_BYREF | VT_VARIANT)) index = V_VARIANTREF(index);
+    VariantInit(&v);
+    if (V_VT(index) == VT_BSTR)
+    {
+#ifndef SG_MUTANT_WIAAUT_NO_NAMES
+        for (i = 0; i < This->count; i++)
+            if (This->entries[i].name && !wcsicmp(This->entries[i].name, V_BSTR(index))) return i;
+#endif
+        /* a number in a string ("6147") */
+        if (FAILED(VariantChangeType(&v, index, 0, VT_I4))) return -1;
+    }
+    else if (FAILED(VariantChangeType(&v, index, 0, VT_I4))) return -1;
+    id = V_I4(&v);
+    for (i = 0; i < This->count; i++)
+        if (This->entries[i].id == id) return i;
+    return -1;
+}
+
+static HRESULT WINAPI properties_get_Item(IProperties *iface, VARIANT *index, IProperty **out)
+{
+    struct properties *This = impl_from_IProperties(iface);
+    LONG i;
+
+    if (!index || !out) return E_POINTER;
+    *out = NULL;
+    if ((i = find_entry(This, index)) < 0) return DISP_E_BADINDEX;
+    return create_property(This, i, out);
+}
+
+static HRESULT WINAPI properties_get_Count(IProperties *iface, LONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IProperties(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI properties_Exists(IProperties *iface, VARIANT *index, VARIANT_BOOL *exists)
+{
+    if (!index || !exists) return E_POINTER;
+    *exists = find_entry(impl_from_IProperties(iface), index) >= 0 ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI properties_get__NewEnum(IProperties *iface, IUnknown **out)
+{
+    struct properties *This = impl_from_IProperties(iface);
+    VARIANT *values;
+    IProperty *prop;
+    LONG i;
+    HRESULT hr;
+
+    if (!(values = calloc(This->count ? This->count : 1, sizeof(VARIANT)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        if (FAILED(create_property(This, i, &prop))) continue;
+        V_VT(&values[i]) = VT_DISPATCH;
+        V_DISPATCH(&values[i]) = (IDispatch *)prop;
+    }
+    hr = create_enum_variant(values, This->count, out);
+    for (i = 0; i < This->count; i++) VariantClear(&values[i]);
+    free(values);
+    return hr;
+}
+
+static const IPropertiesVtbl properties_vtbl =
+{
+    DISPOBJ_METHODS,
+    properties_get_Item,
+    properties_get_Count,
+    properties_Exists,
+    properties_get__NewEnum,
+};
+
+static HRESULT create_properties(struct properties **out)
+{
+    struct properties *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &properties_vtbl, IProperties_tid, properties_destroy);
+    *out = This;
+    return S_OK;
+}
+
+HRESULT properties_from_storage(IWiaPropertyStorage *storage, IProperties **out)
+{
+    struct properties *This;
+    IEnumSTATPROPSTG *stats;
+    STATPROPSTG stat;
+    ULONG fetched, n = 0, flags;
+    HRESULT hr;
+
+    if (FAILED(hr = create_properties(&This))) return hr;
+    if (storage)
+    {
+        IWiaPropertyStorage_AddRef(storage);
+        This->storage = storage;
+        if (SUCCEEDED(IWiaPropertyStorage_GetCount(storage, &n)) && n
+                && (This->entries = calloc(n, sizeof(*This->entries)))
+                && SUCCEEDED(IWiaPropertyStorage_Enum(storage, &stats)))
+        {
+            while (This->count < n && IEnumSTATPROPSTG_Next(stats, 1, &stat, &fetched) == S_OK && fetched == 1)
+            {
+                struct property_entry *entry = &This->entries[This->count++];
+                PROPSPEC spec;
+
+                entry->id = stat.propid;
+                entry->name = SysAllocString(stat.lpwstrName ? stat.lpwstrName : L"");
+                entry->vt = stat.vt;
+                CoTaskMemFree(stat.lpwstrName);
+                spec.ulKind = PRSPEC_PROPID;
+                spec.propid = entry->id;
+                PropVariantInit(&entry->valid);
+                if (IWiaPropertyStorage_GetPropertyAttributes(storage, 1, &spec, &flags, &entry->valid) == S_OK)
+                {
+                    entry->readonly = !(flags & WIA_PROP_WRITE);
+                    entry->flags = flags & (WIA_PROP_RANGE | WIA_PROP_LIST | WIA_PROP_FLAG);
+                }
+                else entry->readonly = TRUE;
+            }
+            IEnumSTATPROPSTG_Release(stats);
+        }
+    }
+    *out = (IProperties *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+HRESULT properties_from_defs(const struct prop_def *defs, unsigned int count, IProperties **out)
+{
+    struct properties *This;
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = create_properties(&This))) return hr;
+    if (count && !(This->entries = calloc(count, sizeof(*This->entries))))
+    {
+        properties_destroy(&This->obj);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        struct property_entry *entry = &This->entries[i];
+        entry->id = defs[i].id;
+        entry->name = SysAllocString(defs[i].name);
+        entry->vt = V_VT(&defs[i].value);
+        entry->readonly = defs[i].readonly;
+        VariantCopy(&entry->value, (VARIANT *)&defs[i].value);
+        PropVariantInit(&entry->valid);
+    }
+    This->count = count;
+    *out = (IProperties *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+HRESULT properties_get_value(IProperties *iface, const WCHAR *name, VARIANT *value)
+{
+    struct properties *This = impl_from_IProperties(iface);
+    VARIANT index;
+    LONG i;
+
+    V_VT(&index) = VT_BSTR;
+    V_BSTR(&index) = (BSTR)name;
+    if ((i = find_entry(This, &index)) < 0) return DISP_E_BADINDEX;
+    return read_entry(This, i, value);
+}
+
+/* ImageFile: the bytes of an image file */
+
+struct imagefile
+{
+    struct dispobj obj;
+    BYTE *data;
+    SIZE_T size;
+    GUID format;
+    UINT width, height, frames, active, bpp;
+    double xres, yres;
+    BOOL indexed, alpha;
+};
+
+static inline struct imagefile *impl_from_IImageFile(IImageFile *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct imagefile, obj);
+}
+
+static void imagefile_destroy(struct dispobj *obj)
+{
+    struct imagefile *This = CONTAINING_RECORD(obj, struct imagefile, obj);
+
+    free(This->data);
+    free(This);
+}
+
+static const struct { const GUID *container, *wia; const WCHAR *ext; } image_formats[] =
+{
+    { &wic_bmp, &WiaImgFmt_BMP, L"bmp" },
+    { &wic_png, &WiaImgFmt_PNG, L"png" },
+    { &wic_jpeg, &WiaImgFmt_JPEG, L"jpg" },
+    { &wic_tiff, &WiaImgFmt_TIFF, L"tif" },
+    { &wic_gif, &WiaImgFmt_GIF, L"gif" },
+};
+
+/* what the file is, from its decoder: format, size, resolution, pixels */
+static HRESULT imagefile_load(struct imagefile *This)
+{
+    IWICImagingFactory *factory;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICComponentInfo *info;
+    IWICPixelFormatInfo *pixel_info;
+    WICPixelFormatGUID pixel;
+    IStream *stream;
+    GUID container;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!(factory = wic_factory())) return E_FAIL;
+    if (!(stream = SHCreateMemStream(This->data, This->size)))
+    {
+        IWICImagingFactory_Release(factory);
+        return E_OUTOFMEMORY;
+    }
+    hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand, &decoder);
+    if (SUCCEEDED(hr)) hr = IWICBitmapDecoder_GetContainerFormat(decoder, &container);
+    if (SUCCEEDED(hr))
+    {
+        This->format = WiaImgFmt_UNDEFINED;
+        for (i = 0; i < ARRAY_SIZE(image_formats); i++)
+            if (IsEqualGUID(&container, image_formats[i].container)) This->format = *image_formats[i].wia;
+        IWICBitmapDecoder_GetFrameCount(decoder, &This->frames);
+        hr = IWICBitmapDecoder_GetFrame(decoder, min(This->active, This->frames ? This->frames - 1 : 0), &frame);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IWICBitmapFrameDecode_GetSize(frame, &This->width, &This->height)))
+    {
+        IWICBitmapFrameDecode_GetResolution(frame, &This->xres, &This->yres);
+        if (SUCCEEDED(IWICBitmapFrameDecode_GetPixelFormat(frame, &pixel))
+                && SUCCEEDED(IWICImagingFactory_CreateComponentInfo(factory, &pixel, &info)))
+        {
+            if (SUCCEEDED(IWICComponentInfo_QueryInterface(info, &wic_pixel_format_info_iid, (void **)&pixel_info)))
+            {
+                IWICPixelFormatInfo_GetBitsPerPixel(pixel_info, &This->bpp);
+                IWICPixelFormatInfo_Release(pixel_info);
+            }
+            IWICComponentInfo_Release(info);
+        }
+        This->indexed = This->bpp <= 8;
+        This->alpha = This->bpp == 32 && !IsEqualGUID(&This->format, &WiaImgFmt_BMP);
+    }
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    IStream_Release(stream);
+    IWICImagingFactory_Release(factory);
+    return hr;
+}
+
+static HRESULT WINAPI imagefile_get_FormatID(IImageFile *iface, BSTR *format)
+{
+    if (!format) return E_POINTER;
+    *format = guid_string(&impl_from_IImageFile(iface)->format);
+    return S_OK;
+}
+
+static HRESULT WINAPI imagefile_get_FileExtension(IImageFile *iface, BSTR *ext)
+{
+    struct imagefile *This = impl_from_IImageFile(iface);
+    unsigned int i;
+
+    if (!ext) return E_POINTER;
+    for (i = 0; i < ARRAY_SIZE(image_formats); i++)
+        if (IsEqualGUID(&This->format, image_formats[i].wia)) break;
+    *ext = SysAllocString(i < ARRAY_SIZE(image_formats) ? image_formats[i].ext : L"");
+    return S_OK;
+}
+
+static HRESULT WINAPI imagefile_get_FileData(IImageFile *iface, IVector **out)
+{
+    struct imagefile *This = impl_from_IImageFile(iface);
+
+    if (!out) return E_POINTER;
+    return vector_from_bytes(This->data, This->size, out);
+}
+
+static HRESULT WINAPI imagefile_get_ARGBData(IImageFile *iface, IVector **out)
+{
+    struct imagefile *This = impl_from_IImageFile(iface);
+    IWICImagingFactory *factory;
+    IWICBitmapDecoder *decoder;
+    IWICBitmapFrameDecode *frame;
+    IWICFormatConverter *conv;
+    IStream *stream;
+    DWORD *pixels = NULL;
+    UINT i, count = This->width * This->height;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (!(factory = wic_factory())) return E_FAIL;
+    if (!(pixels = malloc(count * 4 + 4)))
+    {
+        IWICImagingFactory_Release(factory);
+        return E_OUTOFMEMORY;
+    }
+    stream = SHCreateMemStream(This->data, This->size);
+    if (SUCCEEDED(hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand,
+                                                                 &decoder)))
+    {
+        if (SUCCEEDED(hr = IWICBitmapDecoder_GetFrame(decoder, This->active, &frame)))
+        {
+            if (SUCCEEDED(hr = IWICImagingFactory_CreateFormatConverter(factory, &conv)))
+            {
+                if (SUCCEEDED(hr = IWICFormatConverter_Initialize(conv, (IWICBitmapSource *)frame, &wic_32bppbgra,
+                        WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeCustom)))
+                    hr = IWICFormatConverter_CopyPixels(conv, NULL, This->width * 4, count * 4, (BYTE *)pixels);
+                IWICFormatConverter_Release(conv);
+            }
+            IWICBitmapFrameDecode_Release(frame);
+        }
+        IWICBitmapDecoder_Release(decoder);
+    }
+    if (stream) IStream_Release(stream);
+    IWICImagingFactory_Release(factory);
+    /* a Vector of 0xAARRGGBB numbers, the rows from the top */
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = vector_create(out)))
+    {
+        struct vector *vec = impl_from_IVector(*out);
+        if ((vec->values = calloc(count ? count : 1, sizeof(VARIANT))))
+        {
+            vec->size = count ? count : 1;
+            for (i = 0; i < count; i++)
+            {
+                V_VT(&vec->values[i]) = VT_I4;
+                V_I4(&vec->values[i]) = pixels[i];
+            }
+            vec->count = count;
+        }
+    }
+    free(pixels);
+    return hr;
+}
