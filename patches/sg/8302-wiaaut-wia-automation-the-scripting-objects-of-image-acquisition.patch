+static HRESULT WINAPI filters_Add(IFilters *iface, BSTR id, LONG index)
+{
+    struct filters *This = impl_from_IFilters(iface);
+    IFilter *filter, **grown;
+    int kind;
+    HRESULT hr;
+
+    if (!id || (kind = filter_kind(id)) < 0) return E_INVALIDARG;
+    if (index < 0 || index > This->count + 1) return DISP_E_BADINDEX;
+    if (!index) index = This->count + 1;
+    if (FAILED(hr = create_filter(kind, &filter))) return hr;
+    if (!(grown = realloc(This->items, (This->count + 1) * sizeof(*grown))))
+    {
+        IFilter_Release(filter);
+        return E_OUTOFMEMORY;
+    }
+    This->items = grown;
+    memmove(&grown[index], &grown[index - 1], (This->count - index + 1) * sizeof(*grown));
+    grown[index - 1] = filter;
+    This->count++;
+    return S_OK;
+}
