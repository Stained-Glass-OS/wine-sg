+{
+    struct filter *This = impl_from_IFilter(filter);
+    VARIANT v, conv;
+    LONG ret = 0;
+
+    VariantInit(&conv);
+    if (SUCCEEDED(properties_get_value(This->props, name, &v)))
+    {
+        if (SUCCEEDED(VariantChangeType(&conv, &v, 0, VT_I4))) ret = V_I4(&conv);
+        VariantClear(&v);
+    }
+    return ret;
+}
+
+static BOOL filter_bool(IFilter *filter, const WCHAR *name)
+{
+    return filter_long(filter, name) != 0;
+}
+
+/* the filters, one after the other, on the first frame of the file; then the file in its (new) format */
+static HRESULT WINAPI imageprocess_Apply(IImageProcess *iface, IImageFile *source, IImageFile **out)
+{
+    struct imageprocess *This = impl_from_IImageProcess(iface);
+    struct filters *filters = impl_from_IFilters(This->filters);
+    IWICImagingFactory *factory;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapSource *current = NULL, *next;
+    IWICBitmapEncoder *encoder = NULL;
+    IWICBitmapFrameEncode *frame_out = NULL;
+    IPropertyBag2 *options = NULL;
+    IStream *in = NULL, *result = NULL;
+    const BYTE *data;
+    SIZE_T size;
+    GUID format, container = wic_bmp;
+    LONG quality = 100, i;
+    HGLOBAL global;
+    STATSTG stat;
+    double xres = 96.0, yres = 96.0;
+    unsigned int f;
+    HRESULT hr;
+
+    if (!source || !out) return E_POINTER;
+    *out = NULL;
+    imagefile_data(source, &data, &size);
+    format = impl_from_IImageFile(source)->format;
+    if (!(factory = wic_factory())) return E_FAIL;
+    in = SHCreateMemStream(data, size);
+    hr = IWICImagingFactory_CreateDecoderFromStream(factory, in, NULL, WICDecodeMetadataCacheOnDemand, &decoder);
+    if (SUCCEEDED(hr)) hr = IWICBitmapDecoder_GetFrame(decoder, 0, &frame);
+    if (SUCCEEDED(hr))
+    {
+        IWICBitmapFrameDecode_GetResolution(frame, &xres, &yres);
+        current = (IWICBitmapSource *)frame;
+        IWICBitmapSource_AddRef(current);
+    }
+
+    for (i = 0; SUCCEEDED(hr) && i < filters->count; i++)
+    {
+        IFilter *filter = filters->items[i];
+        UINT w, h;
+
+        next = NULL;
+        IWICBitmapSource_GetSize(current, &w, &h);
+        switch (impl_from_IFilter(filter)->kind)
+        {
+        case FILTER_ROTATEFLIP:
+        {
+            IWICBitmapFlipRotator *rotator;
+            WICBitmapTransformOptions opts;
+            LONG angle = filter_long(filter, L"RotationAngle");
+            if (angle % 90) { hr = E_INVALIDARG; break; }
+            angle = ((angle % 360) + 360) % 360;
+            opts = angle == 90 ? WICBitmapTransformRotate90 : angle == 180 ? WICBitmapTransformRotate180 :
+                   angle == 270 ? WICBitmapTransformRotate270 : WICBitmapTransformRotate0;
+            if (filter_bool(filter, L"FlipHorizontal")) opts |= WICBitmapTransformFlipHorizontal;
+            if (filter_bool(filter, L"FlipVertical")) opts |= WICBitmapTransformFlipVertical;
+            if (SUCCEEDED(hr = IWICImagingFactory_CreateBitmapFlipRotator(factory, &rotator)))
+            {
+                if (SUCCEEDED(hr = IWICBitmapFlipRotator_Initialize(rotator, current, opts)))
+                    next = (IWICBitmapSource *)rotator;
+                else IWICBitmapFlipRotator_Release(rotator);
+            }
+            break;
+        }
+        case FILTER_CROP:
+        {
+            IWICBitmapClipper *clipper;
+            WICRect rect;
+            rect.X = filter_long(filter, L"Left");
+            rect.Y = filter_long(filter, L"Top");
+            rect.Width = w - rect.X - filter_long(filter, L"Right");
+            rect.Height = h - rect.Y - filter_long(filter, L"Bottom");
+            if (rect.X < 0 || rect.Y < 0 || rect.Width <= 0 || rect.Height <= 0) { hr = E_INVALIDARG; break; }
+            if (SUCCEEDED(hr = IWICImagingFactory_CreateBitmapClipper(factory, &clipper)))
+            {
+                if (SUCCEEDED(hr = IWICBitmapClipper_Initialize(clipper, current, &rect)))
+                    next = (IWICBitmapSource *)clipper;
+                else IWICBitmapClipper_Release(clipper);
+            }
+            break;
+        }
+        case FILTER_SCALE:
+        {
+            IWICBitmapScaler *scaler;
+            LONG mw = filter_long(filter, L"MaximumWidth"), mh = filter_long(filter, L"MaximumHeight");
+            UINT nw = mw > 0 ? mw : w, nh = mh > 0 ? mh : h;
+            if (filter_bool(filter, L"PreserveAspectRatio"))
+            {
+                if ((double)nw / w < (double)nh / h) nh = max(1, (UINT)((double)h * nw / w + 0.5));
+                else nw = max(1, (UINT)((double)w * nh / h + 0.5));
+            }
+            if (SUCCEEDED(hr = IWICImagingFactory_CreateBitmapScaler(factory, &scaler)))
+            {
+                if (SUCCEEDED(hr = IWICBitmapScaler_Initialize(scaler, current, nw, nh, WICBitmapInterpolationModeFant)))
+                    next = (IWICBitmapSource *)scaler;
+                else IWICBitmapScaler_Release(scaler);
+            }
+            break;
+        }
+        case FILTER_CONVERT:
+        {
+            VARIANT v;
+            if (SUCCEEDED(properties_get_value(impl_from_IFilter(filter)->props, L"FormatID", &v)))
+            {
+                if (V_VT(&v) != VT_BSTR || !parse_guid(V_BSTR(&v), &format)) hr = E_INVALIDARG;
+                VariantClear(&v);
+            }
+            quality = filter_long(filter, L"Quality");
+            break;
+        }
+        default:
+            FIXME("filter %s is not applied\n", debugstr_w(filter_infos[impl_from_IFilter(filter)->kind].name));
+            break;
+        }
+        if (next)
+        {
+            IWICBitmapSource_Release(current);
+            current = next;
+        }
+    }
+
+    for (f = 0; f < ARRAY_SIZE(image_formats); f++)
+        if (IsEqualGUID(&format, image_formats[f].wia)) container = *image_formats[f].container;
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = CreateStreamOnHGlobal(NULL, TRUE, &result))
+            && SUCCEEDED(hr = IWICImagingFactory_CreateEncoder(factory, &container, NULL, &encoder))
+            && SUCCEEDED(hr = IWICBitmapEncoder_Initialize(encoder, result, WICBitmapEncoderNoCache))
+            && SUCCEEDED(hr = IWICBitmapEncoder_CreateNewFrame(encoder, &frame_out, &options)))
+    {
+        if (IsEqualGUID(&container, &wic_jpeg) && options)
+        {
+            PROPBAG2 opt = { 0 };
+            VARIANT v;
+            opt.pstrName = (WCHAR *)L"ImageQuality";
+            V_VT(&v) = VT_R4;
+            V_R4(&v) = max(1, min(quality, 100)) / 100.0f;
+            IPropertyBag2_Write(options, 1, &opt, &v);
+        }
+        if (SUCCEEDED(hr = IWICBitmapFrameEncode_Initialize(frame_out, options)))
+        {
+            UINT w, h;
+            WICPixelFormatGUID pixel;
+            IWICBitmapSource_GetSize(current, &w, &h);
+            IWICBitmapSource_GetPixelFormat(current, &pixel);
+            IWICBitmapFrameEncode_SetSize(frame_out, w, h);
+            IWICBitmapFrameEncode_SetResolution(frame_out, xres, yres);
+            {
+                /* the encoder may want another pixel format (GIF: a palette) */
+                IWICFormatConverter *conv = NULL;
+                WICPixelFormatGUID wanted = pixel;
+                IWICBitmapFrameEncode_SetPixelFormat(frame_out, &wanted);
+                if (!IsEqualGUID(&wanted, &pixel)
+                        && SUCCEEDED(IWICImagingFactory_CreateFormatConverter(factory, &conv))
+                        && SUCCEEDED(IWICFormatConverter_Initialize(conv, current, &wanted, WICBitmapDitherTypeNone,
+                                                                    NULL, 0.0, WICBitmapPaletteTypeFixedWebPalette)))
+                    hr = IWICBitmapFrameEncode_WriteSource(frame_out, (IWICBitmapSource *)conv, NULL);
+                else hr = IWICBitmapFrameEncode_WriteSource(frame_out, current, NULL);
+                if (conv) IWICFormatConverter_Release(conv);
+            }
+        }
+        if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_Commit(frame_out);
+        if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_Commit(encoder);
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IStream_Stat(result, &stat, STATFLAG_NONAME))
+            && SUCCEEDED(hr = GetHGlobalFromStream(result, &global)))
+    {
+        hr = imagefile_from_data(GlobalLock(global), stat.cbSize.QuadPart, out);
+        GlobalUnlock(global);
+    }
+    if (options) IPropertyBag2_Release(options);
+    if (frame_out) IWICBitmapFrameEncode_Release(frame_out);
+    if (encoder) IWICBitmapEncoder_Release(encoder);
+    if (result) IStream_Release(result);
+    if (current) IWICBitmapSource_Release(current);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    if (in) IStream_Release(in);
+    IWICImagingFactory_Release(factory);
+    return hr;
+}
+
+static const IImageProcessVtbl imageprocess_vtbl =
+{
+    DISPOBJ_METHODS,
+    imageprocess_get_FilterInfos,
+    imageprocess_get_Filters,
+    imageprocess_Apply,
+};
+
+HRESULT imageprocess_create(IImageProcess **out)
+{
+    struct imageprocess *This;
+    struct filters *filters;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (!(filters = calloc(1, sizeof(*filters))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    dispobj_init(&filters->obj, &filters_vtbl, IFilters_tid, filters_destroy);
+    dispobj_init(&This->obj, &imageprocess_vtbl, IImageProcess_tid, imageprocess_destroy);
+    This->filters = (IFilters *)&filters->obj.IDispatch_iface;
+    *out = (IImageProcess *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
