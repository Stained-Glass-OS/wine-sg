+static HRESULT WINAPI vector_get_Picture(IVector *iface, LONG width, LONG height, VARIANT *result)
+{
+    IImageFile *image;
+    IPicture *picture;
+    PICTDESC desc = { sizeof(desc), PICTYPE_BITMAP };
+    IWICImagingFactory *factory;
+    IWICBitmapDecoder *decoder;
+    IWICBitmapFrameDecode *frame;
+    IWICFormatConverter *conv;
+    IStream *stream;
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+    const BYTE *data;
+    SIZE_T size;
+    UINT w, h;
+    void *bits;
+    HRESULT hr;
+
+    /* the bytes of an image file, as a picture object */
+    if (!result) return E_POINTER;
+    VariantInit(result);
+    if (FAILED(hr = IVector_get_ImageFile(iface, width, height, &image))) return hr;
+    imagefile_data(image, &data, &size);
+    if (!(factory = wic_factory()))
+    {
+        IImageFile_Release(image);
+        return E_FAIL;
+    }
+    stream = SHCreateMemStream(data, size);
+    hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand, &decoder);
+    if (SUCCEEDED(hr))
+    {
+        if (SUCCEEDED(hr = IWICBitmapDecoder_GetFrame(decoder, 0, &frame)))
+        {
+            if (SUCCEEDED(hr = IWICImagingFactory_CreateFormatConverter(factory, &conv)))
+            {
+                if (SUCCEEDED(hr = IWICFormatConverter_Initialize(conv, (IWICBitmapSource *)frame, &wic_32bppbgra,
+                        WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeCustom))
+                        && SUCCEEDED(hr = IWICFormatConverter_GetSize(conv, &w, &h)))
+                {
+                    bmi.bmiHeader.biWidth = w;
+                    bmi.bmiHeader.biHeight = -(LONG)h;
+                    bmi.bmiHeader.biPlanes = 1;
+                    bmi.bmiHeader.biBitCount = 32;
+                    desc.bmp.hbitmap = CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, &bits, NULL, 0);
+                    if (desc.bmp.hbitmap)
+                        hr = IWICFormatConverter_CopyPixels(conv, NULL, w * 4, w * 4 * h, bits);
+                    else hr = E_OUTOFMEMORY;
+                }
+                IWICFormatConverter_Release(conv);
+            }
+            IWICBitmapFrameDecode_Release(frame);
+        }
+        IWICBitmapDecoder_Release(decoder);
+    }
+    if (stream) IStream_Release(stream);
+    IWICImagingFactory_Release(factory);
+    IImageFile_Release(image);
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = OleCreatePictureIndirect(&desc, &IID_IPicture, TRUE, (void **)&picture)))
+    {
+        V_VT(result) = VT_DISPATCH;
+        IPicture_QueryInterface(picture, &IID_IDispatch, (void **)&V_DISPATCH(result));
+        IPicture_Release(picture);
+    }
+    else if (desc.bmp.hbitmap) DeleteObject(desc.bmp.hbitmap);
+    return hr;
+}
+
+static HRESULT WINAPI vector_get_ImageFile(IVector *iface, LONG width, LONG height, IImageFile **out)
+{
+    BYTE *data;
+    SIZE_T size;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = vector_bytes(iface, &data, &size))) return hr;
+    hr = imagefile_from_data(data, size, out);
+    free(data);
+    return hr;
+}
