+    LONG i;
+
+    for (i = 0; i < This->count; i++) IDeviceInfo_Release(This->infos[i]);
+    free(This->infos);
+    free(This);
+}
+
+static HRESULT WINAPI deviceinfos_get_Item(IDeviceInfos *iface, VARIANT *index, IDeviceInfo **out)
+{
+    struct deviceinfos *This = impl_from_IDeviceInfos(iface);
+    VARIANT v;
+    LONG i;
+
+    if (!index || !out) return E_POINTER;
+    *out = NULL;
+    if (V_VT(index) == (VT_BYREF | VT_VARIANT)) index = V_VARIANTREF(index);
+    VariantInit(&v);
+    if (V_VT(index) == VT_BSTR)
+    {
+        /* by its device ID */
+        for (i = 0; i < This->count; i++)
+        {
+            BSTR id = read_bstr(impl_from_IDeviceInfo(This->infos[i])->stg, WIA_DIP_DEV_ID);
+            BOOL match = !wcsicmp(id, V_BSTR(index));
+            SysFreeString(id);
+            if (match) break;
+        }
+    }
+    else if (SUCCEEDED(VariantChangeType(&v, index, 0, VT_I4))) i = V_I4(&v) - 1;
+    else return DISP_E_TYPEMISMATCH;
+    if (i < 0 || i >= This->count) return DISP_E_BADINDEX;
+    IDeviceInfo_AddRef(This->infos[i]);
+    *out = This->infos[i];
+    return S_OK;
+}
