+HRESULT vector_create(IVector **out)
+{
+    struct vector *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &vector_vtbl, IVector_tid, vector_destroy);
+    *out = (IVector *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
