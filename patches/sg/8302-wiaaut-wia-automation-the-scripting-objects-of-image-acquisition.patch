+/* Vector: a list of values, 1-based */
+
+struct vector
+{
+    struct dispobj obj;
+    VARIANT *values;
+    LONG count, size;
+};
+
+static inline struct vector *impl_from_IVector(IVector *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct vector, obj);
+}
+
+static void vector_destroy(struct dispobj *obj)
+{
+    struct vector *This = CONTAINING_RECORD(obj, struct vector, obj);
+    LONG i;
+
+    for (i = 0; i < This->count; i++) VariantClear(&This->values[i]);
+    free(This->values);
+    free(This);
+}
+
+static HRESULT vector_insert(struct vector *This, const VARIANT *value, LONG index)
+{
+    HRESULT hr;
+
+    if (index < 0 || index > This->count + 1) return E_INVALIDARG;
+    if (!index) index = This->count + 1;
+    if (This->count == This->size)
+    {
+        LONG size = This->size ? This->size * 2 : 16;
+        VARIANT *grown = realloc(This->values, size * sizeof(VARIANT));
+        if (!grown) return E_OUTOFMEMORY;
+        This->values = grown;
+        This->size = size;
+    }
+    memmove(&This->values[index], &This->values[index - 1], (This->count - index + 1) * sizeof(VARIANT));
+    VariantInit(&This->values[index - 1]);
+    if (FAILED(hr = VariantCopyInd(&This->values[index - 1], (VARIANT *)value)))
+    {
+        memmove(&This->values[index - 1], &This->values[index], (This->count - index + 1) * sizeof(VARIANT));
+        return hr;
+    }
+    This->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_get_Item(IVector *iface, LONG index, VARIANT *result)
+{
+    struct vector *This = impl_from_IVector(iface);
+
+    if (!result) return E_POINTER;
+    if (index < 1 || index > This->count) return DISP_E_BADINDEX;
+    VariantInit(result);
+    return VariantCopy(result, &This->values[index - 1]);
+}
+
+static HRESULT WINAPI vector_put_Item(IVector *iface, LONG index, VARIANT *value)
+{
+    struct vector *This = impl_from_IVector(iface);
+
+    if (index < 1 || index > This->count) return DISP_E_BADINDEX;
+    VariantClear(&This->values[index - 1]);
+    return VariantCopyInd(&This->values[index - 1], value);
+}
+
+static HRESULT WINAPI vector_get_Count(IVector *iface, LONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IVector(iface)->count;
+    return S_OK;
+}
+
+HRESULT vector_bytes(IVector *iface, BYTE **data, SIZE_T *size)
+{
+    struct vector *This = impl_from_IVector(iface);
+    LONG i;
+
+    if (!(*data = malloc(This->count ? This->count : 1))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        VARIANT v;
+        VariantInit(&v);
+        if (FAILED(VariantChangeType(&v, &This->values[i], 0, VT_UI1)))
+        {
+            free(*data);
+            return DISP_E_TYPEMISMATCH;
+        }
+        (*data)[i] = V_UI1(&v);
+    }
+    *size = This->count;
+    return S_OK;
+}
