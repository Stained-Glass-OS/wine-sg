+static const IDeviceInfosVtbl deviceinfos_vtbl =
+{
+    DISPOBJ_METHODS,
+    deviceinfos_get_Item,
+    deviceinfos_get_Count,
+    deviceinfos_get__NewEnum,
+};
+
+HRESULT deviceinfos_create(IDeviceInfos **out)
+{
+    struct deviceinfos *This;
+    IEnumWIA_DEV_INFO *devices;
+    IWiaPropertyStorage *stg;
+    IWiaDevMgr *mgr;
+    ULONG fetched;
+    HRESULT hr;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &deviceinfos_vtbl, IDeviceInfos_tid, deviceinfos_destroy);
+    if (SUCCEEDED(hr = get_device_manager(&mgr)))
+    {
+        if (SUCCEEDED(hr = IWiaDevMgr_EnumDeviceInfo(mgr, WIA_DEVINFO_ENUM_LOCAL, &devices)))
+        {
+            while (IEnumWIA_DEV_INFO_Next(devices, 1, &stg, &fetched) == S_OK && fetched == 1)
+            {
+                struct deviceinfo *info;
+                IDeviceInfo **grown;
+                if ((info = calloc(1, sizeof(*info))) && (grown = realloc(This->infos, (This->count + 1) * sizeof(*grown))))
+                {
+                    dispobj_init(&info->obj, &deviceinfo_vtbl, IDeviceInfo_tid, deviceinfo_destroy);
+                    info->stg = stg;
+                    This->infos = grown;
+                    This->infos[This->count++] = (IDeviceInfo *)&info->obj.IDispatch_iface;
+                }
+                else
+                {
+                    free(info);
+                    IWiaPropertyStorage_Release(stg);
+                }
+            }
+            IEnumWIA_DEV_INFO_Release(devices);
+        }
+        IWiaDevMgr_Release(mgr);
+    }
+    if (FAILED(hr)) WARN("no device list: %#lx\n", hr);
+    *out = (IDeviceInfos *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
