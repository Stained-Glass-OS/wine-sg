+static HRESULT WINAPI vector_get_BinaryData(IVector *iface, VARIANT *result)
+{
+    SAFEARRAY *sa;
+    BYTE *data, *dst;
+    SIZE_T size;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    if (FAILED(hr = vector_bytes(iface, &data, &size))) return hr;
+    if (!(sa = SafeArrayCreateVector(VT_UI1, 0, size)))
+    {
+        free(data);
+        return E_OUTOFMEMORY;
+    }
+    SafeArrayAccessData(sa, (void **)&dst);
+    memcpy(dst, data, size);
+    SafeArrayUnaccessData(sa);
+    free(data);
+    V_VT(result) = VT_ARRAY | VT_UI1;
+    V_ARRAY(result) = sa;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_put_BinaryData(IVector *iface, VARIANT *value)
+{
+    struct vector *This = impl_from_IVector(iface);
+    SAFEARRAY *sa;
+    LONG lower, upper, i;
+    BYTE *src;
+    VARIANT v;
+
+    if (!value) return E_POINTER;
+    if (V_VT(value) == (VT_BYREF | VT_VARIANT)) value = V_VARIANTREF(value);
+    if (V_VT(value) == (VT_ARRAY | VT_UI1)) sa = V_ARRAY(value);
+    else if (V_VT(value) == (VT_BYREF | VT_ARRAY | VT_UI1)) sa = *V_ARRAYREF(value);
+    else return DISP_E_TYPEMISMATCH;
+    if (FAILED(SafeArrayGetLBound(sa, 1, &lower)) || FAILED(SafeArrayGetUBound(sa, 1, &upper)))
+        return E_INVALIDARG;
+    IVector_Clear(iface);
+    SafeArrayAccessData(sa, (void **)&src);
+    V_VT(&v) = VT_UI1;
+    for (i = 0; i <= upper - lower; i++)
+    {
+        V_UI1(&v) = src[i];
+        vector_insert(This, &v, 0);
+    }
+    SafeArrayUnaccessData(sa);
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_get_String(IVector *iface, VARIANT_BOOL unicode, BSTR *result)
+{
+    struct vector *This = impl_from_IVector(iface);
+    WCHAR *text;
+    LONG i, n = 0;
+
+    if (!result) return E_POINTER;
+    if (!(text = malloc((This->count + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    /* bytes (or 16-bit units) up to the first zero */
+    for (i = 0; i < This->count; i++)
+    {
+        VARIANT v;
+        VariantInit(&v);
+        if (FAILED(VariantChangeType(&v, &This->values[i], 0, unicode ? VT_UI2 : VT_UI1))) break;
+        if (!(unicode ? V_UI2(&v) : V_UI1(&v))) break;
+        text[n++] = unicode ? V_UI2(&v) : V_UI1(&v);
+    }
+    text[n] = 0;
+    *result = SysAllocString(text);
+    free(text);
+    return *result ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI vector_get_Date(IVector *iface, DATE *date)
+{
+    struct vector *This = impl_from_IVector(iface);
+    SYSTEMTIME st = { 0 };
+    VARIANT v;
+    WORD f[8];
+    LONG i;
+
+    /* a SYSTEMTIME of eight 16-bit values */
+    if (!date) return E_POINTER;
+    if (This->count != 8) return E_INVALIDARG;
+    for (i = 0; i < 8; i++)
+    {
+        VariantInit(&v);
+        if (FAILED(VariantChangeType(&v, &This->values[i], 0, VT_UI2))) return DISP_E_TYPEMISMATCH;
+        f[i] = V_UI2(&v);
+    }
+    st.wYear = f[0]; st.wMonth = f[1]; st.wDayOfWeek = f[2]; st.wDay = f[3];
+    st.wHour = f[4]; st.wMinute = f[5]; st.wSecond = f[6]; st.wMilliseconds = f[7];
+    return SystemTimeToVariantTime(&st, date) ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI vector_put_Date(IVector *iface, DATE date)
+{
+    struct vector *This = impl_from_IVector(iface);
+    SYSTEMTIME st;
+    VARIANT v;
+    WORD f[8];
+    int i;
+
+    if (!VariantTimeToSystemTime(date, &st)) return E_INVALIDARG;
+    f[0] = st.wYear; f[1] = st.wMonth; f[2] = st.wDayOfWeek; f[3] = st.wDay;
+    f[4] = st.wHour; f[5] = st.wMinute; f[6] = st.wSecond; f[7] = st.wMilliseconds;
+    IVector_Clear(iface);
+    V_VT(&v) = VT_UI2;
+    for (i = 0; i < 8; i++)
+    {
+        V_UI2(&v) = f[i];
+        vector_insert(This, &v, 0);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_get__NewEnum(IVector *iface, IUnknown **out)
+{
+    struct vector *This = impl_from_IVector(iface);
+    return create_enum_variant(This->values, This->count, out);
+}
+
+static HRESULT WINAPI vector_Add(IVector *iface, VARIANT *value, LONG index)
+{
+    if (!value) return E_POINTER;
+    return vector_insert(impl_from_IVector(iface), value, index);
+}
+
+static HRESULT WINAPI vector_Remove(IVector *iface, LONG index, VARIANT *result)
+{
+    struct vector *This = impl_from_IVector(iface);
+
+    if (!result) return E_POINTER;
+    if (index < 1 || index > This->count) return DISP_E_BADINDEX;
+    *result = This->values[index - 1];
+    memmove(&This->values[index - 1], &This->values[index], (This->count - index) * sizeof(VARIANT));
+    This->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_Clear(IVector *iface)
+{
+    struct vector *This = impl_from_IVector(iface);
+    LONG i;
+
+    for (i = 0; i < This->count; i++) VariantClear(&This->values[i]);
+    This->count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_SetFromString(IVector *iface, BSTR value, VARIANT_BOOL resizable, VARIANT_BOOL unicode)
+{
+    struct vector *This = impl_from_IVector(iface);
+    UINT i, len = SysStringLen(value);
+    VARIANT v;
+
+    IVector_Clear(iface);
+    for (i = 0; i <= len; i++)
+    {
+        if (unicode)
+        {
+            V_VT(&v) = VT_UI2;
+            V_UI2(&v) = i < len ? value[i] : 0;
+        }
+        else
+        {
+            V_VT(&v) = VT_UI1;
+            V_UI1(&v) = i < len ? (BYTE)value[i] : 0;
+        }
+        vector_insert(This, &v, 0);
+    }
+    return S_OK;
+}
