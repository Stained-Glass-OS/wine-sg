+    HRESULT hr;
+
+    TRACE("(%p, %p, %#x, %#x, %d, %d, %d)\n", iface, device, intent, bias, single, common_ui, cancel_error);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!root) return E_INVALIDARG;
+    hr = IWiaItem_DeviceDlg(root, dialog_owner(), single ? WIA_DEVICE_DIALOG_SINGLE_IMAGE : 0, intent | bias,
+                            &count, &items);
+    if (hr == S_FALSE) return cancelled(cancel_error);
+    if (FAILED(hr)) return hr;
+    hr = items_create(items, count, out);
+    for (i = 0; i < count; i++) IWiaItem_Release(items[i]);
+    CoTaskMemFree(items);
+    return hr;
+}
+
+/* the properties of a device or an item, listed */
+
+struct props_dlg
+{
+    IProperties *props;
+    const WCHAR *title;
+};
+
+static INT_PTR CALLBACK props_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        struct props_dlg *dlg = (struct props_dlg *)lparam;
+        HWND list = GetDlgItem(hwnd, IDC_PROPLIST);
+        LVCOLUMNW col = { LVCF_TEXT | LVCF_WIDTH };
+        WCHAR text[64];
+
+        if (dlg->title) SetWindowTextW(hwnd, dlg->title);
+        SendMessageW(list, LVM_SETEXTENDEDLISTVIEWSTYLE, 0, LVS_EX_FULLROWSELECT);
+        LoadStringW(wiaaut_instance, IDS_PROPERTY, text, ARRAY_SIZE(text));
+        col.pszText = text;
+        col.cx = 200;
+        SendMessageW(list, LVM_INSERTCOLUMNW, 0, (LPARAM)&col);
+        LoadStringW(wiaaut_instance, IDS_VALUE, text, ARRAY_SIZE(text));
+        col.cx = 200;
+        SendMessageW(list, LVM_INSERTCOLUMNW, 1, (LPARAM)&col);
+        /* the list, through the enumerator of the properties */
+        {
+            IUnknown *unk;
+            IEnumVARIANT *values;
+            VARIANT v;
+            ULONG fetched;
+            int row = 0;
+
+            if (SUCCEEDED(IProperties_get__NewEnum(dlg->props, &unk)))
+            {
+                IUnknown_QueryInterface(unk, &IID_IEnumVARIANT, (void **)&values);
+                IUnknown_Release(unk);
+                while (values && IEnumVARIANT_Next(values, 1, &v, &fetched) == S_OK && fetched == 1)
+                {
+                    IProperty *prop = (IProperty *)V_DISPATCH(&v);
+                    LVITEMW item = { LVIF_TEXT };
+                    VARIANT value, str;
+                    BSTR name = NULL;
+
+                    VariantInit(&str);
+                    IProperty_get_Name(prop, &name);
+                    item.iItem = row;
+                    item.pszText = name ? name : (WCHAR *)L"";
+                    SendMessageW(list, LVM_INSERTITEMW, 0, (LPARAM)&item);
+                    if (SUCCEEDED(IProperty_get_Value(prop, &value)))
+                    {
+                        if (SUCCEEDED(VariantChangeType(&str, &value, 0, VT_BSTR)))
+                        {
+                            item.iSubItem = 1;
+                            item.pszText = V_BSTR(&str);
+                            SendMessageW(list, LVM_SETITEMTEXTW, row, (LPARAM)&item);
+                        }
+                        VariantClear(&value);
+                    }
+                    VariantClear(&str);
+                    SysFreeString(name);
+                    VariantClear(&v);
+                    row++;
+                }
+                if (values) IEnumVARIANT_Release(values);
+            }
+        }
+        return TRUE;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wparam) == IDOK || LOWORD(wparam) == IDCANCEL)
+        {
+            EndDialog(hwnd, LOWORD(wparam));
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static HRESULT show_properties(IProperties *props, const WCHAR *title, VARIANT_BOOL cancel_error)
+{
+    INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_LISTVIEW_CLASSES };
+    struct props_dlg dlg = { props, title };
+
+    InitCommonControlsEx(&icc);
+    if (DialogBoxParamW(wiaaut_instance, MAKEINTRESOURCEW(IDD_PROPERTIES), dialog_owner(), props_proc,
+                        (LPARAM)&dlg) == IDCANCEL)
+        return cancelled(cancel_error);
+    return S_OK;
+}
+
+static HRESULT WINAPI commondialog_ShowDeviceProperties(ICommonDialog *iface, IDevice *device, VARIANT_BOOL cancel_error)
+{
+    IProperties *props;
+    VARIANT name;
+    HRESULT hr;
+
+    if (!device) return E_INVALIDARG;
+    if (FAILED(hr = IDevice_get_Properties(device, &props))) return hr;
+    VariantInit(&name);
+    properties_get_value(props, WIA_DIP_DEV_NAME_STR, &name);
+    hr = show_properties(props, V_VT(&name) == VT_BSTR ? V_BSTR(&name) : NULL, cancel_error);
+    VariantClear(&name);
+    IProperties_Release(props);
+    return hr;
+}
+
+static HRESULT WINAPI commondialog_ShowItemProperties(ICommonDialog *iface, IItem *item, VARIANT_BOOL cancel_error)
+{
+    IProperties *props;
+    VARIANT name;
+    HRESULT hr;
+
+    if (!item) return E_INVALIDARG;
+    if (FAILED(hr = IItem_get_Properties(item, &props))) return hr;
+    VariantInit(&name);
+    properties_get_value(props, WIA_IPA_ITEM_NAME_STR, &name);
+    hr = show_properties(props, V_VT(&name) == VT_BSTR ? V_BSTR(&name) : NULL, cancel_error);
+    VariantClear(&name);
+    IProperties_Release(props);
+    return hr;
+}
+
+static HRESULT WINAPI commondialog_ShowTransfer(ICommonDialog *iface, IItem *item, BSTR format,
+                                                VARIANT_BOOL cancel_error, VARIANT *result)
+{
+    IWiaItem *wia = item_wia(item);
+    IImageFile *image;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %s, %d)\n", iface, item, debugstr_w(format), cancel_error);
+
+    if (!result) return E_POINTER;
+    VariantInit(result);
+    if (!wia) return E_INVALIDARG;
+    hr = transfer_item(wia, format, &image);
+    if (hr == WIAAUT_E_CANCELLED) return cancelled(cancel_error);
+    if (FAILED(hr)) return hr;
+    V_VT(result) = VT_DISPATCH;
+    V_DISPATCH(result) = (IDispatch *)image;
+    return S_OK;
+}
+
+static HRESULT WINAPI commondialog_ShowPhotoPrintingWizard(ICommonDialog *iface, VARIANT *files)
+{
+    FIXME("(%p, %p): no photo printing wizard\n", iface, files);
+    return E_NOTIMPL;
+}
