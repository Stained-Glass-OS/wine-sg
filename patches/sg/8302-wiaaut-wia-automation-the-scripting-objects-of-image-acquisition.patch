+/* one element of a vector value */
+static HRESULT get_elem(const PROPVARIANT *pv, ULONG i, PROPVARIANT *elem)
+{
+    PropVariantInit(elem);
+    if (!(pv->vt & VT_VECTOR) || i >= pv->cal.cElems) return E_INVALIDARG;
+    elem->vt = pv->vt & ~VT_VECTOR;
+    switch (elem->vt)
+    {
+    case VT_I1: case VT_UI1: elem->bVal = pv->caub.pElems[i]; break;
+    case VT_I2: case VT_UI2: case VT_BOOL: elem->uiVal = pv->caui.pElems[i]; break;
+    case VT_I4: case VT_UI4: case VT_ERROR: elem->ulVal = pv->caul.pElems[i]; break;
+    case VT_R4: elem->fltVal = pv->caflt.pElems[i]; break;
+    case VT_R8: elem->dblVal = pv->cadbl.pElems[i]; break;
+    case VT_I8: case VT_UI8: elem->uhVal = pv->cauh.pElems[i]; break;
+    case VT_CLSID:
+        if (!(elem->puuid = CoTaskMemAlloc(sizeof(GUID)))) return E_OUTOFMEMORY;
+        *elem->puuid = pv->cauuid.pElems[i];
+        break;
+    case VT_BSTR:
+        if (!(elem->bstrVal = SysAllocString(pv->cabstr.pElems[i]))) return E_OUTOFMEMORY;
+        break;
+    case VT_LPWSTR:
+        elem->vt = VT_BSTR;
+        if (!(elem->bstrVal = SysAllocString(pv->calpwstr.pElems[i]))) return E_OUTOFMEMORY;
+        break;
+    default:
+        elem->vt = VT_EMPTY;
+        return E_NOTIMPL;
+    }
+    return S_OK;
+}
+
+/* a WIA value as a script sees it: class IDs as strings, vectors as Vector objects */
+static HRESULT propvariant_to_variant(const PROPVARIANT *pv, VARIANT *v)
+{
+    IVector *vector;
+    ULONG i;
+    HRESULT hr;
+
+    VariantInit(v);
+    if (pv->vt == VT_CLSID)
+    {
+        V_VT(v) = VT_BSTR;
+        V_BSTR(v) = pv->puuid ? guid_string(pv->puuid) : SysAllocString(L"");
+        return S_OK;
+    }
+    if (pv->vt & VT_VECTOR)
+    {
+        if (FAILED(hr = vector_create(&vector))) return hr;
+        for (i = 0; i < pv->cal.cElems; i++)
+        {
+            PROPVARIANT elem;
+            VARIANT ev;
+            PropVariantInit(&elem);
+            if (SUCCEEDED(get_elem(pv, i, &elem)))
+            {
+                propvariant_to_variant(&elem, &ev);
+                vector_add(vector, &ev);
+                VariantClear(&ev);
+            }
+            PropVariantClear(&elem);
+        }
+        V_VT(v) = VT_DISPATCH;
+        V_DISPATCH(v) = (IDispatch *)vector;
+        return S_OK;
+    }
+    return PropVariantToVariant(pv, v);
+}
+
+static LONG wia_property_type(VARTYPE vt)
+{
+    static const struct { VARTYPE vt; LONG type; } map[] =
+    {
+        { VT_BOOL, BooleanPropertyType }, { VT_UI1, BytePropertyType }, { VT_I2, IntegerPropertyType },
+        { VT_UI2, UnsignedIntegerPropertyType }, { VT_I4, LongPropertyType }, { VT_UI4, UnsignedLongPropertyType },
+        { VT_ERROR, ErrorCodePropertyType }, { VT_I8, LargeIntegerPropertyType },
+        { VT_UI8, UnsignedLargeIntegerPropertyType }, { VT_R4, SinglePropertyType }, { VT_R8, DoublePropertyType },
+        { VT_CY, CurrencyPropertyType }, { VT_DATE, DatePropertyType }, { VT_FILETIME, FileTimePropertyType },
+        { VT_CLSID, ClassIDPropertyType }, { VT_BSTR, StringPropertyType }, { VT_LPWSTR, StringPropertyType },
+        { VT_UNKNOWN, ObjectPropertyType }, { VT_DISPATCH, ObjectPropertyType }, { VT_VARIANT, VariantPropertyType },
+    };
+    unsigned int i;
+    VARTYPE base = vt & ~VT_VECTOR;
+
+    for (i = 0; i < ARRAY_SIZE(map); i++)
+        if (map[i].vt == base)
+            return vt & VT_VECTOR ? (map[i].type == StringPropertyType ? VectorOfStringsPropertyType :
+                                     map[i].type + 100) : map[i].type;
+    return UnsupportedPropertyType;
+}
+
+static HRESULT read_entry(struct properties *props, LONG index, VARIANT *value)
+{
+    struct property_entry *entry = &props->entries[index];
+    PROPSPEC spec;
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    if (!props->storage)
+    {
+        VariantInit(value);
+        return VariantCopy(value, &entry->value);
+    }
+    /* the value now: writes to other properties change some (the extents with the resolution) */
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = entry->id;
+    PropVariantInit(&pv);
+    if (FAILED(hr = IWiaPropertyStorage_ReadMultiple(props->storage, 1, &spec, &pv))) return hr;
+    hr = propvariant_to_variant(&pv, value);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+static HRESULT WINAPI property_get_Value(IProperty *iface, VARIANT *result)
+{
+    struct property *This = impl_from_IProperty(iface);
+
+    if (!result) return E_POINTER;
+    return read_entry(This->props, This->index, result);
+}
+
+static HRESULT WINAPI property_put_Value(IProperty *iface, VARIANT *value)
+{
+    struct property *This = impl_from_IProperty(iface);
+    struct property_entry *entry = &This->props->entries[This->index];
+    PROPSPEC spec;
+    PROPVARIANT pv;
+    VARIANT conv;
+    GUID guid;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (entry->readonly) return E_ACCESSDENIED;
+    VariantInit(&conv);
+    if (V_VT(value) == (VT_BYREF | VT_VARIANT)) value = V_VARIANTREF(value);
+    if (!This->props->storage)
+    {
+        if (entry->vt == VT_EMPTY || entry->vt == VT_VARIANT) hr = VariantCopyInd(&conv, value);
+        else hr = VariantChangeType(&conv, value, 0, entry->vt);
+        if (FAILED(hr)) return hr;
+        VariantClear(&entry->value);
+        entry->value = conv;
+        return S_OK;
+    }
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = entry->id;
+    PropVariantInit(&pv);
+    if (entry->vt == VT_CLSID)
+    {
+        if (FAILED(hr = VariantChangeType(&conv, value, 0, VT_BSTR))) return hr;
+        if (!parse_guid(V_BSTR(&conv), &guid))
+        {
+            VariantClear(&conv);
+            return E_INVALIDARG;
+        }
+        VariantClear(&conv);
+        pv.vt = VT_CLSID;
+        pv.puuid = &guid;
+        return IWiaPropertyStorage_WriteMultiple(This->props->storage, 1, &spec, &pv, WIA_IPA_FIRST);
+    }
+    if (FAILED(hr = VariantChangeType(&conv, value, 0, entry->vt))) return hr;
+    if (SUCCEEDED(hr = VariantToPropVariant(&conv, &pv)))
+    {
+        hr = IWiaPropertyStorage_WriteMultiple(This->props->storage, 1, &spec, &pv, WIA_IPA_FIRST);
+        PropVariantClear(&pv);
+    }
+    VariantClear(&conv);
+    return hr;
+}
