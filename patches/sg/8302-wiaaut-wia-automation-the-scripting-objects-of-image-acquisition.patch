+static HRESULT WINAPI imagefile_LoadFile(IImageFile *iface, BSTR filename)
+{
+    struct imagefile *This = impl_from_IImageFile(iface);
+    LARGE_INTEGER size;
+    HANDLE file;
+    DWORD got;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!filename) return E_INVALIDARG;
+    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (!GetFileSizeEx(file, &size) || size.QuadPart > 0x7fffffff || !(data = malloc(size.QuadPart + 1)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, data, size.QuadPart, &got, NULL) || got != size.QuadPart)
+    {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(file);
+        free(data);
+        return hr;
+    }
+    CloseHandle(file);
+    free(This->data);
+    This->data = data;
+    This->size = got;
+    This->active = 0;
+    return imagefile_load(This);
+}
+
+static HRESULT WINAPI imagefile_SaveFile(IImageFile *iface, BSTR filename)
+{
+    struct imagefile *This = impl_from_IImageFile(iface);
+    HANDLE file;
+    DWORD written;
+    HRESULT hr = S_OK;
+
+    if (!filename) return E_INVALIDARG;
+    if (!This->data) return E_FAIL;
+    /* an existing file is not replaced */
+    file = CreateFileW(filename, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (!WriteFile(file, This->data, This->size, &written, NULL) || written != This->size)
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle(file);
+    return hr;
+}
