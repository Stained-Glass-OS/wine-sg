+HRESULT items_create(IWiaItem **wia_items, LONG count, IItems **out)
+{
+    struct items *This;
+    LONG i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &items_vtbl, IItems_tid, items_destroy);
+    if (count && !(This->items = calloc(count, sizeof(*This->items))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+        if (SUCCEEDED(item_create(wia_items[i], &This->items[This->count]))) This->count++;
+    *out = (IItems *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+HRESULT items_of(IWiaItem *parent, IItems **out)
+{
+    IEnumWiaItem *children;
+    IWiaItem *list[16];
+    ULONG fetched;
+    LONG type = 0, count = 0, i;
+    HRESULT hr;
+
+    IWiaItem_GetItemType(parent, &type);
+    if ((type & WiaItemTypeFolder) && SUCCEEDED(IWiaItem_EnumChildItems(parent, &children)))
+    {
+        while (count < ARRAY_SIZE(list) && IEnumWiaItem_Next(children, 1, &list[count], &fetched) == S_OK
+               && fetched == 1)
+            count++;
+        IEnumWiaItem_Release(children);
+    }
+    hr = items_create(list, count, out);
+    for (i = 0; i < count; i++) IWiaItem_Release(list[i]);
+    return hr;
+}
