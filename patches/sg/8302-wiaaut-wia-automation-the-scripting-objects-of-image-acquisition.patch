+    *root = NULL;
+    if (FAILED(hr = get_device_manager(&mgr))) return hr;
+    hr = IWiaDevMgr_SelectDeviceDlg(mgr, dialog_owner(), type, always ? WIA_SELECT_DEVICE_NODEFAULT : 0, NULL, root);
+    IWiaDevMgr_Release(mgr);
+    if (hr == S_FALSE) return cancelled(cancel_error) == S_OK ? S_FALSE : WIAAUT_E_CANCELLED;
+    return hr;
+}
