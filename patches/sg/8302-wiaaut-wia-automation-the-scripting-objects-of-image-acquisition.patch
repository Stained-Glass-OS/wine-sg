+/* helpers */
+
+BOOL parse_guid(const WCHAR *str, GUID *guid)
+{
+    WCHAR buf[40];
+
+    if (!str || wcslen(str) != 38) return FALSE;
+    lstrcpynW(buf, str, ARRAY_SIZE(buf));
+    return SUCCEEDED(CLSIDFromString(buf, guid));
+}
+
+BSTR guid_string(const GUID *guid)
+{
+    WCHAR buf[40];
+
+    StringFromGUID2(guid, buf, ARRAY_SIZE(buf));
+    return SysAllocString(buf);
+}
