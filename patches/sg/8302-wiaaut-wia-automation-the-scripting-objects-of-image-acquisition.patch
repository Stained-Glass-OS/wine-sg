+static HRESULT WINAPI filters_Remove(IFilters *iface, LONG index)
+{
+    struct filters *This = impl_from_IFilters(iface);
+
+    if (index < 1 || index > This->count) return DISP_E_BADINDEX;
+    IFilter_Release(This->items[index - 1]);
+    memmove(&This->items[index - 1], &This->items[index], (This->count - index) * sizeof(*This->items));
+    This->count--;
+    return S_OK;
+}
