+/* Properties: the properties of a device, an item or a filter */
+
+struct property_entry
+{
+    PROPID id;
+    BSTR name;
+    VARTYPE vt;
+    BOOL readonly;
+    ULONG flags;            /* WIA_PROP_RANGE/LIST/FLAG */
+    PROPVARIANT valid;
+    VARIANT value;          /* the value of a property without a storage */
+};
+
+struct properties
+{
+    struct dispobj obj;
+    IWiaPropertyStorage *storage;      /* NULL: the values are the object's own */
+    struct property_entry *entries;
+    LONG count;
+};
+
+struct property
+{
+    struct dispobj obj;
+    struct properties *props;
+    LONG index;
+};
