+static LONG valid_long(const struct property_entry *entry, ULONG index)
+{
+    if (entry->valid.vt != (VT_VECTOR | VT_I4) || index >= entry->valid.cal.cElems) return 0;
+    return entry->valid.cal.pElems[index];
+}
+
+static HRESULT WINAPI property_get_SubTypeDefault(IProperty *iface, VARIANT *result)
+{
+    struct property *This = impl_from_IProperty(iface);
+    struct property_entry *entry = &This->props->entries[This->index];
+    PROPVARIANT elem;
+    HRESULT hr;
+    ULONG index;
+
+    if (!result) return E_POINTER;
+    VariantInit(result);
+    if (!entry->flags) return read_entry(This->props, This->index, result);
+    index = entry->flags & WIA_PROP_RANGE ? WIA_RANGE_NOM : entry->flags & WIA_PROP_LIST ? WIA_LIST_NOM : WIA_FLAG_NOM;
+    PropVariantInit(&elem);
+    if (FAILED(hr = get_elem(&entry->valid, index, &elem))) return hr;
+    hr = propvariant_to_variant(&elem, result);
+    PropVariantClear(&elem);
+    return hr;
+}
+
+static HRESULT WINAPI property_get_SubTypeValues(IProperty *iface, IVector **out)
+{
+    struct property *This = impl_from_IProperty(iface);
+    struct property_entry *entry = &This->props->entries[This->index];
+    ULONG i;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (!(entry->flags & WIA_PROP_LIST)) return E_INVALIDARG;
+    if (FAILED(hr = vector_create(out))) return hr;
+    for (i = WIA_LIST_VALUES; i < entry->valid.cal.cElems; i++)
+    {
+        PROPVARIANT elem;
+        VARIANT v;
+        PropVariantInit(&elem);
+        if (FAILED(get_elem(&entry->valid, i, &elem))) continue;
+        propvariant_to_variant(&elem, &v);
+        vector_add(*out, &v);
+        VariantClear(&v);
+        PropVariantClear(&elem);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI property_get_SubTypeMin(IProperty *iface, LONG *value)
