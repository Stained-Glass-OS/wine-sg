+/* IEnumVARIANT */
+
+struct enum_variant
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    VARIANT *values;
+    ULONG count, pos;
+};
+
+static inline struct enum_variant *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_variant, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI enumvar_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumVARIANT))
+    {
+        IEnumVARIANT_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enumvar_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI enumvar_Release(IEnumVARIANT *iface)
+{
+    struct enum_variant *This = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) VariantClear(&This->values[i]);
+        free(This->values);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enumvar_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *out, ULONG *fetched)
+{
+    struct enum_variant *This = impl_from_IEnumVARIANT(iface);
+    ULONG n = 0;
+
+    if (!out) return E_POINTER;
+    while (n < celt && This->pos < This->count)
+    {
+        VariantInit(&out[n]);
+        VariantCopy(&out[n++], &This->values[This->pos++]);
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enumvar_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    struct enum_variant *This = impl_from_IEnumVARIANT(iface);
+    ULONG left = This->count - This->pos;
+
+    This->pos += min(celt, left);
+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enumvar_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enumvar_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct enum_variant *This = impl_from_IEnumVARIANT(iface);
+    IUnknown *unk;
+    HRESULT hr;
+
+    if (FAILED(hr = create_enum_variant(This->values, This->count, &unk))) return hr;
+    impl_from_IEnumVARIANT((IEnumVARIANT *)unk)->pos = This->pos;
+    *out = (IEnumVARIANT *)unk;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl enumvar_vtbl =
+{
+    enumvar_QueryInterface,
+    enumvar_AddRef,
+    enumvar_Release,
+    enumvar_Next,
+    enumvar_Skip,
+    enumvar_Reset,
+    enumvar_Clone,
+};
+
+HRESULT create_enum_variant(const VARIANT *values, ULONG count, IUnknown **out)
+{
+    struct enum_variant *This;
+    ULONG i;
+
+    if (!out) return E_POINTER;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (count && !(This->values = calloc(count, sizeof(VARIANT))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++) VariantCopy(&This->values[i], (VARIANT *)&values[i]);
+    This->IEnumVARIANT_iface.lpVtbl = &enumvar_vtbl;
+    This->ref = 1;
+    This->count = count;
+    *out = (IUnknown *)&This->IEnumVARIANT_iface;
+    return S_OK;
+}
