+static LONG read_long(IWiaPropertyStorage *stg, PROPID id, LONG def)
+{
+    PROPSPEC spec;
+    PROPVARIANT v;
+    LONG ret = def;
+
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    if (IWiaPropertyStorage_ReadMultiple(stg, 1, &spec, &v) == S_OK)
+    {
+        if (v.vt == VT_I4 || v.vt == VT_UI4) ret = v.lVal;
+        PropVariantClear(&v);
+    }
+    return ret;
+}
+
+static BSTR read_bstr(IWiaPropertyStorage *stg, PROPID id)
+{
+    PROPSPEC spec;
+    PROPVARIANT v;
+    BSTR ret = NULL;
+
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = id;
+    if (IWiaPropertyStorage_ReadMultiple(stg, 1, &spec, &v) == S_OK)
+    {
+        if (v.vt == VT_BSTR) ret = SysAllocString(v.bstrVal);
+        PropVariantClear(&v);
+    }
+    return ret ? ret : SysAllocString(L"");
+}
+
+static IWiaPropertyStorage *storage_of(IUnknown *unk)
+{
+    IWiaPropertyStorage *stg = NULL;
+
+    IUnknown_QueryInterface(unk, &IID_IWiaPropertyStorage, (void **)&stg);
+    return stg;
+}
+
+static HRESULT dispatch_enum(IDispatch **objs, LONG count, IUnknown **out)
+{
+    VARIANT *values;
+    LONG i;
+    HRESULT hr;
+
+    if (!(values = calloc(count ? count : 1, sizeof(VARIANT)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        V_VT(&values[i]) = VT_DISPATCH;
+        V_DISPATCH(&values[i]) = objs[i];
+    }
+    hr = create_enum_variant(values, count, out);
+    free(values);
+    return hr;
+}
+
+/* Formats: the format IDs an item transfers */
+
+struct formats
+{
+    struct dispobj obj;
+    BSTR *ids;
+    LONG count;
+};
+
+static inline struct formats *impl_from_IFormats(IFormats *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct formats, obj);
+}
+
+static void formats_destroy(struct dispobj *obj)
+{
+    struct formats *This = CONTAINING_RECORD(obj, struct formats, obj);
+    LONG i;
+
+    for (i = 0; i < This->count; i++) SysFreeString(This->ids[i]);
+    free(This->ids);
+    free(This);
+}
+
+static HRESULT WINAPI formats_get_Item(IFormats *iface, LONG index, BSTR *out)
+{
+    struct formats *This = impl_from_IFormats(iface);
+
+    if (!out) return E_POINTER;
+    if (index < 1 || index > This->count) return DISP_E_BADINDEX;
+    *out = SysAllocString(This->ids[index - 1]);
+    return S_OK;
+}
+
+static HRESULT WINAPI formats_get_Count(IFormats *iface, LONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_IFormats(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI formats_get__NewEnum(IFormats *iface, IUnknown **out)
+{
+    struct formats *This = impl_from_IFormats(iface);
+    VARIANT *values;
+    LONG i;
+    HRESULT hr;
+
+    if (!(values = calloc(This->count ? This->count : 1, sizeof(VARIANT)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        V_VT(&values[i]) = VT_BSTR;
+        V_BSTR(&values[i]) = This->ids[i];
+    }
+    hr = create_enum_variant(values, This->count, out);
+    free(values);
+    return hr;
+}
+
+static const IFormatsVtbl formats_vtbl =
+{
+    DISPOBJ_METHODS,
+    formats_get_Item,
+    formats_get_Count,
+    formats_get__NewEnum,
+};
+
+static HRESULT create_formats(IWiaItem *item, IFormats **out)
+{
+    IWiaDataTransfer *transfer;
+    IEnumWIA_FORMAT_INFO *formats;
+    struct formats *This;
+    WIA_FORMAT_INFO info;
+    ULONG fetched;
+    LONG i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &formats_vtbl, IFormats_tid, formats_destroy);
+    if (SUCCEEDED(IWiaItem_QueryInterface(item, &IID_IWiaDataTransfer, (void **)&transfer)))
+    {
+        if (SUCCEEDED(IWiaDataTransfer_idtEnumWIA_FORMAT_INFO(transfer, &formats)))
+        {
+            /* the formats of files (each once) */
+            while (IEnumWIA_FORMAT_INFO_Next(formats, 1, &info, &fetched) == S_OK && fetched == 1)
+            {
+                BSTR id, *grown;
+                if (info.lTymed != TYMED_FILE) continue;
+                id = guid_string(&info.guidFormatID);
+                for (i = 0; i < This->count; i++) if (!wcscmp(This->ids[i], id)) break;
+                if (i < This->count || !(grown = realloc(This->ids, (This->count + 1) * sizeof(BSTR))))
+                {
+                    SysFreeString(id);
+                    continue;
+                }
+                This->ids = grown;
+                This->ids[This->count++] = id;
+            }
+            IEnumWIA_FORMAT_INFO_Release(formats);
+        }
+        IWiaDataTransfer_Release(transfer);
+    }
+    *out = (IFormats *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+/* DeviceCommand(s), DeviceEvent(s): from the device's capabilities */
+
+struct capability
+{
+    struct dispobj obj;
+    BSTR id, name, description;
+    LONG flags;
+};
+
+static inline struct capability *impl_from_capability(void *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct capability, obj);
+}
+
+static void capability_destroy(struct dispobj *obj)
+{
+    struct capability *This = CONTAINING_RECORD(obj, struct capability, obj);
+
+    SysFreeString(This->id);
+    SysFreeString(This->name);
+    SysFreeString(This->description);
+    free(This);
+}
+
+static HRESULT WINAPI command_get_CommandID(IDeviceCommand *iface, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    *out = SysAllocString(impl_from_capability(iface)->id);
+    return S_OK;
+}
+
+static HRESULT WINAPI command_get_Name(IDeviceCommand *iface, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    *out = SysAllocString(impl_from_capability(iface)->name);
+    return S_OK;
+}
+
+static HRESULT WINAPI command_get_Description(IDeviceCommand *iface, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    *out = SysAllocString(impl_from_capability(iface)->description);
+    return S_OK;
+}
+
+static const IDeviceCommandVtbl command_vtbl =
+{
+    DISPOBJ_METHODS,
+    command_get_CommandID,
+    command_get_Name,
+    command_get_Description,
+};
+
+static HRESULT WINAPI event_get_EventID(IDeviceEvent *iface, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    *out = SysAllocString(impl_from_capability(iface)->id);
+    return S_OK;
+}
+
+static HRESULT WINAPI event_get_Type(IDeviceEvent *iface, WiaEventFlag *out)
+{
+    if (!out) return E_POINTER;
+    *out = impl_from_capability(iface)->flags & WIA_ACTION_EVENT ? ActionEvent : NotificationEvent;
+    return S_OK;
+}
+
+static HRESULT WINAPI event_get_Name(IDeviceEvent *iface, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    *out = SysAllocString(impl_from_capability(iface)->name);
+    return S_OK;
+}
+
+static HRESULT WINAPI event_get_Description(IDeviceEvent *iface, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    *out = SysAllocString(impl_from_capability(iface)->description);
+    return S_OK;
+}
+
+static const IDeviceEventVtbl event_vtbl =
+{
+    DISPOBJ_METHODS,
+    event_get_EventID,
+    event_get_Type,
+    event_get_Name,
+    event_get_Description,
+};
+
+struct capabilities
+{
+    struct dispobj obj;
+    IDispatch **items;
+    LONG count;
+};
+
+static inline struct capabilities *impl_from_capabilities(void *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct capabilities, obj);
+}
+
+static void capabilities_destroy(struct dispobj *obj)
+{
+    struct capabilities *This = CONTAINING_RECORD(obj, struct capabilities, obj);
+    LONG i;
+
+    for (i = 0; i < This->count; i++) IDispatch_Release(This->items[i]);
+    free(This->items);
+    free(This);
+}
+
+static HRESULT WINAPI capabilities_get_Item(IDispatch *iface, LONG index, IDispatch **out)
+{
+    struct capabilities *This = impl_from_capabilities(iface);
+
+    if (!out) return E_POINTER;
+    if (index < 1 || index > This->count) return DISP_E_BADINDEX;
+    IDispatch_AddRef(This->items[index - 1]);
+    *out = This->items[index - 1];
+    return S_OK;
+}
+
+static HRESULT WINAPI capabilities_get_Count(IDispatch *iface, LONG *count)
+{
+    if (!count) return E_POINTER;
+    *count = impl_from_capabilities(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI capabilities_get__NewEnum(IDispatch *iface, IUnknown **out)
+{
+    struct capabilities *This = impl_from_capabilities(iface);
+    return dispatch_enum(This->items, This->count, out);
+}
+
+static const IDeviceCommandsVtbl commands_vtbl =
+{
+    DISPOBJ_METHODS,
+    (void *)capabilities_get_Item,
+    (void *)capabilities_get_Count,
+    (void *)capabilities_get__NewEnum,
+};
+
+static const IDeviceEventsVtbl events_vtbl =
+{
+    DISPOBJ_METHODS,
+    (void *)capabilities_get_Item,
+    (void *)capabilities_get_Count,
+    (void *)capabilities_get__NewEnum,
+};
+
+static HRESULT create_capabilities(IWiaItem *root, BOOL events, IDispatch **out)
+{
+    struct capabilities *This;
+    IEnumWIA_DEV_CAPS *caps;
+    WIA_DEV_CAP cap;
+    ULONG fetched;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (events) dispobj_init(&This->obj, &events_vtbl, IDeviceEvents_tid, capabilities_destroy);
+    else dispobj_init(&This->obj, &commands_vtbl, IDeviceCommands_tid, capabilities_destroy);
+    if (root && SUCCEEDED(IWiaItem_EnumDeviceCapabilities(root, events ? WIA_DEVICE_EVENTS : WIA_DEVICE_COMMANDS, &caps)))
+    {
+        while (IEnumWIA_DEV_CAPS_Next(caps, 1, &cap, &fetched) == S_OK && fetched == 1)
+        {
+            struct capability *c;
+            IDispatch **grown;
+            BOOL is_event = (cap.ulFlags & (WIA_NOTIFICATION_EVENT | WIA_ACTION_EVENT)) != 0;
+
+            if (is_event == events && (c = calloc(1, sizeof(*c)))
+                    && (grown = realloc(This->items, (This->count + 1) * sizeof(*grown))))
+            {
+                dispobj_init(&c->obj, events ? (const void *)&event_vtbl : (const void *)&command_vtbl,
+                             events ? IDeviceEvent_tid : IDeviceCommand_tid, capability_destroy);
+                c->id = guid_string(&cap.guid);
+                c->name = SysAllocString(cap.bstrName ? cap.bstrName : L"");
+                c->description = SysAllocString(cap.bstrDescription ? cap.bstrDescription : L"");
+                c->flags = cap.ulFlags;
+                This->items = grown;
+                This->items[This->count++] = &c->obj.IDispatch_iface;
+            }
+            SysFreeString(cap.bstrName);
+            SysFreeString(cap.bstrDescription);
+            SysFreeString(cap.bstrIcon);
+            SysFreeString(cap.bstrCommandline);
+        }
+        IEnumWIA_DEV_CAPS_Release(caps);
+    }
+    *out = &This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+/* the transfer of an item into an ImageFile, through a file of this program */
+HRESULT transfer_item(IWiaItem *item, const WCHAR *format_id, IImageFile **out)
+{
+    IWiaPropertyStorage *stg;
+    IWiaDataTransfer *transfer;
+    IImageFile *image;
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    PROPSPEC spec;
+    PROPVARIANT pv;
+    STGMEDIUM medium;
+    GUID format;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!format_id || !parse_guid(format_id, &format) || IsEqualGUID(&format, &GUID_NULL)) format = WiaImgFmt_BMP;
+    if (!(stg = storage_of((IUnknown *)item))) return E_NOINTERFACE;
+    spec.ulKind = PRSPEC_PROPID;
+    spec.propid = WIA_IPA_FORMAT;
+    pv.vt = VT_CLSID;
+    pv.puuid = &format;
+    if (FAILED(hr = IWiaPropertyStorage_WriteMultiple(stg, 1, &spec, &pv, WIA_IPA_FIRST)))
+    {
+        /* a format the device does not make */
+        IWiaPropertyStorage_Release(stg);
+        return hr;
+    }
+    spec.propid = WIA_IPA_TYMED;
+    pv.vt = VT_I4;
+    pv.lVal = TYMED_FILE;
+    IWiaPropertyStorage_WriteMultiple(stg, 1, &spec, &pv, WIA_IPA_FIRST);
+    IWiaPropertyStorage_Release(stg);
+
+    if (FAILED(hr = IWiaItem_QueryInterface(item, &IID_IWiaDataTransfer, (void **)&transfer))) return hr;
+    GetTempPathW(ARRAY_SIZE(dir), dir);
+    if (!GetTempFileNameW(dir, L"wia", 0, path))
+    {
+        IWiaDataTransfer_Release(transfer);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    memset(&medium, 0, sizeof(medium));
+    medium.tymed = TYMED_FILE;
+    medium.lpszFileName = path;
+    hr = IWiaDataTransfer_idtGetData(transfer, &medium, NULL);
+    IWiaDataTransfer_Release(transfer);
+    if (hr == S_OK && SUCCEEDED(hr = imagefile_create(&image)))
+    {
+        BSTR name = SysAllocString(path);
+        if (SUCCEEDED(hr = IImageFile_LoadFile(image, name))) *out = image;
+        else IImageFile_Release(image);
+        SysFreeString(name);
+    }
+    DeleteFileW(path);
+    return hr == S_FALSE ? WIAAUT_E_CANCELLED : hr;
+}
+
+/* Item */
+
+struct item
+{
+    struct dispobj obj;
+    IWiaItem *wia;
+};
+
+static inline struct item *impl_from_IItem(IItem *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct item, obj);
+}
+
+static void item_destroy(struct dispobj *obj)
+{
+    struct item *This = CONTAINING_RECORD(obj, struct item, obj);
+
+    IWiaItem_Release(This->wia);
+    free(This);
+}
+
+static HRESULT WINAPI item_get_ItemID(IItem *iface, BSTR *out)
+{
+    IWiaPropertyStorage *stg;
+
+    if (!out) return E_POINTER;
+    if (!(stg = storage_of((IUnknown *)impl_from_IItem(iface)->wia))) return E_NOINTERFACE;
+    *out = read_bstr(stg, WIA_IPA_FULL_ITEM_NAME);
+    IWiaPropertyStorage_Release(stg);
+    return S_OK;
+}
+
+static HRESULT WINAPI item_get_Properties(IItem *iface, IProperties **out)
+{
+    IWiaPropertyStorage *stg;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (!(stg = storage_of((IUnknown *)impl_from_IItem(iface)->wia))) return E_NOINTERFACE;
+    hr = properties_from_storage(stg, out);
+    IWiaPropertyStorage_Release(stg);
+    return hr;
+}
+
+static HRESULT WINAPI item_get_Items(IItem *iface, IItems **out)
+{
+    if (!out) return E_POINTER;
+    return items_of(impl_from_IItem(iface)->wia, out);
+}
+
+static HRESULT WINAPI item_get_Formats(IItem *iface, IFormats **out)
+{
+    if (!out) return E_POINTER;
+    return create_formats(impl_from_IItem(iface)->wia, out);
+}
+
+static HRESULT WINAPI item_get_Commands(IItem *iface, IDeviceCommands **out)
+{
+    IWiaItem *root;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = IWiaItem_GetRootItem(impl_from_IItem(iface)->wia, &root))) return hr;
+    hr = create_capabilities(root, FALSE, (IDispatch **)out);
+    IWiaItem_Release(root);
+    return hr;
+}
+
+static HRESULT WINAPI item_get_WiaItem(IItem *iface, IUnknown **out)
+{
+    if (!out) return E_POINTER;
+    return IWiaItem_QueryInterface(impl_from_IItem(iface)->wia, &IID_IUnknown, (void **)out);
+}
+
+static HRESULT WINAPI item_Transfer(IItem *iface, BSTR format, VARIANT *result)
+{
+    IImageFile *image;
+    HRESULT hr;
+
+    TRACE("(%p, %s)\n", iface, debugstr_w(format));
+
+    if (!result) return E_POINTER;
+    VariantInit(result);
+    if (FAILED(hr = transfer_item(impl_from_IItem(iface)->wia, format, &image))) return hr;
+    V_VT(result) = VT_DISPATCH;
+    V_DISPATCH(result) = (IDispatch *)image;
+    return S_OK;
+}
+
+static HRESULT execute_command(IWiaItem *wia, BSTR command, IItem **out)
+{
+    IWiaItem *created = NULL;
+    GUID guid;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!command || !parse_guid(command, &guid)) return E_INVALIDARG;
+    if (FAILED(hr = IWiaItem_DeviceCommand(wia, 0, &guid, &created))) return hr;
+    if (created)
+    {
+        hr = item_create(created, out);
+        IWiaItem_Release(created);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI item_ExecuteCommand(IItem *iface, BSTR command, IItem **out)
+{
+    return execute_command(impl_from_IItem(iface)->wia, command, out);
+}
+
+static const IItemVtbl item_vtbl =
+{
+    DISPOBJ_METHODS,
+    item_get_ItemID,
+    item_get_Properties,
+    item_get_Items,
+    item_get_Formats,
+    item_get_Commands,
+    item_get_WiaItem,
+    item_Transfer,
+    item_ExecuteCommand,
+};
+
+HRESULT item_create(IWiaItem *wia, IItem **out)
+{
+    struct item *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    dispobj_init(&This->obj, &item_vtbl, IItem_tid, item_destroy);
+    IWiaItem_AddRef(wia);
+    This->wia = wia;
+    *out = (IItem *)&This->obj.IDispatch_iface;
+    return S_OK;
+}
+
+IWiaItem *item_wia(IItem *iface)
+{
+    return iface && iface->lpVtbl == &item_vtbl ? impl_from_IItem(iface)->wia : NULL;
+}
+
+/* Items */
+
+struct items
+{
+    struct dispobj obj;
+    IItem **items;
+    LONG count;
+};
+
+static inline struct items *impl_from_IItems(IItems *iface)
+{
+    return CONTAINING_RECORD(dispobj_from(iface), struct items, obj);
+}
+
+static void items_destroy(struct dispobj *obj)
+{
+    struct items *This = CONTAINING_RECORD(obj, struct items, obj);
+    LONG i;
+
+    for (i = 0; i < This->count; i++) IItem_Release(This->items[i]);
+    free(This->items);
+    free(This);
