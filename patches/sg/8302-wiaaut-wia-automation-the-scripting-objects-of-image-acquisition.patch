+static HRESULT WINAPI commondialog_ShowAcquisitionWizard(ICommonDialog *iface, IDevice *device, VARIANT *result)
+{
+    IWiaItem *root = device_root(device), **items = NULL;
+    IImageFile *image = NULL;
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    LONG count = 0, i;
+    HRESULT hr;
+    BSTR name;
+    int n;
+
+    TRACE("(%p, %p)\n", iface, device);
+
+    /* scans a picture into the Pictures folder, as the Scanner and Camera Wizard does */
+    if (!result) return E_POINTER;
+    VariantInit(result);
+    if (!root) return E_INVALIDARG;
+    hr = IWiaItem_DeviceDlg(root, dialog_owner(), WIA_DEVICE_DIALOG_SINGLE_IMAGE, 0, &count, &items);
+    if (hr != S_OK) return SUCCEEDED(hr) ? S_OK : hr;
+    if (count && SUCCEEDED(hr = transfer_item(items[0], L"{B96B3CAE-0728-11D3-9D7B-0000F81EF32E}", &image)))
+    {
+        SHGetFolderPathW(NULL, CSIDL_MYPICTURES | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, dir);
+        for (n = 1; n < 10000; n++)
+        {
+            if (n == 1) swprintf(path, ARRAY_SIZE(path), L"%s\\Scan.jpg", dir);
+            else swprintf(path, ARRAY_SIZE(path), L"%s\\Scan (%d).jpg", dir, n);
+            if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) break;
+        }
+        name = SysAllocString(path);
+        hr = IImageFile_SaveFile(image, name);
+        SysFreeString(name);
+        IImageFile_Release(image);
+    }
+    for (i = 0; i < count; i++) IWiaItem_Release(items[i]);
+    CoTaskMemFree(items);
+    return hr;
+}
+
+static HRESULT WINAPI commondialog_ShowAcquireImage(ICommonDialog *iface, WiaDeviceType type, WiaImageIntent intent,
+                                                    WiaImageBias bias, BSTR format, VARIANT_BOOL always,
+                                                    VARIANT_BOOL common_ui, VARIANT_BOOL cancel_error,
+                                                    IImageFile **out)
+{
+    IWiaItem *root, **items = NULL, *item = NULL;
+    LONG count = 0, i;
+    HRESULT hr;
+
+    TRACE("(%p, %d, %#x, %#x, %s, %d, %d, %d)\n", iface, type, intent, bias, debugstr_w(format), always, common_ui,
+          cancel_error);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if ((hr = select_root(type, always, cancel_error, &root)) != S_OK) return hr == S_FALSE ? S_OK : hr;
+    if (common_ui)
+    {
+        hr = IWiaItem_DeviceDlg(root, dialog_owner(), WIA_DEVICE_DIALOG_SINGLE_IMAGE, intent | bias, &count, &items);
+        if (hr == S_OK && count) item = items[0];
+        else if (hr == S_FALSE) hr = cancelled(cancel_error);
+    }
+    else
+    {
+        /* no dialog: the first item, with the intent asked for */
+        IEnumWiaItem *children;
+        ULONG fetched;
+        if (SUCCEEDED(hr = IWiaItem_EnumChildItems(root, &children)))
+        {
+            if (IEnumWiaItem_Next(children, 1, &item, &fetched) != S_OK) item = NULL;
+            IEnumWiaItem_Release(children);
+        }
+        if (item && intent)
+        {
+            IWiaPropertyStorage *stg = storage_of((IUnknown *)item);
+            PROPSPEC spec = { PRSPEC_PROPID, { WIA_IPS_CUR_INTENT } };
+            PROPVARIANT pv;
+            pv.vt = VT_I4;
+            pv.lVal = intent | bias;
+            if (stg)
+            {
+                IWiaPropertyStorage_WriteMultiple(stg, 1, &spec, &pv, WIA_IPA_FIRST);
+                IWiaPropertyStorage_Release(stg);
+            }
+        }
+        if (!item && SUCCEEDED(hr)) hr = E_FAIL;
+    }
+    if (item && hr == S_OK) hr = transfer_item(item, format, out);
+    if (!common_ui && item) IWiaItem_Release(item);
+    for (i = 0; i < count; i++) IWiaItem_Release(items[i]);
+    CoTaskMemFree(items);
+    IWiaItem_Release(root);
+    if (hr == WIAAUT_E_CANCELLED && !cancel_error) hr = S_OK;
+    return hr;
+}
+
+static HRESULT WINAPI commondialog_ShowSelectDevice(ICommonDialog *iface, WiaDeviceType type, VARIANT_BOOL always,
+                                                    VARIANT_BOOL cancel_error, IDevice **out)
