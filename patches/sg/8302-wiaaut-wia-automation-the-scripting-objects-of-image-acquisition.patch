+HRESULT vector_from_bytes(const BYTE *data, SIZE_T size, IVector **out)
+{
+    struct vector *This;
+    SIZE_T i;
+    HRESULT hr;
+
+    if (FAILED(hr = vector_create(out))) return hr;
+    This = impl_from_IVector(*out);
+    if (!(This->values = calloc(size ? size : 1, sizeof(VARIANT))))
+    {
+        IVector_Release(*out);
+        return E_OUTOFMEMORY;
+    }
+    This->size = size ? size : 1;
+    for (i = 0; i < size; i++)
+    {
+        V_VT(&This->values[i]) = VT_UI1;
+        V_UI1(&This->values[i]) = data[i];
+    }
+    This->count = size;
+    return S_OK;
+}
