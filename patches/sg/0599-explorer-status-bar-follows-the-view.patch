From: Stained Glass OS <ke7oxh@gmail.com>
Subject: explorer: File Explorer's status bar follows the view

After a paste added a file, File Explorer's status bar still said "0 items"
beside it (QA VM): the count was taken when a folder was opened or the
selection changed, not when the view added or removed items by itself (a
paste, a copy, a program writing into the folder). The count is looked at
twice a second and the status bar redrawn when it changed.

Gate: make test-statuscount.
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -142,6 +142,7 @@
 
 #define TIMER_SEARCH  1
 #define TIMER_NEWITEM 2
+#define TIMER_COUNT   3   /* Stained Glass OS: the status bar follows the view's items */
 
 enum content { CONTENT_FOLDER, CONTENT_THISPC, CONTENT_SEARCH, CONTENT_QUICK };
 /* This PC and Quick access are pages of ours */
@@ -228,6 +229,7 @@
 
     /* status bar */
     WCHAR status_left[128], status_sel[128];
+    int status_count;     /* the item count the status bar shows */
     RECT rc_view_details, rc_view_icons;
 
     /* This PC page */
@@ -2950,6 +2952,8 @@
             sel = SendMessageW(list, LVM_GETSELECTEDCOUNT, 0, 0);
         }
         format_items(fe.status_left, ARRAY_SIZE(fe.status_left), total);
+        fe.status_count = total;
+        TRACE("status: %s\n", debugstr_w(fe.status_left));
         if (sel)
         {
             IShellView *sv = get_view();
@@ -4889,6 +4893,14 @@
     case WM_TIMER:
         if (wp == TIMER_SEARCH) { KillTimer(hwnd, TIMER_SEARCH); start_search(); }
         if (wp == TIMER_NEWITEM && (rename_new_item() || ++fe.new_item_tries > 20)) KillTimer(hwnd, TIMER_NEWITEM);
+        /* items the view added or removed by itself (a paste, a program
+         * writing into the folder): the status bar said "0 items" beside
+         * a file */
+        if (wp == TIMER_COUNT && fe.content == CONTENT_FOLDER)
+        {
+            HWND list = get_view_list();
+            if (list && SendMessageW(list, LVM_GETITEMCOUNT, 0, 0) != fe.status_count) update_status();
+        }
         return 0;
     case WM_FE_STATUS:
     {
@@ -5170,6 +5182,7 @@
                               CW_USEDEFAULT, CW_USEDEFAULT, width, height, NULL, NULL, GetModuleHandleW(NULL), NULL);
     if (fe.sw) IShellWindows_Register(fe.sw, NULL, (LONG_PTR)fe.hwnd, SWC_EXPLORER, &fe.sw_cookie);
     AddClipboardFormatListener(fe.hwnd);
+    SetTimer(fe.hwnd, TIMER_COUNT, 500, NULL);
 
     fe.tooltip = CreateWindowExW(WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, TTS_ALWAYSTIP | TTS_NOPREFIX,
                                  0, 0, 0, 0, fe.hwnd, NULL, NULL, NULL);
