+    /* Stained Glass OS: pointer devices coming and going (wine-sg 1420) */
+    NtUserCallTwoParam_SgRegisterPointerNotify,
 };
 
 /* Stained Glass OS: the pointer message (a pen's) the thread is handling,
@@ -1356,6 +1358,12 @@
     return NtUserCallTwoParam( count, (UINT_PTR)devices, NtUserCallTwoParam_SgPointerDevices );
 }
 
+/* WM_POINTERDEVICECHANGE to HWND when a device comes or goes (wine-sg 1420) */
+static inline BOOL NtUserSgRegisterPointerNotify( HWND hwnd, BOOL range )
+{
+    return NtUserCallTwoParam( HandleToUlong( hwnd ), range, NtUserCallTwoParam_SgRegisterPointerNotify );
+}
+
 /* the display driver sets the list */
 static inline UINT NtUserSgSetPointerDevices( UINT count, const struct sg_pointer_device *devices )
 {
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -2615,17 +2615,58 @@
 static struct sg_pointer_device sg_pointer_device_list[SG_MAX_POINTER_DEVICES];
 static UINT sg_pointer_device_count;
 
+/* Stained Glass OS (wine-sg 1420): the windows that asked to hear of pointer
+ * devices coming and going (RegisterPointerDeviceNotifications) */
+static HWND sg_pointer_notify_windows[16];
+
+static BOOL sg_pointer_device_listed( const struct sg_pointer_device *list, UINT count, UINT handle )
+{
+    UINT i;
+    for (i = 0; i < count; i++) if (list[i].handle == handle) return TRUE;
+    return FALSE;
+}
+
+BOOL sg_register_pointer_notify( HWND hwnd, BOOL range )
+{
+    UINT i, free_slot = ARRAY_SIZE(sg_pointer_notify_windows);
+
+    if (!(hwnd = get_full_window_handle( hwnd )) || !is_window( hwnd ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    pthread_mutex_lock( &sg_pointer_devices_lock );
+    for (i = 0; i < ARRAY_SIZE(sg_pointer_notify_windows); i++)
+    {
+        if (sg_pointer_notify_windows[i] == hwnd) break;
+        if (free_slot == ARRAY_SIZE(sg_pointer_notify_windows) &&
+            (!sg_pointer_notify_windows[i] || !is_window( sg_pointer_notify_windows[i] )))
+            free_slot = i;
+    }
+    if (i == ARRAY_SIZE(sg_pointer_notify_windows) && free_slot < i) sg_pointer_notify_windows[free_slot] = hwnd;
+    pthread_mutex_unlock( &sg_pointer_devices_lock );
+    TRACE( "hwnd %p range %d\n", hwnd, range );
+    return TRUE;
+}
+
 UINT sg_pointer_devices( UINT count, struct sg_pointer_device *devices )
 {
-    UINT ret;
+    struct sg_pointer_device old[SG_MAX_POINTER_DEVICES];
+    HWND windows[ARRAY_SIZE(sg_pointer_notify_windows)];
+    UINT ret, i, j, old_count = 0, nwindows = 0;
+    BOOL set = !!(count & 0x80000000);
 
     pthread_mutex_lock( &sg_pointer_devices_lock );
-    if (count & 0x80000000)
+    if (set)
     {
+        old_count = sg_pointer_device_count;
+        memcpy( old, sg_pointer_device_list, old_count * sizeof(*old) );
         count = min( count & 0xff, SG_MAX_POINTER_DEVICES );
         if (devices) memcpy( sg_pointer_device_list, devices, count * sizeof(*devices) );
         sg_pointer_device_count = devices ? count : 0;
         ret = sg_pointer_device_count;
+        for (i = 0; i < ARRAY_SIZE(sg_pointer_notify_windows); i++)
+            if (sg_pointer_notify_windows[i]) windows[nwindows++] = sg_pointer_notify_windows[i];
     }
     else
     {
@@ -2633,6 +2674,25 @@
         if (devices) memcpy( devices, sg_pointer_device_list, min( count, ret ) * sizeof(*devices) );
     }
     pthread_mutex_unlock( &sg_pointer_devices_lock );
+
+    /* Stained Glass OS (wine-sg 1420): a device that came (a pen first seen
+     * after the program started) or went is WM_POINTERDEVICECHANGE to the
+     * windows registered for it, as on Windows -- a drawing program lists
+     * the devices again then. Before, RegisterPointerDeviceNotifications was
+     * a stub and a program heard of no new pen. The display driver sets the
+     * list from each of a process's threads: only a change is told. */
+#ifndef SG_MUTANT_LATEPEN_NO_NOTIFY
+    for (j = 0; set && j < nwindows; j++)
+    {
+        if (!is_window( windows[j] )) continue;
+        for (i = 0; i < old_count; i++)
+            if (!sg_pointer_device_listed( sg_pointer_device_list, ret, old[i].handle ))
+                NtUserPostMessage( windows[j], WM_POINTERDEVICECHANGE, PDC_REMOVAL, old[i].handle );
+        for (i = 0; i < ret; i++)
+            if (!sg_pointer_device_listed( old, old_count, devices[i].handle ))
+                NtUserPostMessage( windows[j], WM_POINTERDEVICECHANGE, PDC_ARRIVAL, devices[i].handle );
+    }
+#endif
     return ret;
 }
 
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -112,6 +112,7 @@
 extern void update_mouse_tracking_info( HWND hwnd );
 extern BOOL get_clip_cursor( RECT *rect, UINT dpi, MONITOR_DPI_TYPE type );
 extern UINT sg_pointer_devices( UINT count, struct sg_pointer_device *devices );
+extern BOOL sg_register_pointer_notify( HWND hwnd, BOOL range );
 /* Stained Glass OS: touches as touches (wine-sg 1150, input.c) */
 extern void free_touch_state(void);
 extern void sg_touch_retrieved( MSG *msg, UINT hw_id, UINT32 info );
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7526,6 +7526,9 @@
     case NtUserCallTwoParam_SgPointerDevices:
         return sg_pointer_devices( arg1, (struct sg_pointer_device *)arg2 );
 
+    case NtUserCallTwoParam_SgRegisterPointerNotify:
+        return sg_register_pointer_notify( UlongToHandle( arg1 ), arg2 );
+
     default:
         FIXME( "invalid code %u\n", (int)code );
         return 0;
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -454,8 +454,10 @@
  */
 BOOL WINAPI RegisterPointerDeviceNotifications(HWND hwnd, BOOL notifyrange)
 {
-    FIXME("(%p %d): stub\n", hwnd, notifyrange);
-    return TRUE;
+    /* Stained Glass OS (wine-sg 1420): WM_POINTERDEVICECHANGE when a pen or
+     * touch screen comes or goes (win32u); the range messages are not sent */
+    TRACE("(%p %d)\n", hwnd, notifyrange);
+    return NtUserSgRegisterPointerNotify( hwnd, notifyrange );
 }
 
 /* Stained Glass OS: the pens (the display driver's: X's) as pointer devices
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -355,7 +355,8 @@
     struct sg_pointer_device devs[SG_MAX_POINTER_DEVICES];
     struct pen_device pens[SG_MAX_POINTER_DEVICES];
     struct touch_device touches[ARRAY_SIZE(touch_devices)];
-    int major = 2, minor = 2, count, i, j, npens = 0, ntouches = 0, ndevs = 0;
+    int major = 2, minor = 2, count, i, j, npens = 0, ntouches = 0, ndevs = 0, ngone = 0;
+    int gone[SG_MAX_POINTER_DEVICES];
     XIDeviceInfo *info;
 
     if (pXIQueryVersion( display, &major, &minor )) return;
@@ -438,12 +439,37 @@
     }
 
     pthread_mutex_lock( &pen_devices_lock );
+    /* the pens gone since the list was last read */
+    for (i = 0; i < pen_device_count; i++)
+    {
+        for (j = 0; j < npens; j++) if (pens[j].id == pen_devices[i].id) break;
+        if (j == npens && ngone < ARRAY_SIZE(gone)) gone[ngone++] = pen_devices[i].id;
+    }
     memcpy( pen_devices, pens, npens * sizeof(*pens) );
     pen_device_count = npens;
     memcpy( touch_devices, touches, ntouches * sizeof(*touches) );
     touch_device_count = ntouches;
     pthread_mutex_unlock( &pen_devices_lock );
     NtUserSgSetPointerDevices( ndevs, ndevs ? devs : NULL );
+
+    /* Stained Glass OS (wine-sg 1420): a pen whose device went (its tablet
+     * unplugged, a Bluetooth pen switched off) leaves the window it was
+     * over -- the X server says no more of it, and the program had the pen
+     * in range over its window for ever. Each process says it once (the
+     * first of its threads to read the list); the server forgets the pen at
+     * the first. */
+#ifndef SG_MUTANT_LATEPEN_NO_LEAVE
+    for (i = 0; i < ngone; i++)
+    {
+        INPUT input = {.type = INPUT_HARDWARE};
+
+        TRACE( "pen %d gone\n", gone[i] );
+        input.hi.uMsg = WM_POINTERLEAVE;
+        input.hi.wParamL = SG_PEN_POINTER_ID( gone[i] );
+        input.hi.wParamH = 0;
+        NtUserSendHardwareInput( 0, 0, &input, (LPARAM)((ULONG64)SG_PEN_MARK << 32) );
+    }
+#endif
 }
 
