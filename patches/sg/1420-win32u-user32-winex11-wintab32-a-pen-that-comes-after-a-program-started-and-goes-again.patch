@@ -2421,6 +2447,12 @@
 #endif
     TRACE( "devices changed (%#x)\n", event->flags );
     load_pen_devices( event->display );
+    /* the thread's last pen gone: its state with it (wine-sg 1420) */
+    if (data && data->pen_last_device && !find_pen_device( data->pen_last_device ))
