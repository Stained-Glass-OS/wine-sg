 }
 
+/* Stained Glass OS (wine-sg 1420): whether the display driver lists a pen
+ * among the pointer devices (GetPointerDevices) */
+static BOOL pen_listed(void)
+{
+    POINTER_DEVICE_INFO devices[16];
+    UINT32 count = ARRAY_SIZE(devices), i;
+
+    if (!GetPointerDevices(&count, devices)) return FALSE;
+    for (i = 0; i < count && i < ARRAY_SIZE(devices); i++)
+        if (devices[i].pointerDeviceType == POINTER_DEVICE_TYPE_INTEGRATED_PEN ||
+            devices[i].pointerDeviceType == POINTER_DEVICE_TYPE_EXTERNAL_PEN) return TRUE;
+    return FALSE;
+}
+
 static inline BOOL LoadTablet(void)
 {
     static enum {TI_START = 0, TI_OK, TI_FAIL} loaded = TI_START;
+    static DWORD failed_at;
 
+    /* Stained Glass OS (wine-sg 1420): no tablet when the program first
+     * asked was no tablet for ever -- a pen first seen after the program
+     * started (a tablet plugged in, a Bluetooth pen switched on, a Surface's
+     * iptsd starting late) had no Wintab. Once a pen is listed, the tablet
+     * is read again (at most twice a second), for a program asking again. */
+#ifndef SG_MUTANT_LATEPEN_WINTAB_ONCE
+    if (loaded == TI_FAIL && GetTickCount() - failed_at >= 500 && pen_listed())
+    {
+        TRACE("A pen came: reading the tablet again\n");
+        loaded = TI_START;
+    }
+#endif
     if (loaded == TI_START)
     {
         if (pLoadTabletInfo && pLoadTabletInfo(hwndDefault))
@@ -158,6 +185,7 @@
         {
             TRACE("Failed to initialize the tablet to hwnd %p\n", hwndDefault);
             loaded = TI_FAIL;
+            failed_at = GetTickCount();
         }
     }
 
