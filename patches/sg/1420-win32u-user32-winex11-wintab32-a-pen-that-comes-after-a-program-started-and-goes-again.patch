     reselect_pen_windows( event->display, DefaultRootWindow( event->display ), 0 );
     if (NtUserGetWindowThread( NtUserGetDesktopWindow(), NULL ) == GetCurrentThreadId())
         x11drv_touch_gestures_enable( event->display );
--- a/dlls/wintab32/context.c
+++ b/dlls/wintab32/context.c
@@ -143,10 +143,37 @@
