+/***********************************************************************
+ *           VariantCompare (PROPSYS.@)
+ *
+ * Stained Glass OS 1695: as PropVariantCompare, the VARIANTs' values as
+ * PROPVARIANTs (the default unit and flags).
+ */
+INT WINAPI VariantCompare(REFVARIANT var1, REFVARIANT var2)
+{
+    PROPVARIANT pv1, pv2;
+    INT ret;
+
+    TRACE("%s, %s\n", debugstr_variant(var1), debugstr_variant(var2));
+
+    if (FAILED(VariantToPropVariant(var1, &pv1))) return -1;
+    if (FAILED(VariantToPropVariant(var2, &pv2)))
+    {
+        PropVariantClear(&pv1);
+        return 1;
+    }
+    ret = PropVariantCompareEx(&pv1, &pv2, PVCU_DEFAULT, PVCF_DEFAULT);
+    PropVariantClear(&pv1);
+    PropVariantClear(&pv2);
+    return ret;
+}
+
 INT WINAPI PropVariantCompareEx(REFPROPVARIANT propvar1, REFPROPVARIANT propvar2,
     PROPVAR_COMPARE_UNIT unit, PROPVAR_COMPARE_FLAGS flags)
