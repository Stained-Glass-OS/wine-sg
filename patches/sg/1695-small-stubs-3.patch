+/*********************************************************************
+ * _invoke_watson (UCRTBASE.@)
+ *
+ * Stained Glass OS 1695: the end of a process whose invalid parameter
+ * handler returned: a fail-fast with FAST_FAIL_INVALID_ARG, as documented.
+ */
+void WINAPI RaiseFailFastException( EXCEPTION_RECORD *, CONTEXT *, DWORD );
+
+void CDECL _invoke_watson( const wchar_t *expr, const wchar_t *func, const wchar_t *file, unsigned int line,
+                           uintptr_t reserved )
+{
+    EXCEPTION_RECORD rec;
+
+    TRACE( "%s %s %s %u\n", debugstr_w(expr), debugstr_w(func), debugstr_w(file), line );
+
+    /* as __fastfail(FAST_FAIL_INVALID_ARG) does */
+    memset( &rec, 0, sizeof(rec) );
+    rec.ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+    rec.ExceptionFlags = EXCEPTION_NONCONTINUABLE;
+    rec.ExceptionAddress = __builtin_return_address(0);
+    rec.NumberParameters = 1;
+    rec.ExceptionInformation[0] = 5;  /* FAST_FAIL_INVALID_ARG */
+    RaiseFailFastException( &rec, NULL, 0 );
+    _exit( STATUS_INVALID_CRUNTIME_PARAMETER );
+}
+
