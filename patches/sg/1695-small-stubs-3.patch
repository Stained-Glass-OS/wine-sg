+++ b/dlls/msvcp90/exception.c
@@ -1247,6 +1247,28 @@ void __cdecl _Throw_C_error(int code)
 #endif
 
 #if _MSVCP_VER >= 140
+/* ?_Throw_Cpp_error@std@@YAXH@Z
+ * Stained Glass OS 1695: the thread library's errors as system_error:
+ * busy, invalid argument, no such process, not enough memory, operation
+ * not permitted, deadlock would occur, try again */
+void __cdecl _Throw_Cpp_error(int code)
+{
+    static const int errnos[] = { EBUSY, EINVAL, ESRCH, ENOMEM, EPERM, EDEADLK, EAGAIN };
+    system_error se;
+    const char *msg;
+
+    TRACE("(%d)\n", code);
+
+    if (code < 0 || code >= ARRAY_SIZE(errnos)) abort();
+    msg = strerror(errnos[code]);
+    MSVCP_runtime_error_ctor(&se.base, &msg);
+    se.code.code = errnos[code];
+    se.code.category = std_generic_category();
+    se.base.e.vtable = &system_error_vtable;
+
+    _CxxThrowException(&se, &system_error_exception_type);
+}
+
