+/******************************************************************************
+ *	DbgPrompt	[NTDLL.@]
+ *
+ * Stained Glass OS 1695: the prompt goes to the debugger, as DbgPrint's
+ * text does; with no kernel debugger to answer, no characters come back.
+ */
+ULONG WINAPI DbgPrompt( PCCH prompt, PCH response, ULONG length )
+{
+    TRACE( "%s, %p, %lu\n", debugstr_a(prompt), response, length );
+
+    if (prompt) DbgPrint( "%s", prompt );
+    if (response && length) response[0] = 0;
+    return 0;
+}
