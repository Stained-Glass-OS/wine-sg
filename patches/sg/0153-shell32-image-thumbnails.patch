+/* ------------------------------------------------------------------------ */
+/* the image thumbnail provider                                             */
+
+struct image_thumbnail
+{
+    IThumbnailProvider IThumbnailProvider_iface;
+    IInitializeWithStream IInitializeWithStream_iface;
+    IInitializeWithFile IInitializeWithFile_iface;
+    LONG ref;
+    IStream *stream;
+    WCHAR *path;
+};
+
+static struct image_thumbnail *impl_from_IThumbnailProvider(IThumbnailProvider *iface)
+{
+    return CONTAINING_RECORD(iface, struct image_thumbnail, IThumbnailProvider_iface);
+}
+
+static struct image_thumbnail *impl_from_IInitializeWithStream(IInitializeWithStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct image_thumbnail, IInitializeWithStream_iface);
+}
+
+static struct image_thumbnail *impl_from_IInitializeWithFile(IInitializeWithFile *iface)
+{
+    return CONTAINING_RECORD(iface, struct image_thumbnail, IInitializeWithFile_iface);
+}
+
+static HRESULT WINAPI thumbnail_QueryInterface(IThumbnailProvider *iface, REFIID riid, void **out)
+{
+    struct image_thumbnail *thumb = impl_from_IThumbnailProvider(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IThumbnailProvider))
+        *out = &thumb->IThumbnailProvider_iface;
+    else if (IsEqualIID(riid, &IID_IInitializeWithStream))
+        *out = &thumb->IInitializeWithStream_iface;
+    else if (IsEqualIID(riid, &IID_IInitializeWithFile))
+        *out = &thumb->IInitializeWithFile_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI thumbnail_AddRef(IThumbnailProvider *iface)
+{
+    return InterlockedIncrement(&impl_from_IThumbnailProvider(iface)->ref);
+}
+
+static ULONG WINAPI thumbnail_Release(IThumbnailProvider *iface)
+{
+    struct image_thumbnail *thumb = impl_from_IThumbnailProvider(iface);
+    ULONG ref = InterlockedDecrement(&thumb->ref);
+
+    if (!ref)
+    {
+        if (thumb->stream) IStream_Release(thumb->stream);
+        free(thumb->path);
+        free(thumb);
+    }
+    return ref;
+}
