+HRESULT WINAPI ImageThumbnailProvider_Constructor(IUnknown *outer, REFIID riid, void **out)
+{
+    struct image_thumbnail *thumb;
+    HRESULT hr;
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(thumb = calloc(1, sizeof(*thumb)))) return E_OUTOFMEMORY;
+    thumb->IThumbnailProvider_iface.lpVtbl = &thumbnail_vtbl;
+    thumb->IInitializeWithStream_iface.lpVtbl = &init_stream_vtbl;
+    thumb->IInitializeWithFile_iface.lpVtbl = &init_file_vtbl;
+    thumb->ref = 1;
+    hr = thumbnail_QueryInterface(&thumb->IThumbnailProvider_iface, riid, out);
+    thumbnail_Release(&thumb->IThumbnailProvider_iface);
+    return hr;
+}
+
+/* ------------------------------------------------------------------------ */
+/* a file type's thumbnail handler                                          */
+
+static BOOL read_handler(const WCHAR *cls, const WCHAR *prefix, const WCHAR *iid, CLSID *clsid)
+{
+    WCHAR key[MAX_PATH], value[64];
+    LONG size = sizeof(value);
+
+    swprintf(key, ARRAY_SIZE(key), L"%s%s\\ShellEx\\%s", prefix, cls, iid);
+    if (RegQueryValueW(HKEY_CLASSES_ROOT, key, value, &size) || !value[0]) return FALSE;
+    return SUCCEEDED(CLSIDFromString(value, clsid));
+}
+
+/* where Windows looks: the extension, its SystemFileAssociations, then its ProgID */
+static BOOL find_handler(const WCHAR *ext, const WCHAR *iid, CLSID *clsid)
+{
+    WCHAR progid[MAX_PATH];
+    LONG size = sizeof(progid);
+
+    if (read_handler(ext, L"", iid, clsid)) return TRUE;
+    if (read_handler(ext, L"SystemFileAssociations\\", iid, clsid)) return TRUE;
+    if (!RegQueryValueW(HKEY_CLASSES_ROOT, ext, progid, &size) && progid[0] && read_handler(progid, L"", iid, clsid))
+        return TRUE;
+    return FALSE;
+}
+
+/* the handler's thumbnail of a file, through whichever initialization it takes */
+static HRESULT provider_thumbnail(const CLSID *clsid, const ITEMIDLIST *pidl, const WCHAR *path, UINT size, HBITMAP *bitmap)
+{
+    IThumbnailProvider *provider;
+    IInitializeWithStream *init_stream;
+    IInitializeWithItem *init_item;
+    IInitializeWithFile *init_file;
+    WTS_ALPHATYPE alpha;
+    HRESULT hr;
+
+    hr = CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IThumbnailProvider, (void **)&provider);
+    if (FAILED(hr)) return hr;
+    hr = E_NOINTERFACE;
+    if (SUCCEEDED(IThumbnailProvider_QueryInterface(provider, &IID_IInitializeWithStream, (void **)&init_stream)))
+    {
+        IStream *stream;
+        if (SUCCEEDED(hr = SHCreateStreamOnFileEx(path, STGM_READ | STGM_SHARE_DENY_NONE, 0, FALSE, NULL, &stream)))
+        {
+            hr = IInitializeWithStream_Initialize(init_stream, stream, STGM_READ);
+            IStream_Release(stream);
+        }
+        IInitializeWithStream_Release(init_stream);
+    }
+    if (FAILED(hr) && SUCCEEDED(IThumbnailProvider_QueryInterface(provider, &IID_IInitializeWithItem, (void **)&init_item)))
+    {
+        IShellItem *item;
+        if (SUCCEEDED(hr = SHCreateItemFromIDList(pidl, &IID_IShellItem, (void **)&item)))
+        {
+            hr = IInitializeWithItem_Initialize(init_item, item, STGM_READ);
+            IShellItem_Release(item);
+        }
+        IInitializeWithItem_Release(init_item);
+    }
+    if (FAILED(hr) && SUCCEEDED(IThumbnailProvider_QueryInterface(provider, &IID_IInitializeWithFile, (void **)&init_file)))
+    {
+        hr = IInitializeWithFile_Initialize(init_file, path, STGM_READ);
+        IInitializeWithFile_Release(init_file);
+    }
+    if (SUCCEEDED(hr)) hr = IThumbnailProvider_GetThumbnail(provider, size, bitmap, &alpha);
+    IThumbnailProvider_Release(provider);
+    return hr;
+}
+
+/* an older IExtractImage handler's picture */
+static HRESULT extract_image_thumbnail(const CLSID *clsid, const WCHAR *path, UINT size, HBITMAP *bitmap)
+{
+    IExtractImage *extract;
+    IPersistFile *file;
+    WCHAR location[MAX_PATH];
+    DWORD priority = 0, flags = IEIFLAG_ORIGSIZE;
+    SIZE sz = { size, size };
+    HRESULT hr;
+
+    hr = CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IExtractImage, (void **)&extract);
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = IExtractImage_QueryInterface(extract, &IID_IPersistFile, (void **)&file)))
+    {
+        hr = IPersistFile_Load(file, path, STGM_READ);
+        IPersistFile_Release(file);
+    }
+    if (SUCCEEDED(hr))
+    {
+        hr = IExtractImage_GetLocation(extract, location, MAX_PATH, &priority, &sz, 32, &flags);
+        if (SUCCEEDED(hr) || hr == E_PENDING) hr = IExtractImage_Extract(extract, bitmap);
+    }
+    IExtractImage_Release(extract);
+    return hr;
+}
+
+/* Stained Glass: a file's thumbnail, from its type's handler; fails when the
+ * type has none (the caller shows its icon) */
+HRESULT SHELL_GetThumbnail(const ITEMIDLIST *pidl, UINT size, HBITMAP *bitmap)
+{
+    WCHAR path[MAX_PATH];
+    const WCHAR *ext;
+    CLSID clsid;
+    HRESULT hr = E_FAIL;
+
+    *bitmap = NULL;
+    if (!pidl || !SHGetPathFromIDListW(pidl, path) || !path[0]) return E_FAIL;
+    if (GetFileAttributesW(path) & FILE_ATTRIBUTE_DIRECTORY) return E_FAIL;
+    ext = PathFindExtensionW(path);
+    if (!ext[0]) return E_FAIL;
+    if (find_handler(ext, thumbnail_provider_key, &clsid))
+        hr = provider_thumbnail(&clsid, pidl, path, size, bitmap);
+    if (FAILED(hr) && find_handler(ext, extract_image_key, &clsid))
+        hr = extract_image_thumbnail(&clsid, path, size, bitmap);
+    if (FAILED(hr) && *bitmap)
+    {
+        DeleteObject(*bitmap);
+        *bitmap = NULL;
+    }
+    TRACE("%s: %#lx\n", debugstr_w(path), hr);
+    return hr;
+}
+
+/* the item's icon, size x size with its alpha, from the best of the system image lists */
+static HRESULT icon_image(const ITEMIDLIST *pidl, UINT size, HBITMAP *bitmap)
+{
+    SHFILEINFOW info;
+    IImageList *list;
+    HIMAGELIST himl;
+    IMAGEINFO ii;
+    HICON icon = NULL;
+    BITMAP bm;
+    void *bits;
+    int which = size > 48 ? SHIL_JUMBO : size > 32 ? SHIL_EXTRALARGE : size > 16 ? SHIL_LARGE : SHIL_SMALL;
+
+    *bitmap = NULL;
+    if (!SHGetFileInfoW((const WCHAR *)pidl, 0, &info, sizeof(info), SHGFI_PIDL | SHGFI_SYSICONINDEX)) return E_FAIL;
+    if (FAILED(SHGetImageList(which, &IID_IImageList, (void **)&list))) return E_FAIL;
+    IImageList_GetIcon(list, info.iIcon, ILD_TRANSPARENT, &icon);
+    IImageList_Release(list);
+    if (!icon) return E_FAIL;
+    /* an image list of that size scales the icon and keeps its alpha */
+    himl = ImageList_Create(size, size, ILC_COLOR32, 1, 1);
+    if (ImageList_AddIcon(himl, icon) == 0 && ImageList_GetImageInfo(himl, 0, &ii) &&
+        GetObjectW(ii.hbmImage, sizeof(bm), &bm) && bm.bmBitsPixel == 32 && (*bitmap = create_dib(size, size, &bits)))
+    {
+        HDC src = CreateCompatibleDC(0), dst = CreateCompatibleDC(0);
+        HGDIOBJ old_src = SelectObject(src, ii.hbmImage), old_dst = SelectObject(dst, *bitmap);
+        BitBlt(dst, 0, 0, size, size, src, ii.rcImage.left, ii.rcImage.top, SRCCOPY);
+        SelectObject(src, old_src);
+        SelectObject(dst, old_dst);
+        DeleteDC(src);
+        DeleteDC(dst);
+    }
+    ImageList_Destroy(himl);
+    DestroyIcon(icon);
+    return *bitmap ? S_OK : E_FAIL;
+}
+
+/* IShellItemImageFactory::GetImage: the thumbnail when there is one, else the icon */
+HRESULT SHELL_GetItemImage(const ITEMIDLIST *pidl, SIZE size, SIIGBF flags, HBITMAP *bitmap)
+{
+    UINT side = max(size.cx, size.cy);
+    HRESULT hr = E_FAIL;
+
+    if (!bitmap) return E_POINTER;
+    *bitmap = NULL;
+    if (!side) return E_INVALIDARG;
+    if (!(flags & SIIGBF_ICONONLY)) hr = SHELL_GetThumbnail(pidl, side, bitmap);
+    if (SUCCEEDED(hr) || (flags & SIIGBF_THUMBNAILONLY)) return hr;
+    return icon_image(pidl, side, bitmap);
+}
