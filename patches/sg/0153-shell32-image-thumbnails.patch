+/* the EXIF orientation of a photo, 1 (as stored) when it has none */
+static UINT frame_orientation(IWICBitmapFrameDecode *frame)
+{
+    IWICMetadataQueryReader *reader;
+    PROPVARIANT value;
+    UINT orientation = 1;
+
+    if (FAILED(IWICBitmapFrameDecode_GetMetadataQueryReader(frame, &reader))) return 1;
+    PropVariantInit(&value);
+    if (SUCCEEDED(IWICMetadataQueryReader_GetMetadataByName(reader, L"/app1/ifd/{ushort=274}", &value)) &&
+        value.vt == VT_UI2 && value.uiVal >= 1 && value.uiVal <= 8)
+        orientation = value.uiVal;
+    PropVariantClear(&value);
+    IWICMetadataQueryReader_Release(reader);
+    return orientation;
+}
+
+/* a JPEG's EXIF orientation read from its APP1 segment (Wine's JPEG decoder
+ * exposes no EXIF metadata): 1-8, or 0 when it has none */
+static UINT jpeg_orientation(const BYTE *data, SIZE_T size)
+{
+    SIZE_T pos = 2;
+
+    if (size < 4 || data[0] != 0xff || data[1] != 0xd8) return 0;
+    while (pos + 4 <= size && data[pos] == 0xff)
+    {
+        BYTE marker = data[pos + 1];
+        SIZE_T len = (data[pos + 2] << 8) | data[pos + 3];
+
+        if (marker == 0xda || marker == 0xd9 || len < 2) break;
+        if (marker == 0xe1 && pos + 2 + len <= size && len >= 16 && !memcmp(data + pos + 4, "Exif\0\0", 6))
+        {
+            const BYTE *tiff = data + pos + 10;
+            SIZE_T tsize = len - 8, ifd, i, count;
+            BOOL le = tiff[0] == 'I';
+
+#define U16(p) (le ? (p)[0] | ((p)[1] << 8) : ((p)[0] << 8) | (p)[1])
+#define U32(p) (le ? (p)[0] | ((p)[1] << 8) | ((p)[2] << 16) | ((ULONG)(p)[3] << 24) : \
+                ((ULONG)(p)[0] << 24) | ((p)[1] << 16) | ((p)[2] << 8) | (p)[3])
+            if ((tiff[0] != 'I' && tiff[0] != 'M') || U16(tiff + 2) != 42) return 0;
+            ifd = U32(tiff + 4);
+            if (ifd + 2 > tsize) return 0;
+            count = U16(tiff + ifd);
+            for (i = 0; i < count && ifd + 2 + (i + 1) * 12 <= tsize; i++)
+            {
+                const BYTE *entry = tiff + ifd + 2 + i * 12;
+                if (U16(entry) == 0x0112)
+                {
+                    UINT value = U16(entry + 8);
+                    return value >= 1 && value <= 8 ? value : 0;
+                }
+            }
+#undef U16
+#undef U32
+            return 0;
+        }
+        pos += 2 + len;
+    }
+    return 0;
+}
+
+/* the orientation from the file's own bytes, for a JPEG */
+static UINT source_orientation(IStream *stream, const WCHAR *path)
+{
+    BYTE *data = malloc(65536);
+    ULONG got = 0;
+    UINT orientation = 0;
+
+    if (!data) return 0;
+    if (stream)
+    {
+        LARGE_INTEGER zero = {{ 0 }};
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+        IStream_Read(stream, data, 65536, &got);
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    }
+    else
+    {
+        HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            ReadFile(file, data, 65536, &got, NULL);
+            CloseHandle(file);
+        }
+    }
+    orientation = jpeg_orientation(data, got);
+    free(data);
+    return orientation;
+}
+
+/* shrinks premultiplied BGRA pixels by averaging each target pixel's area */
+static void box_scale(const BYTE *src, UINT sw, UINT sh, BYTE *dst, UINT dw, UINT dh)
+{
+    UINT x, y, sx, sy, x0, x1, y0, y1, c;
+
+    for (y = 0; y < dh; y++)
+    {
+        y0 = (ULONGLONG)y * sh / dh;
+        y1 = max(y0 + 1, (ULONGLONG)(y + 1) * sh / dh);
+        for (x = 0; x < dw; x++)
+        {
+            UINT sum[4] = { 0 }, n = 0;
+            x0 = (ULONGLONG)x * sw / dw;
+            x1 = max(x0 + 1, (ULONGLONG)(x + 1) * sw / dw);
+            for (sy = y0; sy < y1; sy++)
+                for (sx = x0; sx < x1; sx++)
+                {
+                    const BYTE *p = src + ((SIZE_T)sy * sw + sx) * 4;
+                    for (c = 0; c < 4; c++) sum[c] += p[c];
+                    n++;
+                }
+            for (c = 0; c < 4; c++) dst[((SIZE_T)y * dw + x) * 4 + c] = sum[c] / n;
+        }
+    }
+}
+
+/* turns w x h pixels as a photo's orientation says (EXIF 1-8) into out, which is h x w for 5-8 */
+static void orient_pixels(const DWORD *src, UINT w, UINT h, UINT orientation, DWORD *out)
+{
+    UINT x, y, ow = orientation >= 5 ? h : w, ox, oy;
+
+    for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+        {
+            switch (orientation)
+            {
+            case 2: ox = w - 1 - x; oy = y; break;
+            case 3: ox = w - 1 - x; oy = h - 1 - y; break;
+            case 4: ox = x; oy = h - 1 - y; break;
+            case 5: ox = y; oy = x; break;
+            case 6: ox = h - 1 - y; oy = x; break;
+            case 7: ox = h - 1 - y; oy = w - 1 - x; break;
+            case 8: ox = y; oy = w - 1 - x; break;
+            default: ox = x; oy = y; break;
+            }
+            out[(SIZE_T)oy * ow + ox] = src[(SIZE_T)y * w + x];
+        }
+}
+
+static HBITMAP create_dib(UINT w, UINT h, void **bits)
+{
+    BITMAPINFO bmi = {{ sizeof(BITMAPINFOHEADER) }};
+
+    bmi.bmiHeader.biWidth = w;
+    bmi.bmiHeader.biHeight = -(LONG)h;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    return CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, bits, NULL, 0);
+}
+
+/* a picture no larger than size on its longer side (never enlarged), from WIC */
+static HRESULT decode_thumbnail(IStream *stream, const WCHAR *path, UINT size, HBITMAP *out)
+{
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapSource *source = NULL;
+    IWICBitmapScaler *scaler = NULL;
+    IWICFormatConverter *converter = NULL;
+    UINT w, h, tw, th, sw, sh, orientation;
+    BYTE *pixels = NULL, *scaled = NULL;
+    DWORD *oriented = NULL;
+    void *bits;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!size) return E_INVALIDARG;
+    orientation = source_orientation(stream, path);
+    hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IWICImagingFactory, (void **)&factory);
+    if (FAILED(hr)) return hr;
+    if (stream)
+        hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand, &decoder);
+    else
+        hr = IWICImagingFactory_CreateDecoderFromFilename(factory, path, NULL, GENERIC_READ, WICDecodeMetadataCacheOnDemand, &decoder);
+    if (SUCCEEDED(hr)) hr = IWICBitmapDecoder_GetFrame(decoder, 0, &frame);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameDecode_GetSize(frame, &w, &h);
+    if (SUCCEEDED(hr) && (!w || !h)) hr = E_FAIL;
+    if (FAILED(hr)) goto done;
+
+    if (!orientation) orientation = frame_orientation(frame);
+    if (w >= h) { tw = min(w, size); th = max(1, (UINT)((ULONGLONG)h * tw / w)); }
+    else { th = min(h, size); tw = max(1, (UINT)((ULONGLONG)w * th / h)); }
+
+    /* a very large picture is first brought down to a few times the size */
+    source = (IWICBitmapSource *)frame;
+    IWICBitmapSource_AddRef(source);
+    sw = w;
+    sh = h;
+    if ((ULONGLONG)w * h > 4096 * 4096 / 2 && (w > tw * 4 || h > th * 4))
+    {
+        sw = min(w, tw * 4);
+        sh = min(h, th * 4);
+        if (SUCCEEDED(IWICImagingFactory_CreateBitmapScaler(factory, &scaler)) &&
+            SUCCEEDED(IWICBitmapScaler_Initialize(scaler, source, sw, sh, WICBitmapInterpolationModeFant)))
+        {
+            IWICBitmapSource_Release(source);
+            source = (IWICBitmapSource *)scaler;
+            IWICBitmapSource_AddRef(source);
+        }
+        else { sw = w; sh = h; }
+    }
+    hr = IWICImagingFactory_CreateFormatConverter(factory, &converter);
+    if (SUCCEEDED(hr))
+        hr = IWICFormatConverter_Initialize(converter, source, &GUID_WICPixelFormat32bppPBGRA,
+                                            WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeCustom);
+    if (SUCCEEDED(hr) && !(pixels = malloc((SIZE_T)sw * sh * 4))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr)) hr = IWICFormatConverter_CopyPixels(converter, NULL, sw * 4, sw * sh * 4, pixels);
+    if (FAILED(hr)) goto done;
+
+    if (!(scaled = malloc((SIZE_T)tw * th * 4)) || !(oriented = malloc((SIZE_T)tw * th * 4)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    box_scale(pixels, sw, sh, scaled, tw, th);
+    orient_pixels((DWORD *)scaled, tw, th, orientation, oriented);
+    if (orientation >= 5) { UINT t = tw; tw = th; th = t; }
+    if (!(*out = create_dib(tw, th, &bits)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    memcpy(bits, oriented, (SIZE_T)tw * th * 4);
+    hr = S_OK;
+
+done:
+    free(pixels);
+    free(scaled);
+    free(oriented);
+    if (converter) IWICFormatConverter_Release(converter);
+    if (source) IWICBitmapSource_Release(source);
+    if (scaler) IWICBitmapScaler_Release(scaler);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    IWICImagingFactory_Release(factory);
+    return hr;
+}
+
+static HRESULT WINAPI thumbnail_GetThumbnail(IThumbnailProvider *iface, UINT cx, HBITMAP *bitmap, WTS_ALPHATYPE *alpha)
+{
+    struct image_thumbnail *thumb = impl_from_IThumbnailProvider(iface);
+    HRESULT hr;
+
+    TRACE("%p, %u, %p, %p\n", iface, cx, bitmap, alpha);
+
+    if (!bitmap) return E_POINTER;
+    if (!thumb->stream && !thumb->path) return E_UNEXPECTED;
+    if (thumb->stream)
+    {
+        LARGE_INTEGER zero = {{ 0 }};
+        IStream_Seek(thumb->stream, zero, STREAM_SEEK_SET, NULL);
+    }
+    hr = decode_thumbnail(thumb->stream, thumb->path, cx, bitmap);
+    if (SUCCEEDED(hr) && alpha) *alpha = WTSAT_ARGB;
+    return hr;
+}
