Date: Sat, 28 Nov 2026 01:43:51 -0800
Subject: [PATCH] winspool: a printer's properties open on the General page: name, model, features, paper, Preferences..., Print Test Page (9816)

A printer's properties on Windows open on the General page: the printer's
name, location and comment, its model, what it can do (Color,
Double-sided, Staple, Speed, Maximum resolution, Paper available) and the
Preferences... and Print Test Page buttons; the driver's own pages (Device
Settings) follow. PrinterProperties showed only the driver's pages, so
Settings' "Printer properties", the queue window's Printer > Properties and
programs' Properties buttons opened a lone Device Settings page (for most
PPDs an empty tree).

winspool adds the General page ahead of the driver's (CPSFUNC_ADD_PROPSHEETPAGEW):
the features from DeviceCapabilities (DC_COLORDEVICE, DC_DUPLEX, DC_STAPLE,
DC_PRINTRATEPPM, DC_ENUMRESOLUTIONS, DC_PAPERNAMES); Preferences... is the
person's printing defaults (DocumentProperties, SetPrinter level 9);
Print Test Page prints shell32's test page and says it was sent. Name,
location and comment come from CUPS and are shown, not edited.

Gate test/printprops-gate.sh.

--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -2375,6 +2375,139 @@
     return CPSUI_OK;
 }
 
+/* Stained Glass OS (9816): a printer's properties open on Windows' General
+ * page -- its name, location, comment and model, what it can do (colour,
+ * double-sided, staple, speed, maximum resolution, the paper it takes) and
+ * the Preferences... and Print Test Page buttons -- before the driver's own
+ * pages (Device Settings). It had only the driver's pages. The name,
+ * location and comment come from CUPS and are shown as they are. */
+static void general_yes_no(HWND dlg, int id, DWORD caps)
+{
+    WCHAR text[32];
+
+    LoadStringW(WINSPOOL_hInstance, (int)caps > 0 ? IDS_PG_YES : (int)caps == 0 ? IDS_PG_NO : IDS_PG_UNKNOWN,
+                text, ARRAY_SIZE(text));
+    SetDlgItemTextW(dlg, id, text);
+}
+
+static void general_page_init(HWND dlg, const WCHAR *name)
+{
+    PRINTER_INFO_2W *pi2 = NULL;
+    HANDLE printer;
+    DWORD needed = 0, n, i, max_res = 0;
+    WCHAR *papers, text[64];
+    LONG *res;
+    HICON icon;
+
+    SetDlgItemTextW(dlg, IDC_PG_NAME, name);
+    if ((icon = LoadImageW(GetModuleHandleW(L"shell32.dll"), MAKEINTRESOURCEW(17), IMAGE_ICON, 32, 32, LR_SHARED)) ||
+        (icon = LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION)))
+        SendDlgItemMessageW(dlg, IDC_PG_ICON, STM_SETICON, (WPARAM)icon, 0);
+    if (OpenPrinterW((WCHAR *)name, &printer, NULL))
+    {
+        GetPrinterW(printer, 2, NULL, 0, &needed);
+        if (needed && (pi2 = malloc(needed)) && GetPrinterW(printer, 2, (BYTE *)pi2, needed, &needed))
+        {
+            if (pi2->pLocation) SetDlgItemTextW(dlg, IDC_PG_LOCATION, pi2->pLocation);
+            if (pi2->pComment) SetDlgItemTextW(dlg, IDC_PG_COMMENT, pi2->pComment);
+            if (pi2->pDriverName) SetDlgItemTextW(dlg, IDC_PG_MODEL, pi2->pDriverName);
+        }
+        free(pi2);
+        ClosePrinter(printer);
+    }
+    general_yes_no(dlg, IDC_PG_COLOR, DeviceCapabilitiesW(name, NULL, DC_COLORDEVICE, NULL, NULL));
+    general_yes_no(dlg, IDC_PG_DUPLEX, DeviceCapabilitiesW(name, NULL, DC_DUPLEX, NULL, NULL));
+    general_yes_no(dlg, IDC_PG_STAPLE, DeviceCapabilitiesW(name, NULL, DC_STAPLE, NULL, NULL));
+    n = DeviceCapabilitiesW(name, NULL, DC_PRINTRATEPPM, NULL, NULL);
+    if ((int)n > 0) swprintf(text, ARRAY_SIZE(text), L"%lu ppm", n);
+    else LoadStringW(WINSPOOL_hInstance, IDS_PG_UNKNOWN, text, ARRAY_SIZE(text));
+    SetDlgItemTextW(dlg, IDC_PG_SPEED, text);
+    n = DeviceCapabilitiesW(name, NULL, DC_ENUMRESOLUTIONS, NULL, NULL);
+    if ((int)n > 0 && (res = malloc(n * 2 * sizeof(LONG))))
+    {
+        if (DeviceCapabilitiesW(name, NULL, DC_ENUMRESOLUTIONS, (WCHAR *)res, NULL) == n)
+            for (i = 0; i < n; i++) max_res = max(max_res, (DWORD)max(res[2 * i], res[2 * i + 1]));
+        free(res);
+    }
+    if (max_res) swprintf(text, ARRAY_SIZE(text), L"%lu dpi", max_res);
+    else LoadStringW(WINSPOOL_hInstance, IDS_PG_UNKNOWN, text, ARRAY_SIZE(text));
+    SetDlgItemTextW(dlg, IDC_PG_RES, text);
+    n = DeviceCapabilitiesW(name, NULL, DC_PAPERNAMES, NULL, NULL);
+    if ((int)n > 0 && (papers = calloc(n, 64 * sizeof(WCHAR))))
+    {
+        if (DeviceCapabilitiesW(name, NULL, DC_PAPERNAMES, papers, NULL) == n)
+            for (i = 0; i < n; i++)
+            {
+                lstrcpynW(text, papers + i * 64, 64);
+                if (text[0]) SendDlgItemMessageW(dlg, IDC_PG_PAPERS, LB_ADDSTRING, 0, (LPARAM)text);
+            }
+        free(papers);
+    }
+}
+
+/* Preferences...: the person's printing defaults (SetPrinter level 9), as
+ * Printing Preferences keeps them */
+static void general_page_preferences(HWND dlg, const WCHAR *name)
+{
+    PRINTER_INFO_9W pi9;
+    HANDLE printer;
+    DEVMODEW *dm;
+    LONG size;
+
+    if (!OpenPrinterW((WCHAR *)name, &printer, NULL)) return;
+    size = DocumentPropertiesW(dlg, printer, (WCHAR *)name, NULL, NULL, 0);
+    if (size > 0 && (dm = malloc(size)))
+    {
+        if (DocumentPropertiesW(dlg, printer, (WCHAR *)name, dm, NULL, DM_OUT_BUFFER) == IDOK &&
+            DocumentPropertiesW(dlg, printer, (WCHAR *)name, dm, dm, DM_IN_BUFFER | DM_IN_PROMPT | DM_OUT_BUFFER) == IDOK)
+        {
+            pi9.pDevMode = dm;
+            SetPrinterW(printer, 9, (BYTE *)&pi9, 0);
+        }
+        free(dm);
+    }
+    ClosePrinter(printer);
+}
+
+static void general_page_test(HWND dlg, const WCHAR *name)
+{
+    BOOL (WINAPI *pSHInvokePrinterCommandW)(HWND, UINT, const WCHAR *, const WCHAR *, BOOL);
+    HMODULE shell = LoadLibraryW(L"shell32.dll");
+    WCHAR title[MAX_PATH + 32], text[128];
+    BOOL ok = FALSE;
+
+    pSHInvokePrinterCommandW = shell ? (void *)GetProcAddress(shell, "SHInvokePrinterCommandW") : NULL;
+#ifndef SG_MUTANT_PG_NO_TESTPAGE
+    if (pSHInvokePrinterCommandW) ok = pSHInvokePrinterCommandW(dlg, 4 /* PRINTACTION_TESTPAGE */, name, NULL, TRUE);
+#endif
+    if (shell) FreeLibrary(shell);
+    LoadStringW(WINSPOOL_hInstance, ok ? IDS_PG_TESTSENT : IDS_PG_TESTFAIL, text, ARRAY_SIZE(text));
+    swprintf(title, ARRAY_SIZE(title), L"%s", name);
+    MessageBoxW(dlg, text, title, MB_OK | (ok ? MB_ICONINFORMATION : MB_ICONERROR));
+}
+
+static INT_PTR CALLBACK general_page_proc(HWND dlg, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        const device_property_t *dp = (const device_property_t *)((PROPSHEETPAGEW *)lparam)->lParam;
+        SetWindowLongPtrW(dlg, DWLP_USER, (LONG_PTR)dp->dph.pszPrinterName);
+        general_page_init(dlg, dp->dph.pszPrinterName);
+        return TRUE;
+    }
+    case WM_COMMAND:
+    {
+        const WCHAR *name = (const WCHAR *)GetWindowLongPtrW(dlg, DWLP_USER);
+        if (LOWORD(wparam) == IDC_PG_PREFS && HIWORD(wparam) == BN_CLICKED) general_page_preferences(dlg, name);
+        else if (LOWORD(wparam) == IDC_PG_TEST && HIWORD(wparam) == BN_CLICKED) general_page_test(dlg, name);
+        break;
+    }
+    }
+    return FALSE;
+}
+
 static LONG WINAPI device_callback(PROPSHEETUI_INFO *info, LPARAM lparam)
 {
     device_property_t *dp = (device_property_t *)info->lParamInit;
@@ -2382,6 +2515,19 @@
     switch (info->Reason)
     {
     case PROPSHEETUI_REASON_INIT:
+#ifndef SG_MUTANT_PG_NO_GENERAL
+    {
+        PROPSHEETPAGEW page;
+
+        memset(&page, 0, sizeof(page));
+        page.dwSize = sizeof(page);
+        page.hInstance = WINSPOOL_hInstance;
+        page.pszTemplate = MAKEINTRESOURCEW(PRINTER_GENERAL_PAGE);
+        page.pfnDlgProc = general_page_proc;
+        page.lParam = (LPARAM)dp;
+        info->pfnComPropSheet(info->hComPropSheet, CPSFUNC_ADD_PROPSHEETPAGEW, (LPARAM)&page, 0);
+    }
+#endif
         if (!info->pfnComPropSheet(info->hComPropSheet, CPSFUNC_ADD_PFNPROPSHEETUIW,
                     (LPARAM)dp->config->pDrvDevicePropertySheets, (LPARAM)&dp->dph))
             return ERR_CPSUI_GETLASTERROR;
--- a/dlls/winspool.drv/winspool.rc
+++ b/dlls/winspool.drv/winspool.rc
@@ -29,8 +29,43 @@
     IDS_CAPTION "Local Port"
     IDS_FILE_EXISTS "The output file already exists. Click OK to overwrite."
     IDS_CANNOT_OPEN "Unable to create the output file."
+    IDS_PG_YES "Yes"
+    IDS_PG_NO "No"
+    IDS_PG_UNKNOWN "Unknown"
+    IDS_PG_TESTSENT "A test page has been sent to your printer."
+    IDS_PG_TESTFAIL "The test page could not be printed."
 }
 
+PRINTER_GENERAL_PAGE DIALOG 0, 0, 252, 218
