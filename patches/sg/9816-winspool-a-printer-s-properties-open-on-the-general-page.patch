+    EDITTEXT IDC_PG_NAME, 46, 12, 196, 12, ES_AUTOHSCROLL | ES_READONLY
+    LTEXT "&Location:", -1, 10, 38, 34, 8
+    EDITTEXT IDC_PG_LOCATION, 46, 36, 196, 12, ES_AUTOHSCROLL | ES_READONLY
+    LTEXT "&Comment:", -1, 10, 56, 34, 8
+    EDITTEXT IDC_PG_COMMENT, 46, 54, 196, 24, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
+    LTEXT "M&odel:", -1, 10, 88, 34, 8
+    EDITTEXT IDC_PG_MODEL, 46, 88, 196, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
+    GROUPBOX "Features", -1, 10, 104, 232, 84
+    LTEXT "Color:", -1, 18, 118, 60, 8
+    LTEXT "", IDC_PG_COLOR, 80, 118, 40, 8
+    LTEXT "Double-sided:", -1, 18, 130, 60, 8
+    LTEXT "", IDC_PG_DUPLEX, 80, 130, 40, 8
+    LTEXT "Staple:", -1, 18, 142, 60, 8
+    LTEXT "", IDC_PG_STAPLE, 80, 142, 40, 8
+    LTEXT "Speed:", -1, 18, 154, 60, 8
+    LTEXT "", IDC_PG_SPEED, 80, 154, 44, 8
+    LTEXT "Maximum resolution:", -1, 18, 166, 78, 8
+    LTEXT "", IDC_PG_RES, 96, 166, 32, 8
+    LTEXT "Paper available:", -1, 130, 118, 104, 8
+    LISTBOX IDC_PG_PAPERS, 130, 130, 104, 52, LBS_NOSEL | WS_VSCROLL | WS_BORDER
