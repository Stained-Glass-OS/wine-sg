From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxgi: GetDC errors, CoreWindow swap chains, shared resource LUID, mode flags (3719)

dxgi: surface GetDC/ReleaseDC errors, CoreWindow swap chains, shared resource LUID, mode list flags

DXGI_ERROR_INVALID_CALL instead of the wined3d code (two d3d11 todo_wine
marks removed), CreateSwapChainForCoreWindow through ICoreWindowInterop,
GetSharedResourceAdapterLuid through a private d3d11 export, and the
interlaced filter of GetDisplayModeList. Details in notes/3719.txt.
---
diff --git a/dlls/d3d11/d3d11.spec b/dlls/d3d11/d3d11.spec
index bb755e2..7744291 100644
--- a/dlls/d3d11/d3d11.spec
+++ b/dlls/d3d11/d3d11.spec
@@ -4,6 +4,7 @@
 @ stdcall D3D11CoreRegisterLayers()
 @ stdcall D3D11CreateDevice(ptr long ptr long ptr long long ptr ptr ptr)
 @ stdcall D3D11CreateDeviceAndSwapChain(ptr long ptr long ptr long long ptr ptr ptr ptr ptr)
+@ cdecl -private wine_d3d11_get_shared_resource_adapter_luid(ptr ptr)
 @ stdcall D3D11On12CreateDevice(ptr long ptr long ptr long long ptr ptr ptr)
 @ stdcall D3DKMTCheckVidPnExclusiveOwnership(ptr) gdi32.D3DKMTCheckVidPnExclusiveOwnership
 @ stdcall D3DKMTCloseAdapter(ptr) gdi32.D3DKMTCloseAdapter
diff --git a/dlls/d3d11/d3d11_private.h b/dlls/d3d11/d3d11_private.h
index 28cc59a..a8d3688 100644
--- a/dlls/d3d11/d3d11_private.h
+++ b/dlls/d3d11/d3d11_private.h
@@ -142,6 +142,7 @@ struct d3d_shared_resource
     LONG refcount;
     struct list entry;
     HANDLE handle;                  /* legacy shared handle, NULL for NT handle sharing */
+    LUID adapter_luid;              /* the adapter of the device that made it */
     D3D11_TEXTURE2D_DESC desc;
     SRWLOCK lock;
     CONDITION_VARIABLE released;
diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index 4915e6e..2819fe0 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -17625,7 +17625,7 @@ static void test_getdc(void)
     ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
 
     hr = IDXGISurface1_GetDC(surface, FALSE, &dc);
-    todo_wine ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
 
     IDXGISurface1_Release(surface);
     ID3D11Texture2D_Release(texture);
@@ -17638,7 +17638,7 @@ static void test_getdc(void)
     ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
 
     hr = IDXGISurface1_ReleaseDC(surface, NULL);
-    todo_wine ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
 
     hr = IDXGISurface1_GetDC(surface, FALSE, &dc);
     ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
diff --git a/dlls/d3d11/texture.c b/dlls/d3d11/texture.c
index 7e4ebce..bf8c1fa 100644
--- a/dlls/d3d11/texture.c
+++ b/dlls/d3d11/texture.c
@@ -626,6 +626,22 @@ static struct d3d_shared_resource *shared_resource_create(struct d3d_texture2d *
     shared->refcount = 1;
     shared->desc = texture->desc;
     shared->source = texture;
+    {
+        IDXGIDevice *dxgi_device;
+        IDXGIAdapter *adapter;
+        DXGI_ADAPTER_DESC adapter_desc;
+
+        if (SUCCEEDED(ID3D11Device2_QueryInterface(texture->device, &IID_IDXGIDevice, (void **)&dxgi_device)))
+        {
+            if (SUCCEEDED(IDXGIDevice_GetAdapter(dxgi_device, &adapter)))
+            {
+                if (SUCCEEDED(IDXGIAdapter_GetDesc(adapter, &adapter_desc)))
+                    shared->adapter_luid = adapter_desc.AdapterLuid;
+                IDXGIAdapter_Release(adapter);
+            }
+            IDXGIDevice_Release(dxgi_device);
+        }
+    }
     InitializeSRWLock(&shared->lock);
     InitializeConditionVariable(&shared->released);
     /* A legacy handle is a number any process could use; this is a number nothing else is. */
@@ -1594,6 +1610,26 @@ HRESULT d3d_texture2d_create(struct d3d_device *device, const D3D11_TEXTURE2D_DE
 }
 
 /* The texture another device of the process made, opened with its shared handle. */
+/* Private export for dxgi's IDXGIFactory2::GetSharedResourceAdapterLuid */
+HRESULT CDECL wine_d3d11_get_shared_resource_adapter_luid(HANDLE handle, LUID *luid)
+{
+    struct d3d_shared_resource *entry;
+    HRESULT hr = DXGI_ERROR_INVALID_CALL;
+
+    AcquireSRWLockShared(&shared_resources_lock);
+    LIST_FOR_EACH_ENTRY(entry, &shared_resources, struct d3d_shared_resource, entry)
+    {
+        if (entry->handle && entry->handle == handle)
+        {
+            *luid = entry->adapter_luid;
+            hr = S_OK;
+            break;
+        }
+    }
+    ReleaseSRWLockShared(&shared_resources_lock);
+    return hr;
+}
+
 HRESULT d3d_texture2d_open_shared(struct d3d_device *device, HANDLE handle, struct d3d_texture2d **out)
 {
     struct d3d_shared_resource *shared = NULL, *entry;
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index 2b21444..441d1f1 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -327,18 +327,75 @@ static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForCoreWindow(IWine
         IUnknown *device, IUnknown *window, const DXGI_SWAP_CHAIN_DESC1 *desc,
         IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, window %p, desc %p, output %p, swapchain %p stub!\n",
+    /* ICoreWindowInterop of the windows.ui.core CoreWindow */
+    static const GUID IID_ICoreWindowInterop =
+            {0x45d64a29, 0xa63e, 0x4cb6, {0xb4, 0x98, 0x57, 0x81, 0xd2, 0x98, 0xcb, 0x4f}};
+    struct core_window_interop
+    {
+        struct
+        {
+            HRESULT (STDMETHODCALLTYPE *QueryInterface)(void *, REFIID, void **);
+            ULONG (STDMETHODCALLTYPE *AddRef)(void *);
+            ULONG (STDMETHODCALLTYPE *Release)(void *);
+            HRESULT (STDMETHODCALLTYPE *get_WindowHandle)(void *, HWND *);
+            HRESULT (STDMETHODCALLTYPE *put_MessageHandled)(void *, unsigned char);
+        } *vtbl;
+    } *interop;
+    HWND hwnd = NULL;
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, window %p, desc %p, output %p, swapchain %p.\n",
             iface, device, window, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!device || !window || !desc || !swapchain)
+    {
+        WARN("Invalid pointer.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    /* A CoreWindow is shown in an ordinary window of the process; its interop
+     * interface says which one. The swap chain is the same as for that window. */
+    if (FAILED(IUnknown_QueryInterface(window, &IID_ICoreWindowInterop, (void **)&interop)))
+    {
+        WARN("The window object has no ICoreWindowInterop.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+    hr = interop->vtbl->get_WindowHandle(interop, &hwnd);
+#ifndef SG_MUTANT_DXGI_LEAK
+    interop->vtbl->Release(interop);
+#endif
+    if (FAILED(hr))
+    {
+        WARN("The CoreWindow has no window handle, hr %#lx.\n", hr);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    return dxgi_factory_CreateSwapChainForHwnd(iface, device, hwnd, desc, NULL, output, swapchain);
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_factory_GetSharedResourceAdapterLuid(IWineDXGIFactory *iface,
         HANDLE resource, LUID *luid)
 {
-    FIXME("iface %p, resource %p, luid %p stub!\n", iface, resource, luid);
+    HRESULT (CDECL *get_luid)(HANDLE, LUID *);
+    HMODULE d3d11;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, resource %p, luid %p.\n", iface, resource, luid);
+
+    if (!luid)
+        return DXGI_ERROR_INVALID_CALL;
+    memset(luid, 0, sizeof(*luid));
+
+    /* The shared resources of this implementation are kept by d3d11.dll, which
+     * is loaded in any process that has made one. */
+    if (!resource || !(d3d11 = GetModuleHandleW(L"d3d11.dll"))
+            || !(get_luid = (void *)GetProcAddress(d3d11, "wine_d3d11_get_shared_resource_adapter_luid")))
+        return DXGI_ERROR_INVALID_CALL;
+#ifdef SG_MUTANT_DXGI_LUID
+    get_luid(resource, luid);
+    memset(luid, 0, sizeof(*luid));
+    return S_OK;
+#endif
+    return get_luid(resource, luid);
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_factory_RegisterOcclusionStatusWindow(IWineDXGIFactory *iface,
diff --git a/dlls/dxgi/output.c b/dlls/dxgi/output.c
index feef2f0..e8c6b35 100644
--- a/dlls/dxgi/output.c
+++ b/dlls/dxgi/output.c
@@ -113,9 +113,10 @@ enum dxgi_mode_struct_version
 };
 
 static HRESULT dxgi_output_get_display_mode_list(struct dxgi_output *output,
-        DXGI_FORMAT format, unsigned int *mode_count, void *modes,
+        DXGI_FORMAT format, unsigned int flags, unsigned int *mode_count, void *modes,
         enum dxgi_mode_struct_version struct_version)
 {
+    enum wined3d_scanline_ordering ordering = WINED3D_SCANLINE_ORDERING_UNKNOWN;
     enum wined3d_format_id wined3d_format;
     struct wined3d_display_mode mode;
     unsigned int i, max_count;
@@ -132,9 +133,16 @@ static HRESULT dxgi_output_get_display_mode_list(struct dxgi_output *output,
 
     wined3d_format = wined3dformat_from_dxgi_format(format);
 
+    /* Interlaced modes are only listed on request. Modes that only exist
+     * through scaling (DXGI_ENUM_MODES_SCALING) do not exist here: the output
+     * has the modes the display driver reports and nothing is scaled, so that
+     * flag adds nothing; likewise the stereo flags (no stereo modes). */
+    if (!(flags & DXGI_ENUM_MODES_INTERLACED))
+        ordering = WINED3D_SCANLINE_ORDERING_PROGRESSIVE;
+
     wined3d_mutex_lock();
     max_count = wined3d_output_get_mode_count(output->wined3d_output,
-            wined3d_format, WINED3D_SCANLINE_ORDERING_UNKNOWN, false);
+            wined3d_format, ordering, false);
 
     if (!modes)
     {
@@ -154,7 +162,7 @@ static HRESULT dxgi_output_get_display_mode_list(struct dxgi_output *output,
     for (i = 0; i < *mode_count; ++i)
     {
         if (FAILED(hr = wined3d_output_get_mode(output->wined3d_output, wined3d_format,
-                WINED3D_SCANLINE_ORDERING_UNKNOWN, i, &mode, true)))
+                ordering, i, &mode, true)))
         {
             WARN("Failed to get output mode %u, hr %#lx.\n", i, hr);
             wined3d_mutex_unlock();
@@ -341,11 +349,11 @@ static HRESULT STDMETHODCALLTYPE dxgi_output_GetDisplayModeList(IDXGIOutput6 *if
 {
     struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
 
-    FIXME("iface %p, format %s, flags %#x, mode_count %p, modes %p partial stub!\n",
+    TRACE("iface %p, format %s, flags %#x, mode_count %p, modes %p.\n",
             iface, debug_dxgi_format(format), flags, mode_count, modes);
 
     return dxgi_output_get_display_mode_list(output,
-            format, mode_count, modes, DXGI_MODE_STRUCT_VERSION_0);
+            format, flags, mode_count, modes, DXGI_MODE_STRUCT_VERSION_0);
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_FindClosestMatchingMode(IDXGIOutput6 *iface,
@@ -647,11 +655,11 @@ static HRESULT STDMETHODCALLTYPE dxgi_output_GetDisplayModeList1(IDXGIOutput6 *i
 {
     struct dxgi_output *output = impl_from_IDXGIOutput6(iface);
 
-    FIXME("iface %p, format %s, flags %#x, mode_count %p, modes %p partial stub!\n",
+    TRACE("iface %p, format %s, flags %#x, mode_count %p, modes %p.\n",
             iface, debug_dxgi_format(format), flags, mode_count, modes);
 
     return dxgi_output_get_display_mode_list(output,
-            format, mode_count, modes, DXGI_MODE_STRUCT_VERSION_1);
+            format, flags, mode_count, modes, DXGI_MODE_STRUCT_VERSION_1);
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_output_FindClosestMatchingMode1(IDXGIOutput6 *iface,
diff --git a/dlls/dxgi/resource.c b/dlls/dxgi/resource.c
index fb3eb29..12ac956 100644
--- a/dlls/dxgi/resource.c
+++ b/dlls/dxgi/resource.c
@@ -205,17 +205,43 @@ static HRESULT STDMETHODCALLTYPE dxgi_surface_GetDC(IDXGISurface1 *iface, BOOL d
     struct dxgi_resource *resource = impl_from_IDXGISurface1(iface);
     HRESULT hr;
 
-    FIXME("iface %p, discard %d, hdc %p semi-stub!\n", iface, discard, hdc);
+    TRACE("iface %p, discard %d, hdc %p.\n", iface, discard, hdc);
 
+    /* "discard" only says the old contents are not needed afterwards: the DC
+     * shows the surface's memory either way, which is a valid answer. */
     if (!hdc)
         return E_INVALIDARG;
 
     wined3d_mutex_lock();
+#ifdef SG_MUTANT_DXGI_DCTWICE
+    if (0)
+#else
+    if (resource->dc)
+#endif
+    {
+        /* GetDC again before ReleaseDC */
+        wined3d_mutex_unlock();
+        WARN("The surface's DC is already in use.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
     hr = wined3d_texture_get_dc(wined3d_texture_from_resource(resource->wined3d_resource), 0, hdc);
-    wined3d_mutex_unlock();
+#ifdef SG_MUTANT_DXGI_DCTWICE
+    if (hr == WINED3DERR_INVALIDCALL && resource->dc)
+    {
+        *hdc = resource->dc;
+        hr = S_OK;
+    }
+#endif
+#ifdef SG_MUTANT_DXGI_HRMAP
+    if (0)
+#else
+    if (hr == WINED3DERR_INVALIDCALL)
+#endif
+        hr = DXGI_ERROR_INVALID_CALL;   /* not GDI compatible */
 
     if (SUCCEEDED(hr))
-       resource->dc = *hdc;
+        resource->dc = *hdc;
+    wined3d_mutex_unlock();
 
     return hr;
 }
@@ -227,11 +253,26 @@ static HRESULT STDMETHODCALLTYPE dxgi_surface_ReleaseDC(IDXGISurface1 *iface, RE
 
     TRACE("iface %p, rect %s\n", iface, wine_dbgstr_rect(dirty_rect));
 
-    if (!IsRectEmpty(dirty_rect))
-        FIXME("dirty rectangle is ignored.\n");
-
+    /* The DC draws straight into the surface's memory, so the whole surface is
+     * up to date whatever rectangle the caller names. */
     wined3d_mutex_lock();
+#ifndef SG_MUTANT_DXGI_RELEASE
+    if (!resource->dc)
+    {
+        wined3d_mutex_unlock();
+        WARN("No DC to release.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+#endif
     hr = wined3d_texture_release_dc(wined3d_texture_from_resource(resource->wined3d_resource), 0, resource->dc);
+#ifdef SG_MUTANT_DXGI_RELEASE
+    if (hr == WINED3DERR_INVALIDCALL)
+        hr = S_OK;
+#endif
+    if (hr == WINED3DERR_INVALIDCALL)
+        hr = DXGI_ERROR_INVALID_CALL;
+    if (SUCCEEDED(hr))
+        resource->dc = NULL;
     wined3d_mutex_unlock();
 
     return hr;
