From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32, sechost: LookupAccountNameLocalA/W

Stubs in sechost, missing from advapi32 (looked up by name by programs that use them when present).
LookupAccountName on the local computer, as documented. Gate: test/namelocal-gate.sh.
Mutant: SG_MUTANT_NAMELOCAL_FAIL.
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -1123,6 +1123,34 @@
 }
 
 /******************************************************************************
+ * LookupAccountNameLocalA [ADVAPI32.@]
+ *
+ * Stained Glass OS (wine-sg 9712): LookupAccountName on the local computer, as Windows documents it.
+ */
+BOOL WINAPI LookupAccountNameLocalA( LPCSTR account, PSID sid, LPDWORD sid_size, LPSTR domain,
+                                     LPDWORD domain_size, PSID_NAME_USE name_use )
+{
+#ifdef SG_MUTANT_NAMELOCAL_FAIL
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    return FALSE;
+#endif
+    return LookupAccountNameA( NULL, account, sid, sid_size, domain, domain_size, name_use );
+}
+
+/******************************************************************************
+ * LookupAccountNameLocalW [ADVAPI32.@]
+ */
+BOOL WINAPI LookupAccountNameLocalW( LPCWSTR account, PSID sid, LPDWORD sid_size, LPWSTR domain,
+                                     LPDWORD domain_size, PSID_NAME_USE name_use )
+{
+#ifdef SG_MUTANT_NAMELOCAL_FAIL
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    return FALSE;
+#endif
+    return LookupAccountNameW( NULL, account, sid, sid_size, domain, domain_size, name_use );
+}
+
+/******************************************************************************
  * LookupAccountSidLocalA [ADVAPI32.@]
  */
 BOOL WINAPI
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -428,6 +428,8 @@
 @ stdcall LogonUserExW(wstr wstr wstr long long ptr ptr ptr ptr ptr)
 @ stdcall LogonUserW(wstr wstr wstr long long ptr)
 @ stdcall LookupAccountNameA(str str ptr ptr ptr ptr ptr)
+@ stdcall LookupAccountNameLocalA(str ptr ptr ptr ptr ptr)
+@ stdcall LookupAccountNameLocalW(wstr ptr ptr ptr ptr ptr)
 @ stdcall LookupAccountNameW(wstr wstr ptr ptr ptr ptr ptr)
 @ stdcall LookupAccountSidA(str ptr ptr ptr ptr ptr ptr)
 @ stdcall LookupAccountSidLocalA(ptr ptr ptr ptr ptr ptr)
--- a/dlls/sechost/sechost.spec
+++ b/dlls/sechost/sechost.spec
@@ -122,8 +122,8 @@
 @ stub LocalGetStringForCondition
 @ stub LocalRpcBindingCreateWithSecurity
 @ stub LocalRpcBindingSetAuthInfoEx
-@ stub LookupAccountNameLocalA
-@ stub LookupAccountNameLocalW
+@ stdcall LookupAccountNameLocalA(str ptr ptr ptr ptr ptr) advapi32.LookupAccountNameLocalA
+@ stdcall LookupAccountNameLocalW(wstr ptr ptr ptr ptr ptr) advapi32.LookupAccountNameLocalW
 @ stdcall LookupAccountSidLocalA(ptr ptr ptr ptr ptr ptr) advapi32.LookupAccountSidLocalA
 @ stdcall LookupAccountSidLocalW(ptr ptr ptr ptr ptr ptr) advapi32.LookupAccountSidLocalW
 @ stdcall LsaAddAccountRights(ptr ptr ptr long) advapi32.LsaAddAccountRights
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -2675,6 +2675,9 @@
 WINADVAPI  BOOL        WINAPI LookupAccountSidA(LPCSTR,PSID,LPSTR,LPDWORD,LPSTR,LPDWORD,PSID_NAME_USE);
 WINADVAPI  BOOL        WINAPI LookupAccountSidW(LPCWSTR,PSID,LPWSTR,LPDWORD,LPWSTR,LPDWORD,PSID_NAME_USE);
 #define                       LookupAccountSid WINELIB_NAME_AW(LookupAccountSid)
+WINADVAPI  BOOL        WINAPI LookupAccountNameLocalA(LPCSTR,PSID,LPDWORD,LPSTR,LPDWORD,PSID_NAME_USE);
+WINADVAPI  BOOL        WINAPI LookupAccountNameLocalW(LPCWSTR,PSID,LPDWORD,LPWSTR,LPDWORD,PSID_NAME_USE);
+#define                       LookupAccountNameLocal WINELIB_NAME_AW(LookupAccountNameLocal)
 WINADVAPI  BOOL        WINAPI LookupAccountSidLocalA(PSID,LPSTR,LPDWORD,LPSTR,LPDWORD,PSID_NAME_USE);
 WINADVAPI  BOOL        WINAPI LookupAccountSidLocalW(PSID,LPWSTR,LPDWORD,LPWSTR,LPDWORD,PSID_NAME_USE);
 #define                       LookupAccountSidLocal WINELIB_NAME_AW(LookupAccountSidLocal)
