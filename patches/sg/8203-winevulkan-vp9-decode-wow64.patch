From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winevulkan: VK_KHR_video_decode_vp9 for 32-bit programs.

7848 offered VP9 video decode to 64-bit programs only: winevulkan's thunks come from a registry older
than the extension, and a 32-bit program's structures must be converted. Now they are, by hand, in the
generated converters: the VP9 feature (vkCreateDevice, vkGetPhysicalDeviceFeatures2 both ways), the VP9
profile (video profiles, query pools), the VP9 decode capabilities (both ways) and the VP9 picture info
(vkCmdDecodeVideoKHR: its standard picture info's three pointers widened; what they point to holds no
pointers). So 32-bit DXVK D3D11 decoders and DXVA2 get VP9 like 64-bit ones.
---
--- a/dlls/winevulkan/vulkan.c
+++ b/dlls/winevulkan/vulkan.c
@@ -158,16 +158,18 @@
 }
 
 /* Stained Glass OS (7848): the device extensions offered. VK_KHR_video_decode_vp9 is newer than the
- * registry these thunks were made from: its feature structure is converted for 64-bit callers only
- * (vkCreateDevice), the rest of it passes through as it is; a 32-bit caller would need its structures
- * converted, so it is not offered there. */
+ * registry these thunks were made from: its feature structure is converted for 64-bit callers
+ * (vkCreateDevice), the rest of it passes through as it is; for 32-bit callers its structures are
+ * converted by hand (8203). */
 static BOOL device_extension_offered(const char *name)
 {
     if (!wine_vk_device_extension_supported(name)) return FALSE;
 #ifdef SG_MUTANT_VP9_NOT_OFFERED
     if (!strcmp(name, "VK_KHR_video_decode_vp9")) return FALSE;
 #endif
-    if (!strcmp(name, "VK_KHR_video_decode_vp9") && (sizeof(void *) != sizeof(UINT64) || is_wow64())) return FALSE;
+#ifdef SG_MUTANT_VP9_WOW64_HIDDEN
+    if (!strcmp(name, "VK_KHR_video_decode_vp9") && is_wow64()) return FALSE;
+#endif
     return TRUE;
 }
 
--- a/dlls/winevulkan/vulkan_thunks.c
+++ b/dlls/winevulkan/vulkan_thunks.c
@@ -1993,6 +1993,88 @@
     StdVideoH265ProfileIdc stdProfileIdc;
 } VkVideoDecodeH265ProfileInfoKHR32;
 
+/* Stained Glass OS (wine-sg 8203): VK_KHR_video_decode_vp9's structures, which the registry these thunks were
+ * made from predates (layouts as in the Vulkan registry and vk_video/vulkan_video_codec_vp9std_decode.h).
+ * The color config, loop filter and segmentation a picture points to hold no pointers: their 32-bit
+ * addresses only widen. */
+typedef struct VkVideoDecodeVP9ProfileInfoKHR
+{
+    VkStructureType sType;
+    const void *pNext;
+    uint32_t stdProfile;
+} VkVideoDecodeVP9ProfileInfoKHR;
+typedef struct VkVideoDecodeVP9ProfileInfoKHR32
+{
+    VkStructureType sType;
+    PTR32 pNext;
+    uint32_t stdProfile;
+} VkVideoDecodeVP9ProfileInfoKHR32;
+typedef struct VkVideoDecodeVP9CapabilitiesKHR
+{
+    VkStructureType sType;
+    void *pNext;
+    uint32_t maxLevel;
+} VkVideoDecodeVP9CapabilitiesKHR;
+typedef struct VkVideoDecodeVP9CapabilitiesKHR32
+{
+    VkStructureType sType;
+    PTR32 pNext;
+    uint32_t maxLevel;
+} VkVideoDecodeVP9CapabilitiesKHR32;
+typedef struct StdVideoDecodeVP9PictureInfo
+{
+    uint8_t head[32];   /* flags, profile, frame type ... tile_rows_log2, reserved1 */
+    const void *pColorConfig;
+    const void *pLoopFilter;
+    const void *pSegmentation;
+} StdVideoDecodeVP9PictureInfo;
+typedef struct StdVideoDecodeVP9PictureInfo32
+{
+    uint8_t head[32];
+    PTR32 pColorConfig;
+    PTR32 pLoopFilter;
+    PTR32 pSegmentation;
+} StdVideoDecodeVP9PictureInfo32;
+typedef struct VkVideoDecodeVP9PictureInfoKHR
+{
+    VkStructureType sType;
+    const void *pNext;
+    const StdVideoDecodeVP9PictureInfo *pStdPictureInfo;
+    int32_t referenceNameSlotIndices[3];
+    uint32_t uncompressedHeaderOffset;
+    uint32_t compressedHeaderOffset;
+    uint32_t tilesOffset;
+} VkVideoDecodeVP9PictureInfoKHR;
+typedef struct VkVideoDecodeVP9PictureInfoKHR32
+{
+    VkStructureType sType;
+    PTR32 pNext;
+    PTR32 pStdPictureInfo;
+    int32_t referenceNameSlotIndices[3];
+    uint32_t uncompressedHeaderOffset;
+    uint32_t compressedHeaderOffset;
+    uint32_t tilesOffset;
+} VkVideoDecodeVP9PictureInfoKHR32;
+typedef struct VkPhysicalDeviceVideoDecodeVP9FeaturesKHR32
+{
+    VkStructureType sType;
+    PTR32 pNext;
+    VkBool32 videoDecodeVP9;
+} VkPhysicalDeviceVideoDecodeVP9FeaturesKHR32;
+
+static const StdVideoDecodeVP9PictureInfo *convert_StdVideoDecodeVP9PictureInfo_win32_to_host(struct conversion_context *ctx,
+        const StdVideoDecodeVP9PictureInfo32 *in)
+{
+    StdVideoDecodeVP9PictureInfo *out;
+
+    if (!in || !(out = conversion_context_alloc(ctx, sizeof(*out)))) return NULL;
+    memcpy(out->head, in->head, sizeof(out->head));
+    out->pColorConfig = UlongToPtr(in->pColorConfig);
+    out->pLoopFilter = UlongToPtr(in->pLoopFilter);
+    out->pSegmentation = UlongToPtr(in->pSegmentation);
+    return out;
+}
+
 typedef struct VkVideoDecodeAV1ProfileInfoKHR32
 {
     VkStructureType sType;
