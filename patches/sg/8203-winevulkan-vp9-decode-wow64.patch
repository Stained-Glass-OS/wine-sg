+            memcpy(out_ext->referenceNameSlotIndices, in_ext->referenceNameSlotIndices, sizeof(out_ext->referenceNameSlotIndices));
+            out_ext->uncompressedHeaderOffset = in_ext->uncompressedHeaderOffset;
