+static HRESULT WINAPI reader_closable_Close( IClosable *iface )
+{
+    struct data_reader *impl = impl_from_IClosable( iface );
+    IInputStream *stream = impl->stream;
+    IClosable *closable;
+
+    TRACE( "iface %p.\n", iface );
+
+    /* closing the reader closes its stream */
+    impl->stream = NULL;
+    if (stream)
+    {
+        if (SUCCEEDED(IInputStream_QueryInterface( stream, &IID_IClosable, (void **)&closable )))
+        {
+            IClosable_Close( closable );
+            IClosable_Release( closable );
+        }
+        IInputStream_Release( stream );
+    }
+    return S_OK;
+}
