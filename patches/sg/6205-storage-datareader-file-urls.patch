+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A DataReader reads values from bytes it holds: a buffer's (DataReader.FromBuffer) or those
+ * LoadAsync brought in from its input stream.  Numbers are in its ByteOrder (big-endian unless set),
+ * strings in its UnicodeEncoding (UTF-8 unless set), counted in code units; reading past what it
+ * holds is E_BOUNDS.  LoadAsync reads synchronously and completes at once.
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+struct data_reader
+{
+    IDataReader IDataReader_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    IInputStream *stream;
+    UnicodeEncoding encoding;
+    ByteOrder byte_order;
+    InputStreamOptions options;
+    BYTE *bytes;          /* loaded, from offset on not read yet */
+    UINT32 length;
+    UINT32 offset;
+};
+
+static inline struct data_reader *impl_from_IDataReader( IDataReader *iface )
+{
+    return CONTAINING_RECORD( iface, struct data_reader, IDataReader_iface );
+}
+
+static HRESULT WINAPI reader_QueryInterface( IDataReader *iface, REFIID iid, void **out )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDataReader ))
+        *out = &impl->IDataReader_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI reader_AddRef( IDataReader *iface )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI reader_Release( IDataReader *iface )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->stream) IInputStream_Release( impl->stream );
+        free( impl->bytes );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI reader_GetIids( IDataReader *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI reader_GetRuntimeClassName( IDataReader *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_Storage_Streams_DataReader;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI reader_GetTrustLevel( IDataReader *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT append( struct data_reader *impl, const BYTE *data, UINT32 size )
+{
+    UINT32 left = impl->length - impl->offset;
+    BYTE *bytes;
+
+    if (size > 0x7fffffff - left) return E_OUTOFMEMORY;
+    if (!(bytes = malloc( left + size ? left + size : 1 ))) return E_OUTOFMEMORY;
+    if (left) memcpy( bytes, impl->bytes + impl->offset, left );
+    if (size) memcpy( bytes + left, data, size );
+    free( impl->bytes );
+    impl->bytes = bytes;
+    impl->length = left + size;
+    impl->offset = 0;
+    return S_OK;
+}
+
+/* the next size bytes, consumed */
+static HRESULT take( struct data_reader *impl, void *out, UINT32 size )
+{
+#ifndef SG_MUTANT_READER_NO_BOUNDS
+    if (size > impl->length - impl->offset) return E_BOUNDS;
+#endif
+    memcpy( out, impl->bytes + impl->offset, size );
+    impl->offset += size;
+    return S_OK;
+}
+
+/* an integer in the reader's byte order */
+static HRESULT take_number( struct data_reader *impl, void *out, UINT32 size )
+{
+    BYTE bytes[8];
+    UINT32 i;
+    HRESULT hr;
+
+    if (impl->byte_order == ByteOrder_LittleEndian) return take( impl, out, size );
+    if (FAILED(hr = take( impl, bytes, size ))) return hr;
+    for (i = 0; i < size; ++i) ((BYTE *)out)[i] = bytes[size - 1 - i];
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_UnconsumedBufferLength( IDataReader *iface, UINT32 *value )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->length - impl->offset;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_UnicodeEncoding( IDataReader *iface, UnicodeEncoding *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IDataReader( iface )->encoding;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_put_UnicodeEncoding( IDataReader *iface, UnicodeEncoding value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    if (value != UnicodeEncoding_Utf8 && value != UnicodeEncoding_Utf16LE && value != UnicodeEncoding_Utf16BE)
+        return E_INVALIDARG;
+    impl_from_IDataReader( iface )->encoding = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_ByteOrder( IDataReader *iface, ByteOrder *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IDataReader( iface )->byte_order;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_put_ByteOrder( IDataReader *iface, ByteOrder value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    if (value != ByteOrder_LittleEndian && value != ByteOrder_BigEndian) return E_INVALIDARG;
+    impl_from_IDataReader( iface )->byte_order = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_get_InputStreamOptions( IDataReader *iface, InputStreamOptions *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IDataReader( iface )->options;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_put_InputStreamOptions( IDataReader *iface, InputStreamOptions value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IDataReader( iface )->options = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_ReadByte( IDataReader *iface, BYTE *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return take( impl_from_IDataReader( iface ), value, 1 );
+}
+
+static HRESULT WINAPI reader_ReadBytes( IDataReader *iface, UINT32 value_size, BYTE *value )
+{
+    TRACE( "iface %p, value_size %u, value %p.\n", iface, value_size, value );
+    if (!value && value_size) return E_POINTER;
+    return take( impl_from_IDataReader( iface ), value, value_size );
+}
+
+static HRESULT WINAPI reader_ReadBuffer( IDataReader *iface, UINT32 length, IBuffer **buffer )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, length %u, buffer %p.\n", iface, length, buffer );
+
+    if (!buffer) return E_POINTER;
+    if (length > impl->length - impl->offset) return E_BOUNDS;
+    if (FAILED(hr = buffer_create( length, buffer ))) return hr;
+    buffer_get_bytes( *buffer, &bytes, NULL, NULL );
+    take( impl, bytes, length );
+    IBuffer_put_Length( *buffer, length );
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_ReadBoolean( IDataReader *iface, boolean *value )
+{
+    BYTE byte;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (SUCCEEDED(hr = take( impl_from_IDataReader( iface ), &byte, 1 ))) *value = !!byte;
+    return hr;
+}
+
+static HRESULT WINAPI reader_ReadGuid( IDataReader *iface, GUID *value )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if (impl->length - impl->offset < 16) return E_BOUNDS;
+    if (FAILED(hr = take_number( impl, &value->Data1, 4 ))) return hr;
+    if (FAILED(hr = take_number( impl, &value->Data2, 2 ))) return hr;
+    if (FAILED(hr = take_number( impl, &value->Data3, 2 ))) return hr;
+    return take( impl, value->Data4, 8 );
+}
+
+#define READ_NUMBER( name, type )                                                       \
+static HRESULT WINAPI reader_Read##name( IDataReader *iface, type *value )             \
+{                                                                                      \
+    TRACE( "iface %p, value %p.\n", iface, value );                                    \
+    if (!value) return E_POINTER;                                                      \
+    return take_number( impl_from_IDataReader( iface ), value, sizeof(*value) );       \
+}
+READ_NUMBER( Int16, INT16 )
+READ_NUMBER( Int32, INT32 )
+READ_NUMBER( Int64, INT64 )
+READ_NUMBER( UInt16, UINT16 )
+READ_NUMBER( UInt32, UINT32 )
+READ_NUMBER( UInt64, UINT64 )
+READ_NUMBER( Single, FLOAT )
+READ_NUMBER( Double, DOUBLE )
+#undef READ_NUMBER
+
+static HRESULT WINAPI reader_ReadString( IDataReader *iface, UINT32 code_unit_count, HSTRING *value )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    HSTRING_BUFFER buffer;
+    WCHAR *str;
+    UINT32 size, i;
+    int length;
+    HRESULT hr;
+
+    TRACE( "iface %p, code_unit_count %u, value %p.\n", iface, code_unit_count, value );
+
+    if (!value) return E_POINTER;
+    size = impl->encoding == UnicodeEncoding_Utf8 ? code_unit_count : code_unit_count * 2;
+    if (code_unit_count > 0x3fffffff || size > impl->length - impl->offset) return E_BOUNDS;
+    if (!size) return WindowsCreateString( NULL, 0, value );
+
+    if (impl->encoding == UnicodeEncoding_Utf8)
+    {
+        const char *utf8 = (const char *)impl->bytes + impl->offset;
+
+        length = MultiByteToWideChar( CP_UTF8, 0, utf8, size, NULL, 0 );
+        if (FAILED(hr = WindowsPreallocateStringBuffer( length, &str, &buffer ))) return hr;
+        MultiByteToWideChar( CP_UTF8, 0, utf8, size, str, length );
+    }
+    else
+    {
+        const BYTE *src = impl->bytes + impl->offset;
+
+        if (FAILED(hr = WindowsPreallocateStringBuffer( code_unit_count, &str, &buffer ))) return hr;
+        for (i = 0; i < code_unit_count; i++)
+            str[i] = impl->encoding == UnicodeEncoding_Utf16LE ? src[2 * i] | (src[2 * i + 1] << 8)
+                                                               : (src[2 * i] << 8) | src[2 * i + 1];
+    }
+    if (FAILED(hr = WindowsPromoteStringBuffer( buffer, value )))
+    {
+        WindowsDeleteStringBuffer( buffer );
+        return hr;
+    }
+    impl->offset += size;
+    return S_OK;
+}
+
+static HRESULT WINAPI reader_ReadDateTime( IDataReader *iface, DateTime *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return take_number( impl_from_IDataReader( iface ), &value->UniversalTime, 8 );
+}
+
+static HRESULT WINAPI reader_ReadTimeSpan( IDataReader *iface, TimeSpan *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return take_number( impl_from_IDataReader( iface ), &value->Duration, 8 );
+}
+
+/* waits for another stream's read to finish */
+struct read_wait
+{
+    IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 iface;
+    LONG ref;
+    HANDLE event;
+};
+
+static struct read_wait *impl_from_read_wait( IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *iface )
+{
+    return CONTAINING_RECORD( iface, struct read_wait, iface );
+}
+
+static HRESULT WINAPI read_wait_QueryInterface( IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *iface,
+                                                REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 ))
+    {
+        InterlockedIncrement( &impl_from_read_wait( iface )->ref );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI read_wait_AddRef( IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *iface )
+{
+    return InterlockedIncrement( &impl_from_read_wait( iface )->ref );
+}
+
+static ULONG WINAPI read_wait_Release( IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *iface )
+{
+    struct read_wait *impl = impl_from_read_wait( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        CloseHandle( impl->event );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI read_wait_Invoke( IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *iface,
+                                        IAsyncOperationWithProgress_IBuffer_UINT32 *operation, AsyncStatus status )
+{
+    SetEvent( impl_from_read_wait( iface )->event );
+    return S_OK;
+}
+
+static const struct IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32Vtbl read_wait_vtbl =
+{
+    read_wait_QueryInterface,
+    read_wait_AddRef,
+    read_wait_Release,
+    read_wait_Invoke,
+};
+
+/* one read of up to count bytes from the stream, appended */
+static HRESULT read_once( struct data_reader *impl, UINT32 count, UINT32 *read )
+{
+    IAsyncOperationWithProgress_IBuffer_UINT32 *operation;
+    IBuffer *buffer, *result = NULL;
+    struct read_wait *wait;
+    UINT32 length = 0;
+    BYTE *bytes;
+    HRESULT hr;
+
+    *read = 0;
+    if (FAILED(hr = buffer_create( count, &buffer ))) return hr;
+    hr = IInputStream_ReadAsync( impl->stream, buffer, count, impl->options, &operation );
+    IBuffer_Release( buffer );
+    if (FAILED(hr)) return hr;
+
+    if (!(wait = calloc( 1, sizeof(*wait) )))
+    {
+        IAsyncOperationWithProgress_IBuffer_UINT32_Release( operation );
+        return E_OUTOFMEMORY;
+    }
+    wait->iface.lpVtbl = &read_wait_vtbl;
+    wait->ref = 1;
+    wait->event = CreateEventW( NULL, TRUE, FALSE, NULL );
+    if (SUCCEEDED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_put_Completed( operation, &wait->iface )))
+    {
+        WaitForSingleObject( wait->event, INFINITE );
+        hr = IAsyncOperationWithProgress_IBuffer_UINT32_GetResults( operation, &result );
+    }
+    IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_Release( &wait->iface );
+    IAsyncOperationWithProgress_IBuffer_UINT32_Release( operation );
+    if (SUCCEEDED(hr) && result && SUCCEEDED(hr = buffer_get_bytes( result, &bytes, &length, NULL )))
+    {
+        if (length > count) length = count;
+        if (SUCCEEDED(hr = append( impl, bytes, length ))) *read = length;
+    }
+    if (result) IBuffer_Release( result );
+    return hr;
+}
+
+static HRESULT WINAPI reader_LoadAsync( IDataReader *iface, UINT32 count, IAsyncOperation_UINT32 **operation )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+    UINT32 loaded = 0, read;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, count %u, operation %p.\n", iface, count, operation );
+
+    if (!operation) return E_POINTER;
+    /* a reader made from a buffer has no stream to load from */
+    if (!impl->stream) return E_ILLEGAL_METHOD_CALL;
+    /* all of it, unless a partial read will do; the stream's end stops it */
+    while (loaded < count)
+    {
+        if (FAILED(hr = read_once( impl, count - loaded, &read )) || !read) break;
+        loaded += read;
+        if (impl->options & InputStreamOptions_Partial) break;
+    }
+    return async_uint32_create( loaded, hr, operation );
+}
+
+static HRESULT WINAPI reader_DetachBuffer( IDataReader *iface, IBuffer **buffer )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+
+    TRACE( "iface %p, buffer %p.\n", iface, buffer );
+    return reader_ReadBuffer( iface, impl->length - impl->offset, buffer );
+}
+
+static HRESULT WINAPI reader_DetachStream( IDataReader *iface, IInputStream **stream )
+{
+    struct data_reader *impl = impl_from_IDataReader( iface );
+
+    TRACE( "iface %p, stream %p.\n", iface, stream );
+
+    if (!stream) return E_POINTER;
+    *stream = impl->stream;
+    impl->stream = NULL;
+    return S_OK;
+}
+
+static const struct IDataReaderVtbl reader_vtbl =
+{
+    reader_QueryInterface,
+    reader_AddRef,
+    reader_Release,
+    /* IInspectable methods */
+    reader_GetIids,
+    reader_GetRuntimeClassName,
+    reader_GetTrustLevel,
+    /* IDataReader methods */
+    reader_get_UnconsumedBufferLength,
+    reader_get_UnicodeEncoding,
+    reader_put_UnicodeEncoding,
+    reader_get_ByteOrder,
+    reader_put_ByteOrder,
+    reader_get_InputStreamOptions,
+    reader_put_InputStreamOptions,
+    reader_ReadByte,
+    reader_ReadBytes,
+    reader_ReadBuffer,
+    reader_ReadBoolean,
+    reader_ReadGuid,
+    reader_ReadInt16,
+    reader_ReadInt32,
+    reader_ReadInt64,
+    reader_ReadUInt16,
+    reader_ReadUInt32,
+    reader_ReadUInt64,
+    reader_ReadSingle,
+    reader_ReadDouble,
+    reader_ReadString,
+    reader_ReadDateTime,
