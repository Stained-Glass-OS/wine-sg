From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.storage: DataReader, and file: URLs for StorageFile paths

React Native for Windows (OneDrive's interface) opens its script bundle with StorageFile.GetFileFromPathAsync("file:///C:\...") and reads it with DataReader.FromBuffer. The URL was refused with E_INVALIDARG, and DataReader did not exist, so OneDrive's window stayed empty. A file: URL now names its path, as the shell parses it on Windows. DataReader reads numbers in its byte order, UTF-8 or UTF-16 strings counted in code units, GUIDs, dates and buffers from a buffer or from what LoadAsync brought in from its stream. Reading past what it holds is E_BOUNDS.
---
diff --git a/dlls/windows.storage/Makefile.in b/dlls/windows.storage/Makefile.in
index bc9450c..a026c4b 100644
--- a/dlls/windows.storage/Makefile.in
+++ b/dlls/windows.storage/Makefile.in
@@ -11,6 +11,7 @@ SOURCES = \
 	files.idl \
 	item.c \
 	main.c \
+	reader.c \
 	stream.c \
 	wrapstream.c \
 	writer.c
diff --git a/dlls/windows.storage/item.c b/dlls/windows.storage/item.c
index 3c2e981..e29c7aa 100644
--- a/dlls/windows.storage/item.c
+++ b/dlls/windows.storage/item.c
@@ -19,6 +19,7 @@
 
 #include "private.h"
 #include "winhttp.h"
+#include "shlwapi.h"
 #include "wine/list.h"
 #include "wine/debug.h"
 
@@ -75,10 +76,19 @@ static BOOL is_valid_name( const WCHAR *name )
 /* a full path without trailing separator (except for a root), or an error */
 static HRESULT normalize_path( const WCHAR *in, WCHAR **out )
 {
-    WCHAR full[MAX_PATH * 2], *p;
+    WCHAR full[MAX_PATH * 2], from_url[MAX_PATH * 2], *p;
     DWORD len;
 
     if (!in || !*in) return E_INVALIDARG;
+#ifndef SG_MUTANT_STORAGE_NO_FILE_URL
+    /* a file: URL names its path (the shell parses paths so; React Native for Windows loads its bundle by one) */
+    if (!wcsnicmp( in, L"file:", 5 ))
+    {
+        len = ARRAY_SIZE(from_url);
+        if (FAILED(PathCreateFromUrlW( in, from_url, &len, 0 ))) return E_INVALIDARG;
+        in = from_url;
+    }
+#endif
     if (wcschr( in, '/' )) return E_INVALIDARG;
     if (!((iswalpha( in[0] ) && in[1] == ':' && in[2] == '\\') || (in[0] == '\\' && in[1] == '\\')))
         return E_INVALIDARG;
diff --git a/dlls/windows.storage/main.c b/dlls/windows.storage/main.c
index 1f753ef..47eb6dd 100644
--- a/dlls/windows.storage/main.c
+++ b/dlls/windows.storage/main.c
@@ -42,6 +42,8 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
         IActivationFactory_QueryInterface( buffer_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Streams_DataWriter ))
         IActivationFactory_QueryInterface( data_writer_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Streams_DataReader ))
+        IActivationFactory_QueryInterface( data_reader_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Streams_InMemoryRandomAccessStream ))
         IActivationFactory_QueryInterface( memory_stream_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( buffer, RuntimeClass_Windows_Storage_Streams_RandomAccessStreamReference ))
diff --git a/dlls/windows.storage/private.h b/dlls/windows.storage/private.h
index 8fdc0c7..9051264 100644
--- a/dlls/windows.storage/private.h
+++ b/dlls/windows.storage/private.h
@@ -48,6 +48,7 @@
 
 extern IActivationFactory *buffer_factory;
