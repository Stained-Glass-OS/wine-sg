+static HRESULT data_reader_create( IInputStream *stream, IDataReader **out )
+{
+    struct data_reader *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDataReader_iface.lpVtbl = &reader_vtbl;
+    impl->IClosable_iface.lpVtbl = &reader_closable_vtbl;
+    impl->ref = 1;
+    impl->encoding = UnicodeEncoding_Utf8;
+    impl->byte_order = ByteOrder_BigEndian;
+    impl->options = InputStreamOptions_None;
+    if ((impl->stream = stream)) IInputStream_AddRef( stream );
+    *out = &impl->IDataReader_iface;
+    return S_OK;
