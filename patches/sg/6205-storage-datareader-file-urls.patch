 extern IActivationFactory *storage_folder_factory;
diff --git a/dlls/windows.storage/reader.c b/dlls/windows.storage/reader.c
new file mode 100644
index 0000000..34a8c51
--- /dev/null
+++ b/dlls/windows.storage/reader.c
@@ -0,0 +1,722 @@
