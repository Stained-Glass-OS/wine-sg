+
+static HRESULT WINAPI reader_statics_FromBuffer( IDataReaderStatics *iface, IBuffer *buffer, IDataReader **data_reader )
+{
+    struct data_reader *impl;
+    UINT32 length;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p, data_reader %p.\n", iface, buffer, data_reader );
+
+    if (!buffer || !data_reader) return E_POINTER;
+#ifdef SG_MUTANT_NO_DATA_READER
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = buffer_get_bytes( buffer, &bytes, &length, NULL ))) return hr;
+    if (FAILED(hr = data_reader_create( NULL, data_reader ))) return hr;
+    impl = impl_from_IDataReader( *data_reader );
+    if (FAILED(hr = append( impl, bytes, length )))
+    {
+        IDataReader_Release( *data_reader );
+        *data_reader = NULL;
+    }
+    return hr;
+}
+
+static const struct IDataReaderStaticsVtbl reader_statics_vtbl =
+{
+    reader_statics_QueryInterface,
+    reader_statics_AddRef,
+    reader_statics_Release,
