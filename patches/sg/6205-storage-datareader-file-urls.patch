+
+static HRESULT WINAPI reader_factory_CreateDataReader( IDataReaderFactory *iface, IInputStream *stream,
+                                                       IDataReader **data_reader )
+{
+    TRACE( "iface %p, stream %p, data_reader %p.\n", iface, stream, data_reader );
+    if (!stream || !data_reader) return E_POINTER;
+    return data_reader_create( stream, data_reader );
+}
