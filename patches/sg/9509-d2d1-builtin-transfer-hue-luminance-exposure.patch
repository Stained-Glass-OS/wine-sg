From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: Linear/Gamma/Table/Discrete Transfer, Hue Rotation, Luminance To Alpha and Exposure effects

These built-in effects were registered with their properties but drawn as their input ('Built-in effect ... is drawn as its input'). The built-in effect shader now does them: the four transfer effects are the Filter Effects spec's feComponentTransfer functions on straight colour, per channel (Linear: slope x + intercept; Gamma: amplitude x^exponent + offset; Table: piecewise linear through the table; Discrete: step table; a channel's Disable leaves it alone; ClampOutput), tables up to 256 values in the constants (longer ones resampled); Hue Rotation is feColorMatrix hueRotate with the angle in degrees; Luminance To Alpha is black with the luminance (0.2125, 0.7154, 0.0721) as alpha; Exposure multiplies the colour by 2 to the ExposureValue. The other stub effects (lighting, Brightness, Contrast, Sepia, Tint, Temperature/Tint, Vignette, Posterize, Highlights/Shadows, Displacement Map, Chroma Key, HDR Tone Map, YCbCr, Histogram, Lookup Table 3D, Hue/RGB) stay as they were.
---
--- a/dlls/d2d1/effect_render.c
+++ b/dlls/d2d1/effect_render.c
@@ -1014,9 +1014,9 @@
      * column-major unless told: the colour matrix was transposed and the
      * transforms lost their translation (Word's caret, a pixel moved to the
      * text, stayed at the origin) */
-    "cbuffer p : register(b0) { row_major float4x4 m; float4 v0; float4 v1; float4 v2; uint mode; };\n"
+    "cbuffer p : register(b0) { row_major float4x4 m; float4 v0; float4 v1; float4 v2; uint mode; float4 t[256]; };\n"
 #else
-    "cbuffer p : register(b0) { float4x4 m; float4 v0; float4 v1; float4 v2; uint mode; };\n"
+    "cbuffer p : register(b0) { float4x4 m; float4 v0; float4 v1; float4 v2; uint mode; float4 t[256]; };\n"
 #endif
     "Texture2D t0 : register(t0); SamplerState s0 : register(s0);\n"
     "Texture2D t1 : register(t1); SamplerState s1 : register(s1);\n"
@@ -1057,6 +1057,30 @@
     "    if (mode == 12) {\n"                                         /* invert */
     "        float4 u = unpremul(c); return premul(float4(1.0 - u.rgb, u.a));\n"
     "    }\n"
+    /* wine-sg 9509: the component transfers of the Filter Effects spec (feComponentTransfer), which the
+     * Linear, Gamma, Table and Discrete Transfer effects are: on straight colour, per channel */
+    "    if (mode == 13) {\n"                                         /* gamma/linear: v0 * u^v1 + v2 */
+    "        float4 r = v0 * pow(max(unpremul(c), 0.0), v1) + v2;\n"
+    "        if (m[0][0] > 0.5) r = saturate(r);\n"
+    "        return premul(r);\n"
+    "    }\n"
+    "    if (mode == 14) {\n"                                         /* table (v1.x 0) or discrete (1) */
+    "        float4 u = saturate(unpremul(c)), r = u;\n"
+    "        for (int ch = 0; ch < 4; ++ch) {\n"
+    "            float n = v0[ch];\n"
+    "            if (n < 1.0) continue;\n"
+    "            if (v1.x > 0.5) {\n"
+    "                int k = min(int(floor(u[ch] * n)), int(n) - 1);\n"
+    "                r[ch] = t[k][ch];\n"
+    "            } else if (n < 2.0) r[ch] = t[0][ch];\n"
+    "            else {\n"
+    "                float x = u[ch] * (n - 1.0); int k = min(int(floor(x)), int(n) - 2);\n"
+    "                r[ch] = lerp(t[k][ch], t[k + 1][ch], x - k);\n"
+    "            }\n"
+    "        }\n"
+    "        if (v1.y > 0.5) r = saturate(r);\n"
+    "        return premul(r);\n"
+    "    }\n"
     "    return c;\n"
     "}\n";
 
@@ -1065,6 +1089,7 @@
     float m[16];
     float v0[4], v1[4], v2[4];
     UINT32 mode, pad[3];
+    float t[256][4];    /* the Table and Discrete Transfer effects' tables, entry by entry (wine-sg 9509) */
 };
 
 static HRESULT fx_builtin_shaders(struct fx_renderer *r, ID3D11PixelShader **ps, ID3D11VertexShader **vs)
@@ -1458,6 +1483,111 @@
     }
     else if (IsEqualGUID(id, &CLSID_D2D1Invert))
         c.mode = 12;
+#ifndef SG_MUTANT_D2D_FX_STUBS
+    /* wine-sg 9509: effects that were drawn as their input */
+    else if (IsEqualGUID(id, &CLSID_D2D1LinearTransfer) || IsEqualGUID(id, &CLSID_D2D1GammaTransfer))
+    {
+        /* per channel: Linear y = slope x + intercept (YIntercept, Slope, Disable), Gamma y = amplitude x^exponent
+         * + offset (Amplitude, Exponent, Offset, Disable); then ClampOutput */
+        BOOL gamma = IsEqualGUID(id, &CLSID_D2D1GammaTransfer);
+        UINT32 per = gamma ? 4 : 3, ch, disable, clamp = 0;
+
+        c.mode = 13;
+        for (ch = 0; ch < 4; ++ch)
+        {
+            float a = 1.0f, e = 1.0f, o = 0.0f;
+
+            disable = 0;
+            if (gamma)
+            {
+                get_float(effect, ch * per, &a);
+                get_float(effect, ch * per + 1, &e);
+                get_float(effect, ch * per + 2, &o);
+            }
+            else
+            {
+                get_float(effect, ch * per, &o);
+                get_float(effect, ch * per + 1, &a);
+            }
+            get_uint(effect, ch * per + per - 1, D2D1_PROPERTY_TYPE_BOOL, &disable);
+            if (disable) { a = 1.0f; e = 1.0f; o = 0.0f; }
+            c.v0[ch] = a;
+            c.v1[ch] = e;
+            c.v2[ch] = o;
+        }
+        get_uint(effect, 4 * per, D2D1_PROPERTY_TYPE_BOOL, &clamp);
+        memset(c.m, 0, sizeof(c.m));
+        c.m[0] = clamp ? 1.0f : 0.0f;
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1TableTransfer) || IsEqualGUID(id, &CLSID_D2D1DiscreteTransfer))
+    {
+        /* RedTable (float blob), RedDisable, ... AlphaTable, AlphaDisable, ClampOutput; a table longer than 256
+         * values is resampled */
+        UINT32 ch, disable, clamp = 0, size, n, k;
+        float *values;
+
+        c.mode = 14;
+        c.v1[0] = IsEqualGUID(id, &CLSID_D2D1DiscreteTransfer) ? 1.0f : 0.0f;
+        for (ch = 0; ch < 4; ++ch)
+        {
+            disable = 0;
+            get_uint(effect, ch * 2 + 1, D2D1_PROPERTY_TYPE_BOOL, &disable);
+            size = ID2D1Effect_GetValueSize(&effect->ID2D1Effect_iface, ch * 2);
+            n = size / sizeof(float);
+            if (disable || !n || !(values = malloc(n * sizeof(float))))
+                continue;
+            if (SUCCEEDED(ID2D1Effect_GetValue(&effect->ID2D1Effect_iface, ch * 2, D2D1_PROPERTY_TYPE_BLOB,
+                    (BYTE *)values, n * sizeof(float))))
+            {
+                UINT32 used = min(n, 256);
+
+                for (k = 0; k < used; ++k)
+                    c.t[k][ch] = values[used == n ? k : (UINT32)((UINT64)k * (n - 1) / (used - 1))];
+                c.v0[ch] = used;
+            }
+            free(values);
+        }
+        get_uint(effect, 8, D2D1_PROPERTY_TYPE_BOOL, &clamp);
+        c.v1[1] = clamp ? 1.0f : 0.0f;
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1HueRotation))
+    {
+        /* the Filter Effects spec's hueRotate matrix, the angle in degrees; row vectors, so transposed */
+        static const float base[3][3] = {{0.213f, 0.715f, 0.072f}, {0.213f, 0.715f, 0.072f}, {0.213f, 0.715f, 0.072f}};
+        static const float cs[3][3] = {{0.787f, -0.715f, -0.072f}, {-0.213f, 0.285f, -0.072f}, {-0.213f, -0.715f, 0.928f}};
+        static const float sn[3][3] = {{-0.213f, -0.715f, 0.928f}, {0.143f, 0.140f, -0.283f}, {-0.787f, 0.715f, 0.072f}};
+        float angle = 0.0f, co, si;
+        unsigned int row, col;
+
+        get_float(effect, 0, &angle);
+        co = cosf(angle * (float)M_PI / 180.0f);
+        si = sinf(angle * (float)M_PI / 180.0f);
+        c.mode = 3;
+        memset(c.m, 0, sizeof(c.m));
+        for (row = 0; row < 3; ++row)
+            for (col = 0; col < 3; ++col)
+                c.m[col * 4 + row] = base[row][col] + co * cs[row][col] + si * sn[row][col];
+        c.m[15] = 1.0f;
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1LuminanceToAlpha))
+    {
+        /* feColorMatrix luminanceToAlpha: black, the alpha the luminance of the straight colour */
+        c.mode = 3;
+        memset(c.m, 0, sizeof(c.m));
+        c.m[0 * 4 + 3] = 0.2125f;
+        c.m[1 * 4 + 3] = 0.7154f;
+        c.m[2 * 4 + 3] = 0.0721f;
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Exposure))
+    {
+        /* the colour times 2 to the ExposureValue */
+        float ev = 0.0f;
+
+        get_float(effect, 0, &ev);
+        c.mode = 6;
+        c.v0[0] = powf(2.0f, ev);
+    }
+#endif
     else if (IsEqualGUID(id, &CLSID_D2D1ColorManagement))
     {
         D2D1_COLOR_SPACE src = fx_color_space(effect, 0), dst = fx_color_space(effect, 2);
