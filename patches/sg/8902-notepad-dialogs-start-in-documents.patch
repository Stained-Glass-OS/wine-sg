From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] notepad: Open and Save As start in Documents, then in the folder last used

The first Save As of a new document opened the profile folder: Notepad gave the common dialog no starting folder, and its rule then takes the current directory whenever a file there matches the filter -- "All files (*.*)" matches anything, and Notepad started from the Start menu runs in the profile folder. As Windows' Notepad, Open and Save As now start in the folder Notepad's dialogs last used (kept in HKCU\Software\Microsoft\Notepad, sgDialogFolder), and the first time in the user's Documents (FOLDERID_Documents). A document that was saved still starts in its own folder.
---
--- a/programs/notepad/main.c
+++ b/programs/notepad/main.c
@@ -35,6 +35,7 @@
 
 #include "notepad.h"
 #include <commctrl.h>
+#include <shlobj.h>
 #include "wine/sg_smooth.h"
 #include "wine/sg_accent.h"
 
@@ -785,12 +786,46 @@
     return TRUE;
 }
 
+/* Where Open and Save As start when the document has no folder of its own:
+ * the folder Notepad's dialogs last used, and the first time the user's
+ * Documents (FOLDERID_Documents), as Windows' Notepad does. Left to itself the
+ * common dialog took the current directory whenever it held a file matching
+ * the filter -- "All files (*.*)" matches anything -- so Notepad started from
+ * the Start menu offered the profile folder. */
+static void dialog_dir(WCHAR *dir, DWORD cch)
+{
+    HKEY key = NULL;
+#ifndef SG_MUTANT_NOTEPAD_DIALOG_DIR
+    RegOpenKeyExW(HKEY_CURRENT_USER, NOTEPAD_KEY, 0, KEY_READ, &key);
+    reg_str(key, L"sgDialogFolder", dir, cch, L"");
+    if (key) RegCloseKey(key);
+    if (dir[0] && PathIsDirectoryW(dir)) return;
+    if (SUCCEEDED(SHGetFolderPathW(NULL, CSIDL_PERSONAL | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, dir))) return;
+#endif
+    dir[0] = 0;
+}
+
+/* the folder of a file just opened or saved through a dialog (or, with
+ * is_dir, that folder itself) */
+static void remember_dialog_dir(const WCHAR *path, BOOL is_dir)
+{
+    WCHAR dir[MAX_PATH * 4];
+    HKEY key;
+
+    lstrcpynW(dir, path, ARRAY_SIZE(dir));
+    if (!is_dir) PathRemoveFileSpecW(dir);
+    if (!dir[0] || RegCreateKeyExW(HKEY_CURRENT_USER, NOTEPAD_KEY, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL)) return;
+    RegSetValueExW(key, L"sgDialogFolder", 0, REG_SZ, (const BYTE *)dir, (lstrlenW(dir) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+}
+
 static BOOL save_as_dialog(DOC *d)
 {
     OPENFILENAMEW ofn;
-    WCHAR path[MAX_PATH * 4], filter[512], *p = filter;
+    WCHAR path[MAX_PATH * 4], filter[512], *p = filter, dir[MAX_PATH * 4];
 
     lstrcpynW(path, d->path ? d->path : L"", ARRAY_SIZE(path));
+    dialog_dir(dir, ARRAY_SIZE(dir));
     if (!d->path) { lstrcpyW(path, L"*.txt"); }
     lstrcpyW(p, load_str(STRING_TEXT_FILES_TXT)); p += lstrlenW(p) + 1;
     lstrcpyW(p, L"*.txt"); p += lstrlenW(p) + 1;
@@ -811,7 +846,9 @@
     ofn.lpTemplateName = MAKEINTRESOURCEW(IDD_OFN_TEMPLATE);
     ofn.lpfnHook = save_hook;
     ofn.lCustData = (LPARAM)d;
+    if (!d->path && dir[0]) ofn.lpstrInitialDir = dir;   /* a saved one starts in its own folder */
     if (!GetSaveFileNameW(&ofn)) return FALSE;
+    remember_dialog_dir(path, FALSE);
     return save_doc_as(d, path);
 }
 
@@ -949,10 +986,11 @@
