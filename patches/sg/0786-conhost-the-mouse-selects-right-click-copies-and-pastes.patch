From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] conhost: the mouse selects; right-click copies and pastes

David 2026-10-03: in PowerShell (Wine's console window) nothing could be
highlighted, and neither a right-click nor Ctrl+Shift+C copied. QuickEdit
was off by default (a drag went to the program; selecting needed the Mark
menu), a right-click went to the program, and the console knew no Ctrl
shortcuts.

As Windows 10's console: QuickEdit is on by default (a setting kept in the
registry still wins); with it, a right-click copies the selection and ends
it, or pastes the clipboard when nothing is selected; Ctrl+C or
Ctrl+Shift+C with a selection copies it (and is not sent on as ^C), and
Ctrl+Shift+V pastes.

Test: test/consel-gate.sh (cmd in the console window: drag + right-click
copies, Ctrl+Shift+C copies, right-click with nothing selected pastes;
wine-sg 148 fails all three; mutant SG_MUTANT_NO_QUICK_EDIT).
---
--- a/programs/conhost/window.c
+++ b/programs/conhost/window.c
@@ -255,7 +255,11 @@
     config->insert_mode  = 1;
     config->menu_mask    = 0;
     config->popup_attr   = 0xF5;
+#ifndef SG_MUTANT_NO_QUICK_EDIT
+    config->quick_edit   = 1;   /* Stained Glass OS: as Windows 10: the mouse selects (David 2026-10-03) */
+#else
     config->quick_edit   = 0;
+#endif
     config->sb_height    = 150;
     config->sb_width     = 80;
     config->attr         = 0x000F;
@@ -2080,6 +2084,8 @@
     return 0;
 }
 
+static BOOL swallow_char;   /* the WM_CHAR of a key the console took */
+
 static LRESULT WINAPI window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
 {
     struct console *console = (struct console *)GetWindowLongPtrW( hwnd, 0 );
@@ -2132,6 +2138,27 @@
 
     case WM_KEYDOWN:
     case WM_KEYUP:
+        /* Stained Glass OS (David 2026-10-03: in PowerShell nothing could be
+         * selected or copied): as Windows 10's console, Ctrl+C or Ctrl+Shift+C
+         * with a selection copies it, Ctrl+Shift+V pastes */
+        if (msg == WM_KEYDOWN && console->window && GetKeyState( VK_CONTROL ) < 0 && GetKeyState( VK_MENU ) >= 0)
+        {
+            BOOL shift = GetKeyState( VK_SHIFT ) < 0;
+            if (wparam == 'C' && console->window->in_selection)
+            {
+                copy_selection( console );
+                update_selection( console, 0 );
+                console->window->in_selection = FALSE;
+                swallow_char = TRUE;   /* its ^C is not the program's */
+                break;
+            }
+            if (wparam == 'V' && shift)
+            {
+                paste_clipboard( console );
+                swallow_char = TRUE;
+                break;
+            }
+        }
         if (console->window && console->window->in_selection)
             handle_selection_key( console, msg == WM_KEYDOWN, wparam, lparam );
         else
@@ -2144,6 +2171,7 @@
         break;
 
     case WM_CHAR:
+        if (swallow_char) { swallow_char = FALSE; break; }
         if (console->window && console->window->in_selection)
             handle_selection_key( console, TRUE, LOBYTE( VkKeyScanW( (WCHAR)wparam ) ), lparam );
         else
@@ -2208,6 +2236,19 @@
         break;
 
     case WM_RBUTTONDOWN:
+        /* Stained Glass OS: QuickEdit's right-click, as Windows': the selection
+         * copied, or the clipboard pasted when nothing is selected */
+        if (console->window && console->window->quick_edit && !(wparam & (MK_CONTROL|MK_SHIFT)))
+        {
+            if (console->window->in_selection)
+            {
+                copy_selection( console );
+                update_selection( console, 0 );
+                console->window->in_selection = FALSE;
+            }
+            else paste_clipboard( console );
+            break;
+        }
         if (console->window && (wparam & (MK_CONTROL|MK_SHIFT)) == console->window->menu_mask)
         {
             POINT       pt;
@@ -2225,6 +2266,7 @@
         break;
 
     case WM_RBUTTONUP:
+        if (console->window && console->window->quick_edit && !(wparam & (MK_CONTROL|MK_SHIFT))) break;
         /* no need to track for rbutton up when opening the popup... the event will be
          * swallowed by TrackPopupMenu */
     case WM_MBUTTONDOWN:
