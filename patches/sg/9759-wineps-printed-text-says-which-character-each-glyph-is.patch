From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 06:13:33 -0800
Subject: [PATCH] wineps: printed text says which character each glyph is (9759)

Print to PDF from a Windows program gave a PDF whose text could not be
searched or copied whenever the font was an OpenType CFF font, or a TrueType
font without PostScript glyph names: the PostScript driver downloads each
font as Type 42 or Type 1 with the glyph names of the font's 'post' table,
or g0024-style names when it has none, and a PDF maker (ghostscript, as
cups-pdf and CUPS's PDF filters run it) can only make the PDF font's
ToUnicode map from names it knows. Windows' PostScript driver says which
character each glyph is in the font's /FontInfo /GlyphNames2Unicode
dictionary; so do we now: the font's character map read backwards, an
entry for each glyph as it is sent (not for a Level 1 printer, whose
dictionaries do not grow).
Gate test/pstext-gate.sh; mutant SG_MUTANT_PS_NO_G2U.
---
--- a/dlls/wineps.drv/download.c
+++ b/dlls/wineps.drv/download.c
@@ -715,6 +715,80 @@
     HeapFree(GetProcessHeap(), 0, post_header);
 }
 
+/* The character each glyph of the current font stands for: the font's character map read
+ * backwards (the first character that maps to a glyph wins, so U+0020 rather than U+00A0). */
+static void build_glyph_unicode(print_ctx *ctx, DOWNLOAD *pdl)
+{
+    DWORD size = GetFontUnicodeRanges(ctx->hdc, NULL), i, n = 0;
+    GLYPHSET *set;
+    WCHAR *chars;
+    WORD *glyphs;
+
+    pdl->glyph_unicode_count = 0;
+    if (!size || !(set = HeapAlloc(GetProcessHeap(), 0, size))) return;
+    if (!GetFontUnicodeRanges(ctx->hdc, set)) goto done;
+    for (i = 0; i < set->cRanges; i++) n = max(n, set->ranges[i].cGlyphs);
+    chars = HeapAlloc(GetProcessHeap(), 0, n * sizeof(*chars));
+    glyphs = HeapAlloc(GetProcessHeap(), 0, n * sizeof(*glyphs));
+    if (!chars || !glyphs) goto free;
+    for (i = 0; i < set->cRanges; i++)
+    {
+        WCHAR first = set->ranges[i].wcLow;
+        DWORD j, count = set->ranges[i].cGlyphs;
+
+        for (j = 0; j < count; j++) chars[j] = first + j;
+        if (GetGlyphIndicesW(ctx->hdc, chars, count, glyphs, GGI_MARK_NONEXISTING_GLYPHS) == GDI_ERROR) continue;
+        for (j = 0; j < count; j++)
+        {
+            WORD g = glyphs[j];
+            if (!g || g == 0xffff || chars[j] < 0x20) continue;
+            if (g >= pdl->glyph_unicode_count)
+            {
+                DWORD new_count = max(g + 1, pdl->glyph_unicode_count * 2);
+                WCHAR *map = pdl->glyph_unicode ?
+                    HeapReAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, pdl->glyph_unicode, new_count * sizeof(*map)) :
+                    HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, new_count * sizeof(*map));
+                if (!map) goto free;
+                pdl->glyph_unicode = map;
+                pdl->glyph_unicode_count = new_count;
+            }
+            if (!pdl->glyph_unicode[g]) pdl->glyph_unicode[g] = chars[j];
+        }
+    }
+free:
+    HeapFree(GetProcessHeap(), 0, chars);
+    HeapFree(GetProcessHeap(), 0, glyphs);
+done:
+    HeapFree(GetProcessHeap(), 0, set);
+    if (!pdl->glyph_unicode) pdl->glyph_unicode = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(WCHAR));
+}
+
+/****************************************************************************
+ *  PSDRV_WriteGlyphUnicode
+ *
+ *  Say which character a glyph just sent is, as the system's PostScript driver does: an entry
+ *  in the font's /FontInfo /GlyphNames2Unicode. PDF makers (ghostscript, Distiller) turn it into
+ *  the PDF font's ToUnicode map, so the text of a printed PDF can be searched and copied. Without
+ *  it a glyph is only a shape; its name ("g0024", or none a converter knows) says nothing.
+ */
+void PSDRV_WriteGlyphUnicode(print_ctx *ctx, DOWNLOAD *pdl, DWORD index, const char *glyph_name)
+{
+    static const char put[] = "/%s findfont /FontInfo get /GlyphNames2Unicode get /%s %u put\n";
+    char buf[sizeof(put) + 2 * MAX_G_NAME + 200];
+    WCHAR wc;
+
+#ifdef SG_MUTANT_PS_NO_G2U
+    return;
+#endif
+    if (!index) return; /* .notdef */
+    if (ctx->pi->ppd->LanguageLevel == 1) return; /* a Level 1 dictionary does not grow */
+    if (!pdl->glyph_unicode) build_glyph_unicode(ctx, pdl);
+    if (index >= pdl->glyph_unicode_count || !(wc = pdl->glyph_unicode[index])) return;
+    if (strlen(pdl->ps_name) > 200) return;
+    sprintf(buf, put, pdl->ps_name, glyph_name, wc);
+    PSDRV_WriteSpool(ctx, buf, strlen(buf));
+}
+
 /****************************************************************************
  *  PSDRV_WriteDownloadGlyphShow
  *
@@ -794,6 +868,7 @@
 	}
 
 	HeapFree(GetProcessHeap(), 0, pdl->ps_name);
+	HeapFree(GetProcessHeap(), 0, pdl->glyph_unicode);
 	old = pdl;
 	pdl = pdl->next;
 	HeapFree(GetProcessHeap(), 0, old);
--- a/dlls/wineps.drv/psdrv.h
+++ b/dlls/wineps.drv/psdrv.h
@@ -327,6 +327,8 @@
     TYPE42 *Type42;
   } typeinfo;
   char *ps_name;
+  WCHAR *glyph_unicode; /* the character of each glyph, from the font's cmap (built when first needed) */
+  DWORD glyph_unicode_count;
   struct _tagDOWNLOAD *next;
 } DOWNLOAD;
 
@@ -588,6 +590,7 @@
 
 extern BOOL PSDRV_WriteSetDownloadFont(print_ctx *ctx, BOOL vertical);
 extern BOOL PSDRV_WriteDownloadGlyphShow(print_ctx *ctx, const WORD *glyphs, UINT count);
+extern void PSDRV_WriteGlyphUnicode(print_ctx *ctx, DOWNLOAD *pdl, DWORD index, const char *glyph_name);
 extern BOOL PSDRV_EmptyDownloadList(print_ctx *ctx, BOOL write_undef);
 
 extern BOOL flush_spool(print_ctx *ctx);
--- a/dlls/wineps.drv/type1.c
+++ b/dlls/wineps.drv/type1.c
@@ -80,6 +80,7 @@
       " /FontMatrix [1 %ld div 0 0 1 %ld div 0 0] def\n"
       " /FontBBox [%ld %ld %ld %ld] def\n"
       " /FontType 1 def\n"
+      " /FontInfo 1 dict dup /GlyphNames2Unicode 256 dict put def\n"
       " /Private 7 dict begin\n"
       "  /RD {string currentfile exch readhexstring pop} def\n"
       "  /ND {def} def\n"
@@ -764,6 +765,7 @@
 
     t1->glyph_sent[index] = TRUE;
     HeapFree(GetProcessHeap(), 0, buf);
+    PSDRV_WriteGlyphUnicode(ctx, pdl, index, glyph_name);
     return TRUE;
 }
 
--- a/dlls/wineps.drv/type42.c
+++ b/dlls/wineps.drv/type42.c
@@ -152,6 +152,7 @@
 	    " /FontMatrix [1 0 0 1 0 0] def\n"
 	    " /FontBBox [%f %f %f %f] def\n"
 	    " /FontType 42 def\n"
+	    " /FontInfo 1 dict dup /GlyphNames2Unicode 256 dict put def\n"
 	    " /CharStrings 256 dict begin\n"
 	    "  /.notdef 0 def\n"
             " currentdict end def\n"
@@ -366,6 +367,7 @@
 
     t42->glyph_sent[index] = TRUE;
     HeapFree(GetProcessHeap(), 0, buf);
+    PSDRV_WriteGlyphUnicode(ctx, pdl, index, glyph_name);
     return TRUE;
 }
 
