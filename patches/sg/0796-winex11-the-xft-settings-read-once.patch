From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: the Xft settings, read once

XGetDefault keeps nothing when the X server has no resources and there is
no ~/.Xdefaults -- as in our sessions -- so every font selected into a
window's DC read the resource files again: the QA VM's File Explorer
opened ~/.Xdefaults and ~/.Xdefaults-<host> hundreds of times drawing one
folder (2026-10-04, while timing a network folder). Xft.antialias and
Xft.rgba are read once now.

Test: test/xftdefault-gate.sh with test/xftdefault-probe.c (mutant
SG_MUTANT_XFT_EVERY_FONT: 1369 opens for 300 selections, 20 with it).
---
--- a/dlls/winex11.drv/xrender.c
+++ b/dlls/winex11.drv/xrender.c
@@ -781,6 +781,28 @@
     }
 }
 
+/* Stained Glass OS: the Xft settings, read once. XGetDefault keeps nothing
+ * when the X server has no resources and there is no ~/.Xdefaults (our
+ * sessions): every font selected read the resource files again -- hundreds
+ * of opens for one File Explorer folder. */
+static char *xft_default( const char *name )
+{
+#ifndef SG_MUTANT_XFT_EVERY_FONT
+    static char *antialias, *rgba;
+    static BOOL read;
+    if (!read)
+    {
+        const char *v;
+        if ((v = XGetDefault( gdi_display, "Xft", "antialias" ))) antialias = strdup( v );
+        if ((v = XGetDefault( gdi_display, "Xft", "rgba" ))) rgba = strdup( v );
+        read = TRUE;
+    }
+    return !strcmp( name, "antialias" ) ? antialias : rgba;
+#else
+    return XGetDefault( gdi_display, "Xft", name );
+#endif
+}
+
 static UINT get_xft_aa_flags( const LOGFONTW *lf )
 {
     char *value, *p;
@@ -792,7 +814,7 @@
     case ANTIALIASED_QUALITY:
         break;
     default:
-        if (!(value = XGetDefault( gdi_display, "Xft", "antialias" ))) break;
+        if (!(value = xft_default( "antialias" ))) break;
         TRACE( "got antialias '%s'\n", value );
         for (p = value; *p; p++) if ('A' <= *p && *p <= 'Z') *p += 'a' - 'A'; /* to lower */
         if (value[0] == 'f' || value[0] == 'n' || value[0] == '0' || !strcmp( value, "off" ))
@@ -804,7 +826,7 @@
         /* fall through */
     case CLEARTYPE_QUALITY:
     case CLEARTYPE_NATURAL_QUALITY:
-        if (!(value = XGetDefault( gdi_display, "Xft", "rgba" ))) break;
+        if (!(value = xft_default( "rgba" ))) break;
         TRACE( "got rgba '%s'\n", value );
         if (!strcmp( value, "rgb" )) ret = WINE_GGO_HRGB_BITMAP;
         else if (!strcmp( value, "bgr" )) ret = WINE_GGO_HBGR_BITMAP;
