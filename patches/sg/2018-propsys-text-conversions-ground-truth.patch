+/* Stained Glass OS: the text of one scalar, as Windows writes numbers and times */
+static HRESULT PROPVAR_ScalarToString(VARTYPE vt, const void *p, WCHAR **ret)
+{
+    WCHAR text[96];
+    BSTR bstr = NULL;
+    SYSTEMTIME st;
+    HRESULT hr = S_OK;
+
+    switch (vt)
+    {
+    case VT_I1: swprintf(text, ARRAY_SIZE(text), L"%d", *(const signed char *)p); break;
+    case VT_UI1: swprintf(text, ARRAY_SIZE(text), L"%u", *(const BYTE *)p); break;
+    case VT_I2: swprintf(text, ARRAY_SIZE(text), L"%d", *(const SHORT *)p); break;
+    case VT_UI2: swprintf(text, ARRAY_SIZE(text), L"%u", *(const USHORT *)p); break;
+    case VT_BOOL: swprintf(text, ARRAY_SIZE(text), L"%d", *(const SHORT *)p); break;
+    case VT_I4: case VT_INT: swprintf(text, ARRAY_SIZE(text), L"%ld", *(const LONG *)p); break;
+    case VT_UI4: case VT_UINT: swprintf(text, ARRAY_SIZE(text), L"%lu", *(const ULONG *)p); break;
+    case VT_I8: swprintf(text, ARRAY_SIZE(text), L"%I64d", *(const LONGLONG *)p); break;
+    case VT_UI8: swprintf(text, ARRAY_SIZE(text), L"%I64u", *(const ULONGLONG *)p); break;
+    case VT_R4:
+        if (FAILED(hr = VarBstrFromR4( *(const float *)p, LOCALE_INVARIANT, 0, &bstr ))) return hr;
+        break;
+    case VT_R8:
+        if (FAILED(hr = VarBstrFromR8( *(const double *)p, LOCALE_INVARIANT, 0, &bstr ))) return hr;
+        break;
+    case VT_FILETIME:
+        if (!FileTimeToSystemTime( p, &st )) return E_FAIL;
+        swprintf(text, ARRAY_SIZE(text), L"%04d/%02d/%02d:%02d:%02d:%02d.%03d", st.wYear, st.wMonth, st.wDay,
+                 st.wHour, st.wMinute, st.wSecond, st.wMilliseconds);
+        break;
+    case VT_DATE:
+        if (!VariantTimeToSystemTime( *(const DATE *)p, &st )) return E_FAIL;
+#ifdef SG_MUTANT_PV_DATE_FMT
+        st.wMonth = st.wDay;
+#endif
+        swprintf(text, ARRAY_SIZE(text), L"%04d/%02d/%02d:%02d:%02d:%02d.%03d", st.wYear, st.wMonth, st.wDay,
+                 st.wHour, st.wMinute, st.wSecond, st.wMilliseconds);
+        break;
+    default:
+        return E_FAIL;
+    }
+
+    if (bstr)
+    {
+        *ret = CoTaskMemAlloc( (SysStringLen( bstr ) + 1) * sizeof(WCHAR) );
+        if (*ret) memcpy( *ret, bstr, (SysStringLen( bstr ) + 1) * sizeof(WCHAR) );
+        SysFreeString( bstr );
+    }
+    else
+    {
+        *ret = CoTaskMemAlloc( (wcslen( text ) + 1) * sizeof(WCHAR) );
+        if (*ret) wcscpy( *ret, text );
+    }
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+static UINT PROPVAR_ElementSize(VARTYPE vt)
+{
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1: return 1;
+    case VT_I2: case VT_UI2: case VT_BOOL: return 2;
+    case VT_I4: case VT_UI4: case VT_R4: return 4;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_FILETIME: case VT_DATE: return 8;
+    default: return 0;
+    }
+}
+
