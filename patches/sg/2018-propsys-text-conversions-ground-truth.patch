 {
     WCHAR *res = NULL;
     HRESULT hr = S_OK;
 
-    TRACE("%p,%p semi-stub\n", propvarIn, ret);
+    TRACE("%p,%p\n", propvarIn, ret);
+
+    if (propvarIn->vt & VT_VECTOR)
+    {
+        VARTYPE elem = propvarIn->vt & ~VT_VECTOR;
+        UINT size = PROPVAR_ElementSize( elem ), i;
+        const BYTE *data = (const BYTE *)propvarIn->caub.pElems;
+        SIZE_T total = 1;
+        WCHAR **parts;
+        WCHAR *out;
+
+        if (!size) { *ret = NULL; FIXME("Unsupported conversion (%d)\n", propvarIn->vt); return E_FAIL; }
+        if (!(parts = calloc( propvarIn->caub.cElems + 1, sizeof(*parts) ))) return E_OUTOFMEMORY;
+        for (i = 0; i < propvarIn->caub.cElems && SUCCEEDED(hr); i++)
+        {
+            if (SUCCEEDED(hr = PROPVAR_ScalarToString( elem, data + (SIZE_T)i * size, &parts[i] )))
+                total += wcslen( parts[i] ) + (i ? 2 : 0);
+        }
+        if (SUCCEEDED(hr) && (out = CoTaskMemAlloc( total * sizeof(WCHAR) )))
+        {
+            out[0] = 0;
+            for (i = 0; i < propvarIn->caub.cElems; i++)
+            {
+#ifdef SG_MUTANT_PV_VECTOR_SEP
+                if (i) wcscat( out, L", " );
+#else
+                if (i) wcscat( out, L"; " );
+#endif
+                wcscat( out, parts[i] );
+            }
+            res = out;
+        }
+        else if (SUCCEEDED(hr)) hr = E_OUTOFMEMORY;
+        for (i = 0; i < propvarIn->caub.cElems; i++) CoTaskMemFree( parts[i] );
+        free( parts );
+        *ret = res;
+        return hr;
+    }
 
     switch(propvarIn->vt)
     {
@@ -488,8 +614,19 @@
             break;
 
         default:
-            FIXME("Unsupported conversion (%d)\n", propvarIn->vt);
-            hr = E_FAIL;
+            if (PROPVAR_ElementSize( propvarIn->vt ) || propvarIn->vt == VT_INT || propvarIn->vt == VT_UINT)
+            {
+#ifdef SG_MUTANT_PV_NUMBERS
+                hr = E_FAIL;
+#else
+                hr = PROPVAR_ScalarToString( propvarIn->vt, &propvarIn->cVal, &res );
+#endif
+            }
+            else
+            {
+                FIXME("Unsupported conversion (%d)\n", propvarIn->vt);
+                hr = E_FAIL;
+            }
             break;
     }
 
