From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: error log entries.

IoAllocateErrorLogEntry returned NULL and IoWriteErrorLogEntry and
IoFreeErrorLogEntry were unimplemented exports. IoAllocateErrorLogEntry now
returns a packet for a device or driver object (NULL above
ERROR_LOG_MAXIMUM_SIZE), IoFreeErrorLogEntry frees an unused one and
IoWriteErrorLogEntry posts the packet to the event log, with the driver's
name as the source, the error code as the event id, its severity as the
type, the insertion strings and the dump data, and frees it.

Gate: test/ntoskrnl-errorlog-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1315,15 +1315,99 @@
 }
 
 
+struct error_log_entry
+{
+    void *io_object;
+    ULONG magic;
+    ULONG pad;  /* keeps the packet 8-byte aligned */
+    IO_ERROR_LOG_PACKET packet;
+};
+#define ERROR_LOG_ENTRY_MAGIC 0x45726c67
+
 /***********************************************************************
  *           IoAllocateErrorLogEntry  (NTOSKRNL.EXE.@)
  */
 PVOID WINAPI IoAllocateErrorLogEntry( PVOID IoObject, UCHAR EntrySize )
 {
-    FIXME( "stub: %p, %u\n", IoObject, EntrySize );
-    return NULL;
+    struct error_log_entry *entry;
+
+    TRACE( "%p, %u\n", IoObject, EntrySize );
+
+    if (!IoObject) return NULL;
+#ifndef SG_MUTANT_ERRORLOG_NO_SIZE_LIMIT
+    if (EntrySize > ERROR_LOG_MAXIMUM_SIZE) return NULL;
+#endif
+    if (!(entry = ExAllocatePool2( POOL_FLAG_NON_PAGED, offsetof(struct error_log_entry, packet) + max( EntrySize, sizeof(IO_ERROR_LOG_PACKET) ), 0 )))
+        return NULL;
+    entry->io_object = IoObject;
+    entry->magic = ERROR_LOG_ENTRY_MAGIC;
+    return &entry->packet;
+}
+
+/***********************************************************************
+ *           IoFreeErrorLogEntry  (NTOSKRNL.EXE.@)
+ */
+VOID WINAPI IoFreeErrorLogEntry( PVOID packet )
+{
+    struct error_log_entry *entry = CONTAINING_RECORD( packet, struct error_log_entry, packet );
+
+    TRACE( "%p\n", packet );
+
+    if (!packet) return;
+    entry->magic = 0;
+    ExFreePool( entry );
 }
 
+/***********************************************************************
+ *           IoWriteErrorLogEntry  (NTOSKRNL.EXE.@)
+ */
+VOID WINAPI IoWriteErrorLogEntry( PVOID packet )
+{
+    struct error_log_entry *entry = CONTAINING_RECORD( packet, struct error_log_entry, packet );
+    IO_ERROR_LOG_PACKET *p = packet;
+    DRIVER_OBJECT *driver;
+    const WCHAR *strings[64], *name, *str;
+    WCHAR source[MAX_PATH];
+    UNICODE_STRING *driver_name;
+    HANDLE log;
+    WORD type, i, count;
+
+    TRACE( "%p\n", packet );
+
+    if (!packet) return;
+    driver = *(CSHORT *)entry->io_object == IO_TYPE_DEVICE ? ((DEVICE_OBJECT *)entry->io_object)->DriverObject : entry->io_object;
+    driver_name = &driver->DriverName;
+    name = driver_name->Buffer;
+    if (name && !_wcsnicmp( name, L"\\Driver\\", 8 )) name += 8;
+    lstrcpynW( source, name ? name : L"Driver", ARRAY_SIZE(source) );
+
+    count = min( p->NumberOfStrings, ARRAY_SIZE(strings) );
+    str = (const WCHAR *)((char *)p + p->StringOffset);
+    for (i = 0; i < count; i++)
+    {
+        strings[i] = str;
+        str += wcslen( str ) + 1;
+    }
+
+    switch ((ULONG)p->ErrorCode >> 30)  /* the severity of the status */
+    {
+    case 2:  type = EVENTLOG_WARNING_TYPE; break;
+    case 3:  type = EVENTLOG_ERROR_TYPE; break;
+    default: type = EVENTLOG_INFORMATION_TYPE; break;
+    }
+
+#ifdef SG_MUTANT_ERRORLOG_NO_WRITE
+    if (0)
+#else
+    if ((log = RegisterEventSourceW( NULL, source )))
+#endif
+    {
+        ReportEventW( log, type, p->EventCategory, p->ErrorCode, NULL, count, p->DumpDataSize, strings,
+                      p->DumpDataSize ? p->DumpData : NULL );
+        DeregisterEventSource( log );
+    }
+    IoFreeErrorLogEntry( packet );
+}
 
 /***********************************************************************
  *           IoAllocateMdl  (NTOSKRNL.EXE.@)
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -393,7 +393,7 @@
 @ stub IoForwardAndCatchIrp
 @ stub IoForwardIrpSynchronously
 @ stub IoFreeController
-@ stub IoFreeErrorLogEntry
+@ stdcall IoFreeErrorLogEntry(ptr)
 @ stdcall IoFreeIrp(ptr)
 @ stdcall IoFreeMdl(ptr)
 @ stdcall IoFreeWorkItem(ptr)
@@ -518,7 +518,7 @@
 @ stub IoWMISetSingleItem
 @ stub IoWMISuggestInstanceName
 @ stub IoWMIWriteEvent
-@ stub IoWriteErrorLogEntry
+@ stdcall IoWriteErrorLogEntry(ptr)
 @ stub IoWriteOperationCount
 @ stub IoWritePartitionTableEx
 @ stub IoWriteTransferCount
diff --git a/include/ddk/wdm.h b/include/ddk/wdm.h
--- a/include/ddk/wdm.h
+++ b/include/ddk/wdm.h
@@ -123,6 +123,24 @@
   BOOLEAN  Busy;
 } KDEVICE_QUEUE, *PKDEVICE_QUEUE, *RESTRICTED_POINTER PRKDEVICE_QUEUE;
 
+#define ERROR_LOG_MAXIMUM_SIZE 152
+
+typedef struct _IO_ERROR_LOG_PACKET {
+  UCHAR MajorFunctionCode;
+  UCHAR RetryCount;
+  USHORT DumpDataSize;
+  USHORT NumberOfStrings;
+  USHORT StringOffset;
+  USHORT EventCategory;
+  NTSTATUS ErrorCode;
+  ULONG UniqueErrorValue;
+  NTSTATUS FinalStatus;
+  ULONG SequenceNumber;
+  ULONG IoControlCode;
+  LARGE_INTEGER DeviceOffset;
+  ULONG DumpData[1];
+} IO_ERROR_LOG_PACKET, *PIO_ERROR_LOG_PACKET;
+
 typedef struct _KMUTANT {
     DISPATCHER_HEADER Header;
     LIST_ENTRY MutantListEntry;
-- 
2.47.0
