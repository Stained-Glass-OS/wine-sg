From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: SymSrvStoreFile

SymSrvStoreFile(W) store a file in a symbol store laid out as symstore lays it out: <store>\<name>\<index>\<name>, the index being SymSrvGetFileIndexString's (8243); SYMSTOREOPT_POINTER writes a file.ptr naming the file instead of a copy, SYMSTOREOPT_RETURNINDEX gives only the index, an existing copy is refused (ERROR_ALREADY_EXISTS) unless overwritten or passed. The store is a directory or the first store of a srv* path, and gets its pingme.txt. They were spec stubs.
---
--- a/include/dbghelp.h
+++ b/include/dbghelp.h
@@ -1126,6 +1126,15 @@
 BOOL IMAGEAPI SymSrvGetFileIndexStringW(HANDLE, PCWSTR, PCWSTR, PWSTR, size_t, DWORD);
 BOOL IMAGEAPI SymSrvIsStore(HANDLE, PCSTR);
 BOOL IMAGEAPI SymSrvIsStoreW(HANDLE, PCWSTR);
+PCSTR IMAGEAPI SymSrvStoreFile(HANDLE, PCSTR, PCSTR, DWORD);
+PCWSTR IMAGEAPI SymSrvStoreFileW(HANDLE, PCWSTR, PCWSTR, DWORD);
+#define SYMSTOREOPT_COMPRESS        0x01
+#define SYMSTOREOPT_OVERWRITE       0x02
+#define SYMSTOREOPT_RETURNINDEX     0x04
+#define SYMSTOREOPT_POINTER         0x08
+#define SYMSTOREOPT_ALT_INDEX       0x10
+#define SYMSTOREOPT_UNICODE         0x20
+#define SYMSTOREOPT_PASS_IF_EXISTS  0x40
 
 typedef BOOL     (WINAPI* PSYMBOLSERVERPROC)(PCSTR, PCSTR, PVOID, DWORD, DWORD, PSTR);
 typedef BOOL     (WINAPI* PSYMBOLSERVERPROCA)(PCSTR, PCSTR, PVOID, DWORD, DWORD, PSTR);
--- a/dlls/dbghelp/path.c
+++ b/dlls/dbghelp/path.c
@@ -1120,3 +1120,113 @@
 BOOL WINAPI SymSrvIsStoreW(HANDLE p, const WCHAR *path) { return FALSE; }
 BOOL WINAPI SymSrvIsStore(HANDLE p, const char *path) { return FALSE; }
 #endif
+
+#ifndef SG_MUTANT_NO_SYMSRV_STORE
+/******************************************************************
+ *      SymSrvStoreFileW (DBGHELP.@)
+ *
+ * (wine-sg 8277) A file stored in a symbol store laid out as symstore lays it out: <store>\<name>\<index>\<name>,
+ * the index being SymSrvGetFileIndexString's; with SYMSTOREOPT_POINTER a <name>.ptr there naming the file
+ * instead of a copy; SYMSTOREOPT_RETURNINDEX only gives the index. The store is a directory, or a "srv*"
+ * path's first store; it gets the pingme.txt that marks a store. Compression is not done (the file is stored
+ * as it is).
+ */
+PCWSTR WINAPI SymSrvStoreFileW(HANDLE process, PCWSTR srv_path, PCWSTR file, DWORD flags)
+{
+    static WCHAR result[MAX_PATH];
+    WCHAR store[MAX_PATH], index[64], path[MAX_PATH], full[MAX_PATH];
+    const WCHAR *name, *start, *end;
+    DWORD attr;
+
+    TRACE("(%p, %s, %s, %#lx)\n", process, debugstr_w(srv_path), debugstr_w(file), flags);
+
+    if (!file || !srv_path || !*srv_path)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    if (!SymSrvGetFileIndexStringW(process, NULL, file, index, ARRAY_SIZE(index), 0)) return NULL;
+    if (flags & SYMSTOREOPT_RETURNINDEX)
+    {
+        wcscpy(result, index);
+        return result;
+    }
+    /* "srv*C:\store" or "srv*C:\cache*https://..." -> the first store after "srv*"; else the path itself */
+    start = srv_path;
+    if (!wcsnicmp(start, L"srv*", 4)) start += 4;
+    if (!(end = wcschr(start, '*'))) end = start + wcslen(start);
+    if (end == start || end - start >= MAX_PATH - 1)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    memcpy(store, start, (end - start) * sizeof(WCHAR));
+    store[end - start] = 0;
+    if (flags & SYMSTOREOPT_COMPRESS) FIXME("compression not supported, storing the file as it is\n");
+
+    if (!GetFullPathNameW(file, ARRAY_SIZE(full), full, NULL)) return NULL;
+    name = file_name(full);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\pingme.txt", store);
+    if (!CreateDirectoryW(store, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return NULL;
+    if (GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES)
+    {
+        HANDLE ping = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (ping != INVALID_HANDLE_VALUE) CloseHandle(ping);
+    }
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", store, name);
+    CreateDirectoryW(path, NULL);
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s\\%s", store, name, index);
+    CreateDirectoryW(path, NULL);
+    swprintf(result, ARRAY_SIZE(result), (flags & SYMSTOREOPT_POINTER) ? L"%s\\%s\\%s\\file.ptr" : L"%s\\%s\\%s\\%s",
+             store, name, index, name);
+
+    attr = GetFileAttributesW(result);
+    if (attr != INVALID_FILE_ATTRIBUTES && !(flags & SYMSTOREOPT_OVERWRITE))
+    {
+        if (flags & SYMSTOREOPT_PASS_IF_EXISTS) return result;
+        SetLastError(ERROR_ALREADY_EXISTS);
+        return NULL;
+    }
+    if (flags & SYMSTOREOPT_POINTER)
+    {
+        char text[MAX_PATH * 3];
+        HANDLE ptr;
+        DWORD len, done;
+        BOOL ok;
+
+        len = snprintf(text, 6, "PATH:");
+        len += WideCharToMultiByte(CP_ACP, 0, full, -1, text + len, sizeof(text) - len, NULL, NULL) - 1;
+        ptr = CreateFileW(result, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (ptr == INVALID_HANDLE_VALUE) return NULL;
+        ok = WriteFile(ptr, text, len, &done, NULL) && done == len;
+        CloseHandle(ptr);
+        return ok ? result : NULL;
+    }
+    if (!CopyFileW(full, result, FALSE)) return NULL;
+    return result;
+}
+
+/******************************************************************
+ *      SymSrvStoreFile (DBGHELP.@)
+ */
+PCSTR WINAPI SymSrvStoreFile(HANDLE process, PCSTR srv_path, PCSTR file, DWORD flags)
+{
+    static char result[MAX_PATH];
+    WCHAR srvW[MAX_PATH], fileW[MAX_PATH];
+    const WCHAR *ret;
+
+    if (!srv_path || !file)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    MultiByteToWideChar(CP_ACP, 0, srv_path, -1, srvW, ARRAY_SIZE(srvW));
+    MultiByteToWideChar(CP_ACP, 0, file, -1, fileW, ARRAY_SIZE(fileW));
+    if (!(ret = SymSrvStoreFileW(process, srvW, fileW, flags))) return NULL;
+    WideCharToMultiByte(CP_ACP, 0, ret, -1, result, sizeof(result), NULL, NULL);
+    return result;
+}
+#else
+PCWSTR WINAPI SymSrvStoreFileW(HANDLE process, PCWSTR srv_path, PCWSTR file, DWORD flags) { return NULL; }
+PCSTR WINAPI SymSrvStoreFile(HANDLE process, PCSTR srv_path, PCSTR file, DWORD flags) { return NULL; }
+#endif
--- a/dlls/dbghelp/dbghelp.spec
+++ b/dlls/dbghelp/dbghelp.spec
@@ -185,8 +185,8 @@
 @ stub SymSrvGetSupplementW
 @ stdcall SymSrvIsStore(ptr str)
 @ stdcall SymSrvIsStoreW(ptr wstr)
-@ stub SymSrvStoreFile
-@ stub SymSrvStoreFileW
+@ stdcall SymSrvStoreFile(ptr str str long)
+@ stdcall SymSrvStoreFileW(ptr wstr wstr long)
 @ stub SymSrvStoreSupplement
 @ stub SymSrvStoreSupplementW
 # @ stub SymSetSymWithAddr64 no longer present ??
