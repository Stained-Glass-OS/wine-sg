+    config_identity current;  /* of the <dependentAssembly> being read */
 } ConfigFileHandler;
 
 typedef struct
@@ -340,7 +342,12 @@ static ULONG WINAPI ConfigFileHandler_Release(ISAXContentHandler *iface)
     ULONG ref = InterlockedDecrement(&This->ref);
 
     if (ref == 0)
+    {
+        free(This->current.name);
+        free(This->current.token);
+        free(This->current.culture);
         free(This);
+    }
 
     return ref;
 }
@@ -394,6 +401,134 @@ static HRESULT parse_startup(ConfigFileHandler *This, ISAXAttributes *pAttr)
     return hr;
 }
 
+static WCHAR *get_attribute(ISAXAttributes *attrs, const WCHAR *name)
+{
+    const WCHAR *value;
+    int size;
+    WCHAR *ret;
+
+    if (FAILED(ISAXAttributes_getValueFromName(attrs, L"", 0, name, lstrlenW(name), &value, &size)) || !value)
+        return NULL;
+    if ((ret = malloc((size + 1) * sizeof(WCHAR))))
+    {
+        memcpy(ret, value, size * sizeof(WCHAR));
+        ret[size] = 0;
+    }
+    return ret;
+}
+
+static void free_identity(config_identity *id)
+{
+    free(id->name);
+    free(id->token);
+    free(id->culture);
+    memset(id, 0, sizeof(*id));
+}
+
+static BOOL copy_identity(config_identity *dst, const config_identity *src)
+{
+    memset(dst, 0, sizeof(*dst));
+    if (!(dst->name = wcsdup(src->name))) return FALSE;
+    if (src->token && !(dst->token = wcsdup(src->token))) return FALSE;
+    if (src->culture && !(dst->culture = wcsdup(src->culture))) return FALSE;
+    return TRUE;
+}
+
+/* "1.2.3.4" (missing parts are 0); the end of what was read in *end */
+static BOOL parse_version(const WCHAR *str, WORD version[4], const WCHAR **end)
+{
+    int i;
+
+    memset(version, 0, 4 * sizeof(WORD));
+    for (i = 0; i < 4; i++)
+    {
+        unsigned long part;
+        WCHAR *next;
+
+        while (*str == ' ') str++;
+        if (*str < '0' || *str > '9') return FALSE;
+        part = wcstoul(str, &next, 10);
+        if (part > 0xffff) return FALSE;
+        version[i] = part;
+        str = next;
+        if (*str != '.') break;
+        str++;
+    }
+    while (*str == ' ') str++;
+    if (end) *end = str;
+    return TRUE;
+}
+
+static void parse_assembly_identity(ConfigFileHandler *This, ISAXAttributes *attrs)
+{
+    free_identity(&This->current);
+    This->current.name = get_attribute(attrs, L"name");
+    This->current.token = get_attribute(attrs, L"publicKeyToken");
+    This->current.culture = get_attribute(attrs, L"culture");
+    TRACE("dependent assembly %s token %s culture %s\n", debugstr_w(This->current.name),
+          debugstr_w(This->current.token), debugstr_w(This->current.culture));
+}
+
+static void parse_binding_redirect(ConfigFileHandler *This, ISAXAttributes *attrs)
+{
+    WCHAR *old = get_attribute(attrs, L"oldVersion"), *new = get_attribute(attrs, L"newVersion");
+    config_redirect *entry = NULL;
+    const WCHAR *end;
+
+    if (!This->current.name || !old || !new) goto done;
+    if (!(entry = calloc(1, sizeof(*entry)))) goto done;
+    if (!parse_version(old, entry->old_low, &end)) goto bad;
+    if (*end == '-')
+    {
+        if (!parse_version(end + 1, entry->old_high, &end) || *end) goto bad;
+    }
+    else if (*end) goto bad;
+    else memcpy(entry->old_high, entry->old_low, sizeof(entry->old_high));
+    if (!parse_version(new, entry->new_version, &end) || *end) goto bad;
+    if (!copy_identity(&entry->id, &This->current)) goto bad;
+    TRACE("redirect %s %s -> %s\n", debugstr_w(entry->id.name), debugstr_w(old), debugstr_w(new));
+    list_add_tail(&This->result->redirects, &entry->entry);
+    entry = NULL;
+    goto done;
+bad:
+    WARN("bad bindingRedirect %s -> %s for %s\n", debugstr_w(old), debugstr_w(new), debugstr_w(This->current.name));
+    free_identity(&entry->id);
+    free(entry);
+    entry = NULL;
+done:
+    free(entry);
+    free(old);
+    free(new);
+}
+
+static void parse_codebase(ConfigFileHandler *This, ISAXAttributes *attrs)
+{
+    WCHAR *version = get_attribute(attrs, L"version"), *href = get_attribute(attrs, L"href");
+    config_codebase *entry;
+    const WCHAR *end;
+
+    if (This->current.name && href && (entry = calloc(1, sizeof(*entry))))
+    {
+        /* a codeBase without a version is only allowed for an assembly without a strong name */
+        if ((version ? parse_version(version, entry->version, &end) && !*end : !This->current.token) &&
+            copy_identity(&entry->id, &This->current))
+        {
+            TRACE("codebase %s %s -> %s\n", debugstr_w(entry->id.name), debugstr_w(version), debugstr_w(href));
+            entry->href = href;
+            href = NULL;
+            list_add_tail(&This->result->codebases, &entry->entry);
+        }
+        else
+        {
+            WARN("bad codeBase %s %s for %s\n", debugstr_w(version), debugstr_w(href), debugstr_w(This->current.name));
+            free_identity(&entry->id);
+            free(entry);
+        }
+    }
+    free(version);
+    free(href);
+}
+
 static HRESULT parse_probing(ConfigFileHandler *This, ISAXAttributes *pAttr)
 {
     static const WCHAR privatePath[] = {'p','r','i','v','a','t','e','P','a','t','h',0};
@@ -524,8 +659,24 @@ static HRESULT WINAPI ConfigFileHandler_startElement(ISAXContentHandler *iface,
             This->states[++This->statenum] = STATE_PROBING;
             break;
         }
+#ifndef SG_MUTANT_NO_CODEBASE
+        else if (nLocalName == 17 && !wcsncmp(pLocalName, L"dependentAssembly", 17))
+        {
+            free_identity(&This->current);
+            This->states[++This->statenum] = STATE_DEPENDENT_ASSEMBLY;
+            break;
+        }
+#endif
         else
             goto unknown;
+    case STATE_DEPENDENT_ASSEMBLY:
+        if (nLocalName == 16 && !wcsncmp(pLocalName, L"assemblyIdentity", 16))
+            parse_assembly_identity(This, pAttr);
+        else if (nLocalName == 15 && !wcsncmp(pLocalName, L"bindingRedirect", 15))
+            parse_binding_redirect(This, pAttr);
+        else if (nLocalName == 8 && !wcsncmp(pLocalName, L"codeBase", 8))
+            parse_codebase(This, pAttr);
+        goto unknown;
     case STATE_STARTUP:
         if (nLocalName == ARRAY_SIZE(supportedRuntime) - 1 &&
             wcscmp(pLocalName, supportedRuntime) == 0)
@@ -562,6 +713,8 @@ static HRESULT WINAPI ConfigFileHandler_endElement(ISAXContentHandler *iface,
 
     if (This->statenum > 0)
     {
+        if (This->states[This->statenum] == STATE_DEPENDENT_ASSEMBLY)
+            free_identity(&This->current);
         This->statenum--;
     }
     else
@@ -673,6 +826,8 @@ static void init_config(parsed_config_file *config)
     list_init(&config->supported_runtimes);
     config->legacy_v2_policy = FALSE;
     config->private_path = NULL;
+    list_init(&config->redirects);
+    list_init(&config->codebases);
 }
 
 static HRESULT parse_config(VARIANT input, parsed_config_file *result)
@@ -681,7 +836,7 @@ static HRESULT parse_config(VARIANT input, parsed_config_file *result)
     ConfigFileHandler *handler;
     HRESULT hr;
 
-    handler = malloc(sizeof(ConfigFileHandler));
+    handler = calloc(1, sizeof(ConfigFileHandler));
     if (!handler)
         return E_OUTOFMEMORY;
 
@@ -763,4 +918,24 @@ void free_parsed_config_file(parsed_config_file *file)
     }
 
     free(file->private_path);
+    file->private_path = NULL;
+
+    {
+        config_redirect *redirect, *next_redirect;
+        config_codebase *codebase, *next_codebase;
+
+        LIST_FOR_EACH_ENTRY_SAFE(redirect, next_redirect, &file->redirects, config_redirect, entry)
+        {
+            list_remove(&redirect->entry);
+            free_identity(&redirect->id);
+            free(redirect);
+        }
+        LIST_FOR_EACH_ENTRY_SAFE(codebase, next_codebase, &file->codebases, config_codebase, entry)
+        {
+            list_remove(&codebase->entry);
+            free_identity(&codebase->id);
+            free(codebase->href);
+            free(codebase);
+        }
+    }
 }
