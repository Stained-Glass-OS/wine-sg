 }
 
+static BOOL identity_matches(const config_identity *id, const WCHAR *name, const WCHAR *token, const WCHAR *culture)
+{
+    if (wcsicmp(id->name, name)) return FALSE;
+    if (id->token && wcsicmp(id->token, token ? token : L"null")) return FALSE;
+    if (id->culture && wcsicmp(id->culture, L"neutral") && wcsicmp(id->culture, culture ? culture : L"")) return FALSE;
+    return TRUE;
+}
+
+static int compare_version(const WORD *a, const WORD *b)
+{
+    int i;
+    for (i = 0; i < 4; i++) if (a[i] != b[i]) return a[i] < b[i] ? -1 : 1;
+    return 0;
+}
+
+/* an assembly the configuration of the default domain names a <codeBase> for, at the version its
+ * <bindingRedirect>s bind the reference to: the CLR loads it from there before probing */
+MonoAssembly *load_from_codebase(MonoAssemblyName *aname, const char *stringname)
+{
+    WCHAR name[256], token[32] = {0}, culture[64] = {0}, path[MAX_PATH * 2];
+    const char *aculture = mono_assembly_name_get_culture(aname), *p;
+    domain_binding *binding = default_domain_binding;
+    config_redirect *redirect;
+    config_codebase *codebase;
+    WORD version[4];
+    DWORD len;
+    int i;
+
+    if (!binding) return NULL;
+    if (!MultiByteToWideChar(CP_UTF8, 0, mono_assembly_name_get_name(aname), -1, name, ARRAY_SIZE(name))) return NULL;
+    if (aculture) MultiByteToWideChar(CP_UTF8, 0, aculture, -1, culture, ARRAY_SIZE(culture));
+    if (stringname && (p = strstr(stringname, "PublicKeyToken=")))
+    {
+        p += 15;
+        for (i = 0; i < ARRAY_SIZE(token) - 1 && p[i] && p[i] != ',' && p[i] != ' '; i++) token[i] = p[i];
+        token[i] = 0;
+    }
+    version[0] = mono_assembly_name_get_version(aname, &version[1], &version[2], &version[3]);
+
+    LIST_FOR_EACH_ENTRY(redirect, &binding->config.redirects, config_redirect, entry)
+    {
+        if (!identity_matches(&redirect->id, name, token[0] ? token : NULL, culture)) continue;
+        if (compare_version(version, redirect->old_low) < 0 || compare_version(version, redirect->old_high) > 0) continue;
+        TRACE("%s %u.%u.%u.%u redirected to %u.%u.%u.%u\n", debugstr_w(name), version[0], version[1], version[2],
+              version[3], redirect->new_version[0], redirect->new_version[1], redirect->new_version[2],
+              redirect->new_version[3]);
+        memcpy(version, redirect->new_version, sizeof(version));
+        break;
+    }
+
+    LIST_FOR_EACH_ENTRY(codebase, &binding->config.codebases, config_codebase, entry)
+    {
+        MonoAssembly *result;
+
+        if (!identity_matches(&codebase->id, name, token[0] ? token : NULL, culture)) continue;
+        if (codebase->id.token && compare_version(version, codebase->version)) continue;
+
+        if (!wcsnicmp(codebase->href, L"file:", 5))
+        {
+            len = ARRAY_SIZE(path);
+            if (FAILED(PathCreateFromUrlW(codebase->href, path, &len, 0))) continue;
+        }
+        else if (wcsstr(codebase->href, L"://"))
+        {
+            FIXME("code base %s for %s is not on a disk\n", debugstr_w(codebase->href), debugstr_w(name));
+            continue;
+        }
+        else
+        {
+            WCHAR *c;
+
+            if (PathIsRelativeW(codebase->href))
+            {
+                if (wcslen(binding->base_dir) + wcslen(codebase->href) >= ARRAY_SIZE(path)) continue;
+                wcscpy(path, binding->base_dir);
+                wcscat(path, codebase->href);
+            }
+            else
+            {
+                if (wcslen(codebase->href) >= ARRAY_SIZE(path)) continue;
+                wcscpy(path, codebase->href);
+            }
+            for (c = path; *c; c++) if (*c == '/') *c = '\\';
+        }
+
+        TRACE("%s: code base %s\n", debugstr_a(stringname), debugstr_w(path));
+        if ((result = mono_assembly_try_load(path))) return result;
+    }
+    return NULL;
+}
+
 static MonoAssembly* CDECL mono_assembly_preload_hook_fn(MonoAssemblyName *aname, char **assemblies_path, void *user_data)
 {
     int flags = 0;
@@ -2228,6 +2333,8 @@ static MonoAssembly* CDECL wine_mono_assembly_preload_hook_v2_fn(MonoAssemblyNam
     if (!stringname || !assemblyname) return NULL;
 
     search_flags = get_assembly_search_flags(aname);
+    if ((search_flags & ASSEMBLY_SEARCH_PRIVATEPATH) != 0 && (result = load_from_codebase(aname, stringname)))
+        goto done;
     if (private_path && (search_flags & ASSEMBLY_SEARCH_PRIVATEPATH) != 0)
