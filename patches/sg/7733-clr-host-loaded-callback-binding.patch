+/* the assembly binding of an application configuration file, as the CLR uses it for the default
+ * domain of a managed program and of a native program that hosts the runtime: <probing privatePath>
+ * (directories under the application base, the directory of base_file, where assemblies are looked
+ * for) and the <dependentAssembly> binding redirects and code bases */
+static void set_private_path_from_config(const WCHAR *config_file, const WCHAR *base_file)
+{
+    static LONG done;
+    parsed_config_file parsed_config;
+    WCHAR *temp, *save, **priv_path;
+    SIZE_T base_dir_size;
+    const WCHAR *slash;
+    int i, count = 0;
+
+    if (!config_file || !base_file) return;
+    if (!(slash = wcsrchr(base_file, '\\'))) return;
+    base_dir_size = slash - base_file + 1;
+    if (base_dir_size >= MAX_PATH) return;
+    if (InterlockedExchange(&done, 1)) return;
+
+    if (FAILED(parse_config_file(config_file, &parsed_config))) goto done;
+
+    if (!list_empty(&parsed_config.codebases) || !list_empty(&parsed_config.redirects))
+    {
+        domain_binding *binding;
+
+        if ((binding = calloc(1, sizeof(*binding))))
+        {
+            memcpy(binding->base_dir, base_file, base_dir_size * sizeof(WCHAR));
+            binding->base_dir[base_dir_size] = 0;
+            list_init(&binding->config.supported_runtimes);
+            list_init(&binding->config.redirects);
+            list_init(&binding->config.codebases);
+            list_move_tail(&binding->config.redirects, &parsed_config.redirects);
+            list_move_tail(&binding->config.codebases, &parsed_config.codebases);
+            TRACE("binding configuration from %s, base %s\n", debugstr_w(config_file), debugstr_w(binding->base_dir));
+            if (InterlockedCompareExchangePointer((void **)&default_domain_binding, binding, NULL))
+            {
+                free_parsed_config_file(&binding->config);
+                free(binding);
+            }
+        }
+    }
+
+    if (private_path) goto done;
+    if (parsed_config.private_path && parsed_config.private_path[0])
+    {
+        for (i = 0; parsed_config.private_path[i]; i++)
+            if (parsed_config.private_path[i] == ';') count++;
+        if (parsed_config.private_path[wcslen(parsed_config.private_path) - 1] != ';') count++;
+        if ((priv_path = calloc(count + 1, sizeof(WCHAR *))))
+        {
+            /* wcstok ignores trailing semicolons */
+            temp = wcstok_s(parsed_config.private_path, L";", &save);
+            for (i = 0; i < count && temp; i++)
+            {
+                if (!(priv_path[i] = malloc((base_dir_size + wcslen(temp) + 1) * sizeof(WCHAR)))) break;
+                memcpy(priv_path[i], base_file, base_dir_size * sizeof(WCHAR));
+                wcscpy(priv_path[i] + base_dir_size, temp);
+                TRACE("private path %s\n", debugstr_w(priv_path[i]));
+                temp = wcstok_s(NULL, L";", &save);
+            }
+            if (InterlockedCompareExchangePointer((void **)&private_path, priv_path, NULL))
+            {
+                for (i = 0; priv_path[i]; i++) free(priv_path[i]);
+                free(priv_path);
+            }
+        }
+    }
+done:
+    free_parsed_config_file(&parsed_config);
+}
+
