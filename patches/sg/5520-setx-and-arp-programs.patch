From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setx and arp: the command line tools do what their documentation says

setx was a stub that logged and exited 0, so scripts believed their
environment variables were set. It now has the command line mode (setx NAME
VALUE [/m]) and registry mode (setx NAME /k HKEY_...\Key\Value [/m]) the
documentation describes: HKCU\Environment or the system environment, a
value over 1024 characters cut with a warning, a variable stored with
references keeping REG_EXPAND_SZ, REG_DWORD values used in hexadecimal and
REG_EXPAND_SZ expanded, a WM_SETTINGCHANGE broadcast, and exit code 1 for
syntax errors and the forms it does not offer (remote /s, file mode /f).

arp was a stub that printed nothing. arp -a / -g lists the table from
GetIpNetTable by interface (with -N, an address and -v as documented), -s
adds a static entry and -d deletes entries through CreateIpNetEntry and
DeleteIpNetEntry, so the system decides who may change the table.
---
--- a/programs/arp/Makefile.in
+++ b/programs/arp/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = arp.exe
+IMPORTS   = iphlpapi ws2_32
 
 EXTRADLLFLAGS = -mconsole -municode
 
--- a/programs/arp/main.c
+++ b/programs/arp/main.c
@@ -16,18 +16,310 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
-#include "wine/debug.h"
+/* arp: -a / -g display the ARP table by interface, -s adds a static entry,
+ * -d deletes entries, as the documentation of the command describes them.
+ * The table comes from GetIpNetTable and changes go through CreateIpNetEntry
+ * and DeleteIpNetEntry, so what the system lets a caller change is decided
+ * there. */
 
-WINE_DEFAULT_DEBUG_CHANNEL(arp);
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <iphlpapi.h>
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+static void usage(void)
+{
+    wprintf(L"\nDisplays and modifies the IP-to-Physical address translation tables used by\n"
+            L"address resolution protocol (ARP).\n\n"
+            L"ARP -s inet_addr eth_addr [if_addr]\n"
+            L"ARP -d inet_addr [if_addr]\n"
+            L"ARP -a [inet_addr] [-N if_addr] [-v]\n\n"
+            L"  -a            Displays current ARP entries by interrogating the current\n"
+            L"                protocol data.  If inet_addr is specified, the IP and Physical\n"
+            L"                addresses for only the specified computer are displayed.  If\n"
+            L"                more than one network interface uses ARP, entries for each ARP\n"
+            L"                table are displayed.\n"
+            L"  -g            Same as -a.\n"
+            L"  -v            Displays current ARP entries in verbose mode.  All invalid\n"
+            L"                entries and entries on the loop-back interface will be shown.\n"
+            L"  inet_addr     Specifies an internet address.\n"
+            L"  -N if_addr    Displays the ARP entries for the network interface specified\n"
+            L"                by if_addr.\n"
+            L"  -d            Deletes the host specified by inet_addr. inet_addr may be\n"
+            L"                wildcarded with * to delete all hosts.\n"
+            L"  -s            Adds the host and associates the Internet address inet_addr\n"
+            L"                with the Physical address eth_addr.  The Physical address is\n"
+            L"                given as 6 hexadecimal bytes separated by hyphens. The entry\n"
+            L"                is permanent.\n"
+            L"  eth_addr      Specifies a physical address.\n"
+            L"  if_addr       If present, this specifies the Internet address of the\n"
+            L"                interface whose address translation table should be modified.\n"
+            L"                If not present, the first applicable interface will be used.\n");
+}
+
+static int fail(const WCHAR *message)
+{
+    fwprintf(stderr, L"%ls\n", message);
+    return 1;
+}
+
+static BOOL parse_ip(const WCHAR *text, DWORD *addr)
+{
+    char narrow[32];
+    unsigned int i;
+
+    for (i = 0; text[i] && i < sizeof(narrow) - 1; i++) narrow[i] = text[i] < 128 ? text[i] : '?';
+    narrow[i] = 0;
+    return !text[i] && inet_pton(AF_INET, narrow, addr) == 1;
+}
+
+static void format_ip(DWORD addr, WCHAR *out, DWORD size)
+{
+    swprintf(out, size, L"%u.%u.%u.%u", addr & 0xff, (addr >> 8) & 0xff, (addr >> 16) & 0xff, addr >> 24);
+}
+
+static MIB_IPNETTABLE *get_net_table(void)
+{
+    MIB_IPNETTABLE *table = NULL;
+    DWORD size = 0, ret;
+
+    for (;;)
+    {
+        ret = GetIpNetTable(table, &size, TRUE);
+        if (!ret) return table;
+        free(table);
+        table = NULL;
+        if (ret != ERROR_INSUFFICIENT_BUFFER || !(table = malloc(size))) return NULL;
+    }
+}
+
+static MIB_IPADDRTABLE *get_addr_table(void)
+{
+    MIB_IPADDRTABLE *table = NULL;
+    DWORD size = 0, ret;
+
+    for (;;)
+    {
+        ret = GetIpAddrTable(table, &size, TRUE);
+        if (!ret) return table;
+        free(table);
+        table = NULL;
+        if (ret != ERROR_INSUFFICIENT_BUFFER || !(table = malloc(size))) return NULL;
+    }
+}
+
+/* the first IPv4 address of an interface, 0 if it has none */
+static DWORD interface_address(const MIB_IPADDRTABLE *addrs, DWORD index)
+{
+    DWORD i;
+
+    for (i = 0; i < addrs->dwNumEntries; i++)
+        if (addrs->table[i].dwIndex == index && addrs->table[i].dwAddr) return addrs->table[i].dwAddr;
+    return 0;
+}
+
+static const WCHAR *type_name(DWORD type)
+{
+    switch (type)
+    {
+    case MIB_IPNET_TYPE_DYNAMIC: return L"dynamic";
+    case MIB_IPNET_TYPE_STATIC:
+#ifdef SG_MUTANT_ARP_NOTYPE
+        return L"dynamic";
+#endif
+        return L"static";
+    case MIB_IPNET_TYPE_INVALID: return L"invalid";
+    default: return L"other";
+    }
+}
+
+static int display(DWORD only_addr, DWORD only_if_addr, BOOL verbose)
 {
-    int i;
+    MIB_IPNETTABLE *nets = get_net_table();
+    MIB_IPADDRTABLE *addrs = get_addr_table();
+    DWORD i, j, index, shown = 0, if_addr;
+    BOOL header;
+    WCHAR ip[32], if_ip[32], mac[32];
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+    if (!addrs) return fail(L"ARP: GetIpAddrTable failed");
+    for (i = 0; i < addrs->dwNumEntries; i++)
+    {
+        index = addrs->table[i].dwIndex;
+        if_addr = interface_address(addrs, index);
+        if (!if_addr || addrs->table[i].dwAddr != if_addr) continue;   /* once per interface */
+#ifndef SG_MUTANT_ARP_ALLIFS
+        if (only_if_addr && if_addr != only_if_addr) continue;
+#endif
+        if ((if_addr & 0xff) == 127 && !verbose) continue;
 
+        header = FALSE;
+        for (j = 0; nets && j < nets->dwNumEntries; j++)
+        {
+            const MIB_IPNETROW *row = &nets->table[j];
+
+            if (row->dwIndex != index) continue;
+            if (only_addr && row->dwAddr != only_addr) continue;
+            if (row->dwType == MIB_IPNET_TYPE_INVALID && !verbose) continue;
+            if (!header)
+            {
+                format_ip(if_addr, if_ip, ARRAY_SIZE(if_ip));
+                wprintf(L"\nInterface: %ls --- 0x%lx\n  Internet Address      Physical Address      Type\n", if_ip, index);
+                header = TRUE;
+            }
+            format_ip(row->dwAddr, ip, ARRAY_SIZE(ip));
+            if (row->dwPhysAddrLen == 6)
+                swprintf(mac, ARRAY_SIZE(mac), L"%02x-%02x-%02x-%02x-%02x-%02x", row->bPhysAddr[0], row->bPhysAddr[1],
+                         row->bPhysAddr[2], row->bPhysAddr[3], row->bPhysAddr[4], row->bPhysAddr[5]);
+            else mac[0] = 0;
+            wprintf(L"  %-22ls%-22ls%ls\n", ip, mac, type_name(row->dwType));
+            shown++;
+        }
+    }
+    free(nets);
+    free(addrs);
+    if (!shown) wprintf(L"No ARP Entries Found.\n");
+    return 0;
+}
+
+static BOOL parse_mac(const WCHAR *text, BYTE *mac)
+{
+    unsigned int v[6];
+    char narrow[32];
+    unsigned int i;
+    char tail;
+
+    for (i = 0; text[i] && i < sizeof(narrow) - 1; i++) narrow[i] = text[i] < 128 ? text[i] : '?';
+    narrow[i] = 0;
+    if (text[i] || sscanf(narrow, "%2x-%2x-%2x-%2x-%2x-%2x%c", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &tail) != 6)
+        return FALSE;
+    for (i = 0; i < 6; i++) mac[i] = v[i];
+    return TRUE;
+}
+
+/* the interface index of an address given as if_addr; else the first one that is
+ * not the loopback and whose subnet holds inet_addr, else the first one */
+static DWORD pick_interface(const MIB_IPADDRTABLE *addrs, DWORD if_addr, DWORD inet)
+{
+    DWORD i, first = 0;
+
+    for (i = 0; i < addrs->dwNumEntries; i++)
+    {
+        const MIB_IPADDRROW *row = &addrs->table[i];
+
+        if (!row->dwAddr) continue;
+        if (if_addr) { if (row->dwAddr == if_addr) return row->dwIndex; continue; }
+        if ((row->dwAddr & 0xff) == 127) continue;
+        if (!first) first = row->dwIndex;
+        if ((row->dwAddr & row->dwMask) == (inet & row->dwMask)) return row->dwIndex;
+    }
+    return first;
+}
+
+static int add_entry(DWORD inet, const BYTE *mac, DWORD if_addr)
+{
+    MIB_IPADDRTABLE *addrs = get_addr_table();
+    MIB_IPNETROW row = {0};
+    DWORD ret;
+    WCHAR msg[64];
+
+    if (!addrs) return fail(L"ARP: GetIpAddrTable failed");
+    row.dwIndex = pick_interface(addrs, if_addr, inet);
+    free(addrs);
+    if (!row.dwIndex) return fail(L"ARP: bad interface address");
+    row.dwPhysAddrLen = 6;
+    memcpy(row.bPhysAddr, mac, 6);
+    row.dwAddr = inet;
+    row.dwType = MIB_IPNET_TYPE_STATIC;
+    if ((ret = CreateIpNetEntry(&row)))
+    {
+        swprintf(msg, ARRAY_SIZE(msg), L"The ARP entry addition failed: %lu", ret);
+        return fail(msg);
+    }
     return 0;
 }
+
+static int delete_entries(BOOL all, DWORD inet, DWORD if_addr)
+{
+    MIB_IPNETTABLE *nets = get_net_table();
+    MIB_IPADDRTABLE *addrs = get_addr_table();
+    DWORD i, index = 0, ret, found = 0;
+    WCHAR msg[64];
+    int result = 0;
+
+    if (!addrs) return fail(L"ARP: GetIpAddrTable failed");
+    if (if_addr && !(index = pick_interface(addrs, if_addr, 0))) result = fail(L"ARP: bad interface address");
+    free(addrs);
+    for (i = 0; !result && nets && i < nets->dwNumEntries; i++)
+    {
+        MIB_IPNETROW *row = &nets->table[i];
+
+        if (index && row->dwIndex != index) continue;
+        if (!all && row->dwAddr != inet) continue;
+        if (row->dwType == MIB_IPNET_TYPE_INVALID) continue;
+        found++;
+        if ((ret = DeleteIpNetEntry(row)))
+        {
+            swprintf(msg, ARRAY_SIZE(msg), L"The ARP entry deletion failed: %lu", ret);
+            result = fail(msg);
+        }
+    }
+    free(nets);
+    if (!result && !found && !all) return fail(L"The specified entry was not found.");
+    return result;
+}
+
+int __cdecl wmain(int argc, WCHAR *argv[])
+{
+    DWORD inet = 0, if_addr = 0;
+    BYTE mac[6];
+    BOOL verbose = FALSE;
+    int i = 1;
+
+    if (argc < 2 || !wcscmp(argv[1], L"/?") || !wcscmp(argv[1], L"-?"))
+    {
+        usage();
+        return argc < 2 ? 1 : 0;
+    }
+
+    if (!wcsicmp(argv[1], L"-a") || !wcsicmp(argv[1], L"-g"))
+    {
+        for (i = 2; i < argc; i++)
+        {
+            if (!wcscmp(argv[i], L"-v")) verbose = TRUE;
+            else if (!wcscmp(argv[i], L"-N"))
+            {
+                if (++i >= argc || !parse_ip(argv[i], &if_addr)) return fail(L"ARP: bad argument -N");
+            }
+            else if (!inet)
+            {
+                if (!parse_ip(argv[i], &inet)) return fail(L"ARP: bad IP address");
+            }
+            else return fail(L"ARP: bad argument");
+        }
+        return display(inet, if_addr, verbose);
+    }
+
+    if (!wcsicmp(argv[1], L"-s"))
+    {
+        if (argc < 4 || argc > 5) return fail(L"ARP: bad argument count");
+        if (!parse_ip(argv[2], &inet)) return fail(L"ARP: bad IP address");
+        if (!parse_mac(argv[3], mac)) return fail(L"ARP: bad argument");
+        if (argc == 5 && !parse_ip(argv[4], &if_addr)) return fail(L"ARP: bad IP address");
+        return add_entry(inet, mac, if_addr);
+    }
+
+    if (!wcsicmp(argv[1], L"-d"))
+    {
+        BOOL all = argc > 2 && !wcscmp(argv[2], L"*");
+
+        if (argc < 3 || argc > 4) return fail(L"ARP: bad argument count");
+        if (!all && !parse_ip(argv[2], &inet)) return fail(L"ARP: bad IP address");
+        if (argc == 4 && !parse_ip(argv[3], &if_addr)) return fail(L"ARP: bad IP address");
+        return delete_entries(all, inet, if_addr);
+    }
+
+    return fail(L"ARP: bad argument");
+}
--- a/programs/setx/Makefile.in
+++ b/programs/setx/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = setx.exe
+IMPORTS   = user32 advapi32
 
 EXTRADLLFLAGS = -mconsole -municode
 
--- a/programs/setx/main.c
+++ b/programs/setx/main.c
@@ -16,18 +16,206 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
-#include "wine/debug.h"
+/* setx: command line mode and registry mode, as the documentation of the
+ * command describes them (the parameters, /m, /k, the 1024 characters limit).
+ * File mode (/f with /a, /r, /x, /d) needs the coordinates of a text file,
+ * which the documentation does not define well enough to implement. */
 
-WINE_DEFAULT_DEBUG_CHANNEL(setx);
+#include <stdio.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include <windows.h>
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+#define MAX_VALUE_LEN 1024
+
+static const WCHAR user_env_key[] = L"Environment";
+static const WCHAR machine_env_key[] = L"System\\CurrentControlSet\\Control\\Session Manager\\Environment";
+
+static void err(const WCHAR *message)
+{
+    fwprintf(stderr, L"%ls\n", message);
+}
+
+static int usage_error(void)
+{
+    err(L"ERROR: Invalid syntax.");
+    err(L"Type \"SETX /?\" for usage.");
+    return 1;
+}
+
+static BOOL is_switch(const WCHAR *arg, WCHAR letter)
+{
+    return (arg[0] == '/' || arg[0] == '-') && arg[1] && !arg[2] && towlower(arg[1]) == letter;
+}
+
+/* The value a "\HIVE\KEY\...\Value" path names; HKEY_CURRENT_USER and
+ * HKEY_LOCAL_MACHINE are the only hives the command supports. */
+static WCHAR *read_registry_path(const WCHAR *path)
+{
+    static const struct { const WCHAR *name; HKEY root; } hives[] =
+    {
+        { L"HKEY_CURRENT_USER", HKEY_CURRENT_USER }, { L"HKCU", HKEY_CURRENT_USER },
+        { L"HKEY_LOCAL_MACHINE", HKEY_LOCAL_MACHINE }, { L"HKLM", HKEY_LOCAL_MACHINE },
+    };
+    WCHAR *copy, *key, *value_name, *result = NULL, *expanded;
+    DWORD type, size, i, len;
+    HKEY root = NULL, hkey;
+    BYTE *data;
+
+    while (*path == '\\') path++;
+    if (!(copy = wcsdup(path))) return NULL;
+    if (!(key = wcschr(copy, '\\')))
+    {
+        free(copy);
+        return NULL;
+    }
+    *key++ = 0;
+    for (i = 0; i < ARRAY_SIZE(hives); i++)
+        if (!wcsicmp(copy, hives[i].name)) root = hives[i].root;
+    if (!root || !(value_name = wcsrchr(key, '\\')))
+    {
+        free(copy);
+        return NULL;
+    }
+    *value_name++ = 0;
+
+    if (RegOpenKeyExW(root, key, 0, KEY_QUERY_VALUE, &hkey))
+    {
+        free(copy);
+        return NULL;
+    }
+    size = 0;
+    if (!RegQueryValueExW(hkey, value_name, NULL, &type, NULL, &size) && (data = malloc(size + 2 * sizeof(WCHAR))))
+    {
+        if (!RegQueryValueExW(hkey, value_name, NULL, &type, data, &size))
+        {
+            memset(data + size, 0, 2 * sizeof(WCHAR));
+            switch (type)
+            {
+            case REG_SZ:
+            case REG_MULTI_SZ:   /* only the first item is used */
+                result = wcsdup((WCHAR *)data);
+                break;
+            case REG_EXPAND_SZ:
+                len = ExpandEnvironmentStringsW((WCHAR *)data, NULL, 0);
+                if ((expanded = malloc(len * sizeof(WCHAR))))
+                {
+                    ExpandEnvironmentStringsW((WCHAR *)data, expanded, len);
+                    result = expanded;
+                }
+                break;
+            case REG_DWORD:   /* used in hexadecimal */
+                if (size >= sizeof(DWORD) && (result = malloc(16 * sizeof(WCHAR))))
+                    swprintf(result, 16, L"0x%lx", *(DWORD *)data);
+                break;
+            }
+        }
+        free(data);
+    }
+    RegCloseKey(hkey);
+    free(copy);
+    return result;
+}
+
+static int save_variable(const WCHAR *name, const WCHAR *value, BOOL machine)
 {
-    int i;
+    DWORD type = REG_SZ, size = 0, old_type, len;
+    WCHAR *truncated = NULL;
+    HKEY hkey;
+    LONG ret;
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+    len = wcslen(value);
+#ifdef SG_MUTANT_SETX_NOTRUNC
+    len = 0;
+#endif
+    if (len > MAX_VALUE_LEN)
+    {
+        err(L"WARNING: The data being saved is truncated to 1024 characters.");
+        if (!(truncated = malloc((MAX_VALUE_LEN + 1) * sizeof(WCHAR)))) return 1;
+        lstrcpynW(truncated, value, MAX_VALUE_LEN + 1);
+        value = truncated;
+    }
 
+    ret = RegCreateKeyExW(machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, machine ? machine_env_key : user_env_key,
+                          0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, NULL, &hkey, NULL);
+    if (ret)
+    {
+        err(L"ERROR: Access to the registry path is denied.");
+        free(truncated);
+        return 1;
+    }
+#ifndef SG_MUTANT_SETX_RESETS_TYPE
+    /* a variable that was stored with references keeps that type */
+    if (!RegQueryValueExW(hkey, name, NULL, &old_type, NULL, &size) && old_type == REG_EXPAND_SZ) type = REG_EXPAND_SZ;
+#endif
+    ret = RegSetValueExW(hkey, name, 0, type, (const BYTE *)value, (wcslen(value) + 1) * sizeof(WCHAR));
+    RegCloseKey(hkey);
+    free(truncated);
+    if (ret)
+    {
+        err(L"ERROR: Access to the registry path is denied.");
+        return 1;
+    }
+
+    SendMessageTimeoutW(HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"Environment", SMTO_ABORTIFHUNG, 5000, NULL);
+    wprintf(L"\nSUCCESS: Specified value was saved.\n");
     return 0;
 }
+
+int __cdecl wmain(int argc, WCHAR *argv[])
+{
+    const WCHAR *name = NULL, *value = NULL, *key_path = NULL;
+    BOOL machine = FALSE;
+    WCHAR *from_registry = NULL;
+    int i, ret;
+
+    for (i = 1; i < argc; i++)
+    {
+        if (is_switch(argv[i], 'm')) machine = TRUE;
+        else if (is_switch(argv[i], '?'))
+        {
+            wprintf(L"\nSETX [/S system [/U [domain\\]user [/P [password]]]]\n"
+                    L"     variable value [/M]\n"
+                    L"SETX [/S system [/U [domain\\]user [/P [password]]]]\n"
+                    L"     variable /K path [/M]\n"
+                    L"\nSets a user or system environment variable in the registry.\n"
+                    L"The remote form and file mode (/F) are not supported.\n");
+            return 0;
+        }
+        else if (is_switch(argv[i], 's') || is_switch(argv[i], 'u') || is_switch(argv[i], 'p'))
+        {
+            err(L"ERROR: Setting variables on a remote system is not supported.");
+            return 1;
+        }
+        else if (is_switch(argv[i], 'f') || is_switch(argv[i], 'x') || is_switch(argv[i], 'a') ||
+                 is_switch(argv[i], 'r') || is_switch(argv[i], 'd'))
+        {
+            err(L"ERROR: File mode is not supported.");
+            return 1;
+        }
+        else if (is_switch(argv[i], 'k'))
+        {
+            if (++i >= argc) return usage_error();
+            key_path = argv[i];
+        }
+        else if (!name) name = argv[i];
+        else if (!value) value = argv[i];
+        else return usage_error();
+    }
+
+    if (!name || !*name || (key_path ? value != NULL : value == NULL)) return usage_error();
+
+    if (key_path)
+    {
+        if (!(from_registry = read_registry_path(key_path)))
+        {
+            err(L"ERROR: Specified registry key or value was not found.");
+            return 1;
+        }
+        value = from_registry;
+    }
+
+    ret = save_variable(name, value, machine);
+    free(from_registry);
+    return ret;
+}
