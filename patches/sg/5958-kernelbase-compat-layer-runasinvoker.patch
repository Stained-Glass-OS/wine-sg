From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: __COMPAT_LAYER=RunAsInvoker runs a program as its caller

Windows honours the __COMPAT_LAYER environment variable: with RunAsInvoker
among its layers a program runs as its caller whatever its manifest asks.
SG Store sets it for an installer it runs for one person (the winget entry's
scope "user"): an administrator's elevation here is another account
(sgsystem), so Kdenlive's NSIS installer (RequestExecutionLevel highest,
/CurrentUser) asked for consent and installed itself into sgsystem's
profile. Gate test-elevreq; mutant SG_MUTANT_NO_RUNASINVOKER.
---
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index cad27e6..ab7e690 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -731,6 +731,26 @@ static BOOL sg_layers_run_as_admin( const WCHAR *app_name )
     return ret;
 }
 
+/* __COMPAT_LAYER=RunAsInvoker in the environment: the program runs as its
+ * caller whatever its manifest asks, as on Windows. SG Store sets it for an
+ * installer it runs for one person (the entry's scope "user"): an
+ * administrator's elevation here is another account (sgsystem), so Kdenlive's
+ * installer (NSIS "highest", /CurrentUser) put itself in sgsystem's profile. */
+static BOOL sg_env_run_as_invoker(void)
+{
+    WCHAR layers[256], *tok, *end;
+    DWORD len = GetEnvironmentVariableW( L"__COMPAT_LAYER", layers, ARRAY_SIZE(layers) );
+
+    if (!len || len >= ARRAY_SIZE(layers)) return FALSE;
+    for (tok = layers; *tok; tok = end)  /* space-separated layer names */
+    {
+        while (*tok == ' ') tok++;
+        for (end = tok; *end && *end != ' '; end++);
+        if (end - tok == 12 && !wcsnicmp( tok, L"RunAsInvoker", 12 )) return TRUE;
+    }
+    return FALSE;
+}
+
 /* Stained Glass OS (ADR 0012): does starting app_name need an administrator?
  *
  * On Windows, CreateProcess of a program whose manifest says
@@ -768,6 +788,9 @@ static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token )
     WCHAR broker[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate", *p;
 
     if (!app_name || GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 )) return FALSE;
+#ifndef SG_MUTANT_NO_RUNASINVOKER
+    if (sg_env_run_as_invoker()) return FALSE;
+#endif
     /* SG_ELEVATE names a stand-in broker client (an absolute Unix path), for gates */
     if (GetEnvironmentVariableW( L"SG_ELEVATE", broker + 8, MAX_PATH ) && broker[8] == '/')
     {
