From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:13:08 -0700
Subject: [PATCH] dx8vb: class factory lock count

IClassFactory::LockServer keeps a lock count instead of being a FIXME stub.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/dx8vb/main.c b/dlls/dx8vb/main.c
index 2fc7402..b1e19c8 100644
--- a/dlls/dx8vb/main.c
+++ b/dlls/dx8vb/main.c
@@ -110,10 +110,16 @@ static HRESULT WINAPI classfactory_CreateInstance(IClassFactory *iface, IUnknown
     return hres;
 }
 
+static LONG server_locks;
+
 static HRESULT WINAPI classfactory_LockServer(IClassFactory *iface, BOOL dolock)
 {
     IClassFactoryImpl *This = impl_from_IClassFactory(iface);
-    FIXME("(%p)->(%d), stub!\n", This, dolock);
+
+    TRACE("(%p)->(%d)\n", This, dolock);
+
+    if (dolock) InterlockedIncrement(&server_locks);
+    else if (server_locks > 0) InterlockedDecrement(&server_locks);
     return S_OK;
 }
 
