From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vbscript: a call statement's first argument may start with a bracket (9617)

WScript.Echo (a) & " items", MsgBox (n) + 1 and WScript.Echo ("Total: ") & n
are valid VBScript: when an operator follows the closing bracket, the
bracketed expression is only the start of the first argument. Wine's lexer
always took a bracket after the called name as the call's own argument list,
so the operator was a syntax error (1002) and the whole script did not run.
The lexer now looks, for the first name (or member chain) of a statement, at
what follows the matching bracket on the same statement: an arithmetic,
concatenation or comparison operator, or And/Or/Xor/Mod/Eqv/Imp/Is, makes the
bracket part of the argument. The end of the statement, a comma, '=', '.' or
another bracket keep today's meaning, so Sub (1, 2) is still error 1044 and
arr (1) = 2 still assigns.
---
--- a/dlls/vbscript/lex.c
+++ b/dlls/vbscript/lex.c
@@ -388,6 +388,57 @@
     return tNL;
 }
 
+/* A call statement whose first argument begins with a parenthesized expression --
+ * WScript.Echo (a) & " items", MsgBox (n) + 1: native VBScript takes the brackets as part of
+ * the argument when an operator follows the closing bracket (wine-sg 9617). The lexer is
+ * at the character after '(' (spaces skipped); it looks for the matching ')' on the
+ * statement and at what follows it. A bracket followed by the end of the statement, a comma,
+ * '=', '.', '(' or anything else keeps its meaning (the argument list of the call). */
+static BOOL bracket_starts_argument(parser_ctx_t *ctx)
+{
+    static const WCHAR *const ops[] = { L"and", L"or", L"xor", L"mod", L"eqv", L"imp", L"is" };
+    const WCHAR *p = ctx->ptr;
+    unsigned depth = 1, i, len;
+
+#ifdef SG_MUTANT_VBS_PAREN_ARG
+    return FALSE;
+#endif
+    while(p < ctx->end && depth) {
+        switch(*p) {
+        case '"':
+            for(p++; p < ctx->end && *p != '\n' && *p != '\r'; p++) {
+                if(*p == '"') {
+                    if(p + 1 < ctx->end && p[1] == '"') p++;
+                    else break;
+                }
+            }
+            if(p >= ctx->end || *p != '"') return FALSE;
+            break;
+        case '\n': case '\r': case ':': case '\'':
+            return FALSE;
+        case '(':
+            depth++;
+            break;
+        case ')':
+            depth--;
+            break;
+        }
+        p++;
+    }
+    if(depth) return FALSE;
+    while(p < ctx->end && (*p == ' ' || *p == '\t')) p++;
+    if(p >= ctx->end) return FALSE;
+    switch(*p) {
+    case '&': case '+': case '-': case '*': case '/': case '\\': case '^': case '<': case '>':
+        return TRUE;
+    }
+    if(!iswalpha(*p)) return FALSE;
+    for(len = 0; p + len < ctx->end && is_identifier_char(p[len]); len++);
+    for(i = 0; i < ARRAY_SIZE(ops); i++)
+        if(len == wcslen(ops[i]) && !wcsnicmp(p, ops[i], len)) return TRUE;
+    return FALSE;
+}
+
 static int parse_next_token(void *lval, unsigned *loc, parser_ctx_t *ctx)
 {
     WCHAR c;
@@ -466,6 +517,8 @@
          * Parser can't predict if bracket is part of argument expression or an argument
          * in call expression. We predict it here instead.
          */
+        if(ctx->last_token == tIdentifier && ctx->call_state == 2 && bracket_starts_argument(ctx))
+            return tEXPRLBRACKET;
         if(ctx->last_token == tIdentifier || ctx->last_token == ')')
             return '(';
         return tEXPRLBRACKET;
@@ -547,5 +600,25 @@
         ctx->last_nl = ctx->ptr-ctx->code;
     }
 
+    /* 1: a statement starts, 2: after its first name (or a member of it), 3: after a '.' there */
+    switch(ret) {
+    case tNL: case ':': case tTHEN: case tELSE:
+        ctx->call_state = 1;
+        break;
+    case tIdentifier:
+        ctx->call_state = (ctx->call_state == 1 || ctx->call_state == 3) ? 2 : 0;
+        break;
+    case tME:
+        ctx->call_state = ctx->call_state == 1 ? 2 : 0;
+        break;
+    case '.':
+        ctx->call_state = ctx->call_state == 2 ? 3 : 0;
+        break;
+    case tDOT:
+        ctx->call_state = ctx->call_state == 1 ? 3 : 0;
+        break;
+    default:
+        ctx->call_state = 0;
+    }
     return (ctx->last_token = ret);
 }
--- a/dlls/vbscript/parse.h
+++ b/dlls/vbscript/parse.h
@@ -303,6 +303,7 @@
 
     int last_token;
     unsigned last_nl;
+    int call_state; /* where a call statement's callee is being read (lex.c, wine-sg 9617) */
 
     statement_t *stats;
     statement_t *stats_tail;
--- a/dlls/vbscript/parser.y
+++ b/dlls/vbscript/parser.y
@@ -1223,13 +1223,16 @@
     ctx->error_loc = -1;
     ctx->last_token = tNL;
     ctx->last_nl = 0;
+    ctx->call_state = 1;
     ctx->stats = ctx->stats_tail = NULL;
     ctx->class_decls = NULL;
     ctx->option_explicit = FALSE;
     ctx->is_html = delimiter && !wcsicmp(delimiter, L"</script>");
 
-    if(flags & SCRIPTTEXT_ISEXPRESSION)
+    if(flags & SCRIPTTEXT_ISEXPRESSION) {
         ctx->last_token = tEXPRESSION;
+        ctx->call_state = 0; /* an expression is no call statement */
+    }
 
     parser_parse(ctx);
 
