From: Stained Glass OS <dev@stained-glass.example>
Subject: msxml3: removeChild of a node replaceChild took out of the same parent

Office's installer (Click-to-Run, App-V's manifest merging) replaces an
Extensions element with replaceChild, then removes the element it replaced
from the same parent. Wine refused that removal with E_INVALIDARG -- the
node had no parent any more -- and Office stopped with error 30088-45.

A node remembers the parent replaceChild took it out of; removing it from
that parent again succeeds, to no effect, and returns the node. Every other
removal of a node that is not a child is still refused as before, as MSXML
refuses it (Wine's tests: a child removed already, a descendant that is not
a child): one asked of another parent, one moved into a tree since, one
removed by removeChild.

Gate: test/msxml-replace-gate.sh.
---
--- a/dlls/msxml3/msxml_private.h
+++ b/dlls/msxml3/msxml_private.h
@@ -101,6 +101,7 @@
     IXMLDOMNode *iface;
     IXMLDOMNode *parent;
     xmlNodePtr   node;
+    xmlNodePtr   replaced_from; /* the parent replaceChild took this node out of */
 } xmlnode;
 
 /* IXMLDOMNamedNodeMap custom function table */
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -529,6 +529,7 @@
         if (refcount) xmldoc_release_refs(doc, refcount);
         node_obj->parent = This->iface;
     }
+    node_obj->replaced_from = NULL;   /* in a tree again */
 
     if(ret)
     {
@@ -592,7 +593,9 @@
     xmlReplaceNode(old_child->node, new_child->node);
     if (refcount) xmldoc_release_refs(leaving_doc, refcount);
     new_child->parent = old_child->parent;
+    new_child->replaced_from = NULL;
     old_child->parent = NULL;
+    old_child->replaced_from = This->node;
 
     xmldoc_add_orphan(old_child->node->doc, old_child->node);
 
@@ -619,12 +622,28 @@
 
     if(child_node->node->parent != This->node)
     {
+        /* Stained Glass OS: a node replaceChild took out of this parent can
+         * be removed from it again, to no effect. Office's installer (App-V's
+         * manifest merging) replaces an Extensions element and then removes
+         * the one it replaced; it stopped with 30088-45. A node removed by
+         * removeChild, or taken out of another parent, is still refused. */
+        if(!child_node->node->parent && child_node->replaced_from == This->node)
+        {
+            TRACE("%p was replaced out of %p already\n", child, This);
+            if(oldChild)
+            {
+                IXMLDOMNode_AddRef(child);
+                *oldChild = child;
+            }
+            return S_OK;
+        }
         WARN("childNode %p is not a child of %p\n", child, This);
         return E_INVALIDARG;
     }
 
     xmlUnlinkNode(child_node->node);
     child_node->parent = NULL;
+    child_node->replaced_from = NULL;
     xmldoc_add_orphan(child_node->node->doc, child_node->node);
 
     if(oldChild)
@@ -1655,6 +1674,7 @@
     This->node = node;
     This->iface = node_iface;
     This->parent = NULL;
+    This->replaced_from = NULL;
 
     init_dispex(&This->dispex, (IUnknown*)This->iface, dispex_data);
 }
