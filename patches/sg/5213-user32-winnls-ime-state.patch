From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32

 WINNLSEnableIME and WINNLSGetEnableStatus:WINNLSEnableIME keeps the IME state and returns the previous one, and WINNLSGetEnableStatus reports it; a window handle is refused. CORE: integrator must review
(patches/notes/5213.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -412,24 +412,49 @@
     return 0; /* unknown */
 }
 
+/* Stained Glass OS: the state WINNLSEnableIME sets (a process-wide switch: a particular IME
+ * per application is not supported) */
+static LONG winnls_ime_enabled = TRUE;
+
 /**********************************************************************
  * WINNLSEnableIME [USER32.@]
  *
+ * Returns the previous state; hwnd must be NULL.
  */
 BOOL WINAPI WINNLSEnableIME(HWND hwnd, BOOL enable)
 {
-    FIXME("hwnd %p enable %d: stub!\n", hwnd, enable);
-    return TRUE; /* success (?) */
+    TRACE("hwnd %p enable %d\n", hwnd, enable);
+
+#ifdef SG_MUTANT_NLS_NOHWND
+    if (0)
+#else
+    if (hwnd)
+#endif
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#ifdef SG_MUTANT_NLS_ALWAYS_TRUE
+    return TRUE;
+#endif
+    return InterlockedExchange( &winnls_ime_enabled, enable != FALSE ) != FALSE;
 }
 
 /**********************************************************************
  * WINNLSGetEnableStatus [USER32.@]
  *
+ * The state WINNLSEnableIME left.
  */
 BOOL WINAPI WINNLSGetEnableStatus(HWND hwnd)
 {
-    FIXME("hwnd %p: stub!\n", hwnd);
-    return TRUE; /* success (?) */
+    TRACE("hwnd %p\n", hwnd);
+
+    if (hwnd)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return InterlockedCompareExchange( &winnls_ime_enabled, 0, 0 ) != FALSE;
 }
 
 /**********************************************************************
