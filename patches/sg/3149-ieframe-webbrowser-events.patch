index 6d189de..4b49f91 100644
--- a/dlls/ieframe/ieframe.h
+++ b/dlls/ieframe/ieframe.h
@@ -146,6 +146,7 @@ struct DocHost {
     VARIANT_BOOL silent;
     VARIANT_BOOL offline;
     VARIANT_BOOL busy;
+    LONG progress_max;
 
     READYSTATE ready_state;
     READYSTATE doc_state;
@@ -306,6 +307,8 @@ void deactivate_document(DocHost*);
 void create_doc_view_hwnd(DocHost*);
 void on_commandstate_change(DocHost*,LONG,BOOL);
 void notify_download_state(DocHost*,BOOL);
+void fire_secure_lock_icon(DocHost*,LONG);
+void set_dochost_status_text(DocHost*,const WCHAR*);
 void update_navigation_commands(DocHost *dochost);
 
 #define WM_DOCHOSTTASK (WM_USER+0x300)
diff --git a/dlls/ieframe/navigate.c b/dlls/ieframe/navigate.c
index ee098f6..9bb7cb5 100644
--- a/dlls/ieframe/navigate.c
+++ b/dlls/ieframe/navigate.c
@@ -93,10 +93,24 @@ static void dump_BINDINFO(BINDINFO *bi)
             );
 }
 
-static void set_status_text(BindStatusCallback *This, ULONG statuscode, LPCWSTR str)
+void set_dochost_status_text(DocHost *doc_host, const WCHAR *text)
 {
     VARIANTARG arg;
     DISPPARAMS dispparams = {&arg, NULL, 1, 0};
+
+    V_VT(&arg) = VT_BSTR;
+    V_BSTR(&arg) = SysAllocString(text ? text : emptyW);
+
+    call_sink(doc_host->cps.wbe2, DISPID_STATUSTEXTCHANGE, &dispparams);
+
+    if(doc_host->frame)
+        IOleInPlaceFrame_SetStatusText(doc_host->frame, V_BSTR(&arg));
+
+    VariantClear(&arg);
+}
+
+static void set_status_text(BindStatusCallback *This, ULONG statuscode, LPCWSTR str)
+{
     WCHAR fmt[IDS_STATUSFMT_MAXLEN];
     WCHAR buffer[IDS_STATUSFMT_MAXLEN + INTERNET_MAX_URL_LENGTH];
 
@@ -112,17 +126,8 @@ static void set_status_text(BindStatusCallback *This, ULONG statuscode, LPCWSTR
         swprintf(buffer, ARRAY_SIZE(buffer), fmt, str);
     }
 
-    V_VT(&arg) = VT_BSTR;
-    V_BSTR(&arg) = str ? SysAllocString(buffer) : SysAllocString(emptyW);
-    TRACE("=> %s\n", debugstr_w(V_BSTR(&arg)));
-
-    call_sink(This->doc_host->cps.wbe2, DISPID_STATUSTEXTCHANGE, &dispparams);
-
-    if(This->doc_host->frame)
-        IOleInPlaceFrame_SetStatusText(This->doc_host->frame, buffer);
-
-    VariantClear(&arg);
-
+    TRACE("=> %s\n", debugstr_w(buffer));
+    set_dochost_status_text(This->doc_host, buffer);
 }
 
 HRESULT set_dochost_url(DocHost *This, const WCHAR *url)
@@ -144,10 +149,25 @@ HRESULT set_dochost_url(DocHost *This, const WCHAR *url)
     return S_OK;
 }
 
+/* DWebBrowserEvents2::SetSecureLockIcon, 0 meaning an unsecured page */
+void fire_secure_lock_icon(DocHost *dochost, LONG state)
+{
+    VARIANTARG arg;
+    DISPPARAMS dispparams = {&arg, NULL, 1, 0};
+
+    V_VT(&arg) = VT_I4;
+    V_I4(&arg) = state;
+    call_sink(dochost->cps.wbe2, DISPID_SETSECURELOCKICON, &dispparams);
+}
+
 void notify_download_state(DocHost *dochost, BOOL is_downloading)
 {
     DISPPARAMS dwl_dp = {NULL};
     TRACE("(%x)\n", is_downloading);
+#ifndef SG_MUTANT_DOCHOST_LOCKICON
+    if(is_downloading && !dochost->busy)
+        fire_secure_lock_icon(dochost, 0);
+#endif
     dochost->busy = is_downloading ? VARIANT_TRUE : VARIANT_FALSE;
     call_sink(dochost->cps.wbe2, is_downloading ? DISPID_DOWNLOADBEGIN : DISPID_DOWNLOADCOMPLETE, &dwl_dp);
 }
