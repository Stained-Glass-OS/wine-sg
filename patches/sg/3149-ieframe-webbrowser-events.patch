From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:44:33 -0700
Subject: [PATCH] ieframe: WebBrowser progress, title, status text, lock icon
 and download events

The document host now acts on the commands the document sends to its client
site: OLECMDID_SETPROGRESSMAX and SETPROGRESSPOS are passed on to the
container's command target and, while a download is running, fire
ProgressChange; SETPROGRESSTEXT is passed on; SETTITLE fires TitleChange.
QueryStatus goes to the container's command target. SetSecureLockIcon (0)
fires when a download begins, FileDownload when a document object is created
for a navigation, and the status text is cleared (StatusTextChange and the
frame's SetStatusText) when the download is done. Removes the todo_wine
marks of these checks in tests/webbrowser.c.

diff --git a/dlls/ieframe/dochost.c b/dlls/ieframe/dochost.c
index 97b86d4..20d490b 100644
--- a/dlls/ieframe/dochost.c
+++ b/dlls/ieframe/dochost.c
@@ -301,6 +301,21 @@ static void object_available_proc(DocHost *This, task_header_t *task)
     object_available(This);
 }
 
+/* DWebBrowserEvents2::FileDownload for a download that is opened as an active document */
+static void fire_file_download(DocHost *This)
+{
+    VARIANTARG params[2];
+    VARIANT_BOOL cancel = VARIANT_FALSE;
+    DISPPARAMS dispparams = {params, NULL, 2, 0};
+
+    V_VT(params) = VT_BOOL|VT_BYREF;
+    V_BOOLREF(params) = &cancel;
+    V_VT(params+1) = VT_BOOL;
+    V_BOOL(params+1) = VARIANT_TRUE;
+
+    call_sink(This->cps.wbe2, DISPID_FILEDOWNLOAD, &dispparams);
+}
+
 HRESULT dochost_object_available(DocHost *This, IUnknown *doc)
 {
     READYSTATE ready_state;
@@ -311,6 +326,8 @@ HRESULT dochost_object_available(DocHost *This, IUnknown *doc)
     IUnknown_AddRef(doc);
     This->document = doc;
 
+    fire_file_download(This);
+
     hres = IUnknown_QueryInterface(doc, &IID_IOleObject, (void**)&oleobj);
     if(SUCCEEDED(hres)) {
         CLSID clsid;
@@ -689,12 +706,53 @@ static HRESULT WINAPI ClOleCommandTarget_QueryStatus(IOleCommandTarget *iface,
 
     TRACE("(%p)->(%s %lu %p %p)\n", This, debugstr_guid(pguidCmdGroup), cCmds, prgCmds,
           pCmdText);
+
+    /* the container decides which commands it takes */
+    if(!pguidCmdGroup && This->olecmd)
+        return IOleCommandTarget_QueryStatus(This->olecmd, pguidCmdGroup, cCmds, prgCmds, pCmdText);
+
     for(i=0; prgCmds && i < cCmds; i++)
         TRACE("unsupported command %lu (%lx)\n", prgCmds[i].cmdID, prgCmds[i].cmdf);
 
     return E_NOTIMPL;
 }
 
+static void fire_progress_change(DocHost *This, LONG pos)
+{
+    DISPPARAMS dispparams;
+    VARIANTARG params[2];
+
+    dispparams.cArgs = 2;
+    dispparams.cNamedArgs = 0;
+    dispparams.rgdispidNamedArgs = NULL;
+    dispparams.rgvarg = params;
+
+    V_VT(params) = VT_I4;
+    V_I4(params) = This->progress_max;
+    V_VT(params+1) = VT_I4;
+    V_I4(params+1) = pos;
+
+    call_sink(This->cps.wbe2, DISPID_PROGRESSCHANGE, &dispparams);
+}
+
+static void fire_title_change(DocHost *This, const WCHAR *title)
+{
+    DISPPARAMS dispparams;
+    VARIANTARG params[1];
+
+    dispparams.cArgs = 1;
+    dispparams.cNamedArgs = 0;
+    dispparams.rgdispidNamedArgs = NULL;
+    dispparams.rgvarg = params;
+
+    V_VT(params) = VT_BSTR;
+    V_BSTR(params) = SysAllocString(title);
+
+    call_sink(This->cps.wbe2, DISPID_TITLECHANGE, &dispparams);
+
+    SysFreeString(V_BSTR(params));
+}
+
 static HRESULT WINAPI ClOleCommandTarget_Exec(IOleCommandTarget *iface,
         const GUID *pguidCmdGroup, DWORD nCmdID, DWORD nCmdexecopt, VARIANT *pvaIn,
         VARIANT *pvaOut)
@@ -711,8 +769,20 @@ static HRESULT WINAPI ClOleCommandTarget_Exec(IOleCommandTarget *iface,
                 return E_NOTIMPL;
             return IOleCommandTarget_Exec(This->olecmd, pguidCmdGroup, nCmdID, nCmdexecopt, pvaIn, pvaOut);
         case OLECMDID_SETDOWNLOADSTATE:
-            if(pvaIn && V_VT(pvaIn) == VT_I4)
+            if(pvaIn && V_VT(pvaIn) == VT_I4) {
+                BOOL was_busy = This->busy != VARIANT_FALSE;
+
+#ifndef SG_MUTANT_DOCHOST_LOCKICON
+                if(V_I4(pvaIn) && !was_busy)
+                    fire_secure_lock_icon(This, 0);
+#endif
                 This->busy = V_I4(pvaIn) ? VARIANT_TRUE : VARIANT_FALSE;
+#ifndef SG_MUTANT_DOCHOST_STATUS
+                /* the status text of the download is cleared when it is done */
+                if(was_busy && !V_I4(pvaIn))
+                    set_dochost_status_text(This, NULL);
+#endif
+            }
             if(This->olecmd)
                 return IOleCommandTarget_Exec(This->olecmd, pguidCmdGroup, nCmdID, nCmdexecopt, pvaIn, pvaOut);
 
@@ -721,6 +791,29 @@ static HRESULT WINAPI ClOleCommandTarget_Exec(IOleCommandTarget *iface,
 
             notify_download_state(This, V_I4(pvaIn));
             return S_OK;
+#ifndef SG_MUTANT_DOCHOST_PROGRESS
+        case OLECMDID_SETPROGRESSMAX:
+            if(pvaIn && V_VT(pvaIn) == VT_I4)
+                This->progress_max = V_I4(pvaIn);
+            if(This->olecmd)
+                IOleCommandTarget_Exec(This->olecmd, pguidCmdGroup, nCmdID, nCmdexecopt, pvaIn, pvaOut);
+            return S_OK;
+        case OLECMDID_SETPROGRESSPOS:
+            if(This->olecmd)
+                IOleCommandTarget_Exec(This->olecmd, pguidCmdGroup, nCmdID, nCmdexecopt, pvaIn, pvaOut);
+            /* only while a download is running, not for the resets done when the document is set up */
+            if(pvaIn && V_VT(pvaIn) == VT_I4 && This->busy)
+                fire_progress_change(This, V_I4(pvaIn));
+            return S_OK;
+        case OLECMDID_SETPROGRESSTEXT:
+            if(This->olecmd)
+                return IOleCommandTarget_Exec(This->olecmd, pguidCmdGroup, nCmdID, nCmdexecopt, pvaIn, pvaOut);
+            return E_NOTIMPL;
+        case OLECMDID_SETTITLE:
+            if(pvaIn && V_VT(pvaIn) == VT_BSTR && V_BSTR(pvaIn))
+                fire_title_change(This, V_BSTR(pvaIn));
+            return S_OK;
+#endif
         default:
             TRACE("Unimplemented cmdid %ld\n", nCmdID);
             return E_NOTIMPL;
