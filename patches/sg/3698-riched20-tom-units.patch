From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] riched20: ITextRange units for lines, screens, the window, formats, tables and objects (3698)

riched20: ITextRange units for lines, screens, the window, formats, tables and objects

Expand, StartOf, EndOf, Move, MoveStart, MoveEnd, GetIndex and SetIndex
took only characters, words, sentences, paragraphs and the story; every
other unit was E_NOTIMPL. They now take the units of the TOM documentation
that a rich edit control can honour:
 - tomLine: the display lines of the wrapped control;
 - tomScreen: a page of rows (as for PAGE UP and PAGE DOWN);
 - tomWindow: the visible part (upper left to lower right);
 - tomCharFormat and tomParaFormat: runs of constant character and
   paragraph formatting;
 - tomCell, tomRow and tomTable: the cells, rows and tables of the control;
 - tomObject: embedded objects, which are not contiguous, so Move and the
   edge moves step from object to object and Expand takes the object a
   collapsed range is at.
tomSection stays E_NOTIMPL (documented for rich edit controls) and so does
tomColumn, which is not a contiguous part of the story. The boundaries of
these units come from the layout and the run list of the editor, collected
with the text of the story, so the word, sentence and paragraph code that
steps over boundaries serves all of them.
---
diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index bbc84cf..b18d3c4 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -898,9 +898,58 @@ static void textfont_cache_range_props(ITextFontImpl *font)
 /* Units other than characters: words and paragraphs found in the text of the story, and the
  * story itself (one unit). A word is a run of letters and digits or of other marks, with the
  * white space after it; a paragraph ends with a carriage return. */
+static BOOL tom_partition_unit(LONG unit)
+{
+    switch (unit)
+    {
+    case tomWord: case tomSentence: case tomParagraph: case tomStory:
+    case tomLine: case tomScreen: case tomWindow: case tomCell: case tomRow: case tomTable:
+    case tomCharFormat: case tomParaFormat:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+/* tomObject is the one unit that is not a partition of the story: objects are single characters
+ * with any amount of text between them. tomSection is E_NOTIMPL in rich edit (documented) and
+ * tomColumn is not a contiguous part of the story. */
 static BOOL tom_generic_unit(LONG unit)
 {
-    return unit == tomWord || unit == tomSentence || unit == tomParagraph || unit == tomStory;
+    return tom_partition_unit(unit) || unit == tomObject;
+}
+
+/* bits of the boundary mask kept after the text of a story */
+#define TOMB_LINE    0x0001
+#define TOMB_SCREEN  0x0002
+#define TOMB_WINDOW  0x0004
+#define TOMB_CELL    0x0008
+#define TOMB_ROW     0x0010
+#define TOMB_TABLE   0x0020
+#define TOMB_CHARFMT 0x0040
+#define TOMB_PARAFMT 0x0080
+#define TOMB_OBJECT  0x0100
+
+static WORD tom_unit_mask(LONG unit)
+{
+    switch (unit)
+    {
+    case tomLine:       return TOMB_LINE;
+    case tomScreen:     return TOMB_SCREEN;
+    case tomWindow:     return TOMB_WINDOW;
+    case tomCell:       return TOMB_CELL;
+    case tomRow:        return TOMB_ROW;
+    case tomTable:      return TOMB_TABLE;
+    case tomCharFormat: return TOMB_CHARFMT;
+    case tomParaFormat: return TOMB_PARAFMT;
+    case tomObject:     return TOMB_OBJECT;
+    default:            return 0;
+    }
+}
+
+static inline WORD *tom_mask(const WCHAR *t, LONG len)
+{
+    return (WORD *)(t + len + 2);
 }
 
 static int tom_char_class(WCHAR c)
@@ -944,7 +993,12 @@ static BOOL tom_is_boundary(const WCHAR *t, LONG len, LONG unit, LONG pos)
 #endif
         return prev == 0 || cur != prev;
     }
-    default: return FALSE;
+    default:
+    {
+        WORD mask = tom_unit_mask(unit);
+
+        return mask && (tom_mask(t, len)[pos] & mask);
+    }
     }
 }
 
@@ -967,6 +1021,120 @@ static LONG tom_unit_prev(const WCHAR *t, LONG len, LONG unit, LONG pos)
     return max(pos, 0);
 }
 
+
+/* The boundaries of the units that come from the layout and the formatting of the story and not
+ * from its text: display lines, screens, the window, table cells, rows and tables, runs of
+ * constant character and paragraph formats, and the places of embedded objects. */
+static void tom_fill_masks(ITextRange *range, const WCHAR *t, LONG len)
+{
+    struct text_services *services = NULL;
+    WORD *mask = tom_mask(t, len);
+    ME_TextEditor *editor;
+    ME_Paragraph *para, *prev_para = NULL;
+    ME_Run *prev_run = NULL;
+    int page, top, screen_top = 0;
+
+    ITextRange_QueryInterface(range, &IID_Igetrichole, (void **)&services);
+    if (!services) return;
+    editor = services->editor;
+    page = editor->vert_si.nPage ? editor->vert_si.nPage : editor->sizeWindow.cy;
+    top = editor->vert_si.nPos;
+    if (page <= 0) page = 1;
+
+    mask[0] |= TOMB_LINE | TOMB_SCREEN | TOMB_WINDOW | TOMB_CELL | TOMB_ROW | TOMB_TABLE | TOMB_CHARFMT | TOMB_PARAFMT;
+    for (para = editor_first_para(editor); para_next(para); prev_para = para, para = para_next(para))
+    {
+        int ofs = para->nCharOfs;
+        BOOL rowstart = !!(para->nFlags & MEPF_ROWSTART), rowend = !!(para->nFlags & MEPF_ROWEND);
+        BOOL table_para = !!(para->nFlags & (MEPF_CELL | MEPF_ROWSTART | MEPF_ROWEND));
+        BOOL prev_table = prev_para && !!(prev_para->nFlags & (MEPF_CELL | MEPF_ROWSTART | MEPF_ROWEND));
+        ME_Row *row;
+        ME_Run *run;
+
+        if (ofs < 0 || ofs >= len) continue;
+        mask[ofs] |= TOMB_LINE;
+#ifndef SG_MUTANT_TOM2_PARAFMT
+        if (!prev_para || memcmp(&para->fmt, &prev_para->fmt, sizeof(para->fmt))) mask[ofs] |= TOMB_PARAFMT;
+#endif
+
+        /* a table is a run of its row paragraphs; the text before and after is no table */
+#ifndef SG_MUTANT_TOM2_TABLE
+        if (table_para != prev_table) mask[ofs] |= TOMB_TABLE | TOMB_ROW | TOMB_CELL;
+#endif
+#ifndef SG_MUTANT_TOM2_ROW
+        if (rowstart) mask[ofs] |= TOMB_ROW | TOMB_CELL;
+#endif
+        if (rowend) mask[ofs] |= TOMB_CELL;
+#ifndef SG_MUTANT_TOM2_CELL
+        if ((para->nFlags & MEPF_CELL) && (!prev_para || prev_para->cell != para->cell)) mask[ofs] |= TOMB_CELL;
+#endif
+
+        for (row = para_first_row(para); row; row = row_next(row))
+        {
+            ME_Cursor cursor;
+            int y = para->pt.y + row->pt.y, cp;
+
+            row_first_cursor(row, &cursor);
+            cp = ME_GetCursorOfs(&cursor);
+            if (cp < 0 || cp >= len) continue;
+#ifndef SG_MUTANT_TOM2_LINE
+            mask[cp] |= TOMB_LINE;
+#endif
+            /* screens fill from the top of the story, a page of rows each */
+            if (y + row->nHeight > screen_top + page && cp != 0
+#ifdef SG_MUTANT_TOM2_SCREEN
+                    && 0
+#endif
+                    )
+            {
+                mask[cp] |= TOMB_SCREEN;
+                screen_top = y;
+            }
+        }
+
+        for (run = para_first_run(para); run; run = run_next(run))
+        {
+            int rofs = run_char_ofs(run, 0);
+
+            if (rofs < 0 || rofs >= len) continue;
+            if (!prev_run || (prev_run->style != run->style
+                    && memcmp(&prev_run->style->fmt, &run->style->fmt, sizeof(run->style->fmt))))
+#ifndef SG_MUTANT_TOM2_CHARFMT
+                mask[rofs] |= TOMB_CHARFMT;
+#endif
+#ifndef SG_MUTANT_TOM2_OBJECT
+            if (run->nFlags & MERF_GRAPHICS) mask[rofs] |= TOMB_OBJECT;
+#endif
+            prev_run = run;
+        }
+    }
+
+    /* the window: from the first visible row to the first row below the visible part */
+    {
+        BOOL first = FALSE, after = FALSE;
+
+        for (para = editor_first_para(editor); para_next(para); para = para_next(para))
+        {
+            ME_Row *row;
+
+            for (row = para_first_row(para); row; row = row_next(row))
+            {
+                ME_Cursor cursor;
+                int y = para->pt.y + row->pt.y, cp;
+
+                row_first_cursor(row, &cursor);
+                cp = ME_GetCursorOfs(&cursor);
+                if (cp < 0 || cp >= len) continue;
+#ifdef SG_MUTANT_TOM2_WINDOW
+                top = 0;
+#endif
+                if (!first && y + row->nHeight > top) { mask[cp] |= TOMB_WINDOW; first = TRUE; }
+                if (!after && first && y >= top + page) { mask[cp] |= TOMB_WINDOW; after = TRUE; }
+            }
+        }
+    }
+}
+
 /* the text of the whole story of the range's document */
 static HRESULT tom_story_text(ITextRange *range, WCHAR **text, LONG *len)
 {
@@ -982,9 +1150,11 @@ static HRESULT tom_story_text(ITextRange *range, WCHAR **text, LONG *len)
     hr = ITextRange_GetText(dup, &str);
     ITextRange_Release(dup);
     if (FAILED(hr)) return hr;
-    if (!(*text = calloc(*len + 2, sizeof(WCHAR)))) { SysFreeString(str); return E_OUTOFMEMORY; }
+    /* the text, then one boundary mask word for each offset */
+    if (!(*text = calloc((*len + 2) * 2, sizeof(WCHAR)))) { SysFreeString(str); return E_OUTOFMEMORY; }
     if (str) memcpy(*text, str, min((LONG)SysStringLen(str), *len) * sizeof(WCHAR));
     SysFreeString(str);
+    tom_fill_masks(range, *text, *len);
     return S_OK;
 }
 
@@ -1009,12 +1179,93 @@ static LONG tom_step(const WCHAR *t, LONG len, LONG unit, LONG *pos, LONG count)
     return moved;
 }
 
+
+/* Embedded objects are single characters with any amount of text between them, so they are not a
+ * partition: the object unit moves between objects and EndOf and StartOf reach the next or the
+ * previous object. */
+static BOOL tom_is_object(const WCHAR *t, LONG len, LONG pos)
+{
+    return pos >= 0 && pos < len && (tom_mask(t, len)[pos] & TOMB_OBJECT);
+}
+
+static LONG tom_object_after(const WCHAR *t, LONG len, LONG pos)
+{
+    for (; pos < len; pos++) if (tom_is_object(t, len, pos)) return pos;
+    return -1;
+}
+
+static LONG tom_object_before(const WCHAR *t, LONG len, LONG pos)
+{
+    for (; pos >= 0; pos--) if (tom_is_object(t, len, pos)) return pos;
+    return -1;
+}
+
+/* move a position over count objects, stopping at the first character of the one reached */
+static LONG tom_object_step(const WCHAR *t, LONG len, LONG *pos, LONG count)
+{
+    LONG moved = 0, p;
+
+    while (count > 0 && (p = tom_object_after(t, len, *pos + 1)) >= 0
+#ifdef SG_MUTANT_TOM2_OBJSTEP
+            && moved < 1
+#endif
+            )
+    { *pos = p; moved++; count--; }
+    while (count < 0 && *pos > 0 && (p = tom_object_before(t, len, *pos - 1)) >= 0)
+    { *pos = p; moved--; count++; }
+    return moved;
+}
+
+static HRESULT tom_object_op(ITextRange *range, int op, BOOL end_edge, LONG count, LONG extend, LONG *delta)
+{
+    LONG start, end, len, ns, ne, pos, moved = 0, p;
+    WCHAR *t;
+    HRESULT hr;
+
+    if (delta) *delta = 0;
+    if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    ns = start;
+    ne = end;
+    switch (op)
+    {
+    case 0: /* expand: a collapsed range at an object takes it */
+        if (start == end && tom_is_object(t, len, start)) { ne = start + 1; moved = 1; }
+        break;
+    case 1: /* start of the object at or before the start */
+        if ((p = tom_object_before(t, len, start)) >= 0) { ns = p; moved = ns - start; if (extend != tomExtend) ne = ns; }
+        break;
+    case 2: /* end of the object that reaches the end or lies after it */
+        if ((p = tom_object_after(t, len, max(end - 1, 0))) >= 0) { ne = p + 1; moved = ne - end; if (extend != tomExtend) ns = ne; }
+        break;
+    case 3: /* move */
+        pos = count > 0 ? end : start;
+        moved = tom_object_step(t, len, &pos, count);
+        ns = ne = pos;
+        break;
+    case 4: /* move an edge */
+        pos = end_edge ? end : start;
+        moved = tom_object_step(t, len, &pos, count);
+        if (end_edge) { ne = pos; if (ne < ns) ns = ne; }
+        else { ns = pos; if (ne < ns) ne = ns; }
+        break;
+    }
+    free(t);
+    if (delta) *delta = moved;
+    if (!moved && op != 3) return S_FALSE;
+    ITextRange_SetStart(range, ns);
+    ITextRange_SetEnd(range, ne);
+    return moved ? S_OK : S_FALSE;
+}
+
 static HRESULT tom_generic_move(ITextRange *range, LONG unit, LONG count, LONG *delta)
 {
     LONG start, end, len, pos, moved;
     WCHAR *t;
     HRESULT hr;
 
+    if (unit == tomObject) return tom_object_op(range, 3, FALSE, count, 0, delta);
     if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
     ITextRange_GetStart(range, &start);
     ITextRange_GetEnd(range, &end);
@@ -1040,6 +1291,7 @@ static HRESULT tom_generic_moveedge(ITextRange *range, BOOL end_edge, LONG unit,
     WCHAR *t;
     HRESULT hr;
 
+    if (unit == tomObject) return tom_object_op(range, 4, end_edge, count, 0, delta);
     if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
     ITextRange_GetStart(range, &start);
     ITextRange_GetEnd(range, &end);
@@ -1066,6 +1318,7 @@ static HRESULT tom_generic_edge_of(ITextRange *range, BOOL to_end, LONG unit, LO
     WCHAR *t;
     HRESULT hr;
 
+    if (unit == tomObject) return tom_object_op(range, to_end ? 2 : 1, to_end, 0, extend, delta);
     if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
     ITextRange_GetStart(range, &start);
     ITextRange_GetEnd(range, &end);
@@ -1100,6 +1353,7 @@ static HRESULT tom_generic_expand(ITextRange *range, LONG unit, LONG *delta)
     WCHAR *t;
     HRESULT hr;
 
+    if (unit == tomObject) return tom_object_op(range, 0, FALSE, 0, 0, delta);
     if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
     ITextRange_GetStart(range, &start);
     ITextRange_GetEnd(range, &end);
@@ -1124,7 +1378,7 @@ static HRESULT textrange_getindex(ITextRange *range, LONG unit, LONG *index)
     if (!index) return E_INVALIDARG;
     ITextRange_GetStart(range, &start);
     if (unit == tomCharacter) { *index = start + 1; return S_OK; }
-    if (!tom_generic_unit(unit)) return E_NOTIMPL;
+    if (!tom_partition_unit(unit)) return E_NOTIMPL;
     if (unit == tomStory) { *index = 1; return S_OK; }
     if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
     /* one more than the unit starts after the beginning of the story, up to the range start */
@@ -1144,7 +1398,7 @@ static HRESULT textrange_setindex(ITextRange *range, LONG unit, LONG index, LONG
     HRESULT hr;
 
     if (!index) return E_INVALIDARG;
-    if (unit != tomCharacter && !tom_generic_unit(unit)) return E_NOTIMPL;
+    if (unit != tomCharacter && !tom_partition_unit(unit)) return E_NOTIMPL;
     if (FAILED(hr = tom_story_text(range, &t, &len))) return hr;
     ITextRange_GetStart(range, &start);
     ITextRange_GetEnd(range, &end);
