+/* Delete: with a count of 0 the text of the range goes; otherwise, for an
+ * insertion point, count characters after it (before it when negative). */
+static HRESULT textrange_delete(ITextRange *range, struct text_services *services, BOOL selection,
+                                LONG unit, LONG count, LONG *delta)
+{
+    ME_TextEditor *editor = services->editor;
+    LONG start, end, len = ME_GetTextLength(editor), from, to;
+    ME_Cursor cursor;
+
+    if (delta) *delta = 0;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+
+    if (editor->props & TXTBIT_READONLY)
+        return E_ACCESSDENIED;
+
+    if (!count)
+    {
+        from = start;
+        to = min(end, len);
+    }
+    else if (unit != tomCharacter)
+    {
+        FIXME("unit %ld is not supported\n", unit);
+        return E_NOTIMPL;
+    }
+    else if (start != end)
+    {
+        FIXME("counted delete of a range that is not an insertion point\n");
+        return E_NOTIMPL;
+    }
+    else if (count > 0)
+    {
+        from = start;
+        to = count == tomForward || count > len - start ? len : start + count;
+    }
+    else
+    {
+        to = start;
+        from = count == tomBackward || -count > start ? 0 : start + count;
+    }
+
+    if (to <= from)
+        return S_FALSE;
+
+#ifdef SG_MUTANT_DELETE_NOOP
+    return S_OK;
+#endif
+    cursor_from_char_ofs(editor, from, &cursor);
+    ME_InternalDeleteText(editor, &cursor, to - from, FALSE);
+    textranges_update_ranges(services, from, to, RANGE_UPDATE_DELETE);
+    if (selection)
+        set_selection_cursors(editor, from, from);
+    if (delta) *delta = count < 0 ? from - to : to - from;
+    return S_OK;
+}
+
+/* Replace one character, keeping the formatting of the one it replaces. */
+static void editor_replace_char(ME_TextEditor *editor, LONG ofs, WCHAR ch)
+{
+    ME_Cursor cursor;
+    ME_Style *style;
+    int cursors[2] = { ME_GetCursorOfs(&editor->pCursors[0]), ME_GetCursorOfs(&editor->pCursors[1]) };
+
+    cursor_from_char_ofs(editor, ofs, &cursor);
+    style = cursor.run->style;
+    ME_AddRefStyle(style);
+    ME_InternalDeleteText(editor, &cursor, 1, FALSE);
+    /* a selection would be deleted by the insertion */
+    cursor_from_char_ofs(editor, ofs, &editor->pCursors[0]);
+    editor->pCursors[1] = editor->pCursors[0];
+#ifdef SG_MUTANT_CASE_FORMAT_LOST
+    ME_ReleaseStyle(style);
+    style = editor->pBuffer->pDefaultStyle;
+    ME_AddRefStyle(style);
+#endif
+    ME_InsertTextFromCursor(editor, 0, &ch, 1, style);
+    ME_ReleaseStyle(style);
+    cursor_from_char_ofs(editor, cursors[0], &editor->pCursors[0]);
+    cursor_from_char_ofs(editor, cursors[1], &editor->pCursors[1]);
+}
+
+static HRESULT textrange_setchar(ITextRange *range, ME_TextEditor *editor, LONG ch)
+{
+    LONG start;
+
+    if (editor->props & TXTBIT_READONLY)
+        return E_ACCESSDENIED;
+    ITextRange_GetStart(range, &start);
+    if (start >= ME_GetTextLength(editor))
+        return E_INVALIDARG;
+    editor_replace_char(editor, start, ch);
+    return S_OK;
+}
+
+static HRESULT textrange_changecase(ITextRange *range, ME_TextEditor *editor, LONG type)
+{
+    LONG start, end, i, total;
+    BOOL new_word = TRUE, new_sentence = TRUE;
+    WCHAR *text;
+    HRESULT hr;
+
+    if (type != tomLowerCase && type != tomUpperCase && type != tomTitleCase &&
+        type != tomSentenceCase && type != tomToggleCase)
+        return E_INVALIDARG;
+    if (editor->props & TXTBIT_READONLY)
+        return E_ACCESSDENIED;
+
+    if (FAILED(hr = story_text(editor, &text, &total)))
+        return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    if (end > ME_GetTextLength(editor)) end = ME_GetTextLength(editor);
+
+    /* whether the range starts a word or a sentence */
+    if (start > 0)
+    {
+        new_word = !iswalnum(text[start - 1]);
+        for (i = start - 1; i >= 0 && iswspace(text[i]) && text[i] != '\r'; i--) ;
+        new_sentence = i < 0 || text[i] == '\r' || text[i] == '.' || text[i] == '!' || text[i] == '?';
+    }
+
+    for (i = start; i < end; i++)
+    {
+        WCHAR c = text[i], n = c;
+        switch (type)
+        {
+        case tomLowerCase: n = towlower(c); break;
+        case tomUpperCase: n = towupper(c); break;
+        case tomToggleCase: n = iswupper(c) ? towlower(c) : towupper(c); break;
+        case tomTitleCase: if (new_word) n = towupper(c); break;
+        case tomSentenceCase: if (new_sentence && iswalpha(c)) n = towupper(c); break;
+        }
+        if (n != c)
+            editor_replace_char(editor, i, n);
+
+        new_word = !iswalnum(c);
+        if (c == '.' || c == '!' || c == '?' || c == '\r') new_sentence = TRUE;
+        else if (!iswspace(c)) new_sentence = FALSE;
+    }
+    free(text);
+    return S_OK;
+}
+
+static HRESULT textrange_canedit(ME_TextEditor *editor, LONG *ret)
+{
+    if (!ret)
+        return E_INVALIDARG;
+    *ret = (editor->props & TXTBIT_READONLY) ? tomFalse : tomTrue;
+    return *ret == tomTrue ? S_OK : S_FALSE;
+}
