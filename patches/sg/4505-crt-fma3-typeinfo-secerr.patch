From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: FMA3 flags, type_info name cleanup, default security error report.

_get_FMA3_enable and _set_FMA3_enable (64-bit ucrtbase/msvcr120) report 0:
the math functions here have no FMA3 implementations to switch to, which is
what the documented return values describe. __clean_type_info_names_internal
(msvcr80/90) has nothing to free, the undecorated names being kept with each
type_info. __security_error_handler (msvcr70/71) without an application
handler reports the buffer overrun (or unknown security failure) on stderr
before ending the program with exit code 3; it only logged a FIXME.
---
 dlls/msvcrt/cpp.c    |  5 ++++-
 dlls/msvcrt/except.c | 12 +++++++++++-
 dlls/msvcrt/math.c   |  6 ++++--
 3 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/dlls/msvcrt/cpp.c b/dlls/msvcrt/cpp.c
index 84959f1..71bfa50 100644
--- a/dlls/msvcrt/cpp.c
+++ b/dlls/msvcrt/cpp.c
@@ -949,7 +949,10 @@ int __cdecl _is_exception_typeof(const type_info *ti, EXCEPTION_POINTERS *ep)
  */
 void CDECL __clean_type_info_names_internal(void *p)
 {
-    FIXME("(%p) stub\n", p);
+    TRACE("(%p)\n", p);
+    /* The undecorated names are kept with each type_info (see
+     * type_info_name_internal_method), not in the caller's list: nothing is
+     * listed to free. */
 }
 
 /*********************************************************************
diff --git a/dlls/msvcrt/except.c b/dlls/msvcrt/except.c
index 5cb2958..71b7f83 100644
--- a/dlls/msvcrt/except.c
+++ b/dlls/msvcrt/except.c
@@ -33,6 +33,7 @@
 #include "winternl.h"
 #include "msvcrt.h"
 #include "excpt.h"
+#include "io.h"
 #include "wincon.h"
 #include "wine/exception.h"
 #include "wine/debug.h"
@@ -866,7 +867,16 @@ void CDECL __security_error_handler(int code, void *data)
     if(security_error_handler)
         security_error_handler(code, data);
     else
-        FIXME("(%d, %p) stub\n", code, data);
+    {
+        /* the report the runtime gives without a handler; the program ends */
+        const char *msg = code == 1 /* _SECERR_BUFFER_OVERRUN */ ? "Buffer overrun detected!\n"
+                                                                  : "Unknown security failure detected!\n";
+
+        ERR("(%d, %p) %s", code, data, msg);
+#ifndef SG_MUTANT_SECERR_SILENT
+        _write(2, msg, strlen(msg));
+#endif
+    }
 
     _exit(3);
 }
diff --git a/dlls/msvcrt/math.c b/dlls/msvcrt/math.c
index c00c2ae..b3b0f29 100644
--- a/dlls/msvcrt/math.c
+++ b/dlls/msvcrt/math.c
@@ -174,7 +174,8 @@ int CDECL _set_SSE2_enable(int flag)
  */
 int CDECL _get_FMA3_enable(void)
 {
-    FIXME("() stub\n");
+    TRACE("()\n");
+    /* the math functions here have no FMA3 implementations to switch to */
     return 0;
 }
 # endif
@@ -185,7 +186,8 @@ int CDECL _get_FMA3_enable(void)
  */
 int CDECL _set_FMA3_enable(int flag)
 {
-    FIXME("(%x) stub\n", flag);
+    TRACE("(%x)\n", flag);
+    /* nonzero only when FMA3 implementations are in use, which they never are here */
     return 0;
 }
 # endif
