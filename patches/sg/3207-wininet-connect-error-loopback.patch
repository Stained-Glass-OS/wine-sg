From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 22:33:42 -0700
Subject: [PATCH] wininet: InternetConnect fails for unsupported services,
 loopback proxy bypass (3207)

InternetConnect(INTERNET_SERVICE_GOPHER) and unknown services returned NULL
with last error 0. They now fail with ERROR_INTERNET_INVALID_OPERATION
(guess; Gopher is documented as Windows XP and earlier only). The documented
default proxy bypass for localhost, loopback, 127.0.0.1 and [::1] is applied
unless the bypass list contains <-loopback>.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/wininet/http.c b/dlls/wininet/http.c
index 7b46ed8..b4fb214 100644
--- a/dlls/wininet/http.c
+++ b/dlls/wininet/http.c
@@ -1706,6 +1706,18 @@ static BOOL HTTP_HostInBypassList(const WCHAR *bypass, LPCWSTR server)
     LPCWSTR ptr;
     BOOL ret = FALSE;
 
+    /* documented default: localhost and the loopback addresses bypass the proxy,
+     * unless the list removes that with "<-loopback>" */
+#ifdef SG_MUTANT_WININET_LOOPBACK
+    if (0 &&
+#else
+    if (
+#endif
+        (!wcsicmp(server, L"localhost") || !wcsicmp(server, L"loopback") || !wcscmp(server, L"127.0.0.1") ||
+         !wcscmp(server, L"[::1]") || !wcscmp(server, L"::1")) &&
+        !(bypass && wcsstr(bypass, L"<-loopback>")))
+        return TRUE;
+
     if (!bypass) return FALSE;
     ptr = bypass;
     while(1) {
diff --git a/dlls/wininet/internet.c b/dlls/wininet/internet.c
index 3a73474..eba3b67 100644
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -1852,6 +1852,11 @@ HINTERNET WINAPI InternetConnectW(HINTERNET hInternet,
 
         case INTERNET_SERVICE_GOPHER:
         default:
+            /* Gopher sessions are only supported on Windows XP and earlier (documentation);
+             * the exact error for the unsupported service is a guess */
+#ifndef SG_MUTANT_WININET_GOPHERCONN
+            res = ERROR_INTERNET_INVALID_OPERATION;
+#endif
             break;
     }
