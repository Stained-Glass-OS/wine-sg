--- a/dlls/loadperf/Makefile.in
+++ b/dlls/loadperf/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = loadperf.dll
+IMPORTS   = advapi32
 IMPORTLIB = loadperf
 
 EXTRADLLFLAGS = -Wb,--prefer-native
--- a/dlls/loadperf/loadperf_main.c
+++ b/dlls/loadperf/loadperf_main.c
@@ -20,9 +20,16 @@
 
 
 #include <stdarg.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <wchar.h>
 
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
 #include "windef.h"
 #include "winbase.h"
+#include "winreg.h"
+#include "winternl.h"
 #include "winerror.h"
 #include "winnls.h"
 #include "wine/debug.h"
@@ -31,6 +38,420 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(loadperf);
 
+#define PERFLIB_PATH L"\\Registry\\Machine\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Perflib"
+#define SERVICES_PATH L"SYSTEM\\CurrentControlSet\\Services\\"
+#define BASE_LAST_COUNTER 1846  /* the last counter of a system's built-in set */
+
+struct text_entry { DWORD index; WCHAR *text; };
+struct text_list { struct text_entry *entries; unsigned int count, size; };
+
+static void free_text_list(struct text_list *list)
+{
+    unsigned int i;
+    for (i = 0; i < list->count; i++) free(list->entries[i].text);
+    free(list->entries);
+    memset(list, 0, sizeof(*list));
+}
+
+/* inserts in index order; an entry with the same index is replaced */
+static BOOL add_text(struct text_list *list, DWORD index, const WCHAR *text)
+{
+    unsigned int i;
+    WCHAR *copy = wcsdup(text);
+
+    if (!copy) return FALSE;
+    for (i = 0; i < list->count && list->entries[i].index < index; i++) {}
+    if (i < list->count && list->entries[i].index == index)
+    {
+        free(list->entries[i].text);
+        list->entries[i].text = copy;
+        return TRUE;
+    }
+    if (list->count == list->size)
+    {
+        unsigned int size = list->size ? list->size * 2 : 64;
+        struct text_entry *entries = realloc(list->entries, size * sizeof(*entries));
+        if (!entries) { free(copy); return FALSE; }
+        list->entries = entries;
+        list->size = size;
+    }
+    memmove(&list->entries[i + 1], &list->entries[i], (list->count - i) * sizeof(*list->entries));
+    list->entries[i].index = index;
+    list->entries[i].text = copy;
+    list->count++;
+    return TRUE;
+}
+
+static void remove_text_range(struct text_list *list, DWORD first, DWORD last)
+{
+    unsigned int i, j = 0;
+    for (i = 0; i < list->count; i++)
+    {
+        if (list->entries[i].index >= first && list->entries[i].index <= last) free(list->entries[i].text);
+        else list->entries[j++] = list->entries[i];
+    }
+    list->count = j;
+}
+
+/* the Perflib\<lang> keys must be opened below ntdll: kernelbase turns a handle
+ * on Perflib\009 into HKEY_PERFORMANCE_TEXT */
+static NTSTATUS open_perflib_key(const WCHAR *lang, BOOL create, HANDLE *key)
+{
+    WCHAR path[128];
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    NTSTATUS status;
+
+    /* the server keeps Perflib\009 as the virtual text key, which holds no values;
+     * kernelbase answers HKEY_PERFORMANCE_TEXT from Perflib\CurrentLanguage too */
+    swprintf(path, ARRAY_SIZE(path), L"%s\\%s", PERFLIB_PATH, !wcscmp(lang, L"009") ? L"CurrentLanguage" : lang);
+    RtlInitUnicodeString(&name, path);
+    InitializeObjectAttributes(&attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL);
+    if (create) status = NtCreateKey(key, KEY_ALL_ACCESS, &attr, 0, NULL, 0, NULL);
+    else status = NtOpenKey(key, KEY_ALL_ACCESS, &attr);
+    /* the server marks Perflib\009 as the predefined text key; the handle is a real one */
+    return status == STATUS_PREDEFINED_HANDLE ? STATUS_SUCCESS : status;
+}
+
+static NTSTATUS read_text_list(HANDLE key, const WCHAR *value, struct text_list *list)
+{
+    UNICODE_STRING name;
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    ULONG size = 0, got;
+    const WCHAR *p, *end;
+    NTSTATUS status;
+
+    RtlInitUnicodeString(&name, value);
+    status = NtQueryValueKey(key, &name, KeyValuePartialInformation, NULL, 0, &size);
+    if (status == STATUS_OBJECT_NAME_NOT_FOUND) return STATUS_SUCCESS;
+    if (status != STATUS_BUFFER_TOO_SMALL && status != STATUS_BUFFER_OVERFLOW) return status;
+    if (!(info = malloc(size))) return STATUS_NO_MEMORY;
+    status = NtQueryValueKey(key, &name, KeyValuePartialInformation, info, size, &got);
+    if (!status && info->Type == REG_MULTI_SZ)
+    {
+        p = (const WCHAR *)info->Data;
+        end = p + info->DataLength / sizeof(WCHAR);
+        while (p < end && *p)
+        {
+            WCHAR *num_end;
+            DWORD index = wcstoul(p, &num_end, 10);
+            const WCHAR *text = p + wcslen(p) + 1;
+
+            if (text >= end) break;
+            if (*num_end == 0 && !add_text(list, index, text)) { status = STATUS_NO_MEMORY; break; }
+            p = text + wcslen(text) + 1;
+        }
+    }
+    free(info);
+    return status;
+}
+
+static NTSTATUS write_text_list(HANDLE key, const WCHAR *value, const struct text_list *list)
+{
+    UNICODE_STRING name;
+    unsigned int i;
+    size_t len = 1;
+    WCHAR *data, *p;
+    NTSTATUS status;
+
+    for (i = 0; i < list->count; i++) len += 12 + wcslen(list->entries[i].text) + 1;
+    if (!(data = malloc(len * sizeof(WCHAR)))) return STATUS_NO_MEMORY;
+    for (i = 0, p = data; i < list->count; i++)
+    {
+        p += swprintf(p, 12, L"%lu", list->entries[i].index) + 1;
+        wcscpy(p, list->entries[i].text);
+        p += wcslen(p) + 1;
+    }
+    *p++ = 0;
+    RtlInitUnicodeString(&name, value);
+    status = NtSetValueKey(key, &name, 0, REG_MULTI_SZ, data, (p - data) * sizeof(WCHAR));
+    free(data);
+    return status;
+}
+
+static DWORD get_dword(HKEY key, const WCHAR *name, DWORD def)
+{
+    DWORD value, size = sizeof(value), type;
+    if (RegQueryValueExW(key, name, NULL, &type, (BYTE *)&value, &size) || type != REG_DWORD) return def;
+    return value;
+}
+
+static DWORD set_dword(HKEY key, const WCHAR *name, DWORD value)
+{
+    return RegSetValueExW(key, name, 0, REG_DWORD, (const BYTE *)&value, sizeof(value));
+}
+
+/* the last argument of a command line (a quoted path may hold spaces) */
+static WCHAR *last_argument(const WCHAR *cmdline)
+{
+    const WCHAR *end, *start;
+    WCHAR *ret;
+
+    if (!cmdline) return NULL;
+    end = cmdline + wcslen(cmdline);
+    while (end > cmdline && end[-1] == ' ') end--;
+    if (end == cmdline) return NULL;
+    if (end[-1] == '"')
+    {
+        end--;
+        for (start = end; start > cmdline && start[-1] != '"'; start--) {}
+    }
+    else for (start = end; start > cmdline && start[-1] != ' '; start--) {}
+    if (!(ret = malloc((end - start + 1) * sizeof(WCHAR)))) return NULL;
+    memcpy(ret, start, (end - start) * sizeof(WCHAR));
+    ret[end - start] = 0;
+    return ret;
+}
+
+static DWORD open_performance_key(const WCHAR *driver, REGSAM access, BOOL create, HKEY *key)
+{
+    WCHAR path[MAX_PATH];
+    DWORD ret;
+
+    if (wcslen(driver) + ARRAY_SIZE(SERVICES_PATH) + ARRAY_SIZE(L"\\Performance") >= ARRAY_SIZE(path))
+        return ERROR_INVALID_PARAMETER;
+    swprintf(path, ARRAY_SIZE(path), L"%s%s", SERVICES_PATH, driver);
+    ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, key);
+    if (ret) return ret;
+    RegCloseKey(*key);
+    wcscat(path, L"\\Performance");
+    if (create) return RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, access, NULL, key, NULL);
+    return RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, access, key);
+}
+
+static DWORD remove_counters(const WCHAR *driver)
+{
+    static const WCHAR *value_names[] = { L"First Counter", L"Last Counter", L"First Help", L"Last Help" };
+    DWORD first, last, ret;
+    HKEY perf, perflib;
+    unsigned int i;
+    WCHAR lang[16];
+
+    if ((ret = open_performance_key(driver, KEY_ALL_ACCESS, FALSE, &perf))) return ret;
+    first = min(get_dword(perf, L"First Counter", ~0u), get_dword(perf, L"First Help", ~0u));
+    last = max(get_dword(perf, L"Last Counter", 0), get_dword(perf, L"Last Help", 0));
+    if (first == ~0u || last < first)
+    {
+        RegCloseKey(perf);
+        return ERROR_FILE_NOT_FOUND;
+    }
+
+    ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Perflib",
+                        0, KEY_READ, &perflib);
+    for (i = 0; !ret && !RegEnumKeyW(perflib, i, lang, ARRAY_SIZE(lang)); i++)
+    {
+        static const WCHAR *names[] = { L"Counter", L"Help" };
+        HANDLE key;
+        unsigned int n;
+
+        if (!wcscmp(lang, L"009")) continue;  /* virtual; its strings are in CurrentLanguage */
+
+#ifdef SG_MUTANT_PERF_KEEPTEXT
+        break;
+#endif
+
+        if (open_perflib_key(lang, FALSE, &key)) continue;
+        for (n = 0; n < 2; n++)
+        {
+            struct text_list list = {0};
+            if (!read_text_list(key, names[n], &list))
+            {
+                remove_text_range(&list, first, last);
+                write_text_list(key, names[n], &list);
+            }
+            free_text_list(&list);
+        }
+        NtClose(key);
+    }
+    if (!ret) RegCloseKey(perflib);
+
+    for (i = 0; i < ARRAY_SIZE(value_names); i++) RegDeleteValueW(perf, value_names[i]);
+    RegCloseKey(perf);
+    return ERROR_SUCCESS;
+}
+
+static BOOL read_symbol(const WCHAR *symbols, size_t len, const WCHAR *name, size_t name_len, DWORD *value)
+{
+    const WCHAR *p = symbols, *end = symbols + len;
+
+    while (p < end)
+    {
+        const WCHAR *line_end = p;
+        while (line_end < end && *line_end != '\n') line_end++;
+        while (p < line_end && (*p == ' ' || *p == '\t')) p++;
+        if (line_end - p > 7 && !wcsncmp(p, L"#define", 7) && (p[7] == ' ' || p[7] == '\t'))
+        {
+            p += 7;
+            while (p < line_end && (*p == ' ' || *p == '\t')) p++;
+            if ((size_t)(line_end - p) > name_len && !wcsncmp(p, name, name_len) &&
+                (p[name_len] == ' ' || p[name_len] == '\t'))
+            {
+                WCHAR *num_end;
+                p += name_len;
+                *value = wcstoul(p, &num_end, 0);
+                return num_end != p;
+            }
+        }
+        p = line_end + 1;
+    }
+    return FALSE;
+}
+
+static WCHAR *read_text_file(const WCHAR *path, size_t *len)
+{
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0);
+    DWORD size, got;
+    char *data;
+    WCHAR *ret;
+
+    *len = 0;
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize(file, NULL);
+    if (!(data = malloc(size + 2))) { CloseHandle(file); return NULL; }
+    if (!ReadFile(file, data, size, &got, NULL)) got = 0;
+    CloseHandle(file);
+    if (got >= 2 && (BYTE)data[0] == 0xff && (BYTE)data[1] == 0xfe)
+    {
+        ret = malloc(got);
+        if (ret) { memcpy(ret, data + 2, got - 2); *len = (got - 2) / sizeof(WCHAR); }
+    }
+    else
+    {
+        ret = malloc((got + 1) * sizeof(WCHAR));
+        if (ret) *len = MultiByteToWideChar(CP_ACP, 0, data, got, ret, got);
+    }
+    free(data);
+    return ret;
+}
+
+static DWORD load_ini(const WCHAR *ini)
+{
+    WCHAR driver[MAX_PATH], symfile[MAX_PATH], full[MAX_PATH], *dir, *section = NULL, *p;
+    WCHAR *symbols = NULL;
+    size_t symbols_len = 0, section_size = 65536;
+    struct { WCHAR lang[16]; HANDLE key; struct text_list names, helps; } languages[32] = {{{0}}};
+    unsigned int nlang = 0, i;
+    DWORD ret = ERROR_SUCCESS, last_counter, last_help, first_counter, first_help, max_offset = 0;
+    HKEY perflib = NULL, perf = NULL;
+
+    if (GetFileAttributesW(ini) == INVALID_FILE_ATTRIBUTES) return GetLastError();
+    if (!GetFullPathNameW(ini, MAX_PATH, full, NULL)) return GetLastError();
+
+    GetPrivateProfileStringW(L"info", L"drivername", L"", driver, ARRAY_SIZE(driver), full);
+    GetPrivateProfileStringW(L"info", L"symbolfile", L"", symfile, ARRAY_SIZE(symfile), full);
+    if (!driver[0] || !symfile[0]) return ERROR_BADKEY;
+
+    /* the symbol file sits beside the .ini file */
+    if ((dir = wcsrchr(full, '\\')))
+    {
+        WCHAR path[MAX_PATH];
+        *dir = 0;
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s", full, symfile);
+        *dir = '\\';
+        symbols = read_text_file(path, &symbols_len);
+    }
+    if (!symbols) return ERROR_FILE_NOT_FOUND;
+
+    if (!(section = malloc(section_size * sizeof(WCHAR)))) { free(symbols); return ERROR_OUTOFMEMORY; }
+    GetPrivateProfileSectionW(L"languages", section, section_size, full);
+    for (p = section; *p && nlang < ARRAY_SIZE(languages); p += wcslen(p) + 1)
+    {
+        WCHAR *eq = wcschr(p, '=');
+        if (!eq || eq - p >= ARRAY_SIZE(languages[0].lang)) continue;
+        memcpy(languages[nlang].lang, p, (eq - p) * sizeof(WCHAR));
+        nlang++;
+    }
+    if (!nlang) { ret = ERROR_BADKEY; goto done; }
+
+    /* the strings of every language, numbered from the symbols' offsets */
+    if (!GetPrivateProfileSectionW(L"text", section, section_size, full)) { ret = ERROR_BADKEY; goto done; }
+    for (p = section; *p; p += wcslen(p) + 1)
+    {
+        WCHAR *eq = wcschr(p, '='), *underscore, *kind;
+        size_t name_len;
+        DWORD offset;
+        BOOL is_help;
+
+        if (!eq) continue;
+        kind = eq - 5;
+        if (kind <= p) continue;
+        if (!wcsnicmp(kind, L"_NAME", 5)) is_help = FALSE;
+        else if (!wcsnicmp(kind, L"_HELP", 5)) is_help = TRUE;
+        else continue;
+        for (underscore = kind - 1; underscore > p && *underscore != '_'; underscore--) {}
+        if (underscore <= p) continue;
+        name_len = underscore - p;
+        if (!read_symbol(symbols, symbols_len, p, name_len, &offset)) continue;
+        for (i = 0; i < nlang; i++)
+        {
+            size_t lang_len = wcslen(languages[i].lang);
+            if ((size_t)(kind - underscore - 1) != lang_len || wcsnicmp(underscore + 1, languages[i].lang, lang_len))
+                continue;
+            max_offset = max(max_offset, offset);
+            /* offsets are relative; the real indices are added below */
+            if (!add_text(is_help ? &languages[i].helps : &languages[i].names, offset, eq + 1)) ret = ERROR_OUTOFMEMORY;
+        }
+    }
+    if (ret) goto done;
+
+    /* a driver that is already loaded is replaced */
+    remove_counters(driver);
+
+    if ((ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Perflib",
+                             0, KEY_ALL_ACCESS, &perflib))) goto done;
+    if ((ret = open_performance_key(driver, KEY_ALL_ACCESS, FALSE, &perf))) goto done;
+
+    last_counter = get_dword(perflib, L"Last Counter", BASE_LAST_COUNTER);
+    last_help = get_dword(perflib, L"Last Help", BASE_LAST_COUNTER + 1);
+    first_counter = max(last_counter, last_help - 1) + 2;
+    first_help = first_counter + 1;
+    last_counter = first_counter + max_offset;
+    last_help = first_help + max_offset;
+
+    for (i = 0; i < nlang && !ret; i++)
+    {
+        struct text_list names = {0}, helps = {0};
+        unsigned int n;
+        NTSTATUS status = open_perflib_key(languages[i].lang, TRUE, &languages[i].key);
+
+        if (status) { WARN("open %s: %#lx\n", debugstr_w(languages[i].lang), status); ret = RtlNtStatusToDosError(status); break; }
+        status = read_text_list(languages[i].key, L"Counter", &names);
+        if (!status) status = read_text_list(languages[i].key, L"Help", &helps);
+        for (n = 0; !status && n < languages[i].names.count; n++)
+            if (!add_text(&names, first_counter + languages[i].names.entries[n].index,
+                          languages[i].names.entries[n].text)) status = STATUS_NO_MEMORY;
+        for (n = 0; !status && n < languages[i].helps.count; n++)
