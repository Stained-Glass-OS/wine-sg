From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] loadperf, kernelbase: install and remove counter text from an .ini file

LoadPerfCounterTextStringsW, UnloadPerfCounterTextStringsW and
InstallPerfDllW (lodctr/unlodctr) were stubs that reported success. They now
follow the documented lodctr format: the .ini's [info] drivername and
symbolfile, [languages] and [text] (<symbol>_<lang>_NAME/_HELP) with the
symbol's offset from the #define file beside it. Strings get indices after
Perflib's Last Counter/Last Help (names even, help the next odd), are stored
in each language's Counter/Help REG_MULTI_SZ, and the range goes into the
driver's Performance key. Reinstalling replaces; unloading removes the
strings and the Performance values and leaves Perflib's Last values.
Wine's Perflib\009 is the virtual text key (the server refuses values on it),
so English is kept in Perflib\CurrentLanguage and kernelbase appends it to
the HKEY_PERFORMANCE_TEXT Counter and Help answers.
---
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -2129,44 +2129,85 @@ LONG WINAPI RegSetKeyValueA( HKEY hkey, LPCSTR subkey, LPCSTR name, DWORD type,
 
 /* FIXME: we should read data from system32/perf009c.dat (or perf###c depending
  * on locale) instead */
-static DWORD query_perf_names( DWORD *type, void *data, DWORD *ret_size, BOOL unicode )
+/* strings that loadperf installed for the text key: Wine's Perflib\009 key is virtual, so
+ * they are kept in Perflib\CurrentLanguage as REG_MULTI_SZ; returns the data without the
+ * final terminator, to be appended after the built-in entries */
+static WCHAR *get_installed_perf_text( const WCHAR *value, DWORD *chars )
 {
-    static const WCHAR names[] = L"1\0" "1847\0" "1846\0End Marker\0";
-    DWORD size = *ret_size;
+    HKEY key;
+    DWORD size = 0, type;
+    WCHAR *data = NULL;
+
+    *chars = 0;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Perflib\\CurrentLanguage",
+                       0, KEY_READ, &key )) return NULL;
+    if (!RegQueryValueExW( key, value, NULL, &type, NULL, &size ) && type == REG_MULTI_SZ && size > sizeof(WCHAR) * 2 &&
+        (data = RtlAllocateHeap( GetProcessHeap(), 0,  size + sizeof(WCHAR)  )))
+    {
+        if (RegQueryValueExW( key, value, NULL, &type, (BYTE *)data, &size ) || size < sizeof(WCHAR) * 2)
+        {
+            RtlFreeHeap( GetProcessHeap(), 0, data );
+            data = NULL;
+        }
+        else
+        {
+            *chars = size / sizeof(WCHAR);
+            data[*chars] = 0;
+            while (*chars && !data[*chars - 1]) (*chars)--;
+            if (*chars) (*chars)++;  /* keep the terminator of the last string */
+            if (!*chars) { RtlFreeHeap( GetProcessHeap(), 0, data ); data = NULL; }
+        }
+    }
+    RegCloseKey( key );
+    return data;
+}
+
+static DWORD return_perf_text( const WCHAR *names, DWORD names_chars, const WCHAR *value, DWORD *type, void *data,
+                               DWORD *ret_size, BOOL unicode )
+{
+    DWORD size = *ret_size, extra_chars, total_chars, out_size;
+    WCHAR *extra = get_installed_perf_text( value, &extra_chars ), *all;
+    DWORD ret = ERROR_SUCCESS;
+
+    /* names ends with the empty string that ends the list: replace it by the extra strings */
+    total_chars = names_chars - 1 + extra_chars + 1;
+    if (!(all = RtlAllocateHeap( GetProcessHeap(), 0,  total_chars * sizeof(WCHAR)  )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, extra );
+        return ERROR_OUTOFMEMORY;
+    }
+    memcpy( all, names, (names_chars - 1) * sizeof(WCHAR) );
+    if (extra) memcpy( all + names_chars - 1, extra, extra_chars * sizeof(WCHAR) );
+    all[total_chars - 1] = 0;
+    RtlFreeHeap( GetProcessHeap(), 0, extra );
 
     if (type) *type = REG_MULTI_SZ;
-    *ret_size = sizeof(names);
-    if (!unicode) *ret_size /= sizeof(WCHAR);
+    out_size = total_chars * sizeof(WCHAR);
+    if (!unicode) out_size /= sizeof(WCHAR);
+    *ret_size = out_size;
 
-    if (!data) return ERROR_SUCCESS;
-    if (size < *ret_size) return ERROR_MORE_DATA;
+    if (data)
+    {
+        if (size < out_size) ret = ERROR_MORE_DATA;
+        else if (unicode) memcpy( data, all, total_chars * sizeof(WCHAR) );
+        else RtlUnicodeToMultiByteN( data, size, NULL, all, total_chars * sizeof(WCHAR) );
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, all );
+    return ret;
+}
 
-    if (unicode)
-        memcpy( data, names, sizeof(names) );
-    else
-        RtlUnicodeToMultiByteN( data, size, NULL, names, sizeof(names) );
-    return ERROR_SUCCESS;
+static DWORD query_perf_names( DWORD *type, void *data, DWORD *ret_size, BOOL unicode )
+{
+    static const WCHAR names[] = L"1\0" "1847\0" "1846\0End Marker\0";
+
+    return return_perf_text( names, ARRAY_SIZE(names), L"Counter", type, data, ret_size, unicode );
 }
 
-/* FIXME: we should read data from system32/perf009h.dat (or perf###h depending
- * on locale) instead */
 static DWORD query_perf_help( DWORD *type, void *data, DWORD *ret_size, BOOL unicode )
 {
     static const WCHAR names[] = L"1847\0End Marker\0";
-    DWORD size = *ret_size;
-
-    if (type) *type = REG_MULTI_SZ;
-    *ret_size = sizeof(names);
-    if (!unicode) *ret_size /= sizeof(WCHAR);
-
-    if (!data) return ERROR_SUCCESS;
-    if (size < *ret_size) return ERROR_MORE_DATA;
 
-    if (unicode)
-        memcpy( data, names, sizeof(names) );
-    else
-        RtlUnicodeToMultiByteN( data, size, NULL, names, sizeof(names) );
-    return ERROR_SUCCESS;
+    return return_perf_text( names, ARRAY_SIZE(names), L"Help", type, data, ret_size, unicode );
 }
 
