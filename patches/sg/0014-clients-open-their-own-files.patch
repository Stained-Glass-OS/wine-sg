+++ b/dlls/ntdll/unix/file.c
@@ -4001,6 +4001,165 @@
 }
 
 
+/* Stained Glass OS (ADR 0013): open files here, not in the server.
+ *
+ * Wine's server used to open() files on its clients' behalf. With one
+ * machine-level server shared by every user and running as SYSTEM, the kernel
+ * then checked SYSTEM's rights for every user's every open: an ordinary user's
+ * program could write System32 and read SYSTEM-only files. The client now
+ * opens -- and creates -- the file as its own Unix user and sends the fd with
+ * the request; the server adopts it and opens nothing, and refuses to open by
+ * name for anyone who is not its own account.
+ *
+ * This mirrors what the server's create_file()/open_fd() did before calling
+ * open(): the same flags for each disposition, the same access-to-mode
+ * mapping, the same retry for directories, and the same errno-to-status
+ * mapping (the server's, not ntdll's -- they differ, and callers see these
+ * statuses). A file this function creates starts owner-only and is given the
+ * server's computed mode once the server has answered, so it is never briefly
+ * readable by others. */
+
+/* the server's file_set_error() mapping, which callers of NtCreateFile see */
+static NTSTATUS sg_open_errno_to_status( int err )
+{
+    switch (err)
+    {
+    case ETXTBSY:
+    case EAGAIN:    return STATUS_SHARING_VIOLATION;
+    case EBADF:     return STATUS_INVALID_HANDLE;
+    case ENOSPC:    return STATUS_DISK_FULL;
+    case EACCES:
+    case ESRCH:
+    case EROFS:
+    case EPERM:     return STATUS_ACCESS_DENIED;
+    case EBUSY:     return STATUS_FILE_LOCK_CONFLICT;
+    case ENOENT:    return STATUS_NO_SUCH_FILE;
+    case EISDIR:    return STATUS_FILE_IS_A_DIRECTORY;
+    case ENFILE:
+    case EMFILE:    return STATUS_TOO_MANY_OPENED_FILES;
+    case EEXIST:    return STATUS_OBJECT_NAME_COLLISION;
+    case EINVAL:    return STATUS_INVALID_PARAMETER;
+    case ESPIPE:    return STATUS_ILLEGAL_FUNCTION;
+    case ENOTEMPTY: return STATUS_DIRECTORY_NOT_EMPTY;
+    case EIO:       return STATUS_ACCESS_VIOLATION;
+    case ENOTDIR:   return STATUS_NOT_A_DIRECTORY;
+    case EFBIG:     return STATUS_SECTION_TOO_BIG;
+    case ENODEV:
+    case ENXIO:     return STATUS_NO_SUCH_DEVICE;
+    case EXDEV:     return STATUS_NOT_SAME_DEVICE;
+    case ELOOP:     return STATUS_REPARSE_POINT_NOT_RESOLVED;
+    case EOVERFLOW: return STATUS_INVALID_PARAMETER;
+    default:        return STATUS_UNSUCCESSFUL;
+    }
+}
+
+/* the process umask, read without changing it (umask() would race other
+ * threads creating files) */
+static mode_t sg_umask(void)
+{
+    static mode_t cached = (mode_t)-1;
+    char line[64];
+    FILE *f;
+
+    if (cached != (mode_t)-1) return cached;
+    cached = 022;
+    if ((f = fopen( "/proc/self/status", "r" )))
+    {
+        while (fgets( line, sizeof(line), f ))
+            if (!strncmp( line, "Umask:", 6 )) { cached = strtoul( line + 6, NULL, 8 ) & 0777; break; }
+        fclose( f );
+    }
+    return cached;
+}
+
+#define SG_UNIX_READ_ACCESS  (FILE_READ_DATA|FILE_READ_ATTRIBUTES|FILE_READ_EA)
+#define SG_UNIX_WRITE_ACCESS (FILE_WRITE_DATA|FILE_APPEND_DATA|FILE_WRITE_ATTRIBUTES|FILE_WRITE_EA)
+
+/* Open unix_name (relative to root_fd when it is not AT_FDCWD) as this process's
+ * user. Returns the fd, or -1 with *status set; *created says whether this call
+ * created it. */
+static int sg_client_open( int root_fd, const char *unix_name, ACCESS_MASK access,
+                           ULONG disposition, ULONG options, BOOL *created, NTSTATUS *status )
+{
+    int flags, rw_mode, fd;
+
+    *created = FALSE;
+    switch (disposition)
+    {
+    case FILE_CREATE:       flags = O_CREAT | O_EXCL; break;
+    case FILE_OVERWRITE_IF: access |= FILE_WRITE_ATTRIBUTES; /* fall through */
+    case FILE_SUPERSEDE:    flags = O_CREAT | O_TRUNC; break;
+    case FILE_OPEN:         flags = 0; break;
+    case FILE_OPEN_IF:      flags = O_CREAT; break;
+    case FILE_OVERWRITE:    flags = O_TRUNC; access |= FILE_WRITE_ATTRIBUTES; break;
+    default:                *status = STATUS_INVALID_PARAMETER; return -1;
+    }
+    /* rejected by the server before it touched the disk; reject them first
+     * here too, so nothing is created for a request that is going to fail */
+    if (((options & FILE_DELETE_ON_CLOSE) && !(access & (DELETE | GENERIC_ALL))) ||
+        ((options & FILE_DIRECTORY_FILE) && (flags & O_TRUNC)))
+    {
+        *status = STATUS_INVALID_PARAMETER;
+        return -1;
+    }
+
+    if (access & GENERIC_READ)    access |= FILE_GENERIC_READ;
+    if (access & GENERIC_WRITE)   access |= FILE_GENERIC_WRITE;
+    if (access & GENERIC_EXECUTE) access |= FILE_GENERIC_EXECUTE;
+    if (access & GENERIC_ALL)     access |= FILE_ALL_ACCESS;
+
+    if ((options & FILE_DIRECTORY_FILE) && (flags & O_CREAT))
+    {
+        if (mkdirat( root_fd, unix_name, 0700 ) == 0) *created = TRUE;
+        else if (errno != EEXIST || (flags & O_EXCL))
+        {
+            *status = sg_open_errno_to_status( errno );
+            return -1;
+        }
+        flags &= ~(O_CREAT | O_EXCL | O_TRUNC);
+    }
+
+    if ((access & SG_UNIX_WRITE_ACCESS) && !(options & FILE_DIRECTORY_FILE))
+        rw_mode = (access & SG_UNIX_READ_ACCESS) ? O_RDWR : O_WRONLY;
+    else
+        rw_mode = O_RDONLY;
+    rw_mode |= O_NONBLOCK | O_CLOEXEC;
+
+    /* O_TRUNC waits for the server's sharing check. Creating with O_EXCL first
+     * is how we learn whether this call created the file. */
+    if ((flags & O_CREAT) && !(flags & O_EXCL))
+    {
+        fd = openat( root_fd, unix_name, rw_mode | O_CREAT | O_EXCL, 0600 );
+        if (fd != -1) *created = TRUE;
+        else if (errno == EEXIST) fd = openat( root_fd, unix_name, rw_mode );
+    }
+    else
+    {
+        fd = openat( root_fd, unix_name, rw_mode | (flags & (O_CREAT | O_EXCL)), 0600 );
+        if (fd != -1 && (flags & O_CREAT)) *created = TRUE;
+    }
+
+    /* if we tried to open a directory for write access, retry read-only */
+    if (fd == -1 && errno == EISDIR && ((access & SG_UNIX_WRITE_ACCESS) || (flags & O_CREAT)))
+        fd = openat( root_fd, unix_name, O_RDONLY | O_NONBLOCK | O_CLOEXEC );
+
+    if (fd == -1)
+    {
+        size_t len = strlen( unix_name );
+        /* check for trailing slash on file path */
+        if ((errno == ENOENT || (errno == ENOTDIR && !(options & FILE_DIRECTORY_FILE))) &&
+            len && unix_name[len - 1] == '/')
+            *status = STATUS_OBJECT_NAME_INVALID;
+        else
+            *status = sg_open_errno_to_status( errno );
+        if (*created && (options & FILE_DIRECTORY_FILE)) unlinkat( root_fd, unix_name, AT_REMOVEDIR );
+        *created = FALSE;
+        return -1;
+    }
+    return fd;
+}
