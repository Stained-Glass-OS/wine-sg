+        mode = reply->mode;
     }
     SERVER_END_REQ;
+
+    /* a file this call created gets the mode the server chose for it -- from
+     * the security descriptor, or the default -- under this process's umask,
+     * as open() would have applied it */
+    if (created && !status) fchmod( fd, mode & 07777 & ~sg_umask() );
+    close( fd );
     free( objattr );
     return status;
 }
