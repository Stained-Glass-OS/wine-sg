+/* Plays the commands onto the context, keeping the context's drawing state. */
+HRESULT d2d_command_list_replay(ID2D1CommandList *list, ID2D1DeviceContext *context,
+        const D2D1_MATRIX_3X2_F *base)
+{
+    D2D1_TEXT_ANTIALIAS_MODE text_aa;
+    D2D1_PRIMITIVE_BLEND blend;
+    struct d2d_replay_sink sink;
+    D2D1_ANTIALIAS_MODE aa;
+    D2D1_MATRIX_3X2_F m;
+    D2D1_UNIT_MODE unit;
+    HRESULT hr;
+
+    ID2D1DeviceContext_GetTransform(context, &m);
+    aa = ID2D1DeviceContext_GetAntialiasMode(context);
+    text_aa = ID2D1DeviceContext_GetTextAntialiasMode(context);
+    blend = ID2D1DeviceContext_GetPrimitiveBlend(context);
+    unit = ID2D1DeviceContext_GetUnitMode(context);
+
+    sink.ID2D1CommandSink_iface.lpVtbl = &d2d_replay_sink_vtbl;
+    sink.context = context;
+    sink.base = *base;
+    ID2D1DeviceContext_SetTransform(context, base);
+    hr = ID2D1CommandList_Stream(list, &sink.ID2D1CommandSink_iface);
+
+    ID2D1DeviceContext_SetTransform(context, &m);
+    ID2D1DeviceContext_SetAntialiasMode(context, aa);
+    ID2D1DeviceContext_SetTextAntialiasMode(context, text_aa);
+    ID2D1DeviceContext_SetPrimitiveBlend(context, blend);
+    ID2D1DeviceContext_SetUnitMode(context, unit);
+    return hr;
+}
