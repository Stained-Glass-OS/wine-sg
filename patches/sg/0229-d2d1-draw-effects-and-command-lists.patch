+/* Emits one closed figure made of line and cubic segments. "segs" holds
+ * "count" segments; for a line only point3 is used. */
+struct d2d_simple_segment
+{
+    BOOL bezier;
+    D2D1_BEZIER_SEGMENT b;
+};
+
+static void d2d_geometry_emit_figure(ID2D1SimplifiedGeometrySink *sink, D2D1_GEOMETRY_SIMPLIFICATION_OPTION option,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F start,
+        const struct d2d_simple_segment *segs, unsigned int count)
+{
+    D2D1_BEZIER_SEGMENT b;
+    D2D1_POINT_2F p;
+    unsigned int i;
+
+    if (!(tolerance > 0.0f))
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    if (transform)
+        d2d_point_transform(&start, transform, start.x, start.y);
+    ID2D1SimplifiedGeometrySink_BeginFigure(sink, start, D2D1_FIGURE_BEGIN_FILLED);
+    p = start;
+    for (i = 0; i < count; ++i)
+    {
+        b = segs[i].b;
+        if (transform)
+        {
+            d2d_point_transform(&b.point1, transform, b.point1.x, b.point1.y);
+            d2d_point_transform(&b.point2, transform, b.point2.x, b.point2.y);
+            d2d_point_transform(&b.point3, transform, b.point3.x, b.point3.y);
+        }
+        if (!segs[i].bezier)
+            ID2D1SimplifiedGeometrySink_AddLines(sink, &b.point3, 1);
+        else if (option == D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES)
+            d2d_geometry_flatten_cubic(sink, &p, &b, tolerance);
+        else
+            ID2D1SimplifiedGeometrySink_AddBeziers(sink, &b, 1);
+        p = b.point3;
+    }
+    ID2D1SimplifiedGeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+}
+
+/* Quarter arc of an axis-aligned ellipse from (cx + rx * cos a0, ...) to angle a0 + 90 degrees,
+ * given as the two endpoints' unit directions. */
+static void d2d_quarter_arc(struct d2d_simple_segment *seg, float cx, float cy, float rx, float ry,
+        float ux0, float uy0, float ux1, float uy1)
+{
+    static const float k = 0.55228475f;
+
+    seg->bezier = TRUE;
+    d2d_point_set(&seg->b.point1, cx + rx * (ux0 + k * ux1), cy + ry * (uy0 + k * uy1));
+    d2d_point_set(&seg->b.point2, cx + rx * (ux1 + k * ux0), cy + ry * (uy1 + k * uy0));
+    d2d_point_set(&seg->b.point3, cx + rx * ux1, cy + ry * uy1);
+}
