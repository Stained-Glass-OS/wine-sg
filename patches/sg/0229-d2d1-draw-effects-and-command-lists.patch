+static HRESULT STDMETHODCALLTYPE d2d_replay_sink_SetTransform(ID2D1CommandSink *iface, const D2D1_MATRIX_3X2_F *m)
+{
+    struct d2d_replay_sink *sink = impl_from_replay_sink(iface);
+    const D2D1_MATRIX_3X2_F *b = &sink->base;
+    D2D1_MATRIX_3X2_F r;
+
+    r._11 = m->_11 * b->_11 + m->_12 * b->_21;
+    r._12 = m->_11 * b->_12 + m->_12 * b->_22;
+    r._21 = m->_21 * b->_11 + m->_22 * b->_21;
+    r._22 = m->_21 * b->_12 + m->_22 * b->_22;
+    r._31 = m->_31 * b->_11 + m->_32 * b->_21 + b->_31;
+    r._32 = m->_31 * b->_12 + m->_32 * b->_22 + b->_32;
+    ID2D1DeviceContext_SetTransform(sink->context, &r);
+    return S_OK;
+}
