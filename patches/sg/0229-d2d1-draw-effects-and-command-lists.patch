+/* Variable-size fields follow their command in the command list's buffer,
+ * which moves when it grows. So a field's pointer is stored as its offset
+ * from the command, plus one (NULL stays NULL), and resolved when the
+ * command list is streamed. */
+static inline void d2d_command_list_write_field(BYTE **data, const void *command, void *dst, const void *src,
+        size_t size)
+{
+    void **ptr = dst;
+
+    if (!src)
+    {
+        *ptr = NULL;
+        return;
+    }
+
+    *ptr = (void *)(ULONG_PTR)(*data - (const BYTE *)command + 1);
+    memcpy(*data, src, size);
+    *data = *data + size;
+}
+
+static inline void *d2d_command_field(const void *command, const void *field)
+{
+    if (!field)
+        return NULL;
+    return (BYTE *)command + (ULONG_PTR)field - 1;
+}
