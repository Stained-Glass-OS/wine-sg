From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: MsiInstallMissingFile

MsiInstallMissingFile finds the component the file belongs to in the File table of the product's cached package (by its long or short name; a path's directory is ignored) and installs it the way MsiInstallMissingComponent does, through the feature that owns it. It was a spec stub; msi.h gains it.
---
--- a/include/msi.h
+++ b/include/msi.h
@@ -705,6 +705,9 @@
 UINT WINAPI MsiInstallMissingComponentA(LPCSTR, LPCSTR, INSTALLSTATE);
 UINT WINAPI MsiInstallMissingComponentW(LPCWSTR, LPCWSTR, INSTALLSTATE);
 #define     MsiInstallMissingComponent WINELIB_NAME_AW(MsiInstallMissingComponent)
+UINT WINAPI MsiInstallMissingFileA(LPCSTR, LPCSTR);
+UINT WINAPI MsiInstallMissingFileW(LPCWSTR, LPCWSTR);
+#define     MsiInstallMissingFile WINELIB_NAME_AW(MsiInstallMissingFile)
 
 UINT WINAPI MsiDetermineApplicablePatchesA(LPCSTR, DWORD, PMSIPATCHSEQUENCEINFOA);
 UINT WINAPI MsiDetermineApplicablePatchesW(LPCWSTR, DWORD, PMSIPATCHSEQUENCEINFOW);
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -4988,6 +4988,91 @@
     return MsiConfigureFeatureW( szProduct, feature, eInstallState );
 }
 
+#ifndef SG_MUTANT_NO_MISSINGFILE
+/* (wine-sg 8250) MsiInstallMissingFile: the component the file belongs to, from the File table of the
+ * product's cached package (matched on its long or short name), is installed like MsiInstallMissingComponent
+ * does it */
+UINT WINAPI MsiInstallMissingFileW( const WCHAR *product, const WCHAR *file )
+{
+    WCHAR package[MAX_PATH], component[39] = L"", name[MAX_PATH], key[73];
+    const WCHAR *base, *bar;
+    MSIHANDLE db = 0, view = 0, rec = 0, param;
+    DWORD len = ARRAY_SIZE(package), size;
+    UINT r;
+
+    TRACE( "%s, %s\n", debugstr_w(product), debugstr_w(file) );
+
+    if (!product || !file || !*file) return ERROR_INVALID_PARAMETER;
+    base = wcsrchr( file, '\\' );
+    base = base ? base + 1 : file;
+
+    r = MsiGetProductInfoW( product, INSTALLPROPERTY_LOCALPACKAGEW, package, &len );
+    if (r == ERROR_UNKNOWN_PRODUCT || r == ERROR_INVALID_PARAMETER) return r;
+    if (r || MsiOpenDatabaseW( package, MSIDBOPEN_READONLY, &db )) return ERROR_BAD_CONFIGURATION;
+
+    r = ERROR_FILE_NOT_FOUND;
+    *key = 0;
+    if (!MsiDatabaseOpenViewW( db, L"SELECT `Component_`, `FileName` FROM `File`", &view ) && !MsiViewExecute( view, 0 ))
+    {
+        while (!MsiViewFetch( view, &rec ))
+        {
+            size = ARRAY_SIZE(name);
+            if (!MsiRecordGetStringW( rec, 2, name, &size ))
+            {
+                /* "SHORT~1.EXT|long name.ext" or one name */
+                bar = wcschr( name, '|' );
+                if (!wcsicmp( bar ? bar + 1 : name, base ) || (bar && !wcsnicmp( name, base, bar - name ) && !base[bar - name]))
+                {
+                    size = ARRAY_SIZE(key);
+                    MsiRecordGetStringW( rec, 1, key, &size );
+                    MsiCloseHandle( rec );
+                    break;
+                }
+            }
+            MsiCloseHandle( rec );
+        }
+        MsiViewClose( view );
+    }
+    MsiCloseHandle( view );
+    view = 0;
+    if (*key && !MsiDatabaseOpenViewW( db, L"SELECT `ComponentId` FROM `Component` WHERE `Component` = ?", &view ))
+    {
+        param = MsiCreateRecord( 1 );
+        MsiRecordSetStringW( param, 1, key );
+        if (!MsiViewExecute( view, param ) && !MsiViewFetch( view, &rec ))
+        {
+            size = ARRAY_SIZE(component);
+            if (MsiRecordGetStringW( rec, 1, component, &size )) *component = 0;
+            MsiCloseHandle( rec );
+        }
+        MsiCloseHandle( param );
+        MsiViewClose( view );
+        MsiCloseHandle( view );
+    }
+    MsiCloseHandle( db );
+    if (!*key) return r;
+    if (!*component) return ERROR_BAD_CONFIGURATION;
+    return MsiInstallMissingComponentW( product, component, INSTALLSTATE_DEFAULT );
+}
+
+UINT WINAPI MsiInstallMissingFileA( const char *product, const char *file )
+{
+    WCHAR *productW = NULL, *fileW = NULL;
+    UINT r = ERROR_OUTOFMEMORY;
+
+    if (product && !(productW = strdupAtoW( product ))) goto done;
+    if (file && !(fileW = strdupAtoW( file ))) goto done;
+    r = MsiInstallMissingFileW( productW, fileW );
+done:
+    free( productW );
+    free( fileW );
+    return r;
+}
+#else
+UINT WINAPI MsiInstallMissingFileW( const WCHAR *product, const WCHAR *file ) { return ERROR_CALL_NOT_IMPLEMENTED; }
+UINT WINAPI MsiInstallMissingFileA( const char *product, const char *file ) { return ERROR_CALL_NOT_IMPLEMENTED; }
+#endif
+
 UINT WINAPI MsiProvideComponentA( const char *product, const char *feature, const char *component, DWORD mode,
                                   char *buf, DWORD *buflen )
 {
--- a/dlls/msi/msi.spec
+++ b/dlls/msi/msi.spec
@@ -78,8 +78,8 @@
 82 stdcall MsiGetUserInfoW(wstr ptr ptr ptr ptr ptr ptr)
 83 stdcall MsiInstallMissingComponentA(str str long)
 84 stdcall MsiInstallMissingComponentW(wstr wstr long)
-85 stub MsiInstallMissingFileA
-86 stub MsiInstallMissingFileW
+85 stdcall MsiInstallMissingFileA(str str)
+86 stdcall MsiInstallMissingFileW(wstr wstr)
 87 stdcall MsiInstallProductA(str str)
 88 stdcall MsiInstallProductW(wstr wstr)
 89 stdcall MsiLocateComponentA(str ptr ptr)
