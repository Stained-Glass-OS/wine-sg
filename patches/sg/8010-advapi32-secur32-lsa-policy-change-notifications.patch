From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32, secur32: LsaRegisterPolicyChangeNotification and LsaUnregisterPolicyChangeNotification

secur32's were spec stubs (pywin32's win32security in Anki and BleachBit imports them) and advapi32's register failed with STATUS_UNSUCCESSFUL. A registration is kept with a duplicate of the event, as the LSA keeps its own: the class must be one of POLICY_NOTIFICATION_INFORMATION_CLASS, the handle an event (else STATUS_INVALID_PARAMETER / STATUS_INVALID_HANDLE); unregistering what was not registered is STATUS_INVALID_HANDLE. No policy of these classes changes here (LsaSetInformationPolicy does not write), so nothing is signalled. secur32 forwards to advapi32.
---
--- a/dlls/advapi32/lsa.c
+++ b/dlls/advapi32/lsa.c
@@ -33,6 +33,7 @@
 #include "advapi32_misc.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(advapi);
 
@@ -974,6 +975,31 @@
     return STATUS_OBJECT_NAME_NOT_FOUND;
 }
 
+/* Stained Glass OS (wine-sg 8010): the registrations are kept (with a duplicate of the event, as the LSA keeps
+ * its own) instead of failing. No policy in these classes changes here -- LsaSetInformationPolicy does not
+ * write -- so no event is signalled, which is what Windows does while the policy stays as it is. */
+struct policy_notify
+{
+    struct list entry;
+    POLICY_NOTIFICATION_INFORMATION_CLASS class;
+    HANDLE event;  /* the caller's */
+    HANDLE dup;    /* ours */
+};
+static struct list policy_notifies = LIST_INIT( policy_notifies );
+static CRITICAL_SECTION policy_notify_cs;
+static CRITICAL_SECTION_DEBUG policy_notify_cs_debug =
+{
+    0, 0, &policy_notify_cs,
+    { &policy_notify_cs_debug.ProcessLocksList, &policy_notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": policy_notify_cs") }
+};
+static CRITICAL_SECTION policy_notify_cs = { &policy_notify_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL policy_notify_class_valid( POLICY_NOTIFICATION_INFORMATION_CLASS class )
+{
+    return class >= PolicyNotifyAuditEventsInformation && class <= PolicyNotifyMachineAccountPasswordInformation;
+}
+
 /******************************************************************************
  * LsaRegisterPolicyChangeNotification [ADVAPI32.@]
  *
@@ -982,8 +1008,33 @@
     POLICY_NOTIFICATION_INFORMATION_CLASS class,
     HANDLE event)
 {
-    FIXME("(%d,%p) stub\n", class, event);
+    struct policy_notify *notify;
+    EVENT_BASIC_INFORMATION info;
+    NTSTATUS status;
+
+    TRACE("(%d,%p)\n", class, event);
+
+#ifndef SG_MUTANT_NO_POLICY_NOTIFY
+    if (!policy_notify_class_valid( class )) return STATUS_INVALID_PARAMETER;
+    if (!event) return STATUS_INVALID_HANDLE;
+    if ((status = NtQueryEvent( event, EventBasicInformation, &info, sizeof(info), NULL )))
+        return status == STATUS_OBJECT_TYPE_MISMATCH ? STATUS_INVALID_HANDLE : status;
+    if (!(notify = malloc( sizeof(*notify) ))) return STATUS_NO_MEMORY;
+    if ((status = NtDuplicateObject( GetCurrentProcess(), event, GetCurrentProcess(), &notify->dup,
+                                     0, 0, DUPLICATE_SAME_ACCESS )))
+    {
+        free( notify );
+        return status;
+    }
+    notify->class = class;
+    notify->event = event;
+    EnterCriticalSection( &policy_notify_cs );
+    list_add_tail( &policy_notifies, &notify->entry );
+    LeaveCriticalSection( &policy_notify_cs );
+    return STATUS_SUCCESS;
+#else
     return STATUS_UNSUCCESSFUL;
+#endif
 }
 
 /******************************************************************************
@@ -1131,7 +1182,24 @@
     POLICY_NOTIFICATION_INFORMATION_CLASS class,
     HANDLE event)
 {
-    FIXME("(%d,%p) stub\n", class, event);
+    struct policy_notify *notify, *found = NULL;
+
+    TRACE("(%d,%p)\n", class, event);
+
+    if (!policy_notify_class_valid( class )) return STATUS_INVALID_PARAMETER;
+    if (!event) return STATUS_INVALID_HANDLE;
+    EnterCriticalSection( &policy_notify_cs );
+    LIST_FOR_EACH_ENTRY( notify, &policy_notifies, struct policy_notify, entry )
+    {
+        if (notify->class != class || notify->event != event) continue;
+        list_remove( &notify->entry );
+        found = notify;
+        break;
+    }
+    LeaveCriticalSection( &policy_notify_cs );
+    if (!found) return STATUS_INVALID_HANDLE;
+    NtClose( found->dup );
+    free( found );
     return STATUS_SUCCESS;
 }
 
--- a/dlls/secur32/secur32.spec
+++ b/dlls/secur32/secur32.spec
@@ -41,8 +41,8 @@
 @ stdcall LsaLogonUser(ptr ptr long long ptr long ptr ptr ptr ptr ptr ptr ptr ptr)
 @ stdcall LsaLookupAuthenticationPackage(ptr ptr ptr)
 @ stdcall LsaRegisterLogonProcess(ptr ptr ptr)
-@ stub LsaRegisterPolicyChangeNotification
-@ stub LsaUnregisterPolicyChangeNotification
+@ stdcall LsaRegisterPolicyChangeNotification(long long) advapi32.LsaRegisterPolicyChangeNotification
+@ stdcall LsaUnregisterPolicyChangeNotification(long long) advapi32.LsaUnregisterPolicyChangeNotification
 @ stdcall MakeSignature(ptr long ptr long)
 @ stdcall QueryContextAttributesA(ptr long ptr)
 @ stdcall QueryContextAttributesW(ptr long ptr)
--- a/dlls/advapi32/tests/lsa.c
+++ b/dlls/advapi32/tests/lsa.c
@@ -501,6 +501,20 @@
     LsaFreeMemory(lsa_domain);
 }
 
+static void test_LsaPolicyChangeNotification(void)
+{
+    HANDLE event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    NTSTATUS status;
+
+    status = LsaRegisterPolicyChangeNotification(PolicyNotifyAuditEventsInformation, event);
+    ok(!status, "got %#lx\n", status);
+    status = LsaRegisterPolicyChangeNotification(PolicyNotifyAuditEventsInformation, NULL);
+    ok(status == STATUS_INVALID_HANDLE, "got %#lx\n", status);
+    status = LsaUnregisterPolicyChangeNotification(PolicyNotifyAuditEventsInformation, event);
+    ok(!status, "got %#lx\n", status);
+    CloseHandle(event);
+}
+
 START_TEST(lsa)
 {
     HMODULE hkernel32 = GetModuleHandleA("kernel32.dll");
@@ -514,4 +528,5 @@
     test_LsaLookupSids();
     test_LsaLookupPrivilegeName();
     test_LsaGetUserName();
+    test_LsaPolicyChangeNotification();
 }
