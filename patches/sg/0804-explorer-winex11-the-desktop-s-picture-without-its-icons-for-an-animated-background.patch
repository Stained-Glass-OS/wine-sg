From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, winex11: the desktop's picture without its icons, for an animated background

An animated background (Settings > Personalization > Background; David
2026-10-02: "an active background instead of the single wallpaper") is
drawn by sg-deskcomp under the icons. While one is chosen
(HKCU\Software\Stained Glass\Effects AnimatedBackground), explorer hands
the display driver the desktop's picture without its icons too (escape
0x5348) before the whole one (0610); winex11 names it on the desktop
window, _SG_WALLPAPER_PIXMAP. The compositor draws the moving background
from it and the icons over it: the pixels where the desktop's picture is
not the wallpaper. Test: sg-compositor's test/animbg-gate.sh (mutant
SG_MUTANT_NO_WALLPAPER).
---
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -338,6 +338,7 @@
     X11DRV_START_EXPOSURES,  /* start graphics exposures */
     X11DRV_END_EXPOSURES,    /* end graphics exposures */
     X11DRV_SG_DESKTOP_BACKGROUND = 0x5347, /* Stained Glass OS: the desktop's picture, for X to show */
+    X11DRV_SG_DESKTOP_WALLPAPER = 0x5348,  /* Stained Glass OS: the desktop's picture without its icons */
 };
 
 /* The virtual desktop's picture -- wallpaper and icons, 32-bit top-down BGRX,
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -308,6 +308,48 @@
     return TRUE;
 }
 
+/* Stained Glass OS: the desktop's picture without its icons -- the wallpaper
+ * alone -- for the desktop's compositor's animated background (sg-deskcomp
+ * draws it moving, then the icons over it: the pixels where the desktop's
+ * picture is not the wallpaper). Named on the desktop window as
+ * _SG_WALLPAPER_PIXMAP until the next replaces it; explorer sends it only
+ * while an animated background is chosen. */
+static BOOL set_desktop_wallpaper( const struct x11drv_escape_sg_background *bg )
+{
+    static Pixmap published;
+    static Atom prop;
+    XImage *image;
+    Pixmap pixmap;
+    GC gc;
+
+    if (!is_virtual_desktop() || root_window == DefaultRootWindow( gdi_display )) return FALSE;
+    if (!bg->bits || bg->width <= 0 || bg->height <= 0 || bg->width > 16384 || bg->height > 16384) return FALSE;
+    if (default_visual.class != TrueColor || (default_visual.depth != 24 && default_visual.depth != 32) ||
+        default_visual.red_mask != 0xff0000 || default_visual.green_mask != 0xff00 || default_visual.blue_mask != 0xff)
+        return FALSE;
+    if (!(image = XCreateImage( gdi_display, default_visual.visual, default_visual.depth, ZPixmap, 0,
+                                (char *)bg->bits, bg->width, bg->height, 32, bg->width * 4 )))
+        return FALSE;
+    if (image->bits_per_pixel != 32 || image->byte_order != LSBFirst)
+    {
+        image->data = NULL;
+        XDestroyImage( image );
+        return FALSE;
+    }
+    pixmap = XCreatePixmap( gdi_display, root_window, bg->width, bg->height, default_visual.depth );
+    gc = XCreateGC( gdi_display, pixmap, 0, NULL );
+    XPutImage( gdi_display, pixmap, gc, image, 0, 0, 0, 0, bg->width, bg->height );
+    XFreeGC( gdi_display, gc );
+    if (!prop) prop = XInternAtom( gdi_display, "_SG_WALLPAPER_PIXMAP", False );
+    XChangeProperty( gdi_display, root_window, prop, XA_PIXMAP, 32, PropModeReplace, (unsigned char *)&pixmap, 1 );
+    if (published) XFreePixmap( gdi_display, published );
+    published = pixmap;
+    XFlush( gdi_display );
+    image->data = NULL;
+    XDestroyImage( image );
+    return TRUE;
+}
+
 static INT X11DRV_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID in_data,
                              INT out_count, LPVOID out_data )
 {
@@ -360,6 +402,10 @@
                 if (in_count >= sizeof(struct x11drv_escape_sg_background))
                     return set_desktop_background( in_data );
                 break;
+            case X11DRV_SG_DESKTOP_WALLPAPER:
+                if (in_count >= sizeof(struct x11drv_escape_sg_background))
+                    return set_desktop_wallpaper( in_data );
+                break;
             case X11DRV_START_EXPOSURES:
                 XSetGraphicsExposures( gdi_display, physDev->gc, True );
                 physDev->exposures = 0;
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -1617,7 +1617,24 @@
     if ((dib = CreateDIBSection( hdc, &bi, DIB_RGB_COLORS, &bits, NULL, 0 )))
     {
         HGDIOBJ old = SelectObject( mem, dib );
+        DWORD animated = 0, size = sizeof(animated);
         PaintDesktop( mem );
+        /* an animated background (Settings > Personalization > Background):
+         * the desktop's compositor draws it under the icons, and needs the
+         * wallpaper without them first */
+        RegGetValueW( HKEY_CURRENT_USER, L"Software\\Stained Glass\\Effects", L"AnimatedBackground",
+                      RRF_RT_REG_DWORD, NULL, &animated, &size );
+#ifndef SG_MUTANT_NO_WALLPAPER
+        if (animated)
+        {
+            GdiFlush();
+            esc.code = 0x5348;
+            esc.width = rc.right;
+            esc.height = rc.bottom;
+            esc.bits = bits;
+            ExtEscape( hdc, 6789 /* X11DRV_ESCAPE */, sizeof(esc), (const char *)&esc, 0, NULL );
+        }
+#endif
         draw_launchers( mem, rc );
         GdiFlush();
         esc.code = 0x5347;
