From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.media.mediacontrol: Create*AudioStateMonitorForCategory / ForCategoryAndDeviceRole

The four category and device-role factory functions (capture and render)
return monitors; the category and role are accepted and not interpreted.

---
diff --git a/dlls/windows.media.mediacontrol/audiostate.c b/dlls/windows.media.mediacontrol/audiostate.c
index 68f3b0f..2fd2b25 100644
--- a/dlls/windows.media.mediacontrol/audiostate.c
+++ b/dlls/windows.media.mediacontrol/audiostate.c
@@ -202,8 +202,34 @@ HRESULT WINAPI CreateCaptureAudioStateMonitor( IAudioStateMonitor **monitor )
     return create_monitor( TRUE, monitor );
 }
 
+HRESULT WINAPI CreateCaptureAudioStateMonitorForCategory( AUDIO_STREAM_CATEGORY category, IAudioStateMonitor **monitor )
+{
+    TRACE( "category %d, monitor %p\n", category, monitor );
+    return create_monitor( TRUE, monitor );
+}
+
+HRESULT WINAPI CreateCaptureAudioStateMonitorForCategoryAndDeviceRole( AUDIO_STREAM_CATEGORY category, ERole role,
+                                                                       IAudioStateMonitor **monitor )
+{
+    TRACE( "category %d, role %d, monitor %p\n", category, role, monitor );
+    return create_monitor( TRUE, monitor );
+}
+
 HRESULT WINAPI CreateRenderAudioStateMonitor( IAudioStateMonitor **monitor )
 {
     TRACE( "monitor %p\n", monitor );
     return create_monitor( FALSE, monitor );
 }
+
+HRESULT WINAPI CreateRenderAudioStateMonitorForCategory( AUDIO_STREAM_CATEGORY category, IAudioStateMonitor **monitor )
+{
+    TRACE( "category %d, monitor %p\n", category, monitor );
+    return create_monitor( FALSE, monitor );
+}
+
+HRESULT WINAPI CreateRenderAudioStateMonitorForCategoryAndDeviceRole( AUDIO_STREAM_CATEGORY category, ERole role,
+                                                                      IAudioStateMonitor **monitor )
+{
+    TRACE( "category %d, role %d, monitor %p\n", category, role, monitor );
+    return create_monitor( FALSE, monitor );
+}
diff --git a/dlls/windows.media.mediacontrol/windows.media.mediacontrol.spec b/dlls/windows.media.mediacontrol/windows.media.mediacontrol.spec
index 92bf9d5..d812967 100644
--- a/dlls/windows.media.mediacontrol/windows.media.mediacontrol.spec
+++ b/dlls/windows.media.mediacontrol/windows.media.mediacontrol.spec
@@ -1,11 +1,11 @@
 @ stdcall CreateCaptureAudioStateMonitor(ptr)
-@ stub CreateCaptureAudioStateMonitorForCategory
+@ stdcall CreateCaptureAudioStateMonitorForCategory(long ptr)
 @ stub CreateCaptureAudioStateMonitorForCategoryAndDeviceId
-@ stub CreateCaptureAudioStateMonitorForCategoryAndDeviceRole
+@ stdcall CreateCaptureAudioStateMonitorForCategoryAndDeviceRole(long long ptr)
 @ stdcall CreateRenderAudioStateMonitor(ptr)
-@ stub CreateRenderAudioStateMonitorForCategory
+@ stdcall CreateRenderAudioStateMonitorForCategory(long ptr)
 @ stub CreateRenderAudioStateMonitorForCategoryAndDeviceId
-@ stub CreateRenderAudioStateMonitorForCategoryAndDeviceRole
+@ stdcall CreateRenderAudioStateMonitorForCategoryAndDeviceRole(long long ptr)
 @ stdcall -private DllCanUnloadNow()
 @ stdcall -private DllGetActivationFactory(ptr ptr)
 @ stdcall -private DllGetClassObject(ptr ptr ptr)
