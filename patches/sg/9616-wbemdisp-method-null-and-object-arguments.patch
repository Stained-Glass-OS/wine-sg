From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemdisp: script method calls take Null and SWbemObject arguments (9616)

Microsoft's samples start a process with
objProcess.Create("notepad.exe", Null, objConfig, intProcessID), objConfig
being a Win32_ProcessStartup instance (SpawnInstance_). wbemdisp converted
every argument to its parameter's type: Null for the CurrentDirectory string
failed with "Type mismatch", and the SWbemObject for the object parameter
reached wbemprox as an IDispatch it could not use (WBEM_E_TYPE_MISMATCH).
Null (also held in a variable) now leaves the parameter without a value, as an
argument left out does, and an SWbemObject for an object parameter goes in as
the WMI object it wraps.
---
--- a/dlls/wbemdisp/locator.c
+++ b/dlls/wbemdisp/locator.c
@@ -2827,6 +2827,8 @@
     return S_OK;
 }
 
+static const ISWbemObjectVtbl object_vtbl;
+
 /* obj.Method( args ): the arguments are the method's parameters in ID order */
 static HRESULT object_call_method( struct object *object, const WCHAR *method, DISPPARAMS *params, VARIANT *result )
 {
@@ -2858,6 +2860,29 @@
         if (V_VT( arg ) == VT_ERROR && V_ERROR( arg ) == DISP_E_PARAMNOTFOUND) continue;
         if (!list[i].in) continue;
         VariantInit( &conv );
+        if (V_VT( arg ) == (VT_BYREF | VT_VARIANT)) arg = V_VARIANTREF( arg );
+#ifndef SG_MUTANT_WBEM_NULL_ARG_CONVERTED
+        /* Null is "no value" for any parameter, as an argument left out is -- Win32_Process.Create(
+         * cmd, Null, Null, pid), the way Microsoft's own samples call it (wine-sg 9616) */
+        if (V_VT( arg ) == VT_NULL) continue;
+#endif
+#ifndef SG_MUTANT_WBEM_OBJECT_ARG_WRAPPED
+        /* an SWbemObject for an object parameter (a Win32_ProcessStartup instance for
+         * Win32_Process.Create) goes in as the WMI object it stands for */
+        if ((list[i].type & ~CIM_FLAG_ARRAY) == CIM_OBJECT && V_VT( arg ) == VT_DISPATCH &&
+            V_DISPATCH( arg ) && V_DISPATCH( arg )->lpVtbl == (IDispatchVtbl *)&object_vtbl)
+        {
+            struct object *obj = CONTAINING_RECORD( (ISWbemObject *)V_DISPATCH( arg ), struct object, ISWbemObject_iface );
+
+            V_VT( &conv ) = VT_UNKNOWN;
+            V_UNKNOWN( &conv ) = (IUnknown *)obj->object;
+            IUnknown_AddRef( V_UNKNOWN( &conv ) );
+            hr = IWbemClassObject_Put( in_inst, list[i].name, 0, &conv, 0 );
+            VariantClear( &conv );
+            if (FAILED(hr)) goto done;
+            continue;
+        }
+#endif
         if ((list[i].type & CIM_FLAG_ARRAY) || !(vt = to_vartype( list[i].type ))) hr = VariantCopyInd( &conv, arg );
         else hr = VariantChangeType( &conv, arg, 0, vt );
         if (FAILED(hr)) goto done;
