From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9_36: ID3DXFileEnumObject lookups, SetRawValue, D3DXCreateText adjacency (3536)

d3dx9_36: ID3DXFileEnumObject lookups, SetRawValue, D3DXCreateText adjacency

ID3DXFileEnumObject::GetFile, GetDataObjectById and GetDataObjectByName work (top-level objects; D3DXFERR_NOTFOUND); ID3DXEffect::SetRawValue copies bytes into a parameter at an offset with bounds checks; D3DXCreateTextA/W return the adjacency buffer when asked (generated from the mesh). Left alone: ID3DXFileData::GetEnum, the effect compiler, fragment linker, texture shaders, teapot, N-patch tessellation, D3DXOptimizeFaces/Vertices (Wine's tests record Windows' results).
---
--- a/dlls/d3dx9_36/xfile.c
+++ b/dlls/d3dx9_36/xfile.c
@@ -56,6 +56,7 @@
 {
     ID3DXFileEnumObject ID3DXFileEnumObject_iface;
     LONG ref;
+    struct d3dx9_file *file;    /* the file object that made the enumeration */
     unsigned int child_count;
     ID3DXFileData **children;
 };
@@ -492,6 +493,7 @@
             child->lpVtbl->Release(child);
         }
         free(file_enum->children);
+        if (file_enum->file) file_enum->file->ID3DXFile_iface.lpVtbl->Release(&file_enum->file->ID3DXFile_iface);
         free(file_enum);
     }
 
@@ -500,9 +502,17 @@
 
 static HRESULT WINAPI d3dx9_file_enum_object_GetFile(ID3DXFileEnumObject *iface, ID3DXFile **file)
 {
-    FIXME("iface %p, file %p stub!\n", iface, file);
+    struct d3dx9_file_enum_object *file_enum = impl_from_ID3DXFileEnumObject(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, file %p.\n", iface, file);
+
+    if (!file)
+        return E_POINTER;
+
+    *file = &file_enum->file->ID3DXFile_iface;
+    (*file)->lpVtbl->AddRef(*file);
+
+    return S_OK;
 }
 
 static HRESULT WINAPI d3dx9_file_enum_object_GetChildren(ID3DXFileEnumObject *iface, SIZE_T *children)
@@ -537,17 +547,64 @@
 static HRESULT WINAPI d3dx9_file_enum_object_GetDataObjectById(ID3DXFileEnumObject *iface,
         REFGUID guid, ID3DXFileData **object)
 {
-    FIXME("iface %p, guid %s, object %p stub!\n", iface, debugstr_guid(guid), object);
+    struct d3dx9_file_enum_object *file_enum = impl_from_ID3DXFileEnumObject(iface);
+    unsigned int i;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, guid %s, object %p.\n", iface, debugstr_guid(guid), object);
+
+    if (!guid || !object)
+        return E_POINTER;
+
+    *object = NULL;
+    for (i = 0; i < file_enum->child_count; ++i)
+    {
+        GUID id;
+
+        if (SUCCEEDED(file_enum->children[i]->lpVtbl->GetId(file_enum->children[i], &id)) && IsEqualGUID(&id, guid))
+        {
+            *object = file_enum->children[i];
+            (*object)->lpVtbl->AddRef(*object);
+            return S_OK;
+        }
+    }
+
+    return D3DXFERR_NOTFOUND;
 }
 
 static HRESULT WINAPI d3dx9_file_enum_object_GetDataObjectByName(ID3DXFileEnumObject *iface,
         const char *name, ID3DXFileData **object)
 {
-    FIXME("iface %p, name %s, object %p stub!\n", iface, debugstr_a(name), object);
+    struct d3dx9_file_enum_object *file_enum = impl_from_ID3DXFileEnumObject(iface);
+    unsigned int i;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, name %s, object %p.\n", iface, debugstr_a(name), object);
+
+    if (!name || !object)
+        return E_POINTER;
+
+    *object = NULL;
+    for (i = 0; i < file_enum->child_count; ++i)
+    {
+        SIZE_T size = 0;
+        char *child_name;
+        BOOL match = FALSE;
+
+        if (FAILED(file_enum->children[i]->lpVtbl->GetName(file_enum->children[i], NULL, &size)) || !size)
+            continue;
+        if (!(child_name = malloc(size)))
+            return E_OUTOFMEMORY;
+        if (SUCCEEDED(file_enum->children[i]->lpVtbl->GetName(file_enum->children[i], child_name, &size)))
+            match = !strcmp(child_name, name);
+        free(child_name);
+        if (match)
+        {
+            *object = file_enum->children[i];
+            (*object)->lpVtbl->AddRef(*object);
+            return S_OK;
+        }
+    }
+
+    return D3DXFERR_NOTFOUND;
 }
 
 static const ID3DXFileEnumObjectVtbl d3dx9_file_enum_object_vtbl =
@@ -664,11 +721,14 @@
 
     object->ID3DXFileEnumObject_iface.lpVtbl = &d3dx9_file_enum_object_vtbl;
     object->ref = 1;
+    object->file = file;
+    iface->lpVtbl->AddRef(iface);
 
     ret = IDirectXFile_CreateEnumObject(file->dxfile, dxfile_source, dxfile_options, &dxfile_enum_object);
 
     if (ret != S_OK)
     {
+        iface->lpVtbl->Release(iface);
         free(object);
         return ret;
     }
--- a/dlls/d3dx9_36/effect.c
+++ b/dlls/d3dx9_36/effect.c
@@ -4438,10 +4438,29 @@
 static HRESULT WINAPI d3dx_effect_SetRawValue(ID3DXEffect *iface, D3DXHANDLE parameter, const void *data,
         UINT byte_offset, UINT bytes)
 {
-    FIXME("iface %p, parameter %p, data %p, byte_offset %u, bytes %u stub!\n",
-            iface, parameter, data, byte_offset, bytes);
+    struct d3dx_effect *effect = impl_from_ID3DXEffect(iface);
+    struct d3dx_parameter *param = get_valid_parameter(effect, parameter);
+    void *param_data;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, parameter %p, data %p, byte_offset %u, bytes %u.\n", iface, parameter, data, byte_offset, bytes);
+
+    if (!param)
+    {
+        WARN("Invalid parameter %p specified.\n", parameter);
+        return D3DERR_INVALIDCALL;
+    }
+    if (param->class == D3DXPC_OBJECT || !data || byte_offset > param->bytes || bytes > param->bytes - byte_offset)
+    {
+        WARN("Invalid argument specified.\n");
+        return D3DERR_INVALIDCALL;
+    }
+    if (!bytes)
+        return D3D_OK;
+
+    param_data = param_get_data_and_dirtify(effect, param, param->bytes, TRUE);
+    memcpy((BYTE *)param_data + byte_offset, data, bytes);
+
+    return D3D_OK;
 }
 #endif
 
