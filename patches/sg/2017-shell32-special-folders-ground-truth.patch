+/* Stained Glass OS: a name handed to a file system folder to parse is made of
+ * elements between backslashes; "." and "..", empty elements, a leading
+ * backslash and forward slashes are not names (a trailing backslash is) */
+BOOL SHELL32_IsValidParseName(const WCHAR *name, BOOL allow_slash_root)
+{
+    const WCHAR *p = name;
+
+    if (allow_slash_root && name[0] == '/') return TRUE;
+    if (!wcsnicmp(name, L"\\\\?\\unix\\", 9)) return TRUE;
+    if (name[0] == '\\') return FALSE;
+    while (*p)
+    {
+        const WCHAR *end = p;
+        SIZE_T len;
+
+        while (*end && *end != '\\') end++;
+        len = end - p;
+        if ((len == 1 && p[0] == '.') || (len == 2 && p[0] == '.' && p[1] == '.')) return FALSE;
+        { SIZE_T k; for (k = 0; k < len; k++) if (p[k] == '/') return FALSE; }
+        if (!*end) break;
+        p = end + 1;
+        if (*p == '\\') return FALSE;
+    }
+    return TRUE;
+}
+
