From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:10:00 -0700
Subject: [PATCH] winex11: pre-edit caret moves by word, to line end, clamps
 (3239)

xic_preedit_caret answered "Not implemented" for XIMLineEnd and the
up/down/line moves and treated word moves as single characters. Word moves
now stop at the next/previous word boundary of the composition string,
XIMLineEnd goes to its end, the single-line pre-edit ignores up/down/line
moves, and the caret is clamped to the string. The caret reported by a
pre-edit draw callback is remembered so later relative moves start from it.
CORE review: not run against a real input method server (compiled only).

diff --git a/dlls/winex11.drv/xim.c b/dlls/winex11.drv/xim.c
index acbe1c3..4ef6d9c 100644
--- a/dlls/winex11.drv/xim.c
+++ b/dlls/winex11.drv/xim.c
@@ -45,6 +45,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(xim);
 #endif
 
 static WCHAR *ime_comp_buf;
+static int xim_caret_pos;
 
 static XIMStyle input_style = 0;
 static XIMStyle input_style_req = XIMPreeditCallbacks | XIMStatusCallbacks;
@@ -202,36 +203,51 @@ static int xic_preedit_draw( XIC xic, XPointer user, XPointer arg )
 
     if (text && str != text->string.multi_byte) free( str );
 
+    xim_caret_pos = params->caret;
     post_ime_update( hwnd, params->caret, ime_comp_buf, NULL );
 
     return 0;
 }
 
+static BOOL xim_is_space( WCHAR c )
+{
+    return (c >= 9 && c <= 13) || c == ' ' || c == 0x3000;
+}
+
 static int xic_preedit_caret( XIC xic, XPointer user, XPointer arg )
 {
-    static int xim_caret_pos;
     XIMPreeditCaretCallbackStruct *params = (void *)arg;
     HWND hwnd = (HWND)user;
-    int pos;
+    int pos, len;
 
     TRACE( "xic %p, hwnd %p, arg %p\n", xic, hwnd, arg );
 
     if (!params) return 0;
 
     pos = xim_caret_pos;
+    len = ime_comp_buf ? wcslen( ime_comp_buf ) : 0;
     switch (params->direction)
     {
     case XIMForwardChar:
-    case XIMForwardWord:
         pos++;
         break;
     case XIMBackwardChar:
-    case XIMBackwardWord:
         pos--;
         break;
+    case XIMForwardWord:
+        while (pos < len && !xim_is_space( ime_comp_buf[pos] )) pos++;
+        while (pos < len && xim_is_space( ime_comp_buf[pos] )) pos++;
+        break;
+    case XIMBackwardWord:
+        while (pos > 0 && pos <= len && xim_is_space( ime_comp_buf[pos - 1] )) pos--;
+        while (pos > 0 && pos <= len && !xim_is_space( ime_comp_buf[pos - 1] )) pos--;
+        break;
     case XIMLineStart:
         pos = 0;
         break;
+    case XIMLineEnd:
+        pos = len;
+        break;
     case XIMAbsolutePosition:
         pos = params->position;
         break;
@@ -242,10 +258,11 @@ static int xic_preedit_caret( XIC xic, XPointer user, XPointer arg )
     case XIMCaretDown:
     case XIMPreviousLine:
     case XIMNextLine:
-    case XIMLineEnd:
-        FIXME( "Not implemented\n" );
+        /* the pre-edit text is a single line: nothing to move to */
         break;
     }
+    if (pos < 0) pos = 0;
+    if (pos > len) pos = len;
     params->position = xim_caret_pos = pos;
 
     post_ime_update( hwnd, pos, ime_comp_buf, NULL );
