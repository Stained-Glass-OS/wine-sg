+/* The pairs are separated by '&' and split at the first '='; a leading '?' is
+ * not part of the first name. An empty piece is no pair. */
+static HRESULT decoder_create(const WCHAR *query, UINT32 len, IWwwFormUrlDecoderRuntimeClass **ret)
+{
+    const WCHAR *end = query + len, *p, *amp, *eq;
+    struct decoder *decoder;
+    struct entry **entries;
+    HRESULT hr = S_OK;
+
+    *ret = NULL;
+    if (!(decoder = calloc(1, sizeof(*decoder)))) return E_OUTOFMEMORY;
+    decoder->IWwwFormUrlDecoderRuntimeClass_iface.lpVtbl = &decoder_vtbl;
+    decoder->IVectorView_IWwwFormUrlDecoderEntry_iface.lpVtbl = &decoder_view_vtbl;
+    decoder->IIterable_IWwwFormUrlDecoderEntry_iface.lpVtbl = &decoder_iterable_vtbl;
+    decoder->ref = 1;
+
+    p = query;
+    if (p < end && *p == '?') p++;
+    while (p < end)
+    {
+        for (amp = p; amp < end && *amp != '&'; amp++) {}
+        if (amp > p)
+        {
+            for (eq = p; eq < amp && *eq != '='; eq++) {}
+            if (!(entries = realloc(decoder->entries, (decoder->count + 1) * sizeof(*entries))))
+            {
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            decoder->entries = entries;
+            if (FAILED(hr = entry_create(p, eq - p, eq < amp ? eq + 1 : amp, eq < amp ? amp - eq - 1 : 0,
+                                         &decoder->entries[decoder->count])))
+                break;
+            decoder->count++;
+        }
+        p = amp < end ? amp + 1 : end;
+    }
+    if (FAILED(hr))
+    {
+        IWwwFormUrlDecoderRuntimeClass_Release(&decoder->IWwwFormUrlDecoderRuntimeClass_iface);
+        return hr;
+    }
+    *ret = &decoder->IWwwFormUrlDecoderRuntimeClass_iface;
+    return S_OK;
+}
