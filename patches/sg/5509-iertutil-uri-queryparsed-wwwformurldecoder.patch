+/* IInspectable::GetIids: a CoTaskMem array of the interfaces, without IUnknown and IInspectable */
+static HRESULT get_iids(ULONG *count, IID **iids, const IID *const *list, ULONG n)
+{
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc(n * sizeof(IID)))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *list[i];
+    *count = n;
+    return S_OK;
+}
+
+/* the text of a query string component with its %XX escapes (UTF-8) decoded */
+static HRESULT percent_decode(const WCHAR *in, UINT32 len, HSTRING *value)
+{
+    char *bytes;
+    WCHAR *out;
+    UINT32 i, b = 0;
+    int wlen;
+    HRESULT hr;
+
+    if (!(bytes = malloc(len * 4 + 1))) return E_OUTOFMEMORY;
+    for (i = 0; i < len; i++)
+    {
+#ifdef SG_MUTANT_DEC_NO_UNESCAPE
+        if (0)
+#else
+        if (in[i] == '%' && i + 2 < len && iswxdigit(in[i + 1]) && iswxdigit(in[i + 2]))
+#endif
+        {
+            WCHAR h[3] = { in[i + 1], in[i + 2], 0 };
+            bytes[b++] = (char)wcstol(h, NULL, 16);
+            i += 2;
+        }
+        else
+        {
+            /* not an escape: the character itself, as UTF-8 (a surrogate pair is one character) */
+            int n = (in[i] >= 0xd800 && in[i] < 0xdc00 && i + 1 < len && in[i + 1] >= 0xdc00 && in[i + 1] < 0xe000) ? 2 : 1;
+
+            b += WideCharToMultiByte(CP_UTF8, 0, &in[i], n, bytes + b, 4, NULL, NULL);
+            i += n - 1;
+        }
+    }
+    wlen = MultiByteToWideChar(CP_UTF8, 0, bytes, b, NULL, 0);
+    if (!(out = malloc((wlen + 1) * sizeof(WCHAR)))) { free(bytes); return E_OUTOFMEMORY; }
+    MultiByteToWideChar(CP_UTF8, 0, bytes, b, out, wlen);
+    out[wlen] = 0;
+    hr = WindowsCreateString(out, wlen, value);
+    free(bytes);
+    free(out);
+    return hr;
+}
+
