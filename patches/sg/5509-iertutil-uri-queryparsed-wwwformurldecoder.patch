+    hr = IWwwFormUrlDecoderRuntimeClassFactory_CreateWwwFormUrlDecoder(factory, query, &decoder);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(query);
+
+    hr = IWwwFormUrlDecoderRuntimeClass_QueryInterface(decoder, &IID_IVectorView_IWwwFormUrlDecoderEntry, (void **)&view);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_entry(view, 0, L"a", L"1");
+    check_entry(view, 1, L"b", L"two words");
+    check_entry(view, 2, L"a", L"3");
+    check_entry(view, 3, L"d", L"\x20ac");
+    check_entry(view, 4, L"e", L"");
+    IVectorView_IWwwFormUrlDecoderEntry_Release(view);
+    test_decoder_collection(decoder, 5);
+
+    WindowsCreateString(L"a", 1, &str);
+    hr = IWwwFormUrlDecoderRuntimeClass_GetFirstValueByName(decoder, str, &value);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_hstring(value, L"1");
+    WindowsDeleteString(value);
+    WindowsDeleteString(str);
+    WindowsCreateString(L"missing", 7, &str);
+    value = (HSTRING)0xdeadbeef;
+    hr = IWwwFormUrlDecoderRuntimeClass_GetFirstValueByName(decoder, str, &value);
+    ok(FAILED(hr), "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(str);
+    IWwwFormUrlDecoderRuntimeClass_Release(decoder);
+
+    WindowsCreateString(L"", 0, &query);
+    hr = IWwwFormUrlDecoderRuntimeClassFactory_CreateWwwFormUrlDecoder(factory, query, &decoder);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(query);
+    test_decoder_collection(decoder, 0);
+    IWwwFormUrlDecoderRuntimeClass_Release(decoder);
+
+    IWwwFormUrlDecoderRuntimeClassFactory_Release(factory);
+    RoUninitialize();
+}
+
+static void test_Uri_query_and_interfaces(void)
+{
+    static const WCHAR *class_name = L"Windows.Foundation.Uri";
+    IUriRuntimeClassWithAbsoluteCanonicalUri *canonical = NULL;
+    IWwwFormUrlDecoderRuntimeClass *decoder = NULL;
+    IVectorView_IWwwFormUrlDecoderEntry *view = NULL;
+    IUriRuntimeClassFactory *factory = NULL;
+    IUriRuntimeClass *uri = NULL;
+    HSTRING str, value;
+    IUnknown *unknown;
+    ULONG count, i;
+    IID *iids;
+    HRESULT hr;
+
+    hr = RoInitialize(RO_INIT_MULTITHREADED);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    WindowsCreateString(class_name, wcslen(class_name), &str);
+    hr = RoGetActivationFactory(str, &IID_IUriRuntimeClassFactory, (void **)&factory);
+    ok(hr == S_OK || broken(hr == REGDB_E_CLASSNOTREG), "RoGetActivationFactory failed, hr %#lx.\n", hr);
+    WindowsDeleteString(str);
+    if (hr == REGDB_E_CLASSNOTREG)
+    {
+        win_skip("%s runtimeclass not registered, skipping tests.\n", wine_dbgstr_w(class_name));
+        RoUninitialize();
+        return;
+    }
+
+    WindowsCreateString(L"https://example.com/p?x=1&y=%41#frag", wcslen(L"https://example.com/p?x=1&y=%41#frag"), &str);
+    hr = IUriRuntimeClassFactory_CreateUri(factory, str, &uri);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(str);
+
+    hr = IUriRuntimeClass_get_QueryParsed(uri, &decoder);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IWwwFormUrlDecoderRuntimeClass_QueryInterface(decoder, &IID_IVectorView_IWwwFormUrlDecoderEntry, (void **)&view);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_entry(view, 0, L"x", L"1");
+    check_entry(view, 1, L"y", L"A");
+    IVectorView_IWwwFormUrlDecoderEntry_Release(view);
+    test_decoder_collection(decoder, 2);
+    IWwwFormUrlDecoderRuntimeClass_Release(decoder);
+
+    /* every interface GetIids names can be queried */
+    hr = IUriRuntimeClass_GetIids(uri, &count, &iids);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(count > 0, "Got no interfaces.\n");
+    for (i = 0; i < count; i++)
+    {
+        hr = IUriRuntimeClass_QueryInterface(uri, &iids[i], (void **)&unknown);
+        ok(hr == S_OK, "QueryInterface(%s) returned %#lx.\n", wine_dbgstr_guid(&iids[i]), hr);
+        if (hr == S_OK) IUnknown_Release(unknown);
+    }
+    CoTaskMemFree(iids);
+
+    hr = IUriRuntimeClass_QueryInterface(uri, &IID_IUriRuntimeClassWithAbsoluteCanonicalUri, (void **)&canonical);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    if (canonical)
+    {
+        hr = IUriRuntimeClassWithAbsoluteCanonicalUri_get_AbsoluteCanonicalUri(canonical, &value);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        check_hstring(value, L"https://example.com/p?x=1&y=A#frag");
+        WindowsDeleteString(value);
+        IUriRuntimeClassWithAbsoluteCanonicalUri_Release(canonical);
+    }
+    IUriRuntimeClass_Release(uri);
+
+    /* no query: nothing to decode */
+    WindowsCreateString(L"https://example.com/p", wcslen(L"https://example.com/p"), &str);
+    hr = IUriRuntimeClassFactory_CreateUri(factory, str, &uri);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(str);
+    hr = IUriRuntimeClass_get_QueryParsed(uri, &decoder);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    test_decoder_collection(decoder, 0);
+    IWwwFormUrlDecoderRuntimeClass_Release(decoder);
+    IUriRuntimeClass_Release(uri);
+
+    IUriRuntimeClassFactory_Release(factory);
+    RoUninitialize();
+}
+
 START_TEST(iertutil)
 {
     test_IUriRuntimeClassFactory();
     test_IUriRuntimeClass();
+    test_WwwFormUrlDecoder();
+    test_Uri_query_and_interfaces();
 }
