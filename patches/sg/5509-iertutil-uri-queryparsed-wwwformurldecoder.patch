+/* Windows.Foundation.WwwFormUrlDecoder: the name-value pairs of a query
+ * string, as a read-only vector of IWwwFormUrlDecoderEntry. */
+struct entry
+{
+    IWwwFormUrlDecoderEntry IWwwFormUrlDecoderEntry_iface;
+    LONG ref;
+    HSTRING name, value;
+};
+
+struct decoder
+{
+    IWwwFormUrlDecoderRuntimeClass IWwwFormUrlDecoderRuntimeClass_iface;
+    IVectorView_IWwwFormUrlDecoderEntry IVectorView_IWwwFormUrlDecoderEntry_iface;
+    IIterable_IWwwFormUrlDecoderEntry IIterable_IWwwFormUrlDecoderEntry_iface;
+    LONG ref;
+    struct entry **entries;
+    UINT32 count;
+};
+
+struct decoder_iterator
+{
+    IIterator_IWwwFormUrlDecoderEntry IIterator_IWwwFormUrlDecoderEntry_iface;
+    LONG ref;
+    struct decoder *decoder;
+    UINT32 index;
+};
+
+static inline struct entry *impl_from_IWwwFormUrlDecoderEntry(IWwwFormUrlDecoderEntry *iface)
+{
+    return CONTAINING_RECORD(iface, struct entry, IWwwFormUrlDecoderEntry_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE entry_QueryInterface(IWwwFormUrlDecoderEntry *iface, REFIID iid, void **out)
+{
+    struct entry *impl = impl_from_IWwwFormUrlDecoderEntry(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable)
+        || IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IWwwFormUrlDecoderEntry))
+    {
+        IUnknown_AddRef(&impl->IWwwFormUrlDecoderEntry_iface);
+        *out = &impl->IWwwFormUrlDecoderEntry_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE entry_AddRef(IWwwFormUrlDecoderEntry *iface)
+{
+    struct entry *impl = impl_from_IWwwFormUrlDecoderEntry(iface);
+    ULONG ref = InterlockedIncrement(&impl->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE entry_Release(IWwwFormUrlDecoderEntry *iface)
+{
+    struct entry *impl = impl_from_IWwwFormUrlDecoderEntry(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+
+    if (!ref)
+    {
+        WindowsDeleteString(impl->name);
+        WindowsDeleteString(impl->value);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE entry_GetIids(IWwwFormUrlDecoderEntry *iface, ULONG *iid_count, IID **iids)
+{
+    static const IID *const list[] = { &IID_IWwwFormUrlDecoderEntry };
+
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+    return get_iids(iid_count, iids, list, ARRAY_SIZE(list));
+}
+
+static HRESULT STDMETHODCALLTYPE entry_GetRuntimeClassName(IWwwFormUrlDecoderEntry *iface, HSTRING *class_name)
+{
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+    return WindowsCreateString(L"Windows.Foundation.WwwFormUrlDecoderEntry",
+                               wcslen(L"Windows.Foundation.WwwFormUrlDecoderEntry"), class_name);
+}
+
+static HRESULT STDMETHODCALLTYPE entry_GetTrustLevel(IWwwFormUrlDecoderEntry *iface, TrustLevel *trust_level)
+{
+    TRACE("iface %p, trust_level %p.\n", iface, trust_level);
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE entry_get_Name(IWwwFormUrlDecoderEntry *iface, HSTRING *value)
+{
+    TRACE("iface %p, value %p.\n", iface, value);
+    return WindowsDuplicateString(impl_from_IWwwFormUrlDecoderEntry(iface)->name, value);
+}
+
+static HRESULT STDMETHODCALLTYPE entry_get_Value(IWwwFormUrlDecoderEntry *iface, HSTRING *value)
+{
+    TRACE("iface %p, value %p.\n", iface, value);
+    return WindowsDuplicateString(impl_from_IWwwFormUrlDecoderEntry(iface)->value, value);
+}
+
+static const IWwwFormUrlDecoderEntryVtbl entry_vtbl =
+{
+    entry_QueryInterface,
+    entry_AddRef,
+    entry_Release,
+    /* IInspectable methods */
+    entry_GetIids,
+    entry_GetRuntimeClassName,
+    entry_GetTrustLevel,
+    /* IWwwFormUrlDecoderEntry methods */
+    entry_get_Name,
+    entry_get_Value,
+};
+
+static HRESULT entry_create(const WCHAR *name, UINT32 name_len, const WCHAR *value, UINT32 value_len,
+                            struct entry **ret)
+{
+    struct entry *entry;
+    HRESULT hr;
+
+    if (!(entry = calloc(1, sizeof(*entry)))) return E_OUTOFMEMORY;
+    entry->IWwwFormUrlDecoderEntry_iface.lpVtbl = &entry_vtbl;
+    entry->ref = 1;
+    if (FAILED(hr = percent_decode(name, name_len, &entry->name))
+        || FAILED(hr = percent_decode(value, value_len, &entry->value)))
+    {
+        WindowsDeleteString(entry->name);
+        free(entry);
+        return hr;
+    }
+    *ret = entry;
+    return S_OK;
+}
+
+/* DEFINE_IINSPECTABLE needs impl_from_<iface> and <iface>_iface */
+static inline struct decoder *impl_from_IWwwFormUrlDecoderRuntimeClass(IWwwFormUrlDecoderRuntimeClass *iface)
+{
+    return CONTAINING_RECORD(iface, struct decoder, IWwwFormUrlDecoderRuntimeClass_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_QueryInterface(IWwwFormUrlDecoderRuntimeClass *iface, REFIID iid,
+                                                        void **out)
+{
+    struct decoder *impl = impl_from_IWwwFormUrlDecoderRuntimeClass(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable)
+        || IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IWwwFormUrlDecoderRuntimeClass))
+        *out = &impl->IWwwFormUrlDecoderRuntimeClass_iface;
+    else if (IsEqualGUID(iid, &IID_IVectorView_IWwwFormUrlDecoderEntry))
+        *out = &impl->IVectorView_IWwwFormUrlDecoderEntry_iface;
+    else if (IsEqualGUID(iid, &IID_IIterable_IWwwFormUrlDecoderEntry))
+        *out = &impl->IIterable_IWwwFormUrlDecoderEntry_iface;
+    else
+    {
+        WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG STDMETHODCALLTYPE decoder_AddRef(IWwwFormUrlDecoderRuntimeClass *iface)
+{
+    struct decoder *impl = impl_from_IWwwFormUrlDecoderRuntimeClass(iface);
+    ULONG ref = InterlockedIncrement(&impl->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE decoder_Release(IWwwFormUrlDecoderRuntimeClass *iface)
+{
+    struct decoder *impl = impl_from_IWwwFormUrlDecoderRuntimeClass(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    UINT32 i;
+
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) IWwwFormUrlDecoderEntry_Release(&impl->entries[i]->IWwwFormUrlDecoderEntry_iface);
+        free(impl->entries);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_GetIids(IWwwFormUrlDecoderRuntimeClass *iface, ULONG *iid_count,
+                                                 IID **iids)
+{
+    static const IID *const list[] =
+        { &IID_IWwwFormUrlDecoderRuntimeClass, &IID_IVectorView_IWwwFormUrlDecoderEntry,
+          &IID_IIterable_IWwwFormUrlDecoderEntry };
+
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+    return get_iids(iid_count, iids, list, ARRAY_SIZE(list));
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_GetRuntimeClassName(IWwwFormUrlDecoderRuntimeClass *iface,
+                                                             HSTRING *class_name)
+{
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+    return WindowsCreateString(L"Windows.Foundation.WwwFormUrlDecoder",
+                               wcslen(L"Windows.Foundation.WwwFormUrlDecoder"), class_name);
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_GetTrustLevel(IWwwFormUrlDecoderRuntimeClass *iface, TrustLevel *trust_level)
+{
+    TRACE("iface %p, trust_level %p.\n", iface, trust_level);
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_GetFirstValueByName(IWwwFormUrlDecoderRuntimeClass *iface,
+                                                             HSTRING name, HSTRING *value)
+{
+    struct decoder *impl = impl_from_IWwwFormUrlDecoderRuntimeClass(iface);
+    INT32 res;
+    UINT32 i;
+
+    TRACE("iface %p, name %s, value %p.\n", iface, debugstr_hstring(name), value);
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    for (i = 0; i < impl->count; i++)
+    {
+        if (SUCCEEDED(WindowsCompareStringOrdinal(impl->entries[i]->name, name, &res)) && !res)
+            return WindowsDuplicateString(impl->entries[i]->value, value);
+    }
+    /* "throws an exception ... if the value specified as name doesn't exist" */
+    return E_INVALIDARG;
+}
+
+static const IWwwFormUrlDecoderRuntimeClassVtbl decoder_vtbl =
+{
+    decoder_QueryInterface,
+    decoder_AddRef,
+    decoder_Release,
+    /* IInspectable methods */
+    decoder_GetIids,
+    decoder_GetRuntimeClassName,
+    decoder_GetTrustLevel,
+    /* IWwwFormUrlDecoderRuntimeClass methods */
+    decoder_GetFirstValueByName,
+};
+
+DEFINE_IINSPECTABLE(decoder_view, IVectorView_IWwwFormUrlDecoderEntry, struct decoder,
+                    IWwwFormUrlDecoderRuntimeClass_iface)
+DEFINE_IINSPECTABLE(decoder_iterable, IIterable_IWwwFormUrlDecoderEntry, struct decoder,
+                    IWwwFormUrlDecoderRuntimeClass_iface)
+
+static HRESULT STDMETHODCALLTYPE decoder_view_GetAt(IVectorView_IWwwFormUrlDecoderEntry *iface, UINT32 index,
+                                                    IWwwFormUrlDecoderEntry **value)
+{
+    struct decoder *impl = impl_from_IVectorView_IWwwFormUrlDecoderEntry(iface);
+
+    TRACE("iface %p, index %u, value %p.\n", iface, index, value);
+
+    *value = NULL;
+    if (index >= impl->count) return E_BOUNDS;
+    *value = &impl->entries[index]->IWwwFormUrlDecoderEntry_iface;
+    IWwwFormUrlDecoderEntry_AddRef(*value);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_view_get_Size(IVectorView_IWwwFormUrlDecoderEntry *iface, UINT32 *value)
+{
+    TRACE("iface %p, value %p.\n", iface, value);
+    *value = impl_from_IVectorView_IWwwFormUrlDecoderEntry(iface)->count;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_view_IndexOf(IVectorView_IWwwFormUrlDecoderEntry *iface,
+                                                      IWwwFormUrlDecoderEntry *element, UINT32 *index,
+                                                      boolean *found)
+{
+    struct decoder *impl = impl_from_IVectorView_IWwwFormUrlDecoderEntry(iface);
+    UINT32 i;
+
+    TRACE("iface %p, element %p, index %p, found %p.\n", iface, element, index, found);
+
+    for (i = 0; i < impl->count; i++)
+        if (&impl->entries[i]->IWwwFormUrlDecoderEntry_iface == element) break;
+    if ((*found = i < impl->count)) *index = i;
+    else *index = 0;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE decoder_view_GetMany(IVectorView_IWwwFormUrlDecoderEntry *iface,
+                                                      UINT32 start_index, UINT32 items_size,
+                                                      IWwwFormUrlDecoderEntry **items, UINT32 *count)
+{
+    struct decoder *impl = impl_from_IVectorView_IWwwFormUrlDecoderEntry(iface);
+    UINT32 i;
+
+    TRACE("iface %p, start_index %u, items_size %u, items %p, count %p.\n", iface, start_index, items_size,
+          items, count);
+
+    if (start_index >= impl->count) return E_BOUNDS;
+    for (i = start_index; i < impl->count && i - start_index < items_size; i++)
+    {
+        items[i - start_index] = &impl->entries[i]->IWwwFormUrlDecoderEntry_iface;
+        IWwwFormUrlDecoderEntry_AddRef(items[i - start_index]);
+    }
+    *count = i - start_index;
+    return S_OK;
+}
+
+static const IVectorView_IWwwFormUrlDecoderEntryVtbl decoder_view_vtbl =
