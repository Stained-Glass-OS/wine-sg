From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: the profile manager's codec information, IWMCodecInfo3 (9105)

The profile manager had no IWMCodecInfo (E_NOINTERFACE), so a program that builds
its profile from the installed codecs (fre:ac's WMA encoder, CD rippers, the SDK's
codec enumeration) had no stream to configure; fre:ac crashed on the NULL. On
Windows the list is the installed encoders; here it is the encoders the writer has
(6518: GStreamer's libav WMA 2 and WMV 2): Windows Media Audio 9.2 (format tag
0x161) with the one-pass CBR formats that encoder takes (24 kbps and up, 8 to
48 kHz, mono and stereo), and Windows Media Video 8 (WMV2). VBR and two-pass
encoding, which this encoder has not, list no formats and _ISVBRSUPPORTED says so,
so programs fall back to CBR. Codec enumeration settings, codec and format
properties, format descriptions.
---
--- a/include/wmsdkidl.idl
+++ b/include/wmsdkidl.idl
@@ -630,6 +630,14 @@
 
 cpp_quote("static const WCHAR g_wszNumPasses[] = {'_','P','A','S','S','E','S','U','S','E','D',0};")
 cpp_quote("static const WCHAR g_wszVBREnabled[] = {'_','V','B','R','E','N','A','B','L','E','D',0};")
+cpp_quote("static const WCHAR g_wszIsVBRSupported[] = {'_','I','S','V','B','R','S','U','P','P','O','R','T','E','D',0};")
+cpp_quote("static const WCHAR g_wszVBRQuality[] = {'_','V','B','R','Q','U','A','L','I','T','Y',0};")
+cpp_quote("static const WCHAR g_wszVBRBitrateMax[] = {'_','R','M','A','X',0};")
+cpp_quote("static const WCHAR g_wszVBRBufferWindowMax[] = {'_','B','M','A','X',0};")
+cpp_quote("static const WCHAR g_wszComplexityMax[] = {'_','C','O','M','P','L','E','X','I','T','Y','E','X','M','A','X',0};")
+cpp_quote("static const WCHAR g_wszComplexityOffline[] = {'_','C','O','M','P','L','E','X','I','T','Y','E','X','O','F','F','L','I','N','E',0};")
+cpp_quote("static const WCHAR g_wszComplexityLive[] = {'_','C','O','M','P','L','E','X','I','T','Y','E','X','L','I','V','E',0};")
+cpp_quote("static const WCHAR g_wszSpeechCaps[] = {'S','p','e','e','c','h','F','o','r','m','a','t','C','a','p',0};")
 
 [
     object,
--- a/dlls/wmvcore/profile.h
+++ b/dlls/wmvcore/profile.h
@@ -51,6 +51,12 @@
 void writer_header_destroy(struct writer_header *header);
 void writer_header_clear(struct writer_header *header);
 
+/* The profile manager's IWMCodecInfo3 (codecinfo.c), aggregated: its IUnknown is the manager. */
+struct codec_info;
+HRESULT codec_info_create(IUnknown *outer, struct codec_info **out);
+IWMCodecInfo3 *codec_info_iface(struct codec_info *info);
+void codec_info_destroy(struct codec_info *info);
+
 /* The end of writing for a file sink of ours (filesink.c): the final header unit and the index.
  * S_FALSE for any other sink. */
 HRESULT file_sink_finish(IWMWriterSink *sink, const BYTE *header, DWORD header_size,
--- a/dlls/wmvcore/Makefile.in
+++ b/dlls/wmvcore/Makefile.in
@@ -8,6 +8,7 @@
 SOURCES = \
 	asfmux.c \
 	async_reader.c \
+	codecinfo.c \
 	editor.c \
 	filesink.c \
 	profile.c \
--- /dev/null
+++ b/dlls/wmvcore/codecinfo.c
@@ -0,0 +1,485 @@
+/*
+ * The profile manager's codec information (IWMCodecInfo3)
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
