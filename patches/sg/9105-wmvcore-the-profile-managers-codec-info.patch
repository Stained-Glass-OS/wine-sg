+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS (wine-sg 9105): the profile manager had no IWMCodecInfo, so a program that
+ * builds its profile from the installed codecs (fre:ac's WMA encoder, CD rippers, the SDK's
+ * codec-enumeration pattern) got E_NOINTERFACE and had no stream to configure. On Windows the
+ * list is the encoders installed. Here it is the encoders the writer really has (wine-sg 6518:
+ * GStreamer's libav WMA version 2 and WMV version 2 encoders): one audio codec, Windows Media
+ * Audio 9.2 (format tag 0x161), with the one-pass CBR formats that encoder takes (24 kbps and up,
+ * 8 to 48 kHz, mono and stereo), and one video codec, Windows Media Video 8 (WMV2). VBR and two
+ * passes are codec enumeration settings Windows' WMA encoder has and this one does not:
+ * _ISVBRSUPPORTED says FALSE and those settings list no formats, so a program falls back to CBR.
+ */
+
+#include "wmvcore_private.h"
+#include "wmsdk.h"
+#include "nserror.h"
+#include "asferr.h"
+#include "mmreg.h"
+#include "amvideo.h"
+#include "profile.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wmvcore);
+
+static const GUID media_audio = {0x73647561, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID media_video = {0x73646976, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+static const GUID format_waveformatex = {0x05589f81, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+static const GUID format_videoinfo = {0x05589f80, 0xc356, 0x11ce, {0xbf, 0x01, 0x00, 0xaa, 0x00, 0x55, 0x59, 0x5a}};
+
+/* the one-pass CBR formats of the WMA encoder: GStreamer's libav wmav2 takes 24 kbps and more */
+static const struct audio_format
+{
+    DWORD rate;
+    WORD channels;
+    DWORD kbps;
+}
+audio_formats[] =
+{
+    {48000, 2, 320}, {48000, 2, 256}, {48000, 2, 192}, {48000, 2, 160}, {48000, 2, 128},
+    {44100, 2, 320}, {44100, 2, 256}, {44100, 2, 192}, {44100, 2, 160}, {44100, 2, 128},
+    {44100, 2, 96}, {44100, 2, 80}, {44100, 2, 64}, {44100, 2, 48}, {44100, 2, 40}, {44100, 2, 32},
+    {32000, 2, 64}, {32000, 2, 48}, {32000, 2, 40}, {32000, 2, 32},
+    {22050, 2, 48}, {22050, 2, 32}, {22050, 2, 24},
+    {16000, 2, 32}, {16000, 2, 24},
+    {48000, 1, 64}, {44100, 1, 64}, {44100, 1, 48}, {44100, 1, 32},
+    {32000, 1, 32}, {22050, 1, 32}, {22050, 1, 24}, {16000, 1, 24},
+    {8000, 1, 24},
+};
+
+enum codec_kind { CODEC_AUDIO, CODEC_VIDEO, CODEC_KINDS };
+
+struct codec_settings
+{
+    BOOL vbr;
+    DWORD passes;
+};
+
+struct codec_info
+{
+    IWMCodecInfo3 IWMCodecInfo3_iface;
+    IUnknown *outer;
+    CRITICAL_SECTION cs;
+    struct codec_settings settings[CODEC_KINDS];
+};
+
+static inline struct codec_info *impl_from_IWMCodecInfo3(IWMCodecInfo3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct codec_info, IWMCodecInfo3_iface);
+}
+
+static HRESULT WINAPI codec_info_QueryInterface(IWMCodecInfo3 *iface, REFIID iid, void **out)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    return IUnknown_QueryInterface(info->outer, iid, out);
+}
+
+static ULONG WINAPI codec_info_AddRef(IWMCodecInfo3 *iface)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    return IUnknown_AddRef(info->outer);
+}
+
+static ULONG WINAPI codec_info_Release(IWMCodecInfo3 *iface)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    return IUnknown_Release(info->outer);
+}
+
+/* the codec a major type and index name, or -1 */
+static int find_codec(const GUID *type, DWORD index)
+{
+    if (!type) return -1;
+    if (IsEqualGUID(type, &media_audio) && !index) return CODEC_AUDIO;
+    if (IsEqualGUID(type, &media_video) && !index) return CODEC_VIDEO;
+    return -1;
+}
+
+static DWORD format_count(const struct codec_info *info, int codec)
+{
+    const struct codec_settings *settings = &info->settings[codec];
+
+    /* no VBR and no two-pass encoding: those settings have no formats */
+    if (settings->vbr || settings->passes != 1) return 0;
+    return codec == CODEC_AUDIO ? ARRAY_SIZE(audio_formats) : 1;
+}
+
+static HRESULT WINAPI codec_info_GetCodecInfoCount(IWMCodecInfo3 *iface, REFGUID type, DWORD *count)
+{
+    TRACE("iface %p, type %s, count %p.\n", iface, debugstr_guid(type), count);
+
+    if (!type || !count) return E_INVALIDARG;
+    *count = IsEqualGUID(type, &media_audio) || IsEqualGUID(type, &media_video) ? 1 : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI codec_info_GetCodecFormatCount(IWMCodecInfo3 *iface, REFGUID type, DWORD index, DWORD *count)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    int codec = find_codec(type, index);
+
+    TRACE("info %p, type %s, index %lu, count %p.\n", info, debugstr_guid(type), index, count);
+
+    if (!count || codec < 0) return E_INVALIDARG;
+    EnterCriticalSection(&info->cs);
+    *count = format_count(info, codec);
+    LeaveCriticalSection(&info->cs);
+    return S_OK;
+}
+
+/* a stream configuration of one of the formats, through a scratch profile (its stream objects are
+ * the profile's own private copies) */
+static HRESULT create_format(int codec, DWORD index, IWMStreamConfig **out)
+{
+    BYTE wma[sizeof(WAVEFORMATEX) + 10] = {0};
+    VIDEOINFOHEADER vih = {0};
+    WM_MEDIA_TYPE mt = {0};
+    IWMStreamConfig *config;
+    IWMMediaProps *props;
+    IWMProfile3 *profile;
+    HRESULT hr;
+
+    if (FAILED(hr = profile_create(WMT_VER_9_0, &profile))) return hr;
+    hr = IWMProfile3_CreateNewStream(profile, codec == CODEC_AUDIO ? &media_audio : &media_video, &config);
+    IWMProfile3_Release(profile);
+    if (FAILED(hr)) return hr;
+
+    if (codec == CODEC_AUDIO)
+    {
+        const struct audio_format *format = &audio_formats[index];
+        DWORD frame = format->rate <= 16000 ? 512 : format->rate <= 22050 ? 1024 : 2048;
+        WAVEFORMATEX *wfx = (WAVEFORMATEX *)wma;
+        WORD options = 1;
+
+        wfx->wFormatTag = 0x161;     /* Windows Media Audio version 2 */
+        wfx->nChannels = format->channels;
+        wfx->nSamplesPerSec = format->rate;
+        wfx->nAvgBytesPerSec = format->kbps * 1000 / 8;
+        /* a frame's worth of the bit rate, as the encoder makes its blocks */
+        wfx->nBlockAlign = (WORD)min((UINT64)format->kbps * 1000 * frame / (8 * format->rate), 0xffff);
+        wfx->wBitsPerSample = 16;
+#ifdef SG_MUTANT_CODECINFO_NO_DATA
+        wfx->cbSize = 0;
+#else
+        wfx->cbSize = 10;
+#endif
+        /* the WMA 2 format's own data: samples per block, encode options, super block alignment */
+        memcpy(wma + sizeof(WAVEFORMATEX), &frame, 4);
+        memcpy(wma + sizeof(WAVEFORMATEX) + 4, &options, 2);
+        {
+            DWORD super_block = wfx->nBlockAlign;
+            memcpy(wma + sizeof(WAVEFORMATEX) + 6, &super_block, 4);
+        }
+        mt.majortype = media_audio;
+        mt.subtype = media_audio;
+        mt.subtype.Data1 = 0x161;
+        mt.bFixedSizeSamples = TRUE;
+        mt.lSampleSize = wfx->nBlockAlign;
+        mt.formattype = format_waveformatex;
+        mt.cbFormat = sizeof(wma);
+        mt.pbFormat = wma;
+        IWMStreamConfig_SetBitrate(config, format->kbps * 1000);
+        IWMStreamConfig_SetBufferWindow(config, 3000);
+    }
+    else
+    {
+        /* the program sets its own frame size and rate on the stream */
+        vih.dwBitRate = 300000;
+        vih.AvgTimePerFrame = 333333;
+        vih.bmiHeader.biSize = sizeof(vih.bmiHeader);
+        vih.bmiHeader.biWidth = 320;
+        vih.bmiHeader.biHeight = 240;
+        vih.bmiHeader.biPlanes = 1;
+        vih.bmiHeader.biBitCount = 24;
+        vih.bmiHeader.biCompression = MAKEFOURCC('W','M','V','2');
+        mt.majortype = media_video;
+        mt.subtype = media_audio;
+        mt.subtype.Data1 = MAKEFOURCC('W','M','V','2');
+        mt.bTemporalCompression = TRUE;
+        mt.formattype = format_videoinfo;
+        mt.cbFormat = sizeof(vih);
+        mt.pbFormat = (BYTE *)&vih;
+        IWMStreamConfig_SetBitrate(config, vih.dwBitRate);
+        IWMStreamConfig_SetBufferWindow(config, 5000);
+    }
+
+    if (SUCCEEDED(hr = IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props)))
+    {
+        hr = IWMMediaProps_SetMediaType(props, &mt);
+        IWMMediaProps_Release(props);
+    }
+    if (FAILED(hr))
+    {
+        IWMStreamConfig_Release(config);
+        return hr;
+    }
+    *out = config;
+    return S_OK;
+}
+
+static HRESULT get_format(struct codec_info *info, REFGUID type, DWORD index, DWORD format, IWMStreamConfig **out)
+{
+    int codec = find_codec(type, index);
+    DWORD count;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (codec < 0) return E_INVALIDARG;
+    EnterCriticalSection(&info->cs);
+    count = format_count(info, codec);
+    LeaveCriticalSection(&info->cs);
+    if (format >= count) return E_INVALIDARG;
+    return create_format(codec, format, out);
+}
+
+static HRESULT WINAPI codec_info_GetCodecFormat(IWMCodecInfo3 *iface, REFGUID type, DWORD index, DWORD format,
+        IWMStreamConfig **config)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+
+    TRACE("info %p, type %s, index %lu, format %lu, config %p.\n", info, debugstr_guid(type), index, format, config);
+
+    return get_format(info, type, index, format, config);
+}
+
+static HRESULT copy_string(const WCHAR *str, WCHAR *out, DWORD *size)
+{
+    DWORD len = wcslen(str) + 1;
+
+    if (!size) return E_INVALIDARG;
+    if (out)
+    {
+        if (*size < len)
+        {
+            *size = len;
+            return ASF_E_BUFFERTOOSMALL;
+        }
+        memcpy(out, str, len * sizeof(WCHAR));
+    }
+    *size = len;
+    return S_OK;
+}
+
+static HRESULT WINAPI codec_info_GetCodecName(IWMCodecInfo3 *iface, REFGUID type, DWORD index, WCHAR *name,
+        DWORD *size)
+{
+    int codec = find_codec(type, index);
+
+    TRACE("iface %p, type %s, index %lu, name %p, size %p.\n", iface, debugstr_guid(type), index, name, size);
+
+    if (codec < 0) return E_INVALIDARG;
+    return copy_string(codec == CODEC_AUDIO ? L"Windows Media Audio 9.2" : L"Windows Media Video 8", name, size);
+}
+
+static HRESULT WINAPI codec_info_GetCodecFormatDesc(IWMCodecInfo3 *iface, REFGUID type, DWORD index, DWORD format,
+        IWMStreamConfig **config, WCHAR *desc, DWORD *size)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    int codec = find_codec(type, index);
+    IWMStreamConfig *object = NULL;
+    WCHAR buffer[64];
+    HRESULT hr;
+
+    TRACE("info %p, type %s, index %lu, format %lu, config %p, desc %p, size %p.\n",
+            info, debugstr_guid(type), index, format, config, desc, size);
+
+    if (!size) return E_INVALIDARG;
+    if (FAILED(hr = get_format(info, type, index, format, &object))) return hr;
+    if (codec == CODEC_AUDIO)
+    {
+        const struct audio_format *f = &audio_formats[format];
+        swprintf(buffer, ARRAY_SIZE(buffer), L"%u kbps, %u kHz, %s 1-pass CBR", f->kbps, f->rate / 1000,
+                f->channels == 2 ? L"stereo" : L"mono");
+    }
+    else
+        wcscpy(buffer, L"1-pass CBR");
+    if (SUCCEEDED(hr = copy_string(buffer, desc, size)) && config)
+        IWMStreamConfig_AddRef(*config = object);
+    IWMStreamConfig_Release(object);
+    return hr;
+}
+
+static HRESULT put_value(WMT_ATTR_DATATYPE type, const void *value, DWORD length,
+        WMT_ATTR_DATATYPE *out_type, BYTE *out, DWORD *size)
+{
+    if (!out_type || !size) return E_INVALIDARG;
+    *out_type = type;
+    if (out)
+    {
+        if (*size < length)
+        {
+            *size = length;
+            return ASF_E_BUFFERTOOSMALL;
+        }
+        memcpy(out, value, length);
+    }
+    *size = length;
+    return S_OK;
+}
+
+static HRESULT WINAPI codec_info_GetCodecFormatProp(IWMCodecInfo3 *iface, REFGUID type, DWORD index, DWORD format,
+        const WCHAR *name, WMT_ATTR_DATATYPE *value_type, BYTE *value, DWORD *size)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    int codec = find_codec(type, index);
+    DWORD count;
+
+    TRACE("info %p, type %s, index %lu, format %lu, name %s, value_type %p, value %p, size %p.\n",
+            info, debugstr_guid(type), index, format, debugstr_w(name), value_type, value, size);
+
+    if (codec < 0 || !name) return E_INVALIDARG;
+    EnterCriticalSection(&info->cs);
+    count = format_count(info, codec);
+    LeaveCriticalSection(&info->cs);
+    if (format >= count) return E_INVALIDARG;
+    if (codec == CODEC_AUDIO && !wcscmp(name, g_wszSpeechCaps))
+    {
+        DWORD caps = 0;     /* no speech formats */
+        return put_value(WMT_TYPE_DWORD, &caps, sizeof(caps), value_type, value, size);
+    }
+    FIXME("Unsupported format property %s.\n", debugstr_w(name));
+    return NS_E_UNSUPPORTED_PROPERTY;
+}
+
+static HRESULT WINAPI codec_info_GetCodecProp(IWMCodecInfo3 *iface, REFGUID type, DWORD index, const WCHAR *name,
+        WMT_ATTR_DATATYPE *value_type, BYTE *value, DWORD *size)
+{
+    int codec = find_codec(type, index);
+
+    TRACE("iface %p, type %s, index %lu, name %s, value_type %p, value %p, size %p.\n",
+            iface, debugstr_guid(type), index, debugstr_w(name), value_type, value, size);
+
+    if (codec < 0 || !name) return E_INVALIDARG;
+    if (!wcscmp(name, g_wszIsVBRSupported))
+    {
+        BOOL vbr = FALSE;
+        return put_value(WMT_TYPE_BOOL, &vbr, sizeof(vbr), value_type, value, size);
+    }
+    if (codec == CODEC_VIDEO && (!wcscmp(name, g_wszComplexityMax) || !wcscmp(name, g_wszComplexityOffline)
+            || !wcscmp(name, g_wszComplexityLive)))
+    {
+        DWORD complexity = 0;
+        return put_value(WMT_TYPE_DWORD, &complexity, sizeof(complexity), value_type, value, size);
+    }
+    FIXME("Unsupported codec property %s.\n", debugstr_w(name));
+    return NS_E_UNSUPPORTED_PROPERTY;
+}
+
+static HRESULT WINAPI codec_info_SetCodecEnumerationSetting(IWMCodecInfo3 *iface, REFGUID type, DWORD index,
+        const WCHAR *name, WMT_ATTR_DATATYPE value_type, const BYTE *value, DWORD size)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    int codec = find_codec(type, index);
+    HRESULT hr = S_OK;
+
+    TRACE("info %p, type %s, index %lu, name %s, value_type %#x, value %p, size %lu.\n",
+            info, debugstr_guid(type), index, debugstr_w(name), value_type, value, size);
+
+    if (codec < 0 || !name || !value) return E_INVALIDARG;
+    EnterCriticalSection(&info->cs);
+    if (!wcscmp(name, g_wszVBREnabled))
+    {
+        if (value_type != WMT_TYPE_BOOL || size < sizeof(BOOL)) hr = E_INVALIDARG;
+        else info->settings[codec].vbr = !!*(const BOOL *)value;
+    }
+    else if (!wcscmp(name, g_wszNumPasses))
+    {
+        if (value_type != WMT_TYPE_DWORD || size < sizeof(DWORD) || !*(const DWORD *)value
+                || *(const DWORD *)value > 2)
+            hr = E_INVALIDARG;
+        else info->settings[codec].passes = *(const DWORD *)value;
+    }
+    else
+    {
+        FIXME("Unsupported setting %s.\n", debugstr_w(name));
+        hr = NS_E_UNSUPPORTED_PROPERTY;
+    }
+    LeaveCriticalSection(&info->cs);
+    return hr;
+}
+
+static HRESULT WINAPI codec_info_GetCodecEnumerationSetting(IWMCodecInfo3 *iface, REFGUID type, DWORD index,
+        const WCHAR *name, WMT_ATTR_DATATYPE *value_type, BYTE *value, DWORD *size)
+{
+    struct codec_info *info = impl_from_IWMCodecInfo3(iface);
+    int codec = find_codec(type, index);
+    struct codec_settings settings;
+
+    TRACE("info %p, type %s, index %lu, name %s, value_type %p, value %p, size %p.\n",
+            info, debugstr_guid(type), index, debugstr_w(name), value_type, value, size);
+
+    if (codec < 0 || !name) return E_INVALIDARG;
+    EnterCriticalSection(&info->cs);
+    settings = info->settings[codec];
+    LeaveCriticalSection(&info->cs);
+    if (!wcscmp(name, g_wszVBREnabled))
+        return put_value(WMT_TYPE_BOOL, &settings.vbr, sizeof(BOOL), value_type, value, size);
+    if (!wcscmp(name, g_wszNumPasses))
+        return put_value(WMT_TYPE_DWORD, &settings.passes, sizeof(DWORD), value_type, value, size);
+    FIXME("Unsupported setting %s.\n", debugstr_w(name));
+    return NS_E_UNSUPPORTED_PROPERTY;
+}
+
+static const IWMCodecInfo3Vtbl codec_info_vtbl =
+{
+    codec_info_QueryInterface,
+    codec_info_AddRef,
+    codec_info_Release,
+    codec_info_GetCodecInfoCount,
+    codec_info_GetCodecFormatCount,
+    codec_info_GetCodecFormat,
+    codec_info_GetCodecName,
+    codec_info_GetCodecFormatDesc,
+    codec_info_GetCodecFormatProp,
+    codec_info_GetCodecProp,
+    codec_info_SetCodecEnumerationSetting,
+    codec_info_GetCodecEnumerationSetting,
+};
+
+HRESULT codec_info_create(IUnknown *outer, struct codec_info **out)
+{
+    struct codec_info *info;
+    unsigned int i;
+
+    if (!(info = calloc(1, sizeof(*info)))) return E_OUTOFMEMORY;
