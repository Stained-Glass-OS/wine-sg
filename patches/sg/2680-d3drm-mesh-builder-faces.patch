From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3drm: faces of a mesh builder

GetFaceCount counts the faces of a mesh builder: those of its face data and
the ones made with CreateFace, which stay when X data is loaded and come in
front of the loaded faces (Windows keeps the face of the test). GetFaces
returns an IDirect3DRMFaceArray (implemented here) and GetFace(index) a face
object, for versions 2 and 3; a face of the face data comes out with the
builder's vertices and normals (faces now keep a normal per vertex when given
one), D3DRMERR_BADVALUE for an index out of range or no output. Removes the
todo_wine marks of the face tests of the d3drm test.
---
--- a/dlls/d3drm/d3drm_private.h
+++ b/dlls/d3drm/d3drm_private.h
@@ -196,6 +196,8 @@ struct d3drm_face
     {
         D3DVECTOR position;
         float u, v;
+        BOOL has_normal;
+        D3DVECTOR normal;
     } *vertices;
     SIZE_T nb_vertices;
     SIZE_T vertices_size;
@@ -220,6 +222,8 @@ struct d3drm_mesh_builder
     DWORD nb_faces;
     DWORD face_data_size;
     void *pFaceData;
+    struct d3drm_face **extra_faces; /* faces made with CreateFace */
+    SIZE_T nb_extra_faces, extra_faces_size, nb_leading_extra_faces;
     DWORD nb_coords2d;
     struct coords_2d *pCoords2d;
     D3DCOLOR color;
@@ -355,6 +359,8 @@ struct d3drm_device *unsafe_impl_from_IDirect3DRMDevice3(IDirect3DRMDevice3 *ifa
 HRESULT d3drm_texture_create(struct d3drm_texture **texture, IDirect3DRM *d3drm);
 HRESULT d3drm_frame_create(struct d3drm_frame **frame, IUnknown *parent_frame, IDirect3DRM *d3drm);
 HRESULT d3drm_face_create(struct d3drm_face **face);
+HRESULT d3drm_face_add_vertex_normal(struct d3drm_face *face, const D3DVECTOR *position, const D3DVECTOR *normal);
+HRESULT d3drm_face_array_create(struct d3drm_face **faces, ULONG count, IDirect3DRMFaceArray **array);
 HRESULT d3drm_viewport_create(struct d3drm_viewport **viewport, IDirect3DRM *d3drm);
 HRESULT d3drm_mesh_builder_create(struct d3drm_mesh_builder **mesh_builder, IDirect3DRM *d3drm);
 HRESULT d3drm_light_create(struct d3drm_light **light, IDirect3DRM *d3drm);
