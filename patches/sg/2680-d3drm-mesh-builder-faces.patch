+/* The faces a builder has: those of its face data, made into objects when asked for, then the ones
+ * made with CreateFace. */
+static HRESULT mesh_builder_get_face(struct d3drm_mesh_builder *mb, DWORD index, struct d3drm_face **face)
+{
+    const DWORD *ptr = mb->pFaceData;
+    struct d3drm_face *object;
+    DWORD i, j, n;
+    HRESULT hr;
+
+    *face = NULL;
+    if (index < mb->nb_leading_extra_faces)
+    {
+        *face = mb->extra_faces[index];
+        IDirect3DRMFace_AddRef(&(*face)->IDirect3DRMFace_iface);
+        return D3DRM_OK;
+    }
+    index -= mb->nb_leading_extra_faces;
+    if (index >= mb->nb_faces)
+    {
+        index -= mb->nb_faces;
+        if (index + mb->nb_leading_extra_faces >= mb->nb_extra_faces)
+            return D3DRMERR_BADVALUE;
+        *face = mb->extra_faces[index + mb->nb_leading_extra_faces];
+        IDirect3DRMFace_AddRef(&(*face)->IDirect3DRMFace_iface);
+        return D3DRM_OK;
+    }
+
+    for (i = 0; i < index; ++i)
+        ptr += 1 + *ptr * 2;
+    n = *ptr++;
+    if (FAILED(hr = d3drm_face_create(&object)))
+        return hr;
+    for (j = 0; j < n; ++j, ptr += 2)
+    {
+        if (ptr[0] >= mb->nb_vertices)
+        {
+            IDirect3DRMFace_Release(&object->IDirect3DRMFace_iface);
+            return D3DRMERR_BADVALUE;
+        }
+        if (FAILED(hr = d3drm_face_add_vertex_normal(object, &mb->vertices[ptr[0]],
+#ifdef SG_MUTANT_DRMMB_NO_NORMALS
+                NULL)))
+#else
+                ptr[1] < mb->nb_normals ? &mb->normals[ptr[1]] : NULL)))
+#endif
+        {
+            IDirect3DRMFace_Release(&object->IDirect3DRMFace_iface);
+            return hr;
+        }
+    }
+    IDirect3DRMFace_SetColor(&object->IDirect3DRMFace_iface, mb->color);
+    *face = object;
+    return D3DRM_OK;
+}
+
+static HRESULT mesh_builder_get_faces(struct d3drm_mesh_builder *mb, IDirect3DRMFaceArray **array)
+{
+    DWORD count = mb->nb_faces + mb->nb_extra_faces, i;
+    struct d3drm_face **faces;
+    HRESULT hr = D3DRM_OK;
+
+    if (!array)
+        return D3DRMERR_BADVALUE;
+    *array = NULL;
+    if (count && !(faces = calloc(count, sizeof(*faces))))
+        return E_OUTOFMEMORY;
+    else if (!count)
+        faces = NULL;
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+        hr = mesh_builder_get_face(mb, i, &faces[i]);
+    if (SUCCEEDED(hr))
+        hr = d3drm_face_array_create(faces, count, array);
+    for (i = 0; i < count; ++i)
+        if (faces[i])
+            IDirect3DRMFace_Release(&faces[i]->IDirect3DRMFace_iface);
+    free(faces);
+    return hr;
+}
+
+static HRESULT mesh_builder_create_face(struct d3drm_mesh_builder *mb, struct d3drm_face **face)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = d3drm_face_create(face)))
+        return hr;
+    if (!d3drm_array_reserve((void **)&mb->extra_faces, &mb->extra_faces_size, mb->nb_extra_faces + 1,
+            sizeof(*mb->extra_faces)))
+    {
+        IDirect3DRMFace_Release(&(*face)->IDirect3DRMFace_iface);
+        return E_OUTOFMEMORY;
+    }
+    mb->extra_faces[mb->nb_extra_faces++] = *face;
+    IDirect3DRMFace_AddRef(&(*face)->IDirect3DRMFace_iface);
+    return D3DRM_OK;
+}
+
+static void clean_mesh_builder_data(struct d3drm_mesh_builder *mesh_builder);
+
 static void clean_mesh_builder_data(struct d3drm_mesh_builder *mesh_builder)
 {
     DWORD i;
@@ -321,6 +420,10 @@ static void clean_mesh_builder_data(struct d3drm_mesh_builder *mesh_builder)
     mesh_builder->pFaceData = NULL;
     mesh_builder->face_data_size = 0;
     mesh_builder->nb_faces = 0;
+    /* faces made with CreateFace stay, in front of the ones loaded now */
+#ifndef SG_MUTANT_DRMMB_NO_LEADING
+    mesh_builder->nb_leading_extra_faces = mesh_builder->nb_extra_faces;
+#endif
     free(mesh_builder->pCoords2d);
