+++ b/dlls/d3drm/meshbuilder.c
@@ -304,6 +304,105 @@ static inline struct d3drm_wrap *impl_from_IDirect3DRMWrap(IDirect3DRMWrap *ifac
     return CONTAINING_RECORD(iface, struct d3drm_wrap, IDirect3DRMWrap_iface);
 }
 
