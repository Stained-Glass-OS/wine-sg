             IDirect3DRMMaterial2_Release(mesh_builder->material);
         if (mesh_builder->texture)
@@ -797,9 +904,9 @@ static HRESULT WINAPI d3drm_mesh_builder2_SetVertexColorRGB(IDirect3DRMMeshBuild
