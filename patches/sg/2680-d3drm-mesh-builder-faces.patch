+++ b/dlls/d3drm/face.c
@@ -86,7 +86,7 @@ static HRESULT face_get_vertex(struct d3drm_face *face, DWORD index, D3DVECTOR *
     if (vertex)
         *vertex = face->vertices[index].position;
     if (normal)
-        *normal = face_normal(face);
+        *normal = face->vertices[index].has_normal ? face->vertices[index].normal : face_normal(face);
     return D3DRM_OK;
 }
 
@@ -111,7 +111,7 @@ static HRESULT face_get_vertices(struct d3drm_face *face, DWORD *count, D3DVECTO
         if (coords)
             coords[i] = face->vertices[i].position;
         if (normals)
-            normals[i] = face_normal(face);
+            normals[i] = face->vertices[i].has_normal ? face->vertices[i].normal : face_normal(face);
     }
     *count = face->nb_vertices;
     return D3DRM_OK;
@@ -875,3 +875,133 @@ HRESULT d3drm_face_create(struct d3drm_face **face)
 
     return S_OK;
 }
+
+HRESULT d3drm_face_add_vertex_normal(struct d3drm_face *face, const D3DVECTOR *position, const D3DVECTOR *normal)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = face_add_vertex(face, position->x, position->y, position->z)))
+        return hr;
+    if (normal)
+    {
+        face->vertices[face->nb_vertices - 1].has_normal = TRUE;
+        face->vertices[face->nb_vertices - 1].normal = *normal;
+    }
+    return D3DRM_OK;
+}
+
+struct d3drm_face_array
+{
+    IDirect3DRMFaceArray IDirect3DRMFaceArray_iface;
+    LONG ref;
+    ULONG size;
+    IDirect3DRMFace **faces;
+};
+
+static inline struct d3drm_face_array *impl_from_IDirect3DRMFaceArray(IDirect3DRMFaceArray *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3drm_face_array, IDirect3DRMFaceArray_iface);
+}
+
+static HRESULT WINAPI d3drm_face_array_QueryInterface(IDirect3DRMFaceArray *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IDirect3DRMFaceArray) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IDirect3DRMFaceArray_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI d3drm_face_array_AddRef(IDirect3DRMFaceArray *iface)
+{
+    struct d3drm_face_array *array = impl_from_IDirect3DRMFaceArray(iface);
+    ULONG refcount = InterlockedIncrement(&array->ref);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI d3drm_face_array_Release(IDirect3DRMFaceArray *iface)
+{
+    struct d3drm_face_array *array = impl_from_IDirect3DRMFaceArray(iface);
+    ULONG refcount = InterlockedDecrement(&array->ref);
+    ULONG i;
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        for (i = 0; i < array->size; ++i)
+            IDirect3DRMFace_Release(array->faces[i]);
+        free(array->faces);
+        free(array);
+    }
+    return refcount;
+}
+
+static DWORD WINAPI d3drm_face_array_GetSize(IDirect3DRMFaceArray *iface)
+{
+    struct d3drm_face_array *array = impl_from_IDirect3DRMFaceArray(iface);
+
+    TRACE("iface %p.\n", iface);
+    return array->size;
+}
+
+static HRESULT WINAPI d3drm_face_array_GetElement(IDirect3DRMFaceArray *iface, DWORD index, IDirect3DRMFace **face)
+{
+    struct d3drm_face_array *array = impl_from_IDirect3DRMFaceArray(iface);
+
+    TRACE("iface %p, index %lu, face %p.\n", iface, index, face);
+
+    if (!face)
+        return D3DRMERR_BADVALUE;
+    if (index >= array->size)
+    {
+        *face = NULL;
+        return D3DRMERR_BADVALUE;
+    }
+    *face = array->faces[index];
+    IDirect3DRMFace_AddRef(*face);
+    return D3DRM_OK;
+}
+
+static const struct IDirect3DRMFaceArrayVtbl d3drm_face_array_vtbl =
+{
+    d3drm_face_array_QueryInterface,
+    d3drm_face_array_AddRef,
+    d3drm_face_array_Release,
+    d3drm_face_array_GetSize,
+    d3drm_face_array_GetElement,
+};
+
+/* Takes a reference to each face. */
+HRESULT d3drm_face_array_create(struct d3drm_face **faces, ULONG count, IDirect3DRMFaceArray **out)
+{
+    struct d3drm_face_array *array;
+    ULONG i;
+
+    if (!(array = calloc(1, sizeof(*array))))
+        return E_OUTOFMEMORY;
+    if (count && !(array->faces = calloc(count, sizeof(*array->faces))))
+    {
+        free(array);
+        return E_OUTOFMEMORY;
+    }
+    array->IDirect3DRMFaceArray_iface.lpVtbl = &d3drm_face_array_vtbl;
+    array->ref = 1;
+    array->size = count;
+    for (i = 0; i < count; ++i)
+    {
+        array->faces[i] = &faces[i]->IDirect3DRMFace_iface;
+        IDirect3DRMFace_AddRef(array->faces[i]);
+    }
+    *out = &array->IDirect3DRMFaceArray_iface;
+    return S_OK;
+}
