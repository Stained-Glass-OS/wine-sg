From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: Marshal HPALETTE.

HPALETTE_UserSize/Marshal/Unmarshal/Free (userHPALETTE, wtypes.idl): the
handle in-process (WDT_INPROC_CALL); otherwise an rpcLOGPALETTE
(WDT_REMOTE_CALL, then the count, palVersion, palNumEntries and the
entries) from which the receiver makes its own palette, deleted again by
HPALETTE_UserFree. They were no-ops, so palettes never crossed.

Gate: test/combase-hpalette-gate.sh (64/32).
---
 dlls/combase/usrmarshal.c | 97 ++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 92 insertions(+), 5 deletions(-)

diff --git a/dlls/combase/usrmarshal.c b/dlls/combase/usrmarshal.c
index cb22fa0..6979886 100644
--- a/dlls/combase/usrmarshal.c
+++ b/dlls/combase/usrmarshal.c
@@ -561,10 +561,20 @@ void __RPC_USER HBITMAP_UserFree(ULONG *flags, HBITMAP *bmp)
  *  the first parameter is a ULONG.
  *  This function is only intended to be called by the RPC runtime.
  */
+/* userHPALETTE (wtypes.idl): in-process the handle; otherwise a
+ * rpcLOGPALETTE - a conformant count, then palVersion, palNumEntries and
+ * the entries - from which the other side makes its own palette. */
 ULONG __RPC_USER HPALETTE_UserSize(ULONG *pFlags, ULONG StartingSize, HPALETTE *phPal)
 {
-    FIXME(":stub\n");
-    return StartingSize;
+    ULONG size = StartingSize;
+
+    TRACE("%s, %lu, %p.\n", debugstr_user_flags(pFlags), StartingSize, *phPal);
+
+    ALIGN_LENGTH(size, 3);
+    size += 2 * sizeof(ULONG);
+    if (LOWORD(*pFlags) != MSHCTX_INPROC && *phPal)
+        size += sizeof(ULONG) + 2 * sizeof(WORD) + GetPaletteEntries(*phPal, 0, 0, NULL) * sizeof(PALETTEENTRY);
+    return size;
 }
 
 /******************************************************************************
@@ -588,7 +598,40 @@ ULONG __RPC_USER HPALETTE_UserSize(ULONG *pFlags, ULONG StartingSize, HPALETTE *
  */
 unsigned char * __RPC_USER HPALETTE_UserMarshal(ULONG *pFlags, unsigned char *pBuffer, HPALETTE *phPal)
 {
-    FIXME(":stub\n");
+    TRACE("%s, %p, %p.\n", debugstr_user_flags(pFlags), pBuffer, *phPal);
+
+    ALIGN_POINTER(pBuffer, 3);
+#ifndef SG_MUTANT_HPALETTE_REMOTE_AS_HANDLE
+    if (LOWORD(*pFlags) == MSHCTX_INPROC)
+#endif
+    {
+        *(ULONG *)pBuffer = WDT_INPROC_CALL;
+        pBuffer += sizeof(ULONG);
+        *(ULONG *)pBuffer = (ULONG)(ULONG_PTR)*phPal;
+        pBuffer += sizeof(ULONG);
+    }
+#ifndef SG_MUTANT_HPALETTE_REMOTE_AS_HANDLE
+    else
+    {
+        *(ULONG *)pBuffer = WDT_REMOTE_CALL;
+        pBuffer += sizeof(ULONG);
+        *(ULONG *)pBuffer = (ULONG)(ULONG_PTR)*phPal;
+        pBuffer += sizeof(ULONG);
+        if (*phPal)
+        {
+            UINT count = GetPaletteEntries(*phPal, 0, 0, NULL);
+
+            *(ULONG *)pBuffer = count;
+            pBuffer += sizeof(ULONG);
+            *(WORD *)pBuffer = 0x300;
+            pBuffer += sizeof(WORD);
+            *(WORD *)pBuffer = count;
+            pBuffer += sizeof(WORD);
+            GetPaletteEntries(*phPal, 0, count, (PALETTEENTRY *)pBuffer);
+            pBuffer += count * sizeof(PALETTEENTRY);
+        }
+    }
+#endif
     return pBuffer;
 }
 
@@ -613,7 +656,47 @@ unsigned char * __RPC_USER HPALETTE_UserMarshal(ULONG *pFlags, unsigned char *pB
  */
 unsigned char * __RPC_USER HPALETTE_UserUnmarshal(ULONG *pFlags, unsigned char *pBuffer, HPALETTE *phPal)
 {
-    FIXME(":stub\n");
+    ULONG context, handle;
+
+    TRACE("%s, %p, %p.\n", debugstr_user_flags(pFlags), pBuffer, phPal);
+
+    ALIGN_POINTER(pBuffer, 3);
+    context = *(ULONG *)pBuffer;
+    pBuffer += sizeof(ULONG);
+    handle = *(ULONG *)pBuffer;
+    pBuffer += sizeof(ULONG);
+
+    if (context == WDT_INPROC_CALL)
+        *phPal = (HPALETTE)(LONG_PTR)(LONG)handle;
+    else if (context == WDT_REMOTE_CALL)
+    {
+        if (handle)
+        {
+            ULONG count = *(ULONG *)pBuffer;
+            LOGPALETTE *pal;
+
+            pBuffer += sizeof(ULONG);
+            if (!(pal = malloc(FIELD_OFFSET(LOGPALETTE, palPalEntry[count]))))
+                RaiseException(E_OUTOFMEMORY, 0, 0, NULL);
+            pal->palVersion = *(WORD *)pBuffer;
+            pBuffer += sizeof(WORD);
+            pal->palNumEntries = *(WORD *)pBuffer;
+            pBuffer += sizeof(WORD);
+            if (pal->palNumEntries != count)
+            {
+                free(pal);
+                RaiseException(RPC_X_BAD_STUB_DATA, 0, 0, NULL);
+            }
+            memcpy(pal->palPalEntry, pBuffer, count * sizeof(PALETTEENTRY));
+            pBuffer += count * sizeof(PALETTEENTRY);
+            *phPal = CreatePalette(pal);
+            free(pal);
+        }
+        else
+            *phPal = NULL;
+    }
+    else
+        RaiseException(RPC_S_INVALID_TAG, 0, 0, NULL);
     return pBuffer;
 }
 
@@ -856,7 +939,11 @@ void __RPC_USER HGLOBAL_UserFree(ULONG *pFlags, HGLOBAL *phGlobal)
  */
 void __RPC_USER HPALETTE_UserFree(ULONG *pFlags, HPALETTE *phPal)
 {
-    FIXME(":stub\n");
+    TRACE("%s, %p.\n", debugstr_user_flags(pFlags), *phPal);
+
+    /* a palette made from the data on unmarshalling is ours to free */
+    if (LOWORD(*pFlags) != MSHCTX_INPROC)
+        DeleteObject(*phPal);
 }
 
 /******************************************************************************
