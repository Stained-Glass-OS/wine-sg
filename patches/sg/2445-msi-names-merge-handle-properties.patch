From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: hyphen names, empty quoted names, MERGE against an existing row, properties of a package from a database handle

Ground truth from Wine's msi db tests (11 todo_wine marks removed): an unquoted name may begin with a hyphen ("SELECT * FROM -a"; a hyphen before a digit is still minus); a quoted name with nothing in it is a syntax error; MsiViewModify with MSIMODIFY_MERGE on a row whose key exists is ERROR_FUNCTION_FAILED unless the record says what the row says; the properties a package opened from a database handle sets (SetProperty, a custom action) go when the package is closed instead of staying in the handle's database.
---
--- a/dlls/msi/msipriv.h
+++ b/dlls/msi/msipriv.h
@@ -462,6 +462,7 @@ typedef struct tagMSIPACKAGE
     LPWSTR ProductCode;
     LPWSTR localfile;
     BOOL delete_on_close;
+    BOOL db_from_handle;       /* opened from a database handle: its temporary property table goes with the package */
 
     INSTALLUILEVEL ui_level;
     msi_dialog *dialog;
--- a/dlls/msi/package.c
+++ b/dlls/msi/package.c
@@ -337,6 +337,20 @@ static void MSI_FreePackage( MSIOBJECTHDR *arg)
     if( package->dialog )
         msi_dialog_destroy( package->dialog );
 
+    /* a database handle outlives the package: the property table made for the package goes */
+#ifndef SG_MUTANT_MSI_PROPERTY_LEAK
+    if (package->db_from_handle)
+    {
+        MSIQUERY *view;
+
+        if (!MSI_DatabaseOpenViewW( package->db, L"DROP TABLE `_Property`", &view ))
+        {
+            MSI_ViewExecute( view, 0 );
+            MSI_ViewClose( view );
+            msiobj_release( &view->hdr );
+        }
+    }
+#endif
     msiobj_release( &package->db->hdr );
     free_package_structures(package);
     CloseHandle( package->log_file );
@@ -1476,6 +1490,7 @@ UINT MSI_OpenPackageW(LPCWSTR szPackage, DWORD dwOptions, MSIPACKAGE **pPackage)
     if (!package) return ERROR_INSTALL_PACKAGE_INVALID;
     package->localfile = wcsdup( localfile );
     package->delete_on_close = delete_on_close;
+    package->db_from_handle = (szPackage[0] == '#');
 
     r = msi_get_suminfo( db->storage, 0, &si );
     if (r != ERROR_SUCCESS)
--- a/dlls/msi/sql.y
+++ b/dlls/msi/sql.y
@@ -720,6 +720,11 @@ id:
         {
             if ( SQL_getstring( info, &$1, &$$ ) != ERROR_SUCCESS || !$$ )
                 YYABORT;
+#ifndef SG_MUTANT_MSI_EMPTY_ID
+            /* a quoted name with nothing in it names nothing */
+            if ( !$$[0] )
+                YYABORT;
+#endif
         }
     ;
 
--- a/dlls/msi/table.c
+++ b/dlls/msi/table.c
@@ -1912,6 +1912,25 @@ static UINT TABLE_modify( struct tagMSIVIEW *view, MSIMODIFY eModifyMode,
             if (r == ERROR_SUCCESS)
                 r = TABLE_insert_row( view, rec, -1, FALSE );
         }
+#ifndef SG_MUTANT_MSI_MERGE
+        else
+        {
+            /* the row is there: merging succeeds only if the record says what the row says */
+            UINT i, new, cur;
+
+            for (i = 0; i < tv->num_cols; i++)
+            {
+                if (MSITYPE_IS_BINARY(tv->columns[i].type)) continue;
+                if (get_table_value_from_record( tv, rec, i + 1, &new )) new = 0;
+                if (TABLE_fetch_int( view, frow, i + 1, &cur )) continue;
+                if (new != cur)
+                {
+                    r = ERROR_FUNCTION_FAILED;
+                    break;
+                }
+            }
+        }
+#endif
         break;
 
     case MSIMODIFY_REPLACE:
--- a/dlls/msi/tests/db.c
+++ b/dlls/msi/tests/db.c
