--- a/dlls/msi/tokenize.c
+++ b/dlls/msi/tokenize.c
@@ -180,6 +180,14 @@ int sqliteGetToken(const WCHAR *z, int *tokenType, int *skip){
       return i;
     case '-':
       if( z[1]==0 ) return -1;
+      /* a name that starts with a hyphen (not a number) is a name */
+#ifndef SG_MUTANT_MSI_HYPHEN_NAME
+      if( z[1]!='-' && isIdChar[z[1]] && !isDigit(z[1]) ){
+        for(i=2; isIdChar[z[i]]; i++){}
+        *tokenType = TK_ID;
+        return i;
+      }
+#endif
       *tokenType = TK_MINUS;
       return 1;
     case '(':
