+{
+    TRACE("(%p %s)\n", this, debugstr_a(str));
+    return msvcp60_exception_init(this, str, &__non_rtti_object_vtable);
+}
+
+/* ??0__non_rtti_object@std@@QAE@ABV01@@Z */
+/* ??0__non_rtti_object@std@@QEAA@AEBV01@@Z */
+DEFINE_THISCALL_WRAPPER(MSVCP___non_rtti_object_copy_ctor, 8)
+__non_rtti_object* __thiscall MSVCP___non_rtti_object_copy_ctor(__non_rtti_object *this, const __non_rtti_object *rhs)
+{
