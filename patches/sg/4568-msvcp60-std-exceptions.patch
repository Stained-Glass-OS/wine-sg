 DEFINE_RTTI_DATA2(domain_error, 0, &logic_error_rtti_base_descriptor, &exception_rtti_base_descriptor, ".?AVdomain_error@std@@")
+
+/* std::bad_typeid, std::__non_rtti_object and std::bad_exception: msvcp60
+ * has its own, beside the CRT's global ones */
+typedef exception bad_typeid;
+typedef exception __non_rtti_object;
+typedef exception bad_exception;
+extern const vtable_ptr bad_typeid_vtable;
+extern const vtable_ptr __non_rtti_object_vtable;
+extern const vtable_ptr bad_exception_vtable;
+
+static exception* msvcp60_exception_init(exception *this, const char *str, const vtable_ptr *vtable)
+{
+    MSVCP_exception_ctor(this, EXCEPTION_NAME(str));
+    this->vtable = vtable;
+    return this;
+}
+
+/* ??0bad_typeid@std@@QAE@PBD@Z */
+/* ??0bad_typeid@std@@QEAA@PEBD@Z */
+DEFINE_THISCALL_WRAPPER(MSVCP_bad_typeid_ctor, 8)
+bad_typeid* __thiscall MSVCP_bad_typeid_ctor(bad_typeid *this, const char *str)
+{
+    TRACE("(%p %s)\n", this, debugstr_a(str));
+    return msvcp60_exception_init(this, str, &bad_typeid_vtable);
+}
+
+/* ??_Fbad_typeid@std@@QAEXXZ */
+/* ??_Fbad_typeid@std@@QEAAXXZ */
+DEFINE_THISCALL_WRAPPER(MSVCP_bad_typeid_default_ctor, 4)
+bad_typeid* __thiscall MSVCP_bad_typeid_default_ctor(bad_typeid *this)
+{
+    return MSVCP_bad_typeid_ctor(this, "bad typeid");
+}
+
+/* ??0bad_typeid@std@@QAE@ABV01@@Z */
+/* ??0bad_typeid@std@@QEAA@AEBV01@@Z */
+DEFINE_THISCALL_WRAPPER(MSVCP_bad_typeid_copy_ctor, 8)
+bad_typeid* __thiscall MSVCP_bad_typeid_copy_ctor(bad_typeid *this, const bad_typeid *rhs)
+{
+    TRACE("(%p %p)\n", this, rhs);
+    exception_copy_ctor(this, rhs);
+    this->vtable = &bad_typeid_vtable;
+    return this;
+}
+
+/* ??4bad_typeid@std@@QAEAAV01@ABV01@@Z */
+/* ??4bad_typeid@std@@QEAAAEAV01@AEBV01@@Z */
+DEFINE_THISCALL_WRAPPER(MSVCP_bad_typeid_assign, 8)
+bad_typeid* __thiscall MSVCP_bad_typeid_assign(bad_typeid *this, const bad_typeid *assign)
+{
+    MSVCP_exception_dtor(this);
+    return MSVCP_bad_typeid_copy_ctor(this, assign);
+}
