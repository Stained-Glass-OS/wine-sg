From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: path gradient brushes follow their blend and preset blend

A path gradient brush blended linearly from its surround colours to its centre colour whatever its blend factors (SetBlend, SetSigmaBellShape, SetLinearBlend) or preset colours (InterpolationColors) said, with a FIXME. The pixel colour now takes the centre colour by the blend factor at its distance from the boundary (0) to the centre (1), or the preset colours outright.
---
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -696,6 +696,36 @@
         (((start & 0xff) * start_a + ((end & 0xff) * end_a)) / final_a);
 }
 
+/* (wine-sg 8297) a path gradient pixel at distance 0 (the boundary) to 1 (the centre): its blend factors
+ * (SetBlend, SetSigmaBellShape, SetLinearBlend) say how much of the centre colour each distance takes; its
+ * preset blend (InterpolationColors) gives the colours outright. */
+static ARGB path_gradient_color(const GpPathGradient *fill, ARGB outer, REAL distance)
+{
+    REAL factor = distance;
+    int i;
+
+    if (distance < 0.0f) distance = 0.0f;
+    if (distance > 1.0f) distance = 1.0f;
+#ifndef SG_MUTANT_NO_PATHGRAD_BLEND
+    if (fill->pblendcount >= 2)
+    {
+        for (i = 1; i < fill->pblendcount - 1 && distance > fill->pblendpos[i]; i++) ;
+        if (fill->pblendpos[i] <= fill->pblendpos[i-1]) return fill->pblendcolor[i];
+        return blend_colors(fill->pblendcolor[i-1], fill->pblendcolor[i],
+                (distance - fill->pblendpos[i-1]) / (fill->pblendpos[i] - fill->pblendpos[i-1]));
+    }
+    if (fill->blendcount >= 2)
+    {
+        for (i = 1; i < fill->blendcount - 1 && distance > fill->blendpos[i]; i++) ;
+        if (fill->blendpos[i] <= fill->blendpos[i-1]) factor = fill->blendfac[i];
+        else
+            factor = fill->blendfac[i-1] + (fill->blendfac[i] - fill->blendfac[i-1]) *
+                    (distance - fill->blendpos[i-1]) / (fill->blendpos[i] - fill->blendpos[i-1]);
+    }
+#endif
+    return blend_colors(outer, fill->centercolor, factor);
+}
+
 static ARGB blend_line_gradient(GpLineGradient* brush, REAL position)
 {
     REAL blendfac;
@@ -1795,6 +1825,7 @@
                 FIXME("path gradient gamma correction not implemented\n");
         }
 
+#ifdef SG_MUTANT_NO_PATHGRAD_BLEND
         if (fill->blendcount)
         {
             static int once;
@@ -1808,6 +1839,7 @@
             if (!once++)
                 FIXME("path gradient preset blend not implemented\n");
         }
+#endif
 
         if (!transform_fixme_once)
         {
@@ -1980,7 +2012,7 @@
                     distance = distance / center_distance;
 
                     argb_pixels[(x-fill_area->X) + (y-fill_area->Y)*cdwStride] =
-                        blend_colors(outer_color, fill->centercolor, distance);
+                        path_gradient_color(fill, outer_color, distance);
                 }
             }
         }
