From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] combase: standard marshaler DisconnectObject disconnects its object

CoGetStandardMarshal remembers the object; IMarshal::DisconnectObject
releases the stub connections like CoDisconnectObject.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -1125,7 +1125,7 @@
     ClientIdentity_QueryMultipleInterfaces
 };
 
-static HRESULT StdMarshalImpl_Construct(REFIID, DWORD, void*, void**);
+static HRESULT StdMarshalImpl_Construct(REFIID, DWORD, void*, IUnknown*, void**);
 
 static HRESULT WINAPI Proxy_QueryInterface(IMarshal *iface, REFIID riid, void **ppvObject)
 {
@@ -1304,7 +1304,7 @@
     TRACE("(%p, %p, %s, %p)\n", This, pStm, wine_dbgstr_guid(riid), ppv);
 
     hr = StdMarshalImpl_Construct(&IID_IMarshal, This->dest_context,
-            This->dest_context_data, (void**)&marshal);
+            This->dest_context_data, NULL, (void**)&marshal);
     if(FAILED(hr))
         return hr;
 
@@ -1322,7 +1322,7 @@
     TRACE("(%p, %p)\n", This, pStm);
 
     hr = StdMarshalImpl_Construct(&IID_IMarshal, This->dest_context,
-            This->dest_context_data, (void**)&marshal);
+            This->dest_context_data, NULL, (void**)&marshal);
     if(FAILED(hr))
         return hr;
 
@@ -1340,7 +1340,7 @@
     TRACE("%p, %#lx\n", This, dwReserved);
 
     hr = StdMarshalImpl_Construct(&IID_IMarshal, This->dest_context,
-            This->dest_context_data, (void**)&marshal);
+            This->dest_context_data, NULL, (void**)&marshal);
     if(FAILED(hr))
         return hr;
 
@@ -2154,6 +2154,7 @@
     LONG refcount;
     DWORD dest_context;
     void *dest_context_data;
+    IUnknown *object; /* the object this marshaler was made for, or NULL */
 };
 
 static inline struct stdmarshal *impl_from_StdMarshal(IMarshal *iface)
@@ -2186,7 +2187,10 @@
     ULONG refcount = InterlockedDecrement(&marshal->refcount);
 
     if (!refcount)
+    {
+        if (marshal->object) IUnknown_Release(marshal->object);
         free(marshal);
+    }
 
     return refcount;
 }
@@ -2365,7 +2369,28 @@
 
 static HRESULT WINAPI StdMarshalImpl_DisconnectObject(IMarshal *iface, DWORD reserved)
 {
-    FIXME("(), stub!\n");
+    struct stdmarshal *marshal = impl_from_StdMarshal(iface);
+    struct stub_manager *manager;
+    struct apartment *apt;
+
+    TRACE("%p, %#lx\n", iface, reserved);
+
+    /* a marshaler made without an object (the unmarshaling side) has nothing to disconnect */
+    if (!marshal->object) return S_OK;
+
+    /* the same work CoDisconnectObject does for an object without its own
+     * IMarshal; calling CoDisconnectObject here would find this marshaler again */
+    if (!(apt = apartment_get_current_or_mta())) return CO_E_NOTINITIALIZED;
+
+    manager = get_stub_manager_from_object(apt, marshal->object, FALSE);
+    if (manager)
+    {
+        stub_manager_disconnect(manager);
+        /* Release stub manager twice, to remove the apartment reference. */
+        stub_manager_int_release(manager);
+        stub_manager_int_release(manager);
+    }
+    apartment_release(apt);
     return S_OK;
 }
 
@@ -2382,7 +2407,8 @@
     StdMarshalImpl_DisconnectObject
 };
 
-static HRESULT StdMarshalImpl_Construct(REFIID riid, DWORD dest_context, void *dest_context_data, void **ppvObject)
+static HRESULT StdMarshalImpl_Construct(REFIID riid, DWORD dest_context, void *dest_context_data,
+        IUnknown *unk, void **ppvObject)
 {
     struct stdmarshal *object;
     HRESULT hr;
@@ -2395,6 +2421,8 @@
     object->refcount = 1;
     object->dest_context = dest_context;
     object->dest_context_data = dest_context_data;
+    object->object = unk;
+    if (unk) IUnknown_AddRef(unk);
 
     hr = IMarshal_QueryInterface(&object->IMarshal_iface, riid, ppvObject);
     IMarshal_Release(&object->IMarshal_iface);
@@ -2404,7 +2432,7 @@
 
 HRESULT WINAPI InternalCoStdMarshalObject(REFIID riid, DWORD dest_context, void *dest_context_data, void **ppvObject)
 {
-    return StdMarshalImpl_Construct(riid, dest_context, dest_context_data, ppvObject);
+    return StdMarshalImpl_Construct(riid, dest_context, dest_context_data, NULL, ppvObject);
 }
 
 /***********************************************************************
@@ -2419,5 +2447,5 @@
      * object serves both cases. */
     TRACE("%s, %p, %lx, %p, %lx, %p\n", debugstr_guid(riid), pUnk, dwDestContext, dest_context, flags, marshal);
 
-    return StdMarshalImpl_Construct(&IID_IMarshal, dwDestContext, dest_context, (void **)marshal);
+    return StdMarshalImpl_Construct(&IID_IMarshal, dwDestContext, dest_context, pUnk, (void **)marshal);
 }
-- 
2.47.0
