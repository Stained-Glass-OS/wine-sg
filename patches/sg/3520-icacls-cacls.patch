 #include <stdlib.h>
 #include <stdio.h>
+#include <wchar.h>
+
+#include <windows.h>
+#include <aclapi.h>
+#include <sddl.h>
+
+#define ACCESS_DENIED_EXIT 5
+#ifndef PROTECTED_DACL_SECURITY_INFORMATION
+#define PROTECTED_DACL_SECURITY_INFORMATION   0x80000000
+#define UNPROTECTED_DACL_SECURITY_INFORMATION 0x20000000
+#endif
+
+static BOOL opt_recurse, opt_continue, opt_quiet, opt_links;
+static DWORD processed_ok, processed_failed;
+#ifndef ARRAY_SIZE
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#endif
+
+static void out( const WCHAR *fmt, ... )
+{
+    va_list args;
+    WCHAR buf[4096];
+    DWORD written, len;
+    HANDLE h = GetStdHandle( STD_OUTPUT_HANDLE );
+
+    va_start( args, fmt );
+    len = vswprintf( buf, ARRAY_SIZE(buf), fmt, args );
+    va_end( args );
+    if (!WriteConsoleW( h, buf, len, &written, NULL ))
+    {
+        char mb[8192];
+        int n = WideCharToMultiByte( GetConsoleOutputCP(), 0, buf, len, mb, sizeof(mb), NULL, NULL );
+        WriteFile( h, mb, n, &written, NULL );
+    }
+}
+
+static void error_line( const WCHAR *prefix, DWORD err )
+{
+    WCHAR *msg = NULL;
+
+    FormatMessageW( FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL,
+                    err, 0, (WCHAR *)&msg, 0, NULL );
+    if (msg)
+    {
+        WCHAR *end = msg + wcslen( msg );
+        while (end > msg && (end[-1] == '\r' || end[-1] == '\n' || end[-1] == ' ')) *--end = 0;
+    }
+    out( L"%ls: %ls\n", prefix, msg ? msg : L"Unknown error" );
+    LocalFree( msg );
+}
+
+static const struct { const WCHAR *name; DWORD mask; } simple_rights[] =
+{
+    { L"F",  0x1f01ff }, /* FILE_ALL_ACCESS */
+    { L"M",  0x1301bf },
+    { L"RX", 0x1200a9 },
+    { L"R",  0x120089 },
+    { L"W",  0x120116 },
+    { L"D",  0x010000 },
+};
+
+static const struct { const WCHAR *name; DWORD mask; } specific_rights[] =
+{
+    { L"DE",   0x00010000 }, { L"RC",   0x00020000 }, { L"WDAC", 0x00040000 }, { L"WO",   0x00080000 },
+    { L"S",    0x00100000 }, { L"AS",   0x01000000 }, { L"MA",   0x02000000 }, { L"GR",   0x80000000 },
+    { L"GW",   0x40000000 }, { L"GE",   0x20000000 }, { L"GA",   0x10000000 }, { L"RD",   0x00000001 },
+    { L"WD",   0x00000002 }, { L"AD",   0x00000004 }, { L"REA",  0x00000008 }, { L"WEA",  0x00000010 },
+    { L"X",    0x00000020 }, { L"DC",   0x00000040 }, { L"RA",   0x00000080 }, { L"WA",   0x00000100 },
+};
+
+/* "(F)" for a mask that is exactly one of the simple rights, else the specific rights in one group */
+static void format_rights( DWORD mask, WCHAR *buf, size_t size )
+{
+    size_t i;
+    BOOL first = TRUE;
+
+    for (i = 0; i < ARRAY_SIZE(simple_rights); i++)
+    {
+        if (mask == simple_rights[i].mask)
+        {
+            swprintf( buf, size, L"(%ls)", simple_rights[i].name );
+            return;
+        }
+    }
+    wcscpy( buf, L"(" );
+    for (i = 0; i < ARRAY_SIZE(specific_rights); i++)
+    {
+        if (!(mask & specific_rights[i].mask)) continue;
+        if (!first) wcscat( buf, L"," );
+        wcscat( buf, specific_rights[i].name );
+        first = FALSE;
+    }
+    wcscat( buf, L")" );
+}
+
+static BOOL account_name( PSID sid, WCHAR *buf, size_t size )
+{
+    WCHAR name[256], domain[256];
+    DWORD nlen = ARRAY_SIZE(name), dlen = ARRAY_SIZE(domain);
+    SID_NAME_USE use;
+    WCHAR *str;
+
+    if (LookupAccountSidW( NULL, sid, name, &nlen, domain, &dlen, &use ))
+    {
+        if (domain[0]) swprintf( buf, size, L"%ls\\%ls", domain, name );
+        else swprintf( buf, size, L"%ls", name );
+        return TRUE;
+    }
+    if (ConvertSidToStringSidW( sid, &str ))
+    {
+        swprintf( buf, size, L"%ls", str );
+        LocalFree( str );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void print_acl( const WCHAR *path, ACL *dacl )
+{
+    ACL_SIZE_INFORMATION info;
+    DWORD i;
+    BOOL first = TRUE;
+    size_t indent = wcslen( path ) + 1;
+
+    if (!dacl)
+    {
+        out( L"%ls Everyone:(F)\n", path );
+        return;
+    }
+    GetAclInformation( dacl, &info, sizeof(info), AclSizeInformation );
+    for (i = 0; i < info.AceCount; i++)
+    {
+        ACE_HEADER *hdr;
+        ACCESS_ALLOWED_ACE *ace;
+        WCHAR who[512], rights[256], flags[64] = L"";
+
+        if (!GetAce( dacl, i, (void **)&hdr )) continue;
+        if (hdr->AceType != ACCESS_ALLOWED_ACE_TYPE && hdr->AceType != ACCESS_DENIED_ACE_TYPE) continue;
+        ace = (ACCESS_ALLOWED_ACE *)hdr;
+        if (!account_name( (PSID)&ace->SidStart, who, ARRAY_SIZE(who) )) continue;
+
+        if (hdr->AceFlags & INHERITED_ACE) wcscat( flags, L"(I)" );
+        if (hdr->AceFlags & OBJECT_INHERIT_ACE) wcscat( flags, L"(OI)" );
+        if (hdr->AceFlags & CONTAINER_INHERIT_ACE) wcscat( flags, L"(CI)" );
+        if (hdr->AceFlags & INHERIT_ONLY_ACE) wcscat( flags, L"(IO)" );
+        if (hdr->AceFlags & NO_PROPAGATE_INHERIT_ACE) wcscat( flags, L"(NP)" );
+        format_rights( ace->Mask, rights, ARRAY_SIZE(rights) );
+        if (first) out( L"%ls %ls:%ls%ls%ls\n", path, who, flags, hdr->AceType == ACCESS_DENIED_ACE_TYPE ? L"(DENY)" : L"", rights );
+        else out( L"%*ls%ls:%ls%ls%ls\n", (int)indent, L"", who, flags, hdr->AceType == ACCESS_DENIED_ACE_TYPE ? L"(DENY)" : L"", rights );
+        first = FALSE;
+    }
+    if (first) out( L"%ls\n", path );
+    out( L"\n" );
+}
+
+/* a trustee given as a name, DOMAIN\name or *S-1-... */
+static PSID lookup_sid( const WCHAR *name, BOOL *needs_free )
+{
+    PSID sid = NULL;
+    BYTE buf[SECURITY_MAX_SID_SIZE];
+    WCHAR domain[256];
+    DWORD size = sizeof(buf), dlen = ARRAY_SIZE(domain);
+    SID_NAME_USE use;
+
+    *needs_free = FALSE;
+    if (name[0] == '*')
+    {
+        if (ConvertStringSidToSidW( name + 1, &sid )) { *needs_free = TRUE; return sid; }
+        return NULL;
+    }
+    if (!LookupAccountNameW( NULL, name, buf, &size, domain, &dlen, &use )) return NULL;
+    if (!(sid = LocalAlloc( LMEM_FIXED, size ))) return NULL;
+    memcpy( sid, buf, size );
+    *needs_free = TRUE;
+    return sid;
+}
+
+static BOOL parse_permissions( const WCHAR *text, DWORD *mask, DWORD *inherit )
+{
+    const WCHAR *p = text;
+
+    *mask = 0;
+    *inherit = NO_INHERITANCE;
+    while (*p)
+    {
+        WCHAR token[16];
+        size_t n = 0, i;
+
+        if (*p != '(')
+        {
+            /* a bare simple right: F, M, RX, R, W, D */
+            while (*p && *p != '(' && n < ARRAY_SIZE(token) - 1) token[n++] = *p++;
+            token[n] = 0;
+            for (i = 0; i < ARRAY_SIZE(simple_rights); i++)
+                if (!wcsicmp( token, simple_rights[i].name )) { *mask |= simple_rights[i].mask; break; }
+            if (i == ARRAY_SIZE(simple_rights)) return FALSE;
+            continue;
+        }
+        p++;
+        while (*p && *p != ')')
+        {
+            n = 0;
+            while (*p && *p != ',' && *p != ')' && n < ARRAY_SIZE(token) - 1) token[n++] = *p++;
+            token[n] = 0;
+            if (*p == ',') p++;
+            if (!wcsicmp( token, L"OI" )) *inherit |= OBJECT_INHERIT_ACE;
+            else if (!wcsicmp( token, L"CI" )) *inherit |= CONTAINER_INHERIT_ACE;
+            else if (!wcsicmp( token, L"IO" )) *inherit |= INHERIT_ONLY_ACE;
+            else if (!wcsicmp( token, L"NP" )) *inherit |= NO_PROPAGATE_INHERIT_ACE;
+            else
+            {
+                for (i = 0; i < ARRAY_SIZE(simple_rights); i++)
+                    if (!wcsicmp( token, simple_rights[i].name )) { *mask |= simple_rights[i].mask; break; }
+                if (i < ARRAY_SIZE(simple_rights)) continue;
+                for (i = 0; i < ARRAY_SIZE(specific_rights); i++)
+                    if (!wcsicmp( token, specific_rights[i].name )) { *mask |= specific_rights[i].mask; break; }
+                if (i == ARRAY_SIZE(specific_rights)) return FALSE;
+            }
+        }
+        if (*p != ')') return FALSE;
+        p++;
+    }
+    return *mask != 0;
+}
+
+enum action_type { ACT_GRANT, ACT_GRANT_R, ACT_DENY, ACT_REMOVE, ACT_REMOVE_G, ACT_REMOVE_D, ACT_RESET, ACT_SETOWNER,
+                   ACT_INHERIT_E, ACT_INHERIT_D, ACT_INHERIT_R, ACT_SAVE, ACT_RESTORE, ACT_FINDSID, ACT_VERIFY };
+
+struct action
+{
+    enum action_type type;
+    const WCHAR *arg;
+};
+
+static struct action actions[64];
+static int action_count;
+static const WCHAR *save_file;
+
+static BOOL apply_grant_deny( const WCHAR *path, const struct action *act )
+{
+    EXPLICIT_ACCESSW ea[16];
+    WCHAR *copy = wcsdup( act->arg ), *item, *next;
+    ACL *old = NULL, *new_acl = NULL;
+    PSECURITY_DESCRIPTOR sd = NULL;
+    PSID sids[16];
+    BOOL frees[16], ok = FALSE;
+    int n = 0, i;
+    DWORD err;
+
+    if (!copy) return FALSE;
+    for (item = copy; item && *item && n < 16; item = next)
+    {
+        DWORD mask, inherit;
+        BOOL f;
+
+        WCHAR *c = wcschr( item, ':' ), *paren, *q;
+        int depth = 0;
+
+        /* items are separated by a comma outside of parentheses; the first colon ends the trustee */
+        next = NULL;
+        if (!c) { free( copy ); return FALSE; }
+        *c = 0;
+        paren = c + 1;
+        for (q = paren; *q; q++)
+        {
+            if (*q == '(') depth++;
+            else if (*q == ')') depth--;
+            else if (*q == ',' && depth == 0) { *q = 0; next = q + 1; break; }
+        }
+        {
+            if (!(sids[n] = lookup_sid( item, &f )))
+            {
+                out( L"%ls: No mapping between account names and security IDs was done.\n", item );
+                for (i = 0; i < n; i++) if (frees[i]) LocalFree( sids[i] );
+                free( copy );
+                return FALSE;
+            }
+            frees[n] = f;
+            if (!parse_permissions( paren, &mask, &inherit ))
+            {
+                out( L"Invalid parameter \"%ls\"\n", paren );
+                for (i = 0; i <= n; i++) if (frees[i]) LocalFree( sids[i] );
+                free( copy );
+                return FALSE;
+            }
+            memset( &ea[n], 0, sizeof(ea[n]) );
+            ea[n].grfAccessPermissions = mask;
+            ea[n].grfAccessMode = act->type == ACT_DENY ? DENY_ACCESS : act->type == ACT_GRANT_R ? SET_ACCESS : GRANT_ACCESS;
+            ea[n].grfInheritance = inherit;
+            ea[n].Trustee.TrusteeForm = TRUSTEE_IS_SID;
+            ea[n].Trustee.TrusteeType = TRUSTEE_IS_UNKNOWN;
+            ea[n].Trustee.ptstrName = (WCHAR *)sids[n];
+            n++;
+        }
+    }
+
+    err = GetNamedSecurityInfoW( path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, NULL, NULL, &old, NULL, &sd );
+    if (!err) err = SetEntriesInAclW( n, ea, old, &new_acl );
+    if (!err) err = SetNamedSecurityInfoW( (WCHAR *)path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, NULL, NULL, new_acl, NULL );
+    if (err) error_line( path, err ); else ok = TRUE;
+    LocalFree( new_acl );
+    LocalFree( sd );
+    for (i = 0; i < n; i++) if (frees[i]) LocalFree( sids[i] );
+    free( copy );
+    return ok;
+}
+
+static BOOL apply_remove( const WCHAR *path, const struct action *act )
+{
+    BOOL f, ok = FALSE;
+    PSID target = lookup_sid( act->arg, &f );
+    ACL *old = NULL, *new_acl = NULL;
+    PSECURITY_DESCRIPTOR sd = NULL;
+    DWORD err, i;
+    ACL_SIZE_INFORMATION info;
+
+    if (!target)
+    {
+        out( L"%ls: No mapping between account names and security IDs was done.\n", act->arg );
+        return FALSE;
+    }
+    err = GetNamedSecurityInfoW( path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, NULL, NULL, &old, NULL, &sd );
+    if (!err && old)
+    {
+        BYTE *buf = malloc( old->AclSize );
+        ACL *copy = (ACL *)buf;
 
-#include "wine/debug.h"
+        InitializeAcl( copy, old->AclSize, ACL_REVISION );
+        GetAclInformation( old, &info, sizeof(info), AclSizeInformation );
+        for (i = 0; i < info.AceCount; i++)
+        {
+            ACE_HEADER *hdr;
+            ACCESS_ALLOWED_ACE *ace;
+            BOOL drop;
 
-WINE_DEFAULT_DEBUG_CHANNEL(icacls);
+            GetAce( old, i, (void **)&hdr );
+            ace = (ACCESS_ALLOWED_ACE *)hdr;
+            drop = (hdr->AceType == ACCESS_ALLOWED_ACE_TYPE || hdr->AceType == ACCESS_DENIED_ACE_TYPE)
+                    && !(hdr->AceFlags & INHERITED_ACE) && EqualSid( (PSID)&ace->SidStart, target );
+            if (drop && act->type == ACT_REMOVE_G && hdr->AceType != ACCESS_ALLOWED_ACE_TYPE) drop = FALSE;
+            if (drop && act->type == ACT_REMOVE_D && hdr->AceType != ACCESS_DENIED_ACE_TYPE) drop = FALSE;
+            if (!drop && !(hdr->AceFlags & INHERITED_ACE)) AddAce( copy, ACL_REVISION, MAXDWORD, hdr, hdr->AceSize );
+        }
+        err = SetNamedSecurityInfoW( (WCHAR *)path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION | UNPROTECTED_DACL_SECURITY_INFORMATION,
+                                     NULL, NULL, copy, NULL );
+        free( buf );
+    }
+    if (err) error_line( path, err ); else ok = TRUE;
+    LocalFree( sd );
+    if (f) LocalFree( target );
+    (void)new_acl;
+    return ok;
+}
+
+static BOOL apply_reset( const WCHAR *path )
+{
+    BYTE buf[sizeof(ACL)];
+    DWORD err;
+
+    /* no explicit entries, and the parent's entries flow in again */
+    InitializeAcl( (ACL *)buf, sizeof(buf), ACL_REVISION );
+    err = SetNamedSecurityInfoW( (WCHAR *)path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION | UNPROTECTED_DACL_SECURITY_INFORMATION,
+                                 NULL, NULL, (ACL *)buf, NULL );
+    if (err) { error_line( path, err ); return FALSE; }
+    return TRUE;
+}
+
+static BOOL apply_setowner( const WCHAR *path, const WCHAR *name )
+{
+    BOOL f;
+    PSID sid = lookup_sid( name, &f );
+    DWORD err;
+
+    if (!sid)
+    {
+        out( L"%ls: No mapping between account names and security IDs was done.\n", name );
+        return FALSE;
+    }
+    err = SetNamedSecurityInfoW( (WCHAR *)path, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION, sid, NULL, NULL, NULL );
+    if (f) LocalFree( sid );
+    if (err) { error_line( path, err ); return FALSE; }
+    return TRUE;
+}
 
-int __cdecl main(int argc, char** argv)
+static BOOL apply_inheritance( const WCHAR *path, enum action_type type )
 {
+    PSECURITY_DESCRIPTOR sd = NULL;
+    ACL *old = NULL;
+    DWORD err;
+    SECURITY_INFORMATION info = DACL_SECURITY_INFORMATION;
+    ACL_SIZE_INFORMATION size;
+    DWORD i;
+
+    err = GetNamedSecurityInfoW( path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, NULL, NULL, &old, NULL, &sd );
+    if (err) { error_line( path, err ); return FALSE; }
+    if (type == ACT_INHERIT_E)
+    {
+        info |= UNPROTECTED_DACL_SECURITY_INFORMATION;
+        err = SetNamedSecurityInfoW( (WCHAR *)path, SE_FILE_OBJECT, info, NULL, NULL, old, NULL );
+    }
+    else
+    {
+        /* protected: the inherited entries either stay as copies (d) or go (r) */
+        BYTE *buf = malloc( old ? old->AclSize + 8 : 8 );
+        ACL *copy = (ACL *)buf;
+
+        InitializeAcl( copy, old ? old->AclSize + 8 : 8, ACL_REVISION );
+        if (old)
+        {
+            GetAclInformation( old, &size, sizeof(size), AclSizeInformation );
+            for (i = 0; i < size.AceCount; i++)
+            {
+                ACE_HEADER *hdr;
+                GetAce( old, i, (void **)&hdr );
+                if (hdr->AceFlags & INHERITED_ACE)
+                {
+                    if (type == ACT_INHERIT_R) continue;
+                    ((ACE_HEADER *)hdr)->AceFlags &= ~INHERITED_ACE;
+                }
+                AddAce( copy, ACL_REVISION, MAXDWORD, hdr, hdr->AceSize );
+            }
+        }
+        info |= PROTECTED_DACL_SECURITY_INFORMATION;
+        err = SetNamedSecurityInfoW( (WCHAR *)path, SE_FILE_OBJECT, info, NULL, NULL, copy, NULL );
+        free( buf );
+    }
+    LocalFree( sd );
+    if (err) { error_line( path, err ); return FALSE; }
+    return TRUE;
+}
+
+static BOOL apply_findsid( const WCHAR *path, const WCHAR *name )
+{
+    BOOL f, found = FALSE;
+    PSID target = lookup_sid( name, &f );
+    PSECURITY_DESCRIPTOR sd = NULL;
+    ACL *dacl = NULL;
+    ACL_SIZE_INFORMATION info;
+    DWORD i;
+
+    if (!target)
+    {
+        out( L"%ls: No mapping between account names and security IDs was done.\n", name );
+        return FALSE;
+    }
+    if (!GetNamedSecurityInfoW( path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, NULL, NULL, &dacl, NULL, &sd ) && dacl)
+    {
+        GetAclInformation( dacl, &info, sizeof(info), AclSizeInformation );
+        for (i = 0; i < info.AceCount && !found; i++)
+        {
+            ACE_HEADER *hdr;
+            GetAce( dacl, i, (void **)&hdr );
+            if ((hdr->AceType == ACCESS_ALLOWED_ACE_TYPE || hdr->AceType == ACCESS_DENIED_ACE_TYPE)
+                    && EqualSid( (PSID)&((ACCESS_ALLOWED_ACE *)hdr)->SidStart, target ))
+                found = TRUE;
+        }
+    }
+    if (found) out( L"%ls\n", path );
+    LocalFree( sd );
+    if (f) LocalFree( target );
+    return TRUE;
+}
+
+static BOOL apply_save( const WCHAR *path, HANDLE file )
+{
+    PSECURITY_DESCRIPTOR sd = NULL;
+    WCHAR *sddl = NULL;
+    DWORD err, written;
+    WCHAR *line;
+    size_t len;
+
+    err = GetNamedSecurityInfoW( path, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                                 NULL, NULL, NULL, NULL, &sd );
+    if (err) { error_line( path, err ); return FALSE; }
+    if (!ConvertSecurityDescriptorToStringSecurityDescriptorW( sd, SDDL_REVISION_1,
+            OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION, &sddl, NULL ))
+    {
+        LocalFree( sd );
+        return FALSE;
+    }
+    len = wcslen( path ) + wcslen( sddl ) + 8;
+    line = malloc( len * sizeof(WCHAR) );
+    swprintf( line, len, L"%ls\r\n%ls\r\n", path, sddl );
+    WriteFile( file, line, wcslen( line ) * sizeof(WCHAR), &written, NULL );
+    free( line );
+    LocalFree( sddl );
+    LocalFree( sd );
+    return TRUE;
+}
+
+static void process_one( const WCHAR *path, HANDLE save )
+{
+    int i;
+    BOOL ok = TRUE;
+    BOOL displayed = FALSE;
+
+    for (i = 0; i < action_count && (ok || opt_continue); i++)
+    {
+        switch (actions[i].type)
+        {
+        case ACT_GRANT: case ACT_GRANT_R: case ACT_DENY: ok = apply_grant_deny( path, &actions[i] ); break;
+        case ACT_REMOVE: case ACT_REMOVE_G: case ACT_REMOVE_D: ok = apply_remove( path, &actions[i] ); break;
+        case ACT_RESET: ok = apply_reset( path ); break;
+        case ACT_SETOWNER: ok = apply_setowner( path, actions[i].arg ); break;
+        case ACT_INHERIT_E: case ACT_INHERIT_D: case ACT_INHERIT_R: ok = apply_inheritance( path, actions[i].type ); break;
+        case ACT_FINDSID: ok = apply_findsid( path, actions[i].arg ); displayed = TRUE; break;
+        case ACT_SAVE: ok = apply_save( path, save ); displayed = TRUE; break;
+        case ACT_VERIFY: displayed = TRUE; break;
+        default: break;
+        }
+    }
+    if (ok) processed_ok++; else processed_failed++;
+
+    if (!action_count || (ok && !displayed && !opt_quiet))
+    {
+        PSECURITY_DESCRIPTOR sd = NULL;
+        ACL *dacl = NULL;
+        DWORD err = GetNamedSecurityInfoW( path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, NULL, NULL, &dacl, NULL, &sd );
+
+        if (err) { if (!action_count) { error_line( path, err ); processed_ok--; processed_failed++; } }
+        else if (!opt_quiet) print_acl( path, dacl );
+        LocalFree( sd );
+    }
+}
