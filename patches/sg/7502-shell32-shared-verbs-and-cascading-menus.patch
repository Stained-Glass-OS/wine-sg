+/* Stained Glass OS: whether a verb is shown at all: not one Windows keeps out of menus, and not
+ * one limited by an AppliesTo condition (not evaluated here) */
+static BOOL verb_hidden(HKEY shell_key, const WCHAR *verb, BOOL *extended)
+{
+    static const WCHAR *hidden[] = { L"LegacyDisable", L"ProgrammaticAccessOnly", L"AppliesTo" };
+    unsigned int k;
+
+    for (k = 0; k < ARRAY_SIZE(hidden); k++)
+        if (!RegGetValueW(shell_key, verb, hidden[k], RRF_RT_ANY, NULL, NULL, NULL)) return TRUE;
+    *extended = !RegGetValueW(shell_key, verb, L"Extended", RRF_RT_ANY, NULL, NULL, NULL);
+    return FALSE;
+}
+
+static struct verb *add_verb(ContextMenu *menu, const WCHAR *name, WCHAR *desc, const WCHAR *klass)
+{
+    struct verb *verbs = realloc(menu->verbs, (menu->verb_count + 1) * sizeof(*menu->verbs)), *verb;
+
+    if (!verbs || menu->verb_count >= PIN_ID_OFFSET - VERB_ID_OFFSET)
+    {
+        if (verbs) menu->verbs = verbs;
+        free(desc);
+        return NULL;
+    }
+    menu->verbs = verbs;
+    verb = &verbs[menu->verb_count++];
+    memset(verb, 0, sizeof(*verb));
+    verb->verb = wcsdup(name);
+    verb->desc = desc;
+    verb->klass = klass ? wcsdup(klass) : NULL;
+    verb->parent = -1;
+    return verb;
+}
+
+/* a cascade's commands: SubCommands names the CommandStore's verbs, ExtendedSubCommandsKey a
+ * class whose shell key has them */
+static void add_subcommands(ContextMenu *menu, HKEY shell_key, const WCHAR *name, int parent)
+{
+    WCHAR list[2048], sub[MAX_PATH], *p, *next;
+    DWORD size = sizeof(list), i;
+    HKEY key;
+
+    if (!RegGetValueW(shell_key, name, L"SubCommands", RRF_RT_REG_SZ, NULL, list, &size) && list[0] &&
+        !RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\CommandStore\\shell",
+                       0, KEY_READ, &key))
+    {
+        for (p = list; p && *p; p = next)
+        {
+            struct verb *verb;
+            WCHAR *end;
+            HKEY sub_key;
+            BOOL extended;
+
+            if ((next = wcschr(p, ';'))) *next++ = 0;
+            while (*p == ' ') p++;
+            for (end = p + wcslen(p); end > p && end[-1] == ' '; end--) end[-1] = 0;
+            if (!*p || RegOpenKeyExW(key, p, 0, KEY_READ, &sub_key)) continue;
+            RegCloseKey(sub_key);
+            if (verb_hidden(key, p, &extended)) continue;
+            if (!(verb = add_verb(menu, p, get_verb_desc(key, p), NULL))) break;
+            verb->store = TRUE;
+            verb->parent = parent;
+            size = sizeof(verb->flags);
+            RegGetValueW(key, p, L"CommandFlags", RRF_RT_REG_DWORD, NULL, &verb->flags, &size);
+        }
+        RegCloseKey(key);
+        return;
+    }
+    size = sizeof(list);
+    if (!RegGetValueW(shell_key, name, L"ExtendedSubCommandsKey", RRF_RT_REG_SZ, NULL, list, &size) && list[0])
+    {
+        swprintf(sub, ARRAY_SIZE(sub), L"%s\\shell", list);
+        if (RegOpenKeyExW(HKEY_CLASSES_ROOT, sub, 0, KEY_READ, &key)) return;
+        for (i = 0; ; i++)
+        {
+            struct verb *verb;
+            BOOL extended;
+
+            size = ARRAY_SIZE(sub);
+            if (RegEnumKeyExW(key, i, sub, &size, NULL, NULL, NULL, NULL)) break;
+            if (verb_hidden(key, sub, &extended)) continue;
+            if (!(verb = add_verb(menu, sub, get_verb_desc(key, sub), list))) break;
+            verb->parent = parent;
+            size = sizeof(verb->flags);
+            RegGetValueW(key, sub, L"CommandFlags", RRF_RT_REG_DWORD, NULL, &verb->flags, &size);
+        }
+        RegCloseKey(key);
+    }
+}
+
+/* the verbs of one class (the items' type, or one of the classes every such item has); a verb
+ * the menu has already is the earlier class's */
+static void add_class_verbs(ContextMenu *menu, const WCHAR *klass, BOOL own)
+{
+    WCHAR name[256], path[MAX_PATH + 8];
+    HKEY shell_key;
+    DWORD i, size;
+
+    swprintf(path, ARRAY_SIZE(path), L"%s\\shell", klass);
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, path, 0, KEY_READ, &shell_key)) return;
+    for (i = 0; ; i++)
+    {
+        struct verb *verb;
+        BOOL extended = FALSE, cascade, dup = FALSE;
+        size_t k;
+
+        size = ARRAY_SIZE(name);
+        if (RegEnumKeyExW(shell_key, i, name, &size, NULL, NULL, NULL, NULL)) break;
+        for (k = 0; k < menu->verb_count; k++)
+            if (menu->verbs[k].parent < 0 && !menu->verbs[k].store && !wcsicmp(menu->verbs[k].verb, name)) dup = TRUE;
+        if (dup) continue;
+        if (!own && verb_hidden(shell_key, name, &extended)) continue;
+        cascade = !RegGetValueW(shell_key, name, L"SubCommands", RRF_RT_REG_SZ, NULL, NULL, NULL) ||
+                  !RegGetValueW(shell_key, name, L"ExtendedSubCommandsKey", RRF_RT_REG_SZ, NULL, NULL, NULL);
+#ifdef SG_MUTANT_NO_SHARED_VERBS
+        if (!own) continue;
+#endif
+        if (!(verb = add_verb(menu, name, get_verb_desc(shell_key, name), own ? NULL : klass))) break;
+        verb->extended = extended;
+        if (cascade)
+        {
+            int parent = menu->verb_count - 1;
+            size_t before = menu->verb_count;
+#ifndef SG_MUTANT_NO_CASCADE
+            menu->verbs[parent].cascade = TRUE;
+            add_subcommands(menu, shell_key, name, parent);
+#endif
+            /* an empty cascade is not shown */
+            if (menu->verb_count == before)
+            {
+                struct verb *empty = &menu->verbs[--menu->verb_count];
+                free(empty->verb); free(empty->desc); free(empty->klass);
+            }
+        }
+        TRACE("Found verb %s of %s\n", debugstr_w(name), debugstr_w(klass));
+    }
+    RegCloseKey(shell_key);
+}
