From: Stained Glass OS <ke7oxh@gmail.com>
Subject: winex11: another process's surface follows the window's client area

Chromium's GPU process renders into the browser's windows through a client
X window that patch 0586 makes inside the browser's X window. Its place and
size were set once, when it was made. Opera's "Quit Opera?" dialog gains its
frame after that: the surface stayed at the window's corner while Wine took
clicks in the client area 22 pixels lower, so Quit Opera and Cancel could
not be clicked (only Escape closed it).

The surface is now marked (_SG_FOREIGN_CLIENT), and the window's own process
moves and sizes the marked X windows to its client area whenever that
changes (sync_client_position), as it does its own client window.

Gate: make test-xproc-vk ("frame": the window gains a caption after the
other process made its surface; mutant SG_MUTANT_FOREIGN_CLIENT_STAYS).
Checked on qa5: Cancel and Quit Opera work, and maximizing or restoring
Opera's main window still fills it.
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2029,11 +2029,66 @@
  *
  * Synchronize the X client window position with the Windows one
  */
+static Atom foreign_client_atom(void)
+{
+    static Atom atom;
+    if (!atom) atom = XInternAtom( gdi_display, "_SG_FOREIGN_CLIENT", False );
+    return atom;
+}
+
+/* Stained Glass OS: the client windows another process made in this window
+ * (Chromium's GPU process renders into the browser's, create_client_window)
+ * follow its client area. Opera's "Quit Opera?" dialog gains its frame after
+ * the GPU process made its surface: the surface stayed at the window's corner
+ * while clicks went to the client area 22 pixels lower, and its buttons
+ * could not be clicked. */
+static void sync_foreign_client_windows( struct x11drv_win_data *data, const struct window_rects *old_rects )
+{
+    Window root, parent, *children = NULL;
+    unsigned int i, count = 0;
+    XWindowChanges changes;
+
+    if (!data->whole_window) return;
+    changes.x      = data->rects.client.left - data->rects.visible.left;
+    changes.y      = data->rects.client.top - data->rects.visible.top;
+    changes.width  = min( max( 1, data->rects.client.right - data->rects.client.left ), 65535 );
+    changes.height = min( max( 1, data->rects.client.bottom - data->rects.client.top ), 65535 );
+#ifndef SG_MUTANT_FOREIGN_CLIENT_STAYS
+    if (changes.x == old_rects->client.left - old_rects->visible.left &&
+        changes.y == old_rects->client.top - old_rects->visible.top &&
+        changes.width == old_rects->client.right - old_rects->client.left &&
+        changes.height == old_rects->client.bottom - old_rects->client.top) return;
+    if (!XQueryTree( gdi_display, data->whole_window, &root, &parent, &children, &count )) return;
+    for (i = 0; i < count; i++)
+    {
+        Atom type;
+        int format;
+        unsigned long nitems, after;
+        unsigned char *prop = NULL;
+
+        if (children[i] == data->client_window) continue;
+        if (XGetWindowProperty( gdi_display, children[i], foreign_client_atom(), 0, 1, False, XA_CARDINAL,
+                                &type, &format, &nitems, &after, &prop ) == Success && prop)
+        {
+            if (type == XA_CARDINAL)
+            {
+                TRACE( "%p: foreign client window %lx to %d,%d %dx%d\n", data->hwnd, children[i],
+                       changes.x, changes.y, changes.width, changes.height );
+                XConfigureWindow( gdi_display, children[i], CWX | CWY | CWWidth | CWHeight, &changes );
+            }
+            XFree( prop );
+        }
+    }
+    if (children) XFree( children );
+#endif
+}
+
 static void sync_client_position( struct x11drv_win_data *data, const struct window_rects *old_rects )
 {
     int mask = 0;
     XWindowChanges changes;
 
+    sync_foreign_client_windows( data, old_rects );
     if (!data->client_window) return;
 
     changes.x      = data->rects.client.left - data->rects.visible.left;
@@ -2277,7 +2332,14 @@
             ret = XCreateWindow( gdi_display, whole, origin.x - window_rect.left, origin.y - window_rect.top,
                                  cx, cy, 0, default_visual.depth, InputOutput, visual->visual,
                                  CWBitGravity | CWWinGravity | CWBackingStore | CWColormap | CWBorderPixel, &attr );
-            if (ret) XMapWindow( gdi_display, ret );
+            if (ret)
+            {
+                /* marked, so the window's own process keeps it over the client
+                 * area when that moves or changes size (sync_client_position) */
+                XChangeProperty( gdi_display, ret, foreign_client_atom(), XA_CARDINAL, 32,
+                                 PropModeReplace, (unsigned char *)&ret, 1 );
+                XMapWindow( gdi_display, ret );
+            }
             TRACE( "%p: client window %lx in another process's window %lx\n", hwnd, ret, whole );
             return ret;
         }
