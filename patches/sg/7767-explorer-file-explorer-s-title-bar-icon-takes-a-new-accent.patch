From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: File Explorer's title bar icon takes a new accent

File Explorer's window class got its folder icon once, when it was registered: on a new accent
(WM_SETTINGCHANGE "ImmersiveColorSet") the folders in the window took it but the title bar's icon
kept the old one. It is extracted again and set on the class, and the frame repainted.
---
diff --git a/programs/explorer/fileexplorer.c b/programs/explorer/fileexplorer.c
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -5226,7 +5226,27 @@
             /* a new accent: shell32 makes our icons in its lists again (wine-sg 6269), then
              * the views draw them */
             Shell_GetImageLists( &list_large, &list_small );
-            RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
+#ifndef SG_MUTANT_FE_TITLE_ICON_KEPT
+            {
+                /* and the title bar's folder icon, made once when the window class was
+                 * registered: it kept the old accent (David 2026-11-13: "some in the
+                 * explorer upper corner") */
+                HICON ic_big = NULL, ic_small = NULL, old_big, old_small;
+                if (ExtractIconExW( L"shell32.dll", -4, &ic_big, &ic_small, 1 ) && ic_big && ic_small)
+                {
+                    old_big = (HICON)SetClassLongPtrW( hwnd, GCLP_HICON, (LONG_PTR)ic_big );
+                    old_small = (HICON)SetClassLongPtrW( hwnd, GCLP_HICONSM, (LONG_PTR)ic_small );
+                    if (old_big && old_big != ic_big) DestroyIcon( old_big );
+                    if (old_small && old_small != ic_small) DestroyIcon( old_small );
+                }
+                else
+                {
+                    if (ic_big) DestroyIcon( ic_big );
+                    if (ic_small) DestroyIcon( ic_small );
+                }
+            }
+#endif
+            RedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN | RDW_FRAME );
         }
         break;
     case WM_SYSCOLORCHANGE:
