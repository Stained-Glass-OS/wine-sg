+/* _Hard_links: the number of links of a file, -1 on error */
+ULONGLONG __cdecl _Hard_links(WCHAR const* path)
+{
+    BY_HANDLE_FILE_INFORMATION info;
+    HANDLE file;
+    BOOL ret;
+
+    TRACE("(%s)\n", debugstr_w(path));
+
+    file = CreateFileW(path, 0, FILE_SHARE_DELETE | FILE_SHARE_READ | FILE_SHARE_WRITE,
+            NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, 0);
+    if(file == INVALID_HANDLE_VALUE)
+        return ~(ULONGLONG)0;
+    ret = GetFileInformationByHandle(file, &info);
+    CloseHandle(file);
+    if(!ret)
+        return ~(ULONGLONG)0;
+#ifdef SG_MUTANT_HARD_LINKS_ONE
+    return 1;
+#endif
+    return info.nNumberOfLinks;
+}
+
+typedef struct {
+    ULONGLONG capacity;
+    ULONGLONG free;
+    ULONGLONG available;
+} space_info;
+
+/* _Statvfs: the size, free and available space of the volume holding
+ * path; all -1 on error, as the error_code form of std::filesystem::space
+ * reports it */
+space_info* __cdecl _Statvfs(space_info *ret, WCHAR const* path)
+{
+    ULARGE_INTEGER available, total, free;
+
+    TRACE("(%p %s)\n", ret, debugstr_w(path));
+
+    if(!path || !GetDiskFreeSpaceExW(path, &available, &total, &free)) {
+#ifndef SG_MUTANT_STATVFS_ERROR_ZERO
+        ret->capacity = ret->free = ret->available = ~(ULONGLONG)0;
+#else
+        ret->capacity = ret->free = ret->available = 0;
+#endif
+        return ret;
+    }
+    ret->capacity = total.QuadPart;
+    ret->free = free.QuadPart;
+    ret->available = available.QuadPart;
+    return ret;
+}
+
+/* _Chmod: the permissions of the file, which on Windows are its read-only
+ * attribute: read-only when no write permission is given. 0 on success. */
+int __cdecl _Chmod(WCHAR const* path, int perms)
+{
+    DWORD attr;
+
+    TRACE("(%s %#x)\n", debugstr_w(path), perms);
+
+    attr = GetFileAttributesW(path);
+    if(attr == INVALID_FILE_ATTRIBUTES)
+        return -1;
+    if(perms & 0222)
+        attr &= ~FILE_ATTRIBUTE_READONLY;
+    else
+        attr |= FILE_ATTRIBUTE_READONLY;
+    return SetFileAttributesW(path, attr) ? 0 : -1;
+}
+
+/* the documented layouts of the symbolic link and mount point reparse data */
+struct symlink_reparse {
+    ULONG tag;
+    USHORT data_length, reserved;
+    USHORT substitute_offset, substitute_length, print_offset, print_length;
+    ULONG flags;
+    WCHAR path[1];
+};
+
+struct mount_point_reparse {
+    ULONG tag;
+    USHORT data_length, reserved;
+    USHORT substitute_offset, substitute_length, print_offset, print_length;
+    WCHAR path[1];
+};
+
+/* _Symlink_get: the text of the symbolic link path in dst (MAX_PATH
+ * characters), an empty string when it can't be read */
+WCHAR* __cdecl _Symlink_get(WCHAR *dst, WCHAR const* path)
+{
+    union {
+        ULONG tag;
+        struct symlink_reparse link;
+        struct mount_point_reparse mount;
+        char buffer[MAXIMUM_REPARSE_DATA_BUFFER_SIZE];
+    } *rp;
+    HANDLE file;
+    DWORD size;
+    WCHAR *name = NULL;
+    USHORT len = 0;
+
+    TRACE("(%p %s)\n", dst, debugstr_w(path));
+
+    dst[0] = 0;
+    file = CreateFileW(path, 0, FILE_SHARE_DELETE | FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, 0);
+    if(file == INVALID_HANDLE_VALUE)
+        return dst;
+    if(!(rp = malloc(sizeof(*rp)))) {
+        CloseHandle(file);
+        return dst;
+    }
+    if(DeviceIoControl(file, FSCTL_GET_REPARSE_POINT, NULL, 0, rp, sizeof(*rp), &size, NULL)) {
+        if(rp->tag == IO_REPARSE_TAG_SYMLINK) {
+            name = rp->link.path + rp->link.print_offset / sizeof(WCHAR);
+            len = rp->link.print_length / sizeof(WCHAR);
+#ifdef SG_MUTANT_SYMLINK_GET_SUBSTITUTE
+            name = rp->link.path + rp->link.substitute_offset / sizeof(WCHAR);
+            len = rp->link.substitute_length / sizeof(WCHAR);
+#endif
+        }else if(rp->tag == IO_REPARSE_TAG_MOUNT_POINT) {
+            name = rp->mount.path + rp->mount.print_offset / sizeof(WCHAR);
+            len = rp->mount.print_length / sizeof(WCHAR);
+        }
+        if(name && len < MAX_PATH) {
+            memcpy(dst, name, len * sizeof(WCHAR));
+            dst[len] = 0;
+        }
+    }
+    free(rp);
+    CloseHandle(file);
+    return dst;
+}
+
 int __cdecl _Resize(const WCHAR *path, UINT64 size)
 {
     LARGE_INTEGER offset;
