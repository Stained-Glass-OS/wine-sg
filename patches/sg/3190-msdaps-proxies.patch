+/* IID_NULL lives in libuuid, which would clash with the GUIDs this DLL defines itself */
+static const IID null_iid;
+
+/* Strings that the local interfaces point into one buffer (column names, descriptions) travel as the
+ * buffer and an offset in bytes for each pointer (all ones: none). The buffer's length on the wire is
+ * in characters. */
+static DBBYTEOFFSET string_offset(const OLECHAR *base, const OLECHAR *str, ULONG_PTR *end)
+{
+    ULONG_PTR off, stop;
+
+    if(!str || !base) return ~(DBBYTEOFFSET)0;
+    off = (const BYTE *)str - (const BYTE *)base;
+    stop = off + (lstrlenW(str) + 1) * sizeof(OLECHAR);
+    if(stop > *end) *end = stop;
+    return off;
+}
+
+static OLECHAR *string_at(OLECHAR *base, DBBYTEOFFSET off, ULONG chars)
+{
+    if(!base || off == ~(DBBYTEOFFSET)0) return NULL;
+    if(off > chars * sizeof(OLECHAR) || chars * sizeof(OLECHAR) - off < sizeof(OLECHAR)) return NULL;
+    return (OLECHAR *)((BYTE *)base + off);
+}
+
+static BOOL dbid_has_name(const DBID *id)
+{
+    return id->eKind == DBKIND_GUID_NAME || id->eKind == DBKIND_NAME || id->eKind == DBKIND_PGUID_NAME;
+}
+
+static DBCOUNTITEM count_property_infos(ULONG sets, const DBPROPINFOSET *info)
+{
+    DBCOUNTITEM total = 0;
+    ULONG i;
+
+    for(i = 0; i < sets; i++) total += info[i].cPropertyInfos;
+    return total;
+}
+
+static HRESULT property_info_offsets(ULONG sets, const DBPROPINFOSET *info, OLECHAR *desc, DBCOUNTITEM *count,
+                                     DBBYTEOFFSET **offsets, ULONG *chars)
+{
+    ULONG i, j;
+    ULONG_PTR end = 0;
+    DBCOUNTITEM k = 0;
+
+    *count = count_property_infos(sets, info);
+    *offsets = NULL;
+    *chars = 0;
+    if(*count && !(*offsets = CoTaskMemAlloc(*count * sizeof(**offsets)))) return E_OUTOFMEMORY;
+    for(i = 0; i < sets; i++)
+        for(j = 0; j < info[i].cPropertyInfos; j++)
+            (*offsets)[k++] = string_offset(desc, info[i].rgPropertyInfos[j].pwszDescription, &end);
+    *chars = (end + sizeof(OLECHAR) - 1) / sizeof(OLECHAR);
+    return S_OK;
+}
+
+static void property_info_fix(ULONG sets, DBPROPINFOSET *info, OLECHAR *desc, ULONG chars, DBCOUNTITEM count,
+                              const DBBYTEOFFSET *offsets)
+{
+    ULONG i, j;
+    DBCOUNTITEM k = 0;
+
+    for(i = 0; i < sets; i++)
+        for(j = 0; j < info[i].cPropertyInfos; j++)
+        {
+            info[i].rgPropertyInfos[j].pwszDescription = k < count ? string_at(desc, offsets[k], chars) : NULL;
+            k++;
+        }
+}
+
