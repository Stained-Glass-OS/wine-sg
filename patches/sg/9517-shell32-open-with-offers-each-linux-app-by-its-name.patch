From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: Open with offers each Linux app by its name

"How do you want to open this file?" told apps apart by the program their
class starts: every Linux app's class (SG.LinuxApp.<desktop id>, sg-shell's
sg-linuxapp) starts the same launcher, and an .svg Inkscape and GIMP both
open showed one entry, named after the launcher ("Sg-linuxapp64"), with no
icon (linux1's QA VM, 2026-11-27).

A class that says which app it is -- its Application key
(ApplicationName, ApplicationIcon, AppUserModelID), as a packaged app's
class does on Windows -- is an entry of its own, by that name and icon,
one per AppUserModelID; other classes are told apart by their program as
before.

Gate: test/linuxopenwith-gate.sh (mutant SG_MUTANT_OPENWITH_BY_PROGRAM).
---
--- a/dlls/shell32/openwith.c
+++ b/dlls/shell32/openwith.c
@@ -54,6 +54,7 @@
     WCHAR exe[MAX_PATH];
     WCHAR name[128];
     HICON icon;
+    WCHAR app_id[130];        /* Stained Glass OS 9517: the class's Application AppUserModelID, if it names one */
 };
 
 struct row
@@ -173,10 +174,42 @@
 {
     int i;
     for (i = 0; i < ow->count; i++)
-        if (!lstrcmpiW(PathFindFileNameW(ow->apps[i].exe), PathFindFileNameW(exe))) return i;
+        if (!ow->apps[i].app_id[0] && !lstrcmpiW(PathFindFileNameW(ow->apps[i].exe), PathFindFileNameW(exe))) return i;
     return -1;
 }
 
+/* Stained Glass OS 9517: a class that says which app it is -- its
+ * Application key (ApplicationName, ApplicationIcon, AppUserModelID), as a
+ * packaged app's class does on Windows. Linux apps' classes (SG.LinuxApp.*,
+ * sg-shell's sg-linuxapp) all start the same launcher: by its program they
+ * were one entry, named after the launcher ("Sg-linuxapp64") with no icon,
+ * where Inkscape and GIMP should each be offered. */
+static BOOL class_application( const WCHAR *progid, WCHAR *name, DWORD len, HICON *icon, WCHAR *app_id, DWORD id_len )
+{
+    WCHAR key[MAX_PATH + 16], location[MAX_PATH + 8], *comma;
+    DWORD size = len * sizeof(WCHAR);
+    int index = 0;
+
+    swprintf( key, ARRAY_SIZE(key), L"%s\\Application", progid );
+    if (RegGetValueW( HKEY_CLASSES_ROOT, key, L"ApplicationName", RRF_RT_REG_SZ, NULL, name, &size ) || !name[0] ||
+        name[0] == '@')
+        return FALSE;
+    size = id_len * sizeof(WCHAR);
+    if (RegGetValueW( HKEY_CLASSES_ROOT, key, L"AppUserModelID", RRF_RT_REG_SZ, NULL, app_id, &size )) app_id[0] = 0;
+    if (!app_id[0]) lstrcpynW( app_id, progid, id_len );
+    size = sizeof(location);
+    if (RegGetValueW( HKEY_CLASSES_ROOT, key, L"ApplicationIcon", RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, location, &size ))
+    {
+        swprintf( key, ARRAY_SIZE(key), L"%s\\DefaultIcon", progid );
+        size = sizeof(location);
+        if (RegGetValueW( HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ, NULL, location, &size ))
+            location[0] = 0;
+    }
+    if ((comma = wcsrchr( location, ',' ))) { index = wcstol( comma + 1, NULL, 10 ); *comma = 0; }
+    if (location[0]) ExtractIconExW( location, index, icon, NULL, 1 );
+    return TRUE;
+}
+
 static int add_app(struct openwith *ow, const WCHAR *progid)
 {
     struct app *a;
@@ -185,6 +218,23 @@
 
     if (ow->count >= MAX_APPS || !progid[0] || !class_command(progid, exe)) return -1;
     if (!lstrcmpiW(PathFindFileNameW(exe), L"rundll32.exe")) return -1;
+#ifndef SG_MUTANT_OPENWITH_BY_PROGRAM
+    a = &ow->apps[ow->count];
+    memset( a, 0, sizeof(*a) );
+    if (class_application( progid, a->name, ARRAY_SIZE(a->name), &a->icon, a->app_id, ARRAY_SIZE(a->app_id) ))
+    {
+        /* an app of its own: one entry per app (its ID), not per program */
+        for (i = 0; i < ow->count; i++)
+            if (ow->apps[i].app_id[0] && !lstrcmpiW( ow->apps[i].app_id, a->app_id ))
+            {
+                if (a->icon) DestroyIcon( a->icon );
+                return i;
+            }
+        lstrcpynW( a->progid, progid, MAX_PATH );
+        lstrcpynW( a->exe, exe, MAX_PATH );
+        return ow->count++;
+    }
+#endif
     if ((i = find_app(ow, exe)) >= 0) return i;
     a = &ow->apps[ow->count];
     lstrcpynW(a->progid, progid, MAX_PATH);
