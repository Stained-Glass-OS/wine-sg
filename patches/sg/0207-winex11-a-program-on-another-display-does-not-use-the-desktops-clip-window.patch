From: Stained Glass OS <dev@stained-glass.example>
Subject: winex11: a program on another display does not use the desktop's clip window

The cursor clip window is created by the process that owns the desktop, on
its X display, and every other process takes its id from the desktop
window's property. A program on another display that joined the same
desktop -- a test's Xvfb while the desktop's explorer still ran on the
display wineboot was started on -- used an id that is not a window there,
and the X error on its first XUnmapWindow (a cursor clip, or its release
when focus moved) was fatal: "BadWindow (X_UnmapWindow)", the program
gone. The GUI gates hit it whenever a second program opened a window
outside the shell's desktop.

The id is now checked on this thread's display (an override-redirect
InputOnly window, looked up with the error trapped); if it is not there,
the thread makes a clip window of its own, as the desktop's owner does.

--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1090,16 +1090,53 @@
 }
 
 
+static int clip_window_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+/* The desktop's clip window is made by the process that owns the desktop, on
+ * its own X display. Whether it exists on this thread's display, as an
+ * override-redirect InputOnly window: a program on another display may have
+ * joined the desktop (a test's Xvfb while the desktop's explorer still runs on
+ * the display it was started on), and every X error for a window that is not
+ * there is fatal -- the program died on its first cursor clip or release. */
+static BOOL is_clip_window( Display *display, Window window )
+{
+    XWindowAttributes attr;
+    BOOL ret;
+
+    X11DRV_expect_error( display, clip_window_error, NULL );
+    ret = XGetWindowAttributes( display, window, &attr );
+    if (X11DRV_check_error()) ret = FALSE;
+    return ret && attr.class == InputOnly && attr.override_redirect;
+}
+
 /***********************************************************************
  *     init_clip_window
  */
 Window init_clip_window(void)
 {
     struct x11drv_thread_data *data = x11drv_init_thread_data();
+    Window window;
 
     if (!data->clip_window &&
-        (data->clip_window = (Window)NtUserGetProp( NtUserGetDesktopWindow(), clip_window_prop )))
+        (window = (Window)NtUserGetProp( NtUserGetDesktopWindow(), clip_window_prop )))
     {
+        if (is_clip_window( data->display, window )) data->clip_window = window;
+        else
+        {
+            /* not on this display: a clip window of this thread's own, as the
+             * desktop's owner makes one (X11DRV_CreateWindow) */
+            XSetWindowAttributes attr;
+
+            WARN( "desktop clip window %lx is not on this display, using our own\n", window );
+            attr.override_redirect = TRUE;
+            attr.event_mask = StructureNotifyMask | FocusChangeMask;
+            data->clip_window = XCreateWindow( data->display, root_window, 0, 0, 1, 1, 0, 0,
+                                               InputOnly, default_visual.visual,
+                                               CWOverrideRedirect | CWEventMask, &attr );
+        }
         XSelectInput( data->display, data->clip_window, StructureNotifyMask );
     }
     return data->clip_window;
