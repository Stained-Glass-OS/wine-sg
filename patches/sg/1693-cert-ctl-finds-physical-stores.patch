+    strcpy(entry->pOtherName->pszObjId, oid);
+    entry->pOtherName->Value.pbData = (BYTE *)entry->pOtherName->pszObjId + strlen(oid) + 1;
+    entry->pOtherName->Value.cbData = value_len;
+    memcpy(entry->pOtherName->Value.pbData, data + pos, value_len);
+    return TRUE;
