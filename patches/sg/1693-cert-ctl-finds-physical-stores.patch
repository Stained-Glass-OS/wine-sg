+
+static BOOL cert_has_property(PCCERT_CONTEXT cert, DWORD id)
+{
+    DWORD size = 0;
+    return CertGetCertificateContextProperty(cert, id, NULL, &size);
+}
+
+static BOOL compare_cert_by_property(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    return para && cert_has_property(cert, *(const DWORD *)para);
+}
+
+static BOOL compare_cert_by_attr(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    CERT_NAME_BLOB *name = LOWORD(type) == CERT_INFO_ISSUER_FLAG ? &cert->pCertInfo->Issuer : &cert->pCertInfo->Subject;
+
+    if (!para) return FALSE;
+    return CertIsRDNAttrsInCertificateName(cert->dwCertEncodingType,
+            flags & (CERT_UNICODE_IS_RDN_ATTRS_FLAG | CERT_CASE_INSENSITIVE_IS_RDN_ATTRS_FLAG), name, (CERT_RDN *)para);
+}
+
+static BOOL compare_cert_by_key_spec(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    DWORD spec = 0, size = sizeof(spec);
+
+    if (!para) return FALSE;
+    if (!CertGetCertificateContextProperty(cert, CERT_KEY_SPEC_PROP_ID, &spec, &size))
+    {
+        /* else the key's, from its provider information */
+        CRYPT_KEY_PROV_INFO *info;
+
+        size = 0;
+        if (!CertGetCertificateContextProperty(cert, CERT_KEY_PROV_INFO_PROP_ID, NULL, &size) ||
+            !(info = CryptMemAlloc(size)))
+            return FALSE;
+        if (CertGetCertificateContextProperty(cert, CERT_KEY_PROV_INFO_PROP_ID, info, &size)) spec = info->dwKeySpec;
+        CryptMemFree(info);
+        if (!spec) return FALSE;
+    }
+    return spec == *(const DWORD *)para;
+}
+
+static BOOL usage_has(const CERT_ENHKEY_USAGE *usage, const char *oid)
+{
+    DWORD i;
+    for (i = 0; i < usage->cUsageIdentifier; i++)
+        if (!strcmp(usage->rgpszUsageIdentifier[i], oid)) return TRUE;
+    return FALSE;
+}
+
+static BOOL compare_cert_by_enhkey_usage(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    const CERT_ENHKEY_USAGE *want = para;
+    CERT_ENHKEY_USAGE *have;
+    DWORD size = 0, i, found = 0, get_flags;
+    BOOL no_usage, ret;
+
+    get_flags = flags & (CERT_FIND_EXT_ONLY_ENHKEY_USAGE_FLAG | CERT_FIND_PROP_ONLY_ENHKEY_USAGE_FLAG);
+    SetLastError(0);
+    if (!CertGetEnhancedKeyUsage(cert, get_flags, NULL, &size)) return !!(flags & CERT_FIND_NO_ENHKEY_USAGE_FLAG);
+    if (!(have = CryptMemAlloc(size))) return FALSE;
+    if (!CertGetEnhancedKeyUsage(cert, get_flags, have, &size))
+    {
+        CryptMemFree(have);
+        return FALSE;
+    }
+    /* no extension and no property: good for every usage */
+    no_usage = !have->cUsageIdentifier && GetLastError() == CRYPT_E_NOT_FOUND;
+    if (flags & CERT_FIND_NO_ENHKEY_USAGE_FLAG)
+        ret = no_usage;
+    else if (no_usage)
+        ret = !!(flags & CERT_FIND_OPTIONAL_ENHKEY_USAGE_FLAG);
+    else if (!want || !want->cUsageIdentifier)
+        ret = TRUE;
+    else
+    {
+        for (i = 0; i < want->cUsageIdentifier; i++)
+            if (usage_has(have, want->rgpszUsageIdentifier[i])) found++;
+        ret = (flags & CERT_FIND_OR_ENHKEY_USAGE_FLAG) ? found > 0 : found == want->cUsageIdentifier;
+    }
+    CryptMemFree(have);
+    return ret;
+}
+
+static BOOL compare_cert_by_cross_cert_dist_points(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    return CertFindExtension(szOID_CROSS_CERT_DIST_POINTS, cert->pCertInfo->cExtension, cert->pCertInfo->rgExtension) ||
+           cert_has_property(cert, CERT_CROSS_CERT_DIST_POINTS_PROP_ID);
+}
+
+static BOOL compare_cert_by_subject_info_access(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    return !!CertFindExtension(szOID_SUBJECT_INFO_ACCESS, cert->pCertInfo->cExtension, cert->pCertInfo->rgExtension);
+}
+
+static BOOL compare_cert_by_pubkey_md5_hash(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    const CRYPT_HASH_BLOB *want = para;
+    const CRYPT_BIT_BLOB *key = &cert->pCertInfo->SubjectPublicKeyInfo.PublicKey;
+    BYTE hash[16];
+    DWORD size = sizeof(hash);
+
+    if (!want || want->cbData != sizeof(hash)) return FALSE;
+    if (!CryptHashCertificate(0, CALG_MD5, 0, key->pbData, key->cbData, hash, &size)) return FALSE;
+    return !memcmp(hash, want->pbData, sizeof(hash));
+}
+
+static BOOL compare_cert_by_hash_str(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+    const WCHAR *str = para;
+    BYTE want[20], hash[20];
+    DWORD size = sizeof(hash), n = 0;
+    int nibble = -1;
+
+    if (!str) return FALSE;
+    /* the SHA-1 thumbprint in hex, spaces allowed */
+    for (; *str; str++)
+    {
+        int v;
+        if (*str == ' ') continue;
+        if (*str >= '0' && *str <= '9') v = *str - '0';
+        else if (*str >= 'a' && *str <= 'f') v = *str - 'a' + 10;
+        else if (*str >= 'A' && *str <= 'F') v = *str - 'A' + 10;
+        else return FALSE;
+        if (nibble < 0) nibble = v;
+        else
+        {
+            if (n >= sizeof(want)) return FALSE;
+            want[n++] = (nibble << 4) | v;
+            nibble = -1;
+        }
+    }
+    if (n != sizeof(want) || nibble >= 0) return FALSE;
+    if (!CertGetCertificateContextProperty(cert, CERT_SHA1_HASH_PROP_ID, hash, &size)) return FALSE;
+    return !memcmp(hash, want, sizeof(hash));
+}
+
+static BOOL compare_cert_by_private_key(PCCERT_CONTEXT cert, DWORD type, DWORD flags, const void *para)
+{
+#ifdef SG_MUTANT_NO_PRIVATE_KEY_FIND
+    return FALSE;
+#endif
+    return cert_has_property(cert, CERT_KEY_PROV_INFO_PROP_ID) || cert_has_property(cert, CERT_KEY_CONTEXT_PROP_ID) ||
+           cert_has_property(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID) || cert_has_property(cert, CERT_KEY_PROV_HANDLE_PROP_ID);
+}
