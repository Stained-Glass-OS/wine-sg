+/* Stained Glass OS 1693: the remaining find types, as documented */
+#ifndef szOID_SUBJECT_INFO_ACCESS
+#define szOID_SUBJECT_INFO_ACCESS "1.3.6.1.5.5.7.1.11"
+#endif
+#ifndef CERT_COMPARE_SUBJECT_INFO_ACCESS
+#define CERT_COMPARE_SUBJECT_INFO_ACCESS 19
+#endif
