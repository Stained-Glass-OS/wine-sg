+    if (pos + 2 > len || data[pos] != (ASN_CONTEXT | ASN_CONSTRUCTOR | 0)) return FALSE;
+    if (!CRYPT_GetLen(data + pos, len - pos, &value_len)) return FALSE;
+    lb = GET_LEN_BYTES(data[pos + 1]);
+    pos += 1 + lb;
+    if (pos + value_len > len) return FALSE;
