+ * adds the room needed to *size; else fills entry->pOtherName in the
+ * room the entry's data pointer points to. */
+static BOOL decode_other_name(const BYTE *data, DWORD len, CERT_ALT_NAME_ENTRY *entry, DWORD *size)
+{
+    DWORD oid_len, value_len, pos, i, arcs = 0;
+    char oid[256];
+    size_t n = 0;
+    BYTE lb;
