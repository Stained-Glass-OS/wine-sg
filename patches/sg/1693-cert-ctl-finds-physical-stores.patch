+    if (len < 2 || data[0] != ASN_OBJECTIDENTIFIER) return FALSE;
+    if (!CRYPT_GetLen(data, len, &oid_len)) return FALSE;
+    lb = GET_LEN_BYTES(data[1]);
+    pos = 1 + lb;
+    if (pos + oid_len > len || !oid_len) return FALSE;
+    /* the OID as dotted decimal */
+    for (i = 0; i < oid_len; )
+    {
+        ULONGLONG v = 0;
+        do
+        {
+            if (i >= oid_len) return FALSE;
+            v = (v << 7) | (data[pos + i] & 0x7f);
+        } while (data[pos + i++] & 0x80);
+        if (!arcs++)
+        {
+            unsigned int first = v < 40 ? 0 : v < 80 ? 1 : 2;
+            n += snprintf(oid + n, sizeof(oid) - n, "%u.%I64u", first, v - first * 40);
+        }
+        else n += snprintf(oid + n, sizeof(oid) - n, ".%I64u", v);
+        if (n >= sizeof(oid) - 1) return FALSE;
+    }
