+/***********************************************************************
+ *		CertFindSubjectInCTL (CRYPT32.@)
+ *
+ * Stained Glass OS 1693: the CTL entry for a subject, given its identifier
+ * (CTL_ANY_SUBJECT_TYPE) or a certificate (CTL_CERT_SUBJECT_TYPE, its hash
+ * by the CTL's subject algorithm).
+ */
+PCTL_ENTRY WINAPI CertFindSubjectInCTL(DWORD dwEncodingType, DWORD dwSubjectType, void *pvSubject,
+ PCCTL_CONTEXT pCtlContext, DWORD dwFlags)
+{
+    const CTL_INFO *info;
+    BYTE hash[20];
+    CRYPT_DATA_BLOB id;
+    DWORD i, size = sizeof(hash);
+
+    TRACE("(%08lx, %ld, %p, %p, %08lx)\n", dwEncodingType, dwSubjectType, pvSubject, pCtlContext, dwFlags);
+
+    if (!pCtlContext || !pvSubject)
+    {
+        SetLastError(E_INVALIDARG);
+        return NULL;
+    }
+    info = pCtlContext->pCtlInfo;
+    switch (dwSubjectType)
+    {
+    case CTL_ANY_SUBJECT_TYPE:
+    {
+        const CTL_ANY_SUBJECT_INFO *any = pvSubject;
+
+        if (any->SubjectAlgorithm.pszObjId && info->SubjectAlgorithm.pszObjId &&
+            strcmp(any->SubjectAlgorithm.pszObjId, info->SubjectAlgorithm.pszObjId))
+        {
+            SetLastError(CRYPT_E_NOT_FOUND);
+            return NULL;
+        }
+        id = any->SubjectIdentifier;
+        break;
+    }
+    case CTL_CERT_SUBJECT_TYPE:
+    {
+        DWORD prop = CERT_SHA1_HASH_PROP_ID;
+
+        if (info->SubjectAlgorithm.pszObjId && !strcmp(info->SubjectAlgorithm.pszObjId, szOID_RSA_MD5))
+            prop = CERT_MD5_HASH_PROP_ID;
+        if (!CertGetCertificateContextProperty(pvSubject, prop, hash, &size)) return NULL;
+        id.cbData = size;
+        id.pbData = hash;
+        break;
+    }
+    default:
+        SetLastError(E_INVALIDARG);
+        return NULL;
+    }
+    for (i = 0; i < info->cCTLEntry; i++)
+    {
+        if (info->rgCTLEntry[i].SubjectIdentifier.cbData == id.cbData &&
+            !memcmp(info->rgCTLEntry[i].SubjectIdentifier.pbData, id.pbData, id.cbData))
+            return &info->rgCTLEntry[i];
+    }
+    SetLastError(CRYPT_E_NOT_FOUND);
+    return NULL;
+}
+
+/* Stained Glass OS 1693: CTL_FIND_USAGE and CTL_FIND_SUBJECT */
+static BOOL ctl_signer_matches(PCCTL_CONTEXT ctl, const CERT_INFO *signer)
+{
+    DWORD count = 0, size = sizeof(count), i;
+    BOOL ret = FALSE;
+
+    if (!signer) return TRUE;
+    if (!ctl->hCryptMsg) return signer == CTL_FIND_NO_SIGNER_PTR;
+    CryptMsgGetParam(ctl->hCryptMsg, CMSG_SIGNER_COUNT_PARAM, 0, &count, &size);
+    if (signer == CTL_FIND_NO_SIGNER_PTR) return !count;
+    for (i = 0; i < count && !ret; i++)
+    {
+        CERT_INFO *info;
+
+        size = 0;
+        if (!CryptMsgGetParam(ctl->hCryptMsg, CMSG_SIGNER_CERT_INFO_PARAM, i, NULL, &size)) continue;
+        if (!(info = CryptMemAlloc(size))) break;
+        if (CryptMsgGetParam(ctl->hCryptMsg, CMSG_SIGNER_CERT_INFO_PARAM, i, info, &size))
+            ret = CertCompareCertificateName(ctl->dwMsgAndCertEncodingType, &info->Issuer, (CERT_NAME_BLOB *)&signer->Issuer) &&
+                  CertCompareIntegerBlob(&info->SerialNumber, (CRYPT_INTEGER_BLOB *)&signer->SerialNumber);
+        CryptMemFree(info);
+    }
+    return ret;
+}
+
+static BOOL ctl_usage_matches(PCCTL_CONTEXT ctl, DWORD flags, const CTL_FIND_USAGE_PARA *para)
+{
+    const CTL_USAGE *have = &ctl->pCtlInfo->SubjectUsage, *want;
+    DWORD i, j;
+
+    if (!para) return TRUE;
+    want = &para->SubjectUsage;
+    /* every usage asked for is in the list, and with CTL_FIND_SAME_USAGE_FLAG no other */
+    for (i = 0; i < want->cUsageIdentifier; i++)
+    {
+        for (j = 0; j < have->cUsageIdentifier; j++)
+            if (!strcmp(want->rgpszUsageIdentifier[i], have->rgpszUsageIdentifier[j])) break;
+        if (j == have->cUsageIdentifier) return FALSE;
+    }
+    if ((flags & CTL_FIND_SAME_USAGE_FLAG) && have->cUsageIdentifier != want->cUsageIdentifier) return FALSE;
+    if (para->ListIdentifier.cbData != CTL_FIND_NO_LIST_ID_CBDATA)
+    {
+        const CRYPT_DATA_BLOB *list = &ctl->pCtlInfo->ListIdentifier;
+        if (list->cbData != para->ListIdentifier.cbData ||
+            (list->cbData && memcmp(list->pbData, para->ListIdentifier.pbData, list->cbData)))
+            return FALSE;
+    }
+    return ctl_signer_matches(ctl, para->pSigner);
+}
+
+static BOOL compare_ctl_by_usage(PCCTL_CONTEXT ctl, DWORD type, DWORD flags, const void *para)
+{
+#ifdef SG_MUTANT_NO_CTL_USAGE
+    return FALSE;
+#endif
+    return ctl_usage_matches(ctl, flags, para);
+}
+
+static BOOL compare_ctl_by_subject(PCCTL_CONTEXT ctl, DWORD type, DWORD flags, const void *pvPara)
+{
+    const CTL_FIND_SUBJECT_PARA *para = pvPara;
+
+    if (!para) return TRUE;
+    if (para->pUsagePara && !ctl_usage_matches(ctl, flags, para->pUsagePara)) return FALSE;
+    if (!para->pvSubject) return TRUE;
+    return CertFindSubjectInCTL(ctl->dwMsgAndCertEncodingType, para->dwSubjectType, para->pvSubject, ctl, 0) != NULL;
+}
