+/**************************************************************************
+ * Stained Glass OS: the data of an OLE drag over another X program (wine-sg
+ * 7787, sg_dragsrc.c), offered and converted as the clipboard's: a file list
+ * as text/uri-list, text as UTF-8 and Latin-1 strings, HTML, PNG, a DIB.
+ */
+/* CF_HDROP as text/uri-list for a drop (RFC 8089 file URIs): the Unix path with
+ * its symbolic links resolved (C: is dosdevices/c:, a link), '/' and the
+ * unreserved characters as they are -- GLib's g_filename_from_uri refuses an
+ * escaped '/', so the clipboard's every-byte escaping gave GTK programs nothing */
+static BOOL export_sg_uri_list( Display *display, Window win, Atom prop, Atom target, void *data, size_t size )
+{
+    static const char hex[] = "0123456789ABCDEF";
+    DROPFILES *drop = data;
+    const WCHAR *ptr;
+    char *list = NULL, *tmp;
+    size_t len = 0, max = 0;
+
+    if (size < sizeof(*drop) || !drop->fWide || drop->pFiles >= size) return FALSE;
+    for (ptr = (const WCHAR *)((char *)data + drop->pFiles); *ptr; ptr += lstrlenW( ptr ) + 1)
+    {
+        char *unix_name, *real, *path;
+        size_t i, need;
+
+        if (!(unix_name = get_unix_file_name( ptr ))) continue;
+        real = realpath( unix_name, NULL );
+        path = real ? real : unix_name;
+        need = strlen( "file://" ) + 3 * strlen( path ) + 2;
+        if (len + need > max)
+        {
+            max = max * 2 + need;
+            if (!(tmp = realloc( list, max ))) { free( real ); free( unix_name ); free( list ); return FALSE; }
+            list = tmp;
+        }
+        len += sprintf( list + len, "file://" );
+        for (i = 0; path[i]; i++)
+        {
+            unsigned char c = path[i];
+#ifndef SG_MUTANT_DRAG_URI_ESCAPED
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "/-._~", c ))
+#else
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "-._~", c ))
+#endif
+                list[len++] = c;
+            else
+            {
+                list[len++] = '%';
+                list[len++] = hex[c >> 4];
+                list[len++] = hex[c & 15];
+            }
+        }
+        list[len++] = '\r';
+        list[len++] = '\n';
+        free( real );
+        free( unix_name );
+    }
+    if (!len) { free( list ); return FALSE; }
+    put_property( display, win, prop, target, 8, list, len );
+    free( list );
+    return TRUE;
+}
+
+static const struct
+{
+    const WCHAR *name;   /* a registered format's name */
+    UINT         id;     /* or a predefined format */
+    const char  *target;
+    EXPORTFUNC   export;
+} sg_drag_formats[] =
+{
+    { 0, CF_HDROP,              "text/uri-list",            export_sg_uri_list },
+    { 0, CF_UNICODETEXT,        "text/plain;charset=utf-8", export_utf8_string },
+    { 0, CF_UNICODETEXT,        "UTF8_STRING",              export_utf8_string },
+    { 0, CF_UNICODETEXT,        "text/plain",               export_string },
+    { 0, CF_UNICODETEXT,        "STRING",                   export_string },
+    { HTMLFormatW, 0,           "text/html",                export_text_html },
+    { PNGW, 0,                  "image/png",                export_data },
+    { 0, CF_DIB,                "image/bmp",                export_image_bmp },
+};
+
+static UINT sg_drag_format_id( unsigned int i )
+{
+    return sg_drag_formats[i].name ? register_clipboard_format( sg_drag_formats[i].name ) : sg_drag_formats[i].id;
+}
+
+/* the X targets FORMAT is offered as */
+UINT sg_drag_targets( Display *display, UINT format, Atom *atoms, UINT max )
+{
+    unsigned int i, count = 0;
+
+    for (i = 0; i < ARRAY_SIZE(sg_drag_formats) && count < max; i++)
+        if (format && sg_drag_format_id( i ) == format)
+            atoms[count++] = XInternAtom( display, sg_drag_formats[i].target, False );
+    return count;
+}
+
+/* put FORMAT's DATA on WIN's PROP as TARGET */
+BOOL sg_drag_export( Display *display, Window win, Atom prop, Atom target, UINT format,
+                     void *data, size_t size )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(sg_drag_formats); i++)
+    {
+        if (sg_drag_format_id( i ) != format) continue;
+        if (XInternAtom( display, sg_drag_formats[i].target, False ) != target) continue;
+        return sg_drag_formats[i].export( display, win, prop, target, data, size );
+    }
+    return FALSE;
+}
+
+char *sg_drag_unix_file_name( const WCHAR *dos )
+{
+    return get_unix_file_name( dos );
+}
+
+
 /***********************************************************************
  *           X11DRV_HandleSelectionRequest
  */
@@ -2307,6 +2423,8 @@ BOOL X11DRV_SelectionRequest( HWND hwnd, XEvent *xev )
     XEvent result;
     Atom rprop = None;
 
+    if (sg_drag_selection_request( event )) return FALSE;
+
     TRACE( "got request on %lx for selection %s target %s win %lx prop %s\n",
            event->owner, debugstr_xatom( event->selection ), debugstr_xatom( event->target ),
            event->requestor, debugstr_xatom( event->property ));
