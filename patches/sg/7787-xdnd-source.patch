+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <X11/Xatom.h>
+
+#include "x11drv.h"
+#include "shlobj.h"
+#include "wine/sg_drag.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xdnd);
+
+#define EFFECT_COPY 1
+#define EFFECT_MOVE 2
+#define EFFECT_LINK 4
+
+#define MAX_TYPES 32
+
+struct sg_drag
+{
+    Window   src;            /* our window: XdndSelection's owner, the messages' sender */
+    Time     time;           /* X server time when we took XdndSelection */
+    Window   target;         /* the XDND program's window under the pointer, or 0 */
+    Window   proxy;          /* where its messages go (XdndProxy), or the target */
+    int      version;        /* the XDND version we speak with it */
+    BOOL     status_pending; /* an XdndPosition went, its XdndStatus did not come yet */
+    BOOL     queued;         /* a position to send when it comes */
+    int      qx, qy;
+    Atom     qaction;
+    BOOL     sent;           /* the last position sent, answered: not sent again unchanged */
+    int      sx, sy;
+    Atom     saction;
+    BOOL     accepted;       /* the last XdndStatus: takes the drop, with this action */
+    Atom     action;
+    BOOL     drop_requested; /* the source said drop */
+    BOOL     dropped;        /* XdndDrop went */
+    BOOL     done;           /* finished, refused, or the target gone */
+    UINT     result;         /* the effect of the drop */
+    BOOL     delete_asked;   /* the target converted DELETE */
+    UINT     ok_effect;
+    BOOL     have_data;
+    char    *data;           /* sg_drag_format records */
+    size_t   size;
+    Atom     types[MAX_TYPES];
+    UINT     ntypes;
+};
+
+Atom sg_wine_window_atom( Display *display )
+{
+    static Atom atom;
+    if (!atom) atom = XInternAtom( display, "_SG_WINE_WINDOW", False );
+    return atom;
+}
+
+static int ignore_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+static Atom effect_to_action( UINT effect )
+{
+    if (effect & EFFECT_MOVE) return x11drv_atom(XdndActionMove);
+    if (effect & EFFECT_LINK) return x11drv_atom(XdndActionLink);
+    return x11drv_atom(XdndActionCopy);
+}
+
+static UINT action_to_effect( Atom action )
+{
+    if (action == x11drv_atom(XdndActionCopy)) return EFFECT_COPY;
+    if (action == x11drv_atom(XdndActionMove)) return EFFECT_MOVE;
+    if (action == x11drv_atom(XdndActionLink)) return EFFECT_LINK;
+    /* XdndActionPrivate, XdndActionAsk: the program does it its way, the data stays */
+    if (action) return EFFECT_COPY;
+    return 0;
+}
+
+static BOOL get_card32( Display *display, Window win, Atom prop, unsigned long *value )
+{
+    Atom type;
+    int format;
+    unsigned long count, after;
+    unsigned char *buf = NULL;
+    BOOL ret = FALSE;
+
+    if (XGetWindowProperty( display, win, prop, 0, 1, False, AnyPropertyType, &type, &format,
+                            &count, &after, &buf ) == Success && buf)
+    {
+        if (format == 32 && count >= 1)
+        {
+            *value = *(unsigned long *)buf;
+            ret = TRUE;
+        }
+        XFree( buf );
+    }
+    return ret;
+}
+
+/* WIN speaks XDND (version 3 or later), directly or through its XdndProxy */
+static BOOL xdnd_aware( Display *display, Window win, int *version, Window *proxy )
+{
+    unsigned long value, check;
+
+    *proxy = win;
+    if (get_card32( display, win, XInternAtom( display, "XdndProxy", False ), &value ) && value &&
+        get_card32( display, value, XInternAtom( display, "XdndProxy", False ), &check ) && check == value)
+        *proxy = value;
+    if (!get_card32( display, *proxy, x11drv_atom(XdndAware), &value )) return FALSE;
+    if (value < 3) return FALSE;
+    *version = min( value, WINE_XDND_VERSION );
+    return TRUE;
+}
+
+static BOOL is_wine_window( Display *display, Window win )
+{
+    unsigned long value;
+    char *ptr;
+
+    if (win == root_window) return TRUE;  /* the virtual desktop */
+    if (!XFindContext( display, win, winContext, &ptr )) return TRUE;
+    return get_card32( display, win, sg_wine_window_atom( display ), &value );
+}
+
+/* what is under the pointer, from the root down */
+static UINT find_target( Display *display, int *root_x, int *root_y, Window *target,
+                         Window *proxy, int *version )
+{
+    Window root = DefaultRootWindow( display ), win = root, child, ret_root, ret_child;
+    int x, y, win_x, win_y, depth = 0;
+    unsigned int mask;
+    UINT kind = SG_DRAG_TARGET_NONE;
+
+    *target = *proxy = 0;
+    X11DRV_expect_error( display, ignore_error, NULL );
+    if (XQueryPointer( display, root, &ret_root, &ret_child, root_x, root_y, &win_x, &win_y, &mask ))
+    {
+        while (depth++ < 64 && XTranslateCoordinates( display, root, win, *root_x, *root_y, &x, &y, &child ) && child)
+        {
+            win = child;
+            if (is_wine_window( display, win ))
+            {
+                kind = SG_DRAG_TARGET_WINE;
+                continue;
+            }
+            if (xdnd_aware( display, win, version, proxy ))
+            {
+                *target = win;
+                kind = SG_DRAG_TARGET_XDND;
+                break;
+            }
+        }
+    }
+    if (X11DRV_check_error()) kind = SG_DRAG_TARGET_NONE;  /* a window went away: next time */
+    return kind;
+}
+
+static void xdnd_send( Display *display, struct sg_drag *d, Atom type, long l1, long l2, long l3, long l4 )
+{
+    XEvent e;
+
+    memset( &e, 0, sizeof(e) );
+    e.xclient.type = ClientMessage;
+    e.xclient.display = display;
+    e.xclient.window = d->target;
+    e.xclient.message_type = type;
+    e.xclient.format = 32;
+    e.xclient.data.l[0] = d->src;
+    e.xclient.data.l[1] = l1;
+    e.xclient.data.l[2] = l2;
+    e.xclient.data.l[3] = l3;
+    e.xclient.data.l[4] = l4;
+    X11DRV_expect_error( display, ignore_error, NULL );
+    XSendEvent( display, d->proxy, False, NoEventMask, &e );
+    if (X11DRV_check_error()) d->done = TRUE;  /* the program is gone */
+}
+
+static void send_position( Display *display, struct sg_drag *d, int x, int y, Atom action )
+{
+    if (d->status_pending)
+    {
+        d->queued = TRUE;
+        d->qx = x;
+        d->qy = y;
+        d->qaction = action;
+        return;
+    }
+    if (d->sent && d->sx == x && d->sy == y && d->saction == action) return;
+    TRACE( "position %d,%d action %lx to %lx\n", x, y, action, d->target );
+    xdnd_send( display, d, x11drv_atom(XdndPosition), 0, (x << 16) | (y & 0xffff), d->time,
+                  d->version >= 2 ? action : 0 );
+    d->status_pending = TRUE;
+    d->queued = FALSE;
+    d->sent = TRUE;
+    d->sx = x;
+    d->sy = y;
+    d->saction = action;
+}
+
+static void leave_target( Display *display, struct sg_drag *d )
+{
+    if (!d->target) return;
+#ifndef SG_MUTANT_DRAG_NO_LEAVE
+    TRACE( "leave %lx\n", d->target );
+    if (!d->dropped) xdnd_send( display, d, x11drv_atom(XdndLeave), 0, 0, 0, 0 );
+#endif
+    d->target = d->proxy = 0;
+    d->status_pending = d->queued = d->accepted = d->sent = FALSE;
+    d->action = 0;
+}
+
+/* an X server time from now: the PropertyNotify of an empty append to WIN */
+static Time server_time( Display *display, Window win )
+{
+    XEvent event;
+    Atom prop = XInternAtom( display, "_SG_DRAG_TIME", False );
+
+    XChangeProperty( display, win, prop, XA_STRING, 8, PropModeAppend, NULL, 0 );
+    XSync( display, False );
+    if (XCheckTypedWindowEvent( display, win, PropertyNotify, &event )) return event.xproperty.time;
+    return CurrentTime;
+}
+
+static BOOL make_source( Display *display, struct sg_drag *d )
+{
+    XSetWindowAttributes attr;
+
+    if (d->src) return TRUE;
+    attr.override_redirect = True;
+    attr.event_mask = PropertyChangeMask;
+    d->src = XCreateWindow( display, DefaultRootWindow( display ), -100, -100, 1, 1, 0, 0, InputOnly,
+                            CopyFromParent, CWOverrideRedirect | CWEventMask, &attr );
+    if (!d->src) return FALSE;
+    d->time = server_time( display, d->src );
+    XSelectInput( display, d->src, NoEventMask );
+    XSetSelectionOwner( display, x11drv_atom(XdndSelection), d->src, d->time );
+    if (d->ntypes > 3)
+        XChangeProperty( display, d->src, x11drv_atom(XdndTypeList), XA_ATOM, 32, PropModeReplace,
+                         (unsigned char *)d->types, d->ntypes );
+    TRACE( "source window %lx time %lu, %u types\n", d->src, d->time, d->ntypes );
+    return TRUE;
+}
+
+static void enter_target( Display *display, struct sg_drag *d, Window target, Window proxy, int version )
+{
+    d->target = target;
+    d->proxy = proxy;
+    d->version = version;
+    d->status_pending = d->queued = d->accepted = d->sent = FALSE;
+    d->action = 0;
+    TRACE( "enter %lx (proxy %lx) version %d\n", target, proxy, version );
+    xdnd_send( display, d, x11drv_atom(XdndEnter), (version << 24) | (d->ntypes > 3 ? 1 : 0),
+                  d->ntypes > 0 ? d->types[0] : 0, d->ntypes > 1 ? d->types[1] : 0,
+                  d->ntypes > 2 ? d->types[2] : 0 );
+}
+
+/* the records of DATA, with a format of FORMAT */
+static const struct sg_drag_format *next_record( const struct sg_drag *d, size_t *pos )
+{
+    const struct sg_drag_format *rec;
+
+    if (*pos + sizeof(*rec) > d->size) return NULL;
+    rec = (const struct sg_drag_format *)(d->data + *pos);
+    if (rec->size > d->size - *pos - sizeof(*rec)) return NULL;
+    *pos += (sizeof(*rec) + rec->size + 7) & ~7;
+    return rec;
+}
+
+static void set_data( Display *display, struct sg_drag *d, const char *data, size_t size )
+{
+    const struct sg_drag_format *rec;
+    size_t pos = 0;
+    Atom atoms[8];
+    UINT i, j, count;
+
+    free( d->data );
+    d->data = NULL;
+    d->size = d->ntypes = 0;
+    d->have_data = TRUE;
+    if (!size || !(d->data = malloc( size ))) return;
+    memcpy( d->data, data, size );
+    d->size = size;
+    while ((rec = next_record( d, &pos )))
+    {
+        count = sg_drag_targets( display, rec->format, atoms, ARRAY_SIZE(atoms) );
+        for (i = 0; i < count && d->ntypes < MAX_TYPES; i++)
+        {
+            for (j = 0; j < d->ntypes; j++) if (d->types[j] == atoms[i]) break;
+            if (j == d->ntypes) d->types[d->ntypes++] = atoms[i];
+        }
+    }
+}
+
+/* every file of the dropped file list is still where it was */
+static BOOL files_still_there( struct sg_drag *d )
+{
+    const struct sg_drag_format *rec;
+    size_t pos = 0;
+
+    while ((rec = next_record( d, &pos )))
+    {
+        const DROPFILES *drop = (const DROPFILES *)(rec + 1);
+        const WCHAR *name;
+        size_t left;
+        BOOL any = FALSE;
+
+        if (rec->format != CF_HDROP || rec->size < sizeof(*drop) || !drop->fWide) continue;
+        if (drop->pFiles >= rec->size) continue;
+        name = (const WCHAR *)((const char *)drop + drop->pFiles);
+        left = (rec->size - drop->pFiles) / sizeof(WCHAR);
+        while (left && *name)
+        {
+            size_t len = 0;
+            char *unix_name;
+            struct stat st;
+
+            while (len < left && name[len]) len++;
+            if (len == left) break;
+            if ((unix_name = sg_drag_unix_file_name( name )))
+            {
+                BOOL there = !lstat( unix_name, &st );
+                free( unix_name );
+                if (!there) return FALSE;
+                any = TRUE;
+            }
+            name += len + 1;
+            left -= len + 1;
+        }
+        return any;
+    }
+    return FALSE;
+}
+
+static void finish( struct sg_drag *d, BOOL ok, Atom action )
+{
+    UINT effect = ok ? action_to_effect( action ) & d->ok_effect : 0;
+
+#ifndef SG_MUTANT_DRAG_MOVE_UNCHECKED
+    if (effect == EFFECT_MOVE && !d->delete_asked && files_still_there( d ))
+    {
+        TRACE( "a move, but the files are still there: a copy\n" );
+        effect = d->ok_effect & EFFECT_COPY;
+    }
+#endif
+    d->result = effect;
+    d->done = TRUE;
+    TRACE( "finished: ok %d effect %#x\n", ok, effect );
+}
+
+static void do_drop( Display *display, struct sg_drag *d )
+{
+    if (d->accepted && d->action && !d->done)
+    {
+        TRACE( "drop on %lx\n", d->target );
+        xdnd_send( display, d, x11drv_atom(XdndDrop), 0, d->time, 0, 0 );
+        d->dropped = TRUE;
+        if (d->done) d->result = 0;  /* gone before it could take it */
+    }
+    else
+    {
+        leave_target( display, d );
+        d->result = 0;
+        d->done = TRUE;
+    }
+}
+
+BOOL sg_drag_client_message( XClientMessageEvent *event )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct sg_drag *d = data ? data->sg_drag : NULL;
+
+    if (!d || !d->src || event->window != d->src || event->format != 32) return FALSE;
+    if ((Window)event->data.l[0] != d->target) return TRUE;  /* about a target we left */
+
+    if (event->message_type == x11drv_atom(XdndStatus))
+    {
+        d->status_pending = FALSE;
+        d->accepted = event->data.l[1] & 1;
+        d->action = d->accepted ? (d->version >= 2 ? (Atom)event->data.l[4] : x11drv_atom(XdndActionCopy)) : 0;
+        TRACE( "status from %lx: accepted %d action %lx\n", d->target, d->accepted, d->action );
+        if (d->drop_requested && !d->dropped && !d->done) do_drop( event->display, d );
+        else if (d->queued) send_position( event->display, d, d->qx, d->qy, d->qaction );
+        return TRUE;
+    }
+    if (event->message_type == x11drv_atom(XdndFinished))
+    {
+        if (!d->dropped || d->done) return TRUE;
+        if (d->version >= 5) finish( d, event->data.l[1] & 1, event->data.l[2] );
+        else finish( d, TRUE, d->action );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+BOOL sg_drag_selection_request( XSelectionRequestEvent *event )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    struct sg_drag *d = data ? data->sg_drag : NULL;
+    Display *display = event->display;
+    Atom prop = event->property ? event->property : event->target;
+    const struct sg_drag_format *rec;
+    BOOL ok = FALSE;
+    size_t pos = 0;
+    XEvent result;
+
+    if (!d || !d->src || event->owner != d->src || event->selection != x11drv_atom(XdndSelection))
+        return FALSE;
+
+    TRACE( "request for target %lx prop %lx from %lx\n", event->target, prop, event->requestor );
+    X11DRV_expect_error( display, ignore_error, NULL );
+    if (event->target == x11drv_atom(TARGETS))
+    {
+        Atom targets[MAX_TYPES + 2];
+        UINT count = d->ntypes;
+
+        memcpy( targets, d->types, count * sizeof(Atom) );
+        targets[count++] = x11drv_atom(TARGETS);
+        targets[count++] = XInternAtom( display, "DELETE", False );
+        XChangeProperty( display, event->requestor, prop, XA_ATOM, 32, PropModeReplace,
+                         (unsigned char *)targets, count );
+        ok = TRUE;
+    }
+    else if (event->target == XInternAtom( display, "DELETE", False ))
+    {
+        /* the program moved the data and asks the source to delete it */
+        d->delete_asked = TRUE;
+        XChangeProperty( display, event->requestor, prop, XInternAtom( display, "NULL", False ), 32,
+                         PropModeReplace, NULL, 0 );
+        ok = TRUE;
+    }
+    else
+    {
+        while (!ok && (rec = next_record( d, &pos )))
+            ok = sg_drag_export( display, event->requestor, prop, event->target, rec->format,
+                                 (void *)(rec + 1), rec->size );
+    }
+
+    memset( &result, 0, sizeof(result) );
+    result.xselection.type = SelectionNotify;
+    result.xselection.display = display;
+    result.xselection.requestor = event->requestor;
+    result.xselection.selection = event->selection;
+    result.xselection.property = ok ? prop : None;
+    result.xselection.target = event->target;
+    result.xselection.time = event->time;
+    XSendEvent( display, event->requestor, False, NoEventMask, &result );
+    X11DRV_check_error();
+    return TRUE;
+}
+
+static void free_drag( Display *display, struct sg_drag *d )
+{
+    if (d->src)
+    {
+        X11DRV_expect_error( display, ignore_error, NULL );
+        XDestroyWindow( display, d->src );
+        X11DRV_check_error();
+    }
+    free( d->data );
+    free( d );
+}
+
+INT sg_drag_escape( const void *in, INT in_count, void *out, INT out_count )
+{
+    const struct sg_drag_escape *esc = in;
+    struct sg_drag_reply *reply = out;
+    struct x11drv_thread_data *data;
+    struct sg_drag *d;
+    Display *display;
+    Window target, proxy;
+    int x, y, version;
+    UINT kind;
+
+    if (in_count < sizeof(*esc) || out_count < sizeof(*reply)) return 0;
+    if (!(data = x11drv_init_thread_data())) return 0;
+    display = data->display;
+    memset( reply, 0, sizeof(*reply) );
+
+    if (esc->op == SG_DRAG_END)
+    {
+        if ((d = data->sg_drag))
+        {
+            if (!d->done) leave_target( display, d );
+            data->sg_drag = NULL;
+            free_drag( display, d );
+            XFlush( display );
+        }
+        return 1;
+    }
+
+    if (!(d = data->sg_drag))
+    {
+        if (!(d = calloc( 1, sizeof(*d) ))) return 0;
+        data->sg_drag = d;
+    }
+    d->ok_effect = esc->ok_effect;
+
+    switch (esc->op)
+    {
+    case SG_DRAG_DATA:
+        if (esc->size > in_count - sizeof(*esc)) return 0;
+        set_data( display, d, (const char *)(esc + 1), esc->size );
+        reply->target = SG_DRAG_TARGET_XDND;
+        break;
+
+    case SG_DRAG_TRACK:
+        if (d->drop_requested) break;
+        kind = find_target( display, &x, &y, &target, &proxy, &version );
+        if (kind == SG_DRAG_TARGET_XDND && !d->have_data)
+        {
+            reply->target = kind;
+            reply->need_data = 1;
+            break;
+        }
+        if (kind == SG_DRAG_TARGET_XDND && !d->ntypes) kind = SG_DRAG_TARGET_NONE; /* nothing it could take */
+        if (kind != SG_DRAG_TARGET_XDND || target != d->target) leave_target( display, d );
+        reply->target = kind;
+        if (kind != SG_DRAG_TARGET_XDND) break;
+        d->done = FALSE;
+        if (!d->target)
+        {
+            if (!make_source( display, d )) { reply->target = SG_DRAG_TARGET_NONE; break; }
+            enter_target( display, d, target, proxy, version );
+        }
+        send_position( display, d, x, y, effect_to_action( esc->effect ) );
+        if (d->done) leave_target( display, d );  /* it went away */
+        reply->effect = d->accepted ? action_to_effect( d->action ) & d->ok_effect : 0;
+        break;
+
+    case SG_DRAG_DROP:
+        reply->target = d->target ? SG_DRAG_TARGET_XDND : SG_DRAG_TARGET_NONE;
+        if (!d->target) { reply->done = 1; break; }
+        d->drop_requested = TRUE;
+        if (!d->status_pending) do_drop( display, d );
+        reply->done = d->done;
+        reply->effect = d->result;
+        break;
+
+    case SG_DRAG_POLL:
+        reply->target = SG_DRAG_TARGET_XDND;
+        reply->done = d->done;
+        reply->effect = d->result;
+        break;
+
+    default:
+        return 0;
+    }
+    XFlush( display );
+    return 1;
+}
