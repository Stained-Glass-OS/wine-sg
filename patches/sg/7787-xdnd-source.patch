+ */
+
+#ifndef __WINE_SG_DRAG_H
+#define __WINE_SG_DRAG_H
+
+#define SG_DRAG_DRIVER_ESCAPE 6789   /* the X11 driver's private escape (X11DRV_ESCAPE) */
+#define SG_DRAG_ESCAPE_CODE   0x534c /* its code for this (X11DRV_SG_DRAG) */
+
+enum sg_drag_op
+{
+    SG_DRAG_TRACK, /* the pointer moved or a key changed: what is under it now, what it accepts */
+    SG_DRAG_DATA,  /* the data, for an X program: sg_drag_format records follow */
+    SG_DRAG_DROP,  /* the source said drop: drop on the X program under the pointer */
+    SG_DRAG_POLL,  /* has the X program finished taking the drop? */
+    SG_DRAG_END,   /* the drag is over: leave the X program if still over one, forget everything */
+};
+
+enum sg_drag_target
+{
+    SG_DRAG_TARGET_WINE, /* a Wine window, any process: OLE's drop targets */
+    SG_DRAG_TARGET_NONE, /* another program's window that takes no drops */
+    SG_DRAG_TARGET_XDND, /* another program's window that speaks XDND */
+};
+
+struct sg_drag_escape
+{
+    unsigned int code;      /* SG_DRAG_ESCAPE_CODE */
+    unsigned int op;        /* enum sg_drag_op */
+    unsigned int ok_effect; /* DROPEFFECT_* the source allows */
+    unsigned int effect;    /* TRACK: the effect the keys held ask for */
+    unsigned int size;      /* DATA: bytes of records after this header */
+};
+
+/* SG_DRAG_DATA records: each starts on an 8-byte boundary */
+struct sg_drag_format
+{
+    unsigned int format;    /* clipboard format */
+    unsigned int size;      /* bytes of data after this */
+};
+
+struct sg_drag_reply
+{
+    unsigned int target;    /* enum sg_drag_target */
+    unsigned int need_data; /* TRACK: an XDND program is under the pointer, send SG_DRAG_DATA */
+    unsigned int effect;    /* DROPEFFECT_* it accepts; after the drop, what it did */
+    unsigned int done;      /* DROP/POLL: the drop is over (finished, refused or the program gone) */
+};
+
+#endif /* __WINE_SG_DRAG_H */
