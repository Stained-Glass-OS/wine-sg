+/***
+ * Stained Glass OS: a drag over another X program's window (wine-sg 7787)
+ *
+ * Over a Wine window the OLE drop targets answer, as always. Over another
+ * program's window (a Linux program on the same X display) the display
+ * driver is the XDND source for us: it is told where the drag is and what
+ * the keys ask for, gets the data rendered once when the drag first reaches
+ * such a program, and answers with what the program accepts; the drop's
+ * result is DoDragDrop's effect. The IDropSource still decides.
+ */
+static BOOL sg_drag_call( TrackerWindowInfo *info, UINT op, DWORD effect, const void *data, UINT size,
+                          struct sg_drag_reply *reply )
+{
+    struct sg_drag_escape *esc;
+    HDC hdc;
+    int ret = 0;
+
+    memset( reply, 0, sizeof(*reply) );
+    if (info->sg_off) return FALSE;
+    if (!(esc = HeapAlloc( GetProcessHeap(), 0, sizeof(*esc) + size ))) return FALSE;
+    esc->code = SG_DRAG_ESCAPE_CODE;
+    esc->op = op;
+    esc->ok_effect = info->dwOKEffect;
+    esc->effect = effect;
+    esc->size = size;
+    if (size) memcpy( esc + 1, data, size );
+    if ((hdc = GetDC( 0 )))
+    {
+        ret = ExtEscape( hdc, SG_DRAG_DRIVER_ESCAPE, sizeof(*esc) + size, (const char *)esc,
+                         sizeof(*reply), (char *)reply );
+        ReleaseDC( 0, hdc );
+    }
+    HeapFree( GetProcessHeap(), 0, esc );
+    if (ret <= 0)
+    {
+        if (op == SG_DRAG_TRACK) info->sg_off = TRUE;  /* not an X display: OLE only */
+        return FALSE;
+    }
+    info->sg_used = TRUE;
+    return TRUE;
+}
+
+/* the effect the keys held ask for, as a drop target would choose it */
+static DWORD sg_drag_wanted_effect( const TrackerWindowInfo *info )
+{
+    DWORD ok = info->dwOKEffect, keys = info->dwKeyState;
+
+    if (((keys & (MK_CONTROL | MK_SHIFT)) == (MK_CONTROL | MK_SHIFT) || (keys & MK_ALT)) && (ok & DROPEFFECT_LINK))
+        return DROPEFFECT_LINK;
+    if ((keys & (MK_CONTROL | MK_SHIFT)) == MK_SHIFT && (ok & DROPEFFECT_MOVE)) return DROPEFFECT_MOVE;
+    if (ok & DROPEFFECT_COPY) return DROPEFFECT_COPY;
+    if (ok & DROPEFFECT_MOVE) return DROPEFFECT_MOVE;
+    if (ok & DROPEFFECT_LINK) return DROPEFFECT_LINK;
+    return DROPEFFECT_NONE;
+}
+
+static BOOL sg_drag_append( char **buf, UINT *size, UINT format, const void *data, UINT len )
+{
+    struct sg_drag_format *rec;
+    UINT rec_size = (sizeof(*rec) + len + 7) & ~7;
+    char *tmp;
+
+    if (len > 64 * 1024 * 1024 || *size + rec_size < *size) return FALSE;
+    if (!(tmp = *buf ? HeapReAlloc( GetProcessHeap(), 0, *buf, *size + rec_size )
+                     : HeapAlloc( GetProcessHeap(), 0, rec_size ))) return FALSE;
+    *buf = tmp;
+    rec = (struct sg_drag_format *)(tmp + *size);
+    memset( rec, 0, rec_size );
+    rec->format = format;
+    rec->size = len;
+    memcpy( rec + 1, data, len );
+    *size += rec_size;
+    return TRUE;
+}
+
+/* the data, in the formats an X program can be offered */
+static char *sg_drag_render( IDataObject *obj, UINT *ret_size )
+{
+    UINT formats[] = { CF_HDROP, CF_UNICODETEXT, CF_TEXT, RegisterClipboardFormatW( L"HTML Format" ),
+                       RegisterClipboardFormatW( L"PNG" ), CF_DIB };
+    BOOL have_text = FALSE;
+    char *buf = NULL;
+    unsigned int i;
+
+    *ret_size = 0;
+    for (i = 0; i < ARRAY_SIZE(formats); i++)
+    {
+        FORMATETC fe = { formats[i], NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+        STGMEDIUM med;
+        SIZE_T len;
+        void *ptr;
+
+        if (!formats[i] || (formats[i] == CF_TEXT && have_text)) continue;
+        if (IDataObject_GetData( obj, &fe, &med ) != S_OK) continue;
+        if (med.tymed == TYMED_HGLOBAL && (len = GlobalSize( med.hGlobal )) && (ptr = GlobalLock( med.hGlobal )))
+        {
+            if (formats[i] == CF_TEXT)
+            {
+                int count = MultiByteToWideChar( CP_ACP, 0, ptr, len, NULL, 0 );
+                WCHAR *text;
+
+                if (count > 0 && (text = HeapAlloc( GetProcessHeap(), 0, count * sizeof(WCHAR) )))
+                {
+                    MultiByteToWideChar( CP_ACP, 0, ptr, len, text, count );
+                    sg_drag_append( &buf, ret_size, CF_UNICODETEXT, text, count * sizeof(WCHAR) );
+                    HeapFree( GetProcessHeap(), 0, text );
+                }
+            }
+            else if (sg_drag_append( &buf, ret_size, formats[i], ptr, len ) && formats[i] == CF_UNICODETEXT)
+                have_text = TRUE;
+            GlobalUnlock( med.hGlobal );
+        }
+        ReleaseStgMedium( &med );
+    }
+    TRACE( "%u bytes for X programs\n", *ret_size );
+    return buf;
+}
+
+/* TRUE: the pointer is over another program's window, not a Wine one */
+static BOOL sg_drag_track( TrackerWindowInfo *info )
+{
+    struct sg_drag_reply reply;
+    DWORD effect = sg_drag_wanted_effect( info );
+
+#ifdef SG_MUTANT_DRAG_NO_XDND
+    return FALSE;
+#endif
+    if (!sg_drag_call( info, SG_DRAG_TRACK, effect, NULL, 0, &reply )) return info->sg_over = FALSE;
+    if (reply.need_data)
+    {
+        UINT size;
+        char *data = sg_drag_render( info->dataObject, &size );
+        struct sg_drag_reply ignored;
+
+        sg_drag_call( info, SG_DRAG_DATA, effect, data, size, &ignored );
+        HeapFree( GetProcessHeap(), 0, data );
+        if (!sg_drag_call( info, SG_DRAG_TRACK, effect, NULL, 0, &reply )) return info->sg_over = FALSE;
+    }
+    info->sg_over = reply.target != SG_DRAG_TARGET_WINE;
+    info->sg_effect = info->sg_over ? reply.effect : DROPEFFECT_NONE;
+    return info->sg_over;
+}
+
+/* drop on the X program and wait for it to take the data */
+static DWORD sg_drag_drop( TrackerWindowInfo *info )
+{
+    struct sg_drag_reply reply;
+    DWORD start = GetTickCount();
+    BOOL quit = FALSE;
+    WPARAM quit_code = 0;
+    MSG msg;
+
+    if (!sg_drag_call( info, SG_DRAG_DROP, 0, NULL, 0, &reply )) return DROPEFFECT_NONE;
+    while (!reply.done && GetTickCount() - start < 10000)
+    {
+        /* the X events (the program's requests for the data, its answer) come in here */
+        MsgWaitForMultipleObjectsEx( 0, NULL, 50, QS_POSTMESSAGE | QS_SENDMESSAGE | QS_PAINT, 0 );
+        while (PeekMessageW( &msg, 0, 0, 0, PM_REMOVE | PM_QS_POSTMESSAGE | PM_QS_SENDMESSAGE | PM_QS_PAINT ))
+        {
+            if (msg.message == WM_QUIT)
+            {
+                quit = TRUE;
+                quit_code = msg.wParam;
+                continue;
+            }
+            DispatchMessageW( &msg );
+        }
+        if (!sg_drag_call( info, SG_DRAG_POLL, 0, NULL, 0, &reply )) break;
+    }
+    if (quit) PostQuitMessage( quit_code );
+    TRACE( "X drop done %u effect %#x\n", reply.done, reply.effect );
+    return reply.done ? reply.effect : DROPEFFECT_NONE;
+}
+
+static void sg_drag_end( TrackerWindowInfo *info )
+{
+    struct sg_drag_reply reply;
+
+    if (info->sg_used) sg_drag_call( info, SG_DRAG_END, 0, NULL, 0, &reply );
+    info->sg_over = FALSE;
+}
+
 static void drag_end( TrackerWindowInfo *info )
 {
     HRESULT hr;
@@ -2245,6 +2441,8 @@ static void drag_end( TrackerWindowInfo *info )
         IDropTarget_Release( info->curDragTarget );
         info->curDragTarget = NULL;
     }
+    else if (info->sg_over && info->returnValue == DRAGDROP_S_DROP)
+        *info->pdwEffect = sg_drag_drop( info ) & info->dwOKEffect;
     else
         *info->pdwEffect = DROPEFFECT_NONE;
 }
@@ -2256,7 +2454,7 @@ static HRESULT give_feedback( TrackerWindowInfo *info )
     HCURSOR cur;
 
     if (info->curDragTarget == NULL)
-        *info->pdwEffect = DROPEFFECT_NONE;
+        *info->pdwEffect = info->sg_over ? info->sg_effect : DROPEFFECT_NONE;
 
     hr = IDropSource_GiveFeedback( info->dropSource, *info->pdwEffect );
 
@@ -2311,6 +2509,12 @@ static void OLEDD_TrackStateChange(TrackerWindowInfo* trackerInfo)
                                                            trackerInfo->escPressed,
                                                            trackerInfo->dwKeyState);
 
+  /* Stained Glass OS: over another program's window no Wine window is the target,
+   * whatever WindowFromPoint finds under it (wine-sg 7787) */
+  if ((trackerInfo->returnValue == S_OK || trackerInfo->returnValue == DRAGDROP_S_DROP) &&
+      sg_drag_track(trackerInfo))
+    hwndNewTarget = 0;
+
   if (trackerInfo->curTargetHWND != hwndNewTarget &&
       (trackerInfo->returnValue == S_OK ||
        trackerInfo->returnValue == DRAGDROP_S_DROP))
