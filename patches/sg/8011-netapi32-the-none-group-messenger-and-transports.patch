+{
+    TRACE("(%s, %s)\n", debugstr_w(servername), debugstr_w(msgname));
+    if (!msgname) return ERROR_INVALID_PARAMETER;
+    return messenger_check( servername );
+}
+
+/************************************************************
+ *                NetMessageNameDel  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetMessageNameDel(LPCWSTR servername, LPCWSTR msgname)
+{
+    TRACE("(%s, %s)\n", debugstr_w(servername), debugstr_w(msgname));
