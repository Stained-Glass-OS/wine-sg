+    *bufptr = NULL;
+    *entriesread = *totalentries = 0;
+#ifndef SG_MUTANT_NO_NONE_GROUP
+    if (wcsicmp( groupname, sg_none_group )) return NERR_GroupNotFound;
+#else
+    return NERR_GroupNotFound;
+#endif
+
+    count = get_local_accounts( &accounts );
+    if (!count && !accounts) return ERROR_NOT_ENOUGH_MEMORY;
+    fixed = level ? sizeof(GROUP_USERS_INFO_1) : sizeof(GROUP_USERS_INFO_0);
+    start = resume_handle ? min( *resume_handle, count ) : 0;
+    /* as many entries as fit in prefmaxlen, at least one */
+    for (n = 0; start + n < count; n++)
+    {
+        SIZE_T entry = fixed + (wcslen( accounts[start + n].name ) + 1) * sizeof(WCHAR);
+        if (n && prefmaxlen != MAX_PREFERRED_LENGTH && size + entry > prefmaxlen) break;
+        size += entry;
+    }
+    *totalentries = count - start;
+    if (!n)
+    {
+        free_local_accounts( accounts );
+        if (resume_handle) *resume_handle = 0;
+        return NERR_Success;
+    }
+    if ((status = NetApiBufferAllocate( size, (void **)&buf )))
+    {
+        free_local_accounts( accounts );
+        return status;
+    }
+    str = (WCHAR *)(buf + n * fixed);
+    used = 0;
+    for (i = 0; i < n; i++)
+    {
+        WCHAR *name = str;
+        wcscpy( name, accounts[start + i].name );
+        str += wcslen( name ) + 1;
+        if (level)
+        {
+            ((GROUP_USERS_INFO_1 *)buf)[i].grui1_name = name;
+            ((GROUP_USERS_INFO_1 *)buf)[i].grui1_attributes = SG_NONE_GROUP_ATTRIBUTES;
+        }
+        else ((GROUP_USERS_INFO_0 *)buf)[i].grui0_name = name;
+        used++;
+    }
+    free_local_accounts( accounts );
+    *bufptr = buf;
+    *entriesread = used;
+    if (start + n < count)
+    {
+        if (resume_handle) *resume_handle = start + n;
+        return ERROR_MORE_DATA;
+    }
+    if (resume_handle) *resume_handle = 0;
+    return NERR_Success;
 }
 
