+/* Stained Glass OS (wine-sg 8011): the messenger service calls, which Windows has not supported since
+ * Vista (no messenger service): ERROR_NOT_SUPPORTED, as Windows documents, after the argument checks; and
+ * binding the redirector to a transport, documented "Not supported". */
+static NET_API_STATUS messenger_check( LPCWSTR servername )
+{
+    NET_API_STATUS status;
+
+    if ((status = NETAPI_ValidateServername( servername )) != NERR_Success) return status;
+    if (!NETAPI_IsLocalComputer( servername )) return ERROR_BAD_NETPATH;
+    return ERROR_NOT_SUPPORTED;
+}
+
+/************************************************************
+ *                NetMessageBufferSend  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetMessageBufferSend(LPCWSTR servername, LPCWSTR msgname, LPCWSTR fromname, LPBYTE buf, DWORD len)
+{
+    TRACE("(%s, %s, %s, %p, %ld)\n", debugstr_w(servername), debugstr_w(msgname), debugstr_w(fromname), buf, len);
+    if (!msgname || (len && !buf)) return ERROR_INVALID_PARAMETER;
+    return messenger_check( servername );
+}
+
+/************************************************************
+ *                NetMessageNameAdd  (NETAPI32.@)
+ */
