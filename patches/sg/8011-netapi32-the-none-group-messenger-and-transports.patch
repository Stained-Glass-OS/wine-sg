+/* Stained Glass OS (wine-sg 8011): the global groups of a computer that is not a domain controller.
+ * Its account database has one group, "None" (relative id 513, "Ordinary users"), and every account is in
+ * it (NetUserGetGroups says so too). Global groups are created, changed and filled on domain controllers
+ * only: the writes check their arguments and the caller, then say NERR_NotPrimary, as NetGroupAddUser did. */
+static BOOL account_exists( const WCHAR *name );
+#define SG_NONE_GROUP_RID 513  /* DOMAIN_GROUP_RID_USERS */
+#define SG_NONE_GROUP_ATTRIBUTES (SE_GROUP_MANDATORY | SE_GROUP_ENABLED_BY_DEFAULT | SE_GROUP_ENABLED)
+static const WCHAR sg_none_group[] = L"None";
+static const WCHAR sg_none_comment[] = L"Ordinary users";
+
+static NET_API_STATUS group_write_check( LPCWSTR servername )
+{
+    NET_API_STATUS status;
+
+    if ((status = NETAPI_ValidateServername( servername )) != NERR_Success) return status;
+    if (!NETAPI_IsLocalComputer( servername )) return ERROR_BAD_NETPATH;
+    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+    return NERR_NotPrimary;
+}
+
+/* the account domain's SID followed by the "None" group's relative id */
+static PSID none_group_sid( void )
+{
+    LSA_OBJECT_ATTRIBUTES attr = { sizeof(attr) };
+    POLICY_ACCOUNT_DOMAIN_INFO *info = NULL;
+    LSA_HANDLE policy;
+    PSID sid = NULL;
+    DWORD len;
+
+    if (LsaOpenPolicy( NULL, &attr, POLICY_VIEW_LOCAL_INFORMATION, &policy )) return NULL;
+    if (!LsaQueryInformationPolicy( policy, PolicyAccountDomainInformation, (void **)&info ) && info &&
+        info->DomainSid && IsValidSid( info->DomainSid ))
+    {
+        UCHAR count = *GetSidSubAuthorityCount( info->DomainSid );
+        len = GetSidLengthRequired( count + 1 );
+        if ((sid = malloc( len )))
+        {
+            InitializeSid( sid, GetSidIdentifierAuthority( info->DomainSid ), count + 1 );
+            memcpy( GetSidSubAuthority( sid, 0 ), GetSidSubAuthority( info->DomainSid, 0 ), count * sizeof(DWORD) );
+            *GetSidSubAuthority( sid, count ) = SG_NONE_GROUP_RID;
+        }
+    }
+    if (info) LsaFreeMemory( info );
+    LsaClose( policy );
+    return sid;
+}
+
+/* one group entry of level 0, 1, 2 or 3 at ptr (fixed part) with its strings at *strings */
+static void fill_none_group( DWORD level, BYTE *ptr, BYTE **strings, PSID sid )
+{
+    WCHAR *name = (WCHAR *)*strings, *comment = name + ARRAY_SIZE(sg_none_group);
+
+    wcscpy( name, sg_none_group );
+    wcscpy( comment, sg_none_comment );
+    *strings = (BYTE *)(comment + ARRAY_SIZE(sg_none_comment));
+    switch (level)
+    {
+    case 0: ((GROUP_INFO_0 *)ptr)->grpi0_name = name; break;
+    case 1: ((GROUP_INFO_1 *)ptr)->grpi1_name = name; ((GROUP_INFO_1 *)ptr)->grpi1_comment = comment; break;
+    case 2:
+        ((GROUP_INFO_2 *)ptr)->grpi2_name = name;
+        ((GROUP_INFO_2 *)ptr)->grpi2_comment = comment;
+        ((GROUP_INFO_2 *)ptr)->grpi2_group_id = SG_NONE_GROUP_RID;
+        ((GROUP_INFO_2 *)ptr)->grpi2_attributes = SG_NONE_GROUP_ATTRIBUTES;
+        break;
+    case 3:
+        ((GROUP_INFO_3 *)ptr)->grpi3_name = name;
+        ((GROUP_INFO_3 *)ptr)->grpi3_comment = comment;
+        ((GROUP_INFO_3 *)ptr)->grpi3_group_sid = (PSID)*strings;
+        CopySid( GetLengthSid( sid ), *strings, sid );
+        *strings += GetLengthSid( sid );
+        ((GROUP_INFO_3 *)ptr)->grpi3_attributes = SG_NONE_GROUP_ATTRIBUTES;
+        break;
+    }
+}
+
+static SIZE_T group_fixed_size( DWORD level )
+{
+    static const SIZE_T fixed[] = { sizeof(GROUP_INFO_0), sizeof(GROUP_INFO_1), sizeof(GROUP_INFO_2), sizeof(GROUP_INFO_3) };
+    return fixed[level];
+}
+
+static SIZE_T none_group_size( DWORD level, PSID sid )
+{
+    return group_fixed_size( level ) + sizeof(sg_none_group) + sizeof(sg_none_comment) + (level == 3 ? GetLengthSid( sid ) : 0);
+}
+
+/************************************************************
+ *                NetGroupAdd  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetGroupAdd(LPCWSTR servername, DWORD level, LPBYTE buf, LPDWORD parm_err)
+{
+    TRACE("(%s, %ld, %p, %p)\n", debugstr_w(servername), level, buf, parm_err);
+
+    if (level > 3) return ERROR_INVALID_LEVEL;
+    if (!buf || !((GROUP_INFO_0 *)buf)->grpi0_name)
+    {
+        if (parm_err) *parm_err = GROUP_NAME_PARMNUM;
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (!wcsicmp( ((GROUP_INFO_0 *)buf)->grpi0_name, sg_none_group ))
+    {
+        NET_API_STATUS status = group_write_check( servername );
+        return status == NERR_NotPrimary ? NERR_GroupExists : status;
+    }
+    return group_write_check( servername );
+}
+
 /************************************************************
  *                NetGroupAddUser  (NETAPI32.@)
  */
 NET_API_STATUS WINAPI
 NetGroupAddUser(LPCWSTR servername, LPCWSTR groupname, LPCWSTR username)
 {
+    TRACE("(%s, %s, %s)\n", debugstr_w(servername), debugstr_w(groupname), debugstr_w(username));
+    /* global groups belong to a domain controller's directory: this computer is not one */
+    return group_write_check( servername );
+}
+
+/************************************************************
+ *                NetGroupDel  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetGroupDel(LPCWSTR servername, LPCWSTR groupname)
+{
+    NET_API_STATUS status;
+
+    TRACE("(%s, %s)\n", debugstr_w(servername), debugstr_w(groupname));
+
+    if (!groupname) return ERROR_INVALID_PARAMETER;
+    if ((status = group_write_check( servername )) != NERR_NotPrimary) return status;
+    return wcsicmp( groupname, sg_none_group ) ? NERR_GroupNotFound : NERR_NotPrimary;
+}
+
+/************************************************************
+ *                NetGroupDelUser  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetGroupDelUser(LPCWSTR servername, LPCWSTR groupname, LPCWSTR username)
+{
     NET_API_STATUS status;
 
     TRACE("(%s, %s, %s)\n", debugstr_w(servername), debugstr_w(groupname), debugstr_w(username));
-    if ((status = NETAPI_ValidateServername(servername)) != NERR_Success) return status;
-    if (!NETAPI_IsLocalComputer(servername)) return ERROR_BAD_NETPATH;
-    /* global groups belong to a domain controller's directory: this computer is not one */
-    if (!sg_is_administrator()) return ERROR_ACCESS_DENIED;
+
+    if (!groupname || !username) return ERROR_INVALID_PARAMETER;
+    if ((status = group_write_check( servername )) != NERR_NotPrimary) return status;
+    if (wcsicmp( groupname, sg_none_group )) return NERR_GroupNotFound;
+    if (!account_exists( username )) return NERR_UserNotFound;
+    return NERR_NotPrimary;
+}
+
+/************************************************************
+ *                NetGroupSetInfo  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetGroupSetInfo(LPCWSTR servername, LPCWSTR groupname, DWORD level, LPBYTE buf, LPDWORD parm_err)
+{
+    NET_API_STATUS status;
+
+    TRACE("(%s, %s, %ld, %p, %p)\n", debugstr_w(servername), debugstr_w(groupname), level, buf, parm_err);
+
+    if (level > 3 && level != 1002 && level != 1005) return ERROR_INVALID_LEVEL;
+    if (!groupname || !buf) return ERROR_INVALID_PARAMETER;
+    if ((status = group_write_check( servername )) != NERR_NotPrimary) return status;
+    return wcsicmp( groupname, sg_none_group ) ? NERR_GroupNotFound : NERR_NotPrimary;
+}
+
+/************************************************************
+ *                NetGroupSetUsers  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetGroupSetUsers(LPCWSTR servername, LPCWSTR groupname, DWORD level, LPBYTE buf, DWORD count)
+{
+    NET_API_STATUS status;
+
+    TRACE("(%s, %s, %ld, %p, %ld)\n", debugstr_w(servername), debugstr_w(groupname), level, buf, count);
+
+    if (level > 1) return ERROR_INVALID_LEVEL;
+    if (!groupname || (count && !buf)) return ERROR_INVALID_PARAMETER;
+    if ((status = group_write_check( servername )) != NERR_NotPrimary) return status;
+    return wcsicmp( groupname, sg_none_group ) ? NERR_GroupNotFound : NERR_NotPrimary;
+}
+
+/************************************************************
+ *                NetUserSetGroups  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI NetUserSetGroups(LPCWSTR servername, LPCWSTR username, DWORD level, LPBYTE buf, DWORD count)
+{
+    NET_API_STATUS status;
+
+    TRACE("(%s, %s, %ld, %p, %ld)\n", debugstr_w(servername), debugstr_w(username), level, buf, count);
+
+    if (level > 1) return ERROR_INVALID_LEVEL;
+    if (!username || (count && !buf)) return ERROR_INVALID_PARAMETER;
+    if ((status = group_write_check( servername )) != NERR_NotPrimary) return status;
+    if (!account_exists( username )) return NERR_UserNotFound;
     return NERR_NotPrimary;
 }
 
