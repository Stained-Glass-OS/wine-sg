+static void test_group_none(void)
+{
+    GROUP_INFO_2 *g2 = NULL;
+    GROUP_INFO_0 *g0 = NULL;
+    GROUP_USERS_INFO_0 *u0 = NULL;
+    DWORD read, total, i;
+    NET_API_STATUS ret;
+    BOOL found = FALSE;
+
+    /* a computer that is not a domain controller has the one global group "None" */
+    ret = NetGroupEnum(NULL, 0, (BYTE **)&g0, MAX_PREFERRED_LENGTH, &read, &total, NULL);
+    ok(ret == NERR_Success, "NetGroupEnum returned %lu\n", ret);
+    if (ret) return;
+    ok(read == 1 && total == 1, "got %lu/%lu groups\n", read, total);
+    ok(!wcscmp(g0->grpi0_name, L"None"), "got %s\n", wine_dbgstr_w(g0->grpi0_name));
+    NetApiBufferFree(g0);
+
+    ret = NetGroupGetInfo(NULL, L"None", 2, (BYTE **)&g2);
+    ok(ret == NERR_Success, "NetGroupGetInfo returned %lu\n", ret);
+    if (!ret)
+    {
+        ok(g2->grpi2_group_id == DOMAIN_GROUP_RID_USERS, "got id %lu\n", g2->grpi2_group_id);
+        ok(g2->grpi2_attributes == (SE_GROUP_MANDATORY | SE_GROUP_ENABLED_BY_DEFAULT | SE_GROUP_ENABLED),
+           "got attributes %#lx\n", g2->grpi2_attributes);
+        NetApiBufferFree(g2);
+    }
+    ret = NetGroupGetInfo(NULL, L"no such group", 0, (BYTE **)&g0);
+    ok(ret == NERR_GroupNotFound, "NetGroupGetInfo returned %lu\n", ret);
+
+    ret = NetGroupGetUsers(NULL, L"None", 0, (BYTE **)&u0, MAX_PREFERRED_LENGTH, &read, &total, NULL);
+    ok(ret == NERR_Success, "NetGroupGetUsers returned %lu\n", ret);
+    for (i = 0; !ret && i < read; i++) if (!wcsicmp(u0[i].grui0_name, user_name)) found = TRUE;
+    ok(found, "%s is not a member of None\n", wine_dbgstr_w(user_name));
+    if (!ret) NetApiBufferFree(u0);
+
+    ret = NetMessageNameAdd(NULL, L"winetest");
+    ok(ret == ERROR_NOT_SUPPORTED, "NetMessageNameAdd returned %lu\n", ret);
+}
+
