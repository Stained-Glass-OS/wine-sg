+struct resource_loader
+{
+    IResourceLoader IResourceLoader_iface;
+    IResourceLoader2 IResourceLoader2_iface;
+    LONG ref;
+    WCHAR *map;
+};
+
+static inline struct resource_loader *impl_from_IResourceLoader( IResourceLoader *iface )
+{
+    return CONTAINING_RECORD( iface, struct resource_loader, IResourceLoader_iface );
+}
+
+static HRESULT WINAPI loader_QueryInterface( IResourceLoader *iface, REFIID iid, void **out )
+{
+    struct resource_loader *impl = impl_from_IResourceLoader( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IResourceLoader ))
+    {
+        *out = &impl->IResourceLoader_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IResourceLoader2 ))
+    {
+        *out = &impl->IResourceLoader2_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI loader_AddRef( IResourceLoader *iface )
+{
+    struct resource_loader *impl = impl_from_IResourceLoader( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI loader_Release( IResourceLoader *iface )
+{
+    struct resource_loader *impl = impl_from_IResourceLoader( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+    if (!ref)
+    {
+        free( impl->map );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI loader_GetIids( IResourceLoader *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI loader_GetRuntimeClassName( IResourceLoader *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_ApplicationModel_Resources_ResourceLoader,
+                                wcslen( RuntimeClass_Windows_ApplicationModel_Resources_ResourceLoader ), class_name );
+}
+
+static HRESULT WINAPI loader_GetTrustLevel( IResourceLoader *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI loader_GetString( IResourceLoader *iface, HSTRING resource, HSTRING *value )
+{
+    struct resource_loader *impl = impl_from_IResourceLoader( iface );
+
+    TRACE( "iface %p, resource %s, value %p.\n", iface, debugstr_hstring( resource ), value );
+    if (!value) return E_POINTER;
