@@ -0,0 +1,964 @@
+/*
+ * Package Resource Index (PRI) reader
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A PRI file ("mrm_pri2" and relatives) is a header, a table of contents and
+ * a list of sections, each tagged with a 16-byte identifier. The sections a
+ * string lookup needs:
+ *
+ *   [mrm_pridescex]  which sections are schemas, decisions, maps, data
+ *   [mrm_hschema(ex)] the resource tree: scopes (folders) and items (names)
+ *   [mrm_decn_info]  qualifier sets (language, scale, ...) per candidate
+ *   [mrm_res_map2_]  per item, its candidates and where their values live
+ *   [mrm_dataitem]   the values themselves
+ *
+ * The layout follows the format as documented by independent open-source
+ * readers (chausner/PriTools, Apache-2.0); this implementation is written
+ * from that description. Everything read from the file is bounds-checked:
+ * a PRI file comes with an application and is untrusted input.
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef PRI_HOST_TEST
+typedef uint16_t WCHAR;
+#else
+#include "windef.h"
+#endif
+
+#include "pri.h"
+
+enum value_type { VT_STRING, VT_PATH, VT_EMBEDDED, VT_ASCII_STRING, VT_UTF8_STRING, VT_ASCII_PATH, VT_UTF8_PATH };
+enum { QUALIFIER_LANGUAGE = 0 };
+
+struct reader
+{
+    const unsigned char *base;
+    size_t size, pos;
+    int bad;
+};
+
+static void rd_init( struct reader *r, const unsigned char *base, size_t size )
+{
+    r->base = base; r->size = size; r->pos = 0; r->bad = 0;
+}
+
+static const unsigned char *rd_take( struct reader *r, size_t n )
+{
+    const unsigned char *p;
+    if (r->bad || n > r->size - r->pos) { r->bad = 1; return NULL; }
+    p = r->base + r->pos;
+    r->pos += n;
+    return p;
+}
+
+static uint8_t rd_u8( struct reader *r )
+{
+    const unsigned char *p = rd_take( r, 1 );
+    return p ? p[0] : 0;
+}
+
+static uint16_t rd_u16( struct reader *r )
+{
+    const unsigned char *p = rd_take( r, 2 );
+    return p ? (uint16_t)(p[0] | (p[1] << 8)) : 0;
+}
+
+static uint32_t rd_u32( struct reader *r )
+{
+    const unsigned char *p = rd_take( r, 4 );
+    return p ? (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24) : 0;
+}
+
+static void rd_seek( struct reader *r, size_t pos )
+{
+    if (pos > r->size) r->bad = 1;
+    else r->pos = pos;
+}
+
+static void rd_expect_u16( struct reader *r, uint16_t v ) { if (rd_u16( r ) != v) r->bad = 1; }
+static void rd_expect_u32( struct reader *r, uint32_t v ) { if (rd_u32( r ) != v) r->bad = 1; }
+
+struct section
+{
+    char id[16];
+    const unsigned char *content;
+    size_t len;
+};
+
+struct node        /* a scope or an item in the resource tree */
+{
+    WCHAR *name;
+    int parent;    /* scope index, or -1 */
+};
+
+struct schema
+{
+    int section;
+    unsigned int num_scopes, num_items;
+    struct node *scopes, *items;
+};
+
+struct qualifier
+{
+    uint16_t type;
+    uint16_t priority;
+    uint16_t fallback;   /* fallback score, x1000 */
+    WCHAR *value;
+};
+
+struct decision_info
+{
+    int section;
+    unsigned int num_qualifiers, num_sets, num_decisions;
+    struct qualifier *qualifiers;
+    unsigned int *set_first, *set_count;        /* into index_table: qualifiers of a set */
+    unsigned int *dec_first, *dec_count;        /* into index_table: sets of a decision */
+    uint16_t *index_table;
+    unsigned int index_count;
+};
+
+struct candidate
+{
+    uint16_t set;              /* qualifier set index */
+    uint8_t value_type;
+    const unsigned char *data;
+    size_t len;
+};
+
+struct item_candidates
+{
+    unsigned int count;
+    struct candidate *c;
+};
+
+struct data_items
+{
+    int section;
+    unsigned int count;
+    const unsigned char **data;
+    size_t *len;
+};
+
+struct pri_file
+{
+    unsigned char *data;
+    size_t size;
+    unsigned int num_sections;
+    struct section *sections;
+    struct schema schema;
+    struct decision_info decisions;
+    struct item_candidates *map;       /* per item of the schema */
+    unsigned int num_data;
+    struct data_items *data_items;
+};
+
+static WCHAR *wstr_from_utf16( const unsigned char *p, size_t max_chars )
+{
+    size_t n = 0;
+    WCHAR *s;
+    while (n < max_chars && (p[2 * n] | p[2 * n + 1])) n++;
+    if (!(s = malloc( (n + 1) * sizeof(WCHAR) ))) return NULL;
+    for (size_t i = 0; i < n; i++) s[i] = p[2 * i] | (p[2 * i + 1] << 8);
+    s[n] = 0;
+    return s;
+}
+
+static WCHAR *wstr_from_ascii( const unsigned char *p, size_t max_chars )
+{
+    size_t n = 0;
+    WCHAR *s;
+    while (n < max_chars && p[n]) n++;
+    if (!(s = malloc( (n + 1) * sizeof(WCHAR) ))) return NULL;
+    for (size_t i = 0; i < n; i++) s[i] = p[i];
+    s[n] = 0;
+    return s;
+}
+
+static WCHAR *wstr_from_utf8( const unsigned char *p, size_t len )
+{
+    WCHAR *s = malloc( (len + 1) * sizeof(WCHAR) );
+    size_t i = 0, n = 0;
+    if (!s) return NULL;
+    while (i < len && p[i])
+    {
+        uint32_t c = p[i];
+        int extra = c >= 0xf0 ? 3 : c >= 0xe0 ? 2 : c >= 0xc0 ? 1 : 0;
+        if (c >= 0x80 && c < 0xc0) { s[n++] = 0xfffd; i++; continue; }
+        if (extra) c &= 0x3f >> extra;
+        i++;
+        while (extra-- && i < len && (p[i] & 0xc0) == 0x80) c = (c << 6) | (p[i++] & 0x3f);
+        if (c >= 0x10000) { c -= 0x10000; s[n++] = 0xd800 | (c >> 10); s[n++] = 0xdc00 | (c & 0x3ff); }
+        else s[n++] = c;
+    }
+    s[n] = 0;
+    return s;
+}
+
+static WCHAR lower( WCHAR c )
+{
+    return (c >= 'A' && c <= 'Z') ? c + 32 : c;
+}
+
+static const struct section *find_section( const struct pri_file *pri, unsigned int index, const char *id )
+{
+    if (index >= pri->num_sections) return NULL;
+    if (id && memcmp( pri->sections[index].id, id, 16 )) return NULL;
+    return &pri->sections[index];
+}
+
+/* ---- [mrm_hschema] / [mrm_hschemaex] ----------------------------------- */
+
+static int parse_schema( struct pri_file *pri, unsigned int index )
+{
+    const struct section *sec = &pri->sections[index];
+    int extended = !memcmp( sec->id, "[mrm_hschemaex] ", 16 );
+    struct schema *sc = &pri->schema;
+    struct reader r;
+    uint16_t unique_len, name_len;
+    uint32_t num_scopes, num_items, unicode_len, ascii_len = 0;
+    size_t hnames_start, unicode_off, ascii_off;
+    int ascii_names = 0;
+    struct { uint16_t parent, full_len; uint8_t flags; uint32_t name_off; uint16_t index; } *info;
+    unsigned int i, total;
+
+    rd_init( &r, sec->content, sec->len );
+    if (!sec->len) return 1;   /* an empty schema */
+    rd_expect_u16( &r, 1 );
+    unique_len = rd_u16( &r );
+    name_len = rd_u16( &r );
+    rd_expect_u16( &r, 0 );
+    if (extended)
+    {
+        const unsigned char *tag = rd_take( &r, 16 );
+        if (tag && !memcmp( tag, "[def_hnamesx]  \0", 16 )) ascii_names = 1;
+        else if (!tag || memcmp( tag, "[def_hnames]   \0", 16 )) return 0;
+    }
+    rd_u16( &r ); rd_u16( &r );          /* version */
+    rd_expect_u32( &r, 0 );
+    rd_u32( &r );                        /* checksum */
+    num_scopes = rd_u32( &r );
+    num_items = rd_u32( &r );
+    rd_take( &r, unique_len * 2 );
+    rd_take( &r, name_len * 2 );
+    rd_expect_u16( &r, 0 );
+    hnames_start = r.pos;
+    rd_u16( &r );                        /* longest full path */
+    rd_expect_u16( &r, 0 );
+    rd_expect_u32( &r, num_scopes + num_items );
+    rd_expect_u32( &r, num_scopes );
+    rd_expect_u32( &r, num_items );
+    unicode_len = rd_u32( &r );
+    rd_u32( &r );                        /* total hnames length */
+    if (ascii_names) ascii_len = rd_u32( &r );
+    if (r.bad || num_scopes > 0xffff || num_items > 0xffff) return 0;
+    (void)hnames_start;
+
+    total = num_scopes + num_items;
+    if (!(info = calloc( total ? total : 1, sizeof(*info) ))) return 0;
+    for (i = 0; i < total; i++)
+    {
+        uint8_t name_chars;
+        info[i].parent = rd_u16( &r );
+        info[i].full_len = rd_u16( &r );
+        rd_u16( &r );                    /* first character, upper-cased */
+        name_chars = rd_u8( &r );
+        info[i].flags = rd_u8( &r );
+        info[i].name_off = rd_u16( &r ) | ((uint32_t)(info[i].flags & 0xf) << 16);
+        info[i].index = rd_u16( &r );
+        (void)name_chars;
+    }
+    rd_take( &r, (size_t)num_scopes * 8 );          /* scope child lists */
+    rd_take( &r, (size_t)num_items * 2 );           /* item order */
+    unicode_off = r.pos;
+    rd_take( &r, (size_t)unicode_len * 2 );
+    ascii_off = r.pos;
+    rd_take( &r, ascii_len );
+    if (r.bad) { free( info ); return 0; }
+
+    sc->section = index;
+    sc->num_scopes = num_scopes;
+    sc->num_items = num_items;
+    sc->scopes = calloc( num_scopes ? num_scopes : 1, sizeof(struct node) );
+    sc->items = calloc( num_items ? num_items : 1, sizeof(struct node) );
+    if (!sc->scopes || !sc->items) { free( info ); return 0; }
+
+    for (i = 0; i < total; i++)
+    {
+        int is_scope = info[i].flags & 0x10, in_ascii = info[i].flags & 0x20;
+        struct node *n;
+        WCHAR *name;
+        size_t off;
+
+        if (is_scope ? info[i].index >= num_scopes : info[i].index >= num_items) { free( info ); return 0; }
+        n = is_scope ? &sc->scopes[info[i].index] : &sc->items[info[i].index];
+        if (n->name) { free( info ); return 0; }   /* each index exactly once */
+        if (!info[i].full_len)
+            name = wstr_from_ascii( (const unsigned char *)"", 1 );
+        else if (in_ascii)
+        {
+            off = ascii_off + info[i].name_off;
+            if (info[i].name_off >= ascii_len) { free( info ); return 0; }
+            name = wstr_from_ascii( sec->content + off, ascii_len - info[i].name_off );
+        }
+        else
+        {
+            if (info[i].name_off >= unicode_len) { free( info ); return 0; }
+            off = unicode_off + (size_t)info[i].name_off * 2;
+            name = wstr_from_utf16( sec->content + off, unicode_len - info[i].name_off );
+        }
+        if (!name) { free( info ); return 0; }
+        n->name = name;
+        n->parent = -1;
+    }
+    for (i = 0; i < total; i++)
+    {
+        unsigned int parent_node = info[i].parent, parent;
+        int is_scope = info[i].flags & 0x10;
+        if (parent_node >= total || !(info[parent_node].flags & 0x10)) continue;
+        parent = info[parent_node].index;
+        if (is_scope)
+        {
+            if (parent != info[i].index) sc->scopes[info[i].index].parent = parent;
+        }
+        else sc->items[info[i].index].parent = parent;
+    }
+    /* A scope chain must end: refuse a cycle rather than loop on it. */
+    for (i = 0; i < num_scopes; i++)
+    {
+        int p = sc->scopes[i].parent;
+        unsigned int steps = 0;
+        while (p >= 0 && steps++ <= num_scopes) p = sc->scopes[p].parent;
+        if (p >= 0) { free( info ); return 0; }
+    }
+    free( info );
+    return 1;
+}
+
+/* ---- [mrm_decn_info] ----------------------------------------------------- */
+
+static int parse_decisions( struct pri_file *pri, unsigned int index )
+{
+    const struct section *sec = &pri->sections[index];
+    struct decision_info *di = &pri->decisions;
+    struct reader r;
+    uint16_t num_distinct, num_qualifiers, num_sets, num_decisions, num_index, data_len;
+    struct { uint16_t type; uint32_t value_off; } *distinct;
+    uint16_t *q_distinct;
+    size_t data_start;
+    unsigned int i;
+
+    rd_init( &r, sec->content, sec->len );
+    num_distinct = rd_u16( &r );
+    num_qualifiers = rd_u16( &r );
+    num_sets = rd_u16( &r );
+    num_decisions = rd_u16( &r );
+    num_index = rd_u16( &r );
+    data_len = rd_u16( &r );
+    if (r.bad) return 0;
+
+    di->section = index;
+    di->num_qualifiers = num_qualifiers;
+    di->num_sets = num_sets;
+    di->num_decisions = num_decisions;
+    di->index_count = num_index;
+    di->qualifiers = calloc( num_qualifiers + 1, sizeof(*di->qualifiers) );
+    di->set_first = calloc( num_sets + 1, sizeof(unsigned int) );
+    di->set_count = calloc( num_sets + 1, sizeof(unsigned int) );
+    di->dec_first = calloc( num_decisions + 1, sizeof(unsigned int) );
+    di->dec_count = calloc( num_decisions + 1, sizeof(unsigned int) );
+    di->index_table = calloc( num_index + 1, sizeof(uint16_t) );
+    distinct = calloc( num_distinct + 1, sizeof(*distinct) );
+    q_distinct = calloc( num_qualifiers + 1, sizeof(uint16_t) );
+    if (!di->qualifiers || !di->set_first || !di->set_count || !di->dec_first || !di->dec_count ||
+        !di->index_table || !distinct || !q_distinct)
+        goto fail;
+
+    for (i = 0; i < num_decisions; i++)
+    {
+        di->dec_first[i] = rd_u16( &r );
+        di->dec_count[i] = rd_u16( &r );
+    }
+    for (i = 0; i < num_sets; i++)
+    {
+        di->set_first[i] = rd_u16( &r );
+        di->set_count[i] = rd_u16( &r );
+    }
+    for (i = 0; i < num_qualifiers; i++)
+    {
+        q_distinct[i] = rd_u16( &r );
+        di->qualifiers[i].priority = rd_u16( &r );
+        di->qualifiers[i].fallback = rd_u16( &r );
+        rd_expect_u16( &r, 0 );
+    }
+    for (i = 0; i < num_distinct; i++)
+    {
+        rd_u16( &r );                    /* attribute atom */
+        distinct[i].type = rd_u16( &r );
+        rd_u16( &r );                    /* condition operator */
+        rd_u16( &r );                    /* value type */
+        distinct[i].value_off = rd_u32( &r );
+    }
+    for (i = 0; i < num_index; i++) di->index_table[i] = rd_u16( &r );
+    if (r.bad) goto fail;
+    data_start = r.pos;
+    if ((size_t)data_len * 2 > sec->len - data_start) goto fail;
+
+    for (i = 0; i < num_qualifiers; i++)
+    {
+        uint32_t off;
+        if (q_distinct[i] >= num_distinct) goto fail;
+        off = distinct[q_distinct[i]].value_off;
+        if (off >= data_len) goto fail;
+        di->qualifiers[i].type = distinct[q_distinct[i]].type;
+        if (!(di->qualifiers[i].value = wstr_from_utf16( sec->content + data_start + (size_t)off * 2, data_len - off )))
+            goto fail;
+    }
+    for (i = 0; i < num_sets; i++)
+        if (di->set_first[i] + di->set_count[i] > num_index) goto fail;
+    for (i = 0; i < num_decisions; i++)
+        if (di->dec_first[i] + di->dec_count[i] > num_index) goto fail;
+    /* index_table entries are checked where used: they index qualifiers or sets */
+    free( distinct );
+    free( q_distinct );
+    return 1;
+
+fail:
+    free( distinct );
+    free( q_distinct );
+    return 0;
+}
+
+/* ---- [mrm_dataitem] ------------------------------------------------------ */
+
+static int parse_data_items( struct data_items *d, const struct section *sec, int index )
+{
+    struct reader r;
+    uint16_t num_strings, num_blobs;
+    uint32_t total;
+    size_t data_start;
+    unsigned int i;
+
+    rd_init( &r, sec->content, sec->len );
+    rd_expect_u32( &r, 0 );
+    num_strings = rd_u16( &r );
+    num_blobs = rd_u16( &r );
+    total = rd_u32( &r );
+    if (r.bad) return 0;
+    data_start = r.pos + (size_t)num_strings * 4 + (size_t)num_blobs * 8;
+    if (data_start > sec->len || total > sec->len - data_start) return 0;
+
+    d->section = index;
+    d->count = num_strings + num_blobs;
+    d->data = calloc( d->count + 1, sizeof(*d->data) );
+    d->len = calloc( d->count + 1, sizeof(*d->len) );
+    if (!d->data || !d->len) return 0;
+    for (i = 0; i < d->count; i++)
+    {
+        uint32_t off, len;
+        if (i < num_strings) { off = rd_u16( &r ); len = rd_u16( &r ); }
+        else { off = rd_u32( &r ); len = rd_u32( &r ); }
+        if (r.bad || off > total || len > total - off) return 0;
+        d->data[i] = sec->content + data_start + off;
+        d->len[i] = len;
+    }
+    return 1;
+}
+
+static const struct data_items *find_data_items( const struct pri_file *pri, unsigned int section )
+{
+    for (unsigned int i = 0; i < pri->num_data; i++)
+        if (pri->data_items[i].section == (int)section) return &pri->data_items[i];
+    return NULL;
+}
+
+/* ---- [mrm_res_map2_] / [mrm_res_map__] ----------------------------------- */
+
+struct cand_info
+{
+    uint8_t kind, value_type;
+    uint16_t a;
+    uint32_t b;
+    uint16_t c;
+};
+
+static int parse_resource_map( struct pri_file *pri, unsigned int index )
+{
+    const struct section *sec = &pri->sections[index];
+    int v2 = !memcmp( sec->id, "[mrm_res_map2_]\0", 16 );
+    const struct decision_info *di = &pri->decisions;
+    struct reader r, lr;
+    uint16_t env_len, num_env, schema_sec, schema_ref_len, decn_sec, type_count;
+    uint32_t i2g_count, group_count, info_count, num_candidates, data_len, large_len;
+    uint32_t *type_table = NULL;
+    struct { uint32_t first_item, group; } *i2g = NULL;
+    struct { uint32_t size, first_info; } *groups = NULL;
+    struct { uint32_t decision, first_candidate; } *infos = NULL;
+    struct cand_info *cands = NULL;
+    const unsigned char *large;
+    size_t strings_start;
+    unsigned int i, total_i2g, total_groups, total_infos;
+    int ok = 0;
+
+    rd_init( &r, sec->content, sec->len );
+    env_len = rd_u16( &r );
+    num_env = rd_u16( &r );
+    if (v2 && (env_len || num_env)) return 0;
+    schema_sec = rd_u16( &r );
+    schema_ref_len = rd_u16( &r );
+    decn_sec = rd_u16( &r );
+    type_count = rd_u16( &r );
+    i2g_count = rd_u16( &r );
+    group_count = rd_u16( &r );
+    info_count = rd_u32( &r );
+    num_candidates = rd_u32( &r );
+    data_len = rd_u32( &r );
+    large_len = rd_u32( &r );
+    if (r.bad) return 0;
+    /* Only the map over the schema and decisions we loaded is useful. */
+    if (schema_sec != pri->schema.section || decn_sec != di->section) return 1;
+
+    rd_take( &r, env_len );
+    rd_take( &r, schema_ref_len );
+    if (!(type_table = calloc( type_count + 1, sizeof(uint32_t) ))) return 0;
+    for (i = 0; i < type_count; i++)
+    {
+        rd_expect_u32( &r, 4 );
+        type_table[i] = rd_u32( &r );
+    }
+
+    /* The small tables, then the optional "large" tables with 32-bit entries
+     * that continue them. */
+    large = NULL;
+    {
+        size_t small_end = r.pos + (size_t)i2g_count * 4 + (size_t)group_count * 4 + (size_t)info_count * 4;
+        uint32_t l_i2g = 0, l_groups = 0, l_infos = 0;
+        if (small_end > sec->len || large_len > sec->len - small_end) goto done;
+        if (large_len)
+        {
+            rd_init( &lr, sec->content + small_end, large_len );
+            l_i2g = rd_u32( &lr );
+            l_groups = rd_u32( &lr );
+            l_infos = rd_u32( &lr );
+            if (lr.bad || (uint64_t)l_i2g * 8 + (uint64_t)l_groups * 8 + (uint64_t)l_infos * 8 + 12 != large_len) goto done;
+            large = sec->content + small_end;
+        }
+        total_i2g = i2g_count + l_i2g;
+        total_groups = group_count + l_groups;
+        total_infos = info_count + l_infos;
+    }
+    i2g = calloc( total_i2g + 1, sizeof(*i2g) );
+    groups = calloc( total_groups + 1, sizeof(*groups) );
+    infos = calloc( total_infos + 1, sizeof(*infos) );
+    if (!i2g || !groups || !infos) goto done;
+    for (i = 0; i < i2g_count; i++) { i2g[i].first_item = rd_u16( &r ); i2g[i].group = rd_u16( &r ); }
+    for (i = 0; i < group_count; i++) { groups[i].size = rd_u16( &r ); groups[i].first_info = rd_u16( &r ); }
+    for (i = 0; i < info_count; i++) { infos[i].decision = rd_u16( &r ); infos[i].first_candidate = rd_u16( &r ); }
+    if (large)
+    {
+        rd_take( &r, large_len );
+        lr.pos = 12;
+        for (i = i2g_count; i < total_i2g; i++) { i2g[i].first_item = rd_u32( &lr ); i2g[i].group = rd_u32( &lr ); }
+        for (i = group_count; i < total_groups; i++) { groups[i].size = rd_u32( &lr ); groups[i].first_info = rd_u32( &lr ); }
+        for (i = info_count; i < total_infos; i++) { infos[i].decision = rd_u32( &lr ); infos[i].first_candidate = rd_u32( &lr ); }
+        if (lr.bad) goto done;
+    }
+
+    if (!(cands = calloc( num_candidates + 1, sizeof(*cands) ))) goto done;
+    for (i = 0; i < num_candidates; i++)
+    {
+        uint8_t type_index;
+        cands[i].kind = rd_u8( &r );
+        type_index = rd_u8( &r );
+        if (type_index >= type_count) goto done;
+        cands[i].value_type = (uint8_t)type_table[type_index];
+        if (cands[i].kind == 1)
+        {
+            cands[i].a = rd_u16( &r );      /* source file */
+            cands[i].b = rd_u16( &r );      /* data item index */
+            cands[i].c = rd_u16( &r );      /* data item section */
+        }
+        else if (cands[i].kind == 0)
+        {
+            cands[i].a = rd_u16( &r );      /* length */
+            cands[i].b = rd_u32( &r );      /* offset into the string data */
+        }
+        else goto done;
+    }
+    if (r.bad) goto done;
+    strings_start = r.pos;
+    if (data_len > sec->len - strings_start) goto done;
+
+    if (!(pri->map = calloc( pri->schema.num_items + 1, sizeof(*pri->map) ))) goto done;
+    for (i = 0; i < total_i2g; i++)
+    {
+        uint32_t size, first_info;
+        if (i2g[i].group < total_groups) { size = groups[i2g[i].group].size; first_info = groups[i2g[i].group].first_info; }
+        else { size = 1; first_info = i2g[i].group - total_groups; }
+        for (uint32_t k = 0; k < size; k++)
+        {
+            uint32_t info = first_info + k, item = i2g[i].first_item + k, dec, nsets;
+            struct item_candidates *ic;
+            if (info >= total_infos || item >= pri->schema.num_items) goto done;
+            dec = infos[info].decision;
+            if (dec >= di->num_decisions) goto done;
+            nsets = di->dec_count[dec];
+            if (infos[info].first_candidate + (uint64_t)nsets > num_candidates) goto done;
+            ic = &pri->map[item];
+            free( ic->c );
+            if (!(ic->c = calloc( nsets + 1, sizeof(*ic->c) ))) goto done;
+            ic->count = nsets;
+            for (uint32_t j = 0; j < nsets; j++)
+            {
+                const struct cand_info *cd = &cands[infos[info].first_candidate + j];
+                struct candidate *c = &ic->c[j];
+                uint16_t set = di->index_table[di->dec_first[dec] + j];
+                if (set >= di->num_sets) goto done;
+                c->set = set;
+                c->value_type = cd->value_type;
+                if (cd->kind == 0)
+                {
+                    if (cd->b > data_len || cd->a > data_len - cd->b) goto done;
+                    c->data = sec->content + strings_start + cd->b;
+                    c->len = cd->a;
+                }
+                else
+                {
+                    const struct data_items *d = find_data_items( pri, cd->c );
+                    if (!d || cd->b >= d->count) goto done;
+                    c->data = d->data[cd->b];
+                    c->len = d->len[cd->b];
+                }
+            }
+        }
+    }
+    ok = 1;
+
+done:
+    free( type_table ); free( i2g ); free( groups ); free( infos ); free( cands );
+    return ok;
+}
+
+/* ---- the file ------------------------------------------------------------ */
+
+void pri_free( struct pri_file *pri )
+{
+    unsigned int i;
+    if (!pri) return;
+    for (i = 0; i < pri->schema.num_scopes && pri->schema.scopes; i++) free( pri->schema.scopes[i].name );
+    for (i = 0; i < pri->schema.num_items && pri->schema.items; i++) free( pri->schema.items[i].name );
+    free( pri->schema.scopes );
+    free( pri->schema.items );
+    for (i = 0; i < pri->decisions.num_qualifiers && pri->decisions.qualifiers; i++)
+        free( pri->decisions.qualifiers[i].value );
+    free( pri->decisions.qualifiers );
+    free( pri->decisions.set_first ); free( pri->decisions.set_count );
+    free( pri->decisions.dec_first ); free( pri->decisions.dec_count );
+    free( pri->decisions.index_table );
+    if (pri->map)
+        for (i = 0; i < pri->schema.num_items; i++) free( pri->map[i].c );
+    free( pri->map );
+    for (i = 0; i < pri->num_data; i++) { free( pri->data_items[i].data ); free( pri->data_items[i].len ); }
+    free( pri->data_items );
+    free( pri->sections );
+    free( pri->data );
+    free( pri );
+}
+
+struct pri_file *pri_parse( unsigned char *data, size_t size )
+{
+    static const char *magics[] = { "mrm_pri0", "mrm_pri1", "mrm_pri2", "mrm_pri3", "mrm_prif" };
+    struct pri_file *pri;
+    struct reader r;
+    const unsigned char *magic;
+    uint32_t total, toc, sections_start;
+    uint16_t num_sections, primary_map = 0xffff;
+    unsigned int i, m, desc = ~0u;
+    struct reader dr;
+    uint16_t n_schema, n_decn, n_map, n_files, n_data;
+    uint16_t *schema_ix = NULL, *decn_ix = NULL, *map_ix = NULL, *data_ix = NULL;
+
+    rd_init( &r, data, size );
+    magic = rd_take( &r, 8 );
+    if (!magic) return NULL;
+    for (m = 0; m < sizeof(magics) / sizeof(magics[0]); m++) if (!memcmp( magic, magics[m], 8 )) break;
+    if (m == sizeof(magics) / sizeof(magics[0])) return NULL;
+    rd_expect_u16( &r, 0 );
+    rd_expect_u16( &r, 1 );
+    total = rd_u32( &r );
+    toc = rd_u32( &r );
+    sections_start = rd_u32( &r );
+    num_sections = rd_u16( &r );
+    rd_expect_u16( &r, 0xffff );
+    rd_expect_u32( &r, 0 );
+    if (r.bad || total > size || total < 16) return NULL;
+    /* the footer: DEFFFADE, the size, the magic */
+    rd_seek( &r, total - 16 );
+    rd_expect_u32( &r, 0xdefffade );
+    rd_expect_u32( &r, total );
+    if (r.bad || memcmp( data + total - 8, magic, 8 )) return NULL;
+
+    if (!(pri = calloc( 1, sizeof(*pri) ))) return NULL;
+    pri->size = total;
+    pri->schema.section = -1;
+    pri->decisions.section = -1;
+    if (!(pri->sections = calloc( num_sections + 1, sizeof(*pri->sections) ))) goto fail;
+    pri->num_sections = num_sections;
+    rd_seek( &r, toc );
+    for (i = 0; i < num_sections; i++)
+    {
+        const unsigned char *id = rd_take( &r, 16 );
+        uint32_t off, len;
+        struct reader sr;
+        rd_u16( &r ); rd_u16( &r );      /* flags, section flags */
+        rd_u32( &r );                    /* qualifier */
+        off = rd_u32( &r );
+        len = rd_u32( &r );
+        if (r.bad || !id) goto fail;
+        memcpy( pri->sections[i].id, id, 16 );
+        /* header: id(16) qualifier(4) flags(2+2) length(4) zero(4); footer: DEF5FADE length */
+        if ((uint64_t)sections_start + off + len > total || len < 40) goto fail;
+        rd_init( &sr, data + sections_start + off, len );
+        {
+            const unsigned char *sid = rd_take( &sr, 16 );
+            uint32_t slen;
+            rd_u32( &sr ); rd_u16( &sr ); rd_u16( &sr );
+            slen = rd_u32( &sr );
+            rd_expect_u32( &sr, 0 );
+            if (sr.bad || memcmp( sid, id, 16 ) || slen != len) goto fail;
+            rd_seek( &sr, len - 8 );
+            rd_expect_u32( &sr, 0xdef5fade );
+            rd_expect_u32( &sr, len );
+            if (sr.bad) goto fail;
+        }
+        pri->sections[i].content = data + sections_start + off + 32;
+        pri->sections[i].len = len - 40;
+        if (!memcmp( id, "[mrm_pridescex]\0", 16 )) desc = i;
+    }
+    if (desc == ~0u) goto fail;
+
+    /* The descriptor names the sections by role. */
+    rd_init( &dr, pri->sections[desc].content, pri->sections[desc].len );
+    rd_u16( &dr );                       /* flags */
+    rd_u16( &dr );                       /* included file list */
+    rd_expect_u16( &dr, 0 );
+    n_schema = rd_u16( &dr );
+    n_decn = rd_u16( &dr );
+    n_map = rd_u16( &dr );
+    primary_map = rd_u16( &dr );
+    n_files = rd_u16( &dr );
+    n_data = rd_u16( &dr );
+    rd_expect_u16( &dr, 0 );
+    if (dr.bad) goto fail;
+    schema_ix = calloc( n_schema + 1, 2 ); decn_ix = calloc( n_decn + 1, 2 );
+    map_ix = calloc( n_map + 1, 2 ); data_ix = calloc( n_data + 1, 2 );
+    if (!schema_ix || !decn_ix || !map_ix || !data_ix) goto fail;
+    for (i = 0; i < n_schema; i++) schema_ix[i] = rd_u16( &dr );
+    for (i = 0; i < n_decn; i++) decn_ix[i] = rd_u16( &dr );
+    for (i = 0; i < n_map; i++) map_ix[i] = rd_u16( &dr );
+    for (i = 0; i < n_files; i++) rd_u16( &dr );
+    for (i = 0; i < n_data; i++) data_ix[i] = rd_u16( &dr );
+    if (dr.bad) goto fail;
+
+    if (!(pri->data_items = calloc( n_data + 1, sizeof(*pri->data_items) ))) goto fail;
+    for (i = 0; i < n_data; i++)
+    {
+        const struct section *s = find_section( pri, data_ix[i], "[mrm_dataitem] \0" );
+        if (!s || !parse_data_items( &pri->data_items[pri->num_data++], s, data_ix[i] )) goto fail;
+    }
+
+    /* The map to use: the primary one, else the first. Its schema and
+     * decision sections are the ones it names. */
+    {
+        unsigned int map = primary_map != 0xffff ? primary_map : (n_map ? map_ix[0] : ~0u);
+        const struct section *ms;
+        struct reader mr;
+        uint16_t sc, dc;
+        if (map == ~0u || !(ms = find_section( pri, map, NULL ))) goto fail;
+        if (memcmp( ms->id, "[mrm_res_map2_]\0", 16 ) && memcmp( ms->id, "[mrm_res_map__]\0", 16 )) goto fail;
+        rd_init( &mr, ms->content, ms->len );
+        rd_u16( &mr ); rd_u16( &mr );
+        sc = rd_u16( &mr );
+        rd_u16( &mr );
+        dc = rd_u16( &mr );
+        if (mr.bad || sc >= pri->num_sections || dc >= pri->num_sections) goto fail;
+        if (memcmp( pri->sections[sc].id, "[mrm_hschema]  \0", 16 ) && memcmp( pri->sections[sc].id, "[mrm_hschemaex] ", 16 ))
+            goto fail;
+        if (!find_section( pri, dc, "[mrm_decn_info]\0" )) goto fail;
+        if (!parse_schema( pri, sc ) || !parse_decisions( pri, dc ) || !parse_resource_map( pri, map ) || !pri->map)
+            goto fail;
+    }
+
+    free( schema_ix ); free( decn_ix ); free( map_ix ); free( data_ix );
+    pri->data = data;
+    return pri;
+
+fail:
+    free( schema_ix ); free( decn_ix ); free( map_ix ); free( data_ix );
+    pri->data = NULL;
+    pri_free( pri );
+    return NULL;
+}
+
+/* ---- lookup ------------------------------------------------------------- */
+
+/* The item's path below the root, '\\'-separated, with no leading separator. */
+static size_t item_path( const struct pri_file *pri, unsigned int item, WCHAR *buf, size_t max )
+{
+    const struct node *chain[64];
+    unsigned int depth = 0;
+    size_t n = 0;
+    int p;
+
+    chain[depth++] = &pri->schema.items[item];
+    for (p = pri->schema.items[item].parent; p >= 0 && depth < 64; p = pri->schema.scopes[p].parent)
+        chain[depth++] = &pri->schema.scopes[p];
+    while (depth--)
+    {
+        const WCHAR *s = chain[depth]->name;
+        if (!s[0]) continue;
+        if (n && n < max) buf[n++] = '\\';
+        while (*s && n < max) buf[n++] = *s++;
+    }
+    if (n >= max) n = max - 1;
+    buf[n] = 0;
+    return n;
+}
+
+static int path_equal( const WCHAR *a, const WCHAR *b )
+{
+    while (*a == '/' || *a == '\\') a++;
+    while (*b == '/' || *b == '\\') b++;
+    for (;; a++, b++)
+    {
+        WCHAR ca = *a == '/' ? '\\' : lower( *a ), cb = *b == '/' ? '\\' : lower( *b );
+        if (ca != cb) return 0;
+        if (!ca) return 1;
+    }
+}
+
+/* How well a language tag matches a qualifier value: 3 exact, 2 same
+ * language and more specific, 1 same primary language, 0 none. */
+static int language_match( const WCHAR *want, const WCHAR *have )
+{
+    size_t i;
+    for (i = 0; want[i] && have[i]; i++)
+        if (lower( want[i] ) != lower( have[i] ) && !((want[i] == '-' || want[i] == '_') && (have[i] == '-' || have[i] == '_')))
+            break;
+    if (!want[i] && !have[i]) return 3;
+    if (!have[i] && (want[i] == '-' || want[i] == '_')) return 2;
+    if (!want[i] && (have[i] == '-' || have[i] == '_')) return 2;
+    /* compare primary subtags */
+    for (i = 0; want[i] && want[i] != '-' && want[i] != '_' && lower( want[i] ) == lower( have[i] ); i++) ;
+    if ((!want[i] || want[i] == '-' || want[i] == '_') && (!have[i] || have[i] == '-' || have[i] == '_') && i) return 1;
+    return 0;
+}
+
+/* Scores a candidate: higher is better; -1 means excluded. */
+static long candidate_score( const struct pri_file *pri, const struct candidate *c, const WCHAR *const *languages )
+{
+    const struct decision_info *di = &pri->decisions;
+    long score = 0;
+    unsigned int k;
+
+    for (k = 0; k < di->set_count[c->set]; k++)
+    {
+        uint16_t qi = di->index_table[di->set_first[c->set] + k];
+        const struct qualifier *q;
+        if (qi >= di->num_qualifiers) return -1;
+        q = &di->qualifiers[qi];
+        if (q->type == QUALIFIER_LANGUAGE)
+        {
+            long best = 0;
+            unsigned int li;
+            for (li = 0; languages && languages[li] && li < 32; li++)
+            {
+                int m = language_match( languages[li], q->value );
+                if (m) { long s = (long)(32 - li) * 16 + m * 4; if (s > best) best = s; }
+            }
+            /* No preferred language matched: fall back to the language the
+             * file names as its fallback (its default), like MRT. */
+            if (!best) best = q->fallback ? 1 + q->fallback / 250 : 0;
+            if (!best) return -1;
+            score += best * 1000;
+        }
+        else score += q->fallback;    /* scale, contrast, ...: prefer the default */
+    }
+    return score;
+}
+
+static WCHAR *candidate_string( const struct candidate *c )
+{
+    switch (c->value_type)
+    {
+    case VT_STRING:
+    case VT_PATH:
+        return wstr_from_utf16( c->data, c->len / 2 );
+    case VT_ASCII_STRING:
+    case VT_ASCII_PATH:
+        return wstr_from_ascii( c->data, c->len );
+    case VT_UTF8_STRING:
+    case VT_UTF8_PATH:
+        return wstr_from_utf8( c->data, c->len );
+    }
+    return NULL;
+}
+
+WCHAR *pri_get_string( const struct pri_file *pri, const WCHAR *path, const WCHAR *const *languages )
+{
+    WCHAR buf[1024];
+    unsigned int i;
+
+    for (i = 0; i < pri->schema.num_items; i++)
+    {
+        const struct item_candidates *ic = &pri->map[i];
+        const struct candidate *best = NULL;
+        long best_score = -1;
+        unsigned int j;
+
+        if (!ic->count) continue;
+        item_path( pri, i, buf, sizeof(buf) / sizeof(buf[0]) );
+        if (!path_equal( buf, path )) continue;
+        for (j = 0; j < ic->count; j++)
+        {
+            long s;
+            if (ic->c[j].value_type == VT_EMBEDDED) continue;
+            s = candidate_score( pri, &ic->c[j], languages );
+            if (s > best_score) { best_score = s; best = &ic->c[j]; }
+        }
+        if (!best)   /* nothing matched at all: any candidate beats none */
+            for (j = 0; j < ic->count && !best; j++)
+                if (ic->c[j].value_type != VT_EMBEDDED) best = &ic->c[j];
+        return best ? candidate_string( best ) : NULL;
+    }
+    return NULL;
+}
+
+void pri_enum_items( const struct pri_file *pri, void (*cb)( const WCHAR *path, void *ctx ), void *ctx )
+{
+    WCHAR buf[1024];
+    for (unsigned int i = 0; i < pri->schema.num_items; i++)
+    {
+        item_path( pri, i, buf, sizeof(buf) / sizeof(buf[0]) );
+        cb( buf, ctx );
+    }
+}
