+static HRESULT create_loader( const WCHAR *name, IResourceLoader **out )
+{
+    struct resource_loader *impl;
+    const WCHAR *map = name && name[0] ? name : L"Resources";
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IResourceLoader_iface.lpVtbl = &loader_vtbl;
+    impl->IResourceLoader2_iface.lpVtbl = &loader2_vtbl;
+    impl->ref = 1;
+    /* "ms-resource:///Name" and "/Name" name the same map as "Name". */
+    if (!wcsnicmp( map, L"ms-resource:", 12 )) map += 12;
+    while (*map == '/') map++;
+    if (!(impl->map = wcsdup( map )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    TRACE( "map %s\n", debugstr_w( impl->map ) );
+    *out = &impl->IResourceLoader_iface;
+    return S_OK;
+}
