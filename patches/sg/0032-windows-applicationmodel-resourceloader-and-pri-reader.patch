+/*
+ * String resources from the application's Package Resource Index. A packaged
+ * application's index is resources.pri in its package root; for a process
+ * that runs from an unpacked package directory -- which is how applications
+ * run here -- that is the directory of its executable. <exe name>.pri is also
+ * tried, the name MRT gives an unpackaged application's index.
+ *
+ * A loader names a resource map below the index's root: "Resources" by
+ * default (the Resources.resw file), or the name it was created with
+ * ("winget" for winget.resw). GetString("Key") is "<map>/Key"; a name that
+ * starts with '/' is taken from the root. Like Windows, a resource that does
+ * not exist yields an empty string rather than an error.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "pri.h"
+#include "winnls.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+/* ---- the process's index, loaded once ----------------------------------- */
+
+static CRITICAL_SECTION pri_cs;
+static CRITICAL_SECTION_DEBUG pri_cs_debug =
+{
+    0, 0, &pri_cs,
+    { &pri_cs_debug.ProcessLocksList, &pri_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": pri_cs") }
+};
+static CRITICAL_SECTION pri_cs = { &pri_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL pri_tried;
+static struct pri_file *pri;
+static WCHAR pri_path[MAX_PATH];
+static WCHAR **languages;
+
+static struct pri_file *load_pri_file( const WCHAR *path )
+{
+    LARGE_INTEGER size;
+    unsigned char *data;
+    struct pri_file *ret = NULL;
+    DWORD read;
+    HANDLE file;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (GetFileSizeEx( file, &size ) && size.QuadPart > 0 && size.QuadPart < 256 * 1024 * 1024 &&
+        (data = malloc( size.QuadPart )))
+    {
+        if (ReadFile( file, data, size.QuadPart, &read, NULL ) && read == size.QuadPart &&
+            (ret = pri_parse( data, read )))
+            TRACE( "loaded %s\n", debugstr_w( path ) );
+        else
+        {
+            WARN( "%s is not a usable resource index\n", debugstr_w( path ) );
+            free( data );
+        }
+    }
+    CloseHandle( file );
+    return ret;
+}
+
+static void load_languages(void)
+{
+    ULONG count = 0, len = 0, n = 0;
+    WCHAR *buf, *p;
+
+    if (GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, NULL, &len ) && len &&
+        (buf = malloc( len * sizeof(WCHAR) )) &&
+        GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, buf, &len ))
+    {
+        if ((languages = calloc( count + 2, sizeof(*languages) )))
+            for (p = buf; *p && n < count; p += wcslen( p ) + 1) languages[n++] = p;
+    }
+    if (!languages) languages = calloc( 2, sizeof(*languages) );
+    /* English last: the language a resource index is most likely to fall
+     * back to when none of the user's is present. */
+    if (languages) languages[n] = (WCHAR *)L"en-US";
+}
+
+static struct pri_file *get_pri(void)
+{
+    EnterCriticalSection( &pri_cs );
+    if (!pri_tried)
+    {
+        WCHAR exe[MAX_PATH], *name, *dot;
+        DWORD len;
+
+        pri_tried = TRUE;
+        load_languages();
+        len = GetModuleFileNameW( NULL, exe, ARRAY_SIZE(exe) );
+        if (len && len < ARRAY_SIZE(exe) && (name = wcsrchr( exe, '\\' )))
+        {
+            name++;
+            swprintf( pri_path, ARRAY_SIZE(pri_path), L"%.*sresources.pri", (int)(name - exe), exe );
+            if (!(pri = load_pri_file( pri_path )) && (dot = wcsrchr( name, '.' )))
+            {
+                swprintf( pri_path, ARRAY_SIZE(pri_path), L"%.*s.pri", (int)(dot - exe), exe );
+                pri = load_pri_file( pri_path );
+            }
+            if (!pri) pri_path[0] = 0;
+        }
+        if (!pri) WARN( "no resource index for %s\n", debugstr_w( exe ) );
+    }
+    LeaveCriticalSection( &pri_cs );
+    return pri;
+}
+
+/* Looks up <map>/<resource>, or <resource> from the root if it begins with
+ * '/'. Always succeeds with a string, empty if there is no such resource. */
+static HRESULT lookup_string( const WCHAR *map, const WCHAR *resource, HSTRING *value )
+{
+    struct pri_file *file = get_pri();
+    WCHAR *path, *str = NULL;
+    size_t len;
+    HRESULT hr;
+
+    if (!resource) resource = L"";
+    len = wcslen( map ) + wcslen( resource ) + 2;
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    if (resource[0] == '/') wcscpy( path, resource );
+    else swprintf( path, len, L"%s/%s", map, resource );
+
+    if (file) str = pri_get_string( file, path, (const WCHAR *const *)languages );
+    TRACE( "%s -> %s\n", debugstr_w( path ), debugstr_w( str ) );
+    free( path );
+    hr = WindowsCreateString( str, str ? wcslen( str ) : 0, value );
+    free( str );
+    return hr;
+}
+
+/* ms-resource:///Map/Key, ms-resource://package/Map/Key: the path names the
+ * resource from the root. */
+static HRESULT lookup_uri( IUriRuntimeClass *uri, HSTRING *value )
+{
+    HSTRING hpath = NULL;
+    const WCHAR *path;
+    HRESULT hr;
+
+    if (!uri || !value) return E_POINTER;
+    if (FAILED(hr = IUriRuntimeClass_get_Path( uri, &hpath ))) return hr;
+    path = WindowsGetStringRawBuffer( hpath, NULL );
+    hr = lookup_string( L"", path[0] == '/' ? path : L"/", value );
+    WindowsDeleteString( hpath );
+    return hr;
+}
