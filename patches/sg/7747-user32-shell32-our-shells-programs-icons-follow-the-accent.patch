+    UINT flags;
+} sg_tinted[256];
 static unsigned int sg_tinted_count;
 static CRITICAL_SECTION sg_tint_cs;
 static CRITICAL_SECTION_DEBUG sg_tint_cs_debug =
@@ -1135,15 +1172,22 @@
     return -1;
 }
 
-static void sg_tinted_note( HICON icon, COLORREF accent )
+static void sg_tinted_note( HICON icon, COLORREF accent, HMODULE module, LPCWSTR resname,
+                            INT width, INT height, UINT flags )
 {
     int i;
     EnterCriticalSection( &sg_tint_cs );
     if ((i = sg_tinted_find( icon )) >= 0) sg_tinted[i].accent = accent;
     else if (sg_tinted_count < ARRAY_SIZE(sg_tinted))
     {
-        sg_tinted[sg_tinted_count].icon = icon;
-        sg_tinted[sg_tinted_count++].accent = accent;
+        i = sg_tinted_count++;
+        sg_tinted[i].icon = icon;
+        sg_tinted[i].accent = accent;
+        sg_tinted[i].module = module;
+        sg_tinted[i].name = IS_INTRESOURCE(resname) || !resname ? (LPWSTR)resname : wcsdup( resname );
+        sg_tinted[i].width = width;
+        sg_tinted[i].height = height;
+        sg_tinted[i].flags = flags;
     }
     LeaveCriticalSection( &sg_tint_cs );
 }
@@ -1187,13 +1231,13 @@
     {
         /* the shared icon again, in the new accent, in place: everyone who holds it sees it */
         desc.flags |= SG_CURSORICON_REPLACE;
-        if (NtUserSetCursorIconData( reuse, NULL, NULL, &desc )) sg_tinted_note( reuse, accent );
+        if (NtUserSetCursorIconData( reuse, NULL, NULL, &desc )) sg_tinted_note( reuse, accent, NULL, NULL, 0, 0, 0 );
         else free_icon_frame( &frame );
         return reuse;
     }
     ret = create_cursoricon_object( &desc, bIcon, module, resname, rsrc );
     if (!ret) free_icon_frame( &frame );
-    else if (tint && bIcon && (flags & LR_SHARED)) sg_tinted_note( ret, accent );
+    else if (tint && bIcon && (flags & LR_SHARED)) sg_tinted_note( ret, accent, module, resname, width, height, flags );
     return ret;
 }
 
@@ -1688,6 +1732,66 @@
     return hIcon;
 }
 
+/***********************************************************************
+ * Stained Glass OS: a new accent re-makes, in place, the shared icons this
+ * process tinted with the old one -- the ones its windows' title bars and
+ * class icons hold -- as the next LoadImage of each would (wine-sg 7747).
+ * Run on WM_SETTINGCHANGE "ImmersiveColorSet", once per accent.
+ */
+void sg_follow_accent_icons( HWND hwnd )
+{
+    static COLORREF done = CLR_INVALID;
+    COLORREF accent = sg_icon_accent();
+    unsigned int i, count;
+    int depth;
+
+#ifdef SG_MUTANT_TITLE_ICONS_KEEP
+    return;
+#endif
+    if (accent != done)
+    {
+        done = accent;
+        depth = get_display_bpp();
+        EnterCriticalSection( &sg_tint_cs );
+        count = sg_tinted_count;
+        LeaveCriticalSection( &sg_tint_cs );
+        for (i = 0; i < count; i++)
+        {
+            HMODULE loaded;
+
+            /* only from a module still loaded (not one mapped as data, nor freed since) */
+            if (!sg_tinted[i].module || sg_tinted[i].accent == accent ||
+                !GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                     (LPCWSTR)sg_tinted[i].module, &loaded ) || loaded != sg_tinted[i].module)
+                continue;
+            CURSORICON_Load( sg_tinted[i].module, sg_tinted[i].name, sg_tinted[i].width,
+                             sg_tinted[i].height, depth, FALSE, sg_tinted[i].flags | LR_SHARED );
+        }
+    }
+    if (GetWindowLongW( hwnd, GWL_STYLE ) & WS_CHILD) return;
+    /* the title bar draws the class's small icon, which win32u made from the
+     * big one when the class was registered: the big one again makes it again,
+     * from the resource, in the new accent */
+    {
+        HICON big = (HICON)GetClassLongPtrW( hwnd, GCLP_HICON );
+        int i;
+
+        EnterCriticalSection( &sg_tint_cs );
+        i = big ? sg_tinted_find( big ) : -1;
+        LeaveCriticalSection( &sg_tint_cs );
+#ifdef SG_MUTANT_SMALL_ICON_KEEP
+        i = -1;
+#endif
+        if (i >= 0)
+        {
+            NtUserSetClassLongPtr( hwnd, GCLP_HICON, 0, FALSE );
+            NtUserSetClassLongPtr( hwnd, GCLP_HICON, (ULONG_PTR)big, FALSE );
+        }
+    }
+    /* the title bar's icon is drawn with the frame */
+    NtUserRedrawWindow( hwnd, NULL, 0, RDW_FRAME | RDW_INVALIDATE );
+}
+
 
 static HBITMAP create_masked_bitmap( int width, int height, const void *and, const void *xor )
 {
