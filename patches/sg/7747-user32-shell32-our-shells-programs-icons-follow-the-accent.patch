From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32, shell32: our shell's programs' icons and title-bar icons follow the accent

Follows 6269 (the icons we draw follow the accent; programs' own never
change), which knew our modules by the Wine builtin signature only. On qa5,
with another accent, the Settings, Control Panel, Task Manager and Store
icons stayed purple -- in their title bars, their taskbar buttons and the
taskbar's pins -- and a window open when the accent changed kept its icon.

- user32: a module or a file mapped from /usr/libexec/stained-glass (our
  shell's programs, mingw-built, not builtins; by the mapping's file name)
  is ours too.
- shell32: the image list's entries from that folder are made again on a
  new accent, as the builtins' are.
- user32: on WM_SETTINGCHANGE "ImmersiveColorSet", once per accent, the
  shared icons this process tinted are made again in place from their
  resources (it keeps where each came from), and a top-level window's class
  icon is set again so win32u makes the small icon its title bar draws
  again; the frame is repainted.
---
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -39,6 +39,7 @@
 #include "pidl.h"
 #include "shell32_main.h"
 #include "shresdef.h"
+#include "shlwapi.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(shell);
 
@@ -738,9 +739,18 @@
 {
     static const char signature[] = "Wine builtin DLL";
     char header[sizeof(IMAGE_DOS_HEADER) + sizeof(signature)];
+    WCHAR full[MAX_PATH], *p;
     HANDLE handle;
     DWORD read = 0;
 
+    /* our shell's programs, in /usr/libexec/stained-glass (wine-sg 7747) */
+    if (GetFullPathNameW( file, ARRAY_SIZE(full), full, NULL ))
+    {
+        for (p = full; *p; p++) if (*p == '/') *p = '\\';
+#ifndef SG_MUTANT_SHELL_ICONS_FIXED
+        if (StrStrIW( full, L"\\usr\\libexec\\stained-glass\\" )) return TRUE;
+#endif
+    }
     handle = CreateFileW( file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
                           OPEN_EXISTING, 0, NULL );
     if (handle == INVALID_HANDLE_VALUE) return FALSE;
--- a/dlls/user32/cursoricon.c
+++ b/dlls/user32/cursoricon.c
@@ -1005,6 +1005,33 @@
     return SG_KEY_COLOR;
 }
 
+/* Stained Glass OS: our shell's own programs -- mingw-built, not builtins -- live
+ * in /usr/libexec/stained-glass; a module or a file mapped from there is ours
+ * too, its icons follow the accent as the builtins' do (wine-sg 7747) */
+static BOOL sg_mapping_is_shell( const void *base )
+{
+    static const WCHAR dir[] = L"\\usr\\libexec\\stained-glass\\";
+    char buffer[sizeof(MEMORY_SECTION_NAME) + 1024 * sizeof(WCHAR)];
+    MEMORY_SECTION_NAME *name = (MEMORY_SECTION_NAME *)buffer;
+    WCHAR lower[1024];
+    unsigned int i, count;
+    SIZE_T len;
+
+#ifdef SG_MUTANT_SHELL_ICONS_FIXED
+    return FALSE;
+#endif
+    if (NtQueryVirtualMemory( GetCurrentProcess(), base, MemoryMappedFilenameInformation, name, sizeof(buffer), &len ))
+        return FALSE;
+    count = min( name->SectionFileName.Length / sizeof(WCHAR), ARRAY_SIZE(lower) - 1 );
+    for (i = 0; i < count; i++)
+    {
+        WCHAR c = name->SectionFileName.Buffer[i];
+        lower[i] = c == '/' ? '\\' : (c >= 'A' && c <= 'Z' ? c + 32 : c);
+    }
+    lower[count] = 0;
+    return wcsstr( lower, dir ) != NULL;
+}
+
 BOOL sg_module_is_ours( HMODULE module )
 {
     static const char signature[] = "Wine builtin DLL";
@@ -1027,6 +1054,7 @@
 #ifdef SG_MUTANT_TRY_RETURN
     __TRY { if (module) return ours; } __EXCEPT_PAGE_FAULT { } __ENDTRY
 #endif
+    if (!ours) ours = sg_mapping_is_shell( dos );
     return ours;
 }
 
