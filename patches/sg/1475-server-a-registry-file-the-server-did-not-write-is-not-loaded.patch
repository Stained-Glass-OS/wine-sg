 static int load_init_registry_from_file( const char *filename, struct key *key )
 {
-    FILE *f;
+    FILE *f = NULL;
 
-    if ((f = fopen( filename, "r" )))
+    if (!sg_untrusted_registry_file( filename ) && (f = fopen( filename, "r" )))
     {
         load_keys( key, filename, f, 0 );
         fclose( f );
