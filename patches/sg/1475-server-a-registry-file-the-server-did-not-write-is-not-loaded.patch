From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a registry file the server did not write is not loaded

In a prefix shared between users every person may make files in the
prefix (Wine's clients need to write there), so one could plant
user-<uid>.reg for another person before that person first signs in --
their HKCU, with Run keys and file associations -- or a system.reg of
their own while the server was not running. In a shared prefix only a
regular file owned by the server's account, root or the prefix owner is
loaded; another (or a symlink) is moved aside as .untrusted.<time>.<name>,
said on stderr, and the hive starts as a new one would. sg-session
0.1.0-163 makes the folders sticky and cleans up at boot.

Gate: test/hivetrust-gate.sh. Mutant: SG_MUTANT_TRUST_ANY_HIVE.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -1938,12 +1938,51 @@
     }
 }
 
+/* Stained Glass OS (wine-sg 1475): in a prefix shared between users, a
+ * registry file the server did not write is not loaded. Every person may make
+ * files in the prefix (Wine's clients need to), so one could plant
+ * user-<uid>.reg for another person before that person first signs in -- a
+ * hive with their Run keys and file associations -- or a system.reg of their
+ * own while the server was not running. Only a regular file of the server's,
+ * root's or the prefix owner's (the machine account) is loaded; another is
+ * moved aside, said on stderr (the machine log), and the hive starts as a
+ * new one would. */
+static int sg_untrusted_registry_file( const char *filename )
+{
+    struct stat st = { 0 };
+    char aside[PATH_MAX];
+    int fd;
+
+    if (!sg_system_prefix) return 0;
+#ifdef SG_MUTANT_TRUST_ANY_HIVE
+    return 0;
+#endif
+    if ((fd = open( filename, O_RDONLY | O_NOFOLLOW | O_NONBLOCK )) == -1)
+    {
+        if (errno == ENOENT) return 0;
+        if (lstat( filename, &st ) == -1) return 0;   /* not there: a new hive */
+    }
+    else
+    {
+        int ok = !fstat( fd, &st ) && S_ISREG( st.st_mode ) &&
+                 (st.st_uid == getuid() || st.st_uid == 0 || st.st_uid == sg_system_prefix_uid);
+        close( fd );
+        if (ok) return 0;
+    }
+    snprintf( aside, sizeof(aside), ".untrusted.%ld.%s", (long)time( NULL ), filename );
+    if (rename( filename, aside ) == -1 && unlink( filename ) == -1)
+        fprintf( stderr, "wineserver: %s could not be moved aside: %s\n", filename, strerror( errno ));
+    fprintf( stderr, "wineserver: %s is not the system's (owner %u): moved aside as %s, not loaded\n",
+             filename, (unsigned int)st.st_uid, aside );
+    return 1;
+}
+
