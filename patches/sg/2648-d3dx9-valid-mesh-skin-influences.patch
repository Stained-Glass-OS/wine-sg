 static DWORD WINAPI d3dx9_skin_info_GetNumBoneInfluences(ID3DXSkinInfo *iface, DWORD bone_idx)
@@ -182,17 +189,63 @@ static HRESULT WINAPI d3dx9_skin_info_GetBoneInfluence(ID3DXSkinInfo *iface,
 static HRESULT WINAPI d3dx9_skin_info_GetBoneVertexInfluence(ID3DXSkinInfo *iface,
         DWORD bone_idx, DWORD influence_idx, float *weight, DWORD *vertex_idx)
 {
-    FIXME("iface %p, bone_idx %lu, influence_idx %lu, weight %p, vertex_idx %p stub!\n",
+    struct d3dx9_skin_info *skin = impl_from_ID3DXSkinInfo(iface);
+
+    TRACE("iface %p, bone_idx %lu, influence_idx %lu, weight %p, vertex_idx %p.\n",
             iface, bone_idx, influence_idx, weight, vertex_idx);
 
-    return E_NOTIMPL;
+    if (bone_idx >= skin->num_bones || influence_idx >= skin->bones[bone_idx].num_influences
+            || !weight || !vertex_idx)
+        return D3DERR_INVALIDCALL;
+
+    *weight = skin->bones[bone_idx].weights[influence_idx];
+    *vertex_idx = skin->bones[bone_idx].vertices[influence_idx];
+
+    return D3D_OK;
+}
+
+/* the number of bones that influence each vertex */
+static DWORD *skin_info_count_vertex_bones(const struct d3dx9_skin_info *skin, DWORD *vertex_count)
+{
+    DWORD i, j, count = skin->num_vertices;
+    DWORD *counts;
+
+    for (i = 0; i < skin->num_bones; ++i)
+        for (j = 0; j < skin->bones[i].num_influences; ++j)
+            if (skin->bones[i].vertices[j] >= count)
+                count = skin->bones[i].vertices[j] + 1;
+
+    if (!(counts = calloc(count ? count : 1, sizeof(*counts))))
+        return NULL;
+    for (i = 0; i < skin->num_bones; ++i)
+        for (j = 0; j < skin->bones[i].num_influences; ++j)
+            ++counts[skin->bones[i].vertices[j]];
+
+    *vertex_count = count;
+    return counts;
 }
 
 static HRESULT WINAPI d3dx9_skin_info_GetMaxVertexInfluences(ID3DXSkinInfo *iface, DWORD *max_vertex_influences)
 {
-    FIXME("iface %p, max_vertex_influences %p stub!\n", iface, max_vertex_influences);
+    struct d3dx9_skin_info *skin = impl_from_ID3DXSkinInfo(iface);
+    DWORD *counts, count, i, max = 0;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, max_vertex_influences %p.\n", iface, max_vertex_influences);
+
+    if (!max_vertex_influences)
+        return D3DERR_INVALIDCALL;
+
+    if (!(counts = skin_info_count_vertex_bones(skin, &count)))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i)
+        max = max(max, counts[i]);
+    free(counts);
+
+#ifdef SG_MUTANT_D3DXSKIN_MAX_ZERO
+    max = 0;
+#endif
+    *max_vertex_influences = max;
+    return D3D_OK;
 }
 
