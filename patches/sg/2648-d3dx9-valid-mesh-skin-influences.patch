+static HRESULT mesh_report_invalid(ID3DXBuffer **errors_and_warnings, const char *text)
+{
+    if (errors_and_warnings && SUCCEEDED(D3DXCreateBuffer(strlen(text) + 1, errors_and_warnings)))
+        strcpy(ID3DXBuffer_GetBufferPointer(*errors_and_warnings), text);
+
+    return D3DXERR_INVALIDMESH;
+}
+
+static DWORD mesh_uf_find(DWORD *parent, DWORD i)
+{
+    while (parent[i] != i)
+        i = parent[i] = parent[parent[i]];
+    return i;
+}
+
+/* A mesh is invalid when a face uses a vertex twice or an index outside the vertices, or when the faces around
+   a vertex are not one fan by the adjacency (a bow-tie vertex). */
 HRESULT WINAPI D3DXValidMesh(ID3DXMesh *mesh, const DWORD *adjacency, ID3DXBuffer **errors_and_warnings)
 {
-    FIXME("mesh %p, adjacency %p, errors_and_warnings %p stub.\n", mesh, adjacency, errors_and_warnings);
+    DWORD num_faces, num_vertices, i, e, v, *indices = NULL, *refs = NULL, *parent = NULL, *fan_faces = NULL;
+    BOOL is_32bit;
+    void *data;
+    HRESULT hr, ret = D3D_OK;
+    IDirect3DIndexBuffer9 *ib;
 
-    return E_NOTIMPL;
+    TRACE("mesh %p, adjacency %p, errors_and_warnings %p.\n", mesh, adjacency, errors_and_warnings);
+
+    if (errors_and_warnings)
+        *errors_and_warnings = NULL;
+    if (!mesh)
+        return D3DERR_INVALIDCALL;
+
+    num_faces = mesh->lpVtbl->GetNumFaces(mesh);
+    num_vertices = mesh->lpVtbl->GetNumVertices(mesh);
+    is_32bit = !!(mesh->lpVtbl->GetOptions(mesh) & D3DXMESH_32BIT);
+
+    if (FAILED(hr = mesh->lpVtbl->GetIndexBuffer(mesh, &ib)))
+        return hr;
+    if (FAILED(hr = IDirect3DIndexBuffer9_Lock(ib, 0, 0, &data, D3DLOCK_READONLY)))
+    {
+        IDirect3DIndexBuffer9_Release(ib);
+        return hr;
+    }
+
+    indices = malloc(max(num_faces * 3, 1) * sizeof(*indices));
+    if (!indices)
+    {
+        ret = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (i = 0; i < num_faces * 3; ++i)
+        indices[i] = is_32bit ? ((DWORD *)data)[i] : ((WORD *)data)[i];
+
+    for (i = 0; i < num_faces; ++i)
+    {
+        const DWORD *f = &indices[i * 3];
+
+        if (f[0] >= num_vertices || f[1] >= num_vertices || f[2] >= num_vertices)
+        {
+            ret = mesh_report_invalid(errors_and_warnings, "A face uses a vertex that does not exist.\n");
+            goto done;
+        }
+        if (f[0] == f[1] || f[1] == f[2] || f[0] == f[2])
+        {
+            ret = mesh_report_invalid(errors_and_warnings, "A face uses a vertex twice.\n");
+            goto done;
+        }
+    }
+
+#ifdef SG_MUTANT_D3DXVALID_NO_BOWTIE
+    adjacency = NULL;
+#endif
+    if (!adjacency)
+        goto done;
+
+    /* the faces around each vertex have to be connected by the adjacency */
+    if (!(parent = malloc(max(num_faces, 1) * sizeof(*parent))) || !(refs = malloc(max(num_faces, 1) * sizeof(*refs)))
+            || !(fan_faces = malloc(max(num_faces, 1) * sizeof(*fan_faces))))
+    {
+        ret = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    for (v = 0; v < num_vertices; ++v)
+    {
+        DWORD count = 0, components = 0, j;
+
+        for (i = 0; i < num_faces; ++i)
+        {
+            if (indices[i * 3] == v || indices[i * 3 + 1] == v || indices[i * 3 + 2] == v)
+            {
+                parent[count] = count;
+                fan_faces[count++] = i;
+            }
+        }
+        if (count < 2)
+            continue;
+
+        for (i = 0; i < count; ++i)
+        {
+            for (e = 0; e < 3; ++e)
+            {
+                DWORD neighbour = adjacency[fan_faces[i] * 3 + e];
+
+                if (neighbour == ~0u)
+                    continue;
+                for (j = 0; j < count; ++j)
+                {
+                    if (fan_faces[j] == neighbour)
+                    {
+                        parent[mesh_uf_find(parent, i)] = mesh_uf_find(parent, j);
+                        break;
+                    }
+                }
+            }
+        }
+        for (i = 0; i < count; ++i)
+            if (mesh_uf_find(parent, i) == i)
+                ++components;
+        if (components > 1)
+        {
+            ret = mesh_report_invalid(errors_and_warnings, "A vertex is shared by faces that are not connected (bow-tie).\n");
+            goto done;
+        }
+    }
+
+done:
+    free(fan_faces);
+    free(refs);
+    free(parent);
+    free(indices);
+    IDirect3DIndexBuffer9_Unlock(ib);
+    IDirect3DIndexBuffer9_Release(ib);
+    return ret;
 }
 
 static BOOL weld_float1(void *to, void *from, FLOAT epsilon)
@@ -7445,6 +7593,22 @@ HRESULT WINAPI D3DXComputeTangentFrameEx(ID3DXMesh *mesh, DWORD texture_in_seman
         return D3DERR_INVALIDCALL;
