 static HRESULT WINAPI d3dx9_skin_info_GetMaxFaceInfluences(struct ID3DXSkinInfo *iface,
         struct IDirect3DIndexBuffer9 *index_buffer, DWORD face_count, DWORD *max_face_influences)
 {
-    FIXME("iface %p, index_buffer %p, face_count %lu, max_face_influences %p stub!\n",
+    struct d3dx9_skin_info *skin = impl_from_ID3DXSkinInfo(iface);
+    D3DINDEXBUFFER_DESC desc;
+    DWORD vertex_count, face, k, b, j, max = 0;
+    DWORD *counts;
+    void *data;
+    HRESULT hr;
+
+    TRACE("iface %p, index_buffer %p, face_count %lu, max_face_influences %p.\n",
             iface, index_buffer, face_count, max_face_influences);
 
-    return E_NOTIMPL;
+    if (!index_buffer || !max_face_influences)
+        return D3DERR_INVALIDCALL;
+
+    if (FAILED(hr = IDirect3DIndexBuffer9_GetDesc(index_buffer, &desc)))
+        return hr;
+    if (desc.Format != D3DFMT_INDEX16 && desc.Format != D3DFMT_INDEX32)
+        return D3DERR_INVALIDCALL;
+    if (desc.Size < face_count * 3 * (desc.Format == D3DFMT_INDEX16 ? 2 : 4))
+        return D3DERR_INVALIDCALL;
+
+    if (!(counts = skin_info_count_vertex_bones(skin, &vertex_count)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = IDirect3DIndexBuffer9_Lock(index_buffer, 0, 0, &data, D3DLOCK_READONLY)))
+    {
+        free(counts);
+        return hr;
+    }
+
+    /* the bones that influence at least one of the three vertices of a face */
+    for (face = 0; face < face_count; ++face)
+    {
+        DWORD index[3], influences = 0;
+
+        for (k = 0; k < 3; ++k)
+        {
+            index[k] = desc.Format == D3DFMT_INDEX16 ? ((WORD *)data)[face * 3 + k] : ((DWORD *)data)[face * 3 + k];
+            if (index[k] >= vertex_count)
+                index[k] = ~0u;
+        }
+        for (b = 0; b < skin->num_bones; ++b)
+        {
+            BOOL hit = FALSE;
+
+            for (j = 0; j < skin->bones[b].num_influences && !hit; ++j)
+                for (k = 0; k < 3; ++k)
+                    if (index[k] != ~0u && skin->bones[b].vertices[j] == index[k])
+                        hit = TRUE;
+            if (hit)
+                ++influences;
+        }
+        max = max(max, influences);
+    }
+
+    IDirect3DIndexBuffer9_Unlock(index_buffer);
+    free(counts);
+
+#ifdef SG_MUTANT_D3DXSKIN_FACE_ONE
+    max = min(max, 1);
+#endif
+    *max_face_influences = max;
+    return D3D_OK;
 }
 
