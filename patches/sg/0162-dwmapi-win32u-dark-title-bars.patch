From: Stained Glass OS <dev@stained-glass.example>
Subject: dwmapi, win32u: dark title bars (DWMWA_USE_IMMERSIVE_DARK_MODE), caption colours

Programs ask DWM for a dark title bar with DwmSetWindowAttribute(
DWMWA_USE_IMMERSIVE_DARK_MODE) (20; 19 before Windows 10 20H1), and Windows 11
programs set DWMWA_CAPTION_COLOR / DWMWA_TEXT_COLOR. dwmapi records them as
window properties (a program's own windows only, E_ACCESSDENIED otherwise;
DWMWA_COLOR_DEFAULT/NONE clear a colour) and repaints the frame; win32u's
caption painter (0013's flat buttons) draws the caption, its text, buttons
and the sizing frame in Windows 10's dark colours -- or the program's --
whatever the system colours are. DwmGetWindowAttribute reports the dark
mode. DWMWA_COLOR_DEFAULT and DWMWA_COLOR_NONE are added to dwmapi.h.

Gate: test/darkmode-gate.sh.
---
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -125,6 +125,27 @@
         return NtUserSetWindowCloak(hwnd, *(const BOOL *)attribute ? SET_WINDOW_CLOAK : 0) ? S_OK : E_FAIL;
     }
 
+    if (attributenum == DWMWA_USE_IMMERSIVE_DARK_MODE || attributenum == 19 /* before Windows 10 20H1 */ ||
+        attributenum == DWMWA_CAPTION_COLOR || attributenum == DWMWA_TEXT_COLOR)
+    {
+        /* Stained Glass OS: the title bar's colours, drawn by win32u from
+         * these properties (a colour is stored + 1, so black is not "none") */
+        if (!attribute || size < sizeof(DWORD)) return E_INVALIDARG;
+        if (!GetWindowThreadProcessId(hwnd, &pid)) return E_HANDLE;
+        if (pid != GetCurrentProcessId()) return E_ACCESSDENIED;
+        if (attributenum == DWMWA_CAPTION_COLOR || attributenum == DWMWA_TEXT_COLOR)
+        {
+            const WCHAR *name = attributenum == DWMWA_CAPTION_COLOR ? L"__wine_caption_color" : L"__wine_caption_text";
+            COLORREF color = *(const COLORREF *)attribute;
+            if (color == DWMWA_COLOR_DEFAULT || color == DWMWA_COLOR_NONE) RemovePropW(hwnd, name);
+            else SetPropW(hwnd, name, (HANDLE)(ULONG_PTR)((color & 0xffffff) + 1));
+        }
+        else if (*(const BOOL *)attribute) SetPropW(hwnd, L"__wine_dark_caption", (HANDLE)1);
+        else RemovePropW(hwnd, L"__wine_dark_caption");
+        RedrawWindow(hwnd, NULL, 0, RDW_FRAME | RDW_INVALIDATE);
+        return S_OK;
+    }
