+/* Stained Glass OS: a program asks for a dark title bar with
+ * DwmSetWindowAttribute(DWMWA_USE_IMMERSIVE_DARK_MODE), which dwmapi records
+ * as this property; DWMWA_CAPTION_COLOR / DWMWA_TEXT_COLOR as the others
+ * (the colour + 1, so that black is not "no colour"). The caption, its text,
+ * its buttons and the frame then take Windows 10's dark colours (or the
+ * program's), whatever the system colours are. */
+static BOOL caption_is_dark( HWND hwnd )
+{
+    static const WCHAR darkW[] = {'_','_','w','i','n','e','_','d','a','r','k','_','c','a','p','t','i','o','n',0};
+    return hwnd && NtUserGetProp( hwnd, darkW ) != 0;
+}
+
+static COLORREF caption_color( HWND hwnd, int index )
+{
+    static const WCHAR captionW[] = {'_','_','w','i','n','e','_','c','a','p','t','i','o','n','_','c','o','l','o','r',0};
+    static const WCHAR textW[] = {'_','_','w','i','n','e','_','c','a','p','t','i','o','n','_','t','e','x','t',0};
+    ULONG_PTR custom = 0;
+
+    if (!hwnd) return get_sys_color( index );
+    switch (index)
+    {
+    case COLOR_ACTIVECAPTION: case COLOR_GRADIENTACTIVECAPTION:
+    case COLOR_INACTIVECAPTION: case COLOR_GRADIENTINACTIVECAPTION:
+        custom = (ULONG_PTR)NtUserGetProp( hwnd, captionW );
+        break;
+    case COLOR_CAPTIONTEXT: case COLOR_INACTIVECAPTIONTEXT:
+        custom = (ULONG_PTR)NtUserGetProp( hwnd, textW );
+        break;
+    }
+    if (custom) return (COLORREF)(custom - 1);
+    if (!caption_is_dark( hwnd )) return get_sys_color( index );
+    switch (index)
+    {
+    case COLOR_ACTIVECAPTION: case COLOR_GRADIENTACTIVECAPTION: case COLOR_ACTIVEBORDER:
+        return RGB(0x20,0x20,0x20);
+    case COLOR_INACTIVECAPTION: case COLOR_GRADIENTINACTIVECAPTION: case COLOR_INACTIVEBORDER:
+    case COLOR_3DFACE:
+        return RGB(0x2b,0x2b,0x2b);
+    case COLOR_CAPTIONTEXT: return RGB(0xff,0xff,0xff);
+    case COLOR_INACTIVECAPTIONTEXT: return RGB(0xaa,0xaa,0xaa);
+    case COLOR_GRAYTEXT: return RGB(0x6e,0x6e,0x6e);
+    }
+    return get_sys_color( index );
+}
+
+/* a brush for caption_color(), to be deleted with delete_caption_brush() */
+static HBRUSH caption_brush( HWND hwnd, int index )
+{
+    if (!hwnd || (!caption_is_dark( hwnd ) && caption_color( hwnd, index ) == get_sys_color( index )))
+        return get_sys_color_brush( index );
+    return NtGdiCreateSolidBrush( caption_color( hwnd, index ), NULL );
+}
+
+static void delete_caption_brush( HWND hwnd, int index, HBRUSH brush )
+{
+    if (brush != get_sys_color_brush( index )) NtGdiDeleteObjectApp( brush );
+}
