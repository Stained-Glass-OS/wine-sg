From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: GetConsoleKeyboardLayoutNameA/W

The stub said TRUE and wrote nothing, so the caller read garbage. The console's input locale
identifier, eight hex digits: the active layout (the first preloaded one, which win32u keeps current),
else the user's language. Gate: test/conkl-gate.sh. Mutant: SG_MUTANT_CONKL_STUB.
---
--- a/dlls/kernel32/console.c
+++ b/dlls/kernel32/console.c
@@ -35,6 +35,7 @@
 #include "winternl.h"
 #include "winnls.h"
 #include "winerror.h"
+#include "winreg.h"
 #include "wincon.h"
 #include "wine/condrv.h"
 #include "wine/debug.h"
@@ -42,6 +43,10 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(console);
 
+#ifndef KL_NAMELENGTH
+#define KL_NAMELENGTH 9
+#endif
+
 /******************************************************************
  *		OpenConsoleW            (KERNEL32.@)
  *
@@ -118,20 +123,63 @@
 /***********************************************************************
  *            GetConsoleKeyboardLayoutNameA   (KERNEL32.@)
  */
+BOOL WINAPI GetConsoleKeyboardLayoutNameW(LPWSTR layoutName);
+
 BOOL WINAPI GetConsoleKeyboardLayoutNameA(LPSTR layoutName)
 {
-    FIXME( "stub %p\n", layoutName);
+    WCHAR name[KL_NAMELENGTH];
+
+    if (!layoutName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!GetConsoleKeyboardLayoutNameW( name )) return FALSE;
+    WideCharToMultiByte( CP_ACP, 0, name, -1, layoutName, KL_NAMELENGTH, NULL, NULL );
     return TRUE;
 }
 
 /***********************************************************************
  *            GetConsoleKeyboardLayoutNameW   (KERNEL32.@)
+ *
+ * Stained Glass OS (wine-sg 9711): the console's input locale identifier, eight hex digits ("00000409").
+ * The stub said TRUE and wrote nothing (the caller read garbage). The console's layout is the person's
+ * active one: the first preloaded layout (HKCU\Keyboard Layout\Preload\1, which win32u keeps as the
+ * current one), else the user's language with its default layout.
  */
 BOOL WINAPI GetConsoleKeyboardLayoutNameW(LPWSTR layoutName)
 {
-    static int once;
-    if (!once++)
-        FIXME( "stub %p\n", layoutName);
+    WCHAR value[KL_NAMELENGTH + 8];
+    DWORD size = sizeof(value), type;
+    HKEY key;
+    BOOL found = FALSE;
+
+    TRACE( "%p\n", layoutName );
+    if (!layoutName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#ifndef SG_MUTANT_CONKL_STUB
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, L"Keyboard Layout\\Preload", 0, KEY_QUERY_VALUE, &key ))
+    {
+        if (!RegQueryValueExW( key, L"1", NULL, &type, (BYTE *)value, &size ) && type == REG_SZ &&
+            size >= 8 * sizeof(WCHAR))
+        {
+            value[8] = 0;
+            found = TRUE;
+        }
+        RegCloseKey( key );
+    }
+    if (!found)
+    {
+        static const WCHAR hex[] = L"0123456789ABCDEF";
+        DWORD id = LANGIDFROMLCID( GetUserDefaultLCID() ), i;
+        for (i = 0; i < 8; i++) value[i] = hex[(id >> (28 - 4 * i)) & 0xf];
+        value[8] = 0;
+    }
+    lstrcpynW( layoutName, value, KL_NAMELENGTH );
+#endif
     return TRUE;
 }
 
