+/* a key frame at a key, in order, replacing one at the same key */
+static HRESULT insert_keyframe( struct animation *impl, float key, const float *value, enum keyframe_source source,
+                                ICompositionEasingFunction *function )
+{
+    struct keyframe frame = { key }, *frames;
+    HRESULT hr;
+    UINT i;
+
+    TRACE( "animation %p, key %f, source %u, function %p.\n", impl, key, source, function );
+    if (!(key >= 0.0f && key <= 1.0f)) return E_INVALIDARG;
+    if (FAILED(hr = easing_from_iface( function, &frame.easing ))) return hr;
+    if (value) memcpy( frame.value, value, sizeof(frame.value) );
+    frame.source = source;
+
+    compositor_lock( impl->compositor );
+    for (i = 0; i < impl->count && impl->frames[i].key < key; i++) ;
+    if (i < impl->count && impl->frames[i].key == key) impl->frames[i] = frame;
+    else
+    {
+        if (impl->count == impl->capacity)
+        {
+            UINT capacity = max( 4, impl->capacity * 2 );
+            if (!(frames = realloc( impl->frames, capacity * sizeof(*frames) )))
+            {
+                compositor_unlock( impl->compositor );
+                return E_OUTOFMEMORY;
+            }
+            impl->frames = frames;
+            impl->capacity = capacity;
+        }
+        memmove( impl->frames + i + 1, impl->frames + i, (impl->count - i) * sizeof(*impl->frames) );
+        impl->frames[i] = frame;
+        impl->count++;
+    }
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
+
+/* the expressions a key frame can name without an expression evaluator */
+static HRESULT insert_expression_keyframe( struct animation *impl, float key, HSTRING expression,
+                                           ICompositionEasingFunction *function )
+{
+    WCHAR *text, *start, *end;
+    float value[4] = { 0 };
+    enum keyframe_source source = KEYFRAME_HOLD;
+    HRESULT hr;
+
+    if (!WindowsGetStringLen( expression )) return E_INVALIDARG;
+    if (!(text = hstring_dup( expression ))) return E_OUTOFMEMORY;
+    for (start = text; *start == ' '; start++) ;
+    end = start + wcslen( start );
+    while (end > start && end[-1] == ' ') *--end = 0;
+    if (!wcsicmp( start, L"this.StartingValue" ) || !wcsicmp( start, L"this.CurrentValue" )
+            || !wcsicmp( start, L"this.FinalValue" ))
+        source = KEYFRAME_STARTING_VALUE;
+    else if (impl->kind == ANIM_SCALAR)
+    {
+        WCHAR *stop;
+        value[0] = wcstod( start, &stop );
+        if (stop != start && !*stop) source = KEYFRAME_VALUE;
+    }
+    if (source == KEYFRAME_HOLD) FIXME( "expression %s not evaluated.\n", debugstr_w( start ) );
+    hr = insert_keyframe( impl, key, value, source, function );
+    free( text );
+    return hr;
+}
