+DEFINE_COMPOSITION_OBJECT( batch, struct batch, ICompositionScopedBatch_iface )
+
+static struct batch *batch_alloc( struct compositor *compositor, BOOL commit, CompositionBatchTypes type )
+{
+    struct batch *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->ICompositionScopedBatch_iface.lpVtbl = &scoped_batch_vtbl;
+    impl->ICompositionCommitBatch_iface.lpVtbl = &commit_batch_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &batch_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &batch_closable_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->commit = commit;
+    impl->type = type;
+    list_init( &impl->handlers );
+    return impl;
+}
+
+HRESULT scoped_batch_create( struct compositor *compositor, CompositionBatchTypes type, ICompositionScopedBatch **out )
+{
+    struct anim_clock *clock;
+    struct batch *impl;
+
+    if (!(impl = batch_alloc( compositor, FALSE, type ))) return E_OUTOFMEMORY;
+    compositor_lock( compositor );
+    if (!(clock = get_clock( compositor )))
+    {
+        compositor_unlock( compositor );
+        ICompositionScopedBatch_Release( &impl->ICompositionScopedBatch_iface );
+        return E_OUTOFMEMORY;
+    }
+    /* open until End */
+    ICompositionScopedBatch_AddRef( &impl->ICompositionScopedBatch_iface );
+    list_add_tail( &clock->scoped, &impl->entry );
+    compositor_unlock( compositor );
+    *out = &impl->ICompositionScopedBatch_iface;
+    return S_OK;
+}
