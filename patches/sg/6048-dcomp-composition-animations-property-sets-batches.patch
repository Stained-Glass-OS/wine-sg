+/* an object's Properties: made when first asked for, the same set after */
+HRESULT object_get_properties( struct compositor *compositor, ICompositionPropertySet **slot,
+                               ICompositionPropertySet **value )
+{
+    ICompositionPropertySet *set;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_PROPERTIES_NEW_EACH_TIME
+    return property_set_create( compositor, value );
+#endif
+    if (!*slot)
+    {
+        if (FAILED(hr = property_set_create( compositor, &set ))) return hr;
+        if (InterlockedCompareExchangePointer( (void **)slot, set, NULL ))
+            ICompositionPropertySet_Release( set );
+    }
+    *value = *slot;
+    ICompositionPropertySet_AddRef( *value );
+    return S_OK;
+}
