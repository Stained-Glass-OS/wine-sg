+/***********************************************************************
+ *          Batches
+ */
+
+struct batch_handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs *handler;
+};
+
+struct batch
+{
+    ICompositionScopedBatch ICompositionScopedBatch_iface;
+    ICompositionCommitBatch ICompositionCommitBatch_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionPropertySet *properties;
+    BOOL commit;
+    CompositionBatchTypes type;
+    BOOL ended, suspended, fired, queued;
+    LONG pending;               /* animations of it still running */
+    struct list entry;          /* an open scoped batch, in the clock's */
+    struct list queue_entry;    /* to be looked at on the compositor's thread */
+    struct list handlers;
+    INT64 next_token;
+};
+
+/* what a compositor's animations need: what runs, the open batches */
+struct anim_clock
+{
+    struct list running;
+    struct list scoped;         /* open scoped batches, referenced */
+    struct batch *commit;       /* the frame's commit batch, referenced */
+    struct list queue;          /* batches to look at, referenced */
+    UINT64 frame;               /* commits drawn */
+};
+
+static struct anim_clock *get_clock( struct compositor *compositor )
+{
+    struct anim_clock **clock = compositor_clock( compositor );
+
+    if (!*clock && (*clock = calloc( 1, sizeof(**clock) )))
+    {
+        list_init( &(*clock)->running );
+        list_init( &(*clock)->scoped );
+        list_init( &(*clock)->queue );
+    }
+    return *clock;
+}
+
+static const struct ICompositionScopedBatchVtbl scoped_batch_vtbl;
+
+static struct batch *impl_from_ICompositionScopedBatch( ICompositionScopedBatch *iface )
+{
+    return CONTAINING_RECORD( iface, struct batch, ICompositionScopedBatch_iface );
+}
+
+/* under the compositor's lock: once ended with nothing running, its handlers are called */
+static void batch_check( struct anim_clock *clock, struct batch *batch )
+{
+    if (!batch->ended || batch->pending || batch->fired || batch->queued) return;
+    batch->queued = TRUE;
+    ICompositionScopedBatch_AddRef( &batch->ICompositionScopedBatch_iface );
+    list_add_tail( &clock->queue, &batch->queue_entry );
+}
+
+static HRESULT WINAPI scoped_batch_QueryInterface( ICompositionScopedBatch *iface, REFIID iid, void **out )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = impl->commit ? (void *)&impl->ICompositionCommitBatch_iface : (void *)&impl->ICompositionScopedBatch_iface;
+    else if (!impl->commit && IsEqualGUID( iid, &IID_ICompositionScopedBatch ))
+        *out = &impl->ICompositionScopedBatch_iface;
+    else if (impl->commit && IsEqualGUID( iid, &IID_ICompositionCommitBatch ))
+        *out = &impl->ICompositionCommitBatch_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI scoped_batch_AddRef( ICompositionScopedBatch *iface )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI scoped_batch_Release( ICompositionScopedBatch *iface )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct batch_handler *handler, *next;
+
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( handler, next, &impl->handlers, struct batch_handler, entry )
+        {
+            ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Release( handler->handler );
+            free( handler );
+        }
+        object_release_properties( impl->properties );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI scoped_batch_GetIids( ICompositionScopedBatch *iface, ULONG *iid_count, IID **iids )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+    const IID *list[] = { &IID_ICompositionScopedBatch, &IID_ICompositionObject, &IID_IClosable };
+    if (impl->commit) list[0] = &IID_ICompositionCommitBatch;
+    return iid_list( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI scoped_batch_GetRuntimeClassName( ICompositionScopedBatch *iface, HSTRING *name )
+{
+    return class_name( impl_from_ICompositionScopedBatch( iface )->commit ? class_commit_batch : class_scoped_batch, name );
+}
+
+static HRESULT WINAPI scoped_batch_GetTrustLevel( ICompositionScopedBatch *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT batch_get_IsActive( struct batch *impl, boolean *value )
+{
+    if (!value) return E_POINTER;
+    compositor_lock( impl->compositor );
+    *value = !impl->ended && !impl->suspended;
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT batch_get_IsEnded( struct batch *impl, boolean *value )
+{
+    if (!value) return E_POINTER;
+    compositor_lock( impl->compositor );
+    *value = impl->ended;
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT batch_add_Completed( struct batch *impl,
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs *handler, EventRegistrationToken *token )
+{
+    struct batch_handler *entry;
+
+    TRACE( "batch %p, handler %p, token %p.\n", impl, handler, token );
+    if (!handler) return E_INVALIDARG;
+    if (!token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_AddRef( entry->handler = handler );
+    compositor_lock( impl->compositor );
+    entry->token.value = token->value = ++impl->next_token;
+    list_add_tail( &impl->handlers, &entry->entry );
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT batch_remove_Completed( struct batch *impl, EventRegistrationToken token )
+{
+    struct batch_handler *entry, *found = NULL;
+
+    compositor_lock( impl->compositor );
+    LIST_FOR_EACH_ENTRY( entry, &impl->handlers, struct batch_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    compositor_unlock( impl->compositor );
+    if (found)
+    {
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI scoped_batch_get_IsActive( ICompositionScopedBatch *iface, boolean *value )
+{
+    return batch_get_IsActive( impl_from_ICompositionScopedBatch( iface ), value );
+}
+
+static HRESULT WINAPI scoped_batch_get_IsEnded( ICompositionScopedBatch *iface, boolean *value )
+{
+    return batch_get_IsEnded( impl_from_ICompositionScopedBatch( iface ), value );
+}
+
+static HRESULT WINAPI scoped_batch_End( ICompositionScopedBatch *iface )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+    struct anim_clock *clock;
+
+    TRACE( "iface %p.\n", iface );
+    compositor_lock( impl->compositor );
+    if (impl->ended || !(clock = get_clock( impl->compositor )))
+    {
+        compositor_unlock( impl->compositor );
+        return S_OK;
+    }
+#ifdef SG_MUTANT_BATCH_NEVER_ENDS
+    compositor_unlock( impl->compositor );
+    return S_OK;
+#endif
+    impl->ended = TRUE;
+    list_remove( &impl->entry );
+    /* the open list's reference goes to the queue: what has finished is told of there */
+    impl->queued = TRUE;
+    list_add_tail( &clock->queue, &impl->queue_entry );
+    compositor_unlock( impl->compositor );
+    compositor_wake( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI scoped_batch_Resume( ICompositionScopedBatch *iface )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+    HRESULT hr = S_OK;
+
+    compositor_lock( impl->compositor );
+    if (impl->ended) hr = E_ILLEGAL_METHOD_CALL;
+    else impl->suspended = FALSE;
+    compositor_unlock( impl->compositor );
+    return hr;
+}
+
+static HRESULT WINAPI scoped_batch_Suspend( ICompositionScopedBatch *iface )
+{
+    struct batch *impl = impl_from_ICompositionScopedBatch( iface );
+    HRESULT hr = S_OK;
+
+    compositor_lock( impl->compositor );
+    if (impl->ended) hr = E_ILLEGAL_METHOD_CALL;
+    else impl->suspended = TRUE;
+    compositor_unlock( impl->compositor );
+    return hr;
+}
+
+static HRESULT WINAPI scoped_batch_add_Completed( ICompositionScopedBatch *iface,
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs *handler, EventRegistrationToken *token )
+{
+    return batch_add_Completed( impl_from_ICompositionScopedBatch( iface ), handler, token );
+}
+
+static HRESULT WINAPI scoped_batch_remove_Completed( ICompositionScopedBatch *iface, EventRegistrationToken token )
+{
+    return batch_remove_Completed( impl_from_ICompositionScopedBatch( iface ), token );
+}
+
+static const struct ICompositionScopedBatchVtbl scoped_batch_vtbl =
+{
+    scoped_batch_QueryInterface, scoped_batch_AddRef, scoped_batch_Release,
