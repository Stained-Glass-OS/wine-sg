+HRESULT expression_animation_create( struct compositor *compositor, HSTRING expression, IExpressionAnimation **out )
+{
+    struct animation *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = animation_create( compositor, ANIM_NONE, &expression_vtbl, &impl ))) return hr;
+    if (expression && FAILED(hr = WindowsDuplicateString( expression, &impl->expression )))
+    {
+        ICompositionAnimation_Release( &impl->ICompositionAnimation_iface );
+        return hr;
+    }
+    *out = (IExpressionAnimation *)&impl->typed_iface;
