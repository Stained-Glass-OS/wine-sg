+/* the kinds of values properties and animations hold */
+enum anim_kind
+{
+    ANIM_NONE,
+    ANIM_SCALAR,
+    ANIM_VECTOR2,
+    ANIM_VECTOR3,
+    ANIM_VECTOR4,
+    ANIM_COLOR,
+    ANIM_QUATERNION,
+    ANIM_MATRIX3X2,
+    ANIM_MATRIX4X4,
+    ANIM_BOOLEAN,
+};
+
+/* an animatable property of an object, by name, in a table */
+struct anim_member
+{
+    const WCHAR *name;
+    enum anim_kind kind;
+    size_t offset;
+    float factor;               /* the stored value is the animated one times this, 0 for 1 */
+};
+
+/* where an animation's values go: a property, or some of its components ("Offset.X") */
+struct anim_property
+{
+    enum anim_kind kind;        /* of the animated value */
+    enum anim_kind base_kind;   /* of the property */
+    void *data;
+    BYTE comp[4];
+    UINT comp_count;            /* 0: the whole value */
+    float factor;
+};
+
+typedef BOOL (*animatable_fn)( void *impl, const WCHAR *name, struct anim_property *prop );
+
+BOOL anim_resolve( void *impl, const struct anim_member *table, UINT count, const WCHAR *name,
+                   struct anim_property *prop );
+BOOL anim_none( void *impl, const WCHAR *name, struct anim_property *prop );
