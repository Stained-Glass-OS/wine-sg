+static HRESULT animation_create( struct compositor *compositor, enum anim_kind kind, const void *typed_vtbl,
+                                 struct animation **out )
+{
+    struct animation *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->typed_iface.lpVtbl = (void *)typed_vtbl;
+    impl->IKeyFrameAnimation_iface.lpVtbl = &keyframe_vtbl;
+    impl->ICompositionAnimation_iface.lpVtbl = &animation_vtbl;
+    impl->ICompositionAnimationBase_iface.lpVtbl = &animation_base_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &animation_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &animation_closable_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->kind = kind;
+    impl->duration.Duration = 10000000;     /* a second */
+    impl->iteration_behavior = AnimationIterationBehavior_Count;
+    impl->iteration_count = 1;
+    impl->stop_behavior = AnimationStopBehavior_SetToFinalValue;
+    list_init( &impl->parameters );
+    *out = impl;
+    return S_OK;
+}
