+/*
+ * A started key frame animation is copied: changing the animation object
+ * afterwards does not change what runs. The compositor's thread steps what
+ * runs on a timer, writes each value into the animated property (a visual's,
+ * a brush's, a clip's, or a property set's) and asks for a commit, so the
+ * next frame is drawn with it. A batch -- a scoped one between its creation
+ * and End, or the commit batch of the frame being built -- collects the
+ * animations started while it is open; once it has ended and they have all
+ * finished, its Completed handlers are called on the compositor's thread.
+ *
+ * Expression animations keep their expression and parameters, but are not
+ * evaluated yet.
+ */
+
+#include <math.h>
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objidl.h"
+#include "composition_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+static const WCHAR class_property_set[] = L"Windows.UI.Composition.CompositionPropertySet";
+static const WCHAR class_linear_easing[] = L"Windows.UI.Composition.LinearEasingFunction";
+static const WCHAR class_cubic_easing[] = L"Windows.UI.Composition.CubicBezierEasingFunction";
+static const WCHAR class_expression[] = L"Windows.UI.Composition.ExpressionAnimation";
+static const WCHAR class_scoped_batch[] = L"Windows.UI.Composition.CompositionScopedBatch";
+static const WCHAR class_commit_batch[] = L"Windows.UI.Composition.CompositionCommitBatch";
+static const WCHAR class_batch_args[] = L"Windows.UI.Composition.CompositionBatchCompletedEventArgs";
+
+static HRESULT class_name( const WCHAR *name, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), out );
+}
+
+static HRESULT iid_list( ULONG *iid_count, IID **iids, const IID *const *list, ULONG count )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) (*iids)[i] = *list[i];
+    *iid_count = count;
+    return S_OK;
+}
+
+static WCHAR *hstring_dup( HSTRING str )
+{
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( str, &len );
+    WCHAR *ret;
+
+    if (!(ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, buf, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+/***********************************************************************
+ *          Values
+ */
+
+static UINT kind_size( enum anim_kind kind )
+{
+    switch (kind)
+    {
+    case ANIM_SCALAR: return 1;
+    case ANIM_VECTOR2: return 2;
+    case ANIM_VECTOR3: return 3;
+    case ANIM_VECTOR4:
+    case ANIM_COLOR:
+    case ANIM_QUATERNION: return 4;
+    case ANIM_MATRIX3X2: return 6;
+    case ANIM_MATRIX4X4: return 16;
+    default: return 0;
+    }
+}
+
+/* ".X", ".YZ": some components of a vector or quaternion */
+static BOOL resolve_components( const WCHAR *dot, struct anim_property *prop )
+{
+    static const enum anim_kind kinds[] = { ANIM_NONE, ANIM_SCALAR, ANIM_VECTOR2, ANIM_VECTOR3, ANIM_VECTOR4 };
+    UINT size = kind_size( prop->base_kind ), i;
+
+    prop->kind = prop->base_kind;
+    prop->comp_count = 0;
+    if (!dot) return TRUE;
+    if (prop->base_kind != ANIM_VECTOR2 && prop->base_kind != ANIM_VECTOR3 && prop->base_kind != ANIM_VECTOR4
+            && prop->base_kind != ANIM_QUATERNION)
+        return FALSE;
+    for (i = 0, dot++; dot[i]; i++)
+    {
+        WCHAR c = towupper( dot[i] );
+        UINT index = c == 'W' ? 3 : c - 'X';
+
+        if (i >= 4 || c < 'W' || c > 'Z' || index >= size) return FALSE;
+        prop->comp[i] = index;
+    }
+    if (!i) return FALSE;
+    prop->comp_count = i;
+    prop->kind = kinds[i];
+    return TRUE;
+}
+
+BOOL anim_resolve( void *impl, const struct anim_member *table, UINT count, const WCHAR *name,
+                   struct anim_property *prop )
+{
+    const WCHAR *dot = wcschr( name, '.' );
+    size_t len = dot ? dot - name : wcslen( name );
+    UINT i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (wcslen( table[i].name ) != len || wcsnicmp( table[i].name, name, len )) continue;
+        prop->base_kind = table[i].kind;
+        prop->data = (char *)impl + table[i].offset;
+        prop->factor = table[i].factor;
+        return resolve_components( dot, prop );
+    }
+    return FALSE;
+}
+
+BOOL anim_none( void *impl, const WCHAR *name, struct anim_property *prop )
+{
+    return FALSE;
+}
+
+static void prop_read( const struct anim_property *prop, float out[4] )
+{
+    float full[16] = { 0 };
+    UINT i, size = prop->comp_count ? prop->comp_count : kind_size( prop->kind );
+
+    if (prop->base_kind == ANIM_COLOR)
+    {
+        const Color *color = prop->data;
+        full[0] = color->A; full[1] = color->R; full[2] = color->G; full[3] = color->B;
+    }
+    else memcpy( full, prop->data, kind_size( prop->base_kind ) * sizeof(float) );
+    for (i = 0; i < size && i < 4; i++)
+    {
+        out[i] = prop->comp_count ? full[prop->comp[i]] : full[i];
+        if (prop->factor) out[i] /= prop->factor;
+    }
+}
+
+static BYTE color_byte( float v )
+{
+    if (v <= 0.0f) return 0;
+    if (v >= 255.0f) return 255;
+    return (BYTE)(v + 0.5f);
+}
+
+static void prop_write( const struct anim_property *prop, const float in[4] )
+{
+    UINT i, size = prop->comp_count ? prop->comp_count : kind_size( prop->kind );
+    float *data = prop->data;
+
+    if (prop->base_kind == ANIM_COLOR)
+    {
+        Color *color = prop->data;
+        color->A = color_byte( in[0] ); color->R = color_byte( in[1] );
+        color->G = color_byte( in[2] ); color->B = color_byte( in[3] );
+        return;
+    }
+    for (i = 0; i < size && i < 4; i++)
+    {
+        float v = prop->factor ? in[i] * prop->factor : in[i];
+        data[prop->comp_count ? prop->comp[i] : i] = v;
+    }
+}
+
+/***********************************************************************
+ *          Easing functions
+ */
+
+enum easing_type
+{
+    EASING_LINEAR,
+    EASING_CUBIC_BEZIER,
+};
+
+struct easing
+{
+    enum easing_type type;
+    Vector2 p1, p2;
+};
+
+static float bezier( float a, float b, float t )
+{
+    float u = 1.0f - t;
+    return 3.0f * u * u * t * a + 3.0f * u * t * t * b + t * t * t;
+}
+
+/* the eased progress through a key frame */
+static float ease( const struct easing *easing, float x )
+{
+    float lo = 0.0f, hi = 1.0f, t = x;
+    int i;
+
+#ifdef SG_MUTANT_EASING_LINEAR
+    return x;
+#endif
+    if (x <= 0.0f) return 0.0f;
+    if (x >= 1.0f) return 1.0f;
+    if (easing->type == EASING_LINEAR) return x;
+    /* the curve's x rises from 0 to 1: find its t for this x, then its y */
+    for (i = 0; i < 40; i++)
+    {
+        t = (lo + hi) / 2.0f;
+        if (bezier( easing->p1.X, easing->p2.X, t ) < x) lo = t;
+        else hi = t;
+    }
+    return bezier( easing->p1.Y, easing->p2.Y, t );
+}
+
+struct easing_function
+{
+    ICompositionEasingFunction ICompositionEasingFunction_iface;
+    ILinearEasingFunction ILinearEasingFunction_iface;
+    ICubicBezierEasingFunction ICubicBezierEasingFunction_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionPropertySet *properties;
+    struct easing easing;
+};
+
+static const struct ICompositionEasingFunctionVtbl easing_vtbl;
+
+static struct easing_function *impl_from_ICompositionEasingFunction( ICompositionEasingFunction *iface )
+{
+    return CONTAINING_RECORD( iface, struct easing_function, ICompositionEasingFunction_iface );
+}
+
+static HRESULT WINAPI easing_QueryInterface( ICompositionEasingFunction *iface, REFIID iid, void **out )
+{
+    struct easing_function *impl = impl_from_ICompositionEasingFunction( iface );
+    BOOL cubic = impl->easing.type == EASING_CUBIC_BEZIER;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = cubic ? (void *)&impl->ICubicBezierEasingFunction_iface : (void *)&impl->ILinearEasingFunction_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionEasingFunction ))
+        *out = &impl->ICompositionEasingFunction_iface;
+    else if (!cubic && IsEqualGUID( iid, &IID_ILinearEasingFunction ))
+        *out = &impl->ILinearEasingFunction_iface;
+    else if (cubic && IsEqualGUID( iid, &IID_ICubicBezierEasingFunction ))
+        *out = &impl->ICubicBezierEasingFunction_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI easing_AddRef( ICompositionEasingFunction *iface )
+{
+    struct easing_function *impl = impl_from_ICompositionEasingFunction( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI easing_Release( ICompositionEasingFunction *iface )
+{
+    struct easing_function *impl = impl_from_ICompositionEasingFunction( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        object_release_properties( impl->properties );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI easing_GetIids( ICompositionEasingFunction *iface, ULONG *iid_count, IID **iids )
+{
+    struct easing_function *impl = impl_from_ICompositionEasingFunction( iface );
+    const IID *list[] = { &IID_ILinearEasingFunction, &IID_ICompositionEasingFunction, &IID_ICompositionObject,
+                          &IID_IClosable };
+    if (impl->easing.type == EASING_CUBIC_BEZIER) list[0] = &IID_ICubicBezierEasingFunction;
+    return iid_list( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI easing_GetRuntimeClassName( ICompositionEasingFunction *iface, HSTRING *name )
+{
+    struct easing_function *impl = impl_from_ICompositionEasingFunction( iface );
+    return class_name( impl->easing.type == EASING_CUBIC_BEZIER ? class_cubic_easing : class_linear_easing, name );
+}
+
+static HRESULT WINAPI easing_GetTrustLevel( ICompositionEasingFunction *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const struct ICompositionEasingFunctionVtbl easing_vtbl =
+{
+    easing_QueryInterface, easing_AddRef, easing_Release,
+    easing_GetIids, easing_GetRuntimeClassName, easing_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE( linear_easing, ILinearEasingFunction, struct easing_function, ICompositionEasingFunction_iface )
+
+static const struct ILinearEasingFunctionVtbl linear_easing_vtbl =
+{
+    linear_easing_QueryInterface, linear_easing_AddRef, linear_easing_Release,
+    linear_easing_GetIids, linear_easing_GetRuntimeClassName, linear_easing_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE( cubic_easing, ICubicBezierEasingFunction, struct easing_function, ICompositionEasingFunction_iface )
+
+static HRESULT WINAPI cubic_easing_get_ControlPoint1( ICubicBezierEasingFunction *iface, Vector2 *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICubicBezierEasingFunction( iface )->easing.p1;
+    return S_OK;
+}
+
+static HRESULT WINAPI cubic_easing_get_ControlPoint2( ICubicBezierEasingFunction *iface, Vector2 *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICubicBezierEasingFunction( iface )->easing.p2;
+    return S_OK;
+}
+
+static const struct ICubicBezierEasingFunctionVtbl cubic_easing_vtbl =
+{
+    cubic_easing_QueryInterface, cubic_easing_AddRef, cubic_easing_Release,
+    cubic_easing_GetIids, cubic_easing_GetRuntimeClassName, cubic_easing_GetTrustLevel,
+    cubic_easing_get_ControlPoint1, cubic_easing_get_ControlPoint2,
+};
+
+DEFINE_COMPOSITION_OBJECT( easing, struct easing_function, ICompositionEasingFunction_iface )
+
+static HRESULT easing_create( struct compositor *compositor, const struct easing *easing,
+                              struct easing_function **out )
+{
+    struct easing_function *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICompositionEasingFunction_iface.lpVtbl = &easing_vtbl;
+    impl->ILinearEasingFunction_iface.lpVtbl = &linear_easing_vtbl;
+    impl->ICubicBezierEasingFunction_iface.lpVtbl = &cubic_easing_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &easing_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &easing_closable_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    impl->easing = *easing;
+    *out = impl;
+    return S_OK;
+}
+
+HRESULT linear_easing_create( struct compositor *compositor, ILinearEasingFunction **out )
+{
+    struct easing easing = { EASING_LINEAR };
+    struct easing_function *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = easing_create( compositor, &easing, &impl ))) return hr;
+    *out = &impl->ILinearEasingFunction_iface;
+    return S_OK;
+}
+
+HRESULT cubic_bezier_easing_create( struct compositor *compositor, Vector2 p1, Vector2 p2,
+                                    ICubicBezierEasingFunction **out )
+{
+    struct easing easing = { EASING_CUBIC_BEZIER, p1, p2 };
+    struct easing_function *impl;
+    HRESULT hr;
+
+    /* the curve must go forward in time */
+    if (p1.X < 0.0f || p1.X > 1.0f || p2.X < 0.0f || p2.X > 1.0f) return E_INVALIDARG;
+    if (FAILED(hr = easing_create( compositor, &easing, &impl ))) return hr;
+    *out = &impl->ICubicBezierEasingFunction_iface;
+    return S_OK;
+}
+
+/* a key frame's easing: ours, or linear */
+static HRESULT easing_from_iface( ICompositionEasingFunction *iface, struct easing *easing )
+{
+    easing->type = EASING_LINEAR;
+    if (!iface) return S_OK;
+    if (iface->lpVtbl != &easing_vtbl) return E_INVALIDARG;
+    *easing = impl_from_ICompositionEasingFunction( iface )->easing;
+    return S_OK;
+}
+
+/***********************************************************************
+ *          Property sets
+ */
+
+struct property
+{
+    struct list entry;
+    WCHAR *name;
+    enum anim_kind kind;
+    union
+    {
+        float f[16];
+        Color color;
+        boolean flag;
+    } value;
+};
+
+struct property_set
+{
+    ICompositionPropertySet ICompositionPropertySet_iface;
+    ICompositionPropertySet2 ICompositionPropertySet2_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+    ICompositionPropertySet *properties;
+    struct list entries;
+};
+
+static const struct ICompositionPropertySetVtbl property_set_vtbl;
+
+static struct property_set *impl_from_ICompositionPropertySet( ICompositionPropertySet *iface )
+{
+    return CONTAINING_RECORD( iface, struct property_set, ICompositionPropertySet_iface );
+}
+
+static struct property *find_property( struct property_set *set, const WCHAR *name, size_t len )
+{
+    struct property *property;
+
+    LIST_FOR_EACH_ENTRY( property, &set->entries, struct property, entry )
+        if (wcslen( property->name ) == len && !wcsncmp( property->name, name, len )) return property;
+    return NULL;
+}
+
+/* a property set's entries are animated by name, like an object's properties */
+static BOOL property_set_animatable( void *impl, const WCHAR *name, struct anim_property *prop )
+{
+    struct property_set *set = impl;
+    const WCHAR *dot = wcschr( name, '.' );
+    struct property *property;
+
+    if (!(property = find_property( set, name, dot ? dot - name : wcslen( name ) ))) return FALSE;
+    prop->base_kind = property->kind;
+    prop->data = &property->value;
+    prop->factor = 0;
+    return resolve_components( dot, prop );
+}
+
+static HRESULT property_insert( struct property_set *set, HSTRING name, enum anim_kind kind, const void *value,
+                                size_t size )
+{
+    struct property *property;
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( name, &len );
+
+    if (!len) return E_INVALIDARG;
+    compositor_lock( set->compositor );
+    if (!(property = find_property( set, buf, len )))
+    {
+        if (!(property = calloc( 1, sizeof(*property) )) || !(property->name = hstring_dup( name )))
+        {
+            compositor_unlock( set->compositor );
+            free( property );
+            return E_OUTOFMEMORY;
+        }
+        list_add_tail( &set->entries, &property->entry );
+    }
+    property->kind = kind;
+    memset( &property->value, 0, sizeof(property->value) );
+    memcpy( &property->value, value, size );
+    compositor_unlock( set->compositor );
+    compositor_changed( set->compositor );
+    return S_OK;
+}
+
+static HRESULT property_get( struct property_set *set, HSTRING name, enum anim_kind kind, void *value, size_t size,
+                             CompositionGetValueStatus *status )
+{
+    struct property *property;
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( name, &len );
+
+    if (!value || !status) return E_POINTER;
+    compositor_lock( set->compositor );
+    if (!(property = find_property( set, buf, len ))) *status = CompositionGetValueStatus_NotFound;
+    else if (property->kind != kind) *status = CompositionGetValueStatus_TypeMismatch;
+    else
+    {
+        memcpy( value, &property->value, size );
+        *status = CompositionGetValueStatus_Succeeded;
+    }
+#ifdef SG_MUTANT_PROPSET_NO_TYPECHECK
+    if (property && property->kind != kind)
+    {
+        memcpy( value, &property->value, size );
+        *status = CompositionGetValueStatus_Succeeded;
+    }
+#endif
+    compositor_unlock( set->compositor );
+    if (*status != CompositionGetValueStatus_Succeeded) memset( value, 0, size );
+    return S_OK;
+}
+
+static HRESULT WINAPI property_set_QueryInterface( ICompositionPropertySet *iface, REFIID iid, void **out )
+{
+    struct property_set *impl = impl_from_ICompositionPropertySet( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionPropertySet ))
+        *out = &impl->ICompositionPropertySet_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionPropertySet2 ))
+        *out = &impl->ICompositionPropertySet2_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
