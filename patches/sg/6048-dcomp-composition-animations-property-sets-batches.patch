+
+static HRESULT WINAPI batch_args_QueryInterface( ICompositionBatchCompletedEventArgs *iface, REFIID iid, void **out )
+{
+    struct batch_args *impl = impl_from_ICompositionBatchCompletedEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionBatchCompletedEventArgs ))
+        *out = &impl->ICompositionBatchCompletedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI batch_args_AddRef( ICompositionBatchCompletedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_ICompositionBatchCompletedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI batch_args_Release( ICompositionBatchCompletedEventArgs *iface )
+{
+    struct batch_args *impl = impl_from_ICompositionBatchCompletedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        object_release_properties( impl->properties );
+        ICompositor_Release( (ICompositor *)impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI batch_args_GetIids( ICompositionBatchCompletedEventArgs *iface, ULONG *iid_count, IID **iids )
+{
+    static const IID *const list[] = { &IID_ICompositionBatchCompletedEventArgs, &IID_ICompositionObject,
+                                       &IID_IClosable };
+    return iid_list( iid_count, iids, list, ARRAY_SIZE(list) );
+}
+
+static HRESULT WINAPI batch_args_GetRuntimeClassName( ICompositionBatchCompletedEventArgs *iface, HSTRING *name )
+{
+    return class_name( class_batch_args, name );
+}
+
+static HRESULT WINAPI batch_args_GetTrustLevel( ICompositionBatchCompletedEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const struct ICompositionBatchCompletedEventArgsVtbl batch_args_vtbl =
+{
+    batch_args_QueryInterface, batch_args_AddRef, batch_args_Release,
+    batch_args_GetIids, batch_args_GetRuntimeClassName, batch_args_GetTrustLevel,
+};
+
+DEFINE_COMPOSITION_OBJECT( batch_args, struct batch_args, ICompositionBatchCompletedEventArgs_iface )
+
+static struct batch_args *batch_args_create( struct compositor *compositor )
+{
+    struct batch_args *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->ICompositionBatchCompletedEventArgs_iface.lpVtbl = &batch_args_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &batch_args_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &batch_args_closable_vtbl;
+    impl->ref = 1;
+    impl->compositor = compositor;
+    ICompositor_AddRef( (ICompositor *)compositor );
+    return impl;
+}
+
+/* called on the compositor's thread */
+static void batch_fire( struct batch *batch )
+{
+    ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs **handlers = NULL;
+    struct batch_handler *entry;
+    struct batch_args *args;
+    IInspectable *sender;
+    UINT count = 0, i;
+
+    compositor_lock( batch->compositor );
+    if (batch->ended && !batch->pending && !batch->fired)
+    {
+        batch->fired = TRUE;
+        if ((handlers = calloc( list_count( &batch->handlers ) + 1, sizeof(*handlers) )))
+        {
+            LIST_FOR_EACH_ENTRY( entry, &batch->handlers, struct batch_handler, entry )
+            {
+                ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_AddRef( entry->handler );
+                handlers[count++] = entry->handler;
+            }
+        }
+    }
+    compositor_unlock( batch->compositor );
+    if (!count)
+    {
+        free( handlers );
+        return;
+    }
+
+    TRACE( "batch %p completed, %u handlers.\n", batch, count );
+    sender = batch->commit ? (IInspectable *)&batch->ICompositionCommitBatch_iface
+                           : (IInspectable *)&batch->ICompositionScopedBatch_iface;
+    args = batch_args_create( batch->compositor );
+    for (i = 0; i < count; i++)
+    {
+        if (args)
+            ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Invoke( handlers[i], sender,
+                    &args->ICompositionBatchCompletedEventArgs_iface );
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Release( handlers[i] );
+    }
+    if (args) ICompositionBatchCompletedEventArgs_Release( &args->ICompositionBatchCompletedEventArgs_iface );
+    free( handlers );
+}
+
+/***********************************************************************
+ *          Running animations
+ */
+
+struct running
+{
+    struct list entry;
+    IUnknown *owner;            /* the animated object, referenced */
+    WCHAR *name;
+    struct anim_property prop;
+    float scratch[16];          /* the values of a property the object does not have */
+    enum anim_kind kind;
+    struct keyframe *frames;
+    UINT count;
+    float start[4];             /* the property's value when started */
+    LONGLONG begin, delay, duration;
+    INT32 iterations;           /* 0 for ever */
+    AnimationStopBehavior stop_behavior;
+    UINT64 frame;               /* the commit it was started in */
+    struct batch **batches;     /* referenced */
+    UINT batch_count;
+};
+
+static LONGLONG now_100ns(void)
+{
+    LARGE_INTEGER counter, frequency;
+
+    QueryPerformanceCounter( &counter );
+    QueryPerformanceFrequency( &frequency );
+    return (LONGLONG)((double)counter.QuadPart * 10000000.0 / (double)frequency.QuadPart);
+}
+
+static void slerp( const float *a, const float *b, float t, float *out )
+{
+    float dot = a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3], sign = 1.0f, wa, wb;
+    UINT i;
+
+    if (dot < 0.0f) { dot = -dot; sign = -1.0f; }
+    if (dot > 0.9995f)
+    {
+        wa = 1.0f - t;
+        wb = t;
+    }
+    else
+    {
+        float theta = acosf( dot ), s = sinf( theta );
+        wa = sinf( (1.0f - t) * theta ) / s;
+        wb = sinf( t * theta ) / s;
+    }
+    for (i = 0; i < 4; i++) out[i] = wa * a[i] + sign * wb * b[i];
+}
+
+static void interpolate( const struct running *r, const float *a, const float *b, float t, float *out )
+{
+    UINT i, size = kind_size( r->kind );
+
+    if (r->kind == ANIM_QUATERNION && !r->prop.comp_count)
+    {
+        slerp( a, b, t, out );
+        return;
+    }
+    for (i = 0; i < size; i++) out[i] = a[i] + (b[i] - a[i]) * t;
+}
+
+/* the value at a progress through an iteration */
+static void sample( const struct running *r, float progress, float *out )
+{
+    const float *prev = r->start;
+    float prev_key = 0.0f;
+    UINT i;
+
+    for (i = 0; i < r->count; i++)
+    {
+        const struct keyframe *frame = &r->frames[i];
+        const float *value = frame->source == KEYFRAME_VALUE ? frame->value
+                           : frame->source == KEYFRAME_STARTING_VALUE ? r->start : prev;
+
+        if (progress <= frame->key)
+        {
+            float local = frame->key > prev_key ? (progress - prev_key) / (frame->key - prev_key) : 1.0f;
+            interpolate( r, prev, value, ease( &frame->easing, local ), out );
+            return;
+        }
+        prev = value;
+        prev_key = frame->key;
+    }
+    memcpy( out, prev, 4 * sizeof(float) );
+}
+
+/* its value now; FALSE while it waits for its delay */
+static BOOL running_value( const struct running *r, LONGLONG now, float *out, BOOL *finished )
+{
+    LONGLONG t = now - r->begin - r->delay, iteration;
+    float progress;
+
+    *finished = FALSE;
+    if (t < 0) return FALSE;
+    iteration = t / r->duration;
+    if (r->iterations && iteration >= r->iterations)
+    {
+        *finished = TRUE;
+        progress = 1.0f;
+    }
+    else progress = (float)(t % r->duration) / (float)r->duration;
+#ifdef SG_MUTANT_ANIM_JUMP_TO_END
+    *finished = TRUE;
+    progress = 1.0f;
+#endif
+    sample( r, progress, out );
+    return TRUE;
+}
+
+/* under the lock: it no longer counts for its batches */
+static void running_leave_batches( struct anim_clock *clock, struct running *r )
+{
+    UINT i;
+
+    for (i = 0; i < r->batch_count; i++)
+    {
+        r->batches[i]->pending--;
+        batch_check( clock, r->batches[i] );
+    }
+}
+
+/* outside the lock */
+static void running_free( struct running *r )
+{
+    UINT i;
+
+    for (i = 0; i < r->batch_count; i++) ICompositionScopedBatch_Release( &r->batches[i]->ICompositionScopedBatch_iface );
+    if (r->owner) IUnknown_Release( r->owner );
+    free( r->batches );
+    free( r->frames );
+    free( r->name );
+    free( r );
+}
+
+static void running_join( struct running *r, struct batch *batch )
+{
+    struct batch **batches;
+    BOOL infinite = !r->iterations;
+
+#ifdef SG_MUTANT_BATCH_IGNORES_ANIMATIONS
+    return;
+#endif
+    if (batch->ended || batch->suspended) return;
+    if (!(batch->type & (infinite ? CompositionBatchTypes_InfiniteAnimation : CompositionBatchTypes_Animation))) return;
+    if (!(batches = realloc( r->batches, (r->batch_count + 1) * sizeof(*batches) ))) return;
+    r->batches = batches;
+    batches[r->batch_count++] = batch;
+    ICompositionScopedBatch_AddRef( &batch->ICompositionScopedBatch_iface );
+    batch->pending++;
+}
+
+static struct running *find_running( struct anim_clock *clock, IUnknown *owner, const WCHAR *name )
+{
+    struct running *r;
+
+    LIST_FOR_EACH_ENTRY( r, &clock->running, struct running, entry )
+        if (r->owner == owner && !wcsicmp( r->name, name )) return r;
+    return NULL;
+}
+
+/* under the lock: stops it with its stop behaviour, leaves it in a list to free */
+static void running_stop( struct anim_clock *clock, struct running *r, AnimationStopBehavior behavior,
+                          struct list *freed )
+{
+    float value[4];
+    BOOL finished;
+
+    switch (behavior)
+    {
+    case AnimationStopBehavior_SetToInitialValue:
+        prop_write( &r->prop, r->start );
+        break;
+    case AnimationStopBehavior_SetToFinalValue:
+        sample( r, 1.0f, value );
+        prop_write( &r->prop, value );
+        break;
+    default:
+        if (running_value( r, now_100ns(), value, &finished )) prop_write( &r->prop, value );
+        break;
+    }
+    list_remove( &r->entry );
+    running_leave_batches( clock, r );
+    list_add_tail( freed, &r->entry );
+}
+
+static void free_list( struct list *freed )
+{
+    struct running *r, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( r, next, freed, struct running, entry )
+    {
+        list_remove( &r->entry );
+        running_free( r );
+    }
+}
+
+HRESULT object_start_animation( struct compositor *compositor, IUnknown *owner, animatable_fn animatable,
+                                void *impl, ICompositionPropertySet *properties, HSTRING name,
+                                ICompositionAnimation *animation )
+{
+    struct animation *anim;
+    struct anim_clock *clock;
+    struct running *r, *old;
+    struct list freed = LIST_INIT( freed );
+    struct batch *batch;
+    BOOL found;
+    WCHAR *text;
+
+    TRACE( "owner %p, name %s, animation %p.\n", owner, debugstr_hstring( name ), animation );
+
+    if (!WindowsGetStringLen( name ) || !animation) return E_INVALIDARG;
+    if (animation->lpVtbl != &animation_vtbl) return E_INVALIDARG;
+    anim = impl_from_ICompositionAnimation( animation );
+    if (!(text = hstring_dup( name ))) return E_OUTOFMEMORY;
+    if (!(r = calloc( 1, sizeof(*r) )))
+    {
+        free( text );
+        return E_OUTOFMEMORY;
+    }
+    r->name = text;
+
+    compositor_lock( compositor );
+    if (!(clock = get_clock( compositor )))
+    {
+        compositor_unlock( compositor );
+        running_free( r );
+        return E_OUTOFMEMORY;
+    }
+
+    /* the object's own property, else one in its property set */
+    found = animatable( impl, text, &r->prop );
+    if (!found && properties && properties->lpVtbl == &property_set_vtbl)
+        found = property_set_animatable( impl_from_ICompositionPropertySet( properties ), text, &r->prop );
+    if (!found)
+    {
+        /* a property not here: timed like any other, so its batches end */
+        FIXME( "owner %p has no property %s; timing the animation only.\n", owner, debugstr_w( text ) );
+        r->prop.kind = r->prop.base_kind = anim->kind == ANIM_NONE ? ANIM_SCALAR : anim->kind;
+        r->prop.data = r->scratch;
+    }
+    else if (anim->kind != ANIM_NONE && r->prop.kind != anim->kind)
+    {
+        compositor_unlock( compositor );
+        WARN( "property %s is kind %u, the animation %u.\n", debugstr_w( text ), r->prop.kind, anim->kind );
+        running_free( r );
+        return E_INVALIDARG;
+    }
+
+    /* a new animation of a property replaces what ran on it */
+    if ((old = find_running( clock, owner, text )))
+        running_stop( clock, old, AnimationStopBehavior_LeaveCurrentValue, &freed );
+
+    if (anim->kind == ANIM_NONE)
+    {
+        compositor_unlock( compositor );
+        FIXME( "expression %s for %s not evaluated.\n", debugstr_hstring( anim->expression ), debugstr_w( text ) );
+        running_free( r );
+        free_list( &freed );
+        return S_OK;
+    }
+    if (!anim->count)
+    {
+        compositor_unlock( compositor );
+        WARN( "an animation without key frames.\n" );
+        running_free( r );
+        free_list( &freed );
+        return E_INVALIDARG;
+    }
+
+    r->kind = anim->kind;
+    if (!(r->frames = malloc( anim->count * sizeof(*r->frames) )))
+    {
+        compositor_unlock( compositor );
+        running_free( r );
+        free_list( &freed );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( r->frames, anim->frames, anim->count * sizeof(*r->frames) );
+    r->count = anim->count;
+    prop_read( &r->prop, r->start );
+    r->begin = now_100ns();
+    r->delay = anim->delay.Duration;
+    r->duration = anim->duration.Duration;
+    r->iterations = anim->iteration_behavior == AnimationIterationBehavior_Forever ? 0 : anim->iteration_count;
+    r->stop_behavior = anim->stop_behavior;
+    r->frame = clock->frame;
+    r->owner = owner;
+    IUnknown_AddRef( owner );
+    LIST_FOR_EACH_ENTRY( batch, &clock->scoped, struct batch, entry ) running_join( r, batch );
+    if (clock->commit) running_join( r, clock->commit );
+    list_add_tail( &clock->running, &r->entry );
+    compositor_unlock( compositor );
+
+    free_list( &freed );
+    compositor_wake( compositor );
+    return S_OK;
+}
+
+HRESULT object_stop_animation( struct compositor *compositor, IUnknown *owner, HSTRING name )
+{
+    struct list freed = LIST_INIT( freed );
+    struct anim_clock *clock;
+    struct running *r;
+    WCHAR *text;
+
+    TRACE( "owner %p, name %s.\n", owner, debugstr_hstring( name ) );
+    if (!WindowsGetStringLen( name )) return E_INVALIDARG;
+    if (!(text = hstring_dup( name ))) return E_OUTOFMEMORY;
+    compositor_lock( compositor );
+    if ((clock = get_clock( compositor )) && (r = find_running( clock, owner, text )))
+        running_stop( clock, r, r->stop_behavior, &freed );
+    compositor_unlock( compositor );
+    free( text );
+    if (list_empty( &freed )) return S_OK;
+    free_list( &freed );
+    compositor_changed( compositor );
+    compositor_wake( compositor );
+    return S_OK;
+}
+
+HRESULT commit_batch_get( struct compositor *compositor, CompositionBatchTypes type, ICompositionCommitBatch **out )
+{
+    struct anim_clock *clock;
+    struct running *r;
+    struct batch *batch;
+
+    compositor_lock( compositor );
+    if (!(clock = get_clock( compositor )))
+    {
+        compositor_unlock( compositor );
+        return E_OUTOFMEMORY;
+    }
+    if (!(batch = clock->commit))
+    {
+        if (!(batch = batch_alloc( compositor, TRUE, type )))
+        {
+            compositor_unlock( compositor );
+            return E_OUTOFMEMORY;
+        }
+        clock->commit = batch;
+        /* what was started since the last commit is in it */
+        LIST_FOR_EACH_ENTRY( r, &clock->running, struct running, entry )
+            if (r->frame == clock->frame) running_join( r, batch );
+    }
+    *out = &batch->ICompositionCommitBatch_iface;
+    ICompositionCommitBatch_AddRef( *out );
+    compositor_unlock( compositor );
+    /* it ends with the next commit */
+    compositor_changed( compositor );
+    return S_OK;
+}
+
+/* under the compositor's lock, from its commit */
+void animations_committed( struct compositor *compositor )
+{
+    struct anim_clock *clock = *compositor_clock( compositor );
+    struct batch *batch;
+
+    if (!clock) return;
+    clock->frame++;
+    if (!(batch = clock->commit)) return;
+    clock->commit = NULL;
+    batch->ended = TRUE;
+    /* the clock's reference goes to the queue */
+    /* already queued: that holds a reference of its own, so this is not the last */
+    if (batch->queued) ICompositionScopedBatch_Release( &batch->ICompositionScopedBatch_iface );
+    else
+    {
+        batch->queued = TRUE;
+        list_add_tail( &clock->queue, &batch->queue_entry );
+    }
+    compositor_wake( compositor );
+}
+
+BOOL animations_run( struct compositor *compositor )
+{
+    struct list freed = LIST_INIT( freed ), queue = LIST_INIT( queue );
+    struct anim_clock *clock;
+    struct running *r, *next;
+    struct batch *batch, *next_batch;
+    BOOL changed = FALSE, more;
+    LONGLONG now = now_100ns();
+    float value[4];
+    BOOL finished;
+
+    compositor_lock( compositor );
+    if (!(clock = *compositor_clock( compositor )))
+    {
+        compositor_unlock( compositor );
+        return FALSE;
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( r, next, &clock->running, struct running, entry )
+    {
+        if (!running_value( r, now, value, &finished )) continue;
+        prop_write( &r->prop, value );
+        changed = TRUE;
+        if (!finished) continue;
+        list_remove( &r->entry );
+        running_leave_batches( clock, r );
+        list_add_tail( &freed, &r->entry );
+    }
+    list_move_tail( &queue, &clock->queue );
+    LIST_FOR_EACH_ENTRY( batch, &queue, struct batch, queue_entry ) batch->queued = FALSE;
+    more = !list_empty( &clock->running );
+    compositor_unlock( compositor );
+
+    if (changed) compositor_changed( compositor );
+    free_list( &freed );
+    LIST_FOR_EACH_ENTRY_SAFE( batch, next_batch, &queue, struct batch, queue_entry )
+    {
+        list_remove( &batch->queue_entry );
+        batch_fire( batch );
+        ICompositionScopedBatch_Release( &batch->ICompositionScopedBatch_iface );
+    }
+
+    /* finishing may have queued more */
+    compositor_lock( compositor );
+    more = more || !list_empty( &clock->queue );
+    compositor_unlock( compositor );
+    return more;
+}
+
+/* the compositor is going: nothing that references it is left here */
+void animations_free( struct compositor *compositor )
+{
+    struct anim_clock **clock = compositor_clock( compositor );
+    struct running *r, *next;
+
+    if (!*clock) return;
+    LIST_FOR_EACH_ENTRY_SAFE( r, next, &(*clock)->running, struct running, entry )
+    {
+        list_remove( &r->entry );
+        running_free( r );
+    }
+    free( *clock );
+    *clock = NULL;
+}
