+static HRESULT set_parameter( struct animation *impl, HSTRING key, enum anim_kind kind, const void *value,
+                              size_t size, ICompositionObject *object )
+{
+    struct parameter *parameter;
+    WCHAR *name;
+
+    TRACE( "animation %p, key %s, kind %u.\n", impl, debugstr_hstring( key ), kind );
+    if (!WindowsGetStringLen( key )) return E_INVALIDARG;
+    if (!(name = hstring_dup( key ))) return E_OUTOFMEMORY;
+    compositor_lock( impl->compositor );
+    if (!(parameter = find_parameter( impl, name )))
+    {
+        if (!(parameter = calloc( 1, sizeof(*parameter) )))
+        {
+            compositor_unlock( impl->compositor );
+            free( name );
+            return E_OUTOFMEMORY;
+        }
+        parameter->name = name;
+        list_add_tail( &impl->parameters, &parameter->entry );
+    }
+    else free( name );
+    if (parameter->object) ICompositionObject_Release( parameter->object );
+    if ((parameter->object = object)) ICompositionObject_AddRef( object );
+    parameter->kind = kind;
+    memset( parameter->value, 0, sizeof(parameter->value) );
+    if (value) memcpy( parameter->value, value, size );
+    compositor_unlock( impl->compositor );
+    return S_OK;
+}
