+HRESULT keyframe_animation_create( struct compositor *compositor, enum anim_kind kind, void **out )
+{
+    const void *vtbl;
+    struct animation *impl;
+    HRESULT hr;
+
+    switch (kind)
+    {
+    case ANIM_SCALAR: vtbl = &scalar_vtbl; break;
+    case ANIM_VECTOR2: vtbl = &vector2_vtbl; break;
+    case ANIM_VECTOR3: vtbl = &vector3_vtbl; break;
+    case ANIM_VECTOR4: vtbl = &vector4_vtbl; break;
+    case ANIM_COLOR: vtbl = &color_vtbl; break;
+    case ANIM_QUATERNION: vtbl = &quaternion_vtbl; break;
+    default: return E_INVALIDARG;
+    }
+    if (FAILED(hr = animation_create( compositor, kind, vtbl, &impl ))) return hr;
+    *out = &impl->typed_iface;
+    return S_OK;
+}
