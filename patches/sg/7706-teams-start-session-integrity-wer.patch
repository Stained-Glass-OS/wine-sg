+/* ---- Stained Glass OS 7706: Windows.System.Profile.WindowsIntegrityPolicy ----
+ * Whether the system runs in S mode (only Store apps; an app may say so or offer the switch
+ * out): it never does here, there is no mode to leave and nothing that changes it. */
+
+DEFINE_FACTORY( integrity, IWindowsIntegrityPolicyStatics, IID_IWindowsIntegrityPolicyStatics, RuntimeClass_Windows_System_Profile_WindowsIntegrityPolicy );
+
+static HRESULT WINAPI integrity_statics_get_IsEnabled( IWindowsIntegrityPolicyStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI integrity_statics_get_IsEnabledForTrial( IWindowsIntegrityPolicyStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI integrity_statics_get_CanDisable( IWindowsIntegrityPolicyStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI integrity_statics_get_IsDisableSupported( IWindowsIntegrityPolicyStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI integrity_statics_add_PolicyChanged( IWindowsIntegrityPolicyStatics *iface,
+                                                           IEventHandler_IInspectable *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    /* the policy never changes here: there is nothing to tell */
+    if (!handler || !token) return E_POINTER;
+    token->value = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI integrity_statics_remove_PolicyChanged( IWindowsIntegrityPolicyStatics *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %I64d.\n", iface, token.value );
+    return S_OK;
+}
+
+static const struct IWindowsIntegrityPolicyStaticsVtbl integrity_statics_vtbl =
+{
+    integrity_statics_QueryInterface,
+    integrity_statics_AddRef,
+    integrity_statics_Release,
+    integrity_statics_GetIids,
+    integrity_statics_GetRuntimeClassName,
+    integrity_statics_GetTrustLevel,
+    integrity_statics_get_IsEnabled,
+    integrity_statics_get_IsEnabledForTrial,
+    integrity_statics_get_CanDisable,
+    integrity_statics_get_IsDisableSupported,
+    integrity_statics_add_PolicyChanged,
+    integrity_statics_remove_PolicyChanged,
+};
+
+static struct integrity_factory integrity_factory = { {&integrity_factory_vtbl}, {&integrity_statics_vtbl} };
+IActivationFactory *integrity_policy_factory = &integrity_factory.IActivationFactory_iface;
+
+/* ---- Stained Glass OS 7706: Windows.System.RemoteDesktop.InteractiveSession ----
+ * Whether the user's session is a remote one: what GetSystemMetrics(SM_REMOTESESSION) says. */
+
+DEFINE_FACTORY( session, IInteractiveSessionStatics, IID_IInteractiveSessionStatics, RuntimeClass_Windows_System_RemoteDesktop_InteractiveSession );
+
+static HRESULT WINAPI session_statics_get_IsRemote( IInteractiveSessionStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_SESSION_ALWAYS_REMOTE
+    *value = TRUE;
+#else
+    *value = !!GetSystemMetrics( SM_REMOTESESSION );
+#endif
+    return S_OK;
+}
+
+static const struct IInteractiveSessionStaticsVtbl session_statics_vtbl =
+{
+    session_statics_QueryInterface,
+    session_statics_AddRef,
+    session_statics_Release,
+    session_statics_GetIids,
+    session_statics_GetRuntimeClassName,
+    session_statics_GetTrustLevel,
+    session_statics_get_IsRemote,
+};
+
+static struct session_factory session_factory = { {&session_factory_vtbl}, {&session_statics_vtbl} };
+IActivationFactory *interactive_session_factory = &session_factory.IActivationFactory_iface;
