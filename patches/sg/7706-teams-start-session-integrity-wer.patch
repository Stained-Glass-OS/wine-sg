     }
@@ -896,6 +896,44 @@ static HRESULT remove_wer_entry( int kind, const void *ptr, const WCHAR *name )
     return hr;
 }
 
+/***********************************************************************
+ *         WerRegisterAdditionalProcess   (kernelbase.@)
+ *
+ * Stained Glass OS 7706: another process to report with this one's (a browser's renderers);
+ * the thread whose extra information to capture is updated when it is registered again.
+ * Reports are never sent here; the registrations are kept as Windows keeps them.
+ */
+HRESULT WINAPI WerRegisterAdditionalProcess( DWORD pid, DWORD tid )
+{
+    struct wer_entry *entry;
+    unsigned int count;
+    HRESULT hr;
+
+    TRACE( "(%lu, %lu)\n", pid, tid );
+    if (!pid) return E_INVALIDARG;
+#ifndef SG_MUTANT_NO_WER_PROCESS
+    RtlEnterCriticalSection( &wer_cs );
+    entry = find_wer_entry( WER_ENTRY_PROCESS, ULongToPtr( pid ), NULL, &count );
+    if (entry) entry->size = tid;
+    RtlLeaveCriticalSection( &wer_cs );
+    if (entry) return S_OK;
+    hr = add_wer_entry( WER_ENTRY_PROCESS, ULongToPtr( pid ), tid, 0, NULL, WER_MAX_REGISTERED_ENTRIES );
+    return hr;
+#else
+    return E_NOTIMPL;
+#endif
+}
+
+/***********************************************************************
+ *         WerUnregisterAdditionalProcess   (kernelbase.@)
+ */
+HRESULT WINAPI WerUnregisterAdditionalProcess( DWORD pid )
+{
+    TRACE( "(%lu)\n", pid );
+    if (!pid) return E_INVALIDARG;
+    return remove_wer_entry( WER_ENTRY_PROCESS, ULongToPtr( pid ), NULL );
+}
+
 /***********************************************************************
  *         WerGetFlags   (kernelbase.@)
  */
