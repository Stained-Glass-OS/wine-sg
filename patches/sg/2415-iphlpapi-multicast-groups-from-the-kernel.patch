From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] iphlpapi: the multicast table lists the groups the kernel says were joined

GetMulticastIpAddressTable made up the all-hosts groups for every
interface. It now reads /proc/net/igmp and /proc/net/igmp6 (through the
\\?\unix\ path), keeps the groups of IP interfaces, gives IPv6 groups their
scope from the address (interface, link, subnet, admin, site, organisation,
global) and the interface number as zone for the first two, and falls back
to the all-hosts groups only when the kernel's lists cannot be read.
GetMulticastIpAddressEntry looks in the same table.

The guessed defaults and error codes of InitializeIpForwardEntry,
GetIpErrorString, SendARP and GetOwnerModuleFrom* are now said so in their
comments.
---
--- a/dlls/iphlpapi/entries.c
+++ b/dlls/iphlpapi/entries.c
@@ -23,6 +23,8 @@
 #include <stdarg.h>
 #define IPHLPAPI_DLL_LINKAGE
 #include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
 #include "windef.h"
 #include "winbase.h"
 #include "winsock2.h"
@@ -132,62 +134,246 @@ DWORD WINAPI GetIpNetEntry2( MIB_IPNET_ROW2 *row )
     return err;
 }
 
+/* The groups the kernel says each interface has joined: /proc/net/igmp (IPv4) and
+ * /proc/net/igmp6 (IPv6), read through the \\?\unix\ path so that a missing drive
+ * mapping for / does not matter. The interface number in both is the one the
+ * interface tables use. */
+struct mcast_group
+{
+    NET_IFINDEX index;
+    ADDRESS_FAMILY family;
+    union { IN_ADDR v4; IN6_ADDR v6; } addr;
+};
+
+static char *read_unix_file( const WCHAR *path, DWORD *len )
+{
+    HANDLE file;
+    char *buf = NULL;
+    DWORD size = 0, cap = 0, got;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    for (;;)
+    {
+        if (size + 4096 + 1 > cap)
+        {
+            char *new = heap_realloc( buf, cap = cap ? cap * 2 : 8192 );
+            if (!new) { heap_free( buf ); CloseHandle( file ); return NULL; }
+            buf = new;
+        }
+        if (!ReadFile( file, buf + size, cap - size - 1, &got, NULL ) || !got) break;
+        size += got;
+        if (size > 4 * 1024 * 1024) break;
+    }
+    CloseHandle( file );
+    buf[size] = 0;
+    *len = size;
+    return buf;
+}
+
+static BOOL add_group( struct mcast_group **groups, DWORD *count, DWORD *cap, const struct mcast_group *g )
+{
+    if (*count == *cap)
+    {
+        struct mcast_group *new = heap_realloc( *groups, (*cap = *cap ? *cap * 2 : 32) * sizeof(*new) );
+        if (!new) return FALSE;
+        *groups = new;
+    }
+    (*groups)[(*count)++] = *g;
+    return TRUE;
+}
+
+static BOOL parse_igmp( char *text, struct mcast_group **groups, DWORD *count, DWORD *cap )
+{
+    char *line, *next;
+    unsigned int index = 0;
+
+    for (line = text; line && *line; line = next)
+    {
+        struct mcast_group g = {0};
+        unsigned int addr, users;
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        if (*line >= '0' && *line <= '9')  /* "Idx Device : Count Querier": a device */
+        {
+            index = strtoul( line, NULL, 10 );
+            continue;
+        }
+        /* "   010000E0   1 0:00000000   0": a group, as the raw network-order word the kernel prints */
+        if (!index || sscanf( line, " %8x %u", &addr, &users ) != 2) continue;
+        g.index = index;
+        g.family = AF_INET;
+        g.addr.v4.s_addr = addr;
+        if (!add_group( groups, count, cap, &g )) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL parse_igmp6( char *text, struct mcast_group **groups, DWORD *count, DWORD *cap )
+{
+    char *line, *next;
+
+    for (line = text; line && *line; line = next)
+    {
+        struct mcast_group g = {0};
+        unsigned int index, i;
+        char name[64], hex[40];
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        /* "2 enp4s0 ff0200000000000000000000000000fb 3 00000006 0" */
+        if (sscanf( line, "%u %63s %32s", &index, name, hex ) != 3 || strlen( hex ) != 32) continue;
+        for (i = 0; i < 16; i++)
+        {
+            unsigned int byte;
+            if (sscanf( hex + 2 * i, "%2x", &byte ) != 1) break;
+            g.addr.v6.s6_addr[i] = byte;
+        }
+        if (i != 16) continue;
+        g.index = index;
+        g.family = AF_INET6;
+        if (!add_group( groups, count, cap, &g )) return FALSE;
+    }
+    return TRUE;
+}
+
+/* TRUE when the kernel's lists could be read (for the families asked about) */
+static BOOL load_groups( ADDRESS_FAMILY family, struct mcast_group **groups, DWORD *count )
+{
+    DWORD cap = 0, len;
+    char *text;
+    BOOL ok = FALSE;
+
+    *groups = NULL;
+    *count = 0;
+    if (family == AF_INET || family == AF_UNSPEC)
+    {
+        if ((text = read_unix_file( L"\\\\?\\unix\\proc\\net\\igmp", &len )))
+        {
+            ok = parse_igmp( text, groups, count, &cap );
+            heap_free( text );
+        }
+    }
+    if (family == AF_INET6 || family == AF_UNSPEC)
+    {
+        if ((text = read_unix_file( L"\\\\?\\unix\\proc\\net\\igmp6", &len )))
+        {
+            ok = parse_igmp6( text, groups, count, &cap ) || ok;
+            heap_free( text );
+        }
+    }
+    if (!ok) { heap_free( *groups ); *groups = NULL; *count = 0; }
+    return ok;
+}
+
+static void fill_mcast_row( MIB_MULTICASTIPADDRESS_ROW *row, const MIB_IPINTERFACE_ROW *iface, const struct mcast_group *g )
+{
+    row->InterfaceLuid = iface->InterfaceLuid;
+    row->InterfaceIndex = iface->InterfaceIndex;
+    if (g->family == AF_INET)
+    {
+        row->Address.Ipv4.sin_family = AF_INET;
+        row->Address.Ipv4.sin_addr = g->addr.v4;
+        return;
+    }
+    row->Address.Ipv6.sin6_family = AF_INET6;
+    row->Address.Ipv6.sin6_addr = g->addr.v6;
+    /* the scope is the second nibble: 1 interface, 2 link, 3 subnet, 4 admin, 5 site, 8 organisation, 14 global */
+    row->ScopeId.Level = g->addr.v6.s6_addr[1] & 0xf;
+#ifdef SG_MUTANT_IPE_MCASTSCOPE
+    row->ScopeId.Level = ScopeLevelLink;
+#endif
+    row->ScopeId.Zone = row->ScopeId.Level <= ScopeLevelLink ? iface->InterfaceIndex : 0;
+}
+
+/* No /proc/net/igmp{,6} to read: every interface that has IP enabled belongs to the
+ * all-hosts groups of its family, 224.0.0.1 for IPv4 and ff01::1 and ff02::1 for IPv6. */
+static DWORD synthesise_groups( const MIB_IPINTERFACE_TABLE *ifaces, struct mcast_group **groups, DWORD *count )
+{
+    DWORD i, cap = 0;
+
+    *groups = NULL;
+    *count = 0;
+    for (i = 0; i < ifaces->NumEntries; i++)
+    {
+        struct mcast_group g = {0};
+
+        g.index = ifaces->Table[i].InterfaceIndex;
+        g.family = ifaces->Table[i].Family;
+        if (g.family == AF_INET)
+        {
+            g.addr.v4.s_addr = htonl( 0xe0000001 );
+            if (!add_group( groups, count, &cap, &g )) return ERROR_NOT_ENOUGH_MEMORY;
+            continue;
+        }
+        g.addr.v6.s6_addr[0] = 0xff; g.addr.v6.s6_addr[1] = 0x01; g.addr.v6.s6_addr[15] = 1;
+        if (!add_group( groups, count, &cap, &g )) return ERROR_NOT_ENOUGH_MEMORY;
+        g.addr.v6.s6_addr[1] = 0x02;
+        if (!add_group( groups, count, &cap, &g )) return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    return NO_ERROR;
+}
+
 /******************************************************************
  *    GetMulticastIpAddressTable (IPHLPAPI.@)
  *
- * Every interface that has IP enabled belongs to the all-hosts groups of
- * its family: 224.0.0.1 for IPv4, and ff01::1 and ff02::1 for IPv6.
+ * The groups each IP interface has really joined, from the kernel's
+ * /proc/net/igmp and /proc/net/igmp6; without them, the all-hosts groups.
  */
 DWORD WINAPI GetMulticastIpAddressTable( ADDRESS_FAMILY family, MIB_MULTICASTIPADDRESS_TABLE **table )
 {
-    static const struct in6_addr all_nodes_if = {{{ 0xff, 0x01, [15] = 1 }}};
-    static const struct in6_addr all_nodes_link = {{{ 0xff, 0x02, [15] = 1 }}};
     MIB_IPINTERFACE_TABLE *ifaces;
-    DWORD err, i, count = 0;
+    struct mcast_group *groups;
+    DWORD err, i, j, count, n = 0;
 
     TRACE( "%u, %p\n", family, table );
 
     if (!table || !is_ip_or_unspec( family )) return ERROR_INVALID_PARAMETER;
 
     if ((err = GetIpInterfaceTable( family, &ifaces ))) return err;
-    for (i = 0; i < ifaces->NumEntries; i++) count += ifaces->Table[i].Family == AF_INET ? 1 : 2;
+#ifdef SG_MUTANT_IPE_MCASTSYNTH
+    if (1)
+#else
+    if (!load_groups( family, &groups, &count ))
+#endif
+        err = synthesise_groups( ifaces, &groups, &count );
+    if (err)
+    {
+        FreeMibTable( ifaces );
+        return err;
+    }
 
-    if (!(*table = heap_alloc_zero( FIELD_OFFSET(MIB_MULTICASTIPADDRESS_TABLE, Table[count]) )))
+    if (!(*table = heap_alloc_zero( FIELD_OFFSET(MIB_MULTICASTIPADDRESS_TABLE, Table[count ? count : 1]) )))
     {
+        heap_free( groups );
         FreeMibTable( ifaces );
         return ERROR_NOT_ENOUGH_MEMORY;
     }
-    (*table)->NumEntries = count;
-    for (i = count = 0; i < ifaces->NumEntries; i++)
+    /* a group counts for an interface of its family that has IP enabled; one listed twice counts once */
+    for (i = 0; i < count; i++)
     {
-        const MIB_IPINTERFACE_ROW *iface = ifaces->Table + i;
-        MIB_MULTICASTIPADDRESS_ROW *row = (*table)->Table + count;
+        const MIB_IPINTERFACE_ROW *iface = NULL;
+        BOOL dup = FALSE;
 
-        row->InterfaceLuid = iface->InterfaceLuid;
-        row->InterfaceIndex = iface->InterfaceIndex;
-        if (iface->Family == AF_INET)
+        for (j = 0; j < ifaces->NumEntries; j++)
+            if (ifaces->Table[j].Family == groups[i].family && ifaces->Table[j].InterfaceIndex == groups[i].index)
+            {
+                iface = ifaces->Table + j;
+                break;
+            }
+        if (!iface) continue;
+        for (j = 0; j < n && !dup; j++)
         {
-            row->Address.Ipv4.sin_family = AF_INET;
-            row->Address.Ipv4.sin_addr.s_addr = htonl( 0xe0000001 );
-            count++;
-            continue;
+            const MIB_MULTICASTIPADDRESS_ROW *r = (*table)->Table + j;
+
+            dup = r->InterfaceIndex == groups[i].index && r->Address.si_family == groups[i].family &&
+                  (groups[i].family == AF_INET ? r->Address.Ipv4.sin_addr.s_addr == groups[i].addr.v4.s_addr
+                                               : !memcmp( &r->Address.Ipv6.sin6_addr, &groups[i].addr.v6, sizeof(IN6_ADDR) ));
         }
-        row->Address.Ipv6.sin6_family = AF_INET6;
-        row->Address.Ipv6.sin6_addr = all_nodes_if;
-        row->ScopeId.Level = ScopeLevelInterface;
-        row->ScopeId.Zone = iface->InterfaceIndex;
-#ifdef SG_MUTANT_IPE_MCAST
-        row->Address.Ipv6.sin6_addr = all_nodes_link;
-#endif
-        row++;
-        row->InterfaceLuid = iface->InterfaceLuid;
-        row->InterfaceIndex = iface->InterfaceIndex;
-        row->Address.Ipv6.sin6_family = AF_INET6;
-        row->Address.Ipv6.sin6_addr = all_nodes_link;
-        row->ScopeId.Level = ScopeLevelLink;
-        row->ScopeId.Zone = iface->InterfaceIndex;
-        count += 2;
+        if (dup) continue;
+        fill_mcast_row( (*table)->Table + n++, iface, groups + i );
     }
+    (*table)->NumEntries = n;
+    heap_free( groups );
     FreeMibTable( ifaces );
     return NO_ERROR;
 }
