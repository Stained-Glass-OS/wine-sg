From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wscript, cscript: Unicode script files.

Windows Script Host runs Unicode script files as well as ANSI ones. wscript and
cscript read every file as ANSI, so a UTF-16LE script failed at (1, 1). A script
with the UTF-16LE byte order mark is Unicode, and so is one without it whose bytes
are plainly UTF-16LE text: the Qt Installer Framework writes its deferred-rename
.vbs that way and runs it with cscript after an install, and without it the
maintenance tool (Avidemux's uninstaller) stayed "...exe.new" and Programs and
Features pointed at a missing file.
---
diff --git a/programs/wscript/main.c b/programs/wscript/main.c
index b0fdff5..37dc488 100644
--- a/programs/wscript/main.c
+++ b/programs/wscript/main.c
@@ -327,6 +327,29 @@ static BOOL init_engine(IActiveScript *script, IActiveScriptParse *parser)
     return SUCCEEDED(hres);
 }
 
+/* Windows Script Host runs Unicode script files as well as ANSI ones: those
+ * with the UTF-16LE byte order mark, and those without it whose bytes are
+ * plainly UTF-16LE text (Qt Installer Framework writes its deferred-rename
+ * .vbs that way, and runs it with cscript after an install). */
+static BOOL is_unicode_script(const unsigned char *p, DWORD size)
+{
+    DWORD i, n, odd_zero = 0, even_zero = 0;
+
+    if (size >= 2 && p[0] == 0xff && p[1] == 0xfe) return TRUE;
+#ifdef SG_MUTANT_WSCRIPT_BOM_ONLY
+    return FALSE;
+#endif
+    if (size < 4 || (size & 1)) return FALSE;
+    n = min(size, 512);
+    for (i = 0; i < n; i += 2)
+    {
+        if (!p[i]) even_zero++;
+        if (!p[i + 1]) odd_zero++;
+    }
+    n /= 2;
+    return odd_zero * 10 >= n * 9 && even_zero * 10 < n;
+}
+
 static BSTR get_script_str(const WCHAR *filename)
 {
     const char *file_map;
@@ -349,9 +372,20 @@ static BSTR get_script_str(const WCHAR *filename)
     if(!file_map)
         return NULL;
 
-    len = MultiByteToWideChar(CP_ACP, 0, file_map, size, NULL, 0);
-    ret = SysAllocStringLen(NULL, len);
-    MultiByteToWideChar(CP_ACP, 0, file_map, size, ret, len);
+    if (is_unicode_script((const unsigned char *)file_map, size))
+    {
+        /* a Unicode (UTF-16LE) script, its byte order mark left out */
+        const WCHAR *text = (const WCHAR *)file_map;
+        len = size / sizeof(WCHAR);
+        if (len && text[0] == 0xfeff) { text++; len--; }
+        ret = SysAllocStringLen(text, len);
+    }
+    else
+    {
+        len = MultiByteToWideChar(CP_ACP, 0, file_map, size, NULL, 0);
+        ret = SysAllocStringLen(NULL, len);
+        MultiByteToWideChar(CP_ACP, 0, file_map, size, ret, len);
+    }
 
     UnmapViewOfFile(file_map);
     return ret;
