From: Stained Glass OS <dev@stained-glass.example>
Subject: dwrite: a glyph is hinted at the size it is drawn at, not the run's em size alone

cairo (so GTK: Pinta, Inkscape, GIMP 3) draws every glyph through
IDWriteFactory3::CreateGlyphRunAnalysis with an em size of 1, the real size
in the transform and a glyph offset that puts the glyph's ink box at 0,0,
then asks for exactly that box. Wine handed FreeType the em size -- 1 pixel
-- hinted there and scaled the result: the glyph's box snapped to whole ems
(a 9-pixel "o" got a 16-pixel box) and the glyph was drawn above the
texture cairo asked for. The tops of lower-case letters were cut off:
"Background" read "Backyiuuliu".

The transform's scale (the square root of its determinant) is now folded
into the em size for the glyph box and bitmap, leaving a transform of
determinant +-1; the glyph cache keys on the folded size.

Gate: test/dwscale-gate.sh. dwrite:font, layout, analyzer unchanged.
---
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -155,6 +155,25 @@
     return entry->advance;
 }
 
+/* A glyph is hinted at the size it is drawn at: fold a transform's scale into
+ * the em size, leaving a transform of determinant +-1. Callers such as cairo
+ * pass an em size of 1 and the real size in the transform; hinted at 1 ppem
+ * and then scaled, a glyph's box snapped to whole em units -- a 9-pixel "o"
+ * got a 16-pixel box, and the glyph was drawn outside the texture asked for. */
+static void fold_transform_scale(float *emsize, MATRIX_2X2 *m)
+{
+    float det = m->m11 * m->m22 - m->m12 * m->m21, scale;
+
+    if (det == 0.0f) return;
+    scale = sqrtf(fabsf(det));
+    if (fabsf(scale - 1.0f) < 1e-4f) return;
+    *emsize *= scale;
+    m->m11 /= scale;
+    m->m12 /= scale;
+    m->m21 /= scale;
+    m->m22 /= scale;
+}
+
 void dwrite_fontface_get_glyph_bbox(IDWriteFontFace *iface, struct dwrite_glyphbitmap *bitmap)
 {
     struct cache_key key = { .size = bitmap->emsize, .glyph = bitmap->glyph, .mode = DWRITE_MEASURING_MODE_NATURAL };
@@ -167,6 +186,8 @@
     params.glyph = bitmap->glyph;
     params.emsize = bitmap->emsize;
     matrix_2x2_from_dwrite_matrix(&params.m, bitmap->m ? bitmap->m : &identity);
+    fold_transform_scale(&params.emsize, &params.m);
+    key.size = params.emsize;
 
     EnterCriticalSection(&fontface->cs);
     /* For now bypass cache for transformed cases. */
@@ -216,6 +237,8 @@
     params.bitmap = bitmap->buf;
     params.is_1bpp = is_1bpp;
     matrix_2x2_from_dwrite_matrix(&params.m, bitmap->m ? bitmap->m : &identity);
+    fold_transform_scale(&params.emsize, &params.m);
+    key.size = params.emsize;
 
     EnterCriticalSection(&fontface->cs);
     /* For now bypass cache for transformed cases. */
