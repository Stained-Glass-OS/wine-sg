diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index bd29690..b5775b0 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -1723,6 +1723,25 @@ static BOOL sg_smb_dos_attrib( const char *path, int fd, const struct stat *st,
 }
 
 
+/* Stained Glass OS: the reparse tag of a Unix symbolic link. A junction (IO_REPARSE_TAG_MOUNT_POINT)
+ * is stored as a link whose absolute target ends in a slash; any other link is a symbolic link. */
+static BOOL sg_link_target_is_junction( const char *target, size_t len )
+{
+#ifdef SG_MUTANT_JUNCTION_AS_SYMLINK
+    return FALSE;
+#endif
+    return len > 1 && target[0] == '/' && target[len - 1] == '/';
+}
+
+static ULONG sg_link_reparse_tag( const char *unix_name )
+{
+    char target[PATH_MAX];
+    ssize_t n = readlink( unix_name, target, sizeof(target) - 1 );
+
+    if (n <= 0) return 0;
+    return sg_link_target_is_junction( target, n ) ? IO_REPARSE_TAG_MOUNT_POINT : IO_REPARSE_TAG_SYMLINK;
+}
+
 /* get the stat info and file attributes for a file (by file descriptor) */
 static int fd_get_file_info( int fd, unsigned int options, struct stat *st, ULONG *attr )
 {
@@ -2665,6 +2684,27 @@ static NTSTATUS get_dir_data_entry( struct dir_data *dir_data, void *info_ptr, I
         fill_file_info( &st, attributes, info, class );
     }
 
+    /* Stained Glass OS: a reparse point's entry has its tag where the EA size goes, as NTFS has it
+     * (FindFirstFile's dwReserved0) */
+    {
+        ULONG tag = 0;
+        struct stat lst;
+
+        if ((attributes & FILE_ATTRIBUTE_REPARSE_POINT) && !lstat( names->unix_name, &lst ))
+            tag = S_ISLNK( lst.st_mode ) ? sg_link_reparse_tag( names->unix_name ) : IO_REPARSE_TAG_MOUNT_POINT;
+#ifdef SG_MUTANT_DIR_NO_TAG
+        tag = 0;
+#endif
+        switch (class)
+        {
+        case FileFullDirectoryInformation: info->full.EaSize = tag; break;
+        case FileIdFullDirectoryInformation: info->id_full.EaSize = tag; break;
+        case FileBothDirectoryInformation: info->both.EaSize = tag; break;
+        case FileIdBothDirectoryInformation: info->id_both.EaSize = tag; break;
+        default: break;
+        }
+    }
+
     switch (class)
     {
     case FileDirectoryInformation:
@@ -2672,24 +2712,20 @@ static NTSTATUS get_dir_data_entry( struct dir_data *dir_data, void *info_ptr, I
         break;
 
     case FileFullDirectoryInformation:
-        info->full.EaSize = 0; /* FIXME */
         info->full.FileNameLength = name_len;
         break;
 
     case FileIdFullDirectoryInformation:
-        info->id_full.EaSize = 0; /* FIXME */
         info->id_full.FileNameLength = name_len;
         break;
 
     case FileBothDirectoryInformation:
-        info->both.EaSize = 0; /* FIXME */
         info->both.ShortNameLength = wcslen( names->short_name ) * sizeof(WCHAR);
         memcpy( info->both.ShortName, names->short_name, info->both.ShortNameLength );
         info->both.FileNameLength = name_len;
         break;
 
     case FileIdBothDirectoryInformation:
-        info->id_both.EaSize = 0; /* FIXME */
         info->id_both.ShortNameLength = wcslen( names->short_name ) * sizeof(WCHAR);
         memcpy( info->id_both.ShortName, names->short_name, info->id_both.ShortNameLength );
         info->id_both.FileNameLength = name_len;
@@ -5313,7 +5349,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                 if (!lstat( unix_name, &lst ) && S_ISLNK( lst.st_mode ))
                 {
                     info->FileAttributes |= FILE_ATTRIBUTE_REPARSE_POINT;
-                    info->ReparseTag = IO_REPARSE_TAG_SYMLINK;
+                    info->ReparseTag = sg_link_reparse_tag( unix_name );
                 }
                 free( unix_name );
             }
@@ -7452,6 +7488,21 @@ static NTSTATUS sg_set_reparse_point( HANDLE handle, const void *in, ULONG in_si
     memcpy( path, buf + hdr + subst_off, subst_len );
     if ((status = server_get_unix_name( handle, &link ))) goto done;
     if ((status = sg_reparse_unix_target( link, path, subst_len / sizeof(WCHAR), relative, &target ))) goto done;
+    {
+        /* a junction's target ends in a slash, a symbolic link's does not (sg_link_reparse_tag) */
+        size_t len = strlen( target );
+        if (tag == IO_REPARSE_TAG_MOUNT_POINT && target[0] == '/' && (!len || target[len - 1] != '/'))
+        {
+            char *marked = malloc( len + 2 );
+            if (!marked) { status = STATUS_NO_MEMORY; goto done; }
+            memcpy( marked, target, len );
+            strcpy( marked + len, "/" );
+            free( target );
+            target = marked;
+        }
+        else if (tag == IO_REPARSE_TAG_SYMLINK)
+            while (len > 1 && target[len - 1] == '/') target[--len] = 0;
+    }
     TRACE( "%s -> %s\n", debugstr_a(link), debugstr_a(target) );
 
     if (lstat( link, &st ) == -1) { status = errno_to_status( errno ); goto done; }
@@ -7509,6 +7560,35 @@ static NTSTATUS sg_get_reparse_point( HANDLE handle, void *out, ULONG out_size,
     if (n == -1) return errno == EINVAL ? STATUS_NOT_A_REPARSE_POINT : errno_to_status( errno );
     target[n] = 0;
 
+    if (sg_link_target_is_junction( target, n ))
+    {
+        /* a junction: IO_REPARSE_TAG_MOUNT_POINT's layout (no flags), "\??\C:\dir" and "C:\dir" */
+        while (n > 1 && target[n - 1] == '/') target[--n] = 0;
+        if ((status = unix_to_nt_file_name( target, &nt ))) return status;
+        subst_len = wcslen( nt ) * sizeof(WCHAR);
+        print_len = subst_len - 4 * sizeof(WCHAR);
+        total = 16 + subst_len + sizeof(WCHAR) + print_len + sizeof(WCHAR);
+        if (!(buf = calloc( 1, total ))) { free( nt ); return STATUS_NO_MEMORY; }
+        *(ULONG *)buf = IO_REPARSE_TAG_MOUNT_POINT;
+        *(USHORT *)(buf + 4) = total - 8;
+        *(USHORT *)(buf + 8) = 0;                              /* SubstituteNameOffset */
+        *(USHORT *)(buf + 10) = subst_len;
+        *(USHORT *)(buf + 12) = subst_len + sizeof(WCHAR);     /* PrintNameOffset */
+        *(USHORT *)(buf + 14) = print_len;
+        memcpy( buf + 16, nt, subst_len );
+        memcpy( buf + 16 + subst_len + sizeof(WCHAR), nt + 4, print_len );
+        free( nt );
+        if (out_size < 16) status = STATUS_BUFFER_TOO_SMALL;
+        else
+        {
+            *ret_size = min( total, out_size );
+            memcpy( out, buf, *ret_size );
+            status = total > out_size ? STATUS_BUFFER_OVERFLOW : STATUS_SUCCESS;
+        }
+        free( buf );
+        return status;
+    }
+
     if (target[0] == '/')
     {
         if ((status = unix_to_nt_file_name( target, &nt ))) return status;
diff --git a/programs/cmd/builtins.c b/programs/cmd/builtins.c
index d7c5090..c1ae29b 100644
--- a/programs/cmd/builtins.c
+++ b/programs/cmd/builtins.c
@@ -30,6 +30,7 @@
 
 #include "wcmd.h"
 #include <shellapi.h>
+#include <winioctl.h>
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(cmd);
@@ -3975,6 +3976,43 @@ RETURN_CODE WCMD_color(void)
  * WCMD_mklink
  */
 
+/* Stained Glass OS: mklink /J: a directory made a mount point (junction) to the target's full path */
+static BOOL create_junction(const WCHAR *link, const WCHAR *target)
+{
+    WCHAR full[MAX_PATH];
+    BYTE buffer[16 + 2 * (MAX_PATH + 8) * sizeof(WCHAR)];
+    DWORD len, subst_len, print_len, size;
+    HANDLE file;
+    BOOL ret;
+
+    len = GetFullPathNameW(target, ARRAY_SIZE(full), full, NULL);
+    if (!len || len >= ARRAY_SIZE(full)) return FALSE;
+    if (!CreateDirectoryW(link, NULL)) return FALSE;
+    file = CreateFileW(link, GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
+                       FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        RemoveDirectoryW(link);
+        return FALSE;
+    }
+    subst_len = (4 + len) * sizeof(WCHAR);
+    print_len = len * sizeof(WCHAR);
+    memset(buffer, 0, sizeof(buffer));
+    *(DWORD *)buffer = IO_REPARSE_TAG_MOUNT_POINT;
+    *(WORD *)(buffer + 4) = 8 + subst_len + sizeof(WCHAR) + print_len + sizeof(WCHAR);
+    *(WORD *)(buffer + 8) = 0;
+    *(WORD *)(buffer + 10) = subst_len;
+    *(WORD *)(buffer + 12) = subst_len + sizeof(WCHAR);
+    *(WORD *)(buffer + 14) = print_len;
+    memcpy(buffer + 16, L"\\??\\", 4 * sizeof(WCHAR));
+    memcpy(buffer + 16 + 4 * sizeof(WCHAR), full, len * sizeof(WCHAR));
+    memcpy(buffer + 16 + subst_len + sizeof(WCHAR), full, print_len);
+    ret = DeviceIoControl(file, FSCTL_SET_REPARSE_POINT, buffer, 8 + *(WORD *)(buffer + 4), NULL, 0, &size, NULL);
+    CloseHandle(file);
+    if (!ret) RemoveDirectoryW(link);
+    return ret;
+}
+
 RETURN_CODE WCMD_mklink(WCHAR *args)
 {
     int   argno = 0;
@@ -4021,7 +4059,7 @@ RETURN_CODE WCMD_mklink(WCHAR *args)
         else if(!junction)
             ret = CreateSymbolicLinkW(file1, file2, isdir);
         else
-            TRACE("Junction links currently not supported.\n");
+            ret = create_junction(file1, file2);
     }
 
     if (ret) return errorlevel = NO_ERROR;
