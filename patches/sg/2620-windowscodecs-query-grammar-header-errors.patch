From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: metadata query grammar, header errors and index range as Windows has them

Ground truth from Wine's metadata tests (todo_wine blocks):
 - Query indexes: a sign ([+1], [-1]) is WINCODEC_ERR_INVALIDQUERYCHARACTER; [*] is
   understood; on an item of a block an index is E_INVALIDARG and [*]
   WINCODEC_ERR_REQUESTONLYVALIDATMETADATAROOT; whole numbers in {type=...} written in
   hexadecimal are DISP_E_TYPEMISMATCH.
 - CreateMetadataReader with the format of a reader that refuses the data (an App1
   reader handed something that is not Exif) fails with WINCODEC_ERR_BADMETADATAHEADER
   instead of making an unknown reader.
 - A block reader of a decoder frame asked for a reader past its end gives
   WINCODEC_ERR_VALUEOUTOFRANGE.
The matching todo_wine marks of the tests are removed.
---
--- a/dlls/windowscodecs/decoder.c
+++ b/dlls/windowscodecs/decoder.c
@@ -617,8 +617,13 @@ static HRESULT WINAPI CommonDecoderFrame_Block_GetReaderByIndex(IWICMetadataBloc
 
     hr = CommonDecoderFrame_InitializeMetadata(This);
 
+#ifdef SG_MUTANT_MD_INDEX_INVALIDARG
     if (SUCCEEDED(hr) && nIndex >= This->metadata_count)
         hr = E_INVALIDARG;
+#else
+    if (SUCCEEDED(hr) && nIndex >= This->metadata_count)
+        hr = WINCODEC_ERR_VALUEOUTOFRANGE;
+#endif
 
     if (SUCCEEDED(hr))
         hr = create_instance(&CLSID_WICImagingFactory, &IID_IWICComponentFactory, (void**)&factory);
--- a/dlls/windowscodecs/imgfactory.c
+++ b/dlls/windowscodecs/imgfactory.c
@@ -1258,6 +1258,7 @@ struct iterator_context
     IStream *stream;
 
     void **result;
+    HRESULT header_error; /* a reader of the format refused the data's header */
 };
 
 typedef enum iterator_result (*iterator_func)(IUnknown *item, struct iterator_context *context);
@@ -1384,6 +1385,10 @@ static enum iterator_result create_metadata_reader_iterator(IUnknown *item,
     if (reader)
         IWICMetadataReader_Release(reader);
 
+    /* the data is not what the reader of this format reads */
+    if (hr == WINCODEC_ERR_BADMETADATAHEADER && !context->header_error)
+        context->header_error = hr;
+
     return ITER_SKIP;
 }
 
@@ -1473,6 +1478,11 @@ static HRESULT WINAPI ComponentFactory_CreateMetadataReader(IWICComponentFactory
     if (FAILED(hr))
         WARN("Failed to create a metadata reader instance, hr %#lx.\n", hr);
 
+#ifndef SG_MUTANT_MD_HEADER_FALLBACK
+    if (!*reader && context.header_error)
+        return context.header_error;
+#endif
+
     if (!*reader && !(options & WICMetadataCreationFailUnknown))
         hr = create_unknown_metadata_reader(stream, options, reader);
 
--- a/dlls/windowscodecs/metadataquery.c
+++ b/dlls/windowscodecs/metadataquery.c
@@ -156,6 +156,9 @@ static const struct
     { 4, {'b','o','o','l'}, VT_BOOL }
 };
 
+#define INDEX_NONE (-1) /* no index in the query */
+#define INDEX_ALL (-2)  /* [*] */
+
 static VARTYPE map_type(struct string_t *str)
 {
     UINT i;
@@ -195,6 +198,21 @@ static HRESULT get_token(struct string_t *elem, PROPVARIANT *id, PROPVARIANT *sc
     {
         WCHAR *idx_end;
 
+#ifndef SG_MUTANT_MQ_SIGN_ACCEPTED
+        if (start[1] == '+' || start[1] == '-') return WINCODEC_ERR_INVALIDQUERYCHARACTER;
+#endif
+        if (start[1] == '*' && start[2] == ']')
+        {
+            /* every one of them */
+            *idx = INDEX_ALL;
+            end = start + 3;
+            next_elem.str = end;
+            next_elem.len = elem->len - 3;
+            hr = get_token(&next_elem, id, schema, idx);
+            if (hr != S_OK) return hr;
+            elem->len = 3 + next_elem.len;
+            return S_OK;
+        }
         if (start[1] < '0' || start[1] > '9') return DISP_E_TYPEMISMATCH;
 
         *idx = wcstol(start + 1, &idx_end, 10);
@@ -264,7 +282,23 @@ static HRESULT get_token(struct string_t *elem, PROPVARIANT *id, PROPVARIANT *sc
             hr = UuidFromStringW(next_token.bstrVal, id->puuid);
         }
         else
+        {
+            /* whole numbers are written in decimal */
+#ifndef SG_MUTANT_MQ_HEX_ACCEPTED
+            const WCHAR *digits = next_token.bstrVal;
+
+            if (vt == VT_I2 || vt == VT_I4 || (vt >= VT_I1 && vt <= VT_UI8))
+            {
+                if (*digits == '+' || *digits == '-') digits++;
+                if (digits[0] == '0' && (digits[1] == 'x' || digits[1] == 'X'))
+                {
+                    PropVariantClear(&next_token);
+                    return DISP_E_TYPEMISMATCH;
+                }
+            }
+#endif
             hr = PropVariantChangeType(id, &next_token, 0, vt);
+        }
         PropVariantClear(&next_token);
         if (hr != S_OK)
         {
@@ -517,7 +551,7 @@ static HRESULT WINAPI mqr_GetMetadataByName(IWICMetadataQueryReader *iface, LPCW
 
         p++;
 
-        index = 0;
+        index = INDEX_NONE;
         elem.str = p;
         elem.len = lstrlenW(p);
         hr = get_token(&elem, &tk_id, &tk_schema, &index);
@@ -543,6 +577,14 @@ static HRESULT WINAPI mqr_GetMetadataByName(IWICMetadataQueryReader *iface, LPCW
 
             if (tk_id.vt == VT_CLSID) guid = *tk_id.puuid;
 
+            if (index == INDEX_ALL)
+            {
+                FIXME("[*] is not supported for metadata blocks.\n");
+                hr = DISP_E_TYPEMISMATCH;
+                break;
+            }
+            if (index == INDEX_NONE) index = 0;
+
             if (reader)
             {
                 IWICMetadataReader *new_reader;
@@ -580,6 +622,20 @@ static HRESULT WINAPI mqr_GetMetadataByName(IWICMetadataQueryReader *iface, LPCW
                 break;
             }
 
+            /* an item of a block has no index */
+#ifndef SG_MUTANT_MQ_ITEM_INDEX_OK
+            if (index == INDEX_ALL)
+            {
+                hr = WINCODEC_ERR_REQUESTONLYVALIDATMETADATAROOT;
+                break;
+            }
+            if (index != INDEX_NONE)
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+#endif
+
             if (tk_schema.vt == VT_BSTR)
             {
                 hr = IWICMetadataReader_GetMetadataFormat(reader, &guid);
--- a/dlls/windowscodecs/tests/metadata.c
+++ b/dlls/windowscodecs/tests/metadata.c
@@ -1691,7 +1691,6 @@ static void test_CreateMetadataReader(void)
     hr = IStream_Seek(stream, pos, STREAM_SEEK_SET, NULL);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     hr = IWICComponentFactory_CreateMetadataReader(factory, &GUID_MetadataFormatApp1, NULL, 0, stream, &reader);
-    todo_wine
     ok(hr == WINCODEC_ERR_BADMETADATAHEADER, "Unexpected hr %#lx.\n", hr);
 
     /* With and without caching */
@@ -1830,7 +1829,7 @@ static void test_metadata_png(void)
         }
 
         hr = IWICMetadataBlockReader_GetReaderByIndex(blockreader, 1, &reader);
-        todo_wine ok(hr == WINCODEC_ERR_VALUEOUTOFRANGE, "GetReaderByIndex failed, hr=%lx\n", hr);
+        ok(hr == WINCODEC_ERR_VALUEOUTOFRANGE, "GetReaderByIndex failed, hr=%lx\n", hr);
 
         hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
             &IID_IWICComponentFactory, (void**)&factory);
@@ -3667,13 +3666,13 @@ static void test_queryreader(void)
         { FALSE, &data3, L"/[1]ifd/{str=R\\}ATING}", S_OK, VT_LPSTR, 0, the_best },
 
         { FALSE, &data1, L"[0]/ifd/Rating", WINCODEC_ERR_PROPERTYNOTSUPPORTED },
-        { TRUE, &data1, L"/[+1]ifd/Rating", WINCODEC_ERR_INVALIDQUERYCHARACTER },
-        { TRUE, &data1, L"/[-1]ifd/Rating", WINCODEC_ERR_INVALIDQUERYCHARACTER },
+        { FALSE, &data1, L"/[+1]ifd/Rating", WINCODEC_ERR_INVALIDQUERYCHARACTER },
+        { FALSE, &data1, L"/[-1]ifd/Rating", WINCODEC_ERR_INVALIDQUERYCHARACTER },
         { FALSE, &data1, L"/ifd/{\\str=Rating}", WINCODEC_ERR_WRONGSTATE },
         { FALSE, &data1, L"/ifd/{badtype=0}", WINCODEC_ERR_WRONGSTATE },
-        { TRUE, &data1, L"/ifd/{uint=0x1234}", DISP_E_TYPEMISMATCH },
-        { TRUE, &data1, L"/ifd/[0]Rating", E_INVALIDARG },
-        { TRUE, &data1, L"/ifd/[*]Rating", WINCODEC_ERR_REQUESTONLYVALIDATMETADATAROOT },
+        { FALSE, &data1, L"/ifd/{uint=0x1234}", DISP_E_TYPEMISMATCH },
+        { FALSE, &data1, L"/ifd/[0]Rating", E_INVALIDARG },
+        { FALSE, &data1, L"/ifd/[*]Rating", WINCODEC_ERR_REQUESTONLYVALIDATMETADATAROOT },
     };
     HRESULT hr;
     IWICComponentFactory *factory;
