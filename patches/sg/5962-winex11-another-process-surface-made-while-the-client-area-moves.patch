From: Stained Glass OS <ke7oxh@gmail.com>
Subject: winex11: another process's surface made while the client area moves

5961 has the window's own process keep another process's surface (marked
_SG_FOREIGN_CLIENT) on its client area when that changes. One moment was
left: the other process reads where the client area is, then makes its X
window there. If the client area moves in between -- Opera's "Quit Opera?"
dialog gains its frame just as Chromium's GPU process makes its surface --
the window's own process finds no marked window to move, and the surface
is made at the old place: on qa5 with 10.0-722 it sat at +0+0 while the
client area was at +3+22, and the dialog's buttons were drawn 22 pixels
above where clicks went.

The other process now reads the client area again once its window is made,
marked and known to the X server, and moves it if the area moved. A change
after that finds the marked window, so either side catches every move.

WINE_SG_FOREIGN_CLIENT_DELAY_MS widens the moment for tests.

Gate: make test-xproc-vk "race" (the caption comes while the other process
makes its surface; mutant SG_MUTANT_FOREIGN_CLIENT_NO_RECHECK).
Checked on qa5: the dialog's surface at +3+22 six times out of six, with
its title bar drawn, and Cancel and Quit Opera work.
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2292,6 +2292,24 @@
 }
 
 
+/* Stained Glass OS: where another process's top-level window has its client
+ * area, relative to its X window */
+static BOOL foreign_client_geometry( HWND hwnd, int *x, int *y, int *cx, int *cy )
+{
+    RECT window_rect, client_rect;
+    POINT origin = { 0, 0 };
+    UINT dpi = NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI );
+
+    if (!NtUserGetWindowRect( hwnd, &window_rect, dpi )) return FALSE;
+    NtUserMapWindowPoints( hwnd, 0, &origin, 1, dpi );
+    NtUserGetClientRect( hwnd, &client_rect, NtUserGetDpiForWindow( hwnd ) );
+    *x = origin.x - window_rect.left;
+    *y = origin.y - window_rect.top;
+    *cx = min( max( 1, client_rect.right - client_rect.left ), 65535 );
+    *cy = min( max( 1, client_rect.bottom - client_rect.top ), 65535 );
+    return TRUE;
+}
+
 /**********************************************************************
  *		create_client_window
  */
@@ -2314,31 +2332,40 @@
              * GPU process renders into the browser's): the client window goes
              * inside its X window, over its client area */
             Window whole = X11DRV_get_whole_window( hwnd );
-            RECT window_rect;
-            POINT origin = { 0, 0 };
-            UINT dpi = NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI );
-
-            if (!whole || !NtUserGetWindowRect( hwnd, &window_rect, dpi )) return 0;
-            NtUserMapWindowPoints( hwnd, 0, &origin, 1, dpi );
-            NtUserGetClientRect( hwnd, &client_rect, NtUserGetDpiForWindow( hwnd ) );
-            cx = min( max( 1, client_rect.right - client_rect.left ), 65535 );
-            cy = min( max( 1, client_rect.bottom - client_rect.top ), 65535 );
+
+            const char *delay = getenv( "WINE_SG_FOREIGN_CLIENT_DELAY_MS" );   /* tests: widen the race */
+
+            if (!whole || !foreign_client_geometry( hwnd, &x, &y, &cx, &cy )) return 0;
+            if (delay) usleep( atoi( delay ) * 1000 );
             attr.colormap = colormap;
             attr.bit_gravity = NorthWestGravity;
             attr.win_gravity = NorthWestGravity;
             attr.backing_store = NotUseful;
             attr.border_pixel = 0;
             XSync( gdi_display, False );
-            ret = XCreateWindow( gdi_display, whole, origin.x - window_rect.left, origin.y - window_rect.top,
-                                 cx, cy, 0, default_visual.depth, InputOutput, visual->visual,
+            ret = XCreateWindow( gdi_display, whole, x, y, cx, cy, 0, default_visual.depth, InputOutput, visual->visual,
                                  CWBitGravity | CWWinGravity | CWBackingStore | CWColormap | CWBorderPixel, &attr );
             if (ret)
             {
+                int x2, y2, cx2, cy2;
+
                 /* marked, so the window's own process keeps it over the client
                  * area when that moves or changes size (sync_client_position) */
                 XChangeProperty( gdi_display, ret, foreign_client_atom(), XA_CARDINAL, 32,
                                  PropModeReplace, (unsigned char *)&ret, 1 );
                 XMapWindow( gdi_display, ret );
+                /* the area may have moved while the window was being made (Opera's
+                 * "Quit Opera?" gains its frame then): its own process only moves
+                 * marked windows, so look again now the mark is on the server */
+                XSync( gdi_display, False );
+#ifndef SG_MUTANT_FOREIGN_CLIENT_NO_RECHECK
+                if (foreign_client_geometry( hwnd, &x2, &y2, &cx2, &cy2 ) &&
+                    (x2 != x || y2 != y || cx2 != cx || cy2 != cy))
+                {
+                    TRACE( "%p: client area moved while %lx was made: %d,%d %dx%d\n", hwnd, ret, x2, y2, cx2, cy2 );
+                    XMoveResizeWindow( gdi_display, ret, x2, y2, cx2, cy2 );
+                }
+#endif
             }
             TRACE( "%p: client window %lx in another process's window %lx\n", hwnd, ret, whole );
             return ret;
