 /* DG_IMAGE/DAT_IMAGELAYOUT/MSG_SET */
 TW_UINT16 GPHOTO2_ImageLayoutSet (pTW_IDENTITY pOrigin, 
                                 TW_MEMREF pData)
 {
-    FIXME ("stub!\n");
+    pTW_IMAGELAYOUT layout = (pTW_IMAGELAYOUT) pData;
+    TW_FRAME whole;
+    TW_UINT16 rc;
 
-    return TWRC_FAILURE;
+    TRACE("DG_IMAGE/DAT_IMAGELAYOUT/MSG_SET\n");
+    if (activeDS.currentState != 4 && activeDS.currentState != 5 && activeDS.currentState != 6)
+    {
+        activeDS.twCC = TWCC_SEQERROR;
+        return TWRC_FAILURE;
+    }
+    if (!layout) return TWRC_FAILURE;
+    whole = layout->Frame;
+    rc = image_layout( layout );
+    /* a camera hands over the picture as it is: a frame that crops it is refused and the whole frame is reported */
+    if (rc == TWRC_SUCCESS && (whole.Left.Whole || whole.Top.Whole || whole.Right.Whole || whole.Bottom.Whole)
+            && memcmp( &whole, &layout->Frame, sizeof(whole) ))
+        return TWRC_CHECKSTATUS;
+    return rc;
 }
 
