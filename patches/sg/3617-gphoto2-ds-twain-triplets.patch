+/* The layout of a picture from a camera is the whole picture, in pixels (ICAP_UNITS can only be pixels). */
+static TW_UINT16 image_layout( pTW_IMAGELAYOUT layout )
+{
+    if (activeDS.currentState < 4 || activeDS.currentState > 6)
+    {
+        activeDS.twCC = TWCC_SEQERROR;
+        return TWRC_FAILURE;
+    }
+    if (!layout)
+    {
+        activeDS.twCC = TWCC_BADVALUE;
+        return TWRC_FAILURE;
+    }
+    memset( layout, 0, sizeof(*layout) );
+    if (activeDS.file_handle)
+    {
+        layout->Frame.Right.Whole = activeDS.jd.output_width;
+        layout->Frame.Bottom.Whole = activeDS.jd.output_height;
+    }
+    layout->DocumentNumber = layout->PageNumber = layout->FrameNumber = 1;
+    activeDS.twCC = TWCC_SUCCESS;
+    return TWRC_SUCCESS;
+}
