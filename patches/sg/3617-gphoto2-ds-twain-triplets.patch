                                         TW_MEMREF pData)
 {
-    FIXME ("stub!\n");
+    pTW_CAPABILITY pCapability = (pTW_CAPABILITY) pData;
+    TW_CAPABILITY probe = *pCapability;
+    TW_UINT32 flags = TWQC_GET | TWQC_GETDEFAULT | TWQC_GETCURRENT | TWQC_RESET;
+    TW_UINT16 cc;
 
-    return TWRC_FAILURE;
+    TRACE("DG_CONTROL/DAT_CAPABILITY/MSG_QUERYSUPPORT\n");
+    if (activeDS.currentState < 4 || activeDS.currentState > 7) {
+        activeDS.twCC = TWCC_SEQERROR;
+        return TWRC_FAILURE;
+    }
+    /* a capability is supported when asking for it works */
+    probe.ConType = TWON_DONTCARE16;
+    probe.hContainer = 0;
+    cc = GPHOTO2_SaneCapability( &probe, MSG_GET );
+    if (probe.hContainer) GlobalFree( probe.hContainer );
+    if (cc == TWCC_CAPUNSUPPORTED) {
+        activeDS.twCC = TWCC_BADCAP;
+        return TWRC_FAILURE;
+    }
+    switch (pCapability->Cap)
+    {
+        case ICAP_XFERMECH:
+        case ICAP_PIXELTYPE:
+        case ICAP_PIXELFLAVOR:
+        case ICAP_UNITS:
+        case ICAP_BITDEPTH:
+            flags |= TWQC_SET;
+            break;
+    }
+    pCapability->ConType = TWON_ONEVALUE;
+    pCapability->hContainer = GlobalAlloc( 0, sizeof(TW_ONEVALUE) );
+    if (!pCapability->hContainer) {
+        activeDS.twCC = TWCC_LOWMEMORY;
+        return TWRC_FAILURE;
+    }
+    {
+        pTW_ONEVALUE value = GlobalLock( pCapability->hContainer );
+        value->ItemType = TWTY_UINT32;
+        value->Item = flags;
+        GlobalUnlock( pCapability->hContainer );
+    }
+    activeDS.twCC = TWCC_SUCCESS;
+    return TWRC_SUCCESS;
 }
 
