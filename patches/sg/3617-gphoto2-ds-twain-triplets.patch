From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gphoto2.ds: TWAIN triplets the source does not support, image layout, file transfer, query support (3617)

gphoto2.ds: TWAIN triplets the source does not support, image layout, file transfer, query support

Triplets this source does not have (JPEG compression, palette, gray/RGB response,
CIE color, extended image info, custom data, the camera file system, pass
through, the audio group) now answer TWRC_FAILURE with TWCC_BADPROTOCOL as the
TWAIN specification says, instead of failing with no condition code. New:
DAT_IMAGELAYOUT (the whole picture in pixels; a cropping frame is refused with
TWRC_CHECKSTATUS), DAT_SETUPFILEXFER and DAT_IMAGEFILEXFER (the camera's JFIF
data written to a file when ICAP_XFERMECH is TWSX_FILE), DAT_XFERGROUP (images
only), MSG_QUERYSUPPORT, MSG_ENABLEDSUIONLY, and ICAP_UNITS (pixels only, as the
source reports). The camera-backed paths cannot be run without a camera.
---
diff --git a/dlls/gphoto2.ds/capability.c b/dlls/gphoto2.ds/capability.c
index dbbf2a0..68161ca 100644
--- a/dlls/gphoto2.ds/capability.c
+++ b/dlls/gphoto2.ds/capability.c
@@ -514,8 +514,8 @@ static TW_UINT16 GPHOTO2_ICAPUnits (pTW_CAPABILITY pCapability, TW_UINT16 action
 
                 if (!GPHOTO2_OneValueGet16 (pCapability, &units))
                     return TWCC_LOWMEMORY;
-		FIXME("SET to type %d, stub.\n", units);
-		return TWCC_SUCCESS;
+		/* pictures are measured in pixels: that is the only unit there is */
+		return units == TWUN_PIXELS ? TWCC_SUCCESS : TWCC_BADVALUE;
             }
             if (pCapability->ConType == TWON_ENUMERATION)
 	    {
@@ -525,14 +525,14 @@ static TW_UINT16 GPHOTO2_ICAPUnits (pTW_CAPABILITY pCapability, TW_UINT16 action
                 if (!GPHOTO2_EnumGet16 (pCapability, &nrofvalues, &values))
                     return TWCC_LOWMEMORY;
 		for (i=0;i<nrofvalues;i++)
-		    FIXME("SET: enum element %d = %d\n", i, values[i]);
+		    if (values[i] == TWUN_PIXELS) break;
 		HeapFree (GetProcessHeap(), 0, values);
-		return TWCC_SUCCESS;
+		return i < nrofvalues ? TWCC_SUCCESS : TWCC_BADVALUE;
 	    }
 	    FIXME("Unhandled container type %d in MSG_SET\n", pCapability->ConType);
             break;
         case MSG_GETCURRENT:
-            if (!GPHOTO2_OneValueSet16 (pCapability, TWUN_INCHES))
+            if (!GPHOTO2_OneValueSet16 (pCapability, TWUN_PIXELS))
                 return TWCC_LOWMEMORY;
             break;
         case MSG_GETDEFAULT:
