From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: Implement IAMDirectSound::SetFocusWindow and GetFocusWindow.

The DirectSound renderer implements IAMDirectSound::SetFocusWindow and
GetFocusWindow, as the documentation of the interface says it does. The
window becomes the DirectSound object's cooperative window (the desktop
when it is NULL), and when the sound must not stay audible without the
focus, the buffer the next connection creates is not a global-focus one.
GetFocusWindow returns them, NULL and TRUE before any call, E_POINTER for a
NULL argument.

Gate: test/quartz-dsound-focus-gate.sh (64/32).
---
 dlls/quartz/dsoundrender.c | 39 +++++++++++++++++++++++++++++++--------
 1 file changed, 31 insertions(+), 8 deletions(-)

diff --git a/dlls/quartz/dsoundrender.c b/dlls/quartz/dsoundrender.c
index 3caee49..0a1c80b 100644
--- a/dlls/quartz/dsoundrender.c
+++ b/dlls/quartz/dsoundrender.c
@@ -68,6 +68,10 @@ struct dsound_render
 
     IDirectSound8 *dsound;
     LPDIRECTSOUNDBUFFER dsbuffer;
+    /* IAMDirectSound::SetFocusWindow: the window playback belongs to and
+     * whether the sound stays audible when it loses the focus */
+    HWND focus_window;
+    BOOL focus_audible;
     DWORD buf_size;
     DWORD last_playpos, writepos;
 
@@ -467,8 +471,10 @@ static HRESULT dsound_render_sink_connect(struct strmbase_sink *iface, IPin *pee
     memset(&buf_desc,0,sizeof(DSBUFFERDESC));
     buf_desc.dwSize = sizeof(DSBUFFERDESC);
     buf_desc.dwFlags = DSBCAPS_CTRLVOLUME | DSBCAPS_CTRLPAN |
-                       DSBCAPS_CTRLFREQUENCY | DSBCAPS_GLOBALFOCUS |
-                       DSBCAPS_GETCURRENTPOSITION2;
+                       DSBCAPS_CTRLFREQUENCY | DSBCAPS_GETCURRENTPOSITION2;
+    /* without a focus window, or audible without the focus, it plays whatever has the focus */
+    if (!filter->focus_window || filter->focus_audible)
+        buf_desc.dwFlags |= DSBCAPS_GLOBALFOCUS;
     buf_desc.dwBufferBytes = filter->buf_size;
     buf_desc.lpwfxFormat = (WAVEFORMATEX *)format;
     hr = IDirectSound8_CreateSoundBuffer(filter->dsound, &buf_desc, &filter->dsbuffer, NULL);
@@ -982,15 +988,26 @@ static HRESULT WINAPI direct_sound_ReleaseSecondaryBufferInterface(IAMDirectSoun
     return E_NOTIMPL;
 }
 
+/* The DirectSound renderer implements these two methods of the interface
+ * (IAMDirectSound docs). The window becomes the cooperative window of the
+ * DirectSound object; whether the sound stays audible without the focus
+ * applies to the sound buffer the next connection creates. */
 static HRESULT WINAPI direct_sound_SetFocusWindow(IAMDirectSound *iface, HWND hwnd, BOOL bgaudible)
 {
     struct dsound_render *filter = impl_from_IAMDirectSound(iface);
+    HRESULT hr;
 
     TRACE("(%p/%p)->(%p,%d)\n", filter, iface, hwnd, bgaudible);
 
-    /* The DirectSound renderer does not hand out its DirectSound objects or
-     * take a focus window through this obsolete interface. */
-    return E_NOTIMPL;
+    if (FAILED(hr = IDirectSound8_SetCooperativeLevel(filter->dsound, hwnd ? hwnd : GetDesktopWindow(), DSSCL_PRIORITY)))
+        return hr;
+    EnterCriticalSection(&filter->filter.filter_cs);
+    filter->focus_window = hwnd;
+#ifndef SG_MUTANT_FOCUS_AUDIBLE_LOST
+    filter->focus_audible = bgaudible;
+#endif
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI direct_sound_GetFocusWindow(IAMDirectSound *iface, HWND *hwnd, BOOL *bgaudible)
@@ -999,9 +1016,13 @@ static HRESULT WINAPI direct_sound_GetFocusWindow(IAMDirectSound *iface, HWND *h
 
     TRACE("(%p/%p)->(%p,%p)\n", filter, iface, hwnd, bgaudible);
 
-    /* The DirectSound renderer does not hand out its DirectSound objects or
-     * take a focus window through this obsolete interface. */
-    return E_NOTIMPL;
+    if (!hwnd || !bgaudible)
+        return E_POINTER;
+    EnterCriticalSection(&filter->filter.filter_cs);
+    *hwnd = filter->focus_window;
+    *bgaudible = filter->focus_audible;
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return S_OK;
 }
 
 static const IAMDirectSoundVtbl direct_sound_vtbl =
@@ -1106,6 +1127,8 @@ HRESULT dsound_render_create(IUnknown *outer, IUnknown **out)
         return hr;
     }
 
+    object->focus_audible = TRUE;
+
     if (FAILED(hr = DirectSoundCreate8(NULL, &object->dsound, NULL)))
     {
         IUnknown_Release(object->system_clock);
