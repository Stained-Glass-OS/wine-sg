From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmp: IWMPPlayer4::mediaCollection and IWMPMediaCollection

Stub (E_NOTIMPL + FIXME), as documented now.

get_mediaCollection returns an object embedded in the control (shares its
reference count; IUnknown/IDispatch/IWMPMediaCollection, IDispatch through the
type library). The player has no media library, so it answers as an empty one:
getAll and getByName/Genre/Author/Album/Attribute return empty playlists,
getAttributeStringCollection an empty IWMPStringCollection (count 0, Item is
E_INVALIDARG), getMediaAtom S_FALSE with atom 0, isDeleted VARIANT_FALSE,
setDeleted and remove S_FALSE (the item is not in the library), add returns a
media item for the URL (it is not kept). NULL out pointers are E_POINTER, NULL
or empty required strings E_INVALIDARG. IWMPPlayer::get_mediaCollection
forwards to it.
Gate: test/wmp-collections-gate.sh.

---
diff --git a/dlls/wmp/player.c b/dlls/wmp/player.c
--- a/dlls/wmp/player.c
+++ b/dlls/wmp/player.c
@@ -407,8 +407,13 @@ static HRESULT WINAPI WMPPlayer4_put_currentMedia(IWMPPlayer4 *iface, IWMPMedia
 static HRESULT WINAPI WMPPlayer4_get_mediaCollection(IWMPPlayer4 *iface, IWMPMediaCollection **ppMediaCollection)
 {
     WindowsMediaPlayer *This = impl_from_IWMPPlayer4(iface);
-    FIXME("(%p)->(%p)\n", This, ppMediaCollection);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppMediaCollection);
+
+    if (!ppMediaCollection)
+        return E_POINTER;
+    IWMPMediaCollection_AddRef(*ppMediaCollection = &This->IWMPMediaCollection_iface);
+    return S_OK;
 }
 
 static HRESULT WINAPI WMPPlayer4_get_playlistCollection(IWMPPlayer4 *iface, IWMPPlaylistCollection **ppPlaylistCollection)
@@ -3180,6 +3185,291 @@ static const IWMPPlaylistVtbl WMPPlaylistVtbl = {
     WMPPlaylist_moveItem
 };
 
+/* The player has no media library, playlist store, drive or DVD of its own:
+ * these objects report the empty answers of a control embedded in a host that
+ * has none (counts of zero, empty arrays, S_FALSE/"not available" results). */
+#define WMP_IDISPATCH_METHODS(prefix, type, tid) \
+static HRESULT WINAPI prefix##_GetTypeInfoCount(type *iface, UINT *pctinfo) \
+{ \
+    TRACE("(%p)\n", iface); \
+    return dispatch_GetTypeInfoCount(pctinfo); \
+} \
+static HRESULT WINAPI prefix##_GetTypeInfo(type *iface, UINT iTInfo, LCID lcid, ITypeInfo **ppTInfo) \
+{ \
+    TRACE("(%p)\n", iface); \
+    return dispatch_GetTypeInfo(tid, iTInfo, lcid, ppTInfo); \
+} \
+static HRESULT WINAPI prefix##_GetIDsOfNames(type *iface, REFIID riid, LPOLESTR *rgszNames, UINT cNames, \
+        LCID lcid, DISPID *rgDispId) \
+{ \
+    TRACE("(%p)\n", iface); \
+    return dispatch_GetIDsOfNames(tid, rgszNames, cNames, lcid, rgDispId); \
+} \
+static HRESULT WINAPI prefix##_Invoke(type *iface, DISPID dispIdMember, REFIID riid, LCID lcid, WORD wFlags, \
+        DISPPARAMS *pDispParams, VARIANT *pVarResult, EXCEPINFO *pExcepInfo, UINT *puArgErr) \
+{ \
+    TRACE("(%p)\n", iface); \
+    return dispatch_Invoke(tid, iface, dispIdMember, lcid, wFlags, pDispParams, pVarResult, pExcepInfo, puArgErr); \
+}
+
+/* sub-objects embedded in the control share its reference count */
+#define WMP_EMBEDDED_UNKNOWN(prefix, type, iid, field) \
+static HRESULT WINAPI prefix##_QueryInterface(type *iface, REFIID riid, void **ppv) \
+{ \
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, &iid)) \
+    { \
+        *ppv = iface; \
+        IUnknown_AddRef((IUnknown *)*ppv); \
+        return S_OK; \
+    } \
+    WARN("Unsupported interface (%s)\n", wine_dbgstr_guid(riid)); \
+    *ppv = NULL; \
+    return E_NOINTERFACE; \
+} \
+static ULONG WINAPI prefix##_AddRef(type *iface) \
+{ \
+    WindowsMediaPlayer *This = CONTAINING_RECORD(iface, WindowsMediaPlayer, field); \
+    return IOleObject_AddRef(&This->IOleObject_iface); \
+} \
+static ULONG WINAPI prefix##_Release(type *iface) \
+{ \
+    WindowsMediaPlayer *This = CONTAINING_RECORD(iface, WindowsMediaPlayer, field); \
+    return IOleObject_Release(&This->IOleObject_iface); \
+}
+
+/* IWMPStringCollection and IWMPPlaylistArray: always empty (count 0) */
+typedef struct {
+    IWMPStringCollection IWMPStringCollection_iface;
+    LONG ref;
+} WMPStringCollection;
+
+static HRESULT empty_count(LONG *count)
+{
+    if (!count)
+        return E_POINTER;
+#ifdef SG_MUTANT_WMP_EMPTYLIST_COUNT
+    *count = 1;
+#else
+    *count = 0;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI WMPStringCollection_QueryInterface(IWMPStringCollection *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch)
+            || IsEqualGUID(riid, &IID_IWMPStringCollection))
+    {
+        *ppv = iface;
+        IUnknown_AddRef((IUnknown *)iface);
+        return S_OK;
+    }
+    WARN("Unsupported interface (%s)\n", wine_dbgstr_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI WMPStringCollection_AddRef(IWMPStringCollection *iface)
+{
+    WMPStringCollection *This = CONTAINING_RECORD(iface, WMPStringCollection, IWMPStringCollection_iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI WMPStringCollection_Release(IWMPStringCollection *iface)
+{
+    WMPStringCollection *This = CONTAINING_RECORD(iface, WMPStringCollection, IWMPStringCollection_iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+        free(This);
+    return ref;
+}
+
+WMP_IDISPATCH_METHODS(WMPStringCollection, IWMPStringCollection, IWMPStringCollection_tid)
+
+static HRESULT WINAPI WMPStringCollection_get_count(IWMPStringCollection *iface, LONG *plCount)
+{
+    TRACE("(%p)->(%p)\n", iface, plCount);
+    return empty_count(plCount);
+}
+
+static HRESULT WINAPI WMPStringCollection_Item(IWMPStringCollection *iface, LONG lIndex, BSTR *pbstrString)
+{
+    TRACE("(%p)->(%ld %p)\n", iface, lIndex, pbstrString);
+    if (!pbstrString)
+        return E_POINTER;
+    *pbstrString = NULL;
+    return E_INVALIDARG;
+}
+
+static const IWMPStringCollectionVtbl WMPStringCollectionVtbl = {
+    WMPStringCollection_QueryInterface,
+    WMPStringCollection_AddRef,
+    WMPStringCollection_Release,
+    WMPStringCollection_GetTypeInfoCount,
+    WMPStringCollection_GetTypeInfo,
+    WMPStringCollection_GetIDsOfNames,
+    WMPStringCollection_Invoke,
+    WMPStringCollection_get_count,
+    WMPStringCollection_Item,
+};
+
+static HRESULT create_string_collection(IWMPStringCollection **out)
+{
+    WMPStringCollection *coll;
+
+    *out = NULL;
+    if (!(coll = calloc(1, sizeof(*coll))))
+        return E_OUTOFMEMORY;
+    coll->IWMPStringCollection_iface.lpVtbl = &WMPStringCollectionVtbl;
+    coll->ref = 1;
+    *out = &coll->IWMPStringCollection_iface;
+    return S_OK;
+}
+
+static HRESULT create_empty_playlist(IWMPPlaylist **out)
+{
+    HRESULT hr;
+    BSTR name = SysAllocString(L"");
+
+    if (!name)
+        return E_OUTOFMEMORY;
+    hr = create_playlist(name, NULL, 0, out);
+    SysFreeString(name);
+    return hr;
+}
+
+static HRESULT WINAPI WMPMediaCollection_add(IWMPMediaCollection *iface, BSTR url, IWMPMedia **ppItem)
+{
+    TRACE("(%p)->(%s %p)\n", iface, debugstr_w(url), ppItem);
+
+    if (!ppItem)
+        return E_POINTER;
+    *ppItem = NULL;
+    if (!url || !*url)
+        return E_INVALIDARG;
+    /* nothing is stored: the item is returned but never listed by getAll() */
+    return create_media_from_url(url, 0.0, ppItem);
+}
+
+static HRESULT WINAPI WMPMediaCollection_getAll(IWMPMediaCollection *iface, IWMPPlaylist **ppMediaItems)
+{
+    TRACE("(%p)->(%p)\n", iface, ppMediaItems);
+
+    if (!ppMediaItems)
+        return E_POINTER;
+    *ppMediaItems = NULL;
+#ifdef SG_MUTANT_WMP_MEDIACOLL_NOALL
+    return S_OK;
+#else
+    return create_empty_playlist(ppMediaItems);
+#endif
+}
+
+#define MEDIA_COLLECTION_QUERY(name, arg) \
+static HRESULT WINAPI WMPMediaCollection_##name(IWMPMediaCollection *iface, BSTR arg, IWMPPlaylist **ppMediaItems) \
+{ \
+    TRACE("(%p)->(%s %p)\n", iface, debugstr_w(arg), ppMediaItems); \
+    if (!ppMediaItems) \
+        return E_POINTER; \
+    *ppMediaItems = NULL; \
+    if (!arg) \
+        return E_INVALIDARG; \
+    return create_empty_playlist(ppMediaItems); \
+}
+MEDIA_COLLECTION_QUERY(getByName, bstrName)
+MEDIA_COLLECTION_QUERY(getByGenre, bstrGenre)
+MEDIA_COLLECTION_QUERY(getByAuthor, bstrAuthor)
+MEDIA_COLLECTION_QUERY(getByAlbum, bstrAlbum)
+#undef MEDIA_COLLECTION_QUERY
+
+static HRESULT WINAPI WMPMediaCollection_getByAttribute(IWMPMediaCollection *iface, BSTR attr, BSTR value,
+        IWMPPlaylist **ppMediaItems)
+{
+    TRACE("(%p)->(%s %s %p)\n", iface, debugstr_w(attr), debugstr_w(value), ppMediaItems);
+
+    if (!ppMediaItems)
+        return E_POINTER;
+    *ppMediaItems = NULL;
+    if (!attr || !value)
+        return E_INVALIDARG;
+    return create_empty_playlist(ppMediaItems);
+}
+
+/* an item that is not in the (empty) library cannot be removed */
+static HRESULT WINAPI WMPMediaCollection_remove(IWMPMediaCollection *iface, IWMPMedia *pItem,
+        VARIANT_BOOL fDeleteFile)
+{
+    TRACE("(%p)->(%p %d)\n", iface, pItem, fDeleteFile);
+    return pItem ? S_FALSE : E_POINTER;
+}
+
+static HRESULT WINAPI WMPMediaCollection_getAttributeStringCollection(IWMPMediaCollection *iface, BSTR attr,
+        BSTR media_type, IWMPStringCollection **ppStringCollection)
+{
+    TRACE("(%p)->(%s %s %p)\n", iface, debugstr_w(attr), debugstr_w(media_type), ppStringCollection);
+
+    if (!ppStringCollection)
+        return E_POINTER;
+    *ppStringCollection = NULL;
+    if (!attr || !media_type)
+        return E_INVALIDARG;
+    return create_string_collection(ppStringCollection);
+}
+
+/* the library has no attribute atoms to hand out */
+static HRESULT WINAPI WMPMediaCollection_getMediaAtom(IWMPMediaCollection *iface, BSTR name, LONG *plAtom)
+{
+    TRACE("(%p)->(%s %p)\n", iface, debugstr_w(name), plAtom);
+
+    if (!plAtom)
+        return E_POINTER;
+    *plAtom = 0;
+    return name ? S_FALSE : E_INVALIDARG;
+}
+
+static HRESULT WINAPI WMPMediaCollection_setDeleted(IWMPMediaCollection *iface, IWMPMedia *pItem,
+        VARIANT_BOOL fIsDeleted)
+{
+    TRACE("(%p)->(%p %d)\n", iface, pItem, fIsDeleted);
+    return pItem ? S_FALSE : E_POINTER;
+}
+
+static HRESULT WINAPI WMPMediaCollection_isDeleted(IWMPMediaCollection *iface, IWMPMedia *pItem,
+        VARIANT_BOOL *pfIsDeleted)
+{
+    TRACE("(%p)->(%p %p)\n", iface, pItem, pfIsDeleted);
+
+    if (!pfIsDeleted)
+        return E_POINTER;
+    *pfIsDeleted = VARIANT_FALSE;
+    return pItem ? S_OK : E_POINTER;
+}
+
+WMP_EMBEDDED_UNKNOWN(WMPMediaCollection, IWMPMediaCollection, IID_IWMPMediaCollection, IWMPMediaCollection_iface)
+WMP_IDISPATCH_METHODS(WMPMediaCollection, IWMPMediaCollection, IWMPMediaCollection_tid)
+
+static const IWMPMediaCollectionVtbl WMPMediaCollectionVtbl = {
+    WMPMediaCollection_QueryInterface,
+    WMPMediaCollection_AddRef,
+    WMPMediaCollection_Release,
+    WMPMediaCollection_GetTypeInfoCount,
+    WMPMediaCollection_GetTypeInfo,
+    WMPMediaCollection_GetIDsOfNames,
+    WMPMediaCollection_Invoke,
+    WMPMediaCollection_add,
+    WMPMediaCollection_getAll,
+    WMPMediaCollection_getByName,
+    WMPMediaCollection_getByGenre,
+    WMPMediaCollection_getByAuthor,
+    WMPMediaCollection_getByAlbum,
+    WMPMediaCollection_getByAttribute,
+    WMPMediaCollection_remove,
+    WMPMediaCollection_getAttributeStringCollection,
+    WMPMediaCollection_getMediaAtom,
+    WMPMediaCollection_setDeleted,
+    WMPMediaCollection_isDeleted,
+};
+
 static HRESULT WINAPI WMPError_QueryInterface(IWMPError *iface, REFIID riid, void **ppv)
 {
     if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, &IID_IWMPError))
@@ -3440,6 +3730,7 @@ BOOL init_player(WindowsMediaPlayer *wmp)
     wmp->IWMPNetwork_iface.lpVtbl = &WMPNetworkVtbl;
     wmp->IWMPError_iface.lpVtbl = &WMPErrorVtbl;
     wmp->IWMPClosedCaption_iface.lpVtbl = &WMPClosedCaptionVtbl;
+    wmp->IWMPMediaCollection_iface.lpVtbl = &WMPMediaCollectionVtbl;
 
     name = SysAllocString(L"Playlist1");
     if (SUCCEEDED(create_playlist(name, NULL, 0, &playlist)))
diff --git a/dlls/wmp/wmp_private.h b/dlls/wmp/wmp_private.h
--- a/dlls/wmp/wmp_private.h
+++ b/dlls/wmp/wmp_private.h
@@ -33,6 +33,8 @@
     XIID(IWMPPlaylist) \
     XIID(IWMPError) \
     XIID(IWMPClosedCaption) \
+    XIID(IWMPMediaCollection) \
+    XIID(IWMPStringCollection) \
     CTID(WindowsMediaPlayer)
 
 typedef enum {
@@ -115,6 +117,7 @@ struct WindowsMediaPlayer {
     IWMPNetwork IWMPNetwork_iface;
     IWMPError IWMPError_iface;
     IWMPClosedCaption IWMPClosedCaption_iface;
+    IWMPMediaCollection IWMPMediaCollection_iface;
 
     LONG ref;
 
