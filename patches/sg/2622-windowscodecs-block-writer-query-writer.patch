+/* The identifier a child directory has in its parent: the Exif and GPS directories are the
+ * values of their pointer tags, anything else is numbered. */
+static void mqw_child_id(const GUID *child, UINT index, PROPVARIANT *id)
+{
+    PropVariantInit(id);
+    id->vt = VT_UI2;
+    if (IsEqualGUID(child, &GUID_MetadataFormatExif)) id->uiVal = 0x8769;
+    else if (IsEqualGUID(child, &GUID_MetadataFormatGps)) id->uiVal = 0x8825;
+    else id->uiVal = index;
+}
+
+/* The writer inside an item of a writer, the index-th one of the format. */
+static HRESULT mqw_find_child(IWICMetadataWriter *parent, const GUID *format, UINT index, IWICMetadataWriter **child,
+        PROPVARIANT *child_id)
+{
+    IWICMetadataReader *reader;
+    UINT count, i, matched = 0;
+    HRESULT hr;
+
+    *child = NULL;
+    if (FAILED(hr = IWICMetadataWriter_QueryInterface(parent, &IID_IWICMetadataReader, (void **)&reader)))
+        return hr;
+    if (FAILED(hr = IWICMetadataReader_GetCount(reader, &count)))
+    {
+        IWICMetadataReader_Release(reader);
+        return hr;
+    }
+    hr = WINCODEC_ERR_PROPERTYNOTFOUND;
+    for (i = 0; i < count; ++i)
+    {
+        PROPVARIANT id, value;
+        IWICMetadataReader *nested;
+        GUID nested_format;
+
+        PropVariantInit(&id);
+        PropVariantInit(&value);
+        if (FAILED(IWICMetadataReader_GetValueByIndex(reader, i, NULL, &id, &value))) continue;
+        if (value.vt == VT_UNKNOWN && value.punkVal
+                && SUCCEEDED(IUnknown_QueryInterface(value.punkVal, &IID_IWICMetadataReader, (void **)&nested)))
+        {
+            BOOL match = SUCCEEDED(IWICMetadataReader_GetMetadataFormat(nested, &nested_format))
+                    && IsEqualGUID(&nested_format, format) && matched++ == index;
+
+            IWICMetadataReader_Release(nested);
+            if (match)
+            {
+                hr = IUnknown_QueryInterface(value.punkVal, &IID_IWICMetadataWriter, (void **)child);
+                if (FAILED(hr)) hr = WINCODEC_ERR_UNSUPPORTEDOPERATION;
+                if (child_id) *child_id = id; else PropVariantClear(&id);
+                PropVariantClear(&value);
+                break;
+            }
+        }
+        PropVariantClear(&id);
+        PropVariantClear(&value);
+    }
+    IWICMetadataReader_Release(reader);
+    return hr;
+}
+
+static HRESULT mqw_create_writer(const GUID *format, IWICMetadataWriter **writer)
+{
+    IWICComponentFactory *factory;
+    HRESULT hr;
+
+    if (FAILED(hr = create_instance(&CLSID_WICImagingFactory, &IID_IWICComponentFactory, (void **)&factory)))
+        return hr;
+    hr = IWICComponentFactory_CreateMetadataWriter(factory, format, NULL, 0, writer);
+    IWICComponentFactory_Release(factory);
+    return hr;
+}
+
+/* The block writer's writer of a format, the index-th one. */
+static HRESULT mqw_find_top(IWICMetadataBlockWriter *block, const GUID *format, UINT index, IWICMetadataWriter **writer,
+        UINT *position)
+{
+    UINT count, i, matched = 0;
+    HRESULT hr;
+
+    *writer = NULL;
+    if (FAILED(hr = IWICMetadataBlockWriter_GetCount(block, &count))) return hr;
+    for (i = 0; i < count; ++i)
+    {
+        IWICMetadataWriter *w;
+        GUID found;
+
+        if (FAILED(hr = IWICMetadataBlockWriter_GetWriterByIndex(block, i, &w))) return hr;
+        if (SUCCEEDED(IWICMetadataWriter_GetMetadataFormat(w, &found)) && IsEqualGUID(&found, format)
+                && matched++ == index)
+        {
+            *writer = w;
+            if (position) *position = i;
+            return S_OK;
+        }
+        IWICMetadataWriter_Release(w);
+    }
+    return WINCODEC_ERR_PROPERTYNOTFOUND;
+}
+
+/* Walks the query down to the item or the block it names and sets, or removes, it. Blocks on the way
+ * that do not exist are made when setting. */
+static HRESULT mqw_modify(QueryWriter *This, const WCHAR *name, const PROPVARIANT *value, BOOL remove)
+{
+    IWICMetadataWriter *current = NULL, *parent = NULL;
+    PROPVARIANT tk_id, tk_schema;
+    PROPVARIANT parent_child_id;
+    BOOL have_parent_id = FALSE;
+    WCHAR *full_query;
+    const WCHAR *p;
+    struct string_t elem;
+    UINT position = 0;
+    HRESULT hr = S_OK;
+    int index;
+    GUID guid;
+    BOOL done = FALSE;
+
+    full_query = malloc((lstrlenW(name) + (This->root ? lstrlenW(This->root) : 0) + 1) * sizeof(WCHAR));
+    if (!full_query) return E_OUTOFMEMORY;
+    full_query[0] = 0;
+    if (This->root) lstrcpyW(full_query, This->root);
+    lstrcatW(full_query, name);
+
+    PropVariantInit(&tk_id);
+    PropVariantInit(&tk_schema);
+    PropVariantInit(&parent_child_id);
+    p = full_query;
+
+    if (*p != '/')
+    {
+        free(full_query);
+        return WINCODEC_ERR_PROPERTYNOTSUPPORTED;
+    }
+
+    while (*p && SUCCEEDED(hr) && !done)
+    {
+        if (*p != '/') { hr = WINCODEC_ERR_PROPERTYNOTSUPPORTED; break; }
+        ++p;
+
+        index = INDEX_NONE;
+        elem.str = p;
+        elem.len = lstrlenW(p);
+        hr = get_token(&elem, &tk_id, &tk_schema, &index);
+        if (hr != S_OK) break;
+        if (!elem.len) { hr = WINCODEC_ERR_INVALIDQUERYREQUEST; break; }
+
+        if (tk_id.vt == VT_CLSID || (tk_id.vt == VT_BSTR && WICMapShortNameToGuid(tk_id.bstrVal, &guid) == S_OK))
+        {
+            IWICMetadataWriter *next = NULL;
+            BOOL last;
+
+            if (tk_id.vt == VT_CLSID) guid = *tk_id.puuid;
+            if (index == INDEX_ALL) { hr = DISP_E_TYPEMISMATCH; break; }
+            if (index == INDEX_NONE) index = 0;
+            last = !p[elem.len];
+
+            if (!current)
+            {
+                hr = mqw_find_top(This->block, &guid, index, &next, &position);
+#ifdef SG_MUTANT_MDB_QW_NO_CREATE
+                if (0)
+#else
+                if (hr == WINCODEC_ERR_PROPERTYNOTFOUND && !remove)
+#endif
+                {
+                    UINT same = 0, i, count;
+
+                    /* only the next one of a format can be made */
+                    IWICMetadataBlockWriter_GetCount(This->block, &count);
+                    for (i = 0; i < count; ++i)
+                    {
+                        IWICMetadataWriter *w;
+                        GUID found;
+
+                        if (SUCCEEDED(IWICMetadataBlockWriter_GetWriterByIndex(This->block, i, &w)))
+                        {
+                            if (SUCCEEDED(IWICMetadataWriter_GetMetadataFormat(w, &found)) && IsEqualGUID(&found, &guid))
+                                ++same;
+                            IWICMetadataWriter_Release(w);
+                        }
+                    }
+                    if ((UINT)index != same) { hr = WINCODEC_ERR_PROPERTYNOTFOUND; break; }
+                    if (last && value) { hr = E_INVALIDARG; break; }
+                    if (SUCCEEDED(hr = mqw_create_writer(&guid, &next)))
+                    {
+                        hr = IWICMetadataBlockWriter_AddWriter(This->block, next);
+                        if (FAILED(hr)) { IWICMetadataWriter_Release(next); next = NULL; }
+                    }
+                }
+                if (FAILED(hr)) break;
+                if (last && remove)
+                {
+                    IWICMetadataWriter_Release(next);
+                    hr = IWICMetadataBlockWriter_RemoveWriterByIndex(This->block, position);
+                    done = TRUE;
+                    break;
+                }
+            }
+            else
+            {
+                PROPVARIANT child_id;
+
+                PropVariantInit(&child_id);
+                hr = mqw_find_child(current, &guid, index, &next, &child_id);
+                if (hr == WINCODEC_ERR_PROPERTYNOTFOUND && !remove)
+                {
+                    PROPVARIANT child_value;
+
+                    if (last && value) { hr = E_INVALIDARG; break; }
+                    if (SUCCEEDED(hr = mqw_create_writer(&guid, &next)))
+                    {
+                        mqw_child_id(&guid, index, &child_id);
+                        PropVariantInit(&child_value);
+                        child_value.vt = VT_UNKNOWN;
+                        child_value.punkVal = (IUnknown *)next;
+                        hr = IWICMetadataWriter_SetValue(current, NULL, &child_id, &child_value);
+                        if (FAILED(hr)) { IWICMetadataWriter_Release(next); next = NULL; }
+                    }
+                }
+                if (FAILED(hr)) { PropVariantClear(&child_id); break; }
+                if (last && remove)
+                {
+                    IWICMetadataWriter_Release(next);
+                    hr = IWICMetadataWriter_RemoveValue(current, NULL, &child_id);
+                    PropVariantClear(&child_id);
+                    done = TRUE;
+                    break;
+                }
+                PropVariantClear(&parent_child_id);
+                parent_child_id = child_id;
+                have_parent_id = TRUE;
+            }
+            if (parent) IWICMetadataWriter_Release(parent);
+            parent = current;
+            current = next;
+        }
+        else
+        {
+            PROPVARIANT schema, id;
+
+            if (!current) { hr = WINCODEC_ERR_INVALIDQUERYREQUEST; break; }
+            if (p[elem.len]) { hr = WINCODEC_ERR_INVALIDQUERYREQUEST; break; }  /* an item is the end of the query */
+            if (index == INDEX_ALL) { hr = WINCODEC_ERR_REQUESTONLYVALIDATMETADATAROOT; break; }
+            if (index != INDEX_NONE) { hr = E_INVALIDARG; break; }
+
+            if (tk_schema.vt == VT_BSTR)
+            {
+                GUID format;
+
+                if (FAILED(hr = IWICMetadataWriter_GetMetadataFormat(current, &format))) break;
+                schema.vt = VT_LPWSTR;
+                schema.pwszVal = (LPWSTR)map_shortname_to_schema(&format, tk_schema.bstrVal);
+                if (!schema.pwszVal) schema.pwszVal = tk_schema.bstrVal;
+            }
+            else
+                schema = tk_schema;
+            if (tk_id.vt == VT_BSTR)
+            {
+                id.vt = VT_LPWSTR;
+                id.pwszVal = tk_id.bstrVal;
+            }
+            else
+                id = tk_id;
+
+#ifdef SG_MUTANT_MDB_QW_REMOVE_KEEPS
+            if (remove)
+                hr = S_OK;
+#else
+            if (remove)
+                hr = IWICMetadataWriter_RemoveValue(current, schema.vt == VT_EMPTY ? NULL : &schema, &id);
+#endif
+            else
+                hr = IWICMetadataWriter_SetValue(current, schema.vt == VT_EMPTY ? NULL : &schema, &id, value);
+            done = TRUE;
+        }
+
+        p += elem.len;
+        PropVariantClear(&tk_id);
+        PropVariantClear(&tk_schema);
+    }
+
+    /* a query that ends with a block names the block as a whole */
+    if (SUCCEEDED(hr) && !done && !remove) hr = E_INVALIDARG;
+    if (SUCCEEDED(hr) && !done && remove) hr = WINCODEC_ERR_INVALIDQUERYREQUEST;
+
+    PropVariantClear(&tk_id);
+    PropVariantClear(&tk_schema);
+    PropVariantClear(&parent_child_id);
+    (void)have_parent_id;
+    if (current) IWICMetadataWriter_Release(current);
+    if (parent) IWICMetadataWriter_Release(parent);
+    free(full_query);
+    return hr;
 }
 
