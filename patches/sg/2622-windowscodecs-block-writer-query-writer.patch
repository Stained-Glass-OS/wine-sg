+/* ---- the writers of a frame ---- */
+
+void md_block_list_clear(struct md_block_list *list)
+{
+    UINT i;
+
+    for (i = 0; i < list->count; ++i)
+        IWICMetadataWriter_Release(list->writers[i]);
+    free(list->writers);
+    memset(list, 0, sizeof(*list));
+}
+
+HRESULT md_block_list_get_count(struct md_block_list *list, UINT *count)
+{
+    if (!count) return E_INVALIDARG;
+    *count = list->count;
+    return S_OK;
+}
+
+HRESULT md_block_list_get_writer(struct md_block_list *list, UINT index, IWICMetadataWriter **writer)
+{
+    if (!writer) return E_INVALIDARG;
+    *writer = NULL;
+#ifdef SG_MUTANT_MDB_OUT_OF_RANGE_OK
+    if (index >= list->count) return E_INVALIDARG;
+#else
+    if (index >= list->count) return WINCODEC_ERR_VALUEOUTOFRANGE;
+#endif
+    *writer = list->writers[index];
+    IWICMetadataWriter_AddRef(*writer);
+    return S_OK;
+}
+
+HRESULT md_block_list_get_reader(struct md_block_list *list, UINT index, IWICMetadataReader **reader)
+{
+    if (!reader) return E_INVALIDARG;
+    *reader = NULL;
+    if (index >= list->count) return WINCODEC_ERR_VALUEOUTOFRANGE;
+    return IWICMetadataWriter_QueryInterface(list->writers[index], &IID_IWICMetadataReader, (void **)reader);
+}
+
+HRESULT md_block_list_add(struct md_block_list *list, IWICMetadataWriter *writer)
+{
+    if (!writer) return E_INVALIDARG;
+    if (list->count == list->capacity)
+    {
+        UINT capacity = list->capacity ? list->capacity * 2 : 4;
+        IWICMetadataWriter **writers = realloc(list->writers, capacity * sizeof(*writers));
+
+        if (!writers) return E_OUTOFMEMORY;
+        list->writers = writers;
+        list->capacity = capacity;
+    }
+    IWICMetadataWriter_AddRef(writer);
+    list->writers[list->count++] = writer;
+    return S_OK;
+}
+
+HRESULT md_block_list_set(struct md_block_list *list, UINT index, IWICMetadataWriter *writer)
+{
+    if (!writer) return E_INVALIDARG;
+    if (index >= list->count) return WINCODEC_ERR_VALUEOUTOFRANGE;
+#ifdef SG_MUTANT_MDB_SET_APPENDS
+    return md_block_list_add(list, writer);
+#endif
+    IWICMetadataWriter_AddRef(writer);
+    IWICMetadataWriter_Release(list->writers[index]);
+    list->writers[index] = writer;
+    return S_OK;
+}
+
+HRESULT md_block_list_remove(struct md_block_list *list, UINT index)
+{
+    if (index >= list->count) return WINCODEC_ERR_VALUEOUTOFRANGE;
+    IWICMetadataWriter_Release(list->writers[index]);
+    memmove(&list->writers[index], &list->writers[index + 1], (list->count - index - 1) * sizeof(*list->writers));
+    --list->count;
+    return S_OK;
+}
+
+HRESULT md_block_list_init_from_reader(struct md_block_list *list, IWICMetadataBlockReader *block_reader)
+{
+    struct md_block_list fresh = {0};
+    IWICComponentFactory *factory;
+    UINT count, i;
+    HRESULT hr;
+
+    if (!block_reader) return E_INVALIDARG;
+    if (FAILED(hr = IWICMetadataBlockReader_GetCount(block_reader, &count))) return hr;
+    if (FAILED(hr = create_instance(&CLSID_WICImagingFactory, &IID_IWICComponentFactory, (void **)&factory)))
+        return hr;
+
+    for (i = 0; i < count && SUCCEEDED(hr); ++i)
+    {
+        IWICMetadataReader *reader;
+        IWICMetadataWriter *writer;
+
+        if (FAILED(hr = IWICMetadataBlockReader_GetReaderByIndex(block_reader, i, &reader))) break;
+        hr = IWICComponentFactory_CreateMetadataWriterFromReader(factory, reader, NULL, &writer);
+        IWICMetadataReader_Release(reader);
+        if (FAILED(hr)) break;
+        hr = md_block_list_add(&fresh, writer);
+        IWICMetadataWriter_Release(writer);
+    }
+    IWICComponentFactory_Release(factory);
+
+    if (FAILED(hr))
+    {
+        md_block_list_clear(&fresh);
+        return hr;
+    }
+    /* the new writers replace the old ones */
+    md_block_list_clear(list);
+    *list = fresh;
+    return S_OK;
+}
+
+/* A snapshot of the readers. */
+struct md_reader_enum
+{
+    IEnumUnknown IEnumUnknown_iface;
+    LONG ref;
+    IUnknown **items;
+    UINT count, pos;
+};
+
+static inline struct md_reader_enum *impl_from_md_enum(IEnumUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct md_reader_enum, IEnumUnknown_iface);
+}
+
+static HRESULT WINAPI md_enum_QueryInterface(IEnumUnknown *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IEnumUnknown))
+    {
+        *out = iface;
+        IEnumUnknown_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI md_enum_AddRef(IEnumUnknown *iface)
+{
+    return InterlockedIncrement(&impl_from_md_enum(iface)->ref);
+}
+
+static ULONG WINAPI md_enum_Release(IEnumUnknown *iface)
+{
+    struct md_reader_enum *This = impl_from_md_enum(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; ++i)
+            IUnknown_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI md_enum_Next(IEnumUnknown *iface, ULONG count, IUnknown **out, ULONG *fetched)
+{
+    struct md_reader_enum *This = impl_from_md_enum(iface);
+    ULONG n = 0;
+
+    if (!out || (!fetched && count > 1)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        out[n] = This->items[This->pos++];
+        IUnknown_AddRef(out[n]);
+        ++n;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI md_enum_Skip(IEnumUnknown *iface, ULONG count)
+{
+    struct md_reader_enum *This = impl_from_md_enum(iface);
+
+    This->pos = min(This->pos + count, This->count);
+    return This->pos < This->count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI md_enum_Reset(IEnumUnknown *iface)
+{
+    impl_from_md_enum(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI md_enum_Clone(IEnumUnknown *iface, IEnumUnknown **out)
+{
+    struct md_reader_enum *This = impl_from_md_enum(iface);
+    struct md_reader_enum *copy;
+    UINT i;
+
+    if (!out) return E_INVALIDARG;
+    if (!(copy = calloc(1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    if (This->count && !(copy->items = calloc(This->count, sizeof(*copy->items))))
+    {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    copy->IEnumUnknown_iface = This->IEnumUnknown_iface;
+    copy->ref = 1;
+    copy->count = This->count;
+    copy->pos = This->pos;
+    for (i = 0; i < This->count; ++i)
+    {
+        copy->items[i] = This->items[i];
+        IUnknown_AddRef(copy->items[i]);
+    }
+    *out = &copy->IEnumUnknown_iface;
+    return S_OK;
+}
+
+static const IEnumUnknownVtbl md_enum_vtbl =
+{
+    md_enum_QueryInterface,
+    md_enum_AddRef,
+    md_enum_Release,
+    md_enum_Next,
+    md_enum_Skip,
+    md_enum_Reset,
+    md_enum_Clone,
+};
+
+HRESULT md_block_list_get_enumerator(struct md_block_list *list, IEnumUnknown **enumerator)
+{
+    struct md_reader_enum *object;
+    UINT i;
+    HRESULT hr = S_OK;
+
+    if (!enumerator) return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object)))) return E_OUTOFMEMORY;
+    if (list->count && !(object->items = calloc(list->count, sizeof(*object->items))))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    object->IEnumUnknown_iface.lpVtbl = &md_enum_vtbl;
+    object->ref = 1;
+    for (i = 0; i < list->count && SUCCEEDED(hr); ++i)
+    {
+        hr = IWICMetadataWriter_QueryInterface(list->writers[i], &IID_IUnknown, (void **)&object->items[i]);
+        if (SUCCEEDED(hr)) object->count++;
+    }
+    if (FAILED(hr))
+    {
+        IEnumUnknown_Release(&object->IEnumUnknown_iface);
+        return hr;
+    }
+    *enumerator = &object->IEnumUnknown_iface;
+    return S_OK;
+}
