+static void test_split_one(BOOL dir_in_text, BOOL is64)
+{
+    char img[MAX_PATH], symdir[MAX_PATH], dbgpath[MAX_PATH], symroot[MAX_PATH], orig[MAX_PATH];
+    BYTE cv[256];
+    DWORD cv_size = build_nb09(cv);
+    struct build b = { 0 };
+    struct timg t, o;
+    BYTE *dbgdata;
+    DWORD dbgsize;
+    IMAGE_SEPARATE_DEBUG_HEADER *sh;
+    IMAGE_DEBUG_DIRECTORY *dd;
+    IMAGE_NT_HEADERS32 nt;
+    BOOL ret;
+
+    b.is64 = is64;
+    b.relocs = TRUE;
+    b.debug = TRUE;
+    b.dir_in_text = dir_in_text;
+    b.cv = cv;
+    b.cv_size = cv_size;
+    make_path(img, "sgs.dll");
+    make_path(orig, "sgs.orig");
+    sprintf(symroot, "%ssgsyms", tmpdir);
+    CreateDirectoryA(symroot, NULL);
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    CopyFileA(img, orig, FALSE);
+    ok(load_img(orig, &o), "Cannot load the original.\n");
+
+    SetLastError(0xdeadbeef);
+    dbgpath[0] = 0;
+    ret = SplitSymbols(img, symroot, dbgpath, SPLITSYM_REMOVE_PRIVATE);
+    ok(ret, "SplitSymbols failed %lu.\n", GetLastError());
+    sprintf(symdir, "%s\\dll\\sgs.dbg", symroot);
+    ok(!_stricmp(dbgpath, symdir), "Got path %s, expected %s.\n", dbgpath, symdir);
+    ok(GetFileAttributesA(symdir) != INVALID_FILE_ATTRIBUTES, "The .DBG file is missing.\n");
+
+    ok(load_img(img, &t), "Cannot load the stripped image.\n");
+    ok(t.nt->FileHeader.Characteristics & IMAGE_FILE_DEBUG_STRIPPED, "Not marked as stripped.\n");
+    ok(img_dir(&t, IMAGE_DIRECTORY_ENTRY_DEBUG)->Size == sizeof(IMAGE_DEBUG_DIRECTORY), "Debug directory size %lu.\n",
+            img_dir(&t, IMAGE_DIRECTORY_ENTRY_DEBUG)->Size);
+    dd = (void *)img_rva(&t, img_dir(&t, IMAGE_DIRECTORY_ENTRY_DEBUG)->VirtualAddress);
+    ok(dd->Type == IMAGE_DEBUG_TYPE_MISC, "Entry type %lu.\n", dd->Type);
+    {
+        IMAGE_DEBUG_MISC *misc = (void *)(t.d + dd->PointerToRawData);
+
+        ok(misc->DataType == IMAGE_DEBUG_MISC_EXENAME && !misc->Unicode, "Misc type %lu, unicode %u.\n", misc->DataType,
+                misc->Unicode);
+        ok(!strcmp((char *)misc->Data, "sgs.dbg"), "Misc name %s.\n", (char *)misc->Data);
+        ok(misc->Length == dd->SizeOfData && !(misc->Length & 3), "Length %lu, size %lu.\n", misc->Length, dd->SizeOfData);
+    }
+    if (dir_in_text)
+    {
+        ok(t.nt->FileHeader.NumberOfSections == 3, "Got %u sections.\n", t.nt->FileHeader.NumberOfSections);
+        ok(t.size == o.size - 0x200, "File size %lu, original %lu.\n", t.size, o.size);
+        ok(t.nt->OptionalHeader.SizeOfImage == 0x4000, "SizeOfImage %#lx.\n", t.nt->OptionalHeader.SizeOfImage);
+    }
+    else
+    {
+        ok(t.nt->FileHeader.NumberOfSections == 4, "Got %u sections.\n", t.nt->FileHeader.NumberOfSections);
+        ok(t.size == o.size, "File size %lu, original %lu.\n", t.size, o.size);
+    }
+    ok(!memcmp(img_rva(&t, 0x2000), img_rva(&o, 0x2000), 0x200), "Imports changed.\n");
+    ok(!memcmp(img_rva(&t, 0x3000), img_rva(&o, 0x3000), 0x200), "Relocations changed.\n");
+    ok(!memcmp(img_rva(&t, 0x1000), img_rva(&o, 0x1000), 0x100), "The code changed.\n");
+    check_sum_valid(img, "stripped image");
+
+    /* the separate file */
+    dbgdata = read_file(symdir, &dbgsize);
+    ok(dbgdata && dbgsize > sizeof(*sh), "Cannot load the .DBG file.\n");
+    sh = (void *)dbgdata;
+    ok(sh->Signature == IMAGE_SEPARATE_DEBUG_SIGNATURE, "Signature %#x.\n", sh->Signature);
+    ok(sh->Machine == o.nt->FileHeader.Machine, "Machine %#x.\n", sh->Machine);
+    ok(sh->TimeDateStamp == o.nt->FileHeader.TimeDateStamp, "Stamp %#lx.\n", sh->TimeDateStamp);
+    ok(sh->ImageBase == (DWORD)img_base(&o), "Base %#lx.\n", sh->ImageBase);
+    ok(sh->SizeOfImage == o.nt->OptionalHeader.SizeOfImage, "Image size %#lx.\n", sh->SizeOfImage);
+    ok(sh->NumberOfSections == 4 && sh->DebugDirectorySize == 2 * sizeof(IMAGE_DEBUG_DIRECTORY),
+            "Sections %lu, directory size %lu.\n", sh->NumberOfSections, sh->DebugDirectorySize);
+    ok(sh->SectionAlignment == 0x1000, "Alignment %#lx.\n", sh->SectionAlignment);
+    ok(!memcmp(sh + 1, img_secs(&o), 4 * sizeof(IMAGE_SECTION_HEADER)), "The section headers differ.\n");
+    dd = (void *)((BYTE *)(sh + 1) + 4 * sizeof(IMAGE_SECTION_HEADER) + sh->ExportedNamesSize);
+    ok(dd[0].Type == IMAGE_DEBUG_TYPE_CODEVIEW && dd[1].Type == 9, "Types %lu, %lu.\n", dd[0].Type, dd[1].Type);
+    ok(dd[0].PointerToRawData + dd[0].SizeOfData <= dbgsize && dd[1].PointerToRawData + dd[1].SizeOfData <= dbgsize,
+            "Entries beyond the file.\n");
+    ok(!memcmp(dbgdata + dd[1].PointerToRawData, "sixteen data....", 16), "The second entry data is wrong.\n");
+    ok(dd[0].SizeOfData < cv_size && !memcmp(dbgdata + dd[0].PointerToRawData, "NB09", 4), "CodeView size %lu (was %lu).\n",
+            dd[0].SizeOfData, cv_size);
+    ok(dd[0].AddressOfRawData == 0x4040, "RVA %#lx.\n", dd[0].AddressOfRawData);
+
+    /* an image that is already stripped */
+    SetLastError(0xdeadbeef);
+    ret = SplitSymbols(img, symroot, dbgpath, 0);
+    ok(!ret && GetLastError() == ERROR_INVALID_DATA, "Got %d, %lu.\n", ret, GetLastError());
+
+    /* UpdateDebugInfoFile copies the image header values into the .DBG file */
+    memset(&nt, 0, sizeof(nt));
+    nt.FileHeader.TimeDateStamp = 0x51515151;
+    nt.OptionalHeader.CheckSum = 0x61616161;
+    nt.OptionalHeader.ImageBase = 0x22220000;
+    nt.OptionalHeader.SizeOfImage = 0x7000;
+    dbgpath[0] = 0;
+    ret = UpdateDebugInfoFile(img, symroot, dbgpath, &nt);
+    ok(ret, "UpdateDebugInfoFile failed %lu.\n", GetLastError());
+    ok(!_stricmp(dbgpath, symdir), "Path %s.\n", dbgpath);
+    HeapFree(GetProcessHeap(), 0, dbgdata);
+    dbgdata = read_file(symdir, &dbgsize);
+    sh = (void *)dbgdata;
+    ok(sh->TimeDateStamp == 0x51515151 && sh->CheckSum == 0x61616161 && sh->ImageBase == 0x22220000
+            && sh->SizeOfImage == 0x7000, "Header %#lx %#lx %#lx %#lx.\n", sh->TimeDateStamp, sh->CheckSum, sh->ImageBase,
+            sh->SizeOfImage);
+    ok(sh->NumberOfSections == 4 && sh->Machine == o.nt->FileHeader.Machine, "Other fields changed.\n");
+    HeapFree(GetProcessHeap(), 0, dbgdata);
+
+    /* the Ex variant only updates a file that has the old checksum */
+    nt.FileHeader.TimeDateStamp = 0x52525252;
+    SetLastError(0xdeadbeef);
+    ret = UpdateDebugInfoFileEx(img, symroot, dbgpath, &nt, 0x1234);
+    ok(!ret && GetLastError() == ERROR_INVALID_DATA, "Got %d, %lu.\n", ret, GetLastError());
+    dbgdata = read_file(symdir, &dbgsize);
+    ok(((IMAGE_SEPARATE_DEBUG_HEADER *)dbgdata)->TimeDateStamp == 0x51515151, "The file was changed.\n");
+    HeapFree(GetProcessHeap(), 0, dbgdata);
+    ret = UpdateDebugInfoFileEx(img, symroot, dbgpath, &nt, 0x61616161);
+    ok(ret, "UpdateDebugInfoFileEx failed %lu.\n", GetLastError());
+    dbgdata = read_file(symdir, &dbgsize);
+    ok(((IMAGE_SEPARATE_DEBUG_HEADER *)dbgdata)->TimeDateStamp == 0x52525252, "The file was not changed.\n");
+    HeapFree(GetProcessHeap(), 0, dbgdata);
+
+    SetLastError(0xdeadbeef);
+    ret = UpdateDebugInfoFile(NULL, symroot, dbgpath, &nt);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, %lu.\n", ret, GetLastError());
+
+    /* a rebased image keeps its .DBG file in step */
+    {
+        ULONG64 nbase = 0x20000000;
+        ULONG os, ns;
+        ULONG64 ob;
+
+        ret = ReBaseImage64(img, symroot, TRUE, TRUE, TRUE, 0, &os, &ob, &ns, &nbase, 0);
+        ok(ret, "ReBaseImage64 failed %lu.\n", GetLastError());
+        dbgdata = read_file(symdir, &dbgsize);
+        ok(((IMAGE_SEPARATE_DEBUG_HEADER *)dbgdata)->ImageBase == 0x1fff0000, "Base %#lx in the .DBG file.\n",
+                ((IMAGE_SEPARATE_DEBUG_HEADER *)dbgdata)->ImageBase);
+        HeapFree(GetProcessHeap(), 0, dbgdata);
+    }
+
+    free_img(&t);
+    free_img(&o);
+    DeleteFileA(symdir);
+    sprintf(symdir, "%s\\dll", symroot);
+    RemoveDirectoryA(symdir);
+    RemoveDirectoryA(symroot);
+    DeleteFileA(img);
+    DeleteFileA(orig);
+}
+
+static void test_split(void)
+{
+    test_split_one(FALSE, FALSE);
+    test_split_one(TRUE, FALSE);
+    test_split_one(TRUE, TRUE);
+}
+
+START_TEST(rewrite)
+{
+    GetTempPathA(sizeof(tmpdir), tmpdir);
+
+    test_bind();
+    test_rebase();
+    test_cv();
+    test_split();
+}
