diff --git a/dlls/imagehlp/rewrite.c b/dlls/imagehlp/rewrite.c
new file mode 100644
index 0000000..d3970ea
--- /dev/null
+++ b/dlls/imagehlp/rewrite.c
@@ -0,0 +1,1489 @@
+/*
+ * IMAGEHLP library: functions that rewrite PE files
+ * (BindImageEx, ReBaseImage, SplitSymbols, UpdateDebugInfoFile, RemovePrivateCvSymbolic)
+ *
+ * Written from the published PE/COFF format description and the documentation
+ * of the imagehlp functions.
+ *
