+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    CopyFileA(img, orig, FALSE);
+
+    /* a bind that changes nothing reports the same imports */
+    nevents = 0;
+    ret = BindImageEx(BIND_NO_UPDATE, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(files_equal(img, orig), "BIND_NO_UPDATE changed the file.\n");
+    ok(count_events(BindImportModule) == 4, "Got %u modules.\n", count_events(BindImportModule));
+    ok(count_events(BindImportProcedure) == 7, "Got %u procedures.\n", count_events(BindImportProcedure));
+    ok(count_events(BindImageModified) == 0, "Unexpected modification callback.\n");
+    e = find_event(BindImportProcedure, "export");
+    want = ref_export(tdll, "export", 0, dirs);
+    ok(e && want && e->va == (ULONG_PTR)want, "Got %p for export, expected %I64x.\n", e ? (void *)e->va : NULL, want);
+    e = find_event(BindImportProcedure, "Ordinal2");
+    want = ref_export(oleaut, "VariantInit", 0, dirs);
+    ok(want != 0, "VariantInit not in oleaut32.\n");
+    ok(e && e->va == (ULONG_PTR)want, "Ordinal import of the forwarder: %p, expected %I64x.\n", e ? (void *)e->va : NULL, want);
+    /* testdll.dll forwards two of the imports, and this implementation of shlwapi forwards ordinal 117 */
+    ok(count_events(BindForwarder) >= 2, "Got %u BindForwarder callbacks.\n", count_events(BindForwarder));
+    e = find_event(BindImportProcedure, "Ordinal117");
+    ok(e && e->va, "Ordinal import of shlwapi: %p.\n", e ? (void *)e->va : NULL);
+
+    /* no bound imports: nothing is written either */
+    nevents = 0;
+    ret = BindImageEx(BIND_NO_BOUND_IMPORTS, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(files_equal(img, orig), "BIND_NO_BOUND_IMPORTS changed the file.\n");
+
+    /* the real bind: the headers have to grow to hold the bound import directory */
+    nevents = 0;
+    ret = BindImageEx(0, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(count_events(BindImageModified) == 1, "Got %u modification callbacks.\n", count_events(BindImageModified));
+    ok(count_events(BindExpandFileHeaders) == 1, "Got %u header expansions.\n", count_events(BindExpandFileHeaders));
+    ok(load_img(img, &t) && load_img(orig, &o), "Cannot load the images.\n");
+    ok(t.nt->OptionalHeader.SizeOfHeaders == 0x400, "SizeOfHeaders %#lx.\n", t.nt->OptionalHeader.SizeOfHeaders);
+    ok(t.size == o.size + 0x200, "Size %lu, original %lu.\n", t.size, o.size);
+    for (i = 0; i < 4; i++)
+        ok(img_secs(&t)[i].PointerToRawData == img_secs(&o)[i].PointerToRawData + 0x200,
+                "Section %lu at %#lx.\n", i, img_secs(&t)[i].PointerToRawData);
+    ok(img_dir(&t, IMAGE_DIRECTORY_ENTRY_DEBUG)->VirtualAddress == img_dir(&o, IMAGE_DIRECTORY_ENTRY_DEBUG)->VirtualAddress,
+            "The debug directory moved.\n");
+    {
+        IMAGE_DEBUG_DIRECTORY *dd = (void *)img_rva(&t, img_dir(&t, IMAGE_DIRECTORY_ENTRY_DEBUG)->VirtualAddress);
+        ok(dd->PointerToRawData == 0x800 + 0x40 + 0x200, "Debug data pointer %#lx.\n", dd->PointerToRawData);
+        ok(!memcmp(t.d + dd->PointerToRawData, nb10_cv, sizeof(nb10_cv)), "Debug data differs.\n");
+    }
+    ok(!memcmp(img_rva(&t, 0x1000), img_rva(&o, 0x1000), 0x200), "The code changed.\n");
+    check_sum_valid(img, "bound image");
+
+    imp = (void *)img_rva(&t, 0x2000);
+    for (i = 0; i < 4; i++)
+        ok(imp[i].TimeDateStamp == ~0u, "Descriptor %lu stamp %#lx.\n", i, imp[i].TimeDateStamp);
+    {
+        /* import address table of testdll.dll: export, VariantInit, ordinal 2 */
+        BYTE *iat = img_rva(&t, imp[0].FirstThunk), *ilt = img_rva(&t, imp[0].OriginalFirstThunk);
+        ULONGLONG v0, v1, v2, i0;
+
+        i0 = b.is64 ? *(ULONGLONG *)ilt : *(DWORD *)ilt;
+        ok(i0 != 0 && !(i0 >> 63 && b.is64), "The original thunk changed: %I64x.\n", i0);
+        v0 = b.is64 ? ((ULONGLONG *)iat)[0] : ((DWORD *)iat)[0];
+        v1 = b.is64 ? ((ULONGLONG *)iat)[1] : ((DWORD *)iat)[1];
+        v2 = b.is64 ? ((ULONGLONG *)iat)[2] : ((DWORD *)iat)[2];
+        ok(v0 == ref_export(tdll, "export", 0, dirs), "IAT[0] %I64x.\n", v0);
+        want = ref_export(oleaut, "VariantInit", 0, dirs);
+        ok(v1 == want, "IAT[1] %I64x, expected %I64x.\n", v1, want);
+        ok(v2 == want, "IAT[2] %I64x, expected %I64x.\n", v2, want);
+        ok(!(b.is64 ? ((ULONGLONG *)iat)[3] : ((DWORD *)iat)[3]), "The table lost its terminator.\n");
+    }
+    bd = img_dir(&t, IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT);
+    ok(bd->VirtualAddress && bd->Size, "No bound import directory.\n");
+    bound = (void *)img_rva(&t, bd->VirtualAddress);
+    {
+        BYTE *p = (BYTE *)bound;
+        int n = 0;
+        BOOL saw_fwd = FALSE;
+
+        while (((IMAGE_BOUND_IMPORT_DESCRIPTOR *)p)->TimeDateStamp || ((IMAGE_BOUND_IMPORT_DESCRIPTOR *)p)->OffsetModuleName)
+        {
+            IMAGE_BOUND_IMPORT_DESCRIPTOR *d = (void *)p;
+            const char *name = (const char *)bound + d->OffsetModuleName;
+            char full[MAX_PATH];
+
+            ok(SearchPathA(dirs, name, NULL, sizeof(full), full, NULL), "Bound module %s not found.\n", name);
+            ok(d->TimeDateStamp == ref_stamp(full), "Stamp of %s: %#lx.\n", name, d->TimeDateStamp);
+            if (!strcmp(name, "testdll.dll"))
+            {
+                IMAGE_BOUND_FORWARDER_REF *fr = (void *)(d + 1);
+
+                ok(d->NumberOfModuleForwarderRefs == 1, "Got %u forwarder refs.\n", d->NumberOfModuleForwarderRefs);
+                if (d->NumberOfModuleForwarderRefs == 1)
+                {
+                    ok(!_stricmp((const char *)bound + fr->OffsetModuleName, "oleaut32.dll"), "Forwarder ref %s.\n",
+                            (const char *)bound + fr->OffsetModuleName);
+                    ok(fr->TimeDateStamp == ref_stamp(oleaut), "Forwarder ref stamp %#lx.\n", fr->TimeDateStamp);
+                    saw_fwd = TRUE;
+                }
+            }
+            else if (!_stricmp(name, "oleaut32.dll") || !_stricmp(name, "comdlg32.dll"))
+                ok(!d->NumberOfModuleForwarderRefs, "Module %s has forwarder refs.\n", name);
+            p += sizeof(*d) + d->NumberOfModuleForwarderRefs * sizeof(IMAGE_BOUND_FORWARDER_REF);
+            n++;
+        }
+        ok(n == 4, "Got %d bound modules.\n", n);
+        ok(saw_fwd, "testdll.dll was not bound.\n");
+    }
+    free_img(&t);
+    free_img(&o);
+
+    /* binding again changes nothing */
+    CopyFileA(img, orig, FALSE);
+    nevents = 0;
+    ret = BindImageEx(0, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(files_equal(img, orig), "Binding twice changed the file.\n");
+    ok(count_events(BindExpandFileHeaders) == 0, "The headers grew again.\n");
+
+    /* imports that cannot be resolved leave their module unbound and its table as it was */
+    b.imps = imps_bad;
+    b.debug = FALSE;
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    nevents = 0;
+    ret = BindImageEx(0, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(count_events(BindImportModuleFailed) == 1, "Got %u module failures.\n", count_events(BindImportModuleFailed));
+    e = find_event(BindImportProcedureFailed, "NoSuchFunctionSG");
+    ok(!!e, "No BindImportProcedureFailed for the missing function.\n");
+    ok(load_img(img, &t), "Cannot load the image.\n");
+    imp = (void *)img_rva(&t, 0x2000);
+    ok(imp[0].TimeDateStamp == 0, "Unresolved module stamp %#lx.\n", imp[0].TimeDateStamp);
+    ok(imp[1].TimeDateStamp == 0, "Module with a missing function stamp %#lx.\n", imp[1].TimeDateStamp);
+    ok(imp[2].TimeDateStamp == ~0u, "Resolved module stamp %#lx.\n", imp[2].TimeDateStamp);
+    {
+        BYTE *iat = img_rva(&t, imp[1].FirstThunk), *ilt = img_rva(&t, imp[1].OriginalFirstThunk);
+        ok(!memcmp(iat, ilt, 3 * esz), "The table of the unbound module changed.\n");
+    }
+    free_img(&t);
+    check_sum_valid(img, "partly bound image");
+
+    /* with room in the headers, nothing grows (a different layout: no debug section, one import) */
+    b.imps = imps_one;
+    b.debug = FALSE;
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    CopyFileA(img, orig, FALSE);
+    nevents = 0;
+    ret = BindImageEx(0, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(count_events(BindExpandFileHeaders) == 0, "The headers grew.\n");
+    ok(load_img(img, &t) && load_img(orig, &o), "Cannot load the images.\n");
+    ok(t.size == o.size && t.nt->OptionalHeader.SizeOfHeaders == 0x200, "Size %lu, headers %#lx.\n", t.size,
+            t.nt->OptionalHeader.SizeOfHeaders);
+    bd = img_dir(&t, IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT);
+    ok(bd->VirtualAddress >= (BYTE *)(img_secs(&t) + 3) - t.d && bd->VirtualAddress < 0x200,
+            "Bound directory at %#lx.\n", bd->VirtualAddress);
+    free_img(&t);
+    free_img(&o);
+
+    /* BIND_ALL_IMAGES also binds the imports of the dlls found (the copy of testdll.dll in the directory) */
+    b.imps = imps_one;
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    nevents = 0;
+    ret = BindImageEx(BIND_ALL_IMAGES, img, dirs, NULL, record_cb);
+    ok(ret, "BindImageEx failed %lu.\n", GetLastError());
+    ok(load_img(tdll, &t), "Cannot load testdll.\n");
+    {
+        IMAGE_DATA_DIRECTORY *id = img_dir(&t, IMAGE_DIRECTORY_ENTRY_IMPORT);
+        unsigned int bound_count = 0;
+
+        imp = (void *)img_rva(&t, id->VirtualAddress);
+        for (i = 0; imp[i].Name; i++) if (imp[i].TimeDateStamp == ~0u) bound_count++;
+        ok(bound_count > 0, "None of the imports of testdll.dll were bound.\n");
+    }
+    free_img(&t);
+
+    /* failures */
+    SetLastError(0xdeadbeef);
+    ret = BindImageEx(0, "C:\\nonexistent\\sg.dll", dirs, NULL, NULL);
+    ok(!ret && (GetLastError() == ERROR_FILE_NOT_FOUND || GetLastError() == ERROR_PATH_NOT_FOUND),
+            "Got %d, %lu.\n", ret, GetLastError());
+
+    DeleteFileA(img);
+    DeleteFileA(orig);
+    DeleteFileA(tdll);
+}
