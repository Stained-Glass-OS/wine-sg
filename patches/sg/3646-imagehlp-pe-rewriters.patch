+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <ctype.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winerror.h"
+#include "winver.h"
+#include "wine/debug.h"
+#include "imagehlp.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(imagehlp);
+
+/* a PE file held in memory */
+struct pe
+{
+    BYTE *data;
+    DWORD size;
+    IMAGE_NT_HEADERS32 *nt;   /* the fields before ImageBase are common to both variants */
+    BOOL is64;
+};
+
+#define NT64(pe) ((IMAGE_NT_HEADERS64 *)(pe)->nt)
+
+static DWORD align_up(DWORD v, DWORD a) { return a ? (v + a - 1) / a * a : v; }
+
+static BOOL pe_parse(struct pe *pe)
+{
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)pe->data;
+    DWORD off, need;
+
+    pe->nt = NULL;
+    if (pe->size < sizeof(*dos) || dos->e_magic != IMAGE_DOS_SIGNATURE) return FALSE;
+    off = dos->e_lfanew;
+    if (off < sizeof(*dos) || off > pe->size || pe->size - off < 4 + sizeof(IMAGE_FILE_HEADER) + 2) return FALSE;
+    pe->nt = (IMAGE_NT_HEADERS32 *)(pe->data + off);
+    if (pe->nt->Signature != IMAGE_NT_SIGNATURE) goto fail;
+    if (pe->nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR32_MAGIC) pe->is64 = FALSE;
+    else if (pe->nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC) pe->is64 = TRUE;
+    else goto fail;
+    need = 4 + sizeof(IMAGE_FILE_HEADER) + pe->nt->FileHeader.SizeOfOptionalHeader
+            + pe->nt->FileHeader.NumberOfSections * sizeof(IMAGE_SECTION_HEADER);
+    if (pe->nt->FileHeader.SizeOfOptionalHeader < (pe->is64 ? 112 : 96) || pe->size - off < need) goto fail;
+    return TRUE;
+fail:
+    pe->nt = NULL;
+    return FALSE;
+}
+
+static void pe_free(struct pe *pe)
+{
+    HeapFree(GetProcessHeap(), 0, pe->data);
+    memset(pe, 0, sizeof(*pe));
+}
+
+static BOOL pe_read(const char *path, struct pe *pe, DWORD extra)
+{
+    HANDLE file;
+    DWORD size, got;
+
+    memset(pe, 0, sizeof(*pe));
+    file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    size = GetFileSize(file, NULL);
+    if (size == INVALID_FILE_SIZE || size > 0x10000000 || !(pe->data = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, size + extra)))
+    {
+        if (size != INVALID_FILE_SIZE) SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        CloseHandle(file);
+        return FALSE;
+    }
+    if (!ReadFile(file, pe->data, size, &got, NULL) || got != size)
+    {
+        CloseHandle(file);
+        pe_free(pe);
+        return FALSE;
+    }
+    CloseHandle(file);
+    pe->size = size;
+    if (!pe_parse(pe))
+    {
+        pe_free(pe);
+        SetLastError(ERROR_BAD_EXE_FORMAT);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL pe_write(const char *path, struct pe *pe)
+{
+    DWORD hdr_sum, sum, put;
+    HANDLE file;
+    BOOL ret;
+
+    CheckSumMappedFile(pe->data, pe->size, &hdr_sum, &sum);
+    pe->nt->OptionalHeader.CheckSum = sum;
+    file = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, 0);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ret = WriteFile(file, pe->data, pe->size, &put, NULL) && put == pe->size && SetEndOfFile(file);
+    CloseHandle(file);
+    return ret;
+}
+
+static IMAGE_SECTION_HEADER *pe_sections(const struct pe *pe)
+{
+    return (IMAGE_SECTION_HEADER *)((BYTE *)&pe->nt->OptionalHeader + pe->nt->FileHeader.SizeOfOptionalHeader);
+}
+
+static IMAGE_DATA_DIRECTORY *pe_dir(const struct pe *pe, DWORD index)
+{
+    DWORD base = pe->is64 ? 112 : 96, count = pe->is64 ? NT64(pe)->OptionalHeader.NumberOfRvaAndSizes
+            : pe->nt->OptionalHeader.NumberOfRvaAndSizes;
+
+    if (index >= count || base + (index + 1) * sizeof(IMAGE_DATA_DIRECTORY) > pe->nt->FileHeader.SizeOfOptionalHeader)
+        return NULL;
+    return (IMAGE_DATA_DIRECTORY *)((BYTE *)&pe->nt->OptionalHeader + base) + index;
+}
+
+static ULONGLONG pe_image_base(const struct pe *pe)
+{
+    return pe->is64 ? NT64(pe)->OptionalHeader.ImageBase : pe->nt->OptionalHeader.ImageBase;
+}
+
+/* file offset of an RVA and the number of bytes available there */
+static BOOL pe_rva_off(const struct pe *pe, DWORD rva, DWORD *off, DWORD *avail)
+{
+    const IMAGE_SECTION_HEADER *sec = pe_sections(pe);
+    DWORD i, o;
+
+    for (i = 0; i < pe->nt->FileHeader.NumberOfSections; i++)
+    {
+        if (rva < sec[i].VirtualAddress || rva - sec[i].VirtualAddress >= sec[i].SizeOfRawData) continue;
+        o = sec[i].PointerToRawData + (rva - sec[i].VirtualAddress);
+        if (o >= pe->size) continue;
+        *off = o;
+        *avail = min(sec[i].SizeOfRawData - (rva - sec[i].VirtualAddress), pe->size - o);
+        return TRUE;
+    }
+    if (rva < pe->nt->OptionalHeader.SizeOfHeaders && rva < pe->size)
+    {
+        *off = rva;
+        *avail = min(pe->nt->OptionalHeader.SizeOfHeaders, pe->size) - rva;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void *pe_rva_ptr(const struct pe *pe, DWORD rva, DWORD need)
+{
+    DWORD off, avail;
+
+    if (!pe_rva_off(pe, rva, &off, &avail) || avail < need) return NULL;
+    return pe->data + off;
+}
+
+static const char *pe_rva_str(const struct pe *pe, DWORD rva)
+{
+    DWORD off, avail;
+
+    if (!pe_rva_off(pe, rva, &off, &avail) || !avail || !memchr(pe->data + off, 0, avail)) return NULL;
+    return (const char *)pe->data + off;
+}
+
+static BOOL pe_off_rva(const struct pe *pe, DWORD off, DWORD *rva)
+{
+    const IMAGE_SECTION_HEADER *sec = pe_sections(pe);
+    DWORD i;
+
+    for (i = 0; i < pe->nt->FileHeader.NumberOfSections; i++)
+    {
+        if (!sec[i].PointerToRawData || off < sec[i].PointerToRawData
+                || off - sec[i].PointerToRawData >= sec[i].SizeOfRawData) continue;
+        *rva = sec[i].VirtualAddress + (off - sec[i].PointerToRawData);
+        return TRUE;
+    }
+    if (off < pe->nt->OptionalHeader.SizeOfHeaders)
+    {
+        *rva = off;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* ---- bind ---- */
+
+struct bdll
+{
+    char path[MAX_PATH];
+    char name[MAX_PATH];
+    struct pe pe;
+};
+
+struct bctx
+{
+    DWORD flags;
+    const char *dll_path;
+    PIMAGEHLP_STATUS_ROUTINE cb;
+    struct bdll *dlls[64];
+    unsigned int count;
+    char *visited[32];
+    unsigned int nvisited;
+};
+
+struct fwd_ref
+{
+    char name[MAX_PATH];
+    DWORD stamp;
+};
+
+struct bound_mod
+{
+    BOOL ok;
+    DWORD stamp;
+    char name[MAX_PATH];
+    struct fwd_ref refs[16];
+    unsigned int nrefs;
+    ULONGLONG *values;
+    unsigned int nvalues;
+};
+
+static BOOL bind_status(const struct bctx *ctx, IMAGEHLP_STATUS_REASON reason, const char *image,
+        const char *dll, ULONG_PTR va, ULONG_PTR param)
+{
+    return ctx->cb ? ctx->cb(reason, image, dll, va, param) : TRUE;
+}
+
+static struct bdll *bind_get_dll(struct bctx *ctx, const char *name)
+{
+    char path[MAX_PATH];
+    struct bdll *dll;
+    unsigned int i;
+
+    if (!SearchPathA(ctx->dll_path, name, ".dll", sizeof(path), path, NULL)) return NULL;
+    for (i = 0; i < ctx->count; i++)
+        if (!_stricmp(ctx->dlls[i]->path, path)) return ctx->dlls[i];
+    if (ctx->count == ARRAY_SIZE(ctx->dlls)) return NULL;
+    if (!(dll = HeapAlloc(GetProcessHeap(), 0, sizeof(*dll)))) return NULL;
+    strcpy(dll->path, path);
+    strcpy(dll->name, strrchr(path, '\\') ? strrchr(path, '\\') + 1 : path);
+    if (!pe_read(path, &dll->pe, 0))
+    {
+        HeapFree(GetProcessHeap(), 0, dll);
+        return NULL;
+    }
+    ctx->dlls[ctx->count++] = dll;
+    return dll;
+}
+
+static void bind_free(struct bctx *ctx)
+{
+    unsigned int i;
+
+    for (i = 0; i < ctx->count; i++)
+    {
+        pe_free(&ctx->dlls[i]->pe);
+        HeapFree(GetProcessHeap(), 0, ctx->dlls[i]);
+    }
+    for (i = 0; i < ctx->nvisited; i++) HeapFree(GetProcessHeap(), 0, ctx->visited[i]);
+}
+
+/* looks up an export; by name when name is not NULL, else by ordinal.  Forwarders are followed. */
+static BOOL resolve_export(struct bctx *ctx, struct bdll *dll, const char *name, DWORD ordinal,
+        ULONGLONG *va, struct bound_mod *mod, const char *image, int depth)
+{
+    const IMAGE_DATA_DIRECTORY *dir = pe_dir(&dll->pe, IMAGE_DIRECTORY_ENTRY_EXPORT);
+    const IMAGE_EXPORT_DIRECTORY *exp;
+    const DWORD *funcs, *names;
+    const WORD *ords;
+    DWORD idx, func, i;
+
+    if (!dir || !dir->VirtualAddress || !(exp = pe_rva_ptr(&dll->pe, dir->VirtualAddress, sizeof(*exp)))) return FALSE;
+    if (!(funcs = pe_rva_ptr(&dll->pe, exp->AddressOfFunctions, exp->NumberOfFunctions * sizeof(DWORD)))) return FALSE;
+    if (name)
+    {
+        if (!(names = pe_rva_ptr(&dll->pe, exp->AddressOfNames, exp->NumberOfNames * sizeof(DWORD)))
+                || !(ords = pe_rva_ptr(&dll->pe, exp->AddressOfNameOrdinals, exp->NumberOfNames * sizeof(WORD))))
+            return FALSE;
+        for (i = 0; i < exp->NumberOfNames; i++)
+        {
+            const char *s = pe_rva_str(&dll->pe, names[i]);
+            if (s && !strcmp(s, name)) break;
+        }
+        if (i == exp->NumberOfNames) return FALSE;
+        idx = ords[i];
+    }
+    else
+    {
+        if (ordinal < exp->Base) return FALSE;
+        idx = ordinal - exp->Base;
+    }
+    if (idx >= exp->NumberOfFunctions || !(func = funcs[idx])) return FALSE;
+
+    if (func >= dir->VirtualAddress && func - dir->VirtualAddress < dir->Size)
+    {
+        /* a forwarder: "MODULE.Function" or "MODULE.#ordinal" */
+        const char *fwd = pe_rva_str(&dll->pe, func), *dot;
+        char modname[MAX_PATH];
+        struct bdll *target;
+        unsigned int k;
+
+        if (!fwd || !(dot = strchr(fwd, '.')) || dot == fwd || dot - fwd >= MAX_PATH - 5 || depth > 8) return FALSE;
+        memcpy(modname, fwd, dot - fwd);
+        modname[dot - fwd] = 0;
+        if (!(target = bind_get_dll(ctx, modname)) || target->pe.is64 != dll->pe.is64)
+        {
+            bind_status(ctx, BindForwarderNOT, image, dll->path, 0, (ULONG_PTR)fwd);
+            return FALSE;
+        }
+        for (k = 0; k < mod->nrefs; k++)
+            if (!_stricmp(mod->refs[k].name, target->name)) break;
+        if (k == mod->nrefs)
+        {
+            if (k == ARRAY_SIZE(mod->refs)) return FALSE;
+            strcpy(mod->refs[k].name, target->name);
+            mod->refs[k].stamp = target->pe.nt->FileHeader.TimeDateStamp;
+            mod->nrefs++;
+        }
+        if (dot[1] == '#')
+        {
+            if (!resolve_export(ctx, target, NULL, atoi(dot + 2), va, mod, image, depth + 1)) return FALSE;
+        }
+        else if (!resolve_export(ctx, target, dot + 1, 0, va, mod, image, depth + 1))
+        {
+            bind_status(ctx, BindForwarderNOT, image, target->path, 0, (ULONG_PTR)fwd);
+            return FALSE;
+        }
+        bind_status(ctx, BindForwarder, image, target->path, (ULONG_PTR)*va, (ULONG_PTR)fwd);
+        return TRUE;
+    }
+    *va = pe_image_base(&dll->pe) + func;
+    return TRUE;
+}
+
+/* makes room for 'add' more bytes of headers (a multiple of the file alignment) */
+static BOOL pe_grow_headers(struct pe *pe, DWORD first_raw, DWORD add)
+{
+    IMAGE_SECTION_HEADER *sec;
+    IMAGE_DATA_DIRECTORY *dir;
+    BYTE *p;
+    DWORD i, old_size = pe->size;
+
+    if (!(p = HeapReAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, pe->data, old_size + add))) return FALSE;
+    pe->data = p;
+    memmove(p + first_raw + add, p + first_raw, old_size - first_raw);
+    memset(p + first_raw, 0, add);
+    pe->size = old_size + add;
+    if (!pe_parse(pe)) return FALSE;
+
+    sec = pe_sections(pe);
+    for (i = 0; i < pe->nt->FileHeader.NumberOfSections; i++)
+        if (sec[i].PointerToRawData >= first_raw) sec[i].PointerToRawData += add;
+    if (pe->nt->FileHeader.PointerToSymbolTable >= first_raw) pe->nt->FileHeader.PointerToSymbolTable += add;
+    if ((dir = pe_dir(pe, IMAGE_DIRECTORY_ENTRY_SECURITY)) && dir->VirtualAddress >= first_raw)
+        dir->VirtualAddress += add;
+    if ((dir = pe_dir(pe, IMAGE_DIRECTORY_ENTRY_DEBUG)) && dir->VirtualAddress)
+    {
+        IMAGE_DEBUG_DIRECTORY *dbg = pe_rva_ptr(pe, dir->VirtualAddress, dir->Size);
+        for (i = 0; dbg && i < dir->Size / sizeof(*dbg); i++)
+            if (dbg[i].PointerToRawData >= first_raw) dbg[i].PointerToRawData += add;
+    }
+    pe->nt->OptionalHeader.SizeOfHeaders += add;
+    return TRUE;
+}
+
+static BOOL bind_one(struct bctx *ctx, const char *module, int depth);
+
+static WORD name_offset(char (*names)[MAX_PATH], const WORD *offs, unsigned int count, const char *name)
+{
+    unsigned int q;
+
+    for (q = 0; q < count; q++) if (!_stricmp(names[q], name)) return offs[q];
+    return 0;
+}
+
+static BOOL bind_image_file(struct bctx *ctx, const char *path, const char *module, int depth)
+{
+    const IMAGE_DATA_DIRECTORY *idir;
+    IMAGE_IMPORT_DESCRIPTOR *imp;
+    struct bound_mod *mods = NULL;
+    unsigned int nmods = 0, i, j, nbound = 0;
+    struct pe pe;
+    BOOL ret = FALSE;
+
+    if (!pe_read(path, &pe, 0)) return FALSE;
+
+    if (!(idir = pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_IMPORT)) || !idir->VirtualAddress
+            || !(imp = pe_rva_ptr(&pe, idir->VirtualAddress, sizeof(*imp))))
+    {
+        pe_free(&pe);
+        return TRUE; /* no imports */
+    }
+
+    {
+        DWORD avail, off;
+        if (!pe_rva_off(&pe, idir->VirtualAddress, &off, &avail)) goto done;
+        nmods = avail / sizeof(*imp);
+        for (i = 0; i < nmods; i++) if (!imp[i].Name && !imp[i].FirstThunk) break;
+        nmods = i;
+    }
+    if (!(mods = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, (nmods + 1) * sizeof(*mods)))) goto done;
+
+    for (i = 0; i < nmods; i++)
+    {
+        struct bound_mod *mod = &mods[i];
+        const char *dll_name = pe_rva_str(&pe, imp[i].Name);
+        DWORD thunk_rva = imp[i].OriginalFirstThunk ? imp[i].OriginalFirstThunk : imp[i].FirstThunk;
+        DWORD esize = pe.is64 ? 8 : 4, n, k, avail, off;
+        struct bdll *dll;
+        BYTE *thunks;
+        char full[MAX_PATH];
+
+        if (!dll_name)
+        {
+            bind_status(ctx, BindRvaToVaFailed, module, NULL, imp[i].Name, 0);
+            continue;
+        }
+        bind_status(ctx, BindImportModule, module, dll_name, 0, 0);
+        if (!(dll = bind_get_dll(ctx, dll_name)) || dll->pe.is64 != pe.is64
+                || !SearchPathA(ctx->dll_path, dll_name, ".dll", sizeof(full), full, NULL))
+        {
+            bind_status(ctx, BindImportModuleFailed, module, dll_name, 0, 0);
+            continue;
+        }
+        if (!pe_rva_off(&pe, thunk_rva, &off, &avail))
+        {
+            bind_status(ctx, BindRvaToVaFailed, module, dll_name, thunk_rva, 0);
+            continue;
+        }
+        thunks = pe.data + off;
+        for (n = 0; (n + 1) * esize <= avail; n++)
+            if (pe.is64 ? !((ULONGLONG *)thunks)[n] : !((DWORD *)thunks)[n]) break;
+        mod->values = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, (n + 1) * sizeof(ULONGLONG));
+        if (!mod->values)
+        {
+            bind_status(ctx, BindOutOfMemory, module, dll_name, 0, 0);
+            continue;
+        }
+        mod->nvalues = n;
+        mod->ok = TRUE;
+        strcpy(mod->name, dll_name);
+        mod->stamp = dll->pe.nt->FileHeader.TimeDateStamp;
+
+        for (k = 0; k < n && mod->ok; k++)
+        {
+            ULONGLONG t = pe.is64 ? ((ULONGLONG *)thunks)[k] : ((DWORD *)thunks)[k], va;
+            BOOL by_ord = pe.is64 ? !!(t >> 63) : !!(t >> 31);
+            char ordname[16];
+            const char *name = NULL;
+            DWORD ordinal = 0;
+
+            if (by_ord)
+            {
+#ifdef SG_MUTANT_BIND_ORD
+                mod->ok = FALSE;
+                break;
+#endif
+                ordinal = t & 0xffff;
+                sprintf(ordname, "Ordinal%lu", ordinal);
+                name = ordname;
+            }
+            else
+            {
+                const char *s = pe_rva_str(&pe, (DWORD)t + 2);
+                if (!s)
+                {
+                    bind_status(ctx, BindRvaToVaFailed, module, full, (ULONG_PTR)t, 0);
+                    mod->ok = FALSE;
+                    break;
+                }
+                name = s;
+            }
+            if (!resolve_export(ctx, dll, by_ord ? NULL : name, ordinal, &va, mod, module, 0))
+            {
+                bind_status(ctx, BindImportProcedureFailed, module, full, 0, (ULONG_PTR)name);
+                mod->ok = FALSE;
+                break;
+            }
+            mod->values[k] = va;
+            bind_status(ctx, BindImportProcedure, module, full, (ULONG_PTR)va, (ULONG_PTR)name);
+        }
+        if (mod->ok) nbound++;
+    }
+
+#ifdef SG_MUTANT_BIND_NOUPD
+    if (ctx->flags & BIND_NO_BOUND_IMPORTS || !nbound)
+#else
+    if (ctx->flags & (BIND_NO_UPDATE | BIND_NO_BOUND_IMPORTS) || !nbound)
+#endif
+    {
+        ret = TRUE;
+        goto recurse;
+    }
+
+    {
+        /* build the bound import directory */
+        IMAGE_SECTION_HEADER *sec;
+        DWORD dir_size = sizeof(IMAGE_BOUND_IMPORT_DESCRIPTOR), names_size = 0, total, gap_start, first_raw, avail;
+        DWORD align, extra;
+        IMAGE_DATA_DIRECTORY *bdir;
+        BYTE *buf, *dst;
+        WORD *name_offs;
+        char (*names)[MAX_PATH];
+        unsigned int nnames = 0, p;
+        BOOL expanded = FALSE;
+
+        names = HeapAlloc(GetProcessHeap(), 0, (nmods * 17 + 1) * sizeof(*names));
+        name_offs = HeapAlloc(GetProcessHeap(), 0, (nmods * 17 + 1) * sizeof(WORD));
+        if (!names || !name_offs)
+        {
+            HeapFree(GetProcessHeap(), 0, names);
+            HeapFree(GetProcessHeap(), 0, name_offs);
+            bind_status(ctx, BindOutOfMemory, module, NULL, 0, 0);
+            goto done;
+        }
+        /* collect the distinct module names */
+#define ADD_NAME(n) do { for (p = 0; p < nnames; p++) if (!_stricmp(names[p], (n))) break; \
+                         if (p == nnames) { strcpy(names[nnames++], (n)); names_size += strlen(n) + 1; } } while (0)
+        for (i = 0; i < nmods; i++)
+        {
+            if (!mods[i].ok) continue;
+            dir_size += sizeof(IMAGE_BOUND_IMPORT_DESCRIPTOR) + mods[i].nrefs * sizeof(IMAGE_BOUND_FORWARDER_REF);
+            ADD_NAME(mods[i].name);
+            for (j = 0; j < mods[i].nrefs; j++) ADD_NAME(mods[i].refs[j].name);
+        }
+        total = align_up(dir_size + names_size, 4);
+
+        sec = pe_sections(&pe);
+        first_raw = ~0u;
+        for (j = 0; j < pe.nt->FileHeader.NumberOfSections; j++)
+            if (sec[j].PointerToRawData && sec[j].PointerToRawData < first_raw) first_raw = sec[j].PointerToRawData;
+        if (first_raw == ~0u) first_raw = min(pe.nt->OptionalHeader.SizeOfHeaders, pe.size);
+        gap_start = align_up((BYTE *)(sec + pe.nt->FileHeader.NumberOfSections) - pe.data, 8);
+        bdir = pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT);
+        if (!bdir || first_raw < gap_start || first_raw > pe.size) goto no_room;
+
+        /* the room must be empty (or be a previous bound import directory at the same place) */
+        for (j = gap_start; j < first_raw; j++)
+            if (pe.data[j] && !(bdir->VirtualAddress == gap_start)) goto no_room;
+        avail = first_raw - gap_start;
+        extra = 0;
+        if (avail < total)
+        {
+            align = pe.nt->OptionalHeader.FileAlignment ? pe.nt->OptionalHeader.FileAlignment : 0x200;
+            extra = align_up(total - avail, align);
+            for (j = 0; j < pe.nt->FileHeader.NumberOfSections; j++)
+                if (sec[j].VirtualAddress && sec[j].VirtualAddress < pe.nt->OptionalHeader.SizeOfHeaders + extra)
+                    goto no_room;
+            bind_status(ctx, BindExpandFileHeaders, module, NULL, 0, 0);
+#ifdef SG_MUTANT_BIND_GROW
+            goto no_room;
+#endif
+            if (!pe_grow_headers(&pe, first_raw, extra))
+            {
+                bind_status(ctx, BindOutOfMemory, module, NULL, 0, 0);
+                HeapFree(GetProcessHeap(), 0, names);
+                HeapFree(GetProcessHeap(), 0, name_offs);
+                goto done;
+            }
+            expanded = TRUE;
+            /* the pointers into the old buffer are gone */
+            imp = pe_rva_ptr(&pe, idir->VirtualAddress, sizeof(*imp));
+            bdir = pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT);
+        }
+        (void)expanded;
+
+        if (!(buf = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, total)))
+        {
+            HeapFree(GetProcessHeap(), 0, names);
+            HeapFree(GetProcessHeap(), 0, name_offs);
+            goto done;
+        }
+        /* name offsets are relative to the start of the directory */
+        {
+            DWORD at = dir_size;
+            for (p = 0; p < nnames; p++)
+            {
+                name_offs[p] = at;
+                strcpy((char *)buf + at, names[p]);
+                at += strlen(names[p]) + 1;
+            }
+        }
+        dst = buf;
+        for (i = 0; i < nmods; i++)
+        {
+            IMAGE_BOUND_IMPORT_DESCRIPTOR *bd = (IMAGE_BOUND_IMPORT_DESCRIPTOR *)dst;
+            IMAGE_BOUND_FORWARDER_REF *fr;
+
+            if (!mods[i].ok) continue;
+            bd->TimeDateStamp = mods[i].stamp;
+            bd->OffsetModuleName = name_offset(names, name_offs, nnames, mods[i].name);
+            bd->NumberOfModuleForwarderRefs = mods[i].nrefs;
+            fr = (IMAGE_BOUND_FORWARDER_REF *)(bd + 1);
+            for (j = 0; j < mods[i].nrefs; j++, fr++)
+            {
+#ifdef SG_MUTANT_BIND_FWDREF
+                bd->NumberOfModuleForwarderRefs = 0;
+                break;
+#endif
+                fr->TimeDateStamp = mods[i].refs[j].stamp;
+                fr->OffsetModuleName = name_offset(names, name_offs, nnames, mods[i].refs[j].name);
+            }
+            dst = (BYTE *)fr;
+        }
+        memcpy(pe.data + gap_start, buf, total);
+        HeapFree(GetProcessHeap(), 0, buf);
+        HeapFree(GetProcessHeap(), 0, names);
+        HeapFree(GetProcessHeap(), 0, name_offs);
+        bdir->VirtualAddress = gap_start;
+        bdir->Size = dir_size;
+
+        /* the import address tables and descriptors */
+        for (i = 0; i < nmods; i++)
+        {
+            DWORD off, avail2;
+#ifdef SG_MUTANT_BIND_PARTIAL
+            if (!mods[i].ok) imp[i].TimeDateStamp = ~0u;
+#endif
+            if (!mods[i].ok)
+            {
+#ifndef SG_MUTANT_BIND_PARTIAL
+                imp[i].TimeDateStamp = 0;
+#endif
+                continue;
+            }
+            if (!pe_rva_off(&pe, imp[i].FirstThunk, &off, &avail2) || avail2 < mods[i].nvalues * (pe.is64 ? 8 : 4))
+                continue;
+            for (j = 0; j < mods[i].nvalues; j++)
+            {
+#ifdef SG_MUTANT_BIND_IAT
+                break;
+#endif
+                if (pe.is64) ((ULONGLONG *)(pe.data + off))[j] = mods[i].values[j];
+                else ((DWORD *)(pe.data + off))[j] = (DWORD)mods[i].values[j];
+            }
+#ifndef SG_MUTANT_BIND_STAMP
+            imp[i].TimeDateStamp = ~0u;
+#endif
+            imp[i].ForwarderChain = 0;
+        }
+        if (!pe_write(path, &pe)) goto done;
+        bind_status(ctx, BindImageModified, module, module, 0, 0);
+        ret = TRUE;
+        goto recurse;
+no_room:
+        HeapFree(GetProcessHeap(), 0, names);
+        HeapFree(GetProcessHeap(), 0, name_offs);
+        bind_status(ctx, BindNoRoomInImage, module, NULL, 0, 0);
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        goto done;
+    }
+
+recurse:
+    ret = TRUE;
+#ifdef SG_MUTANT_BIND_ALL
+    if (0)
+#else
+    if ((ctx->flags & BIND_ALL_IMAGES) && depth < 16)
+#endif
+    {
+        /* imports are only available while the file buffer is alive */
+        for (i = 0; i < nmods; i++)
+        {
+            const char *dll_name = pe_rva_str(&pe, imp[i].Name);
+            struct bdll *dll;
+            char name[MAX_PATH];
+
+            if (!dll_name || !(dll = bind_get_dll(ctx, dll_name))) continue;
+            strcpy(name, dll->path);
+            bind_one(ctx, name, depth + 1);
+        }
+    }
+done:
+    if (mods)
+    {
+        for (i = 0; i < nmods; i++) HeapFree(GetProcessHeap(), 0, mods[i].values);
+        HeapFree(GetProcessHeap(), 0, mods);
+    }
+    pe_free(&pe);
+    return ret;
+}
+
+static BOOL bind_one(struct bctx *ctx, const char *module, int depth)
+{
+    char path[MAX_PATH];
+    unsigned int i;
+
+    if (!SearchPathA(ctx->dll_path, module, ".dll", sizeof(path), path, NULL)) return FALSE;
+    for (i = 0; i < ctx->nvisited; i++) if (!_stricmp(ctx->visited[i], path)) return TRUE;
+    if (ctx->nvisited < ARRAY_SIZE(ctx->visited) && (ctx->visited[ctx->nvisited] = HeapAlloc(GetProcessHeap(), 0, strlen(path) + 1)))
+        strcpy(ctx->visited[ctx->nvisited++], path);
+    return bind_image_file(ctx, path, module, depth);
+}
+
+/***********************************************************************
+ *		BindImageEx (IMAGEHLP.@)
+ */
+BOOL WINAPI BindImageEx(DWORD flags, const char *module, const char *dll_path,
+        const char *symbol_path, PIMAGEHLP_STATUS_ROUTINE cb)
+{
+    struct bctx *ctx;
+    BOOL ret;
+
+    TRACE("flags %#lx, module %s, dll_path %s, symbol_path %s, cb %p.\n",
+            flags, debugstr_a(module), debugstr_a(dll_path), debugstr_a(symbol_path), cb);
+
+    if (!module)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(ctx = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*ctx)))) return FALSE;
+    ctx->flags = flags;
+    ctx->dll_path = dll_path;
+    ctx->cb = cb;
+    ret = bind_one(ctx, module, 0);
+    bind_free(ctx);
+    HeapFree(GetProcessHeap(), 0, ctx);
+    return ret;
+}
+
+/* ---- ReBaseImage ---- */
+
+static BOOL apply_relocations(struct pe *pe, LONGLONG delta)
+{
+    const IMAGE_DATA_DIRECTORY *dir = pe_dir(pe, IMAGE_DIRECTORY_ENTRY_BASERELOC);
+    DWORD pos = 0;
+
+    if (!dir || !dir->VirtualAddress || !dir->Size) return FALSE;
+    while (pos + sizeof(IMAGE_BASE_RELOCATION) <= dir->Size)
+    {
+        const IMAGE_BASE_RELOCATION *block = pe_rva_ptr(pe, dir->VirtualAddress + pos, sizeof(*block));
+        const WORD *entry;
+        DWORD count, k;
+
+        if (!block || block->SizeOfBlock < sizeof(*block) || block->SizeOfBlock > dir->Size - pos) break;
+        count = (block->SizeOfBlock - sizeof(*block)) / sizeof(WORD);
+        entry = (const WORD *)(block + 1);
+        for (k = 0; k < count; k++)
+        {
+            DWORD rva = block->VirtualAddress + (entry[k] & 0xfff);
+            void *p;
+
+            switch (entry[k] >> 12)
+            {
+            case IMAGE_REL_BASED_HIGH:
+                if ((p = pe_rva_ptr(pe, rva, 2))) *(WORD *)p += (WORD)((delta >> 16) & 0xffff);
+                break;
+            case IMAGE_REL_BASED_LOW:
+                if ((p = pe_rva_ptr(pe, rva, 2))) *(WORD *)p += (WORD)(delta & 0xffff);
+                break;
+            case IMAGE_REL_BASED_HIGHLOW:
+                if ((p = pe_rva_ptr(pe, rva, 4))) *(DWORD *)p += (DWORD)delta;
+                break;
+            case IMAGE_REL_BASED_HIGHADJ:
+                if ((p = pe_rva_ptr(pe, rva, 2)) && k + 1 < count)
+                {
+                    /* the next entry holds the low half of the original value */
+                    LONG full = ((LONG)*(WORD *)p << 16) + (SHORT)entry[k + 1];
+                    full += (LONG)delta;
+                    full += 0x8000;
+                    *(WORD *)p = (WORD)(full >> 16);
+                    k++;
+                }
+                break;
+            case IMAGE_REL_BASED_DIR64:
+                if ((p = pe_rva_ptr(pe, rva, 8))) *(ULONGLONG *)p += delta;
+                break;
+            default:
+                break;
+            }
+        }
+        pos += block->SizeOfBlock;
+    }
+    return TRUE;
+}
+
+struct dbg_values
+{
+    DWORD stamp, checksum, base, size;
+};
+
+static void dbg_values_from_pe(const struct pe *pe, struct dbg_values *v)
+{
+    v->stamp = pe->nt->FileHeader.TimeDateStamp;
+    v->checksum = pe->nt->OptionalHeader.CheckSum;
+    v->base = (DWORD)pe_image_base(pe);
+    v->size = pe->nt->OptionalHeader.SizeOfImage;
+}
+
+static BOOL update_dbg_header(const char *dbg_path, const struct dbg_values *v, BOOL check_sum, DWORD old_sum);
+static BOOL find_dbg_file(const char *image, const char *symbol_path, char *out);
+
+static BOOL rebase_image(const char *name, const char *symbol_path, BOOL do_rebase, BOOL sys_ok, BOOL going_down,
+        ULONG check_size, ULONG *old_size, ULONG64 *old_base, ULONG *new_size, ULONG64 *new_base, ULONG stamp)
+{
+    ULONG64 base, newbase, limit;
+    BOOL can_rebase = TRUE;
+    ULONG size, nsize;
+    struct pe pe;
+
+    if (!name || !new_base)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!pe_read(name, &pe, 0)) return FALSE;
+
+    base = pe_image_base(&pe);
+    size = pe.nt->OptionalHeader.SizeOfImage;
+    if (old_size) *old_size = size;
+    if (old_base) *old_base = base;
+
+#ifndef SG_MUTANT_REBASE_CHECK
+    if (check_size && size > check_size)
+#else
+    if (0)
+#endif
+    {
+        pe_free(&pe);
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    nsize = align_up(size, 0x10000);
+    if (new_size) *new_size = nsize;
+    limit = pe.is64 ? ~(ULONG64)0 : 0xffffffffu;
+
+    if (going_down)
+    {
+        if (*new_base < nsize)
+        {
+            pe_free(&pe);
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+#ifdef SG_MUTANT_REBASE_DOWN
+        newbase = *new_base & ~(ULONG64)0xffff;
+#else
+        newbase = (*new_base - nsize) & ~(ULONG64)0xffff;
+#endif
+    }
+    else
+        newbase = (*new_base + 0xffff) & ~(ULONG64)0xffff;
+    if (newbase + nsize - 1 > limit)
+    {
+        pe_free(&pe);
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    /* an image without relocations cannot be moved; system files only when allowed */
+    if ((pe.nt->FileHeader.Characteristics & IMAGE_FILE_RELOCS_STRIPPED)
+            || !pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_BASERELOC) || !pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_BASERELOC)->Size)
+        can_rebase = FALSE;
+#ifndef SG_MUTANT_REBASE_SYS
+    if (!sys_ok && (pe.nt->OptionalHeader.Subsystem == IMAGE_SUBSYSTEM_NATIVE || (!pe.is64 && base >= 0x80000000)))
+        can_rebase = FALSE;
+#endif
+
+    if (can_rebase)
+    {
+        if (do_rebase && newbase != base)
+        {
+#ifdef SG_MUTANT_REBASE_RELOC
+            if (0)
+#else
+            if (!apply_relocations(&pe, (LONGLONG)(newbase - base)))
+#endif
+                can_rebase = FALSE;
+            else
+            {
+                if (pe.is64) NT64(&pe)->OptionalHeader.ImageBase = newbase;
+                else pe.nt->OptionalHeader.ImageBase = (DWORD)newbase;
+            }
+        }
+        if (can_rebase && do_rebase)
+        {
+            char dbg[MAX_PATH];
+
+#ifndef SG_MUTANT_REBASE_STAMP
+            if (stamp) pe.nt->FileHeader.TimeDateStamp = stamp;
+#endif
+            if (!pe_write(name, &pe))
+            {
+                pe_free(&pe);
+                return FALSE;
+            }
+            /* a separate debug file keeps the base, the stamp and the checksum of its image */
+#ifdef SG_MUTANT_REBASE_DBG
+            if (0)
+#else
+            if ((pe.nt->FileHeader.Characteristics & IMAGE_FILE_DEBUG_STRIPPED) && find_dbg_file(name, symbol_path, dbg))
+#endif
+            {
+                struct dbg_values v;
+
+                dbg_values_from_pe(&pe, &v);
+                update_dbg_header(dbg, &v, FALSE, 0);
+            }
+        }
+    }
+    else
+        newbase = base;
+
+    *new_base = going_down ? newbase : newbase + nsize;
+    pe_free(&pe);
+    return TRUE;
+}
+
+/***********************************************************************
+ *		ReBaseImage64 (IMAGEHLP.@)
+ */
+BOOL WINAPI ReBaseImage64(PCSTR name, PCSTR symbol_path, BOOL rebase, BOOL sys_ok, BOOL going_down,
+        ULONG check_size, ULONG *old_size, ULONG64 *old_base, ULONG *new_size, ULONG64 *new_base, ULONG stamp)
+{
+    TRACE("%s, %s, %d, %d, %d, %lu, %p, %p, %p, %p, %lu\n", debugstr_a(name), debugstr_a(symbol_path), rebase, sys_ok,
+            going_down, check_size, old_size, old_base, new_size, new_base, stamp);
+    return rebase_image(name, symbol_path, rebase, sys_ok, going_down, check_size, old_size, old_base,
+            new_size, new_base, stamp);
+}
+
+/***********************************************************************
+ *		ReBaseImage (IMAGEHLP.@)
+ */
+BOOL WINAPI ReBaseImage(PCSTR name, PCSTR symbol_path, BOOL rebase, BOOL sys_ok, BOOL going_down,
+        ULONG check_size, ULONG *old_size, ULONG_PTR *old_base, ULONG *new_size, ULONG_PTR *new_base, ULONG stamp)
+{
+    ULONG64 ob = 0, nb;
+    BOOL ret;
+
+    TRACE("%s, %s, %d, %d, %d, %lu, %p, %p, %p, %p, %lu\n", debugstr_a(name), debugstr_a(symbol_path), rebase, sys_ok,
+            going_down, check_size, old_size, old_base, new_size, new_base, stamp);
+
+    if (!new_base)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    nb = *new_base;
+    ret = rebase_image(name, symbol_path, rebase, sys_ok, going_down, check_size, old_size, &ob, new_size, &nb, stamp);
+    if (old_base) *old_base = (ULONG_PTR)ob;
+    if (ret) *new_base = (ULONG_PTR)nb;
+    return ret;
+}
+
+/* ---- CodeView ---- */
+
+#define CV_SST_MODULE      0x120
+#define CV_SST_PUBLIC      0x122
+#define CV_SST_PUBLICSYM   0x123
+#define CV_SST_LIBRARIES   0x128
+#define CV_SST_GLOBALPUB   0x12a
+#define CV_SST_SEGMAP      0x12d
+#define CV_SST_SEGNAME     0x12e
+#define CV_SST_FILEINDEX   0x133
+
+#include "pshpack1.h"
+struct cv_dir_header
+{
+    WORD  header_size;
+    WORD  entry_size;
+    DWORD count;
+    DWORD next;
+    DWORD flags;
+};
+struct cv_dir_entry
+{
+    WORD  subsection;
+    WORD  module;
+    DWORD offset;
+    DWORD size;
+};
+#include "poppack.h"
+
+/* the size of the CodeView data, found from its directory (the real size is not passed in) */
+static BOOL cv_data_size(const BYTE *cv, DWORD *size)
+{
+    const struct cv_dir_header *hdr;
+    const struct cv_dir_entry *ent;
+    DWORD dir, end, i;
+
+    if (memcmp(cv, "NB09", 4) && memcmp(cv, "NB11", 4)) return FALSE;
+    dir = *(const DWORD *)(cv + 4);
+    hdr = (const void *)(cv + dir);
+    if (hdr->header_size < sizeof(*hdr) || hdr->entry_size < sizeof(*ent)) return FALSE;
+    end = dir + hdr->header_size + hdr->count * hdr->entry_size;
+    ent = (const void *)((const BYTE *)hdr + hdr->header_size);
+    for (i = 0; i < hdr->count; i++)
+        end = max(end, ent[i].offset + ent[i].size);
+    *size = end + 8; /* the NBxx signature and base offset that close the data */
+    return TRUE;
+}
+
+static BOOL cv_is_public(WORD sst)
+{
+#ifdef SG_MUTANT_CV_KEEPALL
+    return TRUE;
+#endif
+    switch (sst)
+    {
+    case CV_SST_MODULE: case CV_SST_PUBLIC: case CV_SST_PUBLICSYM: case CV_SST_LIBRARIES:
+    case CV_SST_GLOBALPUB: case CV_SST_SEGMAP: case CV_SST_SEGNAME: case CV_SST_FILEINDEX:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* keeps the public symbol subsections; the result is allocated on the process heap */
+static BOOL cv_remove_private(const BYTE *cv, DWORD cv_size, BYTE **out, DWORD *out_size)
+{
+    const struct cv_dir_header *hdr;
+    const struct cv_dir_entry *ent;
+    struct cv_dir_header *nhdr;
+    struct cv_dir_entry *nent;
+    DWORD dir, i, kept = 0, total = 8, at;
+    BYTE *buf;
+
+    if (!cv_data_size(cv, &i)) return FALSE;
+    if (cv_size && i > cv_size) return FALSE;
+    dir = *(const DWORD *)(cv + 4);
+    hdr = (const void *)(cv + dir);
+    ent = (const void *)((const BYTE *)hdr + hdr->header_size);
+    for (i = 0; i < hdr->count; i++)
+        if (cv_is_public(ent[i].subsection))
+        {
+            kept++;
+            total += align_up(ent[i].size, 4);
+        }
+    total += sizeof(*nhdr) + kept * sizeof(*nent) + 8;
+    if (!(buf = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, total))) return FALSE;
+    memcpy(buf, cv, 4);
+    at = 8;
+    nent = (void *)(buf + total - 8 - kept * sizeof(*nent));
+    nhdr = (void *)((BYTE *)nent - sizeof(*nhdr));
+    for (i = 0, kept = 0; i < hdr->count; i++)
+    {
+        if (!cv_is_public(ent[i].subsection)) continue;
+        memcpy(buf + at, cv + ent[i].offset, ent[i].size);
+        nent[kept] = ent[i];
+        nent[kept].offset = at;
+        at += align_up(ent[i].size, 4);
+        kept++;
+    }
+    nhdr->header_size = sizeof(*nhdr);
+    nhdr->entry_size = sizeof(*nent);
+    nhdr->count = kept;
+    nhdr->next = 0;
+    nhdr->flags = hdr->flags;
+    *(DWORD *)(buf + 4) = (BYTE *)nhdr - buf;
+    memcpy(buf + total - 8, cv, 4);
+    *(DWORD *)(buf + total - 4) = total; /* offset of the start of the data back from the end */
+    *out = buf;
+    *out_size = total;
+    return TRUE;
+}
+
+/***********************************************************************
+ *		RemovePrivateCvSymbolic (IMAGEHLP.@)
+ */
+BOOL WINAPI RemovePrivateCvSymbolic(PCHAR debug_data, PCHAR *new_data, ULONG *new_size)
+{
+    DWORD size;
+
+    TRACE("(%p, %p, %p)\n", debug_data, new_data, new_size);
+
+    if (!debug_data || !new_data || !new_size)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!cv_data_size((const BYTE *)debug_data, &size))
+    {
+        SetLastError(ERROR_INVALID_DATA);
+        return FALSE;
+    }
+    return cv_remove_private((const BYTE *)debug_data, size, (BYTE **)new_data, new_size);
+}
+
+/* ---- separate debug files ---- */
+
+static BOOL update_dbg_header(const char *dbg_path, const struct dbg_values *v, BOOL check_sum, DWORD old_sum)
+{
+    IMAGE_SEPARATE_DEBUG_HEADER hdr;
+    DWORD got;
+    HANDLE file;
+    BOOL ret = FALSE;
+
+    file = CreateFileA(dbg_path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, 0);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    if (!ReadFile(file, &hdr, sizeof(hdr), &got, NULL) || got != sizeof(hdr) || hdr.Signature != IMAGE_SEPARATE_DEBUG_SIGNATURE)
+    {
+        SetLastError(ERROR_BAD_EXE_FORMAT);
+        goto done;
+    }
+#ifndef SG_MUTANT_UPD_EX
+    if (check_sum && hdr.CheckSum != old_sum)
+#else
+    if (0)
+#endif
+    {
+        SetLastError(ERROR_INVALID_DATA);
+        goto done;
+    }
+    hdr.TimeDateStamp = v->stamp;
+    hdr.CheckSum = v->checksum;
+#ifndef SG_MUTANT_UPD_BASE
+    hdr.ImageBase = v->base;
+#endif
+    hdr.SizeOfImage = v->size;
+    if (SetFilePointer(file, 0, NULL, FILE_BEGIN) == INVALID_SET_FILE_POINTER) goto done;
+    ret = WriteFile(file, &hdr, sizeof(hdr), &got, NULL) && got == sizeof(hdr);
+done:
+    CloseHandle(file);
+    return ret;
+}
+
+/* the .DBG file of an image: the name in its MISC debug entry (or the image's name with .dbg), looked for in
+ * SYMBOL_PATH\Symbols\ext, SYMBOL_PATH\ext, SYMBOL_PATH and then beside the image */
+static BOOL find_dbg_file(const char *image, const char *symbol_path, char *out)
+{
+    char name[MAX_PATH], ext[16] = "", dir[MAX_PATH], list[2 * MAX_PATH], *p, *next;
+    const char *slash, *dot;
+    struct pe pe;
+    unsigned int i;
+
+    slash = strrchr(image, '\\');
+    if (!slash) slash = strrchr(image, '/');
+    slash = slash ? slash + 1 : image;
+    strcpy(name, slash);
+    if ((dot = strrchr(name, '.')))
+    {
+        for (i = 0; i < sizeof(ext) - 1 && dot[i + 1]; i++) ext[i] = tolower(dot[i + 1]);
+        ext[i] = 0;
+        name[dot - name] = 0;
+    }
+    strcat(name, ".dbg");
+    if (pe_read(image, &pe, 0))
+    {
+        const IMAGE_DATA_DIRECTORY *dd = pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_DEBUG);
+        const IMAGE_DEBUG_DIRECTORY *dbg;
+
+        if (dd && dd->VirtualAddress && dd->Size >= sizeof(*dbg) && (dbg = pe_rva_ptr(&pe, dd->VirtualAddress, sizeof(*dbg)))
+                && dbg->Type == IMAGE_DEBUG_TYPE_MISC && dbg->PointerToRawData
+                && dbg->PointerToRawData + sizeof(IMAGE_DEBUG_MISC) < pe.size)
+        {
+            const IMAGE_DEBUG_MISC *misc = (const IMAGE_DEBUG_MISC *)(pe.data + dbg->PointerToRawData);
+            if (misc->DataType == IMAGE_DEBUG_MISC_EXENAME && !misc->Unicode
+                    && memchr(misc->Data, 0, pe.size - dbg->PointerToRawData - FIELD_OFFSET(IMAGE_DEBUG_MISC, Data)))
+            {
+                const char *n = (const char *)misc->Data, *s2 = strrchr(n, '\\');
+                lstrcpynA(name, s2 ? s2 + 1 : n, sizeof(name));
+            }
+        }
+        pe_free(&pe);
+    }
+    list[0] = 0;
+    if (symbol_path) lstrcpynA(list, symbol_path, sizeof(list));
+    for (p = list; p; p = next)
+    {
+        char cand[MAX_PATH];
+
+        if ((next = strchr(p, ';'))) *next++ = 0;
+        if (!*p) continue;
+        sprintf(cand, "%s\\Symbols\\%s\\%s", p, ext, name);
+        if (GetFileAttributesA(cand) != INVALID_FILE_ATTRIBUTES) goto found;
+        sprintf(cand, "%s\\%s\\%s", p, ext, name);
+        if (GetFileAttributesA(cand) != INVALID_FILE_ATTRIBUTES) goto found;
+        sprintf(cand, "%s\\%s", p, name);
+        if (GetFileAttributesA(cand) != INVALID_FILE_ATTRIBUTES) goto found;
+        continue;
+found:
+        strcpy(out, cand);
+        return TRUE;
+    }
+    lstrcpynA(dir, image, slash - image + 1);
+    sprintf(out, "%s%s", dir, name);
+    if (GetFileAttributesA(out) != INVALID_FILE_ATTRIBUTES) return TRUE;
+    SetLastError(ERROR_FILE_NOT_FOUND);
+    return FALSE;
+}
+
+static BOOL update_debug_info(const char *image, const char *symbol_path, char *dbg_path,
+        const IMAGE_NT_HEADERS32 *nt, BOOL check_sum, DWORD old_sum)
+{
+    char path[MAX_PATH];
+    struct dbg_values v;
+
+    if (!image || !nt)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!find_dbg_file(image, symbol_path, path)) return FALSE;
+    if (dbg_path) strcpy(dbg_path, path);
+    v.stamp = nt->FileHeader.TimeDateStamp;
+    v.checksum = nt->OptionalHeader.CheckSum;
+    v.base = nt->OptionalHeader.ImageBase;
+    v.size = nt->OptionalHeader.SizeOfImage;
+    return update_dbg_header(path, &v, check_sum, old_sum);
+}
+
+/***********************************************************************
+ *		UpdateDebugInfoFile (IMAGEHLP.@)
+ */
+BOOL WINAPI UpdateDebugInfoFile(PCSTR image, PCSTR symbol_path, PSTR dbg_path, PIMAGE_NT_HEADERS32 nt)
+{
+    TRACE("(%s, %s, %p, %p)\n", debugstr_a(image), debugstr_a(symbol_path), dbg_path, nt);
+    return update_debug_info(image, symbol_path, dbg_path, nt, FALSE, 0);
+}
+
+/***********************************************************************
+ *		UpdateDebugInfoFileEx (IMAGEHLP.@)
+ */
+BOOL WINAPI UpdateDebugInfoFileEx(PCSTR image, PCSTR symbol_path, PSTR dbg_path, PIMAGE_NT_HEADERS32 nt, DWORD old_sum)
+{
+    TRACE("(%s, %s, %p, %p, %#lx)\n", debugstr_a(image), debugstr_a(symbol_path), dbg_path, nt, old_sum);
+    return update_debug_info(image, symbol_path, dbg_path, nt, TRUE, old_sum);
+}
+
+/***********************************************************************
+ *		SplitSymbols (IMAGEHLP.@)
+ */
+BOOL WINAPI SplitSymbols(PSTR image_name, PCSTR symbols_path, PSTR symbol_file, ULONG flags)
+{
+    IMAGE_DATA_DIRECTORY *ddir;
+    IMAGE_DEBUG_DIRECTORY *dbg;
+    IMAGE_SECTION_HEADER *sec;
+    IMAGE_SEPARATE_DEBUG_HEADER shdr;
+    BYTE *dbgfile = NULL;
+    DWORD ndbg, i, at, miscsize, misc_rva = 0, dir_off, dir_avail, out_len;
+    char outdir[MAX_PATH], outpath[MAX_PATH], *base, *ext, basename[MAX_PATH];
+    BYTE **blobs = NULL;
+    DWORD *blobsizes = NULL;
+    BOOL ret = FALSE;
+    struct pe pe;
+    HANDLE file;
+    DWORD put;
+
+    TRACE("(%s, %s, %p, %#lx)\n", debugstr_a(image_name), debugstr_a(symbols_path), symbol_file, flags);
+
+    if (!image_name || !symbol_file)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!pe_read(image_name, &pe, 0)) return FALSE;
+    if (pe.nt->FileHeader.Characteristics & IMAGE_FILE_DEBUG_STRIPPED) goto invalid;
+    ddir = pe_dir(&pe, IMAGE_DIRECTORY_ENTRY_DEBUG);
+    if (!ddir || !ddir->VirtualAddress || ddir->Size < sizeof(*dbg)) goto invalid;
+    ndbg = ddir->Size / sizeof(*dbg);
+    if (!(dbg = pe_rva_ptr(&pe, ddir->VirtualAddress, ndbg * sizeof(*dbg)))) goto invalid;
+    if (!pe_rva_off(&pe, ddir->VirtualAddress, &dir_off, &dir_avail)) goto invalid;
+    sec = pe_sections(&pe);
+
+    /* where the separate file goes: SYMBOLS_PATH\<extension>\<name>.dbg, or beside the image */
+    strcpy(outpath, image_name);
+    base = strrchr(outpath, '\\');
+    if (!base) base = strrchr(outpath, '/');
+    strcpy(basename, base ? base + 1 : outpath);
+    ext = strrchr(basename, '.');
+    if (ext) *ext = 0;
+    if (symbols_path && symbols_path[0] && !(flags & SPLITSYM_SYMBOLPATH_IS_SRC))
+    {
+        char e[16];
+        size_t l = strlen(symbols_path);
+
+        strcpy(outdir, symbols_path);
+        if (l && outdir[l - 1] != '\\') strcat(outdir, "\\");
+        if (ext && ext[1])
+        {
+            for (i = 0; i < sizeof(e) - 1 && ext[i + 1]; i++) e[i] = tolower(ext[i + 1]);
+            e[i] = 0;
+            strcat(outdir, e);
+            strcat(outdir, "\\");
+        }
+    }
+    else if (base)
+    {
+        memcpy(outdir, outpath, base - outpath + 1);
+        outdir[base - outpath + 1] = 0;
+    }
+    else outdir[0] = 0;
+    sprintf(outpath, "%s%s.dbg", outdir, basename);
+    if (outdir[0] && !MakeSureDirectoryPathExists(outdir)) goto done;
+
+    /* gather the debug data blocks */
+    blobs = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ndbg * sizeof(*blobs));
+    blobsizes = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ndbg * sizeof(*blobsizes));
+    if (!blobs || !blobsizes) goto done;
+    for (i = 0; i < ndbg; i++)
+    {
+        DWORD sz = dbg[i].SizeOfData;
+        BYTE *src;
+
+        if (!sz) continue;
+        if (!dbg[i].PointerToRawData || dbg[i].PointerToRawData > pe.size || sz > pe.size - dbg[i].PointerToRawData)
+            goto invalid;
+        src = pe.data + dbg[i].PointerToRawData;
+        blobs[i] = HeapAlloc(GetProcessHeap(), 0, sz);
+        if (!blobs[i]) goto done;
+        memcpy(blobs[i], src, sz);
+        blobsizes[i] = sz;
+#ifndef SG_MUTANT_SPLIT_NOPRIV
+        if ((flags & SPLITSYM_REMOVE_PRIVATE) && dbg[i].Type == IMAGE_DEBUG_TYPE_CODEVIEW)
+#else
+        if (0)
+#endif
+        {
+            BYTE *nb;
+            DWORD ns;
+            if (cv_remove_private(blobs[i], sz, &nb, &ns))
+            {
+                HeapFree(GetProcessHeap(), 0, blobs[i]);
+                blobs[i] = nb;
+                blobsizes[i] = ns;
+            }
+        }
+    }
+
+    /* the .DBG file: header, section headers, debug directory, then the data */
+    memset(&shdr, 0, sizeof(shdr));
+    shdr.Signature = IMAGE_SEPARATE_DEBUG_SIGNATURE;
+    shdr.Machine = pe.nt->FileHeader.Machine;
+    shdr.Characteristics = pe.nt->FileHeader.Characteristics;
+    shdr.TimeDateStamp = pe.nt->FileHeader.TimeDateStamp;
+    shdr.CheckSum = pe.nt->OptionalHeader.CheckSum;
+    shdr.ImageBase = (DWORD)pe_image_base(&pe);
+    shdr.SizeOfImage = pe.nt->OptionalHeader.SizeOfImage;
+    shdr.NumberOfSections = pe.nt->FileHeader.NumberOfSections;
+    shdr.DebugDirectorySize = ndbg * sizeof(*dbg);
+    shdr.SectionAlignment = pe.nt->OptionalHeader.SectionAlignment;
+    at = sizeof(shdr) + shdr.NumberOfSections * sizeof(IMAGE_SECTION_HEADER) + ndbg * sizeof(*dbg);
+    out_len = at;
+    for (i = 0; i < ndbg; i++) out_len += align_up(blobsizes[i], 4);
+    if (!(dbgfile = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, out_len))) goto done;
+    memcpy(dbgfile, &shdr, sizeof(shdr));
+    memcpy(dbgfile + sizeof(shdr), sec, shdr.NumberOfSections * sizeof(IMAGE_SECTION_HEADER));
+    {
+        IMAGE_DEBUG_DIRECTORY *odir = (IMAGE_DEBUG_DIRECTORY *)(dbgfile + sizeof(shdr)
+                + shdr.NumberOfSections * sizeof(IMAGE_SECTION_HEADER));
+        for (i = 0; i < ndbg; i++)
+        {
+            odir[i] = dbg[i];
+            odir[i].SizeOfData = blobsizes[i];
+            if (blobsizes[i])
+            {
+                odir[i].PointerToRawData = at;
+                memcpy(dbgfile + at, blobs[i], blobsizes[i]);
+                at += align_up(blobsizes[i], 4);
+            }
+            else odir[i].PointerToRawData = 0;
+        }
+    }
+
+    /* the stripped image has one MISC entry naming the file */
+    {
+        char miscname[MAX_PATH];
+        IMAGE_DEBUG_MISC *misc;
+        DWORD misc_off = 0, misc_fits = 0;
+
+        sprintf(miscname, "%s.dbg", basename);
+        miscsize = align_up(FIELD_OFFSET(IMAGE_DEBUG_MISC, Data) + strlen(miscname) + 1, 4);
+
+        /* room: the directory entries that are no longer needed, else the old first data block */
+        if ((ndbg - 1) * sizeof(*dbg) >= miscsize && dir_avail >= ndbg * sizeof(*dbg))
+        {
+            misc_off = dir_off + sizeof(*dbg);
+            misc_fits = 1;
+        }
+        else
+            for (i = 0; i < ndbg; i++)
+                if (dbg[i].SizeOfData >= miscsize && dbg[i].PointerToRawData)
+                {
+                    misc_off = dbg[i].PointerToRawData;
+                    misc_fits = 1;
+                    break;
+                }
+        if (!misc_fits)
+        {
+            SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+            goto done;
+        }
+        if (!pe_off_rva(&pe, misc_off, &misc_rva)) goto invalid;
+
+        /* write the .DBG first: the image is only changed once that worked */
+        file = CreateFileA(outpath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
+        if (file == INVALID_HANDLE_VALUE) goto done;
+        if (!WriteFile(file, dbgfile, out_len, &put, NULL) || put != out_len)
+        {
+            CloseHandle(file);
+            goto done;
+        }
+        CloseHandle(file);
+
+        {
+            IMAGE_DEBUG_DIRECTORY first = dbg[0];
+
+            /* clear the old data and directory */
+            for (i = 0; i < ndbg; i++)
+                if (dbg[i].SizeOfData && dbg[i].PointerToRawData + dbg[i].SizeOfData <= pe.size)
+                    memset(pe.data + dbg[i].PointerToRawData, 0, dbg[i].SizeOfData);
+            memset(dbg, 0, ndbg * sizeof(*dbg));
+            misc = (IMAGE_DEBUG_MISC *)(pe.data + misc_off);
+            misc->DataType = IMAGE_DEBUG_MISC_EXENAME;
+            misc->Length = miscsize;
+            misc->Unicode = 0;
+            strcpy((char *)misc->Data, miscname);
+            dbg[0].TimeDateStamp = first.TimeDateStamp;
+            dbg[0].Type = IMAGE_DEBUG_TYPE_MISC;
+            dbg[0].SizeOfData = miscsize;
+            dbg[0].AddressOfRawData = misc_rva;
+            dbg[0].PointerToRawData = misc_off;
+            ddir->Size = sizeof(*dbg);
+        }
+    }
+
+#ifndef SG_MUTANT_SPLIT_FLAG
+    pe.nt->FileHeader.Characteristics |= IMAGE_FILE_DEBUG_STRIPPED;
+#endif
+
+    /* a trailing .debug section whose content is no longer needed is removed */
+    {
+        DWORD n = pe.nt->FileHeader.NumberOfSections;
+        IMAGE_SECTION_HEADER *last = n ? &sec[n - 1] : NULL;
+#ifdef SG_MUTANT_SPLIT_TRUNC
+        if (0)
+#else
+        if (last && !strncmp((char *)last->Name, ".debug", 8))
+#endif
+        {
+            DWORD l_off = last->PointerToRawData, l_end = l_off + last->SizeOfRawData;
+            BOOL used = (dir_off >= l_off && dir_off < l_end) || (dbg[0].PointerToRawData >= l_off && dbg[0].PointerToRawData < l_end);
+            if (!used)
+            {
+                if (l_off && l_end >= pe.size) pe.size = l_off;
+                else if (l_off) memset(pe.data + l_off, 0, min(last->SizeOfRawData, pe.size - l_off));
+                if (last->Characteristics & IMAGE_SCN_CNT_INITIALIZED_DATA)
+                    pe.nt->OptionalHeader.SizeOfInitializedData -= min(pe.nt->OptionalHeader.SizeOfInitializedData,
+                            align_up(last->SizeOfRawData, pe.nt->OptionalHeader.FileAlignment));
+                memset(last, 0, sizeof(*last));
+                pe.nt->FileHeader.NumberOfSections--;
+                if (n >= 2)
+                    pe.nt->OptionalHeader.SizeOfImage = align_up(sec[n - 2].VirtualAddress
+                            + max(sec[n - 2].Misc.VirtualSize, sec[n - 2].SizeOfRawData),
+                            pe.nt->OptionalHeader.SectionAlignment);
+            }
+        }
+    }
+    if (!pe_write(image_name, &pe)) goto done;
+
+    strcpy(symbol_file, outpath);
+    ret = TRUE;
+    goto done;
+invalid:
+    SetLastError(ERROR_INVALID_DATA);
+done:
+    if (blobs)
+    {
+        for (i = 0; i < ndbg; i++) HeapFree(GetProcessHeap(), 0, blobs[i]);
+        HeapFree(GetProcessHeap(), 0, blobs);
+    }
+    HeapFree(GetProcessHeap(), 0, blobsizes);
+    HeapFree(GetProcessHeap(), 0, dbgfile);
+    pe_free(&pe);
+    return ret;
+}
