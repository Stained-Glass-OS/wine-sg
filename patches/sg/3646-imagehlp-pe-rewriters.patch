+#include <stdio.h>
+#include <stdarg.h>
+
+#include <windef.h>
+#include <winbase.h>
+#include <winver.h>
+#include <winnt.h>
+#include <winuser.h>
+#include <imagehlp.h>
+
+#include "wine/test.h"
+
+static char tmpdir[MAX_PATH];
+
+/* ---- a PE file in memory ---- */
+
+struct timg
+{
+    BYTE *d;
+    DWORD size;
+    IMAGE_NT_HEADERS32 *nt;
+    BOOL is64;
+};
+
+static BYTE *read_file(const char *path, DWORD *size)
+{
+    HANDLE h = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, 0);
+    BYTE *buf;
+    DWORD got;
+
+    *size = 0;
+    if (h == INVALID_HANDLE_VALUE) return NULL;
+    *size = GetFileSize(h, NULL);
+    buf = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, *size + 1);
+    ReadFile(h, buf, *size, &got, NULL);
+    CloseHandle(h);
+    return buf;
+}
+
+static BOOL load_img(const char *path, struct timg *img)
+{
+    memset(img, 0, sizeof(*img));
+    img->d = read_file(path, &img->size);
+    if (!img->d || img->size < 0x200) return FALSE;
+    img->nt = (IMAGE_NT_HEADERS32 *)(img->d + ((IMAGE_DOS_HEADER *)img->d)->e_lfanew);
+    img->is64 = img->nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC;
+    return TRUE;
+}
+
+static void free_img(struct timg *img)
+{
+    HeapFree(GetProcessHeap(), 0, img->d);
+    memset(img, 0, sizeof(*img));
+}
+
+static IMAGE_SECTION_HEADER *img_secs(struct timg *img)
+{
+    return (IMAGE_SECTION_HEADER *)((BYTE *)&img->nt->OptionalHeader + img->nt->FileHeader.SizeOfOptionalHeader);
+}
+
+static IMAGE_DATA_DIRECTORY *img_dir(struct timg *img, int i)
+{
+    return (IMAGE_DATA_DIRECTORY *)((BYTE *)&img->nt->OptionalHeader + (img->is64 ? 112 : 96)) + i;
+}
+
+static ULONGLONG img_base(struct timg *img)
+{
+    return img->is64 ? ((IMAGE_NT_HEADERS64 *)img->nt)->OptionalHeader.ImageBase : img->nt->OptionalHeader.ImageBase;
+}
+
+static BYTE *img_rva(struct timg *img, DWORD rva)
+{
+    IMAGE_SECTION_HEADER *s = img_secs(img);
+    int i;
+
+    for (i = 0; i < img->nt->FileHeader.NumberOfSections; i++)
+        if (rva >= s[i].VirtualAddress && rva - s[i].VirtualAddress < s[i].SizeOfRawData)
+            return img->d + s[i].PointerToRawData + rva - s[i].VirtualAddress;
+    if (rva < img->nt->OptionalHeader.SizeOfHeaders) return img->d + rva;
+    return NULL;
+}
+
+/* export address (VA at the preferred base) of a DLL file; follows forwarders */
+static ULONGLONG ref_export(const char *path, const char *name, DWORD ordinal, const char *dirs)
+{
+    struct timg img;
+    IMAGE_EXPORT_DIRECTORY *exp;
+    IMAGE_DATA_DIRECTORY *dir;
+    DWORD *funcs, *names, idx = ~0u, i, rva;
+    WORD *ords;
+    ULONGLONG ret = 0;
+
+    if (!load_img(path, &img)) return 0;
+    dir = img_dir(&img, IMAGE_DIRECTORY_ENTRY_EXPORT);
+    exp = (void *)img_rva(&img, dir->VirtualAddress);
+    funcs = (void *)img_rva(&img, exp->AddressOfFunctions);
+    names = (void *)img_rva(&img, exp->AddressOfNames);
+    ords = (void *)img_rva(&img, exp->AddressOfNameOrdinals);
+    if (name)
+    {
+        for (i = 0; i < exp->NumberOfNames; i++)
+            if (!strcmp((char *)img_rva(&img, names[i]), name)) idx = ords[i];
+    }
+    else idx = ordinal - exp->Base;
+    if (idx < exp->NumberOfFunctions && (rva = funcs[idx]))
+    {
+        if (rva >= dir->VirtualAddress && rva < dir->VirtualAddress + dir->Size)
+        {
+            char mod[MAX_PATH], full[MAX_PATH];
+            char *fwd = (char *)img_rva(&img, rva), *dot = strchr(fwd, '.');
+
+            memcpy(mod, fwd, dot - fwd);
+            mod[dot - fwd] = 0;
+            if (SearchPathA(dirs, mod, ".dll", sizeof(full), full, NULL))
+                ret = ref_export(full, dot + 1, 0, dirs);
+        }
+        else ret = img_base(&img) + rva;
+    }
+    free_img(&img);
+    return ret;
+}
+
+static DWORD ref_stamp(const char *path)
+{
+    struct timg img;
+    DWORD ret;
+
+    if (!load_img(path, &img)) return 0;
+    ret = img.nt->FileHeader.TimeDateStamp;
+    free_img(&img);
+    return ret;
+}
+
+/* ---- the image builder ---- */
+
+struct imp_spec
+{
+    const char *dll;
+    const char *names[4]; /* "#N" is an import by ordinal */
+};
+
+struct build
+{
+    BOOL is64;
+    const struct imp_spec *imps; /* terminated by a NULL dll */
+    BOOL debug;                  /* a .debug section with CodeView and one more entry */
+    BOOL dir_in_text;            /* the debug directory is in .text, not in .debug */
+    const BYTE *cv;
+    DWORD cv_size;
+    BOOL relocs;                 /* with a base relocation directory */
+    WORD subsystem;
+    DWORD stamp;
+    ULONGLONG base;
+};
+
+#define RELOC_PAGE 0x1000
+#define NUM_RELOCS 8
+
+static const WORD reloc_types[NUM_RELOCS] =
+    { IMAGE_REL_BASED_HIGHLOW, IMAGE_REL_BASED_LOW, IMAGE_REL_BASED_HIGH, IMAGE_REL_BASED_HIGHADJ,
+      0xff /* the HIGHADJ parameter */, IMAGE_REL_BASED_DIR64, IMAGE_REL_BASED_HIGHLOW, IMAGE_REL_BASED_ABSOLUTE };
+/* where in .text each relocation applies */
+static const DWORD reloc_offs[NUM_RELOCS] = { 0x00, 0x08, 0x0c, 0x10, 0, 0x18, 0x20, 0 };
+
+static void put64(BYTE *p, ULONGLONG v) { memcpy(p, &v, 8); }
+static void put32(BYTE *p, DWORD v) { memcpy(p, &v, 4); }
+static void put16(BYTE *p, WORD v) { memcpy(p, &v, 2); }
+
+static BOOL build_pe(const char *path, const struct build *b)
+{
+    DWORD nsec = b->debug ? 4 : 3, fsize = 0x200 + nsec * 0x200, i, j, at, esize = b->is64 ? 8 : 4;
+    DWORD dbg_rva = 0, dbg_size = 0, nimp = 0, nblocks;
+    BYTE *f = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, fsize);
+    IMAGE_SECTION_HEADER *sec;
+    IMAGE_DATA_DIRECTORY *dirs;
+    IMAGE_DOS_HEADER *dos = (void *)f;
+    IMAGE_NT_HEADERS32 *nt = (void *)(f + 0x40);
+    ULONGLONG base = b->base ? b->base : (b->is64 ? 0x140000000ull : 0x10000000);
+    BYTE *idata = f + 0x400, *text = f + 0x200, *rel = f + 0x600;
+    DWORD desc_at = 0, tab_at, str_at;
+    HANDLE h;
+    DWORD put;
+    BOOL ret;
+
+    dos->e_magic = IMAGE_DOS_SIGNATURE;
+    dos->e_lfanew = 0x40;
+    nt->Signature = IMAGE_NT_SIGNATURE;
+    nt->FileHeader.Machine = b->is64 ? IMAGE_FILE_MACHINE_AMD64 : IMAGE_FILE_MACHINE_I386;
+    nt->FileHeader.NumberOfSections = nsec;
+    nt->FileHeader.TimeDateStamp = b->stamp ? b->stamp : 0x4f000000;
+    nt->FileHeader.SizeOfOptionalHeader = b->is64 ? sizeof(IMAGE_OPTIONAL_HEADER64) : sizeof(IMAGE_OPTIONAL_HEADER32);
+    nt->FileHeader.Characteristics = IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_DLL
+            | (b->is64 ? IMAGE_FILE_LARGE_ADDRESS_AWARE : IMAGE_FILE_32BIT_MACHINE);
+    if (!b->relocs) nt->FileHeader.Characteristics |= IMAGE_FILE_RELOCS_STRIPPED;
+    nt->OptionalHeader.Magic = b->is64 ? IMAGE_NT_OPTIONAL_HDR64_MAGIC : IMAGE_NT_OPTIONAL_HDR32_MAGIC;
+    nt->OptionalHeader.SizeOfCode = 0x200;
+    nt->OptionalHeader.SizeOfInitializedData = (nsec - 1) * 0x200;
+    nt->OptionalHeader.AddressOfEntryPoint = 0x1000;
+    nt->OptionalHeader.BaseOfCode = 0x1000;
+    if (b->is64) ((IMAGE_NT_HEADERS64 *)nt)->OptionalHeader.ImageBase = base;
+    else
+    {
+        nt->OptionalHeader.BaseOfData = 0x2000;
+        nt->OptionalHeader.ImageBase = (DWORD)base;
+    }
+    nt->OptionalHeader.SectionAlignment = 0x1000;
+    nt->OptionalHeader.FileAlignment = 0x200;
+    nt->OptionalHeader.MajorOperatingSystemVersion = 4;
+    nt->OptionalHeader.MajorSubsystemVersion = 4;
+    nt->OptionalHeader.SizeOfImage = 0x1000 * (nsec + 1);
+    nt->OptionalHeader.SizeOfHeaders = 0x200;
+    nt->OptionalHeader.Subsystem = b->subsystem ? b->subsystem : IMAGE_SUBSYSTEM_WINDOWS_GUI;
+    if (b->is64) ((IMAGE_NT_HEADERS64 *)nt)->OptionalHeader.NumberOfRvaAndSizes = 16;
+    else nt->OptionalHeader.NumberOfRvaAndSizes = 16;
+    dirs = (IMAGE_DATA_DIRECTORY *)((BYTE *)&nt->OptionalHeader + (b->is64 ? 112 : 96));
+    sec = (IMAGE_SECTION_HEADER *)((BYTE *)&nt->OptionalHeader + nt->FileHeader.SizeOfOptionalHeader);
+
+    strcpy((char *)sec[0].Name, ".text");
+    sec[0].VirtualAddress = 0x1000; sec[0].Misc.VirtualSize = 0x200; sec[0].SizeOfRawData = 0x200;
+    sec[0].PointerToRawData = 0x200; sec[0].Characteristics = 0x60000020;
+    strcpy((char *)sec[1].Name, ".idata");
+    sec[1].VirtualAddress = 0x2000; sec[1].Misc.VirtualSize = 0x200; sec[1].SizeOfRawData = 0x200;
+    sec[1].PointerToRawData = 0x400; sec[1].Characteristics = 0xc0000040;
+    strcpy((char *)sec[2].Name, ".reloc");
+    sec[2].VirtualAddress = 0x3000; sec[2].Misc.VirtualSize = 0x200; sec[2].SizeOfRawData = 0x200;
+    sec[2].PointerToRawData = 0x600; sec[2].Characteristics = 0x42000040;
+    if (b->debug)
+    {
+        strcpy((char *)sec[3].Name, ".debug");
+        sec[3].VirtualAddress = 0x4000; sec[3].Misc.VirtualSize = 0x200; sec[3].SizeOfRawData = 0x200;
+        sec[3].PointerToRawData = 0x800; sec[3].Characteristics = 0x42000040;
+    }
+
+    /* code: values that the relocations apply to */
+    if (b->is64) put64(text, base + 0x1000); else put32(text, (DWORD)base + 0x1000);
+    put16(text + 0x08, 0x1234);
+    put16(text + 0x0c, (WORD)((base + 0x1000) >> 16));
+    put16(text + 0x10, (WORD)((base + 0x1000) >> 16));
+    put64(text + 0x18, base + 0x1234);
+    put32(text + 0x20, (DWORD)base + 0x1100);
+
+    /* imports */
+    for (nimp = 0; b->imps && b->imps[nimp].dll; nimp++) ;
+    tab_at = (nimp + 1) * sizeof(IMAGE_IMPORT_DESCRIPTOR);
+    at = tab_at;
+    for (i = 0; i < nimp; i++)
+    {
+        DWORD n = 0;
+        while (n < 4 && b->imps[i].names[n]) n++;
+        at += 2 * (n + 1) * esize; /* ILT and IAT */
+    }
+    str_at = at;
+    for (i = 0; i < nimp; i++)
+    {
+        IMAGE_IMPORT_DESCRIPTOR *d = (void *)(idata + desc_at);
+        DWORD n = 0;
+
+        while (n < 4 && b->imps[i].names[n]) n++;
+        d->OriginalFirstThunk = 0x2000 + tab_at;
+        d->FirstThunk = 0x2000 + tab_at + (n + 1) * esize;
+        for (j = 0; j < n; j++)
+        {
+            const char *nm = b->imps[i].names[j];
+            ULONGLONG t;
+
+            if (nm[0] == '#') t = atoi(nm + 1) | (b->is64 ? 1ull << 63 : 1ull << 31);
+            else
+            {
+                put16(idata + str_at, 0);
+                strcpy((char *)idata + str_at + 2, nm);
+                t = 0x2000 + str_at;
+                str_at += (2 + strlen(nm) + 1 + 1) & ~1;
+            }
+            if (b->is64)
+            {
+                put64(idata + tab_at + j * 8, t);
+                put64(idata + tab_at + (n + 1) * 8 + j * 8, t);
+            }
+            else
+            {
+                put32(idata + tab_at + j * 4, (DWORD)t);
+                put32(idata + tab_at + (n + 1) * 4 + j * 4, (DWORD)t);
+            }
+        }
+        tab_at += 2 * (n + 1) * esize;
+        d->Name = 0x2000 + str_at;
+        strcpy((char *)idata + str_at, b->imps[i].dll);
+        str_at += (strlen(b->imps[i].dll) + 2) & ~1;
+        desc_at += sizeof(*d);
+    }
+    if (nimp)
+    {
+        dirs[IMAGE_DIRECTORY_ENTRY_IMPORT].VirtualAddress = 0x2000;
+        dirs[IMAGE_DIRECTORY_ENTRY_IMPORT].Size = (nimp + 1) * sizeof(IMAGE_IMPORT_DESCRIPTOR);
+    }
+
+    /* relocations: one block for the page of .text */
+    if (b->relocs)
+    {
+        IMAGE_BASE_RELOCATION *blk = (void *)rel;
+        WORD *ent = (WORD *)(blk + 1);
+
+        for (i = 0; i < NUM_RELOCS; i++)
+        {
+            if (!b->is64 && reloc_types[i] == IMAGE_REL_BASED_DIR64) { ent[i] = 0; continue; }
+            if (reloc_types[i] == 0xff) ent[i] = 0x2345; /* the low half belonging to the HIGHADJ before it */
+            else ent[i] = (reloc_types[i] << 12) | reloc_offs[i];
+        }
+        nblocks = NUM_RELOCS;
+        blk->VirtualAddress = RELOC_PAGE;
+        blk->SizeOfBlock = sizeof(*blk) + nblocks * 2;
+        dirs[IMAGE_DIRECTORY_ENTRY_BASERELOC].VirtualAddress = 0x3000;
+        dirs[IMAGE_DIRECTORY_ENTRY_BASERELOC].Size = blk->SizeOfBlock;
+    }
+
+    /* debug */
+    if (b->debug)
+    {
+        IMAGE_DEBUG_DIRECTORY *dd;
+        BYTE *dbgsec = f + 0x800;
+        DWORD cv_rva = 0x4040, other_rva = 0x4100;
+
+        if (b->dir_in_text) { dbg_rva = 0x1100; dd = (void *)(text + 0x100); }
+        else { dbg_rva = 0x4000; dd = (void *)dbgsec; }
+        dbg_size = 2 * sizeof(*dd);
+        dd[0].TimeDateStamp = nt->FileHeader.TimeDateStamp;
+        dd[0].Type = IMAGE_DEBUG_TYPE_CODEVIEW;
+        dd[0].SizeOfData = b->cv_size;
+        dd[0].AddressOfRawData = cv_rva;
+        dd[0].PointerToRawData = 0x800 + (cv_rva - 0x4000);
+        memcpy(dbgsec + (cv_rva - 0x4000), b->cv, b->cv_size);
+        dd[1].TimeDateStamp = nt->FileHeader.TimeDateStamp;
+        dd[1].Type = 9;
+        dd[1].SizeOfData = 16;
+        dd[1].AddressOfRawData = other_rva;
+        dd[1].PointerToRawData = 0x800 + (other_rva - 0x4000);
+        memcpy(dbgsec + (other_rva - 0x4000), "sixteen data....", 16);
+        dirs[IMAGE_DIRECTORY_ENTRY_DEBUG].VirtualAddress = dbg_rva;
+        dirs[IMAGE_DIRECTORY_ENTRY_DEBUG].Size = dbg_size;
+    }
+
+    h = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, 0);
+    ret = h != INVALID_HANDLE_VALUE && WriteFile(h, f, fsize, &put, NULL) && put == fsize;
+    if (h != INVALID_HANDLE_VALUE) CloseHandle(h);
+    HeapFree(GetProcessHeap(), 0, f);
+    return ret;
+}
+
+static void make_path(char *out, const char *name)
+{
+    sprintf(out, "%s%s", tmpdir, name);
+}
+
+static BOOL files_equal(const char *a, const char *b)
+{
+    DWORD sa, sb;
+    BYTE *da = read_file(a, &sa), *db = read_file(b, &sb);
+    BOOL ret = da && db && sa == sb && !memcmp(da, db, sa);
+
+    HeapFree(GetProcessHeap(), 0, da);
+    HeapFree(GetProcessHeap(), 0, db);
+    return ret;
+}
+
+static void check_sum_valid(const char *path, const char *what)
+{
+    DWORD hdr, sum, ret;
+
+    ret = MapFileAndCheckSumA(path, &hdr, &sum);
+    ok(!ret, "%s: MapFileAndCheckSum failed %lu.\n", what, ret);
+    ok(hdr == sum && hdr, "%s: header checksum %#lx, computed %#lx.\n", what, hdr, sum);
+}
+
+/* ---- the bind test ---- */
+
+struct cb_event
+{
+    IMAGEHLP_STATUS_REASON reason;
+    char dll[MAX_PATH];
+    ULONG_PTR va;
+    char param[64];
+};
+static struct cb_event events[256];
+static unsigned int nevents;
+
+static BOOL WINAPI record_cb(IMAGEHLP_STATUS_REASON reason, const char *file, const char *dll, ULONG_PTR va, ULONG_PTR param)
+{
+    struct cb_event *e;
+
+    if (nevents == ARRAY_SIZE(events)) return TRUE;
+    e = &events[nevents++];
+    e->reason = reason;
+    lstrcpynA(e->dll, dll ? dll : "", sizeof(e->dll));
+    e->va = va;
+    e->param[0] = 0;
+    if (param && (reason == BindImportProcedure || reason == BindImportProcedureFailed || reason == BindForwarder
+            || reason == BindForwarderNOT))
+        lstrcpynA(e->param, (const char *)param, sizeof(e->param));
+    return TRUE;
+}
+
+static unsigned int count_events(IMAGEHLP_STATUS_REASON reason)
+{
+    unsigned int i, n = 0;
+
+    for (i = 0; i < nevents; i++) if (events[i].reason == reason) n++;
+    return n;
+}
+
+static struct cb_event *find_event(IMAGEHLP_STATUS_REASON reason, const char *param)
+{
+    unsigned int i;
+
+    for (i = 0; i < nevents; i++)
+        if (events[i].reason == reason && (!param || !strcmp(events[i].param, param))) return &events[i];
+    return NULL;
+}
+
+static const char *load_testdll(const char *dir)
+{
+    static char path[MAX_PATH];
+    DWORD written;
+    HANDLE file;
+    HRSRC res;
+    void *ptr;
+
+    sprintf(path, "%stestdll.dll", dir);
+    file = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, 0);
+    ok(file != INVALID_HANDLE_VALUE, "Failed to create %s, error %lu.\n", path, GetLastError());
+    res = FindResourceA(NULL, "testdll.dll", "TESTDLL");
+    ok(!!res, "Failed to find the resource, error %lu.\n", GetLastError());
+    ptr = LockResource(LoadResource(GetModuleHandleA(NULL), res));
+    WriteFile(file, ptr, SizeofResource(GetModuleHandleA(NULL), res), &written, NULL);
+    CloseHandle(file);
+    return path;
+}
