+/* ---- CodeView and separate debug files ---- */
+
+#include <pshpack1.h>
+struct cv_dir_header { WORD hdr; WORD ent; DWORD count; DWORD next; DWORD flags; };
+struct cv_dir_entry { WORD sst; WORD mod; DWORD off; DWORD size; };
+#include <poppack.h>
+
+/* a CodeView 4 (NB09) block with a public and a private subsection of known contents */
+static DWORD build_nb09(BYTE *buf)
+{
+    static const WORD ssts[] = { 0x120, 0x121, 0x124, 0x12a, 0x129, 0x12d };
+    static const DWORD sizes[] = { 12, 16, 20, 8, 24, 4 };
+    struct cv_dir_header *dh;
+    struct cv_dir_entry *de;
+    DWORD at = 8, i;
+
+    memcpy(buf, "NB09", 4);
+    for (i = 0; i < ARRAY_SIZE(ssts); i++)
+    {
+        memset(buf + at, 0x10 + i, sizes[i]);
+        at += (sizes[i] + 3) & ~3;
+    }
+    dh = (void *)(buf + at);
+    *(DWORD *)(buf + 4) = at;
+    dh->hdr = sizeof(*dh);
+    dh->ent = sizeof(*de);
+    dh->count = ARRAY_SIZE(ssts);
+    de = (void *)(dh + 1);
+    for (i = 0, at = 8; i < ARRAY_SIZE(ssts); i++)
+    {
+        de[i].sst = ssts[i];
+        de[i].mod = 0xffff;
+        de[i].off = at;
+        de[i].size = sizes[i];
+        at += (sizes[i] + 3) & ~3;
+    }
+    at = (BYTE *)(de + ARRAY_SIZE(ssts)) - buf;
+    memcpy(buf + at, "NB09", 4);
+    *(DWORD *)(buf + at + 4) = at + 8;
+    return at + 8;
+}
+
+static void test_cv(void)
+{
+    BYTE cv[256], *out = NULL;
+    ULONG out_size = 0;
+    DWORD size, i, kept = 0;
+    struct cv_dir_header *dh;
+    struct cv_dir_entry *de;
+    BOOL ret;
+
+    size = build_nb09(cv);
+    ret = RemovePrivateCvSymbolic((PCHAR)cv, (PCHAR *)&out, &out_size);
+    ok(ret, "RemovePrivateCvSymbolic failed %lu.\n", GetLastError());
+    ok(out && out_size && out_size < size, "Got %p, %lu (was %lu).\n", out, out_size, size);
+    if (!out) return;
+    ok(!memcmp(out, "NB09", 4) && !memcmp(out + out_size - 8, "NB09", 4), "The signatures are wrong.\n");
+    dh = (void *)(out + *(DWORD *)(out + 4));
+    de = (void *)(dh + 1);
+    ok(dh->count == 3, "Got %lu subsections.\n", dh->count);
+    for (i = 0; i < dh->count; i++)
+    {
+        ok(de[i].sst == 0x120 || de[i].sst == 0x12a || de[i].sst == 0x12d, "Kept subsection %#x.\n", de[i].sst);
+        ok(de[i].off + de[i].size <= out_size, "Subsection %#x out of range.\n", de[i].sst);
+        ok(out[de[i].off] == (de[i].sst == 0x120 ? 0x10 : de[i].sst == 0x12a ? 0x13 : 0x15) && out[de[i].off + de[i].size - 1]
+                == out[de[i].off], "Subsection %#x has the wrong contents.\n", de[i].sst);
+        kept++;
+    }
+    ok(kept == 3, "kept %lu.\n", kept);
+    ok(*(DWORD *)(out + out_size - 4) == out_size, "Trailer offset %lu.\n", *(DWORD *)(out + out_size - 4));
+    HeapFree(GetProcessHeap(), 0, out);
+
+    SetLastError(0xdeadbeef);
+    ret = RemovePrivateCvSymbolic((PCHAR)nb10_cv, (PCHAR *)&out, &out_size);
+    ok(!ret && GetLastError() == ERROR_INVALID_DATA, "Got %d, %lu.\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = RemovePrivateCvSymbolic(NULL, (PCHAR *)&out, &out_size);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, %lu.\n", ret, GetLastError());
+}
