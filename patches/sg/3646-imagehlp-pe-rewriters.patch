+/* ---- rebase ---- */
+
+static void check_relocated(const char *what, struct timg *t, ULONGLONG old_base, ULONGLONG new_base)
+{
+    LONGLONG delta = new_base - old_base;
+    BYTE *text = img_rva(t, 0x1000);
+    ULONGLONG ob = old_base;
+
+    ok(img_base(t) == new_base, "%s: base %I64x, expected %I64x.\n", what, img_base(t), new_base);
+    ok(*(DWORD *)text == (DWORD)(ob + 0x1000 + delta), "%s: HIGHLOW %#lx.\n", what, *(DWORD *)text);
+    ok(*(WORD *)(text + 0x08) == (WORD)(0x1234 + delta), "%s: LOW %#x.\n", what, *(WORD *)(text + 0x08));
+    ok(*(WORD *)(text + 0x0c) == (WORD)(((ob + 0x1000) >> 16) + (delta >> 16)), "%s: HIGH %#x.\n", what,
+            *(WORD *)(text + 0x0c));
+    {
+        /* HIGHADJ: the 16 bit field is the high half of a 32 bit value whose low half is the next entry */
+        LONG full = ((LONG)(WORD)((ob + 0x1000) >> 16) << 16) + (SHORT)0x2345;
+        full += (LONG)delta + 0x8000;
+        ok(*(WORD *)(text + 0x10) == (WORD)(full >> 16), "%s: HIGHADJ %#x, expected %#x.\n", what,
+                *(WORD *)(text + 0x10), (WORD)(full >> 16));
+    }
+    if (t->is64)
+        ok(*(ULONGLONG *)(text + 0x18) == ob + 0x1234 + delta, "%s: DIR64 %I64x.\n", what, *(ULONGLONG *)(text + 0x18));
+    ok(*(DWORD *)(text + 0x20) == (DWORD)(ob + 0x1100 + delta), "%s: HIGHLOW 2 %#lx.\n", what,
+            *(DWORD *)(text + 0x20));
+}
+
+static void test_rebase_one(BOOL is64)
+{
+    char img[MAX_PATH], orig[MAX_PATH];
+    struct build b = { 0 };
+    ULONG osize, nsize;
+    ULONG64 obase, nbase;
+    ULONG_PTR obase_p, nbase_p;
+    struct timg t;
+    ULONGLONG start = is64 ? 0x140000000ull : 0x10000000;
+    BOOL ret;
+
+    b.is64 = is64;
+    b.relocs = TRUE;
+    b.stamp = 0x4f000000;
+    make_path(img, "sgrebase.dll");
+    make_path(orig, "sgrebase.orig");
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    CopyFileA(img, orig, FALSE);
+
+    /* only computing: down from 0x20000000 */
+    nbase = 0x20000000;
+    ret = ReBaseImage64(img, NULL, FALSE, TRUE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(ret, "ReBaseImage64 failed %lu.\n", GetLastError());
+    ok(osize == 0x4000 && nsize == 0x10000, "Sizes %#lx, %#lx.\n", osize, nsize);
+    ok(obase == start, "Old base %I64x.\n", obase);
+    ok(nbase == 0x20000000 - 0x10000, "New base %I64x.\n", nbase);
+    ok(files_equal(img, orig), "The file changed without fReBase.\n");
+
+    /* going up */
+    nbase = 0x30000001;
+    ret = ReBaseImage64(img, NULL, FALSE, TRUE, FALSE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(ret, "ReBaseImage64 failed %lu.\n", GetLastError());
+    ok(nbase == 0x30010000 + 0x10000, "New base %I64x.\n", nbase);
+
+    /* the image is too big for the check size */
+    nbase = 0x20000000;
+    SetLastError(0xdeadbeef);
+    ret = ReBaseImage64(img, NULL, TRUE, TRUE, TRUE, 0x1000, &osize, &obase, &nsize, &nbase, 0);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, %lu.\n", ret, GetLastError());
+    ok(files_equal(img, orig), "The file changed.\n");
+
+    /* the real rebase, down */
+    nbase = 0x20000000;
+    ret = ReBaseImage64(img, NULL, TRUE, TRUE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0x50000000);
+    ok(ret, "ReBaseImage64 failed %lu.\n", GetLastError());
+    ok(nbase == 0x1fff0000, "Next base %I64x.\n", nbase);
+    ok(load_img(img, &t), "Cannot load the image.\n");
+    check_relocated("down", &t, start, 0x1fff0000);
+    ok(t.nt->FileHeader.TimeDateStamp == 0x50000000, "Stamp %#lx.\n", t.nt->FileHeader.TimeDateStamp);
+    free_img(&t);
+    check_sum_valid(img, "rebased image");
+
+    /* and up again, with the 32-bit-pointer variant (it works on pointer sized values) */
+    {
+        obase_p = 0;
+        nbase_p = 0x40000000;
+        ret = ReBaseImage(img, NULL, TRUE, TRUE, FALSE, 0, &osize, &obase_p, &nsize, &nbase_p, 0);
+        ok(ret, "ReBaseImage failed %lu.\n", GetLastError());
+        ok(obase_p == 0x1fff0000, "Old base %Ix.\n", obase_p);
+        ok(nbase_p == 0x40010000, "Next base %Ix.\n", nbase_p);
+        ok(load_img(img, &t), "Cannot load the image.\n");
+        check_relocated("up", &t, 0x1fff0000, 0x40000000);
+        ok(t.nt->FileHeader.TimeDateStamp == 0x50000000, "The stamp changed to %#lx.\n", t.nt->FileHeader.TimeDateStamp);
+        free_img(&t);
+    }
+
+    /* an image without relocations stays where it is */
+    b.relocs = FALSE;
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    CopyFileA(img, orig, FALSE);
+    nbase = 0x20000000;
+    ret = ReBaseImage64(img, NULL, TRUE, TRUE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(ret, "ReBaseImage64 failed %lu.\n", GetLastError());
+    ok(files_equal(img, orig), "An image without relocations changed.\n");
+    ok(nbase == start, "Next base %I64x.\n", nbase);
+
+    /* system files (native subsystem) only when allowed */
+    b.relocs = TRUE;
+    b.subsystem = IMAGE_SUBSYSTEM_NATIVE;
+    ret = build_pe(img, &b);
+    ok(ret, "Failed to build the image.\n");
+    CopyFileA(img, orig, FALSE);
+    nbase = 0x20000000;
+    ret = ReBaseImage64(img, NULL, TRUE, FALSE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(ret && files_equal(img, orig), "A system file was rebased.\n");
+    nbase = 0x20000000;
+    ret = ReBaseImage64(img, NULL, TRUE, TRUE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(ret && !files_equal(img, orig), "A system file was not rebased when allowed.\n");
+
+    /* errors */
+    SetLastError(0xdeadbeef);
+    nbase = 0x20000000;
+    ret = ReBaseImage64("C:\\nonexistent\\sg.dll", NULL, TRUE, TRUE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(!ret && (GetLastError() == ERROR_PATH_NOT_FOUND || GetLastError() == ERROR_FILE_NOT_FOUND),
+            "Got %d, %lu.\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    nbase = 0x8000;
+    ret = ReBaseImage64(img, NULL, TRUE, TRUE, TRUE, 0, &osize, &obase, &nsize, &nbase, 0);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, %lu.\n", ret, GetLastError());
+
+    DeleteFileA(img);
+    DeleteFileA(orig);
+}
+
+static void test_rebase(void)
+{
+    test_rebase_one(FALSE);
+    test_rebase_one(TRUE);
+}
