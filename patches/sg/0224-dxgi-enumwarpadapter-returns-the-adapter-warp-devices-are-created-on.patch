From: Stained Glass OS <dev@stained-glass.example>
Subject: dxgi: EnumWarpAdapter returns the adapter WARP devices are created on

IDXGIFactory4::EnumWarpAdapter was a stub returning E_NOTIMPL; Paint.NET
asks for the WARP adapter when it chooses its GPU and died on the error.
d3d11 creates a D3D_DRIVER_TYPE_WARP device on the first adapter, so that
adapter is returned.

Gate: test/d2dfx-gate.sh.
---
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -457,9 +457,22 @@
 static HRESULT STDMETHODCALLTYPE dxgi_factory_EnumWarpAdapter(IWineDXGIFactory *iface,
         REFIID iid, void **adapter)
 {
-    FIXME("iface %p, iid %s, adapter %p stub!\n", iface, debugstr_guid(iid), adapter);
+    IDXGIAdapter1 *adapter1;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, iid %s, adapter %p.\n", iface, debugstr_guid(iid), adapter);
+
+    if (!adapter)
+        return DXGI_ERROR_INVALID_CALL;
+    *adapter = NULL;
+
+    /* A device created with D3D_DRIVER_TYPE_WARP is a device on the first
+     * adapter, so that is the WARP adapter too. */
+    if (FAILED(hr = dxgi_factory_EnumAdapters1(iface, 0, &adapter1)))
+        return hr == DXGI_ERROR_NOT_FOUND ? DXGI_ERROR_UNSUPPORTED : hr;
+    hr = IDXGIAdapter1_QueryInterface(adapter1, iid, adapter);
+    IDXGIAdapter1_Release(adapter1);
+    return hr;
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CheckFeatureSupport(IWineDXGIFactory *iface,
