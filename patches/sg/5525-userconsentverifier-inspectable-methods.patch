From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.credentials.ui.userconsentverifier: IInspectable GetIids and GetTrustLevel

The activation factory and the CheckAvailabilityAsync operation answered
E_NOTIMPL to IInspectable::GetIids and GetTrustLevel (and the factory to
GetRuntimeClassName), which a WinRT projection uses when it wraps the object.
They now answer as IInspectable describes: the interfaces the object
implements besides IUnknown and IInspectable, BaseTrust, and for the factory
the runtime class name of the class it serves.

Rebased at integration (integ-2026-10) onto fast-b 3716 (RECONCILE-CLOUD KEEP-A, a superset). Only 5525's conformance tests are kept (they pass on 3716).
---
diff --git a/dlls/windows.security.credentials.ui.userconsentverifier/tests/verifier.c b/dlls/windows.security.credentials.ui.userconsentverifier/tests/verifier.c
--- a/dlls/windows.security.credentials.ui.userconsentverifier/tests/verifier.c
+++ b/dlls/windows.security.credentials.ui.userconsentverifier/tests/verifier.c
@@ -228,6 +228,22 @@ static void test_UserConsentVerifierStatics(void)
     check_interface( factory, &IID_IUnknown );
     check_interface( factory, &IID_IInspectable );
     check_interface( factory, &IID_IAgileObject );
+    {
+        TrustLevel trust = 0xdeadbeef;
+        ULONG count = 0, i;
+        IID *iids = NULL;
+        BOOL found = FALSE;
+
+        hr = IInspectable_GetTrustLevel( (IInspectable *)factory, &trust );
+        ok( hr == S_OK, "GetTrustLevel returned %#lx\n", hr );
+        ok( trust == BaseTrust, "got trust level %u\n", trust );
+        hr = IInspectable_GetIids( (IInspectable *)factory, &count, &iids );
+        ok( hr == S_OK, "GetIids returned %#lx\n", hr );
+        for (i = 0; hr == S_OK && i < count; i++)
+            if (IsEqualGUID( iids + i, &IID_IUserConsentVerifierStatics )) found = TRUE;
+        ok( found, "IUserConsentVerifierStatics missing from %lu iids\n", count );
+        CoTaskMemFree( iids );
+    }
 
     hr = IActivationFactory_QueryInterface( factory, &IID_IUserConsentVerifierStatics, (void **)&user_consent_verifier_statics );
     ok( hr == S_OK, "got hr %#lx.\n", hr );
@@ -243,6 +259,27 @@ static void test_UserConsentVerifierStatics(void)
     check_interface( verifier_async, &IID_IAsyncInfo );
     check_interface( verifier_async, &IID_IAsyncOperation_UserConsentVerifierAvailability );
     check_runtimeclass( verifier_async, L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.UI.UserConsentVerifierAvailability>" );
+    {
+        IInspectable *inspectable = (IInspectable *)verifier_async;
+        TrustLevel trust = 0xdeadbeef;
+        ULONG count = 0, i;
+        IID *iids = NULL;
+        BOOL found_op = FALSE, found_info = FALSE;
+
+        hr = IInspectable_GetTrustLevel( inspectable, &trust );
+        ok( hr == S_OK, "GetTrustLevel returned %#lx\n", hr );
+        ok( trust == BaseTrust, "got trust level %u\n", trust );
+
+        hr = IInspectable_GetIids( inspectable, &count, &iids );
+        ok( hr == S_OK, "GetIids returned %#lx\n", hr );
+        for (i = 0; hr == S_OK && i < count; i++)
+        {
+            if (IsEqualGUID( iids + i, &IID_IAsyncOperation_UserConsentVerifierAvailability )) found_op = TRUE;
+            if (IsEqualGUID( iids + i, &IID_IAsyncInfo )) found_info = TRUE;
+        }
+        ok( found_op && found_info, "IAsyncOperation and IAsyncInfo missing from %lu iids\n", count );
+        CoTaskMemFree( iids );
+    }
 
     hr = IAsyncOperation_UserConsentVerifierAvailability_get_Completed( verifier_async, &tmp_handler );
     ok( hr == S_OK, "get_Completed returned %#lx\n", hr );
