From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.security.credentials.ui.userconsentverifier: IInspectable GetIids and GetTrustLevel

The activation factory and the CheckAvailabilityAsync operation answered
E_NOTIMPL to IInspectable::GetIids and GetTrustLevel (and the factory to
GetRuntimeClassName), which a WinRT projection uses when it wraps the object.
They now answer as IInspectable describes: the interfaces the object
implements besides IUnknown and IInspectable, BaseTrust, and for the factory
the runtime class name of the class it serves.
---
--- a/dlls/windows.security.credentials.ui.userconsentverifier/async.c
+++ b/dlls/windows.security.credentials.ui.userconsentverifier/async.c
@@ -418,8 +418,17 @@ static ULONG WINAPI async_user_consent_verifier_availability_Release( IAsyncOper
 
 static HRESULT WINAPI async_user_consent_verifier_availability_GetIids( IAsyncOperation_UserConsentVerifierAvailability *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    IID *list;
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    /* the interfaces beyond IUnknown and IInspectable the object implements */
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = IID_IAsyncOperation_UserConsentVerifierAvailability;
+    list[1] = IID_IAsyncInfo;
+    *iid_count = 2;
+    *iids = list;
+    return S_OK;
 }
 
 static HRESULT WINAPI async_user_consent_verifier_availability_GetRuntimeClassName( IAsyncOperation_UserConsentVerifierAvailability *iface, HSTRING *class_name )
@@ -431,8 +440,12 @@ static HRESULT WINAPI async_user_consent_verifier_availability_GetRuntimeClassNa
 
 static HRESULT WINAPI async_user_consent_verifier_availability_GetTrustLevel( IAsyncOperation_UserConsentVerifierAvailability *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+#ifdef SG_MUTANT_UCV_TRUST
     return E_NOTIMPL;
+#endif
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI async_user_consent_verifier_availability_put_Completed( IAsyncOperation_UserConsentVerifierAvailability *iface,
--- a/dlls/windows.security.credentials.ui.userconsentverifier/main.c
+++ b/dlls/windows.security.credentials.ui.userconsentverifier/main.c
@@ -81,20 +81,32 @@ static ULONG WINAPI factory_Release( IActivationFactory *iface )
 
 static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    IID *list;
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    /* the statics interface of the class, besides IActivationFactory */
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = IID_IActivationFactory;
+    list[1] = IID_IUserConsentVerifierStatics;
+    *iid_count = 2;
+    *iids = list;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
 {
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
+    static const WCHAR name[] = L"Windows.Security.Credentials.UI.UserConsentVerifier";
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
 }
 
 static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
--- a/dlls/windows.security.credentials.ui.userconsentverifier/tests/verifier.c
+++ b/dlls/windows.security.credentials.ui.userconsentverifier/tests/verifier.c
@@ -227,6 +227,22 @@ static void test_UserConsentVerifierStatics(void)
 
     check_interface( factory, &IID_IUnknown );
     check_interface( factory, &IID_IInspectable );
+    {
+        TrustLevel trust = 0xdeadbeef;
+        ULONG count = 0, i;
+        IID *iids = NULL;
+        BOOL found = FALSE;
+
+        hr = IInspectable_GetTrustLevel( (IInspectable *)factory, &trust );
+        ok( hr == S_OK, "GetTrustLevel returned %#lx\n", hr );
+        ok( trust == BaseTrust, "got trust level %u\n", trust );
+        hr = IInspectable_GetIids( (IInspectable *)factory, &count, &iids );
+        ok( hr == S_OK, "GetIids returned %#lx\n", hr );
+        for (i = 0; hr == S_OK && i < count; i++)
+            if (IsEqualGUID( iids + i, &IID_IUserConsentVerifierStatics )) found = TRUE;
+        ok( found, "IUserConsentVerifierStatics missing from %lu iids\n", count );
+        CoTaskMemFree( iids );
+    }
 
     hr = IActivationFactory_QueryInterface( factory, &IID_IUserConsentVerifierStatics, (void **)&user_consent_verifier_statics );
     ok( hr == S_OK, "got hr %#lx.\n", hr );
@@ -242,6 +258,27 @@ static void test_UserConsentVerifierStatics(void)
     check_interface( verifier_async, &IID_IAsyncInfo );
     check_interface( verifier_async, &IID_IAsyncOperation_UserConsentVerifierAvailability );
     check_runtimeclass( verifier_async, L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.UI.UserConsentVerifierAvailability>" );
+    {
+        IInspectable *inspectable = (IInspectable *)verifier_async;
+        TrustLevel trust = 0xdeadbeef;
+        ULONG count = 0, i;
+        IID *iids = NULL;
+        BOOL found_op = FALSE, found_info = FALSE;
+
+        hr = IInspectable_GetTrustLevel( inspectable, &trust );
+        ok( hr == S_OK, "GetTrustLevel returned %#lx\n", hr );
+        ok( trust == BaseTrust, "got trust level %u\n", trust );
+
+        hr = IInspectable_GetIids( inspectable, &count, &iids );
+        ok( hr == S_OK, "GetIids returned %#lx\n", hr );
+        for (i = 0; hr == S_OK && i < count; i++)
+        {
+            if (IsEqualGUID( iids + i, &IID_IAsyncOperation_UserConsentVerifierAvailability )) found_op = TRUE;
+            if (IsEqualGUID( iids + i, &IID_IAsyncInfo )) found_info = TRUE;
+        }
+        ok( found_op && found_info, "IAsyncOperation and IAsyncInfo missing from %lu iids\n", count );
+        CoTaskMemFree( iids );
+    }
 
     hr = IAsyncOperation_UserConsentVerifierAvailability_get_Completed( verifier_async, &tmp_handler );
     ok( hr == S_OK, "get_Completed returned %#lx\n", hr );
