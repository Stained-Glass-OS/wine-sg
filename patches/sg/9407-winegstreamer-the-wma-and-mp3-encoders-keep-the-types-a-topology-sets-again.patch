From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winegstreamer: The WMA and MP3 encoders keep the types a topology loader sets again (9407)

Found with the transcode API (9405) in a Media Session: the WMA encoder took the all-zero codec
data of its not yet negotiated GStreamer caps into its output type (the .wma's header then said
"no exponent VLCs" and every decoder made noise of it); it accepted an input type of another rate than
its output type and dropped the output type (so no resampler was put in front: the session stopped
with MF_E_TRANSFORM_TYPE_NOT_SET); and the MP3 encoder dropped its input type whenever its output type
was set again (the session never ended). The encoders now keep the types that fit and refuse an input
of another rate or channel count once the output type is set, as the AAC encoder does.
---
--- a/dlls/winegstreamer/wma_encoder.c
+++ b/dlls/winegstreamer/wma_encoder.c
@@ -407,7 +407,7 @@
     struct wg_transform_attrs attrs = {.input_queue_length = 15};
     IMFMediaType *actual, *output;
     UINT8 *codec_data = NULL;
-    UINT32 size = 0, block;
+    UINT32 size = 0, block, i;
     HRESULT hr;
 
     encoder_destroy_transform(impl);
@@ -428,8 +428,13 @@
     CoTaskMemFree(codec_data);
     codec_data = NULL;
 #endif
-    if (codec_data && SUCCEEDED(create_output_type(impl->rate, impl->channels, impl->block_align, codec_data,
-            size, &output)))
+    /* before the encoder has negotiated, its caps have no codec data: the type then reads all zeros */
+    for (i = 0; codec_data && i < size && !codec_data[i]; i++) ;
+#ifdef SG_MUTANT_WMAENC_ZERO_CODEC_DATA
+    i = size ? 0 : i;
+#endif
+    if (codec_data && i < size && SUCCEEDED(create_output_type(impl->rate, impl->channels, impl->block_align,
+            codec_data, size, &output)))
     {
         IMFMediaType_Release(impl->output_type);
         impl->output_type = output;
@@ -492,6 +497,10 @@
         return MF_E_INVALIDMEDIATYPE;
     if (FAILED(IMFMediaType_GetUINT32(type, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, &bytes)) || bytes != rate * block)
         return MF_E_INVALIDMEDIATYPE;
+    /* with an output type set, the input is of its rate and channels (a topology loader then puts a
+     * resampler in front) */
+    if (impl->output_type && (rate != impl->rate || channels != impl->channels))
+        return MF_E_INVALIDMEDIATYPE;
     if (flags & MFT_SET_TYPE_TEST_ONLY)
         return S_OK;
 
@@ -502,13 +511,6 @@
     impl->input_type = input;
     impl->depth = depth;
     encoder_destroy_transform(impl);
-    /* an output type of other rates or channels goes; one that fits is kept (a sink writer or a
-     * transcode topology sets the encoder's output type first) */
-    if (impl->output_type && (rate != impl->rate || channels != impl->channels))
-    {
-        IMFMediaType_Release(impl->output_type);
-        impl->output_type = NULL;
-    }
     impl->rate = rate;
     impl->channels = channels;
     if (impl->output_type && FAILED(hr = encoder_try_create_transform(impl)))
--- a/dlls/winegstreamer/mp3_encoder.c
+++ b/dlls/winegstreamer/mp3_encoder.c
@@ -457,9 +457,13 @@
     if (flags & MFT_SET_TYPE_TEST_ONLY)
         return S_OK;
 
-    /* the encoder adds MF_MT_USER_DATA (and the rest of the description); a new output type
-     * takes the input type away */
+    /* the encoder adds MF_MT_USER_DATA (and the rest of the description); an input type of other rates
+     * or channels goes (one that fits is kept: a topology loader sets the output type again) */
+#ifndef SG_MUTANT_MP3ENC_DROP_INPUT
+    if (encoder->input_type && (rate != encoder->rate || channels != encoder->channels))
+#else
     if (encoder->input_type)
+#endif
     {
         IMFMediaType_Release(encoder->input_type);
         encoder->input_type = NULL;
