From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: proximity evaluation, auto-rotation preferences, AnimateWindow

user32: EvaluateProximityToRect failed with ERROR_CALL_NOT_IMPLEMENTED and
EvaluateProximityToPolygon was not exported; both now give the touch hit
test score (pixel distance, 0 inside, capped at 0xFFF) and the adjusted
point.  Get/SetDisplayAutoRotationPreferences stored nothing; they now keep
the per-process preference and refuse unknown bits.  AnimateWindow only
showed or hid the window; it now takes the time given: AW_BLEND ramps the
layered alpha (restoring a window's own layered state), roll/slide/centre
grow or shrink the window region, and AW_BLEND on a child fails.

---
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -22,6 +22,7 @@
  */
 
 #include <stdarg.h>
+#include <math.h>
 
 #include "windef.h"
 #include "wine/windef16.h"
@@ -896,6 +897,16 @@ BOOL WINAPI RegisterTouchHitTestingWindow(HWND hwnd, ULONG value)
     return TRUE;
 }
 
+/* Stained Glass OS: score is the distance (in pixels) from the touch point to the
+ * target, capped at TOUCH_HIT_TESTING_PROXIMITY_FARTHEST; 0 when the point is inside. */
+static void set_proximity( TOUCH_HIT_TESTING_PROXIMITY_EVALUATION *proximity, POINT pt, POINT adjusted )
+{
+    double dx = pt.x - adjusted.x, dy = pt.y - adjusted.y, dist = sqrt( dx * dx + dy * dy );
+
+    proximity->score = dist >= TOUCH_HIT_TESTING_PROXIMITY_FARTHEST ? TOUCH_HIT_TESTING_PROXIMITY_FARTHEST : (UINT16)(dist + 0.5);
+    proximity->adjustedPoint = adjusted;
+}
+
 /**********************************************************************
  * EvaluateProximityToRect [USER32.@]
  */
@@ -903,9 +914,63 @@ BOOL WINAPI EvaluateProximityToRect(const RECT *box,
                                     const TOUCH_HIT_TESTING_INPUT *input,
                                     TOUCH_HIT_TESTING_PROXIMITY_EVALUATION *proximity)
 {
-    FIXME("(%p,%p,%p): stub\n", box, input, proximity);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    POINT adjusted;
+
+    if (!box || !input || !proximity || box->left > box->right || box->top > box->bottom)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    adjusted.x = min( max( input->point.x, box->left ), box->right - 1 );
+    adjusted.y = min( max( input->point.y, box->top ), box->bottom - 1 );
+    if (box->left == box->right) adjusted.x = box->left;
+    if (box->top == box->bottom) adjusted.y = box->top;
+#ifdef SG_MUTANT_PROX_NO_CLAMP
+    adjusted = input->point;
+#endif
+    set_proximity( proximity, input->point, adjusted );
+    return TRUE;
+}
+
+/**********************************************************************
+ * EvaluateProximityToPolygon [USER32.@]
+ */
+BOOL WINAPI EvaluateProximityToPolygon(UINT32 count, const POINT *vertices,
+                                       const TOUCH_HIT_TESTING_INPUT *input,
+                                       TOUCH_HIT_TESTING_PROXIMITY_EVALUATION *proximity)
+{
+    double best = -1;
+    POINT adjusted = input ? input->point : (POINT){0};
+    BOOL inside = FALSE;
+    UINT32 i;
+
+    if (!count || !vertices || !input || !proximity)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        POINT a = vertices[i], b = vertices[(i + 1) % count], pt = input->point;
+        double dx = b.x - a.x, dy = b.y - a.y, len2 = dx * dx + dy * dy, t = 0, px, py, d;
+
+        if ((a.y > pt.y) != (b.y > pt.y) &&
+            pt.x < (double)(b.x - a.x) * (pt.y - a.y) / (b.y - a.y) + a.x)
+            inside = !inside;
+        if (len2 > 0) t = ((pt.x - a.x) * dx + (pt.y - a.y) * dy) / len2;
+        t = t < 0 ? 0 : t > 1 ? 1 : t;
+        px = a.x + t * dx;
+        py = a.y + t * dy;
+        d = (pt.x - px) * (pt.x - px) + (pt.y - py) * (pt.y - py);
+        if (best < 0 || d < best)
+        {
+            best = d;
+            adjusted.x = floor( px + 0.5 );
+            adjusted.y = floor( py + 0.5 );
+        }
+    }
+    set_proximity( proximity, input->point, inside ? input->point : adjusted );
+    return TRUE;
 }
 
 /**********************************************************************
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -1068,13 +1068,20 @@ BOOL WINAPI GetAutoRotationState( AR_STATE *state )
     return TRUE;
 }
 
+/* Stained Glass OS: the preferences are per process, as documented */
+static LONG auto_rotation_prefs;
+
 /**********************************************************************
  *              GetDisplayAutoRotationPreferences (USER32.@)
  */
 BOOL WINAPI GetDisplayAutoRotationPreferences( ORIENTATION_PREFERENCE *orientation )
 {
-    FIXME("(%p): stub\n", orientation);
-    *orientation = ORIENTATION_PREFERENCE_NONE;
+    if (!orientation)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *orientation = InterlockedCompareExchange( &auto_rotation_prefs, 0, 0 );
     return TRUE;
 }
 
@@ -1083,7 +1090,17 @@ BOOL WINAPI GetDisplayAutoRotationPreferences( ORIENTATION_PREFERENCE *orientati
  */
 BOOL WINAPI SetDisplayAutoRotationPreferences( ORIENTATION_PREFERENCE orientation )
 {
-    FIXME("(%d): stub\n", orientation);
+#ifdef SG_MUTANT_ROT_ANYBITS
+    if (0)
+#else
+    if (orientation & ~(ORIENTATION_PREFERENCE_LANDSCAPE | ORIENTATION_PREFERENCE_PORTRAIT |
+                        ORIENTATION_PREFERENCE_LANDSCAPE_FLIPPED | ORIENTATION_PREFERENCE_PORTRAIT_FLIPPED))
+#endif
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    InterlockedExchange( &auto_rotation_prefs, orientation );
     return TRUE;
 }
 
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -488,7 +488,7 @@
 @ stdcall EnumWindowStationsW(ptr long)
 @ stdcall EnumWindows(ptr long)
 @ stdcall EqualRect(ptr ptr)
-# @ stub EvaluateProximityToPolygon
+@ stdcall EvaluateProximityToPolygon(long ptr ptr ptr)
 @ stdcall EvaluateProximityToRect(ptr ptr ptr)
 @ stdcall ExcludeUpdateRgn(long long) NtUserExcludeUpdateRgn
 @ stdcall ExitWindowsEx(long long)
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -846,22 +846,125 @@ BOOL WINAPI BringWindowToTop( HWND hwnd )
 }
 
 
+static void animate_region( HWND hwnd, const RECT *size, DWORD flags, int pos, int steps, BOOL hide )
+{
+    int w = size->right, h = size->bottom, n = hide ? steps - pos : pos;
+    RECT r = { 0, 0, w, h };
+    HRGN rgn;
+
+    if (flags & AW_CENTER)
+    {
+        r.left = (w - w * n / steps) / 2;
+        r.top = (h - h * n / steps) / 2;
+        r.right = w - r.left;
+        r.bottom = h - r.top;
+    }
+    else
+    {
+        if (flags & AW_HOR_POSITIVE) r.right = w * n / steps;
+        else if (flags & AW_HOR_NEGATIVE) r.left = w - w * n / steps;
+        if (flags & AW_VER_POSITIVE) r.bottom = h * n / steps;
+        else if (flags & AW_VER_NEGATIVE) r.top = h - h * n / steps;
+    }
+    if (!(rgn = CreateRectRgn( r.left, r.top, r.right, r.bottom ))) return;
+    if (!NtUserSetWindowRgn( hwnd, rgn, TRUE )) DeleteObject( rgn );
+}
+
 /***********************************************************************
  *           AnimateWindow (USER32.@)
+ *
+ * Stained Glass OS: the window is revealed (or concealed) synchronously over
+ * the given time: AW_BLEND ramps the layered alpha, the roll/slide/centre
+ * variants grow or shrink the window region.
  */
 BOOL WINAPI AnimateWindow( HWND hwnd, DWORD time, DWORD flags )
 {
-    FIXME( "partial stub\n" );
+    BOOL hide = (flags & AW_HIDE) != 0, was_layered, region_anim, blend;
+    DWORD old_flags = 0, ex_style, start, now, elapsed;
+    COLORREF old_key = 0;
+    BYTE old_alpha = 255;
+    RECT rect, size;
+    HRGN tmp;
+    int steps, pos;
 
-    /* If trying to show/hide and it's already shown/hidden or invalid window,
-     * fail with invalid parameter. */
-    if (!IsWindow( hwnd ) || (!(flags & AW_HIDE)) == IsWindowVisible( hwnd ))
+    if (!IsWindow( hwnd ) || (!hide) == IsWindowVisible( hwnd ))
     {
-        SetLastError(ERROR_INVALID_PARAMETER);
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
     }
+    /* AW_BLEND cannot be used on child windows */
+    if ((flags & AW_BLEND) && (GetWindowLongW( hwnd, GWL_STYLE ) & WS_CHILD))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!time) time = 200;
+
+    blend = (flags & AW_BLEND) != 0;
+    region_anim = !blend && (flags & (AW_CENTER | AW_HOR_POSITIVE | AW_HOR_NEGATIVE |
+                                      AW_VER_POSITIVE | AW_VER_NEGATIVE));
+    if (region_anim)
+    {
+        /* a window with a region of its own is not animated through its region */
+        if ((tmp = CreateRectRgn( 0, 0, 0, 0 )))
+        {
+            if (NtUserGetWindowRgnEx( hwnd, tmp, 0 ) != ERROR) region_anim = FALSE;
+            DeleteObject( tmp );
+        }
+    }
+    if (!blend && !region_anim)
+    {
+        NtUserShowWindow( hwnd, hide ? SW_HIDE : ((flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA) );
+        return TRUE;
+    }
+
+    GetWindowRect( hwnd, &rect );
+    size.left = size.top = 0;
+    size.right = rect.right - rect.left;
+    size.bottom = rect.bottom - rect.top;
+    steps = max( 1, min( time / 10, 60 ));
+
+    ex_style = GetWindowLongW( hwnd, GWL_EXSTYLE );
+    was_layered = (ex_style & WS_EX_LAYERED) != 0;
+    if (blend)
+    {
+        if (was_layered) NtUserGetLayeredWindowAttributes( hwnd, &old_key, &old_alpha, &old_flags );
+        else SetWindowLongW( hwnd, GWL_EXSTYLE, ex_style | WS_EX_LAYERED );
+        NtUserSetLayeredWindowAttributes( hwnd, old_key, hide ? 255 : 0, LWA_ALPHA | (old_flags & LWA_COLORKEY) );
+    }
+    else animate_region( hwnd, &size, flags, 0, steps, hide );
+
+    if (!hide) NtUserShowWindow( hwnd, (flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA );
 
-    NtUserShowWindow( hwnd, (flags & AW_HIDE) ? SW_HIDE : ((flags & AW_ACTIVATE) ? SW_SHOW : SW_SHOWNA) );
+    start = GetTickCount();
+    for (pos = 1; pos <= steps; pos++)
+    {
+        DWORD due = start + time * pos / steps;
+        now = GetTickCount();
+        if (due > now) Sleep( due - now );
+        if (blend)
+        {
+            int a = (hide ? steps - pos : pos) * 255 / steps;
+#ifdef SG_MUTANT_NO_BLEND_RAMP
+            a = hide ? 0 : 255;
+#endif
+            NtUserSetLayeredWindowAttributes( hwnd, old_key, a, LWA_ALPHA | (old_flags & LWA_COLORKEY) );
+        }
+        else animate_region( hwnd, &size, flags, pos, steps, hide );
+        UpdateWindow( hwnd );
+    }
+    elapsed = GetTickCount() - start;
+    if (elapsed < time) Sleep( time - elapsed );
+
+    if (hide) NtUserShowWindow( hwnd, SW_HIDE );
+    if (blend)
+    {
+        if (was_layered)
+            NtUserSetLayeredWindowAttributes( hwnd, old_key, old_alpha, old_flags );
+        else
+            SetWindowLongW( hwnd, GWL_EXSTYLE, GetWindowLongW( hwnd, GWL_EXSTYLE ) & ~WS_EX_LAYERED );
+    }
+    else NtUserSetWindowRgn( hwnd, 0, TRUE );
     return TRUE;
 }
 
