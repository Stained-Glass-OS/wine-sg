From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 14:56:38 -0700
Subject: [PATCH] coremessaging: GetIids of the DispatcherQueue objects,
 factory class name

- GetIids returns the interfaces of the async action, deferral, shutdown arguments, dispatcher queue, timer,
  controller and the statics (they all returned E_NOTIMPL)
- the statics' GetRuntimeClassName answers, ActivateInstance fails quietly (static classes)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/coremessaging/main.c b/dlls/coremessaging/main.c
index 9d32a81..e5d4871 100644
--- a/dlls/coremessaging/main.c
+++ b/dlls/coremessaging/main.c
@@ -50,6 +50,18 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(messaging);
 
+static HRESULT return_iids( ULONG *count, IID **iids, const IID *const *list, ULONG n )
+{
+    IID *copy;
+    ULONG i;
+
+    if (!(copy = CoTaskMemAlloc( n * sizeof(*copy) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) copy[i] = *list[i];
+    *count = n;
+    *iids = copy;
+    return S_OK;
+}
+
 #define WM_QUEUE_DISPATCH  (WM_USER + 1)
 #define WM_QUEUE_TIMER     (WM_USER + 2)   /* wparam: 1 start, 0 stop; lparam: the timer */
 #define WM_QUEUE_SHUTDOWN  (WM_USER + 3)   /* lparam: the async action */
@@ -189,7 +201,8 @@ static ULONG WINAPI async_action_Release( IAsyncAction *iface )
 
 static HRESULT WINAPI async_action_GetIids( IAsyncAction *iface, ULONG *count, IID **iids )
 {
-    return E_NOTIMPL;
+    static const IID *const iids_list[] = { &IID_IAsyncAction, &IID_IAsyncInfo };
+    return return_iids( count, iids, iids_list, ARRAY_SIZE(iids_list) );
 }
 
 static HRESULT WINAPI async_action_GetRuntimeClassName( IAsyncAction *iface, HSTRING *name )
@@ -278,7 +291,8 @@ static ULONG WINAPI async_info_Release( IAsyncInfo *iface )
 
 static HRESULT WINAPI async_info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )
