From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: DrawThemeParentBackgroundEx

DrawThemeParentBackgroundEx has the parent paint the area behind a child (WM_ERASEBKGND, then WM_PRINTCLIENT). With DTPB_USEERASEBKGND a parent that erased is enough; with DTPB_USECTLCOLORSTATIC the area is otherwise filled with the parent's WM_CTLCOLORSTATIC brush, or COLOR_BTNFACE; with neither, S_OK means the parent handled WM_PRINTCLIENT. DTPB_WINDOWDC takes hdc as the child's window DC. It was not exported. uxtheme.h gains it and the DTPB_ flags.
---
--- a/include/uxtheme.h
+++ b/include/uxtheme.h
@@ -55,6 +55,10 @@
 THEMEAPI DrawThemeEdge(HTHEME,HDC,int,int,const RECT*,UINT,UINT, RECT*);
 THEMEAPI DrawThemeIcon(HTHEME,HDC,int,int,const RECT*,HIMAGELIST,int);
 THEMEAPI DrawThemeParentBackground(HWND,HDC,RECT*);
+#define DTPB_WINDOWDC           0x00000001
+#define DTPB_USECTLCOLORSTATIC  0x00000002
+#define DTPB_USEERASEBKGND      0x00000004
+THEMEAPI DrawThemeParentBackgroundEx(HWND,HDC,DWORD,const RECT*);
 THEMEAPI DrawThemeText(HTHEME,HDC,int,int,LPCWSTR,int,DWORD,DWORD, const RECT*);
 
 #define DTT_GRAYED      0x1
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -142,6 +142,82 @@
 }
 
 
+#ifndef SG_MUTANT_NO_PARENT_BG_EX
+/***********************************************************************
+ *      DrawThemeParentBackgroundEx                         (UXTHEME.@)
+ *
+ * (wine-sg 8269) The parent's WM_ERASEBKGND and WM_PRINTCLIENT paint the area behind the child. With
+ * DTPB_USEERASEBKGND a parent that erased is enough; with DTPB_USECTLCOLORSTATIC the area is otherwise filled
+ * with the parent's WM_CTLCOLORSTATIC brush (COLOR_BTNFACE without one); with neither, S_OK means the parent
+ * handled WM_PRINTCLIENT. DTPB_WINDOWDC: hdc is the child's window DC, not its client DC.
+ */
+HRESULT WINAPI DrawThemeParentBackgroundEx(HWND hwnd, HDC hdc, DWORD flags, const RECT *prc)
+{
+    RECT area, child;
+    POINT org, at;
+    HWND parent;
+    HRGN clip = NULL;
+    int has_clip = -1;
+    BOOL erased, printed;
+    HRESULT hr = S_FALSE;
+
+    TRACE("(%p, %p, %#lx, %s)\n", hwnd, hdc, flags, wine_dbgstr_rect(prc));
+
+    if (!(parent = GetParent(hwnd))) parent = hwnd;
+    /* where the DC's origin is in the parent's client coordinates */
+    if (flags & DTPB_WINDOWDC)
+    {
+        GetWindowRect(hwnd, &child);
+        at.x = child.left; at.y = child.top;
+        ScreenToClient(parent, &at);
+        OffsetRect(&child, -child.left, -child.top);
+    }
+    else
+    {
+        at.x = at.y = 0;
+        MapWindowPoints(hwnd, parent, &at, 1);
+        GetClientRect(hwnd, &child);
+    }
+    area = prc ? *prc : child;
+    if (prc)
+    {
+        clip = CreateRectRgn(0, 0, 1, 1);
+        has_clip = GetClipRgn(hdc, clip);
+        if (has_clip != -1) IntersectClipRect(hdc, prc->left, prc->top, prc->right, prc->bottom);
+    }
+
+    OffsetViewportOrgEx(hdc, -at.x, -at.y, &org);
+    erased = SendMessageW(parent, WM_ERASEBKGND, (WPARAM)hdc, 0) != 0;
+    printed = SendMessageW(parent, WM_PRINTCLIENT, (WPARAM)hdc, PRF_CLIENT) != 0;
+    SetViewportOrgEx(hdc, org.x, org.y, NULL);
+
+    if ((flags & DTPB_USEERASEBKGND) && erased)
+        hr = S_OK;
+    else if (flags & DTPB_USECTLCOLORSTATIC)
+    {
+        HBRUSH brush = (HBRUSH)SendMessageW(parent, WM_CTLCOLORSTATIC, (WPARAM)hdc, (LPARAM)hwnd);
+
+        FillRect(hdc, &area, brush ? brush : GetSysColorBrush(COLOR_BTNFACE));
+        hr = S_OK;
+    }
+    else if (printed)
+        hr = S_OK;
+
+    if (prc)
+    {
+        if (has_clip == 0) SelectClipRgn(hdc, NULL);
+        else if (has_clip == 1) SelectClipRgn(hdc, clip);
+        DeleteObject(clip);
+    }
+    return hr;
+}
+#else
+HRESULT WINAPI DrawThemeParentBackgroundEx(HWND hwnd, HDC hdc, DWORD flags, const RECT *prc)
+{
+    return E_NOTIMPL;
+}
+#endif
+
 /***********************************************************************
  *      DrawThemeBackground                                 (UXTHEME.@)
  */
--- a/dlls/uxtheme/uxtheme.spec
+++ b/dlls/uxtheme/uxtheme.spec
@@ -66,6 +66,7 @@
 @ stdcall DrawThemeEdge(ptr ptr long long ptr long long ptr)
 @ stdcall DrawThemeIcon(ptr ptr long long ptr ptr long)
 @ stdcall DrawThemeParentBackground(ptr ptr ptr)
+@ stdcall DrawThemeParentBackgroundEx(ptr ptr long ptr)
 @ stdcall DrawThemeText(ptr ptr long long wstr long long long ptr)
 @ stdcall DrawThemeTextEx(ptr ptr long long wstr long long ptr ptr)
 @ stdcall EnableThemeDialogTexture(ptr long)
