From: Stained Glass OS contributors
Subject: explorer: after a resolution change the taskbar is on the new screen, icons by the clock

Display settings in a VM (David: stuck at 1024x768) now changes the
resolution, and Wine's desktop follows; then the taskbar disappeared:
WM_DISPLAYCHANGE hid the tray whenever show_systray was false -- the
stand-alone tray's flag, false in the shell -- instead of placing the shell's
taskbar (enable_taskbar) on the new screen. And the notification icons were
placed only when added, so they stayed where the old bar ended; the bar's
placement now puts them before the clock (after a new edge too).

--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -2084,6 +2084,19 @@
         tray_height = sg_bar_rect.bottom - sg_bar_rect.top;
         if (!sg_bar.autohide) sg_hidden = FALSE;
         sg_place_bar();
+        /* the notification icons sit before the clock: where that is now (a
+         * new resolution, a new edge -- they stayed where the old bar ended) */
+        {
+            struct icon *icon;
+            LIST_FOR_EACH_ENTRY( icon, &icon_list, struct icon, entry )
+            {
+                POINT pos;
+                if (icon->display == ICON_DISPLAY_HIDDEN) continue;
+                pos = get_icon_pos( icon );
+                SetWindowPos( icon->window, 0, pos.x, pos.y, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER );
+                update_tooltip_position( icon );
+            }
+        }
         /* reserve the bar's space, as Windows' taskbar does, so maximized and
          * snapped windows stay clear of it -- nothing when it hides itself --
          * together with the appbars' (appbar.c) */
@@ -2195,8 +2208,12 @@
         break;
 
     case WM_DISPLAYCHANGE:
-        if (!show_systray) do_hide_systray();
-        else if (!nb_displayed && !enable_taskbar) do_hide_systray();
+        /* Stained Glass OS: the shell's taskbar (enable_taskbar; show_systray
+         * is only the standalone tray) takes its place on the new screen --
+         * it was hidden at every resolution change */
+        if (enable_taskbar) do_show_systray();
+        else if (!show_systray) do_hide_systray();
+        else if (!nb_displayed) do_hide_systray();
         else do_show_systray();
         break;
 
