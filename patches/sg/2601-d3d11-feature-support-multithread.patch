From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3d11: CheckFeatureSupport long tail, shared multithread-protected flag

- ID3D11Device::CheckFeatureSupport answered E_NOTIMPL for FORMAT_SUPPORT2,
  D3D9_SHADOW_SUPPORT, SHADER_MIN_PRECISION_SUPPORT,
  D3D9_SIMPLE_INSTANCING_SUPPORT, MARKER_SUPPORT, D3D9_OPTIONS1,
  GPU_VIRTUAL_ADDRESS_SUPPORT, SHADER_CACHE, D3D11_OPTIONS4 and OPTIONS5.
  Each now validates the buffer size (E_INVALIDARG) and reports what the
  device really has: shadow sampling, simple instancing and non-pow2
  textures supported; typed UAV/tiled extras, min-precision, markers, the
  shader cache and shared-resource tiers reported as none.
- ID3D10Multithread and ID3D11Multithread kept no state (Set returned TRUE,
  Get returned TRUE). They now share one per-device flag, FALSE until
  turned on as on Windows, and Set returns the previous value. The
  todo_wine of the ID3D11Multithread default in tests/d3d11.c is removed.

Gate: test/d3d11featx-gate.sh (test/d3d11featx-probe.c).
Mutants SG_MUTANT_D3D9_SHADOW_ALWAYS_FALSE, SG_MUTANT_MT_PROTECTED_ALWAYS_TRUE
(d3d11/device.c).
---
--- a/dlls/d3d11/d3d11_private.h
+++ b/dlls/d3d11/d3d11_private.h
@@ -580,6 +580,7 @@ struct d3d_device
     LONG refcount;
 
     BOOL d3d11_only;
+    BOOL multithread_protected;
 
     struct d3d_device_context_state *state;
     struct d3d11_device_context immediate_context;
--- a/dlls/d3d11/device.c
+++ b/dlls/d3d11/device.c
@@ -3837,16 +3837,33 @@ static void STDMETHODCALLTYPE d3d11_multithread_Leave(ID3D11Multithread *iface)
 static BOOL STDMETHODCALLTYPE d3d11_multithread_SetMultithreadProtected(
         ID3D11Multithread *iface, BOOL enable)
 {
-    FIXME("iface %p, enable %#x stub!\n", iface, enable);
+    struct d3d11_device_context *context = impl_from_ID3D11Multithread(iface);
+    struct d3d_device *device = context->device;
+    BOOL prev;
 
-    return TRUE;
+    TRACE("iface %p, enable %#x.\n", iface, enable);
+
+    wined3d_mutex_lock();
+    prev = device->multithread_protected;
+    device->multithread_protected = !!enable;
+    wined3d_mutex_unlock();
+
+    return prev;
 }
 
 static BOOL STDMETHODCALLTYPE d3d11_multithread_GetMultithreadProtected(ID3D11Multithread *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3d11_device_context *context = impl_from_ID3D11Multithread(iface);
+    struct d3d_device *device = context->device;
+    BOOL ret;
 
-    return TRUE;
+    TRACE("iface %p.\n", iface);
+
+    wined3d_mutex_lock();
+    ret = device->multithread_protected;
+    wined3d_mutex_unlock();
+
+    return ret;
 }
 
 static const struct ID3D11MultithreadVtbl d3d11_multithread_vtbl =
@@ -4999,6 +5016,158 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device2
             return d3d11_device_CheckFormatSupport(iface, data->InFormat, &data->OutFormatSupport);
         }
 
+        case D3D11_FEATURE_FORMAT_SUPPORT2:
+        {
+            D3D11_FEATURE_DATA_FORMAT_SUPPORT2 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid size %u for D3D11_FEATURE_FORMAT_SUPPORT2.\n", feature_support_data_size);
+                return E_INVALIDARG;
+            }
+
+            /* None of the extended (typed UAV load/store, tiled, MinMax
+             * filter) operations advertised by this query are implemented,
+             * for any format. */
+            data->OutFormatSupport2 = 0;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D9_SHADOW_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_D3D9_SHADOW_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* Every feature level 10_0+ device supports sampling a depth
+             * texture with a comparison filter. */
+#ifdef SG_MUTANT_D3D9_SHADOW_ALWAYS_FALSE
+            data->SupportsDepthAsTextureWithLessEqualComparisonFilter = FALSE;
+#else
+            data->SupportsDepthAsTextureWithLessEqualComparisonFilter = TRUE;
+#endif
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_SHADER_MIN_PRECISION_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_SHADER_MIN_PRECISION_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* Reduced shader precision is not implemented; shaders always
+             * run at full precision. */
+            data->PixelShaderMinPrecision = 0;
+            data->AllOtherShaderStagesMinPrecision = 0;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D9_SIMPLE_INSTANCING_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_D3D9_SIMPLE_INSTANCING_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->SimpleInstancingSupported = TRUE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_MARKER_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_MARKER_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* ID3D11DeviceContext2::IsAnnotationEnabled-level profiling
+             * markers are not implemented. */
+            data->Profile = FALSE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D9_OPTIONS1:
+        {
+            D3D11_FEATURE_DATA_D3D9_OPTIONS1 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->FullNonPow2TextureSupported = TRUE;
+            data->DepthAsTextureWithLessEqualComparisonFilterSupported = TRUE;
+            data->SimpleInstancingSupported = TRUE;
+            data->TextureCubeFaceRenderTargetWithNonCubeDepthStencilSupported = TRUE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_GPU_VIRTUAL_ADDRESS_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_GPU_VIRTUAL_ADDRESS_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* Typical values reported by current hardware/drivers; this
+             * query is informative and Wine does not expose GPU virtual
+             * addresses to applications. */
+            data->MaxGPUVirtualAddressBitsPerResource = 34;
+            data->MaxGPUVirtualAddressBitsPerProcess = 40;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_SHADER_CACHE:
+        {
+            D3D11_FEATURE_DATA_SHADER_CACHE *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* Shader bytecode is not cached across runs. */
+            data->SupportFlags = D3D11_SHADER_CACHE_SUPPORT_NONE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D11_OPTIONS4:
+        {
+            D3D11_FEATURE_DATA_D3D11_OPTIONS4 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->ExtendedNV12SharedTextureSupported = FALSE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D11_OPTIONS5:
+        {
+            D3D11_FEATURE_DATA_D3D11_OPTIONS5 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->SharedResourceTier = D3D11_SHARED_RESOURCE_TIER_0;
+            return S_OK;
+        }
+
         default:
             FIXME("Unhandled feature %#x.\n", feature);
             return E_NOTIMPL;
@@ -7668,16 +7837,35 @@ static void STDMETHODCALLTYPE d3d10_multithread_Leave(ID3D10Multithread *iface)
 
 static BOOL STDMETHODCALLTYPE d3d10_multithread_SetMultithreadProtected(ID3D10Multithread *iface, BOOL enable)
 {
-    FIXME("iface %p, enable %#x stub!\n", iface, enable);
+    struct d3d_device *device = impl_from_ID3D10Multithread(iface);
+    BOOL prev;
+
+    TRACE("iface %p, enable %#x.\n", iface, enable);
 
+    wined3d_mutex_lock();
+    prev = device->multithread_protected;
+    device->multithread_protected = !!enable;
+    wined3d_mutex_unlock();
+
+#ifdef SG_MUTANT_MT_PROTECTED_ALWAYS_TRUE
     return TRUE;
+#else
+    return prev;
+#endif
 }
 
 static BOOL STDMETHODCALLTYPE d3d10_multithread_GetMultithreadProtected(ID3D10Multithread *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3d_device *device = impl_from_ID3D10Multithread(iface);
+    BOOL ret;
 
-    return TRUE;
+    TRACE("iface %p.\n", iface);
+
+    wined3d_mutex_lock();
+    ret = device->multithread_protected;
+    wined3d_mutex_unlock();
+
+    return ret;
 }
 
 static const struct ID3D10MultithreadVtbl d3d10_multithread_vtbl =
@@ -8134,6 +8322,9 @@ void d3d_device_init(struct d3d_device *device, void *outer_unknown)
     /* COM aggregation always takes place */
     device->outer_unk = outer_unknown;
     device->d3d11_only = FALSE;
+    /* ID3D10Multithread and ID3D11Multithread share one flag, which reads
+     * FALSE until the application turns protection on. */
+    device->multithread_protected = FALSE;
     device->state = NULL;
 
     d3d11_device_context_init(&device->immediate_context, device, D3D11_DEVICE_CONTEXT_IMMEDIATE);
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -2393,7 +2393,7 @@ static void test_immediate_context(void)
     ok(refcount == expected_refcount, "Got refcount %lu, expected %lu.\n", refcount, expected_refcount);
 
     enabled = ID3D11Multithread_GetMultithreadProtected(multithread);
-    todo_wine ok(!enabled, "Multithread protection is %#x.\n", enabled);
+    ok(!enabled, "Multithread protection is %#x.\n", enabled);
 
     ID3D11Multithread_Release(multithread);
 
