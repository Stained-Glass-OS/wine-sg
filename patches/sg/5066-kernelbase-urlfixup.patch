From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Correct a mistyped scheme in UrlFixupW.

UrlFixupW corrects a URL whose scheme is mistyped, as documented: a known
scheme is kept, a near one (at most two edits, same first letter, one of the
typed length first) replaces it, and the schemes that name a host get "//"
before it ("http:www.x", "htps:\\www.x" -> "http://www.x", "mail:" ->
"mailto:"). A URL it cannot recognise ("abc:def", no scheme, a drive letter)
is handed back unchanged with S_FALSE. It copied the URL and returned S_OK.

Gate: test/kernelbase-urlfixup-gate.sh.
---
 dlls/kernelbase/path.c | 103 ++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 97 insertions(+), 6 deletions(-)

diff --git a/dlls/kernelbase/path.c b/dlls/kernelbase/path.c
index cc84e69..c2eb1b9 100644
--- a/dlls/kernelbase/path.c
+++ b/dlls/kernelbase/path.c
@@ -4430,21 +4430,112 @@ INT WINAPI UrlCompareW(const WCHAR *url1, const WCHAR *url2, BOOL ignore_slash)
     return -1;
 }
 
+/* the edit distance between two short scheme names, ignoring case */
+static unsigned int scheme_distance(const WCHAR *a, unsigned int len_a, const WCHAR *b, unsigned int len_b)
+{
+    unsigned int row[INTERNET_MAX_SCHEME_LENGTH + 1], i, j, diag, up;
+
+    if (len_b > INTERNET_MAX_SCHEME_LENGTH) return ~0u;
+    for (j = 0; j <= len_b; j++) row[j] = j;
+    for (i = 1; i <= len_a; i++)
+    {
+        diag = row[0];
+        row[0] = i;
+        for (j = 1; j <= len_b; j++)
+        {
+            up = row[j];
+            row[j] = min(min(row[j] + 1, row[j - 1] + 1), diag + (towlower(a[i - 1]) != towlower(b[j - 1])));
+            diag = up;
+        }
+    }
+    return row[len_b];
+}
+
+/* the schemes whose URLs name a host after "//" */
+static BOOL scheme_has_host(DWORD scheme)
+{
+    switch (scheme)
+    {
+    case URL_SCHEME_FTP:
+    case URL_SCHEME_HTTP:
+    case URL_SCHEME_HTTPS:
+    case URL_SCHEME_GOPHER:
+    case URL_SCHEME_TELNET:
+    case URL_SCHEME_WAIS:
+        return TRUE;
+    }
+    return FALSE;
+}
+
 HRESULT WINAPI UrlFixupW(const WCHAR *url, WCHAR *translatedUrl, DWORD maxChars)
 {
-    DWORD srcLen;
+    WCHAR *out;
+    const WCHAR *colon, *rest, *name = NULL;
+    unsigned int len, best = ~0u, i, d;
+    DWORD scheme = URL_SCHEME_INVALID;
+    HRESULT hr = S_OK;
 
-    FIXME("%s, %p, %ld stub\n", wine_dbgstr_w(url), translatedUrl, maxChars);
+    TRACE("%s, %p, %ld\n", wine_dbgstr_w(url), translatedUrl, maxChars);
 
     if (!url)
         return E_FAIL;
+    if (!translatedUrl || !maxChars)
+        return E_INVALIDARG;
 
-    srcLen = lstrlenW(url) + 1;
+    colon = wcschr(url, ':');
+    len = colon ? colon - url : 0;
+    /* one letter is a drive, not a scheme */
+    if (len > 1 && len <= INTERNET_MAX_SCHEME_LENGTH)
+    {
+        if ((scheme = get_scheme_code(url, len)) == URL_SCHEME_UNKNOWN)
+        {
+            /* the nearest scheme starting with the same letter ("htp" is http, not ftp), one
+             * of the typed length first ("htps" is http, as documented), then the one the
+             * URL_SCHEME list has first; two edits at most */
+            for (i = 0; i < ARRAY_SIZE(url_schemes); i++)
+            {
+                unsigned int name_len = lstrlenW(url_schemes[i].scheme_name);
+
+                if (towlower(url_schemes[i].scheme_name[0]) != towlower(url[0])) continue;
+                d = scheme_distance(url, len, url_schemes[i].scheme_name, name_len);
+#ifndef SG_MUTANT_FIXUP_ANY_DISTANCE
+                if (d > 2) continue;
+#endif
+                d = d + (name_len != len ? 0x100 : 0);
+                if (d < best)
+                {
+                    best = d;
+                    name = url_schemes[i].scheme_name;
+                    scheme = url_schemes[i].scheme_number;
+                }
+            }
+        }
+    }
+    if (scheme == URL_SCHEME_UNKNOWN || scheme == URL_SCHEME_INVALID)
+    {
+        /* not recognised well enough to correct: hand the URL back as it is */
+        if (translatedUrl != url) lstrcpynW(translatedUrl, url, maxChars);
+        return S_FALSE;
+    }
 
-    /* For now just copy the URL directly */
-    lstrcpynW(translatedUrl, url, (maxChars < srcLen) ? maxChars : srcLen);
+    if (!(out = heap_alloc((lstrlenW(url) + INTERNET_MAX_SCHEME_LENGTH + 4) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    if (name) lstrcpyW(out, name);
+    else lstrcpynW(out, url, len + 1);
+    lstrcatW(out, L":");
+    rest = colon + 1;
+    if (scheme_has_host(scheme))
+    {
+        /* "http:host", "http:\\\\host" and "http:/host" all name a host */
+        while (*rest == '/' || *rest == '\\') rest++;
+        lstrcatW(out, L"//");
+    }
+    lstrcatW(out, rest);
 
-    return S_OK;
+    if (lstrlenW(out) >= maxChars) hr = E_POINTER;
+    else lstrcpyW(translatedUrl, out);
+    heap_free(out);
+    return hr;
 }
 
 const char * WINAPI UrlGetLocationA(const char *url)
