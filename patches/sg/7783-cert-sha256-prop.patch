From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CERT_SHA256_HASH_PROP_ID, a certificate's SHA-256 thumbprint

Windows computes a certificate's SHA-256 thumbprint on demand as the
CERT_SHA256_HASH_PROP_ID property, as it does the SHA-1 one. crypt32 did
not know the property and gave CRYPT_E_NOT_FOUND. Paint.NET 5.2's setup
reads it from its signer after WinVerifyTrust, so it said "Setup cannot
continue because its files have been modified or are damaged" and exited
with 0x80092004. It now installs.
---
diff --git a/dlls/crypt32/cert.c b/dlls/crypt32/cert.c
index c4580ae..669e24d 100644
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -549,6 +549,15 @@ static BOOL CertContext_GetProperty(cert_t *cert, DWORD dwPropId,
              cert->ctx.pbCertEncoded, cert->ctx.cbCertEncoded, pvData,
              pcbData);
             break;
+#ifndef SG_MUTANT_NO_SHA256_PROP
+        case CERT_SHA256_HASH_PROP_ID:
+            /* computed on demand like the SHA-1 thumbprint; installers pin
+             * their signer by it (Paint.NET's SetupFrontEnd) */
+            ret = CertContext_GetHashProp(cert, dwPropId, CALG_SHA_256,
+             cert->ctx.pbCertEncoded, cert->ctx.cbCertEncoded, pvData,
+             pcbData);
+            break;
+#endif
         case CERT_SUBJECT_NAME_MD5_HASH_PROP_ID:
             ret = CertContext_GetHashProp(cert, dwPropId, CALG_MD5,
              cert->ctx.pCertInfo->Subject.pbData,
@@ -955,6 +964,7 @@ static BOOL CertContext_SetProperty(cert_t *cert, DWORD dwPropId,
         case CERT_HASH_PROP_ID:
         case CERT_KEY_IDENTIFIER_PROP_ID:
         case CERT_MD5_HASH_PROP_ID:
+        case CERT_SHA256_HASH_PROP_ID:
         case CERT_NEXT_UPDATE_LOCATION_PROP_ID:
         case CERT_PUBKEY_ALG_PARA_PROP_ID:
         case CERT_PVK_FILE_PROP_ID:
diff --git a/include/wincrypt.h b/include/wincrypt.h
index 5b36fa7..89e1e2e 100644
--- a/include/wincrypt.h
+++ b/include/wincrypt.h
@@ -2615,6 +2615,7 @@ typedef struct _CERT_CHAIN_FIND_BY_ISSUER_PARA {
 #define CERT_CA_DISABLE_CRL_PROP_ID                82
 #define CERT_ROOT_PROGRAM_CERT_POLICIES_PROP_ID    83
 #define CERT_ROOT_PROGRAM_NAME_CONSTRAINTS_PROP_ID 84
+#define CERT_SHA256_HASH_PROP_ID                   107
 
 #define CERT_FIRST_RESERVED_PROP_ID                85
 #define CERT_LAST_RESERVED_PROP_ID                 0x00007fff
