+/*
+ * IAccPropServices: a process-wide table of MSAA property overrides, keyed
+ * by an opaque "identity string" that names either an hwnd+idObject+idChild
+ * accessible or an hmenu+idChild one. An app (or AT bridge) calls the Set*
+ * methods to annotate a property with either a fixed VARIANT value or an
+ * IAccPropServer callback that is asked for the value each time; Clear*
+ * removes those annotations again. The identity string's byte layout is
+ * never documented by Microsoft and no caller is meant to parse it -- it is
+ * only round-tripped through the Compose.../Decompose... methods, so any
+ * internally consistent format is correct.
+ *
+ * Nothing in Wine yet reads this table back when answering an IAccessible
+ * property query (that plumbing lives in whatever provides the window's
+ * MSAA object -- comctl32, user32's default object, or the app itself), so
+ * for now this is a correctly-behaved store with no consumer. That matches
+ * real Windows closely enough for apps that only *set* annotations defensively
+ * and do not depend on them taking visible effect under Wine.
+ */
+
 #define COBJMACROS
 
 #include <stdarg.h>
 
 #include "oleacc_private.h"
-
+#include "wine/list.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(oleacc);
 
+/* Kinds of identity string this module hands out. */
+enum accprop_id_kind
+{
+    ACCPROP_ID_HWND = 1,
+    ACCPROP_ID_HMENU = 2,
+};
+
+struct accprop_hwnd_id
+{
+    DWORD kind;
+    HWND hwnd;
+    DWORD idObject;
+    DWORD idChild;
+};
+
+struct accprop_hmenu_id
+{
+    DWORD kind;
+    HMENU hmenu;
+    DWORD idChild;
+};
+
+/* Identity strings are compared with memcmp, so padding must be zeroed. */
+static void hwnd_id_init(struct accprop_hwnd_id *id, HWND hwnd, DWORD idObject, DWORD idChild)
+{
+    memset(id, 0, sizeof(*id));
+    id->kind = ACCPROP_ID_HWND;
+    id->hwnd = hwnd;
+    id->idObject = idObject;
+    id->idChild = idChild;
+}
+
+static void hmenu_id_init(struct accprop_hmenu_id *id, HMENU hmenu, DWORD idChild)
+{
+    memset(id, 0, sizeof(*id));
+    id->kind = ACCPROP_ID_HMENU;
+    id->hmenu = hmenu;
+    id->idChild = idChild;
+}
+
+struct accprop_entry
+{
+    struct list entry;
+    BYTE *id;
+    DWORD id_len;
+    MSAAPROPID prop;
+    VARIANT var;            /* VT_EMPTY when server is set instead */
+    IAccPropServer *server;
+};
+
+static struct list accprop_entries = LIST_INIT(accprop_entries);
+static CRITICAL_SECTION accprop_cs;
+static CRITICAL_SECTION_DEBUG accprop_cs_debug =
+{
+    0, 0, &accprop_cs,
+    { &accprop_cs_debug.ProcessLocksList, &accprop_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": accprop_cs") }
+};
+static CRITICAL_SECTION accprop_cs = { &accprop_cs_debug, -1, 0, 0, 0, 0 };
+
+static void accprop_entry_destroy(struct accprop_entry *entry)
+{
+    list_remove(&entry->entry);
+    if (entry->server)
+        IAccPropServer_Release(entry->server);
+    else
+        VariantClear(&entry->var);
+    free(entry->id);
+    free(entry);
+}
+
+static BOOL accprop_id_equal(const BYTE *id1, DWORD len1, const BYTE *id2, DWORD len2)
+{
+    return len1 == len2 && !memcmp(id1, id2, len1);
+}
+
+/* Remove every stored entry for "id" whose property is in props[0..cProps),
+ * or every entry for "id" at all when cProps is 0 (ClearProps's documented
+ * meaning of an empty property list is "clear nothing", but SG_MUTANT below
+ * shows why that distinction matters for this store's cleanup path). */
+static HRESULT accprop_clear(const BYTE *id, DWORD id_len, const MSAAPROPID *props, int cProps)
+{
+    struct accprop_entry *entry, *next;
+    int i;
+
+    EnterCriticalSection(&accprop_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &accprop_entries, struct accprop_entry, entry)
+    {
+        if (!accprop_id_equal(entry->id, entry->id_len, id, id_len))
+            continue;
+        for (i = 0; i < cProps; i++)
+        {
+            if (IsEqualGUID(&entry->prop, &props[i]))
+            {
+                accprop_entry_destroy(entry);
+                break;
+            }
+        }
+    }
+    LeaveCriticalSection(&accprop_cs);
+    return S_OK;
+}
+
+/* Store a value or a server for "id"/"prop", replacing (and releasing) any
+ * existing entry for the same identity and property. */
+static HRESULT accprop_set(const BYTE *id, DWORD id_len, MSAAPROPID prop,
+        const VARIANT *var, IAccPropServer *server)
+{
+    struct accprop_entry *entry;
+    BYTE *id_copy;
+    HRESULT hr;
+
+    if (!(id_copy = malloc(id_len)))
+        return E_OUTOFMEMORY;
+    memcpy(id_copy, id, id_len);
+
+    if (!(entry = calloc(1, sizeof(*entry))))
+    {
+        free(id_copy);
+        return E_OUTOFMEMORY;
+    }
+    entry->id = id_copy;
+    entry->id_len = id_len;
+    entry->prop = prop;
+    VariantInit(&entry->var);
+    if (server)
+    {
+        IAccPropServer_AddRef(server);
+        entry->server = server;
+    }
+    else if (var)
+    {
+        if (FAILED(hr = VariantCopy(&entry->var, var)))
+        {
+            free(entry->id);
+            free(entry);
+            return hr;
+        }
+    }
+
+    EnterCriticalSection(&accprop_cs);
+#ifndef SG_MUTANT_ACCPROP_NO_RELEASE_OLD
+    accprop_clear(id, id_len, &prop, 1);
+#endif
+    list_add_tail(&accprop_entries, &entry->entry);
+    LeaveCriticalSection(&accprop_cs);
+    return S_OK;
+}
+
