From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3d11: keep a texture's minimum LOD

ID3D11DeviceContext::SetResourceMinLOD stores the value with the 1D, 2D or 3D texture and GetResourceMinLOD returns it (a buffer has none); GetResourceMinLOD always gave 0. Sampling is not clamped to it yet: the most detailed mip levels stay in use.
---
--- a/dlls/d3d11/d3d11_private.h
+++ b/dlls/d3d11/d3d11_private.h
@@ -126,6 +126,7 @@
     IUnknown *dxgi_resource;
     struct wined3d_texture *wined3d_texture;
     D3D11_TEXTURE1D_DESC desc;
+    float min_lod; /* SetResourceMinLOD (wine-sg 8248) */
     ID3D11Device2 *device;
 };
 
@@ -203,6 +204,7 @@
     struct wined3d_texture *wined3d_texture;
     struct wined3d_swapchain *swapchain;
     D3D11_TEXTURE2D_DESC desc;
+    float min_lod; /* SetResourceMinLOD (wine-sg 8248) */
     ID3D11Device2 *device;
 
     IDXGIKeyedMutex IDXGIKeyedMutex_iface;
@@ -235,6 +237,7 @@
     IUnknown *dxgi_resource;
     struct wined3d_texture *wined3d_texture;
     D3D11_TEXTURE3D_DESC desc;
+    float min_lod; /* SetResourceMinLOD (wine-sg 8248) */
     ID3D11Device2 *device;
 };
 
--- a/dlls/d3d11/device.c
+++ b/dlls/d3d11/device.c
@@ -1490,18 +1490,59 @@
     wined3d_device_context_generate_mipmaps(context->wined3d_context, srv->wined3d_view);
 }
 
+#ifndef SG_MUTANT_NO_MINLOD
+/* (wine-sg 8248) A texture's minimum LOD is kept with it and read back; sampling does not clamp to it yet
+ * (the most detailed mip levels stay in use, which a streaming engine's hint allows). Buffers have none. */
+static float *d3d11_resource_min_lod(ID3D11Resource *resource)
+{
+    D3D11_RESOURCE_DIMENSION dimension;
+    struct d3d_texture1d *texture1d;
+    struct d3d_texture2d *texture2d;
+    struct d3d_texture3d *texture3d;
+
+    if (!resource) return NULL;
+    ID3D11Resource_GetType(resource, &dimension);
+    switch (dimension)
+    {
+        case D3D11_RESOURCE_DIMENSION_TEXTURE1D:
+            return (texture1d = unsafe_impl_from_ID3D11Texture1D((ID3D11Texture1D *)resource)) ? &texture1d->min_lod : NULL;
+        case D3D11_RESOURCE_DIMENSION_TEXTURE2D:
+            return (texture2d = unsafe_impl_from_ID3D11Texture2D((ID3D11Texture2D *)resource)) ? &texture2d->min_lod : NULL;
+        case D3D11_RESOURCE_DIMENSION_TEXTURE3D:
+            return (texture3d = unsafe_impl_from_ID3D11Texture3D((ID3D11Texture3D *)resource)) ? &texture3d->min_lod : NULL;
+        default:
+            return NULL;
+    }
+}
+#endif
+
 static void STDMETHODCALLTYPE d3d11_device_context_SetResourceMinLOD(ID3D11DeviceContext1 *iface,
         ID3D11Resource *resource, FLOAT min_lod)
 {
+#ifndef SG_MUTANT_NO_MINLOD
+    float *lod;
+
+    TRACE("iface %p, resource %p, min_lod %f.\n", iface, resource, min_lod);
+
+    if ((lod = d3d11_resource_min_lod(resource))) *lod = min_lod;
+#else
     FIXME("iface %p, resource %p, min_lod %f stub!\n", iface, resource, min_lod);
+#endif
 }
 
 static FLOAT STDMETHODCALLTYPE d3d11_device_context_GetResourceMinLOD(ID3D11DeviceContext1 *iface,
         ID3D11Resource *resource)
 {
-    FIXME("iface %p, resource %p stub!\n", iface, resource);
+#ifndef SG_MUTANT_NO_MINLOD
+    float *lod;
 
+    TRACE("iface %p, resource %p.\n", iface, resource);
+
+    return (lod = d3d11_resource_min_lod(resource)) ? *lod : 0.0f;
+#else
+    FIXME("iface %p, resource %p stub!\n", iface, resource);
     return 0.0f;
+#endif
 }
 
 static void STDMETHODCALLTYPE d3d11_device_context_ResolveSubresource(ID3D11DeviceContext1 *iface,
