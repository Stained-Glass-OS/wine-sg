From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 03:10:26 -0800
Subject: [PATCH] comdlg32: the Page Setup dialog in Windows' words (9820)

The Page Setup dialog (PageSetupDlg: Notepad, WordPad, most programs' File >
Page Setup) was captioned "Setup Page" and its margins "Margins [inches]" /
"Margins [mm]"; Windows says "Page Setup", "Margins (inches)" and "Margins
(millimeters)".

Gate test/pagesetup-gate.sh.

--- a/dlls/comdlg32/comdlg32.rc
+++ b/dlls/comdlg32/comdlg32.rc
@@ -80,8 +80,8 @@
 
     PD32_DEFAULT_PRINTER                  "Default Printer; "
     PD32_NR_OF_DOCUMENTS_IN_QUEUE         "There are %d documents in the queue"
-    PD32_MARGINS_IN_INCHES                "Margins [inches]"
-    PD32_MARGINS_IN_MILLIMETERS           "Margins [mm]"
+    PD32_MARGINS_IN_INCHES                "Margins (inches)"
+    PD32_MARGINS_IN_MILLIMETERS           "Margins (millimeters)"
     PD32_MILLIMETERS                      "#msgctxt#unit: millimeters#mm"
 
     PD32_PRINTER_STATUS_READY             "Ready"
@@ -468,7 +468,11 @@
 
 PAGESETUPDLGORD DIALOG 32, 32, 240, 240
 STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
+#ifndef SG_MUTANT_PSD_OLD_WORDS
+CAPTION "Page Setup"
+#else
 CAPTION "Setup Page"
+#endif
 FONT 8, "MS Shell Dlg"
 BEGIN
   CONTROL "", rct1, "Static", SS_WHITERECT, 80, 8, 80, 80
