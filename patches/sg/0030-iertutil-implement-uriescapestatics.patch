From: Stained Glass OS <dev@stained-glass.example>
Subject: iertutil: implement Windows.Foundation.Uri's IUriEscapeStatics

winget escapes the components of a search query into the source URL with
Windows.Foundation.Uri.EscapeComponent (IUriEscapeStatics). Wine's iertutil
gave the Uri activation factory only IUriRuntimeClassFactory, so
RoGetActivationFactory for IUriEscapeStatics returned E_NOINTERFACE and winget
could not build a source request -- `winget search' failed to open its source.

Implement IUriEscapeStatics on the factory: EscapeComponent percent-encodes
everything outside the RFC 3986 unreserved set (UTF-8, uppercase hex), and
UnescapeComponent reverses it. With this (and the Windows.Web.Http transport),
real winget-cli opens the Microsoft Store source and returns real search
results: `winget search python' lists the Store's Python packages with their
real product IDs.
--- a/dlls/iertutil/main.c
+++ b/dlls/iertutil/main.c
@@ -237,6 +237,7 @@
 {
     IActivationFactory IActivationFactory_iface;
     IUriRuntimeClassFactory IUriRuntimeClassFactory_iface;
+    IUriEscapeStatics IUriEscapeStatics_iface;
     LONG ref;
 };
 
@@ -267,6 +268,12 @@
         *out = &impl->IUriRuntimeClassFactory_iface;
         return S_OK;
     }
+    else if (IsEqualGUID(iid, &IID_IUriEscapeStatics))
+    {
+        IUriEscapeStatics_AddRef(&impl->IUriEscapeStatics_iface);
+        *out = &impl->IUriEscapeStatics_iface;
+        return S_OK;
+    }
 
     FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
@@ -383,10 +390,105 @@
     uri_factory_CreateWithRelativeUri,
 };
 
+
+/* IUriEscapeStatics: percent-encode / decode a URI component. */
+DEFINE_IINSPECTABLE(uri_escape_statics, IUriEscapeStatics, struct iertutil, IActivationFactory_iface)
+
+static inline int is_unreserved(WCHAR c)
+{
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
+        || c == '-' || c == '_' || c == '.' || c == '~';
+}
+
+static HRESULT STDMETHODCALLTYPE uri_escape_statics_EscapeComponent(IUriEscapeStatics *iface,
+                                                                    HSTRING to_escape, HSTRING *value)
+{
+    static const WCHAR hex[] = L"0123456789ABCDEF";
+    UINT32 len = 0;
+    const WCHAR *in = WindowsGetStringRawBuffer(to_escape, &len);
+    char utf8[4];
+    WCHAR *out;
+    UINT32 i, o = 0;
+    int b, j;
+    HRESULT hr;
+
+    TRACE("iface %p, to_escape %s, value %p.\n", iface, debugstr_hstring(to_escape), value);
+
+    /* worst case: every input WCHAR becomes up to 4 UTF-8 bytes, each "%XX". */
+    if (!(out = malloc((len * 12 + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    for (i = 0; i < len; i++)
+    {
+        if (is_unreserved(in[i]))
+        {
+            out[o++] = in[i];
+            continue;
+        }
+        b = WideCharToMultiByte(CP_UTF8, 0, &in[i], 1, utf8, sizeof(utf8), NULL, NULL);
+        for (j = 0; j < b; j++)
+        {
+            out[o++] = '%';
+            out[o++] = hex[(utf8[j] >> 4) & 0xf];
+            out[o++] = hex[utf8[j] & 0xf];
+        }
+    }
+    out[o] = 0;
+    hr = WindowsCreateString(out, o, value);
+    free(out);
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE uri_escape_statics_UnescapeComponent(IUriEscapeStatics *iface,
+                                                                      HSTRING to_unescape, HSTRING *value)
+{
+    UINT32 len = 0;
+    const WCHAR *in = WindowsGetStringRawBuffer(to_unescape, &len);
+    char *bytes;
+    WCHAR *out;
+    UINT32 i, b = 0;
+    int wlen;
+    HRESULT hr;
+
+    TRACE("iface %p, to_unescape %s, value %p.\n", iface, debugstr_hstring(to_unescape), value);
+
+    if (!(bytes = malloc(len + 1))) return E_OUTOFMEMORY;
+    for (i = 0; i < len; i++)
+    {
+        if (in[i] == '%' && i + 2 < len && iswxdigit(in[i+1]) && iswxdigit(in[i+2]))
+        {
+            WCHAR h[3] = { in[i+1], in[i+2], 0 };
+            bytes[b++] = (char)wcstol(h, NULL, 16);
+            i += 2;
+        }
+        else bytes[b++] = (char)in[i];
+    }
+    wlen = MultiByteToWideChar(CP_UTF8, 0, bytes, b, NULL, 0);
+    if (!(out = malloc((wlen + 1) * sizeof(WCHAR)))) { free(bytes); return E_OUTOFMEMORY; }
+    MultiByteToWideChar(CP_UTF8, 0, bytes, b, out, wlen);
+    out[wlen] = 0;
+    hr = WindowsCreateString(out, wlen, value);
+    free(bytes);
+    free(out);
+    return hr;
+}
+
+static const struct IUriEscapeStaticsVtbl uri_escape_statics_vtbl =
+{
+    uri_escape_statics_QueryInterface,
+    uri_escape_statics_AddRef,
+    uri_escape_statics_Release,
+    uri_escape_statics_GetIids,
+    uri_escape_statics_GetRuntimeClassName,
+    uri_escape_statics_GetTrustLevel,
+    /* IUriEscapeStatics methods */
+    uri_escape_statics_UnescapeComponent,
+    uri_escape_statics_EscapeComponent,
+};
+
 static struct iertutil iertutil =
 {
     {&activation_factory_vtbl},
     {&uri_factory_vtbl},
+    {&uri_escape_statics_vtbl},
     1
 };
 
