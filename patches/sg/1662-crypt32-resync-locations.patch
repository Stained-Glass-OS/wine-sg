From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: store auto-resync, cancel notify, service, user and enterprise stores

CERT_STORE_CTRL_AUTO_RESYNC and CERT_STORE_CTRL_CANCEL_NOTIFY were stubs,
and the CERT_SYSTEM_STORE_CURRENT_SERVICE, _SERVICES, _USERS and
_LOCAL_MACHINE_ENTERPRISE locations FIXMEs that failed: services that keep
certificates in their own stores, tools that look at another user's
stores and enterprise roots pushed to the machine found nothing.
CertEnumSystemStore also passed the callback's argument where the
location's parameter belonged, and CertEnumPhysicalStore was a stub.

- AUTO_RESYNC: the registry store watches its keys; before it is next
  enumerated after a change it reads them again, so certificates another
  handle or process added are seen without CERT_STORE_CTRL_RESYNC.
- CANCEL_NOTIFY: the event given to NOTIFY_CHANGE (or RESYNC) is no
  longer signalled; an event that was not registered is E_INVALIDARG.
- The locations: HKLM\Software\Microsoft\Cryptography\Services\<service>\
  SystemCertificates (SERVICES with "service\store"; CURRENT_SERVICE for
  the service this process runs, from the service manager -- a process
  that is no service gets ERROR_FILE_NOT_FOUND), HKEY_USERS\<sid>\
  Software\Microsoft\SystemCertificates (USERS, "sid\store"),
  HKLM\Software\Microsoft\EnterpriseCertificates (enterprise).
  CertEnumSystemStore lists them, and every service's or user's stores as
  "who\store" when no service or user is given.
- The machine's system stores also read its group policy and enterprise
  stores, the user's its group policy store and the machine's view, as
  their physical stores; CertEnumPhysicalStore lists .Default and those
  that exist.

Wine's crypt32 store tests: 557 tests, no failures (the enterprise
registration todo now passes and is no longer marked); cert: 631, no
failures, as before.

Gate: test/certresync-gate.sh (64- and 32-bit, test/certresync-probe.c).
Mutants SG_MUTANT_NO_AUTO_RESYNC (crypt32/regstore.c),
SG_MUTANT_NO_POLICY_STORES, SG_MUTANT_NO_CURRENT_SERVICE
(crypt32/store.c).
---
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -515,4 +515,8 @@ enum unix_funcs
 
 #define CRYPT32_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
+/* Stained Glass OS 1662: asked of a registry store before it is enumerated,
+ * when it was set to CERT_STORE_CTRL_AUTO_RESYNC */
+#define SG_CERT_STORE_CTRL_CHECK_RESYNC 0x53470001
+
 #endif
--- a/dlls/crypt32/provstore.c
+++ b/dlls/crypt32/provstore.c
@@ -31,6 +31,7 @@ typedef struct _WINE_PROVIDERSTORE
 {
     WINECRYPT_CERTSTORE             hdr;
     DWORD                           dwStoreProvFlags;
+    BOOL                            auto_resync;   /* Stained Glass OS 1662 */
     WINECRYPT_CERTSTORE            *memStore;
     HCERTSTOREPROV                  hStoreProv;
     PFN_CERT_STORE_PROV_CLOSE       provCloseStore;
@@ -106,11 +107,20 @@ static BOOL ProvStore_addCert(WINECRYPT_CERTSTORE *store, context_t *cert,
     return ret;
 }
 
+/* an auto-resync store reads itself again, if it changed, before it is
+ * enumerated from the start */
+static void ProvStore_check_resync(WINE_PROVIDERSTORE *ps, context_t *prev)
+{
+    if (!prev && ps->auto_resync && ps->provControl)
+        ps->provControl(ps->hStoreProv, 0, SG_CERT_STORE_CTRL_CHECK_RESYNC, NULL);
+}
+
 static context_t *ProvStore_enumCert(WINECRYPT_CERTSTORE *store, context_t *prev)
 {
     WINE_PROVIDERSTORE *ps = (WINE_PROVIDERSTORE*)store;
     cert_t *ret;
 
+    ProvStore_check_resync(ps, prev);
     ret = (cert_t*)ps->memStore->vtbl->certs.enumContext(ps->memStore, prev);
     if (!ret)
         return NULL;
@@ -178,6 +188,7 @@ static context_t *ProvStore_enumCRL(WINECRYPT_CERTSTORE *store, context_t *prev)
     WINE_PROVIDERSTORE *ps = (WINE_PROVIDERSTORE*)store;
     crl_t *ret;
 
+    ProvStore_check_resync(ps, prev);
     ret = (crl_t*)ps->memStore->vtbl->crls.enumContext(ps->memStore, prev);
     if (!ret)
         return NULL;
@@ -245,6 +256,7 @@ static context_t *ProvStore_enumCTL(WINECRYPT_CERTSTORE *store, context_t *prev)
     WINE_PROVIDERSTORE *ps = (WINE_PROVIDERSTORE*)store;
     ctl_t *ret;
 
+    ProvStore_check_resync(ps, prev);
     ret = (ctl_t*)ps->memStore->vtbl->ctls.enumContext(ps->memStore, prev);
     if (!ret)
         return NULL;
@@ -281,6 +293,7 @@ static BOOL ProvStore_control(WINECRYPT_CERTSTORE *cert_store, DWORD dwFlags, DW
     if (store->provControl)
         ret = store->provControl(store->hStoreProv, dwFlags, dwCtrlType,
          pvCtrlPara);
+    if (ret && dwCtrlType == CERT_STORE_CTRL_AUTO_RESYNC) store->auto_resync = TRUE;
     return ret;
 }
 
--- a/dlls/crypt32/regstore.c
+++ b/dlls/crypt32/regstore.c
@@ -44,7 +44,13 @@ typedef struct _WINE_REGSTOREINFO
