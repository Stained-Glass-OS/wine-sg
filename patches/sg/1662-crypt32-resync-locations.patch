+    WCHAR sg_base[512];
 
     TRACE("(%Id, %08lx, %s)\n", hCryptProv, dwFlags,
      debugstr_w(pvPara));
@@ -433,24 +500,32 @@ static WINECRYPT_CERTSTORE *CRYPT_SysRegOpenStoreW(HCRYPTPROV hCryptProv,
         base = CERT_LOCAL_MACHINE_SYSTEM_STORE_REGPATH;
         break;
     case CERT_SYSTEM_STORE_CURRENT_SERVICE:
