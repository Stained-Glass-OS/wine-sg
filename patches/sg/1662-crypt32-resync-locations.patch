     }
-    keys[store->notify_count++] = key;
     store->notify_keys = keys;
+    {
+        HANDLE *events = CryptMemRealloc(store->notify_events, (store->notify_count + 1) * sizeof(*events));
+        if (!events)
+        {
+            LeaveCriticalSection(&store->cs);
+            RegCloseKey(key);
+            SetLastError(ERROR_OUTOFMEMORY);
+            return FALSE;
+        }
+        events[store->notify_count] = event;
+        store->notify_events = events;
+    }
+    keys[store->notify_count++] = key;
     LeaveCriticalSection(&store->cs);
     return TRUE;
 }
 
+/* the store's contents read again from its keys */
+static void CRYPT_RegResync(WINE_REGSTOREINFO *store)
+{
+    HCERTSTORE memStore = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL);
+
+    CRYPT_RegFlushStore(store, FALSE);
+    CRYPT_RegReadFromReg(store->key, memStore, CERT_STORE_ADD_REPLACE_EXISTING);
+    I_CertUpdateStore(store->memStore, memStore, 0, 0);
+    CertCloseStore(memStore, 0);
+}
+
 static BOOL WINAPI CRYPT_RegControl(HCERTSTORE hCertStore, DWORD dwFlags,
  DWORD dwCtrlType, void const *pvCtrlPara)
 {
@@ -501,15 +533,17 @@ static BOOL WINAPI CRYPT_RegControl(HCERTSTORE hCertStore, DWORD dwFlags,
 
     switch (dwCtrlType)
     {
+    case SG_CERT_STORE_CTRL_CHECK_RESYNC:
+        /* the store is about to be enumerated: read it again if it changed */
+        if (!store->auto_event || WaitForSingleObject(store->auto_event, 0) != WAIT_OBJECT_0) break;
+        TRACE("%p changed, reading it again\n", store);
+        CRYPT_RegResync(store);
+        RegNotifyChangeKeyValue(store->auto_key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+         store->auto_event, TRUE);
+        break;
     case CERT_STORE_CTRL_RESYNC:
     {
-        HCERTSTORE memStore = CertOpenStore(CERT_STORE_PROV_MEMORY, 0, 0,
-         CERT_STORE_CREATE_NEW_FLAG, NULL);
-
-        CRYPT_RegFlushStore(store, FALSE);
-        CRYPT_RegReadFromReg(store->key, memStore, CERT_STORE_ADD_REPLACE_EXISTING);
-        I_CertUpdateStore(store->memStore, memStore, 0, 0);
-        CertCloseStore(memStore, 0);
+        CRYPT_RegResync(store);
         /* an event given with the resync is armed again for the next change */
         if (pvCtrlPara && *(const HANDLE *)pvCtrlPara)
             ret = CRYPT_RegNotifyChange(store, *(const HANDLE *)pvCtrlPara);
@@ -520,8 +554,32 @@ static BOOL WINAPI CRYPT_RegControl(HCERTSTORE hCertStore, DWORD dwFlags,
          dwFlags & CERT_STORE_CTRL_COMMIT_FORCE_FLAG);
         break;
     case CERT_STORE_CTRL_AUTO_RESYNC:
-        FIXME("CERT_STORE_CTRL_AUTO_RESYNC: stub\n");
+    {
+        LSTATUS rc;
+#ifdef SG_MUTANT_NO_AUTO_RESYNC
+        break;
+#endif
+        if (store->auto_event) break;
+        if ((rc = RegOpenKeyExW(store->key, NULL, 0, KEY_NOTIFY, &store->auto_key)))
+        {
+            store->auto_key = NULL;
+            SetLastError(rc);
+            ret = FALSE;
+            break;
+        }
+        store->auto_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        if (!store->auto_event || (rc = RegNotifyChangeKeyValue(store->auto_key, TRUE,
+             REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET, store->auto_event, TRUE)))
+        {
+            if (store->auto_event) CloseHandle(store->auto_event);
+            RegCloseKey(store->auto_key);
+            store->auto_event = NULL;
+            store->auto_key = NULL;
+            SetLastError(rc ? rc : GetLastError());
+            ret = FALSE;
+        }
         break;
+    }
     case CERT_STORE_CTRL_NOTIFY_CHANGE:
         /* the event is signalled when the store's registry key changes */
         if (!pvCtrlPara || !*(const HANDLE *)pvCtrlPara)
@@ -531,6 +589,38 @@ static BOOL WINAPI CRYPT_RegControl(HCERTSTORE hCertStore, DWORD dwFlags,
         }
         else ret = CRYPT_RegNotifyChange(store, *(const HANDLE *)pvCtrlPara);
         break;
+    case CERT_STORE_CTRL_CANCEL_NOTIFY:
+    {
+        /* Stained Glass OS 1662: the event is no longer signalled */
+        HANDLE event = pvCtrlPara ? *(const HANDLE *)pvCtrlPara : NULL;
+        DWORD i, found = 0;
+
+        if (!event)
+        {
+            SetLastError(E_INVALIDARG);
+            ret = FALSE;
+            break;
+        }
+        EnterCriticalSection(&store->cs);
+        for (i = 0; i < store->notify_count; )
+        {
+            if (store->notify_events[i] != event) { i++; continue; }
+            RegCloseKey(store->notify_keys[i]);
+            store->notify_count--;
+            memmove(store->notify_keys + i, store->notify_keys + i + 1, (store->notify_count - i) * sizeof(HKEY));
+            memmove(store->notify_events + i, store->notify_events + i + 1, (store->notify_count - i) * sizeof(HANDLE));
+            found++;
+        }
+        LeaveCriticalSection(&store->cs);
+        /* closing a watched key signals its event: the caller is not told */
+        if (found) ResetEvent(event);
+        if (!found)
+        {
+            SetLastError(E_INVALIDARG);
+            ret = FALSE;
+        }
+        break;
+    }
     default:
         FIXME("%lu: stub\n", dwCtrlType);
         ret = FALSE;
@@ -600,7 +690,10 @@ WINECRYPT_CERTSTORE *CRYPT_RegOpenStore(HCRYPTPROV hCryptProv, DWORD dwFlags,
                     regInfo->memStore = memStore;
