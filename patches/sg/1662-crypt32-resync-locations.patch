     case CERT_SYSTEM_STORE_CURRENT_USER_GROUP_POLICY:
         root = HKEY_CURRENT_USER;
         base = CERT_GROUP_POLICY_SYSTEM_STORE_REGPATH;
@@ -460,10 +535,9 @@ static WINECRYPT_CERTSTORE *CRYPT_SysRegOpenStoreW(HCRYPTPROV hCryptProv,
         base = CERT_GROUP_POLICY_SYSTEM_STORE_REGPATH;
