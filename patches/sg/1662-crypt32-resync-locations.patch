+/* Stained Glass OS 1662: the service this process runs as (for
+ * CERT_SYSTEM_STORE_CURRENT_SERVICE), from the service manager */
+static BOOL current_service_name(WCHAR *name, DWORD len)
+{
+    ENUM_SERVICE_STATUS_PROCESSW *services = NULL;
+    DWORD needed = 0, count = 0, resume = 0, i, pid = GetCurrentProcessId();
+    SC_HANDLE scm;
+    BOOL ret = FALSE;
+
+    if (!(scm = OpenSCManagerW(NULL, NULL, SC_MANAGER_ENUMERATE_SERVICE))) return FALSE;
+    EnumServicesStatusExW(scm, SC_ENUM_PROCESS_INFO, SERVICE_WIN32, SERVICE_ACTIVE, NULL, 0, &needed, &count,
+                          &resume, NULL);
+    if (needed && (services = CryptMemAlloc(needed)) &&
+        EnumServicesStatusExW(scm, SC_ENUM_PROCESS_INFO, SERVICE_WIN32, SERVICE_ACTIVE, (BYTE *)services, needed,
+                              &needed, &count, &resume, NULL))
+    {
+        for (i = 0; i < count && !ret; i++)
+            if (services[i].ServiceStatusProcess.dwProcessId == pid)
+            {
+                lstrcpynW(name, services[i].lpServiceName, len);
+                ret = TRUE;
+            }
+    }
+    CryptMemFree(services);
+    CloseServiceHandle(scm);
+    return ret;
+}
+
+/* the registry key a system store location's stores are under:
+ * services keep theirs in HKLM\Software\Microsoft\Cryptography\Services\
+ * <service>\SystemCertificates, users in HKEY_USERS\<sid>\Software\
+ * Microsoft\SystemCertificates, the enterprise stores in HKLM\Software\
+ * Microsoft\EnterpriseCertificates. para: the service or the user (SID),
+ * for those locations. */
+static BOOL system_store_base(DWORD location, const WCHAR *para, HKEY *root, WCHAR *base, DWORD len)
+{
+    WCHAR service[256];
+
+    switch (location)
+    {
+    case CERT_SYSTEM_STORE_CURRENT_SERVICE:
+#ifdef SG_MUTANT_NO_CURRENT_SERVICE
+        return FALSE;
+#endif
+        if (!current_service_name(service, ARRAY_SIZE(service))) return FALSE;
+        para = service;
+        /* fall through */
+    case CERT_SYSTEM_STORE_SERVICES:
+        if (!para || !*para) return FALSE;
+        *root = HKEY_LOCAL_MACHINE;
+        swprintf(base, len, L"Software\\Microsoft\\Cryptography\\Services\\%s\\SystemCertificates", para);
+        return TRUE;
+    case CERT_SYSTEM_STORE_USERS:
+        if (!para || !*para) return FALSE;
+        *root = HKEY_USERS;
+        swprintf(base, len, L"%s\\%s", para, CERT_LOCAL_MACHINE_SYSTEM_STORE_REGPATH);
+        return TRUE;
+    case CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE:
+        *root = HKEY_LOCAL_MACHINE;
+        lstrcpynW(base, L"Software\\Microsoft\\EnterpriseCertificates", len);
+        return TRUE;
+    }
+    return FALSE;
+}
+
