@@ -325,6 +331,9 @@ static void WINAPI CRYPT_RegCloseStore(HCERTSTORE hCertStore, DWORD dwFlags)
     RegCloseKey(store->key);
     while (store->notify_count) RegCloseKey(store->notify_keys[--store->notify_count]);
     CryptMemFree(store->notify_keys);
+    CryptMemFree(store->notify_events);
+    if (store->auto_key) RegCloseKey(store->auto_key);
+    if (store->auto_event) CloseHandle(store->auto_event);
     store->cs.DebugInfo->Spare[0] = 0;
     DeleteCriticalSection(&store->cs);
     CryptMemFree(store);
@@ -484,12 +493,35 @@ static BOOL CRYPT_RegNotifyChange(WINE_REGSTOREINFO *store, HANDLE event)
         SetLastError(ERROR_OUTOFMEMORY);
