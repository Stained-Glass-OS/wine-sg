+/* Stained Glass OS 1662: the physical stores of a system store beyond its
+ * own (.Default): the machine's stores also hold the group policy and
+ * enterprise stores (certificates pushed by policy are trusted), the user's
+ * the user's group policy store. They are read when they exist. */
+static const struct sg_physical_store
+{
+    DWORD system_location;
+    const WCHAR *name;
+    DWORD location;
+} sg_physical_stores[] =
+{
+    { CERT_SYSTEM_STORE_CURRENT_USER, L".GroupPolicy", CERT_SYSTEM_STORE_CURRENT_USER_GROUP_POLICY },
+    { CERT_SYSTEM_STORE_CURRENT_USER, L".LocalMachine", CERT_SYSTEM_STORE_LOCAL_MACHINE },
+    { CERT_SYSTEM_STORE_LOCAL_MACHINE, L".GroupPolicy", CERT_SYSTEM_STORE_LOCAL_MACHINE_GROUP_POLICY },
+    { CERT_SYSTEM_STORE_LOCAL_MACHINE, L".Enterprise", CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE },
+};
+
+static HCERTSTORE sg_open_physical(const struct sg_physical_store *phys, DWORD flags, const WCHAR *name)
+{
+    flags &= ~(CERT_SYSTEM_STORE_LOCATION_MASK | CERT_STORE_CREATE_NEW_FLAG);
+    flags |= phys->location | CERT_STORE_READONLY_FLAG | CERT_STORE_OPEN_EXISTING_FLAG;
+    return CertOpenStore(CERT_STORE_PROV_SYSTEM_REGISTRY_W, 0, 0, flags, name);
+}
+
+static void sg_add_policy_stores(HCERTSTORE collection, DWORD flags, const WCHAR *name)
+{
+    DWORD location = flags & CERT_SYSTEM_STORE_LOCATION_MASK, i;
+    HCERTSTORE phys;
+
+#ifdef SG_MUTANT_NO_POLICY_STORES
+    return;
+#endif
+
+    for (i = 0; i < ARRAY_SIZE(sg_physical_stores); i++)
+    {
+        /* the user's view of the machine's store is added below */
+        if (sg_physical_stores[i].system_location != location ||
+            sg_physical_stores[i].location == CERT_SYSTEM_STORE_LOCAL_MACHINE) continue;
+        if (!(phys = sg_open_physical(&sg_physical_stores[i], flags, name))) continue;
+        CertAddStoreToCollection(collection, phys, 0, 0);
+        CertCloseStore(phys, 0);
+    }
+}
+
