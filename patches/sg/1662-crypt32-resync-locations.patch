+    HANDLE          *notify_events; /* the event each key signals (CERT_STORE_CTRL_CANCEL_NOTIFY) */
     DWORD            notify_count;
+    /* Stained Glass OS 1662: CERT_STORE_CTRL_AUTO_RESYNC: signalled when the
+     * store's keys change; the store reads them again before it is next
+     * enumerated */
+    HANDLE           auto_event;
+    HKEY             auto_key;
