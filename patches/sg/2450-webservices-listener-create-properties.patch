From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: listener backlog and IP version are creation-time properties

Ground truth from Wine's channel test (3 todo_wine marks removed): WsSetListenerProperty refuses WS_LISTENER_PROPERTY_LISTEN_BACKLOG and _IP_VERSION on an existing listener (E_INVALIDARG; they are given to WsCreateListener), and the IP version of a new listener is WS_IP_VERSION_AUTO.
---
--- a/dlls/webservices/listener.c
+++ b/dlls/webservices/listener.c
@@ -75,8 +75,13 @@ BOOL WINAPI DllMain( HINSTANCE hinst, DWORD reason, void *reserved )
 
 static const struct prop_desc listener_props[] =
 {
-    { sizeof(ULONG), FALSE },                               /* WS_LISTENER_PROPERTY_LISTEN_BACKLOG */
-    { sizeof(WS_IP_VERSION), FALSE },                       /* WS_LISTENER_PROPERTY_IP_VERSION */
+#ifndef SG_MUTANT_WSLISTENER_PROPS
+    { sizeof(ULONG), TRUE },                                /* WS_LISTENER_PROPERTY_LISTEN_BACKLOG: given when created */
+    { sizeof(WS_IP_VERSION), TRUE },                        /* WS_LISTENER_PROPERTY_IP_VERSION: likewise */
+#else
+    { sizeof(ULONG), FALSE },
+    { sizeof(WS_IP_VERSION), FALSE },
+#endif
     { sizeof(WS_LISTENER_STATE), TRUE },                    /* WS_LISTENER_PROPERTY_STATE */
     { sizeof(WS_CALLBACK_MODEL), FALSE },                   /* WS_LISTENER_PROPERTY_ASYNC_CALLBACK_MODEL */
     { sizeof(WS_CHANNEL_TYPE), TRUE },                      /* WS_LISTENER_PROPERTY_CHANNEL_TYPE */
@@ -146,6 +151,7 @@ static struct listener *alloc_listener(void)
 
     prop_init( listener_props, count, ret->prop, &ret[1] );
     ret->prop_count = count;
+    *(WS_IP_VERSION *)ret->prop[WS_LISTENER_PROPERTY_IP_VERSION].value = WS_IP_VERSION_AUTO;
     return ret;
 }
 
@@ -194,8 +200,16 @@ static HRESULT create_listener( WS_CHANNEL_TYPE type, WS_CHANNEL_BINDING binding
 
     for (i = 0; i < count; i++)
     {
-        hr = prop_set( listener->prop, listener->prop_count, properties[i].id, properties[i].value,
-                       properties[i].valueSize );
+        ULONG id = properties[i].id;
+
+        /* the backlog and the IP version can be given here, and only here */
+        if ((id == WS_LISTENER_PROPERTY_LISTEN_BACKLOG || id == WS_LISTENER_PROPERTY_IP_VERSION) &&
+            id < listener->prop_count && properties[i].valueSize == listener->prop[id].size && properties[i].value)
+        {
+            memcpy( listener->prop[id].value, properties[i].value, properties[i].valueSize );
+            hr = S_OK;
+        }
+        else hr = prop_set( listener->prop, listener->prop_count, id, properties[i].value, properties[i].valueSize );
         if (hr != S_OK)
         {
             free_listener( listener );
--- a/dlls/webservices/tests/channel.c
+++ b/dlls/webservices/tests/channel.c
@@ -260,12 +260,12 @@ static void test_WsCreateListener(void)
     backlog = 1000;
     size = sizeof(backlog);
     hr = WsSetListenerProperty( listener, WS_LISTENER_PROPERTY_LISTEN_BACKLOG, &backlog, size, NULL );
-    todo_wine ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
 
     version = WS_IP_VERSION_4;
     size = sizeof(version);
     hr = WsSetListenerProperty( listener, WS_LISTENER_PROPERTY_IP_VERSION, &version, size, NULL );
-    todo_wine ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
 
     type = 0xdeadbeef;
     hr = WsGetListenerProperty( listener, WS_LISTENER_PROPERTY_CHANNEL_TYPE, &type, sizeof(type), NULL );
@@ -281,7 +281,7 @@ static void test_WsCreateListener(void)
     size = sizeof(version);
     hr = WsGetListenerProperty( listener, WS_LISTENER_PROPERTY_IP_VERSION, &version, size, NULL );
     ok( hr == S_OK, "got %#lx\n", hr );
-    todo_wine ok( version == WS_IP_VERSION_AUTO, "got %u\n", version );
+    ok( version == WS_IP_VERSION_AUTO, "got %u\n", version );
 
     state = 0xdeadbeef;
     size = sizeof(state);
