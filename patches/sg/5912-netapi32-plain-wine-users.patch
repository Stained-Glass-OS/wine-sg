From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32: without the wine group every ordinary account is a user (5912)

On a machine without the Stained Glass wine group (a plain Wine, or a
developer's host), fast-a 3180's local groups listed no member of Users and
only the current user in Administrators, because account types come from the
sgwine/sg-admins Unix groups. fast-b 3528 (whose local-group functions were
dropped for 3180's) listed every ordinary account (uid 1000-59999) there, and
its gate fastb-acct checks that the current user is in Users and that
"net user NAME" shows the memberships. Without the wine group every ordinary
account is now one of the computer's users again (Users), as 3528 did; on a
Stained Glass system nothing changes (the group exists).

Integration patch (integ-2026-10): no behaviour of the dropped
implementation is lost (coordinator rule). Gates: fastb-acct (3528/3532),
fastnetacct (3180, stand-in /etc with the groups). Mutant
SG_MUTANT_ACCT_PLAIN_NONE.
---
diff --git a/dlls/netapi32/localacct.c b/dlls/netapi32/localacct.c
--- a/dlls/netapi32/localacct.c
+++ b/dlls/netapi32/localacct.c
@@ -216,6 +216,17 @@ static const char *env_group( const WCHAR *var, const char *def, char *buf, int
 }
 
 /* the local accounts (people), as names; admin: 0 all, 1 administrators only, 2 standard only */
+/* is there a line for the Unix group in /etc/group text */
+static BOOL unix_group_exists( const char *groups, const char *group )
+{
+    size_t glen = strlen( group );
+    const char *p;
+
+    for (p = groups; p && *p; p = strchr( p, '\n' ) ? strchr( p, '\n' ) + 1 : NULL)
+        if (!strncmp( p, group, glen ) && p[glen] == ':') return TRUE;
+    return FALSE;
+}
+
 static DWORD list_accounts( int admin, WCHAR ***names, DWORD *count )
 {
     char abuf[64], wbuf[64], *passwd, *group;
@@ -225,15 +236,21 @@ static DWORD list_accounts( int admin, WCHAR ***names, DWORD *count )
     struct passwd_line e;
     WCHAR **list = NULL;
     DWORD n = 0, cap = 0;
+    BOOL plain = FALSE;
 
     *names = NULL; *count = 0;
     if (!(passwd = read_account_file( L"passwd" ))) return NERR_Success;
     group = read_account_file( L"group" );
+    /* A machine without the Stained Glass wine group (a plain Wine) has no account type to go by:
+     * every ordinary account is one of this computer's users, as fast-b 3528 listed them (5912). */
+#ifndef SG_MUTANT_ACCT_PLAIN_NONE
+    plain = !group || !unix_group_exists( group, wgroup );
+#endif
     for (pos = passwd; next_passwd( &pos, &e ); )
     {
         BOOL is_admin;
         if (!local_person( &e )) continue;
-        if (!group || !in_unix_group( group, wgroup, &e )) continue;
+        if (!plain && !in_unix_group( group, wgroup, &e )) continue;
         is_admin = in_unix_group( group, agroup, &e );
         if ((admin == 1 && !is_admin) || (admin == 2 && is_admin)) continue;
         if (n == cap)
