 enable_urlmon
 enable_usbd_sys
+enable_usbscan_sys
 enable_user32
 enable_userenv
 enable_usp10
@@ -22834,6 +22835,7 @@
 wine_fn_config_makefile dlls/urlmon enable_urlmon
 wine_fn_config_makefile dlls/urlmon/tests enable_tests
 wine_fn_config_makefile dlls/usbd.sys enable_usbd_sys
+wine_fn_config_makefile dlls/usbscan.sys enable_usbscan_sys
 wine_fn_config_makefile dlls/user.exe16 enable_win16
 wine_fn_config_makefile dlls/user32 enable_user32
 wine_fn_config_makefile dlls/user32/tests enable_tests
--- a/configure.ac
+++ b/configure.ac
@@ -3155,6 +3155,7 @@
 WINE_CONFIG_MAKEFILE(dlls/urlmon)
 WINE_CONFIG_MAKEFILE(dlls/urlmon/tests)
 WINE_CONFIG_MAKEFILE(dlls/usbd.sys)
+WINE_CONFIG_MAKEFILE(dlls/usbscan.sys)
 WINE_CONFIG_MAKEFILE(dlls/user.exe16,enable_win16)
 WINE_CONFIG_MAKEFILE(dlls/user32)
 WINE_CONFIG_MAKEFILE(dlls/user32/tests)
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -2835,6 +2835,7 @@
 [InfFiles]
 input.inf,"@%12%\hidclass.sys,-1"
 mouhid.inf,"@%12%\mouhid.sys,-1"
