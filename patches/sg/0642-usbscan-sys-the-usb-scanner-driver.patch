--- /dev/null
+++ b/dlls/usbscan.sys/Makefile.in
@@ -0,0 +1,8 @@
+MODULE    = usbscan.sys
+IMPORTS   = usbd ntoskrnl
+
+EXTRADLLFLAGS = -Wl,--subsystem,native
+
+SOURCES = \
+	usbscan.c \
+	usbscan.rc
--- /dev/null
+++ b/dlls/usbscan.sys/sti.inf
@@ -0,0 +1,34 @@
+; The still image (scanner and camera) class's shared INF sections, which a
+; device's own INF uses through "Include=sti.inf" and "Needs=STI.USBSection":
+; a USB scanner gets the usbscan driver (\\.\UsbscanN).
+; Stained Glass OS, our own; the section names are the ones device INFs use.
+
+[Version]
+Signature="$CHICAGO$"
+Class=Image
+ClassGuid={6bdd1fc6-810f-11d0-bec7-08002be2092f}
+Provider=%Wine%
+
+[STI.USBSection]
+SubClass=StillImage
+DeviceType=1
+
+[STI.USBSection.Services]
+AddService = usbscan,0x00000002,STI.USBSection.ServiceInstall
+
+[STI.USBSection.ServiceInstall]
+Description="USB scanner driver"
+DisplayName="USB scanner"
+ServiceBinary="%12%\usbscan.sys"
+LoadOrderGroup="WinePlugPlay"
+ServiceType=1
+StartType=3
+ErrorControl=1
+
+[STI.SerialSection]
+SubClass=StillImage
+
+[STI.SerialSection.Services]
+
+[Strings]
+Wine="Wine"
--- /dev/null
+++ b/dlls/usbscan.sys/usbscan.c
@@ -0,0 +1,733 @@
+/*
+ * usbscan.sys: the USB still image (scanner) driver
+ *
+ * A function driver over a USB device (wineusb's PDO), for scanners whose INF
+ * says "Needs=STI.USBSection" (sti.inf). The device is \Device\UsbscanN, and
+ * \\.\UsbscanN to programs: ReadFile reads its bulk-in pipe, WriteFile writes
+ * its bulk-out pipe, and the IOCTLs of usbscan.h -- the device descriptor, the
+ * pipes, vendor and class control requests, the interrupt (event) pipe. A
+ * program may open \\.\UsbscanN\<pipe> to read or write one pipe.
+ *
+ * Scanner software probes \\.\Usbscan0, 1, 2... and talks to the device so
+ * (the Ambir ImageScan Pro 490i's library). Bulk and interrupt transfers
+ * complete asynchronously: winedevice serves every driver in it from one
+ * thread, and a scan's reads must not hold up the others.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winioctl.h"
+#include "ddk/wdm.h"
+#include "ddk/ntifs.h"
+#include "ddk/usb.h"
+#include "ddk/usbioctl.h"
+#include "ddk/usbdlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(usbscan);
+
+/* usbscan.h (the public interface programs use) */
+#define FILE_DEVICE_USB_SCAN 0x8000
+#define IOCTL_INDEX 0x0800
+#define USBSCAN_IOCTL(n) (((ULONG)FILE_DEVICE_USB_SCAN << 16) | ((IOCTL_INDEX + (n)) << 2) | METHOD_BUFFERED)
+#define IOCTL_GET_VERSION               USBSCAN_IOCTL(0)
+#define IOCTL_CANCEL_IO                 USBSCAN_IOCTL(1)
+#define IOCTL_WAIT_ON_DEVICE_EVENT      USBSCAN_IOCTL(2)
+#define IOCTL_READ_REGISTERS            USBSCAN_IOCTL(3)
+#define IOCTL_WRITE_REGISTERS           USBSCAN_IOCTL(4)
+#define IOCTL_GET_CHANNEL_ALIGN_RQST    USBSCAN_IOCTL(5)
+#define IOCTL_GET_DEVICE_DESCRIPTOR     USBSCAN_IOCTL(6)
+#define IOCTL_RESET_PIPE                USBSCAN_IOCTL(7)
+#define IOCTL_GET_USB_DESCRIPTOR        USBSCAN_IOCTL(8)
+#define IOCTL_SEND_USB_REQUEST          USBSCAN_IOCTL(9)
+#define IOCTL_GET_PIPE_CONFIGURATION    USBSCAN_IOCTL(10)
+#define IOCTL_SET_TIMEOUT               USBSCAN_IOCTL(11)
+
+#define MAX_NUM_PIPES 8
+
+#include "pshpack8.h"
+typedef struct { unsigned major, minor, internal; } DRV_VERSION;
+typedef struct { unsigned EventChannelSize, uReadDataAlignment, uWriteDataAlignment; } CHANNEL_INFO;
+typedef enum { EVENT_PIPE, READ_DATA_PIPE, WRITE_DATA_PIPE, ALL_PIPE } PIPE_TYPE;
+typedef struct { UCHAR DescriptorType; UCHAR Index; USHORT LanguageId; } USBSCAN_GET_DESCRIPTOR;
+typedef struct { USHORT usVendorId, usProductId, usBcdDevice, usLanguageId; } SCAN_DEVICE_DESCRIPTOR;
+typedef enum { USBSCAN_PIPE_CONTROL, USBSCAN_PIPE_ISOCHRONOUS, USBSCAN_PIPE_BULK, USBSCAN_PIPE_INTERRUPT } RAW_PIPE_TYPE;
+typedef struct { USHORT MaximumPacketSize; UCHAR EndpointAddress; UCHAR Interval; RAW_PIPE_TYPE PipeType; } USBSCAN_PIPE_INFORMATION;
+typedef struct { ULONG NumberOfPipes; USBSCAN_PIPE_INFORMATION PipeInfo[MAX_NUM_PIPES]; } USBSCAN_PIPE_CONFIGURATION;
+typedef struct { ULONG TimeoutRead, TimeoutWrite, TimeoutEvent; } USBSCAN_TIMEOUT;
+#include "poppack.h"
+
+/* IO_BLOCK and IO_BLOCK_EX hold a pointer: their layout is the caller's */
+struct io_block
+{
+    ULONG offset, length;
+    ULONG_PTR data;
+    ULONG index;
+    UCHAR request, request_type, direction_in;
+};
+
+struct scanner
+{
+    DEVICE_OBJECT *fdo, *pdo, *next;
+    UNICODE_STRING link;
+    BOOL started;
+    USB_DEVICE_DESCRIPTOR device_desc;
+    USBD_CONFIGURATION_HANDLE config;
+    USBD_PIPE_INFORMATION pipes[MAX_NUM_PIPES];
+    ULONG pipe_count;
+    int bulk_in, bulk_out, interrupt_in;
+    USBSCAN_TIMEOUT timeout;
+};
+
+/* a file's pipe: -1, the default ones */
+#define FILE_PIPE(file) ((int)(INT_PTR)(file)->FsContext - 1)
+
+static NTSTATUS WINAPI sync_completion( DEVICE_OBJECT *device, IRP *irp, void *context )
+{
+    if (irp->PendingReturned) KeSetEvent( context, IO_NO_INCREMENT, FALSE );
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+/* an URB to the USB device, waited for (control requests, configuration) */
+static NTSTATUS submit_urb_sync( struct scanner *scanner, URB *urb )
+{
+    IO_STACK_LOCATION *stack;
+    NTSTATUS status;
+    KEVENT event;
+    IRP *irp;
+
+    if (!(irp = IoAllocateIrp( scanner->next->StackSize, FALSE ))) return STATUS_NO_MEMORY;
+    KeInitializeEvent( &event, NotificationEvent, FALSE );
+    stack = IoGetNextIrpStackLocation( irp );
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = urb;
+    IoSetCompletionRoutine( irp, sync_completion, &event, TRUE, TRUE, TRUE );
+    if (IoCallDriver( scanner->next, irp ) == STATUS_PENDING)
+        KeWaitForSingleObject( &event, Executive, KernelMode, FALSE, NULL );
+    status = irp->IoStatus.Status;
+    IoFreeIrp( irp );
+    if (!status && !USBD_SUCCESS( urb->UrbHeader.Status )) status = STATUS_UNSUCCESSFUL;
+    return status;
+}
+
+/* the original IRP waits on this one's completion */
+struct transfer
+{
+    IRP *irp;           /* the program's */
+    URB urb;
+};
+
+static NTSTATUS WINAPI transfer_completion( DEVICE_OBJECT *device, IRP *usb_irp, void *context )
+{
+    struct transfer *transfer = context;
+    IRP *irp = transfer->irp;
+
+    irp->IoStatus.Status = usb_irp->IoStatus.Status;
+    if (!irp->IoStatus.Status && !USBD_SUCCESS( transfer->urb.UrbHeader.Status ))
+        irp->IoStatus.Status = STATUS_UNSUCCESSFUL;
+    irp->IoStatus.Information = irp->IoStatus.Status ? 0 : transfer->urb.UrbBulkOrInterruptTransfer.TransferBufferLength;
+    TRACE( "irp %p: %#lx, %Iu bytes.\n", irp, irp->IoStatus.Status, irp->IoStatus.Information );
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    ExFreePool( transfer );
+    IoFreeIrp( usb_irp );
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+/* a bulk or interrupt transfer on a pipe, the program's IRP pending on it */
+static NTSTATUS start_transfer( struct scanner *scanner, IRP *irp, int pipe, void *buffer, ULONG length, BOOL in )
+{
+    struct transfer *transfer;
+    IO_STACK_LOCATION *stack;
+    IRP *usb_irp;
+
+    if (pipe < 0 || pipe >= scanner->pipe_count) return STATUS_INVALID_PARAMETER;
+    if (!(transfer = ExAllocatePool( NonPagedPool, sizeof(*transfer) ))) return STATUS_NO_MEMORY;
+    if (!(usb_irp = IoAllocateIrp( scanner->next->StackSize, FALSE )))
+    {
+        ExFreePool( transfer );
+        return STATUS_NO_MEMORY;
+    }
+    memset( &transfer->urb, 0, sizeof(transfer->urb) );
+    transfer->irp = irp;
+    transfer->urb.UrbHeader.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+    transfer->urb.UrbHeader.Length = sizeof(struct _URB_BULK_OR_INTERRUPT_TRANSFER);
+    transfer->urb.UrbBulkOrInterruptTransfer.PipeHandle = scanner->pipes[pipe].PipeHandle;
+    transfer->urb.UrbBulkOrInterruptTransfer.TransferFlags = in ? USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK : 0;
+    transfer->urb.UrbBulkOrInterruptTransfer.TransferBuffer = buffer;
+    transfer->urb.UrbBulkOrInterruptTransfer.TransferBufferLength = length;
+
+    stack = IoGetNextIrpStackLocation( usb_irp );
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = &transfer->urb;
+    IoSetCompletionRoutine( usb_irp, transfer_completion, transfer, TRUE, TRUE, TRUE );
+
+    TRACE( "irp %p: pipe %d (endpoint %#x), %lu bytes %s.\n", irp, pipe,
+           scanner->pipes[pipe].EndpointAddress, length, in ? "in" : "out" );
+    IoMarkIrpPending( irp );
+    IoCallDriver( scanner->next, usb_irp );
+    return STATUS_PENDING;
+}
+
+static NTSTATUS abort_pipe( struct scanner *scanner, int pipe )
+{
+    struct _URB_PIPE_REQUEST urb = {{0}};
+
+    if (pipe < 0 || pipe >= scanner->pipe_count) return STATUS_INVALID_PARAMETER;
+    urb.Hdr.Function = URB_FUNCTION_ABORT_PIPE;
+    urb.Hdr.Length = sizeof(urb);
+    urb.PipeHandle = scanner->pipes[pipe].PipeHandle;
+    return submit_urb_sync( scanner, (URB *)&urb );
+}
+
+static NTSTATUS reset_pipe( struct scanner *scanner, int pipe )
+{
+    struct _URB_PIPE_REQUEST urb = {{0}};
+
+    if (pipe < 0 || pipe >= scanner->pipe_count) return STATUS_INVALID_PARAMETER;
+    urb.Hdr.Function = URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL;
+    urb.Hdr.Length = sizeof(urb);
+    urb.PipeHandle = scanner->pipes[pipe].PipeHandle;
+    return submit_urb_sync( scanner, (URB *)&urb );
+}
+
+static int pipe_of_type( struct scanner *scanner, ULONG type )
+{
+    switch (type)
+    {
+    case EVENT_PIPE: return scanner->interrupt_in;
+    case READ_DATA_PIPE: return scanner->bulk_in;
+    case WRITE_DATA_PIPE: return scanner->bulk_out;
+    }
+    return -1;
+}
+
+static NTSTATUS get_descriptor( struct scanner *scanner, UCHAR type, UCHAR index, USHORT lang, void *buffer, ULONG *length )
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST urb = {{0}};
+    NTSTATUS status;
+
+    urb.Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    urb.Hdr.Length = sizeof(urb);
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = *length;
+    urb.DescriptorType = type;
+    urb.Index = index;
+    urb.LanguageId = lang;
+    status = submit_urb_sync( scanner, (URB *)&urb );
+    *length = urb.TransferBufferLength;
+    return status;
+}
+
+/* a vendor or class control request on the default pipe; data in buffer */
+static NTSTATUS control_request( struct scanner *scanner, UCHAR request_type, UCHAR request, USHORT value,
+                                 USHORT index, void *buffer, ULONG *length, BOOL in )
+{
+    struct _URB_CONTROL_VENDOR_OR_CLASS_REQUEST urb = {{0}};
+    NTSTATUS status;
+    BOOL interface = (request_type & 0x1f) == 1;
+
+    switch ((request_type >> 5) & 3)
+    {
+    case 2: urb.Hdr.Function = interface ? URB_FUNCTION_VENDOR_INTERFACE : URB_FUNCTION_VENDOR_DEVICE; break;
+    case 1: urb.Hdr.Function = interface ? URB_FUNCTION_CLASS_INTERFACE : URB_FUNCTION_CLASS_DEVICE; break;
+    default:
+        FIXME( "standard request %#x (type %#x) not supported\n", request, request_type );
+        return STATUS_NOT_SUPPORTED;
+    }
+    urb.Hdr.Length = sizeof(urb);
+    urb.TransferFlags = in ? USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK : 0;
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = *length;
+    urb.Request = request;
+    urb.Value = value;
+    urb.Index = index;
+    TRACE( "type %#x request %#x value %#x index %#x, %lu bytes %s.\n", request_type, request, value, index,
+           *length, in ? "in" : "out" );
+    status = submit_urb_sync( scanner, (URB *)&urb );
+    *length = urb.TransferBufferLength;
+    TRACE( "  -> %#lx (usbd %#lx), %lu bytes.\n", status, urb.Hdr.Status, *length );
+    return status;
+}
+
+/* IO_BLOCK(_EX) as the caller laid it out */
+static BOOL get_io_block( IRP *irp, const void *in, ULONG in_size, BOOL ex, struct io_block *block )
+{
+    memset( block, 0, sizeof(*block) );
+#ifdef _WIN64
+    if (IoIs32bitProcess( irp ))
+    {
+        const BYTE *p = in;
+        if (in_size < (ex ? 19 : 16)) return FALSE;
+        block->offset = *(const ULONG *)p;
+        block->length = *(const ULONG *)(p + 4);
+        block->data = *(const ULONG *)(p + 8);
+        block->index = *(const ULONG *)(p + 12);
+        if (ex)
+        {
+            block->request = p[16];
+            block->request_type = p[17];
+            block->direction_in = p[18];
+        }
+        return TRUE;
+    }
+#endif
+    {
+        const BYTE *p = in;
+        if (in_size < (ex ? 2 * sizeof(ULONG) + 2 * sizeof(void *) + 3 : 2 * sizeof(ULONG) + 2 * sizeof(void *))) return FALSE;
+        block->offset = *(const ULONG *)p;
+        block->length = *(const ULONG *)(p + 4);
+        block->data = *(const ULONG_PTR *)(p + sizeof(void *));
+        block->index = *(const ULONG *)(p + 2 * sizeof(void *));
+        if (ex)
+        {
+            block->request = p[2 * sizeof(void *) + 4];
+            block->request_type = p[2 * sizeof(void *) + 5];
+            block->direction_in = p[2 * sizeof(void *) + 6];
+        }
+    }
+    return TRUE;
+}
+
+/* the caller's memory at block->data, read or written (Wine's drivers run in
+ * a process of their own) */
+static NTSTATUS caller_memory( IRP *irp, ULONG_PTR address, void *buffer, ULONG length, BOOL write )
+{
+    PEPROCESS process = IoGetRequestorProcess( irp );
+    HANDLE handle;
+    SIZE_T done = 0;
+    NTSTATUS status;
+
+    if (!address || !length) return STATUS_SUCCESS;
+    if ((status = ObOpenObjectByPointer( process, OBJ_KERNEL_HANDLE, NULL,
+                                         PROCESS_VM_READ | PROCESS_VM_WRITE | PROCESS_VM_OPERATION,
+                                         NULL, KernelMode, &handle )))
+        return status;
+    if (write) status = NtWriteVirtualMemory( handle, (void *)address, buffer, length, &done );
+    else status = NtReadVirtualMemory( handle, (void *)address, buffer, length, &done );
+    NtClose( handle );
+    return status;
+}
+
+static NTSTATUS device_ioctl( struct scanner *scanner, IRP *irp )
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_size = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    void *buffer = irp->AssociatedIrp.SystemBuffer;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "code %#lx, in %lu, out %lu.\n", code, in_size, out_size );
+    irp->IoStatus.Information = 0;
+
+    switch (code)
+    {
+    case IOCTL_GET_VERSION:
+    {
+        DRV_VERSION version = { 1, 0, 0 };
+        if (out_size < sizeof(version)) return STATUS_BUFFER_TOO_SMALL;
+        memcpy( buffer, &version, sizeof(version) );
+        irp->IoStatus.Information = sizeof(version);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_GET_DEVICE_DESCRIPTOR:
+    {
+        SCAN_DEVICE_DESCRIPTOR desc;
+        if (out_size < sizeof(desc)) return STATUS_BUFFER_TOO_SMALL;
+        desc.usVendorId = scanner->device_desc.idVendor;
+        desc.usProductId = scanner->device_desc.idProduct;
+        desc.usBcdDevice = scanner->device_desc.bcdDevice;
+        desc.usLanguageId = 0;
+        memcpy( buffer, &desc, sizeof(desc) );
+        irp->IoStatus.Information = sizeof(desc);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_GET_USB_DESCRIPTOR:
+    {
+        USBSCAN_GET_DESCRIPTOR req;
+        ULONG length = out_size;
+        if (in_size < sizeof(req)) return STATUS_INVALID_PARAMETER;
+        memcpy( &req, buffer, sizeof(req) );
+        status = get_descriptor( scanner, req.DescriptorType, req.Index, req.LanguageId, buffer, &length );
+        if (!status) irp->IoStatus.Information = length;
+        return status;
+    }
+
+    case IOCTL_GET_PIPE_CONFIGURATION:
+    {
+        USBSCAN_PIPE_CONFIGURATION config = {0};
+        ULONG i;
+        if (out_size < sizeof(config)) return STATUS_BUFFER_TOO_SMALL;
+        config.NumberOfPipes = scanner->pipe_count;
+        for (i = 0; i < scanner->pipe_count; i++)
+        {
+            config.PipeInfo[i].MaximumPacketSize = scanner->pipes[i].MaximumPacketSize;
+            config.PipeInfo[i].EndpointAddress = scanner->pipes[i].EndpointAddress;
+            config.PipeInfo[i].Interval = scanner->pipes[i].Interval;
+            switch (scanner->pipes[i].PipeType)
+            {
+            case UsbdPipeTypeControl: config.PipeInfo[i].PipeType = USBSCAN_PIPE_CONTROL; break;
+            case UsbdPipeTypeIsochronous: config.PipeInfo[i].PipeType = USBSCAN_PIPE_ISOCHRONOUS; break;
+            case UsbdPipeTypeBulk: config.PipeInfo[i].PipeType = USBSCAN_PIPE_BULK; break;
+            case UsbdPipeTypeInterrupt: config.PipeInfo[i].PipeType = USBSCAN_PIPE_INTERRUPT; break;
+            }
+        }
+        memcpy( buffer, &config, sizeof(config) );
+        irp->IoStatus.Information = sizeof(config);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_GET_CHANNEL_ALIGN_RQST:
+    {
+        CHANNEL_INFO info = {0};
+        if (out_size < sizeof(info)) return STATUS_BUFFER_TOO_SMALL;
+        if (scanner->interrupt_in >= 0) info.EventChannelSize = scanner->pipes[scanner->interrupt_in].MaximumPacketSize;
+        if (scanner->bulk_in >= 0) info.uReadDataAlignment = scanner->pipes[scanner->bulk_in].MaximumPacketSize;
+        if (scanner->bulk_out >= 0) info.uWriteDataAlignment = scanner->pipes[scanner->bulk_out].MaximumPacketSize;
+        memcpy( buffer, &info, sizeof(info) );
+        irp->IoStatus.Information = sizeof(info);
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_SET_TIMEOUT:
+        if (in_size < sizeof(USBSCAN_TIMEOUT)) return STATUS_INVALID_PARAMETER;
+        memcpy( &scanner->timeout, buffer, sizeof(USBSCAN_TIMEOUT) );
+        return STATUS_SUCCESS;
+
+    case IOCTL_CANCEL_IO:
+    case IOCTL_RESET_PIPE:
+    {
+        ULONG type, i;
+        if (in_size < sizeof(ULONG)) return STATUS_INVALID_PARAMETER;
+        type = *(ULONG *)buffer;
+        for (i = 0; i < scanner->pipe_count; i++)
+        {
+            if (type != ALL_PIPE && (int)i != pipe_of_type( scanner, type )) continue;
+            status = code == IOCTL_CANCEL_IO ? abort_pipe( scanner, i ) : reset_pipe( scanner, i );
+        }
+        return status;
+    }
+
+    case IOCTL_WAIT_ON_DEVICE_EVENT:
+        /* the interrupt pipe's next packet */
+        if (scanner->interrupt_in < 0) return STATUS_NOT_SUPPORTED;
+        return start_transfer( scanner, irp, scanner->interrupt_in, buffer, out_size, TRUE );
+
+    case IOCTL_READ_REGISTERS:
+    case IOCTL_WRITE_REGISTERS:
+    case IOCTL_SEND_USB_REQUEST:
+    {
+        BOOL ex = code == IOCTL_SEND_USB_REQUEST, in;
+        struct io_block block;
+        UCHAR request_type, request;
+        ULONG length;
+        BYTE *data;
+
+        if (!get_io_block( irp, buffer, in_size, ex, &block )) return STATUS_INVALID_PARAMETER;
+        if (ex)
+        {
+            in = block.direction_in != 0;
+            request_type = block.request_type | (in ? 0x80 : 0);
+            request = block.request;
+        }
+        else
+        {
+            /* register access: vendor requests to the device, as usbscan's */
+            in = code == IOCTL_READ_REGISTERS;
+            request_type = in ? 0xc0 : 0x40;
+            request = block.length > 1 ? 0x04 : 0x0c;
+        }
+        length = block.length;
+        if (length > 0x10000) return STATUS_INVALID_PARAMETER;
+        if (!(data = ExAllocatePool( NonPagedPool, max( length, 1 ) ))) return STATUS_NO_MEMORY;
+        if (!in)
+        {
+            /* the data to write: at pbyData in the caller, or after the block */
+            if (block.data) status = caller_memory( irp, block.data, data, length, FALSE );
+            else if (in_size >= length) memcpy( data, (BYTE *)buffer + in_size - length, length );
+            else status = STATUS_INVALID_PARAMETER;
+        }
+        if (!status)
+            status = control_request( scanner, request_type, request, block.offset, block.index, data, &length, in );
+        if (!status && in)
+        {
+            /* what was read: the output buffer, or pbyData in the caller */
+            if (out_size)
+            {
+                length = min( length, out_size );
+                memcpy( buffer, data, length );
+                irp->IoStatus.Information = length;
+            }
+            else status = caller_memory( irp, block.data, data, length, TRUE );
+        }
+        else if (!status && !in) irp->IoStatus.Information = length;   /* what was written */
+        ExFreePool( data );
+        return status;
+    }
+    }
+
+    FIXME( "unhandled ioctl %#lx\n", code );
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS WINAPI driver_ioctl( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct scanner *scanner = device->DeviceExtension;
+    NTSTATUS status = scanner->started ? device_ioctl( scanner, irp ) : STATUS_DEVICE_NOT_READY;
+
+    if (status == STATUS_PENDING) return status;
+    irp->IoStatus.Status = status;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return status;
+}
+
+static NTSTATUS WINAPI driver_read_write( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct scanner *scanner = device->DeviceExtension;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    BOOL read = stack->MajorFunction == IRP_MJ_READ;
+    ULONG length = read ? stack->Parameters.Read.Length : stack->Parameters.Write.Length;
+    void *buffer = irp->AssociatedIrp.SystemBuffer ? irp->AssociatedIrp.SystemBuffer : irp->UserBuffer;
+    int pipe = stack->FileObject ? FILE_PIPE( stack->FileObject ) : -1;
+    NTSTATUS status;
+
+    if (!scanner->started) status = STATUS_DEVICE_NOT_READY;
+    else
+    {
+        if (pipe < 0) pipe = read ? scanner->bulk_in : scanner->bulk_out;
+        status = start_transfer( scanner, irp, pipe, buffer, length, read );
+    }
+    if (status == STATUS_PENDING) return status;
+    irp->IoStatus.Status = status;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return status;
+}
+
+/* \\.\UsbscanN, or \\.\UsbscanN\<pipe> for one pipe */
+static NTSTATUS WINAPI driver_create( DEVICE_OBJECT *device, IRP *irp )
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    FILE_OBJECT *file = stack->FileObject;
+    int pipe = -1;
+
+    if (file && file->FileName.Length)
+    {
+        const WCHAR *p = file->FileName.Buffer, *end = p + file->FileName.Length / sizeof(WCHAR);
+        while (p < end && *p == '\\') p++;
+        if (p < end)
+        {
+            pipe = 0;
+            for (; p < end && *p >= '0' && *p <= '9'; p++) pipe = pipe * 10 + *p - '0';
+            if (p != end || pipe >= MAX_NUM_PIPES) pipe = -1;
+        }
+    }
+    if (file) file->FsContext = (void *)(INT_PTR)(pipe + 1);
+    TRACE( "%s: pipe %d.\n", file ? debugstr_wn( file->FileName.Buffer, file->FileName.Length / sizeof(WCHAR) ) : "-", pipe );
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS WINAPI driver_close( DEVICE_OBJECT *device, IRP *irp )
+{
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest( irp, IO_NO_INCREMENT );
+    return STATUS_SUCCESS;
+}
+
+/* the device's descriptors, and its first configuration selected */
+static NTSTATUS start_scanner( struct scanner *scanner )
+{
+    USB_CONFIGURATION_DESCRIPTOR header, *config = NULL;
+    USBD_INTERFACE_LIST_ENTRY list[2] = {{0}};
+    USB_INTERFACE_DESCRIPTOR *iface;
+    NTSTATUS status;
+    ULONG length, i;
+    URB *urb;
+
+    length = sizeof(scanner->device_desc);
+    if ((status = get_descriptor( scanner, USB_DEVICE_DESCRIPTOR_TYPE, 0, 0, &scanner->device_desc, &length )))
+        return status;
+    length = sizeof(header);
+    if ((status = get_descriptor( scanner, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, &header, &length )))
+        return status;
+    if (!(config = ExAllocatePool( NonPagedPool, header.wTotalLength ))) return STATUS_NO_MEMORY;
+    length = header.wTotalLength;
+    if ((status = get_descriptor( scanner, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, config, &length )))
+        goto done;
+
+    if (!(iface = USBD_ParseConfigurationDescriptorEx( config, config, -1, -1, -1, -1, -1 )))
+    {
+        status = STATUS_DEVICE_CONFIGURATION_ERROR;
+        goto done;
+    }
+    list[0].InterfaceDescriptor = iface;
+    if (!(urb = USBD_CreateConfigurationRequestEx( config, list )))
+    {
+        status = STATUS_NO_MEMORY;
+        goto done;
+    }
+    if (!(status = submit_urb_sync( scanner, urb )))
+    {
+        USBD_INTERFACE_INFORMATION *info = list[0].Interface;
+
+        scanner->config = urb->UrbSelectConfiguration.ConfigurationHandle;
+        scanner->pipe_count = min( info->NumberOfPipes, MAX_NUM_PIPES );
+        scanner->bulk_in = scanner->bulk_out = scanner->interrupt_in = -1;
+        for (i = 0; i < scanner->pipe_count; i++)
+        {
+            USBD_PIPE_INFORMATION *pipe = &scanner->pipes[i];
+
+            *pipe = info->Pipes[i];
+            if (pipe->PipeType == UsbdPipeTypeBulk && (pipe->EndpointAddress & 0x80) && scanner->bulk_in < 0)
+                scanner->bulk_in = i;
+            else if (pipe->PipeType == UsbdPipeTypeBulk && !(pipe->EndpointAddress & 0x80) && scanner->bulk_out < 0)
+                scanner->bulk_out = i;
+            else if (pipe->PipeType == UsbdPipeTypeInterrupt && scanner->interrupt_in < 0)
+                scanner->interrupt_in = i;
+        }
+        TRACE( "%04x:%04x: %lu pipes, bulk in %d, bulk out %d, interrupt %d.\n", scanner->device_desc.idVendor,
+               scanner->device_desc.idProduct, scanner->pipe_count, scanner->bulk_in, scanner->bulk_out,
+               scanner->interrupt_in );
+    }
+    ExFreePool( urb );
+
+done:
+    ExFreePool( config );
+    return status;
+}
+
+static NTSTATUS forward_sync( struct scanner *scanner, IRP *irp )
+{
+    KEVENT event;
+
+    KeInitializeEvent( &event, NotificationEvent, FALSE );
+    IoCopyCurrentIrpStackLocationToNext( irp );
+    IoSetCompletionRoutine( irp, sync_completion, &event, TRUE, TRUE, TRUE );
+    if (IoCallDriver( scanner->next, irp ) == STATUS_PENDING)
+        KeWaitForSingleObject( &event, Executive, KernelMode, FALSE, NULL );
+    return irp->IoStatus.Status;
+}
+
+static NTSTATUS WINAPI driver_pnp( DEVICE_OBJECT *device, IRP *irp )
+{
+    struct scanner *scanner = device->DeviceExtension;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation( irp );
+    NTSTATUS status;
+
+    switch (stack->MinorFunction)
+    {
+    case IRP_MN_START_DEVICE:
+        if (!(status = forward_sync( scanner, irp )))
+        {
+            if (!(status = start_scanner( scanner ))) scanner->started = TRUE;
+            else ERR( "the scanner could not be configured: %#lx\n", status );
+        }
+        irp->IoStatus.Status = status;
+        IoCompleteRequest( irp, IO_NO_INCREMENT );
+        return status;
+
+    case IRP_MN_SURPRISE_REMOVAL:
+        scanner->started = FALSE;
+        break;
+
+    case IRP_MN_REMOVE_DEVICE:
+        scanner->started = FALSE;
+        IoDeleteSymbolicLink( &scanner->link );
+        RtlFreeUnicodeString( &scanner->link );
+        IoSkipCurrentIrpStackLocation( irp );
+        status = IoCallDriver( scanner->next, irp );
+        IoDetachDevice( scanner->next );
+        IoDeleteDevice( device );
+        return status;
+    }
+
+    IoSkipCurrentIrpStackLocation( irp );
+    return IoCallDriver( scanner->next, irp );
+}
+
+static NTSTATUS WINAPI driver_add_device( DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo )
+{
+    struct scanner *scanner;
+    DEVICE_OBJECT *fdo;
+    UNICODE_STRING name;
+    WCHAR buffer[32], link[32];
+    NTSTATUS status;
+    int i;
+
+    /* the first free \Device\UsbscanN */
+    for (i = 0; i < 128; i++)
+    {
+        swprintf( buffer, ARRAY_SIZE(buffer), L"\\Device\\Usbscan%d", i );
+        RtlInitUnicodeString( &name, buffer );
+        status = IoCreateDevice( driver, sizeof(*scanner), &name, FILE_DEVICE_USB_SCAN, 0, FALSE, &fdo );
+        if (status != STATUS_OBJECT_NAME_COLLISION) break;
+    }
+    if (status)
+    {
+        ERR( "no device: %#lx\n", status );
+        return status;
+    }
+
+    scanner = fdo->DeviceExtension;
+    memset( scanner, 0, sizeof(*scanner) );
+    scanner->fdo = fdo;
+    scanner->pdo = pdo;
+    scanner->bulk_in = scanner->bulk_out = scanner->interrupt_in = -1;
+    swprintf( link, ARRAY_SIZE(link), L"\\DosDevices\\Usbscan%d", i );
+    RtlCreateUnicodeString( &scanner->link, link );
+    if ((status = IoCreateSymbolicLink( &scanner->link, &name )))
+        ERR( "no link %s: %#lx\n", debugstr_w(link), status );
+    scanner->next = IoAttachDeviceToDeviceStack( fdo, pdo );
+    fdo->Flags &= ~DO_DEVICE_INITIALIZING;
+    TRACE( "pdo %p: %s -> %s.\n", pdo, debugstr_w(link), debugstr_w(buffer) );
+    return STATUS_SUCCESS;
+}
+
+static void WINAPI driver_unload( DRIVER_OBJECT *driver )
+{
+}
+
+NTSTATUS WINAPI DriverEntry( DRIVER_OBJECT *driver, UNICODE_STRING *path )
+{
+    TRACE( "driver %p, path %s.\n", driver, debugstr_w(path->Buffer) );
+
+    driver->MajorFunction[IRP_MJ_CREATE] = driver_create;
+    driver->MajorFunction[IRP_MJ_CLOSE] = driver_close;
+    driver->MajorFunction[IRP_MJ_CLEANUP] = driver_close;
+    driver->MajorFunction[IRP_MJ_READ] = driver_read_write;
+    driver->MajorFunction[IRP_MJ_WRITE] = driver_read_write;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL] = driver_ioctl;
+    driver->MajorFunction[IRP_MJ_PNP] = driver_pnp;
+    driver->DriverExtension->AddDevice = driver_add_device;
+    driver->DriverUnload = driver_unload;
+    return STATUS_SUCCESS;
+}
