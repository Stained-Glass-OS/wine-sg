From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wsdapi: xml text conversion for DATETIME, TIMESPAN, DECIMAL, LIST (3664)

wsdapi: xml text conversion for DATETIME, TIMESPAN, DECIMAL and LIST

xml_text_to_wide_string handles the four remaining WS_XML_TEXT types:
WS_DATETIME ticks become an xs:dateTime (UTC with Z, local with an offset,
no zone for NONE), timespans an xs:duration, DECIMAL its decimal digits,
and a list its items separated by spaces.
---
diff --git a/dlls/wsdapi/soap.c b/dlls/wsdapi/soap.c
index ec61616..8c68b2e 100644
--- a/dlls/wsdapi/soap.c
+++ b/dlls/wsdapi/soap.c
@@ -1259,6 +1259,125 @@ HRESULT send_resolve_matches_message(IWSDiscoveryPublisherImpl *impl, const WSD_
         types_list, scopes_list, xaddrs_list, header_any, ref_param_any, endpoint_ref_any, any, TRUE);
 }
 
+/* Layouts of the WS_XML_TEXT subtypes the public header lacks (MS docs, WS_XML_DECIMAL_TEXT,
+ * WS_XML_TIMESPAN_TEXT, WS_XML_LIST_TEXT). */
+typedef struct { WS_XML_TEXT text; DECIMAL value; } sg_xml_decimal_text;
+typedef struct { WS_XML_TEXT text; LONGLONG ticks; } sg_xml_timespan_text;
+typedef struct { WS_XML_TEXT text; ULONG itemCount; WS_XML_TEXT **items; } sg_xml_list_text;
+
+#define TICKS_PER_SECOND 10000000ULL
+#define TICKS_0001_TO_1601 504911232000000000ULL
+
+/* xs:decimal text of a DECIMAL: the 96-bit magnitude with the decimal point scale digits from the right */
+static void format_decimal(const DECIMAL *dec, WCHAR *buf, size_t len)
+{
+    ULONG w[3] = { dec->Lo32, dec->Mid32, dec->Hi32 };
+    char digits[32];
+    int n = 0, i, scale = dec->scale > 28 ? 28 : dec->scale;
+    WCHAR *p = buf;
+
+    for (;;)
+    {
+        ULONGLONG rem = 0;
+        int k;
+
+        if (!w[0] && !w[1] && !w[2]) break;
+        for (k = 2; k >= 0; k--)
+        {
+            ULONGLONG cur = (rem << 32) | w[k];
+            w[k] = cur / 10;
+            rem = cur % 10;
+        }
+        digits[n++] = '0' + rem;
+    }
+    while (n <= scale) digits[n++] = '0';   /* at least one digit before the point */
+    if (dec->sign & DECIMAL_NEG) *p++ = '-';
+    for (i = n - 1; i >= 0 && (size_t)(p - buf) < len - 2; i--)
+    {
+        *p++ = digits[i];
+        if (i == scale && scale) *p++ = '.';
+    }
+    *p = 0;
+}
+
+/* xs:dateTime from WS_DATETIME ticks (100ns since 0001-01-01); local times carry their UTC offset */
+static BOOL format_datetime(const WS_XML_DATETIME_TEXT *dt, WCHAR *buf, size_t len)
+{
+    SYSTEMTIME st, local;
+    FILETIME ft;
+    ULARGE_INTEGER u;
+    ULONGLONG frac;
+    WCHAR fraction[16] = L"", zone[16] = L"";
+
+    if (dt->value.ticks < TICKS_0001_TO_1601 || dt->value.ticks > 3155378975999999999ULL) return FALSE;
+    u.QuadPart = dt->value.ticks - TICKS_0001_TO_1601;
+    ft.dwLowDateTime = u.LowPart;
+    ft.dwHighDateTime = u.HighPart;
+    if (!FileTimeToSystemTime(&ft, &st)) return FALSE;
+    frac = u.QuadPart % TICKS_PER_SECOND;
+    if (frac)
+    {
+        WCHAR *p;
+        swprintf(fraction, ARRAY_SIZE(fraction), L".%07I64u", frac);
+        for (p = fraction + wcslen(fraction); p[-1] == '0'; p--) p[-1] = 0;
+    }
+    switch (dt->value.format)
+    {
+    case WS_DATETIME_FORMAT_UTC:
+        wcscpy(zone, L"Z");
+        break;
+    case WS_DATETIME_FORMAT_LOCAL:
+    {
+        FILETIME lft;
+        ULARGE_INTEGER lu;
+        LONGLONG diff;
+
+        if (!SystemTimeToTzSpecificLocalTime(NULL, &st, &local) || !SystemTimeToFileTime(&local, &lft)) return FALSE;
+        lu.LowPart = lft.dwLowDateTime;
+        lu.HighPart = lft.dwHighDateTime;
+        diff = ((LONGLONG)lu.QuadPart - (LONGLONG)(u.QuadPart - frac)) / (60 * TICKS_PER_SECOND);
+        st = local;
+        if (!diff) wcscpy(zone, L"Z");
+        else swprintf(zone, ARRAY_SIZE(zone), L"%c%02d:%02d", diff < 0 ? '-' : '+', (int)(llabs(diff) / 60), (int)(llabs(diff) % 60));
+        break;
+    }
+    default:
+        break;
+    }
+    swprintf(buf, len, L"%04d-%02d-%02dT%02d:%02d:%02d%s%s", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute,
+             st.wSecond, fraction, zone);
+    return TRUE;
+}
+
+/* xs:duration from a count of 100ns ticks: [-]P[nD]T[nH][nM][n[.f]S] */
+static void format_timespan(LONGLONG ticks, WCHAR *buf, size_t len)
+{
+    ULONGLONG t = ticks < 0 ? 0 - (ULONGLONG)ticks : (ULONGLONG)ticks, frac = t % TICKS_PER_SECOND;
+    ULONGLONG secs = t / TICKS_PER_SECOND;
+    ULONG days = secs / 86400, hours = secs / 3600 % 24, mins = secs / 60 % 60, sec = secs % 60;
+    WCHAR *p = buf;
+    WCHAR fraction[16] = L"";
+
+    if (frac)
+    {
+        WCHAR *q;
+        swprintf(fraction, ARRAY_SIZE(fraction), L".%07I64u", frac);
+        for (q = fraction + wcslen(fraction); q[-1] == '0'; q--) q[-1] = 0;
+    }
+    if (ticks < 0) *p++ = '-';
+    *p++ = 'P';
+    if (days) p += swprintf(p, len - (p - buf), L"%luD", days);
+    if (hours || mins || sec || frac || !days)
+    {
+        *p++ = 'T';
+        if (hours) p += swprintf(p, len - (p - buf), L"%luH", hours);
+        if (mins) p += swprintf(p, len - (p - buf), L"%luM", mins);
+        if (sec || frac || (!hours && !mins))
+            p += swprintf(p, len - (p - buf), L"%lu%sS", sec, fraction);
+    }
+    *p = 0;
+}
+
 static LPWSTR xml_text_to_wide_string(void *parent_memory, WS_XML_TEXT *text)
 {
     if (text->textType == WS_XML_TEXT_TYPE_UTF8)
@@ -1334,6 +1453,43 @@ static LPWSTR xml_text_to_wide_string(void *parent_memory, WS_XML_TEXT *text)
             str[o] = 0;
             return str;
         }
+        case WS_XML_TEXT_TYPE_DATETIME:
+            if (!format_datetime((const WS_XML_DATETIME_TEXT *) text, buffer, ARRAY_SIZE(buffer))) return NULL;
+            break;
+        case WS_XML_TEXT_TYPE_TIMESPAN:
+            format_timespan(((const sg_xml_timespan_text *) text)->ticks, buffer, ARRAY_SIZE(buffer));
+            break;
+        case WS_XML_TEXT_TYPE_DECIMAL:
+            format_decimal(&((const sg_xml_decimal_text *) text)->value, buffer, ARRAY_SIZE(buffer));
+            break;
+        case WS_XML_TEXT_TYPE_LIST:
+        {
+            const sg_xml_list_text *list = (const sg_xml_list_text *) text;
+            WCHAR **items, *str;
+            size_t total = 1;
+            ULONG i;
+
+            if (!list->itemCount) return duplicate_string(parent_memory, L"");
+            if (!(items = calloc(list->itemCount, sizeof(*items)))) return NULL;
+            for (i = 0; i < list->itemCount; i++)
+            {
+                if (!(items[i] = xml_text_to_wide_string(parent_memory, list->items[i]))) break;
+                total += wcslen(items[i]) + 1;
+            }
+            str = i == list->itemCount ? WSDAllocateLinkedMemory(parent_memory, total * sizeof(WCHAR)) : NULL;
+            if (str)
+            {
+                str[0] = 0;
+                for (i = 0; i < list->itemCount; i++)
+                {
+                    if (i) wcscat(str, L" ");
+                    wcscat(str, items[i]);
+                }
+            }
+            for (i = 0; i < list->itemCount; i++) WSDFreeLinkedMemory(items[i]);
+            free(items);
+            return str;
+        }
         case WS_XML_TEXT_TYPE_QNAME:
         {
             const WS_XML_QNAME_TEXT *q = (const WS_XML_QNAME_TEXT *) text;
