     return NS_E_INVALID_NAME;
 }
 
+static const GUID asf_header_object;
+
+/* An ASF stream starts with the header object. */
+HRESULT WINAPI WMValidateData(BYTE *data, DWORD *size)
+{
+    TRACE("(%p, %p)\n", data, size);
+
+    if (!size)
+        return E_INVALIDARG;
+    if (!data || *size < sizeof(GUID))
+    {
+        *size = sizeof(GUID);
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    if (memcmp(data, &asf_header_object, sizeof(GUID)))
+        return NS_E_INVALID_DATA;
+    return S_OK;
+}
+
+/* Local files (paths or file: URLs) that exist play offline; anything reached over a network does not. */
+HRESULT WINAPI WMIsAvailableOffline(const WCHAR *url, const WCHAR *language, BOOL *available)
+{
+    const WCHAR *path = url;
+    WCHAR buffer[MAX_PATH];
+    DWORD len = ARRAY_SIZE(buffer);
+
+    TRACE("(%s, %s, %p)\n", debugstr_w(url), debugstr_w(language), available);
+
+    if (!url || !available)
+        return E_INVALIDARG;
+
+    *available = FALSE;
+    if (!_wcsnicmp(url, L"file:", 5))
+    {
+        if (FAILED(PathCreateFromUrlW(url, buffer, &len, 0)))
+            return S_OK;
+        path = buffer;
+    }
+    else if (wcsstr(url, L"://"))
+        return S_OK;
+
+    *available = GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES;
+    return S_OK;
+}
