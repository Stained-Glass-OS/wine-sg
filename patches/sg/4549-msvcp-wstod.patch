From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp140: Implement the wide _WStod family and __Wcrtomb_lk.

msvcp140's wide string to floating point conversions _WStod, _WStodx,
_WStof, _WStofx, _WStold and _WStoldx, the wide forms of _Stod and its
family (the number times ten to the given power; the "x" forms return
the conversion's error code and keep errno), and __Wcrtomb_lk, _Wcrtomb
without the locale lock. msvcp_win forwards.
---
 dlls/msvcp140/msvcp140.spec   | 14 ++++++------
 dlls/msvcp90/locale.c         | 53 +++++++++++++++++++++++++++++++++++++++++++
 dlls/msvcp_win/msvcp_win.spec | 14 ++++++------
 3 files changed, 67 insertions(+), 14 deletions(-)

diff --git a/dlls/msvcp140/msvcp140.spec b/dlls/msvcp140/msvcp140.spec
index 0e44020..3e22f86 100644
--- a/dlls/msvcp140/msvcp140.spec
+++ b/dlls/msvcp140/msvcp140.spec
@@ -3740,19 +3740,19 @@
 @ cdecl _Towupper(long ptr)
 @ cdecl _Unlink(wstr) tr2_sys__Unlink_wchar
 @ cdecl _Unlock_shared_ptr_spin_lock()
-@ stub _WStod
-@ stub _WStodx
-@ stub _WStof
-@ stub _WStofx
-@ stub _WStold
-@ stub _WStoldx
+@ cdecl _WStod(ptr ptr long)
+@ cdecl _WStodx(ptr ptr long ptr)
+@ cdecl _WStof(ptr ptr long)
+@ cdecl _WStofx(ptr ptr long ptr)
+@ cdecl _WStold(ptr ptr long) _WStod
+@ cdecl _WStoldx(ptr ptr long ptr) _WStodx
 @ cdecl _Wcrtomb(ptr long ptr ptr)
 @ cdecl _Wcscoll(ptr ptr ptr ptr ptr)
 @ cdecl _Wcsxfrm(ptr ptr ptr ptr ptr)
 @ cdecl _Xtime_diff_to_millis(ptr) _Xtime_diff_to_millis
 @ cdecl _Xtime_diff_to_millis2(ptr ptr) _Xtime_diff_to_millis2
 @ cdecl -ret64 _Xtime_get_ticks() _Xtime_get_ticks
-@ stub __Wcrtomb_lk
+@ cdecl __Wcrtomb_lk(ptr long ptr ptr)
 @ cdecl __crtCloseThreadpoolTimer(ptr) MSVCP__crtCloseThreadpoolTimer
 @ cdecl __crtCloseThreadpoolWait(ptr) MSVCP__crtCloseThreadpoolWait
 @ cdecl __crtCompareStringA(long long str long str long) msvcrt.__crtCompareStringA
diff --git a/dlls/msvcp90/locale.c b/dlls/msvcp90/locale.c
index 07af0b3..7717550 100644
--- a/dlls/msvcp90/locale.c
+++ b/dlls/msvcp90/locale.c
@@ -5047,6 +5047,17 @@ int __cdecl _Wcrtomb(char *s, wchar_t wch, _Mbstatet *state, const _Cvtvec *cvt)
     return size;
 }
 
+#if _MSVCP_VER >= 140
+/* __Wcrtomb_lk: _Wcrtomb, without taking the locale lock */
+int __cdecl __Wcrtomb_lk(char *s, wchar_t wch, _Mbstatet *state, const _Cvtvec *cvt)
+{
+#ifdef SG_MUTANT_WCRTOMB_LK_NO_CVT
+    return _Wcrtomb(s, wch, state, NULL);
+#endif
+    return _Wcrtomb(s, wch, state, cvt);
+}
+#endif
+
 /* ?_Donarrow@?$ctype@_W@std@@IBED_WD@Z */
 /* ?_Donarrow@?$ctype@_W@std@@IEBAD_WD@Z */
 /* ?_Donarrow@?$ctype@G@std@@IBEDGD@Z */
@@ -8153,6 +8164,48 @@ float __cdecl _Stofx(const char *buf, char **buf_end, LONG exp, int *err)
     return _Stodx(buf, buf_end, exp, err);
 }
 
+#if _MSVCP_VER >= 140
+/* _WStod, _WStold */
+double __cdecl _WStod(const wchar_t *buf, wchar_t **buf_end, LONG exp)
+{
+    double ret = wcstod(buf, buf_end);
+
+#ifdef SG_MUTANT_WSTOD_NO_EXP
+    return ret;
+#endif
+    if(exp)
+        ret *= pow(10, exp);
+    return ret;
+}
+
+/* _WStodx, _WStoldx */
+double __cdecl _WStodx(const wchar_t *buf, wchar_t **buf_end, LONG exp, int *err)
+{
+    double ret;
+
+    *err = *_errno();
+    *_errno() = 0;
+    ret = _WStod(buf, buf_end, exp);
+    if(*_errno()) {
+        *err = *_errno();
+    }else {
+        *_errno() = *err;
+        *err = 0;
+    }
+    return ret;
+}
+
+float __cdecl _WStof(const wchar_t *buf, wchar_t **buf_end, LONG exp)
+{
+    return _WStod(buf, buf_end, exp);
+}
+
+float __cdecl _WStofx(const wchar_t *buf, wchar_t **buf_end, LONG exp, int *err)
+{
+    return _WStodx(buf, buf_end, exp, err);
+}
+#endif
+
 __int64 __cdecl _Stoll(const char *buf, char **buf_end, int base)
 {
     return _strtoi64(buf, buf_end, base);
diff --git a/dlls/msvcp_win/msvcp_win.spec b/dlls/msvcp_win/msvcp_win.spec
