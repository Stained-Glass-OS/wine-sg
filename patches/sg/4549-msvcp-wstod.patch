 @ cdecl _Unlink(wstr) msvcp140._Unlink
 @ cdecl _Unlock_shared_ptr_spin_lock() msvcp140._Unlock_shared_ptr_spin_lock
-@ stub _WStod
-@ stub _WStodx
-@ stub _WStof
-@ stub _WStofx
-@ stub _WStold
-@ stub _WStoldx
+@ cdecl _WStod(ptr ptr long) msvcp140._WStod
+@ cdecl _WStodx(ptr ptr long ptr) msvcp140._WStodx
+@ cdecl _WStof(ptr ptr long) msvcp140._WStof
+@ cdecl _WStofx(ptr ptr long ptr) msvcp140._WStofx
+@ cdecl _WStold(ptr ptr long) msvcp140._WStold
+@ cdecl _WStoldx(ptr ptr long ptr) msvcp140._WStoldx
 @ cdecl _Wcrtomb(ptr long ptr ptr) msvcp140._Wcrtomb
 @ cdecl _Wcscoll(ptr ptr ptr ptr ptr) msvcp140._Wcscoll
 @ cdecl _Wcsxfrm(ptr ptr ptr ptr ptr) msvcp140._Wcsxfrm
 @ cdecl _Xtime_diff_to_millis(ptr) msvcp140._Xtime_diff_to_millis
 @ cdecl _Xtime_diff_to_millis2(ptr ptr) msvcp140._Xtime_diff_to_millis2
 @ cdecl -ret64 _Xtime_get_ticks() msvcp140._Xtime_get_ticks
-@ stub __Wcrtomb_lk
+@ cdecl __Wcrtomb_lk(ptr long ptr ptr) msvcp140.__Wcrtomb_lk
 @ cdecl __crtCompareStringA(long long str long str long) msvcp140.__crtCompareStringA
 @ cdecl __crtCompareStringW(long long wstr long wstr long) msvcp140.__crtCompareStringW
 @ cdecl __crtLCMapStringA(long long str long ptr long long long) msvcp140.__crtLCMapStringA
