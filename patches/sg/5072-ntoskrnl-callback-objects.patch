From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl.exe: Implement callback objects.

Callback objects: ExCreateCallback opens a named callback object or makes one
(a name is required: STATUS_UNSUCCESSFUL without; STATUS_OBJECT_NAME_NOT_FOUND
when it does not exist and Create is FALSE), and the system's
\Callback\SetSystemTime, \Callback\PowerState and \Callback\ProcessorAdd
always open. ExRegisterCallback adds a routine (NULL when the object takes
one and has it), ExUnregisterCallback removes it (also from inside the
routine), ExNotifyCallback calls each with its context and both arguments.
They were stubs: ExCreateCallback returned success without an object.

Gate: test/ntoskrnl-callback-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c | 179 +++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 173 insertions(+), 6 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index d46bd48..0c4215f 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2348,29 +2348,164 @@ PVOID WINAPI ExAllocatePoolWithQuotaTag( POOL_TYPE type, SIZE_T size, ULONG tag
     return ExAllocatePool2( flags, size, tag );
 }
 
+/* callback objects: named, kept for the life of the process (as the system's own
+ * \Callback objects are, and as OBJ_PERMANENT asks); each registration holds a
+ * reference to its object */
+struct callback_object
+{
+    UNICODE_STRING name;
+    BOOLEAN allow_multiple;
+    struct list registrations;
+    struct list entry;
+};
+
+struct callback_registration
+{
+    struct list entry;
+    struct callback_object *object;
+    PCALLBACK_FUNCTION function;
+    void *context;
+    unsigned int busy;   /* calls under way, under callback_cs */
+    BOOL removed;
+};
+
+static struct list callback_objects = LIST_INIT( callback_objects );
+static CRITICAL_SECTION callback_cs;
+static CRITICAL_SECTION_DEBUG callback_cs_debug =
+{
+    0, 0, &callback_cs,
+    { &callback_cs_debug.ProcessLocksList, &callback_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": callback_cs") }
+};
+static CRITICAL_SECTION callback_cs = { &callback_cs_debug, -1, 0, 0, 0, 0 };
+
+static const WCHAR callback_type_name[] = {'C','a','l','l','b','a','c','k',0};
+
+static struct _OBJECT_TYPE callback_type =
+{
+    callback_type_name,
+};
+
+/* the callback objects the system makes for drivers */
+static const WCHAR *const system_callbacks[] =
+{
+    L"\\Callback\\SetSystemTime",
+    L"\\Callback\\PowerState",
+    L"\\Callback\\ProcessorAdd",
+};
+
+static struct callback_object *create_callback_object( const UNICODE_STRING *name, BOOLEAN allow_multiple )
+{
+    struct callback_object *object;
+
+    /* two references: the name's, which keeps it, and the caller's */
+    if (!(object = alloc_kernel_object( &callback_type, NULL, sizeof(*object), 2 ))) return NULL;
+    if (!(object->name.Buffer = ExAllocatePool( NonPagedPool, name->Length )))
+    {
+        HeapFree( GetProcessHeap(), 0, (struct object_header *)object - 1 );
+        return NULL;
+    }
+    memcpy( object->name.Buffer, name->Buffer, name->Length );
+    object->name.Length = object->name.MaximumLength = name->Length;
+    object->allow_multiple = allow_multiple;
+    list_init( &object->registrations );
+    list_add_tail( &callback_objects, &object->entry );
+    return object;
+}
+
 /***********************************************************************
  *           ExCreateCallback   (NTOSKRNL.EXE.@)
  */
 NTSTATUS WINAPI ExCreateCallback(PCALLBACK_OBJECT *obj, POBJECT_ATTRIBUTES attr,
                                  BOOLEAN create, BOOLEAN allow_multiple)
 {
-    FIXME("(%p, %p, %u, %u): stub\n", obj, attr, create, allow_multiple);
+    struct callback_object *object;
+    UNICODE_STRING system_name;
+    NTSTATUS status = STATUS_SUCCESS;
+    unsigned int i;
 
-    return STATUS_SUCCESS;
+    TRACE("(%p, %p, %u, %u)\n", obj, attr, create, allow_multiple);
+
+    /* unnamed callback objects are not permitted */
+    if (!attr || !attr->ObjectName || !attr->ObjectName->Length) return STATUS_UNSUCCESSFUL;
+
+    EnterCriticalSection( &callback_cs );
+    LIST_FOR_EACH_ENTRY( object, &callback_objects, struct callback_object, entry )
+    {
+        if (RtlEqualUnicodeString( &object->name, attr->ObjectName, TRUE ))
+        {
+            ObReferenceObject( object );
+            *obj = (PCALLBACK_OBJECT)object;
+            LeaveCriticalSection( &callback_cs );
+            return STATUS_SUCCESS;
+        }
+    }
+    for (i = 0; i < ARRAY_SIZE(system_callbacks); i++)
+    {
+        RtlInitUnicodeString( &system_name, system_callbacks[i] );
+        if (RtlEqualUnicodeString( &system_name, attr->ObjectName, TRUE ))
+        {
+            create = TRUE;
+            allow_multiple = TRUE;
+        }
+    }
+    if (!create) status = STATUS_OBJECT_NAME_NOT_FOUND;
+    else if (!(object = create_callback_object( attr->ObjectName, allow_multiple ))) status = STATUS_NO_MEMORY;
+    else *obj = (PCALLBACK_OBJECT)object;
+    LeaveCriticalSection( &callback_cs );
+    return status;
 }
 
+/***********************************************************************
+ *           ExRegisterCallback   (NTOSKRNL.EXE.@)
+ */
 void * WINAPI ExRegisterCallback(PCALLBACK_OBJECT callback_object,
         PCALLBACK_FUNCTION callback_function, void *callback_context)
 {
-    FIXME("callback_object %p, callback_function %p, callback_context %p stub.\n",
+    struct callback_object *object = (struct callback_object *)callback_object;
+    struct callback_registration *reg = NULL;
+
+    TRACE("callback_object %p, callback_function %p, callback_context %p.\n",
             callback_object, callback_function, callback_context);
 
-    return (void *)0xdeadbeef;
+    EnterCriticalSection( &callback_cs );
+#ifndef SG_MUTANT_CALLBACK_MULTIPLE
+    if (!object->allow_multiple && !list_empty( &object->registrations ))
+        WARN( "%s takes one callback routine\n", debugstr_us( &object->name ) );
+    else
+#endif
+    if ((reg = ExAllocatePool( NonPagedPool, sizeof(*reg) )))
+    {
+        reg->object = object;
+        reg->function = callback_function;
+        reg->context = callback_context;
+        reg->busy = 0;
+        reg->removed = FALSE;
+        ObReferenceObject( object );
+        list_add_tail( &object->registrations, &reg->entry );
+    }
+    LeaveCriticalSection( &callback_cs );
+    return reg;
 }
 
+/***********************************************************************
+ *           ExUnregisterCallback   (NTOSKRNL.EXE.@)
+ */
 void WINAPI ExUnregisterCallback(void *callback_registration)
 {
-    FIXME("callback_registration %p stub.\n", callback_registration);
+    struct callback_registration *reg = callback_registration;
+
+    TRACE("callback_registration %p.\n", callback_registration);
+
+    EnterCriticalSection( &callback_cs );
+    list_remove( &reg->entry );
+    reg->removed = TRUE;
+    /* a notification calling it now (it may be unregistering itself) frees it after the call */
+    if (reg->busy) reg = NULL;
+    LeaveCriticalSection( &callback_cs );
+    if (!reg) return;
+    ObDereferenceObject( reg->object );
+    ExFreePool( reg );
 }
 
 /***********************************************************************
@@ -2378,7 +2513,39 @@ void WINAPI ExUnregisterCallback(void *callback_registration)
  */
 void WINAPI ExNotifyCallback(void *obj, void *arg1, void *arg2)
 {
-    FIXME("(%p, %p, %p): stub\n", obj, arg1, arg2);
+    struct callback_object *object = obj;
+    struct callback_registration *reg, **regs = NULL;
+    unsigned int count = 0, i;
+
+    TRACE("(%p, %p, %p)\n", obj, arg1, arg2);
+
+    /* call each routine registered now, outside the lock: one may unregister itself */
+    EnterCriticalSection( &callback_cs );
+    if ((regs = malloc( list_count( &object->registrations ) * sizeof(*regs) + 1 )))
+    {
+        LIST_FOR_EACH_ENTRY( reg, &object->registrations, struct callback_registration, entry )
+        {
+            reg->busy++;
+            regs[count++] = reg;
+        }
+    }
+    LeaveCriticalSection( &callback_cs );
+
+    for (i = 0; i < count; i++)
+    {
+        BOOL done;
+
+        regs[i]->function( regs[i]->context, arg1, arg2 );
+        EnterCriticalSection( &callback_cs );
+        done = !--regs[i]->busy && regs[i]->removed;
+        LeaveCriticalSection( &callback_cs );
+        if (done)
+        {
+            ObDereferenceObject( regs[i]->object );
+            ExFreePool( regs[i] );
+        }
+    }
+    free( regs );
 }
 
 /***********************************************************************
