+@ thiscall -arch=i386 ?ReleaseTarget@ControlBlock@Details@Platform@@AAEXXZ(ptr) ControlBlock_ReleaseTarget_thiscall
+@ thiscall -arch=i386 ??0Delegate@Platform@@Q$AAE@XZ(ptr) Delegate_ctor_thiscall
