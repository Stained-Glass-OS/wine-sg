+@ cdecl -arch=i386 ?Free@Heap@Details@Platform@@SAXPAX@Z(ptr) Heap_Free
+@ stdcall -arch=i386 ?Free@Heap@Details@Platform@@SGXPAX@Z(ptr) Heap_Free_stdcall
+@ cdecl -arch=i386 ?AlignedFree@Heap@Details@Platform@@SAXPAX@Z(ptr) Heap_AlignedFree
