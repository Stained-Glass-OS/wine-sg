From: Stained Glass OS <dev@stained-glass.example>
Subject: Draw the caption buttons flat, in the Windows 10 manner

Wine draws the minimize, maximize/restore and close buttons as classic 3D push
buttons with Marlett glyphs, and its visual-style support never reaches the
title bar, so no theme can change them. Next to the flat white captions the
Stained Glass palette gives, they are the most dated thing left on a window.

Draw them flat instead, in dlls/win32u/defwnd.c: the caption colour behind a
thin line glyph (a line, a square, two overlapping squares, an X) in the
caption text colour, and a solid fill while pressed -- red for Close. Colours
come from the system palette, so the buttons follow whatever scheme is set.
Only the window's own caption buttons change: the public
DrawFrameControl(DFC_CAPTION) is user32's separate copy and keeps the classic
look for applications that draw with it. The Help button keeps its classic
glyph.

Forwarded: not-needed
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1449,6 +1449,100 @@
     return retval;
 }
 
+/* Stained Glass OS: flat, Windows-10-style caption buttons -- no 3D frame,
+ * the caption colour behind a thin line glyph, and a solid fill while pressed
+ * (red for Close). Only the window's own caption buttons change: the public
+ * DrawFrameControl(DFC_CAPTION) is user32's separate copy and keeps the
+ * classic look for applications that draw with it. */
+#define SG_CAPBTN_PRESSED        RGB(0xCC,0xCC,0xCC)
+#define SG_CAPBTN_CLOSE_PRESSED  RGB(0xC4,0x2B,0x1C)
+
+static void sg_draw_caption_button( HWND hwnd, HDC hdc, const RECT *r, UINT flags )
+{
+    BOOL active = (win_get_flags( hwnd ) & WIN_NCACTIVATED) != 0;
+    BOOL pushed = (flags & DFCS_PUSHED) != 0;
+    BOOL grayed = (flags & DFCS_INACTIVE) != 0;
+    UINT kind = flags & 0xf;
+    int w = r->right - r->left, h = r->bottom - r->top;
+    int g = min( w, h ) * 2 / 5;                   /* glyph box */
+    int lw = max( 1, (int)get_dpi_for_window( hwnd ) / 96 );
+    int x0, y0;
+    COLORREF bg, fg;
+    HBRUSH brush;
+    HPEN pen, prev_pen;
+    POINT pts[10];
+    ULONG counts[2];
+
+    if (kind > DFCS_CAPTIONRESTORE)   /* Help: no flat glyph, keep the classic one */
+    {
+        RECT rc = *r;
+        draw_frame_caption( hdc, &rc, flags );
+        return;
+    }
+
+    bg = get_sys_color( active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION );
+    fg = get_sys_color( grayed ? COLOR_GRAYTEXT :
+                        active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT );
+    if (pushed && !grayed)
+    {
+        if (kind == DFCS_CAPTIONCLOSE) { bg = SG_CAPBTN_CLOSE_PRESSED; fg = RGB(0xFF,0xFF,0xFF); }
+        else bg = SG_CAPBTN_PRESSED;
+    }
+    brush = NtGdiCreateSolidBrush( bg, NULL );
+    fill_rect( hdc, r, brush );
+    NtGdiDeleteObjectApp( brush );
+
+    if (g < 6) g = 6;
+    x0 = r->left + (w - g) / 2;
+    y0 = r->top  + (h - g) / 2;
+
+    pen = NtGdiCreatePen( PS_SOLID, lw, fg, NULL );
+    prev_pen = NtGdiSelectPen( hdc, pen );
+    switch (kind)
+    {
+    case DFCS_CAPTIONCLOSE:     /* an X; a polyline omits its last pixel, hence +1 */
+        pts[0].x = x0;     pts[0].y = y0;     pts[1].x = x0 + g + 1; pts[1].y = y0 + g + 1;
+        pts[2].x = x0 + g; pts[2].y = y0;     pts[3].x = x0 - 1;     pts[3].y = y0 + g + 1;
+        counts[0] = counts[1] = 2;
+        NtGdiPolyPolyDraw( hdc, pts, counts, 2, NtGdiPolyPolyline );
+        break;
+    case DFCS_CAPTIONMAX:       /* a square */
+        pts[0].x = x0;     pts[0].y = y0;     pts[1].x = x0 + g; pts[1].y = y0;
+        pts[2].x = x0 + g; pts[2].y = y0 + g; pts[3].x = x0;     pts[3].y = y0 + g;
+        pts[4] = pts[0];
+        counts[0] = 5;
+        NtGdiPolyPolyDraw( hdc, pts, counts, 1, NtGdiPolyPolyline );
+        break;
+    case DFCS_CAPTIONRESTORE:   /* two overlapping squares */
+    {
+        int d = g / 4 + 1, s = g - d;
+        /* the back square shows only its top and right edges */
+        pts[0].x = x0 + d;     pts[0].y = y0 + d;
+        pts[1].x = x0 + d;     pts[1].y = y0;
+        pts[2].x = x0 + g;     pts[2].y = y0;
+        pts[3].x = x0 + g;     pts[3].y = y0 + s;
+        pts[4].x = x0 + s;     pts[4].y = y0 + s;
+        /* the front square, whole */
+        pts[5].x = x0;         pts[5].y = y0 + d;
+        pts[6].x = x0 + s;     pts[6].y = y0 + d;
+        pts[7].x = x0 + s;     pts[7].y = y0 + g;
+        pts[8].x = x0;         pts[8].y = y0 + g;
+        pts[9] = pts[5];
+        counts[0] = counts[1] = 5;
+        NtGdiPolyPolyDraw( hdc, pts, counts, 2, NtGdiPolyPolyline );
+        break;
+    }
+    case DFCS_CAPTIONMIN:       /* a line */
+        pts[0].x = x0;         pts[0].y = y0 + g / 2;
+        pts[1].x = x0 + g + 1; pts[1].y = y0 + g / 2;
+        counts[0] = 2;
+        NtGdiPolyPolyDraw( hdc, pts, counts, 1, NtGdiPolyPolyline );
+        break;
+    }
+    NtGdiSelectPen( hdc, prev_pen );
+    NtGdiDeleteObjectApp( pen );
+}
+
 static void draw_close_button( HWND hwnd, HDC hdc, BOOL down, BOOL grayed )
 {
     RECT rect;
@@ -1482,7 +1576,7 @@
 
     if (down) flags |= DFCS_PUSHED;
     if (grayed) flags |= DFCS_INACTIVE;
-    draw_frame_caption( hdc, &rect, flags );
+    sg_draw_caption_button( hwnd, hdc, &rect, flags );
 }
 
 static void draw_max_button( HWND hwnd, HDC hdc, BOOL down, BOOL grayed )
@@ -1505,7 +1599,7 @@
     rect.right -= 2;
     if (down) flags |= DFCS_PUSHED;
     if (grayed) flags |= DFCS_INACTIVE;
-    draw_frame_caption( hdc, &rect, flags );
+    sg_draw_caption_button( hwnd, hdc, &rect, flags );
 }
 
 static void draw_min_button( HWND hwnd, HDC hdc, BOOL down, BOOL grayed )
@@ -1531,7 +1625,7 @@
     rect.right -= 2;
     if (down) flags |= DFCS_PUSHED;
     if (grayed) flags |= DFCS_INACTIVE;
-    draw_frame_caption( hdc, &rect, flags );
+    sg_draw_caption_button( hwnd, hdc, &rect, flags );
 }
 
