diff --git a/dlls/sensapi/sensapi.c b/dlls/sensapi/sensapi.c
index 7305227..547d7e6 100644
--- a/dlls/sensapi/sensapi.c
+++ b/dlls/sensapi/sensapi.c
@@ -27,6 +27,10 @@
 #define COBJMACROS
 
 #include "windef.h"
+#include "winbase.h"
+#include "winsock2.h"
+#include "ws2tcpip.h"
+#include "iphlpapi.h"
 #include "sensevts.h"
 #include "sensapi.h"
 
@@ -34,15 +38,67 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(sensapi);
 
+/* Stained Glass OS: a destination (a host name or an address) is reachable when it resolves and the
+ * routing table has an interface for it; the speed of that interface goes to the QOC info (GUESS: Windows
+ * measures; the link speed is what the interface says). */
+static BOOL destination_reachable(const WCHAR *dest, QOCINFO *qoc)
+{
+    ADDRINFOW hints = {0}, *res, *cur;
+    WSADATA data;
+    BOOL ret = FALSE;
+
+    if (!dest || (qoc && qoc->dwSize != sizeof(*qoc)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (WSAStartup(MAKEWORD(2, 2), &data)) return FALSE;
+    hints.ai_family = AF_UNSPEC;
+    if (!GetAddrInfoW(dest, NULL, &hints, &res))
+    {
+        for (cur = res; cur && !ret; cur = cur->ai_next)
+        {
+            DWORD index;
+            MIB_IFROW row;
+
+            if (GetBestInterfaceEx(cur->ai_addr, &index)) continue;
+            ret = TRUE;
+            if (qoc)
+            {
+                memset(&row, 0, sizeof(row));
+                row.dwIndex = index;
+                qoc->dwFlags = NETWORK_ALIVE_LAN;
+                qoc->dwInSpeed = qoc->dwOutSpeed = GetIfEntry(&row) ? 0 : row.dwSpeed;
+            }
+        }
+        FreeAddrInfoW(res);
+    }
+    WSACleanup();
+    if (!ret) SetLastError(ERROR_NETWORK_UNREACHABLE);
+    return ret;
+}
+
 BOOL WINAPI IsDestinationReachableA(LPCSTR lpszDestination, LPQOCINFO lpQOCInfo)
 {
-    FIXME("%s,%p\n", lpszDestination, lpQOCInfo);
-    return TRUE;
+    WCHAR *dest = NULL;
+    BOOL ret;
+
+    TRACE("%s,%p\n", debugstr_a(lpszDestination), lpQOCInfo);
+    if (lpszDestination)
+    {
+        int len = MultiByteToWideChar(CP_ACP, 0, lpszDestination, -1, NULL, 0);
+        if (!(dest = HeapAlloc(GetProcessHeap(), 0, len * sizeof(WCHAR)))) return FALSE;
+        MultiByteToWideChar(CP_ACP, 0, lpszDestination, -1, dest, len);
+    }
+    ret = destination_reachable(dest, lpQOCInfo);
+    HeapFree(GetProcessHeap(), 0, dest);
+    return ret;
 }
+
 BOOL WINAPI IsDestinationReachableW(LPCWSTR lpszDestination, LPQOCINFO lpQOCInfo)
 {
-    FIXME("%s,%p\n", debugstr_w(lpszDestination), lpQOCInfo);
-    return TRUE;
+    TRACE("%s,%p\n", debugstr_w(lpszDestination), lpQOCInfo);
+    return destination_reachable(lpszDestination, lpQOCInfo);
 }
 
 BOOL WINAPI IsNetworkAlive(LPDWORD lpdwFlags)
