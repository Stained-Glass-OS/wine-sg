From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: Win+Shift+S and Print Screen, screen snipping

Windows opens screen snipping with Win+Shift+S, and Windows 11 with Print
Screen too, unless "Use the Print screen key to open screen snipping" is
off (HKCU\Control Panel\Keyboard PrintScreenKeyForSnippingEnabled = 0).
Explorer runs ShellExecute("snippingtool.exe", "/clip"), which App Paths
resolves to sg-shell's Snipping Tool.

Gate: test/handoff-gate.sh.
---
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -4,7 +4,8 @@
  * The Windows key alone opens Start. Win+D shows the desktop (and puts the
  * windows back), Win+M minimizes all, Win+Shift+M restores them, Win+E opens
  * File Explorer, Win+R Run, Win+I settings (the Control Panel), Win+Pause
- * System, Win+X the quick-link menu, Win+H voice typing (sg-dictate.exe /toggle); Win+Left/Right snap the active window
+ * System, Win+X the quick-link menu, Win+H voice typing (sg-dictate.exe /toggle), Win+Shift+S and
+ * Print Screen screen snipping (snippingtool.exe /clip); Win+Left/Right snap the active window
  * to half the screen, Win+Up maximizes it, Win+Down restores or minimizes it.
  * Dragging a window to the left or right edge snaps it to that half, to the
  * top edge maximizes it, with an outline of where it will go (Aero Snap),
@@ -33,6 +34,7 @@
 #include "winbase.h"
 #include "wingdi.h"
 #include "winuser.h"
+#include "winreg.h"
 #include "shellapi.h"
 #include "wine/debug.h"
 #include "explorer_private.h"
@@ -44,7 +46,7 @@
 #endif
 
 enum { SK_DESKTOP = 0x5700, SK_MINIMIZE_ALL, SK_RESTORE_ALL, SK_EXPLORER, SK_RUN, SK_SETTINGS, SK_SYSTEM,
-       SK_QUICKLINK, SK_SNAP_LEFT, SK_SNAP_RIGHT, SK_MAXIMIZE, SK_DOWN, SK_DICTATE, SK_LAST };
+       SK_QUICKLINK, SK_SNAP_LEFT, SK_SNAP_RIGHT, SK_MAXIMIZE, SK_DOWN, SK_DICTATE, SK_SNIP, SK_SNIP_PRTSC, SK_LAST };
 
 static HWND sk_tray;
 static HHOOK sk_hook;
@@ -389,6 +391,11 @@
         /* voice typing (sg-shell's sg-dictate, found through App Paths) */
         run( L"sg-dictate.exe", L"/toggle" );
         return TRUE;
+    case SK_SNIP:
+    case SK_SNIP_PRTSC:
+        /* screen snipping (sg-shell's Snipping Tool, through App Paths) */
+        run( L"snippingtool.exe", L"/clip" );
+        return TRUE;
     }
     return FALSE;
 }
@@ -442,6 +449,15 @@
     RegisterHotKey( tray, SK_MAXIMIZE, MOD_WIN, VK_UP );
     RegisterHotKey( tray, SK_DOWN, MOD_WIN, VK_DOWN );
     RegisterHotKey( tray, SK_DICTATE, MOD_WIN | MOD_NOREPEAT, 'H' );
+    RegisterHotKey( tray, SK_SNIP, MOD_WIN | MOD_SHIFT | MOD_NOREPEAT, 'S' );
+    /* Print Screen opens screen snipping, as Windows 11 does, unless "Use the
+     * Print screen key to open screen snipping" is turned off */
+    {
+        DWORD on = 1, size = sizeof(on);
+        RegGetValueW( HKEY_CURRENT_USER, L"Control Panel\\Keyboard", L"PrintScreenKeyForSnippingEnabled",
+                      RRF_RT_REG_DWORD, NULL, &on, &size );
+        if (on) RegisterHotKey( tray, SK_SNIP_PRTSC, MOD_NOREPEAT, VK_SNAPSHOT );
+    }
     sk_hook = SetWindowsHookExW( WH_KEYBOARD_LL, win_key_proc, GetModuleHandleW( NULL ), 0 );
     {
         WNDCLASSW wc = { 0 };
