From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] unidrv: a plug-in's band is a DIB, the printer's bits are ink

A label made by DYMO Connect through DYMO's LabelWriter 550 driver (0921)
came out as its negative: the bitmap a render plug-in's ImageProcessing
returns is a DIB, a set bit white, while the 550's raster (as every
printer's) sets a bit for ink -- DYMO's open Linux driver for the 550 says
so, and the plug-in's own FilterGraphics clears the column past the label's
printable width to 0, paper. A one-bit band from the plug-in is now turned
into ink before FilterGraphics or the GPD's raster commands send it. The
plug-in is also given rows that end on a whole DWORD of the printer's bits,
the columns past the page paper, so the last byte sent has no bits the
plug-in was not given (a 271-dot label otherwise ended in a dark column).

The printdrv gate's plug-in returns its band as a DIB and counts the dark
pixels it is given (mutants BANDPAD, MONOINVERT).
---
--- a/dlls/unidrv/ddi.c
+++ b/dlls/unidrv/ddi.c
@@ -301,7 +301,7 @@
     const BYTE *bits = so->pvScan0;
     int stride = so->lDelta, w = so->sizlBitmap.cx, h = rows;
     BYTE *rotated = NULL, *dithered = NULL, *result = NULL;
-    int bytespp = pdev->drv_bpp / 8, out_stride, out_bytes;
+    int bytespp = pdev->drv_bpp / 8, out_stride, out_bytes, send_w;
     POINT offset = { origin.x, origin.y };
 
     if (pdev->landscape && bytespp)
@@ -315,6 +315,33 @@
         offset.x = offset.y = 0;
     }
 
+    send_w = w;
+    if (pdev->drv_bpp >= 24 && pdev->oem.uni && pdev->oem.has_image_processing && pdev->ip_callback >= 0)
+    {
+        /* the plug-in is given rows that end on a whole DWORD of device
+         * bits, the columns past the page paper, so the last byte sent has
+         * no bits the plug-in was not given */
+        int pad_w = (w * pdev->dev_bpp + 31) / 32 * 32 / pdev->dev_bpp, y;
+        int pad_stride = (pad_w * bytespp + 3) & ~3;
+        BYTE *padded = malloc( (SIZE_T)pad_stride * h );
+        if (!padded) goto done;
+        for (y = 0; y < h; y++)
+        {
+#ifdef SG_MUTANT_BANDPAD
+            memset( padded + (SIZE_T)y * pad_stride, 0, pad_stride );
+            memcpy( padded + (SIZE_T)y * pad_stride, bits + (SIZE_T)y * stride, w * bytespp );
+#else
+            memcpy( padded + (SIZE_T)y * pad_stride, bits + (SIZE_T)y * stride, w * bytespp );
+            memset( padded + (SIZE_T)y * pad_stride + w * bytespp, 0xff, pad_stride - w * bytespp );
+#endif
+        }
+        free( rotated );
+        rotated = padded;
+        bits = padded;
+        stride = pad_stride;
+        w = pad_w;
+    }
+
     if (pdev->drv_bpp >= 24 && pdev->oem.uni && pdev->oem.has_image_processing && pdev->ip_callback >= 0)
     {
         BITMAPINFOHEADER bih = { sizeof(bih), w, h, 1, pdev->drv_bpp, BI_RGB };
@@ -332,6 +359,17 @@
         TRACE( "ImageProcessing %dx%d -> %#lx %p\n", w, h, hr, result );
         if (FAILED(hr) || !result) goto done;  /* the plug-in sent the band itself */
         out_stride = ((w * pdev->dev_bpp + 31) / 32) * 4;
+#ifndef SG_MUTANT_MONOINVERT
+        if (pdev->dev_bpp == 1)
+        {
+            /* the plug-in's band is a DIB, 0 black; the device's bits are
+             * ink, 1 black (what FilterGraphics clears to 0 is paper) */
+            int i, n = out_stride * h;
+            if (!(dithered = malloc( n ))) goto done;
+            for (i = 0; i < n; i++) dithered[i] = ~result[i];
+            result = dithered;
+        }
+#endif
     }
     else if (pdev->drv_bpp >= 24)
     {
@@ -343,7 +381,7 @@
         result = (BYTE *)bits;
         out_stride = stride;
     }
-    out_bytes = (w * pdev->dev_bpp + 7) / 8;
+    out_bytes = (send_w * pdev->dev_bpp + 7) / 8;
 
     if (pdev->oem.uni && pdev->oem.has_filter_graphics)
     {
