From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: IVisual2 -- offset and size relative to the parent's size

---
diff --git a/dlls/dcomp/composition.c b/dlls/dcomp/composition.c
index 134fbf8..f57c6c3 100644
--- a/dlls/dcomp/composition.c
+++ b/dlls/dcomp/composition.c
@@ -110,6 +110,7 @@ struct visual
     ICompositionObject2 ICompositionObject2_iface;
     IClosable IClosable_iface;
     IInspectable ICompositionObject4_iface;
+    IVisual2 IVisual2_iface;
     LONG ref;
 
     struct compositor *compositor;
@@ -132,9 +133,15 @@ struct visual
     CompositionBackfaceVisibility backface;
     CompositionBorderMode border_mode;
     CompositionCompositeMode composite_mode;
+    Vector3 relative_offset;    /* IVisual2: the offset's part relative to the parent's size (wine-sg 7707) */
+    Vector2 relative_size;      /* IVisual2: the size's part relative to the parent's size */
     ICompositionClip *clip;
     ICompositionBrush *brush;
     ICompositionPropertySet *properties;
+    IVisual *parent_for_transform;  /* IVisual2.ParentForTransform: kept, not yet applied */
+    /* the renderer's: size and offset with the relative parts resolved (under the compositor's lock) */
+    Vector2 render_size;
+    Vector3 render_offset;
 };
 
 static const struct IVisualVtbl visual_vtbl;
@@ -190,6 +197,10 @@ static HRESULT WINAPI visual_QueryInterface( IVisual *iface, REFIID iid, void **
 #endif
     else if (IsEqualGUID( iid, &IID_IClosable ))
         *out = &impl->IClosable_iface;
+#ifndef SG_MUTANT_NO_VISUAL2
+    else if (IsEqualGUID( iid, &IID_IVisual2 ))
+        *out = &impl->IVisual2_iface;
+#endif
     else
     {
         FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
@@ -224,6 +235,7 @@ static ULONG WINAPI visual_Release( IVisual *iface )
         if (impl->shapes) IInspectable_Release( impl->shapes );
         if (impl->view_box) IInspectable_Release( impl->view_box );
         if (impl->implicit) IImplicitAnimationCollection_Release( impl->implicit );
+        if (impl->parent_for_transform) IVisual_Release( impl->parent_for_transform );
         WindowsDeleteString( impl->comment );
         ICompositor_Release( (ICompositor *)impl->compositor );
         object_release_properties( impl->properties );
@@ -634,6 +646,8 @@ static BOOL visual_animatable( void *impl, const WCHAR *name, struct anim_proper
         { L"RotationAxis", ANIM_VECTOR3, offsetof(struct visual, rotation_axis) },
         { L"Scale", ANIM_VECTOR3, offsetof(struct visual, scale) },
         { L"Size", ANIM_VECTOR2, offsetof(struct visual, size) },
+        { L"RelativeOffsetAdjustment", ANIM_VECTOR3, offsetof(struct visual, relative_offset) },
+        { L"RelativeSizeAdjustment", ANIM_VECTOR2, offsetof(struct visual, relative_size) },
         { L"IsVisible", ANIM_BOOLEAN, offsetof(struct visual, visible) },
     };
     return anim_resolve( impl, members, ARRAY_SIZE(members), name, prop );
@@ -644,6 +658,89 @@ DEFINE_COMPOSITION_OBJECT4( visual, struct visual, IVisual_iface )
 
 DEFINE_IINSPECTABLE( visual_object2, ICompositionObject2, struct visual, IVisual_iface )
 
+/* ---- IVisual2 (wine-sg 7707): parts of the offset and size relative to the parent's size ---- */
+
+DEFINE_IINSPECTABLE( visual2, IVisual2, struct visual, IVisual_iface )
+
+static HRESULT WINAPI visual2_get_ParentForTransform( IVisual2 *iface, IVisual **value )
+{
+    struct visual *impl = impl_from_IVisual2( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    if ((*value = impl->parent_for_transform)) IVisual_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual2_put_ParentForTransform( IVisual2 *iface, IVisual *value )
+{
+    struct visual *impl = impl_from_IVisual2( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) FIXME( "parent for transform %p is kept but not applied.\n", value );
+    if (value) IVisual_AddRef( value );
+    if (impl->parent_for_transform) IVisual_Release( impl->parent_for_transform );
+    impl->parent_for_transform = value;
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual2_get_RelativeOffsetAdjustment( IVisual2 *iface, Vector3 *value )
+{
+    struct visual *impl = impl_from_IVisual2( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->relative_offset;
+    return S_OK;
+}
+
+static HRESULT WINAPI visual2_put_RelativeOffsetAdjustment( IVisual2 *iface, Vector3 value )
+{
+    struct visual *impl = impl_from_IVisual2( iface );
+    Vector3 old = impl->relative_offset;
+    TRACE( "iface %p.\n", iface );
+    impl->relative_offset = value;
+    if (impl->implicit && memcmp( &old, &value, sizeof(old) ))
+        visual_changed_implicit( impl, L"RelativeOffsetAdjustment", &old, sizeof(old) );
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual2_get_RelativeSizeAdjustment( IVisual2 *iface, Vector2 *value )
+{
+    struct visual *impl = impl_from_IVisual2( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->relative_size;
+    return S_OK;
+}
+
+static HRESULT WINAPI visual2_put_RelativeSizeAdjustment( IVisual2 *iface, Vector2 value )
+{
+    struct visual *impl = impl_from_IVisual2( iface );
+    Vector2 old = impl->relative_size;
+    TRACE( "iface %p.\n", iface );
+    impl->relative_size = value;
+    if (impl->implicit && memcmp( &old, &value, sizeof(old) ))
+        visual_changed_implicit( impl, L"RelativeSizeAdjustment", &old, sizeof(old) );
+    compositor_changed( impl->compositor );
+    return S_OK;
+}
+
+static const struct IVisual2Vtbl visual2_vtbl =
+{
+    visual2_QueryInterface,
+    visual2_AddRef,
+    visual2_Release,
+    visual2_GetIids,
+    visual2_GetRuntimeClassName,
+    visual2_GetTrustLevel,
+    visual2_get_ParentForTransform,
+    visual2_put_ParentForTransform,
+    visual2_get_RelativeOffsetAdjustment,
+    visual2_put_RelativeOffsetAdjustment,
+    visual2_get_RelativeSizeAdjustment,
+    visual2_put_RelativeSizeAdjustment,
+};
+
 static HRESULT WINAPI visual_object2_get_Comment( ICompositionObject2 *iface, HSTRING *value )
 {
     if (!value) return E_POINTER;
@@ -771,6 +868,7 @@ static HRESULT visual_create( struct compositor *compositor, BOOL sprite, struct
     impl->ICompositionObject_iface.lpVtbl = &visual_object_vtbl;
     impl->ICompositionObject2_iface.lpVtbl = &visual_object2_vtbl;
     impl->IClosable_iface.lpVtbl = &visual_closable_vtbl;
+    impl->IVisual2_iface.lpVtbl = &visual2_vtbl;
     impl->ref = 1;
     impl->compositor = compositor;
     ICompositor_AddRef( (ICompositor *)compositor );
@@ -1962,8 +2060,8 @@ static void visual_local_transform( const struct visual *v, D2D1_MATRIX_3X2_F *m
     /* anchor, then scale and rotation about the centre point */
     a._11 = v->scale.X * c; a._12 = v->scale.X * s;
     a._21 = -v->scale.Y * s; a._22 = v->scale.Y * c;
-    a._31 = -cx * a._11 - cy * a._21 + cx - v->anchor_point.X * v->size.X;
-    a._32 = -cx * a._12 - cy * a._22 + cy - v->anchor_point.Y * v->size.Y;
+    a._31 = -cx * a._11 - cy * a._21 + cx - v->anchor_point.X * v->render_size.X;
+    a._32 = -cx * a._12 - cy * a._22 + cy - v->anchor_point.Y * v->render_size.Y;
     /* then its matrix's 2D part */
     b._11 = v->transform.M11; b._12 = v->transform.M12;
     b._21 = v->transform.M21; b._22 = v->transform.M22;
@@ -1972,8 +2070,8 @@ static void visual_local_transform( const struct visual *v, D2D1_MATRIX_3X2_F *m
     m->_12 = a._11 * b._12 + a._12 * b._22;
     m->_21 = a._21 * b._11 + a._22 * b._21;
     m->_22 = a._21 * b._12 + a._22 * b._22;
-    m->_31 = a._31 * b._11 + a._32 * b._21 + b._31 + v->offset.X;
-    m->_32 = a._31 * b._12 + a._32 * b._22 + b._32 + v->offset.Y;
+    m->_31 = a._31 * b._11 + a._32 * b._21 + b._31 + v->render_offset.X;
+    m->_32 = a._31 * b._12 + a._32 * b._22 + b._32 + v->render_offset.Y;
 }
 
 static void matrix_multiply( D2D1_MATRIX_3X2_F *out, const D2D1_MATRIX_3X2_F *a, const D2D1_MATRIX_3X2_F *b )
@@ -2088,7 +2186,7 @@ static BOOL draw_render_target_only;
 static void draw_surface_brush( ID2D1DeviceContext *ctx, const struct visual *v, struct brush *brush, float opacity )
 {
     struct drawing_surface *surface = unsafe_drawing_surface( (IUnknown *)brush->surface );
-    float sw, sh, w = v->size.X, h = v->size.Y, dw, dh, scale;
+    float sw, sh, w = v->render_size.X, h = v->render_size.Y, dw, dh, scale;
     D2D1_RECT_F dst, src;
 
     if (!surface || !surface->bitmap) return;
@@ -2126,6 +2224,25 @@ static void draw_surface_brush( ID2D1DeviceContext *ctx, const struct visual *v,
     ID2D1DeviceContext_PopAxisAlignedClip( ctx );
 }
 
+/* the size of what the root visual is in: its target window's client area (wine-sg 7707) */
+static Vector2 draw_root_parent_size;
+
+/* a visual's size and offset as drawn: its own plus the relative parts (IVisual2) of its parent's size, the
+ * parent's as drawn (the root's parent is its window); the parent is resolved before its children */
+static void visual_resolve_size( struct visual *v, unsigned int depth )
+{
+    Vector2 parent = depth && v->parent ? v->parent->render_size : draw_root_parent_size;
+
+#ifdef SG_MUTANT_VISUAL2_NOT_APPLIED
+    parent.X = parent.Y = 0.0f;
+#endif
+    v->render_size.X = v->size.X + v->relative_size.X * parent.X;
+    v->render_size.Y = v->size.Y + v->relative_size.Y * parent.Y;
+    v->render_offset = v->offset;
+    v->render_offset.X += v->relative_offset.X * parent.X;
+    v->render_offset.Y += v->relative_offset.Y * parent.Y;
+}
+
 static void draw_visual( ID2D1DeviceContext *ctx, struct visual *v, const D2D1_MATRIX_3X2_F *parent, float opacity,
         unsigned int depth, struct swapchain_place *places, unsigned int max_places, unsigned int *count )
 {
@@ -2137,6 +2254,7 @@ static void draw_visual( ID2D1DeviceContext *ctx, struct visual *v, const D2D1_M
     if (!v->visible || depth > 256) return;
     opacity *= v->opacity;
     if (opacity <= 0.0f) return;
+    visual_resolve_size( v, depth );
     visual_local_transform( v, &local );
     matrix_multiply( &world, &local, parent );
     ID2D1DeviceContext_SetTransform( ctx, &world );
@@ -2145,7 +2263,7 @@ static void draw_visual( ID2D1DeviceContext *ctx, struct visual *v, const D2D1_M
     {
         clip = impl_from_ICompositionClip( v->clip );
         ID2D1DeviceContext_PushAxisAlignedClip( ctx, &(D2D1_RECT_F){ clip->left + clip->offset.X, clip->top + clip->offset.Y,
-                v->size.X - clip->right + clip->offset.X, v->size.Y - clip->bottom + clip->offset.Y },
+                v->render_size.X - clip->right + clip->offset.X, v->render_size.Y - clip->bottom + clip->offset.Y },
                 D2D1_ANTIALIAS_MODE_ALIASED );
     }
 
@@ -2159,7 +2277,7 @@ static void draw_visual( ID2D1DeviceContext *ctx, struct visual *v, const D2D1_M
 
             if (SUCCEEDED(ID2D1DeviceContext_CreateSolidColorBrush( ctx, &color, NULL, &solid )))
             {
-                ID2D1DeviceContext_FillRectangle( ctx, &(D2D1_RECT_F){ 0, 0, v->size.X, v->size.Y },
+                ID2D1DeviceContext_FillRectangle( ctx, &(D2D1_RECT_F){ 0, 0, v->render_size.X, v->render_size.Y },
                         (ID2D1Brush *)solid );
                 ID2D1SolidColorBrush_Release( solid );
             }
@@ -2187,7 +2305,7 @@ static void draw_visual( ID2D1DeviceContext *ctx, struct visual *v, const D2D1_M
     else if (v->brush && v->sprite)
         FIXME( "Brush %p is not drawn.\n", v->brush );
 #ifndef SG_MUTANT_SHAPES_NOT_DRAWN
-    if (v->shape_visual) shapes_draw( ctx, v->shapes, v->view_box, v->size, &world, opacity );
+    if (v->shape_visual) shapes_draw( ctx, v->shapes, v->view_box, v->render_size, &world, opacity );
 #endif
 
     LIST_FOR_EACH_ENTRY( child, &v->children, struct visual, entry )
@@ -2335,7 +2453,14 @@ static void target_render( struct desktop_target *target )
     ID2D1DeviceContext_SetTarget( target->context, (ID2D1Image *)target->bitmap );
     ID2D1DeviceContext_BeginDraw( target->context );
     ID2D1DeviceContext_Clear( target->context, &black );
+    {
+        RECT client;
+        GetClientRect( target->hwnd, &client );
+        draw_root_parent_size.X = client.right - client.left;
+        draw_root_parent_size.Y = client.bottom - client.top;
+    }
     draw_visual( target->context, target->root, &identity, 1.0f, 0, places, ARRAY_SIZE(places), &count );
+    draw_root_parent_size.X = draw_root_parent_size.Y = 0.0f;
     ID2D1DeviceContext_SetTransform( target->context, &identity );
     if (FAILED(hr = ID2D1DeviceContext_EndDraw( target->context, NULL, NULL )))
         WARN( "Drawing failed, hr %#lx.\n", hr );
diff --git a/include/windows.ui.composition.idl b/include/windows.ui.composition.idl
index 7f1a4dd..4308fbe 100644
--- a/include/windows.ui.composition.idl
+++ b/include/windows.ui.composition.idl
@@ -984,6 +984,22 @@ namespace Windows.UI.Composition {
         [propput] HRESULT TransformMatrix([in] Windows.Foundation.Numerics.Matrix4x4 value);
     }
 
+    /* Stained Glass OS 7707: identity and order from Microsoft's published metadata via the MIT windows crate */
+    [
+        contract(Windows.Foundation.UniversalApiContract, 4.0),
+        exclusiveto(Windows.UI.Composition.Visual),
+        uuid(3052b611-56c3-4c3e-8bf3-f6e1ad473f06)
+    ]
+    interface IVisual2 : IInspectable
+    {
+        [propget] HRESULT ParentForTransform([out, retval] Windows.UI.Composition.Visual **value);
+        [propput] HRESULT ParentForTransform([in] Windows.UI.Composition.Visual *value);
+        [propget] HRESULT RelativeOffsetAdjustment([out, retval] Windows.Foundation.Numerics.Vector3 *value);
+        [propput] HRESULT RelativeOffsetAdjustment([in] Windows.Foundation.Numerics.Vector3 value);
+        [propget] HRESULT RelativeSizeAdjustment([out, retval] Windows.Foundation.Numerics.Vector2 *value);
+        [propput] HRESULT RelativeSizeAdjustment([in] Windows.Foundation.Numerics.Vector2 value);
+    }
+
     [
         contract(Windows.Foundation.UniversalApiContract, 2.0),
         exclusiveto(Windows.UI.Composition.Visual),
