From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dmime: IDirectMusicSegment8::Compose

IDirectMusicSegment8::Compose: the segment is the transition template. The
result is a copy of the template (same length, start point, tracks and
track groups), in which every track that supports IDirectMusicTrack8 gets
to compose (IDirectMusicTrack8::Compose, the track group bits as group, the
segment which is transitioned to as context, else the segment which is
transitioned from, else the template itself) and is replaced by the track
that Compose returns; tracks that return E_NOTIMPL are kept as copied, other
errors fail the call. A missing result pointer is E_POINTER. The time
argument (where in the source segment the transition starts) is accepted
and not otherwise used, as no track of this implementation takes it.
---
diff --git a/dlls/dmime/segment.c b/dlls/dmime/segment.c
index a8fce18..eb79093 100644
--- a/dlls/dmime/segment.c
+++ b/dlls/dmime/segment.c
@@ -598,15 +598,59 @@ static HRESULT WINAPI segment_GetAudioPathConfig(IDirectMusicSegment8 *iface, IU
     return S_OK;
 }
 
+/* The segment is the template: a copy of it is the transition. Each track of the copy gets to compose its
+ * contents (IDirectMusicTrack8::Compose) with the segment which is transitioned to, or from, as context;
+ * tracks which do not compose are kept as they are. */
 static HRESULT WINAPI segment_Compose(IDirectMusicSegment8 *iface, MUSIC_TIME time,
         IDirectMusicSegment *from, IDirectMusicSegment *to, IDirectMusicSegment **composed)
 {
     struct segment *This = impl_from_IDirectMusicSegment8(iface);
+    IDirectMusicSegment *context = to ? to : from ? from : (IDirectMusicSegment *)iface;
+    struct track_entry *entry;
+    IDirectMusicSegment *copy;
+    HRESULT hr;
+
+    TRACE("(%p, %ld, %p, %p, %p)\n", This, time, from, to, composed);
+
+    if (!composed) return E_POINTER;
+    *composed = NULL;
+
+    if ((hr = segment_Clone(iface, 0, This->header.mtLength, &copy)) != S_OK)
+    {
+        if (copy) IDirectMusicSegment_Release(copy);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+
+    LIST_FOR_EACH_ENTRY(entry, &impl_from_IDirectMusicSegment8((IDirectMusicSegment8 *)copy)->tracks,
+            struct track_entry, entry)
+    {
+        IDirectMusicTrack8 *track8;
+        IDirectMusicTrack *result = NULL;
+
+        if (FAILED(IDirectMusicTrack_QueryInterface(entry->pTrack, &IID_IDirectMusicTrack8, (void **)&track8)))
+            continue;
+        hr = IDirectMusicTrack8_Compose(track8, (IUnknown *)context, entry->dwGroupBits, &result);
+        IDirectMusicTrack8_Release(track8);
 
-    FIXME("(%p, %ld, %p, %p, %p): transition composition is not supported\n", This, time, from, to, composed);
+        if (hr == E_NOTIMPL) continue;
+        if (FAILED(hr))
+        {
+            IDirectMusicSegment_Release(copy);
+            return hr;
+        }
+#ifndef SG_MUTANT_COMPOSE_KEEP
+        if (result)
+        {
+            IDirectMusicTrack_Release(entry->pTrack);
+            entry->pTrack = result;
+        }
+#else
+        if (result) IDirectMusicTrack_Release(result);
+#endif
+    }
 
-    if (composed) *composed = NULL;
-    return E_NOTIMPL;
+    *composed = copy;
+    return S_OK;
 }
 
 static HRESULT WINAPI segment_Download(IDirectMusicSegment8 *iface, IUnknown *audio_path)
