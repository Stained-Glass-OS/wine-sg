From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: PrintWindow of a window whose process refuses PROCESS_DUP_HANDLE

PW_RENDERFULLCONTENT across processes duplicated a section into the window's process. KeePassXC's process DACL refuses PROCESS_DUP_HANDLE, so PrintWindow failed and the taskbar's thumbnail fell back to a picture of the screen, showing whatever covered KeePassXC. The window's process now takes the section from the requester when it cannot be given one.
---
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index e0732f4..764306e 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -2485,6 +2485,7 @@ LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam )
 {
     int width = (lparam >> 15) & 0x7fff, height = lparam & 0x7fff;
     UINT flags = (lparam >> 30) & 3;
+    DWORD requester = (ULONGLONG)lparam >> 32;
     BITMAPINFO info = print_window_info( width, height );
     struct window_surface *surface = NULL;
     HBITMAP bitmap;
@@ -2493,6 +2494,19 @@ LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam )
     WND *win;
     LRESULT ret = 0;
 
+    /* the requester's own handle: this process takes its copy (print_other_process_window) */
+    if (requester)
+    {
+        OBJECT_ATTRIBUTES attr = { sizeof(attr) };
+        CLIENT_ID cid = { ULongToHandle( requester ), 0 };
+        HANDLE process, ours = 0;
+
+        if (NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid )) return 0;
+        NtDuplicateObject( process, section, GetCurrentProcess(), &ours, 0, 0, DUPLICATE_SAME_ACCESS );
+        NtClose( process );
+        if (!(section = ours)) return 0;
+    }
+
     if (!width || !height) goto done;
     if (!(hdc = NtGdiCreateCompatibleDC( 0 ))) goto done;
     if ((bitmap = NtGdiCreateDIBSection( hdc, section, 0, &info, DIB_RGB_COLORS, 0, 0, 0, &bits )))
@@ -2545,6 +2559,7 @@ static BOOL print_other_process_window( HWND hwnd, HDC hdc, UINT flags )
     HDC mem;
     int width, height;
     BOOL ret = FALSE;
+    LRESULT sent = 0;
 
     if (flags & PW_CLIENTONLY) get_client_rect( hwnd, &rect, get_thread_dpi() );
     else if (!get_window_rect( hwnd, &rect, get_thread_dpi() )) return FALSE;
@@ -2558,11 +2573,21 @@ static BOOL print_other_process_window( HWND hwnd, HDC hdc, UINT flags )
     cid.UniqueProcess = ULongToHandle( pid );
     if (!NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid ) &&
         !NtDuplicateObject( GetCurrentProcess(), section, process, &remote, 0, 0, DUPLICATE_SAME_ACCESS ))
+        sent = send_message_timeout( hwnd, WM_WINE_PRINTWINDOW, (WPARAM)remote,
+                                     ((LPARAM)(flags & 3) << 30) | (width << 15) | height,
+                                     SMTO_ABORTIFHUNG, 5000, FALSE );
+#ifndef SG_MUTANT_PRINT_NO_PULL
+    /* Stained Glass OS (wine-sg 6101): a process that keeps others from its handles (KeePassXC
+     * denies PROCESS_DUP_HANDLE to protect its memory) takes the section from us instead; the
+     * taskbar's thumbnail of it had been a picture of the screen, whatever covered it there */
+    else
+        sent = send_message_timeout( hwnd, WM_WINE_PRINTWINDOW, (WPARAM)section,
+                                     ((LPARAM)GetCurrentProcessId() << 32) | ((LPARAM)(flags & 3) << 30) |
+                                     (width << 15) | height, SMTO_ABORTIFHUNG, 5000, FALSE );
+#endif
     {
         /* the other side closes its handle, whatever it does */
-        if (send_message_timeout( hwnd, WM_WINE_PRINTWINDOW, (WPARAM)remote,
-                                  ((LPARAM)(flags & 3) << 30) | (width << 15) | height,
-                                  SMTO_ABORTIFHUNG, 5000, FALSE ))
+        if (sent)
         {
             info = print_window_info( width, height );
             mem = NtGdiCreateCompatibleDC( hdc );
