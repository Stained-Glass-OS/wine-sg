From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wintrust: CryptCATAdminAddCatalog validation and unique names, SIP put checks

From Wine's own crypt tests (todo_wine, recorded from Windows):
CryptCATAdminAddCatalog refuses a file holding no catalog with
ERROR_BAD_FORMAT (a file that is a catalog Wine cannot decode is still
copied), and without a base name it makes up a name that is not taken;
CryptSIPPutSignedDataMsg refuses a handle that cannot be written to with
ERROR_INVALID_PARAMETER. 6 todo_wine marks removed.

Gate: test/wintrustadmin-gate.sh (64 and 32 bit). Mutants
SG_MUTANT_CAT_ADDBAD, _ADDNONAME and SG_MUTANT_SIP_PUTRO are caught.
---
--- a/dlls/wintrust/crypt.c
+++ b/dlls/wintrust/crypt.c
@@ -249,19 +249,40 @@ HCATINFO WINAPI CryptCATAdminAddCatalog(HCATADMIN catAdmin, PWSTR catalogFile,
     TRACE("%p %s %s %ld\n", catAdmin, debugstr_w(catalogFile),
           debugstr_w(selectBaseName), flags);
 
-    if (!selectBaseName)
+    if (!ca || ca->magic != CATADMIN_MAGIC || !catalogFile || flags)
     {
-        FIXME("NULL basename not handled\n");
         SetLastError(ERROR_INVALID_PARAMETER);
         return NULL;
     }
-    if (!ca || ca->magic != CATADMIN_MAGIC || !catalogFile || flags)
+
+#ifdef SG_MUTANT_CAT_ADDNONAME
+    if (!selectBaseName)
     {
         SetLastError(ERROR_INVALID_PARAMETER);
         return NULL;
     }
+#endif
+
+    /* a file that holds no catalog at all is refused; one that merely cannot be decoded here is still copied */
+    {
+        HANDLE cat = CryptCATOpen(catalogFile, CRYPTCAT_OPEN_EXISTING, 0, 0, 0);
 
-    len = lstrlenW(ca->path) + lstrlenW(selectBaseName) + 2;
+        if (cat != INVALID_HANDLE_VALUE)
+        {
+            BOOL empty = !((struct cryptcat *)cat)->inner;
+
+            CryptCATClose(cat);
+#ifndef SG_MUTANT_CAT_ADDBAD
+            if (empty)
+            {
+                SetLastError(ERROR_BAD_FORMAT);
+                return NULL;
+            }
+#endif
+        }
+    }
+
+    len = lstrlenW(ca->path) + (selectBaseName ? lstrlenW(selectBaseName) : 16) + 2;
     if (!(target = malloc(len * sizeof(WCHAR))))
     {
         SetLastError(ERROR_OUTOFMEMORY);
@@ -269,7 +290,27 @@ HCATINFO WINAPI CryptCATAdminAddCatalog(HCATADMIN catAdmin, PWSTR catalogFile,
     }
     lstrcpyW(target, ca->path);
     lstrcatW(target, slashW);
-    lstrcatW(target, selectBaseName);
+    if (selectBaseName) lstrcatW(target, selectBaseName);
+    else
+    {
+        /* no name asked for: one that is not taken yet, like Windows' catNNNN.cat */
+        WCHAR *name = target + lstrlenW(target);
+        DWORD n;
+
+        for (n = 1; n < 0xffff; n++)
+        {
+            HANDLE file;
+
+            swprintf(name, 16, L"cat%X.cat", n);
+            file = CreateFileW(target, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                CloseHandle(file);
+                break;
+            }
+            if (GetLastError() != ERROR_FILE_EXISTS && GetLastError() != ERROR_ALREADY_EXISTS) break;
+        }
+    }
 
     if (!CopyFileW(catalogFile, target, FALSE))
     {
@@ -2550,7 +2591,20 @@ static BOOL WINTRUST_PutSignedMsgToPEFile(SIP_SUBJECTINFO* pSubjectInfo, DWORD p
     BOOL ret;
 
     if(pSubjectInfo->hFile && pSubjectInfo->hFile!=INVALID_HANDLE_VALUE)
+    {
+        OBJECT_BASIC_INFORMATION info;
+
         file = pSubjectInfo->hFile;
+        /* a handle that cannot be written to is not one a signature can be put into */
+#ifndef SG_MUTANT_SIP_PUTRO
+        if (NtQueryObject(file, ObjectBasicInformation, &info, sizeof(info), NULL) ||
+            !(info.GrantedAccess & (FILE_WRITE_DATA | FILE_APPEND_DATA)))
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+#endif
+    }
     else
     {
         file = CreateFileW(pSubjectInfo->pwsFileName, GENERIC_READ|GENERIC_WRITE,
--- a/dlls/wintrust/tests/crypt.c
+++ b/dlls/wintrust/tests/crypt.c
@@ -680,7 +680,7 @@ static void test_CryptCATAdminAddRemoveCatalog(void)
     SetLastError(0xdeadbeef);
     hcatinfo = pCryptCATAdminAddCatalog(hcatadmin, tmpfileW, basenameW, 0);
     error = GetLastError();
-    todo_wine {
+    {
     ok(hcatinfo == NULL, "CryptCATAdminAddCatalog succeeded\n");
     ok(error == ERROR_BAD_FORMAT, "got %lu expected ERROR_BAD_FORMAT\n", GetLastError());
     }
@@ -699,7 +699,7 @@ static void test_CryptCATAdminAddRemoveCatalog(void)
     hcatinfo = pCryptCATAdminAddCatalog(hcatadmin, tmpfileW, NULL, 0);
     error = GetLastError();
     ok(hcatinfo == NULL, "CryptCATAdminAddCatalog succeeded\n");
-    todo_wine ok(error == ERROR_BAD_FORMAT, "got %lu expected ERROR_BAD_FORMAT\n", GetLastError());
+    ok(error == ERROR_BAD_FORMAT, "got %lu expected ERROR_BAD_FORMAT\n", GetLastError());
 
     DeleteFileA(tmpfile);
     file = CreateFileA(tmpfile, GENERIC_WRITE, 0, NULL, CREATE_NEW, 0, NULL);
@@ -714,12 +714,11 @@ static void test_CryptCATAdminAddRemoveCatalog(void)
         win_skip("Not enough rights\n");
         goto cleanup;
     }
-    todo_wine ok(hcatinfo != NULL, "CryptCATAdminAddCatalog failed %lu\n", GetLastError());
+    ok(hcatinfo != NULL, "CryptCATAdminAddCatalog failed %lu\n", GetLastError());
 
     info.cbStruct = sizeof(info);
     info.wszCatalogFile[0] = 0;
     ret = pCryptCATCatalogInfoFromContext(hcatinfo, &info, 0);
-    todo_wine
     {
     ok(ret, "CryptCATCatalogInfoFromContext failed %lu\n", GetLastError());
     ok(info.wszCatalogFile[0] != 0, "Expected a filename\n");
@@ -1356,7 +1355,7 @@ static void test_sip(void)
     ret = pPutSignedDataMsg(&info, X509_ASN_ENCODING, &index, 4, (BYTE*)"test");
     ok(!ret, "CryptSIPPutSignedDataMsg succeeded\n");
     index = GetLastError();
-    todo_wine ok(index == ERROR_INVALID_PARAMETER, "GetLastError returned %lx\n", index);
+    ok(index == ERROR_INVALID_PARAMETER, "GetLastError returned %lx\n", index);
 
     info.hFile = INVALID_HANDLE_VALUE;
     info.pwsFileName = nameW;
