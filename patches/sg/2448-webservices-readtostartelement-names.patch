From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: WsReadToStartElement checks the name, and an end tag is not an error

WsReadToStartElement ignored the local name and namespace it was given ("name and/or namespace not verified"): with a name, found is now TRUE only if the next start element is that one. At an end tag it failed with WS_E_INVALID_FORMAT; it now returns S_OK with found FALSE and leaves the end tag to be read.
---
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -2830,6 +2830,9 @@ static HRESULT read_to_startelement_bin( struct reader *reader, BOOL *found )
     return hr;
 }
 
+static HRESULT array_peek_start( struct reader *, BOOL * );
+static BOOL match_element( const struct node *, const WS_XML_STRING *, const WS_XML_STRING * );
+
 static HRESULT read_to_startelement( struct reader *reader, BOOL *found )
 {
     switch (reader->input_enc)
@@ -3364,7 +3367,6 @@ HRESULT WINAPI WsReadToStartElement( WS_XML_READER *handle, const WS_XML_STRING
     if (error) FIXME( "ignoring error parameter\n" );
 
     if (!reader) return E_INVALIDARG;
-    if (localname || ns) FIXME( "name and/or namespace not verified\n" );
 
     EnterCriticalSection( &reader->cs );
 
@@ -3374,7 +3376,11 @@ HRESULT WINAPI WsReadToStartElement( WS_XML_READER *handle, const WS_XML_STRING
         return E_INVALIDARG;
     }
 
-    hr = read_to_startelement( reader, found );
+    hr = array_peek_start( reader, found );
+    /* with a name, the next element has to be that one */
+#ifndef SG_MUTANT_WSSTART_NAME
+    if (hr == S_OK && found && *found && localname && !match_element( reader->current, localname, ns )) *found = FALSE;
+#endif
 
     LeaveCriticalSection( &reader->cs );
     TRACE( "returning %#lx\n", hr );
@@ -7088,18 +7094,20 @@ HRESULT WINAPI WsReadElement( WS_XML_READER *handle, const WS_ELEMENT_DESCRIPTIO
     return hr;
 }
 
-/* is there a start element next?  (An end tag is the end of the array, not an error.) */
+/* is there a start element next?  (An end tag is no start element: found is FALSE, not an error.) */
 static HRESULT array_peek_start( struct reader *reader, BOOL *found )
 {
     unsigned char buf[2];
 
-    *found = FALSE;
-    if (reader->input_enc == WS_XML_READER_ENCODING_TYPE_TEXT && reader->state != READER_STATE_INITIAL &&
-        reader->state != READER_STATE_STARTELEMENT)
+    if (found) *found = FALSE;
+#ifndef SG_MUTANT_WSSTART_ENDTAG
+    if (reader->input_enc == WS_XML_READER_ENCODING_TYPE_TEXT && reader->input_type && reader->read_bufptr &&
+        reader->state != READER_STATE_INITIAL && reader->state != READER_STATE_STARTELEMENT)
     {
         read_skip_whitespace( reader );
         if (read_peek( reader, buf, 2 ) == S_OK && buf[0] == '<' && buf[1] == '/') return S_OK;
     }
+#endif
     return read_to_startelement( reader, found );
 }
 
