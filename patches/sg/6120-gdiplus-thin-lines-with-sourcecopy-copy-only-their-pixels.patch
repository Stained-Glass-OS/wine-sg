From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: thin lines drawn with SourceCopy copy only the pixels they cover

SOFTWARE_GdipDrawThinPath rendered the line into a transparent buffer the size of its bounds and copied the whole buffer; with CompositingModeSourceCopy the transparent part overwrote what was there, so the second diagonal of a cross erased the first (PyCharm's close button showed one stroke of its X). With SourceCopy only runs of covered pixels are copied now.
---
diff --git a/dlls/gdiplus/graphics.c b/dlls/gdiplus/graphics.c
index 34affd7..f86a717 100644
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -4058,6 +4058,7 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
     RECT output_area;
     INT output_height, output_width;
     DWORD *output_bits, *brush_bits=NULL;
+    BYTE *covered = NULL;
     int i;
     static const BYTE static_dash_pattern[] = {1,1,1,0,1,0,1,0};
     const BYTE *dash_pattern;
@@ -4145,6 +4146,17 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
         output_bits = calloc(output_width * output_height, sizeof(DWORD));
         if (!output_bits)
             stat = OutOfMemory;
+        /* Stained Glass OS: with SourceCopy only the pixels the line covers are
+         * copied; the rest of the output area is not the line's (the second
+         * diagonal of a cross erased the first: PyCharm's close button) */
+#ifndef SG_MUTANT_THINPATH_COPY_ALL
+        else if (graphics->compmode == CompositingModeSourceCopy &&
+                 !(covered = calloc(output_width, output_height)))
+        {
+            free(output_bits);
+            stat = OutOfMemory;
+        }
+#endif
     }
 
     if (stat == Ok)
@@ -4300,6 +4312,7 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
                             output_bits[x + y*output_width] = brush_bits[x + y*output_width];
                         else
                             output_bits[x + y*output_width] = ((GpSolidFill*)pen->brush)->color;
+                        if (covered) covered[x + y*output_width] = 1;
                     }
                 }
                 else
@@ -4342,6 +4355,7 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
                             output_bits[x + y*output_width] = brush_bits[x + y*output_width];
                         else
                             output_bits[x + y*output_width] = ((GpSolidFill*)pen->brush)->color;
+                        if (covered) covered[x + y*output_width] = 1;
                     }
                 }
             }
@@ -4390,6 +4404,7 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
                                             output_bits[x + y*output_width] = brush_bits[x + y*output_width];
                                         else
                                             output_bits[x + y*output_width] = ((GpSolidFill*)pen->brush)->color;
+                                        if (covered) covered[x + y*output_width] = 1;
                                     }
                                 }
                             }
@@ -4412,9 +4427,31 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
         {
             gdi_transform_acquire(graphics);
 
-            stat = alpha_blend_pixels(graphics, output_area.left, output_area.top,
-                (BYTE*)output_bits, output_width, output_height, output_width * 4,
-                PixelFormat32bppARGB);
+            if (covered)
+            {
+                INT x, y, run;
+
+                /* each row's runs of covered pixels */
+                for (y = 0; y < output_height && stat == Ok; y++)
+                {
+                    for (x = 0; x < output_width && stat == Ok; x += run)
+                    {
+                        for (run = 0; x + run < output_width && covered[x + run + y*output_width]; run++);
+                        if (!run)
+                        {
+                            run = 1;
+                            continue;
+                        }
+                        stat = alpha_blend_pixels(graphics, output_area.left + x, output_area.top + y,
+                            (BYTE*)(output_bits + x + y*output_width), run, 1, output_width * 4,
+                            PixelFormat32bppARGB);
+                    }
+                }
+            }
+            else
+                stat = alpha_blend_pixels(graphics, output_area.left, output_area.top,
+                    (BYTE*)output_bits, output_width, output_height, output_width * 4,
+                    PixelFormat32bppARGB);
 
             gdi_transform_release(graphics);
         }
@@ -4422,6 +4459,7 @@ static GpStatus SOFTWARE_GdipDrawThinPath(GpGraphics *graphics, GpPen *pen, GpPa
         free(brush_bits);
         free(dyn_dash_pattern);
         free(output_bits);
+        free(covered);
     }
 
     GdipDeletePath(flat_path);
