+
+/* ---- counter path parsing ---- */
+
+struct path_parts
+{
+    const WCHAR *machine;  DWORD machine_len;
+    const WCHAR *object;   DWORD object_len;
+    const WCHAR *inst;     DWORD inst_len;   /* text between the parentheses, NULL if none */
+    const WCHAR *counter;  DWORD counter_len;
+};
+
+/* \\machine\object(instance)\counter, the machine and instance being optional */
+static PDH_STATUS parse_path( const WCHAR *path, struct path_parts *parts )
+{
+    const WCHAR *p = path, *q;
+    int depth;
+
+    memset( parts, 0, sizeof(*parts) );
+    if (!p[0]) return PDH_INVALID_ARGUMENT;
+    if (p[0] == '\\' && p[1] == '\\')
+    {
+        parts->machine = p + 2;
+        if (!(q = wcschr( parts->machine, '\\' ))) return PDH_CSTATUS_BAD_COUNTERNAME;
+        parts->machine_len = q - parts->machine;
+        if (!parts->machine_len) return PDH_CSTATUS_BAD_COUNTERNAME;
+        p = q;
+    }
+    if (*p++ != '\\') return PDH_CSTATUS_BAD_COUNTERNAME;
+    parts->object = p;
+    while (*p && *p != '(' && *p != '\\') p++;
+    if (!*p) return PDH_CSTATUS_BAD_COUNTERNAME;
+    parts->object_len = p - parts->object;
+    if (!parts->object_len) return PDH_CSTATUS_BAD_COUNTERNAME;
+    if (*p == '(')
+    {
+        parts->inst = ++p;
+        for (depth = 1; *p; p++)
+        {
+            if (*p == '(') depth++;
+            else if (*p == ')' && !--depth) break;
+        }
+        if (!*p) return PDH_CSTATUS_BAD_COUNTERNAME;
+        parts->inst_len = p - parts->inst;
+        p++;
+    }
+    if (*p++ != '\\') return PDH_CSTATUS_BAD_COUNTERNAME;
+    parts->counter = p;
+    parts->counter_len = lstrlenW( p );
+    if (!parts->counter_len) return PDH_CSTATUS_BAD_COUNTERNAME;
+    return ERROR_SUCCESS;
+}
+
+/* split "parent/name#index" */
+static void split_instance( const WCHAR *inst, DWORD len, const WCHAR **parent, DWORD *parent_len,
+                            const WCHAR **name, DWORD *name_len, DWORD *index )
+{
+    const WCHAR *slash = NULL, *hash = NULL, *p;
+
+    for (p = inst; p < inst + len; p++)
+    {
+        if (*p == '/' && !slash) slash = p;
+        if (*p == '#') hash = p;
+    }
+    *index = ~0u;
+    if (hash && hash + 1 < inst + len && hash > inst)
+    {
+        const WCHAR *d = hash + 1;
+        DWORD val = 0;
+        while (d < inst + len && *d >= '0' && *d <= '9') val = val * 10 + (*d++ - '0');
+        if (d == inst + len) *index = val; else hash = NULL;
+    }
+    else hash = NULL;
+    if (slash && slash + 1 < inst + len && slash > inst)
+    {
+        *parent = inst;
+        *parent_len = slash - inst;
+        *name = slash + 1;
+    }
+    else
+    {
+        *parent = NULL;
+        *parent_len = 0;
+        *name = inst;
+    }
+    *name_len = (hash ? hash : inst + len) - *name;
+}
+
+static DWORD out_len( BOOL ansi, const WCHAR *str, DWORD len )
+{
+    if (!ansi) return len + 1;
+    return WideCharToMultiByte( CP_ACP, 0, str, len, NULL, 0, NULL, NULL ) + 1;
+}
+
+static char *out_str( BOOL ansi, char *dst, const WCHAR *str, DWORD len )
+{
+    if (!ansi)
+    {
+        memcpy( dst, str, len * sizeof(WCHAR) );
+        ((WCHAR *)dst)[len] = 0;
+        return dst + (len + 1) * sizeof(WCHAR);
+    }
+    len = WideCharToMultiByte( CP_ACP, 0, str, len, dst, 0x7fffffff, NULL, NULL );
+    dst[len] = 0;
+    return dst + len + 1;
+}
+
+static PDH_STATUS parse_counter_path( const WCHAR *path, void *buffer, DWORD *size, BOOL ansi )
+{
+    struct path_parts parts;
+    const WCHAR *parent, *name;
+    DWORD parent_len, name_len, index = ~0u, need, cs = ansi ? 1 : sizeof(WCHAR);
+    PDH_STATUS ret;
+    char *p;
+    struct { void *machine, *object, *inst, *parent; DWORD index; void *counter; } *e;
+
+    if ((ret = parse_path( path, &parts ))) return ret;
+    need = ansi ? sizeof(PDH_COUNTER_PATH_ELEMENTS_A) : sizeof(PDH_COUNTER_PATH_ELEMENTS_W);
+    if (parts.machine) need += out_len( ansi, parts.machine, parts.machine_len ) * cs;
+    need += out_len( ansi, parts.object, parts.object_len ) * cs;
+    parent = name = NULL; parent_len = name_len = 0;
+    if (parts.inst)
+    {
+        split_instance( parts.inst, parts.inst_len, &parent, &parent_len, &name, &name_len, &index );
+        need += out_len( ansi, name, name_len ) * cs;
+        if (parent) need += out_len( ansi, parent, parent_len ) * cs;
+    }
+    need += out_len( ansi, parts.counter, parts.counter_len ) * cs;
+
+    if (*size < need || !buffer)
+    {
+        *size = need;
+        return PDH_MORE_DATA;
+    }
+    memset( buffer, 0, sizeof(*e) );
+    e = buffer;
+    p = (char *)buffer + (ansi ? sizeof(PDH_COUNTER_PATH_ELEMENTS_A) : sizeof(PDH_COUNTER_PATH_ELEMENTS_W));
+    if (parts.machine) { e->machine = p; p = out_str( ansi, p, parts.machine, parts.machine_len ); }
+    e->object = p; p = out_str( ansi, p, parts.object, parts.object_len );
+    if (parts.inst)
+    {
+        e->inst = p; p = out_str( ansi, p, name, name_len );
+        if (parent) { e->parent = p; p = out_str( ansi, p, parent, parent_len ); }
+    }
+    e->index = index;
+    e->counter = p; p = out_str( ansi, p, parts.counter, parts.counter_len );
+    *size = need;
+    return ERROR_SUCCESS;
+}
+
 /***********************************************************************
- *              PdhEnumObjectItemsA   (PDH.@)
+ *              PdhParseCounterPathW   (PDH.@)
+ */
+PDH_STATUS WINAPI PdhParseCounterPathW( LPCWSTR path, PDH_COUNTER_PATH_ELEMENTS_W *buffer, LPDWORD size, DWORD flags )
+{
+    TRACE("%s %p %p 0x%08lx\n", debugstr_w(path), buffer, size, flags);
+
+    if (!path || !size) return PDH_INVALID_ARGUMENT;
+    return parse_counter_path( path, buffer, size, FALSE );
+}
+
+/***********************************************************************
+ *              PdhParseCounterPathA   (PDH.@)
+ */
+PDH_STATUS WINAPI PdhParseCounterPathA( LPCSTR path, PDH_COUNTER_PATH_ELEMENTS_A *buffer, LPDWORD size, DWORD flags )
+{
+    PDH_STATUS ret;
+    WCHAR *pathW;
+
+    TRACE("%s %p %p 0x%08lx\n", debugstr_a(path), buffer, size, flags);
+
+    if (!path || !size) return PDH_INVALID_ARGUMENT;
+    if (!(pathW = pdh_strdup_aw( path ))) return PDH_MEMORY_ALLOCATION_FAILURE;
+    ret = parse_counter_path( pathW, buffer, size, TRUE );
+    free( pathW );
+    return ret;
+}
+
+static PDH_STATUS parse_instance_name( const WCHAR *str, void *name, DWORD *name_size, void *parent,
+                                       DWORD *parent_size, DWORD *index, BOOL ansi )
+{
+    const WCHAR *pw, *nw;
+    DWORD pl, nl, idx, need_name, need_parent;
+
+    if (!str || !*str || !name_size || !parent_size || !index) return PDH_INVALID_ARGUMENT;
+    split_instance( str, lstrlenW( str ), &pw, &pl, &nw, &nl, &idx );
+    need_name = out_len( ansi, nw, nl );
+    need_parent = pw ? out_len( ansi, pw, pl ) : 1;
+    *index = idx == ~0u ? 0 : idx;
+    if (!name || !parent || *name_size < need_name || *parent_size < need_parent)
+    {
+        *name_size = need_name;
+        *parent_size = need_parent;
+        return PDH_MORE_DATA;
+    }
+    out_str( ansi, name, nw, nl );
+    out_str( ansi, parent, pw ? pw : L"", pl );
+    *name_size = need_name;
+    *parent_size = need_parent;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *              PdhParseInstanceNameW   (PDH.@)
+ */
+PDH_STATUS WINAPI PdhParseInstanceNameW( LPCWSTR str, LPWSTR name, LPDWORD name_size, LPWSTR parent,
+                                         LPDWORD parent_size, LPDWORD index )
+{
+    TRACE("%s %p %p %p %p %p\n", debugstr_w(str), name, name_size, parent, parent_size, index);
+    return parse_instance_name( str, name, name_size, parent, parent_size, index, FALSE );
+}
+
+/***********************************************************************
+ *              PdhParseInstanceNameA   (PDH.@)
+ */
+PDH_STATUS WINAPI PdhParseInstanceNameA( LPCSTR str, LPSTR name, LPDWORD name_size, LPSTR parent,
+                                         LPDWORD parent_size, LPDWORD index )
+{
+    PDH_STATUS ret;
+    WCHAR *strW;
+
+    TRACE("%s %p %p %p %p %p\n", debugstr_a(str), name, name_size, parent, parent_size, index);
+
+    if (!str) return PDH_INVALID_ARGUMENT;
+    if (!(strW = pdh_strdup_aw( str ))) return PDH_MEMORY_ALLOCATION_FAILURE;
+    ret = parse_instance_name( strW, name, name_size, parent, parent_size, index, TRUE );
+    free( strW );
+    return ret;
+}
+
+/* ---- wildcard expansion and object enumeration over the built-in counter set ---- */
+
+static BOOL wild_match( const WCHAR *pat, DWORD plen, const WCHAR *str, DWORD slen )
+{
+    while (plen)
+    {
+        if (*pat == '*')
+        {
+            while (plen && *pat == '*') { pat++; plen--; }
+            if (!plen) return TRUE;
+            for (;;)
+            {
+                if (wild_match( pat, plen, str, slen )) return TRUE;
+                if (!slen) return FALSE;
+                str++; slen--;
+            }
+        }
+        if (!slen) return FALSE;
+        if (*pat != '?' && towlower( *pat ) != towlower( *str )) return FALSE;
+        pat++; plen--; str++; slen--;
+    }
+    return !slen;
+}
+
+static BOOL is_local_machine_name( const WCHAR *name, DWORD len )
+{
+    if (!name) return TRUE;
+    if (len >= 2 && name[0] == '\\' && name[1] == '\\') { name += 2; len -= 2; }
+    return !len || is_local_machine( name, len );
+}
+
+static BOOL wide_is_local_machine( const WCHAR *name )
+{
+    return !name || !*name || is_local_machine_name( name, lstrlenW( name ));
+}
+
+static PDH_STATUS append_multisz( WCHAR **buf, DWORD *used, DWORD *cap, const WCHAR *str, DWORD len )
+{
+    if (*used + len + 2 > *cap)
+    {
+        DWORD ncap = max( *cap * 2, *used + len + 2 + 64 );
+        WCHAR *tmp = realloc( *buf, ncap * sizeof(WCHAR) );
+        if (!tmp) return PDH_MEMORY_ALLOCATION_FAILURE;
+        *buf = tmp;
+        *cap = ncap;
+    }
+    memcpy( *buf + *used, str, len * sizeof(WCHAR) );
+    *used += len;
+    (*buf)[(*used)++] = 0;
+    (*buf)[*used] = 0;
+    return ERROR_SUCCESS;
+}
+
+static BOOL multisz_has( const WCHAR *list, DWORD used, const WCHAR *str, DWORD len )
+{
+    const WCHAR *p = list;
+    while (p && p < list + used && *p)
+    {
+        if (lstrlenW( p ) == len && !wcsnicmp( p, str, len )) return TRUE;
+        p += lstrlenW( p ) + 1;
+    }
+    return FALSE;
+}
+
+/* hands out a multi-string, honouring the Windows buffer-size protocol */
+static PDH_STATUS return_multisz_w( const WCHAR *list, DWORD used, WCHAR *buffer, DWORD *size )
+{
+    /* an empty list is a double null */
+    DWORD need = used ? used + 1 : 2;
+
+    if (!buffer || *size < need)
+    {
+        *size = need;
+        return PDH_MORE_DATA;
+    }
+    if (used) memcpy( buffer, list, used * sizeof(WCHAR) );
+    else buffer[0] = 0;
+    buffer[need - 1] = 0;
+    *size = need;
+    return ERROR_SUCCESS;
+}
+
+static PDH_STATUS return_multisz_a( const WCHAR *list, DWORD used, char *buffer, DWORD *size )
+{
+    DWORD need = used ? used + 1 : 2, alen;
+
+    alen = WideCharToMultiByte( CP_ACP, 0, list, used ? used + 1 : 2, NULL, 0, NULL, NULL );
+    if (!used) alen = 2;
+    if (!buffer || *size < alen)
+    {
+        *size = alen;
+        return PDH_MORE_DATA;
+    }
+    if (used) WideCharToMultiByte( CP_ACP, 0, list, need, buffer, alen, NULL, NULL );
+    else buffer[0] = buffer[1] = 0;
+    *size = alen;
+    return ERROR_SUCCESS;
+}
+
+static BOOL log_file_exists( const WCHAR *name )
+{
+    return GetFileAttributesW( name ) != INVALID_FILE_ATTRIBUTES;
+}
+
+static PDH_STATUS expand_wildcard_path( const WCHAR *source, const WCHAR *pattern, WCHAR **list, DWORD *used,
+                                        DWORD flags )
+{
+    struct path_parts pat, src;
+    PDH_STATUS ret = PDH_CSTATUS_NO_OBJECT, status;
+    DWORD i, cap = 0, len;
+    WCHAR *tmp;
+
+    *list = NULL;
+    *used = 0;
+    if ((status = parse_path( pattern, &pat ))) return status;
