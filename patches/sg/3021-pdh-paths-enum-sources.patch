+ *              PdhValidatePathExA   (PDH.@)
+ */
+PDH_STATUS WINAPI PdhValidatePathExA( PDH_HLOG source, LPCSTR path )
+{
+    PDH_STATUS ret;
+    WCHAR *pathW;
+
+    TRACE("%p %s\n", source, debugstr_a(path));
+
+    if (!source) return PdhValidatePathA( path );
+    if (!path) return PDH_INVALID_ARGUMENT;
+    if (!(pathW = pdh_strdup_aw( path ))) return PDH_MEMORY_ALLOCATION_FAILURE;
+    ret = PdhValidatePathExW( source, pathW );
+    free( pathW );
+    return ret;
+}
+
+static BOOL read_prefix( const WCHAR *name, BYTE *buf, DWORD size, DWORD *read )
+{
+    HANDLE file = CreateFileW( name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, 0 );
+
+    *read = 0;
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ReadFile( file, buf, size, read, NULL );
+    CloseHandle( file );
+    return TRUE;
+}
+
+static PDH_STATUS log_file_type( const WCHAR *name, DWORD *type )
+{
+    static const char csv[] = "\"(PDH-CSV 4.0)", tsv[] = "\"(PDH-TSV 4.0)";
+    static const WCHAR csvw[] = L"\"(PDH-CSV 4.0)", tsvw[] = L"\"(PDH-TSV 4.0)";
+    const WCHAR *ext;
+    BYTE buf[32];
+    DWORD read;
+
+    if (!name || !type) return PDH_INVALID_ARGUMENT;
+    if (!read_prefix( name, buf, sizeof(buf), &read )) return PDH_LOG_FILE_OPEN_ERROR;
+
+    if (read >= sizeof(csv) - 1 && !memcmp( buf, csv, sizeof(csv) - 1 )) *type = PDH_LOG_TYPE_CSV;
+    else if (read >= sizeof(tsv) - 1 && !memcmp( buf, tsv, sizeof(tsv) - 1 )) *type = PDH_LOG_TYPE_TSV;
+    else if (read >= sizeof(csvw) - sizeof(WCHAR) && !memcmp( buf, csvw, sizeof(csvw) - sizeof(WCHAR) )) *type = PDH_LOG_TYPE_CSV;
+    else if (read >= sizeof(tsvw) - sizeof(WCHAR) && !memcmp( buf, tsvw, sizeof(tsvw) - sizeof(WCHAR) )) *type = PDH_LOG_TYPE_TSV;
+    else if ((ext = wcsrchr( name, '.' )) && !wcsicmp( ext, L".blg" )) *type = PDH_LOG_TYPE_BINARY;
+    else if (ext && !wcsicmp( ext, L".etl" )) *type = PDH_LOG_TYPE_TRACE_GENERIC;
+    else return PDH_UNKNOWN_LOG_FORMAT;
+    return ERROR_SUCCESS;
 }
 
