+/* return a single string with the Windows buffer protocol */
+static PDH_STATUS return_string( BOOL ansi, const WCHAR *str, void *buffer, DWORD *size )
+{
+    DWORD len = lstrlenW( str ), need = out_len( ansi, str, len );
+
+    if (!buffer || *size < need)
+    {
+        *size = need;
+        return PDH_MORE_DATA;
+    }
+    out_str( ansi, buffer, str, len );
+    *size = need;
+    return ERROR_SUCCESS;
+}
