 HRESULT WINAPI GetVersionFromProcess(HANDLE hProcess, LPWSTR pVersion, DWORD cchBuffer, DWORD *dwLength)
 {
-    FIXME("(%p, %p, %ld, %p): stub\n", hProcess, pVersion, cchBuffer, dwLength);
-    return E_NOTIMPL;
-}
+    IEnumUnknown *runtimes;
+    IUnknown *unk;
+    ICLRRuntimeInfo *info;
+    ULONG fetched = 0;
+    DWORD length;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %ld, %p)\n", hProcess, pVersion, cchBuffer, dwLength);
 
+    if (!dwLength)
+        return E_POINTER;
+
+    hr = get_loaded_runtimes(hProcess, &runtimes);
+    if (FAILED(hr))
+        return hr;
+
+    hr = IEnumUnknown_Next(runtimes, 1, &unk, &fetched);
+    IEnumUnknown_Release(runtimes);
+    if (hr != S_OK || !fetched)
+        return CLR_E_SHIM_RUNTIMELOAD;
+
+    hr = IUnknown_QueryInterface(unk, &IID_ICLRRuntimeInfo, (void **)&info);
+    IUnknown_Release(unk);
+    if (FAILED(hr))
+        return hr;
+
+    length = cchBuffer;
+    hr = ICLRRuntimeInfo_GetVersionString(info, pVersion, &length);
+    *dwLength = length;
+    ICLRRuntimeInfo_Release(info);
+    return hr;
+}
