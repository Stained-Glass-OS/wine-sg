+struct domain_enum
+{
+    MonoDomain **domains;
+    ULONG count, size, pos;
+    BOOL failed;
+};
+
+static void CDECL collect_domain(MonoDomain *domain, void *user_data)
+{
+    struct domain_enum *e = user_data;
+
+    if (e->failed) return;
+    if (e->count == e->size)
+    {
+        ULONG size = e->size ? e->size * 2 : 8;
+        MonoDomain **list = realloc(e->domains, size * sizeof(*list));
+        if (!list) { e->failed = TRUE; return; }
+        e->domains = list;
+        e->size = size;
+    }
+    e->domains[e->count++] = domain;
+}
+
 static HRESULT WINAPI corruntimehost_EnumDomains(
     ICorRuntimeHost* iface,
     HDOMAINENUM *hEnum)
 {
-    FIXME("stub %p\n", iface);
-    return E_NOTIMPL;
-}
+    RuntimeHost *This = impl_from_ICorRuntimeHost( iface );
+    struct domain_enum *e;
+    MonoDomain *dummy;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", iface, hEnum);
+
+    if (!hEnum)
+        return E_POINTER;
+
+    *hEnum = NULL;
+
+    if (!mono_domain_foreach)
+        return E_NOTIMPL;
+
+    hr = RuntimeHost_GetDefaultDomain(This, NULL, &dummy);
+    if (FAILED(hr))
+        return hr;
+
+    e = calloc(1, sizeof(*e));
+    if (!e)
+        return E_OUTOFMEMORY;
+
+    mono_domain_foreach(collect_domain, e);
+
+    if (e->failed)
+    {
+        free(e->domains);
+        free(e);
+        return E_OUTOFMEMORY;
+    }
 
+    *hEnum = e;
+    return S_OK;
+}
