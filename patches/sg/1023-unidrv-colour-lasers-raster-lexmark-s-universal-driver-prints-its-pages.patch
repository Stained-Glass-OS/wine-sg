+/* TIFF 4.0 (PCL mode 2, PackBits) run-length encoding */
+static int packbits( const BYTE *in, int len, BYTE *out )
+{
+    int i = 0, o = 0;
+
+    while (i < len)
+    {
+        int run = 1;
+        while (i + run < len && run < 128 && in[i + run] == in[i]) run++;
+        if (run >= 3)
+        {
+            out[o++] = (BYTE)(257 - run);
+            out[o++] = in[i];
+            i += run;
+        }
+        else
+        {
+            int lit = 0;
+            while (i + lit < len && lit < 128 &&
+                   !(i + lit + 2 < len && in[i + lit] == in[i + lit + 1] && in[i + lit] == in[i + lit + 2]))
+                lit++;
+            out[o++] = (BYTE)(lit - 1);
+            memcpy( out + o, in + i, lit );
+            o += lit;
+            i += lit;
+        }
+    }
+    return o;
+}
+
+static BOOL has_command( struct unidrv_pdev *pdev, const char *name )
+{
+    struct gpd_command cmd;
+    return gpd_command( pdev->gpd, pdev->sel, name, &cmd ) && (cmd.cmd || cmd.callback >= 0);
+}
+
+/* a GPD with raster mode commands (PCL's "start raster", "end raster"):
+ * rows go in raster groups, after the source width and the cursor, each
+ * row compressed when the GPD can turn compression on; a blank row ends
+ * the group */
+static BOOL send_raster_groups( struct unidrv_pdev *pdev, const BYTE *data, int stride, int bytes, int rows, int y0 )
+{
+    BOOL in_raster = FALSE, tiff = FALSE, blank_white = pdev->dev_bpp > 1;
+    BYTE *packed;
+    int y, i;
+
+    if (!has_command( pdev, "CmdBeginRaster" )) return FALSE;
+#ifdef SG_MUTANT_RASTERGROUP
+    return FALSE;
+#endif
+    if (!(packed = malloc( bytes + bytes / 64 + 16 ))) return TRUE;
+    for (y = 0; y < rows; y++)
+    {
+        const BYTE *row = data + (SIZE_T)y * stride;
+        BOOL blank = TRUE;
+        int len;
+
+        for (i = 0; i < bytes; i++)
+            if (blank_white ? row[i] != 0xff : row[i] != 0) { blank = FALSE; break; }
+        if (blank)
+        {
+            if (in_raster) send_named( pdev, "CmdEndRaster" );
+            in_raster = FALSE;
+            continue;
+        }
+        if (!in_raster)
+        {
+            pdev->cur_x = 0;
+            pdev->cur_y = y0 + y;
+            pdev->width_bytes = bytes;
+            pdev->height_pixels = rows - y;
+            send_named( pdev, "CmdXMoveAbsolute" );
+            send_named( pdev, "CmdYMoveAbsolute" );
+            send_named( pdev, "CmdSetSrcBmpWidth" );
+            send_named( pdev, "CmdSetSrcBmpHeight" );
+            send_named( pdev, "CmdBeginRaster" );
+            tiff = has_command( pdev, "CmdEnableTIFF4" );
+            if (tiff) send_named( pdev, "CmdEnableTIFF4" );
+            else send_named( pdev, "CmdDisableCompression" );
+            in_raster = TRUE;
+        }
+        if (tiff) len = packbits( row, bytes, packed );
+        else len = bytes;
+        pdev->data_bytes = len;
+        pdev->width_bytes = bytes;
+        pdev->height_pixels = 1;
+        send_named( pdev, "CmdSendBlockData" );
+        unidrv_write( pdev, tiff ? packed : row, len );
+        send_named( pdev, "CmdEndBlockData" );
+    }
+    if (in_raster) send_named( pdev, "CmdEndRaster" );
+    pdev->cur_y = y0 + rows;
+    free( packed );
+    return TRUE;
+}
+
