+    DWORD i;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, box %p.\n", iface, box);
+
+    if (!box)
+        return D3DRMERR_BADVALUE;
+    memset(box, 0, sizeof(*box));
+    for (i = 0; i < mesh_builder->nb_vertices; ++i)
+    {
+        const D3DVECTOR *v = &mesh_builder->vertices[i];
+
+        if (!i || v->x < box->min.x) box->min.x = v->x;
+        if (!i || v->y < box->min.y) box->min.y = v->y;
+        if (!i || v->z < box->min.z) box->min.z = v->z;
+        if (!i || v->x > box->max.x) box->max.x = v->x;
+        if (!i || v->y > box->max.y) box->max.y = v->y;
+        if (!i || v->z > box->max.z) box->max.z = v->z;
+    }
+    return D3DRM_OK;
 }
 
