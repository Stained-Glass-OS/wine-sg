From: Stained Glass OS <ke7oxh@gmail.com>
d3drm: mesh builder vertex and normal accessors, boxes and flags

IDirect3DRMMeshBuilder2 and 3 implement SetVertex/SetNormal (and the
array forms), GetVertex/GetNormal, Translate, GetBox, ReserveSpace,
GetGeometry for version 3, the perspective flag, the color source and the
texture topology.
---
--- a/dlls/d3drm/d3drm_private.h
+++ b/dlls/d3drm/d3drm_private.h
@@ -229,6 +229,9 @@ struct d3drm_mesh_builder
     struct mesh_material *materials;
     DWORD *material_indices;
     D3DRMRENDERQUALITY quality;
+    D3DRMCOLORSOURCE color_source;
+    BOOL perspective;
+    BOOL wrap_u, wrap_v;
 };
 
 struct mesh_group
--- a/dlls/d3drm/meshbuilder.c
