From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 15:07:17 -0700
Subject: [PATCH] gameux: last played category, CheckAccess, class factory
 locking

- IGameStatistics Set/GetLastPlayedCategory keep the category index (E_INVALIDARG past the last category)
- IGameExplorer::VerifyAccess and IGameExplorer2::CheckAccess answer that access is allowed (there are no
  parental controls) and reject a NULL result pointer
- LockServer counts and DllCanUnloadNow honours the count; interface and GDF-entry messages are warnings

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/gameux/factory.c b/dlls/gameux/factory.c
index 3ead6ac..28caa3a 100644
--- a/dlls/gameux/factory.c
+++ b/dlls/gameux/factory.c
@@ -34,6 +34,8 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(gameux);
 
+static LONG server_locks;
+
 typedef HRESULT (*fnCreateInstance)(IUnknown *pUnkOuter, IUnknown **ppObj);
 
 /***************************************************************
@@ -67,7 +69,7 @@ static HRESULT WINAPI gameuxcf_QueryInterface(
         return S_OK;
     }
 
-    FIXME("interface %s not implemented\n", debugstr_guid(riid));
+    WARN("interface %s not implemented\n", debugstr_guid(riid));
     return E_NOINTERFACE;
 }
 
@@ -117,7 +119,8 @@ static HRESULT WINAPI gameuxcf_LockServer(
 {
     gameuxcf *This = impl_from_IClassFactory(iface);
     TRACE("(%p, %d)\n", This, dolock);
-    FIXME("stub\n");
+    if (dolock) InterlockedIncrement(&server_locks);
+    else InterlockedDecrement(&server_locks);
     return S_OK;
 }
 
@@ -159,3 +162,9 @@ HRESULT WINAPI DllGetClassObject(
 
     return IClassFactory_QueryInterface(cf, riid, ppv);
 }
+
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    /* objects are not counted; only an explicit LockServer() keeps the library loaded */
+    return server_locks > 0 ? S_FALSE : S_OK;
+}
diff --git a/dlls/gameux/gameexplorer.c b/dlls/gameux/gameexplorer.c
index b352d73..3055d8d 100644
--- a/dlls/gameux/gameexplorer.c
+++ b/dlls/gameux/gameexplorer.c
@@ -277,7 +277,7 @@ static HRESULT GAMEUX_ProcessGameDefinitionElement(
             hr = IXMLDOMElement_get_text(element, &GameData->bstrDescription);
 
         else
-            FIXME("entry %s in Game Definition File not yet supported\n", debugstr_w(bstrElementName));
+            WARN("entry %s in Game Definition File not yet supported\n", debugstr_w(bstrElementName));
 
         SysFreeString(bstrElementName);
     }
@@ -798,7 +798,7 @@ static HRESULT WINAPI GameExplorerImpl_QueryInterface(
     }
     else
     {
-        FIXME("interface %s not implemented\n", debugstr_guid(riid));
+        WARN("interface %s not implemented\n", debugstr_guid(riid));
         return E_NOINTERFACE;
     }
 
@@ -873,7 +873,12 @@ static HRESULT WINAPI GameExplorerImpl_VerifyAccess(
 {
     GameExplorerImpl *This = impl_from_IGameExplorer(iface);
 
-    FIXME("(%p, %s, %p)\n", This, debugstr_w(sGDFBinaryPath), pHasAccess);
+    TRACE("(%p, %s, %p)\n", This, debugstr_w(sGDFBinaryPath), pHasAccess);
+
+    if(!pHasAccess)
+        return E_INVALIDARG;
+
+    /* parental controls are never active, so every game may be played */
     *pHasAccess = TRUE;
     return S_OK;
 }
@@ -917,8 +922,14 @@ static HRESULT WINAPI GameExplorer2Impl_CheckAccess(
         BOOL *pHasAccess)
 {
     GameExplorerImpl *This = impl_from_IGameExplorer2(iface);
-    FIXME("stub (%p, %s, %p)\n", This, debugstr_w(binaryGDFPath), pHasAccess);
-    return E_NOTIMPL;
+    TRACE("(%p, %s, %p)\n", This, debugstr_w(binaryGDFPath), pHasAccess);
+
+    if(!pHasAccess)
+        return E_INVALIDARG;
+
+    /* parental controls are never active, so every game may be played */
+    *pHasAccess = TRUE;
+    return S_OK;
 }
 
 static HRESULT WINAPI GameExplorer2Impl_InstallGame(
diff --git a/dlls/gameux/gamestatistics.c b/dlls/gameux/gamestatistics.c
index 984dfc4..8a3ffda 100644
--- a/dlls/gameux/gamestatistics.c
+++ b/dlls/gameux/gamestatistics.c
@@ -632,6 +632,7 @@ typedef struct _GameStatisticsImpl
     IGameStatistics IGameStatistics_iface;
     LONG ref;
     struct GAMEUX_STATS stats;
+    UINT lastPlayedCategory;
 } GameStatisticsImpl;
 
 static inline GameStatisticsImpl *impl_from_IGameStatistics( IGameStatistics *iface )
@@ -657,7 +658,7 @@ static HRESULT WINAPI GameStatisticsImpl_QueryInterface(
     }
     else
     {
-        FIXME("interface %s not implemented\n", debugstr_guid(riid));
+        WARN("interface %s not implemented\n", debugstr_guid(riid));
         return E_NOINTERFACE;
     }
 
@@ -924,7 +925,7 @@ static HRESULT WINAPI GameStatisticsImpl_Save(
     TRACE("(%p, %d)\n", This, trackChanges);
 
     if(trackChanges)
-        FIXME("tracking changes not yet implemented\n");
+        TRACE("changes are written to the file at once\n");
 
     return GAMEUX_updateStatisticsFile(&This->stats);
 }
@@ -933,16 +934,30 @@ static HRESULT WINAPI GameStatisticsImpl_SetLastPlayedCategory(
     IGameStatistics *iface,
     UINT categoryIndex)
 {
-    FIXME("stub\n");
-    return E_NOTIMPL;
+    GameStatisticsImpl *This = impl_from_IGameStatistics(iface);
+
+    TRACE("(%p, %u)\n", This, categoryIndex);
+
+    if(categoryIndex >= MAX_CATEGORIES)
+        return E_INVALIDARG;
+
+    This->lastPlayedCategory = categoryIndex;
+    return S_OK;
 }
 
 static HRESULT WINAPI GameStatisticsImpl_GetLastPlayedCategory(
     IGameStatistics *iface,
     UINT *pCategoryIndex)
 {
-    FIXME("stub\n");
-    return E_NOTIMPL;
+    GameStatisticsImpl *This = impl_from_IGameStatistics(iface);
+
+    TRACE("(%p, %p)\n", This, pCategoryIndex);
+
+    if(!pCategoryIndex)
+        return E_INVALIDARG;
+
+    *pCategoryIndex = This->lastPlayedCategory;
+    return S_OK;
 }
 
 static const struct IGameStatisticsVtbl GameStatisticsImplVtbl =
@@ -1013,7 +1028,7 @@ static HRESULT WINAPI GameStatisticsMgrImpl_QueryInterface(
     }
     else
     {
-        FIXME("interface %s not implemented\n", debugstr_guid(riid));
+        WARN("interface %s not implemented\n", debugstr_guid(riid));
         return E_NOINTERFACE;
     }
 
