+static BOOL type_is(MimeBody *mb, const char *pri, const char *sub)
+{
+    return IMimeBody_IsContentType(&mb->IMimeBody_iface, pri, sub) == S_OK;
+}
+
+static DWORD tree_flags(struct list *bodies, BOOL top)
+{
+    DWORD flags = 0;
+    body_t *body;
+
+    LIST_FOR_EACH_ENTRY(body, bodies, body_t, entry)
+    {
+        MimeBody *mb = body->mime_body;
+
+        if (!list_empty(&body->children) || type_is(mb, "multipart", NULL))
+        {
+            if (!top || body->parent) flags |= IMF_SUBMULTIPART;
+            flags |= tree_flags(&body->children, FALSE);
+            continue;
+        }
+#ifndef SG_MUTANT_MSG_FLAGS_ATTACH
+        if (IMimeBody_IsType(&mb->IMimeBody_iface, IBT_ATTACHMENT) == S_OK) flags |= IMF_ATTACHMENTS;
+#endif
+        if (type_is(mb, "text", "html")) flags |= IMF_HTML | IMF_TEXT;
+        if (type_is(mb, "text", "plain")) flags |= IMF_PLAIN | IMF_TEXT;
+        if (type_is(mb, "text", "x-vcard") || type_is(mb, "text", "vcard")) flags |= IMF_HASVCARD;
+        if (type_is(mb, "message", "partial")) flags |= IMF_PARTIAL;
+        if (type_is(mb, "application", "ms-tnef")) flags |= IMF_TNEF;
+        if (type_is(mb, "application", "x-pkcs7-signature") || type_is(mb, "application", "pkcs7-signature"))
+            flags |= IMF_SIGNED | IMF_SECURE;
+        if (type_is(mb, "application", "x-pkcs7-mime") || type_is(mb, "application", "pkcs7-mime"))
+            flags |= IMF_ENCRYPTED | IMF_SECURE;
+        if (get_charset_param(mb)) flags |= IMF_CSETTAGGED;
+    }
+    return flags;
+}
+
 static HRESULT WINAPI MimeMessage_GetFlags(
     IMimeMessage *iface,
     DWORD *pdwFlags)
 {
-    FIXME("(%p)->(%p)\n", iface, pdwFlags);
-    return E_NOTIMPL;
+    MimeMessage *This = impl_from_IMimeMessage(iface);
+    body_t *root = root_body_of(This);
+    header_t *header;
+    DWORD flags = 0;
+
+    TRACE("(%p)->(%p)\n", iface, pdwFlags);
+
+    if (!pdwFlags) return E_INVALIDARG;
+    *pdwFlags = 0;
+    if (!root) return MIME_E_NO_DATA;
+
+    if (find_prop(root->mime_body, "MIME-Version", &header) == S_OK) flags |= IMF_MIME;
+    if (find_prop(root->mime_body, "Newsgroups", &header) == S_OK) flags |= IMF_NEWS;
+    if (type_is(root->mime_body, "multipart", NULL))
+    {
+        flags |= IMF_MULTIPART;
+        if (type_is(root->mime_body, "multipart", "signed")) flags |= IMF_SIGNED | IMF_SECURE;
+        if (type_is(root->mime_body, "multipart", "related")) flags |= IMF_MHTML;
+    }
+    flags |= tree_flags(&This->body_tree, TRUE);
+    if (get_charset_param(root->mime_body)) flags |= IMF_CSETTAGGED;
+    *pdwFlags = flags;
+    return S_OK;
 }
 
