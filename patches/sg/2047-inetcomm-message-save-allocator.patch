+static body_t *root_body_of(MimeMessage *msg)
+{
+    struct list *head = list_head(&msg->body_tree);
+    return head ? LIST_ENTRY(head, body_t, entry) : NULL;
+}
+
+static BOOL tree_is_dirty(struct list *bodies)
+{
+    body_t *body;
+
+    LIST_FOR_EACH_ENTRY(body, bodies, body_t, entry)
+        if (body->mime_body->dirty || tree_is_dirty(&body->children)) return TRUE;
+    return FALSE;
+}
+
+static void tree_clear_dirty(struct list *bodies)
+{
+    body_t *body;
+
+    LIST_FOR_EACH_ENTRY(body, bodies, body_t, entry)
+    {
+        body->mime_body->dirty = FALSE;
+        tree_clear_dirty(&body->children);
+    }
+}
+
+static HRESULT write_text(IStream *stream, const char *text)
+{
+    return IStream_Write(stream, text, strlen(text), NULL);
+}
+
+/* The boundary of a multipart body: the one it has, or a new one added to its Content-Type */
+static const char *body_boundary(MimeBody *mb)
+{
+    static LONG counter;
+    header_t *header;
+    param_t *param;
+    char name[64];
+
+    if (find_prop(mb, "Content-Type", &header) != S_OK) return NULL;
+    LIST_FOR_EACH_ENTRY(param, &header->params, param_t, entry)
+        if (!lstrcmpiA(param->name, "boundary")) return param->value;
+
+    if (!(param = malloc(sizeof(*param)))) return NULL;
+    sprintf(name, "----=_NextPart_%03lX_%08lX", InterlockedIncrement(&counter), GetTickCount());
+    param->name = strdup("boundary");
+    param->value = strdup(name);
+    list_add_tail(&header->params, &param->entry);
+    return param->value;
+}
+
+/* A body and everything below it as message text: a multipart body puts its parts between boundary lines */
+static HRESULT save_body_tree(body_t *body, IStream *out)
+{
+    MimeBody *mb = body->mime_body;
+    IMimeBody *iface = &mb->IMimeBody_iface;
+    const char *boundary;
+    body_t *child;
+    char *text;
+    size_t length;
+    HRESULT hr;
+
+    if (list_empty(&body->children) || IMimeBody_IsContentType(iface, "multipart", NULL) != S_OK)
+        return IMimeBody_Save(iface, out, FALSE);
+
+    if (!(boundary = body_boundary(mb))) return E_OUTOFMEMORY;
+    if (FAILED(hr = body_header_text(mb, &text, &length))) return hr;
+    hr = IStream_Write(out, text, length, NULL);
+    free(text);
+    if (SUCCEEDED(hr)) hr = write_text(out, "\r\n");
+
+    LIST_FOR_EACH_ENTRY(child, &body->children, body_t, entry)
+    {
+        if (FAILED(hr)) break;
+        if (SUCCEEDED(hr = write_text(out, "--"))) hr = write_text(out, boundary);
+        if (SUCCEEDED(hr)) hr = write_text(out, "\r\n");
+        if (SUCCEEDED(hr)) hr = save_body_tree(child, out);
+        if (SUCCEEDED(hr)) hr = write_text(out, "\r\n");
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = write_text(out, "--"))) hr = write_text(out, boundary);
+#ifdef SG_MUTANT_MSG_SAVE_BOUNDARY
+    return hr;
+#endif
+    if (SUCCEEDED(hr)) hr = write_text(out, "--\r\n");
+    return hr;
+}
+
+static HRESULT copy_whole_stream(IStream *in, IStream *out)
+{
+    LARGE_INTEGER zero = {{0}};
+    ULARGE_INTEGER max;
+    HRESULT hr;
+
+    max.QuadPart = ~0ull;
+    if (FAILED(hr = IStream_Seek(in, zero, STREAM_SEEK_SET, NULL))) return hr;
+    return IStream_CopyTo(in, out, max, NULL, NULL);
+}
+
+/* The message as text: the text it was loaded from while nothing changed, else built from its bodies */
+static HRESULT message_text(MimeMessage *This, IStream *out)
+{
+    body_t *root = root_body_of(This);
+
+    if (!root) return MIME_E_NO_DATA;
+#ifndef SG_MUTANT_MSG_SAVE_SOURCE
+    if (This->stream && !tree_is_dirty(&This->body_tree)) return copy_whole_stream(This->stream, out);
+#endif
+    return save_body_tree(root, out);
+}
+
+static HRESULT message_stream(MimeMessage *This, IStream **ret)
+{
+    LARGE_INTEGER zero = {{0}};
+    IStream *stream;
+    HRESULT hr;
+
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &stream))) return hr;
+    if (SUCCEEDED(hr = message_text(This, stream))) hr = IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    if (FAILED(hr))
+    {
+        IStream_Release(stream);
+        return hr;
+    }
+    *ret = stream;
+    return S_OK;
+}
+
 static HRESULT WINAPI MimeMessage_Save(IMimeMessage *iface, IStream *pStm, BOOL fClearDirty)
 {
-    FIXME("(%p)->(%p, %s)\n", iface, pStm, fClearDirty ? "TRUE" : "FALSE");
-    return E_NOTIMPL;
+    MimeMessage *This = impl_from_IMimeMessage(iface);
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %s)\n", iface, pStm, fClearDirty ? "TRUE" : "FALSE");
+
+    if (!pStm) return E_INVALIDARG;
+    if (FAILED(hr = message_text(This, pStm))) return hr;
+    if (fClearDirty) tree_clear_dirty(&This->body_tree);
+    return S_OK;
+}
+
+static HRESULT message_size(MimeMessage *This, ULARGE_INTEGER *size)
+{
+    IStream *stream;
+    STATSTG stat;
+    HRESULT hr;
+
+    if (FAILED(hr = message_stream(This, &stream))) return hr;
+    hr = IStream_Stat(stream, &stat, STATFLAG_NONAME);
+    IStream_Release(stream);
+    if (SUCCEEDED(hr)) *size = stat.cbSize;
+    return hr;
 }
 
