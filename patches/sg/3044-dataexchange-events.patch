From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 14:07:04 -0700
Subject: [PATCH] dataexchange: IInspectable answers and CoreDragDropManager
 events

GetIids, GetRuntimeClassName and GetTrustLevel report the real class information; add/remove_TargetRequested keep
the handlers with unique tokens (removing an unknown token succeeds), AreConcurrentOperationsEnabled is a stored
property (default false), GetForCurrentView reports that the thread has no window. todo_wine marks that pass are removed.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/dataexchange/main.c b/dlls/dataexchange/main.c
index cc39c5c..75b282f 100644
--- a/dlls/dataexchange/main.c
+++ b/dlls/dataexchange/main.c
@@ -20,6 +20,28 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(dataexchange);
 
+static HRESULT inspectable_get_iids(const IID *iids, ULONG count, ULONG *iid_count, IID **out)
+{
+    IID *copy;
+
+    if (!iid_count || !out) return E_POINTER;
+    *iid_count = 0;
+    *out = NULL;
+    if (!(copy = CoTaskMemAlloc(count * sizeof(*copy)))) return E_OUTOFMEMORY;
+    memcpy(copy, iids, count * sizeof(*copy));
+    *out = copy;
+    *iid_count = count;
+    return S_OK;
+}
+
+static HRESULT inspectable_get_class_name(HSTRING *class_name)
+{
+    static const WCHAR name[] = L"Windows.ApplicationModel.DataTransfer.DragDrop.Core.CoreDragDropManager";
+
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString(name, ARRAY_SIZE(name) - 1, class_name);
+}
+
 struct dataexchange
 {
     IActivationFactory IActivationFactory_iface;
@@ -62,7 +84,7 @@ static HRESULT STDMETHODCALLTYPE dataexchange_QueryInterface(IActivationFactory
         return S_OK;
     }
 
-    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -86,28 +108,41 @@ static ULONG STDMETHODCALLTYPE dataexchange_Release(IActivationFactory *iface)
 static HRESULT STDMETHODCALLTYPE dataexchange_GetIids(IActivationFactory *iface, ULONG *iid_count,
                                                       IID **iids)
 {
-    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
-    return E_NOTIMPL;
+    IID list[3];
+
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+
+    list[0] = IID_IActivationFactory;
+    list[1] = IID_ICoreDragDropManagerStatics;
+    list[2] = IID_IDragDropManagerInterop;
+    return inspectable_get_iids(list, 3, iid_count, iids);
 }
 
 static HRESULT STDMETHODCALLTYPE dataexchange_GetRuntimeClassName(IActivationFactory *iface,
                                                                   HSTRING *class_name)
 {
-    FIXME("iface %p, class_name %p stub!\n", iface, class_name);
-    return E_NOTIMPL;
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+    return inspectable_get_class_name(class_name);
 }
 
 static HRESULT STDMETHODCALLTYPE dataexchange_GetTrustLevel(IActivationFactory *iface,
                                                             TrustLevel *trust_level)
 {
-    FIXME("iface %p, trust_level %p stub!\n", iface, trust_level);
-    return E_NOTIMPL;
+    TRACE("iface %p, trust_level %p.\n", iface, trust_level);
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE dataexchange_ActivateInstance(IActivationFactory *iface,
                                                                IInspectable **instance)
 {
-    FIXME("iface %p, instance %p stub!\n", iface, instance);
+    TRACE("iface %p, instance %p.\n", iface, instance);
+
+    /* the class only has static members: it cannot be activated without arguments */
+    if (!instance) return E_POINTER;
+    *instance = NULL;
     return E_NOTIMPL;
 }
 
@@ -124,11 +159,23 @@ static const struct IActivationFactoryVtbl activation_factory_vtbl =
     dataexchange_ActivateInstance,
 };
 
+struct target_handler
+{
+    ITypedEventHandler_CoreDragDropManager_CoreDropOperationTargetRequestedEventArgs *handler;
+    INT64 token;
+};
+
 struct core_dragdrop_manager
 {
     ICoreDragDropManager ICoreDragDropManager_iface;
     HWND hwnd;
     LONG ref;
+
+    CRITICAL_SECTION cs;
+    struct target_handler *handlers;
+    unsigned int handler_count;
+    INT64 next_token;
+    boolean concurrent;
 };
 
 static inline struct core_dragdrop_manager *impl_from_ICoreDragDropManager(ICoreDragDropManager *iface)
@@ -150,7 +197,7 @@ static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_QueryInterface(ICoreDragD
         return S_OK;
     }
 
-    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -171,7 +218,15 @@ static ULONG STDMETHODCALLTYPE core_dragdrop_manager_Release(ICoreDragDropManage
     TRACE("iface %p, ref %lu.\n", iface, ref);
 
     if (!ref)
+    {
+        unsigned int i;
+
+        for (i = 0; i < impl->handler_count; i++)
+            ITypedEventHandler_CoreDragDropManager_CoreDropOperationTargetRequestedEventArgs_Release(impl->handlers[i].handler);
+        free(impl->handlers);
+        DeleteCriticalSection(&impl->cs);
         free(impl);
+    }
 
     return ref;
 }
@@ -179,52 +234,103 @@ static ULONG STDMETHODCALLTYPE core_dragdrop_manager_Release(ICoreDragDropManage
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_GetIids(ICoreDragDropManager *iface,
                                                                ULONG *iid_count, IID **iids)
 {
-    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
-    return E_NOTIMPL;
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+    return inspectable_get_iids(&IID_ICoreDragDropManager, 1, iid_count, iids);
 }
 
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_GetRuntimeClassName(ICoreDragDropManager *iface,
                                                                            HSTRING *class_name)
 {
-    FIXME("iface %p, class_name %p stub!\n", iface, class_name);
-    return E_NOTIMPL;
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+    return inspectable_get_class_name(class_name);
 }
 
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_GetTrustLevel(ICoreDragDropManager *iface,
                                                                      TrustLevel *trust_level)
 {
-    FIXME("iface %p, trust_level %p stub!\n", iface, trust_level);
-    return E_NOTIMPL;
+    TRACE("iface %p, trust_level %p.\n", iface, trust_level);
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_add_TargetRequested(ICoreDragDropManager *iface,
                                                                            ITypedEventHandler_CoreDragDropManager_CoreDropOperationTargetRequestedEventArgs *value,
                                                                            EventRegistrationToken *return_value)
 {
-    FIXME("iface %p, value %p, return_value %p stub!\n", iface, value, return_value);
-    return_value->value = 0xdeadbeef;
+    struct core_dragdrop_manager *impl = impl_from_ICoreDragDropManager(iface);
+    struct target_handler *handlers;
+
+    TRACE("iface %p, value %p, return_value %p.\n", iface, value, return_value);
+
+    if (!return_value) return E_POINTER;
+    return_value->value = 0;
+    if (!value) return E_INVALIDARG;
+
+    EnterCriticalSection(&impl->cs);
+    if (!(handlers = realloc(impl->handlers, (impl->handler_count + 1) * sizeof(*handlers))))
+    {
+        LeaveCriticalSection(&impl->cs);
+        return E_OUTOFMEMORY;
+    }
+    impl->handlers = handlers;
+    ITypedEventHandler_CoreDragDropManager_CoreDropOperationTargetRequestedEventArgs_AddRef(value);
+    handlers[impl->handler_count].handler = value;
+    handlers[impl->handler_count].token = ++impl->next_token;
+    return_value->value = impl->next_token;
+    impl->handler_count++;
+    LeaveCriticalSection(&impl->cs);
     return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_remove_TargetRequested(ICoreDragDropManager *iface,
                                                                               EventRegistrationToken value)
 {
-    FIXME("iface %p, value %#I64x stub!\n", iface, value.value);
-    return E_NOTIMPL;
+    struct core_dragdrop_manager *impl = impl_from_ICoreDragDropManager(iface);
+    unsigned int i;
+
+    TRACE("iface %p, value %#I64x.\n", iface, value.value);
+
+    EnterCriticalSection(&impl->cs);
+    for (i = 0; i < impl->handler_count; i++)
+    {
+        if (impl->handlers[i].token != value.value) continue;
+        ITypedEventHandler_CoreDragDropManager_CoreDropOperationTargetRequestedEventArgs_Release(impl->handlers[i].handler);
+        impl->handlers[i] = impl->handlers[--impl->handler_count];
+        break;
+    }
+    LeaveCriticalSection(&impl->cs);
+
+    /* removing a token that is not registered is not an error */
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_get_AreConcurrentOperationsEnabled(ICoreDragDropManager *iface,
                                                                                           boolean *value)
 {
-    FIXME("iface %p, value %p stub!\n", iface, value);
-    return E_NOTIMPL;
+    struct core_dragdrop_manager *impl = impl_from_ICoreDragDropManager(iface);
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection(&impl->cs);
+    *value = impl->concurrent;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_put_AreConcurrentOperationsEnabled(ICoreDragDropManager *iface,
                                                                                           boolean value)
 {
-    FIXME("iface %p, value %d stub!\n", iface, value);
-    return E_NOTIMPL;
+    struct core_dragdrop_manager *impl = impl_from_ICoreDragDropManager(iface);
+
+    TRACE("iface %p, value %d.\n", iface, value);
+
+    EnterCriticalSection(&impl->cs);
+    impl->concurrent = !!value;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
 }
 
 static const struct ICoreDragDropManagerVtbl core_dragdrop_manager_vtbl =
@@ -260,6 +366,7 @@ static HRESULT create_core_dragdrop_manager(HWND hwnd, REFIID iid, void **out)
     manager->ICoreDragDropManager_iface.lpVtbl = &core_dragdrop_manager_vtbl;
     manager->hwnd = hwnd;
     manager->ref = 1;
+    InitializeCriticalSection(&manager->cs);
     hr = ICoreDragDropManager_QueryInterface(&manager->ICoreDragDropManager_iface, iid, out);
     ICoreDragDropManager_Release(&manager->ICoreDragDropManager_iface);
     return hr;
@@ -271,8 +378,13 @@ DEFINE_IINSPECTABLE(core_dragdrop_manager_statics, ICoreDragDropManagerStatics,
 static HRESULT STDMETHODCALLTYPE core_dragdrop_manager_statics_GetForCurrentView(ICoreDragDropManagerStatics *iface,
                                                                                  ICoreDragDropManager **value)
 {
-    FIXME("iface %p, value %p stub!\n", iface, value);
-    return E_NOTIMPL;
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+
+    /* the thread has no core window: only desktop windows exist here */
+    return HRESULT_FROM_WIN32(ERROR_INVALID_WINDOW_HANDLE);
 }
 
 static const struct ICoreDragDropManagerStaticsVtbl core_dragdrop_manager_statics_vtbl =
@@ -294,8 +406,9 @@ DEFINE_IINSPECTABLE(dragdrop_manager_interop, IDragDropManagerInterop, struct da
 static HRESULT STDMETHODCALLTYPE dragdrop_manager_interop_GetForWindow(IDragDropManagerInterop *iface,
                                                                        HWND hwnd, REFIID iid, void **out)
 {
-    FIXME("iface %p, hwnd %p, iid %s, out %p semi-stub!\n", iface, hwnd, debugstr_guid(iid), out);
+    TRACE("iface %p, hwnd %p, iid %s, out %p.\n", iface, hwnd, debugstr_guid(iid), out);
 
+    if (!out) return E_POINTER;
     return create_core_dragdrop_manager(hwnd, iid, out);
 }
 
@@ -322,7 +435,10 @@ static struct dataexchange dataexchange =
 
 HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **out)
 {
-    FIXME("clsid %s, riid %s, out %p stub!\n", debugstr_guid(clsid), debugstr_guid(riid), out);
+    TRACE("clsid %s, riid %s, out %p.\n", debugstr_guid(clsid), debugstr_guid(riid), out);
+
+    /* the classes are WinRT classes: they are reached through DllGetActivationFactory */
+    if (out) *out = NULL;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
