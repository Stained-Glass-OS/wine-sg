From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, win32u: each person has a logon SID; window stations and desktops name it

On Windows every logon has a logon SID of its own (S-1-5-5-X-Y), its tokens
hold it, and winlogon's descriptor on the logon's WinSta0 and desktops grants
it full access. Sandboxed processes depend on that: Chromium's USER_LIMITED
token (its GPU, audio and utility processes) restricts to Users, Everyone,
RESTRICTED and the logon SID, so only the logon SID lets it use the desktop.
And Windows connects a process to its desktop with MAXIMUM_ALLOWED, so a
renderer on Chromium's alternate desktop, which denies RESTRICTED its write
rights, still gets the desktop with the rights it has.

In Wine:
- every token had the same logon SID, S-1-5-5-0-0 -- every user's and
  SYSTEM's. No descriptor could name it without opening every user's desktop
  to every other user, so 1707's descriptor did not.
- in a single user's prefix window stations and desktops had no descriptor
  at all. Chromium's sandbox (and QtWebEngine's: Jellyfin Media Player,
  TeamSpeak 3) merges its denial of RESTRICTED into the alternate desktop's
  DACL; merged into nothing, the DACL was that one denial, and the renderers
  were denied the desktop ("get_desktop_window failed to create desktop
  window"; the renderer hung).
- a process asked for every right on its desktop; denied one, it kept the
  handle the server had opened for it with its parent's token instead.

Now:
- in a shared prefix each person has a logon SID of their own: X is drawn
  when the server starts (no saved ACL names a later boot's logon), Y numbers
  the people. Every token made for a person (own, elevated, linked, a
  session's, LogonUser's) holds that person's and no other's, so naming it
  grants nothing the person's own SID was not already granted. SYSTEM keeps
  S-1-5-5-0-0, which no descriptor names.
- a window station's or desktop's descriptor (1707) also grants the logon
  SID full access: in a shared prefix the session's person's (never the
  creator's), in a single user's prefix the creator's -- which now get a
  descriptor too: SYSTEM and the creator full access, Administrators read.
- a process is connected to its window station and desktop with
  MAXIMUM_ALLOWED when the full request is denied, as on Windows.

Nobody gains access to another user's window station or desktop: the logon
ACE names a SID only the session's own person's tokens carry, and
MAXIMUM_ALLOWED grants only what the DACL grants.

Gates: test/logondesk-gate.sh (a single user's prefix: the DACL, a renderer
and USER_LIMITED children on Chromium's alternate desktop and on the user's
own), test/logondesk-users-gate.sh (sgsystem, sgtest1, sgtest2 on one shared
prefix: own logon SIDs, the descriptor, a USER_LIMITED child, the other user
still denied). Mutants SG_MUTANT_SHARED_LOGON_SID, SG_MUTANT_NO_LOGON_ACE,
SG_MUTANT_SINGLE_USER_NO_DESKTOP_SD, SG_MUTANT_DESKTOP_FULL_ACCESS_ONLY.
---
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -1097,6 +1097,13 @@
                                     dir, NULL );
 
         handle = NtUserCreateWindowStation( &attr, STANDARD_RIGHTS_REQUIRED | WINSTA_ALL_ACCESS, 0, 0, 0, 0, 0 );
+        /* Stained Glass OS 9060: as on Windows, a process is connected to its window station and
+         * desktop with the rights it has (MAXIMUM_ALLOWED): a sandboxed process denied some of them
+         * (Chromium's renderers, on a desktop that denies RESTRICTED) still gets one */
+#ifndef SG_MUTANT_DESKTOP_FULL_ACCESS_ONLY
+        if (!handle && RtlGetLastWin32Error() == ERROR_ACCESS_DENIED)
+            handle = NtUserCreateWindowStation( &attr, MAXIMUM_ALLOWED, 0, 0, 0, 0, 0 );
+#endif
         if (handle)
         {
             NtUserSetProcessWindowStation( handle );
@@ -1132,6 +1139,10 @@
                                     dir, NULL );
 
         handle = NtUserCreateDesktopEx( &attr, NULL, NULL, 0, STANDARD_RIGHTS_REQUIRED | DESKTOP_ALL_ACCESS, 0 );
+#ifndef SG_MUTANT_DESKTOP_FULL_ACCESS_ONLY
+        if (!handle && RtlGetLastWin32Error() == ERROR_ACCESS_DENIED)  /* 9060: see above */
+            handle = NtUserCreateDesktopEx( &attr, NULL, NULL, 0, MAXIMUM_ALLOWED, 0 );
+#endif
         if (handle) NtUserSetThreadDesktop( handle );
     }
     NtClose( dir );
--- a/server/security.h
+++ b/server/security.h
@@ -74,7 +74,10 @@
 extern struct security_descriptor *sg_create_owner_sd( const struct sid *user_sid );
 extern struct security_descriptor *sg_create_process_sd( struct token *token, unsigned int limited );
 extern struct security_descriptor *sg_create_session_object_sd( const struct sid *creator, const struct sid *session_user,
+                                                                const struct sid *logon,
                                                                 unsigned int all_access, unsigned int read_access );
+extern int sg_logon_sid_for_uid( uid_t uid, struct sid *sid );
+extern const struct sid *token_get_logon_sid( struct token *token );
 extern const struct sid local_system_sid;
 extern const struct sid builtin_users_sid;
 extern const struct sid builtin_admins_sid;
--- a/server/token.c
+++ b/server/token.c
@@ -667,19 +667,21 @@
  * owner is the creator. The rights are the object type's own, as Windows
  * stores them (its GENERIC_ALL and GENERIC_READ mapped). */
 struct security_descriptor *sg_create_session_object_sd( const struct sid *creator, const struct sid *session_user,
+                                                         const struct sid *logon,
                                                          unsigned int all_access, unsigned int read_access )
 {
     struct sid alias_admins_sid = { SID_REVISION, 2, SECURITY_NT_AUTHORITY, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS }};
     const struct sid *owner = creator ? creator : &local_system_sid;
     int own = creator && !equal_sid( creator, &local_system_sid );
     int user = session_user && !equal_sid( session_user, &local_system_sid ) && !(own && equal_sid( session_user, creator ));
-    unsigned int count = 2 + own + user;
+    unsigned int count = 2 + own + user + !!logon;
     struct security_descriptor *sd;
     size_t owner_len = sid_len( owner );
     size_t group_len = sid_len( &domain_users_sid );
     size_t dacl_len = sizeof(struct acl) + count * sizeof(struct ace) +
                       sid_len( &local_system_sid ) + sid_len( &alias_admins_sid ) +
-                      (own ? sid_len( creator ) : 0) + (user ? sid_len( session_user ) : 0);
+                      (own ? sid_len( creator ) : 0) + (user ? sid_len( session_user ) : 0) +
+                      (logon ? sid_len( logon ) : 0);
     struct acl *dacl;
     struct ace *ace;
     char *ptr;
@@ -702,10 +704,68 @@
     ace = set_ace( ace_first( dacl ), &local_system_sid, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
     ace = set_ace( ace_next( ace ), &alias_admins_sid, ACCESS_ALLOWED_ACE_TYPE, 0, read_access );
     if (own) ace = set_ace( ace_next( ace ), creator, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
-    if (user) set_ace( ace_next( ace ), session_user, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
+    if (user) ace = set_ace( ace_next( ace ), session_user, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
+    /* 9060: and the logon, as winlogon grants it: what lets the session's restricted (sandboxed)
+     * programs, whose restricting SIDs name the logon SID but not the user, use the desktop */
+    if (logon) set_ace( ace_next( ace ), logon, ACCESS_ALLOWED_ACE_TYPE, 0, all_access );
     return sd;
 }
 
+/* Stained Glass OS (9060): logon SIDs. On Windows every logon has a logon SID of its own,
+ * S-1-5-5-X-Y, which its tokens hold (SE_GROUP_LOGON_ID) and winlogon's descriptor on the
+ * logon's WinSta0 and desktops names -- restricted tokens (Chromium's and QtWebEngine's sandboxed
+ * processes) keep it among their restricting SIDs to be able to use the desktop at all. Upstream
+ * Wine gives every token the same S-1-5-5-0-0. In a prefix shared between users a descriptor
+ * naming that SID would be open to every user, so here each person has a logon SID of their own:
+ * X is drawn when the server starts (an ACL saved somewhere never names a later boot's logon),
+ * Y numbers the people in the order they first get a token. Every token made for a person
+ * (theirs, elevated, linked, a session token, LogonUser's) holds that person's logon SID and no
+ * other person's, so naming it grants no more than naming the person does. SYSTEM (and anyone
+ * past the table's end) keeps S-1-5-5-0-0, which no descriptor here names. */
+static struct { uid_t uid; unsigned int id; } sg_logon_map[200];
+static unsigned int sg_logon_count, sg_logon_high;
+
+int sg_logon_sid_for_uid( uid_t uid, struct sid *sid )
+{
+    unsigned int i, id = 0;
+
+    if (!sg_system_prefix || !uid || uid == sg_system_prefix_uid) return 0;
+    if (!sg_logon_high)
+    {
+        if (getrandom( &sg_logon_high, sizeof(sg_logon_high), GRND_NONBLOCK ) != sizeof(sg_logon_high))
+            sg_logon_high = (unsigned int)time( NULL ) ^ ((unsigned int)getpid() << 16);
+        sg_logon_high = (sg_logon_high & 0x7fffffff) | 0x10000;  /* never 0: 0-0 is SYSTEM's */
+    }
+    for (i = 0; i < sg_logon_count; i++) if (sg_logon_map[i].uid == uid) id = sg_logon_map[i].id;
+    if (!id)
+    {
+        if (sg_logon_count == ARRAY_SIZE(sg_logon_map)) return 0;
+        sg_logon_map[sg_logon_count].uid = uid;
+        id = sg_logon_map[sg_logon_count].id = 1000 + sg_logon_count;
+        sg_logon_count++;
+    }
+    sid->revision = SID_REVISION;
+    sid->sub_count = 3;
+    memcpy( sid->id_auth, local_system_sid.id_auth, sizeof(sid->id_auth) );
+    sid->sub_auth[0] = SECURITY_LOGON_IDS_RID;
+    sid->sub_auth[1] = sg_logon_high;
+    sid->sub_auth[2] = id;
+#ifdef SG_MUTANT_SHARED_LOGON_SID
+    sid->sub_auth[1] = sid->sub_auth[2] = 0;  /* everybody's, as upstream: the desktops open to all */
+#endif
+    return 1;
+}
+
+/* the token's logon SID (the group marked SE_GROUP_LOGON_ID), if it has one */
+const struct sid *token_get_logon_sid( struct token *token )
+{
+    const struct group *group;
+
+    LIST_FOR_EACH_ENTRY( group, &token->groups, const struct group, entry )
+        if (group->attrs & SE_GROUP_LOGON_ID) return &group->sid;
+    return NULL;
+}
+
 /* Stained Glass OS (multi-user debt D17): in a prefix shared between Unix
  * users, the server's token requests are a privilege boundary. Upstream Wine
  * mints tokens for anyone who asks -- every process there is its user's
@@ -1712,6 +1772,8 @@
     int primary_group = 4 /* domain_users */;
 
     if (!default_dacl) return NULL;
+    /* Stained Glass OS 9060: the person's own logon SID (sg_logon_sid_for_uid) */
+    sg_logon_sid_for_uid( uid, &logon_sid );
 
     /* A domain account also holds its domain groups, and the first of them
      * (its primaryGroupID, normally Domain Users) is its primary group. The
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -141,16 +141,41 @@
 static void sg_set_session_object_sd( struct object *obj, const struct type_descr *type )
 {
     struct security_descriptor *sd;
-    const struct sid *creator = NULL, *user = NULL;
+    const struct sid *creator = NULL, *user = NULL, *logon = NULL;
+    struct sid logon_sid;
     uid_t uid;
 
 #ifdef SG_MUTANT_OPEN_WINSTATIONS
     return;
 #endif
-    if (!sg_system_prefix || !current) return;
-    if (current->process->token) creator = token_get_user( current->process->token );
-    if (sg_session_user( current->process->session_id, &uid )) user = security_unix_uid_to_sid( uid );
-    if (!(sd = sg_create_session_object_sd( creator, user, type->mapping.all, type->mapping.read ))) return;
+    if (!current) return;
+    /* 9060: Windows gives every window station and desktop a descriptor; one made with none
+     * comes from its creator's (CreateWindowStation), or from its window station's (CreateDesktop),
+     * which for WinSta0 is winlogon's. A single user's prefix had none: Chromium's sandbox merges
+     * its denial of RESTRICTED into the desktop's DACL, which, merged into nothing, is that one
+     * denial -- the sandboxed renderers (Chromium, QtWebEngine) were then denied the desktop. */
+    if (!sg_system_prefix)
+    {
+#ifdef SG_MUTANT_SINGLE_USER_NO_DESKTOP_SD
+        return;
+#endif
+        if (!current->process->token) return;
+        creator = token_get_user( current->process->token );
+        logon = token_get_logon_sid( current->process->token );
+    }
+    else
+    {
+        if (current->process->token) creator = token_get_user( current->process->token );
+        if (sg_session_user( current->process->session_id, &uid ))
+        {
+            user = security_unix_uid_to_sid( uid );
+            /* 9060: the session's person's logon SID, never the creator's (sg_logon_sid_for_uid) */
+#ifndef SG_MUTANT_NO_LOGON_ACE
+            if (sg_logon_sid_for_uid( uid, &logon_sid )) logon = &logon_sid;
+#endif
+        }
+    }
+    if (!(sd = sg_create_session_object_sd( creator, user, logon, type->mapping.all, type->mapping.read ))) return;
     free( obj->sd );
     obj->sd = sd;
 }
