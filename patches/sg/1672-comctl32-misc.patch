+/* an icon flipped left to right: a new one; the old one is destroyed */
+static BOOL mirror_icon(HICON *icon)
+{
+    ICONINFO info;
+    BITMAP bm;
+    HBITMAP color = NULL, mask = NULL;
+    HDC src, dst;
+    HICON mirrored;
+    BOOL ret = FALSE;
+
+    if (!*icon) return TRUE;
+    if (!GetIconInfo(*icon, &info)) return FALSE;
+    GetObjectW(info.hbmMask, sizeof(bm), &bm);
+    src = CreateCompatibleDC(0);
+    dst = CreateCompatibleDC(0);
+    mask = CreateBitmap(bm.bmWidth, bm.bmHeight, 1, 1, NULL);
+    SelectObject(src, info.hbmMask);
+    SelectObject(dst, mask);
+    StretchBlt(dst, bm.bmWidth - 1, 0, -bm.bmWidth, bm.bmHeight, src, 0, 0, bm.bmWidth, bm.bmHeight, SRCCOPY);
+    if (info.hbmColor)
+    {
+        BITMAP cbm;
+        BITMAPINFO bi = {{ sizeof(BITMAPINFOHEADER), 0, 0, 1, 32, BI_RGB }};
+        void *bits;
+
+        GetObjectW(info.hbmColor, sizeof(cbm), &cbm);
+        bi.bmiHeader.biWidth = cbm.bmWidth;
+        bi.bmiHeader.biHeight = cbm.bmHeight;
+        color = CreateDIBSection(dst, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+        SelectObject(src, info.hbmColor);
+        SelectObject(dst, color);
+        StretchBlt(dst, cbm.bmWidth - 1, 0, -cbm.bmWidth, cbm.bmHeight, src, 0, 0, cbm.bmWidth, cbm.bmHeight, SRCCOPY);
+    }
+    DeleteDC(src);
+    DeleteDC(dst);
+    DeleteObject(info.hbmMask);
+    if (info.hbmColor) DeleteObject(info.hbmColor);
+    info.hbmMask = mask;
+    info.hbmColor = color;
+    if ((mirrored = CreateIconIndirect(&info)))
+    {
+        DestroyIcon(*icon);
+        *icon = mirrored;
+        ret = TRUE;
+    }
+    if (mask) DeleteObject(mask);
+    if (color) DeleteObject(color);
+    return ret;
+}
+
 BOOL WINAPI MirrorIcon(HICON *phicon1, HICON *phicon2)
 {
-    FIXME("(%p, %p): stub\n", phicon1, phicon2);
-    return FALSE;
+    BOOL ret = TRUE;
+
+    TRACE("(%p, %p)\n", phicon1, phicon2);
+
+    /* the icons (either may be absent) are replaced by mirrored ones */
+#ifndef SG_MUTANT_NO_MIRROR
+    if (phicon1 && !mirror_icon(phicon1)) ret = FALSE;
+    if (phicon2 && !mirror_icon(phicon2)) ret = FALSE;
+#endif
+    return ret;
 }
 
