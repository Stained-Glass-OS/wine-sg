+/* Stained Glass OS 1672: an app-defined field ('X'..., FORMATCALLBACK):
+ * its format string, and what the parent says to show in it */
+static BOOL DATETIME_IsCallbackField(int spec)
+{
+    return !(spec & DT_STRING) && (spec & FORMATCALLMASK) && spec != FORMATCALLMASK;
+}
+
+static void DATETIME_CallbackFormat(int spec, WCHAR *format, int size)
+{
+    int n = min(spec - FORMATCALLMASK, size - 1), i;
+    for (i = 0; i < n; i++) format[i] = 'X';
+    format[n] = 0;
+}
+
+static void DATETIME_InitHeader(const DATETIME_INFO *infoPtr, NMHDR *hdr, UINT code)
+{
+    hdr->hwndFrom = infoPtr->hwndSelf;
+    hdr->idFrom = GetWindowLongPtrW(infoPtr->hwndSelf, GWLP_ID);
+    hdr->code = code;
+}
+
+static void DATETIME_CallbackText(const DATETIME_INFO *infoPtr, int spec, LPWSTR result, int size)
+{
+    WCHAR format[32];
+    NMDATETIMEFORMATW nmf;
+
+    DATETIME_CallbackFormat(spec, format, ARRAY_SIZE(format));
+    memset(&nmf, 0, sizeof(nmf));
+    DATETIME_InitHeader(infoPtr, &nmf.nmhdr, DTN_FORMATW);
+    nmf.pszFormat = format;
+    nmf.st = infoPtr->date;
+    nmf.pszDisplay = nmf.szDisplay;
+    SendMessageW(infoPtr->hwndNotify, WM_NOTIFY, nmf.nmhdr.idFrom, (LPARAM)&nmf);
+    lstrcpynW(result, nmf.pszDisplay ? nmf.pszDisplay : L"", size);
+}
+
