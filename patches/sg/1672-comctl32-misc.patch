+/* Stained Glass OS 1672: TCS_EX_REGISTERDROP. The tab control is a drop
+ * target; over a tab it asks its parent for that tab's own drop target
+ * (TCN_GETOBJECT) and hands it the drag. */
+struct tab_drop
+{
+    IDropTarget IDropTarget_iface;
+    LONG ref;
+    TAB_INFO *info;             /* cleared when the control goes */
+    IDropTarget *current;
+    INT current_item;
+    IDataObject *data;
+};
+
+static inline struct tab_drop *tab_drop_from_iface(IDropTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct tab_drop, IDropTarget_iface);
+}
+
+static HRESULT WINAPI tab_drop_QueryInterface(IDropTarget *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDropTarget))
+    {
+        *out = iface;
+        IDropTarget_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI tab_drop_AddRef(IDropTarget *iface)
+{
+    return InterlockedIncrement(&tab_drop_from_iface(iface)->ref);
+}
+
+static ULONG WINAPI tab_drop_Release(IDropTarget *iface)
+{
+    struct tab_drop *drop = tab_drop_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&drop->ref);
+
+    if (!ref)
+    {
+        if (drop->current) IDropTarget_Release(drop->current);
+        if (drop->data) IDataObject_Release(drop->data);
+        Free(drop);
+    }
+    return ref;
+}
+
+static IDropTarget *tab_drop_target_at(struct tab_drop *drop, POINTL ptl, INT *item)
+{
+    TAB_INFO *infoPtr = drop->info;
+    NMOBJECTNOTIFY nmo;
+    POINT pt = { ptl.x, ptl.y };
+    UINT flags;
+
+    *item = -1;
+    if (!infoPtr) return NULL;
+    ScreenToClient(infoPtr->hwnd, &pt);
+    if ((*item = TAB_InternalHitTest(infoPtr, pt, &flags)) < 0) return NULL;
+    memset(&nmo, 0, sizeof(nmo));
+    nmo.hdr.hwndFrom = infoPtr->hwnd;
+    nmo.hdr.idFrom = GetWindowLongPtrW(infoPtr->hwnd, GWLP_ID);
+    nmo.hdr.code = TCN_GETOBJECT;
+    nmo.iItem = *item;
+    nmo.piid = &IID_IDropTarget;
+    nmo.hResult = E_NOINTERFACE;
+    SendMessageW(infoPtr->hwndNotify, WM_NOTIFY, nmo.hdr.idFrom, (LPARAM)&nmo);
+    if (FAILED(nmo.hResult) || !nmo.pObject) return NULL;
+    return nmo.pObject;
+}
+
+static HRESULT WINAPI tab_drop_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct tab_drop *drop = tab_drop_from_iface(iface);
+
+    if (drop->data) IDataObject_Release(drop->data);
+    if ((drop->data = data)) IDataObject_AddRef(data);
+    if (drop->current) IDropTarget_Release(drop->current);
+    drop->current = tab_drop_target_at(drop, pt, &drop->current_item);
+    if (drop->current) return IDropTarget_DragEnter(drop->current, data, keys, pt, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI tab_drop_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct tab_drop *drop = tab_drop_from_iface(iface);
+    IDropTarget *target;
+    INT item;
+
+    target = tab_drop_target_at(drop, pt, &item);
+    if (item == drop->current_item && target == drop->current)
+    {
+        if (target) IDropTarget_Release(target);
+        if (drop->current) return IDropTarget_DragOver(drop->current, keys, pt, effect);
+        *effect = DROPEFFECT_NONE;
+        return S_OK;
+    }
+    if (drop->current)
+    {
+        IDropTarget_DragLeave(drop->current);
+        IDropTarget_Release(drop->current);
+    }
+    drop->current = target;
+    drop->current_item = item;
+    if (target && drop->data) return IDropTarget_DragEnter(target, drop->data, keys, pt, effect);
+    *effect = DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI tab_drop_DragLeave(IDropTarget *iface)
+{
+    struct tab_drop *drop = tab_drop_from_iface(iface);
+
+    if (drop->current)
+    {
+        IDropTarget_DragLeave(drop->current);
+        IDropTarget_Release(drop->current);
+        drop->current = NULL;
+    }
+    drop->current_item = -1;
+    return S_OK;
+}
+
+static HRESULT WINAPI tab_drop_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct tab_drop *drop = tab_drop_from_iface(iface);
+    HRESULT hr = S_OK;
+
+    if (drop->current)
+    {
+        hr = IDropTarget_Drop(drop->current, data, keys, pt, effect);
+        IDropTarget_Release(drop->current);
+        drop->current = NULL;
+    }
+    else *effect = DROPEFFECT_NONE;
+    drop->current_item = -1;
+    return hr;
+}
+
+static const IDropTargetVtbl tab_drop_vtbl =
+{
+    tab_drop_QueryInterface,
+    tab_drop_AddRef,
+    tab_drop_Release,
+    tab_drop_DragEnter,
+    tab_drop_DragOver,
+    tab_drop_DragLeave,
+    tab_drop_Drop,
+};
+
+static void TAB_RegisterDrop(TAB_INFO *infoPtr, BOOL want)
+{
+    static HRESULT (WINAPI *register_drop)(HWND, IDropTarget *);
+    static HRESULT (WINAPI *revoke_drop)(HWND);
+
+    if (want == (infoPtr->drop != NULL)) return;
+    if (!register_drop)
+    {
+        HMODULE ole32 = LoadLibraryW(L"ole32.dll");
+        if (!ole32) return;
+        register_drop = (void *)GetProcAddress(ole32, "RegisterDragDrop");
+        revoke_drop = (void *)GetProcAddress(ole32, "RevokeDragDrop");
+        if (!register_drop || !revoke_drop) return;
+    }
+    if (want)
+    {
+        struct tab_drop *drop = Alloc(sizeof(*drop));
+        if (!drop) return;
+        drop->IDropTarget_iface.lpVtbl = &tab_drop_vtbl;
+        drop->ref = 1;
+        drop->info = infoPtr;
+        drop->current_item = -1;
+#ifndef SG_MUTANT_NO_TAB_DROP
+        if (SUCCEEDED(register_drop(infoPtr->hwnd, &drop->IDropTarget_iface)))
+        {
+            infoPtr->drop = drop;
+            return;
+        }
+#endif
+        IDropTarget_Release(&drop->IDropTarget_iface);
+    }
+    else
+    {
+        revoke_drop(infoPtr->hwnd);
+        infoPtr->drop->info = NULL;
+        IDropTarget_Release(&infoPtr->drop->IDropTarget_iface);
+        infoPtr->drop = NULL;
+    }
+}
