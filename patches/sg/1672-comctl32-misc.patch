+/* a page's size from its template, in dialog units, with the room a
+ * wizard gives its pages (as PROPSHEET_CollectPageInfo counts it) */
+static BOOL PROPSHEET_PageTemplateSize(const PropSheetInfo *psInfo, HPROPSHEETPAGE hpsp, int *width, int *height)
+{
+  const DLGTEMPLATE *pTemplate = HPSP_load_template(hpsp, NULL);
+  const WORD *p;
+
+  if (!pTemplate) return FALSE;
+  p = (const WORD *)pTemplate;
+  if (((const MyDLGTEMPLATEEX *)pTemplate)->signature == 0xFFFF) p += 8;
+  else p += 4;
+  p += 3;    /* nb items, x, y */
+  *width = (WORD)*p++;
+  *height = (WORD)*p;
+  if ((psInfo->ppshheader.dwFlags & (PSH_WIZARD97_OLD | PSH_WIZARD97_NEW)) &&
+      (psInfo->ppshheader.dwFlags & PSH_HEADER) && !(HPSP_get_flags(hpsp) & PSP_HIDEHEADER))
+  {
+      *height += 2 * WIZARD_PADDING + WIZARD_HEADER_HEIGHT;
+      *width += 2 * WIZARD_PADDING;
+  }
+  if (psInfo->ppshheader.dwFlags & PSH_WIZARD)
+  {
+      *height += 2 * WIZARD_PADDING;
+      *width += 2 * WIZARD_PADDING;
+  }
+  return TRUE;
+}
