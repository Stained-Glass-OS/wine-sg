+    int i, width = 0, height = 0, w, h;
+    RECT rc;
+
+    TRACE("(%p)\n", hwndDlg);
+
+    if (!psInfo) return FALSE;
+    for (i = 0; i < psInfo->nPages; i++)
+    {
+        if (!psInfo->proppage[i].hpage ||
+            !PROPSHEET_PageTemplateSize(psInfo, psInfo->proppage[i].hpage, &w, &h)) continue;
+        width = max(width, w);
+        height = max(height, h);
+    }
+    if (!width || !height) return FALSE;
+#ifdef SG_MUTANT_NO_RECALC
+    return TRUE;
+#endif
+    psInfo->width = width;
+    psInfo->height = height;
+    if (psInfo->ppshheader.dwFlags & INTRNL_ANY_WIZARD)
+    {
+        PROPSHEET_AdjustSizeWizard(hwndDlg, psInfo);
+        PROPSHEET_AdjustButtonsWizard(hwndDlg, psInfo);
+    }
+    else
+    {
+        PROPSHEET_AdjustSize(hwndDlg, psInfo);
+        PROPSHEET_AdjustButtons(hwndDlg, psInfo);
+    }
+    /* the pages that are made already follow */
+    for (i = 0; i < psInfo->nPages; i++)
+    {
+        if (!psInfo->proppage[i].hwndPage) continue;
+        PROPSHEET_GetPageRect(psInfo, hwndDlg, &rc, psInfo->proppage[i].hpage);
+        SetWindowPos(psInfo->proppage[i].hwndPage, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top,
+                     SWP_NOZORDER | SWP_NOACTIVATE);
+    }
+    return TRUE;
 }
 
