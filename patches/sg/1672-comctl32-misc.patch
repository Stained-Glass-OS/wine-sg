 BOOL WINAPI DelMRUString(HANDLE hList, INT nItemPos)
 {
-    FIXME("(%p, %d): stub\n", hList, nItemPos);
+    WINEMRULIST *mp = hList;
+    WCHAR name[2] = { 0 };
+    UINT slot, last;
+    HKEY key;
+    LPWSTR pos;
+
+    TRACE("(%p, %d)\n", hList, nItemPos);
+
+    if (!mp || nItemPos < 0 || nItemPos >= (INT)mp->cursize) return FALSE;
+
+    /* the item's slot ('a', 'b', ...) leaves the order */
+    slot = mp->realMRU[nItemPos] - 'a';
+    memmove(mp->realMRU + nItemPos, mp->realMRU + nItemPos + 1, (mp->cursize - nItemPos) * sizeof(WCHAR));
+    Free(mp->array[slot]);
+
+    /* the last slot moves into the hole, so the slots stay a, b, c, ... */
+    last = mp->cursize - 1;
+    if (slot != last)
+    {
+        mp->array[slot] = mp->array[last];
+        mp->array[slot]->itemFlag |= WMRUIF_CHANGED;
+        if ((pos = wcschr(mp->realMRU, 'a' + last))) *pos = 'a' + slot;
+    }
+    mp->array[last] = NULL;
+    mp->cursize--;
+    mp->realMRU[mp->cursize] = 0;
+    mp->wineFlags |= WMRUF_CHANGED;
+
+    /* the last slot's value is gone from the registry */
+    if (!RegOpenKeyExW(mp->extview.hKey, mp->extview.lpszSubKey, 0, KEY_WRITE, &key))
+    {
+        name[0] = 'a' + last;
+        RegDeleteValueW(key, name);
+        RegCloseKey(key);
+    }
+    if (!(mp->extview.fFlags & MRU_CACHEWRITE)) MRU_SaveChanged(mp);
     return TRUE;
 }
 
