From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 22:21:47 -0700
Subject: [PATCH] mshtml: commands given to a text range run on the range

TxtRange.execCommand and queryCommandSupported/Enabled/State/Indeterm/Value
were E_NOTIMPL, and the range's IOleCommandTarget only knew the indent
command. They now run the document's editor with the range as the selection
and put the old selection back afterwards, so a command changes only the text
of the range (the range follows the result). queryCommandValue is also
implemented for documents: the font name and size come from the editor, other
commands report their state. IHTMLElement helpers no longer crash on a NULL
interface (moveToElementText(NULL) now fails with E_INVALIDARG).

diff --git a/dlls/mshtml/htmldoc.c b/dlls/mshtml/htmldoc.c
index 682e9a2..08d2416 100644
--- a/dlls/mshtml/htmldoc.c
+++ b/dlls/mshtml/htmldoc.c
@@ -1807,8 +1807,38 @@ static HRESULT WINAPI HTMLDocument_queryCommandValue(IHTMLDocument2 *iface, BSTR
         VARIANT *pfRet)
 {
     HTMLDocumentNode *This = impl_from_IHTMLDocument2(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
-    return E_NOTIMPL;
+    OLECMDID cmdid;
+    DWORD flags;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+
+    if(!pfRet)
+        return E_POINTER;
+
+    V_VT(pfRet) = VT_EMPTY;
+    if(!cmdid_from_string(cmdID, &cmdid))
+        return S_OK;
+
+    /* the font name and size give their value back through the output argument; running any
+     * other command to see what it returns would apply it */
+    if(cmdid == IDM_FONTNAME || cmdid == IDM_FONTSIZE) {
+        hres = IOleCommandTarget_Exec(&This->IOleCommandTarget_iface, &CGID_MSHTML, cmdid,
+                OLECMDEXECOPT_DONTPROMPTUSER, NULL, pfRet);
+        if(SUCCEEDED(hres) && V_VT(pfRet) != VT_EMPTY)
+            return S_OK;
+        V_VT(pfRet) = VT_EMPTY;
+    }
+
+    /* the others have their state */
+    hres = query_command_flags(This, cmdID, &flags);
+    if(FAILED(hres))
+        return hres;
+    if(flags & OLECMDF_SUPPORTED) {
+        V_VT(pfRet) = VT_BOOL;
+        V_BOOL(pfRet) = variant_bool(flags & OLECMDF_LATCHED);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI HTMLDocument_execCommand(IHTMLDocument2 *iface, BSTR cmdID,
