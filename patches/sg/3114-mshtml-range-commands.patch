+/* The editor works on the selection of the document: a command given to a range is run
+ * with the range as the selection, and the selection is put back afterwards. */
+typedef HRESULT (*range_command_t)(HTMLDocumentNode*,void*);
+
+static HRESULT range_run_command(HTMLTxtRange *This, BOOL modifies, range_command_t command, void *arg)
+{
+    nsIDOMRange *saved = NULL, *work = NULL, *tmp = NULL;
+    nsISelection *nsselection;
+    nsIDOMNode *node;
+    LONG cnt = 0, off;
+    nsresult nsres;
+    HRESULT hres;
+
+    if(!This->doc || !This->doc->window || !This->doc->window->dom_window)
+        return E_UNEXPECTED;
+
+    nsres = nsIDOMWindow_GetSelection(This->doc->window->dom_window, &nsselection);
+    if(NS_FAILED(nsres) || !nsselection)
+        return E_FAIL;
+
+    nsISelection_GetRangeCount(nsselection, &cnt);
+    if(cnt > 0 && NS_SUCCEEDED(nsISelection_GetRangeAt(nsselection, 0, &tmp)) && tmp) {
+        nsIDOMRange_CloneRange(tmp, &saved);
+        nsIDOMRange_Release(tmp);
+    }
+
+    if(NS_FAILED(nsIDOMRange_CloneRange(This->nsrange, &work))) {
+        if(saved) nsIDOMRange_Release(saved);
+        nsISelection_Release(nsselection);
+        return E_FAIL;
+    }
+    nsISelection_RemoveAllRanges(nsselection);
+    nsISelection_AddRange(nsselection, work);
+
+#ifdef SG_MUTANT_MSHTML_RANGECMD_NOAPPLY
+    nsISelection_RemoveAllRanges(nsselection);
+#endif
+    hres = command(This->doc, arg);
+
+    /* what the command left selected is what the range is now */
+    cnt = 0;
+    nsISelection_GetRangeCount(nsselection, &cnt);
+    if(modifies && cnt > 0 && NS_SUCCEEDED(nsISelection_GetRangeAt(nsselection, 0, &tmp)) && tmp) {
+        nsIDOMRange_GetStartContainer(tmp, &node);
+        nsIDOMRange_GetStartOffset(tmp, &off);
+        if(node) {
+            nsIDOMRange_SetStart(This->nsrange, node, off);
+            nsIDOMNode_Release(node);
+        }
+        nsIDOMRange_GetEndContainer(tmp, &node);
+        nsIDOMRange_GetEndOffset(tmp, &off);
+        if(node) {
+            nsIDOMRange_SetEnd(This->nsrange, node, off);
+            nsIDOMNode_Release(node);
+        }
+        nsIDOMRange_Release(tmp);
+    }
+
+    nsISelection_RemoveAllRanges(nsselection);
+#ifdef SG_MUTANT_MSHTML_RANGECMD_NORESTORE
+    if(0)
+#endif
+    if(saved) {
+        nsISelection_AddRange(nsselection, saved);
+        nsIDOMRange_Release(saved);
+    }
+    nsIDOMRange_Release(work);
+    nsISelection_Release(nsselection);
+    return hres;
+}
+
+typedef struct {
+    BSTR cmd;
+    VARIANT_BOOL ui;
+    VARIANT *value;
+    VARIANT_BOOL *ret;
+    BSTR *ret_text;
+    VARIANT *ret_value;
+    int which;
+} range_cmd_args_t;
+
+enum { RC_SUPPORTED, RC_ENABLED, RC_STATE, RC_INDETERM, RC_TEXT, RC_VALUE, RC_EXEC };
+
+static HRESULT range_cmd_op(HTMLDocumentNode *doc, void *ctx)
+{
+    range_cmd_args_t *a = ctx;
+    IHTMLDocument2 *doc2 = &doc->IHTMLDocument2_iface;
+
+    switch(a->which) {
+    case RC_SUPPORTED: return IHTMLDocument2_queryCommandSupported(doc2, a->cmd, a->ret);
+    case RC_ENABLED:   return IHTMLDocument2_queryCommandEnabled(doc2, a->cmd, a->ret);
+    case RC_STATE:     return IHTMLDocument2_queryCommandState(doc2, a->cmd, a->ret);
+    case RC_INDETERM:  return IHTMLDocument2_queryCommandIndeterm(doc2, a->cmd, a->ret);
+    case RC_TEXT:      return IHTMLDocument2_queryCommandText(doc2, a->cmd, a->ret_text);
+    case RC_VALUE:     return IHTMLDocument2_queryCommandValue(doc2, a->cmd, a->ret_value);
+    default:           return IHTMLDocument2_execCommand(doc2, a->cmd, a->ui, *a->value, a->ret);
+    }
+}
+
+static HRESULT range_command(HTMLTxtRange *This, int which, BSTR cmd, VARIANT_BOOL ui, VARIANT *value,
+        VARIANT_BOOL *ret, BSTR *ret_text, VARIANT *ret_value)
+{
+    range_cmd_args_t args = { cmd, ui, value, ret, ret_text, ret_value, which };
+
+    if(!cmd)
+        return E_INVALIDARG;
+    return range_run_command(This, which == RC_EXEC, range_cmd_op, &args);
+}
+
 static HRESULT WINAPI HTMLTxtRange_queryCommandSupported(IHTMLTxtRange *iface, BSTR cmdID,
         VARIANT_BOOL *pfRet)
 {
     HTMLTxtRange *This = impl_from_IHTMLTxtRange(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(cmdID), pfRet);
+
+    if(!pfRet)
+        return E_POINTER;
+    return range_command(This, RC_SUPPORTED, cmdID, 0, NULL, pfRet, NULL, NULL);
 }
 
