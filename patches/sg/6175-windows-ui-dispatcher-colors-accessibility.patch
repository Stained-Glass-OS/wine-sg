+/* a posted callback, on the dispatcher's thread */
+static void run_action( struct dispatch_action *impl )
+{
+    IAsyncActionCompletedHandler *handler;
+    AsyncStatus status;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+    if (status == Started)
+    {
+        if (impl->idle)
+            hr = ((HRESULT (WINAPI *)( IUnknown *, IInspectable * ))((void **)impl->callback->lpVtbl)[3])(
+                    impl->callback, (IInspectable *)&idle_args );
+        else
+            hr = ((HRESULT (WINAPI *)( IUnknown * ))((void **)impl->callback->lpVtbl)[3])( impl->callback );
+        TRACE( "%p ran: %#lx\n", impl, hr );
+    }
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started)
+    {
+        impl->result = hr;
+        impl->status = SUCCEEDED(hr) ? Completed : Error;
+    }
+    status = impl->status;
+    if ((handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( handler );
+    LeaveCriticalSection( &impl->cs );
+    if (handler)
+    {
+        IAsyncActionCompletedHandler_Invoke( handler, &impl->IAsyncAction_iface, status );
+        IAsyncActionCompletedHandler_Release( handler );
+    }
+    IAsyncAction_Release( &impl->IAsyncAction_iface );   /* the posted message's */
+}
+
+static LRESULT CALLBACK dispatcher_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_SG_DISPATCH)
+    {
+        run_action( (struct dispatch_action *)lparam );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
