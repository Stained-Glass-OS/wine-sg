+static HRESULT WINAPI da_add_AcceleratorKeyActivated( void *iface, IUnknown *handler, EventRegistrationToken *token )
+{
+    if (!token) return E_POINTER;
+    /* raised only for a CoreWindow of its own: islands deliver keys to XAML */
+    token->value = InterlockedIncrement64( &FROM_A( iface )->next_token );
+    return S_OK;
