+/*
+ * Stained Glass OS: whether high contrast is on (SystemParametersInfo(SPI_GETHIGHCONTRAST)) and its
+ * scheme's name; HighContrastChanged handlers are accepted (not raised: the setting is read when asked).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "weakreference.h"
+#include "initguid.h"
+#include "wine/debug.h"
+
+DEFINE_GUID(IID_IWeakReferenceSource_sg, 0x00000038, 0x0000, 0x0000, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46);
+DEFINE_GUID(IID_IWeakReference_sg, 0x00000037, 0x0000, 0x0000, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46);
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+struct weak;
+
+struct accessibility
+{
+    IAccessibilitySettings IAccessibilitySettings_iface;
+    IWeakReferenceSource IWeakReferenceSource_iface;   /* C++/WinRT event revokers ask for it */
+    LONG ref;
+    INT64 next_token;
+    struct weak *weak;
+};
+
+struct weak
+{
+    IWeakReference IWeakReference_iface;
+    LONG ref;
+    struct accessibility *obj;      /* NULL once it is gone */
+};
+
+static struct accessibility *impl_from_iface( IAccessibilitySettings *iface )
+{
+    return CONTAINING_RECORD( iface, struct accessibility, IAccessibilitySettings_iface );
+}
+
+static HRESULT WINAPI accessibility_QueryInterface( IAccessibilitySettings *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAccessibilitySettings ))
+    {
+        IAccessibilitySettings_AddRef( (*out = iface) );
+        return S_OK;
+    }
+#ifndef SG_MUTANT_ACCESSIBILITY_NO_WEAK
+    if (IsEqualGUID( iid, &IID_IWeakReferenceSource_sg ))
+    {
+        IAccessibilitySettings_AddRef( iface );
+        *out = &impl_from_iface( iface )->IWeakReferenceSource_iface;
+        return S_OK;
+    }
+#endif
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI accessibility_AddRef( IAccessibilitySettings *iface )
+{
+    return InterlockedIncrement( &impl_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI accessibility_Release( IAccessibilitySettings *iface )
+{
+    struct accessibility *impl = impl_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->weak)
+        {
+            impl->weak->obj = NULL;
+            IWeakReference_Release( &impl->weak->IWeakReference_iface );
+        }
+        free( impl );
+    }
+    return ref;
+}
+
+/* ---- weak references ---- */
+
+static struct weak *weak_from_iface( IWeakReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct weak, IWeakReference_iface );
+}
+
+static HRESULT WINAPI weak_QueryInterface( IWeakReference *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference_sg ))
+    {
+        IWeakReference_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI weak_AddRef( IWeakReference *iface )
+{
+    return InterlockedIncrement( &weak_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI weak_Release( IWeakReference *iface )
+{
+    struct weak *weak = weak_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &weak->ref );
+    if (!ref) free( weak );
+    return ref;
+}
+
+static HRESULT WINAPI weak_Resolve( IWeakReference *iface, REFIID iid, IInspectable **out )
+{
+    struct weak *weak = weak_from_iface( iface );
+
+    *out = NULL;
+    if (!weak->obj || !InterlockedCompareExchange( &weak->obj->ref, 0, 0 )) return S_OK;
+    return IAccessibilitySettings_QueryInterface( &weak->obj->IAccessibilitySettings_iface, iid, (void **)out );
+}
+
+static const IWeakReferenceVtbl weak_vtbl = { weak_QueryInterface, weak_AddRef, weak_Release, weak_Resolve };
+
+static struct accessibility *impl_from_source( IWeakReferenceSource *iface )
+{
+    return CONTAINING_RECORD( iface, struct accessibility, IWeakReferenceSource_iface );
+}
+
+static HRESULT WINAPI source_QueryInterface( IWeakReferenceSource *iface, REFIID iid, void **out )
+{
+    return IAccessibilitySettings_QueryInterface( &impl_from_source( iface )->IAccessibilitySettings_iface, iid, out );
+}
+
+static ULONG WINAPI source_AddRef( IWeakReferenceSource *iface )
+{
+    return IAccessibilitySettings_AddRef( &impl_from_source( iface )->IAccessibilitySettings_iface );
+}
+
+static ULONG WINAPI source_Release( IWeakReferenceSource *iface )
+{
+    return IAccessibilitySettings_Release( &impl_from_source( iface )->IAccessibilitySettings_iface );
+}
+
+static HRESULT WINAPI source_GetWeakReference( IWeakReferenceSource *iface, IWeakReference **out )
+{
+    struct accessibility *impl = impl_from_source( iface );
+
+    if (!impl->weak)
+    {
+        if (!(impl->weak = calloc( 1, sizeof(*impl->weak) ))) return E_OUTOFMEMORY;
+        impl->weak->IWeakReference_iface.lpVtbl = &weak_vtbl;
+        impl->weak->ref = 1;   /* the object's */
+        impl->weak->obj = impl;
+    }
+    IWeakReference_AddRef( (*out = &impl->weak->IWeakReference_iface) );
+    return S_OK;
+}
+
+static const IWeakReferenceSourceVtbl source_vtbl = { source_QueryInterface, source_AddRef, source_Release, source_GetWeakReference };
+
+static HRESULT WINAPI accessibility_GetIids( IAccessibilitySettings *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI accessibility_GetRuntimeClassName( IAccessibilitySettings *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.UI.ViewManagement.AccessibilitySettings", name );
+}
+
+static HRESULT WINAPI accessibility_GetTrustLevel( IAccessibilitySettings *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI accessibility_get_HighContrast( IAccessibilitySettings *iface, boolean *value )
+{
+    HIGHCONTRASTW hc = { sizeof(hc) };
+
+    if (!value) return E_POINTER;
+#ifdef SG_MUTANT_HIGH_CONTRAST_ALWAYS
+    *value = TRUE;
+    return S_OK;
+#endif
+    *value = SystemParametersInfoW( SPI_GETHIGHCONTRAST, sizeof(hc), &hc, 0 ) && (hc.dwFlags & HCF_HIGHCONTRASTON);
+    return S_OK;
+}
+
+static HRESULT WINAPI accessibility_get_HighContrastScheme( IAccessibilitySettings *iface, HSTRING *value )
+{
+    HIGHCONTRASTW hc = { sizeof(hc) };
+    const WCHAR *name = L"";
+
+    if (!value) return E_POINTER;
+    if (SystemParametersInfoW( SPI_GETHIGHCONTRAST, sizeof(hc), &hc, 0 ) && (hc.dwFlags & HCF_HIGHCONTRASTON) &&
+        hc.lpszDefaultScheme)
+        name = hc.lpszDefaultScheme;
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT WINAPI accessibility_add_HighContrastChanged( IAccessibilitySettings *iface, IInspectable *handler,
+                                                             EventRegistrationToken *token )
+{
+    if (!token) return E_POINTER;
+    token->value = InterlockedIncrement64( &impl_from_iface( iface )->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI accessibility_remove_HighContrastChanged( IAccessibilitySettings *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static const IAccessibilitySettingsVtbl accessibility_vtbl =
+{
+    accessibility_QueryInterface, accessibility_AddRef, accessibility_Release, accessibility_GetIids,
+    accessibility_GetRuntimeClassName, accessibility_GetTrustLevel, accessibility_get_HighContrast,
+    accessibility_get_HighContrastScheme, accessibility_add_HighContrastChanged, accessibility_remove_HighContrastChanged,
+};
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.UI.ViewManagement.AccessibilitySettings", name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct accessibility *impl;
+
+    if (!instance) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAccessibilitySettings_iface.lpVtbl = &accessibility_vtbl;
+    impl->IWeakReferenceSource_iface.lpVtbl = &source_vtbl;
+    impl->ref = 1;
+    *instance = (IInspectable *)&impl->IAccessibilitySettings_iface;
+    return S_OK;
+}
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release, factory_GetIids, factory_GetRuntimeClassName,
+    factory_GetTrustLevel, factory_ActivateInstance,
+};
+
+static IActivationFactory accessibility_factory_obj = { &factory_vtbl };
+IActivationFactory *accessibility_settings_factory = &accessibility_factory_obj;
