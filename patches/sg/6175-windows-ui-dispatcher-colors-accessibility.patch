+/* the calling thread's dispatcher (made at first), with a reference */
+HRESULT thread_dispatcher( IInspectable **out )
+{
+    static DWORD tls = TLS_OUT_OF_INDEXES;
+    static const WCHAR class_name[] = L"SgCoreDispatcher";
+    struct dispatcher *impl;
+
+    if (tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        WNDCLASSW wc = { 0 };
+        if (InterlockedCompareExchange( (LONG *)&tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES) TlsFree( index );
+        wc.lpfnWndProc = dispatcher_wndproc;
+        wc.hInstance = GetModuleHandleW( L"windows.ui.dll" );
+        wc.lpszClassName = class_name;
+        RegisterClassW( &wc );
+    }
+    if (!(impl = TlsGetValue( tls )))
+    {
+        if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+        impl->vtbl = dispatcher_vtbl;
+        impl->dispatcher2_vtbl = dispatcher2_vtbl;
+        impl->priority_vtbl = priority_vtbl;
+        impl->accelerator_vtbl = accelerator_vtbl;
+        impl->ref = 1;
+        impl->thread = GetCurrentThreadId();
+        impl->priority = 0;   /* Normal */
+        impl->hwnd = CreateWindowExW( 0, class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                                      GetModuleHandleW( L"windows.ui.dll" ), NULL );
+        TlsSetValue( tls, impl );
+    }
+    dispatcher_addref( impl );
+    *out = (IInspectable *)&impl->vtbl;
+    return S_OK;
+}
