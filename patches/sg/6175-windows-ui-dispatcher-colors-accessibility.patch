+/* ---- CoreDispatcher ---- */
+
+struct dispatcher
+{
+    const void *vtbl;                  /* ICoreDispatcher */
+    const void *dispatcher2_vtbl, *priority_vtbl, *accelerator_vtbl;
+    LONG ref;
+    DWORD thread;
+    HWND hwnd;                         /* message-only, of its thread */
+    INT32 priority;
+    INT64 next_token;
+};
+
+static struct dispatcher *dispatcher_from( void *iface, size_t offset )
+{
+    return (struct dispatcher *)((char *)iface - offset);
+}
+
+#define FROM_D(iface) dispatcher_from( iface, 0 )
+#define FROM_D2(iface) dispatcher_from( iface, offsetof(struct dispatcher, dispatcher2_vtbl) )
+#define FROM_P(iface) dispatcher_from( iface, offsetof(struct dispatcher, priority_vtbl) )
+#define FROM_A(iface) dispatcher_from( iface, offsetof(struct dispatcher, accelerator_vtbl) )
+
+static HRESULT dispatcher_qi( struct dispatcher *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICoreDispatcher_sg ))
+        *out = &impl->vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreDispatcher2_sg )) *out = &impl->dispatcher2_vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreDispatcherWithTaskPriority_sg )) *out = &impl->priority_vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreAcceleratorKeys_sg )) *out = &impl->accelerator_vtbl;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG dispatcher_addref( struct dispatcher *impl ) { return InterlockedIncrement( &impl->ref ); }
+static ULONG dispatcher_release( struct dispatcher *impl ) { return InterlockedDecrement( &impl->ref ); }   /* the thread's for life */
+
+#define DISPATCHER_BASE(prefix, from) \
+static HRESULT WINAPI prefix##_QueryInterface( void *iface, REFIID iid, void **out ) { return dispatcher_qi( from( iface ), iid, out ); } \
+static ULONG WINAPI prefix##_AddRef( void *iface ) { return dispatcher_addref( from( iface ) ); } \
+static ULONG WINAPI prefix##_Release( void *iface ) { return dispatcher_release( from( iface ) ); } \
+static HRESULT WINAPI prefix##_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName( void *iface, HSTRING *name ) \
+{ return inspectable_name( L"Windows.UI.Core.CoreDispatcher", name ); } \
+static HRESULT WINAPI prefix##_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+#define BASE_METHODS(prefix) \
+    prefix##_QueryInterface, prefix##_AddRef, prefix##_Release, prefix##_GetIids, prefix##_GetRuntimeClassName, prefix##_GetTrustLevel
+
+DISPATCHER_BASE(d, FROM_D)
+DISPATCHER_BASE(d2, FROM_D2)
+DISPATCHER_BASE(dp, FROM_P)
+DISPATCHER_BASE(da, FROM_A)
+
+static HRESULT WINAPI d_get_HasThreadAccess( void *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = GetCurrentThreadId() == FROM_D( iface )->thread;
+    return S_OK;
+}
+
+static HRESULT WINAPI d_ProcessEvents( void *iface, INT32 options )
+{
+    MSG msg;
+
+    /* ProcessAllIfPresent (1) and the like: what is queued now; the others need a CoreApplication's loop */
+    if (GetCurrentThreadId() != FROM_D( iface )->thread) return RPC_E_WRONG_THREAD;
+    while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE ))
+    {
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    return S_OK;
+}
+
+static HRESULT post_callback( struct dispatcher *impl, IUnknown *callback, BOOL idle, IAsyncAction **out )
+{
+    struct dispatch_action *action;
+
+    if (!callback || !out) return E_POINTER;
+#ifdef SG_MUTANT_DISPATCHER_NO_RUN
+    *out = NULL;
+    return E_NOTIMPL;
+#endif
+    if (!(action = calloc( 1, sizeof(*action) ))) return E_OUTOFMEMORY;
+    action->IAsyncAction_iface.lpVtbl = &action_vtbl;
+    action->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    action->ref = 2;   /* the caller's and the posted message's */
+    action->callback = callback;
+    IUnknown_AddRef( callback );
+    action->idle = idle;
+    action->status = Started;
+    InitializeCriticalSectionEx( &action->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    action->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": dispatch_action.cs");
+    if (!PostMessageW( impl->hwnd, WM_SG_DISPATCH, 0, (LPARAM)action ))
+    {
+        IAsyncAction_Release( &action->IAsyncAction_iface );
+        IAsyncAction_Release( &action->IAsyncAction_iface );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    *out = &action->IAsyncAction_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI d_RunAsync( void *iface, INT32 priority, IUnknown *callback, IAsyncAction **action )
+{
+    return post_callback( FROM_D( iface ), callback, FALSE, action );
+}
+
+static HRESULT WINAPI d_RunIdleAsync( void *iface, IUnknown *callback, IAsyncAction **action )
+{
+    return post_callback( FROM_D( iface ), callback, TRUE, action );
+}
