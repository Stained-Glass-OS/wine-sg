+
+/*
+ * Stained Glass OS: CoreWindow.Dispatcher of a thread's CoreWindow (XAML Islands; WinUI 2 controls
+ * ask for it when they are made).  RunAsync and RunIdleAsync post the callback to a message-only
+ * window of the CoreWindow's thread and run it there from its message loop; the IAsyncAction they
+ * return completes when the callback has run.  HasThreadAccess is true on that thread.
+ *
+ * Interface identity per windows-rs 0.30.0 (MIT), Windows/UI/Core/mod.rs.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "initguid.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+DEFINE_GUID(IID_ICoreDispatcher_sg, 0x60db2fa8, 0xb705, 0x4fde, 0xa7, 0xd6, 0xeb, 0xbb, 0x18, 0x91, 0xd3, 0x9e);
+DEFINE_GUID(IID_ICoreDispatcher2_sg, 0x6f5e63c7, 0xe3aa, 0x4eae, 0xb0, 0xe0, 0xdc, 0xf3, 0x21, 0xca, 0x4b, 0x2f);
+DEFINE_GUID(IID_ICoreDispatcherWithTaskPriority_sg, 0xbafaecad, 0x484d, 0x41be, 0xba, 0x80, 0x1d, 0x58, 0xc6, 0x52, 0x63, 0xea);
+DEFINE_GUID(IID_ICoreAcceleratorKeys_sg, 0x9ffdf7f5, 0xb8c9, 0x4ef0, 0xb7, 0xd2, 0x1d, 0xe6, 0x26, 0x56, 0x1f, 0xc8);
+DEFINE_GUID(IID_IIdleDispatchedHandlerArgs_sg, 0x98bb6a24, 0xdc1c, 0x43cb, 0xb4, 0xed, 0xd1, 0xc0, 0xeb, 0x23, 0x91, 0xf3);
+
+#define WM_SG_DISPATCH (WM_USER + 0x5d1)
+
+/* ---- the IAsyncAction of a callback: completed once it has run ---- */
+
+struct dispatch_action
+{
+    IAsyncAction IAsyncAction_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IUnknown *callback;          /* DispatchedHandler or IdleDispatchedHandler */
+    BOOL idle;
+    AsyncStatus status;
+    HRESULT result;
+    IAsyncActionCompletedHandler *handler;
+    CRITICAL_SECTION cs;
+};
+
+static struct dispatch_action *action_from_iface( IAsyncAction *iface )
+{
+    return CONTAINING_RECORD( iface, struct dispatch_action, IAsyncAction_iface );
+}
+
+static HRESULT WINAPI action_QueryInterface( IAsyncAction *iface, REFIID iid, void **out )
+{
+    struct dispatch_action *impl = action_from_iface( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncAction ))
+        *out = &impl->IAsyncAction_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI action_AddRef( IAsyncAction *iface )
+{
+    return InterlockedIncrement( &action_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI action_Release( IAsyncAction *iface )
+{
+    struct dispatch_action *impl = action_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncActionCompletedHandler_Release( impl->handler );
+        if (impl->callback) IUnknown_Release( impl->callback );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI action_GetIids( IAsyncAction *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI action_GetRuntimeClassName( IAsyncAction *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.Foundation.IAsyncAction", name );
+}
+
+static HRESULT WINAPI action_GetTrustLevel( IAsyncAction *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI action_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct dispatch_action *impl = action_from_iface( iface );
+    AsyncStatus status;
+
+    if (!handler) return S_OK;
+    EnterCriticalSection( &impl->cs );
+    if (impl->handler)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    IAsyncActionCompletedHandler_AddRef( (impl->handler = handler) );
+    status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+    /* already run: told at once */
+    if (status != Started) IAsyncActionCompletedHandler_Invoke( handler, iface, status );
+    return S_OK;
+}
+
+static HRESULT WINAPI action_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct dispatch_action *impl = action_from_iface( iface );
+
+    if (!handler) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if ((*handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI action_GetResults( IAsyncAction *iface )
+{
+    struct dispatch_action *impl = action_from_iface( iface );
+    return impl->status == Started ? E_ILLEGAL_METHOD_CALL : impl->result;
+}
+
+static const IAsyncActionVtbl action_vtbl =
+{
+    action_QueryInterface, action_AddRef, action_Release, action_GetIids, action_GetRuntimeClassName,
+    action_GetTrustLevel, action_put_Completed, action_get_Completed, action_GetResults,
+};
+
+static struct dispatch_action *action_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct dispatch_action, IAsyncInfo_iface );
+}
+
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return action_QueryInterface( &action_from_info( iface )->IAsyncAction_iface, iid, out );
+}
+
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface )
+{
+    return action_AddRef( &action_from_info( iface )->IAsyncAction_iface );
+}
+
+static ULONG WINAPI info_Release( IAsyncInfo *iface )
+{
+    return action_Release( &action_from_info( iface )->IAsyncAction_iface );
+}
+
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.Foundation.IAsyncAction", name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    if (!id) return E_POINTER;
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    if (!status) return E_POINTER;
+    *status = action_from_info( iface )->status;
+    return S_OK;
