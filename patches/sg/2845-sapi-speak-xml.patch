diff --git a/dlls/sapi/speak_text.c b/dlls/sapi/speak_text.c
new file mode 100644
index 0000000..5102721
--- /dev/null
+++ b/dlls/sapi/speak_text.c
@@ -0,0 +1,521 @@
+/*
+ * Speech API (SAPI) text fragments for the engine: plain text and the XML
+ * markup of SAPI (volume, rate, pitch, emph, spell, silence, bookmark,
+ * pron, lang, context, partofsp; unknown tags are handed to the engine).
+ *
