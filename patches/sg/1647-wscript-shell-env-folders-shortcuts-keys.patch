+/* hotkeys as WSH writes them: "ALT+CTRL+SHIFT+F" */
+static const struct { WORD vk; const WCHAR *name; } hotkey_names[] =
+{
+    { VK_BACK, L"BACKSPACE" }, { VK_TAB, L"TAB" }, { VK_RETURN, L"ENTER" }, { VK_ESCAPE, L"ESC" },
+    { VK_SPACE, L"SPACE" }, { VK_PRIOR, L"PGUP" }, { VK_NEXT, L"PGDN" }, { VK_END, L"END" },
+    { VK_HOME, L"HOME" }, { VK_LEFT, L"LEFT" }, { VK_UP, L"UP" }, { VK_RIGHT, L"RIGHT" },
+    { VK_DOWN, L"DOWN" }, { VK_INSERT, L"INSERT" }, { VK_DELETE, L"DELETE" }, { VK_PAUSE, L"BREAK" },
+    { VK_ADD, L"ADD" }, { VK_SUBTRACT, L"SUBTRACT" }, { VK_MULTIPLY, L"MULTIPLY" }, { VK_DIVIDE, L"DIVIDE" },
+};
+
+static void hotkey_to_string(WORD hotkey, WCHAR *out, size_t size)
+{
+    BYTE vk = LOBYTE(hotkey), mods = HIBYTE(hotkey);
+    WCHAR key[16];
+    unsigned int i;
+
+    out[0] = 0;
+    if (!vk) return;
+    if (mods & HOTKEYF_ALT) wcscat(out, L"ALT+");
+    if (mods & HOTKEYF_CONTROL) wcscat(out, L"CTRL+");
+    if (mods & HOTKEYF_SHIFT) wcscat(out, L"SHIFT+");
+    if (mods & HOTKEYF_EXT) wcscat(out, L"EXT+");
+    if ((vk >= '0' && vk <= '9') || (vk >= 'A' && vk <= 'Z')) swprintf(key, ARRAY_SIZE(key), L"%c", vk);
+    else if (vk >= VK_F1 && vk <= VK_F24) swprintf(key, ARRAY_SIZE(key), L"F%u", vk - VK_F1 + 1);
+    else
+    {
+        swprintf(key, ARRAY_SIZE(key), L"%u", vk);
+        for (i = 0; i < ARRAY_SIZE(hotkey_names); i++)
+            if (hotkey_names[i].vk == vk) wcscpy(key, hotkey_names[i].name);
+    }
+    if (wcslen(out) + wcslen(key) < size) wcscat(out, key);
+}
+
+static BOOL hotkey_from_string(const WCHAR *str, WORD *hotkey)
+{
+    BYTE vk = 0, mods = 0;
+    const WCHAR *p = str, *end;
+    unsigned int i;
+
+    *hotkey = 0;
+    if (!str || !str[0]) return TRUE;   /* none */
+    while (*p)
+    {
+        WCHAR token[16];
+        size_t len;
+
+        while (*p == ' ') p++;
+        if (!(end = wcschr(p, '+'))) end = p + wcslen(p);
+        else if (end == p) end++;      /* "+" itself as the key: not a valid hotkey */
+        len = end - p;
+        if (!len || len >= ARRAY_SIZE(token)) return FALSE;
+        memcpy(token, p, len * sizeof(WCHAR));
+        token[len] = 0;
+        while (len && token[len - 1] == ' ') token[--len] = 0;
+        if (!wcsicmp(token, L"ALT")) mods |= HOTKEYF_ALT;
+        else if (!wcsicmp(token, L"CTRL") || !wcsicmp(token, L"CONTROL")) mods |= HOTKEYF_CONTROL;
+        else if (!wcsicmp(token, L"SHIFT")) mods |= HOTKEYF_SHIFT;
+        else if (!wcsicmp(token, L"EXT")) mods |= HOTKEYF_EXT;
+        else if (vk) return FALSE;
+        else if (len == 1 && iswalnum(token[0])) vk = towupper(token[0]);
+        else if ((token[0] == 'F' || token[0] == 'f') && iswdigit(token[1]) && wcstoul(token + 1, NULL, 10) >= 1 &&
+                 wcstoul(token + 1, NULL, 10) <= 24)
+            vk = VK_F1 + wcstoul(token + 1, NULL, 10) - 1;
+        else
+        {
+            for (i = 0; i < ARRAY_SIZE(hotkey_names); i++)
+                if (!wcsicmp(token, hotkey_names[i].name)) vk = hotkey_names[i].vk;
+            if (!vk) return FALSE;
+        }
+        p = *end ? end + 1 : end;
+    }
+    if (!vk) return FALSE;
+    *hotkey = MAKEWORD(vk, mods);
+    return TRUE;
+}
