+/* AppActivate: a window whose title is the name, else begins with it, else
+ * ends with it; or a window of the process with that id */
+struct app_search
+{
+    const WCHAR *title;
+    DWORD pid;
+    int pass;
+    HWND found;
+};
+
+static BOOL CALLBACK find_app_window(HWND hwnd, LPARAM lparam)
+{
+    struct app_search *search = (struct app_search *)lparam;
+    WCHAR text[512];
+    size_t len, tlen;
+
+    if (!IsWindowVisible(hwnd) || GetWindow(hwnd, GW_OWNER)) return TRUE;
+    if (search->pid)
+    {
+        DWORD pid;
+        GetWindowThreadProcessId(hwnd, &pid);
+        if (pid != search->pid) return TRUE;
+        search->found = hwnd;
+        return FALSE;
+    }
+    if (!GetWindowTextW(hwnd, text, ARRAY_SIZE(text))) return TRUE;
+    len = wcslen(text);
+    tlen = wcslen(search->title);
+    if ((search->pass == 0 && !wcsicmp(text, search->title)) ||
+        (search->pass == 1 && !wcsnicmp(text, search->title, tlen)) ||
+        (search->pass == 2 && len >= tlen && !wcsicmp(text + len - tlen, search->title)))
+    {
+        search->found = hwnd;
+        return FALSE;
+    }
+    return TRUE;
 }
 
