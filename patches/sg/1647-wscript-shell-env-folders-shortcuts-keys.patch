+static inline StringEnum *impl_from_StringEnum(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, StringEnum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI StringEnum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumVARIANT))
+    {
+        *ppv = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI StringEnum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_StringEnum(iface)->ref);
+}
+
+static ULONG WINAPI StringEnum_Release(IEnumVARIANT *iface)
+{
+    StringEnum *This = impl_from_StringEnum(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) SysFreeString(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI StringEnum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched)
+{
+    StringEnum *This = impl_from_StringEnum(iface);
+    ULONG i;
+
+    for (i = 0; i < celt && This->pos < This->count; i++, This->pos++)
+    {
+        V_VT(&var[i]) = VT_BSTR;
+        V_BSTR(&var[i]) = SysAllocString(This->items[This->pos]);
+    }
+    if (fetched) *fetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI StringEnum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    StringEnum *This = impl_from_StringEnum(iface);
+
+    if (This->count - This->pos < celt)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI StringEnum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_StringEnum(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_string_enum(BSTR *items, ULONG count, ULONG pos, IEnumVARIANT **ret);
+
+static HRESULT WINAPI StringEnum_Clone(IEnumVARIANT *iface, IEnumVARIANT **ret)
+{
+    StringEnum *This = impl_from_StringEnum(iface);
+    BSTR *items;
+    ULONG i;
+
+    if (!(items = calloc(This->count + 1, sizeof(*items)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++) items[i] = SysAllocString(This->items[i]);
+    return create_string_enum(items, This->count, This->pos, ret);
+}
+
+static const IEnumVARIANTVtbl StringEnumVtbl =
+{
+    StringEnum_QueryInterface,
+    StringEnum_AddRef,
+    StringEnum_Release,
+    StringEnum_Next,
+    StringEnum_Skip,
+    StringEnum_Reset,
+    StringEnum_Clone
+};
+
+/* takes the strings */
+static HRESULT create_string_enum(BSTR *items, ULONG count, ULONG pos, IEnumVARIANT **ret)
+{
+    StringEnum *This;
+    ULONG i;
+
+    if (!(This = malloc(sizeof(*This))))
+    {
+        for (i = 0; i < count; i++) SysFreeString(items[i]);
+        free(items);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumVARIANT_iface.lpVtbl = &StringEnumVtbl;
+    This->ref = 1;
+    This->items = items;
+    This->count = count;
+    This->pos = pos;
+    *ret = &This->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+/* the registry key an environment lives in */
+static HKEY open_env_key(enum env_type type, REGSAM access)
+{
+    HKEY key = NULL;
+
+    switch (type)
+    {
+    case ENV_SYSTEM:
+        RegCreateKeyExW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Session Manager\\Environment",
+                        0, NULL, 0, access, NULL, &key, NULL);
+        break;
+    case ENV_USER:
+        RegCreateKeyExW(HKEY_CURRENT_USER, L"Environment", 0, NULL, 0, access, NULL, &key, NULL);
+        break;
+    case ENV_VOLATILE:
+        RegCreateKeyExW(HKEY_CURRENT_USER, L"Volatile Environment", 0, NULL, REG_OPTION_VOLATILE, access,
+                        NULL, &key, NULL);
+        break;
+    default:
+        break;
+    }
+    return key;
+}
+
+/* every variable, as "NAME=value" */
+static HRESULT list_env(enum env_type type, BSTR **list, ULONG *count)
+{
+    ULONG n = 0, size = 0;
+    BSTR *items = NULL;
+
+    *list = NULL;
+    *count = 0;
+    if (type == ENV_PROCESS)
+    {
+        WCHAR *block = GetEnvironmentStringsW(), *p;
+
+        if (!block) return E_OUTOFMEMORY;
+        for (p = block; *p; p += wcslen(p) + 1)
+        {
+            if (*p == '=') continue;   /* the hidden per-drive directories */
+            if (n == size)
+            {
+                BSTR *bigger = realloc(items, (size = max(size * 2, 32)) * sizeof(*items));
+                if (!bigger) break;
+                items = bigger;
+            }
+            items[n++] = SysAllocString(p);
+        }
+        FreeEnvironmentStringsW(block);
+    }
+    else
+    {
+        HKEY key = open_env_key(type, KEY_READ);
+        WCHAR name[1024], *data;
+        DWORD i, name_len, data_size, max_data = 0, value_type;
+
+        if (!key) return S_OK;
+        RegQueryInfoKeyW(key, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &max_data, NULL, NULL);
+        if (!(data = malloc(max_data + sizeof(WCHAR))))
+        {
+            RegCloseKey(key);
+            return E_OUTOFMEMORY;
+        }
+        for (i = 0;; i++)
+        {
+            name_len = ARRAY_SIZE(name);
+            data_size = max_data;
+            if (RegEnumValueW(key, i, name, &name_len, NULL, &value_type, (BYTE *)data, &data_size)) break;
+            if (value_type != REG_SZ && value_type != REG_EXPAND_SZ) continue;
+            data[data_size / sizeof(WCHAR)] = 0;
+            if (n == size)
+            {
+                BSTR *bigger = realloc(items, (size = max(size * 2, 32)) * sizeof(*items));
+                if (!bigger) break;
+                items = bigger;
+            }
+            if ((items[n] = SysAllocStringLen(NULL, name_len + 1 + wcslen(data))))
+            {
+                wcscpy(items[n], name);
+                wcscat(items[n], L"=");
+                wcscat(items[n], data);
+                n++;
+            }
+        }
+        free(data);
+        RegCloseKey(key);
+    }
+    *list = items;
+    *count = n;
+    return S_OK;
+}
+
+/* the system and user environments changed: running programs (the shell)
+ * read them again */
+static void env_changed(enum env_type type)
+{
+    DWORD_PTR result;
+
+    if (type == ENV_SYSTEM || type == ENV_USER)
+        SendMessageTimeoutW(HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"Environment", SMTO_ABORTIFHUNG,
+                            5000, &result);
+}
