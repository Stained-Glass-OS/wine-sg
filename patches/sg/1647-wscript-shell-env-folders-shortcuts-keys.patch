+static HRESULT parse_send_keys(const WCHAR *keys, struct key_sender *ks)
+{
+    UINT mods = 0, group = 0;
+    BOOL in_group = FALSE;
+    const WCHAR *p = keys;
+
+    while (*p)
+    {
+        WCHAR c = *p++;
+
+        switch (c)
+        {
+        case '+': mods |= 1; continue;
+        case '^': mods |= 2; continue;
+        case '%': mods |= 4; continue;
+        case '(':
+            if (in_group) return E_INVALIDARG;
+            in_group = TRUE;
+            group = mods;
+            mods = 0;
+            continue;
+        case ')':
+            if (!in_group) return E_INVALIDARG;
+            in_group = FALSE;
+            group = 0;
+            mods = 0;
+            continue;
+        case '~':
+            press(ks, VK_RETURN, 0, mods | group);
+            break;
+        case '{':
+        {
+            const WCHAR *end = wcschr(p + 1, '}');   /* "{}}" is a "}" */
+            WCHAR name[32];
+            size_t len;
+            unsigned int i, repeat = 1;
+            WORD vk = 0;
+            WCHAR ch = 0;
+            WCHAR *space;
+
+            if (!end) return E_INVALIDARG;
+            len = end - p;
+            if (!len || len >= ARRAY_SIZE(name)) return E_INVALIDARG;
+            memcpy(name, p, len * sizeof(WCHAR));
+            name[len] = 0;
+            p = end + 1;
+            if ((space = wcschr(name + 1, ' ')))
+            {
+                *space = 0;
+                repeat = wcstoul(space + 1, NULL, 10);
+            }
+            if (!name[1]) ch = name[0];   /* "{+}", "{%}", "{a}" */
+            else if ((name[0] == 'F' || name[0] == 'f') && iswdigit(name[1]))
+            {
+                unsigned int n = wcstoul(name + 1, NULL, 10);
+                if (n < 1 || n > 24) return E_INVALIDARG;
+                vk = VK_F1 + n - 1;
+            }
+            else
+            {
+                for (i = 0; i < ARRAY_SIZE(sendkey_names); i++)
+                    if (!wcsicmp(name, sendkey_names[i].name)) vk = sendkey_names[i].vk;
+                if (!vk) return E_INVALIDARG;
+            }
+            for (i = 0; i < repeat; i++) press(ks, vk, ch, mods | group);
+            break;
+        }
+        default:
+            press(ks, 0, c, mods | group);
+            break;
+        }
+        mods = 0;
+    }
+    return in_group ? E_INVALIDARG : S_OK;
 }
 
