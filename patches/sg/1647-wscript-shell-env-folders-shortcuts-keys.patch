     WshEnvironment *This = impl_from_IWshEnvironment(iface);
-    FIXME("(%p)->(%s %s): stub\n", This, debugstr_w(name), debugstr_w(value));
-    return E_NOTIMPL;
+    LSTATUS ret;
+    HKEY key;
+
+    TRACE("(%p)->(%s %s)\n", This, debugstr_w(name), debugstr_w(value));
+
+    if (!name || !name[0] || wcschr(name, '=')) return E_INVALIDARG;
+    if (This->type == ENV_PROCESS)
+        return SetEnvironmentVariableW(name, value ? value : L"") ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+
+    if (!(key = open_env_key(This->type, KEY_SET_VALUE))) return E_ACCESSDENIED;
+    if (!value) value = (BSTR)L"";
+    /* a value naming other variables is expanded when read */
+    ret = RegSetValueExW(key, name, 0, wcschr(value, '%') ? REG_EXPAND_SZ : REG_SZ, (const BYTE *)value,
+                         (wcslen(value) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+    if (ret) return HRESULT_FROM_WIN32(ret);
+    env_changed(This->type);
+    return S_OK;
 }
 
