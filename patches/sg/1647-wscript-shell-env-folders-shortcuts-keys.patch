+/* a key press, with the modifiers given (and those the character needs) */
+static void press(struct key_sender *ks, WORD vk, WCHAR ch, UINT mods)
+{
+    UINT need = mods;
+
+    if (!vk && ch)
+    {
+        SHORT scan = VkKeyScanW(ch);
+        /* a character the layout types with AltGr, or not at all: sent as
+         * the character itself */
+        if (scan != -1 && (HIBYTE(scan) & 6) != 6)
+        {
+            vk = LOBYTE(scan);
+            if (HIBYTE(scan) & 1) need |= 1;
+            if (HIBYTE(scan) & 2) need |= 2;
+            if (HIBYTE(scan) & 4) need |= 4;
+        }
+    }
+    if (need & 1) add_input(ks, VK_SHIFT, 0, FALSE);
+    if (need & 2) add_input(ks, VK_CONTROL, 0, FALSE);
+    if (need & 4) add_input(ks, VK_MENU, 0, FALSE);
+    add_input(ks, vk, ch, FALSE);
+    add_input(ks, vk, ch, TRUE);
+    if (need & 4) add_input(ks, VK_MENU, 0, TRUE);
+    if (need & 2) add_input(ks, VK_CONTROL, 0, TRUE);
+    if (need & 1) add_input(ks, VK_SHIFT, 0, TRUE);
+}
