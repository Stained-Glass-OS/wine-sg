 {
     DWORD len;
@@ -558,48 +796,116 @@ HRESULT get_env_var(const WCHAR *name, BSTR *value)
 static HRESULT WINAPI WshEnvironment_get_Item(IWshEnvironment *iface, BSTR name, BSTR *value)
 {
     WshEnvironment *This = impl_from_IWshEnvironment(iface);
+    DWORD size = 0, type;
+    HKEY key;
 
     TRACE("(%p)->(%s %p)\n", This, debugstr_w(name), value);
 
     if (!value)
         return E_POINTER;
 
+#ifdef SG_MUTANT_PROCESS_ENV_ONLY
     return get_env_var(name, value);
+#endif
+    if (This->type == ENV_PROCESS)
+        return get_env_var(name, value);
+
+    /* the registry's value, as it is (not expanded); none: empty */
+    *value = NULL;
+    if (name && (key = open_env_key(This->type, KEY_READ)))
+    {
+        if (!RegQueryValueExW(key, name, NULL, &type, NULL, &size) && (type == REG_SZ || type == REG_EXPAND_SZ))
+        {
+            WCHAR *data = calloc(1, size + sizeof(WCHAR));
+            if (data && !RegQueryValueExW(key, name, NULL, NULL, (BYTE *)data, &size))
+                *value = SysAllocString(data);
+            free(data);
+        }
+        RegCloseKey(key);
+    }
+    if (!*value) *value = SysAllocStringLen(NULL, 0);
+    return *value ? S_OK : E_OUTOFMEMORY;
 }
 
