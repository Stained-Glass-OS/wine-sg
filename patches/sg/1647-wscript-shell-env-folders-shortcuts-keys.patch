+struct key_sender
+{
+    INPUT *inputs;
+    UINT count, size;
+};
+
+static void add_input(struct key_sender *ks, WORD vk, WCHAR ch, BOOL up)
+{
+    INPUT *in;
+
+    if (ks->count == ks->size)
+    {
+        INPUT *bigger = realloc(ks->inputs, (ks->size = max(ks->size * 2, 64)) * sizeof(INPUT));
+        if (!bigger) return;
+        ks->inputs = bigger;
+    }
+    in = &ks->inputs[ks->count++];
+    memset(in, 0, sizeof(*in));
+    in->type = INPUT_KEYBOARD;
+    in->ki.wVk = vk;
+    in->ki.wScan = vk ? MapVirtualKeyW(vk, MAPVK_VK_TO_VSC) : ch;
+    in->ki.dwFlags = (vk ? 0 : KEYEVENTF_UNICODE) | (up ? KEYEVENTF_KEYUP : 0);
+    if (vk == VK_DELETE || vk == VK_INSERT || vk == VK_HOME || vk == VK_END || vk == VK_PRIOR || vk == VK_NEXT ||
+        vk == VK_LEFT || vk == VK_RIGHT || vk == VK_UP || vk == VK_DOWN || vk == VK_DIVIDE)
+        in->ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
