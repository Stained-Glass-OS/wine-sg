     WshEnvironment *This = impl_from_IWshEnvironment(iface);
-    FIXME("(%p)->(%s): stub\n", This, debugstr_w(name));
-    return E_NOTIMPL;
+    LSTATUS ret;
+    HKEY key;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(name));
+
+    if (!name) return E_INVALIDARG;
+    if (This->type == ENV_PROCESS)
+        return SetEnvironmentVariableW(name, NULL) || GetLastError() == ERROR_ENVVAR_NOT_FOUND
+               ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+    if (!(key = open_env_key(This->type, KEY_SET_VALUE))) return E_ACCESSDENIED;
+    ret = RegDeleteValueW(key, name);
+    RegCloseKey(key);
+    if (ret && ret != ERROR_FILE_NOT_FOUND) return HRESULT_FROM_WIN32(ret);
+    env_changed(This->type);
+    return S_OK;
 }
 
