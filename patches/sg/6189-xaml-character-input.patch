@@ -261,9 +261,31 @@ static HRESULT WINAPI cw_remove_event( __x_ABI_CWindows_CUI_CCore_CICoreWindow *
     return S_OK;
 }
 
+/* CoreVirtualKeyStates of a VirtualKey (the Win32 virtual-key codes): Down 1, Locked 2 -- a terminal
+ * asks for Shift, Ctrl, Alt and the lock keys with each key it gets */
+static UINT32 key_states( SHORT state )
+{
+    return ((state & 0x8000) ? 1 : 0) | ((state & 1) ? 2 : 0);
+}
+
 static HRESULT WINAPI cw_key_state( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, int key, void *state )
 {
+    if (!state) return E_POINTER;
+#ifdef SG_MUTANT_COREWINDOW_NO_KEY_STATE
     return E_NOTIMPL;
+#endif
+    *(UINT32 *)state = key >= 0 && key < 256 ? key_states( GetKeyState( key ) ) : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI cw_async_key_state( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, int key, void *state )
+{
+    if (!state) return E_POINTER;
+#ifdef SG_MUTANT_COREWINDOW_NO_KEY_STATE
+    return E_NOTIMPL;
+#endif
+    *(UINT32 *)state = key >= 0 && key < 256 ? key_states( GetAsyncKeyState( key ) ) : 0;
+    return S_OK;
 }
 
