From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml, windows.ui: typed characters reach a program's control

Windows Terminal showed its prompt but took no typing. Its TermControl is a UserControl the program makes a tab stop; it takes text from UIElement.CharacterReceived and, with every key, asks CoreWindow.GetKeyState for Shift, Ctrl, Alt and the lock keys. Our focus went only to text boxes, buttons and list items, CharacterReceived was never raised, and GetKeyState returned E_NOTIMPL -- which Windows Terminal turned into an exception in a noexcept function and ended. Now a control whose IsTabStop the program set true takes the focus (by Focus() or a click), each WM_CHAR is raised as CharacterReceived up from the focused element (before a text box's own handling), and CoreWindow.GetKeyState and GetAsyncKeyState report Down and Locked from the thread's and the system's key state.
---
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index 0d705e3..8e2cfd3 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -1367,6 +1367,8 @@ INT32 xaml_tab_navigation( struct uielem *elem )
     return mode;
 }
 static HRESULT WINAPI fe_add_PreviewKeyDown( struct xiface *iface, IUnknown *handler, INT64 *token );
+static HRESULT WINAPI fe_add_CharacterReceived( struct xiface *iface, IUnknown *handler, INT64 *token );
+static HRESULT WINAPI fe_remove_CharacterReceived( struct xiface *iface, INT64 token );
 static HRESULT WINAPI fe_remove_PreviewKeyDown( struct xiface *iface, INT64 token );
 static HRESULT WINAPI fe_add_PreviewKeyUp( struct xiface *iface, IUnknown *handler, INT64 *token );
 static HRESULT WINAPI fe_remove_PreviewKeyUp( struct xiface *iface, INT64 token );
@@ -1382,6 +1384,7 @@ static const void *uielement7_vtbl[] =
     [IUIElement7_KeyboardAccelerators] = uielement7_get_KeyboardAccelerators,
     [IUIElement7_PreviewKeyDown] = fe_add_PreviewKeyDown, [IUIElement7_RemovePreviewKeyDown] = fe_remove_PreviewKeyDown,
     [IUIElement7_PreviewKeyUp] = fe_add_PreviewKeyUp, [IUIElement7_RemovePreviewKeyUp] = fe_remove_PreviewKeyUp,
+    [IUIElement7_CharacterReceived] = fe_add_CharacterReceived, [IUIElement7_RemoveCharacterReceived] = fe_remove_CharacterReceived,
 };
 static const void *uielement8_vtbl[] = { IUIElement8_STUBS };
 static const void *uielement9_vtbl[] = { IUIElement9_STUBS };
@@ -1699,6 +1702,7 @@ ELEM_EVENT(KeyUp, key_up)
 ELEM_EVENT(GotFocus, got_focus)
 ELEM_EVENT(LostFocus, lost_focus)
 ELEM_EVENT(PreviewKeyDown, preview_key_down)
+ELEM_EVENT(CharacterReceived, character_received)
 ELEM_EVENT(PreviewKeyUp, preview_key_up)
 
 struct handler_list *xaml_routed_list( struct uielem *elem, enum xaml_routed which )
@@ -1711,6 +1715,7 @@ struct handler_list *xaml_routed_list( struct uielem *elem, enum xaml_routed whi
     case XROUTED_LOST_FOCUS: return &elem->lost_focus;
     case XROUTED_PREVIEW_KEY_DOWN: return &elem->preview_key_down;
     case XROUTED_PREVIEW_KEY_UP: return &elem->preview_key_up;
+    case XROUTED_CHARACTER_RECEIVED: return &elem->character_received;
     }
     return NULL;
 }
@@ -1977,6 +1982,7 @@ void uielem_init( struct uielem *elem, const struct xclass *cls, const struct el
     handlers_init( &elem->got_focus );
     handlers_init( &elem->lost_focus );
     handlers_init( &elem->preview_key_down );
+    handlers_init( &elem->character_received );
     handlers_init( &elem->preview_key_up );
     handlers_init( &elem->size_changed );
     handlers_init( &elem->layout_updated );
@@ -2016,6 +2022,7 @@ void uielem_cleanup( struct uielem *elem )
     handlers_clear( &elem->got_focus );
     handlers_clear( &elem->lost_focus );
     handlers_clear( &elem->preview_key_down );
+    handlers_clear( &elem->character_received );
     handlers_clear( &elem->preview_key_up );
     handlers_clear( &elem->size_changed );
     handlers_clear( &elem->layout_updated );
diff --git a/dlls/windows.ui.xaml/focus.c b/dlls/windows.ui.xaml/focus.c
index cfca775..6985eaa 100644
--- a/dlls/windows.ui.xaml/focus.c
+++ b/dlls/windows.ui.xaml/focus.c
@@ -48,8 +48,10 @@ struct key_args
 {
     struct xobj obj;
     struct xiface IRoutedEventArgs_iface, IKeyRoutedEventArgs_iface, IKeyRoutedEventArgs2_iface;
+    struct xiface ICharacterReceivedRoutedEventArgs_iface;
     IInspectable *source;
     INT32 key;
+    WCHAR ch;                       /* CharacterReceived's */
     UINT32 repeat;
     boolean handled, menu_down, released, was_down;
     UINT32 scan;
@@ -128,6 +130,51 @@ static const struct xclass key_args_class =
     L"Windows.UI.Xaml.Input.KeyRoutedEventArgs", key_args_ifaces, ARRAY_SIZE(key_args_ifaces), key_args_destroy,
 };
 
+/* CharacterReceivedRoutedEventArgs: a typed character, with its key's status */
+static HRESULT WINAPI char_get_Character( struct xiface *iface, WCHAR *value )
+{
+    if (!value) return E_POINTER;
+    *value = key_args_from_iface( iface )->ch;
+    return S_OK;
+}
+
+static const void *char_args_vtbl[] =
+{
+    ICharacterReceivedRoutedEventArgs_STUBS,
+    [ICharacterReceivedRoutedEventArgs_Character] = char_get_Character,
+    [ICharacterReceivedRoutedEventArgs_KeyStatus] = key_get_KeyStatus,
+    [ICharacterReceivedRoutedEventArgs_Handled] = key_get_Handled,
+    [ICharacterReceivedRoutedEventArgs_SetHandled] = key_put_Handled,
+};
+
+static const struct xiface_entry char_args_ifaces[] =
+{
+    { &IID_ICharacterReceivedRoutedEventArgs, offsetof(struct key_args, ICharacterReceivedRoutedEventArgs_iface) },
+    { &IID_IRoutedEventArgs_key, offsetof(struct key_args, IRoutedEventArgs_iface) },
+};
+
+static const struct xclass char_args_class =
+{
+    L"Windows.UI.Xaml.Input.CharacterReceivedRoutedEventArgs", char_args_ifaces, ARRAY_SIZE(char_args_ifaces), key_args_destroy,
+};
+
+static struct key_args *new_char_args( IInspectable *source, WCHAR ch, LPARAM lparam )
+{
+    struct key_args *args;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return NULL;
+    args->IRoutedEventArgs_iface.vtbl = key_routed_vtbl;
+    args->ICharacterReceivedRoutedEventArgs_iface.vtbl = char_args_vtbl;
+    xobj_init( &args->obj, &char_args_class, NULL );
+    if ((args->source = source)) IInspectable_AddRef( source );
+    args->ch = ch;
+    args->repeat = lparam & 0xffff;
+    args->scan = (lparam >> 16) & 0xff;
+    args->menu_down = (lparam >> 29) & 1;
+    args->was_down = (lparam >> 30) & 1;
+    return args;
+}
+
 static struct key_args *new_key_args( IInspectable *source, UINT vk, LPARAM lparam, BOOL up )
 {
     struct key_args *args;
@@ -234,9 +281,21 @@ static BOOL control_flag( struct uielem *elem, const WCHAR *name, BOOL def )
 }
 
 /* what takes the keyboard: text boxes and buttons, enabled tab stops */
+/* any control a program made a tab stop itself (IsTabStop set true: a terminal's surface, a custom control) */
+static BOOL explicit_tab_stop( struct uielem *elem )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.Control", L"IsTabStop" );
+
+#ifdef SG_MUTANT_NO_EXPLICIT_TAB_STOP
+    return FALSE;
+#endif
+    return prop && is_control( &elem->d ) && dobj_has_value( &elem->d, prop ) && control_flag( elem, L"IsTabStop", FALSE );
+}
+
 BOOL xaml_is_focus_target( struct uielem *elem )
 {
-    if (!elem || (!xaml_is_text_box( elem ) && !xaml_is_button( elem ) && !xaml_is_list_view_item( elem ))) return FALSE;
+    if (!elem || (!xaml_is_text_box( elem ) && !xaml_is_button( elem ) && !xaml_is_list_view_item( elem ) &&
+                  !explicit_tab_stop( elem ))) return FALSE;
 #ifdef SG_MUTANT_XAML_NO_BUTTON_FOCUS
     if (!xaml_is_text_box( elem )) return FALSE;
 #endif
@@ -947,9 +1006,27 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
         IUnknown_Release( args->obj.outer );
         return msg == WM_KEYDOWN || msg == WM_KEYUP;
     case WM_CHAR:
+    {
+        /* CharacterReceived up from the focused element (a terminal takes its input so), then a text box's */
+        boolean handled = FALSE;
+#ifndef SG_MUTANT_NO_CHARACTER_RECEIVED
+        if (target && (source = sender_of( target )))
+        {
+            struct key_args *chars = new_char_args( source, wparam, lparam );
+            IInspectable_Release( source );
+            if (chars)
+            {
+                raise_up( target, XROUTED_CHARACTER_RECEIVED, (IInspectable *)&chars->ICharacterReceivedRoutedEventArgs_iface, &chars->handled );
+                handled = chars->handled;
+                IUnknown_Release( chars->obj.outer );
+            }
+        }
+        if (handled) return TRUE;
+#endif
         if (focus && in_content( focus, content ) && xaml_is_text_box( focus ) && wparam >= 0x20)
             return xaml_text_box_char( focus, wparam );
         return FALSE;
+    }
     case WM_KILLFOCUS:
         if (focus && in_content( focus, content ) && xaml_is_text_box( focus )) xaml_text_box_focus( focus, FALSE );
         return FALSE;
