From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 09:53:10 -0700
Subject: [PATCH] urlmon: quiet FIXMEs for calls whose result is right (3001)

DllInstall, LogSqmBits, LogSqmIncrement, LogSqmUXCommandOffsetInternal,
FlushUrlmonZonesCache, ShouldShowIntranetWarningSecband, IsProtectedModeURL and
the zone manager's GetZoneSecurityState, GetIESecurityState and
FixInsecureSettings do nothing visible (telemetry and security banner hooks) or
report a green state; they traced a FIXME on every call although their result
is the intended one. They trace now.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/urlmon/sec_mgr.c b/dlls/urlmon/sec_mgr.c
index ed54ba3..7b76fba 100644
--- a/dlls/urlmon/sec_mgr.c
+++ b/dlls/urlmon/sec_mgr.c
@@ -2385,7 +2385,7 @@ static HRESULT WINAPI ZoneMgrImpl_GetZoneSecurityState(IInternetZoneManagerEx2*
                                                        LPDWORD pdwState,
                                                        BOOL *pfPolicyEncountered)
 {
-    FIXME("(%p)->(%ld, %d, %p, %p) stub\n", iface, dwZoneIndex, fRespectPolicy,
+    TRACE("(%p)->(%ld, %d, %p, %p)\n", iface, dwZoneIndex, fRespectPolicy,
                                            pdwState, pfPolicyEncountered);
 
     *pdwState = SECURITY_IE_STATE_GREEN;
@@ -2405,7 +2405,7 @@ static HRESULT WINAPI ZoneMgrImpl_GetIESecurityState(IInternetZoneManagerEx2* if
                                                      BOOL *pfPolicyEncountered,
                                                      BOOL fNoCache)
 {
-    FIXME("(%p)->(%d, %p, %p, %d) stub\n", iface, fRespectPolicy, pdwState,
+    TRACE("(%p)->(%d, %p, %p, %d)\n", iface, fRespectPolicy, pdwState,
                                            pfPolicyEncountered, fNoCache);
 
     *pdwState = SECURITY_IE_STATE_GREEN;
@@ -2421,7 +2421,7 @@ static HRESULT WINAPI ZoneMgrImpl_GetIESecurityState(IInternetZoneManagerEx2* if
  */
 static HRESULT WINAPI ZoneMgrImpl_FixInsecureSettings(IInternetZoneManagerEx2* iface)
 {
-    FIXME("(%p) stub\n", iface);
+    TRACE("(%p)\n", iface);
     return S_OK;
 }
 
diff --git a/dlls/urlmon/urlmon_main.c b/dlls/urlmon/urlmon_main.c
index 2225cba..bed980c 100644
--- a/dlls/urlmon/urlmon_main.c
+++ b/dlls/urlmon/urlmon_main.c
@@ -237,7 +237,7 @@ const char *debugstr_bindstatus(ULONG status)
  */
 HRESULT WINAPI DllInstall(BOOL bInstall, LPCWSTR cmdline)
 {
-  FIXME("(%s, %s): stub\n", bInstall?"TRUE":"FALSE",
+  TRACE("(%s, %s)\n", bInstall?"TRUE":"FALSE",
 	debugstr_w(cmdline));
 
   return S_OK;
@@ -822,7 +822,7 @@ BOOL WINAPI IsLoggingEnabledW(LPCWSTR url)
  */
 BOOL WINAPI IsProtectedModeURL(const WCHAR *url)
 {
-    FIXME("stub: %s\n", debugstr_w(url));
+    TRACE("%s\n", debugstr_w(url));
     return TRUE;
 }
 
@@ -832,7 +832,7 @@ BOOL WINAPI IsProtectedModeURL(const WCHAR *url)
  */
 int WINAPI LogSqmBits(DWORD unk1, DWORD unk2)
 {
-    FIXME("stub: %ld %ld\n", unk1, unk2);
+    TRACE("%ld %ld\n", unk1, unk2);
     return 0;
 }
 
@@ -842,7 +842,7 @@ int WINAPI LogSqmBits(DWORD unk1, DWORD unk2)
  */
 int WINAPI LogSqmIncrement(DWORD unk1, DWORD unk2)
 {
-    FIXME("stub: %ld %ld\n", unk1, unk2);
+    TRACE("%ld %ld\n", unk1, unk2);
     return 0;
 }
 
@@ -852,7 +852,7 @@ int WINAPI LogSqmIncrement(DWORD unk1, DWORD unk2)
  */
 void WINAPI LogSqmUXCommandOffsetInternal(DWORD unk1, DWORD unk2, DWORD unk3, DWORD unk4)
 {
-    FIXME("stub: %ld %ld %ld %ld\n", unk1, unk2, unk3, unk4);
+    TRACE("%ld %ld %ld %ld\n", unk1, unk2, unk3, unk4);
 }
 
 /***********************************************************************
@@ -881,7 +881,7 @@ HRESULT WINAPI CoInternetGetBrowserProfile(DWORD unk)
  */
 void WINAPI FlushUrlmonZonesCache(void)
 {
-    FIXME("stub\n");
+    TRACE("\n");
 }
 
 /***********************************************************************
@@ -919,7 +919,7 @@ HRESULT WINAPI RegisterMediaTypes(UINT types, LPCSTR *szTypes, CLIPFORMAT *cfTyp
  */
 BOOL WINAPI ShouldShowIntranetWarningSecband(DWORD unk)
 {
-    FIXME("%lx: stub\n", unk);
+    TRACE("%lx\n", unk);
     return FALSE;
 }
 
