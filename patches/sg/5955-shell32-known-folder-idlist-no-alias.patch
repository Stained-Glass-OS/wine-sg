From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHGetKnownFolderIDList honours KF_FLAG_NO_ALIAS (5955)

shell32: SHGetKnownFolderIDList honours KF_FLAG_NO_ALIAS

With KF_FLAG_NO_ALIAS the Desktop and Documents are the folders on
disk, not their aliases in the namespace (the root; the Documents
item); the flag was ignored. ImgBurn's shell component (VirtualShellTools
TNamespace) creates its "physical" Desktop with it and resolves the
root's parsing name through it: given the root again, it recursed until
the 32-bit stack overflowed at every start (qa4/qa5 Store walk
2026-10-22). It now opens its main window. Without the flag nothing
changes.
Gate: test/noalias-gate.sh; mutant SG_MUTANT_NOALIAS.
---
diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index 6af37fa..29c3c82 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -4666,19 +4666,29 @@ HRESULT WINAPI KnownFolderManager_Constructor( IUnknown *punk, REFIID riid, void
 
 HRESULT WINAPI SHGetKnownFolderIDList(REFKNOWNFOLDERID rfid, DWORD flags, HANDLE token, PIDLIST_ABSOLUTE *pidl)
 {
+    BOOL alias;
+
     TRACE("%s, 0x%08lx, %p, %p\n", debugstr_guid(rfid), flags, token, pidl);
 
     if (!pidl)
         return E_INVALIDARG;
 
-    if (flags)
+    if (flags & ~KF_FLAG_NO_ALIAS)
         FIXME("unsupported flags: 0x%08lx\n", flags);
 
     if (token)
         FIXME("user token is not used.\n");
 
     *pidl = NULL;
-    if (IsEqualIID(rfid, &FOLDERID_Desktop))
+    /* KF_FLAG_NO_ALIAS: the Desktop and Documents themselves, not their aliases in the namespace (the
+       root, the Documents item): the folders on disk, as for any other known folder. Without it a
+       shell component that takes the "physical" Desktop to resolve the root recursed forever
+       (ImgBurn's VirtualShellTools TNamespace: stack overflow at start, qa4/qa5 2026-10-22) */
+    alias = !(flags & KF_FLAG_NO_ALIAS);
+#ifdef SG_MUTANT_NOALIAS
+    alias = TRUE;
+#endif
+    if (alias && IsEqualIID(rfid, &FOLDERID_Desktop))
         *pidl = _ILCreateDesktop();
     else if (IsEqualIID(rfid, &FOLDERID_RecycleBinFolder))
         *pidl = _ILCreateBitBucket();
@@ -4690,7 +4700,7 @@ HRESULT WINAPI SHGetKnownFolderIDList(REFKNOWNFOLDERID rfid, DWORD flags, HANDLE
         *pidl = _ILCreateControlPanel();
     else if (IsEqualIID(rfid, &FOLDERID_NetworkFolder))
         *pidl = _ILCreateNetwork();
-    else if (IsEqualIID(rfid, &FOLDERID_Documents))
+    else if (alias && IsEqualIID(rfid, &FOLDERID_Documents))
         *pidl = _ILCreateMyDocuments();
     else
     {
@@ -4698,7 +4708,7 @@ HRESULT WINAPI SHGetKnownFolderIDList(REFKNOWNFOLDERID rfid, DWORD flags, HANDLE
         WCHAR *pathW;
         HRESULT hr;
 
-        hr = SHGetKnownFolderPath(rfid, flags, token, &pathW);
+        hr = SHGetKnownFolderPath(rfid, flags & ~KF_FLAG_NO_ALIAS, token, &pathW);
         if (FAILED(hr))
             return hr;
 
