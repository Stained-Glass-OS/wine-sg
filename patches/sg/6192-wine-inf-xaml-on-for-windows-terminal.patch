From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wine.inf: Windows.UI.Xaml on for Windows Terminal

Windows Terminal has no Win32 fallback: with Windows.UI.Xaml off (6131) it stops at its first window. Its interface now draws with ours (tabs, typing, a second tab, its pane under DXVK), so wine.inf sets HKLM\Software\Wine\AppDefaults\WindowsTerminal.exe SgXaml=1 in every prefix, new or updated. Other programs keep XAML off unless switched on.
---
diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index 2f28ee4..ece8cbc 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -119,7 +119,8 @@ AddReg=\
     Tapi,\
     ThemeManager,\
     LicenseInformation,\
-    SgDllOverrides
+    SgDllOverrides,\
+    SgAppDefaults
 
 [DefaultInstall.NT]
 ProfileItems=AdminToolComputerManagement,AdminToolDeviceManager,AdminToolDiskCleanup,AdminToolDiskManagement,AdminToolEventViewer,AdminToolRegistryEditor,AdminToolResourceMonitor,AdminToolServices,AdminToolSystemInformation
@@ -145,7 +146,8 @@ AddReg=\
     ThemeManager,\
     VersionInfo,\
     LicenseInformation,\
-    SgDllOverrides
+    SgDllOverrides,\
+    SgAppDefaults
 
 [DefaultInstall.ntamd64]
 ProfileItems=AdminToolComputerManagement,AdminToolDeviceManager,AdminToolDiskCleanup,AdminToolDiskManagement,AdminToolEventViewer,AdminToolRegistryEditor,AdminToolResourceMonitor,AdminToolServices,AdminToolSystemInformation
@@ -172,7 +174,8 @@ AddReg=\
     ThemeManager,\
     VersionInfo,\
     LicenseInformation,\
-    SgDllOverrides
+    SgDllOverrides,\
+    SgAppDefaults
 
 [DefaultInstall.ntarm64]
 ProfileItems=AdminToolComputerManagement,AdminToolDeviceManager,AdminToolDiskCleanup,AdminToolDiskManagement,AdminToolEventViewer,AdminToolRegistryEditor,AdminToolResourceMonitor,AdminToolServices,AdminToolSystemInformation
@@ -199,7 +202,8 @@ AddReg=\
     ThemeManager,\
     VersionInfo,\
     LicenseInformation,\
-    SgDllOverrides
+    SgDllOverrides,\
+    SgAppDefaults
 
 [Wow64Install.ntx86]
 RegisterDlls=RegisterDllsSection
@@ -215,7 +219,8 @@ AddReg=\
     Tapi,\
     VersionInfo,\
     LicenseInformation,\
-    SgDllOverrides
+    SgDllOverrides,\
+    SgAppDefaults
 
 [Wow64Install.ntarm]
 RegisterDlls=RegisterDllsSection
@@ -231,7 +236,8 @@ AddReg=\
     Tapi,\
     VersionInfo,\
     LicenseInformation,\
-    SgDllOverrides
+    SgDllOverrides,\
+    SgAppDefaults
 
 [DefaultInstall.Services]
 AddService=BITS,0,BITSService
@@ -2851,6 +2857,12 @@ HKLM,Software\Wow6432Node\Registered Applications,"SymbolicLinkValue",0x60000,"\
 ; (Windows Terminal, node-pty: VS Code), which needs the kernel console driver
 HKLM,Software\Wine\DllOverrides,"conpty",,"builtin"
 
+[SgAppDefaults]
+; Stained Glass OS (wine-sg 6192): programs whose Windows.UI.Xaml interface draws with ours, so
+; Windows.UI.Xaml is on for them (Software\Wine\AppDefaults\<exe>\SgXaml, wine-sg 6131).
+; Windows Terminal has no Win32 fallback: without XAML it stops at its first window.
+HKLM,Software\Wine\AppDefaults\WindowsTerminal.exe,"SgXaml",0x10001,1
+
 [LicenseInformation]
 ; based on information from http://www.geoffchappell.com/notes/windows/license/install.htm
 HKLM,Software\Wine\LicenseInformation,"Kernel-MUI-Language-Allowed",,"EMPTY"
