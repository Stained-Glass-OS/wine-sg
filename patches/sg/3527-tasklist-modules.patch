From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tasklist: /m (3527)

tasklist: /m [module]

tasklist /m lists the modules each process has loaded (Image Name, PID, Modules; TABLE, CSV, LIST), /m pattern keeps
the processes with a matching module and lists only the matching ones (* and ? wildcards); a process that cannot be
examined shows N/A; no match prints the INFO line; /m with /v or /svc is a syntax error.
---
--- a/programs/tasklist/tasklist.c
+++ b/programs/tasklist/tasklist.c
@@ -447,6 +447,103 @@
     free(process_list);
 }
 
+/* ---- /m: the modules (DLLs) each process has loaded ---- */
+
+static BOOL tasklist_wildcard_match(const WCHAR *pattern, const WCHAR *text)
+{
+    for (; *pattern; pattern++, text++)
+    {
+        if (*pattern == '*')
+        {
+            while (pattern[1] == '*') pattern++;
+            if (!pattern[1]) return TRUE;
+            for (; *text; text++) if (tasklist_wildcard_match(pattern + 1, text)) return TRUE;
+            return FALSE;
+        }
+        if (!*text || (*pattern != '?' && towlower(*pattern) != towlower(*text))) return FALSE;
+    }
+    return !*text;
+}
+
+/* "a.dll,b.dll" for the modules of a process that match the pattern; NULL when none match, "N/A" when the
+ * process cannot be examined. The caller frees the result. */
+static WCHAR *tasklist_get_modules(DWORD pid, const WCHAR *pattern)
+{
+    MODULEENTRY32W module;
+    HANDLE snapshot;
+    WCHAR *out = NULL, *new;
+    size_t len = 0, cap = 0, n;
+    BOOL found = FALSE;
+
+    snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | 0x10 /* TH32CS_SNAPMODULE32 */, pid);
+    if (snapshot == INVALID_HANDLE_VALUE) return pattern ? NULL : wcsdup(L"N/A");
+
+    module.dwSize = sizeof(module);
+    if (Module32FirstW(snapshot, &module))
+    {
+        do
+        {
+            if (pattern && !tasklist_wildcard_match(pattern, module.szModule)) continue;
+            n = wcslen(module.szModule);
+            if (len + n + 2 > cap)
+            {
+                cap = max(cap * 2, len + n + 256);
+                if (!(new = realloc(out, cap * sizeof(WCHAR)))) break;
+                out = new;
+            }
+            if (found) out[len++] = ',';
+            memcpy(out + len, module.szModule, (n + 1) * sizeof(WCHAR));
+            len += n;
+            found = TRUE;
+        } while (Module32NextW(snapshot, &module));
+    }
+    CloseHandle(snapshot);
+    if (!found)
+    {
+        free(out);
+        return pattern ? NULL : wcsdup(L"N/A");
+    }
+    return out;
+}
+
+static void tasklist_print_modules(const struct tasklist_options *options, const struct tasklist_process_info *header)
+{
+    PROCESSENTRY32W *process_list;
+    struct tasklist_process_info info;
+    DWORD process_count, i;
+    WCHAR *modules;
+    BOOL any = FALSE;
+
+    process_list = enumerate_processes(&process_count);
+    for (i = 0; i < process_count; ++i)
+    {
+        if (!tasklist_get_process_info(&process_list[i], &info)) continue;
+        if (!tasklist_check_filters(options->filters, &info)) continue;
+        if (!(modules = tasklist_get_modules(process_list[i].th32ProcessID, options->module_pattern))) continue;
+
+        if (!any)
+        {
+            any = TRUE;
+            if (options->format == TABLE) wprintf(L"\n");
+            if (!options->no_header)
+            {
+                if (options->format == TABLE)
+                    wprintf(L"%-25.25s %8.8s %s\n========================= ======== ============================================\n",
+                            header->image_name, header->pid, L"Modules");
+                else if (options->format == CSV)
+                    wprintf(L"\"%s\",\"%s\",\"%s\"\n", header->image_name, header->pid, L"Modules");
+            }
+        }
+        if (options->format == TABLE) wprintf(L"%-25.25s %8.8s %s\n", info.image_name, info.pid, modules);
+        else if (options->format == CSV) wprintf(L"\"%s\",\"%s\",\"%s\"\n", info.image_name, info.pid, modules);
+        else wprintf(L"\n%-13.13s %s\n%-13.13s %s\n%-13.13s %s\n", header->image_name, info.image_name, header->pid, info.pid,
+                     L"Modules:", modules);
+        free(modules);
+    }
+    free(process_list);
+    if (!any) wprintf(L"INFO: No tasks are running which match the specified criteria.\n");
+}
+
 static void tasklist_print(const struct tasklist_options *options)
 {
     struct tasklist_process_info header, info;
@@ -454,6 +551,11 @@
     DWORD process_count, i;
 
     tasklist_get_header(options, &header);
+    if (options->modules)
+    {
+        tasklist_print_modules(options, &header);
+        return;
+    }
     if (options->verbose || options->services)
     {
         tasklist_print_extended(options, &header);
@@ -533,6 +635,11 @@
         {
             options.services = TRUE;
         }
+        else if (!wcsicmp(argv[i], L"/m"))
+        {
+            options.modules = TRUE;
+            if (i + 1 < argc && argv[i + 1][0] != '/') options.module_pattern = argv[++i];
+        }
         else if (!wcsicmp(argv[i], L"/fo"))
         {
             if (i + 1 >= argc)
@@ -657,6 +764,12 @@
         }
     }
 
+    if (options.modules && (options.verbose || options.services))
+    {
+        tasklist_error(STRING_INVALID_SYNTAX);
+        ret = 1;
+        goto done;
+    }
     tasklist_print(&options);
 
 done:
--- a/programs/tasklist/tasklist.h
+++ b/programs/tasklist/tasklist.h
@@ -90,6 +90,8 @@
     BOOL no_header;
     BOOL verbose;
     BOOL services;
+    BOOL modules;
+    const WCHAR *module_pattern;
     enum tasklist_format format;
     struct tasklist_filter *filters;
 };
