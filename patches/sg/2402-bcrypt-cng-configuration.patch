--- /dev/null
+++ b/dlls/bcrypt/config.c
@@ -0,0 +1,1138 @@
+/*
+ * CNG configuration store: contexts, context functions, providers
+ *
+ * Windows keeps this in the registry under
+ * HKLM\SYSTEM\CurrentControlSet\Control\Cryptography\Configuration (and the
+ * Providers key).  This implementation keeps the same model in memory for the
+ * lifetime of the process: a table (local or domain) holds named contexts, a
+ * context holds an ordered list of functions per interface, a function holds
+ * an ordered list of providers plus named properties, and registered
+ * providers are described by a CRYPT_PROVIDER_REG.
+ *
+ * Every buffer handed back to the caller is a single allocation with the
+ * pointers inside it pointing into the same block, so BCryptFreeBuffer (free)
+ * releases it.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "bcrypt.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "wine/unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(bcrypt);
+
+#define PRIMITIVE_PROVIDER L"Microsoft Primitive Provider"
+#define PRIMITIVE_IMAGE    L"bcryptprimitives.dll"
+#define FIRST_INTERFACE    BCRYPT_CIPHER_INTERFACE
+#define LAST_INTERFACE     BCRYPT_KEY_DERIVATION_INTERFACE
+
+struct name_entry
+{
+    struct list entry;
+    WCHAR      *name;
+};
+
+struct property
+{
+    struct list entry;
+    WCHAR      *name;
+    ULONG       size;
+    BYTE       *data;
+};
+
+struct function
+{
+    struct list entry;
+    ULONG       iface;
+    WCHAR      *name;
+    ULONG       flags, reserved;
+    struct list providers;  /* name_entry, in priority order */
+    struct list properties;
+};
+
+struct context
+{
+    struct list entry;
+    WCHAR      *name;
+    ULONG       flags, reserved;
+    struct list functions;  /* all interfaces, grouped only by list order */
+};
+
+struct provider
+{
+    struct list         entry;
+    WCHAR              *name;
+    CRYPT_PROVIDER_REG *reg;  /* single block, see fill_provider_reg() */
+};
+
+static SRWLOCK config_lock = SRWLOCK_INIT;
+static BOOL    seeded;
+static struct list contexts[2] = { LIST_INIT( contexts[0] ), LIST_INIT( contexts[1] ) };
+static struct list providers = LIST_INIT( providers );
+
+/* a size-measuring / filling bump allocator */
+struct blob
+{
+    BYTE   *base;  /* NULL while measuring */
+    SIZE_T  size;
+};
+
+static void *blob_alloc( struct blob *b, SIZE_T size )
+{
+    SIZE_T off = (b->size + 7) & ~(SIZE_T)7;
+    b->size = off + size;
+    return b->base ? b->base + off : NULL;
+}
+
+static WCHAR *blob_str( struct blob *b, const WCHAR *str )
+{
+    SIZE_T len = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = blob_alloc( b, len );
+    if (ret) memcpy( ret, str, len );
+    return ret;
+}
+
+typedef void (*fill_func)( struct blob *b, const void *arg );
+
+static NTSTATUS alloc_blob( fill_func fill, const void *arg, void **out, ULONG *size )
+{
+    struct blob b = { NULL, 0 };
+    void *mem;
+
+    fill( &b, arg );
+    if (!(mem = malloc( b.size ? b.size : 1 ))) return STATUS_NO_MEMORY;
+    b.base = mem;
+    b.size = 0;
+    fill( &b, arg );
+    *out = mem;
+    if (size) *size = b.size;
+    return STATUS_SUCCESS;
+}
+
+/* the Query/Enum convention: *buffer == NULL asks for an allocation, otherwise
+ * the caller supplies *size bytes at *buffer */
+static NTSTATUS deliver( fill_func fill, const void *arg, ULONG *size, void **buffer )
+{
+    struct blob b = { NULL, 0 };
+
+    if (!size || !buffer) return STATUS_INVALID_PARAMETER;
+    if (!*buffer) return alloc_blob( fill, arg, buffer, size );
+
+    fill( &b, arg );
+    if (*size < b.size)
+    {
+        *size = b.size;
+        return STATUS_BUFFER_TOO_SMALL;
+    }
+    b.base = *buffer;
+    b.size = 0;
+    fill( &b, arg );
+    *size = b.size;
+    return STATUS_SUCCESS;
+}
+
+static BOOL name_eq( const WCHAR *a, const WCHAR *b )
+{
+#ifdef SG_MUTANT_BCCFG_CASE
+    return !wcscmp( a, b );
+#else
+    return !wcsicmp( a, b );
+#endif
+}
+
+static WCHAR *dup_str( const WCHAR *str )
+{
+    SIZE_T len = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = malloc( len );
+    if (ret) memcpy( ret, str, len );
+    return ret;
+}
+
+static BOOL valid_table( ULONG table )
+{
+    return table == CRYPT_LOCAL || table == CRYPT_DOMAIN;
+}
+
+static BOOL valid_interface( ULONG iface )
+{
+    /* the BCRYPT_* primitive interfaces and the NCRYPT_* key storage ones */
+    return (iface >= FIRST_INTERFACE && iface <= LAST_INTERFACE) || (iface >= 0x10001 && iface <= 0x10004);
+}
+
+static BOOL valid_name( const WCHAR *name )
+{
+    return name && name[0];
+}
+
+/* ---- provider registration blobs ---- */
+
+struct reg_copy
+{
+    const CRYPT_PROVIDER_REG *src;
+    ULONG                     mode;   /* 0 = copy everything */
+    ULONG                     iface;  /* 0 = all interfaces */
+};
+
+static CRYPT_IMAGE_REG *fill_image( struct blob *b, const CRYPT_IMAGE_REG *src, ULONG iface )
+{
+    CRYPT_IMAGE_REG *image;
+    CRYPT_INTERFACE_REG **list;
+    ULONG i, j, k, count = 0;
+
+    for (i = 0; i < src->cInterfaces; i++)
+        if (!iface || src->rgpInterfaces[i]->dwInterface == iface) count++;
+
+    image = blob_alloc( b, sizeof(*image) );
+    list = blob_alloc( b, count * sizeof(*list) );
+    if (image)
+    {
+        image->pszImage = blob_str( b, src->pszImage );
+        image->cInterfaces = count;
+        image->rgpInterfaces = list;
+    }
+    else blob_str( b, src->pszImage );
+
+    for (i = 0, j = 0; i < src->cInterfaces; i++)
+    {
+        const CRYPT_INTERFACE_REG *in = src->rgpInterfaces[i];
+        CRYPT_INTERFACE_REG *out;
+        PWSTR *funcs;
+
+        if (iface && in->dwInterface != iface) continue;
+        out = blob_alloc( b, sizeof(*out) );
+        funcs = blob_alloc( b, in->cFunctions * sizeof(*funcs) );
+        if (out)
+        {
+            out->dwInterface = in->dwInterface;
+            out->dwFlags = in->dwFlags;
+            out->cFunctions = in->cFunctions;
+            out->rgpszFunctions = funcs;
+            list[j] = out;
+        }
+        for (k = 0; k < in->cFunctions; k++)
+        {
+            WCHAR *s = blob_str( b, in->rgpszFunctions[k] );
+            if (funcs) funcs[k] = s;
+        }
+        j++;
+    }
+    return image;
+}
+
+static void fill_provider_reg( struct blob *b, const void *arg )
+{
+    const struct reg_copy *rc = arg;
+    const CRYPT_PROVIDER_REG *src = rc->src;
+    CRYPT_PROVIDER_REG *reg;
+    PWSTR *aliases;
+    ULONG i;
+
+    reg = blob_alloc( b, sizeof(*reg) );
+    aliases = blob_alloc( b, src->cAliases * sizeof(*aliases) );
+    if (reg)
+    {
+        reg->cAliases = src->cAliases;
+        reg->rgpszAliases = aliases;
+        reg->pUM = reg->pKM = NULL;
+    }
+    for (i = 0; i < src->cAliases; i++)
+    {
+        WCHAR *s = blob_str( b, src->rgpszAliases[i] );
+        if (aliases) aliases[i] = s;
+    }
+    if (src->pUM && rc->mode != CRYPT_KM)
+    {
+        CRYPT_IMAGE_REG *image = fill_image( b, src->pUM, rc->iface );
+        if (reg) reg->pUM = image;
+    }
+    if (src->pKM && rc->mode != CRYPT_UM)
+    {
+        CRYPT_IMAGE_REG *image = fill_image( b, src->pKM, rc->iface );
+        if (reg) reg->pKM = image;
+    }
+}
+
+static BOOL valid_image( const CRYPT_IMAGE_REG *image )
+{
+    ULONG i, j;
+
+    if (!valid_name( image->pszImage )) return FALSE;
+    if (image->cInterfaces && !image->rgpInterfaces) return FALSE;
+    for (i = 0; i < image->cInterfaces; i++)
+    {
+        const CRYPT_INTERFACE_REG *iface = image->rgpInterfaces[i];
+        if (!iface || !valid_interface( iface->dwInterface )) return FALSE;
+        if (iface->cFunctions && !iface->rgpszFunctions) return FALSE;
+        for (j = 0; j < iface->cFunctions; j++)
+            if (!valid_name( iface->rgpszFunctions[j] )) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL valid_provider_reg( const CRYPT_PROVIDER_REG *reg )
+{
+    ULONG i;
+
+    if (reg->cAliases && !reg->rgpszAliases) return FALSE;
+    for (i = 0; i < reg->cAliases; i++)
+        if (!valid_name( reg->rgpszAliases[i] )) return FALSE;
+    if (reg->pUM && !valid_image( reg->pUM )) return FALSE;
+    if (reg->pKM && !valid_image( reg->pKM )) return FALSE;
+    return TRUE;
+}
+
+static struct provider *find_provider( const WCHAR *name )
+{
+    struct provider *p;
+    LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry )
+        if (name_eq( p->name, name )) return p;
+    return NULL;
+}
+
+static NTSTATUS register_provider( const WCHAR *name, ULONG flags, const CRYPT_PROVIDER_REG *reg )
+{
+    struct reg_copy rc = { reg, 0, 0 };
+    struct provider *p = find_provider( name );
+    CRYPT_PROVIDER_REG *copy;
+    NTSTATUS status;
+
+    if (p && !(flags & CRYPT_OVERWRITE)) return STATUS_OBJECT_NAME_COLLISION;
+    if ((status = alloc_blob( fill_provider_reg, &rc, (void **)&copy, NULL ))) return status;
+    if (p)
+    {
+        free( p->reg );
+        p->reg = copy;
+        return STATUS_SUCCESS;
+    }
+    if (!(p = malloc( sizeof(*p) )) || !(p->name = dup_str( name )))
+    {
+        free( p );
+        free( copy );
+        return STATUS_NO_MEMORY;
+    }
+    p->reg = copy;
+    list_add_tail( &providers, &p->entry );
+    return STATUS_SUCCESS;
+}
+
+/* ---- contexts ---- */
+
+static struct context *find_context( ULONG table, const WCHAR *name )
+{
+    struct context *ctx;
+    LIST_FOR_EACH_ENTRY( ctx, &contexts[table - 1], struct context, entry )
+        if (name_eq( ctx->name, name )) return ctx;
+    return NULL;
+}
+
+static struct function *find_function( struct context *ctx, ULONG iface, const WCHAR *name )
+{
+    struct function *f;
+    LIST_FOR_EACH_ENTRY( f, &ctx->functions, struct function, entry )
+        if (f->iface == iface && name_eq( f->name, name )) return f;
+    return NULL;
+}
+
+static void free_names( struct list *list )
+{
+    struct name_entry *n, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( n, next, list, struct name_entry, entry )
+    {
+        list_remove( &n->entry );
+        free( n->name );
+        free( n );
+    }
+}
+
+static void free_function( struct function *f )
+{
+    struct property *p, *next;
+
+    free_names( &f->providers );
+    LIST_FOR_EACH_ENTRY_SAFE( p, next, &f->properties, struct property, entry )
+    {
+        list_remove( &p->entry );
+        free( p->name );
+        free( p->data );
+        free( p );
+    }
+    list_remove( &f->entry );
+    free( f->name );
+    free( f );
+}
+
+static struct context *add_context( ULONG table, const WCHAR *name, const CRYPT_CONTEXT_CONFIG *cfg )
+{
+    struct context *ctx;
+
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return NULL;
+    if (!(ctx->name = dup_str( name )))
+    {
+        free( ctx );
+        return NULL;
+    }
+    if (cfg)
+    {
+        ctx->flags = cfg->dwFlags;
+        ctx->reserved = cfg->dwReserved;
+    }
+    list_init( &ctx->functions );
+    list_add_tail( &contexts[table - 1], &ctx->entry );
+    return ctx;
+}
+
+static BOOL add_name( struct list *list, const WCHAR *name, ULONG pos )
+{
+    struct name_entry *n, *at;
+    ULONG i = 0;
+
+    if (!(n = malloc( sizeof(*n) ))) return FALSE;
+    if (!(n->name = dup_str( name )))
+    {
+        free( n );
+        return FALSE;
+    }
+    if (pos != CRYPT_PRIORITY_BOTTOM)
+    {
+        LIST_FOR_EACH_ENTRY( at, list, struct name_entry, entry )
+        {
+            if (i++ == pos)
+            {
+                list_add_before( &at->entry, &n->entry );
+                return TRUE;
+            }
+        }
+    }
+    list_add_tail( list, &n->entry );
+    return TRUE;
+}
+
+static struct function *add_function( struct context *ctx, ULONG iface, const WCHAR *name, ULONG pos )
+{
+    struct function *f, *at;
+    ULONG i = 0;
+
+    if (!(f = calloc( 1, sizeof(*f) ))) return NULL;
+    if (!(f->name = dup_str( name )))
+    {
+        free( f );
+        return NULL;
+    }
+    f->iface = iface;
+    list_init( &f->providers );
+    list_init( &f->properties );
+#ifdef SG_MUTANT_BCCFG_ORDER
+    pos = CRYPT_PRIORITY_BOTTOM;
+#endif
+    if (pos != CRYPT_PRIORITY_BOTTOM)
+    {
+        LIST_FOR_EACH_ENTRY( at, &ctx->functions, struct function, entry )
+        {
+            if (at->iface != iface) continue;
+            if (i++ == pos)
+            {
+                list_add_before( &at->entry, &f->entry );
+                return f;
+            }
+        }
+    }
+    list_add_tail( &ctx->functions, &f->entry );
+    return f;
+}
+
+/* Default context and the built-in provider are derived from the algorithms
+ * this bcrypt implements, so the two never disagree with BCryptEnumAlgorithms. */
+static void seed_config(void)
+{
+    BCRYPT_ALGORITHM_IDENTIFIER *algs;
+    CRYPT_INTERFACE_REG ifaces[LAST_INTERFACE + 1], *iface_list[LAST_INTERFACE];
+    CRYPT_IMAGE_REG image;
+    CRYPT_PROVIDER_REG reg;
+    struct context *ctx;
+    PWSTR *names[LAST_INTERFACE + 1] = { 0 };
+    ULONG count, i, j, n, iface;
+
+    if (seeded) return;
+    seeded = TRUE;
+
+    ctx = add_context( CRYPT_LOCAL, L"Default", NULL );
+    add_context( CRYPT_LOCAL, L"SSL", NULL );
+    if (BCryptEnumAlgorithms( 0, &count, &algs, 0 )) return;
+
+    memset( ifaces, 0, sizeof(ifaces) );
+    for (i = 0; i < count; i++)
+    {
+        struct function *f;
+
+        iface = algs[i].dwClass;
+        if (!valid_interface( iface )) continue;
+        if (ctx && (f = add_function( ctx, iface, algs[i].pszName, CRYPT_PRIORITY_BOTTOM )))
+            add_name( &f->providers, PRIMITIVE_PROVIDER, CRYPT_PRIORITY_BOTTOM );
+        ifaces[iface].cFunctions++;
+    }
+
+    for (iface = FIRST_INTERFACE, n = 0; iface <= LAST_INTERFACE; iface++)
+    {
+        if (!ifaces[iface].cFunctions) continue;
+        ifaces[iface].dwInterface = iface;
+        if (!(names[iface] = malloc( ifaces[iface].cFunctions * sizeof(PWSTR) ))) ifaces[iface].cFunctions = 0;
+        ifaces[iface].rgpszFunctions = names[iface];
+        for (i = 0, j = 0; i < count && names[iface]; i++)
+            if (algs[i].dwClass == iface) names[iface][j++] = algs[i].pszName;
+        iface_list[n++] = &ifaces[iface];
+    }
+
+    image.pszImage = (WCHAR *)PRIMITIVE_IMAGE;
+    image.cInterfaces = n;
+    image.rgpInterfaces = iface_list;
+    reg.cAliases = 0;
+    reg.rgpszAliases = NULL;
+    reg.pUM = &image;
+    reg.pKM = NULL;
+#ifndef SG_MUTANT_BCCFG_NOSEED
+    register_provider( PRIMITIVE_PROVIDER, 0, &reg );
+#endif
+
+    for (iface = FIRST_INTERFACE; iface <= LAST_INTERFACE; iface++) free( names[iface] );
+    BCryptFreeBuffer( algs );
+}
+
+/* ---- string-list results ---- */
+
+struct strlist
+{
+    ULONG          count;
+    const WCHAR  **names;
+};
+
+/* CRYPT_CONTEXTS, CRYPT_CONTEXT_FUNCTIONS, CRYPT_PROVIDERS and
+ * CRYPT_CONTEXT_FUNCTION_PROVIDERS all share one layout */
+static void fill_strlist( struct blob *b, const void *arg )
+{
+    const struct strlist *l = arg;
+    struct { ULONG count; PWSTR *list; } *hdr;
+    PWSTR *list;
+    ULONG i;
+
+    hdr = blob_alloc( b, sizeof(*hdr) );
+    list = blob_alloc( b, l->count * sizeof(*list) );
+    if (hdr)
+    {
+        hdr->count = l->count;
+        hdr->list = list;
+    }
+    for (i = 0; i < l->count; i++)
+    {
+        WCHAR *s = blob_str( b, l->names[i] );
+        if (list) list[i] = s;
+    }
+}
+
+static void fill_provider_names( struct blob *b, const void *arg )
+{
+    const struct strlist *l = arg;
+    BCRYPT_PROVIDER_NAME *list;
+    ULONG i;
+
+    list = blob_alloc( b, l->count * sizeof(*list) );
+    for (i = 0; i < l->count; i++)
+    {
+        WCHAR *s = blob_str( b, l->names[i] );
+        if (list) list[i].pszProviderName = s;
+    }
+}
+
+static NTSTATUS deliver_names( struct list *list, ULONG *size, void **buffer )
+{
+    struct strlist l = { 0, NULL };
+    struct name_entry *n;
+    NTSTATUS status;
+
+    LIST_FOR_EACH_ENTRY( n, list, struct name_entry, entry ) l.count++;
+    if (!(l.names = malloc( (l.count + 1) * sizeof(*l.names) ))) return STATUS_NO_MEMORY;
+    l.count = 0;
+    LIST_FOR_EACH_ENTRY( n, list, struct name_entry, entry ) l.names[l.count++] = n->name;
+    status = deliver( fill_strlist, &l, size, buffer );
+    free( l.names );
+    return status;
+}
+
+/* ---- public API ---- */
+
+NTSTATUS WINAPI BCryptCreateContext( ULONG table, const WCHAR *ctx_name, CRYPT_CONTEXT_CONFIG *cfg )
+{
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %p\n", table, debugstr_w(ctx_name), cfg );
+
+    if (!valid_table( table ) || !valid_name( ctx_name )) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (find_context( table, ctx_name )) status = STATUS_OBJECT_NAME_COLLISION;
+    else if (!add_context( table, ctx_name, cfg )) status = STATUS_NO_MEMORY;
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptDeleteContext( ULONG table, const WCHAR *ctx_name )
+{
+    struct context *ctx;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s\n", table, debugstr_w(ctx_name) );
+
+    if (!valid_table( table ) || !valid_name( ctx_name )) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name ))) status = STATUS_NOT_FOUND;
+    else
+    {
+        while (!list_empty( &ctx->functions ))
+            free_function( LIST_ENTRY( list_head( &ctx->functions ), struct function, entry ) );
+        list_remove( &ctx->entry );
+        free( ctx->name );
+        free( ctx );
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptConfigureContext( ULONG table, const WCHAR *ctx_name, CRYPT_CONTEXT_CONFIG *cfg )
+{
+    struct context *ctx;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %p\n", table, debugstr_w(ctx_name), cfg );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !cfg) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name ))) status = STATUS_NOT_FOUND;
+    else
+    {
+        ctx->flags = cfg->dwFlags;
+        ctx->reserved = cfg->dwReserved;
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+static void fill_context_config( struct blob *b, const void *arg )
+{
+    const struct context *ctx = arg;
+    CRYPT_CONTEXT_CONFIG *cfg = blob_alloc( b, sizeof(*cfg) );
+
+    if (cfg)
+    {
+        cfg->dwFlags = ctx->flags;
+        cfg->dwReserved = ctx->reserved;
+    }
+}
+
+NTSTATUS WINAPI BCryptQueryContextConfiguration( ULONG table, const WCHAR *ctx_name, ULONG *size,
+                                                 CRYPT_CONTEXT_CONFIG **buffer )
+{
+    struct context *ctx;
+    NTSTATUS status;
+
+    TRACE( "%#lx, %s, %p, %p\n", table, debugstr_w(ctx_name), size, buffer );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !size || !buffer) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name ))) status = STATUS_NOT_FOUND;
+    else status = deliver( fill_context_config, ctx, size, (void **)buffer );
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptEnumContexts( ULONG table, ULONG *size, CRYPT_CONTEXTS **buffer )
+{
+    struct strlist l = { 0, NULL };
+    struct context *ctx;
+    NTSTATUS status;
+
+    TRACE( "%#lx, %p, %p\n", table, size, buffer );
+
+    if (!valid_table( table ) || !size || !buffer) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    LIST_FOR_EACH_ENTRY( ctx, &contexts[table - 1], struct context, entry ) l.count++;
+    if (!(l.names = malloc( (l.count + 1) * sizeof(*l.names) ))) status = STATUS_NO_MEMORY;
+    else
+    {
+        l.count = 0;
+        LIST_FOR_EACH_ENTRY( ctx, &contexts[table - 1], struct context, entry ) l.names[l.count++] = ctx->name;
+        status = deliver( fill_strlist, &l, size, (void **)buffer );
+        free( l.names );
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptAddContextFunction( ULONG table, const WCHAR *ctx_name, ULONG iface, const WCHAR *func,
+                                          ULONG pos )
+{
+    struct context *ctx;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %#lx, %s, %lu\n", table, debugstr_w(ctx_name), iface, debugstr_w(func), pos );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ))
+        return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name ))) status = STATUS_NOT_FOUND;
+    else if (find_function( ctx, iface, func )) status = STATUS_OBJECT_NAME_COLLISION;
+    else if (!add_function( ctx, iface, func, pos )) status = STATUS_NO_MEMORY;
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptRemoveContextFunction( ULONG table, const WCHAR *ctx_name, ULONG iface, const WCHAR *func )
+{
+    struct context *ctx;
+    struct function *f;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %#lx, %s\n", table, debugstr_w(ctx_name), iface, debugstr_w(func) );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ))
+        return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name )) || !(f = find_function( ctx, iface, func ))) status = STATUS_NOT_FOUND;
+    else free_function( f );
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptEnumContextFunctions( ULONG table, const WCHAR *ctx_name, ULONG iface, ULONG *size,
+                                            CRYPT_CONTEXT_FUNCTIONS **buffer )
+{
+    struct strlist l = { 0, NULL };
+    struct context *ctx;
+    struct function *f;
+    NTSTATUS status;
+
+    TRACE( "%#lx, %s, %#lx, %p, %p\n", table, debugstr_w(ctx_name), iface, size, buffer );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !size || !buffer)
+        return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name ))) status = STATUS_NOT_FOUND;
+    else
+    {
+        LIST_FOR_EACH_ENTRY( f, &ctx->functions, struct function, entry ) if (f->iface == iface) l.count++;
+        if (!(l.names = malloc( (l.count + 1) * sizeof(*l.names) ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            l.count = 0;
+            LIST_FOR_EACH_ENTRY( f, &ctx->functions, struct function, entry )
+                if (f->iface == iface) l.names[l.count++] = f->name;
+            status = deliver( fill_strlist, &l, size, (void **)buffer );
+            free( l.names );
+        }
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+static void fill_function_config( struct blob *b, const void *arg )
+{
+    const struct function *f = arg;
+    CRYPT_CONTEXT_FUNCTION_CONFIG *cfg = blob_alloc( b, sizeof(*cfg) );
+
+    if (cfg)
+    {
+        cfg->dwFlags = f->flags;
+        cfg->dwReserved = f->reserved;
+    }
+}
+
+NTSTATUS WINAPI BCryptConfigureContextFunction( ULONG table, const WCHAR *ctx_name, ULONG iface, const WCHAR *func,
+                                                CRYPT_CONTEXT_FUNCTION_CONFIG *cfg )
+{
+    struct context *ctx;
+    struct function *f;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %#lx, %s, %p\n", table, debugstr_w(ctx_name), iface, debugstr_w(func), cfg );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) || !cfg)
+        return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name )) || !(f = find_function( ctx, iface, func ))) status = STATUS_NOT_FOUND;
+    else
+    {
+        f->flags = cfg->dwFlags;
+        f->reserved = cfg->dwReserved;
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptQueryContextFunctionConfiguration( ULONG table, const WCHAR *ctx_name, ULONG iface,
+                                                         const WCHAR *func, ULONG *size,
+                                                         CRYPT_CONTEXT_FUNCTION_CONFIG **buffer )
+{
+    struct context *ctx;
+    struct function *f;
+    NTSTATUS status;
+
+    TRACE( "%#lx, %s, %#lx, %s, %p, %p\n", table, debugstr_w(ctx_name), iface, debugstr_w(func), size, buffer );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) ||
+        !size || !buffer) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name )) || !(f = find_function( ctx, iface, func ))) status = STATUS_NOT_FOUND;
+    else status = deliver( fill_function_config, f, size, (void **)buffer );
+    ReleaseSRWLockExclusive( &config_lock );
