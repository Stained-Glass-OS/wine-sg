+}
+
+NTSTATUS WINAPI BCryptAddContextFunctionProvider( ULONG table, const WCHAR *ctx_name, ULONG iface, const WCHAR *func,
+                                                  const WCHAR *provider, ULONG pos )
+{
+    struct context *ctx;
+    struct function *f;
+    struct name_entry *n;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %#lx, %s, %s, %lu\n", table, debugstr_w(ctx_name), iface, debugstr_w(func),
+           debugstr_w(provider), pos );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) ||
+        !valid_name( provider )) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name )) || !(f = find_function( ctx, iface, func ))) status = STATUS_NOT_FOUND;
+    else
+    {
+        LIST_FOR_EACH_ENTRY( n, &f->providers, struct name_entry, entry )
+            if (name_eq( n->name, provider )) status = STATUS_OBJECT_NAME_COLLISION;
+        if (!status && !add_name( &f->providers, provider, pos )) status = STATUS_NO_MEMORY;
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptRemoveContextFunctionProvider( ULONG table, const WCHAR *ctx_name, ULONG iface,
+                                                     const WCHAR *func, const WCHAR *provider )
+{
+    struct context *ctx;
+    struct function *f;
+    struct name_entry *n;
+    NTSTATUS status = STATUS_NOT_FOUND;
+
+    TRACE( "%#lx, %s, %#lx, %s, %s\n", table, debugstr_w(ctx_name), iface, debugstr_w(func), debugstr_w(provider) );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) ||
+        !valid_name( provider )) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if ((ctx = find_context( table, ctx_name )) && (f = find_function( ctx, iface, func )))
+    {
+        LIST_FOR_EACH_ENTRY( n, &f->providers, struct name_entry, entry )
+        {
+            if (!name_eq( n->name, provider )) continue;
+            list_remove( &n->entry );
+            free( n->name );
+            free( n );
+            status = STATUS_SUCCESS;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptEnumContextFunctionProviders( ULONG table, const WCHAR *ctx_name, ULONG iface,
+                                                    const WCHAR *func, ULONG *size,
+                                                    CRYPT_CONTEXT_FUNCTION_PROVIDERS **buffer )
+{
+    struct context *ctx;
+    struct function *f;
+    NTSTATUS status;
+
+    TRACE( "%#lx, %s, %#lx, %s, %p, %p\n", table, debugstr_w(ctx_name), iface, debugstr_w(func), size, buffer );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) ||
+        !size || !buffer) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name )) || !(f = find_function( ctx, iface, func ))) status = STATUS_NOT_FOUND;
+    else status = deliver_names( &f->providers, size, (void **)buffer );
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptSetContextFunctionProperty( ULONG table, const WCHAR *ctx_name, ULONG iface, const WCHAR *func,
+                                                  const WCHAR *prop_name, ULONG size, UCHAR *value )
+{
+    struct context *ctx;
+    struct function *f;
+    struct property *p;
+    BYTE *data = NULL;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%#lx, %s, %#lx, %s, %s, %lu, %p\n", table, debugstr_w(ctx_name), iface, debugstr_w(func),
+           debugstr_w(prop_name), size, value );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) ||
+        !valid_name( prop_name ) || (size && !value)) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(ctx = find_context( table, ctx_name )) || !(f = find_function( ctx, iface, func ))) status = STATUS_NOT_FOUND;
+    else if (!(data = malloc( size ? size : 1 ))) status = STATUS_NO_MEMORY;
+    else
+    {
+        if (size) memcpy( data, value, size );
+        LIST_FOR_EACH_ENTRY( p, &f->properties, struct property, entry )
+        {
+            if (!name_eq( p->name, prop_name )) continue;
+            free( p->data );
+            p->data = data;
+            p->size = size;
+            goto done;
+        }
+        if (!(p = malloc( sizeof(*p) )) || !(p->name = dup_str( prop_name )))
+        {
+            free( p );
+            free( data );
+            status = STATUS_NO_MEMORY;
+            goto done;
+        }
+        p->data = data;
+        p->size = size;
+        list_add_tail( &f->properties, &p->entry );
+    }
+done:
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+static void fill_property( struct blob *b, const void *arg )
+{
+    const struct property *p = arg;
+    BYTE *data = blob_alloc( b, p->size ? p->size : 1 );
+
+    if (data && p->size) memcpy( data, p->data, p->size );
+}
+
+NTSTATUS WINAPI BCryptQueryContextFunctionProperty( ULONG table, const WCHAR *ctx_name, ULONG iface,
+                                                    const WCHAR *func, const WCHAR *prop_name, ULONG *size,
+                                                    UCHAR **value )
+{
+    struct context *ctx;
+    struct function *f;
+    struct property *p;
+    NTSTATUS status = STATUS_NOT_FOUND;
+
+    TRACE( "%#lx, %s, %#lx, %s, %s, %p, %p\n", table, debugstr_w(ctx_name), iface, debugstr_w(func),
+           debugstr_w(prop_name), size, value );
+
+    if (!valid_table( table ) || !valid_name( ctx_name ) || !valid_interface( iface ) || !valid_name( func ) ||
+        !valid_name( prop_name ) || !size || !value) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if ((ctx = find_context( table, ctx_name )) && (f = find_function( ctx, iface, func )))
+    {
+        LIST_FOR_EACH_ENTRY( p, &f->properties, struct property, entry )
+        {
+            if (!name_eq( p->name, prop_name )) continue;
+            /* the reported size is the property's, not the block's */
+            if (!*value)
+            {
+                ULONG ignored;
+                status = alloc_blob( fill_property, p, (void **)value, &ignored );
+                if (!status) *size = p->size;
+            }
+            else if (*size < p->size)
+            {
+                *size = p->size;
+                status = STATUS_BUFFER_TOO_SMALL;
+            }
+            else
+            {
+                if (p->size) memcpy( *value, p->data, p->size );
+                *size = p->size;
+                status = STATUS_SUCCESS;
+            }
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+/* ---- providers ---- */
+
+NTSTATUS WINAPI BCryptRegisterProvider( const WCHAR *name, ULONG flags, CRYPT_PROVIDER_REG *reg )
+{
+    NTSTATUS status;
+
+    TRACE( "%s, %#lx, %p\n", debugstr_w(name), flags, reg );
+
+    if (!valid_name( name ) || !reg || (flags & ~CRYPT_OVERWRITE) || !valid_provider_reg( reg ))
+        return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    status = register_provider( name, flags, reg );
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptUnregisterProvider( const WCHAR *name )
+{
+    struct provider *p;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    TRACE( "%s\n", debugstr_w(name) );
+
+    if (!valid_name( name )) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(p = find_provider( name ))) status = STATUS_NOT_FOUND;
+    else
+    {
+        list_remove( &p->entry );
+        free( p->reg );
+        free( p->name );
+        free( p );
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptQueryProviderRegistration( const WCHAR *name, ULONG mode, ULONG iface, ULONG *size,
+                                                 CRYPT_PROVIDER_REG **buffer )
+{
+    struct provider *p;
+    struct reg_copy rc;
+    NTSTATUS status;
+
+    TRACE( "%s, %#lx, %#lx, %p, %p\n", debugstr_w(name), mode, iface, size, buffer );
+
+    if (!valid_name( name ) || !size || !buffer || mode < CRYPT_UM || mode > CRYPT_ANY ||
+        (iface && !valid_interface( iface ))) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    if (!(p = find_provider( name ))) status = STATUS_NOT_FOUND;
+    else if ((mode == CRYPT_UM && !p->reg->pUM) || (mode == CRYPT_KM && !p->reg->pKM) ||
+             (mode == CRYPT_MM && (!p->reg->pUM || !p->reg->pKM)))
+        status = STATUS_NOT_FOUND;
+    else
+    {
+        rc.src = p->reg;
+        rc.mode = (mode == CRYPT_UM || mode == CRYPT_KM) ? mode : 0;
+#ifdef SG_MUTANT_BCCFG_FILTER
+        rc.iface = 0;
+#else
+        rc.iface = iface;
+#endif
+        status = deliver( fill_provider_reg, &rc, size, (void **)buffer );
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+NTSTATUS WINAPI BCryptEnumRegisteredProviders( ULONG *size, CRYPT_PROVIDERS **buffer )
+{
+    struct strlist l = { 0, NULL };
+    struct provider *p;
+    NTSTATUS status;
+
+    TRACE( "%p, %p\n", size, buffer );
+
+    if (!size || !buffer) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry ) l.count++;
+    if (!(l.names = malloc( (l.count + 1) * sizeof(*l.names) ))) status = STATUS_NO_MEMORY;
+    else
+    {
+        l.count = 0;
+        LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry ) l.names[l.count++] = p->name;
+        status = deliver( fill_strlist, &l, size, (void **)buffer );
+        free( l.names );
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
+
+static BOOL image_has_function( const CRYPT_IMAGE_REG *image, const WCHAR *alg )
+{
+    ULONG i, j;
+
+    if (!image) return FALSE;
+    for (i = 0; i < image->cInterfaces; i++)
+        for (j = 0; j < image->rgpInterfaces[i]->cFunctions; j++)
+            if (name_eq( image->rgpInterfaces[i]->rgpszFunctions[j], alg )) return TRUE;
+    return FALSE;
+}
+
+NTSTATUS WINAPI BCryptEnumProviders( const WCHAR *alg, ULONG *count, BCRYPT_PROVIDER_NAME **list, ULONG flags )
+{
+    struct strlist l = { 0, NULL };
+    struct provider *p;
+    NTSTATUS status;
+    void *mem;
+
+    TRACE( "%s, %p, %p, %#lx\n", debugstr_w(alg), count, list, flags );
+
+    if (!valid_name( alg ) || !count || !list) return STATUS_INVALID_PARAMETER;
+
+    AcquireSRWLockExclusive( &config_lock );
+    seed_config();
+    LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry ) l.count++;
+    if (!(l.names = malloc( (l.count + 1) * sizeof(*l.names) ))) status = STATUS_NO_MEMORY;
+    else
+    {
+        l.count = 0;
+        LIST_FOR_EACH_ENTRY( p, &providers, struct provider, entry )
+            if (image_has_function( p->reg->pUM, alg ) || image_has_function( p->reg->pKM, alg ))
+                l.names[l.count++] = p->name;
+        if (!l.count) status = STATUS_NOT_FOUND;
+        else if (!(status = alloc_blob( fill_provider_names, &l, &mem, NULL )))
+        {
+            *list = mem;
+            *count = l.count;
+        }
+        free( l.names );
+    }
+    ReleaseSRWLockExclusive( &config_lock );
+    return status;
+}
