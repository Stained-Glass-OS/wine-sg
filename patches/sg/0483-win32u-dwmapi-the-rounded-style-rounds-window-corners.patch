+/* Stained Glass OS: the Rounded style (Settings > Personalization > Colors,
+ * HKCU\Software\Stained Glass\Style "Rounded") rounds the corners of
+ * top-level windows with a title bar, as newer Windows does: the rounding is
+ * the window surface's shape, not a window region, so programs see nothing
+ * of it. A window keeps square corners while maximized or minimized, when it
+ * has a region of its own, when it is layered (it draws its own edges), and
+ * when it asks for them (DWMWA_WINDOW_CORNER_PREFERENCE, recorded by dwmapi
+ * as __wine_corner: the preference + 1). */
+static BOOL rounded_style(void)
+{
+    static DWORD last;
+    static BOOL value;
+    DWORD now = NtGetTickCount();
+
+    if (!last || now - last > 500)  /* asked at every move: read at most twice a second */
+    {
+        static const WCHAR roundedW[] = {'R','o','u','n','d','e','d',0};
+        char buffer[sizeof(KEY_VALUE_PARTIAL_INFORMATION) + sizeof(DWORD)];
+        KEY_VALUE_PARTIAL_INFORMATION *info = (void *)buffer;
+        HKEY key;
+
+        value = FALSE;
+        if ((key = reg_open_hkcu_key( "Software\\Stained Glass\\Style" )))
+        {
+            if (query_reg_value( key, roundedW, info, sizeof(buffer) ) && info->Type == REG_DWORD)
+                value = *(DWORD *)info->Data != 0;
+            NtClose( key );
+        }
+        last = now ? now : 1;
+    }
+    return value;
+}
+
+static HRGN rounded_corners_shape( WND *win )
+{
+    static const WCHAR cornerW[] = {'_','_','w','i','n','e','_','c','o','r','n','e','r',0};
+    ULONG_PTR pref;
+    int radius, w, h, x, y;
+
+    if (win->parent != get_desktop_window()) return 0;
+    if ((win->dwStyle & WS_CAPTION) != WS_CAPTION || (win->dwStyle & (WS_MAXIMIZE | WS_MINIMIZE))) return 0;
+    if (win->dwExStyle & WS_EX_LAYERED) return 0;
+    if (!rounded_style()) return 0;
+    pref = (ULONG_PTR)NtUserGetProp( win->obj.handle, cornerW );
+    if (pref == 2 /* DWMWCP_DONOTROUND */) return 0;
+    radius = muldiv( pref == 4 /* DWMWCP_ROUNDSMALL */ ? 4 : 8, get_dpi_for_window( win->obj.handle ), USER_DEFAULT_SCREEN_DPI );
+    w = win->rects.window.right - win->rects.window.left;
+    h = win->rects.window.bottom - win->rects.window.top;
+    if (w < 4 * radius || h < 4 * radius) return 0;
+    x = win->rects.window.left - win->rects.visible.left;
+    y = win->rects.window.top - win->rects.visible.top;
+    return NtGdiCreateRoundRectRgn( x, y, x + w + 1, y + h + 1, 2 * radius, 2 * radius );
+}
+
