From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: implement the package name functions

PackageFamilyNameFromFullName was unimplemented, so winget -- which derives
its community source's family name from the source package's full name --
crashed into the debugger the moment the source had downloaded.

Implement PackageFamilyNameFromFullName, PackageFamilyNameFromId,
PackageFullNameFromId, PackageNameAndPublisherIdFromFamilyName and
VerifyPackageFullName/FamilyName/Id beside the existing PackageIdFromFullName,
and export the first four from kernel32 as Windows does. A PACKAGE_ID without
a publisher ID gets one computed from the publisher: the first 64 bits of the
SHA-256 of the publisher (UTF-16LE), a zero bit appended, as 13 base-32
digits -- for Microsoft's publisher string that is the well-known
8wekyb3d8bbwe, which test/appx-gate.sh checks as a known answer.

--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -38,6 +38,7 @@
 #include "winternl.h"
 #include "winerror.h"
 #include "appmodel.h"
+#include "bcrypt.h"
 
 #include "kernelbase.h"
 #include "wine/debug.h"
@@ -1752,3 +1753,209 @@
 
     return ERROR_SUCCESS;
 }
+
+/* The five '_'-separated fields of a package full name:
+ * Name_Version_Architecture_ResourceId_PublisherId. */
+struct full_name_parts
+{
+    const WCHAR *name, *version, *arch, *resource_id, *publisher_id;
+    UINT32 name_len, version_len, arch_len, resource_id_len;
+};
+
+static BOOL is_publisher_id(const WCHAR *s, UINT32 len)
+{
+    static const WCHAR digits[] = L"0123456789abcdefghjkmnpqrstvwxyz";
+    UINT32 i;
+    if (len != 13) return FALSE;
+    for (i = 0; i < len; i++)
+        if (!wcschr(digits, towlower(s[i])) || !s[i]) return FALSE;
+    return TRUE;
+}
+
+static BOOL split_full_name(const WCHAR *full_name, struct full_name_parts *p)
+{
+    const WCHAR *f[5], *s = full_name;
+    unsigned int i;
+
+    if (!full_name) return FALSE;
+    f[0] = s;
+    for (i = 1; i < 5; i++)
+    {
+        if (!(s = wcschr(s, '_'))) return FALSE;
+        f[i] = ++s;
+    }
+    if (wcschr(f[4], '_')) return FALSE;
+    p->name = f[0]; p->name_len = f[1] - f[0] - 1;
+    p->version = f[1]; p->version_len = f[2] - f[1] - 1;
+    p->arch = f[2]; p->arch_len = f[3] - f[2] - 1;
+    p->resource_id = f[3]; p->resource_id_len = f[4] - f[3] - 1;
+    p->publisher_id = f[4];
+    if (!p->name_len || p->name_len > 50 || !p->version_len || !p->arch_len) return FALSE;
+    if (processor_arch_from_string(p->arch, p->arch_len) == ~0u) return FALSE;
+    return is_publisher_id(p->publisher_id, lstrlenW(p->publisher_id));
+}
+
+/* The first 64 bits of the SHA-256 of the publisher (UTF-16LE), with a zero
+ * bit appended, as 13 base-32 digits (Crockford's alphabet). */
+static BOOL publisher_id_from_publisher(const WCHAR *publisher, WCHAR out[14])
+{
+    static const WCHAR digits[] = L"0123456789abcdefghjkmnpqrstvwxyz";
+    static NTSTATUS (WINAPI *pBCryptHash)(BCRYPT_ALG_HANDLE, UCHAR *, ULONG, UCHAR *, ULONG, UCHAR *, ULONG);
+    UCHAR hash[32];
+    UINT64 bits = 0;
+    int i;
+
+    if (!pBCryptHash)
+    {
+        HMODULE bcrypt = LoadLibraryW(L"bcrypt.dll");
+        if (!bcrypt || !(pBCryptHash = (void *)GetProcAddress(bcrypt, "BCryptHash"))) return FALSE;
+    }
+    if (pBCryptHash(BCRYPT_SHA256_ALG_HANDLE, NULL, 0, (UCHAR *)publisher, lstrlenW(publisher) * sizeof(WCHAR),
+                    hash, sizeof(hash)))
+        return FALSE;
+    for (i = 0; i < 8; i++) bits = (bits << 8) | hash[i];
+    for (i = 0; i < 13; i++)
+    {
+        int shift = 59 - 5 * i;
+        out[i] = digits[(shift >= 0 ? bits >> shift : bits << -shift) & 31];
+    }
+    out[13] = 0;
+    return TRUE;
+}
+
+static LONG copy_out(const WCHAR *str, UINT32 *length, WCHAR *out)
+{
+    UINT32 needed = lstrlenW(str) + 1, have = *length;
+
+    *length = needed;
+    if (!out || have < needed) return ERROR_INSUFFICIENT_BUFFER;
+    memcpy(out, str, needed * sizeof(WCHAR));
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         PackageFamilyNameFromFullName   (kernelbase.@)
+ */
+LONG WINAPI PackageFamilyNameFromFullName(const WCHAR *full_name, UINT32 *length, WCHAR *family_name)
+{
+    struct full_name_parts p;
+    WCHAR buf[128];
+
+    TRACE("full_name %s, length %p, family_name %p.\n", debugstr_w(full_name), length, family_name);
+
+    if (!length || !split_full_name(full_name, &p)) return ERROR_INVALID_PARAMETER;
+    swprintf(buf, ARRAY_SIZE(buf), L"%.*s_%s", p.name_len, p.name, p.publisher_id);
+    return copy_out(buf, length, family_name);
+}
+
+static LONG publisher_id_of(const PACKAGE_ID *id, WCHAR out[14])
+{
+    if (id->publisherId && id->publisherId[0])
+    {
+        if (!is_publisher_id(id->publisherId, lstrlenW(id->publisherId))) return ERROR_INVALID_PARAMETER;
+        lstrcpyW(out, id->publisherId);
+        return ERROR_SUCCESS;
+    }
+    if (!id->publisher || !id->publisher[0] || !publisher_id_from_publisher(id->publisher, out))
+        return ERROR_INVALID_PARAMETER;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         PackageFamilyNameFromId   (kernelbase.@)
+ */
+LONG WINAPI PackageFamilyNameFromId(const PACKAGE_ID *id, UINT32 *length, WCHAR *family_name)
+{
+    WCHAR pub[14], buf[128];
+    LONG ret;
+
+    TRACE("id %p, length %p, family_name %p.\n", id, length, family_name);
+
+    if (!id || !length || !id->name || !id->name[0] || lstrlenW(id->name) > 50) return ERROR_INVALID_PARAMETER;
+    if ((ret = publisher_id_of(id, pub))) return ret;
+    swprintf(buf, ARRAY_SIZE(buf), L"%s_%s", id->name, pub);
+    return copy_out(buf, length, family_name);
+}
+
+/***********************************************************************
+ *         PackageFullNameFromId   (kernelbase.@)
+ */
+LONG WINAPI PackageFullNameFromId(const PACKAGE_ID *id, UINT32 *length, WCHAR *full_name)
+{
+    const WCHAR *arch = NULL;
+    WCHAR pub[14], buf[256];
+    unsigned int i;
+    LONG ret;
+
+    TRACE("id %p, length %p, full_name %p.\n", id, length, full_name);
+
+    if (!id || !length || !id->name || !id->name[0] || lstrlenW(id->name) > 50) return ERROR_INVALID_PARAMETER;
+    if (id->resourceId && lstrlenW(id->resourceId) > 30) return ERROR_INVALID_PARAMETER;
+    for (i = 0; i < ARRAY_SIZE(arch_names); i++)
+        if (arch_names[i].code == id->processorArchitecture && id->processorArchitecture != PROCESSOR_ARCHITECTURE_UNKNOWN)
+            arch = arch_names[i].name;
+    if (!arch) return ERROR_INVALID_PARAMETER;
+    if ((ret = publisher_id_of(id, pub))) return ret;
+    swprintf(buf, ARRAY_SIZE(buf), L"%s_%u.%u.%u.%u_%s_%s_%s", id->name, id->version.Major, id->version.Minor,
+             id->version.Build, id->version.Revision, arch, id->resourceId ? id->resourceId : L"", pub);
+    return copy_out(buf, length, full_name);
+}
+
+/***********************************************************************
+ *         PackageNameAndPublisherIdFromFamilyName   (kernelbase.@)
+ */
+LONG WINAPI PackageNameAndPublisherIdFromFamilyName(const WCHAR *family_name, UINT32 *name_length, WCHAR *name,
+                                                    UINT32 *publisher_id_length, WCHAR *publisher_id)
+{
+    const WCHAR *sep;
+    WCHAR buf[64];
+    UINT32 len;
+    LONG ret, ret2;
+
+    TRACE("family_name %s, name_length %p, name %p, publisher_id_length %p, publisher_id %p.\n",
+          debugstr_w(family_name), name_length, name, publisher_id_length, publisher_id);
+
+    if (!family_name || !name_length || !publisher_id_length) return ERROR_INVALID_PARAMETER;
+    if (!(sep = wcschr(family_name, '_')) || wcschr(sep + 1, '_')) return ERROR_INVALID_PARAMETER;
+    len = sep - family_name;
+    if (!len || len > 50 || !is_publisher_id(sep + 1, lstrlenW(sep + 1))) return ERROR_INVALID_PARAMETER;
+    memcpy(buf, family_name, len * sizeof(WCHAR));
+    buf[len] = 0;
+    ret = copy_out(buf, name_length, name);
+    ret2 = copy_out(sep + 1, publisher_id_length, publisher_id);
+    return ret ? ret : ret2;
+}
+
+/***********************************************************************
+ *         VerifyPackageFullName   (kernelbase.@)
+ */
+LONG WINAPI VerifyPackageFullName(const WCHAR *full_name)
+{
+    struct full_name_parts p;
+    TRACE("full_name %s.\n", debugstr_w(full_name));
+    return split_full_name(full_name, &p) ? ERROR_SUCCESS : ERROR_INVALID_PARAMETER;
+}
+
+/***********************************************************************
+ *         VerifyPackageFamilyName   (kernelbase.@)
+ */
+LONG WINAPI VerifyPackageFamilyName(const WCHAR *family_name)
+{
+    const WCHAR *sep;
+    TRACE("family_name %s.\n", debugstr_w(family_name));
+    if (!family_name || !(sep = wcschr(family_name, '_')) || sep == family_name || sep - family_name > 50 ||
+        wcschr(sep + 1, '_') || !is_publisher_id(sep + 1, lstrlenW(sep + 1)))
+        return ERROR_INVALID_PARAMETER;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         VerifyPackageId   (kernelbase.@)
+ */
+LONG WINAPI VerifyPackageId(const PACKAGE_ID *id)
+{
+    WCHAR buf[256];
+    UINT32 len = ARRAY_SIZE(buf);
+    TRACE("id %p.\n", id);
+    return PackageFullNameFromId(id, &len, buf);
+}
