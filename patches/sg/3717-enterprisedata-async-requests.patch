index 6574070..fde039e 100644
--- a/dlls/windows.security.enterprisedata/Makefile.in
+++ b/dlls/windows.security.enterprisedata/Makefile.in
@@ -2,5 +2,6 @@ MODULE  = windows.security.enterprisedata.dll
 IMPORTS = combase uuid
 
 SOURCES = \
+	async.c \
 	edp.idl \
 	main.c
diff --git a/dlls/windows.security.enterprisedata/async.c b/dlls/windows.security.enterprisedata/async.c
new file mode 100644
index 0000000..27f8026
--- /dev/null
+++ b/dlls/windows.security.enterprisedata/async.c
@@ -0,0 +1,255 @@
+/* Windows.Security.EnterpriseData: the asynchronous operations of ProtectionPolicyManager
+ *
+ * Stained Glass OS: where no enterprise identity is managed every request is answered at
+ * once, so each operation is born completed (the result is decided by the caller). The
+ * behaviour of IAsyncInfo and IAsyncOperation follows Wine's own conformance tests of the
+ * other WinRT asynchronous operations (which were run on Windows): Completed at once, the
+ * handler runs when it is set, a second handler is refused, Close ends the operation.
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "objbase.h"
+#include "activation.h"
+
+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#define WIDL_using_Windows_Security_EnterpriseData
+#include "edp.h"
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(edp);
+
+#define CLOSED 4
+
+#ifdef SG_MUTANT_EDP_NOCLOSE
+#define SG_EDP_CLOSE( impl ) (void)(impl);
+#else
+#define SG_EDP_CLOSE( impl ) (impl)->status = CLOSED;
+#endif
+
+#ifdef SG_MUTANT_EDP_NOINVOKE
+#define SG_EDP_INVOKE( fn, handler, iface, status ) (void)(status);
+#else
+#define SG_EDP_INVOKE( fn, handler, iface, status ) fn( handler, iface, status );
+#endif
+
+static LONG next_async_id;
+
+/* IInspectable::GetIids: the runtime interfaces of an object, not IUnknown, IInspectable or IAgileObject */
+HRESULT get_iids( ULONG *count, IID **iids, const IID *const *list, ULONG n )
+{
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+#ifdef SG_MUTANT_EDP_GETIIDS
+    return E_NOTIMPL;
+#endif
+    *count = 0;
+    *iids = NULL;
+    if (!n) return S_OK;
+    if (!(*iids = CoTaskMemAlloc( n * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) (*iids)[i] = *list[i];
+    *count = n;
+    return S_OK;
+}
+
+#define DEFINE_ASYNC_OPERATION( sfx, class_name, result_type, clear_expr, copy_expr )                           \
+struct async_##sfx                                                                                              \
+{                                                                                                               \
+    IAsyncOperation_##sfx IAsyncOperation_iface;                                                                \
+    IAsyncInfo IAsyncInfo_iface;                                                                                \
+    LONG ref;                                                                                                   \
+    UINT32 id;                                                                                                  \
+    AsyncStatus status;                                                                                         \
+    IAsyncOperationCompletedHandler_##sfx *handler;                                                             \
+    BOOL handler_set;                                                                                           \
+    result_type result;                                                                                         \
+};                                                                                                              \
+static inline struct async_##sfx *sfx##_from_op( IAsyncOperation_##sfx *iface )                                 \
+{ return CONTAINING_RECORD( iface, struct async_##sfx, IAsyncOperation_iface ); }                               \
+static inline struct async_##sfx *sfx##_from_info( IAsyncInfo *iface )                                          \
+{ return CONTAINING_RECORD( iface, struct async_##sfx, IAsyncInfo_iface ); }                                    \
+static HRESULT WINAPI sfx##_QueryInterface( IAsyncOperation_##sfx *iface, REFIID iid, void **out )              \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_op( iface );                                                          \
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||                           \
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_##sfx ))                \
+        *out = &impl->IAsyncOperation_iface;                                                                    \
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))                                                               \
+        *out = &impl->IAsyncInfo_iface;                                                                         \
+    else                                                                                                        \
+    {                                                                                                           \
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );                         \
+        *out = NULL;                                                                                            \
+        return E_NOINTERFACE;                                                                                   \
+    }                                                                                                           \
+    IUnknown_AddRef( (IUnknown *)*out );                                                                        \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static ULONG WINAPI sfx##_AddRef( IAsyncOperation_##sfx *iface )                                                \
+{ return InterlockedIncrement( &sfx##_from_op( iface )->ref ); }                                                \
+static ULONG WINAPI sfx##_Release( IAsyncOperation_##sfx *iface )                                               \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_op( iface );                                                          \
+    ULONG ref = InterlockedDecrement( &impl->ref );                                                             \
+    if (!ref)                                                                                                   \
+    {                                                                                                           \
+        if (impl->handler) IAsyncOperationCompletedHandler_##sfx##_Release( impl->handler );                    \
+        clear_expr;                                                                                             \
+        free( impl );                                                                                           \
+    }                                                                                                           \
+    return ref;                                                                                                 \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_GetIids( IAsyncOperation_##sfx *iface, ULONG *count, IID **iids )                   \
+{                                                                                                               \
+    static const IID *const list[] = { &IID_IAsyncOperation_##sfx, &IID_IAsyncInfo };                           \
+    return get_iids( count, iids, list, ARRAY_SIZE(list) );                                                     \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_GetRuntimeClassName( IAsyncOperation_##sfx *iface, HSTRING *name )                  \
+{                                                                                                               \
+    static const WCHAR nameW[] = L"Windows.Foundation.IAsyncOperation`1<" class_name L">";                      \
+    if (!name) return E_POINTER;                                                                                \
+    return WindowsCreateString( nameW, ARRAY_SIZE(nameW) - 1, name );                                           \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_GetTrustLevel( IAsyncOperation_##sfx *iface, TrustLevel *level )                    \
+{                                                                                                               \
+    if (!level) return E_POINTER;                                                                               \
+    *level = BaseTrust;                                                                                         \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_put_Completed( IAsyncOperation_##sfx *iface,                                        \
+                                           IAsyncOperationCompletedHandler_##sfx *handler )                     \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_op( iface );                                                          \
+    AsyncStatus status;                                                                                         \
+    TRACE( "iface %p, handler %p.\n", iface, handler );                                                         \
+    if (impl->status == CLOSED) return E_ILLEGAL_METHOD_CALL;                                                   \
+    if (impl->handler_set) return E_ILLEGAL_DELEGATE_ASSIGNMENT;                                                \
+    impl->handler_set = TRUE;                                                                                   \
+    if (!(impl->handler = handler)) return S_OK;                                                                \
+    IAsyncOperationCompletedHandler_##sfx##_AddRef( handler );                                                  \
+    /* the operation is already done: the handler runs now */                                                   \
+    status = impl->status;                                                                                      \
+    SG_EDP_INVOKE( IAsyncOperationCompletedHandler_##sfx##_Invoke, handler, iface, status )                    \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_get_Completed( IAsyncOperation_##sfx *iface,                                        \
+                                           IAsyncOperationCompletedHandler_##sfx **handler )                    \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_op( iface );                                                          \
+    if (!handler) return E_POINTER;                                                                             \
+    if (impl->status == CLOSED) return E_ILLEGAL_METHOD_CALL;                                                   \
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_##sfx##_AddRef( *handler );                 \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_GetResults( IAsyncOperation_##sfx *iface, result_type *out )                        \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_op( iface );                                                          \
+    if (!out) return E_POINTER;                                                                                 \
+    if (impl->status != Completed) return E_ILLEGAL_METHOD_CALL;                                                \
+    copy_expr;                                                                                                  \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static const IAsyncOperation_##sfx##Vtbl sfx##_vtbl =                                                           \
+{                                                                                                               \
+    sfx##_QueryInterface, sfx##_AddRef, sfx##_Release,                                                          \
+    sfx##_GetIids, sfx##_GetRuntimeClassName, sfx##_GetTrustLevel,                                              \
+    sfx##_put_Completed, sfx##_get_Completed, sfx##_GetResults,                                                 \
+};                                                                                                              \
+static HRESULT WINAPI sfx##_info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )                    \
+{ return sfx##_QueryInterface( &sfx##_from_info( iface )->IAsyncOperation_iface, iid, out ); }                  \
+static ULONG WINAPI sfx##_info_AddRef( IAsyncInfo *iface )                                                      \
+{ return sfx##_AddRef( &sfx##_from_info( iface )->IAsyncOperation_iface ); }                                    \
+static ULONG WINAPI sfx##_info_Release( IAsyncInfo *iface )                                                     \
+{ return sfx##_Release( &sfx##_from_info( iface )->IAsyncOperation_iface ); }                                   \
+static HRESULT WINAPI sfx##_info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )                         \
+{ return sfx##_GetIids( &sfx##_from_info( iface )->IAsyncOperation_iface, count, iids ); }                      \
+static HRESULT WINAPI sfx##_info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )                        \
+{ return sfx##_GetRuntimeClassName( &sfx##_from_info( iface )->IAsyncOperation_iface, name ); }                 \
+static HRESULT WINAPI sfx##_info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )                          \
+{ return sfx##_GetTrustLevel( &sfx##_from_info( iface )->IAsyncOperation_iface, level ); }                      \
+static HRESULT WINAPI sfx##_info_get_Id( IAsyncInfo *iface, UINT32 *id )                                        \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_info( iface );                                                        \
+    if (!id) return E_POINTER;                                                                                  \
+    if (impl->status == CLOSED) return E_ILLEGAL_METHOD_CALL;                                                   \
+    *id = impl->id;                                                                                             \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )                           \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_info( iface );                                                        \
+    if (!status) return E_POINTER;                                                                              \
+    if (impl->status == CLOSED) return E_ILLEGAL_METHOD_CALL;                                                   \
+    *status = impl->status;                                                                                     \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code )                              \
+{                                                                                                               \
+    struct async_##sfx *impl = sfx##_from_info( iface );                                                        \
+    if (!code) return E_POINTER;                                                                                \
+    if (impl->status == CLOSED) return E_ILLEGAL_METHOD_CALL;                                                   \
+    *code = S_OK;                                                                                               \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static HRESULT WINAPI sfx##_info_Cancel( IAsyncInfo *iface )                                                    \
+{ return S_OK; /* nothing left to cancel: the operation stays Completed */ }                                    \
+static HRESULT WINAPI sfx##_info_Close( IAsyncInfo *iface )                                                     \
+{                                                                                                               \
+    SG_EDP_CLOSE( sfx##_from_info( iface ) )                                                                    \
+    return S_OK;                                                                                                \
+}                                                                                                               \
+static const IAsyncInfoVtbl sfx##_info_vtbl =                                                                   \
+{                                                                                                               \
+    sfx##_info_QueryInterface, sfx##_info_AddRef, sfx##_info_Release,                                           \
+    sfx##_info_GetIids, sfx##_info_GetRuntimeClassName, sfx##_info_GetTrustLevel,                               \
+    sfx##_info_get_Id, sfx##_info_get_Status, sfx##_info_get_ErrorCode, sfx##_info_Cancel, sfx##_info_Close,    \
+};                                                                                                              \
+static HRESULT async_##sfx##_create( result_type value, IAsyncOperation_##sfx **out )                           \
+{                                                                                                               \
+    struct async_##sfx *impl;                                                                                   \
+    *out = NULL;                                                                                                \
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;                                             \
+    impl->IAsyncOperation_iface.lpVtbl = &sfx##_vtbl;                                                           \
+    impl->IAsyncInfo_iface.lpVtbl = &sfx##_info_vtbl;                                                           \
+    impl->ref = 1;                                                                                              \
+    impl->id = InterlockedIncrement( &next_async_id );                                                          \
+    impl->status = Completed;                                                                                   \
+    impl->result = value;                                                                                       \
+    *out = &impl->IAsyncOperation_iface;                                                                        \
+    return S_OK;                                                                                                \
+}
+
+DEFINE_ASYNC_OPERATION( ProtectionPolicyEvaluationResult, L"Windows.Security.EnterpriseData.ProtectionPolicyEvaluationResult",
+                        ProtectionPolicyEvaluationResult, (void)0, *out = impl->result )
+DEFINE_ASYNC_OPERATION( boolean, L"Boolean", boolean, (void)0, *out = impl->result )
+DEFINE_ASYNC_OPERATION( HSTRING, L"String", HSTRING, WindowsDeleteString( impl->result ),
+                        return WindowsDuplicateString( impl->result, out ) )
+
+/* the results every operation here has: no identity is managed */
+HRESULT async_evaluation_create( ProtectionPolicyEvaluationResult value, IAsyncOperation_ProtectionPolicyEvaluationResult **out )
+{
+    return async_ProtectionPolicyEvaluationResult_create( value, out );
+}
+
+HRESULT async_boolean_create_( boolean value, IAsyncOperation_boolean **out )
+{
+    return async_boolean_create( value, out );
+}
+
+HRESULT async_hstring_create( HSTRING value, IAsyncOperation_HSTRING **out )
+{
+    HSTRING copy = NULL;
+    HRESULT hr;
+
+    if (value && FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    if (FAILED(hr = async_HSTRING_create( copy, out ))) WindowsDeleteString( copy );
+    return hr;
+}
