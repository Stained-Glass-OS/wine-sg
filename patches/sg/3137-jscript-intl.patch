+double intl_current_time(void)
+{
+    return date_now();
+}
+
+/* Local (or UTC) broken-down time of a time value, for Intl.DateTimeFormat.
+ * tzname_style: 0 none, 1 short, 2 long. */
+BOOL intl_time_to_systemtime(double time, BOOL utc_only, SYSTEMTIME *st, int tzname_style, WCHAR *tzname,
+        unsigned tzname_len)
+{
+    TIME_ZONE_INFORMATION tzi;
+    DateInstance d;
+    DOUBLE lt;
+
+    if(isnan(time) || fabs(time) > 8.64e15)
+        return FALSE;
+    time = floor(time);
+
+    GetTimeZoneInformation(&tzi);
+    memset(&d, 0, sizeof(d));
+    d.time = time;
+    d.bias = tzi.Bias;
+    d.standardDate = tzi.StandardDate;
+    d.standardBias = tzi.StandardBias;
+    d.daylightDate = tzi.DaylightDate;
+    d.daylightBias = tzi.DaylightBias;
+
+    lt = utc_only ? time : local_time(time, &d);
+    *st = create_systemtime(lt);
+    if(st->wYear < 1601 || st->wYear > 9999)
+        return FALSE;
+
+    if(tzname_style) {
+        const WCHAR *name;
+        if(utc_only) {
+            lstrcpynW(tzname, L"UTC", tzname_len);
+        }else {
+            name = daylight_saving_ta(time, &d) != d.standardBias ? tzi.DaylightName : tzi.StandardName;
+            if(tzname_style == 1 && wcschr(name, ' ')) {
+                unsigned n = 0;
+                BOOL start = TRUE;
+                for(; *name && n + 1 < tzname_len; name++) {
+                    if(*name == ' ') start = TRUE;
+                    else if(start) {
+                        tzname[n++] = *name;
+                        start = FALSE;
+                    }
+                }
+                tzname[n] = 0;
+            }else
+                lstrcpynW(tzname, name, tzname_len);
+        }
+        tzname[tzname_len - 1] = 0;
+    }
+    return TRUE;
+}
+
