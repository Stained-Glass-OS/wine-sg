+/* ---- NumberFormat ---- */
+
+static const WCHAR *const style_values[] = { L"decimal", L"percent", L"currency", NULL };
+static const WCHAR *const currdisp_values[] = { L"code", L"symbol", L"name", NULL };
+
+static int currency_digits(const WCHAR *code)
+{
+    static const char zero[][4] = { "BIF","CLP","DJF","GNF","ISK","JPY","KMF","KRW","PYG","RWF","UGX","UYI",
+                                    "VND","VUV","XAF","XOF","XPF" };
+    static const char three[][4] = { "BHD","IQD","JOD","KWD","LYD","OMR","TND" };
+    char c[4];
+    unsigned i;
+
+    for(i = 0; i < 3; i++) c[i] = code[i];
+    c[3] = 0;
+    for(i = 0; i < ARRAY_SIZE(zero); i++) if(!strcmp(c, zero[i])) return 0;
+    for(i = 0; i < ARRAY_SIZE(three); i++) if(!strcmp(c, three[i])) return 3;
+    if(!strcmp(c, "CLF") || !strcmp(c, "UYW")) return 4;
+    return 2;
+}
+
+static HRESULT init_numberformat(script_ctx_t *ctx, IntlInstance *inst, jsval_t locales, jsval_t options)
+{
+    options_t opts;
+    jsval_t v;
+    int i, mnfd_def, mxfd_def, mnfd, mxfd, mnsd, mxsd, has_sig;
+    HRESULT hres;
+
+    hres = options_init(ctx, options, &opts);
+    if(FAILED(hres))
+        return hres;
+
+    hres = resolve_locale(ctx, locales, &opts, inst->locale);
+    if(SUCCEEDED(hres)) hres = opt_enum(&opts, L"style", style_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.num.style = i < 0 ? 0 : i;
+
+    hres = opt_get(&opts, L"currency", &v);
+    if(FAILED(hres)) goto done;
+    if(!is_undefined(v)) {
+        jsstr_t *str;
+        const WCHAR *s;
+        hres = to_flat_string(ctx, v, &str, &s);
+        jsval_release(v);
+        if(FAILED(hres)) goto done;
+        if(jsstr_length(str) != 3 || !iswalpha(s[0]) || !iswalpha(s[1]) || !iswalpha(s[2]) ||
+           s[0] > 'z' || s[1] > 'z' || s[2] > 'z') {
+            jsstr_release(str);
+            hres = throw_error(ctx, JS_E_INTL_BAD_OPTION, L"currency");
+            goto done;
+        }
+        for(i = 0; i < 3; i++)
+            inst->u.num.currency[i] = towupper(s[i]);
+        inst->u.num.currency[3] = 0;
+        jsstr_release(str);
+    }
+    if(inst->u.num.style == 2 && !inst->u.num.currency[0]) {
+        hres = throw_error(ctx, JS_E_OBJECT_EXPECTED, NULL);
+        goto done;
+    }
+
+    hres = opt_enum(&opts, L"currencyDisplay", currdisp_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.num.currency_display = i < 0 ? 1 : i;
+
+    hres = opt_number(&opts, L"minimumIntegerDigits", 1, 21, 1, &inst->u.num.min_int);
+    if(FAILED(hres)) goto done;
+
+    mnfd_def = inst->u.num.style == 2 ? currency_digits(inst->u.num.currency) : 0;
+    mxfd_def = inst->u.num.style == 2 ? mnfd_def : (inst->u.num.style == 1 ? 0 : 3);
+    hres = opt_number(&opts, L"minimumFractionDigits", 0, 20, mnfd_def, &mnfd);
+    if(FAILED(hres)) goto done;
+    if(mxfd_def < mnfd) mxfd_def = mnfd;
+    hres = opt_number(&opts, L"maximumFractionDigits", mnfd, 20, mxfd_def, &mxfd);
+    if(FAILED(hres)) goto done;
+    inst->u.num.min_frac = mnfd;
+    inst->u.num.max_frac = mxfd;
+
+    has_sig = 0;
+    hres = opt_get(&opts, L"minimumSignificantDigits", &v);
+    if(FAILED(hres)) goto done;
+    has_sig |= !is_undefined(v);
+    jsval_release(v);
+    hres = opt_get(&opts, L"maximumSignificantDigits", &v);
+    if(FAILED(hres)) goto done;
+    has_sig |= !is_undefined(v);
+    jsval_release(v);
+    if(has_sig) {
+        hres = opt_number(&opts, L"minimumSignificantDigits", 1, 21, 1, &mnsd);
+        if(SUCCEEDED(hres)) hres = opt_number(&opts, L"maximumSignificantDigits", mnsd, 21, 21, &mxsd);
+        if(FAILED(hres)) goto done;
+        inst->u.num.min_sig = mnsd;
+        inst->u.num.max_sig = mxsd;
+    }
+
+    hres = opt_bool(&opts, L"useGrouping", &i);
+    if(FAILED(hres)) goto done;
+    inst->u.num.grouping = i < 0 ? TRUE : i;
+
+done:
+    options_free(&opts);
+    return hres;
+}
+
+static void append_str(WCHAR *buf, size_t size, const WCHAR *s)
+{
+    size_t len = wcslen(buf);
+    if(len + wcslen(s) + 1 > size)
+        return;
+    wcscpy(buf + len, s);
+}
+
+static const WCHAR *currency_symbol(const WCHAR *code)
+{
+    static const struct { const WCHAR code[4]; const WCHAR *sym; } syms[] = {
+        { L"USD", L"$" }, { L"EUR", L"\x20ac" }, { L"GBP", L"\xa3" }, { L"JPY", L"\xa5" },
+        { L"INR", L"\x20b9" }, { L"KRW", L"\x20a9" }, { L"ILS", L"\x20aa" }, { L"VND", L"\x20ab" },
+        { L"PHP", L"\x20b1" }, { L"THB", L"\xe3f" }, { L"UAH", L"\x20b4" }, { L"TRY", L"\x20ba" },
+        { L"CNY", L"CN\xa5" }, { L"CAD", L"CA$" }, { L"AUD", L"AU$" }, { L"NZD", L"NZ$" },
+        { L"MXN", L"MX$" }, { L"HKD", L"HK$" },
+    };
+    unsigned i;
+    for(i = 0; i < ARRAY_SIZE(syms); i++)
+        if(!wcscmp(code, syms[i].code))
+            return syms[i].sym;
+    return code;
+}
+
+/* Builds the decimal digit string for abs(x) according to the rounding options. */
+static HRESULT make_digits(IntlInstance *inst, double ax, WCHAR *out, size_t size, int *frac_digits, int *int_digits)
+{
+    WCHAR *dot, *p;
+    jsstr_t *str;
+    int i;
+
+    out[0] = 0;
+    if(inst->u.num.max_sig) {
+        int digits, exp, k, pos;
+        const WCHAR *s;
+        WCHAR mant[32], *e;
+
+        str = number_format_exponential(ax, inst->u.num.max_sig - 1);
+        if(!str)
+            return E_OUTOFMEMORY;
+        s = jsstr_flatten(str);
+        if(!s) {
+            jsstr_release(str);
+            return E_OUTOFMEMORY;
+        }
+        digits = 0;
+        for(k = 0; s[k] && s[k] != 'e'; k++)
+            if(s[k] >= '0' && s[k] <= '9' && digits < 31)
+                mant[digits++] = s[k];
+        mant[digits] = 0;
+        e = wcschr(s, 'e');
+        exp = e ? wcstol(e + 1, NULL, 10) : 0;
+        jsstr_release(str);
+
+        while(digits > inst->u.num.min_sig && mant[digits - 1] == '0')
+            mant[--digits] = 0;
+
+        pos = exp + 1;
+        if(pos <= 0) {
+            append_str(out, size, L"0.");
+            for(i = pos; i < 0; i++)
+                append_str(out, size, L"0");
+            append_str(out, size, mant);
+        }else if(digits <= pos) {
+            append_str(out, size, mant);
+            for(i = digits; i < pos; i++)
+                append_str(out, size, L"0");
+        }else {
+            WCHAR tmp[2] = {0, 0};
+            for(i = 0; i < digits; i++) {
+                if(i == pos)
+                    append_str(out, size, L".");
+                tmp[0] = mant[i];
+                append_str(out, size, tmp);
+            }
+        }
+    }else {
+        if(ax >= 1e21) {
+            swprintf(out, size, L"%.0f", ax);
+        }else {
+            str = number_format_fixed(ax, inst->u.num.max_frac);
+            if(!str)
+                return E_OUTOFMEMORY;
+            append_str(out, size, jsstr_flatten(str));
+            jsstr_release(str);
+        }
+        if((dot = wcschr(out, '.'))) {
+            p = out + wcslen(out);
+            while(p - dot - 1 > inst->u.num.min_frac && p[-1] == '0')
+                *--p = 0;
+            if(p == dot + 1)
+                *dot = 0;
+        }
+    }
+
+    dot = wcschr(out, '.');
+    *frac_digits = dot ? wcslen(dot + 1) : 0;
+    *int_digits = dot ? dot - out : wcslen(out);
+    return S_OK;
+}
+
+static int locale_int(const WCHAR *locale, DWORD type, int fallback)
+{
+    DWORD v;
+    if(!GetLocaleInfoEx(locale, type | LOCALE_RETURN_NUMBER, (WCHAR*)&v, sizeof(v) / sizeof(WCHAR)))
+        return fallback;
+    return v;
+}
+
+/* Integer part padded to min_int digits, grouped, with the locale's negative pattern. */
+static void manual_number(const WCHAR *digits, int intd, int frac, int min_int, BOOL neg, int g,
+        const WCHAR *decimal, const WCHAR *thousands, int negorder, WCHAR *out, size_t size)
+{
+    WCHAR ip[64], res[300] = L"";
+    int total = min_int > intd ? min_int : intd, i, pad = total - intd, pos = 0, grp;
+
+    for(i = 0; i < total && i < 60; i++)
+        ip[i] = i < pad ? '0' : digits[i - pad];
+    ip[i] = 0;
+    total = i;
+
+    /* walk digits left to right inserting separators */
+    grp = g == 32 ? 3 : g;
+    for(i = 0; i < total; i++) {
+        WCHAR one[2] = { ip[i], 0 };
+        int remaining = total - i;
+        if(i && g) {
+            BOOL sep = FALSE;
+            if(remaining == grp) sep = TRUE;
+            else if(remaining > grp && g == 32 && (remaining - grp) % 2 == 0) sep = TRUE;
+            else if(remaining > grp && g != 32 && remaining % grp == 0) sep = TRUE;
+            if(sep) append_str(res, ARRAY_SIZE(res), thousands);
+        }
+        append_str(res, ARRAY_SIZE(res), one);
+    }
+    (void)pos;
+    if(frac) {
+        append_str(res, ARRAY_SIZE(res), decimal);
+        append_str(res, ARRAY_SIZE(res), digits + intd + 1);
+    }
+
+    out[0] = 0;
+    if(neg) {
+        static const WCHAR *const pat[] = { L"(n)", L"-n", L"- n", L"n-", L"n -" };
+        const WCHAR *p = pat[negorder >= 0 && negorder < 5 ? negorder : 1];
+        for(; *p; p++) {
+            WCHAR one[2] = { *p, 0 };
+            if(*p == 'n') append_str(out, size, res);
+            else append_str(out, size, one);
+        }
+    }else
+        append_str(out, size, res);
+}
+
+static HRESULT format_number(script_ctx_t *ctx, IntlInstance *inst, double x, jsstr_t **ret)
+{
+    WCHAR digits[512], decimal[16], thousands[16], grouping[16], percent[16], negsign[16], symbol[64];
+    WCHAR out[768];
+    NUMBERFMTW nf;
+    CURRENCYFMTW cf;
+    BOOL neg;
+    int frac, intd, n, g;
+    HRESULT hres;
+
+    if(isnan(x)) {
+        *ret = jsstr_alloc(L"NaN");
+        return *ret ? S_OK : E_OUTOFMEMORY;
+    }
+    neg = x < 0;
+    if(isinf(x)) {
+        *ret = jsstr_alloc(neg ? L"-\x221e" : L"\x221e");
+        return *ret ? S_OK : E_OUTOFMEMORY;
+    }
+    if(inst->u.num.style == 1)
+        x *= 100;
+    hres = make_digits(inst, fabs(x), digits, ARRAY_SIZE(digits), &frac, &intd);
+    if(FAILED(hres))
+        return hres;
+
+    if(!GetLocaleInfoEx(inst->locale, LOCALE_SDECIMAL, decimal, ARRAY_SIZE(decimal)))
+        wcscpy(decimal, L".");
+    if(!GetLocaleInfoEx(inst->locale, LOCALE_STHOUSAND, thousands, ARRAY_SIZE(thousands)))
+        wcscpy(thousands, L",");
+    grouping[2] = 0;
+    if(!GetLocaleInfoEx(inst->locale, LOCALE_SGROUPING, grouping, ARRAY_SIZE(grouping)))
+        g = 3;
+    else
+        g = grouping[2] == '2' ? 32 : grouping[0] - '0';
+    if(!inst->u.num.grouping)
+        g = 0;
+
+    if(intd < inst->u.num.min_int && inst->u.num.style != 2) {
+        /* NLS drops leading zeros, so group the padded digits ourselves */
+        manual_number(digits, intd, frac, inst->u.num.min_int, inst->u.num.style == 0 && neg, g, decimal, thousands,
+                      locale_int(inst->locale, LOCALE_INEGNUMBER, 1), out, ARRAY_SIZE(out));
+        n = 1;
+    }else
+    if(inst->u.num.style == 2) {
+        WCHAR symbuf[16], intl[16];
+
+        cf.NumDigits = frac;
+        cf.LeadingZero = locale_int(inst->locale, LOCALE_ILZERO, 1);
+        cf.Grouping = g;
+        cf.lpDecimalSep = decimal;
+        cf.lpThousandSep = thousands;
+        cf.NegativeOrder = locale_int(inst->locale, LOCALE_INEGCURR, 0);
+        cf.PositiveOrder = locale_int(inst->locale, LOCALE_ICURRENCY, 0);
+        symbol[0] = 0;
+        if(inst->u.num.currency_display == 0) {
+            wcscpy(symbol, inst->u.num.currency);
+        }else {
+            intl[0] = 0;
+            GetLocaleInfoEx(inst->locale, LOCALE_SINTLSYMBOL, intl, ARRAY_SIZE(intl));
+            if(!wcsncmp(intl, inst->u.num.currency, 3)) {
+                if(inst->u.num.currency_display == 2) {
+                    if(!GetLocaleInfoEx(inst->locale, LOCALE_SNATIVECURRNAME, symbol, ARRAY_SIZE(symbol)))
+                        symbol[0] = 0;
+                }
+                if(!symbol[0] && !GetLocaleInfoEx(inst->locale, LOCALE_SCURRENCY, symbol, ARRAY_SIZE(symbol)))
+                    symbol[0] = 0;
+            }
+            if(!symbol[0]) {
+                wcscpy(symbuf, inst->u.num.currency_display == 2 ? inst->u.num.currency
+                                                                  : currency_symbol(inst->u.num.currency));
+                wcscpy(symbol, symbuf);
+            }
+        }
+        cf.lpCurrencySymbol = symbol;
+        if(neg) {
+            memmove(digits + 1, digits, (wcslen(digits) + 1) * sizeof(WCHAR));
+            digits[0] = '-';
+        }
+        n = GetCurrencyFormatEx(inst->locale, 0, digits, &cf, out, ARRAY_SIZE(out));
+    }else {
+        nf.NumDigits = frac;
+        nf.LeadingZero = locale_int(inst->locale, LOCALE_ILZERO, 1);
+        nf.Grouping = g;
+        nf.lpDecimalSep = decimal;
+        nf.lpThousandSep = thousands;
+        nf.NegativeOrder = locale_int(inst->locale, LOCALE_INEGNUMBER, 1);
+        if(inst->u.num.style == 0 && neg) {
+            memmove(digits + 1, digits, (wcslen(digits) + 1) * sizeof(WCHAR));
+            digits[0] = '-';
+        }
+        n = GetNumberFormatEx(inst->locale, 0, digits, &nf, out, ARRAY_SIZE(out));
+    }
+    if(!n)
+        return E_FAIL;
+
+    if(inst->u.num.style == 1) {
+        static const WCHAR *const pos_pat[] = { L"n %", L"n%", L"%n", L"% n" };
+        static const WCHAR *const neg_pat[] = { L"-n %", L"-n%", L"-%n", L"%-n", L"%n-", L"n-%", L"n%-", L"-% n",
+                                                L"n %-", L"% n-", L"% -n", L"n- %" };
+        const WCHAR *pat, *p;
+        WCHAR res[800] = L"";
+
+        if(!GetLocaleInfoEx(inst->locale, LOCALE_SPERCENT, percent, ARRAY_SIZE(percent)))
+            wcscpy(percent, L"%");
+        if(!GetLocaleInfoEx(inst->locale, LOCALE_SNEGATIVESIGN, negsign, ARRAY_SIZE(negsign)))
+            wcscpy(negsign, L"-");
+        if(neg) {
+            n = locale_int(inst->locale, LOCALE_INEGATIVEPERCENT, 1);
+            pat = neg_pat[n >= 0 && n < 12 ? n : 1];
+        }else {
+            n = locale_int(inst->locale, LOCALE_IPOSITIVEPERCENT, 1);
+            pat = pos_pat[n >= 0 && n < 4 ? n : 1];
+        }
+        for(p = pat; *p; p++) {
+            WCHAR one[2] = { *p, 0 };
+            if(*p == 'n') append_str(res, ARRAY_SIZE(res), out);
+            else if(*p == '%') append_str(res, ARRAY_SIZE(res), percent);
+            else if(*p == '-') append_str(res, ARRAY_SIZE(res), negsign);
+            else append_str(res, ARRAY_SIZE(res), one);
+        }
+        *ret = jsstr_alloc(res);
+    }else {
+        *ret = jsstr_alloc(out);
+    }
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT NumberFormat_format_fn(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    IntlInstance *inst;
+    jsstr_t *str;
+    double x;
+    HRESULT hres = S_OK;
+
+    if(!(inst = intl_this(ctx, vthis, JSCLASS_INTL_NUMBERFORMAT, L"NumberFormat", &hres)))
+        return hres;
+    hres = to_number(ctx, argc ? argv[0] : jsval_undefined(), &x);
+    if(FAILED(hres))
