+/* ---- Collator ---- */
+
+static const WCHAR *const usage_values[] = { L"sort", L"search", NULL };
+static const WCHAR *const sensitivity_values[] = { L"base", L"accent", L"case", L"variant", NULL };
+static const WCHAR *const casefirst_values[] = { L"false", L"upper", L"lower", NULL };
+
+static HRESULT Collator_compare_fn(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    jsstr_t *s1, *s2;
+    const WCHAR *p1, *p2;
+    IntlInstance *inst;
+    DWORD cmpflags;
+    HRESULT hres = S_OK;
+    int cmp;
+
+    if(!(inst = intl_this(ctx, vthis, JSCLASS_INTL_COLLATOR, L"Collator", &hres)))
+        return hres;
+
+    hres = to_flat_string(ctx, argc ? argv[0] : jsval_undefined(), &s1, &p1);
+    if(FAILED(hres))
+        return hres;
+    hres = to_flat_string(ctx, argc > 1 ? argv[1] : jsval_undefined(), &s2, &p2);
+    if(FAILED(hres)) {
+        jsstr_release(s1);
+        return hres;
+    }
+
+    switch(inst->u.coll.sensitivity) {
+    case 0: cmpflags = NORM_IGNORECASE | NORM_IGNORENONSPACE; break;
+    case 1: cmpflags = NORM_IGNORECASE; break;
+    case 2: cmpflags = NORM_IGNORENONSPACE; break;
+    default: cmpflags = 0; break;
+    }
+#ifdef SG_MUTANT_JS_NOSENS
+    cmpflags = 0;
+#endif
+    if(inst->u.coll.ignore_punct)
+        cmpflags |= NORM_IGNORESYMBOLS;
+    if(inst->u.coll.numeric)
+        cmpflags |= SORT_DIGITSASNUMBERS;
+
+    cmp = CompareStringEx(inst->locale, cmpflags, p1, jsstr_length(s1), p2, jsstr_length(s2), NULL, NULL, 0);
+    jsstr_release(s1);
+    jsstr_release(s2);
+    if(!cmp)
+        return E_FAIL;
+    if(r)
+        *r = jsval_number(cmp - CSTR_EQUAL);
+    return S_OK;
+}
+
+static HRESULT Collator_resolvedOptions(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc,
+        jsval_t *argv, jsval_t *r)
+{
+    IntlInstance *inst;
+    jsdisp_t *obj;
+    HRESULT hres = S_OK;
+
+    if(!(inst = intl_this(ctx, vthis, JSCLASS_INTL_COLLATOR, L"Collator", &hres)))
+        return hres;
+    if(!r)
+        return S_OK;
+    hres = create_object(ctx, NULL, &obj);
+    if(FAILED(hres))
+        return hres;
+    hres = str_prop(ctx, obj, L"locale", inst->locale);
+    if(SUCCEEDED(hres)) hres = str_prop(ctx, obj, L"usage", usage_values[inst->u.coll.usage]);
+    if(SUCCEEDED(hres)) hres = str_prop(ctx, obj, L"sensitivity", sensitivity_values[inst->u.coll.sensitivity]);
+    if(SUCCEEDED(hres)) hres = bool_prop(ctx, obj, L"ignorePunctuation", inst->u.coll.ignore_punct);
+    if(SUCCEEDED(hres)) hres = str_prop(ctx, obj, L"collation", L"default");
+    if(SUCCEEDED(hres)) hres = bool_prop(ctx, obj, L"numeric", inst->u.coll.numeric);
+    if(SUCCEEDED(hres)) hres = str_prop(ctx, obj, L"caseFirst", casefirst_values[inst->u.coll.case_first]);
+    if(FAILED(hres)) {
+        jsdisp_release(obj);
+        return hres;
+    }
+    *r = jsval_obj(obj);
+    return S_OK;
+}
