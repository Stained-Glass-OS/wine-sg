+
+/* required: 0 = date, 1 = time, 2 = any; defaults: 0 = date, 1 = time, 2 = all */
+static HRESULT init_datetimeformat(script_ctx_t *ctx, IntlInstance *inst, jsval_t locales, jsval_t options,
+        int required, int defaults)
+{
+    static const WCHAR *const matchers[] = { L"basic", L"best fit", NULL };
+    options_t opts;
+    BOOL need_defaults = TRUE;
+    jsval_t v;
+    int i, hour12;
+    HRESULT hres;
+
+    hres = options_init(ctx, options, &opts);
+    if(FAILED(hres))
+        return hres;
+
+    hres = resolve_locale(ctx, locales, &opts, inst->locale);
+    if(FAILED(hres)) goto done;
+
+    hres = opt_get(&opts, L"timeZone", &v);
+    if(FAILED(hres)) goto done;
+    if(!is_undefined(v)) {
+        jsstr_t *str;
+        const WCHAR *s;
+        hres = to_flat_string(ctx, v, &str, &s);
+        jsval_release(v);
+        if(FAILED(hres)) goto done;
+        if(_wcsicmp(s, L"UTC")) {
+            jsstr_release(str);
+            hres = throw_error(ctx, JS_E_INTL_BAD_OPTION, L"timeZone");
+            goto done;
+        }
+        jsstr_release(str);
+        inst->u.dt.utc = TRUE;
+    }
+
+    hres = opt_bool(&opts, L"hour12", &hour12);
+    if(SUCCEEDED(hres)) hres = opt_enum(&opts, L"weekday", nsl_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.weekday = i + 1;
+    hres = opt_enum(&opts, L"era", nsl_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.era = i + 1;
+    hres = opt_enum(&opts, L"year", year_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.year = i + 1;
+    hres = opt_enum(&opts, L"month", month_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.month = i + 1;
+    hres = opt_enum(&opts, L"day", num_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.day = i + 1;
+    hres = opt_enum(&opts, L"hour", num_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.hour = i + 1;
+    hres = opt_enum(&opts, L"minute", num_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.minute = i + 1;
+    hres = opt_enum(&opts, L"second", num_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.second = i + 1;
+    hres = opt_enum(&opts, L"timeZoneName", tzname_values, &i);
+    if(FAILED(hres)) goto done;
+    inst->u.dt.tzname = i + 1;
+    hres = opt_enum(&opts, L"formatMatcher", matchers, &i);
+    if(FAILED(hres)) goto done;
+
+    if(required != 1 && (inst->u.dt.weekday || inst->u.dt.year || inst->u.dt.month || inst->u.dt.day))
+        need_defaults = FALSE;
+    if(required != 0 && (inst->u.dt.hour || inst->u.dt.minute || inst->u.dt.second))
+        need_defaults = FALSE;
+    if(need_defaults) {
+        if(defaults != 1)
+            inst->u.dt.year = inst->u.dt.month = inst->u.dt.day = 2;
+        if(defaults != 0)
+            inst->u.dt.hour = inst->u.dt.minute = inst->u.dt.second = 2;
+    }
+
+    if(inst->u.dt.hour) {
+        WCHAR fmt[80];
+        BOOL loc12 = FALSE;
+        if(hour12 >= 0)
+            inst->u.dt.hour12 = hour12;
+        else {
+            if(GetLocaleInfoEx(inst->locale, LOCALE_STIMEFORMAT, fmt, ARRAY_SIZE(fmt)))
+                loc12 = wcschr(fmt, 'h') != NULL;
+            inst->u.dt.hour12 = loc12;
+        }
+    }
+done:
+    options_free(&opts);
+    return hres;
+}
+
+/* ---- Intl.* constructors ---- */
+
+static HRESULT create_instance(script_ctx_t *ctx, const builtin_info_t *info, jsdisp_t *proto, IntlInstance **ret)
+{
+    IntlInstance *inst;
+    HRESULT hres;
+
+    if(!(inst = calloc(1, sizeof(*inst))))
+        return E_OUTOFMEMORY;
+    hres = init_dispex(&inst->dispex, ctx, info, proto);
+    if(FAILED(hres)) {
+        free(inst);
+        return hres;
+    }
+    *ret = inst;
+    return S_OK;
+}
+
+static HRESULT Collator_constructor(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    IntlInstance *inst;
+    HRESULT hres;
+
+    TRACE("\n");
+    if(!r)
+        return S_OK;
+    hres = create_instance(ctx, &Collator_info, ctx->collator_prototype, &inst);
+    if(FAILED(hres))
+        return hres;
+    hres = init_collator(ctx, inst, argc ? argv[0] : jsval_undefined(), argc > 1 ? argv[1] : jsval_undefined());
+    if(SUCCEEDED(hres))
+        hres = define_bound(ctx, inst, L"compare", Collator_compare_fn, 2);
+    if(FAILED(hres)) {
+        jsdisp_release(&inst->dispex);
+        return hres;
+    }
+    *r = jsval_obj(&inst->dispex);
+    return S_OK;
+}
+
+static HRESULT NumberFormat_constructor(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    IntlInstance *inst;
+    HRESULT hres;
+
+    TRACE("\n");
+    if(!r)
+        return S_OK;
+    hres = create_instance(ctx, &NumberFormat_info, ctx->numberfmt_prototype, &inst);
+    if(FAILED(hres))
+        return hres;
+    hres = init_numberformat(ctx, inst, argc ? argv[0] : jsval_undefined(), argc > 1 ? argv[1] : jsval_undefined());
+    if(SUCCEEDED(hres))
+        hres = define_bound(ctx, inst, L"format", NumberFormat_format_fn, 1);
+    if(FAILED(hres)) {
+        jsdisp_release(&inst->dispex);
+        return hres;
+    }
+    *r = jsval_obj(&inst->dispex);
+    return S_OK;
+}
+
+static HRESULT DateTimeFormat_constructor(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc,
+        jsval_t *argv, jsval_t *r)
+{
+    IntlInstance *inst;
+    HRESULT hres;
+
+    TRACE("\n");
+    if(!r)
+        return S_OK;
+    hres = create_instance(ctx, &DateTimeFormat_info, ctx->datefmt_prototype, &inst);
+    if(FAILED(hres))
+        return hres;
+    hres = init_datetimeformat(ctx, inst, argc ? argv[0] : jsval_undefined(),
+                               argc > 1 ? argv[1] : jsval_undefined(), 2, 0);
+    if(SUCCEEDED(hres))
+        hres = define_bound(ctx, inst, L"format", DateTimeFormat_format_fn, 1);
+    if(FAILED(hres)) {
+        jsdisp_release(&inst->dispex);
+        return hres;
+    }
+    *r = jsval_obj(&inst->dispex);
+    return S_OK;
+}
+
+static HRESULT supportedLocalesOf_fn(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
+        jsval_t *r)
+{
+    return supported_locales_of(ctx, argc, argv, r);
+}
+
+static HRESULT define_constructor(script_ctx_t *ctx, jsdisp_t *intl, const WCHAR *name, builtin_invoke_t proc,
+        const builtin_info_t *proto_info, jsdisp_t **proto)
+{
+    jsdisp_t *constr, *fn;
+    HRESULT hres;
+
+    hres = create_dispex(ctx, proto_info, ctx->object_prototype, proto);
+    if(FAILED(hres))
+        return hres;
+    hres = create_builtin_constructor(ctx, proc, name, NULL, PROPF_CONSTR, *proto, &constr);
+    if(FAILED(hres))
+        return hres;
+    hres = create_builtin_function(ctx, supportedLocalesOf_fn, L"supportedLocalesOf", NULL, PROPF_METHOD | 1, NULL, &fn);
+    if(SUCCEEDED(hres)) {
+        hres = jsdisp_define_data_property(constr, L"supportedLocalesOf", PROPF_WRITABLE | PROPF_CONFIGURABLE,
+                                           jsval_obj(fn));
+        jsdisp_release(fn);
+    }
+    if(SUCCEEDED(hres))
+        hres = jsdisp_define_data_property(intl, name, PROPF_WRITABLE | PROPF_CONFIGURABLE, jsval_obj(constr));
+    jsdisp_release(constr);
+    return hres;
+}
+
+static const builtin_info_t Intl_info = {
+    .class     = JSCLASS_OBJECT,
+};
+
+HRESULT init_intl(script_ctx_t *ctx)
+{
+    jsdisp_t *intl;
+    HRESULT hres;
+
+#ifdef SG_MUTANT_JS_NOINTL
+    return S_OK;
+#endif
+    if(ctx->version < SCRIPTLANGUAGEVERSION_ES6)
+        return S_OK;
+
+    hres = create_dispex(ctx, &Intl_info, ctx->object_prototype, &intl);
+    if(FAILED(hres))
+        return hres;
+
+    hres = define_constructor(ctx, intl, L"Collator", Collator_constructor, &Collator_prototype_info,
+                              &ctx->collator_prototype);
+    if(SUCCEEDED(hres))
+        hres = define_constructor(ctx, intl, L"NumberFormat", NumberFormat_constructor, &NumberFormat_prototype_info,
+                                  &ctx->numberfmt_prototype);
+    if(SUCCEEDED(hres))
+        hres = define_constructor(ctx, intl, L"DateTimeFormat", DateTimeFormat_constructor,
+                                  &DateTimeFormat_prototype_info, &ctx->datefmt_prototype);
+    if(SUCCEEDED(hres))
+        hres = jsdisp_define_data_property(ctx->global, L"Intl", PROPF_CONFIGURABLE | PROPF_WRITABLE,
+                                           jsval_obj(intl));
+    jsdisp_release(intl);
+    return hres;
+}
+
+/* ---- entry points for the locale-sensitive methods taking (locales, options) ---- */
+
+HRESULT intl_locale_compare(script_ctx_t *ctx, const WCHAR *s1, unsigned len1, const WCHAR *s2, unsigned len2,
+        jsval_t locales, jsval_t options, int *ret)
+{
+    IntlInstance *inst;
+    DWORD cmpflags = 0;
+    HRESULT hres;
+    int cmp;
+
+    hres = create_instance(ctx, &Collator_info, ctx->collator_prototype, &inst);
+    if(FAILED(hres))
+        return hres;
+    hres = init_collator(ctx, inst, locales, options);
+    if(SUCCEEDED(hres)) {
+        switch(inst->u.coll.sensitivity) {
+        case 0: cmpflags = NORM_IGNORECASE | NORM_IGNORENONSPACE; break;
+        case 1: cmpflags = NORM_IGNORECASE; break;
+        case 2: cmpflags = NORM_IGNORENONSPACE; break;
+        }
+        if(inst->u.coll.ignore_punct) cmpflags |= NORM_IGNORESYMBOLS;
+        if(inst->u.coll.numeric) cmpflags |= SORT_DIGITSASNUMBERS;
+        cmp = CompareStringEx(inst->locale, cmpflags, s1, len1, s2, len2, NULL, NULL, 0);
+        if(!cmp)
+            hres = E_FAIL;
+        else
+            *ret = cmp - CSTR_EQUAL;
+    }
+    jsdisp_release(&inst->dispex);
+    return hres;
+}
+
+HRESULT intl_number_to_locale_string(script_ctx_t *ctx, double x, jsval_t locales, jsval_t options, jsstr_t **ret)
+{
+    IntlInstance *inst;
+    HRESULT hres;
+
+    hres = create_instance(ctx, &NumberFormat_info, ctx->numberfmt_prototype, &inst);
+    if(FAILED(hres))
+        return hres;
+    hres = init_numberformat(ctx, inst, locales, options);
+    if(SUCCEEDED(hres))
+        hres = format_number(ctx, inst, x, ret);
+    jsdisp_release(&inst->dispex);
+    return hres;
+}
+
+HRESULT intl_date_to_locale_string(script_ctx_t *ctx, double time, int required, int defaults, jsval_t locales,
+        jsval_t options, jsstr_t **ret)
+{
+    IntlInstance *inst;
+    HRESULT hres;
+
+    hres = create_instance(ctx, &DateTimeFormat_info, ctx->datefmt_prototype, &inst);
+    if(FAILED(hres))
+        return hres;
+    hres = init_datetimeformat(ctx, inst, locales, options, required, defaults);
+    if(SUCCEEDED(hres))
+        hres = format_datetime(ctx, inst, time, ret);
+    jsdisp_release(&inst->dispex);
+    return hres;
+}
