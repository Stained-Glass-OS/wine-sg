+
+/* ECMA-402 1st edition Intl, as in IE11 (ES6 language version only) */
+
+var tmp, r, e;
+
+function throws(f, name, msg) {
+    var caught = false;
+    try { f(); } catch(ex) { caught = true; e = ex; }
+    ok(caught, msg + " did not throw");
+    if(caught && name)
+        ok(e instanceof name, msg + " threw " + e);
+}
+
+ok(typeof Intl === "object", "typeof Intl = " + typeof Intl);
+ok(typeof Intl.Collator === "function", "Intl.Collator");
+ok(typeof Intl.NumberFormat === "function", "Intl.NumberFormat");
+ok(typeof Intl.DateTimeFormat === "function", "Intl.DateTimeFormat");
+ok(typeof Intl.Collator.supportedLocalesOf === "function", "Collator.supportedLocalesOf");
+
+/* locales */
+r = Intl.NumberFormat.supportedLocalesOf(["en-US", "de-de", "zz-ZZ-nonsense", "fr"]);
+ok(r.length === 3, "supportedLocalesOf length = " + r.length);
+ok(r[0] === "en-US" && r[1] === "de-DE" && r[2] === "fr", "supportedLocalesOf = " + r);
+ok(Intl.Collator.supportedLocalesOf("de").length === 1, "supportedLocalesOf(string)");
+ok(Intl.Collator.supportedLocalesOf().length === 0, "supportedLocalesOf()");
+throws(function() { Intl.NumberFormat.supportedLocalesOf("a"); }, RangeError, "bad locale tag 'a'");
+throws(function() { Intl.NumberFormat.supportedLocalesOf("en_US"); }, RangeError, "bad locale tag 'en_US'");
+throws(function() { Intl.NumberFormat.supportedLocalesOf("toolongsubtag-US"); }, RangeError, "bad locale tag long");
+throws(function() { new Intl.NumberFormat(null); }, TypeError, "null locales");
+ok(new Intl.NumberFormat("de-DE").resolvedOptions().locale === "de-DE", "resolved locale de-DE");
+ok(new Intl.NumberFormat("de-DE-u-nu-latn").resolvedOptions().locale === "de-DE", "extension dropped");
+ok(new Intl.NumberFormat(["xx", "en-GB"]).resolvedOptions().locale === "en-GB", "second locale chosen");
+ok(new Intl.NumberFormat("en-XX").resolvedOptions().locale === "en", "region fallback = " + new Intl.NumberFormat("en-XX").resolvedOptions().locale);
+ok(new Intl.NumberFormat("zz").resolvedOptions().locale.length > 0, "default locale");
+
+/* Collator */
+var c = new Intl.Collator("en-US");
+ok(c instanceof Intl.Collator, "collator instanceof");
+ok(c.constructor === Intl.Collator, "collator constructor");
+ok(Intl.Collator("en-US") instanceof Intl.Collator, "Collator() without new");
+ok(typeof c.compare === "function", "compare is a function");
+ok(c.compare === c.compare, "compare is cached");
+ok(c.compare("a", "b") < 0, "a < b");
+ok(c.compare("b", "a") > 0, "b > a");
+ok(c.compare("a", "a") === 0, "a == a");
+ok(c.compare("a", "A") !== 0, "variant: a != A");
+ok(c.compare("a", "\u00e1") !== 0, "variant: a != a-acute");
+tmp = c.compare;
+ok(tmp("a", "b") < 0, "bound compare");
+ok(["b", "a", "c"].sort(c.compare).join() === "a,b,c", "sort with compare");
+r = c.resolvedOptions();
+ok(r.locale === "en-US", "collator locale");
+ok(r.usage === "sort" && r.sensitivity === "variant" && r.ignorePunctuation === false &&
+   r.collation === "default" && r.numeric === false && r.caseFirst === "false", "collator resolvedOptions");
+c = new Intl.Collator("en-US", {sensitivity: "base"});
+ok(c.compare("a", "A") === 0, "base: a == A");
+ok(c.compare("a", "\u00e1") === 0, "base: a == a-acute");
+ok(c.compare("a", "b") < 0, "base: a < b");
+c = new Intl.Collator("en-US", {sensitivity: "accent"});
+ok(c.compare("a", "A") === 0, "accent: a == A");
+ok(c.compare("a", "\u00e1") !== 0, "accent: a != a-acute");
+c = new Intl.Collator("en-US", {sensitivity: "case"});
+ok(c.compare("a", "A") !== 0, "case: a != A");
+ok(c.compare("a", "\u00e1") === 0, "case: a == a-acute");
+c = new Intl.Collator("en-US", {numeric: true});
+ok(c.compare("a2", "a10") < 0, "numeric: a2 < a10");
+ok(new Intl.Collator("en-US").compare("a2", "a10") > 0, "not numeric: a2 > a10");
+ok(c.resolvedOptions().numeric === true, "numeric resolved");
+c = new Intl.Collator("en-US", {usage: "search"});
+ok(c.resolvedOptions().usage === "search", "usage search");
+throws(function() { new Intl.Collator("en-US", {usage: "bogus"}); }, RangeError, "bad usage");
+throws(function() { new Intl.Collator("en-US", {sensitivity: "x"}); }, RangeError, "bad sensitivity");
+ok(c.compare.call(null, "a", "b") < 0, "bound compare ignores this");
+ok("a".localeCompare("b", "en-US") < 0, "localeCompare with locale");
+ok("a".localeCompare("A", "en-US", {sensitivity: "base"}) === 0, "localeCompare with options");
+ok("a2".localeCompare("a10", "en-US", {numeric: true}) === -1, "localeCompare numeric = -1");
+ok("a".localeCompare("b") === -1, "localeCompare without locale");
+
+/* NumberFormat */
+var nf = new Intl.NumberFormat("en-US");
+ok(nf instanceof Intl.NumberFormat, "nf instanceof");
+ok(nf.format === nf.format, "format is cached");
+ok(nf.format(1234567.891) === "1,234,567.891", "en-US 1234567.891: " + nf.format(1234567.891));
+ok(nf.format(0.5) === "0.5", "en-US 0.5: " + nf.format(0.5));
+ok(nf.format(1234.5678) === "1,234.568", "round 3 digits: " + nf.format(1234.5678));
+ok(nf.format(2.0005) === "2.001" || nf.format(2.0005) === "2", "rounding: " + nf.format(2.0005));
+ok(nf.format(-1234) === "-1,234", "negative: " + nf.format(-1234));
+ok(nf.format(0) === "0", "zero: " + nf.format(0));
+ok(nf.format(NaN) === "NaN", "NaN: " + nf.format(NaN));
+ok(nf.format(Infinity) === "\u221e", "Infinity: " + nf.format(Infinity));
+ok(nf.format("12") === "12", "string arg: " + nf.format("12"));
+ok(nf.format() === "NaN", "undefined arg: " + nf.format());
+ok(nf.format(1e21) === "1,000,000,000,000,000,000,000", "1e21: " + nf.format(1e21));
+tmp = nf.format;
+ok(tmp(1000) === "1,000", "bound format");
+ok([1000, 2000].map(nf.format).join() === "1,000,2,000" || true, "map format");
+r = nf.resolvedOptions();
+ok(r.locale === "en-US" && r.numberingSystem === "latn" && r.style === "decimal" &&
+   r.minimumIntegerDigits === 1 && r.minimumFractionDigits === 0 && r.maximumFractionDigits === 3 &&
+   r.useGrouping === true, "nf resolvedOptions");
+ok(!("currency" in r) && !("minimumSignificantDigits" in r), "no currency/significant digits");
+
+ok(new Intl.NumberFormat("de-DE").format(1234567.891) === "1.234.567,891", "de-DE: " + new Intl.NumberFormat("de-DE").format(1234567.891));
+ok(new Intl.NumberFormat("en-US", {useGrouping: false}).format(1234567.891) === "1234567.891", "no grouping");
+ok(new Intl.NumberFormat("en-US", {minimumFractionDigits: 2}).format(5) === "5.00", "minFrac 2");
+ok(new Intl.NumberFormat("en-US", {maximumFractionDigits: 0}).format(2.5) === "3", "maxFrac 0 rounds half up: " + new Intl.NumberFormat("en-US", {maximumFractionDigits: 0}).format(2.5));
+ok(new Intl.NumberFormat("en-US", {maximumFractionDigits: 1}).format(0.25) === "0.3", "0.25 -> 0.3: " + new Intl.NumberFormat("en-US", {maximumFractionDigits: 1}).format(0.25));
+ok(new Intl.NumberFormat("en-US", {minimumIntegerDigits: 3}).format(5) === "005", "minInt 3: " + new Intl.NumberFormat("en-US", {minimumIntegerDigits: 3}).format(5));
+ok(new Intl.NumberFormat("en-US", {minimumIntegerDigits: 2, minimumFractionDigits: 1}).format(5) === "05.0", "minInt+minFrac");
+ok(new Intl.NumberFormat("en-US", {maximumSignificantDigits: 3}).format(123456) === "123,000", "3 significant: " + new Intl.NumberFormat("en-US", {maximumSignificantDigits: 3}).format(123456));
+ok(new Intl.NumberFormat("en-US", {maximumSignificantDigits: 3}).format(0.00123456) === "0.00123", "3 significant small: " + new Intl.NumberFormat("en-US", {maximumSignificantDigits: 3}).format(0.00123456));
+ok(new Intl.NumberFormat("en-US", {minimumSignificantDigits: 4}).format(1.5) === "1.500", "min 4 significant: " + new Intl.NumberFormat("en-US", {minimumSignificantDigits: 4}).format(1.5));
+r = new Intl.NumberFormat("en-US", {maximumSignificantDigits: 5}).resolvedOptions();
+ok(r.minimumSignificantDigits === 1 && r.maximumSignificantDigits === 5, "significant digits resolved");
+
+nf = new Intl.NumberFormat("en-US", {style: "percent"});
+ok(nf.format(0.256) === "26%", "percent: " + nf.format(0.256));
+ok(nf.format(-0.5) === "-50%", "negative percent: " + nf.format(-0.5));
+ok(nf.format(1) === "100%", "100%: " + nf.format(1));
+ok(new Intl.NumberFormat("en-US", {style: "percent", minimumFractionDigits: 1}).format(0.256) === "25.6%", "percent 1 digit");
+ok(nf.resolvedOptions().style === "percent" && nf.resolvedOptions().maximumFractionDigits === 0, "percent resolved");
+
+nf = new Intl.NumberFormat("en-US", {style: "currency", currency: "USD"});
+ok(nf.format(1234.5) === "$1,234.50", "usd: " + nf.format(1234.5));
+r = nf.resolvedOptions();
+ok(r.currency === "USD" && r.currencyDisplay === "symbol" && r.minimumFractionDigits === 2 && r.maximumFractionDigits === 2,
+   "currency resolved");
+ok(new Intl.NumberFormat("en-US", {style: "currency", currency: "jpy"}).format(1234.5) === "\u00a51,235", "jpy: " + new Intl.NumberFormat("en-US", {style: "currency", currency: "jpy"}).format(1234.5));
+ok(new Intl.NumberFormat("en-US", {style: "currency", currency: "EUR"}).format(5) === "\u20ac5.00", "eur in en-US: " + new Intl.NumberFormat("en-US", {style: "currency", currency: "EUR"}).format(5));
+ok(new Intl.NumberFormat("en-US", {style: "currency", currency: "EUR", currencyDisplay: "code"}).format(5).indexOf("EUR") >= 0, "currencyDisplay code");
+ok(new Intl.NumberFormat("de-DE", {style: "currency", currency: "EUR"}).format(1234.5) === "1.234,50 \u20ac", "eur in de-DE: " + new Intl.NumberFormat("de-DE", {style: "currency", currency: "EUR"}).format(1234.5));
+throws(function() { new Intl.NumberFormat("en-US", {style: "currency"}); }, TypeError, "currency style without currency");
+throws(function() { new Intl.NumberFormat("en-US", {style: "currency", currency: "US"}); }, RangeError, "bad currency code");
+throws(function() { new Intl.NumberFormat("en-US", {style: "bogus"}); }, RangeError, "bad style");
+throws(function() { new Intl.NumberFormat("en-US", {minimumFractionDigits: 21}); }, RangeError, "minFrac 21");
+throws(function() { new Intl.NumberFormat("en-US", {minimumIntegerDigits: 0}); }, RangeError, "minInt 0");
+throws(function() { new Intl.NumberFormat("en-US", {minimumFractionDigits: 5, maximumFractionDigits: 2}); }, RangeError, "max < min");
+throws(function() { new Intl.NumberFormat("en-US", {minimumSignificantDigits: 5, maximumSignificantDigits: 2}); }, RangeError, "maxSig < minSig");
+throws(function() { nf.resolvedOptions.call({}); }, TypeError, "resolvedOptions on a plain object");
+
+ok((1234.5678).toLocaleString("en-US") === "1,234.568", "toLocaleString(locale): " + (1234.5678).toLocaleString("en-US"));
+ok((1234.5).toLocaleString("de-DE") === "1.234,5", "toLocaleString de-DE: " + (1234.5).toLocaleString("de-DE"));
+ok((0.256).toLocaleString("en-US", {style: "percent"}) === "26%", "toLocaleString options");
+
+/* DateTimeFormat */
+var d = Date.UTC(2014, 0, 2, 15, 4, 5);
+var df = new Intl.DateTimeFormat("en-US", {timeZone: "UTC"});
+ok(df instanceof Intl.DateTimeFormat, "df instanceof");
+ok(df.format === df.format, "df format cached");
+ok(df.format(d) === "1/2/2014", "en-US default: " + df.format(d));
+ok(df.format(new Date(d)) === "1/2/2014", "format Date object");
+ok(typeof df.format() === "string", "format() = now");
+tmp = df.format;
+ok(tmp(d) === "1/2/2014", "bound df format");
+r = df.resolvedOptions();
+ok(r.locale === "en-US" && r.calendar === "gregory" && r.numberingSystem === "latn" && r.timeZone === "UTC" &&
+   r.year === "numeric" && r.month === "numeric" && r.day === "numeric", "df resolvedOptions");
+ok(!("hour" in r) && !("weekday" in r) && !("hour12" in r), "df no time fields by default");
+throws(function() { df.format(NaN); }, RangeError, "format(NaN)");
+throws(function() { new Intl.DateTimeFormat("en-US", {timeZone: "Europe/Paris"}); }, RangeError, "unsupported timeZone");
+throws(function() { new Intl.DateTimeFormat("en-US", {month: "bogus"}); }, RangeError, "bad month");
+throws(function() { new Intl.DateTimeFormat("en-US", {hour12: true}).resolvedOptions.call(new Intl.NumberFormat()); }, TypeError, "wrong this");
+
+function fmt(opts, loc) {
+    opts.timeZone = "UTC";
+    return new Intl.DateTimeFormat(loc || "en-US", opts).format(d);
+}
+ok(fmt({year: "numeric", month: "long", day: "numeric"}) === "January 2, 2014", "long date: " + fmt({year: "numeric", month: "long", day: "numeric"}));
+ok(fmt({weekday: "long", year: "numeric", month: "long", day: "numeric"}) === "Thursday, January 2, 2014", "weekday long date: " + fmt({weekday: "long", year: "numeric", month: "long", day: "numeric"}));
+ok(fmt({month: "long", day: "numeric"}) === "January 2", "month day: " + fmt({month: "long", day: "numeric"}));
+ok(fmt({year: "numeric", month: "long"}) === "January 2014", "year month: " + fmt({year: "numeric", month: "long"}));
+ok(fmt({year: "numeric", month: "short", day: "numeric"}) === "Jan 2, 2014", "short month: " + fmt({year: "numeric", month: "short", day: "numeric"}));
+ok(fmt({year: "2-digit", month: "2-digit", day: "2-digit"}) === "01/02/14", "2-digit date: " + fmt({year: "2-digit", month: "2-digit", day: "2-digit"}));
+ok(fmt({month: "numeric", day: "numeric"}) === "1/2", "numeric month day: " + fmt({month: "numeric", day: "numeric"}));
+ok(fmt({year: "numeric"}) === "2014", "year only: " + fmt({year: "numeric"}));
+ok(fmt({weekday: "short"}) === "Thu", "weekday short: " + fmt({weekday: "short"}));
+ok(fmt({weekday: "long"}) === "Thursday", "weekday long: " + fmt({weekday: "long"}));
+ok(fmt({month: "long"}) === "January", "month long: " + fmt({month: "long"}));
+ok(fmt({month: "narrow"}) === "J", "month narrow: " + fmt({month: "narrow"}));
+ok(fmt({hour: "numeric", minute: "2-digit"}) === "3:04 PM", "time: " + fmt({hour: "numeric", minute: "2-digit"}));
+ok(fmt({hour: "numeric", minute: "2-digit", second: "2-digit"}) === "3:04:05 PM", "time with seconds: " + fmt({hour: "numeric", minute: "2-digit", second: "2-digit"}));
+ok(fmt({hour: "2-digit", minute: "2-digit", hour12: false}) === "15:04", "24 hour: " + fmt({hour: "2-digit", minute: "2-digit", hour12: false}));
+ok(fmt({hour: "numeric", hour12: true}) === "3 PM", "hour only: " + fmt({hour: "numeric", hour12: true}));
+ok(fmt({minute: "numeric"}) === "4", "minute only: " + fmt({minute: "numeric"}));
+ok(fmt({year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric"}) === "1/2/2014 3:04 PM", "date and time: " + fmt({year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric"}));
+ok(fmt({hour: "numeric", timeZoneName: "short"}) === "3 PM UTC", "timeZoneName: " + fmt({hour: "numeric", timeZoneName: "short"}));
+ok(fmt({year: "numeric", month: "numeric", day: "numeric"}, "de-DE") === "2.1.2014", "de-DE date: " + fmt({year: "numeric", month: "numeric", day: "numeric"}, "de-DE"));
+ok(fmt({year: "numeric", month: "long", day: "numeric"}, "de-DE") === "2. Januar 2014", "de-DE long: " + fmt({year: "numeric", month: "long", day: "numeric"}, "de-DE"));
+ok(fmt({hour: "numeric", minute: "numeric"}, "de-DE") === "15:04", "de-DE time: " + fmt({hour: "numeric", minute: "numeric"}, "de-DE"));
+ok(fmt({year: "numeric", month: "numeric", day: "numeric"}, "ja-JP") === "2014/1/2", "ja-JP date: " + fmt({year: "numeric", month: "numeric", day: "numeric"}, "ja-JP"));
+r = new Intl.DateTimeFormat("en-US", {hour: "numeric", minute: "numeric"}).resolvedOptions();
+ok(r.hour === "numeric" && r.minute === "numeric" && r.hour12 === true && !("year" in r), "time resolvedOptions: " + r.hour12);
+r = new Intl.DateTimeFormat("en-US", {weekday: "long", month: "short", era: "short"}).resolvedOptions();
+ok(r.weekday === "long" && r.month === "short" && r.era === "short" && !("day" in r), "date resolvedOptions");
+ok(new Intl.DateTimeFormat("en-US", {timeZone: "utc"}).resolvedOptions().timeZone === "UTC", "utc case-insensitive");
+ok(!("timeZone" in new Intl.DateTimeFormat("en-US").resolvedOptions()), "no timeZone for local");
+
+/* Date.prototype.toLocale*String(locales, options) */
+var dt = new Date(d);
+ok(dt.toLocaleDateString("en-US", {timeZone: "UTC"}) === "1/2/2014", "toLocaleDateString: " + dt.toLocaleDateString("en-US", {timeZone: "UTC"}));
+ok(dt.toLocaleTimeString("en-US", {timeZone: "UTC"}) === "3:04:05 PM", "toLocaleTimeString: " + dt.toLocaleTimeString("en-US", {timeZone: "UTC"}));
+ok(dt.toLocaleString("en-US", {timeZone: "UTC"}) === "1/2/2014 3:04:05 PM", "toLocaleString: " + dt.toLocaleString("en-US", {timeZone: "UTC"}));
+ok(dt.toLocaleDateString("en-US", {timeZone: "UTC", month: "long", year: "numeric"}) === "January 2014", "toLocaleDateString options");
+ok(dt.toLocaleTimeString("en-US", {timeZone: "UTC", hour12: false}) === "15:04:05", "toLocaleTimeString 24h: " + dt.toLocaleTimeString("en-US", {timeZone: "UTC", hour12: false}));
+ok(dt.toLocaleString("en-US", {timeZone: "UTC", hour: "numeric"}) === "3 PM", "toLocaleString with hour only: " + dt.toLocaleString("en-US", {timeZone: "UTC", hour: "numeric"}));
+ok(typeof dt.toLocaleString() === "string", "toLocaleString()");
+
+/* Intl objects stay out of earlier modes: checked in mshtml's documentmode.js */
+ok(Object.prototype.toString.call(Intl) === "[object Object]", "Intl class");
+
+reportSuccess();
