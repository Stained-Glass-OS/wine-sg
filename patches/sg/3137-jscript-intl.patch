+
+/*
+ * The ECMAScript Internationalization API (ECMA-402, 1st edition), as
+ * shipped with IE11: Intl.Collator, Intl.NumberFormat and Intl.DateTimeFormat,
+ * built on the NLS functions (CompareStringEx, GetNumberFormatEx,
+ * GetCurrencyFormatEx, GetDateFormatEx, GetTimeFormatEx).  Only present in
+ * the ES6 (IE11 document mode) language version.
+ */
+
+#include <math.h>
+#include <assert.h>
+
+#include "jscript.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(jscript);
+
+/* not declared in winnls.h */
+WINBASEAPI INT WINAPI GetNumberFormatEx(LPCWSTR,DWORD,LPCWSTR,const NUMBERFMTW*,LPWSTR,int);
+
+#define MAX_LOCALES 32
+#define LNAME_LEN   LOCALE_NAME_MAX_LENGTH
+
+typedef struct {
+    jsdisp_t dispex;
+    WCHAR locale[LNAME_LEN];
+    union {
+        struct {
+            int usage;         /* 0 sort, 1 search */
+            int sensitivity;   /* 0 base, 1 accent, 2 case, 3 variant */
+            BOOL ignore_punct;
+            BOOL numeric;
+            int case_first;    /* 0 false, 1 upper, 2 lower */
+        } coll;
+        struct {
+            int style;         /* 0 decimal, 1 percent, 2 currency */
+            WCHAR currency[4];
+            int currency_display; /* 0 code, 1 symbol, 2 name */
+            int min_int, min_frac, max_frac;
+            int min_sig, max_sig;  /* 0 if unused */
+            BOOL grouping;
+        } num;
+        struct {
+            int weekday, era, year, month, day, hour, minute, second, tzname;
+            BOOL hour12, utc;
+        } dt;
+    } u;
+} IntlInstance;
+
+static inline IntlInstance *intl_from_jsdisp(jsdisp_t *jsdisp)
+{
+    return CONTAINING_RECORD(jsdisp, IntlInstance, dispex);
+}
+
+static IntlInstance *intl_this(script_ctx_t *ctx, jsval_t vthis, jsclass_t class, const WCHAR *name, HRESULT *hres)
+{
+    jsdisp_t *jsdisp;
+
+    if(!is_object_instance(vthis) || !(jsdisp = to_jsdisp(get_object(vthis))) || !is_class(jsdisp, class)) {
+        *hres = throw_error(ctx, JS_E_WRONG_THIS, name);
+        return NULL;
+    }
+    return intl_from_jsdisp(jsdisp);
+}
+
+static void Intl_destructor(jsdisp_t *dispex)
+{
+    free(intl_from_jsdisp(dispex));
+}
+
+/* ---- options ---- */
+
+typedef struct {
+    script_ctx_t *ctx;
+    IDispatch *disp;
+} options_t;
+
+static HRESULT options_init(script_ctx_t *ctx, jsval_t v, options_t *o)
+{
+    o->ctx = ctx;
+    o->disp = NULL;
+    if(is_undefined(v))
+        return S_OK;
+    if(is_null(v))
+        return throw_error(ctx, JS_E_OBJECT_EXPECTED, NULL);
+    return to_object(ctx, v, &o->disp);
+}
+
+static void options_free(options_t *o)
+{
+    if(o->disp)
+        IDispatch_Release(o->disp);
+}
+
+static HRESULT opt_get(options_t *o, const WCHAR *name, jsval_t *r)
+{
+    jsdisp_t *jsdisp;
+    HRESULT hres;
+
+    *r = jsval_undefined();
+    if(!o->disp)
+        return S_OK;
+    if((jsdisp = to_jsdisp(o->disp)))
+        return jsdisp_propget_name(jsdisp, name, r);
+    hres = disp_call_name(o->ctx, o->disp, name, DISPATCH_PROPERTYGET, 0, NULL, r);
+    if(hres == DISP_E_UNKNOWNNAME || hres == DISP_E_MEMBERNOTFOUND) {
+        *r = jsval_undefined();
+        return S_OK;
+    }
+    return hres;
+}
+
+/* returns the index into allowed, or -1 if the option is undefined */
+static HRESULT opt_enum(options_t *o, const WCHAR *name, const WCHAR *const *allowed, int *idx)
+{
+    const WCHAR *s;
+    jsstr_t *str;
+    jsval_t v;
+    HRESULT hres;
+    int i;
+
+    *idx = -1;
+    hres = opt_get(o, name, &v);
+    if(FAILED(hres) || is_undefined(v))
+        return hres;
+    hres = to_flat_string(o->ctx, v, &str, &s);
+    jsval_release(v);
+    if(FAILED(hres))
+        return hres;
+    for(i = 0; allowed[i]; i++) {
+        if(!wcscmp(s, allowed[i])) {
+            *idx = i;
+            break;
+        }
+    }
+    jsstr_release(str);
+    if(*idx < 0)
+        return throw_error(o->ctx, JS_E_INTL_BAD_OPTION, name);
+    return S_OK;
+}
+
+static HRESULT opt_bool(options_t *o, const WCHAR *name, int *ret)
+{
+    BOOL b;
+    jsval_t v;
+    HRESULT hres;
+
+    *ret = -1;
+    hres = opt_get(o, name, &v);
+    if(FAILED(hres) || is_undefined(v))
+        return hres;
+    hres = to_boolean(v, &b);
+    jsval_release(v);
+    if(SUCCEEDED(hres))
+        *ret = b != 0;
+    return hres;
+}
+
+static HRESULT opt_number(options_t *o, const WCHAR *name, int min, int max, int fallback, int *ret)
+{
+    double d;
+    jsval_t v;
+    HRESULT hres;
+
+    *ret = fallback;
+    hres = opt_get(o, name, &v);
+    if(FAILED(hres) || is_undefined(v))
+        return hres;
+    hres = to_number(o->ctx, v, &d);
+    jsval_release(v);
+    if(FAILED(hres))
+        return hres;
+    if(isnan(d) || d < min || d > max)
+        return throw_error(o->ctx, JS_E_INTL_BAD_OPTION, name);
+    *ret = floor(d);
+    return S_OK;
+}
+
+/* ---- locales ---- */
+
+static BOOL canonicalize_tag(const WCHAR *tag, size_t len, WCHAR *out)
+{
+    size_t i = 0, o = 0, sub_len;
+    unsigned index = 0;
+
+    if(!len || len >= LNAME_LEN)
+        return FALSE;
+
+    while(i <= len) {
+        size_t start = i, k;
+        BOOL alpha = TRUE;
+
+        while(i < len && tag[i] != '-')
+            i++;
+        sub_len = i - start;
+        if(!sub_len || sub_len > 8)
+            return FALSE;
+        for(k = start; k < i; k++) {
+            WCHAR c = tag[k];
+            if(c >= '0' && c <= '9') alpha = FALSE;
+            else if(!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) return FALSE;
+        }
+        if(!index && (!alpha || (sub_len == 1 || sub_len == 4)))
+            return FALSE;
+        if(index && sub_len == 1)  /* extension or private use singleton: ignored */
+            break;
+        if(o)
+            out[o++] = '-';
+        for(k = start; k < i; k++) {
+            WCHAR c = tag[k];
+            BOOL upper;
+            if(!index || sub_len > 4 || !alpha) upper = FALSE;
+            else if(sub_len == 4) upper = (k == start);
+            else upper = (sub_len == 2);
+            if(c >= 'A' && c <= 'Z' && !upper) c += 'a' - 'A';
+            else if(c >= 'a' && c <= 'z' && upper) c -= 'a' - 'A';
+            out[o++] = c;
+        }
+        index++;
+        i++;
+    }
+    out[o] = 0;
+    return TRUE;
+}
+
+static HRESULT get_locale_list(script_ctx_t *ctx, jsval_t locales, WCHAR list[MAX_LOCALES][LNAME_LEN],
+        unsigned *count)
+{
+    IDispatch *disp = NULL;
+    jsdisp_t *jsdisp;
+    jsstr_t *str;
+    const WCHAR *s;
+    jsval_t v;
+    double len;
+    unsigned i;
+    HRESULT hres;
+
+    *count = 0;
+    if(is_undefined(locales))
+        return S_OK;
+    if(is_null(locales))
+        return throw_error(ctx, JS_E_OBJECT_EXPECTED, NULL);
+
+    if(jsval_type(locales) == JSV_STRING) {
+        hres = to_flat_string(ctx, locales, &str, &s);
+        if(FAILED(hres))
+            return hres;
+        if(!canonicalize_tag(s, jsstr_length(str), list[0]))
+            hres = throw_error(ctx, JS_E_INTL_BAD_LOCALE, NULL);
+        else {
+            *count = 1;
+            hres = S_OK;
+        }
+        jsstr_release(str);
+        return hres;
+    }
+
+    hres = to_object(ctx, locales, &disp);
+    if(FAILED(hres))
+        return hres;
+    jsdisp = to_jsdisp(disp);
+    if(jsdisp)
+        hres = jsdisp_propget_name(jsdisp, L"length", &v);
+    else {
+        hres = disp_call_name(ctx, disp, L"length", DISPATCH_PROPERTYGET, 0, NULL, &v);
+        if(hres == DISP_E_UNKNOWNNAME || hres == DISP_E_MEMBERNOTFOUND) {
+            v = jsval_undefined();
+            hres = S_OK;
+        }
+    }
+    if(FAILED(hres)) {
+        IDispatch_Release(disp);
+        return hres;
+    }
+    hres = to_number(ctx, v, &len);
+    jsval_release(v);
+    if(FAILED(hres)) {
+        IDispatch_Release(disp);
+        return hres;
+    }
+    if(isnan(len) || len < 0) len = 0;
+    for(i = 0; i < len && SUCCEEDED(hres); i++) {
+        WCHAR name[16];
+        swprintf(name, ARRAY_SIZE(name), L"%u", i);
+        if(jsdisp)
+            hres = jsdisp_propget_name(jsdisp, name, &v);
+        else {
+            hres = disp_call_name(ctx, disp, name, DISPATCH_PROPERTYGET, 0, NULL, &v);
+            if(hres == DISP_E_UNKNOWNNAME || hres == DISP_E_MEMBERNOTFOUND) {
+                v = jsval_undefined();
+                hres = S_OK;
+            }
+        }
+        if(FAILED(hres))
+            break;
+        if(is_undefined(v))
+            continue;  /* absent element */
+        if(jsval_type(v) != JSV_STRING && !is_object_instance(v)) {
+            jsval_release(v);
+            hres = throw_error(ctx, JS_E_INTL_BAD_LOCALE, NULL);
+            break;
+        }
+        hres = to_flat_string(ctx, v, &str, &s);
+        jsval_release(v);
+        if(FAILED(hres))
+            break;
+        if(!canonicalize_tag(s, jsstr_length(str), list[*count]))
+            hres = throw_error(ctx, JS_E_INTL_BAD_LOCALE, NULL);
+        else if(++*count == MAX_LOCALES)
+            i = len;
+        jsstr_release(str);
+    }
+    IDispatch_Release(disp);
+    return hres;
+}
+
+static BOOL lookup_locale(const WCHAR *tag, WCHAR *out)
+{
+    WCHAR buf[LNAME_LEN], *p;
+
+    wcscpy(buf, tag);
+    for(;;) {
+        if(buf[0] && IsValidLocaleName(buf)) {
+            wcscpy(out, buf);
+            return TRUE;
+        }
+        if(!(p = wcsrchr(buf, '-')))
+            return FALSE;
+        *p = 0;
+    }
+}
+
+static void default_locale(script_ctx_t *ctx, WCHAR *out)
+{
+    if(!LCIDToLocaleName(ctx->lcid, out, LNAME_LEN, 0) || !out[0])
+        wcscpy(out, L"en-US");
+}
+
+static HRESULT resolve_locale(script_ctx_t *ctx, jsval_t locales, options_t *opts, WCHAR *out)
+{
+    static const WCHAR *const matchers[] = { L"lookup", L"best fit", NULL };
+    WCHAR list[MAX_LOCALES][LNAME_LEN];
+    unsigned count, i;
+    int matcher;
+    HRESULT hres;
+
+    hres = get_locale_list(ctx, locales, list, &count);
+    if(FAILED(hres))
+        return hres;
+    hres = opt_enum(opts, L"localeMatcher", matchers, &matcher);
+    if(FAILED(hres))
+        return hres;
+
+    for(i = 0; i < count; i++)
+        if(lookup_locale(list[i], out))
+            return S_OK;
+    default_locale(ctx, out);
+    return S_OK;
+}
+
+static HRESULT supported_locales_of(script_ctx_t *ctx, unsigned argc, jsval_t *argv, jsval_t *r)
+{
+    static const WCHAR *const matchers[] = { L"lookup", L"best fit", NULL };
+    WCHAR list[MAX_LOCALES][LNAME_LEN], tmp[LNAME_LEN];
+    unsigned count, i, n = 0;
+    options_t opts;
+    jsdisp_t *arr;
+    int matcher;
+    HRESULT hres;
+
+    hres = get_locale_list(ctx, argc ? argv[0] : jsval_undefined(), list, &count);
+    if(FAILED(hres))
+        return hres;
+    hres = options_init(ctx, argc > 1 ? argv[1] : jsval_undefined(), &opts);
+    if(FAILED(hres))
+        return hres;
+    hres = opt_enum(&opts, L"localeMatcher", matchers, &matcher);
+    options_free(&opts);
+    if(FAILED(hres))
+        return hres;
+
+    hres = create_array(ctx, 0, &arr);
+    if(FAILED(hres))
+        return hres;
+    for(i = 0; i < count && SUCCEEDED(hres); i++) {
+        jsstr_t *str;
+        if(!lookup_locale(list[i], tmp))
+            continue;
+        if(!(str = jsstr_alloc(list[i]))) {
+            hres = E_OUTOFMEMORY;
+            break;
+        }
+        hres = jsdisp_propput_idx(arr, n++, jsval_string(str));
+        jsstr_release(str);
+    }
+    if(FAILED(hres)) {
+        jsdisp_release(arr);
+        return hres;
+    }
+    if(r)
+        *r = jsval_obj(arr);
+    else
+        jsdisp_release(arr);
+    return S_OK;
+}
+
+static HRESULT str_prop(script_ctx_t *ctx, jsdisp_t *obj, const WCHAR *name, const WCHAR *value)
+{
+    jsstr_t *str = jsstr_alloc(value);
+    HRESULT hres;
+
+    if(!str)
+        return E_OUTOFMEMORY;
+    hres = jsdisp_define_data_property(obj, name, PROPF_ENUMERABLE | PROPF_WRITABLE | PROPF_CONFIGURABLE,
+                                       jsval_string(str));
+    jsstr_release(str);
+    return hres;
+}
+
