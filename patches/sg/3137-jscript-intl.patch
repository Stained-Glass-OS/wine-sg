+static HRESULT init_collator(script_ctx_t *ctx, IntlInstance *inst, jsval_t locales, jsval_t options)
+{
+    options_t opts;
+    int v;
+    HRESULT hres;
+
+    hres = options_init(ctx, options, &opts);
+    if(FAILED(hres))
+        return hres;
+
+    hres = opt_enum(&opts, L"usage", usage_values, &v);
+    if(SUCCEEDED(hres)) inst->u.coll.usage = v < 0 ? 0 : v;
+    if(SUCCEEDED(hres)) hres = resolve_locale(ctx, locales, &opts, inst->locale);
+    if(SUCCEEDED(hres)) hres = opt_bool(&opts, L"numeric", &v);
+    if(SUCCEEDED(hres)) inst->u.coll.numeric = v > 0;
+    if(SUCCEEDED(hres)) hres = opt_enum(&opts, L"caseFirst", casefirst_values, &v);
+    if(SUCCEEDED(hres)) inst->u.coll.case_first = v < 0 ? 0 : v;
+    if(SUCCEEDED(hres)) hres = opt_enum(&opts, L"sensitivity", sensitivity_values, &v);
+    if(SUCCEEDED(hres)) inst->u.coll.sensitivity = v < 0 ? 3 : v;
+    if(SUCCEEDED(hres)) hres = opt_bool(&opts, L"ignorePunctuation", &v);
+    if(SUCCEEDED(hres)) inst->u.coll.ignore_punct = v > 0;
+    options_free(&opts);
+    return hres;
+}
