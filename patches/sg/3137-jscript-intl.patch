+/* ---- DateTimeFormat ---- */
+
+static const WCHAR *const nsl_values[] = { L"narrow", L"short", L"long", NULL };
+static const WCHAR *const year_values[] = { L"2-digit", L"numeric", NULL };
+static const WCHAR *const month_values[] = { L"2-digit", L"numeric", L"narrow", L"short", L"long", NULL };
+static const WCHAR *const num_values[] = { L"2-digit", L"numeric", NULL };
+static const WCHAR *const tzname_values[] = { L"short", L"long", NULL };
+
+/* pattern tokens */
+enum { TK_LIT, TK_DAY, TK_MONTH, TK_YEAR, TK_ERA, TK_WDAY, TK_HOUR12, TK_HOUR24, TK_MIN, TK_SEC, TK_MARK };
+
+typedef struct {
+    int kind;
+    int len;            /* for non-literals: letter count */
+    WCHAR lit[24];      /* literal text (unquoted) */
+    BOOL drop;
+} ptoken_t;
+
+#define MAX_TOKENS 40
+
+static unsigned parse_pattern(const WCHAR *pat, ptoken_t *tok)
+{
+    unsigned n = 0;
+
+    while(*pat && n < MAX_TOKENS) {
+        WCHAR c = *pat;
+        ptoken_t *t = &tok[n];
+
+        memset(t, 0, sizeof(*t));
+        if(c == '\'') {
+            unsigned l = 0;
+            pat++;
+            while(*pat) {
+                if(*pat == '\'') {
+                    if(pat[1] == '\'') { if(l < 23) t->lit[l++] = '\''; pat += 2; continue; }
+                    pat++;
+                    break;
+                }
+                if(l < 23) t->lit[l++] = *pat;
+                pat++;
+            }
+            t->kind = TK_LIT;
+        }else if(wcschr(L"dMyghHmst", c)) {
+            int kind;
+            switch(c) {
+            case 'd': kind = TK_DAY; break;
+            case 'M': kind = TK_MONTH; break;
+            case 'y': kind = TK_YEAR; break;
+            case 'g': kind = TK_ERA; break;
+            case 'h': kind = TK_HOUR12; break;
+            case 'H': kind = TK_HOUR24; break;
+            case 'm': kind = TK_MIN; break;
+            case 's': kind = TK_SEC; break;
+            default:  kind = TK_MARK; break;
+            }
+            t->kind = kind;
+            while(*pat == c) { t->len++; pat++; }
+            if(c == 'd' && t->len >= 3) t->kind = TK_WDAY;
+        }else {
+            unsigned l = 0;
+            while(*pat && *pat != '\'' && !wcschr(L"dMyghHmst", *pat)) {
+                if(l < 23) t->lit[l++] = *pat;
+                pat++;
+            }
+            t->kind = TK_LIT;
+        }
+        n++;
+    }
+    return n;
+}
+
+/* picture string builder: consecutive literals are merged into one quoted run */
+typedef struct {
+    WCHAR *pic;
+    size_t size;
+    WCHAR lit[96];
+    unsigned lit_len;
+} picbuf_t;
+
+static void pb_flush(picbuf_t *pb)
+{
+    WCHAR tmp[200];
+    unsigned i, l = 0;
+
+    if(!pb->lit_len)
+        return;
+    tmp[l++] = '\'';
+    for(i = 0; i < pb->lit_len; i++) {
+        if(pb->lit[i] == '\'')
+            tmp[l++] = '\'';
+        tmp[l++] = pb->lit[i];
+    }
+    tmp[l++] = '\'';
+    tmp[l] = 0;
+    append_str(pb->pic, pb->size, tmp);
+    pb->lit_len = 0;
+}
+
+static void pb_lit(picbuf_t *pb, const WCHAR *s)
+{
+    for(; *s && pb->lit_len < ARRAY_SIZE(pb->lit); s++)
+        pb->lit[pb->lit_len++] = *s;
+}
+
+static void pb_tok(picbuf_t *pb, WCHAR c, int len)
+{
+    WCHAR tmp[8];
+    int i;
+
+    pb_flush(pb);
+    for(i = 0; i < len && i < 7; i++) tmp[i] = c;
+    tmp[i] = 0;
+    append_str(pb->pic, pb->size, tmp);
+}
+
+static void pb_first_char(picbuf_t *pb, const WCHAR *locale, DWORD type)
+{
+    WCHAR name[80], one[2];
+
+    if(GetLocaleInfoEx(locale, type, name, ARRAY_SIZE(name)) && name[0]) {
+        one[0] = name[0];
+        one[1] = 0;
+        pb_lit(pb, one);
+    }
+}
+
+static BOOL lit_has_nonascii(const WCHAR *s)
+{
+    for(; *s; s++)
+        if(*s > 127)
+            return TRUE;
+    return FALSE;
+}
+
+static BOOL lit_is_space(const WCHAR *s)
+{
+    for(; *s; s++)
+        if(*s != ' ' && *s != 0xa0)
+            return FALSE;
+    return TRUE;
+}
+
+/* Emit the separator between two kept tokens: the literals found between them
+ * in the original pattern, preferring a whitespace-only one, else the first. */
+static void emit_separator(picbuf_t *pb, const ptoken_t *tok, unsigned from, unsigned to)
+{
+    const WCHAR *first = NULL, *space = NULL;
+    unsigned i;
+
+    for(i = from + 1; i < to; i++) {
+        if(tok[i].kind != TK_LIT)
+            continue;
+        if(!first) first = tok[i].lit;
+        if(!space && lit_is_space(tok[i].lit)) space = tok[i].lit;
+    }
+#ifdef SG_MUTANT_JS_NOSEP
+    space = NULL;
+#endif
+    if(space) pb_lit(pb, space);
+    else if(first) pb_lit(pb, first);
+}
+
+typedef void (*emit_tok_t)(picbuf_t*, const ptoken_t*, void*);
+
+/* Emits the tokens that are not dropped, with the separators between them. */
+static void emit_pattern(picbuf_t *pb, const ptoken_t *tok, unsigned n, emit_tok_t emit, void *ctx)
+{
+    int last = -1, first = -1;
+    unsigned i;
+
+    for(i = 0; i < n; i++) {
+        if(tok[i].kind == TK_LIT || tok[i].drop)
+            continue;
+        if(first < 0) {
+            first = i;
+            for(last = 0; last < first; last++)
+                if(tok[last].kind == TK_LIT && lit_has_nonascii(tok[last].lit))
+                    pb_lit(pb, tok[last].lit);
+        }else
+            emit_separator(pb, tok, last, i);
+        emit(pb, &tok[i], ctx);
+        last = i;
+    }
+    if(first >= 0 && (unsigned)last + 1 < n && tok[last + 1].kind == TK_LIT &&
+       lit_has_nonascii(tok[last + 1].lit))
+        pb_lit(pb, tok[last + 1].lit);
+}
+
+struct date_emit {
+    const IntlInstance *inst;
+    const SYSTEMTIME *st;
+};
+
+static void emit_weekday(picbuf_t *pb, const IntlInstance *inst, const SYSTEMTIME *st)
+{
+    if(inst->u.dt.weekday == 1)
+        pb_first_char(pb, inst->locale, LOCALE_SDAYNAME1 + (st->wDayOfWeek + 6) % 7);
+    else
+        pb_tok(pb, 'd', inst->u.dt.weekday == 2 ? 3 : 4);
+}
+
+static void emit_date_tok(picbuf_t *pb, const ptoken_t *t, void *ctx)
+{
+    struct date_emit *de = ctx;
+    const IntlInstance *inst = de->inst;
+
+    switch(t->kind) {
+    case TK_DAY:
+        pb_tok(pb, 'd', inst->u.dt.day == 1 ? 2 : 1);
+        break;
+    case TK_YEAR:
+        pb_tok(pb, 'y', inst->u.dt.year == 1 ? 2 : 4);
+        break;
+    case TK_ERA:
+        pb_tok(pb, 'g', 2);
+        break;
+    case TK_WDAY:
+        emit_weekday(pb, inst, de->st);
+        break;
+    case TK_MONTH:
+        switch(inst->u.dt.month) {
+        case 1: pb_tok(pb, 'M', 2); break;
+        case 2: pb_tok(pb, 'M', 1); break;
+        case 3: pb_first_char(pb, inst->locale, LOCALE_SMONTHNAME1 + de->st->wMonth - 1); break;
+        case 4: pb_tok(pb, 'M', 3); break;
+        default: pb_tok(pb, 'M', 4); break;
+        }
+        break;
+    }
+}
+
+static void build_date_picture(const IntlInstance *inst, const SYSTEMTIME *st, WCHAR *pic, size_t size)
+{
+    const WCHAR *l = inst->locale;
+    BOOL text_month = inst->u.dt.month >= 3;
+    WCHAR base[80];
+    ptoken_t tok[MAX_TOKENS];
+    struct date_emit de = { inst, st };
+    picbuf_t pb = { pic, size };
+    unsigned n, i;
+    BOOL have_wday = FALSE, have_era = FALSE, kept = FALSE;
+
+    pic[0] = 0;
+    if(!inst->u.dt.weekday && !inst->u.dt.year && !inst->u.dt.month && !inst->u.dt.day && !inst->u.dt.era)
+        return;
+
+    if(!GetLocaleInfoEx(l, text_month ? LOCALE_SLONGDATE : LOCALE_SSHORTDATE, base, ARRAY_SIZE(base)))
+        wcscpy(base, text_month ? L"dddd, MMMM d, yyyy" : L"M/d/yyyy");
+    n = parse_pattern(base, tok);
+
+    for(i = 0; i < n; i++) {
+        switch(tok[i].kind) {
+        case TK_DAY:   tok[i].drop = !inst->u.dt.day; break;
+        case TK_MONTH: tok[i].drop = !inst->u.dt.month; break;
+        case TK_YEAR:  tok[i].drop = !inst->u.dt.year; break;
+        case TK_WDAY:  tok[i].drop = !inst->u.dt.weekday; have_wday = TRUE; break;
+        case TK_ERA:   tok[i].drop = !inst->u.dt.era; have_era = TRUE; break;
+        default: continue;
+        }
+        kept |= !tok[i].drop && tok[i].kind != TK_WDAY && tok[i].kind != TK_ERA;
+    }
+
+    if(inst->u.dt.weekday && !have_wday) {
+        emit_weekday(&pb, inst, st);
+        if(kept)
+            pb_lit(&pb, L", ");
+    }
+    emit_pattern(&pb, tok, n, emit_date_tok, &de);
+    if(inst->u.dt.era && !have_era) {
+        pb_lit(&pb, L" ");
+        pb_tok(&pb, 'g', 2);
+    }
+    pb_flush(&pb);
+}
+
+struct time_emit {
+    const IntlInstance *inst;
+    BOOL want12, two_digit_24;
+};
+
+static void emit_time_tok(picbuf_t *pb, const ptoken_t *t, void *ctx)
+{
+    struct time_emit *te = ctx;
+    const IntlInstance *inst = te->inst;
+    BOOL two;
+
+    switch(t->kind) {
+    case TK_HOUR12: case TK_HOUR24:
+        two = inst->u.dt.hour == 1;
+        if(inst->u.dt.hour == 2)  /* numeric */
+            two = !te->want12 && te->two_digit_24;
+        pb_tok(pb, te->want12 ? 'h' : 'H', two ? 2 : 1);
+        break;
+    case TK_MIN:
+        pb_tok(pb, 'm', inst->u.dt.hour || inst->u.dt.minute == 1 ? 2 : 1);
+        break;
+    case TK_SEC:
+        pb_tok(pb, 's', inst->u.dt.minute || inst->u.dt.second == 1 ? 2 : 1);
+        break;
+    case TK_MARK:
+        pb_tok(pb, 't', 2);
+        break;
+    }
+}
+
+static void build_time_picture(const IntlInstance *inst, WCHAR *pic, size_t size)
+{
+    WCHAR base[80];
+    ptoken_t tok[MAX_TOKENS];
+    struct time_emit te = { inst };
+    picbuf_t pb = { pic, size };
+    unsigned n, i;
+    BOOL have_mark = FALSE;
+
+    pic[0] = 0;
+    if(!inst->u.dt.hour && !inst->u.dt.minute && !inst->u.dt.second)
+        return;
+
+    if(!GetLocaleInfoEx(inst->locale, LOCALE_STIMEFORMAT, base, ARRAY_SIZE(base)))
+        wcscpy(base, L"h:mm:ss tt");
+    n = parse_pattern(base, tok);
+    te.want12 = inst->u.dt.hour && inst->u.dt.hour12;
+    for(i = 0; i < n; i++) {
+        if(tok[i].kind == TK_HOUR24 && tok[i].len > 1) te.two_digit_24 = TRUE;
+        if(tok[i].kind == TK_MARK) have_mark = TRUE;
+    }
+
+    for(i = 0; i < n; i++) {
+        switch(tok[i].kind) {
+        case TK_HOUR12: case TK_HOUR24: tok[i].drop = !inst->u.dt.hour; break;
+        case TK_MIN:    tok[i].drop = !inst->u.dt.minute; break;
+        case TK_SEC:    tok[i].drop = !inst->u.dt.second; break;
+        case TK_MARK:   tok[i].drop = !te.want12; break;
+        }
+    }
+    emit_pattern(&pb, tok, n, emit_time_tok, &te);
+    if(te.want12 && !have_mark) {
+        pb_lit(&pb, L" ");
+        pb_tok(&pb, 't', 2);
+    }
+    pb_flush(&pb);
+}
+
+
+static HRESULT format_datetime(script_ctx_t *ctx, IntlInstance *inst, double time, jsstr_t **ret)
+{
+    WCHAR datepic[200] = L"", timepic[200] = L"", date[200] = L"", tm[200] = L"", out[500] = L"";
+    WCHAR tzname[80] = L"";
+    SYSTEMTIME st;
+
+    if(!intl_time_to_systemtime(time, inst->u.dt.utc, &st, inst->u.dt.tzname, tzname, ARRAY_SIZE(tzname)))
+        return throw_error(ctx, JS_E_INTL_BAD_DATE, NULL);
+
+    build_date_picture(inst, &st, datepic, ARRAY_SIZE(datepic));
+    build_time_picture(inst, timepic, ARRAY_SIZE(timepic));
+
+    if(datepic[0] && !GetDateFormatEx(inst->locale, 0, &st, datepic, date, ARRAY_SIZE(date), NULL))
+        return E_FAIL;
+    if(timepic[0] && !GetTimeFormatEx(inst->locale, 0, &st, timepic, tm, ARRAY_SIZE(tm)))
+        return E_FAIL;
+
+    append_str(out, ARRAY_SIZE(out), date);
+    if(date[0] && tm[0])
+        append_str(out, ARRAY_SIZE(out), L" ");
+    append_str(out, ARRAY_SIZE(out), tm);
+    if(tzname[0]) {
+        if(out[0])
+            append_str(out, ARRAY_SIZE(out), L" ");
+        append_str(out, ARRAY_SIZE(out), tzname);
+    }
+    *ret = jsstr_alloc(out);
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT DateTimeFormat_format_fn(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc,
+        jsval_t *argv, jsval_t *r)
+{
+    IntlInstance *inst;
+    jsstr_t *str;
+    double t;
+    HRESULT hres = S_OK;
+
+    if(!(inst = intl_this(ctx, vthis, JSCLASS_INTL_DATETIMEFORMAT, L"DateTimeFormat", &hres)))
+        return hres;
+    if(!argc || is_undefined(argv[0]))
+        t = intl_current_time();
+    else {
+        hres = to_number(ctx, argv[0], &t);
+        if(FAILED(hres))
+            return hres;
+    }
+    hres = format_datetime(ctx, inst, t, &str);
+    if(FAILED(hres))
+        return hres;
+    if(r)
+        *r = jsval_string(str);
+    else
+        jsstr_release(str);
+    return S_OK;
+}
+
+static HRESULT DateTimeFormat_resolvedOptions(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc,
+        jsval_t *argv, jsval_t *r)
+{
+    IntlInstance *inst;
+    jsdisp_t *obj;
+    HRESULT hres = S_OK;
+
+    if(!(inst = intl_this(ctx, vthis, JSCLASS_INTL_DATETIMEFORMAT, L"DateTimeFormat", &hres)))
+        return hres;
+    if(!r)
+        return S_OK;
+    hres = create_object(ctx, NULL, &obj);
+    if(FAILED(hres))
+        return hres;
+    hres = str_prop(ctx, obj, L"locale", inst->locale);
+    if(SUCCEEDED(hres)) hres = str_prop(ctx, obj, L"calendar", L"gregory");
+    if(SUCCEEDED(hres)) hres = str_prop(ctx, obj, L"numberingSystem", L"latn");
+    if(SUCCEEDED(hres) && inst->u.dt.utc) hres = str_prop(ctx, obj, L"timeZone", L"UTC");
+    if(SUCCEEDED(hres) && inst->u.dt.hour) hres = bool_prop(ctx, obj, L"hour12", inst->u.dt.hour12);
+    if(SUCCEEDED(hres) && inst->u.dt.weekday) hres = str_prop(ctx, obj, L"weekday", nsl_values[inst->u.dt.weekday - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.era) hres = str_prop(ctx, obj, L"era", nsl_values[inst->u.dt.era - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.year) hres = str_prop(ctx, obj, L"year", year_values[inst->u.dt.year - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.month) hres = str_prop(ctx, obj, L"month", month_values[inst->u.dt.month - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.day) hres = str_prop(ctx, obj, L"day", num_values[inst->u.dt.day - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.hour) hres = str_prop(ctx, obj, L"hour", num_values[inst->u.dt.hour - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.minute) hres = str_prop(ctx, obj, L"minute", num_values[inst->u.dt.minute - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.second) hres = str_prop(ctx, obj, L"second", num_values[inst->u.dt.second - 1]);
+    if(SUCCEEDED(hres) && inst->u.dt.tzname) hres = str_prop(ctx, obj, L"timeZoneName", tzname_values[inst->u.dt.tzname - 1]);
+    if(FAILED(hres)) {
+        jsdisp_release(obj);
+        return hres;
+    }
+    *r = jsval_obj(obj);
+    return S_OK;
+}
