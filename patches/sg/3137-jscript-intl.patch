+/* Defines the bound compare/format function as a property of the instance. */
+static HRESULT define_bound(script_ctx_t *ctx, IntlInstance *inst, const WCHAR *name, builtin_invoke_t proc,
+        unsigned length)
+{
+    jsdisp_t *fn;
+    jsval_t this_val, ret;
+    HRESULT hres;
+
+    hres = create_builtin_function(ctx, proc, L"", NULL, PROPF_METHOD | length, NULL, &fn);
+    if(FAILED(hres))
+        return hres;
+    this_val = jsval_obj(&inst->dispex);
+    hres = jsdisp_call_name(fn, L"bind", DISPATCH_METHOD, 1, &this_val, &ret);
+    jsdisp_release(fn);
+    if(FAILED(hres))
+        return hres;
+    hres = jsdisp_define_data_property(&inst->dispex, name, PROPF_CONFIGURABLE, ret);
+    jsval_release(ret);
+    return hres;
+}
