+static const builtin_prop_t Collator_prototype_props[] = {
+    {L"resolvedOptions",  Collator_resolvedOptions,  PROPF_METHOD},
+};
+
+static const builtin_info_t Collator_prototype_info = {
+    .class     = JSCLASS_OBJECT,
+    .props_cnt = ARRAY_SIZE(Collator_prototype_props),
+    .props     = Collator_prototype_props,
+};
