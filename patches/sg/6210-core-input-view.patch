+/*
+ * The view of the on-screen input panels (touch keyboard, handwriting, emoji) for a thread's view:
+ * one object per thread, for its life.  No such panel is shown over a program here, so nothing
+ * occludes the view (an empty list), showing or hiding one is not done (FALSE), and the events are
+ * accepted and never raised.  React Native for Windows asks for it when it makes a text input.
+ * Interface identity per windows-rs 0.30.0 (MIT).
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+static const GUID IID_ICoreInputView_sg = { 0xc770cd7a, 0x7001, 0x4c32, { 0xbf, 0x94, 0x25, 0xc1, 0xf5, 0x54, 0xcb, 0xf1 } };
+static const GUID IID_ICoreInputView2_sg = { 0x0ed726c1, 0xe09a, 0x4ae8, { 0xae, 0xdf, 0xdf, 0xa4, 0x85, 0x7d, 0x1a, 0x01 } };
+static const GUID IID_ICoreInputView3_sg = { 0xbc941653, 0x3ab9, 0x4849, { 0x8f, 0x58, 0x46, 0xe7, 0xf0, 0x35, 0x3c, 0xfc } };
+static const GUID IID_ICoreInputView4_sg = { 0x002863d6, 0xd9ef, 0x57eb, { 0x8c, 0xef, 0x77, 0xf6, 0xce, 0x1b, 0x7e, 0xe7 } };
+static const GUID IID_ICoreInputView5_sg = { 0x136316e0, 0xc6d5, 0x5c57, { 0x81, 0x1e, 0x1a, 0xd8, 0xa9, 0x9b, 0xa6, 0xab } };
+static const GUID IID_ICoreInputViewStatics_sg = { 0x7d9b97cd, 0xedbe, 0x49cf, { 0xa5, 0x4f, 0x33, 0x7d, 0xe0, 0x52, 0x90, 0x7f } };
+static const GUID IID_ICoreInputViewStatics2_sg = { 0x7ebc0862, 0xd049, 0x4e52, { 0x87, 0xb0, 0x1e, 0x90, 0xe9, 0x8c, 0x49, 0xed } };
+static const GUID IID_IVectorView_Occlusion = { 0xe0963578, 0xa246, 0x5680, { 0x86, 0xd1, 0x27, 0x51, 0x94, 0x23, 0xe2, 0x12 } };
+static const GUID IID_IIterable_Occlusion = { 0x0a11958b, 0x63da, 0x5566, { 0x91, 0x3a, 0x18, 0x05, 0x50, 0xda, 0xd2, 0x6a } };
+static const GUID IID_IIterator_Occlusion = { 0x5bb57354, 0x4f40, 0x5ef3, { 0xa5, 0xd1, 0x6a, 0x60, 0x49, 0xf9, 0x05, 0xa1 } };
+
+static LONG next_token;
+
+/* ---- the empty list of occlusions (one static object; its iterator too) ---- */
+
+static HRESULT WINAPI none_QueryInterface( void *iface, REFIID iid, void **out );
+static ULONG WINAPI none_AddRef( void *iface ) { return 2; }
+static ULONG WINAPI none_Release( void *iface ) { return 1; }
+static HRESULT WINAPI none_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI none_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.Foundation.Collections.IVectorView`1<Windows.UI.ViewManagement.Core.CoreInputViewOcclusion>", name );
+}
+static HRESULT WINAPI none_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI none_GetAt( void *iface, UINT32 index, IInspectable **value ) { if (value) *value = NULL; return E_BOUNDS; }
+static HRESULT WINAPI none_get_Size( void *iface, UINT32 *value ) { if (!value) return E_POINTER; *value = 0; return S_OK; }
+static HRESULT WINAPI none_IndexOf( void *iface, IInspectable *item, UINT32 *index, boolean *found )
+{
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI none_GetMany( void *iface, UINT32 start, UINT32 size, IInspectable **items, UINT32 *count )
+{
+    if (!count) return E_POINTER;
+    *count = 0;
+    return start ? E_BOUNDS : S_OK;
+}
+static const void *none_view_vtbl[] =
+{
+    none_QueryInterface, none_AddRef, none_Release, none_GetIids, none_GetRuntimeClassName, none_GetTrustLevel,
+    none_GetAt, none_get_Size, none_IndexOf, none_GetMany,
+};
+
+static HRESULT WINAPI none_First( void *iface, void **out );
+static const void *none_iterable_vtbl[] =
+{
+    none_QueryInterface, none_AddRef, none_Release, none_GetIids, none_GetRuntimeClassName, none_GetTrustLevel,
+    none_First,
+};
+
+static HRESULT WINAPI none_get_Current( void *iface, IInspectable **value ) { if (value) *value = NULL; return E_BOUNDS; }
+static HRESULT WINAPI none_get_HasCurrent( void *iface, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT WINAPI none_MoveNext( void *iface, boolean *value ) { if (!value) return E_POINTER; *value = FALSE; return S_OK; }
+static HRESULT WINAPI none_iter_GetMany( void *iface, UINT32 size, IInspectable **items, UINT32 *count )
+{
+    if (!count) return E_POINTER;
+    *count = 0;
+    return S_OK;
+}
+static const void *none_iterator_vtbl[] =
+{
+    none_QueryInterface, none_AddRef, none_Release, none_GetIids, none_GetRuntimeClassName, none_GetTrustLevel,
+    none_get_Current, none_get_HasCurrent, none_MoveNext, none_iter_GetMany,
+};
+
+static struct { const void *view, *iterable; } none = { none_view_vtbl, none_iterable_vtbl };
+static struct { const void *vtbl; } none_iterator = { none_iterator_vtbl };
+
+static HRESULT WINAPI none_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    if (iface == &none_iterator)
+    {
+        if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+            IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_Occlusion ))
+        {
+            *out = iface;
+            return S_OK;
+        }
+    }
+    else if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+             IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorView_Occlusion ))
+    {
+        *out = &none.view;
+        return S_OK;
+    }
+    else if (IsEqualGUID( iid, &IID_IIterable_Occlusion ))
+    {
+        *out = &none.iterable;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI none_First( void *iface, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = &none_iterator;
+    return S_OK;
+}
+
+/* ---- the view ---- */
+
+struct input_view
+{
+    const void *vtbl, *view2_vtbl, *view3_vtbl, *view4_vtbl, *view5_vtbl;
+    const void *weak_source_vtbl, *weak_vtbl;   /* held weakly: always resolves, it is never freed */
+    LONG ref;
+};
+
+static DWORD view_tls = TLS_OUT_OF_INDEXES;
+
+static struct input_view *view_from( void *iface, size_t offset )
+{
+    return (struct input_view *)((char *)iface - offset);
+}
+
+#define FROM_V(iface) view_from( iface, offsetof(struct input_view, vtbl) )
+#define FROM_V2(iface) view_from( iface, offsetof(struct input_view, view2_vtbl) )
+#define FROM_V3(iface) view_from( iface, offsetof(struct input_view, view3_vtbl) )
+#define FROM_V4(iface) view_from( iface, offsetof(struct input_view, view4_vtbl) )
+#define FROM_V5(iface) view_from( iface, offsetof(struct input_view, view5_vtbl) )
+#define FROM_WS(iface) view_from( iface, offsetof(struct input_view, weak_source_vtbl) )
+#define FROM_W(iface) view_from( iface, offsetof(struct input_view, weak_vtbl) )
+
+static const GUID IID_IWeakReferenceSource_civ = { 0x00000038, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+static const GUID IID_IWeakReference_civ = { 0x00000037, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+
+static HRESULT view_qi( struct input_view *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICoreInputView_sg ))
+        *out = &impl->vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreInputView2_sg )) *out = &impl->view2_vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreInputView3_sg )) *out = &impl->view3_vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreInputView4_sg )) *out = &impl->view4_vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreInputView5_sg )) *out = &impl->view5_vtbl;
+    else if (IsEqualGUID( iid, &IID_IWeakReferenceSource_civ )) *out = &impl->weak_source_vtbl;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG view_addref( struct input_view *impl ) { return InterlockedIncrement( &impl->ref ); }
+static ULONG view_release( struct input_view *impl ) { return InterlockedDecrement( &impl->ref ); }   /* the thread's for life */
+
+#define VIEW_BASE(prefix, from) \
+static HRESULT WINAPI prefix##_QueryInterface( void *iface, REFIID iid, void **out ) { return view_qi( from( iface ), iid, out ); } \
+static ULONG WINAPI prefix##_AddRef( void *iface ) { return view_addref( from( iface ) ); } \
+static ULONG WINAPI prefix##_Release( void *iface ) { return view_release( from( iface ) ); } \
+static HRESULT WINAPI prefix##_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName( void *iface, HSTRING *name ) \
+{ return inspectable_name( L"Windows.UI.ViewManagement.Core.CoreInputView", name ); } \
+static HRESULT WINAPI prefix##_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+#define BASE_METHODS(prefix) \
+    prefix##_QueryInterface, prefix##_AddRef, prefix##_Release, prefix##_GetIids, prefix##_GetRuntimeClassName, prefix##_GetTrustLevel
+
+VIEW_BASE(v, FROM_V)
+VIEW_BASE(v2, FROM_V2)
+VIEW_BASE(v3, FROM_V3)
+VIEW_BASE(v4, FROM_V4)
+VIEW_BASE(v5, FROM_V5)
+
+static HRESULT WINAPI ws_QueryInterface( void *iface, REFIID iid, void **out ) { return view_qi( FROM_WS( iface ), iid, out ); }
+static ULONG WINAPI ws_AddRef( void *iface ) { return view_addref( FROM_WS( iface ) ); }
+static ULONG WINAPI ws_Release( void *iface ) { return view_release( FROM_WS( iface ) ); }
+static HRESULT WINAPI ws_GetWeakReference( void *iface, void **out )
+{
+    struct input_view *impl = FROM_WS( iface );
+
+    if (!out) return E_POINTER;
+    view_addref( impl );
+    *out = &impl->weak_vtbl;
+    return S_OK;
+}
+static const void *weak_source_vtbl[] = { ws_QueryInterface, ws_AddRef, ws_Release, ws_GetWeakReference };
+
+static HRESULT WINAPI w_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IWeakReference_civ ))
+    {
+        view_addref( FROM_W( iface ) );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI w_AddRef( void *iface ) { return view_addref( FROM_W( iface ) ); }
+static ULONG WINAPI w_Release( void *iface ) { return view_release( FROM_W( iface ) ); }
+static HRESULT WINAPI w_Resolve( void *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    return view_qi( FROM_W( iface ), iid, out );
+}
+static const void *weak_vtbl[] = { w_QueryInterface, w_AddRef, w_Release, w_Resolve };
+
+static HRESULT WINAPI add_event( void *iface, IUnknown *handler, EventRegistrationToken *token )
+{
+    if (!handler || !token) return E_POINTER;
+    token->value = InterlockedIncrement( &next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI remove_event( void *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI v_GetCoreInputViewOcclusions( void *iface, void **value )
+{
+    if (!value) return E_POINTER;
+    *value = &none.view;
+    return S_OK;
+}
+
+/* TryShowPrimaryView, TryHidePrimaryView, TryShow, TryHide: no panel to show or hide */
+static HRESULT WINAPI v_not_done( void *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI v_not_done_kind( void *iface, INT32 kind, boolean *value )
+{
+    return v_not_done( iface, value );
+}
+
+struct civ_rect { FLOAT x, y, w, h; };
+
+static HRESULT WINAPI v2_TryTransferXYFocusToPrimaryView( void *iface, struct civ_rect origin, INT32 direction,
+                                                          boolean *value )
+{
+    return v_not_done( iface, value );
+}
+
+static const void *view_vtbl[] =
+{
+    BASE_METHODS(v), add_event, remove_event, v_GetCoreInputViewOcclusions, v_not_done, v_not_done,
+};
+static const void *view2_vtbl[] =
+{
+    BASE_METHODS(v2), add_event, remove_event, add_event, remove_event, v2_TryTransferXYFocusToPrimaryView,
+};
+static const void *view3_vtbl[] = { BASE_METHODS(v3), v_not_done, v_not_done_kind, v_not_done };
+static const void *view4_vtbl[] = { BASE_METHODS(v4), add_event, remove_event, add_event, remove_event };
+static const void *view5_vtbl[] = { BASE_METHODS(v5), v_not_done_kind, add_event, remove_event };
+C_ASSERT( ARRAY_SIZE(view_vtbl) == 11 );
+C_ASSERT( ARRAY_SIZE(view2_vtbl) == 11 );
+C_ASSERT( ARRAY_SIZE(view3_vtbl) == 9 );
+C_ASSERT( ARRAY_SIZE(view4_vtbl) == 10 );
+C_ASSERT( ARRAY_SIZE(view5_vtbl) == 9 );
+
+/* ---- the statics ---- */
+
+static HRESULT current_view( IInspectable **out )
+{
+    struct input_view *impl;
+
+    if (!out) return E_POINTER;
+#ifdef SG_MUTANT_NO_CORE_INPUT_VIEW
+    return E_NOTIMPL;
+#endif
+    if (view_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&view_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES)
+            TlsFree( index );
+    }
+    if (!(impl = TlsGetValue( view_tls )))
+    {
+        if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+        impl->vtbl = view_vtbl;
+        impl->view2_vtbl = view2_vtbl;
+        impl->view3_vtbl = view3_vtbl;
+        impl->view4_vtbl = view4_vtbl;
+        impl->view5_vtbl = view5_vtbl;
+        impl->weak_source_vtbl = weak_source_vtbl;
+        impl->weak_vtbl = weak_vtbl;
+        impl->ref = 1;   /* the thread's */
+        TlsSetValue( view_tls, impl );
+    }
+    view_addref( impl );
+    *out = (IInspectable *)&impl->vtbl;
+    return S_OK;
+}
+
+struct view_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    const void *statics_vtbl, *statics2_vtbl;
+};
+
+static struct view_factory *factory_from( void *iface, size_t offset )
+{
+    return (struct view_factory *)((char *)iface - offset);
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct view_factory *impl = CONTAINING_RECORD( iface, struct view_factory, IActivationFactory_iface );
+
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICoreInputViewStatics_sg )) *out = &impl->statics_vtbl;
+    else if (IsEqualGUID( iid, &IID_ICoreInputViewStatics2_sg )) *out = &impl->statics2_vtbl;
+    if (*out) return S_OK;
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return inspectable_name( L"Windows.UI.ViewManagement.Core.CoreInputView", name );
+}
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const IActivationFactoryVtbl view_factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release, factory_GetIids, factory_GetRuntimeClassName,
+    factory_GetTrustLevel, factory_ActivateInstance,
+};
+
+#define STATICS_BASE(prefix, member) \
+static HRESULT WINAPI prefix##_QueryInterface( void *iface, REFIID iid, void **out ) \
+{ return factory_QueryInterface( &factory_from( iface, offsetof(struct view_factory, member) )->IActivationFactory_iface, iid, out ); } \
+static ULONG WINAPI prefix##_AddRef( void *iface ) { return 2; } \
+static ULONG WINAPI prefix##_Release( void *iface ) { return 1; } \
+static HRESULT WINAPI prefix##_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName( void *iface, HSTRING *name ) \
+{ return inspectable_name( L"Windows.UI.ViewManagement.Core.CoreInputView", name ); } \
+static HRESULT WINAPI prefix##_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+STATICS_BASE(s1, statics_vtbl)
+STATICS_BASE(s2, statics2_vtbl)
+
+static HRESULT WINAPI s1_GetForCurrentView( void *iface, IInspectable **out )
+{
+    TRACE( "%p\n", out );
+    return current_view( out );
+}
+
+static HRESULT WINAPI s2_GetForUIContext( void *iface, IInspectable *context, IInspectable **out )
+{
+    TRACE( "%p, %p\n", context, out );
+    return current_view( out );
+}
+
+static const void *statics_vtbl[] = { BASE_METHODS(s1), s1_GetForCurrentView };
+static const void *statics2_vtbl[] = { BASE_METHODS(s2), s2_GetForUIContext };
+
+static struct view_factory view_factory_obj = { { &view_factory_vtbl }, statics_vtbl, statics2_vtbl };
+IActivationFactory *core_input_view_factory = &view_factory_obj.IActivationFactory_iface;
