+/* the header shows which column the view is sorted by, and which way */
+static void ShellView_UpdateSortArrow(IShellViewImpl *This)
+{
+    HWND header = (HWND)SendMessageW(This->hWndList, LVM_GETHEADER, 0, 0);
+    int i, count, sorted = This->ListViewSortInfo.nHeaderID < 0 ? 0 : This->ListViewSortInfo.nHeaderID;
+    HDITEMW item;
 
+    if (!header) return;
+    count = SendMessageW(header, HDM_GETITEMCOUNT, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        item.mask = HDI_FORMAT;
+        if (!SendMessageW(header, HDM_GETITEMW, i, (LPARAM)&item)) continue;
+        item.fmt &= ~(HDF_SORTUP | HDF_SORTDOWN);
+        if (i == sorted) item.fmt |= This->ListViewSortInfo.bIsAscending ? HDF_SORTUP : HDF_SORTDOWN;
+        SendMessageW(header, HDM_SETITEMW, i, (LPARAM)&item);
+    }
+}
+
+static void ShellView_Sort(IShellViewImpl *This)
+{
+    This->ListViewSortInfo.view = This;
+    SendMessageW(This->hWndList, LVM_SORTITEMS, (WPARAM)&This->ListViewSortInfo, (LPARAM)ShellView_ListViewCompareItems);
+    ShellView_UpdateSortArrow(This);
 }
 
