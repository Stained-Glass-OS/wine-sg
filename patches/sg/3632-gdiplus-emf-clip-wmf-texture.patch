-    FIXME("stub: %p, %p, %p, %p, %u, %p, %p\n", refGraphics, metafile, conversionSuccess, filename, emfType, description, out_metafile);
+    TRACE("(%p,%p,%p,%s,%u,%s,%p)\n", refGraphics, metafile, conversionSuccess, debugstr_w(filename),
+            emfType, debugstr_w(description), out_metafile);
