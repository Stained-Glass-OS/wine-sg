+        set_rect(&frame, pFrameRect->X, pFrameRect->Y, pFrameRect->Width, pFrameRect->Height);
+        return GdipRecordMetafileFileName(fileName, hdc, type, &frame, frameUnit, desc, metafile);
+    }
+
+    return GdipRecordMetafileFileName(fileName, hdc, type, NULL, frameUnit, desc, metafile);
 }
 
