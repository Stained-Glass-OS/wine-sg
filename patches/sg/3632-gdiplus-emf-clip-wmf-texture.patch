@@ -4750,10 +4814,21 @@ GpStatus WINGDIPAPI GdipRecordMetafileFileNameI(GDIPCONST WCHAR* fileName, HDC h
                             GDIPCONST GpRect *pFrameRect, MetafileFrameUnit frameUnit,
