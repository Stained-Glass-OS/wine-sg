From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: EMF-only clip recording, EmfToWmfBits, record/convert to file, metafile texture brushes (3632)

gdiplus: EMF-only clip recording, EmfToWmfBits, record/convert to file, metafile texture brushes

gdiplus: EMF-only recording accepts SetClipRegion/Path, ResetClip, OffsetClip, SetRenderingOrigin (the GDI half carries the state); GdipEmfToWmfBits (GetWinMetaFileBits + optional placeable header); GdipRecordMetafileFileNameI; GdipConvertToEmfPlusToFile; metafile texture brushes (GdipCreateTextureIA draws the metafile into a bitmap). Gate fastb-gapgdip; mutants SG_MUTANT_GP_EMFCLIP, GP_WMF, GP_FNI, GP_CONV, GP_TEX. Careful (Office): EmfToWmfBits return value is the byte count as in the GDI+ docs, unverified against Windows. All five mutants shown caught.
---
diff --git a/dlls/gdiplus/brush.c b/dlls/gdiplus/brush.c
index ad2a7fa..0f6235e 100644
--- a/dlls/gdiplus/brush.c
+++ b/dlls/gdiplus/brush.c
@@ -857,6 +857,35 @@ GpStatus WINGDIPAPI GdipCreateTextureIA(GpImage *image,
 
     *texture = NULL;
 
+#ifndef SG_MUTANT_GP_TEX
+    if(image->type == ImageTypeMetafile){
+        /* A metafile texture is the metafile drawn into a bitmap of its size. */
+        GpBitmap *bitmap;
+        GpGraphics *graphics;
+        UINT image_width, image_height;
+
+        GdipGetImageWidth(image, &image_width);
+        GdipGetImageHeight(image, &image_height);
+        if (!image_width || !image_height)
+            return InvalidParameter;
+
+        status = GdipCreateBitmapFromScan0(image_width, image_height, 0, PixelFormat32bppARGB, NULL, &bitmap);
+        if (status != Ok)
+            return status;
+
+        status = GdipGetImageGraphicsContext((GpImage *)bitmap, &graphics);
+        if (status == Ok)
+        {
+            status = GdipDrawImageRectI(graphics, image, 0, 0, image_width, image_height);
+            GdipDeleteGraphics(graphics);
+        }
+        if (status == Ok)
+            status = GdipCreateTextureIA((GpImage *)bitmap, imageattr, x, y, width, height, texture);
+        GdipDisposeImage((GpImage *)bitmap);
+        return status;
+    }
+#endif
+
     if(image->type != ImageTypeBitmap){
         FIXME("not implemented for image type %d\n", image->type);
         return NotImplemented;
