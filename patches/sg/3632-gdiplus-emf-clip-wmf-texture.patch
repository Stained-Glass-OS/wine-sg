+        const WCHAR *description, const WCHAR *filename, GpMetafile **out)
 {
     GpMetafile *recorded;
     GpGraphics *graphics;
@@ -4573,7 +4572,7 @@ static GpStatus convert_to_emfplus(const GpGraphics *ref, GpMetafile *metafile,
     frame.Y = header.Y;
     frame.Width = header.Width;
     frame.Height = header.Height;
-    stat = GdipRecordMetafile(ref_dc, type, &frame, MetafileFrameUnitPixel, description, &recorded);
+    stat = GdipRecordMetafileFileName(filename, ref_dc, type, &frame, MetafileFrameUnitPixel, description, &recorded);
     DeleteDC(ref_dc);
     if (stat != Ok)
         return stat;
@@ -4625,14 +4624,79 @@ GpStatus WINGDIPAPI GdipConvertToEmfPlus(const GpGraphics* ref,
         *succ = FALSE;
     *out_metafile = NULL;
 
-    return convert_to_emfplus(ref, metafile, succ, emfType, description, out_metafile);
