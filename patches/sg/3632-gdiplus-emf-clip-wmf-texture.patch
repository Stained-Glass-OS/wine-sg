+#pragma pack(push,1)
+struct placeable_wmf_header
+{
+    DWORD key;
+    WORD hmf;
+    SHORT left, top, right, bottom;
+    WORD inch;
+    DWORD reserved;
+    WORD checksum;
+};
+#pragma pack(pop)
+
+/* Returns the number of bytes of the Windows metafile (the size needed when
+ * the buffer is NULL), or 0 on failure, like the Metafile::EmfToWmfBits
+ * documentation describes. */
 GpStatus WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
     LPBYTE pData16, INT iMapMode, INT eFlags)
 {
-    FIXME("(%p, %d, %p, %d, %d): stub\n", hemf, cbData16, pData16, iMapMode, eFlags);
-    return NotImplemented;
+    const BOOL placeable = eFlags & 2; /* EmfToWmfBitsFlagsIncludePlaceable */
+    struct placeable_wmf_header header = {0};
+    ENHMETAHEADER emf_header;
+    UINT size, header_size = placeable ? sizeof(header) : 0;
+    HDC ref_dc;
+    WORD *w;
+    unsigned int i;
+
+    TRACE("(%p, %d, %p, %d, %d)\n", hemf, cbData16, pData16, iMapMode, eFlags);
+
+#ifdef SG_MUTANT_GP_WMF
+    return 0;
+#endif
+    if (!hemf || !GetEnhMetaFileHeader(hemf, sizeof(emf_header), &emf_header))
+        return 0;
+
+    if (!(ref_dc = CreateCompatibleDC(0)))
+        return 0;
+
+    if (!pData16)
+    {
+        size = GetWinMetaFileBits(hemf, 0, NULL, iMapMode, ref_dc);
+        DeleteDC(ref_dc);
+        return size ? size + header_size : 0;
+    }
+
+    if (cbData16 < header_size)
+    {
+        DeleteDC(ref_dc);
+        return 0;
+    }
+
+    size = GetWinMetaFileBits(hemf, cbData16 - header_size, pData16 + header_size, iMapMode, ref_dc);
+    DeleteDC(ref_dc);
+    if (!size)
+        return 0;
+
+    if (placeable)
+    {
+        /* The frame is in 0.01 mm; the placeable header counts 1440 units per inch. */
+        header.key = 0x9ac6cdd7;
+        header.inch = 1440;
+        header.left = MulDiv(emf_header.rclFrame.left, 1440, 2540);
+        header.top = MulDiv(emf_header.rclFrame.top, 1440, 2540);
+        header.right = MulDiv(emf_header.rclFrame.right, 1440, 2540);
+        header.bottom = MulDiv(emf_header.rclFrame.bottom, 1440, 2540);
+        for (i = 0, w = (WORD *)&header; i < 10; ++i)
+            header.checksum ^= w[i];
+        memcpy(pData16, &header, sizeof(header));
+    }
+
+    return size + header_size;
 }
 
