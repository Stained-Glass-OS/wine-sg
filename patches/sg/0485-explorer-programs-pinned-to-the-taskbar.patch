+/* Stained Glass OS: a pinned program's menu: start it, or unpin it */
+static void sg_pin_menu( int i, HWND button, LPARAM lparam )
+{
+    POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+    HMENU menu;
+    int cmd;
+
+    if (i >= sg_npins) return;
+    if (lparam == -1) { RECT rc; GetWindowRect( button, &rc ); pt.x = rc.left; pt.y = rc.top; }
+    menu = CreatePopupMenu();
+    AppendMenuW( menu, MF_STRING, SG_BTN_LAUNCH, sg_pins[i].name );
+    AppendMenuW( menu, MF_STRING, SG_BTN_UNPIN, L"Unpin from tas&kbar" );
+    SetForegroundWindow( tray_window );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON |
+                          (sg_bar.edge == ABE_TOP ? TPM_TOPALIGN : TPM_BOTTOMALIGN),
+                          pt.x, pt.y, 0, tray_window, NULL );
+    DestroyMenu( menu );
+    if (cmd == SG_BTN_LAUNCH) ShellExecuteW( NULL, NULL, sg_pins[i].lnk, NULL, NULL, SW_SHOWNORMAL );
+    else if (cmd == SG_BTN_UNPIN)
+    {
+        pins_remove( sg_pins[i].lnk );
+        sg_reload_pins();
+    }
+}
