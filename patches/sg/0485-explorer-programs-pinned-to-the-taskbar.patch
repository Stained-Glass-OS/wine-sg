+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#include <stdio.h>
+#include <stdlib.h>
+#include <windows.h>
+#include <shlobj.h>
+#include <shellapi.h>
+
+#include "wine/debug.h"
+#include "explorer_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(explorer);
+
+static const WCHAR pins_key[] = L"Software\\Stained Glass\\Taskbar";
+
+static BOOL pins_dir( WCHAR *dir )
+{
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_APPDATA | CSIDL_FLAG_CREATE, NULL, 0, dir ))) return FALSE;
+    lstrcatW( dir, L"\\Microsoft\\Internet Explorer\\Quick Launch\\User Pinned\\TaskBar" );
+    return TRUE;
+}
+
+/* the order: file names, one after another, ending in an empty one */
+static WCHAR *pins_order(void)
+{
+    DWORD size = 0;
+    WCHAR *order;
+
+    if (RegGetValueW( HKEY_CURRENT_USER, pins_key, L"PinOrder", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ) ||
+        !(order = calloc( 1, size + 2 * sizeof(WCHAR) )))
+        return calloc( 2, sizeof(WCHAR) );
+    RegGetValueW( HKEY_CURRENT_USER, pins_key, L"PinOrder", RRF_RT_REG_MULTI_SZ, NULL, order, &size );
+    return order;
+}
+
+static void pins_save_order( const struct taskbar_pin *pins, int count )
+{
+    WCHAR *order, *p;
+    DWORD size = sizeof(WCHAR);
+    HKEY key;
+    int i;
+
+    for (i = 0; i < count; i++) size += (lstrlenW( wcsrchr( pins[i].lnk, '\\' ) + 1 ) + 1) * sizeof(WCHAR);
+    if (!(p = order = calloc( 1, size ))) return;
+    for (i = 0; i < count; i++)
+    {
+        lstrcpyW( p, wcsrchr( pins[i].lnk, '\\' ) + 1 );
+        p += lstrlenW( p ) + 1;
+    }
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, pins_key, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+    {
+        RegSetValueExW( key, L"PinOrder", 0, REG_MULTI_SZ, (BYTE *)order, size );
+        RegCloseKey( key );
+    }
+    free( order );
+}
+
+static int order_index( const WCHAR *order, const WCHAR *name )
+{
+    int i = 0;
+    for (; *order; order += lstrlenW( order ) + 1, i++)
+        if (!wcsicmp( order, name )) return i;
+    return 0x10000;
+}
+
+static const WCHAR *sort_order;
+static int __cdecl compare_pins( const void *a, const void *b )
+{
+    const struct taskbar_pin *pa = a, *pb = b;
+    const WCHAR *na = wcsrchr( pa->lnk, '\\' ) + 1, *nb = wcsrchr( pb->lnk, '\\' ) + 1;
+    int ia = order_index( sort_order, na ), ib = order_index( sort_order, nb );
+    return ia != ib ? (ia < ib ? -1 : 1) : wcsicmp( na, nb );
+}
+
+/* what a shortcut starts, and its icon */
+static void resolve_pin( struct taskbar_pin *pin )
+{
+    IShellLinkW *link;
+    IPersistFile *file;
+    SHFILEINFOW info;
+
+    pin->target[0] = 0;
+    if (SUCCEEDED(CoCreateInstance( &CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&link )))
+    {
+        if (SUCCEEDED(IShellLinkW_QueryInterface( link, &IID_IPersistFile, (void **)&file )))
+        {
+            if (SUCCEEDED(IPersistFile_Load( file, pin->lnk, STGM_READ )))
+                IShellLinkW_GetPath( link, pin->target, MAX_PATH, NULL, 0 );
+            IPersistFile_Release( file );
+        }
+        IShellLinkW_Release( link );
+    }
+    lstrcpynW( pin->name, wcsrchr( pin->lnk, '\\' ) + 1, MAX_PATH );
+    if (wcsrchr( pin->name, '.' )) *wcsrchr( pin->name, '.' ) = 0;
+    pin->icon = 0;
+    if (SHGetFileInfoW( pin->lnk, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON )) pin->icon = info.hIcon;
+}
+
+void pins_free( struct taskbar_pin *pins, int count )
+{
+    int i;
+    for (i = 0; i < count; i++) if (pins[i].icon) DestroyIcon( pins[i].icon );
+    free( pins );
+}
+
+/* the pinned programs, in their order; *count of them */
+struct taskbar_pin *pins_load( int *count )
+{
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH];
+    struct taskbar_pin *pins = NULL, *grown;
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    int n = 0, max = 0;
+
+    *count = 0;
+    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    if (!pins_dir( dir )) return NULL;
+    swprintf( pattern, MAX_PATH, L"%s\\*.lnk", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) == INVALID_HANDLE_VALUE) return NULL;
+    do
+    {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        if (n == max)
+        {
+            max = max ? 2 * max : 8;
+            if (!(grown = realloc( pins, max * sizeof(*pins) ))) break;
+            pins = grown;
+        }
+        swprintf( pins[n].lnk, MAX_PATH, L"%s\\%s", dir, fd.cFileName );
+        resolve_pin( &pins[n] );
+        n++;
+    } while (FindNextFileW( find, &fd ));
+    FindClose( find );
+
+    sort_order = pins_order();
+    qsort( pins, n, sizeof(*pins), compare_pins );
+    free( (void *)sort_order );
+    *count = n;
+    return pins;
+}
+
+/* the pin that starts this program, or -1 */
+int pins_find( const struct taskbar_pin *pins, int count, const WCHAR *exe )
+{
+    int i;
+    if (!exe || !exe[0]) return -1;
+    for (i = 0; i < count; i++) if (pins[i].target[0] && !wcsicmp( pins[i].target, exe )) return i;
+    return -1;
+}
+
+/* pin a program: a shortcut named after it, last in the order */
+BOOL pins_add( const WCHAR *exe, const WCHAR *name )
+{
+    WCHAR dir[MAX_PATH], lnk[MAX_PATH], clean[MAX_PATH], *p;
+    struct taskbar_pin *pins;
+    IShellLinkW *link;
+    IPersistFile *file;
+    BOOL ret = FALSE;
+    int count;
+
+    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    if (!pins_dir( dir )) return FALSE;
+    SHCreateDirectoryExW( NULL, dir, NULL );
+    lstrcpynW( clean, name && name[0] ? name : wcsrchr( exe, '\\' ) ? wcsrchr( exe, '\\' ) + 1 : exe, MAX_PATH );
+    for (p = clean; *p; p++) if (wcschr( L"\\/:*?\"<>|", *p )) *p = '_';
+    swprintf( lnk, MAX_PATH, L"%s\\%s.lnk", dir, clean );
+    if (SUCCEEDED(CoCreateInstance( &CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&link )))
+    {
+        IShellLinkW_SetPath( link, exe );
+        if (wcsrchr( exe, '\\' ))
+        {
+            WCHAR work[MAX_PATH];
+            lstrcpynW( work, exe, MAX_PATH );
+            *wcsrchr( work, '\\' ) = 0;
+            IShellLinkW_SetWorkingDirectory( link, work );
+        }
+        if (SUCCEEDED(IShellLinkW_QueryInterface( link, &IID_IPersistFile, (void **)&file )))
+        {
+            ret = SUCCEEDED(IPersistFile_Save( file, lnk, TRUE ));
+            IPersistFile_Release( file );
+        }
+        IShellLinkW_Release( link );
+    }
+    if (ret && (pins = pins_load( &count )))
+    {
+        /* the new one goes last: it sorted in by name among those the order lacks */
+        int i, at = -1;
+        for (i = 0; i < count; i++) if (!wcsicmp( pins[i].lnk, lnk )) at = i;
+        if (at >= 0 && at != count - 1)
+        {
+            struct taskbar_pin moved = pins[at];
+            memmove( &pins[at], &pins[at + 1], (count - at - 1) * sizeof(*pins) );
+            pins[count - 1] = moved;
+        }
+        pins_save_order( pins, count );
+        pins_free( pins, count );
+    }
+    return ret;
+}
+
+/* unpin: the shortcut goes, and its place in the order */
+BOOL pins_remove( const WCHAR *lnk )
+{
+    struct taskbar_pin *pins;
+    int count;
+    BOOL ret = DeleteFileW( lnk );
+
+    if (!ret) ERR( "could not remove %s: %lu\n", debugstr_w(lnk), GetLastError() );
+
+    if ((pins = pins_load( &count )))
+    {
+        pins_save_order( pins, count );
+        pins_free( pins, count );
+    }
+    else pins_save_order( NULL, 0 );
+    return ret;
+}
