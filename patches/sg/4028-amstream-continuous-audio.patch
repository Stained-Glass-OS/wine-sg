From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] amstream: Continuous updates of audio stream samples.

IAudioStreamSample::Update takes SSUPDATE_CONTINUOUS (with
SSUPDATE_ASYNC), as the DirectDraw stream samples already did: each time
the sample is filled it is signalled and queued again, until a
CompletionStatus wait or abort ends it.
---
 dlls/amstream/audiostream.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/dlls/amstream/audiostream.c b/dlls/amstream/audiostream.c
index c8331a0..0b59177 100644
--- a/dlls/amstream/audiostream.c
+++ b/dlls/amstream/audiostream.c
@@ -83,6 +83,7 @@ struct audio_sample
     BYTE *pointer;
     DWORD position;
     HRESULT update_hr;
+    BOOL continuous_update;
 };
 
 static void remove_queued_receive(struct queued_receive *receive)
@@ -158,7 +159,21 @@ static void process_updates(struct audio_stream *stream)
         process_update(sample, receive);
 
         if (sample->update_hr != MS_S_PENDING)
+        {
+            BOOL again = sample->continuous_update && SUCCEEDED(sample->update_hr);
+            HANDLE event = sample->external_event;
+
             remove_queued_update(sample);
+            if (again)
+            {
+                /* SSUPDATE_CONTINUOUS: signal, then fill the sample again */
+                sample->external_event = event;
+                sample->position = 0;
+                sample->update_hr = MS_S_PENDING;
+                ResetEvent(sample->update_event);
+                list_add_tail(&stream->update_queue, &sample->entry);
+            }
+        }
         if (receive->position == receive->length)
             remove_queued_receive(receive);
     }
@@ -296,7 +311,7 @@ static HRESULT WINAPI audio_sample_Update(IAudioStreamSample *iface,
     if (event && apc_func)
         return E_INVALIDARG;
 
-    if (flags & ~SSUPDATE_ASYNC)
+    if (flags & ~(SSUPDATE_ASYNC | SSUPDATE_CONTINUOUS))
     {
         FIXME("Unsupported flags %#lx.\n", flags);
         return E_NOTIMPL;
@@ -333,6 +348,7 @@ static HRESULT WINAPI audio_sample_Update(IAudioStreamSample *iface,
         sample->apc_data = apc_data;
     }
     sample->external_event = event;
+    sample->continuous_update = (flags & SSUPDATE_ASYNC) && (flags & SSUPDATE_CONTINUOUS);
 
     sample->length = length;
     sample->pointer = pointer;
@@ -376,6 +392,8 @@ static HRESULT WINAPI audio_sample_CompletionStatus(IAudioStreamSample *iface, D
 #endif
         if (flags & COMPSTAT_WAIT)
         {
+            /* waiting ends a continuous update after the current one */
+            sample->continuous_update = FALSE;
             LeaveCriticalSection(&sample->parent->cs);
             WaitForSingleObject(sample->update_event, milliseconds);
             EnterCriticalSection(&sample->parent->cs);
