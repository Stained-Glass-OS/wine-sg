From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 21:05:30 -0700
Subject: [PATCH] inetcomm: class factory LockServer is not a stub

The inetcomm, IMAP, POP3 and SMTP class factories keep no per-factory lock
state (the DLL is unloaded through DllCanUnloadNow); LockServer logs and
succeeds instead of reporting itself as a stub.

diff --git a/dlls/inetcomm/imaptransport.c b/dlls/inetcomm/imaptransport.c
index 27ed5b3..4a32c33 100644
--- a/dlls/inetcomm/imaptransport.c
+++ b/dlls/inetcomm/imaptransport.c
@@ -491,7 +491,7 @@ static HRESULT WINAPI IMAPTransportCF_CreateInstance(IClassFactory *iface,
 
 static HRESULT WINAPI IMAPTransportCF_LockServer(IClassFactory *iface, BOOL fLock)
 {
-    FIXME("(%d), stub!\n",fLock);
+    TRACE("(%d)\n", fLock);
     return S_OK;
 }
 
diff --git a/dlls/inetcomm/inetcomm_main.c b/dlls/inetcomm/inetcomm_main.c
index ad02f21..492f8bb 100644
--- a/dlls/inetcomm/inetcomm_main.c
+++ b/dlls/inetcomm/inetcomm_main.c
@@ -131,7 +131,7 @@ static HRESULT WINAPI cf_CreateInstance( IClassFactory *iface, LPUNKNOWN pOuter,
 
 static HRESULT WINAPI cf_LockServer( IClassFactory *iface, BOOL dolock)
 {
-    FIXME("(%p)->(%d),stub!\n",iface,dolock);
+    TRACE("(%p)->(%d)\n", iface, dolock);
     return S_OK;
 }
 
diff --git a/dlls/inetcomm/pop3transport.c b/dlls/inetcomm/pop3transport.c
index 6dbbab1..46ccf76 100644
--- a/dlls/inetcomm/pop3transport.c
+++ b/dlls/inetcomm/pop3transport.c
@@ -1183,7 +1183,7 @@ static HRESULT WINAPI POP3TransportCF_CreateInstance(LPCLASSFACTORY iface,
 
 static HRESULT WINAPI POP3TransportCF_LockServer(LPCLASSFACTORY iface, BOOL fLock)
 {
-    FIXME("(%d)\n",fLock);
+    TRACE("(%d)\n", fLock);
     return S_OK;
 }
 
diff --git a/dlls/inetcomm/smtptransport.c b/dlls/inetcomm/smtptransport.c
index 88659c4..183846c 100644
--- a/dlls/inetcomm/smtptransport.c
+++ b/dlls/inetcomm/smtptransport.c
@@ -1024,7 +1024,7 @@ static HRESULT WINAPI SMTPTransportCF_CreateInstance(LPCLASSFACTORY iface,
 
 static HRESULT WINAPI SMTPTransportCF_LockServer(LPCLASSFACTORY iface, BOOL fLock)
 {
-    FIXME("(%d)\n",fLock);
+    TRACE("(%d)\n", fLock);
     return S_OK;
 }
 
