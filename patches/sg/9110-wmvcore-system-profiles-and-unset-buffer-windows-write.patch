From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmvcore: system profiles and streams with no buffer window can be written (9110)

The version 8 system profiles (LoadSystemProfile) described their WMA 2 stream
without the format's own ten bytes (samples per block, encode options, super block
alignment), so the writer found no encoder for it and BeginWriting failed
(MF_E_ATTRIBUTENOTFOUND) for every one of them. They now carry them, with a block
of a frame's worth of the bit rate and a 3000 ms buffer window, as the WMA encoder's
formats do. And a stream made with CreateNewStream and never given a buffer window
(GetBufferWindow -1) became a preroll of 4294967 seconds, written into the file
properties and every time the reader gave back; the writer takes 3000 ms for it.
---
--- a/dlls/wmvcore/asfmux.c
+++ b/dlls/wmvcore/asfmux.c
@@ -179,6 +179,12 @@
         IWMStreamConfig_GetStreamNumber(config, &stream->number);
         IWMStreamConfig_GetBitrate(config, &stream->bitrate);
         IWMStreamConfig_GetBufferWindow(config, &stream->buffer_window);
+#ifndef SG_MUTANT_WMVW_UNSET_WINDOW
+        /* wine-sg 9110: -1 is a stream with no buffer window of its own (one made with
+         * CreateNewStream and never given one); it was taken as a preroll of 4294967 s, written
+         * into the file properties and every presentation time */
+        if (stream->buffer_window == ~0u) stream->buffer_window = 3000;
+#endif
         hr = IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props);
         IWMStreamConfig_Release(config);
         if (FAILED(hr)) goto fail;
--- a/dlls/wmvcore/profile.c
+++ b/dlls/wmvcore/profile.c
@@ -1962,8 +1962,9 @@
     IWMMediaProps *props;
     IWMProfile3 *profile;
     WM_MEDIA_TYPE mt = {0};
-    BYTE format[18] = {0};
-    DWORD align;
+    BYTE format[18 + 10] = {0};
+    DWORD align, frame;
+    WORD options = 1;
     HRESULT hr;
 
     if (index >= profile_system_count(version))
@@ -1979,22 +1980,34 @@
         goto fail;
     IWMStreamConfig_SetBitrate(config, desc->bitrate);
 
-    /* Audio version 2 (format tag 0x161), 16 bit samples. */
+    /* Audio version 2 (format tag 0x161), 16 bit samples. Stained Glass OS (wine-sg 9110): with
+     * the format's own ten bytes (samples per block, encode options, super block alignment) and a
+     * block of a frame's worth of the bit rate, as the WMA 2 encoder's formats carry them; without
+     * them the writer had no encoder for the stream and BeginWriting failed, so no system profile
+     * could be written. */
+    frame = desc->rate <= 16000 ? 512 : desc->rate <= 22050 ? 1024 : 2048;
     format[0] = 0x61; format[1] = 0x01;
     format[2] = desc->channels;
     memcpy(format + 4, &desc->rate, 4);
     align = desc->bitrate / 8;
     memcpy(format + 8, &align, 4);
-    align = desc->channels * 2;
-    format[12] = align;
+    align = (DWORD)((UINT64)desc->bitrate * frame / (8 * desc->rate));
+    memcpy(format + 12, &align, 2);
     format[14] = 16;
+#ifndef SG_MUTANT_WMVP_SYSTEM_NO_DATA
+    format[16] = 10;
+#endif
+    memcpy(format + 18, &frame, 4);
+    memcpy(format + 22, &options, 2);
+    memcpy(format + 24, &align, 4);
+    IWMStreamConfig_SetBufferWindow(config, 3000);
     mt.majortype = audio_type;
     mt.subtype = audio_type;
     mt.subtype.Data1 = 0x161;
     mt.bFixedSizeSamples = TRUE;
     mt.lSampleSize = align;
     mt.formattype = wave_format;
-    mt.cbFormat = sizeof(format);
+    mt.cbFormat = format[16] ? sizeof(format) : 18;
     mt.pbFormat = format;
     if (SUCCEEDED(hr = IWMStreamConfig_QueryInterface(config, &IID_IWMMediaProps, (void **)&props)))
     {
