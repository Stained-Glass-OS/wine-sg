From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: IP_MULTICAST_IF takes an interface index, as Windows does

Windows takes an IP_MULTICAST_IF value in 0.x.x.x (not 0.0.0.0) as an
interface index in network byte order. Zeroconf's mDNS passes the index so
(DYMO Connect's web service, discovering network label printers); Wine gave
the value to Linux as an address, setsockopt failed with "Invalid argument"
and the DYMO web service stopped. On Linux the index is set with an
ip_mreqn.
---
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -2139,6 +2139,21 @@
         {
             int sock_type = get_sock_type( handle );
             if (sock_type != SOCK_DGRAM && sock_type != SOCK_RAW) return STATUS_INVALID_PARAMETER;
+#ifdef __linux__
+            /* An address in 0.x.x.x (but 0.0.0.0) is an interface index in
+             * network byte order, as Windows takes it -- Zeroconf's mDNS
+             * (DYMO Connect's printer discovery) passes the index so. */
+            if (in_size >= sizeof(struct in_addr) && !((const unsigned char *)in_buffer)[0]
+                && ((const struct in_addr *)in_buffer)->s_addr)
+            {
+                struct ip_mreqn mreqn;
+                memset( &mreqn, 0, sizeof(mreqn) );
+                mreqn.imr_ifindex = ntohl( ((const struct in_addr *)in_buffer)->s_addr );
+#ifndef SG_MUTANT_NOIFINDEX
+                return do_setsockopt( handle, io, IPPROTO_IP, IP_MULTICAST_IF, &mreqn, sizeof(mreqn) );
+#endif
+            }
+#endif
             return do_setsockopt( handle, io, IPPROTO_IP, IP_MULTICAST_IF, in_buffer, in_size );
         }
 
