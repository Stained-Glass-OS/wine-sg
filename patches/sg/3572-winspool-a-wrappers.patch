+    }
+    else
+    {
+        FORM_INFO_2A *f = (FORM_INFO_2A *)form;
+
+        formW.Flags = f->Flags;
+        formW.pName = asciitounicode(&name, f->pName);
+        formW.Size = f->Size;
+        formW.ImageableArea = f->ImageableArea;
+        formW.pKeyword = f->pKeyword;
+        formW.StringType = f->StringType;
+        formW.pMuiDll = asciitounicode(&mui, f->pMuiDll);
+        formW.dwResourceId = f->dwResourceId;
+        formW.pDisplayName = asciitounicode(&display, f->pDisplayName);
+        formW.wLangId = f->wLangId;
+    }
+    ret = AddFormW(printer, level, (BYTE *)&formW);
+    RtlFreeUnicodeString(&name);
+    RtlFreeUnicodeString(&mui);
+    RtlFreeUnicodeString(&display);
+    return ret;
 }
 
