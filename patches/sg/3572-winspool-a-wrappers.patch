@@ -8038,8 +8210,36 @@ DWORD WINAPI EnumPrinterDataW( HANDLE hPrinter, DWORD dwIndex, LPWSTR pValueName
  */
 DWORD WINAPI EnumPrinterKeyA(HANDLE printer, const CHAR *key, CHAR *subkey, DWORD size, DWORD *needed)
 {
-    FIXME("%p %s %p %lx %p\n", printer, debugstr_a(key), subkey, size, needed);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    UNICODE_STRING keyU;
+    WCHAR *bufW;
+    DWORD neededW = 0, ret, len;
+
+    TRACE("%p %s %p %lx %p\n", printer, debugstr_a(key), subkey, size, needed);
+
+    if (!key || !needed) return ERROR_INVALID_PARAMETER;
+    asciitounicode(&keyU, key);
+    ret = EnumPrinterKeyW(printer, keyU.Buffer, NULL, 0, &neededW);
+    if (ret != ERROR_MORE_DATA)
+    {
+        RtlFreeUnicodeString(&keyU);
+        return ret;
+    }
+    if (!(bufW = malloc(neededW)))
+    {
+        RtlFreeUnicodeString(&keyU);
+        return ERROR_OUTOFMEMORY;
+    }
+    ret = EnumPrinterKeyW(printer, keyU.Buffer, bufW, neededW, &neededW);
+    RtlFreeUnicodeString(&keyU);
+    if (ret == ERROR_SUCCESS)
+    {
+        len = WideCharToMultiByte(CP_ACP, 0, bufW, neededW / sizeof(WCHAR), NULL, 0, NULL, NULL);
+        *needed = len;
+        if (!subkey || size < len) ret = ERROR_MORE_DATA;
+        else WideCharToMultiByte(CP_ACP, 0, bufW, neededW / sizeof(WCHAR), subkey, size, NULL, NULL);
+    }
+    free(bufW);
+    return ret;
 }
 
 /*****************************************************************************
@@ -8048,8 +8248,55 @@ DWORD WINAPI EnumPrinterKeyA(HANDLE printer, const CHAR *key, CHAR *subkey, DWOR
  */
 DWORD WINAPI EnumPrinterKeyW(HANDLE printer, const WCHAR *key, WCHAR *subkey, DWORD size, DWORD *needed)
 {
-    FIXME("%p %s %p %lx %p\n", printer, debugstr_w(key), subkey, size, needed);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    HKEY printer_key, sub;
+    DWORD ret, count, maxlen, i, total = 1, pos = 0;
+    WCHAR *name;
+
+    TRACE("%p %s %p %lx %p\n", printer, debugstr_w(key), subkey, size, needed);
+
+    if (!key || !needed) return ERROR_INVALID_PARAMETER;
+    if ((ret = WINSPOOL_GetOpenedPrinterRegKey(printer, &printer_key))) return ret;
+    if (key[0])
+    {
+        ret = RegOpenKeyExW(printer_key, key, 0, KEY_READ, &sub);
+        RegCloseKey(printer_key);
+        if (ret) return ret == ERROR_FILE_NOT_FOUND ? ERROR_FILE_NOT_FOUND : ret;
+    }
+    else sub = printer_key;
+
+    if ((ret = RegQueryInfoKeyW(sub, NULL, NULL, NULL, &count, &maxlen, NULL, NULL, NULL, NULL, NULL, NULL)))
+    {
+        RegCloseKey(sub);
+        return ret;
+    }
+    if (!(name = malloc((maxlen + 1) * sizeof(WCHAR))))
+    {
+        RegCloseKey(sub);
+        return ERROR_OUTOFMEMORY;
+    }
+    /* the result is a list of names, each ended by a null, and a final extra null */
+    for (i = 0; i < count; i++)
+    {
+        DWORD len = maxlen + 1;
+
+        if (RegEnumKeyExW(sub, i, name, &len, NULL, NULL, NULL, NULL)) break;
+        total += len + 1;
+        if ((total * sizeof(WCHAR)) <= size && subkey)
+        {
+            memcpy(subkey + pos, name, len * sizeof(WCHAR));
+            pos += len;
+            subkey[pos++] = 0;
+        }
+    }
+    free(name);
+    RegCloseKey(sub);
+
+    if (total == 1) total = 2;  /* an empty list is two nulls */
+    *needed = total * sizeof(WCHAR);
+    if (!subkey || size < *needed) return ERROR_MORE_DATA;
+    if (pos == 0) subkey[pos++] = 0;
+    subkey[pos] = 0;
+    return ERROR_SUCCESS;
 }
 
