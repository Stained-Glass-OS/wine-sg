+/* ---- the local accounts, read from the account database of the host ----
+ * An ordinary account is a passwd entry with a user id from 1000 to 59999 and a login shell; its relative id
+ * is 1000 plus the user id (the server makes the SIDs the same way). Changes go through the account tools of
+ * the host, not through these calls. */
+#ifndef FILTER_NORMAL_ACCOUNT
+#define FILTER_NORMAL_ACCOUNT 0x0002
+#endif
+struct local_account { WCHAR name[UNLEN + 1]; };
+
+static void free_local_accounts( struct local_account *accounts ) { free( accounts ); }
+
+static BOOL account_in_list( const struct local_account *accounts, UINT count, const WCHAR *name )
+{
+    UINT i;
+    for (i = 0; i < count; i++) if (!wcsicmp( accounts[i].name, name )) return TRUE;
+    return FALSE;
+}
+
+static UINT get_local_accounts( struct local_account **ret )
+{
+    HANDLE file = CreateFileW( L"\\\\?\\unix\\etc\\passwd", GENERIC_READ, FILE_SHARE_READ|FILE_SHARE_WRITE, NULL,
+                               OPEN_EXISTING, 0, 0 );
+    struct local_account *accounts = NULL, *new;
+    char *data = NULL, *line, *next, *tmp;
+    DWORD size = 0, cap = 0, read;
+    UINT count = 0;
+    WCHAR cur[UNLEN + 1];
+    DWORD curlen = ARRAY_SIZE(cur);
+
+    *ret = NULL;
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        for (;;)
+        {
+            if (size + 4097 > cap)
+            {
+                cap = cap ? cap * 2 : 16384;
+                if (cap > 4 * 1024 * 1024 || !(tmp = realloc( data, cap ))) { size = 0; break; }
+                data = tmp;
+            }
+            if (!ReadFile( file, data + size, cap - size - 1, &read, NULL ) || !read) break;
+            size += read;
+        }
+        CloseHandle( file );
+    }
+    if (data && size)
+    {
+        data[size] = 0;
+        for (line = data; line && *line; line = next)
+        {
+            char *f[7], *p;
+            int n = 0, uid;
+            WCHAR name[UNLEN + 1];
+
+            if ((next = strchr( line, '\n' ))) *next++ = 0;
+            f[n++] = line;
+            for (p = line; *p && n < 7; p++) if (*p == ':') { *p = 0; f[n++] = p + 1; }
+            if (n < 7) continue;
+            uid = atoi( f[2] );
+            if (uid < 1000 || uid >= 60000) continue;
+            p = strrchr( f[6], '/' );
+            p = p ? p + 1 : f[6];
+            if (!*p || !strcmp( p, "nologin" ) || !strcmp( p, "false" )) continue;
+            if (!MultiByteToWideChar( CP_UTF8, 0, f[0], -1, name, ARRAY_SIZE(name) )) continue;
+            if (account_in_list( accounts, count, name )) continue;
+            if (!(new = realloc( accounts, (count + 1) * sizeof(*accounts) ))) break;
+            accounts = new;
+            wcscpy( accounts[count++].name, name );
+        }
+    }
+    free( data );
+    /* the account running this program is always one of them */
+    if (GetUserNameW( cur, &curlen ) && !account_in_list( accounts, count, cur ) &&
+        (new = realloc( accounts, (count + 1) * sizeof(*accounts) )))
+    {
+        accounts = new;
+        wcscpy( accounts[count++].name, cur );
+    }
+    *ret = accounts;
+    return count;
+}
