+/* NET USER and NET LOCALGROUP: list the accounts and local groups of this computer (read only) */
+static BOOL local_group_has(const WCHAR *group, const WCHAR *computer, const WCHAR *user)
+{
+    LOCALGROUP_MEMBERS_INFO_3 *members = NULL;
+    DWORD read = 0, total = 0, i;
+    WCHAR full[512];
+    BOOL found = FALSE;
+
+    swprintf(full, ARRAY_SIZE(full), L"%s\\%s", computer, user);
+    if (NetLocalGroupGetMembers(NULL, group, 3, (BYTE **)&members, MAX_PREFERRED_LENGTH, &read, &total, NULL) != NERR_Success)
+        return FALSE;
+    for (i = 0; i < read; i++) if (!wcsicmp(members[i].lgrmi3_domainandname, full)) found = TRUE;
+    NetApiBufferFree(members);
+    return found;
+}
+
