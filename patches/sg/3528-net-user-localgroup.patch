+        ptr = buf + count * (level == 0 ? sizeof(USER_INFO_0) : sizeof(USER_INFO_20));
+        for (i = 0; i < count; i++)
+        {
+            WCHAR *name = (WCHAR *)ptr;
 
-        if (!LookupAccountNameW(NULL, user, sid, &size, NULL, &len, &use))
-            return GetLastError();
-
-        count = GetSidSubAuthorityCount(sid);
-        rid = GetSidSubAuthority(sid, *count - 1);
-
-        info->usri20_name      = (WCHAR *)((char *)info + sizeof(*info));
-        wcscpy(info->usri20_name, user);
-        info->usri20_full_name = NULL;
-        info->usri20_comment   = NULL;
-        info->usri20_flags     = UF_NORMAL_ACCOUNT;
-        info->usri20_user_id   = *rid;
-
-        *bufptr = (BYTE *)info;
-        *entriesread = *totalentries = 1;
+            wcscpy( name, accounts[i].name );
+            ptr += (wcslen( name ) + 1) * sizeof(WCHAR);
+            if (level == 0) ((USER_INFO_0 *)buf)[i].usri0_name = name;
+            else
+            {
+                USER_INFO_20 *info = &((USER_INFO_20 *)buf)[i];
 
-        NetApiBufferFree(sid);
-        break;
-    }
-    default:
-        FIXME("level %lu not supported\n", level);
-        return ERROR_INVALID_LEVEL;
+                info->usri20_name      = name;
+                info->usri20_full_name = NULL;
+                info->usri20_comment   = NULL;
+                info->usri20_flags     = UF_NORMAL_ACCOUNT;
+                info->usri20_user_id   = get_user_rid( name );
+            }
+            n++;
+        }
+        free_local_accounts( accounts );
+        *bufptr = buf;
+        *entriesread = *totalentries = n;
     }
     return NERR_Success;
 }
diff --git a/programs/net/net.c b/programs/net/net.c
--- a/programs/net/net.c
+++ b/programs/net/net.c
@@ -177,6 +177,139 @@ static int net_share(int argc, const WCHAR *argv[])
     return 0;
 }
 
+/* NET USER and NET LOCALGROUP: list the accounts and local groups of this computer (read only) */
+static BOOL local_group_has(const WCHAR *group, const WCHAR *computer, const WCHAR *user)
+{
+    LOCALGROUP_MEMBERS_INFO_3 *members = NULL;
+    DWORD read = 0, total = 0, i;
+    WCHAR full[512];
+    BOOL found = FALSE;
+
+    swprintf(full, ARRAY_SIZE(full), L"%s\\%s", computer, user);
+    if (NetLocalGroupGetMembers(NULL, group, 3, (BYTE **)&members, MAX_PREFERRED_LENGTH, &read, &total, NULL) != NERR_Success)
+        return FALSE;
+    for (i = 0; i < read; i++) if (!wcsicmp(members[i].lgrmi3_domainandname, full)) found = TRUE;
+    NetApiBufferFree(members);
+    return found;
+}
+
+static int net_user(int argc, const WCHAR *argv[])
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer), read = 0, total = 0, i;
+    USER_INFO_0 *users = NULL;
+    NET_API_STATUS status;
+
+    GetComputerNameW(computer, &size);
+    if (argc > 2 && argv[2][0] != '/')
+    {
+        USER_INFO_0 *info = NULL;
+        WCHAR groups[128] = L"";
+
+        if (argc > 3)
+        {
+            /* a password, /add, /delete or /active: changes belong to the account tools */
+            output_string(STRING_ACCOUNT_CHANGE);
+            return 2;
+        }
+        status = NetUserGetInfo(NULL, argv[2], 0, (BYTE **)&info);
+        if (status != NERR_Success)
+        {
+            output_string(STRING_USER_NOT_FOUND);
+            return 2;
+        }
+        if (local_group_has(L"Administrators", computer, info->usri0_name)) wcscat(groups, L"*Administrators");
+        if (local_group_has(L"Users", computer, info->usri0_name))
+        {
+            if (groups[0]) wcscat(groups, L"  ");
+            wcscat(groups, L"*Users");
+        }
+        output_string(STRING_USER_DETAIL, info->usri0_name, groups[0] ? groups : L"*None");
+        output_string(STRING_CMD_SUCCESS);
+        NetApiBufferFree(info);
+        return 0;
+    }
+    if (argc > 2)
+    {
+        output_string(STRING_ACCOUNT_CHANGE);
+        return 2;
+    }
+    status = NetUserEnum(NULL, 0, 0, (BYTE **)&users, MAX_PREFERRED_LENGTH, &read, &total, NULL);
+    if (status != NERR_Success)
+    {
+        output_string(STRING_SYSTEM_ERROR, status);
+        output_error_string(status);
+        return 2;
+    }
+    output_string(STRING_ACCOUNTS_HEADER, computer);
+    for (i = 0; i < read; i++)
+        output_printf(i % 3 == 2 || i == read - 1 ? L"%1\n" : L"%1!-25s!", users[i].usri0_name);
+    output_string(STRING_CMD_SUCCESS);
+    NetApiBufferFree(users);
+    return 0;
+}
+
+static int net_localgroup(int argc, const WCHAR *argv[])
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD size = ARRAY_SIZE(computer), read = 0, total = 0, i;
+    NET_API_STATUS status;
+
+    GetComputerNameW(computer, &size);
+    if (argc > 2 && argv[2][0] != '/')
+    {
+        LOCALGROUP_INFO_1 *info = NULL;
+        LOCALGROUP_MEMBERS_INFO_3 *members = NULL;
+
+        if (argc > 3)
+        {
+            output_string(STRING_ACCOUNT_CHANGE);
+            return 2;
+        }
+        status = NetLocalGroupGetInfo(NULL, argv[2], 1, (BYTE **)&info);
+        if (status != NERR_Success)
+        {
+            output_string(STRING_ALIAS_NOT_FOUND);
+            return 2;
+        }
+        output_string(STRING_ALIAS_DETAIL, info->lgrpi1_name, info->lgrpi1_comment);
+        status = NetLocalGroupGetMembers(NULL, argv[2], 3, (BYTE **)&members, MAX_PREFERRED_LENGTH, &read, &total, NULL);
+        if (status == NERR_Success)
+        {
+            for (i = 0; i < read; i++)
+            {
+                const WCHAR *name = wcschr(members[i].lgrmi3_domainandname, '\\');
+                output_printf(L"%1\n", name ? name + 1 : members[i].lgrmi3_domainandname);
+            }
+            NetApiBufferFree(members);
+        }
+        output_string(STRING_CMD_SUCCESS);
+        NetApiBufferFree(info);
+        return 0;
+    }
+    if (argc > 2)
+    {
+        output_string(STRING_ACCOUNT_CHANGE);
+        return 2;
+    }
+    {
+        LOCALGROUP_INFO_0 *groups = NULL;
+
+        status = NetLocalGroupEnum(NULL, 0, (BYTE **)&groups, MAX_PREFERRED_LENGTH, &read, &total, NULL);
+        if (status != NERR_Success)
+        {
+            output_string(STRING_SYSTEM_ERROR, status);
+            output_error_string(status);
+            return 2;
+        }
+        output_string(STRING_ALIASES_HEADER, computer);
+        for (i = 0; i < read; i++) output_printf(L"*%1\n", groups[i].lgrpi0_name);
+        output_string(STRING_CMD_SUCCESS);
+        NetApiBufferFree(groups);
+    }
+    return 0;
+}
+
 static BOOL arg_is(const WCHAR* str1, const WCHAR* str2);
 
 static BOOL net_use(int argc, const WCHAR* argv[])
@@ -569,6 +702,14 @@ int __cdecl wmain(int argc, const WCHAR* argv[])
         }
         return net_helpmsg(argv[2]);
     }
+    else if(arg_is(argv[1], L"user") || arg_is(argv[1], L"users"))
+    {
+        return net_user(argc, argv);
+    }
+    else if(arg_is(argv[1], L"localgroup"))
+    {
+        return net_localgroup(argc, argv);
+    }
     else if(arg_is(argv[1], L"share"))
     {
         return net_share(argc, argv);
