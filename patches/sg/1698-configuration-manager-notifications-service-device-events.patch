+/* Stained Glass OS: a service registered for device events with its status
+ * handle (RegisterDeviceNotification, DEVICE_NOTIFY_SERVICE_HANDLE, which
+ * registers with no callback) gets them as SERVICE_CONTROL_DEVICEEVENT in
+ * its HandlerEx. */
+static DWORD service_device_event( HANDLE handle, DWORD code, DEV_BROADCAST_HDR *header )
+{
+    LPHANDLER_FUNCTION_EX handler = NULL;
+    void *context = NULL;
+    unsigned int i;
+
+    EnterCriticalSection( &service_cs );
+    for (i = 0; i < nb_services; i++)
+    {
+        if (services[i]->handle != (SC_HANDLE)handle) continue;
+        handler = services[i]->handler;
+        context = services[i]->context;
+        break;
+    }
+    LeaveCriticalSection( &service_cs );
+
+#ifdef SG_MUTANT_NO_SERVICE_DEVEVENT
+    handler = NULL;
+#endif
+    /* only HandlerEx gets device events */
+    if (!handler || handler == ctrl_handler_thunk)
+    {
+        TRACE( "no handler for %p\n", handle );
+        return 0;
+    }
+    TRACE( "service %p event %#lx\n", handle, code );
+    return handler( SERVICE_CONTROL_DEVICEEVENT, code, header, context );
+}
