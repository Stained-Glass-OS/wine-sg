From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, win32u, user32: process mitigation policies enforced

The mitigation policies a process set (SetProcessMitigationPolicy) or was
created with (PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY) were kept and read
back (1602, 1641) but nothing held the process to them. Where the host can,
it now is, as on Windows (Chrome, Edge and other sandboxes set these):

- StrictHandleCheck (RaiseExceptionOnInvalidHandleReference): using a
  handle that is not one -- NtClose, the waits, NtSetEvent/ResetEvent,
  NtReleaseMutant/Semaphore -- raises STATUS_INVALID_HANDLE as an exception
  when the call returns, as it otherwise does only under a debugger; the
  pseudo-handles are never invalid.
- DynamicCode (ProhibitDynamicCode, Arbitrary Code Guard): no executable
  allocation, no data (non-image) memory made executable, no memory both
  writable and executable, no executable view of a data section:
  STATUS_DYNAMIC_CODE_BLOCKED (ERROR_DYNAMIC_CODE_BLOCKED). Images map and
  keep their protections. With AllowThreadOptOut a thread that opted out
  (ThreadDynamicCodePolicyInfo) may.
- ImageLoad: NoRemoteImages refuses an image on a remote (network) device;
  PreferSystem32Images searches the system directory before the load path.
- FontDisable (DisableNonSystemFonts): only fonts in the fonts folder (or
  by bare name) load; others, and fonts in memory, are refused.
- ExtensionPointDisable: another process's hook DLL is not loaded into the
  process (the hook is skipped), as AppInit DLLs are not (Wine loads none).

Not enforced: NoLowMandatoryLabelImages (files carry no mandatory labels
here), SystemCallDisable (DisallowWin32kSystemCalls: Wine's own code makes
win32k calls Windows would not in such a process), Signature
(MicrosoftSignedOnly: nothing here is Microsoft-signed), and ASLR/DEP,
which are the host's. NoRemoteImages is not covered by the gate (no
network file system in it).

Gate: test/mitigate-gate.sh (64- and 32-bit, test/mitigate-probe.c,
test/mitigate-dll.c). Mutants SG_MUTANT_NO_STRICT_HANDLES
(ntdll/unix/server.c), SG_MUTANT_NO_ACG (ntdll/unix/virtual.c),
SG_MUTANT_FONTS_ALLOWED (win32u/font.c), SG_MUTANT_HOOKS_INJECTED
(user32/hook.c). Wine's ntdll virtual and kernel32 process tests: no
failures.
---
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -2676,6 +2676,27 @@ static NTSTATUS get_dll_load_path_search_flags( LPCWSTR module, DWORD flags, WCH
  *
  * Open a file for a new dll. Helper for find_dll_file.
  */
+/* Stained Glass OS: ProcessImageLoadPolicy: NoRemoteImages (1) refuses an
+ * image on a remote (network) device, PreferSystem32Images (4) searches the
+ * system directory before the load path */
+static ULONG image_load_policy(void)
+{
+    PROCESS_MITIGATION_POLICY_INFORMATION info = { .Policy = ProcessImageLoadPolicy };
+
+    if (NtQueryInformationProcess( GetCurrentProcess(), ProcessMitigationPolicy, &info, sizeof(info), NULL ))
+        return 0;
+    return info.Flags;
+}
+
+static BOOL is_remote_file( HANDLE handle )
+{
+    FILE_FS_DEVICE_INFORMATION dev;
+    IO_STATUS_BLOCK io;
+
+    if (NtQueryVolumeInformationFile( handle, &io, &dev, sizeof(dev), FileFsDeviceInformation )) return FALSE;
+    return (dev.Characteristics & FILE_REMOTE_DEVICE) || dev.DeviceType == FILE_DEVICE_NETWORK_FILE_SYSTEM;
+}
+
 static NTSTATUS open_dll_file( UNICODE_STRING *nt_name, WINE_MODREF **pwm, HANDLE *mapping,
                                SECTION_IMAGE_INFORMATION *image_info, struct file_id *id )
 {
@@ -2722,6 +2743,15 @@ static NTSTATUS open_dll_file( UNICODE_STRING *nt_name, WINE_MODREF **pwm, HANDL
         }
     }
 
+#ifndef SG_MUTANT_REMOTE_IMAGES
+    if ((image_load_policy() & 1) && is_remote_file( handle ))
+    {
+        WARN( "%s is on a remote device and remote images are disabled\n", debugstr_us(nt_name) );
+        NtClose( handle );
+        return STATUS_ACCESS_DENIED;
+    }
+#endif
+
     size.QuadPart = 0;
     status = NtCreateSection( mapping, STANDARD_RIGHTS_REQUIRED | SECTION_QUERY |
                               SECTION_MAP_READ | SECTION_MAP_EXECUTE,
@@ -3278,7 +3308,11 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
 
     if (RtlDetermineDosPathNameType_U( libname ) == RELATIVE_PATH)
     {
-        status = search_dll_file( load_path, libname, nt_name, pwm, mapping, image_info, id );
+        status = STATUS_DLL_NOT_FOUND;
+        if (image_load_policy() & 4)
+            status = search_dll_file( system_dir, libname, nt_name, pwm, mapping, image_info, id );
+        if (status == STATUS_DLL_NOT_FOUND)
+            status = search_dll_file( load_path, libname, nt_name, pwm, mapping, image_info, id );
         if (status == STATUS_DLL_NOT_FOUND)
             status = find_builtin_without_file( libname, nt_name, pwm, mapping, image_info, id );
     }
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1323,6 +1323,24 @@ static ULONG creation_mitigation_flags( HANDLE handle, PROCESS_MITIGATION_POLICY
     return flags;
 }
 
+/* Stained Glass OS: the policies in force in this process, set at creation
+ * (PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY) or since (SetProcessMitigationPolicy),
+ * for the code that enforces them. The creation ones are asked of the server
+ * once. */
+ULONG current_mitigation_flags( PROCESS_MITIGATION_POLICY which )
+{
+    static ULONG creation[MaxProcessMitigationPolicy];
+    static LONG known[MaxProcessMitigationPolicy];
+
+    if ((unsigned int)which >= MaxProcessMitigationPolicy) return 0;
+    if (!ReadAcquire( &known[which] ))
+    {
+        creation[which] = creation_mitigation_flags( NtCurrentProcess(), which );
+        WriteRelease( &known[which], 1 );
+    }
+    return creation[which] | ReadNoFence( (LONG *)&mitigation_policies[which] );
+}
+
 /* whether a process handle is this process, checking the access asked for */
 static NTSTATUS is_current_process( HANDLE handle, BOOL set, BOOL *current )
 {
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1902,6 +1902,24 @@ NTSTATUS WINAPI NtCompareTokens( HANDLE first, HANDLE second, BOOLEAN *equal )
 /**************************************************************************
  *           NtClose
  */
+/* Stained Glass OS: with ProcessStrictHandleCheckPolicy
+ * (RaiseExceptionOnInvalidHandleReference) a use of a handle that is not
+ * one raises STATUS_INVALID_HANDLE as an exception when the call returns, as
+ * on Windows, instead of only failing. */
+void check_invalid_handle( NTSTATUS status, HANDLE handle )
+{
+    if (status != STATUS_INVALID_HANDLE || !handle) return;
+    /* the pseudo-handles are never invalid */
+    if (HandleToLong( handle ) >= ~5 && HandleToLong( handle ) <= ~0) return;
+#ifndef SG_MUTANT_NO_STRICT_HANDLES
+    if (!(current_mitigation_flags( ProcessStrictHandleCheckPolicy ) & 1)) return;
+#else
+    return;
+#endif
+    NtCurrentTeb()->ExceptionCode = status;
+    call_raise_user_exception_dispatcher();
+}
+
 NTSTATUS WINAPI NtClose( HANDLE handle )
 {
     sigset_t sigset;
@@ -1939,6 +1957,7 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
     if (!ret) power_request_closed( handle );
 
     if (ret != STATUS_INVALID_HANDLE || !handle) return ret;
+    check_invalid_handle( ret, handle );
     if (!peb->BeingDebugged) return ret;
     if (!NtQueryInformationProcess( NtCurrentProcess(), ProcessDebugPort, &port, sizeof(port), NULL) && port)
     {
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -407,6 +407,7 @@ NTSTATUS WINAPI NtReleaseSemaphore( HANDLE handle, ULONG count, ULONG *previous
         }
     }
     SERVER_END_REQ;
+    check_invalid_handle( ret, handle );
     return ret;
 }
 
@@ -481,6 +482,7 @@ NTSTATUS WINAPI NtSetEvent( HANDLE handle, LONG *prev_state )
         if (!ret && prev_state) *prev_state = reply->state;
     }
     SERVER_END_REQ;
+    check_invalid_handle( ret, handle );
     return ret;
 }
 
@@ -500,6 +502,7 @@ NTSTATUS WINAPI NtResetEvent( HANDLE handle, LONG *prev_state )
         if (!ret && prev_state) *prev_state = reply->state;
     }
     SERVER_END_REQ;
+    check_invalid_handle( ret, handle );
     return ret;
 }
 
@@ -634,6 +637,7 @@ NTSTATUS WINAPI NtReleaseMutant( HANDLE handle, LONG *prev_count )
         if (prev_count) *prev_count = 1 - reply->prev_count;
     }
     SERVER_END_REQ;
+    check_invalid_handle( ret, handle );
     return ret;
 }
 
@@ -1686,13 +1690,17 @@ NTSTATUS WINAPI NtWaitForMultipleObjects( DWORD count, const HANDLE *handles, BO
 {
     union select_op select_op;
     UINT i, flags = SELECT_INTERRUPTIBLE;
+    NTSTATUS status;
 
     if (!count || count > MAXIMUM_WAIT_OBJECTS) return STATUS_INVALID_PARAMETER_1;
 
     if (alertable) flags |= SELECT_ALERTABLE;
     select_op.wait.op = wait_any ? SELECT_WAIT : SELECT_WAIT_ALL;
+
     for (i = 0; i < count; i++) select_op.wait.handles[i] = wine_server_obj_handle( handles[i] );
-    return server_wait( &select_op, offsetof( union select_op, wait.handles[count] ), flags, timeout );
+    status = server_wait( &select_op, offsetof( union select_op, wait.handles[count] ), flags, timeout );
+    check_invalid_handle( status, handles[0] );
+    return status;
 }
 
 
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -316,6 +316,8 @@ extern NTSTATUS get_thread_ldt_entry( HANDLE handle, void *data, ULONG len, ULON
 extern void *get_native_context( CONTEXT *context );
 extern void *get_wow_context( CONTEXT *context );
 extern ULONG process_disable_priority_boost;
+extern ULONG current_mitigation_flags( PROCESS_MITIGATION_POLICY which );
+extern void check_invalid_handle( NTSTATUS status, HANDLE handle );
 extern ULONG64 get_tsc_frequency(void);
