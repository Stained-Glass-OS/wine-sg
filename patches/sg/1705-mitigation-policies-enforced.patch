--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4696,6 +4696,52 @@ static NTSTATUS allocate_virtual_memory( void **ret, SIZE_T *size_ptr, ULONG typ
 }
 
 
+
+/* Stained Glass OS: ProcessDynamicCodePolicy (Arbitrary Code Guard). With
+ * ProhibitDynamicCode the process cannot make code of its own: no
+ * executable allocation, no mapping of a data (non-image) section as
+ * executable, no making data executable, no memory both writable and
+ * executable; images map and keep their code as they are. A thread that
+ * opted out (ThreadDynamicCodePolicyInfo, when AllowThreadOptOut) may. */
+static BOOL is_exec_protection( ULONG protect )
+{
+    switch (protect & 0xff)
+    {
+    case PAGE_EXECUTE:
+    case PAGE_EXECUTE_READ:
+    case PAGE_EXECUTE_READWRITE:
+    case PAGE_EXECUTE_WRITECOPY:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL is_write_exec_protection( ULONG protect )
+{
+    return (protect & 0xff) == PAGE_EXECUTE_READWRITE || (protect & 0xff) == PAGE_EXECUTE_WRITECOPY;
+}
+
+static BOOL dynamic_code_prohibited(void)
+{
+    ULONG flags = current_mitigation_flags( ProcessDynamicCodePolicy );
+
+#ifdef SG_MUTANT_NO_ACG
+    return FALSE;
+#endif
+    if (!(flags & 1)) return FALSE;
+    if ((flags & 2) && (ntdll_get_thread_data()->dynamic_code_policy & THREAD_DYNAMIC_CODE_ALLOW)) return FALSE;
+    return TRUE;
+}
+
+static BOOL map_blocked_by_acg( HANDLE section, ULONG protect )
+{
+    SECTION_BASIC_INFORMATION info;
+
+    if (!is_exec_protection( protect ) || !dynamic_code_prohibited()) return FALSE;
+    if (NtQuerySection( section, SectionBasicInformation, &info, sizeof(info), NULL )) return FALSE;
+    return !(info.Attributes & SEC_IMAGE);
+}
+
 /***********************************************************************
  *             NtAllocateVirtualMemory   (NTDLL.@)
  *             ZwAllocateVirtualMemory   (NTDLL.@)
@@ -4746,6 +4792,8 @@ NTSTATUS WINAPI NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR z
         return result.virtual_alloc.status;
     }
 
+    if (is_exec_protection( protect ) && dynamic_code_prohibited()) return STATUS_DYNAMIC_CODE_BLOCKED;
+
     if (!*ret)
         limit = get_zero_bits_limit( zero_bits );
     else
@@ -4889,6 +4937,8 @@ NTSTATUS WINAPI NtAllocateVirtualMemoryEx( HANDLE process, PVOID *ret, SIZE_T *s
         return result.virtual_alloc_ex.status;
     }
 
+    if (is_exec_protection( protect ) && dynamic_code_prohibited()) return STATUS_DYNAMIC_CODE_BLOCKED;
+
     return allocate_virtual_memory( ret, size_ptr, type, protect,
                                     limit_low, limit_high, align, attributes );
 }
@@ -5001,6 +5051,7 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
     SIZE_T size = *size_ptr;
     LPVOID addr = *addr_ptr;
     DWORD old;
+    BOOL acg;
 
     TRACE("%p %p %08lx %08x\n", process, addr, size, (int)new_prot );
 
@@ -5034,13 +5085,16 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
 
     size = ROUND_SIZE( addr, size );
     base = ROUND_ADDR( addr, page_mask );
+    acg = is_exec_protection( new_prot ) && dynamic_code_prohibited();
 
     server_enter_uninterrupted_section( &virtual_mutex, &sigset );
 
     if ((view = find_view( base, size )))
     {
         /* Make sure all the pages are committed */
-        if (get_committed_size( view, base, ~(size_t)0, &vprot, VPROT_COMMITTED ) >= size && (vprot & VPROT_COMMITTED))
+        if (acg && (!(view->protect & SEC_IMAGE) || is_write_exec_protection( new_prot )))
+            status = STATUS_DYNAMIC_CODE_BLOCKED;
+        else if (get_committed_size( view, base, ~(size_t)0, &vprot, VPROT_COMMITTED ) >= size && (vprot & VPROT_COMMITTED))
         {
             old = get_win32_prot( vprot, view->protect );
             status = set_protection( view, base, size, new_prot );
@@ -5743,6 +5797,8 @@ NTSTATUS WINAPI NtMapViewOfSection( HANDLE handle, HANDLE process, PVOID *addr_p
         return result.map_view.status;
     }
 
+    if (map_blocked_by_acg( handle, protect )) return STATUS_DYNAMIC_CODE_BLOCKED;
+
     return virtual_map_section( handle, addr_ptr, 0, get_zero_bits_limit( zero_bits ), commit_size,
                                 offset_ptr, size_ptr, alloc_type, protect, 0 );
 }
@@ -5817,6 +5873,8 @@ NTSTATUS WINAPI NtMapViewOfSectionEx( HANDLE handle, HANDLE process, PVOID *addr
         return result.map_view_ex.status;
     }
 
+    if (map_blocked_by_acg( handle, protect )) return STATUS_DYNAMIC_CODE_BLOCKED;
+
     return virtual_map_section( handle, addr_ptr, limit_low, limit_high, 0,
                                 offset_ptr, size_ptr, alloc_type, protect, machine );
 }
--- a/dlls/user32/hook.c
+++ b/dlls/user32/hook.c
@@ -341,6 +341,19 @@ void *get_hook_proc( void *proc, const WCHAR *module, HMODULE *free_module )
     *free_module = mod;
     if (!mod)
     {
+        PROCESS_MITIGATION_POLICY_INFORMATION policy = { .Policy = ProcessExtensionPointDisablePolicy };
+
+        /* Stained Glass OS: with ProcessExtensionPointDisablePolicy a global
+         * hook's DLL is not loaded into this process (as AppInit DLLs and
+         * the other legacy extension points are not): the hook is skipped */
+        if (!NtQueryInformationProcess( GetCurrentProcess(), ProcessMitigationPolicy, &policy, sizeof(policy), NULL ) &&
+            (policy.Flags & 1) /* DisableExtensionPoints */)
+        {
+#ifndef SG_MUTANT_HOOKS_INJECTED
+            TRACE( "not loading %s: extension points are disabled\n", debugstr_w(module) );
+            return NULL;
+#endif
+        }
         TRACE( "loading %s\n", debugstr_w(module) );
         /* FIXME: the library will never be freed */
         if (!(mod = LoadLibraryExW(module, NULL, LOAD_WITH_ALTERED_SEARCH_PATH))) return NULL;
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -6946,6 +6946,32 @@ UINT font_init(void)
     return dpi;
 }
 
+/* Stained Glass OS: ProcessFontDisablePolicy (DisableNonSystemFonts): only
+ * the fonts installed in the system's fonts folder can be loaded; a font
+ * file anywhere else, or a font in memory, is refused, as on Windows. */
+static BOOL non_system_fonts_disabled(void)
+{
+    PROCESS_MITIGATION_POLICY_INFORMATION info = { .Policy = ProcessFontDisablePolicy };
+
+#ifdef SG_MUTANT_FONTS_ALLOWED
+    return FALSE;
+#endif
+    if (NtQueryInformationProcess( GetCurrentProcess(), ProcessMitigationPolicy, &info, sizeof(info), NULL ))
+        return FALSE;
+    return info.Flags & 1;
+}
+
+static BOOL is_system_font_path( const WCHAR *file )
+{
+    WCHAR dir[MAX_PATH];
+    size_t len;
+
+    if (*file != '\\') return !wcschr( file, '\\' );  /* a bare name: a system font */
+    get_fonts_win_dir_path( NULL, dir );
+    len = lstrlenW( dir );
+    return !wcsnicmp( file, dir, len ) && !wcschr( file + len, '\\' );
+}
+
 /***********************************************************************
  *           NtGdiAddFontResourceW    (win32u.@)
  */
@@ -6953,6 +6979,11 @@ INT WINAPI NtGdiAddFontResourceW( const WCHAR *str, ULONG size, ULONG files, DWO
                                   DWORD tid, void *dv )
 {
     if (!font_funcs) return 1;
+    if (!is_system_font_path( str ) && non_system_fonts_disabled())
+    {
+        WARN( "%s: not a system font, and non-system fonts are disabled\n", debugstr_w(str) );
+        return 0;
+    }
     return add_font_resource( str, flags );
 }
 
@@ -6972,6 +7003,11 @@ HANDLE WINAPI NtGdiAddFontMemResourceEx( void *ptr, DWORD size, void *dv, ULONG
         return NULL;
     }
     if (!font_funcs) return NULL;
+    if (non_system_fonts_disabled())
+    {
+        WARN( "fonts in memory are not system fonts, and non-system fonts are disabled\n" );
+        return NULL;
+    }
     if (!(copy = malloc( size ))) return NULL;
     memcpy( copy, ptr, size );
 
