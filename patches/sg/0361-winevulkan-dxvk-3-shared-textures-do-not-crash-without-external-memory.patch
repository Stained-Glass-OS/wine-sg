+/* Stained Glass OS: Win32 handle sharing for memory, semaphores and fences.
+ *
+ * Wine 10.0 does not expose VK_KHR_external_{memory,semaphore,fence}_win32, so
+ * these functions are never available. DXVK 3.x nonetheless calls
+ * vkGetMemoryWin32HandleKHR for every D3D11 texture created with
+ * D3D11_RESOURCE_MISC_SHARED, even after it decided it could not share it
+ * ("Failed to create shared resource: VK_KHR_EXTERNAL_MEMORY_WIN32 not
+ * supported"): the allocation keeps the requested handle type and asks for a
+ * handle anyway -- through a NULL pointer. Chromium (CEF, Electron), Qt
+ * WebEngine and WebView2 create such textures for their GPU compositing, so
+ * GOG Galaxy and every other DXVK-rendered browser engine died at start.
+ *
+ * Asked for, these return entry points that fail the way the functions may
+ * fail. Callers that check the extension (all well-behaved ones) never ask;
+ * DXVK logs the failure and carries on with an unshared texture, as with
+ * Wine's own d3d11. */
+static VkResult WINAPI sg_get_memory_win32_handle_unsupported(VkDevice device, const void *info, HANDLE *handle)
+{
+    WARN("%p, %p, %p: VK_KHR_external_memory_win32 is not supported.\n", device, info, handle);
+    return VK_ERROR_TOO_MANY_OBJECTS;
+}
+
+static VkResult WINAPI sg_get_memory_win32_properties_unsupported(VkDevice device, VkExternalMemoryHandleTypeFlagBits type,
+                                                                   HANDLE handle, void *props)
+{
+    WARN("%p, %#x, %p, %p: VK_KHR_external_memory_win32 is not supported.\n", device, type, handle, props);
+    return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+}
+
+static VkResult WINAPI sg_get_win32_handle_unsupported(VkDevice device, const void *info, HANDLE *handle)
+{
+    WARN("%p, %p, %p: Win32 semaphore/fence handles are not supported.\n", device, info, handle);
+    return VK_ERROR_TOO_MANY_OBJECTS;
+}
+
+static VkResult WINAPI sg_import_win32_handle_unsupported(VkDevice device, const void *info)
+{
+    WARN("%p, %p: Win32 semaphore/fence handles are not supported.\n", device, info);
+    return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+}
+
+static PFN_vkVoidFunction sg_unsupported_win32_handle_function(const char *name)
+{
+    static const struct { const char *name; PFN_vkVoidFunction func; } stubs[] =
+    {
+        { "vkGetMemoryWin32HandleKHR", (PFN_vkVoidFunction)sg_get_memory_win32_handle_unsupported },
+        { "vkGetMemoryWin32HandlePropertiesKHR", (PFN_vkVoidFunction)sg_get_memory_win32_properties_unsupported },
+        { "vkGetSemaphoreWin32HandleKHR", (PFN_vkVoidFunction)sg_get_win32_handle_unsupported },
+        { "vkImportSemaphoreWin32HandleKHR", (PFN_vkVoidFunction)sg_import_win32_handle_unsupported },
+        { "vkGetFenceWin32HandleKHR", (PFN_vkVoidFunction)sg_get_win32_handle_unsupported },
+        { "vkImportFenceWin32HandleKHR", (PFN_vkVoidFunction)sg_import_win32_handle_unsupported },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(stubs); i++)
+        if (!strcmp(name, stubs[i].name)) return stubs[i].func;
+    return NULL;
+}
+
 PFN_vkVoidFunction WINAPI vkGetDeviceProcAddr(VkDevice device, const char *name)
 {
     void *func;
@@ -185,6 +245,12 @@
         return func;
     }
 
+    if ((func = sg_unsupported_win32_handle_function(name)))
+    {
+        WARN("Returning a stub for %s.\n", debugstr_a(name));
+        return func;
+    }
+
     WARN("Unsupported device function: %s.\n", debugstr_a(name));
     return NULL;
 }
