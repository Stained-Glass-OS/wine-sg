index 0000000..ee77f71
--- /dev/null
+++ b/dlls/icu/host.c
@@ -0,0 +1,1383 @@
+/* icu.dll: the ICU C API that .NET's System.Globalization.Native binds (every name on its list,
+ * as Windows' icu.dll exports them all), forwarded to the host's ICU (wine-sg 6268). Generated by
+ * make_host.py. The 32-bit side gives ICU's objects small handles and keeps copies of the host's strings.
+ *
+ * Copyright (C) 2026 Stained Glass OS contributors; LGPL-2.1-or-later */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+#include "icu_host.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(icu);
+
+static BOOL host_ok;
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls(instance);
+        host_ok = !__wine_init_unix_call() && !WINE_UNIX_CALL(unix_icu_init, NULL);
+#ifdef SG_MUTANT_ICU_NO_HOST
+        host_ok = FALSE;
+#endif
+        if (!host_ok) ERR("no host ICU\n");
+    }
+    return TRUE;
+}
+
+static void icu_call(enum icu_funcs code, struct icu_call *c)
+{
+    if (host_ok) WINE_UNIX_CALL(code, c);
+}
+
+#ifdef _WIN64
+static UINT64 h_in(void *h) { return (UINT64)(ULONG_PTR)h; }
+static void *h_out(UINT64 v) { return (void *)(ULONG_PTR)v; }
+static void h_free(void *h) { }
+static const char *s8_out(UINT64 v) { return (const char *)(ULONG_PTR)v; }
+static const WCHAR *s16_out(UINT64 v) { return (const WCHAR *)(ULONG_PTR)v; }
+#else
+/* handles: 1-based slots of the host objects */
+static CRITICAL_SECTION cs;
+static CRITICAL_SECTION_DEBUG cs_debug = { 0, 0, &cs, { &cs_debug.ProcessLocksList, &cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": cs") } };
+static CRITICAL_SECTION cs = { &cs_debug, -1, 0, 0, 0, 0 };
+static UINT64 *slots;
+static UINT32 slot_count, slot_size;
+
+static UINT64 h_in(void *h)
+{
+    ULONG_PTR i = (ULONG_PTR)h;
+    UINT64 v = 0;
+    EnterCriticalSection(&cs);
+    if (i && i <= slot_count) v = slots[i - 1];
+    LeaveCriticalSection(&cs);
+    return v;
+}
+
+static void *h_out(UINT64 v)
+{
+    UINT32 i, free_slot = 0;
+    if (!v) return NULL;
+    EnterCriticalSection(&cs);
+    for (i = 0; i < slot_count; i++)
+    {
+        if (slots[i] == v) { LeaveCriticalSection(&cs); return (void *)(ULONG_PTR)(i + 1); }
+        if (!slots[i] && !free_slot) free_slot = i + 1;
+    }
+    if (!free_slot)
+    {
+        if (slot_count == slot_size)
+        {
+            UINT32 size = slot_size ? slot_size * 2 : 64;
+            UINT64 *n = realloc(slots, size * sizeof(*n));
+            if (!n) { LeaveCriticalSection(&cs); return NULL; }
+            slots = n; slot_size = size;
+        }
+        free_slot = ++slot_count;
+    }
+    slots[free_slot - 1] = v;
+    LeaveCriticalSection(&cs);
+    return (void *)(ULONG_PTR)free_slot;
+}
+
+static void h_free(void *h)
+{
+    ULONG_PTR i = (ULONG_PTR)h;
+    EnterCriticalSection(&cs);
+    if (i && i <= slot_count) slots[i - 1] = 0;
+    LeaveCriticalSection(&cs);
+}
+
+/* the host's strings: one copy for each different string, kept */
+struct kept { struct kept *next; UINT32 wide, bytes; char data[1]; };
+static struct kept *kept;
+
+static const void *keep(UINT64 v, UINT32 wide)
+{
+    struct icu_string s = { v, 0, wide, 0, 0 };
+    UINT32 unit = wide ? 2 : 1;
+    struct kept *k;
+    char *buf;
+
+    if (!v || !host_ok) return NULL;
+    WINE_UNIX_CALL(unix_icu_string, &s);
+    if (!(buf = malloc((s.len + 1) * unit))) return NULL;
+    s.buf = (ULONG_PTR)buf; s.size = (s.len + 1) * unit;
+    WINE_UNIX_CALL(unix_icu_string, &s);
+    EnterCriticalSection(&cs);
+    for (k = kept; k; k = k->next)
+        if (k->wide == wide && k->bytes == s.size && !memcmp(k->data, buf, s.size)) break;
+    if (!k && (k = malloc(offsetof(struct kept, data[s.size]))))
+    {
+        k->wide = wide; k->bytes = s.size;
+        memcpy(k->data, buf, s.size);
+        k->next = kept; kept = k;
+    }
+    LeaveCriticalSection(&cs);
+    free(buf);
+    return k ? k->data : NULL;
+}
+static const char *s8_out(UINT64 v) { return keep(v, 0); }
+static const WCHAR *s16_out(UINT64 v) { return keep(v, 1); }
+#endif
+
+static UINT64 d_in(double d) { UINT64 v; memcpy(&v, &d, sizeof(v)); return v; }
+static double d_out(UINT64 v) { double d; memcpy(&d, &v, sizeof(d)); return d; }
+
+int CDECL u_strlen(const WCHAR *s)
+{
+    int n = 0;
+    while (s[n]) n++;
+    return n;
+}
+
+int CDECL u_strcmp(const WCHAR *a, const WCHAR *b)
+{
+    while (*a && *a == *b) { a++; b++; }
+    return (int)*a - (int)*b;
+}
+
+WCHAR * CDECL u_strcpy(WCHAR *dst, const WCHAR *src)
+{
+    WCHAR *d = dst;
+    while ((*d++ = *src++));
+    return dst;
+}
+
+WCHAR * CDECL u_strncpy(WCHAR *dst, const WCHAR *src, int n)
+{
+    WCHAR *d = dst;
+    while (n > 0 && (*d++ = *src++)) n--;
+    return dst;
+}
