+/* a host string's length, and as much of it as fits copied out (the 32-bit side keeps copies) */
+static NTSTATUS icu_string(void *args)
+{
+    struct icu_string *s = args;
+    UINT32 unit = s->wide ? 2 : 1, len = 0;
+
+    if (!s->ptr) { s->len = 0; return STATUS_SUCCESS; }
+    if (s->wide) len = u_strlen((const UChar *)(uintptr_t)s->ptr);
+    else len = strlen((const char *)(uintptr_t)s->ptr);
+    s->len = len;
+    if (s->buf && s->size >= (len + 1) * unit)
+        memcpy((void *)(uintptr_t)s->buf, (const void *)(uintptr_t)s->ptr, (len + 1) * unit);
+    return STATUS_SUCCESS;
+}
