+#!/usr/bin/env python3
+"""make_host.py [OUTDIR]: icu.dll's forwarders to the host ICU (host.c, unixlib.c, icu_host.h and
+host.spec, whose lines are in icu.spec) for the ICU C API .NET's System.Globalization.Native binds:
+the names in dotnet_names.txt (dotnet/runtime, MIT: pal_icushim_internal.h FOR_ALL_ICU_FUNCTIONS,
+.NET 5.0 through 10), with the prototypes of the host's ICU headers (/usr/include/unicode).
