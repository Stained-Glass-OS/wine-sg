+#ifdef _WIN64
+static UINT64 h_in(void *h) { return (UINT64)(ULONG_PTR)h; }
+static void *h_out(UINT64 v) { return (void *)(ULONG_PTR)v; }
+static void h_free(void *h) { }
+static const char *s8_out(UINT64 v) { return (const char *)(ULONG_PTR)v; }
+static const WCHAR *s16_out(UINT64 v) { return (const WCHAR *)(ULONG_PTR)v; }
