+for f in sorted(glob.glob('/usr/include/unicode/*.h')):
+    text += open(f, errors='replace').read() + '\n'
+text = re.sub(r'/\*.*?\*/', '', text, flags=re.S)
+text = re.sub(r'//[^\n]*', '', text)
