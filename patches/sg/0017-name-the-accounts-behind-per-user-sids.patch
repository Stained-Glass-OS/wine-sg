+/* Stained Glass OS (multi-user debt D12): in a prefix shared between Unix
+ * users, each has the SID <computer SID>-<1000 + uid>; the server, which
+ * assigns them, names them. rid 0 looks the name up instead. */
+static BOOL sg_lookup_account( DWORD *rid, const WCHAR *name, WCHAR *out, DWORD out_len )
+{
+    NTSTATUS status;
+    DWORD len = 0;
+
+    SERVER_START_REQ( sg_lookup_account )
+    {
+        req->rid = *rid;
+        if (!*rid) wine_server_add_data( req, name, lstrlenW( name ) * sizeof(WCHAR) );
+        if (out) wine_server_set_reply( req, out, (out_len - 1) * sizeof(WCHAR) );
+        status = wine_server_call( req );
+        if (!status)
+        {
+            *rid = reply->rid;
+            len = wine_server_reply_size( reply ) / sizeof(WCHAR);
+        }
+    }
+    SERVER_END_REQ;
+    if (status) return FALSE;
+    if (out) out[len] = 0;
+    return TRUE;
+}
