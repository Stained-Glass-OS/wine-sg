+/* Stained Glass OS (multi-user debt D12): name the account behind a per-user
+ * SID, and the reverse. Each Unix user of a shared prefix has the SID
+ * S-1-5-21-0-0-0-<1000 + uid> (security_unix_uid_to_sid), which Windows
+ * programs could not turn into a name -- WindowsIdentity.Name was empty. The
+ * server made the SID, so it answers, from the passwd database. The prefix's
+ * owner and root are SYSTEM, which has its own well-known name. */
+DECL_HANDLER(sg_lookup_account)
+{
+    struct passwd *pw = NULL;
+    WCHAR wname[64];
+    data_size_t i, len;
+
+    if (!sg_system_prefix)
+    {
+        set_error( STATUS_NOT_SUPPORTED );
+        return;
+    }
+    if (req->rid)
+    {
+        if (req->rid > 1000) pw = getpwuid( req->rid - 1000 );
+    }
+    else
+    {
+        const WCHAR *name = get_req_data();
+        char aname[64];
+
+        len = get_req_data_size() / sizeof(WCHAR);
+        if (!len || len >= sizeof(aname))
+        {
+            set_error( STATUS_NONE_MAPPED );
+            return;
+        }
+        for (i = 0; i < len; i++)
+        {
+            if (name[i] >= 0x80 || !name[i])
+            {
+                set_error( STATUS_NONE_MAPPED );
+                return;
+            }
+            aname[i] = name[i];
+        }
+        aname[len] = 0;
+        /* Windows names are case-insensitive, Unix ones are normally lower case */
+        if (!(pw = getpwnam( aname )))
+        {
+            for (i = 0; i < len; i++) if (aname[i] >= 'A' && aname[i] <= 'Z') aname[i] += 'a' - 'A';
+            pw = getpwnam( aname );
+        }
+    }
+    if (!pw || !pw->pw_uid || pw->pw_uid == sg_system_prefix_uid || pw->pw_uid > 0xffffffffu - 1000)
+    {
+        set_error( STATUS_NONE_MAPPED );
+        return;
+    }
+    len = strlen( pw->pw_name );
+    if (len > ARRAY_SIZE(wname))
+    {
+        set_error( STATUS_NONE_MAPPED );
+        return;
+    }
+    for (i = 0; i < len; i++) wname[i] = (unsigned char)pw->pw_name[i];
+    reply->rid = 1000 + pw->pw_uid;
+    /* a caller looking up a name may not want it back */
+    if (len * sizeof(WCHAR) <= get_reply_max_size()) set_reply_data( wname, len * sizeof(WCHAR) );
+    else if (get_reply_max_size()) set_error( STATUS_BUFFER_TOO_SMALL );
+}
