+/* Stained Glass OS: the account behind a per-user SID (1000 + uid) or name */
+@REQ(sg_lookup_account)
+    unsigned int rid;             /* RID to look up, or 0 to look up the name */
+    VARARG(name,unicode_str);     /* account name, when rid is 0 */
+@REPLY
+    unsigned int rid;             /* the account's RID */
+    VARARG(name,unicode_str);     /* the account's name */
+@END
