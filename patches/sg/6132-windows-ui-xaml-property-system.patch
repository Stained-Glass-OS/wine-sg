+/* ---- DependencyObject ------------------------------------------------------------------ */
+
+static struct dobj *dobj_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct dobj, obj );
+}
+
+static HRESULT WINAPI dobj_GetValue( struct xiface *iface, IInspectable *dp, IInspectable **result )
+{
+    struct xaml_property *prop = xaml_property_from_inspectable( dp );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!prop) return E_INVALIDARG;
+    return dobj_get_value( dobj_from_iface( iface ), prop, result );
+}
+
+static HRESULT WINAPI dobj_SetValue( struct xiface *iface, IInspectable *dp, IInspectable *value )
+{
+    struct xaml_property *prop = xaml_property_from_inspectable( dp );
+
+    if (!prop) return E_INVALIDARG;
+    return dobj_set_value( dobj_from_iface( iface ), prop, value );
+}
+
+static HRESULT WINAPI dobj_ClearValue( struct xiface *iface, IInspectable *dp )
+{
+    struct xaml_property *prop = xaml_property_from_inspectable( dp );
+
+    if (!prop) return E_INVALIDARG;
+    return dobj_clear_value( dobj_from_iface( iface ), prop );
+}
+
+static HRESULT WINAPI dobj_ReadLocalValue( struct xiface *iface, IInspectable *dp, IInspectable **result )
+{
+    struct xaml_property *prop = xaml_property_from_inspectable( dp );
+    struct dvalue *value;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!prop) return E_INVALIDARG;
+    if ((value = find_value( dobj_from_iface( iface ), prop, FALSE )) && value->has_local)
+    {
+        if ((*result = value->local)) IInspectable_AddRef( *result );
+        return S_OK;
+    }
+    IInspectable_AddRef( (*result = xaml_unset_value()) );
+    return S_OK;
+}
+
+static HRESULT WINAPI dobj_GetAnimationBaseValue( struct xiface *iface, IInspectable *dp, IInspectable **result )
+{
+    /* no animations yet: the base value is the value */
+    return dobj_GetValue( iface, dp, result );
+}
+
+static HRESULT WINAPI dobj_get_Dispatcher( struct xiface *iface, IInspectable **value )
+{
+    FIXME( "%p, %p: no dispatcher yet\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
