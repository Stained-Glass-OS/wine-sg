+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Every XAML object is a DependencyObject: its properties are DependencyProperty objects
+ * (registered by our classes and by applications), and an object keeps the values set on it.  A
+ * property's value is the first of, in order: the value set on the object (local), the default
+ * made for it by its metadata's CreateDefaultValueCallback (once per object), the metadata's
+ * DefaultValue.  When the value changes, the property's own change function (our classes), the
+ * metadata's PropertyChangedCallback and the callbacks registered on the object for it are called.
+ *
+ * Interface definitions per upstream Wine's windows.ui.xaml.idl; the implementation is ours.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+DEFINE_GUID(IID_IDependencyObject,          0x5c526665, 0xf60e, 0x4912, 0xaf, 0x59, 0x5f, 0xe0, 0x68, 0x0f, 0x08, 0x9d);
+DEFINE_GUID(IID_IDependencyObject2,         0x29fed85d, 0x3d22, 0x43a1, 0xad, 0xd0, 0x17, 0x02, 0x7c, 0x08, 0xb2, 0x12);
+DEFINE_GUID(IID_IDependencyObjectFactory,   0x9a03af92, 0x7d8a, 0x4937, 0x88, 0x4f, 0xec, 0xf3, 0x4f, 0xe0, 0x2a, 0xcb);
+DEFINE_GUID(IID_IDependencyProperty,        0x85b13970, 0x9bc4, 0x4e96, 0xac, 0xf1, 0x30, 0xc8, 0xfd, 0x3d, 0x55, 0xc8);
+DEFINE_GUID(IID_IDependencyPropertyStatics, 0x49e5f28f, 0x8259, 0x4d5c, 0xaa, 0xe0, 0x83, 0xd5, 0x6d, 0xbb, 0x68, 0xd9);
+DEFINE_GUID(IID_IDependencyPropertyChangedEventArgs, 0x81212c2b, 0x24d0, 0x4957, 0xab, 0xc3, 0x22, 0x44, 0x70, 0xa9, 0x3a, 0x4e);
+DEFINE_GUID(IID_IPropertyMetadata,          0x814ef30d, 0x8d18, 0x448a, 0x86, 0x44, 0xf2, 0xcb, 0x51, 0xe7, 0x03, 0x80);
+DEFINE_GUID(IID_IPropertyMetadataFactory,   0xc1b81cc0, 0x57cd, 0x4f2f, 0xb0, 0xa9, 0xe1, 0x80, 0x1b, 0x28, 0xf7, 0x6b);
+DEFINE_GUID(IID_IPropertyValue_xaml,        0x4bd682dd, 0x7554, 0x40e9, 0x9a, 0x9b, 0x82, 0x65, 0x4e, 0xde, 0x7e, 0x62);
+DEFINE_GUID(IID_IPropertyMetadataStatics,   0x3b01077a, 0x6e06, 0x45e9, 0x8b, 0x5c, 0xaf, 0x24, 0x34, 0x58, 0xc0, 0x62);
+
+/* delegates: IUnknown, then Invoke */
+typedef HRESULT (WINAPI *create_default_fn)( IUnknown *delegate, IInspectable **result );
+typedef HRESULT (WINAPI *dp_changed_fn)( IUnknown *delegate, IInspectable *sender, IInspectable *dp );
+typedef HRESULT (WINAPI *property_changed_fn)( IUnknown *delegate, IInspectable *obj, IInspectable *args );
+#define DELEGATE_INVOKE(d) (((void **)(d)->lpVtbl)[3])
+
+static CRITICAL_SECTION props_cs;
+static CRITICAL_SECTION_DEBUG props_cs_debug =
+{
+    0, 0, &props_cs,
+    { &props_cs_debug.ProcessLocksList, &props_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": props_cs") }
+};
+static CRITICAL_SECTION props_cs = { &props_cs_debug, -1, 0, 0, 0, 0 };
+static struct list properties = LIST_INIT( properties );
+
+/* ---- the unset value -------------------------------------------------------- */
+
+static const struct xiface_entry unset_ifaces[] = { { &IID_IInspectable, 0 } };
+static const struct xclass unset_class = { L"Windows.UI.Xaml.DependencyProperty.UnsetValue", unset_ifaces, 0, NULL };
+static struct xobj unset_obj;
+static INIT_ONCE unset_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI init_unset( INIT_ONCE *once, void *param, void **context )
+{
+    xobj_init( &unset_obj, &unset_class, NULL );
+    unset_obj.ref = 0x10000;   /* never freed */
+    return TRUE;
+}
+
+IInspectable *xaml_unset_value(void)
+{
+    InitOnceExecuteOnce( &unset_once, init_unset, NULL, NULL );
+    return &unset_obj.IInspectable_inner;
+}
+
+static BOOL is_unset( IInspectable *value )
+{
+    IUnknown *unk;
+    BOOL ret;
+
+    if (!value) return FALSE;
+    if (value == xaml_unset_value()) return TRUE;
+    if (FAILED(IInspectable_QueryInterface( value, &IID_IUnknown, (void **)&unk ))) return FALSE;
+    ret = unk == (IUnknown *)xaml_unset_value();
+    IUnknown_Release( unk );
+    return ret;
+}
+
+/* ---- PropertyMetadata ------------------------------------------------------------ */
+
+struct xaml_metadata
+{
+    struct xobj obj;
+    struct xiface IPropertyMetadata_iface;
+    IInspectable *default_value;
+    IUnknown *create_default;       /* CreateDefaultValueCallback */
+    IUnknown *changed;              /* PropertyChangedCallback */
+};
+
+static const struct xiface_entry metadata_ifaces[] =
+{
+    { &IID_IPropertyMetadata, offsetof(struct xaml_metadata, IPropertyMetadata_iface) },
+};
+
+static void metadata_destroy( struct xobj *obj )
+{
+    struct xaml_metadata *md = CONTAINING_RECORD( obj, struct xaml_metadata, obj );
+
+    if (md->default_value) IInspectable_Release( md->default_value );
+    if (md->create_default) IUnknown_Release( md->create_default );
+    if (md->changed) IUnknown_Release( md->changed );
+}
+
+static const struct xclass metadata_class =
+{
+    L"Windows.UI.Xaml.PropertyMetadata", metadata_ifaces, ARRAY_SIZE(metadata_ifaces), metadata_destroy,
+};
+
+static struct xaml_metadata *metadata_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct xaml_metadata, obj );
+}
+
+static HRESULT WINAPI metadata_get_DefaultValue( struct xiface *iface, IInspectable **value )
+{
+    struct xaml_metadata *md = metadata_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if ((*value = md->default_value)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI metadata_get_CreateDefaultValueCallback( struct xiface *iface, IUnknown **value )
+{
+    struct xaml_metadata *md = metadata_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if ((*value = md->create_default)) IUnknown_AddRef( *value );
+    return S_OK;
+}
+
+static const void *metadata_vtbl[] = { XIFACE_COMMON, metadata_get_DefaultValue, metadata_get_CreateDefaultValueCallback };
+
+static struct xaml_metadata *metadata_from_inspectable( IInspectable *iface )
+{
+    struct xiface *md_iface;
+    struct xaml_metadata *md;
+
+    if (!iface || FAILED(IInspectable_QueryInterface( iface, &IID_IPropertyMetadata, (void **)&md_iface ))) return NULL;
+    if (md_iface->vtbl != metadata_vtbl)
+    {
+        IUnknown_Release( (IUnknown *)md_iface );
+        return NULL;
+    }
+    md = metadata_from_iface( md_iface );
+    IUnknown_Release( (IUnknown *)md_iface );
+    return md;
+}
+
+static HRESULT metadata_create( IInspectable *default_value, IUnknown *create_default, IUnknown *changed,
+                                IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct xaml_metadata *md;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(md = calloc( 1, sizeof(*md) ))) return E_OUTOFMEMORY;
+    md->IPropertyMetadata_iface.vtbl = metadata_vtbl;
+    if ((md->default_value = default_value)) IInspectable_AddRef( default_value );
+    if ((md->create_default = create_default)) IUnknown_AddRef( create_default );
+    if ((md->changed = changed)) IUnknown_AddRef( changed );
+    xobj_init( &md->obj, &metadata_class, outer );
+    if (outer)
+    {
+        *inner = &md->obj.IInspectable_inner;
+        IUnknown_AddRef( md->obj.outer );
+    }
+    *value = &md->IPropertyMetadata_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI metadata_factory_CreateInstanceWithDefaultValue( struct xfiface *iface, IInspectable *default_value,
+                                                                        IInspectable *outer, IInspectable **inner, void **value )
+{
+    return metadata_create( default_value, NULL, NULL, outer, inner, value );
+}
+
+static HRESULT WINAPI metadata_factory_CreateInstanceWithDefaultValueAndCallback( struct xfiface *iface,
+        IInspectable *default_value, IUnknown *changed, IInspectable *outer, IInspectable **inner, void **value )
+{
+    return metadata_create( default_value, NULL, changed, outer, inner, value );
+}
+
+static const void *metadata_factory_vtbl[] =
+{
+    XFIFACE_COMMON, metadata_factory_CreateInstanceWithDefaultValue, metadata_factory_CreateInstanceWithDefaultValueAndCallback,
+};
+
+static HRESULT WINAPI metadata_statics_CreateWithDefaultValue( struct xfiface *iface, IInspectable *default_value, void **result )
+{
+    return metadata_create( default_value, NULL, NULL, NULL, NULL, result );
+}
+
+static HRESULT WINAPI metadata_statics_CreateWithDefaultValueAndCallback( struct xfiface *iface, IInspectable *default_value,
+                                                                           IUnknown *changed, void **result )
+{
+    return metadata_create( default_value, NULL, changed, NULL, NULL, result );
+}
+
+static HRESULT WINAPI metadata_statics_CreateWithFactory( struct xfiface *iface, IUnknown *create_default, void **result )
+{
+    return metadata_create( NULL, create_default, NULL, NULL, NULL, result );
+}
+
+static HRESULT WINAPI metadata_statics_CreateWithFactoryAndCallback( struct xfiface *iface, IUnknown *create_default,
+                                                                      IUnknown *changed, void **result )
+{
+    return metadata_create( NULL, create_default, changed, NULL, NULL, result );
+}
+
+static const void *metadata_statics_vtbl[] =
+{
+    XFIFACE_COMMON, metadata_statics_CreateWithDefaultValue, metadata_statics_CreateWithDefaultValueAndCallback,
+    metadata_statics_CreateWithFactory, metadata_statics_CreateWithFactoryAndCallback,
+};
+
+static struct xfactory metadata_factory =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.PropertyMetadata",
+    { &IID_IPropertyMetadataFactory, &IID_IPropertyMetadataStatics },
+    { { metadata_factory_vtbl }, { metadata_statics_vtbl } },
+};
+
+IActivationFactory *property_metadata_factory = &metadata_factory.IActivationFactory_iface;
+
+/* ---- DependencyProperty ------------------------------------------------------------ */
+
+static const struct xiface_entry property_ifaces[] =
+{
+    { &IID_IDependencyProperty, offsetof(struct xaml_property, IDependencyProperty_iface) },
+};
+
+static const struct xclass property_class =
+{
+    L"Windows.UI.Xaml.DependencyProperty", property_ifaces, ARRAY_SIZE(property_ifaces), NULL,
+};
+
+static struct xaml_property *property_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct xaml_property, obj );
+}
+
+static HRESULT WINAPI property_GetMetadata( struct xiface *iface, struct xaml_type_name type, IInspectable **result )
+{
+    struct xaml_property *prop = property_from_iface( iface );
+
+    if (!result) return E_POINTER;
+    if ((*result = prop->metadata)) IInspectable_AddRef( *result );
+    return S_OK;
+}
+
+static const void *property_vtbl[] = { XIFACE_COMMON, property_GetMetadata };
+
+struct xaml_property *xaml_property_from_inspectable( IInspectable *iface )
+{
+    struct xiface *prop_iface;
+    struct xaml_property *prop;
+
+    if (!iface || FAILED(IInspectable_QueryInterface( iface, &IID_IDependencyProperty, (void **)&prop_iface ))) return NULL;
+    if (prop_iface->vtbl != property_vtbl)
+    {
+        IUnknown_Release( (IUnknown *)prop_iface );
+        return NULL;
+    }
+    prop = property_from_iface( prop_iface );
+    IUnknown_Release( (IUnknown *)prop_iface );
+    return prop;
+}
+
+IInspectable *xaml_property_iface( struct xaml_property *prop )
+{
+    return (IInspectable *)&prop->IDependencyProperty_iface;
+}
+
+static WCHAR *type_name_dup( HSTRING name )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( name, NULL );
+    return wcsdup( str ? str : L"" );
+}
+
+static struct xaml_property *property_new( const WCHAR *name, const WCHAR *type, const WCHAR *owner, IInspectable *metadata,
+                                           BOOL attached )
+{
+    struct xaml_property *prop;
+
+    if (!(prop = calloc( 1, sizeof(*prop) ))) return NULL;
+    prop->IDependencyProperty_iface.vtbl = property_vtbl;
+    xobj_init( &prop->obj, &property_class, NULL );
+    prop->obj.ref = 0x10000;   /* properties live as long as the process */
+    prop->name = wcsdup( name ? name : L"" );
+    prop->type = wcsdup( type ? type : L"" );
+    prop->owner = wcsdup( owner ? owner : L"" );
+    if ((prop->metadata = metadata)) IInspectable_AddRef( metadata );
+    prop->attached = attached;
+    EnterCriticalSection( &props_cs );
+    list_add_tail( &properties, &prop->entry );
+    LeaveCriticalSection( &props_cs );
+    TRACE( "%s.%s (%s)%s\n", debugstr_w( prop->owner ), debugstr_w( prop->name ), debugstr_w( prop->type ),
+           attached ? " attached" : "" );
+    return prop;
+}
+
+/* one of our classes' properties: its default value (given) and its change function */
+struct xaml_property *xaml_property_register( const WCHAR *owner, const WCHAR *name, const WCHAR *type,
+                                              IInspectable *default_value, BOOL attached,
+                                              void (*changed)( struct dobj *, struct xaml_property *, IInspectable *, IInspectable * ) )
+{
+    struct xaml_property *prop;
+    IInspectable *metadata = NULL;
+
+    if (default_value && FAILED(metadata_create( default_value, NULL, NULL, NULL, NULL, (void **)&metadata ))) return NULL;
+    prop = property_new( name, type, owner, metadata, attached );
+    if (metadata) IInspectable_Release( metadata );
+    if (prop) prop->changed = changed;
+    return prop;
+}
+
+struct xaml_property *xaml_property_find( const WCHAR *owner, const WCHAR *name )
+{
+    struct xaml_property *prop, *ret = NULL;
+
+    EnterCriticalSection( &props_cs );
+    LIST_FOR_EACH_ENTRY( prop, &properties, struct xaml_property, entry )
+    {
+        if (!wcscmp( prop->name, name ) && (!owner || !wcscmp( prop->owner, owner ))) { ret = prop; break; }
+    }
+    LeaveCriticalSection( &props_cs );
+    return ret;
+}
+
+static HRESULT WINAPI property_statics_get_UnsetValue( struct xfiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    *value = xaml_unset_value();
+    IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT property_register( HSTRING name, struct xaml_type_name type, struct xaml_type_name owner,
+                                  IInspectable *metadata, BOOL attached, IInspectable **result )
+{
+    struct xaml_property *prop;
+    WCHAR *type_str, *owner_str;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!WindowsGetStringLen( name )) return E_INVALIDARG;
+    if (metadata && !metadata_from_inspectable( metadata ))
+        FIXME( "metadata %p is not ours\n", metadata );   /* an application's derived metadata: kept as given */
+    type_str = type_name_dup( type.Name );
+    owner_str = type_name_dup( owner.Name );
+    prop = property_new( WindowsGetStringRawBuffer( name, NULL ), type_str, owner_str, metadata, attached );
+    free( type_str );
+    free( owner_str );
+    if (!prop) return E_OUTOFMEMORY;
+    *result = xaml_property_iface( prop );
+    IInspectable_AddRef( *result );
+    return S_OK;
+}
+
+static HRESULT WINAPI property_statics_Register( struct xfiface *iface, HSTRING name, struct xaml_type_name type,
+                                                 struct xaml_type_name owner, IInspectable *metadata, IInspectable **result )
+{
+    return property_register( name, type, owner, metadata, FALSE, result );
+}
+
+static HRESULT WINAPI property_statics_RegisterAttached( struct xfiface *iface, HSTRING name, struct xaml_type_name type,
+                                                         struct xaml_type_name owner, IInspectable *metadata, IInspectable **result )
+{
+    return property_register( name, type, owner, metadata, TRUE, result );
+}
+
+static const void *property_statics_vtbl[] =
+{
+    XFIFACE_COMMON, property_statics_get_UnsetValue, property_statics_Register, property_statics_RegisterAttached,
+};
+
+static struct xfactory property_factory =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.DependencyProperty",
+    { &IID_IDependencyPropertyStatics },
+    { { property_statics_vtbl } },
+};
+
+IActivationFactory *dependency_property_factory = &property_factory.IActivationFactory_iface;
+
+/* ---- DependencyPropertyChangedEventArgs ------------------------------------------------- */
+
+struct changed_args
+{
+    struct xobj obj;
+    struct xiface IDependencyPropertyChangedEventArgs_iface;
+    struct xaml_property *prop;
+    IInspectable *old_value, *new_value;
+};
+
+static const struct xiface_entry args_ifaces[] =
+{
+    { &IID_IDependencyPropertyChangedEventArgs, offsetof(struct changed_args, IDependencyPropertyChangedEventArgs_iface) },
+};
+
+static void args_destroy( struct xobj *obj )
+{
+    struct changed_args *args = CONTAINING_RECORD( obj, struct changed_args, obj );
+
+    if (args->old_value) IInspectable_Release( args->old_value );
+    if (args->new_value) IInspectable_Release( args->new_value );
+}
+
+static const struct xclass args_class =
+{
+    L"Windows.UI.Xaml.DependencyPropertyChangedEventArgs", args_ifaces, ARRAY_SIZE(args_ifaces), args_destroy,
+};
+
+static struct changed_args *args_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct changed_args, obj );
+}
+
