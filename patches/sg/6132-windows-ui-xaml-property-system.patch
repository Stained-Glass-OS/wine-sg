+static const void *args_vtbl[] = { XIFACE_COMMON, args_get_Property, args_get_OldValue, args_get_NewValue };
+
+/* ---- values -------------------------------------------------------------------------- */
+
+struct dvalue
+{
+    struct list entry;
+    struct xaml_property *prop;
+    BOOL has_local;
+    IInspectable *local;            /* set on the object (may be null) */
+    IInspectable *made_default;     /* by the metadata's CreateDefaultValueCallback */
+};
+
+struct dcallback
+{
+    struct list entry;
+    struct xaml_property *prop;
+    INT64 token;
+    IUnknown *callback;             /* DependencyPropertyChangedCallback */
+};
+
+static struct dvalue *find_value( struct dobj *obj, struct xaml_property *prop, BOOL create )
+{
+    struct dvalue *value;
+
+    LIST_FOR_EACH_ENTRY( value, &obj->values, struct dvalue, entry )
+        if (value->prop == prop) return value;
+    if (!create || !(value = calloc( 1, sizeof(*value) ))) return NULL;
+    value->prop = prop;
+    list_add_tail( &obj->values, &value->entry );
+    return value;
+}
+
+/* boxed values compare by value (Windows does not report a change to an equal value) */
+static BOOL values_equal( IInspectable *a, IInspectable *b )
+{
+    IPropertyValue *pa = NULL, *pb = NULL;
+    PropertyType ta, tb;
+    BOOL ret = FALSE;
+
+    if (a == b) return TRUE;
+    if (!a || !b) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( a, &IID_IPropertyValue_xaml, (void **)&pa ))) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( b, &IID_IPropertyValue_xaml, (void **)&pb ))) goto done;
+    if (FAILED(IPropertyValue_get_Type( pa, &ta )) || FAILED(IPropertyValue_get_Type( pb, &tb )) || ta != tb) goto done;
+    switch (ta)
+    {
+    case PropertyType_Boolean:
+    {
+        boolean x, y;
+        ret = SUCCEEDED(IPropertyValue_GetBoolean( pa, &x )) && SUCCEEDED(IPropertyValue_GetBoolean( pb, &y )) && x == y;
+        break;
+    }
+    case PropertyType_Int32:
+    {
+        INT32 x, y;
+        ret = SUCCEEDED(IPropertyValue_GetInt32( pa, &x )) && SUCCEEDED(IPropertyValue_GetInt32( pb, &y )) && x == y;
+        break;
+    }
+    case PropertyType_UInt32:
+    {
+        UINT32 x, y;
+        ret = SUCCEEDED(IPropertyValue_GetUInt32( pa, &x )) && SUCCEEDED(IPropertyValue_GetUInt32( pb, &y )) && x == y;
+        break;
+    }
+    case PropertyType_Int64:
+    {
+        INT64 x, y;
+        ret = SUCCEEDED(IPropertyValue_GetInt64( pa, &x )) && SUCCEEDED(IPropertyValue_GetInt64( pb, &y )) && x == y;
+        break;
+    }
+    case PropertyType_Double:
+    {
+        DOUBLE x, y;
+        ret = SUCCEEDED(IPropertyValue_GetDouble( pa, &x )) && SUCCEEDED(IPropertyValue_GetDouble( pb, &y )) && x == y;
+        break;
+    }
+    case PropertyType_Single:
+    {
+        FLOAT x, y;
+        ret = SUCCEEDED(IPropertyValue_GetSingle( pa, &x )) && SUCCEEDED(IPropertyValue_GetSingle( pb, &y )) && x == y;
+        break;
+    }
+    case PropertyType_String:
+    {
+        HSTRING x = NULL, y = NULL;
+        INT32 order = 1;
+        if (SUCCEEDED(IPropertyValue_GetString( pa, &x )) && SUCCEEDED(IPropertyValue_GetString( pb, &y )))
+            ret = SUCCEEDED(WindowsCompareStringOrdinal( x, y, &order )) && !order;
+        WindowsDeleteString( x );
+        WindowsDeleteString( y );
+        break;
+    }
+    default:
+        break;
+    }
+done:
+    if (pa) IPropertyValue_Release( pa );
+    if (pb) IPropertyValue_Release( pb );
+    return ret;
+}
+
+static struct xaml_metadata *property_metadata( struct xaml_property *prop )
+{
+    return metadata_from_inspectable( prop->metadata );
+}
+
+/* the effective value, with a reference (NULL is a value) */
+HRESULT dobj_get_value( struct dobj *obj, struct xaml_property *prop, IInspectable **result )
+{
+    struct xaml_metadata *md = property_metadata( prop );
+    struct dvalue *value = find_value( obj, prop, FALSE );
+    IInspectable *ret = NULL;
+    HRESULT hr;
+
+    *result = NULL;
+    if (value && value->has_local) ret = value->local;
+    else if (value && value->made_default) ret = value->made_default;
+    else if (md && md->create_default)
+    {
+        if (FAILED(hr = ((create_default_fn)DELEGATE_INVOKE( md->create_default ))( md->create_default, &ret ))) return hr;
+        if (!(value = find_value( obj, prop, TRUE )))
+        {
+            if (ret) IInspectable_Release( ret );
+            return E_OUTOFMEMORY;
+        }
+        value->made_default = ret;   /* keeps the reference */
+    }
+    else if (md) ret = md->default_value;
+    if ((*result = ret)) IInspectable_AddRef( ret );
+    return S_OK;
+}
+
+static void notify_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct xaml_metadata *md = property_metadata( prop );
+    IInspectable *sender = (IInspectable *)&obj->IDependencyObject_iface;
+    struct dcallback *cb, *next;
+
+    TRACE( "%p %s.%s\n", obj, debugstr_w( prop->owner ), debugstr_w( prop->name ) );
+    if (prop->changed) prop->changed( obj, prop, old_value, new_value );
+    if (md && md->changed)
+    {
+        struct changed_args *args;
+
+        if ((args = calloc( 1, sizeof(*args) )))
+        {
+            args->IDependencyPropertyChangedEventArgs_iface.vtbl = args_vtbl;
+            args->prop = prop;
+            if ((args->old_value = old_value)) IInspectable_AddRef( old_value );
+            if ((args->new_value = new_value)) IInspectable_AddRef( new_value );
+            xobj_init( &args->obj, &args_class, NULL );
+            ((property_changed_fn)DELEGATE_INVOKE( md->changed ))( md->changed, sender,
+                    (IInspectable *)&args->IDependencyPropertyChangedEventArgs_iface );
+            IInspectable_Release( &args->obj.IInspectable_inner );
+        }
+    }
+    IUnknown_AddRef( obj->obj.outer );
+    LIST_FOR_EACH_ENTRY_SAFE( cb, next, &obj->callbacks, struct dcallback, entry )
+    {
+        IUnknown *callback;
+        if (cb->prop != prop) continue;
+        callback = cb->callback;
+        IUnknown_AddRef( callback );
+        ((dp_changed_fn)DELEGATE_INVOKE( callback ))( callback, sender, xaml_property_iface( prop ) );
+        IUnknown_Release( callback );
+    }
+    IUnknown_Release( obj->obj.outer );
+}
+
+static HRESULT set_local( struct dobj *obj, struct xaml_property *prop, BOOL has_local, IInspectable *new_local )
+{
+    IInspectable *old_value, *new_value;
+    struct dvalue *value;
+    HRESULT hr;
+
+    if (FAILED(hr = dobj_get_value( obj, prop, &old_value ))) return hr;
+    if (!(value = find_value( obj, prop, has_local )))
+    {
+        if (old_value) IInspectable_Release( old_value );
+        return has_local ? E_OUTOFMEMORY : S_OK;   /* nothing to clear */
+    }
+    if (new_local) IInspectable_AddRef( new_local );
+    if (value->local) IInspectable_Release( value->local );
+    value->local = new_local;
+    value->has_local = has_local;
+#ifdef SG_MUTANT_DP_NO_LOCAL_VALUE
+    if (value->local) IInspectable_Release( value->local );
+    value->local = NULL;
+    value->has_local = FALSE;
+#endif
+    if (SUCCEEDED(dobj_get_value( obj, prop, &new_value )))
+    {
+        if (!values_equal( old_value, new_value )) notify_changed( obj, prop, old_value, new_value );
+        if (new_value) IInspectable_Release( new_value );
+    }
+    if (old_value) IInspectable_Release( old_value );
+    return S_OK;
+}
+
+/* a local value: null is a value (it is not unset); UnsetValue clears it */
+HRESULT dobj_set_value( struct dobj *obj, struct xaml_property *prop, IInspectable *value )
+{
+    if (is_unset( value )) return set_local( obj, prop, FALSE, NULL );
+    return set_local( obj, prop, TRUE, value );
+}
+
+HRESULT dobj_clear_value( struct dobj *obj, struct xaml_property *prop )
+{
+    return set_local( obj, prop, FALSE, NULL );
+}
