+static HRESULT WINAPI dobj2_RegisterPropertyChangedCallback( struct xiface *iface, IInspectable *dp, IUnknown *callback,
+                                                             INT64 *token )
+{
+    struct xaml_property *prop = xaml_property_from_inspectable( dp );
+    struct dobj *obj = dobj_from_iface( iface );
+    struct dcallback *cb;
+
+    if (!token) return E_POINTER;
+    if (!prop || !callback) return E_INVALIDARG;
+    if (!(cb = calloc( 1, sizeof(*cb) ))) return E_OUTOFMEMORY;
+    cb->prop = prop;
+    cb->token = ++obj->next_token;
+    cb->callback = callback;
+    IUnknown_AddRef( callback );
+    list_add_tail( &obj->callbacks, &cb->entry );
+    *token = cb->token;
+    return S_OK;
+}
+
+static HRESULT WINAPI dobj2_UnregisterPropertyChangedCallback( struct xiface *iface, IInspectable *dp, INT64 token )
+{
+    struct dobj *obj = dobj_from_iface( iface );
+    struct dcallback *cb;
+
+    LIST_FOR_EACH_ENTRY( cb, &obj->callbacks, struct dcallback, entry )
+    {
+        if (cb->token != token) continue;
+        list_remove( &cb->entry );
+        IUnknown_Release( cb->callback );
+        free( cb );
+        break;
+    }
+    return S_OK;
+}
+
+static const void *dobj2_vtbl[] =
+{
+    XIFACE_COMMON, dobj2_RegisterPropertyChangedCallback, dobj2_UnregisterPropertyChangedCallback,
+};
+
+void dobj_init( struct dobj *obj, const struct xclass *cls, IInspectable *outer )
+{
+    obj->IDependencyObject_iface.vtbl = dobj_vtbl;
+    obj->IDependencyObject2_iface.vtbl = dobj2_vtbl;
+    list_init( &obj->values );
+    list_init( &obj->callbacks );
+    xobj_init( &obj->obj, cls, outer );
+}
+
+void dobj_cleanup( struct dobj *obj )
+{
+    struct dvalue *value, *next_value;
+    struct dcallback *cb, *next_cb;
+
+    LIST_FOR_EACH_ENTRY_SAFE( value, next_value, &obj->values, struct dvalue, entry )
+    {
+        list_remove( &value->entry );
+        if (value->local) IInspectable_Release( value->local );
+        if (value->made_default) IInspectable_Release( value->made_default );
+        free( value );
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( cb, next_cb, &obj->callbacks, struct dcallback, entry )
+    {
+        list_remove( &cb->entry );
+        IUnknown_Release( cb->callback );
+        free( cb );
+    }
+}
+
+struct dobj *dobj_from_inspectable( IInspectable *iface )
+{
+    struct xiface *dobj_iface;
+    struct dobj *obj;
+
+    if (!iface || FAILED(IInspectable_QueryInterface( iface, &IID_IDependencyObject, (void **)&dobj_iface ))) return NULL;
+    if (dobj_iface->vtbl != dobj_vtbl)
+    {
+        IUnknown_Release( (IUnknown *)dobj_iface );
+        return NULL;
+    }
+    obj = dobj_from_iface( dobj_iface );
+    IUnknown_Release( (IUnknown *)dobj_iface );
+    return obj;
+}
+
+/* DependencyObject itself (an application derives its own from it) */
+
+static const struct xiface_entry dependency_object_ifaces[] = { DOBJ_IFACES(struct dobj) };
+
+static void dependency_object_destroy( struct xobj *obj )
+{
+    dobj_cleanup( CONTAINING_RECORD( obj, struct dobj, obj ) );
+}
+
+static const struct xclass dependency_object_class =
+{
+    L"Windows.UI.Xaml.DependencyObject", dependency_object_ifaces, ARRAY_SIZE(dependency_object_ifaces),
+    dependency_object_destroy,
+};
