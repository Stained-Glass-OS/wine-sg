From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: the property system -- DependencyObject, DependencyProperty, PropertyMetadata

Every XAML element is a DependencyObject whose properties are DependencyProperty objects; there was none. DependencyProperty.Register/RegisterAttached/UnsetValue/GetMetadata; PropertyMetadata (composable; default value, default-value factory, change callback); DependencyObject (composable -- applications derive their own): GetValue (local value, then the factory's default made once per object, then the metadata's default), SetValue (null is a value, UnsetValue clears), ClearValue, ReadLocalValue, GetAnimationBaseValue, Register/UnregisterPropertyChangedCallback; a change (equal boxed values are not one) calls our class's own change function, the metadata's PropertyChangedCallback with DependencyPropertyChangedEventArgs, and the registered callbacks. Interface definitions per upstream Wine's windows.ui.xaml.idl; the implementation is ours. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/Makefile.in b/dlls/windows.ui.xaml/Makefile.in
index fbb3e1d..5b64a09 100644
--- a/dlls/windows.ui.xaml/Makefile.in
+++ b/dlls/windows.ui.xaml/Makefile.in
@@ -4,6 +4,7 @@ IMPORTS = combase user32 advapi32 uuid
 SOURCES = \
 	application.c \
 	classes.idl \
+	dependency.c \
 	factory.c \
 	hosting.c \
 	main.c \
diff --git a/dlls/windows.ui.xaml/classes.idl b/dlls/windows.ui.xaml/classes.idl
index 7d2d24b..f476a69 100644
--- a/dlls/windows.ui.xaml/classes.idl
+++ b/dlls/windows.ui.xaml/classes.idl
@@ -52,6 +52,64 @@ namespace Windows.UI.Xaml {
         [default] interface Windows.UI.Xaml.IApplication;
     }
 
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(5c526665-f60e-4912-af59-5fe0680f089d)]
+    interface IDependencyObject : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(9a03af92-7d8a-4937-884f-ecf34fe02acb)]
+    interface IDependencyObjectFactory : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(85b13970-9bc4-4e96-acf1-30c8fd3d55c8)]
+    interface IDependencyProperty : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(49e5f28f-8259-4d5c-aae0-83d56dbb68d9)]
+    interface IDependencyPropertyStatics : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(814ef30d-8d18-448a-8644-f2cb51e70380)]
+    interface IPropertyMetadata : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(c1b81cc0-57cd-4f2f-b0a9-e1801b28f76b)]
+    interface IPropertyMetadataFactory : IInspectable {}
+
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(3b01077a-6e06-45e9-8b5c-af243458c062)]
+    interface IPropertyMetadataStatics : IInspectable {}
+
+    /* composable ("protected") only on Windows; widl registers a class only when it is activatable
+     * or has statics, so it is marked activatable here (ActivateInstance answers E_NOTIMPL) */
+    [
+        activatable(Windows.Foundation.UniversalApiContract, 1.0),
+        composable(Windows.UI.Xaml.IDependencyObjectFactory, protected, Windows.Foundation.UniversalApiContract, 1.0),
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        marshaling_behavior(agile),
+        threading(both)
+    ]
+    runtimeclass DependencyObject
+    {
+        [default] interface Windows.UI.Xaml.IDependencyObject;
+    }
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        marshaling_behavior(agile),
+        static(Windows.UI.Xaml.IDependencyPropertyStatics, Windows.Foundation.UniversalApiContract, 1.0),
+        threading(both)
+    ]
+    runtimeclass DependencyProperty
+    {
+        [default] interface Windows.UI.Xaml.IDependencyProperty;
+    }
+
+    [
+        composable(Windows.UI.Xaml.IPropertyMetadataFactory, public, Windows.Foundation.UniversalApiContract, 1.0),
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        marshaling_behavior(agile),
+        static(Windows.UI.Xaml.IPropertyMetadataStatics, Windows.Foundation.UniversalApiContract, 1.0),
+        threading(both)
+    ]
+    runtimeclass PropertyMetadata
+    {
+        [default] interface Windows.UI.Xaml.IPropertyMetadata;
+    }
+
     [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(3276167d-c9f6-462d-9de2-ae4c1fd8c2e5)]
     interface IWindow : IInspectable {}
 
diff --git a/dlls/windows.ui.xaml/dependency.c b/dlls/windows.ui.xaml/dependency.c
new file mode 100644
index 0000000..83f8bfd
--- /dev/null
+++ b/dlls/windows.ui.xaml/dependency.c
@@ -0,0 +1,875 @@
+/*
+ * Windows.UI.Xaml property system: DependencyObject, DependencyProperty, PropertyMetadata
+ *
+ * Copyright 2026 Stained Glass OS
+ *
