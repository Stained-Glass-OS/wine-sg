+static HRESULT WINAPI dobj_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner,
+                                                   void **value )
+{
+    struct dobj *obj;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(obj = calloc( 1, sizeof(*obj) ))) return E_OUTOFMEMORY;
+    dobj_init( obj, &dependency_object_class, outer );
+    if (outer)
+    {
+        *inner = &obj->obj.IInspectable_inner;
+        IUnknown_AddRef( obj->obj.outer );
+    }
+    *value = &obj->IDependencyObject_iface;
+    return S_OK;
+}
