+static const void *dobj_vtbl[] =
+{
+    XIFACE_COMMON, dobj_GetValue, dobj_SetValue, dobj_ClearValue, dobj_ReadLocalValue, dobj_GetAnimationBaseValue,
+    dobj_get_Dispatcher,
