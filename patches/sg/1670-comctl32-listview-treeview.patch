+/* Stained Glass OS 1670: the incremental search string, while a search
+ * goes on: its length (the string copied), else 0 */
+static LRESULT
+TREEVIEW_GetISearchString(const TREEVIEW_INFO *infoPtr, void *buffer, BOOL unicode)
+{
+    INT len = infoPtr->nSearchParamLength;
+
+    if (!len || GetTickCount() - infoPtr->lastKeyPressTimestamp > KEY_DELAY) return 0;
+    if (!buffer) return len;
+    if (unicode)
+    {
+        memcpy(buffer, infoPtr->szSearchParam, len * sizeof(WCHAR));
+        ((WCHAR *)buffer)[len] = 0;
+    }
+    else
+    {
+        INT n = WideCharToMultiByte(CP_ACP, 0, infoPtr->szSearchParam, len, buffer, MAX_PATH - 1, NULL, NULL);
+        ((char *)buffer)[n] = 0;
+    }
+    return len;
+}
