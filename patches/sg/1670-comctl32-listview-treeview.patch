+/* a picture file (or URL) as a bitmap: a .bmp directly, else OLE's picture loader */
+static HBITMAP LISTVIEW_LoadBkImage(const WCHAR *url)
+{
+    static HRESULT (WINAPI *load_path)(LPOLESTR, LPUNKNOWN, DWORD, OLE_COLOR, REFIID, LPVOID *);
+    HBITMAP bmp;
+    IPicture *pic;
+    OLE_HANDLE handle;
+    short type;
+
+    if ((bmp = LoadImageW(NULL, url, IMAGE_BITMAP, 0, 0, LR_LOADFROMFILE | LR_CREATEDIBSECTION))) return bmp;
+    if (!load_path)
+    {
+        HMODULE oleaut = LoadLibraryW(L"oleaut32.dll");
+        if (oleaut) load_path = (void *)GetProcAddress(oleaut, "OleLoadPicturePath");
+    }
+    if (!load_path || FAILED(load_path((LPOLESTR)url, NULL, 0, 0, &IID_IPicture, (void **)&pic))) return NULL;
+    if (SUCCEEDED(IPicture_get_Type(pic, &type)) && type == PICTYPE_BITMAP &&
+        SUCCEEDED(IPicture_get_Handle(pic, &handle)))
+        bmp = CopyImage((HBITMAP)(UINT_PTR)handle, IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION);
+    IPicture_Release(pic);
+    return bmp;
+}
