+/* Stained Glass OS 1670: the insertion mark's rectangle, in client
+ * coordinates: a bar before or after its item */
+static BOOL LISTVIEW_GetInsertMarkRect(const LISTVIEW_INFO *infoPtr, RECT *rect)
+{
+    RECT box;
+    INT edge;
+
+    if (infoPtr->insertMark.iItem < 0 || infoPtr->insertMark.iItem >= infoPtr->nItemCount) return FALSE;
+    LISTVIEW_GetItemBox(infoPtr, infoPtr->insertMark.iItem, &box);
+    if (infoPtr->uView == LV_VIEW_DETAILS)
+    {
+        edge = (infoPtr->insertMark.dwFlags & LVIM_AFTER) ? box.bottom : box.top;
+        SetRect(rect, box.left, edge - 2, box.right, edge + 2);
+    }
+    else
+    {
+        edge = (infoPtr->insertMark.dwFlags & LVIM_AFTER) ? box.right : box.left;
+        SetRect(rect, edge - 2, box.top, edge + 2, box.bottom);
+    }
+    return TRUE;
+}
+
+static void LISTVIEW_DrawInsertMark(const LISTVIEW_INFO *infoPtr, HDC hdc)
+{
+    COLORREF color = infoPtr->clrInsertMark == CLR_DEFAULT ? GetSysColor(COLOR_WINDOWTEXT) : infoPtr->clrInsertMark;
+    HBRUSH brush;
+    RECT rc, part;
+
+    if (!LISTVIEW_GetInsertMarkRect(infoPtr, &rc)) return;
+    brush = CreateSolidBrush(color);
+    if (infoPtr->uView == LV_VIEW_DETAILS)
+    {
+        /* the line, and ticks at its ends */
+        SetRect(&part, rc.left, rc.top + 1, rc.right, rc.bottom - 1);
+        FillRect(hdc, &part, brush);
+        SetRect(&part, rc.left, rc.top - 2, rc.left + 2, rc.bottom + 2);
+        FillRect(hdc, &part, brush);
+        SetRect(&part, rc.right - 2, rc.top - 2, rc.right, rc.bottom + 2);
+        FillRect(hdc, &part, brush);
+    }
+    else
+    {
+        SetRect(&part, rc.left + 1, rc.top, rc.right - 1, rc.bottom);
+        FillRect(hdc, &part, brush);
+        SetRect(&part, rc.left - 2, rc.top, rc.right + 2, rc.top + 2);
+        FillRect(hdc, &part, brush);
+        SetRect(&part, rc.left - 2, rc.bottom - 2, rc.right + 2, rc.bottom);
+        FillRect(hdc, &part, brush);
+    }
+    DeleteObject(brush);
+}
+
+static void LISTVIEW_InvalidateInsertMark(const LISTVIEW_INFO *infoPtr)
+{
+    RECT rc;
+    if (!LISTVIEW_GetInsertMarkRect(infoPtr, &rc)) return;
+    InflateRect(&rc, 3, 3);
+    InvalidateRect(infoPtr->hwndSelf, &rc, TRUE);
+}
+
+static BOOL LISTVIEW_SetInsertMark(LISTVIEW_INFO *infoPtr, const LVINSERTMARK *mark)
+{
+    if (!mark || mark->cbSize != sizeof(*mark) || mark->iItem < -1 || mark->iItem >= infoPtr->nItemCount)
+        return FALSE;
+    LISTVIEW_InvalidateInsertMark(infoPtr);
+    infoPtr->insertMark.iItem = mark->iItem;
+    infoPtr->insertMark.dwFlags = mark->dwFlags & LVIM_AFTER;
+    LISTVIEW_InvalidateInsertMark(infoPtr);
+    return TRUE;
+}
+
+static BOOL LISTVIEW_GetInsertMark(const LISTVIEW_INFO *infoPtr, LVINSERTMARK *mark)
+{
+    if (!mark || mark->cbSize != sizeof(*mark)) return FALSE;
+    mark->iItem = infoPtr->insertMark.iItem;
+    mark->dwFlags = infoPtr->insertMark.dwFlags;
+    mark->dwReserved = 0;
+    return TRUE;
+}
+
+/* the insertion point nearest a point: before or after the nearest item */
+static INT LISTVIEW_InsertMarkHitTest(const LISTVIEW_INFO *infoPtr, const POINT *pt, LVINSERTMARK *mark)
+{
+    INT i, best = -1;
+    LONGLONG best_dist = 0;
+    RECT box;
+
+    if (!pt || !mark || mark->cbSize != sizeof(*mark)) return FALSE;
+    mark->iItem = -1;
+    mark->dwFlags = 0;
+    for (i = 0; i < infoPtr->nItemCount; i++)
+    {
+        LONGLONG dx, dy, dist;
+
+        LISTVIEW_GetItemBox(infoPtr, i, &box);
+        dx = pt->x < box.left ? box.left - pt->x : pt->x > box.right ? pt->x - box.right : 0;
+        dy = pt->y < box.top ? box.top - pt->y : pt->y > box.bottom ? pt->y - box.bottom : 0;
+        dist = dx * dx + dy * dy;
+        if (best < 0 || dist < best_dist)
+        {
+            best = i;
+            best_dist = dist;
+        }
+    }
+    if (best < 0) return FALSE;
+    LISTVIEW_GetItemBox(infoPtr, best, &box);
+    mark->iItem = best;
+    if (infoPtr->uView == LV_VIEW_DETAILS ? pt->y > (box.top + box.bottom) / 2 : pt->x > (box.left + box.right) / 2)
+        mark->dwFlags = LVIM_AFTER;
+    return TRUE;
+}
+
+/* the incremental search string, while a search goes on */
+static INT LISTVIEW_GetISearchString(const LISTVIEW_INFO *infoPtr, void *buffer, BOOL unicode)
+{
+    INT len = infoPtr->nSearchParamLength;
+
+    if (!len || GetTickCount() - infoPtr->lastKeyPressTimestamp > KEY_DELAY) return 0;
+    if (!buffer) return len;
+    if (unicode)
+    {
+        memcpy(buffer, infoPtr->szSearchParam, len * sizeof(WCHAR));
+        ((WCHAR *)buffer)[len] = 0;
+    }
+    else
+    {
+        INT n = WideCharToMultiByte(CP_ACP, 0, infoPtr->szSearchParam, len, buffer, MAX_PATH - 1, NULL, NULL);
+        ((char *)buffer)[n] = 0;
+    }
+    return len;
+}
+
+static BOOL LISTVIEW_SetWorkAreas(LISTVIEW_INFO *infoPtr, INT count, const RECT *areas)
+{
+    if (count < 0 || count > LV_WORKAREAS_MAX || (count && !areas)) return FALSE;
+    if (count) memcpy(infoPtr->workAreas, areas, count * sizeof(RECT));
+    infoPtr->nWorkAreas = count;
+    if (is_icon_view(infoPtr) && (infoPtr->dwStyle & LVS_AUTOARRANGE))
+        LISTVIEW_Arrange(infoPtr, LVA_DEFAULT);
+    InvalidateRect(infoPtr->hwndSelf, NULL, TRUE);
+    return TRUE;
+}
+
+static BOOL LISTVIEW_GetWorkAreas(const LISTVIEW_INFO *infoPtr, INT count, RECT *areas)
+{
+    if (count < 0 || (count && !areas)) return FALSE;
+    if (count) memcpy(areas, infoPtr->workAreas, min(count, infoPtr->nWorkAreas) * sizeof(RECT));
+    return TRUE;
+}
+
+/* LVM_SETINFOTIP: an item's (or subitem's) tip, given to LVN_GETINFOTIP */
+struct infotip
+{
+    INT item, subitem;
+    WCHAR text[INFOTIPSIZE];
+};
+
+static BOOL LISTVIEW_SetInfoTip(LISTVIEW_INFO *infoPtr, const LVSETINFOTIP *tip)
+{
+    struct infotip *entry = NULL;
+    INT i;
+
+    if (!tip || tip->cbSize != sizeof(*tip) || tip->iItem < 0 || tip->iItem >= infoPtr->nItemCount) return FALSE;
+    if (!infoPtr->hdpaInfoTips && !(infoPtr->hdpaInfoTips = DPA_Create(4))) return FALSE;
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaInfoTips); i++)
+    {
+        struct infotip *t = DPA_GetPtr(infoPtr->hdpaInfoTips, i);
+        if (t->item == tip->iItem && t->subitem == tip->iSubItem) entry = t;
+    }
+    if (!entry)
+    {
+        if (!(entry = Alloc(sizeof(*entry)))) return FALSE;
+        entry->item = tip->iItem;
+        entry->subitem = tip->iSubItem;
+        DPA_InsertPtr(infoPtr->hdpaInfoTips, DPA_GetPtrCount(infoPtr->hdpaInfoTips), entry);
+    }
+    lstrcpynW(entry->text, tip->pszText ? tip->pszText : L"", INFOTIPSIZE);
+    return TRUE;
+}
+
+static void LISTVIEW_HideInfoTip(LISTVIEW_INFO *infoPtr)
+{
+    TTTOOLINFOW ti = { sizeof(ti) };
+
+    if (infoPtr->nInfoTipItem < 0 || !infoPtr->hwndToolTip) return;
+    ti.hwnd = infoPtr->hwndSelf;
+    ti.uId = INFOTIP_TOOL_ID;
+    SendMessageW(infoPtr->hwndToolTip, TTM_TRACKACTIVATE, FALSE, (LPARAM)&ti);
+    infoPtr->nInfoTipItem = -1;
+}
+
+/* LVS_EX_INFOTIP: the parent's tip for the item under the mouse */
+static void LISTVIEW_ShowInfoTip(LISTVIEW_INFO *infoPtr, INT x, INT y)
+{
+    WCHAR text[INFOTIPSIZE];
+    NMLVGETINFOTIPW nmtip = { {0} };
+    TTTOOLINFOW ti = { sizeof(ti) };
+    LVHITTESTINFO ht = { { x, y } };
+    POINT pt = { x, y + 20 };
+    INT i;
+
+    if (!(infoPtr->dwLvExStyle & LVS_EX_INFOTIP)) return;
+    LISTVIEW_HitTest(infoPtr, &ht, infoPtr->uView == LV_VIEW_DETAILS, FALSE);
+    if (ht.iItem < 0 || ht.iItem == infoPtr->nInfoTipItem) return;
+    LISTVIEW_HideInfoTip(infoPtr);
+    text[0] = 0;
+    if (infoPtr->hdpaInfoTips)
+        for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaInfoTips); i++)
+        {
+            struct infotip *t = DPA_GetPtr(infoPtr->hdpaInfoTips, i);
+            if (t->item == ht.iItem && t->subitem == ht.iSubItem) lstrcpyW(text, t->text);
+        }
+    nmtip.dwFlags = LVGIT_UNFOLDED;
+    nmtip.pszText = text;
+    nmtip.cchTextMax = INFOTIPSIZE;
+    nmtip.iItem = ht.iItem;
+    nmtip.iSubItem = ht.iSubItem;
+#ifndef SG_MUTANT_NO_INFOTIP
+    notify_hdr(infoPtr, LVN_GETINFOTIPW, &nmtip.hdr);
+#endif
+    if (!text[0]) return;
+    if (!infoPtr->hwndToolTip && !(infoPtr->hwndToolTip = COMCTL32_CreateToolTip(infoPtr->hwndSelf))) return;
