From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a folder is not searched for its desktop.ini again and again

David's list, item 29: a folder on an SMB share was very slow to draw and
drawn twice before it could be used. File Explorer showing a folder of 520
items looked up its desktop.ini 248 times (each folder icon, each binding),
and a desktop.ini that is not there costs a case-insensitive search of the
whole folder: 124 opens of the folder and 1423 directory reads -- on a
share, each one over the network.

Whether a folder has a desktop.ini is now remembered for five seconds (64
folders): the same folder is opened once, its desktop.ini looked up twice,
and read in 142 directory reads. A desktop.ini that is there is read as
before.

Test: test/folderscan-gate.sh (strace counts; mutant SG_MUTANT_NO_INI_CACHE).
---
--- a/dlls/shell32/shlfolder.c
+++ b/dlls/shell32/shlfolder.c
@@ -66,12 +66,69 @@
  *    TRUE if returned non-NULL value.
  *    FALSE otherwise.
  */
+/* Stained Glass OS: whether a folder has a desktop.ini, remembered a few
+ * seconds. Each folder's icon and binding asked again and again -- hundreds
+ * of times for one folder shown -- and a missing desktop.ini costs a search
+ * of the whole folder (a case-insensitive lookup): on a network share, that
+ * many listings of the share's folder made it slow to draw and drawn twice
+ * (David's list, item 29). */
+#define INI_CACHE_SIZE 64
+#define INI_CACHE_MS   5000
+static struct { WCHAR folder[MAX_PATH]; BOOL exists; DWORD when; } ini_cache[INI_CACHE_SIZE];
+static unsigned int ini_cache_next;
+static CRITICAL_SECTION ini_cache_cs;
+static CRITICAL_SECTION_DEBUG ini_cache_cs_debug =
+{
+    0, 0, &ini_cache_cs,
+    { &ini_cache_cs_debug.ProcessLocksList, &ini_cache_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": ini_cache_cs") }
+};
+static CRITICAL_SECTION ini_cache_cs = { &ini_cache_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL folder_has_desktop_ini( const WCHAR *ini, int folder_len )
+{
+    DWORD now = GetTickCount();
+    unsigned int i;
+    BOOL exists;
+
+#ifdef SG_MUTANT_NO_INI_CACHE
+    return GetFileAttributesW( ini ) != INVALID_FILE_ATTRIBUTES;
+#endif
+    if (folder_len >= MAX_PATH) return GetFileAttributesW( ini ) != INVALID_FILE_ATTRIBUTES;
+    EnterCriticalSection( &ini_cache_cs );
+    for (i = 0; i < INI_CACHE_SIZE; i++)
+        if (ini_cache[i].folder[0] && now - ini_cache[i].when < INI_CACHE_MS &&
+            !wcsnicmp( ini_cache[i].folder, ini, folder_len ) && !ini_cache[i].folder[folder_len])
+        {
+            exists = ini_cache[i].exists;
+            LeaveCriticalSection( &ini_cache_cs );
+            return exists;
+        }
+    LeaveCriticalSection( &ini_cache_cs );
+    exists = GetFileAttributesW( ini ) != INVALID_FILE_ATTRIBUTES;
+    EnterCriticalSection( &ini_cache_cs );
+    i = ini_cache_next++ % INI_CACHE_SIZE;
+    memcpy( ini_cache[i].folder, ini, folder_len * sizeof(WCHAR) );
+    ini_cache[i].folder[folder_len] = 0;
+    ini_cache[i].exists = exists;
+    ini_cache[i].when = now;
+    LeaveCriticalSection( &ini_cache_cs );
+    return exists;
+}
+
 static inline BOOL SHELL32_GetCustomFolderAttributeFromPath(
     LPWSTR pwszFolderPath, LPCWSTR pwszHeading, LPCWSTR pwszAttribute,
     LPWSTR pwszValue, DWORD cchValue)
 {
+    int folder_len;
     PathAddBackslashW(pwszFolderPath);
+    folder_len = lstrlenW(pwszFolderPath);
     PathAppendW(pwszFolderPath, L"desktop.ini");
+    if (!folder_has_desktop_ini(pwszFolderPath, folder_len))
+    {
+        if (cchValue) pwszValue[0] = 0;
+        return FALSE;
+    }
     return GetPrivateProfileStringW(pwszHeading, pwszAttribute, L"", pwszValue, cchValue, pwszFolderPath);
 }
 
