From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: CoWaitForMultipleObjects is not CoWaitForMultipleHandles

2240 exported CoWaitForMultipleObjects as an alias of
CoWaitForMultipleHandles, but the two take different flags. CWMO_FLAGS:
CWMO_DEFAULT 0, CWMO_DISPATCH_CALLS 1, CWMO_DISPATCH_WINDOW_MESSAGES 2;
COWAIT_FLAGS: COWAIT_WAITALL 1, COWAIT_ALERTABLE 2. Through the alias a
caller asking for COM calls to be dispatched waited for all handles
instead of any (a hang until the timeout), one asking for window messages
got an alertable wait that a user APC ended, and CWMO_DEFAULT ran the
modal loop of a single-threaded apartment, which dispatches messages.

CoWaitForMultipleObjects is now its own function: unknown flags and more
than 56 handles are rejected, the wait is for any handle and never
alertable, a single-threaded apartment runs the modal loop only when one
of the dispatch flags is given, and otherwise it is a plain wait.
---
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -2384,6 +2384,61 @@ HRESULT WINAPI CoWaitForMultipleHandles(DWORD flags, DWORD timeout, ULONG handle
     return hr;
 }
 
+/* CoWaitForMultipleObjects flags (CWMO_FLAGS); not the COWAIT_* values */
+#define CWMO_DEFAULT                   0
+#define CWMO_DISPATCH_CALLS            1
+#define CWMO_DISPATCH_WINDOW_MESSAGES  2
+#define CWMO_MAX_HANDLES               56
+
+/***********************************************************************
+ *           CoWaitForMultipleObjects    (combase.@)
+ *
+ * Waits for any one of the handles. Unlike CoWaitForMultipleHandles nothing is
+ * dispatched by default: only with CWMO_DISPATCH_CALLS or
+ * CWMO_DISPATCH_WINDOW_MESSAGES does a single-threaded apartment run its modal
+ * loop meanwhile. The wait is never for all handles and never alertable.
+ */
+HRESULT WINAPI CoWaitForMultipleObjects(DWORD flags, DWORD timeout, ULONG handle_count, const HANDLE *handles,
+        DWORD *index)
+{
+    struct apartment *apt;
+    DWORD res;
+
+    TRACE("%#lx, %#lx, %lu, %p, %p\n", flags, timeout, handle_count, handles, index);
+
+    if (!index)
+        return E_INVALIDARG;
+
+    *index = 0;
+
+    if (!handles || handle_count > CWMO_MAX_HANDLES || (flags & ~(CWMO_DISPATCH_CALLS | CWMO_DISPATCH_WINDOW_MESSAGES)))
+        return E_INVALIDARG;
+
+    if (!handle_count)
+        return RPC_E_NO_SYNC;
+
+#ifdef SG_MUTANT_CWMO_AS_COWAIT
+    return CoWaitForMultipleHandles(flags, timeout, handle_count, (HANDLE *)handles, index);
+#endif
+
+    /* the modal loop of a single-threaded apartment: COM calls and the messages it lets through */
+    apt = com_get_current_apt();
+    if (apt && !apt->multi_threaded && flags != CWMO_DEFAULT)
+        return CoWaitForMultipleHandles(0, timeout, handle_count, (HANDLE *)handles, index);
+
+    res = WaitForMultipleObjectsEx(handle_count, handles, FALSE, timeout, FALSE);
+    switch (res)
+    {
+    case WAIT_TIMEOUT:
+        return RPC_S_CALLPENDING;
+    case WAIT_FAILED:
+        return HRESULT_FROM_WIN32(GetLastError());
+    default:
+        *index = res;
+        return S_OK;
+    }
+}
+
 /******************************************************************************
  *            CoRegisterMessageFilter        (combase.@)
  */
--- a/dlls/combase/combase.spec
+++ b/dlls/combase/combase.spec
@@ -172,7 +172,7 @@
 @ stub CoVrfGetThreadState
 @ stub CoVrfReleaseThreadState
 @ stdcall CoWaitForMultipleHandles(long long long ptr ptr)
-@ stdcall CoWaitForMultipleObjects(long long long ptr ptr) CoWaitForMultipleHandles
+@ stdcall CoWaitForMultipleObjects(long long long ptr ptr)
 @ stdcall CreateErrorInfo(ptr)
 @ stdcall CreateStreamOnHGlobal(ptr long ptr)
 @ stub DcomChannelSetHResult
