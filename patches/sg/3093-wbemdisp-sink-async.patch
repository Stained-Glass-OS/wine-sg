+static HRESULT WINAPI sink_pci_GetClassInfo( IProvideClassInfo2 *iface, ITypeInfo **info )
+{
+    ITypeInfo *typeinfo;
+    ITypeLib *lib;
+    UINT index;
+    HRESULT hr;
+
+    TRACE( "%p\n", info );
+
+    if (!info) return E_POINTER;
+    *info = NULL;
+    if (FAILED(hr = get_typeinfo( ISWbemSink_tid, &typeinfo ))) return hr;
+    hr = ITypeInfo_GetContainingTypeLib( typeinfo, &lib, &index );
+    ITypeInfo_Release( typeinfo );
+    if (FAILED(hr)) return hr;
+    hr = ITypeLib_GetTypeInfoOfGuid( lib, &CLSID_SWbemSink, info );
+    ITypeLib_Release( lib );
+    return hr;
+}
+
+static HRESULT WINAPI sink_pci_GetGUID( IProvideClassInfo2 *iface, DWORD kind, GUID *guid )
