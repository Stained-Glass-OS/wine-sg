+HRESULT SWbemSink_create( void **obj )
+{
+    struct sink *sink;
+
+    TRACE( "%p\n", obj );
+
+    if (!(sink = calloc( 1, sizeof(*sink) ))) return E_OUTOFMEMORY;
+    sink->ISWbemSink_iface.lpVtbl = &sink_vtbl;
+    sink->IConnectionPointContainer_iface.lpVtbl = &sink_cpc_vtbl;
+    sink->IConnectionPoint_iface.lpVtbl = &sink_cp_vtbl;
+    sink->IProvideClassInfo2_iface.lpVtbl = &sink_pci_vtbl;
+    sink->refs = 1;
+
+    *obj = &sink->ISWbemSink_iface;
+    return S_OK;
+}
+
+static struct sink *unsafe_sink_impl_from_IDispatch( IDispatch *iface )
+{
+    if (!iface) return NULL;
+    if (iface->lpVtbl != (IDispatchVtbl *)&sink_vtbl)
+    {
+        FIXME( "External implementations are not supported.\n" );
+        return NULL;
+    }
+    return CONTAINING_RECORD( (ISWbemSink *)iface, struct sink, ISWbemSink_iface );
+}
+
+static const GUID null_iid;
+
+/* an event, to each connected sink; args are in the order of the event's parameters */
+static void sink_fire( struct sink *sink, DISPID id, VARIANT *args, UINT count )
+{
+    VARIANT rev[4];
+    DISPPARAMS params = { rev, NULL, count, 0 };
+    DWORD i;
+    UINT k;
+
+    for (k = 0; k < count; k++) rev[k] = args[count - 1 - k];
+    for (i = 0; i < sink->sink_count; i++)
+    {
+        IDispatch *disp = sink->sinks[i];
+        if (!disp) continue;
+        IDispatch_AddRef( disp );
+        IDispatch_Invoke( disp, id, &null_iid, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &params, NULL, NULL, NULL );
+        IDispatch_Release( disp );
+    }
+}
+
+static void variant_dispatch( VARIANT *v, IDispatch *disp )
+{
+    V_VT( v ) = VT_DISPATCH;
+    V_DISPATCH( v ) = disp;
+}
+
+#define WBEMS_DISPID_OBJECT_READY 1
+#define WBEMS_DISPID_COMPLETED    2
+#define WBEMS_DISPID_OBJECT_PUT   4
+
+static void sink_object_ready( struct sink *sink, IDispatch *object, IDispatch *context )
+{
+    VARIANT args[2];
+
+    variant_dispatch( &args[0], object );
+    variant_dispatch( &args[1], context );
+    sink_fire( sink, WBEMS_DISPID_OBJECT_READY, args, 2 );
+}
+
+static void sink_completed( struct sink *sink, HRESULT hr, IDispatch *context )
+{
+#ifdef SG_MUTANT_WBEM_NO_COMPLETED
+    return;
+#endif
+    VARIANT args[3];
+
+    V_VT( &args[0] ) = VT_I4;
+    V_I4( &args[0] ) = hr;
+    variant_dispatch( &args[1], NULL );
+    variant_dispatch( &args[2], context );
+    sink_fire( sink, WBEMS_DISPID_COMPLETED, args, 3 );
+}
+
+static void sink_object_put( struct sink *sink, IDispatch *path, IDispatch *context )
+{
+    VARIANT args[2];
+
+    variant_dispatch( &args[0], path );
+    variant_dispatch( &args[1], context );
+    sink_fire( sink, WBEMS_DISPID_OBJECT_PUT, args, 2 );
+}
+
+/* the end of an operation that made an object (Get, ExecMethod), a set of them or none */
+static HRESULT sink_finish_object( struct sink *sink, HRESULT hr, ISWbemObject *object, IDispatch *context )
+{
+    if (FAILED(hr)) return hr;
+    if (object)
+    {
+        sink_object_ready( sink, (IDispatch *)object, context );
+        ISWbemObject_Release( object );
+    }
+    sink_completed( sink, S_OK, context );
+    return S_OK;
+}
+
+static HRESULT sink_finish_set( struct sink *sink, HRESULT hr, ISWbemObjectSet *set, IDispatch *context )
+{
+    IUnknown *unk;
+    IEnumVARIANT *iter;
+    VARIANT item;
+    ULONG got;
+
+    if (FAILED(hr)) return hr;
+    if (set && SUCCEEDED(ISWbemObjectSet_get__NewEnum( set, &unk )))
+    {
+        if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_IEnumVARIANT, (void **)&iter )))
+        {
+            VariantInit( &item );
+            while (IEnumVARIANT_Next( iter, 1, &item, &got ) == S_OK && got)
+            {
+                if (V_VT( &item ) == VT_DISPATCH) sink_object_ready( sink, V_DISPATCH( &item ), context );
+                VariantClear( &item );
+            }
+            IEnumVARIANT_Release( iter );
+        }
+        IUnknown_Release( unk );
+    }
+    if (set) ISWbemObjectSet_Release( set );
+    sink_completed( sink, S_OK, context );
+    return S_OK;
+}
+
+/* the operation is done before its results are looked at */
+#define FINISH_OBJECT( sink, call, object, context ) \
+    do { HRESULT _hr = (call); return sink_finish_object( (sink), _hr, (object), (context) ); } while (0)
+#define FINISH_SET( sink, call, set, context ) \
+    do { HRESULT _hr = (call); return sink_finish_set( (sink), _hr, (set), (context) ); } while (0)
+
+#define ASYNC_SINK( disp, sink ) \
+    if (!((sink) = unsafe_sink_impl_from_IDispatch( disp ))) return WBEM_E_INVALID_PARAMETER
+
 /*
  * An enumerator over a list of variants (the collections' _NewEnum)
  */
