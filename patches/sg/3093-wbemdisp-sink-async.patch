+/*
+ * SWbemSink: where an asynchronous operation reports to. The operation runs
+ * to its end during the call (the services are in this process), then its
+ * results and its end reach the connected event sinks.
+ */
+struct sink
+{
+    ISWbemSink ISWbemSink_iface;
+    IConnectionPointContainer IConnectionPointContainer_iface;
+    IConnectionPoint IConnectionPoint_iface;
+    IProvideClassInfo2 IProvideClassInfo2_iface;
+    LONG refs;
+
+    IDispatch **sinks;                  /* NULL entries are free; a cookie is an index + 1 */
+    DWORD sink_count;
+    LONG busy;
+};
+
+static inline struct sink *impl_from_ISWbemSink( ISWbemSink *iface )
+{
+    return CONTAINING_RECORD( iface, struct sink, ISWbemSink_iface );
+}
+
+static inline struct sink *impl_from_sink_IConnectionPointContainer( IConnectionPointContainer *iface )
+{
+    return CONTAINING_RECORD( iface, struct sink, IConnectionPointContainer_iface );
+}
+
+static inline struct sink *impl_from_sink_IConnectionPoint( IConnectionPoint *iface )
+{
+    return CONTAINING_RECORD( iface, struct sink, IConnectionPoint_iface );
+}
+
+static inline struct sink *impl_from_sink_IProvideClassInfo2( IProvideClassInfo2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct sink, IProvideClassInfo2_iface );
+}
+
+static HRESULT WINAPI sink_QueryInterface( ISWbemSink *iface, REFIID riid, void **obj )
+{
+    struct sink *sink = impl_from_ISWbemSink( iface );
+
+    TRACE( "%p, %s, %p\n", sink, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_ISWbemSink ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+        *obj = &sink->ISWbemSink_iface;
+    else if (IsEqualGUID( riid, &IID_IConnectionPointContainer ))
+        *obj = &sink->IConnectionPointContainer_iface;
+    else if (IsEqualGUID( riid, &IID_IProvideClassInfo ) || IsEqualGUID( riid, &IID_IProvideClassInfo2 ))
+        *obj = &sink->IProvideClassInfo2_iface;
+    else
+    {
+        WARN( "interface %s not implemented\n", debugstr_guid(riid) );
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*obj );
+    return S_OK;
+}
+
+static ULONG WINAPI sink_AddRef( ISWbemSink *iface )
+{
+    return InterlockedIncrement( &impl_from_ISWbemSink( iface )->refs );
+}
+
+static ULONG WINAPI sink_Release( ISWbemSink *iface )
+{
+    struct sink *sink = impl_from_ISWbemSink( iface );
+    LONG refs = InterlockedDecrement( &sink->refs );
+
+    if (!refs)
+    {
+        DWORD i;
+
+        TRACE( "destroying %p\n", sink );
+        for (i = 0; i < sink->sink_count; i++)
+            if (sink->sinks[i]) IDispatch_Release( sink->sinks[i] );
+        free( sink->sinks );
+        free( sink );
+    }
+    return refs;
+}
+
+DISPATCH_IMPL( sink, ISWbemSink, ISWbemSink_tid )
+
+static HRESULT WINAPI sink_Cancel( ISWbemSink *iface )
+{
+    struct sink *sink = impl_from_ISWbemSink( iface );
+
+    /* what it reports for has ended before the call returned, so nothing is left to cancel */
+    TRACE( "%p\n", sink );
+    return S_OK;
+}
