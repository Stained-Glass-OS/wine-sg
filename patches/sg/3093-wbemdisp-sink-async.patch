+static HRESULT WINAPI sink_cp_GetConnectionPointContainer( IConnectionPoint *iface, IConnectionPointContainer **container )
+{
+    struct sink *sink = impl_from_sink_IConnectionPoint( iface );
+
+    if (!container) return E_POINTER;
+    IConnectionPointContainer_AddRef( (*container = &sink->IConnectionPointContainer_iface) );
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_cp_Advise( IConnectionPoint *iface, IUnknown *unk, DWORD *cookie )
+{
+    struct sink *sink = impl_from_sink_IConnectionPoint( iface );
+    IDispatch *disp;
+    DWORD i;
+
+    TRACE( "%p, %p, %p\n", sink, unk, cookie );
+
+    if (!unk || !cookie) return E_POINTER;
+    if (FAILED(IUnknown_QueryInterface( unk, &DIID_ISWbemSinkEvents, (void **)&disp )) &&
+        FAILED(IUnknown_QueryInterface( unk, &IID_IDispatch, (void **)&disp )))
+        return CONNECT_E_CANNOTCONNECT;
+
+    for (i = 0; i < sink->sink_count; i++) if (!sink->sinks[i]) break;
+    if (i == sink->sink_count)
+    {
+        IDispatch **new_sinks = realloc( sink->sinks, (i + 4) * sizeof(*new_sinks) );
+        if (!new_sinks)
+        {
+            IDispatch_Release( disp );
+            return E_OUTOFMEMORY;
+        }
+        memset( new_sinks + i, 0, 4 * sizeof(*new_sinks) );
+        sink->sinks = new_sinks;
+        sink->sink_count = i + 4;
+    }
+    sink->sinks[i] = disp;
+    *cookie = i + 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI sink_cp_Unadvise( IConnectionPoint *iface, DWORD cookie )
+{
+    struct sink *sink = impl_from_sink_IConnectionPoint( iface );
+
+    TRACE( "%p, %lu\n", sink, cookie );
+
+    if (!cookie || cookie > sink->sink_count || !sink->sinks[cookie - 1]) return CONNECT_E_NOCONNECTION;
+    IDispatch_Release( sink->sinks[cookie - 1] );
+    sink->sinks[cookie - 1] = NULL;
+    return S_OK;
+}
+
