From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: IoGetDeviceProperty for the remaining properties.

A property it did not handle logged a FIXME and returned
STATUS_NOT_IMPLEMENTED. DevicePropertyDriverKeyName now reads the device's
driver key name, a value that is no property is STATUS_INVALID_PARAMETER_2 as
documented, the boot configuration properties report that the device has none,
and a buffer that is too small is STATUS_BUFFER_TOO_SMALL (it returned the
Win32 error code ERROR_INSUFFICIENT_BUFFER) with the needed size in
ResultLength.

Test: the PnP test driver; gate test/ntoskrnl-pnptest-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/pnp.c b/dlls/ntoskrnl.exe/pnp.c
--- a/dlls/ntoskrnl.exe/pnp.c
+++ b/dlls/ntoskrnl.exe/pnp.c
@@ -911,9 +911,21 @@
         case DevicePropertyRemovalPolicy:
             sp_property = SPDRP_REMOVAL_POLICY;
             break;
+#ifndef SG_MUTANT_DEVPROP_DRIVERKEY
+        case DevicePropertyDriverKeyName:
+            sp_property = SPDRP_DRIVER;
+            break;
+#endif
+        case DevicePropertyBootConfiguration:
+        case DevicePropertyBootConfigurationTranslated:
+            /* the resources the firmware gave the device: none are recorded here */
+            *needed = 0;
+            return STATUS_OBJECT_NAME_NOT_FOUND;
         default:
-            FIXME("Unhandled property %u.\n", property);
+#ifdef SG_MUTANT_DEVPROP_INVALID
             return STATUS_NOT_IMPLEMENTED;
+#endif
+            return STATUS_INVALID_PARAMETER_2;
     }
 
     if ((status = get_device_instance_id( device, device_instance_id )))
@@ -934,6 +946,8 @@
 
     if (SetupDiGetDeviceRegistryPropertyW( set, &sp_device, sp_property, NULL, buffer, length, needed ))
         status = STATUS_SUCCESS;
+    else if (GetLastError() == ERROR_INSUFFICIENT_BUFFER)
+        status = STATUS_BUFFER_TOO_SMALL;   /* *needed is the size to ask for */
     else
         status = GetLastError();
 
diff --git a/dlls/ntoskrnl.exe/tests/driver_pnp.c b/dlls/ntoskrnl.exe/tests/driver_pnp.c
--- a/dlls/ntoskrnl.exe/tests/driver_pnp.c
+++ b/dlls/ntoskrnl.exe/tests/driver_pnp.c
@@ -764,6 +764,30 @@
 };
 #undef WINETEST_DRIVER_DEVPROP
 
+static void test_io_get_device_property( DEVICE_OBJECT *device )
+{
+    ULONG needed = 0xdeadbeef, size;
+    WCHAR buffer[256];
+    NTSTATUS status;
+
+    /* a value that is no property */
+    status = IoGetDeviceProperty( device, 100, sizeof(buffer), buffer, &needed );
+    ok( status == STATUS_INVALID_PARAMETER_2, "got status %#lx.\n", status );
+
+    /* the driver key name: a string when the device has one, as for the properties setupapi has */
+    status = IoGetDeviceProperty( device, DevicePropertyDriverKeyName, 0, NULL, &needed );
+    ok( status == STATUS_BUFFER_TOO_SMALL || status == STATUS_SUCCESS || status == ERROR_INVALID_DATA || status == ERROR_FILE_NOT_FOUND,
+        "got status %#lx.\n", status );
+    if (status == STATUS_BUFFER_TOO_SMALL)
+    {
+        size = needed;
+        ok( size >= sizeof(WCHAR) && size <= sizeof(buffer), "got size %lu.\n", size );
+        status = IoGetDeviceProperty( device, DevicePropertyDriverKeyName, size, buffer, &needed );
+        ok( status == STATUS_SUCCESS, "got status %#lx.\n", status );
+        ok( needed == size && buffer[size / sizeof(WCHAR) - 1] == 0, "got %lu bytes.\n", needed );
+    }
+}
+
 static void test_device_properties( DEVICE_OBJECT *device )
 {
     SIZE_T i;
@@ -864,6 +888,7 @@
         case IOCTL_WINETEST_BUS_MAIN:
             test_bus_query();
             test_device_properties( bus_pdo );
+            test_io_get_device_property( bus_pdo );
             return STATUS_SUCCESS;
 
         case IOCTL_WINETEST_BUS_NOTIFY:
