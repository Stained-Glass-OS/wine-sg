From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: IMediaControl AddSourceFilter, FilterCollection and RegFilterCollection

Replace the three stubs with the documented behaviour: AddSourceFilter adds the
file's source filter to the graph (named after the file, like
IGraphBuilder::AddSourceFilter) and returns its IFilterInfo; FilterCollection
returns an IAMCollection of IFilterInfo for the filters currently in the graph;
RegFilterCollection returns an IAMCollection of IRegFilterInfo for all registered
filters. E_POINTER for NULL out pointers. No fixme is logged any more.
---
diff --git a/dlls/quartz/filtergraph.c b/dlls/quartz/filtergraph.c
index 35103af..0a477ad 100644
--- a/dlls/quartz/filtergraph.c
+++ b/dlls/quartz/filtergraph.c
@@ -2014,46 +2014,66 @@ static HRESULT WINAPI MediaControl_RenderFile(IMediaControl *iface, BSTR strFile
     return IFilterGraph2_RenderFile(&This->IFilterGraph2_iface, strFilename, NULL);
 }
 
-/* These return automation collections of IFilterInfo/IRegFilterInfo objects,
- * which need the IAMCollection, IFilterInfo, IRegFilterInfo, IPinInfo and
- * IMediaTypeInfo interfaces and their type library; none of those exist here
- * yet. Report the lack of the objects rather than a fake empty success. */
 static HRESULT WINAPI MediaControl_AddSourceFilter(IMediaControl *iface, BSTR strFilename,
         IDispatch **ppUnk)
 {
     struct filter_graph *This = impl_from_IMediaControl(iface);
+    IBaseFilter *filter;
+    HRESULT hr;
 
-    FIXME("(%p/%p)->(%s (%p), %p): IFilterInfo objects are not implemented.\n",
-            This, iface, debugstr_w(strFilename), strFilename, ppUnk);
+    TRACE("(%p/%p)->(%s (%p), %p)\n", This, iface, debugstr_w(strFilename), strFilename, ppUnk);
 
     if (!ppUnk)
         return E_POINTER;
     *ppUnk = NULL;
-    return E_NOTIMPL;
+    if (!strFilename)
+        return E_POINTER;
+
+    /* The graph names the filter after the file, like IGraphBuilder::AddSourceFilter(). */
+#ifdef SG_MUTANT_ASF_NAME
+    if (FAILED(hr = IFilterGraph2_AddSourceFilter(&This->IFilterGraph2_iface, strFilename,
+            L"Source", &filter)))
+#else
+    if (FAILED(hr = IFilterGraph2_AddSourceFilter(&This->IFilterGraph2_iface, strFilename,
+            strFilename, &filter)))
+#endif
+        return hr;
+
+    hr = filterinfo_create(filter, ppUnk);
+    if (FAILED(hr))
+        IFilterGraph2_RemoveFilter(&This->IFilterGraph2_iface, filter);
+    IBaseFilter_Release(filter);
+    return hr;
 }
 
 static HRESULT WINAPI MediaControl_get_FilterCollection(IMediaControl *iface, IDispatch **ppUnk)
 {
     struct filter_graph *This = impl_from_IMediaControl(iface);
 
-    FIXME("(%p/%p)->(%p): IAMCollection objects are not implemented.\n", This, iface, ppUnk);
+    TRACE("(%p/%p)->(%p)\n", This, iface, ppUnk);
 
     if (!ppUnk)
         return E_POINTER;
     *ppUnk = NULL;
-    return E_NOTIMPL;
+    return filterinfo_create_filter_collection(&This->IFilterGraph2_iface, ppUnk);
 }
 
 static HRESULT WINAPI MediaControl_get_RegFilterCollection(IMediaControl *iface, IDispatch **ppUnk)
 {
     struct filter_graph *This = impl_from_IMediaControl(iface);
+    IFilterMapper *mapper;
+    HRESULT hr;
 
-    FIXME("(%p/%p)->(%p): IAMCollection objects are not implemented.\n", This, iface, ppUnk);
+    TRACE("(%p/%p)->(%p)\n", This, iface, ppUnk);
 
     if (!ppUnk)
         return E_POINTER;
     *ppUnk = NULL;
-    return E_NOTIMPL;
+    if (FAILED(hr = IUnknown_QueryInterface(This->punkFilterMapper2, &IID_IFilterMapper, (void **)&mapper)))
+        return hr;
+    hr = filterinfo_create_reg_collection(&This->IFilterGraph2_iface, mapper, ppUnk);
+    IFilterMapper_Release(mapper);
+    return hr;
 }
 
 static void CALLBACK wait_pause_cb(TP_CALLBACK_INSTANCE *instance, void *context)
