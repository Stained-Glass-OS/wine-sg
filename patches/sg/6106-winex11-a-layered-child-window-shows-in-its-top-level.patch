From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a layered child window shows in its top-level window

A WS_EX_LAYERED child (Windows 8) gets a surface and an X window of its own; that X window was made at the root at the child's parent-relative position. JetBrains' runtime draws its caption buttons in one: they showed at the screen's top edge. The child's X window now goes in its top-level's X window at its place, takes no input (the frame hit-tests), and the frame's surface is put around it.
---
diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index bcf491a..f013a5c 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -2109,7 +2109,8 @@ static BOOL x11drv_surface_flush( struct window_surface *window_surface, const R
 
     /* Stained Glass OS: a Linux program's window in this one (sg_embed.c) is
      * not painted over */
-    if (sg_embed_is_frame( surface->window )) XSetSubwindowMode( gdi_display, surface->gc, ClipByChildren );
+    if (sg_embed_is_frame( surface->window ) || x11drv_has_layered_kids( surface->window ))
+        XSetSubwindowMode( gdi_display, surface->gc, ClipByChildren );
     if (alpha_bits == -1 && surface->keep_alpha) alpha_bits = 0;
     if (alpha_bits == -1)
     {
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index db2b08a..6519767 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1460,6 +1460,8 @@ BOOL stack_window_below( Display *display, Window window, Window below )
     return !X11DRV_check_error();
 }
 
+static Window child_x_parent( struct x11drv_win_data *data, const RECT *visible, POINT *pos );
+
 /* above: raise to the top of the stack; below: otherwise, the X window to
  * stack right below (0: leave the stacking alone) */
 static void window_set_config( struct x11drv_win_data *data, const RECT *new_rect, BOOL above, Window below )
@@ -1503,7 +1505,8 @@ static void window_set_config( struct x11drv_win_data *data, const RECT *new_rec
     if ((old_rect->left != new_rect->left || old_rect->top != new_rect->top) &&
         (data->whole_window != root_window && !data->embedded))
     {
-        POINT pt = virtual_screen_to_root( new_rect->left, new_rect->top );
+        POINT pt;
+        if (!child_x_parent( data, new_rect, &pt )) pt = virtual_screen_to_root( new_rect->left, new_rect->top );
         changes.x = pt.x;
         changes.y = pt.y;
         mask |= CWX | CWY;
@@ -2344,6 +2347,64 @@ Window create_client_window( HWND hwnd, const XVisualInfo *visual, Colormap colo
 }
 
 
+/* Stained Glass OS: a layered child window (Windows 8 has them; JetBrains'
+ * runtime draws its caption buttons in one) gets a surface, and so an X
+ * window, of its own. That window was made at the root with the child's
+ * parent-relative position: the buttons showed at the screen's top edge, left
+ * of where they belong, and moved with nothing. Its X window goes in its
+ * top-level window's, at its place there. Returns that X parent and the place,
+ * 0 for a top-level window. */
+/* the top-level X windows that hold a layered child's: their surfaces are put
+   around such children, not over them */
+static Window kid_parents[64];
+static unsigned int kid_parent_next;
+static pthread_mutex_t kid_parent_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void note_layered_kid_parent( Window window )
+{
+    unsigned int i;
+
+    pthread_mutex_lock( &kid_parent_mutex );
+    for (i = 0; i < ARRAY_SIZE(kid_parents); i++) if (kid_parents[i] == window) break;
+    if (i == ARRAY_SIZE(kid_parents)) kid_parents[kid_parent_next++ % ARRAY_SIZE(kid_parents)] = window;
+    pthread_mutex_unlock( &kid_parent_mutex );
+}
+
+BOOL x11drv_has_layered_kids( Window window )
+{
+    BOOL ret = FALSE;
+    unsigned int i;
+
+    if (!window || !kid_parent_next) return FALSE;
+    pthread_mutex_lock( &kid_parent_mutex );
+    for (i = 0; i < ARRAY_SIZE(kid_parents); i++) if (kid_parents[i] == window) ret = TRUE;
+    pthread_mutex_unlock( &kid_parent_mutex );
+    return ret;
+}
+
+static Window child_x_parent( struct x11drv_win_data *data, const RECT *visible, POINT *pos )
+{
+    HWND parent = NtUserGetAncestor( data->hwnd, GA_PARENT ), top;
+    struct x11drv_win_data *top_data;
+    Window ret;
+    POINT pt;
+
+#ifdef SG_MUTANT_LAYERED_CHILD_ROOT
+    return 0;
+#endif
+    if (!parent || parent == NtUserGetDesktopWindow()) return 0;
+    if (!(top = NtUserGetAncestor( data->hwnd, GA_ROOT )) || top == data->hwnd) return 0;
+    pt.x = visible->left;
+    pt.y = visible->top;
+    NtUserMapWindowPoints( parent, top, &pt, 1, NtUserGetWinMonitorDpi( data->hwnd, MDT_RAW_DPI ) );
+    if (!(top_data = get_win_data( top ))) return 0;
+    ret = top_data->whole_window;
+    pos->x = pt.x + top_data->rects.client.left - top_data->rects.visible.left;
+    pos->y = pt.y + top_data->rects.client.top - top_data->rects.visible.top;
+    release_win_data( top_data );
+    return ret;
+}
+
 /**********************************************************************
  *		create_whole_window
  *
@@ -2359,6 +2420,7 @@ static void create_whole_window( struct x11drv_win_data *data )
     DWORD layered_flags;
     HRGN win_rgn;
     POINT pos;
+    Window x_parent;
 
     if (!data->managed && is_window_managed( data->hwnd, SWP_NOACTIVATE, &data->rects.window ))
     {
@@ -2384,10 +2446,30 @@ static void create_whole_window( struct x11drv_win_data *data )
     if (!(cy = data->rects.visible.bottom - data->rects.visible.top)) cy = 1;
     else if (cy > 65535) cy = 65535;
 
-    pos = virtual_screen_to_root( data->rects.visible.left, data->rects.visible.top );
-    data->whole_window = XCreateWindow( data->display, root_window, pos.x, pos.y,
-                                        cx, cy, 0, data->vis.depth, InputOutput,
-                                        data->vis.visual, mask, &attr );
+    if ((x_parent = child_x_parent( data, &data->rects.visible, &pos )))
+    {
+        /* a layered child: in its top-level window's X window, and its
+           rects stay the parent-relative ones */
+        data->whole_window = XCreateWindow( data->display, x_parent, pos.x, pos.y,
+                                            cx, cy, 0, data->vis.depth, InputOutput,
+                                            data->vis.visual, mask, &attr );
+#ifdef HAVE_LIBXSHAPE
+        /* the pointer goes through it to the top-level window, which finds
+           the child the Win32 way (a WS_EX_TRANSPARENT one is passed over) */
+        if (data->whole_window)
+            XShapeCombineRectangles( data->display, data->whole_window, ShapeInput, 0, 0, NULL, 0, ShapeSet, YXBanded );
+#endif
+        note_layered_kid_parent( x_parent );
+        pos.x = data->rects.visible.left;
+        pos.y = data->rects.visible.top;
+    }
+    else
+    {
+        pos = virtual_screen_to_root( data->rects.visible.left, data->rects.visible.top );
+        data->whole_window = XCreateWindow( data->display, root_window, pos.x, pos.y,
+                                            cx, cy, 0, data->vis.depth, InputOutput,
+                                            data->vis.visual, mask, &attr );
+    }
     if (!data->whole_window) goto done;
     SetRect( &data->current_state.rect, pos.x, pos.y, pos.x + cx, pos.y + cy );
     data->pending_state.rect = data->current_state.rect;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 48ab0af..fbaecca 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -753,6 +753,7 @@ extern BOOL sg_embed_button( HWND hwnd, XButtonEvent *event );
 extern void sg_embed_layout( struct x11drv_win_data *data, UINT style );
 extern void sg_embed_destroy( HWND hwnd );
 extern BOOL sg_embed_is_frame( Window window );
+extern BOOL x11drv_has_layered_kids( Window window );
 extern void sg_embed_key( HWND hwnd, XKeyEvent *event );
 extern void release_win_data( struct x11drv_win_data *data );
 extern void set_window_parent( struct x11drv_win_data *data, Window parent );
