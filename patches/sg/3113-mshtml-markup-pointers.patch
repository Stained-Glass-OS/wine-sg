+static const WCHAR *markup_tag_name(ELEMENT_TAG_ID id)
+{
+    unsigned i;
+    for(i = 0; i < ARRAY_SIZE(markup_tags); i++)
+        if(markup_tags[i].id == id)
+            return markup_tags[i].name;
+    return NULL;
+}
+
+static ELEMENT_TAG_ID markup_tag_id(const WCHAR *name)
+{
+    unsigned i;
+    for(i = 0; i < ARRAY_SIZE(markup_tags); i++)
+        if(!wcsicmp(markup_tags[i].name, name))
+            return markup_tags[i].id;
+    return TAGID_UNKNOWN;
+}
+
+/* name=value pairs, the value bare or in quotes */
+static HRESULT apply_markup_attributes(IHTMLElement *elem, const WCHAR *attrs)
+{
+    HRESULT hres = S_OK;
+
+    while(attrs && *attrs && SUCCEEDED(hres)) {
+        const WCHAR *name, *value;
+        size_t name_len, value_len;
+        WCHAR quote = 0;
+        BSTR bname, bvalue;
+        VARIANT v;
+
+        while(iswspace(*attrs)) attrs++;
+        if(!*attrs)
+            break;
+        name = attrs;
+        while(*attrs && *attrs != '=' && !iswspace(*attrs)) attrs++;
+        name_len = attrs - name;
+        while(iswspace(*attrs)) attrs++;
+        value = attrs;
+        value_len = 0;
+        if(*attrs == '=') {
+            attrs++;
+            while(iswspace(*attrs)) attrs++;
+            if(*attrs == '"' || *attrs == '\'')
+                quote = *attrs++;
+            value = attrs;
+            while(*attrs && (quote ? *attrs != quote : !iswspace(*attrs))) attrs++;
+            value_len = attrs - value;
+            if(quote && *attrs == quote)
+                attrs++;
+        }else {
+            value = L"";
+        }
+        if(!name_len)
+            return E_INVALIDARG;
+
+        bname = SysAllocStringLen(name, name_len);
+        bvalue = SysAllocStringLen(value, value_len);
+        V_VT(&v) = VT_BSTR;
+        V_BSTR(&v) = bvalue;
+        hres = IHTMLElement_setAttribute(elem, bname, v, 0);
+        SysFreeString(bname);
+        SysFreeString(bvalue);
+    }
+    return hres;
+}
