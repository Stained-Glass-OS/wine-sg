+    nsres = nsIDOMDocument_CreateRange(nsdoc, &range);
+    nsIDOMDocument_Release(nsdoc);
+    if(NS_FAILED(nsres) || !range)
+        return E_FAIL;
+
+    nsres = nsIDOMRange_SetStart(range, node, off);
+    if(NS_SUCCEEDED(nsres))
+        nsres = nsIDOMRange_SetEnd(range, node, off);
+    if(NS_FAILED(nsres)) {
+        nsIDOMRange_Release(range);
+        return E_INVALIDARG;
+    }
