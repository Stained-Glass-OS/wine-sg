+    static const WCHAR * const tags[] = { L"area", L"base", L"basefont", L"bgsound", L"br", L"col", L"embed",
+        L"frame", L"hr", L"img", L"input", L"isindex", L"link", L"meta", L"nextid", L"param", L"wbr" };
+    unsigned i;
+
+#ifdef SG_MUTANT_MSHTML_MARKUP_NOVOID
+    return FALSE;
+#endif
+    for(i = 0; i < ARRAY_SIZE(tags); i++)
+        if(is_elem_tag(node, tags[i]))
+            return TRUE;
+    return FALSE;
+}
+
+static BOOL is_container_node(nsIDOMNode *node)
+{
+    UINT16 type = get_node_type(node);
+    return type == DOCUMENT_NODE || type == DOCUMENT_FRAGMENT_NODE;
+}
+
+/* the position, with a reference on the node */
+static BOOL mp_get(MarkupPointer *This, nsIDOMNode **node, LONG *off)
+{
+    if(!This->range)
+        return FALSE;
+    nsIDOMRange_GetStartContainer(This->range, node);
+    nsIDOMRange_GetStartOffset(This->range, off);
+    return *node != NULL;
+}
+
+static HRESULT mp_set(MarkupPointer *This, nsIDOMNode *node, LONG off)
+{
