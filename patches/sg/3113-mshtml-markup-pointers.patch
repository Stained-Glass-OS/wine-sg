 static HRESULT WINAPI MarkupServices_CreateElement(IMarkupServices *iface,
     ELEMENT_TAG_ID tagID, OLECHAR *pchAttributes, IHTMLElement **ppElement)
 {
     HTMLDocumentNode *This = impl_from_IMarkupServices(iface);
-    FIXME("(%p)->(%d,%s,%p)\n", This, tagID, debugstr_w(pchAttributes), ppElement);
-    return E_NOTIMPL;
+    const WCHAR *name;
+    BSTR bname;
+    HRESULT hres;
+
+    TRACE("(%p)->(%d,%s,%p)\n", This, tagID, debugstr_w(pchAttributes), ppElement);
+
+    if(!(name = markup_tag_name(tagID)))
+        return E_INVALIDARG;
+    if(!(bname = SysAllocString(name)))
+        return E_OUTOFMEMORY;
+    hres = IHTMLDocument2_createElement(&This->IHTMLDocument2_iface, bname, ppElement);
+    SysFreeString(bname);
+    if(SUCCEEDED(hres)) {
+        hres = apply_markup_attributes(*ppElement, pchAttributes);
+        if(FAILED(hres)) {
+            IHTMLElement_Release(*ppElement);
+            *ppElement = NULL;
+        }
+    }
+    return hres;
 }
 
 static HRESULT WINAPI MarkupServices_CloneElement(IMarkupServices *iface,
     IHTMLElement *pElemCloneThis, IHTMLElement **ppElementTheClone)
 {
     HTMLDocumentNode *This = impl_from_IMarkupServices(iface);
-    FIXME("(%p)->(%p,%p)\n", This, pElemCloneThis, ppElementTheClone);
-    return E_NOTIMPL;
+    IHTMLDOMNode *node, *clone;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p,%p)\n", This, pElemCloneThis, ppElementTheClone);
+
+    if(!pElemCloneThis)
+        return E_INVALIDARG;
+    hres = IHTMLElement_QueryInterface(pElemCloneThis, &IID_IHTMLDOMNode, (void**)&node);
+    if(FAILED(hres))
+        return hres;
+    /* the clone has the attributes of the element, not its content */
+    hres = IHTMLDOMNode_cloneNode(node, VARIANT_FALSE, &clone);
+    IHTMLDOMNode_Release(node);
+    if(FAILED(hres))
+        return hres;
+    hres = IHTMLDOMNode_QueryInterface(clone, &IID_IHTMLElement, (void**)ppElementTheClone);
+    IHTMLDOMNode_Release(clone);
+    return hres;
 }
 
