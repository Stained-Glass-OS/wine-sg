+        nsIDOMRange_GetStartContainer(nsrange, &start_node);
+        nsIDOMRange_GetStartOffset(nsrange, &start_off);
+        hres = mp_set(start, start_node, start_off);
+        nsIDOMNode_Release(start_node);
+        if(SUCCEEDED(hres)) {
+            nsIDOMRange_GetEndContainer(nsrange, &start_node);
+            nsIDOMRange_GetEndOffset(nsrange, &start_off);
+            hres = mp_set(finish, start_node, start_off);
+            nsIDOMNode_Release(start_node);
+        }
+    }
+    return hres;
+}
+
+HRESULT markup_range_to_pointers(IMarkupPointer *start_iface, IMarkupPointer *finish_iface, IHTMLTxtRange *range)
+{
+    MarkupPointer *start = unsafe_markup_pointer(start_iface), *finish = unsafe_markup_pointer(finish_iface);
+    nsIDOMRange *nsrange;
+    nsIDOMNode *node;
+    LONG off;
+    int cmp;
+    HRESULT hres;
+
+    if(!start || !finish)
+        return E_INVALIDARG;
+    hres = txtrange_get_nsrange(range, &nsrange);
+    if(FAILED(hres))
+        return hres;
+    if(!start->range || !finish->range)
+        return E_FAIL;
+    hres = mp_compare(start, finish, &cmp);
+    if(FAILED(hres))
+        return hres;
+    if(cmp > 0)
+        return E_INVALIDARG;
+
+    mp_get(start, &node, &off);
+    nsIDOMRange_SetStart(nsrange, node, off);
+    nsIDOMNode_Release(node);
+    mp_get(finish, &node, &off);
+    nsIDOMRange_SetEnd(nsrange, node, off);
+    nsIDOMNode_Release(node);
+    return S_OK;
+}
+
+HRESULT markup_is_scoped(IHTMLElement *element, BOOL *scoped)
+{
+    HTMLElement *elem = unsafe_impl_from_IHTMLElement(element);
+
+    if(!elem)
+        return E_INVALIDARG;
+    *scoped = !is_scopeless_node(elem->node.nsnode);
+    return S_OK;
+}
