From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, explorer: a window minimizes into its own taskbar button

The minimize animation (sg-deskcomp's lamp or shrink) always went to the
taskbar under the window, the bar's middle for a centred window (David
2026-10-01, field report item 4); Windows' goes to the window's own
button, which the shell tells it (HSHELL_GETMINRECT). The taskbar now
puts each window's button rectangle on it as the window prop
__wine_sg_minrect (left, top, right, bottom, 16 bits each), and winex11
hands it to the desktop's compositor as _SG_MINRECT (x, y, width,
height) when the window minimizes or comes back, before it moves.

Gate: test/deskprops-gate.sh (One's and Two's buttons, in order on the
bar; mutant SG_MUTANT_NO_MINRECT fails it); sg-compositor's
test/deskcomp-gate.sh for the animation.
---
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3254,6 +3254,26 @@
         }
     }
 
+    /* Stained Glass OS: a window minimizing or coming back tells the
+     * desktop's compositor where its taskbar button is (the shell's window
+     * prop __wine_sg_minrect, explorer 0751) before it moves: _SG_MINRECT
+     * x, y, width, height, which sg-deskcomp's animation goes to or from */
+    if ((swp_flags & SWP_STATECHANGED) && ((old_style ^ new_style) & WS_MINIMIZE))
+    {
+        static const WCHAR minrectW[] = {'_','_','w','i','n','e','_','s','g','_','m','i','n','r','e','c','t',0};
+        static Atom minrect_atom;
+        ULONGLONG packed = (ULONG_PTR)NtUserGetProp( hwnd, minrectW );
+        if (!minrect_atom) minrect_atom = XInternAtom( data->display, "_SG_MINRECT", False );
+        if (packed)
+        {
+            short l = packed, t = packed >> 16, r = packed >> 32, b = packed >> 48;
+            unsigned long rect[4] = { (unsigned long)(long)l, (unsigned long)(long)t, r - l, b - t };
+            XChangeProperty( data->display, data->whole_window, minrect_atom, XA_CARDINAL, 32,
+                             PropModeReplace, (unsigned char *)rect, 4 );
+        }
+        else XDeleteProperty( data->display, data->whole_window, minrect_atom );
+    }
+
     /* don't change position if we are about to minimize or maximize a managed window */
     if (!(data->managed && (swp_flags & SWP_STATECHANGED) && (new_style & (WS_MINIMIZE|WS_MAXIMIZE))))
     {
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1121,6 +1121,35 @@
     SetWindowPos( button, 0, 0, 0, 0, 0, SWP_NOZORDER | SWP_NOACTIVATE | SWP_HIDEWINDOW );
 }
 
+/* Stained Glass OS: each window's button, where it minimizes to -- as
+ * Windows' shell answers HSHELL_GETMINRECT. The window prop
+ * __wine_sg_minrect (left, top, right, bottom, 16 bits each, on the screen),
+ * which winex11 (0751) hands on to the desktop's compositor as _SG_MINRECT
+ * when the window minimizes or comes back, so the animation goes to the
+ * window's own button, not the middle of the bar (David 2026-10-01). A
+ * window without a button of its own shown goes to its group's. */
+static void sg_publish_minrects(void)
+{
+    struct taskbar_button *win;
+    RECT rc;
+
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        HWND button;
+        if (!win->hwnd || win->xwin || win->elevated) continue;
+        button = win->button;
+        if ((!button || !IsWindowVisible( button )) && win->group && win->group->button) button = win->group->button;
+#ifndef SG_MUTANT_NO_MINRECT
+        if (button && IsWindowVisible( button ) && GetWindowRect( button, &rc ))
+            SetPropW( win->hwnd, L"__wine_sg_minrect",
+                      (HANDLE)(ULONG_PTR)((ULONGLONG)(USHORT)rc.left | (ULONGLONG)(USHORT)rc.top << 16 |
+                                          (ULONGLONG)(USHORT)rc.right << 32 | (ULONGLONG)(USHORT)rc.bottom << 48) );
+        else
+#endif
+            RemovePropW( win->hwnd, L"__wine_sg_minrect" );
+    }
+}
+
 static int sg_horizon_start_width;   /* Horizon's Start button: its label is wider */
 static int sg_start_len(void)
 {
@@ -1305,6 +1334,7 @@
         }
         else hide_button( win->button );
     }
+    sg_publish_minrects();
 }
 
 /* Stained Glass OS: read the pinned programs again, with a button each */
