From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: Keep AM format blocks of unknown types through conversions.

MFInitMediaTypeFromAMMediaType keeps a format block of a type it does not
interpret (not FORMAT_None, not one of the video/wave formats) as the
format GUID plus the bytes, for any major type, and
MFInitAMMediaTypeFromMFMediaType gives that block back unchanged when no
other format is asked for. Known formats that are too short and video or
audio without a format still fail as before, which the video decoder DMOs
rely on to refuse such types.
---
 dlls/mfplat/mediatype.c | 108 +++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 97 insertions(+), 11 deletions(-)

diff --git a/dlls/mfplat/mediatype.c b/dlls/mfplat/mediatype.c
index 09ec252..4ed4f85 100644
--- a/dlls/mfplat/mediatype.c
+++ b/dlls/mfplat/mediatype.c
@@ -4915,6 +4915,81 @@ static HRESULT init_am_media_type_video_format(AM_MEDIA_TYPE *am_type, IMFMediaT
     return S_OK;
 }
 
+/* Format blocks this file does not interpret travel as MF_MT_AM_FORMAT_TYPE plus
+ * the raw block in MF_MT_USER_DATA. */
+static const GUID SG_MF_MT_AM_FORMAT_TYPE = {0x73d1072d, 0x1870, 0x4174, {0xa0, 0x63, 0x29, 0xff, 0x4f, 0xf6, 0xc1, 0x1e}};
+
+static HRESULT init_am_media_type_opaque_format(AM_MEDIA_TYPE *am_type, IMFMediaType *media_type)
+{
+    GUID format_type;
+    UINT32 size;
+    HRESULT hr;
+
+    if (FAILED(IMFMediaType_GetGUID(media_type, &SG_MF_MT_AM_FORMAT_TYPE, &format_type)))
+        format_type = GUID_NULL;
+
+    if (IsEqualGUID(&am_type->formattype, &GUID_NULL))
+        am_type->formattype = format_type;
+    else if (!IsEqualGUID(&am_type->formattype, &format_type))
+        return E_INVALIDARG;
+
+    if (IsEqualGUID(&am_type->formattype, &GUID_NULL) || IsEqualGUID(&am_type->formattype, &FORMAT_None))
+        return S_OK;
+
+    if (FAILED(IMFMediaType_GetBlobSize(media_type, &MF_MT_USER_DATA, &size)) || !size)
+        return S_OK;
+    if (!(am_type->pbFormat = CoTaskMemAlloc(size)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = IMFMediaType_GetBlob(media_type, &MF_MT_USER_DATA, am_type->pbFormat, size, NULL)))
+        return hr;
+    am_type->cbFormat = size;
+
+    return S_OK;
+}
+
+/* A format block of a type that is not interpreted here (the known ones that are
+ * too short, and no format at all, still fail) */
+static BOOL is_opaque_am_format(const AM_MEDIA_TYPE *am_type)
+{
+    static const GUID *known[] =
+    {
+        &GUID_NULL, &FORMAT_None, &FORMAT_VideoInfo, &FORMAT_VideoInfo2, &FORMAT_MPEGVideo,
+        &FORMAT_MPEG2Video, &FORMAT_MFVideoFormat, &FORMAT_WaveFormatEx,
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(known); ++i)
+        if (IsEqualGUID(&am_type->formattype, known[i]))
+            return FALSE;
+    return TRUE;
+}
+
+static BOOL media_type_has_format(IMFMediaType *media_type, const GUID *format)
+{
+    GUID kept;
+
+    return SUCCEEDED(IMFMediaType_GetGUID(media_type, &SG_MF_MT_AM_FORMAT_TYPE, &kept)) && IsEqualGUID(&kept, format);
+}
+
+static HRESULT init_media_type_opaque_format(IMFMediaType *media_type, const AM_MEDIA_TYPE *am_type)
+{
+    HRESULT hr = S_OK;
+
+    if (am_type->cbFormat && !am_type->pbFormat)
+        return E_INVALIDARG;
+
+    mediatype_set_guid(media_type, &MF_MT_MAJOR_TYPE, &am_type->majortype, &hr);
+    mediatype_set_guid(media_type, &MF_MT_SUBTYPE, &am_type->subtype, &hr);
+    if (!IsEqualGUID(&am_type->formattype, &GUID_NULL) && !IsEqualGUID(&am_type->formattype, &FORMAT_None))
+    {
+        mediatype_set_guid(media_type, &SG_MF_MT_AM_FORMAT_TYPE, &am_type->formattype, &hr);
+        if (SUCCEEDED(hr) && am_type->cbFormat)
+            hr = IMFMediaType_SetBlob(media_type, &MF_MT_USER_DATA, am_type->pbFormat, am_type->cbFormat);
+    }
+
+    return hr;
+}
+
 /***********************************************************************
  *      MFInitAMMediaTypeFromMFMediaType (mfplat.@)
  */
@@ -4935,15 +5010,17 @@ HRESULT WINAPI MFInitAMMediaTypeFromMFMediaType(IMFMediaType *media_type, GUID f
     am_type->bFixedSizeSamples = media_type_get_uint32(media_type, &MF_MT_FIXED_SIZE_SAMPLES);
     am_type->lSampleSize = media_type_get_uint32(media_type, &MF_MT_SAMPLE_SIZE);
 
-    if (IsEqualGUID(&am_type->majortype, &MFMediaType_Audio))
+    /* a format block kept from an AM type goes back as it came, unless the
+     * caller asks for another format */
+    if (SUCCEEDED(IMFMediaType_GetItem(media_type, &SG_MF_MT_AM_FORMAT_TYPE, NULL))
+            && (IsEqualGUID(&format, &GUID_NULL) || media_type_has_format(media_type, &format)))
+        hr = init_am_media_type_opaque_format(am_type, media_type);
+    else if (IsEqualGUID(&am_type->majortype, &MFMediaType_Audio))
         hr = init_am_media_type_audio_format(am_type, media_type);
     else if (IsEqualGUID(&am_type->majortype, &MFMediaType_Video))
         hr = init_am_media_type_video_format(am_type, media_type);
     else
-    {
-        FIXME("Not implemented!\n");
-        hr = E_NOTIMPL;
-    }
+        hr = init_am_media_type_opaque_format(am_type, media_type);
 
 done:
     if (FAILED(hr))
@@ -4992,11 +5069,18 @@ HRESULT WINAPI MFInitMediaTypeFromAMMediaType(IMFMediaType *media_type, const AM
         else if (0)
 #endif
             hr = MFInitMediaTypeFromMFVideoFormat(media_type, (MFVIDEOFORMAT *)am_type->pbFormat, am_type->cbFormat);
-        else
+        else if (!is_opaque_am_format(am_type))
         {
             FIXME("Unsupported format type %s / size %ld.\n", debugstr_guid(&am_type->formattype), am_type->cbFormat);
             return E_NOTIMPL;
         }
+        else
+        {
+            WARN("Keeping format type %s / size %ld as opaque data.\n", debugstr_guid(&am_type->formattype), am_type->cbFormat);
+            hr = init_media_type_opaque_format(media_type, am_type);
+            if (SUCCEEDED(hr) && subtype)
+                mediatype_set_guid(media_type, &MF_MT_SUBTYPE, subtype, &hr);
+        }
     }
     else if (IsEqualGUID(&am_type->majortype, &MEDIATYPE_Audio))
     {
@@ -5013,11 +5097,16 @@ HRESULT WINAPI MFInitMediaTypeFromAMMediaType(IMFMediaType *media_type, const AM
             if (SUCCEEDED(hr) && !IsEqualGUID(&am_type->subtype, &GUID_NULL))
                 mediatype_set_guid(media_type, &MF_MT_SUBTYPE, &am_type->subtype, &hr);
         }
-        else
+        else if (!is_opaque_am_format(am_type))
         {
             FIXME("Unsupported format type %s / size %ld.\n", debugstr_guid(&am_type->formattype), am_type->cbFormat);
             return E_NOTIMPL;
         }
+        else
+        {
+            WARN("Keeping format type %s / size %ld as opaque data.\n", debugstr_guid(&am_type->formattype), am_type->cbFormat);
+            hr = init_media_type_opaque_format(media_type, am_type);
+        }
     }
 #ifdef SG_MUTANT_AMMT_NO_NULL
     else if (0)
@@ -5030,10 +5119,7 @@ HRESULT WINAPI MFInitMediaTypeFromAMMediaType(IMFMediaType *media_type, const AM
         mediatype_set_guid(media_type, &MF_MT_SUBTYPE, &am_type->subtype, &hr);
     }
     else
-    {
-        FIXME("Unsupported major type %s.\n", debugstr_guid(&am_type->majortype));
-        return E_NOTIMPL;
-    }
+        hr = init_media_type_opaque_format(media_type, am_type);
 
     if (!am_type->bTemporalCompression && FAILED(IMFMediaType_GetItem(media_type, &MF_MT_ALL_SAMPLES_INDEPENDENT, NULL)))
         mediatype_set_uint32(media_type, &MF_MT_ALL_SAMPLES_INDEPENDENT, 1, &hr);
