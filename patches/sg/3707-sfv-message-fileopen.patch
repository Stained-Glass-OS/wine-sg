+/* SignalFileOpen / SHWaitForFileToOpen: a program that wants to know when a file is opened adds the
+ * file; the signal is a named event per file, so that it comes from any process.  The event is named
+ * after a hash of the parsing name of the file. */
+static CRITICAL_SECTION file_open_cs;
+static CRITICAL_SECTION_DEBUG file_open_cs_debug =
+{
+    0, 0, &file_open_cs, { &file_open_cs_debug.ProcessLocksList, &file_open_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": file_open_cs") }
+};
+static CRITICAL_SECTION file_open_cs = { &file_open_cs_debug, -1, 0, 0, 0, 0 };
+
+struct file_open_wait
+{
+    struct list entry;
+    WCHAR name[64];
+    HANDLE event;
+    int count;
+};
+static struct list file_open_waits = LIST_INIT(file_open_waits);
+
+static BOOL file_open_event_name(PCIDLIST_ABSOLUTE pidl, WCHAR name[64])
+{
+    DWORD hash = 2166136261u;
+    WCHAR *parsing;
+
+    if (FAILED(SHGetNameFromIDList(pidl, SIGDN_DESKTOPABSOLUTEPARSING, &parsing))) return FALSE;
+    for (WCHAR *p = parsing; *p; p++) hash = (hash ^ (WCHAR)towlower(*p)) * 16777619u;
+    CoTaskMemFree(parsing);
+#ifdef SG_MUTANT_FILEOPEN_NAME
+    hash = 0;
+#endif
+    swprintf(name, 64, L"Local\\SHFileOpen_%08lX", hash);
+    return TRUE;
+}
+
+static struct file_open_wait *find_file_open_wait(const WCHAR *name)
+{
+    struct file_open_wait *wait;
+
+    LIST_FOR_EACH_ENTRY(wait, &file_open_waits, struct file_open_wait, entry)
+        if (!wcscmp(wait->name, name)) return wait;
+    return NULL;
+}
+
+static struct file_open_wait *add_file_open_wait(const WCHAR *name)
+{
+    struct file_open_wait *wait = calloc(1, sizeof(*wait));
+
+    if (!wait) return NULL;
+    wcscpy(wait->name, name);
+    wait->count = 1;
+    if (!(wait->event = CreateEventW(NULL, TRUE, FALSE, name)))
+    {
+        free(wait);
+        return NULL;
+    }
+    list_add_tail(&file_open_waits, &wait->entry);
+    return wait;
+}
+
+static void remove_file_open_wait(struct file_open_wait *wait)
+{
+    if (--wait->count > 0) return;
+    list_remove(&wait->entry);
+    CloseHandle(wait->event);
+    free(wait);
+}
+
 /*************************************************************************
  * SignalFileOpen				[SHELL32.103]
  *
@@ -583,9 +686,19 @@ WORD WINAPI ArrangeWindows(HWND hwndParent, DWORD dwReserved, const RECT *lpRect
 BOOL WINAPI
 SignalFileOpen (PCIDLIST_ABSOLUTE pidl)
 {
-    FIXME("(%p):stub.\n", pidl);
+    WCHAR name[64];
+    HANDLE event;
 
-    return FALSE;
+    TRACE("(%p)\n", pidl);
+
+    if (!pidl || !file_open_event_name(pidl, name)) return FALSE;
+    /* somebody must be waiting for the file (SHWaitForFileToOpen with SHWFF_ADD) */
+    if (!(event = OpenEventW(EVENT_MODIFY_STATE, FALSE, name))) return FALSE;
+#ifndef SG_MUTANT_FILEOPEN_NOSIGNAL
+    SetEvent(event);
+#endif
+    CloseHandle(event);
+    return TRUE;
 }
 
 /*************************************************************************
@@ -1555,8 +1668,48 @@ BOOL WINAPI SHWaitForFileToOpen(
 	DWORD dwFlags,
 	DWORD dwTimeout)
 {
-	FIXME("%p 0x%08lx 0x%08lx stub\n", pidl, dwFlags, dwTimeout);
-	return FALSE;
+	WCHAR name[64];
+	BOOL ret = TRUE;
+	struct file_open_wait *wait = NULL;
+
+	TRACE("%p 0x%08lx 0x%08lx\n", pidl, dwFlags, dwTimeout);
+
+	if (!pidl || !file_open_event_name(pidl, name)) return FALSE;
+
+	EnterCriticalSection(&file_open_cs);
+	wait = find_file_open_wait(name);
+	if (dwFlags & SHWFF_ADD)
+	{
+		if (wait) wait->count++;
+		else if (!(wait = add_file_open_wait(name))) ret = FALSE;
+	}
+	if (ret && (dwFlags & SHWFF_WAIT))
+	{
+		HANDLE event = NULL;
+
+		/* the event stays valid while it is waited on: the wait is on a copy of the handle */
+		if (wait) DuplicateHandle(GetCurrentProcess(), wait->event, GetCurrentProcess(), &event, 0, FALSE, DUPLICATE_SAME_ACCESS);
+		LeaveCriticalSection(&file_open_cs);
+		ret = event && WaitForSingleObject(event, dwTimeout) == WAIT_OBJECT_0;
+#ifdef SG_MUTANT_FILEOPEN_WAIT
+		ret = TRUE;
+#endif
+		if (event) CloseHandle(event);
+		EnterCriticalSection(&file_open_cs);
+		wait = find_file_open_wait(name);
+	}
+	if (dwFlags & SHWFF_REMOVE)
+	{
+		if (wait)
+		{
+#ifndef SG_MUTANT_FILEOPEN_REMOVE
+			remove_file_open_wait(wait);
+#endif
+		}
+		else if (!(dwFlags & (SHWFF_ADD | SHWFF_WAIT))) ret = FALSE;
+	}
+	LeaveCriticalSection(&file_open_cs);
+	return ret;
 }
 
