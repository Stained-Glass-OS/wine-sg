+/* SHShellFolderView_Message: the SFVM_* requests to the folder view, taken in the view's own window */
+typedef struct { PCUITEMID_CHILD pidl; POINT pt; } sg_setitempos;
+
+static LRESULT ShellView_SFVMessage(IShellViewImpl *This, UINT message, LPARAM lparam)
+{
+    IShellFolderView *sfv = &This->IShellFolderView_iface;
+    UINT index;
+    int i, count;
+
+    switch (message)
+    {
+    case 1: /* SFVM_REARRANGE: lparam is what IShellFolder::CompareIDs gets */
+        IShellFolderView_Rearrange(sfv, lparam);
+        return 0;
+    case 3: /* SFVM_ADDOBJECT */
+        if (SUCCEEDED(IShellFolderView_AddObject(sfv, (PITEMID_CHILD)lparam, &index))) return index;
+        return -1;
+    case 6: /* SFVM_REMOVEOBJECT */
+        if (!lparam) return -1;
+        IShellFolderView_RemoveObject(sfv, (PITEMID_CHILD)lparam, &index);
+#ifdef SG_MUTANT_SFVMSG_REMOVE
+        return 0;
+#endif
+        return (int)index;
+    case 7: /* SFVM_UPDATEOBJECT: lparam points to the old and the new id list */
+    {
+        PITEMID_CHILD *pair = (PITEMID_CHILD *)lparam;
+
+#ifdef SG_MUTANT_SFVMSG_UPDATE
+        return -1;
+#endif
+        if (!pair || FAILED(IShellFolderView_UpdateObject(sfv, pair[0], pair[1], &index))) return -1;
+        /* the view has its own copy: the one made for the call is its to free */
+        ILFree(pair[1]);
+        return index;
+    }
+    case 9: /* SFVM_GETSELECTEDOBJECTS: lparam points to where the array of id lists goes */
+    {
+        PCITEMID_CHILD *selected;
+        PITEMID_CHILD *out;
+
+        if (!lparam) return 0;
+#ifdef SG_MUTANT_SFVMSG_GETSEL
+        return 0;
+#endif
+        *(PITEMID_CHILD **)lparam = NULL;
+        if (FAILED(IShellFolderView_GetSelectedObjects(sfv, &selected, &index)) || !index) return 0;
+        if (!(out = LocalAlloc(0, index * sizeof(*out))))
+        {
+            LocalFree((void *)selected);
+            return 0;
+        }
+        for (i = 0; i < (int)index; i++) out[i] = ILClone(selected[i]);
+        LocalFree((void *)selected);
+        *(PITEMID_CHILD **)lparam = out;
+        return index;
+    }
+    case 14: /* SFVM_SETITEMPOS */
+    {
+        sg_setitempos *pos = (sg_setitempos *)lparam;
+
+#ifndef SG_MUTANT_SFVMSG_POS
+        if (pos) IShellFolderView_SetItemPos(sfv, pos->pidl, &pos->pt);
+#endif
+        return 0;
+    }
+    case 16: /* SFVM_SETCLIPBOARD: -2 an item was cut to the clipboard, -3 copied */
+        if (!This->hWndList) return 0;
+        count = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+        for (i = 0; i < count; i++)
+        {
+            UINT selected_state = lparam == (LPARAM)-2 ? (UINT)SendMessageW(This->hWndList, LVM_GETITEMSTATE, i, LVIS_SELECTED) : 0;
+            LVITEMW item;
+
+            item.stateMask = LVIS_CUT;
+            item.state = selected_state ? LVIS_CUT : 0;
+#ifdef SG_MUTANT_SFVMSG_CLIP
+            item.state = 0;
+#endif
+            SendMessageW(This->hWndList, LVM_SETITEMSTATE, i, (LPARAM)&item);
+        }
+        return 0;
+    case 23: /* SFVM_SETPOINTS */
+        if (lparam) IShellFolderView_SetPoints(sfv, (IDataObject *)lparam);
+        return 0;
+    }
+    return 0;
+}
+
 static LRESULT CALLBACK ShellView_WndProc(HWND hWnd, UINT uMessage, WPARAM wParam, LPARAM lParam)
 {
 	IShellViewImpl * pThis = (IShellViewImpl*)GetWindowLongPtrW(hWnd, GWLP_USERDATA);
