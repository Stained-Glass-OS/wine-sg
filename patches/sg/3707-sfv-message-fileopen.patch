+static BOOL CALLBACK find_defview_proc(HWND hwnd, LPARAM lparam)
+{
+	WCHAR name[32];
+
+	if (GetClassNameW(hwnd, name, ARRAY_SIZE(name)) && !wcscmp(name, L"SHELLDLL_DefView"))
+	{
+		*(HWND *)lparam = hwnd;
+		return FALSE;
+	}
+	return TRUE;
+}
+
+/* the folder view window: the window itself, or the one in the cabinet window */
+static HWND find_defview(HWND hwnd)
+{
+	WCHAR name[32];
+	HWND view = NULL;
+
+	if (!IsWindow(hwnd)) return NULL;
+	if (GetClassNameW(hwnd, name, ARRAY_SIZE(name)) && !wcscmp(name, L"SHELLDLL_DefView")) return hwnd;
+#ifndef SG_MUTANT_SFVMSG_FIND
+	EnumChildWindows(hwnd, find_defview_proc, (LPARAM)&view);
+#endif
+	return view;
+}
+
 LRESULT WINAPI SHShellFolderView_Message(
 	HWND hwndCabinet,
 	UINT uMessage,
 	LPARAM lParam)
 {
-	FIXME("%p %08x %08Ix stub\n",hwndCabinet, uMessage, lParam);
-	return 0;
+	HWND view;
+	DWORD pid;
+
+	TRACE("%p %08x %08Ix\n", hwndCabinet, uMessage, lParam);
+
+	/* the requests carry pointers: they only make sense inside the process of the view */
+	if (!(view = find_defview(hwndCabinet)) || !GetWindowThreadProcessId(view, &pid) || pid != GetCurrentProcessId())
+		return 0;
+	return SendMessageW(view, RegisterWindowMessageW(SG_SFV_MESSAGE), uMessage, lParam);
 }
 
