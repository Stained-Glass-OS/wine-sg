+/* SERVICE_CONFIG_FAILURE_ACTIONS: services.exe returns a struct
+ * service_failure_actions, the actions and the two strings; the caller gets
+ * the SERVICE_FAILURE_ACTIONS followed by the actions and the strings, NULL
+ * pointers for what is not set. */
+static BOOL query_failure_actions( SC_HANDLE service, BYTE *buffer, DWORD size, DWORD *ret_size, BOOL ansi )
+{
+    const struct service_failure_actions *wire;
+    const BYTE *blob, *actions;
+    const WCHAR *msg, *cmd;
+    DWORD len, err, msg_len, cmd_len, hdr, total;
+    BYTE *out;
+
+    if (!ret_size) return set_error( ERROR_INVALID_ADDRESS );
+    if (!buffer && size) return set_error( ERROR_INVALID_ADDRESS );
+    if ((err = get_config_blob( service, SERVICE_CONFIG_FAILURE_ACTIONS, (BYTE **)&blob, &len ))) return set_error( err );
+    wire = (const struct service_failure_actions *)blob;
+    if (len < sizeof(*wire) || wire->count > (len - sizeof(*wire)) / sizeof(SC_ACTION) ||
+        len - sizeof(*wire) - wire->count * sizeof(SC_ACTION) < (SIZE_T)wire->reboot_msg_size + wire->command_size)
+    {
+        free( (void *)blob );
+        return set_error( ERROR_INVALID_DATA );
+    }
+    actions = blob + sizeof(*wire);
+    msg = (const WCHAR *)(actions + wire->count * sizeof(SC_ACTION));
+    cmd = (const WCHAR *)((const BYTE *)msg + wire->reboot_msg_size);
+    msg_len = wire->reboot_msg_size / sizeof(WCHAR);
+    cmd_len = wire->command_size / sizeof(WCHAR);
+    if (ansi)
+    {
+        msg_len = msg_len ? WideCharToMultiByte( CP_ACP, 0, msg, msg_len, NULL, 0, NULL, NULL ) : 0;
+        cmd_len = cmd_len ? WideCharToMultiByte( CP_ACP, 0, cmd, cmd_len, NULL, 0, NULL, NULL ) : 0;
+        hdr = sizeof(SERVICE_FAILURE_ACTIONSA);
+    }
+    else
+    {
+        msg_len *= sizeof(WCHAR);
+        cmd_len *= sizeof(WCHAR);
+        hdr = sizeof(SERVICE_FAILURE_ACTIONSW);
+    }
+    hdr = (hdr + 3) & ~3;
+    total = hdr + wire->count * sizeof(SC_ACTION) + msg_len + cmd_len;
+    *ret_size = total;
+    if (size < total)
+    {
+        free( (void *)blob );
+        return set_error( ERROR_INSUFFICIENT_BUFFER );
+    }
+    out = buffer + hdr;
+    memcpy( out, actions, wire->count * sizeof(SC_ACTION) );
+    if (ansi)
+    {
+        SERVICE_FAILURE_ACTIONSA *fa = (SERVICE_FAILURE_ACTIONSA *)buffer;
+        BYTE *str = out + wire->count * sizeof(SC_ACTION);
+
+        fa->dwResetPeriod = wire->reset_period;
+        fa->cActions = wire->count;
+        fa->lpsaActions = wire->count ? (SC_ACTION *)out : NULL;
+        fa->lpRebootMsg = NULL;
+        fa->lpCommand = NULL;
+        if (msg_len)
+        {
+            fa->lpRebootMsg = (char *)str;
+            WideCharToMultiByte( CP_ACP, 0, msg, wire->reboot_msg_size / sizeof(WCHAR), fa->lpRebootMsg, msg_len, NULL, NULL );
+            str += msg_len;
+        }
+        if (cmd_len)
+        {
+            fa->lpCommand = (char *)str;
+            WideCharToMultiByte( CP_ACP, 0, cmd, wire->command_size / sizeof(WCHAR), fa->lpCommand, cmd_len, NULL, NULL );
+        }
+    }
+    else
+    {
+        SERVICE_FAILURE_ACTIONSW *fa = (SERVICE_FAILURE_ACTIONSW *)buffer;
+        BYTE *str = out + wire->count * sizeof(SC_ACTION);
+
+        fa->dwResetPeriod = wire->reset_period;
+        fa->cActions = wire->count;
+        fa->lpsaActions = wire->count ? (SC_ACTION *)out : NULL;
+        fa->lpRebootMsg = NULL;
+        fa->lpCommand = NULL;
+        if (msg_len)
+        {
+            fa->lpRebootMsg = (WCHAR *)str;
+            memcpy( str, msg, msg_len );
+            str += msg_len;
+        }
+        if (cmd_len)
+        {
+            fa->lpCommand = (WCHAR *)str;
+            memcpy( str, cmd, cmd_len );
+        }
+    }
+    free( (void *)blob );
+    return TRUE;
+}
