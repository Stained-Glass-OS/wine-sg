+/* Service failure actions (SERVICE_CONFIG_FAILURE_ACTIONS) and the other
+ * per-service settings of ChangeServiceConfig2, kept where Windows keeps them
+ * in Services\<name>: FailureActions (binary: reset period, offsets of the
+ * reboot message and of the command, the number of actions and the offset of
+ * the SC_ACTION array, which is followed by the two strings),
+ * FailureActionsOnNonCrashFailures, ServiceSidType, RequiredPrivileges and
+ * LaunchProtected (numbers). */
+struct failure_config
+{
+    DWORD reset_period;
+    DWORD count;
+    SC_ACTION *actions;
+    WCHAR *reboot_msg;
+    WCHAR *command;
+};
+
+static void free_failure_config(struct failure_config *fc)
+{
+    free(fc->actions);
+    free(fc->reboot_msg);
+    free(fc->command);
+    memset(fc, 0, sizeof(*fc));
+}
+
+static WCHAR *failure_string_at(const BYTE *blob, DWORD size, DWORD offset)
+{
+    DWORD i, max;
+    WCHAR *str;
+
+    if (!offset || offset >= size || (offset & 1)) return NULL;
+    max = (size - offset) / sizeof(WCHAR);
+    for (i = 0; i < max; i++) if (!((const WCHAR *)(blob + offset))[i]) break;
+    if (i == max || !i) return NULL;
+    if (!(str = malloc((i + 1) * sizeof(WCHAR)))) return NULL;
+    memcpy(str, blob + offset, (i + 1) * sizeof(WCHAR));
+    return str;
+}
+
+static DWORD load_failure_config(struct service_entry *entry, struct failure_config *fc)
+{
+    HKEY key;
+    BYTE *blob = NULL;
+    DWORD err, size = 0, type, i, offset;
+
+    memset(fc, 0, sizeof(*fc));
+    if ((err = RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_READ, &key))) return err;
+    err = RegQueryValueExW(key, L"FailureActions", NULL, &type, NULL, &size);
+    if (!err && type == REG_BINARY && size >= 20 && (blob = malloc(size)))
+        err = RegQueryValueExW(key, L"FailureActions", NULL, &type, blob, &size);
+    else if (!err) err = ERROR_FILE_NOT_FOUND;
+    RegCloseKey(key);
+    if (err)
+    {
+        free(blob);
+        return err == ERROR_FILE_NOT_FOUND ? ERROR_SUCCESS : err;
+    }
+
+    fc->reset_period = ((DWORD *)blob)[0];
+    fc->reboot_msg = failure_string_at(blob, size, ((DWORD *)blob)[1]);
+    fc->command = failure_string_at(blob, size, ((DWORD *)blob)[2]);
+    fc->count = ((DWORD *)blob)[3];
+    offset = ((DWORD *)blob)[4];
+    if (fc->count && (offset > size || fc->count > (size - offset) / sizeof(SC_ACTION))) fc->count = 0;
+    if (fc->count && (fc->actions = malloc(fc->count * sizeof(SC_ACTION))))
+        for (i = 0; i < fc->count; i++)
+            memcpy(&fc->actions[i], blob + offset + i * sizeof(SC_ACTION), sizeof(SC_ACTION));
+    else fc->count = 0;
+    free(blob);
+    return ERROR_SUCCESS;
+}
+
+static DWORD save_failure_config(struct service_entry *entry, const struct failure_config *fc)
+{
+    HKEY key;
+    BYTE *blob;
+    DWORD err, size, offset, msg_size = 0, cmd_size = 0, *hdr;
+
+    if ((err = RegCreateKeyExW(entry->db->root_key, entry->name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+        return err;
+
+    if (!fc->count && !fc->reset_period && !fc->reboot_msg && !fc->command)
+    {
+        err = RegDeleteValueW(key, L"FailureActions");
+        RegCloseKey(key);
+        return err == ERROR_FILE_NOT_FOUND ? ERROR_SUCCESS : err;
+    }
+
+    if (fc->reboot_msg) msg_size = (lstrlenW(fc->reboot_msg) + 1) * sizeof(WCHAR);
+    if (fc->command) cmd_size = (lstrlenW(fc->command) + 1) * sizeof(WCHAR);
+    size = 20 + fc->count * sizeof(SC_ACTION) + msg_size + cmd_size;
+    if (!(blob = calloc(1, size)))
+    {
+        RegCloseKey(key);
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    hdr = (DWORD *)blob;
+    hdr[0] = fc->reset_period;
+    hdr[3] = fc->count;
+    hdr[4] = 20;
+    memcpy(blob + 20, fc->actions, fc->count * sizeof(SC_ACTION));
+    offset = 20 + fc->count * sizeof(SC_ACTION);
+    if (msg_size)
+    {
+        hdr[1] = offset;
+        memcpy(blob + offset, fc->reboot_msg, msg_size);
+        offset += msg_size;
+    }
+    if (cmd_size)
+    {
+        hdr[2] = offset;
+        memcpy(blob + offset, fc->command, cmd_size);
+    }
+    err = RegSetValueExW(key, L"FailureActions", 0, REG_BINARY, blob, size);
+    free(blob);
+    RegCloseKey(key);
+    return err;
+}
+
+DWORD set_service_failure_actions(struct service_entry *entry, const SERVICE_FAILURE_ACTIONSW *fa)
+{
+    struct failure_config fc;
+    DWORD err;
+
+    if ((err = load_failure_config(entry, &fc))) return err;
+
+    /* NULL strings leave the current ones, empty strings remove them */
+    if (fa->lpRebootMsg)
+    {
+        free(fc.reboot_msg);
+        fc.reboot_msg = fa->lpRebootMsg[0] ? wcsdup(fa->lpRebootMsg) : NULL;
+    }
+    if (fa->lpCommand)
+    {
+        free(fc.command);
+        fc.command = fa->lpCommand[0] ? wcsdup(fa->lpCommand) : NULL;
+    }
+    /* NULL actions leave the actions and the reset period; an empty array removes both */
+    if (fa->lpsaActions)
+    {
+        free(fc.actions);
+        fc.actions = NULL;
+        fc.count = 0;
+        fc.reset_period = 0;
+        if (fa->cActions)
+        {
+            if (!(fc.actions = malloc(fa->cActions * sizeof(SC_ACTION))))
+            {
+                free_failure_config(&fc);
+                return ERROR_NOT_ENOUGH_MEMORY;
+            }
+            memcpy(fc.actions, fa->lpsaActions, fa->cActions * sizeof(SC_ACTION));
+            fc.count = fa->cActions;
+            fc.reset_period = fa->dwResetPeriod;
+        }
+    }
+    err = save_failure_config(entry, &fc);
+    free_failure_config(&fc);
+    return err;
+}
+
+/* the answer to QueryServiceConfig2(SERVICE_CONFIG_FAILURE_ACTIONS): a struct
+ * service_failure_actions, the actions, then the two strings */
+DWORD query_service_failure_actions(struct service_entry *entry, BYTE *buffer, DWORD size, DWORD *needed)
+{
+    struct failure_config fc;
+    struct service_failure_actions *wire = (struct service_failure_actions *)buffer;
+    DWORD err, msg_size = 0, cmd_size = 0, total;
+    BYTE *out;
+
+    if ((err = load_failure_config(entry, &fc))) return err;
+    if (fc.reboot_msg) msg_size = (lstrlenW(fc.reboot_msg) + 1) * sizeof(WCHAR);
+    if (fc.command) cmd_size = (lstrlenW(fc.command) + 1) * sizeof(WCHAR);
+    total = sizeof(*wire) + fc.count * sizeof(SC_ACTION) + msg_size + cmd_size;
+    *needed = total;
+    if (size < total) err = ERROR_INSUFFICIENT_BUFFER;
+    else
+    {
+        wire->reset_period = fc.reset_period;
+        wire->reboot_msg_size = msg_size;
+        wire->command_size = cmd_size;
+        wire->count = fc.count;
+        out = buffer + sizeof(*wire);
+        memcpy(out, fc.actions, fc.count * sizeof(SC_ACTION));
+        out += fc.count * sizeof(SC_ACTION);
+        memcpy(out, fc.reboot_msg, msg_size);
+        out += msg_size;
+        memcpy(out, fc.command, cmd_size);
+    }
+    free_failure_config(&fc);
+    return err;
+}
+
+DWORD set_service_dword_setting(struct service_entry *entry, const WCHAR *name, DWORD value)
+{
+    HKEY key;
+    DWORD err;
+
+    if ((err = RegCreateKeyExW(entry->db->root_key, entry->name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+        return err;
+    err = reg_set_dword_value(key, name, value);
+    RegCloseKey(key);
+    return err;
+}
+
+DWORD query_service_dword_setting(struct service_entry *entry, const WCHAR *name, DWORD *value)
+{
+    HKEY key;
+    DWORD err, size = sizeof(*value), type;
+
+    *value = 0;
+    if ((err = RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_READ, &key))) return err;
+    err = RegQueryValueExW(key, name, NULL, &type, (BYTE *)value, &size);
+    RegCloseKey(key);
+    if (err == ERROR_FILE_NOT_FOUND) return ERROR_SUCCESS;
+    if (!err && type != REG_DWORD) *value = 0;
+    return err;
+}
+
+DWORD set_service_privileges(struct service_entry *entry, const BYTE *data, DWORD size)
+{
+    HKEY key;
+    DWORD err;
+
+    if ((err = RegCreateKeyExW(entry->db->root_key, entry->name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL)))
+        return err;
+    if (size <= sizeof(WCHAR)) err = RegDeleteValueW(key, L"RequiredPrivileges");  /* an empty list removes them */
+    else err = RegSetValueExW(key, L"RequiredPrivileges", 0, REG_MULTI_SZ, data, size);
+    RegCloseKey(key);
+    return err == ERROR_FILE_NOT_FOUND ? ERROR_SUCCESS : err;
+}
+
+/* the multi-string as stored, or no bytes at all when there are none */
+DWORD query_service_privileges(struct service_entry *entry, BYTE *buffer, DWORD size, DWORD *needed)
+{
+    HKEY key;
+    DWORD err, len = 0, type;
+
+    *needed = 0;
+    if ((err = RegOpenKeyExW(entry->db->root_key, entry->name, 0, KEY_READ, &key))) return err;
+    err = RegQueryValueExW(key, L"RequiredPrivileges", NULL, &type, NULL, &len);
+    if (err == ERROR_FILE_NOT_FOUND || (!err && type != REG_MULTI_SZ))
+    {
+        RegCloseKey(key);
+        return ERROR_SUCCESS;
+    }
+    if (!err)
+    {
+        *needed = len;
+        if (size < len) err = ERROR_INSUFFICIENT_BUFFER;
+        else err = RegQueryValueExW(key, L"RequiredPrivileges", NULL, &type, buffer, &len);
+    }
+    RegCloseKey(key);
+    return err;
+}
