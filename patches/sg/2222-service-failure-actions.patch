+/* What a failure of a service asks for: a restart, a command, or nothing.  The
+ * action is picked by how many failures there have been within the reset
+ * period (the last action repeats), and runs after its delay. */
+struct failure_job
+{
+    struct service_entry *service;
+    BOOL crashed;
+};
+
+static CRITICAL_SECTION failure_cs;
+static BOOL failure_cs_ready;
+
+static WCHAR *expand_failure_count(const WCHAR *command, DWORD count)
+{
+    WCHAR *out, *dst;
+    const WCHAR *src;
+    size_t len = lstrlenW(command) + 1;
+
+    for (src = command; (src = wcsstr(src, L"%1%")); src += 3) len += 12;
+    if (!(out = malloc(len * sizeof(WCHAR)))) return NULL;
+    for (src = command, dst = out; *src; )
+    {
+        if (!wcsncmp(src, L"%1%", 3))
+        {
+            dst += swprintf(dst, 12, L"%lu", count);
+            src += 3;
+        }
+        else *dst++ = *src++;
+    }
+    *dst = 0;
+    return out;
+}
+
+static DWORD WINAPI failure_actions_thread(void *param)
+{
+    struct failure_job *job = param;
+    struct service_entry *service = job->service;
+    struct failure_config fc;
+    SC_ACTION action;
+    DWORD count, nonzero_flag = 0;
+    ULONGLONG now = GetTickCount64();
+
+    if (!failure_cs_ready) goto done;
+    if (load_failure_config(service, &fc) || !fc.count)
+    {
+        free_failure_config(&fc);
+        goto done;
+    }
+#ifdef SG_MUTANT_NO_NONCRASH_FLAG
+    if (0 &&
+#else
+    if (!job->crashed &&
+#endif
+        (query_service_dword_setting(service, L"FailureActionsOnNonCrashFailures", &nonzero_flag) || !nonzero_flag))
+    {
+        free_failure_config(&fc);
+        goto done;
+    }
+
+    EnterCriticalSection(&failure_cs);
+#ifndef SG_MUTANT_NO_FAILURE_RESET
+    if (fc.reset_period != INFINITE && service->failure_count &&
+        now - service->last_failure > (ULONGLONG)fc.reset_period * 1000)
+        service->failure_count = 0;
+#endif
+    count = ++service->failure_count;
+    service->last_failure = now;
+    LeaveCriticalSection(&failure_cs);
+
+    action = fc.actions[min(count, fc.count) - 1];
+    WINE_TRACE("service %s failure %lu: action %u after %lu ms\n", wine_dbgstr_w(service->name),
+               count, action.Type, action.Delay);
+    if (action.Type == SC_ACTION_NONE || action.Type == SC_ACTION_REBOOT)
+    {
+        if (action.Type == SC_ACTION_REBOOT) WINE_FIXME("reboot action ignored\n");
+        free_failure_config(&fc);
+        goto done;
+    }
+
+    if (action.Delay) WaitForSingleObject(exit_event, action.Delay);
+    if (WaitForSingleObject(exit_event, 0) == WAIT_OBJECT_0)
+    {
+        free_failure_config(&fc);
+        goto done;
+    }
+
+#ifdef SG_MUTANT_NO_FAILURE_RESTART
+    if (action.Type == SC_ACTION_RESTART) {}
+    else
+#endif
+    if (action.Type == SC_ACTION_RESTART)
+    {
+        scmdatabase_lock_startup(active_database, INFINITE);
+        if (service->status.dwCurrentState == SERVICE_STOPPED && service->config.dwStartType != SERVICE_DISABLED)
+        {
+            DWORD err = service_start(service, 0, NULL);
+            if (err) WINE_WARN("restart of %s failed: %lu\n", wine_dbgstr_w(service->name), err);
+        }
+        scmdatabase_unlock_startup(active_database);
+    }
+    else if (action.Type == SC_ACTION_RUN_COMMAND && fc.command)
+    {
+        WCHAR *cmdline = expand_failure_count(fc.command, count);
+        STARTUPINFOW si = { sizeof(si) };
+        PROCESS_INFORMATION pi;
+
+        if (cmdline && CreateProcessW(NULL, cmdline, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi))
+        {
+            CloseHandle(pi.hThread);
+            CloseHandle(pi.hProcess);
+        }
+        else if (cmdline)
+            WINE_WARN("failure command of %s failed: %lu\n", wine_dbgstr_w(service->name), GetLastError());
+        free(cmdline);
+    }
+    free_failure_config(&fc);
+done:
+    release_service(service);
+    free(job);
+    return 0;
+}
+
+/* called when a service has failed: its process ended without it stopping
+ * (crashed), or it stopped reporting an error (not crashed) */
+void service_failed(struct service_entry *entry, BOOL crashed)
+{
+    struct failure_job *job;
+    HANDLE thread;
+
+    if (WaitForSingleObject(exit_event, 0) == WAIT_OBJECT_0) return;  /* the whole system is going down */
+    if (!(job = malloc(sizeof(*job)))) return;
+    job->service = grab_service(entry);
+    job->crashed = crashed;
+    if (!(thread = CreateThread(NULL, 0, failure_actions_thread, job, 0, NULL)))
+    {
+        release_service(entry);
+        free(job);
+        return;
+    }
+    CloseHandle(thread);
+}
