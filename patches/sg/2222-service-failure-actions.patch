+/* SERVICE_CONFIG_REQUIRED_PRIVILEGES_INFO: services.exe returns the
+ * multi-string; the caller gets the structure with the multi-string behind it,
+ * or a NULL pointer when there are none */
+static BOOL query_required_privileges( SC_HANDLE service, BYTE *buffer, DWORD size, DWORD *ret_size, BOOL ansi )
+{
+    BYTE *blob;
+    DWORD len, err, conv = 0, total;
+
+    if (!ret_size) return set_error( ERROR_INVALID_ADDRESS );
+    if (!buffer && size) return set_error( ERROR_INVALID_ADDRESS );
+    if ((err = get_config_blob( service, SERVICE_CONFIG_REQUIRED_PRIVILEGES_INFO, &blob, &len ))) return set_error( err );
+    len -= len % sizeof(WCHAR);
+    if (len)
+        conv = ansi ? WideCharToMultiByte( CP_ACP, 0, (WCHAR *)blob, len / sizeof(WCHAR), NULL, 0, NULL, NULL ) : len;
+    total = sizeof(void *) + conv;
+    *ret_size = total;
+    if (size < total)
+    {
+        free( blob );
+        return set_error( ERROR_INSUFFICIENT_BUFFER );
+    }
+    if (ansi)
+    {
+        SERVICE_REQUIRED_PRIVILEGES_INFOA *info = (SERVICE_REQUIRED_PRIVILEGES_INFOA *)buffer;
+        info->pmszRequiredPrivileges = conv ? (char *)(info + 1) : NULL;
+        if (conv) WideCharToMultiByte( CP_ACP, 0, (WCHAR *)blob, len / sizeof(WCHAR), info->pmszRequiredPrivileges, conv, NULL, NULL );
+    }
+    else
+    {
+        SERVICE_REQUIRED_PRIVILEGES_INFOW *info = (SERVICE_REQUIRED_PRIVILEGES_INFOW *)buffer;
+        info->pmszRequiredPrivileges = conv ? (WCHAR *)(info + 1) : NULL;
+        if (conv) memcpy( info->pmszRequiredPrivileges, blob, conv );
+    }
+    free( blob );
+    return TRUE;
+}
