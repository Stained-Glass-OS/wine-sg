From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: EMF+ records GDI+ writes are played (6504)

Metafiles with EMF+ records (Office's documents, charts, clip art)
lost every DrawLines, FillPolygon, DrawBeziers, DrawCurve,
DrawClosedCurve and DrawString record ("not implemented"), and ignored
ResetClip, OffsetClip, SetTextContrast and Comment. They are now played
as [MS-EMFPLUS] lays them out: compressed, float and relative points
(EmfPlusInteger7/15), solid-colour or object brushes, and the
StringFormat object a DrawString names.
---
diff --git a/dlls/gdiplus/gdiplus_private.h b/dlls/gdiplus/gdiplus_private.h
index 5ee0b18..b59acbf 100644
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -448,6 +448,7 @@ struct emfplus_object {
         GpImage *image;
         GpFont *font;
         GpImageAttributes *image_attributes;
+        GpStringFormat *format;
         void *object;
     } u;
 };
diff --git a/dlls/gdiplus/metafile.c b/dlls/gdiplus/metafile.c
index dcfbc78..35af25e 100644
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -675,6 +675,9 @@ static void metafile_free_object_table_entry(GpMetafile *metafile, BYTE id)
     case ObjectTypeImageAttributes:
         GdipDisposeImageAttributes(object->u.image_attributes);
         break;
+    case ObjectTypeStringFormat:
+        GdipDeleteStringFormat(object->u.format);
+        break;
     default:
         FIXME("not implemented for object type %u.\n", object->type);
         return;
@@ -2249,6 +2252,8 @@ static GpStatus metafile_read_region_node(struct memory_buffer *mbuf, GpRegion *
     return InvalidParameter;
 }
 
+static GpStatus metafile_deserialize_string_format(const BYTE *record_data, UINT data_size, GpStringFormat **format);
+
 static GpStatus metafile_deserialize_region(const BYTE *record_data, UINT data_size, GpRegion **region)
 {
     struct memory_buffer mbuf;
@@ -2828,6 +2833,9 @@ static GpStatus METAFILE_PlaybackObject(GpMetafile *metafile, UINT flags, UINT d
             GdipDisposeImageAttributes(attributes);
         break;
     }
+    case ObjectTypeStringFormat:
+        status = metafile_deserialize_string_format(record_data, data_size, (GpStringFormat **)&object);
+        break;
     default:
         FIXME("not implemented for object type %d.\n", type);
         return NotImplemented;
@@ -2851,6 +2859,291 @@ static GpStatus metafile_set_clip_region(GpMetafile *metafile, GpRegion *region,
     return METAFILE_PlaybackUpdateClip(metafile);
 }
 
+/* Stained Glass OS (wine-sg 6504): EMF+ records written by GDI+ on Windows (Office's
+ * documents, charts and clip art) that playback did not know: DrawLines, FillPolygon,
+ * DrawBeziers, DrawCurve, DrawClosedCurve, DrawString (and the StringFormat object it
+ * names), ResetClip, OffsetClip, SetTextContrast, Comment. Per [MS-EMFPLUS]. */
+typedef struct EmfPlusStringFormatData
+{
+    DWORD Version;
+    DWORD StringFormatFlags;
+    DWORD Language;
+    DWORD StringAlignment;
+    DWORD LineAlign;
+    DWORD DigitSubstitution;
+    DWORD DigitLanguage;
+    float FirstTabOffset;
+    DWORD HotkeyPrefix;
+    float LeadingMargin;
+    float TrailingMargin;
+    float Tracking;
+    DWORD Trimming;
+    DWORD TabStopCount;
+    DWORD RangeCount;
+    BYTE StringFormatData[1];
+} EmfPlusStringFormatData;
+
+static GpStatus metafile_deserialize_string_format(const BYTE *record_data, UINT data_size, GpStringFormat **format)
+{
+    const EmfPlusStringFormatData *data = (const EmfPlusStringFormatData *)record_data;
+    UINT fixed = FIELD_OFFSET(EmfPlusStringFormatData, StringFormatData);
+    GpStatus status;
+
+    *format = NULL;
+    if (data_size < fixed || data->TabStopCount > (data_size - fixed) / sizeof(float))
+        return InvalidParameter;
+    if (data->RangeCount > (data_size - fixed - data->TabStopCount * sizeof(float)) / (2 * sizeof(INT)))
+        return InvalidParameter;
+    if ((status = GdipCreateStringFormat(data->StringFormatFlags, data->Language, format)) != Ok)
+        return status;
+    GdipSetStringFormatAlign(*format, data->StringAlignment);
+    GdipSetStringFormatLineAlign(*format, data->LineAlign);
+    GdipSetStringFormatDigitSubstitution(*format, data->DigitLanguage, data->DigitSubstitution);
+    GdipSetStringFormatHotkeyPrefix(*format, data->HotkeyPrefix);
+    GdipSetStringFormatTrimming(*format, data->Trimming);
+    if (data->TabStopCount)
+        GdipSetStringFormatTabStops(*format, data->FirstTabOffset, data->TabStopCount,
+                (const REAL *)data->StringFormatData);
+    if (data->RangeCount)
+    {
+        const INT *r = (const INT *)(data->StringFormatData + data->TabStopCount * sizeof(float));
+        CharacterRange *ranges = malloc(data->RangeCount * sizeof(*ranges));
+        UINT i;
+
+        if (ranges)
+        {
+            for (i = 0; i < data->RangeCount; i++)
+            {
+                ranges[i].First = r[2 * i];
+                ranges[i].Length = r[2 * i + 1];
+            }
+            GdipSetStringFormatMeasurableCharacterRanges(*format, data->RangeCount, ranges);
+            free(ranges);
+        }
+    }
+    return Ok;
+}
+
+/* one EmfPlusInteger7 or EmfPlusInteger15 at *pos; FALSE past END */
+static BOOL metafile_read_integer_r(const BYTE **pos, const BYTE *end, int *value)
+{
+    if (*pos >= end) return FALSE;
+    if (**pos & 0x80)
+    {
+        int v;
+        if (*pos + 2 > end) return FALSE;
+        v = ((**pos & 0x7f) << 8) | (*pos)[1];
+        *value = (v & 0x4000) ? v - 0x8000 : v;
+        *pos += 2;
+    }
+    else
+    {
+        *value = (**pos & 0x40) ? (int)**pos - 0x80 : **pos;
+        *pos += 1;
+    }
+    return TRUE;
+}
+
+/* COUNT points at DATA (SIZE bytes): relative (P: EmfPlusPointR, each from the one before,
+ * the first from the origin), compressed (C: shorts) or floats; *USED: their size, 4-aligned */
+static GpStatus metafile_read_points(UINT flags, const BYTE *data, UINT size, UINT count, GpPointF **points,
+        UINT *used)
+{
+    UINT i;
+
+    if (!count || count > size)
+        return InvalidParameter;
+    if (!(*points = malloc(count * sizeof(**points))))
+        return OutOfMemory;
+    if (flags & 0x800) /* P */
+    {
+        const BYTE *pos = data, *end = data + size;
+        int x = 0, y = 0, dx, dy;
+
+        for (i = 0; i < count; i++)
+        {
+            if (!metafile_read_integer_r(&pos, end, &dx) || !metafile_read_integer_r(&pos, end, &dy))
+            {
+                free(*points);
+                *points = NULL;
+                return InvalidParameter;
+            }
+            x += dx;
+            y += dy;
+            (*points)[i].X = x;
+            (*points)[i].Y = y;
+        }
+        *used = ((pos - data) + 3) & ~3;
+    }
+    else if (flags & 0x4000) /* C */
+    {
+        const EmfPlusPoint *p = (const EmfPlusPoint *)data;
+        if (size < count * sizeof(*p))
+        {
+            free(*points);
+            *points = NULL;
+            return InvalidParameter;
+        }
+        for (i = 0; i < count; i++)
+        {
+            (*points)[i].X = p[i].X;
+            (*points)[i].Y = p[i].Y;
+        }
+        *used = count * sizeof(*p);
+    }
+    else
+    {
+        if (size < count * sizeof(EmfPlusPointF))
+        {
+            free(*points);
+            *points = NULL;
+            return InvalidParameter;
+        }
+        memcpy(*points, data, count * sizeof(GpPointF));
+        *used = count * sizeof(EmfPlusPointF);
+    }
+    return Ok;
+}
+
+/* the pen object the record's flags name */
+static GpPen *metafile_record_pen(GpMetafile *metafile, UINT flags)
+{
+    BYTE id = flags & 0xff;
+    if (id >= EmfPlusObjectTableSize || metafile->objtable[id].type != ObjectTypePen)
+        return NULL;
+    return metafile->objtable[id].u.pen;
+}
+
+/* the brush a record gives: an ARGB colour (S flag) or a brush object; *temp to delete */
+static GpBrush *metafile_record_brush(GpMetafile *metafile, UINT flags, DWORD brush_id, GpSolidFill **temp)
+{
+    *temp = NULL;
+    if (flags & 0x8000) /* S */
+    {
+        if (GdipCreateSolidFill(brush_id, temp) != Ok) return NULL;
+        return (GpBrush *)*temp;
+    }
+    if (brush_id >= EmfPlusObjectTableSize || metafile->objtable[brush_id].type != ObjectTypeBrush)
+        return NULL;
+    return metafile->objtable[brush_id].u.brush;
+}
+
+static GpStatus metafile_play_new_record(GpMetafile *metafile, EmfPlusRecordType type, UINT flags, UINT size,
+        const BYTE *data)
+{
+    GpGraphics *graphics = metafile->playback_graphics;
+    GpPointF *points = NULL;
+    GpSolidFill *temp = NULL;
+    GpStatus stat;
+    UINT used;
+    GpPen *pen;
+
+#ifdef SG_MUTANT_GDIP_EMFPLUS_UNPLAYED
+    return NotImplemented;
+#endif
+    switch (type)
+    {
+    case EmfPlusRecordTypeComment:
+        return Ok;
+    case EmfPlusRecordTypeResetClip:
+        return GdipResetClip(graphics);
+    case EmfPlusRecordTypeOffsetClip:
+        if (size != 2 * sizeof(float)) return InvalidParameter;
+        return GdipTranslateClip(graphics, ((const float *)data)[0], ((const float *)data)[1]);
+    case EmfPlusRecordTypeSetTextContrast:
+    {
+        /* the gamma times 1000 (1000 to 2200); GDI+ takes 0 to 12 */
+        UINT gamma = flags & 0xfff;
+        return GdipSetTextContrast(graphics, gamma > 1000 ? min((gamma - 1000 + 50) / 100, 12) : 0);
+    }
+    case EmfPlusRecordTypeDrawLines:
+    case EmfPlusRecordTypeDrawBeziers:
+    {
+        UINT count;
+        if (size < sizeof(DWORD) || !(pen = metafile_record_pen(metafile, flags))) return InvalidParameter;
+        count = *(const DWORD *)data;
+        if ((stat = metafile_read_points(flags, data + 4, size - 4, count, &points, &used)) != Ok) return stat;
+        if (type == EmfPlusRecordTypeDrawBeziers)
+            stat = GdipDrawBeziers(graphics, pen, points, count);
+        else if (flags & 0x2000) /* L: closed */
+            stat = GdipDrawPolygon(graphics, pen, points, count);
+        else
+            stat = GdipDrawLines(graphics, pen, points, count);
+        free(points);
+        return stat;
+    }
+    case EmfPlusRecordTypeFillPolygon:
+    {
+        GpBrush *brush;
+        UINT count;
+        if (size < 2 * sizeof(DWORD)) return InvalidParameter;
+        if (!(brush = metafile_record_brush(metafile, flags, ((const DWORD *)data)[0], &temp))) return InvalidParameter;
+        count = ((const DWORD *)data)[1];
+        if ((stat = metafile_read_points(flags, data + 8, size - 8, count, &points, &used)) == Ok)
+        {
+            stat = GdipFillPolygon(graphics, brush, points, count, FillModeAlternate);
+            free(points);
+        }
+        GdipDeleteBrush((GpBrush *)temp);
+        return stat;
+    }
+    case EmfPlusRecordTypeDrawCurve:
+    {
+        float tension;
+        UINT offset, segments, count;
+        if (size < 16 || !(pen = metafile_record_pen(metafile, flags))) return InvalidParameter;
+        tension = *(const float *)data;
+        offset = ((const DWORD *)data)[1];
+        segments = ((const DWORD *)data)[2];
+        count = ((const DWORD *)data)[3];
+        if ((stat = metafile_read_points(flags & ~0x800, data + 16, size - 16, count, &points, &used)) != Ok)
+            return stat;
+        stat = GdipDrawCurve3(graphics, pen, points, count, offset, segments, tension);
+        free(points);
+        return stat;
+    }
+    case EmfPlusRecordTypeDrawClosedCurve:
+    {
+        float tension;
+        UINT count;
+        if (size < 8 || !(pen = metafile_record_pen(metafile, flags))) return InvalidParameter;
+        tension = *(const float *)data;
+        count = ((const DWORD *)data)[1];
+        if ((stat = metafile_read_points(flags, data + 8, size - 8, count, &points, &used)) != Ok) return stat;
+        stat = GdipDrawClosedCurve2(graphics, pen, points, count, tension);
+        free(points);
+        return stat;
+    }
+    case EmfPlusRecordTypeDrawString:
+    {
+        BYTE font_id = flags & 0xff;
+        DWORD brush_id, format_id, length;
+        GpStringFormat *format = NULL;
+        const WCHAR *text;
+        GpBrush *brush;
+        RectF rect;
+
+        if (size < 28) return InvalidParameter;
+        brush_id = ((const DWORD *)data)[0];
+        format_id = ((const DWORD *)data)[1];
+        length = ((const DWORD *)data)[2];
+        memcpy(&rect, data + 12, sizeof(rect));
+        text = (const WCHAR *)(data + 28);
+        if (length > (size - 28) / sizeof(WCHAR)) return InvalidParameter;
+        if (font_id >= EmfPlusObjectTableSize || metafile->objtable[font_id].type != ObjectTypeFont)
+            return InvalidParameter;
+        if (format_id < EmfPlusObjectTableSize && metafile->objtable[format_id].type == ObjectTypeStringFormat)
+            format = metafile->objtable[format_id].u.format;
+        if (!(brush = metafile_record_brush(metafile, flags, brush_id, &temp))) return InvalidParameter;
+        stat = GdipDrawString(graphics, text, length, metafile->objtable[font_id].u.font, &rect, format, brush);
+        GdipDeleteBrush((GpBrush *)temp);
+        return stat;
+    }
+    default:
+        return NotImplemented;
+    }
+}
+
 GpStatus WINGDIPAPI GdipPlayMetafileRecord(GDIPCONST GpMetafile *metafile,
     EmfPlusRecordType recordType, UINT flags, UINT dataSize, GDIPCONST BYTE *data)
 {
@@ -3846,6 +4139,8 @@ GpStatus WINGDIPAPI GdipPlayMetafileRecord(GDIPCONST GpMetafile *metafile,
             return GdipSetRenderingOrigin(real_metafile->playback_graphics, origin->x, origin->y);
         }
         default:
+            if ((stat = metafile_play_new_record(real_metafile, recordType, flags, dataSize, data)) != NotImplemented)
+                return stat;
             if (recordType >= GDIP_EMFPLUS_RECORD_BASE)
                 FIXME("Not implemented for EMF+ record type %u\n", recordType - GDIP_EMFPLUS_RECORD_BASE);
             else
