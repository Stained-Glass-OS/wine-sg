 BOOL WINAPI /* DECLSPEC_HOTPATCH */ GetProcessMitigationPolicy( HANDLE process, PROCESS_MITIGATION_POLICY policy,
                                                           void *buffer, SIZE_T length )
 {
+#ifndef SG_MUTANT_NO_MITIGATION_POLICY
+    PROCESS_MITIGATION_POLICY_INFORMATION info;
+
+    TRACE( "(%p, %u, %p, %Iu)\n", process, policy, buffer, length );
+
+    /* The stub returned TRUE without writing the buffer: Chrome and Edge
+     * read their sandbox policies back as whatever was on their stack. */
+    switch (policy)
+    {
+    case ProcessDEPPolicy:
+    {
+        PROCESS_MITIGATION_DEP_POLICY *dep = buffer;
+        ULONG flags;
+
+        if (length != sizeof(*dep)) break;
+        if (!set_ntstatus( NtQueryInformationProcess( process, ProcessExecuteFlags, &flags, sizeof(flags), NULL ))) return FALSE;
+        dep->Flags = 0;
+        if (flags & MEM_EXECUTE_OPTION_DISABLE) dep->Enable = 1;
+        if (flags & MEM_EXECUTE_OPTION_DISABLE_THUNK_EMULATION) dep->DisableAtlThunkEmulation = 1;
+        dep->Permanent = !!(flags & MEM_EXECUTE_OPTION_PERMANENT);
+        return TRUE;
+    }
+    case ProcessMitigationOptionsMask:
+        /* the options CreateProcess's PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY
+         * enforces: none of them */
+        if (length != sizeof(ULONG64) && length != 2 * sizeof(ULONG64) && length != 3 * sizeof(ULONG64)) break;
+        memset( buffer, 0, length );
+        return TRUE;
+    default:
+        if (policy >= MaxProcessMitigationPolicy || length != sizeof(DWORD)) break;
+        info.Policy = policy;
+        info.Flags = 0;
+        if (!set_ntstatus( NtQueryInformationProcess( process, ProcessMitigationPolicy, &info, sizeof(info), NULL ) ))
+            return FALSE;
+        *(DWORD *)buffer = info.Flags;
+        return TRUE;
+    }
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return FALSE;
+#else
     FIXME( "(%p, %u, %p, %Iu): stub\n", process, policy, buffer, length );
     return TRUE;
+#endif
 }
 
 
