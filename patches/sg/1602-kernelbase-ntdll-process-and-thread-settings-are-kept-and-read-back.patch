+/* Settings a process makes on itself and reads back: SetProcessMitigationPolicy,
+ * SetProcessInformation. Chrome and Edge set mitigation policies and check
+ * them; they and .NET set power throttling and memory priority. Kept, not
+ * enforced. Another process's are not known here: its defaults are given. */
+static ULONG mitigation_policies[MaxProcessMitigationPolicy];
+static PROCESS_POWER_THROTTLING_STATE process_power_throttling = { PROCESS_POWER_THROTTLING_CURRENT_VERSION };
+static ULONG process_page_priority = MEMORY_PRIORITY_NORMAL;
+static ULONG process_leap_second_flags;
+
+/* whether a process handle is this process, checking the access asked for */
+static NTSTATUS is_current_process( HANDLE handle, BOOL set, BOOL *current )
+{
+    NTSTATUS status;
+
+    *current = TRUE;
+    if (handle == GetCurrentProcess()) return STATUS_SUCCESS;
+    if (set)
+    {
+        SERVER_START_REQ( set_process_info )
+        {
+            req->handle = wine_server_obj_handle( handle );
+            req->mask   = 0;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        if (status) return status;
+    }
+    SERVER_START_REQ( get_process_info )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        if (!(status = wine_server_call( req ))) *current = (reply->pid == GetCurrentProcessId());
+    }
+    SERVER_END_REQ;
+    return status;
+}
