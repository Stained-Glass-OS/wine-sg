+/* The private data of a thread of this process, where the settings a thread
+ * is given and reads back are kept (SetThreadInformation: power throttling,
+ * memory priority, dynamic code). NULL for another process's thread. */
+static NTSTATUS get_thread_settings( HANDLE handle, BOOL set, struct ntdll_thread_data **thread_data )
+{
+    NTSTATUS status;
+    client_ptr_t teb = 0;
+    int tries;
+
+    *thread_data = NULL;
+    if (handle == GetCurrentThread())
+    {
+        *thread_data = ntdll_get_thread_data();
+        return STATUS_SUCCESS;
+    }
+    if (set)
+    {
+        SERVER_START_REQ( set_thread_info )
+        {
+            req->handle = wine_server_obj_handle( handle );
+            req->mask   = 0;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        if (status) return status;
+    }
+    for (tries = 0; tries < 200; tries++)
+    {
+        BOOL starting = FALSE;
+
+        SERVER_START_REQ( get_thread_info )
+        {
+            req->handle = wine_server_obj_handle( handle );
+            req->access = THREAD_QUERY_LIMITED_INFORMATION;
+            if (!(status = wine_server_call( req )) && reply->pid == GetCurrentProcessId() &&
+                reply->exit_code == STATUS_PENDING)
+            {
+                teb = reply->teb;
+                /* a thread just created knows its TEB once it starts */
+                starting = !teb;
+            }
+        }
+        SERVER_END_REQ;
+        if (!starting) break;
+        usleep( 500 );
+    }
+    if (teb) *thread_data = (struct ntdll_thread_data *)&((TEB *)wine_server_get_ptr( teb ))->GdiTebBatch;
+    return status;
+}
