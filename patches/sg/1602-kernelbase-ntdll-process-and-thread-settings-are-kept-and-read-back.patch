                                                           void *buffer, SIZE_T length )
 {
+#ifndef SG_MUTANT_NO_MITIGATION_POLICY
+    PROCESS_MITIGATION_POLICY_INFORMATION info;
+
+    TRACE( "(%d, %p, %Iu)\n", policy, buffer, length );
+
+    switch (policy)
+    {
+    case ProcessDEPPolicy:
+    {
+        const PROCESS_MITIGATION_DEP_POLICY *dep = buffer;
+        ULONG flags;
+
+        if (length != sizeof(*dep)) break;
+        if (!set_ntstatus( NtQueryInformationProcess( GetCurrentProcess(), ProcessExecuteFlags,
+                                                      &flags, sizeof(flags), NULL ))) return FALSE;
+        if (flags & MEM_EXECUTE_OPTION_PERMANENT)
+        {
+            /* 64-bit processes always have DEP; it cannot be turned off */
+            if (dep->Enable && (flags & MEM_EXECUTE_OPTION_DISABLE)) return TRUE;
+            SetLastError( ERROR_ACCESS_DENIED );
+            return FALSE;
+        }
+        flags = dep->Enable ? MEM_EXECUTE_OPTION_DISABLE : MEM_EXECUTE_OPTION_ENABLE;
+        if (dep->DisableAtlThunkEmulation) flags |= MEM_EXECUTE_OPTION_DISABLE_THUNK_EMULATION;
+        if (dep->Permanent) flags |= MEM_EXECUTE_OPTION_PERMANENT;
+        return set_ntstatus( NtSetInformationProcess( GetCurrentProcess(), ProcessExecuteFlags, &flags, sizeof(flags) ));
+    }
+    case ProcessMitigationOptionsMask:
+        break;
+    default:
+        if (policy >= MaxProcessMitigationPolicy || length != sizeof(DWORD)) break;
+        info.Policy = policy;
+        info.Flags = *(DWORD *)buffer;
+        return set_ntstatus( NtSetInformationProcess( GetCurrentProcess(), ProcessMitigationPolicy, &info, sizeof(info) ));
+    }
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return FALSE;
+#else
     FIXME( "(%d, %p, %Iu): stub\n", policy, buffer, length );
