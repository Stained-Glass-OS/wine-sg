+/**********************************************************************
+ *            GetThreadInformation   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH GetThreadInformation( HANDLE thread, THREAD_INFORMATION_CLASS info_class,
+                                                    VOID *info, DWORD size )
+{
+    switch (info_class)
+    {
+        case ThreadMemoryPriority:
+            return set_ntstatus( NtQueryInformationThread( thread, ThreadPagePriority, info, size, NULL ));
+        case ThreadPowerThrottling:
+            return set_ntstatus( NtQueryInformationThread( thread, ThreadPowerThrottlingState, info, size, NULL ));
+        case ThreadDynamicCodePolicy:
+            return set_ntstatus( NtQueryInformationThread( thread, ThreadDynamicCodePolicyInfo, info, size, NULL ));
+        case ThreadAbsoluteCpuPriority:
+        {
+            /* the priority the scheduler uses: the class's base plus the thread's own */
+            THREAD_BASIC_INFORMATION tbi;
+            PROCESS_PRIORITY_CLASS ppc;
+            OBJECT_ATTRIBUTES attr;
+            CLIENT_ID cid;
+            HANDLE process;
+            LONG base, prio;
+
+            if (size != sizeof(LONG))
+            {
+                SetLastError( ERROR_INVALID_PARAMETER );
+                return FALSE;
+            }
+            if (!set_ntstatus( NtQueryInformationThread( thread, ThreadBasicInformation, &tbi, sizeof(tbi), NULL )))
+                return FALSE;
+            if ((prio = GetThreadPriority( thread )) == THREAD_PRIORITY_ERROR_RETURN) return FALSE;
+            ppc.PriorityClass = PROCESS_PRIOCLASS_NORMAL;
+            InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+            cid.UniqueProcess = tbi.ClientId.UniqueProcess;
+            cid.UniqueThread = 0;
+            if (!NtOpenProcess( &process, PROCESS_QUERY_LIMITED_INFORMATION, &attr, &cid ))
+            {
+                NtQueryInformationProcess( process, ProcessPriorityClass, &ppc, sizeof(ppc), NULL );
+                NtClose( process );
+            }
+            switch (ppc.PriorityClass)
+            {
+            case PROCESS_PRIOCLASS_IDLE:         base = 4; break;
+            case PROCESS_PRIOCLASS_BELOW_NORMAL: base = 6; break;
+            case PROCESS_PRIOCLASS_ABOVE_NORMAL: base = 10; break;
+            case PROCESS_PRIOCLASS_HIGH:         base = 13; break;
+            case PROCESS_PRIOCLASS_REALTIME:     base = 24; break;
+            default:                             base = 8; break;
+            }
+            if (prio == THREAD_PRIORITY_IDLE) prio = base >= 16 ? 16 : 1;
+            else if (prio == THREAD_PRIORITY_TIME_CRITICAL) prio = base >= 16 ? 31 : 15;
+            else prio += base;
+            *(LONG *)info = prio;
+            return TRUE;
+        }
+        default:
+            SetLastError( ERROR_INVALID_PARAMETER );
             return FALSE;
     }
 }
