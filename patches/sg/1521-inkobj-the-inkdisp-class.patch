From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] inkobj: the InkDisp class

Every Windows client edition registers the Tablet PC ink objects
(msinkaut.h); on Windows Server they come with the Desktop Experience
feature. OneNote opens HKCR\CLSID\{937C1A34-151D-4610-9CA6-A8CC9BDB5D83}
(InkDisp) as it starts and, when the class is missing, says "You'll need
to install the Desktop Experience before you start OneNote" and quits.

inkobj now has the InkDisp class, registered (both views) when the prefix
is made or updated: an ink object that holds no strokes yet. It keeps its
Dirty flag, clones to a fresh ink, answers IDispatch (no type library),
finds no nearest stroke and cannot paste; the stroke methods are FIXMEs.

Gate: test/inkdisp-gate.sh (registry key, CoCreateInstance, Dirty, Clone,
IDispatch; 64- and 32-bit). Mutant SG_MUTANT_NO_INKDISP. inkobj has no
conformance tests.
---
--- a/dlls/inkobj/Makefile.in
+++ b/dlls/inkobj/Makefile.in
@@ -1,6 +1,8 @@
 MODULE    = inkobj.dll
+IMPORTS   = uuid ole32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
-	inkobj.c
+	inkobj.c \
+	inkobj_classes.idl
--- a/dlls/inkobj/inkobj.c
+++ b/dlls/inkobj/inkobj.c
@@ -16,14 +16,370 @@
  */
 
 #include "inkobj_internal.h"
+#include "initguid.h"
+
+DEFINE_GUID(IID_IInkDisp, 0x9d398fa0,0xc4e2,0x4fcd,0x99,0x73,0x97,0x5c,0xaa,0xf4,0x7e,0xa6);
 
 WINE_DEFAULT_DEBUG_CHANNEL(inkobj);
 
+/* Stained Glass OS (wine-sg 1521): the InkDisp class (an ink object, the
+ * Tablet PC automation API, msinkaut.h). Windows has it on every client
+ * edition; OneNote looks its class up at start and, without it, takes the
+ * system for a Server lacking the Desktop Experience and refuses to start.
+ * The object holds no strokes yet: it answers for an empty ink. */
+
+static const CLSID CLSID_InkDisp = {0x937c1a34,0x151d,0x4610,{0x9c,0xa6,0xa8,0xcc,0x9b,0xdb,0x5d,0x83}};
+
+struct ink
+{
+    IInkDisp IInkDisp_iface;
+    LONG ref;
+    VARIANT_BOOL dirty;
+};
+
+static inline struct ink *impl_from_IInkDisp(IInkDisp *iface)
+{
+    return CONTAINING_RECORD(iface, struct ink, IInkDisp_iface);
+}
+
+static HRESULT create_ink(IInkDisp **out);
+
+static HRESULT WINAPI ink_QueryInterface(IInkDisp *iface, REFIID riid, void **out)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), out);
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDispatch) || IsEqualIID(riid, &IID_IInkDisp))
+    {
+        *out = iface;
+        IInkDisp_AddRef(iface);
+        return S_OK;
+    }
+    WARN("%s not implemented\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ink_AddRef(IInkDisp *iface)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    return InterlockedIncrement(&ink->ref);
+}
+
+static ULONG WINAPI ink_Release(IInkDisp *iface)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    ULONG ref = InterlockedDecrement(&ink->ref);
+    if (!ref) free(ink);
+    return ref;
+}
+
+static HRESULT WINAPI ink_GetTypeInfoCount(IInkDisp *iface, UINT *count)
+{
+    TRACE("%p, %p\n", iface, count);
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI ink_GetTypeInfo(IInkDisp *iface, UINT index, LCID lcid, ITypeInfo **info)
+{
+    FIXME("%p, %u, %#lx, %p: no type library\n", iface, index, lcid, info);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_GetIDsOfNames(IInkDisp *iface, REFIID riid, LPOLESTR *names, UINT count,
+        LCID lcid, DISPID *ids)
+{
+    FIXME("%p, %s, %p, %u, %#lx, %p: no type library\n", iface, debugstr_guid(riid), names, count, lcid, ids);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Invoke(IInkDisp *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    FIXME("%p, %ld: no type library\n", iface, id);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_get_Strokes(IInkDisp *iface, IInkStrokes **strokes)
+{
+    FIXME("%p, %p: stub\n", iface, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_get_ExtendedProperties(IInkDisp *iface, IInkExtendedProperties **props)
+{
+    FIXME("%p, %p: stub\n", iface, props);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_get_Dirty(IInkDisp *iface, VARIANT_BOOL *dirty)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    TRACE("%p, %p\n", iface, dirty);
+    if (!dirty) return E_POINTER;
+    *dirty = ink->dirty;
+    return S_OK;
+}
+
+static HRESULT WINAPI ink_put_Dirty(IInkDisp *iface, VARIANT_BOOL dirty)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    TRACE("%p, %d\n", iface, dirty);
+    ink->dirty = dirty ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI ink_get_CustomStrokes(IInkDisp *iface, IInkCustomStrokes **strokes)
+{
+    FIXME("%p, %p: stub\n", iface, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_GetBoundingBox(IInkDisp *iface, InkBoundingBoxMode mode, IInkRectangle **rect)
+{
+    FIXME("%p, %d, %p: stub\n", iface, mode, rect);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_DeleteStrokes(IInkDisp *iface, IInkStrokes *strokes)
+{
+    FIXME("%p, %p: stub\n", iface, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_DeleteStroke(IInkDisp *iface, IInkStrokeDisp *stroke)
+{
+    FIXME("%p, %p: stub\n", iface, stroke);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_ExtractStrokes(IInkDisp *iface, IInkStrokes *strokes, InkExtractFlags flags,
+        IInkDisp **out)
+{
+    FIXME("%p, %p, %#x, %p: stub\n", iface, strokes, flags, out);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_ExtractWithRectangle(IInkDisp *iface, IInkRectangle *rect, InkExtractFlags flags,
+        IInkDisp **out)
+{
+    FIXME("%p, %p, %#x, %p: stub\n", iface, rect, flags, out);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Clip(IInkDisp *iface, IInkRectangle *rect)
+{
+    FIXME("%p, %p: stub\n", iface, rect);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Clone(IInkDisp *iface, IInkDisp **out)
+{
+    TRACE("%p, %p\n", iface, out);
+    if (!out) return E_POINTER;
+    /* an empty ink's copy is another empty ink */
+    return create_ink(out);
+}
+
+static HRESULT WINAPI ink_HitTestCircle(IInkDisp *iface, LONG x, LONG y, float radius, IInkStrokes **strokes)
+{
+    FIXME("%p, %ld, %ld, %f, %p: stub\n", iface, x, y, radius, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_HitTestWithRectangle(IInkDisp *iface, IInkRectangle *rect, float percent,
+        IInkStrokes **strokes)
+{
+    FIXME("%p, %p, %f, %p: stub\n", iface, rect, percent, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_HitTestWithLasso(IInkDisp *iface, VARIANT points, float percent, VARIANT *lasso,
+        IInkStrokes **strokes)
+{
+    FIXME("%p, %f, %p, %p: stub\n", iface, percent, lasso, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_NearestPoint(IInkDisp *iface, LONG x, LONG y, float *point, float *distance,
+        IInkStrokeDisp **stroke)
+{
+    TRACE("%p, %ld, %ld, %p, %p, %p\n", iface, x, y, point, distance, stroke);
+    if (!stroke) return E_POINTER;
+    /* no strokes, so none is nearest */
+    *stroke = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI ink_CreateStrokes(IInkDisp *iface, VARIANT ids, IInkStrokes **strokes)
+{
+    FIXME("%p, %p: stub\n", iface, strokes);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_AddStrokesAtRectangle(IInkDisp *iface, IInkStrokes *strokes, IInkRectangle *rect)
+{
+    FIXME("%p, %p, %p: stub\n", iface, strokes, rect);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Save(IInkDisp *iface, InkPersistenceFormat format,
+        InkPersistenceCompressionMode mode, VARIANT *data)
+{
+    FIXME("%p, %d, %d, %p: stub\n", iface, format, mode, data);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
+{
+    FIXME("%p: stub\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_CreateStroke(IInkDisp *iface, VARIANT packets, VARIANT desc, IInkStrokeDisp **stroke)
+{
+    FIXME("%p, %p: stub\n", iface, stroke);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_ClipboardCopyWithRectangle(IInkDisp *iface, IInkRectangle *rect,
+        InkClipboardFormats formats, InkClipboardModes modes, IDataObject **data)
+{
+    FIXME("%p, %p, %#x, %#x, %p: stub\n", iface, rect, formats, modes, data);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_ClipboardCopy(IInkDisp *iface, IInkStrokes *strokes, InkClipboardFormats formats,
+        InkClipboardModes modes, IDataObject **data)
+{
+    FIXME("%p, %p, %#x, %#x, %p: stub\n", iface, strokes, formats, modes, data);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_CanPaste(IInkDisp *iface, IDataObject *data, VARIANT_BOOL *can_paste)
+{
+    FIXME("%p, %p, %p: no ink formats are read yet\n", iface, data, can_paste);
+    if (!can_paste) return E_POINTER;
+    *can_paste = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI ink_ClipboardPaste(IInkDisp *iface, LONG x, LONG y, IDataObject *data,
+        IInkStrokes **strokes)
+{
+    FIXME("%p, %ld, %ld, %p, %p: stub\n", iface, x, y, data, strokes);
+    return E_NOTIMPL;
+}
+
+static const IInkDispVtbl ink_vtbl =
+{
+    ink_QueryInterface,
+    ink_AddRef,
+    ink_Release,
+    ink_GetTypeInfoCount,
+    ink_GetTypeInfo,
+    ink_GetIDsOfNames,
+    ink_Invoke,
+    ink_get_Strokes,
+    ink_get_ExtendedProperties,
+    ink_get_Dirty,
+    ink_put_Dirty,
+    ink_get_CustomStrokes,
+    ink_GetBoundingBox,
+    ink_DeleteStrokes,
+    ink_DeleteStroke,
+    ink_ExtractStrokes,
+    ink_ExtractWithRectangle,
+    ink_Clip,
+    ink_Clone,
+    ink_HitTestCircle,
+    ink_HitTestWithRectangle,
+    ink_HitTestWithLasso,
+    ink_NearestPoint,
+    ink_CreateStrokes,
+    ink_AddStrokesAtRectangle,
+    ink_Save,
+    ink_Load,
+    ink_CreateStroke,
+    ink_ClipboardCopyWithRectangle,
+    ink_ClipboardCopy,
+    ink_CanPaste,
+    ink_ClipboardPaste,
+};
+
+static HRESULT create_ink(IInkDisp **out)
+{
+    struct ink *ink;
+
+    if (!(ink = calloc(1, sizeof(*ink)))) return E_OUTOFMEMORY;
+    ink->IInkDisp_iface.lpVtbl = &ink_vtbl;
+    ink->ref = 1;
+    ink->dirty = VARIANT_FALSE;
+    *out = &ink->IInkDisp_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IClassFactory))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
+{
+    IInkDisp *ink;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p\n", outer, debugstr_guid(riid), out);
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = create_ink(&ink))) return hr;
+    hr = IInkDisp_QueryInterface(ink, riid, out);
+    IInkDisp_Release(ink);
+    return hr;
+}
+
+static HRESULT WINAPI factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateInstance,
+    factory_LockServer,
+};
+
+static IClassFactory ink_factory = { &factory_vtbl };
+
 /*****************************************************
  *    DllGetClassObject [INKOBJ.@]
  */
 HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, LPVOID* ppv)
 {
+    TRACE("%s, %s, %p\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
+#ifndef SG_MUTANT_NO_INKDISP
+    if (IsEqualCLSID(rclsid, &CLSID_InkDisp))
+        return IClassFactory_QueryInterface(&ink_factory, riid, ppv);
+#endif
     FIXME("Not implemented. Requested class was:%s\n", debugstr_guid(rclsid));
+    *ppv = NULL;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
