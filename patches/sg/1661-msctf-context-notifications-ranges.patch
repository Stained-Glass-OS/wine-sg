+/* move an anchor by count characters, within the document; the end may not
+ * pass before the start or the start past the end (they move together) */
+static HRESULT shift_anchor(Range *range, TfEditCookie ec, BOOL start, LONG req, LONG *moved)
+{
+    LONG end_doc, pos, target;
+
+    if (!range_has_lock(ec)) return TF_E_NOLOCK;
+    end_doc = range_doc_end(range);
+    pos = start ? range->anchorStart : range->anchorEnd;
+    target = max(0, min(end_doc, pos + req));
+    if (moved) *moved = target - pos;
+    if (start)
+    {
+        range->anchorStart = target;
+        if ((LONG)range->anchorEnd < target) range->anchorEnd = target;
+    }
+    else
+    {
+        range->anchorEnd = target;
+        if ((LONG)range->anchorStart > target) range->anchorStart = target;
+    }
+    return S_OK;
 }
 
