+/* Stained Glass OS 1661: the text store changed outside an edit session:
+ * the text edit sinks are told, under a read lock, with an edit record */
+static void request_notify_lock(Context *This)
+{
+    HRESULT hrSession;
+
+    if (!This->pITextStoreACP || This->currentEditSession) return;   /* told at the session's end */
+    if (list_empty(&This->pTextEditSink)) return;
+    ITextStoreACP_RequestLock(This->pITextStoreACP, TS_LF_READ | TS_LF_SYNC, &hrSession);
+}
