+/* Stained Glass OS 1661: the context's view (the text store's active one):
+ * where text is on the screen, the window, the range at a point */
+typedef struct
+{
+    ITfContextView ITfContextView_iface;
+    LONG ref;
+    Context *context;
+    TsViewCookie cookie;
+} ContextView;
+
+static inline ContextView *impl_from_ITfContextView(ITfContextView *iface)
+{
+    return CONTAINING_RECORD(iface, ContextView, ITfContextView_iface);
+}
+
+static HRESULT WINAPI ContextView_QueryInterface(ITfContextView *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITfContextView))
+    {
+        *ppv = iface;
+        ITfContextView_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ContextView_AddRef(ITfContextView *iface)
+{
+    return InterlockedIncrement(&impl_from_ITfContextView(iface)->ref);
+}
+
+static ULONG WINAPI ContextView_Release(ITfContextView *iface)
+{
+    ContextView *This = impl_from_ITfContextView(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ITfContext_Release(&This->context->ITfContext_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI ContextView_GetRangeFromPoint(ITfContextView *iface, TfEditCookie ec, const POINT *pt,
+        DWORD flags, ITfRange **range)
+{
+    ContextView *This = impl_from_ITfContextView(iface);
+    LONG acp;
+    HRESULT hr;
+
+    TRACE("(%p) %li %p %lx %p\n", This, ec, pt, flags, range);
+
+    if (!pt || !range) return E_INVALIDARG;
+    *range = NULL;
+    if (get_Cookie_magic(ec) != COOKIE_MAGIC_EDITCOOKIE) return TF_E_NOLOCK;
+    if (!This->context->pITextStoreACP) return E_FAIL;
+    /* GXFPF_ROUND_NEAREST and GXFPF_NEAREST are TS_ ones too */
+    hr = ITextStoreACP_GetACPFromPoint(This->context->pITextStoreACP, This->cookie, pt, flags, &acp);
+    if (hr == TS_E_NOLOCK) return TF_E_NOLOCK;
+    if (FAILED(hr)) return hr;
+    return Range_Constructor(&This->context->ITfContext_iface, acp, acp, range);
+}
+
+static HRESULT WINAPI ContextView_GetTextExt(ITfContextView *iface, TfEditCookie ec, ITfRange *range,
+        RECT *rc, BOOL *clipped)
+{
+    ContextView *This = impl_from_ITfContextView(iface);
+    LONG start, end;
+    HRESULT hr;
+
+    TRACE("(%p) %li %p %p %p\n", This, ec, range, rc, clipped);
+
+    if (!range || !rc || !clipped) return E_INVALIDARG;
+    if (get_Cookie_magic(ec) != COOKIE_MAGIC_EDITCOOKIE) return TF_E_NOLOCK;
+    if (!This->context->pITextStoreACP) return E_FAIL;
+    if (FAILED(hr = Range_GetAnchors(range, &start, &end))) return hr;
+    hr = ITextStoreACP_GetTextExt(This->context->pITextStoreACP, This->cookie, start, end, rc, clipped);
+    return hr == TS_E_NOLOCK ? TF_E_NOLOCK : hr;
+}
+
+static HRESULT WINAPI ContextView_GetScreenExt(ITfContextView *iface, RECT *rc)
+{
+    ContextView *This = impl_from_ITfContextView(iface);
+
+    TRACE("(%p) %p\n", This, rc);
+
+    if (!rc) return E_INVALIDARG;
+    if (!This->context->pITextStoreACP) return E_FAIL;
+    return ITextStoreACP_GetScreenExt(This->context->pITextStoreACP, This->cookie, rc);
+}
+
+static HRESULT WINAPI ContextView_GetWnd(ITfContextView *iface, HWND *hwnd)
+{
+    ContextView *This = impl_from_ITfContextView(iface);
+
+    TRACE("(%p) %p\n", This, hwnd);
+
+    if (!hwnd) return E_INVALIDARG;
+    *hwnd = NULL;
+    if (!This->context->pITextStoreACP) return E_FAIL;
+    return ITextStoreACP_GetWnd(This->context->pITextStoreACP, This->cookie, hwnd);
+}
+
+static const ITfContextViewVtbl ContextViewVtbl =
+{
+    ContextView_QueryInterface,
+    ContextView_AddRef,
+    ContextView_Release,
+    ContextView_GetRangeFromPoint,
+    ContextView_GetTextExt,
+    ContextView_GetScreenExt,
+    ContextView_GetWnd
+};
+
+static HRESULT ContextView_Create(Context *context, TsViewCookie cookie, ITfContextView **ret)
+{
+    ContextView *view = calloc(1, sizeof(*view));
+    if (!view) return E_OUTOFMEMORY;
+    view->ITfContextView_iface.lpVtbl = &ContextViewVtbl;
+    view->ref = 1;
+    view->context = context;
+    view->cookie = cookie;
+    ITfContext_AddRef(&context->ITfContext_iface);
+    *ret = &view->ITfContextView_iface;
+    return S_OK;
+}
+
+/* an enumeration of the one view */
+typedef struct
+{
+    IEnumTfContextViews IEnumTfContextViews_iface;
+    LONG ref;
+    ITfContextView *view;
+    ULONG pos;
+} EnumViews;
+
+static inline EnumViews *impl_from_IEnumTfContextViews(IEnumTfContextViews *iface)
+{
+    return CONTAINING_RECORD(iface, EnumViews, IEnumTfContextViews_iface);
+}
+
+static HRESULT EnumViews_Create(ITfContextView *view, IEnumTfContextViews **ret);
+
+static HRESULT WINAPI EnumViews_QueryInterface(IEnumTfContextViews *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumTfContextViews))
+    {
+        *ppv = iface;
+        IEnumTfContextViews_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumViews_AddRef(IEnumTfContextViews *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumTfContextViews(iface)->ref);
+}
+
+static ULONG WINAPI EnumViews_Release(IEnumTfContextViews *iface)
+{
+    EnumViews *This = impl_from_IEnumTfContextViews(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ITfContextView_Release(This->view);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumViews_Clone(IEnumTfContextViews *iface, IEnumTfContextViews **ret)
+{
+    EnumViews *This = impl_from_IEnumTfContextViews(iface);
+    HRESULT hr;
+    if (!ret) return E_INVALIDARG;
+    if (SUCCEEDED(hr = EnumViews_Create(This->view, ret)))
+        impl_from_IEnumTfContextViews(*ret)->pos = This->pos;
+    return hr;
+}
+
+static HRESULT WINAPI EnumViews_Next(IEnumTfContextViews *iface, ULONG count, ITfContextView **views, ULONG *fetched)
+{
+    EnumViews *This = impl_from_IEnumTfContextViews(iface);
+    ULONG n = 0;
+
+    if (!views) return E_INVALIDARG;
+    if (count && !This->pos)
+    {
+        views[n++] = This->view;
+        ITfContextView_AddRef(This->view);
+        This->pos = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumViews_Reset(IEnumTfContextViews *iface)
+{
+    impl_from_IEnumTfContextViews(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumViews_Skip(IEnumTfContextViews *iface, ULONG count)
+{
+    EnumViews *This = impl_from_IEnumTfContextViews(iface);
+    if (!count) return S_OK;
+    if (This->pos) return S_FALSE;
+    This->pos = 1;
+    return count == 1 ? S_OK : S_FALSE;
+}
+
+static const IEnumTfContextViewsVtbl EnumViewsVtbl =
+{
+    EnumViews_QueryInterface,
+    EnumViews_AddRef,
+    EnumViews_Release,
+    EnumViews_Clone,
+    EnumViews_Next,
+    EnumViews_Reset,
+    EnumViews_Skip
+};
+
+static HRESULT EnumViews_Create(ITfContextView *view, IEnumTfContextViews **ret)
+{
+    EnumViews *e = calloc(1, sizeof(*e));
+    if (!e) return E_OUTOFMEMORY;
+    e->IEnumTfContextViews_iface.lpVtbl = &EnumViewsVtbl;
+    e->ref = 1;
+    e->view = view;
+    ITfContextView_AddRef(view);
+    *ret = &e->IEnumTfContextViews_iface;
+    return S_OK;
+}
+
+/* an enumeration of (at most) one range */
+typedef struct
+{
+    IEnumTfRanges IEnumTfRanges_iface;
+    LONG ref;
+    ITfRange *range;
+    ULONG pos;
+} EnumRanges;
+
+static inline EnumRanges *impl_from_IEnumTfRanges(IEnumTfRanges *iface)
+{
+    return CONTAINING_RECORD(iface, EnumRanges, IEnumTfRanges_iface);
+}
+
+static HRESULT EnumTfRanges_Create(ITfRange *range, IEnumTfRanges **ret);
+
+static HRESULT WINAPI EnumRanges_QueryInterface(IEnumTfRanges *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IEnumTfRanges))
+    {
+        *ppv = iface;
+        IEnumTfRanges_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumRanges_AddRef(IEnumTfRanges *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumTfRanges(iface)->ref);
+}
+
+static ULONG WINAPI EnumRanges_Release(IEnumTfRanges *iface)
+{
+    EnumRanges *This = impl_from_IEnumTfRanges(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        if (This->range) ITfRange_Release(This->range);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumRanges_Clone(IEnumTfRanges *iface, IEnumTfRanges **ret)
+{
+    EnumRanges *This = impl_from_IEnumTfRanges(iface);
+    HRESULT hr;
+    if (!ret) return E_INVALIDARG;
+    if (SUCCEEDED(hr = EnumTfRanges_Create(This->range, ret)))
+        impl_from_IEnumTfRanges(*ret)->pos = This->pos;
+    return hr;
+}
+
+static HRESULT WINAPI EnumRanges_Next(IEnumTfRanges *iface, ULONG count, ITfRange **ranges, ULONG *fetched)
+{
+    EnumRanges *This = impl_from_IEnumTfRanges(iface);
+    ULONG n = 0;
+
+    if (!ranges) return E_INVALIDARG;
+    if (count && This->range && !This->pos)
+    {
+        ranges[n++] = This->range;
+        ITfRange_AddRef(This->range);
+        This->pos = 1;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumRanges_Reset(IEnumTfRanges *iface)
+{
+    impl_from_IEnumTfRanges(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumRanges_Skip(IEnumTfRanges *iface, ULONG count)
+{
+    EnumRanges *This = impl_from_IEnumTfRanges(iface);
+    if (!count) return S_OK;
+    if (This->pos || !This->range) return S_FALSE;
+    This->pos = 1;
+    return count == 1 ? S_OK : S_FALSE;
+}
+
+static const IEnumTfRangesVtbl EnumRangesVtbl =
+{
+    EnumRanges_QueryInterface,
+    EnumRanges_AddRef,
+    EnumRanges_Release,
+    EnumRanges_Clone,
+    EnumRanges_Next,
+    EnumRanges_Reset,
+    EnumRanges_Skip
+};
+
+static HRESULT EnumTfRanges_Create(ITfRange *range, IEnumTfRanges **ret)
+{
+    EnumRanges *e = calloc(1, sizeof(*e));
+    if (!e) return E_OUTOFMEMORY;
+    e->IEnumTfRanges_iface.lpVtbl = &EnumRangesVtbl;
+    e->ref = 1;
+    e->range = range;
+    if (range) ITfRange_AddRef(range);
+    *ret = &e->IEnumTfRanges_iface;
+    return S_OK;
+}
+
+/* the edit record OnEndEdit gets: whether the selection changed, and the
+ * ranges whose text changed */
+typedef struct
+{
+    ITfEditRecord ITfEditRecord_iface;
+    LONG ref;
+    ITfContext *context;
+    BOOL selection;
+    LONG start, end;    /* start > end: no text changed */
+} EditRecord;
+
+static inline EditRecord *impl_from_ITfEditRecord(ITfEditRecord *iface)
+{
+    return CONTAINING_RECORD(iface, EditRecord, ITfEditRecord_iface);
+}
+
+static HRESULT WINAPI EditRecord_QueryInterface(ITfEditRecord *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_ITfEditRecord))
+    {
+        *ppv = iface;
+        ITfEditRecord_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EditRecord_AddRef(ITfEditRecord *iface)
+{
+    return InterlockedIncrement(&impl_from_ITfEditRecord(iface)->ref);
+}
+
+static ULONG WINAPI EditRecord_Release(ITfEditRecord *iface)
+{
+    EditRecord *This = impl_from_ITfEditRecord(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ITfContext_Release(This->context);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EditRecord_GetSelectionStatus(ITfEditRecord *iface, BOOL *changed)
+{
+    if (!changed) return E_INVALIDARG;
+    *changed = impl_from_ITfEditRecord(iface)->selection;
+    return S_OK;
+}
+
+static HRESULT WINAPI EditRecord_GetTextAndPropertyUpdates(ITfEditRecord *iface, DWORD flags, const GUID **props,
+        ULONG count, IEnumTfRanges **ret)
+{
+    EditRecord *This = impl_from_ITfEditRecord(iface);
+    ITfRange *range = NULL;
+    HRESULT hr;
+
+    TRACE("(%p) %lx %p %lu %p\n", This, flags, props, count, ret);
+
+    if (!ret) return E_INVALIDARG;
+    /* text changes only: properties are not tracked */
+    if (This->start <= This->end && (flags & TF_GTP_INCL_TEXT) &&
+        FAILED(hr = Range_Constructor(This->context, This->start, This->end, &range))) return hr;
+    hr = EnumTfRanges_Create(range, ret);
+    if (range) ITfRange_Release(range);
+    return hr;
+}
+
+static const ITfEditRecordVtbl EditRecordVtbl =
+{
+    EditRecord_QueryInterface,
+    EditRecord_AddRef,
+    EditRecord_Release,
+    EditRecord_GetSelectionStatus,
+    EditRecord_GetTextAndPropertyUpdates
+};
+
+static ITfEditRecord *EditRecord_Create(Context *context)
+{
+    EditRecord *rec = calloc(1, sizeof(*rec));
+    if (!rec) return NULL;
+    rec->ITfEditRecord_iface.lpVtbl = &EditRecordVtbl;
+    rec->ref = 1;
+    rec->context = &context->ITfContext_iface;
+    ITfContext_AddRef(rec->context);
+    rec->selection = context->selectionChanged;
+    rec->start = context->changeStart;
+    rec->end = context->changeEnd;
+    context->selectionChanged = FALSE;
+    context->changeStart = 1;
+    context->changeEnd = 0;
+    return &rec->ITfEditRecord_iface;
+}
+
+/* tell the text edit sinks, under a read lock: what changed */
+static void notify_end_edit(Context *This, TfEditCookie ec)
+{
+    ITfEditRecord *rec = EditRecord_Create(This);
+    ITfTextEditSink *sink;
+    struct list *cursor;
+
+    SINK_FOR_EACH(cursor, &This->pTextEditSink, ITfTextEditSink, sink)
+    {
+        ITfTextEditSink_OnEndEdit(sink, &This->ITfContext_iface, ec, rec);
+    }
+    if (rec) ITfEditRecord_Release(rec);
+}
+
+/* a range's text store (range.c) */
+ITextStoreACP *Context_GetTextStore(ITfContext *iface)
+{
+    return iface ? impl_from_ITfContext(iface)->pITextStoreACP : NULL;
+}
