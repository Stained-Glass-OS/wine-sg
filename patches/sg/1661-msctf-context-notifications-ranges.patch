+/* Stained Glass OS 1661: ranges over the context's text store (ACP). Text,
+ * formatted text and embedded objects come from the text store; moving and
+ * comparing anchors is done here, within the document's length. */
+static ITextStoreACP *range_store(Range *range)
+{
+    return Context_GetTextStore(range->context);
+}
+
+static BOOL range_has_lock(TfEditCookie ec)
+{
+    return get_Cookie_magic(ec) == COOKIE_MAGIC_EDITCOOKIE;
+}
+
+static LONG range_doc_end(Range *range)
+{
+    ITextStoreACP *store = range_store(range);
+    LONG end = 0;
+    if (store && FAILED(ITextStoreACP_GetEndACP(store, &end))) end = 0;
+    return end;
+}
+
+static Range *range_from(ITfRange *other)
+{
+    return other ? unsafe_impl_from_ITfRange(other) : NULL;
+}
