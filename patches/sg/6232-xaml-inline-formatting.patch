+/* a Direct2D brush for text drawing effects: a gradient over an area, else the brush's colour, else COLOR */
+IUnknown *xdraw_d2d_brush( struct xdraw *draw, IInspectable *brush, const struct xcolor *color, const struct xrect *rect )
+{
+    ID2D1Brush *ret = brush ? gradient_brush( draw, brush, rect ) : NULL;
+    struct xcolor c;
+
+    if (ret) return (IUnknown *)ret;
+    if (brush && xaml_brush_color( brush, &c )) color = &c;
+    if (!color) return NULL;
+    {
+        ID2D1SolidColorBrush *solid_brush = NULL;
+        D2D1_COLOR_F f = d2d_color( *color );
+        ID2D1RenderTarget_CreateSolidColorBrush( draw->target, &f, NULL, &solid_brush );
+        return (IUnknown *)solid_brush;
+    }
+}
