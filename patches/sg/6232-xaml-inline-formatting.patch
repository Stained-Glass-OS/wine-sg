-static void collect( struct xvector *inlines, WCHAR **buf, size_t *len, size_t *size, int depth )
+/* the formatting text inherits down the spans */
+struct format { INT32 weight, style, underline, strike; DOUBLE size; IInspectable *foreground; BOOL hyperlink; };
+
+struct collector
+{
+    WCHAR *buf;
+    size_t len, size;
+    struct xtext_range *ranges;
+    UINT32 count, capacity;
+};
+
+static void own_format( struct text_inline *in, const struct format *parent, struct format *f )
+{
+    IInspectable *box = NULL;
+    struct { UINT16 weight; } weight;
+
+    *f = *parent;
+    if (in->kind == INLINE_BOLD) f->weight = 700;
+    if (in->kind == INLINE_ITALIC) f->style = 2;
+    if (in->kind == INLINE_UNDERLINE || in->kind == INLINE_HYPERLINK) f->underline = 1;
+    if (in->kind == INLINE_HYPERLINK) f->hyperlink = TRUE;
+#ifdef SG_MUTANT_INLINE_FORMAT_IGNORED
+    return;
+#endif
+    if (dobj_has_value( &in->d, prop_te_font_weight ) && SUCCEEDED(dobj_get_value( &in->d, prop_te_font_weight, &box )) && box)
+    {
+        weight.weight = 0;
+        xunbox_ref( box, &IID_IReference_FontWeight, &weight, sizeof(weight) );
+        if (weight.weight) f->weight = weight.weight;
+        IInspectable_Release( box );
+        box = NULL;
+    }
+    if (dobj_has_value( &in->d, prop_te_font_style ) && SUCCEEDED(dobj_get_value( &in->d, prop_te_font_style, &box )) && box)
+    {
+        f->style = xunbox_enum( box, &IID_IReference_FontStyle, 0 );
+        IInspectable_Release( box );
+        box = NULL;
+    }
+    if (dobj_has_value( &in->d, prop_te_font_size ) && SUCCEEDED(dobj_get_value( &in->d, prop_te_font_size, &box )) && box)
+    {
+        DOUBLE size = xunbox_double( box, 0 );
+        if (size > 0) f->size = size;
+        IInspectable_Release( box );
+        box = NULL;
+    }
+    if (dobj_has_value( &in->d, prop_te_decorations ) && SUCCEEDED(dobj_get_value( &in->d, prop_te_decorations, &box )) && box)
+    {
+        INT32 d = xunbox_enum( box, NULL, 0 );
+        f->underline = !!(d & 1);
+        f->strike = !!(d & 2);
+        IInspectable_Release( box );
+        box = NULL;
+    }
+    if (dobj_has_value( &in->d, prop_te_foreground ) && SUCCEEDED(dobj_get_value( &in->d, prop_te_foreground, &box )) && box)
+    {
+        f->foreground = box;   /* kept by the inline; the range takes its own reference */
+        IInspectable_Release( box );
+    }
+}
+
+static void add_range( struct collector *c, size_t start, const struct format *f )
+{
+    struct xtext_range *r;
+
+    if (!c->buf || c->len <= start) return;
+    if (f->weight <= 0 && f->style < 0 && f->underline < 0 && f->strike <= 0 && f->size <= 0 && !f->foreground && !f->hyperlink) return;
+    if (c->count == c->capacity)
+    {
+        UINT32 n = max( 8, c->capacity * 2 );
+        if (!(r = realloc( c->ranges, n * sizeof(*r) ))) return;
+        c->ranges = r;
+        c->capacity = n;
+    }
+    r = &c->ranges[c->count++];
+    r->start = start;
+    r->length = c->len - start;
+    r->weight = f->weight;
+    r->style = f->style;
+    r->underline = f->underline;
+    r->strike = f->strike;
+    r->size = f->size;
+    r->hyperlink = f->hyperlink;
+    if ((r->foreground = f->foreground)) IInspectable_AddRef( r->foreground );
+}
+
