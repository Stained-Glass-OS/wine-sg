From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: inline text formatting, Bold, Italic, Underline, Hyperlink

A TextBlock's Inlines were drawn as plain text: a Run's or Span's Foreground, FontWeight, FontStyle, FontSize and TextDecorations were not kept, and Bold, Italic, Underline and Hyperlink were missing (text in them came out unformatted or not at all). TextElement's formatting members are now kept (ITextElement getters and setters, markup), Bold/Italic/Underline/Hyperlink exist (a Hyperlink keeps its NavigateUri and Click handlers, and is drawn underlined in the accent colour), text written inside a span becomes a Run, and each part of the text is laid out and drawn with its formatting, inherited down the spans; a Foreground may be a gradient.
---
diff --git a/dlls/windows.ui.xaml/classes.idl b/dlls/windows.ui.xaml/classes.idl
index 9e64b51..2804da0 100644
--- a/dlls/windows.ui.xaml/classes.idl
+++ b/dlls/windows.ui.xaml/classes.idl
@@ -1121,6 +1121,16 @@ namespace Windows.UI.Xaml.Documents {
     {
         [default] interface Windows.UI.Xaml.Documents.ISpan;
     }
+
+    /* wine-sg 6232 */
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass Bold { [default] interface Windows.UI.Xaml.Documents.ISpan; }
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass Italic { [default] interface Windows.UI.Xaml.Documents.ISpan; }
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass Underline { [default] interface Windows.UI.Xaml.Documents.ISpan; }
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass Hyperlink { [default] interface Windows.UI.Xaml.Documents.ISpan; }
 }
 
 namespace Windows.UI.Xaml {
