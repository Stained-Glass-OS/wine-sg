From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, appxdeploymentclient: a package's File Explorer commands (6030)

A package declares its context menu commands with a
fileExplorerContextMenus extension -- for "*", ".ext" or "Directory", a
verb naming a COM class that implements IExplorerCommand -- and the
class with a windows.comServer extension. TeraCopy's package does (on
Windows 10 2004 and later its setup registers no classic shell
extension), as do the Windows 11 menus of many programs; File Explorer
showed none of them.

appxdeploymentclient registers a package's com:SurrogateServer and
com:ExeServer classes for the user (InprocServer32 with its threading
model and a DllSurrogate AppID, or LocalServer32, in the package or its
external location) unless the machine has the class already, records
them and removes them with the package. shell32's item context menu
adds each command of the user's packages for the items' type, through
an IContextMenu over the IExplorerCommand: its title and state (hidden,
disabled, checked), sub-commands as a submenu, Invoke with the selected
items. shobjidl.idl gains IExplorerCommand and IEnumExplorerCommand.
---
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index 0177d1a..b1f8998 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -59,6 +59,14 @@
  * location for a package that does not allow external content is refused
  * (ERROR_PACKAGE_EXTERNAL_LOCATION_NOT_ALLOWED).
  *
+ * COM servers (windows.comServer: com:SurrogateServer / com:ExeServer and
+ * their com:Class elements): each class the machine does not have already is
+ * registered for the user under HKCU\Software\Classes\CLSID -- a surrogate
+ * server's DLL as InprocServer32 with its threading model and a DllSurrogate
+ * AppID, an exe server as LocalServer32 -- so that CoCreateInstance finds it
+ * (File Explorer's packaged context menu verbs are such classes); the record
+ * lists them (ComClasses) and removal takes them away.
+ *
  * Unsigned packages: with AddPackageOptions.AllowUnsigned, a package without a
  * signature installs when its publisher has the OID Windows reserves for them
  * (OID.2.25.311729368913984317654407730594956997722=1); a signed package with
@@ -759,6 +767,178 @@ done:
     IStream_Release( stream );
 }
 
+/* ---- COM servers -------------------------------------------------------------------------- */
+
+static const WCHAR *threading_model( const WCHAR *model )
+{
+    if (!model || !wcsicmp( model, L"STA" )) return L"Apartment";
+    if (!wcsicmp( model, L"MTA" )) return L"Free";
+    if (!wcsicmp( model, L"Both" )) return L"Both";
+    if (!wcsicmp( model, L"Neutral" )) return L"Neutral";
+    return L"Apartment";
+}
+
+/* A class of the package's: registered for the user, unless the machine knows it already. */
+static void register_com_class( const WCHAR *clsid, const WCHAR *display, const WCHAR *inproc, const WCHAR *model,
+                                const WCHAR *local_server, struct strlist *list )
+{
+    WCHAR key_path[128], id[40];
+    HKEY key, sub;
+    GUID guid;
+
+    /* the manifest's Id has no braces */
+    if (clsid[0] == '{') lstrcpynW( id, clsid, ARRAY_SIZE(id) );
+    else swprintf( id, ARRAY_SIZE(id), L"{%s}", clsid );
+    if (wcslen( id ) != 38 || FAILED(CLSIDFromString( id, &guid ))) return;
+    StringFromGUID2( &guid, id, ARRAY_SIZE(id) );
+    swprintf( key_path, ARRAY_SIZE(key_path), L"CLSID\\%s", id );
+#ifndef SG_MUTANT_PKGCOM_CLOBBER
+    if (!RegOpenKeyExW( HKEY_CLASSES_ROOT, key_path, 0, KEY_READ, &key ))
+    {
+        TRACE( "%s is registered already\n", debugstr_w( id ) );
+        RegCloseKey( key );
+        return;
+    }
+#endif
+    swprintf( key_path, ARRAY_SIZE(key_path), L"Software\\Classes\\CLSID\\%s", id );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, key_path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return;
+    if (display) reg_set_string( key, NULL, display );
+    if (inproc && !RegCreateKeyExW( key, L"InprocServer32", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sub, NULL ))
+    {
+        reg_set_string( sub, NULL, inproc );
+        reg_set_string( sub, L"ThreadingModel", threading_model( model ) );
+        RegCloseKey( sub );
+        /* a surrogate server: dllhost serves it to callers that ask for a local server */
+        reg_set_string( key, L"AppID", id );
+        swprintf( key_path, ARRAY_SIZE(key_path), L"Software\\Classes\\AppID\\%s", id );
+        if (!RegCreateKeyExW( HKEY_CURRENT_USER, key_path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sub, NULL ))
+        {
+            if (display) reg_set_string( sub, NULL, display );
+            reg_set_string( sub, L"DllSurrogate", L"" );
+            RegCloseKey( sub );
+        }
+    }
+    if (local_server && !RegCreateKeyExW( key, L"LocalServer32", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sub, NULL ))
+    {
+        reg_set_string( sub, NULL, local_server );
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+    strlist_add( list, id );
+    TRACE( "registered %s: %s\n", debugstr_w( id ), debugstr_w( inproc ? inproc : local_server ) );
+}
+
+static WCHAR *xml_attribute( IXmlReader *reader, const WCHAR *name )
+{
+    const WCHAR *value;
+    WCHAR *ret = NULL;
+
+    if (IXmlReader_MoveToAttributeByName( reader, name, NULL ) == S_OK &&
+        SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) ret = wcsdup( value );
+    IXmlReader_MoveToElement( reader );
+    return ret;
+}
+
+/* The manifest's windows.comServer extensions, at the package's level or an application's. */
+static void register_com_servers( IAppxManifestReader *manifest, const struct package_record *rec, struct strlist *list )
+{
+    WCHAR *server_display = NULL, *exe = NULL, *args = NULL;
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType type;
+    UINT server_depth = 0, com_depth = 0;
+    BOOL surrogate = FALSE;
+
+    if (FAILED(IAppxManifestReader_GetStream( manifest, &stream ))) return;
+    if (FAILED(CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL ))) goto done;
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (FAILED(IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+
+    while (IXmlReader_Read( reader, &type ) == S_OK)
+    {
+        const WCHAR *name;
+        UINT depth;
+
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        IXmlReader_GetDepth( reader, &depth );
+        if (server_depth && depth <= server_depth) server_depth = 0;
+        if (com_depth && depth <= com_depth) com_depth = 0;
+        if (!wcscmp( name, L"ComServer" ))
+        {
+            com_depth = depth;
+            continue;
+        }
+        if (com_depth && (!wcscmp( name, L"SurrogateServer" ) || !wcscmp( name, L"ExeServer" )))
+        {
+            free( server_display );
+            free( exe );
+            free( args );
+            server_display = xml_attribute( reader, L"DisplayName" );
+            surrogate = !wcscmp( name, L"SurrogateServer" );
+            exe = surrogate ? NULL : xml_attribute( reader, L"Executable" );
+            args = surrogate ? NULL : xml_attribute( reader, L"Arguments" );
+            server_depth = depth;
+            continue;
+        }
+        if (server_depth && depth > server_depth && !wcscmp( name, L"Class" ))
+        {
+            WCHAR *id = xml_attribute( reader, L"Id" ), *path = xml_attribute( reader, L"Path" );
+            WCHAR *model = xml_attribute( reader, L"ThreadingModel" ), *display = xml_attribute( reader, L"DisplayName" );
+            WCHAR target[MAX_PATH], command[MAX_PATH * 2];
+
+            if (id && surrogate && path && payload_path( content_root( rec ), path, target, ARRAY_SIZE(target) ))
+                register_com_class( id, display ? display : server_display, target, model, NULL, list );
+            else if (id && !surrogate && exe && payload_path( content_root( rec ), exe, target, ARRAY_SIZE(target) ))
+            {
+                swprintf( command, ARRAY_SIZE(command), args ? L"\"%s\" %s" : L"\"%s\"", target, args );
+                register_com_class( id, display ? display : server_display, NULL, NULL, command, list );
+            }
+            else WARN( "not registering class %s (%s)\n", debugstr_w( id ), debugstr_w( path ? path : exe ) );
+            free( id );
+            free( path );
+            free( model );
+            free( display );
+        }
+    }
+
+done:
+    free( server_display );
+    free( exe );
+    free( args );
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+}
+
+/* The classes registered for a package, recorded with it. */
+static void record_com_classes( const WCHAR *full_name, const struct strlist *list )
+{
+    WCHAR path[MAX_PATH];
+    HKEY key;
+
+    if (!list->data) return;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_SET_VALUE, &key )) return;
+    reg_set_multi( key, L"ComClasses", list );
+    RegCloseKey( key );
+}
+
+static void unregister_com_classes( HKEY record )
+{
+    WCHAR *list, *p, path[128];
+
+    if (!(list = reg_multi( record, L"ComClasses" ))) return;
+    for (p = list; *p; p += wcslen( p ) + 1)
+    {
+        if (p[0] != '{' || wcslen( p ) != 38) continue;
+        swprintf( path, ARRAY_SIZE(path), L"Software\\Classes\\CLSID\\%s", p );
+        RegDeleteTreeW( HKEY_CURRENT_USER, path );
+        swprintf( path, ARRAY_SIZE(path), L"Software\\Classes\\AppID\\%s", p );
+        RegDeleteTreeW( HKEY_CURRENT_USER, path );
+    }
+    free( list );
+}
+
 /* ---- dependencies ---------------------------------------------------------------------- */
 
 /* Which architecture a bundle's application package must have, best first. */
@@ -1071,6 +1251,7 @@ static HRESULT remove_record( const WCHAR *full_name, WCHAR **error_text )
         for (p = list; *p; p += wcslen( p ) + 1) DeleteFileW( p );
         free( list );
     }
+    unregister_com_classes( key );
     /* a development registration is the developer's own folder; the files of the package stay while
      * another user has it */
     if (!rec.development_mode && !other_users_have( full_name )) delete_tree( rec.install_location );
@@ -1194,7 +1375,7 @@ static HRESULT install_package_ex( IAppxPackageReader *reader, DeploymentOptions
 {
     struct package_record rec = { 0 };
     struct family_search family = { 0 };
-    struct strlist shortcuts = { 0 }, aliases = { 0 };
+    struct strlist shortcuts = { 0 }, aliases = { 0 }, classes = { 0 };
     IAppxManifestReader *manifest = NULL;
     IAppxFilesEnumerator *files = NULL;
     IAppxFile *file;
@@ -1314,14 +1495,20 @@ static HRESULT install_package_ex( IAppxPackageReader *reader, DeploymentOptions
     {
         create_shortcuts( manifest, &rec, &shortcuts );
         create_aliases( manifest, &rec, &aliases );
+        register_com_servers( manifest, &rec, &classes );
     }
     if (FAILED(hr = write_record( &rec, &shortcuts, &aliases, resources )))
         set_error( error_text, L"The package could not be registered", NULL );
-    else if (full_name) *full_name = wcsdup( rec.full_name );
+    else
+    {
+        record_com_classes( rec.full_name, &classes );
+        if (full_name) *full_name = wcsdup( rec.full_name );
+    }
 
 done:
     free( shortcuts.data );
     free( aliases.data );
+    free( classes.data );
     free( family.older.data );
     if (files) IAppxFilesEnumerator_Release( files );
     if (manifest) IAppxManifestReader_Release( manifest );
@@ -1753,7 +1940,7 @@ HRESULT register_package_work( const WCHAR *path, DeploymentOptions options, WCH
 {
     const WCHAR *external = list_external( &path );
     struct package_record rec = { 0 };
-    struct strlist shortcuts = { 0 }, aliases = { 0 };
+    struct strlist shortcuts = { 0 }, aliases = { 0 }, classes = { 0 };
     IAppxFactory *factory = NULL;
     IAppxManifestReader *manifest = NULL;
     IStream *stream = NULL;
@@ -1811,13 +1998,16 @@ HRESULT register_package_work( const WCHAR *path, DeploymentOptions options, WCH
     {
         create_shortcuts( manifest, &rec, &shortcuts );
         create_aliases( manifest, &rec, &aliases );
+        register_com_servers( manifest, &rec, &classes );
     }
     if (FAILED(hr = write_record( &rec, &shortcuts, &aliases, NULL )))
         set_error( error_text, L"The package could not be registered", NULL );
+    else record_com_classes( rec.full_name, &classes );
 
 done:
     free( shortcuts.data );
     free( aliases.data );
+    free( classes.data );
     if (manifest) IAppxManifestReader_Release( manifest );
     if (factory) IAppxFactory_Release( factory );
     if (stream) IStream_Release( stream );
@@ -1889,7 +2079,7 @@ HRESULT stage_package_work( const WCHAR *list, DeploymentOptions options, WCHAR
 static HRESULT register_staged_one( const WCHAR *full_name, WCHAR **error_text )
 {
     struct package_record rec;
-    struct strlist shortcuts = { 0 }, aliases = { 0 }, resources = { 0 };
+    struct strlist shortcuts = { 0 }, aliases = { 0 }, resources = { 0 }, classes = { 0 };
     IAppxFactory *factory = NULL;
     IAppxManifestReader *manifest = NULL;
     IStream *stream = NULL;
@@ -1942,17 +2132,23 @@ static HRESULT register_staged_one( const WCHAR *full_name, WCHAR **error_text )
         }
         create_shortcuts( manifest, &rec, &shortcuts );
         create_aliases( manifest, &rec, &aliases );
+        register_com_servers( manifest, &rec, &classes );
     }
 #ifndef SG_MUTANT_AX_REGISTER
     rec.staged = FALSE;
 #endif
     if (FAILED(hr = write_record( &rec, &shortcuts, &aliases, &resources )))
         set_error( error_text, L"The package could not be registered", NULL );
-    else TRACE( "registered %s\n", debugstr_w( full_name ) );
+    else
+    {
+        record_com_classes( rec.full_name, &classes );
+        TRACE( "registered %s\n", debugstr_w( full_name ) );
+    }
 
 done:
     free( shortcuts.data );
     free( aliases.data );
+    free( classes.data );
     free( resources.data );
     if (manifest) IAppxManifestReader_Release( manifest );
     if (factory) IAppxFactory_Release( factory );
diff --git a/dlls/shell32/Makefile.in b/dlls/shell32/Makefile.in
index baac2f6..7398d69 100644
--- a/dlls/shell32/Makefile.in
+++ b/dlls/shell32/Makefile.in
@@ -3,7 +3,7 @@ MODULE    = shell32.dll
 IMPORTLIB = shell32
 IMPORTS   = $(ZLIB_PE_LIBS) uuid mfuuid shlwapi user32 gdi32 advapi32
 EXTRAINCL = $(ZLIB_PE_CFLAGS)
-DELAYIMPORTS = ole32 oleaut32 shdocvw version comctl32 comdlg32 gdiplus mfplat mfreadwrite propsys
+DELAYIMPORTS = ole32 oleaut32 shdocvw version comctl32 comdlg32 gdiplus mfplat mfreadwrite propsys xmllite
 
 SOURCES = \
 	appbar.c \
@@ -29,6 +29,7 @@ SOURCES = \
 	new_menu.c \
 	openwith.c \
 	pidl.c \
+	pkgverbs.c \
 	recyclebin.c \
 	resultsfolder.c \
 	resources/audio.svg \
diff --git a/dlls/shell32/pkgverbs.c b/dlls/shell32/pkgverbs.c
new file mode 100644
index 0000000..2c43c75
--- /dev/null
+++ b/dlls/shell32/pkgverbs.c
@@ -0,0 +1,413 @@
+/*
+ * Packaged File Explorer verbs (desktop4/desktop5/desktop10 FileExplorerContextMenus)
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * A package (MSIX, or one with external location such as TeraCopy's) adds
+ * commands to File Explorer's context menu with a fileExplorerContextMenus
+ * extension: for each item type ("*" every file, ".ext", "Directory"), a
+ * verb names a COM class that implements IExplorerCommand. The packages are
+ * appxdeploymentclient's records (HKCU\Software\Wine\AppModel\Packages, the
+ * manifest in each InstallLocation); their classes are registered for the
+ * user when the package is installed. Each command is shown as a context
+ * menu handler of its own: an IContextMenu over the IExplorerCommand, with its
+ * title, state (hidden, disabled, checked) and sub-commands.
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "shlobj.h"
+#include "shobjidl.h"
+#include "shlwapi.h"
+#include "xmllite.h"
+#include "shell32_main.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+/* xmllite's IIDs are not in libuuid */
+static const GUID iid_xml_reader = {0x7279fc81,0x709d,0x4095,{0xb6,0x3d,0x69,0xfe,0x4b,0x0d,0x90,0x30}};
+
+#define MAX_PACKAGE_VERBS 16
+#define MAX_SUB_COMMANDS  32
+
+struct package_verb
+{
+    CLSID clsid;
+    WCHAR id[64];
+};
+
+static BOOL type_wanted( const WCHAR *type, const WCHAR *const *types, UINT count )
+{
+    UINT i;
+    for (i = 0; i < count; i++) if (!wcsicmp( type, types[i] )) return TRUE;
+    return FALSE;
+}
+
+static void add_verb( struct package_verb *verbs, UINT *count, UINT max, const WCHAR *clsid, const WCHAR *id )
+{
+    WCHAR str[40];
+    CLSID guid;
+    UINT i;
+
+    if (!clsid) return;
+    if (clsid[0] == '{') lstrcpynW( str, clsid, ARRAY_SIZE(str) );
+    else swprintf( str, ARRAY_SIZE(str), L"{%s}", clsid );
+    if (wcslen( str ) != 38 || FAILED(CLSIDFromString( str, &guid ))) return;
+    for (i = 0; i < *count; i++) if (IsEqualCLSID( &verbs[i].clsid, &guid )) return;
+    if (*count >= max) return;
+    verbs[*count].clsid = guid;
+    lstrcpynW( verbs[*count].id, id ? id : L"", ARRAY_SIZE(verbs[*count].id) );
+    (*count)++;
+}
+
+/* The verbs one manifest gives the types. */
+static void manifest_verbs( const WCHAR *path, const WCHAR *const *types, UINT type_count,
+                            struct package_verb *verbs, UINT *count, UINT max )
+{
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType node;
+    UINT menus_depth = 0, type_depth = 0;
+    BOOL wanted = FALSE;
+
+    if (FAILED(SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream ))) return;
+    if (FAILED(CreateXmlReader( &iid_xml_reader, (void **)&reader, NULL ))) goto done;
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (FAILED(IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+
+    while (IXmlReader_Read( reader, &node ) == S_OK)
+    {
+        const WCHAR *name, *value;
+        WCHAR *clsid = NULL, *id = NULL;
+        UINT depth;
+
+        if (node != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        IXmlReader_GetDepth( reader, &depth );
+        if (menus_depth && depth <= menus_depth) menus_depth = 0;
+        if (type_depth && depth <= type_depth) type_depth = 0;
+        if (!wcscmp( name, L"FileExplorerContextMenus" ))
+        {
+            menus_depth = depth;
+            continue;
+        }
+        if (!menus_depth) continue;
+        if (!wcscmp( name, L"ItemType" ))
+        {
+            type_depth = depth;
+            wanted = IXmlReader_MoveToAttributeByName( reader, L"Type", NULL ) == S_OK &&
+                     SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL )) && type_wanted( value, types, type_count );
+            IXmlReader_MoveToElement( reader );
+            continue;
+        }
+        if (!type_depth || !wanted || wcscmp( name, L"Verb" )) continue;
+        if (IXmlReader_MoveToAttributeByName( reader, L"Clsid", NULL ) == S_OK &&
+            SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) clsid = wcsdup( value );
+        if (IXmlReader_MoveToAttributeByName( reader, L"Id", NULL ) == S_OK &&
+            SUCCEEDED(IXmlReader_GetValue( reader, &value, NULL ))) id = wcsdup( value );
+        IXmlReader_MoveToElement( reader );
+        add_verb( verbs, count, max, clsid, id );
+        free( clsid );
+        free( id );
+    }
+
+done:
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+}
+
+/* The verbs the user's packages give the types. */
+static UINT package_verbs( const WCHAR *const *types, UINT type_count, struct package_verb *verbs, UINT max )
+{
+    WCHAR name[256], location[MAX_PATH], path[MAX_PATH + 32];
+    DWORD len, index = 0, size, staged;
+    UINT count = 0;
+    HKEY key, sub;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, L"Software\\Wine\\AppModel\\Packages", 0, KEY_READ, &key )) return 0;
+    while (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, index++, name, &len, NULL, NULL, NULL, NULL ))
+    {
+        if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+        size = sizeof(staged);
+        if (RegGetValueW( sub, NULL, L"Staged", RRF_RT_REG_DWORD, NULL, &staged, &size )) staged = 0;
+        size = sizeof(location);
+        if (!staged && !RegGetValueW( sub, NULL, L"InstallLocation", RRF_RT_REG_SZ, NULL, location, &size ))
+        {
+            swprintf( path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", location );
+            manifest_verbs( path, types, type_count, verbs, &count, max );
+        }
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+    return count;
+}
+
+/* ---- an IContextMenu over an IExplorerCommand --------------------------------------------- */
+
+struct command_menu
+{
+    IContextMenu IContextMenu_iface;
+    LONG ref;
+    IShellItemArray *items;
+    WCHAR verb[64];
+    IExplorerCommand *top;
+    /* the commands by their offset: the command itself, or its sub-commands */
+    IExplorerCommand *commands[MAX_SUB_COMMANDS];
+    UINT count;
+};
+
+static inline struct command_menu *impl_from_IContextMenu( IContextMenu *iface )
+{
+    return CONTAINING_RECORD( iface, struct command_menu, IContextMenu_iface );
+}
+
+static void release_commands( struct command_menu *menu )
+{
+    UINT i;
+    for (i = 0; i < menu->count; i++) IExplorerCommand_Release( menu->commands[i] );
+    menu->count = 0;
+}
+
+static HRESULT WINAPI command_menu_QueryInterface( IContextMenu *iface, REFIID iid, void **out )
+{
+    struct command_menu *menu = impl_from_IContextMenu( iface );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IContextMenu ))
+    {
+        *out = &menu->IContextMenu_iface;
+        IContextMenu_AddRef( iface );
+        return S_OK;
+    }
+    if (IsEqualIID( iid, &IID_IExplorerCommand ))
+        return IExplorerCommand_QueryInterface( menu->top, iid, out );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI command_menu_AddRef( IContextMenu *iface )
+{
+    return InterlockedIncrement( &impl_from_IContextMenu( iface )->ref );
+}
+
+static ULONG WINAPI command_menu_Release( IContextMenu *iface )
+{
+    struct command_menu *menu = impl_from_IContextMenu( iface );
+    ULONG ref = InterlockedDecrement( &menu->ref );
+
+    if (!ref)
+    {
+        release_commands( menu );
+        IExplorerCommand_Release( menu->top );
+        IShellItemArray_Release( menu->items );
+        free( menu );
+    }
+    return ref;
+}
+
+/* A command's menu item: its title and state; FALSE when it is hidden or has no title. */
+static BOOL command_item( IExplorerCommand *command, IShellItemArray *items, MENUITEMINFOW *mii, WCHAR **title )
+{
+    EXPCMDSTATE state = ECS_ENABLED;
+
+    *title = NULL;
+    if (FAILED(IExplorerCommand_GetState( command, items, TRUE, &state ))) state = ECS_ENABLED;
+#ifndef SG_MUTANT_PKGVERB_HIDDEN
+    if (state & ECS_HIDDEN) return FALSE;
+#endif
+    if (FAILED(IExplorerCommand_GetTitle( command, items, title )) || !*title) return FALSE;
+    memset( mii, 0, sizeof(*mii) );
+    mii->cbSize = sizeof(*mii);
+    mii->fMask = MIIM_STRING | MIIM_ID | MIIM_STATE;
+    mii->dwTypeData = *title;
+    if (state & ECS_DISABLED) mii->fState |= MFS_DISABLED;
+    if (state & ECS_CHECKED) mii->fState |= MFS_CHECKED;
+    return TRUE;
+}
+
+static HRESULT WINAPI command_menu_QueryContextMenu( IContextMenu *iface, HMENU hmenu, UINT index, UINT first,
+                                                     UINT last, UINT flags )
+{
+    struct command_menu *menu = impl_from_IContextMenu( iface );
+    IExplorerCommand *command = menu->top;
+    EXPCMDFLAGS cmd_flags = ECF_DEFAULT;
+    MENUITEMINFOW mii;
+    WCHAR *title;
+
+    TRACE( "menu %p, hmenu %p, index %u, first %u, last %u, flags %#x\n", menu, hmenu, index, first, last, flags );
+
+    release_commands( menu );
+    if (flags & CMF_DEFAULTONLY) return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 0 );
+    if (!command_item( command, menu->items, &mii, &title ))
+    {
+        CoTaskMemFree( title );
+        return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 0 );
+    }
+    IExplorerCommand_GetFlags( command, &cmd_flags );
+    if (cmd_flags & ECF_HASSUBCOMMANDS)
+    {
+        IEnumExplorerCommand *list = NULL;
+        IExplorerCommand *sub;
+        HMENU popup = CreatePopupMenu();
+        UINT pos = 0;
+        ULONG got;
+
+        /* the sub-commands take the offsets; the command keeps none of its own */
+        if (SUCCEEDED(IExplorerCommand_EnumSubCommands( command, &list )) && list)
+        {
+            while (menu->count < MAX_SUB_COMMANDS && first + menu->count <= last &&
+                   IEnumExplorerCommand_Next( list, 1, &sub, &got ) == S_OK && got)
+            {
+                MENUITEMINFOW sub_mii;
+                WCHAR *sub_title;
+
+                if (command_item( sub, menu->items, &sub_mii, &sub_title ))
+                {
+                    sub_mii.wID = first + menu->count;
+                    InsertMenuItemW( popup, pos++, TRUE, &sub_mii );
+                    menu->commands[menu->count++] = sub;
+                }
+                else IExplorerCommand_Release( sub );
+                CoTaskMemFree( sub_title );
+            }
+            IEnumExplorerCommand_Release( list );
+        }
+        if (!menu->count)
+        {
+            DestroyMenu( popup );
+            CoTaskMemFree( title );
+            return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 0 );
+        }
+        mii.fMask |= MIIM_SUBMENU;
+        mii.hSubMenu = popup;
+        mii.wID = first;
+        InsertMenuItemW( hmenu, index, TRUE, &mii );
+        CoTaskMemFree( title );
+        return MAKE_HRESULT( SEVERITY_SUCCESS, 0, menu->count );
+    }
+    mii.wID = first;
+    InsertMenuItemW( hmenu, index, TRUE, &mii );
+    CoTaskMemFree( title );
+    IExplorerCommand_AddRef( command );
+    menu->commands[menu->count++] = command;
+    return MAKE_HRESULT( SEVERITY_SUCCESS, 0, 1 );
+}
+
+static HRESULT WINAPI command_menu_InvokeCommand( IContextMenu *iface, CMINVOKECOMMANDINFO *info )
+{
+    struct command_menu *menu = impl_from_IContextMenu( iface );
+    UINT offset;
+
+    if (!IS_INTRESOURCE( info->lpVerb ))
+    {
+        WCHAR verb[64];
+
+        /* the verb's name from the manifest */
+        MultiByteToWideChar( CP_ACP, 0, info->lpVerb, -1, verb, ARRAY_SIZE(verb) );
+        if (!menu->verb[0] || wcsicmp( verb, menu->verb )) return E_INVALIDARG;
+        TRACE( "menu %p, invoking %s\n", menu, debugstr_w( verb ) );
+        return IExplorerCommand_Invoke( menu->top, menu->items, NULL );
+    }
+    offset = LOWORD( info->lpVerb );
+    if (offset >= menu->count) return E_INVALIDARG;
+    TRACE( "menu %p, invoking command %u\n", menu, offset );
+    return IExplorerCommand_Invoke( menu->commands[offset], menu->items, NULL );
+}
+
+static HRESULT WINAPI command_menu_GetCommandString( IContextMenu *iface, UINT_PTR id, UINT flags, UINT *reserved,
+                                                     LPSTR name, UINT max )
+{
+    struct command_menu *menu = impl_from_IContextMenu( iface );
+    WCHAR *tip = NULL;
+    HRESULT hr;
+
+    if (id >= menu->count || !max) return E_INVALIDARG;
+    switch (flags)
+    {
+    case GCS_VERBW:
+        if (id || !menu->verb[0]) return E_NOTIMPL;
+        lstrcpynW( (WCHAR *)name, menu->verb, max );
+        return S_OK;
+    case GCS_VERBA:
+        if (id || !menu->verb[0]) return E_NOTIMPL;
+        WideCharToMultiByte( CP_ACP, 0, menu->verb, -1, name, max, NULL, NULL );
+        return S_OK;
+    case GCS_HELPTEXTW:
+    case GCS_HELPTEXTA:
+        if (FAILED(hr = IExplorerCommand_GetToolTip( menu->commands[id], menu->items, &tip )) || !tip) return E_NOTIMPL;
+        if (flags == GCS_HELPTEXTW) lstrcpynW( (WCHAR *)name, tip, max );
+        else WideCharToMultiByte( CP_ACP, 0, tip, -1, name, max, NULL, NULL );
+        CoTaskMemFree( tip );
+        return S_OK;
+    }
+    return E_NOTIMPL;
+}
+
+static const IContextMenuVtbl command_menu_vtbl =
+{
+    command_menu_QueryInterface,
+    command_menu_AddRef,
+    command_menu_Release,
+    command_menu_QueryContextMenu,
+    command_menu_InvokeCommand,
+    command_menu_GetCommandString,
+};
+
+/* Context menus for the packages' commands for these item types: the number made. */
+UINT package_verb_menus( const WCHAR *const *types, UINT type_count, IShellItemArray *items, IContextMenu **menus, UINT max )
+{
+    struct package_verb verbs[MAX_PACKAGE_VERBS];
+    UINT count, i, made = 0;
+
+#ifdef SG_MUTANT_PKGVERB_NONE
+    return 0;
+#endif
+    count = package_verbs( types, type_count, verbs, min( max, MAX_PACKAGE_VERBS ) );
+    for (i = 0; i < count; i++)
+    {
+        struct command_menu *menu;
+        IExplorerCommand *command;
+        HRESULT hr;
+
+        hr = CoCreateInstance( &verbs[i].clsid, NULL, CLSCTX_INPROC_SERVER | CLSCTX_LOCAL_SERVER,
+                               &IID_IExplorerCommand, (void **)&command );
+        if (FAILED(hr))
+        {
+            WARN( "command %s (%s) did not load: %#lx\n", debugstr_guid( &verbs[i].clsid ), debugstr_w( verbs[i].id ), hr );
+            continue;
+        }
+        if (!(menu = calloc( 1, sizeof(*menu) )))
+        {
+            IExplorerCommand_Release( command );
+            break;
+        }
+        menu->IContextMenu_iface.lpVtbl = &command_menu_vtbl;
+        menu->ref = 1;
+        menu->items = items;
+        IShellItemArray_AddRef( items );
+        lstrcpynW( menu->verb, verbs[i].id, ARRAY_SIZE(menu->verb) );
+        menu->top = command;
+        menus[made++] = &menu->IContextMenu_iface;
+        TRACE( "command %s (%s)\n", debugstr_guid( &verbs[i].clsid ), debugstr_w( verbs[i].id ) );
+    }
+    return made;
+}
