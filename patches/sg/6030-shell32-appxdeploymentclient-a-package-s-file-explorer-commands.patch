+/* Stained Glass OS: the packages' commands for the items (fileExplorerContextMenus, pkgverbs.c), each a
+ * handler of its own */
+static void ext_add_package_verbs(ContextMenu *This, BOOL folders, HMENU hmenu, UINT *pos, UINT idCmdFirst,
+                                  UINT idCmdLast, UINT flags, UINT *next)
+{
+    IContextMenu *menus[MAX_EXT];
+    IShellItemArray *items;
+    const WCHAR *types[2];
+    WCHAR ext[MAX_PATH] = L"", path[MAX_PATH];
+    UINT count, ntypes = 0, i;
+    HRESULT hr;
+
+    if (FAILED(SHCreateShellItemArray(This->pidl, This->parent, This->cidl, (LPCITEMIDLIST *)This->apidl, &items)))
+        return;
+    if (folders) types[ntypes++] = L"Directory";
+    else
+    {
+        /* every file; the extension when the items share one */
+        types[ntypes++] = L"*";
+        for (i = 0; i < This->cidl; i++)
+        {
+            ITEMIDLIST *full = ILCombine(This->pidl, This->apidl[i]);
+            const WCHAR *dot = NULL;
+            if (full && SHGetPathFromIDListW(full, path)) dot = PathFindExtensionW(path);
+            ILFree(full);
+            if (!dot || !*dot || (i && wcsicmp(dot, ext))) { ext[0] = 0; break; }
+            lstrcpynW(ext, dot, ARRAY_SIZE(ext));
+        }
+        if (ext[0]) types[ntypes++] = ext;
+    }
+    count = package_verb_menus(types, ntypes, items, menus, MAX_EXT - This->ext_count);
+    IShellItemArray_Release(items);
+    for (i = 0; i < count; i++)
+    {
+        UINT before = GetMenuItemCount(hmenu);
+
+        hr = IContextMenu_QueryContextMenu(menus[i], hmenu, *pos, idCmdFirst + *next, idCmdLast, flags);
+        if (FAILED(hr) || !HRESULT_CODE(hr) || This->ext_count >= MAX_EXT)
+        {
+            IContextMenu_Release(menus[i]);
+            continue;
+        }
+        This->ext[This->ext_count].cm = menus[i];
+        This->ext[This->ext_count].first = *next;
+        This->ext[This->ext_count].count = HRESULT_CODE(hr);
+        This->ext_count++;
+        *next += HRESULT_CODE(hr);
+        *pos += GetMenuItemCount(hmenu) - before;
+    }
+}
+
 static void ext_add_handlers(ContextMenu *This, HMENU hmenu, UINT *pos, UINT idCmdFirst, UINT idCmdLast,
                              UINT flags, INT *uIDMax)
 {
@@ -376,6 +427,7 @@ static void ext_add_handlers(ContextMenu *This, HMENU hmenu, UINT *pos, UINT idC
         ext_add_from(This, L"*", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
     }
     ext_add_from(This, L"AllFilesystemObjects", hmenu, pos, idCmdFirst, idCmdLast, flags, data, &next);
+    ext_add_package_verbs(This, folders == This->cidl, hmenu, pos, idCmdFirst, idCmdLast, flags, &next);
     IDataObject_Release(data);
     if (next > EXT_ID_OFFSET) *uIDMax = max(*uIDMax, (INT)(idCmdFirst + next));
 }
