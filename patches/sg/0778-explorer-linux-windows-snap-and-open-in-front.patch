From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Linux windows snap, and open in front

David 2026-10-03: "Linux apps like the terminal can start behind other apps
and not in focus as well as don't do the snapping like if you drag the
window to the edge it doesn't snap to half the screen".

- Snapping (drag to an edge, Win+Left/Right/Up) took only other programs'
  windows (is_app() refused explorer's own, and the move/size WinEvent hook
  skipped explorer's process). A Linux program's frame (SgLinuxWindow,
  0762) is explorer's: it is let through now, and the hook hears explorer's
  own windows, is_app() still refusing every other one of ours.
- A new frame was shown and made the foreground window, but under the
  session's Xwayland X's stacking does not follow Wine's by itself (as
  0765 found for a frame chosen or clicked): it is now put on top too.

Test: test/linuxembed-gate.sh 5c (dragged to the left edge: the left half;
Win+Right: the right half; mutant SG_MUTANT_FRAME_NO_SNAP fails both). The
raise needs the session's Xwayland to show (Xvfb keeps the order itself):
QA VM (mutant SG_MUTANT_FRAME_NOT_RAISED).
---
--- a/programs/explorer/shellkeys.c
+++ b/programs/explorer/shellkeys.c
@@ -59,12 +59,26 @@
 
 /* ---- which windows ----------------------------------------------------- */
 
+/* a Linux program's window in its frame (systray.c's SgLinuxWindow): ours,
+ * but a program's window to snap, as the user sees it (David 2026-10-03) */
+static BOOL is_linux_frame( HWND hwnd )
+{
+    WCHAR class[32];
+#ifdef SG_MUTANT_FRAME_NO_SNAP
+    return FALSE;
+#endif
+    /* with its title bar, or without one for a program that draws its own
+     * (0803: WS_POPUP | WS_THICKFRAME); the hidden stand-ins are not visible */
+    return GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) && !wcscmp( class, L"SgLinuxWindow" );
+}
+
 static BOOL is_app( HWND hwnd )
 {
     DWORD pid;
     LONG ex = GetWindowLongW( hwnd, GWL_EXSTYLE );
     if (!IsWindowVisible( hwnd ) || GetWindow( hwnd, GW_OWNER )) return FALSE;
-    if (!GetWindowThreadProcessId( hwnd, &pid ) || pid == GetCurrentProcessId()) return FALSE;
+    if (!GetWindowThreadProcessId( hwnd, &pid )) return FALSE;
+    if (pid == GetCurrentProcessId() && !is_linux_frame( hwnd )) return FALSE;
     if ((ex & WS_EX_TOOLWINDOW) && !(ex & WS_EX_APPWINDOW)) return FALSE;
     return vd_on_current( hwnd );
 }
@@ -630,6 +644,8 @@
         wc.lpszClassName = L"SgSnapPreview";
         RegisterClassW( &wc );
     }
+    /* not WINEVENT_SKIPOWNPROCESS: the Linux programs' frames are ours, and
+     * snap (is_app() lets only those of ours through) */
     SetWinEventHook( EVENT_SYSTEM_MOVESIZESTART, EVENT_SYSTEM_MOVESIZEEND, NULL, move_size_event, 0, 0,
-                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+                     WINEVENT_OUTOFCONTEXT );
 }
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1888,6 +1888,12 @@
         return NULL;
     }
     SetForegroundWindow( frame );
+    /* and on top: under the session's Xwayland, X's stacking does not follow
+     * Wine's by itself (0765), and a new Linux window opened behind the
+     * window in front, without the focus (David 2026-10-03) */
+#ifndef SG_MUTANT_FRAME_NOT_RAISED
+    SetWindowPos( frame, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE );
+#endif
     return frame;
 }
 
