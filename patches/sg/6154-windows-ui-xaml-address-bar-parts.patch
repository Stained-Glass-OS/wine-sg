+/*
+ * A flyout is made and given to elements as their context or selection flyout (NanaZip makes a
+ * TextCommandBarFlyout for its address bar when its template is applied): its placement and
+ * commands are kept and its events accepted; showing it comes with the popups.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const GUID IID_IVector_Object_fly = { 0xb32bdca4, 0x5e52, 0x5b27, { 0xbc, 0x5d, 0xd6, 0x6a, 0x1a, 0x26, 0x8c, 0x2a } };
+static const GUID IID_IVectorView_Object_fly = { 0xa6487363, 0xb074, 0x5c60, { 0xab, 0x16, 0x86, 0x6d, 0xce, 0x4e, 0xe5, 0x4d } };
+static const GUID IID_IIterable_Object_fly = { 0x092b849b, 0x60b1, 0x52be, { 0xa4, 0x4a, 0x6f, 0xe8, 0xe9, 0x33, 0xcb, 0xe4 } };
+static const GUID IID_IIterator_Object_fly = { 0x44a94f2d, 0x04f8, 0x5091, { 0xb3, 0x36, 0xbe, 0x78, 0x92, 0xdd, 0x10, 0xbe } };
+
+/* the commands, kept as objects (IVector<ICommandBarElement> is asked for by its own IID: also given) */
+static const struct xvector_type commands_type =
+{
+    L"Windows.Foundation.Collections.IObservableVector`1", &IID_IVector_Object_fly, &IID_IVectorView_Object_fly,
+    &IID_IIterable_Object_fly, &IID_IIterator_Object_fly, &IID_IInspectable, NULL, NULL, NULL, NULL,
+};
+
+struct flyout
+{
+    struct dobj d;
+    struct xiface IFlyoutBase_iface, IFlyoutBase2_iface, ICommandBarFlyout_iface, ITextCommandBarFlyout_iface;
+    INT32 placement;
+    struct xvector *primary, *secondary;
+    struct handler_list opened, closed, opening;
+};
+
+static struct flyout *flyout_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct flyout, d.obj );
+}
+
+static HRESULT WINAPI flyout_get_Placement( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = flyout_from_iface( iface )->placement;
+    return S_OK;
+}
+
+static HRESULT WINAPI flyout_put_Placement( struct xiface *iface, INT32 value )
+{
+    flyout_from_iface( iface )->placement = value;
+    return S_OK;
+}
+
+#define FLYOUT_EVENT(name, field) \
+static HRESULT WINAPI flyout_add_##name( struct xiface *iface, IUnknown *handler, INT64 *token ) \
+{ return handlers_add( &flyout_from_iface( iface )->field, handler, token ); } \
+static HRESULT WINAPI flyout_remove_##name( struct xiface *iface, INT64 token ) \
+{ return handlers_remove( &flyout_from_iface( iface )->field, token ); }
+
+FLYOUT_EVENT(Opened, opened)
+FLYOUT_EVENT(Closed, closed)
+FLYOUT_EVENT(Opening, opening)
+
+static HRESULT WINAPI flyout_ShowAt( struct xiface *iface, IInspectable *target )
+{
+    FIXME( "%p, %p: flyouts are not shown yet\n", iface, target );
+    return S_OK;
+}
+
+static HRESULT WINAPI flyout_Hide( struct xiface *iface )
+{
+    return S_OK;
+}
+
+static const void *flyout_base_vtbl[] =
+{
+    IFlyoutBase_STUBS,
+    [IFlyoutBase_Placement] = flyout_get_Placement, [IFlyoutBase_SetPlacement] = flyout_put_Placement,
+    [IFlyoutBase_Opened] = flyout_add_Opened, [IFlyoutBase_RemoveOpened] = flyout_remove_Opened,
+    [IFlyoutBase_Closed] = flyout_add_Closed, [IFlyoutBase_RemoveClosed] = flyout_remove_Closed,
+    [IFlyoutBase_Opening] = flyout_add_Opening, [IFlyoutBase_RemoveOpening] = flyout_remove_Opening,
+    [IFlyoutBase_ShowAt] = flyout_ShowAt, [IFlyoutBase_Hide] = flyout_Hide,
+};
+
+static const void *flyout_base2_vtbl[] = { IFlyoutBase2_STUBS };
+
+static HRESULT WINAPI flyout_get_PrimaryCommands( struct xiface *iface, IInspectable **value )
+{
+    struct flyout *flyout = flyout_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if (!flyout->primary && FAILED(xvector_create( &commands_type, flyout, &flyout->primary ))) return E_OUTOFMEMORY;
+    IInspectable_AddRef( (*value = xvector_iface( flyout->primary )) );
+    return S_OK;
+}
+
+static HRESULT WINAPI flyout_get_SecondaryCommands( struct xiface *iface, IInspectable **value )
+{
+    struct flyout *flyout = flyout_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if (!flyout->secondary && FAILED(xvector_create( &commands_type, flyout, &flyout->secondary ))) return E_OUTOFMEMORY;
+    IInspectable_AddRef( (*value = xvector_iface( flyout->secondary )) );
+    return S_OK;
+}
+
+static const void *command_bar_flyout_vtbl[] =
+{
+    ICommandBarFlyout_STUBS,
+    [ICommandBarFlyout_PrimaryCommands] = flyout_get_PrimaryCommands,
+    [ICommandBarFlyout_SecondaryCommands] = flyout_get_SecondaryCommands,
+};
+
+static const void *text_command_bar_flyout_vtbl[] = { ITextCommandBarFlyout_STUBS };
+
+static const struct xiface_entry text_flyout_ifaces[] =
+{
+    { &IID_ITextCommandBarFlyout, offsetof(struct flyout, ITextCommandBarFlyout_iface) },
+    { &IID_ICommandBarFlyout, offsetof(struct flyout, ICommandBarFlyout_iface) },
+    { &IID_IFlyoutBase, offsetof(struct flyout, IFlyoutBase_iface) },
+    { &IID_IFlyoutBase2, offsetof(struct flyout, IFlyoutBase2_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static const struct xiface_entry flyout_ifaces[] =
+{
+    { &IID_ICommandBarFlyout, offsetof(struct flyout, ICommandBarFlyout_iface) },
+    { &IID_IFlyoutBase, offsetof(struct flyout, IFlyoutBase_iface) },
+    { &IID_IFlyoutBase2, offsetof(struct flyout, IFlyoutBase2_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void flyout_destroy( struct xobj *obj )
+{
+    struct flyout *flyout = CONTAINING_RECORD( obj, struct flyout, d.obj );
+
+    if (flyout->primary) xvector_detach( flyout->primary );
+    if (flyout->secondary) xvector_detach( flyout->secondary );
+    handlers_clear( &flyout->opened );
+    handlers_clear( &flyout->closed );
+    handlers_clear( &flyout->opening );
+    dobj_cleanup( &flyout->d );
+}
+
+static const struct xclass text_flyout_class =
+{
+    L"Windows.UI.Xaml.Controls.TextCommandBarFlyout", text_flyout_ifaces, ARRAY_SIZE(text_flyout_ifaces), flyout_destroy,
+};
+
+static const struct xclass flyout_class =
+{
+    L"Windows.UI.Xaml.Controls.CommandBarFlyout", flyout_ifaces, ARRAY_SIZE(flyout_ifaces), flyout_destroy,
+};
+
+static struct flyout *new_flyout( BOOL text, IInspectable *outer )
+{
+    struct flyout *flyout;
+
+    if (!(flyout = calloc( 1, sizeof(*flyout) ))) return NULL;
+    flyout->IFlyoutBase_iface.vtbl = flyout_base_vtbl;
+    flyout->IFlyoutBase2_iface.vtbl = flyout_base2_vtbl;
+    flyout->ICommandBarFlyout_iface.vtbl = command_bar_flyout_vtbl;
+    flyout->ITextCommandBarFlyout_iface.vtbl = text_command_bar_flyout_vtbl;
+    flyout->placement = 0;   /* Top */
+    handlers_init( &flyout->opened );
+    handlers_init( &flyout->closed );
+    handlers_init( &flyout->opening );
+    dobj_init( &flyout->d, text ? &text_flyout_class : &flyout_class, outer );
+    return flyout;
+}
+
+#define FLYOUT_CREATE(name, text, field) \
+static HRESULT WINAPI name( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value ) \
+{ \
+    struct flyout *flyout; \
+    if (!value) return E_POINTER; \
+    if (outer && !inner) return E_INVALIDARG; \
+    if (!(flyout = new_flyout( text, outer ))) return E_OUTOFMEMORY; \
+    if (outer) \
+    { \
+        *inner = &flyout->d.obj.IInspectable_inner; \
+        IUnknown_AddRef( flyout->d.obj.outer ); \
+    } \
+    *value = &flyout->field; \
+    return S_OK; \
+}
+
+FLYOUT_CREATE(text_flyout_CreateInstance, TRUE, ITextCommandBarFlyout_iface)
+FLYOUT_CREATE(flyout_CreateInstance, FALSE, ICommandBarFlyout_iface)
+
+static const void *text_flyout_factory_vtbl[] =
+{
+    ITextCommandBarFlyoutFactory_FSTUBS, [ITextCommandBarFlyoutFactory_CreateInstance] = text_flyout_CreateInstance,
+};
+
+static const void *flyout_factory_vtbl[] =
+{
+    ICommandBarFlyoutFactory_FSTUBS, [ICommandBarFlyoutFactory_CreateInstance] = flyout_CreateInstance,
+};
+
+static struct xfactory text_flyout_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Controls.TextCommandBarFlyout",
+                                                   { &IID_ITextCommandBarFlyoutFactory }, { { text_flyout_factory_vtbl } } };
+static struct xfactory flyout_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Controls.CommandBarFlyout",
+                                              { &IID_ICommandBarFlyoutFactory }, { { flyout_factory_vtbl } } };
+
+IActivationFactory *text_command_bar_flyout_factory = &text_flyout_factory_obj.IActivationFactory_iface;
+IActivationFactory *command_bar_flyout_factory = &flyout_factory_obj.IActivationFactory_iface;
diff --git a/dlls/windows.ui.xaml/focus.c b/dlls/windows.ui.xaml/focus.c
index 5f995e6..345fee4 100644
--- a/dlls/windows.ui.xaml/focus.c
+++ b/dlls/windows.ui.xaml/focus.c
@@ -176,6 +176,31 @@ static void raise_up( struct uielem *from, enum xaml_routed which, IInspectable
     for (i = 0; i < count; i++) IUnknown_Release( chain[i]->d.obj.outer );
 }
 
+/* a tunnelling event (Preview*): from the root down to the element, while not handled */
+static void raise_down( struct uielem *to, enum xaml_routed which, IInspectable *args, boolean *handled )
+{
+    struct uielem *elem, *chain[256];
+    unsigned int count = 0;
+
+    for (elem = to; elem && count < ARRAY_SIZE(chain); elem = elem->parent)
+    {
+        IUnknown_AddRef( elem->d.obj.outer );
+        chain[count++] = elem;
+    }
+    while (count--)
+    {
+        struct handler_list *list = xaml_routed_list( chain[count], which );
+        IInspectable *sender;
+
+        if (!*handled && list && !list_empty( &list->entries ) && (sender = sender_of( chain[count] )))
+        {
+            xaml_raise_routed( list, sender, args );
+            IInspectable_Release( sender );
+        }
+        IUnknown_Release( chain[count]->d.obj.outer );
+    }
+}
+
 static void raise_focus_event( struct uielem *elem, enum xaml_routed which )
 {
     IInspectable *source = sender_of( elem ), *args;
@@ -255,6 +280,11 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
         args = new_key_args( source, wparam, lparam, up );
         IInspectable_Release( source );
         if (!args) return FALSE;
+        /* PreviewKeyDown/Up from the root down, then KeyDown/Up up from the element */
+#ifndef SG_MUTANT_XAML_NO_PREVIEW
+        raise_down( target, up ? XROUTED_PREVIEW_KEY_UP : XROUTED_PREVIEW_KEY_DOWN,
+                    (IInspectable *)&args->IKeyRoutedEventArgs_iface, &args->handled );
+#endif
         raise_up( target, up ? XROUTED_KEY_UP : XROUTED_KEY_DOWN, (IInspectable *)&args->IKeyRoutedEventArgs_iface, &args->handled );
         if (!args->handled && !up && target == focus && xaml_is_text_box( target ))
             args->handled = xaml_text_box_key( target, wparam );
