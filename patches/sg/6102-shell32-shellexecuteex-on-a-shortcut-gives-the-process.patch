From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: ShellExecuteEx on a shortcut gives the process it started

A .lnk is run through its IContextMenu, which had no way to hand back the target's process: with SEE_MASK_NOCLOSEPROCESS the caller got no hProcess. start /wait on a Start menu shortcut (TeXstudio) waited on nothing and ended at once with an undefined exit code (3) while the program ran on. The shortcut's InvokeCommand now leaves the process for the ShellExecuteEx that asked for it, and SHELL_execute passes it on.
---
diff --git a/dlls/shell32/shell32_main.h b/dlls/shell32/shell32_main.h
index a9adbda..5ca7cdb 100644
--- a/dlls/shell32/shell32_main.h
+++ b/dlls/shell32/shell32_main.h
@@ -345,6 +345,12 @@ BOOL add_drive_properties_page(const WCHAR *root, LPFNADDPROPSHEETPAGE add, LPAR
 /* SHCreateFileExtractIconW (shell32_main.c) */
 HRESULT WINAPI SHCreateFileExtractIconW(LPCWSTR file, DWORD attribs, REFIID riid, void **ppv);
 
+/* Stained Glass OS (6102): the process a shortcut started, handed to ShellExecuteEx (shelllink.c) */
+void shelllink_want_process(BOOL want);
+HANDLE shelllink_take_process(void);
+BOOL shelllink_process_wanted(void);
+void shelllink_put_process(HANDLE process);
+
 /* Stained Glass OS: context menus for the packages' File Explorer commands for these item types (pkgverbs.c) */
 UINT package_verb_menus( const WCHAR *const *types, UINT type_count, IShellItemArray *items, IContextMenu **menus,
                          UINT max );
diff --git a/dlls/shell32/shelllink.c b/dlls/shell32/shelllink.c
index 22272c3..878319b 100644
--- a/dlls/shell32/shelllink.c
+++ b/dlls/shell32/shelllink.c
@@ -2946,6 +2946,7 @@ ShellLink_InvokeCommand( IContextMenu* iface, LPCMINVOKECOMMANDINFO lpici )
     LPWSTR args = NULL;
     LPWSTR path = NULL;
     const WCHAR *verb = L"Open";
+    BOOL wanted = FALSE;
     HRESULT r;
 
     TRACE("%p %p\n", This, lpici );
@@ -3026,11 +3027,22 @@ ShellLink_InvokeCommand( IContextMenu* iface, LPCMINVOKECOMMANDINFO lpici )
     sei.lpDirectory = This->sWorkDir;
     sei.lpParameters = args;
     sei.lpVerb = verb;
+#ifndef SG_MUTANT_LINK_NO_PROCESS
+    wanted = shelllink_process_wanted();
+    if (wanted) sei.fMask |= SEE_MASK_NOCLOSEPROCESS;
+    /* the target's own ShellExecuteEx must not take what is asked of the shortcut */
+    shelllink_want_process( FALSE );
+#endif
 
     if( ShellExecuteExW( &sei ) )
         r = S_OK;
     else
         r = E_FAIL;
+    if (wanted)
+    {
+        if (r == S_OK && sei.hProcess) shelllink_put_process( sei.hProcess );
+        else shelllink_want_process( TRUE );
+    }
 
     free( args );
     free( path );
@@ -3038,6 +3050,58 @@ ShellLink_InvokeCommand( IContextMenu* iface, LPCMINVOKECOMMANDINFO lpici )
     return r;
 }
 
+/* Stained Glass OS (wine-sg 6102): ShellExecuteEx on a shortcut runs it through the shortcut's
+ * IContextMenu, whose InvokeCommand has no way to hand back the process it started: with
+ * SEE_MASK_NOCLOSEPROCESS the caller got no hProcess. `start /wait app.lnk` (and every launcher that
+ * waits on a Start menu shortcut) then waited on NULL and ended at once with an undefined exit code
+ * (3 for TeXstudio's), while the program ran on. Windows gives the target's process. The thread
+ * that runs ShellExecuteEx asks for it here; InvokeCommand leaves it here. */
+static DWORD link_process_tls = TLS_OUT_OF_INDEXES;
+static INIT_ONCE link_process_once = INIT_ONCE_STATIC_INIT;
+#define LINK_PROCESS_WANTED ((HANDLE)~(ULONG_PTR)0)
+
+static BOOL WINAPI link_process_init( INIT_ONCE *once, void *param, void **context )
+{
+    link_process_tls = TlsAlloc();
+    return TRUE;
+}
+
+static HANDLE link_process_get(void)
+{
+    InitOnceExecuteOnce( &link_process_once, link_process_init, NULL, NULL );
+    return link_process_tls == TLS_OUT_OF_INDEXES ? NULL : TlsGetValue( link_process_tls );
+}
+
+static void link_process_set( HANDLE value )
+{
+    InitOnceExecuteOnce( &link_process_once, link_process_init, NULL, NULL );
+    if (link_process_tls != TLS_OUT_OF_INDEXES) TlsSetValue( link_process_tls, value );
+}
+
+void shelllink_want_process( BOOL want )
+{
+    HANDLE old = link_process_get();
+    if (old && old != LINK_PROCESS_WANTED) CloseHandle( old );
+    link_process_set( want ? LINK_PROCESS_WANTED : NULL );
+}
+
+BOOL shelllink_process_wanted(void)
+{
+    return link_process_get() == LINK_PROCESS_WANTED;
+}
+
+void shelllink_put_process( HANDLE process )
+{
+    link_process_set( process );
+}
+
+HANDLE shelllink_take_process(void)
+{
+    HANDLE process = link_process_get();
+    link_process_set( NULL );
+    return process == LINK_PROCESS_WANTED ? NULL : process;
+}
+
 static HRESULT WINAPI
 ShellLink_GetCommandString( IContextMenu* iface, UINT_PTR idCmd, UINT uType,
                             UINT* pwReserved, LPSTR pszName, UINT cchMax )
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index 5c5e3b6..f320fb3 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -1750,7 +1750,13 @@ static HRESULT shellex_run_context_menu_default( IShellExtInit *obj,
     ici.hwnd = sei->hwnd;
     ici.lpParametersW = sei->lpParameters;
     
+    shelllink_want_process( (sei->fMask & SEE_MASK_NOCLOSEPROCESS) != 0 );
     r = IContextMenu_InvokeCommand( cm, (LPCMINVOKECOMMANDINFO) &ici );
+    {
+        HANDLE process = shelllink_take_process();
+        if (process && SUCCEEDED(r) && (sei->fMask & SEE_MASK_NOCLOSEPROCESS)) sei->hProcess = process;
+        else if (process) CloseHandle( process );
+    }
 
     TRACE("invoke command returned %08lx\n", r );
 
@@ -2252,6 +2258,7 @@ static BOOL SHELL_execute( LPSHELLEXECUTEINFOW sei, SHELL_ExecuteW32 execfunc )
                 debugstr_w(sei_tmp.lpClass) : "not used");
 
     sei->hProcess = NULL;
+    sei_tmp.hProcess = NULL;
 
     /* make copies of all path/command strings */
     if (!sei_tmp.lpFile)
@@ -2378,6 +2385,9 @@ static BOOL SHELL_execute( LPSHELLEXECUTEINFOW sei, SHELL_ExecuteW32 execfunc )
     if ( ERROR_SUCCESS == ShellExecute_FromContextMenu( &sei_tmp ) )
     {
         sei->hInstApp = (HINSTANCE) 33;
+        /* Stained Glass OS (6102): the process a shortcut started */
+        if (sei->fMask & SEE_MASK_NOCLOSEPROCESS) sei->hProcess = sei_tmp.hProcess;
+        else if (sei_tmp.hProcess) CloseHandle( sei_tmp.hProcess );
         free(wszApplicationName);
         if (wszParameters != parametersBuffer)
             free(wszParameters);
