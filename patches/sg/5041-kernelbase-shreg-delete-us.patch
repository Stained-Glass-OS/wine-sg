From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Implement SHRegDeleteUSValue and SHRegDeleteEmptyUSKey.

SHRegDeleteUSValue and SHRegDeleteEmptyUSKey (A and W) delete as their
SHREGDEL_FLAGS say: SHREGDEL_DEFAULT from HKCU, or from HKLM when the item
is not found in HKCU; SHREGDEL_HKCU / SHREGDEL_HKLM from that hive;
SHREGDEL_BOTH from both. An "empty" key is one without subkeys, as for
SHDeleteEmptyKey (ERROR_KEY_HAS_CHILDREN otherwise). All four returned
ERROR_SUCCESS and deleted nothing.

Gate: test/kernelbase-shregdel-gate.sh (64/32).
---
 dlls/kernelbase/registry.c | 92 ++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 84 insertions(+), 8 deletions(-)

diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
index 0d43fdd..221885a 100644
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -4540,28 +4540,104 @@ LONG WINAPI SHRegCloseUSKey(HUSKEY hUSKey)
     return ret;
 }
 
-LONG WINAPI SHRegDeleteEmptyUSKeyA(HUSKEY hUSKey, const char *value, SHREGDEL_FLAGS flags)
+static WCHAR *reg_strdup_AtoW(const char *str)
+{
+    WCHAR *ret;
+    INT len;
+
+    if (!str) return NULL;
+    len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+    if ((ret = heap_alloc(len * sizeof(WCHAR)))) MultiByteToWideChar(CP_ACP, 0, str, -1, ret, len);
+    return ret;
+}
+
+/* a key without subkeys, as SHDeleteEmptyKey takes it */
+static LONG reg_delete_empty_key(HKEY hkey, const WCHAR *subkey)
 {
-    FIXME("%p, %s, %#x\n", hUSKey, debugstr_a(value), flags);
+    DWORD count = 0;
+    HKEY key;
+    LONG ret;
+
+    if ((ret = RegOpenKeyExW(hkey, subkey, 0, KEY_READ, &key))) return ret;
+    ret = RegQueryInfoKeyW(key, NULL, NULL, NULL, &count, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+    RegCloseKey(key);
+    if (ret) return ret;
+    return count ? ERROR_KEY_HAS_CHILDREN : RegDeleteKeyExW(hkey, subkey, 0, 0);
+}
+
+/* SHREGDEL_DEFAULT: from HKCU, else (not found there) from HKLM; SHREGDEL_HKCU,
+ * SHREGDEL_HKLM: from that one; SHREGDEL_BOTH: from both */
+static LONG reg_delete_us(HUSKEY hUSKey, const WCHAR *name, SHREGDEL_FLAGS flags, BOOL is_key)
+{
+    HKEY hkcu, hklm;
+    LONG ret = ERROR_FILE_NOT_FOUND, ret2;
+
+    if (!hUSKey) return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_SHREGDEL_FAKE
     return ERROR_SUCCESS;
+#endif
+    hkcu = reg_get_hkey_from_huskey(hUSKey, TRUE);
+    hklm = reg_get_hkey_from_huskey(hUSKey, FALSE);
+
+    switch (flags)
+    {
+    case SHREGDEL_DEFAULT:
+        if (hkcu) ret = is_key ? reg_delete_empty_key(hkcu, name) : RegDeleteValueW(hkcu, name);
+        if (ret == ERROR_FILE_NOT_FOUND && hklm)
+            ret = is_key ? reg_delete_empty_key(hklm, name) : RegDeleteValueW(hklm, name);
+        return ret;
+    case SHREGDEL_HKCU:
+        if (!hkcu) return ERROR_FILE_NOT_FOUND;
+        return is_key ? reg_delete_empty_key(hkcu, name) : RegDeleteValueW(hkcu, name);
+    case SHREGDEL_HKLM:
+        if (!hklm) return ERROR_FILE_NOT_FOUND;
+        return is_key ? reg_delete_empty_key(hklm, name) : RegDeleteValueW(hklm, name);
+    case SHREGDEL_BOTH:
+        if (hkcu) ret = is_key ? reg_delete_empty_key(hkcu, name) : RegDeleteValueW(hkcu, name);
+        ret2 = ERROR_FILE_NOT_FOUND;
+        if (hklm) ret2 = is_key ? reg_delete_empty_key(hklm, name) : RegDeleteValueW(hklm, name);
+        return ret == ERROR_SUCCESS || ret2 == ERROR_SUCCESS ? ERROR_SUCCESS : ret;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
+}
+
+LONG WINAPI SHRegDeleteEmptyUSKeyA(HUSKEY hUSKey, const char *value, SHREGDEL_FLAGS flags)
+{
+    WCHAR *valueW = NULL;
+    LONG ret;
+
+    TRACE("%p, %s, %#x\n", hUSKey, debugstr_a(value), flags);
+
+    if (value && !(valueW = reg_strdup_AtoW(value))) return ERROR_NOT_ENOUGH_MEMORY;
+    ret = SHRegDeleteEmptyUSKeyW(hUSKey, valueW, flags);
+    heap_free(valueW);
+    return ret;
 }
 
 LONG WINAPI SHRegDeleteEmptyUSKeyW(HUSKEY hUSKey, const WCHAR *value, SHREGDEL_FLAGS flags)
 {
-    FIXME("%p, %s, %#x\n", hUSKey, debugstr_w(value), flags);
-    return ERROR_SUCCESS;
+    TRACE("%p, %s, %#x\n", hUSKey, debugstr_w(value), flags);
+    return reg_delete_us(hUSKey, value, flags, TRUE);
 }
 
 LONG WINAPI SHRegDeleteUSValueA(HUSKEY hUSKey, const char *value, SHREGDEL_FLAGS flags)
 {
-    FIXME("%p, %s, %#x\n", hUSKey, debugstr_a(value), flags);
-    return ERROR_SUCCESS;
+    WCHAR *valueW = NULL;
+    LONG ret;
+
+    TRACE("%p, %s, %#x\n", hUSKey, debugstr_a(value), flags);
+
+    if (value && !(valueW = reg_strdup_AtoW(value))) return ERROR_NOT_ENOUGH_MEMORY;
+    ret = SHRegDeleteUSValueW(hUSKey, valueW, flags);
+    heap_free(valueW);
+    return ret;
 }
 
 LONG WINAPI SHRegDeleteUSValueW(HUSKEY hUSKey, const WCHAR *value, SHREGDEL_FLAGS flags)
 {
-    FIXME("%p, %s, %#x\n", hUSKey, debugstr_w(value), flags);
-    return ERROR_SUCCESS;
+    TRACE("%p, %s, %#x\n", hUSKey, debugstr_w(value), flags);
+    return reg_delete_us(hUSKey, value, flags, FALSE);
 }
 
 LONG WINAPI SHRegEnumUSValueA(HUSKEY hUSKey, DWORD index, char *value_name, DWORD *value_name_len, DWORD *type,
