+/* reads every player; with events, says what changed */
+static void refresh_sessions( struct pending_event **events, UINT *event_count, BOOL *sessions_changed, BOOL *current_changed )
+{
+    struct mpris_players_params params = { 0 };
+    struct mpris_player *players;
+    struct session *impl, *next, *current = NULL, *playing = NULL;
+    struct list gone = LIST_INIT( gone );
+    struct pending_event *out = NULL;
+    UINT i, n = 0;
+    DWORD now = GetTickCount();
+    BOOL *seen;
+
+    if (events) { *events = NULL; *event_count = 0; *sessions_changed = *current_changed = FALSE; }
+    if (!(players = calloc( MAX_PLAYERS, sizeof(*players) ))) return;
+    if (mpris_init())
+    {
+        params.players = (UINT64)(ULONG_PTR)players;
+        params.capacity = MAX_PLAYERS;
+        if (WINE_UNIX_CALL( unix_mpris_players, &params )) params.count = 0;
+    }
+    n = min( params.count, MAX_PLAYERS );
+    if (!(seen = calloc( MAX_PLAYERS + 1, sizeof(*seen) )) ||
+        (events && !(out = calloc( MAX_PLAYERS, sizeof(*out) ))))
+    {
+        free( seen );
+        free( players );
+        return;
+    }
+
+    EnterCriticalSection( &gsmtc_cs );
+    LIST_FOR_EACH_ENTRY_SAFE( impl, next, &sessions, struct session, entry )
+    {
+        for (i = 0; i < n; i++) if (!strcmp( players[i].name, impl->info.name )) break;
+        if (i == n)
+        {
+            /* the player left the bus */
+            list_remove( &impl->entry );
+            impl->gone = TRUE;
+            if (current_session == impl) current_session = NULL;
+            list_add_tail( &gone, &impl->entry );
+            if (events) *sessions_changed = TRUE;
+            continue;
+        }
+        seen[i] = TRUE;
+        if (events)
+        {
+            unsigned int changes = compare_players( &impl->info, &players[i], now - impl->read_time );
+            if (changes && *event_count < MAX_PLAYERS)
+            {
+                session_AddRef( &impl->IGlobalSystemMediaTransportControlsSession_iface );
+                out[*event_count].session = impl;
+                out[(*event_count)++].changes = changes;
+            }
+        }
+        impl->info = players[i];
+        impl->read_time = now;
+    }
+    for (i = 0; i < n; i++)
+    {
+        if (seen[i] || !(impl = session_create( &players[i] ))) continue;
+        list_add_tail( &sessions, &impl->entry );
+        if (events) *sessions_changed = TRUE;
+    }
+
+    /* the current session: the one that plays; a playing one that started takes it over */
+    LIST_FOR_EACH_ENTRY( impl, &sessions, struct session, entry )
+        if (impl->info.status == MPRIS_PLAYING) { playing = impl; break; }
+    if (current_session && current_session->info.status == MPRIS_PLAYING) current = current_session;
+    else if (playing) current = playing;
+    else if (current_session) current = current_session;
+    else if (!list_empty( &sessions )) current = LIST_ENTRY( list_head( &sessions ), struct session, entry );
+    if (current != current_session)
+    {
+        current_session = current;
+        if (events) *current_changed = TRUE;
+    }
+    LeaveCriticalSection( &gsmtc_cs );
+
+    LIST_FOR_EACH_ENTRY_SAFE( impl, next, &gone, struct session, entry )
+    {
+        list_init( &impl->entry );
+        session_Release( &impl->IGlobalSystemMediaTransportControlsSession_iface );
+    }
+    if (events) *events = out;
+    free( seen );
+    free( players );
+}
