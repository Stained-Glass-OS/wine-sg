+/*
+ * Reading the bus: the sessions list, and what changed since the last look
+ */
+enum change { CHANGE_MEDIA = 1, CHANGE_PLAYBACK = 2, CHANGE_TIMELINE = 4 };
+
+static unsigned int compare_players( const struct mpris_player *a, const struct mpris_player *b, DWORD elapsed_ms )
+{
+    unsigned int changes = 0;
+    INT64 expected;
+
+    if (strcmp( a->title, b->title ) || strcmp( a->artist, b->artist ) || strcmp( a->album, b->album ) ||
+        strcmp( a->album_artist, b->album_artist ) || strcmp( a->art_url, b->art_url ) ||
+        strcmp( a->track_id, b->track_id ) || a->track_number != b->track_number)
+        changes |= CHANGE_MEDIA;
+    if (a->status != b->status || a->loop != b->loop || a->shuffle != b->shuffle || a->rate != b->rate ||
+        a->has_loop != b->has_loop || a->has_shuffle != b->has_shuffle || a->has_rate != b->has_rate ||
+        a->can_play != b->can_play || a->can_pause != b->can_pause || a->can_next != b->can_next ||
+        a->can_previous != b->can_previous || a->can_seek != b->can_seek || a->can_control != b->can_control)
+        changes |= CHANGE_PLAYBACK;
+    /* the position moves on by itself while it plays: only a jump is a change */
+    expected = a->position_us + (a->status == MPRIS_PLAYING ? (INT64)elapsed_ms * 1000 : 0);
+    if (a->length_us != b->length_us || (changes & CHANGE_MEDIA) ||
+        (b->position_us >= 0 && llabs( b->position_us - expected ) > 2000000))
+        changes |= CHANGE_TIMELINE;
+    return changes;
+}
