+static HRESULT snapshot_create( const struct mpris_player *info, enum snapshot_kind kind, IInspectable **out )
+{
+    struct snapshot *impl;
+    FILETIME ft;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IGlobalSystemMediaTransportControlsSessionMediaProperties_iface.lpVtbl = &media_vtbl;
+    impl->IGlobalSystemMediaTransportControlsSessionPlaybackInfo_iface.lpVtbl = &playback_vtbl;
+    impl->IGlobalSystemMediaTransportControlsSessionPlaybackControls_iface.lpVtbl = &controls_vtbl;
+    impl->IGlobalSystemMediaTransportControlsSessionTimelineProperties_iface.lpVtbl = &timeline_vtbl;
+    impl->ref = 1;
+    impl->kind = kind;
+    impl->info = *info;
+    GetSystemTimeAsFileTime( &ft );
+    impl->now = ((INT64)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    *out = snapshot_iface( impl );
+    return S_OK;
+}
