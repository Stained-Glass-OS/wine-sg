+static DWORD WINAPI watch_proc( void *arg )
+{
+    struct pending_event *events;
+    BOOL sessions_changed, current_changed;
+    UINT i, count;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_gsmtc_watch" );
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    for (;;)
+    {
+        refresh_sessions( &events, &count, &sessions_changed, &current_changed );
+        for (i = 0; i < count; i++)
+        {
+            struct session *impl = events[i].session;
+            IGlobalSystemMediaTransportControlsSession *sender = &impl->IGlobalSystemMediaTransportControlsSession_iface;
+
+            if (events[i].changes & CHANGE_MEDIA)
+                fire( &impl->media_handlers, sender, &IID_IMediaPropertiesChangedEventArgs,
+                      RuntimeClass_Windows_Media_Control_MediaPropertiesChangedEventArgs );
+            if (events[i].changes & CHANGE_PLAYBACK)
+                fire( &impl->playback_handlers, sender, &IID_IPlaybackInfoChangedEventArgs,
+                      RuntimeClass_Windows_Media_Control_PlaybackInfoChangedEventArgs );
+            if (events[i].changes & CHANGE_TIMELINE)
+                fire( &impl->timeline_handlers, sender, &IID_ITimelinePropertiesChangedEventArgs,
+                      RuntimeClass_Windows_Media_Control_TimelinePropertiesChangedEventArgs );
+            session_Release( sender );
+        }
+        free( events );
+        if (sessions_changed)
+            fire( &sessions_handlers, &the_manager.IGlobalSystemMediaTransportControlsSessionManager_iface,
+                  &IID_ISessionsChangedEventArgs, RuntimeClass_Windows_Media_Control_SessionsChangedEventArgs );
+        if (current_changed)
+            fire( &current_handlers, &the_manager.IGlobalSystemMediaTransportControlsSessionManager_iface,
+                  &IID_ICurrentSessionChangedEventArgs, RuntimeClass_Windows_Media_Control_CurrentSessionChangedEventArgs );
+        Sleep( WATCH_INTERVAL_MS );
+    }
+    return 0;
+}
