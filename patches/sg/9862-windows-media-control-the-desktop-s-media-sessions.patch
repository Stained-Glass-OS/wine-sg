+static BOOL WINAPI start_watch_once( INIT_ONCE *once, void *param, void **context )
+{
+    HANDLE thread;
+
+    /* the list as it is now, so that the first look reports changes only */
+    refresh_sessions( NULL, NULL, NULL, NULL );
+    if ((thread = CreateThread( NULL, 0, watch_proc, NULL, 0, NULL ))) watch_thread = thread;
+    return TRUE;
+}
+
+static void start_watch( void )
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, start_watch_once, NULL, NULL );
+}
