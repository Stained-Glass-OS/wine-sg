+/* a request to the player; TRUE when it took it */
+static HRESULT session_command( struct session *impl, enum mpris_command command, UINT32 value, double rate,
+                                INT64 position_us, IAsyncOperation_boolean **operation )
+{
+    struct mpris_command_params params = { 0 };
+
+    if (!operation) return E_POINTER;
+    params.command = command;
+    params.value = value;
+    params.rate = rate;
+    params.position_us = position_us;
+    EnterCriticalSection( &gsmtc_cs );
+    strcpy( params.name, impl->info.name );
+    strcpy( params.track_id, impl->info.track_id );
+    LeaveCriticalSection( &gsmtc_cs );
+    if (command == MPRIS_COMMAND_SET_POSITION && !params.track_id[0]) params.name[0] = 0;
+    if (!impl->gone && params.name[0] && mpris_init() && !WINE_UNIX_CALL( unix_mpris_command, &params ))
+    {
+        TRACE( "%s command %u: %u\n", params.name, command, params.result );
+        impl->read_time = 0;
+        return completed_bool_operation( !!params.result, operation );
+    }
+    return completed_bool_operation( FALSE, operation );
+}
