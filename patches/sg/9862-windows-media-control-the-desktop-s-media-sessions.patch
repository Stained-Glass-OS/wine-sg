+static HRESULT utf8_hstring( const char *str, HSTRING *out )
+{
+    WCHAR buffer[512];
+    int len;
+
+    if (!out) return E_POINTER;
+    len = str && *str ? MultiByteToWideChar( CP_UTF8, 0, str, -1, buffer, ARRAY_SIZE(buffer) ) : 0;
+    return WindowsCreateString( buffer, len ? len - 1 : 0, out );
+}
+
+/* the program the session is of: a Linux program's desktop entry; a Windows program's executable name */
+static void app_id( const struct mpris_player *info, char *out, size_t size )
+{
+    const char *suffix = info->name + strlen( "org.mpris.MediaPlayer2." ), *instance;
+
+    if (info->desktop_entry[0]) snprintf( out, size, "%s", info->desktop_entry );
+    else if ((instance = strstr( suffix, ".instance" )) && info->identity[0])
+    {
+        /* org.mpris.MediaPlayer2.<program>.instance<pid>_<n>: published by a program's transport controls */
+        snprintf( out, size, "%s.exe", info->identity );
+    }
+    else if (info->identity[0]) snprintf( out, size, "%s", info->identity );
+    else snprintf( out, size, "%s", suffix );
+}
+
+static HRESULT WINAPI session_get_SourceAppUserModelId( IGlobalSystemMediaTransportControlsSession *iface, HSTRING *value )
+{
+    struct session *impl = impl_from_IGlobalSystemMediaTransportControlsSession( iface );
+    char id[256];
+
+    EnterCriticalSection( &gsmtc_cs );
+    app_id( &impl->info, id, sizeof(id) );
+    LeaveCriticalSection( &gsmtc_cs );
+    return utf8_hstring( id, value );
+}
+
+/* reads the player again, unless it was read a moment ago */
+static void session_refresh( struct session *impl )
+{
+    struct mpris_players_params params = { 0 };
+    struct mpris_player *player;
+
+    if (impl->gone || GetTickCount() - impl->read_time < 100) return;
+    if (!mpris_init() || !(player = calloc( 1, sizeof(*player) ))) return;
+    params.players = (UINT64)(ULONG_PTR)player;
+    params.capacity = 1;
+    strcpy( params.name, impl->info.name );
+    if (!WINE_UNIX_CALL( unix_mpris_players, &params ) && params.count)
+    {
+        EnterCriticalSection( &gsmtc_cs );
+        impl->info = *player;
+        impl->read_time = GetTickCount();
+        LeaveCriticalSection( &gsmtc_cs );
+    }
+    free( player );
+}
+
+static void session_info( struct session *impl, struct mpris_player *info )
+{
+    session_refresh( impl );
+    EnterCriticalSection( &gsmtc_cs );
+    *info = impl->info;
+    LeaveCriticalSection( &gsmtc_cs );
+}
