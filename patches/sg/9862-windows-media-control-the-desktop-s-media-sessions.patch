+/*
+ * GlobalSystemMediaTransportControlsSessionManager: on Windows the list of every program's
+ * SystemMediaTransportControls session, which launchers, widgets and "now playing" tools read and
+ * control. On the desktop here the media sessions are MPRIS players on the user's session bus: the
+ * Linux programs' own, and every Windows program's transport controls (wine-sg 6523 publishes them).
+ * So a session is an MPRIS player; its properties are the player's, and TryPlayAsync and the others
+ * are the player's Play, Pause... The list is read when asked; with an event handler added, a thread
+ * looks every half second and raises SessionsChanged, CurrentSessionChanged and each session's
+ * MediaPropertiesChanged, PlaybackInfoChanged and TimelinePropertiesChanged, from that thread, as
+ * Windows raises them from its own.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "private.h"
+#include "unixlib.h"
+
+#define WIDL_using_Windows_Media_Control
+#include "windows.media.control.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediacontrol);
+
+#define MAX_PLAYERS 32
+#define WATCH_INTERVAL_MS 500
+#define MAX_ART_SIZE (8 << 20)
+
+/* the layout every TypedEventHandler and AsyncOperationCompletedHandler shares */
+struct handler_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IUnknown *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IUnknown *iface );
+    ULONG (WINAPI *Release)( IUnknown *iface );
+    HRESULT (WINAPI *Invoke)( IUnknown *iface, void *sender, void *args );
+};
+
+static HRESULT invoke_handler( IUnknown *handler, void *sender, void *args )
+{
+    return ((const struct handler_vtbl *)handler->lpVtbl)->Invoke( handler, sender, args );
+}
+
+struct handler_entry
+{
+    struct list entry;
+    IUnknown *handler;
+    EventRegistrationToken token;
+};
+
+static CRITICAL_SECTION gsmtc_cs;
+static CRITICAL_SECTION_DEBUG gsmtc_cs_debug =
+{
+    0, 0, &gsmtc_cs,
+    { &gsmtc_cs_debug.ProcessLocksList, &gsmtc_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": gsmtc_cs") }
+};
+static CRITICAL_SECTION gsmtc_cs = { &gsmtc_cs_debug, -1, 0, 0, 0, 0 };
+static LONG64 next_token;
+
+static HRESULT add_handler( struct list *list, IUnknown *handler, EventRegistrationToken *token )
+{
+    struct handler_entry *entry;
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->handler = handler;
+    IUnknown_AddRef( handler );
+    entry->token.value = token->value = InterlockedIncrement64( &next_token );
+    EnterCriticalSection( &gsmtc_cs );
+    list_add_tail( list, &entry->entry );
+    LeaveCriticalSection( &gsmtc_cs );
+    return S_OK;
+}
+
+static HRESULT remove_handler( struct list *list, EventRegistrationToken token )
+{
+    struct handler_entry *entry, *found = NULL;
+
+    EnterCriticalSection( &gsmtc_cs );
+    LIST_FOR_EACH_ENTRY( entry, list, struct handler_entry, entry )
+        if (entry->token.value == token.value) { found = entry; list_remove( &entry->entry ); break; }
+    LeaveCriticalSection( &gsmtc_cs );
+    if (found)
+    {
+        IUnknown_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+/* the handlers, with a reference each, to call outside the lock */
+static IUnknown **copy_handlers( struct list *list, UINT *count )
+{
+    struct handler_entry *entry;
+    IUnknown **out;
+    UINT n = 0;
+
+    *count = 0;
+    if (!(n = list_count( list )) || !(out = calloc( n, sizeof(*out) ))) return NULL;
+    LIST_FOR_EACH_ENTRY( entry, list, struct handler_entry, entry )
+    {
+        out[*count] = entry->handler;
+        IUnknown_AddRef( entry->handler );
+        (*count)++;
+    }
+    return out;
+}
+
+static void call_handlers( IUnknown **handlers, UINT count, void *sender, void *args )
+{
+    UINT i;
+
+    for (i = 0; i < count; i++)
+    {
+        invoke_handler( handlers[i], sender, args );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+}
