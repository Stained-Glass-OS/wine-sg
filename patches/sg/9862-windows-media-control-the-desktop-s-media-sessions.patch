+/*
+ * wine-sg 9862: the other side -- GlobalSystemMediaTransportControlsSessionManager lists the MPRIS
+ * players on the session bus (the user's Linux players and Windows programs' transport controls
+ * alike), reads their state and sends them Play, Pause, Next... It has a connection of its own.
+ */
+static pthread_mutex_t client_mutex = PTHREAD_MUTEX_INITIALIZER;
+static DBusConnection *client_conn;
+
+#define CLIENT_TIMEOUT_MS 1000
+
+static DBusConnection *get_client(void)
+{
+    const char *address = getenv( "DBUS_SESSION_BUS_ADDRESS" ), *runtime = getenv( "XDG_RUNTIME_DIR" );
+    char path[1024];
+    struct stat st;
+    DBusError err;
+
+    if (client_conn && !p_dbus_connection_get_is_connected( client_conn ))
+    {
+        p_dbus_connection_close( client_conn );
+        p_dbus_connection_unref( client_conn );
+        client_conn = NULL;
+    }
+    if (client_conn) return client_conn;
+    /* the user's own session bus, never one started for us */
+    if (!address || !*address)
+    {
+        if (!runtime || !*runtime || snprintf( path, sizeof(path), "%s/bus", runtime ) >= (int)sizeof(path) ||
+            stat( path, &st ) || !S_ISSOCK( st.st_mode ))
+            return NULL;
+    }
+    p_dbus_error_init( &err );
+    if (!(client_conn = p_dbus_bus_get_private( DBUS_BUS_SESSION, &err )))
+    {
+        TRACE( "no session bus: %s\n", err.message ? err.message : "" );
+        p_dbus_error_free( &err );
+        return NULL;
+    }
+    p_dbus_connection_set_exit_on_disconnect( client_conn, FALSE );
+    return client_conn;
+}
+
+/* a method call and its reply, or NULL */
+static DBusMessage *client_call( DBusMessage *msg )
+{
+    DBusConnection *conn = get_client();
+    DBusMessage *reply;
+    DBusError err;
+
+    if (!conn || !msg)
+    {
+        if (msg) p_dbus_message_unref( msg );
+        return NULL;
+    }
+    p_dbus_error_init( &err );
+    reply = p_dbus_connection_send_with_reply_and_block( conn, msg, CLIENT_TIMEOUT_MS, &err );
+    if (!reply)
+    {
+        TRACE( "%s.%s: %s\n", p_dbus_message_get_interface( msg ), p_dbus_message_get_member( msg ),
+               err.message ? err.message : "" );
+        p_dbus_error_free( &err );
+    }
+    p_dbus_message_unref( msg );
+    return reply;
+}
+
+static void copy_string( char *out, size_t size, const char *in )
+{
+    if (!in) in = "";
+    snprintf( out, size, "%s", in );
+}
+
+/* a string, or the first of a string array */
+static void read_string( DBusMessageIter *value, char *out, size_t size )
+{
+    DBusMessageIter array;
+    const char *str = NULL;
+    int type = p_dbus_message_iter_get_arg_type( value );
+
+    if (type == DBUS_TYPE_STRING || type == DBUS_TYPE_OBJECT_PATH) p_dbus_message_iter_get_basic( value, &str );
+    else if (type == DBUS_TYPE_ARRAY)
+    {
+        p_dbus_message_iter_recurse( value, &array );
+        if (p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_STRING) p_dbus_message_iter_get_basic( &array, &str );
+    }
+    copy_string( out, size, str );
+}
+
+static INT64 read_int( DBusMessageIter *value, INT64 def )
+{
+    union { dbus_int64_t i64; dbus_uint64_t u64; dbus_int32_t i32; dbus_uint32_t u32; double d; } v;
+
+    switch (p_dbus_message_iter_get_arg_type( value ))
+    {
+    case DBUS_TYPE_INT64: p_dbus_message_iter_get_basic( value, &v ); return v.i64;
+    case DBUS_TYPE_UINT64: p_dbus_message_iter_get_basic( value, &v ); return (INT64)v.u64;
+    case DBUS_TYPE_INT32: p_dbus_message_iter_get_basic( value, &v ); return v.i32;
+    case DBUS_TYPE_UINT32: p_dbus_message_iter_get_basic( value, &v ); return v.u32;
+    case DBUS_TYPE_DOUBLE: p_dbus_message_iter_get_basic( value, &v ); return (INT64)v.d;
+    }
+    return def;
+}
+
+static BOOL read_bool( DBusMessageIter *value, BOOL *out )
+{
+    dbus_bool_t b;
+
+    if (p_dbus_message_iter_get_arg_type( value ) != DBUS_TYPE_BOOLEAN) return FALSE;
+    p_dbus_message_iter_get_basic( value, &b );
+    *out = !!b;
+    return TRUE;
+}
+
+static void read_metadata( DBusMessageIter *value, struct mpris_player *player )
+{
+    DBusMessageIter dict, entry, v;
+    const char *key;
+
+    if (p_dbus_message_iter_get_arg_type( value ) != DBUS_TYPE_ARRAY) return;
+    for (p_dbus_message_iter_recurse( value, &dict ); p_dbus_message_iter_get_arg_type( &dict ) == DBUS_TYPE_DICT_ENTRY;
+         p_dbus_message_iter_next( &dict ))
+    {
+        p_dbus_message_iter_recurse( &dict, &entry );
+        if (p_dbus_message_iter_get_arg_type( &entry ) != DBUS_TYPE_STRING) continue;
+        p_dbus_message_iter_get_basic( &entry, &key );
+        if (!p_dbus_message_iter_next( &entry ) || p_dbus_message_iter_get_arg_type( &entry ) != DBUS_TYPE_VARIANT) continue;
+        p_dbus_message_iter_recurse( &entry, &v );
+        if (!strcmp( key, "xesam:title" )) read_string( &v, player->title, sizeof(player->title) );
+        else if (!strcmp( key, "xesam:artist" )) read_string( &v, player->artist, sizeof(player->artist) );
+        else if (!strcmp( key, "xesam:album" )) read_string( &v, player->album, sizeof(player->album) );
+        else if (!strcmp( key, "xesam:albumArtist" )) read_string( &v, player->album_artist, sizeof(player->album_artist) );
+        else if (!strcmp( key, "mpris:artUrl" )) read_string( &v, player->art_url, sizeof(player->art_url) );
+        else if (!strcmp( key, "mpris:trackid" )) read_string( &v, player->track_id, sizeof(player->track_id) );
+        else if (!strcmp( key, "mpris:length" )) player->length_us = read_int( &v, -1 );
+        else if (!strcmp( key, "xesam:trackNumber" )) player->track_number = (INT32)read_int( &v, 0 );
+    }
+}
+
+/* Properties.GetAll of one interface, into the player */
+static BOOL read_properties( struct mpris_player *player, const char *iface )
+{
+    DBusMessage *msg, *reply;
+    DBusMessageIter iter, dict, entry, v;
+    const char *key;
+    BOOL b;
+
+    msg = p_dbus_message_new_method_call( player->name, MPRIS_PATH, PROPS_IFACE, "GetAll" );
+    if (msg) p_dbus_message_append_args( msg, DBUS_TYPE_STRING, &iface, DBUS_TYPE_INVALID );
+    if (!(reply = client_call( msg ))) return FALSE;
+    if (p_dbus_message_get_type( reply ) != DBUS_MESSAGE_TYPE_METHOD_RETURN || !p_dbus_message_iter_init( reply, &iter ) ||
+        p_dbus_message_iter_get_arg_type( &iter ) != DBUS_TYPE_ARRAY)
+    {
+        p_dbus_message_unref( reply );
+        return FALSE;
+    }
+    for (p_dbus_message_iter_recurse( &iter, &dict ); p_dbus_message_iter_get_arg_type( &dict ) == DBUS_TYPE_DICT_ENTRY;
+         p_dbus_message_iter_next( &dict ))
+    {
+        p_dbus_message_iter_recurse( &dict, &entry );
+        if (p_dbus_message_iter_get_arg_type( &entry ) != DBUS_TYPE_STRING) continue;
+        p_dbus_message_iter_get_basic( &entry, &key );
+        if (!p_dbus_message_iter_next( &entry ) || p_dbus_message_iter_get_arg_type( &entry ) != DBUS_TYPE_VARIANT) continue;
+        p_dbus_message_iter_recurse( &entry, &v );
+        if (!strcmp( key, "Identity" )) read_string( &v, player->identity, sizeof(player->identity) );
+        else if (!strcmp( key, "DesktopEntry" )) read_string( &v, player->desktop_entry, sizeof(player->desktop_entry) );
+        else if (!strcmp( key, "Metadata" )) read_metadata( &v, player );
+        else if (!strcmp( key, "Position" )) player->position_us = read_int( &v, -1 );
+        else if (!strcmp( key, "PlaybackStatus" ))
+        {
+            char status[32];
+            read_string( &v, status, sizeof(status) );
+            player->status = !strcmp( status, "Playing" ) ? MPRIS_PLAYING : !strcmp( status, "Paused" ) ? MPRIS_PAUSED : MPRIS_STOPPED;
+        }
+        else if (!strcmp( key, "LoopStatus" ))
+        {
+            char loop[32];
+            read_string( &v, loop, sizeof(loop) );
+            player->loop = !strcmp( loop, "Track" ) ? 1 : !strcmp( loop, "Playlist" ) ? 2 : 0;
+            player->has_loop = 1;
+        }
+        else if (!strcmp( key, "Shuffle" )) { if (read_bool( &v, &b )) { player->shuffle = b; player->has_shuffle = 1; } }
+        else if (!strcmp( key, "Rate" ) && p_dbus_message_iter_get_arg_type( &v ) == DBUS_TYPE_DOUBLE)
+        {
+            p_dbus_message_iter_get_basic( &v, &player->rate );
+            player->has_rate = 1;
+        }
+        else if (!strcmp( key, "CanPlay" )) { if (read_bool( &v, &b )) player->can_play = b; }
+        else if (!strcmp( key, "CanPause" )) { if (read_bool( &v, &b )) player->can_pause = b; }
+        else if (!strcmp( key, "CanGoNext" )) { if (read_bool( &v, &b )) player->can_next = b; }
+        else if (!strcmp( key, "CanGoPrevious" )) { if (read_bool( &v, &b )) player->can_previous = b; }
+        else if (!strcmp( key, "CanSeek" )) { if (read_bool( &v, &b )) player->can_seek = b; }
+        else if (!strcmp( key, "CanControl" )) { if (read_bool( &v, &b )) player->can_control = b; }
+    }
+    p_dbus_message_unref( reply );
+    return TRUE;
+}
+
+static BOOL read_player( struct mpris_player *player, const char *name )
+{
+    memset( player, 0, sizeof(*player) );
+    copy_string( player->name, sizeof(player->name), name );
+    player->length_us = player->position_us = -1;
+    player->rate = 1.0;
+    if (!read_properties( player, PLAYER_IFACE )) return FALSE;
+    read_properties( player, ROOT_IFACE );
+    return TRUE;
+}
+
+static NTSTATUS mpris_players( void *args )
+{
+    struct mpris_players_params *params = args;
+    struct mpris_player *out = (struct mpris_player *)(ULONG_PTR)params->players;
+    DBusMessageIter iter, array;
+    DBusMessage *reply;
+    const char *name;
+
+    params->count = 0;
+    if (!load_dbus()) return STATUS_NOT_SUPPORTED;
+    pthread_mutex_lock( &client_mutex );
+    if (params->name[0])
+    {
+        if (params->capacity && read_player( out, params->name )) params->count = 1;
+        pthread_mutex_unlock( &client_mutex );
+        return STATUS_SUCCESS;
+    }
+    reply = client_call( p_dbus_message_new_method_call( "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                                                         "org.freedesktop.DBus", "ListNames" ) );
+    if (reply && p_dbus_message_iter_init( reply, &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_ARRAY)
+    {
+        for (p_dbus_message_iter_recurse( &iter, &array ); p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_STRING;
+             p_dbus_message_iter_next( &array ))
+        {
+            p_dbus_message_iter_get_basic( &array, &name );
+            if (strncmp( name, ROOT_IFACE ".", strlen( ROOT_IFACE "." ) ) || strlen( name ) >= sizeof(out->name)) continue;
+            if (params->count < params->capacity)
+            {
+                if (!read_player( &out[params->count], name )) continue;
+            }
+            params->count++;
+        }
+    }
+    if (reply) p_dbus_message_unref( reply );
+    pthread_mutex_unlock( &client_mutex );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS mpris_command( void *args )
+{
+    static const char *const methods[] = { "Play", "Pause", "PlayPause", "Stop", "Next", "Previous" };
+    struct mpris_command_params *params = args;
+    DBusMessage *msg = NULL, *reply;
+    DBusMessageIter iter, variant;
+    const char *iface = PLAYER_IFACE, *prop, *str;
+    dbus_bool_t b;
+    double d;
+
+    params->result = 0;
+    if (!load_dbus()) return STATUS_NOT_SUPPORTED;
+    if (!params->name[0]) return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock( &client_mutex );
+    if (params->command <= MPRIS_COMMAND_PREVIOUS)
+        msg = p_dbus_message_new_method_call( params->name, MPRIS_PATH, PLAYER_IFACE, methods[params->command] );
+    else if (params->command == MPRIS_COMMAND_SET_POSITION)
+    {
+        const char *track = params->track_id;
+        dbus_int64_t pos = params->position_us;
+        if ((msg = p_dbus_message_new_method_call( params->name, MPRIS_PATH, PLAYER_IFACE, "SetPosition" )))
+            p_dbus_message_append_args( msg, DBUS_TYPE_OBJECT_PATH, &track, DBUS_TYPE_INT64, &pos, DBUS_TYPE_INVALID );
+    }
+    else if (params->command <= MPRIS_COMMAND_SET_RATE &&
+             (msg = p_dbus_message_new_method_call( params->name, MPRIS_PATH, PROPS_IFACE, "Set" )))
+    {
+        p_dbus_message_iter_init_append( msg, &iter );
+        p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &iface );
+        if (params->command == MPRIS_COMMAND_SET_LOOP)
+        {
+            prop = "LoopStatus";
+            str = params->value == 1 ? "Track" : params->value == 2 ? "Playlist" : "None";
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &prop );
+            p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "s", &variant );
+            p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_STRING, &str );
+        }
+        else if (params->command == MPRIS_COMMAND_SET_SHUFFLE)
+        {
+            prop = "Shuffle";
+            b = !!params->value;
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &prop );
+            p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "b", &variant );
+            p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_BOOLEAN, &b );
+        }
+        else
+        {
+            prop = "Rate";
+            d = params->rate;
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &prop );
+            p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "d", &variant );
+            p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_DOUBLE, &d );
+        }
+        p_dbus_message_iter_close_container( &iter, &variant );
+    }
+    if ((reply = client_call( msg )))
+    {
+        params->result = p_dbus_message_get_type( reply ) == DBUS_MESSAGE_TYPE_METHOD_RETURN;
+        p_dbus_message_unref( reply );
+    }
+    pthread_mutex_unlock( &client_mutex );
+    return STATUS_SUCCESS;
+}
+
+static int hex_value( char c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* only the user's own files: a file:// URL with an absolute path */
+static NTSTATUS mpris_read_art( void *args )
+{
+    struct mpris_read_art_params *params = args;
+    char path[1024], *out = path;
+    const char *in;
+    struct stat st;
+    FILE *file;
+    size_t size;
+
+    size = params->size;
+    params->size = 0;
+    if (strncmp( params->url, "file:///", 8 )) return STATUS_SUCCESS;
+    for (in = params->url + 7; *in && out < path + sizeof(path) - 1; in++)
+    {
+        if (*in == '%' && hex_value( in[1] ) >= 0 && hex_value( in[2] ) >= 0)
+        {
+            *out++ = (char)(hex_value( in[1] ) * 16 + hex_value( in[2] ));
+            in += 2;
+        }
+        else *out++ = *in;
+    }
+    *out = 0;
+    if (stat( path, &st ) || !S_ISREG( st.st_mode ) || st.st_size <= 0 || (UINT64)st.st_size > size) return STATUS_SUCCESS;
+    if (!(file = fopen( path, "rb" ))) return STATUS_SUCCESS;
+    params->size = fread( (void *)(ULONG_PTR)params->data, 1, st.st_size, file );
+    fclose( file );
+    return STATUS_SUCCESS;
+}
