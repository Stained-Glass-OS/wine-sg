+        return hq_bitmap_pixel(src_rect, bits, width, height, point, footprint, attributes, TRUE);
+    case InterpolationModeHighQualityBilinear:
+        return hq_bitmap_pixel(src_rect, bits, width, height, point, footprint, attributes, FALSE);
+    default:   /* Default and LowQuality are bilinear */
     case InterpolationModeBilinear:
     {
         REAL leftxf, topyf;
@@ -3348,7 +3501,7 @@ GpStatus WINGDIPAPI GdipDrawImagePointsRect(GpGraphics *graphics, GpImage *image
                 REAL m11, m12, m21, m22, mdx, mdy;
                 REAL x_dx, x_dy, y_dx, y_dy;
