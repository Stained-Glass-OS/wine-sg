+/* a pixel for the bicubic and prefiltering samplers: outside the bitmap as
+ * the wrap mode says, outside the sampled area its nearest edge pixel */
+static ARGB fetch_bitmap_pixel(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width,
+    UINT height, INT x, INT y, GDIPCONST GpImageAttributes *attributes)
+{
+    if (attributes->wrap == WrapModeClamp && (x < 0 || y < 0 || x >= width || y >= height))
+        return attributes->outside_color;
+    if (attributes->wrap == WrapModeClamp)
+    {
+        x = max(src_rect->X, min(x, src_rect->X + src_rect->Width - 1));
+        y = max(src_rect->Y, min(y, src_rect->Y + src_rect->Height - 1));
+    }
+    return sample_bitmap_pixel(src_rect, bits, width, height, x, y, attributes);
+}
+
+static inline void add_premultiplied(REAL *acc, ARGB c, REAL w)
+{
+    REAL a = (c >> 24) / 255.0f;
+    acc[0] += w * a;
+    acc[1] += w * a * ((c >> 16) & 0xff);
+    acc[2] += w * a * ((c >> 8) & 0xff);
+    acc[3] += w * a * (c & 0xff);
+}
+
+static ARGB from_premultiplied(const REAL *acc)
+{
+    REAL a = acc[0];
+    INT ia, r, g, b;
+
+    if (a <= 0.0f) return 0;
+    if (a > 1.0f) a = 1.0f;
+    ia = gdip_round(a * 255.0f);
+    r = gdip_round(acc[1] / acc[0]);
+    g = gdip_round(acc[2] / acc[0]);
+    b = gdip_round(acc[3] / acc[0]);
+    r = max(0, min(255, r));
+    g = max(0, min(255, g));
+    b = max(0, min(255, b));
+    return (ia << 24) | (r << 16) | (g << 8) | b;
+}
+
+/* Keys' cubic convolution kernel, a = -0.5 */
+static REAL cubic_weight(REAL t)
+{
+    t = fabsf(t);
+    if (t <= 1.0f) return (1.5f * t - 2.5f) * t * t + 1.0f;
+    if (t < 2.0f) return ((-0.5f * t + 2.5f) * t - 4.0f) * t + 2.0f;
+    return 0.0f;
+}
+
+static ARGB bicubic_bitmap_pixel(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width,
+    UINT height, REAL px, REAL py, GDIPCONST GpImageAttributes *attributes)
+{
+    INT x0 = (INT)floorf(px), y0 = (INT)floorf(py), i, j;
+    REAL fx = px - x0, fy = py - y0, wx[4], wy[4], acc[4] = {0}, total = 0.0f;
+
+    for (i = 0; i < 4; i++)
+    {
+        wx[i] = cubic_weight(fx - (i - 1));
+        wy[i] = cubic_weight(fy - (i - 1));
+    }
+    for (j = 0; j < 4; j++)
+        for (i = 0; i < 4; i++)
+        {
+            add_premultiplied(acc, fetch_bitmap_pixel(src_rect, bits, width, height, x0 + i - 1, y0 + j - 1,
+                                                      attributes), wx[i] * wy[j]);
+            total += wx[i] * wy[j];
+        }
+    if (total != 0.0f && total != 1.0f)
+        for (i = 0; i < 4; i++) acc[i] /= total;
+    /* the kernel overshoots: keep the colour within what alpha allows */
+    if (acc[0] > 1.0f) acc[0] = 1.0f;
+    for (i = 1; i < 4; i++)
+        acc[i] = max(0.0f, min(acc[i], acc[0] * 255.0f));
+    return from_premultiplied(acc);
+}
+
+static ARGB bilinear_bitmap_pixel(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width,
+    UINT height, REAL px, REAL py, GDIPCONST GpImageAttributes *attributes)
+{
+    INT x0 = (INT)floorf(px), y0 = (INT)floorf(py);
+    REAL fx = px - x0, fy = py - y0, acc[4] = {0};
+
+    add_premultiplied(acc, fetch_bitmap_pixel(src_rect, bits, width, height, x0, y0, attributes), (1 - fx) * (1 - fy));
+    add_premultiplied(acc, fetch_bitmap_pixel(src_rect, bits, width, height, x0 + 1, y0, attributes), fx * (1 - fy));
+    add_premultiplied(acc, fetch_bitmap_pixel(src_rect, bits, width, height, x0, y0 + 1, attributes), (1 - fx) * fy);
+    add_premultiplied(acc, fetch_bitmap_pixel(src_rect, bits, width, height, x0 + 1, y0 + 1, attributes), fx * fy);
+    return from_premultiplied(acc);
+}
+
+/* the high quality modes: when an image is drawn smaller, average over each
+ * destination pixel's footprint in the source (a prefilter), so that detail
+ * between the samples is not lost; drawn larger, one bicubic or bilinear
+ * sample. footprint: the source vectors of one destination pixel step. */
+static ARGB hq_bitmap_pixel(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width, UINT height,
+    const GpPointF *point, const GpPointF *footprint, GDIPCONST GpImageAttributes *attributes, BOOL bicubic)
+{
+    REAL sx = sqrtf(footprint[0].X * footprint[0].X + footprint[0].Y * footprint[0].Y);
+    REAL sy = sqrtf(footprint[1].X * footprint[1].X + footprint[1].Y * footprint[1].Y);
+    INT nx, ny, i, j;
+    REAL acc[4] = {0};
+
+#ifdef SG_MUTANT_NO_PREFILTER
+    sx = sy = 1.0f;
+#endif
+    if (sx <= 1.0f && sy <= 1.0f)
+        return bicubic ? bicubic_bitmap_pixel(src_rect, bits, width, height, point->X, point->Y, attributes)
+                       : bilinear_bitmap_pixel(src_rect, bits, width, height, point->X, point->Y, attributes);
+
+    nx = max(1, min(16, (INT)ceilf(sx)));
+    ny = max(1, min(16, (INT)ceilf(sy)));
+    for (j = 0; j < ny; j++)
+    {
+        REAL v = (j + 0.5f) / ny - 0.5f;
+        for (i = 0; i < nx; i++)
+        {
+            REAL u = (i + 0.5f) / nx - 0.5f;
+            REAL px = point->X + u * footprint[0].X + v * footprint[1].X;
+            REAL py = point->Y + u * footprint[0].Y + v * footprint[1].Y;
+            add_premultiplied(acc, bilinear_bitmap_pixel(src_rect, bits, width, height, px, py, attributes),
+                              1.0f / (nx * ny));
+        }
+    }
+    return from_premultiplied(acc);
+}
+
+static ARGB resample_bitmap_pixel_footprint(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width,
+    UINT height, GpPointF *point, const GpPointF *footprint, GDIPCONST GpImageAttributes *attributes,
+    InterpolationMode interpolation, PixelOffsetMode offset_mode);
+
 static ARGB resample_bitmap_pixel(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width,
     UINT height, GpPointF *point, GDIPCONST GpImageAttributes *attributes,
     InterpolationMode interpolation, PixelOffsetMode offset_mode)
 {
-    static int fixme;
+    static const GpPointF unit[2] = {{1.0f, 0.0f}, {0.0f, 1.0f}};
+    return resample_bitmap_pixel_footprint(src_rect, bits, width, height, point, unit, attributes,
+                                           interpolation, offset_mode);
+}
 
+static ARGB resample_bitmap_pixel_footprint(GDIPCONST GpRect *src_rect, LPBYTE bits, UINT width,
+    UINT height, GpPointF *point, const GpPointF *footprint, GDIPCONST GpImageAttributes *attributes,
+    InterpolationMode interpolation, PixelOffsetMode offset_mode)
+{
