     return Ok;
 }
 
+/* the metrics of the family's face in this style: bold and italic faces have
+ * their own (Stained Glass OS 1656) */
+static void get_style_metrics(GDIPCONST GpFontFamily *family, INT style, UINT16 *em_height, UINT16 *ascent,
+                              UINT16 *descent, UINT16 *line_spacing)
+{
+    GpFontFamily *fam = (GpFontFamily *)family;
+    INT index = (style & (FontStyleBold | FontStyleItalic)) - 1;
+
+    *em_height = family->em_height;
+    *ascent = family->ascent;
+    *descent = family->descent;
+    *line_spacing = family->line_spacing;
+#ifdef SG_MUTANT_STYLE_IGNORED
+    index = -1;
+#endif
+    if (index < 0) return;
+
+    if (!fam->styled[index].valid)
+    {
+        struct font_metrics fm;
+        WCHAR face[LF_FACESIZE];
+        LOGFONTW lf = {0};
+        HFONT hfont, old;
+        HDC hdc;
+
+        fam->styled[index].em_height = family->em_height;
+        fam->styled[index].ascent = family->ascent;
+        fam->styled[index].descent = family->descent;
+        fam->styled[index].line_spacing = family->line_spacing;
+        if ((hdc = CreateCompatibleDC(0)))
+        {
+            lf.lfHeight = -(INT)family->em_height;
+            lf.lfWeight = (style & FontStyleBold) ? FW_BOLD : FW_REGULAR;
+            lf.lfItalic = (style & FontStyleItalic) ? TRUE : FALSE;
+            lf.lfCharSet = DEFAULT_CHARSET;
+            lstrcpynW(lf.lfFaceName, family->FamilyName, LF_FACESIZE);
+            hfont = CreateFontIndirectW(&lf);
+            old = SelectObject(hdc, hfont);
+            /* only the family's own faces; a substitute's metrics would be wrong */
+            if (GetTextFaceW(hdc, LF_FACESIZE, face) && !wcsicmp(face, family->FamilyName) &&
+                get_font_metrics(hdc, &fm) && fm.em_height)
+            {
+                fam->styled[index].em_height = fm.em_height;
+                fam->styled[index].ascent = fm.ascent;
+                fam->styled[index].descent = fm.descent;
+                fam->styled[index].line_spacing = fm.line_spacing;
+            }
+            SelectObject(hdc, old);
+            DeleteObject(hfont);
+            DeleteDC(hdc);
+        }
+        fam->styled[index].valid = TRUE;
+    }
+    *em_height = family->styled[index].em_height;
+    *ascent = family->styled[index].ascent;
+    *descent = family->styled[index].descent;
+    *line_spacing = family->styled[index].line_spacing;
+}
