@@ -402,8 +408,20 @@ static void CALLBACK move_size_event( HWINEVENTHOOK hook, DWORD event, HWND hwnd
 
 /* ---- programs ------------------------------------------------------------- */
 
+void sg_pass_foreground( HWND target )
+{
+    DWORD pid;
+#ifdef SG_MUTANT_NO_PASS_FOREGROUND
+    return;
+#endif
+    if (target && GetWindowThreadProcessId( target, &pid )) AllowSetForegroundWindow( pid );
+}
+
 static void run( const WCHAR *file, const WCHAR *params )
 {
+    /* Stained Glass OS 9931: the shell's own programs (sg-notify /toggle and the like) hand the
+     * request to the one running, which then comes forward on the person's key */
+    AllowSetForegroundWindow( ASFW_ANY );
     if ((INT_PTR)ShellExecuteW( NULL, NULL, file, params, NULL, SW_SHOWNORMAL ) <= 32)
         WARN( "could not start %s %s\n", debugstr_w(file), debugstr_w(params) );
 }
@@ -419,6 +437,7 @@ static void magnifier( UINT cmd )
 
     if (mag)
     {
+        sg_pass_foreground( mag );
         if (cmd == WM_CLOSE) PostMessageW( mag, WM_CLOSE, 0, 0 );
         else PostMessageW( mag, WM_COMMAND, cmd, 0 );
     }
@@ -439,6 +458,8 @@ static void on_screen_keyboard(void)
  * Control Panel (and its page) where no Settings app is registered. */
 static void run_settings( const WCHAR *uri, const WCHAR *control_params )
 {
+    /* Stained Glass OS 9931: Settings already running takes the page and comes forward (Win+I) */
+    AllowSetForegroundWindow( ASFW_ANY );
     if ((INT_PTR)ShellExecuteW( NULL, NULL, uri, NULL, NULL, SW_SHOWNORMAL ) > 32) return;
     TRACE( "no handler for %s, using the Control Panel\n", debugstr_w(uri) );
     run( L"control.exe", control_params );
@@ -463,6 +484,7 @@ static void run_dialog(void)
 static void open_start(void)
 {
     HWND start = FindWindowW( L"SgStartPanel", NULL );
+    sg_pass_foreground( start );
     if (start) PostMessageW( start, WM_USER + 10, 0, 0 );
     else do_startmenu( sk_tray );
 }
