+     * then stays orange until the window is activated or stops flashing (HSHELL_REDRAW) */
+    BOOL        flash_on;
+    int         flash_ticks;    /* blinks left; lit on even counts, steady at 0 */
     /* Stained Glass OS: combining buttons (one application's windows) */
     WCHAR       exe[MAX_PATH];  /* the program, which decides the group */
     struct taskbar_button *group;   /* the group's leader: the button shown */
@@ -1466,6 +1470,7 @@ static void sync_taskbar_buttons(void)
     {
         if (!win->hwnd) { start = win; continue; }
         win->active = (win->xwin || win->elevated) ? win->xwin_focused : (win->hwnd == foreground);
+        if (win->active) win->flash_on = FALSE;   /* Stained Glass OS 9931: activated, it stops flashing */
         /* Stained Glass OS: only the current virtual desktop's windows */
         /* as on Windows: no button for a tool window (Start, flyouts), unless
          * it asks for one with WS_EX_APPWINDOW */
@@ -2076,6 +2081,71 @@ static void sg_repaint_progress(void)
 /* brings its window (or tab) forward; its x closes it.                       */
 
 #define SG_THUMB_HOVER_MS     400
+#define SG_FLASH_TIMER        0xC1B2   /* Stained Glass OS 9931: flashing buttons blink */
+#define SG_COL_FLASH          RGB(0xF7,0x63,0x0C)   /* a flashing button's orange, as Windows' */
+#define SG_FLASH_BLINKS       6        /* three blinks, then lit */
+static UINT sg_shellhook_msg;          /* "SHELLHOOK": the tray is a shell hook window */
+
+/* whether a button (or, combined, one of its group's windows) is lit by a flash now */
+static BOOL sg_flash_lit( const struct taskbar_button *button )
+{
+    const struct taskbar_button *win;
+
+#ifdef SG_MUTANT_TASKBAR_NO_FLASH
+    return FALSE;
+#endif
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (win != button && !(button->combined && win->group == button)) continue;
+        if (win->flash_on && !(win->flash_ticks % 2)) return TRUE;
+    }
+    return FALSE;
+}
+
+static void sg_flash_repaint( struct taskbar_button *win )
+{
+    struct taskbar_button *shown = win->combined && win->group ? win->group : win;
+    if (shown->button) InvalidateRect( shown->button, NULL, TRUE );
+}
+
+/* the shell hook's news: a window flashes, or is redrawn (FLASHW_STOP, a new title) */
+static void sg_shell_hook( WPARAM code, HWND hwnd )
+{
+    struct taskbar_button *win;
+
+    if (!hwnd || !(win = find_taskbar_button( hwnd ))) return;
+    switch (code)
+    {
+    case HSHELL_FLASH:
+        if (win->hwnd == GetAncestor( GetForegroundWindow(), GA_ROOTOWNER )) return;
+        if (!win->flash_on) win->flash_ticks = SG_FLASH_BLINKS;
+        win->flash_on = TRUE;
+        SetTimer( tray_window, SG_FLASH_TIMER, 500, NULL );
+        sg_flash_repaint( win );
+        break;
+    case HSHELL_REDRAW:
+        if (!win->flash_on) return;
+        win->flash_on = FALSE;
+        sg_flash_repaint( win );
+        break;
+    }
+}
+
+static void sg_flash_tick(void)
+{
+    struct taskbar_button *win;
+    BOOL more = FALSE;
+
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (!win->flash_on || !win->flash_ticks) continue;
+        win->flash_ticks--;
+        if (win->flash_ticks) more = TRUE;
+        sg_flash_repaint( win );
+    }
+    if (!more) KillTimer( tray_window, SG_FLASH_TIMER );
+}
+
 #define SG_THUMB_HIDE_TIMER   0xC1B0
 #define SG_THUMB_RESHOW_TIMER 0xC1B1
 #define SG_THUMB_W            SG_PX(200)
