+++ b/programs/explorer/shellkeys.c
@@ -109,6 +109,12 @@ static void minimize_all( BOOL remember )
     EnumWindows( collect_proc, 0 );
     for (i = 0; i < nshown; i++) ShowWindowAsync( shown[i], SW_SHOWMINNOACTIVE );
     if (!remember) nshown = 0;
+    /* Stained Glass OS 9932: the desktop's icons get the keyboard, as Windows' desktop list view does
+     * (a letter selects an icon, Enter opens it); it was the taskbar, where keys did nothing */
