         else do_startmenu( tray_window );
         return;
@@ -4908,6 +4981,7 @@ static void activate_taskbar_window( HWND hwnd )
          * and toggles on this message. Fall back to Wine's built-in menu when
          * it is not, so a bare Wine still has a Start button. */
         HWND sg = FindWindowW( L"SgStartPanel", NULL );
+        sg_pass_foreground( sg );
         if (sg) PostMessageW( sg, WM_USER + 10, 0, 0 );
         else do_startmenu( tray_window );
         return;
@@ -4940,6 +5014,14 @@ static void activate_taskbar_window( HWND hwnd )
         }
         hwnd = owned;
     }
+    /* Stained Glass OS 9931: as Windows' taskbar, the button's window's last active pop-up comes forward
+     * when that window itself is not shown (a program whose visible window is owned by a hidden one);
+     * it used to be shown on top already, before the foreground lock kept such windows back */
+    if (hwnd && !IsWindowVisible( hwnd ))
+    {
+        HWND popup = GetLastActivePopup( hwnd );
+        if (popup && popup != hwnd && IsWindowVisible( popup ) && IsWindowEnabled( popup )) hwnd = popup;
+    }
     SetForegroundWindow( hwnd );
 }
 
