 /* the Windows key's shortcuts (shellkeys.c) */
 extern void initialize_shell_keys( HWND tray );
+extern HWND desktop_keys_window(void);   /* the desktop's icons' keyboard window (desktop.c) */
+
+/* Stained Glass OS 9931: the shell's pieces run in programs of their own (sg-shell's Start, Magnifier,
+ * the notification centre): asked to show themselves on the person's click or key, they may take the
+ * foreground (AllowSetForegroundWindow, as Windows' shell grants its own hosts) */
+extern void sg_pass_foreground( HWND target );
 extern BOOL shell_hotkey( WPARAM id );
 extern void shell_show_desktop(void);
 extern void shell_quick_link(void);
