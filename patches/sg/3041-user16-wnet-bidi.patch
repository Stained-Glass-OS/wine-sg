+++ b/dlls/user.exe16/network.c
@@ -26,11 +26,92 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winnetwk.h"
+#include "winerror.h"
+#include "wownt32.h"
 #include "wine/winnet16.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wnet);
 
+/* the last error of a WNet16 call, for WNetGetError */
+static WORD last_wnet_error = WN16_SUCCESS;
+
+static WORD wnet_error_from_win32( DWORD err )
+{
+    WORD ret;
+
+    switch (err)
+    {
+    case NO_ERROR:                   ret = WN16_SUCCESS; break;
+    case ERROR_MORE_DATA:            ret = WN16_MORE_DATA; break;
+    case ERROR_NOT_SUPPORTED:
+    case ERROR_CALL_NOT_IMPLEMENTED:
+    case ERROR_NO_NETWORK:           ret = WN16_NOT_SUPPORTED; break;
+    case ERROR_INVALID_PASSWORD:
+    case ERROR_LOGON_FAILURE:        ret = WN16_BAD_PASSWORD; break;
+    case ERROR_ACCESS_DENIED:        ret = WN16_ACCESS_DENIED; break;
+    case ERROR_BUSY:                 ret = WN16_FUNCTION_BUSY; break;
+    case ERROR_NOT_ENOUGH_MEMORY:
+    case ERROR_OUTOFMEMORY:          ret = WN16_OUT_OF_MEMORY; break;
+    case ERROR_CANCELLED:            ret = WN16_CANCEL; break;
+    case ERROR_NOT_CONNECTED:        ret = WN16_NOT_CONNECTED; break;
+    case ERROR_OPEN_FILES:           ret = WN16_OPEN_FILES; break;
+    case ERROR_BAD_NETPATH:
+    case ERROR_BAD_NET_NAME:         ret = WN16_BAD_NETNAME; break;
+    case ERROR_BAD_DEVICE:           ret = WN16_BAD_LOCALNAME; break;
+    case ERROR_ALREADY_ASSIGNED:
+    case ERROR_DEVICE_ALREADY_REMEMBERED: ret = WN16_ALREADY_CONNECTED; break;
+    case ERROR_INVALID_PARAMETER:    ret = WN16_BAD_VALUE; break;
+    case ERROR_INVALID_ADDRESS:      ret = WN16_BAD_POINTER; break;
+    case ERROR_CONNECTION_UNAVAIL:   ret = WN16_CONNECTION_CLOSED; break;
+    default:                         ret = WN16_NET_ERROR; break;
+    }
+    last_wnet_error = ret;
+    return ret;
+}
+
+static DWORD wnet_resource_type( WORD type )
+{
+    /* WNTYPE_DRIVE, WNTYPE_FILE, WNTYPE_PRINTER */
+    return type == 3 ? RESOURCETYPE_PRINT : RESOURCETYPE_DISK;
+}
+
+static const char *wnet_error_text( WORD error )
+{
+    switch (error)
+    {
+    case WN16_SUCCESS:           return "The operation was successful.";
+    case WN16_NOT_SUPPORTED:     return "The network does not support this function.";
+    case WN16_NET_ERROR:         return "A network error occurred.";
+    case WN16_MORE_DATA:         return "More data is available than fits in the buffer.";
+    case WN16_BAD_POINTER:       return "An invalid pointer was passed.";
+    case WN16_BAD_VALUE:         return "An invalid value was passed.";
+    case WN16_BAD_PASSWORD:      return "The password is not correct.";
+    case WN16_ACCESS_DENIED:     return "Access was denied.";
+    case WN16_FUNCTION_BUSY:     return "The network is busy.";
+    case WN16_WINDOWS_ERROR:     return "A system error occurred.";
+    case WN16_BAD_USER:          return "The user name is not valid.";
+    case WN16_OUT_OF_MEMORY:     return "There is not enough memory.";
+    case WN16_CANCEL:            return "The operation was canceled.";
+    case WN16_CONTINUE:          return "The operation continues.";
+    case WN16_NOT_CONNECTED:     return "The device is not connected.";
+    case WN16_OPEN_FILES:        return "There are open files on the connection.";
+    case WN16_BAD_NETNAME:       return "The network name is not valid.";
+    case WN16_BAD_LOCALNAME:     return "The local device name is not valid.";
+    case WN16_ALREADY_CONNECTED: return "The device is already connected.";
+    case WN16_DEVICE_ERROR:      return "A device error occurred.";
+    case WN16_CONNECTION_CLOSED: return "The connection was closed.";
+    case WN16_BAD_JOBID:         return "The job identifier is not valid.";
+    case WN16_JOB_NOT_FOUND:     return "The job was not found.";
+    case WN16_JOB_NOT_HELD:      return "The job is not held.";
+    case WN16_BAD_QUEUE:         return "The queue is not valid.";
+    case WN16_BAD_FILE_HANDLE:   return "The file handle is not valid.";
+    case WN16_CANT_SET_COPIES:   return "The number of copies cannot be set.";
+    case WN16_ALREADY_LOCKED:    return "The queue is already locked.";
+    default:                     return NULL;
+    }
+}
+
