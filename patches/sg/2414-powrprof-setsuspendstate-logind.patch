From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] powrprof: SetSuspendState suspends and hibernates through systemd-logind

SetSuspendState only logged a FIXME and said TRUE. It now needs the shutdown
privilege (ERROR_PRIVILEGE_NOT_HELD), asks logind on the system bus whether
the machine can (CanSuspend / CanHibernate: "na" is ERROR_NOT_SUPPORTED, "no"
ERROR_ACCESS_DENIED), then calls Suspend or Hibernate (interactive false, so
polkit decides for the active local user; a refusal is ERROR_ACCESS_DENIED,
other errors ERROR_GEN_FAILURE). Like Windows it returns TRUE only once the
machine is back: it follows logind's PrepareForSleep signal. No libdbus or
no system bus is ERROR_NOT_SUPPORTED. powrprof gets a Unix library, which
loads libdbus at run time.
---
--- a/dlls/powrprof/Makefile.in
+++ b/dlls/powrprof/Makefile.in
@@ -1,8 +1,11 @@
 MODULE    = powrprof.dll
+UNIXLIB   = powrprof.so
+UNIX_CFLAGS = $(DBUS_CFLAGS)
 IMPORTLIB = powrprof
 IMPORTS   = advapi32 user32 rpcrt4
 
 SOURCES = \
 	legacy.c \
 	powrprof.c \
-	schemes.c
+	schemes.c \
+	unixlib.c
--- a/dlls/powrprof/powrprof.c
+++ b/dlls/powrprof/powrprof.c
@@ -28,6 +28,8 @@
 #include "winreg.h"
 #include "winternl.h"
 #include "powrprof.h"
+#include "wine/unixlib.h"
+#include "unixlib.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(powrprof);
@@ -175,13 +177,67 @@ BOOLEAN WINAPI IsPwrSuspendAllowed(VOID)
    return PowerCaps.SystemS1 && PowerCaps.SystemS2 && PowerCaps.SystemS3;
 }
 
+/* Suspending or hibernating is the Linux system's: systemd-logind, asked on
+ * the system bus, whose polkit lets the active local user do it. The call
+ * returns once the machine is back. ForceCritical and DisableWakeEvent have
+ * nothing to act on: logind neither asks programs first nor arms wake events
+ * for this request. */
 BOOLEAN WINAPI SetSuspendState(BOOLEAN Hibernate, BOOLEAN ForceCritical,
 	BOOLEAN DisableWakeEvent)
 {
-   /* FIXME: I have NO idea how you're supposed to call NtInitiatePowerAction
-    * here, because it's not a documented function that I can find */
-   FIXME("(%d, %d, %d) stub!\n", Hibernate, ForceCritical, DisableWakeEvent);
-   return TRUE;
+    struct suspend_params params;
+    TOKEN_PRIVILEGES tp;
+    HANDLE token;
+    BOOL ok;
+
+    TRACE("(%d, %d, %d)\n", Hibernate, ForceCritical, DisableWakeEvent);
+
+    /* like Windows: the caller needs the shutdown privilege, which it is given for the call */
+    if (!OpenThreadToken(GetCurrentThread(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, TRUE, &token) &&
+        !OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token))
+        return FALSE;
+    tp.PrivilegeCount = 1;
+    tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    if (!LookupPrivilegeValueW(NULL, L"SeShutdownPrivilege", &tp.Privileges[0].Luid))
+    {
+        CloseHandle(token);
+        return FALSE;
+    }
+    SetLastError(0);
+    ok = AdjustTokenPrivileges(token, FALSE, &tp, 0, NULL, NULL);
+    CloseHandle(token);
+    if (!ok) return FALSE;
+    if (GetLastError() == ERROR_NOT_ALL_ASSIGNED)
+    {
+        SetLastError(ERROR_PRIVILEGE_NOT_HELD);
+        return FALSE;
+    }
+
+    params.hibernate = Hibernate != 0;
+    params.result = SUSPEND_UNAVAILABLE;
+    if (__wine_init_unix_call() || WINE_UNIX_CALL(unix_suspend, &params))
+    {
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+#ifdef SG_MUTANT_SUSPEND_ALWAYS_TRUE
+    if (params.result != SUSPEND_OK) return TRUE;
+#endif
+    switch (params.result)
+    {
+    case SUSPEND_OK:
+        return TRUE;
+    case SUSPEND_DENIED:
+        SetLastError(ERROR_ACCESS_DENIED);
+        break;
+    case SUSPEND_FAILED:
+        SetLastError(ERROR_GEN_FAILURE);
+        break;
+    default:  /* no way to ask, or the machine cannot */
+        SetLastError(ERROR_NOT_SUPPORTED);
+        break;
+    }
+    return FALSE;
 }
 
 
