+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <string.h>
+#include <stdarg.h>
+#include <dlfcn.h>
+#include <time.h>
+#ifdef SONAME_LIBDBUS_1
+# include <dbus/dbus.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "unixlib.h"
+
+#ifdef SONAME_LIBDBUS_1
+
+#define DBUS_FUNCS \
+    DO_FUNC(dbus_bus_add_match); \
+    DO_FUNC(dbus_bus_get_private); \
+    DO_FUNC(dbus_connection_close); \
+    DO_FUNC(dbus_connection_pop_message); \
+    DO_FUNC(dbus_connection_read_write_dispatch); \
+    DO_FUNC(dbus_connection_send_with_reply_and_block); \
+    DO_FUNC(dbus_connection_set_exit_on_disconnect); \
+    DO_FUNC(dbus_connection_unref); \
+    DO_FUNC(dbus_error_free); \
+    DO_FUNC(dbus_error_init); \
+    DO_FUNC(dbus_error_is_set); \
+    DO_FUNC(dbus_message_get_args); \
+    DO_FUNC(dbus_message_is_signal); \
+    DO_FUNC(dbus_message_iter_append_basic); \
+    DO_FUNC(dbus_message_iter_init_append); \
+    DO_FUNC(dbus_message_new_method_call); \
+    DO_FUNC(dbus_message_unref)
+
+#define DO_FUNC(f) static typeof(f) * p_##f
+DBUS_FUNCS;
+#undef DO_FUNC
+
+static BOOL load_dbus(void)
+{
+    static int loaded = -1;
+    void *handle;
+
+    if (loaded != -1) return loaded;
+    loaded = 0;
+    if (!(handle = dlopen( SONAME_LIBDBUS_1, RTLD_NOW ))) return FALSE;
+#define DO_FUNC(f) if (!(p_##f = dlsym( handle, #f ))) return FALSE
+    DBUS_FUNCS;
+#undef DO_FUNC
+    loaded = 1;
+    return TRUE;
+}
+
+#define LOGIND_NAME  "org.freedesktop.login1"
+#define LOGIND_PATH  "/org/freedesktop/login1"
+#define LOGIND_IFACE "org.freedesktop.login1.Manager"
+
+/* a Manager method; with_bool adds the one boolean argument (interactive = false: no
+ * authentication dialog, polkit decides for the active local user) */
+static DBusMessage *call( DBusConnection *conn, const char *method, int with_bool, DBusError *err )
+{
+    DBusMessage *msg, *reply;
+
+    if (!(msg = p_dbus_message_new_method_call( LOGIND_NAME, LOGIND_PATH, LOGIND_IFACE, method ))) return NULL;
+    if (with_bool)
+    {
+        DBusMessageIter iter;
+        dbus_bool_t interactive = FALSE;
+
+        p_dbus_message_iter_init_append( msg, &iter );
+        p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_BOOLEAN, &interactive );
+    }
+    reply = p_dbus_connection_send_with_reply_and_block( conn, msg, 25000, err );
+    p_dbus_message_unref( msg );
+    return reply;
+}
+
+static int error_result( DBusError *err )
+{
+    if (!err->name) return SUSPEND_FAILED;
+    if (!strcmp( err->name, DBUS_ERROR_ACCESS_DENIED ) ||
+        !strcmp( err->name, "org.freedesktop.DBus.Error.InteractiveAuthorizationRequired" ))
+        return SUSPEND_DENIED;
+    if (!strcmp( err->name, DBUS_ERROR_SERVICE_UNKNOWN ) || !strcmp( err->name, DBUS_ERROR_NAME_HAS_NO_OWNER ) ||
+        !strcmp( err->name, DBUS_ERROR_NO_SERVER ) || !strcmp( err->name, DBUS_ERROR_DISCONNECTED ))
+        return SUSPEND_UNAVAILABLE;
+    return SUSPEND_FAILED;
+}
+
+/* waits up to timeout_s for PrepareForSleep(want) from logind; -1: until one comes */
+static BOOL wait_prepare_for_sleep( DBusConnection *conn, dbus_bool_t want, long timeout_s )
+{
+    time_t end = time( NULL ) + timeout_s;
+
+    while (timeout_s < 0 || time( NULL ) < end)
+    {
+        DBusMessage *msg;
+
+        while ((msg = p_dbus_connection_pop_message( conn )))
+        {
+            if (p_dbus_message_is_signal( msg, LOGIND_IFACE, "PrepareForSleep" ))
+            {
+                dbus_bool_t value = !want;
+                DBusError err;
+
+                p_dbus_error_init( &err );
+                if (p_dbus_message_get_args( msg, &err, DBUS_TYPE_BOOLEAN, &value, DBUS_TYPE_INVALID ) && value == want)
+                {
+                    p_dbus_message_unref( msg );
+                    return TRUE;
+                }
+                p_dbus_error_free( &err );
+            }
+            p_dbus_message_unref( msg );
+        }
+        if (!p_dbus_connection_read_write_dispatch( conn, 500 )) break;
+    }
+    return FALSE;
+}
+
+#ifdef SG_MUTANT_SUSPEND_HIBSWAP
+#define HIBERNATE_METHOD "Suspend"
+#else
+#define HIBERNATE_METHOD (hibernate ? "Hibernate" : "Suspend")
+#endif
+
+static int do_suspend( int hibernate )
+{
+    DBusConnection *conn;
+    DBusMessage *reply;
+    DBusError err;
+    const char *can = NULL;
+    int result;
+
+    if (!load_dbus()) return SUSPEND_UNAVAILABLE;
+    p_dbus_error_init( &err );
+    if (!(conn = p_dbus_bus_get_private( DBUS_BUS_SYSTEM, &err )))
+    {
+        p_dbus_error_free( &err );
+        return SUSPEND_UNAVAILABLE;
+    }
+    p_dbus_connection_set_exit_on_disconnect( conn, FALSE );
+
+    /* will it work: "yes", "challenge" (after authentication), "na" (not on this machine), "no" */
+    if (!(reply = call( conn, hibernate ? "CanHibernate" : "CanSuspend", 0, &err )))
+    {
+        result = error_result( &err );
+        goto done;
+    }
+    if (!p_dbus_message_get_args( reply, NULL, DBUS_TYPE_STRING, &can, DBUS_TYPE_INVALID )) can = NULL;
+    result = SUSPEND_OK;
+    if (!can) result = SUSPEND_FAILED;
+    else if (!strcmp( can, "na" )) result = SUSPEND_NOT_SUPPORTED;
+    else if (!strcmp( can, "no" )) result = SUSPEND_DENIED;
+    p_dbus_message_unref( reply );
+    if (result != SUSPEND_OK) goto done;
+
+    /* the machine is not back until PrepareForSleep(false) follows PrepareForSleep(true) */
+    p_dbus_bus_add_match( conn, "type='signal',interface='" LOGIND_IFACE "',member='PrepareForSleep'", NULL );
+    if (!(reply = call( conn, HIBERNATE_METHOD, 1, &err )))
+    {
+        result = error_result( &err );
+        goto done;
+    }
+    p_dbus_message_unref( reply );
+#ifndef SG_MUTANT_SUSPEND_NOWAIT
+    if (wait_prepare_for_sleep( conn, TRUE, 5 )) wait_prepare_for_sleep( conn, FALSE, -1 );
+#endif
+done:
+    if (p_dbus_error_is_set( &err )) p_dbus_error_free( &err );
+    p_dbus_connection_close( conn );
+    p_dbus_connection_unref( conn );
+    return result;
+}
+
+#endif /* SONAME_LIBDBUS_1 */
+
+static NTSTATUS suspend( void *args )
+{
+    struct suspend_params *params = args;
+
+#ifdef SONAME_LIBDBUS_1
+    params->result = do_suspend( params->hibernate );
+#else
+    params->result = SUSPEND_UNAVAILABLE;
+#endif
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    suspend,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    suspend,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
