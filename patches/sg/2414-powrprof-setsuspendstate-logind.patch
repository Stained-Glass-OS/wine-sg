+#include "wine/unixlib.h"
+
+enum suspend_result
+{
+    SUSPEND_OK,           /* suspended, and the machine is back */
+    SUSPEND_UNAVAILABLE,  /* no libdbus, or no system bus */
+    SUSPEND_NOT_SUPPORTED,/* logind says this machine cannot (CanSuspend / CanHibernate: "na") */
+    SUSPEND_DENIED,       /* logind or polkit refuses */
+    SUSPEND_FAILED,       /* any other error */
+};
+
+/* no pointers: the same for 32- and 64-bit callers */
+struct suspend_params
+{
+    int hibernate;   /* in: hibernate instead of suspend */
+    int result;      /* out: enum suspend_result */
+};
+
+enum powrprof_funcs
+{
+    unix_suspend,
+    unix_funcs_count
+};
