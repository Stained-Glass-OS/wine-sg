From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] iphlpapi: GetBestRoute2

GetBestRoute2 was a stub (ERROR_NOT_SUPPORTED). As documented now: of the
routes of the destination's family (GetIpForwardTable2) whose prefix holds
the destination, the longest wins, then the lowest route plus interface
metric; an interface LUID or index, or a source address (its interface),
limits the routes. The best source address is the given one, else an
address of the route's interface (not a link-local IPv6 address for a
destination beyond the link). No route: ERROR_NETWORK_UNREACHABLE.

Gate: test/bestroute-gate.sh (in a user and network namespace with two
dummy interfaces and their routes; test/bestroute-probe.c). Mutant
SG_MUTANT_NO_BEST_ROUTE (iphlpapi/iphlpapi_main.c).
---
--- a/dlls/iphlpapi/iphlpapi_main.c
+++ b/dlls/iphlpapi/iphlpapi_main.c
@@ -4991,21 +4991,155 @@ void WINAPI InitializeIpInterfaceEntry( MIB_IPINTERFACE_ROW *row )
 /******************************************************************
  *    GetBestRoute2 (IPHLPAPI.@)
  */
+/* Stained Glass OS 1690: does the route's prefix hold the address? */
+static BOOL route_matches( const MIB_IPFORWARD_ROW2 *row, const SOCKADDR_INET *dst )
+{
+    ULONG bits = row->DestinationPrefix.PrefixLength, i;
+    const BYTE *a, *b;
+
+    if (row->DestinationPrefix.Prefix.si_family != dst->si_family) return FALSE;
+    if (dst->si_family == AF_INET)
+    {
+        a = (const BYTE *)&row->DestinationPrefix.Prefix.Ipv4.sin_addr;
+        b = (const BYTE *)&dst->Ipv4.sin_addr;
+        if (bits > 32) return FALSE;
+    }
+    else
+    {
+        a = (const BYTE *)&row->DestinationPrefix.Prefix.Ipv6.sin6_addr;
+        b = (const BYTE *)&dst->Ipv6.sin6_addr;
+        if (bits > 128) return FALSE;
+    }
+    for (i = 0; i < bits / 8; i++) if (a[i] != b[i]) return FALSE;
+    if (bits % 8)
+    {
+        BYTE mask = 0xff << (8 - bits % 8);
+        if ((a[i] & mask) != (b[i] & mask)) return FALSE;
+    }
+    return TRUE;
+}
+
+static ULONG interface_metric( NET_LUID luid, ADDRESS_FAMILY family )
+{
+    MIB_IPINTERFACE_ROW row;
+
+    memset( &row, 0, sizeof(row) );
+    row.Family = family;
+    row.InterfaceLuid = luid;
+    if (GetIpInterfaceEntry( &row )) return 0;
+    return row.Metric;
+}
+
+/******************************************************************
+ *    GetBestRoute2 (IPHLPAPI.@)
+ *
+ * The route the system would take to a destination: the longest prefix
+ * that holds it, then the lowest route and interface metric, on the given
+ * interface (or the source address's) when one is given; and the source
+ * address the system would use, an address of that interface.
+ */
 DWORD WINAPI GetBestRoute2(NET_LUID *luid, NET_IFINDEX index,
                            const SOCKADDR_INET *source, const SOCKADDR_INET *destination,
                            ULONG options, PMIB_IPFORWARD_ROW2 bestroute,
                            SOCKADDR_INET *bestaddress)
 {
-    static int once;
+    MIB_IPFORWARD_TABLE2 *routes = NULL;
+    MIB_UNICASTIPADDRESS_TABLE *addrs = NULL;
+    const MIB_IPFORWARD_ROW2 *best = NULL;
+    ULONG best_metric = 0, i;
+    NET_LUID want = { 0 };
+    BOOL want_if = FALSE;
+    ADDRESS_FAMILY family;
+    DWORD ret;
 
-    if (!once++)
-        FIXME("(%p, %ld, %p, %p, 0x%08lx, %p, %p): stub\n", luid, index, source,
-                destination, options, bestroute, bestaddress);
+    TRACE("(%p, %ld, %p, %p, 0x%08lx, %p, %p)\n", luid, index, source, destination, options, bestroute, bestaddress);
 
     if (!destination || !bestroute || !bestaddress)
         return ERROR_INVALID_PARAMETER;
+    family = destination->si_family;
+    if (family != AF_INET && family != AF_INET6) return ERROR_INVALID_PARAMETER;
+
+    if (luid && luid->Value) { want = *luid; want_if = TRUE; }
+    else if (index)
+    {
+        if ((ret = ConvertInterfaceIndexToLuid( index, &want ))) return ret;
+        want_if = TRUE;
+    }
+
+    if ((ret = GetUnicastIpAddressTable( family, &addrs ))) return ret;
+    /* a source address: the interface it belongs to */
+    if (!want_if && source && source->si_family == family)
+    {
+        for (i = 0; i < addrs->NumEntries; i++)
+        {
+            const SOCKADDR_INET *a = &addrs->Table[i].Address;
+            if ((family == AF_INET && a->Ipv4.sin_addr.s_addr == source->Ipv4.sin_addr.s_addr) ||
+                (family == AF_INET6 && !memcmp( &a->Ipv6.sin6_addr, &source->Ipv6.sin6_addr, sizeof(IN6_ADDR) )))
+            {
+                want = addrs->Table[i].InterfaceLuid;
+                want_if = TRUE;
+                break;
+            }
+        }
+    }
 
+#ifdef SG_MUTANT_NO_BEST_ROUTE
+    FreeMibTable( addrs );
     return ERROR_NOT_SUPPORTED;
+#endif
+    if ((ret = GetIpForwardTable2( family, &routes )))
+    {
+        FreeMibTable( addrs );
+        return ret;
+    }
+    for (i = 0; i < routes->NumEntries; i++)
+    {
+        const MIB_IPFORWARD_ROW2 *row = &routes->Table[i];
+        ULONG metric;
+
+        if (want_if && row->InterfaceLuid.Value != want.Value) continue;
+        if (!route_matches( row, destination )) continue;
+        metric = row->Metric + interface_metric( row->InterfaceLuid, family );
+        if (!best || row->DestinationPrefix.PrefixLength > best->DestinationPrefix.PrefixLength ||
+            (row->DestinationPrefix.PrefixLength == best->DestinationPrefix.PrefixLength && metric < best_metric))
+        {
+            best = row;
+            best_metric = metric;
+        }
+    }
+    if (!best)
+    {
+        FreeMibTable( routes );
+        FreeMibTable( addrs );
+        return ERROR_NETWORK_UNREACHABLE;
+    }
+    *bestroute = *best;
+
+    /* the source: the given one, else an address of the route's interface */
+    memset( bestaddress, 0, sizeof(*bestaddress) );
+    ret = ERROR_NETWORK_UNREACHABLE;
+    if (source && source->si_family == family && want_if && (!luid || !luid->Value) && !index)
+    {
+        *bestaddress = *source;
+        ret = NO_ERROR;
+    }
+    else
+    {
+        for (i = 0; i < addrs->NumEntries; i++)
+        {
+            if (addrs->Table[i].InterfaceLuid.Value != best->InterfaceLuid.Value) continue;
+            /* a link-local IPv6 address only for a link-local destination */
+            if (family == AF_INET6 && IN6_IS_ADDR_LINKLOCAL( &addrs->Table[i].Address.Ipv6.sin6_addr ) &&
+                !IN6_IS_ADDR_LINKLOCAL( &destination->Ipv6.sin6_addr ) && ret == NO_ERROR)
+                continue;
+            *bestaddress = addrs->Table[i].Address;
+            ret = NO_ERROR;
+            if (!(family == AF_INET6 && IN6_IS_ADDR_LINKLOCAL( &bestaddress->Ipv6.sin6_addr ))) break;
+        }
+    }
+    FreeMibTable( routes );
+    FreeMibTable( addrs );
+    return ret;
 }
 
 /******************************************************************
