From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:23:25 -0700
Subject: [PATCH] prntvpt: PTQuerySchemaVersionSupport (3243)

Returns the Print Schema version of an existing queue (1, the only version,
as PTOpenProvider accepts) and the HRESULT of OpenPrinter for an unknown
queue; NULL arguments are E_INVALIDARG.

diff --git a/dlls/prntvpt/main.c b/dlls/prntvpt/main.c
index 90b907f..766dcab 100644
--- a/dlls/prntvpt/main.c
+++ b/dlls/prntvpt/main.c
@@ -40,8 +40,22 @@ HRESULT WINAPI PTReleaseMemory(PVOID mem)
 
 HRESULT WINAPI PTQuerySchemaVersionSupport(PCWSTR printer, DWORD *version)
 {
-    FIXME("stub:%s %p\n", debugstr_w(printer), version);
-    return E_NOTIMPL;
+    HANDLE hprinter;
+
+    TRACE("%s, %p\n", debugstr_w(printer), version);
+
+#ifndef SG_MUTANT_PTV_NOARGS
+    if (!printer || !version) return E_INVALIDARG;
+#endif
+
+    /* the queue has to exist; the Print Schema is at version 1, the only one there is */
+    if (!OpenPrinterW((WCHAR *)printer, &hprinter, NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    ClosePrinter(hprinter);
+#ifdef SG_MUTANT_PTV_NOVER
+    return S_OK;
+#endif
+    *version = 1;
+    return S_OK;
 }
 
 HRESULT WINAPI PTCloseProvider(HPTPROVIDER provider)
