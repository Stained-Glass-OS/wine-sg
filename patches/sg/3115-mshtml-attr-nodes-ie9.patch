From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 22:48:24 -0700
Subject: [PATCH] mshtml: setAttributeNode and setNamedItem in document mode 9+

In IE9 and later modes an attribute lives in the DOM, so getAttribute
read nothing after setAttributeNode or attributes.setNamedItem put the
node's value on the expando only. The value is now also written to the DOM
attribute, and a later change of the node's value follows. When the attribute
already exists in the DOM (set by setAttribute or the markup),
setAttributeNode returns the attribute it replaces, with the old value.

diff --git a/dlls/mshtml/htmlattr.c b/dlls/mshtml/htmlattr.c
index 6139d04..1a14ddd 100644
--- a/dlls/mshtml/htmlattr.c
+++ b/dlls/mshtml/htmlattr.c
@@ -62,6 +62,7 @@ static HRESULT WINAPI HTMLDOMAttribute_put_nodeValue(IHTMLDOMAttribute *iface, V
 {
     HTMLDOMAttribute *This = impl_from_IHTMLDOMAttribute(iface);
     EXCEPINFO ei;
+    HRESULT hres;
 
     TRACE("(%p)->(%s)\n", This, debugstr_variant(&v));
 
@@ -69,7 +70,10 @@ static HRESULT WINAPI HTMLDOMAttribute_put_nodeValue(IHTMLDOMAttribute *iface, V
         return VariantCopy(&This->value, &v);
 
     memset(&ei, 0, sizeof(ei));
-    return dispex_prop_put(&This->elem->node.event_target.dispex, This->dispid, LOCALE_SYSTEM_DEFAULT, &v, &ei, NULL);
+    hres = dispex_prop_put(&This->elem->node.event_target.dispex, This->dispid, LOCALE_SYSTEM_DEFAULT, &v, &ei, NULL);
+    if(SUCCEEDED(hres))
+        mirror_expando_attr_to_dom(This->elem, This->dispid, &v);
+    return hres;
 }
 
 static HRESULT WINAPI HTMLDOMAttribute_get_nodeValue(IHTMLDOMAttribute *iface, VARIANT *p)
diff --git a/dlls/mshtml/htmlelem.c b/dlls/mshtml/htmlelem.c
index e8369b8..8bf622e 100644
--- a/dlls/mshtml/htmlelem.c
+++ b/dlls/mshtml/htmlelem.c
@@ -1248,6 +1248,52 @@ static HRESULT set_elem_attr_value_by_dispid(HTMLElement *elem, DISPID dispid, V
     return dispex_prop_put(&elem->node.event_target.dispex, dispid, LOCALE_SYSTEM_DEFAULT, v, &ei, NULL);
 }
 
+HRESULT mirror_expando_attr_to_dom(HTMLElement *elem, DISPID dispid, VARIANT *v)
+{
+    nsAString name_str, value_str;
+    VARIANT str;
+    nsresult nsres;
+    BSTR name;
+    HRESULT hres;
+
+    /* In document mode 9+ attributes live in the DOM, so getAttribute and the
+     * attributes of the element see what an attribute node holds. */
+#ifdef SG_MUTANT_ATTRMIRROR
+    return S_OK;
+#endif
+    if(!elem->dom_element || dispex_compat_mode(&elem->node.event_target.dispex) < COMPAT_MODE_IE9
+       || get_dispid_type(dispid) == DISPEXPROP_BUILTIN)
+        return S_OK;
+
+    V_VT(&str) = VT_EMPTY;
+    if(V_VT(v) == VT_BSTR || V_VT(v) == VT_NULL || V_VT(v) == VT_EMPTY) {
+        hres = VariantCopy(&str, v);
+    }else {
+        hres = VariantChangeTypeEx(&str, v, MAKELCID(MAKELANGID(LANG_ENGLISH,SUBLANG_ENGLISH_US),SORT_DEFAULT),
+                                   0, VT_BSTR);
+    }
+    if(FAILED(hres))
+        return hres;
+
+    hres = dispex_prop_name(&elem->node.event_target.dispex, dispid, &name);
+    if(FAILED(hres)) {
+        VariantClear(&str);
+        return hres;
+    }
+
+    hres = variant_to_nsstr(&str, FALSE, &value_str);
+    if(SUCCEEDED(hres)) {
+        nsAString_InitDepend(&name_str, name);
+        nsres = nsIDOMElement_SetAttribute(elem->dom_element, &name_str, &value_str);
+        nsAString_Finish(&name_str);
+        nsAString_Finish(&value_str);
+        hres = map_nsresult(nsres);
+    }
+    SysFreeString(name);
+    VariantClear(&str);
+    return hres;
+}
+
 static HRESULT WINAPI HTMLElement_setAttribute(IHTMLElement *iface, BSTR strAttributeName,
                                                VARIANT AttributeValue, LONG lFlags)
 {
@@ -4832,6 +4878,7 @@ static HRESULT WINAPI HTMLElement4_setAttributeNode(IHTMLElement4 *iface, IHTMLD
     HTMLElement *This = impl_from_IHTMLElement4(iface);
     HTMLDOMAttribute *attr, *iter, *replace = NULL;
     HTMLAttributeCollection *attrs;
+    BOOL dom_has_attr;
     DISPID dispid;
     HRESULT hres;
 
@@ -4861,8 +4908,45 @@ static HRESULT WINAPI HTMLElement4_setAttributeNode(IHTMLElement4 *iface, IHTMLD
         }
     }
 
+    /* Document mode 9+: an attribute set with setAttribute or parsed from the markup lives only
+     * in the DOM; it is the one that setAttributeNode replaces. */
+    dom_has_attr = FALSE;
+    if(This->dom_element && dispex_compat_mode(&This->node.event_target.dispex) >= COMPAT_MODE_IE9
+       && attr->name && get_dispid_type(dispid) != DISPEXPROP_BUILTIN) {
+        nsIDOMAttr *nsattr = NULL;
+        nsAString nsname;
+
+        nsAString_InitDepend(&nsname, attr->name);
+        nsIDOMElement_GetAttributeNode(This->dom_element, &nsname, &nsattr);
+        nsAString_Finish(&nsname);
+        if(nsattr) {
+            nsIDOMAttr_Release(nsattr);
+            dom_has_attr = TRUE;
+        }
+    }
+    if(!replace && dom_has_attr) {
+        hres = HTMLDOMAttribute_Create(attr->name, This, dispid, This->node.doc, &replace);
+        if(FAILED(hres)) {
+            IHTMLAttributeCollection_Release(&attrs->IHTMLAttributeCollection_iface);
+            return hres;
+        }
+    }
+
     if(replace) {
-        hres = get_elem_attr_value_by_dispid(This, dispid, &replace->value);
+        if(dom_has_attr) {
+            nsAString nsname, nsvalue;
+
+            nsAString_InitDepend(&nsname, attr->name);
+            nsAString_InitDepend(&nsvalue, NULL);
+            if(NS_SUCCEEDED(nsIDOMElement_GetAttribute(This->dom_element, &nsname, &nsvalue))
+               && SUCCEEDED(return_nsstr_variant(NS_OK, &nsvalue, 0, &replace->value)))
+                hres = S_OK;
+            else
+                hres = E_FAIL;
+            nsAString_Finish(&nsname);
+        }else {
+            hres = get_elem_attr_value_by_dispid(This, dispid, &replace->value);
+        }
         if(FAILED(hres)) {
             WARN("could not get attr value: %08lx\n", hres);
             V_VT(&replace->value) = VT_EMPTY;
@@ -4888,6 +4972,8 @@ static HRESULT WINAPI HTMLElement4_setAttributeNode(IHTMLElement4 *iface, IHTMLD
     hres = set_elem_attr_value_by_dispid(This, dispid, &attr->value);
     if(FAILED(hres))
         WARN("Could not set attribute value: %08lx\n", hres);
+    else
+        mirror_expando_attr_to_dom(This, dispid, &attr->value);
     VariantClear(&attr->value);
 
     *ppretAttribute = replace ? &replace->IHTMLDOMAttribute_iface : NULL;
diff --git a/dlls/mshtml/mshtml_private.h b/dlls/mshtml/mshtml_private.h
index 2d2bf54..4678268 100644
--- a/dlls/mshtml/mshtml_private.h
+++ b/dlls/mshtml/mshtml_private.h
@@ -1065,6 +1065,7 @@ typedef struct {
     WCHAR *filter;
     unsigned unique_id;
 } HTMLElement;
+HRESULT mirror_expando_attr_to_dom(HTMLElement*,DISPID,VARIANT*);
 
 extern cp_static_data_t HTMLElementEvents2_data;
 #define HTMLELEMENT_CPC {&DIID_HTMLElementEvents2, &HTMLElementEvents2_data}
