+static D3DVECTOR face_vec(float x, float y, float z)
+{
+    D3DVECTOR v;
+
+    v.x = x;
+    v.y = y;
+    v.z = z;
+    return v;
+}
+
+static HRESULT face_add_vertex(struct d3drm_face *face, float x, float y, float z)
+{
+    if (!d3drm_array_reserve((void **)&face->vertices, &face->vertices_size, face->nb_vertices + 1,
+            sizeof(*face->vertices)))
+        return E_OUTOFMEMORY;
+    memset(&face->vertices[face->nb_vertices], 0, sizeof(*face->vertices));
+    face->vertices[face->nb_vertices].position = face_vec(x, y, z);
+    ++face->nb_vertices;
+    return D3DRM_OK;
+}
+
+/* The normal of a face: of the plane of its first three vertices. */
+static D3DVECTOR face_normal(const struct d3drm_face *face)
+{
+    D3DVECTOR a, b, n;
+
+    if (face->nb_vertices < 3)
+        return face_vec(0.0f, 0.0f, 0.0f);
+    a = face_vec(face->vertices[1].position.x - face->vertices[0].position.x,
+            face->vertices[1].position.y - face->vertices[0].position.y,
+            face->vertices[1].position.z - face->vertices[0].position.z);
+    b = face_vec(face->vertices[2].position.x - face->vertices[0].position.x,
+            face->vertices[2].position.y - face->vertices[0].position.y,
+            face->vertices[2].position.z - face->vertices[0].position.z);
+#ifdef SG_MUTANT_DRMFACE_NORMAL_FLIP
+    D3DRMVectorCrossProduct(&n, &b, &a);
+#else
+    D3DRMVectorCrossProduct(&n, &a, &b);
+#endif
+    if (n.x == 0.0f && n.y == 0.0f && n.z == 0.0f)
+        return n;
+    D3DRMVectorNormalize(&n);
+    return n;
+}
+
+static HRESULT face_get_vertex(struct d3drm_face *face, DWORD index, D3DVECTOR *vertex, D3DVECTOR *normal)
+{
+#ifndef SG_MUTANT_DRMFACE_NO_BOUNDS
+    if (index >= face->nb_vertices)
+        return D3DRMERR_BADVALUE;
+#endif
+    if (vertex)
+        *vertex = face->vertices[index].position;
+    if (normal)
+        *normal = face_normal(face);
+    return D3DRM_OK;
+}
+
+static HRESULT face_get_vertices(struct d3drm_face *face, DWORD *count, D3DVECTOR *coords, D3DVECTOR *normals)
+{
+    DWORD i;
+
+    if (!count)
+        return D3DRMERR_BADVALUE;
+    if (!coords && !normals)
+    {
+        *count = face->nb_vertices;
+        return D3DRM_OK;
+    }
+    if (*count < face->nb_vertices)
+    {
+        *count = face->nb_vertices;
+        return D3DRMERR_BADVALUE;
+    }
+    for (i = 0; i < face->nb_vertices; ++i)
+    {
+        if (coords)
+            coords[i] = face->vertices[i].position;
+        if (normals)
+            normals[i] = face_normal(face);
+    }
+    *count = face->nb_vertices;
+    return D3DRM_OK;
+}
+
+static HRESULT face_set_texture(struct d3drm_face *face, IDirect3DRMTexture3 *texture)
+{
+    if (texture)
+        IDirect3DRMTexture3_AddRef(texture);
+    if (face->texture)
+        IDirect3DRMTexture3_Release(face->texture);
+    face->texture = texture;
+    return D3DRM_OK;
+}
+
+static HRESULT face_set_material(struct d3drm_face *face, IDirect3DRMMaterial2 *material)
+{
+#ifndef SG_MUTANT_DRMFACE_NO_REF
+    if (material)
+        IDirect3DRMMaterial2_AddRef(material);
+#endif
+    if (face->material)
+        IDirect3DRMMaterial2_Release(face->material);
+    face->material = material;
+    return D3DRM_OK;
+}
