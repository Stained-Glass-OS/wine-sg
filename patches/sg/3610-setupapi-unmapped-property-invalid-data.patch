From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] setupapi: a device property Windows knows but the device lacks is ERROR_INVALID_DATA (3610)

setupapi: a device property Windows knows but the device lacks is ERROR_INVALID_DATA

SetupDiGetDeviceRegistryProperty A/W answered ERROR_INVALID_REG_PROPERTY for every
property number without a registry mapping (SPDRP_DEVTYPE, SECURITY, REMOVAL_POLICY,
ENUMERATOR_NAME, ...). Windows (ntoskrnl test, ntoskrnl.c:1633) fails those with
ERROR_INVALID_DATA; only unused and out-of-range numbers are ERROR_INVALID_REG_PROPERTY.
Regression of 2051 against stock (which left the earlier ERROR_INVALID_DATA in place).
---
diff --git a/dlls/setupapi/devinst.c b/dlls/setupapi/devinst.c
index a624ec9..3d5a002 100644
--- a/dlls/setupapi/devinst.c
+++ b/dlls/setupapi/devinst.c
@@ -3353,6 +3353,19 @@ BOOL WINAPI SetupDiGetDeviceInterfaceDetailW(HDEVINFO devinfo, SP_DEVICE_INTERFA
     return ret;
 }
 
+/* A property Windows knows but the device does not have fails with ERROR_INVALID_DATA, only an
+ * unknown (or unused) property number is ERROR_INVALID_REG_PROPERTY. */
+static DWORD unmapped_property_error(DWORD prop)
+{
+#ifdef SG_MUTANT_UNMAPPED_PROP
+    return ERROR_INVALID_REG_PROPERTY;
+#else
+    if (prop < SPDRP_MAXIMUM_PROPERTY && prop != SPDRP_UNUSED0 && prop != SPDRP_UNUSED1 && prop != SPDRP_UNUSED2)
+        return ERROR_INVALID_DATA;
+    return ERROR_INVALID_REG_PROPERTY;
+#endif
+}
+
 /***********************************************************************
  *		SetupDiGetDeviceRegistryPropertyA (SETUPAPI.@)
  */
@@ -3393,7 +3406,7 @@ BOOL WINAPI SetupDiGetDeviceRegistryPropertyA(HDEVINFO devinfo,
             *RequiredSize = size;
     }
     else
-        SetLastError(ERROR_INVALID_REG_PROPERTY);
+        SetLastError(unmapped_property_error(Property));
     return ret;
 }
 
@@ -3438,7 +3451,7 @@ BOOL WINAPI SetupDiGetDeviceRegistryPropertyW(HDEVINFO devinfo,
     }
 #ifndef SG_MUTANT_DEVPROP_INVALID
     else
-        SetLastError(ERROR_INVALID_REG_PROPERTY);
+        SetLastError(unmapped_property_error(Property));
 #endif
     return ret;
 }
