+/* unix pid of another process, from one of its threads */
+static int get_process_unix_pid( HANDLE handle )
+{
+    int unix_pid = -1;
+    HANDLE thread;
+
+    if (!NtGetNextThread( handle, 0, THREAD_QUERY_LIMITED_INFORMATION, 0, 0, &thread ))
+    {
+        SERVER_START_REQ( get_thread_times )
+        {
+            req->handle = wine_server_obj_handle( thread );
+            if (!wine_server_call( req )) unix_pid = reply->unix_pid;
+        }
+        SERVER_END_REQ;
+        NtClose( thread );
+    }
+    return unix_pid;
+}
+
+/* User and kernel time of any process. Task managers and browsers' own task
+ * managers read other processes' times; they used to get the caller's. */
+static void get_process_cpu_times( HANDLE handle, process_id_t pid, LARGE_INTEGER *kernel, LARGE_INTEGER *user )
+{
+    long ticks = sysconf( _SC_CLK_TCK );
+    struct tms tms;
+    int unix_pid;
+
+    kernel->QuadPart = user->QuadPart = 0;
+#ifndef SG_MUTANT_PROCTIMES_SELF
+    if (handle != GetCurrentProcess() && pid != GetCurrentProcessId())
+    {
+        if ((unix_pid = get_process_unix_pid( handle )) != -1)
+            get_thread_times( unix_pid, -1, kernel, user );
+        else
+        {
+            /* the handle may not enumerate threads; the process list has the times */
+            SYSTEM_PROCESS_INFORMATION *spi, *buf = NULL;
+            ULONG buf_size = 0x10000;
+            NTSTATUS status;
+
+            for (;;)
+            {
+                if (!(buf = malloc( buf_size ))) return;
+                status = NtQuerySystemInformation( SystemProcessInformation, buf, buf_size, NULL );
+                if (status != STATUS_INFO_LENGTH_MISMATCH) break;
+                free( buf );
+                buf_size *= 2;
+            }
+            for (spi = buf; !status; spi = (SYSTEM_PROCESS_INFORMATION *)((char *)spi + spi->NextEntryOffset))
+            {
+                if (HandleToULong( spi->UniqueProcessId ) == pid)
+                {
+                    *kernel = spi->KernelTime;
+                    *user = spi->UserTime;
+                    break;
+                }
+                if (!spi->NextEntryOffset) break;
+            }
+            free( buf );
+        }
+        return;
+    }
+#endif
+    if (ticks && times( &tms ) != -1)
+    {
+        user->QuadPart = (ULONGLONG)tms.tms_utime * 10000000 / ticks;
+        kernel->QuadPart = (ULONGLONG)tms.tms_stime * 10000000 / ticks;
+    }
+}
