+                ns = (kernel.QuadPart + user.QuadPart) * 100;
+        }
+        cycles.AccumulatedCycles = cycles_from_ns( ns );
+        cycles.CurrentCycleCount = 0;
+        if (!data) return STATUS_ACCESS_VIOLATION;
+        memcpy( data, &cycles, sizeof(cycles) );
+        if (ret_len) *ret_len = sizeof(cycles);
