--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -1367,6 +1367,56 @@ static void init_tsc_frequency(void)
 
 #endif
 
+/* Windows' cycle counts (QueryThreadCycleTime, QueryProcessCycleTime, the idle
+ * cycle times) tick at the time stamp counter's rate. Programs turn them back
+ * into time with their own TSC calibration (Chrome's ThreadTicks), so the
+ * nominal frequency is used when cpufreq has it, else the TSC is measured. */
+#ifndef SG_MUTANT_NO_TSC_FREQ
+ULONG64 get_tsc_frequency(void)
+{
+    static ULONG64 frequency;
+    unsigned long khz;
+    FILE *f;
+
+    if (frequency) return frequency;
+    if ((f = fopen( "/sys/devices/system/cpu/cpu0/cpufreq/base_frequency", "r" )))
+    {
+        if (fscanf( f, "%lu", &khz ) == 1 && khz) frequency = (ULONG64)khz * 1000;
+        fclose( f );
+    }
+#if defined(__i386__) || defined(__x86_64__)
+    if (!frequency)
+    {
+        struct timespec start, now;
+        ULONG64 tsc_start, tsc_end, ns;
+
+        clock_gettime( CLOCK_MONOTONIC, &start );
+        tsc_start = __builtin_ia32_rdtsc();
+        do
+        {
+            clock_gettime( CLOCK_MONOTONIC, &now );
+            ns = (now.tv_sec - start.tv_sec) * 1000000000ull + now.tv_nsec - start.tv_nsec;
+        } while (ns < 2000000);
+        tsc_end = __builtin_ia32_rdtsc();
+        frequency = (tsc_end - tsc_start) * 1000000000ull / ns;
+        /* to the nearest MHz, as the nominal rate is */
+        frequency = (frequency + 500000) / 1000000 * 1000000;
+    }
+#endif
+    if (!frequency) frequency = 1000000000;  /* no TSC: one cycle per nanosecond */
+    return frequency;
+}
+#else
+ULONG64 get_tsc_frequency(void) { return 0; }
+#endif
+
+/* nanoseconds of CPU time as TSC cycles */
+ULONG64 cycles_from_ns( ULONG64 ns )
+{
+    ULONG64 frequency = get_tsc_frequency();
+    return ns / 1000000000 * frequency + ns % 1000000000 * frequency / 1000000000;
+}
