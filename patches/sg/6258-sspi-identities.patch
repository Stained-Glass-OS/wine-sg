From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sspicli, secur32: SSPI identities copied, compared, marshalled and validated

OneDrive's sync session code imports SspiCopyAuthIdentity, SspiCompareAuthIdentities, SspiMarshalAuthIdentity and SspiUnmarshalAuthIdentity from secur32, which Wine had as stubs in sspicli and not at all in secur32. They are implemented, with SspiValidateAuthIdentity and SspiIsAuthIdentityEncrypted, for the identities SspiEncodeStringsAsAuthIdentity makes, SEC_WINNT_AUTH_IDENTITY_EXW and the packed SEC_WINNT_AUTH_IDENTITY_EX2 form that marshalling produces (a password credential after the header), and secur32 forwards them.
---
diff --git a/dlls/secur32/secur32.spec b/dlls/secur32/secur32.spec
index 061f8c6..c9b0ed9 100644
--- a/dlls/secur32/secur32.spec
+++ b/dlls/secur32/secur32.spec
@@ -71,11 +71,17 @@
 @ stub SecpTranslateNameEx
 @ stdcall SetContextAttributesA(ptr long ptr long)
 @ stdcall SetContextAttributesW(ptr long ptr long)
+@ stdcall SspiCompareAuthIdentities(ptr ptr ptr ptr) sspicli.SspiCompareAuthIdentities
+@ stdcall SspiCopyAuthIdentity(ptr ptr) sspicli.SspiCopyAuthIdentity
 @ stdcall SspiEncodeAuthIdentityAsStrings(ptr ptr ptr ptr) sspicli.SspiEncodeAuthIdentityAsStrings
 @ stdcall SspiEncodeStringsAsAuthIdentity(wstr wstr wstr ptr) sspicli.SspiEncodeStringsAsAuthIdentity
 @ stdcall SspiFreeAuthIdentity(ptr) sspicli.SspiFreeAuthIdentity
+@ stdcall SspiIsAuthIdentityEncrypted(ptr) sspicli.SspiIsAuthIdentityEncrypted
+@ stdcall SspiMarshalAuthIdentity(ptr ptr ptr) sspicli.SspiMarshalAuthIdentity
 @ stdcall SspiLocalFree(ptr) sspicli.SspiLocalFree
 @ stdcall SspiPrepareForCredWrite(ptr wstr ptr ptr ptr ptr ptr) sspicli.SspiPrepareForCredWrite
+@ stdcall SspiUnmarshalAuthIdentity(long ptr ptr) sspicli.SspiUnmarshalAuthIdentity
+@ stdcall SspiValidateAuthIdentity(ptr) sspicli.SspiValidateAuthIdentity
 @ stdcall SspiZeroAuthIdentity(ptr) sspicli.SspiZeroAuthIdentity
 @ stdcall TranslateNameA(str long long ptr ptr)
 @ stdcall TranslateNameW(wstr long long ptr ptr)
diff --git a/dlls/sspicli/main.c b/dlls/sspicli/main.c
index 2190fc5..dd9dfd1 100644
--- a/dlls/sspicli/main.c
+++ b/dlls/sspicli/main.c
@@ -188,3 +188,283 @@ SECURITY_STATUS SEC_ENTRY SspiPrepareForCredWrite( PSEC_WINNT_AUTH_IDENTITY_OPAQ
 
     return SEC_E_OK;
 }
+
+/* ---- Stained Glass OS 6258: copying, comparing and (un)marshalling identities ----
+ * An identity is ours (SEC_WINNT_AUTH_IDENTITY_W, from SspiEncodeStringsAsAuthIdentity),
+ * a SEC_WINNT_AUTH_IDENTITY_EXW (version 0x200) or a packed SEC_WINNT_AUTH_IDENTITY_EX2
+ * (version 0x201, the marshalled form: Unicode strings and a password credential after
+ * the header, at offsets from its start).  OneDrive's sync session code uses them all. */
+
+#define AUTH_IDENTITY_VERSION   0x200
+#define AUTH_IDENTITY_VERSION_2 0x201
+#ifndef SEC_WINNT_AUTH_IDENTITY_MARSHALLED
+#define SEC_WINNT_AUTH_IDENTITY_MARSHALLED 0x4
+#endif
+
+struct ex2_header
+{
+    ULONG Version;
+    USHORT cbHeaderLength;
+    ULONG cbStructureLength;
+    ULONG UserOffset;
+    USHORT UserLength;
+    ULONG DomainOffset;
+    USHORT DomainLength;
+    ULONG PackedCredentialsOffset;
+    USHORT PackedCredentialsLength;
+    ULONG Flags;
+    ULONG PackageListOffset;
+    USHORT PackageListLength;
+};
+
+struct packed_credentials
+{
+    USHORT cbHeaderLength;
+    USHORT cbStructureLength;
+    GUID CredType;
+    ULONG ByteArrayOffset;      /* from the start of this structure */
+    USHORT ByteArrayLength;
+};
+
+struct exw_identity
+{
+    ULONG Version, Length;
+    WCHAR *User;
+    ULONG UserLength;
+    WCHAR *Domain;
+    ULONG DomainLength;
+    WCHAR *Password;
+    ULONG PasswordLength;
+    ULONG Flags;
+    WCHAR *PackageList;
+    ULONG PackageListLength;
+};
+
+static const GUID auth_data_type_password = { 0x28bfc32f, 0x10f6, 0x4738, { 0x98, 0xd1, 0x1a, 0xc0, 0x61, 0xdf, 0x71, 0x6a } };
+
+struct id_strings
+{
+    const WCHAR *user, *domain, *password;
+    ULONG user_len, domain_len, password_len;   /* in characters */
+};
+
+static BOOL id_strings_get( const void *opaque, ULONG size, struct id_strings *s )
+{
+    ULONG version;
+
+    memset( s, 0, sizeof(*s) );
+    if (!opaque) return FALSE;
+    version = *(const ULONG *)opaque;
+    if (version == AUTH_IDENTITY_VERSION_2)
+    {
+        const struct ex2_header *h = opaque;
+        const BYTE *base = opaque;
+
+        if (!size) size = h->cbStructureLength;
+        if (h->cbHeaderLength < sizeof(*h) || size < h->cbHeaderLength || h->cbStructureLength > size) return FALSE;
+        if (!(h->Flags & SEC_WINNT_AUTH_IDENTITY_UNICODE) && (h->UserLength || h->DomainLength)) return FALSE;
+        if ((ULONGLONG)h->UserOffset + h->UserLength > size || (ULONGLONG)h->DomainOffset + h->DomainLength > size ||
+            (ULONGLONG)h->PackedCredentialsOffset + h->PackedCredentialsLength > size) return FALSE;
+        if (h->UserLength) { s->user = (const WCHAR *)(base + h->UserOffset); s->user_len = h->UserLength / sizeof(WCHAR); }
+        if (h->DomainLength) { s->domain = (const WCHAR *)(base + h->DomainOffset); s->domain_len = h->DomainLength / sizeof(WCHAR); }
+        if (h->PackedCredentialsLength >= sizeof(struct packed_credentials))
+        {
+            const struct packed_credentials *p = (const struct packed_credentials *)(base + h->PackedCredentialsOffset);
+            if (IsEqualGUID( &p->CredType, &auth_data_type_password ) &&
+                (ULONGLONG)p->ByteArrayOffset + p->ByteArrayLength <= h->PackedCredentialsLength)
+            {
+                s->password = (const WCHAR *)((const BYTE *)p + p->ByteArrayOffset);
+                s->password_len = p->ByteArrayLength / sizeof(WCHAR);
+            }
+        }
+        return TRUE;
+    }
+    if (version == AUTH_IDENTITY_VERSION)
+    {
+        const struct exw_identity *e = opaque;
+        if (!(e->Flags & SEC_WINNT_AUTH_IDENTITY_UNICODE)) return FALSE;
+        s->user = e->User; s->user_len = e->User ? e->UserLength : 0;
+        s->domain = e->Domain; s->domain_len = e->Domain ? e->DomainLength : 0;
+        s->password = e->Password; s->password_len = e->Password ? e->PasswordLength : 0;
+        return TRUE;
+    }
+    {
+        const SEC_WINNT_AUTH_IDENTITY_W *w = opaque;
+        s->user = w->User; s->user_len = w->User ? w->UserLength : 0;
+        s->domain = w->Domain; s->domain_len = w->Domain ? w->DomainLength : 0;
+        s->password = w->Password; s->password_len = w->Password ? w->PasswordLength : 0;
+        return TRUE;
+    }
+}
+
+/* a SEC_WINNT_AUTH_IDENTITY_W of counted strings (like SspiEncodeStringsAsAuthIdentity's) */
+static SECURITY_STATUS id_from_strings( const struct id_strings *s, PSEC_WINNT_AUTH_IDENTITY_OPAQUE *out )
+{
+    SEC_WINNT_AUTH_IDENTITY_W *id;
+    WCHAR *ptr;
+    SIZE_T size = sizeof(*id) + (s->user_len + s->domain_len + s->password_len + 3) * sizeof(WCHAR);
+
+    if (!(id = calloc( 1, size ))) return SEC_E_INSUFFICIENT_MEMORY;
+    ptr = (WCHAR *)(id + 1);
+    id->Flags = SEC_WINNT_AUTH_IDENTITY_UNICODE;
+    if (s->user)
+    {
+        memcpy( ptr, s->user, s->user_len * sizeof(WCHAR) );
+        id->User = ptr;
+        id->UserLength = s->user_len;
+        ptr += s->user_len + 1;
+    }
+    if (s->domain)
+    {
+        memcpy( ptr, s->domain, s->domain_len * sizeof(WCHAR) );
+        id->Domain = ptr;
+        id->DomainLength = s->domain_len;
+        ptr += s->domain_len + 1;
+    }
+    if (s->password)
+    {
+        memcpy( ptr, s->password, s->password_len * sizeof(WCHAR) );
+        id->Password = ptr;
+        id->PasswordLength = s->password_len;
+    }
+    *out = id;
+    return SEC_E_OK;
+}
+
+/***********************************************************************
+ *		SspiCopyAuthIdentity (SSPICLI.@)
+ */
+SECURITY_STATUS SEC_ENTRY SspiCopyAuthIdentity( PSEC_WINNT_AUTH_IDENTITY_OPAQUE opaque_id,
+                                                PSEC_WINNT_AUTH_IDENTITY_OPAQUE *copy )
+{
+    struct id_strings s;
+
+    TRACE( "%p %p\n", opaque_id, copy );
+
+    if (!copy) return SEC_E_INVALID_PARAMETER;
+    *copy = NULL;
+    if (!id_strings_get( opaque_id, 0, &s )) return SEC_E_INVALID_TOKEN;
+    return id_from_strings( &s, copy );
+}
+
+static BOOL counted_equal( const WCHAR *a, ULONG alen, const WCHAR *b, ULONG blen, BOOL nocase )
+{
+    if (alen != blen) return FALSE;
+    if (!alen) return TRUE;
+    if (nocase) return CompareStringOrdinal( a, alen, b, blen, TRUE ) == CSTR_EQUAL;
+    return !memcmp( a, b, alen * sizeof(WCHAR) );
+}
+
+/***********************************************************************
+ *		SspiCompareAuthIdentities (SSPICLI.@)
+ */
+SECURITY_STATUS SEC_ENTRY SspiCompareAuthIdentities( PSEC_WINNT_AUTH_IDENTITY_OPAQUE id1,
+                                                     PSEC_WINNT_AUTH_IDENTITY_OPAQUE id2,
+                                                     BOOLEAN *same_user, BOOLEAN *same_identity )
+{
+    struct id_strings a, b;
+    BOOL user;
+
+    TRACE( "%p %p %p %p\n", id1, id2, same_user, same_identity );
+
+    if (!id_strings_get( id1, 0, &a ) || !id_strings_get( id2, 0, &b )) return SEC_E_INVALID_TOKEN;
+    user = counted_equal( a.user, a.user_len, b.user, b.user_len, TRUE ) &&
+           counted_equal( a.domain, a.domain_len, b.domain, b.domain_len, TRUE );
+#ifdef SG_MUTANT_COMPARE_IGNORES_PASSWORD
+    if (same_user) *same_user = user;
+    if (same_identity) *same_identity = user;
+    return SEC_E_OK;
+#endif
+    if (same_user) *same_user = user;
+    if (same_identity) *same_identity = user && counted_equal( a.password, a.password_len, b.password, b.password_len, FALSE );
+    return SEC_E_OK;
+}
+
+/***********************************************************************
+ *		SspiMarshalAuthIdentity (SSPICLI.@)
+ *
+ * The identity as one packed SEC_WINNT_AUTH_IDENTITY_EX2 buffer (freed with SspiLocalFree).
+ */
+SECURITY_STATUS SEC_ENTRY SspiMarshalAuthIdentity( PSEC_WINNT_AUTH_IDENTITY_OPAQUE opaque_id,
+                                                   ULONG *length, char **bytes )
+{
+    struct packed_credentials *p;
+    struct ex2_header *h;
+    struct id_strings s;
+    ULONG size, user = 0, domain, packed;
+    BYTE *buf;
+
+    TRACE( "%p %p %p\n", opaque_id, length, bytes );
+
+    if (!length || !bytes) return SEC_E_INVALID_PARAMETER;
+    if (!id_strings_get( opaque_id, 0, &s )) return SEC_E_INVALID_TOKEN;
+    if (s.user_len > 0x7fff || s.domain_len > 0x7fff || s.password_len > 0x7fff) return SEC_E_INVALID_TOKEN;
+    user = sizeof(*h);
+    domain = user + s.user_len * sizeof(WCHAR);
+    packed = (domain + s.domain_len * sizeof(WCHAR) + 3) & ~3;
+    size = packed + sizeof(*p) + s.password_len * sizeof(WCHAR);
+    if (!(buf = calloc( 1, size ))) return SEC_E_INSUFFICIENT_MEMORY;
+    h = (struct ex2_header *)buf;
+    h->Version = AUTH_IDENTITY_VERSION_2;
+    h->cbHeaderLength = sizeof(*h);
+    h->cbStructureLength = size;
+    h->Flags = SEC_WINNT_AUTH_IDENTITY_UNICODE | SEC_WINNT_AUTH_IDENTITY_MARSHALLED;
+    h->UserOffset = user;
+    h->UserLength = s.user_len * sizeof(WCHAR);
+    if (s.user_len) memcpy( buf + user, s.user, h->UserLength );
+    h->DomainOffset = domain;
+    h->DomainLength = s.domain_len * sizeof(WCHAR);
+    if (s.domain_len) memcpy( buf + domain, s.domain, h->DomainLength );
+    h->PackedCredentialsOffset = packed;
+    h->PackedCredentialsLength = sizeof(*p) + s.password_len * sizeof(WCHAR);
+    p = (struct packed_credentials *)(buf + packed);
+    p->cbHeaderLength = sizeof(*p);
+    p->cbStructureLength = h->PackedCredentialsLength;
+    p->CredType = auth_data_type_password;
+    p->ByteArrayOffset = sizeof(*p);
+    p->ByteArrayLength = s.password_len * sizeof(WCHAR);
+    if (s.password_len) memcpy( p + 1, s.password, p->ByteArrayLength );
+    *length = size;
+    *bytes = (char *)buf;
+    return SEC_E_OK;
+}
+
+/***********************************************************************
+ *		SspiUnmarshalAuthIdentity (SSPICLI.@)
+ */
+SECURITY_STATUS SEC_ENTRY SspiUnmarshalAuthIdentity( ULONG length, char *bytes, PSEC_WINNT_AUTH_IDENTITY_OPAQUE *opaque_id )
+{
+    struct id_strings s;
+
+    TRACE( "%lu %p %p\n", length, bytes, opaque_id );
+
+    if (!opaque_id) return SEC_E_INVALID_PARAMETER;
+    *opaque_id = NULL;
+    if (!bytes || length < sizeof(struct ex2_header) || *(ULONG *)bytes != AUTH_IDENTITY_VERSION_2 ||
+        !id_strings_get( bytes, length, &s ))
+        return SEC_E_INVALID_TOKEN;
+    return id_from_strings( &s, opaque_id );
+}
+
+/***********************************************************************
+ *		SspiValidateAuthIdentity (SSPICLI.@)
+ */
+SECURITY_STATUS SEC_ENTRY SspiValidateAuthIdentity( PSEC_WINNT_AUTH_IDENTITY_OPAQUE opaque_id )
+{
+    struct id_strings s;
+
+    TRACE( "%p\n", opaque_id );
+    return id_strings_get( opaque_id, 0, &s ) ? SEC_E_OK : SEC_E_INVALID_TOKEN;
+}
+
+/***********************************************************************
+ *		SspiIsAuthIdentityEncrypted (SSPICLI.@)
+ */
+BOOLEAN SEC_ENTRY SspiIsAuthIdentityEncrypted( PSEC_WINNT_AUTH_IDENTITY_OPAQUE opaque_id )
+{
+    TRACE( "%p\n", opaque_id );
+    /* identities are never encrypted here (SspiEncryptAuthIdentity is not implemented) */
+    if (opaque_id && *(ULONG *)opaque_id == AUTH_IDENTITY_VERSION_2)
+        return (((struct ex2_header *)opaque_id)->Flags & 0x70) != 0;
+    return FALSE;
+}
diff --git a/dlls/sspicli/sspicli.spec b/dlls/sspicli/sspicli.spec
index cb14a50..d758955 100644
--- a/dlls/sspicli/sspicli.spec
+++ b/dlls/sspicli/sspicli.spec
@@ -79,8 +79,8 @@
 @ stdcall SetContextAttributesW(ptr long ptr long) secur32.SetContextAttributesW
 @ stub SetCredentialsAttributesA
 @ stub SetCredentialsAttributesW
-@ stub SspiCompareAuthIdentities
-@ stub SspiCopyAuthIdentity
+@ stdcall SspiCompareAuthIdentities(ptr ptr ptr ptr)
+@ stdcall SspiCopyAuthIdentity(ptr ptr)
 @ stub SspiDecryptAuthIdentity
 @ stub SspiDecryptAuthIdentityEx
 @ stdcall SspiEncodeAuthIdentityAsStrings(ptr ptr ptr ptr)
@@ -91,14 +91,14 @@
 @ stdcall SspiFreeAuthIdentity(ptr)
 @ stub SspiGetComputerNameForSPN
 @ stub SspiGetTargetHostName
-@ stub SspiIsAuthIdentityEncrypted
+@ stdcall SspiIsAuthIdentityEncrypted(ptr)
 @ stdcall SspiLocalFree(ptr)
-@ stub SspiMarshalAuthIdentity
+@ stdcall SspiMarshalAuthIdentity(ptr ptr ptr)
 @ stub SspiPrepareForCredRead
 @ stdcall SspiPrepareForCredWrite(ptr wstr ptr ptr ptr ptr ptr)
-@ stub SspiUnmarshalAuthIdentity
+@ stdcall SspiUnmarshalAuthIdentity(long ptr ptr)
 @ stub SspiUnmarshalAuthIdentityInternal
-@ stub SspiValidateAuthIdentity
+@ stdcall SspiValidateAuthIdentity(ptr)
 @ stdcall SspiZeroAuthIdentity(ptr)
 @ stdcall UnsealMessage(ptr ptr long ptr) secur32.UnsealMessage
 @ stdcall VerifySignature(ptr ptr long ptr) secur32.VerifySignature
