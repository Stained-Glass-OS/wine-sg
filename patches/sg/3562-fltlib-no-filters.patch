From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] fltlib: report no filters (3562)

fltlib: report no filters, no instances, no ports

There is no filter manager, so the user-mode filter API answers like a machine without minifilters:
the Find-First calls for filters, volumes and volume instances end at once with ERROR_NO_MORE_ITEMS,
the handle based calls (Next, Close, GetInformation, messages) fail with ERROR_INVALID_HANDLE since no
handle can exist, filter-by-name calls (Create, InstanceCreate, InstanceFindFirst, Attach, Detach) give
ERROR_FLT_FILTER_NOT_FOUND, FilterConnectCommunicationPort ERROR_FILE_NOT_FOUND. FilterGetDosName maps
a device volume name to its drive letter. FilterLoad/Unload look up the driver service first
(ERROR_SERVICE_DOES_NOT_EXIST), then report that a driver cannot be loaded / is not loaded.
---
--- a/dlls/fltlib/Makefile.in
+++ b/dlls/fltlib/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = fltlib.dll
+IMPORTS   = advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
--- a/dlls/fltlib/fltlib.c
+++ b/dlls/fltlib/fltlib.c
@@ -21,10 +21,26 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winsvc.h"
+#include "winerror.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(fltlib);
 
+
+/* There is no filter manager here, so no minifilter is loaded, no volume has an instance and no
+ * communication port exists.  Queries report that, and calls that need a handle or a filter by name
+ * fail the way they do when the filter is not there. */
+
+#define FILTER_E(code) HRESULT_FROM_WIN32(code)
+
+enum filter_information_class
+{
+    FilterFullInformation,
+    FilterAggregateBasicInformation,
+    FilterAggregateStandardInformation,
+};
+
 /**********************************************************************
  *      FilterConnectCommunicationPort         (FLTLIB.@)
  */
@@ -33,11 +49,14 @@
                                               LPSECURITY_ATTRIBUTES lpSecurityAttributes,
                                               HANDLE *hPort)
 {
-    FIXME("(%s, %ld, %p, %ld, %p, %p) stub\n", debugstr_w(lpPortName), dwOptions,
+    TRACE("(%s, %ld, %p, %ld, %p, %p)\n", debugstr_w(lpPortName), dwOptions,
         lpContext, dwSizeOfContext, lpSecurityAttributes, hPort);
 
+    if (!hPort) return E_INVALIDARG;
     *hPort = INVALID_HANDLE_VALUE;
-    return E_NOTIMPL;
+    if (!lpPortName || (dwSizeOfContext && !lpContext)) return E_INVALIDARG;
+    /* ports are created by filter drivers, and there are none */
+    return FILTER_E(ERROR_FILE_NOT_FOUND);
 }
 
 /**********************************************************************
@@ -46,8 +65,22 @@
 HRESULT WINAPI FilterFindFirst(DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned,
                                LPHANDLE handle)
 {
-    FIXME("(%lu, %p, %lu, %p, %p) stub\n", class, buffer, size, bytes_returned, handle);
-    return HRESULT_FROM_WIN32(ERROR_NO_MORE_ITEMS);
+    TRACE("(%lu, %p, %lu, %p, %p)\n", class, buffer, size, bytes_returned, handle);
+
+    if (class != FilterAggregateBasicInformation && class != FilterAggregateStandardInformation) return E_INVALIDARG;
+    if (!buffer || !bytes_returned || !handle) return E_INVALIDARG;
+    *bytes_returned = 0;
+    return FILTER_E(ERROR_NO_MORE_ITEMS);
+}
+
+/**********************************************************************
+ *      FilterFindNext          (FLTLIB.@)
+ */
+HRESULT WINAPI FilterFindNext(HANDLE handle, DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned)
+{
+    TRACE("(%p, %lu, %p, %lu, %p)\n", handle, class, buffer, size, bytes_returned);
+    /* FilterFindFirst never returns a search handle */
+    return FILTER_E(ERROR_INVALID_HANDLE);
 }
 
 /**********************************************************************
@@ -55,7 +88,268 @@
  */
 HRESULT WINAPI FilterFindClose(HANDLE handle)
 {
-    FIXME("(%p) stub\n", handle);
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterVolumeFindFirst   (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeFindFirst(DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned, LPHANDLE handle)
+{
+    TRACE("(%lu, %p, %lu, %p, %p)\n", class, buffer, size, bytes_returned, handle);
+
+    if (class > FilterAggregateStandardInformation) return E_INVALIDARG;
+    if (!buffer || !bytes_returned || !handle) return E_INVALIDARG;
+    *bytes_returned = 0;
+    /* no filter, so no volume has one attached */
+    return FILTER_E(ERROR_NO_MORE_ITEMS);
+}
+
+/**********************************************************************
+ *      FilterVolumeFindNext    (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeFindNext(HANDLE handle, DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned)
+{
+    TRACE("(%p, %lu, %p, %lu, %p)\n", handle, class, buffer, size, bytes_returned);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterVolumeFindClose   (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeFindClose(HANDLE handle)
+{
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterVolumeInstanceFindFirst   (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeInstanceFindFirst(LPCWSTR volume, DWORD class, LPVOID buffer, DWORD size,
+                                             LPDWORD bytes_returned, LPHANDLE handle)
+{
+    TRACE("(%s, %lu, %p, %lu, %p, %p)\n", debugstr_w(volume), class, buffer, size, bytes_returned, handle);
+
+    if (!volume || !buffer || !bytes_returned || !handle) return E_INVALIDARG;
+    *bytes_returned = 0;
+    return FILTER_E(ERROR_NO_MORE_ITEMS);
+}
+
+/**********************************************************************
+ *      FilterVolumeInstanceFindNext    (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeInstanceFindNext(HANDLE handle, DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned)
+{
+    TRACE("(%p, %lu, %p, %lu, %p)\n", handle, class, buffer, size, bytes_returned);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterVolumeInstanceFindClose   (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeInstanceFindClose(HANDLE handle)
+{
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterVolumeClose       (FLTLIB.@)
+ */
+HRESULT WINAPI FilterVolumeClose(HANDLE handle)
+{
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterInstanceFindFirst (FLTLIB.@)
+ */
+HRESULT WINAPI FilterInstanceFindFirst(LPCWSTR filter, DWORD class, LPVOID buffer, DWORD size,
+                                       LPDWORD bytes_returned, LPHANDLE handle)
+{
+    TRACE("(%s, %lu, %p, %lu, %p, %p)\n", debugstr_w(filter), class, buffer, size, bytes_returned, handle);
+
+    if (!filter || !buffer || !bytes_returned || !handle) return E_INVALIDARG;
+    *bytes_returned = 0;
+    return ERROR_FLT_FILTER_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterInstanceFindNext  (FLTLIB.@)
+ */
+HRESULT WINAPI FilterInstanceFindNext(HANDLE handle, DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned)
+{
+    TRACE("(%p, %lu, %p, %lu, %p)\n", handle, class, buffer, size, bytes_returned);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterInstanceFindClose (FLTLIB.@)
+ */
+HRESULT WINAPI FilterInstanceFindClose(HANDLE handle)
+{
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterCreate            (FLTLIB.@)
+ */
+HRESULT WINAPI FilterCreate(LPCWSTR filter, HANDLE *handle)
+{
+    TRACE("(%s, %p)\n", debugstr_w(filter), handle);
+
+    if (!filter || !handle) return E_INVALIDARG;
+    *handle = INVALID_HANDLE_VALUE;
+    return ERROR_FLT_FILTER_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterClose             (FLTLIB.@)
+ */
+HRESULT WINAPI FilterClose(HANDLE handle)
+{
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterGetInformation    (FLTLIB.@)
+ */
+HRESULT WINAPI FilterGetInformation(HANDLE filter, DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned)
+{
+    TRACE("(%p, %lu, %p, %lu, %p)\n", filter, class, buffer, size, bytes_returned);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterInstanceCreate    (FLTLIB.@)
+ */
+HRESULT WINAPI FilterInstanceCreate(LPCWSTR filter, LPCWSTR volume, LPCWSTR instance, HANDLE *handle)
+{
+    TRACE("(%s, %s, %s, %p)\n", debugstr_w(filter), debugstr_w(volume), debugstr_w(instance), handle);
+
+    if (!filter || !volume || !handle) return E_INVALIDARG;
+    *handle = INVALID_HANDLE_VALUE;
+    return ERROR_FLT_FILTER_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterInstanceClose     (FLTLIB.@)
+ */
+HRESULT WINAPI FilterInstanceClose(HANDLE handle)
+{
+    TRACE("(%p)\n", handle);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterInstanceGetInformation    (FLTLIB.@)
+ */
+HRESULT WINAPI FilterInstanceGetInformation(HANDLE instance, DWORD class, LPVOID buffer, DWORD size, LPDWORD bytes_returned)
+{
+    TRACE("(%p, %lu, %p, %lu, %p)\n", instance, class, buffer, size, bytes_returned);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterAttach            (FLTLIB.@)
+ */
+HRESULT WINAPI FilterAttach(LPCWSTR filter, LPCWSTR volume, LPCWSTR instance, DWORD created_len, LPWSTR created)
+{
+    TRACE("(%s, %s, %s, %lu, %p)\n", debugstr_w(filter), debugstr_w(volume), debugstr_w(instance), created_len, created);
+
+    if (!filter || !volume) return E_INVALIDARG;
+    return ERROR_FLT_FILTER_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterAttachAtAltitude  (FLTLIB.@)
+ */
+HRESULT WINAPI FilterAttachAtAltitude(LPCWSTR filter, LPCWSTR volume, LPCWSTR altitude, LPCWSTR instance,
+                                      DWORD created_len, LPWSTR created)
+{
+    TRACE("(%s, %s, %s, %s, %lu, %p)\n", debugstr_w(filter), debugstr_w(volume), debugstr_w(altitude),
+          debugstr_w(instance), created_len, created);
+
+    if (!filter || !volume || !altitude) return E_INVALIDARG;
+    return ERROR_FLT_FILTER_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterDetach            (FLTLIB.@)
+ */
+HRESULT WINAPI FilterDetach(LPCWSTR filter, LPCWSTR volume, LPCWSTR instance)
+{
+    TRACE("(%s, %s, %s)\n", debugstr_w(filter), debugstr_w(volume), debugstr_w(instance));
+
+    if (!filter || !volume) return E_INVALIDARG;
+    return ERROR_FLT_FILTER_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterGetDosName        (FLTLIB.@)
+ */
+HRESULT WINAPI FilterGetDosName(LPCWSTR volume, LPWSTR dos_name, DWORD size)
+{
+    WCHAR drive[3] = L"A:", target[MAX_PATH];
+
+    TRACE("(%s, %p, %lu)\n", debugstr_w(volume), dos_name, size);
+
+    if (!volume || !dos_name) return E_INVALIDARG;
+    for (; drive[0] <= 'Z'; drive[0]++)
+    {
+        if (!QueryDosDeviceW(drive, target, ARRAY_SIZE(target)) || wcsicmp(target, volume)) continue;
+        if (size < 3) return FILTER_E(ERROR_INSUFFICIENT_BUFFER);
+        wcscpy(dos_name, drive);
+        return S_OK;
+    }
+    return ERROR_FLT_VOLUME_NOT_FOUND;
+}
+
+/**********************************************************************
+ *      FilterSendMessage       (FLTLIB.@)
+ */
+HRESULT WINAPI FilterSendMessage(HANDLE port, LPVOID in, DWORD in_size, LPVOID out, DWORD out_size, LPDWORD returned)
+{
+    TRACE("(%p, %p, %lu, %p, %lu, %p)\n", port, in, in_size, out, out_size, returned);
+    /* ports cannot be opened, so there is no valid port handle */
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterGetMessage        (FLTLIB.@)
+ */
+HRESULT WINAPI FilterGetMessage(HANDLE port, void *message, DWORD size, LPOVERLAPPED overlapped)
+{
+    TRACE("(%p, %p, %lu, %p)\n", port, message, size, overlapped);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/**********************************************************************
+ *      FilterReplyMessage      (FLTLIB.@)
+ */
+HRESULT WINAPI FilterReplyMessage(HANDLE port, void *reply, DWORD size)
+{
+    TRACE("(%p, %p, %lu)\n", port, reply, size);
+    return FILTER_E(ERROR_INVALID_HANDLE);
+}
+
+/* the service of a filter driver: loading a filter starts it, unloading stops it */
+static HRESULT filter_service_check(LPCWSTR filtername, SC_HANDLE *service_out)
+{
+    SC_HANDLE manager, service;
+    DWORD err;
+
+    if (!(manager = OpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT))) return HRESULT_FROM_WIN32(GetLastError());
+    service = OpenServiceW(manager, filtername, SERVICE_QUERY_STATUS);
+    err = service ? ERROR_SUCCESS : GetLastError();
+    CloseServiceHandle(manager);
+    if (!service) return HRESULT_FROM_WIN32(err);
+    *service_out = service;
     return S_OK;
 }
 
@@ -64,8 +358,17 @@
  */
 HRESULT WINAPI FilterLoad(LPCWSTR filtername)
 {
-    FIXME("(%s) stub\n", debugstr_w(filtername));
-    return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
+    SC_HANDLE service;
+    HRESULT hr;
+
+    TRACE("(%s)\n", debugstr_w(filtername));
+
+    if (!filtername) return FILTER_E(ERROR_INVALID_PARAMETER);
+    if (FAILED(hr = filter_service_check(filtername, &service))) return hr;
+    CloseServiceHandle(service);
+    /* kernel drivers cannot be loaded */
+    FIXME("cannot load the filter driver %s\n", debugstr_w(filtername));
+    return FILTER_E(ERROR_NOT_SUPPORTED);
 }
 
 /**********************************************************************
@@ -73,10 +376,15 @@
  */
 HRESULT WINAPI FilterUnload(LPCWSTR filtername)
 {
-    FIXME("(%s) stub\n", debugstr_w(filtername));
+    SC_HANDLE service;
+    HRESULT hr;
 
-    if (!filtername)
-        return HRESULT_FROM_WIN32(ERROR_INVALID_PARAMETER);
+    TRACE("(%s)\n", debugstr_w(filtername));
 
-    return S_OK;
+    if (!filtername)
+        return FILTER_E(ERROR_INVALID_PARAMETER);
+    if (FAILED(hr = filter_service_check(filtername, &service))) return hr;
+    CloseServiceHandle(service);
+    /* a filter driver never runs here, so this one is not loaded */
+    return ERROR_FLT_FILTER_NOT_FOUND;
 }
--- a/dlls/fltlib/fltlib.spec
+++ b/dlls/fltlib/fltlib.spec
