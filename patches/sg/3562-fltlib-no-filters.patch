-@ stub FilterVolumeFindNext
-@ stub FilterVolumeInstanceFindClose
-@ stub FilterVolumeInstanceFindFirst
-@ stub FilterVolumeInstanceFindNext
+@ stdcall FilterVolumeClose(ptr)
