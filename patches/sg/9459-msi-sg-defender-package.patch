From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: SG Defender scans a package before it is opened

SG Defender's real-time protection for installers: MSI_OpenPackageW scans the
package before opening it (its custom actions run from it). One that holds
malware is not installed: ERROR_VIRUS_INFECTED. Gate test-defender-exec.
---
--- a/dlls/msi/package.c
+++ b/dlls/msi/package.c
@@ -1484,6 +1484,27 @@
     return ERROR_SUCCESS;
 }
 
+/* Stained Glass OS: SG Defender's real-time protection -- an installer
+ * package is scanned before it is opened (its custom actions run from it);
+ * one that holds malware is not installed: ERROR_VIRUS_INFECTED */
+static BOOL package_blocked( const WCHAR *path )
+{
+    static LONG (CDECL *scan)( HANDLE, const void *, ULONG, const WCHAR *, ULONG );
+    LONG status;
+    HANDLE file;
+
+    if (!scan) scan = (void *)GetProcAddress( GetModuleHandleW( L"ntdll.dll" ), "__wine_sg_defender_scan" );
+    if (!scan) return FALSE;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    status = scan( file, NULL, 0, NULL, 1 );
+    CloseHandle( file );
+    if (status != (LONG)0xc0000906 /* STATUS_VIRUS_INFECTED */) return FALSE;
+    WARN( "SG Defender: %s holds malware: not installed\n", debugstr_w(path) );
+    return TRUE;
+}
+
 UINT MSI_OpenPackageW(LPCWSTR szPackage, DWORD dwOptions, MSIPACKAGE **pPackage)
 {
     MSIDATABASE *db;
@@ -1524,6 +1545,7 @@
 
             file = cachefile;
         }
+        if (package_blocked( file )) return ERROR_VIRUS_INFECTED;
         r = MSI_OpenDatabaseW( file, MSIDBOPEN_READONLY, &db );
         if (r != ERROR_SUCCESS)
         {
