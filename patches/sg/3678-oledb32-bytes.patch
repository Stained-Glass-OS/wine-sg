From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oledb32: IDataConvert conversions to DBTYPE_BYTES (3678)

oledb32: IDataConvert conversions to DBTYPE_BYTES

GetConversionSize to DBTYPE_BYTES now answers for DBTYPE_BYTES (the source
length), DBTYPE_STR, DBTYPE_WSTR and DBTYPE_BSTR (a string of hexadecimal
digit pairs: half as many bytes). DataConvert converts those string types to
bytes the same way, with truncation status and DBSTATUS_E_CANTCONVERTVALUE
for an odd digit count or a non-hexadecimal character.
---
diff --git a/dlls/oledb32/convert.c b/dlls/oledb32/convert.c
index d8ee482..4012549 100644
--- a/dlls/oledb32/convert.c
+++ b/dlls/oledb32/convert.c
@@ -1209,6 +1209,54 @@ static HRESULT WINAPI convert_DataConvert(IDataConvert* iface,
             }
         }
         break;
+        case DBTYPE_STR:
+        case DBTYPE_WSTR:
+        case DBTYPE_BSTR:
+        {
+            /* a string of hexadecimal digit pairs (GUESSED: documented table not reachable) */
+            DBLENGTH chars, i, out;
+            BOOL ok = TRUE;
+
+            if (src_type == DBTYPE_STR) chars = src_len;
+            else if (src_type == DBTYPE_WSTR) chars = src_len / sizeof(WCHAR);
+            else chars = *(WCHAR **)src ? SysStringLen(*(BSTR *)src) : 0;
+#ifndef OLE_MUT_ODD
+            if (chars % 2) ok = FALSE;
+#endif
+            for (i = 0; ok && i < chars; i++)
+            {
+                WCHAR c = src_type == DBTYPE_STR ? (unsigned char)((char *)src)[i]
+                        : src_type == DBTYPE_WSTR ? ((WCHAR *)src)[i] : (*(WCHAR **)src)[i];
+#ifdef OLE_MUT_CASE
+                ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+#else
+                ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+#endif
+            }
+            if (!ok)
+            {
+                *dst_status = DBSTATUS_E_CANTCONVERTVALUE;
+                return DB_E_CANTCONVERTVALUE;
+            }
+            out = chars / 2;
+            for (i = 0; i < out && i < dst_max_len; i++)
+            {
+                WCHAR hi, lo;
+                if (src_type == DBTYPE_STR) { hi = ((char *)src)[2 * i]; lo = ((char *)src)[2 * i + 1]; }
+                else if (src_type == DBTYPE_WSTR) { hi = ((WCHAR *)src)[2 * i]; lo = ((WCHAR *)src)[2 * i + 1]; }
+                else { hi = (*(WCHAR **)src)[2 * i]; lo = (*(WCHAR **)src)[2 * i + 1]; }
+                hi = hi <= '9' ? hi - '0' : (hi | 0x20) - 'a' + 10;
+                lo = lo <= '9' ? lo - '0' : (lo | 0x20) - 'a' + 10;
+                d[i] = (hi << 4) | lo;
+            }
+            *dst_len = out;
+#ifdef OLE_MUT_TRUNC
+            *dst_status = DBSTATUS_S_OK;
+#else
+            *dst_status = out > dst_max_len ? DBSTATUS_S_TRUNCATED : DBSTATUS_S_OK;
+#endif
+            return S_OK;
+        }
         default: FIXME("Unimplemented conversion %04x -> DBTYPE_BYTES\n", src_type); return E_NOTIMPL;
         }
         break;
@@ -1641,6 +1689,23 @@ static HRESULT WINAPI convert_GetConversionSize(IDataConvert* iface,
                 }
             }
             break;
+        case DBTYPE_BYTES:
+            if (!src_len) return E_INVALIDARG;
+            *dst_len = *src_len;
+            break;
+        case DBTYPE_STR:
+#ifdef OLE_MUT_SIZE
+            *dst_len = (src_len ? *src_len : strlen(src));
+#else
+            *dst_len = (src_len ? *src_len : strlen(src)) / 2;
+#endif
+            break;
+        case DBTYPE_WSTR:
+            *dst_len = (src_len ? *src_len / sizeof(WCHAR) : lstrlenW(src)) / 2;
+            break;
+        case DBTYPE_BSTR:
+            *dst_len = (*(WCHAR **)src ? SysStringLen(*(BSTR *)src) : 0) / 2;
+            break;
         default:
             FIXME("unimplemented for %04x -> DBTYPE_BYTES\n", src_type);
             return E_NOTIMPL;
