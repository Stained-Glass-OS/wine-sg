From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: SetFileShortName

A helper Word starts calls SetFileShortNameW, which kernel32 did not
export, and aborted on it.

The file system here derives a file's 8.3 name from its long one and keeps
none of its own, so there is nothing to set: a valid 8.3 name (up to eight
characters, a dot and up to three, none of \/:*?"<>|+,;=[] or a space) for
an open file is taken, to no effect; any other name is refused with
ERROR_INVALID_PARAMETER, and a handle that is not a file's with the error
of querying it. SetFileShortNameA converts and calls it. kernel32 forwards
both.

Gate: test/shortname-gate.sh.
---
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -4032,6 +4032,61 @@
 /***********************************************************************
  *	SetFileTime   (kernelbase.@)
  */
+/***********************************************************************
+ *	SetFileShortNameW   (kernelbase.@)
+ *
+ * Stained Glass OS: the file system derives a file's 8.3 name from its long
+ * one and keeps none of its own, so there is nothing to set: a valid 8.3 name
+ * for an open file is taken, to no effect. Office (a helper Word starts)
+ * aborted on the missing function.
+ */
+BOOL WINAPI SetFileShortNameW( HANDLE file, LPCWSTR name )
+{
+    static const WCHAR invalid[] = L"\\/:*?\"<>|+,;=[] ";
+    IO_STATUS_BLOCK io;
+    FILE_BASIC_INFORMATION info;
+    const WCHAR *dot = NULL, *p;
+
+    TRACE( "%p, %s\n", file, debugstr_w(name) );
+
+    if (!name || !*name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    for (p = name; *p; p++)
+    {
+        if (*p < 0x20 || wcschr( invalid, *p )) break;
+        if (*p == '.') { if (dot) break; dot = p; }
+    }
+    if (*p || (dot ? (dot == name || dot - name > 8 || !dot[1] || wcslen( dot + 1 ) > 3) : wcslen( name ) > 8))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!set_ntstatus( NtQueryInformationFile( file, &io, &info, sizeof(info), FileBasicInformation ))) return FALSE;
+    return TRUE;
+}
+
+/***********************************************************************
+ *	SetFileShortNameA   (kernelbase.@)
+ */
+BOOL WINAPI SetFileShortNameA( HANDLE file, LPCSTR name )
+{
+    WCHAR *nameW;
+    BOOL ret;
+
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(nameW = file_name_AtoW( name, TRUE ))) return FALSE;
+    ret = SetFileShortNameW( file, nameW );
+    HeapFree( GetProcessHeap(), 0, nameW );
+    return ret;
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH SetFileTime( HANDLE file, const FILETIME *ctime,
                                            const FILETIME *atime, const FILETIME *mtime )
 {
