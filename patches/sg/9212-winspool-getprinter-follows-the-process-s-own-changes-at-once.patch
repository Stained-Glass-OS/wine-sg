From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 04:30:00 -0800
Subject: [PATCH] winspool: GetPrinter follows the process's own changes at once (9212)

winspool keeps what CUPS says of its queues (state, documents) for 2 seconds.
After the process paused, resumed or purged a CUPS printer (SetPrinter),
changed a document (SetJob) or printed one (EndDocPrinter), GetPrinter went on
answering from that copy: a WPF program's PrintQueue.Pause then IsPaused read
"not paused", a queue window showed a cancelled document. Windows' spooler
answers with the change at once; now those calls forget the copy (a
get_printer_status call without a printer) and the next GetPrinter asks CUPS.
Gate test/cupsjobs-gate.sh (status part, 64/32-bit); mutant
SG_MUTANT_STATUS_STALE.
---
--- a/dlls/winspool.drv/cups.c
+++ b/dlls/winspool.drv/cups.c
@@ -589,6 +589,21 @@
     time_t now = time( NULL );
     int i;
 
+#ifndef SG_MUTANT_STATUS_STALE
+    /* Stained Glass OS (9212): no printer = forget what was read; the next
+     * question asks CUPS again (after this process paused, resumed or purged
+     * a queue, or changed or added a document, as Windows' spooler answers
+     * at once) */
+    if (!params->printer)
+    {
+        pthread_mutex_lock( &lock );
+        free( cache );
+        cache = NULL;
+        cache_count = 0;
+        pthread_mutex_unlock( &lock );
+        return STATUS_SUCCESS;
+    }
+#endif
     if (!pcupsGetDests) return STATUS_NOT_SUPPORTED;
     if (ntdll_wcstoumbs( params->printer, wcslen( params->printer ) + 1, name, sizeof(name), FALSE ) <= 0)
         return STATUS_INVALID_PARAMETER;
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -3917,6 +3917,16 @@
     return TRUE;
 }
 
+/* Stained Glass OS (9212): what CUPS said of its queues is kept a moment;
+ * after this process changed a queue or a document the next GetPrinter asks
+ * again, so a pause, a cancel or a new document shows at once, as on Windows */
+static void forget_printer_status( void )
+{
+    struct get_printer_status_params params = { NULL, NULL, NULL };
+
+    UNIX_CALL( get_printer_status, &params );
+}
+
 /******************************************************************************
  *    SetPrinterW  [WINSPOOL.@]
  */
@@ -3942,6 +3952,7 @@
         {
             if (backend->fpSetPrinter( handle, level, data, command ))
             {
+                forget_printer_status();
                 RegCloseKey( key );
                 return TRUE;
             }
@@ -4188,7 +4199,9 @@
         return FALSE;
     }
 
-    return backend->fpSetJob(handle, job_id, level, data, command);
+    if (!backend->fpSetJob(handle, job_id, level, data, command)) return FALSE;
+    forget_printer_status();
+    return TRUE;
 }
 
 /*****************************************************************************
@@ -4210,7 +4223,9 @@
         return FALSE;
     }
 
-    return backend->fpEndDocPrinter(handle);
+    if (!backend->fpEndDocPrinter(handle)) return FALSE;
+    forget_printer_status();
+    return TRUE;
 }
 
 /*****************************************************************************
