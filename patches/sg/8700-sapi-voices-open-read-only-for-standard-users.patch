From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sapi: voices and audio outputs below HKEY_LOCAL_MACHINE open for a standard user (8700)

sapi opened the token category (SetId, GetDataKey), its Tokens key, each
object token (SetId) and a data key's sub keys (OpenKey, CreateKey) with
KEY_ALL_ACCESS. The voices, audio outputs and recognizers live below
HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Speech, which a standard user -- and an
administrator who is not elevated -- may only read on Stained Glass (machine
keys have Windows' descriptor since 3764). SpObjectTokenCategory::SetId gave
SPERR_INVALID_REGISTRY_KEY, SpVoice found no voice and Speak failed: nothing
read text aloud (Thorium's read aloud stopped at its first sentence; Chromium's
speechSynthesis, Balabolka and NVDA's SAPI 5 driver use the same path).
A key the caller may not write is opened for reading now, as SAPI does on
Windows; changing it still fails with E_ACCESSDENIED. Mutant
SG_MUTANT_SAPI_NO_READONLY_KEYS.
---
--- a/dlls/sapi/token.c
+++ b/dlls/sapi/token.c
@@ -261,6 +261,26 @@
     return S_OK;
 }
 
+/* Open (or create) a key for reading and writing, and when the caller may not
+ * write there -- the voices, audio outputs and recognizers below
+ * HKEY_LOCAL_MACHINE for anyone but an elevated administrator -- for reading
+ * only, as SAPI does on Windows: a standard user enumerates and uses the
+ * installed voices, and only a change to them is refused. */
+static LSTATUS open_key_rw_or_ro( HKEY root, const WCHAR *subkey, BOOL create, HKEY *key )
+{
+    LSTATUS res;
+
+    if (create)
+        res = RegCreateKeyExW( root, subkey, 0, NULL, 0, KEY_ALL_ACCESS, NULL, key, NULL );
+    else
+        res = RegOpenKeyExW( root, subkey, 0, KEY_ALL_ACCESS, key );
+#ifndef SG_MUTANT_SAPI_NO_READONLY_KEYS
+    if (res == ERROR_ACCESS_DENIED)
+        res = RegOpenKeyExW( root, subkey, 0, KEY_READ, key );
+#endif
+    return res;
+}
+
 static HRESULT WINAPI data_key_OpenKey( ISpRegDataKey *iface,
                                         LPCWSTR name, ISpDataKey **sub_key )
 {
@@ -272,7 +292,7 @@
 
     TRACE( "%p, %s, %p\n", This, debugstr_w(name), sub_key );
 
-    ret = RegOpenKeyExW( This->key, name, 0, KEY_ALL_ACCESS, &key );
+    ret = open_key_rw_or_ro( This->key, name, FALSE, &key );
     if (ret != ERROR_SUCCESS)
         return SPERR_NOT_FOUND;
 
@@ -308,7 +328,7 @@
 
     TRACE( "%p, %s, %p\n", This, debugstr_w(name), sub_key );
 
-    res = RegCreateKeyExW( This->key, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
+    res = open_key_rw_or_ro( This->key, name, TRUE, &key );
     if (res != ERROR_SUCCESS)
         return HRESULT_FROM_WIN32(res);
 
@@ -1042,10 +1062,7 @@
     hr = parse_cat_id( id, &root, &subkey );
     if (hr != S_OK) return SPERR_INVALID_REGISTRY_KEY;
 
-    if (create)
-        res = RegCreateKeyExW( root, subkey, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
-    else
-        res = RegOpenKeyExW( root, subkey, 0, KEY_ALL_ACCESS, &key );
+    res = open_key_rw_or_ro( root, subkey, create, &key );
     if (res) return SPERR_INVALID_REGISTRY_KEY;
 
     if (FAILED(hr = create_data_key_with_hkey( key, &This->data_key )))
@@ -1109,7 +1126,7 @@
     if (parse_cat_id( This->id, &key, &subkey ) != S_OK)
         return SPERR_INVALID_REGISTRY_KEY;
 
-    res = RegCreateKeyExW( root, subkey, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
+    res = open_key_rw_or_ro( root, subkey, TRUE, &key );
     if (res) return HRESULT_FROM_WIN32( res );
 
     if (FAILED(hr = create_data_key_with_hkey( key, &reg_key )))
@@ -1193,7 +1210,7 @@
 
     this_data_key = impl_from_ISpRegDataKey( This->data_key );
 
-    if (!RegOpenKeyExW( this_data_key->key, L"Tokens", 0, KEY_ALL_ACCESS, &tokens_key ))
+    if (!open_key_rw_or_ro( this_data_key->key, L"Tokens", FALSE, &tokens_key ))
     {
         RegQueryInfoKeyW( tokens_key, NULL, NULL, NULL, &count, &max_subkey_size, NULL,
                 NULL, NULL, NULL, NULL, NULL );
@@ -2687,10 +2704,7 @@
         res = open_mmaudio_out_token( subkey + wcslen( mmaudio_out_enum ), &key );
     else
 #endif
-    if (create)
-        res = RegCreateKeyExW( root, subkey, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL);
-    else
-        res = RegOpenKeyExW( root, subkey, 0, KEY_ALL_ACCESS, &key );
+        res = open_key_rw_or_ro( root, subkey, create, &key );
     if (res) return SPERR_NOT_FOUND;
 
     hr = create_data_key_with_hkey( key, &This->data_key );
