+static void elem_origin( struct uielem *elem, FLOAT *x, FLOAT *y );
+
+static BOOL clips_children( struct uielem *elem )
+{
+    const WCHAR *name = elem->d.obj.cls->name;
+    return !wcscmp( name, L"Windows.UI.Xaml.Controls.ScrollViewer" ) ||
+           !wcscmp( name, L"Windows.UI.Xaml.Controls.ScrollContentPresenter" );
+}
+
+/* the part of the root (and of the scroll viewers it is in) an element shows, in its own coordinates;
+ * the distances to bring it into view when it is outside */
+static void effective_viewport( struct uielem *elem, struct uielem *root, struct xrect *rect, struct xrect *max,
+                                DOUBLE *dx, DOUBLE *dy )
+{
+    FLOAT left = 0, top = 0, right = root->render.width, bottom = root->render.height, x, y, ex, ey;
+    struct uielem *up;
+
+    for (up = elem->parent; up && up != root; up = up->parent)
+    {
+        if (!clips_children( up )) continue;
+        elem_origin( up, &x, &y );
+        if (x > left) left = x;
+        if (y > top) top = y;
+        if (x + up->render.width < right) right = x + up->render.width;
+        if (y + up->render.height < bottom) bottom = y + up->render.height;
+    }
+    elem_origin( elem, &ex, &ey );
+    rect->x = left - ex;
+    rect->y = top - ey;
+    rect->width = right > left ? right - left : 0;
+    rect->height = bottom > top ? bottom - top : 0;
+    max->x = -ex;
+    max->y = -ey;
+    max->width = root->render.width;
+    max->height = root->render.height;
+    *dx = ex + elem->render.width < left ? left - (ex + elem->render.width) : ex > right ? ex - right : 0;
+    *dy = ey + elem->render.height < top ? top - (ey + elem->render.height) : ey > bottom ? ey - bottom : 0;
+}
+
+void xaml_raise_viewport_changed( struct uielem *root )
+{
+    unsigned int i, count;
+    struct uielem **items;
+
+#ifdef SG_MUTANT_NO_VIEWPORT_CHANGED
+    return;
+#endif
+    if (!(items = subtree( root, &count ))) return;
+    for (i = 0; i < count; i++)
+    {
+        struct uielem *elem = items[i];
+        struct viewport_args *args;
+        IInspectable *sender;
+        struct xrect rect, max;
+        DOUBLE dx, dy;
+
+        if (list_empty( &elem->viewport_changed.entries )) continue;
+        effective_viewport( elem, root, &rect, &max, &dx, &dy );
+        if (elem->viewport_told && !memcmp( &rect, &elem->last_viewport, sizeof(rect) )) continue;
+        elem->last_viewport = rect;
+        elem->viewport_told = TRUE;
+        if (!(sender = sender_of( elem ))) continue;
+        if ((args = calloc( 1, sizeof(*args) )))
+        {
+            args->iface.vtbl = viewport_args_vtbl;
+            args->effective = rect;
+            args->max = max;
+            args->distance_x = dx;
+            args->distance_y = dy;
+            xobj_init( &args->obj, &viewport_args_class, NULL );
+            TRACE( "%p: EffectiveViewportChanged %.1f,%.1f %.1fx%.1f\n", elem, rect.x, rect.y, rect.width, rect.height );
+            xaml_raise_routed( &elem->viewport_changed, sender, (IInspectable *)&args->iface );
+            IInspectable_Release( (IInspectable *)&args->iface );
+        }
+        IInspectable_Release( sender );
+    }
+    release_subtree( items, count );
+}
