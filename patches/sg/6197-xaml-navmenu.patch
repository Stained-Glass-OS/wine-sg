+static const struct xclass routed_event_class =
+{
+    L"Windows.UI.Xaml.RoutedEvent", routed_event_ifaces, ARRAY_SIZE(routed_event_ifaces), NULL,
+};
+
+static const void *routed_event_vtbl[] = { IRoutedEvent_STUBS };
+static struct routed_event *routed_events[REV_COUNT];   /* made when first asked for, kept for the process */
+
+static IInspectable *routed_event_iface( enum routed_event_id id )
+{
+    struct routed_event *event;
+
+    if (!routed_events[id])
+    {
+        if (!(event = calloc( 1, sizeof(*event) ))) return NULL;
+        event->IRoutedEvent_iface.vtbl = routed_event_vtbl;
+        event->id = id;
+        xobj_init( &event->obj, &routed_event_class, NULL );
+        if (InterlockedCompareExchangePointer( (void **)&routed_events[id], event, NULL ))
+            IInspectable_Release( (IInspectable *)&event->IRoutedEvent_iface );
+    }
+    return (IInspectable *)&routed_events[id]->IRoutedEvent_iface;
+}
+
+static struct handler_list *routed_event_list( struct uielem *elem, IInspectable *routed, const WCHAR **name )
+{
+    unsigned int i;
+
+    *name = NULL;
+    for (i = 0; i < REV_COUNT; i++)
+    {
+        if (!routed_events[i] || routed != (IInspectable *)&routed_events[i]->IRoutedEvent_iface) continue;
+        *name = routed_event_names[i];
+#ifndef SG_MUTANT_ADD_HANDLER_NOT_JOINED
+        if (i == REV_KEY_DOWN) return xaml_routed_list( elem, XROUTED_KEY_DOWN );
+        if (i == REV_KEY_UP) return xaml_routed_list( elem, XROUTED_KEY_UP );
+#endif
+        return NULL;
+    }
+    return NULL;
