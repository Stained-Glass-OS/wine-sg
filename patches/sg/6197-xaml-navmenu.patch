+
+static HRESULT WINAPI uielement_AddHandler( struct xiface *iface, IInspectable *routed, IInspectable *handler, boolean handled_too )
+{
+    struct uielem *elem = elem_from_iface( iface );
+    struct handler_list *list;
+    const WCHAR *name;
+    INT64 token;
+
+    if (!routed || !handler) return E_INVALIDARG;
+    list = routed_event_list( elem, routed, &name );
+    TRACE( "%p, %s, %p, handled too %d\n", elem, debugstr_w( name ), handler, handled_too );
+    if (!name) return E_INVALIDARG;
+    if (!list) return S_OK;     /* not raised yet */
+    return handlers_add( list, (IUnknown *)handler, &token );
+}
+
+static HRESULT WINAPI uielement_RemoveHandler( struct xiface *iface, IInspectable *routed, IInspectable *handler )
+{
+    struct uielem *elem = elem_from_iface( iface );
+    struct handler_list *list;
+    struct handler_entry *entry;
+    const WCHAR *name;
+
+    if (!routed || !handler) return E_INVALIDARG;
+    if (!(list = routed_event_list( elem, routed, &name ))) return S_OK;
+    LIST_FOR_EACH_ENTRY( entry, &list->entries, struct handler_entry, entry )
+    {
+        if (entry->handler != (IUnknown *)handler) continue;
+        return handlers_remove( list, entry->token );
+    }
+    return S_OK;
+}
