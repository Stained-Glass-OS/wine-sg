+    L"DoubleTapped", L"Holding", L"RightTapped", L"ManipulationStarting", L"ManipulationInertiaStarting",
+    L"ManipulationStarted", L"ManipulationDelta", L"ManipulationCompleted", L"DragEnter", L"DragLeave",
+    L"DragOver", L"Drop",
+};
