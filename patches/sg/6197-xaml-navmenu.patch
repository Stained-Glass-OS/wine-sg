+/* BindingOperations.SetBinding: a binding set from code; a template part's templated parent is the
+ * control whose template made it */
+static BOOL is_within( struct uielem *elem, struct uielem *root )
+{
+    for (; elem; elem = elem->parent) if (elem == root) return TRUE;
+    return FALSE;
+}
+
+struct uielem *xaml_templated_parent_of( struct uielem *elem )
+{
+    struct uielem *up;
+
+    if (!elem) return NULL;
+    for (up = elem->parent; up; up = up->parent)
+    {
+        struct control *control;
+        if (!is_control( &up->d )) continue;
+        control = control_from_elem( up );
+        if (control->template_root && is_within( elem, control->template_root )) return up;
+    }
+    return NULL;
+}
+
+static HRESULT WINAPI ops_SetBinding( struct xfiface *iface, IInspectable *target, IInspectable *property, IInspectable *binding )
+{
+    struct xaml_property *prop = property ? xaml_property_from_inspectable( property ) : NULL;
+    struct uielem *elem = target ? uielem_from_inspectable( target ) : NULL;
+
+    TRACE( "%p, %p (%s), %p\n", target, property, prop ? debugstr_w( prop->name ) : "?", binding );
+    if (!target || !prop || !binding) return E_INVALIDARG;
+#ifdef SG_MUTANT_NO_SET_BINDING
+    return E_NOTIMPL;
+#endif
+    if (!xaml_binding_assign( binding, target, prop->name, xaml_templated_parent_of( elem ) ))
+        FIXME( "%p: not a binding of ours\n", binding );
+    return S_OK;
+}
+
+static const void *ops_statics_vtbl[] = { IBindingOperationsStatics_FSTUBS, [IBindingOperationsStatics_SetBinding] = ops_SetBinding };
+
+static struct xfactory ops_factory_obj =
+    { { &xfactory_vtbl }, L"Windows.UI.Xaml.Data.BindingOperations", { &IID_IBindingOperationsStatics },
+      { { ops_statics_vtbl } }, NULL };
+
 IActivationFactory *xaml_binding_factory( const WCHAR *name )
 {
+    if (!wcscmp( name, ops_factory_obj.name )) return &ops_factory_obj.IActivationFactory_iface;
     if (!wcscmp( name, binding_factory_obj.name )) return &binding_factory_obj.IActivationFactory_iface;
     if (!wcscmp( name, rs_factory_obj.name )) return &rs_factory_obj.IActivationFactory_iface;
     if (!wcscmp( name, path_factory_obj.name )) return &path_factory_obj.IActivationFactory_iface;
