--- a/dlls/wininet/urlcache.c
+++ b/dlls/wininet/urlcache.c
@@ -1867,7 +1867,12 @@ static int urlcache_encode_url(const WCHAR *url, char *encoded_url, int encoded_
     uc.dwStructSize = sizeof(uc);
     uc.dwHostNameLength = 1;
     if(!InternetCrackUrlW(url, 0, 0, &uc))
+    {
+        /* an http(s) URL without a host is not one to cache */
+        if(GetLastError() == ERROR_INTERNET_INVALID_URL)
+            return 0;
         uc.nScheme = INTERNET_SCHEME_UNKNOWN;
+    }
 
     if(uc.nScheme!=INTERNET_SCHEME_HTTP && uc.nScheme!=INTERNET_SCHEME_HTTPS)
