From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet: InternetCrackUrl buffer rules, http host, empty request headers, raw header index

Ground truth from Wine's wininet tests (13 todo_wine removed): a component buffer of length 0 fails with ERROR_INSUFFICIENT_BUFFER (it cannot take the terminator) and reports the length needed; all lengths 0 with buffers given is ERROR_INVALID_PARAMETER; an http or https URL without a host fails (a redirect to one reports ERROR_INTERNET_INVALID_URL as before); ICU_DECODE does not add the slash of an empty path. HttpAddRequestHeaders with ADD and no value fails with ERROR_INVALID_PARAMETER and adds nothing; HttpQueryInfo for the raw headers with a start index other than 0 is ERROR_HTTP_HEADER_NOT_FOUND.
---
--- a/dlls/wininet/http.c
+++ b/dlls/wininet/http.c
@@ -1238,6 +1238,16 @@ static DWORD HTTP_HttpAddRequestHeadersW(http_request_t *request,
         pFieldAndValue = HTTP_InterpretHttpHeader(lpszStart);
         if (pFieldAndValue)
         {
+            /* adding a header with no value is refused (replacing it with none removes it) */
+#ifndef SG_MUTANT_HDR_EMPTY
+            if ((dwModifier & HTTP_ADDREQ_FLAG_ADD) && !(dwModifier & HTTP_ADDREQ_FLAG_REPLACE) &&
+                (!pFieldAndValue[1] || !pFieldAndValue[1][0]))
+            {
+                HTTP_FreeTokens(pFieldAndValue);
+                res = ERROR_INVALID_PARAMETER;
+                break;
+            }
+#endif
             res = HTTP_ProcessHeader(request, pFieldAndValue[0],
                 pFieldAndValue[1], dwModifier | HTTP_ADDHDR_FLAG_REQ);
             HTTP_FreeTokens(pFieldAndValue);
@@ -3706,6 +3716,15 @@ static DWORD HTTP_HttpQueryInfoW(http_request_t *request, DWORD dwInfoLevel,
             DWORD len = 0;
             DWORD res = ERROR_INVALID_PARAMETER;
 
+            /* there is only the one block: no start index but 0 finds it */
+#ifndef SG_MUTANT_RAW_INDEX
+            if (requested_index)
+            {
+                LeaveCriticalSection( &request->headers_section );
+                return ERROR_HTTP_HEADER_NOT_FOUND;
+            }
+#endif
+
             if (request_only)
                 headers = build_request_header(request, request->verb, request->path, request->version, TRUE);
             else
@@ -3739,6 +3758,14 @@ static DWORD HTTP_HttpQueryInfoW(http_request_t *request, DWORD dwInfoLevel,
             LPWSTR headers;
             DWORD len;
 
+#ifndef SG_MUTANT_RAW_INDEX
+            if (requested_index)
+            {
+                LeaveCriticalSection( &request->headers_section );
+                return ERROR_HTTP_HEADER_NOT_FOUND;
+            }
+#endif
+
             if (request_only)
                 headers = build_request_header(request, request->verb, request->path, request->version, FALSE);
             else
@@ -4244,7 +4271,7 @@ static DWORD HTTP_HandleRedirect(http_request_t *request, WCHAR *url)
         urlComponents.dwUserNameLength = 1;
         urlComponents.dwUrlPathLength = 1;
         if(!InternetCrackUrlW(url, url_len, 0, &urlComponents))
-            return INTERNET_GetLastError();
+            return GetLastError() == ERROR_INTERNET_INVALID_URL ? ERROR_INTERNET_INVALID_URL : INTERNET_GetLastError();
 
         if(!urlComponents.dwHostNameLength)
             return ERROR_INTERNET_INVALID_URL;
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -1903,7 +1903,18 @@ static BOOL set_url_component(WCHAR **component, DWORD *component_length, const
     TRACE("%s (%ld)\n", debugstr_wn(value, len), len);
 
     if (!*component_length)
+    {
+        /* a buffer of no size cannot take even the terminator */
+#ifndef SG_MUTANT_CRACK_ZERO_BUFFER
+        if (*component)
+        {
+            *component_length = len + 1;
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            return FALSE;
+        }
+#endif
         return TRUE;
+    }
 
     if (!*component) {
         *(const WCHAR**)component = value;
@@ -1928,9 +1939,19 @@ static BOOL set_url_component_WtoA(const WCHAR *comp_w, DWORD length, const WCHA
 {
     size_t size, ret_size = *ret_length;
 
+    size = WideCharToMultiByte(CP_ACP, 0, comp_w, length, NULL, 0, NULL, NULL);
     if (!*ret_length)
+    {
+#ifndef SG_MUTANT_CRACK_ZERO_BUFFER
+        if (*comp)
+        {
+            *ret_length = size + 1;
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            return FALSE;
+        }
+#endif
         return TRUE;
-    size = WideCharToMultiByte(CP_ACP, 0, comp_w, length, NULL, 0, NULL, NULL);
+    }
 
     if (!*comp) {
         *comp = comp_w ? (char*)url_a + WideCharToMultiByte(CP_ACP, 0, url_w, comp_w-url_w, NULL, 0, NULL, NULL) : NULL;
@@ -2113,6 +2134,18 @@ BOOL WINAPI InternetCrackUrlW(const WCHAR *lpszUrl, DWORD dwUrlLength, DWORD dwF
         return FALSE;
     }
 
+    /* every length 0 while a buffer is given: nothing can be returned */
+#ifndef SG_MUTANT_CRACK_ALL_ZERO
+    if (!lpUC->dwSchemeLength && !lpUC->dwHostNameLength && !lpUC->dwUserNameLength &&
+        !lpUC->dwPasswordLength && !lpUC->dwUrlPathLength && !lpUC->dwExtraInfoLength &&
+        (lpUC->lpszScheme || lpUC->lpszHostName || lpUC->lpszUserName || lpUC->lpszPassword ||
+         lpUC->lpszUrlPath || lpUC->lpszExtraInfo))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+#endif
+
     if (!dwUrlLength)
         dwUrlLength = lstrlenW(lpszUrl);
     else {
@@ -2146,7 +2179,15 @@ BOOL WINAPI InternetCrackUrlW(const WCHAR *lpszUrl, DWORD dwUrlLength, DWORD dwF
             ret = InternetCanonicalizeUrlW(url_tmp, buffer, &len, ICU_DECODE | ICU_NO_ENCODE);
         }
         if (ret)
+        {
+            /* canonicalising adds the "/" of an empty path, cracking does not */
+            const WCHAR *auth = wcsstr(url_tmp, L"://");
+
+#ifndef SG_MUTANT_CRACK_DECODE_SLASH
+            if (auth && len && buffer[len - 1] == '/' && !wcspbrk(auth + 3, L"/?#")) len--;
+#endif
             ret = InternetCrackUrlW(buffer, len, dwFlags & ~ICU_DECODE, lpUC);
+        }
 
         if (buffer != url_tmp) free(buffer);
         free(url_tmp);
@@ -2289,6 +2330,15 @@ BOOL WINAPI InternetCrackUrlW(const WCHAR *lpszUrl, DWORD dwUrlLength, DWORD dwF
                 }
                 else
                 {
+                    /* an http(s) URL names a host */
+#ifndef SG_MUTANT_CRACK_NO_HOST
+                    if (lpszPort == lpszHost &&
+                        (lpUC->nScheme == INTERNET_SCHEME_HTTP || lpUC->nScheme == INTERNET_SCHEME_HTTPS))
+                    {
+                        SetLastError(ERROR_INTERNET_INVALID_URL);
+                        return FALSE;
+                    }
+#endif
                     if(!set_url_component(&lpUC->lpszHostName, &lpUC->dwHostNameLength, lpszHost, lpszPort - lpszHost))
                         return FALSE;
                     if (lpszPort != lpszNetLoc)
--- a/dlls/wininet/tests/http.c
