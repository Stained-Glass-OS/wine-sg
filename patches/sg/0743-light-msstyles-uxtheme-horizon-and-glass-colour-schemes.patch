From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] light.msstyles, uxtheme: Horizon and Glass colour schemes

David: each look complete and close to its era -- buttons, check boxes,
scroll bars, menus and the system colours too, not only the frames (0742).
light.msstyles carries two more colour schemes, "Horizon" and "Glass"
(COLORNAMES, FILERESNAMES, display names), generated, never drawn by hand:
wine-sg's theme/eras.py draws the main controls' images from shapes and
colours it writes out and recolours the rest of Light's, and writes their
INIs with the era's system colours (eras.rc, which light.rc includes;
build.sh runs it after rounded.py).

uxtheme's RefreshImmersiveColorPolicyState takes Horizon or Glass while
HKCU\Software\Stained Glass\Style Frame is 1 or 2 (the looks' frames), in
either app mode -- those desktops had no dark mode; Rounded, Blue and Dark
otherwise, as before.
---
--- a/dlls/light.msstyles/light.rc
+++ b/dlls/light.msstyles/light.rc
@@ -29,6 +29,8 @@
     IDS_COLOR_DISPLAY_NAME_DARK         "Dark"
     IDS_COLOR_DISPLAY_NAME_ROUNDED      "Rounded"
     IDS_COLOR_DISPLAY_NAME_ROUNDEDDARK  "Rounded Dark"
+    IDS_COLOR_DISPLAY_NAME_HORIZON      "Horizon"
+    IDS_COLOR_DISPLAY_NAME_GLASS        "Glass"
 }
 
 /* Theme color tooltips */
@@ -38,6 +40,8 @@
     IDS_COLOR_TOOLTIP_DARK         "Dark"
     IDS_COLOR_TOOLTIP_ROUNDED      "Rounded"
     IDS_COLOR_TOOLTIP_ROUNDEDDARK  "Rounded Dark"
+    IDS_COLOR_TOOLTIP_HORIZON      "Horizon"
+    IDS_COLOR_TOOLTIP_GLASS        "Glass"
 }
 
 /* Theme size display names */
@@ -64,6 +68,8 @@
 "Dark\0"
 "Rounded\0"
 "RoundedDark\0"
+"Horizon\0"
+"Glass\0"
 "\0"
 }
 
@@ -81,6 +87,8 @@
 "DARK_INI\0"
 "ROUNDED_INI\0"
 "ROUNDEDDARK_INI\0"
+"HORIZON_INI\0"
+"GLASS_INI\0"
 "\0"
 }
 
@@ -4590,6 +4598,10 @@
  * by wine-sg theme/rounded.py from BLUE_INI and the Light images. */
 #include "rounded.rc"
 
+/* The Horizon and Glass colour schemes (the Horizon and Glass looks):
+ * generated by wine-sg theme/eras.py from BLUE_INI and the Light images. */
+#include "eras.rc"
+
 /* File version */
 #define WINE_FILEDESCRIPTION_STR "Light Theme"
 #define WINE_FILENAME_STR "light.msstyles"
--- a/dlls/light.msstyles/resources.h
+++ b/dlls/light.msstyles/resources.h
@@ -22,9 +22,13 @@
 #define IDS_COLOR_DISPLAY_NAME_DARK            1001
 #define IDS_COLOR_DISPLAY_NAME_ROUNDED         1002
 #define IDS_COLOR_DISPLAY_NAME_ROUNDEDDARK     1003
+#define IDS_COLOR_DISPLAY_NAME_HORIZON         1004
+#define IDS_COLOR_DISPLAY_NAME_GLASS           1005
 #define IDS_COLOR_TOOLTIP_BLUE                 2000
 #define IDS_COLOR_TOOLTIP_DARK                 2001
 #define IDS_COLOR_TOOLTIP_ROUNDED              2002
 #define IDS_COLOR_TOOLTIP_ROUNDEDDARK          2003
+#define IDS_COLOR_TOOLTIP_HORIZON              2004
+#define IDS_COLOR_TOOLTIP_GLASS                2005
 #define IDS_SIZE_DISPLAY_NAME_NORMAL           3000
 #define IDS_SIZE_TOOLTIP_NORMAL                4000
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -645,7 +645,7 @@
 {
     WCHAR theme[MAX_PATH], color[64], size[64];
     PTHEME_FILE light = NULL, dark = NULL, rounded = NULL, want;
-    DWORD style = 0, len = sizeof(style);
+    DWORD style = 0, frame = 0, len = sizeof(style);
     BOOL active, dark_mode;
 
     UXTHEME_FollowThemeChange();
@@ -657,7 +657,14 @@
     /* Stained Glass OS: the Rounded style (HKCU\Software\Stained Glass\Style
      * Rounded) takes the style's Rounded or Rounded Dark scheme, if it has them */
     RegGetValueW(HKEY_CURRENT_USER, L"Software\\Stained Glass\\Style", L"Rounded", RRF_RT_REG_DWORD, NULL, &style, &len);
-    if (style) MSSTYLES_OpenThemeFile(theme, dark_mode ? L"RoundedDark" : L"Rounded", size[0] ? size : NULL, &rounded);
+    /* the Horizon and Glass looks (Style Frame 1 and 2, 0742) take their
+     * own schemes, which have no dark counterpart, as those desktops had none */
+    len = sizeof(frame);
+    RegGetValueW(HKEY_CURRENT_USER, L"Software\\Stained Glass\\Style", L"Frame", RRF_RT_REG_DWORD, NULL, &frame, &len);
+#ifndef SG_MUTANT_NOERASCHEMES
+    if (frame == 1 || frame == 2) MSSTYLES_OpenThemeFile(theme, frame == 1 ? L"Horizon" : L"Glass", size[0] ? size : NULL, &rounded);
+#endif
+    if (style && !rounded) MSSTYLES_OpenThemeFile(theme, dark_mode ? L"RoundedDark" : L"Rounded", size[0] ? size : NULL, &rounded);
     if (SUCCEEDED(MSSTYLES_OpenThemeFile(theme, NULL, size[0] ? size : NULL, &light)))
     {
         want = rounded ? rounded : dark_mode ? dark : light;
