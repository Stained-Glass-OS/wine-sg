+static void network_config_init(struct network_config *config)
+{
+    unsigned int i;
+
+    config->buffering_time = 5 * 10000000; /* 5 seconds */
+    for (i = 0; i < PROXY_COUNT; i++)
+        config->proxy[i].setting = WMT_PROXY_SETTING_BROWSER;
+    config->multicast = config->http = config->udp = config->tcp = TRUE;
+    config->content_caching = config->fast_cache = TRUE;
+    config->reconnect_limit = 3;
+    config->resends = config->thinning = TRUE;
+    config->max_packet_size = 1500;
+}
+
+static void network_config_free(struct network_config *config)
+{
+    unsigned int i;
+
+    free(config->udp_ranges);
+    for (i = 0; i < PROXY_COUNT; i++)
+    {
+        free(config->proxy[i].host);
+        free(config->proxy[i].exceptions);
+    }
+    for (i = 0; i < config->logging_url_count; i++)
+        free(config->logging_urls[i]);
+    free(config->logging_urls);
+}
