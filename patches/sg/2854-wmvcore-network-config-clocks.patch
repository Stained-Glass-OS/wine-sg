+/* The Windows Media Format SDK string getters: a NULL buffer returns the
+ * length needed, in characters including the terminator; a short buffer
+ * returns that length with ASF_E_BUFFERTOOSMALL. */
+static HRESULT copy_string_out(const WCHAR *str, WCHAR *out, DWORD *len)
+{
+    DWORD length = str ? wcslen(str) : 0;
+    DWORD size = length + 1;
+
+    if (!len)
+        return E_INVALIDARG;
+
+#ifdef SG_MUTANT_WMV_STRLEN
+    size--;
+#endif
+    if (!out)
+    {
+        *len = size;
+        return S_OK;
+    }
+    if (*len < size)
+    {
+        *len = size;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    if (length)
+        memcpy(out, str, length * sizeof(WCHAR));
+    out[length] = 0;
+    *len = size;
+    return S_OK;
+}
+
+static HRESULT replace_string(WCHAR **dst, const WCHAR *src)
+{
+    WCHAR *copy;
+
+    if (!src)
+        return E_INVALIDARG;
+    if (!(copy = wcsdup(src)))
+        return E_OUTOFMEMORY;
+    free(*dst);
+    *dst = copy;
+    return S_OK;
+}
+
+static int find_protocol(const WCHAR *protocol)
+{
+    unsigned int i;
+
+    if (!protocol)
+        return -1;
+    for (i = 0; i < PROXY_COUNT; i++)
+    {
+        if (!wcsicmp(protocol, protocol_names[i]))
+#ifdef SG_MUTANT_WMV_PROXY_SHARED
+            return 0;
+#else
+            return i;
+#endif
+    }
+    return -1;
+}
