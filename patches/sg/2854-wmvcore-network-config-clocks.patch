+static void clock_timer_destroy(struct clock_timer *timer)
+{
+    /* waits for a callback that is running */
+    if (timer->handle)
+        DeleteTimerQueueTimer(NULL, timer->handle, INVALID_HANDLE_VALUE);
+    free(timer);
+}
+
+/* Removes the timers of one kind (or all of them) and waits for their callbacks. */
+static void clock_timers_remove(struct async_reader *reader, bool stream_only)
+{
+    struct clock_timer *timer, *next;
+    struct list removed = LIST_INIT(removed);
+
+    EnterCriticalSection(&reader->timer_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(timer, next, &reader->timers, struct clock_timer, entry)
+    {
+        if (stream_only && timer->type != TIMER_STREAM)
+            continue;
+        list_remove(&timer->entry);
+        list_add_tail(&removed, &timer->entry);
+    }
+    LeaveCriticalSection(&reader->timer_cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(timer, next, &removed, struct clock_timer, entry)
+    {
+        list_remove(&timer->entry);
+        clock_timer_destroy(timer);
+    }
+}
+
+static void clock_timers_free(struct async_reader *reader)
+{
+    clock_timers_remove(reader, false);
+}
+
+static HRESULT clock_timer_add(struct async_reader *reader, enum timer_type type, DWORD *id,
+        WAITORTIMERCALLBACK proc, DWORD due_ms, DWORD period_ms, struct clock_timer **out)
+{
+    struct clock_timer *timer;
+
+    if (!(timer = calloc(1, sizeof(*timer))))
+        return E_OUTOFMEMORY;
+    timer->reader = reader;
+    timer->type = type;
+
+    EnterCriticalSection(&reader->timer_cs);
+    timer->id = ++reader->next_timer_id;
+    list_add_tail(&reader->timers, &timer->entry);
+    LeaveCriticalSection(&reader->timer_cs);
+    *id = timer->id;
+    *out = timer;
+    return S_OK;
+}
+
+static HRESULT clock_timer_start(struct clock_timer *timer, WAITORTIMERCALLBACK proc, DWORD due_ms, DWORD period_ms)
+{
+    HANDLE handle;
+
+    if (!CreateTimerQueueTimer(&handle, NULL, proc, timer, due_ms, period_ms,
+            period_ms ? WT_EXECUTEDEFAULT : WT_EXECUTEONLYONCE))
+        return HRESULT_FROM_WIN32(GetLastError());
+    timer->handle = handle;
+    return S_OK;
+}
+
+static QWORD get_stream_time(struct async_reader *reader)
+{
+    QWORD time;
+
+    EnterCriticalSection(&reader->callback_cs);
+    if (reader->user_clock)
+        time = reader->user_time;
+    else if (reader->clock_start)
+        time = get_current_time(reader) - reader->clock_start;
+    else
+        time = 0;
+    LeaveCriticalSection(&reader->callback_cs);
+    return time;
+}
+
+static void CALLBACK stream_timer_proc(void *param, BOOLEAN timed_out)
+{
+    struct clock_timer *timer = param;
+    struct async_reader *reader = timer->reader;
+
+    if (reader->callback_advanced)
+        IWMReaderCallbackAdvanced_OnTime(reader->callback_advanced, timer->u.stream.when, timer->u.stream.param);
+}
+
+static void CALLBACK event_timer_proc(void *param, BOOLEAN timed_out)
+{
+    struct clock_timer *timer = param;
+    SetEvent(timer->u.sync);
+}
+
+static void CALLBACK semaphore_timer_proc(void *param, BOOLEAN timed_out)
+{
+    struct clock_timer *timer = param;
+    ReleaseSemaphore(timer->u.sync, 1, NULL);
+}
+
+static DWORD reference_delay_ms(struct async_reader *reader, REFERENCE_TIME due)
+{
+    REFERENCE_TIME now = get_current_time(reader);
+
+    return due > now ? (DWORD)min((due - now) / 10000, 0x7fffffff) : 0;
+}
