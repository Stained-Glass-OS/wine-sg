+/* With a clock provided by the program the timers are due when it reaches their time. */
+static void fire_user_clock_timers(struct async_reader *reader, QWORD time)
+{
+    struct clock_timer *timer;
+    struct { QWORD when; void *param; } due[16];
+    unsigned int count = 0, i;
+
+    EnterCriticalSection(&reader->timer_cs);
+    LIST_FOR_EACH_ENTRY(timer, &reader->timers, struct clock_timer, entry)
+    {
+        if (timer->type != TIMER_STREAM || timer->handle || timer->u.stream.when == ~(QWORD)0)
+            continue;
+#ifndef SG_MUTANT_WMV_USERCLOCK_EARLY
+        if (timer->u.stream.when > time)
+            continue;
+#endif
+        if (count == ARRAY_SIZE(due))
+            break;
+        due[count].when = timer->u.stream.when;
+        due[count++].param = timer->u.stream.param;
+        timer->u.stream.when = ~(QWORD)0; /* fired */
+    }
+    LeaveCriticalSection(&reader->timer_cs);
+
+    for (i = 0; i < count; i++)
+        if (reader->callback_advanced)
+            IWMReaderCallbackAdvanced_OnTime(reader->callback_advanced, due[i].when, due[i].param);
 }
 
