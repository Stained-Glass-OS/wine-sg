+static void widen_figure(GpPath *path, int start, int end, int closed, GpPen *pen, REAL pen_width,
+    path_list_node_t **last_point)
+{
+    if (pen->dash != DashStyleSolid)
+        widen_dashed_figure(path, start, end, closed, pen, pen_width, last_point);
+    else if (closed)
+        widen_closed_figure(path->pathdata.Points, start, end, pen, pen_width, last_point);
+    else
+        widen_open_figure(path->pathdata.Points, start, end, pen, pen_width,
+            pen->startcap, pen->customstart, pen->endcap, pen->customend, last_point);
+}
