+/* wine-sg 9503: a figure drawn with the pen's compound array (each pair of values is a band of the pen's
+ * width, measured from its edge on the side opposite the normal (-dy, dx)) and alignment (an inset pen
+ * draws a closed figure's stroke inside it; open figures are drawn centred) */
+static void widen_pen_figure(GpPath *path, int start, int end, int closed, GpPen *pen, REAL pen_width,
+    path_list_node_t **last_point)
+{
+    REAL base = 0.0;
+    int i;
+
+#ifndef SG_MUTANT_GDIP_NO_INSET
+    if (pen->align == PenAlignmentInset && closed)
+    {
+        /* the inside is the side of the normal (-dy, dx) when the signed area is positive */
+        const GpPointF *pts = path->pathdata.Points;
+        REAL area = 0.0;
+
+        for (i = start; i <= end; i++)
+        {
+            const GpPointF *a = &pts[i], *b = &pts[i == end ? start : i + 1];
+            area += a->X * b->Y - b->X * a->Y;
+        }
+        if (area != 0.0) base = (area > 0.0 ? 0.5 : -0.5) * pen_width;
+    }
+#endif
+
+#ifndef SG_MUTANT_GDIP_NO_COMPOUND
+    if (pen->compound_array_size >= 2)
+    {
+        for (i = 0; i + 1 < pen->compound_array_size; i += 2)
+        {
+            REAL a = pen->compound_array[i], b = pen->compound_array[i + 1];
+
+            if (b <= a) continue;
+            widen_offset_figure(path, start, end, closed, pen, (b - a) * pen_width,
+                base + ((a + b) / 2.0 - 0.5) * pen_width, last_point);
+        }
+        return;
+    }
+#endif
+    widen_offset_figure(path, start, end, closed, pen, pen_width, base, last_point);
+}
