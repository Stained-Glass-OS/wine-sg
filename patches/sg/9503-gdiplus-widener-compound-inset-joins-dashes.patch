+/* wine-sg 9503: the unit normal (-dy, dx) of the segment from A to B; FALSE when it has no length */
+static BOOL segment_normal(const GpPointF *a, const GpPointF *b, GpPointF *n)
+{
+    REAL len = hypotf(b->X - a->X, b->Y - a->Y);
+    if (len == 0.0) return FALSE;
+    n->X = -(b->Y - a->Y) / len;
+    n->Y = (b->X - a->X) / len;
+    return TRUE;
+}
+
+/* wine-sg 9503: a figure's stroke moved sideways by DISTANCE along the segments' normals (-dy, dx), the
+ * corners mitred (at most 4 times the distance): one band of a compound line, or an inset pen's stroke */
+static void widen_offset_figure(GpPath *path, int start, int end, int closed, GpPen *pen, REAL pen_width,
+    REAL distance, path_list_node_t **last_point)
+{
+    const GpPointF *pts = path->pathdata.Points;
+    int count = end - start + 1, i, k;
+    GpPointF *moved;
+    BYTE *types;
+    GpPath *tmp;
+
+    if (distance == 0.0)
+    {
+        widen_figure(path, start, end, closed, pen, pen_width, last_point);
+        return;
+    }
+    moved = malloc(count * sizeof(*moved));
+    types = malloc(count);
+    if (!moved || !types) goto done;
+
+    for (i = 0; i < count; i++)
+    {
+        GpPointF n0, n1, v;
+        BOOL has0 = FALSE, has1 = FALSE;
+        REAL denom, len;
+
+        /* the segments into and out of the point, skipping repeated points */
+        for (k = 1; k < count && !has0; k++)
+        {
+            int prev = i - k;
+            if (prev < 0) { if (!closed) break; prev += count; }
+            has0 = segment_normal(&pts[start + prev], &pts[start + i], &n0);
+        }
+        for (k = 1; k < count && !has1; k++)
+        {
+            int next = i + k;
+            if (next >= count) { if (!closed) break; next -= count; }
+            has1 = segment_normal(&pts[start + i], &pts[start + next], &n1);
+        }
+        if (!has0) n0 = has1 ? n1 : (GpPointF){0, 0};
+        if (!has1) n1 = n0;
+        denom = 1.0 + n0.X * n1.X + n0.Y * n1.Y;
+        if (denom < 1e-3)
+        {
+            v = n1;
+            v.X *= distance;
+            v.Y *= distance;
+        }
+        else
+        {
+            v.X = distance * (n0.X + n1.X) / denom;
+            v.Y = distance * (n0.Y + n1.Y) / denom;
+        }
+        len = hypotf(v.X, v.Y);
+        if (len > 4.0 * fabsf(distance))
+        {
+            v.X *= 4.0 * fabsf(distance) / len;
+            v.Y *= 4.0 * fabsf(distance) / len;
+        }
+        moved[i].X = pts[start + i].X + v.X;
+        moved[i].Y = pts[start + i].Y + v.Y;
+        types[i] = (path->pathdata.Types[start + i] & ~PathPointTypePathTypeMask) | PathPointTypeLine;
+    }
+    types[0] = (types[0] & ~PathPointTypePathTypeMask) | PathPointTypeStart;
+
+    if (GdipCreatePath2(moved, types, count, path->fill, &tmp) == Ok)
+    {
+        widen_figure(tmp, 0, count - 1, closed, pen, pen_width, last_point);
+        GdipDeletePath(tmp);
+    }
+done:
+    free(moved);
+    free(types);
+}
