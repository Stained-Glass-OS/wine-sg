+/* wine-sg 9503: what a GDI pen cannot draw -- pen transforms, compound lines, inset alignment, dash caps
+ * and dash offsets -- goes through GDI+'s own widener */
+static BOOL pen_needs_widener(const GpPen *pen)
+{
+    BOOL identity = TRUE;
+
+    GdipIsMatrixIdentity(&pen->transform, &identity);
+    if (!identity || pen->compound_array_size || pen->align == PenAlignmentInset) return TRUE;
+    return pen->dash != DashStyleSolid && (pen->dashcap != DashCapFlat || pen->offset != 0.0);
+}
