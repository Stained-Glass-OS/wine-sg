+/* wine-sg 9503: a circular arc around CENTER from FROM to TO (the short way), as Bezier pieces of at most
+ * 90 degrees, after a line to FROM */
+static void add_arc_points(const GpPointF *center, const GpPointF *from, const GpPointF *to,
+    path_list_node_t **last_point)
+{
+    REAL r = hypotf(from->X - center->X, from->Y - center->Y);
+    REAL a0 = atan2f(from->Y - center->Y, from->X - center->X);
+    REAL sweep = atan2f(to->Y - center->Y, to->X - center->X) - a0;
+    int pieces, i;
+
+    while (sweep > M_PI) sweep -= 2 * M_PI;
+    while (sweep < -M_PI) sweep += 2 * M_PI;
+    *last_point = add_path_list_node(*last_point, from->X, from->Y, PathPointTypeLine);
+    pieces = (int)ceilf(fabsf(sweep) / (M_PI / 2) - 0.001);
+    for (i = 0; i < pieces; i++)
+    {
+        REAL a = a0 + sweep * i / pieces, b = a0 + sweep * (i + 1) / pieces;
+        REAL k = 4.0 / 3.0 * tanf((b - a) / 4) * r;
+        REAL x0 = center->X + r * cosf(a), y0 = center->Y + r * sinf(a);
+        REAL x3 = center->X + r * cosf(b), y3 = center->Y + r * sinf(b);
+
+        *last_point = add_path_list_node(*last_point, x0 - k * sinf(a), y0 + k * cosf(a), PathPointTypeBezier);
+        *last_point = add_path_list_node(*last_point, x3 + k * sinf(b), y3 - k * cosf(b), PathPointTypeBezier);
+        *last_point = add_path_list_node(*last_point, (i == pieces - 1) ? to->X : x3,
+            (i == pieces - 1) ? to->Y : y3, PathPointTypeBezier);
+    }
+}
