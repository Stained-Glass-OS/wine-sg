From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msdasql: views and procedure parameter schema rowsets

IDBSchemaRowset gives DBSCHEMA_VIEWS (SQLTables of table type VIEW; restrictions catalog, schema, name) and DBSCHEMA_PROCEDURE_PARAMETERS (SQLProcedureColumns; restrictions catalog, schema, procedure, parameter name; the procedure's result-set columns left out, the ODBC column type mapped to DBPARAMTYPE_*). They were E_INVALIDARG (unknown schema), so ADO OpenSchema(adSchemaViews / adSchemaProcedureParameters) failed.
---
--- a/dlls/msdasql/session.c
+++ b/dlls/msdasql/session.c
@@ -845,7 +845,7 @@
  * function's columns they come from */
 enum schema_conv { SC_COPY, SC_NULL, SC_NULLABLE_BOOL, SC_SQLTYPE_TO_DBTYPE, SC_IF_CHAR, SC_IF_NUMERIC, SC_HAS_VALUE,
                    /* (wine-sg 8224) */ SC_RULE, SC_DEFERRABILITY, SC_BOOL, SC_NOT_BOOL, SC_EQ1_BOOL, SC_INDEX_TYPE,
-                   SC_COLLATION, SC_SEARCHABLE, SC_IS_LONG };
+                   SC_COLLATION, SC_SEARCHABLE, SC_IS_LONG, /* (wine-sg 8230) */ SC_PARAM_TYPE };
 
 struct schema_col
 {
@@ -3068,6 +3068,38 @@
 };
 #endif
 
+#ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
+/* (wine-sg 8230) views (SQLTables of table type VIEW) and procedure parameters (SQLProcedureColumns, the
+ * result-set columns left out) */
+static const GUID DBSCHEMA_PROCEDURE_PARAMETERS_ = {0xc8b522b8,0x5cf3,0x11ce,{0xad,0xe5,0x00,0xaa,0x00,0x44,0x77,0x3d}};
+#ifndef DBPARAMTYPE_INPUT
+#define DBPARAMTYPE_INPUT       1
+#define DBPARAMTYPE_INPUTOUTPUT 2
+#define DBPARAMTYPE_OUTPUT      3
+#define DBPARAMTYPE_RETURNVALUE 4
+#endif
+
+static const struct schema_col views_cols[] =
+{
+    { L"TABLE_CATALOG", DBTYPE_WSTR, 1 }, { L"TABLE_SCHEMA", DBTYPE_WSTR, 2 }, { L"TABLE_NAME", DBTYPE_WSTR, 3 },
+    { L"VIEW_DEFINITION", DBTYPE_WSTR, 0, SC_NULL }, { L"CHECK_OPTION", DBTYPE_BOOL, 0, SC_NULL },
+    { L"IS_UPDATABLE", DBTYPE_BOOL, 0, SC_NULL }, { L"DESCRIPTION", DBTYPE_WSTR, 5 },
+    { L"DATE_CREATED", DBTYPE_DATE, 0, SC_NULL }, { L"DATE_MODIFIED", DBTYPE_DATE, 0, SC_NULL },
+};
+
+static const struct schema_col procedure_parameters_cols[] =
+{
+    { L"PROCEDURE_CATALOG", DBTYPE_WSTR, 1 }, { L"PROCEDURE_SCHEMA", DBTYPE_WSTR, 2 },
+    { L"PROCEDURE_NAME", DBTYPE_WSTR, 3 }, { L"PARAMETER_NAME", DBTYPE_WSTR, 4 },
+    { L"ORDINAL_POSITION", DBTYPE_UI2, 18 }, { L"PARAMETER_TYPE", DBTYPE_UI2, 5, SC_PARAM_TYPE },
+    { L"PARAMETER_HASDEFAULT", DBTYPE_BOOL, 14, SC_HAS_VALUE }, { L"PARAMETER_DEFAULT", DBTYPE_WSTR, 14 },
+    { L"IS_NULLABLE", DBTYPE_BOOL, 12, SC_NULLABLE_BOOL }, { L"DATA_TYPE", DBTYPE_UI2, 6, SC_SQLTYPE_TO_DBTYPE },
+    { L"CHARACTER_MAXIMUM_LENGTH", DBTYPE_UI4, 8, SC_IF_CHAR }, { L"CHARACTER_OCTET_LENGTH", DBTYPE_UI4, 17, SC_IF_CHAR },
+    { L"NUMERIC_PRECISION", DBTYPE_UI2, 8, SC_IF_NUMERIC }, { L"NUMERIC_SCALE", DBTYPE_I2, 10, SC_IF_NUMERIC },
+    { L"DESCRIPTION", DBTYPE_WSTR, 13 }, { L"TYPE_NAME", DBTYPE_WSTR, 7 }, { L"LOCAL_TYPE_NAME", DBTYPE_WSTR, 7 },
+};
+#endif
+
 static const struct schema_desc schemas[] =
 {
     { &DBSCHEMA_TABLES, 0xf, ARRAY_SIZE(tables_cols), tables_cols },
@@ -3080,6 +3112,10 @@
     { &DBSCHEMA_INDEXES, 0x13, ARRAY_SIZE(indexes_cols), indexes_cols },
     { &DBSCHEMA_PROVIDER_TYPES, 0, ARRAY_SIZE(provider_types_cols), provider_types_cols },
 #endif
+#ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
+    { &DBSCHEMA_VIEWS, 0x7, ARRAY_SIZE(views_cols), views_cols },
+    { &DBSCHEMA_PROCEDURE_PARAMETERS_, 0xf, ARRAY_SIZE(procedure_parameters_cols), procedure_parameters_cols },
+#endif
 };
 
 static BOOL is_char_sqltype( SQLSMALLINT type )
@@ -3157,6 +3193,14 @@
             if (!v->null && wcstol( v->text, NULL, 10 ) == SQL_TABLE_STAT) continue;
         }
 #endif
+#ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
+        /* a procedure's result-set columns are no parameters */
+        if (desc->cols == procedure_parameters_cols)
+        {
+            v = schema_get( rowset->hstmt, cache, 5 );
+            if (!v->null && wcstol( v->text, NULL, 10 ) == SQL_RESULT_COL) continue;
+        }
+#endif
         break;
     }
     /* the ODBC data type, which some columns depend on */
@@ -3165,6 +3209,13 @@
         v = schema_get( rowset->hstmt, cache, 5 );
         data_type = v->null ? 0 : wcstol( v->text, NULL, 10 );
     }
+#ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
+    else if (desc->cols == procedure_parameters_cols)
+    {
+        v = schema_get( rowset->hstmt, cache, 6 );
+        data_type = v->null ? 0 : wcstol( v->text, NULL, 10 );
+    }
+#endif
 
     for (i = 0; i < ncols && i < desc->ncols; i++)
     {
@@ -3235,6 +3286,11 @@
                 continue;
             }
 #endif
+#ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
+            if (col->conv == SC_PARAM_TYPE)   /* SQL_PARAM_TYPE_UNKNOWN taken as an input (GUESS) */
+                value = value == SQL_PARAM_INPUT_OUTPUT ? DBPARAMTYPE_INPUTOUTPUT : value == SQL_PARAM_OUTPUT
+                        ? DBPARAMTYPE_OUTPUT : value == SQL_RETURN_VALUE ? DBPARAMTYPE_RETURNVALUE : DBPARAMTYPE_INPUT;
+#endif
             if (col->conv == SC_SQLTYPE_TO_DBTYPE) value = sqltype_to_bindtype( value, TRUE );
             if (!(buf = calloc( 1, 8 )))
             {
@@ -3379,6 +3435,14 @@
     else if (IsEqualGUID( desc->guid, &DBSCHEMA_PROVIDER_TYPES ))
         ret = SQLGetTypeInfoW( hstmt, SQL_ALL_TYPES );
 #endif
+#ifndef SG_MUTANT_NO_VIEW_PARAM_SCHEMAS
+    else if (IsEqualGUID( desc->guid, &DBSCHEMA_VIEWS ))
+        ret = SQLTablesW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2],
+                          (SQLWCHAR *)L"VIEW", SQL_NTS );
+    else if (desc->cols == procedure_parameters_cols)
+        ret = SQLProcedureColumnsW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2],
+                                    len[2], (SQLWCHAR *)r[3], len[3] );
+#endif
     else
         ret = SQLPrimaryKeysW( hstmt, (SQLWCHAR *)r[0], len[0], (SQLWCHAR *)r[1], len[1], (SQLWCHAR *)r[2], len[2] );
     if (!SQL_SUCCEEDED(ret))
