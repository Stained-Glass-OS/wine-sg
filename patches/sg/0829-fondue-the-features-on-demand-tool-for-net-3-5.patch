From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] fondue: the Features on Demand tool, for the .NET Framework 3.5

Programs that need an optional feature start "fondue.exe
/enable-feature:NetFx3 [/caller-name:NAME] [/hide-ux:all]" and wait for
its exit code, 0 when the feature is on; Wine had no fondue.exe, so they
could not start it and took 3.5 for missing.

fondue.exe now exists (system32 and syswow64) and answers from the same
features as dism.exe (programs/dism/features.c): 0 when the feature is on
(the .NET Framework registered as installed, Wine Mono's); when it is not,
it says so in a message box (not with /hide-ux:all) and exits with DISM's
"source files not found"; an unknown feature with DISM's "unknown
feature".

Test: test/netfx3-gate.sh (mutant SG_MUTANT_FONDUE).
---
--- a/configure.ac
+++ b/configure.ac
@@ -3473,6 +3473,7 @@
 WINE_CONFIG_MAKEFILE(programs/find)
 WINE_CONFIG_MAKEFILE(programs/find/tests)
 WINE_CONFIG_MAKEFILE(programs/findstr)
+WINE_CONFIG_MAKEFILE(programs/fondue)
 WINE_CONFIG_MAKEFILE(programs/fontview)
 WINE_CONFIG_MAKEFILE(programs/findstr/tests)
 WINE_CONFIG_MAKEFILE(programs/fsutil)
--- a/configure
+++ b/configure
@@ -1690,6 +1690,7 @@
 enable_fc
 enable_find
 enable_findstr
+enable_fondue
 enable_fontview
 enable_fsutil
 enable_hh
@@ -23155,6 +23156,7 @@
 wine_fn_config_makefile programs/find enable_find
 wine_fn_config_makefile programs/find/tests enable_tests
 wine_fn_config_makefile programs/findstr enable_findstr
+wine_fn_config_makefile programs/fondue enable_fondue
 wine_fn_config_makefile programs/fontview enable_fontview
 wine_fn_config_makefile programs/findstr/tests enable_tests
 wine_fn_config_makefile programs/fsutil enable_fsutil
--- /dev/null
+++ b/programs/fondue/Makefile.in
@@ -0,0 +1,9 @@
+MODULE    = fondue.exe
+IMPORTS   = advapi32 shell32 user32
+PARENTSRC = ../dism
+
+EXTRADLLFLAGS = -mwindows -municode
+
+SOURCES = \
+	features.c \
+	fondue.c
--- /dev/null
+++ b/programs/fondue/fondue.c
@@ -0,0 +1,79 @@
+/*
+ * fondue.exe, the Features on Demand tool (Stained Glass OS)
+ *
+ * Programs that need an optional feature start it as
+ *   fondue.exe /enable-feature:NetFx3 [/caller-name:NAME] [/hide-ux:all]
+ * and wait for its exit code: 0 when the feature is on. On Windows it asks
+ * the user and turns the feature on. Here the only features are the .NET
+ * Framework's (features.c), which are on when Wine Mono is installed: then
+ * 0; when it is not, it says so (unless the UI is hidden) and exits with
+ * DISM's "source files not found"; an unknown feature with DISM's "unknown
+ * feature". Wine had no fondue.exe: such a program could not start it.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <windows.h>
+#include <shellapi.h>
+#include "features.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(fondue);
+
+static const WCHAR *option( const WCHAR *arg, const WCHAR *name )
+{
+    size_t len = wcslen( name );
+
+    if (arg[0] != '/' && arg[0] != '-') return NULL;
+    if (wcsnicmp( arg + 1, name, len )) return NULL;
+    if (!arg[len + 1]) return L"";
+    if (arg[len + 1] == ':') return arg + len + 2;
+    return NULL;
+}
+
+int WINAPI wWinMain( HINSTANCE instance, HINSTANCE prev, WCHAR *cmdline, int show )
+{
+    const struct optional_feature *feature;
+    const WCHAR *name = NULL, *value;
+    BOOL hide_ui = FALSE;
+    WCHAR text[512];
+    WCHAR **argv;
+    int argc, i;
+
+    argv = CommandLineToArgvW( GetCommandLineW(), &argc );
+    for (i = 1; argv && i < argc; i++)
+    {
+        if ((value = option( argv[i], L"enable-feature" )) && *value) name = value;
+        else if ((value = option( argv[i], L"hide-ux" ))) hide_ui = !wcsicmp( value, L"all" );
+    }
+    TRACE( "feature %s hide %d\n", debugstr_w(name), hide_ui );
+
+    if (!name) return ERROR_INVALID_PARAMETER;
+#ifndef SG_MUTANT_FONDUE
+    if (!(feature = find_optional_feature( name ))) return DISM_E_UNKNOWN_FEATURE;
+    if (optional_feature_enabled( feature )) return 0;
+#else
+    feature = find_optional_feature( name );
+    if (!feature) return DISM_E_UNKNOWN_FEATURE;
+#endif
+    if (!hide_ui)
+    {
+        swprintf( text, ARRAY_SIZE(text), L"%s is needed by a program, but it cannot be turned on: "
+                  L"the .NET Framework (Wine Mono) is not installed.", feature->display_name );
+        MessageBoxW( NULL, text, L"Optional features", MB_OK | MB_ICONWARNING );
+    }
+    return DISM_E_SOURCE_MISSING;
+}
