+/***********************************************************************
+ * System cursors replaced by SetSystemCursor (Stained Glass OS)
+ *
+ * The replacement of a system cursor is kept for the session in
+ * HKCU\Software\Wine\Temporary System Parameters\System Cursors, value "<OCR id>" =
+ * the cursor as a cursor resource (hotspot, then the DIB with its XOR and AND images),
+ * so cursors a process loads later with LoadCursor( NULL, id ) get it.  The cursor the
+ * calling process already loaded is changed in place (NtUserSetCursorIconData with
+ * SG_CURSORICON_REPLACE), so its windows show the new image; processes that are running
+ * keep what they loaded.  SystemParametersInfo( SPI_SETCURSORS ) puts the defaults back.
+ */
+#define SG_CURSORICON_REPLACE 0x40000000
+#define SYSTEM_CURSORS_KEY L"Software\\Wine\\Temporary System Parameters\\System Cursors"
+
+static const WORD system_cursor_ids[] =
+{
+    32650 /* OCR_APPSTARTING */, 32512 /* NORMAL */, 32515 /* CROSS */, 32649 /* HAND */, 32651 /* HELP */,
+    32513 /* IBEAM */, 32648 /* NO */, 32646 /* SIZEALL */, 32643 /* SIZENESW */, 32645 /* SIZENS */,
+    32642 /* SIZENWSE */, 32644 /* SIZEWE */, 32516 /* UP */, 32514 /* WAIT */
+};
+static HCURSOR replaced_system_cursors[ARRAY_SIZE(system_cursor_ids)];  /* shared handles of this process */
+
+static int system_cursor_index( DWORD id )
+{
+    UINT i;
+    for (i = 0; i < ARRAY_SIZE(system_cursor_ids); i++) if (system_cursor_ids[i] == id) return i;
+    return -1;
+}
+
+/* the cursor as a cursor resource; the result is freed with HeapFree */
+static BYTE *cursor_to_blob( HCURSOR cursor, DWORD *ret_size )
+{
+    BITMAPINFO *bmi = NULL;
+    ICONINFO info;
+    BITMAP bm;
+    BYTE *blob = NULL, *data;
+    DWORD xor_size, and_size, size;
+    int width, height, bpp;
+    HDC hdc;
+
+    if (!GetIconInfo( cursor, &info )) return NULL;
+    if (info.fIcon || !GetObjectW( info.hbmMask, sizeof(bm), &bm ))
+    {
+        SetLastError( ERROR_INVALID_CURSOR_HANDLE );
+        goto done;
+    }
+    width = bm.bmWidth;
+    height = info.hbmColor ? bm.bmHeight : bm.bmHeight / 2;
+    bpp = info.hbmColor ? 32 : 1;
+    if (width <= 0 || height <= 0) goto done;
+
+    xor_size = get_dib_image_size( width, height, bpp );
+    and_size = get_dib_image_size( width, height, 1 );
+    size = 2 * sizeof(SHORT) + sizeof(BITMAPINFOHEADER) + (bpp == 1 ? 2 * sizeof(RGBQUAD) : 0) + xor_size + and_size;
+    if (!(blob = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) goto done;
+    ((SHORT *)blob)[0] = info.xHotspot;
+    ((SHORT *)blob)[1] = info.yHotspot;
+    bmi = (BITMAPINFO *)(blob + 2 * sizeof(SHORT));
+    bmi->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bmi->bmiHeader.biWidth = width;
+    bmi->bmiHeader.biHeight = 2 * height;
+    bmi->bmiHeader.biPlanes = 1;
+    bmi->bmiHeader.biBitCount = bpp;
+    bmi->bmiHeader.biCompression = BI_RGB;
+    data = (BYTE *)bmi + sizeof(BITMAPINFOHEADER) + (bpp == 1 ? 2 * sizeof(RGBQUAD) : 0);
+
+    hdc = CreateCompatibleDC( 0 );
+    {
+        char buffer[sizeof(BITMAPINFOHEADER) + 2 * sizeof(RGBQUAD)] = {0};
+        BITMAPINFO *tmp = (BITMAPINFO *)buffer;
+        BOOL ok;
+
+        tmp->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+        tmp->bmiHeader.biWidth = width;
+        tmp->bmiHeader.biPlanes = 1;
+        tmp->bmiHeader.biCompression = BI_RGB;
+        if (info.hbmColor)
+        {
+            /* the XOR image (32 bits per pixel, bottom-up), then the AND mask */
+            tmp->bmiHeader.biHeight = height;
+            tmp->bmiHeader.biBitCount = 32;
+            ok = GetDIBits( hdc, info.hbmColor, 0, height, data, tmp, DIB_RGB_COLORS ) == height;
+            tmp->bmiHeader.biBitCount = 1;
+            ok = ok && GetDIBits( hdc, info.hbmMask, 0, height, data + xor_size, tmp, DIB_RGB_COLORS ) == height;
+        }
+        else
+        {
+            /* the mask bitmap is the AND image over the XOR image: bottom-up that is the resource order */
+            tmp->bmiHeader.biHeight = 2 * height;
+            tmp->bmiHeader.biBitCount = 1;
+            ok = GetDIBits( hdc, info.hbmMask, 0, 2 * height, data, tmp, DIB_RGB_COLORS ) == 2 * height;
+            memcpy( bmi->bmiColors, tmp->bmiColors, 2 * sizeof(RGBQUAD) );
+        }
+        if (!ok)
+        {
+            HeapFree( GetProcessHeap(), 0, blob );
+            blob = NULL;
+        }
+    }
+    DeleteDC( hdc );
+    if (blob) *ret_size = size;
+done:
+    if (info.hbmColor) DeleteObject( info.hbmColor );
+    if (info.hbmMask) DeleteObject( info.hbmMask );
+    return blob;
+}
+
+static BOOL replace_cursor_from_blob( HCURSOR cursor, const BYTE *blob, DWORD size )
+{
+    struct cursoricon_frame frame;
+    struct cursoricon_desc desc = { .flags = SG_CURSORICON_REPLACE, .frames = &frame };
+    POINT hotspot;
+
+    if (size < 2 * sizeof(SHORT) + sizeof(BITMAPINFOHEADER)) return FALSE;
+    hotspot.x = ((const SHORT *)blob)[0];
+    hotspot.y = ((const SHORT *)blob)[1];
+    if (!create_icon_frame( (const BITMAPINFO *)(blob + 2 * sizeof(SHORT)), size - 2 * sizeof(SHORT),
+                            hotspot, FALSE, 0, 0, 0, &frame )) return FALSE;
+    if (NtUserSetCursorIconData( cursor, NULL, NULL, &desc )) return TRUE;
+    free_icon_frame( &frame );
+    return FALSE;
+}
+
+static BOOL write_system_cursor( DWORD id, const BYTE *blob, DWORD size )
+{
+    WCHAR name[16];
+    HKEY key;
+    BOOL ret;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, SYSTEM_CURSORS_KEY, 0, NULL, REG_OPTION_VOLATILE, KEY_WRITE, NULL, &key, NULL ))
+        return FALSE;
+    swprintf( name, ARRAY_SIZE(name), L"%lu", id );
+    ret = !RegSetValueExW( key, name, 0, REG_BINARY, blob, size );
+    RegCloseKey( key );
+    return ret;
+}
+
+/* a replacement made by SetSystemCursor: applied to a system cursor the process has just loaded */
+static void apply_system_cursor( HCURSOR cursor, DWORD id, BOOL shared )
+{
+    WCHAR name[16];
+    DWORD size = 0;
+    BYTE *blob;
+    int idx;
+    HKEY key;
+
+    if ((idx = system_cursor_index( id )) < 0) return;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, SYSTEM_CURSORS_KEY, 0, KEY_READ, &key )) return;
+    swprintf( name, ARRAY_SIZE(name), L"%lu", id );
+    if (!RegQueryValueExW( key, name, NULL, NULL, NULL, &size ) && size &&
+        (blob = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        DWORD type;
+        if (!RegQueryValueExW( key, name, NULL, &type, blob, &size ) && type == REG_BINARY &&
+            replace_cursor_from_blob( cursor, blob, size) && shared)
+            replaced_system_cursors[idx] = cursor;
+        HeapFree( GetProcessHeap(), 0, blob );
+    }
+    RegCloseKey( key );
+}
+
+/* SystemParametersInfo( SPI_SETCURSORS ): the system cursors are the defaults again */
+void reset_system_cursors(void)
+{
+    UINT i;
+
+    RegDeleteKeyW( HKEY_CURRENT_USER, SYSTEM_CURSORS_KEY );
+    for (i = 0; i < ARRAY_SIZE(system_cursor_ids); i++)
+    {
+        HCURSOR def;
+        DWORD size;
+        BYTE *blob;
+
+        if (!replaced_system_cursors[i]) continue;
+        if (!(def = LoadImageW( NULL, MAKEINTRESOURCEW(system_cursor_ids[i]), IMAGE_CURSOR, 0, 0, LR_DEFAULTSIZE ))) continue;
+        if ((blob = cursor_to_blob( def, &size )))
+        {
+            if (replace_cursor_from_blob( replaced_system_cursors[i], blob, size )) replaced_system_cursors[i] = 0;
+            HeapFree( GetProcessHeap(), 0, blob );
+        }
+        DestroyCursor( def );
+    }
+}
+
 /***********************************************************************
  *		SetSystemCursor (USER32.@)
  */
-BOOL WINAPI SetSystemCursor(HCURSOR hcur, DWORD id)
+BOOL WINAPI SetSystemCursor( HCURSOR hcur, DWORD id )
 {
-    FIXME("(%p,%08lx),stub!\n", hcur, id);
-    return TRUE;
+    HCURSOR system;
+    DWORD size;
+    BYTE *blob;
+    BOOL ret = FALSE;
+    int idx;
+
+    TRACE( "%p, %08lx\n", hcur, id );
+
+    if ((idx = system_cursor_index( id )) < 0)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(blob = cursor_to_blob( hcur, &size ))) return FALSE;
+
+    /* the shared cursor LoadCursor( NULL, id ) returns */
+    if ((system = LoadImageW( NULL, MAKEINTRESOURCEW(id), IMAGE_CURSOR, 0, 0, LR_SHARED | LR_DEFAULTSIZE )))
+    {
+        if (write_system_cursor( id, blob, size ) && (system == hcur || replace_cursor_from_blob( system, blob, size )))
+        {
+            replaced_system_cursors[idx] = system;
+            ret = TRUE;
+        }
+    }
+    HeapFree( GetProcessHeap(), 0, blob );
+    if (ret && system != hcur) DestroyCursor( hcur );   /* the cursor is given to the system */
+    return ret;
 }
 
 
