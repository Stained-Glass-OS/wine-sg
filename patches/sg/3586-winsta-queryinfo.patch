From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winsta: WinStationQueryInformation scalar classes (3586)

winsta: WinStationQueryInformation for the scalar classes

WinStationQueryInformationW/A answer the classes whose result is a single ULONG in [MS-TSTS] 2.2.1.8:
WinStationIdleTime (seconds, 0), WinStationLastReconnectType (0, manual) and WinStationReconnectedFromId
(-1, no temporary session). Unknown sessions give ERROR_CTX_WINSTATION_NOT_FOUND, a short buffer
ERROR_INSUFFICIENT_BUFFER with the length set. Other classes keep their FIXME.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---
diff --git a/dlls/winsta/main.c b/dlls/winsta/main.c
index 31bbea9..b3b7756 100644
--- a/dlls/winsta/main.c
+++ b/dlls/winsta/main.c
@@ -39,20 +39,71 @@ static BOOLEAN is_local_server( HANDLE server )
     return TRUE;
 }
 
-BOOLEAN WINAPI WinStationQueryInformationA( HANDLE server, ULONG logon_id, WINSTATIONINFOCLASS class,
-                                            void *info, ULONG len, ULONG *ret_len )
+/* WINSTATIONINFOCLASS values ([MS-TSTS] 2.2.1.8) with a plain ULONG result */
+#define WINSTATION_CLASS_IDLE_TIME            30
+#define WINSTATION_CLASS_LAST_RECONNECT_TYPE  31
+#define WINSTATION_CLASS_RECONNECTED_FROM_ID  37
+
+static BOOL session_exists( ULONG id )
 {
-    FIXME( "%p %lu %u %p %lu %p\n", server, logon_id, class, info, len, ret_len );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    WTS_SESSION_INFOW *sessions;
+    DWORD i, count;
+    BOOL found = FALSE;
+
+    if (!WTSEnumerateSessionsW( WTS_CURRENT_SERVER_HANDLE, 0, 1, &sessions, &count )) return FALSE;
+    for (i = 0; i < count; i++) if (sessions[i].SessionId == id) found = TRUE;
+    WTSFreeMemory( sessions );
+    return found;
 }
 
 BOOLEAN WINAPI WinStationQueryInformationW( HANDLE server, ULONG logon_id, WINSTATIONINFOCLASS class,
                                             void *info, ULONG len, ULONG *ret_len )
 {
-    FIXME( "%p %lu %u %p %lu %p\n", server, logon_id, class, info, len, ret_len );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    ULONG value;
+
+    TRACE( "%p %lu %u %p %lu %p\n", server, logon_id, class, info, len, ret_len );
+
+    switch ((ULONG)class)
+    {
+    case WINSTATION_CLASS_IDLE_TIME:            value = 0; break;   /* seconds; input time is not tracked per session */
+    case WINSTATION_CLASS_LAST_RECONNECT_TYPE:  value = 0; break;   /* 0: manual reconnect */
+    case WINSTATION_CLASS_RECONNECTED_FROM_ID:
+#ifdef SG_MUTANT_WINSTA_RECONN
+        value = 0; break;
+#else
+        value = ~0u; break;
+#endif /* no temporary session was created */
+    default:
+        FIXME( "%p %lu %u %p %lu %p\n", server, logon_id, class, info, len, ret_len );
+        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        return FALSE;
+    }
+
+    if (!ret_len || !is_local_server( server ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!session_exists( logon_id ))
+    {
+        SetLastError( ERROR_CTX_WINSTATION_NOT_FOUND );
+        return FALSE;
+    }
+    *ret_len = sizeof(value);
+    if (!info || len < sizeof(value))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    *(ULONG *)info = value;
+    return TRUE;
+}
+
+BOOLEAN WINAPI WinStationQueryInformationA( HANDLE server, ULONG logon_id, WINSTATIONINFOCLASS class,
+                                            void *info, ULONG len, ULONG *ret_len )
+{
+    /* the classes handled have no strings */
+    return WinStationQueryInformationW( server, logon_id, class, info, len, ret_len );
 }
 
 /* session notifications are the ones wtsapi32 sends */
