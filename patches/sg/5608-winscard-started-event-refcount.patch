From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winscard: the started event is reference counted

winscard: SCardAccessStartedEvent and SCardReleaseStartedEvent are reference counted

The started event is created on the first access, shared by every caller and
closed when the last caller releases it.
---
--- a/dlls/winscard/tests/winscard.c
+++ b/dlls/winscard/tests/winscard.c
@@ -251,7 +251,46 @@ static void test_SCardEstablishContext(void)
     ok( ret == ERROR_INVALID_HANDLE, "got %lx\n", ret );
 }
 
+static void test_SCardStartedEvent(void)
+{
+    HANDLE event, event2;
+    DWORD ret;
+
+    /* a release with no access does nothing */
+    SCardReleaseStartedEvent();
+
+    event = SCardAccessStartedEvent();
+    ok(event != NULL, "got error %lu\n", GetLastError());
+    ret = WaitForSingleObject(event, 0);
+    ok(ret == WAIT_OBJECT_0, "got %lu\n", ret);
+    ret = WaitForSingleObject(event, 0);
+    ok(ret == WAIT_OBJECT_0, "the event is not manual-reset: %lu\n", ret);
+
+    /* a second access counts another reference and gives the same event */
+    event2 = SCardAccessStartedEvent();
+    ok(event2 == event, "got %p, expected %p\n", event2, event);
+
+    SCardReleaseStartedEvent();
+    ret = WaitForSingleObject(event, 0);
+    ok(ret == WAIT_OBJECT_0, "the event was closed with a reference left: %lu\n", ret);
+
+    /* the last release closes it */
+    SCardReleaseStartedEvent();
+    SetLastError(0xdeadbeef);
+    ret = WaitForSingleObject(event, 0);
+    ok(ret == WAIT_FAILED && GetLastError() == ERROR_INVALID_HANDLE, "got %lu, error %lu\n", ret, GetLastError());
+
+    /* more releases than accesses change nothing */
+    SCardReleaseStartedEvent();
+    event = SCardAccessStartedEvent();
+    ok(event != NULL, "got error %lu\n", GetLastError());
+    ret = WaitForSingleObject(event, 0);
+    ok(ret == WAIT_OBJECT_0, "got %lu\n", ret);
+    SCardReleaseStartedEvent();
+}
+
 START_TEST(winscard)
 {
     test_SCardEstablishContext();
+    test_SCardStartedEvent();
 }
--- a/dlls/winscard/winscard.c
+++ b/dlls/winscard/winscard.c
@@ -32,7 +32,16 @@ WINE_DEFAULT_DEBUG_CHANNEL(winscard);
 
 #define UNIX_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
+static CRITICAL_SECTION started_cs;
+static CRITICAL_SECTION_DEBUG started_cs_debug =
+{
+    0, 0, &started_cs,
+    { &started_cs_debug.ProcessLocksList, &started_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": started_cs") }
+};
+static CRITICAL_SECTION started_cs = { &started_cs_debug, -1, 0, 0, 0, 0 };
 static HANDLE g_startedEvent;
+static ULONG g_startedRefs;
 
 const SCARD_IO_REQUEST g_rgSCardT0Pci = { SCARD_PROTOCOL_T0, 8 };
 const SCARD_IO_REQUEST g_rgSCardT1Pci = { SCARD_PROTOCOL_T1, 8 };
@@ -111,8 +120,17 @@ static inline int utf8_to_ansi( const char *src, char **dst )
 
 HANDLE WINAPI SCardAccessStartedEvent(void)
 {
-    FIXME( "stub\n" );
-    return g_startedEvent;
+    HANDLE ret;
+
+    TRACE( "\n" );
+
+    /* FIXME: for now, we act as if the pcsc daemon is always started */
+    EnterCriticalSection( &started_cs );
+    if (!g_startedEvent) g_startedEvent = CreateEventW( NULL, TRUE, TRUE, NULL );
+    if (g_startedEvent) g_startedRefs++;
+    ret = g_startedEvent;
+    LeaveCriticalSection( &started_cs );
+    return ret;
 }
 
 LONG WINAPI SCardAddReaderToGroupA( SCARDCONTEXT context, const char *reader, const char *group )
@@ -417,7 +435,17 @@ LONG WINAPI SCardStatusW( SCARDHANDLE connect, WCHAR *names, DWORD *names_len, D
 
 void WINAPI SCardReleaseStartedEvent(void)
 {
-    FIXME( "stub\n" );
+    TRACE( "\n" );
+
+    EnterCriticalSection( &started_cs );
+    if (g_startedRefs && !--g_startedRefs)
+    {
+#ifndef SG_MUTANT_STARTED_NO_CLOSE
+        CloseHandle( g_startedEvent );
+        g_startedEvent = NULL;
+#endif
+    }
+    LeaveCriticalSection( &started_cs );
 }
 
 LONG WINAPI SCardListReadersA( SCARDCONTEXT context, const char *groups, char *readers, DWORD *readers_len )
@@ -954,13 +982,11 @@ BOOL WINAPI DllMain( HINSTANCE hinst, DWORD reason, void *reserved )
         DisableThreadLibraryCalls( hinst );
         if (__wine_init_unix_call()) ERR( "no pcsclite support, expect problems\n" );
 
-        /* FIXME: for now, we act as if the pcsc daemon is always started */
-        g_startedEvent = CreateEventW( NULL, TRUE, TRUE, NULL );
         break;
 
     case DLL_PROCESS_DETACH:
         if (reserved) break;
-        CloseHandle( g_startedEvent );
+        if (g_startedEvent) CloseHandle( g_startedEvent );
         g_startedEvent = NULL;
         break;
     }
