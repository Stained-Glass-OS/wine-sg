+/***********************************************************************
+ *           is_gui_thread
+ *
+ * Whether this thread has a message queue, making one when asked to
+ * (IsGUIThread).
+ */
+BOOL is_gui_thread( BOOL convert )
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+    BOOL ret = FALSE;
+
+    if (thread_info->server_queue) return TRUE;
+#ifndef SG_MUTANT_GUI_THREAD_ALWAYS
+    SERVER_START_REQ( get_thread_input )
+    {
+        req->tid = GetCurrentThreadId();
+        if (!wine_server_call( req )) ret = reply->locator.id != 0;
+    }
+    SERVER_END_REQ;
+#else
+    ret = TRUE;
+#endif
+    if (!ret && convert) ret = get_server_queue_handle() != 0;
+    return ret;
+}
