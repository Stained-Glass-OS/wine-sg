From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: Implement IViewObject::Freeze and Unfreeze in the data cache.

IViewObject::Freeze and Unfreeze on the OLE data cache: a cached aspect
freezes (a key; VIEW_S_ALREADY_FROZEN and the same key when it already is),
an aspect with nothing cached is OLE_E_BLANK, lindex other than -1
DV_E_LINDEX, an unknown aspect DV_E_DVASPECT. While frozen, view
notifications wait and data from the running object is not taken, so Draw
keeps the same picture; Unfreeze takes the new data and sends the
notification held back, and is OLE_E_NOCONNECTION for a key not frozen.
Both returned E_NOTIMPL. Two todo_wine go.

Gate: test/ole32-cachefreeze-gate.sh.
---
 dlls/ole32/datacache.c  | 92 ++++++++++++++++++++++++++++++++++++++++++++++---
 dlls/ole32/tests/ole2.c |  2 --
 2 files changed, 88 insertions(+), 6 deletions(-)

diff --git a/dlls/ole32/datacache.c b/dlls/ole32/datacache.c
index 937fd10..e017fb8 100644
--- a/dlls/ole32/datacache.c
+++ b/dlls/ole32/datacache.c
@@ -165,6 +165,16 @@ struct DataCache
   BOOL dirty;
   /* running object set by OnRun */
   IDataObject *running_object;
+  /* IViewObject::Freeze: the frozen aspects (one key each) and what waits for Unfreeze */
+  struct frozen_view
+  {
+      DWORD key;
+      DWORD aspect;
+      BOOL view_change;     /* a view notification was held back */
+      BOOL data_change;     /* the running object's data changed meanwhile */
+  } frozen[4];
+  unsigned int frozen_count;
+  DWORD last_freeze_key;
 };
 
 typedef struct DataCache DataCache;
@@ -420,13 +430,31 @@ fail:
  *
  * See IAdviseSink::OnViewChange for more details.
  */
+static struct frozen_view *find_frozen_view( DataCache *cache, DWORD aspect )
+{
+  unsigned int i;
+
+  for (i = 0; i < cache->frozen_count; i++)
+    if (cache->frozen[i].aspect == aspect) return &cache->frozen[i];
+  return NULL;
+}
+
 static void DataCache_FireOnViewChange(
   DataCache* this,
   DWORD      aspect,
   LONG       lindex)
 {
+  struct frozen_view *frozen;
+
   TRACE("%p, %lx, %ld.\n", this, aspect, lindex);
 
+  /* while frozen, the notification waits for Unfreeze */
+  if ((frozen = find_frozen_view( this, aspect )))
+  {
+    frozen->view_change = TRUE;
+    return;
+  }
+
   /*
    * The sink supplies a filter when it registers
    * we make sure we only send the notifications when that
@@ -2155,16 +2183,62 @@ static HRESULT WINAPI DataCache_Freeze(
 	    void*           pvAspect,
 	    DWORD*          pdwFreeze)
 {
-  FIXME("stub\n");
-  return E_NOTIMPL;
+  DataCache *This = impl_from_IViewObject2(iface);
+  struct frozen_view *frozen;
+  DataCacheEntry *entry;
+  BOOL cached = FALSE;
+
+  TRACE("(%p, %lx, %ld, %p, %p)\n", iface, dwDrawAspect, lindex, pvAspect, pdwFreeze);
+
+  if (!pdwFreeze) return E_INVALIDARG;
+  if (lindex != -1) return DV_E_LINDEX;
+  if (dwDrawAspect != DVASPECT_CONTENT && dwDrawAspect != DVASPECT_THUMBNAIL &&
+      dwDrawAspect != DVASPECT_ICON && dwDrawAspect != DVASPECT_DOCPRINT)
+    return DV_E_DVASPECT;
+
+  if ((frozen = find_frozen_view( This, dwDrawAspect )))
+  {
+    *pdwFreeze = frozen->key;
+    return VIEW_S_ALREADY_FROZEN;
+  }
+  /* only a presentation the cache holds can be frozen */
+  LIST_FOR_EACH_ENTRY(entry, &This->cache_list, DataCacheEntry, entry)
+    if (entry->fmtetc.dwAspect == dwDrawAspect && entry->stgmedium.tymed != TYMED_NULL) cached = TRUE;
+#ifndef SG_MUTANT_FREEZE_ANY
+  if (!cached) return OLE_E_BLANK;
+#endif
+  if (This->frozen_count == ARRAY_SIZE(This->frozen)) return E_OUTOFMEMORY;
+
+  frozen = &This->frozen[This->frozen_count++];
+  frozen->key = ++This->last_freeze_key;
+  frozen->aspect = dwDrawAspect;
+  frozen->view_change = frozen->data_change = FALSE;
+  *pdwFreeze = frozen->key;
+  return S_OK;
 }
 
 static HRESULT WINAPI DataCache_Unfreeze(
             IViewObject2*   iface,
 	    DWORD           dwFreeze)
 {
-  FIXME("stub\n");
-  return E_NOTIMPL;
+  DataCache *This = impl_from_IViewObject2(iface);
+  struct frozen_view frozen;
+  unsigned int i;
+
+  TRACE("(%p, %lu)\n", iface, dwFreeze);
+
+  for (i = 0; i < This->frozen_count; i++)
+    if (This->frozen[i].key == dwFreeze) break;
+  if (i == This->frozen_count) return OLE_E_NOCONNECTION;
+  frozen = This->frozen[i];
+  This->frozen[i] = This->frozen[--This->frozen_count];
+
+  /* what was held back: the running object's new data, then the view notification */
+  if (frozen.data_change && This->running_object)
+    IOleCache2_UpdateCache( &This->IOleCache2_iface, This->running_object, UPDFCACHE_ALL, NULL );
+  if (frozen.view_change || frozen.data_change)
+    DataCache_FireOnViewChange( This, frozen.aspect, -1 );
+  return S_OK;
 }
 
 /************************************************************************
@@ -2842,7 +2916,15 @@ static ULONG WINAPI DataCache_IAdviseSink_Release(IAdviseSink *iface)
 static void WINAPI DataCache_OnDataChange(IAdviseSink *iface, FORMATETC *fmt, STGMEDIUM *med)
 {
     DataCache *This = impl_from_IAdviseSink(iface);
+    struct frozen_view *frozen;
+
     TRACE("(%p)->(%s, %p)\n", This, debugstr_formatetc(fmt), med);
+    /* a frozen presentation keeps drawing the same picture: the cache catches up on Unfreeze */
+    if ((frozen = find_frozen_view( This, fmt->dwAspect )))
+    {
+        frozen->data_change = TRUE;
+        return;
+    }
     IOleCache2_SetData(&This->IOleCache2_iface, fmt, med, FALSE);
 }
 
@@ -2996,6 +3078,8 @@ static DataCache* DataCache_Construct(
   newObject->presentationStorage = NULL;
   list_init(&newObject->cache_list);
   newObject->last_cache_id = 2;
+  newObject->frozen_count = 0;
+  newObject->last_freeze_key = 0;
   newObject->dirty = FALSE;
   newObject->running_object = NULL;
 
diff --git a/dlls/ole32/tests/ole2.c b/dlls/ole32/tests/ole2.c
index dca9ba7..eae98b5 100644
--- a/dlls/ole32/tests/ole2.c
+++ b/dlls/ole32/tests/ole2.c
@@ -1766,11 +1766,9 @@ static void test_data_cache(void)
     ReleaseStgMedium(&stgmedium);
 
     hr = IViewObject_Freeze(pViewObject, DVASPECT_ICON, -1, NULL, &dwFreeze);
-    todo_wine {
     ok_ole_success(hr, "IViewObject_Freeze");
     hr = IViewObject_Freeze(pViewObject, DVASPECT_CONTENT, -1, NULL, &dwFreeze);
     ok(hr == OLE_E_BLANK, "IViewObject_Freeze with uncached aspect should have returned OLE_E_BLANK instead of 0x%08lx\n", hr);
-    }
 
     rcBounds.left = 0;
     rcBounds.top = 0;
