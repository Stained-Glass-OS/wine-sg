From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] schedsvc: a person's task host does not hold up signing out

The host of a person's scheduled tasks (1173: "rundll32
schedsvc.dll,SgUserTaskHost", started by the shell at each sign-in) ran
its scheduler on the thread that has rundll32's window, and that thread
never read its messages. Signing out asks every window whether the
session may end; a window that does not answer is a hung program, and
the sign-out waited on it: the shell never ended, and with it the
session (Start > Sign out, Ctrl+Alt+Del > Sign out, shutdown /l left the
person at an empty desktop). logoff-gate was red since 1173.

The scheduler now runs on a thread of its own. The host's first thread
reads the messages of a hidden window of its own, which agrees to the
session's end and ends the host with it.

Test: test/logoff-gate.sh (mutant SG_MUTANT_TASKHOST_BLOCKS_LOGOFF in
taskrun.c fails it); test/taskrun-gate.sh still passes.
---
--- a/dlls/schedsvc/Makefile.in
+++ b/dlls/schedsvc/Makefile.in
@@ -1,5 +1,6 @@
 MODULE    = schedsvc.dll
 IMPORTS   = rpcrt4 advapi32 ole32 xmllite
+DELAYIMPORTS = user32
 
 SOURCES = \
 	atsvc.c \
--- a/dlls/schedsvc/taskrun.c
+++ b/dlls/schedsvc/taskrun.c
@@ -53,6 +53,7 @@
 #include "windef.h"
 #include "winbase.h"
 #include "winreg.h"
+#include "winuser.h"
 #include "sddl.h"
 #include "objbase.h"
 #include "xmllite.h"
@@ -1230,6 +1231,20 @@
  * person's tasks, for as long as their session lasts. The shell starts it at
  * each sign-in; one per session. --as names the account whose tasks it
  * takes (they still run as whoever runs it): for tests. */
+/* Stained Glass OS: the host's window answers the session's end: signing
+ * out asks every window whether it may end (WM_QUERYENDSESSION), and the
+ * host goes with the session (WM_ENDSESSION) */
+static LRESULT CALLBACK host_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    if (msg == WM_QUERYENDSESSION) return TRUE;
+    if (msg == WM_ENDSESSION && wparam)
+    {
+        TRACE("the session ends\n");
+        ExitProcess(0);
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
 void WINAPI SgUserTaskHostW(HWND hwnd, HINSTANCE instance, WCHAR *cmdline, int show)
 {
     const WCHAR *as = NULL;
@@ -1258,6 +1273,35 @@
     wake_event = CreateEventW(NULL, FALSE, FALSE, NULL);
     host_wake = OpenEventW(SYNCHRONIZE, FALSE, L"Global\\SgTaskHostWake");
     never = CreateEventW(NULL, TRUE, FALSE, NULL);
+#ifndef SG_MUTANT_TASKHOST_BLOCKS_LOGOFF
+    /* The scheduler on a thread of its own: this one has rundll32's window,
+     * and a window whose thread never reads its messages is a hung program
+     * to a sign-out -- which then waited on it, and the session never ended
+     * (logoff-gate, since 1173). This thread reads them, with a window of
+     * the host's own that answers the session's end. */
+    {
+        WNDCLASSW wc = {0};
+        HANDLE thread;
+        MSG msg;
+
+        if (hwnd) DestroyWindow(hwnd);
+        if ((thread = CreateThread(NULL, 0, scheduler_proc, never, 0, NULL)))
+        {
+            CloseHandle(thread);
+            wc.lpfnWndProc = host_wndproc;
+            wc.hInstance = GetModuleHandleW(NULL);
+            wc.lpszClassName = L"SgUserTaskHost";
+            RegisterClassW(&wc);
+            CreateWindowExW(0, L"SgUserTaskHost", L"SgUserTaskHost", WS_POPUP, 0, 0, 0, 0, NULL, NULL, wc.hInstance, NULL);
+            while (GetMessageW(&msg, NULL, 0, 0) > 0)
+            {
+                TranslateMessage(&msg);
+                DispatchMessageW(&msg);
+            }
+            return;
+        }
+    }
+#endif
     scheduler_proc(never);
 }
 
