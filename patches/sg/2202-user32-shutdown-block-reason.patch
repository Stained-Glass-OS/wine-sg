From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: ShutdownBlockReasonCreate/Destroy/Query

- ShutdownBlockReasonCreate and ShutdownBlockReasonDestroy were stubs and
  ShutdownBlockReasonQuery was not exported: a window never had a reason, so
  a program that sets one and asks for it back (or checks its own reason is
  gone before retrying) got nothing. A later Create replaces the reason; NULL
  or 256+ characters is ERROR_INVALID_PARAMETER, a handle that is not a
  window is ERROR_INVALID_WINDOW_HANDLE, and Create/Destroy on a window of
  another process is ERROR_ACCESS_DENIED.
- The reason is server-side state, readable from ANOTHER process (the logoff
  UI is one): it is packed two characters per window property (32-bit
  values, so 32- and 64-bit processes agree) beside a length property. No
  pointers are shared, and the properties and their atoms are freed with
  the window by the server.
- Query copies the reason into the caller's buffer and reports the size in
  characters with the terminating null; a buffer too small is
  ERROR_INSUFFICIENT_BUFFER with the size needed; a window with no reason
  queries as an empty string (size 1). Destroy removes the reason.
- There is no logoff prompt to show the reason in, so nothing blocks a
  shutdown over it.

---
--- a/dlls/user32/user_main.c
+++ b/dlls/user32/user_main.c
@@ -402,14 +402,115 @@ int WINAPI RegisterServicesProcess(DWORD ServicesProcessId)
     return 0;
 }
 
+/* Stained Glass OS: a window's shutdown-block reason (ShutdownBlockReason*)
+ * was "stub"/not exported at all -- a window never had one, so a caller
+ * that sets a reason then asks for it back (WerReportSubmit-style crash
+ * handlers, and anything checking its own reason stuck around before
+ * retrying) got nothing.
+ *
+ * The reason has to be readable from ANOTHER process (the logoff UI queries
+ * the windows of the programs holding a shutdown up), and has to go away
+ * with the window.  Window properties already do both: they live in the
+ * wineserver and win32u removes them when the window is destroyed.  A
+ * property holds one pointer-sized value, so the string is packed two
+ * characters per property (32 bits, so a 32-bit and a 64-bit process agree)
+ * into "__sg_sbr_N" properties beside a "__sg_sbr_len" one holding the
+ * length in characters including the terminator.  We do not block an actual
+ * logoff over it (no logoff prompt exists to show the reason in), only keep
+ * it for a caller to set, read back and clear, as Windows lets any window
+ * do whether or not a shutdown is in progress. */
+static const WCHAR sbr_len_propW[] = L"__sg_sbr_len";
+#define SBR_MAX_CHARS 256 /* MAX_STR_BLOCKREASON, with the terminator */
+
+static void sbr_chunk_name( WCHAR *name, unsigned int index )
+{
+    static const WCHAR prefix[] = L"__sg_sbr_";
+    unsigned int len = lstrlenW( prefix );
+
+    memcpy( name, prefix, len * sizeof(WCHAR) );
+    name[len++] = '0' + index / 100;
+    name[len++] = '0' + (index / 10) % 10;
+    name[len++] = '0' + index % 10;
+    name[len] = 0;
+}
+
+/* remove the whole reason of a window, whatever its length */
+static void sbr_remove( HWND hwnd )
+{
+    WCHAR name[16];
+    unsigned int i, len = (UINT_PTR)GetPropW( hwnd, sbr_len_propW );
+
+    for (i = 0; i < (len + 1) / 2; i++)
+    {
+        sbr_chunk_name( name, i );
+        RemovePropW( hwnd, name );
+    }
+    RemovePropW( hwnd, sbr_len_propW );
+}
+
+static BOOL sbr_check_window( HWND hwnd )
+{
+    DWORD pid;
+
+    if (!IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    /* only a window of the calling process can hold a reason */
+#ifdef SG_MUTANT_NO_OWNER_CHECK
+    if (0)
+#else
+    if (!GetWindowThreadProcessId( hwnd, &pid ) || pid != GetCurrentProcessId())
+#endif
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    return TRUE;
+}
+
 /***********************************************************************
  *		ShutdownBlockReasonCreate (USER32.@)
  */
 BOOL WINAPI ShutdownBlockReasonCreate(HWND hwnd, LPCWSTR reason)
 {
-    FIXME("(%p, %s): stub\n", hwnd, debugstr_w(reason));
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    WCHAR name[16];
+    unsigned int i, len;
+
+    TRACE("(%p, %s)\n", hwnd, debugstr_w(reason));
+
+    if (!sbr_check_window( hwnd )) return FALSE;
+    if (!reason || (len = lstrlenW( reason ) + 1) > SBR_MAX_CHARS)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    sbr_remove( hwnd );
+    for (i = 0; i < (len + 1) / 2; i++)
+    {
+        UINT_PTR value = reason[2 * i];
+        if (2 * i + 1 < len) value |= (UINT_PTR)reason[2 * i + 1] << 16;
+        sbr_chunk_name( name, i );
+        if (!SetPropW( hwnd, name, (HANDLE)value ))
+        {
+            sbr_remove( hwnd );
+            SetLastError( ERROR_OUTOFMEMORY );
+            return FALSE;
+        }
+    }
+    if (!SetPropW( hwnd, sbr_len_propW, (HANDLE)(UINT_PTR)len ))
+    {
+        /* the chunks are not counted yet: remove them by hand */
+        for (i = 0; i < (len + 1) / 2; i++)
+        {
+            sbr_chunk_name( name, i );
+            RemovePropW( hwnd, name );
+        }
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    return TRUE;
 }
 
 /***********************************************************************
@@ -417,9 +518,56 @@ BOOL WINAPI ShutdownBlockReasonCreate(HWND hwnd, LPCWSTR reason)
  */
 BOOL WINAPI ShutdownBlockReasonDestroy(HWND hwnd)
 {
-    FIXME("(%p): stub\n", hwnd);
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE("(%p)\n", hwnd);
+
+    if (!sbr_check_window( hwnd )) return FALSE;
+#ifndef SG_MUTANT_NO_REASON_CLEAR
+    sbr_remove( hwnd );
+#endif
+    return TRUE;
+}
+
+/***********************************************************************
+ *		ShutdownBlockReasonQuery (USER32.@)
+ */
+BOOL WINAPI ShutdownBlockReasonQuery(HWND hwnd, LPWSTR buffer, DWORD *size)
+{
+    WCHAR name[16];
+    unsigned int i, len;
+
+    TRACE("(%p, %p, %p)\n", hwnd, buffer, size);
+
+    if (!size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    len = (UINT_PTR)GetPropW( hwnd, sbr_len_propW );
+    if (len > SBR_MAX_CHARS) len = 0;
+    if (!len) len = 1;  /* no reason: the empty string */
+    if (!buffer || *size < len)
+    {
+        *size = len;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    buffer[0] = 0;
+    for (i = 0; i < (len + 1) / 2 && len > 1; i++)
+    {
+        UINT_PTR value;
+        sbr_chunk_name( name, i );
+        value = (UINT_PTR)GetPropW( hwnd, name );
+        buffer[2 * i] = value & 0xffff;
+        if (2 * i + 1 < len) buffer[2 * i + 1] = (value >> 16) & 0xffff;
+    }
+    buffer[len - 1] = 0;
+    *size = len;
+    return TRUE;
 }
 
 const char *SPY_GetMsgName( UINT msg, HWND hwnd )
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -1137,7 +1137,7 @@
 @ stdcall ShowWindowAsync(long long) NtUserShowWindowAsync
 @ stdcall ShutdownBlockReasonCreate(long wstr)
 @ stdcall ShutdownBlockReasonDestroy(long)
-# @ stub ShutdownBlockReasonQuery
+@ stdcall ShutdownBlockReasonQuery(long ptr ptr)
 # @ stub SignalRedirectionStartComplete
 @ stdcall SkipPointerFrameMessages(long)
 # @ stub SoftModalMessageBox
--- a/include/winuser.h
+++ b/include/winuser.h
@@ -4684,6 +4684,7 @@
 WINUSERAPI BOOL        WINAPI ShowWindowAsync(HWND,INT);
 WINUSERAPI BOOL        WINAPI ShutdownBlockReasonCreate(HWND,LPCWSTR);
 WINUSERAPI BOOL        WINAPI ShutdownBlockReasonDestroy(HWND);
+WINUSERAPI BOOL        WINAPI ShutdownBlockReasonQuery(HWND,LPWSTR,DWORD*);
 WINUSERAPI BOOL        WINAPI SkipPointerFrameMessages(UINT32);
 WINUSERAPI BOOL        WINAPI SubtractRect(LPRECT,const RECT*,const RECT*);
 WINUSERAPI BOOL        WINAPI SwapMouseButton(BOOL);
