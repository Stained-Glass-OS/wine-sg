From: Stained Glass OS contributors
Subject: explorer: File Explorer's arrows and chevrons from the icon font

Back, Forward, Up, Refresh, Search and the chevrons were GDI+ strokes;
Wine's GDI+ drew them jagged, the arrowheads broken -- David, "the arrows
look poor and hand drawn". They are now the glyphs of "Segoe MDL2 Assets"
(sg-shell's Stained Glass Icons stands in for it: U+E72B, E72A, E74A, E72C,
E721, E76C, E70D), rendered as text is, smooth at any size; the strokes
remain for a system without the font.

--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -334,6 +334,57 @@
 /* ------------------------------------------------------------------------ */
 /* glyphs: line icons, drawn anti-aliased on a 16-unit grid                 */
 
+/* Stained Glass OS: the arrows, chevrons and the like come from the icon font
+ * ("Segoe MDL2 Assets", sg-shell's Stained Glass Icons stands in for it),
+ * rendered like text -- smooth. Drawn as GDI+ strokes they came out jagged,
+ * the arrowheads broken: David, "the arrows look poor and hand drawn". FALSE
+ * when the font has no such glyph. */
+static BOOL draw_font_glyph(HDC dc, int glyph, int x, int y, int size, COLORREF color)
+{
+    static HFONT fonts[4];
+    static int sizes[4];
+    WCHAR ch;
+    WORD index;
+    HFONT font = NULL, old;
+    RECT rc = { x, y, x + size, y + size };
+    int i;
+
+    switch (glyph)
+    {
+    case G_BACK:          ch = 0xe72b; break;
+    case G_FORWARD:       ch = 0xe72a; break;
+    case G_UP:            ch = 0xe74a; break;
+    case G_REFRESH:       ch = 0xe72c; break;
+    case G_SEARCH:        ch = 0xe721; break;
+    case G_CHEVRON_RIGHT: ch = 0xe76c; break;
+    case G_CHEVRON_DOWN:  ch = 0xe70d; break;
+    default: return FALSE;
+    }
+    for (i = 0; i < ARRAY_SIZE(fonts); i++)
+    {
+        if (fonts[i] && sizes[i] == size) { font = fonts[i]; break; }
+        if (!fonts[i])
+        {
+            fonts[i] = font = CreateFontW(-size, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, OUT_TT_ONLY_PRECIS, 0,
+                                          ANTIALIASED_QUALITY, 0, L"Segoe MDL2 Assets");
+            sizes[i] = size;
+            break;
+        }
+    }
+    if (!font) return FALSE;
+    old = SelectObject(dc, font);
+    if (GetGlyphIndicesW(dc, &ch, 1, &index, GGI_MARK_NONEXISTING_GLYPHS) == GDI_ERROR || index == 0xffff)
+    {
+        SelectObject(dc, old);
+        return FALSE;
+    }
+    SetTextColor(dc, color);
+    SetBkMode(dc, TRANSPARENT);
+    DrawTextW(dc, &ch, 1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_NOCLIP);
+    SelectObject(dc, old);
+    return TRUE;
+}
+
 static void draw_glyph(HDC dc, int glyph, int x, int y, int size, COLORREF color)
 {
     GpGraphics *g;
@@ -355,6 +406,7 @@
 #define V(x1, y1, x2, y2, x3, y3) do { GpPointF v_[3] = { { X(x1), Y(y1) }, { X(x2), Y(y2) }, { X(x3), Y(y3) } }; \
                                        GdipDrawLines(g, pen, v_, 3); } while (0)
 
+    if (draw_font_glyph(dc, glyph, x, y, size, color)) return;
     if (glyph == G_NONE || GdipCreateFromHDC(dc, &g) != Ok) return;
     GdipSetSmoothingMode(g, SmoothingModeAntiAlias);
     GdipSetPixelOffsetMode(g, PixelOffsetModeHalf);
