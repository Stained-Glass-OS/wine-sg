From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: a WinEvent hook that skips its own process skips the process that set it

SetWinEventHook's WINEVENT_SKIPOWNPROCESS and WINEVENT_SKIPOWNTHREAD keep
from a hook the events of the process, or the thread, that set it. Wine
compared the event's thread with the process and thread the hook watches,
which a hook on every process (process 0, thread 0) does not have, so such
a hook got its own process's events after all. AnyDesk watches the
foreground window that way and closes its address box whenever another
window comes forward; giving the box the focus brought the box forward,
AnyDesk's own hook was told, and the box closed at once: of an ID typed
only the first digit stayed. The skip now looks at the hook's owner.

The taskbar set its window hooks to skip its own process but was made
with that process's windows (File Explorer's) seen; those hooks no longer
ask to skip, so it sees what it saw before.

Test: test/winevskip-gate.sh with test/winevskip-probe.c (mutant
SG_MUTANT_WINEVENT_SKIPOWN).
---
--- a/server/hook.c
+++ b/server/hook.c
@@ -131,9 +131,18 @@
 static int run_hook_in_thread( struct hook *hook, struct thread *thread )
 {
     if (hook->process && hook->process != thread->process) return 0;
-    if ((hook->flags & WINEVENT_SKIPOWNPROCESS) && hook->process == thread->process) return 0;
     if (hook->thread && hook->thread != thread) return 0;
+#ifndef SG_MUTANT_WINEVENT_SKIPOWN
+    /* "own" is the process and thread that set the hook: a system-wide hook
+     * (no process, no thread to watch) skipping its own process's events
+     * (AnyDesk's foreground watcher, which closed its own address box the
+     * moment it gave it the focus) */
+    if ((hook->flags & WINEVENT_SKIPOWNPROCESS) && hook->owner->process == thread->process) return 0;
+    if ((hook->flags & WINEVENT_SKIPOWNTHREAD) && hook->owner == thread) return 0;
+#else
+    if ((hook->flags & WINEVENT_SKIPOWNPROCESS) && hook->process == thread->process) return 0;
     if ((hook->flags & WINEVENT_SKIPOWNTHREAD) && hook->thread == thread) return 0;
+#endif
     return 1;
 }
 
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -3849,14 +3849,17 @@
 
 static void sg_watch_windows(void)
 {
+    /* every process's windows, this one's (File Explorer's) too: these hooks
+     * were set to skip this process, which Wine did not do for a hook on all
+     * processes until 0861 -- the bar was made with them seen */
     SetWinEventHook( EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, NULL, sg_window_event, 0, 0,
-                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+                     WINEVENT_OUTOFCONTEXT );
     SetWinEventHook( EVENT_OBJECT_SHOW, EVENT_OBJECT_HIDE, NULL, sg_window_event, 0, 0,
-                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+                     WINEVENT_OUTOFCONTEXT );
     SetWinEventHook( EVENT_OBJECT_NAMECHANGE, EVENT_OBJECT_NAMECHANGE, NULL, sg_window_event, 0, 0,
-                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+                     WINEVENT_OUTOFCONTEXT );
     SetWinEventHook( EVENT_OBJECT_LOCATIONCHANGE, EVENT_OBJECT_LOCATIONCHANGE, NULL, sg_window_event, 0, 0,
-                     WINEVENT_OUTOFCONTEXT | WINEVENT_SKIPOWNPROCESS );
+                     WINEVENT_OUTOFCONTEXT );
     /* this process's windows too (File Explorer's) */
     SetWinEventHook( EVENT_SYSTEM_FOREGROUND, EVENT_SYSTEM_FOREGROUND, NULL, sg_foreground_event, 0, 0,
                      WINEVENT_OUTOFCONTEXT );
