+/* the part of input INDEX the effect needs to make OUTPUT (GetEffectRequiredInputRectangles):
+ * the output rectangle back through what the effect does to its inputs */
+void d2d_effect_required_input_rect(struct d2d_effect *effect, UINT32 index, const D2D1_RECT_L *output,
+        D2D1_RECT_L *in)
+{
+    const GUID *id = &effect->id;
+    D2D1_MATRIX_3X2_F m, inv;
+    float f, v[4];
+    UINT32 u, w;
+
+    *in = *output;
+#ifdef SG_MUTANT_D2D_REQUIRED_IDENTITY
+    return;
+#endif
+    if (!effect->builtin)
+    {
+        /* what a custom effect's transforms need is theirs to say: all of the input */
+        if (!effect->graph || !effect->graph->passthrough)
+            *in = infinite_rect;
+        return;
+    }
+    if (IsEqualGUID(id, &CLSID_D2D1Crop) || IsEqualGUID(id, &CLSID_D2D1Atlas))
+    {
+        if (get_floats(effect, 0, D2D1_PROPERTY_TYPE_VECTOR4, v, 4) && (v[0] < v[2] && v[1] < v[3]))
+        {
+            D2D1_RECT_L crop = { clamp_to_long(floor(v[0])), clamp_to_long(floor(v[1])),
+                                 clamp_to_long(ceil(v[2])), clamp_to_long(ceil(v[3])) };
+            rect_l_intersect(in, &crop);
+        }
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1GaussianBlur) || IsEqualGUID(id, &CLSID_D2D1Shadow)
+            || IsEqualGUID(id, &CLSID_D2D1DirectionalBlur))
+    {
+        if (!get_float(effect, 0, &f)) f = 3.0f;
+        rect_l_inflate(in, 3.0 * f, 3.0 * f);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Morphology))
+    {
+        if (!get_uint(effect, 1, D2D1_PROPERTY_TYPE_UINT32, &u)) u = 1;
+        if (!get_uint(effect, 2, D2D1_PROPERTY_TYPE_UINT32, &w)) w = 1;
+        rect_l_inflate(in, u / 2.0, w / 2.0);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1ConvolveMatrix) || IsEqualGUID(id, &CLSID_D2D1EdgeDetection)
+            || IsEqualGUID(id, &CLSID_D2D1Emboss) || IsEqualGUID(id, &CLSID_D2D1Sharpen))
+    {
+        rect_l_inflate(in, 1.0, 1.0);
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Scale) || IsEqualGUID(id, &CLSID_D2D12DAffineTransform)
+            || IsEqualGUID(id, &CLSID_D2D1DpiCompensation)
+            || (IsEqualGUID(id, &CLSID_D2D13DTransform) && fx_3d_transform_affine(effect, &m)))
+    {
+        BOOL have = FALSE;
+        float s[4];
+
+        if (IsEqualGUID(id, &CLSID_D2D1Scale) && get_floats(effect, 0, D2D1_PROPERTY_TYPE_VECTOR2, s, 2)
+                && get_floats(effect, 1, D2D1_PROPERTY_TYPE_VECTOR2, s + 2, 2))
+        {
+            m._11 = s[0]; m._12 = 0.0f; m._21 = 0.0f; m._22 = s[1];
+            m._31 = s[2] - s[2] * s[0]; m._32 = s[3] - s[3] * s[1];
+            have = TRUE;
+        }
+        else if (IsEqualGUID(id, &CLSID_D2D12DAffineTransform))
+            have = get_floats(effect, 2, D2D1_PROPERTY_TYPE_MATRIX_3X2, (float *)&m, 6);
+        else if (IsEqualGUID(id, &CLSID_D2D1DpiCompensation) && get_float(effect, 2, &f) && f > 0.0f)
+        {
+            m._11 = m._22 = 96.0f / f; m._12 = m._21 = m._31 = m._32 = 0.0f;
+            have = TRUE;
+        }
+        else if (IsEqualGUID(id, &CLSID_D2D13DTransform))
+            have = TRUE;
+        if (have)
+        {
+            if (d2d_matrix_invert(&inv, &m)) rect_l_transform(in, &inv);
+            else *in = infinite_rect;
+            rect_l_inflate(in, 1.0, 1.0);   /* the filter's neighbours */
+        }
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D13DTransform) || IsEqualGUID(id, &CLSID_D2D13DPerspectiveTransform)
+            || IsEqualGUID(id, &CLSID_D2D1Straighten) || IsEqualGUID(id, &CLSID_D2D1Border))
+    {
+        *in = infinite_rect;   /* any of it may be pulled in */
+    }
+    else if (IsEqualGUID(id, &CLSID_D2D1Tile))
+    {
+        if (get_floats(effect, 0, D2D1_PROPERTY_TYPE_VECTOR4, v, 4) && v[0] < v[2] && v[1] < v[3])
+        {
+            D2D1_RECT_L tile = { clamp_to_long(floor(v[0])), clamp_to_long(floor(v[1])),
+                                 clamp_to_long(ceil(v[2])), clamp_to_long(ceil(v[3])) };
+            *in = tile;
+        }
+    }
+    /* everything else needs the same pixels of each input */
+}
