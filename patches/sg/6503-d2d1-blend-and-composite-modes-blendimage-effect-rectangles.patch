+/* Stained Glass OS (wine-sg 6503): where input INDEX's rectangle IN lands in the effect's
+ * output (an invalidated part of an input: InvalidateEffectInputRectangle) */
+HRESULT d2d_effect_map_input_rect(struct d2d_effect *effect, UINT32 index, const D2D1_RECT_L *in, D2D1_RECT_L *out)
+{
+    D2D1_RECT_L stack_rects[8], *inputs = stack_rects;
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    if (index >= effect->input_count)
+        return E_INVALIDARG;
+    if (effect->input_count > ARRAY_SIZE(stack_rects) && !(inputs = calloc(effect->input_count, sizeof(*inputs))))
+        return E_OUTOFMEMORY;
+    /* the others contribute nothing that changed */
+    for (i = 0; i < effect->input_count; ++i)
+        inputs[i] = *in;
+    if (effect->builtin)
+        d2d_builtin_output_rect(effect, inputs, out);
+    else
+        hr = d2d_effect_output_rect(effect, inputs, 0, out);
+    if (inputs != stack_rects)
+        free(inputs);
+    return hr;
+}
