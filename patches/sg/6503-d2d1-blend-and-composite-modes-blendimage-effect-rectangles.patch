+/* RECT (NULL: all) of the effect's output changed: it is invalid until the effect is drawn */
+void d2d_effect_invalidate(struct d2d_effect *effect, const D2D1_RECT_L *rect)
+{
+    if (effect->invalid_all)
+        return;
+    if (!rect)
+    {
+        effect->invalid_all = TRUE;
+        effect->invalid_count = 0;
+        return;
+    }
+    if (rect_l_is_empty(rect))
+        return;
+    if (!d2d_array_reserve((void **)&effect->invalid, &effect->invalid_size, effect->invalid_count + 1,
+            sizeof(*effect->invalid)))
+    {
+        effect->invalid_all = TRUE;
+        effect->invalid_count = 0;
+        return;
+    }
+    effect->invalid[effect->invalid_count++] = *rect;
+}
+
+/* the effect, and the effects drawn into it, were drawn: nothing of them is invalid */
+void d2d_effect_validate(struct d2d_effect *effect, unsigned int depth)
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_D2D_INVALID_KEPT
+    return;
+#endif
+    if (depth > 64)
+        return;
+    effect->invalid_all = FALSE;
+    effect->invalid_count = 0;
+    for (i = 0; i < effect->input_count; ++i)
+    {
+        struct d2d_effect *input = d2d_effect_from_image(effect->inputs[i]);
+        if (input) d2d_effect_validate(input, depth + 1);
+    }
+}
