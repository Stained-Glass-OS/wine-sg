+/* Stained Glass OS (wine-sg 6503): an enum property's <Fields><Field name= displayname= index=/></Fields>:
+ * its D2D1_SUBPROPERTY_FIELDS array, one string per member (its display name) with an Index */
+static HRESULT parse_effect_enum_fields(IXmlReader *reader, struct d2d_effect_registration *effect,
+        const WCHAR *property_name, unsigned int element_depth)
+{
+    struct d2d_effect_property *property, *fields = NULL;
+    struct d2d_effect_properties *sub = NULL;
+    const WCHAR *node_name;
+    XmlNodeType node_type;
+    unsigned int depth, count = 0;
+    HRESULT hr;
+
+    if (!(property = d2d_effect_properties_get_property_by_name(effect->properties, property_name)))
+        return E_FAIL;
+    while ((hr = IXmlReader_Read(reader, &node_type)) == S_OK)
+    {
+        IXmlReader_GetDepth(reader, &depth);
+        if (node_type == XmlNodeType_EndElement && depth == element_depth + 1)
+            break;
+        if (node_type != XmlNodeType_Element || FAILED(IXmlReader_GetLocalName(reader, &node_name, NULL)))
+            continue;
+        if (!wcscmp(node_name, L"Fields") && !fields)
+        {
+            if (!property->subproperties)
+            {
+                if (!(property->subproperties = calloc(1, sizeof(*property->subproperties))))
+                    return E_OUTOFMEMORY;
+                d2d_effect_init_properties(NULL, property->subproperties);
+            }
+            if (FAILED(hr = d2d_effect_subproperties_add(property->subproperties, L"Fields", D2D1_SUBPROPERTY_FIELDS,
+                    D2D1_PROPERTY_TYPE_ARRAY, NULL)))
+                return hr;
+            if (!(fields = d2d_effect_properties_get_property_by_name(property->subproperties, L"Fields")))
+                return E_FAIL;
+            if (!(fields->subproperties = calloc(1, sizeof(*fields->subproperties))))
+                return E_OUTOFMEMORY;
+            d2d_effect_init_properties(NULL, fields->subproperties);
+            sub = fields->subproperties;
+        }
+        else if (!wcscmp(node_name, L"Field") && sub)
+        {
+            WCHAR *field = NULL, *display = NULL, *index = NULL;
+            struct d2d_effect_property *entry;
+
+            parse_effect_get_attribute(reader, L"name", &field);
+            parse_effect_get_attribute(reader, L"displayname", &display);
+            parse_effect_get_attribute(reader, L"index", &index);
+            if (field && index)
+            {
+                hr = d2d_effect_subproperties_add(sub, field, count, D2D1_PROPERTY_TYPE_STRING, display ? display : field);
+                if (SUCCEEDED(hr) && (entry = d2d_effect_properties_get_property_by_name(sub, field)))
+                {
+                    if (!(entry->subproperties = calloc(1, sizeof(*entry->subproperties))))
+                        hr = E_OUTOFMEMORY;
+                    else
+                    {
+                        d2d_effect_init_properties(NULL, entry->subproperties);
+                        hr = d2d_effect_subproperties_add(entry->subproperties, L"Index", 0, D2D1_PROPERTY_TYPE_UINT32,
+                                index);
+                    }
+                }
+                count++;
+            }
+            free(field);
+            free(display);
+            free(index);
+            if (FAILED(hr))
+                return hr;
+        }
+    }
+    if (fields)
+        *(UINT32 *)(property->subproperties->data.ptr + fields->data.offset) = count;
+    return hr == S_FALSE ? S_OK : hr;
+}
