+static HRESULT fx_two_shaders(struct fx_renderer *r, ID3D11PixelShader **ps, ID3D11VertexShader **vs)
+{
+    /* this renderer's own ids for the two-input shader and its vertex shader */
+    static const GUID ps_id = {0x5f2b0e8b, 0x7c1d, 0x4a3e, {0x9b, 0x6f, 0x1d, 0x2c, 0x3e, 0x4f, 0x5a, 0x6c}};
+    static const GUID vs_id = {0x6f2b0e8b, 0x7c1d, 0x4a3e, {0x9b, 0x6f, 0x1d, 0x2c, 0x3e, 0x4f, 0x5a, 0x6c}};
+    struct d2d_device *device = r->context->device;
+    ID3DBlob *code = NULL, *errors = NULL;
+    HRESULT hr;
+
+    if (d2d_device_get_indexed_object(&device->fx_internal, &ps_id, (IUnknown **)ps)
+            && d2d_device_get_indexed_object(&device->fx_internal, &vs_id, (IUnknown **)vs))
+        return S_OK;
+    if (*ps) ID3D11PixelShader_Release(*ps);
+    *ps = NULL;
+
+    if (FAILED(hr = D3DCompile(fx_two_ps, sizeof(fx_two_ps) - 1, "fx_two", NULL, NULL, "main",
+            "ps_4_0", 0, 0, &code, &errors)))
+    {
+        ERR("Failed to compile the two-input effects' shader, hr %#lx: %s\n", hr,
+                errors ? debugstr_a(ID3D10Blob_GetBufferPointer(errors)) : "");
+        if (errors) ID3D10Blob_Release(errors);
+        return hr;
+    }
+    if (SUCCEEDED(hr = ID3D11Device1_CreatePixelShader(r->device, ID3D10Blob_GetBufferPointer(code),
+            ID3D10Blob_GetBufferSize(code), NULL, ps)))
+        hr = fx_make_vertex_shader(r, ID3D10Blob_GetBufferPointer(code), ID3D10Blob_GetBufferSize(code), vs);
+    ID3D10Blob_Release(code);
+    if (FAILED(hr))
+    {
+        if (*ps) ID3D11PixelShader_Release(*ps);
+        *ps = NULL;
+        return hr;
+    }
+    d2d_device_add_indexed_object(&device->fx_internal, &ps_id, (IUnknown *)*ps);
+    d2d_device_add_indexed_object(&device->fx_internal, &vs_id, (IUnknown *)*vs);
+    return S_OK;
+}
