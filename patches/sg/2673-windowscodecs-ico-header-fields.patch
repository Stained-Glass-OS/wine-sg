From: Stained Glass OS <ke7oxh@gmail.com>
windowscodecs: the ICO decoder does not check the reserved and type fields

The decoder initializes from a stream whose icon directory has any reserved
or type value, as the Wine test records from native. Removes the two
todo_wine marks of that test.
---
--- a/dlls/windowscodecs/icoformat.c
+++ b/dlls/windowscodecs/icoformat.c
@@ -535,12 +535,15 @@ static HRESULT WINAPI IcoDecoder_Initialize(IWICBitmapDecoder *iface, IStream *p
         goto end;
     }
 
+    /* The reserved and type fields are not checked: decoders are chosen by pattern, not by them. */
+#ifdef SG_MUTANT_WICICO_STRICT_HEADER
     if (This->header.idReserved != 0 ||
         This->header.idType != 1)
     {
         hr = E_FAIL;
         goto end;
     }
+#endif
 
     hr = IStream_Stat(pIStream, &statstg, STATFLAG_NONAME);
     if (FAILED(hr))
--- a/dlls/windowscodecs/tests/icoformat.c
+++ b/dlls/windowscodecs/tests/icoformat.c
@@ -227,10 +227,10 @@ static void test_decoder(void)
     /* Header fields validation. */
     ico = ico_1;
     ico.header.idReserved = 1;
-    test_ico_data_todo(&ico, sizeof(ico), S_OK);
+    test_ico_data(&ico, sizeof(ico), S_OK);
     ico.header.idReserved = 0;
     ico.header.idType = 100;
-    test_ico_data_todo(&ico, sizeof(ico), S_OK);
+    test_ico_data(&ico, sizeof(ico), S_OK);
 
     /* Premature end of data. */
     ico = ico_1;
