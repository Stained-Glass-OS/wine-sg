+static int stack_sibling_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return (event->error_code == BadMatch || event->error_code == BadWindow);
+}
+
+/***********************************************************************
+ *     get_stack_predecessor
+ *
+ * Stained Glass OS: in a virtual desktop no window manager stacks the
+ * windows -- they are children of the desktop's window, a new one starts at
+ * the top of them, and a focused one was raised to the top. Their X stacking
+ * must follow Wine's Z order: returns TRUE when the window is the top visible
+ * one, else FALSE with *below the X window of the visible window before it
+ * (0 outside a virtual desktop, where the window manager stacks).
+ */
+BOOL get_stack_predecessor( HWND hwnd, BOOL managed, Window *below )
+{
+    HWND prev = NtUserGetWindowRelative( hwnd, GW_HWNDPREV );
+
+    *below = 0;
+    while (prev && !(NtUserGetWindowLongW( prev, GWL_STYLE ) & WS_VISIBLE))
+        prev = NtUserGetWindowRelative( prev, GW_HWNDPREV );
+    if (!prev) return TRUE;
+    if (is_virtual_desktop() && !managed) *below = X11DRV_get_whole_window( prev );
+    return FALSE;
+}
+
+/* stack the window right below another; FALSE when that is no sibling */
+BOOL stack_window_below( Display *display, Window window, Window below )
+{
+    XWindowChanges changes;
+
+    if (!below || below == window) return FALSE;
+    changes.sibling = below;
+    changes.stack_mode = Below;
+    X11DRV_expect_error( display, stack_sibling_error, NULL );
+    XConfigureWindow( display, window, CWSibling | CWStackMode, &changes );
+    return !X11DRV_check_error();
+}
+
+/* above: raise to the top of the stack; below: otherwise, the X window to
+ * stack right below (0: leave the stacking alone) */
