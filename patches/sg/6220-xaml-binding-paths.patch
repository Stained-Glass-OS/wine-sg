From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: template binding paths, a ContentPresenter's left default

A {Binding A.B, RelativeSource={RelativeSource TemplatedParent}} whose path goes through an object the control holds was not made: WinUI 2's NavigationView binds its top bar's Visibility to TemplateSettings.TopPaneVisibility, so Windows Terminal's settings showed an empty top bar with an overflow button above the page. The path is now followed, now and when any member along it changes; text markup's {Binding ..., RelativeSource={RelativeSource TemplatedParent}} is made as compiled markup's is. A ContentPresenter's text sat in its middle (a Control's HorizontalContentAlignment default); a presenter's own default is Left, so Terminal's settings menu reads from the left.
---
diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
index 38d6205..9f81a41 100644
--- a/dlls/windows.ui.xaml/control.c
+++ b/dlls/windows.ui.xaml/control.c
@@ -332,6 +332,12 @@ void control_arrange( struct uielem *elem, struct xsize final, struct xsize *use
         INT32 h = get_enum( control, prop_hcontent, &IID_IReference_HorizontalAlignment, XALIGN_LEFT );
         INT32 v = get_enum( control, prop_vcontent, &IID_IReference_VerticalAlignment, XALIGN_LEFT );
         struct xsize size = control->child->desired;
+#ifndef SG_MUTANT_PRESENTER_CONTENT_CENTRED
+        /* a ContentPresenter's own HorizontalContentAlignment default is Left (a Control's is Center);
+         * (its VerticalContentAlignment's, Top, is not taken yet: presenters a template centres with
+         * their own VerticalAlignment are still arranged at full height here) */
+        if (xaml_is_presenter( elem ) && !dobj_has_value( &control->e.d, prop_hcontent )) h = XALIGN_LEFT;
+#endif
         if (h != XALIGN_STRETCH && size.width < rect.width)
         {
             rect.x += h == XALIGN_CENTER ? (rect.width - size.width) / 2 : h == XALIGN_RIGHT ? rect.width - size.width : 0;
diff --git a/dlls/windows.ui.xaml/markup.c b/dlls/windows.ui.xaml/markup.c
index a230ca0..9370cda 100644
--- a/dlls/windows.ui.xaml/markup.c
+++ b/dlls/windows.ui.xaml/markup.c
@@ -958,6 +958,26 @@ HRESULT xaml_writer_set( struct xaml_writer *writer, IInspectable *obj, const WC
         if (!writer->templated_parent) return S_OK;   /* outside a template: nothing to bind */
         return xaml_template_bind( writer->templated_parent, obj, name, source );
     }
+#ifndef SG_MUTANT_NO_MARKUP_BINDING
+    if (str && !wcsncmp( str, L"{Binding", 8 ) && (str[8] == ' ' || str[8] == '}') && wcsstr( str, L"RelativeSource TemplatedParent" ))
+#else
+    if (FALSE)
+#endif
+    {
+        /* {Binding Path, RelativeSource={RelativeSource TemplatedParent}} (or Path=...): as compiled markup's */
+        WCHAR path[128];
+        const WCHAR *p = str + 8;
+        size_t n = 0;
+
+        path[0] = 0;
+        while (*p == ' ') p++;
+        if (wcsstr( p, L"Path=" )) p = wcsstr( p, L"Path=" ) + 5;
+        else if (!wcsncmp( p, L"RelativeSource", 14 )) p = L"";
+        while (*p && *p != '}' && *p != ',' && *p != ' ' && n < ARRAY_SIZE(path) - 1) path[n++] = *p++;
+        path[n] = 0;
+        if (!writer->templated_parent || !path[0]) return S_OK;
+        return xaml_template_bind( writer->templated_parent, obj, name, path );
+    }
     if (str && str[0] == '{' && str[1] != '}')
     {
         IInspectable *ext = NULL;
diff --git a/dlls/windows.ui.xaml/templates.c b/dlls/windows.ui.xaml/templates.c
index b0ec18b..47a3219 100644
--- a/dlls/windows.ui.xaml/templates.c
+++ b/dlls/windows.ui.xaml/templates.c
@@ -379,9 +379,130 @@ static HRESULT WINAPI tbinding_Invoke( IUnknown *iface, IInspectable *sender, II
 
 static const void *tbinding_vtbl[] = { tbinding_QueryInterface, tbinding_AddRef, tbinding_Release, tbinding_Invoke };
 
+/* ---- a {Binding A.B, RelativeSource TemplatedParent}: a path through the control's members ---- */
+
+struct pbinding
+{
+    IUnknown IUnknown_iface;        /* a DependencyPropertyChangedCallback on each object of the path */
+    LONG ref;
+    IUnknown *target;
+    struct dobj *target_obj;
+    struct xaml_property *target_prop;
+    struct dobj *root;
+    WCHAR *path;
+};
+
+static struct pbinding *pbinding_from_iface( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct pbinding, IUnknown_iface );
+}
+
+static ULONG WINAPI pbinding_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &pbinding_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI pbinding_Release( IUnknown *iface )
+{
+    struct pbinding *b = pbinding_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &b->ref );
+
+    if (!ref)
+    {
+        if (b->target) IUnknown_Release( b->target );
+        free( b->path );
+        free( b );
+    }
+    return ref;
+}
+
+/* the path's value from the root (a reference); SUBSCRIBE: follow each of its members' changes */
+static IInspectable *pbinding_value( struct pbinding *b, BOOL subscribe )
+{
+    struct dobj *obj = b->root;
+    IInspectable *value = NULL, *holder = NULL;
+    WCHAR *path = wcsdup( b->path ), *seg, *next;
+    struct xaml_property *prop;
+
+    for (seg = path; seg && obj; seg = next)
+    {
+        if ((next = wcschr( seg, '.' ))) *next++ = 0;
+        if (!(prop = xaml_find_member( obj, seg )))
+        {
+            FIXME( "binding path %s: no %s\n", debugstr_w( b->path ), debugstr_w( seg ) );
+            if (value) IInspectable_Release( value );
+            value = NULL;
+            break;
+        }
+        if (subscribe) dobj_add_callback( obj, prop, &b->IUnknown_iface );
+        if (value) IInspectable_Release( value );
+        value = NULL;
+        dobj_get_value( obj, prop, &value );
+        if (holder) IInspectable_Release( holder );
+        holder = NULL;
+        if (next)
+        {
+            if (!value) break;
+            obj = dobj_from_inspectable( value );
+            holder = value;   /* keeps the object while its member is read */
+            value = NULL;
+        }
+    }
+    if (holder) IInspectable_Release( holder );
+    free( path );
+    return value;
+}
+
+static void pbinding_update( struct pbinding *b, BOOL subscribe )
+{
+    IInspectable *value = pbinding_value( b, subscribe ), *bound = bound_value( b->target_prop, value );
+
+    TRACE( "%p.%s from path %s: %p\n", b->target_obj, debugstr_w( b->target_prop->name ), debugstr_w( b->path ), value );
+    dobj_set_value( b->target_obj, b->target_prop, bound );
+    if (bound) IInspectable_Release( bound );
+    if (value) IInspectable_Release( value );
+}
+
+static HRESULT WINAPI pbinding_Invoke( IUnknown *iface, IInspectable *sender, IInspectable *dp )
+{
+    pbinding_update( pbinding_from_iface( iface ), FALSE );
+    return S_OK;
+}
+
+static const void *pbinding_vtbl[] = { tbinding_QueryInterface, pbinding_AddRef, pbinding_Release, pbinding_Invoke };
+
+static HRESULT bind_path( struct uielem *templated_parent, struct dobj *target_obj, struct xaml_property *target_prop,
+                          const WCHAR *path )
+{
+    struct pbinding *b;
+
+    if (!(b = calloc( 1, sizeof(*b) )) || !(b->path = wcsdup( path )))
+    {
+        free( b );
+        return E_OUTOFMEMORY;
+    }
+    b->IUnknown_iface.lpVtbl = (void *)pbinding_vtbl;
+    b->ref = 1;
+    IUnknown_QueryInterface( target_obj->obj.outer, &IID_IUnknown, (void **)&b->target );
+    b->target_obj = target_obj;
+    b->target_prop = target_prop;
+    b->root = &templated_parent->d;
+    pbinding_update( b, TRUE );
+    IUnknown_Release( &b->IUnknown_iface );
+    return S_OK;
+}
+
 /* {TemplateBinding Source} on a template element's member: its value now and when it changes */
 HRESULT xaml_template_bind( struct uielem *templated_parent, IInspectable *target, const WCHAR *member, const WCHAR *source )
 {
+#ifndef SG_MUTANT_NO_BINDING_PATHS
+    struct dobj *target_obj = dobj_from_inspectable( target );
+    struct xaml_property *target_prop;
+
+    /* a path (TemplateSettings.TopPaneVisibility): through the objects its members hold */
+    if (source && wcschr( source, L'.' ) && !wcschr( source, L'(' ) && target_obj && (target_prop = xaml_find_owned_member( target_obj, NULL, member )))
+        return bind_path( templated_parent, target_obj, target_prop, source );
+#endif
     return xaml_template_bind_owned( templated_parent, target, NULL, member, NULL, source );
 }
 
