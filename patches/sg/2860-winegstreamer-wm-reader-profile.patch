+/* The profile of a reader: the streams of the file, minus those removed,
+ * plus those added. Called with reader->cs held. */
+static struct stream_attrs *profile_entry(struct wm_reader *reader, DWORD index,
+        WORD *number, struct wm_stream **stream, struct extra_stream **extra)
+{
+    unsigned int i;
+
+    for (i = 0; i < reader->stream_count; ++i)
+    {
+        struct wm_stream *s = &reader->streams[i];
+
+        if (s->attrs.removed)
+            continue;
+        if (!index--)
+        {
+            *number = i + 1;
+            *stream = s;
+            *extra = NULL;
+            return &s->attrs;
+        }
+    }
+    for (i = 0; i < reader->extra_count; ++i)
+    {
+        struct extra_stream *e = &reader->extras[i];
+
+        if (!index--)
+        {
+            *number = e->number;
+            *stream = NULL;
+            *extra = e;
+            return &e->attrs;
+        }
+    }
+    return NULL;
+}
+
+static struct stream_attrs *profile_find(struct wm_reader *reader, WORD number,
+        struct wm_stream **stream, struct extra_stream **extra)
+{
+    struct stream_attrs *attrs;
+    WORD n;
+    DWORD i;
+
+    for (i = 0; (attrs = profile_entry(reader, i, &n, stream, extra)); ++i)
+    {
+        if (n == number)
+            return attrs;
+    }
+    return NULL;
+}
+
+static void profile_clear(struct wm_reader *reader)
+{
+    unsigned int i;
+
+    for (i = 0; i < reader->extra_count; ++i)
+        stream_attrs_clear(&reader->extras[i].attrs);
+    free(reader->extras);
+    free(reader->profile_name);
+    free(reader->profile_description);
+    for (i = 0; i < reader->mutex_count; ++i)
+        IWMMutualExclusion_Release(reader->mutexes[i]);
+    free(reader->mutexes);
+    for (i = 0; i < reader->sharing_count; ++i)
+        IWMBandwidthSharing_Release(reader->sharings[i]);
+    free(reader->sharings);
+    if (reader->priorities)
+        IWMStreamPrioritization_Release(reader->priorities);
+}
+
+static struct stream_config *unsafe_impl_from_IWMStreamConfig(IWMStreamConfig *iface)
+{
+    if (!iface || iface->lpVtbl != &stream_config_vtbl)
+        return NULL;
+    return impl_from_IWMStreamConfig(iface);
+}
+
+static HRESULT stream_config_create(struct wm_reader *reader, const struct wm_stream *stream,
+        WORD number, const GUID *type, const struct stream_attrs *attrs, struct stream_config **out)
+{
+    struct stream_config *object;
+    HRESULT hr;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IWMStreamConfig_iface.lpVtbl = &stream_config_vtbl;
+    object->IWMMediaProps_iface.lpVtbl = &stream_props_vtbl;
+    object->refcount = 1;
+    object->reader = reader;
+    object->stream = stream;
+    object->number = number;
+    object->type = *type;
+    if (FAILED(hr = stream_attrs_copy(&object->attrs, attrs)))
+    {
+        free(object);
+        return hr;
+    }
+    IWMProfile3_AddRef(&reader->IWMProfile3_iface);
+
+    TRACE("Created stream config %p.\n", object);
+    *out = object;
+    return S_OK;
+}
+
+static void profile_forget_stream(struct wm_reader *reader, WORD number)
+{
+    unsigned int i;
+
+    for (i = 0; i < reader->mutex_count; ++i)
+        IWMMutualExclusion_RemoveStream(reader->mutexes[i], number);
+    for (i = 0; i < reader->sharing_count; ++i)
+        IWMBandwidthSharing_RemoveStream(reader->sharings[i], number);
+}
+
+static HRESULT profile_remove_stream(struct wm_reader *reader, WORD number)
+{
+    struct extra_stream *extra;
+    struct wm_stream *stream;
+    struct stream_attrs *attrs;
+
+    EnterCriticalSection(&reader->cs);
+
+    if (!(attrs = profile_find(reader, number, &stream, &extra)))
+    {
+        LeaveCriticalSection(&reader->cs);
+        return NS_E_NO_STREAM;
+    }
+
+#ifndef SG_MUTANT_REMOVE
+    if (stream)
+    {
+        stream_attrs_clear(attrs);
+        attrs->removed = true;
+    }
+    else
+    {
+        stream_attrs_clear(attrs);
+        memmove(extra, extra + 1, (&reader->extras[reader->extra_count] - (extra + 1)) * sizeof(*extra));
+        --reader->extra_count;
+    }
+    profile_forget_stream(reader, number);
+#endif
+
+    LeaveCriticalSection(&reader->cs);
+    return S_OK;
+}
