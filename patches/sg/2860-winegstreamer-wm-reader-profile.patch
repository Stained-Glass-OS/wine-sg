+/* The Windows Media Format SDK string getters: a NULL buffer returns the
+ * length needed, in characters including the terminator; a short buffer
+ * returns that length with ASF_E_BUFFERTOOSMALL. */
+static HRESULT get_string_property(const WCHAR *str, WCHAR *out, DWORD *len)
+{
+    DWORD length = str ? wcslen(str) : 0;
+    DWORD size = length + 1;
+
+    if (!len)
+        return E_INVALIDARG;
+
+#ifdef SG_MUTANT_STRLEN
+    size--;
+#endif
+    if (!out)
+    {
+        *len = size;
+        return S_OK;
+    }
+    if (*len < size)
+    {
+        *len = size;
+        return ASF_E_BUFFERTOOSMALL;
+    }
+    if (length)
+        memcpy(out, str, length * sizeof(WCHAR));
+    out[length] = 0;
+    *len = size;
+    return S_OK;
+}
+
+static HRESULT get_string_property_word(const WCHAR *str, WCHAR *out, WORD *len)
+{
+    DWORD size;
+    HRESULT hr;
+
+    if (!len)
+        return E_INVALIDARG;
+    size = *len;
+    hr = get_string_property(str, out, &size);
+    if (hr == S_OK || hr == ASF_E_BUFFERTOOSMALL)
+        *len = min(size, 0xffff);
+    return hr;
+}
+
+static HRESULT set_string_property(WCHAR **dst, const WCHAR *src, size_t max)
+{
+    WCHAR *copy;
+
+    if (!src || wcslen(src) + 1 > max)
+        return E_INVALIDARG;
+    if (!(copy = wcsdup(src)))
+        return E_OUTOFMEMORY;
+    free(*dst);
+    *dst = copy;
+    return S_OK;
+}
+
+static void stream_attrs_clear(struct stream_attrs *attrs)
+{
+    free(attrs->name);
+    free(attrs->connection);
+    if (attrs->mt)
+    {
+        FreeMediaType(attrs->mt);
+        free(attrs->mt);
+    }
+    memset(attrs, 0, sizeof(*attrs));
+}
+
+static HRESULT stream_attrs_copy(struct stream_attrs *dst, const struct stream_attrs *src)
+{
+    struct stream_attrs tmp = *src;
+
+    tmp.name = tmp.connection = NULL;
+    tmp.mt = NULL;
+    tmp.removed = false;
+
+    if ((src->name && !(tmp.name = wcsdup(src->name)))
+            || (src->connection && !(tmp.connection = wcsdup(src->connection))))
+        goto fail;
+    if (src->mt)
+    {
+        if (!(tmp.mt = calloc(1, sizeof(*tmp.mt))))
+            goto fail;
+        if (FAILED(CopyMediaType(tmp.mt, src->mt)))
+        {
+            free(tmp.mt);
+            tmp.mt = NULL;
+            goto fail;
+        }
+    }
+
+    stream_attrs_clear(dst);
+    *dst = tmp;
+    return S_OK;
+
+fail:
+    stream_attrs_clear(&tmp);
+    return E_OUTOFMEMORY;
+}
+
+/* Copy a media type out through the buffer-size protocol shared by
+ * IWMMediaProps::GetMediaType and IWMOutputMediaProps::GetMediaType. */
+static HRESULT copy_wm_media_type(const AM_MEDIA_TYPE *src, WM_MEDIA_TYPE *mt, DWORD *size)
+{
+    const DWORD req_size = *size;
+
+    *size = sizeof(*mt) + src->cbFormat;
+    if (!mt)
+        return S_OK;
+    if (req_size < *size)
+        return ASF_E_BUFFERTOOSMALL;
+
+    memcpy(mt, src, sizeof(*mt));
+    memcpy(mt + 1, src->pbFormat, src->cbFormat);
+    mt->pbFormat = (BYTE *)(mt + 1);
+    return S_OK;
+}
