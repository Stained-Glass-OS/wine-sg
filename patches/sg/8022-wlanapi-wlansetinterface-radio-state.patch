From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wlanapi: WlanSetInterface, and the radio state

WlanSetInterface was a spec stub (its name is in OBS's binaries); WlanQueryInterface did not know wlan_intf_opcode_radio_state. The radio's software switch is NetworkManager's (sg-netctl wifi radio status / on / off): one PHY, index 0, its hardware state reported on when the software state is known. Automatic configuration, background scans and the infrastructure BSS type are always on here, so setting them on is accepted and off is ERROR_NOT_SUPPORTED; the media streaming mode is a hint to scan less, accepted; the query-only opcodes are ERROR_INVALID_PARAMETER. wlanapi.h gains the radio state types.
---
--- a/include/wlanapi.h
+++ b/include/wlanapi.h
@@ -398,6 +398,28 @@
     WCHAR strProfileXml[1];
 } WLAN_CONNECTION_NOTIFICATION_DATA, *PWLAN_CONNECTION_NOTIFICATION_DATA;
 
+typedef enum _DOT11_RADIO_STATE
+{
+    dot11_radio_state_unknown,
+    dot11_radio_state_on,
+    dot11_radio_state_off
+} DOT11_RADIO_STATE, *PDOT11_RADIO_STATE;
+
+#define WLAN_MAX_PHY_INDEX 64
+
+typedef struct _WLAN_PHY_RADIO_STATE
+{
+    DWORD dwPhyIndex;
+    DOT11_RADIO_STATE dot11SoftwareRadioState;
+    DOT11_RADIO_STATE dot11HardwareRadioState;
+} WLAN_PHY_RADIO_STATE, *PWLAN_PHY_RADIO_STATE;
+
+typedef struct _WLAN_RADIO_STATE
+{
+    DWORD dwNumberOfPhys;
+    WLAN_PHY_RADIO_STATE PhyRadioState[WLAN_MAX_PHY_INDEX];
+} WLAN_RADIO_STATE, *PWLAN_RADIO_STATE;
+
 typedef struct _WLAN_PROFILE_INFO
 {
     WCHAR strProfileName[WLAN_MAX_NAME_LENGTH];
@@ -426,5 +448,6 @@
 DWORD WINAPI WlanGetProfileList(HANDLE, const GUID *, void *, WLAN_PROFILE_INFO_LIST **);
 DWORD WINAPI WlanDeleteProfile(HANDLE, const GUID *, const WCHAR *, void *);
 DWORD WINAPI WlanReasonCodeToString(DWORD, DWORD, WCHAR *, void *);
+DWORD WINAPI WlanSetInterface(HANDLE, const GUID *, WLAN_INTF_OPCODE, DWORD, const void *, void *);
 
 #endif /* _WLAN_WLANAPI_H */
--- a/dlls/wlanapi/main.c
+++ b/dlls/wlanapi/main.c
@@ -490,6 +490,24 @@
     return ERROR_SUCCESS;
 }
 
+/* (wine-sg 8022) sg-netctl wifi radio status: RADIO enabled|disabled */
+static DOT11_RADIO_STATE radio_software_state(void)
+{
+    const WCHAR *args[] = { L"wifi", L"radio", L"status" };
+    DOT11_RADIO_STATE ret = dot11_radio_state_unknown;
+    struct sgnet_reply r;
+    int i;
+
+    if (sgnet_request(args, 3, &r) == 1)
+        for (i = 0; i < r.count; i++)
+        {
+            if (!wcscmp(r.lines[i], L"RADIO enabled")) ret = dot11_radio_state_on;
+            else if (!wcscmp(r.lines[i], L"RADIO disabled")) ret = dot11_radio_state_off;
+        }
+    sgnet_free(&r);
+    return ret;
+}
+
 DWORD WINAPI WlanQueryInterface(HANDLE handle, const GUID *guid, WLAN_INTF_OPCODE opcode,
                     void *reserved, DWORD *data_size, void **data, WLAN_OPCODE_VALUE_TYPE *opcode_type)
 {
@@ -512,6 +530,26 @@
         return ERROR_NOT_FOUND;
     }
 
+    if (opcode == wlan_intf_opcode_radio_state)
+    {
+        /* (wine-sg 8022) the radio's software switch, as NetworkManager has it; one PHY */
+        WLAN_RADIO_STATE *radio;
+        DOT11_RADIO_STATE soft = radio_software_state();
+
+        free(adapters);
+        if (!(radio = WlanAllocateMemory(sizeof(*radio)))) return ERROR_NOT_ENOUGH_MEMORY;
+        memset(radio, 0, sizeof(*radio));
+        radio->dwNumberOfPhys = 1;
+        radio->PhyRadioState[0].dwPhyIndex = 0;
+        radio->PhyRadioState[0].dot11SoftwareRadioState = soft;
+        radio->PhyRadioState[0].dot11HardwareRadioState = soft == dot11_radio_state_unknown ? dot11_radio_state_unknown
+                                                                                              : dot11_radio_state_on;
+        *data = radio;
+        *data_size = sizeof(*radio);
+        if (opcode_type) *opcode_type = wlan_opcode_value_type_set_by_user;
+        return ERROR_SUCCESS;
+    }
+
     switch (opcode)
     {
     case wlan_intf_opcode_autoconf_enabled:
@@ -1059,6 +1097,56 @@
     return ERROR_SUCCESS;
 }
 
+/* (wine-sg 8022) Of what WlanSetInterface sets, NetworkManager has the radio's software switch (wifi
+ * radio on|off, the PHY 0); automatic configuration, background scans and the infrastructure BSS type are
+ * always on here, so keeping them is accepted and turning them off is ERROR_NOT_SUPPORTED. */
+DWORD WINAPI WlanSetInterface(HANDLE handle, const GUID *guid, WLAN_INTF_OPCODE opcode, DWORD size,
+                              const void *data, void *reserved)
+{
+    const WCHAR *args[3] = { L"wifi", L"radio" };
+    struct sgnet_reply r;
+    DWORD err;
+    int rc;
+
+    TRACE("(%p, %s, %#x, %lu, %p, %p)\n", handle, wine_dbgstr_guid(guid), opcode, size, data, reserved);
+
+    if (!handle || !guid || !data || reserved) return ERROR_INVALID_PARAMETER;
+    if ((err = check_interface(handle, guid, NULL, 0))) return err;
+
+    switch (opcode)
+    {
+    case wlan_intf_opcode_radio_state:
+    {
+        const WLAN_PHY_RADIO_STATE *radio = data;
+
+        if (size < sizeof(*radio) || radio->dwPhyIndex != 0) return ERROR_INVALID_PARAMETER;
+        if (radio->dot11SoftwareRadioState == dot11_radio_state_on) args[2] = L"on";
+        else if (radio->dot11SoftwareRadioState == dot11_radio_state_off) args[2] = L"off";
+        else return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_NO_WLAN_RADIO
+        return ERROR_SUCCESS;
+#endif
+        rc = sgnet_request(args, 3, &r);
+        err = rc == 1 ? ERROR_SUCCESS : netctl_error(&r, rc);
+        sgnet_free(&r);
+        return err;
+    }
+    case wlan_intf_opcode_autoconf_enabled:
+    case wlan_intf_opcode_background_scan_enabled:
+        if (size < sizeof(BOOL)) return ERROR_INVALID_PARAMETER;
+        return *(const BOOL *)data ? ERROR_SUCCESS : ERROR_NOT_SUPPORTED;
+    case wlan_intf_opcode_bss_type:
+        if (size < sizeof(DOT11_BSS_TYPE)) return ERROR_INVALID_PARAMETER;
+        return *(const DOT11_BSS_TYPE *)data == dot11_BSS_type_infrastructure ? ERROR_SUCCESS : ERROR_NOT_SUPPORTED;
+    case wlan_intf_opcode_media_streaming_mode:
+        /* a hint to scan less in the background; nothing here to lower */
+        if (size < sizeof(BOOL)) return ERROR_INVALID_PARAMETER;
+        return ERROR_SUCCESS;
+    default:
+        return ERROR_INVALID_PARAMETER;   /* the query-only opcodes */
+    }
+}
+
 void WINAPI WlanFreeMemory(void *ptr)
 {
     TRACE("(%p)\n", ptr);
--- a/dlls/wlanapi/wlanapi.spec
+++ b/dlls/wlanapi/wlanapi.spec
@@ -28,7 +28,7 @@
 @ stdcall WlanScan(ptr ptr ptr ptr ptr)
 @ stub WlanSetAutoConfigParameter
 @ stub WlanSetFilterList
-@ stub WlanSetInterface
+@ stdcall WlanSetInterface(ptr ptr long long ptr ptr)
 @ stub WlanSetProfile
 @ stub WlanSetProfileCustomUserData
 @ stub WlanSetProfileEapUserData
