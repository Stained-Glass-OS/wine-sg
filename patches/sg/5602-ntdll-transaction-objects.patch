+    case TransactionPropertiesInformation: size = FIELD_OFFSET(TRANSACTION_PROPERTIES_INFORMATION, Description); break;
+    default: return STATUS_INVALID_INFO_CLASS;
+    }
+    if (length < size)
+    {
+        if (ret_len) *ret_len = size;
+        return STATUS_INFO_LENGTH_MISMATCH;
+    }
+
+    SERVER_START_REQ( query_transaction )
+    {
+        req->handle = wine_server_obj_handle( transaction );
+        if (class == TransactionPropertiesInformation) wine_server_set_reply( req, desc, sizeof(desc) );
+        if (!(ret = wine_server_call( req )))
+        {
+            memcpy( &guid, &reply->guid_0, sizeof(guid) );
+            outcome = reply->outcome;
+            level = reply->isolation_level;
+            flags = reply->isolation_flags;
+            timeout.QuadPart = reply->timeout;
+            desc_len = reply->desc_len;
