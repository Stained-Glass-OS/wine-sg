+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "config.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <sys/types.h>
+#ifdef HAVE_SYS_RANDOM_H
+# include <sys/random.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "file.h"
+#include "handle.h"
+#include "request.h"
+#include "security.h"
+
+enum transaction_outcome
+{
+    OUTCOME_UNDETERMINED = 1,
+    OUTCOME_COMMITTED    = 2,
+    OUTCOME_ABORTED      = 3,
+};
+
+static const WCHAR transaction_name[] = {'T','r','a','n','s','a','c','t','i','o','n'};
+
+struct type_descr transaction_type =
+{
+    { transaction_name, sizeof(transaction_name) },   /* name */
+    TRANSACTION_ALL_ACCESS,                           /* valid_access */
+    {                                                 /* mapping */
+        STANDARD_RIGHTS_READ | TRANSACTION_QUERY_INFORMATION | SYNCHRONIZE,
+        STANDARD_RIGHTS_WRITE | TRANSACTION_SET_INFORMATION | TRANSACTION_COMMIT | TRANSACTION_ENLIST |
+            TRANSACTION_ROLLBACK | TRANSACTION_PROPAGATE | SYNCHRONIZE,
+        STANDARD_RIGHTS_EXECUTE | SYNCHRONIZE,
+        TRANSACTION_ALL_ACCESS
+    },
+};
+
+struct transaction
+{
+    struct object        obj;              /* object header */
+    struct list          entry;            /* entry in the list of live transactions */
+    GUID                 guid;             /* transaction id */
+    enum transaction_outcome outcome;      /* undetermined while active */
+    unsigned int         isolation_level;
+    unsigned int         isolation_flags;
+    timeout_t            timeout;          /* as given at creation */
+    struct timeout_user *timeout_user;     /* aborts the transaction when it expires */
+    WCHAR               *desc;             /* description */
+    data_size_t          desc_len;         /* its length in bytes */
+};
+
+static struct list transaction_list = LIST_INIT( transaction_list );
+
+static void transaction_dump( struct object *obj, int verbose );
+static int transaction_signaled( struct object *obj, struct wait_queue_entry *entry );
+static unsigned int transaction_map_access( struct object *obj, unsigned int access );
+static void transaction_destroy( struct object *obj );
+
+static const struct object_ops transaction_ops =
+{
+    sizeof(struct transaction),   /* size */
+    &transaction_type,            /* type */
+    transaction_dump,             /* dump */
+    add_queue,                    /* add_queue */
+    remove_queue,                 /* remove_queue */
+    transaction_signaled,         /* signaled */
+    no_satisfied,                 /* satisfied */
+    no_signal,                    /* signal */
+    no_get_fd,                    /* get_fd */
+    transaction_map_access,       /* map_access */
+    default_get_sd,               /* get_sd */
+    default_set_sd,               /* set_sd */
+    default_get_full_name,        /* get_full_name */
+    no_lookup_name,               /* lookup_name */
+    directory_link_name,          /* link_name */
+    default_unlink_name,          /* unlink_name */
+    no_open_file,                 /* open_file */
+    no_kernel_obj_list,           /* get_kernel_obj_list */
+    no_close_handle,              /* close_handle */
+    transaction_destroy           /* destroy */
+};
+
+static void transaction_dump( struct object *obj, int verbose )
+{
+    struct transaction *transaction = (struct transaction *)obj;
+    assert( obj->ops == &transaction_ops );
+    fprintf( stderr, "Transaction outcome=%u\n", transaction->outcome );
+}
+
+static int transaction_signaled( struct object *obj, struct wait_queue_entry *entry )
+{
+    return 0;
+}
+
+static unsigned int transaction_map_access( struct object *obj, unsigned int access )
+{
+    if (access & GENERIC_READ)    access |= STANDARD_RIGHTS_READ | TRANSACTION_QUERY_INFORMATION | SYNCHRONIZE;
+    if (access & GENERIC_WRITE)   access |= STANDARD_RIGHTS_WRITE | TRANSACTION_SET_INFORMATION | TRANSACTION_COMMIT |
+                                            TRANSACTION_ENLIST | TRANSACTION_ROLLBACK | TRANSACTION_PROPAGATE | SYNCHRONIZE;
+    if (access & GENERIC_EXECUTE) access |= STANDARD_RIGHTS_EXECUTE | SYNCHRONIZE;
+    if (access & GENERIC_ALL)     access |= TRANSACTION_ALL_ACCESS;
+    return access & ~(GENERIC_READ | GENERIC_WRITE | GENERIC_EXECUTE | GENERIC_ALL);
+}
+
+static void transaction_timeout( void *private )
+{
+    struct transaction *transaction = private;
+
+    transaction->timeout_user = NULL;
+    /* the transaction is aborted when it has not completed in time */
+    if (transaction->outcome == OUTCOME_UNDETERMINED) transaction->outcome = OUTCOME_ABORTED;
+}
+
+static void transaction_destroy( struct object *obj )
+{
+    struct transaction *transaction = (struct transaction *)obj;
+    assert( obj->ops == &transaction_ops );
+
+    /* the last handle was closed: an active transaction is rolled back */
+    if (transaction->outcome == OUTCOME_UNDETERMINED) transaction->outcome = OUTCOME_ABORTED;
+    if (transaction->timeout_user) remove_timeout_user( transaction->timeout_user );
+    list_remove( &transaction->entry );
+    free( transaction->desc );
+}
+
+static void make_guid( GUID *guid )
+{
+    unsigned char *b = (unsigned char *)guid;
+    unsigned int i;
+
+#ifdef HAVE_SYS_RANDOM_H
+    if (getrandom( b, sizeof(*guid), 0 ) != sizeof(*guid))
+#endif
+        for (i = 0; i < sizeof(*guid); i++) b[i] = rand() >> 4;
+    /* random UUID, version 4 */
+    guid->Data3 = (guid->Data3 & 0x0fff) | 0x4000;
+    guid->Data4[0] = (guid->Data4[0] & 0x3f) | 0x80;
+}
+
+static void guid_from_req( GUID *guid, unsigned int a, unsigned int b, unsigned int c, unsigned int d )
+{
+    unsigned int v[4] = { a, b, c, d };
+    memcpy( guid, v, sizeof(*guid) );
+}
+
+static void guid_to_reply( const GUID *guid, unsigned int *v )
+{
+    memcpy( v, guid, 4 * sizeof(unsigned int) );
+}
+
+static struct transaction *find_transaction( const GUID *guid )
+{
+    struct transaction *transaction;
+
+    LIST_FOR_EACH_ENTRY( transaction, &transaction_list, struct transaction, entry )
+        if (!memcmp( &transaction->guid, guid, sizeof(*guid) )) return transaction;
+    return NULL;
+}
+
+/* create a transaction */
+DECL_HANDLER(create_transaction)
+{
+    struct transaction *transaction;
+    struct unicode_str name;
+    struct object *root;
+    const struct security_descriptor *sd;
+    const struct object_attributes *objattr = get_req_object_attributes( &sd, &name, &root );
+    data_size_t desc_len;
+    const WCHAR *desc;
+    GUID guid;
+
+    if (!objattr) return;
+
+    desc = get_req_data_after_objattr( objattr, &desc_len );
+    desc_len = (desc_len / sizeof(WCHAR)) * sizeof(WCHAR);
+
+    if (req->has_guid) guid_from_req( &guid, req->guid_0, req->guid_1, req->guid_2, req->guid_3 );
+    else make_guid( &guid );
+
+    if (req->has_guid && find_transaction( &guid ))
+    {
+        set_error( STATUS_OBJECT_NAME_COLLISION );
+        goto done;
+    }
+
+    if ((transaction = create_named_object( root, &transaction_ops, &name, objattr->attributes, sd )))
+    {
+        if (get_error() == STATUS_OBJECT_NAME_EXISTS)
+        {
+            reply->handle = alloc_handle( current->process, transaction, req->access, objattr->attributes );
+        }
+        else
+        {
+            if (!sd) set_creator_owner_group( &transaction->obj );
+            transaction->guid = guid;
+            transaction->outcome = OUTCOME_UNDETERMINED;
+            transaction->isolation_level = req->isolation_level;
+            transaction->isolation_flags = req->isolation_flags;
+            transaction->timeout = req->timeout;
+            transaction->timeout_user = NULL;
+            transaction->desc = NULL;
+            transaction->desc_len = 0;
+            list_add_tail( &transaction_list, &transaction->entry );
+            if (desc_len && (transaction->desc = memdup( desc, desc_len ))) transaction->desc_len = desc_len;
+#ifdef SG_MUTANT_TX_NO_TIMEOUT
+            if (0)
+#else
+            if (req->timeout)
+#endif
+                transaction->timeout_user = add_timeout_user( req->timeout, transaction_timeout, transaction );
+            reply->handle = alloc_handle_no_access_check( current->process, transaction,
+                                                          req->access, objattr->attributes );
+        }
+        release_object( transaction );
+    }
+
+done:
+    if (root) release_object( root );
+}
+
+/* open a transaction by name or id */
+DECL_HANDLER(open_transaction)
+{
+    struct unicode_str name = get_req_unicode_str();
+
+    if (req->has_guid)
+    {
+        struct transaction *transaction;
+        GUID guid;
+
+        guid_from_req( &guid, req->guid_0, req->guid_1, req->guid_2, req->guid_3 );
+        if (!(transaction = find_transaction( &guid )))
+        {
+            set_error( STATUS_TRANSACTION_NOT_FOUND );
+            return;
+        }
+        reply->handle = alloc_handle( current->process, transaction, req->access, req->attributes );
+        return;
+    }
+    reply->handle = open_object( current->process, req->rootdir, req->access,
+                                 &transaction_ops, &name, req->attributes );
+}
+
+/* commit a transaction: only while it is active */
+DECL_HANDLER(commit_transaction)
+{
+    struct transaction *transaction;
+
+#ifdef SG_MUTANT_TX_NO_ACCESS
+    if (!(transaction = (struct transaction *)get_handle_obj( current->process, req->handle,
+                                                              0, &transaction_ops )))
+#else
+    if (!(transaction = (struct transaction *)get_handle_obj( current->process, req->handle,
+                                                              TRANSACTION_COMMIT, &transaction_ops )))
+#endif
+        return;
+    switch (transaction->outcome)
+    {
+    case OUTCOME_UNDETERMINED:
+        transaction->outcome = OUTCOME_COMMITTED;
+        if (transaction->timeout_user)
+        {
+            remove_timeout_user( transaction->timeout_user );
+            transaction->timeout_user = NULL;
+        }
+        break;
+    case OUTCOME_COMMITTED:
+#ifndef SG_MUTANT_TX_COMMIT_TWICE
+        set_error( STATUS_TRANSACTION_ALREADY_COMMITTED );
+#endif
+        break;
+    default:
+#ifdef SG_MUTANT_TX_COMMIT_ABORTED
+        transaction->outcome = OUTCOME_COMMITTED;
+#else
+        set_error( STATUS_TRANSACTION_ALREADY_ABORTED );
+#endif
+        break;
+    }
+    release_object( transaction );
+}
+
+/* roll back a transaction */
+DECL_HANDLER(rollback_transaction)
+{
+    struct transaction *transaction;
+
+    if (!(transaction = (struct transaction *)get_handle_obj( current->process, req->handle,
+                                                              TRANSACTION_ROLLBACK, &transaction_ops )))
+        return;
+    switch (transaction->outcome)
+    {
+    case OUTCOME_UNDETERMINED:
+        transaction->outcome = OUTCOME_ABORTED;
+        if (transaction->timeout_user)
+        {
+            remove_timeout_user( transaction->timeout_user );
+            transaction->timeout_user = NULL;
+        }
+        break;
+    case OUTCOME_COMMITTED:
+#ifdef SG_MUTANT_TX_ROLLBACK_COMMITTED
+        transaction->outcome = OUTCOME_ABORTED;
+#else
+        set_error( STATUS_TRANSACTION_ALREADY_COMMITTED );
+#endif
+        break;
+    default:
+        set_error( STATUS_TRANSACTION_ALREADY_ABORTED );
+        break;
+    }
+    release_object( transaction );
+}
+
+/* return details about a transaction */
+DECL_HANDLER(query_transaction)
+{
+    struct transaction *transaction;
+    data_size_t len;
+
+    if (!(transaction = (struct transaction *)get_handle_obj( current->process, req->handle,
+                                                              TRANSACTION_QUERY_INFORMATION, &transaction_ops )))
+        return;
+    guid_to_reply( &transaction->guid, &reply->guid_0 );
+    reply->outcome = transaction->outcome;
+    reply->isolation_level = transaction->isolation_level;
+    reply->isolation_flags = transaction->isolation_flags;
+    reply->timeout = transaction->timeout;
+    reply->desc_len = transaction->desc_len;
+    len = min( get_reply_max_size(), transaction->desc_len );
+    if (len) set_reply_data( transaction->desc, len );
+    release_object( transaction );
+}
