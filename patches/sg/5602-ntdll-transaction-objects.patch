+    status = pNtCreateTransaction(&handle2, TRANSACTION_ALL_ACCESS, &attr, NULL, NULL, 0, 0, 0, NULL, NULL);
+    ok(status == STATUS_OBJECT_NAME_COLLISION, "got %#lx\n", status);
+    attr.Attributes |= OBJ_OPENIF;
+    status = pNtCreateTransaction(&handle2, TRANSACTION_ALL_ACCESS, &attr, NULL, NULL, 0, 0, 0, NULL, NULL);
+    ok(status == STATUS_OBJECT_NAME_EXISTS, "got %#lx\n", status);
+    status = pNtOpenTransaction(&handle3, TRANSACTION_QUERY_INFORMATION, &attr, NULL, NULL);
+    ok(!status, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status, "got %#lx\n", status);
+    status = basic_info(handle3, &info2);
+    ok(!status && IsEqualGUID(&info.TransactionId, &info2.TransactionId), "got %#lx\n", status);
+    status = basic_info(handle2, &info2);
+    ok(!status && IsEqualGUID(&info.TransactionId, &info2.TransactionId), "got %#lx\n", status);
+    CloseHandle(handle3);
+    CloseHandle(handle2);
+    CloseHandle(handle);
+    status = pNtOpenTransaction(&handle3, TRANSACTION_QUERY_INFORMATION, &attr, NULL, NULL);
+    ok(status == STATUS_OBJECT_NAME_NOT_FOUND, "got %#lx\n", status);
+}
