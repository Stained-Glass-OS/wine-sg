From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, server: transaction objects

ntdll, server: transaction objects (NtCreateTransaction and friends)

Transactions become real server objects with a GUID, a description, an
optional timeout and an outcome (undetermined, committed, aborted).
NtCreateTransaction, NtOpenTransaction (by name or GUID), NtCommitTransaction,
NtRollbackTransaction and NtQueryInformationTransaction (basic and properties
classes) replace the stubs; ktmw32 gets OpenTransaction. The last handle
closing, or the timeout, aborts a transaction that was not committed.
---
--- a/dlls/ktmw32/ktmw32.spec
+++ b/dlls/ktmw32/ktmw32.spec
@@ -16,7 +16,7 @@
 @ stub GetTransactionManagerId
 @ stub OpenEnlistment
 @ stub OpenResourceManager
-@ stub OpenTransaction
+@ stdcall OpenTransaction(long ptr)
 @ stub OpenTransactionManager
 @ stub OpenTransactionManagerById
 @ stub PrePrepareComplete
--- a/dlls/ktmw32/ktmw32_main.c
+++ b/dlls/ktmw32/ktmw32_main.c
@@ -62,7 +62,7 @@ HANDLE WINAPI CreateTransaction( SECURITY_ATTRIBUTES *sa, GUID *guid, DWORD opti
 
     RtlInitUnicodeString( &desc_str, desc );
 
-    if (!set_ntstatus( NtCreateTransaction( &handle, 0 /* FIXME */, &attr, guid, NULL, options, level, flags,
+    if (!set_ntstatus( NtCreateTransaction( &handle, TRANSACTION_ALL_ACCESS, &attr, guid, NULL, options, level, flags,
             get_nt_timeout( &time, timeout ), &desc_str )))
     {
         return INVALID_HANDLE_VALUE;
@@ -78,3 +78,21 @@ BOOL WINAPI RollbackTransaction(HANDLE transaction)
 {
     return set_ntstatus( NtRollbackTransaction( transaction, TRUE ));
 }
+
+/***********************************************************************
+ * OpenTransaction (ktmw32.@)
+ */
+HANDLE WINAPI OpenTransaction( DWORD access, GUID *guid )
+{
+    OBJECT_ATTRIBUTES attr;
+    HANDLE handle;
+
+    if (!guid)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+    InitializeObjectAttributes( &attr, NULL, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (!set_ntstatus( NtOpenTransaction( &handle, access, &attr, guid, NULL ))) return INVALID_HANDLE_VALUE;
+    return handle;
+}
