+static void test_ktmw32(void)
+{
+    static WCHAR desc[] = L"ktm test";
+    TRANSACTION_BASIC_INFORMATION info;
+    HANDLE ktm, handle, handle2;
+    NTSTATUS status;
+    DWORD error;
+    GUID id;
+    BOOL ret;
+
+    ktm = LoadLibraryA("ktmw32.dll");
+    if (!ktm)
+    {
+        win_skip("ktmw32.dll not available\n");
+        return;
+    }
+    pCreateTransaction = (void *)GetProcAddress(ktm, "CreateTransaction");
+    pOpenTransaction = (void *)GetProcAddress(ktm, "OpenTransaction");
+    pCommitTransaction = (void *)GetProcAddress(ktm, "CommitTransaction");
+    pRollbackTransaction = (void *)GetProcAddress(ktm, "RollbackTransaction");
+
+    handle = pCreateTransaction(NULL, NULL, 0, 0, 0, 0, desc);
+    ok(handle != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeUndetermined, "got %#lx\n", status);
+    id = info.TransactionId;
+
+    handle2 = pOpenTransaction(TRANSACTION_ALL_ACCESS, &id);
+    ok(handle2 != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    ret = pRollbackTransaction(handle2);
+    ok(ret, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = pCommitTransaction(handle);
+    error = GetLastError();
+    ok(!ret && error == ERROR_TRANSACTION_ALREADY_ABORTED, "got %d, error %lu\n", ret, error);
+    SetLastError(0xdeadbeef);
+    ret = pRollbackTransaction(handle);
+    error = GetLastError();
+    ok(!ret && error == ERROR_TRANSACTION_ALREADY_ABORTED, "got %d, error %lu\n", ret, error);
+    CloseHandle(handle2);
+    CloseHandle(handle);
+
+    handle = pCreateTransaction(NULL, NULL, 0, 0, 0, 0, NULL);
+    ok(handle != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    ret = pCommitTransaction(handle);
+    ok(ret, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = pCommitTransaction(handle);
+    error = GetLastError();
+    ok(!ret && error == ERROR_TRANSACTION_ALREADY_COMMITTED, "got %d, error %lu\n", ret, error);
+    SetLastError(0xdeadbeef);
+    ret = pRollbackTransaction(handle);
+    error = GetLastError();
+    ok(!ret && error == ERROR_TRANSACTION_ALREADY_COMMITTED, "got %d, error %lu\n", ret, error);
+    CloseHandle(handle);
+
+    SetLastError(0xdeadbeef);
+    memset(&id, 0x5a, sizeof(id));
+    handle = pOpenTransaction(TRANSACTION_ALL_ACCESS, &id);
+    error = GetLastError();
+    ok(handle == INVALID_HANDLE_VALUE && error == ERROR_TRANSACTION_NOT_FOUND, "got %p, error %lu\n", handle, error);
+}
