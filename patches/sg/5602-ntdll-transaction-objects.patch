+static void test_properties(void)
+{
+    static WCHAR desc[] = L"wine transaction";
+    union { TRANSACTION_PROPERTIES_INFORMATION props; char buffer[256]; } u;
+    TRANSACTION_PROPERTIES_INFORMATION *props = &u.props;
+    UNICODE_STRING str;
+    LARGE_INTEGER timeout;
+    ULONG len, size;
+    HANDLE handle;
+    NTSTATUS status;
+
+    RtlInitUnicodeString(&str, desc);
+    timeout.QuadPart = -100000000;
+    status = pNtCreateTransaction(&handle, TRANSACTION_ALL_ACCESS, NULL, NULL, NULL, 0, 5, 6, &timeout, &str);
+    ok(!status, "got %#lx\n", status);
+    size = FIELD_OFFSET(TRANSACTION_PROPERTIES_INFORMATION, Description);
+    memset(&u, 0xcc, sizeof(u));
+    len = 0;
+    status = pNtQueryInformationTransaction(handle, TransactionPropertiesInformation, props, sizeof(u), &len);
+    ok(!status, "got %#lx\n", status);
+    ok(len == size + sizeof(desc) - sizeof(WCHAR), "got length %lu\n", len);
+    ok(props->IsolationLevel == 5, "got level %lu\n", props->IsolationLevel);
+    ok(props->IsolationFlags == 6, "got flags %lu\n", props->IsolationFlags);
+    ok(props->Timeout.QuadPart == timeout.QuadPart, "got timeout %s\n", wine_dbgstr_longlong(props->Timeout.QuadPart));
+    ok(props->Outcome == TransactionOutcomeUndetermined, "got outcome %lu\n", props->Outcome);
+    ok(props->DescriptionLength == sizeof(desc) - sizeof(WCHAR), "got description length %lu\n", props->DescriptionLength);
+    ok(!memcmp(props->Description, desc, props->DescriptionLength), "wrong description\n");
+
+    len = 0;
+    status = pNtQueryInformationTransaction(handle, TransactionPropertiesInformation, props, size - 1, &len);
+    ok(status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", status);
+    ok(len == size, "got length %lu\n", len);
+    status = pNtQueryInformationTransaction(handle, TransactionPropertiesInformation, props, size + 4, &len);
+    ok(status == STATUS_BUFFER_OVERFLOW, "got %#lx\n", status);
+    CloseHandle(handle);
+}
+
+static void test_timeout(void)
+{
+    TRANSACTION_BASIC_INFORMATION info;
+    LARGE_INTEGER timeout;
+    HANDLE handle, other;
+    NTSTATUS status;
+
+    timeout.QuadPart = -1500000; /* 150 ms */
+    status = pNtCreateTransaction(&handle, TRANSACTION_ALL_ACCESS, NULL, NULL, NULL, 0, 0, 0, &timeout, NULL);
+    ok(!status, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeUndetermined, "got %#lx outcome %lu\n", status, info.Outcome);
+    Sleep(600);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeAborted, "got %#lx outcome %lu\n", status, info.Outcome);
+    status = pNtCommitTransaction(handle, TRUE);
+    ok(status == STATUS_TRANSACTION_ALREADY_ABORTED, "got %#lx\n", status);
+    CloseHandle(handle);
+
+    /* committing in time cancels it */
+    timeout.QuadPart = -1500000;
+    status = pNtCreateTransaction(&handle, TRANSACTION_ALL_ACCESS, NULL, NULL, NULL, 0, 0, 0, &timeout, NULL);
+    ok(!status, "got %#lx\n", status);
+    status = pNtCommitTransaction(handle, TRUE);
+    ok(!status, "got %#lx\n", status);
+    Sleep(600);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeCommitted, "got %#lx outcome %lu\n", status, info.Outcome);
+    CloseHandle(handle);
+    (void)other;
+}
