+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/test.h"
+
+static NTSTATUS (WINAPI *pNtCreateTransaction)(HANDLE *, ACCESS_MASK, OBJECT_ATTRIBUTES *, GUID *, HANDLE, ULONG, ULONG,
+                                               ULONG, LARGE_INTEGER *, UNICODE_STRING *);
+static NTSTATUS (WINAPI *pNtOpenTransaction)(HANDLE *, ACCESS_MASK, OBJECT_ATTRIBUTES *, GUID *, HANDLE);
+static NTSTATUS (WINAPI *pNtCommitTransaction)(HANDLE, BOOLEAN);
+static NTSTATUS (WINAPI *pNtRollbackTransaction)(HANDLE, BOOLEAN);
+static NTSTATUS (WINAPI *pNtQueryInformationTransaction)(HANDLE, TRANSACTION_INFORMATION_CLASS, void *, ULONG, ULONG *);
+static HANDLE (WINAPI *pCreateTransaction)(SECURITY_ATTRIBUTES *, GUID *, DWORD, DWORD, DWORD, DWORD, WCHAR *);
+static HANDLE (WINAPI *pOpenTransaction)(DWORD, GUID *);
+static BOOL (WINAPI *pCommitTransaction)(HANDLE);
+static BOOL (WINAPI *pRollbackTransaction)(HANDLE);
+
+static const GUID null_guid;
+
+static NTSTATUS basic_info(HANDLE handle, TRANSACTION_BASIC_INFORMATION *info)
+{
+    ULONG len = 0;
+    NTSTATUS status;
+
+    memset(info, 0xcc, sizeof(*info));
+    status = pNtQueryInformationTransaction(handle, TransactionBasicInformation, info, sizeof(*info), &len);
+    if (!status) ok(len == sizeof(*info), "got length %lu\n", len);
+    return status;
+}
+
+static void test_lifecycle(void)
+{
+    static const GUID guid = {0x9c2f5a1e, 0x3b4d, 0x4c6a, {0x8e, 0x11, 0x20, 0x4f, 0x6b, 0x77, 0x01, 0xaa}};
+    TRANSACTION_BASIC_INFORMATION info, info2;
+    HANDLE handle, handle2, query_only;
+    NTSTATUS status;
+    GUID id, other = guid;
+    ULONG len;
+
+    status = pNtCreateTransaction(&handle, TRANSACTION_ALL_ACCESS, NULL, NULL, NULL, 0, 0, 0, NULL, NULL);
+    ok(!status, "got %#lx\n", status);
+    ok(handle && handle != (HANDLE)1, "got handle %p\n", handle);
+    status = basic_info(handle, &info);
+    ok(!status, "got %#lx\n", status);
+    ok(info.State == TransactionStateNormal, "got state %lu\n", info.State);
+    ok(info.Outcome == TransactionOutcomeUndetermined, "got outcome %lu\n", info.Outcome);
+    id = info.TransactionId;
+    ok(!IsEqualGUID(&id, &null_guid), "got a null id\n");
+
+    status = pNtOpenTransaction(&handle2, TRANSACTION_QUERY_INFORMATION, NULL, &id, NULL);
+    ok(!status, "got %#lx\n", status);
+    ok(handle2 != handle, "got the same handle\n");
+    status = basic_info(handle2, &info2);
+    ok(!status && IsEqualGUID(&info2.TransactionId, &id), "got %#lx\n", status);
+
+    /* the open handle only has the right to query */
+    status = pNtCommitTransaction(handle2, TRUE);
+    ok(status == STATUS_ACCESS_DENIED, "got %#lx\n", status);
+    status = pNtRollbackTransaction(handle2, TRUE);
+    ok(status == STATUS_ACCESS_DENIED, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeUndetermined, "got %#lx outcome %lu\n", status, info.Outcome);
+
+    /* closing a handle while another one is open leaves it active */
+    CloseHandle(handle2);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeUndetermined, "got %#lx outcome %lu\n", status, info.Outcome);
+
+    status = pNtCommitTransaction(handle, TRUE);
+    ok(!status, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeCommitted, "got %#lx outcome %lu\n", status, info.Outcome);
+    status = pNtCommitTransaction(handle, TRUE);
+    ok(status == STATUS_TRANSACTION_ALREADY_COMMITTED, "got %#lx\n", status);
+    status = pNtRollbackTransaction(handle, TRUE);
+    ok(status == STATUS_TRANSACTION_ALREADY_COMMITTED, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeCommitted, "got %#lx outcome %lu\n", status, info.Outcome);
+    CloseHandle(handle);
+
+    /* explicit id */
+    status = pNtCreateTransaction(&handle, TRANSACTION_ALL_ACCESS, NULL, &other, NULL, 0, 0, 0, NULL, NULL);
+    ok(!status, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status && IsEqualGUID(&info.TransactionId, &guid), "got %#lx\n", status);
+    status = pNtCreateTransaction(&handle2, TRANSACTION_ALL_ACCESS, NULL, &other, NULL, 0, 0, 0, NULL, NULL);
+    ok(status == STATUS_OBJECT_NAME_COLLISION, "got %#lx\n", status);
+
+    status = pNtOpenTransaction(&query_only, TRANSACTION_ALL_ACCESS, NULL, &other, NULL);
+    ok(!status, "got %#lx\n", status);
+    status = pNtRollbackTransaction(query_only, TRUE);
+    ok(!status, "got %#lx\n", status);
+    status = basic_info(handle, &info);
+    ok(!status && info.Outcome == TransactionOutcomeAborted, "got %#lx outcome %lu\n", status, info.Outcome);
+    status = pNtCommitTransaction(handle, TRUE);
+    ok(status == STATUS_TRANSACTION_ALREADY_ABORTED, "got %#lx\n", status);
+    status = pNtRollbackTransaction(handle, TRUE);
+    ok(status == STATUS_TRANSACTION_ALREADY_ABORTED, "got %#lx\n", status);
+
+    /* the id is gone with the last handle */
+    CloseHandle(query_only);
+    status = pNtOpenTransaction(&handle2, TRANSACTION_ALL_ACCESS, NULL, &other, NULL);
+    ok(!status, "got %#lx\n", status);
+    CloseHandle(handle2);
+    CloseHandle(handle);
+    status = pNtOpenTransaction(&handle2, TRANSACTION_ALL_ACCESS, NULL, &other, NULL);
+    ok(status == STATUS_TRANSACTION_NOT_FOUND, "got %#lx\n", status);
+
+    /* the information classes */
+    status = pNtCreateTransaction(&handle, TRANSACTION_ALL_ACCESS, NULL, NULL, NULL, 0, 0, 0, NULL, NULL);
+    ok(!status, "got %#lx\n", status);
+    len = 0;
+    status = pNtQueryInformationTransaction(handle, TransactionBasicInformation, &info, sizeof(info) - 1, &len);
+    ok(status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", status);
+    status = pNtQueryInformationTransaction(handle, 0xdead, &info, sizeof(info), &len);
+    ok(status == STATUS_INVALID_INFO_CLASS, "got %#lx\n", status);
+    status = pNtQueryInformationTransaction((HANDLE)0xdeadbeef, TransactionBasicInformation, &info, sizeof(info), &len);
+    ok(status == STATUS_INVALID_HANDLE, "got %#lx\n", status);
+    status = pNtCommitTransaction((HANDLE)0xdeadbeef, TRUE);
+    ok(status == STATUS_INVALID_HANDLE, "got %#lx\n", status);
+    status = pNtRollbackTransaction((HANDLE)0xdeadbeef, TRUE);
+    ok(status == STATUS_INVALID_HANDLE, "got %#lx\n", status);
+    CloseHandle(handle);
+
+    handle = CreateEventW(NULL, FALSE, FALSE, NULL);
+    status = pNtCommitTransaction(handle, TRUE);
+    ok(status == STATUS_OBJECT_TYPE_MISMATCH, "got %#lx\n", status);
+    CloseHandle(handle);
+}
