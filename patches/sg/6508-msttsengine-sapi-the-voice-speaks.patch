+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_MSTTSENGINE_UNIXLIB_H
+#define __WINE_MSTTSENGINE_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* a word or sentence the synthesizer reached: where in the text (UTF-8 characters, from 0) and
+ * at which sample of the result */
+struct tts_mark
+{
+    UINT32 type;      /* 1 word, 2 sentence */
+    UINT32 text_pos;
+    UINT32 text_len;
+    UINT32 sample;
+};
+
+/* the pointers are 64-bit wide: the same layout for 32-bit and 64-bit callers */
+struct tts_init_params
+{
+    UINT32 sample_rate;  /* out: 0 if there is no synthesizer */
+};
+
+struct tts_synth_params
+{
+    UINT64 text;         /* UTF-8, not terminated */
+    UINT32 text_len;     /* bytes */
+    INT32 rate;          /* words per minute */
+    INT32 volume;        /* 0 - 200, 100 normal */
+    INT32 pitch;         /* 0 - 100, 50 normal */
+    UINT64 language;     /* the synthesizer's voice name, terminated (e.g. "en-us") */
+    UINT64 handle;       /* out: the result, for tts_get_result */
+    UINT32 sample_count; /* out */
+    UINT32 mark_count;   /* out */
+};
+
+struct tts_get_result_params
+{
+    UINT64 handle;
+    UINT64 samples;      /* INT16[sample_count] */
+    UINT64 marks;        /* struct tts_mark[mark_count] */
+};
+
+enum unix_funcs
+{
+    unix_tts_init,
+    unix_tts_synth,
+    unix_tts_get_result,
+    unix_funcs_count,
+};
+
+#endif /* __WINE_MSTTSENGINE_UNIXLIB_H */
