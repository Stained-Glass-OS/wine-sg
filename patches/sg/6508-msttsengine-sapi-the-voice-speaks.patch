+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dlfcn.h>
+#include <pthread.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msttsengine);
+
+/* the eSpeak NG library's documented interface (speak_lib.h) */
+enum { ESPEAK_EVENT_LIST_TERMINATED = 0, ESPEAK_EVENT_WORD = 1, ESPEAK_EVENT_SENTENCE = 2 };
+enum { ESPEAK_AUDIO_OUTPUT_SYNCHRONOUS = 2 };
+enum { ESPEAK_RATE = 1, ESPEAK_VOLUME = 2, ESPEAK_PITCH = 3 };
+#define ESPEAK_POS_CHARACTER 1
+#define ESPEAK_CHARS_UTF8 1
+#define ESPEAK_INITIALIZE_DONT_EXIT 0x8000
+
+typedef struct
+{
+    int type;
+    unsigned int unique_identifier;
+    int text_position;
+    int length;
+    int audio_position;
+    int sample;
+    void *user_data;
+    union { int number; const char *name; char string[8]; } id;
+} espeak_event;
+
+typedef int (espeak_callback)(short *wav, int count, espeak_event *events);
+
+static int (*p_espeak_Initialize)(int output, int buflength, const char *path, int options);
+static void (*p_espeak_SetSynthCallback)(espeak_callback *callback);
+static int (*p_espeak_Synth)(const void *text, size_t size, unsigned int position, int position_type,
+                             unsigned int end_position, unsigned int flags, unsigned int *id, void *user_data);
+static int (*p_espeak_SetParameter)(int parameter, int value, int relative);
+static int (*p_espeak_SetVoiceByName)(const char *name);
+
+static pthread_mutex_t tts_mutex = PTHREAD_MUTEX_INITIALIZER;
+static int sample_rate = -1;   /* -1: not tried yet; 0: no synthesizer */
+
+struct tts_result
+{
+    short *samples;
+    UINT32 sample_count, sample_capacity;
+    struct tts_mark *marks;
+    UINT32 mark_count, mark_capacity;
+};
+
+/* the result being made: synthesis is synchronous, under tts_mutex */
+static struct tts_result *current;
+
+static int synth_callback(short *wav, int count, espeak_event *events)
+{
+    struct tts_result *result = current;
+    espeak_event *e;
+
+    if (!result) return 0;
+    for (e = events; e && e->type != ESPEAK_EVENT_LIST_TERMINATED; e++)
+    {
+        if (e->type == ESPEAK_EVENT_WORD || e->type == ESPEAK_EVENT_SENTENCE)
+        {
+            if (result->mark_count == result->mark_capacity)
+            {
+                UINT32 capacity = result->mark_capacity ? result->mark_capacity * 2 : 64;
+                struct tts_mark *marks = realloc(result->marks, capacity * sizeof(*marks));
+                if (!marks) continue;
+                result->marks = marks;
+                result->mark_capacity = capacity;
+            }
+            result->marks[result->mark_count].type = e->type == ESPEAK_EVENT_WORD ? 1 : 2;
+            result->marks[result->mark_count].text_pos = e->text_position > 0 ? e->text_position - 1 : 0;
+            result->marks[result->mark_count].text_len = e->length > 0 ? e->length : 0;
+            result->marks[result->mark_count].sample = (UINT64)e->audio_position * sample_rate / 1000;
+            result->mark_count++;
+        }
+    }
+    if (wav && count > 0)
+    {
+        if (result->sample_count + count > result->sample_capacity)
+        {
+            UINT32 capacity = result->sample_capacity ? result->sample_capacity : 16384;
+            short *samples;
+            while (capacity < result->sample_count + count) capacity *= 2;
+            if (!(samples = realloc(result->samples, capacity * sizeof(*samples)))) return 1;
+            result->samples = samples;
+            result->sample_capacity = capacity;
+        }
+        memcpy(result->samples + result->sample_count, wav, count * sizeof(*wav));
+        result->sample_count += count;
+    }
+    return 0;
+}
+
+static NTSTATUS tts_init(void *args)
+{
+    struct tts_init_params *params = args;
+    void *lib;
+
+    pthread_mutex_lock(&tts_mutex);
+    if (sample_rate < 0)
+    {
+        sample_rate = 0;
+        if ((lib = dlopen("libespeak-ng.so.1", RTLD_NOW)) || (lib = dlopen("libespeak-ng.so", RTLD_NOW)))
+        {
+            p_espeak_Initialize = dlsym(lib, "espeak_Initialize");
+            p_espeak_SetSynthCallback = dlsym(lib, "espeak_SetSynthCallback");
+            p_espeak_Synth = dlsym(lib, "espeak_Synth");
+            p_espeak_SetParameter = dlsym(lib, "espeak_SetParameter");
+            p_espeak_SetVoiceByName = dlsym(lib, "espeak_SetVoiceByName");
+            if (p_espeak_Initialize && p_espeak_SetSynthCallback && p_espeak_Synth && p_espeak_SetParameter &&
+                p_espeak_SetVoiceByName)
+            {
+                int rate = p_espeak_Initialize(ESPEAK_AUDIO_OUTPUT_SYNCHRONOUS, 0, NULL, ESPEAK_INITIALIZE_DONT_EXIT);
+                if (rate > 0)
+                {
+                    p_espeak_SetSynthCallback(synth_callback);
+                    sample_rate = rate;
+                }
+            }
+        }
+        if (!sample_rate) WARN("no speech synthesizer (libespeak-ng) found.\n");
+        else TRACE("eSpeak NG at %d Hz\n", sample_rate);
+    }
+    params->sample_rate = sample_rate;
+    pthread_mutex_unlock(&tts_mutex);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS tts_synth(void *args)
+{
+    struct tts_synth_params *params = args;
+    struct tts_result *result;
+    char *text;
+    int ret;
+
+    params->handle = 0;
+    params->sample_count = params->mark_count = 0;
+    if (sample_rate <= 0) return STATUS_NOT_SUPPORTED;
+    if (!(result = calloc(1, sizeof(*result)))) return STATUS_NO_MEMORY;
+    if (!(text = malloc(params->text_len + 1)))
+    {
+        free(result);
+        return STATUS_NO_MEMORY;
+    }
+    memcpy(text, (const char *)(ULONG_PTR)params->text, params->text_len);
+    text[params->text_len] = 0;
+
+    pthread_mutex_lock(&tts_mutex);
+    if (params->language && p_espeak_SetVoiceByName((const char *)(ULONG_PTR)params->language))
+        p_espeak_SetVoiceByName("en");
+    p_espeak_SetParameter(ESPEAK_RATE, params->rate, 0);
+    p_espeak_SetParameter(ESPEAK_VOLUME, params->volume, 0);
+    p_espeak_SetParameter(ESPEAK_PITCH, params->pitch, 0);
+    current = result;
+    ret = p_espeak_Synth(text, params->text_len + 1, 0, ESPEAK_POS_CHARACTER, 0, ESPEAK_CHARS_UTF8, NULL, result);
+    current = NULL;
+    pthread_mutex_unlock(&tts_mutex);
+    free(text);
+    if (ret)
+    {
+        WARN("espeak_Synth failed: %d\n", ret);
+        free(result->samples);
+        free(result->marks);
+        free(result);
+        return STATUS_UNSUCCESSFUL;
+    }
+    params->handle = (ULONG_PTR)result;
+    params->sample_count = result->sample_count;
+    params->mark_count = result->mark_count;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS tts_get_result(void *args)
+{
+    struct tts_get_result_params *params = args;
+    struct tts_result *result = (struct tts_result *)(ULONG_PTR)params->handle;
+
+    if (!result) return STATUS_INVALID_PARAMETER;
+    if (params->samples && result->sample_count)
+        memcpy((void *)(ULONG_PTR)params->samples, result->samples, result->sample_count * sizeof(short));
+    if (params->marks && result->mark_count)
+        memcpy((void *)(ULONG_PTR)params->marks, result->marks, result->mark_count * sizeof(struct tts_mark));
+    free(result->samples);
+    free(result->marks);
+    free(result);
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    tts_init,
+    tts_synth,
+    tts_get_result,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count);
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    tts_init,
+    tts_synth,
+    tts_get_result,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count);
+
+#endif
diff --git a/dlls/msttsengine/unixlib.h b/dlls/msttsengine/unixlib.h
new file mode 100644
index 0000000..c4e4925
--- /dev/null
+++ b/dlls/msttsengine/unixlib.h
@@ -0,0 +1,68 @@
+/*
+ * MSTTSEngine speech synthesis backend (Stained Glass OS)
