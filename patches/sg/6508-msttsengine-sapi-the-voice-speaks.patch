diff --git a/dlls/msttsengine/tts.c b/dlls/msttsengine/tts.c
index f895b35..000a1d9 100644
--- a/dlls/msttsengine/tts.c
+++ b/dlls/msttsengine/tts.c
@@ -29,7 +29,10 @@
 #include "sapiddk.h"
 #include "sperror.h"
 
+#include "mmreg.h"
+#include "initguid.h"
 #include "wine/debug.h"
+#include "unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(msttsengine);
 
@@ -101,22 +104,348 @@ static ULONG WINAPI ttsengine_Release(ISpTTSEngine *iface)
     return ref;
 }
 
+/* Stained Glass OS (wine-sg 6508): the voice speaks. Speak and GetOutputFormat were stubs, so
+ * every SAPI voice (SpVoice, ISpeechVoice, "Wine Default Voice") said nothing and programs that
+ * read text aloud failed. The text is synthesized by eSpeak NG (the system's, when there) a
+ * sentence at a time, in the fragment's language, at the site's and the fragment's rate,
+ * volume and pitch; word and sentence boundaries and bookmarks are reported as events; the
+ * audio is written in the format the output asked for (PCM, resampled), and an abort stops
+ * between sentences. */
+DEFINE_GUID(SPDFID_WaveFormatEx, 0xc31adbae, 0x527f, 0x4ff5, 0xa2, 0x30, 0xf6, 0x2b, 0xb6, 0x1f, 0xf7, 0x0c);
+#define SPET_LPARAM_IS_UNDEFINED_ 0
+#define SPET_LPARAM_IS_STRING_    4
+
+static UINT32 engine_rate(void)
+{
+    static UINT32 rate = ~0u;
+    struct tts_init_params params = { 0 };
+
+    if (rate == ~0u)
+    {
+        WINE_UNIX_CALL(unix_tts_init, &params);
+        rate = params.sample_rate;
+    }
+    return rate;
+}
+
+static const char *espeak_language(LANGID lang)
+{
+    switch (PRIMARYLANGID(lang))
+    {
+    case LANG_ENGLISH: return SUBLANGID(lang) == SUBLANG_ENGLISH_UK ? "en-gb" : "en-us";
+    case LANG_GERMAN: return "de";
+    case LANG_FRENCH: return "fr";
+    case LANG_SPANISH: return "es";
+    case LANG_ITALIAN: return "it";
+    case LANG_PORTUGUESE: return SUBLANGID(lang) == SUBLANG_PORTUGUESE_BRAZILIAN ? "pt-br" : "pt";
+    case LANG_DUTCH: return "nl";
+    case LANG_RUSSIAN: return "ru";
+    case LANG_POLISH: return "pl";
+    case LANG_CHINESE: return "cmn";
+    case LANG_JAPANESE: return "ja";
+    case LANG_KOREAN: return "ko";
+    case LANG_SWEDISH: return "sv";
+    case LANG_NORWEGIAN: return "nb";
+    case LANG_DANISH: return "da";
+    case LANG_FINNISH: return "fi";
+    case LANG_TURKISH: return "tr";
+    case LANG_CZECH: return "cs";
+    case LANG_HUNGARIAN: return "hu";
+    case LANG_ARABIC: return "ar";
+    case LANG_HEBREW: return "he";
+    case LANG_GREEK: return "el";
+    case LANG_ROMANIAN: return "ro";
+    case LANG_UKRAINIAN: return "uk";
+    case LANG_VIETNAMESE: return "vi";
+    case LANG_HINDI: return "hi";
+    case LANG_INDONESIAN: return "id";
+    case LANG_CATALAN: return "ca";
+    default: return "en-us";
+    }
+}
+
+/* the frames written so far (in the output format), for event offsets */
+struct speak_state
+{
+    ISpTTSEngineSite *site;
+    const WAVEFORMATEX *wfx;
+    ULONGLONG written;   /* bytes */
+    DWORD in_rate;
+};
+
+static HRESULT write_samples(struct speak_state *state, const INT16 *in, UINT32 count)
+{
+    const WAVEFORMATEX *wfx = state->wfx;
+    UINT32 out_count, i, c, frame = wfx->nBlockAlign;
+    BYTE *buf;
+    ULONG written = 0;
+    HRESULT hr;
+
+    if (!count) return S_OK;
+    out_count = (UINT64)count * wfx->nSamplesPerSec / state->in_rate;
+    if (!out_count) return S_OK;
+    if (!(buf = malloc((size_t)out_count * frame))) return E_OUTOFMEMORY;
+    for (i = 0; i < out_count; i++)
+    {
+        /* linear resampling */
+        double pos = (double)i * state->in_rate / wfx->nSamplesPerSec;
+        UINT32 j = (UINT32)pos;
+        double f = pos - j;
+        int a = in[min(j, count - 1)], b = in[min(j + 1, count - 1)];
+        int v = (int)(a + (b - a) * f);
+
+        for (c = 0; c < wfx->nChannels; c++)
+        {
+            if (wfx->wBitsPerSample == 8) buf[i * frame + c] = (BYTE)((v >> 8) + 128);
+            else ((INT16 *)(buf + i * frame))[c] = (INT16)v;
+        }
+    }
+    hr = ISpTTSEngineSite_Write(state->site, buf, out_count * frame, &written);
+    state->written += written;
+    free(buf);
+    return hr;
+}
+
+static HRESULT write_silence(struct speak_state *state, ULONG msecs)
+{
+    UINT32 count = (UINT64)msecs * state->in_rate / 1000;
+    INT16 *zeros = calloc(max(count, 1), sizeof(*zeros));
+    HRESULT hr;
+
+    if (!zeros) return E_OUTOFMEMORY;
+    hr = write_samples(state, zeros, count);
+    free(zeros);
+    return hr;
+}
+
+/* UTF-8 character CH of TEXT (as eSpeak counts them) to a UTF-16 offset */
+static ULONG utf16_offset(const WCHAR *text, ULONG len, UINT32 ch)
+{
+    ULONG i = 0;
+
+    while (ch && i < len)
+    {
+        i += (IS_HIGH_SURROGATE(text[i]) && i + 1 < len) ? 2 : 1;
+        ch--;
+    }
+    return i;
+}
+
+/* one piece of text (TEXT, LEN chars, at SRC_OFFSET in the source) spoken */
+static HRESULT speak_piece(struct speak_state *state, const WCHAR *text, ULONG len, ULONG src_offset,
+                           const SPVSTATE *vstate, LONG site_rate, USHORT site_volume)
+{
+    struct tts_synth_params params = { 0 };
+    struct tts_get_result_params result = { 0 };
+    struct tts_mark *marks = NULL;
+    INT16 *samples = NULL;
+    double speed;
+    int utf8_len;
+    char *utf8;
+    UINT32 i, done = 0;
+    HRESULT hr = S_OK;
+    LONG rate = site_rate + vstate->RateAdj;
+    NTSTATUS status;
+
+    if (!len) return S_OK;
+    if (!(utf8_len = WideCharToMultiByte(CP_UTF8, 0, text, len, NULL, 0, NULL, NULL))) return S_OK;
+    if (!(utf8 = malloc(utf8_len))) return E_OUTOFMEMORY;
+    WideCharToMultiByte(CP_UTF8, 0, text, len, utf8, utf8_len, NULL, NULL);
+
+    /* SAPI's rate: +10 is three times as fast, -10 a third */
+    rate = max(-10, min(10, rate));
+    speed = 1.0;
+    for (i = 0; i < (UINT32)abs(rate); i++) speed *= 1.116123; /* 3^(1/10) */
+    if (rate < 0) speed = 1.0 / speed;
+    params.text = (ULONG_PTR)utf8;
+    params.text_len = utf8_len;
+    params.rate = max(80, min(450, (INT32)(175 * speed)));
+    params.volume = (INT32)site_volume * (vstate->Volume ? vstate->Volume : 100) / 100;
+    params.pitch = max(0, min(99, 50 + vstate->PitchAdj.MiddleAdj * 5));
+    params.language = (ULONG_PTR)espeak_language(vstate->LangID ? vstate->LangID : MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US));
+    status = WINE_UNIX_CALL(unix_tts_synth, &params);
+    free(utf8);
+    if (status)
+    {
+        WARN("synthesis failed: %#lx\n", (long)status);
+        return E_FAIL;
+    }
+    samples = malloc(max(params.sample_count, 1) * sizeof(*samples));
+    marks = malloc(max(params.mark_count, 1) * sizeof(*marks));
+    result.handle = params.handle;
+    result.samples = (ULONG_PTR)samples;
+    result.marks = (ULONG_PTR)marks;
+    if (!samples || !marks)
+    {
+        result.samples = result.marks = 0;
+        WINE_UNIX_CALL(unix_tts_get_result, &result);
+        free(samples);
+        free(marks);
+        return E_OUTOFMEMORY;
+    }
+    WINE_UNIX_CALL(unix_tts_get_result, &result);
+
+    /* the audio up to each mark, then the mark's event */
+    for (i = 0; i < params.mark_count && SUCCEEDED(hr); i++)
+    {
+        SPEVENT event = { 0 };
+        UINT32 at = min(marks[i].sample, params.sample_count);
+        ULONG start = utf16_offset(text, len, marks[i].text_pos);
+        ULONG end = utf16_offset(text, len, marks[i].text_pos + marks[i].text_len);
+
+        if (at > done)
+        {
+            hr = write_samples(state, samples + done, at - done);
+            done = at;
+        }
+        event.eEventId = marks[i].type == 1 ? SPEI_WORD_BOUNDARY : SPEI_SENTENCE_BOUNDARY;
+        event.elParamType = SPET_LPARAM_IS_UNDEFINED_;
+        event.ullAudioStreamOffset = state->written;
+        event.lParam = src_offset + start;
+        event.wParam = end > start ? end - start : 0;
+        if (SUCCEEDED(hr)) ISpTTSEngineSite_AddEvents(state->site, &event, 1);
+    }
+    if (SUCCEEDED(hr) && params.sample_count > done) hr = write_samples(state, samples + done, params.sample_count - done);
+    free(samples);
+    free(marks);
+    return hr;
+}
+
+static BOOL is_sentence_end(const WCHAR *text, ULONG len, ULONG i)
+{
+    if (text[i] == '\n') return TRUE;
+    if (text[i] != '.' && text[i] != '!' && text[i] != '?' && text[i] != ';') return FALSE;
+    return i + 1 >= len || iswspace(text[i + 1]);
+}
+
 static HRESULT WINAPI ttsengine_Speak(ISpTTSEngine *iface, DWORD flags, REFGUID fmtid,
                                       const WAVEFORMATEX *wfx, const SPVTEXTFRAG *frag_list,
                                       ISpTTSEngineSite *site)
 {
-    FIXME("(%p, %#lx, %s, %p, %p, %p): stub.\n", iface, flags, debugstr_guid(fmtid), wfx, frag_list, site);
+    struct speak_state state = { site, wfx, 0, 0 };
+    const SPVTEXTFRAG *frag;
+    HRESULT hr = S_OK;
 
+    TRACE("(%p, %#lx, %s, %p, %p, %p).\n", iface, flags, debugstr_guid(fmtid), wfx, frag_list, site);
+
+#ifdef SG_MUTANT_TTS_SILENT
     return E_NOTIMPL;
+#endif
+    if (!site || !wfx || !fmtid || !IsEqualGUID(fmtid, &SPDFID_WaveFormatEx) || wfx->wFormatTag != WAVE_FORMAT_PCM ||
+        (wfx->wBitsPerSample != 8 && wfx->wBitsPerSample != 16) || !wfx->nChannels || !wfx->nSamplesPerSec)
+        return E_INVALIDARG;
+    if (!(state.in_rate = engine_rate()))
+    {
+        ERR("no speech synthesizer: install eSpeak NG (libespeak-ng1).\n");
+        return E_FAIL;
+    }
+
+    for (frag = frag_list; frag && SUCCEEDED(hr); frag = frag->pNext)
+    {
+        LONG rate = 0;
+        USHORT volume = 100;
+        DWORD actions = ISpTTSEngineSite_GetActions(site);
+
+        if (actions & SPVES_ABORT) break;
+        ISpTTSEngineSite_GetRate(site, &rate);
+        ISpTTSEngineSite_GetVolume(site, &volume);
+
+        switch (frag->State.eAction)
+        {
+        case SPVA_Silence:
+            hr = write_silence(&state, frag->State.SilenceMSecs);
+            break;
+        case SPVA_Bookmark:
+        {
+            SPEVENT event = { 0 };
+            WCHAR *name = malloc((frag->ulTextLen + 1) * sizeof(WCHAR));
+
+            if (!name) break;
+            memcpy(name, frag->pTextStart, frag->ulTextLen * sizeof(WCHAR));
+            name[frag->ulTextLen] = 0;
+            event.eEventId = SPEI_TTS_BOOKMARK;
+            event.elParamType = SPET_LPARAM_IS_STRING_;
+            event.ullAudioStreamOffset = state.written;
+            event.wParam = wcstol(name, NULL, 10);
+            event.lParam = (LPARAM)name;
+            ISpTTSEngineSite_AddEvents(site, &event, 1);
+            free(name);
+            break;
+        }
+        case SPVA_SpellOut:
+        {
+            /* each character on its own */
+            WCHAR *spaced = malloc(frag->ulTextLen * 2 * sizeof(WCHAR) + sizeof(WCHAR));
+            ULONG i, n = 0;
+
+            if (!spaced) { hr = E_OUTOFMEMORY; break; }
+            for (i = 0; i < frag->ulTextLen; i++)
+            {
+                spaced[n++] = frag->pTextStart[i];
+                spaced[n++] = ' ';
+            }
+            hr = speak_piece(&state, spaced, n, frag->ulTextSrcOffset, &frag->State, rate, volume);
+            free(spaced);
+            break;
+        }
+        case SPVA_Speak:
+        case SPVA_Pronounce:
+        default:
+        {
+            ULONG start = 0, i;
+
+            /* a sentence at a time: the first is heard soon, an abort is not long in coming */
+            for (i = 0; i <= frag->ulTextLen && SUCCEEDED(hr); i++)
+            {
+                if (i < frag->ulTextLen && !is_sentence_end(frag->pTextStart, frag->ulTextLen, i)) continue;
+                if (i < frag->ulTextLen) i++;   /* the punctuation goes with its sentence */
+                hr = speak_piece(&state, frag->pTextStart + start, i - start, frag->ulTextSrcOffset + start,
+                                 &frag->State, rate, volume);
+                start = i;
+                if (ISpTTSEngineSite_GetActions(site) & SPVES_ABORT) break;
+                if (i >= frag->ulTextLen) break;
+            }
+            break;
+        }
+        }
+    }
+    return hr;
 }
 
 static HRESULT WINAPI ttsengine_GetOutputFormat(ISpTTSEngine *iface, const GUID *fmtid,
                                                 const WAVEFORMATEX *wfx, GUID *out_fmtid,
                                                 WAVEFORMATEX **out_wfx)
 {
-    FIXME("(%p, %s, %p, %p, %p): stub.\n", iface, debugstr_guid(fmtid), wfx, out_fmtid, out_wfx);
+    WAVEFORMATEX *fmt;
+    UINT32 rate;
 
-    return E_NOTIMPL;
+    TRACE("(%p, %s, %p, %p, %p).\n", iface, debugstr_guid(fmtid), wfx, out_fmtid, out_wfx);
+
+    if (!out_fmtid || !out_wfx) return E_POINTER;
+    if (!(fmt = CoTaskMemAlloc(sizeof(*fmt)))) return E_OUTOFMEMORY;
+    if (fmtid && IsEqualGUID(fmtid, &SPDFID_WaveFormatEx) && wfx && wfx->wFormatTag == WAVE_FORMAT_PCM &&
+        (wfx->wBitsPerSample == 8 || wfx->wBitsPerSample == 16) && wfx->nChannels >= 1 && wfx->nChannels <= 2 &&
+        wfx->nSamplesPerSec >= 8000 && wfx->nSamplesPerSec <= 48000)
+    {
+        /* the output's own format: the engine converts to it */
+        *fmt = *wfx;
+        fmt->cbSize = 0;
+    }
+    else
+    {
+        /* the synthesizer's: 16-bit mono */
+        rate = engine_rate();
+        fmt->wFormatTag = WAVE_FORMAT_PCM;
+        fmt->nChannels = 1;
+        fmt->nSamplesPerSec = rate ? rate : 22050;
+        fmt->wBitsPerSample = 16;
+        fmt->nBlockAlign = 2;
+        fmt->nAvgBytesPerSec = fmt->nSamplesPerSec * 2;
+        fmt->cbSize = 0;
+    }
+    *out_fmtid = SPDFID_WaveFormatEx;
+    *out_wfx = fmt;
+    return S_OK;
 }
 
 static ISpTTSEngineVtbl ttsengine_vtbl =
diff --git a/dlls/msttsengine/unixlib.c b/dlls/msttsengine/unixlib.c
new file mode 100644
index 0000000..775ef51
--- /dev/null
+++ b/dlls/msttsengine/unixlib.c
@@ -0,0 +1,241 @@
