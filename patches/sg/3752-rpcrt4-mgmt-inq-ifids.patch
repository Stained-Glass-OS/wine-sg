From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: RpcMgmtInqIfIds lists the interfaces this server registered (3752)

rpcrt4: RpcMgmtInqIfIds lists the interfaces this server registered

Fills the vector of RPC_IF_ID for the local server and implements
RpcIfIdVectorFree.
---
diff --git a/dlls/rpcrt4/rpc_server.c b/dlls/rpcrt4/rpc_server.c
index eb733f6..f6b0705 100644
--- a/dlls/rpcrt4/rpc_server.c
+++ b/dlls/rpcrt4/rpc_server.c
@@ -1649,8 +1649,57 @@ UINT WINAPI I_RpcWindowProc( void *hWnd, UINT Message, UINT wParam, ULONG lParam
  */
 RPC_STATUS WINAPI RpcMgmtInqIfIds(RPC_BINDING_HANDLE Binding, RPC_IF_ID_VECTOR **IfIdVector)
 {
-  FIXME("(%p,%p): stub\n", Binding, IfIdVector);
-  return RPC_S_INVALID_BINDING;
+  RpcServerInterface *cif;
+  RPC_IF_ID_VECTOR *vector;
+  RPC_IF_ID *ids;
+  ULONG count = 0, i = 0;
+
+  TRACE("(%p,%p)\n", Binding, IfIdVector);
+
+  if (!IfIdVector) return RPC_S_INVALID_ARG;
+  *IfIdVector = NULL;
+  if (Binding)
+  {
+    /* another server: that would be a call to its management interface, which is not made */
+    FIXME("remote servers are not asked\n");
+    return RPC_S_INVALID_BINDING;
+  }
+
+  /* the interfaces this process has registered, one vector block: the count, the pointers, the ids */
+  EnterCriticalSection(&server_cs);
+  LIST_FOR_EACH_ENTRY(cif, &server_interfaces, RpcServerInterface, entry) count++;
+  vector = malloc(FIELD_OFFSET(RPC_IF_ID_VECTOR, IfId[count]) + count * sizeof(RPC_IF_ID));
+  if (!vector)
+  {
+    LeaveCriticalSection(&server_cs);
+    return RPC_S_OUT_OF_RESOURCES;
+  }
+  ids = (RPC_IF_ID *)((char *)vector + FIELD_OFFSET(RPC_IF_ID_VECTOR, IfId[count]));
+  LIST_FOR_EACH_ENTRY(cif, &server_interfaces, RpcServerInterface, entry)
+  {
+    ids[i].Uuid = cif->If->InterfaceId.SyntaxGUID;
+    ids[i].VersMajor = cif->If->InterfaceId.SyntaxVersion.MajorVersion;
+    ids[i].VersMinor = cif->If->InterfaceId.SyntaxVersion.MinorVersion;
+    vector->IfId[i] = &ids[i];
+    i++;
+  }
+  LeaveCriticalSection(&server_cs);
+  vector->Count = count;
+  *IfIdVector = vector;
+  return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcIfIdVectorFree (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcIfIdVectorFree(RPC_IF_ID_VECTOR **IfIdVector)
+{
+  TRACE("(%p)\n", IfIdVector);
+
+  if (!IfIdVector) return RPC_S_INVALID_ARG;
+  free(*IfIdVector);
+  *IfIdVector = NULL;
+  return RPC_S_OK;
 }
 
 /***********************************************************************
diff --git a/dlls/rpcrt4/rpcrt4.spec b/dlls/rpcrt4/rpcrt4.spec
index 428bf0a..ac6afe7 100644
--- a/dlls/rpcrt4/rpcrt4.spec
+++ b/dlls/rpcrt4/rpcrt4.spec
@@ -389,7 +389,7 @@
 @ stdcall RpcExceptionFilter(long)
 @ stub RpcFreeAuthorizationContext
 @ stdcall RpcGetAsyncCallStatus(ptr) RpcAsyncGetCallStatus
-@ stub RpcIfIdVectorFree
+@ stdcall RpcIfIdVectorFree(ptr)
 @ stdcall RpcIfInqId(ptr ptr)
 @ stdcall RpcImpersonateClient(ptr)
 @ stdcall RpcInitializeAsyncHandle(ptr long) RpcAsyncInitializeHandle
