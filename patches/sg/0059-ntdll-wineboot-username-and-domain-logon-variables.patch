From: Stained Glass OS <dev@stained-glass.example>
Subject: ntdll, wineboot: USERNAME for every user; keep a domain logon's variables

On Windows the logon writes the user's Volatile Environment: USERNAME,
USERDOMAIN, LOGONSERVER, HOMEDRIVE, HOMESHARE, HOMEPATH. In a shared prefix
only the user who ran wineboot ever got one, so everyone else's programs --
and their logon scripts -- expanded %USERNAME% to nothing.

- ntdll sets USERNAME from the signed-in user before the user's own
  variables, as it does USERPROFILE (patch 0018); Volatile Environment still
  overrides it.
- wineboot fills USERDOMAIN, LOGONSERVER, HOMEDRIVE, HOMEPATH and HOMESHARE
  in Volatile Environment only where they are missing, so what a domain
  logon put there (Stained Glass OS's sg-domain-logon: the user's domain,
  the domain controller, their home share) survives it. The key is
  volatile, so a fresh wineserver still gets every value.

--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1325,6 +1325,24 @@
         NtClose( key );
     }
 
+    /* ...and the user's name. On Windows the logon puts USERNAME in the
+     * user's Volatile Environment; in a shared prefix only the user who ran
+     * wineboot ever had one, and everyone else's logon scripts expanded
+     * %USERNAME% to nothing. Volatile Environment still overrides it. */
+    if (user_name)
+    {
+        static const WCHAR usernameW[] = {'U','S','E','R','N','A','M','E',0};
+        size_t ulen = strlen( user_name );
+        WCHAR *name = malloc( (ulen + 1) * sizeof(WCHAR) );
+
+        if (name)
+        {
+            name[ntdll_umbstowcs( user_name, ulen, name, ulen )] = 0;
+            set_env_var( env, pos, size, usernameW, wcslen(usernameW), name );
+            free( name );
+        }
+    }
+
     if (!open_hkcu_key( "Environment", &key ))
     {
         add_registry_variables( env, pos, size, key );
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1033,6 +1033,14 @@
     RegCloseKey( key );
 }
 
+/* Stained Glass OS: what a domain logon put in Volatile Environment (the
+ * user's domain, the domain controller that signed them in, their home
+ * share) is theirs; wineboot only fills in what is missing. */
+static void set_reg_value_if_absent( HKEY hkey, const WCHAR *name, const WCHAR *value )
+{
+    if (RegQueryValueExW( hkey, name, NULL, NULL, NULL, NULL )) set_reg_value( hkey, name, value );
+}
+
 static void create_volatile_environment_registry_key(void)
 {
     WCHAR path[MAX_PATH];
@@ -1056,15 +1064,15 @@
     if (SUCCEEDED(hr))
     {
         set_reg_value( hkey, L"USERPROFILE", path );
-        set_reg_value( hkey, L"HOMEPATH", path + 2 );
+        set_reg_value_if_absent( hkey, L"HOMEPATH", path + 2 );
         path[2] = '\0';
-        set_reg_value( hkey, L"HOMEDRIVE", path );
+        set_reg_value_if_absent( hkey, L"HOMEDRIVE", path );
     }
 
     size = ARRAY_SIZE(path);
     if (GetUserNameW( path, &size )) set_reg_value( hkey, L"USERNAME", path );
 
-    set_reg_value( hkey, L"HOMESHARE", L"" );
+    set_reg_value_if_absent( hkey, L"HOMESHARE", L"" );
 
     hr = SHGetFolderPathW( NULL, CSIDL_LOCAL_APPDATA | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, path );
     if (SUCCEEDED(hr))
@@ -1073,9 +1081,9 @@
     size = ARRAY_SIZE(computername) - 2;
     if (GetComputerNameW(&computername[2], &size))
     {
-        set_reg_value( hkey, L"USERDOMAIN", &computername[2] );
+        set_reg_value_if_absent( hkey, L"USERDOMAIN", &computername[2] );
         computername[0] = computername[1] = '\\';
-        set_reg_value( hkey, L"LOGONSERVER", computername );
+        set_reg_value_if_absent( hkey, L"LOGONSERVER", computername );
     }
 
     set_reg_value( hkey, L"SESSIONNAME", L"Console" );
