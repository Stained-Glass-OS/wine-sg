From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comdlg32: GetOpenFileName with no buffer (2021)

comdlg32: GetOpenFileName with no buffer (2021)

From Wine's todo_wine blocks, which record Windows: when the caller passes
no file buffer (lpstrFile NULL) there is no size to exceed: the dialog is
accepted, CommDlgExtendedError is 0 and nFileOffset / nFileExtension are
filled in, instead of FNERR_BUFFERTOOSMALL.
---
--- a/dlls/comdlg32/filedlg.c
+++ b/dlls/comdlg32/filedlg.c
@@ -3068,7 +3068,12 @@
 
         /* Check that the size of the file does not exceed buffer size.
              (Allow for extra \0 if OFN_MULTISELECT is set.) */
+        /* with no buffer at all there is no size to exceed */
+#ifdef SG_MUTANT_NULL_FILE
         if(lstrlenW(lpstrPathAndFile) < fodInfos->ofnInfos->nMaxFile -
+#else
+        if(!fodInfos->ofnInfos->lpstrFile || lstrlenW(lpstrPathAndFile) < fodInfos->ofnInfos->nMaxFile -
+#endif
             ((fodInfos->ofnInfos->Flags & OFN_ALLOWMULTISELECT) ? 1 : 0))
         {
 
--- a/dlls/comdlg32/tests/filedlg.c
+++ b/dlls/comdlg32/tests/filedlg.c
@@ -1168,12 +1168,12 @@
     ofnA.lpstrFilter = "text\0*.txt\0All\0*\0\0";
     ofnA.lpstrDefExt = NULL;
     ret = GetOpenFileNameA(&ofnA);
-    todo_wine ok(ret, "GetOpenFileNameA returned %#lx\n", ret);
+    ok(ret, "GetOpenFileNameA returned %#lx\n", ret);
     ret = CommDlgExtendedError();
-    todo_wine ok(!ret, "CommDlgExtendedError returned %#lx, should be 0\n", ret);
+    ok(!ret, "CommDlgExtendedError returned %#lx, should be 0\n", ret);
 
-    todo_wine ok(ofnA.nFileOffset != 0xdead, "ofnA.nFileOffset is 0xdead\n");
-    todo_wine ok(ofnA.nFileExtension != 0xbeef, "ofnA.nFileExtension is 0xbeef\n");
+    ok(ofnA.nFileOffset != 0xdead, "ofnA.nFileOffset is 0xdead\n");
+    ok(ofnA.nFileExtension != 0xbeef, "ofnA.nFileExtension is 0xbeef\n");
 
     ofnA.lpstrFile = NULL;
     ofnA.nMaxFile = 1024; /* bogus input - lpstrFile = NULL but fake 1024 bytes available */
@@ -1199,12 +1199,12 @@
     ofnW.lpstrFilter = filterW;
     ofnW.lpstrDefExt = NULL;
     ret = GetOpenFileNameW(&ofnW);
-    todo_wine ok(ret, "GetOpenFileNameW returned %#lx\n", ret);
+    ok(ret, "GetOpenFileNameW returned %#lx\n", ret);
     ret = CommDlgExtendedError();
-    todo_wine ok(!ret, "CommDlgExtendedError returned %#lx\n", ret);
+    ok(!ret, "CommDlgExtendedError returned %#lx\n", ret);
 
-    todo_wine ok(ofnW.nFileOffset != 0xdead, "ofnW.nFileOffset is 0xdead\n");
-    todo_wine ok(ofnW.nFileExtension != 0xbeef, "ofnW.nFileExtension is 0xbeef\n");
+    ok(ofnW.nFileOffset != 0xdead, "ofnW.nFileOffset is 0xdead\n");
+    ok(ofnW.nFileExtension != 0xbeef, "ofnW.nFileExtension is 0xbeef\n");
 
     ofnW.lpstrFile = NULL;
     ofnW.nMaxFile = 1024; /* bogus input - lpstrFile = NULL but fake 1024 bytes available */
