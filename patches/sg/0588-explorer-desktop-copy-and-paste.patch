+/* Stained Glass OS: an icon's verb without its menu -- Ctrl+C, Ctrl+X, Delete */
+static void sg_item_verb( HWND hwnd, const struct launcher *l, const char *verb )
+{
+    const WCHAR *name = (l->args && l->args[0] == ':') ? l->args : l->path;
+    IShellFolder *parent = NULL;
+    IContextMenu *cm = NULL;
+    LPCITEMIDLIST child;
+    LPITEMIDLIST pidl = NULL;
+    HMENU menu;
+
+    sg_ole_init();
+
+    if (l->is_file && SUCCEEDED(SHParseDisplayName( name, NULL, &pidl, 0, NULL )) &&
+        SUCCEEDED(SHBindToParent( pidl, &IID_IShellFolder, (void **)&parent, &child )) &&
+        SUCCEEDED(IShellFolder_GetUIObjectOf( parent, hwnd, 1, &child, &IID_IContextMenu, NULL, (void **)&cm )) &&
+        (menu = CreatePopupMenu()))
+    {
+        CMINVOKECOMMANDINFO info = { sizeof(info) };
+
+        IContextMenu_QueryContextMenu( cm, menu, 0, 1, 0x7fff, CMF_NORMAL );
+        info.hwnd = hwnd;
+        info.lpVerb = verb;
+        info.nShow = SW_SHOWNORMAL;
+        IContextMenu_InvokeCommand( cm, &info );
+        DestroyMenu( menu );
+    }
+    if (cm) IContextMenu_Release( cm );
+    if (parent) IShellFolder_Release( parent );
+    CoTaskMemFree( pidl );
+    PostMessageW( hwnd, WM_SG_DESKTOP_RESCAN, 0, 0 );
+}
+
+/* Stained Glass OS: Paste on the desktop -- what was copied or cut, into the
+ * user's Desktop folder, as the folder's own Paste does it */
+static void sg_paste( HWND hwnd )
+{
+    IShellFolder *desktop = NULL, *folder = NULL;
+    IContextMenu *cm = NULL;
+    LPITEMIDLIST pidl = NULL;
+    HMENU menu;
+
+    sg_ole_init();
+
+    if (SUCCEEDED(SHGetDesktopFolder( &desktop )) &&
+        SUCCEEDED(SHParseDisplayName( desktop_folder, NULL, &pidl, 0, NULL )) &&
+        SUCCEEDED(IShellFolder_BindToObject( desktop, pidl, NULL, &IID_IShellFolder, (void **)&folder )) &&
+        SUCCEEDED(IShellFolder_CreateViewObject( folder, hwnd, &IID_IContextMenu, (void **)&cm )) &&
+        (menu = CreatePopupMenu()))
+    {
+        CMINVOKECOMMANDINFO info = { sizeof(info) };
+
+        IContextMenu_QueryContextMenu( cm, menu, 0, 1, 0x7fff, CMF_NORMAL );
+        info.hwnd = hwnd;
+        info.lpVerb = "paste";
+        info.nShow = SW_SHOWNORMAL;
+        IContextMenu_InvokeCommand( cm, &info );
+        DestroyMenu( menu );
+    }
+    if (cm) IContextMenu_Release( cm );
+    if (folder) IShellFolder_Release( folder );
+    if (desktop) IShellFolder_Release( desktop );
+    CoTaskMemFree( pidl );
+    sg_rescan( hwnd, NULL );
+}
 
