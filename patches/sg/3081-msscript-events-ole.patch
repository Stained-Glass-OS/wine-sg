 static HRESULT WINAPI PersistStreamInit_Load(IPersistStreamInit *iface, IStream *stream)
 {
     ScriptControl *This = impl_from_IPersistStreamInit(iface);
+    struct persisted data;
+    ULONG read;
+    HRESULT hr;
 
-    FIXME("(%p)->(%p)\n", This, stream);
+    TRACE("(%p)->(%p)\n", This, stream);
 
+    if (!stream) return E_POINTER;
+    hr = IStream_Read(stream, &data, sizeof(data), &read);
+    if (FAILED(hr)) return hr;
+    if (read != sizeof(data) || data.version != 1) return E_FAIL;
+    This->timeout = data.timeout;
+    This->allow_ui = data.allow_ui;
+    This->use_safe_subset = data.use_safe_subset;
+    This->dirty = FALSE;
     return S_OK;
 }
 
