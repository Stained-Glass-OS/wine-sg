+/* the Error event: a script error is passed to the program that handles it; when the handler
+ * clears the error object the call does not fail */
+static HRESULT fire_error_event(ScriptControl *This, HRESULT hr)
+{
+    ConnectionPoint *cp = &This->cp_scsource;
+    DISPPARAMS dp = {0};
+    BOOL had_error;
+    IDispatch *sink;
+    unsigned int i;
+
+#ifdef SG_MUTANT_NO_ERROR_EVENT
+    return hr;
+#endif
+    if (SUCCEEDED(hr) || This->events_frozen || !cp->sink_count) return hr;
+    had_error = This->error && This->error->object;
+
+    for (i = 0; i < cp->sink_count; i++)
+    {
+        if (FAILED(IUnknown_QueryInterface(cp->sinks[i].unk, &IID_IDispatch, (void **)&sink))) continue;
+        IDispatch_Invoke(sink, 0xbb8, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, NULL, NULL, NULL);
+        IDispatch_Release(sink);
+    }
+    if (had_error && !This->error->object) return S_OK;
+    return hr;
+}
