+HRESULT dc_create_surface(IDXGIDevice *dxgi_device, UINT width, UINT height, DXGI_FORMAT format,
+        DXGI_ALPHA_MODE alpha_mode, BOOL is_virtual, void **out);
+IUnknown *dc_surface_get_presenter(IUnknown *content);
+
 #endif
