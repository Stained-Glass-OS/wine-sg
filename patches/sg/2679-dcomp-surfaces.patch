+
+/*
+ * A surface is a Direct3D 11 texture on the device the DirectComposition
+ * device was made for. BeginDraw hands the texture (as the interface asked
+ * for) to the program, EndDraw takes it back. When a visual whose content is
+ * a surface is committed and the surface changed, its texture is copied to
+ * the back buffer of a composition swap chain of the same size that the
+ * surface keeps for the purpose, and presented: showing that swap chain in
+ * the window is what the device already does for the swap chains programs
+ * make themselves. A virtual surface is the same, with a size that can
+ * change and a Trim that has nothing to give back.
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objidl.h"
+#include "d3d11.h"
+#include "dxgi1_2.h"
+#include "dcomp.h"
+#include "wine/debug.h"
+
+#include "dcomp_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+#define DC_MAX_SURFACE_SIZE 16384
+
+enum surface_state { SURFACE_IDLE, SURFACE_DRAWING, SURFACE_SUSPENDED };
+
+struct composition_surface
+{
+    IDCompositionVirtualSurface IDCompositionVirtualSurface_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+    BOOL is_virtual;
+    UINT width, height;
+    DXGI_FORMAT format;
+    DXGI_ALPHA_MODE alpha_mode;
+    ID3D11Device *device;
+    ID3D11DeviceContext *context;
+    IDXGIDevice *dxgi_device;
+    ID3D11Texture2D *texture;
+    IDXGISwapChain1 *chain;
+    UINT chain_width, chain_height;
+    enum surface_state state;
+    BOOL dirty;
+};
+
+static const IDCompositionVirtualSurfaceVtbl virtual_surface_vtbl;
+static const IDCompositionSurfaceVtbl surface_vtbl;
+
+static struct composition_surface *impl_from_IDCompositionVirtualSurface(IDCompositionVirtualSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_surface, IDCompositionVirtualSurface_iface);
+}
+
+static struct composition_surface *unsafe_impl_from_surface(IUnknown *object)
+{
+    IDCompositionSurface *surface;
+    struct composition_surface *impl = NULL;
+
+    if (!object || FAILED(IUnknown_QueryInterface(object, &IID_IDCompositionSurface, (void **)&surface)))
+        return NULL;
+    if (surface->lpVtbl == &surface_vtbl || surface->lpVtbl == (const void *)&virtual_surface_vtbl)
+        impl = CONTAINING_RECORD(surface, struct composition_surface, IDCompositionVirtualSurface_iface);
+    IDCompositionSurface_Release(surface);
+    return impl;
+}
+
+static HRESULT surface_create_texture(struct composition_surface *surface, UINT width, UINT height,
+        ID3D11Texture2D **texture)
+{
+    D3D11_TEXTURE2D_DESC desc = {0};
+
+    desc.Width = width;
+    desc.Height = height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = surface->format;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    return ID3D11Device_CreateTexture2D(surface->device, &desc, NULL, texture);
+}
+
+static HRESULT WINAPI surface_QueryInterface(IDCompositionVirtualSurface *iface, REFIID iid, void **out)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionSurface)
+            || (surface->is_virtual && IsEqualGUID(iid, &IID_IDCompositionVirtualSurface)))
+    {
+        IDCompositionVirtualSurface_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI surface_AddRef(IDCompositionVirtualSurface *iface)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ULONG refcount = InterlockedIncrement(&surface->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", surface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI surface_Release(IDCompositionVirtualSurface *iface)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ULONG refcount = InterlockedDecrement(&surface->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", surface, refcount);
+
+    if (!refcount)
+    {
+        if (surface->chain) IDXGISwapChain1_Release(surface->chain);
+        if (surface->texture) ID3D11Texture2D_Release(surface->texture);
+        if (surface->context) ID3D11DeviceContext_Release(surface->context);
+        if (surface->device) ID3D11Device_Release(surface->device);
+        if (surface->dxgi_device) IDXGIDevice_Release(surface->dxgi_device);
+        surface->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&surface->cs);
+        free(surface);
+    }
+    return refcount;
+}
+
+static BOOL rect_valid_in_surface(const struct composition_surface *surface, const RECT *rect)
+{
+    return rect->left >= 0 && rect->top >= 0 && rect->right > rect->left && rect->bottom > rect->top
+            && (UINT)rect->right <= surface->width && (UINT)rect->bottom <= surface->height;
+}
+
+static HRESULT WINAPI surface_BeginDraw(IDCompositionVirtualSurface *iface, const RECT *rect, REFIID iid,
+        void **object, POINT *offset)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, rect %s, iid %s, object %p, offset %p.\n", iface, wine_dbgstr_rect(rect),
+            debugstr_guid(iid), object, offset);
+
+    if (!object || !offset)
+        return E_INVALIDARG;
+    *object = NULL;
+    offset->x = offset->y = 0;
+
+    EnterCriticalSection(&surface->cs);
+#ifdef SG_MUTANT_SURFACE_REENTER
+    if (0)
+#else
+    if (surface->state != SURFACE_IDLE)
+#endif
+        hr = DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+    else if (rect && !rect_valid_in_surface(surface, rect))
+        hr = E_INVALIDARG;
+    else if (SUCCEEDED(hr = ID3D11Texture2D_QueryInterface(surface->texture, iid, object)))
+    {
+        if (rect)
+        {
+            offset->x = rect->left;
+            offset->y = rect->top;
+        }
+        surface->state = SURFACE_DRAWING;
+    }
+    LeaveCriticalSection(&surface->cs);
+    return hr;
+}
+
+static HRESULT WINAPI surface_EndDraw(IDCompositionVirtualSurface *iface)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&surface->cs);
+    if (surface->state == SURFACE_IDLE)
+        hr = DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
+    else
+    {
+        surface->state = SURFACE_IDLE;
+        surface->dirty = TRUE;
+    }
+    LeaveCriticalSection(&surface->cs);
+    return hr;
+}
+
+static HRESULT WINAPI surface_SuspendDraw(IDCompositionVirtualSurface *iface)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&surface->cs);
+    if (surface->state != SURFACE_DRAWING)
+        hr = DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
+    else
+        surface->state = SURFACE_SUSPENDED;
+    LeaveCriticalSection(&surface->cs);
+    return hr;
+}
+
+static HRESULT WINAPI surface_ResumeDraw(IDCompositionVirtualSurface *iface)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&surface->cs);
+    if (surface->state != SURFACE_SUSPENDED)
+        hr = DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
+    else
+        surface->state = SURFACE_DRAWING;
+    LeaveCriticalSection(&surface->cs);
+    return hr;
+}
+
+static HRESULT WINAPI surface_Scroll(IDCompositionVirtualSurface *iface, const RECT *scroll, const RECT *clip,
+        int offset_x, int offset_y)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    RECT whole = {0, 0, surface->width, surface->height}, src, dst;
+    ID3D11Texture2D *copy;
+    D3D11_BOX box;
+    HRESULT hr;
+
+    TRACE("iface %p, scroll %s, clip %s, offset_x %d, offset_y %d.\n", iface, wine_dbgstr_rect(scroll),
+            wine_dbgstr_rect(clip), offset_x, offset_y);
+
+    if ((scroll && !rect_valid_in_surface(surface, scroll)) || (clip && !rect_valid_in_surface(surface, clip)))
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&surface->cs);
+    if (surface->state != SURFACE_IDLE)
+    {
+        LeaveCriticalSection(&surface->cs);
+        return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+    }
+
+    /* the pixels of the scroll rectangle move by the offset; only the part that lands inside the
+     * clip rectangle is written */
+    src = scroll ? *scroll : whole;
+    dst = src;
+    OffsetRect(&dst, offset_x, offset_y);
+#ifdef SG_MUTANT_SURFACE_SCROLL_NOCLIP
+    clip = NULL;
+#endif
+    if (!IntersectRect(&dst, &dst, clip ? clip : &whole) || !IntersectRect(&dst, &dst, &whole))
+    {
+        LeaveCriticalSection(&surface->cs);
+        return S_OK;
+    }
+    src = dst;
+    OffsetRect(&src, -offset_x, -offset_y);
+
+    if (SUCCEEDED(hr = surface_create_texture(surface, surface->width, surface->height, &copy)))
+    {
+        box.left = src.left; box.top = src.top; box.front = 0;
+        box.right = src.right; box.bottom = src.bottom; box.back = 1;
+        ID3D11DeviceContext_CopySubresourceRegion(surface->context, (ID3D11Resource *)copy, 0, 0, 0, 0,
+                (ID3D11Resource *)surface->texture, 0, &box);
+        box.left = 0; box.top = 0;
+        box.right = src.right - src.left; box.bottom = src.bottom - src.top;
+        ID3D11DeviceContext_CopySubresourceRegion(surface->context, (ID3D11Resource *)surface->texture, 0,
+                dst.left, dst.top, 0, (ID3D11Resource *)copy, 0, &box);
+        ID3D11Texture2D_Release(copy);
+        surface->dirty = TRUE;
+    }
+    LeaveCriticalSection(&surface->cs);
+    return hr;
+}
+
+static HRESULT WINAPI surface_Resize(IDCompositionVirtualSurface *iface, UINT width, UINT height)
+{
+    struct composition_surface *surface = impl_from_IDCompositionVirtualSurface(iface);
+    ID3D11Texture2D *texture;
+    D3D11_BOX box;
+    HRESULT hr;
+
+    TRACE("iface %p, width %u, height %u.\n", iface, width, height);
+
+    if (!width || !height || width > DC_MAX_SURFACE_SIZE || height > DC_MAX_SURFACE_SIZE)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&surface->cs);
+    if (surface->state != SURFACE_IDLE)
+    {
+        LeaveCriticalSection(&surface->cs);
+        return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+    }
+    if (SUCCEEDED(hr = surface_create_texture(surface, width, height, &texture)))
+    {
+        /* the part that stays keeps its pixels */
+        box.left = box.top = box.front = 0;
+        box.right = min(width, surface->width);
+        box.bottom = min(height, surface->height);
+        box.back = 1;
+        ID3D11DeviceContext_CopySubresourceRegion(surface->context, (ID3D11Resource *)texture, 0, 0, 0, 0,
+                (ID3D11Resource *)surface->texture, 0, &box);
+        ID3D11Texture2D_Release(surface->texture);
+        surface->texture = texture;
+        surface->width = width;
+        surface->height = height;
+        surface->dirty = TRUE;
+    }
+    LeaveCriticalSection(&surface->cs);
+    return hr;
+}
+
+static HRESULT WINAPI surface_Trim(IDCompositionVirtualSurface *iface, const RECT *rectangles, UINT count)
+{
+    TRACE("iface %p, rectangles %p, count %u.\n", iface, rectangles, count);
+
+    /* Nothing is allocated lazily here, so there is nothing to give back. */
+    if (count && !rectangles)
+        return E_INVALIDARG;
+    return S_OK;
+}
+
+static const IDCompositionSurfaceVtbl surface_vtbl =
+{
+    (void *)surface_QueryInterface,
+    (void *)surface_AddRef,
+    (void *)surface_Release,
+    (void *)surface_BeginDraw,
+    (void *)surface_EndDraw,
+    (void *)surface_SuspendDraw,
+    (void *)surface_ResumeDraw,
+    (void *)surface_Scroll,
+};
+
+static const IDCompositionVirtualSurfaceVtbl virtual_surface_vtbl =
+{
+    surface_QueryInterface,
+    surface_AddRef,
+    surface_Release,
+    surface_BeginDraw,
+    surface_EndDraw,
+    surface_SuspendDraw,
+    surface_ResumeDraw,
+    surface_Scroll,
+    surface_Resize,
+    surface_Trim,
+};
+
+HRESULT dc_create_surface(IDXGIDevice *dxgi_device, UINT width, UINT height, DXGI_FORMAT format,
+        DXGI_ALPHA_MODE alpha_mode, BOOL is_virtual, void **out)
+{
+    struct composition_surface *surface;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!width || !height || width > DC_MAX_SURFACE_SIZE || height > DC_MAX_SURFACE_SIZE)
+        return E_INVALIDARG;
+    if (format != DXGI_FORMAT_B8G8R8A8_UNORM && format != DXGI_FORMAT_R8G8B8A8_UNORM
+            && format != DXGI_FORMAT_R16G16B16A16_FLOAT)
+        return E_INVALIDARG;
+    if (alpha_mode != DXGI_ALPHA_MODE_PREMULTIPLIED && alpha_mode != DXGI_ALPHA_MODE_IGNORE)
+        return E_INVALIDARG;
+
+    if (!(surface = calloc(1, sizeof(*surface))))
+        return E_OUTOFMEMORY;
+    surface->IDCompositionVirtualSurface_iface.lpVtbl = is_virtual ? &virtual_surface_vtbl
+            : (const IDCompositionVirtualSurfaceVtbl *)&surface_vtbl;
+    surface->refcount = 1;
+    InitializeCriticalSectionEx(&surface->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    surface->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": composition_surface.cs");
+    surface->is_virtual = is_virtual;
+    surface->width = width;
+    surface->height = height;
+    surface->format = format;
+    surface->alpha_mode = alpha_mode;
+
+    if (dxgi_device)
+    {
+        if (FAILED(hr = IDXGIDevice_QueryInterface(dxgi_device, &IID_ID3D11Device, (void **)&surface->device)))
+        {
+            WARN("The DXGI device is not a Direct3D 11 device, hr %#lx.\n", hr);
+            goto fail;
+        }
+        IDXGIDevice_AddRef(surface->dxgi_device = dxgi_device);
+    }
+    else
+    {
+        /* Without a device of the program's, surfaces live on a device of our own. */
+        if (FAILED(hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                NULL, 0, D3D11_SDK_VERSION, &surface->device, NULL, NULL)))
+            goto fail;
+        if (FAILED(hr = ID3D11Device_QueryInterface(surface->device, &IID_IDXGIDevice, (void **)&surface->dxgi_device)))
+            goto fail;
+    }
+    ID3D11Device_GetImmediateContext(surface->device, &surface->context);
+
+    if (FAILED(hr = surface_create_texture(surface, width, height, &surface->texture)))
+        goto fail;
+
+    *out = &surface->IDCompositionVirtualSurface_iface;
+    return S_OK;
+
+fail:
+    surface_Release(&surface->IDCompositionVirtualSurface_iface);
+    return hr;
+}
+
+/* The swap chain that shows the content of a surface, brought up to date; NULL if the content is not a
+ * surface (or showing it failed). The caller releases it. */
+IUnknown *dc_surface_get_presenter(IUnknown *content)
+{
+    struct composition_surface *surface = unsafe_impl_from_surface(content);
+    IUnknown *ret = NULL;
+    ID3D11Texture2D *buffer;
+    IDXGIAdapter *adapter;
+    IDXGIFactory2 *factory;
+
+    if (!surface)
+        return NULL;
+
+    EnterCriticalSection(&surface->cs);
+    if (surface->chain && (surface->chain_width != surface->width || surface->chain_height != surface->height))
+    {
+        IDXGISwapChain1_Release(surface->chain);
+        surface->chain = NULL;
+        surface->dirty = TRUE;
+    }
+
+    if (!surface->chain)
+    {
+        DXGI_SWAP_CHAIN_DESC1 desc = {0};
+
+        desc.Width = surface->width;
+        desc.Height = surface->height;
+        desc.Format = surface->format;
+        desc.SampleDesc.Count = 1;
+        desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+        desc.BufferCount = 2;
+        desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+        desc.AlphaMode = surface->alpha_mode;
+        if (SUCCEEDED(IDXGIDevice_GetAdapter(surface->dxgi_device, &adapter)))
+        {
+            if (SUCCEEDED(IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory2, (void **)&factory)))
+            {
+                if (FAILED(IDXGIFactory2_CreateSwapChainForComposition(factory, (IUnknown *)surface->device, &desc,
+                        NULL, &surface->chain)))
+                    WARN("Failed to create the swap chain showing a surface.\n");
+                IDXGIFactory2_Release(factory);
+            }
+            IDXGIAdapter_Release(adapter);
+        }
+        if (surface->chain)
+        {
+            surface->chain_width = surface->width;
+            surface->chain_height = surface->height;
+            surface->dirty = TRUE;
+        }
+    }
+
+    if (surface->chain)
+    {
+#ifndef SG_MUTANT_SURFACE_NEVER_PRESENT
+        if (surface->dirty && surface->state != SURFACE_DRAWING
+                && SUCCEEDED(IDXGISwapChain1_GetBuffer(surface->chain, 0, &IID_ID3D11Texture2D, (void **)&buffer)))
+        {
+            ID3D11DeviceContext_CopyResource(surface->context, (ID3D11Resource *)buffer,
+                    (ID3D11Resource *)surface->texture);
+            ID3D11Texture2D_Release(buffer);
+            IDXGISwapChain1_Present(surface->chain, 0, 0);
+            surface->dirty = FALSE;
+        }
+#endif
+        IDXGISwapChain1_QueryInterface(surface->chain, &IID_IUnknown, (void **)&ret);
+    }
+    LeaveCriticalSection(&surface->cs);
+    return ret;
+}
