From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: context menu submenu items have command IDs (3605)

shell32: the submenu items of the context menus have command IDs

The View, Arrange Icons and New submenus of the folder background menu (merged
without IDs of their own so they are not dropped at an idCmdFirst of 0) and the
Send to submenu item of the item menu had item ID 0. IContextMenu clients, and
shell32's own shlfolder test (test_contextmenu), expect every item's ID to lie
between idCmdFirst and the maximum QueryContextMenu returned. Each such item now
gets an ID after the last command's, so no other item is taken for it, and the
returned maximum covers them. Which submenus exist, and what they hold, is
unchanged.

Explorer-facing: run the explorer gates at integration.
Gate: test/fastb-cmenuids-gate.sh (shlfolder; mutant SG_MUTANT_POPUP_IDS, 4 failures).
---
diff --git a/dlls/shell32/shlview_cmenu.c b/dlls/shell32/shlview_cmenu.c
index 3683015..aea73d9 100644
--- a/dlls/shell32/shlview_cmenu.c
+++ b/dlls/shell32/shlview_cmenu.c
@@ -509,8 +509,19 @@ static HRESULT WINAPI ItemMenu_QueryContextMenu(
                 mi.fType = MFT_STRING;
                 mi.hSubMenu = SHELL_BuildSendToMenu(idCmdFirst + SENDTO_ID_OFFSET, idCmdFirst + SENDTO_ID_LAST,
                                                     &This->sendto, &This->sendto_count);
+#ifndef SG_MUTANT_POPUP_IDS
+                /* the submenu item has a command ID of the menu too, after the Send to targets' */
+                uIDMax = max(uIDMax, idCmdFirst + SENDTO_ID_OFFSET + This->sendto_count + 1);
+                if (uIDMax <= idCmdLast)
+                {
+                    mi.fMask |= MIIM_ID;
+                    mi.wID = uIDMax++;
+                }
+                InsertMenuItemW(hmenu, pos++, MF_BYPOSITION, &mi);
+#else
                 InsertMenuItemW(hmenu, pos++, MF_BYPOSITION, &mi);
                 uIDMax = max(uIDMax, idCmdFirst + SENDTO_ID_OFFSET + This->sendto_count + 1);
+#endif
                 mi.fMask = MIIM_FTYPE;
                 mi.fType = MFT_SEPARATOR;
                 InsertMenuItemW(hmenu, pos++, MF_BYPOSITION, &mi);
@@ -2059,6 +2070,7 @@ static HRESULT WINAPI BackgroundMenu_QueryContextMenu(
          * IDs of their own. With the view's idCmdFirst of 0 their IDs
          * (0x40-0x42) moved below zero, wrapped past idCmdLast and all three
          * were dropped: the right-click menu had no New at all. */
+        UINT before = GetMenuItemCount(hMenu);
         Shell_MergeMenus (hMenu, GetSubMenu(hMyMenu,0), indexMenu,
                           idCmdFirst - FCIDM_BASE, idCmdLast, 0);
         idMax = max_menu_id(GetSubMenu(hMyMenu, 0), idCmdFirst - FCIDM_BASE, idCmdLast);
@@ -2066,6 +2078,26 @@ static HRESULT WINAPI BackgroundMenu_QueryContextMenu(
             UINT top = add_new_types( hMenu, idCmdFirst - FCIDM_BASE, idCmdLast );
             if (top > idMax) idMax = top;
         }
+        /* The submenus got no ID: a command ID of the menu is what the caller
+         * and IContextMenu clients expect of every item (between idCmdFirst and
+         * the returned maximum). Give each one an ID after the last command's,
+         * so none is taken for another item. */
+#ifndef SG_MUTANT_POPUP_IDS
+        {
+            UINT i, count = GetMenuItemCount(hMenu);
+
+            for (i = indexMenu; indexMenu <= before && count >= before && i < indexMenu + (count - before); i++)
+            {
+                MENUITEMINFOW mi = { sizeof(mi), MIIM_ID | MIIM_SUBMENU };
+
+                if (!GetMenuItemInfoW(hMenu, i, TRUE, &mi) || !mi.hSubMenu || mi.wID) continue;
+                if (idMax >= idCmdLast) break;   /* no room */
+                mi.fMask = MIIM_ID;
+                mi.wID = idMax++;
+                SetMenuItemInfoW(hMenu, i, TRUE, &mi);
+            }
+        }
+#endif
         hr =  MAKE_HRESULT(SEVERITY_SUCCESS, FACILITY_NULL, idMax-idCmdFirst);
     }
     DestroyMenu(hMyMenu);
