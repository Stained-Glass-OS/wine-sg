From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: marshal data of an STA's object is released in its
 apartment

---
 dlls/combase/marshal.c | 52 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 49 insertions(+), 3 deletions(-)

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
index 226bc0a..4494065 100644
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -634,6 +634,50 @@ static HRESULT get_unmarshaler_from_stream(IStream *stream, IMarshal **marshal,
     return hr;
 }
 
+/* Stained Glass OS (wine-sg 7823): marshal data released in the object's own apartment */
+struct release_marshal_call
+{
+    struct stub_manager *stubmgr;
+    const struct OR_STANDARD *obj;
+};
+
+static HRESULT __stdcall release_marshal_data_in_apartment(void *param)
+{
+    struct release_marshal_call *call = param;
+
+    stub_manager_release_marshal_data(call->stubmgr, call->obj->std.cPublicRefs, &call->obj->std.ipid,
+                                      call->obj->std.flags & SORFP_TABLEWEAK);
+    stub_manager_int_release(call->stubmgr);   /* the last reference may be this one: the object goes here */
+    return S_OK;
+}
+
+/* An object of a single-threaded apartment is released on that apartment's thread, whichever thread
+ * releases the marshal data: the global interface table's RevokeInterfaceFromGlobal from another
+ * thread -- .NET's finalizer dropping an STA object it held through the table (WinForms'
+ * AgileComPointer: an mshtml element of a WebBrowser) -- released the object on the finalizer thread,
+ * and the object, made for its own thread only, crashed (Devolutions RDM 2025.1 at start). As for a
+ * call to the object, the releasing thread waits while the apartment's thread runs it (sent to its
+ * apartment window). Released here as before when the apartment's thread is gone or going: it then
+ * disconnected its objects itself. */
+static BOOL release_marshal_data_elsewhere(struct apartment *apt, struct stub_manager *stubmgr,
+                                           const struct OR_STANDARD *obj)
+{
+    struct release_marshal_call rc = { stubmgr, obj };
+    struct context_call call = { release_marshal_data_in_apartment, &rc, E_FAIL, NULL };
+    HWND hwnd;
+
+#ifdef SG_MUTANT_GIT_RELEASE_HERE
+    return FALSE;
+#endif
+    if (apt->multi_threaded || apt->tid == GetCurrentThreadId()) return FALSE;
+    if (!(hwnd = apartment_getwindow(apt))) return FALSE;
+    if (!(call.done = CreateEventW(NULL, TRUE, FALSE, NULL))) return FALSE;
+    SendMessageW(hwnd, DM_CONTEXTCALL, 0, (LPARAM)&call);
+    CloseHandle(call.done);
+    TRACE("released in the apartment of thread %04lx: %#lx\n", apt->tid, call.hr);
+    return call.hr == S_OK;
+}
+
 static HRESULT std_release_marshal_data(IStream *stream)
 {
     struct stub_manager *stubmgr;
@@ -669,9 +713,11 @@ static HRESULT std_release_marshal_data(IStream *stream)
         return RPC_E_INVALID_OBJREF;
     }
 
-    stub_manager_release_marshal_data(stubmgr, obj.std.cPublicRefs, &obj.std.ipid, obj.std.flags & SORFP_TABLEWEAK);
-
-    stub_manager_int_release(stubmgr);
+    if (!release_marshal_data_elsewhere(apt, stubmgr, &obj))
+    {
+        stub_manager_release_marshal_data(stubmgr, obj.std.cPublicRefs, &obj.std.ipid, obj.std.flags & SORFP_TABLEWEAK);
+        stub_manager_int_release(stubmgr);
+    }
     apartment_release(apt);
 
     return S_OK;
-- 
