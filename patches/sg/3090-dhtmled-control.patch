 static HRESULT WINAPI DHTMLEdit_LoadURL(IDHTMLEdit *iface, BSTR url)
 {
     DHTMLEditImpl *This = impl_from_IDHTMLEdit(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_w(url));
-    return E_NOTIMPL;
+    WCHAR path[MAX_PATH];
+    DWORD len = ARRAY_SIZE(path);
+    HRESULT hr;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(url));
+
+    if (!url || !*url)
+        return E_INVALIDARG;
+    /* a file: URL or a path; other schemes need a download this control does not do */
+    if (!_wcsnicmp(url, L"file:", 5))
+    {
+        if (FAILED(hr = PathCreateFromUrlW(url, path, &len, 0))) return hr;
+        url = path;
+    }
+    else if (wcschr(url, ':') && wcschr(url, ':') - url > 1)
+        return E_NOTIMPL;
+    if (FAILED(hr = load_file(This, url))) return hr;
+    fire_event(This, DISPID_DOCUMENTCOMPLETE);
+    return S_OK;
 }
 
