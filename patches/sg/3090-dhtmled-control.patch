 static HRESULT WINAPI DHTMLEdit_get_DOM(IDHTMLEdit *iface, IHTMLDocument2 **value)
 {
     DHTMLEditImpl *This = impl_from_IDHTMLEdit(iface);
-    FIXME("(%p)->(%p) stub\n", This, value);
-    return E_NOTIMPL;
+    SAFEARRAY *sa;
+    VARIANT *var;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, value);
+
+    if (!value) return E_INVALIDARG;
+    *value = NULL;
+
+    /* a document of its own with the source of the edited one */
+    hr = CoCreateInstance(&CLSID_HTMLDocument, NULL, CLSCTX_INPROC_SERVER, &IID_IHTMLDocument2, (void **)value);
+    if (FAILED(hr)) return hr;
+    if (!(sa = SafeArrayCreateVector(VT_VARIANT, 0, 1)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        SafeArrayAccessData(sa, (void **)&var);
+        V_VT(var) = VT_BSTR;
+        V_BSTR(var) = SysAllocString(This->html ? This->html : L"");
+        SafeArrayUnaccessData(sa);
+        hr = IHTMLDocument2_write(*value, sa);
+        SafeArrayDestroy(sa);
+        if (SUCCEEDED(hr)) IHTMLDocument2_close(*value);
+    }
+    if (FAILED(hr))
+    {
+        IHTMLDocument2_Release(*value);
+        *value = NULL;
+    }
+    return hr;
 }
 
