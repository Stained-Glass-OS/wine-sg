+static void fire_event(DHTMLEditImpl *This, DISPID id)
+{
+    DISPPARAMS params = {0};
+    DWORD i;
+
+#ifdef SG_MUTANT_NO_EVENTS
+    return;
+#endif
+    for (i = 0; i < This->sink_count; i++)
+    {
+        IDispatch *sink = This->sinks[i];
+        if (!sink) continue;
+        IDispatch_AddRef(sink);
+        IDispatch_Invoke(sink, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &params, NULL, NULL, NULL);
+        IDispatch_Release(sink);
+    }
+}
+
+/* replaces the document source; a document set by the program is not dirty */
+static HRESULT set_document(DHTMLEditImpl *This, const WCHAR *html, const WCHAR *path, BOOL dirty)
+{
+    BSTR new_html = NULL, new_path = NULL;
+
+    if (html && !(new_html = SysAllocString(html))) return E_OUTOFMEMORY;
+    if (path && !(new_path = SysAllocString(path)))
+    {
+        SysFreeString(new_html);
+        return E_OUTOFMEMORY;
+    }
+    SysFreeString(This->html);
+    SysFreeString(This->path);
+    This->html = new_html;
+    This->path = new_path;
+    This->dirty = dirty;
+    return S_OK;
+}
+
+static WCHAR *html_from_bytes(const BYTE *data, DWORD size)
+{
+    WCHAR *ret;
+    int len;
+
+    if (size >= 2 && data[0] == 0xff && data[1] == 0xfe)
+    {
+        len = (size - 2) / sizeof(WCHAR);
+        if ((ret = HeapAlloc(GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR))))
+        {
+            memcpy(ret, data + 2, len * sizeof(WCHAR));
+            ret[len] = 0;
+        }
+        return ret;
+    }
+    if (size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf)
+    {
+        data += 3;
+        size -= 3;
+    }
+    len = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)data, size, NULL, 0);
+    if (len || !size)
+    {
+        if ((ret = HeapAlloc(GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR))))
+        {
+            MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)data, size, ret, len);
+            ret[len] = 0;
+        }
+        return ret;
+    }
+    len = MultiByteToWideChar(CP_ACP, 0, (const char *)data, size, NULL, 0);
+    if ((ret = HeapAlloc(GetProcessHeap(), 0, (len + 1) * sizeof(WCHAR))))
+    {
+        MultiByteToWideChar(CP_ACP, 0, (const char *)data, size, ret, len);
+        ret[len] = 0;
+    }
+    return ret;
+}
+
+static HRESULT load_file(DHTMLEditImpl *This, const WCHAR *path)
+{
+    HANDLE file;
+    DWORD size, read;
+    BYTE *data;
+    WCHAR *html, full[MAX_PATH];
+    HRESULT hr;
+
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    size = GetFileSize(file, NULL);
+    if (size == INVALID_FILE_SIZE || !(data = HeapAlloc(GetProcessHeap(), 0, size ? size : 1)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, data, size, &read, NULL))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else if (!(html = html_from_bytes(data, read)))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        if (!GetFullPathNameW(path, MAX_PATH, full, NULL)) lstrcpyW(full, path);
+        hr = set_document(This, html, full, FALSE);
+        HeapFree(GetProcessHeap(), 0, html);
+    }
+    HeapFree(GetProcessHeap(), 0, data);
+    CloseHandle(file);
+    return hr;
+}
+
+/* the <title> of the document, as the editor reports it */
+static BSTR document_title(const WCHAR *html)
+{
+    const WCHAR *start, *end;
+
+    if (!html) return SysAllocString(L"");
+    for (start = html; *start; start++)
+        if (!_wcsnicmp(start, L"<title", 6) && (start[6] == '>' || start[6] == ' ')) break;
+    if (!*start || !(start = wcschr(start, '>'))) return SysAllocString(L"");
+    start++;
+    for (end = start; *end; end++)
+        if (!_wcsnicmp(end, L"</title", 7)) break;
+    return SysAllocStringLen(start, end - start);
+}
+
+static HRESULT path_from_variant(const VARIANT *var, const WCHAR **path)
+{
+    const VARIANT *v = var;
+
+    while (v && V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    if (!v || V_VT(v) == VT_EMPTY || V_VT(v) == VT_ERROR) { *path = NULL; return S_OK; }
+    if (V_VT(v) == VT_BSTR) { *path = V_BSTR(v); return S_OK; }
+    if (V_VT(v) == (VT_BSTR | VT_BYREF)) { *path = *V_BSTRREF(v); return S_OK; }
+    return E_INVALIDARG;
+}
