From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: A font written over a Fonts folder link replaces it (6546)

Since 6533 C:\windows\Fonts holds links to the system's fonts. A font an
installer writes under one of those names (CREATE_ALWAYS, TRUNCATE_EXISTING,
CopyFile, MSI's cabinet extraction) was opened through the link, at the
system's read-only file: access denied. LibreOffice's MSI stopped at
Caladea-Bold.ttf (InstallFiles 1603, msiexec 67), OpenOffice's likewise;
the rollback then deleted the link.

When an overwriting open (O_TRUNC dispositions) fails with access denied,
read-only or not found, and the name is a symbolic link to an absolute
path in the prefix's windows\Fonts folder, the link is removed and the
file created in its place, as the file it stood for would have been
replaced. The system's file is never written. Other links are unchanged.
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 0076064..031e17e 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4537,6 +4537,40 @@ static mode_t sg_umask(void)
 #define SG_UNIX_READ_ACCESS  (FILE_READ_DATA|FILE_READ_ATTRIBUTES|FILE_READ_EA)
 #define SG_UNIX_WRITE_ACCESS (FILE_WRITE_DATA|FILE_APPEND_DATA|FILE_WRITE_ATTRIBUTES|FILE_WRITE_EA)
 
+/* Stained Glass OS: whether unix_name is one of the links wineboot keeps in
+ * C:\windows\Fonts to the system's fonts (6533): a symbolic link to an
+ * absolute path, in the prefix's windows\Fonts folder */
+static BOOL sg_is_font_folder_link( int root_fd, const char *unix_name )
+{
+    struct stat lst, dir_st, fonts_st;
+    char target[16], *fonts, *parent, *slash;
+    BOOL ret = FALSE;
+    ssize_t len;
+
+    if (fstatat( root_fd, unix_name, &lst, AT_SYMLINK_NOFOLLOW ) || !S_ISLNK( lst.st_mode )) return FALSE;
+    if ((len = readlinkat( root_fd, unix_name, target, sizeof(target) )) <= 0 || target[0] != '/') return FALSE;
+    if (!config_dir || !(fonts = malloc( strlen( config_dir ) + sizeof("/dosdevices/c:/windows/Fonts") ))) return FALSE;
+    strcpy( fonts, config_dir );
+    strcat( fonts, "/dosdevices/c:/windows/Fonts" );
+    if (!stat( fonts, &fonts_st ))
+    {
+        if ((slash = strrchr( unix_name, '/' )))
+        {
+            if ((parent = strdup( unix_name )))
+            {
+                parent[slash - unix_name] = 0;
+                if (!fstatat( root_fd, slash == unix_name ? "/" : parent, &dir_st, 0 ))
+                    ret = dir_st.st_dev == fonts_st.st_dev && dir_st.st_ino == fonts_st.st_ino;
+                free( parent );
+            }
+        }
+        else if (root_fd != AT_FDCWD && !fstat( root_fd, &dir_st ))
+            ret = dir_st.st_dev == fonts_st.st_dev && dir_st.st_ino == fonts_st.st_ino;
+    }
+    free( fonts );
+    return ret;
+}
+
 /* Open unix_name (relative to root_fd when it is not AT_FDCWD) as this process's
  * user. Returns the fd, or -1 with *status set; *created says whether this call
  * created it. */
@@ -4605,6 +4639,22 @@ static int sg_client_open( int root_fd, const char *unix_name, ACCESS_MASK acces
     if (fd == -1 && errno == EISDIR && ((access & SG_UNIX_WRITE_ACCESS) || (flags & O_CREAT)))
         fd = openat( root_fd, unix_name, O_RDONLY | O_NONBLOCK | O_CLOEXEC );
 
+    /* Stained Glass OS: a font written over one of the Fonts folder's links to
+     * the system's fonts (an installer's CopyFile or MSI's extraction of
+     * Caladea-Bold.ttf, CREATE_ALWAYS) replaces the link, as the file it
+     * stands for would have been replaced: writing through it to the
+     * system's read-only font failed with access denied, and LibreOffice's
+     * and OpenOffice's installs stopped (6533) */
+#ifndef SG_MUTANT_FONT_LINK_WRITE_THROUGH
+    if (fd == -1 && (flags & O_TRUNC) && (errno == EACCES || errno == EPERM || errno == EROFS || errno == ENOENT) &&
+        sg_is_font_folder_link( root_fd, unix_name ) && !unlinkat( root_fd, unix_name, 0 ))
+    {
+        /* (FILE_OVERWRITE too: the file existed, as the link) */
+        fd = openat( root_fd, unix_name, rw_mode | O_CREAT | O_EXCL, 0600 );
+        if (fd != -1) *created = TRUE;
+    }
+#endif
+
     /* Stained Glass OS: a symbolic link opened as itself (FILE_OPEN_REPARSE_POINT,
      * as DeleteFileW and RemoveDirectoryW open) whose target is missing, or that
      * loops, is opened as the link -- O_PATH, never through it -- as on Windows,
