From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernel32: Fail user-mode scheduling with ERROR_NOT_SUPPORTED.

The user-mode scheduling functions fail with ERROR_NOT_SUPPORTED, as
documented for Windows 11 ("user-mode scheduling is not supported. All calls
fail with the error ERROR_NOT_SUPPORTED"), instead of
ERROR_CALL_NOT_IMPLEMENTED and a FIXME. GetCurrentUmsThread returns NULL.

Gate: test/kernel32-ums-gate.sh (64/32).
---
 dlls/kernel32/process.c | 62 ++++++++++++++++++++++++++++---------------------
 1 file changed, 35 insertions(+), 27 deletions(-)

diff --git a/dlls/kernel32/process.c b/dlls/kernel32/process.c
index 4a7369f..64c4e3f 100644
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -949,13 +949,21 @@ BOOL WINAPI GetProcessDEPPolicy(HANDLE process, LPDWORD flags, PBOOL permanent)
     return TRUE;
 }
 
+/* User-mode scheduling: "As of Windows 11, user-mode scheduling is not
+ * supported. All calls fail with the error ERROR_NOT_SUPPORTED." */
+#ifndef SG_MUTANT_UMS_NOTIMPL
+#define UMS_ERROR ERROR_NOT_SUPPORTED
+#else
+#define UMS_ERROR ERROR_CALL_NOT_IMPLEMENTED
+#endif
+
 /***********************************************************************
  *           CreateUmsCompletionList   (KERNEL32.@)
  */
 BOOL WINAPI CreateUmsCompletionList(PUMS_COMPLETION_LIST *list)
 {
-    FIXME( "%p: stub\n", list );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", list );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -964,8 +972,8 @@ BOOL WINAPI CreateUmsCompletionList(PUMS_COMPLETION_LIST *list)
  */
 BOOL WINAPI CreateUmsThreadContext(PUMS_CONTEXT *ctx)
 {
-    FIXME( "%p: stub\n", ctx );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", ctx );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -974,8 +982,8 @@ BOOL WINAPI CreateUmsThreadContext(PUMS_CONTEXT *ctx)
  */
 BOOL WINAPI DeleteUmsCompletionList(PUMS_COMPLETION_LIST list)
 {
-    FIXME( "%p: stub\n", list );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", list );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -984,8 +992,8 @@ BOOL WINAPI DeleteUmsCompletionList(PUMS_COMPLETION_LIST list)
  */
 BOOL WINAPI DeleteUmsThreadContext(PUMS_CONTEXT ctx)
 {
-    FIXME( "%p: stub\n", ctx );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", ctx );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -994,8 +1002,8 @@ BOOL WINAPI DeleteUmsThreadContext(PUMS_CONTEXT ctx)
  */
 BOOL WINAPI DequeueUmsCompletionListItems(void *list, DWORD timeout, PUMS_CONTEXT *ctx)
 {
-    FIXME( "%p,%08lx,%p: stub\n", list, timeout, ctx );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p,%08lx,%p\n", list, timeout, ctx );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -1004,8 +1012,8 @@ BOOL WINAPI DequeueUmsCompletionListItems(void *list, DWORD timeout, PUMS_CONTEX
  */
 BOOL WINAPI EnterUmsSchedulingMode(UMS_SCHEDULER_STARTUP_INFO *info)
 {
-    FIXME( "%p: stub\n", info );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", info );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -1014,8 +1022,8 @@ BOOL WINAPI EnterUmsSchedulingMode(UMS_SCHEDULER_STARTUP_INFO *info)
  */
 BOOL WINAPI ExecuteUmsThread(PUMS_CONTEXT ctx)
 {
-    FIXME( "%p: stub\n", ctx );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", ctx );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -1024,9 +1032,9 @@ BOOL WINAPI ExecuteUmsThread(PUMS_CONTEXT ctx)
  */
 PUMS_CONTEXT WINAPI GetCurrentUmsThread(void)
 {
-    FIXME( "stub\n" );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE( "\n" );
+    SetLastError( UMS_ERROR );
+    return NULL;
 }
 
 /***********************************************************************
@@ -1034,8 +1042,8 @@ PUMS_CONTEXT WINAPI GetCurrentUmsThread(void)
  */
 PUMS_CONTEXT WINAPI GetNextUmsListItem(PUMS_CONTEXT ctx)
 {
-    FIXME( "%p: stub\n", ctx );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", ctx );
+    SetLastError( UMS_ERROR );
     return NULL;
 }
 
@@ -1044,8 +1052,8 @@ PUMS_CONTEXT WINAPI GetNextUmsListItem(PUMS_CONTEXT ctx)
  */
 BOOL WINAPI GetUmsCompletionListEvent(PUMS_COMPLETION_LIST list, HANDLE *event)
 {
-    FIXME( "%p,%p: stub\n", list, event );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p,%p\n", list, event );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -1055,8 +1063,8 @@ BOOL WINAPI GetUmsCompletionListEvent(PUMS_COMPLETION_LIST list, HANDLE *event)
 BOOL WINAPI QueryUmsThreadInformation(PUMS_CONTEXT ctx, UMS_THREAD_INFO_CLASS class,
                                        void *buf, ULONG length, ULONG *ret_length)
 {
-    FIXME( "%p,%08x,%p,%08lx,%p: stub\n", ctx, class, buf, length, ret_length );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p,%08x,%p,%08lx,%p\n", ctx, class, buf, length, ret_length );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -1066,8 +1074,8 @@ BOOL WINAPI QueryUmsThreadInformation(PUMS_CONTEXT ctx, UMS_THREAD_INFO_CLASS cl
 BOOL WINAPI SetUmsThreadInformation(PUMS_CONTEXT ctx, UMS_THREAD_INFO_CLASS class,
                                      void *buf, ULONG length)
 {
-    FIXME( "%p,%08x,%p,%08lx: stub\n", ctx, class, buf, length );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p,%08x,%p,%08lx\n", ctx, class, buf, length );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
 
@@ -1076,7 +1084,7 @@ BOOL WINAPI SetUmsThreadInformation(PUMS_CONTEXT ctx, UMS_THREAD_INFO_CLASS clas
  */
 BOOL WINAPI UmsThreadYield(void *param)
 {
-    FIXME( "%p: stub\n", param );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "%p\n", param );
+    SetLastError( UMS_ERROR );
     return FALSE;
 }
