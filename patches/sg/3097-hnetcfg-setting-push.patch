From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 20:19:26 -0700
Subject: [PATCH] hnetcfg: push the firewall's obeyed profile settings through
 sg-admind at once

Stained Glass Firewall reads DoNotAllowExceptions, DefaultInboundAction,
DisableNotifications and IcmpSettings\AllowInboundEchoRequest of each
profile from system.reg, which reaches the disk late. A change (or a removal
by RestoreLocalFirewallDefaults) now also goes to it as
"firewall registry-push setting:PROFILE:NAME VALUE" (PROFILE domain, private
or public; no value when deleted), the way rules do.

diff --git a/dlls/hnetcfg/policy.c b/dlls/hnetcfg/policy.c
index 886595a..184609f 100644
--- a/dlls/hnetcfg/policy.c
+++ b/dlls/hnetcfg/policy.c
@@ -1669,6 +1669,32 @@ HRESULT fw_profile_value_get( const WCHAR *profile, const WCHAR *value, DWORD de
     return S_OK;
 }
 
+/* Stained Glass OS: the firewall obeys four of a profile's settings and reads them from the
+ * machine's registry file, which reaches the disk late; a change goes to it at once, like a rule
+ * does (setting:PROFILE:NAME, the decimal value, or none when the value is deleted). */
+static void firewall_setting_push( const WCHAR *profile, const WCHAR *value, BOOL set, DWORD data )
+{
+#ifndef SG_MUTANT_FW_SETTING_NOT_PUSHED
+    static const WCHAR *obeyed[] = { L"DoNotAllowExceptions", L"DefaultInboundAction", L"DisableNotifications",
+                                     L"IcmpSettings\\AllowInboundEchoRequest" };
+    const WCHAR *name, *short_name;
+    WCHAR id[128], text[16];
+    unsigned int i;
+
+    if (!wcsicmp( profile, L"DomainProfile" )) short_name = L"domain";
+    else if (!wcsicmp( profile, L"StandardProfile" )) short_name = L"private";
+    else if (!wcsicmp( profile, L"PublicProfile" )) short_name = L"public";
+    else return;
+    for (i = 0, name = NULL; i < ARRAY_SIZE(obeyed); i++)
+        if (!wcsicmp( value, obeyed[i] )) name = obeyed[i];
+    if (!name) return;
+
+    swprintf( id, ARRAY_SIZE(id), L"setting:%s:%s", short_name, name );
+    swprintf( text, ARRAY_SIZE(text), L"%lu", data );
+    firewall_push( id, set ? text : NULL );
+#endif
+}
+
 HRESULT fw_profile_value_set( const WCHAR *profile, const WCHAR *value, DWORD data )
 {
     WCHAR path[MAX_PATH];
@@ -1680,6 +1706,7 @@ HRESULT fw_profile_value_set( const WCHAR *profile, const WCHAR *value, DWORD da
         return HRESULT_FROM_WIN32( err );
     err = RegSetValueExW( key, value, 0, REG_DWORD, (BYTE *)&data, sizeof(data) );
     RegCloseKey( key );
+    if (!err) firewall_setting_push( profile, value, TRUE, data );
     return err ? HRESULT_FROM_WIN32( err ) : S_OK;
 }
 
@@ -2337,7 +2364,17 @@ static HRESULT WINAPI fwpolicy2_RestoreLocalFirewallDefaults(INetFwPolicy2 *ifac
             if (err == ERROR_ACCESS_DENIED) return E_ACCESSDENIED;
             continue;
         }
-        for (v = 0; v < ARRAY_SIZE(values); v++) RegDeleteValueW( key, values[v] );
+        for (v = 0; v < ARRAY_SIZE(values); v++)
+            if (!RegDeleteValueW( key, values[v] )) firewall_setting_push( profiles[k], values[v], FALSE, 0 );
+        {
+            HKEY icmp;
+            if (!RegOpenKeyExW( key, L"IcmpSettings", 0, KEY_SET_VALUE, &icmp ))
+            {
+                if (!RegDeleteValueW( icmp, L"AllowInboundEchoRequest" ))
+                    firewall_setting_push( profiles[k], L"IcmpSettings\\AllowInboundEchoRequest", FALSE, 0 );
+                RegCloseKey( icmp );
+            }
+        }
         RegCloseKey( key );
     }
     if (FAILED(hr = load_rules( &list, &n ))) return hr;
