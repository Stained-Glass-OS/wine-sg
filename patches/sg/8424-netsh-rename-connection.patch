     {
         if (argc >= 3 && is( argv[1], L"show" ) && is( argv[2], L"interface" )) return show_interfaces();
+        if (argc >= 3 && is( argv[1], L"set" ) && is( argv[2], L"interface" ))
+        {
+            int ret = set_interface( argc - 3, argv + 3 );
