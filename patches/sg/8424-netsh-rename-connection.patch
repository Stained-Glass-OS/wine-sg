From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netsh: interface set interface newname renames a connection

"netsh interface set interface name=... newname=..." renames a connection
(Control\Network\{Net}\{id}\Connection Name), as Windows does: OpenVPN names
the adapters it makes ("OpenVPN Wintun", ...) so and later removes them by
those names (i1014). Unknown name: "Element not found."; a name already taken
refused; without the right to write the machine's settings: the elevation
message. Was accepted and ignored.

Gate test/classdrv-gate.sh (rename); mutant SG_MUTANT_NETSH_NO_RENAME.
---
--- a/programs/netsh/netsh.c
+++ b/programs/netsh/netsh.c
@@ -317,6 +317,84 @@
     return 0;
 }
 
+/* ---- interface set interface (newname) --------------------------------- */
+
+/* Stained Glass OS (vpn2, i1014): a connection's name (Control\Network\{Net}\{id}\Connection
+ * Name), as Windows renames it: OpenVPN names the adapters it creates ("OpenVPN Wintun") this way */
+#define NET_CONNECTIONS L"System\\CurrentControlSet\\Control\\Network\\{4D36E972-E325-11CE-BFC1-08002BE10318}"
+
+/* the Connection key of the connection called name; KEY_SET_VALUE when write */
+static HKEY find_connection( const WCHAR *name, BOOL write, LONG *error )
+{
+    WCHAR sub[64], cur[256];
+    HKEY net, conn;
+    DWORD i, len, size;
+
+    *error = ERROR_NOT_FOUND;
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, NET_CONNECTIONS, 0, KEY_READ, &net )) return NULL;
+    for (i = 0;; i++)
+    {
+        len = ARRAY_SIZE(sub) - 12;
+        if (RegEnumKeyExW( net, i, sub, &len, NULL, NULL, NULL, NULL )) break;
+        lstrcatW( sub, L"\\Connection" );
+        if (RegOpenKeyExW( net, sub, 0, KEY_READ, &conn )) continue;
+        size = sizeof(cur);
+        if (!RegQueryValueExW( conn, L"Name", NULL, NULL, (BYTE *)cur, &size ) && !wcsicmp( cur, name ))
+        {
+            RegCloseKey( conn );
+            *error = write ? RegOpenKeyExW( net, sub, 0, KEY_READ | KEY_SET_VALUE, &conn ) : 0;
+            if (!write) RegOpenKeyExW( net, sub, 0, KEY_READ, &conn );
+            RegCloseKey( net );
+            return *error ? NULL : conn;
+        }
+        RegCloseKey( conn );
+    }
+    RegCloseKey( net );
+    return NULL;
+}
+
+static int set_interface( int argc, WCHAR **argv )
+{
+    static const WCHAR *const slots[] = { L"name", L"admin", L"connect", L"newname" };
+    struct params p;
+    const WCHAR *name, *newname;
+    HKEY key;
+    LONG err;
+
+    parse_params( argc, argv, slots, ARRAY_SIZE(slots), &p );
+    name = param( &p, 0 );
+    newname = param( &p, 3 );
+    if (!name || !newname) return -1;  /* admin=/connect= only: not ours */
+#ifdef SG_MUTANT_NETSH_NO_RENAME
+    return 0;
+#endif
+    if (!*newname || wcslen( newname ) > 255)
+    {
+        wprintf( L"The parameter is incorrect.\n\n" );
+        return 1;
+    }
+    if (wcsicmp( name, newname ) && (key = find_connection( newname, FALSE, &err )))
+    {
+        RegCloseKey( key );
+        wprintf( L"Cannot create a file when that file already exists.\n\n" );
+        return 1;
+    }
+    if (!(key = find_connection( name, TRUE, &err )))
+    {
+        if (err == ERROR_ACCESS_DENIED) wprintf( L"The requested operation requires elevation (Run as administrator).\n\n" );
+        else wprintf( L"Element not found.\n\n" );
+        return 1;
+    }
+    err = RegSetValueExW( key, L"Name", 0, REG_SZ, (const BYTE *)newname, (wcslen( newname ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    if (err == ERROR_ACCESS_DENIED)
+    {
+        wprintf( L"The requested operation requires elevation (Run as administrator).\n\n" );
+        return 1;
+    }
+    return err ? 1 : 0;
+}
+
