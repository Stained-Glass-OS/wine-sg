--- /dev/null
+++ b/dlls/rpcrt4/rpc_ss.c
@@ -0,0 +1,401 @@
+/*
+ * RPC stub memory management: RpcSs* / RpcSm* and the NDR helpers that use them
+ * (Stained Glass OS, wine-sg 8226)
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * A memory management environment belongs to a thread (or is shared through RpcSsSetThreadHandle): memory
+ * RpcSsAllocate takes from it is freed one block at a time by RpcSsFree or all at once by RpcSsDisableAllocate.
+ * Server stubs of procedures marked [enable_allocate] run their manager routine in one; client stubs allocate
+ * the out parameters of such procedures with the client allocator (RpcSsSetClientAllocFree).
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "rpc.h"
+#include "rpcndr.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rpc);
+
+struct ss_env
+{
+    CRITICAL_SECTION cs;
+    struct list blocks;
+};
+
+struct ss_block
+{
+    struct list entry;
+    struct ss_env *env;
+    /* the memory follows, aligned for any type */
+    union { double d; void *p; LONGLONG ll; } data[1];
+};
+
+struct ss_thread
+{
+    struct ss_env *env;
+    RPC_CLIENT_ALLOC *client_alloc;
+    RPC_CLIENT_FREE *client_free;
+};
+
+static DWORD ss_tls = TLS_OUT_OF_INDEXES;
+static INIT_ONCE ss_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI ss_init( INIT_ONCE *once, void *param, void **context )
+{
+    ss_tls = TlsAlloc();
+    return TRUE;
+}
+
+static struct ss_thread *ss_thread( BOOL create )
+{
+    struct ss_thread *thread;
+
+    InitOnceExecuteOnce( &ss_once, ss_init, NULL, NULL );
+    if (ss_tls == TLS_OUT_OF_INDEXES) return NULL;
+    if (!(thread = TlsGetValue( ss_tls )) && create && (thread = calloc( 1, sizeof(*thread) )))
+        TlsSetValue( ss_tls, thread );
+    return thread;
+}
+
+static void *__RPC_USER default_client_alloc( SIZE_T size )
+{
+    return HeapAlloc( GetProcessHeap(), 0, size );
+}
+
+static void __RPC_USER default_client_free( void *ptr )
+{
+    HeapFree( GetProcessHeap(), 0, ptr );
+}
+
+static RPC_STATUS ss_enable(void)
+{
+    struct ss_thread *thread = ss_thread( TRUE );
+    struct ss_env *env;
+
+#ifdef SG_MUTANT_NO_RPCSS_ALLOC
+    return RPC_S_CANNOT_SUPPORT;
+#endif
+    if (!thread) return RPC_S_OUT_OF_MEMORY;
+    if (thread->env) return RPC_S_OK;
+    if (!(env = calloc( 1, sizeof(*env) ))) return RPC_S_OUT_OF_MEMORY;
+    InitializeCriticalSectionEx( &env->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    env->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": ss_env.cs");
+    list_init( &env->blocks );
+    thread->env = env;
+    return RPC_S_OK;
+}
+
+static RPC_STATUS ss_disable(void)
+{
+    struct ss_thread *thread = ss_thread( FALSE );
+    struct ss_env *env;
+    struct ss_block *block, *next;
+
+    if (!thread || !(env = thread->env)) return RPC_S_OK;
+    thread->env = NULL;
+    LIST_FOR_EACH_ENTRY_SAFE( block, next, &env->blocks, struct ss_block, entry ) free( block );
+    env->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &env->cs );
+    free( env );
+    return RPC_S_OK;
+}
+
+/* memory from the thread's environment (one is set up when the thread has none: GUESS at what Windows does
+ * outside an enabled environment) */
+static void *ss_allocate( SIZE_T size, RPC_STATUS *status )
+{
+    struct ss_thread *thread;
+    struct ss_block *block;
+
+    *status = ss_enable();
+    if (*status) return NULL;
+    thread = ss_thread( FALSE );
+    if (!(block = malloc( offsetof(struct ss_block, data) + (size ? size : 1) )))
+    {
+        *status = RPC_S_OUT_OF_MEMORY;
+        return NULL;
+    }
+    block->env = thread->env;
+    EnterCriticalSection( &block->env->cs );
+    list_add_tail( &block->env->blocks, &block->entry );
+    LeaveCriticalSection( &block->env->cs );
+    return block->data;
+}
+
+static RPC_STATUS ss_free( void *ptr )
+{
+    struct ss_thread *thread = ss_thread( FALSE );
+    struct ss_block *block, *cur;
+    struct ss_env *env;
+
+    if (!ptr) return RPC_S_OK;
+    if (!thread || !(env = thread->env)) return RPC_S_INVALID_ARG;
+    block = CONTAINING_RECORD( ptr, struct ss_block, data );
+    EnterCriticalSection( &env->cs );
+    LIST_FOR_EACH_ENTRY( cur, &env->blocks, struct ss_block, entry )
+    {
+        if (cur != block) continue;
+        list_remove( &block->entry );
+        LeaveCriticalSection( &env->cs );
+        free( block );
+        return RPC_S_OK;
+    }
+    LeaveCriticalSection( &env->cs );
+    return RPC_S_INVALID_ARG;
+}
+
+/***********************************************************************
+ *             RpcSsAllocate [RPCRT4.@]
+ */
+void * WINAPI RpcSsAllocate( SIZE_T size )
+{
+    RPC_STATUS status;
+    void *ret = ss_allocate( size, &status );
+
+    TRACE( "%Iu -> %p\n", size, ret );
+    if (!ret) RpcRaiseException( status );
+    return ret;
+}
+
+/***********************************************************************
+ *             RpcSsFree [RPCRT4.@]
+ */
+void WINAPI RpcSsFree( void *ptr )
+{
+    TRACE( "%p\n", ptr );
+    ss_free( ptr );
+}
+
+/***********************************************************************
+ *             RpcSsEnableAllocate [RPCRT4.@]
+ */
+void WINAPI RpcSsEnableAllocate(void)
+{
+    RPC_STATUS status = ss_enable();
+    TRACE( "\n" );
+    if (status) RpcRaiseException( status );
+}
+
+/***********************************************************************
+ *             RpcSsDisableAllocate [RPCRT4.@]
+ */
+void WINAPI RpcSsDisableAllocate(void)
+{
+    TRACE( "\n" );
+    ss_disable();
+}
+
+/***********************************************************************
+ *             RpcSsGetThreadHandle [RPCRT4.@]
+ */
+RPC_SS_THREAD_HANDLE WINAPI RpcSsGetThreadHandle(void)
+{
+    struct ss_thread *thread = ss_thread( FALSE );
+    return thread ? thread->env : NULL;
+}
+
+/***********************************************************************
+ *             RpcSsSetThreadHandle [RPCRT4.@]
+ */
+void WINAPI RpcSsSetThreadHandle( RPC_SS_THREAD_HANDLE handle )
+{
+    struct ss_thread *thread = ss_thread( TRUE );
+    TRACE( "%p\n", handle );
+    if (!thread) RpcRaiseException( RPC_S_OUT_OF_MEMORY );
+    thread->env = handle;
+}
+
+/***********************************************************************
+ *             RpcSsSwapClientAllocFree [RPCRT4.@]
+ */
+void WINAPI RpcSsSwapClientAllocFree( RPC_CLIENT_ALLOC *alloc, RPC_CLIENT_FREE *free_fn, RPC_CLIENT_ALLOC **old_alloc,
+                                      RPC_CLIENT_FREE **old_free )
+{
+    struct ss_thread *thread = ss_thread( TRUE );
+
+    TRACE( "%p, %p, %p, %p\n", alloc, free_fn, old_alloc, old_free );
+    if (!thread) RpcRaiseException( RPC_S_OUT_OF_MEMORY );
+    if (old_alloc) *old_alloc = thread->client_alloc ? thread->client_alloc : default_client_alloc;
+    if (old_free) *old_free = thread->client_free ? thread->client_free : default_client_free;
+    thread->client_alloc = alloc;
+    thread->client_free = free_fn;
+}
+
+/***********************************************************************
+ *             RpcSsSetClientAllocFree [RPCRT4.@]
+ */
+void WINAPI RpcSsSetClientAllocFree( RPC_CLIENT_ALLOC *alloc, RPC_CLIENT_FREE *free_fn )
+{
+    RpcSsSwapClientAllocFree( alloc, free_fn, NULL, NULL );
+}
+
+/***********************************************************************
+ *             RpcSmAllocate [RPCRT4.@]
+ */
+void * WINAPI RpcSmAllocate( SIZE_T size, RPC_STATUS *status )
+{
+    RPC_STATUS st;
+    void *ret = ss_allocate( size, &st );
+    if (status) *status = st;
+    return ret;
+}
+
+/***********************************************************************
+ *             RpcSmFree [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmFree( void *ptr )
+{
+    return ss_free( ptr );
+}
+
+/***********************************************************************
+ *             RpcSmEnableAllocate [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmEnableAllocate(void)
+{
+    return ss_enable();
+}
+
+/***********************************************************************
+ *             RpcSmDisableAllocate [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmDisableAllocate(void)
+{
+    return ss_disable();
+}
+
+/***********************************************************************
+ *             RpcSmGetThreadHandle [RPCRT4.@]
+ */
+RPC_SS_THREAD_HANDLE WINAPI RpcSmGetThreadHandle( RPC_STATUS *status )
+{
+    if (status) *status = RPC_S_OK;
+    return RpcSsGetThreadHandle();
+}
+
+/***********************************************************************
+ *             RpcSmSetThreadHandle [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmSetThreadHandle( RPC_SS_THREAD_HANDLE handle )
+{
+    struct ss_thread *thread = ss_thread( TRUE );
+    if (!thread) return RPC_S_OUT_OF_MEMORY;
+    thread->env = handle;
+    return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcSmSwapClientAllocFree [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmSwapClientAllocFree( RPC_CLIENT_ALLOC *alloc, RPC_CLIENT_FREE *free_fn,
+                                            RPC_CLIENT_ALLOC **old_alloc, RPC_CLIENT_FREE **old_free )
+{
+    struct ss_thread *thread = ss_thread( TRUE );
+    if (!thread) return RPC_S_OUT_OF_MEMORY;
+    if (old_alloc) *old_alloc = thread->client_alloc ? thread->client_alloc : default_client_alloc;
+    if (old_free) *old_free = thread->client_free ? thread->client_free : default_client_free;
+    thread->client_alloc = alloc;
+    thread->client_free = free_fn;
+    return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcSmSetClientAllocFree [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmSetClientAllocFree( RPC_CLIENT_ALLOC *alloc, RPC_CLIENT_FREE *free_fn )
+{
+    return RpcSmSwapClientAllocFree( alloc, free_fn, NULL, NULL );
+}
+
+/***********************************************************************
+ *             NdrRpcSmClientAllocate [RPCRT4.@]
+ *
+ * The client stub's allocator for [enable_allocate] procedures: the one RpcSsSetClientAllocFree set, else the
+ * process heap.
+ */
+void * WINAPI NdrRpcSmClientAllocate( SIZE_T size )
+{
+    struct ss_thread *thread = ss_thread( FALSE );
+    if (thread && thread->client_alloc) return thread->client_alloc( size );
+    return default_client_alloc( size );
+}
+
+/***********************************************************************
+ *             NdrRpcSmClientFree [RPCRT4.@]
+ */
+void WINAPI NdrRpcSmClientFree( void *ptr )
+{
+    struct ss_thread *thread = ss_thread( FALSE );
+    if (thread && thread->client_free) thread->client_free( ptr );
+    else default_client_free( ptr );
+}
+
+/***********************************************************************
+ *             RpcSmClientFree [RPCRT4.@]
+ */
+RPC_STATUS WINAPI RpcSmClientFree( void *ptr )
+{
+    NdrRpcSmClientFree( ptr );
+    return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             NdrRpcSsDefaultAllocate [RPCRT4.@]
+ */
+void * WINAPI NdrRpcSsDefaultAllocate( SIZE_T size )
+{
+    return RpcSsAllocate( size );
+}
+
+/***********************************************************************
+ *             NdrRpcSsDefaultFree [RPCRT4.@]
+ */
+void WINAPI NdrRpcSsDefaultFree( void *ptr )
+{
+    RpcSsFree( ptr );
+}
+
+/***********************************************************************
+ *             NdrRpcSsEnableAllocate [RPCRT4.@]
+ *
+ * A server stub's manager routine runs in an environment; the stub allocates with it.
+ */
+void WINAPI NdrRpcSsEnableAllocate( PMIDL_STUB_MESSAGE msg )
+{
+    TRACE( "%p\n", msg );
+    RpcSsEnableAllocate();
+    msg->pfnAllocate = NdrRpcSsDefaultAllocate;
+    msg->pfnFree = NdrRpcSsDefaultFree;
+}
+
+/***********************************************************************
+ *             NdrRpcSsDisableAllocate [RPCRT4.@]
+ */
+void WINAPI NdrRpcSsDisableAllocate( PMIDL_STUB_MESSAGE msg )
+{
+    TRACE( "%p\n", msg );
+    RpcSsDisableAllocate();
+}
+
