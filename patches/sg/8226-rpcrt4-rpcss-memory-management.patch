-#if 0 /* these functions are not defined yet */
+#ifndef SG_MUTANT_NO_RPCSS_ALLOC
+    /* (wine-sg 8226) the client allocator of [enable_allocate] procedures, rpc_ss.c */
     pMessage->pfnAllocate = NdrRpcSmClientAllocate;
     pMessage->pfnFree = NdrRpcSmClientFree;
 #endif
@@ -1304,8 +1305,8 @@
 
     /* use alternate memory allocation routines */
     if (pProcHeader->Oi_flags & Oi_RPCSS_ALLOC_USED)
-#if 0
-          NdrRpcSsEnableAllocate(&stubMsg);
+#ifndef SG_MUTANT_NO_RPCSS_ALLOC
+          NdrRpcSsEnableAllocate(&stubMsg);   /* (wine-sg 8226) freed when the call ends */
 #else
           FIXME("Set RPCSS memory allocation routines\n");
 #endif
@@ -1498,6 +1499,12 @@
     if (pProcHeader->Oi_flags & Oi_FULL_PTR_USED)
         NdrFullPointerXlatFree(stubMsg.FullPtrXlatTables);
 
+#ifndef SG_MUTANT_NO_RPCSS_ALLOC
+    /* what the manager routine allocated with RpcSsAllocate */
+    if (pProcHeader->Oi_flags & Oi_RPCSS_ALLOC_USED)
+        NdrRpcSsDisableAllocate(&stubMsg);
+#endif
+
     /* free server function stack */
     free(args);
 
@@ -2058,13 +2065,10 @@
     if (pProcHeader->Oi_flags & Oi_FULL_PTR_USED)
         async_call_data->pStubMsg->FullPtrXlatTables = NdrFullPointerXlatInit(0, XLAT_SERVER);
 
-    /* use alternate memory allocation routines */
+    /* use alternate memory allocation routines: an asynchronous call may complete on another thread than the
+     * one it started on, and the RpcSs environment is a thread's (wine-sg 8226: not done here) */
     if (pProcHeader->Oi_flags & Oi_RPCSS_ALLOC_USED)
-#if 0
-          NdrRpcSsEnableAllocate(&stubMsg);
-#else
           FIXME("Set RPCSS memory allocation routines\n");
-#endif
 
     TRACE("allocating memory for stack of size %x\n", async_call_data->stack_size);
 
