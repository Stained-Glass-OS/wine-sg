+/* ---- operations that are done when they are made -------------------------- */
+
+#define DEFINE_DONE_OPERATION( name, op_type, handler_type, result_type, iid, addref_result, release_result ) \
+struct name                                                                                           \
+{                                                                                                     \
+    op_type op_type##_iface;                                                                          \
+    IAsyncInfo IAsyncInfo_iface;                                                                      \
+    LONG ref;                                                                                         \
+    result_type result;                                                                               \
+};                                                                                                    \
+static inline struct name *name##_from_op( op_type *iface )                                          \
+{                                                                                                     \
+    return CONTAINING_RECORD( iface, struct name, op_type##_iface );                                  \
+}                                                                                                     \
+static HRESULT WINAPI name##_QueryInterface( op_type *iface, REFIID riid, void **out )               \
+{                                                                                                     \
+    struct name *impl = name##_from_op( iface );                                                      \
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IInspectable ) ||               \
+        IsEqualGUID( riid, &IID_IAgileObject ) || IsEqualGUID( riid, iid ))                           \
+        *out = &impl->op_type##_iface;                                                                \
+    else if (IsEqualGUID( riid, &IID_IAsyncInfo ))                                                    \
+        *out = &impl->IAsyncInfo_iface;                                                               \
+    else                                                                                              \
+    {                                                                                                 \
+        *out = NULL;                                                                                  \
+        return E_NOINTERFACE;                                                                         \
+    }                                                                                                 \
+    IInspectable_AddRef( (IInspectable *)*out );                                                      \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static ULONG WINAPI name##_AddRef( op_type *iface )                                                  \
+{                                                                                                     \
+    return InterlockedIncrement( &name##_from_op( iface )->ref );                                     \
+}                                                                                                     \
+static ULONG WINAPI name##_Release( op_type *iface )                                                 \
+{                                                                                                     \
+    struct name *impl = name##_from_op( iface );                                                      \
+    ULONG ref = InterlockedDecrement( &impl->ref );                                                   \
+    if (!ref)                                                                                         \
+    {                                                                                                 \
+        release_result;                                                                               \
+        free( impl );                                                                                 \
+    }                                                                                                 \
+    return ref;                                                                                       \
+}                                                                                                     \
+static HRESULT WINAPI name##_GetIids( op_type *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI name##_GetRuntimeClassName( op_type *iface, HSTRING *class_name ) { return E_NOTIMPL; } \
+static HRESULT WINAPI name##_GetTrustLevel( op_type *iface, TrustLevel *level )                      \
+{                                                                                                     \
+    *level = BaseTrust;                                                                               \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static HRESULT WINAPI name##_put_Completed( op_type *iface, handler_type *handler )                  \
+{                                                                                                     \
+    if (handler) handler->lpVtbl->Invoke( handler, iface, Completed );                                \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static HRESULT WINAPI name##_get_Completed( op_type *iface, handler_type **handler )                 \
+{                                                                                                     \
+    *handler = NULL;                                                                                  \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static HRESULT WINAPI name##_GetResults( op_type *iface, result_type *results )                      \
+{                                                                                                     \
+    struct name *impl = name##_from_op( iface );                                                      \
+    *results = impl->result;                                                                          \
+    addref_result;                                                                                    \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static const struct op_type##Vtbl name##_vtbl =                                                       \
+{                                                                                                     \
+    name##_QueryInterface, name##_AddRef, name##_Release, name##_GetIids, name##_GetRuntimeClassName, \
+    name##_GetTrustLevel, name##_put_Completed, name##_get_Completed, name##_GetResults,              \
+};                                                                                                    \
+DEFINE_IINSPECTABLE_( name##_info, IAsyncInfo, struct name, name##_from_info, IAsyncInfo_iface,        \
+                      &impl->op_type##_iface )                                                        \
+static HRESULT WINAPI name##_info_get_Id( IAsyncInfo *iface, UINT32 *id ) { *id = 1; return S_OK; }  \
+static HRESULT WINAPI name##_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )                \
+{                                                                                                     \
+    *status = Completed;                                                                              \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static HRESULT WINAPI name##_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )                  \
+{                                                                                                     \
+    *error = S_OK;                                                                                    \
+    return S_OK;                                                                                      \
+}                                                                                                     \
+static HRESULT WINAPI name##_info_Cancel( IAsyncInfo *iface ) { return S_OK; }                        \
+static HRESULT WINAPI name##_info_Close( IAsyncInfo *iface ) { return S_OK; }                         \
+static const struct IAsyncInfoVtbl name##_info_vtbl =                                                 \
+{                                                                                                     \
+    name##_info_QueryInterface, name##_info_AddRef, name##_info_Release, name##_info_GetIids,         \
+    name##_info_GetRuntimeClassName, name##_info_GetTrustLevel, name##_info_get_Id,                   \
+    name##_info_get_Status, name##_info_get_ErrorCode, name##_info_Cancel, name##_info_Close,         \
+};                                                                                                    \
+static HRESULT name##_create( result_type result, op_type **out )                                    \
+{                                                                                                     \
+    struct name *impl = calloc( 1, sizeof(*impl) );                                                   \
+    if (!impl) return E_OUTOFMEMORY;                                                                  \
+    impl->op_type##_iface.lpVtbl = &name##_vtbl;                                                      \
+    impl->IAsyncInfo_iface.lpVtbl = &name##_info_vtbl;                                                \
+    impl->ref = 1;                                                                                    \
+    impl->result = result;                                                                            \
+    *out = &impl->op_type##_iface;                                                                    \
+    return S_OK;                                                                                      \
+}
