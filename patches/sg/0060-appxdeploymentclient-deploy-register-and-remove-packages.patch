+static HRESULT WINAPI list_get_Size( IVectorView_AppListEntry *iface, UINT32 *value )
+{
+    *value = impl_from_IVectorView_AppListEntry( iface )->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI list_IndexOf( IVectorView_AppListEntry *iface, IAppListEntry *element, UINT32 *index, boolean *found )
+{
+    struct entry_list *impl = impl_from_IVectorView_AppListEntry( iface );
+    for (*index = 0; *index < impl->count; (*index)++)
+        if (impl->entries[*index] == element) return (*found = TRUE), S_OK;
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI list_GetMany( IVectorView_AppListEntry *iface, UINT32 start, UINT32 size, IAppListEntry **items, UINT *count )
+{
+    struct entry_list *impl = impl_from_IVectorView_AppListEntry( iface );
+    UINT32 i;
+
+    for (i = 0; start + i < impl->count && i < size; i++) IAppListEntry_AddRef( (items[i] = impl->entries[start + i]) );
+    *count = i;
+    return S_OK;
+}
+
+static const struct IVectorView_AppListEntryVtbl list_vtbl =
+{
+    list_QueryInterface,
+    list_AddRef,
+    list_Release,
+    list_GetIids,
+    list_GetRuntimeClassName,
+    list_GetTrustLevel,
+    list_GetAt,
+    list_get_Size,
+    list_IndexOf,
+    list_GetMany,
+};
+
+/* The applications of the package at folder, from its AppxManifest.xml. */
+HRESULT app_list_entries_create( const WCHAR *folder, IAsyncOperation_IVectorView_AppListEntry **operation )
+{
+    IAppxManifestApplicationsEnumerator *apps = NULL;
+    IAppxManifestReader *manifest = NULL;
+    IAppxManifestApplication *app;
+    IAppxFactory *factory = NULL;
+    IStream *stream = NULL;
+    struct entry_list *list;
+    WCHAR path[MAX_PATH];
+    BOOL has_current;
+    HRESULT hr;
+
+    if (!(list = calloc( 1, sizeof(*list) ))) return E_OUTOFMEMORY;
+    list->IVectorView_AppListEntry_iface.lpVtbl = &list_vtbl;
+    list->ref = 1;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", folder );
+    if (SUCCEEDED(SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )) &&
+        SUCCEEDED(CoCreateInstance( &CLSID_AppxFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxFactory, (void **)&factory )) &&
+        SUCCEEDED(IAppxFactory_CreateManifestReader( factory, stream, &manifest )) &&
+        SUCCEEDED(IAppxManifestReader_GetApplications( manifest, &apps )))
+    {
+        while (SUCCEEDED(IAppxManifestApplicationsEnumerator_GetHasCurrent( apps, &has_current )) && has_current)
+        {
+            WCHAR *exe = NULL, *list_entry = NULL;
+            IAppListEntry **grown;
+            struct entry *entry;
+
+            if (FAILED(IAppxManifestApplicationsEnumerator_GetCurrent( apps, &app ))) break;
+            IAppxManifestApplication_GetStringValue( app, L"Executable", &exe );
+            IAppxManifestApplication_GetStringValue( app, L"AppListEntry", &list_entry );
+            if (exe && (!list_entry || wcsicmp( list_entry, L"none" )) && (entry = calloc( 1, sizeof(*entry) )))
+            {
+                size_t len = wcslen( folder ) + wcslen( exe ) + 2;
+                entry->IAppListEntry_iface.lpVtbl = &entry_vtbl;
+                entry->ref = 1;
+                entry->folder = wcsdup( folder );
+                if ((entry->exe = malloc( len * sizeof(WCHAR) ))) swprintf( entry->exe, len, L"%s\\%s", folder, exe );
+                if (entry->folder && entry->exe && (grown = realloc( list->entries, (list->count + 1) * sizeof(*grown) )))
+                {
+                    list->entries = grown;
+                    list->entries[list->count++] = &entry->IAppListEntry_iface;
+                }
+                else IAppListEntry_Release( &entry->IAppListEntry_iface );
+            }
+            CoTaskMemFree( exe );
+            CoTaskMemFree( list_entry );
+            IAppxManifestApplication_Release( app );
+            IAppxManifestApplicationsEnumerator_MoveNext( apps, &has_current );
+        }
+    }
+    else WARN( "cannot read %s\n", debugstr_w( path ) );
+    if (apps) IAppxManifestApplicationsEnumerator_Release( apps );
+    if (manifest) IAppxManifestReader_Release( manifest );
+    if (factory) IAppxFactory_Release( factory );
+    if (stream) IStream_Release( stream );
+
+    if (FAILED(hr = entries_op_create( &list->IVectorView_AppListEntry_iface, operation )))
+        IVectorView_AppListEntry_Release( &list->IVectorView_AppListEntry_iface );
+    return hr;
+}
