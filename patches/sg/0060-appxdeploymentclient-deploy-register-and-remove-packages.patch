+/* ---- an application ----------------------------------------------------------- */
+
+struct entry
+{
+    IAppListEntry IAppListEntry_iface;
+    LONG ref;
+    WCHAR *exe;       /* full path */
+    WCHAR *folder;    /* the package's folder */
+};
+
+static inline struct entry *impl_from_IAppListEntry( IAppListEntry *iface )
+{
+    return CONTAINING_RECORD( iface, struct entry, IAppListEntry_iface );
+}
+
+static HRESULT WINAPI entry_QueryInterface( IAppListEntry *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAppListEntry ))
+    {
+        *out = iface;
+        IAppListEntry_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI entry_AddRef( IAppListEntry *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppListEntry( iface )->ref );
+}
+
+static ULONG WINAPI entry_Release( IAppListEntry *iface )
+{
+    struct entry *impl = impl_from_IAppListEntry( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        free( impl->exe );
+        free( impl->folder );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI entry_GetIids( IAppListEntry *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI entry_GetRuntimeClassName( IAppListEntry *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI entry_GetTrustLevel( IAppListEntry *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI entry_get_DisplayInfo( IAppListEntry *iface, IAppDisplayInfo **value )
+{
+    FIXME( "iface %p: no display info\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI entry_LaunchAsync( IAppListEntry *iface, IAsyncOperation_boolean **operation )
+{
+    struct entry *impl = impl_from_IAppListEntry( iface );
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR *cmdline;
+    BOOL ok = FALSE;
+
+    TRACE( "iface %p, launching %s\n", iface, debugstr_w( impl->exe ) );
+    if ((cmdline = malloc( (wcslen( impl->exe ) + 3) * sizeof(WCHAR) )))
+    {
+        swprintf( cmdline, wcslen( impl->exe ) + 3, L"\"%s\"", impl->exe );
+        if ((ok = CreateProcessW( impl->exe, cmdline, NULL, NULL, FALSE, 0, NULL, impl->folder, &si, &pi )))
+        {
+            CloseHandle( pi.hThread );
+            CloseHandle( pi.hProcess );
+        }
+        else WARN( "cannot start %s: %lu\n", debugstr_w( impl->exe ), GetLastError() );
+        free( cmdline );
+    }
+    return launch_op_create( ok, operation );
+}
