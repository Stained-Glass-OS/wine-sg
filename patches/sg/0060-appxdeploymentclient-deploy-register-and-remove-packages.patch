+/* A file: URI as a DOS path; other schemes are not fetched. */
+static HRESULT uri_to_path( IUriRuntimeClass *uri, WCHAR *path, DWORD size )
+{
+    HSTRING str;
+    HRESULT hr;
+
+    if (!uri) return E_INVALIDARG;
+    if (FAILED(hr = IUriRuntimeClass_get_AbsoluteUri( uri, &str ))) return hr;
+    hr = PathCreateFromUrlW( WindowsGetStringRawBuffer( str, NULL ), path, &size, 0 );
+    TRACE( "%s -> %s\n", debugstr_hstring( str ), SUCCEEDED(hr) ? debugstr_w( path ) : "(not a file)" );
+    WindowsDeleteString( str );
+    return FAILED(hr) ? E_INVALIDARG : S_OK;
+}
