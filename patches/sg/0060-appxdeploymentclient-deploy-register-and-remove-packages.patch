+static void set_error( WCHAR **error_text, const WCHAR *text, const WCHAR *detail )
+{
+    size_t len = wcslen( text ) + (detail ? wcslen( detail ) + 3 : 0) + 1;
+
+    free( *error_text );
+    if ((*error_text = malloc( len * sizeof(WCHAR) )))
+    {
+        if (detail) swprintf( *error_text, len, L"%s: %s", text, detail );
+        else wcscpy( *error_text, text );
+    }
+}
+
+/* ---- the record ------------------------------------------------------------ */
+
+static WCHAR *reg_string( HKEY key, const WCHAR *name )
+{
+    DWORD size = 0;
+    WCHAR *value;
+
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ, NULL, NULL, &size )) return NULL;
+    if (!(value = malloc( size ))) return NULL;
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ, NULL, value, &size ))
+    {
+        free( value );
+        return NULL;
+    }
+    return value;
+}
+
+static void reg_set_string( HKEY key, const WCHAR *name, const WCHAR *value )
+{
+    if (value) RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)value, (wcslen( value ) + 1) * sizeof(WCHAR) );
+}
+
+static BOOL read_record( HKEY key, const WCHAR *full_name, struct package_record *rec )
+{
+    DWORD size, value;
+
+    memset( rec, 0, sizeof(*rec) );
+    rec->full_name = wcsdup( full_name );
+    rec->name = reg_string( key, L"Name" );
+    rec->publisher = reg_string( key, L"Publisher" );
+    rec->publisher_id = reg_string( key, L"PublisherId" );
+    rec->family_name = reg_string( key, L"FamilyName" );
+    rec->resource_id = reg_string( key, L"ResourceId" );
+    rec->install_location = reg_string( key, L"InstallLocation" );
+    rec->display_name = reg_string( key, L"DisplayName" );
+    rec->publisher_display_name = reg_string( key, L"PublisherDisplayName" );
+    rec->description = reg_string( key, L"Description" );
+    size = sizeof(rec->version);
+    RegGetValueW( key, NULL, L"Version", RRF_RT_REG_QWORD, NULL, &rec->version, &size );
+    size = sizeof(value);
+    if (!RegGetValueW( key, NULL, L"Architecture", RRF_RT_REG_DWORD, NULL, &value, &size )) rec->architecture = value;
+    size = sizeof(value);
+    if (!RegGetValueW( key, NULL, L"Framework", RRF_RT_REG_DWORD, NULL, &value, &size )) rec->framework = !!value;
+    size = sizeof(value);
+    if (!RegGetValueW( key, NULL, L"DevelopmentMode", RRF_RT_REG_DWORD, NULL, &value, &size )) rec->development_mode = !!value;
+    if (!rec->full_name || !rec->name || !rec->install_location)
+    {
+        package_record_free( rec );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static HRESULT write_record( const struct package_record *rec, const WCHAR *shortcuts, DWORD shortcuts_size )
+{
+    WCHAR path[MAX_PATH];
+    DWORD value;
+    HKEY key;
+    LSTATUS res;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, rec->full_name );
+    if ((res = RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( res );
+    reg_set_string( key, L"Name", rec->name );
+    reg_set_string( key, L"Publisher", rec->publisher );
+    reg_set_string( key, L"PublisherId", rec->publisher_id );
+    reg_set_string( key, L"FamilyName", rec->family_name );
+    reg_set_string( key, L"ResourceId", rec->resource_id );
+    reg_set_string( key, L"InstallLocation", rec->install_location );
+    reg_set_string( key, L"DisplayName", rec->display_name );
+    reg_set_string( key, L"PublisherDisplayName", rec->publisher_display_name );
+    reg_set_string( key, L"Description", rec->description );
+    RegSetValueExW( key, L"Version", 0, REG_QWORD, (const BYTE *)&rec->version, sizeof(rec->version) );
+    value = rec->architecture;
+    RegSetValueExW( key, L"Architecture", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+    value = rec->framework;
+    RegSetValueExW( key, L"Framework", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+    value = rec->development_mode;
+    RegSetValueExW( key, L"DevelopmentMode", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+    if (shortcuts) RegSetValueExW( key, L"Shortcuts", 0, REG_MULTI_SZ, (const BYTE *)shortcuts, shortcuts_size );
+    RegCloseKey( key );
+    return S_OK;
+}
+
+/* What the manifest says about the package: identity and properties. */
+static HRESULT record_from_manifest( IAppxManifestReader *manifest, struct package_record *rec )
+{
+    IAppxManifestPackageId *id;
+    IAppxManifestProperties *props;
+    APPX_PACKAGE_ARCHITECTURE arch;
+    WCHAR *str;
+    BOOL framework = FALSE;
+    HRESULT hr;
+
+    memset( rec, 0, sizeof(*rec) );
+    if (FAILED(hr = IAppxManifestReader_GetPackageId( manifest, &id ))) return hr;
+    str = NULL; IAppxManifestPackageId_GetName( id, &str ); rec->name = from_co( str );
+    str = NULL; IAppxManifestPackageId_GetPublisher( id, &str ); rec->publisher = from_co( str );
+    str = NULL; IAppxManifestPackageId_GetResourceId( id, &str ); rec->resource_id = from_co( str );
+    str = NULL; IAppxManifestPackageId_GetPackageFullName( id, &str ); rec->full_name = from_co( str );
+    str = NULL; IAppxManifestPackageId_GetPackageFamilyName( id, &str ); rec->family_name = from_co( str );
+    /* the publisher ID is the family name's part after the "_" */
+    if (rec->family_name && (str = wcsrchr( rec->family_name, '_' ))) rec->publisher_id = wcsdup( str + 1 );
+    IAppxManifestPackageId_GetVersion( id, &rec->version );
+    if (SUCCEEDED(IAppxManifestPackageId_GetArchitecture( id, &arch ))) rec->architecture = arch;
+    IAppxManifestPackageId_Release( id );
+
+    if (SUCCEEDED(IAppxManifestReader_GetProperties( manifest, &props )))
+    {
+        str = NULL; IAppxManifestProperties_GetStringValue( props, L"DisplayName", &str ); rec->display_name = from_co( str );
+        str = NULL; IAppxManifestProperties_GetStringValue( props, L"PublisherDisplayName", &str );
+        rec->publisher_display_name = from_co( str );
+        str = NULL; IAppxManifestProperties_GetStringValue( props, L"Description", &str ); rec->description = from_co( str );
+        if (SUCCEEDED(IAppxManifestProperties_GetBoolValue( props, L"Framework", &framework ))) rec->framework = framework;
+        IAppxManifestProperties_Release( props );
+    }
+    if (!rec->name || !rec->full_name)
+    {
+        package_record_free( rec );
+        return APPX_E_INVALID_MANIFEST;
+    }
+    return S_OK;
+}
+
+/* ---- Start menu shortcuts ---------------------------------------------------- */
+
+static void safe_file_name( WCHAR *name )
+{
+    for (; *name; name++) if (wcschr( L"\\/:*?\"<>|", *name ) || *name < 32) *name = '_';
+}
+
+/* A shortcut for each application with an entry in the app list; returns the
+ * shortcuts' paths as a REG_MULTI_SZ, for removal. */
+static WCHAR *create_shortcuts( IAppxManifestReader *manifest, const struct package_record *rec, DWORD *size )
+{
+    IAppxManifestApplicationsEnumerator *apps;
+    IAppxManifestApplication *app;
+    WCHAR programs[MAX_PATH], *list = NULL;
+    DWORD list_len = 0;
+    BOOL has_current;
+
+    *size = 0;
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_PROGRAMS | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, programs )))
+        return NULL;
+    if (FAILED(IAppxManifestReader_GetApplications( manifest, &apps ))) return NULL;
+
+    while (SUCCEEDED(IAppxManifestApplicationsEnumerator_GetHasCurrent( apps, &has_current )) && has_current)
+    {
+        WCHAR *exe = NULL, *display = NULL, *entry = NULL, name[MAX_PATH], target[MAX_PATH], link[MAX_PATH];
+        IShellLinkW *shell_link;
+        IPersistFile *file;
+
+        if (FAILED(IAppxManifestApplicationsEnumerator_GetCurrent( apps, &app ))) break;
+        IAppxManifestApplication_GetStringValue( app, L"Executable", &exe );
+        IAppxManifestApplication_GetStringValue( app, L"DisplayName", &display );
+        IAppxManifestApplication_GetStringValue( app, L"AppListEntry", &entry );
+
+        if (exe && (!entry || wcsicmp( entry, L"none" )))
+        {
+            /* a resource reference (ms-resource:) is not a name */
+            if (display && wcsnicmp( display, L"ms-resource:", 12 )) lstrcpynW( name, display, MAX_PATH );
+            else if (rec->display_name && wcsnicmp( rec->display_name, L"ms-resource:", 12 ))
+                lstrcpynW( name, rec->display_name, MAX_PATH );
+            else lstrcpynW( name, rec->name, MAX_PATH );
+            safe_file_name( name );
+            swprintf( target, ARRAY_SIZE(target), L"%s\\%s", rec->install_location, exe );
+            swprintf( link, ARRAY_SIZE(link), L"%s\\%s.lnk", programs, name );
+
+            if (SUCCEEDED(CoCreateInstance( &CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW,
+                                            (void **)&shell_link )))
+            {
+                IShellLinkW_SetPath( shell_link, target );
+                IShellLinkW_SetWorkingDirectory( shell_link, rec->install_location );
+                IShellLinkW_SetDescription( shell_link, name );
+                if (SUCCEEDED(IShellLinkW_QueryInterface( shell_link, &IID_IPersistFile, (void **)&file )))
+                {
+                    if (SUCCEEDED(IPersistFile_Save( file, link, TRUE )))
+                    {
+                        DWORD len = wcslen( link ) + 1;
+                        WCHAR *grown = realloc( list, (list_len + len + 1) * sizeof(WCHAR) );
+                        if (grown)
+                        {
+                            list = grown;
+                            wcscpy( list + list_len, link );
+                            list_len += len;
+                            list[list_len] = 0;
+                        }
+                        TRACE( "shortcut %s -> %s\n", debugstr_w( link ), debugstr_w( target ) );
+                    }
+                    IPersistFile_Release( file );
+                }
+                IShellLinkW_Release( shell_link );
+            }
+        }
+        CoTaskMemFree( exe );
+        CoTaskMemFree( display );
+        CoTaskMemFree( entry );
+        IAppxManifestApplication_Release( app );
+        IAppxManifestApplicationsEnumerator_MoveNext( apps, &has_current );
+    }
+    IAppxManifestApplicationsEnumerator_Release( apps );
+    if (list) *size = (list_len + 1) * sizeof(WCHAR);
+    return list;
+}
+
+/* ---- extraction -------------------------------------------------------------- */
+
+/* A name from the package, as a path under root: never absolute, never "..". */
+static BOOL payload_path( const WCHAR *root, const WCHAR *name, WCHAR *path, size_t size )
+{
+    const WCHAR *p = name, *start;
+
+    if (!name[0] || name[0] == '\\' || name[0] == '/' || wcschr( name, ':' )) return FALSE;
+    while (*p)
+    {
+        start = p;
+        while (*p && *p != '\\' && *p != '/') p++;
+        if (p - start == 0 || (p - start == 2 && start[0] == '.' && start[1] == '.') ||
+            (p - start == 1 && start[0] == '.')) return FALSE;
+        if (*p) p++;
+    }
+    if (swprintf( path, size, L"%s\\%s", root, name ) < 0) return FALSE;
+    for (p = path; *p; p++) if (*p == '/') *(WCHAR *)p = '\\';
+    return TRUE;
+}
+
+static HRESULT create_parent_dirs( WCHAR *path )
+{
+    WCHAR *p = wcsrchr( path, '\\' );
+    int res;
+
+    if (!p) return S_OK;
+    *p = 0;
+    res = SHCreateDirectoryExW( NULL, path, NULL );
+    *p = '\\';
+    return (res == ERROR_SUCCESS || res == ERROR_ALREADY_EXISTS || res == ERROR_FILE_EXISTS) ? S_OK : HRESULT_FROM_WIN32( res );
+}
+
+static HRESULT extract_file( IAppxFile *file, const WCHAR *root )
+{
+    WCHAR *name = NULL, path[MAX_PATH];
+    IStream *stream = NULL;
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    BYTE buffer[65536];
+    ULONG read;
+    DWORD written;
+    HRESULT hr;
+
+    if (FAILED(hr = IAppxFile_GetName( file, &name ))) return hr;
+    if (!payload_path( root, name, path, ARRAY_SIZE(path) ))
+    {
+        WARN( "refusing file name %s\n", debugstr_w( name ) );
+        CoTaskMemFree( name );
+        return APPX_E_CORRUPT_CONTENT;
+    }
+    CoTaskMemFree( name );
+    if (FAILED(hr = create_parent_dirs( path ))) return hr;
+    /* reading it checks it against the signed block map */
+    if (FAILED(hr = IAppxFile_GetStream( file, &stream ))) return hr;
+    handle = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (handle == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32( GetLastError() );
+    else
+    {
+        while (SUCCEEDED(hr = IStream_Read( stream, buffer, sizeof(buffer), &read )) && read)
+        {
+            if (!WriteFile( handle, buffer, read, &written, NULL ) || written != read)
+            {
+                hr = HRESULT_FROM_WIN32( GetLastError() );
+                break;
+            }
+        }
+        if (hr == S_FALSE) hr = S_OK;
+        CloseHandle( handle );
+        if (FAILED(hr)) DeleteFileW( path );
+    }
+    IStream_Release( stream );
+    return hr;
+}
+
+/* %ProgramFiles%\WindowsApps if this user may write it, else their own. */
+static HRESULT staging_root( WCHAR *root, size_t size )
+{
+    WCHAR probe[MAX_PATH];
+    HANDLE file;
+
+    if (SUCCEEDED(SHGetFolderPathW( NULL, CSIDL_PROGRAM_FILES, NULL, SHGFP_TYPE_CURRENT, root )) &&
+        wcslen( root ) + 13 < size)
+    {
+        wcscat( root, L"\\WindowsApps" );
+        SHCreateDirectoryExW( NULL, root, NULL );
+        swprintf( probe, ARRAY_SIZE(probe), L"%s\\.sg-probe-%lu", root, GetCurrentThreadId() );
+        file = CreateFileW( probe, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_FLAG_DELETE_ON_CLOSE, NULL );
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            CloseHandle( file );
+            return S_OK;
+        }
+    }
+    if (FAILED(SHGetFolderPathW( NULL, CSIDL_LOCAL_APPDATA | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, root )) ||
+        wcslen( root ) + 23 >= size)
+        return E_FAIL;
+    wcscat( root, L"\\Programs\\WindowsApps" );
+    SHCreateDirectoryExW( NULL, root, NULL );
+    return S_OK;
+}
+
+static HRESULT verify_signature( const WCHAR *path )
+{
+    GUID action = WINTRUST_ACTION_GENERIC_VERIFY_V2;
+    WINTRUST_FILE_INFO file = { sizeof(file) };
+    WINTRUST_DATA data = { sizeof(data) };
+    LONG status;
+
+    file.pcwszFilePath = path;
+    data.dwUIChoice = WTD_UI_NONE;
+    data.fdwRevocationChecks = WTD_REVOKE_NONE;
+    data.dwUnionChoice = WTD_CHOICE_FILE;
+    data.pFile = &file;
+    data.dwStateAction = WTD_STATEACTION_VERIFY;
+    status = WinVerifyTrust( INVALID_HANDLE_VALUE, &action, &data );
+    data.dwStateAction = WTD_STATEACTION_CLOSE;
+    WinVerifyTrust( INVALID_HANDLE_VALUE, &action, &data );
+    return status;
+}
+
+/* ---- AddPackageAsync: a package file -------------------------------------------- */
+
+HRESULT add_package_work( const WCHAR *path, DeploymentOptions options, WCHAR **error_text )
+{
+    struct package_record rec = { 0 };
+    IAppxFactory *factory = NULL;
+    IAppxPackageReader *reader = NULL;
+    IAppxManifestReader *manifest = NULL;
+    IAppxFilesEnumerator *files = NULL;
+    IAppxFile *file;
+    IStream *stream = NULL;
+    WCHAR root[MAX_PATH], *shortcuts = NULL;
+    DWORD shortcuts_size = 0;
+    BOOL has_current;
+    HRESULT hr;
+    int i;
+
+    TRACE( "path %s, options %#x\n", debugstr_w( path ), options );
+
+    if (FAILED(hr = SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+    {
+        set_error( error_text, L"The package file could not be opened", path );
+        return hr;
+    }
+    if (FAILED(hr = verify_signature( path )))
+    {
+        set_error( error_text, L"The package's signature is not trusted", NULL );
+        goto done;
+    }
+    if (FAILED(hr = CoCreateInstance( &CLSID_AppxFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxFactory, (void **)&factory )))
+        goto done;
+    if (FAILED(hr = IAppxFactory_CreatePackageReader( factory, stream, &reader )))
+    {
+        set_error( error_text, hr == APPX_E_MISSING_REQUIRED_FILE ? L"Bundles (.msixbundle, .appxbundle) are not supported yet"
+                                                                   : L"The package could not be read", NULL );
+        goto done;
+    }
+    if (FAILED(hr = IAppxPackageReader_GetManifest( reader, &manifest ))) goto done;
+    if (FAILED(hr = record_from_manifest( manifest, &rec )))
+    {
+        set_error( error_text, L"The package's manifest is invalid", NULL );
+        goto done;
+    }
+    if (FAILED(hr = staging_root( root, ARRAY_SIZE(root) ))) goto done;
+    if (!(rec.install_location = malloc( (wcslen( root ) + wcslen( rec.full_name ) + 2) * sizeof(WCHAR) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    swprintf( rec.install_location, wcslen( root ) + wcslen( rec.full_name ) + 2, L"%s\\%s", root, rec.full_name );
+    TRACE( "installing %s to %s\n", debugstr_w( rec.full_name ), debugstr_w( rec.install_location ) );
+
+    /* the payload, then the manifest, block map and signature beside it */
+    if (FAILED(hr = IAppxPackageReader_GetPayloadFiles( reader, &files ))) goto done;
+    while (SUCCEEDED(hr = IAppxFilesEnumerator_GetHasCurrent( files, &has_current )) && has_current)
+    {
+        if (FAILED(hr = IAppxFilesEnumerator_GetCurrent( files, &file ))) break;
+        hr = extract_file( file, rec.install_location );
+        IAppxFile_Release( file );
+        if (FAILED(hr)) break;
+        if (FAILED(hr = IAppxFilesEnumerator_MoveNext( files, &has_current ))) break;
+    }
+    if (FAILED(hr))
+    {
+        set_error( error_text, L"The package's files could not be installed", NULL );
+        goto done;
+    }
+    for (i = APPX_FOOTPRINT_FILE_TYPE_MANIFEST; i <= APPX_FOOTPRINT_FILE_TYPE_SIGNATURE; i++)
+    {
+        if (FAILED(IAppxPackageReader_GetFootprintFile( reader, i, &file ))) continue;
+        extract_file( file, rec.install_location );
+        IAppxFile_Release( file );
+    }
+
+    shortcuts = create_shortcuts( manifest, &rec, &shortcuts_size );
+    if (FAILED(hr = write_record( &rec, shortcuts, shortcuts_size )))
+        set_error( error_text, L"The package could not be registered", NULL );
+
+done:
+    free( shortcuts );
+    if (files) IAppxFilesEnumerator_Release( files );
+    if (manifest) IAppxManifestReader_Release( manifest );
+    if (reader) IAppxPackageReader_Release( reader );
+    if (factory) IAppxFactory_Release( factory );
+    if (stream) IStream_Release( stream );
+    package_record_free( &rec );
+    return hr;
+}
+
+/* ---- RegisterPackageAsync: a loose manifest, in development mode -------------------- */
+
+static BOOL development_mode_allowed(void)
+{
+    DWORD value = 0, size = sizeof(value);
+    return !RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\AppModelUnlock",
+                          L"AllowDevelopmentWithoutDevLicense", RRF_RT_REG_DWORD, NULL, &value, &size ) && value;
+}
+
+HRESULT register_package_work( const WCHAR *path, DeploymentOptions options, WCHAR **error_text )
+{
+    struct package_record rec = { 0 };
+    IAppxFactory *factory = NULL;
+    IAppxManifestReader *manifest = NULL;
+    IStream *stream = NULL;
+    WCHAR *shortcuts = NULL, *slash;
+    DWORD shortcuts_size = 0;
+    HRESULT hr;
+
+    TRACE( "path %s, options %#x\n", debugstr_w( path ), options );
+
+    if (!(options & DeploymentOptions_DevelopmentMode))
+    {
+        set_error( error_text, L"Only a manifest in development mode can be registered", NULL );
+        return E_NOTIMPL;
+    }
+    if (!development_mode_allowed())
+    {
+        set_error( error_text, L"Developer mode is not enabled", NULL );
+        return 0x80073cff; /* ERROR_INSTALL_POLICY_FAILURE */
+    }
+    if (FAILED(hr = SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+    {
+        set_error( error_text, L"The manifest could not be opened", path );
+        return hr;
+    }
+    if (FAILED(hr = CoCreateInstance( &CLSID_AppxFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxFactory, (void **)&factory )))
+        goto done;
+    if (FAILED(hr = IAppxFactory_CreateManifestReader( factory, stream, &manifest )) ||
+        FAILED(hr = record_from_manifest( manifest, &rec )))
+    {
+        set_error( error_text, L"The manifest is invalid", NULL );
+        goto done;
+    }
+    rec.development_mode = TRUE;
+    if (!(rec.install_location = wcsdup( path )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if ((slash = wcsrchr( rec.install_location, '\\' ))) *slash = 0;
+
+    shortcuts = create_shortcuts( manifest, &rec, &shortcuts_size );
+    if (FAILED(hr = write_record( &rec, shortcuts, shortcuts_size )))
+        set_error( error_text, L"The package could not be registered", NULL );
+
+done:
+    free( shortcuts );
+    if (manifest) IAppxManifestReader_Release( manifest );
+    if (factory) IAppxFactory_Release( factory );
+    if (stream) IStream_Release( stream );
+    package_record_free( &rec );
+    return hr;
+}
+
+/* ---- RemovePackageAsync ------------------------------------------------------------ */
+
+static void delete_tree( const WCHAR *dir )
+{
+    WCHAR *from;
+    size_t len = wcslen( dir );
+    SHFILEOPSTRUCTW op = { 0 };
+
+    /* double NUL-terminated */
+    if (!(from = calloc( len + 2, sizeof(WCHAR) ))) return;
+    memcpy( from, dir, len * sizeof(WCHAR) );
+    op.wFunc = FO_DELETE;
+    op.pFrom = from;
+    op.fFlags = FOF_NO_UI;
+    SHFileOperationW( &op );
+    free( from );
+}
+
+HRESULT remove_package_work( const WCHAR *full_name, DeploymentOptions options, WCHAR **error_text )
+{
+    struct package_record rec;
+    WCHAR path[MAX_PATH], *shortcuts, *p;
+    DWORD size = 0;
+    HKEY key;
+    LSTATUS res;
+
+    TRACE( "package %s\n", debugstr_w( full_name ) );
+
+    if (!full_name || wcschr( full_name, '\\' ))
+    {
+        set_error( error_text, L"Not a package full name", full_name );
+        return E_INVALIDARG;
+    }
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key ))
+    {
+        set_error( error_text, L"The package is not installed", full_name );
+        return 0x80073cf1; /* ERROR_PACKAGE_NOT_FOUND */
+    }
+    if (!RegGetValueW( key, NULL, L"Shortcuts", RRF_RT_REG_MULTI_SZ, NULL, NULL, &size ) &&
+        (shortcuts = malloc( size )))
+    {
+        if (!RegGetValueW( key, NULL, L"Shortcuts", RRF_RT_REG_MULTI_SZ, NULL, shortcuts, &size ))
+            for (p = shortcuts; *p; p += wcslen( p ) + 1) DeleteFileW( p );
+        free( shortcuts );
+    }
+    if (read_record( key, full_name, &rec ))
+    {
+        /* a development registration is the developer's own folder */
+        if (!rec.development_mode) delete_tree( rec.install_location );
+        package_record_free( &rec );
+    }
+    RegCloseKey( key );
+    if ((res = RegDeleteTreeW( HKEY_CURRENT_USER, path )) && res != ERROR_FILE_NOT_FOUND)
+        return HRESULT_FROM_WIN32( res );
+    return S_OK;
+}
+
+/* ---- queries --------------------------------------------------------------------- */
+
+static BOOL matches( const WCHAR *filter, const WCHAR *value )
+{
+    return !filter || !filter[0] || (value && !wcsicmp( filter, value ));
+}
+
+HRESULT deployed_packages( const WCHAR *user_sid, const WCHAR *name, const WCHAR *publisher,
+                           const WCHAR *family_name, IIterable_Package **out )
+{
+    IPackage **packages = NULL, **grown;
+    UINT32 count = 0, i;
+    WCHAR full_name[256];
+    DWORD len, index = 0;
+    HKEY root, key;
+    HRESULT hr;
+
+    TRACE( "user %s, name %s, publisher %s, family %s\n", debugstr_w( user_sid ), debugstr_w( name ),
+           debugstr_w( publisher ), debugstr_w( family_name ) );
+
+    if (user_sid && user_sid[0]) FIXME( "packages of user %s: the calling user's are listed\n", debugstr_w( user_sid ) );
+
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, packages_keyW, 0, KEY_READ, &root ))
+    {
+        while (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( root, index++, full_name, &len, NULL, NULL, NULL, NULL ))
+        {
+            struct package_record rec;
+            IPackage *package;
+
+            if (RegOpenKeyExW( root, full_name, 0, KEY_READ, &key )) continue;
+            if (read_record( key, full_name, &rec ))
+            {
+                if (matches( name, rec.name ) && matches( publisher, rec.publisher ) &&
+                    matches( family_name, rec.family_name ) && SUCCEEDED(package_create( &rec, &package )))
+                {
+                    if ((grown = realloc( packages, (count + 1) * sizeof(*packages) )))
+                    {
+                        packages = grown;
+                        packages[count++] = package;
+                    }
+                    else IPackage_Release( package );
+                }
+                package_record_free( &rec );
+            }
+            RegCloseKey( key );
+        }
+        RegCloseKey( root );
+    }
+
+    /* the list takes the packages */
+    if (FAILED(hr = package_list_create( packages, count, out )))
+    {
+        for (i = 0; i < count; i++) IPackage_Release( packages[i] );
+        free( packages );
+    }
+    return hr;
+}
+
+HRESULT deployed_package_by_full_name( const WCHAR *full_name, IPackage **out )
+{
+    struct package_record rec;
+    WCHAR path[MAX_PATH];
+    HRESULT hr = S_OK;
+    HKEY key;
+
+    *out = NULL;
+    if (!full_name || wcschr( full_name, '\\' )) return S_OK;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key )) return S_OK;
+    if (read_record( key, full_name, &rec ))
+    {
+        hr = package_create( &rec, out );
+        package_record_free( &rec );
+    }
+    RegCloseKey( key );
+    return hr;
+}
