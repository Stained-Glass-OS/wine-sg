+struct deployment_result
+{
+    IDeploymentResult IDeploymentResult_iface;
+    LONG ref;
+    HRESULT hr;
+    HSTRING error_text;
+    GUID activity_id;
+};
+
+static inline struct deployment_result *impl_from_IDeploymentResult( IDeploymentResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct deployment_result, IDeploymentResult_iface );
+}
+
+static HRESULT WINAPI result_QueryInterface( IDeploymentResult *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDeploymentResult ))
+    {
+        *out = iface;
+        IDeploymentResult_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI result_AddRef( IDeploymentResult *iface )
+{
+    return InterlockedIncrement( &impl_from_IDeploymentResult( iface )->ref );
+}
+
+static ULONG WINAPI result_Release( IDeploymentResult *iface )
+{
+    struct deployment_result *impl = impl_from_IDeploymentResult( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->error_text );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI result_GetIids( IDeploymentResult *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI result_GetRuntimeClassName( IDeploymentResult *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.Management.Deployment.DeploymentResult",
+                                wcslen( L"Windows.Management.Deployment.DeploymentResult" ), name );
+}
+
+static HRESULT WINAPI result_GetTrustLevel( IDeploymentResult *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI result_get_ErrorText( IDeploymentResult *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IDeploymentResult( iface )->error_text, value );
+}
+
+static HRESULT WINAPI result_get_ActivityId( IDeploymentResult *iface, GUID *value )
+{
+    *value = impl_from_IDeploymentResult( iface )->activity_id;
+    return S_OK;
+}
+
+static HRESULT WINAPI result_get_ExtendedErrorCode( IDeploymentResult *iface, HRESULT *value )
+{
+    *value = impl_from_IDeploymentResult( iface )->hr;
+    return S_OK;
+}
+
+static const struct IDeploymentResultVtbl result_vtbl =
+{
+    result_QueryInterface,
+    result_AddRef,
+    result_Release,
+    result_GetIids,
+    result_GetRuntimeClassName,
+    result_GetTrustLevel,
+    result_get_ErrorText,
+    result_get_ActivityId,
+    result_get_ExtendedErrorCode,
+};
+
+static IDeploymentResult *result_create( HRESULT hr, const WCHAR *error_text )
+{
+    struct deployment_result *impl = calloc( 1, sizeof(*impl) );
+
+    if (!impl) return NULL;
+    impl->IDeploymentResult_iface.lpVtbl = &result_vtbl;
+    impl->ref = 1;
+    impl->hr = hr;
+    if (error_text) WindowsCreateString( error_text, wcslen( error_text ), &impl->error_text );
+    CoCreateGuid( &impl->activity_id );
+    return &impl->IDeploymentResult_iface;
+}
+
+/* ---- the operation ------------------------------------------------------- */
+
+struct deploy_operation
+{
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress IAsyncOperationWithProgress_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    AsyncStatus status;
+    HRESULT hr;
+    IDeploymentResult *result;
+    IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress *completed;
+    IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress *progress;
+    deploy_work_func work;
+    WCHAR *arg;
+    DeploymentOptions options;
+};
+
+static inline struct deploy_operation *impl_from_IAsyncOperationWithProgress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface )
+{
+    return CONTAINING_RECORD( iface, struct deploy_operation, IAsyncOperationWithProgress_iface );
+}
+
+static HRESULT WINAPI op_QueryInterface( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, REFIID iid, void **out )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        *out = &impl->IAsyncInfo_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI op_AddRef( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncOperationWithProgress( iface )->ref );
+}
+
+static ULONG WINAPI op_Release( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->result) IDeploymentResult_Release( impl->result );
+        if (impl->completed) IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Release( impl->completed );
+        if (impl->progress) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Release( impl->progress );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl->arg );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_GetIids( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Progress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                       IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress *handler )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->progress) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Release( impl->progress );
+    if ((impl->progress = handler)) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( handler );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Progress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                       IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress **handler )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    EnterCriticalSection( &impl->cs );
+    if ((*handler = impl->progress)) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( *handler );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Completed( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress *handler )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+    AsyncStatus status;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->completed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    status = impl->status;
+    if (handler && status == Started)
+    {
+        impl->completed = handler;
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_AddRef( handler );
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    /* already done: the handler is called at once */
+    if (handler && status != Started)
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Invoke( handler, iface, status );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Completed( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress **handler )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    EnterCriticalSection( &impl->cs );
+    if ((*handler = impl->completed)) IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_AddRef( *handler );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, IDeploymentResult **results )
+{
+    struct deploy_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started) hr = E_ILLEGAL_METHOD_CALL;
+    else if (impl->status == Closed || !impl->result) hr = E_ILLEGAL_METHOD_CALL;
+    else IDeploymentResult_AddRef( (*results = impl->result) );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const struct IAsyncOperationWithProgress_DeploymentResult_DeploymentProgressVtbl op_vtbl =
+{
+    op_QueryInterface,
+    op_AddRef,
+    op_Release,
+    op_GetIids,
+    op_GetRuntimeClassName,
+    op_GetTrustLevel,
+    op_put_Progress,
+    op_get_Progress,
+    op_put_Completed,
+    op_get_Completed,
+    op_GetResults,
+};
+
+DEFINE_IINSPECTABLE( async_info, IAsyncInfo, struct deploy_operation, IAsyncOperationWithProgress_iface )
+
+static HRESULT WINAPI async_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct deploy_operation *impl = impl_from_IAsyncInfo( iface );
+
+    EnterCriticalSection( &impl->cs );
+    *status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )
+{
+    struct deploy_operation *impl = impl_from_IAsyncInfo( iface );
+
+    EnterCriticalSection( &impl->cs );
+    *error = impl->status == Error ? impl->hr : S_OK;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Cancel( IAsyncInfo *iface )
+{
+    /* a deployment in flight runs to its end */
+    FIXME( "iface %p: deployments are not cancelled\n", iface );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Close( IAsyncInfo *iface )
+{
+    struct deploy_operation *impl = impl_from_IAsyncInfo( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started) hr = E_ILLEGAL_STATE_CHANGE;
+    else impl->status = Closed;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const struct IAsyncInfoVtbl async_info_vtbl =
+{
+    async_info_QueryInterface,
+    async_info_AddRef,
+    async_info_Release,
+    async_info_GetIids,
+    async_info_GetRuntimeClassName,
+    async_info_GetTrustLevel,
+    async_info_get_Id,
+    async_info_get_Status,
+    async_info_get_ErrorCode,
+    async_info_Cancel,
+    async_info_Close,
+};
+
+static void CALLBACK deploy_worker( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct deploy_operation *impl = context;
+    IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress *completed;
+    IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress *progress;
+    DeploymentProgress done = { DeploymentProgressState_Processing, 100 };
+    WCHAR *error_text = NULL;
+    AsyncStatus status;
+    HRESULT hr;
+
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    hr = impl->work( impl->arg, impl->options, &error_text );
+    CoUninitialize();
+    TRACE( "%s -> %#lx %s\n", debugstr_w( impl->arg ), hr, debugstr_w( error_text ) );
+
+    EnterCriticalSection( &impl->cs );
+    impl->hr = hr;
+    impl->result = result_create( hr, error_text );
+    impl->status = status = SUCCEEDED(hr) ? Completed : Error;
+    if ((completed = impl->completed)) impl->completed = NULL;
+    if ((progress = impl->progress)) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( progress );
+    LeaveCriticalSection( &impl->cs );
+    free( error_text );
+
+    if (progress)
+    {
+        if (SUCCEEDED(hr)) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Invoke( progress, &impl->IAsyncOperationWithProgress_iface, done );
+        IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Release( progress );
+    }
+    if (completed)
+    {
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Invoke( completed, &impl->IAsyncOperationWithProgress_iface, status );
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Release( completed );
+    }
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress_Release( &impl->IAsyncOperationWithProgress_iface );
+}
+
+/* Start work( arg, options ) on the thread pool; its result is the operation's. */
+HRESULT deploy_operation_create( deploy_work_func work, const WCHAR *arg, DeploymentOptions options,
+                                 IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **out )
+{
+    struct deploy_operation *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncOperationWithProgress_iface.lpVtbl = &op_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &async_info_vtbl;
+    impl->ref = 2;  /* one for the caller, one for the worker */
+    impl->status = Started;
+    impl->work = work;
+    impl->options = options;
+    if (arg && !(impl->arg = wcsdup( arg )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": deploy_operation.cs");
+
+    if (!TrySubmitThreadpoolCallback( deploy_worker, impl, NULL ))
+    {
+        impl->ref = 1;
+        IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress_Release( &impl->IAsyncOperationWithProgress_iface );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    *out = &impl->IAsyncOperationWithProgress_iface;
+    return S_OK;
+}
