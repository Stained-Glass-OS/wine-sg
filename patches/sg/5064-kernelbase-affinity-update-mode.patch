From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Keep the process's affinity update mode.

SetProcessAffinityUpdateMode keeps the process's affinity update mode instead
of failing: off by default, PROCESS_AFFINITY_ENABLE_AUTO_UPDATE switches it
on, 0 switches it off, and once switched off it cannot be switched on again
(documented). It takes only GetCurrentProcess() and the one flag.
QueryProcessAffinityUpdateMode (a stub export) reports it for the current
process; Wine never changes a process's affinity on its own, so the mode only
records the process's choice.

Gate: test/kernelbase-affinityupdate-gate.sh.
---
 dlls/kernel32/kernel32.spec     |  2 +-
 dlls/kernelbase/kernelbase.spec |  2 +-
 dlls/kernelbase/process.c       | 55 ++++++++++++++++++++++++++++++++++++++---
 include/winbase.h               |  4 +++
 4 files changed, 58 insertions(+), 5 deletions(-)

diff --git a/dlls/kernel32/kernel32.spec b/dlls/kernel32/kernel32.spec
index 4345721..f12eba5 100644
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -1223,7 +1223,7 @@
 @ stub QueryOldestEventLogRecord
 @ stdcall -import QueryPerformanceCounter(ptr)
 @ stdcall -import QueryPerformanceFrequency(ptr)
-# @ stub QueryProcessAffinityUpdateMode
+@ stdcall -import QueryProcessAffinityUpdateMode(long ptr)
 @ stdcall -import QueryProcessCycleTime(long ptr)
 @ stdcall -import QueryThreadCycleTime(long ptr)
 # @ stub QueryThreadProfiling
diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
index 01a9a06..3505e03 100644
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -1247,7 +1247,7 @@
 # @ stub QueryOptionalDelayLoadedAPI
 @ stdcall QueryPerformanceCounter(ptr) ntdll.RtlQueryPerformanceCounter
 @ stdcall QueryPerformanceFrequency(ptr) ntdll.RtlQueryPerformanceFrequency
-@ stub QueryProcessAffinityUpdateMode
+@ stdcall QueryProcessAffinityUpdateMode(long ptr)
 @ stdcall QueryProcessCycleTime(long ptr)
 # @ stub QueryProtectedPolicy
 @ stub QuerySecurityAccessMask
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index 465e222..d17b9b0 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -1701,11 +1701,60 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetPriorityClass( HANDLE process, DWORD class )
 /***********************************************************************
  *           SetProcessAffinityUpdateMode   (kernelbase.@)
  */
+/* the process's affinity update mode: off until the process asks for it,
+ * and once it has switched it off it cannot switch it back on */
+static LONG affinity_update_mode;   /* 0 never set, 1 enabled, 2 disabled by a call */
+
 BOOL WINAPI DECLSPEC_HOTPATCH SetProcessAffinityUpdateMode( HANDLE process, DWORD flags )
 {
-    FIXME( "(%p,0x%08lx): stub\n", process, flags );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE( "(%p,0x%08lx)\n", process, flags );
+
+    if (process != GetCurrentProcess() || (flags & ~PROCESS_AFFINITY_ENABLE_AUTO_UPDATE))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!flags)
+    {
+        InterlockedExchange( &affinity_update_mode, 2 );
+        return TRUE;
+    }
+#ifndef SG_MUTANT_AFFINITY_NO_LATCH
+    if (InterlockedCompareExchange( &affinity_update_mode, 1, 0 ) == 2)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#else
+    affinity_update_mode = 1;
+#endif
+    return TRUE;
+}
+
+
+/***********************************************************************
+ *           QueryProcessAffinityUpdateMode   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH QueryProcessAffinityUpdateMode( HANDLE process, DWORD *flags )
+{
+    PROCESS_BASIC_INFORMATION pbi;
+
+    TRACE( "(%p,%p)\n", process, flags );
+
+    if (process != GetCurrentProcess())
+    {
+        if (!set_ntstatus( NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL )))
+            return FALSE;
+        if (pbi.UniqueProcessId != GetCurrentProcessId())
+        {
+            /* the mode is kept in each process; another one's is not known here */
+            FIXME( "process %p is not the current process\n", process );
+            SetLastError( ERROR_NOT_SUPPORTED );
+            return FALSE;
+        }
+    }
+    if (flags) *flags = affinity_update_mode == 1 ? PROCESS_AFFINITY_ENABLE_AUTO_UPDATE : 0;
+    return TRUE;
 }
 
 
diff --git a/include/winbase.h b/include/winbase.h
index c3bb908..c12114b 100644
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -1546,6 +1546,8 @@ typedef struct tagCOMMTIMEOUTS {
 
 #define PROCESS_NAME_NATIVE        1
 
+#define PROCESS_AFFINITY_ENABLE_AUTO_UPDATE 0x00000001
+
 typedef void (CALLBACK *PAPCFUNC)(ULONG_PTR);
 typedef void (CALLBACK *PTIMERAPCROUTINE)(LPVOID,DWORD,DWORD);
 
@@ -2770,6 +2772,7 @@ WINBASEAPI BOOL        WINAPI QueryInformationJobObject(HANDLE,JOBOBJECTINFOCLAS
 WINBASEAPI BOOL        WINAPI QueryMemoryResourceNotification(HANDLE,PBOOL);
 WINBASEAPI BOOL        WINAPI QueryPerformanceCounter(LARGE_INTEGER*);
 WINBASEAPI BOOL        WINAPI QueryPerformanceFrequency(LARGE_INTEGER*);
+WINBASEAPI BOOL        WINAPI QueryProcessAffinityUpdateMode(HANDLE,LPDWORD);
 WINBASEAPI BOOL        WINAPI QueryUmsThreadInformation(PUMS_CONTEXT,UMS_THREAD_INFO_CLASS,PVOID,ULONG,PULONG);
 WINBASEAPI DWORD       WINAPI QueueUserAPC(PAPCFUNC,HANDLE,ULONG_PTR);
 WINBASEAPI BOOL        WINAPI QueueUserWorkItem(LPTHREAD_START_ROUTINE,PVOID,ULONG);
@@ -2876,6 +2879,7 @@ WINBASEAPI BOOL        WINAPI SetPriorityClass(HANDLE,DWORD);
 WINADVAPI  BOOL        WINAPI SetPrivateObjectSecurity(SECURITY_INFORMATION,PSECURITY_DESCRIPTOR,PSECURITY_DESCRIPTOR*,PGENERIC_MAPPING,HANDLE);
 WINADVAPI  BOOL        WINAPI SetPrivateObjectSecurityEx(SECURITY_INFORMATION,PSECURITY_DESCRIPTOR,PSECURITY_DESCRIPTOR*,ULONG,PGENERIC_MAPPING,HANDLE);
 WINBASEAPI BOOL        WINAPI SetProcessAffinityMask(HANDLE,DWORD_PTR);
+WINBASEAPI BOOL        WINAPI SetProcessAffinityUpdateMode(HANDLE,DWORD);
 WINBASEAPI BOOL        WINAPI SetProcessInformation(HANDLE,PROCESS_INFORMATION_CLASS,LPVOID,DWORD);
 WINBASEAPI BOOL        WINAPI SetProcessPriorityBoost(HANDLE,BOOL);
 WINBASEAPI BOOL        WINAPI SetProcessShutdownParameters(DWORD,DWORD);
