+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "objbase.h"
+#include "oleauto.h"
+#include "ocidl.h"
+#include "olectl.h"
+
+#include "sapiddk.h"
+#include "sperror.h"
+
+#include "initguid.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+#include "sapi_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(sapi);
+
+DEFINE_GUID(DIID__ISpeechVoiceEvents, 0xa372acd1, 0x3bef, 0x4bbd, 0x8f, 0xfb, 0xcb, 0x3e, 0x2b, 0x41, 0x6a, 0xf8);
+
+#define WM_VOICE_EVENTS (WM_USER + 1)
+
+enum voice_event_dispid
+{
+    DISPID_SVEStreamStart = 1,
+    DISPID_SVEStreamEnd,
+    DISPID_SVEVoiceChange,
+    DISPID_SVEBookmark,
+    DISPID_SVEWord,
+    DISPID_SVEPhoneme,
+    DISPID_SVESentenceBoundary,
+    DISPID_SVEViseme,
+    DISPID_SVEAudioLevel,
+    DISPID_SVEEnginePrivate,
+};
+
+struct sink
+{
+    struct list entry;
+    DWORD cookie;
+    IDispatch *disp;
+};
+
+struct pending_event
+{
+    struct list entry;
+    SPEVENT event;
+};
+
+/* The sinks and the events waiting for them. The events are delivered by a
+ * window of the thread that made the voice, as clients of automation expect
+ * to be called from their own thread. */
+struct voice_dispatcher
+{
+    LONG ref;
+    CRITICAL_SECTION cs;
+    HWND hwnd;
+    DWORD next_cookie;
+    struct list sinks;
+    struct list pending;
+    BOOL posted;
+};
+
+struct connection_point
+{
+    IConnectionPoint IConnectionPoint_iface;
+    LONG ref;
+    struct voice_dispatcher *dispatcher;
+    IConnectionPointContainer *container;
+};
+
+static inline struct connection_point *impl_from_IConnectionPoint(IConnectionPoint *iface)
+{
+    return CONTAINING_RECORD(iface, struct connection_point, IConnectionPoint_iface);
+}
+
+static void dispatcher_addref(struct voice_dispatcher *d)
+{
+    InterlockedIncrement(&d->ref);
+}
+
+static void clear_event_param(SPEVENT *event)
+{
+    switch (event->elParamType)
+    {
+        case SPET_LPARAM_IS_TOKEN:
+        case SPET_LPARAM_IS_OBJECT:
+            if (event->lParam) IUnknown_Release((IUnknown *)event->lParam);
+            break;
+        case SPET_LPARAM_IS_POINTER:
+        case SPET_LPARAM_IS_STRING:
+            free((void *)event->lParam);
+            break;
+    }
+}
+
+static void dispatcher_release(struct voice_dispatcher *d)
+{
+    struct sink *sink, *next;
+    struct pending_event *pending, *next_pending;
+
+    if (InterlockedDecrement(&d->ref)) return;
+
+    LIST_FOR_EACH_ENTRY_SAFE(sink, next, &d->sinks, struct sink, entry)
+    {
+        list_remove(&sink->entry);
+        IDispatch_Release(sink->disp);
+        free(sink);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(pending, next_pending, &d->pending, struct pending_event, entry)
+    {
+        list_remove(&pending->entry);
+        clear_event_param(&pending->event);
+        free(pending);
+    }
+    DeleteCriticalSection(&d->cs);
+    free(d);
+}
+
+/* One invocation of a method of _ISpeechVoiceEvents on a sink. */
+static void invoke_sink(IDispatch *sink, DISPID id, VARIANT *args, UINT count)
+{
+    DISPPARAMS params = { args, NULL, count, 0 };
+    HRESULT hr = IDispatch_Invoke(sink, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &params, NULL, NULL, NULL);
+
+    if (FAILED(hr)) WARN("sink method %ld failed: %#lx.\n", id, hr);
+}
+
+static void init_position(VARIANT *var, ULONGLONG position)
+{
+    /* The position of a stream is a number that is an integer while it fits. */
+    if (position <= 0x7fffffff)
+    {
+        V_VT(var) = VT_I4;
+        V_I4(var) = position;
+    }
+    else
+    {
+        V_VT(var) = VT_R8;
+        V_R8(var) = (double)position;
+    }
+}
+
+static void init_i4(VARIANT *var, LONG value)
+{
+    V_VT(var) = VT_I4;
+    V_I4(var) = value;
+}
+
+static void init_i2(VARIANT *var, short value)
+{
+    V_VT(var) = VT_I2;
+    V_I2(var) = value;
+}
+
+static void deliver_event(IDispatch *sink, const SPEVENT *event)
+{
+    /* Arguments are given last first. */
+    VARIANT args[6];
+    BSTR bookmark = NULL;
+    IDispatch *token = NULL;
+
+    switch (event->eEventId)
+    {
+        case SPEI_START_INPUT_STREAM:
+        case SPEI_END_INPUT_STREAM:
+            init_position(&args[0], event->ullAudioStreamOffset);
+            init_i4(&args[1], event->ulStreamNum);
+            invoke_sink(sink, event->eEventId == SPEI_START_INPUT_STREAM ? DISPID_SVEStreamStart : DISPID_SVEStreamEnd, args, 2);
+            break;
+
+        case SPEI_VOICE_CHANGE:
+            if (event->elParamType == SPET_LPARAM_IS_TOKEN && event->lParam)
+                IUnknown_QueryInterface((IUnknown *)event->lParam, &IID_ISpeechObjectToken, (void **)&token);
+            V_VT(&args[0]) = VT_DISPATCH;
+            V_DISPATCH(&args[0]) = token;
+            init_position(&args[1], event->ullAudioStreamOffset);
+            init_i4(&args[2], event->ulStreamNum);
+            invoke_sink(sink, DISPID_SVEVoiceChange, args, 3);
+            if (token) IDispatch_Release(token);
+            break;
+
+        case SPEI_TTS_BOOKMARK:
+            init_i4(&args[0], event->wParam);
+            V_VT(&args[1]) = VT_BSTR;
+            V_BSTR(&args[1]) = bookmark = SysAllocString(event->elParamType == SPET_LPARAM_IS_STRING && event->lParam ?
+                                                         (const WCHAR *)event->lParam : L"");
+            init_position(&args[2], event->ullAudioStreamOffset);
+            init_i4(&args[3], event->ulStreamNum);
+            invoke_sink(sink, DISPID_SVEBookmark, args, 4);
+            SysFreeString(bookmark);
+            break;
+
+        case SPEI_WORD_BOUNDARY:
+        case SPEI_SENTENCE_BOUNDARY:
+            init_i4(&args[0], event->wParam);
+            init_i4(&args[1], event->lParam);
+            init_position(&args[2], event->ullAudioStreamOffset);
+            init_i4(&args[3], event->ulStreamNum);
+            invoke_sink(sink, event->eEventId == SPEI_WORD_BOUNDARY ? DISPID_SVEWord : DISPID_SVESentenceBoundary, args, 4);
+            break;
+
+        case SPEI_PHONEME:
+        case SPEI_VISEME:
+            /* The duration and the feature are in wParam, the next and the current id in lParam. */
+            if (event->eEventId == SPEI_PHONEME) init_i2(&args[0], HIWORD(event->lParam));
+            else init_i4(&args[0], HIWORD(event->lParam));
+            init_i4(&args[1], HIWORD(event->wParam));
+            if (event->eEventId == SPEI_PHONEME) init_i2(&args[2], LOWORD(event->lParam));
+            else init_i4(&args[2], LOWORD(event->lParam));
+            init_i2(&args[3], LOWORD(event->wParam));
+            init_position(&args[4], event->ullAudioStreamOffset);
+            init_i4(&args[5], event->ulStreamNum);
+            invoke_sink(sink, event->eEventId == SPEI_PHONEME ? DISPID_SVEPhoneme : DISPID_SVEViseme, args, 6);
+            break;
+
+        case SPEI_TTS_AUDIO_LEVEL:
+            init_i4(&args[0], event->wParam);
+            init_position(&args[1], event->ullAudioStreamOffset);
+            init_i4(&args[2], event->ulStreamNum);
+            invoke_sink(sink, DISPID_SVEAudioLevel, args, 3);
+            break;
+
+        default:
+            break;
+    }
+}
+
+static void deliver_pending(struct voice_dispatcher *d)
+{
+    struct list events = LIST_INIT(events);
+    struct pending_event *pending, *next;
+    struct sink *sink;
+
+    EnterCriticalSection(&d->cs);
+    list_move_tail(&events, &d->pending);
+    d->posted = FALSE;
+    LeaveCriticalSection(&d->cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(pending, next, &events, struct pending_event, entry)
+    {
+        IDispatch *sinks[16];
+        unsigned int count = 0, i;
+
+        /* A sink may disconnect or connect from its own method, so work on a copy. */
+        EnterCriticalSection(&d->cs);
+        LIST_FOR_EACH_ENTRY(sink, &d->sinks, struct sink, entry)
+        {
+            if (count == ARRAY_SIZE(sinks)) break;
+            IDispatch_AddRef(sinks[count++] = sink->disp);
+        }
+        LeaveCriticalSection(&d->cs);
+
+        for (i = 0; i < count; i++)
+        {
+            deliver_event(sinks[i], &pending->event);
+            IDispatch_Release(sinks[i]);
+        }
+
+        list_remove(&pending->entry);
+        clear_event_param(&pending->event);
+        free(pending);
+    }
+}
+
+static LRESULT CALLBACK dispatcher_wndproc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct voice_dispatcher *d = (struct voice_dispatcher *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+        case WM_NCCREATE:
+            d = ((CREATESTRUCTW *)lparam)->lpCreateParams;
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)d);
+            dispatcher_addref(d);
+            return TRUE;
+
+        case WM_VOICE_EVENTS:
+            if (d) deliver_pending(d);
+            return 0;
+
+        case WM_CLOSE:
+            DestroyWindow(hwnd);
+            return 0;
+
+        case WM_NCDESTROY:
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+            if (d)
+            {
+                BOOL owned;
+
+                EnterCriticalSection(&d->cs);
+                if ((owned = d->hwnd == hwnd)) d->hwnd = NULL;
+                LeaveCriticalSection(&d->cs);
+                if (owned) dispatcher_release(d);
+            }
+            break;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+static const WCHAR dispatcher_class[] = L"SAPIVoiceEvents";
+static INIT_ONCE class_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK register_class(INIT_ONCE *once, void *param, void **ctx)
+{
+    WNDCLASSW wc = { 0 };
+
+    wc.lpfnWndProc = dispatcher_wndproc;
+    wc.hInstance = sapi_instance;
+    wc.lpszClassName = dispatcher_class;
+    RegisterClassW(&wc);
+    return TRUE;
+}
+
+void voice_events_cleanup(void)
+{
+    UnregisterClassW(dispatcher_class, sapi_instance);
+}
+
+HRESULT voice_dispatcher_create(struct voice_dispatcher **ret)
+{
+    struct voice_dispatcher *d;
+
+    if (!(d = calloc(1, sizeof(*d)))) return E_OUTOFMEMORY;
+    d->ref = 1;
+    InitializeCriticalSection(&d->cs);
+    list_init(&d->sinks);
+    list_init(&d->pending);
+    d->next_cookie = 1;
+
+    InitOnceExecuteOnce(&class_once, register_class, NULL, NULL);
+    /* A message window of this thread: it gets the events to deliver. */
+    d->hwnd = CreateWindowExW(0, dispatcher_class, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, sapi_instance, d);
+    if (!d->hwnd) WARN("failed to create the event window: %lu.\n", GetLastError());
+
+    *ret = d;
+    return S_OK;
+}
+
+void voice_dispatcher_free(struct voice_dispatcher *d)
+{
+    HWND hwnd;
+
+    /* The window is closed by the thread that made it, at its next message. */
+    EnterCriticalSection(&d->cs);
+    hwnd = d->hwnd;
+    d->hwnd = NULL;
+    LeaveCriticalSection(&d->cs);
+    if (hwnd)
+    {
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+        PostMessageW(hwnd, WM_CLOSE, 0, 0);
+        /* the window's reference, which its destruction can no longer release */
+        dispatcher_release(d);
+    }
+    dispatcher_release(d);
+}
+
+/* Queues an event for the sinks, if there are any and the event is wanted. */
+void voice_dispatcher_post(struct voice_dispatcher *d, const SPEVENT *event, ULONGLONG interest)
+{
+    struct pending_event *pending;
+    BOOL post;
+
+#ifdef SG_MUTANT_SAPICP_INTEREST
+    interest = ~0ull;
+#endif
+    if (event->eEventId >= 64 || !(interest & (1ull << event->eEventId))) return;
+
+    EnterCriticalSection(&d->cs);
+    if (list_empty(&d->sinks) || !d->hwnd)
+    {
+        LeaveCriticalSection(&d->cs);
+        return;
+    }
+    LeaveCriticalSection(&d->cs);
+
+    if (!(pending = calloc(1, sizeof(*pending)))) return;
+    pending->event = *event;
+    switch (event->elParamType)
+    {
+        case SPET_LPARAM_IS_TOKEN:
+        case SPET_LPARAM_IS_OBJECT:
+            if (event->lParam) IUnknown_AddRef((IUnknown *)event->lParam);
+            break;
+        case SPET_LPARAM_IS_STRING:
+            pending->event.lParam = event->lParam ? (LPARAM)wcsdup((const WCHAR *)event->lParam) : 0;
+            break;
+        case SPET_LPARAM_IS_POINTER:
+            pending->event.lParam = 0;
+            pending->event.elParamType = SPET_LPARAM_IS_UNDEFINED;
+            break;
+    }
+
+    EnterCriticalSection(&d->cs);
+    list_add_tail(&d->pending, &pending->entry);
+    post = !d->posted;
+    d->posted = TRUE;
+    LeaveCriticalSection(&d->cs);
+
+#ifdef SG_MUTANT_SAPICP_DIRECT
+    deliver_pending(d);
+    return;
+#endif
+    if (post) PostMessageW(d->hwnd, WM_VOICE_EVENTS, 0, 0);
+}
+
+/* IConnectionPoint */
+static HRESULT WINAPI cp_QueryInterface(IConnectionPoint *iface, REFIID iid, void **obj)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+
+    TRACE("(%p, %s, %p).\n", iface, debugstr_guid(iid), obj);
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IConnectionPoint))
+        *obj = &This->IConnectionPoint_iface;
+    else
+    {
+        *obj = NULL;
+        WARN("interface %s not implemented.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
+
+static ULONG WINAPI cp_AddRef(IConnectionPoint *iface)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI cp_Release(IConnectionPoint *iface)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        dispatcher_release(This->dispatcher);
+        IConnectionPointContainer_Release(This->container);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI cp_GetConnectionInterface(IConnectionPoint *iface, IID *iid)
+{
+    TRACE("(%p, %p).\n", iface, iid);
+
+    if (!iid) return E_POINTER;
+    *iid = DIID__ISpeechVoiceEvents;
+    return S_OK;
+}
+
+static HRESULT WINAPI cp_GetConnectionPointContainer(IConnectionPoint *iface, IConnectionPointContainer **container)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+
+    TRACE("(%p, %p).\n", iface, container);
+
+    if (!container) return E_POINTER;
+    IConnectionPointContainer_AddRef(*container = This->container);
+    return S_OK;
+}
+
+static HRESULT WINAPI cp_Advise(IConnectionPoint *iface, IUnknown *unk, DWORD *cookie)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+    struct voice_dispatcher *d = This->dispatcher;
+    IDispatch *disp;
+    struct sink *sink;
+
+    TRACE("(%p, %p, %p).\n", iface, unk, cookie);
+
+    if (!unk || !cookie) return E_POINTER;
+
+    /* The sink is the dispinterface of the events, or any IDispatch. */
+    if (FAILED(IUnknown_QueryInterface(unk, &DIID__ISpeechVoiceEvents, (void **)&disp)) &&
+        FAILED(IUnknown_QueryInterface(unk, &IID_IDispatch, (void **)&disp)))
+    {
+#ifdef SG_MUTANT_SAPICP_ADVISE_ANY
+        *cookie = 99;
+        return S_OK;
+#endif
+        return CONNECT_E_CANNOTCONNECT;
+    }
+
+    if (!(sink = malloc(sizeof(*sink))))
+    {
+        IDispatch_Release(disp);
+        return E_OUTOFMEMORY;
+    }
+    sink->disp = disp;
+
+    EnterCriticalSection(&d->cs);
+    sink->cookie = *cookie = d->next_cookie++;
+#ifdef SG_MUTANT_SAPICP_COOKIE_SAME
+    sink->cookie = *cookie = 1;
+#endif
+    list_add_tail(&d->sinks, &sink->entry);
+    LeaveCriticalSection(&d->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI cp_Unadvise(IConnectionPoint *iface, DWORD cookie)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+    struct voice_dispatcher *d = This->dispatcher;
+    struct sink *sink;
+
+    TRACE("(%p, %lu).\n", iface, cookie);
+
+    EnterCriticalSection(&d->cs);
+    LIST_FOR_EACH_ENTRY(sink, &d->sinks, struct sink, entry)
+    {
+        if (sink->cookie == cookie)
+        {
+            list_remove(&sink->entry);
+            LeaveCriticalSection(&d->cs);
+            IDispatch_Release(sink->disp);
+            free(sink);
+            return S_OK;
+        }
+    }
+    LeaveCriticalSection(&d->cs);
+#ifdef SG_MUTANT_SAPICP_UNADVISE_ANY
+    return S_OK;
+#endif
+    return CONNECT_E_NOCONNECTION;
+}
+
+/* IEnumConnections over a snapshot of the sinks */
+struct enum_connections
+{
+    IEnumConnections IEnumConnections_iface;
+    LONG ref;
+    CONNECTDATA *data;
+    ULONG count, index;
+};
+
+static inline struct enum_connections *impl_from_IEnumConnections(IEnumConnections *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_connections, IEnumConnections_iface);
+}
+
+static HRESULT WINAPI enum_conn_QueryInterface(IEnumConnections *iface, REFIID iid, void **obj)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumConnections))
+        *obj = &This->IEnumConnections_iface;
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
+
+static ULONG WINAPI enum_conn_AddRef(IEnumConnections *iface)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI enum_conn_Release(IEnumConnections *iface)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        ULONG i;
+        for (i = 0; i < This->count; i++) IUnknown_Release(This->data[i].pUnk);
+        free(This->data);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_conn_Next(IEnumConnections *iface, ULONG count, CONNECTDATA *data, ULONG *fetched)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+    ULONG i;
+
+    TRACE("(%p, %lu, %p, %p).\n", iface, count, data, fetched);
+
+    if (!data || (!fetched && count != 1)) return E_POINTER;
+
+    for (i = 0; i < count && This->index < This->count; i++, This->index++)
+    {
+        data[i] = This->data[This->index];
+        IUnknown_AddRef(data[i].pUnk);
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_conn_Skip(IEnumConnections *iface, ULONG count)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+
+    TRACE("(%p, %lu).\n", iface, count);
+
+    if (count > This->count - min(This->index, This->count))
+    {
+        This->index = This->count;
+        return S_FALSE;
+    }
+    This->index += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conn_Reset(IEnumConnections *iface)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+
+    TRACE("(%p).\n", iface);
+
+    This->index = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conn_Clone(IEnumConnections *iface, IEnumConnections **ret);
+
+static const IEnumConnectionsVtbl enum_connections_vtbl =
+{
+    enum_conn_QueryInterface,
+    enum_conn_AddRef,
+    enum_conn_Release,
+    enum_conn_Next,
+    enum_conn_Skip,
+    enum_conn_Reset,
+    enum_conn_Clone,
+};
+
+static HRESULT create_enum_connections(CONNECTDATA *data, ULONG count, ULONG index, IEnumConnections **ret)
+{
+    struct enum_connections *obj;
+    ULONG i;
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    if (count && !(obj->data = malloc(count * sizeof(*data))))
+    {
+        free(obj);
+        return E_OUTOFMEMORY;
+    }
+    obj->IEnumConnections_iface.lpVtbl = &enum_connections_vtbl;
+    obj->ref = 1;
+    obj->count = count;
+    obj->index = index;
+    for (i = 0; i < count; i++)
+    {
+        obj->data[i] = data[i];
+        IUnknown_AddRef(obj->data[i].pUnk);
+    }
+    *ret = &obj->IEnumConnections_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_conn_Clone(IEnumConnections *iface, IEnumConnections **ret)
+{
+    struct enum_connections *This = impl_from_IEnumConnections(iface);
+
+    TRACE("(%p, %p).\n", iface, ret);
+
+    if (!ret) return E_POINTER;
+    return create_enum_connections(This->data, This->count, This->index, ret);
+}
+
+static HRESULT WINAPI cp_EnumConnections(IConnectionPoint *iface, IEnumConnections **ret)
+{
+    struct connection_point *This = impl_from_IConnectionPoint(iface);
+    struct voice_dispatcher *d = This->dispatcher;
+    CONNECTDATA *data = NULL;
+    struct sink *sink;
+    ULONG count = 0, i = 0;
+    HRESULT hr;
+
+    TRACE("(%p, %p).\n", iface, ret);
+
+    if (!ret) return E_POINTER;
+
+    EnterCriticalSection(&d->cs);
+    LIST_FOR_EACH_ENTRY(sink, &d->sinks, struct sink, entry) count++;
+    if (count && (data = malloc(count * sizeof(*data))))
+    {
+        LIST_FOR_EACH_ENTRY(sink, &d->sinks, struct sink, entry)
+        {
+            data[i].pUnk = (IUnknown *)sink->disp;
+            data[i++].dwCookie = sink->cookie;
+            IDispatch_AddRef(sink->disp);
+        }
+    }
+    LeaveCriticalSection(&d->cs);
+    if (count && !data) return E_OUTOFMEMORY;
+
+    hr = create_enum_connections(data, count, 0, ret);
+    for (i = 0; i < count; i++) IUnknown_Release(data[i].pUnk);
+    free(data);
+    return hr;
+}
+
+static const IConnectionPointVtbl cp_vtbl =
+{
+    cp_QueryInterface,
+    cp_AddRef,
+    cp_Release,
+    cp_GetConnectionInterface,
+    cp_GetConnectionPointContainer,
+    cp_Advise,
+    cp_Unadvise,
+    cp_EnumConnections,
+};
+
+static HRESULT create_connection_point(struct voice_dispatcher *d, IConnectionPointContainer *container,
+                                       IConnectionPoint **ret)
+{
+    struct connection_point *cp;
+
+    if (!(cp = calloc(1, sizeof(*cp)))) return E_OUTOFMEMORY;
+    cp->IConnectionPoint_iface.lpVtbl = &cp_vtbl;
+    cp->ref = 1;
+    dispatcher_addref(d);
+    cp->dispatcher = d;
+    IConnectionPointContainer_AddRef(cp->container = container);
+    *ret = &cp->IConnectionPoint_iface;
+    return S_OK;
+}
+
+HRESULT voice_find_connection_point(struct voice_dispatcher *d, IConnectionPointContainer *container,
+                                    REFIID iid, IConnectionPoint **cp)
+{
+    if (!cp) return E_POINTER;
+    *cp = NULL;
+    if (!IsEqualIID(iid, &DIID__ISpeechVoiceEvents)) return CONNECT_E_NOCONNECTION;
+    return create_connection_point(d, container, cp);
+}
+
+/* IEnumConnectionPoints over the one connection point of the voice */
+struct enum_cps
+{
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG ref;
+    IConnectionPoint *cp;
+    ULONG index;
+};
+
+static inline struct enum_cps *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_cps, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI enum_cps_QueryInterface(IEnumConnectionPoints *iface, REFIID iid, void **obj)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumConnectionPoints))
+        *obj = &This->IEnumConnectionPoints_iface;
+    else
+    {
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
+
+static ULONG WINAPI enum_cps_AddRef(IEnumConnectionPoints *iface)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI enum_cps_Release(IEnumConnectionPoints *iface)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IConnectionPoint_Release(This->cp);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_cps_Next(IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **cps, ULONG *fetched)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG i = 0;
+
+    TRACE("(%p, %lu, %p, %p).\n", iface, count, cps, fetched);
+
+    if (!cps || (!fetched && count != 1)) return E_POINTER;
+
+    if (count && !This->index)
+    {
+        IConnectionPoint_AddRef(cps[i++] = This->cp);
+        This->index = 1;
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_cps_Skip(IEnumConnectionPoints *iface, ULONG count)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p, %lu).\n", iface, count);
+
+    if (count > 1 - This->index)
+    {
+        This->index = 1;
+        return S_FALSE;
+    }
+    This->index += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_cps_Reset(IEnumConnectionPoints *iface)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p).\n", iface);
+
+    This->index = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_cps(IConnectionPoint *cp, ULONG index, IEnumConnectionPoints **ret);
+
+static HRESULT WINAPI enum_cps_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **ret)
+{
+    struct enum_cps *This = impl_from_IEnumConnectionPoints(iface);
+
+    TRACE("(%p, %p).\n", iface, ret);
+
+    if (!ret) return E_POINTER;
+    return create_enum_cps(This->cp, This->index, ret);
+}
+
+static const IEnumConnectionPointsVtbl enum_cps_vtbl =
+{
+    enum_cps_QueryInterface,
+    enum_cps_AddRef,
+    enum_cps_Release,
+    enum_cps_Next,
+    enum_cps_Skip,
+    enum_cps_Reset,
+    enum_cps_Clone,
+};
+
+static HRESULT create_enum_cps(IConnectionPoint *cp, ULONG index, IEnumConnectionPoints **ret)
+{
+    struct enum_cps *obj;
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IEnumConnectionPoints_iface.lpVtbl = &enum_cps_vtbl;
+    obj->ref = 1;
+    IConnectionPoint_AddRef(obj->cp = cp);
+    obj->index = index;
+    *ret = &obj->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+HRESULT voice_enum_connection_points(struct voice_dispatcher *d, IConnectionPointContainer *container,
+                                     IEnumConnectionPoints **ret)
+{
+    IConnectionPoint *cp;
+    HRESULT hr;
+
+    if (!ret) return E_POINTER;
+    if (FAILED(hr = create_connection_point(d, container, &cp))) return hr;
+    hr = create_enum_cps(cp, 0, ret);
+    IConnectionPoint_Release(cp);
+    return hr;
+}
