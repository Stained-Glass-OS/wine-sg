Date: Wed, 14 Oct 2026 20:56:33 -0700
Subject: [PATCH] ws2_32: WSAGetQOSByName checks its arguments (3279)

Returns FALSE with WSAENOTSOCK for a handle that is no socket and WSAEFAULT for NULL name or QOS pointers; a zero length name (the template list) succeeds, any other name is not a template (WSAEINVAL: GUESS). No QOS templates are defined.

diff --git a/dlls/ws2_32/socket.c b/dlls/ws2_32/socket.c
index 2e50c87..037b23f 100644
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -4479,7 +4479,27 @@ int WINAPI WSADuplicateSocketW( SOCKET s, DWORD dwProcessId, LPWSAPROTOCOL_INFOW
  */
 BOOL WINAPI WSAGetQOSByName( SOCKET s, WSABUF *name, QOS *qos )
 {
-    FIXME( "socket %#Ix, name %p, qos %p, stub!\n", s, name, qos );
+    int type, size = sizeof(type);
+
+    TRACE( "socket %#Ix, name %p, qos %p\n", s, name, qos );
+
+#ifdef SG_MUTANT_WSAQOS
+    return FALSE;
+#endif
+    if (getsockopt( s, SOL_SOCKET, SO_TYPE, (char *)&type, &size ) == SOCKET_ERROR)
+    {
+        /* getsockopt sets WSAENOTSOCK for a handle that is no socket */
+        return FALSE;
+    }
+    if (!name || !qos || (name->len && !name->buf))
+    {
+        SetLastError( WSAEFAULT );
+        return FALSE;
+    }
+    /* no QOS template is defined here: a zero length name lists none (an empty double-null list), any other
+     * name is not a template (GUESS for the error) */
+    if (!name->len) return TRUE;
+    SetLastError( WSAEINVAL );
     return FALSE;
 }
 
