+/* the value of "name" in a flat JSON object: a string, or the bare word of a number or boolean */
+static WCHAR *json_value( const WCHAR *json, const WCHAR *name )
+{
+    WCHAR key[64], *ret;
+    const WCHAR *p, *end;
+
+    swprintf( key, ARRAY_SIZE(key), L"\"%s\"", name );
+    if (!(p = wcsstr( json, key ))) return NULL;
+    p += wcslen( key );
+    while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
+    if (*p != ':') return NULL;
+    p++;
+    while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
+    if (*p == '"')
+    {
+        p++;
+        for (end = p; *end && *end != '"'; end++) if (*end == '\\' && end[1]) end++;
+    }
+    else for (end = p; *end && *end != ',' && *end != '}' && *end != ' ' && *end != '\n' && *end != '\r'; end++) ;
+    if (!(ret = malloc( (end - p + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, p, (end - p) * sizeof(WCHAR) );
+    ret[end - p] = 0;
+    return ret;
+}
