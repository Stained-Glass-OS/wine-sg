+/* "VENDOR - 1": the vendor's first word in capitals, as the BIOS version of a Windows machine reads */
+static WCHAR *get_bios_version_text( const char *buf, UINT len )
+{
+    WCHAR *vendor = get_bios_manufacturer( buf, len ), *p, *ret;
+    UINT size;
+
+    if (!vendor) return wcsdup( L"BIOS - 1" );
+    for (p = vendor; *p && *p != ' ' && *p != ','; p++) *p = towupper( *p );
+    *p = 0;
+    size = wcslen( vendor ) + 5;
+    if ((ret = malloc( size * sizeof(WCHAR) ))) swprintf( ret, size, L"%s - 1", vendor );
+    free( vendor );
+    return ret;
+}
