+/* the sizes of the second and third level caches of one package, in KB */
+static void get_cache_sizes( UINT packages, UINT32 *l2, UINT32 *l3 )
+{
+    SYSTEM_LOGICAL_PROCESSOR_INFORMATION *info;
+    DWORD size = 0, i, count;
+    UINT64 total2 = 0, total3 = 0;
+
+    *l2 = *l3 = 0;
+    if (GetLogicalProcessorInformation( NULL, &size ) || GetLastError() != ERROR_INSUFFICIENT_BUFFER) return;
+    if (!(info = malloc( size ))) return;
+    if (GetLogicalProcessorInformation( info, &size ))
+    {
+        count = size / sizeof(*info);
+        for (i = 0; i < count; i++)
+        {
+            if (info[i].Relationship != RelationCache) continue;
+            if (info[i].Cache.Level == 2) total2 += info[i].Cache.Size;
+            else if (info[i].Cache.Level == 3) total3 += info[i].Cache.Size;
+        }
+    }
+    free( info );
+    if (!packages) packages = 1;
+    *l2 = total2 / 1024 / packages;
+    *l3 = total3 / 1024 / packages;
+}
