+/* "ClamAV 1.4.3/27780/Fri Oct  3 08:24:01 2026": the days since the definitions were made, or -1 */
+static int definitions_age_days( const WCHAR *engine )
+{
+    static const WCHAR *months[] = { L"Jan", L"Feb", L"Mar", L"Apr", L"May", L"Jun", L"Jul", L"Aug", L"Sep", L"Oct", L"Nov", L"Dec" };
+    const WCHAR *p;
+    SYSTEMTIME st = {0}, now;
+    FILETIME a, b;
+    ULARGE_INTEGER ua, ub;
+    int i, day, hour, min, sec, year;
+    WCHAR mon[4];
+
+    if (!engine || !(p = wcsrchr( engine, '/' ))) return -1;
+    p++;
+    while (*p && *p != ' ') p++; /* the weekday */
+    while (*p == ' ') p++;
+    if (swscanf( p, L"%3ls %d %d:%d:%d %d", mon, &day, &hour, &min, &sec, &year ) != 6) return -1;
+    for (i = 0; i < 12; i++) if (!wcsicmp( mon, months[i] )) break;
+    if (i == 12) return -1;
+    st.wYear = year; st.wMonth = i + 1; st.wDay = day; st.wHour = hour; st.wMinute = min; st.wSecond = sec;
+    if (!SystemTimeToFileTime( &st, &a )) return -1;
+    GetSystemTime( &now );
+    SystemTimeToFileTime( &now, &b );
+    ua.LowPart = a.dwLowDateTime; ua.HighPart = a.dwHighDateTime;
+    ub.LowPart = b.dwLowDateTime; ub.HighPart = b.dwHighDateTime;
+    if (ub.QuadPart < ua.QuadPart) return 0;
+    return (ub.QuadPart - ua.QuadPart) / (10000000ULL * 86400);
+}
+
+static WCHAR *filetime_to_http_date( const FILETIME *ft )
+{
+    static const WCHAR *days[] = { L"Sun", L"Mon", L"Tue", L"Wed", L"Thu", L"Fri", L"Sat" };
+    static const WCHAR *months[] = { L"Jan", L"Feb", L"Mar", L"Apr", L"May", L"Jun", L"Jul", L"Aug", L"Sep", L"Oct", L"Nov", L"Dec" };
+    SYSTEMTIME st;
+    WCHAR *ret;
+
+    if (!FileTimeToSystemTime( ft, &st )) return wcsdup( L"" );
+    if (!(ret = malloc( 32 * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, 32, L"%s, %02u %s %04u %02u:%02u:%02u GMT", days[st.wDayOfWeek], st.wDay, months[st.wMonth - 1],
+              st.wYear, st.wHour, st.wMinute, st.wSecond );
+    return ret;
+}
+
+static BOOL get_defender_state( UINT32 *state, WCHAR **timestamp )
+{
+    WCHAR dir[MAX_PATH], path[MAX_PATH], *json, *enabled, *engine;
+    FILETIME mtime = {0};
+    int age;
+
+    if (!GetEnvironmentVariableW( L"SG_DEFENDER_DIR", dir, ARRAY_SIZE(dir) ))
+        wcscpy( dir, L"Z:\\var\\lib\\stained-glass\\defender" );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\status.json", dir );
+    if (!(json = read_small_file( path, &mtime, NULL ))) return FALSE;
+    enabled = json_value( json, L"enabled" );
+    engine = json_value( json, L"engine" );
+    if (!enabled || wcsicmp( enabled, L"true" )) *state = PRODUCT_STATE_OFF;
+    else
+    {
+        age = definitions_age_days( engine );
+        *state = (age > 7) ? PRODUCT_STATE_OUTOFDATE : PRODUCT_STATE_ON;
+    }
+    *timestamp = filetime_to_http_date( &mtime );
+    free( enabled ); free( engine ); free( json );
+    return TRUE;
+}
+
+static BOOL get_firewall_state( UINT32 *state )
+{
+    INetFwPolicy2 *policy;
+    VARIANT_BOOL on = VARIANT_FALSE;
+    NET_FW_PROFILE_TYPE2 profiles[] = { NET_FW_PROFILE2_DOMAIN, NET_FW_PROFILE2_PRIVATE, NET_FW_PROFILE2_PUBLIC };
+    HRESULT hr;
+    UINT i;
+    BOOL ok = FALSE;
+
+    hr = CoCreateInstance( &CLSID_NetFwPolicy2, NULL, CLSCTX_INPROC_SERVER, &IID_INetFwPolicy2, (void **)&policy );
+    if (FAILED(hr)) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(profiles); i++)
+    {
+        VARIANT_BOOL enabled = VARIANT_FALSE;
+
+        if (SUCCEEDED(INetFwPolicy2_get_FirewallEnabled( policy, profiles[i], &enabled )))
+        {
+            ok = TRUE;
+            if (enabled) on = VARIANT_TRUE;
+        }
+    }
+    INetFwPolicy2_Release( policy );
+    if (!ok) return FALSE;
+    *state = on ? PRODUCT_STATE_ON : PRODUCT_STATE_OFF;
+    return TRUE;
+}
+
+static enum fill_status fill_securityproduct( struct table *table, const struct expr *cond, const WCHAR *name,
+                                              const WCHAR *guid, BOOL firewall )
+{
+    struct record_securityproduct *rec;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    WCHAR *timestamp = NULL;
+    UINT32 state = 0;
+    UINT row = 0;
+
+    if (firewall)
+    {
+        if (!get_firewall_state( &state )) goto done;
+        timestamp = wcsdup( L"" );
+    }
+    else if (!get_defender_state( &state, &timestamp )) goto done;
+
+    if (!resize_table( table, 1, sizeof(*rec) )) { free( timestamp ); return FILL_STATUS_FAILED; }
+    rec = (struct record_securityproduct *)table->data;
+    rec->displayname              = wcsdup( name );
+    rec->instanceguid             = guid;
+    rec->pathtosignedproductexe   = L"";
+    rec->pathtosignedreportingexe = L"";
+    rec->productstate             = state;
+    rec->timestamp                = timestamp;
+    if (!match_row( table, row, cond, &status )) free_row_values( table, row );
+    else row++;
+
+done:
+    table->num_rows = row;
+    return status;
+}
+
+static enum fill_status fill_antivirusproduct( struct table *table, const struct expr *cond )
+{
+    return fill_securityproduct( table, cond, L"SG Defender", L"{D2BFC8E3-6D3A-4C59-9A4B-1E7B1F6C5A01}", FALSE );
+}
+
+static enum fill_status fill_antispywareproduct( struct table *table, const struct expr *cond )
+{
+    return fill_securityproduct( table, cond, L"SG Defender", L"{D2BFC8E3-6D3A-4C59-9A4B-1E7B1F6C5A01}", FALSE );
+}
+
+static enum fill_status fill_firewallproduct( struct table *table, const struct expr *cond )
+{
+    return fill_securityproduct( table, cond, L"SG Firewall", L"{7A1C0F42-5E8B-4D0E-8F63-2B9D4C71E802}", TRUE );
+}
