-static UINT64 get_available_virtual_memory(void)
+/* The commit limit is RAM plus swap; what is committed comes out of it. The part beyond RAM is the paging files. */
+static UINT64 get_total_commit(void)
+{
+    MEMORYSTATUSEX status;
+
+    status.dwLength = sizeof(status);
+    if (!GlobalMemoryStatusEx( &status )) return 1024 * 1024 * 1024;
+    return status.ullTotalPageFile;
+}
+static UINT64 get_available_commit(void)
 {
     MEMORYSTATUSEX status;
 
     status.dwLength = sizeof(status);
     if (!GlobalMemoryStatusEx( &status )) return 1024 * 1024 * 1024;
-    return status.ullAvailVirtual;
+    return status.ullAvailPageFile;
+}
+static UINT64 get_paging_total(void)
+{
+    MEMORYSTATUSEX status;
+
+    status.dwLength = sizeof(status);
+    if (!GlobalMemoryStatusEx( &status ) || status.ullTotalPageFile < status.ullTotalPhys) return 0;
+    return status.ullTotalPageFile - status.ullTotalPhys;
+}
+static UINT64 get_paging_free(void)
+{
