From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] fontsub: CreateFontPackage subsets the font

CreateFontPackage copied the whole source font. With TTFCFP_FLAGS_SUBSET it
now builds a working subset (TTFCFP_SUBSET): the kept characters (mapped
through the cmap subtable the platform and encoding name; formats 0, 4, 6 and
12) or glyph indices, glyph 0 and the components of kept composite glyphs
keep their indices and all other glyphs become empty; loca is rewritten in
the long format, DSIG is dropped, the table directory and checksums are
rebuilt. A TTC face is chosen by index. Font packages (TTFCFP_SUBSET1,
TTFCFP_DELTA) and CFF outlines are refused with ERR_GENERIC.
---
--- a/dlls/fontsub/main.c
+++ b/dlls/fontsub/main.c
@@ -17,6 +17,9 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
 #include "windef.h"
 #include "winbase.h"
 #include "fontsub.h"
@@ -25,26 +28,345 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(fontsub);
 
+#define TAG(a,b,c,d) (((DWORD)(a) << 24) | ((DWORD)(b) << 16) | ((DWORD)(c) << 8) | (DWORD)(d))
+
+static inline unsigned int be16(const unsigned char *p) { return (p[0] << 8) | p[1]; }
+static inline DWORD be32(const unsigned char *p) { return ((DWORD)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; }
+static inline void put16(unsigned char *p, unsigned int v) { p[0] = v >> 8; p[1] = v; }
+static inline void put32(unsigned char *p, DWORD v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+
+struct table
+{
+    DWORD tag;
+    const unsigned char *data;
+    DWORD length;
+    unsigned char *own;  /* data we built, if any */
+};
+
+struct font
+{
+    const unsigned char *src;
+    ULONG size;
+    struct table tables[40];
+    unsigned int count;
+};
+
+static const struct table *find_table(const struct font *font, DWORD tag)
+{
+    unsigned int i;
+    for (i = 0; i < font->count; i++) if (font->tables[i].tag == tag) return &font->tables[i];
+    return NULL;
+}
+
+static BOOL read_font(struct font *font, const unsigned char *src, ULONG size, BOOL ttc, unsigned int index)
+{
+    DWORD offset = 0, version;
+    unsigned int i, num_tables;
+
+    font->src = src;
+    font->size = size;
+    font->count = 0;
+    if (ttc)
+    {
+        if (size < 12 || be32(src) != TAG('t','t','c','f') || index >= be32(src + 8)) return FALSE;
+        if (12 + (index + 1) * 4 > size) return FALSE;
+        offset = be32(src + 12 + index * 4);
+    }
+    if (offset > size || size - offset < 12) return FALSE;
+    version = be32(src + offset);
+    if (version != 0x00010000 && version != TAG('t','r','u','e')) return FALSE;  /* no CFF outlines */
+    num_tables = be16(src + offset + 4);
+    if (num_tables > ARRAY_SIZE(font->tables) || offset + 12 + num_tables * 16 > size) return FALSE;
+    for (i = 0; i < num_tables; i++)
+    {
+        const unsigned char *rec = src + offset + 12 + i * 16;
+        DWORD pos = be32(rec + 8), len = be32(rec + 12);
+
+        if (pos > size || len > size - pos) return FALSE;
+        font->tables[font->count].tag = be32(rec);
+        font->tables[font->count].data = src + pos;
+        font->tables[font->count].length = len;
+        font->tables[font->count].own = NULL;
+        font->count++;
+    }
+    return TRUE;
+}
+
+static DWORD table_checksum(const unsigned char *data, DWORD length)
+{
+    DWORD sum = 0, i;
+    for (i = 0; i + 4 <= length; i += 4) sum += be32(data + i);
+    if (length & 3)
+    {
+        unsigned char tail[4] = {0};
+        memcpy(tail, data + (length & ~3), length & 3);
+        sum += be32(tail);
+    }
+    return sum;
+}
+
+/* glyph for a character in one cmap subtable, 0 if unmapped */
+static unsigned int cmap_lookup(const unsigned char *sub, DWORD len, DWORD ch)
+{
+    unsigned int format;
+
+    if (len < 6) return 0;
+    format = be16(sub);
+    switch (format)
+    {
+    case 0:
+        return ch < 256 && len >= 6 + 256 ? sub[6 + ch] : 0;
+    case 4:
+    {
+        unsigned int segs, i;
+        if (len < 16 || ch > 0xffff) return 0;
+        segs = be16(sub + 6) / 2;
+        if (16 + segs * 8 > len) return 0;
+        for (i = 0; i < segs; i++)
+        {
+            unsigned int end = be16(sub + 14 + i * 2);
+            unsigned int start = be16(sub + 16 + segs * 2 + i * 2);
+            unsigned int delta = be16(sub + 16 + segs * 4 + i * 2);
+            unsigned int range = be16(sub + 16 + segs * 6 + i * 2);
+
+            if (ch > end) continue;
+            if (ch < start) return 0;
+            if (!range) return (ch + delta) & 0xffff;
+            {
+                DWORD pos = 16 + segs * 6 + i * 2 + range + (ch - start) * 2;
+                unsigned int glyph;
+                if (pos + 2 > len) return 0;
+                glyph = be16(sub + pos);
+                return glyph ? (glyph + delta) & 0xffff : 0;
+            }
+        }
+        return 0;
+    }
+    case 6:
+    {
+        unsigned int first, count;
+        if (len < 10) return 0;
+        first = be16(sub + 6);
+        count = be16(sub + 8);
+        if (ch < first || ch >= first + count || 10 + (ch - first + 1) * 2 > len) return 0;
+        return be16(sub + 10 + (ch - first) * 2);
+    }
+    case 12:
+    {
+        DWORD groups, i;
+        if (len < 16) return 0;
+        groups = be32(sub + 12);
+        if (groups > (len - 16) / 12) return 0;
+        for (i = 0; i < groups; i++)
+        {
+            DWORD start = be32(sub + 16 + i * 12), end = be32(sub + 20 + i * 12);
+            if (ch >= start && ch <= end) return be32(sub + 24 + i * 12) + (ch - start);
+        }
+        return 0;
+    }
+    }
+    return 0;
+}
+
+static const unsigned char *find_cmap(const struct table *cmap, unsigned int platform, unsigned int encoding, DWORD *len)
+{
+    unsigned int i, count;
+
+    if (!cmap || cmap->length < 4) return NULL;
+    count = be16(cmap->data + 2);
+    if (4 + count * 8 > cmap->length) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        const unsigned char *rec = cmap->data + 4 + i * 8;
+        DWORD off = be32(rec + 4);
+
+        if (platform != 0xffff && be16(rec) != platform) continue;
+        if (encoding != TTFCFP_DONT_CARE && be16(rec + 2) != encoding) continue;
+        if (off >= cmap->length) continue;
+        *len = cmap->length - off;
+        return cmap->data + off;
+    }
+    return NULL;
+}
+
+static void keep_glyph(unsigned char *keep, unsigned int num_glyphs, unsigned int glyph,
+                       const unsigned char *glyf, DWORD glyf_len, const DWORD *loca, int depth)
+{
+    DWORD start, end;
+    const unsigned char *g;
+
+    if (glyph >= num_glyphs || keep[glyph]) return;
+    keep[glyph] = 1;
+    start = loca[glyph];
+    end = loca[glyph + 1];
+#ifdef SG_MUTANT_FONTSUB_NOCLOSURE
+    return;
+#endif
+    if (end <= start || end > glyf_len || end - start < 10 || depth > 16) return;
+    g = glyf + start;
+    if ((short)be16(g) >= 0) return;
+    /* composite: follow every component */
+    {
+        DWORD pos = 10;
+        unsigned int flags;
+
+        do
+        {
+            if (pos + 4 > end - start) return;
+            flags = be16(g + pos);
+            keep_glyph(keep, num_glyphs, be16(g + pos + 2), glyf, glyf_len, loca, depth + 1);
+            pos += 4 + ((flags & 1) ? 4 : 2);
+            if (flags & 0x8) pos += 2;
+            else if (flags & 0x40) pos += 4;
+            else if (flags & 0x80) pos += 8;
+        } while (flags & 0x20);
+    }
+}
+
+static int compare_tables(const void *a, const void *b)
+{
+    const struct table *ta = a, *tb = b;
+    return ta->tag < tb->tag ? -1 : ta->tag > tb->tag;
+}
+
 ULONG __cdecl CreateFontPackage(const unsigned char *src, const ULONG src_len, unsigned char **dest,
     ULONG *dest_len, ULONG *written, const unsigned short flags, const unsigned short face_index,
     const unsigned short format, const unsigned short lang, const unsigned short platform, const unsigned short encoding,
     const unsigned short *keep_list, const unsigned short keep_len, CFP_ALLOCPROC allocproc,
     CFP_REALLOCPROC reallocproc, CFP_FREEPROC freeproc, void *reserved)
 {
-    FIXME("(%p %lu %p %p %p %#x %u %u %u %u %u %p %u %p %p %p %p): stub\n", src, src_len, dest, dest_len,
+    struct font font;
+    struct table out[40];
+    const struct table *head, *maxp, *loca_t, *glyf_t, *cmap;
+    unsigned char *keep = NULL, *glyf_new = NULL, *loca_new = NULL, *result = NULL, *head_new = NULL;
+    DWORD *loca = NULL, glyf_size = 0, pos, total, sum, i;
+    unsigned int num_glyphs, num_out, loca_format;
+    ULONG ret = ERR_GENERIC;
+
+    TRACE("(%p %lu %p %p %p %#x %u %u %u %u %u %p %u %p %p %p %p)\n", src, src_len, dest, dest_len,
         written, flags, face_index, format, lang, platform, encoding, keep_list, keep_len, allocproc,
         reallocproc, freeproc, reserved);
 
-    if (format != TTFCFP_SUBSET)
-        return ERR_GENERIC;
+    if (!src || !dest || !dest_len || !written || !allocproc || !freeproc || reserved) return ERR_GENERIC;
+    if (format != TTFCFP_SUBSET) return ERR_GENERIC;  /* font packages (merge format) are not produced */
+
+    if (!(flags & TTFCFP_FLAGS_SUBSET))
+    {
+        /* nothing requested that we do (compression is a no-op, as in the documented version) */
+        if (!(*dest = allocproc(src_len))) return ERR_MEM;
+        memcpy(*dest, src, src_len);
+        *dest_len = *written = src_len;
+        return NO_ERROR;
+    }
+
+    if (!read_font(&font, src, src_len, flags & TTFCFP_FLAGS_TTC, face_index)) return ERR_GENERIC;
+    head = find_table(&font, TAG('h','e','a','d'));
+    maxp = find_table(&font, TAG('m','a','x','p'));
+    loca_t = find_table(&font, TAG('l','o','c','a'));
+    glyf_t = find_table(&font, TAG('g','l','y','f'));
+    cmap = find_table(&font, TAG('c','m','a','p'));
+    if (!head || !maxp || !loca_t || !glyf_t || head->length < 54 || maxp->length < 6) return ERR_GENERIC;
+    num_glyphs = be16(maxp->data + 4);
+    loca_format = be16(head->data + 50);
+    if (!num_glyphs || loca_format > 1 || loca_t->length < (num_glyphs + 1) * (loca_format ? 4 : 2)) return ERR_GENERIC;
+
+    keep = calloc(num_glyphs, 1);
+    loca = malloc((num_glyphs + 1) * sizeof(*loca));
+    if (!keep || !loca) { ret = ERR_MEM; goto done; }
+    for (i = 0; i <= num_glyphs; i++)
+        loca[i] = loca_format ? be32(loca_t->data + i * 4) : be16(loca_t->data + i * 2) * 2;
+    for (i = 0; i < num_glyphs; i++) if (loca[i] > loca[i + 1] || loca[i + 1] > glyf_t->length) loca[i + 1] = loca[i];
+
+    keep_glyph(keep, num_glyphs, 0, glyf_t->data, glyf_t->length, loca, 0);
+    if (flags & TTFCFP_FLAGS_GLYPHLIST)
+    {
+        for (i = 0; i < keep_len; i++)
+            keep_glyph(keep, num_glyphs, keep_list[i], glyf_t->data, glyf_t->length, loca, 0);
+    }
+    else if (keep_len)
+    {
+        DWORD cmap_len = 0;
+        const unsigned char *sub = find_cmap(cmap, platform, encoding, &cmap_len);
+
+        if (!sub) goto done;
+        for (i = 0; i < keep_len; i++)
+            keep_glyph(keep, num_glyphs, cmap_lookup(sub, cmap_len, keep_list[i]), glyf_t->data, glyf_t->length,
+                       loca, 0);
+    }
+
+    /* the glyphs keep their indices; the ones not kept become empty */
+    for (i = 0; i < num_glyphs; i++) if (keep[i]) glyf_size += (loca[i + 1] - loca[i] + 3) & ~3u;
+    glyf_new = calloc(1, glyf_size + 4);
+    loca_new = calloc(num_glyphs + 1, 4);
+    head_new = malloc(head->length);
+    if (!glyf_new || !loca_new || !head_new) { ret = ERR_MEM; goto done; }
+    for (i = 0, pos = 0; i < num_glyphs; i++)
+    {
+        put32(loca_new + i * 4, pos);
+        if (!keep[i]) continue;
+        memcpy(glyf_new + pos, glyf_t->data + loca[i], loca[i + 1] - loca[i]);
+        pos += (loca[i + 1] - loca[i] + 3) & ~3u;
+    }
+    put32(loca_new + num_glyphs * 4, pos);
+    memcpy(head_new, head->data, head->length);
+    put32(head_new + 8, 0);  /* checkSumAdjustment, set below */
+    put16(head_new + 50, 1);
+
+    for (i = 0, num_out = 0; i < font.count; i++)
+    {
+        const struct table *t = &font.tables[i];
 
-    *dest = allocproc(src_len);
-    if (!*dest)
-        return ERR_MEM;
+        if (t->tag == TAG('D','S','I','G')) continue;  /* the signature no longer matches */
+        out[num_out] = *t;
+        if (t->tag == TAG('g','l','y','f')) { out[num_out].data = glyf_new; out[num_out].length = pos; }
+        else if (t->tag == TAG('l','o','c','a')) { out[num_out].data = loca_new; out[num_out].length = (num_glyphs + 1) * 4; }
+        else if (t->tag == TAG('h','e','a','d')) out[num_out].data = head_new;
+        num_out++;
+    }
+    qsort(out, num_out, sizeof(*out), compare_tables);
 
-    memcpy(*dest, src, src_len);
-    *dest_len = src_len;
-    *written = src_len;
+    total = 12 + num_out * 16;
+    for (i = 0; i < num_out; i++) total += (out[i].length + 3) & ~3u;
+    if (!(result = allocproc(total))) { ret = ERR_MEM; goto done; }
+    memset(result, 0, total);
+    put32(result, 0x00010000);
+    put16(result + 4, num_out);
+    {
+        unsigned int search = 1, entry = 0;
+        while (search * 2 <= num_out) { search *= 2; entry++; }
+        put16(result + 6, search * 16);
+        put16(result + 8, entry);
+        put16(result + 10, num_out * 16 - search * 16);
+    }
+    for (i = 0, pos = 12 + num_out * 16; i < num_out; i++)
+    {
+        unsigned char *rec = result + 12 + i * 16;
+        put32(rec, out[i].tag);
+        put32(rec + 4, table_checksum(out[i].data, out[i].length));
+        put32(rec + 8, pos);
+        put32(rec + 12, out[i].length);
+        memcpy(result + pos, out[i].data, out[i].length);
+        pos += (out[i].length + 3) & ~3u;
+    }
+    /* the head table's checkSumAdjustment makes the whole file sum to 0xb1b0afba */
+    sum = table_checksum(result, total);
+    for (i = 0; i < num_out; i++)
+    {
+        if (out[i].tag != TAG('h','e','a','d')) continue;
+        pos = be32(result + 12 + i * 16 + 8);
+        put32(result + pos + 8, 0xb1b0afba - sum);
+    }
+    *dest = result;
+    *dest_len = *written = total;
+    result = NULL;
+    ret = NO_ERROR;
 
-    return NO_ERROR;
+done:
+    if (result) freeproc(result);
+    free(keep);
+    free(loca);
+    free(glyf_new);
+    free(loca_new);
+    free(head_new);
+    return ret;
 }
