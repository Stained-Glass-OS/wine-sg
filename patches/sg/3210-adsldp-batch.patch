+
+/* Values of a property as strings: a single value or an array of values; booleans are TRUE and FALSE,
+ * numbers are decimal. */
+static HRESULT variant_to_strings(VARIANT *var, WCHAR ***out)
+{
+    VARIANT *items = NULL, one;
+    SAFEARRAY *sa = NULL;
+    WCHAR **list;
+    LONG lb = 0, ub = -1, i;
+    HRESULT hr = S_OK;
+
+    *out = NULL;
+
+    if (V_VT(var) == (VT_ARRAY | VT_VARIANT) || V_VT(var) == (VT_ARRAY | VT_VARIANT | VT_BYREF))
+    {
+        sa = V_VT(var) & VT_BYREF ? *V_ARRAYREF(var) : V_ARRAY(var);
+        if (!sa || SafeArrayGetDim(sa) != 1) return E_ADS_BAD_PARAMETER;
+        SafeArrayGetLBound(sa, 1, &lb);
+        SafeArrayGetUBound(sa, 1, &ub);
+        if ((hr = SafeArrayAccessData(sa, (void **)&items)) != S_OK) return hr;
+    }
+    else if (V_VT(var) == VT_EMPTY || V_VT(var) == VT_NULL)
+    {
+        items = NULL;
+    }
+    else
+    {
+        one = *var;
+        items = &one;
+        lb = 0;
+        ub = 0;
+    }
+
+    list = calloc(ub - lb + 2, sizeof(*list));
+    if (!list)
+    {
+        if (sa) SafeArrayUnaccessData(sa);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i <= ub - lb && hr == S_OK; i++)
+    {
+        VARIANT str;
+        VARIANT *item = &items[i];
+
+        if (V_VT(item) == (VT_VARIANT | VT_BYREF)) item = V_VARIANTREF(item);
+        VariantInit(&str);
+        if (V_VT(item) == VT_BOOL)
