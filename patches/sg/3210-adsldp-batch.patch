+                 (V_VT(item) & ~VT_BYREF) == VT_UI1 || (V_VT(item) & ~VT_BYREF) == VT_UI2 ||
+                 (V_VT(item) & ~VT_BYREF) == VT_UI4 || (V_VT(item) & ~VT_BYREF) == VT_I8 ||
+                 (V_VT(item) & ~VT_BYREF) == VT_INT || (V_VT(item) & ~VT_BYREF) == VT_UINT)
