+static struct ldap_attribute *find_cached_attr(LDAP_namespace *ldap, const WCHAR *name)
+{
+    ULONG i;
+
+    for (i = 0; i < ldap->attrs_count; i++)
+        if (!wcsicmp(name, ldap->attrs[i].name)) return &ldap->attrs[i];
+    return NULL;
+}
+
+static HRESULT add_mod_item(LDAP_namespace *ldap, ULONG op, const WCHAR *name, WCHAR **values)
+{
+    struct ldap_mod_item *item;
+
+    if (ldap->mods_allocated == ldap->mods_count)
+    {
+        ULONG n = ldap->mods_allocated ? ldap->mods_allocated * 2 : 8;
+        struct ldap_mod_item *mods = realloc(ldap->mods, n * sizeof(*mods));
+
+        if (!mods) return E_OUTOFMEMORY;
+        ldap->mods = mods;
+        ldap->mods_allocated = n;
+    }
+
+    item = &ldap->mods[ldap->mods_count];
+    item->op = op;
+    if (!(item->name = wcsdup(name))) return E_OUTOFMEMORY;
+    item->values = values;
+    ldap->mods_count++;
+    return S_OK;
+}
+
+static WCHAR **dup_string_list(WCHAR **list)
+{
+    ULONG i, n = count_strings(list);
+    WCHAR **ret = calloc(n + 1, sizeof(*ret));
+
+    if (!ret) return NULL;
+    for (i = 0; i < n; i++)
+    {
+        if (!(ret[i] = wcsdup(list[i])))
+        {
+            free_string_list(ret);
+            return NULL;
+        }
+    }
+    return ret;
+}
