+/* a modify request: the operation, the attribute and its values as the directory stores them */
+struct mod_req
+{
+    ULONG op;
+    WCHAR *name;
+    struct berval **bvals;
+};
+
+static struct berval *make_berval_len(const void *data, size_t len)
+{
+    struct berval *bv = malloc(sizeof(*bv) + len + 1);
+
+    if (!bv) return NULL;
+    bv->bv_val = (char *)(bv + 1);
+    if (len) memcpy(bv->bv_val, data, len);
+    bv->bv_val[len] = 0;
+    bv->bv_len = len;
+    return bv;
+}
+
+/* UTF-8 value of a mod */
+static struct berval *make_berval(const WCHAR *str)
+{
+    struct berval *bv;
+    int len = WideCharToMultiByte(CP_UTF8, 0, str, -1, NULL, 0, NULL, NULL);
+
+    if (len <= 0) return NULL;
+    bv = malloc(sizeof(*bv) + len);
+    if (!bv) return NULL;
+    bv->bv_val = (char *)(bv + 1);
+    WideCharToMultiByte(CP_UTF8, 0, str, -1, bv->bv_val, len, NULL, NULL);
+    bv->bv_len = len - 1;
+    return bv;
+}
+
+static void free_bvals(struct berval **bvals)
+{
+    ULONG i;
+
+    if (!bvals) return;
+    for (i = 0; bvals[i]; i++) free(bvals[i]);
+    free(bvals);
+}
+
+static HRESULT run_modify(LDAP_namespace *ldap, const WCHAR *dn, struct mod_req *reqs, ULONG count)
+{
+    LDAPModW *mods, **list;
+    ULONG i, err;
+    HRESULT hr = S_OK;
+
+    mods = calloc(count, sizeof(*mods));
+    list = calloc(count + 1, sizeof(*list));
+    if (!mods || !list)
+    {
+        free(mods);
+        free(list);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        mods[i].mod_op = reqs[i].op | LDAP_MOD_BVALUES;
+        mods[i].mod_type = reqs[i].name;
+        mods[i].mod_vals.modv_bvals = reqs[i].bvals;
+        list[i] = &mods[i];
+    }
+
+    err = ldap_modify_sW(ldap->ld, (WCHAR *)dn, list);
+    if (err != LDAP_SUCCESS)
+    {
+        TRACE("ldap_modify_sW error %#lx\n", err);
+        hr = HRESULT_FROM_WIN32(map_ldap_error(err));
+    }
+
+    free(mods);
+    free(list);
+    return hr;
+}
+
+/* Sends the pending changes of the property cache to the server in one modify request. */
+static HRESULT send_mods(LDAP_namespace *ldap, const WCHAR *dn, struct ldap_mod_item *items, ULONG count)
+{
+    struct mod_req *reqs;
+    ULONG i, j, n;
+    HRESULT hr = S_OK;
+
+    reqs = calloc(count, sizeof(*reqs));
+    if (!reqs) return E_OUTOFMEMORY;
+
+    for (i = 0; i < count && hr == S_OK; i++)
+    {
+        for (n = 0; items[i].values && items[i].values[n]; n++) ;
+        reqs[i].op = items[i].op;
+        reqs[i].name = items[i].name;
+        reqs[i].bvals = calloc(n + 1, sizeof(*reqs[i].bvals));
+        if (!reqs[i].bvals)
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        for (j = 0; j < n; j++)
+        {
+            if (!(reqs[i].bvals[j] = make_berval(items[i].values[j])))
+            {
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+        }
+    }
+
+    if (hr == S_OK) hr = run_modify(ldap, dn, reqs, count);
+
+    for (i = 0; i < count; i++) free_bvals(reqs[i].bvals);
+    free(reqs);
+    return hr;
+}
