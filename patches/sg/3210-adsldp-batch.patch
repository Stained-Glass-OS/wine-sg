+/* end of the first RDN of a distinguished name: the first comma that is not escaped */
+static const WCHAR *rdn_end(const WCHAR *dn)
+{
+    for (; *dn; dn++)
+    {
+        if (*dn == '\\' && dn[1]) dn++;
+        else if (*dn == ',') return dn;
+    }
+    return dn;
+}
+
+/* ADsPath of the server (a path without an object) */
+static BSTR server_path(const LDAP_namespace *ldap)
+{
+    WCHAR buf[320];
+
+    if (!ldap->host) return SysAllocString(L"LDAP:");
+    if (ldap->port) swprintf(buf, ARRAY_SIZE(buf), L"LDAP://%s:%lu", ldap->host, ldap->port);
+    else swprintf(buf, ARRAY_SIZE(buf), L"LDAP://%s", ldap->host);
+    return SysAllocString(buf);
+}
+
+static BSTR object_path(const LDAP_namespace *ldap, const WCHAR *dn)
+{
+    BSTR base = server_path(ldap), ret = NULL;
+    size_t len;
+
+    if (!base) return NULL;
+    if (!dn || !*dn) return base;
+
+    len = SysStringLen(base) + 1 + wcslen(dn) + 1;
+    ret = SysAllocStringLen(NULL, len);
+    if (ret) swprintf(ret, len + 1, L"%s/%s", base, dn);
+    SysFreeString(base);
+    return ret;
 }
 
