+                    values[j] = *src;
+                    switch (src->dwType)
+                    {
+                    case ADSTYPE_DN_STRING:
+                    case ADSTYPE_CASE_EXACT_STRING:
+                    case ADSTYPE_CASE_IGNORE_STRING:
+                    case ADSTYPE_PRINTABLE_STRING:
+                    case ADSTYPE_NUMERIC_STRING:
+                        values[j].CaseIgnoreString = (WCHAR *)p;
+                        memcpy(p, src->CaseIgnoreString, sz);
+                        p += sz;
+                        break;
+                    case ADSTYPE_OCTET_STRING:
+                    case ADSTYPE_NT_SECURITY_DESCRIPTOR:
+                        values[j].OctetString.lpValue = p;
+                        memcpy(p, src->OctetString.lpValue, sz);
+                        p += sz;
+                        break;
+                    case ADSTYPE_DN_WITH_BINARY:
+                    {
+                        ADS_DN_WITH_BINARY *dnb = (ADS_DN_WITH_BINARY *)p;
+
+                        values[j].pDNWithBinary = dnb;
+                        dnb->dwLength = src->pDNWithBinary->dwLength;
+                        dnb->lpBinaryValue = (BYTE *)(dnb + 1);
+                        memcpy(dnb->lpBinaryValue, src->pDNWithBinary->lpBinaryValue, dnb->dwLength);
+                        dnb->pszDNString = (WCHAR *)(((ULONG_PTR)(dnb->lpBinaryValue + dnb->dwLength) + 7) & ~(ULONG_PTR)7);
+                        wcscpy(dnb->pszDNString, src->pDNWithBinary->pszDNString);
+                        p = (BYTE *)(dnb->pszDNString + wcslen(dnb->pszDNString) + 1);
+                        p = (BYTE *)(((ULONG_PTR)p + 7) & ~(ULONG_PTR)7);
+                        break;
+                    }
+                    default:
+                        break;
+                    }
+                    p = (BYTE *)(((ULONG_PTR)p + 7) & ~(ULONG_PTR)7);
+                }
+            }
+            *attrs = out;
+#ifndef SG_MUTANT_ADS_GETATTRS
+            *count_returned = found;
+#endif
+        }
+    }
+
+    for (i = 0; i < found; i++) search_FreeColumn(&ldap->IDirectorySearch_iface, &cols[i]);
+    free(cols);
+    ldap_msgfree(res);
+    return hr;
+}
+
+/* the values of an ADS_ATTR_INFO as the directory stores them */
+static HRESULT adsvalue_to_berval(const ADSVALUE *v, struct berval **out)
+{
+    WCHAR buf[64];
+    char *hex, *text;
+    struct berval *bv = NULL;
+    DWORD i;
+
+    switch (v->dwType)
+    {
+    case ADSTYPE_DN_STRING:
+    case ADSTYPE_CASE_EXACT_STRING:
+    case ADSTYPE_CASE_IGNORE_STRING:
+    case ADSTYPE_PRINTABLE_STRING:
+    case ADSTYPE_NUMERIC_STRING:
+        if (!v->CaseIgnoreString) return E_ADS_BAD_PARAMETER;
+        bv = make_berval(v->CaseIgnoreString);
+        break;
+    case ADSTYPE_BOOLEAN:
+        bv = make_berval(v->Boolean ? L"TRUE" : L"FALSE");
+        break;
+    case ADSTYPE_INTEGER:
+        swprintf(buf, ARRAY_SIZE(buf), L"%ld", v->Integer);
+        bv = make_berval(buf);
+        break;
+    case ADSTYPE_LARGE_INTEGER:
+        swprintf(buf, ARRAY_SIZE(buf), L"%I64d", v->LargeInteger.QuadPart);
+        bv = make_berval(buf);
+        break;
+    case ADSTYPE_UTC_TIME:
+        swprintf(buf, ARRAY_SIZE(buf), L"%04u%02u%02u%02u%02u%02u.0Z", v->UTCTime.wYear, v->UTCTime.wMonth,
+                 v->UTCTime.wDay, v->UTCTime.wHour, v->UTCTime.wMinute, v->UTCTime.wSecond);
+        bv = make_berval(buf);
+        break;
+    case ADSTYPE_OCTET_STRING:
+    case ADSTYPE_NT_SECURITY_DESCRIPTOR:
+        bv = make_berval_len(v->OctetString.lpValue, v->OctetString.dwLength);
+        break;
+    case ADSTYPE_DN_WITH_BINARY:
+    {
+        int len = WideCharToMultiByte(CP_UTF8, 0, v->pDNWithBinary->pszDNString, -1, NULL, 0, NULL, NULL);
+
+        if (len <= 0) return E_ADS_BAD_PARAMETER;
+        /* B:<number of hex digits>:<hex digits>:<DN> */
+        text = malloc(32 + v->pDNWithBinary->dwLength * 2 + len);
+        if (!text) return E_OUTOFMEMORY;
+        hex = text + sprintf(text, "B:%lu:", v->pDNWithBinary->dwLength * 2);
+        for (i = 0; i < v->pDNWithBinary->dwLength; i++) hex += sprintf(hex, "%02X", v->pDNWithBinary->lpBinaryValue[i]);
+        *hex++ = ':';
+        WideCharToMultiByte(CP_UTF8, 0, v->pDNWithBinary->pszDNString, -1, hex, len, NULL, NULL);
+        bv = make_berval_len(text, strlen(text));
+        free(text);
+        break;
+    }
+    default:
+        return E_ADS_CANT_CONVERT_DATATYPE;
+    }
+
+    if (!bv) return E_OUTOFMEMORY;
+    *out = bv;
+    return S_OK;
+}
+
+static void free_mod_reqs(struct mod_req *reqs, ULONG count)
+{
+    ULONG i;
+
+    if (!reqs) return;
+    for (i = 0; i < count; i++) free_bvals(reqs[i].bvals);
+    free(reqs);
+}
+
+static HRESULT attrs_to_mods(PADS_ATTR_INFO attrs, DWORD count, BOOL create, struct mod_req **out)
+{
+    struct mod_req *reqs;
+    DWORD i, j;
+    HRESULT hr = S_OK;
+
+    reqs = calloc(count ? count : 1, sizeof(*reqs));
+    if (!reqs) return E_OUTOFMEMORY;
+
+    for (i = 0; i < count && hr == S_OK; i++)
+    {
+        reqs[i].name = attrs[i].pszAttrName;
+        switch (create ? ADS_PROPERTY_APPEND : attrs[i].dwControlCode)
+        {
+        case ADS_PROPERTY_CLEAR:  reqs[i].op = LDAP_MOD_REPLACE; break;
+        case ADS_PROPERTY_UPDATE: reqs[i].op = LDAP_MOD_REPLACE; break;
+        case ADS_PROPERTY_APPEND: reqs[i].op = LDAP_MOD_ADD; break;
+#ifdef SG_MUTANT_ADS_SETATTR
+        case ADS_PROPERTY_DELETE: reqs[i].op = LDAP_MOD_ADD; break;
+#else
+        case ADS_PROPERTY_DELETE: reqs[i].op = LDAP_MOD_DELETE; break;
+#endif
+        default: hr = E_ADS_BAD_PARAMETER; continue;
+        }
+
+        reqs[i].bvals = calloc(attrs[i].dwNumValues + 1, sizeof(*reqs[i].bvals));
+        if (!reqs[i].bvals)
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        /* a clear has no values */
+        for (j = 0; j < attrs[i].dwNumValues && attrs[i].dwControlCode != ADS_PROPERTY_CLEAR; j++)
+        {
+            if (!attrs[i].pADsValues) { hr = E_ADS_BAD_PARAMETER; break; }
+            hr = adsvalue_to_berval(&attrs[i].pADsValues[j], &reqs[i].bvals[j]);
+            if (hr != S_OK) break;
+        }
+    }
+
+    if (hr != S_OK)
+    {
+        free_mod_reqs(reqs, count);
+        return hr;
+    }
+    *out = reqs;
+    return S_OK;
 }
 
