+/* Makes the cache have these values for the attribute (taking the list over); an empty list removes it. */
+static HRESULT cache_set_values(LDAP_namespace *ldap, const WCHAR *name, WCHAR **values)
+{
+    struct ldap_attribute *attr = find_cached_attr(ldap, name);
+    WCHAR *copy;
+    HRESULT hr;
+
+    if (attr)
+    {
+        if (attr->own)
+        {
+            free_string_list(attr->values);
+            attr->values = values;
+        }
+        else
+        {
+            /* the old values belong to the LDAP library: keep the name, own the new values */
+            ldap_value_freeW(attr->values);
+            attr->values = values;
+            if (!(copy = wcsdup(attr->name))) return E_OUTOFMEMORY;
+            ldap_memfreeW(attr->name);
+            attr->name = copy;
+            attr->own = TRUE;
+        }
+        return S_OK;
+    }
+
+    if (!(copy = wcsdup(name))) return E_OUTOFMEMORY;
+    hr = add_attribute(ldap, copy, values);
+    if (hr != S_OK)
+    {
+        free(copy);
+        return hr;
+    }
+    ldap->attrs[ldap->attrs_count - 1].own = TRUE;
+    return S_OK;
 }
 
