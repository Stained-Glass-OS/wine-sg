+/* the dn of a child of this object, from its relative name */
+static WCHAR *child_dn(const LDAP_namespace *ldap, const WCHAR *rdn)
+{
+    size_t len = wcslen(rdn) + 1 + (ldap->object ? wcslen(ldap->object) : 0) + 1;
+    WCHAR *dn = malloc(len * sizeof(WCHAR));
+
+    if (!dn) return NULL;
+    if (is_root_dse(ldap)) wcscpy(dn, rdn);
+    else swprintf(dn, len, L"%s,%s", rdn, ldap->object);
+    return dn;
 }
 
