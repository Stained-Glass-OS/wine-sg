+/* Opens an object of the domain controller's directory with the LDAP provider. */
+static HRESULT open_dc_object(const WCHAR *dc, const WCHAR *object, IDispatch **disp)
+{
+    IADsOpenDSObject *open;
+    WCHAR *path;
+    BSTR bpath;
+    size_t len = wcslen(L"LDAP://") + wcslen(dc) + 1 + wcslen(object) + 1;
+    HRESULT hr;
+
+    hr = LDAPNamespace_create(&IID_IADsOpenDSObject, (void **)&open);
+    if (FAILED(hr)) return hr;
+
+    path = malloc(len * sizeof(WCHAR));
+    if (!path)
+    {
+        IADsOpenDSObject_Release(open);
+        return E_OUTOFMEMORY;
+    }
+    swprintf(path, len, L"LDAP://%s/%s", dc, object);
+    bpath = SysAllocString(path);
+    free(path);
+    if (!bpath)
+    {
+        IADsOpenDSObject_Release(open);
+        return E_OUTOFMEMORY;
+    }
+
+    hr = IADsOpenDSObject_OpenDSObject(open, bpath, NULL, NULL, ADS_SECURE_AUTHENTICATION, disp);
+    if (hr != S_OK)
+        hr = IADsOpenDSObject_OpenDSObject(open, bpath, NULL, NULL, 0, disp);
+    SysFreeString(bpath);
+    IADsOpenDSObject_Release(open);
+    return hr;
+}
+
+/* Reads an attribute of an object of the domain controller's directory. */
+static HRESULT dc_get_attribute(const WCHAR *dc, const WCHAR *object, const WCHAR *attr, VARIANT *value)
+{
+    IDispatch *disp;
+    IADs *ads;
+    BSTR battr;
+    HRESULT hr;
+
+    hr = open_dc_object(dc, object, &disp);
+    if (hr != S_OK) return hr;
+
+    hr = IDispatch_QueryInterface(disp, &IID_IADs, (void **)&ads);
+    IDispatch_Release(disp);
+    if (hr != S_OK) return hr;
+
+    battr = SysAllocString(attr);
+    hr = battr ? IADs_Get(ads, battr, value) : E_OUTOFMEMORY;
+    SysFreeString(battr);
+    IADs_Release(ads);
+    return hr;
+}
+
+static HRESULT dc_get_string(const WCHAR *dc, const WCHAR *object, const WCHAR *attr, BSTR *ret)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    VariantInit(&v);
+    hr = dc_get_attribute(dc, object, attr, &v);
+    if (hr == S_OK)
+    {
+        if (V_VT(&v) == VT_BSTR)
+        {
+            *ret = V_BSTR(&v);
+            V_VT(&v) = VT_EMPTY;
+        }
+        else
+            hr = E_ADS_PROPERTY_NOT_FOUND;
+    }
+    VariantClear(&v);
+    return hr;
+}
+
+/* name of the domain controller without the leading backslashes */
+static HRESULT get_dc_name(DOMAIN_CONTROLLER_INFOW **info, const WCHAR **dc)
+{
+    HRESULT hr = get_dc_info(DS_RETURN_DNS_NAME, info);
+    if (hr != S_OK) return hr;
+    *dc = (*info)->DomainControllerName;
+    while (**dc == '\\') (*dc)++;
+    return S_OK;
+}
+
+/* the role owner of an object found through a root DSE attribute (a naming context) */
+static HRESULT get_role_owner(const WCHAR *context_attr, BSTR *retval)
+{
+    DOMAIN_CONTROLLER_INFOW *dcinfo;
+    BSTR nc = NULL;
+    const WCHAR *dc;
+    HRESULT hr;
+
+    if (!retval) return E_POINTER;
+    if (FAILED(hr = get_dc_name(&dcinfo, &dc))) return hr;
+    hr = dc_get_string(dc, L"rootDSE", context_attr, &nc);
+    if (hr == S_OK) hr = dc_get_string(dc, nc, L"fSMORoleOwner", retval);
+    SysFreeString(nc);
+    NetApiBufferFree(dcinfo);
+    return hr;
 }
 
