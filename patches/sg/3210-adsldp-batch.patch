+/* type information of the automation interfaces comes from the type library of activeds.dll */
+static ITypeInfo *typeinfos[3];
+static const GUID guid_null = {0};
+
+static HRESULT get_typeinfo(unsigned idx, const GUID *iid, ITypeInfo **ti)
+{
+    ITypeInfo *info;
+    ITypeLib *lib;
+    WCHAR path[MAX_PATH];
+    HMODULE module;
+    HRESULT hr;
+
+    if (!typeinfos[idx])
+    {
+        if (!(module = GetModuleHandleW(L"activeds.dll")) || !GetModuleFileNameW(module, path, ARRAY_SIZE(path)))
+            return HRESULT_FROM_WIN32(GetLastError());
+        if (FAILED(hr = LoadTypeLibEx(path, REGKIND_NONE, &lib))) return hr;
+        hr = ITypeLib_GetTypeInfoOfGuid(lib, iid, &info);
+        ITypeLib_Release(lib);
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer((void **)&typeinfos[idx], info, NULL))
+            ITypeInfo_Release(info);
+    }
+
+    *ti = typeinfos[idx];
+    ITypeInfo_AddRef(*ti);
+    return S_OK;
+}
+
+static HRESULT disp_get_type_info_count(UINT *count)
+{
+    if (!count) return E_POINTER;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT disp_get_type_info(unsigned idx, const GUID *iid, UINT index, ITypeInfo **info)
+{
+    if (!info) return E_POINTER;
+    *info = NULL;
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo(idx, iid, info);
+}
+
+static HRESULT disp_get_ids_of_names(unsigned idx, const GUID *iid, REFIID riid, LPOLESTR *names, UINT count,
+                                     DISPID *dispid)
+{
+    ITypeInfo *ti;
+    HRESULT hr;
+
+    if (!IsEqualGUID(riid, &guid_null)) return DISP_E_UNKNOWNINTERFACE;
+#ifdef SG_MUTANT_ADS_TYPEINFO
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = get_typeinfo(idx, iid, &ti))) return hr;
+    hr = ITypeInfo_GetIDsOfNames(ti, names, count, dispid);
+    ITypeInfo_Release(ti);
+    return hr;
+}
+
+static HRESULT disp_invoke(unsigned idx, const GUID *iid, void *iface, DISPID dispid, REFIID riid, WORD flags,
+                           DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    ITypeInfo *ti;
+    HRESULT hr;
+
+    if (!IsEqualGUID(riid, &guid_null)) return DISP_E_UNKNOWNINTERFACE;
+    if (FAILED(hr = get_typeinfo(idx, iid, &ti))) return hr;
+    hr = ITypeInfo_Invoke(ti, iface, dispid, flags, params, result, excepinfo, argerr);
+    ITypeInfo_Release(ti);
+    return hr;
+}
+
+static HRESULT bstr_dup_out(const WCHAR *str, BSTR *ret)
+{
+    if (!ret) return E_POINTER;
+    *ret = SysAllocString(str ? str : L"");
+    return *ret ? S_OK : E_OUTOFMEMORY;
+}
