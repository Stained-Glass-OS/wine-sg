+static HRESULT get_trees_from_partitions(const WCHAR *dc, const WCHAR *config, VARIANT *ret)
+{
+    static WCHAR filter[] = L"(&(objectClass=crossRef)(systemFlags=3)(!(trustParent=*)))";
+    static WCHAR dns_root[] = L"dnsRoot";
+    WCHAR *attrs[] = { dns_root };
+    ADS_SEARCHPREF_INFO pref;
+    ADS_SEARCH_HANDLE handle;
+    IDirectorySearch *search;
+    BSTR *names = NULL;
+    SAFEARRAY *sa;
+    IDispatch *disp;
+    WCHAR *object;
+    ULONG count = 0, i;
+    HRESULT hr;
+
+    object = malloc((wcslen(L"CN=Partitions,") + wcslen(config) + 1) * sizeof(WCHAR));
+    if (!object) return E_OUTOFMEMORY;
+    wcscpy(object, L"CN=Partitions,");
+    wcscat(object, config);
+    hr = open_dc_object(dc, object, &disp);
+    free(object);
+    if (hr != S_OK) return hr;
+
+    hr = IDispatch_QueryInterface(disp, &IID_IDirectorySearch, (void **)&search);
+    IDispatch_Release(disp);
+    if (hr != S_OK) return hr;
+
+    pref.dwSearchPref = ADS_SEARCHPREF_SEARCH_SCOPE;
+    pref.vValue.dwType = ADSTYPE_INTEGER;
+    pref.vValue.Integer = ADS_SCOPE_ONELEVEL;
+    IDirectorySearch_SetSearchPreference(search, &pref, 1);
+
+    hr = IDirectorySearch_ExecuteSearch(search, filter, attrs, 1, &handle);
+    if (hr == S_OK)
+    {
+        while ((hr = IDirectorySearch_GetNextRow(search, handle)) == S_OK)
+        {
+            ADS_SEARCH_COLUMN col;
+            BSTR *new_names;
+
+            if (IDirectorySearch_GetColumn(search, handle, dns_root, &col) != S_OK) continue;
+            new_names = realloc(names, (count + 1) * sizeof(*names));
+            if (new_names && col.dwNumValues &&
+                (new_names[count] = SysAllocString(col.pADsValues[0].CaseIgnoreString)))
+            {
+                names = new_names;
+                count++;
+            }
+            else if (new_names)
+                names = new_names;
+            IDirectorySearch_FreeColumn(search, &col);
+        }
+        if (hr == S_ADS_NOMORE_ROWS) hr = S_OK;
+        IDirectorySearch_CloseSearchHandle(search, handle);
+    }
+    IDirectorySearch_Release(search);
+
+    if (hr == S_OK)
+    {
+        sa = SafeArrayCreateVector(VT_VARIANT, 0, count);
+        if (!sa) hr = E_OUTOFMEMORY;
+        for (i = 0; hr == S_OK && i < count; i++)
+        {
+            VARIANT item;
+            LONG idx = i;
+
+            V_VT(&item) = VT_BSTR;
+            V_BSTR(&item) = names[i];
+            hr = SafeArrayPutElement(sa, &idx, &item);
+        }
+        if (hr == S_OK)
+        {
+            V_VT(ret) = VT_ARRAY | VT_VARIANT;
+            V_ARRAY(ret) = sa;
+        }
+        else if (sa)
+            SafeArrayDestroy(sa);
+    }
+    for (i = 0; i < count; i++) SysFreeString(names[i]);
+    free(names);
+    return hr;
 }
 
