+    err = ldap_search_sW(ldap->ld, ldap->object, LDAP_SCOPE_BASE, (WCHAR *)L"(objectClass=*)", attrs, FALSE, &res);
+    if (err != LDAP_SUCCESS)
+        return HRESULT_FROM_WIN32(map_ldap_error(err));
+
+    entry = ldap_first_entry(ldap->ld, res);
+    values = entry ? ldap_get_values_lenW(ldap->ld, entry, attrs[0]) : NULL;
+    if (values && values[0])
+    {
+#ifdef SG_MUTANT_ADS_GUID
+        static const WCHAR hex[] = L"0123456789ABCDEF";
+#else
+        static const WCHAR hex[] = L"0123456789abcdef";
+#endif
+        BSTR str = SysAllocStringLen(NULL, values[0]->bv_len * 2);
+
+        if (!str) hr = E_OUTOFMEMORY;
+        else
+        {
+            /* the octet string, as hexadecimal digits */
+            for (i = 0; i < values[0]->bv_len; i++)
+            {
+                BYTE b = (BYTE)values[0]->bv_val[i];
+                str[i * 2] = hex[b >> 4];
+                str[i * 2 + 1] = hex[b & 15];
+            }
+            *retval = str;
