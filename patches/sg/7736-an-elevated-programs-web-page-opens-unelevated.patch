From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, explorer: a web page an elevated program opens opens unelevated, as the person

David 2026-11-11: "A browser can run with the system account's rights.
seems like a bad idea, prhpas we block or de-eleavet that."

An elevated program runs as the SYSTEM account on disk (ADR 0012). When it
opened a page (FreeOffice's uninstaller, its survey), ShellExecute started
the browser from it: Linux Firefox ran as that account, on the person's
desktop, with its rights.

- shell32: ShellExecuteEx of a URL (not file: or shell:) from an elevated
  process goes to the person's own shell. Their explorer.exe serves
  \\.\pipe\sg-unelevated-open-<SID>; the elevated program is that person,
  elevated (7601), so it knows the SID. shell32 checks the server is that
  person and not elevated (another account that made the pipe first is not
  given the page), connects with identification-level impersonation only,
  and returns the shell's ShellExecute answer. With no such shell the page
  is not opened at all and ShellExecuteEx fails with access denied: a
  browser never starts elevated.
- explorer: a shell desktop that is not elevated makes that pipe, first
  instance only, open to its SID, and opens a page for a client that is the
  same person (ImpersonateNamedPipeClient); others are refused. Wine does
  not enforce the pipe's DACL against other accounts, so this check is what
  keeps them out.

Gate test-elevurl; mutants SG_MUTANT_ELEVATED_BROWSER (shell32),
SG_MUTANT_UNELEVATED_OPEN_ANYONE (explorer).
---
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -34,6 +34,7 @@
 #include "winreg.h"
 #include "winuser.h"
 #include "shlwapi.h"
+#include "sddl.h"
 #include "ddeml.h"
 #include "winnetwk.h"
 
@@ -2423,6 +2424,97 @@
     return TRUE;
 }
 
+/* Stained Glass OS: a web page an elevated program opens is opened by the
+ * person's own, unelevated shell (David, 2026-11-11). An elevated program
+ * runs as the SYSTEM account on disk (ADR 0012); the browser it started for
+ * a link (an uninstaller's survey page) ran with the system account's
+ * rights. The person's desktop process (explorer.exe, their session) serves
+ * \\.\pipe\sg-unelevated-open-<SID> and opens the URL as them; this checks
+ * that the pipe's server is that person, unelevated, before giving it the
+ * URL. With no such shell the page is not opened at all: a browser never
+ * runs elevated. Not for file: or shell: locations -- those are not pages. */
+static BOOL token_query( HANDLE token, TOKEN_INFORMATION_CLASS class, void *buf, DWORD size )
+{
+    DWORD len;
+    return GetTokenInformation( token, class, buf, size, &len );
+}
+
+static BOOL process_is_elevated( HANDLE process, BYTE *user, DWORD user_size )
+{
+    TOKEN_ELEVATION elevation = { 0 };
+    HANDLE token;
+    BOOL ret = FALSE;
+
+    if (!OpenProcessToken( process, TOKEN_QUERY, &token )) return FALSE;
+    if (token_query( token, TokenElevation, &elevation, sizeof(elevation) )) ret = elevation.TokenIsElevated;
+    if (user && !token_query( token, TokenUser, user, user_size )) memset( user, 0, user_size );
+    CloseHandle( token );
+    return ret;
+}
+
+/* the page a lpFile names, without quotes; NULL when it is not a page */
+static WCHAR *page_url( const WCHAR *file )
+{
+    WCHAR *url;
+    int len;
+
+    if (!file) return NULL;
+    len = lstrlenW( file );
+    if (len > 1 && file[0] == '"' && file[len - 1] == '"') { file++; len -= 2; }
+    if (!(url = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( url, file, len * sizeof(WCHAR) );
+    url[len] = 0;
+    if (PathIsURLW( url ) && wcsnicmp( url, L"file:", 5 ) && wcsnicmp( url, L"shell:", 6 )) return url;
+    free( url );
+    return NULL;
+}
+
+/* TRUE when the URL was handed over or refused; *ret is ShellExecute's answer */
+static BOOL open_url_unelevated( const WCHAR *url, UINT_PTR *ret )
+{
+    BYTE me[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)], them[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)];
+    WCHAR name[128], *sid = NULL;
+    HANDLE pipe = INVALID_HANDLE_VALUE, server;
+    DWORD mode = PIPE_READMODE_MESSAGE, done, answer = 0;
+    ULONG pid;
+
+#ifdef SG_MUTANT_ELEVATED_BROWSER
+    return FALSE;
+#endif
+    if (!process_is_elevated( GetCurrentProcess(), me, sizeof(me) )) return FALSE;
+    *ret = SE_ERR_ACCESSDENIED;
+    if (!((TOKEN_USER *)me)->User.Sid || !ConvertSidToStringSidW( ((TOKEN_USER *)me)->User.Sid, &sid )) goto refused;
+    swprintf( name, ARRAY_SIZE(name), L"\\\\.\\pipe\\sg-unelevated-open-%s", sid );
+    LocalFree( sid );
+    /* identification only: the person's shell may see who asks, not act as them */
+    pipe = CreateFileW( name, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
+                        SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION, NULL );
+    if (pipe == INVALID_HANDLE_VALUE) goto refused;
+    if (!GetNamedPipeServerProcessId( pipe, &pid ) || !(server = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
+        goto refused;
+    if (process_is_elevated( server, them, sizeof(them) ) || !((TOKEN_USER *)them)->User.Sid ||
+        !EqualSid( ((TOKEN_USER *)them)->User.Sid, ((TOKEN_USER *)me)->User.Sid ))
+    {
+        CloseHandle( server );
+        goto refused;
+    }
+    CloseHandle( server );
+    SetNamedPipeHandleState( pipe, &mode, NULL, NULL );
+    if (!WriteFile( pipe, url, (lstrlenW( url ) + 1) * sizeof(WCHAR), &done, NULL ) ||
+        !ReadFile( pipe, &answer, sizeof(answer), &done, NULL ) || done != sizeof(answer))
+        goto refused;
+    CloseHandle( pipe );
+    TRACE( "%s opened by the person's shell, unelevated: %lu\n", debugstr_w(url), answer );
+    *ret = answer;
+    return TRUE;
+
+refused:
+    if (pipe != INVALID_HANDLE_VALUE) CloseHandle( pipe );
+    SetLastError( ERROR_ACCESS_DENIED );
+    ERR( "not opening %s elevated: no unelevated shell of this person to open it\n", debugstr_w(url) );
+    return TRUE;
+}
+
 static BOOL SHELL_execute( LPSHELLEXECUTEINFOW sei, SHELL_ExecuteW32 execfunc )
 {
     /* Stained Glass OS 1657: SEE_MASK_FLAG_DDEWAIT (NOASYNC), ASYNCOK and
@@ -2461,6 +2553,17 @@
     if (!(sei_tmp.fMask & SEE_MASK_IDLIST) && sei_tmp.lpFile && apps_folder_aumid( sei_tmp.lpFile ))
         return shell_execute_aumid( sei, apps_folder_aumid( sei_tmp.lpFile ) );
 
+    if (!(sei_tmp.fMask & SEE_MASK_IDLIST) && (wszApplicationName = page_url( sei_tmp.lpFile )))
+    {
+        BOOL handled = open_url_unelevated( wszApplicationName, &retval );
+        free( wszApplicationName );
+        if (handled)
+        {
+            sei->hInstApp = (HINSTANCE)(retval > 32 ? 33 : retval);
+            return retval > 32;
+        }
+    }
+
     /* make copies of all path/command strings */
     if (!sei_tmp.lpFile)
     {
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -31,6 +31,7 @@
 #include <shellapi.h>
 #include <commctrl.h>
 #include <shlwapi.h>
+#include <sddl.h>
 #include <dbt.h>
 #include <ntuser.h>
 #include "exdisp.h"
@@ -3683,6 +3684,94 @@
  * account's desktop, not this one: a disc put in did not show until This
  * PC was opened again. A look every two seconds: the drive letters, and
  * each removable or optical drive's volume serial number. */
+/* Stained Glass OS: the person's shell opens the web pages their elevated
+ * programs open (shell32's open_url_unelevated, David 2026-11-11), so a
+ * browser never runs with the system account's rights. One pipe per person,
+ * \\.\pipe\sg-unelevated-open-<SID>, made first by this process (a squatter
+ * makes it fail here, and shell32 then finds a server it refuses) and open to
+ * that SID alone; each request must come from that person (the elevated
+ * program is the person, elevated, wine-sg 7601) and name a page, not a file. */
+static BOOL token_user_sid( HANDLE token, BYTE *buf, DWORD size )
+{
+    DWORD len;
+    return GetTokenInformation( token, TokenUser, buf, size, &len ) && ((TOKEN_USER *)buf)->User.Sid;
+}
+
+static BOOL request_from_person( HANDLE pipe, PSID person )
+{
+    BYTE buf[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)];
+    HANDLE token;
+    BOOL ret = FALSE;
+
+#ifdef SG_MUTANT_UNELEVATED_OPEN_ANYONE
+    return TRUE;
+#endif
+    if (!ImpersonateNamedPipeClient( pipe )) return FALSE;
+    if (OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ))
+    {
+        ret = token_user_sid( token, buf, sizeof(buf) ) && EqualSid( ((TOKEN_USER *)buf)->User.Sid, person );
+        CloseHandle( token );
+    }
+    RevertToSelf();
+    return ret;
+}
+
+static DWORD WINAPI unelevated_open_thread( void *arg )
+{
+    BYTE me[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)];
+    TOKEN_ELEVATION elevation = { 0 };
+    SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, FALSE };
+    WCHAR name[128], sddl[200], *sid, url[4096];
+    HANDLE token, pipe;
+    DWORD len;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return 0;
+    if (!token_user_sid( token, me, sizeof(me) ) ||
+        (GetTokenInformation( token, TokenElevation, &elevation, sizeof(elevation), &len ) && elevation.TokenIsElevated))
+    {
+        CloseHandle( token );
+        return 0;   /* an elevated desktop opens no pages for anyone */
+    }
+    CloseHandle( token );
+    if (!ConvertSidToStringSidW( ((TOKEN_USER *)me)->User.Sid, &sid )) return 0;
+    swprintf( name, ARRAY_SIZE(name), L"\\\\.\\pipe\\sg-unelevated-open-%s", sid );
+    swprintf( sddl, ARRAY_SIZE(sddl), L"D:P(A;;GA;;;%s)", sid );
+    LocalFree( sid );
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW( sddl, SDDL_REVISION_1, &sa.lpSecurityDescriptor, NULL ))
+        return 0;
+    pipe = CreateNamedPipeW( name, PIPE_ACCESS_DUPLEX | FILE_FLAG_FIRST_PIPE_INSTANCE,
+                             PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT,
+                             1, 4096, sizeof(url), 0, &sa );
+    LocalFree( sa.lpSecurityDescriptor );
+    if (pipe == INVALID_HANDLE_VALUE)
+    {
+        WARN( "%s: %lu; elevated programs' pages are not opened\n", debugstr_w(name), GetLastError() );
+        return 0;
+    }
+    for (;;)
+    {
+        DWORD got = 0, answer = SE_ERR_ACCESSDENIED, done;
+
+        if (!ConnectNamedPipe( pipe, NULL ) && GetLastError() != ERROR_PIPE_CONNECTED) continue;
+        if (ReadFile( pipe, url, sizeof(url) - sizeof(WCHAR), &got, NULL ) && got >= sizeof(WCHAR))
+        {
+            url[got / sizeof(WCHAR)] = 0;
+            if (!request_from_person( pipe, ((TOKEN_USER *)me)->User.Sid ))
+                WARN( "a request from someone else: refused\n" );
+            else if (!PathIsURLW( url ) || !wcsnicmp( url, L"file:", 5 ) || !wcsnicmp( url, L"shell:", 6 ))
+                WARN( "not a page: %s\n", debugstr_w(url) );
+            else
+            {
+                TRACE( "opening %s for an elevated program\n", debugstr_w(url) );
+                answer = (DWORD)(ULONG_PTR)ShellExecuteW( NULL, NULL, url, NULL, NULL, SW_SHOWNORMAL );
+            }
+            WriteFile( pipe, &answer, sizeof(answer), &done, NULL );
+            FlushFileBuffers( pipe );
+        }
+        DisconnectNamedPipe( pipe );
+    }
+}
+
 static DWORD WINAPI device_watch_thread( void *arg )
 {
     DWORD serials[26] = {0}, mask = GetLogicalDrives(), i;
@@ -3937,6 +4026,8 @@
         if (thread) CloseHandle( thread );
         if (enable_shell && (thread = CreateThread( NULL, 0, device_watch_thread, NULL, 0, NULL )))
             CloseHandle( thread );
+        if (enable_shell && (thread = CreateThread( NULL, 0, unelevated_open_thread, NULL, 0, NULL )))
+            CloseHandle( thread );
         SystemParametersInfoW( SPI_SETDESKWALLPAPER, 0, NULL, FALSE );
         ClipCursor( NULL );
         initialize_display_settings( width, height );
