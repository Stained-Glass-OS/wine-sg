From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vbscript: an element of an array a function returns is copied out (9615)

Split(line, ";")(1) is how scripts pick a field out of a line, and
Array(a, b)(0), UCase(Split(name, ".")(1)) and a script function's array
result indexed with arguments work the same way. vbscript handed back a
reference into the returned array and then freed the array, so the value read
was Empty (or whatever reused the memory). An element of such a temporary
array is now copied before the array goes; a variable's array is still
indexed by reference.
---
--- a/dlls/vbscript/interp.c
+++ b/dlls/vbscript/interp.c
@@ -586,7 +586,8 @@
     return hres;
 }
 
-static HRESULT variant_call(exec_ctx_t *ctx, VARIANT *v, unsigned arg_cnt, VARIANT *res)
+/* temp: v is a value the caller clears after the call (a function's result, not a variable) */
+static HRESULT variant_call(exec_ctx_t *ctx, VARIANT *v, unsigned arg_cnt, VARIANT *res, BOOL temp)
 {
     SAFEARRAY *array = NULL;
     DISPPARAMS dp;
@@ -634,8 +635,20 @@
         if(FAILED(hres))
             return hres;
 
-        V_VT(res) = VT_BYREF|VT_VARIANT;
-        V_BYREF(res) = v;
+#ifndef SG_MUTANT_VBS_TEMP_ARRAY_REF
+        if(temp) {
+            /* an element of an array a function returned -- Split(s, ",")(1), Array(1, 2)(0):
+             * the array goes when the call is done, so the element is copied (wine-sg 9615) */
+            V_VT(res) = VT_EMPTY;
+            hres = VariantCopy(res, v);
+            if(FAILED(hres))
+                return hres;
+        }else
+#endif
+        {
+            V_VT(res) = VT_BYREF|VT_VARIANT;
+            V_BYREF(res) = v;
+        }
     }
 
     stack_popn(ctx, arg_cnt);
@@ -658,7 +671,7 @@
     case REF_VAR:
     case REF_CONST:
         if(arg_cnt)
-            return variant_call(ctx, ref.u.v, arg_cnt, res);
+            return variant_call(ctx, ref.u.v, arg_cnt, res, FALSE);
 
         if(!res) {
             /* a variable named as a statement: an object calls its default member, anything else is no call */
@@ -768,7 +781,7 @@
     TRACE("\n");
 
     v = stack_pop(ctx);
-    hres = variant_call(ctx, v, arg_cnt, &res);
+    hres = variant_call(ctx, v, arg_cnt, &res, V_VT(v) != (VT_VARIANT|VT_BYREF) && !(V_VT(v) & VT_BYREF));
     VariantClear(v);
     if(FAILED(hres))
         return hres;
@@ -785,7 +798,7 @@
     TRACE("\n");
 
     v = stack_pop(ctx);
-    hres = variant_call(ctx, v, arg_cnt, NULL);
+    hres = variant_call(ctx, v, arg_cnt, NULL, FALSE);
     VariantClear(v);
     return hres;
 }
