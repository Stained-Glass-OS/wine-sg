From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] start: an elevated console program's raw arguments through wineconsole

wine-sg 8400 carries an elevated program's arguments as "/sg-raw-args:TEXT" after the program,
which ntdll and start.exe /exec put in the command line as written. The elevated side starts a
console program as "start /exec wineconsole PROGRAM /sg-raw-args:TEXT": the marker was then not the
only argument, start.exe passed it on, and wineconsole -- which hands its command line to the
program as it is -- gave the program "/sg-raw-args:TEXT" literally. Bitvise's uninstaller, run
elevated from SG Store, got /sg-raw-args:"BvSshClient" -unat, waited, and exited 1. start.exe
/exec of wineconsole now makes the arguments before the marker, then TEXT unchanged; only for
wineconsole, as another program would split TEXT again.
---
diff --git a/programs/start/start.c b/programs/start/start.c
--- a/programs/start/start.c
+++ b/programs/start/start.c
@@ -538,6 +538,31 @@
      * arguments as the caller wrote them, unchanged */
     if (exec_mode && i < argc && i + 1 == argc && !wcsncmp( argv[i], L"/sg-raw-args:", 13 ))
         opts.sei.lpParameters = argv[i] + 13;
+#ifndef SG_MUTANT_RAW_ARGS_LITERAL_AFTER_PROGRAM
+    /* Stained Glass OS (wine-sg 8410): the marker after other arguments -- a console program the
+     * elevated side starts as "start /exec wineconsole PROGRAM /sg-raw-args:TEXT" -- is those
+     * arguments and then TEXT, unchanged; wineconsole hands its command line to the program as it
+     * is (only for it: another program would split TEXT again). It reached the program literally: Bitvise's
+     * uninstaller got "/sg-raw-args:"BvSshClient" -unat", waited, and exited 1. */
+    else if (exec_mode && i + 1 < argc && !wcsncmp( argv[argc - 1], L"/sg-raw-args:", 13 ) &&
+             (!wcsicmp( wcsrchr( file, '\\' ) ? wcsrchr( file, '\\' ) + 1 : file, L"wineconsole" ) ||
+              !wcsicmp( wcsrchr( file, '\\' ) ? wcsrchr( file, '\\' ) + 1 : file, L"wineconsole.exe" )))
+    {
+        WCHAR *raw = argv[argc - 1] + 13, *head, *both;
+
+        argv[argc - 1] = NULL;
+        head = build_command_line( &argv[i] );
+        argv[argc - 1] = raw - 13;
+        both = HeapAlloc( GetProcessHeap(), 0, (lstrlenW( head ) + lstrlenW( raw ) + 2) * sizeof(WCHAR) );
+        lstrcpyW( both, head );
+        if (*raw)
+        {
+            lstrcatW( both, L" " );
+            lstrcatW( both, raw );
+        }
+        opts.sei.lpParameters = both;
+    }
+#endif
     else
 #endif
     opts.sei.lpParameters = build_command_line( &argv[i] );
