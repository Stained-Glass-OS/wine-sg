From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHSetDefaultProperties

SHSetDefaultProperties gives a Shell item the default properties its file type lists in SetDefaultsFor (under its ProgID, else under HKCR\*): of System.Author, System.Document.DateCreated and System.Photo.DateTaken, the ones the item has no value for get the user's name or the time now, through the item's read-write property store. A type listing none of them needs nothing (S_OK). It was not exported.
---
--- a/include/shobjidl.idl
+++ b/include/shobjidl.idl
@@ -777,6 +777,7 @@
 
 cpp_quote("WINSHELLAPI HRESULT WINAPI SHGetNameFromIDList(PCIDLIST_ABSOLUTE pidl, SIGDN sigdnName, PWSTR *ppszName);")
 cpp_quote("WINSHELLAPI HRESULT WINAPI SHCreateItemFromParsingName(PCWSTR pszPath, IBindCtx *pbc, REFIID riid, void **ppv);")
+cpp_quote("WINSHELLAPI HRESULT WINAPI SHSetDefaultProperties(HWND hwnd, IShellItem *psi, DWORD dwFileOpFlags, IFileOperationProgressSink *pfops);")
 cpp_quote("WINSHELLAPI HRESULT WINAPI SHCreateItemFromIDList(PCIDLIST_ABSOLUTE pidl, REFIID riid, void **ppv);")
 cpp_quote("WINSHELLAPI HRESULT WINAPI SHCreateItemFromRelativeName(IShellItem *parent, PCWSTR name, IBindCtx *pbc, REFIID riid, void **ppv);")
 cpp_quote("WINSHELLAPI HRESULT WINAPI SHGetItemFromDataObject(IDataObject *pdtobj, DATAOBJ_GET_ITEM_FLAGS dwFlags, REFIID riid, void **ppv);")
--- a/dlls/shell32/shellitem.c
+++ b/dlls/shell32/shellitem.c
@@ -2406,3 +2406,105 @@
     if (FAILED(hr = item_temp_store(item))) return hr;
     return IPropertyStore_GetValue(item->temp_store, propkey, ppropvar);
 }
+
+#ifndef SG_MUTANT_NO_SET_DEFAULT_PROPS
+/* (wine-sg 8272) SHSetDefaultProperties: the properties a file type lists in SetDefaultsFor (its ProgID's, else
+ * HKCR\*'s) -- of which only System.Author, System.Document.DateCreated and System.Photo.DateTaken count -- get
+ * their default values where the item has none: the user's name, and the time now. */
+static BOOL default_props_list(const WCHAR *path, WCHAR *list, DWORD size)
+{
+    WCHAR progid[256], key[300];
+    const WCHAR *ext = wcsrchr(path, '.');
+    DWORD len = sizeof(progid), got = size;
+
+    if (ext && !wcschr(ext, '\\') &&
+        !RegGetValueW(HKEY_CLASSES_ROOT, ext, NULL, RRF_RT_REG_SZ, NULL, progid, &len))
+    {
+        swprintf(key, ARRAY_SIZE(key), L"%s", progid);
+        if (!RegGetValueW(HKEY_CLASSES_ROOT, key, L"SetDefaultsFor", RRF_RT_REG_SZ, NULL, list, &got)) return TRUE;
+    }
+    got = size;
+    return !RegGetValueW(HKEY_CLASSES_ROOT, L"*", L"SetDefaultsFor", RRF_RT_REG_SZ, NULL, list, &got);
+}
+
+HRESULT WINAPI SHSetDefaultProperties(HWND hwnd, IShellItem *item, DWORD flags, IFileOperationProgressSink *sink)
+{
+    static const struct { const WCHAR *name; const PROPERTYKEY *key; BOOL is_date; } known[] =
+    {
+        { L"System.Author", &PKEY_Author, FALSE },
+        { L"System.Document.DateCreated", &PKEY_Document_DateCreated, TRUE },
+        { L"System.Photo.DateTaken", &PKEY_Photo_DateTaken, TRUE },
+    };
+    WCHAR *path = NULL, list[1024], *p, *ctx;
+    IShellItem2 *item2 = NULL;
+    IPropertyStore *store = NULL;
+    BOOL wanted[ARRAY_SIZE(known)] = { 0 }, any = FALSE, changed = FALSE;
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %#lx, %p)\n", hwnd, item, flags, sink);
+
+    if (!item) return E_INVALIDARG;
+    if (FAILED(hr = IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &path))) return hr;
+    if (default_props_list(path, list, sizeof(list)))
+    {
+        /* "prop:System.Author;System.Document.DateCreated" */
+        p = wcsncmp(list, L"prop:", 5) ? list : list + 5;
+        for (p = wcstok(p, L";", &ctx); p; p = wcstok(NULL, L";", &ctx))
+            for (i = 0; i < ARRAY_SIZE(known); i++)
+                if (!wcsicmp(p, known[i].name)) wanted[i] = any = TRUE;
+    }
+    CoTaskMemFree(path);
+    if (!any) return S_OK;
+
+    if (FAILED(hr = IShellItem_QueryInterface(item, &IID_IShellItem2, (void **)&item2))) return hr;
+    hr = IShellItem2_GetPropertyStore(item2, GPS_READWRITE, &IID_IPropertyStore, (void **)&store);
+    IShellItem2_Release(item2);
+    if (FAILED(hr)) return hr;
+    for (i = 0; i < ARRAY_SIZE(known) && SUCCEEDED(hr); i++)
+    {
+        PROPVARIANT value;
+
+        if (!wanted[i]) continue;
+        PropVariantInit(&value);
+        if (SUCCEEDED(IPropertyStore_GetValue(store, known[i].key, &value)) && value.vt != VT_EMPTY)
+        {
+            PropVariantClear(&value);
+            continue;
+        }
+        PropVariantClear(&value);
+        if (known[i].is_date)
+        {
+            FILETIME now;
+
+            GetSystemTimeAsFileTime(&now);
+            hr = InitPropVariantFromFileTime(&now, &value);
+        }
+        else
+        {
+            WCHAR user[256];
+            DWORD len = ARRAY_SIZE(user);
+
+            if (!GetUserNameW(user, &len)) user[0] = 0;
+            value.vt = VT_LPWSTR;
+            if (!(value.pwszVal = CoTaskMemAlloc((wcslen(user) + 1) * sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+            else
+            {
+                wcscpy(value.pwszVal, user);
+                hr = S_OK;
+            }
+        }
+        if (SUCCEEDED(hr)) hr = IPropertyStore_SetValue(store, known[i].key, &value);
+        PropVariantClear(&value);
+        changed = TRUE;
+    }
+    if (SUCCEEDED(hr) && changed) hr = IPropertyStore_Commit(store);
+    IPropertyStore_Release(store);
+    return hr;
+}
+#else
+HRESULT WINAPI SHSetDefaultProperties(HWND hwnd, IShellItem *item, DWORD flags, IFileOperationProgressSink *sink)
+{
+    return E_NOTIMPL;
+}
+#endif
--- a/dlls/shell32/shell32.spec
+++ b/dlls/shell32/shell32.spec
@@ -408,6 +408,7 @@
 @ stdcall SHGetPathFromIDListW(ptr ptr)
 @ stdcall SHGetPropertyStoreForWindow(long ptr ptr)
 @ stdcall SHGetPropertyStoreFromParsingName(wstr ptr long ptr ptr)
+@ stdcall SHSetDefaultProperties(ptr ptr long ptr)
 @ stdcall SHGetSettings(ptr long)
 @ stdcall SHGetSpecialFolderLocation(long long ptr)
 @ stdcall SHGetSpecialFolderPathA(long ptr long long)
