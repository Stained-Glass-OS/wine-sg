From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] gdi32: EMF playback of EXTESCAPE, DRAWESCAPE, NAMEDESCAPE and UFI records

PlayEnhMetaFileRecord passes the escape records on to ExtEscape, DrawEscape and
NamedEscape and accepts the UFI and STARTDOC ones; GLS, colour-correct-palette
and colour-match records are still not played (partial). CORE: integrator must
review (patches/notes/5222.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/gdi32/enhmetafile.c b/dlls/gdi32/enhmetafile.c
--- a/dlls/gdi32/enhmetafile.c
+++ b/dlls/gdi32/enhmetafile.c
@@ -777,6 +777,9 @@
     return handletable->objectHandle[i];
 }
 
+INT WINAPI NamedEscape( HDC hdc, const WCHAR *driver, INT escape, INT input_size, const char *input,
+                        INT output_size, char *output );
+
 /* EMR_SETICMPROFILEA/W: the profile's name, then an optionally embedded profile */
 struct emr_seticmprofile
 {
@@ -2417,15 +2420,49 @@
         break;
     }
 
-    case EMR_GLSRECORD:
-    case EMR_GLSBOUNDEDRECORD:
-    case EMR_DRAWESCAPE:
     case EMR_EXTESCAPE:
-    case EMR_STARTDOC:
-    case EMR_FORCEUFIMAPPING:
+    case EMR_DRAWESCAPE:
+      {
+        /* Stained Glass OS: the escape and its data are passed to the device ([MS-EMF] 2.3.6.x) */
+        const EMREXTESCAPE *esc = (const void *)mr;
+#ifdef SG_MUTANT_EMF_ESCAPE
+        break;
+#endif
+        if (mr->nSize < FIELD_OFFSET( EMREXTESCAPE, EscData ) || esc->cbEscData < 0 ||
+            (UINT)esc->cbEscData > mr->nSize - FIELD_OFFSET( EMREXTESCAPE, EscData )) break;
+        TRACE( "%s: escape %d, %d bytes\n", type == EMR_EXTESCAPE ? "ExtEscape" : "DrawEscape", esc->iEscape, esc->cbEscData );
+        if (type == EMR_EXTESCAPE) ExtEscape( hdc, esc->iEscape, esc->cbEscData, (const char *)esc->EscData, 0, NULL );
+        else DrawEscape( hdc, esc->iEscape, esc->cbEscData, (const char *)esc->EscData );
+        break;
+      }
+
     case EMR_NAMEDESCAPE:
-    case EMR_COLORCORRECTPALETTE:
+      {
+        /* iEscape, cjDriver (bytes of the driver name, even), cjIn (bytes of data), name, data */
+        const struct emr_namedescape { EMR emr; DWORD iEscape, cjDriver, cjIn; BYTE Data[1]; } *esc = (const void *)mr;
+        WCHAR *name;
+        DWORD avail;
+
+        if (mr->nSize < FIELD_OFFSET( struct emr_namedescape, Data )) break;
+        avail = mr->nSize - FIELD_OFFSET( struct emr_namedescape, Data );
+        if ((esc->cjDriver & 1) || esc->cjDriver > avail || esc->cjIn > avail - esc->cjDriver) break;
+        if (!(name = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, esc->cjDriver + sizeof(WCHAR) ))) break;
+        memcpy( name, esc->Data, esc->cjDriver );
+        TRACE( "NamedEscape: driver %s, escape %d, %d bytes\n", debugstr_w(name), esc->iEscape, esc->cjIn );
+        NamedEscape( hdc, name, esc->iEscape, esc->cjIn, (const char *)esc->Data + esc->cjDriver, 0, NULL );
+        HeapFree( GetProcessHeap(), 0, name );
+        break;
+      }
+
+    case EMR_STARTDOC:           /* not a record of [MS-EMF]: nothing to play */
+    case EMR_FORCEUFIMAPPING:    /* font mapping by UniversalFontId: Wine fonts have none, the LogFont is used */
     case EMR_SETLINKEDUFI:
+      TRACE( "record %s ignored\n", get_emr_name( type ));
+      break;
+
+    case EMR_GLSRECORD:          /* OpenGL command streams, the data format is not specified */
+    case EMR_GLSBOUNDEDRECORD:
+    case EMR_COLORCORRECTPALETTE: /* needs a WCS colour transform, which Wine does not have */
     case EMR_COLORMATCHTOTARGETW:
 
     default:
-- 
