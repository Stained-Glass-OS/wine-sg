+/* ---- data transfer: the document is offered as Unicode text, ANSI text and "HTML Format" */
+static UINT cf_html_format(void)
+{
+    static UINT cf;
+    if (!cf) cf = RegisterClipboardFormatW(L"HTML Format");
+    return cf;
+}
+
+static HGLOBAL data_for_format(const WCHAR *html, UINT cf)
+{
+    int len = html ? lstrlenW(html) : 0, size;
+    HGLOBAL mem = NULL;
+    char *p;
+
+    if (cf == CF_UNICODETEXT)
+    {
+        if ((mem = GlobalAlloc(GMEM_MOVEABLE, (len + 1) * sizeof(WCHAR))))
+        {
+            p = GlobalLock(mem);
+            memcpy(p, html ? html : L"", len * sizeof(WCHAR));
+            ((WCHAR *)p)[len] = 0;
+            GlobalUnlock(mem);
+        }
+    }
+    else if (cf == CF_TEXT)
+    {
+        size = WideCharToMultiByte(CP_ACP, 0, html, len, NULL, 0, NULL, NULL);
+        if ((mem = GlobalAlloc(GMEM_MOVEABLE, size + 1)))
+        {
+            p = GlobalLock(mem);
+            WideCharToMultiByte(CP_ACP, 0, html, len, p, size, NULL, NULL);
+            p[size] = 0;
+            GlobalUnlock(mem);
+        }
+    }
+    else if (cf == cf_html_format())
+    {
+        static const char head_fmt[] = "Version:0.9\r\nStartHTML:%010d\r\nEndHTML:%010d\r\nStartFragment:%010d\r\nEndFragment:%010d\r\n";
+        char head[128];
+        int hlen = sprintf(head, head_fmt, 0, 0, 0, 0);
+
+        size = WideCharToMultiByte(CP_UTF8, 0, html, len, NULL, 0, NULL, NULL);
+        if ((mem = GlobalAlloc(GMEM_MOVEABLE, hlen + size + 1)))
+        {
+            p = GlobalLock(mem);
+            sprintf(p, head_fmt, hlen, hlen + size, hlen, hlen + size);
+            WideCharToMultiByte(CP_UTF8, 0, html, len, p + hlen, size, NULL, NULL);
+            p[hlen + size] = 0;
+            GlobalUnlock(mem);
+        }
+    }
+    return mem;
+}
+
+static HRESULT check_format(const FORMATETC *fmt)
+{
+    if (!fmt) return E_INVALIDARG;
+    if (fmt->cfFormat != CF_UNICODETEXT && fmt->cfFormat != CF_TEXT && fmt->cfFormat != cf_html_format())
+        return DV_E_FORMATETC;
+    if (!(fmt->dwAspect & DVASPECT_CONTENT)) return DV_E_DVASPECT;
+    if (!(fmt->tymed & TYMED_HGLOBAL)) return DV_E_TYMED;
+    return S_OK;
+}
+
+static HRESULT html_get_data(const WCHAR *html, FORMATETC *fmt, STGMEDIUM *medium)
+{
+    HRESULT hr = check_format(fmt);
+
+    if (FAILED(hr)) return hr;
+    if (!medium) return E_INVALIDARG;
+    if (!(medium->hGlobal = data_for_format(html, fmt->cfFormat))) return E_OUTOFMEMORY;
+    medium->tymed = TYMED_HGLOBAL;
+    medium->pUnkForRelease = NULL;
+    return S_OK;
+}
+
+static HRESULT html_get_data_here(const WCHAR *html, FORMATETC *fmt, STGMEDIUM *medium)
+{
+    HRESULT hr = check_format(fmt);
+    HGLOBAL mem;
+    SIZE_T need;
+
+    if (FAILED(hr)) return hr;
+    if (!medium || medium->tymed != TYMED_HGLOBAL || !medium->hGlobal) return DV_E_TYMED;
+    if (!(mem = data_for_format(html, fmt->cfFormat))) return E_OUTOFMEMORY;
+    need = GlobalSize(mem);
+    if (GlobalSize(medium->hGlobal) < need)
+        hr = STG_E_MEDIUMFULL;
+    else
+    {
+        memcpy(GlobalLock(medium->hGlobal), GlobalLock(mem), need);
+        GlobalUnlock(medium->hGlobal);
+        GlobalUnlock(mem);
+    }
+    GlobalFree(mem);
+    return hr;
+}
+
+static HRESULT html_enum_format_etc(DWORD direction, IEnumFORMATETC **enum_fmt)
+{
+    FORMATETC fmts[3] = {
+        { CF_UNICODETEXT, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL },
+        { CF_TEXT, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL },
+        { 0, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL },
+    };
+
+    if (!enum_fmt) return E_POINTER;
+    if (direction != DATADIR_GET) return E_NOTIMPL;
+    fmts[2].cfFormat = cf_html_format();
+    return SHCreateStdEnumFmtEtc(ARRAY_SIZE(fmts), fmts, enum_fmt);
+}
+
+/* the HTML source from a data object, preferring "HTML Format" */
+static WCHAR *html_from_data_object(IDataObject *data)
+{
+    UINT formats[3] = { cf_html_format(), CF_UNICODETEXT, CF_TEXT };
+    WCHAR *ret = NULL;
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(formats) && !ret; i++)
+    {
+        FORMATETC fmt = { formats[i], NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+        STGMEDIUM medium;
+        const char *p;
+        SIZE_T size;
+
+        if (FAILED(IDataObject_GetData(data, &fmt, &medium))) continue;
+        if (medium.tymed == TYMED_HGLOBAL && (p = GlobalLock(medium.hGlobal)))
+        {
+            size = GlobalSize(medium.hGlobal);
+            if (formats[i] == CF_UNICODETEXT)
+            {
+                ret = HeapAlloc(GetProcessHeap(), 0, size + sizeof(WCHAR));
+                if (ret) { memcpy(ret, p, size); ret[size / sizeof(WCHAR)] = 0; }
+            }
+            else if (formats[i] == CF_TEXT)
+                ret = html_from_bytes((const BYTE *)p, strnlen(p, size));
+            else
+            {
+                /* the fragment between StartHTML and EndHTML */
+                const char *a = strstr(p, "StartHTML:"), *b = strstr(p, "EndHTML:");
+                int start = a ? atoi(a + 10) : 0, end = b ? atoi(b + 8) : 0;
+                if (start > 0 && end >= start && (SIZE_T)end <= size)
+                    ret = html_from_bytes((const BYTE *)p + start, end - start);
+            }
+            GlobalUnlock(medium.hGlobal);
+        }
+        ReleaseStgMedium(&medium);
+    }
+    return ret;
+}
+
+typedef struct
+{
+    IDataObject IDataObject_iface;
+    LONG ref;
+    WCHAR *html;
+    IDataAdviseHolder *holder;
+} SnapshotData;
+
+static inline SnapshotData *impl_from_snapshot(IDataObject *iface)
+{
+    return CONTAINING_RECORD(iface, SnapshotData, IDataObject_iface);
+}
+
+static HRESULT WINAPI Snapshot_QueryInterface(IDataObject *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDataObject))
+    {
+        IDataObject_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI Snapshot_AddRef(IDataObject *iface)
+{
+    return InterlockedIncrement(&impl_from_snapshot(iface)->ref);
+}
+
+static ULONG WINAPI Snapshot_Release(IDataObject *iface)
+{
+    SnapshotData *This = impl_from_snapshot(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        if (This->holder) IDataAdviseHolder_Release(This->holder);
+        HeapFree(GetProcessHeap(), 0, This->html);
+        HeapFree(GetProcessHeap(), 0, This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI Snapshot_GetData(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium)
+{
+    return html_get_data(impl_from_snapshot(iface)->html, fmt, medium);
+}
+
+static HRESULT WINAPI Snapshot_GetDataHere(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium)
+{
+    return html_get_data_here(impl_from_snapshot(iface)->html, fmt, medium);
+}
+
+static HRESULT WINAPI Snapshot_QueryGetData(IDataObject *iface, FORMATETC *fmt)
+{
+    return check_format(fmt);
+}
+
+static HRESULT WINAPI Snapshot_GetCanonicalFormatEtc(IDataObject *iface, FORMATETC *in, FORMATETC *out)
+{
+    if (!out) return E_INVALIDARG;
+    out->ptd = NULL;
+    return DATA_S_SAMEFORMATETC;
+}
+
+static HRESULT WINAPI Snapshot_SetData(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *medium, BOOL release)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI Snapshot_EnumFormatEtc(IDataObject *iface, DWORD direction, IEnumFORMATETC **enum_fmt)
+{
+    return html_enum_format_etc(direction, enum_fmt);
+}
+
+static HRESULT WINAPI Snapshot_DAdvise(IDataObject *iface, FORMATETC *fmt, DWORD advf, IAdviseSink *sink, DWORD *conn)
+{
+    SnapshotData *This = impl_from_snapshot(iface);
+    HRESULT hr;
+
+    if (!This->holder && FAILED(hr = CreateDataAdviseHolder(&This->holder))) return hr;
+    return IDataAdviseHolder_Advise(This->holder, iface, fmt, advf, sink, conn);
+}
+
+static HRESULT WINAPI Snapshot_DUnadvise(IDataObject *iface, DWORD conn)
+{
+    SnapshotData *This = impl_from_snapshot(iface);
+
+    if (!This->holder) return OLE_E_NOCONNECTION;
+    return IDataAdviseHolder_Unadvise(This->holder, conn);
+}
+
+static HRESULT WINAPI Snapshot_EnumDAdvise(IDataObject *iface, IEnumSTATDATA **enum_advise)
+{
+    SnapshotData *This = impl_from_snapshot(iface);
+
+    if (!This->holder) return OLE_E_ADVISENOTSUPPORTED;
+    return IDataAdviseHolder_EnumAdvise(This->holder, enum_advise);
+}
+
+static const IDataObjectVtbl SnapshotDataVtbl = {
+    Snapshot_QueryInterface,
+    Snapshot_AddRef,
+    Snapshot_Release,
+    Snapshot_GetData,
+    Snapshot_GetDataHere,
+    Snapshot_QueryGetData,
+    Snapshot_GetCanonicalFormatEtc,
+    Snapshot_SetData,
+    Snapshot_EnumFormatEtc,
+    Snapshot_DAdvise,
+    Snapshot_DUnadvise,
+    Snapshot_EnumDAdvise
+};
+
+/* a data object holding a copy of the document that does not change (IOleObject::GetClipboardData) */
+static HRESULT create_snapshot_data(const WCHAR *html, IDataObject **out)
+{
+    SnapshotData *This;
+
+    if (!(This = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IDataObject_iface.lpVtbl = &SnapshotDataVtbl;
+    This->ref = 1;
+    if (!(This->html = HeapAlloc(GetProcessHeap(), 0, ((html ? lstrlenW(html) : 0) + 1) * sizeof(WCHAR))))
+    {
+        HeapFree(GetProcessHeap(), 0, This);
+        return E_OUTOFMEMORY;
+    }
+    lstrcpyW(This->html, html ? html : L"");
+    *out = &This->IDataObject_iface;
+    return S_OK;
+}
