+/* ---- enumerators for the connection point container and the connection point */
+typedef struct
+{
+    IEnumConnectionPoints IEnumConnectionPoints_iface;
+    LONG ref;
+    IConnectionPoint *point;   /* the one connection point */
+    ULONG pos;
+} EnumPoints;
+
+static inline EnumPoints *impl_from_IEnumConnectionPoints(IEnumConnectionPoints *iface)
+{
+    return CONTAINING_RECORD(iface, EnumPoints, IEnumConnectionPoints_iface);
+}
+
+static HRESULT WINAPI EnumPoints_QueryInterface(IEnumConnectionPoints *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IEnumConnectionPoints))
+    {
+        IEnumConnectionPoints_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumPoints_AddRef(IEnumConnectionPoints *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumConnectionPoints(iface)->ref);
+}
+
+static ULONG WINAPI EnumPoints_Release(IEnumConnectionPoints *iface)
+{
+    EnumPoints *This = impl_from_IEnumConnectionPoints(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IConnectionPoint_Release(This->point);
+        HeapFree(GetProcessHeap(), 0, This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI EnumPoints_Next(IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **points, ULONG *fetched)
+{
+    EnumPoints *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG n = 0;
+
+    if (!points || (!fetched && count != 1)) return E_POINTER;
+    if (count && This->pos < 1)
+    {
+        IConnectionPoint_AddRef(This->point);
+        points[n++] = This->point;
+        This->pos++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumPoints_Skip(IEnumConnectionPoints *iface, ULONG count)
+{
+    EnumPoints *This = impl_from_IEnumConnectionPoints(iface);
+    ULONG left = This->pos < 1 ? 1 - This->pos : 0;
+
+    This->pos += min(count, left);
+    return count <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumPoints_Reset(IEnumConnectionPoints *iface)
+{
+    impl_from_IEnumConnectionPoints(iface)->pos = 0;
+    return S_OK;
+}
