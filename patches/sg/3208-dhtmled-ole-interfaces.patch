+{
+    EnumPoints *This = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*This));
+
+    if (!This) return E_OUTOFMEMORY;
+    This->IEnumConnectionPoints_iface.lpVtbl = &EnumPointsVtbl;
+    This->ref = 1;
+    This->point = point;
+    IConnectionPoint_AddRef(point);
+    This->pos = pos;
+    *out = &This->IEnumConnectionPoints_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumPoints_Clone(IEnumConnectionPoints *iface, IEnumConnectionPoints **out)
+{
