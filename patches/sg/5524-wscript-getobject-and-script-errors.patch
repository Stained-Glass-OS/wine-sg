From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wscript, cscript: WScript.GetObject, and unhandled script errors are reported

WScript.GetObject was E_NOTIMPL: GetObject(path) now opens a file or moniker
name (CoGetObject), GetObject(path, progid) creates the ProgID's object and
loads the file into it, GetObject("", progid) creates the object, and
neither is an error. Event prefixes are not connected (the object is returned
and a FIXME says so).

An error a script raised and nothing handled was dropped silently (the site's
OnScriptError was E_NOTIMPL) and the host exited 0. It is now reported --
file, line, column, source and description on the console in cscript, a
message box in the interactive host -- and the exit code is 1.
OnScriptTerminate succeeds.
---
--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -62,7 +62,7 @@ static HRESULT to_string(VARIANT *src, BSTR *dst)
     return S_OK;
 }
 
-static void print_string(const WCHAR *string)
+void print_string(const WCHAR *string)
 {
     DWORD count, ret, len, lena;
     char *buf;
@@ -379,12 +379,61 @@ static HRESULT WINAPI Host_Echo(IHost *iface, SAFEARRAY *args)
     return S_OK;
 }
 
+/* WScript.GetObject(pathname, progid, prefix): a file or moniker name opens
+ * the object it names; with a ProgID as well, a new object of that class loads
+ * the file; with an empty path the ProgID's class is created. Event prefixes
+ * (connecting the object's events to handlers) are not supported: the object
+ * is returned without them. */
 static HRESULT WINAPI Host_GetObject(IHost *iface, BSTR Pathname, BSTR ProgID,
         BSTR Prefix, IDispatch **out_Dispatch)
 {
-    WINE_FIXME("(%s %s %s %p)\n", wine_dbgstr_w(Pathname), wine_dbgstr_w(ProgID),
+    BOOL have_path = Pathname && *Pathname, have_progid = ProgID && *ProgID;
+    IPersistFile *persist;
+    IUnknown *unk;
+    GUID guid;
+    HRESULT hres;
+
+    TRACE("(%s %s %s %p)\n", wine_dbgstr_w(Pathname), wine_dbgstr_w(ProgID),
         wine_dbgstr_w(Prefix), out_Dispatch);
-    return E_NOTIMPL;
+
+    if(!out_Dispatch) return E_POINTER;
+    *out_Dispatch = NULL;
+    if(Prefix && *Prefix)
+        FIXME("Prefix %s: events are not connected\n", debugstr_w(Prefix));
+
+    if(have_path && !have_progid) {
+#ifdef SG_MUTANT_WSH_GETOBJECT_NOTIMPL
+        return E_NOTIMPL;
+#endif
+        return CoGetObject(Pathname, NULL, &IID_IDispatch, (void**)out_Dispatch);
+    }
+
+    if(!have_progid)
+        return E_INVALIDARG;
+
+    hres = CLSIDFromProgID(ProgID, &guid);
+    if(FAILED(hres))
+        return hres;
+    hres = CoCreateInstance(&guid, NULL, CLSCTX_INPROC_SERVER|CLSCTX_LOCAL_SERVER|CLSCTX_REMOTE_SERVER,
+            &IID_IUnknown, (void**)&unk);
+    if(FAILED(hres))
+        return hres;
+
+    if(have_path) {
+        hres = IUnknown_QueryInterface(unk, &IID_IPersistFile, (void**)&persist);
+        if(SUCCEEDED(hres)) {
+            hres = IPersistFile_Load(persist, Pathname, STGM_READ);
+            IPersistFile_Release(persist);
+        }
+        if(FAILED(hres)) {
+            IUnknown_Release(unk);
+            return hres;
+        }
+    }
+
+    hres = IUnknown_QueryInterface(unk, &IID_IDispatch, (void**)out_Dispatch);
+    IUnknown_Release(unk);
+    return hres;
 }
 
 static HRESULT WINAPI Host_DisconnectObject(IHost *iface, IDispatch *Object)
--- a/programs/wscript/main.c
+++ b/programs/wscript/main.c
@@ -48,6 +48,7 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(wscript);
 WCHAR scriptFullName[MAX_PATH];
+int script_exit_code;
 
 ITypeInfo *host_ti;
 ITypeInfo *arguments_ti;
@@ -109,8 +110,8 @@ static HRESULT WINAPI ActiveScriptSite_GetDocVersionString(IActiveScriptSite *if
 static HRESULT WINAPI ActiveScriptSite_OnScriptTerminate(IActiveScriptSite *iface,
         const VARIANT *pvarResult, const EXCEPINFO *pexcepinfo)
 {
-    WINE_FIXME("()\n");
-    return E_NOTIMPL;
+    WINE_TRACE("()\n");
+    return S_OK;
 }
 
 static HRESULT WINAPI ActiveScriptSite_OnStateChange(IActiveScriptSite *iface,
@@ -120,11 +121,43 @@ static HRESULT WINAPI ActiveScriptSite_OnStateChange(IActiveScriptSite *iface,
     return S_OK;
 }
 
+/* The line comes back as the host numbered it (ParseScriptText is given 1 as the
+ * first line), the column from zero. An error the script raised that nothing handled: reported as the host does
+ * (a message box in the interactive host, a line on the console in the batch
+ * one), and the script's exit code becomes 1. */
 static HRESULT WINAPI ActiveScriptSite_OnScriptError(IActiveScriptSite *iface,
         IActiveScriptError *pscripterror)
 {
-    WINE_FIXME("()\n");
-    return E_NOTIMPL;
+    EXCEPINFO excepinfo = {0};
+    DWORD context, line = 0;
+    LONG column = 0;
+    WCHAR buf[2048];
+    const WCHAR *source, *desc;
+
+    WINE_TRACE("(%p)\n", pscripterror);
+
+    script_exit_code = 1;
+    if(!pscripterror)
+        return S_OK;
+
+    if(FAILED(IActiveScriptError_GetExceptionInfo(pscripterror, &excepinfo)))
+        return S_OK;
+    IActiveScriptError_GetSourcePosition(pscripterror, &context, &line, &column);
+    source = excepinfo.bstrSource ? excepinfo.bstrSource : L"";
+    desc = excepinfo.bstrDescription ? excepinfo.bstrDescription : L"";
+
+    if(wshInteractive)
+        swprintf(buf, ARRAY_SIZE(buf), L"Script: %ls\nLine: %lu\nChar: %ld\nError: %ls\nCode: %08lX\nSource: %ls",
+                 scriptFullName, line, column + 1, desc, (DWORD)(excepinfo.scode ? excepinfo.scode : excepinfo.wCode),
+                 source);
+    else
+        swprintf(buf, ARRAY_SIZE(buf), L"%ls(%lu, %ld) %ls: %ls", scriptFullName, line, column + 1, source, desc);
+    print_string(buf);
+
+    SysFreeString(excepinfo.bstrSource);
+    SysFreeString(excepinfo.bstrDescription);
+    SysFreeString(excepinfo.bstrHelpFile);
+    return S_OK;
 }
 
 static HRESULT WINAPI ActiveScriptSite_OnEnterScript(IActiveScriptSite *iface)
@@ -464,5 +497,5 @@ int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE hPrevInst, LPWSTR cmdline, int cm
 
     CoUninitialize();
 
-    return 0;
+    return script_exit_code;
 }
--- a/programs/wscript/wscript.h
+++ b/programs/wscript/wscript.h
@@ -33,3 +33,7 @@ extern WCHAR **argums;
 extern int numOfArgs;
 
 extern VARIANT_BOOL wshInteractive;
+
+extern int script_exit_code;
+
+void print_string(const WCHAR *string);
