From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: quiet no-ops, GetAssemblyMDImport crash (3508)

mscoree: quieter no-ops, GetAssemblyMDImport crash

useLegacyV2RuntimeActivationPolicy and sku= are read and noted instead of logged as unimplemented, class
factory LockServer, CoEEShutDownCOM and CoInitializeCor are quiet, and GetAssemblyMDImport dereferenced its
output pointer in a trace.
---
--- a/dlls/mscoree/config.c
+++ b/dlls/mscoree/config.c
@@ -331,7 +331,7 @@ static HRESULT parse_startup(ConfigFileHandler *This, ISAXAttributes *pAttr)
 
     hr = ISAXAttributes_getValueFromName(pAttr, empty, 0, legacy, lstrlenW(legacy), &value, &value_size);
     if (SUCCEEDED(hr))
-        FIXME("useLegacyV2RuntimeActivationPolicy=%s not implemented\n", debugstr_wn(value, value_size));
+        TRACE("useLegacyV2RuntimeActivationPolicy=%s is not acted on\n", debugstr_wn(value, value_size));
     hr = S_OK;
 
     return hr;
@@ -397,7 +397,7 @@ static HRESULT parse_supported_runtime(ConfigFileHandler *This, ISAXAttributes *
     {
         hr = ISAXAttributes_getValueFromName(pAttr, empty, 0, sku, lstrlenW(sku), &value, &value_size);
         if (SUCCEEDED(hr))
-            FIXME("sku=%s not implemented\n", debugstr_wn(value, value_size));
+            TRACE("sku=%s is not acted on\n", debugstr_wn(value, value_size));
         hr = S_OK;
     }
 
--- a/dlls/mscoree/mscoree_main.c
+++ b/dlls/mscoree/mscoree_main.c
@@ -183,7 +183,7 @@ static HRESULT WINAPI mscorecf_CreateInstance(IClassFactory *iface,LPUNKNOWN pOu
 
 static HRESULT WINAPI mscorecf_LockServer(IClassFactory *iface, BOOL dolock)
 {
-    FIXME("(%p)->(%d),stub!\n",iface,dolock);
+    TRACE("(%p)->(%d)\n",iface,dolock);
     return S_OK;
 }
 
@@ -509,13 +509,13 @@ HRESULT WINAPI LockClrVersion(FLockClrVersionCallback hostCallback, FLockClrVers
 
 HRESULT WINAPI CoInitializeCor(DWORD fFlags)
 {
-    FIXME("(0x%08lx): stub\n", fFlags);
+    TRACE("(0x%08lx)\n", fFlags);
     return S_OK;
 }
 
 HRESULT WINAPI GetAssemblyMDImport(LPCWSTR szFileName, REFIID riid, IUnknown **ppIUnk)
 {
-    FIXME("(%p %s, %s, %p): stub\n", szFileName, debugstr_w(szFileName), debugstr_guid(riid), *ppIUnk);
+    FIXME("(%p %s, %s, %p): stub\n", szFileName, debugstr_w(szFileName), debugstr_guid(riid), ppIUnk);
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
@@ -971,7 +971,8 @@ HRESULT WINAPI DllUnregisterServer(void)
 
 void WINAPI CoEEShutDownCOM(void)
 {
-    FIXME("stub.\n");
+    /* nothing of the COM exports to shut down: the runtime hosted here keeps no state of them */
+    TRACE("\n");
 }
 
 INT WINAPI ND_RU1( const void *ptr, INT offset )
