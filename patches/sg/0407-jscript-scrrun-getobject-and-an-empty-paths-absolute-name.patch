From: Stained Glass OS contributors
Subject: jscript, scrrun: GetObject, and an empty path's absolute name

What installer script custom actions need, found in the OpenVPN MSI, whose
JScript actions stopped its install one after the other:

- jscript: GetObject(pathname) was E_NOTIMPL. It now binds the moniker the
  name parses to -- "winmgmts://./root/cimv2" (WMI), a file -- as VBScript's
  GetObject does; not in the untrusted-script safety modes. (The
  two-argument form, by class, is still a FIXME.)
- scrrun: FileSystemObject.GetAbsolutePathName("") failed (E_FAIL); on
  Windows it is the current directory. OpenVPN's installer asks it for the
  install directory before that is known.

With these the OpenVPN 2.6 MSI installs (its Wintun/TAP/DCO driver
features cannot: they are kernel drivers -- the tunnel is sg-netctl's).

Gate: test/jscript-gate.sh (3 of its 4 checks fail without this patch).
---
--- a/dlls/jscript/global.c
+++ b/dlls/jscript/global.c
@@ -22,6 +22,7 @@
 
 #include "jscript.h"
 #include "engine.h"
+#include "objsafe.h"
 
 #include "wine/debug.h"
 
@@ -496,11 +497,61 @@
     return S_OK;
 }
 
+/* GetObject(pathname): the object a moniker names -- "winmgmts:..." (WMI),
+ * a file -- as VBScript's GetObject does. Installer script custom actions
+ * (OpenVPN's) and admin scripts ask WMI this way. Not for untrusted scripts. */
 static HRESULT JSGlobal_GetObject(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
         jsval_t *r)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    const WCHAR *name;
+    IBindCtx *bind_ctx;
+    IUnknown *unk;
+    IDispatch *disp;
+    IMoniker *mon;
+    ULONG eaten = 0;
+    jsstr_t *str;
+    HRESULT hres;
+
+    TRACE("\n");
+
+    if(ctx->safeopt & (INTERFACE_USES_SECURITY_MANAGER|INTERFACESAFE_FOR_UNTRUSTED_DATA)) {
+        WARN("blocked in current safety mode\n");
+        return JS_E_CANNOT_CREATE_OBJ;
+    }
+    if(argc != 1) {
+        FIXME("GetObject with %u arguments\n", argc);
+        return E_NOTIMPL;
+    }
+
+    hres = to_flat_string(ctx, argv[0], &str, &name);
+    if(FAILED(hres))
+        return hres;
+
+    hres = CreateBindCtx(0, &bind_ctx);
+    if(SUCCEEDED(hres)) {
+        hres = MkParseDisplayName(bind_ctx, name, &eaten, &mon);
+        if(SUCCEEDED(hres)) {
+            hres = IMoniker_BindToObject(mon, bind_ctx, NULL, &IID_IUnknown, (void**)&unk);
+            IMoniker_Release(mon);
+        }else {
+            hres = MK_E_SYNTAX;
+        }
+        IBindCtx_Release(bind_ctx);
+    }
+    jsstr_release(str);
+    if(FAILED(hres))
+        return hres;
+
+    hres = IUnknown_QueryInterface(unk, &IID_IDispatch, (void**)&disp);
+    IUnknown_Release(unk);
+    if(FAILED(hres))
+        return JS_E_CANNOT_CREATE_OBJ;
+
+    if(r)
+        *r = jsval_disp(disp);
+    else
+        IDispatch_Release(disp);
+    return S_OK;
 }
 
 static HRESULT JSGlobal_ScriptEngine(script_ctx_t *ctx, jsval_t vthis, WORD flags, unsigned argc, jsval_t *argv,
--- a/dlls/scrrun/filesystem.c
+++ b/dlls/scrrun/filesystem.c
@@ -3443,7 +3443,9 @@
     if(!pbstrResult)
         return E_POINTER;
 
-    len = GetFullPathNameW(path ? path : L".", MAX_PATH, buf, NULL);
+    /* an empty path is the current directory (the OpenVPN installer's script
+     * custom action asks, before the install directory is known) */
+    len = GetFullPathNameW(path && *path ? path : L".", MAX_PATH, buf, NULL);
     if(!len)
         return E_FAIL;
 
