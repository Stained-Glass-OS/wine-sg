From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: buffered animations end with their window (3725)

uxtheme: buffered animations end with their window

The animation timer of 3713 kept running (200 ticks in 3 s) after the
animated window was destroyed. The timer now drops an animation whose
window is gone and ends with the last one, and BufferedPaintUnInit ends
the calling thread's animations.
---
diff --git a/dlls/uxtheme/buffer.c b/dlls/uxtheme/buffer.c
index 418023c..71cfe5a 100644
--- a/dlls/uxtheme/buffer.c
+++ b/dlls/uxtheme/buffer.c
@@ -71,12 +71,17 @@ HRESULT WINAPI BufferedPaintInit(VOID)
     return S_OK;
 }
 
+static void drop_thread_animations(void);
+
 /***********************************************************************
  *      BufferedPaintUnInit                                (UXTHEME.@)
  */
 HRESULT WINAPI BufferedPaintUnInit(VOID)
 {
     TRACE("()\n");
+#ifndef SG_MUTANT_UX_UNINIT
+    drop_thread_animations();
+#endif
     return S_OK;
 }
 
@@ -421,18 +426,27 @@ static void free_animation(struct animation *anim)
     free(anim);
 }
 
-/* the thread's timer: ask for a repaint of what is animating */
+/* the thread's timer: ask for a repaint of what is animating; an animation
+ * whose window is gone is dropped, and the timer ends with the last one */
 static VOID CALLBACK animation_timer(HWND timer_hwnd, UINT msg, UINT_PTR id, DWORD time)
 {
-    struct animation *anim;
+    struct animation *anim, *next;
     BOOL any = FALSE;
 
     EnterCriticalSection(&animation_cs);
-    LIST_FOR_EACH_ENTRY(anim, &animations, struct animation, entry)
+    LIST_FOR_EACH_ENTRY_SAFE(anim, next, &animations, struct animation, entry)
     {
         if (!anim->running || anim->thread != GetCurrentThreadId()) continue;
+#ifndef SG_MUTANT_UX_DEADWND
+        if (!IsWindow(anim->hwnd))
+        {
+            if (anim->timer) KillTimer(NULL, anim->timer);
+            free_animation(anim);
+            continue;
+        }
+#endif
         any = TRUE;
-        if (IsWindow(anim->hwnd)) InvalidateRect(anim->hwnd, &anim->rect, FALSE);
+        InvalidateRect(anim->hwnd, &anim->rect, FALSE);
     }
     if (!any) KillTimer(NULL, id);
     LeaveCriticalSection(&animation_cs);
@@ -603,6 +617,21 @@ BOOL WINAPI BufferedPaintRenderAnimation(HWND hwnd, HDC hdcTarget)
     return ret;
 }
 
+/* BufferedPaintUnInit: the thread's animations end with its buffered painting */
+static void drop_thread_animations(void)
+{
+    struct animation *anim, *next;
+
+    EnterCriticalSection(&animation_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(anim, next, &animations, struct animation, entry)
+    {
+        if (anim->thread != GetCurrentThreadId()) continue;
+        if (anim->timer) KillTimer(NULL, anim->timer);
+        free_animation(anim);
+    }
+    LeaveCriticalSection(&animation_cs);
+}
+
 /***********************************************************************
  *      BufferedPaintStopAllAnimations                     (UXTHEME.@)
  */
