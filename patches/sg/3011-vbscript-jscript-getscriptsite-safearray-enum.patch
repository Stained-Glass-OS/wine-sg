From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 11:28:54 -0700
Subject: [PATCH] vbscript, jscript: GetScriptSite; vbscript: For Each over any
 SAFEARRAY (3011)

IActiveScript::GetScriptSite returns an interface of the site instead of
E_NOTIMPL in both engines. The SAFEARRAY enumerator of vbscript handles Next with
more than one element, Skip, Reset and Clone, and enumerates arrays that are
not arrays of VARIANT (strings, longs, objects).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/jscript/jscript.c b/dlls/jscript/jscript.c
index c42109b..7f70cfc 100644
--- a/dlls/jscript/jscript.c
+++ b/dlls/jscript/jscript.c
@@ -808,8 +808,13 @@ static HRESULT WINAPI JScript_GetScriptSite(IActiveScript *iface, REFIID riid,
                                             void **ppvObject)
 {
     JScript *This = impl_from_IActiveScript(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), ppvObject);
+
+    if(!This->site)
+        return E_FAIL;
+
+    return IActiveScriptSite_QueryInterface(This->site, riid, ppvObject);
 }
 
 static HRESULT WINAPI JScript_SetScriptState(IActiveScript *iface, SCRIPTSTATE ss)
diff --git a/dlls/vbscript/utils.c b/dlls/vbscript/utils.c
index 4bfc2c6..d40d1b0 100644
--- a/dlls/vbscript/utils.c
+++ b/dlls/vbscript/utils.c
@@ -30,6 +30,7 @@ typedef struct {
     SAFEARRAY *sa;
     BOOL owned;
     ULONG i, size;
+    VARTYPE vt;
 } safearray_iter;
 
 static inline safearray_iter *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
@@ -87,58 +88,108 @@ static ULONG WINAPI safearray_iter_IEnumVARIANT_Release(IEnumVARIANT *iface)
     return ref;
 }
 
+static HRESULT safearray_iter_get(safearray_iter *This, VARIANT *ret)
+{
+    BYTE *elem = (BYTE*)This->sa->pvData + This->i * This->sa->cbElements;
+    VARIANT ref;
+
+    if(This->vt == VT_VARIANT)
+        return VariantCopy(ret, (VARIANT*)elem);
+
+    V_VT(&ref) = This->vt | VT_BYREF;
+    V_BYREF(&ref) = elem;
+    return VariantCopyInd(ret, &ref);
+}
+
 static HRESULT WINAPI safearray_iter_IEnumVARIANT_Next(IEnumVARIANT *iface,
         ULONG celt, VARIANT *rgVar, ULONG *pCeltFetched)
 {
     safearray_iter *This = impl_from_IEnumVARIANT(iface);
-    HRESULT hres;
-    VARIANT *v;
+    ULONG fetched = 0;
+    HRESULT hres = S_OK;
 
     TRACE("(%p)->(%lu %p %p)\n", This, celt, rgVar, pCeltFetched);
 
-    if(celt != 1) {
-        FIXME("celt != 1\n");
-        return E_NOTIMPL;
-    }
+    if(!rgVar)
+        return E_POINTER;
 
-    if(This->i >= This->size) {
-        if(pCeltFetched)
-            *pCeltFetched = 0;
-        return S_FALSE;
+    if(This->i < This->size && !This->sa->cLocks)
+        ERR("SAFEARRAY not locked\n");
+
+    while(fetched < celt && This->i < This->size) {
+        V_VT(&rgVar[fetched]) = VT_EMPTY;
+        hres = safearray_iter_get(This, &rgVar[fetched]);
+        if(FAILED(hres))
+            break;
+        This->i++;
+        fetched++;
     }
 
-    if(!This->sa->cLocks)
-        ERR("SAFEARRAY not locked\n");
+    if(FAILED(hres)) {
+        while(fetched--)
+            VariantClear(&rgVar[fetched]);
+        fetched = 0;
+    }
 
-    v = (VARIANT*)(((BYTE*)This->sa->pvData) + This->i * This->sa->cbElements);
-    V_VT(rgVar) = VT_EMPTY;
-    hres = VariantCopy(rgVar, v);
+    if(pCeltFetched)
+        *pCeltFetched = fetched;
     if(FAILED(hres))
         return hres;
-
-    This->i++;
-    if(pCeltFetched)
-        *pCeltFetched = 1;
-    return S_OK;
+    return fetched == celt ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI safearray_iter_IEnumVARIANT_Skip(IEnumVARIANT *iface, ULONG celt)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    safearray_iter *This = impl_from_IEnumVARIANT(iface);
+
+    TRACE("(%p)->(%lu)\n", This, celt);
+
+    if(celt > This->size - This->i) {
+        This->i = This->size;
+        return S_FALSE;
+    }
+    This->i += celt;
+    return S_OK;
 }
 
 static HRESULT WINAPI safearray_iter_IEnumVARIANT_Reset(IEnumVARIANT *iface)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    safearray_iter *This = impl_from_IEnumVARIANT(iface);
+
+    TRACE("(%p)\n", This);
+
+    This->i = 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI safearray_iter_IEnumVARIANT_Clone(
         IEnumVARIANT *iface, IEnumVARIANT **ppEnum)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    safearray_iter *This = impl_from_IEnumVARIANT(iface);
+    SAFEARRAY *sa = This->sa;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, ppEnum);
+
+    if(!ppEnum)
+        return E_POINTER;
+
+    /* An owned array is destroyed with its iterator, so the clone needs its own copy. */
+    if(sa && This->owned) {
+        hres = SafeArrayCopy(sa, &sa);
+        if(FAILED(hres))
+            return hres;
+    }
+
+    hres = create_safearray_iter(sa, This->owned, ppEnum);
+    if(FAILED(hres)) {
+        if(sa && This->owned)
+            SafeArrayDestroy(sa);
+        return hres;
+    }
+
+    ((safearray_iter*)impl_from_IEnumVARIANT(*ppEnum))->i = This->i;
+    return S_OK;
 }
 
 static const IEnumVARIANTVtbl safearray_iter_EnumVARIANTVtbl = {
@@ -169,9 +220,14 @@ HRESULT create_safearray_iter(SAFEARRAY *sa, BOOL owned, IEnumVARIANT **ev)
     safearray_iter *iter;
     HRESULT hres;
 
+    VARTYPE vt = VT_VARIANT;
+
     if(sa && !(sa->fFeatures & FADF_VARIANT)) {
-        FIXME("enumeration not supported: %x\n", sa->fFeatures);
-        return E_NOTIMPL;
+        hres = SafeArrayGetVartype(sa, &vt);
+        if(FAILED(hres) || vt == VT_RECORD || vt == VT_EMPTY) {
+            FIXME("enumeration not supported: %x\n", sa->fFeatures);
+            return E_NOTIMPL;
+        }
     }
 
     iter = malloc(sizeof(*iter));
@@ -192,6 +248,7 @@ HRESULT create_safearray_iter(SAFEARRAY *sa, BOOL owned, IEnumVARIANT **ev)
     iter->owned = owned;
     iter->i = 0;
     iter->size = get_safearray_size(sa);
+    iter->vt = vt;
 
     *ev = &iter->IEnumVARIANT_iface;
     return S_OK;
diff --git a/dlls/vbscript/vbscript.c b/dlls/vbscript/vbscript.c
index 70a50af..2832557 100644
--- a/dlls/vbscript/vbscript.c
+++ b/dlls/vbscript/vbscript.c
@@ -717,8 +717,13 @@ static HRESULT WINAPI VBScript_GetScriptSite(IActiveScript *iface, REFIID riid,
                                             void **ppvObject)
 {
     VBScript *This = impl_from_IActiveScript(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_guid(riid), ppvObject);
+
+    if(!This->ctx->site)
+        return E_FAIL;
+
+    return IActiveScriptSite_QueryInterface(This->ctx->site, riid, ppvObject);
 }
 
 static HRESULT WINAPI VBScript_SetScriptState(IActiveScript *iface, SCRIPTSTATE ss)
