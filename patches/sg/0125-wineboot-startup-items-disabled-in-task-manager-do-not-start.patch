From: Stained Glass OS <dev@stained-glass.example>
Subject: wineboot: startup items disabled in Task Manager do not start

Task Manager's Startup tab (sg-shell's sg-taskmgr, as Windows') turns a
startup item off without deleting it: Explorer\StartupApproved\Run, Run32
or StartupFolder in the same hive holds a binary value named like the
entry, its first byte odd when disabled (Windows writes 03, and 07). Wine's
wineboot started every Run entry and Startup folder item regardless. Now
it skips the disabled ones; RunOnce and RunServices are not affected, as
on Windows.

Gate: test/startup-gate.sh.
---
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1261,7 +1261,24 @@
     return exit_code;
 }
 
-static void process_run_key( HKEY key, const WCHAR *keyname, BOOL delete, BOOL synchronous )
+/* Stained Glass OS: a Run entry or Startup folder item turned off in Task
+ * Manager's Startup tab does not start. Windows keeps that under
+ * Explorer\StartupApproved\<list> in the same hive: a binary value named like
+ * the entry whose first byte is odd when it is disabled. */
+static BOOL startup_disabled( HKEY root, const WCHAR *list, const WCHAR *name )
+{
+    WCHAR path[128];
+    BYTE data[64];
+    DWORD size = sizeof(data);
+
+    if (!list) return FALSE;
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\%s", list );
+    if (RegGetValueW( root, path, name, RRF_RT_REG_BINARY, NULL, data, &size ) || !size) return FALSE;
+    return data[0] & 1;
+}
+
+static void process_run_key( HKEY key, const WCHAR *keyname, BOOL delete, BOOL synchronous,
+                             HKEY approved_root, const WCHAR *approved_list )
 {
     HKEY runkey;
     LONG res;
@@ -1311,6 +1328,11 @@
