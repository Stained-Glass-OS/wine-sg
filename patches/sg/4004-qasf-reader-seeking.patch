From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] qasf: Restart the WM reader on seeking, advanced reader callbacks.

The ASF reader filter stops and restarts the reader when its position
changes while running, answers the IWMReaderCallbackAdvanced calls the
reader makes (stream samples, time, stream selection, allocation) and
OnOutputPropsChanged; LockServer is counted.
---
 dlls/qasf/asfreader.c | 141 +++++++++++++++++++++++++++++++++++++++++---------
 dlls/qasf/qasf_main.c |  10 +++-
 2 files changed, 125 insertions(+), 26 deletions(-)

diff --git a/dlls/qasf/asfreader.c b/dlls/qasf/asfreader.c
index 91fdc6f..6045d70 100644
--- a/dlls/qasf/asfreader.c
+++ b/dlls/qasf/asfreader.c
@@ -284,22 +284,70 @@ static inline struct asf_stream *impl_from_IMediaSeeking(IMediaSeeking *iface)
     return CONTAINING_RECORD(iface, struct asf_stream, seek.IMediaSeeking_iface);
 }
 
+static HRESULT asf_reader_start(struct asf_reader *filter, LONGLONG current, LONGLONG stop, double rate);
+static HRESULT asf_reader_stop(struct asf_reader *filter);
+
+/* A new position, stop time or rate restarts the reader there: everything
+ * delivered for the old position is flushed and a new segment begins. While
+ * stopped the values are only kept for the next start. */
+static HRESULT asf_stream_seek(struct asf_stream *stream)
+{
+    struct asf_reader *filter = asf_reader_from_asf_stream(stream);
+    LONGLONG current, stop;
+    double rate;
+    HRESULT hr;
+    UINT i;
+
+    EnterCriticalSection(&filter->filter.filter_cs);
+
+    if (filter->filter.state == State_Stopped)
+    {
+        LeaveCriticalSection(&filter->filter.filter_cs);
+        return S_OK;
+    }
+
+    EnterCriticalSection(&stream->seek.cs);
+    current = stream->seek.llCurrent;
+    stop = stream->seek.llStop;
+    rate = stream->seek.dRate;
+    LeaveCriticalSection(&stream->seek.cs);
+
+    if (FAILED(hr = asf_reader_stop(filter)))
+        WARN("Failed to stop the reader, hr %#lx.\n", hr);
+
+    for (i = 0; i < filter->stream_count; ++i)
+    {
+        struct asf_stream *other = filter->streams + i;
+
+        if (!other->source.pin.peer)
+            continue;
+        IPin_BeginFlush(other->source.pin.peer);
+        IPin_EndFlush(other->source.pin.peer);
+        IPin_NewSegment(other->source.pin.peer, current, stop, rate);
+    }
+
+    hr = asf_reader_start(filter, current, stop, rate);
+
+    LeaveCriticalSection(&filter->filter.filter_cs);
+    return hr;
+}
+
 static HRESULT WINAPI media_seeking_ChangeCurrent(IMediaSeeking *iface)
 {
-    FIXME("iface %p stub!\n", iface);
-    return S_OK;
+    TRACE("iface %p.\n", iface);
+    return asf_stream_seek(CONTAINING_RECORD(iface, struct asf_stream, seek.IMediaSeeking_iface));
 }
 
 static HRESULT WINAPI media_seeking_ChangeStop(IMediaSeeking *iface)
 {
-    FIXME("iface %p stub!\n", iface);
-    return S_OK;
+    TRACE("iface %p.\n", iface);
+    return asf_stream_seek(CONTAINING_RECORD(iface, struct asf_stream, seek.IMediaSeeking_iface));
 }
 
 static HRESULT WINAPI media_seeking_ChangeRate(IMediaSeeking *iface)
 {
-    FIXME("iface %p stub!\n", iface);
-    return S_OK;
+    TRACE("iface %p.\n", iface);
+    return asf_stream_seek(CONTAINING_RECORD(iface, struct asf_stream, seek.IMediaSeeking_iface));
 }
 
 static HRESULT WINAPI media_seeking_QueryInterface(IMediaSeeking *iface, REFIID riid, void **ppv)
@@ -323,9 +371,10 @@ static ULONG WINAPI media_seeking_Release(IMediaSeeking *iface)
 static HRESULT WINAPI media_seeking_SetPositions(IMediaSeeking *iface,
         LONGLONG *current, DWORD current_flags, LONGLONG *stop, DWORD stop_flags)
 {
-    FIXME("iface %p, current %s, current_flags %#lx, stop %s, stop_flags %#lx stub!\n",
+    TRACE("iface %p, current %s, current_flags %#lx, stop %s, stop_flags %#lx.\n",
             iface, current ? debugstr_time(*current) : "<null>", current_flags,
             stop ? debugstr_time(*stop) : "<null>", stop_flags);
+    /* the Change* callbacks restart the reader at the new positions */
     return SourceSeekingImpl_SetPositions(iface, current, current_flags, stop, stop_flags);
 }
 
@@ -465,7 +514,8 @@ static HRESULT asf_reader_init_stream(struct strmbase_filter *iface)
             break;
         }
 
-        if (FAILED(hr = IPin_NewSegment(stream->source.pin.peer, 0, 0, 1)))
+        if (FAILED(hr = IPin_NewSegment(stream->source.pin.peer, stream->seek.llCurrent,
+                stream->seek.llStop, stream->seek.dRate)))
         {
             WARN("Failed to start stream %u new segment, hr %#lx\n", i, hr);
             break;
@@ -483,8 +533,23 @@ static HRESULT asf_reader_init_stream(struct strmbase_filter *iface)
     if (FAILED(hr))
         return hr;
 
+    /* start where the first connected stream was positioned */
+    for (i = 0; i < filter->stream_count; ++i)
+    {
+        struct asf_stream *stream = filter->streams + i;
+
+        if (stream->source.pin.peer)
+            return asf_reader_start(filter, stream->seek.llCurrent, stream->seek.llStop, stream->seek.dRate);
+    }
+    return asf_reader_start(filter, 0, 0, 1.0);
+}
+
+static HRESULT asf_reader_start(struct asf_reader *filter, LONGLONG current, LONGLONG stop, double rate)
+{
+    HRESULT hr;
+
     EnterCriticalSection(&filter->status_cs);
-    if (SUCCEEDED(hr = IWMReader_Start(filter->reader, 0, 0, 1, NULL)))
+    if (SUCCEEDED(hr = IWMReader_Start(filter->reader, current, stop > current ? stop - current : 0, rate, NULL)))
     {
         filter->status = -1;
         while (filter->status != WMT_STARTED)
@@ -499,13 +564,9 @@ static HRESULT asf_reader_init_stream(struct strmbase_filter *iface)
     return hr;
 }
 
-static HRESULT asf_reader_cleanup_stream(struct strmbase_filter *iface)
+static HRESULT asf_reader_stop(struct asf_reader *filter)
 {
-    struct asf_reader *filter = impl_from_strmbase_filter(iface);
-    HRESULT hr = S_OK;
-    int i;
-
-    TRACE("iface %p\n", iface);
+    HRESULT hr;
 
     EnterCriticalSection(&filter->status_cs);
     if (SUCCEEDED(hr = IWMReader_Stop(filter->reader)))
@@ -517,7 +578,18 @@ static HRESULT asf_reader_cleanup_stream(struct strmbase_filter *iface)
     }
     LeaveCriticalSection(&filter->status_cs);
 
-    if (FAILED(hr))
+    return hr;
+}
+
+static HRESULT asf_reader_cleanup_stream(struct strmbase_filter *iface)
+{
+    struct asf_reader *filter = impl_from_strmbase_filter(iface);
+    HRESULT hr = S_OK;
+    int i;
+
+    TRACE("iface %p\n", iface);
+
+    if (FAILED(hr = asf_reader_stop(filter)))
         WARN("Failed to stop WMReader %p, hr %#lx\n", filter->reader, hr);
 
     for (i = 0; i < filter->stream_count; ++i)
@@ -917,39 +989,58 @@ static ULONG WINAPI reader_callback_advanced_Release(IWMReaderCallbackAdvanced *
     return IUnknown_Release(&impl->IWMReaderCallback_iface);
 }
 
+/* The filter reads uncompressed outputs only: compressed stream samples, user
+ * clock times and their buffers are never asked for. */
 static HRESULT WINAPI reader_callback_advanced_OnStreamSample(IWMReaderCallbackAdvanced *iface,
         WORD stream, QWORD time, QWORD duration, DWORD flags, INSSBuffer *sample, void *context)
 {
-    FIXME("iface %p, stream %u, time %I64u, duration %I64u, flags %#lx, sample %p, context %p stub!\n",
+    TRACE("iface %p, stream %u, time %I64u, duration %I64u, flags %#lx, sample %p, context %p.\n",
             iface, stream, time, duration, flags, sample, context);
-    return E_NOTIMPL;
+    return S_OK;
 }
 
 static HRESULT WINAPI reader_callback_advanced_OnTime(IWMReaderCallbackAdvanced *iface,
         QWORD time, void *context)
 {
-    FIXME("iface %p stub!\n", iface);
-    return E_NOTIMPL;
+    TRACE("iface %p, time %I64u, context %p.\n", iface, time, context);
+    return S_OK;
 }
 
 static HRESULT WINAPI reader_callback_advanced_OnStreamSelection(IWMReaderCallbackAdvanced *iface,
         WORD count, WORD *stream_numbers, WMT_STREAM_SELECTION *selections, void *context)
 {
-    FIXME("iface %p stub!\n", iface);
-    return E_NOTIMPL;
+    TRACE("iface %p, count %u, stream_numbers %p, selections %p, context %p.\n",
+            iface, count, stream_numbers, selections, context);
+    return S_OK;
 }
 
+/* A format change mid-stream goes downstream with the next sample. */
 static HRESULT WINAPI reader_callback_advanced_OnOutputPropsChanged(IWMReaderCallbackAdvanced *iface,
         DWORD output, WM_MEDIA_TYPE *mt, void *context)
 {
-    FIXME("iface %p stub!\n", iface);
-    return E_NOTIMPL;
+    struct asf_reader *filter = impl_from_IWMReaderCallbackAdvanced(iface)->filter;
+    struct asf_stream *stream;
+
+    TRACE("iface %p, output %lu, mt %p, context %p.\n", iface, output, mt, context);
+
+    if (output >= filter->stream_count || !mt)
+        return E_INVALIDARG;
+
+    stream = filter->streams + output;
+    if (!stream->source.pin.peer)
+        return S_OK;
+    if (IPin_QueryAccept(stream->source.pin.peer, (AM_MEDIA_TYPE *)mt) != S_OK)
+        return VFW_E_TYPE_NOT_ACCEPTED;
+
+    FreeMediaType(&stream->source.pin.mt);
+    return CopyMediaType(&stream->source.pin.mt, (AM_MEDIA_TYPE *)mt);
 }
 
 static HRESULT WINAPI reader_callback_advanced_AllocateForStream(IWMReaderCallbackAdvanced *iface,
         WORD stream, DWORD size, INSSBuffer **out, void *context)
 {
-    FIXME("iface %p stub!\n", iface);
+    TRACE("iface %p, stream %u, size %lu, out %p, context %p.\n", iface, stream, size, out, context);
+    /* the reader's own buffers are used */
     return E_NOTIMPL;
 }
 
diff --git a/dlls/qasf/qasf_main.c b/dlls/qasf/qasf_main.c
index d32a9da..c9ff58a 100644
--- a/dlls/qasf/qasf_main.c
+++ b/dlls/qasf/qasf_main.c
@@ -81,9 +81,17 @@ static HRESULT WINAPI class_factory_CreateInstance(IClassFactory *iface,
     return hr;
 }
 
+static LONG server_locks;
+
 static HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL lock)
 {
-    FIXME("lock %d, stub!\n", lock);
+    TRACE("lock %d.\n", lock);
+
+    /* the factories are static, the count is only kept for the record */
+    if (lock)
+        InterlockedIncrement(&server_locks);
+    else
+        InterlockedDecrement(&server_locks);
     return S_OK;
 }
 
