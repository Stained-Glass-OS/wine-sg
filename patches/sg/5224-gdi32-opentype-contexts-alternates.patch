--- a/dlls/gdi32/uniscribe/shape.c
+++ b/dlls/gdi32/uniscribe/shape.c
@@ -3534,13 +3534,46 @@
 {
     HRESULT hr;
     BOOL filter = FALSE;
+    const char *const *hidden = NULL;
 
     load_ot_tables(hdc, psc);
 
     if (psa && scriptInformation[psa->eScript].scriptTag)
     {
-        FIXME("Filtering not implemented\n");
+        /* the features the script's shaping engine requires are its own business: hidden */
         filter = TRUE;
+        hidden = ShapingData[psa->eScript].requiredFeatures;
+#ifdef SG_MUTANT_SHAPE_NOFILTER
+        hidden = NULL;
+#endif
+    }
+
+    if (hidden)
+    {
+        OPENTYPE_TAG *all;
+        int total = 0, kept = 0, i, h;
+
+        hr = OpenType_GetFontFeatureTags(psc, tagScript, tagLangSys, filter, 0x00000000, FEATURE_ALL_TABLES, 0, NULL, &total, NULL);
+        if (FAILED(hr) && hr != E_OUTOFMEMORY) { *pcTags = 0; return hr; }
+        if (!(all = heap_alloc((total + 1) * sizeof(*all)))) { *pcTags = 0; return E_OUTOFMEMORY; }
+        hr = OpenType_GetFontFeatureTags(psc, tagScript, tagLangSys, filter, 0x00000000, FEATURE_ALL_TABLES, total, all, &total, NULL);
+        if (SUCCEEDED(hr))
+        {
+            for (i = 0; i < total; i++)
+            {
+                BOOL hide = FALSE;
+                for (h = 0; hidden[h]; h++)
+                    if (all[i] == MS_MAKE_TAG(hidden[h][0], hidden[h][1], hidden[h][2], hidden[h][3])) hide = TRUE;
+                if (hide) continue;
+                if (kept < cMaxTags) pFeatureTags[kept] = all[i];
+                kept++;
+            }
+            *pcTags = kept;
+            if (kept > cMaxTags) hr = E_OUTOFMEMORY;
+        }
+        heap_free(all);
+        if (FAILED(hr)) *pcTags = hr == E_OUTOFMEMORY ? kept : 0;
+        return hr;
     }
 
     hr = OpenType_GetFontFeatureTags(psc, tagScript, tagLangSys, filter, 0x00000000, FEATURE_ALL_TABLES, cMaxTags, pFeatureTags, pcTags, NULL);
@@ -3549,3 +3582,11 @@
         *pcTags = 0;
     return hr;
 }
