+HRESULT SHAPE_GetFontAlternateGlyphs( HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, OPENTYPE_TAG tagScript,
+                                      OPENTYPE_TAG tagLangSys, OPENTYPE_TAG tagFeature, WORD glyph, int size,
+                                      WORD *list, int *count )
+{
+    load_ot_tables(hdc, psc);
+    return OpenType_GetAlternateGlyphs(psc, tagScript, tagLangSys, tagFeature, glyph, size, list, count);
+}
