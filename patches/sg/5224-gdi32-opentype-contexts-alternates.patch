+/* Stained Glass OS: the alternates of a glyph in a feature's alternate substitution lookups
+ * (GSUB type 3, also through extension lookups): the glyph itself first, then every alternate,
+ * as ScriptGetFontAlternateGlyphs describes.  *count is the number of glyphs in all; E_OUTOFMEMORY
+ * (with *count set) when the list is too short. */
+HRESULT OpenType_GetAlternateGlyphs(ScriptCache *psc, OPENTYPE_TAG script_tag, OPENTYPE_TAG language_tag,
+        OPENTYPE_TAG feature_tag, WORD glyph, int size, WORD *list, int *count)
+{
+    const GSUB_Header *header = psc->GSUB_Table;
+    const OT_LookupList *lookup_list;
+    LoadedFeature *feature = NULL;
+    OPENTYPE_TAG tag;
+    int tags, i, total = 0;
+
+    *count = 0;
+    if (!language_tag) language_tag = MS_MAKE_TAG('d','f','l','t');
+    _initialize_script_cache(psc);
+    if (!header) return S_OK;
+    if (!usp10_script_cache_get_script(psc, script_tag)) return USP_E_SCRIPT_NOT_IN_FONT;
+    if (FAILED(OpenType_GetFontFeatureTags(psc, script_tag, language_tag, FALSE, feature_tag,
+            FEATURE_GSUB_TABLE, 1, &tag, &tags, &feature)) || !feature)
+        return S_OK;
+
+    lookup_list = (const OT_LookupList *)((const BYTE *)header + GET_BE_WORD(header->LookupList));
+    for (i = 0; i < feature->lookup_count; i++)
+    {
+        const OT_LookupTable *look = (const OT_LookupTable *)((const BYTE *)lookup_list +
+                GET_BE_WORD(lookup_list->Lookup[feature->lookups[i]]));
+        unsigned int type = GET_BE_WORD(look->LookupType), j;
+
+        for (j = 0; j < GET_BE_WORD(look->SubTableCount); j++)
+        {
+            const BYTE *subtable = (const BYTE *)look + GET_BE_WORD(look->SubTable[j]);
+            const GSUB_AlternateSubstFormat1 *asf1;
+            const GSUB_AlternateSet *set;
+            unsigned int sub_type = type, k, n;
+            int index;
+
+            if (type == GSUB_LOOKUP_EXTENSION)
+            {
+                const GSUB_ExtensionPosFormat1 *ext = (const GSUB_ExtensionPosFormat1 *)subtable;
+                if (GET_BE_WORD(ext->SubstFormat) != 1) continue;
+                sub_type = GET_BE_WORD(ext->ExtensionLookupType);
+                subtable += GET_BE_DWORD(ext->ExtensionOffset);
+            }
+#ifdef SG_MUTANT_OT_ALT
+            continue;
+#endif
+            if (sub_type != GSUB_LOOKUP_ALTERNATE) continue;
+
+            asf1 = (const GSUB_AlternateSubstFormat1 *)subtable;
+            if (GET_BE_WORD(asf1->SubstFormat) != 1) continue;
+            index = GSUB_is_glyph_covered(subtable + GET_BE_WORD(asf1->Coverage), glyph);
+            if (index == -1 || index >= GET_BE_WORD(asf1->AlternateSetCount)) continue;
+            set = (const GSUB_AlternateSet *)(subtable + GET_BE_WORD(asf1->AlternateSet[index]));
+            n = GET_BE_WORD(set->GlyphCount);
+            for (k = 0; k < n; k++)
+            {
+                if (!total)
+                {
+                    if (size > 0) list[0] = glyph;
+                    total = 1;
+                }
+                if (total < size) list[total] = GET_BE_WORD(set->Alternate[k]);
+                total++;
+            }
+        }
+    }
+
+    *count = total;
+    return total > size ? E_OUTOFMEMORY : S_OK;
+}
