From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: a Linux window's stand-in answers close and restore

The taskbar keeps a hidden stand-in window (SgLinuxWindow) for each Linux
program's window, holding its title; it answered nothing (DefWindowProc):
asked to close -- Task Manager's End task -- it was destroyed and the
Linux window stayed. Now WM_CLOSE or SC_CLOSE asks the Linux window to
close (XCLOSE), SC_RESTORE brings it forward (XACTIVATE), as the window
itself would; programs that list windows see Linux ones by these.

Gate: test/linuxstandin-gate.sh (mutant SG_MUTANT_STANDIN_DEAF fails it).
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1591,6 +1591,30 @@
     sg_run_lockctl( args );
 }
 
+/* Stained Glass OS: a Linux window's stand-in answers as the window would:
+ * asked to close (Task Manager's End task, WM_CLOSE or SC_CLOSE), the Linux
+ * program's window is asked to close (XCLOSE); restored or brought forward
+ * (Switch to, SC_RESTORE), it comes forward (XACTIVATE). Programs see Linux
+ * windows by these. */
+static LRESULT CALLBACK sg_linux_standin_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct taskbar_button *win;
+
+#ifndef SG_MUTANT_STANDIN_DEAF
+    if ((msg == WM_CLOSE || (msg == WM_SYSCOMMAND && (wp & 0xfff0) == SC_CLOSE)) && (win = find_taskbar_button( hwnd )))
+    {
+        sg_xwin_command( win, L"XCLOSE" );
+        return 0;
+    }
+    if (msg == WM_SYSCOMMAND && (wp & 0xfff0) == SC_RESTORE && (win = find_taskbar_button( hwnd )))
+    {
+        sg_xwin_command( win, L"XACTIVATE" );
+        return 0;
+    }
+#endif
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
 /* Stained Glass OS: Wine's windows and the Linux programs' windows take turns
  * in front. Every Wine window -- File Explorer, Notepad, the Start menu --
  * lives in Wine's desktop window, one X window under a Linux program's (SG
@@ -1843,7 +1867,7 @@
     if (!registered)
     {
         WNDCLASSW wc = { 0 };
-        wc.lpfnWndProc = DefWindowProcW;
+        wc.lpfnWndProc = sg_linux_standin_proc;
         wc.lpszClassName = L"SgLinuxWindow";
         RegisterClassW( &wc );
         registered = TRUE;
