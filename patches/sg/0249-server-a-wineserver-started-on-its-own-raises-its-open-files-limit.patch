From: Stained Glass OS <dev@stained-glass.example>
Subject: server: a wineserver started on its own raises its open-files limit

The server holds a descriptor for every file, mapping and socket of every
process attached to it. Wine's clients raise their own RLIMIT_NOFILE to the
hard limit (ntdll's set_max_limit) and a server they start inherits it, but
the shared prefix's machine server is started by systemd and kept the soft
default of 1024. One Firefox (a dozen processes, ~1300 descriptors) used it
up: every further DLL load failed with STATUS_TOO_MANY_OPENED_FILES
("Couldn't load XPCOM", tabs "Exiting due to channel error"), and Firefox
exited at startup. The server now raises its soft limit to the hard one, as
the clients do.

Found by the 2026-09-26 ISO QA pass. Gate: test/serverfds-gate.sh
(make test-serverfds).
---
--- a/server/main.c
+++ b/server/main.c
@@ -27,6 +27,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <sys/time.h>
+#include <sys/resource.h>
 #include <unistd.h>
 
 #include "object.h"
@@ -212,6 +213,27 @@
     exit(1);  /* make sure atexit functions get called */
 }
 
+/* Stained Glass OS: the server holds a file descriptor for every file,
+ * mapping and socket of every process attached to it. Wine's clients raise
+ * their own open-files limit to the hard limit (ntdll's set_max_limit), and a
+ * server they start inherits it; a server started on its own -- the shared
+ * prefix's machine server, run by systemd -- kept the soft default of 1024,
+ * which one Firefox (a dozen processes) exhausts: every further DLL load
+ * failed with STATUS_TOO_MANY_OPENED_FILES ("Couldn't load XPCOM", tabs dying
+ * "Exiting due to channel error"). Raise it as the clients do. */
+static void raise_open_files_limit(void)
+{
+#ifdef RLIMIT_NOFILE
+    struct rlimit rl;
+
+    if (!getrlimit( RLIMIT_NOFILE, &rl ) && rl.rlim_cur < rl.rlim_max)
+    {
+        rl.rlim_cur = rl.rlim_max;
+        setrlimit( RLIMIT_NOFILE, &rl );
+    }
+#endif
+}
+
 int main( int argc, char *argv[] )
 {
     setvbuf( stderr, NULL, _IOLBF, 0 );
@@ -226,6 +248,7 @@
     signal( SIGTERM, sigterm_handler );
     signal( SIGABRT, sigterm_handler );
 
+    raise_open_files_limit();
     sock_init();
     open_master_socket();
 
