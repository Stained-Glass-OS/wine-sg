From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, userenv: a changed environment reaches new programs

As on Windows, the shell reads environment variables again when told they
changed (WM_SETTINGCHANGE "Environment": the Environment Variables dialog,
setx, installers), so programs started after a change get it without
signing in again (David 2026-10-01: Claude Code asked for PATH to be
changed). Only what the registry defines is set or removed; the session's
own variables stay.

And CreateEnvironmentBlock lost the user's Path: the ';' joining it to the
system's was written one character too far, over the user's first
character, and the system's terminator stayed.
---
--- a/programs/explorer/Makefile.in
+++ b/programs/explorer/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = explorer.exe
 IMPORTS   = uuid mfuuid rpcrt4 user32 gdi32 advapi32 win32u
-DELAYIMPORTS = comctl32 shell32 oleaut32 ole32 shlwapi gdiplus mfplat mfreadwrite mpr
+DELAYIMPORTS = comctl32 shell32 oleaut32 ole32 shlwapi gdiplus mfplat mfreadwrite mpr userenv
 
 EXTRADLLFLAGS = -mwindows -municode
 
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -710,6 +710,72 @@
     return TRUE;
 }
 
+/* Stained Glass OS: the session's programs get changed environment variables
+ * without signing in again, as on Windows: the Environment Variables dialog
+ * (and setx, installers) broadcast WM_SETTINGCHANGE "Environment", and the
+ * shell -- which starts the programs -- builds its environment again from
+ * the registry (David 2026-10-01: Claude Code asked for PATH to be changed).
+ * Only what the registry defines is set or removed: the session's own
+ * variables (DISPLAY, XDG_RUNTIME_DIR, SG_...) stay. */
+static WCHAR *sg_env_names;     /* the names the registry defined last time, '\0'-separated */
+/* userenv.h's (its rpcndr.h does not mix with this file) */
+BOOL WINAPI CreateEnvironmentBlock( void **env, HANDLE token, BOOL inherit );
+BOOL WINAPI DestroyEnvironmentBlock( void *env );
+
+static WCHAR *sg_env_block( WCHAR **names )
+{
+    HANDLE token;
+    WCHAR *block = NULL, *p, *out;
+    size_t len = 1;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE | TOKEN_IMPERSONATE, &token ))
+        return NULL;
+    if (!CreateEnvironmentBlock( (void **)&block, token, FALSE )) block = NULL;
+    CloseHandle( token );
+    if (!block) return NULL;
+    for (p = block; *p; p += lstrlenW( p ) + 1) len += lstrlenW( p ) + 1;
+    if ((*names = out = malloc( len * sizeof(WCHAR) )))
+    {
+        for (p = block; *p; p += lstrlenW( p ) + 1)
+        {
+            const WCHAR *eq = wcschr( p + 1, '=' );
+            if (!eq || *p == '=') continue;
+            memcpy( out, p, (eq - p) * sizeof(WCHAR) );
+            out += eq - p;
+            *out++ = 0;
+        }
+        *out = 0;
+    }
+    return block;
+}
+
+static void sg_reload_environment(void)
+{
+    WCHAR *names = NULL, *block = sg_env_block( &names ), *p, *n;
+
+    if (!block) return;
+    for (p = block; *p; p += lstrlenW( p ) + 1)
+    {
+        WCHAR *eq = wcschr( p + 1, '=' );
+        if (!eq || *p == '=') continue;
+        *eq = 0;
+        SetEnvironmentVariableW( p, eq + 1 );
+        *eq = '=';
+    }
+    /* what the registry defined before and does not now: removed */
+    for (n = sg_env_names; n && *n; n += lstrlenW( n ) + 1)
+    {
+        BOOL still = FALSE;
+        WCHAR *m;
+        for (m = names; m && *m; m += lstrlenW( m ) + 1) if (!wcsicmp( m, n )) { still = TRUE; break; }
+        if (!still) SetEnvironmentVariableW( n, NULL );
+    }
+    DestroyEnvironmentBlock( block );
+    free( sg_env_names );
+    sg_env_names = names;
+    TRACE( "environment read again from the registry\n" );
+}
+
 /* window procedure for the individual tray icon window */
 static LRESULT WINAPI tray_icon_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
 {
@@ -3501,6 +3567,9 @@
         return handle_incoming((HWND)wparam, (COPYDATASTRUCT *)lparam);
 
     case WM_SETTINGCHANGE:
+#ifndef SG_MUTANT_NO_ENV_RELOAD
+        if (lparam && !wcsicmp( (const WCHAR *)lparam, L"Environment" )) sg_reload_environment();
+#endif
         /* Stained Glass OS: Settings > Personalization > Colors */
         if (enable_taskbar && lparam && !wcscmp( (const WCHAR *)lparam, L"ImmersiveColorSet" ))
         {
@@ -3682,6 +3751,13 @@
 {
     RECT work_rect, primary_rect, taskbar_rect;
 
+    /* the registry's variables as they are now: what a later change removes */
+    if (arg_enable_shell)
+    {
+        WCHAR *block = sg_env_block( &sg_env_names );
+        if (block) DestroyEnvironmentBlock( block );
+    }
+
     shell_traywnd_class.hIcon = LoadIconW( 0, (const WCHAR *)IDI_WINLOGO );
     shell_traywnd_class.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
     tray_icon_class.hIcon = shell_traywnd_class.hIcon;
--- a/dlls/userenv/userenv_main.c
+++ b/dlls/userenv/userenv_main.c
@@ -118,7 +118,14 @@
                         sizeof(value)-size*sizeof(WCHAR)))
                 continue;
 
+            /* Stained Glass OS: the separator replaces the system value's
+             * terminator; at value[size] it overwrote the user's first
+             * character and the user's Path was cut off entirely */
+#ifndef SG_MUTANT_USER_PATH_LOST
+            value[size - 1] = ';';
+#else
             value[size] = ';';
+#endif
             set_env_var(env, name, value);
             continue;
         }
