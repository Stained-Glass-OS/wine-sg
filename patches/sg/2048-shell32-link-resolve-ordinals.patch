+/*************************************************************************
+ * AddCommasW [SHELL32.203]
+ *
+ * A number with the digit grouping of the user's locale, in a buffer of 15
+ * characters or more; returns the buffer.
+ */
+WCHAR * WINAPI AddCommasW(DWORD number, WCHAR *out)
+{
+    WCHAR digits[16], thousand[8], grouping[16], reversed[32];
+    UINT sizes[8], nsizes = 0, i, n, run, group = 0, next;
+    BOOL repeat = FALSE;
+    const WCHAR *p;
+    WCHAR *o = reversed;
+
+    TRACE("(%lu, %p)\n", number, out);
+
+    if (!out) return NULL;
+    swprintf(digits, ARRAY_SIZE(digits), L"%lu", number);
+
+    if (!GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_STHOUSAND, thousand, ARRAY_SIZE(thousand)))
+        lstrcpyW(thousand, L",");
+    if (!GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_SGROUPING, grouping, ARRAY_SIZE(grouping)))
+        lstrcpyW(grouping, L"3;0");
+    /* "3;2;0": groups of 3 then of 2, the last repeated because of the 0; "3;2" ends after the 2 */
+    for (p = grouping; *p; p++)
+    {
+        if (*p < '0' || *p > '9') continue;
+        if (*p == '0') { repeat = TRUE; break; }
+        if (nsizes < ARRAY_SIZE(sizes)) sizes[nsizes++] = *p - '0';
+    }
+#ifdef SG_MUTANT_ADDCOMMAS
+    nsizes = 0;
+#endif
+
+    /* the digits from the right, a separator when a group is full */
+    n = lstrlenW(digits);
+    next = nsizes ? sizes[0] : 0;
+    run = 0;
+    for (i = 0; i < n; i++)
+    {
+        if (next && run == next)
+        {
+            const WCHAR *t;
+            for (t = thousand + lstrlenW(thousand); t > thousand; ) *o++ = *--t;
+            run = 0;
+            group++;
+            if (group < nsizes) next = sizes[group];
+            else if (!repeat) next = 0;
+        }
+        *o++ = digits[n - 1 - i];
+        run++;
+    }
+    /* reverse back into the output */
+    for (i = 0; o > reversed; i++) out[i] = *--o;
+    out[i] = 0;
+    return out;
+}
+
+/*************************************************************************
+ * ShortSizeFormatW [SHELL32.204]
+ *
+ * A size as the shell shows it ("1.44 MB"), in a buffer of 16 characters or
+ * more; returns the buffer.
+ */
+WCHAR * WINAPI ShortSizeFormatW(DWORD size, WCHAR *out)
+{
+    TRACE("(%lu, %p)\n", size, out);
+
+    if (!out) return NULL;
+    if (!StrFormatByteSizeW(size, out, 16)) out[0] = 0;
+    return out;
+}
+
+/*************************************************************************
+ * SHIsBadInterfacePtr [SHELL32.84]
+ *
+ * Whether a pointer cannot be an interface: its vtable pointer and the
+ * first count slots of the vtable must be readable.
+ */
+BOOL WINAPI SHIsBadInterfacePtr(const void *iface, UINT count)
+{
+    const void * const *vtbl;
+
+    TRACE("(%p, %u)\n", iface, count);
+
+#ifdef SG_MUTANT_BADIFACE
+    return FALSE;
+#endif
+    if (IsBadReadPtr(iface, sizeof(void *))) return TRUE;
+    vtbl = *(const void * const * const *)iface;
+    return IsBadReadPtr(vtbl, count * sizeof(void *));
+}
