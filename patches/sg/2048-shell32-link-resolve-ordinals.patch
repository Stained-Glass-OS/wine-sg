+UINT WINAPI DragQueryFileAorW(HDROP drop, UINT index, void *file, UINT size, BOOL ansi, BOOL wide)
+{
+    TRACE("(%p, %u, %p, %u, %d, %d)\n", drop, index, file, size, ansi, wide);
+
+    if (ansi) return DragQueryFileA(drop, index, file, size);
+    return DragQueryFileW(drop, index, file, size);
+}
