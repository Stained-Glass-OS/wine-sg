+}
+
+/*************************************************************************
+ * SheShortenPath [SHELL32.@]
+ *
+ * A path rewritten in place in its short (8.3) or long form.
+ */
+BOOL WINAPI SheShortenPathW(WCHAR *path, BOOL shorten)
+{
+    WCHAR buffer[MAX_PATH];
+    DWORD len;
+
+    TRACE("(%s, %d)\n", debugstr_w(path), shorten);
+
+    if (!path) return FALSE;
+    len = shorten ? GetShortPathNameW(path, buffer, MAX_PATH) : GetLongPathNameW(path, buffer, MAX_PATH);
+    if (!len || len >= MAX_PATH) return FALSE;
+    lstrcpyW(path, buffer);
+    return TRUE;
+}
+
+BOOL WINAPI SheShortenPathA(char *path, BOOL shorten)
+{
+    char buffer[MAX_PATH];
+    DWORD len;
+
+    TRACE("(%s, %d)\n", debugstr_a(path), shorten);
+
+    if (!path) return FALSE;
+    len = shorten ? GetShortPathNameA(path, buffer, MAX_PATH) : GetLongPathNameA(path, buffer, MAX_PATH);
+    if (!len || len >= MAX_PATH) return FALSE;
+    lstrcpyA(path, buffer);
+    return TRUE;
+}
+
+/*************************************************************************
+ * SheGetCurDrive [SHELL32.@]
+ *
+ * The number of the current drive, 0 for A.
+ */
+int WINAPI SheGetCurDrive(void)
+{
+    WCHAR dir[MAX_PATH];
+
+    TRACE("\n");
+
+    if (!GetCurrentDirectoryW(MAX_PATH, dir) || dir[1] != ':') return -1;
+    return towupper(dir[0]) - 'A';
+}
