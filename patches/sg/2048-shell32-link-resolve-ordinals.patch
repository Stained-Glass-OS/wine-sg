+/* The icon shown for a file with none of its own: one of shell32's, which the path and index then name */
+static HICON associated_fallback_icon(HINSTANCE hInst, LPWSTR path, WORD *index, WORD which)
+{
+    GetSystemDirectoryW(path, MAX_PATH);
+    lstrcatW(path, L"\\shell32.dll");
+    *index = which;
+#ifdef SG_MUTANT_ASSOC_FALLBACK
+    return NULL;
+#endif
+    return ExtractIconW(hInst, path, which);
+}
