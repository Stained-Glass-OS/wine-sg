+/*************************************************************************
+ * SheRemoveQuotes [SHELL32.@]
+ *
+ * A string that starts with a quote loses it and the quote that ends it (and
+ * what follows); returns the string.
+ */
+WCHAR * WINAPI SheRemoveQuotesW(WCHAR *str)
+{
+    WCHAR *p;
+
+    TRACE("(%s)\n", debugstr_w(str));
+
+#ifdef SG_MUTANT_SHE_QUOTES
+    return str;
+#endif
+    if (str && *str == '"')
+    {
+        for (p = str + 1; *p && *p != '"'; p++) p[-1] = *p;
+        p[-1] = 0;
+    }
+    return str;
+}
+
+char * WINAPI SheRemoveQuotesA(char *str)
+{
+    char *p;
+
+    TRACE("(%s)\n", debugstr_a(str));
+
+    if (str && *str == '"')
+    {
+        for (p = str + 1; *p && *p != '"'; p++) p[-1] = *p;
+        p[-1] = 0;
+    }
+    return str;
+}
