 /*************************************************************************
-*	PathProcessCommandA
+*	PathProcessCommand
+*
+* Split a command line into the program and its arguments, finding the program
+* when the line is not quoted and the program's name has spaces in it.
 */
-static LONG PathProcessCommandA (
-	LPCSTR lpszPath,
-	LPSTR lpszBuff,
-	DWORD dwBuffSize,
-	DWORD dwFlags)
+static BOOL process_command_exists(WCHAR *name, DWORD flags)
 {
-	FIXME("%s %p 0x%04lx 0x%04lx stub\n",
-	lpszPath, lpszBuff, dwBuffSize, dwFlags);
-	if(!lpszPath) return -1;
-	if(lpszBuff) strcpy(lpszBuff, lpszPath);
-	return strlen(lpszPath);
+    WCHAR full[MAX_PATH];
+    BOOL qualify = (flags & PPCF_FORCEQUALIFY) != 0;
+
+    if (flags & PPCF_DONTRESOLVE) return FALSE;
+
+    if (!name[0]) return FALSE;
+    lstrcpyW(full, name);
+    if (PathResolveW(full, NULL, PRF_VERIFYEXISTS | PRF_TRYPROGRAMEXTENSIONS) ||
+        (PathIsRelativeW(name) ? FALSE : PathFileExistsW(name)))
+    {
+        if (qualify) lstrcpyW(name, full);
+        return TRUE;
+    }
+    return FALSE;
 }
 
-/*************************************************************************
-*	PathProcessCommandW
-*/
 static LONG PathProcessCommandW (
 	LPCWSTR lpszPath,
 	LPWSTR lpszBuff,
 	DWORD dwBuffSize,
 	DWORD dwFlags)
 {
-	FIXME("(%s, %p, 0x%04lx, 0x%04lx) stub\n",
-	debugstr_w(lpszPath), lpszBuff, dwBuffSize, dwFlags);
-	if(!lpszPath) return -1;
-	if(lpszBuff) lstrcpyW(lpszBuff, lpszPath);
-	return lstrlenW(lpszPath);
+    WCHAR name[MAX_PATH];
+    const WCHAR *args = NULL, *end;
+    WCHAR *out;
+    SIZE_T len, name_len;
+    BOOL found = FALSE, quote;
+
+    TRACE("(%s, %p, %lu, 0x%04lx)\n", debugstr_w(lpszPath), lpszBuff, dwBuffSize, dwFlags);
+
+    if (!lpszPath || !lpszBuff || !dwBuffSize) return -1;
+    while (*lpszPath == ' ') lpszPath++;
+
+    if (*lpszPath == '"')
+    {
+        /* quoted: the program is what the quotes hold, the arguments follow them */
+        lpszPath++;
+        end = wcschr(lpszPath, '"');
+        if (!end) end = lpszPath + lstrlenW(lpszPath);
+        name_len = end - lpszPath;
+        args = *end ? end + 1 : end;
+        if (name_len >= MAX_PATH) return -1;
+        memcpy(name, lpszPath, name_len * sizeof(WCHAR));
+        name[name_len] = 0;
+        found = process_command_exists(name, dwFlags);
+    }
+    else
+    {
+        /* unquoted: the program may have spaces; try the line cut at each space */
+        const WCHAR *cut[MAX_PATH / 2];
+        int ncut = 0, i;
+
+        for (end = lpszPath; ; end++)
+        {
+            if (*end == ' ' || !*end)
+            {
+                if (ncut < ARRAY_SIZE(cut)) cut[ncut++] = end;
+                if (!*end) break;
+            }
+        }
+        for (i = 0; i < ncut && !found; i++)
+        {
+#ifdef SG_MUTANT_PPC_LONGEST
+            int k = i;
+#else
+            int k = (dwFlags & PPCF_LONGESTPOSSIBLE) ? ncut - 1 - i : i;
+#endif
+
+            name_len = cut[k] - lpszPath;
+            if (!name_len || name_len >= MAX_PATH) continue;
+            memcpy(name, lpszPath, name_len * sizeof(WCHAR));
+            name[name_len] = 0;
+            if (process_command_exists(name, dwFlags))
+            {
+                found = TRUE;
+                args = cut[k];
+            }
+        }
+        if (!found)
+        {
+            /* no such file: the first word is the program */
+            name_len = min(cut[0] - lpszPath, MAX_PATH - 1);
+            memcpy(name, lpszPath, name_len * sizeof(WCHAR));
+            name[name_len] = 0;
+            args = cut[0];
+        }
+    }
+    while (args && *args == ' ') args++;
+
+    if (found && (dwFlags & PPCF_NODIRECTORIES) && PathIsDirectoryW(name)) return -1;
+
+    quote = (dwFlags & PPCF_ADDQUOTES) && wcschr(name, ' ');
+    len = lstrlenW(name) + (quote ? 2 : 0);
+    if ((dwFlags & PPCF_INCLUDEARGS) && args && *args) len += 1 + lstrlenW(args);
+    if (len >= dwBuffSize) return -1;
+
+    out = lpszBuff;
+    if (quote) *out++ = '"';
+    lstrcpyW(out, name);
+    out += lstrlenW(name);
+    if (quote) *out++ = '"';
+    if ((dwFlags & PPCF_INCLUDEARGS) && args && *args)
+    {
+        *out++ = ' ';
+        lstrcpyW(out, args);
+    }
+    else *out = 0;
+    return len;
+}
+
+static LONG PathProcessCommandA (
+	LPCSTR lpszPath,
+	LPSTR lpszBuff,
+	DWORD dwBuffSize,
+	DWORD dwFlags)
+{
+    WCHAR *path, *buff;
+    LONG ret = -1;
+    int n;
+
+    TRACE("(%s, %p, %lu, 0x%04lx)\n", debugstr_a(lpszPath), lpszBuff, dwBuffSize, dwFlags);
+
+    if (!lpszPath || !lpszBuff || !dwBuffSize) return -1;
+    n = MultiByteToWideChar(CP_ACP, 0, lpszPath, -1, NULL, 0);
+    path = malloc(n * sizeof(WCHAR));
+    buff = malloc(dwBuffSize * sizeof(WCHAR));
+    if (path && buff)
+    {
+        MultiByteToWideChar(CP_ACP, 0, lpszPath, -1, path, n);
+        if ((ret = PathProcessCommandW(path, buff, dwBuffSize, dwFlags)) >= 0)
+            WideCharToMultiByte(CP_ACP, 0, buff, -1, lpszBuff, dwBuffSize, NULL, NULL);
+    }
+    free(path);
+    free(buff);
+    return ret;
 }
 
