From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:36:55 -0700
Subject: [PATCH] odbccp32: file DSN read/write, available drivers, posted
 installer errors, default data source

- SQLReadFileDSN/SQLWriteFileDSN (A and W) on .dsn files, default directory for bare names
- SQLGetAvailableDrivers (A and W) lists the [ODBC Drivers] section of an INF file
- SQLPostInstallerError posts to the installer error stack read by SQLInstallerError
- SQLRemoveDefaultDataSource removes the DSN named Default

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/odbccp32/odbccp32.c b/dlls/odbccp32/odbccp32.c
index f42a9e2..307d1c6 100644
--- a/dlls/odbccp32/odbccp32.c
+++ b/dlls/odbccp32/odbccp32.c
@@ -612,19 +612,74 @@ BOOL WINAPI SQLCreateDataSource(HWND hwnd, LPCSTR lpszDS)
 BOOL WINAPI SQLGetAvailableDriversW(LPCWSTR lpszInfFile, LPWSTR lpszBuf,
                WORD cbBufMax, WORD *pcbBufOut)
 {
+    DWORD len;
+
     clear_errors();
-    FIXME("%s %p %d %p\n", debugstr_w(lpszInfFile), lpszBuf, cbBufMax, pcbBufOut);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("%s %p %d %p\n", debugstr_w(lpszInfFile), lpszBuf, cbBufMax, pcbBufOut);
+
+    if (!lpszInfFile || !*lpszInfFile)
+    {
+        push_error(ODBC_ERROR_INVALID_INF, L"Invalid INF file");
+        return FALSE;
+    }
+    if (!lpszBuf || !cbBufMax)
+    {
+        push_error(ODBC_ERROR_INVALID_BUFF_LEN, L"Invalid buffer length");
+        return FALSE;
+    }
+    if (GetFileAttributesW(lpszInfFile) == INVALID_FILE_ATTRIBUTES)
+    {
+        push_error(ODBC_ERROR_INVALID_INF, L"Invalid INF file");
+        return FALSE;
+    }
+
+    /* the driver descriptions are the keys of the [ODBC Drivers] section */
+    len = GetPrivateProfileStringW(L"ODBC Drivers", NULL, L"", lpszBuf, cbBufMax, lpszInfFile);
+    if (!len)
+    {
+        lpszBuf[0] = 0;
+        if (cbBufMax > 1) lpszBuf[1] = 0;
+        if (pcbBufOut) *pcbBufOut = 0;
+        return TRUE;
+    }
+    if (pcbBufOut) *pcbBufOut = len + 1;
+    return TRUE;
 }
 
 BOOL WINAPI SQLGetAvailableDrivers(LPCSTR lpszInfFile, LPSTR lpszBuf,
                WORD cbBufMax, WORD *pcbBufOut)
 {
+    WCHAR *file, *wbuf;
+    WORD wout = 0;
+    BOOL ret;
+
     clear_errors();
-    FIXME("%s %p %d %p\n", debugstr_a(lpszInfFile), lpszBuf, cbBufMax, pcbBufOut);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("%s %p %d %p\n", debugstr_a(lpszInfFile), lpszBuf, cbBufMax, pcbBufOut);
+
+    if (!lpszBuf || !cbBufMax)
+    {
+        push_error(ODBC_ERROR_INVALID_BUFF_LEN, L"Invalid buffer length");
+        return FALSE;
+    }
+
+    file = strdupAtoW(lpszInfFile);
+    wbuf = malloc(cbBufMax * sizeof(WCHAR));
+    if (!wbuf)
+    {
+        free(file);
+        push_error(ODBC_ERROR_OUT_OF_MEM, L"Out of memory");
+        return FALSE;
+    }
+
+    ret = SQLGetAvailableDriversW(file, wbuf, cbBufMax, &wout);
+    if (ret)
+    {
+        int n = WideCharToMultiByte(CP_ACP, 0, wbuf, wout ? wout : 2, lpszBuf, cbBufMax, NULL, NULL);
+        if (pcbBufOut) *pcbBufOut = wout ? n : 0;
+    }
+    free(file);
+    free(wbuf);
+    return ret;
 }
 
 BOOL WINAPI SQLGetConfigMode(UWORD *pwConfigMode)
@@ -1460,46 +1515,158 @@ BOOL WINAPI SQLManageDataSources(HWND hwnd)
 
 SQLRETURN WINAPI SQLPostInstallerErrorW(DWORD fErrorCode, LPCWSTR szErrorMsg)
 {
-    FIXME("%lu %s\n", fErrorCode, debugstr_w(szErrorMsg));
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("%lu %s\n", fErrorCode, debugstr_w(szErrorMsg));
+
+    /* the message has to outlive the call: keep a private copy of the latest ones */
+    {
+        static WCHAR *posted[8];
+        static int next;
+        WCHAR *copy = szErrorMsg ? wcsdup(szErrorMsg) : NULL;
+
+        if (num_errors >= ARRAY_SIZE(error_code))
+            return SQL_ERROR;
+        free(posted[next]);
+        posted[next] = copy;
+        push_error(fErrorCode, copy);
+        next = (next + 1) % ARRAY_SIZE(posted);
+    }
+    return SQL_SUCCESS;
 }
 
 SQLRETURN WINAPI SQLPostInstallerError(DWORD fErrorCode, LPCSTR szErrorMsg)
 {
-    FIXME("%lu %s\n", fErrorCode, debugstr_a(szErrorMsg));
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    WCHAR *msg = strdupAtoW(szErrorMsg);
+    SQLRETURN ret;
+
+    TRACE("%lu %s\n", fErrorCode, debugstr_a(szErrorMsg));
+
+    ret = SQLPostInstallerErrorW(fErrorCode, msg);
+    free(msg);
+    return ret;
+}
+
+/* a file DSN given without a directory lives in the default file DSN directory */
+static WCHAR *file_dsn_path(const WCHAR *name)
+{
+    WCHAR dir[MAX_PATH], *path;
+    DWORD len;
+
+    if (wcschr(name, '\\') || wcschr(name, '/'))
+        return wcsdup(name);
+
+    len = ExpandEnvironmentStringsW(L"%CommonProgramFiles%\\ODBC\\Data Sources", dir, ARRAY_SIZE(dir));
+    if (!len || len > ARRAY_SIZE(dir)) return NULL;
+    {
+        /* the default directory is created on demand */
+        WCHAR *p;
+        for (p = dir + 3; *p; p++)
+        {
+            if (*p != '\\') continue;
+            *p = 0;
+            CreateDirectoryW(dir, NULL);
+            *p = '\\';
+        }
+        CreateDirectoryW(dir, NULL);
+    }
+    path = malloc((lstrlenW(dir) + lstrlenW(name) + 2) * sizeof(WCHAR));
+    if (path) swprintf(path, lstrlenW(dir) + lstrlenW(name) + 2, L"%s\\%s", dir, name);
+    return path;
 }
 
 BOOL WINAPI SQLReadFileDSNW(LPCWSTR lpszFileName, LPCWSTR lpszAppName,
                LPCWSTR lpszKeyName, LPWSTR lpszString, WORD cbString,
                WORD *pcbString)
 {
+    WCHAR *path;
+    DWORD len;
+
     clear_errors();
-    FIXME("%s %s %s %s %d %p\n", debugstr_w(lpszFileName), debugstr_w(lpszAppName),
-               debugstr_w(lpszKeyName), debugstr_w(lpszString), cbString, pcbString);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("%s %s %s %p %d %p\n", debugstr_w(lpszFileName), debugstr_w(lpszAppName),
+               debugstr_w(lpszKeyName), lpszString, cbString, pcbString);
+
+    if (!lpszFileName || !*lpszFileName)
+    {
+        push_error(ODBC_ERROR_INVALID_PATH, L"Invalid path");
+        return FALSE;
+    }
+    if (!lpszString || !cbString)
+    {
+        push_error(ODBC_ERROR_INVALID_BUFF_LEN, L"Invalid buffer length");
+        return FALSE;
+    }
+    if (lpszKeyName && !lpszAppName)
+    {
+        push_error(ODBC_ERROR_GENERAL_ERR, L"General error");
+        return FALSE;
+    }
+
+    if (!(path = file_dsn_path(lpszFileName)))
+    {
+        push_error(ODBC_ERROR_OUT_OF_MEM, L"Out of memory");
+        return FALSE;
+    }
+
+    len = GetPrivateProfileStringW(lpszAppName, lpszKeyName, L"", lpszString, cbString, path);
+    free(path);
+    if (pcbString) *pcbString = len;
+    return TRUE;
 }
 
 BOOL WINAPI SQLReadFileDSN(LPCSTR lpszFileName, LPCSTR lpszAppName,
                LPCSTR lpszKeyName, LPSTR lpszString, WORD cbString,
                WORD *pcbString)
 {
+    WCHAR *file, *app, *key, *buf;
+    WORD wlen = 0;
+    BOOL ret;
+
     clear_errors();
-    FIXME("%s %s %s %s %d %p\n", debugstr_a(lpszFileName), debugstr_a(lpszAppName),
-               debugstr_a(lpszKeyName), debugstr_a(lpszString), cbString, pcbString);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("%s %s %s %p %d %p\n", debugstr_a(lpszFileName), debugstr_a(lpszAppName),
+               debugstr_a(lpszKeyName), lpszString, cbString, pcbString);
+
+    if (!lpszString || !cbString)
+    {
+        push_error(ODBC_ERROR_INVALID_BUFF_LEN, L"Invalid buffer length");
+        return FALSE;
+    }
+
+    file = strdupAtoW(lpszFileName);
+    app = strdupAtoW(lpszAppName);
+    key = strdupAtoW(lpszKeyName);
+    buf = calloc(cbString, sizeof(WCHAR));
+    if (!buf)
+    {
+        push_error(ODBC_ERROR_OUT_OF_MEM, L"Out of memory");
+        ret = FALSE;
+    }
+    else if ((ret = SQLReadFileDSNW(file, app, key, buf, cbString, &wlen)))
+    {
+        /* a list of names keeps its embedded zeros */
+        int total = min((int)wlen + 2, (int)cbString);
+        int n = WideCharToMultiByte(CP_ACP, 0, buf, total, lpszString, cbString, NULL, NULL);
+
+        lpszString[cbString - 1] = 0;
+        if (pcbString)
+        {
+            /* length of the text without the terminating zero(s) of a list */
+            *pcbString = WideCharToMultiByte(CP_ACP, 0, buf, wlen, NULL, 0, NULL, NULL);
+            (void)n;
+        }
+    }
+    free(file);
+    free(app);
+    free(key);
+    free(buf);
+    return ret;
 }
 
 BOOL WINAPI SQLRemoveDefaultDataSource(void)
 {
     clear_errors();
-    FIXME("\n");
