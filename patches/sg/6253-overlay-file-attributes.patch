From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: overlay handlers get the file attributes, and their answers are traced

IShellIconOverlayIdentifier::IsMemberOf takes the item's file attributes (FILE_ATTRIBUTE_*), as documented, but the folder passed it SFGAO flags: every item looked like a directory with recall-on-access set, and OneDrive's handlers marked none of them. The handlers now get GetFileAttributes' value, with a cloud file's pinned, unpinned and recall-on-data-access bits added from its placeholder state, which Wine's file system does not keep. Each handler's answer and each overlay job are traced.
---
diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index cdad3ab..51a9a98 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -1226,7 +1226,12 @@ static void overlays_apply(void)
 
         if (!h->obj) continue;
         h->image = SIC_GetIconIndex( h->icon_file, h->icon_index, 0 );
-        if (h->image < 0) continue;
+        if (h->image < 0)
+        {
+            WARN( "overlay handler %s: no picture from %s,%d\n", debugstr_w(h->name), debugstr_w(h->icon_file), h->icon_index );
+            continue;
+        }
+        TRACE( "overlay %d (%s) is image %d\n", h->overlay, debugstr_w(h->name), h->image );
         for (l = 0; l < ARRAY_SIZE(shell_imagelists); l++)
             if (shell_imagelists[l]) ImageList_SetOverlayImage( shell_imagelists[l], h->image, h->overlay );
     }
@@ -1313,6 +1318,8 @@ static int overlay_ask( const WCHAR *path, DWORD attributes, int *image )
         hr = IShellIconOverlayIdentifier_IsMemberOf( h->obj, path, attributes );
         if ((took = GetTickCount() - start) >= 1000)
             WARN( "overlay handler %s took %lu ms for %s\n", debugstr_w(h->name), took, debugstr_w(path) );
+        TRACE( "handler %s (overlay %d) IsMemberOf(%s, %#lx) -> %#lx\n", debugstr_w(h->name), h->overlay,
+               debugstr_w(path), attributes, hr );
         if (hr == S_OK)
         {
             best = h->overlay;
@@ -1346,7 +1353,13 @@ static DWORD WINAPI overlay_worker( void *arg )
             continue;
         }
         job = LIST_ENTRY( next, struct overlay_job, entry );
-        TRACE( "job %p kind %u path %s\n", job, job->kind, debugstr_w(job->path) );
+        if (job->kind == OVERLAY_JOB_ITEM)
+        {
+            WCHAR name[MAX_PATH];
+            if (!_ILSimpleGetTextW( job->child, name, ARRAY_SIZE(name) )) name[0] = 0;
+            TRACE( "job %p: item %s of folder %p\n", job, debugstr_w(name), job->folder );
+        }
+        else TRACE( "job %p kind %u path %s\n", job, job->kind, debugstr_w(job->path) );
         switch (job->kind)
         {
         case OVERLAY_JOB_LOAD:
@@ -1359,6 +1372,7 @@ static DWORD WINAPI overlay_worker( void *arg )
             job->overlay = 0;
             if (IShellIconOverlay_GetOverlayIndex( job->folder, job->child, &job->overlay ) != S_OK)
                 job->overlay = 0;
+            TRACE( "job %p: overlay %d\n", job, job->overlay );
             break;
         }
         if (job->hwnd && (!IsWindow( job->hwnd ) ||
diff --git a/dlls/shell32/shfldr_fs.c b/dlls/shell32/shfldr_fs.c
index 5e4be0c..2486f23 100644
--- a/dlls/shell32/shfldr_fs.c
+++ b/dlls/shell32/shfldr_fs.c
@@ -273,7 +273,29 @@ struct cf_basic { DWORD pin, in_sync; LARGE_INTEGER file_id, root_id; DWORD iden
 struct cf_range { LARGE_INTEGER offset, length; };
 
 /* the status of a file: a string id, and System.StorageProviderState's value; 0 for none */
+static UINT cloud_status_pin( const WCHAR *path, DWORD *state, DWORD *pin );
+
 static UINT cloud_status( const WCHAR *path, DWORD *state )
+{
+    DWORD pin;
+    return cloud_status_pin( path, state, &pin );
+}
+
+/* Stained Glass OS 6253: a file's attributes as Windows shows them for a cloud file:
+ * FILE_ATTRIBUTE_PINNED / UNPINNED from the pin state, RECALL_ON_DATA_ACCESS when its
+ * data is not on the disk.  (Wine's file system does not keep these.) */
+static DWORD cloud_attributes( const WCHAR *path )
+{
+    DWORD state, pin, ret = 0;
+
+    if (!cloud_status_pin( path, &state, &pin )) return 0;
+    if (pin == 1 /* CF_PIN_STATE_PINNED */) ret |= 0x00080000;        /* FILE_ATTRIBUTE_PINNED */
+    else if (pin == 2 /* CF_PIN_STATE_UNPINNED */) ret |= 0x00100000; /* FILE_ATTRIBUTE_UNPINNED */
+    if (state == 1) ret |= 0x00400000;                                  /* FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS */
+    return ret;
+}
+
+static UINT cloud_status_pin( const WCHAR *path, DWORD *state, DWORD *pin )
 {
     static HRESULT (WINAPI *get_info)( HANDLE, DWORD, void *, DWORD, DWORD * );
     static HRESULT (WINAPI *get_ranges)( HANDLE, DWORD, LONGLONG, LONGLONG, void *, DWORD, DWORD * );
@@ -288,6 +310,7 @@ static UINT cloud_status( const WCHAR *path, DWORD *state )
     UINT id;
 
     *state = 0;
+    *pin = 0;
 #ifdef SG_MUTANT_NO_CLOUD_STATUS
     return 0;
 #endif
@@ -310,6 +333,7 @@ static UINT cloud_status( const WCHAR *path, DWORD *state )
         CloseHandle( file );
         return 0;
     }
+    *pin = basic->pin;
     if (!basic->in_sync)
     {
         id = IDS_SYNC_PENDING;
@@ -1563,11 +1587,18 @@ static ULONG WINAPI overlay_Release(IShellIconOverlay *iface)
 static int item_overlay(IGenericSFImpl *This, PCUITEMID_CHILD pidl, int *image)
 {
     WCHAR path[MAX_PATH], name[MAX_PATH];
-    SFGAOF attributes = SFGAO_FOLDER | SFGAO_FILESYSTEM | SFGAO_LINK | SFGAO_READONLY | SFGAO_HIDDEN | SFGAO_SHARE;
+    DWORD attributes;
 
     if (!pidl || !This->sPathTarget || !_ILSimpleGetTextW(pidl, name, ARRAY_SIZE(name))) return 0;
     if (!PathCombineW(path, This->sPathTarget, name)) return 0;
-    if (FAILED(IShellFolder2_GetAttributesOf(&This->IShellFolder2_iface, 1, &pidl, &attributes))) attributes = 0;
+    /* Stained Glass OS 6253: IsMemberOf gets the file's attributes (FILE_ATTRIBUTE_*), as
+     * documented, with a cloud file's pin and recall bits -- not SFGAO flags */
+#ifndef SG_MUTANT_OVERLAY_SFGAO
+    if ((attributes = GetFileAttributesW(path)) == INVALID_FILE_ATTRIBUTES) attributes = 0;
+    else attributes |= cloud_attributes(path);
+#else
+    attributes = SFGAO_FILESYSTEM;
+#endif
     return SHELL32_OverlayForPath(path, attributes, image);
 }
 
