From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 04:17:41 -0700
Subject: [PATCH] msi: command-line property values follow the quoting rules

A value is plain (ends at a space, quotes in it are ordinary characters) or starts with
a quote: a doubled quote is a quote of the value, a single one closes it and only a space
or the end may follow. P=one" is accepted, P=""one"" is an invalid command line, quoted
values no longer swallow the properties after them. Removes 2 todo_wine in msi's test.

diff --git a/dlls/msi/action.c b/dlls/msi/action.c
index 216304e..d882ebb 100644
--- a/dlls/msi/action.c
+++ b/dlls/msi/action.c
@@ -191,24 +191,44 @@ done:
     return p - str;
 }
 
-static void remove_quotes( WCHAR *str )
+/* A value is either plain (it ends at a space; quotes in it are ordinary characters)
+ * or starts with a quote: then a doubled quote is a quote of the value, a single one
+ * closes it, and only a space or the end of the line may follow.  Returns the number of
+ * characters used in len, FALSE when the quoting is wrong. */
+static BOOL command_line_value( const WCHAR *s, WCHAR *out, int *len )
 {
-    WCHAR *p = str;
-    int len = lstrlenW( str );
+    int i = 0;
 
-    while ((p = wcschr( p, '"' )))
+    if (s[0] != '"')
+    {
+        for (; s[i] && s[i] != ' '; i++) out[i] = s[i];
+        out[i] = 0;
+        *len = i;
+        return TRUE;
+    }
     {
-        memmove( p, p + 1, (len - (p - str)) * sizeof(WCHAR) );
-        p++;
+        int n = 0;
+#ifdef SG_MUTANT_MSI_QUOTECOUNT
+        return FALSE;
+#endif
+        for (i = 1; s[i]; i++)
+        {
+            if (s[i] != '"') { out[n++] = s[i]; continue; }
+            if (s[i + 1] == '"') { out[n++] = '"'; i++; continue; }
+            if (s[i + 1] != 0 && s[i + 1] != ' ') return FALSE;
+            out[n] = 0;
+            *len = i + 1;
+            return TRUE;
+        }
     }
+    return FALSE;
 }
 
 UINT msi_parse_command_line( MSIPACKAGE *package, LPCWSTR szCommandLine,
                              BOOL preserve_case )
 {
     LPCWSTR ptr, ptr2;
-    int num_quotes;
-    DWORD len;
+    int len;
     WCHAR *prop, *val;
     UINT r;
 
@@ -237,17 +257,14 @@ UINT msi_parse_command_line( MSIPACKAGE *package, LPCWSTR szCommandLine,
         ptr2++;
         while (*ptr2 == ' ') ptr2++;
 
-        num_quotes = 0;
         val = malloc( (wcslen( ptr2 ) + 1) * sizeof(WCHAR) );
-        len = parse_prop( ptr2, val, &num_quotes );
-        if (num_quotes % 2)
+        if (!command_line_value( ptr2, val, &len ))
         {
             WARN("unbalanced quotes\n");
             free( val );
             free( prop );
             return ERROR_INVALID_COMMAND_LINE;
         }
-        remove_quotes( val );
         TRACE("Found commandline property %s = %s\n", debugstr_w(prop), debugstr_w(val));
 
         r = msi_set_property( package->db, prop, val, -1 );
diff --git a/dlls/msi/tests/msi.c b/dlls/msi/tests/msi.c
index d676841..1d46205 100644
--- a/dlls/msi/tests/msi.c
+++ b/dlls/msi/tests/msi.c
@@ -13335,7 +13335,7 @@ static void test_command_line_parsing(void)
 
     cmd = "P=one\"";
     r = MsiInstallProductA(msifile, cmd);
-    todo_wine ok(r == ERROR_SUCCESS, "Expected ERROR_SUCCESS, got %u\n", r);
+    ok(r == ERROR_SUCCESS, "Expected ERROR_SUCCESS, got %u\n", r);
 
     cmd = "P=\"one\"";
     r = MsiInstallProductA(msifile, cmd);
@@ -13355,7 +13355,7 @@ static void test_command_line_parsing(void)
 
     cmd = "P=\"\"one\"\"";
     r = MsiInstallProductA(msifile, cmd);
-    todo_wine ok(r == ERROR_INVALID_COMMAND_LINE, "Expected ERROR_INVALID_COMMAND_LINE, got %u\n", r);
+    ok(r == ERROR_INVALID_COMMAND_LINE, "Expected ERROR_INVALID_COMMAND_LINE, got %u\n", r);
 
     cmd = "P=\"one two\"";
     r = MsiInstallProductA(msifile, cmd);
