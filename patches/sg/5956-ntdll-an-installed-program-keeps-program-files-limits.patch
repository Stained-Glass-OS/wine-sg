From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: what is made under a folder's default ACL keeps that
 ACL's limits (5956)

A file or folder a client makes under a folder with a default ACL is not
given the umask (0769, POSIX's rule) -- but the mode the server chose was
then applied whole. With no security descriptor that is the default,
0777 for a folder and 0666 for a file, and fchmod() replaced the ACL's
"others r-x" that Program Files passes down with rwx: every program an
elevated installer put in Program Files was every account's to change,
a standard user's too (qa4/qa5 Store walk 2026-10-22: Geany, Pidgin,
TeraCopy, foobar2000... all 777). The mode is now limited by the
parent's default ACL -- its owner's, mask's (else group's) and others'
entries -- as open() and mkdir() would have limited it. ProgramData and
C:\ (group rwx) keep the users' write.
Gate: test/dirshare-gate.sh (no-descriptor cases); mutant
SG_MUTANT_INHERIT_WIDENS.
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index bfaecd3..bd29690 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4455,6 +4455,32 @@ static NTSTATUS sg_open_errno_to_status( int err )
 
 /* the process umask, read without changing it (umask() would race other
  * threads creating files) */
+/* Stained Glass OS: whether a folder (FD, or PATH) has a default ACL, and
+ * the most of a mode it lets a new entry have (LIMIT): its owner's, its
+ * mask's (else its group's) and others' entries, as open() and mkdir()
+ * apply them */
+static BOOL sg_default_acl_limit( int fd, const char *path, mode_t *limit )
+{
+    unsigned char buf[4 + 8 * 64];
+    ssize_t len = fd != -1 ? fgetxattr( fd, "system.posix_acl_default", buf, sizeof(buf) )
+                           : getxattr( path, "system.posix_acl_default", buf, sizeof(buf) );
+    mode_t u = 7, g = 7, o = 7, mask = 8;
+    ssize_t i;
+
+    if (len <= 4) return FALSE;
+    for (i = 4; i + 8 <= len; i += 8)
+    {
+        unsigned short tag = buf[i] | (buf[i + 1] << 8), perm = (buf[i + 2] | (buf[i + 3] << 8)) & 7;
+        if (tag == 0x01) u = perm;
+        else if (tag == 0x04) g = perm;
+        else if (tag == 0x10) mask = perm;
+        else if (tag == 0x20) o = perm;
+    }
+    if (mask != 8) g = mask;
+    *limit = (u << 6) | (g << 3) | o;
+    return TRUE;
+}
+
 static mode_t sg_umask(void)
 {
     static mode_t cached = (mode_t)-1;
@@ -4639,24 +4665,31 @@ NTSTATUS open_unix_file( HANDLE *handle, const char *unix_name, ACCESS_MASK acce
          * it got from there says so), the umask is not applied -- POSIX's
          * rule, as open() and mkdir() would have done: 022 took the users'
          * write from a folder made in ProgramData */
-        mode_t m = mode & 07777;
+        mode_t m = mode & 07777, limit = 0777;
         BOOL inherited = FALSE;
         struct stat st;
 #ifndef SG_MUTANT_UMASK_ALWAYS
         if (!fstat( fd, &st ) && S_ISDIR( st.st_mode ))   /* a folder has its parent's default ACL */
-            inherited = fgetxattr( fd, "system.posix_acl_default", NULL, 0 ) > 0;
+            inherited = sg_default_acl_limit( fd, NULL, &limit );
         else if (unix_name[0] == '/')
         {
             char *parent = strdup( unix_name ), *slash;
             if (parent && (slash = strrchr( parent, '/' )))
             {
                 if (slash == parent) slash[1] = 0; else *slash = 0;
-                inherited = getxattr( parent, "system.posix_acl_default", NULL, 0 ) > 0;
+                inherited = sg_default_acl_limit( -1, parent, &limit );
             }
             free( parent );
         }
 #endif
         if (!inherited) m &= ~sg_umask();
+#ifndef SG_MUTANT_INHERIT_WIDENS
+        /* ...but the inherited ACL's own limits stand, as open() and mkdir()
+         * would have left them: the default mode (0777, 0666) applied over
+         * Program Files' "others r-x" made every installed program every
+         * account's to change */
+        else m &= 07000 | limit;
+#endif
         fchmod( fd, m );
     }
     close( fd );
