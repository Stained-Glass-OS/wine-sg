From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wscript: enforce WScript.Timeout and //T (3575)

wscript: enforce WScript.Timeout and //T:nn

The countdown starts when the timeout is set; setting it again restarts it and 0
cancels it. When it runs out the host reports "Script execution time was exceeded
on script ..." (message box for wscript, error stream for cscript or //B) and ends
the process with exit code 1. Conformance test and smoke gate extended.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---
diff --git a/programs/wscript/host.c b/programs/wscript/host.c
index ea91418..f3bd9e5 100644
--- a/programs/wscript/host.c
+++ b/programs/wscript/host.c
@@ -273,9 +273,45 @@ static HRESULT WINAPI Host_get_BuildVersion(IHost *iface, int *out_Build)
     return S_OK;
 }
 
-/* seconds after which the host ends the script; 0 for never. The value is kept for the script to read
- * back; the host does not end the script by itself. */
+/* Seconds after which the host ends the script; 0 for never. As in the Windows script host the
+ * countdown starts when the value is set (//T:nn on the command line or WScript.Timeout in the
+ * script); setting it again restarts or, with 0, cancels the countdown. When it runs out the
+ * host reports the overrun and ends the process. */
 static LONG host_timeout;
+static HANDLE timeout_thread, timeout_cancel;
+
+static DWORD WINAPI timeout_proc(void *param)
+{
+    DWORD ms = (DWORD)(ULONG_PTR)param;
+
+    if (WaitForSingleObject(timeout_cancel, ms) != WAIT_TIMEOUT) return 0;
+
+    report_timeout();
+    ExitProcess(1);
+    return 0;
+}
+
+void set_script_timeout(LONG seconds)
+{
+    if (timeout_thread)
+    {
+        SetEvent(timeout_cancel);
+        WaitForSingleObject(timeout_thread, INFINITE);
+        CloseHandle(timeout_thread);
+        CloseHandle(timeout_cancel);
+        timeout_thread = timeout_cancel = NULL;
+    }
+    host_timeout = seconds;
+    if (seconds <= 0) return;
+
+    timeout_cancel = CreateEventW(NULL, TRUE, FALSE, NULL);
+    timeout_thread = CreateThread(NULL, 0, timeout_proc, (void *)(ULONG_PTR)(seconds * 1000), 0, NULL);
+    if (!timeout_thread)
+    {
+        CloseHandle(timeout_cancel);
+        timeout_cancel = NULL;
+    }
+}
 
 static HRESULT WINAPI Host_get_Timeout(IHost *iface, LONG *out_Timeout)
 {
@@ -291,7 +327,7 @@ static HRESULT WINAPI Host_put_Timeout(IHost *iface, LONG v)
     WINE_TRACE("(%ld)\n", v);
 
     if (v < 0) return E_INVALIDARG;
-    host_timeout = v;
+    set_script_timeout(v);
     return S_OK;
 }
 
diff --git a/programs/wscript/main.c b/programs/wscript/main.c
index 1257118..b024913 100644
--- a/programs/wscript/main.c
+++ b/programs/wscript/main.c
@@ -377,6 +377,31 @@ static void run_script(const WCHAR *filename, IActiveScript *script, IActiveScri
         WINE_FIXME("SetScriptState failed: %08lx\n", hres);
 }
 
+/* The message the script host gives when WScript.Timeout runs out: a message box for the
+ * interactive host, the error stream for batch mode (//B). */
+void report_timeout(void)
+{
+    static const WCHAR fmt[] = L"Script execution time was exceeded on script \"%s\". Execution was terminated.";
+    WCHAR msg[MAX_PATH + 128];
+    DWORD written;
+    char buf[(MAX_PATH + 128) * 3];
+    int len;
+
+    swprintf(msg, ARRAY_SIZE(msg), fmt, scriptFullName);
+    if (wshInteractive)
+    {
+        MessageBoxW(NULL, msg, L"Windows Script Host", MB_OK | MB_ICONERROR);
+        return;
+    }
+    len = WideCharToMultiByte(GetConsoleOutputCP(), 0, msg, -1, buf, sizeof(buf) - 2, NULL, NULL);
+    if (len > 0)
+    {
+        buf[len - 1] = '\r';
+        buf[len] = '\n';
+        WriteFile(GetStdHandle(STD_ERROR_HANDLE), buf, len + 1, &written, NULL);
+    }
+}
+
 static BOOL set_host_properties(const WCHAR *prop)
 {
     if(*prop == '/') {
@@ -391,6 +416,13 @@ static BOOL set_host_properties(const WCHAR *prop)
         wshInteractive = VARIANT_TRUE;
     else if(wcsicmp(prop, L"b") == 0)
         wshInteractive = VARIANT_FALSE;
+    else if((prop[0] == 't' || prop[0] == 'T') && prop[1] == ':' && prop[2])
+    {
+        WCHAR *end;
+        LONG v = wcstol(prop + 2, &end, 10);
+        if(*end || v < 0) return FALSE;
+        set_script_timeout(v);
+    }
     else if(wcsicmp(prop, L"nologo") == 0)
         WINE_FIXME("ignored %s switch\n", debugstr_w(L"nologo"));
     else
diff --git a/programs/wscript/tests/run.c b/programs/wscript/tests/run.c
index 7bccf09..44d0eca 100644
--- a/programs/wscript/tests/run.c
+++ b/programs/wscript/tests/run.c
@@ -455,6 +455,57 @@ static BOOL register_activex(void)
     return TRUE;
 }
 
+/* WScript.Timeout (or //T:nn): the host ends a script that outlives it. */
+static void test_timeout(void)
+{
+    static const char *scripts[] = {
+        "WScript.Timeout = 1;\r\nWScript.Sleep(8000);\r\n",
+        "WScript.Sleep(8000);\r\n",
+    };
+    static const char *switches[] = { "//B", "//B //T:1" };
+    static const char *quick = "WScript.Timeout = 5;\r\nWScript.Timeout = 0;\r\nWScript.Sleep(1500);\r\nWScript.Quit(7);\r\n";
+    char command[MAX_PATH + 64];
+    STARTUPINFOA si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD exit_code, size, start, elapsed;
+    HANDLE file;
+    unsigned i;
+
+    for (i = 0; i < 3; i++)
+    {
+        const char *data = i < 2 ? scripts[i] : quick;
+        file = CreateFileA("timeout.js", GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        ok(file != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
+        if (file == INVALID_HANDLE_VALUE) return;
+        WriteFile(file, data, strlen(data), &size, NULL);
+        CloseHandle(file);
+
+        sprintf(command, "wscript.exe %s timeout.js", i < 2 ? switches[i] : "//B");
+        start = GetTickCount();
+        if (!CreateProcessA(NULL, command, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi))
+        {
+            win_skip("wscript.exe is not available\n");
+            break;
+        }
+        WaitForSingleObject(pi.hProcess, 60000);
+        elapsed = GetTickCount() - start;
+        GetExitCodeProcess(pi.hProcess, &exit_code);
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+        if (i < 2)
+        {
+            ok(exit_code == 1, "%u: exit code %lu\n", i, exit_code);
+            ok(elapsed < 6000, "%u: script not ended by the timeout (%lu ms)\n", i, elapsed);
+        }
+        else
+        {
+            ok(exit_code == 7, "cancelled timeout: exit code %lu\n", exit_code);
+            ok(elapsed >= 1400, "cancelled timeout: %lu ms\n", elapsed);
+        }
+    }
+    DeleteFileA("timeout.js");
+}
+
 START_TEST(run)
 {
     char **argv;
@@ -478,7 +529,8 @@ START_TEST(run)
                            "winetest.reportSuccess();\n"
                            "WScript.Quit(3);\n"
                            "winetest.ok(false, 'not quit?');\n", 3);
-}
+        test_timeout();
+    }
 
     init_registry(FALSE);
     CoUninitialize();
