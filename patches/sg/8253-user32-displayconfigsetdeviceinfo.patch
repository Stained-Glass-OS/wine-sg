From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: DisplayConfigSetDeviceInfo

DisplayConfigSetDeviceInfo checks the target (its name must be readable) and handles the documented set packets: boot persistence is accepted (there is no persistence database), the monitor virtual resolution switch is kept per user and DisplayConfigGetDeviceInfo's GET_SUPPORT_VIRTUAL_RESOLUTION reads it back, advanced colour can be turned off but turning it on gives ERROR_NOT_SUPPORTED, matching GET_ADVANCED_COLOR_INFO's SDR report. It was a stub returning ERROR_CALL_NOT_IMPLEMENTED-style errors.
---
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -1177,18 +1177,106 @@
 /***********************************************************************
  *              DisplayConfigGetDeviceInfo (USER32.@)
  */
+#ifndef SG_MUTANT_NO_DCSET
+/* (wine-sg 8253) a target's "monitor virtual resolution" switch, kept per user under this key, named by the
+ * adapter LUID and target id */
+static const WCHAR display_config_keyW[] = L"Software\\Wine\\DisplayConfig";
+
+static void virtual_resolution_name( const DISPLAYCONFIG_DEVICE_INFO_HEADER *packet, WCHAR *name, size_t len )
+{
+    swprintf( name, len, L"%08lx%08lx-%u DisableVirtualResolution", packet->adapterId.HighPart,
+              packet->adapterId.LowPart, packet->id );
+}
+
+/* whether the packet names a target of an active display: its name can be read */
+static BOOL display_config_target_exists( const DISPLAYCONFIG_DEVICE_INFO_HEADER *packet )
+{
+    DISPLAYCONFIG_TARGET_DEVICE_NAME target;
+
+    memset( &target, 0, sizeof(target) );
+    target.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME;
+    target.header.size = sizeof(target);
+    target.header.adapterId = packet->adapterId;
+    target.header.id = packet->id;
+    return !NtUserDisplayConfigGetDeviceInfo( &target.header );
+}
+#endif
+
 LONG WINAPI DisplayConfigGetDeviceInfo(DISPLAYCONFIG_DEVICE_INFO_HEADER *packet)
 {
+#ifndef SG_MUTANT_NO_DCSET
+    if (packet && packet->size >= sizeof(*packet) && packet->type == DISPLAYCONFIG_DEVICE_INFO_GET_SUPPORT_VIRTUAL_RESOLUTION)
+    {
+        DISPLAYCONFIG_SUPPORT_VIRTUAL_RESOLUTION *info = (DISPLAYCONFIG_SUPPORT_VIRTUAL_RESOLUTION *)packet;
+        DWORD value = 0, size = sizeof(value);
+        WCHAR name[64];
+
+        if (packet->size < sizeof(*info) || !display_config_target_exists( packet )) return ERROR_INVALID_PARAMETER;
+        virtual_resolution_name( packet, name, ARRAY_SIZE(name) );
+        if (RegGetValueW( HKEY_CURRENT_USER, display_config_keyW, name, RRF_RT_REG_DWORD, NULL, &value, &size ))
+            value = 0;
+        info->value = 0;
+        info->disableMonitorVirtualResolution = value ? 1 : 0;
+        return ERROR_SUCCESS;
+    }
+#endif
     return RtlNtStatusToDosError(NtUserDisplayConfigGetDeviceInfo(packet));
 }
 
 /***********************************************************************
  *              DisplayConfigSetDeviceInfo (USER32.@)
+ *
+ * Boot persistence of a target is accepted (there is no persistence database), the monitor virtual
+ * resolution switch is kept and read back by DisplayConfigGetDeviceInfo, and advanced colour can be
+ * turned off but not on: the displays are SDR (DisplayConfigGetDeviceInfo reports no advanced colour).
  */
 LONG WINAPI DisplayConfigSetDeviceInfo( DISPLAYCONFIG_DEVICE_INFO_HEADER *packet )
 {
+#ifndef SG_MUTANT_NO_DCSET
+    TRACE( "packet %p, type %d\n", packet, packet ? packet->type : 0 );
+
+    if (!packet || packet->size < sizeof(*packet)) return ERROR_INVALID_PARAMETER;
+    switch (packet->type)
+    {
+    case DISPLAYCONFIG_DEVICE_INFO_SET_TARGET_PERSISTENCE:
+        if (packet->size < sizeof(DISPLAYCONFIG_SET_TARGET_PERSISTENCE) || !display_config_target_exists( packet ))
+            return ERROR_INVALID_PARAMETER;
+        return ERROR_SUCCESS;
+
+    case DISPLAYCONFIG_DEVICE_INFO_SET_SUPPORT_VIRTUAL_RESOLUTION:
+    {
+        DISPLAYCONFIG_SUPPORT_VIRTUAL_RESOLUTION *info = (DISPLAYCONFIG_SUPPORT_VIRTUAL_RESOLUTION *)packet;
+        DWORD value;
+        WCHAR name[64];
+        HKEY key;
+        LONG ret;
+
+        if (packet->size < sizeof(*info) || !display_config_target_exists( packet )) return ERROR_INVALID_PARAMETER;
+        value = info->disableMonitorVirtualResolution;
+        virtual_resolution_name( packet, name, ARRAY_SIZE(name) );
+        if ((ret = RegCreateKeyExW( HKEY_CURRENT_USER, display_config_keyW, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+            return ret;
+        ret = RegSetValueExW( key, name, 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+        RegCloseKey( key );
+        return ret;
+    }
+
+    case DISPLAYCONFIG_DEVICE_INFO_SET_ADVANCED_COLOR_STATE:
+    {
+        DISPLAYCONFIG_SET_ADVANCED_COLOR_STATE *state = (DISPLAYCONFIG_SET_ADVANCED_COLOR_STATE *)packet;
+
+        if (packet->size < sizeof(*state) || !display_config_target_exists( packet )) return ERROR_INVALID_PARAMETER;
+        return state->enableAdvancedColor ? ERROR_NOT_SUPPORTED : ERROR_SUCCESS;
+    }
+
+    default:
+        FIXME( "packet type %d not handled\n", packet->type );
+        return ERROR_INVALID_PARAMETER;
+    }
+#else
     FIXME( "stub!\n" );
     return RtlNtStatusToDosError( STATUS_NOT_IMPLEMENTED );
+#endif
 }
 
