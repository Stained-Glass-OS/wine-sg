+/* Selection movement works as the keys do: units are characters and words
+ * to the left and right, lines up and down, lines and the story for Home and
+ * End. A selection that is not an insertion point collapses first, which
+ * counts as the first unit when it is not extended. */
+static HRESULT selection_move(ME_TextEditor *editor, int vkey, BOOL ctrl, LONG count, LONG extend, LONG *delta)
+{
+    LONG moved = 0, want = count < 0 ? -count : count, from, to, from2, to2;
+    int key = vkey;
+    BOOL reverse = count < 0;
+
+    if (delta) *delta = 0;
+    if (!count) return S_FALSE;
+
+    if (reverse)
+    {
+        if (vkey == VK_LEFT) key = VK_RIGHT;
+        else if (vkey == VK_RIGHT) key = VK_LEFT;
+        else if (vkey == VK_UP) key = VK_DOWN;
+        else if (vkey == VK_DOWN) key = VK_UP;
+    }
+
+    while (moved < want)
+    {
+        ME_GetSelectionOfs(editor, &from, &to);
+        if (!extend && from != to && (key == VK_LEFT || key == VK_RIGHT))
+        {
+#ifndef SG_MUTANT_SEL_COLLAPSE
+            LONG at = key == VK_LEFT ? from : to;
+            set_selection(editor, at, at);
+            moved++;
+            continue;
+#endif
+        }
+        ME_ArrowKey(editor, key, extend != 0, ctrl);
+        ME_GetSelectionOfs(editor, &from2, &to2);
+        if (from2 == from && to2 == to) break;
+        moved++;
+    }
+
+    if (delta) *delta = reverse ? -moved : moved;
+    return moved == want ? S_OK : S_FALSE;
+}
+
+static HRESULT selection_key_move(ME_TextEditor *editor, int vkey, LONG unit, LONG extend, LONG *delta)
+{
+    LONG from, to, from2, to2, start_pos;
+    BOOL ctrl;
+
+    if (delta) *delta = 0;
+    if (unit != tomLine && unit != tomStory) return E_INVALIDARG;
+    ctrl = unit == tomStory;
+
+    ME_GetSelectionOfs(editor, &from, &to);
+    start_pos = from;
+    ME_ArrowKey(editor, vkey, extend != 0, ctrl);
+    ME_GetSelectionOfs(editor, &from2, &to2);
+    if (delta) *delta = abs((from2 == from ? to2 : from2) - (vkey == VK_HOME ? start_pos : to));
+    return from2 == from && to2 == to ? S_FALSE : S_OK;
+}
+
 static HRESULT WINAPI ITextSelection_fnSetRange(ITextSelection *me, LONG anchor, LONG active)
 {
     struct text_selection *This = impl_from_ITextSelection(me);
+    ME_TextEditor *editor;
+    LONG len;
 
-    FIXME("(%p)->(%ld %ld): stub\n", This, anchor, active);
+    TRACE("(%p)->(%ld %ld)\n", This, anchor, active);
 
     if (!This->services)
         return CO_E_RELEASED;
 
-    return E_NOTIMPL;
+    editor = This->services->editor;
+    len = ME_GetTextLength(editor);
+    anchor = max(0, min(anchor, len + 1));
+    active = max(0, min(active, len + 1));
+
+    /* the anchor is where the selection started, the active end is the caret */
+    set_selection(editor, anchor, active);
+#ifndef SG_MUTANT_SEL_RANGE_ACTIVE
+    if (anchor > active)
+    {
+        ME_Cursor tmp = editor->pCursors[0];
+        editor->pCursors[0] = editor->pCursors[1];
+        editor->pCursors[1] = tmp;
+    }
+#endif
+    return S_OK;
 }
 
