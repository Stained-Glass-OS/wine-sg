 static HRESULT WINAPI ITextSelection_fnTypeText(ITextSelection *me, BSTR text)
 {
     struct text_selection *This = impl_from_ITextSelection(me);
+    ME_TextEditor *editor;
+    LONG from, to, len;
 
-    FIXME("(%p)->(%s): stub\n", This, debugstr_w(text));
+    TRACE("(%p)->(%s)\n", This, debugstr_w(text));
 
     if (!This->services)
         return CO_E_RELEASED;
 
-    return E_NOTIMPL;
+    editor = This->services->editor;
+    if (editor->props & TXTBIT_READONLY)
+        return E_ACCESSDENIED;
+
+    /* the text replaces the selection and the insertion point follows it */
+    ME_GetSelectionOfs(editor, &from, &to);
+    len = text ? lstrlenW(text) : 0;
+    ME_ReplaceSel(editor, TRUE, text ? text : L"", len);
+    if (len < to - from)
+        textranges_update_ranges(This->services, from + len, to, RANGE_UPDATE_DELETE);
+    return S_OK;
 }
 
