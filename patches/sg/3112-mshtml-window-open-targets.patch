From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 22:02:27 -0700
Subject: [PATCH] mshtml: window.open finds a frame or window by name and
 handles the reserved targets

window.open(url, name) now navigates the frame of the page or the top window
that has that name and returns it, instead of always making a new window.
_parent and _top navigate the parent and the top window; _blank, _search and
_media make a window without a name. A frame that has not loaded an address of
its own can call window.open. Also release the frame collection that
get_frame_by_name leaked when it found the frame by name.

diff --git a/dlls/mshtml/htmlwindow.c b/dlls/mshtml/htmlwindow.c
index 1a88082..0b3abe8 100644
--- a/dlls/mshtml/htmlwindow.c
+++ b/dlls/mshtml/htmlwindow.c
@@ -324,6 +324,7 @@ HRESULT get_frame_by_name(HTMLOuterWindow *This, const WCHAR *name, BOOL deep, H
     }
 
     if(mozwindow) {
+        nsIDOMWindowCollection_Release(nsframes);
         *ret = mozwindow_to_window(mozwindow);
         return S_OK;
     }
@@ -903,7 +904,7 @@ static HRESULT WINAPI HTMLWindow2_open(IHTMLWindow2 *iface, BSTR url, BSTR name,
     if(replace)
         FIXME("unsupported relace argument\n");
 
-    if(!window->browser || !window->uri_nofrag)
+    if(!window->browser)
         return E_UNEXPECTED;
 
     if(name && *name == '_') {
@@ -924,8 +925,59 @@ static HRESULT WINAPI HTMLWindow2_open(IHTMLWindow2 *iface, BSTR url, BSTR name,
             return S_OK;
         }
 
-        FIXME("Unsupported name %s\n", debugstr_w(name));
-        return E_NOTIMPL;
+        if(!wcscmp(name, L"_parent") || !wcscmp(name, L"_top")) {
+            HTMLOuterWindow *target = window;
+
+            if(!wcscmp(name, L"_top"))
+                get_top_window(window, &target);
+            else if(window->parent)
+                target = window->parent;
+
+            hres = navigate_url(target, url, window->uri, BINDING_NAVIGATED);
+            if(FAILED(hres))
+                return hres;
+            if(pomWindowResult) {
+                *pomWindowResult = &target->base.IHTMLWindow2_iface;
+                IHTMLWindow2_AddRef(*pomWindowResult);
+            }
+            return S_OK;
+        }
+
+        /* _blank and _search are windows without a name */
+        if(!wcscmp(name, L"_blank") || !wcscmp(name, L"_search") || !wcscmp(name, L"_media"))
+            name = NULL;
+    }
+
+#ifdef SG_MUTANT_MSHTML_OPEN_NONAME
+    if(0)
+#else
+    if(name && *name)
+#endif
+    {
+        /* a name finds a frame of the page, or the top window of that name, before a window is made */
+        HTMLOuterWindow *target = NULL, *top;
+
+        get_top_window(window, &top);
+        get_frame_by_name(window, name, TRUE, &target);
+        if(!target && top != window)
+            get_frame_by_name(top, name, TRUE, &target);
+        if(!target) {
+            BSTR top_name = NULL;
+
+            if(SUCCEEDED(IHTMLWindow2_get_name(&top->base.IHTMLWindow2_iface, &top_name)) && top_name && !wcscmp(top_name, name))
+                target = top;
+            SysFreeString(top_name);
+        }
+        if(target) {
+            hres = navigate_url(target, url, window->uri, BINDING_NAVIGATED);
+            if(FAILED(hres))
+                return hres;
+            if(pomWindowResult) {
+                *pomWindowResult = &target->base.IHTMLWindow2_iface;
+                IHTMLWindow2_AddRef(*pomWindowResult);
+            }
+            return S_OK;
+        }
     }
 
     hres = create_relative_uri(window, url, &uri);
diff --git a/dlls/mshtml/navigate.c b/dlls/mshtml/navigate.c
index bf8b6fa..9feb8b7 100644
--- a/dlls/mshtml/navigate.c
+++ b/dlls/mshtml/navigate.c
@@ -2456,7 +2456,13 @@ HRESULT navigate_new_window(HTMLOuterWindow *window, IUri *uri, const WCHAR *nam
             return hres;
         }
 
-        hres = IUri_GetDisplayUri(window->uri_nofrag, &context_url);
+        /* a frame that has not loaded anything has no address of its own */
+        if(window->uri_nofrag) {
+            hres = IUri_GetDisplayUri(window->uri_nofrag, &context_url);
+        }else {
+            context_url = SysAllocString(L"");
+            hres = context_url ? S_OK : E_OUTOFMEMORY;
+        }
         if(FAILED(hres))
             return hres;
 
