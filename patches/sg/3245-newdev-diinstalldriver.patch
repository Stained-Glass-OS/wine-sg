index db8ae80..2e8af8d 100644
--- a/dlls/newdev/Makefile.in
+++ b/dlls/newdev/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = newdev.dll
 IMPORTLIB = newdev
-IMPORTS   = setupapi
+IMPORTS   = setupapi advapi32
 
 SOURCES = \
 	main.c
diff --git a/dlls/newdev/main.c b/dlls/newdev/main.c
index dcf7e39..e8cd519 100644
--- a/dlls/newdev/main.c
+++ b/dlls/newdev/main.c
@@ -28,6 +28,11 @@
 #include "winreg.h"
 #include "cfgmgr32.h"
 #include "newdev.h"
+#include "setupapi.h"
+#include "winnt.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <wchar.h>
 
 #include "wine/debug.h"
 
@@ -148,20 +153,281 @@ BOOL WINAPI UpdateDriverForPlugAndPlayDevicesW(HWND parent, const WCHAR *hardwar
 }
 
 
+/* "m-d-yyyy" (the DriverDate value of a driver key) as a FILETIME */
+static BOOL parse_driver_date(const WCHAR *str, FILETIME *ft)
+{
+    SYSTEMTIME st = {0};
+    WCHAR *end;
+
+    st.wMonth = wcstoul(str, &end, 10);
+    if (*end != '-' && *end != '/') return FALSE;
+    st.wDay = wcstoul(end + 1, &end, 10);
+    if (*end != '-' && *end != '/') return FALSE;
+    st.wYear = wcstoul(end + 1, &end, 10);
+    return SystemTimeToFileTime(&st, ft);
+}
+
+static ULONGLONG parse_driver_version(const WCHAR *str)
+{
+    ULONGLONG ver = 0;
+    unsigned int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        WCHAR *end;
+        ver = (ver << 16) | (wcstoul(str, &end, 10) & 0xffff);
+        if (*end != '.') { ver <<= 16 * (3 - i); break; }
+        str = end + 1;
+    }
+    return ver;
+}
+
+/* the rank setupapi gives a driver for the ID that matched: the index in the hardware IDs,
+ * 0x2000 and up in the compatible IDs; -1 when the device lists neither */
+static DWORD installed_rank(HDEVINFO set, SP_DEVINFO_DATA *device, const WCHAR *matching)
+{
+    static const struct { DWORD prop, base; } lists[] = { {SPDRP_HARDWAREID, 0}, {SPDRP_COMPATIBLEIDS, 0x2000} };
+    unsigned int k;
+
+    for (k = 0; k < ARRAY_SIZE(lists); k++)
+    {
+        WCHAR *ids = NULL;
+        DWORD size = 0, i;
+        const WCHAR *p;
+
+        SetupDiGetDeviceRegistryPropertyW(set, device, lists[k].prop, NULL, NULL, 0, &size);
+        if (!size || !(ids = malloc(size))) continue;
+        if (SetupDiGetDeviceRegistryPropertyW(set, device, lists[k].prop, NULL, (BYTE *)ids, size, NULL))
+        {
+            for (p = ids, i = 0; *p; p += lstrlenW(p) + 1, i++)
+            {
+                if (!wcsicmp(p, matching))
+                {
+                    free(ids);
+                    return lists[k].base + min(i, 0xff);
+                }
+            }
+        }
+        free(ids);
+    }
+    return ~0u;
+}
+
+/* Is the driver the device has now at least as good as the one in the INF?  Windows
+ * compares the rank first, then the date and then the version. */
+static BOOL device_has_better_driver(HDEVINFO set, SP_DEVINFO_DATA *device, const SP_DRVINFO_DATA_W *candidate)
+{
+    SP_DRVINSTALL_PARAMS cand_params = {sizeof(cand_params)};
+    WCHAR value[LINE_LEN];
+    DWORD size, type;
+    FILETIME installed;
+    HKEY key;
+    BOOL ret = FALSE;
+
+    size = sizeof(value);
+    if (!SetupDiGetDeviceRegistryPropertyW(set, device, SPDRP_DRIVER, NULL, (BYTE *)value, sizeof(value), NULL))
+        return FALSE; /* no driver installed */
+
+    if ((key = SetupDiOpenDevRegKey(set, device, DICS_FLAG_GLOBAL, 0, DIREG_DRV, KEY_READ)) == INVALID_HANDLE_VALUE)
+        return FALSE;
+
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"MatchingDeviceId", NULL, &type, (BYTE *)value, &size) && type == REG_SZ
+            && SetupDiGetDriverInstallParamsW(set, device, (SP_DRVINFO_DATA_W *)candidate, &cand_params))
+    {
+        DWORD rank = installed_rank(set, device, value);
+
+#ifndef SG_MUTANT_NDV_NORANK
+        if (rank < cand_params.Rank) { RegCloseKey(key); return TRUE; }
+        if (rank > cand_params.Rank) { RegCloseKey(key); return FALSE; }
+#endif
+    }
+
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"DriverDate", NULL, &type, (BYTE *)value, &size) && type == REG_SZ
+            && parse_driver_date(value, &installed))
+    {
+        int cmp = CompareFileTime(&installed, &candidate->DriverDate);
+
+        if (cmp > 0) ret = TRUE;
+        else if (!cmp)
+        {
+            size = sizeof(value);
+            if (!RegQueryValueExW(key, L"DriverVersion", NULL, &type, (BYTE *)value, &size) && type == REG_SZ)
+                ret = parse_driver_version(value) >= candidate->DriverVersion;
+            else
+                ret = TRUE;
+        }
+    }
+    else
+        ret = TRUE; /* a driver of unknown date is left alone */
+    RegCloseKey(key);
+    return ret;
+}
+
+static BOOL is_admin(void)
+{
+    SID_IDENTIFIER_AUTHORITY auth = {SECURITY_NT_AUTHORITY};
+    PSID sid;
+    BOOL ret = FALSE;
+
+    if (!AllocateAndInitializeSid(&auth, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &sid))
+        return FALSE;
+    if (!CheckTokenMembership(NULL, sid, &ret)) ret = FALSE;
+    FreeSid(sid);
+    return ret;
+}
+
+static BOOL install_inf_on_devices(const WCHAR *inf_path, DWORD flags, BOOL *reboot)
+{
+    SP_DEVINSTALL_PARAMS_W params = {sizeof(params)};
+    SP_DEVINFO_DATA device = {sizeof(device)};
+    SP_DRVINFO_DATA_W drvinfo = {sizeof(drvinfo)};
+    DWORD i, j;
+    HDEVINFO set;
+
+    static const DWORD dif_list[] =
+    {
+        DIF_SELECTBESTCOMPATDRV,
+        DIF_ALLOW_INSTALL,
+        DIF_INSTALLDEVICEFILES,
+        DIF_REGISTER_COINSTALLERS,
+        DIF_INSTALLINTERFACES,
+        DIF_INSTALLDEVICE,
+        DIF_NEWDEVICEWIZARD_FINISHINSTALL,
+    };
+
+    if ((set = SetupDiGetClassDevsW(NULL, NULL, 0, DIGCF_ALLCLASSES | DIGCF_PRESENT)) == INVALID_HANDLE_VALUE)
+        return TRUE; /* the package is in the driver store: that is a success */
+
+    for (i = 0; SetupDiEnumDeviceInfo(set, i, &device); ++i)
+    {
+        if (!SetupDiGetDeviceInstallParamsW(set, &device, &params)) continue;
+        lstrcpyW(params.DriverPath, inf_path);
+        params.Flags |= DI_ENUMSINGLEINF;
+        if (!SetupDiSetDeviceInstallParamsW(set, &device, &params)) continue;
+
+        if (!SetupDiBuildDriverInfoList(set, &device, SPDIT_COMPATDRIVER)) continue;
+        drvinfo.cbSize = sizeof(drvinfo);
+        if (!SetupDiEnumDriverInfoW(set, &device, SPDIT_COMPATDRIVER, 0, &drvinfo)) continue;
+
+        #ifdef SG_MUTANT_NDV_ALWAYS
+        if (0)
+#elif defined(SG_MUTANT_NDV_NOFORCE)
+        if (device_has_better_driver(set, &device, &drvinfo))
+#else
+        if (!(flags & DIIRFLAG_FORCE_INF) && device_has_better_driver(set, &device, &drvinfo))
+#endif
+        {
+            TRACE("device %lu keeps its driver\n", i);
+            continue;
+        }
+
+        for (j = 0; j < ARRAY_SIZE(dif_list); ++j)
+        {
+            if (!SetupDiCallClassInstaller(dif_list[j], set, &device) && GetLastError() != ERROR_DI_DO_DEFAULT)
+                break;
+        }
+
+        params.cbSize = sizeof(params);
+        if (reboot && SetupDiGetDeviceInstallParamsW(set, &device, &params)
+                && (params.Flags & (DI_NEEDREBOOT | DI_NEEDRESTART)))
+            *reboot = TRUE;
+    }
+
+    SetupDiDestroyDeviceInfoList(set);
+    return TRUE;
+}
+
 /***********************************************************************
  *           DiInstallDriverA (NEWDEV.@)
  */
 BOOL WINAPI DiInstallDriverA(HWND parent, const char *inf_path, DWORD flags, BOOL *reboot)
 {
-    FIXME("parent %p, inf_path %s, flags %#lx, reboot %p, stub!\n", parent, debugstr_a(inf_path), flags, reboot);
-    return TRUE;
+    WCHAR pathW[MAX_PATH];
+
+    TRACE("parent %p, inf_path %s, flags %#lx, reboot %p.\n", parent, debugstr_a(inf_path), flags, reboot);
+
+    if (!inf_path)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    MultiByteToWideChar(CP_ACP, 0, inf_path, -1, pathW, ARRAY_SIZE(pathW));
+    return DiInstallDriverW(parent, pathW, flags, reboot);
 }
 
 /***********************************************************************
  *           DiInstallDriverW (NEWDEV.@)
+ *
+ * Stage the driver package in the driver store (the OEM INF directory), then
+ * install it on the present devices it supports and that do not already have
+ * a better driver (all of them with DIIRFLAG_FORCE_INF).
  */
 BOOL WINAPI DiInstallDriverW(HWND parent, const WCHAR *inf_path, DWORD flags, BOOL *reboot)
 {
-    FIXME("parent %p, inf_path %s, flags %#lx, reboot %p, stub!\n", parent, debugstr_w(inf_path), flags, reboot);
-    return TRUE;
+    WCHAR dest[MAX_PATH];
+    BOOL wow64 = FALSE, set = !!(flags & DIIRFLAG_INSTALL_AS_SET);
+
+    TRACE("parent %p, inf_path %s, flags %#lx, reboot %p.\n", parent, debugstr_w(inf_path), flags, reboot);
+
+    if (!inf_path)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (flags & ~(DIIRFLAG_FORCE_INF | DIIRFLAG_INSTALL_AS_SET))
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
+    #ifdef SG_MUTANT_NDV_NOWOW64
+    if (0)
+#else
+    if (IsWow64Process(GetCurrentProcess(), &wow64) && wow64)
+#endif
+    {
+        SetLastError(ERROR_IN_WOW64);
+        return FALSE;
+    }
+    if (!is_admin())
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    if (GetFileAttributesW(inf_path) == INVALID_FILE_ATTRIBUTES)
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+
+    if (reboot) *reboot = FALSE;
+
+    if (set)
+    {
+        /* every INF of the directory is staged; none is installed on a device now */
+        WCHAR pattern[MAX_PATH], file[MAX_PATH];
+        WIN32_FIND_DATAW fd;
+        HANDLE find;
+        BOOL any = FALSE;
+
+        swprintf(pattern, ARRAY_SIZE(pattern), L"%ls\\*.inf", inf_path);
+        if ((find = FindFirstFileW(pattern, &fd)) == INVALID_HANDLE_VALUE)
+        {
+            SetLastError(ERROR_FILE_NOT_FOUND);
+            return FALSE;
+        }
+        do
+        {
+            swprintf(file, ARRAY_SIZE(file), L"%ls\\%ls", inf_path, fd.cFileName);
+            if (SetupCopyOEMInfW(file, NULL, SPOST_PATH, 0, dest, ARRAY_SIZE(dest), NULL, NULL)) any = TRUE;
+        } while (FindNextFileW(find, &fd));
+        FindClose(find);
+        return any;
+    }
+
+    if (!SetupCopyOEMInfW(inf_path, NULL, SPOST_PATH, 0, dest, ARRAY_SIZE(dest), NULL, NULL))
+        return FALSE;
+
+    return install_inf_on_devices(dest, flags, reboot);
 }
