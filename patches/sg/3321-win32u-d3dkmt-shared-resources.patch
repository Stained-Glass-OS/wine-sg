+                                            &alloc_size[i], NULL, &block )))
+                break;
+            status = kmt_objects_create( params->hDevice, block, FALSE, &dummy, &objects[i] );
+            kmt_block_unref( block );
+            if (status) break;
+            /* the resource made along with it is not there for the caller */
+            objects[i]->resource = 0;
+            kmt_object_free( dummy );
+            created++;
+        }
+        if (status)
+        {
+            while (created) kmt_object_free( objects[--created] );
+        }
+        else
+        {
+            for (i = 0; i < params->NumAllocations; i++)
+            {
+                if (info2) params->pAllocationInfo2[i].hAllocation = objects[i]->handle;
+                else params->pAllocationInfo[i].hAllocation = objects[i]->handle;
+            }
+        }
+    }
+
+done:
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
 }
 
