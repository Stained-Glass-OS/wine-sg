+            alloc_size[i] = params->pAllocationInfo2[i].PrivateDriverDataSize;
+        }
+        else
+        {
+            alloc_data[i] = params->pAllocationInfo[i].pPrivateDriverData;
+            alloc_size[i] = params->pAllocationInfo[i].PrivateDriverDataSize;
+        }
+        if (alloc_size[i] && !alloc_data[i]) return STATUS_INVALID_PARAMETER;
+    }
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!kmt_device_exists( params->hDevice ))
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    if (flags.CreateResource)
+    {
+        global_id = 0;
+        if ((status = kmt_block_create( KMT_SHARE_RESOURCE, params->pPrivateRuntimeData,
+                                        params->PrivateRuntimeDataSize, params->pPrivateDriverData,
+                                        params->PrivateDriverDataSize, params->NumAllocations, alloc_data,
+                                        alloc_size, (flags.CreateShared && !flags.NtSecuritySharing) ? &global_id : NULL,
