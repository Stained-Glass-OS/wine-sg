+/******************************************************************************
+ *           NtGdiDdDDIShareObjects    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIShareObjects( UINT count, const D3DKMT_HANDLE *handles, OBJECT_ATTRIBUTES *attr,
+                                        UINT access, HANDLE *handle )
+{
+    struct kmt_object *resource = NULL;
+    struct kmt_block *block;
+    NTSTATUS status;
+    UINT i;
+
+    TRACE( "count %u, handles %p, attr %p, access %#x, handle %p\n", count, handles, attr, access, handle );
+
+    if (!count || !handles || !handle) return STATUS_INVALID_PARAMETER;
+    *handle = NULL;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    for (i = 0; i < count; i++)
+    {
+        struct kmt_object *object;
+
+        if ((object = kmt_find( handles[i], KMT_RESOURCE )) && !resource) resource = object;
+        else
+        {
+            pthread_mutex_unlock( &d3dkmt_lock );
+            return STATUS_INVALID_PARAMETER;
+        }
+    }
+#ifndef SG_MUTANT_KMT_SHARE_ANY
+    if (!resource->nt_sharing)
+#else
+    if (FALSE)
+#endif
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    block = resource->block;
+    /* a name makes a section of its own, the block moves to it */
+    if (attr && attr->ObjectName) status = kmt_block_rebind( block, attr );
+    else status = STATUS_SUCCESS;
+#ifdef SG_MUTANT_KMT_SHARE_COPY
+    if (!status)
+    {
+        /* a copy of the pixels, not the resource's own */
+        struct kmt_share_header *copy;
+        HANDLE csection;
+        if (!(status = kmt_section_create( block->size, NULL, &csection, &copy )))
+        {
+            memcpy( copy, block->hdr, block->size );
+            NtUnmapViewOfSection( NtCurrentProcess(), copy );
+            status = NtDuplicateObject( NtCurrentProcess(), csection, NtCurrentProcess(), handle, access, 0,
+                                        access ? 0 : DUPLICATE_SAME_ACCESS );
+            NtClose( csection );
+        }
+    }
+#else
+    if (!status)
+        status = NtDuplicateObject( NtCurrentProcess(), block->section, NtCurrentProcess(), handle, access,
+                                    (attr && (attr->Attributes & OBJ_INHERIT)) ? OBJ_INHERIT : 0,
+                                    access ? 0 : DUPLICATE_SAME_ACCESS );
+#endif
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
+/* The runtime data and the driver data of the resource of a block, and the sizes to ask for. */
+static NTSTATUS kmt_resource_info( struct kmt_share_header *hdr, void *runtime, UINT *runtime_size,
+                                   UINT *total_driver_size, UINT *resource_driver_size, UINT *alloc_count )
+{
+    struct kmt_share_alloc *allocs = (struct kmt_share_alloc *)((char *)hdr + hdr->alloc_off);
+    UINT i, total = hdr->driver_size;
+
+    if (!(hdr->flags & KMT_SHARE_RESOURCE)) return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < hdr->alloc_count; i++) total += allocs[i].private_size;
+    if (runtime && *runtime_size < hdr->runtime_size) return STATUS_BUFFER_TOO_SMALL;
+    if (runtime) memcpy( runtime, (char *)hdr + hdr->runtime_off, hdr->runtime_size );
+    *runtime_size = hdr->runtime_size;
+    *total_driver_size = total;
+    *resource_driver_size = hdr->driver_size;
+    *alloc_count = hdr->alloc_count;
+    return STATUS_SUCCESS;
+}
+
+/* Opens the resource of a block for a device: the objects, and what the runtime asked to be told.
+ * The block's reference stays with the caller. */
+static NTSTATUS kmt_resource_open( D3DKMT_HANDLE device, struct kmt_block *block, UINT count, void *infos,
+                                   BOOL info2, void *runtime, UINT runtime_size, void *resource_driver,
+                                   UINT resource_driver_size, void *total, UINT total_size,
+                                   D3DKMT_HANDLE *hresource )
+{
+    struct kmt_share_header *hdr = block->hdr;
+    struct kmt_share_alloc *allocs = (struct kmt_share_alloc *)((char *)hdr + hdr->alloc_off);
+    struct kmt_object *resource, *objects[KMT_MAX_ALLOCS];
+    UINT i, needed = hdr->driver_size, off;
+    NTSTATUS status;
+
+    if (!(hdr->flags & KMT_SHARE_RESOURCE) || count != hdr->alloc_count || (count && !infos))
+        return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < count; i++) needed += allocs[i].private_size;
+#ifndef SG_MUTANT_KMT_OPEN_NOCHECK
+    if ((runtime && runtime_size < hdr->runtime_size)
+        || (resource_driver && resource_driver_size < hdr->driver_size)
+        || (total && total_size < needed))
+        return STATUS_BUFFER_TOO_SMALL;
+#endif
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!kmt_device_exists( device )) status = STATUS_INVALID_PARAMETER;
+    else status = kmt_objects_create( device, block, TRUE, &resource, objects );
+    if (status)
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return status;
+    }
+
+    if (runtime) memcpy( runtime, (char *)hdr + hdr->runtime_off, hdr->runtime_size );
+    if (resource_driver) memcpy( resource_driver, (char *)hdr + hdr->driver_off, hdr->driver_size );
+    if (total) memcpy( total, (char *)hdr + hdr->driver_off, hdr->driver_size );
+    off = hdr->driver_size;
+    for (i = 0; i < count; i++)
+    {
+        D3DKMT_HANDLE *handle;
+        const void **driver_data;
+        UINT *driver_size;
+
+        if (info2)
+        {
+            D3DDDI_OPENALLOCATIONINFO2 *info = (D3DDDI_OPENALLOCATIONINFO2 *)infos + i;
+            handle = &info->hAllocation;
+            driver_data = &info->pPrivateDriverData;
+            driver_size = &info->PrivateDriverDataSize;
+        }
+        else
+        {
+            D3DDDI_OPENALLOCATIONINFO *info = (D3DDDI_OPENALLOCATIONINFO *)infos + i;
+            handle = &info->hAllocation;
+            driver_data = &info->pPrivateDriverData;
+            driver_size = &info->PrivateDriverDataSize;
+        }
+        *handle = objects[i]->handle;
+        *driver_size = allocs[i].private_size;
+        if (total)
+        {
+            memcpy( (char *)total + off, (char *)hdr + allocs[i].private_off, allocs[i].private_size );
+            *driver_data = (char *)total + off;
+        }
+        off += allocs[i].private_size;
+    }
+    *hresource = resource->handle;
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS kmt_open_resource( D3DKMT_OPENRESOURCE *params, BOOL info2 )
+{
+    struct kmt_block *block;
+    NTSTATUS status;
+
+    if (!params) return STATUS_INVALID_PARAMETER;
+    if ((status = kmt_block_open_global( params->hGlobalShare, &block ))) return status;
+    status = kmt_resource_open( params->hDevice, block, params->NumAllocations, params->pOpenAllocationInfo,
+                                info2, params->pPrivateRuntimeData, params->PrivateRuntimeDataSize,
+                                params->pResourcePrivateDriverData, params->ResourcePrivateDriverDataSize,
+                                params->pTotalPrivateDriverDataBuffer, params->TotalPrivateDriverDataBufferSize,
+                                &params->hResource );
+    if (!status) params->PrivateRuntimeDataSize = block->hdr->runtime_size;
+    pthread_mutex_lock( &d3dkmt_lock );
+    kmt_block_unref( block );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
 }
 
