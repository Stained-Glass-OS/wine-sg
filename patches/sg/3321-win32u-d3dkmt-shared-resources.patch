-/******************************************************************************
- *           NtGdiDdDDIShareObjects    (win32u.@)
- */
-NTSTATUS WINAPI NtGdiDdDDIShareObjects( UINT count, const D3DKMT_HANDLE *handles, OBJECT_ATTRIBUTES *attr,
-                                        UINT access, HANDLE *handle )
+/* ---- shared graphics objects ----
+ *
+ * There is no kernel-mode driver behind these functions, so a resource is a
+ * block of system memory: a header, the private data the runtime attached to
+ * the resource and its allocations, and the allocations' content. A block that
+ * is shared lives in a section, which is also what an NT handle made by
+ * D3DKMTShareObjects is, and what a global (legacy) share handle names. See
+ * wine/kmtshare.h for the conventions the runtime follows. */
+
+#define KMT_SHARE_MAGIC     0x4d4b4753   /* "SGKM" */
+#define KMT_SHARE_VERSION   1
+#define KMT_SHARE_RESOURCE  0x1
+#define KMT_SHARE_MUTEX     0x2
+#define KMT_SHARE_SYNC      0x4
+#define KMT_MAX_CONTENT     0x40000000
+#define KMT_MAX_PRIVATE     0x100000
+#define KMT_MAX_ALLOCS      0x1000
+
+struct kmt_share_alloc
 {
-    FIXME( "count %u, handles %p, attr %p, access %#x, handle %p stub!\n", count, handles, attr, access, handle );
-    return STATUS_NOT_IMPLEMENTED;
+    UINT   private_size, private_off;
+    UINT64 content_size, content_off;
+};
+
+#define KMT_MUTEX_RUNTIME_MAX 256
+
+struct kmt_share_header
+{
+    UINT   magic, version, flags, global_id;
+    UINT64 total_size;
+    UINT   runtime_size, runtime_off;       /* private runtime data of the resource */
+    UINT   driver_size, driver_off;         /* private driver data of the resource */
+    UINT   alloc_count, alloc_off;          /* struct kmt_share_alloc[] */
+    UINT   mutex_runtime_size, sync_type;
+    UINT   sync_flags, pad0;
+    UINT64 sync_max;
+    /* what every process that has the block mapped sees */
+    UINT64 mutex_key;
+    LONG64 mutex_owner;
+    LONG   mutex_abandoned, pad1;
+    UINT64 sync_value;
+    BYTE   mutex_runtime[KMT_MUTEX_RUNTIME_MAX];    /* private runtime data of the keyed mutex */
+};
+
+enum kmt_type { KMT_RESOURCE = 1, KMT_ALLOCATION, KMT_KEYEDMUTEX, KMT_SYNC };
+
+#define KMT_MAX_OLD_VIEWS 4
+
+struct kmt_block
+{
+    LONG ref;
+    struct kmt_share_header *hdr;
+    SIZE_T size;
+    HANDLE section;
+    /* A block that is given a name moves to a section of that name. What a thread that is waiting on
+     * the block has mapped stays, so that it does not read freed memory. */
+    struct { struct kmt_share_header *hdr; HANDLE section; } old[KMT_MAX_OLD_VIEWS];
+    UINT old_count;
+};
+
+struct kmt_object
+{
+    struct list entry;
+    D3DKMT_HANDLE handle, device;
+    enum kmt_type type;
+    struct kmt_block *block;
+    D3DKMT_HANDLE resource;             /* allocation: the resource it belongs to, or 0 */
+    UINT index;                         /* allocation: its index in the block */
+    BOOL nt_sharing;                    /* resource: made for NT handle sharing */
+};
+
+static struct list kmt_objects = LIST_INIT( kmt_objects );     /* d3dkmt_lock */
+static LONG kmt_next_handle = 0x40000000;
+static LONG *kmt_counter;
+
+static inline UINT64 kmt_align( UINT64 value, UINT64 alignment ) { return (value + alignment - 1) & ~(alignment - 1); }
+
+static inline BOOL kmt_in_range( UINT64 off, UINT64 size, UINT64 total )
+{
+    return off <= total && size <= total - off;
+}
+
+static D3DKMT_HANDLE kmt_new_handle(void)
+{
+    return __atomic_add_fetch( &kmt_next_handle, 1, __ATOMIC_SEQ_CST );
+}
+
+/* d3dkmt_lock must be held */
+static BOOL kmt_device_exists( D3DKMT_HANDLE handle )
+{
+    struct d3dkmt_device *device;
+    if (!handle) return FALSE;
+    LIST_FOR_EACH_ENTRY( device, &d3dkmt_devices, struct d3dkmt_device, entry )
+        if (device->handle == handle) return TRUE;
+    return FALSE;
+}
+
+/* d3dkmt_lock must be held */
+static struct kmt_object *kmt_find( D3DKMT_HANDLE handle, enum kmt_type type )
+{
+    struct kmt_object *object;
+    if (!handle) return NULL;
+    LIST_FOR_EACH_ENTRY( object, &kmt_objects, struct kmt_object, entry )
+        if (object->handle == handle && object->type == type) return object;
+    return NULL;
+}
+
+static void kmt_block_unref( struct kmt_block *block )
+{
+    UINT i;
+
+    if (--block->ref) return;
+    NtUnmapViewOfSection( NtCurrentProcess(), block->hdr );
+    NtClose( block->section );
+    for (i = 0; i < block->old_count; i++)
+    {
+        NtUnmapViewOfSection( NtCurrentProcess(), block->old[i].hdr );
+        NtClose( block->old[i].section );
+    }
+    free( block );
+}
+
+/* d3dkmt_lock must be held */
+static void kmt_object_free( struct kmt_object *object )
+{
+    list_remove( &object->entry );
+    kmt_block_unref( object->block );
+    free( object );
+}
+
+/* d3dkmt_lock must be held */
+static void kmt_free_device_objects( D3DKMT_HANDLE device )
+{
+    struct kmt_object *object, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( object, next, &kmt_objects, struct kmt_object, entry )
+        if (object->device == device) kmt_object_free( object );
+}
+
+/* The name of a global object: in the session's namespace, so every process of the session sees it. */
+static void kmt_object_name( const char *prefix, UINT id, UNICODE_STRING *name, WCHAR *buffer )
+{
+    char text[128];
+    unsigned int i;
+
+    snprintf( text, sizeof(text), "\\Sessions\\%u\\BaseNamedObjects\\%s%08x",
+              (unsigned int)NtCurrentTeb()->Peb->SessionId, prefix, id );
+    for (i = 0; text[i]; i++) buffer[i] = (unsigned char)text[i];
+    buffer[i] = 0;
+    name->Buffer = buffer;
+    name->Length = i * sizeof(WCHAR);
+    name->MaximumLength = (i + 1) * sizeof(WCHAR);
+}
+
+/* d3dkmt_lock must be held. The numbers of global share handles, shared by every process of the session. */
+static UINT kmt_next_global_id(void)
+{
+    if (!kmt_counter)
+    {
+        OBJECT_ATTRIBUTES attr;
+        UNICODE_STRING name;
+        WCHAR buffer[128];
+        LARGE_INTEGER size;
+        SIZE_T view = 0;
+        HANDLE section;
+        void *base = NULL;
+
+        kmt_object_name( "SGKMT_counter", 0, &name, buffer );
+        InitializeObjectAttributes( &attr, &name, OBJ_OPENIF, 0, NULL );
+        size.QuadPart = 0x1000;
+        if (NtCreateSection( &section, SECTION_ALL_ACCESS, &attr, &size, PAGE_READWRITE, SEC_COMMIT, 0 )) return 0;
+        if (NtMapViewOfSection( section, NtCurrentProcess(), &base, 0, 0, NULL, &view, ViewShare, 0, PAGE_READWRITE ))
+        {
+            NtClose( section );
+            return 0;
+        }
+        kmt_counter = base;   /* the section handle stays open: the counter lives as long as any process has it */
+    }
+    return 0x40000000 | ((UINT)__atomic_add_fetch( kmt_counter, 1, __ATOMIC_SEQ_CST ) << 2);
+}
+
+/* A new section of a size, mapped. attr names it, or is NULL. */
+static NTSTATUS kmt_section_create( SIZE_T total, OBJECT_ATTRIBUTES *attr, HANDLE *section,
+                                    struct kmt_share_header **hdr )
+{
+    LARGE_INTEGER size;
+    SIZE_T view = 0;
+    void *base = NULL;
+    NTSTATUS status;
+
+    size.QuadPart = total;
+    if ((status = NtCreateSection( section, SECTION_ALL_ACCESS, attr, &size, PAGE_READWRITE, SEC_COMMIT, 0 )))
+        return status;
+    if ((status = NtMapViewOfSection( *section, NtCurrentProcess(), &base, 0, 0, NULL, &view, ViewShare, 0,
+                                      PAGE_READWRITE )))
+    {
+        NtClose( *section );
+        return status;
+    }
+    *hdr = base;
+    return STATUS_SUCCESS;
+}
+
+/* Moves a block to a section that has the name of attr, which is the NT name of a shared object.
+ * d3dkmt_lock must be held. */
+static NTSTATUS kmt_block_rebind( struct kmt_block *block, OBJECT_ATTRIBUTES *attr )
+{
+    struct kmt_share_header *hdr;
+    HANDLE section;
+    NTSTATUS status;
+
+    if (block->old_count == KMT_MAX_OLD_VIEWS) return STATUS_NOT_SUPPORTED;
+    if ((status = kmt_section_create( block->size, attr, &section, &hdr ))) return status;
+    memcpy( hdr, block->hdr, block->size );
+    block->old[block->old_count].hdr = block->hdr;
+    block->old[block->old_count++].section = block->section;
+    block->hdr = hdr;
+    block->section = section;
+    return STATUS_SUCCESS;
+}
+
+/* The block of a section, from an NT handle or a global name. d3dkmt_lock need not be held. */
+static NTSTATUS kmt_block_open( HANDLE section, struct kmt_block **ret )
+{
+    struct kmt_share_header *hdr;
+    struct kmt_share_alloc *allocs;
+    struct kmt_block *block;
+    SIZE_T view = 0;
+    void *base = NULL;
+    HANDLE copy;
+    NTSTATUS status;
+    UINT i;
+
+    if ((status = NtMapViewOfSection( section, NtCurrentProcess(), &base, 0, 0, NULL, &view, ViewShare, 0,
+                                      PAGE_READWRITE )))
+        return status;
+    hdr = base;
+    if (view < sizeof(*hdr) || hdr->magic != KMT_SHARE_MAGIC || hdr->version != KMT_SHARE_VERSION
+        || hdr->total_size < sizeof(*hdr) || hdr->total_size > view)
+        goto invalid;
+    if (hdr->flags & KMT_SHARE_RESOURCE)
+    {
+        if (hdr->alloc_count > KMT_MAX_ALLOCS
+            || !kmt_in_range( hdr->runtime_off, hdr->runtime_size, hdr->total_size )
+            || !kmt_in_range( hdr->driver_off, hdr->driver_size, hdr->total_size )
+            || !kmt_in_range( hdr->alloc_off, (UINT64)hdr->alloc_count * sizeof(*allocs), hdr->total_size ))
+            goto invalid;
+        allocs = (struct kmt_share_alloc *)((char *)hdr + hdr->alloc_off);
+        for (i = 0; i < hdr->alloc_count; i++)
+            if (!kmt_in_range( allocs[i].private_off, allocs[i].private_size, hdr->total_size )
+                || !kmt_in_range( allocs[i].content_off, allocs[i].content_size, hdr->total_size ))
+                goto invalid;
+    }
+    if ((hdr->flags & KMT_SHARE_MUTEX) && hdr->mutex_runtime_size > KMT_MUTEX_RUNTIME_MAX) goto invalid;
+
+    if (NtDuplicateObject( NtCurrentProcess(), section, NtCurrentProcess(), &copy, 0, 0, DUPLICATE_SAME_ACCESS ))
+        goto invalid;
+    if (!(block = calloc( 1, sizeof(*block) )))
+    {
+        NtClose( copy );
+        NtUnmapViewOfSection( NtCurrentProcess(), base );
+        return STATUS_NO_MEMORY;
+    }
+    block->ref = 1;
+    block->hdr = hdr;
+    block->size = hdr->total_size;
+    block->section = copy;
+    *ret = block;
+    return STATUS_SUCCESS;
+
+invalid:
+    NtUnmapViewOfSection( NtCurrentProcess(), base );
+    return STATUS_INVALID_PARAMETER;
+}
+
+static NTSTATUS kmt_block_open_global( UINT id, struct kmt_block **ret )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    WCHAR buffer[128];
+    HANDLE section;
+    NTSTATUS status;
+
+    if (!id) return STATUS_INVALID_PARAMETER;
+    kmt_object_name( "SGKMT_", id, &name, buffer );
+    InitializeObjectAttributes( &attr, &name, 0, 0, NULL );
+    if ((status = NtOpenSection( &section, SECTION_ALL_ACCESS, &attr ))) return STATUS_INVALID_PARAMETER;
+    status = kmt_block_open( section, ret );
+    NtClose( section );
+    return status;
+}
+
+/* A block for a resource, or for an allocation that has no resource. */
+static NTSTATUS kmt_block_create( UINT flags, const void *runtime, UINT runtime_size, const void *driver,
+                                  UINT driver_size, UINT count, const void *const *alloc_data,
+                                  const UINT *alloc_data_size, UINT *global, struct kmt_block **ret )
+{
+    struct kmt_share_header *hdr;
+    struct kmt_share_alloc *allocs;
+    struct kmt_block *block;
+    UINT64 off, total, content;
+    NTSTATUS status;
+    UINT i;
+
+    if (runtime_size > KMT_MAX_PRIVATE || driver_size > KMT_MAX_PRIVATE || count > KMT_MAX_ALLOCS)
+        return STATUS_INVALID_PARAMETER;
+
+    off = kmt_align( sizeof(*hdr), 64 );
+    total = off + kmt_align( runtime_size, 8 ) + kmt_align( driver_size, 8 ) + count * sizeof(*allocs);
+    for (i = 0; i < count; i++)
+    {
+        content = 0;
+        if (alloc_data_size[i] > KMT_MAX_PRIVATE) return STATUS_INVALID_PARAMETER;
+        if (alloc_data_size[i] >= sizeof(struct wine_kmt_alloc_data))
+            content = ((const struct wine_kmt_alloc_data *)alloc_data[i])->size;
+        if (content > KMT_MAX_CONTENT) return STATUS_INVALID_PARAMETER;
+        total += kmt_align( alloc_data_size[i], 8 );
+    }
+    total = kmt_align( total, 64 );
+    for (i = 0; i < count; i++)
+    {
+        content = 0;
+        if (alloc_data_size[i] >= sizeof(struct wine_kmt_alloc_data))
+            content = ((const struct wine_kmt_alloc_data *)alloc_data[i])->size;
+        total += kmt_align( content, 64 );
+        if (total > KMT_MAX_CONTENT) return STATUS_INVALID_PARAMETER;
+    }
+
+    if (!(block = calloc( 1, sizeof(*block) ))) return STATUS_NO_MEMORY;
+    if (global)
+    {
+        /* a global share handle names the section */
+        OBJECT_ATTRIBUTES attr;
+        UNICODE_STRING name;
+        WCHAR buffer[128];
+        int tries;
+
+        for (tries = 0, status = STATUS_NO_MEMORY; tries < 8 && status; tries++)
+        {
+            if (!(*global = kmt_next_global_id())) break;
+            kmt_object_name( "SGKMT_", *global, &name, buffer );
+            InitializeObjectAttributes( &attr, &name, 0, 0, NULL );
+#ifdef SG_MUTANT_KMT_GLOBAL_NONAME
+            status = kmt_section_create( total, NULL, &block->section, &hdr );
+#else
+            status = kmt_section_create( total, &attr, &block->section, &hdr );
+#endif
+        }
+    }
+    else status = kmt_section_create( total, NULL, &block->section, &hdr );
+    if (status)
+    {
+        free( block );
+        return status;
+    }
+    if (global) hdr->global_id = *global;
+    block->ref = 1;
+    block->hdr = hdr;
+    block->size = total;
+
+    hdr->magic = KMT_SHARE_MAGIC;
+    hdr->version = KMT_SHARE_VERSION;
+    hdr->flags = flags;
+    hdr->total_size = total;
+
+    off = kmt_align( sizeof(*hdr), 64 );
+    hdr->runtime_size = runtime_size;
+    hdr->runtime_off = off;
+    if (runtime_size) memcpy( (char *)hdr + off, runtime, runtime_size );
+    off += kmt_align( runtime_size, 8 );
+    hdr->driver_size = driver_size;
+    hdr->driver_off = off;
+    if (driver_size) memcpy( (char *)hdr + off, driver, driver_size );
+    off += kmt_align( driver_size, 8 );
+    hdr->alloc_count = count;
+    hdr->alloc_off = off;
+    allocs = (struct kmt_share_alloc *)((char *)hdr + off);
+    off += count * sizeof(*allocs);
+    for (i = 0; i < count; i++)
+    {
+        allocs[i].private_size = alloc_data_size[i];
+        allocs[i].private_off = off;
+        if (alloc_data_size[i]) memcpy( (char *)hdr + off, alloc_data[i], alloc_data_size[i] );
+        off += kmt_align( alloc_data_size[i], 8 );
+    }
+    off = kmt_align( off, 64 );
+    for (i = 0; i < count; i++)
+    {
+        content = 0;
+        if (alloc_data_size[i] >= sizeof(struct wine_kmt_alloc_data))
+            content = ((const struct wine_kmt_alloc_data *)alloc_data[i])->size;
+#ifdef SG_MUTANT_KMT_ALLOC_NOSIZE
+        content = 0;
+#endif
+        allocs[i].content_size = content;
+        allocs[i].content_off = off;
+        off += kmt_align( content, 64 );
+    }
+    *ret = block;
+    return STATUS_SUCCESS;
+}
+
+/* The objects of a block: the resource and its allocations. d3dkmt_lock must be held, the block's
+ * reference is the caller's and stays with it. */
+static NTSTATUS kmt_objects_create( D3DKMT_HANDLE device, struct kmt_block *block, BOOL nt_sharing,
+                                    struct kmt_object **res, struct kmt_object **allocs_out )
+{
+    struct kmt_object *resource, *alloc;
+    UINT i;
+
+    if (!(resource = calloc( 1, sizeof(*resource) ))) return STATUS_NO_MEMORY;
+    resource->handle = kmt_new_handle();
+    resource->device = device;
+    resource->type = KMT_RESOURCE;
+    resource->block = block;
+    block->ref++;
+    resource->nt_sharing = nt_sharing;
+    list_add_tail( &kmt_objects, &resource->entry );
+
+    for (i = 0; i < block->hdr->alloc_count; i++)
+    {
+        if (!(alloc = calloc( 1, sizeof(*alloc) )))
+        {
+            kmt_object_free( resource );
+            return STATUS_NO_MEMORY;
+        }
+        alloc->handle = kmt_new_handle();
+        alloc->device = device;
+        alloc->type = KMT_ALLOCATION;
+        alloc->block = block;
+        block->ref++;
+        alloc->resource = resource->handle;
+        alloc->index = i;
+        list_add_tail( &kmt_objects, &alloc->entry );
+        allocs_out[i] = alloc;
+    }
+    *res = resource;
+    return STATUS_SUCCESS;
+}
+
+/* d3dkmt_lock must be held. Removes a resource with its allocations. */
+static void kmt_resource_free( struct kmt_object *resource )
+{
+    struct kmt_object *object, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( object, next, &kmt_objects, struct kmt_object, entry )
+        if (object->type == KMT_ALLOCATION && object->resource == resource->handle) kmt_object_free( object );
+    kmt_object_free( resource );
+}
+
+static NTSTATUS kmt_create_allocation( D3DKMT_CREATEALLOCATION *params, BOOL info2 )
+{
+    D3DKMT_CREATEALLOCATIONFLAGS flags;
+    const void *alloc_data[KMT_MAX_ALLOCS];
+    UINT alloc_size[KMT_MAX_ALLOCS];
+    struct kmt_object *resource = NULL, *objects[KMT_MAX_ALLOCS];
+    struct kmt_block *block;
+    NTSTATUS status;
+    UINT i, global_id = 0;
+
+    if (!params || !params->NumAllocations || params->NumAllocations > KMT_MAX_ALLOCS
+        || !params->pAllocationInfo)
+        return STATUS_INVALID_PARAMETER;
+    flags = params->Flags;
+    if (flags.StandardAllocation || flags.ExistingSysMem || flags.ExistingSection || flags.CrossAdapter
+        || flags.OpenCrossAdapter || flags.PartialSharedCreation)
+    {
+        FIXME( "flags %#x not supported\n", (unsigned int)*(UINT *)&flags );
+        return STATUS_NOT_SUPPORTED;
+    }
+    if ((flags.CreateShared && !flags.CreateResource) || (flags.NtSecuritySharing && !flags.CreateShared))
+        return STATUS_INVALID_PARAMETER;
+    if (!flags.CreateResource && params->hResource) return STATUS_NOT_SUPPORTED;
+    if ((params->PrivateRuntimeDataSize && !params->pPrivateRuntimeData)
+        || (params->PrivateDriverDataSize && !params->pPrivateDriverData))
+        return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < params->NumAllocations; i++)
+    {
+        if (info2)
+        {
