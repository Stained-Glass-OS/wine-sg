+/* D3DKMTEscape of the runtime: a section handle for the content of an allocation. */
+static NTSTATUS kmt_escape( struct wine_kmt_escape *escape )
+{
+    struct kmt_object *object;
+    struct kmt_share_alloc *alloc;
+    struct kmt_block *block;
+    NTSTATUS status;
+    HANDLE section;
+    UINT index = 0;
+
+    if (escape->command != WINE_KMT_ESCAPE_MAP_ALLOCATION) return STATUS_NOT_SUPPORTED;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if ((object = kmt_find( escape->handle, KMT_ALLOCATION ))) index = object->index;
+    else if (!(object = kmt_find( escape->handle, KMT_RESOURCE ))) object = NULL;
+    if (!object || index >= object->block->hdr->alloc_count)
+    {
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return STATUS_INVALID_PARAMETER;
+    }
+    block = object->block;
+    status = NtDuplicateObject( NtCurrentProcess(), block->section, NtCurrentProcess(), &section, 0, 0,
+                                    DUPLICATE_SAME_ACCESS );
+    if (!status)
+    {
+        alloc = (struct kmt_share_alloc *)((char *)block->hdr + block->hdr->alloc_off) + index;
+        escape->section = (UINT64)(ULONG_PTR)section;
+        escape->offset = alloc->content_off;
+        escape->size = alloc->content_size;
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
 
