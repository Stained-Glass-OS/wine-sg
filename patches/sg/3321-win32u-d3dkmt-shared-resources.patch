@@ -188,6 +192,12 @@ NTSTATUS WINAPI NtGdiDdDDIEscape( const D3DKMT_ESCAPE *desc )
 #endif
     if (!known) return STATUS_INVALID_PARAMETER;
 
+    /* the private escapes of the runtime, see wine/kmtshare.h */
