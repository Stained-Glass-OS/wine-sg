+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_KMTSHARE_H
+#define __WINE_KMTSHARE_H
+
+#define WINE_KMT_ESCAPE_MAGIC 0x53474b4d
+
+enum wine_kmt_escape_command
+{
+    WINE_KMT_ESCAPE_MAP_ALLOCATION = 1,
+};
+
+struct wine_kmt_alloc_data
+{
+    UINT64 size;                /* bytes of content */
+};
+
+struct wine_kmt_escape
+{
+    UINT magic;                 /* WINE_KMT_ESCAPE_MAGIC */
+    UINT command;               /* enum wine_kmt_escape_command */
+    D3DKMT_HANDLE handle;       /* an allocation, or a resource (its first allocation) */
+    UINT reserved;
+    UINT64 section;             /* out: a section handle of the calling process, NtClose it when done */
+    UINT64 offset;              /* out: offset of the content in the section */
+    UINT64 size;                /* out: bytes of content */
+};
+
+#endif /* __WINE_KMTSHARE_H */
