From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: interrupt and DPC time in SystemProcessorPerformanceInformation

SystemProcessorPerformanceInformation left each processor's interrupt and
DPC time at zero.  They now come from the kernel's irq and softirq counters
in /proc/stat (the same lines that already give idle, kernel and user time).

---
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -3282,7 +3282,7 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
             if (cpuinfo)
             {
                 unsigned long clk_tck = sysconf(_SC_CLK_TCK);
-                unsigned long usr,nice,sys,idle,remainder[8];
+                unsigned long usr,nice,sys,idle,remainder[8], irq, softirq;
                 int i, count, id;
                 char name[32];
                 char line[255];
@@ -3296,6 +3296,8 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
                                    &remainder[4], &remainder[5], &remainder[6], &remainder[7]);
 
                     if (count < 5 || strncmp( name, "cpu", 3 )) break;
+                    irq = count > 6 ? remainder[1] : 0;        /* hardware interrupts */
+                    softirq = count > 7 ? remainder[2] : 0;    /* deferred procedure calls */
                     for (i = 0; i + 5 < count; ++i) sys += remainder[i];
                     sys += idle;
                     usr += nice;
@@ -3305,6 +3307,11 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
                     sppi[id-1].IdleTime.QuadPart   = (ULONGLONG)idle * 10000000 / clk_tck;
                     sppi[id-1].KernelTime.QuadPart = (ULONGLONG)sys * 10000000 / clk_tck;
                     sppi[id-1].UserTime.QuadPart   = (ULONGLONG)usr * 10000000 / clk_tck;
+/* Reserved1[] is DpcTime and InterruptTime */
+#ifndef SG_MUTANT_NO_SPPI_IRQ
+                    sppi[id-1].Reserved1[1].QuadPart = (ULONGLONG)irq * 10000000 / clk_tck;
+                    sppi[id-1].Reserved1[0].QuadPart = (ULONGLONG)softirq * 10000000 / clk_tck;
+#endif
                 }
                 fclose(cpuinfo);
             }
