From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: the generic ECDH provider, its curve by name or by key size

BCryptOpenAlgorithmProvider(ECDH) was not supported (LibreOffice's xmlsec CNG back end asks for it). The provider
takes its curve from the ECCCurveName property (nistP256/secP256r1, nistP384/secP384r1) or, without one, from the
key size; a key pair it generates or imports is that curve's (BCRYPT_ECDH_PUBLIC/PRIVATE_GENERIC_MAGIC blobs are
read as the curve their size says), so it agrees with the ECDH_P256/ECDH_P384 providers' keys.
---
diff --git a/dlls/bcrypt/bcrypt_internal.h b/dlls/bcrypt/bcrypt_internal.h
index 83ecfd2..04f51d1 100644
--- a/dlls/bcrypt/bcrypt_internal.h
+++ b/dlls/bcrypt/bcrypt_internal.h
@@ -163,6 +163,9 @@ enum alg_id
     ALG_ID_HKDF,
     ALG_ID_SP80056A_CONCAT,
     ALG_ID_SP800108_CTR_HMAC,
+
+    /* secret agreement on a curve named by a property */
+    ALG_ID_ECDH,
 };
 
 enum chain_mode
@@ -180,6 +183,7 @@ struct algorithm
     enum alg_id     id;
     enum chain_mode mode;
     unsigned        flags;
+    enum alg_id     curve;   /* ECDH: the named curve's algorithm, or ALG_ID_ECDH while none is set */
 };
 
 struct key_symmetric
diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 911486f..1d4fe7d 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -85,6 +85,7 @@ builtin_algorithms[] =
     {  BCRYPT_HKDF_ALGORITHM,       BCRYPT_KEY_DERIVATION_INTERFACE,        0,      0,    0 },
     {  BCRYPT_SP80056A_CONCAT_ALGORITHM, BCRYPT_KEY_DERIVATION_INTERFACE,   0,      0,    0 },
     {  BCRYPT_SP800108_CTR_HMAC_ALGORITHM, BCRYPT_KEY_DERIVATION_INTERFACE, 0,      0,    0 },
+    {  BCRYPT_ECDH_ALGORITHM,       BCRYPT_SECRET_AGREEMENT_INTERFACE,      0,      0,    0 },
 };
 
 static inline BOOL is_kdf_alg( enum alg_id id )
@@ -208,7 +209,7 @@ static const struct algorithm pseudo_algorithms[] =
     {{ 0 }}, /* RC2_ECB */
     {{ 0 }}, /* RC2_CFB */
     {{ MAGIC_ALG }, ALG_ID_DH },
-    {{ 0 }}, /* ECDH */
+    {{ MAGIC_ALG }, ALG_ID_ECDH, 0, 0, ALG_ID_ECDH },
     {{ MAGIC_ALG }, ALG_ID_ECDH_P256 },
     {{ MAGIC_ALG }, ALG_ID_ECDH_P384 },
     {{ 0 }}, /* ECDH_P512 */
@@ -330,6 +331,7 @@ static struct algorithm *create_algorithm( enum alg_id id, enum chain_mode mode,
     ret->id        = id;
     ret->mode      = mode;
     ret->flags     = flags;
+    ret->curve     = ALG_ID_ECDH;
     return ret;
 }
 
@@ -834,10 +836,47 @@ static NTSTATUS get_alg_property( const struct algorithm *alg, const WCHAR *prop
     return STATUS_NOT_IMPLEMENTED;
 }
 
+/* ECDH's curve, by its names */
+static enum alg_id ecdh_curve_from_name( const WCHAR *name )
+{
+    if (!wcsicmp( name, BCRYPT_ECC_CURVE_NISTP256 ) || !wcsicmp( name, BCRYPT_ECC_CURVE_SECP256R1 ))
+        return ALG_ID_ECDH_P256;
+    if (!wcsicmp( name, BCRYPT_ECC_CURVE_NISTP384 ) || !wcsicmp( name, BCRYPT_ECC_CURVE_SECP384R1 ))
+        return ALG_ID_ECDH_P384;
+    return ALG_ID_ECDH;
+}
+
+/* the concrete curve for a generic ECDH provider: the named one, else by key size */
+static NTSTATUS ecdh_concrete( const struct algorithm *alg, ULONG bits, struct algorithm *out )
+{
+    *out = *alg;
+    if (alg->curve != ALG_ID_ECDH) out->id = alg->curve;
+    else if (bits == 256) out->id = ALG_ID_ECDH_P256;
+    else if (bits == 384) out->id = ALG_ID_ECDH_P384;
+    else return STATUS_INVALID_PARAMETER;
+    if (bits && bits != (out->id == ALG_ID_ECDH_P256 ? 256u : 384u)) return STATUS_INVALID_PARAMETER;
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS set_alg_property( struct algorithm *alg, const WCHAR *prop, UCHAR *value, ULONG size, ULONG flags )
 {
     switch (alg->id)
     {
+    case ALG_ID_ECDH:
+        if (!wcscmp( prop, BCRYPT_ECC_CURVE_NAME ))
+        {
+            enum alg_id curve;
+            if (!value || size < sizeof(WCHAR)) return STATUS_INVALID_PARAMETER;
+#ifndef SG_MUTANT_ECDH_CURVE_IGNORED
+            if ((curve = ecdh_curve_from_name( (const WCHAR *)value )) == ALG_ID_ECDH) return STATUS_NOT_SUPPORTED;
+            alg->curve = curve;
+#else
+            (void)curve;
+#endif
+            return STATUS_SUCCESS;
+        }
+        return STATUS_NOT_SUPPORTED;
+
     case ALG_ID_3DES:
         if (!wcscmp( prop, BCRYPT_CHAINING_MODE ))
         {
@@ -2422,6 +2461,15 @@ NTSTATUS WINAPI BCryptGenerateKeyPair( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY_HAND
     if (!alg) return STATUS_INVALID_HANDLE;
     if (!ret_handle) return STATUS_INVALID_PARAMETER;
 
+    if (alg->id == ALG_ID_ECDH)
+    {
+        struct algorithm concrete;
+        if ((status = ecdh_concrete( alg, key_len, &concrete ))) return status;
+        if ((status = key_asymmetric_create( concrete.id, concrete.id == ALG_ID_ECDH_P256 ? 256 : 384, &key )))
+            return status;
+        *ret_handle = key;
+        return STATUS_SUCCESS;
+    }
     if ((status = key_asymmetric_create( alg->id, key_len, &key ))) return status;
     *ret_handle = key;
     TRACE( "returning handle %p\n", *ret_handle );
@@ -2732,6 +2780,29 @@ NTSTATUS WINAPI BCryptImportKeyPair( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY_HANDLE
 #endif
     if (decrypt_key_handle) TRACE( "ignoring import key %p\n", decrypt_key_handle );
 
+    if (alg->id == ALG_ID_ECDH)
+    {
+        /* the blob says which curve: its size, and a generic or a curve's magic */
+        BCRYPT_ECCKEY_BLOB *blob = (BCRYPT_ECCKEY_BLOB *)input;
+        struct algorithm concrete;
+        UCHAR *copy;
+        BOOL priv;
+
+        if (input_len < sizeof(*blob) || (blob->cbKey != 32 && blob->cbKey != 48)) return STATUS_INVALID_PARAMETER;
+        if ((status = ecdh_concrete( alg, blob->cbKey * 8, &concrete ))) return status;
+        priv = !wcscmp( type, BCRYPT_ECCPRIVATE_BLOB );
+        if (!(copy = malloc( input_len ))) return STATUS_NO_MEMORY;
+        memcpy( copy, input, input_len );
+        blob = (BCRYPT_ECCKEY_BLOB *)copy;
+        if (blob->dwMagic == (priv ? BCRYPT_ECDH_PRIVATE_GENERIC_MAGIC : BCRYPT_ECDH_PUBLIC_GENERIC_MAGIC))
+            blob->dwMagic = concrete.id == ALG_ID_ECDH_P256
+                ? (priv ? BCRYPT_ECDH_PRIVATE_P256_MAGIC : BCRYPT_ECDH_PUBLIC_P256_MAGIC)
+                : (priv ? BCRYPT_ECDH_PRIVATE_P384_MAGIC : BCRYPT_ECDH_PUBLIC_P384_MAGIC);
+        status = key_import_pair( &concrete, type, ret_handle, copy, input_len );
+        SecureZeroMemory( copy, input_len );
+        free( copy );
+        return status;
+    }
     if ((status = key_import_pair( alg, type, ret_handle, input, input_len ))) return status;
     TRACE( "returning handle %p\n", *ret_handle );
     return STATUS_SUCCESS;
diff --git a/include/bcrypt.h b/include/bcrypt.h
index 43e7f00..f82425b 100644
--- a/include/bcrypt.h
+++ b/include/bcrypt.h
@@ -113,6 +113,12 @@ typedef LONG NTSTATUS;
 #define BCRYPT_SHA3_512_ALGORITHM   L"SHA3-512"
 #define BCRYPT_PBKDF2_ALGORITHM     L"PBKDF2"
 #define BCRYPT_HKDF_ALGORITHM       L"HKDF"
+#define BCRYPT_ECDH_ALGORITHM       L"ECDH"
+#define BCRYPT_ECC_CURVE_NAME       L"ECCCurveName"
+#define BCRYPT_ECC_CURVE_NISTP256   L"nistP256"
+#define BCRYPT_ECC_CURVE_NISTP384   L"nistP384"
+#define BCRYPT_ECC_CURVE_SECP256R1  L"secP256r1"
+#define BCRYPT_ECC_CURVE_SECP384R1  L"secP384r1"
 #define BCRYPT_SP80056A_CONCAT_ALGORITHM L"SP800_56A_CONCAT"
 
 #define BCRYPT_CHAIN_MODE_NA        L"ChainingModeN/A"
@@ -206,6 +212,12 @@ static const WCHAR BCRYPT_SHA3_384_ALGORITHM[] = {'S','H','A','3','-','3','8','4
 static const WCHAR BCRYPT_SHA3_512_ALGORITHM[] = {'S','H','A','3','-','5','1','2',0};
 static const WCHAR BCRYPT_PBKDF2_ALGORITHM[] = {'P','B','K','D','F','2',0};
 static const WCHAR BCRYPT_HKDF_ALGORITHM[] = {'H','K','D','F',0};
+static const WCHAR BCRYPT_ECDH_ALGORITHM[] = {'E','C','D','H',0};
+static const WCHAR BCRYPT_ECC_CURVE_NAME[] = {'E','C','C','C','u','r','v','e','N','a','m','e',0};
+static const WCHAR BCRYPT_ECC_CURVE_NISTP256[] = {'n','i','s','t','P','2','5','6',0};
+static const WCHAR BCRYPT_ECC_CURVE_NISTP384[] = {'n','i','s','t','P','3','8','4',0};
+static const WCHAR BCRYPT_ECC_CURVE_SECP256R1[] = {'s','e','c','P','2','5','6','r','1',0};
+static const WCHAR BCRYPT_ECC_CURVE_SECP384R1[] = {'s','e','c','P','3','8','4','r','1',0};
 static const WCHAR BCRYPT_SP80056A_CONCAT_ALGORITHM[] = {'S','P','8','0','0','_','5','6','A','_','C','O','N','C','A','T',0};
 
 static const WCHAR BCRYPT_CHAIN_MODE_NA[] = {'C','h','a','i','n','i','n','g','M','o','d','e','N','/','A',0};
@@ -300,6 +312,9 @@ typedef struct _BCRYPT_KEY_BLOB
     ULONG Magic;
 } BCRYPT_KEY_BLOB;
 
+#define BCRYPT_ECDH_PUBLIC_GENERIC_MAGIC  0x504b4345
+#define BCRYPT_ECDH_PRIVATE_GENERIC_MAGIC 0x564b4345
+
 typedef struct _BCRYPT_ECCKEY_BLOB
 {
     ULONG dwMagic;
