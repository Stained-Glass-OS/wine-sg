From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Answer FileCompressionInformation.

NtQueryInformationFile answers FileCompressionInformation: files on Unix
file systems are not compressed (COMPRESSION_FORMAT_NONE), and the
compressed size is the size, as GetCompressedFileSize already says.
GetFileInformationByHandleEx(FileCompressionInfo) failed with
STATUS_NOT_IMPLEMENTED from the server.

Gate: test/ntdll-compressioninfo-gate.sh (64/32).
---
 dlls/ntdll/unix/file.c | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index b3bb97d..37fc32a 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4933,6 +4933,17 @@ NTSTATUS WINAPI NtQueryAttributesFile( const OBJECT_ATTRIBUTES *attr, FILE_BASIC
 }
 
 
+/* FILE_COMPRESSION_INFORMATION (ntifs.h) */
+typedef struct
+{
+    LARGE_INTEGER CompressedFileSize;
+    USHORT CompressionFormat;
+    UCHAR CompressionUnitShift;
+    UCHAR ChunkShift;
+    UCHAR ClusterShift;
+    UCHAR Reserved[3];
+} FILE_COMPRESSION_INFORMATION;
+
 /******************************************************************************
  *              NtQueryInformationFile   (NTDLL.@)
  */
@@ -4969,7 +4980,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         0,                                             /* FilePipeRemoteInformation */
         sizeof(FILE_MAILSLOT_QUERY_INFORMATION),       /* FileMailslotQueryInformation */
         0,                                             /* FileMailslotSetInformation */
-        0,                                             /* FileCompressionInformation */
+        sizeof(FILE_COMPRESSION_INFORMATION),          /* FileCompressionInformation */
         0,                                             /* FileObjectIdInformation */
         0,                                             /* FileCompletionInformation */
         0,                                             /* FileMoveClusterInformation */
@@ -5162,6 +5173,22 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         ((FILE_ALIGNMENT_INFORMATION *)ptr)->AlignmentRequirement = FILE_BYTE_ALIGNMENT;
 #else
         status = STATUS_NOT_IMPLEMENTED;
+#endif
+        break;
+    case FileCompressionInformation:
+        /* Unix files are not compressed (COMPRESSION_FORMAT_NONE): the
+         * compressed size is the size, as GetCompressedFileSize says */
+#ifndef SG_MUTANT_COMPRESSION_NOTIMPL
+        if (fd_get_file_info_h( handle, fd, options, &st, &attr ) == -1) status = errno_to_status( errno );
+        else
+        {
+            FILE_COMPRESSION_INFORMATION *info = ptr;
+
+            memset( info, 0, sizeof(*info) );
+            info->CompressedFileSize.QuadPart = S_ISDIR(st.st_mode) ? 0 : st.st_size;
+        }
+#else
+        status = STATUS_NOT_IMPLEMENTED;
 #endif
         break;
     case FileIdInformation:
