From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: Linux windows on the taskbar show their apps' icons

A Linux program's taskbar button had a blank icon unless it was a terminal.
Start's Linux apps (sg-shell's sg-linuxapp) put each app's .ico under its
window class's names in %LOCALAPPDATA%\Stained Glass\Linux app icons; a
window of that class takes it.
---
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -1470,6 +1470,24 @@
         ExtractIconExW( L"Z:\\usr\\libexec\\stained-glass\\shell\\sg-rootterm64.exe", 0, NULL, &icon, 1 );
     else if (!wcsicmp( class, L"XTerm" ) || wcsstr( class, L"erminal" ))
         ExtractIconExW( L"C:\\windows\\system32\\cmd.exe", 0, NULL, &icon, 1 );
+    else
+    {
+        /* a Linux app's own icon: SG's Linux apps in Start (sg-linuxapp) put
+         * its .ico under the window class's names too (StartupWMClass, and
+         * the program's name -- GTK's default class) */
+        WCHAR path[MAX_PATH];
+        if (!wcspbrk( class, L"\\/:*?\"<>|" ) &&
+            GetEnvironmentVariableW( L"LOCALAPPDATA", path, MAX_PATH ) &&
+            wcslen( path ) + wcslen( class ) + 40 < MAX_PATH)
+        {
+            wcscat( path, L"\\Stained Glass\\Linux app icons\\" );
+            wcscat( path, class );
+            wcscat( path, L".ico" );
+            if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES)
+                icon = LoadImageW( NULL, path, IMAGE_ICON, GetSystemMetrics( SM_CXSMICON ),
+                                   GetSystemMetrics( SM_CYSMICON ), LR_LOADFROMFILE );
+        }
+    }
     return icon;
 }
 
