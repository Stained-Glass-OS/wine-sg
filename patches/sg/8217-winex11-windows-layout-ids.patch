From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, wine.inf: Windows' own Layout Ids for the layout-id keyboard layouts

8212 gave eleven KLIDs Layout Ids of its own (0e01-0e0b), so their HKLs differed from Windows'. They now carry Windows' values (from the public keyboard layout data: 00030409 001a, 00040409 001b, 00011009 0020, 00010405 0005, 0001041b 0013, 00010415 0007, 00010419 0008, 00020419 0033, 0001041f 0014, 0001041e 0021). 00010c0c does not exist on Windows: Canadian French (Legacy) is 00000c0c and Canadian French 00001009, both language HKLs, now built from ca(fr-legacy) and ca; the wrong key is deleted from updated prefixes.
---
--- a/dlls/winex11.drv/xkbtables.c
+++ b/dlls/winex11.drv/xkbtables.c
@@ -66,8 +66,8 @@
 } xkb_names[] =
 {
     { 0x0409, "us" },     { 0x0809, "gb" },     { 0x1809, "ie" },     { 0x0c09, "us" },
-    { 0x1009, "us" },     { 0x1409, "us" },     { 0x040c, "fr" },     { 0x080c, "be" },
-    { 0x0c0c, "ca" },     { 0x100c, "ch", "fr" }, { 0x140c, "fr" },   { 0x0407, "de" },
+    { 0x1009, "ca" },     { 0x1409, "us" },     { 0x040c, "fr" },     { 0x080c, "be" },
+    { 0x0c0c, "ca", "fr-legacy" }, { 0x100c, "ch", "fr" }, { 0x140c, "fr" },   { 0x0407, "de" },
     { 0x0807, "ch" },     { 0x0c07, "at" },     { 0x1007, "de" },     { 0x1407, "de" },
     { 0x0410, "it" },     { 0x0810, "ch", "fr" }, { 0x040a, "es" },   { 0x0c0a, "es" },
     { 0x080a, "latam" },  { 0x0416, "br" },     { 0x0816, "pt" },     { 0x0413, "nl" },
@@ -87,7 +87,8 @@
 
 #ifndef SG_MUTANT_KBD_NO_KLID
 /* (wine-sg 8212) the XKB variants of the layout-id layouts (KLIDs with a "Layout Id" in
- * HKLM\System\CurrentControlSet\Control\Keyboard Layouts, wine.inf SgKeyboardLayouts) */
+ * HKLM\System\CurrentControlSet\Control\Keyboard Layouts, wine.inf SgKeyboardLayouts). 8217: KLID
+ * 00000c0c is Canadian French (Legacy) and 00001009 Canadian French -- language HKLs, in xkb_names */
 static const struct
 {
     DWORD klid;
@@ -96,7 +97,7 @@
 } xkb_klids[] =
 {
     { 0x00020409, "us", "intl" },     { 0x00010409, "us", "dvorak" },   { 0x00030409, "us", "dvorak-l" },
-    { 0x00040409, "us", "dvorak-r" }, { 0x00010c0c, "ca", "fr-legacy" }, { 0x00011009, "ca", "multix" },
+    { 0x00040409, "us", "dvorak-r" }, { 0x00011009, "ca", "multix" },
     { 0x00010405, "cz", "qwerty" },   { 0x0001041b, "sk", "qwerty" },   { 0x00010415, "pl", "qwertz" },
     { 0x00010419, "ru", "typewriter" }, { 0x00020419, "ru", "phonetic" }, { 0x0001041f, "tr", "f" },
     { 0x0001041e, "th", "pat" },
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -122,6 +122,7 @@
     SgDllOverrides,\
     SgAppDefaults,\
     SgKeyboardLayouts
+DelReg=SgKeyboardLayoutsGone
 
 [DefaultInstall.NT]
 ProfileItems=AdminToolComputerManagement,AdminToolDeviceManager,AdminToolDiskCleanup,AdminToolDiskManagement,AdminToolEventViewer,AdminToolRegistryEditor,AdminToolResourceMonitor,AdminToolServices,AdminToolSystemInformation
@@ -150,6 +151,7 @@
     SgDllOverrides,\
     SgAppDefaults,\
     SgKeyboardLayouts
+DelReg=SgKeyboardLayoutsGone
 
 [DefaultInstall.ntamd64]
 ProfileItems=AdminToolComputerManagement,AdminToolDeviceManager,AdminToolDiskCleanup,AdminToolDiskManagement,AdminToolEventViewer,AdminToolRegistryEditor,AdminToolResourceMonitor,AdminToolServices,AdminToolSystemInformation
@@ -179,6 +181,7 @@
     SgDllOverrides,\
     SgAppDefaults,\
     SgKeyboardLayouts
+DelReg=SgKeyboardLayoutsGone
 
 [DefaultInstall.ntarm64]
 ProfileItems=AdminToolComputerManagement,AdminToolDeviceManager,AdminToolDiskCleanup,AdminToolDiskManagement,AdminToolEventViewer,AdminToolRegistryEditor,AdminToolResourceMonitor,AdminToolServices,AdminToolSystemInformation
@@ -208,6 +211,7 @@
     SgDllOverrides,\
     SgAppDefaults,\
     SgKeyboardLayouts
+DelReg=SgKeyboardLayoutsGone
 
 [Wow64Install.ntx86]
 RegisterDlls=RegisterDllsSection
@@ -2952,36 +2956,37 @@
 HKLM,Software\Wine\DllOverrides,"conpty",,"builtin"
 
 [SgKeyboardLayouts]
-;; Stained Glass OS (wine-sg 8212): the keyboard layout variants winex11 builds from XKB, so that
+;; Stained Glass OS (wine-sg 8212, 8217): the keyboard layout variants winex11 builds from XKB, so that
 ;; LoadKeyboardLayout("00010409") gives the layout-id HKL (0xf0020409) and GetKeyboardLayoutName
-;; gives the KLID back. "Layout Id" 0001 and 0002 are the Windows values; the 0e0x ones are ours
-;; (Windows assigns its own; ours stay out of its range so no HKL means two layouts).
+;; gives the KLID back. "Layout Id" is Windows' own value for each KLID (hexadecimal, as in its registry).
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00020409,"Layout Text",,"United States-International"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00020409,"Layout Id",,"0001"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010409,"Layout Text",,"United States-Dvorak"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010409,"Layout Id",,"0002"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00030409,"Layout Text",,"United States-Dvorak for left hand"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00030409,"Layout Id",,"0e01"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00030409,"Layout Id",,"001a"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00040409,"Layout Text",,"United States-Dvorak for right hand"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00040409,"Layout Id",,"0e02"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010c0c,"Layout Text",,"Canadian French (Legacy)"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010c0c,"Layout Id",,"0e03"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00040409,"Layout Id",,"001b"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00011009,"Layout Text",,"Canadian Multilingual Standard"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00011009,"Layout Id",,"0e04"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00011009,"Layout Id",,"0020"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010405,"Layout Text",,"Czech (QWERTY)"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010405,"Layout Id",,"0e05"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010405,"Layout Id",,"0005"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041b,"Layout Text",,"Slovak (QWERTY)"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041b,"Layout Id",,"0e06"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041b,"Layout Id",,"0013"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010415,"Layout Text",,"Polish (214)"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010415,"Layout Id",,"0e07"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010415,"Layout Id",,"0007"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010419,"Layout Text",,"Russian (Typewriter)"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010419,"Layout Id",,"0e08"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010419,"Layout Id",,"0008"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00020419,"Layout Text",,"Russian - Mnemonic"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00020419,"Layout Id",,"0e09"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00020419,"Layout Id",,"0033"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041f,"Layout Text",,"Turkish F"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041f,"Layout Id",,"0e0a"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041f,"Layout Id",,"0014"
 HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041e,"Layout Text",,"Thai Pattachote"
-HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041e,"Layout Id",,"0e0b"
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\0001041e,"Layout Id",,"0021"
+
+[SgKeyboardLayoutsGone]
+;; (8217) 8212 listed Canadian French (Legacy) as 00010c0c; Windows has it as 00000c0c (a language HKL)
+HKLM,System\CurrentControlSet\Control\Keyboard Layouts\00010c0c
 
 [SgAppDefaults]
 ; Stained Glass OS (wine-sg 6192): programs whose Windows.UI.Xaml interface draws with ours, so
