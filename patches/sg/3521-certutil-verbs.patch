+static void out( const WCHAR *fmt, ... )
+{
+    va_list args;
+    WCHAR buf[8192];
+    DWORD written, len;
+    HANDLE h = GetStdHandle( STD_OUTPUT_HANDLE );
+
+    va_start( args, fmt );
+    len = vswprintf( buf, ARRAY_SIZE(buf), fmt, args );
+    va_end( args );
+    if (!WriteConsoleW( h, buf, len, &written, NULL ))
+    {
+        char mb[16384];
+        int n = WideCharToMultiByte( GetConsoleOutputCP(), 0, buf, len, mb, sizeof(mb), NULL, NULL );
+        WriteFile( h, mb, n, &written, NULL );
+    }
+}
+
+static void failed( const WCHAR *command, DWORD err )
+{
+    WCHAR *msg = NULL;
+
+    FormatMessageW( FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL,
+                    err, 0, (WCHAR *)&msg, 0, NULL );
+    if (msg)
+    {
+        WCHAR *end = msg + wcslen( msg );
+        while (end > msg && (end[-1] == '\r' || end[-1] == '\n' || end[-1] == ' ')) *--end = 0;
+    }
+    out( L"CertUtil: %ls command FAILED: 0x%x (%d)\nCertUtil: %ls\n", command, err, (int)err, msg ? msg : L"Unknown error" );
+    LocalFree( msg );
+}
+
+static void succeeded( const WCHAR *command )
+{
+    out( L"CertUtil: %ls command completed successfully.\n", command );
+}
+
+static BYTE *read_file( const WCHAR *name, DWORD *size )
 {
-    int i;
+    HANDLE file = CreateFileW( name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    BYTE *data;
+    DWORD read;
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    *size = GetFileSize( file, NULL );
+    if (*size == INVALID_FILE_SIZE || !(data = malloc( *size + 1 ))) { CloseHandle( file ); return NULL; }
+    if (!ReadFile( file, data, *size, &read, NULL )) { free( data ); CloseHandle( file ); return NULL; }
+    CloseHandle( file );
+    *size = read;
+    return data;
+}
 
+static BOOL write_file( const WCHAR *name, const void *data, DWORD size )
+{
+    HANDLE file = CreateFileW( name, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    DWORD written;
+    BOOL ok;
+
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ok = WriteFile( file, data, size, &written, NULL ) && written == size;
+    CloseHandle( file );
+    return ok;
+}
+
+static int cmd_hashfile( const WCHAR *name, const WCHAR *alg )
+{
+    static const struct { const WCHAR *name, *cng; } algs[] =
+    {
+        { L"MD2", L"MD2" }, { L"MD4", L"MD4" }, { L"MD5", L"MD5" }, { L"SHA1", L"SHA1" },
+        { L"SHA256", L"SHA256" }, { L"SHA384", L"SHA384" }, { L"SHA512", L"SHA512" },
+    };
+    BCRYPT_ALG_HANDLE halg = NULL;
+    BCRYPT_HASH_HANDLE hhash = NULL;
+    DWORD size, len, result, i;
+    BYTE *data = NULL, *hash = NULL;
+    const WCHAR *cng = NULL;
+    NTSTATUS status;
+    WCHAR *hex = NULL;
+    int ret = 1;
+
+    if (!alg) alg = L"SHA256";
+    for (i = 0; i < ARRAY_SIZE(algs); i++) if (!wcsicmp( alg, algs[i].name )) cng = algs[i].cng;
+    if (!cng) { failed( L"-hashfile", E_INVALIDARG ); return 1; }
+    if (!(data = read_file( name, &size ))) { failed( L"-hashfile", GetLastError() ); return 1; }
+
+    if ((status = BCryptOpenAlgorithmProvider( &halg, cng, NULL, 0 ))) { failed( L"-hashfile", E_NOTIMPL ); goto done; }
+    BCryptGetProperty( halg, BCRYPT_HASH_LENGTH, (UCHAR *)&len, sizeof(len), &result, 0 );
+    hash = malloc( len );
+    hex = malloc( (len * 2 + 1) * sizeof(WCHAR) );
+    if (!hash || !hex || BCryptCreateHash( halg, &hhash, NULL, 0, NULL, 0, 0 ) || BCryptHashData( hhash, data, size, 0 )
+            || BCryptFinishHash( hhash, hash, len, 0 ))
+    {
+        failed( L"-hashfile", ERROR_GEN_FAILURE );
+        goto done;
+    }
+    for (i = 0; i < len; i++) swprintf( hex + i * 2, 3, L"%02x", hash[i] );
+    out( L"%ls hash of %ls:\n%ls\n", cng, name, hex );
+    succeeded( L"-hashfile" );
+    ret = 0;
+
+done:
+    if (hhash) BCryptDestroyHash( hhash );
+    if (halg) BCryptCloseAlgorithmProvider( halg, 0 );
+    free( hash ); free( hex ); free( data );
+    return ret;
+}
+
+/* hexadecimal text, as certutil writes it: an offset, up to 16 bytes in two groups of eight, and the printable characters */
+static char *hex_dump( const BYTE *data, DWORD size, BOOL raw, DWORD *out_len )
+{
+    DWORD cap = size * 8 + 64, len = 0, off, i;
+    char *buf = malloc( cap );
+
+    if (!buf) return NULL;
+    for (off = 0; off < size; off += 16)
+    {
+        DWORD n = min( 16, size - off );
+
+        if (!raw) len += sprintf( buf + len, "%04x\t", (unsigned int)off );
+        for (i = 0; i < 16; i++)
+        {
+            if (i < n) len += sprintf( buf + len, "%02x", data[off + i] );
+            else if (!raw) len += sprintf( buf + len, "  " );
+            else break;
+            if (i + 1 < 16 && (i + 1 < n || !raw)) buf[len++] = ' ';
+            if (!raw && i == 7) buf[len++] = ' ';
+        }
+        if (raw)
+        {
+            while (len && buf[len - 1] == ' ') len--;
+        }
+        else
+        {
+            buf[len++] = ' ';
+            buf[len++] = ' ';
+            for (i = 0; i < n; i++) buf[len++] = (data[off + i] >= 32 && data[off + i] < 127) ? data[off + i] : '.';
+        }
+        buf[len++] = '\r';
+        buf[len++] = '\n';
+    }
+    *out_len = len;
+    return buf;
+}
+
+static int hex_digit( char c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* the bytes of the dump above, or of plain hex pairs with or without separators */
+static BYTE *hex_undump( const char *text, DWORD size, DWORD *out_len )
+{
+    BYTE *out = malloc( size / 2 + 1 );
+    DWORD pos = 0, n = 0;
+
+    if (!out) return NULL;
+    while (pos < size)
+    {
+        DWORD end = pos, tokens = 0;
+        char *tok[64];
+        DWORD toklen[64], k;
+        BOOL offset_form;
+
+        while (end < size && text[end] != '\n') end++;
+        /* split the line into blanks-separated tokens */
+        for (k = pos; k < end && tokens < 64;)
+        {
+            while (k < end && (text[k] == ' ' || text[k] == '\t' || text[k] == '\r')) k++;
+            if (k >= end) break;
+            tok[tokens] = (char *)text + k;
+            toklen[tokens] = 0;
+            while (k < end && text[k] != ' ' && text[k] != '\t' && text[k] != '\r') { k++; toklen[tokens]++; }
+            tokens++;
+        }
+        offset_form = tokens > 1 && toklen[0] >= 4 && toklen[0] <= 8;
+        if (offset_form)
+            for (k = 0; k < toklen[0]; k++) if (hex_digit( tok[0][k] ) < 0) offset_form = FALSE;
+        {
+            DWORD first = offset_form ? 1 : 0, taken = 0, t;
+
+            for (t = first; t < tokens; t++)
+            {
+                DWORD c;
+                BOOL pairs = toklen[t] % 2 == 0;
+
+                for (c = 0; c < toklen[t]; c++) if (hex_digit( tok[t][c] ) < 0) pairs = FALSE;
+                if (!pairs) break;
+                if (offset_form && toklen[t] != 2) break;
+                for (c = 0; c < toklen[t]; c += 2) out[n++] = hex_digit( tok[t][c] ) * 16 + hex_digit( tok[t][c + 1] );
+                if (offset_form && ++taken == 16) break;
+            }
+        }
+        pos = end + 1;
+    }
+    *out_len = n;
+    return out;
+}
+
+static int cmd_encode( const WCHAR *in, const WCHAR *outname, BOOL decode, BOOL hex )
+{
+    const WCHAR *cmd = decode ? (hex ? L"-decodehex" : L"-decode") : (hex ? L"-encodehex" : L"-encode");
+    BYTE *data;
+    DWORD size, needed = 0;
+    int ret = 1;
+
+    if (!(data = read_file( in, &size ))) { failed( cmd, GetLastError() ); return 1; }
+    if (!decode)
+    {
+        if (hex)
+        {
+            DWORD len;
+            char *dump = hex_dump( data, size, raw_hex, &len );
+
+            if (!dump || !write_file( outname, dump, len )) { failed( cmd, GetLastError() ); free( dump ); goto done; }
+            out( L"Input Length = %lu\nOutput Length = %lu\n", size, len );
+            free( dump );
+        }
+        else
+        {
+            WCHAR *text;
+            char *mb;
+            int mblen, n;
+
+            if (!CryptBinaryToStringW( data, size, CRYPT_STRING_BASE64, NULL, &needed )) { failed( cmd, GetLastError() ); goto done; }
+            text = malloc( needed * sizeof(WCHAR) );
+            CryptBinaryToStringW( data, size, CRYPT_STRING_BASE64, text, &needed );
+            mblen = WideCharToMultiByte( CP_ACP, 0, text, needed, NULL, 0, NULL, NULL );
+            mb = malloc( mblen + 64 );
+            /* a base64 block is framed as a certificate unless certutil is told otherwise */
+            n = sprintf( mb, "-----BEGIN CERTIFICATE-----\r\n" );
+            n += WideCharToMultiByte( CP_ACP, 0, text, needed, mb + n, mblen, NULL, NULL );
+            while (n > 0 && mb[n - 1] == 0) n--;
+            n += sprintf( mb + n, "-----END CERTIFICATE-----\r\n" );
+            mblen = n;
+            if (!write_file( outname, mb, mblen )) { failed( cmd, GetLastError() ); free( text ); free( mb ); goto done; }
+            out( L"Input Length = %lu\nOutput Length = %d\n", size, mblen );
+            free( text ); free( mb );
+        }
+    }
+    else if (hex)
+    {
+        DWORD len;
+        BYTE *bin = hex_undump( (char *)data, size, &len );
+
+        if (!bin || !write_file( outname, bin, len )) { failed( cmd, GetLastError() ); free( bin ); goto done; }
+        out( L"Input Length = %lu\nOutput Length = %lu\n", size, len );
+        free( bin );
+    }
+    else
+    {
+        WCHAR *text = malloc( (size + 1) * sizeof(WCHAR) );
+        BYTE *bin;
+
+        MultiByteToWideChar( CP_ACP, 0, (char *)data, size, text, size );
+        text[size] = 0;
+        if (!CryptStringToBinaryW( text, size, CRYPT_STRING_ANY, NULL, &needed, NULL, NULL )) { failed( cmd, GetLastError() ); free( text ); goto done; }
+        bin = malloc( needed );
+        CryptStringToBinaryW( text, size, CRYPT_STRING_ANY, bin, &needed, NULL, NULL );
+        if (!write_file( outname, bin, needed )) { failed( cmd, GetLastError() ); free( text ); free( bin ); goto done; }
+        out( L"Input Length = %lu\nOutput Length = %lu\n", size, needed );
+        free( text ); free( bin );
+    }
+    succeeded( cmd );
+    ret = 0;
+done:
+    free( data );
+    return ret;
+}
+
+static HCERTSTORE open_store( const WCHAR *name, DWORD extra )
+{
+    DWORD location = opt_user ? CERT_SYSTEM_STORE_CURRENT_USER : CERT_SYSTEM_STORE_LOCAL_MACHINE;
+
+    return CertOpenStore( CERT_STORE_PROV_SYSTEM_W, 0, 0, location | extra, name );
+}
+
+static void hex_of( const BYTE *data, DWORD len, WCHAR *buf )
+{
+    DWORD i;
+    for (i = 0; i < len; i++) swprintf( buf + i * 2, 3, L"%02x", data[i] );
+}
+
+static void print_filetime( const FILETIME *ft )
+{
+    SYSTEMTIME st;
+    WCHAR date[64], time[64];
+
+    FileTimeToSystemTime( ft, &st );
+    GetDateFormatW( LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, date, ARRAY_SIZE(date) );
+    GetTimeFormatW( LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, time, ARRAY_SIZE(time) );
+    out( L"%ls %ls", date, time );
+}
+
+static int cmd_store( const WCHAR *name )
+{
+    HCERTSTORE store;
+    const CERT_CONTEXT *cert = NULL;
+    int index = 0;
+
+    if (!name) name = L"My";
+    if (!(store = open_store( name, CERT_STORE_READONLY_FLAG | CERT_STORE_OPEN_EXISTING_FLAG )))
+    {
+        failed( L"-store", GetLastError() );
+        return 1;
+    }
+    out( L"%ls\n", name );
+    while ((cert = CertEnumCertificatesInStore( store, cert )))
+    {
+        WCHAR subject[512], issuer[512], hash[41], serial[256];
+        BYTE sha1[20];
+        DWORD len = sizeof(sha1), i, slen;
+
+        CertGetNameStringW( cert, CERT_NAME_RDN_TYPE, 0, NULL, subject, ARRAY_SIZE(subject) );
+        CertNameToStrW( X509_ASN_ENCODING, &cert->pCertInfo->Subject, CERT_X500_NAME_STR, subject, ARRAY_SIZE(subject) );
+        CertNameToStrW( X509_ASN_ENCODING, &cert->pCertInfo->Issuer, CERT_X500_NAME_STR, issuer, ARRAY_SIZE(issuer) );
+        CertGetCertificateContextProperty( cert, CERT_SHA1_HASH_PROP_ID, sha1, &len );
+        hex_of( sha1, len, hash );
+        slen = 0;
+        for (i = cert->pCertInfo->SerialNumber.cbData; i > 0 && slen + 3 < ARRAY_SIZE(serial); i--, slen += 2)
+            swprintf( serial + slen, 3, L"%02x", cert->pCertInfo->SerialNumber.pbData[i - 1] );
+        serial[slen] = 0;
+        out( L"================ Certificate %d ================\n", index++ );
+        out( L"Serial Number: %ls\nIssuer: %ls\n NotBefore: ", serial, issuer );
+        print_filetime( &cert->pCertInfo->NotBefore );
+        out( L"\n NotAfter: " );
+        print_filetime( &cert->pCertInfo->NotAfter );
+        out( L"\nSubject: %ls\nCert Hash(sha1): %ls\n", subject, hash );
+    }
+    CertCloseStore( store, 0 );
+    succeeded( L"-store" );
     return 0;
 }
+
+static int cmd_addstore( const WCHAR *name, const WCHAR *file )
+{
+    HCERTSTORE store;
+    const CERT_CONTEXT *cert;
+    BYTE *data;
+    DWORD size;
+    int ret = 1;
+
+    if (!(data = read_file( file, &size ))) { failed( L"-addstore", GetLastError() ); return 1; }
+    /* the file may be PEM or DER */
+    cert = CertCreateCertificateContext( X509_ASN_ENCODING, data, size );
+    if (!cert)
+    {
+        WCHAR *text = malloc( (size + 1) * sizeof(WCHAR) );
+        DWORD needed = 0;
+        BYTE *bin;
+
+        MultiByteToWideChar( CP_ACP, 0, (char *)data, size, text, size );
+        text[size] = 0;
+        if (CryptStringToBinaryW( text, size, CRYPT_STRING_ANY, NULL, &needed, NULL, NULL ) && (bin = malloc( needed )))
+        {
+            if (CryptStringToBinaryW( text, size, CRYPT_STRING_ANY, bin, &needed, NULL, NULL ))
+                cert = CertCreateCertificateContext( X509_ASN_ENCODING, bin, needed );
+            free( bin );
+        }
+        free( text );
+    }
+    if (!cert) { failed( L"-addstore", GetLastError() ); free( data ); return 1; }
+    if (!(store = open_store( name, CERT_STORE_OPEN_EXISTING_FLAG | 0 )) && !(store = open_store( name, 0 )))
+    {
+        failed( L"-addstore", GetLastError() );
+    }
+    else
+    {
+        if (!CertAddCertificateContextToStore( store, cert, CERT_STORE_ADD_REPLACE_EXISTING, NULL )) failed( L"-addstore", GetLastError() );
+        else
+        {
+            out( L"%ls\nCertificate \"%ls\" added to store.\n", name, file );
+            succeeded( L"-addstore" );
+            ret = 0;
+        }
+        CertCloseStore( store, 0 );
+    }
+    CertFreeCertificateContext( cert );
+    free( data );
+    return ret;
+}
+
+static int cmd_delstore( const WCHAR *name, const WCHAR *match )
+{
+    HCERTSTORE store = open_store( name, CERT_STORE_OPEN_EXISTING_FLAG );
+    const CERT_CONTEXT *cert = NULL;
+    int deleted = 0, ret = 1;
+
+    if (!store) { failed( L"-delstore", GetLastError() ); return 1; }
+    for (;;)
+    {
+        WCHAR hash[41], subject[512];
+        BYTE sha1[20];
+        DWORD len = sizeof(sha1);
+        BOOL hit;
+
+        if (!(cert = CertEnumCertificatesInStore( store, cert ))) break;
+        CertGetCertificateContextProperty( cert, CERT_SHA1_HASH_PROP_ID, sha1, &len );
+        hex_of( sha1, len, hash );
+        CertGetNameStringW( cert, CERT_NAME_SIMPLE_DISPLAY_TYPE, 0, NULL, subject, ARRAY_SIZE(subject) );
+        hit = !wcsicmp( hash, match ) || !wcsicmp( subject, match );
+        if (hit)
+        {
+            const CERT_CONTEXT *dup = CertDuplicateCertificateContext( cert );
+
+            if (CertDeleteCertificateFromStore( dup )) deleted++;
+            else { failed( L"-delstore", GetLastError() ); CertCloseStore( store, 0 ); return 1; }
+            cert = NULL;
+            /* the enumeration restarts, the store changed under it */
+        }
+    }
+    CertCloseStore( store, 0 );
+    if (!deleted) { failed( L"-delstore", CRYPT_E_NOT_FOUND ); return 1; }
+    out( L"%ls\nDeleted %d certificate(s).\n", name, deleted );
+    succeeded( L"-delstore" );
+    ret = 0;
+    return ret;
+}
+
+static int usage(void)
+{
+    out( L"Verbs:\n"
+         L"  -dump                -- Dump configuration information or files\n"
+         L"  -encode              -- Encode file to Base64\n"
+         L"  -decode              -- Decode Base64-encoded file\n"
+         L"  -encodehex           -- Encode file to hexadecimal\n"
+         L"  -decodehex           -- Decode hexadecimal-encoded file\n"
+         L"  -hashfile            -- Generate and display cryptographic hash over a file\n"
+         L"  -store               -- Dump certificate store\n"
+         L"  -addstore            -- Add certificate to store\n"
+         L"  -delstore            -- Delete certificate from store\n\n"
+         L"CertUtil -?              -- Display a verb list (command list)\n"
+         L"CertUtil -store -?       -- Display help text for the \"store\" verb\n" );
+    return 0;
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    int i = 1, remaining;
+    const WCHAR *verb, *a1, *a2;
+
+    for (; i < argc; i++)
+    {
+        if (!wcsicmp( argv[i], L"-user" )) opt_user = TRUE;
+        else if (!wcsicmp( argv[i], L"-f" ) || !wcsicmp( argv[i], L"-silent" ) || !wcsicmp( argv[i], L"-v" )
+                 || !wcsicmp( argv[i], L"-split" ) || !wcsicmp( argv[i], L"-enterprise" )) ;
+        else break;
+    }
+    if (i >= argc) return usage();
+    verb = argv[i++];
+    remaining = argc - i;
+    a1 = remaining > 0 ? argv[i] : NULL;
+    a2 = remaining > 1 ? argv[i + 1] : NULL;
+
+    if (!wcscmp( verb, L"-?" ) || !wcscmp( verb, L"/?" )) return usage();
+    if (!wcsicmp( verb, L"-hashfile" ))
+    {
+        if (!a1) { out( L"Usage:\n  CertUtil [Options] -hashfile InFile [HashAlgorithm]\n" ); return 1; }
+        return cmd_hashfile( a1, a2 );
+    }
+    if (!wcsicmp( verb, L"-encode" ) || !wcsicmp( verb, L"-decode" ) || !wcsicmp( verb, L"-encodehex" ) || !wcsicmp( verb, L"-decodehex" ))
+    {
+        BOOL decode = !wcsnicmp( verb, L"-decode", 7 ), hex = !wcsicmp( verb + (decode ? 7 : 7), L"hex" );
+
+        if (!a1 || !a2) { out( L"Usage:\n  CertUtil [Options] %ls InFile OutFile\n", verb ); return 1; }
+        /* a third argument picks the layout: 4 is bare hex bytes without offsets or text */
+        if (hex && remaining > 2 && !wcscmp( argv[i + 2], L"4" )) raw_hex = TRUE;
+        return cmd_encode( a1, a2, decode, hex );
+    }
+    if (!wcsicmp( verb, L"-store" )) return cmd_store( a1 );
+    if (!wcsicmp( verb, L"-addstore" ))
+    {
+        if (!a1 || !a2) { out( L"Usage:\n  CertUtil [Options] -addstore StoreName InFile\n" ); return 1; }
+        return cmd_addstore( a1, a2 );
+    }
+    if (!wcsicmp( verb, L"-delstore" ))
+    {
+        if (!a1 || !a2) { out( L"Usage:\n  CertUtil [Options] -delstore StoreName CertIndex|Subject|Hash\n" ); return 1; }
+        return cmd_delstore( a1, a2 );
+    }
+    WINE_FIXME( "verb %s is not implemented\n", wine_dbgstr_w( verb ) );
+    out( L"CertUtil: %ls command is not supported\n", verb );
+    return (int)E_NOTIMPL;
+}
--- a/programs/certutil/Makefile.in
+++ b/programs/certutil/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = certutil.exe
+IMPORTS   = crypt32 bcrypt advapi32 user32
 
 EXTRADLLFLAGS = -mconsole -municode
 
