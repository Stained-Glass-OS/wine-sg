From: Stained Glass OS <ke7oxh@gmail.com>
Subject: shell32: a window stays responsive while it copies

David: "If you copy a lot of files, the file manager stops updating, and if
you drag the copy dialog over the file browser it shows copies of the file
copier over the file manager." SHFileOperation ran the whole operation on
the caller's thread: File Explorer's Paste blocked its window until the copy
was done (the progress window has a thread of its own, so it moved while the
window under it did not repaint). Called from a thread with windows, the
operation now runs on a thread of its own while the caller's thread handles
its messages until it is done -- still synchronous for the caller.

Gate: make test-fileopresponsive.
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1836,8 +1836,49 @@
     ExitProcess(ret);
 }
 
+static int shfileop_run(LPSHFILEOPSTRUCTW lpFileOp);
+
+/* Stained Glass OS: the operation on a thread of its own while the caller's
+ * thread goes on handling its messages -- a window that asked for a long copy
+ * (File Explorer's Paste) stopped drawing until it was done, and the progress
+ * window dragged over it left copies of itself (David). */
+struct fileop_worker
+{
+    LPSHFILEOPSTRUCTW op;
+    int ret;
+};
+
+static DWORD WINAPI fileop_worker_proc(void *arg)
+{
+    struct fileop_worker *w = arg;
+
+    w->ret = shfileop_run(w->op);
+    return 0;
+}
+
 int WINAPI SHFileOperationW(LPSHFILEOPSTRUCTW lpFileOp)
 {
+    struct fileop_worker w = { lpFileOp, ERROR_INVALID_PARAMETER };
+    HANDLE thread;
+
+    if (!lpFileOp || !IsGUIThread(FALSE) || !(thread = CreateThread(NULL, 0, fileop_worker_proc, &w, 0, NULL)))
+        return shfileop_run(lpFileOp);
+    while (MsgWaitForMultipleObjects(1, &thread, FALSE, INFINITE, QS_ALLINPUT) == WAIT_OBJECT_0 + 1)
+    {
+        MSG msg;
+        while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE))
+        {
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    CloseHandle(thread);
+    SetLastError(ERROR_SUCCESS);
+    return w.ret;
+}
+
+static int shfileop_run(LPSHFILEOPSTRUCTW lpFileOp)
+{
     FILE_OPERATION op;
     FILE_LIST flFrom, flTo;
     WCHAR denied[MAX_PATH];
