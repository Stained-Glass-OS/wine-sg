From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: an empty machine Root store holds the host's roots

Only an administrator may write HKLM\Software\Microsoft\SystemCertificates
\Root (the machine registry has had security descriptors since 2026-10-15), so Wine's import
of the host's CA bundle into it happens only when an administrator's program
opens the store. On a freshly installed machine none had: the store was
empty, and every standard user's program trusted no server at all --
wininet failed every HTTPS request with 12045 or 12057, and SG Store could
download nothing.

While the machine's Root store holds no certificate, a program now reads
the host's roots (and Wine's built-in Microsoft roots) itself, into memory,
once, and the machine's Root store it opens includes them. The registry copy
stays the administrator's, and once it holds roots nothing changes.

Gate: test-hostroots (a standard user on a prefix whose HKLM Root is empty
and not theirs to write reaches an HTTPS server's certificate chain);
mutant SG_MUTANT_NO_HOST_ROOTS fails it.
---
--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -417,6 +417,9 @@
  DWORD dwFlags, const void *pvPara);
 
 void CRYPT_ImportSystemRootCertsToReg(void);
+/* Stained Glass OS 5940: the host's roots, in memory, when the machine's Root
+ * store is empty (no administrator's program filled it yet), else NULL */
+HCERTSTORE CRYPT_SGHostRootsIfMachineEmpty(void);
 BOOL CRYPT_SerializeContextsToReg(HKEY key, DWORD flags, const WINE_CONTEXT_INTERFACE *contextInterface,
     HCERTSTORE memStore);
 void CRYPT_RegReadSerializedFromReg(HKEY key, DWORD contextType,
--- a/dlls/crypt32/rootstore.c
+++ b/dlls/crypt32/rootstore.c
@@ -899,3 +899,44 @@
     ReleaseSemaphore(hsem, 1, NULL);
     CloseHandle(hsem);
 }
+
+/* Stained Glass OS 5940: only an administrator may write HKLM\Root, so the
+ * import above fills it only when an administrator's program opens it. On a
+ * machine where none has yet -- a fresh install -- it stayed empty and a
+ * standard user's programs trusted no server at all (wininet 12045/12057:
+ * SG Store could download nothing). Such a program reads the host's roots
+ * itself, in memory, for as long as the machine's store is empty. */
+static HCERTSTORE sg_host_roots;
+
+static BOOL WINAPI sg_load_host_roots(INIT_ONCE *once, void *param, void **context)
+{
+    HCERTSTORE cached;
+    DWORD subkeys = 0;
+    BOOL delete;
+    HKEY key;
+
+#ifdef SG_MUTANT_NO_HOST_ROOTS
+    return TRUE;
+#endif
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\SystemCertificates\\Root\\Certificates",
+                       0, KEY_READ, &key))
+    {
+        RegQueryInfoKeyW(key, NULL, NULL, NULL, &subkeys, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+        RegCloseKey(key);
+    }
+    if (subkeys) return TRUE;
+    if (!(cached = CertOpenStore(CERT_STORE_PROV_MEMORY, X509_ASN_ENCODING, 0, CERT_STORE_CREATE_NEW_FLAG, NULL)))
+        return TRUE;
+    sg_host_roots = create_root_store(cached, &delete);
+    CertCloseStore(cached, 0);
+    TRACE("machine Root store empty: the host's roots in memory, %p\n", sg_host_roots);
+    return TRUE;
+}
+
+HCERTSTORE CRYPT_SGHostRootsIfMachineEmpty(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+
+    InitOnceExecuteOnce(&once, sg_load_host_roots, NULL, NULL);
+    return sg_host_roots ? CertDuplicateStore(sg_host_roots) : NULL;
+}
--- a/dlls/crypt32/store.c
+++ b/dlls/crypt32/store.c
@@ -883,6 +883,22 @@
     RegCloseKey(parent);
 }
 
+/* Stained Glass OS 5940: the machine's Root store, while it is empty, also
+ * holds the host's roots (rootstore.c) */
+static void sg_add_host_roots(HCERTSTORE store, DWORD dwFlags, const void *pvPara)
+{
+    HCERTSTORE host;
+
+    if ((dwFlags & CERT_SYSTEM_STORE_LOCATION_MASK) != CERT_SYSTEM_STORE_LOCAL_MACHINE ||
+        lstrcmpiW(pvPara, L"Root"))
+        return;
+    if ((host = CRYPT_SGHostRootsIfMachineEmpty()))
+    {
+        CertAddStoreToCollection(store, host, 0, 0);
+        CertCloseStore(host, 0);
+    }
+}
+
 static WINECRYPT_CERTSTORE *CRYPT_SysOpenStoreW(HCRYPTPROV hCryptProv,
  DWORD dwFlags, const void *pvPara)
 {
@@ -936,6 +952,7 @@
              * stores.
              */
             sg_add_policy_stores(store, dwFlags, pvPara);
+            sg_add_host_roots(store, dwFlags, pvPara);
             if ((dwFlags & CERT_SYSTEM_STORE_LOCATION_MASK) ==
              CERT_SYSTEM_STORE_CURRENT_USER)
             {
@@ -963,6 +980,7 @@
                 }
                 /* the machine's store as the machine sees it */
                 sg_add_policy_stores(store, dwFlags, pvPara);
+                sg_add_host_roots(store, dwFlags, pvPara);
             }
             /* System store doesn't need crypto provider, so close it */
             if (hCryptProv && !(dwFlags & CERT_STORE_NO_CRYPT_RELEASE_FLAG))
