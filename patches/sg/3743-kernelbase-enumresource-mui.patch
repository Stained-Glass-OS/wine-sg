From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: the MUI flags of EnumResource*Ex (3743)

kernelbase: the MUI flags of EnumResource*Ex

RESOURCE_ENUM_MUI and RESOURCE_ENUM_MUI_SYSTEM now list the entries of the
language file of the module (<dir>\<locale>\<name>.mui) that the module does
not have, the locale being the one asked for or the UI language, with its
neutral language as the fallback; RESOURCE_ENUM_VALIDATE needs the MUI
resource in both files. Asking only for a .mui that is not there is
ERROR_MUI_FILE_NOT_FOUND. The flags were only logged before.
---
diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index 7afbe04..1ca210b 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -656,6 +656,152 @@ static NTSTATUS get_res_nameW( LPCWSTR name, UNICODE_STRING *str )
 }
 
 
+/* Stained Glass OS: the MUI flags of the EnumResource*Ex family.  RESOURCE_ENUM_LN enumerates the module
+ * itself; RESOURCE_ENUM_MUI / _MUI_SYSTEM also enumerate the resource-only file that localizes it
+ * (<dir>\<locale>\<name>.mui, the user's or the system's UI language, or lang when it is not 0), adding the
+ * entries the module does not have; RESOURCE_ENUM_VALIDATE only accepts a .mui file when both files carry a
+ * "MUI" resource (GUESS: the real check compares the checksums inside it, which is undocumented). */
+struct res_source
+{
+    const IMAGE_RESOURCE_DIRECTORY *base, *dir;          /* this source */
+    const IMAGE_RESOURCE_DIRECTORY *ln_base, *ln_dir;    /* what it must not repeat (NULL for the module) */
+};
+
+static BOOL res_entry_in_dir( const IMAGE_RESOURCE_DIRECTORY *base, const IMAGE_RESOURCE_DIRECTORY *dir,
+                              const IMAGE_RESOURCE_DIRECTORY *ebase, const IMAGE_RESOURCE_DIRECTORY_ENTRY *e )
+{
+    const IMAGE_RESOURCE_DIRECTORY_ENTRY *et = (const IMAGE_RESOURCE_DIRECTORY_ENTRY *)(dir + 1);
+    int i;
+
+    if (!dir) return FALSE;
+    for (i = 0; i < dir->NumberOfNamedEntries + dir->NumberOfIdEntries; i++)
+    {
+        if (et[i].NameIsString != e->NameIsString) continue;
+        if (!e->NameIsString)
+        {
+            if (et[i].Id == e->Id) return TRUE;
+        }
+        else
+        {
+            const IMAGE_RESOURCE_DIR_STRING_U *a = (const void *)((const BYTE *)base + et[i].NameOffset);
+            const IMAGE_RESOURCE_DIR_STRING_U *b = (const void *)((const BYTE *)ebase + e->NameOffset);
+            if (a->Length == b->Length && !RtlCompareUnicodeStrings( a->NameString, a->Length,
+                                                                      b->NameString, b->Length, TRUE ))
+                return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL has_mui_resource( HMODULE module )
+{
+    static const WCHAR muiW[] = L"MUI";
+    LDR_RESOURCE_INFO info;
+    const IMAGE_RESOURCE_DIRECTORY *dir;
+
+    info.Type = (ULONG_PTR)muiW;
+    return !LdrFindResourceDirectory_U( module, &info, 1, &dir );
+}
+
+static HMODULE load_mui_file( HMODULE module, DWORD flags, LANGID lang )
+{
+    WCHAR path[MAX_PATH + 1], full[MAX_PATH + 1], locale[LOCALE_NAME_MAX_LENGTH], *p, *dash;
+    HMODULE mui;
+    int i, dirlen, ll;
+
+    if (!GetModuleFileNameW( module, path, MAX_PATH )) return NULL;
+    if (!(p = wcsrchr( path, '\\' ))) return NULL;
+    dirlen = p + 1 - path;
+    if (!lang) lang = (flags & RESOURCE_ENUM_MUI_SYSTEM) ? GetSystemDefaultUILanguage() : GetUserDefaultUILanguage();
+    if (!LCIDToLocaleName( MAKELCID( lang, SORT_DEFAULT ), locale, ARRAY_SIZE(locale), 0 )) return NULL;
+    /* the directory of the locale (de-DE), then of its neutral language (de) */
+    for (i = 0; i < 2; i++)
+    {
+        if (i)
+        {
+            if (!(dash = wcschr( locale, '-' ))) break;
+            *dash = 0;
+        }
+        ll = lstrlenW( locale );
+        if (dirlen + ll + 1 + lstrlenW( p + 1 ) + 5 > MAX_PATH) continue;
+        memcpy( full, path, dirlen * sizeof(WCHAR) );
+        lstrcpyW( full + dirlen, locale );
+        full[dirlen + ll] = '\\';
+        lstrcpyW( full + dirlen + ll + 1, p + 1 );
+        lstrcatW( full, L".mui" );
+        if ((mui = LoadLibraryExW( full, 0, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE )))
+        {
+            if ((flags & RESOURCE_ENUM_VALIDATE) && !(has_mui_resource( module ) && has_mui_resource( mui )))
+            {
+                FreeLibrary( mui );
+                return NULL;
+            }
+            return mui;
+        }
+    }
+    return NULL;
+}
+
+/* find the directories to enumerate: level 0 = types, 1 = names of info->Type, 2 = languages of Type+Name */
+static NTSTATUS get_res_sources( HMODULE module, DWORD flags, LANGID lang, LDR_RESOURCE_INFO *info, ULONG level,
+                                 struct res_source src[2], int *count, HMODULE *mui )
+{
+    NTSTATUS status = STATUS_SUCCESS;
+    const IMAGE_RESOURCE_DIRECTORY *base, *dir;
+
+    *count = 0;
+    *mui = NULL;
+    memset( src, 0, 2 * sizeof(*src) );
+    if (flags & RESOURCE_ENUM_LN)
+    {
+        status = LdrFindResourceDirectory_U( module, NULL, 0, &base );
+        if (!status)
+        {
+            dir = base;
+            if (level) status = LdrFindResourceDirectory_U( module, info, level, &dir );
+        }
+        if (!status)
+        {
+            src[0].base = base;
+            src[0].dir = dir;
+            *count = 1;
+        }
+        else if (!(flags & (RESOURCE_ENUM_MUI | RESOURCE_ENUM_MUI_SYSTEM))) return status;
+    }
+    if (flags & (RESOURCE_ENUM_MUI | RESOURCE_ENUM_MUI_SYSTEM))
+    {
+        NTSTATUS mui_status = STATUS_MUI_FILE_NOT_FOUND;
+
+        if ((*mui = load_mui_file( module, flags, lang )))
+        {
+            mui_status = LdrFindResourceDirectory_U( *mui, NULL, 0, &base );
+            if (!mui_status)
+            {
+                dir = base;
+                if (level) mui_status = LdrFindResourceDirectory_U( *mui, info, level, &dir );
+            }
+            if (!mui_status)
+            {
+                src[*count].base = base;
+                src[*count].dir = dir;
+                if (*count) { src[*count].ln_base = src[0].base; src[*count].ln_dir = src[0].dir; }
+                (*count)++;
+            }
+        }
+        if (!*count) return status ? status : *mui ? mui_status : STATUS_MUI_FILE_NOT_FOUND;
+    }
+    else if (!*count) return STATUS_INVALID_PARAMETER;
+    return STATUS_SUCCESS;
+}
+
+static void free_mui( HMODULE mui ) { if (mui) FreeLibrary( mui ); }
+
+#define ENUM_RES_FLAGS(flags) do { \
+    if (!(flags)) (flags) = RESOURCE_ENUM_LN | RESOURCE_ENUM_MUI; \
+    if (!((flags) & (RESOURCE_ENUM_LN | RESOURCE_ENUM_MUI | RESOURCE_ENUM_MUI_SYSTEM))) return FALSE; \
+} while (0)
