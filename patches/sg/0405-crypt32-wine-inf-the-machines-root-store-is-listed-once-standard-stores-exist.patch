From: Stained Glass OS contributors
Subject: crypt32, wine.inf: the machine's Root store is listed once; the standard certificate stores exist

- CertEnumSystemStore added "Root" for the local machine after the
  registry's stores, but opening that store writes its registry key, so it
  was then listed twice -- and PowerShell's cert: drive, which indexes the
  stores by name, lost cert:\LocalMachine entirely ("an item with the same
  key has already been added").
- The stores Windows has in both locations are created: AuthRoot, CA,
  ClientAuthIssuer, Disallowed, My, Root, SmartCardRoot, Trust,
  TrustedPeople, TrustedPublisher. Install-Module's publisher check walks
  cert:\*\Root and cert:\*\AuthRoot and stopped on the missing ones.

Gate: test/pssig-gate.sh (its two store checks fail without this patch).
---
--- a/dlls/crypt32/store.c
+++ b/dlls/crypt32/store.c
@@ -1319,6 +1319,7 @@
     LONG rc;
     HKEY key;
     CERT_SYSTEM_STORE_INFO info = { sizeof(info) };
+    BOOL seen_root = FALSE;
 
     TRACE("(%08lx, %p, %p, %p)\n", dwFlags, pvSystemStoreLocationPara, pvArg,
         pfnEnum);
@@ -1336,7 +1337,10 @@
             rc = RegEnumKeyExW(key, index++, name, &size, NULL, NULL, NULL,
                 NULL);
             if (!rc)
+            {
+                if (!wcsicmp(name, L"Root")) seen_root = TRUE;
                 ret = pfnEnum(name, dwFlags, &info, NULL, pvArg);
+            }
         } while (ret && !rc);
         if (ret && rc != ERROR_NO_MORE_ITEMS)
             SetLastError(rc);
@@ -1344,9 +1348,11 @@
     else
         SetLastError(rc);
     /* Include root store for the local machine location (it isn't in the
-     * registry)
+     * registry) -- once: opening it writes its key, and a store listed twice
+     * breaks callers that index stores by name (PowerShell's cert: drive
+     * lost all of LocalMachine).
      */
-    if (ret && (dwFlags & CERT_SYSTEM_STORE_LOCATION_MASK) ==
+    if (ret && !seen_root && (dwFlags & CERT_SYSTEM_STORE_LOCATION_MASK) ==
      CERT_SYSTEM_STORE_LOCAL_MACHINE)
         ret = pfnEnum(L"Root", dwFlags, &info, NULL, pvArg);
     return ret;
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -754,6 +754,26 @@
 HKLM,Software\Microsoft\Rpc\SecurityService,9,2,"secur32.dll"
 HKLM,Software\Microsoft\Shared Tools\MSInfo,,16
 HKLM,Software\Microsoft\SystemCertificates,,16
+HKLM,Software\Microsoft\SystemCertificates\AuthRoot,,16
+HKLM,Software\Microsoft\SystemCertificates\CA,,16
+HKLM,Software\Microsoft\SystemCertificates\ClientAuthIssuer,,16
+HKLM,Software\Microsoft\SystemCertificates\Disallowed,,16
+HKLM,Software\Microsoft\SystemCertificates\My,,16
+HKLM,Software\Microsoft\SystemCertificates\Root,,16
+HKLM,Software\Microsoft\SystemCertificates\SmartCardRoot,,16
+HKLM,Software\Microsoft\SystemCertificates\Trust,,16
+HKLM,Software\Microsoft\SystemCertificates\TrustedPeople,,16
+HKLM,Software\Microsoft\SystemCertificates\TrustedPublisher,,16
+HKCU,Software\Microsoft\SystemCertificates\AuthRoot,,16
+HKCU,Software\Microsoft\SystemCertificates\CA,,16
+HKCU,Software\Microsoft\SystemCertificates\ClientAuthIssuer,,16
+HKCU,Software\Microsoft\SystemCertificates\Disallowed,,16
+HKCU,Software\Microsoft\SystemCertificates\My,,16
+HKCU,Software\Microsoft\SystemCertificates\Root,,16
+HKCU,Software\Microsoft\SystemCertificates\SmartCardRoot,,16
+HKCU,Software\Microsoft\SystemCertificates\Trust,,16
+HKCU,Software\Microsoft\SystemCertificates\TrustedPeople,,16
+HKCU,Software\Microsoft\SystemCertificates\TrustedPublisher,,16
