From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 13:40:33 -0700
Subject: [PATCH] sppc: SLOpen/SLClose context handles (3246)

SLOpen returns a real context instead of a constant, SLClose releases it
(E_INVALIDARG for NULL, unknown or already closed), and the other SL calls
that take an HSLC refuse a handle that is not open. SLPersistApplicationPolicies
no longer logs a FIXME: there is nothing to persist as no right is consumed.
CORE review: security (the store still never grants a right).

diff --git a/dlls/sppc/sppc.c b/dlls/sppc/sppc.c
index 37591ba..8ae0c0a 100644
--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -29,12 +29,48 @@
 #include "winnls.h"
 #include "winternl.h"
 #include "wine/debug.h"
+#include "wine/list.h"
 
 #include "slpublic.h"
 #include "slerror.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(slc);
 
+/* SLOpen handles: an opened context stays valid until SLClose */
+struct slc_context
+{
+    struct list entry;
+    DWORD magic;
+};
+#define SLC_MAGIC 0x534c4331
+static struct list slc_list = LIST_INIT(slc_list);
+static CRITICAL_SECTION slc_cs;
+static CRITICAL_SECTION_DEBUG slc_cs_debug =
+{
+    0, 0, &slc_cs,
+    { &slc_cs_debug.ProcessLocksList, &slc_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": slc_cs") }
+};
+static CRITICAL_SECTION slc_cs = { &slc_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL valid_slc(HSLC handle)
+{
+    struct slc_context *ctx;
+    BOOL ret = FALSE;
+
+#ifdef SG_MUTANT_SPPC_NOCHECK
+    return handle != NULL;
+#endif
+    if (!handle) return FALSE;
+    EnterCriticalSection(&slc_cs);
+    LIST_FOR_EACH_ENTRY(ctx, &slc_list, struct slc_context, entry)
+    {
+        if (ctx == (struct slc_context *)handle) { ret = TRUE; break; }
+    }
+    LeaveCriticalSection(&slc_cs);
+    return ret;
+}
