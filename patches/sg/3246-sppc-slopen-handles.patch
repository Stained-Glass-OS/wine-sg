 HRESULT WINAPI SLOpen(HSLC *handle)
 {
-    FIXME("(%p) stub\n", handle );
+    struct slc_context *ctx;
+
+    TRACE("(%p)\n", handle);
 
     if (!handle)
         return E_INVALIDARG;
 
-    *handle = (HSLC)0xdeadbeef;
+    if (!(ctx = calloc(1, sizeof(*ctx))))
+        return E_OUTOFMEMORY;
+    ctx->magic = SLC_MAGIC;
+    EnterCriticalSection(&slc_cs);
+    list_add_tail(&slc_list, &ctx->entry);
+    LeaveCriticalSection(&slc_cs);
+    *handle = (HSLC)ctx;
 
     return S_OK;
 }
 
 HRESULT WINAPI SLClose(HSLC handle)
 {
-    FIXME("(%p) stub\n", handle );
+    struct slc_context *ctx = (struct slc_context *)handle;
+
+    TRACE("(%p)\n", handle);
+
+    if (!valid_slc(handle))
+        return E_INVALIDARG;
 
+    EnterCriticalSection(&slc_cs);
+#ifndef SG_MUTANT_SPPC_LEAK
+    list_remove(&ctx->entry);
+#endif
+    LeaveCriticalSection(&slc_cs);
+    ctx->magic = 0;
+#ifndef SG_MUTANT_SPPC_LEAK
+    free(ctx);
+#endif
     return S_OK;
 }
 
