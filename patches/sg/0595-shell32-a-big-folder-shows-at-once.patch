From: Stained Glass OS <ke7oxh@gmail.com>
Subject: shell32: a big folder shows at once

David: on a network share File Explorer's items appeared one by one, even
with the server on the same machine. Listing a share is fast (2033 entries in
0.7 s); the view's sort was slow: it compared two items by reading both
items' details afresh at every comparison -- some 44000 reads for a folder of
2000 files, four seconds on a fast machine, longer on the QA VM, with the
window blank meanwhile. Each item's name and the sorted column's text are now
read once for a sort (0.36 s for 2000 files).

Gate: make test-folderspeed (2000 files shown within 2 s; ~4 s before,
~0.6 s after).
--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -111,8 +111,28 @@
     INT     nHeaderID;
     INT     nLastHeaderID;
     void   *view;       /* Stained Glass: the view, for the folder's column details */
+    struct sort_key *keys;   /* Stained Glass: each item's text, read once for a sort */
+    UINT    nkeys;
 }LISTVIEW_SORT_INFO, *LPLISTVIEW_SORT_INFO;
 
+/* Stained Glass OS: what a sort compares, read once per item -- the name and
+ * the sorted column's text. A sort compared two items' details read afresh at
+ * every comparison: tens of thousands of reads for a folder of two thousand
+ * files, seconds before File Explorer showed it (David: a network share's
+ * items appeared one by one). */
+struct sort_key
+{
+    LPCITEMIDLIST pidl;
+    WCHAR *name;
+    WCHAR *text;
+};
+
+static int __cdecl sort_key_cmp(const void *a, const void *b)
+{
+    const struct sort_key *ka = a, *kb = b;
+    return ka->pidl < kb->pidl ? -1 : ka->pidl > kb->pidl ? 1 : 0;
+}
+
 typedef struct
 {
         IShellView3       IShellView3_iface;
@@ -1186,6 +1206,16 @@
     int column = pSortInfo->nHeaderID < 0 ? 0 : pSortInfo->nHeaderID;
     DWORD pid = sort_column_pid(This, pSortInfo->nHeaderID);
     INT nDiff = 0;
+    const struct sort_key *key1 = NULL, *key2 = NULL;
+
+    if (pSortInfo->keys)
+    {
+        struct sort_key find = { pidl1 };
+        key1 = bsearch(&find, pSortInfo->keys, pSortInfo->nkeys, sizeof(find), sort_key_cmp);
+        find.pidl = pidl2;
+        key2 = bsearch(&find, pSortInfo->keys, pSortInfo->nkeys, sizeof(find), sort_key_cmp);
+        if (!key1 || !key2) key1 = key2 = NULL;
+    }
 
     if (folder1 != folder2)
         return folder1 ? -1 : 1;  /* folders first, whichever way the sort goes */
@@ -1204,15 +1234,27 @@
     }
     else if (pid != PID_STG_NAME && column > 0)
     {
-        column_text(This, pidl1, column, text1, MAX_PATH);
-        column_text(This, pidl2, column, text2, MAX_PATH);
-        nDiff = StrCmpLogicalW(text1, text2);
+        if (key1 && key1->text && key2->text) nDiff = StrCmpLogicalW(key1->text, key2->text);
+        else
+        {
+            column_text(This, pidl1, column, text1, MAX_PATH);
+            column_text(This, pidl2, column, text2, MAX_PATH);
+            nDiff = StrCmpLogicalW(text1, text2);
+        }
     }
 
     if (nDiff == 0)
     {
-        column_text(This, pidl1, 0, text1, MAX_PATH);
-        column_text(This, pidl2, 0, text2, MAX_PATH);
+        if (key1 && key1->name && key2->name)
+        {
+            lstrcpynW(text1, key1->name, MAX_PATH);
+            lstrcpynW(text2, key2->name, MAX_PATH);
+        }
+        else
+        {
+            column_text(This, pidl1, 0, text1, MAX_PATH);
+            column_text(This, pidl2, 0, text2, MAX_PATH);
+        }
         if (!text1[0] && !text2[0])
             nDiff = (SHORT)HRESULT_CODE(IShellFolder_CompareIDs(This->pSFParent, 0, pidl1, pidl2));
         else
@@ -1290,8 +1332,44 @@
 
 static void ShellView_Sort(IShellViewImpl *This)
 {
-    This->ListViewSortInfo.view = This;
-    SendMessageW(This->hWndList, LVM_SORTITEMS, (WPARAM)&This->ListViewSortInfo, (LPARAM)ShellView_ListViewCompareItems);
+    LISTVIEW_SORT_INFO *info = &This->ListViewSortInfo;
+    int column = info->nHeaderID < 0 ? 0 : info->nHeaderID;
+    DWORD pid = sort_column_pid(This, info->nHeaderID);
+    BOOL text = pid != PID_STG_NAME && pid != PID_STG_WRITETIME && pid != PID_STG_SIZE && column > 0;
+    UINT i, n = SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0);
+    WCHAR buf[MAX_PATH];
+
+    info->view = This;
+    if (n > 1 && (info->keys = calloc(n, sizeof(*info->keys))))
+    {
+        for (i = 0; i < n; i++)
+        {
+            LVITEMW item = { LVIF_PARAM, i };
+            SendMessageW(This->hWndList, LVM_GETITEMW, 0, (LPARAM)&item);
+            info->keys[i].pidl = (LPCITEMIDLIST)item.lParam;
+            column_text(This, info->keys[i].pidl, 0, buf, MAX_PATH);
+            info->keys[i].name = wcsdup(buf);
+            if (text)
+            {
+                column_text(This, info->keys[i].pidl, column, buf, MAX_PATH);
+                info->keys[i].text = wcsdup(buf);
+            }
+        }
+        info->nkeys = n;
+        qsort(info->keys, n, sizeof(*info->keys), sort_key_cmp);
+    }
+    SendMessageW(This->hWndList, LVM_SORTITEMS, (WPARAM)info, (LPARAM)ShellView_ListViewCompareItems);
+    if (info->keys)
+    {
