From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: Support URL_ESCAPE_ASCII_URI_COMPONENT.

UrlEscapeW supports URL_ESCAPE_ASCII_URI_COMPONENT: every ASCII character
outside the RFC 3986 unreserved set (a-zA-Z0-9-.~_) is percent-encoded,
over the whole string with no URL parts; with URL_ESCAPE_AS_UTF8 (together
URL_ESCAPE_URI_COMPONENT) other characters become UTF-8 %XX, without it
they stay. The flag was ignored.

Gate: test/kernelbase-urlescapecomponent-gate.sh (64/32).
---
 dlls/kernelbase/path.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/dlls/kernelbase/path.c b/dlls/kernelbase/path.c
index c9994ad..cc84e69 100644
--- a/dlls/kernelbase/path.c
+++ b/dlls/kernelbase/path.c
@@ -3292,6 +3292,12 @@ HRESULT WINAPI UrlEscapeA(const char *url, char *escaped, DWORD *escaped_len, DW
     return hr;
 }
 
+static BOOL uri_component_needs_escape(WCHAR ch, DWORD flags)
+{
+    if (ch >= 0x80) return !!(flags & URL_ESCAPE_AS_UTF8);
+    return !(iswalnum(ch) || ch == '-' || ch == '.' || ch == '_' || ch == '~');
+}
+
 HRESULT WINAPI UrlEscapeW(const WCHAR *url, WCHAR *escaped, DWORD *escaped_len, DWORD flags)
 {
     DWORD needed = 0, slashes = 0, int_flags;
@@ -3308,7 +3314,7 @@ HRESULT WINAPI UrlEscapeW(const WCHAR *url, WCHAR *escaped, DWORD *escaped_len,
         return E_INVALIDARG;
 
     if (flags & ~(URL_ESCAPE_SPACES_ONLY | URL_ESCAPE_SEGMENT_ONLY | URL_DONT_ESCAPE_EXTRA_INFO |
-            URL_ESCAPE_PERCENT | URL_ESCAPE_AS_UTF8))
+            URL_ESCAPE_PERCENT | URL_ESCAPE_AS_UTF8 | URL_ESCAPE_ASCII_URI_COMPONENT))
     {
         FIXME("Unimplemented flags: %08lx\n", flags);
     }
@@ -3368,6 +3374,12 @@ HRESULT WINAPI UrlEscapeW(const WCHAR *url, WCHAR *escaped, DWORD *escaped_len,
         }
     }
 
+    /* "Percent-encode all ASCII characters outside of the unreserved set from
+     * URI RFC 3986 (a-zA-Z0-9-.~_)": the whole string, no URL parts */
+#ifndef SG_MUTANT_URLESCAPE_COMPONENT_IGNORED
+    if (flags & URL_ESCAPE_ASCII_URI_COMPONENT) int_flags = 0;
+#endif
+
     for (src = url; *src; )
     {
         WCHAR cur = *src;
@@ -3411,7 +3423,11 @@ HRESULT WINAPI UrlEscapeW(const WCHAR *url, WCHAR *escaped, DWORD *escaped_len,
 
             if (cur == '\\' && (int_flags & WINE_URL_BASH_AS_SLASH) && !stop_escaping) cur = '/';
 
-            if (url_needs_escape(cur, flags, int_flags) && !stop_escaping)
+            if ((
+#ifndef SG_MUTANT_URLESCAPE_COMPONENT_IGNORED
+                 (flags & URL_ESCAPE_ASCII_URI_COMPONENT) ? uri_component_needs_escape(cur, flags) :
+#endif
+                 url_needs_escape(cur, flags, int_flags)) && !stop_escaping)
             {
                 if (flags & URL_ESCAPE_AS_UTF8)
                 {
