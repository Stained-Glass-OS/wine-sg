From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: a registry key's security by name in the 32- and 64-bit views

Get/SetNamedSecurityInfo took SE_REGISTRY_KEY but not
SE_REGISTRY_WOW64_32KEY or SE_REGISTRY_WOW64_64KEY ("Object type 12 is not
currently supported", the DACL left NULL). Opera's installer asks for
HKCU\Software\Classes in the 32-bit view, read the NULL DACL and crashed
in GetExplicitEntriesFromAcl while setting up the registry -- Opera half
installed. The key is opened in that view and its security read or set as
any key's; Get/SetSecurityInfo take the two types too.

Test: test/wow64keysec-gate.sh with test/wow64keysec-probe.c (mutant
SG_MUTANT_NO_WOW64_KEY_TYPES).
---
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -1749,8 +1749,11 @@
     case SE_KERNEL_OBJECT:
     case SE_FILE_OBJECT:
     case SE_WMIGUID_OBJECT:
+    case SE_REGISTRY_WOW64_32KEY:
+    case SE_REGISTRY_WOW64_64KEY:
     case SE_REGISTRY_KEY:
-        if (type == SE_REGISTRY_KEY && (HandleToUlong(handle) >= HandleToUlong(HKEY_SPECIAL_ROOT_FIRST))
+        if (type != SE_KERNEL_OBJECT && type != SE_FILE_OBJECT && type != SE_WMIGUID_OBJECT
+                && (HandleToUlong(handle) >= HandleToUlong(HKEY_SPECIAL_ROOT_FIRST))
                 && (HandleToUlong(handle) <= HandleToUlong(HKEY_SPECIAL_ROOT_LAST)))
         {
             REGSAM access = READ_CONTROL;
@@ -2637,6 +2640,18 @@
             RegCloseKey( handle );
         }
         break;
+#ifndef SG_MUTANT_NO_WOW64_KEY_TYPES
+    /* Stained Glass OS: a key in the 32- or 64-bit view, by name */
+    case SE_REGISTRY_WOW64_32KEY:
+    case SE_REGISTRY_WOW64_64KEY:
+        if (!(err = get_security_regkey( pObjectName, access | (ObjectType == SE_REGISTRY_WOW64_32KEY ?
+                                         KEY_WOW64_32KEY : KEY_WOW64_64KEY), &handle )))
+        {
+            err = SetSecurityInfo( handle, SE_REGISTRY_KEY, SecurityInfo, psidOwner, psidGroup, pDacl, pSacl );
+            RegCloseKey( handle );
+        }
+        break;
+#endif
     case SE_FILE_OBJECT:
         if (SecurityInfo & DACL_SECURITY_INFORMATION)
             access |= READ_CONTROL;
@@ -2969,6 +2984,20 @@
             RegCloseKey( handle );
         }
         break;
+#ifndef SG_MUTANT_NO_WOW64_KEY_TYPES
+    /* Stained Glass OS: a key in the 32- or 64-bit view, by name -- Opera's
+     * installer asks for HKCU\Software\Classes so, and with "not supported"
+     * read a NULL DACL and crashed in GetExplicitEntriesFromAcl */
+    case SE_REGISTRY_WOW64_32KEY:
+    case SE_REGISTRY_WOW64_64KEY:
+        if (!(err = get_security_regkey( name, access | (type == SE_REGISTRY_WOW64_32KEY ?
+                                         KEY_WOW64_32KEY : KEY_WOW64_64KEY), &handle )))
+        {
+            err = GetSecurityInfo( handle, SE_REGISTRY_KEY, info, owner, group, dacl, sacl, descriptor );
+            RegCloseKey( handle );
+        }
+        break;
+#endif
     case SE_FILE_OBJECT:
         if (!(err = get_security_file( name, access, &handle )))
         {
@@ -3370,6 +3399,8 @@
         status = NtSetSecurityObject(handle, SecurityInfo, &sd);
         break;
 
+    case SE_REGISTRY_WOW64_32KEY:
+    case SE_REGISTRY_WOW64_64KEY:
     case SE_REGISTRY_KEY:
         status = NtSetSecurityObject(handle, SecurityInfo, &sd);
         if (status == STATUS_ACCESS_DENIED)
