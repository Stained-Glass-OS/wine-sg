From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: the console session follows logons (5964)

WTSGetActiveConsoleSessionId read KUSER_SHARED_DATA.ActiveConsoleId (1677),
which the server set to SYSTEM's own session and never moved. In a shared
prefix each user has a session of their own (1706), so a service asking for
the user at the console -- WTSQueryUserToken(WTSGetActiveConsoleSessionId()),
the usual way a LocalSystem service starts a program on the user's desktop
-- got ERROR_NO_TOKEN. GOG Galaxy's GalaxyClientService ("Couldn't get query
user token, error code 1008") could not start Galaxy's updater for the
client, and the client asked for elevation at every logon instead.

As on Windows, a user who logs on at the console has it:

- The first process of a user's session is a logon: the console goes to
  that session.
- When the session at the console has no process left (the user logged
  off), it goes to the session of the newest process another user still
  has, else back to SYSTEM's (the logon screen's, which has no user:
  ERROR_NO_TOKEN, as on Windows before anyone logs on).
- A single-user prefix is unchanged (one session).

Gate: test/wtstoken-gate.sh (cases 4: console with one user, SYSTEM gets
that user's token through it, a second user logging on takes it, and it
goes back when they leave). Mutant SG_MUTANT_CONSOLE_STAYS_SYSTEM
(server/process.c): fails all four with GOG's error.
---
--- a/server/process.c
+++ b/server/process.c
@@ -1108,6 +1108,47 @@
     wake_up( &process->obj, 0 );
 }
 
+/* Stained Glass OS (5964): the session at the console. As on Windows a user
+ * who logs on at the console has it: the first process of a user's session
+ * (sg_session_for_uid) is a logon, and the console goes to that session.
+ * When the session at the console has no process left (the user logged
+ * off), it goes to the session of the newest process another user still
+ * has, else back to SYSTEM's (the logon screen's, no user). Services find
+ * the user to start a program for with WTSGetActiveConsoleSessionId and
+ * WTSQueryUserToken (GOG Galaxy's service: ERROR_NO_TOKEN, as the console
+ * stayed SYSTEM's, and its client asked for elevation at every logon). */
+static int session_has_process( unsigned int id, const struct process *except )
+{
+    struct process *process;
+
+    LIST_FOR_EACH_ENTRY( process, &process_list, struct process, entry )
+        if (process != except && process->session_id == id) return 1;
+    return 0;
+}
+
+static void sg_console_follow( struct process *changed, int arrived )
+{
+    struct process *process;
+    unsigned int id = default_session_id;
+    uid_t uid;
+
+#ifdef SG_MUTANT_CONSOLE_STAYS_SYSTEM
+    return;
+#endif
+    if (!sg_system_prefix || changed->session_id == default_session_id) return;
+    if (arrived)
+    {
+        if (sg_session_user( changed->session_id, &uid ) && !session_has_process( changed->session_id, changed ))
+            set_console_session( changed->session_id );
+        return;
+    }
+    if (changed->session_id != get_console_session() || session_has_process( changed->session_id, changed )) return;
+    LIST_FOR_EACH_ENTRY_REV( process, &process_list, struct process, entry )
+        if (process != changed && process->session_id != default_session_id &&
+            sg_session_user( process->session_id, &uid )) { id = process->session_id; break; }
+    set_console_session( id );
+}
+
 /* add a thread to a process running threads list */
 void add_process_thread( struct process *process, struct thread *thread )
 {
@@ -1116,6 +1157,7 @@
     {
         list_add_tail( &process_list, &process->entry );
         running_processes++;
+        sg_console_follow( process, 1 );
         if (!process->is_system)
         {
             if (!user_processes++ && shutdown_timeout)
@@ -1142,6 +1184,7 @@
         process->exit_code = thread->exit_code;
         generate_debug_event( thread, DbgExitProcessStateChange, process );
         list_remove( &process->entry );
+        sg_console_follow( process, 0 );
         process_killed( process );
     }
     else generate_debug_event( thread, DbgExitThreadStateChange, thread );
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1466,6 +1466,18 @@
     return &mapping->obj;
 }
 
+/* Stained Glass OS (5964): the session at the console, which
+ * WTSGetActiveConsoleSessionId reads (process.c moves it with logons) */
+unsigned int get_console_session(void)
+{
+    return user_shared_data ? user_shared_data->ActiveConsoleId : default_session_id;
+}
+
+void set_console_session( unsigned int id )
+{
+    if (user_shared_data) user_shared_data->ActiveConsoleId = id;
+}
+
 /* create a file mapping */
 DECL_HANDLER(create_mapping)
 {
--- a/server/process.h
+++ b/server/process.h
@@ -151,6 +151,8 @@
 static const unsigned int default_session_id = 1;
 extern void sg_create_session( unsigned int id );
 extern unsigned int sg_session_for_uid( uid_t uid );
+extern unsigned int get_console_session(void);
+extern void set_console_session( unsigned int id );
 extern int sg_session_user( unsigned int id, uid_t *uid );
 
 #endif  /* __WINE_SERVER_PROCESS_H */
