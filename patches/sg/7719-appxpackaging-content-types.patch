From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxpackaging: more than 4096 content types, Overrides hashed

---
--- a/dlls/appxpackaging/package.c
+++ b/dlls/appxpackaging/package.c
@@ -68,6 +68,8 @@
     struct name_index file_names;   /* Stained Glass OS: the files by name, once the block map is read */
     unsigned int type_count;
     struct content_type *types;
+    unsigned int type_capacity;
+    struct name_index override_names;   /* Stained Glass OS: the Override part names */
 };
 
 static const WCHAR *footprint_names[] =
@@ -299,10 +301,19 @@
 static HRESULT add_type( struct package *pkg, const WCHAR *key, const WCHAR *type, BOOL is_override )
 {
     struct content_type *t;
+    /* Stained Glass OS: one Override per file is allowed (JASP: 6653 of them; the limit was 4096) */
+#ifdef SG_MUTANT_APPX_TYPE_LIMIT
     if (pkg->type_count >= 4096) return APPX_E_CORRUPT_CONTENT;
-    if (!(t = realloc( pkg->types, (pkg->type_count + 1) * sizeof(*t) ))) return E_OUTOFMEMORY;
-    pkg->types = t;
-    t += pkg->type_count;
+#endif
+    if (pkg->type_count >= 0x100000) return APPX_E_CORRUPT_CONTENT;
+    if (pkg->type_count == pkg->type_capacity)
+    {
+        unsigned int capacity = pkg->type_capacity ? pkg->type_capacity * 2 : 64;
+        if (!(t = realloc( pkg->types, capacity * sizeof(*t) ))) return E_OUTOFMEMORY;
+        pkg->types = t;
+        pkg->type_capacity = capacity;
+    }
+    t = pkg->types + pkg->type_count;
     t->key = strdupW( key );
     t->type = strdupW( type );
     t->is_override = is_override;
@@ -347,7 +358,11 @@
     const WCHAR *ext = wcsrchr( e->name, '.' );
     unsigned int i;
 
-    for (i = 0; i < pkg->type_count; i++)
+    if (pkg->override_names.slots)
+    {
+        if ((i = name_index_find( &pkg->override_names, e->name )) != ~0u) return pkg->types[i].type;
+    }
+    else for (i = 0; i < pkg->type_count; i++)
     {
         const WCHAR *part = pkg->types[i].key, *name = e->name;
         if (!pkg->types[i].is_override) continue;
@@ -626,6 +641,7 @@
     name_index_free( &pkg->file_names );
     for (i = 0; i < pkg->type_count; i++) { free( pkg->types[i].key ); free( pkg->types[i].type ); }
     free( pkg->types );
+    name_index_free( &pkg->override_names );
     if (pkg->manifest) IAppxManifestReader_Release( pkg->manifest );
     zip_close( pkg->zip );
     free( pkg );
@@ -795,6 +811,10 @@
     hr = parse_content_types( pkg, data, types->size );
     free( data );
     if (FAILED(hr)) goto fail;
+    if (FAILED(hr = name_index_init( &pkg->override_names, pkg->type_count ))) goto fail;
+    for (i = 0; i < pkg->type_count; i++)
+        if (pkg->types[i].is_override)
+            name_index_add( &pkg->override_names, pkg->types[i].key + (pkg->types[i].key[0] == '/'), i );
     *out = pkg;
     return S_OK;
 
