From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winmm: mmioOpen makes a temporary file name for MMIO_GETTEMP (6066)

MMIO_GETTEMP was refused. The name is made in the directory the given
name names, else in the temporary directory, and copied to the caller's
buffer; the result is MMSYSERR_NOERROR or MMIOERR_FILENOTFOUND.
---
diff --git a/dlls/winmm/mmio.c b/dlls/winmm/mmio.c
index f049444..5f7d99a 100644
--- a/dlls/winmm/mmio.c
+++ b/dlls/winmm/mmio.c
@@ -647,6 +647,46 @@ static HMMIO MMIO_Open(LPSTR szFileName, MMIOINFO* refmminfo, DWORD dwOpenFlags,
         is_unicode = FALSE;
     }
 
+    /* a temporary file name, in the directory szFileName names (or that of the file it names),
+     * else in the temporary directory; this flag overrides all the others. The name is made
+     * unique by creating the file, as GetTempFileName does. */
+    if (dwOpenFlags & MMIO_GETTEMP) {
+	char	dir[MAX_PATH], name[MAX_PATH], *slash;
+	DWORD	attrs;
+
+	refmminfo->wErrorRet = MMSYSERR_NOERROR;
+	if (!szFileName) {
+	    refmminfo->wErrorRet = MMIOERR_FILENOTFOUND;
+	    return (HMMIO)MMIOERR_FILENOTFOUND;
+	}
+	dir[0] = 0;
+	if (szFileName[0] && GetFullPathNameA(szFileName, sizeof(dir), dir, NULL) < sizeof(dir)) {
+	    attrs = GetFileAttributesA(dir);
+	    if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY)) {
+		if ((slash = strrchr(dir, '\\'))) slash[1] = 0;
+		attrs = GetFileAttributesA(dir);
+		if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY)) dir[0] = 0;
+	    }
+	}
+	else dir[0] = 0;
+#ifdef SG_MUTANT_WINMM_GETTEMP_TEMPDIR_ONLY
+	dir[0] = 0;
+#endif
+	if (!dir[0] && !GetTempPathA(sizeof(dir), dir)) dir[0] = 0;
+	if (!dir[0] || !GetTempFileNameA(dir, "mmi", 0, name)) {
+	    refmminfo->wErrorRet = MMIOERR_FILENOTFOUND;
+	    return (HMMIO)MMIOERR_FILENOTFOUND;
+	}
+	if (strlen(name) >= MMIO_MAXPATH) {
+	    /* the caller's buffer holds 128 characters */
+	    DeleteFileA(name);
+	    refmminfo->wErrorRet = MMIOERR_FILENOTFOUND;
+	    return (HMMIO)MMIOERR_FILENOTFOUND;
+	}
+	strcpy(szFileName, name);
+	return (HMMIO)MMSYSERR_NOERROR;
+    }
+
     if (dwOpenFlags & (MMIO_PARSE|MMIO_EXIST)) {
 	char	buffer[MAX_PATH];
 	DWORD	len;
@@ -775,7 +815,11 @@ HMMIO WINAPI mmioOpenW(LPWSTR szFileName, MMIOINFO* lpmmioinfo,
 
     ret = MMIO_Open(szFn, lpmmioinfo, dwOpenFlags, TRUE);
 
-    if (szFn && (dwOpenFlags & (MMIO_PARSE|MMIO_EXIST)) && (ret || lpmmioinfo))
+    if (szFn && (dwOpenFlags & MMIO_GETTEMP))
+    {
+        if (!ret) MultiByteToWideChar( CP_ACP, 0, szFn, -1, szFileName, MMIO_MAXPATH );
+    }
+    else if (szFn && (dwOpenFlags & (MMIO_PARSE|MMIO_EXIST)) && (ret || lpmmioinfo))
     {
         /* hand the parsed name back to the caller's wide buffer */
         if (ret || lpmmioinfo->wErrorRet == MMIOERR_OUTOFMEMORY)
