 /* Stained Glass: the selected folders pinned to (or unpinned from) Quick access */
+/* Stained Glass OS: Eject. A mounted disc keeps its drive's tray locked, so
+ * the medium is unmounted first -- by sg-eject, through UDisks2, since the
+ * mount is the Windows system's -- then ejected. Without it, the eject
+ * request alone, as Wine did. */
+static HRESULT eject_drive(ContextMenu *This, HWND hwnd)
+{
+    static const WCHAR helperW[] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-eject";
+    LONG (WINAPI *spawnvp)( char * const argv[], int wait );
+    ITEMIDLIST *full = ILCombine(This->pidl, This->apidl[0]);
+    char helper[] = "/usr/libexec/stained-glass/sg-eject", *argv[3];
+    WCHAR root[MAX_PATH], device[8];
+    char *unix_path = NULL;
+    DWORD code = 1, bytes;
+    HANDLE h;
+
+    if (!full || !SHGetPathFromIDListW(full, root)) { ILFree(full); return E_FAIL; }
+    ILFree(full);
+
+    spawnvp = (void *)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "__wine_unix_spawnvp");
+    if (spawnvp && GetFileAttributesW(helperW) != INVALID_FILE_ATTRIBUTES && (unix_path = wine_get_unix_file_name(root)))
+    {
+        argv[0] = helper;
+        argv[1] = unix_path;
+        argv[2] = NULL;
+        code = spawnvp(argv, TRUE);   /* its exit status */
+    }
+    else
+    {
+        swprintf(device, ARRAY_SIZE(device), L"\\\\.\\%c:", root[0]);
+        h = CreateFileW(device, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+        if (h != INVALID_HANDLE_VALUE)
+        {
+            if (DeviceIoControl(h, IOCTL_STORAGE_EJECT_MEDIA, NULL, 0, NULL, 0, &bytes, NULL)) code = 0;
+            CloseHandle(h);
+        }
+    }
+    HeapFree(GetProcessHeap(), 0, unix_path);
+    if (code)
+        MessageBoxW(hwnd, L"This device is currently in use. Close any programs or windows that might be "
+                    L"using the device, and then try again.", L"Problem Ejecting", MB_OK | MB_ICONWARNING);
+    SHChangeNotify(SHCNE_MEDIAREMOVED, SHCNF_PATHW, root, NULL);
+    return S_OK;
+}
