From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: rundll32 shell32.dll,SHHelpShortcuts_RunDLL Connect opens Map Network Drive

rundll32 shell32.dll,SHHelpShortcuts_RunDLL Connect (and Disconnect,
PrintersFolder, FontsFolder) did nothing: it was a stub, declared with four
DWORDs (a 64-bit window handle cut in half). Scripts, installers and older
programs' "Map Network Drive" menu items use it. It is rundll32's entry point
now and opens Map Network Drive, Disconnect Network Drives, the Printers or
the Fonts folder, as on Windows.

Gate: test/netreach-gate.sh; mutant SG_MUTANT_HELPSHORTCUTS_STUB.
---
--- a/dlls/shell32/shell32_main.c
+++ b/dlls/shell32/shell32_main.c
@@ -37,6 +37,7 @@
 #include "shlobj.h"
 #include "rpcproxy.h"
 #include "shlwapi.h"
+#include "winnetwk.h"
 #include "propsys.h"
 #include "commoncontrols.h"
 
@@ -1109,24 +1110,46 @@
     DrawEdge( hdc, &rect, BDR_SUNKENOUTER, BF_RECT );
 }
 
+/* Stained Glass OS: the shortcuts rundll32 shell32.dll,SHHelpShortcuts_RunDLL <name> opens, as
+ * Windows does (wine-sg 9659): Connect (Map Network Drive), Disconnect (Disconnect Network
+ * Drives), PrintersFolder, FontsFolder. Scripts and older programs' menus use them; it was a stub
+ * taking four DWORDs (a 64-bit window handle cut in half). */
+static void help_shortcut(HWND hwnd, const WCHAR *name)
+{
+    TRACE("%p %s\n", hwnd, debugstr_w(name));
+#ifdef SG_MUTANT_HELPSHORTCUTS_STUB
+    return;
+#endif
+    if (!name) return;
+    while (*name == ' ') name++;
+    if (!wcsicmp(name, L"Connect")) SHStartNetConnectionDialogW(hwnd, NULL, RESOURCETYPE_DISK);
+    else if (!wcsicmp(name, L"Disconnect"))
+    {
+        HMODULE mpr = LoadLibraryW(L"mpr.dll");
+        DWORD (WINAPI *disconnect)(HWND, DWORD) = mpr ? (void *)GetProcAddress(mpr, "WNetDisconnectDialog") : NULL;
+        if (disconnect) disconnect(hwnd, RESOURCETYPE_DISK);
+    }
+    else if (!wcsicmp(name, L"PrintersFolder")) ShellExecuteW(hwnd, NULL, L"shell:PrintersFolder", NULL, NULL, SW_SHOWNORMAL);
+    else if (!wcsicmp(name, L"FontsFolder")) ShellExecuteW(hwnd, NULL, L"shell:Fonts", NULL, NULL, SW_SHOWNORMAL);
+    else FIXME("unknown shortcut %s\n", debugstr_w(name));
+}
+
 /*************************************************************************
  * SHHelpShortcuts_RunDLLA        [SHELL32.@]
- *
  */
-DWORD WINAPI SHHelpShortcuts_RunDLLA(DWORD dwArg1, DWORD dwArg2, DWORD dwArg3, DWORD dwArg4)
+void WINAPI SHHelpShortcuts_RunDLLA(HWND hwnd, HINSTANCE inst, LPSTR cmdline, int show)
 {
-    FIXME("(%lx, %lx, %lx, %lx) stub!\n", dwArg1, dwArg2, dwArg3, dwArg4);
-    return 0;
+    WCHAR name[64] = L"";
+    if (cmdline) MultiByteToWideChar(CP_ACP, 0, cmdline, -1, name, ARRAY_SIZE(name));
+    help_shortcut(hwnd, name);
 }
 
 /*************************************************************************
- * SHHelpShortcuts_RunDLLA        [SHELL32.@]
- *
+ * SHHelpShortcuts_RunDLLW        [SHELL32.@]
  */
-DWORD WINAPI SHHelpShortcuts_RunDLLW(DWORD dwArg1, DWORD dwArg2, DWORD dwArg3, DWORD dwArg4)
+void WINAPI SHHelpShortcuts_RunDLLW(HWND hwnd, HINSTANCE inst, LPWSTR cmdline, int show)
 {
-    FIXME("(%lx, %lx, %lx, %lx) stub!\n", dwArg1, dwArg2, dwArg3, dwArg4);
-    return 0;
+    help_shortcut(hwnd, cmdline);
 }
 
 /*************************************************************************
--- a/dlls/shell32/shell32.spec
+++ b/dlls/shell32/shell32.spec
@@ -414,9 +414,9 @@
 @ stdcall SHGetSpecialFolderPathA(long ptr long long)
 @ stdcall SHGetSpecialFolderPathW(long ptr long long)
 @ stdcall SHGetStockIconInfo(long long ptr)
-@ stdcall SHHelpShortcuts_RunDLL(long long long long) SHHelpShortcuts_RunDLLA
-@ stdcall SHHelpShortcuts_RunDLLA(long long long long)
-@ stdcall SHHelpShortcuts_RunDLLW(long long long long)
+@ stdcall SHHelpShortcuts_RunDLL(ptr ptr str long) SHHelpShortcuts_RunDLLA
+@ stdcall SHHelpShortcuts_RunDLLA(ptr ptr str long)
+@ stdcall SHHelpShortcuts_RunDLLW(ptr ptr wstr long)
 @ stdcall SHInvokePrinterCommandA(long long str str long)
 @ stdcall SHInvokePrinterCommandW(long long wstr wstr long)
 @ stdcall SHIsFileAvailableOffline(wstr ptr)
