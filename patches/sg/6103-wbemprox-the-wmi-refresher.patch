From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wbemprox: the WMI refresher and IWbemObjectAccess

CLSID_WbemRefresher was not registered: CPU-Z and hardware and performance monitors create one to read objects and a class's instances again and again (CPU-Z did not check and crashed). WbemRefresher implements IWbemRefresher and IWbemConfigureRefresher: AddObjectByPath and AddObjectByTemplate (objects refreshed in place), AddEnum (IWbemHiPerfEnum, the class's instances read again at each Refresh) and Remove. Class objects also answer IWbemObjectAccess (property handles: Read/Write DWORD, QWORD and property values).
---
diff --git a/dlls/wbemprox/Makefile.in b/dlls/wbemprox/Makefile.in
index 3edfa86..b79426b 100644
--- a/dlls/wbemprox/Makefile.in
+++ b/dlls/wbemprox/Makefile.in
@@ -9,6 +9,7 @@ SOURCES = \
 	qualifier.c \
 	query.c \
 	reg.c \
+	refresher.c \
 	security.c \
 	service.c \
 	services.c \
diff --git a/dlls/wbemprox/class.c b/dlls/wbemprox/class.c
index cde98a5..aca22db 100644
--- a/dlls/wbemprox/class.c
+++ b/dlls/wbemprox/class.c
@@ -352,7 +352,7 @@ static inline struct class_object *impl_from_IWbemClassObject(
     return CONTAINING_RECORD(iface, struct class_object, IWbemClassObject_iface);
 }
 
-static const IWbemClassObjectVtbl class_object_vtbl;
+static const IWbemObjectAccessVtbl class_object_vtbl;
 
 static struct table *class_object_table( struct class_object *co )
 {
@@ -485,7 +485,8 @@ static HRESULT WINAPI class_object_QueryInterface(
     TRACE("%p, %s, %p\n", co, debugstr_guid( riid ), ppvObject );
 
     if ( IsEqualGUID( riid, &IID_IWbemClassObject ) ||
-         IsEqualGUID( riid, &IID_IUnknown ) )
+         IsEqualGUID( riid, &IID_IUnknown ) ||
+         IsEqualGUID( riid, &IID_IWbemObjectAccess ) )  /* Stained Glass OS (6103): its vtable is one */
     {
         *ppvObject = &co->IWbemClassObject_iface;
     }
@@ -1146,7 +1147,7 @@ HRESULT get_class_object_definition( IWbemClassObject *obj, struct table **table
 {
     struct class_object *co;
 
-    if (!obj || obj->lpVtbl != &class_object_vtbl) return WBEM_E_INVALID_PARAMETER;
+    if (!obj || obj->lpVtbl != (const IWbemClassObjectVtbl *)&class_object_vtbl) return WBEM_E_INVALID_PARAMETER;
     co = impl_from_IWbemClassObject( obj );
     if (!co->iter && !co->record) return WBEM_E_INVALID_OBJECT;
     *table = class_object_table( co );
@@ -1200,7 +1201,7 @@ static HRESULT WINAPI class_object_CompareTo(
     TRACE( "%p, %#lx, %p\n", iface, lFlags, pCompareTo );
 
     if (!pCompareTo) return WBEM_E_INVALID_PARAMETER;
-    if (pCompareTo->lpVtbl != &class_object_vtbl) return WBEM_E_INVALID_PARAMETER;
+    if (pCompareTo->lpVtbl != (const IWbemClassObjectVtbl *)&class_object_vtbl) return WBEM_E_INVALID_PARAMETER;
     other = impl_from_IWbemClassObject( pCompareTo );
 
     if (!(lFlags & 0x8) /* WBEM_FLAG_IGNORE_CLASS */ && wcsicmp( co->name, other->name )) return WBEM_S_DIFFERENT;
@@ -1580,35 +1581,300 @@ static HRESULT WINAPI class_object_GetMethodOrigin(
         return WBEM_E_NOT_FOUND;
     return (*pstrClassName = SysAllocString( table->name )) ? S_OK : E_OUTOFMEMORY;
 }
-static const IWbemClassObjectVtbl class_object_vtbl =
-{
-    class_object_QueryInterface,
-    class_object_AddRef,
-    class_object_Release,
-    class_object_GetQualifierSet,
-    class_object_Get,
-    class_object_Put,
-    class_object_Delete,
-    class_object_GetNames,
-    class_object_BeginEnumeration,
-    class_object_Next,
-    class_object_EndEnumeration,
-    class_object_GetPropertyQualifierSet,
-    class_object_Clone,
-    class_object_GetObjectText,
-    class_object_SpawnDerivedClass,
-    class_object_SpawnInstance,
-    class_object_CompareTo,
-    class_object_GetPropertyOrigin,
-    class_object_InheritsFrom,
-    class_object_GetMethod,
-    class_object_PutMethod,
-    class_object_DeleteMethod,
-    class_object_BeginMethodEnumeration,
-    class_object_NextMethod,
-    class_object_EndMethodEnumeration,
-    class_object_GetMethodQualifierSet,
-    class_object_GetMethodOrigin
+/* Stained Glass OS (wine-sg 6103): IWbemObjectAccess, the property-handle access WMI refreshers'
+ * objects give (IWbemHiPerfEnum::GetObjects; CPU-Z, performance monitors). A handle is the
+ * property's column in the object's table. */
+static struct class_object *impl_from_IWbemObjectAccess( IWbemObjectAccess *iface )
+{
+    return impl_from_IWbemClassObject( (IWbemClassObject *)iface );
+}
+
+static HRESULT access_column( struct class_object *co, LONG handle, const WCHAR **name, CIMTYPE *type )
+{
+    struct table *table = class_object_table( co );
+
+    if (!table || handle < 0 || (UINT)handle >= table->num_cols) return WBEM_E_INVALID_PARAMETER;
+    if (name) *name = table->columns[handle].name;
+    if (type) *type = table->columns[handle].type & (CIM_TYPE_MASK | CIM_FLAG_ARRAY);
+    return S_OK;
+}
+
+static HRESULT WINAPI object_access_GetPropertyHandle( IWbemObjectAccess *iface, LPCWSTR name, CIMTYPE *type, LONG *handle )
+{
+    struct class_object *co = impl_from_IWbemObjectAccess( iface );
+    struct table *table = class_object_table( co );
+    UINT index;
+
+    TRACE( "%p, %s, %p, %p\n", iface, debugstr_w(name), type, handle );
+    if (!name || !handle) return WBEM_E_INVALID_PARAMETER;
+    if (!table || get_column_index( table, name, &index ) != S_OK) return WBEM_E_NOT_FOUND;
+    *handle = index;
+    if (type) *type = table->columns[index].type & (CIM_TYPE_MASK | CIM_FLAG_ARRAY);
+    return S_OK;
+}
+
+static HRESULT WINAPI object_access_GetPropertyInfoByHandle( IWbemObjectAccess *iface, LONG handle, BSTR *name, CIMTYPE *type )
+{
+    struct class_object *co = impl_from_IWbemObjectAccess( iface );
+    const WCHAR *column;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %p, %p\n", iface, handle, name, type );
+    if ((hr = access_column( co, handle, &column, type )) != S_OK) return hr;
+    if (name && !(*name = SysAllocString( column ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT access_get( IWbemObjectAccess *iface, LONG handle, VARIANT *var, CIMTYPE *type )
+{
+    struct class_object *co = impl_from_IWbemObjectAccess( iface );
+    const WCHAR *column;
+    HRESULT hr;
+
+    if ((hr = access_column( co, handle, &column, type )) != S_OK) return hr;
+    VariantInit( var );
+    return IWbemClassObject_Get( &co->IWbemClassObject_iface, column, 0, var, NULL, NULL );
+}
+
+static HRESULT access_put( IWbemObjectAccess *iface, LONG handle, VARIANT *var )
+{
+    struct class_object *co = impl_from_IWbemObjectAccess( iface );
+    const WCHAR *column;
+    HRESULT hr;
+
+    if ((hr = access_column( co, handle, &column, NULL )) != S_OK) return hr;
+    return IWbemClassObject_Put( &co->IWbemClassObject_iface, column, 0, var, 0 );
+}
+
+static HRESULT WINAPI object_access_ReadDWORD( IWbemObjectAccess *iface, LONG handle, DWORD *value )
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %p\n", iface, handle, value );
+    if (!value) return WBEM_E_INVALID_PARAMETER;
+    if ((hr = access_get( iface, handle, &var, NULL )) != S_OK) return hr;
+    if (V_VT( &var ) == VT_NULL) *value = 0;
+    else if (FAILED(hr = VariantChangeType( &var, &var, 0, VT_UI4 ))) { VariantClear( &var ); return WBEM_E_TYPE_MISMATCH; }
+    else *value = V_UI4( &var );
+    VariantClear( &var );
+    return S_OK;
+}
+
+static HRESULT WINAPI object_access_ReadQWORD( IWbemObjectAccess *iface, LONG handle, UINT64 *value )
+{
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %p\n", iface, handle, value );
+    if (!value) return WBEM_E_INVALID_PARAMETER;
+    if ((hr = access_get( iface, handle, &var, NULL )) != S_OK) return hr;
+    if (V_VT( &var ) == VT_NULL) *value = 0;
+    else if (V_VT( &var ) == VT_BSTR) *value = wcstoull( V_BSTR( &var ), NULL, 10 );  /* uint64 comes as a string */
+    else if (FAILED(hr = VariantChangeType( &var, &var, 0, VT_UI8 ))) { VariantClear( &var ); return WBEM_E_TYPE_MISMATCH; }
+    else *value = V_UI8( &var );
+    VariantClear( &var );
+    return S_OK;
+}
+
+static HRESULT WINAPI object_access_WriteDWORD( IWbemObjectAccess *iface, LONG handle, DWORD value )
+{
+    VARIANT var;
+
+    TRACE( "%p, %ld, %lu\n", iface, handle, value );
+    V_VT( &var ) = VT_I4;
+    V_I4( &var ) = value;
+    return access_put( iface, handle, &var );
+}
+
+static HRESULT WINAPI object_access_WriteQWORD( IWbemObjectAccess *iface, LONG handle, UINT64 value )
+{
+    WCHAR buf[24];
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %s\n", iface, handle, wine_dbgstr_longlong(value) );
+    swprintf( buf, ARRAY_SIZE(buf), L"%I64u", value );
+    V_VT( &var ) = VT_BSTR;
+    if (!(V_BSTR( &var ) = SysAllocString( buf ))) return E_OUTOFMEMORY;
+    hr = access_put( iface, handle, &var );
+    VariantClear( &var );
+    return hr;
+}
+
+static HRESULT WINAPI object_access_ReadPropertyValue( IWbemObjectAccess *iface, LONG handle, LONG size, LONG *read, BYTE *data )
+{
+    CIMTYPE type;
+    VARIANT var;
+    HRESULT hr;
+    LONG need;
+
+    TRACE( "%p, %ld, %ld, %p, %p\n", iface, handle, size, read, data );
+    if (!read) return WBEM_E_INVALID_PARAMETER;
+    if ((hr = access_get( iface, handle, &var, &type )) != S_OK) return hr;
+    switch (type)
+    {
+    case CIM_STRING:
+    case CIM_DATETIME:
+    case CIM_REFERENCE:
+        need = V_VT( &var ) == VT_BSTR ? (SysStringLen( V_BSTR( &var ) ) + 1) * sizeof(WCHAR) : sizeof(WCHAR);
+        *read = need;
+        if (size < need) { VariantClear( &var ); return WBEM_E_BUFFER_TOO_SMALL; }
+        if (V_VT( &var ) == VT_BSTR) memcpy( data, V_BSTR( &var ), need );
+        else *(WCHAR *)data = 0;
+        break;
+    case CIM_SINT64:
+    case CIM_UINT64:
+    {
+        UINT64 value = 0;
+        VariantClear( &var );
+        if ((hr = object_access_ReadQWORD( iface, handle, &value )) != S_OK) return hr;
+        *read = sizeof(value);
+        if (size < (LONG)sizeof(value)) return WBEM_E_BUFFER_TOO_SMALL;
+        memcpy( data, &value, sizeof(value) );
+        return S_OK;
+    }
+    case CIM_BOOLEAN:
+    case CIM_SINT8: case CIM_UINT8: case CIM_SINT16: case CIM_UINT16:
+    case CIM_SINT32: case CIM_UINT32: case CIM_REAL32: case CIM_REAL64:
+    {
+        LONG len = (type == CIM_SINT8 || type == CIM_UINT8) ? 1 :
+                   (type == CIM_SINT16 || type == CIM_UINT16 || type == CIM_BOOLEAN) ? 2 :
+                   (type == CIM_REAL64) ? 8 : 4;
+        VARTYPE vt = type == CIM_REAL32 ? VT_R4 : type == CIM_REAL64 ? VT_R8 : VT_I8;
+        LONGLONG integer = 0;
+
+        *read = len;
+        if (size < len) { VariantClear( &var ); return WBEM_E_BUFFER_TOO_SMALL; }
+        if (V_VT( &var ) != VT_NULL && FAILED(VariantChangeType( &var, &var, 0, vt )))
+        {
+            VariantClear( &var );
+            return WBEM_E_TYPE_MISMATCH;
+        }
+        if (vt == VT_R4) memcpy( data, V_VT( &var ) == VT_NULL ? &integer : (void *)&V_R4( &var ), 4 );
+        else if (vt == VT_R8) memcpy( data, V_VT( &var ) == VT_NULL ? &integer : (void *)&V_R8( &var ), 8 );
+        else
+        {
+            if (V_VT( &var ) != VT_NULL) integer = V_I8( &var );
+            if (type == CIM_BOOLEAN) integer = integer ? 0xffff : 0;
+            memcpy( data, &integer, len );
+        }
+        break;
+    }
+    default:
+        VariantClear( &var );
+        return WBEM_E_NOT_SUPPORTED;
+    }
+    VariantClear( &var );
+    return S_OK;
+}
+
+static HRESULT WINAPI object_access_WritePropertyValue( IWbemObjectAccess *iface, LONG handle, LONG size, const BYTE *data )
+{
+    CIMTYPE type;
+    VARIANT var;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %ld, %p\n", iface, handle, size, data );
+    if ((hr = access_column( impl_from_IWbemObjectAccess( iface ), handle, NULL, &type )) != S_OK) return hr;
+    VariantInit( &var );
+    switch (type)
+    {
+    case CIM_STRING:
+    case CIM_DATETIME:
+    case CIM_REFERENCE:
+    {
+        UINT len = size > 0 ? size / sizeof(WCHAR) : 0;
+
+        if (len && !((const WCHAR *)data)[len - 1]) len--;  /* without its terminator */
+        V_VT( &var ) = VT_BSTR;
+        if (!(V_BSTR( &var ) = SysAllocStringLen( (const WCHAR *)data, len ))) return E_OUTOFMEMORY;
+        break;
+    }
+    case CIM_SINT64:
+    case CIM_UINT64:
+        if (size < 8) return WBEM_E_INVALID_PARAMETER;
+        return object_access_WriteQWORD( iface, handle, *(const UINT64 *)data );
+    default:
+        if (size < 4) return WBEM_E_INVALID_PARAMETER;
+        return object_access_WriteDWORD( iface, handle, *(const DWORD *)data );
+    }
+    hr = access_put( iface, handle, &var );
+    VariantClear( &var );
+    return hr;
+}
+
+static HRESULT WINAPI object_access_Lock( IWbemObjectAccess *iface, LONG flags )
+{
+    TRACE( "%p, %#lx\n", iface, flags );
+    return flags ? WBEM_E_INVALID_PARAMETER : S_OK;
+}
+
+static HRESULT WINAPI object_access_Unlock( IWbemObjectAccess *iface, LONG flags )
+{
+    TRACE( "%p, %#lx\n", iface, flags );
+    return flags ? WBEM_E_INVALID_PARAMETER : S_OK;
+}
+
+/* a refresher's refresh: OBJ shows what FRESH (an instance just read, of the same class) shows */
+HRESULT class_object_take( IWbemClassObject *obj, IWbemClassObject *fresh )
+{
+    struct class_object *co, *from;
+    struct record *record = NULL;
+
+    if (!obj || !fresh || obj->lpVtbl != (const IWbemClassObjectVtbl *)&class_object_vtbl ||
+        fresh->lpVtbl != (const IWbemClassObjectVtbl *)&class_object_vtbl) return WBEM_E_INVALID_PARAMETER;
+    co = impl_from_IWbemClassObject( obj );
+    from = impl_from_IWbemClassObject( fresh );
+    if (from->record && !(record = copy_record( from->record ))) return E_OUTOFMEMORY;
+    if (from->iter) IEnumWbemClassObject_AddRef( from->iter );
+    if (co->iter) IEnumWbemClassObject_Release( co->iter );
+    destroy_record( co->record );
+    co->iter = from->iter;
+    co->index = from->index;
+    co->record = record;
+    return S_OK;
+}
+
+static const IWbemObjectAccessVtbl class_object_vtbl =
+{
+    (void *)class_object_QueryInterface,
+    (void *)class_object_AddRef,
+    (void *)class_object_Release,
+    (void *)class_object_GetQualifierSet,
+    (void *)class_object_Get,
+    (void *)class_object_Put,
+    (void *)class_object_Delete,
+    (void *)class_object_GetNames,
+    (void *)class_object_BeginEnumeration,
+    (void *)class_object_Next,
+    (void *)class_object_EndEnumeration,
+    (void *)class_object_GetPropertyQualifierSet,
+    (void *)class_object_Clone,
+    (void *)class_object_GetObjectText,
+    (void *)class_object_SpawnDerivedClass,
+    (void *)class_object_SpawnInstance,
+    (void *)class_object_CompareTo,
+    (void *)class_object_GetPropertyOrigin,
+    (void *)class_object_InheritsFrom,
+    (void *)class_object_GetMethod,
+    (void *)class_object_PutMethod,
+    (void *)class_object_DeleteMethod,
+    (void *)class_object_BeginMethodEnumeration,
+    (void *)class_object_NextMethod,
+    (void *)class_object_EndMethodEnumeration,
+    (void *)class_object_GetMethodQualifierSet,
+    (void *)class_object_GetMethodOrigin,
+    object_access_GetPropertyHandle,
+    object_access_WritePropertyValue,
+    object_access_ReadPropertyValue,
+    object_access_ReadDWORD,
+    object_access_WriteDWORD,
+    object_access_ReadQWORD,
+    object_access_WriteQWORD,
+    object_access_GetPropertyInfoByHandle,
+    object_access_Lock,
+    object_access_Unlock
 };
 
 HRESULT create_class_object( enum wbm_namespace ns, const WCHAR *name, IEnumWbemClassObject *iter, UINT index,
@@ -1620,7 +1886,7 @@ HRESULT create_class_object( enum wbm_namespace ns, const WCHAR *name, IEnumWbem
 
     if (!(co = malloc( sizeof(*co) ))) return E_OUTOFMEMORY;
 
-    co->IWbemClassObject_iface.lpVtbl = &class_object_vtbl;
+    co->IWbemClassObject_iface.lpVtbl = (const IWbemClassObjectVtbl *)&class_object_vtbl;
     co->refs  = 1;
     InterlockedIncrement( &object_count );
     if (!name) co->name = NULL;
diff --git a/dlls/wbemprox/main.c b/dlls/wbemprox/main.c
index c146ce8..529bba3 100644
--- a/dlls/wbemprox/main.c
+++ b/dlls/wbemprox/main.c
@@ -111,6 +111,7 @@ static const struct IClassFactoryVtbl wbemprox_cf_vtbl =
 
 static wbemprox_cf wbem_locator_cf = { { &wbemprox_cf_vtbl }, WbemLocator_create };
 static wbemprox_cf wbem_context_cf = { { &wbemprox_cf_vtbl }, WbemContext_create };
+static wbemprox_cf wbem_refresher_cf = { { &wbemprox_cf_vtbl }, WbemRefresher_create };
 
 BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
 {
@@ -147,6 +148,12 @@ HRESULT WINAPI DllGetClassObject( REFCLSID rclsid, REFIID iid, LPVOID *ppv )
