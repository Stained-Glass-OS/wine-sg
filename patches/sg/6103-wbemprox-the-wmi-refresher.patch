+/* Stained Glass OS (wine-sg 6103): the WMI refresher. CPU-Z, performance monitors and hardware
+ * tools create one (CLSID_WbemRefresher) to read the same objects or the instances of a class
+ * again and again; it was not registered, and CPU-Z, which does not check, crashed at start.
+ * Objects added by path or template are refreshed in place (they show what a fresh read of the
+ * same path shows); an enumerator added for a class holds the class's instances, read again at
+ * each Refresh. */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "wbemcli.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "wbemprox_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wbemprox);
+
+struct hiperf_enum
+{
+    IWbemHiPerfEnum IWbemHiPerfEnum_iface;
+    LONG refs;
+    CRITICAL_SECTION cs;
+    IWbemObjectAccess **objects;
+    LONG *ids;
+    ULONG count;
+    LONG next_id;
+};
+
+struct refresher_item
+{
+    struct list entry;
+    LONG id;
+    IWbemServices *services;
+    BSTR path;                   /* an object's path, or an enumerator's class */
+    IWbemClassObject *object;    /* refreshed in place */
+    struct hiperf_enum *hiperf;  /* or an enumerator */
+};
+
+struct refresher
+{
+    IWbemRefresher IWbemRefresher_iface;
+    IWbemConfigureRefresher IWbemConfigureRefresher_iface;
+    LONG refs;
+    CRITICAL_SECTION cs;
+    struct list items;
+    LONG next_id;
+};
+
+static inline struct hiperf_enum *impl_from_IWbemHiPerfEnum( IWbemHiPerfEnum *iface )
+{
+    return CONTAINING_RECORD( iface, struct hiperf_enum, IWbemHiPerfEnum_iface );
+}
+
+static inline struct refresher *impl_from_IWbemRefresher( IWbemRefresher *iface )
+{
+    return CONTAINING_RECORD( iface, struct refresher, IWbemRefresher_iface );
+}
+
+static inline struct refresher *impl_from_IWbemConfigureRefresher( IWbemConfigureRefresher *iface )
+{
+    return CONTAINING_RECORD( iface, struct refresher, IWbemConfigureRefresher_iface );
+}
+
+static void hiperf_clear( struct hiperf_enum *he )
+{
+    ULONG i;
+    for (i = 0; i < he->count; i++) IWbemObjectAccess_Release( he->objects[i] );
+    free( he->objects );
+    free( he->ids );
+    he->objects = NULL;
+    he->ids = NULL;
+    he->count = 0;
+}
+
+static HRESULT hiperf_add( struct hiperf_enum *he, IWbemObjectAccess *obj, LONG id )
+{
+    IWbemObjectAccess **objects;
+    LONG *ids;
+
+    if (!(objects = realloc( he->objects, (he->count + 1) * sizeof(*objects) ))) return E_OUTOFMEMORY;
+    he->objects = objects;
+    if (!(ids = realloc( he->ids, (he->count + 1) * sizeof(*ids) ))) return E_OUTOFMEMORY;
+    he->ids = ids;
+    IWbemObjectAccess_AddRef( obj );
+    he->objects[he->count] = obj;
+    he->ids[he->count] = id;
+    he->count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI hiperf_enum_QueryInterface( IWbemHiPerfEnum *iface, REFIID riid, void **obj )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid( riid ), obj );
+    if (IsEqualGUID( riid, &IID_IWbemHiPerfEnum ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = &he->IWbemHiPerfEnum_iface;
+        IWbemHiPerfEnum_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI hiperf_enum_AddRef( IWbemHiPerfEnum *iface )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+    return InterlockedIncrement( &he->refs );
+}
+
+static ULONG WINAPI hiperf_enum_Release( IWbemHiPerfEnum *iface )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+    LONG refs = InterlockedDecrement( &he->refs );
+
+    if (!refs)
+    {
+        hiperf_clear( he );
+        he->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &he->cs );
+        free( he );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI hiperf_enum_AddObjects( IWbemHiPerfEnum *iface, LONG flags, ULONG count, LONG *ids,
+                                              IWbemObjectAccess **objects )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+    HRESULT hr = S_OK;
+    ULONG i;
+
+    TRACE( "%p, %#lx, %lu, %p, %p\n", iface, flags, count, ids, objects );
+    if (flags || (count && (!ids || !objects))) return WBEM_E_INVALID_PARAMETER;
+    EnterCriticalSection( &he->cs );
+    for (i = 0; i < count && hr == S_OK; i++) hr = hiperf_add( he, objects[i], ids[i] );
+    LeaveCriticalSection( &he->cs );
+    return hr;
+}
+
+static HRESULT WINAPI hiperf_enum_RemoveObjects( IWbemHiPerfEnum *iface, LONG flags, ULONG count, LONG *ids )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+    ULONG i, j;
+
+    TRACE( "%p, %#lx, %lu, %p\n", iface, flags, count, ids );
+    if (flags || (count && !ids)) return WBEM_E_INVALID_PARAMETER;
+    EnterCriticalSection( &he->cs );
+    for (i = 0; i < count; i++)
+        for (j = 0; j < he->count; j++)
+        {
+            if (he->ids[j] != ids[i]) continue;
+            IWbemObjectAccess_Release( he->objects[j] );
+            memmove( he->objects + j, he->objects + j + 1, (he->count - j - 1) * sizeof(*he->objects) );
+            memmove( he->ids + j, he->ids + j + 1, (he->count - j - 1) * sizeof(*he->ids) );
+            he->count--;
+            break;
+        }
+    LeaveCriticalSection( &he->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI hiperf_enum_GetObjects( IWbemHiPerfEnum *iface, LONG flags, ULONG count,
+                                              IWbemObjectAccess **objects, ULONG *returned )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+    HRESULT hr = S_OK;
+    ULONG i;
+
+    TRACE( "%p, %#lx, %lu, %p, %p\n", iface, flags, count, objects, returned );
+    if (flags || !returned || (count && !objects)) return WBEM_E_INVALID_PARAMETER;
+    EnterCriticalSection( &he->cs );
+    *returned = he->count;
+    if (count < he->count) hr = WBEM_E_BUFFER_TOO_SMALL;
+    else
+        for (i = 0; i < he->count; i++)
+        {
+            objects[i] = he->objects[i];
+            IWbemObjectAccess_AddRef( objects[i] );
+        }
+    LeaveCriticalSection( &he->cs );
+    return hr;
+}
+
+static HRESULT WINAPI hiperf_enum_RemoveAll( IWbemHiPerfEnum *iface, LONG flags )
+{
+    struct hiperf_enum *he = impl_from_IWbemHiPerfEnum( iface );
+
+    TRACE( "%p, %#lx\n", iface, flags );
+    if (flags) return WBEM_E_INVALID_PARAMETER;
+    EnterCriticalSection( &he->cs );
+    hiperf_clear( he );
+    LeaveCriticalSection( &he->cs );
+    return S_OK;
+}
+
+static const IWbemHiPerfEnumVtbl hiperf_enum_vtbl =
+{
+    hiperf_enum_QueryInterface,
+    hiperf_enum_AddRef,
+    hiperf_enum_Release,
+    hiperf_enum_AddObjects,
+    hiperf_enum_RemoveObjects,
+    hiperf_enum_GetObjects,
+    hiperf_enum_RemoveAll,
+};
+
+static HRESULT hiperf_enum_create( struct hiperf_enum **ret )
+{
+    struct hiperf_enum *he;
+
+    if (!(he = calloc( 1, sizeof(*he) ))) return E_OUTOFMEMORY;
+    he->IWbemHiPerfEnum_iface.lpVtbl = &hiperf_enum_vtbl;
+    he->refs = 1;
+    InitializeCriticalSectionEx( &he->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    he->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": hiperf_enum.cs");
+    *ret = he;
+    return S_OK;
+}
+
+/* the class's instances now, in place of what the enumerator held */
+static HRESULT hiperf_fill( struct hiperf_enum *he, IWbemServices *services, BSTR class )
+{
+    IEnumWbemClassObject *iter;
+    IWbemClassObject *obj;
+    IWbemObjectAccess *access;
+    ULONG got;
+    HRESULT hr;
+
+    if (FAILED(hr = IWbemServices_CreateInstanceEnum( services, class, WBEM_FLAG_FORWARD_ONLY, NULL, &iter )))
+        return hr;
+    EnterCriticalSection( &he->cs );
+    hiperf_clear( he );
+    while (IEnumWbemClassObject_Next( iter, WBEM_INFINITE, 1, &obj, &got ) == S_OK && got)
+    {
+        if (SUCCEEDED(IWbemClassObject_QueryInterface( obj, &IID_IWbemObjectAccess, (void **)&access )))
+        {
+            hiperf_add( he, access, he->next_id++ );
+            IWbemObjectAccess_Release( access );
+        }
+        IWbemClassObject_Release( obj );
+    }
+    LeaveCriticalSection( &he->cs );
+    IEnumWbemClassObject_Release( iter );
+    return S_OK;
+}
+
+static void free_item( struct refresher_item *item )
+{
+    if (item->services) IWbemServices_Release( item->services );
+    if (item->object) IWbemClassObject_Release( item->object );
+    if (item->hiperf) IWbemHiPerfEnum_Release( &item->hiperf->IWbemHiPerfEnum_iface );
+    SysFreeString( item->path );
+    free( item );
+}
+
+static HRESULT WINAPI refresher_QueryInterface( IWbemRefresher *iface, REFIID riid, void **obj )
+{
+    struct refresher *r = impl_from_IWbemRefresher( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid( riid ), obj );
+    if (IsEqualGUID( riid, &IID_IWbemRefresher ) || IsEqualGUID( riid, &IID_IUnknown ))
+        *obj = &r->IWbemRefresher_iface;
+    else if (IsEqualGUID( riid, &IID_IWbemConfigureRefresher ))
+        *obj = &r->IWbemConfigureRefresher_iface;
+    else
+    {
+        WARN( "interface %s not implemented\n", debugstr_guid( riid ) );
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IWbemRefresher_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI refresher_AddRef( IWbemRefresher *iface )
+{
+    struct refresher *r = impl_from_IWbemRefresher( iface );
+    return InterlockedIncrement( &r->refs );
+}
+
+static ULONG WINAPI refresher_Release( IWbemRefresher *iface )
+{
+    struct refresher *r = impl_from_IWbemRefresher( iface );
+    LONG refs = InterlockedDecrement( &r->refs );
+
+    if (!refs)
+    {
+        struct refresher_item *item, *next;
+
+        LIST_FOR_EACH_ENTRY_SAFE( item, next, &r->items, struct refresher_item, entry )
+        {
+            list_remove( &item->entry );
+            free_item( item );
+        }
+        r->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &r->cs );
+        free( r );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI refresher_Refresh( IWbemRefresher *iface, LONG flags )
+{
+    struct refresher *r = impl_from_IWbemRefresher( iface );
+    struct refresher_item *item;
+    IWbemClassObject *fresh;
+
+    TRACE( "%p, %#lx\n", iface, flags );
+    EnterCriticalSection( &r->cs );
+    LIST_FOR_EACH_ENTRY( item, &r->items, struct refresher_item, entry )
+    {
+        if (item->hiperf) hiperf_fill( item->hiperf, item->services, item->path );
+        else if (SUCCEEDED(IWbemServices_GetObject( item->services, item->path, 0, NULL, &fresh, NULL )))
+        {
+            class_object_take( item->object, fresh );
+            IWbemClassObject_Release( fresh );
+        }
+    }
+    LeaveCriticalSection( &r->cs );
+    return S_OK;
+}
+
+static const IWbemRefresherVtbl refresher_vtbl =
+{
+    refresher_QueryInterface,
+    refresher_AddRef,
+    refresher_Release,
+    refresher_Refresh,
+};
+
+static HRESULT WINAPI configure_QueryInterface( IWbemConfigureRefresher *iface, REFIID riid, void **obj )
+{
+    struct refresher *r = impl_from_IWbemConfigureRefresher( iface );
+    return IWbemRefresher_QueryInterface( &r->IWbemRefresher_iface, riid, obj );
+}
+
+static ULONG WINAPI configure_AddRef( IWbemConfigureRefresher *iface )
+{
+    struct refresher *r = impl_from_IWbemConfigureRefresher( iface );
+    return IWbemRefresher_AddRef( &r->IWbemRefresher_iface );
+}
+
+static ULONG WINAPI configure_Release( IWbemConfigureRefresher *iface )
+{
+    struct refresher *r = impl_from_IWbemConfigureRefresher( iface );
+    return IWbemRefresher_Release( &r->IWbemRefresher_iface );
+}
+
+static void add_item( struct refresher *r, struct refresher_item *item, LONG *id )
+{
+    EnterCriticalSection( &r->cs );
+    item->id = r->next_id++;
+    list_add_tail( &r->items, &item->entry );
+    LeaveCriticalSection( &r->cs );
+    if (id) *id = item->id;
+}
+
+static HRESULT WINAPI configure_AddObjectByPath( IWbemConfigureRefresher *iface, IWbemServices *services,
+                                                 LPCWSTR path, LONG flags, IWbemContext *context,
+                                                 IWbemClassObject **refreshable, LONG *id )
+{
+    struct refresher *r = impl_from_IWbemConfigureRefresher( iface );
+    struct refresher_item *item;
+    IWbemClassObject *obj;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %s, %#lx, %p, %p, %p\n", iface, services, debugstr_w(path), flags, context, refreshable, id );
+    if (!services || !path || !refreshable) return WBEM_E_INVALID_PARAMETER;
+    if (FAILED(hr = IWbemServices_GetObject( services, (BSTR)path, 0, NULL, &obj, NULL ))) return hr;
+    if (!(item = calloc( 1, sizeof(*item) )) || !(item->path = SysAllocString( path )))
+    {
+        free( item );
+        IWbemClassObject_Release( obj );
+        return E_OUTOFMEMORY;
+    }
+    IWbemServices_AddRef( services );
+    item->services = services;
+    item->object = obj;
+    IWbemClassObject_AddRef( obj );
+    *refreshable = obj;
+    add_item( r, item, id );
+    return S_OK;
+}
+
+static HRESULT WINAPI configure_AddObjectByTemplate( IWbemConfigureRefresher *iface, IWbemServices *services,
+                                                     IWbemClassObject *template, LONG flags, IWbemContext *context,
+                                                     IWbemClassObject **refreshable, LONG *id )
+{
+    VARIANT path;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %p, %#lx, %p, %p, %p\n", iface, services, template, flags, context, refreshable, id );
+    if (!template) return WBEM_E_INVALID_PARAMETER;
+    VariantInit( &path );
+    if (FAILED(hr = IWbemClassObject_Get( template, L"__RELPATH", 0, &path, NULL, NULL ))) return hr;
+    if (V_VT( &path ) != VT_BSTR) hr = WBEM_E_INVALID_OBJECT;
+    else hr = configure_AddObjectByPath( iface, services, V_BSTR( &path ), flags, context, refreshable, id );
+    VariantClear( &path );
+    return hr;
+}
+
+static HRESULT WINAPI configure_AddRefresher( IWbemConfigureRefresher *iface, IWbemRefresher *refresher,
+                                              LONG flags, LONG *id )
+{
+    FIXME( "%p, %p, %#lx, %p: refreshers within refreshers\n", iface, refresher, flags, id );
+    return WBEM_E_NOT_SUPPORTED;
+}
+
+static HRESULT WINAPI configure_Remove( IWbemConfigureRefresher *iface, LONG id, LONG flags )
+{
+    struct refresher *r = impl_from_IWbemConfigureRefresher( iface );
+    struct refresher_item *item;
+    HRESULT hr = WBEM_E_NOT_FOUND;
+
+    TRACE( "%p, %ld, %#lx\n", iface, id, flags );
+    EnterCriticalSection( &r->cs );
+    LIST_FOR_EACH_ENTRY( item, &r->items, struct refresher_item, entry )
+    {
+        if (item->id != id) continue;
+        list_remove( &item->entry );
+        free_item( item );
+        hr = S_OK;
+        break;
+    }
+    LeaveCriticalSection( &r->cs );
+    return hr;
+}
+
+static HRESULT WINAPI configure_AddEnum( IWbemConfigureRefresher *iface, IWbemServices *services, LPCWSTR class,
+                                         LONG flags, IWbemContext *context, IWbemHiPerfEnum **ret, LONG *id )
+{
+    struct refresher *r = impl_from_IWbemConfigureRefresher( iface );
+    struct refresher_item *item;
+    struct hiperf_enum *he;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %s, %#lx, %p, %p, %p\n", iface, services, debugstr_w(class), flags, context, ret, id );
+    if (!services || !class || !ret) return WBEM_E_INVALID_PARAMETER;
+    if (FAILED(hr = hiperf_enum_create( &he ))) return hr;
+    if (!(item = calloc( 1, sizeof(*item) )) || !(item->path = SysAllocString( class )))
+    {
+        free( item );
+        IWbemHiPerfEnum_Release( &he->IWbemHiPerfEnum_iface );
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = hiperf_fill( he, services, item->path )))
+    {
+        SysFreeString( item->path );
+        free( item );
+        IWbemHiPerfEnum_Release( &he->IWbemHiPerfEnum_iface );
+        return hr == WBEM_E_NOT_FOUND ? WBEM_E_INVALID_CLASS : hr;
+    }
+    IWbemServices_AddRef( services );
+    item->services = services;
+    item->hiperf = he;
+    IWbemHiPerfEnum_AddRef( &he->IWbemHiPerfEnum_iface );
+    *ret = &he->IWbemHiPerfEnum_iface;
+    add_item( r, item, id );
+    return S_OK;
+}
+
+static const IWbemConfigureRefresherVtbl configure_vtbl =
+{
+    configure_QueryInterface,
+    configure_AddRef,
+    configure_Release,
+    configure_AddObjectByPath,
+    configure_AddObjectByTemplate,
+    configure_AddRefresher,
+    configure_Remove,
+    configure_AddEnum,
+};
+
+HRESULT WbemRefresher_create( void **obj, REFIID riid )
+{
+    struct refresher *r;
+    HRESULT hr;
+
+    TRACE( "%p, %s\n", obj, debugstr_guid( riid ) );
+    if (!(r = calloc( 1, sizeof(*r) ))) return E_OUTOFMEMORY;
+    r->IWbemRefresher_iface.lpVtbl = &refresher_vtbl;
+    r->IWbemConfigureRefresher_iface.lpVtbl = &configure_vtbl;
+    r->refs = 1;
+    list_init( &r->items );
+    InitializeCriticalSectionEx( &r->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    r->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": refresher.cs");
+    hr = IWbemRefresher_QueryInterface( &r->IWbemRefresher_iface, riid, obj );
+    IWbemRefresher_Release( &r->IWbemRefresher_iface );
+    return hr;
+}
