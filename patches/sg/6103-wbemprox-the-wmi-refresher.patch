+    }
+#endif
     if (!cf) return CLASS_E_CLASSNOTAVAILABLE;
     return IClassFactory_QueryInterface( cf, iid, ppv );
 }
diff --git a/dlls/wbemprox/refresher.c b/dlls/wbemprox/refresher.c
new file mode 100644
index 0000000..5e55937
--- /dev/null
+++ b/dlls/wbemprox/refresher.c
@@ -0,0 +1,517 @@
