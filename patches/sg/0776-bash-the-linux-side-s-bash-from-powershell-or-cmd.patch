From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bash: the Linux side's bash, from PowerShell or cmd

David 2026-10-03: "a way to enter bash from PowerShell" (and PowerShell from
bash: sg-session's powershell). bash.exe, in system32 so any console finds it
by name, runs the Unix /bin/bash as the same account, in the same console and
folder, with the arguments as given (quoted as CommandLineToArgvW reads them
back; none: a login shell), and gives back its exit status. Wine starts a
Unix program by its path but gives its process no exit code of its own and
signals its handle at once: sh records the shell's process id and bash's
status in /tmp, and this waits for the status or for the shell to be gone.

An interactive bash inside an interactive PowerShell shares the terminal
with Wine's console, which reads it too: commands and scripts work, typing
into that inner bash does not (yet).

Test: test/linuxbash-gate.sh (mutant SG_MUTANT_BASH_NO_STATUS).
---
--- a/configure
+++ b/configure
@@ -1661,6 +1661,7 @@
 enable_arp
 enable_aspnet_regiis
 enable_attrib
+enable_bash
 enable_cabarc
 enable_cacls
 enable_calc
@@ -23118,6 +23119,7 @@
 wine_fn_config_makefile programs/arp enable_arp
 wine_fn_config_makefile programs/aspnet_regiis enable_aspnet_regiis
 wine_fn_config_makefile programs/attrib enable_attrib
+wine_fn_config_makefile programs/bash enable_bash
 wine_fn_config_makefile programs/cabarc enable_cabarc
 wine_fn_config_makefile programs/cacls enable_cacls
 wine_fn_config_makefile programs/calc enable_calc
--- a/configure.ac
+++ b/configure.ac
@@ -3439,6 +3439,7 @@
 WINE_CONFIG_MAKEFILE(programs/arp)
 WINE_CONFIG_MAKEFILE(programs/aspnet_regiis)
 WINE_CONFIG_MAKEFILE(programs/attrib)
+WINE_CONFIG_MAKEFILE(programs/bash)
 WINE_CONFIG_MAKEFILE(programs/cabarc)
 WINE_CONFIG_MAKEFILE(programs/cacls)
 WINE_CONFIG_MAKEFILE(programs/calc)
--- a/programs/bash/Makefile.in
+++ b/programs/bash/Makefile.in
@@ -0,0 +1,6 @@
+MODULE    = bash.exe
+
+EXTRADLLFLAGS = -mconsole -municode
+
+SOURCES = \
+	main.c
--- a/programs/bash/main.c
+++ b/programs/bash/main.c
@@ -0,0 +1,86 @@
+/*
+ * bash: the Linux side's bash, from PowerShell or cmd (Stained Glass OS)
+ *
+ * David 2026-10-03: "a way to enter bash from PowerShell". This runs the
+ * Unix /bin/bash as the same account, in the same console and folder, with
+ * the arguments given (none: a login shell), and gives back its exit status.
+ * Wine starts a Unix program by its path, but gives its process no exit code
+ * of its own and signals its handle at once: sh records the shell's process id
+ * and bash's status in /tmp, and this waits for the status or for the shell
+ * to be gone.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+#include <windows.h>
+#include <stdio.h>
+int wmain(int argc, WCHAR **argv)
+{
+    WCHAR cmd[32768], rcfile[64], dosrc[80], dospid[80];
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD code = 1;
+    int i;
+    /* bash's exit status: Wine gives a Unix program's process no exit code of
+     * its own, so sh writes it where this reads it back */
+    swprintf(rcfile, 64, L"/tmp/.sg-bash-%lu-%lu", GetCurrentProcessId(), GetTickCount());
+    swprintf(dosrc, 80, L"Z:%ls", rcfile);
+    for (i = 2; dosrc[i]; i++) if (dosrc[i] == '/') dosrc[i] = '\\';
+    swprintf(dospid, 80, L"%ls.pid", dosrc);
+    /* and its process id: Wine's handle on a Unix program is signalled at once,
+     * so this waits for the status, or for the shell to be gone */
+    swprintf(cmd, 32768, L"Z:\\bin\\sh -c \"echo $$ > %ls.pid; bash \\\"$@\\\"; echo $? > %ls.tmp && mv %ls.tmp %ls\" bash",
+             rcfile, rcfile, rcfile, rcfile);
+    if (argc == 1) wcscat(cmd, L" -l");
+    for (i = 1; i < argc; i++) {   /* quoted as CommandLineToArgvW reads it back */
+        WCHAR *o = cmd + wcslen(cmd), *end = cmd + 32700;
+        const WCHAR *a = argv[i];
+        *o++ = ' '; *o++ = '"';
+        while (*a && o < end) {
+            int bs = 0;
+            while (*a == '\\') { bs++; a++; }
+            if (!*a) { while (bs-- && o < end) { *o++ = '\\'; *o++ = '\\'; } break; }
+            if (*a == '"') { while (bs-- && o < end) { *o++ = '\\'; *o++ = '\\'; } *o++ = '\\'; *o++ = '"'; a++; }
+            else { while (bs-- && o < end) *o++ = '\\'; *o++ = *a++; }
+        }
+        *o++ = '"'; *o = 0;
+    }
+    si.dwFlags = STARTF_USESTDHANDLES;
+    si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    si.hStdOutput = GetStdHandle(STD_OUTPUT_HANDLE);
+    si.hStdError = GetStdHandle(STD_ERROR_HANDLE);
+    if (!CreateProcessW(NULL, cmd, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) { fwprintf(stderr, L"bash: %lu\n", GetLastError()); return 127; }
+    WaitForSingleObject(pi.hProcess, INFINITE);
+#ifndef SG_MUTANT_BASH_NO_STATUS
+    for (;;) {
+        FILE *f = _wfopen(dosrc, L"r");
+        int rc;
+        unsigned long pid = 0;
+        WCHAR proc[40];
+        if (f) { if (fscanf(f, "%d", &rc) == 1) code = rc; fclose(f); break; }
+        if ((f = _wfopen(dospid, L"r"))) {
+            if (fscanf(f, "%lu", &pid) != 1) pid = 0;
+            fclose(f);
+            swprintf(proc, 40, L"Z:\\proc\\%lu", pid);
+            if (pid && GetFileAttributesW(proc) == INVALID_FILE_ATTRIBUTES) { code = 1; break; }
+        }
+        Sleep(50);
+    }
+#endif
+    DeleteFileW(dosrc);
+    DeleteFileW(dospid);
+    return (int)code;
+}
