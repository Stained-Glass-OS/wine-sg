From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: ConfigStream Seek/SetSize/Commit/Revert/Clone are E_NOTIMPL (3648)

mscoree: ConfigStream Seek, SetSize, Commit, Revert and Clone are E_NOTIMPL again

Patches 3598/3620/3642 implemented them, but dlls/mscoree/tests/mscoree.c checks (without
todo_wine, so on Windows too) that they return E_NOTIMPL.  The conformance test had not been
run with the builtin mscoree.  CopyTo, Stat and LockRegion stay as implemented (untested).
---
diff --git a/dlls/mscoree/config.c b/dlls/mscoree/config.c
index 29a943b..0a1a8d5 100644
--- a/dlls/mscoree/config.c
+++ b/dlls/mscoree/config.c
@@ -145,34 +145,19 @@ static HRESULT WINAPI ConfigStream_Seek(IStream *iface, LARGE_INTEGER dlibMove,
                                         DWORD dwOrigin, ULARGE_INTEGER *pNewPos)
 {
     ConfigStream *This = impl_from_IStream(iface);
-    LARGE_INTEGER pos;
-    DWORD method;
-
     TRACE("(%p)->(%I64d %ld %p)\n", This, dlibMove.QuadPart, dwOrigin, pNewPos);
-
-    switch (dwOrigin)
-    {
-    case STREAM_SEEK_SET: method = FILE_BEGIN; break;
-    case STREAM_SEEK_CUR: method = FILE_CURRENT; break;
-    case STREAM_SEEK_END: method = FILE_END; break;
-    default: return STG_E_INVALIDFUNCTION;
-    }
-
-    if (!SetFilePointerEx(This->file, dlibMove, &pos, method))
-        return STG_E_INVALIDFUNCTION;
-
-    if (pNewPos) pNewPos->QuadPart = pos.QuadPart;
+    /* Windows' stream cannot be repositioned (the Wine test in tests/mscoree.c checks this) */
 #ifdef SG_MUTANT_CONFIGSTREAM_SEEK
-    if (pNewPos) pNewPos->QuadPart = 0;
-#endif
     return S_OK;
+#endif
+    return E_NOTIMPL;
 }
+
 static HRESULT WINAPI ConfigStream_SetSize(IStream *iface, ULARGE_INTEGER libNewSize)
 {
     ConfigStream *This = impl_from_IStream(iface);
     TRACE("(%p)->(%I64u)\n", This, libNewSize.QuadPart);
-    /* the stream is a read-only view of the file */
-    return STG_E_ACCESSDENIED;
+    return E_NOTIMPL;
 }
 
 static HRESULT WINAPI ConfigStream_CopyTo(IStream *iface, IStream *stream, ULARGE_INTEGER size,
@@ -218,15 +203,13 @@ static HRESULT WINAPI ConfigStream_Commit(IStream *iface, DWORD flags)
 {
     ConfigStream *This = impl_from_IStream(iface);
     TRACE("(%p,%ld)\n", This, flags);
-    /* nothing is ever pending on a read-only stream */
-    return S_OK;
+    return E_NOTIMPL;
 }
 static HRESULT WINAPI ConfigStream_Revert(IStream *iface)
 {
     ConfigStream *This = impl_from_IStream(iface);
     TRACE("(%p)\n", This);
-    /* not a transacted stream: there is nothing to revert */
-    return S_OK;
+    return E_NOTIMPL;
 }
 
 static HRESULT WINAPI ConfigStream_LockUnlockRegion(IStream *iface, ULARGE_INTEGER libOffset,
@@ -265,34 +248,8 @@ static HRESULT WINAPI ConfigStream_Stat(IStream *iface, STATSTG *lpStat, DWORD g
 static HRESULT WINAPI ConfigStream_Clone(IStream *iface, IStream **ppstm)
 {
     ConfigStream *This = impl_from_IStream(iface);
-    ConfigStream *clone;
-    LARGE_INTEGER zero = {{0}}, pos;
-    HANDLE file;
-
     TRACE("(%p, %p)\n", This, ppstm);
-
-    if (!ppstm)
-        return STG_E_INVALIDPOINTER;
-    *ppstm = NULL;
-
-    /* the clone has its own seek pointer, starting at the current position */
-    file = ReOpenFile(This->file, GENERIC_READ, FILE_SHARE_READ, 0);
-    if (file == INVALID_HANDLE_VALUE)
-        return HRESULT_FROM_WIN32(GetLastError());
-    if (!SetFilePointerEx(This->file, zero, &pos, FILE_CURRENT) || !SetFilePointerEx(file, pos, NULL, FILE_BEGIN)
-            || !(clone = malloc(sizeof(*clone))))
-    {
-        CloseHandle(file);
-        return E_OUTOFMEMORY;
-    }
-    clone->IStream_iface.lpVtbl = This->IStream_iface.lpVtbl;
-    clone->ref = 1;
-    clone->file = file;
-#ifdef SG_MUTANT_CONFIGSTREAM_CLONEPOS
-    SetFilePointer(file, 0, NULL, FILE_BEGIN);
-#endif
-    *ppstm = &clone->IStream_iface;
-    return S_OK;
+    return E_NOTIMPL;
 }
 
 static const IStreamVtbl ConfigStreamVtbl = {
