From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: FlushPrinter

FlushPrinter, used after WritePrinter failed, sends the given buffer the way WritePrinter does (to the printer, or to the output a print processor redirected it to) and then leaves the printer idle for the given time. It was not exported. winspool.h gains it.
---
--- a/include/winspool.h
+++ b/include/winspool.h
@@ -1589,6 +1589,7 @@
 BOOL WINAPI StartPagePrinter(HANDLE hPrinter);
 BOOL WINAPI WritePrinter(HANDLE hPrinter, LPVOID pBuf, DWORD cbBuf,
 			 LPDWORD pcWritten);
+BOOL WINAPI FlushPrinter(HANDLE,LPVOID,DWORD,LPDWORD,DWORD);
 BOOL WINAPI EndPagePrinter(HANDLE hPrinter);
 BOOL WINAPI AbortPrinter(HANDLE hPrinter);
 BOOL WINAPI ReadPrinter(HANDLE hPrinter, LPVOID pBuf, DWORD cbBuf,
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -3051,6 +3051,38 @@
     return backend->fpWritePrinter(handle, buf, size, written);
 }
 
+#ifndef SG_MUTANT_NO_FLUSH_PRINTER
+/*****************************************************************************
+ *          FlushPrinter  [WINSPOOL.@]
+ *
+ * (wine-sg 8270) After a WritePrinter failure, the rest of the buffer -- whatever brings the printer out of
+ * its transient state -- is sent the same way, and the printer is then left idle for the given time.
+ */
+BOOL WINAPI FlushPrinter(HANDLE printer, void *buf, DWORD size, DWORD *written, DWORD sleep)
+{
+    DWORD done = 0;
+    BOOL ret;
+
+    TRACE("(%p, %p, %lu, %p, %lu)\n", printer, buf, size, written, sleep);
+
+    if (!written)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    ret = WritePrinter(printer, buf, size, &done);
+    *written = done;
+    if (ret && sleep) Sleep(sleep);
+    return ret;
+}
+#else
+BOOL WINAPI FlushPrinter(HANDLE printer, void *buf, DWORD size, DWORD *written, DWORD sleep)
+{
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+#endif
+
 /*****************************************************************************
  *          AddFormA  [WINSPOOL.@]
  */
--- a/dlls/winspool.drv/winspool.drv.spec
+++ b/dlls/winspool.drv/winspool.drv.spec
@@ -190,6 +190,7 @@
 @ stdcall UploadPrinterDriverPackageW(wstr wstr wstr long long ptr ptr)
 @ stub WaitForPrinterChange
 @ stdcall WritePrinter(long ptr long ptr)
+@ stdcall FlushPrinter(long ptr long ptr long)
 @ stdcall XcvDataW(long wstr ptr long ptr long ptr ptr)
 @ stdcall InstallPrinterDriverFromPackageA(str str str str long)
 @ stdcall InstallPrinterDriverFromPackageW(wstr wstr wstr wstr long)
