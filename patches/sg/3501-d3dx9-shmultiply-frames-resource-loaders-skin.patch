+HRESULT d3dx_find_resource_data(HMODULE module, const void *name, BOOL wide, void **data, DWORD *size)
+{
+    HRSRC resinfo;
+
+    if (wide)
+    {
+        if (!(resinfo = FindResourceW(module, name, (const WCHAR *)RT_RCDATA))
+                /* a bitmap resource is DIB data */
+                && !(resinfo = FindResourceW(module, name, (const WCHAR *)RT_BITMAP)))
+            return D3DXERR_INVALIDDATA;
+    }
+    else
+    {
+        if (!(resinfo = FindResourceA(module, name, (const char *)RT_RCDATA))
+                && !(resinfo = FindResourceA(module, name, (const char *)RT_BITMAP)))
+            return D3DXERR_INVALIDDATA;
+    }
+    if (FAILED(load_resource_into_memory(module, resinfo, data, size)))
+        return D3DXERR_INVALIDDATA;
+    return D3D_OK;
+}
