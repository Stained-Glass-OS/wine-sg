+HRESULT WINAPI D3DXFrameAppendChild(D3DXFRAME *parent, const D3DXFRAME *child)
+{
+    D3DXFRAME *last;
+
+    TRACE("parent %p, child %p.\n", parent, child);
+
+    if (!parent || !child)
+        return D3DERR_INVALIDCALL;
+
+    if (!(last = parent->pFrameFirstChild))
+    {
+        parent->pFrameFirstChild = (D3DXFRAME *)child;
+        return D3D_OK;
+    }
+
+    while (last->pFrameSibling)
+        last = last->pFrameSibling;
+    last->pFrameSibling = (D3DXFRAME *)child;
+
+    return D3D_OK;
+}
+
+static UINT frame_count_named_matrices(const D3DXFRAME *frame)
+{
+    UINT count = 0;
+
+    for (; frame; frame = frame->pFrameSibling)
+    {
+        if (frame->Name)
+            ++count;
+        count += frame_count_named_matrices(frame->pFrameFirstChild);
+    }
+
+    return count;
+}
+
+UINT WINAPI D3DXFrameNumNamedMatrices(const D3DXFRAME *frame_root)
+{
+    TRACE("frame_root %p.\n", frame_root);
+
+    return frame_count_named_matrices(frame_root);
+}
+
+static HRESULT frame_register_named_matrices(D3DXFRAME *frame, ID3DXAnimationController *controller)
+{
+    HRESULT hr;
+
+    for (; frame; frame = frame->pFrameSibling)
+    {
+        if (frame->Name && FAILED(hr = controller->lpVtbl->RegisterAnimationOutput(controller, frame->Name,
+                &frame->TransformationMatrix, NULL, NULL, NULL)))
+            return hr;
+        if (frame->pFrameFirstChild && FAILED(hr = frame_register_named_matrices(frame->pFrameFirstChild,
+                controller)))
+            return hr;
+    }
+
+    return D3D_OK;
+}
+
+HRESULT WINAPI D3DXFrameRegisterNamedMatrices(D3DXFRAME *frame_root, ID3DXAnimationController *controller)
+{
+    TRACE("frame_root %p, controller %p.\n", frame_root, controller);
+
+    if (!frame_root || !controller)
+        return D3DERR_INVALIDCALL;
+
+    return frame_register_named_matrices(frame_root, controller);
+}
+
+struct frame_sphere
+{
+    D3DXVECTOR3 sum, min, max;
+    DWORD count;
+    float radius;
+};
+
+/* Visits every position of the meshes under the frames; pass 0 gathers the
+ * centroid, pass 1 the largest distance from it. */
+static HRESULT frame_visit_positions(const D3DXFRAME *frame, const D3DXMATRIX *parent, struct frame_sphere *sphere,
+        const D3DXVECTOR3 *center, unsigned int pass)
+{
+    for (; frame; frame = frame->pFrameSibling)
+    {
+        D3DXMATRIX world;
+        D3DXMESHCONTAINER *container;
+        HRESULT hr;
+
+        D3DXMatrixMultiply(&world, &frame->TransformationMatrix, parent);
+
+        for (container = frame->pMeshContainer; container; container = container->pNextMeshContainer)
+        {
+            D3DVERTEXELEMENT9 decl[MAX_FVF_DECL_SIZE];
+            ID3DXBaseMesh *mesh;
+            unsigned int i, offset = 0, stride;
+            BOOL found = FALSE;
+            BYTE *vertices;
+            DWORD count;
+
+            if (container->MeshData.Type != D3DXMESHTYPE_MESH && container->MeshData.Type != D3DXMESHTYPE_PMESH)
+                continue;
+
+            mesh = (ID3DXBaseMesh *)container->MeshData.pMesh;
+            if (!mesh || FAILED(hr = mesh->lpVtbl->GetDeclaration(mesh, decl)))
+                continue;
+
+            for (i = 0; decl[i].Stream != 0xff; ++i)
+            {
+                if (decl[i].Usage == D3DDECLUSAGE_POSITION && decl[i].UsageIndex == 0
+                        && decl[i].Type == D3DDECLTYPE_FLOAT3 && decl[i].Stream == 0)
+                {
+                    offset = decl[i].Offset;
+                    found = TRUE;
+                    break;
+                }
+            }
+            if (!found)
+                continue;
+
+            stride = mesh->lpVtbl->GetNumBytesPerVertex(mesh);
+            count = mesh->lpVtbl->GetNumVertices(mesh);
+            if (FAILED(hr = mesh->lpVtbl->LockVertexBuffer(mesh, D3DLOCK_READONLY, (void **)&vertices)))
+                return hr;
+
+            for (i = 0; i < count; ++i)
+            {
+                D3DXVECTOR3 p;
+
+                D3DXVec3TransformCoord(&p, (const D3DXVECTOR3 *)(vertices + i * stride + offset), &world);
+                if (!pass)
+                {
+                    D3DXVec3Add(&sphere->sum, &sphere->sum, &p);
+                    ++sphere->count;
+                }
+                else
+                {
+                    D3DXVECTOR3 d;
+                    float len = D3DXVec3Length(D3DXVec3Subtract(&d, &p, center));
+                    if (len > sphere->radius)
+                        sphere->radius = len;
+                }
+            }
+            mesh->lpVtbl->UnlockVertexBuffer(mesh);
+        }
+
+        if (frame->pFrameFirstChild && FAILED(hr = frame_visit_positions(frame->pFrameFirstChild, &world, sphere,
+                center, pass)))
+            return hr;
+    }
+
+    return D3D_OK;
+}
+
+HRESULT WINAPI D3DXFrameCalculateBoundingSphere(const D3DXFRAME *frame_root, D3DXVECTOR3 *center, float *radius)
+{
+    struct frame_sphere sphere = {{0}};
+    D3DXMATRIX identity;
+    HRESULT hr;
+
+    TRACE("frame_root %p, center %p, radius %p.\n", frame_root, center, radius);
+
+    if (!frame_root || !center || !radius)
+        return D3DERR_INVALIDCALL;
+
+    D3DXMatrixIdentity(&identity);
+    if (FAILED(hr = frame_visit_positions(frame_root, &identity, &sphere, NULL, 0)))
+        return hr;
+
+    if (!sphere.count)
+    {
+        center->x = center->y = center->z = 0.0f;
+        *radius = 0.0f;
+        return D3D_OK;
+    }
+
+    D3DXVec3Scale(center, &sphere.sum, 1.0f / sphere.count);
+    if (FAILED(hr = frame_visit_positions(frame_root, &identity, &sphere, center, 1)))
+        return hr;
+    *radius = sphere.radius;
+
+    return D3D_OK;
+}
