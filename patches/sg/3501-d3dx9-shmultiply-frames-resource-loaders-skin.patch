+/* Products of the higher orders come from the triple-product integrals of the
+ * basis D3DXSHEvalDirection produces, found by quadrature over the sphere. */
+#define SH_MAX_ORDER 6
+#define SH_MAX_COEFFS (SH_MAX_ORDER * SH_MAX_ORDER)
+
+static float sh_gaunt[SH_MAX_COEFFS][SH_MAX_COEFFS][SH_MAX_COEFFS];
+static INIT_ONCE sh_gaunt_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK sh_gaunt_init(INIT_ONCE *once, void *param, void **context)
+{
+    enum { THETA_POINTS = 12, PHI_POINTS = 36 };
+    double nodes[THETA_POINTS], weights[THETA_POINTS];
+    static double gaunt[SH_MAX_COEFFS][SH_MAX_COEFFS][SH_MAX_COEFFS];
+    unsigned int i, j, k, n, t, p;
+
+    /* Gauss-Legendre nodes by Newton iteration on P_n */
+    for (i = 0; i < THETA_POINTS; ++i)
+    {
+        double x = cos(D3DX_PI * (i + 0.75) / (THETA_POINTS + 0.5)), dp = 1.0;
+
+        for (n = 0; n < 50; ++n)
+        {
+            double p0 = 1.0, p1 = x, p2;
+
+            for (k = 2; k <= THETA_POINTS; ++k)
+            {
+                p2 = ((2.0 * k - 1.0) * x * p1 - (k - 1.0) * p0) / k;
+                p0 = p1;
+                p1 = p2;
+            }
+            dp = THETA_POINTS * (x * p1 - p0) / (x * x - 1.0);
+            x -= p1 / dp;
+            if (fabs(p1 / dp) < 1e-15)
+                break;
+        }
+        nodes[i] = x;
+        weights[i] = 2.0 / ((1.0 - x * x) * dp * dp);
+    }
+
+    for (t = 0; t < THETA_POINTS; ++t)
+    {
+        double sin_theta = sqrt(1.0 - nodes[t] * nodes[t]);
+
+        for (p = 0; p < PHI_POINTS; ++p)
+        {
+            double phi = 2.0 * D3DX_PI * (p + 0.5) / PHI_POINTS;
+            float y[SH_MAX_COEFFS];
+            D3DXVECTOR3 dir;
+            double w = weights[t] * 2.0 * D3DX_PI / PHI_POINTS;
+
+            dir.x = sin_theta * cos(phi);
+            dir.y = sin_theta * sin(phi);
+            dir.z = nodes[t];
+            D3DXSHEvalDirection(y, SH_MAX_ORDER, &dir);
+
+            for (k = 0; k < SH_MAX_COEFFS; ++k)
+                for (i = 0; i < SH_MAX_COEFFS; ++i)
+                    for (j = 0; j < SH_MAX_COEFFS; ++j)
+                        gaunt[k][i][j] += w * y[k] * y[i] * y[j];
+        }
+    }
+
+    for (k = 0; k < SH_MAX_COEFFS; ++k)
+        for (i = 0; i < SH_MAX_COEFFS; ++i)
+            for (j = 0; j < SH_MAX_COEFFS; ++j)
+                sh_gaunt[k][i][j] = fabs(gaunt[k][i][j]) < 1e-5 ? 0.0f : gaunt[k][i][j];
+
+    return TRUE;
+}
+
+static FLOAT *sh_multiply(FLOAT *out, const FLOAT *a, const FLOAT *b, unsigned int order)
+{
+    unsigned int n = order * order, i, j, k;
+
+    InitOnceExecuteOnce(&sh_gaunt_once, sh_gaunt_init, NULL, NULL);
+
+    for (k = 0; k < n; ++k)
+    {
+        float sum = 0.0f;
+
+        /* the product of two functions of order N has terms up to order 2N-1,
+         * of which only the first N are kept */
+        for (i = 0; i < n; ++i)
+            for (j = 0; j < n; ++j)
+                if (sh_gaunt[k][i][j] != 0.0f)
+                    sum += sh_gaunt[k][i][j] * a[i] * b[j];
+        out[k] = sum;
+    }
+
+    return out;
+}
+
+FLOAT * WINAPI D3DXSHMultiply5(FLOAT *out, const FLOAT *a, const FLOAT *b)
+{
+    TRACE("out %p, a %p, b %p\n", out, a, b);
+
+    return sh_multiply(out, a, b, 5);
+}
+
+FLOAT * WINAPI D3DXSHMultiply6(FLOAT *out, const FLOAT *a, const FLOAT *b)
+{
+    TRACE("out %p, a %p, b %p\n", out, a, b);
+
+    return sh_multiply(out, a, b, 6);
+}
