From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: files dropped on a file go where its type sends them (7501)

Every drop on a file in File Explorer or on the desktop went to the folder
the file was in: dropping a file on numbers.rar moved it next to the
archive. As on Windows, a file now takes a drop as its type says:
- HKCR\<ProgID>\shellex\DropHandler (or the extension's, or its
  SystemFileAssociations'): the handler, created with IPersistFile and
  loaded with the file, gets the drop (WinRAR adds the files to the .rar);
- a program (exefile, batfile, cmdfile, comfile -> the shell's
  {86C86720-42A0-1069-A2E8-08002B30309D}, new in shell32 and wine.inf):
  started with the dropped files as arguments, quoted when they have a
  space;
- a shortcut (lnkfile -> ShellLink, which now has IDropTarget): its
  program with the shortcut's arguments and then the files, or its folder,
  which takes the files in;
- a file type that is a shell folder (a .zip): the folder takes them in.
Other files leave the drop to their folder, as before. The desktop's own
items take drops the same way.
---
diff --git a/dlls/shell32/Makefile.in b/dlls/shell32/Makefile.in
index 6bae9c0..3cb97be 100644
--- a/dlls/shell32/Makefile.in
+++ b/dlls/shell32/Makefile.in
@@ -20,6 +20,7 @@ SOURCES = \
 	debughlp.c \
 	dialogs.c \
 	dragdrophelper.c \
+	droptarget.c \
 	driveprops.c \
 	ebrowser.c \
 	enumidlist.c \
diff --git a/dlls/shell32/droptarget.c b/dlls/shell32/droptarget.c
new file mode 100644
index 0000000..880fcc1
--- /dev/null
+++ b/dlls/shell32/droptarget.c
@@ -0,0 +1,457 @@
+/*
+ * Stained Glass OS: drop targets of files -- what happens when files are dropped
+ * on a file in File Explorer or on the desktop, as Windows does it:
+ *  - a file whose type has a drop handler (HKCR\<ProgID>\shellex\DropHandler)
+ *    gives the drop to that handler (WinRAR adds the files to the archive);
+ *  - a program (exefile, batfile, cmdfile, comfile: the shell's own
+ *    {86C86720-42A0-1069-A2E8-08002B30309D}) is started with the dropped
+ *    files as its arguments;
+ *  - a shortcut (lnkfile, ShellLink) passes the drop to its target: a folder
+ *    takes the files in, a program starts with the shortcut's arguments
+ *    followed by the files;
+ *  - a file type that is a shell folder (a .zip, Compressed Folder) takes
+ *    the files in.
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "shlobj.h"
+#include "shellapi.h"
+#include "shlwapi.h"
+#include "shell32_main.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+const CLSID CLSID_ExeDropTarget = { 0x86c86720, 0x42a0, 0x1069, { 0xa2, 0xe8, 0x08, 0x00, 0x2b, 0x30, 0x30, 0x9d } };
+
+/* ---- a program's drop target --------------------------------------------- */
+
+struct exe_drop
+{
+    IDropTarget IDropTarget_iface;
+    IPersistFile IPersistFile_iface;
+    LONG ref;
+    WCHAR *path;     /* the program */
+    WCHAR *args;     /* arguments before the files (a shortcut's own) */
+    WCHAR *dir;      /* working directory (a shortcut's), or none */
+    int show;
+    BOOL accept;     /* the data being dragged has files */
+};
+
+static struct exe_drop *impl_from_IDropTarget(IDropTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct exe_drop, IDropTarget_iface);
+}
+
+static struct exe_drop *impl_from_IPersistFile(IPersistFile *iface)
+{
+    return CONTAINING_RECORD(iface, struct exe_drop, IPersistFile_iface);
+}
+
+static HRESULT WINAPI exe_drop_QueryInterface(IDropTarget *iface, REFIID riid, void **out)
+{
+    struct exe_drop *This = impl_from_IDropTarget(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDropTarget))
+        *out = &This->IDropTarget_iface;
+    else if (IsEqualIID(riid, &IID_IPersist) || IsEqualIID(riid, &IID_IPersistFile))
+        *out = &This->IPersistFile_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI exe_drop_AddRef(IDropTarget *iface)
+{
+    return InterlockedIncrement(&impl_from_IDropTarget(iface)->ref);
+}
+
+static ULONG WINAPI exe_drop_Release(IDropTarget *iface)
+{
+    struct exe_drop *This = impl_from_IDropTarget(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        free(This->path);
+        free(This->args);
+        free(This->dir);
+        free(This);
+    }
+    return ref;
+}
+
+/* a program takes files: the drop copies nothing, so the source never deletes them */
+static DWORD exe_drop_effect(DWORD allowed)
+{
+    if (allowed & DROPEFFECT_COPY) return DROPEFFECT_COPY;
+    if (allowed & DROPEFFECT_LINK) return DROPEFFECT_LINK;
+    if (allowed & DROPEFFECT_MOVE) return DROPEFFECT_MOVE;
+    return DROPEFFECT_NONE;
+}
+
+static HRESULT WINAPI exe_drop_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct exe_drop *This = impl_from_IDropTarget(iface);
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+
+    This->accept = data && This->path && IDataObject_QueryGetData(data, &fmt) == S_OK;
+    *effect = This->accept ? exe_drop_effect(*effect) : DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI exe_drop_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct exe_drop *This = impl_from_IDropTarget(iface);
+    *effect = This->accept ? exe_drop_effect(*effect) : DROPEFFECT_NONE;
+    return S_OK;
+}
+
+static HRESULT WINAPI exe_drop_DragLeave(IDropTarget *iface)
+{
+    impl_from_IDropTarget(iface)->accept = FALSE;
+    return S_OK;
+}
+
+/* the program's command line: its own arguments, then each file, quoted when it has a space */
+static WCHAR *exe_drop_params(const WCHAR *args, HDROP drop)
+{
+    UINT i, count = DragQueryFileW(drop, ~0u, NULL, 0);
+    size_t len = (args ? wcslen(args) : 0) + 1, pos = 0;
+    WCHAR *params, *file;
+
+    for (i = 0; i < count; i++) len += DragQueryFileW(drop, i, NULL, 0) + 3;
+    if (!(params = malloc(len * sizeof(WCHAR)))) return NULL;
+    params[0] = 0;
+    if (args && *args)
+    {
+        wcscpy(params, args);
+        pos = wcslen(params);
+    }
+    for (i = 0; i < count; i++)
+    {
+        UINT n = DragQueryFileW(drop, i, NULL, 0);
+        BOOL quote;
+        if (!(file = malloc((n + 1) * sizeof(WCHAR)))) continue;
+        DragQueryFileW(drop, i, file, n + 1);
+        quote = wcschr(file, ' ') != NULL;
+        if (pos) params[pos++] = ' ';
+        if (quote) params[pos++] = '"';
+        wcscpy(params + pos, file);
+        pos += n;
+        if (quote) params[pos++] = '"';
+        params[pos] = 0;
+        free(file);
+    }
+    return params;
+}
+
+static HRESULT WINAPI exe_drop_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    struct exe_drop *This = impl_from_IDropTarget(iface);
+    FORMATETC fmt = { CF_HDROP, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+    STGMEDIUM medium;
+    WCHAR *params;
+    BOOL ok;
+
+    This->accept = FALSE;
+    if (!data || !This->path || FAILED(IDataObject_GetData(data, &fmt, &medium)))
+    {
+        *effect = DROPEFFECT_NONE;
+        return S_OK;
+    }
+    params = exe_drop_params(This->args, medium.hGlobal);
+    ReleaseStgMedium(&medium);
+    if (!params)
+    {
+        *effect = DROPEFFECT_NONE;
+        return E_OUTOFMEMORY;
+    }
+    TRACE("%s %s\n", debugstr_w(This->path), debugstr_w(params));
+    sei.fMask = SEE_MASK_FLAG_NO_UI | SEE_MASK_NOASYNC;
+    sei.lpFile = This->path;
+    sei.lpParameters = params;
+    sei.lpDirectory = This->dir && *This->dir ? This->dir : NULL;
+    sei.nShow = This->show ? This->show : SW_SHOWNORMAL;
+    ok = ShellExecuteExW(&sei);
+    free(params);
+    *effect = ok ? exe_drop_effect(*effect) : DROPEFFECT_NONE;
+    return ok ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+}
+
+static const IDropTargetVtbl exe_drop_vtbl =
+{
+    exe_drop_QueryInterface,
+    exe_drop_AddRef,
+    exe_drop_Release,
+    exe_drop_DragEnter,
+    exe_drop_DragOver,
+    exe_drop_DragLeave,
+    exe_drop_Drop,
+};
+
+static HRESULT WINAPI exe_pf_QueryInterface(IPersistFile *iface, REFIID riid, void **out)
+{
+    return exe_drop_QueryInterface(&impl_from_IPersistFile(iface)->IDropTarget_iface, riid, out);
+}
+
+static ULONG WINAPI exe_pf_AddRef(IPersistFile *iface)
+{
+    return exe_drop_AddRef(&impl_from_IPersistFile(iface)->IDropTarget_iface);
+}
+
+static ULONG WINAPI exe_pf_Release(IPersistFile *iface)
+{
+    return exe_drop_Release(&impl_from_IPersistFile(iface)->IDropTarget_iface);
+}
+
+static HRESULT WINAPI exe_pf_GetClassID(IPersistFile *iface, CLSID *clsid)
+{
+    *clsid = CLSID_ExeDropTarget;
+    return S_OK;
+}
+
+static HRESULT WINAPI exe_pf_IsDirty(IPersistFile *iface)
+{
+    return S_FALSE;
+}
+
+static HRESULT WINAPI exe_pf_Load(IPersistFile *iface, LPCOLESTR file, DWORD mode)
+{
+    struct exe_drop *This = impl_from_IPersistFile(iface);
+    WCHAR *copy;
+
+    if (!file) return E_INVALIDARG;
+    if (!(copy = wcsdup(file))) return E_OUTOFMEMORY;
+    free(This->path);
+    This->path = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI exe_pf_Save(IPersistFile *iface, LPCOLESTR file, BOOL remember)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI exe_pf_SaveCompleted(IPersistFile *iface, LPCOLESTR file)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI exe_pf_GetCurFile(IPersistFile *iface, LPOLESTR *file)
+{
+    struct exe_drop *This = impl_from_IPersistFile(iface);
+
+    *file = NULL;
+    if (!This->path) return S_FALSE;
+    if (!(*file = CoTaskMemAlloc((wcslen(This->path) + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    wcscpy(*file, This->path);
+    return S_OK;
+}
+
+static const IPersistFileVtbl exe_pf_vtbl =
+{
+    exe_pf_QueryInterface,
+    exe_pf_AddRef,
+    exe_pf_Release,
+    exe_pf_GetClassID,
+    exe_pf_IsDirty,
+    exe_pf_Load,
+    exe_pf_Save,
+    exe_pf_SaveCompleted,
+    exe_pf_GetCurFile,
+};
+
+static HRESULT exe_drop_create(const WCHAR *path, const WCHAR *args, const WCHAR *dir, int show, struct exe_drop **ret)
+{
+    struct exe_drop *This;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IDropTarget_iface.lpVtbl = &exe_drop_vtbl;
+    This->IPersistFile_iface.lpVtbl = &exe_pf_vtbl;
+    This->ref = 1;
+    This->show = show;
+    if ((path && !(This->path = wcsdup(path))) || (args && !(This->args = wcsdup(args))) ||
+        (dir && !(This->dir = wcsdup(dir))))
+    {
+        exe_drop_Release(&This->IDropTarget_iface);
+        return E_OUTOFMEMORY;
+    }
+    *ret = This;
+    return S_OK;
+}
+
+HRESULT WINAPI ExeDropTarget_Constructor(IUnknown *outer, REFIID riid, void **out)
+{
+    struct exe_drop *This;
+    HRESULT hr;
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (FAILED(hr = exe_drop_create(NULL, NULL, NULL, 0, &This))) return hr;
+    hr = exe_drop_QueryInterface(&This->IDropTarget_iface, riid, out);
+    exe_drop_Release(&This->IDropTarget_iface);
+    return hr;
+}
+
+/* ---- which drop target a file has ------------------------------------------ */
+
+static BOOL handler_blocked(const WCHAR *clsid)
+{
+    HKEY key;
+    BOOL blocked = FALSE;
+
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Shell Extensions\\Blocked",
+                       0, KEY_READ, &key))
+    {
+        blocked = !RegQueryValueExW(key, clsid, NULL, NULL, NULL, NULL);
+        RegCloseKey(key);
+    }
+    return blocked;
+}
+
+/* the drop handler registered for a file's type: its ProgID's, else its extension's own or
+ * its SystemFileAssociations' */
+static BOOL find_drop_handler(const WCHAR *path, CLSID *clsid, WCHAR *progid, DWORD progid_len)
+{
+    const WCHAR *ext = PathFindExtensionW(path);
+    WCHAR key[MAX_PATH + 64], sfa[MAX_PATH + 32], value[64];
+    const WCHAR *types[3];
+    DWORD size, i, n = 0;
+
+    progid[0] = 0;
+    if (!*ext) return FALSE;
+    size = progid_len * sizeof(WCHAR);
+    if (!SHELL_GetUserChoice(ext, progid, progid_len) &&
+        RegGetValueW(HKEY_CLASSES_ROOT, ext, NULL, RRF_RT_REG_SZ, NULL, progid, &size))
+        progid[0] = 0;
+    if (progid[0]) types[n++] = progid;
+    types[n++] = ext;
+    swprintf(sfa, ARRAY_SIZE(sfa), L"SystemFileAssociations\\%s", ext);
+    types[n++] = sfa;
+    for (i = 0; i < n; i++)
+    {
+        swprintf(key, ARRAY_SIZE(key), L"%s\\shellex\\DropHandler", types[i]);
+        size = sizeof(value);
+        if (RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, value, &size) || value[0] != '{')
+            continue;
+        if (FAILED(CLSIDFromString(value, clsid)) || handler_blocked(value)) continue;
+        TRACE("%s: %s\n", debugstr_w(key), debugstr_w(value));
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* a folder's drop target, by its path */
+static HRESULT folder_drop_target(const WCHAR *path, HWND hwnd, IDropTarget **ret)
+{
+    IShellFolder *folder;
+    ITEMIDLIST *pidl;
+    HRESULT hr;
+
+    if (FAILED(hr = SHParseDisplayName(path, NULL, &pidl, 0, NULL))) return hr;
+    hr = SHBindToObject(NULL, pidl, NULL, &IID_IShellFolder, (void **)&folder);
+    ILFree(pidl);
+    if (FAILED(hr)) return hr;
+    hr = IShellFolder_CreateViewObject(folder, hwnd, &IID_IDropTarget, (void **)ret);
+    IShellFolder_Release(folder);
+    return hr;
+}
+
+/* The drop target of the file system object PATH (see the top of this file), with a
+ * shortcut's ARGS, working directory DIR and SHOW for a program; E_NOINTERFACE when the
+ * file takes no drop (the folder it is in takes it then). FOLDER and CHILD, when given,
+ * are where PATH is, for a file type that is a shell folder. */
+HRESULT SHELL_PathDropTarget(const WCHAR *path, const WCHAR *args, const WCHAR *dir, int show,
+                             IShellFolder *folder, LPCITEMIDLIST child, HWND hwnd, IDropTarget **ret)
+{
+    WCHAR progid[MAX_PATH], key[MAX_PATH + 16];
+    struct exe_drop *exe;
+    IPersistFile *persist;
+    IShellFolder *inner;
+    HKEY hkey;
+    DWORD attrs;
+    CLSID clsid;
+    HRESULT hr;
+
+    *ret = NULL;
+#ifdef SG_MUTANT_NO_FILE_DROP
+    return E_NOINTERFACE;
+#endif
+    if (!path || !*path || (attrs = GetFileAttributesW(path)) == INVALID_FILE_ATTRIBUTES) return E_NOINTERFACE;
+    if (attrs & FILE_ATTRIBUTE_DIRECTORY) return folder_drop_target(path, hwnd, ret);
+
+    if (find_drop_handler(path, &clsid, progid, ARRAY_SIZE(progid)))
+    {
+        if (IsEqualCLSID(&clsid, &CLSID_ExeDropTarget))
+        {
+            if (FAILED(hr = exe_drop_create(path, args, dir, show, &exe))) return hr;
+            *ret = &exe->IDropTarget_iface;
+            return S_OK;
+        }
+        hr = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IPersistFile, (void **)&persist);
+        if (SUCCEEDED(hr))
+        {
+            hr = IPersistFile_Load(persist, path, STGM_READ);
+            if (SUCCEEDED(hr)) hr = IPersistFile_QueryInterface(persist, &IID_IDropTarget, (void **)ret);
+            IPersistFile_Release(persist);
+            if (SUCCEEDED(hr)) return hr;
+        }
+        WARN("drop handler %s for %s: %#lx\n", debugstr_guid(&clsid), debugstr_w(path), hr);
+    }
+
+    /* a file that is a shell folder (HKCR\<ProgID>\CLSID: a .zip) takes the files in */
+    swprintf(key, ARRAY_SIZE(key), L"%s\\CLSID", progid);
+    if (folder && child && progid[0] && !RegOpenKeyExW(HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey))
+    {
+        RegCloseKey(hkey);
+        if (SUCCEEDED(IShellFolder_BindToObject(folder, child, NULL, &IID_IShellFolder, (void **)&inner)))
+        {
+            hr = IShellFolder_CreateViewObject(inner, hwnd, &IID_IDropTarget, (void **)ret);
+            IShellFolder_Release(inner);
+            if (SUCCEEDED(hr)) return hr;
+        }
+    }
+    return E_NOINTERFACE;
+}
+
+/* the drop target of the file system item CHILD of FOLDER (whose absolute pidl is ROOT) */
+HRESULT SHELL_ItemDropTarget(IShellFolder *folder, LPCITEMIDLIST root, LPCITEMIDLIST child, HWND hwnd,
+                             IDropTarget **ret)
+{
+    WCHAR path[MAX_PATH];
+    ITEMIDLIST *full = ILCombine(root, child);
+    BOOL ok = full && SHGetPathFromIDListW(full, path);
+
+    ILFree(full);
+    *ret = NULL;
+    if (!ok) return E_NOINTERFACE;
+    return SHELL_PathDropTarget(path, NULL, NULL, 0, folder, child, hwnd, ret);
+}
