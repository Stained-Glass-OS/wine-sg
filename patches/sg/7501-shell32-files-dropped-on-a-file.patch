     propertystore_Commit
 };
 
+/* Stained Glass OS: files dropped on a shortcut go to its target, as on Windows: a folder takes
+ * them in, a program starts with the shortcut's arguments and then the files, a document's type
+ * may have a drop handler (droptarget.c) */
+static inline IShellLinkImpl *impl_from_IDropTarget(IDropTarget *iface)
+{
+    return CONTAINING_RECORD(iface, IShellLinkImpl, IDropTarget_iface);
+}
+
+static HRESULT WINAPI link_drop_QueryInterface(IDropTarget *iface, REFIID riid, void **out)
+{
+    return IShellLinkW_QueryInterface(&impl_from_IDropTarget(iface)->IShellLinkW_iface, riid, out);
+}
+
+static ULONG WINAPI link_drop_AddRef(IDropTarget *iface)
+{
+    return IShellLinkW_AddRef(&impl_from_IDropTarget(iface)->IShellLinkW_iface);
+}
+
+static ULONG WINAPI link_drop_Release(IDropTarget *iface)
+{
+    return IShellLinkW_Release(&impl_from_IDropTarget(iface)->IShellLinkW_iface);
+}
+
+static HRESULT WINAPI link_drop_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    IShellLinkImpl *This = impl_from_IDropTarget(iface);
+    WCHAR path[MAX_PATH];
+    const WCHAR *target = This->sPath;
+
+    if (This->drop_inner)
+    {
+        IDropTarget_Release(This->drop_inner);
+        This->drop_inner = NULL;
+    }
+    if ((!target || !*target) && This->pPidl && SHGetPathFromIDListW(This->pPidl, path)) target = path;
+    if (FAILED(SHELL_PathDropTarget(target, This->sArgs, This->sWorkDir, This->iShowCmd, NULL, NULL, NULL,
+                                    &This->drop_inner)))
+    {
+        TRACE("%s takes no drop\n", debugstr_w(target));
+        *effect = DROPEFFECT_NONE;
+        return S_OK;
+    }
+    return IDropTarget_DragEnter(This->drop_inner, data, keys, pt, effect);
+}
+
+static HRESULT WINAPI link_drop_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    IShellLinkImpl *This = impl_from_IDropTarget(iface);
+
+    if (!This->drop_inner)
+    {
+        *effect = DROPEFFECT_NONE;
+        return S_OK;
+    }
+    return IDropTarget_DragOver(This->drop_inner, keys, pt, effect);
+}
+
+static HRESULT WINAPI link_drop_DragLeave(IDropTarget *iface)
+{
+    IShellLinkImpl *This = impl_from_IDropTarget(iface);
+    HRESULT hr = S_OK;
+
+    if (This->drop_inner)
+    {
+        hr = IDropTarget_DragLeave(This->drop_inner);
+        IDropTarget_Release(This->drop_inner);
+        This->drop_inner = NULL;
+    }
+    return hr;
+}
+
+static HRESULT WINAPI link_drop_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    IShellLinkImpl *This = impl_from_IDropTarget(iface);
+    IDropTarget *inner = This->drop_inner;
+    HRESULT hr;
+
+    This->drop_inner = NULL;
+    if (!inner)
+    {
+        /* a drop without DragEnter: find the target now */
+        DWORD allowed = *effect;
+        link_drop_DragEnter(iface, data, keys, pt, &allowed);
+        inner = This->drop_inner;
+        This->drop_inner = NULL;
+        if (!inner)
+        {
+            *effect = DROPEFFECT_NONE;
+            return S_OK;
+        }
+    }
+    hr = IDropTarget_Drop(inner, data, keys, pt, effect);
+    IDropTarget_Release(inner);
+    return hr;
+}
+
+static const IDropTargetVtbl droptargetvtbl =
+{
+    link_drop_QueryInterface,
+    link_drop_AddRef,
+    link_drop_Release,
+    link_drop_DragEnter,
+    link_drop_DragOver,
+    link_drop_DragLeave,
+    link_drop_Drop,
+};
+
