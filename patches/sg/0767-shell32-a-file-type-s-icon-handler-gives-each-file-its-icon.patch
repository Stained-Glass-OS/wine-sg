From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a file type's icon handler gives each file its icon

On Windows a file type may name an icon handler (its class's
shellex\IconHandler): the shell creates it, loads it with the file
(IPersistFile) and asks it for that file's icon (IExtractIconW). Wine took
the type's DefaultIcon for every file. A Linux app's .desktop file on the
desktop (Steam puts one there) showed the type's icon, the Store's, not the
app's (David 2026-10-02); sg-shell's sglinuxicon64.dll is that type's
handler.

The handler's location is taken when it names a file (not GIL_NOTFILENAME);
otherwise the DefaultIcon, as before.

Test: test/iconhandler-gate.sh (mutant NO_ICON_HANDLER).
---
--- a/dlls/shell32/folders.c
+++ b/dlls/shell32/folders.c
@@ -178,6 +178,48 @@
 *
 * mapping filetype to icon
 */
+/* Stained Glass OS: a file type's icon handler (its class's
+ * shellex\IconHandler, as on Windows): asked for each file's icon, loaded
+ * with the file (IPersistFile). A Linux app's .desktop file on the desktop
+ * showed the type's icon, the Store's, not the app's -- Steam's (David
+ * 2026-10-02). Only a location in a file is taken (no GIL_NOTFILENAME). */
+static BOOL icon_from_handler(const char *progid, LPCITEMIDLIST pidl, UINT uFlags, LPWSTR szIconFile,
+                              UINT cchMax, int *piIndex)
+{
+    char key[MAX_PATH + 32], value[64];
+    LONG len = sizeof(value);
+    WCHAR clsid_str[64], path[MAX_PATH];
+    IPersistFile *file;
+    IExtractIconW *extract;
+    CLSID clsid;
+    BOOL ok = FALSE;
+
+    if (strlen(progid) > MAX_PATH) return FALSE;
+    sprintf(key, "%s\\shellex\\IconHandler", progid);
+    if (RegQueryValueA(HKEY_CLASSES_ROOT, key, value, &len) || !value[0]) return FALSE;
+    MultiByteToWideChar(CP_ACP, 0, value, -1, clsid_str, ARRAY_SIZE(clsid_str));
+    if (FAILED(CLSIDFromString(clsid_str, &clsid))) return FALSE;
+    if (!SHGetPathFromIDListW(pidl, path)) return FALSE;
+    if (FAILED(SHCoCreateInstance(NULL, &clsid, NULL, &IID_IPersistFile, (void **)&file))) return FALSE;
+    if (SUCCEEDED(IPersistFile_Load(file, path, STGM_READ)) &&
+        SUCCEEDED(IPersistFile_QueryInterface(file, &IID_IExtractIconW, (void **)&extract)))
+    {
+        UINT flags = 0;
+        WCHAR location[MAX_PATH];
+        int index = 0;
+        if (IExtractIconW_GetIconLocation(extract, uFlags, location, ARRAY_SIZE(location), &index, &flags) == S_OK &&
+            location[0] && !(flags & GIL_NOTFILENAME))
+        {
+            lstrcpynW(szIconFile, location, cchMax);
+            *piIndex = index;
+            ok = TRUE;
+        }
+        IExtractIconW_Release(extract);
+    }
+    IPersistFile_Release(file);
+    return ok;
+}
+
 static HRESULT WINAPI IExtractIconW_fnGetIconLocation(IExtractIconW * iface, UINT uFlags,
         LPWSTR szIconFile, UINT cchMax, int * piIndex, UINT * pwFlags)
 {
@@ -284,8 +326,13 @@
 	  }
 	  else if (_ILGetExtension(pSimplePidl, sTemp, MAX_PATH))
 	  {
-	    if (HCR_MapTypeToValueA(sTemp, sTemp, MAX_PATH, TRUE)
-		&& HCR_GetDefaultIconA(sTemp, sTemp, MAX_PATH, &icon_idx))
+	    BOOL mapped = HCR_MapTypeToValueA(sTemp, sTemp, MAX_PATH, TRUE);
+#ifndef SG_MUTANT_NO_ICON_HANDLER
+	    if (mapped && icon_from_handler(sTemp, This->pidl, uFlags, szIconFile, cchMax, piIndex))
+	      found = TRUE;
+	    else
+#endif
+	    if (mapped && HCR_GetDefaultIconA(sTemp, sTemp, MAX_PATH, &icon_idx))
 	    {
 	      if (!lstrcmpA("%1", sTemp))		/* icon is in the file */
 	      {
