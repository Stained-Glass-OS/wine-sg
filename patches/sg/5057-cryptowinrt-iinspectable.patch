 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    static const IID *const list[] = { &IID_IActivationFactory, &IID_IKeyCredentialManagerStatics, &IID_IAgileObject };
