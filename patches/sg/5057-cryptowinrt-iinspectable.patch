From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptowinrt: Implement IInspectable on the factories and the boolean operation.

IInspectable on cryptowinrt's objects: the CryptographicBuffer and
KeyCredentialManager factories list their interfaces (GetIids), answer
GetRuntimeClassName with E_ILLEGAL_METHOD_CALL as a class factory or static
interface does, and are BaseTrust; the IAsyncOperation<Boolean> lists
IAsyncOperation<Boolean>, IAsyncInfo and IAgileObject, is BaseTrust, and its
class name no longer counts the terminating null in the HSTRING's length.
All three returned E_NOTIMPL.

Gate: test/cryptowinrt-inspectable-gate.sh.
---
 dlls/cryptowinrt/async.c       | 22 +++++++++++++++-------
 dlls/cryptowinrt/credentials.c | 20 ++++++++++++++------
 dlls/cryptowinrt/main.c        | 20 ++++++++++++++------
 dlls/cryptowinrt/private.h     | 17 +++++++++++++++++
 4 files changed, 60 insertions(+), 19 deletions(-)

diff --git a/dlls/cryptowinrt/async.c b/dlls/cryptowinrt/async.c
index 5c3d718..5573ce3 100644
--- a/dlls/cryptowinrt/async.c
+++ b/dlls/cryptowinrt/async.c
@@ -419,21 +419,29 @@ static ULONG WINAPI async_bool_Release( IAsyncOperation_boolean *iface )
 
 static HRESULT WINAPI async_bool_GetIids( IAsyncOperation_boolean *iface, ULONG *iid_count, IID **iids )
 {
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
+    static const IID *const list[] = { &IID_IAsyncOperation_boolean, &IID_IAsyncInfo, &IID_IAgileObject };
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    return inspectable_iids( list, ARRAY_SIZE(list), iid_count, iids );
 }
 
 static HRESULT WINAPI async_bool_GetRuntimeClassName( IAsyncOperation_boolean *iface, HSTRING *class_name )
 {
-    return WindowsCreateString( L"Windows.Foundation.IAsyncOperation`1<Boolean>",
-                                ARRAY_SIZE(L"Windows.Foundation.IAsyncOperation`1<Boolean>"),
-                                class_name );
+    static const WCHAR name[] = L"Windows.Foundation.IAsyncOperation`1<Boolean>";
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
 }
 
 static HRESULT WINAPI async_bool_GetTrustLevel( IAsyncOperation_boolean *iface, TrustLevel *trust_level )
 {
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
 }
 
 static HRESULT WINAPI async_bool_put_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean *bool_handler )
