 WINE_DEFAULT_DEBUG_CHANNEL(dpvoice);
 
+/* Stained Glass OS: a voice session's host. It keeps the session's state -- the transport it
+ * was initialized on, the session description, the transmit targets the server controls --
+ * and answers as DirectPlay Voice does; no voice is carried, as our DirectPlay transport has no
+ * voice channel, so no client ever joins (IDirectPlayVoiceClient::Connect finds no session). */
+struct transmit_targets
+{
+    DVID source;
+    DWORD count;
+    DVID *targets;
+};
+
 typedef struct IDirectPlayVoiceServerImpl
 {
     IDirectPlayVoiceServer IDirectPlayVoiceServer_iface;
     LONG ref;
+    IUnknown *transport;
+    struct dpvoice_notify notify;
+    BOOL hosting;
+    DVSESSIONDESC session;
+    DWORD target_count;
+    struct transmit_targets *targets;
 } IDirectPlayVoiceServerImpl;
 
+/* dplay8.h's interfaces, here as dxguid's definitions collide with the dsound GUIDs main.c defines */
+static const GUID dp8_server = { 0x5102dace, 0x241b, 0x11d3, { 0xae, 0xa7, 0x00, 0x60, 0x97, 0xb0, 0x14, 0x11 } };
+static const GUID dp8_client = { 0x5102dacd, 0x241b, 0x11d3, { 0xae, 0xa7, 0x00, 0x60, 0x97, 0xb0, 0x14, 0x11 } };
+static const GUID dp8_peer = { 0x5102dacf, 0x241b, 0x11d3, { 0xae, 0xa7, 0x00, 0x60, 0x97, 0xb0, 0x14, 0x11 } };
+
+/* the DirectPlay 8 object a voice session runs on: a server, client or peer that is in a session */
+HRESULT dpvoice_transport_kind( IUnknown *transport, IUnknown **object, enum dpvoice_transport *kind )
+{
+    DWORD size = 0;
+    HRESULT hr;
+
+    *object = NULL;
+    if (!transport) return DVERR_NOTRANSPORT;
+    if (SUCCEEDED(IUnknown_QueryInterface( transport, &dp8_server, (void **)object )))
+    {
+        *kind = TRANSPORT_SERVER;
+        hr = IDirectPlay8Server_GetApplicationDesc( (IDirectPlay8Server *)*object, NULL, &size, 0 );
+    }
+    else if (SUCCEEDED(IUnknown_QueryInterface( transport, &dp8_client, (void **)object )))
+    {
+        *kind = TRANSPORT_CLIENT;
+        hr = IDirectPlay8Client_GetApplicationDesc( (IDirectPlay8Client *)*object, NULL, &size, 0 );
+    }
+    else if (SUCCEEDED(IUnknown_QueryInterface( transport, &dp8_peer, (void **)object )))
+    {
+        *kind = TRANSPORT_PEER;
+        hr = IDirectPlay8Peer_GetApplicationDesc( (IDirectPlay8Peer *)*object, NULL, &size, 0 );
+    }
+    else return DVERR_NOTRANSPORT;
+    /* a transport in a session tells the size of its description */
+    if (hr == DPNERR_BUFFERTOOSMALL || SUCCEEDED(hr)) return DV_OK;
+    TRACE( "the transport is in no session (%#lx)\n", hr );
+    IUnknown_Release( *object );
+    *object = NULL;
+    return hr == DPNERR_UNINITIALIZED ? DVERR_TRANSPORTNOTINIT : DVERR_TRANSPORTNOSESSION;
+}
+
+HRESULT dpvoice_set_notify( struct dpvoice_notify *notify, PDVMESSAGEHANDLER handler, void *context,
+                            const DWORD *mask, DWORD count )
+{
+    DWORD *copy = NULL, i;
+
+    if (count && !mask) return DVERR_INVALIDPOINTER;
+    if (!count && mask) return DVERR_INVALIDPARAM;
+    if (count && !handler) return DVERR_NOCALLBACK;
+    for (i = 0; i < count; i++)
+        if (mask[i] < DVMSGID_MINBASE || mask[i] > DVMSGID_MAXBASE) return DVERR_INVALIDPARAM;
+    if (count && !(copy = malloc( count * sizeof(*copy) ))) return DVERR_OUTOFMEMORY;
+    if (count) memcpy( copy, mask, count * sizeof(*copy) );
+    free( notify->mask );
+    notify->handler = handler;
+    notify->context = context;
+    notify->mask = copy;
+    notify->mask_count = count;
+    return DV_OK;
+}
+
+BOOL dpvoice_known_compression( const GUID *guid )
+{
+    static const GUID *const known[] =
+    {
+        &DPVCTGUID_ADPCM, &DPVCTGUID_GSM, &DPVCTGUID_NONE, &DPVCTGUID_SC03, &DPVCTGUID_SC06,
+        &DPVCTGUID_TRUESPEECH, &DPVCTGUID_VR12,
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(known); i++) if (IsEqualGUID( guid, known[i] )) return TRUE;
+    return FALSE;
+}
+
+HRESULT dpvoice_get_caps( DVCAPS *caps )
+{
+    if (!caps) return DVERR_INVALIDPOINTER;
+    if (caps->dwSize != sizeof(*caps)) return DVERR_INVALIDPARAM;
+    caps->dwFlags = 0;
+    return DV_OK;
+}
+
+static HRESULT check_session_desc( const DVSESSIONDESC *desc )
+{
+    if (!desc) return DVERR_INVALIDPOINTER;
+    if (desc->dwSize != sizeof(*desc)) return DVERR_INVALIDPARAM;
+    if (desc->dwFlags & ~(DVSESSION_NOHOSTMIGRATION | DVSESSION_SERVERCONTROLTARGET)) return DVERR_INVALIDFLAGS;
+    if (desc->dwBufferQuality > DVBUFFERQUALITY_MAX || desc->dwBufferAggressiveness > DVBUFFERAGGRESSIVENESS_MAX)
+        return DVERR_INVALIDPARAM;
+    return DV_OK;
+}
+
