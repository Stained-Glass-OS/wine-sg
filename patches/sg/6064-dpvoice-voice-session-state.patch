+/* Stained Glass OS: a voice client. Initialize binds it to its DirectPlay 8 transport; our
+ * transport has no voice channel, so Connect finds no voice session (DVERR_NOVOICESESSION, also
+ * reported through DVMSGID_CONNECTRESULT for an asynchronous connect) and the calls that need a
+ * connection answer DVERR_NOTCONNECTED. */
 typedef struct IDirectPlayVoiceClientImpl
 {
     IDirectPlayVoiceClient IDirectPlayVoiceClient_iface;
     LONG ref;
+    IUnknown *transport;
+    struct dpvoice_notify notify;
 } IDirectPlayVoiceClientImpl;
 
+static BOOL notify_wants( const struct dpvoice_notify *notify, DWORD id )
+{
+    DWORD i;
+
+    if (!notify->handler) return FALSE;
+    if (!notify->mask_count) return TRUE;
+    for (i = 0; i < notify->mask_count; i++) if (notify->mask[i] == id) return TRUE;
+    return FALSE;
+}
