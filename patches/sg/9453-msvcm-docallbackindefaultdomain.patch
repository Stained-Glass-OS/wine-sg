From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcm80, msvcm90: DoCallBackInDefaultDomain runs the callback in the default application domain.

A C++/CLI module first loaded in an application domain other than the default one runs its native and per-process initialization in the default domain with <CrtImplementationDetails>::DoCallBackInDefaultDomain. It was a stub, so the module's startup aborted the program. As the CRT does, the callback runs through the loaded runtime's ICLRRuntimeHost::ExecuteInAppDomain with the default domain's id (0 in Wine Mono, whose AppDomain.Id numbers it so; the CLR's is 1).
---
--- a/dlls/msvcm80/msvcm_main.c
+++ b/dlls/msvcm80/msvcm_main.c
@@ -18,13 +18,78 @@
 
 #include <stdarg.h>
 
+#define COBJMACROS
 #include "windef.h"
 #include "winbase.h"
+#include "ole2.h"
+#include "initguid.h"
+#include "mscoree.h"
+#include "metahost.h"
 
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(msvcm);
 
+/* Stained Glass OS (wine-sg 9453): the default application domain's id in the runtime's hosting API.
+ * Wine Mono numbers it 0 -- as its AppDomain.Id does -- where the CLR numbers it 1. */
+#define SG_DEFAULT_DOMAIN_ID 0
+
+/* the hosting interface of the runtime loaded in this process */
+static HRESULT get_loaded_runtime_host( ICLRRuntimeHost **host )
+{
+    HRESULT (WINAPI *create)( REFCLSID, REFIID, void ** );
+    ICLRRuntimeInfo *info = NULL;
+    ICLRMetaHost *metahost;
+    IEnumUnknown *runtimes;
+    IUnknown *unk = NULL;
+    HMODULE mscoree;
+    HRESULT hr;
+
+    *host = NULL;
+    /* the module calling here is managed code: mscoree is loaded */
+    if (!(mscoree = GetModuleHandleW( L"mscoree.dll" ))) return CO_E_NOTINITIALIZED;
+    if (!(create = (void *)GetProcAddress( mscoree, "CLRCreateInstance" ))) return E_NOTIMPL;
+    if (FAILED(hr = create( &CLSID_CLRMetaHost, &IID_ICLRMetaHost, (void **)&metahost ))) return hr;
+    hr = ICLRMetaHost_EnumerateLoadedRuntimes( metahost, GetCurrentProcess(), &runtimes );
+    ICLRMetaHost_Release( metahost );
+    if (FAILED(hr)) return hr;
+    hr = IEnumUnknown_Next( runtimes, 1, &unk, NULL );
+    IEnumUnknown_Release( runtimes );
+    if (hr != S_OK) return CO_E_NOTINITIALIZED;
+    hr = IUnknown_QueryInterface( unk, &IID_ICLRRuntimeInfo, (void **)&info );
+    IUnknown_Release( unk );
+    if (FAILED(hr)) return hr;
+    hr = ICLRRuntimeInfo_GetInterface( info, &CLSID_CLRRuntimeHost, &IID_ICLRRuntimeHost, (void **)host );
+    ICLRRuntimeInfo_Release( info );
+    return hr;
+}
+
+/* void __cdecl <CrtImplementationDetails>::DoCallBackInDefaultDomain(long (__stdcall *)(void *), void *)
+ * Stained Glass OS (wine-sg 9453): a C++/CLI module first loaded in another application domain runs its
+ * native and per-process initialization in the default one; the callback runs there, as the CRT does
+ * it, through the runtime's ICLRRuntimeHost::ExecuteInAppDomain. */
+void __cdecl CrtImplementationDetails_DoCallBackInDefaultDomain( FExecuteInAppDomainCallback function, void *cookie )
+{
+    ICLRRuntimeHost *host;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", function, cookie );
+
+#ifdef SG_MUTANT_MSVCM_CALLBACK_HERE
+    function( cookie );
+    return;
+#endif
+    if (FAILED(hr = get_loaded_runtime_host( &host )))
+    {
+        ERR( "no runtime host: %#lx\n", hr );
+        return;
+    }
+    hr = ICLRRuntimeHost_ExecuteInAppDomain( host, SG_DEFAULT_DOMAIN_ID, function, cookie );
+    ICLRRuntimeHost_Release( host );
+    /* the CRT throws the failure as an exception, which only managed code can */
+    if (FAILED(hr)) ERR( "the callback in the default domain failed: %#lx\n", hr );
+}
+
 /* void __cdecl <CrtImplementationDetails>::DoDllLanguageSupportValidation(void) */
 void __cdecl CrtImplementationDetails_DoDllLanguageSupportValidation(void)
 {
--- a/dlls/msvcm80/msvcm80.spec
+++ b/dlls/msvcm80/msvcm80.spec
@@ -1,5 +1,5 @@
-@ stub -arch=win32 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6GJPAX@Z0@Z
-@ stub -arch=win64 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6AJPEAX@Z0@Z
+@ cdecl -arch=win32 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6GJPAX@Z0@Z(ptr ptr) CrtImplementationDetails_DoCallBackInDefaultDomain
+@ cdecl -arch=win64 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6AJPEAX@Z0@Z(ptr ptr) CrtImplementationDetails_DoCallBackInDefaultDomain
 @ cdecl ?DoDllLanguageSupportValidation@<CrtImplementationDetails>@@YAXXZ() CrtImplementationDetails_DoDllLanguageSupportValidation
 @ cdecl -arch=win32 ?RegisterModuleUninitializer@<CrtImplementationDetails>@@YAXP$AAVEventHandler@System@@@Z(ptr) CrtImplementationDetails_RegisterModuleUninitializer
 @ cdecl -arch=win64 ?RegisterModuleUninitializer@<CrtImplementationDetails>@@YAXPE$AAVEventHandler@System@@@Z(ptr) CrtImplementationDetails_RegisterModuleUninitializer
--- a/dlls/msvcm90/msvcm90.spec
+++ b/dlls/msvcm90/msvcm90.spec
@@ -1,5 +1,5 @@
-@ stub -arch=win32 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6GJPAX@Z0@Z
-@ stub -arch=win64 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6AJPEAX@Z0@Z
+@ cdecl -arch=win32 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6GJPAX@Z0@Z(ptr ptr) CrtImplementationDetails_DoCallBackInDefaultDomain
+@ cdecl -arch=win64 ?DoCallBackInDefaultDomain@<CrtImplementationDetails>@@YAXP6AJPEAX@Z0@Z(ptr ptr) CrtImplementationDetails_DoCallBackInDefaultDomain
 @ cdecl ?DoDllLanguageSupportValidation@<CrtImplementationDetails>@@YAXXZ() CrtImplementationDetails_DoDllLanguageSupportValidation
 @ cdecl -arch=win32 ?RegisterModuleUninitializer@<CrtImplementationDetails>@@YAXP$AAVEventHandler@System@@@Z(ptr) CrtImplementationDetails_RegisterModuleUninitializer
 @ cdecl -arch=win64 ?RegisterModuleUninitializer@<CrtImplementationDetails>@@YAXPE$AAVEventHandler@System@@@Z(ptr) CrtImplementationDetails_RegisterModuleUninitializer
