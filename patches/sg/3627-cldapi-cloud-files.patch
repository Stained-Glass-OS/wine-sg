+static HRESULT create_one_placeholder( const WCHAR *base, CF_PLACEHOLDER_CREATE_INFO *info )
+{
+    WCHAR path[MAX_PATH];
+    struct meta meta;
+    HANDLE file;
+    BOOL dir = info->BasicInfo.FileAttributes & FILE_ATTRIBUTE_DIRECTORY;
+
+    if (!info->RelativeFileName || !info->RelativeFileName[0] || wcsstr( info->RelativeFileName, L".." )
+            || info->FileIdentityLength > META_MAX_IDENTITY || (info->FileIdentityLength && !info->FileIdentity))
+        return E_INVALIDARG;
+    if (wcslen( base ) + wcslen( info->RelativeFileName ) + 2 >= MAX_PATH) return HRESULT_FROM_WIN32( ERROR_FILENAME_EXCED_RANGE );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", base, info->RelativeFileName );
+
+    if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES)
+    {
+        if (!(info->Flags & CF_PLACEHOLDER_CREATE_FLAG_SUPERSEDE)) return HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+        if (dir || (GetFileAttributesW( path ) & FILE_ATTRIBUTE_DIRECTORY)) return HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+        DeleteFileW( path );
+    }
+    if (dir)
+    {
+        if (!CreateDirectoryW( path, NULL )) return hr_last();
+        meta_init( &meta, 0, info->FileIdentity, info->FileIdentityLength );
+        meta.flags |= META_FULL;
+        if (info->Flags & CF_PLACEHOLDER_CREATE_FLAG_MARK_IN_SYNC) meta.flags |= META_IN_SYNC;
+        meta_write( path, &meta ); /* directories may not carry a stream: then they are plain folders */
+        return S_OK;
+    }
+    file = CreateFileW( path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+            CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return hr_last();
+    if (info->FileSize.QuadPart > 0)
+    {
+        LARGE_INTEGER pos = info->FileSize;
+        SetFilePointerEx( file, pos, NULL, FILE_BEGIN );
+        SetEndOfFile( file ); /* a sparse file of the logical size */
+    }
+    if (info->BasicInfo.LastWriteTime.QuadPart || info->BasicInfo.CreationTime.QuadPart)
+    {
+        FILETIME c, a, w;
+        c.dwLowDateTime = info->BasicInfo.CreationTime.LowPart; c.dwHighDateTime = info->BasicInfo.CreationTime.HighPart;
+        a.dwLowDateTime = info->BasicInfo.LastAccessTime.LowPart; a.dwHighDateTime = info->BasicInfo.LastAccessTime.HighPart;
+        w.dwLowDateTime = info->BasicInfo.LastWriteTime.LowPart; w.dwHighDateTime = info->BasicInfo.LastWriteTime.HighPart;
+        SetFileTime( file, c.dwLowDateTime || c.dwHighDateTime ? &c : NULL,
+                a.dwLowDateTime || a.dwHighDateTime ? &a : NULL, w.dwLowDateTime || w.dwHighDateTime ? &w : NULL );
+    }
+    CloseHandle( file );
+    meta_init( &meta, info->FileSize.QuadPart, info->FileIdentity, info->FileIdentityLength );
+    if (info->Flags & CF_PLACEHOLDER_CREATE_FLAG_MARK_IN_SYNC) meta.flags |= META_IN_SYNC;
+    if (!info->FileSize.QuadPart) meta.flags |= META_FULL;
+    if (!meta_write( path, &meta ))
+    {
+        HRESULT hr = hr_last();
+        DeleteFileW( path );
+        return hr;
+    }
+    if (info->BasicInfo.FileAttributes & (FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM))
+        SetFileAttributesW( path, info->BasicInfo.FileAttributes & (FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM) );
+    return S_OK;
