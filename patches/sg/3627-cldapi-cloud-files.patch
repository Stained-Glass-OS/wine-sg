+static HRESULT set_pin_tree( const WCHAR *dir, DWORD state, BOOL stop_on_error )
+{
+    WCHAR pattern[MAX_PATH], item[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    HRESULT hr = S_OK, one;
+
+    swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*", dir );
+    if ((find = FindFirstFileW( pattern, &fd )) == INVALID_HANDLE_VALUE) return S_OK;
+    do
+    {
+        if (!wcscmp( fd.cFileName, L"." ) || !wcscmp( fd.cFileName, L".." )) continue;
+        swprintf( item, ARRAY_SIZE(item), L"%s\\%s", dir, fd.cFileName );
+        one = set_pin_one( item, state );
+        if (FAILED(one) && one != HRESULT_FROM_WIN32( ERROR_NOT_A_CLOUD_FILE ))
+        {
+            hr = one;
+            if (stop_on_error) break;
+        }
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) set_pin_tree( item, state, stop_on_error );
+    } while (FindNextFileW( find, &fd ));
+    FindClose( find );
+    return hr;
 }
 
