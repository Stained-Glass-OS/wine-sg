+    const typeof(params->u.TransferData) *td = &params->u.TransferData;
+    struct meta meta;
+
+    if (!meta_read( path, &meta )) return HRESULT_FROM_WIN32( ERROR_NOT_A_CLOUD_FILE );
+    if (td->CompletionStatus)
+    {
+        req->status = td->CompletionStatus;
+        req->failed = TRUE;
+        return S_OK;
+    }
+    if (td->Offset.QuadPart < 0 || td->Length.QuadPart < 0 || (td->Length.QuadPart && !td->Buffer))
+        return E_INVALIDARG;
+    /* documented: offset and length are multiples of 4 KB unless the transfer ends at the end of the file */
+#ifdef SG_MUTANT_CF_ALIGN
+    if (0)
+#else
+    if ((td->Offset.QuadPart & 0xfff) || ((td->Length.QuadPart & 0xfff)
+            && td->Offset.QuadPart + td->Length.QuadPart != meta.size))
+#endif
+        return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_INVALID_REQUEST );
+    if (td->Offset.QuadPart + td->Length.QuadPart > meta.size)
+        return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_INVALID_REQUEST );
+    if (!write_at( path, td->Offset.QuadPart, td->Buffer, td->Length.QuadPart )) return hr_last();
+#ifndef SG_MUTANT_CF_RANGE
+    meta_add_range( &meta, td->Offset.QuadPart, td->Length.QuadPart );
+#endif
+    if (!meta_write( path, &meta )) return hr_last();
+    return S_OK;
+}
