+HRESULT WINAPI CfExecute( const void *info_, void *params_ )
+{
+    const CF_OPERATION_INFO *info = info_;
+    CF_OPERATION_PARAMETERS *params = params_;
+    struct request *req;
+    WCHAR path[MAX_PATH];
+    HRESULT hr = S_OK;
+
+    TRACE( "%p %p\n", info, params );
+
+    if (!info || !params || info->StructSize < FIELD_OFFSET(CF_OPERATION_INFO, CorrelationVector)) return E_INVALIDARG;
+
+    EnterCriticalSection( &cs );
+    if (!find_connection( info->ConnectionKey ))
+    {
+        LeaveCriticalSection( &cs );
+        return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+    }
+    if (!(req = request_find( info->TransferKey.QuadPart )))
+    {
+        LeaveCriticalSection( &cs );
+        return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_INVALID_REQUEST );
+    }
+    wcscpy( path, req->path );
+
+    switch (info->Type)
+    {
+    case CF_OPERATION_TYPE_TRANSFER_DATA:
+        hr = execute_transfer_data( path, req, params );
+        break;
+
+    case CF_OPERATION_TYPE_RETRIEVE_DATA:
+    {
+        struct meta meta;
+        HANDLE file;
+        DWORD read = 0;
+        LARGE_INTEGER pos;
+
+        if (!meta_read( path, &meta )) { hr = HRESULT_FROM_WIN32( ERROR_NOT_A_CLOUD_FILE ); break; }
+        params->u.RetrieveData.ReturnedLength.QuadPart = 0;
+        if (!meta_covers( &meta, params->u.RetrieveData.Offset.QuadPart, params->u.RetrieveData.Length.QuadPart ))
+            break; /* data not on disk: nothing is returned */
+        file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                OPEN_EXISTING, 0, NULL );
+        if (file == INVALID_HANDLE_VALUE) { hr = hr_last(); break; }
+        pos = params->u.RetrieveData.Offset;
+        SetFilePointerEx( file, pos, NULL, FILE_BEGIN );
+        if (ReadFile( file, params->u.RetrieveData.Buffer, params->u.RetrieveData.Length.QuadPart, &read, NULL ))
+            params->u.RetrieveData.ReturnedLength.QuadPart = read;
+        else
+            hr = hr_last();
+        CloseHandle( file );
+        break;
+    }
+
+    case CF_OPERATION_TYPE_TRANSFER_PLACEHOLDERS:
+    {
+        WCHAR dir[MAX_PATH];
+        LONG processed = 0;
+        WCHAR *slash;
+
+        wcscpy( dir, path );
+        if (!(GetFileAttributesW( dir ) & FILE_ATTRIBUTE_DIRECTORY) && (slash = wcsrchr( dir, '\\' ))) *slash = 0;
+        if (params->u.TransferPlaceholders.CompletionStatus) break;
+        hr = CfCreatePlaceholders( dir, params->u.TransferPlaceholders.PlaceholderArray,
+                params->u.TransferPlaceholders.PlaceholderCount, 0, &processed );
+        params->u.TransferPlaceholders.EntriesProcessed = processed;
+        break;
+    }
+
+    case CF_OPERATION_TYPE_ACK_DATA:
+    case CF_OPERATION_TYPE_RESTART_HYDRATION:
+    case CF_OPERATION_TYPE_ACK_DEHYDRATE:
+    case CF_OPERATION_TYPE_ACK_DELETE:
+    case CF_OPERATION_TYPE_ACK_RENAME:
+        break;
+
+    default:
+        hr = E_INVALIDARG;
+        break;
+    }
+    LeaveCriticalSection( &cs );
+    return hr;
 }
 
 DWORD WINAPI CfGetPlaceholderStateFromAttributeTag( DWORD attributes, DWORD reparse_tag )
