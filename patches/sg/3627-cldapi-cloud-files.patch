+/* ---- helpers --------------------------------------------------------------- */
+
+static HRESULT hr_win32(DWORD err)
+{
+    return err ? HRESULT_FROM_WIN32(err) : S_OK;
+}
+
+static HRESULT hr_last(void)
+{
+    DWORD err = GetLastError();
+    return HRESULT_FROM_WIN32(err ? err : ERROR_GEN_FAILURE);
+}
+
+/* The DOS path of an open file, without the \\?\ prefix. */
+static BOOL handle_path(HANDLE handle, WCHAR *path, DWORD len)
+{
+    DWORD ret = GetFinalPathNameByHandleW(handle, path, len, VOLUME_NAME_DOS);
+
+    if (!ret || ret >= len) return FALSE;
+    if (!wcsncmp(path, L"\\\\?\\", 4)) memmove(path, path + 4, (wcslen(path + 4) + 1) * sizeof(WCHAR));
+    return TRUE;
+}
+
+static BOOL normalize_path(const WCHAR *in, WCHAR *out, DWORD len)
+{
+    DWORD ret = GetFullPathNameW(in, len, out, NULL);
+
+    if (!ret || ret >= len) return FALSE;
+    while (ret > 3 && out[ret - 1] == '\\') out[--ret] = 0;
+    return TRUE;
+}
+
+static BOOL path_under(const WCHAR *root, const WCHAR *path)
+{
+    size_t len = wcslen(root);
+
+    if (_wcsnicmp(root, path, len)) return FALSE;
+    return !path[len] || path[len] == '\\' || (len && root[len - 1] == '\\');
+}
+
+/* ---- placeholder metadata, kept in the "SGCF" stream ----------------------- */
+
+#define META_MAGIC 0x46434753 /* "SGCF" */
+#define META_MAX_RANGES 16
+#define META_MAX_IDENTITY 4096
+
+#define META_PLACEHOLDER 0x1
+#define META_IN_SYNC 0x2
+#define META_FULL 0x4
+
+struct range { LONGLONG start, length; };
+
+struct meta
+{
+    DWORD magic;
+    DWORD version;
+    DWORD flags;
+    DWORD pin_state;
+    LONGLONG size;                  /* the logical size */
+    DWORD range_count;
+    struct range ranges[META_MAX_RANGES];
+    DWORD identity_length;
+    BYTE identity[META_MAX_IDENTITY];
+};
+
+/* The store: one small file per placeholder in the user's CloudFiles folder, named by the volume
+ * serial and file index of the placeholder, so it follows renames and moves. */
+static BOOL meta_file_name(const WCHAR *path, WCHAR *out, size_t len, BOOL create_dir)
+{
+    BY_HANDLE_FILE_INFORMATION info;
+    WCHAR base[MAX_PATH], dir[MAX_PATH];
+    HANDLE file;
+    DWORD n;
+
+    file = CreateFileW(path, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+            FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    n = GetFileInformationByHandle(file, &info);
+    CloseHandle(file);
+    if (!n) return FALSE;
+    n = GetEnvironmentVariableW(L"LOCALAPPDATA", base, ARRAY_SIZE(base));
+    if (!n || n >= ARRAY_SIZE(base)) n = GetTempPathW(ARRAY_SIZE(base), base);
+    if (!n) return FALSE;
+    swprintf(dir, ARRAY_SIZE(dir), L"%s\\Microsoft", base);
+    if (create_dir) CreateDirectoryW(dir, NULL);
+    swprintf(dir, ARRAY_SIZE(dir), L"%s\\Microsoft\\CloudFiles", base);
+    if (create_dir) CreateDirectoryW(dir, NULL);
+    swprintf(out, len, L"%s\\%08lx-%08lx%08lx.sgcf", dir, info.dwVolumeSerialNumber, info.nFileIndexHigh,
+            info.nFileIndexLow);
+    return TRUE;
+}
+
+static BOOL meta_read(const WCHAR *path, struct meta *meta)
+{
+    WCHAR store[MAX_PATH + 64];
+    DWORD read;
+    HANDLE file;
+    BOOL ret;
+
+    if (!meta_file_name(path, store, ARRAY_SIZE(store), FALSE)) return FALSE;
+    file = CreateFileW(store, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+            OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    memset(meta, 0, sizeof(*meta));
+    ret = ReadFile(file, meta, sizeof(*meta), &read, NULL) && read >= FIELD_OFFSET(struct meta, identity)
+            && meta->magic == META_MAGIC && meta->identity_length <= META_MAX_IDENTITY
+            && meta->range_count <= META_MAX_RANGES;
+    CloseHandle(file);
+    return ret;
+}
+
+static BOOL meta_write(const WCHAR *path, const struct meta *meta)
+{
+    WCHAR store[MAX_PATH + 64];
+    DWORD written, size = FIELD_OFFSET(struct meta, identity) + meta->identity_length;
+    HANDLE file;
+    BOOL ret;
+
+    if (!meta_file_name(path, store, ARRAY_SIZE(store), TRUE)) return FALSE;
+    file = CreateFileW(store, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+            CREATE_ALWAYS, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ret = WriteFile(file, meta, size, &written, NULL) && written == size;
+    CloseHandle(file);
+    return ret;
+}
+
+static void meta_delete(const WCHAR *path)
+{
+    WCHAR store[MAX_PATH + 64];
+
+    if (meta_file_name(path, store, ARRAY_SIZE(store), FALSE)) DeleteFileW(store);
+}
+
+static void meta_init(struct meta *meta, LONGLONG size, const void *identity, DWORD identity_length)
+{
+    memset(meta, 0, sizeof(*meta));
+    meta->magic = META_MAGIC;
+    meta->version = 1;
+    meta->flags = META_PLACEHOLDER;
+    meta->pin_state = CF_PIN_STATE_UNSPECIFIED;
+    meta->size = size;
+    if (identity && identity_length && identity_length <= META_MAX_IDENTITY)
+    {
+        memcpy(meta->identity, identity, identity_length);
+        meta->identity_length = identity_length;
+    }
+}
+
+/* Records that [start, start + length) is on disk, merging neighbours. */
+static void meta_add_range(struct meta *meta, LONGLONG start, LONGLONG length)
+{
+    LONGLONG end = start + length;
+    DWORD i, out = 0;
+
+    if (length <= 0) return;
+    for (i = 0; i < meta->range_count; i++)
+    {
+        struct range *r = &meta->ranges[i];
+
+        if (r->start <= end && start <= r->start + r->length)
+        {
+            LONGLONG rend = r->start + r->length;
+            if (r->start < start) start = r->start;
+            if (rend > end) end = rend;
+        }
+        else
+            meta->ranges[out++] = *r;
+    }
+    if (out == META_MAX_RANGES)
+    {
+        /* too fragmented to track: keep the widest span */
+        meta->ranges[0].start = min(meta->ranges[0].start, start);
+        meta->ranges[0].length = max(meta->ranges[0].start + meta->ranges[0].length, end) - meta->ranges[0].start;
+        meta->range_count = 1;
+        return;
+    }
+    meta->ranges[out].start = start;
+    meta->ranges[out].length = end - start;
+    meta->range_count = out + 1;
+    if (meta->range_count == 1 && meta->ranges[0].start == 0 && meta->ranges[0].length >= meta->size)
+        meta->flags |= META_FULL;
+}
+
+static BOOL meta_covers(const struct meta *meta, LONGLONG start, LONGLONG length)
+{
+    DWORD i;
+
+    if (length <= 0) return TRUE;
+    for (i = 0; i < meta->range_count; i++)
+        if (meta->ranges[i].start <= start && meta->ranges[i].start + meta->ranges[i].length >= start + length)
+            return TRUE;
+    return FALSE;
+}
+
+static DWORD pin_attributes(DWORD pin)
+{
+    switch (pin)
+    {
+        case CF_PIN_STATE_PINNED: return 0x00080000; /* FILE_ATTRIBUTE_PINNED */
+        case CF_PIN_STATE_UNPINNED: return 0x00100000; /* FILE_ATTRIBUTE_UNPINNED */
+        default: return 0;
+    }
+}
+
+static void apply_attributes(const WCHAR *path, const struct meta *meta)
+{
+    DWORD attr = GetFileAttributesW(path);
+
+    if (attr == INVALID_FILE_ATTRIBUTES) return;
+    attr &= ~(0x00080000 | 0x00100000);
+    attr |= pin_attributes(meta->pin_state);
+    SetFileAttributesW(path, attr);
+}
+
+/* ---- sync roots and connections -------------------------------------------- */
+
+struct connection
+{
+    LONGLONG key;
+    WCHAR root[MAX_PATH];
+    CF_CALLBACK_REGISTRATION callbacks[16];
+    DWORD callback_count;
+    void *context;
+    BYTE *identity;
+    DWORD identity_length;
+    LONGLONG progress_total, progress_completed;
+};
+
+static CRITICAL_SECTION cs;
+static CRITICAL_SECTION_DEBUG cs_debug =
+{
+    0, 0, &cs, { &cs_debug.ProcessLocksList, &cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": cs") }
+};
+static CRITICAL_SECTION cs = { &cs_debug, -1, 0, 0, 0, 0 };
+
+static struct connection **connections;
+static size_t connection_count;
+static LONGLONG next_key = 0x1000;
+
+/* An open request: its transfer key stands for a file; failures a provider reports are recorded. */
+struct request
+{
+    LONGLONG transfer_key;
+    WCHAR path[MAX_PATH];
+    LONG status;
+    BOOL failed;
+};
+
+static struct request requests[32];
+static size_t request_count;
+
+static struct connection *find_connection(LONGLONG key)
+{
+    size_t i;
+
+    for (i = 0; i < connection_count; i++)
+        if (connections[i]->key == key) return connections[i];
+    return NULL;
+}
+
+static struct connection *find_connection_for_path(const WCHAR *path)
+{
+    struct connection *best = NULL;
+    size_t i;
+
+    for (i = 0; i < connection_count; i++)
+        if (path_under(connections[i]->root, path)
+                && (!best || wcslen(connections[i]->root) > wcslen(best->root)))
+            best = connections[i];
+    return best;
+}
+
+static LONGLONG file_key(const WCHAR *path)
+{
+    BY_HANDLE_FILE_INFORMATION info;
+    HANDLE file = CreateFileW(path, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+            FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    LONGLONG key = 0;
+
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    if (GetFileInformationByHandle(file, &info))
+        key = ((LONGLONG)info.nFileIndexHigh << 32) | info.nFileIndexLow;
+    CloseHandle(file);
+    return key;
+}
+
+static struct request *request_find(LONGLONG transfer_key)
+{
+    size_t i;
+
+    for (i = 0; i < request_count; i++)
+        if (requests[i].transfer_key == transfer_key) return &requests[i];
+    return NULL;
+}
+
+static struct request *request_add(const WCHAR *path)
+{
+    struct request *req;
+    LONGLONG key = file_key(path);
+
+    if ((req = request_find(key))) return req;
+    if (request_count == ARRAY_SIZE(requests)) request_count--; /* drop the newest: the table is a cache */
+    req = &requests[request_count++];
+    req->transfer_key = key;
+    wcscpy(req->path, path);
+    req->status = 0;
+    req->failed = FALSE;
+    return req;
+}
+
+static BOOL sync_root_for_path(const WCHAR *path, WCHAR *root, DWORD len)
+{
+    HKEY key;
+    DWORD i;
+    BOOL found = FALSE;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, CF_SYNC_ROOT_KEY, 0, KEY_READ, &key)) return FALSE;
+    for (i = 0; !found; i++)
+    {
+        WCHAR name[256], value[MAX_PATH];
+        DWORD name_len = ARRAY_SIZE(name), size = sizeof(value);
+        HKEY sub;
+
+        if (RegEnumKeyExW(key, i, name, &name_len, NULL, NULL, NULL, NULL)) break;
+        if (RegOpenKeyExW(key, name, 0, KEY_READ, &sub)) continue;
+        if (!RegGetValueW(sub, NULL, L"Path", RRF_RT_REG_SZ, NULL, value, &size) && path_under(value, path))
+        {
+            lstrcpynW(root, value, len);
+            found = TRUE;
+        }
+        RegCloseKey(sub);
+    }
+    RegCloseKey(key);
+    return found;
+}
+
+static void root_key_name(const WCHAR *provider, const WCHAR *root, WCHAR *name, size_t len)
+{
+    DWORD hash = 5381;
+    const WCHAR *p;
+
+    for (p = root; *p; p++) hash = hash * 33 + towlower(*p);
+    swprintf(name, len, L"%s!%08lx", provider, hash);
+}
