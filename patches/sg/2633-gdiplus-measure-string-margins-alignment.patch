From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: string measuring margins and alignments, nearest colour of 16 bit surfaces

The Wine tests record how Windows measures strings and the measured sizes it gives; these
were todo and now hold.

 - GdipMeasureString makes the box an eighth of the font's size higher than the line (the
   region of the characters is not), counted in the units of the world transform, and a
   layout rectangle lower than that cuts the box.
 - The box of the string sits in the layout rectangle as the alignment and the line alignment
   of the format say (also for an empty rectangle: the text is centred around the point), and so do
   the regions GdipMeasureCharacterRanges gives for the lines: moved by the line alignment, and
   by the left margin for the horizontal one.
 - GdipGetNearestColor of a 16 bit surface drops the low bits of each channel (565, 555,
   1555) as the tests expect, without rounding and with an opaque alpha for the formats
   with none.
 - Removed 23 todo_wine marks and narrowed 3 more of graphics.c (measure, measure ranges, nearest colour).
---
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -5223,6 +5223,26 @@ GpStatus WINGDIPAPI GdipGetNearestColor(GpGraphics *graphics, ARGB* argb)
         GpBitmap *bitmap = (GpBitmap *)graphics->image;
         if (IsIndexedPixelFormat(bitmap->format) && !once++)
             FIXME("(%p, %p): Passing color unmodified\n", graphics, argb);
+
+        /* the colour the surface can show: the low bits of each channel a
+         * 16 bit format cannot hold are dropped, with no rounding */
+        switch (bitmap->format)
+        {
+        case PixelFormat16bppRGB565:
+#ifdef SG_MUTANT_GPMEAS_NEAREST_565
+            break;
+#endif
+            *argb = 0xff000000 | (*argb & 0xf80000) | (*argb & 0x00fc00) | (*argb & 0x0000f8);
+            break;
+        case PixelFormat16bppRGB555:
+            *argb = 0xff000000 | (*argb & 0xf8f8f8);
+            break;
+        case PixelFormat16bppARGB1555:
+            *argb = ((*argb & 0x80000000) ? 0xff000000 : 0) | (*argb & 0xf8f8f8);
+            break;
+        default:
+            break;
+        }
     }
 
     return Ok;
@@ -5885,6 +5905,7 @@ void transform_properties(GpGraphics *graphics, GDIPCONST GpMatrix *matrix, BOOL
 struct measure_ranges_args {
     GpRegion **regions;
     REAL rel_width, rel_height;
+    REAL text_bottom;
 };
 
 static GpStatus measure_ranges_callback(struct gdip_format_string_info *info)
@@ -5905,6 +5926,8 @@ static GpStatus measure_ranges_callback(struct gdip_format_string_info *info)
 
             range_rect.Y = info->bounds->Y / args->rel_height;
             range_rect.Height = info->bounds->Height / args->rel_height;
+            if (range_rect.Y + range_rect.Height > args->text_bottom)
+                args->text_bottom = range_rect.Y + range_rect.Height;
 
             font_link_get_text_extent_point(info, info->index, range_start - info->index, INT_MAX, NULL, &range_size);
             range_rect.X = (info->bounds->X + range_size.cx) / args->rel_width;
@@ -5987,6 +6010,7 @@ GpStatus WINGDIPAPI GdipMeasureCharacterRanges(GpGraphics* graphics,
     }
 
     args.regions = regions;
+    args.text_bottom = layoutRect->Y;
 
     gdi_transform_acquire(graphics);
 
@@ -5995,6 +6019,29 @@ GpStatus WINGDIPAPI GdipMeasureCharacterRanges(GpGraphics* graphics,
 
     gdi_transform_release(graphics);
 
+    /* the alignment places the text without the left margin */
+    if (stat == Ok && stringFormat->align != StringAlignmentNear && margin_x != 0.0)
+    {
+        REAL dx = -margin_x;
+
+        for (i = 0; i < stringFormat->range_count && stat == Ok; i++)
+            stat = GdipTranslateRegion(regions[i], dx, 0.0);
+    }
+
+    /* the lines sit in the rectangle as the line alignment says */
+#ifdef SG_MUTANT_GPMEAS_RANGE_ALIGN
+    if (0)
+#else
+    if (stat == Ok && stringFormat->line_align != StringAlignmentNear && args.text_bottom > layoutRect->Y)
+#endif
+    {
+        REAL dy = layoutRect->Height - (args.text_bottom - layoutRect->Y);
+
+        if (stringFormat->line_align == StringAlignmentCenter) dy /= 2.0;
+        for (i = 0; i < stringFormat->range_count && stat == Ok; i++)
+            stat = GdipTranslateRegion(regions[i], 0.0, dy);
+    }
+
     SelectObject(hdc, oldfont);
     DeleteObject(gdifont);
 
@@ -6034,18 +6081,6 @@ static GpStatus measure_string_callback(struct gdip_format_string_info *info)
     if (args->linesfilled)
         (*args->linesfilled)++;
 
-    switch (info->format ? info->format->align : StringAlignmentNear)
-    {
-    case StringAlignmentCenter:
-        bounds->X = bounds->X + (info->rect->Width/2) - (bounds->Width/2);
-        break;
-    case StringAlignmentFar:
-        bounds->X = bounds->X + info->rect->Width - bounds->Width;
-        break;
-    default:
-        break;
-    }
-
     return Ok;
 }
 
@@ -6064,6 +6099,7 @@ GpStatus WINGDIPAPI GdipMeasureString(GpGraphics *graphics,
     HDC temp_hdc=NULL, hdc;
     RectF scaled_rect;
     REAL margin_x;
+    LOGFONTW lfw;
     INT lines, glyphs;
 
     TRACE("(%p, %s, %i, %p, %s, %p, %p, %p, %p)\n", graphics,
@@ -6109,7 +6145,7 @@ GpStatus WINGDIPAPI GdipMeasureString(GpGraphics *graphics,
     if (scaled_rect.Width >= 1 << 23) scaled_rect.Width = 1 << 23;
     if (scaled_rect.Height >= 1 << 23) scaled_rect.Height = 1 << 23;
 
-    get_font_hfont(graphics, font, format, &gdifont, NULL, NULL);
+    get_font_hfont(graphics, font, format, &gdifont, &lfw, NULL);
     oldfont = SelectObject(hdc, gdifont);
 
     set_rect(bounds, rect->X, rect->Y, 0.0f, 0.0f);
@@ -6130,7 +6166,49 @@ GpStatus WINGDIPAPI GdipMeasureString(GpGraphics *graphics,
     if (codepointsfitted) *codepointsfitted = glyphs;
 
     if (lines)
+    {
         bounds->Width += margin_x * 2.0;
+#ifdef SG_MUTANT_GPMEAS_NO_MARGIN
+        if (0)
+#else
+        if (!(format && format->generic_typographic))
+#endif
+            bounds->Height += abs(lfw.lfHeight) / 8.0 / args.rel_height;
+        if (rect->Height > 0.0 && bounds->Height > rect->Height)
+            bounds->Height = rect->Height;
+
+        /* the box of the text sits in the rectangle as the alignments say */
+#ifdef SG_MUTANT_GPMEAS_ALIGN_X
+        switch (StringAlignmentNear)
+#else
+        switch (format ? format->align : StringAlignmentNear)
+#endif
+        {
+        case StringAlignmentCenter:
+            bounds->X = rect->X + rect->Width / 2.0 - bounds->Width / 2.0;
+            break;
+        case StringAlignmentFar:
+            bounds->X = rect->X + rect->Width - bounds->Width;
+            break;
+        default:
+            break;
+        }
+#ifdef SG_MUTANT_GPMEAS_LINE_ALIGN
+        switch (StringAlignmentNear)
+#else
+        switch (format ? format->line_align : StringAlignmentNear)
+#endif
+        {
+        case StringAlignmentCenter:
+            bounds->Y = rect->Y + rect->Height / 2.0 - bounds->Height / 2.0;
+            break;
+        case StringAlignmentFar:
+            bounds->Y = rect->Y + rect->Height - bounds->Height;
+            break;
+        default:
+            break;
+        }
+    }
 
     SelectObject(hdc, oldfont);
     DeleteObject(gdifont);
