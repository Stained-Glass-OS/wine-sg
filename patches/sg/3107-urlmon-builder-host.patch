From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 21:19:45 -0700
Subject: [PATCH] urlmon: an IUriBuilder made from a URI with a port can change
 another part

Building a URI from a builder that came from a URI such as
http://host:8080/path failed with INET_E_INVALID_URL as soon as any part was
set: the host taken from the original URI was validated together with
everything after it, so the port made it look invalid. Only the host itself
is validated now.

diff --git a/dlls/urlmon/uri.c b/dlls/urlmon/uri.c
index debfd71..2a44516 100644
--- a/dlls/urlmon/uri.c
+++ b/dlls/urlmon/uri.c
@@ -3307,14 +3307,25 @@ static HRESULT validate_userinfo(const UriBuilder *builder, parse_data *data, DW
 static HRESULT validate_host(const UriBuilder *builder, parse_data *data) {
     const WCHAR *ptr;
     const WCHAR **pptr;
+    WCHAR *copy = NULL;
     DWORD expected_len;
+    HRESULT hr = S_OK;
 
     if(builder->host) {
         ptr = builder->host;
         expected_len = builder->host_len;
     } else if(!(builder->modified_props & Uri_HAS_HOST) && builder->uri && builder->uri->host_start > -1) {
-        ptr = builder->uri->canon_uri + builder->uri->host_start;
+        /* The host of the URI is followed by what comes after it (a port, a path): only the host
+         * itself is examined. */
         expected_len = builder->uri->host_len;
+        if(!(copy = malloc((expected_len + 1) * sizeof(WCHAR))))
+            return E_OUTOFMEMORY;
+        memcpy(copy, builder->uri->canon_uri + builder->uri->host_start, expected_len * sizeof(WCHAR));
+        copy[expected_len] = 0;
+        ptr = copy;
+#ifdef SG_MUTANT_URLMON_HOSTCOPY
+        ptr = builder->uri->canon_uri + builder->uri->host_start;
+#endif
     } else
         ptr = NULL;
 
@@ -3323,17 +3334,22 @@ static HRESULT validate_host(const UriBuilder *builder, parse_data *data) {
         DWORD extras = ALLOW_BRACKETLESS_IP_LITERAL|IGNORE_PORT_DELIMITER|SKIP_IP_FUTURE_CHECK;
         pptr = &ptr;
 
-        if(parse_host(pptr, data, extras) && data->host_len == expected_len)
+        if(parse_host(pptr, data, extras) && data->host_len == expected_len) {
             TRACE("(%p %p): Found valid host name %s len=%ld type=%d.\n", builder, data,
                 debugstr_wn(data->host, data->host_len), data->host_len, data->host_type);
-        else {
+            if(copy) {
+                /* the parsed host must point into the URI, not into the copy */
+                data->host = builder->uri->canon_uri + builder->uri->host_start;
+            }
+        }else {
             TRACE("(%p %p): Invalid host name found %s.\n", builder, data,
                 debugstr_wn(component, expected_len));
-            return INET_E_INVALID_URL;
+            hr = INET_E_INVALID_URL;
         }
     }
 
-    return S_OK;
+    free(copy);
+    return hr;
 }
 
 static void setup_port(const UriBuilder *builder, parse_data *data, DWORD flags) {
