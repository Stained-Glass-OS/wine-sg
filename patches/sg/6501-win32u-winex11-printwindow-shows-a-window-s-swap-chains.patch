From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winex11: PrintWindow shows a window's swap chains (6501)

PrintWindow with PW_RENDERFULLCONTENT -- the taskbar's hover
thumbnails, Task View, Alt+Tab, DwmRegisterThumbnail -- copied what the
window last drew on its window surface, where a swap chain's frames
never are: Chromium's and Electron's windows (Opera, Dropbox), presented
by their GPU process, were white thumbnails; Office's Vulkan panes white.
On Windows the compositor has them. The window's process now asks the
display driver (winex11's X11DRV_SG_PRINT_FRAMES escape) to put over the
picture what the window shows in the parts its surface leaves to swap
chains (6500, OpenGL windows) -- from the pixmap the desktop's
compositor keeps of the window, covered or not, or where it is visible
-- and the last frames of its child windows' own swap chains (1523),
from the redirected windows that keep them.
---
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index d294484..e0732f4 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -2417,6 +2417,70 @@ static BITMAPINFO print_window_info( int width, int height )
  * section. PW_RENDERFULLCONTENT copies what the window last drew on its
  * surface -- as the compositor has it on Windows, and there even for a
  * cloaked or covered window; otherwise WM_PRINT, as PrintWindow does. */
+/* Stained Glass OS (wine-sg 6501): what a window shows of swap chains (Direct3D, Vulkan,
+ * OpenGL; Chromium's GPU process presents into the browser's windows, 6500) is not on its
+ * window surface, which leaves those parts out: the display driver puts them, and its
+ * child windows' own swap chains' frames, over the picture (winex11's
+ * X11DRV_SG_PRINT_FRAMES escape; the layout of its struct x11drv_escape_sg_print_frames). */
+struct print_frames_escape
+{
+    int         code;
+    HWND        hwnd;
+    int         x;
+    int         y;
+    int         width;
+    int         height;
+    void       *bits;
+    const RECT *rects;
+    UINT        count;
+};
+
+static void print_window_frames( HWND hwnd, struct window_surface *surface, void *bits, int width, int height,
+                                 UINT flags )
+{
+    struct print_frames_escape escape = { 0x534a, hwnd, 0, 0, width, height, bits, NULL, 0 };
+    struct window_rects rects;
+    RGNDATA *data = NULL;
+    HRGN holes = 0;
+    DWORD size;
+    HDC hdc;
+
+#ifdef SG_MUTANT_PRINT_NO_FRAMES
+    return;
+#endif
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) != NtUserGetDesktopWindow()) return;
+    if (!get_window_rects( hwnd, COORDS_PARENT, &rects, get_thread_dpi() )) return;
+    escape.x = rects.visible.left - ((flags & PW_CLIENTONLY) ? rects.client.left : rects.window.left);
+    escape.y = rects.visible.top - ((flags & PW_CLIENTONLY) ? rects.client.top : rects.window.top);
+
+    /* the parts the surface leaves to swap chains: all of it but its clip region */
+    if (surface)
+    {
+        window_surface_lock( surface );
+        if (surface->clip_region && (holes = NtGdiCreateRectRgn( surface->rect.left, surface->rect.top,
+                                                                  surface->rect.right, surface->rect.bottom )))
+        {
+            NtGdiCombineRgn( holes, holes, surface->clip_region, RGN_DIFF );
+            /* not what is outside the window's shape (rounded corners) */
+            if (surface->shape_region) NtGdiCombineRgn( holes, holes, surface->shape_region, RGN_AND );
+        }
+        window_surface_unlock( surface );
+    }
+    if (holes && (size = NtGdiGetRegionData( holes, 0, NULL )) && (data = malloc( size )) &&
+        NtGdiGetRegionData( holes, size, data ))
+    {
+        escape.rects = (const RECT *)data->Buffer;
+        escape.count = data->rdh.nCount;
+    }
+    if ((hdc = NtUserGetDCEx( hwnd, 0, DCX_WINDOW | DCX_CACHE )))
+    {
+        NtGdiExtEscape( hdc, NULL, 0, 6789 /* X11DRV_ESCAPE */, sizeof(escape), (char *)&escape, 0, NULL );
+        NtUserReleaseDC( hwnd, hdc );
+    }
+    free( data );
+    if (holes) NtGdiDeleteObjectApp( holes );
+}
+
 LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam )
 {
     int width = (lparam >> 15) & 0x7fff, height = lparam & 0x7fff;
@@ -2455,8 +2519,9 @@ LRESULT print_window_to_section( HWND hwnd, HANDLE section, LPARAM lparam )
             if (!(flags & PW_CLIENTONLY)) prf |= PRF_NONCLIENT;
             send_message( hwnd, WM_PRINT, (WPARAM)hdc, prf );
         }
-        if (surface) window_surface_release( surface );
         NtGdiFlush();
+        if (flags & PW_RENDERFULLCONTENT) print_window_frames( hwnd, surface, bits, width, height, flags );
+        if (surface) window_surface_release( surface );
         NtGdiDeleteObjectApp( bitmap );
         ret = 1;
     }
diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index 0061664..94579ea 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -443,6 +443,10 @@ static INT X11DRV_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID in_d
                 if (in_count >= sizeof(struct x11drv_escape_sg_background_part))
                     return set_desktop_part( in_data );
                 break;
+            case X11DRV_SG_PRINT_FRAMES:
+                if (in_count >= sizeof(struct x11drv_escape_sg_print_frames))
+                    return print_window_frames( in_data );
+                break;
             case X11DRV_SG_DESKTOP_WALLPAPER:
                 if (in_count >= sizeof(struct x11drv_escape_sg_background))
                     return set_desktop_wallpaper( in_data );
diff --git a/dlls/winex11.drv/vulkan.c b/dlls/winex11.drv/vulkan.c
index 49e5ec6..cfd071c 100644
--- a/dlls/winex11.drv/vulkan.c
+++ b/dlls/winex11.drv/vulkan.c
@@ -641,6 +641,37 @@ static void X11DRV_vulkan_surface_presented( HWND hwnd, void *private, VkResult
     if (hdc) NtUserReleaseDC( hwnd, hdc );
 }
 
+/* Stained Glass OS (wine-sg 6501): the frames of this process's child windows' swap
+ * chains shown in WHOLE (1523), from the redirected windows that keep them, put into the
+ * picture with PUT -- a child's over its parent's, as they are shown */
+static void print_shown_frames( Window whole, void (*put)( Drawable, int, int, const XRectangle *, void * ),
+                                void *ctx )
+{
+    struct x11drv_vulkan_surface *surface;
+    int depth, max_depth = -1, i;
+
+    pthread_mutex_lock( &shown_mutex );
+    LIST_FOR_EACH_ENTRY( surface, &shown_surfaces, struct x11drv_vulkan_surface, shown_entry )
+        if (surface->shown_on == whole) max_depth = max( max_depth, surface->shown_depth );
+    for (depth = 0; depth <= max_depth; depth++)
+    {
+        LIST_FOR_EACH_ENTRY( surface, &shown_surfaces, struct x11drv_vulkan_surface, shown_entry )
+        {
+            XRectangle full;
+
+            if (surface->shown_on != whole || surface->shown_depth != depth) continue;
+            full.x = surface->shown_rect.left;
+            full.y = surface->shown_rect.top;
+            full.width = surface->shown_rect.right - surface->shown_rect.left;
+            full.height = surface->shown_rect.bottom - surface->shown_rect.top;
+            if (surface->shown_clip_count < 0) put( surface->window, full.x, full.y, &full, ctx );
+            else for (i = 0; i < surface->shown_clip_count; i++)
+                put( surface->window, full.x, full.y, &surface->shown_clip[i], ctx );
+        }
+    }
+    pthread_mutex_unlock( &shown_mutex );
+}
+
 static VkBool32 X11DRV_vkGetPhysicalDeviceWin32PresentationSupportKHR(VkPhysicalDevice phys_dev,
         uint32_t index)
 {
@@ -686,6 +717,11 @@ UINT X11DRV_VulkanInit( UINT version, void *vulkan_handle, const struct vulkan_d
 
 #else /* No vulkan */
 
+static void print_shown_frames( Window whole, void (*put)( Drawable, int, int, const XRectangle *, void * ),
+                                void *ctx )
+{
+}
+
 UINT X11DRV_VulkanInit( UINT version, void *vulkan_handle, const struct vulkan_driver_funcs **driver_funcs )
 {
     ERR( "Wine was built without Vulkan support.\n" );
@@ -693,3 +729,168 @@ UINT X11DRV_VulkanInit( UINT version, void *vulkan_handle, const struct vulkan_d
 }
 
 #endif /* SONAME_LIBVULKAN */
+
+/* Stained Glass OS (wine-sg 6501): PrintWindow with PW_RENDERFULLCONTENT -- the taskbar's
+ * hover thumbnails, Task View and Alt+Tab, DwmRegisterThumbnail -- copied what the window
+ * last drew on its window surface, where a swap chain's frames never are: Chromium's and
+ * Electron's windows (Opera, Dropbox), presented by their GPU process, were white
+ * thumbnails, Office's Vulkan panes white, games black. As Windows' compositor has them,
+ * what the window shows in the parts its surface leaves to swap chains (6500: another
+ * process's, in place or copied; OpenGL windows) is taken from X -- from the pixmap the
+ * desktop's compositor keeps of the window, covered or not, or, without one, where it is
+ * visible -- and its child windows' own swap chains' last frames from the redirected
+ * windows that keep them (1523). */
+struct print_context
+{
+    const struct x11drv_escape_sg_print_frames *print;
+    int done;
+};
+
+/* rectangle R (X window coordinates) of DRAWABLE, which lies at OX,OY in the X window, into the picture */
+static void print_put( Drawable drawable, int ox, int oy, const XRectangle *r, void *arg )
+{
+    struct print_context *ctx = arg;
+    const struct x11drv_escape_sg_print_frames *print = ctx->print;
+    XImage *image;
+    int x, y;
+
+    if (!r->width || !r->height) return;
+    if (!(image = XGetImage( gdi_display, drawable, r->x - ox, r->y - oy, r->width, r->height, AllPlanes, ZPixmap )))
+        return;
+    if (image->bits_per_pixel == 32)
+    {
+        for (y = 0; y < r->height; y++)
+        {
+            const DWORD *src = (const DWORD *)(image->data + y * image->bytes_per_line);
+            int dy = print->y + r->y + y;
+            DWORD *dst;
+
+            if (dy < 0 || dy >= print->height) continue;
+            dst = (DWORD *)print->bits + dy * print->width;
+            for (x = 0; x < r->width; x++)
+            {
+                int dx = print->x + r->x + x;
+                if (dx >= 0 && dx < print->width) dst[dx] = src[x] | 0xff000000;
+            }
+        }
+        ctx->done++;
+    }
+    XDestroyImage( image );
+}
+
+static int print_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+BOOL print_window_frames( const struct x11drv_escape_sg_print_frames *print )
+{
+    struct print_context ctx = { print, 0 };
+    struct x11drv_win_data *data;
+    XRectangle *parts = NULL;
+    Pixmap pixmap = 0;
+    Window whole;
+    RECT visible;
+    UINT i, nparts = 0;
+
+    if (!print->bits || print->width <= 0 || print->height <= 0) return FALSE;
+    if (!(data = get_win_data( print->hwnd ))) return FALSE;
+    whole = data->whole_window;
+    visible = data->rects.visible;
+    release_win_data( data );
+    if (!whole) return FALSE;
+
+    if (print->count && print->rects)
+    {
+#ifdef SONAME_LIBXCOMPOSITE
+        /* what the desktop's compositor keeps of the window, if one redirects it */
+        if (usexcomposite)
+        {
+            X11DRV_expect_error( gdi_display, print_error, NULL );
+            pixmap = pXCompositeNameWindowPixmap( gdi_display, whole );
+            XSync( gdi_display, False );
+            if (X11DRV_check_error()) pixmap = 0;  /* not redirected */
+        }
+#endif
+        if (pixmap)
+        {
+            if ((parts = malloc( print->count * sizeof(*parts) )))
+                for (i = 0; i < print->count; i++, nparts++)
+                {
+                    parts[nparts].x = print->rects[i].left;
+                    parts[nparts].y = print->rects[i].top;
+                    parts[nparts].width = print->rects[i].right - print->rects[i].left;
+                    parts[nparts].height = print->rects[i].bottom - print->rects[i].top;
+                }
+        }
+        else
+        {
+            /* where the window is visible on the screen, then (its system region, in
+             * screen coordinates; win32u calls are made before X errors are expected) */
+            HDC hdc = NtUserGetDCEx( print->hwnd, 0, DCX_WINDOW | DCX_CACHE );
+            HRGN region = NtGdiCreateRectRgn( 0, 0, 0, 0 ), part = NtGdiCreateRectRgn( 0, 0, 0, 0 ), rect;
+            POINT origin = { visible.left, visible.top };
+            DWORD size;
+            RGNDATA *rd;
+
+            NtUserMapWindowPoints( NtUserGetAncestor( print->hwnd, GA_PARENT ), 0, &origin, 1,
+                                   NtUserGetWinMonitorDpi( print->hwnd, MDT_RAW_DPI ) );
+            if (hdc && region && part && NtGdiGetRandomRgn( hdc, region, SYSRGN ) > 0)
+            {
+                NtGdiOffsetRgn( region, -origin.x, -origin.y );
+                for (i = 0; i < print->count; i++)
+                {
+                    if (!(rect = NtGdiCreateRectRgn( print->rects[i].left, print->rects[i].top,
+                                                     print->rects[i].right, print->rects[i].bottom )))
+                        continue;
+                    NtGdiCombineRgn( part, part, rect, RGN_OR );
+                    NtGdiDeleteObjectApp( rect );
+                }
+                if (NtGdiCombineRgn( part, part, region, RGN_AND ) > NULLREGION &&
+                    (size = NtGdiGetRegionData( part, 0, NULL )) && (rd = malloc( size )))
+                {
+                    if (NtGdiGetRegionData( part, size, rd ) &&
+                        (parts = malloc( max( 1, rd->rdh.nCount ) * sizeof(*parts) )))
+                    {
+                        const RECT *v = (const RECT *)rd->Buffer;
+                        for (i = 0; i < rd->rdh.nCount; i++, nparts++)
+                        {
+                            parts[nparts].x = v[i].left;
+                            parts[nparts].y = v[i].top;
+                            parts[nparts].width = v[i].right - v[i].left;
+                            parts[nparts].height = v[i].bottom - v[i].top;
+                        }
+                    }
+                    free( rd );
+                }
+            }
+            if (part) NtGdiDeleteObjectApp( part );
+            if (region) NtGdiDeleteObjectApp( region );
+            if (hdc) NtUserReleaseDC( print->hwnd, hdc );
+        }
+    }
+
+    X11DRV_expect_error( gdi_display, print_error, NULL );
+    for (i = 0; i < nparts; i++)
+    {
+        /* inside the X window (a surface may be larger) */
+        int right = min( parts[i].x + parts[i].width, visible.right - visible.left );
+        int bottom = min( parts[i].y + parts[i].height, visible.bottom - visible.top );
+        XRectangle r;
+
+        r.x = max( 0, parts[i].x );
+        r.y = max( 0, parts[i].y );
+        if (right <= r.x || bottom <= r.y) continue;
+        r.width = right - r.x;
+        r.height = bottom - r.y;
+        print_put( pixmap ? pixmap : whole, 0, 0, &r, &ctx );
+    }
+    print_shown_frames( whole, print_put, &ctx );
+    if (pixmap) XFreePixmap( gdi_display, pixmap );
+    XSync( gdi_display, False );
+    X11DRV_check_error();
+    free( parts );
+    TRACE( "%p: %u parts left to swap chains, %d put into its picture (%s)\n", print->hwnd, print->count, ctx.done,
+           pixmap ? "from the compositor's pixmap" : "where it is visible" );
+    return ctx.done > 0;
+}
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index b845b81..3e88a3f 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -345,6 +345,25 @@ enum x11drv_escape_codes
     X11DRV_SG_DESKTOP_BACKGROUND = 0x5347, /* Stained Glass OS: the desktop's picture, for X to show */
     X11DRV_SG_DESKTOP_WALLPAPER = 0x5348,  /* Stained Glass OS: the desktop's picture without its icons */
     X11DRV_SG_DESKTOP_PART = 0x5349,       /* Stained Glass OS: a part of the desktop's picture, drawn again */
+    X11DRV_SG_PRINT_FRAMES = 0x534a,       /* Stained Glass OS: a window's swap chains' frames, into its picture */
+};
+
+/* PrintWindow with PW_RENDERFULLCONTENT (wine-sg 6501): what HWND, a top-level of this
+ * process, shows in its X window put into its picture BITS (32-bit top-down, WIDTH x
+ * HEIGHT), in which the X window lies at X,Y: the RECTS (X window coordinates) its window
+ * surface leaves to swap chains, and the frames of its child windows' own swap chains.
+ * win32u's dce.c has the same layout. */
+struct x11drv_escape_sg_print_frames
+{
+    enum x11drv_escape_codes code;         /* escape code (X11DRV_SG_PRINT_FRAMES) */
+    HWND                     hwnd;
+    int                      x;
+    int                      y;
+    int                      width;
+    int                      height;
+    void                    *bits;
+    const RECT              *rects;
+    UINT                     count;
 };
 
 /* The virtual desktop's picture -- wallpaper and icons, 32-bit top-down BGRX,
@@ -758,6 +777,7 @@ extern Window create_client_window( HWND hwnd, const XVisualInfo *visual, Colorm
 extern void detach_client_window( struct x11drv_win_data *data, Window client_window );
 extern void vulkan_surfaces_reshow( Window window, const RECT *rect );
 extern void vulkan_surfaces_window_changed( HWND hwnd );
+extern BOOL print_window_frames( const struct x11drv_escape_sg_print_frames *print );
 extern void attach_client_window( struct x11drv_win_data *data, Window client_window );
 extern void destroy_client_window( HWND hwnd, Window client_window );
 extern void set_window_visual( struct x11drv_win_data *data, const XVisualInfo *vis, BOOL use_alpha );
