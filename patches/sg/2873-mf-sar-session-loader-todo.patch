     TRACE("%p.\n", iface);
 
-    if ((object = InterlockedCompareExchangePointer((void **)&activate->object, NULL, activate->object)))
+#ifdef SG_MUTANT_ACTIVATE_RELEASE
+    if (0)
+#else
+    if (activate->funcs->keep_shutdown_object)
+#endif
+    {
+        /* The shut down object stays cached, it is released with the activate. */
+        if ((object = activate->object))
+            activate->funcs->shutdown_object(activate->context, object);
+    }
+    else if ((object = InterlockedCompareExchangePointer((void **)&activate->object, NULL, activate->object)))
     {
         activate->funcs->shutdown_object(activate->context, object);
         IUnknown_Release(object);
