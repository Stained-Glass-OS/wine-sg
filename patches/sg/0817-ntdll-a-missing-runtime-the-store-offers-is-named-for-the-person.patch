From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a missing runtime the store offers is named for the person

Programs and plug-ins written in Visual Basic 6 import MSVBVM60.DLL, the
runtime Windows includes and Wine does not have (it is Microsoft's: we
cannot ship it). When it was missing, LoadLibrary failed and nothing told
the person why -- Meedio's plug-ins "failed to register" (David's compat
sweep). Now, when an import is not found and SG Store offers that DLL
(HKLM\Software\Stained Glass\Store\Runtimes, read in the 64-bit view so
32-bit programs see it too), the loader names it, with the module that
needed it, in HKCU\Software\Stained Glass\Runtimes\Missing; sg-shell's
sg-notify asks whether to install it and opens the store on it. Any other
missing DLL is not named.

Test: test/missingrt-gate.sh with test/missingrt-plugin.c and
test/missingrt-probe.c (mutant SG_MUTANT_NO_RUNTIME_NOTE).
---
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1082,6 +1082,55 @@
 }
 
 
+/* Stained Glass OS: a missing DLL that SG Store offers (its Runtimes key:
+ * msvbvm60.dll, the Visual Basic 6 runtime Windows includes and Wine does
+ * not have) is named, with the module that needed it, in the user's
+ * HKCU\Software\Stained Glass\Runtimes\Missing; sg-shell's sg-notify asks
+ * whether to install it and opens the store on it. Meedio's plug-ins
+ * failed to register for want of it, saying nothing of why. */
+static void sg_note_missing_runtime( const char *name, const WCHAR *needed_by )
+{
+    static const WCHAR runtimesW[] = L"\\Registry\\Machine\\Software\\Stained Glass\\Store\\Runtimes";
+    static const WCHAR *const path[] = { L"Software", L"Stained Glass", L"Runtimes", L"Missing" };
+    UNICODE_STRING str;
+    OBJECT_ATTRIBUTES attr;
+    WCHAR dll[64], *data;
+    const WCHAR *base;
+    HANDLE key, parent, child;
+    char info[256];
+    DWORD size, i;
+    NTSTATUS status;
+
+#ifdef SG_MUTANT_NO_RUNTIME_NOTE
+    return;
+#endif
+    for (i = 0; name[i] && i < ARRAY_SIZE(dll) - 1; i++) dll[i] = (name[i] >= 'A' && name[i] <= 'Z') ? name[i] + 32 : name[i];
+    dll[i] = 0;
+    RtlInitUnicodeString( &str, runtimesW );
+    InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtOpenKey( &key, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &attr )) return;
+    RtlInitUnicodeString( &str, dll );
+    status = NtQueryValueKey( key, &str, KeyValuePartialInformation, info, sizeof(info), &size );
+    NtClose( key );
+    if (status) return;   /* not one the store offers */
+
+    if (RtlOpenCurrentUser( KEY_ALL_ACCESS, &parent )) return;
+    for (i = 0; i < ARRAY_SIZE(path); i++)
+    {
+        RtlInitUnicodeString( &str, path[i] );
+        InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, parent, NULL );
+        status = NtCreateKey( &child, KEY_ALL_ACCESS | KEY_WOW64_64KEY, &attr, 0, NULL, 0, NULL );
+        NtClose( parent );
+        if (status) return;
+        parent = child;
+    }
+    base = needed_by ? wcsrchr( needed_by, '\\' ) : NULL;
+    data = (WCHAR *)(base ? base + 1 : needed_by ? needed_by : L"");
+    RtlInitUnicodeString( &str, dll );
+    NtSetValueKey( parent, &str, 0, REG_SZ, data, (wcslen( data ) + 1) * sizeof(WCHAR) );
+    NtClose( parent );
+}
+
 /*************************************************************************
  *		import_dll
  *
@@ -1124,8 +1173,11 @@
     if (status)
     {
         if (status == STATUS_DLL_NOT_FOUND)
+        {
             ERR("Library %s (which is needed by %s) not found\n",
                 name, debugstr_w(current_modref->ldr.FullDllName.Buffer));
+            sg_note_missing_runtime( name, current_modref->ldr.FullDllName.Buffer );
+        }
         else
             ERR("Loading library %s (which is needed by %s) failed (error %lx).\n",
                 name, debugstr_w(current_modref->ldr.FullDllName.Buffer), status);
