--- a/dlls/windows.ui.xaml/composition.c
+++ b/dlls/windows.ui.xaml/composition.c
@@ -33,6 +33,7 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(xaml);
 
+static const GUID IID_IVisual_x = { 0x117e202d, 0xa859, 0x4c89, { 0x87, 0x3b, 0xc2, 0xaa, 0x56, 0x67, 0x88, 0xe3 } };
 static const GUID IID_ICompositor_x = { 0xb403ca50, 0x7f8c, 0x4e83, { 0x98, 0x5f, 0xcc, 0x45, 0x06, 0x00, 0x36, 0xd8 } };
 enum { ICompositor_CreateContainerVisual_x = 9, ICompositor_CreatePropertySet_x = 18 };
 
@@ -101,8 +102,13 @@ static HRESULT WINAPI ecp_GetElementVisual( struct xfiface *iface, IInspectable
     *visual = NULL;
     if (!elem) return E_INVALIDARG;
     if (!elem->comp_visual && FAILED(hr = compositor_call( ICompositor_CreateContainerVisual_x, &elem->comp_visual ))) return hr;
+    /* the element's Visual (its default interface), not the container interface it was made as */
+#ifndef SG_MUTANT_ELEMENT_VISUAL_AS_CONTAINER
+    return IInspectable_QueryInterface( elem->comp_visual, &IID_IVisual_x, (void **)visual );
+#else
     IInspectable_AddRef( (*visual = elem->comp_visual) );
     return S_OK;
+#endif
 }
 
 static HRESULT WINAPI ecp_GetElementChildVisual( struct xfiface *iface, IInspectable *element, IInspectable **visual )
