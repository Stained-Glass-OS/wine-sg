From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: elements' automation peers, GetElementVisual gives a Visual

FrameworkElementAutomationPeer.CreatePeerForElement gave no peer, and ElementCompositionPreview.GetElementVisual gave the visual's container interface where its Visual was asked for. WinUI 2's NavigationView, given no peer, took the path that animates the selection, called a Visual method through that container interface (a null slot), and Windows Terminal's settings showed no page. An element's peer is now made once and kept by the element (FromElement gives it after; its Owner is the element; it answers UI Automation's questions with defaults and takes the events raised on it). GetElementVisual gives the Visual interface. A ScrollViewer's content that takes whatever it is given no longer makes an infinite extent.
---
diff --git a/dlls/windows.ui.xaml/automation_ids.c b/dlls/windows.ui.xaml/automation_ids.c
index a29407d..04261c7 100644
--- a/dlls/windows.ui.xaml/automation_ids.c
+++ b/dlls/windows.ui.xaml/automation_ids.c
@@ -631,14 +631,142 @@ IActivationFactory *xaml_automation_identifiers_factory( const WCHAR *name )
     return NULL;
 }
 
-/* ---- FrameworkElementAutomationPeer's statics: no element has a peer made here (nothing asks for
- * the UI Automation tree of an island yet), so FromElement and CreatePeerForElement give none ---- */
+/* ---- FrameworkElementAutomationPeer: an element's peer, made when a program asks for it and kept by the
+ * element (FromElement gives it after). Its Owner is the element; what it tells UI Automation is the
+ * defaults (no automation client reads an island's tree here yet), and events raised on it go nowhere ---- */
+
+struct fe_peer
+{
+    struct dobj d;
+    struct xiface IFrameworkElementAutomationPeer_iface, IAutomationPeer_iface, IAutomationPeer2_iface, IAutomationPeer3_iface,
+                  IAutomationPeer4_iface, IAutomationPeer5_iface, IAutomationPeer6_iface, IAutomationPeer7_iface,
+                  IAutomationPeer8_iface, IAutomationPeer9_iface;
+    struct uielem *owner;           /* no reference: the element keeps its peer */
+    IInspectable *events_source;
+};
+
+static struct fe_peer *peer_from( struct xiface *iface ) { return CONTAINING_RECORD( iface->obj, struct fe_peer, d.obj ); }
+
+static HRESULT WINAPI peer_get_Owner( struct xiface *iface, IInspectable **value )
+{
+    struct fe_peer *peer = peer_from( iface );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (peer->owner) IUnknown_QueryInterface( peer->owner->d.obj.outer, &IID_IInspectable, (void **)value );
+    return S_OK;
+}
+
+static HRESULT WINAPI peer_get_EventsSource( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = peer_from( iface )->events_source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI peer_put_EventsSource( struct xiface *iface, IInspectable *value )
+{
+    struct fe_peer *peer = peer_from( iface );
+
+    if (value) IInspectable_AddRef( value );
+    if (peer->events_source) IInspectable_Release( peer->events_source );
+    peer->events_source = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI peer_RaiseAutomationEvent( struct xiface *iface, INT32 event ) { return S_OK; }
+static HRESULT WINAPI peer_RaisePropertyChangedEvent( struct xiface *iface, IInspectable *property, IInspectable *old_value,
+                                                      IInspectable *new_value ) { return S_OK; }
+static HRESULT WINAPI peer_IsEnabled( struct xiface *iface, boolean *value ) { if (!value) return E_POINTER; *value = TRUE; return S_OK; }
+
+static const void *fe_peer_vtbl[] = { IFrameworkElementAutomationPeer_STUBS, [IFrameworkElementAutomationPeer_Owner] = peer_get_Owner };
+static const void *peer_vtbl[] =
+{
+    IAutomationPeer_STUBS,
+    [IAutomationPeer_EventsSource] = peer_get_EventsSource,
+    [IAutomationPeer_SetEventsSource] = peer_put_EventsSource,
+    [IAutomationPeer_RaiseAutomationEvent] = peer_RaiseAutomationEvent,
+    [IAutomationPeer_RaisePropertyChangedEvent] = peer_RaisePropertyChangedEvent,
+    [IAutomationPeer_IsEnabled] = peer_IsEnabled,
+};
+static const void *peer2_vtbl[] = { IAutomationPeer2_STUBS };
+static const void *peer3_vtbl[] = { IAutomationPeer3_STUBS };
+static const void *peer4_vtbl[] = { IAutomationPeer4_STUBS };
+static const void *peer5_vtbl[] = { IAutomationPeer5_STUBS };
+static const void *peer6_vtbl[] = { IAutomationPeer6_STUBS };
+static const void *peer7_vtbl[] = { IAutomationPeer7_STUBS };
+static const void *peer8_vtbl[] = { IAutomationPeer8_STUBS };
+static const void *peer9_vtbl[] = { IAutomationPeer9_STUBS };
+
+static const struct xiface_entry fe_peer_ifaces[] =
+{
+    { &IID_IFrameworkElementAutomationPeer, offsetof(struct fe_peer, IFrameworkElementAutomationPeer_iface) },
+    { &IID_IAutomationPeer, offsetof(struct fe_peer, IAutomationPeer_iface) },
+    { &IID_IAutomationPeer2, offsetof(struct fe_peer, IAutomationPeer2_iface) },
+    { &IID_IAutomationPeer3, offsetof(struct fe_peer, IAutomationPeer3_iface) },
+    { &IID_IAutomationPeer4, offsetof(struct fe_peer, IAutomationPeer4_iface) },
+    { &IID_IAutomationPeer5, offsetof(struct fe_peer, IAutomationPeer5_iface) },
+    { &IID_IAutomationPeer6, offsetof(struct fe_peer, IAutomationPeer6_iface) },
+    { &IID_IAutomationPeer7, offsetof(struct fe_peer, IAutomationPeer7_iface) },
+    { &IID_IAutomationPeer8, offsetof(struct fe_peer, IAutomationPeer8_iface) },
+    { &IID_IAutomationPeer9, offsetof(struct fe_peer, IAutomationPeer9_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void fe_peer_destroy( struct xobj *obj )
+{
+    struct fe_peer *peer = CONTAINING_RECORD( obj, struct fe_peer, d.obj );
+    if (peer->events_source) IInspectable_Release( peer->events_source );
+    dobj_cleanup( &peer->d );
+}
+
+static const struct xclass fe_peer_class =
+{
+    L"Windows.UI.Xaml.Automation.Peers.FrameworkElementAutomationPeer", fe_peer_ifaces, ARRAY_SIZE(fe_peer_ifaces), fe_peer_destroy,
+};
 
 static HRESULT WINAPI peer_FromElement( struct xfiface *iface, IInspectable *element, IInspectable **value )
 {
+    struct uielem *elem = element ? uielem_from_inspectable( element ) : NULL;
+
     if (!value) return E_POINTER;
     if (!element) return E_INVALIDARG;
     *value = NULL;
+    if (elem && elem->automation_peer) IInspectable_AddRef( (*value = elem->automation_peer) );
+    return S_OK;
+}
+
+/* CreatePeerForElement: the element's peer, made the first time */
+static HRESULT WINAPI peer_CreatePeerForElement( struct xfiface *iface, IInspectable *element, IInspectable **value )
+{
+    struct uielem *elem = element ? uielem_from_inspectable( element ) : NULL;
+    struct fe_peer *peer;
+
+    if (!value) return E_POINTER;
+    if (!element) return E_INVALIDARG;
+    *value = NULL;
+#ifdef SG_MUTANT_NO_PEER_MADE
+    return S_OK;
+#endif
+    if (!elem) return S_OK;
+    if (!elem->automation_peer)
+    {
+        if (!(peer = calloc( 1, sizeof(*peer) ))) return E_OUTOFMEMORY;
+        peer->IFrameworkElementAutomationPeer_iface.vtbl = fe_peer_vtbl;
+        peer->IAutomationPeer_iface.vtbl = peer_vtbl;
+        peer->IAutomationPeer2_iface.vtbl = peer2_vtbl;
+        peer->IAutomationPeer3_iface.vtbl = peer3_vtbl;
+        peer->IAutomationPeer4_iface.vtbl = peer4_vtbl;
+        peer->IAutomationPeer5_iface.vtbl = peer5_vtbl;
+        peer->IAutomationPeer6_iface.vtbl = peer6_vtbl;
+        peer->IAutomationPeer7_iface.vtbl = peer7_vtbl;
+        peer->IAutomationPeer8_iface.vtbl = peer8_vtbl;
+        peer->IAutomationPeer9_iface.vtbl = peer9_vtbl;
+        peer->owner = elem;
+        dobj_init( &peer->d, &fe_peer_class, NULL );
+        elem->automation_peer = (IInspectable *)&peer->IAutomationPeer_iface;
+    }
+    IInspectable_AddRef( (*value = elem->automation_peer) );
     return S_OK;
 }
 
@@ -646,7 +774,7 @@ static const void *peer_statics_vtbl[] =
 {
     IFrameworkElementAutomationPeerStatics_FSTUBS,
     [IFrameworkElementAutomationPeerStatics_FromElement] = peer_FromElement,
-    [IFrameworkElementAutomationPeerStatics_CreatePeerForElement] = peer_FromElement,
+    [IFrameworkElementAutomationPeerStatics_CreatePeerForElement] = peer_CreatePeerForElement,
 };
 
 static struct xfactory fe_peer_factory_obj =
