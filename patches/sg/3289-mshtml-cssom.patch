From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 23:16:03 -0700
Subject: [PATCH] mshtml: performance toJSON objects, history.go(url) (3289)

performance.toJSON(), performance.timing.toJSON() and performance.navigation.toJSON() return script Objects with the values as own properties (so JSON.stringify works), history.go(string) goes to the first history entry whose address contains the string, and dispex_define_property now makes sure the object has its dynamic data before it defines a property (it crashed on an object nothing had touched yet). CORE review: dispex.c.

diff --git a/dlls/mshtml/dispex.c b/dlls/mshtml/dispex.c
index 35f518a..a3e3282 100644
--- a/dlls/mshtml/dispex.c
+++ b/dlls/mshtml/dispex.c
@@ -795,11 +795,15 @@ static HRESULT get_dynamic_prop(DispatchEx *This, const WCHAR *name, DWORD flags
     return alloc_dynamic_prop(This, name, NULL, ret);
 }
 
+static BOOL ensure_real_info(DispatchEx *dispex);
+
 HRESULT dispex_define_property(DispatchEx *dispex, const WCHAR *name, DWORD flags, VARIANT *v, DISPID *id)
 {
     dynamic_prop_t *prop;
     HRESULT hres;
 
+    if(!ensure_real_info(dispex) || !get_dynamic_data(dispex))
+        return E_OUTOFMEMORY;
     hres = alloc_dynamic_prop(dispex, name, NULL, &prop);
     if(FAILED(hres))
         return hres;
diff --git a/dlls/mshtml/omnavigator.c b/dlls/mshtml/omnavigator.c
index d33a7de..9a408d6 100644
--- a/dlls/mshtml/omnavigator.c
+++ b/dlls/mshtml/omnavigator.c
@@ -29,6 +29,7 @@
 
 #include "mshtml_private.h"
 #include "mshtmdid.h"
+#include "shlobj.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
 
@@ -1210,6 +1211,16 @@ static HRESULT WINAPI OmHistory_forward(IOmHistory *iface, VARIANT *pvargdistanc
     return travel_history(This, distance);
 }
 
+static BOOL contains_nocase(const WCHAR *str, const WCHAR *sub)
+{
+    size_t len = wcslen(sub);
+
+    for(; *str; str++)
+        if(!wcsnicmp(str, sub, len))
+            return TRUE;
+    return FALSE;
+}
+
 static HRESULT WINAPI OmHistory_go(IOmHistory *iface, VARIANT *pvargdistance)
 {
     OmHistory *This = impl_from_IOmHistory(iface);
@@ -1219,8 +1230,44 @@ static HRESULT WINAPI OmHistory_go(IOmHistory *iface, VARIANT *pvargdistance)
     TRACE("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
 
     if(pvargdistance && V_VT(pvargdistance) == VT_BSTR) {
-        FIXME("going to a URL is not supported\n");
-        return E_NOTIMPL;
+        /* a string names a place in the history: the first entry (oldest first) whose address contains it */
+        GeckoBrowser *browser = NULL;
+        LONG back, forward, i;
+        DWORD count;
+
+        if(This->window->base.outer_window)
+            browser = This->window->base.outer_window->browser;
+        if(!browser || !browser->doc->travel_log || !V_BSTR(pvargdistance) || !*V_BSTR(pvargdistance))
+            return S_OK;
+
+        count = ITravelLog_CountEntries(browser->doc->travel_log, (IUnknown*)browser->doc->browser_service);
+        back = count;
+        forward = count;
+        for(i = -back; i <= forward; i++) {
+            ITravelEntry *entry = NULL;
+            WCHAR *url = NULL;
+            BOOL match;
+
+            if(!i)
+                continue;
+            if(FAILED(ITravelLog_GetTravelEntry(browser->doc->travel_log, (IUnknown*)browser->doc->browser_service, i, &entry)) || !entry)
+                continue;
+            {
+                ITEMIDLIST *pidl = NULL;
+
+                hres = ITravelEntry_GetPidl(entry, &pidl);
+                if(SUCCEEDED(hres) && pidl) {
+                    hres = SHGetNameFromIDList(pidl, SIGDN_URL, &url);
+                    CoTaskMemFree(pidl);
+                }
+            }
+            ITravelEntry_Release(entry);
+            match = SUCCEEDED(hres) && url && contains_nocase(url, V_BSTR(pvargdistance));
+            CoTaskMemFree(url);
+            if(match)
+                return travel_history(This, i);
+        }
+        return S_OK;
     }
 
     hres = history_distance(pvargdistance, 0, &distance);
@@ -2205,11 +2252,113 @@ static HRESULT WINAPI HTMLPerformanceTiming_toString(IHTMLPerformanceTiming *ifa
     return dispex_to_string(&This->dispex, string);
 }
 
+/* The plain objects toJSON returns: a script Object whose own properties are the values, each of them a number (or,
+ * for the performance object, another such object). */
+typedef struct {
+    DispatchEx dispex;
+} JSONObject;
+
+static void JSONObject_destructor(DispatchEx *dispex)
+{
+    free(CONTAINING_RECORD(dispex, JSONObject, dispex));
+}
+
+static const dispex_static_data_vtbl_t JSONObject_dispex_vtbl = {
+    .destructor = JSONObject_destructor,
+};
+
+static dispex_static_data_t JSONObject_dispex = {
+    .name = "Object",
+    .vtbl = &JSONObject_dispex_vtbl,
+};
+
+static HRESULT create_json_object(HTMLInnerWindow *window, JSONObject **ret)
+{
+    JSONObject *obj = calloc(1, sizeof(*obj));
+
+    if(!obj)
+        return E_OUTOFMEMORY;
+    init_dispatch(&obj->dispex, &JSONObject_dispex, window, dispex_compat_mode(&window->event_target.dispex));
+    *ret = obj;
+    return S_OK;
+}
+
+static HRESULT json_add_number(JSONObject *obj, const WCHAR *name, double value)
+{
+    VARIANT v;
+    DISPID id;
+
+    V_VT(&v) = VT_R8;
+    V_R8(&v) = value;
+    return dispex_define_property(&obj->dispex, name, PROPF_WRITABLE | PROPF_ENUMERABLE | PROPF_CONFIGURABLE, &v, &id);
+}
+
+static HRESULT json_add_object(JSONObject *obj, const WCHAR *name, JSONObject *child)
+{
+    VARIANT v;
+    DISPID id;
+
+    V_VT(&v) = VT_DISPATCH;
+    V_DISPATCH(&v) = (IDispatch*)&child->dispex.IWineJSDispatchHost_iface;
+    return dispex_define_property(&obj->dispex, name, PROPF_WRITABLE | PROPF_ENUMERABLE | PROPF_CONFIGURABLE, &v, &id);
+}
+
+static void json_return(JSONObject *obj, VARIANT *p)
+{
+    V_VT(p) = VT_DISPATCH;
+    V_DISPATCH(p) = (IDispatch*)&obj->dispex.IWineJSDispatchHost_iface;
+}
+
+static HRESULT performance_timing_to_json(IHTMLPerformanceTiming *timing, HTMLInnerWindow *window, JSONObject **ret)
+{
+    static const struct { const WCHAR *name; HRESULT (WINAPI *get)(IHTMLPerformanceTiming*, ULONGLONG*); } props[] = {
+#define P(n) { L ## #n, HTMLPerformanceTiming_get_ ## n }
+        P(navigationStart), P(unloadEventStart), P(unloadEventEnd), P(redirectStart), P(redirectEnd), P(fetchStart),
+        P(domainLookupStart), P(domainLookupEnd), P(connectStart), P(connectEnd), P(requestStart), P(responseStart),
+        P(responseEnd), P(domLoading), P(domInteractive), P(domContentLoadedEventStart), P(domContentLoadedEventEnd),
+        P(domComplete), P(loadEventStart), P(loadEventEnd), P(msFirstPaint)
+#undef P
+    };
+    JSONObject *obj;
+    unsigned i;
+    HRESULT hres;
+
+    hres = create_json_object(window, &obj);
+    if(FAILED(hres))
+        return hres;
+    for(i = 0; i < ARRAY_SIZE(props) && SUCCEEDED(hres); i++) {
+        ULONGLONG value = 0;
+
+        hres = props[i].get(timing, &value);
+        if(SUCCEEDED(hres))
+            hres = json_add_number(obj, props[i].name, (double)value);
+    }
+    if(FAILED(hres)) {
+        IWineJSDispatchHost_Release(&obj->dispex.IWineJSDispatchHost_iface);
+        return hres;
+    }
+    *ret = obj;
+    return S_OK;
+}
+
 static HRESULT WINAPI HTMLPerformanceTiming_toJSON(IHTMLPerformanceTiming *iface, VARIANT *p)
 {
     HTMLPerformanceTiming *This = impl_from_IHTMLPerformanceTiming(iface);
-    FIXME("(%p)->(%p)\n", This, p);
+    JSONObject *obj;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+#ifdef SG_MUTANT_CSSOM_JSON
     return E_NOTIMPL;
+#endif
+    hres = performance_timing_to_json(iface, This->window, &obj);
+    if(FAILED(hres))
+        return hres;
+    json_return(obj, p);
+    return S_OK;
 }
 
 static const IHTMLPerformanceTimingVtbl HTMLPerformanceTimingVtbl = {
@@ -2345,11 +2494,45 @@ static HRESULT WINAPI HTMLPerformanceNavigation_toString(IHTMLPerformanceNavigat
     return dispex_to_string(&This->dispex, string);
 }
 
+static HRESULT navigation_to_json(IHTMLPerformanceNavigation *nav, HTMLInnerWindow *window, JSONObject **ret)
+{
+    ULONG type = 0, redirects = 0;
+    JSONObject *obj;
+    HRESULT hres;
+
+    hres = create_json_object(window, &obj);
+    if(FAILED(hres))
+        return hres;
+    IHTMLPerformanceNavigation_get_type(nav, &type);
+    IHTMLPerformanceNavigation_get_redirectCount(nav, &redirects);
+    hres = json_add_number(obj, L"type", type);
+#ifndef SG_MUTANT_CSSOM_JSONNAV
+    if(SUCCEEDED(hres))
+        hres = json_add_number(obj, L"redirectCount", redirects);
+#endif
+    if(FAILED(hres)) {
+        IWineJSDispatchHost_Release(&obj->dispex.IWineJSDispatchHost_iface);
+        return hres;
+    }
+    *ret = obj;
+    return S_OK;
+}
+
 static HRESULT WINAPI HTMLPerformanceNavigation_toJSON(IHTMLPerformanceNavigation *iface, VARIANT *p)
 {
     HTMLPerformanceNavigation *This = impl_from_IHTMLPerformanceNavigation(iface);
-    FIXME("(%p)->(%p)\n", This, p);
-    return E_NOTIMPL;
+    JSONObject *obj;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+    hres = navigation_to_json(iface, This->window, &obj);
+    if(FAILED(hres))
+        return hres;
+    json_return(obj, p);
+    return S_OK;
 }
 
 static const IHTMLPerformanceNavigationVtbl HTMLPerformanceNavigationVtbl = {
@@ -2507,8 +2690,43 @@ static HRESULT WINAPI HTMLPerformance_toString(IHTMLPerformance *iface, BSTR *st
 static HRESULT WINAPI HTMLPerformance_toJSON(IHTMLPerformance *iface, VARIANT *var)
 {
     HTMLPerformance *This = impl_from_IHTMLPerformance(iface);
-    FIXME("(%p)->(%p)\n", This, var);
-    return E_NOTIMPL;
+    IHTMLPerformanceNavigation *nav = NULL;
+    IHTMLPerformanceTiming *timing = NULL;
+    JSONObject *obj = NULL, *child = NULL;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, var);
+
+    if(!var)
+        return E_POINTER;
+    hres = IHTMLPerformance_get_navigation(iface, &nav);
+    if(SUCCEEDED(hres))
+        hres = IHTMLPerformance_get_timing(iface, &timing);
+    if(SUCCEEDED(hres))
+        hres = create_json_object(This->window, &obj);
+    if(SUCCEEDED(hres))
+        hres = performance_timing_to_json(timing, This->window, &child);
+    if(SUCCEEDED(hres)) {
+        hres = json_add_object(obj, L"timing", child);
+        IWineJSDispatchHost_Release(&child->dispex.IWineJSDispatchHost_iface);
+    }
+    if(SUCCEEDED(hres))
+        hres = navigation_to_json(nav, This->window, &child);
+    if(SUCCEEDED(hres)) {
+        hres = json_add_object(obj, L"navigation", child);
+        IWineJSDispatchHost_Release(&child->dispex.IWineJSDispatchHost_iface);
+    }
+    if(nav)
+        IHTMLPerformanceNavigation_Release(nav);
+    if(timing)
+        IHTMLPerformanceTiming_Release(timing);
+    if(FAILED(hres)) {
+        if(obj)
+            IWineJSDispatchHost_Release(&obj->dispex.IWineJSDispatchHost_iface);
+        return hres;
+    }
+    json_return(obj, var);
+    return S_OK;
 }
 
 static inline HTMLPerformance *impl_from_IWineMSHTMLPerformance(IWineMSHTMLPerformance *iface)
