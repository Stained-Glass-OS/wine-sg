From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u: the Rounded style's corners are a window region; menus too

0483 rounded windows by their surface's shape alone. The server did not
know of it, so the windows below never painted what shows through the
corners: over another window they were black holes (only the desktop,
whose X background fills in, looked right).

The rounding is now a window region the server clips by -- the windows
below paint the corners -- set after each move, size or frame change of a
top-level window while the style is on, and made again only when the
window's size or radius changes. It stays the Rounded style's own:
__wine_sg_rounded marks it, GetWindowRgn answers that the window has no
region (as before), and a program's own SetWindowRgn replaces it and is
never touched. Turning the style off takes it away at the next change.

Popup menus are rounded too (8 px), and tooltips (4 px), as newer Windows
draws them.

Gate: test/rounded-gate.sh (a menu and a tooltip over a window, the window
showing through their corners; GetWindowRgn).
---
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -1870,25 +1870,84 @@
     return value;
 }
 
-static HRGN rounded_corners_shape( WND *win )
+static HRGN rounded_corners_shape( WND *win, ULONG_PTR *key )
 {
     static const WCHAR cornerW[] = {'_','_','w','i','n','e','_','c','o','r','n','e','r',0};
     ULONG_PTR pref;
-    int radius, w, h, x, y;
+    int radius, w, h, tip;
 
     if (win->parent != get_desktop_window()) return 0;
-    if ((win->dwStyle & WS_CAPTION) != WS_CAPTION || (win->dwStyle & (WS_MAXIMIZE | WS_MINIMIZE))) return 0;
     if (win->dwExStyle & WS_EX_LAYERED) return 0;
+    if ((win->dwStyle & WS_CAPTION) != WS_CAPTION || (win->dwStyle & (WS_MAXIMIZE | WS_MINIMIZE)))
+    {
+        /* popup menus and tooltips are rounded too, as newer Windows draws them */
+        static const WCHAR tooltipW[] = {'t','o','o','l','t','i','p','s','_','c','l','a','s','s','3','2',0};
+        WCHAR name[32];
+        UNICODE_STRING str = { 0, sizeof(name), name };
+        int len;
+
+        if (!(win->dwStyle & WS_POPUP) || !rounded_style()) return 0;
+        if (get_class_long( win->obj.handle, GCW_ATOM, FALSE ) == LOWORD(POPUPMENU_CLASS_ATOM)) tip = 0;
+        else if ((len = NtUserGetClassName( win->obj.handle, FALSE, &str )) && len < ARRAY_SIZE(name) &&
+                 (name[len] = 0, !wcsicmp( name, tooltipW ))) tip = 1;
+        else return 0;
+        radius = muldiv( tip ? 4 : 8, get_dpi_for_window( win->obj.handle ), USER_DEFAULT_SCREEN_DPI );
+        goto shape;
+    }
     if (!rounded_style()) return 0;
     pref = (ULONG_PTR)NtUserGetProp( win->obj.handle, cornerW );
     if (pref == 2 /* DWMWCP_DONOTROUND */) return 0;
     radius = muldiv( pref == 4 /* DWMWCP_ROUNDSMALL */ ? 4 : 8, get_dpi_for_window( win->obj.handle ), USER_DEFAULT_SCREEN_DPI );
+shape:
     w = win->rects.window.right - win->rects.window.left;
     h = win->rects.window.bottom - win->rects.window.top;
-    if (w < 4 * radius || h < 4 * radius) return 0;
-    x = win->rects.window.left - win->rects.visible.left;
-    y = win->rects.window.top - win->rects.visible.top;
-    return NtGdiCreateRoundRectRgn( x, y, x + w + 1, y + h + 1, 2 * radius, 2 * radius );
+    if (w < 4 * radius || h < 4 * radius || w > 0x7fff || h > 0x7fff) return 0;
+    /* what the region is for, to make it again only when that changes */
+    *key = 0x80000000 | w | (h << 15) | ((radius > 4 * get_dpi_for_window( win->obj.handle ) / USER_DEFAULT_SCREEN_DPI) << 30);
+    return NtGdiCreateRoundRectRgn( 0, 0, w + 1, h + 1, 2 * radius, 2 * radius );
+}
+
+/* The rounded corners are a window region -- the server then clips the
+ * windows below by it, so they paint what shows through the corners (a
+ * surface shape alone left those pixels unpainted) -- but one programs do
+ * not see: while __wine_sg_rounded marks it as ours, GetWindowRgn answers
+ * that the window has none, and a program's own SetWindowRgn replaces it. */
+static const WCHAR sg_roundedW[] = {'_','_','w','i','n','e','_','s','g','_','r','o','u','n','d','e','d',0};
+static BOOL setting_rounded_region;
+
+static void sync_rounded_region( HWND hwnd )
+{
+    ULONG_PTR ours = (ULONG_PTR)NtUserGetProp( hwnd, sg_roundedW ), key = 0;
+    HRGN want = 0, current;
+    RECT visible;
+    WND *win;
+
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) != get_desktop_window()) return;   /* top-level windows only */
+    if (!ours)
+    {
+        /* a program's own region stays; so does a window that never had ours
+         * while the style is off (the common case, answered without a server call) */
+        if (!rounded_style()) return;
+        if (get_window_region( hwnd, FALSE, &current, &visible )) return;
+        if (current) { NtGdiDeleteObjectApp( current ); return; }
+    }
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    want = rounded_corners_shape( win, &key );
+    release_win_ptr( win );
+    if (key == ours) { if (want) NtGdiDeleteObjectApp( want ); return; }
+
+    setting_rounded_region = TRUE;
+    if (want)
+    {
+        NtUserSetProp( hwnd, sg_roundedW, (HANDLE)key );
+        NtUserSetWindowRgn( hwnd, want, TRUE );   /* takes the region */
+    }
+    else
+    {
+        NtUserRemoveProp( hwnd, sg_roundedW );
+        NtUserSetWindowRgn( hwnd, 0, TRUE );
+    }
+    setting_rounded_region = FALSE;
 }
 
 /***********************************************************************
@@ -1904,7 +1963,6 @@
     if (!win->surface) goto done;
 
     if (get_window_region( hwnd, FALSE, &shape, &visible )) goto done;
-    if (!shape && (shape = rounded_corners_shape( win ))) visible = win->rects.visible;
     if (shape)
     {
         region = NtGdiCreateRectRgn( 0, 0, visible.right - visible.left, visible.bottom - visible.top );
@@ -2254,6 +2312,7 @@
                                         get_driver_window_surface( new_surface, raw_dpi ) );
 
         update_children_window_state( hwnd );
+        if (!setting_rounded_region) sync_rounded_region( hwnd );
     }
 
     return ret;
@@ -2337,6 +2396,8 @@
     HRGN win_rgn;
     RECT visible;
 
+    if (NtUserGetProp( hwnd, sg_roundedW )) return ERROR;   /* the Rounded style's, not the program's */
+
     if ((status = get_window_region( hwnd, FALSE, &win_rgn, &visible )))
     {
         set_ntstatus( status );
@@ -2359,6 +2420,9 @@
     static const RECT empty_rect;
     BOOL ret;
 
+    /* a program's own region replaces the Rounded style's */
+    if (!setting_rounded_region) NtUserRemoveProp( hwnd, sg_roundedW );
+
     if (hrgn)
     {
         RGNDATA *data;
