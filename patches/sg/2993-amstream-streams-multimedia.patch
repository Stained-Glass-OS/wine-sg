-    FIXME("(%p)->(%p): stub\n", iface, rect);
+    struct ddraw_sample *sample = impl_from_IDirectDrawStreamSample(iface);
+    DDSURFACEDESC desc;
+    RECT new_rect;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("sample %p, rect %s.\n", sample, wine_dbgstr_rect(rect));
+
+    desc.dwSize = sizeof(desc);
+    if (FAILED(hr = IDirectDrawSurface_GetSurfaceDesc(sample->surface, &desc)))
+        return hr;
+
+    if (rect)
+        new_rect = *rect;
+    else
+        SetRect(&new_rect, 0, 0, desc.dwWidth, desc.dwHeight);
+
+    if (new_rect.left < 0 || new_rect.top < 0 || new_rect.left >= new_rect.right
+            || new_rect.top >= new_rect.bottom || new_rect.right > (LONG)desc.dwWidth
+            || new_rect.bottom > (LONG)desc.dwHeight)
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&sample->parent->cs);
+    if (sample->busy)
+    {
+        LeaveCriticalSection(&sample->parent->cs);
+        return MS_E_BUSY;
+    }
+    LeaveCriticalSection(&sample->parent->cs);
+
+    /* The stream's format follows the part of the surface that is filled. */
+    desc.dwWidth = new_rect.right - new_rect.left;
+    desc.dwHeight = new_rect.bottom - new_rect.top;
+    if (FAILED(hr = IDirectDrawMediaStream_SetFormat(&sample->parent->IDirectDrawMediaStream_iface, &desc, NULL)))
+        return hr;
+
+    EnterCriticalSection(&sample->parent->cs);
+#ifndef SG_MUTANT_AM_RECT
+    sample->rect = new_rect;
+#endif
+    LeaveCriticalSection(&sample->parent->cs);
+
+    return S_OK;
