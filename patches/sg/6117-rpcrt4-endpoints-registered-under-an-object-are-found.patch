From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: an endpoint registered under an object UUID is found by that object

RpcEpRegister with a UUID vector sent the address of each UUID pointer as the object (and set only the first object of each binding), and RpcEpResolveBinding asked the endpoint mapper for the nil object only. NVDA's in-process helper binds "<object>@ncalrpc:" to nvda.exe's controller registered that way and never reached it.
---
diff --git a/dlls/rpcrt4/rpc_epmap.c b/dlls/rpcrt4/rpc_epmap.c
index 5e73205..f5a3988 100644
--- a/dlls/rpcrt4/rpc_epmap.c
+++ b/dlls/rpcrt4/rpc_epmap.c
@@ -239,6 +239,21 @@ static RPC_STATUS epm_register( RPC_IF_HANDLE IfSpec, RPC_BINDING_VECTOR *Bindin
                                   &entries[i*(UuidVector ? UuidVector->Count : 1) + j].tower);
           if (status != RPC_S_OK) break;
 
+#ifndef SG_MUTANT_EPMAP_NIL_OBJECT
+          /* Stained Glass OS: the vector holds pointers to the UUIDs; the
+           * pointer itself, and the next one, were sent as the object (and
+           * only the first object of a binding was set) */
+          {
+              unsigned int k = i * (UuidVector ? UuidVector->Count : 1) + j;
+              if (UuidVector && UuidVector->Uuid[j])
+                  entries[k].object = *UuidVector->Uuid[j];
+              else
+                  memset(&entries[k].object, 0, sizeof(entries[k].object));
+              if (Annotation)
+                  memcpy(entries[k].annotation, Annotation,
+                         min(strlen((char *)Annotation) + 1, ept_max_annotation_size));
+          }
+#else
           if (UuidVector)
               memcpy(&entries[i * UuidVector->Count].object, &UuidVector->Uuid[j], sizeof(GUID));
           else
@@ -246,6 +261,7 @@ static RPC_STATUS epm_register( RPC_IF_HANDLE IfSpec, RPC_BINDING_VECTOR *Bindin
           if (Annotation)
               memcpy(entries[i].annotation, Annotation,
                      min(strlen((char *)Annotation) + 1, ept_max_annotation_size));
+#endif
       }
   }
 
@@ -385,10 +401,10 @@ RPC_STATUS WINAPI RpcEpUnregister( RPC_IF_HANDLE IfSpec, RPC_BINDING_VECTOR *Bin
                                   &entries[i*(UuidVector ? UuidVector->Count : 1) + j].tower);
           if (status != RPC_S_OK) break;
 
-          if (UuidVector)
-              memcpy(&entries[i * UuidVector->Count + j].object, &UuidVector->Uuid[j], sizeof(GUID));
+          if (UuidVector && UuidVector->Uuid[j])
+              entries[i * UuidVector->Count + j].object = *UuidVector->Uuid[j];
           else
-              memset(&entries[i].object, 0, sizeof(entries[i].object));
+              memset(&entries[i * (UuidVector ? UuidVector->Count : 1) + j].object, 0, sizeof(GUID));
       }
   }
 
@@ -464,11 +480,25 @@ RPC_STATUS WINAPI RpcEpResolveBinding( RPC_BINDING_HANDLE Binding, RPC_IF_HANDLE
       return status;
   }
 
+#ifndef SG_MUTANT_EPMAP_NIL_OBJECT
+  /* Stained Glass OS: the binding's object UUID is what the endpoint is
+   * registered under (RpcEpRegister with a UUID vector): NVDA's in-process
+   * helper binds "<object>@ncalrpc:" to the endpoint nvda.exe registered
+   * that way, and the nil object found nothing ("couldn't find an
+   * endpoint"). An endpoint registered with no object still answers. */
+  uuid = bind->ObjectUuid;
+#endif
   while (TRUE)
   {
     __TRY
     {
       ept_map(handle, &uuid, tower, &entry_handle, ARRAY_SIZE(towers), &num_towers, towers, &status2);
+      if (status2 == RPC_S_OK && !num_towers && !IsEqualGUID(&uuid, &GUID_NULL))
+      {
+          uuid = GUID_NULL;
+          entry_handle = NULL;
+          ept_map(handle, &uuid, tower, &entry_handle, ARRAY_SIZE(towers), &num_towers, towers, &status2);
+      }
       /* FIXME: translate status2? */
     }
     __EXCEPT(rpc_filter)
