+/* ------------------------------------------------------------------------ */
+/* Quick access pins: HKCU\Software\Stained Glass\Explorer\QuickAccess,     */
+/* "Pinned" (REG_MULTI_SZ of paths); File Explorer reads the same value     */
+
+#define QUICK_ACCESS_KEY L"Software\\Stained Glass\\Explorer\\QuickAccess"
+
+static const KNOWNFOLDERID *default_pins[] = { &FOLDERID_Desktop, &FOLDERID_Downloads, &FOLDERID_Documents, &FOLDERID_Pictures };
+
+/* the pinned folders: a double-null-terminated list (caller frees), the defaults when never set */
+static WCHAR *read_pins(void)
+{
+    DWORD size = 0, type;
+    WCHAR *list;
+    size_t len = 0;
+    unsigned int i;
+
+    if (!RegGetValueW(HKEY_CURRENT_USER, QUICK_ACCESS_KEY, L"Pinned", RRF_RT_REG_MULTI_SZ, &type, NULL, &size) &&
+        (list = calloc(size / sizeof(WCHAR) + 2, sizeof(WCHAR))))
+    {
+        if (!RegGetValueW(HKEY_CURRENT_USER, QUICK_ACCESS_KEY, L"Pinned", RRF_RT_REG_MULTI_SZ, &type, list, &size))
+            return list;
+        free(list);
+    }
+    if (!(list = calloc(ARRAY_SIZE(default_pins) * MAX_PATH + 1, sizeof(WCHAR)))) return NULL;
+    for (i = 0; i < ARRAY_SIZE(default_pins); i++)
+    {
+        WCHAR *path;
+        if (FAILED(SHGetKnownFolderPath(default_pins[i], 0, NULL, &path))) continue;
+        lstrcpynW(list + len, path, MAX_PATH);
+        len += lstrlenW(list + len) + 1;
+        CoTaskMemFree(path);
+    }
+    list[len] = 0;
+    return list;
+}
+
+static BOOL same_path(const WCHAR *a, const WCHAR *b)
+{
+    WCHAR x[MAX_PATH], y[MAX_PATH];
+
+    lstrcpynW(x, a, MAX_PATH);
+    lstrcpynW(y, b, MAX_PATH);
+    PathRemoveBackslashW(x);
+    PathRemoveBackslashW(y);
+    return !wcsicmp(x, y);
+}
+
+BOOL SHELL_QuickAccessPinned(const WCHAR *path)
+{
+    WCHAR *list = read_pins(), *p;
+    BOOL found = FALSE;
+
+    for (p = list; p && *p && !found; p += lstrlenW(p) + 1) found = same_path(p, path);
+    free(list);
+    return found;
+}
+
+/* pins (at the end, as Windows does) or unpins folders */
+HRESULT SHELL_QuickAccessPin(const WCHAR *const *paths, UINT count, BOOL pin)
+{
+    WCHAR *list = read_pins(), *out, *p;
+    size_t len = 0, size;
+    UINT i;
+    LONG ret;
+
+    if (!list) return E_OUTOFMEMORY;
+    for (p = list; *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 1;
+    size = len + 1;
+    for (i = 0; i < count; i++) size += lstrlenW(paths[i]) + 1;
+    if (!(out = calloc(size, sizeof(WCHAR))))
+    {
+        free(list);
+        return E_OUTOFMEMORY;
+    }
+    len = 0;
+    for (p = list; *p; p += lstrlenW(p) + 1)
+    {
+        BOOL drop = FALSE;
+        for (i = 0; i < count && !pin; i++) drop |= same_path(p, paths[i]);
+        if (drop) continue;
+        lstrcpyW(out + len, p);
+        len += lstrlenW(p) + 1;
+    }
+    for (i = 0; i < count && pin; i++)
+    {
+        BOOL have = FALSE;
+        for (p = list; *p && !have; p += lstrlenW(p) + 1) have = same_path(p, paths[i]);
+        if (have) continue;
+        lstrcpyW(out + len, paths[i]);
+        len += lstrlenW(paths[i]) + 1;
+    }
+    out[len++] = 0;
+    ret = RegSetKeyValueW(HKEY_CURRENT_USER, QUICK_ACCESS_KEY, L"Pinned", REG_MULTI_SZ, out, len * sizeof(WCHAR));
+    TRACE("%s %u folder(s): %ld\n", pin ? "pinned" : "unpinned", count, ret);
+    free(list);
+    free(out);
+    return HRESULT_FROM_WIN32(ret);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Send to                                                                  */
+
+struct sendto_target
+{
+    WCHAR path[MAX_PATH];   /* the SendTo item, or a drive's root */
+    WCHAR name[MAX_PATH];
+    BOOL drive;
+};
+
+static int __cdecl compare_targets(const void *a, const void *b)
+{
+    return lstrcmpiW(((const struct sendto_target *)a)->name, ((const struct sendto_target *)b)->name);
+}
+
+/* the SendTo folder's items by name, then the removable drives */
+static struct sendto_target *list_targets(UINT *count)
+{
+    struct sendto_target *targets = NULL, *grown;
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH], root[4] = L"A:\\";
+    WIN32_FIND_DATAW fd;
+    UINT n = 0, max = 0, folder_items;
+    DWORD drives;
+    HANDLE find;
+
+    *count = 0;
+    if (SHGetFolderPathW(NULL, CSIDL_SENDTO, NULL, SHGFP_TYPE_CURRENT, dir) == S_OK)
+    {
+        PathCombineW(pattern, dir, L"*");
+        if ((find = FindFirstFileW(pattern, &fd)) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (fd.cFileName[0] == '.' || (fd.dwFileAttributes & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM))) continue;
+                if (!wcsicmp(fd.cFileName, L"desktop.ini")) continue;
+                if (n == max)
+                {
+                    max = max(16, max * 2);
+                    if (!(grown = realloc(targets, max * sizeof(*targets)))) break;
+                    targets = grown;
+                }
+                PathCombineW(targets[n].path, dir, fd.cFileName);
+                lstrcpynW(targets[n].name, fd.cFileName, MAX_PATH);
+                if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) PathRemoveExtensionW(targets[n].name);
+                targets[n].drive = FALSE;
+                n++;
+            } while (FindNextFileW(find, &fd));
+            FindClose(find);
+        }
+    }
+    folder_items = n;
+    if (n > 1) qsort(targets, n, sizeof(*targets), compare_targets);
+
+    drives = GetLogicalDrives();
+    for (root[0] = 'A'; root[0] <= 'Z'; root[0]++)
+    {
+        SHFILEINFOW info;
+
+        if (!(drives & (1 << (root[0] - 'A'))) || GetDriveTypeW(root) != DRIVE_REMOVABLE) continue;
+        if (n == max)
+        {
+            max = max(16, max * 2);
+            if (!(grown = realloc(targets, max * sizeof(*targets)))) break;
+            targets = grown;
+        }
+        lstrcpyW(targets[n].path, root);
+        if (SHGetFileInfoW(root, 0, &info, sizeof(info), SHGFI_DISPLAYNAME) && info.szDisplayName[0])
+            lstrcpynW(targets[n].name, info.szDisplayName, MAX_PATH);
+        else
+            swprintf(targets[n].name, MAX_PATH, L"Removable Disk (%c:)", root[0]);
+        targets[n].drive = TRUE;
+        n++;
+    }
+    TRACE("%u SendTo items, %u drives\n", folder_items, n - folder_items);
+    *count = n;
+    return targets;
+}
+
+/* the Send to submenu, its items first_id + index */
+HMENU SHELL_BuildSendToMenu(UINT first_id, UINT last_id, struct sendto_target **targets, UINT *count)
+{
+    HMENU menu = CreatePopupMenu();
+    UINT i;
+
+    *targets = list_targets(count);
+    for (i = 0; i < *count && first_id + i <= last_id; i++)
+    {
+        if ((*targets)[i].drive && (!i || !(*targets)[i - 1].drive) && i) AppendMenuW(menu, MF_SEPARATOR, 0, NULL);
+        AppendMenuW(menu, MF_STRING, first_id + i, (*targets)[i].name);
+    }
+    if (!*count) AppendMenuW(menu, MF_STRING | MF_GRAYED, 0, L"(empty)");
+    return menu;
+}
+
+void SHELL_FreeSendToTargets(struct sendto_target *targets)
+{
+    free(targets);
+}
+
+/* the paths of the items, double-null-terminated */
+static WCHAR *item_paths(const ITEMIDLIST *folder, ITEMIDLIST **items, UINT count)
+{
+    WCHAR *list, path[MAX_PATH];
+    size_t len = 0;
+    UINT i;
+
+    if (!(list = calloc((size_t)count * MAX_PATH + 1, sizeof(WCHAR)))) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        ITEMIDLIST *full = ILCombine(folder, items[i]);
+        if (full && SHGetPathFromIDListW(full, path))
+        {
+            lstrcpyW(list + len, path);
+            len += lstrlenW(path) + 1;
+        }
+        ILFree(full);
+    }
+    list[len] = 0;
+    if (!len)
+    {
+        free(list);
+        return NULL;
+    }
+    return list;
+}
+
+static HRESULT copy_into(HWND hwnd, const WCHAR *list, const WCHAR *dir)
+{
+    SHFILEOPSTRUCTW op = { 0 };
+    WCHAR *to;
+    int ret;
+
+    if (!(to = calloc(lstrlenW(dir) + 2, sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    lstrcpyW(to, dir);
+    op.hwnd = hwnd;
+    op.wFunc = FO_COPY;
+    op.pFrom = list;
+    op.pTo = to;
+    op.fFlags = FOF_ALLOWUNDO;
+    ret = SHFileOperationW(&op);
+    free(to);
+    return ret || op.fAnyOperationsAborted ? E_FAIL : S_OK;
+}
+
+/* a program with the files as its arguments, each quoted */
+static HRESULT run_with_files(const WCHAR *program, const WCHAR *args, const WCHAR *list)
+{
+    const WCHAR *p;
+    WCHAR *params;
+    size_t len = (args ? lstrlenW(args) : 0) + 1;
+    HINSTANCE ret;
+
+    for (p = list; *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 3;
+    if (!(params = calloc(len + 1, sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if (args && *args) lstrcpyW(params, args);
+    for (p = list; *p; p += lstrlenW(p) + 1)
+    {
+        if (params[0]) lstrcatW(params, L" ");
+        lstrcatW(params, L"\"");
+        lstrcatW(params, p);
+        lstrcatW(params, L"\"");
+    }
+    TRACE("%s %s\n", debugstr_w(program), debugstr_w(params));
+    ret = ShellExecuteW(NULL, NULL, program, params, NULL, SW_SHOWNORMAL);
+    free(params);
+    return (INT_PTR)ret > 32 ? S_OK : E_FAIL;
+}
+
+/* a file type's drop command: HKCR\<ext> -> ProgID -> shell\sendto\command,
+ * "%*" (or "%1", once per file) replaced by the files */
+static HRESULT run_type_command(const WCHAR *item, const WCHAR *list)
+{
+    WCHAR progid[MAX_PATH], key[MAX_PATH], command[1024], *out, *pos;
+    const WCHAR *ext = PathFindExtensionW(item), *p;
+    LONG size = sizeof(progid);
+    DWORD csize = sizeof(command);
+    size_t len;
+    PROCESS_INFORMATION pi;
+    STARTUPINFOW si = { sizeof(si) };
+    BOOL ok;
+
+    if (!ext[0] || RegQueryValueW(HKEY_CLASSES_ROOT, ext, progid, &size) || !progid[0]) return E_FAIL;
+    swprintf(key, ARRAY_SIZE(key), L"%s\\shell\\sendto\\command", progid);
+    if (RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ, NULL, command, &csize) || !command[0]) return E_FAIL;
+
+    len = lstrlenW(command) + 1;
+    for (p = list; *p; p += lstrlenW(p) + 1) len += lstrlenW(p) + 3;
+    if (!(out = calloc(len + 1, sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if ((pos = wcsstr(command, L"%*")) || (pos = wcsstr(command, L"%1")) || (pos = wcsstr(command, L"%L")))
+    {
+        BOOL quoted = pos > command && pos[-1] == '"';
+        memcpy(out, command, (pos - command - (quoted ? 1 : 0)) * sizeof(WCHAR));
+        for (p = list; *p; p += lstrlenW(p) + 1)
+        {
+            if (p != list) lstrcatW(out, L" ");
+            lstrcatW(out, L"\"");
+            lstrcatW(out, p);
+            lstrcatW(out, L"\"");
+        }
+        lstrcatW(out, pos + 2 + (quoted && pos[2] == '"' ? 1 : 0));
+    }
+    else
+    {
+        lstrcpyW(out, command);
+        for (p = list; *p; p += lstrlenW(p) + 1)
+        {
+            lstrcatW(out, L" \"");
+            lstrcatW(out, p);
+            lstrcatW(out, L"\"");
+        }
+    }
+    TRACE("%s\n", debugstr_w(out));
+    ok = CreateProcessW(NULL, out, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi);
+    free(out);
+    if (!ok) return HRESULT_FROM_WIN32(GetLastError());
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return S_OK;
+}
+
+/* "<name> - Shortcut.lnk" on the desktop for each item */
+static HRESULT desktop_shortcuts(const WCHAR *list)
+{
+    WCHAR desktop[MAX_PATH];
+    const WCHAR *src;
+    HRESULT hr = S_OK;
+
+    if (SHGetFolderPathW(NULL, CSIDL_DESKTOPDIRECTORY, NULL, SHGFP_TYPE_CURRENT, desktop) != S_OK) return E_FAIL;
+    for (src = list; *src && SUCCEEDED(hr); src += lstrlenW(src) + 1)
+    {
+        WCHAR link[MAX_PATH], name[MAX_PATH];
+        IShellLinkW *sl;
+        IPersistFile *pf;
+        int n = 2;
+
+        lstrcpynW(name, PathFindFileNameW(src), MAX_PATH);
+        if (!PathIsDirectoryW(src)) PathRemoveExtensionW(name);
+        swprintf(link, MAX_PATH, L"%s\\%s - Shortcut.lnk", desktop, name);
+        while (GetFileAttributesW(link) != INVALID_FILE_ATTRIBUTES && n < 1000)
+            swprintf(link, MAX_PATH, L"%s\\%s - Shortcut (%d).lnk", desktop, name, n++);
+        if (FAILED(hr = CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&sl)))
+            break;
+        IShellLinkW_SetPath(sl, src);
+        if (SUCCEEDED(hr = IShellLinkW_QueryInterface(sl, &IID_IPersistFile, (void **)&pf)))
+        {
+            hr = IPersistFile_Save(pf, link, TRUE);
+            IPersistFile_Release(pf);
+        }
+        IShellLinkW_Release(sl);
+    }
+    return hr;
+}
+
+static BOOL is_program(const WCHAR *path)
+{
+    const WCHAR *ext = PathFindExtensionW(path);
+    return !wcsicmp(ext, L".exe") || !wcsicmp(ext, L".com") || !wcsicmp(ext, L".bat") || !wcsicmp(ext, L".cmd");
+}
+
+HRESULT SHELL_SendTo(const struct sendto_target *target, HWND hwnd, const ITEMIDLIST *folder, ITEMIDLIST **items, UINT count)
+{
+    WCHAR *list, resolved[MAX_PATH], args[MAX_PATH];
+    const WCHAR *ext = PathFindExtensionW(target->path);
+    HRESULT hr = E_FAIL;
+
+    if (!(list = item_paths(folder, items, count))) return E_FAIL;
+    TRACE("sending %u item(s) to %s\n", count, debugstr_w(target->path));
+
+    if (target->drive || PathIsDirectoryW(target->path))
+        hr = copy_into(hwnd, list, target->path);
+    else if (!wcsicmp(ext, L".DeskLink"))
+        hr = desktop_shortcuts(list);
+    else if (!wcsicmp(ext, L".mydocs"))
+    {
+        WCHAR docs[MAX_PATH];
+        if (SHGetFolderPathW(NULL, CSIDL_PERSONAL, NULL, SHGFP_TYPE_CURRENT, docs) == S_OK) hr = copy_into(hwnd, list, docs);
+    }
+    else if (!wcsicmp(ext, L".lnk"))
+    {
+        IShellLinkW *sl;
+        IPersistFile *pf;
+
+        resolved[0] = args[0] = 0;
+        if (SUCCEEDED(CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&sl)))
+        {
+            if (SUCCEEDED(IShellLinkW_QueryInterface(sl, &IID_IPersistFile, (void **)&pf)))
+            {
+                if (SUCCEEDED(IPersistFile_Load(pf, target->path, STGM_READ)))
+                {
+                    IShellLinkW_GetPath(sl, resolved, MAX_PATH, NULL, SLGP_RAWPATH);
+                    IShellLinkW_GetArguments(sl, args, MAX_PATH);
+                }
+                IPersistFile_Release(pf);
+            }
+            IShellLinkW_Release(sl);
+        }
+        if (resolved[0] && PathIsDirectoryW(resolved)) hr = copy_into(hwnd, list, resolved);
+        else if (resolved[0]) hr = run_with_files(resolved, args, list);
+    }
+    else if (is_program(target->path))
+        hr = run_with_files(target->path, NULL, list);
+    else
+        hr = run_type_command(target->path, list);
+    if (FAILED(hr)) WARN("send to %s failed: %#lx\n", debugstr_w(target->path), hr);
+    free(list);
+    return hr;
+}
+
+size_t sendto_target_size(void)
+{
+    return sizeof(struct sendto_target);
+}
