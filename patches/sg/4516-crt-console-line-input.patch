+/*********************************************************************
+ *		_cgetws (MSVCRT.@)
+ *
+ * Unicode version of _cgets: str[0] holds the maximum length, str[1]
+ * receives the length read and the line starts at str + 2.
+ */
+wchar_t* CDECL _cgetws(wchar_t* str)
+{
+  wchar_t *buf = str + 2;
+  DWORD got;
+  DWORD conmode = 0;
+
+  TRACE("(%p)\n", str);
+  str[1] = 0; /* Length */
+  LOCK_CONSOLE;
+  GetConsoleMode(msvcrt_input_console(), &conmode);
+  SetConsoleMode(msvcrt_input_console(), ENABLE_LINE_INPUT|ENABLE_ECHO_INPUT|ENABLE_PROCESSED_INPUT);
+
+  if(ReadConsoleW(msvcrt_input_console(), buf, str[0], &got, NULL)) {
+    if(got >= 2 && buf[got-2] == '\r') {
+      buf[got-2] = 0;
+      str[1] = got-2;
+    }
+    else if(got == 1 && buf[got-1] == '\n') {
+      buf[0] = 0;
+      str[1] = 0;
+    }
+    else if(got == str[0] && buf[got-1] == '\r') {
+      buf[got-1] = 0;
+      str[1] = got-1;
+    }
+    else
+      str[1] = got;
+  }
+  else
+    buf = NULL;
+  SetConsoleMode(msvcrt_input_console(), conmode);
+  UNLOCK_CONSOLE;
+  return buf;
+}
+
+#if _MSVCR_VER>=80
+/* read a console line of at most size - 1 characters without its end */
+static int cgets_s_helper(void *buf, size_t size, size_t *read, BOOL wide)
+{
+  DWORD got = 0, conmode = 0, len = size - 1;
+  BOOL ret;
+
+  if (!MSVCRT_CHECK_PMT(read != NULL)) return EINVAL;
+  *read = 0;
+  if (!MSVCRT_CHECK_PMT(buf != NULL)) return EINVAL;
+  if (!MSVCRT_CHECK_PMT(size != 0)) return EINVAL;
+
+  LOCK_CONSOLE;
+  GetConsoleMode(msvcrt_input_console(), &conmode);
+  SetConsoleMode(msvcrt_input_console(), ENABLE_LINE_INPUT|ENABLE_ECHO_INPUT|ENABLE_PROCESSED_INPUT);
+  if (wide)
+  {
+    wchar_t *w = buf;
+    if ((ret = ReadConsoleW(msvcrt_input_console(), w, len, &got, NULL)))
+    {
+      if (got && w[got-1] == '\n') got--;
+      if (got && w[got-1] == '\r') got--;
+      w[got] = 0;
+    }
+    else w[0] = 0;
+  }
+  else
+  {
+    char *c = buf;
+    if ((ret = ReadConsoleA(msvcrt_input_console(), c, len, &got, NULL)))
+    {
+      if (got && c[got-1] == '\n') got--;
+      if (got && c[got-1] == '\r') got--;
+      c[got] = 0;
+    }
+    else c[0] = 0;
+  }
+  SetConsoleMode(msvcrt_input_console(), conmode);
+  UNLOCK_CONSOLE;
+
+  if (!ret)
+  {
+    msvcrt_set_errno(GetLastError());
+    return *_errno();
+  }
+#ifndef SG_MUTANT_CGETS_S_NO_LENGTH
+  *read = got;
+#endif
+  return 0;
+}
+
+/*********************************************************************
+ *		_cgets_s (MSVCR80.@)
+ */
+int CDECL _cgets_s(char *buf, size_t size, size_t *read)
+{
+  TRACE("(%p %Iu %p)\n", buf, size, read);
+  return cgets_s_helper(buf, size, read, FALSE);
+}
+
+/*********************************************************************
+ *		_cgetws_s (MSVCR80.@)
+ */
+int CDECL _cgetws_s(wchar_t *buf, size_t size, size_t *read)
+{
+  TRACE("(%p %Iu %p)\n", buf, size, read);
+  return cgets_s_helper(buf, size, read, TRUE);
+}
+#endif
+
 /*********************************************************************
  *		_ungetch_nolock (MSVCRT.@)
  */
diff --git a/dlls/msvcrt/scanf.c b/dlls/msvcrt/scanf.c
index 5b89ffd..1d3978c 100644
--- a/dlls/msvcrt/scanf.c
+++ b/dlls/msvcrt/scanf.c
@@ -735,6 +735,34 @@ int CDECL __stdio_common_vfwscanf(unsigned __int64 options,
         return vfwscanf_l(file, format, locale, valist);
 }
 
+/*********************************************************************
+ *              __conio_common_vcscanf (UCRTBASE.@)
+ */
+int CDECL __conio_common_vcscanf(unsigned __int64 options, const char *format,
+                                 _locale_t locale, va_list valist)
+{
+    if (options & ~(_CRT_INTERNAL_SCANF_SECURECRT | _CRT_INTERNAL_SCANF_LEGACY_WIDE_SPECIFIERS))
+        FIXME("options %#I64x not handled\n", options);
+    if (options & _CRT_INTERNAL_SCANF_SECURECRT)
+        return vcscanf_s_l(format, locale, valist);
+    else
+        return vcscanf_l(format, locale, valist);
+}
+
+/*********************************************************************
+ *              __conio_common_vcwscanf (UCRTBASE.@)
+ */
+int CDECL __conio_common_vcwscanf(unsigned __int64 options, const wchar_t *format,
+                                  _locale_t locale, va_list valist)
+{
+    if (options & ~(_CRT_INTERNAL_SCANF_SECURECRT | _CRT_INTERNAL_SCANF_LEGACY_WIDE_SPECIFIERS))
+        FIXME("options %#I64x not handled\n", options);
+    if (options & _CRT_INTERNAL_SCANF_SECURECRT)
+        return vcwscanf_s_l(format, locale, valist);
+    else
+        return vcwscanf_l(format, locale, valist);
+}
+
