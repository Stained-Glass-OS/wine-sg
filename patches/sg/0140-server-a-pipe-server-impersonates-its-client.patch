From: Stained Glass OS <dev@stained-glass.example>
Subject: server: a named pipe server impersonates its client

FSCTL_PIPE_IMPERSONATE (ImpersonateNamedPipeClient, and RpcImpersonateClient
over ncacn_np) gave the calling server thread a copy of the SERVER's own
process token -- a FIXME since the day it was written. Every service that
decides what a caller may do by impersonating it (the SCM, the event log)
therefore saw itself: in a shared prefix, where services run as SYSTEM, any
standard user was treated as SYSTEM.

The client's security context -- its thread's impersonation token, else its
process's primary token -- is now captured when the client opens the pipe
(as Windows does, for the default dynamic tracking-less case) and handed to
the server thread, as an impersonation token, on FSCTL_PIPE_IMPERSONATE. It
is dropped on FSCTL_PIPE_DISCONNECT and with the server end. A pipe with no
captured token behaves as before.

Server only: no protocol change.

Gate: test/pipeimp-gate.sh (a second Unix user's client on a shared prefix).
---
--- a/server/named_pipe.c	2026-09-25 03:13:06.884010935 -0700
+++ b/server/named_pipe.c	2026-09-25 03:16:07.294629904 -0700
@@ -74,6 +74,7 @@
     struct list          entry;      /* entry in named pipe listeners list */
     unsigned int         options;    /* pipe options */
     struct async_queue   listen_q;   /* listen queue */
+    struct token        *client_token; /* the connected client's security context */
 };
 
 struct named_pipe
@@ -533,6 +534,7 @@
         list_remove( &server->entry );
 
     free_async_queue( &server->listen_q );
+    if (server->client_token) release_object( server->client_token );
     pipe_end_destroy( obj );
 }
 
@@ -1368,13 +1370,21 @@
         }
 
         pipe_end_disconnect( &server->pipe_end, STATUS_PIPE_DISCONNECTED );
+        if (server->client_token)
+        {
+            release_object( server->client_token );
+            server->client_token = NULL;
+        }
         return;
 
     case FSCTL_PIPE_IMPERSONATE:
-        if (current->process->token) /* FIXME: use the client token */
+        /* the client's security context, captured when it connected; the
+         * server's own token only if there is none (as before) */
+        if (server->client_token || current->process->token)
         {
+            struct token *src = server->client_token ? server->client_token : current->process->token;
             struct token *token;
-            if (!(token = token_duplicate( current->process->token, 0, SecurityImpersonation, NULL, NULL, 0, NULL, 0 )))
+            if (!(token = token_duplicate( src, 0, SecurityImpersonation, NULL, NULL, 0, NULL, 0 )))
                 return;
             if (current->token) release_object( current->token );
             current->token = token;
@@ -1424,6 +1434,7 @@
         return NULL;
 
     server->options = options;
+    server->client_token = NULL;
     init_pipe_end( &server->pipe_end, pipe, pipe_flags, pipe->insize );
     server->pipe_end.state = FILE_PIPE_LISTENING_STATE;
     server->pipe_end.server_pid = get_process_id( current->process );
@@ -1510,6 +1521,22 @@
         server->pipe_end.client_pid = client->client_pid;
         client->server_pid = server->pipe_end.server_pid;
         list_remove( &server->entry );
+        /* capture who connected: the thread's impersonation token, else its
+         * process's primary token, for FSCTL_PIPE_IMPERSONATE */
+        if (server->client_token) release_object( server->client_token );
+        server->client_token = NULL;
+        {
+            struct token *src = current->token ? current->token : current->process->token;
+            if (src)
+            {
+                unsigned int err = get_error();
+                server->client_token = token_duplicate( src, 0, SecurityImpersonation, NULL, NULL, 0, NULL, 0 );
+                if (!server->client_token && src != current->process->token && current->process->token)
+                    server->client_token = token_duplicate( current->process->token, 0, SecurityImpersonation,
+                                                            NULL, NULL, 0, NULL, 0 );
+                set_error( err );
+            }
+        }
     }
     return &client->obj;
 }
