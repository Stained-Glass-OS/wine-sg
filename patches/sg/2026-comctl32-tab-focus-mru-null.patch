From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] comctl32: tab focus and selection rules, AddMRUString NULL (2026)

Tab controls: a negative TCM_SETCURFOCUS index leaves a button-style
control alone, TCM_SETCURSEL does not move a button-style control's
focus, and a selection change vetoed by TCN_SELCHANGING moves neither the
focus nor the selection. AddMRUStringA/W ignore a NULL string (0, no
error). Passing todo_wine marks removed in the tab and mru tests.
---
--- a/dlls/comctl32/tab.c
+++ b/dlls/comctl32/tab.c
@@ -265,7 +265,11 @@
       {
           TAB_GetItem(infoPtr, iItem)->dwState |= TCIS_BUTTONPRESSED;
           infoPtr->iSelected = iItem;
-          infoPtr->uFocus = iItem;
+          /* a button style control keeps the focus where it was */
+#ifndef SG_MUTANT_TAB_BUTTONS_SEL_FOCUS
+          if (!(infoPtr->dwStyle & TCS_BUTTONS))
+#endif
+              infoPtr->uFocus = iItem;
       }
       else
       {
@@ -286,6 +290,10 @@
   TRACE("(%p %d)\n", infoPtr, iItem);
 
   if (iItem < 0) {
+      /* a negative index leaves a button style control as it is */
+#ifndef SG_MUTANT_TAB_BUTTONS_NEGATIVE
+      if (infoPtr->dwStyle & TCS_BUTTONS) return 0;
+#endif
       infoPtr->uFocus = -1;
       if (infoPtr->iSelected != -1) {
           infoPtr->iSelected = -1;
@@ -318,18 +326,22 @@
     } else {
       INT oldFocus = infoPtr->uFocus;
       if (infoPtr->iSelected != iItem || oldFocus == -1 ) {
-        infoPtr->uFocus = iItem;
         if (oldFocus != -1) {
           if (!TAB_SendSimpleNotify(infoPtr, TCN_SELCHANGING))  {
+            infoPtr->uFocus = iItem;
             infoPtr->iSelected = iItem;
             TAB_SendSimpleNotify(infoPtr, TCN_SELCHANGE);
           }
+#ifdef SG_MUTANT_TAB_VETO_MOVES
           else
-            infoPtr->iSelected = iItem;
+            infoPtr->uFocus = infoPtr->iSelected = iItem;
+#endif
           TAB_EnsureSelectionVisible(infoPtr);
           TAB_InvalidateTabArea(infoPtr);
           NotifyWinEvent(EVENT_OBJECT_SELECTION, infoPtr->hwnd, OBJID_CLIENT, iItem + 1);
         }
+        else
+          infoPtr->uFocus = iItem;
       }
     }
   }
--- a/dlls/comctl32/commctrl.c
+++ b/dlls/comctl32/commctrl.c
@@ -2249,7 +2249,9 @@
     if (!hList)
         return -1;
 
-    if (!str || IsBadStringPtrW(str, -1))
+    if (!str) return 0;
+
+    if (IsBadStringPtrW(str, -1))
     {
         SetLastError(ERROR_INVALID_PARAMETER);
         return 0;
@@ -2272,6 +2274,11 @@
     if (!hList)
         return -1;
 
+    /* a NULL string is ignored */
+#ifndef SG_MUTANT_MRU_NULL
+    if (!str) return 0;
+#endif
+
     if (IsBadStringPtrA(str, -1))
     {
         SetLastError(ERROR_INVALID_PARAMETER);
--- a/dlls/comctl32/tests/tab.c
+++ b/dlls/comctl32/tests/tab.c
@@ -788,22 +788,19 @@
     ret = SendMessageA(hTab, TCM_SETCURFOCUS, -10, 0);
     ok(ret == 0, "Unexpected ret value %d.\n", ret);
     ret = SendMessageA(hTab, TCM_GETCURFOCUS, 0, 0);
-    todo_wine
     ok(ret == nTabs - 1, "Unexpected focus index %d.\n", ret);
 
     /* Testing CurFocus with value larger than number of tabs */
     ret = SendMessageA(hTab, TCM_SETCURSEL, 1, 0);
-    todo_wine
     ok(ret == 0, "Unexpected focus index %d.\n", ret);
 
     ret = SendMessageA(hTab, TCM_SETCURFOCUS, nTabs + 1, 0);
     ok(ret == 0, "Unexpected ret value %d.\n", ret);
     ret = SendMessageA(hTab, TCM_GETCURFOCUS, 0, 0);
-    todo_wine
     ok(ret == nTabs - 1, "Unexpected focus index %d.\n", ret);
 
     ok_sequence(sequences, TAB_SEQ_INDEX, getset_cur_focus_buttons_seq, "TCS_BUTTONS: set focused tab sequence", FALSE);
-    ok_sequence(sequences, PARENT_SEQ_INDEX, setfocus_parent_seq, "TCS_BUTTONS: set focused tab parent sequence", TRUE);
+    ok_sequence(sequences, PARENT_SEQ_INDEX, setfocus_parent_seq, "TCS_BUTTONS: set focused tab parent sequence", FALSE);
 
     DestroyWindow(hTab);
 }
@@ -1574,10 +1571,8 @@
     ok_sequence(sequences, PARENT_SEQ_INDEX, selchanging_parent_seq, "Focus change disallowed sequence", FALSE);
 
     ret = SendMessageA(hTab, TCM_GETCURFOCUS, 0, 0);
-    todo_wine
     ok(ret == nTabs - 1, "Unexpected focused tab %d.\n", ret);
     ret = SendMessageA(hTab, TCM_GETCURSEL, 0, 0);
-    todo_wine
     ok(ret == nTabs - 1, "Unexpected selected tab %d.\n", ret);
 
     /* Removing focus sends only TCN_SELCHANGE */
--- a/dlls/comctl32/tests/mru.c
+++ b/dlls/comctl32/tests/mru.c
@@ -341,7 +341,7 @@
         /* Add (NULL string) */
         SetLastError(0);
         iRet = pAddMRUStringA(hMRU, NULL);
-        todo_wine ok(iRet == 0 && !GetLastError(),
+        ok(iRet == 0 && !GetLastError(),
            "AddMRUStringA(NULL str) expected 0,0 got %d,%ld\n",
            iRet, GetLastError());
 
