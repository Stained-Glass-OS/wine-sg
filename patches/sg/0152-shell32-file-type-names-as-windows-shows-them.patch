+/* Stained Glass: the type name Windows' File Explorer shows ("Text
+ * Document", "PNG File", "File folder"), see HCR_GetFileTypeNameW */
+void _ILGetFileTypeW(LPCITEMIDLIST pidl, LPWSTR pOut, UINT uOutSize)
 {
-    if(_ILIsValue(pidl))
-    {
-        char sTemp[64];
-
-        /* "name" or "name." or any unhandled => "File" */
-        lstrcpynA (pOut, "File", uOutSize);
+    WCHAR name[MAX_PATH];
 
-        /* If there's space for more, try to get a better description. */
-        if (uOutSize > 6 && _ILGetExtension (pidl, sTemp, 64))
-        {
-            if (!( HCR_MapTypeToValueA(sTemp, sTemp, 64, TRUE)
-                && HCR_MapTypeToValueA(sTemp, pOut, uOutSize, FALSE ))
-                && sTemp[0])
-            {
-                lstrcpynA (pOut, sTemp, uOutSize - 6);
-                strcat (pOut, " file");
-            }
-        }
+    if (_ILIsValue(pidl))
+    {
+        name[0] = 0;
+        _ILSimpleGetTextW(pidl, name, MAX_PATH);
+        HCR_GetFileTypeNameW(PathFindExtensionW(name), pOut, uOutSize);
     }
     else
-        lstrcpynA(pOut, "Folder", uOutSize);
+        lstrcpynW(pOut, L"File folder", uOutSize);
+}
+
+void _ILGetFileType(LPCITEMIDLIST pidl, LPSTR pOut, UINT uOutSize)
+{
+    WCHAR type[MAX_PATH];
+
+    _ILGetFileTypeW(pidl, type, MAX_PATH);
+    if (!WideCharToMultiByte(CP_ACP, 0, type, -1, pOut, uOutSize, NULL, NULL) && uOutSize)
+        pOut[uOutSize - 1] = 0;
 }
 
