From: Stained Glass OS <dev@stained-glass.example>
Subject: shell32: file type names as Windows shows them

A type's name is its ProgID's FriendlyTypeName (an indirect "@dll,-id"
string is loaded), else the ProgID's own name for itself, else "EXT File"
("PNG File"); a folder is a "File folder"; a name without an extension a
"File". Wine said "txt file" and "Folder". The Type column is Unicode.
wine.inf gives common types their names, without overriding a choice already
made: Application (.exe), Batch File, Command Script,
Application extension, Registration Entries, Compressed (zipped) Folder and
others.

Gate: test/explorer2-gate.sh (types).
---
--- a/dlls/shell32/classes.c
+++ b/dlls/shell32/classes.c
@@ -79,6 +79,67 @@
 	return TRUE;
 }
 
+/* Stained Glass: a file type's name as Windows' File Explorer shows it -- the
+ * ProgID's FriendlyTypeName (an indirect "@dll,-id" string is loaded), else
+ * the ProgID's own name for itself, else "EXT File"; "File" when the name has
+ * no extension. */
+BOOL HCR_GetFileTypeNameW(LPCWSTR ext, LPWSTR out, DWORD len)
+{
+    WCHAR progid[MAX_PATH], value[MAX_PATH];
+    DWORD size;
+    HKEY hkey;
+
+
+    if (!out || !len) return FALSE;
+    out[0] = 0;
+    if (!ext || !ext[0] || (ext[0] == '.' && !ext[1]))
+    {
+        lstrcpynW(out, L"File", len);
+        return TRUE;
+    }
+    if (ext[0] != '.' && lstrlenW(ext) < MAX_PATH - 1)
+    {
+        value[0] = '.';
+        lstrcpyW(value + 1, ext);
+        ext = value;
+    }
+    if (HCR_MapTypeToValueW(ext, progid, MAX_PATH, FALSE) && progid[0] &&
+        !RegOpenKeyExW(HKEY_CLASSES_ROOT, progid, 0, KEY_READ, &hkey))
+    {
+        WCHAR name[MAX_PATH];
+
+        size = sizeof(name);
+        if (!RegQueryValueExW(hkey, L"FriendlyTypeName", NULL, NULL, (BYTE *)name, &size) && name[0])
+        {
+            if (name[0] == '@' && SUCCEEDED(SHLoadIndirectString(name, out, len, NULL)) && out[0])
+            {
+                RegCloseKey(hkey);
+                return TRUE;
+            }
+            if (name[0] != '@')
+            {
+                lstrcpynW(out, name, len);
+                RegCloseKey(hkey);
+                return TRUE;
+            }
+        }
+        size = sizeof(name);
+        if (!RegQueryValueExW(hkey, NULL, NULL, NULL, (BYTE *)name, &size) && name[0])
+        {
+            lstrcpynW(out, name, len);
+            RegCloseKey(hkey);
+            return TRUE;
+        }
+        RegCloseKey(hkey);
+    }
+    /* "EXT File" */
+    lstrcpynW(value, ext + 1, MAX_PATH - 6);
+    CharUpperW(value);
+    lstrcatW(value, L" File");
+    lstrcpynW(out, value, len);
+    return TRUE;
+}
+
 BOOL HCR_MapTypeToValueA(LPCSTR szExtension, LPSTR szFileType, LONG len, BOOL bPrependDot)
 {
 	HKEY	hkey;
