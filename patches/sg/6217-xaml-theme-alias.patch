diff --git a/dlls/windows.ui.xaml/render.c b/dlls/windows.ui.xaml/render.c
index fa89bdc..df0b979 100644
--- a/dlls/windows.ui.xaml/render.c
+++ b/dlls/windows.ui.xaml/render.c
@@ -355,16 +355,40 @@ static void render_element( struct uielem *elem, ID2D1RenderTarget *target, FLOA
 }
 
 /* +xamltree: the tree as it is drawn, with each element's class, place, size and state */
+/* its Background, as drawn: "" when none */
+static const char *debugstr_background( struct uielem *elem )
+{
+    static const WCHAR *owners[] = { L"Windows.UI.Xaml.Controls.Panel", L"Windows.UI.Xaml.Controls.Border",
+                                     L"Windows.UI.Xaml.Controls.Control" };
+    struct xaml_property *prop;
+    IInspectable *box;
+    struct xcolor c;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(owners); i++)
+    {
+        if (!(prop = xaml_property_find( owners[i], L"Background" ))) continue;
+        box = NULL;
+        if (FAILED(dobj_get_value( &elem->d, prop, &box )) || !box) continue;
+        if (!xaml_brush_color( box, &c )) { IInspectable_Release( box ); return " bg=(brush)"; }
+        IInspectable_Release( box );
+        return wine_dbg_sprintf( " bg=#%02x%02x%02x%02x", c.a, c.r, c.g, c.b );
+    }
+    return "";
+}
+
 static void dump_tree( struct uielem *elem, int depth )
 {
     struct uielem *child;
     HSTRING name = NULL;
+    FLOAT opacity = xaml_element_opacity( elem );
 
     IInspectable_GetRuntimeClassName( (IInspectable *)elem->d.obj.outer, &name );
-    TRACE_(xamltree)( "%*s%s %p at %.0f,%.0f %.0fx%.0f%s%s\n", depth * 2, "",
+    TRACE_(xamltree)( "%*s%s %p at %.0f,%.0f %.0fx%.0f%s%s%s%s\n", depth * 2, "",
                       debugstr_hstring( name ), elem, elem->offset.x, elem->offset.y, elem->render.width,
                       elem->render.height, elem->visibility == XCOLLAPSED ? " collapsed" : "",
-                      elem->arrange_valid ? "" : " unarranged" );
+                      elem->arrange_valid ? "" : " unarranged", debugstr_background( elem ),
+                      opacity < 1 ? wine_dbg_sprintf( " opacity=%.2f", opacity ) : "" );
     WindowsDeleteString( name );
     LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) dump_tree( child, depth + 1 );
 }
@@ -488,6 +512,20 @@ void xaml_layout_window( HWND hwnd, IInspectable *content )
     if (changed) xaml_raise_layout_updated( root );
 }
 
+/* what shows where the content draws nothing: the desktop's window colour, or in a Dark theme
+ * the Dark page background when the desktop's colour is light (as a host window behind a Dark
+ * island shows dark) */
+static struct xcolor window_background( struct uielem *root )
+{
+    struct xcolor color = xaml_theme_color( XTHEME_BACKGROUND ), dark = { 0xff, 0x20, 0x20, 0x20 };
+
+#ifdef SG_MUTANT_WINDOW_BACKGROUND_UNTHEMED
+    return color;
+#endif
+    if (root && xaml_element_actual_theme( root ) == 2 && color.r * 3 + color.g * 6 + color.b > 128 * 10) return dark;
+    return color;
+}
+
 /* a host window's paint: its content laid out to its size and drawn on its DC */
 void xaml_render_window( HWND hwnd, HDC hdc, IInspectable *content )
 {
@@ -515,7 +553,7 @@ void xaml_render_window( HWND hwnd, HDC hdc, IInspectable *content )
     if (SUCCEEDED(ID2D1DCRenderTarget_BindDC( target, hdc, &rc )))
     {
         ID2D1DCRenderTarget_BeginDraw( target );
-        background = d2d_color( xaml_theme_color( XTHEME_BACKGROUND ) );
+        background = d2d_color( window_background( root ) );
         ID2D1DCRenderTarget_Clear( target, &background );
         if (root && TRACE_ON(xamltree)) dump_tree( root, 0 );
         if (root) render_element( root, (ID2D1RenderTarget *)target, 0, 0 );
diff --git a/dlls/windows.ui.xaml/resources.c b/dlls/windows.ui.xaml/resources.c
index f45cc4d..3ffbf41 100644
--- a/dlls/windows.ui.xaml/resources.c
+++ b/dlls/windows.ui.xaml/resources.c
@@ -106,6 +106,115 @@ static struct resdict *dict_from_inspectable( IInspectable *iface );
 /* the theme of the element a lookup is for (1 Light, 2 Dark), 0: the application's */
 static INT32 lookup_theme;
 
+/* A dictionary's entry that is another key's resource (<StaticResource x:Key="A" ResourceKey="B"/>,
+ * as WinUI's theme dictionaries alias their colours): B is looked up when A is, in the theme and
+ * from the element A is looked up for, not when the dictionary is read. */
+struct res_alias
+{
+    IInspectable IInspectable_iface;
+    LONG ref;
+    WCHAR *key;
+};
+
+static const IInspectableVtbl res_alias_vtbl;
+
+static struct res_alias *res_alias_from( IInspectable *iface )
+{
+    return iface && iface->lpVtbl == &res_alias_vtbl ? CONTAINING_RECORD( iface, struct res_alias, IInspectable_iface ) : NULL;
+}
+
+static HRESULT WINAPI res_alias_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        IInspectable_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI res_alias_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &res_alias_from( iface )->ref );
+}
+
+static ULONG WINAPI res_alias_Release( IInspectable *iface )
+{
+    struct res_alias *alias = res_alias_from( iface );
+    ULONG ref = InterlockedDecrement( &alias->ref );
+
+    if (!ref)
+    {
+        free( alias->key );
+        free( alias );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI res_alias_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    *count = 0;
+    *iids = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI res_alias_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.UI.Xaml.StaticResourceExtension", 38, name );
+}
+
+static HRESULT WINAPI res_alias_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const IInspectableVtbl res_alias_vtbl =
+{
+    res_alias_QueryInterface, res_alias_AddRef, res_alias_Release,
+    res_alias_GetIids, res_alias_GetRuntimeClassName, res_alias_GetTrustLevel,
+};
+
+IInspectable *xaml_resource_alias( const WCHAR *key )
+{
+    struct res_alias *alias;
+
+    if (!key || !(alias = calloc( 1, sizeof(*alias) ))) return NULL;
+    alias->IInspectable_iface.lpVtbl = &res_alias_vtbl;
+    alias->ref = 1;
+    if (!(alias->key = wcsdup( key )))
+    {
+        free( alias );
+        return NULL;
+    }
+    return &alias->IInspectable_iface;
+}
+
+/* where the lookup now is for: an alias is looked up from there */
+static struct uielem *lookup_elem;
+static IInspectable *const *lookup_scope;
+static unsigned int lookup_scope_count;
+static IInspectable *find_resource( struct uielem *elem, IInspectable *const *scope, unsigned int scope_count, const WCHAR *key );
+
+static IInspectable *resolve_alias( IInspectable *value )
+{
+    static LONG alias_depth;
+    struct res_alias *alias;
+    IInspectable *found;
+
+#ifdef SG_MUTANT_ALIAS_AS_READ
+    return value;
+#endif
+    if (!(alias = res_alias_from( value ))) return value;
+    if (alias_depth >= 8) return NULL;   /* an alias of itself, or a loop of them */
+    alias_depth++;
+    found = find_resource( lookup_elem, lookup_scope, lookup_scope_count, alias->key );
+    TRACE( "alias %s -> %p\n", debugstr_w( alias->key ), found );
+    alias_depth--;
+    return found;
+}
+
 /* a key's value in a dictionary, its merged ones and its theme dictionary (no reference) */
 static IInspectable *dict_lookup( struct resdict *dict, const WCHAR *key, int depth )
 {
@@ -114,12 +223,12 @@ static IInspectable *dict_lookup( struct resdict *dict, const WCHAR *key, int de
     INT32 i;
 
     if (!dict || depth > 16) return NULL;
-    if ((res = find_entry( dict, key ))) return res->value;
+    if ((res = find_entry( dict, key ))) return resolve_alias( res->value );
     for (i = (INT32)xvector_size( dict->merged ) - 1; i >= 0; i--)
         if ((value = dict_lookup( dict_from_inspectable( xvector_item( dict->merged, i ) ), key, depth + 1 ))) return value;
     if (dict->themes)
     {
-        const WCHAR *theme = lookup_theme ? (lookup_theme == 2 ? L"Dark" : L"Light") : system_app_theme() ? L"Dark" : L"Light";
+        const WCHAR *theme = (lookup_theme ? lookup_theme : xaml_application_theme()) == 2 ? L"Dark" : L"Light";
         struct resource *t = find_entry( dict->themes, theme );
         if (!t) t = find_entry( dict->themes, L"Default" );
         if (t && (value = dict_lookup( dict_from_inspectable( t->value ), key, depth + 1 ))) return value;
@@ -515,7 +624,7 @@ static HRESULT WINAPI iterable_First( struct xiface *iface, IInspectable **value
         kvp->iface.vtbl = kvp_vtbl;
         xobj_init( &kvp->obj, &kvp_class, NULL );
         kvp->key = xbox_string( res->key );
-        if ((kvp->value = res->value)) IInspectable_AddRef( kvp->value );
+        if ((kvp->value = resolve_alias( res->value ))) IInspectable_AddRef( kvp->value );
         it->pairs[it->count++] = (IInspectable *)&kvp->iface;
     }
     it->iface.vtbl = iterator_vtbl;
@@ -1331,12 +1440,13 @@ IInspectable *xaml_element_resources( struct uielem *elem )
 /* a resource by key, from an element (or NULL) up, then the application's, then the desktop's (no reference) */
 static struct resdict *default_styles_dict( struct uielem *elem );
 
-static IInspectable *find_resource( struct uielem *elem, IInspectable *const *scope, unsigned int scope_count, const WCHAR *key );
-
 /* a resource for an element (and the objects being made around it): in the theme it is drawn in */
 IInspectable *xaml_find_resource( struct uielem *elem, IInspectable *const *scope, unsigned int scope_count, const WCHAR *key )
 {
     INT32 saved = lookup_theme, theme = 0;
+    struct uielem *saved_elem = lookup_elem;
+    IInspectable *const *saved_scope = lookup_scope;
+    unsigned int saved_count = lookup_scope_count;
     IInspectable *found;
     unsigned int i;
 
@@ -1349,8 +1459,21 @@ IInspectable *xaml_find_resource( struct uielem *elem, IInspectable *const *scop
     if (!theme && elem) theme = xaml_element_theme( elem );
 #endif
     lookup_theme = theme;
+    lookup_elem = elem;
+    lookup_scope = scope;
+    lookup_scope_count = scope_count;
     found = find_resource( elem, scope, scope_count, key );
+    if (TRACE_ON(xaml))
+    {
+        struct xcolor c = { 0 };
+        BOOL is_color = found && xaml_brush_color( found, &c );
+        TRACE( "%p theme %d: %s -> %p %08x\n", elem, theme, debugstr_w( key ), found,
+               is_color ? (c.a << 24 | c.r << 16 | c.g << 8 | c.b) : 0 );
+    }
     lookup_theme = saved;
+    lookup_elem = saved_elem;
+    lookup_scope = saved_scope;
+    lookup_scope_count = saved_count;
     return found;
 }
 
diff --git a/dlls/windows.ui.xaml/xbf.c b/dlls/windows.ui.xaml/xbf.c
index 6438c3b..4891097 100644
--- a/dlls/windows.ui.xaml/xbf.c
+++ b/dlls/windows.ui.xaml/xbf.c
@@ -282,6 +282,7 @@ struct frame
     WCHAR *defer_name;
     INT32 defer_section;
     WCHAR *theme_key;              /* a {ThemeResource} object: its key */
+    WCHAR *alias_key;              /* a resource reference as an object: its key */
 };
 
 struct collection
@@ -506,6 +507,8 @@ static IInspectable *pop_frame( struct xbf_state *s )
     obj = s->frames[--s->nframes].obj;
     free( s->frames[s->nframes].theme_key );
     s->frames[s->nframes].theme_key = NULL;
+    free( s->frames[s->nframes].alias_key );
+    s->frames[s->nframes].alias_key = NULL;
     if (s->frames[s->nframes].uid)
     {
         if (obj) xaml_apply_uid( s->writer, obj, s->frames[s->nframes].uid );
@@ -582,13 +585,21 @@ static HRESULT read_section( struct xbf_state *s, UINT32 index, size_t offset, e
 }
 
 /* the object at an offset of a section (with a reference), or NULL */
-static IInspectable *section_object( struct xbf_state *s, UINT32 section, UINT32 offset, HRESULT *hr )
+static IInspectable *section_object_alias( struct xbf_state *s, UINT32 section, UINT32 offset, HRESULT *hr, WCHAR **alias_key )
 {
     unsigned int frames = s->nframes;
     IInspectable *obj = NULL;
 
     *hr = read_section( s, section, offset, READ_OBJECT );
-    if (SUCCEEDED(*hr) && s->nframes == frames + 1) obj = pop_frame( s );
+    if (SUCCEEDED(*hr) && s->nframes == frames + 1)
+    {
+        if (alias_key)
+        {
+            *alias_key = s->frames[frames].alias_key;
+            s->frames[frames].alias_key = NULL;
+        }
+        obj = pop_frame( s );
+    }
     while (s->nframes > frames)
     {
         IInspectable *extra = pop_frame( s );
@@ -597,6 +608,11 @@ static IInspectable *section_object( struct xbf_state *s, UINT32 section, UINT32
     return obj;
 }
 
+static IInspectable *section_object( struct xbf_state *s, UINT32 section, UINT32 offset, HRESULT *hr )
+{
+    return section_object_alias( s, section, offset, hr, NULL );
+}
+
 /* the name of a style's or a setter's property: Owner.Name when its owner is one of ours */
 static WCHAR *setter_property( struct xbf_state *s, UINT16 id, BOOL string_id )
 {
@@ -692,9 +708,24 @@ static HRESULT add_resource( struct xbf_state *s, UINT32 section, UINT32 offset,
 {
     struct collection *c = s->ncolls ? &s->colls[s->ncolls - 1] : NULL;
     IInspectable *obj;
+    WCHAR *alias_key = NULL;
     HRESULT hr = S_OK;
 
-    if (!c || !c->owner || !(obj = section_object( s, section, offset, &hr ))) return hr;
+    if (!c || !c->owner) return hr;
+    obj = section_object_alias( s, section, offset, &hr, &alias_key );
+    /* a keyed reference (<StaticResource x:Key="A" ResourceKey="B"/>): B looked up when A is, in its
+     * theme -- not now, while the theme dictionaries B may be in are still being read */
+#ifdef SG_MUTANT_XBF_ALIAS_EAGER
+    if (FALSE)
+#else
+    if (alias_key && key && !c->name && xaml_is_resource_dictionary( c->owner ))
+#endif
+    {
+        if (obj) IInspectable_Release( obj );
+        obj = xaml_resource_alias( alias_key );
+    }
+    free( alias_key );
+    if (!obj) return hr;
     hr = xaml_writer_add_keyed( s->writer, c->owner, c->name, obj, key );
     IInspectable_Release( obj );
     return hr == E_INVALIDARG ? S_OK : hr;
@@ -1049,9 +1080,19 @@ static HRESULT read_nodes( struct xbf_state *s, struct rd *r, enum read_mode mod
         {
             IInspectable *child;
             struct collection *c;
+            WCHAR *alias_key;
             if (s->nframes < 2 || !s->ncolls) { r->bad = TRUE; break; }
+            alias_key = s->frames[s->nframes - 1].alias_key;
+            s->frames[s->nframes - 1].alias_key = NULL;
             child = pop_frame( s );
             if (op == 0x0a) value = read_value( s, r );   /* its key */
+            /* a keyed reference (<StaticResource x:Key="A" ResourceKey="B"/>): B looked up when A is */
+            if (op == 0x0a && alias_key && !s->colls[s->ncolls - 1].name && xaml_is_resource_dictionary( s->colls[s->ncolls - 1].owner ))
+            {
+                if (child) IInspectable_Release( child );
+                child = xaml_resource_alias( alias_key );
+            }
+            free( alias_key );
             c = &s->colls[s->ncolls - 1];
             if (child && c->owner && !s->muted)
             {
@@ -1172,6 +1213,7 @@ static HRESULT read_nodes( struct xbf_state *s, struct rd *r, enum read_mode mod
             if (found) IInspectable_AddRef( found );
             hr = push_frame( s, found, FALSE );
             if (SUCCEEDED(hr) && op == 0x23 && value) s->frames[s->nframes - 1].theme_key = wcsdup( value );
+            if (SUCCEEDED(hr) && value) s->frames[s->nframes - 1].alias_key = wcsdup( value );
             break;
         }
         case 0x18: case 0x19:       /* a root with a constructor argument */
