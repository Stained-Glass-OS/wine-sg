From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: theme resources in the theme they are used in

WinUI's compiled theme dictionaries alias their colours (<StaticResource x:Key="A" ResourceKey="B"/>). We looked B up while the dictionaries were being read, before the theme dictionary holding B was there, so a Dark page got Light colours or the desktop's (Windows Terminal's settings: white expanders, light combo boxes and text boxes). Such an entry is now kept as a reference and looked up when it is used, in the theme of the element it is used for. An element made alone (in the application's theme) and put under a RequestedTheme looks its ThemeResource values up again; the application's RequestedTheme, not only the desktop's, is the theme of elements without one; and where a Dark content draws nothing the window shows dark rather than the desktop's light window colour.
---
diff --git a/dlls/windows.ui.xaml/application.c b/dlls/windows.ui.xaml/application.c
index 3b7de4e..4411e34 100644
--- a/dlls/windows.ui.xaml/application.c
+++ b/dlls/windows.ui.xaml/application.c
@@ -306,6 +306,20 @@ static HRESULT WINAPI app_statics_LoadComponent( struct xfiface *iface, IInspect
     return xaml_load_component( component, locator );
 }
 
+/* the theme an element without a RequestedTheme is in: the application's RequestedTheme (1 Light, 2 Dark) */
+INT32 xaml_application_theme(void)
+{
+    INT32 theme;
+
+#ifdef SG_MUTANT_APP_THEME_IGNORED
+    return system_app_theme() == APPLICATION_THEME_DARK ? 2 : 1;
+#endif
+    EnterCriticalSection( &app_cs );
+    theme = current_app ? current_app->requested_theme : system_app_theme();
+    LeaveCriticalSection( &app_cs );
+    return theme == APPLICATION_THEME_DARK ? 2 : 1;
+}
+
 BOOL xaml_current_application_exists(void)
 {
     BOOL ret;
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
index f4f2eb5..35388a0 100644
--- a/dlls/windows.ui.xaml/element.c
+++ b/dlls/windows.ui.xaml/element.c
@@ -500,10 +500,24 @@ void uielem_update_layout( struct uielem *elem )
     if (!root->arrange_valid) uielem_arrange( root, root->final );
 }
 
+/* the theme it is drawn in: its own or an ancestor's RequestedTheme, else the application's (1 Light, 2 Dark) */
+INT32 xaml_element_actual_theme( struct uielem *elem )
+{
+    INT32 theme = xaml_element_theme( elem );
+    return theme ? theme : xaml_application_theme();
+}
+
 void uielem_add_child( struct uielem *parent, struct uielem *child )
 {
+    INT32 before;
+
     if (child->parent) uielem_remove_child( child->parent, child );
+    before = xaml_element_actual_theme( child );
     child->parent = parent;
+#ifndef SG_MUTANT_NO_THEME_ON_ATTACH
+    /* put under a RequestedTheme: its {ThemeResource} values, looked up in the theme it had alone, again */
+    if (xaml_element_actual_theme( child ) != before) refresh_theme( child, 0 );
+#endif
     list_add_tail( &parent->children, &child->entry );
     IUnknown_AddRef( child->d.obj.outer );
     child->measure_valid = child->arrange_valid = FALSE;
@@ -2495,7 +2509,7 @@ static HRESULT WINAPI fe6_get_ActualTheme( struct xiface *iface, INT32 *value )
         if (box) IInspectable_Release( box );
         if (theme) { *value = theme; return S_OK; }
     }
-    *value = system_app_theme() ? 2 : 1;   /* ElementTheme Dark : Light */
+    *value = xaml_application_theme();   /* ElementTheme Light 1, Dark 2 */
     return S_OK;
 }
 
diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index b020f6d..839947d 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -206,6 +206,8 @@ struct xaml_property *xaml_property_register( const WCHAR *owner, const WCHAR *n
                                               IInspectable *default_value, BOOL attached,
                                               void (*changed)( struct dobj *, struct xaml_property *, IInspectable *, IInspectable * ) );
 struct xaml_property *xaml_property_find( const WCHAR *owner, const WCHAR *name );
+/* a dictionary entry standing for another key's resource, looked up when it is */
+IInspectable *xaml_resource_alias( const WCHAR *key );
 struct xaml_property *xaml_property_from_inspectable( IInspectable *iface );
 IInspectable *xaml_property_iface( struct xaml_property *prop );
 IInspectable *xaml_unset_value(void);
@@ -743,6 +745,8 @@ IInspectable *xaml_current_application(void);
 BOOL xaml_current_application_exists(void);
 /* the system's app theme: 0 light, 1 dark (ApplicationTheme) */
 INT32 system_app_theme(void);
+INT32 xaml_application_theme(void);
+INT32 xaml_element_actual_theme( struct uielem *elem );
 HRESULT xaml_load_text( const WCHAR *text, IInspectable *component, IInspectable **out );
