From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dsound: Restore, AcquireResources, capture buffer Initialize/GetObjectInPath/GetFXStatus, LockServer, IKsPropertySet::Set

FIXME stubs, as documented now (and as dsound's conformance tests expect):

- IDirectSoundBuffer::Restore (secondary and primary): DS_OK, nothing is
  ever lost; no FIXME.
- AcquireResources: only DSBPLAY_LOCSOFTWARE may be asked for, effects need
  DSBCAPS_CTRLFX (DSERR_CONTROLUNAVAIL), their count must be the one SetFX
  set (DSERR_INVALIDPARAM), and each gets DSFXR_LOCSOFTWARE.
- IDirectSoundCaptureBuffer::Initialize is DSERR_ALREADYINITIALIZED (the
  buffer comes initialized from CreateCaptureBuffer), GetFXStatus is
  DSERR_CONTROLUNAVAIL (DSERR_INVALIDPARAM without an array), GetObjectInPath
  keeps DSERR_CONTROLUNAVAIL without the FIXME.
- Class factory LockServer and IKsPropertySet::Set (E_PROP_ID_UNSUPPORTED):
  the right answers, without the FIXMEs.

---
diff --git a/dlls/dsound/buffer.c b/dlls/dsound/buffer.c
index 8e261fd..c7cd45e 100644
--- a/dlls/dsound/buffer.c
+++ b/dlls/dsound/buffer.c
@@ -695,7 +695,11 @@ static HRESULT WINAPI IDirectSoundBufferImpl_Restore(IDirectSoundBuffer8 *iface)
 {
         IDirectSoundBufferImpl *This = impl_from_IDirectSoundBuffer8(iface);
 
+	TRACE("(%p)\n",This);
+#ifdef SG_MUTANT_DSOUND_FIXME
 	FIXME("(%p):stub\n",This);
+#endif
+	/* buffers live in system memory and are never lost: there is nothing to restore */
 	return DS_OK;
 }
 
@@ -871,12 +875,26 @@ static HRESULT WINAPI IDirectSoundBufferImpl_AcquireResources(IDirectSoundBuffer
         IDirectSoundBufferImpl *This = impl_from_IDirectSoundBuffer8(iface);
 	DWORD u;
 
-	FIXME("(%p,%08lu,%lu,%p): stub, faking success\n",This,dwFlags,dwEffectsCount,pdwResultCodes);
+	TRACE("(%p,%08lx,%lu,%p)\n",This,dwFlags,dwEffectsCount,pdwResultCodes);
 
-	if (pdwResultCodes)
-		for (u=0; u<dwEffectsCount; u++) pdwResultCodes[u] = DSFXR_UNKNOWN;
+	/* only the software location can be asked for: there is no hardware mixing */
+	if (dwFlags & ~DSBPLAY_LOCSOFTWARE)
+		return DSERR_INVALIDPARAM;
+
+	if (dwEffectsCount && !(This->dsbd.dwFlags & DSBCAPS_CTRLFX)) {
+		WARN("attempted to acquire effects on buffer without DSBCAPS_CTRLFX\n");
+		return DSERR_CONTROLUNAVAIL;
+	}
+
+	/* the effects are those SetFX made; their software filters already exist */
+	if (dwEffectsCount != This->num_filters || (dwEffectsCount && !pdwResultCodes))
+		return DSERR_INVALIDPARAM;
+
+#ifdef SG_MUTANT_DSOUND_ACQUIRE
+	return DS_OK;
+#endif
+	for (u=0; u<dwEffectsCount; u++) pdwResultCodes[u] = DSFXR_LOCSOFTWARE;
 
-	WARN("control unavailable\n");
 	return DS_OK;
 }
 
diff --git a/dlls/dsound/capture.c b/dlls/dsound/capture.c
index e901260..23d0be1 100644
--- a/dlls/dsound/capture.c
+++ b/dlls/dsound/capture.c
@@ -417,9 +417,13 @@ static HRESULT WINAPI IDirectSoundCaptureBufferImpl_Initialize(IDirectSoundCaptu
 {
     IDirectSoundCaptureBufferImpl *This = impl_from_IDirectSoundCaptureBuffer8(iface);
 
-    FIXME( "(%p,%p,%p): stub\n", This, lpDSC, lpcDSCBDesc );
+    TRACE( "(%p,%p,%p)\n", This, lpDSC, lpcDSCBDesc );
 
+    /* a capture buffer is made initialized by CreateCaptureBuffer */
+#ifdef SG_MUTANT_DSOUND_CAPTURE
     return DS_OK;
+#endif
+    return DSERR_ALREADYINITIALIZED;
 }
 
 static HRESULT WINAPI IDirectSoundCaptureBufferImpl_Lock(IDirectSoundCaptureBuffer8 *iface,
@@ -589,7 +593,7 @@ static HRESULT WINAPI IDirectSoundCaptureBufferImpl_GetObjectInPath(IDirectSound
 {
     IDirectSoundCaptureBufferImpl *This = impl_from_IDirectSoundCaptureBuffer8(iface);
 
-    FIXME( "(%p,%s,%lu,%s,%p): stub\n", This, debugstr_guid(rguidObject),
+    TRACE( "(%p,%s,%lu,%s,%p)\n", This, debugstr_guid(rguidObject),
         dwIndex, debugstr_guid(rguidInterface), ppObject );
 
     if (!ppObject)
@@ -604,9 +608,15 @@ static HRESULT WINAPI IDirectSoundCaptureBufferImpl_GetFXStatus(IDirectSoundCapt
 {
     IDirectSoundCaptureBufferImpl *This = impl_from_IDirectSoundCaptureBuffer8(iface);
 
-    FIXME( "(%p,%lu,%p): stub\n", This, dwFXCount, pdwFXStatus );
+    TRACE( "(%p,%lu,%p)\n", This, dwFXCount, pdwFXStatus );
 
+    /* capture effects are not supported: the buffer was never created with DSCBCAPS_CTRLFX */
+    if (!pdwFXStatus && dwFXCount)
+        return DSERR_INVALIDPARAM;
+#ifdef SG_MUTANT_DSOUND_CAPTURE
     return DS_OK;
+#endif
+    return DSERR_CONTROLUNAVAIL;
 }
 
 static const IDirectSoundCaptureBuffer8Vtbl dscbvt =
diff --git a/dlls/dsound/dsound_main.c b/dlls/dsound/dsound_main.c
index bb373a4..31a6cd9 100644
--- a/dlls/dsound/dsound_main.c
+++ b/dlls/dsound/dsound_main.c
@@ -686,7 +686,8 @@ static HRESULT WINAPI DSCF_CreateInstance(
 static HRESULT WINAPI DSCF_LockServer(LPCLASSFACTORY iface, BOOL dolock)
 {
     IClassFactoryImpl *This = impl_from_IClassFactory(iface);
-    FIXME("(%p, %d) stub!\n", This, dolock);
+    TRACE("(%p, %d)\n", This, dolock);
+    /* the server's objects are static: locking it changes nothing */
     return S_OK;
 }
 
diff --git a/dlls/dsound/primary.c b/dlls/dsound/primary.c
index 2073a32..8b41a67 100644
--- a/dlls/dsound/primary.c
+++ b/dlls/dsound/primary.c
@@ -1012,7 +1012,11 @@ static HRESULT WINAPI PrimaryBufferImpl_Unlock(IDirectSoundBuffer8 *iface, void
 static HRESULT WINAPI PrimaryBufferImpl_Restore(IDirectSoundBuffer8 *iface)
 {
         IDirectSoundBufferImpl *This = impl_from_IDirectSoundBuffer8(iface);
+	TRACE("(%p)\n",This);
+#ifdef SG_MUTANT_DSOUND_FIXME
 	FIXME("(%p):stub\n",This);
+#endif
+	/* the primary buffer is never lost: there is nothing to restore */
 	return DS_OK;
 }
 
diff --git a/dlls/dsound/propset.c b/dlls/dsound/propset.c
index be284a6..ce2f20b 100644
--- a/dlls/dsound/propset.c
+++ b/dlls/dsound/propset.c
@@ -547,7 +547,8 @@ static HRESULT WINAPI IKsPrivatePropertySetImpl_Set(
 {
     IKsPrivatePropertySetImpl *This = impl_from_IKsPropertySet(iface);
 
-    FIXME("(%p,%s,%ld,%p,%ld,%p,%ld), stub!\n",This,debugstr_guid(guidPropSet),dwPropID,pInstanceData,cbInstanceData,pPropData,cbPropData);
+    TRACE("(%p,%s,%ld,%p,%ld,%p,%ld)\n",This,debugstr_guid(guidPropSet),dwPropID,pInstanceData,cbInstanceData,pPropData,cbPropData);
+    /* the properties this set offers are read-only */
     return E_PROP_ID_UNSUPPORTED;
 }
 
