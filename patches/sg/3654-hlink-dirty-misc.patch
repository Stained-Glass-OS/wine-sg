 }
 
 static HRESULT WINAPI BindStatusCallback_OnLowResource(IBindStatusCallback *iface, DWORD reserved)
@@ -824,8 +827,8 @@ static HRESULT WINAPI BindStatusCallback_GetBindInfo(IBindStatusCallback *iface,
 static HRESULT WINAPI BindStatusCallback_OnDataAvailable(IBindStatusCallback *iface, DWORD grfBSCF,
         DWORD dwSize, FORMATETC* pformatetc, STGMEDIUM* pstgmed)
 {
-    ok(0, "unexpected call\n");
-    return E_NOTIMPL;
+    CHECK_EXPECT(BindStatusCallback_OnDataAvailable);
+    return 0x1234;
 }
 
 static HRESULT WINAPI BindStatusCallback_OnObjectAvailable(IBindStatusCallback *iface, REFIID iid, IUnknown *out)
@@ -2233,6 +2236,7 @@ static void test_Hlink_Navigate(void)
     IHlink *hlink;
     IBindCtx *pbc;
     HRESULT hres;
+    LONG priority;
 
     hres = CreateBindCtx(0, &pbc);
     ok(hres == S_OK, "CreateBindCtx failed: %08lx\n", hres);
@@ -2410,6 +2414,12 @@ todo_wine {
     hres = IBindStatusCallback_GetBindInfo(async_bind_callback, &bind_flags, &bind_info);
     ok(hres == S_OK, "Got hr %#lx.\n", hres);
 
+    priority = 99;
+    hres = IBindStatusCallback_GetPriority(async_bind_callback, &priority);
+    ok(hres == E_NOTIMPL, "Got hr %#lx.\n", hres);
+    hres = IBindStatusCallback_OnDataAvailable(async_bind_callback, BSCF_FIRSTDATANOTIFICATION, 0, NULL, NULL);
+    ok(hres == S_OK, "Got hr %#lx.\n", hres);
+
     hres = IBindStatusCallback_OnStartBinding(async_bind_callback, 0, NULL);
     ok(hres == S_OK, "Got hr %#lx.\n", hres);
 
@@ -2471,6 +2481,17 @@ todo_wine {
     ok(hres == E_NOTIMPL, "Got hr %#lx.\n", hres);
     CHECK_CALLED(BindStatusCallback_GetBindInfo);
 
+    SET_EXPECT(BindStatusCallback_GetPriority);
+    priority = 0;
+    hres = IBindStatusCallback_GetPriority(async_bind_callback, &priority);
+    ok(hres == S_OK && priority == 17, "Got hr %#lx, priority %ld.\n", hres, priority);
+    CHECK_CALLED(BindStatusCallback_GetPriority);
+
+    SET_EXPECT(BindStatusCallback_OnDataAvailable);
+    hres = IBindStatusCallback_OnDataAvailable(async_bind_callback, BSCF_FIRSTDATANOTIFICATION, 0, NULL, NULL);
+    ok(hres == 0x1234, "Got hr %#lx.\n", hres);
+    CHECK_CALLED(BindStatusCallback_OnDataAvailable);
+
     SET_EXPECT(BindStatusCallback_OnStartBinding);
     hres = IBindStatusCallback_OnStartBinding(async_bind_callback, 0, NULL);
     ok(hres == S_OK, "Got hr %#lx.\n", hres);
@@ -2630,6 +2651,91 @@ static void test_HlinkCreateFromString(void)
     IPersistStream_Release(stream);
 }
 
+static void test_sg_dirty_misc(void)
+{
+    IHlink *link;
+    IPersistStream *ps;
+    IStream *stream;
+    IClassFactory *cf;
+    DWORD status;
+    HRESULT hr;
+
+    hr = HlinkCreateFromString(L"http://www.winehq.org/", NULL, L"friendly", NULL, 0, NULL, &IID_IHlink, (void **)&link);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IHlink_QueryInterface(link, &IID_IPersistStream, (void **)&ps);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* absolute reference: not relative */
+    status = 0xdeadbeef;
+    hr = IHlink_GetMiscStatus(link, &status);
+    ok(hr == S_OK && status == 0, "got %#lx %#lx\n", hr, status);
+    hr = IHlink_GetMiscStatus(link, NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    hr = IPersistStream_IsDirty(ps);
+    ok(hr == S_OK, "a link that was just built has changes to save, got %#lx\n", hr);
+
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    hr = IPersistStream_Save(ps, stream, FALSE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistStream_IsDirty(ps);
+    ok(hr == S_OK, "Save without clearing keeps it dirty, got %#lx\n", hr);
+    hr = IPersistStream_Save(ps, stream, TRUE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistStream_IsDirty(ps);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+
+    hr = IHlink_SetFriendlyName(link, L"other");
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistStream_IsDirty(ps);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IPersistStream_Save(ps, stream, TRUE);
+    hr = IPersistStream_IsDirty(ps);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+    hr = IHlink_SetTargetFrameName(link, L"frame");
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPersistStream_IsDirty(ps);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* loading clears it */
+    {
+        LARGE_INTEGER zero = {{0}};
+        IPersistStream *ps2;
+        IHlink *link2;
+
+        IPersistStream_Save(ps, stream, TRUE);
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+        hr = CoCreateInstance(&CLSID_StdHlink, NULL, CLSCTX_INPROC_SERVER, &IID_IHlink, (void **)&link2);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        IHlink_QueryInterface(link2, &IID_IPersistStream, (void **)&ps2);
+        hr = IPersistStream_Load(ps2, stream);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        hr = IPersistStream_IsDirty(ps2);
+        ok(hr == S_FALSE, "got %#lx\n", hr);
+        IPersistStream_Release(ps2);
+        IHlink_Release(link2);
+    }
+    IStream_Release(stream);
+    IPersistStream_Release(ps);
+    IHlink_Release(link);
+
+    /* a relative reference */
+    hr = HlinkCreateFromString(L"relative\\file.htm", NULL, NULL, NULL, 0, NULL, &IID_IHlink, (void **)&link);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IHlink_GetMiscStatus(link, &status);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(status == HLINKMISC_RELATIVE, "got %#lx\n", status);
+    IHlink_Release(link);
+
+    hr = CoGetClassObject(&CLSID_StdHlink, CLSCTX_INPROC_SERVER, NULL, &IID_IClassFactory, (void **)&cf);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IClassFactory_LockServer(cf, TRUE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IClassFactory_LockServer(cf, FALSE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    IClassFactory_Release(cf);
+}
+
 START_TEST(hlink)
 {
     CoInitialize(NULL);
@@ -2652,6 +2758,7 @@ START_TEST(hlink)
     test_HlinkUpdateStackItem();
     test_HlinkCreateFromMoniker();
     test_HlinkCreateFromString();
+    test_sg_dirty_misc();
 
     CoUninitialize();
 }
