From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] hlink: IsDirty, GetMiscStatus, LockServer, bind callback forwarding (3654)

hlink: IsDirty, GetMiscStatus, LockServer, bind callback forwarding

IPersistStream::IsDirty tracks changes, IHlink::GetMiscStatus reports relative links,
IClassFactory::LockServer succeeds and the hlink's bind status callback forwards
GetPriority and OnDataAvailable to the caller's callback.
---
diff --git a/dlls/hlink/hlink_main.c b/dlls/hlink/hlink_main.c
index 2109ea7..bd50f59 100644
--- a/dlls/hlink/hlink_main.c
+++ b/dlls/hlink/hlink_main.c
@@ -493,8 +493,12 @@ static HRESULT WINAPI HLinkCF_fnCreateInstance( LPCLASSFACTORY iface,
 
 static HRESULT WINAPI HLinkCF_fnLockServer(LPCLASSFACTORY iface, BOOL fLock)
 {
-    FIXME("%p %d\n", iface, fLock);
+    TRACE("%p %d\n", iface, fLock);
+#ifdef SG_MUTANT_HLINK_LOCK
     return E_NOTIMPL;
+#else
+    return S_OK;
+#endif
 }
 
 static const IClassFactoryVtbl hlcfvt =
diff --git a/dlls/hlink/link.c b/dlls/hlink/link.c
index 42eaf0b..cbbcf87 100644
--- a/dlls/hlink/link.c
+++ b/dlls/hlink/link.c
@@ -52,6 +52,7 @@ typedef struct
     IHlinkSite          *Site;
     DWORD               SiteData;
     BOOL                absolute;
+    BOOL                dirty;     /* changed since the last Save/Load */
 
     IBindStatusCallback IBindStatusCallback_iface;
     IBindStatusCallback *bind_callback;
@@ -224,6 +225,8 @@ static HRESULT WINAPI IHlink_fnSetMonikerReference( IHlink* iface,
     TRACE("(%p)->(%li %p %s)\n", This, rfHLSETF, pmkTarget,
             debugstr_w(pwzLocation));
 
+    This->dirty = TRUE;
+
     if(rfHLSETF == 0)
         return E_INVALIDARG;
     if(!(rfHLSETF & (HLINKSETF_TARGET | HLINKSETF_LOCATION)))
@@ -263,6 +266,8 @@ static HRESULT WINAPI IHlink_fnSetStringReference(IHlink* iface,
     TRACE("(%p)->(%li %s %s)\n", This, grfHLSETF, debugstr_w(pwzTarget),
             debugstr_w(pwzLocation));
 
+    This->dirty = TRUE;
+
     if(grfHLSETF > (HLINKSETF_TARGET | HLINKSETF_LOCATION) &&
             grfHLSETF < -(HLINKSETF_TARGET | HLINKSETF_LOCATION))
         return grfHLSETF;
@@ -410,6 +415,7 @@ static HRESULT WINAPI IHlink_fnSetFriendlyName (IHlink *iface,
 
     TRACE("(%p) -> (%s)\n", This, debugstr_w(pwzFriendlyName));
 
+    This->dirty = TRUE;
     free(This->FriendlyName);
     This->FriendlyName = wcsdup( pwzFriendlyName );
 
@@ -458,6 +464,7 @@ static HRESULT WINAPI IHlink_fnSetTargetFrameName(IHlink* iface,
     HlinkImpl  *This = impl_from_IHlink(iface);
     TRACE("(%p)->(%s)\n", This, debugstr_w(pwzTargetFramename));
 
+    This->dirty = TRUE;
     free(This->TargetFrameName);
     This->TargetFrameName = wcsdup( pwzTargetFramename );
 
@@ -485,8 +492,18 @@ static HRESULT WINAPI IHlink_fnGetTargetFrameName(IHlink* iface,
 
 static HRESULT WINAPI IHlink_fnGetMiscStatus(IHlink* iface, DWORD* pdwStatus)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    HlinkImpl *This = impl_from_IHlink(iface);
+
+    TRACE("(%p)->(%p)\n", This, pdwStatus);
+
+    if (!pdwStatus) return E_INVALIDARG;
+    /* a relative link has a moniker that is not absolute */
+#ifdef SG_MUTANT_HLINK_REL
+    *pdwStatus = 0;
+#else
+    *pdwStatus = (This->Moniker && !This->absolute) ? HLINKMISC_RELATIVE : 0;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI IHlink_fnNavigate(IHlink *iface, DWORD flags, IBindCtx *user_bind_ctx,
@@ -974,8 +991,15 @@ static HRESULT WINAPI IPersistStream_fnGetClassID(IPersistStream* iface,
 
 static HRESULT WINAPI IPersistStream_fnIsDirty(IPersistStream* iface)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    HlinkImpl *This = impl_from_IPersistStream(iface);
+
+    TRACE("(%p)\n", This);
+
+#ifdef SG_MUTANT_HLINK_DIRTY
+    return S_FALSE;
+#else
+    return This->dirty ? S_OK : S_FALSE;
+#endif
 }
 
 static HRESULT write_hlink_string(IStream *pStm, LPCWSTR str)
@@ -1086,6 +1110,8 @@ static HRESULT WINAPI IPersistStream_fnLoad(IPersistStream* iface,
 end:
     TRACE("Load Result 0x%lx (%p)\n", r, This->Moniker);
 
+    if (SUCCEEDED(r)) This->dirty = FALSE;
+
     return r;
 }
 
@@ -1157,6 +1183,8 @@ end:
     if (moniker) IMoniker_Release(moniker);
     TRACE("Save Result 0x%lx\n", r);
 
+    if (SUCCEEDED(r) && fClearDirty) This->dirty = FALSE;
+
     return r;
 }
 
@@ -1258,7 +1286,14 @@ static HRESULT WINAPI bind_callback_OnStartBinding(IBindStatusCallback *iface,
 
 static HRESULT WINAPI bind_callback_GetPriority(IBindStatusCallback *iface, LONG *priority)
 {
-    FIXME("iface %p, priority %p, stub!\n", iface, priority);
+    HlinkImpl *hlink = impl_from_IBindStatusCallback(iface);
+
+    TRACE("hlink %p, priority %p.\n", hlink, priority);
+
+#ifndef SG_MUTANT_HLINK_PRIO
+    if (hlink->bind_callback)
+        return IBindStatusCallback_GetPriority(hlink->bind_callback, priority);
+#endif
     return E_NOTIMPL;
 }
 
@@ -1323,9 +1358,15 @@ static HRESULT WINAPI bind_callback_GetBindInfo(IBindStatusCallback *iface,
 static HRESULT WINAPI bind_callback_OnDataAvailable(IBindStatusCallback *iface,
         DWORD flags, DWORD size, FORMATETC *formatetc, STGMEDIUM *stgmed)
 {
-    FIXME("iface %p, flags %#lx, size %ld, formatetc %p, stgmed %p, stub!\n",
-            iface, flags, size, formatetc, stgmed);
-    return E_NOTIMPL;
+    HlinkImpl *hlink = impl_from_IBindStatusCallback(iface);
+
+    TRACE("hlink %p, flags %#lx, size %ld, formatetc %p, stgmed %p.\n", hlink, flags, size, formatetc, stgmed);
+
+#ifndef SG_MUTANT_HLINK_DATA
+    if (hlink->bind_callback)
+        return IBindStatusCallback_OnDataAvailable(hlink->bind_callback, flags, size, formatetc, stgmed);
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI bind_callback_OnObjectAvailable(IBindStatusCallback *iface,
diff --git a/dlls/hlink/tests/hlink.c b/dlls/hlink/tests/hlink.c
index dde3219..7def2af 100644
--- a/dlls/hlink/tests/hlink.c
+++ b/dlls/hlink/tests/hlink.c
@@ -82,6 +82,8 @@ DEFINE_EXPECT(HT_GetFriendlyName);
 DEFINE_EXPECT(HLF_UpdateHlink);
 
 DEFINE_EXPECT(BindStatusCallback_GetBindInfo);
