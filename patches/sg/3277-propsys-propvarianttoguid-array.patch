From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:56:08 -0700
Subject: [PATCH] propsys: PropVariantToGUID reads a 16-byte array (3277)

VT_ARRAY|VT_UI1 holding sixteen bytes converts to a GUID; VT_EMPTY and other types fail with E_INVALIDARG (GUESS for the code) instead of E_NOTIMPL.

diff --git a/dlls/propsys/propvar.c b/dlls/propsys/propvar.c
index a1e586e..ac2b032 100644
--- a/dlls/propsys/propvar.c
+++ b/dlls/propsys/propvar.c
@@ -1161,9 +1161,30 @@ HRESULT WINAPI PropVariantToGUID(const PROPVARIANT *ppropvar, GUID *guid)
         return hr;
     }
 #endif
-    default:
-        FIXME("unsupported vt: %d\n", ppropvar->vt);
+    case VT_ARRAY | VT_UI1:
+    {
+        LONG lbound, ubound;
+        void *data;
+#ifdef SG_MUTANT_PROPSYS
         return E_NOTIMPL;
+#endif
+
+        /* sixteen bytes of a GUID */
+        if (!ppropvar->parray || SafeArrayGetDim(ppropvar->parray) != 1
+                || FAILED(SafeArrayGetLBound(ppropvar->parray, 1, &lbound))
+                || FAILED(SafeArrayGetUBound(ppropvar->parray, 1, &ubound))
+                || ubound - lbound + 1 != sizeof(GUID))
+            return E_INVALIDARG;
+        if (FAILED(SafeArrayAccessData(ppropvar->parray, &data))) return E_INVALIDARG;
+        memcpy(guid, data, sizeof(GUID));
+        SafeArrayUnaccessData(ppropvar->parray);
+        return S_OK;
+    }
+    case VT_EMPTY:
+    default:
+        /* a type that holds no GUID; GUESS: the code of the failure is not documented */
+        WARN("unsupported vt: %d\n", ppropvar->vt);
+        return E_INVALIDARG;
     }
 }
 
