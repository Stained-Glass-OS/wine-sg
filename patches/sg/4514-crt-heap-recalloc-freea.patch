diff --git a/dlls/msvcrt/heap.c b/dlls/msvcrt/heap.c
index 70e4ecb..e7eb8e1 100644
--- a/dlls/msvcrt/heap.c
+++ b/dlls/msvcrt/heap.c
@@ -499,6 +499,82 @@ void* CDECL _recalloc(void *mem, size_t num, size_t size)
         memset((BYTE*)ret+old_size, 0, size-old_size);
     return ret;
 }
+
+/*********************************************************************
+ * _recalloc_crt (MSVCR80.@)
+ */
+void* CDECL _recalloc_crt(void *mem, size_t num, size_t size)
+{
+    return _recalloc(mem, num, size);
+}
+
+/* the header _malloca puts before a block */
+#define _ALLOCA_S_STACK_MARKER 0xcccc
+#define _ALLOCA_S_HEAP_MARKER  0xdddd
+#ifdef _WIN64
+#define _ALLOCA_S_MARKER_SIZE  16
+#else
+#define _ALLOCA_S_MARKER_SIZE  8
+#endif
+
+/*********************************************************************
+ * _freea (MSVCR80.@)
+ *
+ * Frees a block from the _malloca macro: those on the heap carry the heap
+ * marker in the header before the returned pointer, those on the stack the
+ * stack marker.
+ */
+void CDECL _freea(void *mem)
+{
+    if (!mem) return;
+    mem = (char *)mem - _ALLOCA_S_MARKER_SIZE;
+    if (*(unsigned int *)mem == _ALLOCA_S_HEAP_MARKER)
+        free(mem);
+}
+
+/*********************************************************************
+ * _freea_s (MSVCR80.@)
+ */
+void CDECL _freea_s(void *mem)
+{
+    _freea(mem);
+}
+
+static unsigned long malloc_crt_max_wait;
+
+/*********************************************************************
+ * _set_malloc_crt_max_wait (MSVCR80.@)
+ */
+unsigned long CDECL _set_malloc_crt_max_wait(unsigned long wait)
+{
+    unsigned long old = malloc_crt_max_wait;
+
+    if (wait) FIXME("(%lu) the CRT does not retry failed allocations\n", wait);
+    malloc_crt_max_wait = wait;
+    return old;
+}
+#endif
+
+#if _MSVCR_VER>=80 && _MSVCR_VER<=90
+/*********************************************************************
+ * _get_amblksiz (MSVCR80.@)
+ */
+int CDECL _get_amblksiz(size_t *value)
+{
+    if (!MSVCRT_CHECK_PMT(value != NULL)) return EINVAL;
+    *value = MSVCRT_amblksiz;
+    return 0;
+}
+
+/*********************************************************************
+ * _set_amblksiz (MSVCR80.@)
+ */
+int CDECL _set_amblksiz(size_t value)
+{
+    if (!MSVCRT_CHECK_PMT(value != 0)) return EINVAL;
+    MSVCRT_amblksiz = value;
+    return 0;
+}
 #endif
 
 /*********************************************************************
@@ -730,6 +806,42 @@ void * CDECL _aligned_realloc(void *memblock, size_t size, size_t alignment)
     return _aligned_offset_realloc(memblock, size, alignment, 0);
 }
 
+#if _MSVCR_VER>=80
+/*********************************************************************
+ *		_aligned_offset_recalloc (MSVCR80.@)
+ */
+void * CDECL _aligned_offset_recalloc(void *memblock, size_t num, size_t size,
+        size_t alignment, size_t offset)
+{
+    size_t old_size = 0, new_size;
+    void *ret;
+
+    TRACE("(%p, %Iu, %Iu, %Iu, %Iu)\n", memblock, num, size, alignment, offset);
+
+    if (size && num > ~(size_t)0 / size)
+    {
+        *_errno() = ENOMEM;
+        return NULL;
+    }
+    new_size = num * size;
+    if (memblock && new_size) old_size = _aligned_msize(memblock, alignment, offset);
+    ret = _aligned_offset_realloc(memblock, new_size, alignment, offset);
+#ifndef SG_MUTANT_RECALLOC_NO_ZERO
+    if (ret && new_size > old_size)
+        memset((BYTE *)ret + old_size, 0, new_size - old_size);
+#endif
+    return ret;
+}
+
+/*********************************************************************
+ *		_aligned_recalloc (MSVCR80.@)
+ */
+void * CDECL _aligned_recalloc(void *memblock, size_t num, size_t size, size_t alignment)
+{
+    return _aligned_offset_recalloc(memblock, num, size, alignment, 0);
+}
+#endif
+
 /*********************************************************************
  *		memmove_s (MSVCRT.@)
  */
