From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, ntdll: SYSTEM and elevated administrators set the read-only flag of a file another account owns

Only a file's owner may chmod it, so a SYSTEM service (or an elevated
administrator's program) could not set or clear the read-only flag of a
user's file -- GOG GALAXY's service and the files its client, run by the
user, had made (7794 covered only a flag that does not change). When the
fchmod is refused, ntdll asks the server (new request sg_chmod_fd), which
does it for a SYSTEM token or one with Administrators enabled only, making
the system wineserver's CAP_FOWNER (permitted only) effective for that one
fchmod; anyone else is refused, as before.
---
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 369cbe1..69f3791 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -1827,7 +1827,31 @@ static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set )
 
 
 /* set the stat info and file attributes for a file (by file descriptor) */
-static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
+/* Stained Glass OS: fchmod, and for a file another account owns, the server's -- which does it for
+ * SYSTEM or an elevated administrator only, as Windows lets them change any file's attributes
+ * (wine-sg 7795) */
+static int sg_fchmod( HANDLE handle, int fd, mode_t mode )
+{
+    NTSTATUS status;
+
+    if (!fchmod( fd, mode )) return 0;
+    if (errno != EPERM || !handle) return -1;
+#ifdef SG_MUTANT_CHMOD_NO_SERVER
+    return -1;
+#endif
+    SERVER_START_REQ( sg_chmod_fd )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        req->mode   = mode;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (!status) return 0;
+    errno = EPERM;
+    return -1;
+}
+
+static NTSTATUS fd_set_file_info( HANDLE handle, int fd, UINT attr, BOOL force_set_xattr )
 {
     struct stat st;
     mode_t old_mode;
@@ -1867,14 +1891,14 @@ static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
         return STATUS_SUCCESS;
     }
 #endif
-    if (!S_ISDIR( st.st_mode ) && !(st.st_mode & 0200)) fchmod( fd, st.st_mode | 0200 );
-    else if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
+    if (!S_ISDIR( st.st_mode ) && !(st.st_mode & 0200)) sg_fchmod( handle, fd, st.st_mode | 0200 );
+    else if (sg_fchmod( handle, fd, st.st_mode ) == -1) return errno_to_status( errno );
     if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
         WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)\n",
               errno, strerror( errno ) );
-    if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
+    if (sg_fchmod( handle, fd, st.st_mode ) == -1) return errno_to_status( errno );
 #else
-    if (fchmod( fd, st.st_mode ) == -1) return errno_to_status( errno );
+    if (sg_fchmod( handle, fd, st.st_mode ) == -1) return errno_to_status( errno );
     if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
         WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)\n",
               errno, strerror( errno ) );
@@ -5886,7 +5910,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                 status = set_file_times( fd, &mtime, &atime );
 
             if (status == STATUS_SUCCESS)
-                status = fd_set_file_info( fd, info->FileAttributes,
+                status = fd_set_file_info( handle, fd, info->FileAttributes,
                                            unix_name && is_hidden_file( unix_name ));
 
             if (needs_close) close( fd );
diff --git a/include/wine/server_protocol.h b/include/wine/server_protocol.h
index 6085824..81a2d86 100644
--- a/include/wine/server_protocol.h
+++ b/include/wine/server_protocol.h
@@ -6420,6 +6420,21 @@ struct register_terminate_port_reply
 };
 
 
+/* Stained Glass OS: set the Unix mode of a file the caller does not own (its read-only flag), for a
+ * SYSTEM or an elevated administrator's process, as Windows lets them (wine-sg 7795) */
+struct sg_chmod_fd_request
+{
+    struct request_header __header;
+    obj_handle_t handle;
+    unsigned int mode;
+    char __pad_20[4];
+};
+struct sg_chmod_fd_reply
+{
+    struct reply_header __header;
+};
+
+
 enum request
 {
     REQ_new_process,
@@ -6744,6 +6759,7 @@ enum request
     REQ_send_port_message,
     REQ_receive_port_message,
     REQ_register_terminate_port,
+    REQ_sg_chmod_fd,
     REQ_NB_REQUESTS
 };
 
@@ -7073,6 +7089,7 @@ union generic_request
     struct send_port_message_request send_port_message_request;
     struct receive_port_message_request receive_port_message_request;
     struct register_terminate_port_request register_terminate_port_request;
+    struct sg_chmod_fd_request sg_chmod_fd_request;
 };
 union generic_reply
 {
@@ -7400,8 +7417,9 @@ union generic_reply
     struct send_port_message_reply send_port_message_reply;
     struct receive_port_message_reply receive_port_message_reply;
     struct register_terminate_port_reply register_terminate_port_reply;
+    struct sg_chmod_fd_reply sg_chmod_fd_reply;
 };
 
-#define SERVER_PROTOCOL_VERSION 877
+#define SERVER_PROTOCOL_VERSION 878
 
 #endif /* __WINE_WINE_SERVER_PROTOCOL_H */
diff --git a/server/fd.c b/server/fd.c
index ff3ad6e..83f647a 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -97,6 +97,7 @@
 
 #include "winternl.h"
 #include "winioctl.h"
+#include "security.h"
 #include "ddk/wdm.h"
 
 #if defined(HAVE_SYS_EPOLL_H) && defined(HAVE_EPOLL_CREATE)
@@ -3519,3 +3520,43 @@ DECL_HANDLER(set_fd_eof_info)
         release_object( fd );
     }
 }
+
+/* Stained Glass OS: a file's mode set for SYSTEM or an elevated administrator although another account
+ * owns it -- the system wineserver's CAP_FOWNER (permitted only) made effective for that one fchmod.
+ * A SYSTEM service setting or clearing the read-only flag of a user's file was refused (wine-sg 7795). */
+#ifndef CAP_FOWNER
+#define CAP_FOWNER 3
+#endif
+
+DECL_HANDLER(sg_chmod_fd)
+{
+    struct token *token = current->token ? current->token : current->process->token;
+    struct fd *fd;
+    int unix_fd, ret, err;
+
+    if (!token || (!equal_sid( token_get_user( token ), &local_system_sid ) &&
+#ifndef SG_MUTANT_CHMOD_ANYONE
+                   !token_sid_present( token, &builtin_admins_sid, FALSE )))
+#else
+                   0))
+#endif
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return;
+    }
+    /* (Wine's SetFileAttributes opens with SYNCHRONIZE alone; SYSTEM and an elevated administrator
+     * may write any file's attributes) */
+    if (!(fd = get_handle_fd_obj( current->process, req->handle, 0 ))) return;
+    if ((unix_fd = get_unix_fd( fd )) != -1)
+    {
+        if ((ret = fchmod( unix_fd, req->mode & 07777 )) == -1 && errno == EPERM && !sg_capability( CAP_FOWNER, 1 ))
+        {
+            ret = fchmod( unix_fd, req->mode & 07777 );
+            err = errno;
+            sg_capability( CAP_FOWNER, 0 );
+            errno = err;
+        }
+        if (ret == -1) file_set_error();
+    }
+    release_object( fd );
+}
diff --git a/server/protocol.def b/server/protocol.def
index 49cd1ab..361dff9 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -4431,3 +4431,11 @@ struct handle_info
 @REQ(register_terminate_port)
     obj_handle_t handle;        /* port handle */
 @END
+
+
+/* Stained Glass OS: set the Unix mode of a file the caller does not own (its read-only flag), for a
+ * SYSTEM or an elevated administrator's process, as Windows lets them (wine-sg 7795) */
+@REQ(sg_chmod_fd)
+    obj_handle_t handle;        /* the file */
+    unsigned int mode;          /* its new mode */
+@END
diff --git a/server/request_handlers.h b/server/request_handlers.h
index 933eb89..7e27f65 100644
--- a/server/request_handlers.h
+++ b/server/request_handlers.h
@@ -329,6 +329,7 @@ DECL_HANDLER(complete_port_connect);
 DECL_HANDLER(send_port_message);
 DECL_HANDLER(receive_port_message);
 DECL_HANDLER(register_terminate_port);
+DECL_HANDLER(sg_chmod_fd);
 
 typedef void (*req_handler)( const void *req, void *reply );
 static const req_handler req_handlers[REQ_NB_REQUESTS] =
@@ -655,6 +656,7 @@ static const req_handler req_handlers[REQ_NB_REQUESTS] =
     (req_handler)req_send_port_message,
     (req_handler)req_receive_port_message,
     (req_handler)req_register_terminate_port,
+    (req_handler)req_sg_chmod_fd,
 };
 
 C_ASSERT( sizeof(abstime_t) == 8 );
@@ -2496,3 +2498,6 @@ C_ASSERT( offsetof(struct receive_port_message_reply, data_len) == 32 );
 C_ASSERT( sizeof(struct receive_port_message_reply) == 40 );
 C_ASSERT( offsetof(struct register_terminate_port_request, handle) == 12 );
 C_ASSERT( sizeof(struct register_terminate_port_request) == 16 );
+C_ASSERT( offsetof(struct sg_chmod_fd_request, handle) == 12 );
+C_ASSERT( offsetof(struct sg_chmod_fd_request, mode) == 16 );
+C_ASSERT( sizeof(struct sg_chmod_fd_request) == 24 );
diff --git a/server/request_trace.h b/server/request_trace.h
index 3b87083..9537efb 100644
--- a/server/request_trace.h
+++ b/server/request_trace.h
@@ -3694,6 +3694,12 @@ static void dump_register_terminate_port_request( const struct register_terminat
     fprintf( stderr, " handle=%04x", req->handle );
 }
 
+static void dump_sg_chmod_fd_request( const struct sg_chmod_fd_request *req )
+{
+    fprintf( stderr, " handle=%04x", req->handle );
+    fprintf( stderr, ", mode=%08x", req->mode );
+}
+
 typedef void (*dump_func)( const void *req );
 
 static const dump_func req_dumpers[REQ_NB_REQUESTS] =
@@ -4020,6 +4026,7 @@ static const dump_func req_dumpers[REQ_NB_REQUESTS] =
     (dump_func)dump_send_port_message_request,
     (dump_func)dump_receive_port_message_request,
     (dump_func)dump_register_terminate_port_request,
+    (dump_func)dump_sg_chmod_fd_request,
 };
 
 static const dump_func reply_dumpers[REQ_NB_REQUESTS] =
@@ -4346,6 +4353,7 @@ static const dump_func reply_dumpers[REQ_NB_REQUESTS] =
     (dump_func)dump_send_port_message_reply,
     (dump_func)dump_receive_port_message_reply,
     NULL,
+    NULL,
 };
 
 static const char * const req_names[REQ_NB_REQUESTS] =
@@ -4672,6 +4680,7 @@ static const char * const req_names[REQ_NB_REQUESTS] =
     "send_port_message",
     "receive_port_message",
     "register_terminate_port",
+    "sg_chmod_fd",
 };
 
 static const struct
@@ -4775,6 +4784,7 @@ static const struct
     { "NO_IMPERSONATION_TOKEN",      STATUS_NO_IMPERSONATION_TOKEN },
     { "NO_MEMORY",                   STATUS_NO_MEMORY },
     { "NO_MORE_ENTRIES",             STATUS_NO_MORE_ENTRIES },
+    { "NO_MORE_FILES",               STATUS_NO_MORE_FILES },
     { "NO_SUCH_DEVICE",              STATUS_NO_SUCH_DEVICE },
     { "NO_SUCH_FILE",                STATUS_NO_SUCH_FILE },
     { "NO_SUCH_LOGON_SESSION",       STATUS_NO_SUCH_LOGON_SESSION },
