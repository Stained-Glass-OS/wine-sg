From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a pbuffer is a GLX pixmap with a software renderer

With Mesa's software renderer, drawing to a pbuffer's front buffer (glDrawBuffer(GL_FRONT), then
glFlush or glFinish) puts the image on the GLXPbuffer with XShmPutImage; the X server answers
BadMatch and the X error ends the program. Java 3D clears a 1x1 pbuffer that way while it sets up:
Sweet Home 3D closed before showing a window, on a machine without a GPU (Xvfb, a VM).

When GLX_MESA_query_renderer says the renderer is not accelerated and the pixel format can draw to
pixmaps, wglCreatePbufferARB makes an X pixmap of the pbuffer's size and a GLX pixmap on it instead;
it reads back what was drawn, and is freed with the pbuffer. Accelerated renderers keep GLX pbuffers.
---
--- a/dlls/winex11.drv/opengl.c
+++ b/dlls/winex11.drv/opengl.c
@@ -174,6 +174,9 @@
 #define GLX_RGBA_FLOAT_TYPE               0x20B9
 /** GLX_MESA_query_renderer */
 #define GLX_RENDERER_ID_MESA              0x818E
+#ifndef GLX_RENDERER_ACCELERATED_MESA
+#define GLX_RENDERER_ACCELERATED_MESA     0x8186
+#endif
 /** GLX_NV_float_buffer */
 #define GLX_FLOAT_COMPONENTS_NV           0x20B0
 
@@ -954,8 +957,13 @@
         XFreePixmap( gdi_display, gl->pixmap );
         break;
     case DC_GL_PBUFFER:
-        TRACE( "destroying pbuffer drawable %lx\n", gl->drawable );
-        pglXDestroyPbuffer( gdi_display, gl->drawable );
+        TRACE( "destroying pbuffer drawable %lx pixmap %lx\n", gl->drawable, gl->pixmap );
+        if (gl->pixmap)  /* a pixmap stood in for it (8412) */
+        {
+            pglXDestroyPixmap( gdi_display, gl->drawable );
+            XFreePixmap( gdi_display, gl->pixmap );
+        }
+        else pglXDestroyPbuffer( gdi_display, gl->drawable );
         break;
     default:
         break;
@@ -2184,6 +2192,29 @@
     return wglExtensions;
 }
 
+/* Stained Glass OS (8412): with Mesa's software renderer, drawing to a pbuffer's front buffer
+ * (glDrawBuffer(GL_FRONT), then glFlush or glFinish) puts the image with XShmPutImage on the
+ * GLXPbuffer, which the X server refuses with BadMatch -- and the X error ends the program (Java 3D,
+ * Sweet Home 3D). A GLX pixmap is an X drawable that takes the image; Windows programs cannot tell it
+ * from a pbuffer. Only when the renderer says it is not accelerated (GLX_MESA_query_renderer). */
+static BOOL pbuffer_as_pixmap( const struct glx_pixel_format *fmt )
+{
+    static int software = -1;
+    int drawable_type = 0;
+
+    if (software < 0)
+    {
+        unsigned int accelerated = 1;
+        software = pglXQueryRendererIntegerMESA &&
+                   pglXQueryRendererIntegerMESA( gdi_display, DefaultScreen( gdi_display ), 0,
+                                                 GLX_RENDERER_ACCELERATED_MESA, &accelerated ) && !accelerated;
+        TRACE( "software renderer %d\n", software );
+    }
+    if (!software || !fmt->visual) return FALSE;
+    pglXGetFBConfigAttrib( gdi_display, fmt->fbconfig, GLX_DRAWABLE_TYPE, &drawable_type );
+    return (drawable_type & GLX_PIXMAP_BIT) != 0;
+}
+
 /**
  * X11DRV_wglCreatePbufferARB
  *
@@ -2361,6 +2392,20 @@
     object->gl->format = object->fmt;
     object->gl->ref = 1;
 
+#ifndef SG_MUTANT_PBUFFER_NO_PIXMAP
+    if (pbuffer_as_pixmap( fmt ))
+    {
+        object->gl->pixmap = XCreatePixmap( gdi_display, root_window, max( object->width, 1 ),
+                                            max( object->height, 1 ), fmt->visual->depth );
+        if (object->gl->pixmap &&
+            !(object->gl->drawable = pglXCreatePixmap( gdi_display, fmt->fbconfig, object->gl->pixmap, NULL )))
+        {
+            XFreePixmap( gdi_display, object->gl->pixmap );
+            object->gl->pixmap = 0;
+        }
+    }
+    if (!object->gl->drawable)
+#endif
     object->gl->drawable = pglXCreatePbuffer(gdi_display, fmt->fbconfig, attribs);
     TRACE("new Pbuffer drawable as %p (%lx)\n", object->gl, object->gl->drawable);
     if (!object->gl->drawable) {
