+/* The sheet itself. pd is the unicode structure (the ANSI entry converts to it). */
+static HRESULT pdex_run(PRINTDLGEXW *pd)
+{
+    struct pdex_state *st;
+    HPROPSHEETPAGE *pages;
+    PROPSHEETPAGEW psp = { sizeof(psp) };
+    PROPSHEETHEADERW psh = { sizeof(psh) };
+    WCHAR title[32];
+    INT_PTR res;
+    DWORD i;
+    HRESULT hr = S_OK;
+
+    if (!(st = calloc(1, sizeof(*st)))) return E_OUTOFMEMORY;
+    st->IPrintDialogServices_iface.lpVtbl = &pdex_services_vtbl;
+    st->ref = 1;
+    st->pd = pd;
+    if (pd->lpCallback)
+    {
+        IUnknown_QueryInterface((IUnknown *)pd->lpCallback, &IID_IPrintDialogCallback, (void **)&st->callback);
+        IUnknown_QueryInterface((IUnknown *)pd->lpCallback, &IID_IObjectWithSite, (void **)&st->site);
+    }
+    if (pd->hDevMode)
+    {
+        DEVMODEW *dm = GlobalLock(pd->hDevMode);
+
+        if (dm)
+        {
+            st->input_dm = malloc(dm->dmSize + dm->dmDriverExtra);
+            if (st->input_dm) memcpy(st->input_dm, dm, dm->dmSize + dm->dmDriverExtra);
+            GlobalUnlock(pd->hDevMode);
+        }
+    }
+    pdex_initial_printer(st);
+    if (!st->printer)
+    {
+        COMDLG32_SetCommDlgExtendedError(PDERR_NODEFAULTPRN);
+        hr = E_FAIL;
+        goto done;
+    }
+
+    pages = malloc((1 + pd->nPropertyPages) * sizeof(*pages));
+    if (!pages)
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    psp.dwFlags = PSP_DEFAULT | PSP_PREMATURE;
+    psp.hInstance = COMDLG32_hInstance;
+    psp.pszTemplate = L"PRINTDLGEX_GENERAL";
+    psp.pfnDlgProc = pdex_page_proc;
+    psp.lParam = (LPARAM)st;
+    pages[0] = CreatePropertySheetPageW(&psp);
+    for (i = 0; i < pd->nPropertyPages; i++) pages[1 + i] = pd->lphPropertyPages[i];
+    if (!pages[0])
+    {
+        for (i = 0; i < pd->nPropertyPages; i++) DestroyPropertySheetPage(pages[1 + i]);
+        free(pages);
+        hr = E_FAIL;
+        goto done;
+    }
+
+    LoadStringW(COMDLG32_hInstance, PD32_PRINT_TITLE, title, ARRAY_SIZE(title));
+    psh.dwFlags = PSH_USECALLBACK | PSH_NOCONTEXTHELP;
+    psh.hwndParent = pd->hwndOwner;
+    psh.hInstance = COMDLG32_hInstance;
+    psh.pszCaption = title;
+    psh.nPages = 1 + pd->nPropertyPages;
+    psh.nStartPage = pd->nStartPage == START_PAGE_GENERAL ? 0 : pd->nStartPage + 1;
+    psh.phpage = pages;
+    psh.pfnCallback = pdex_sheet_callback;
+    res = PropertySheetW(&psh);
+    free(pages);
+    if (res < 0)
+    {
