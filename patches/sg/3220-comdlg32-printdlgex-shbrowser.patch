+                /* a shortcut to a folder opens the folder */
+                LPITEMIDLIST pidl;
+                if (SUCCEEDED(SHParseDisplayName(lpstrPathAndFile, NULL, &pidl, 0, NULL)))
+                {
+                    if (SUCCEEDED(IShellBrowser_BrowseObject(fodInfos->Shell.FOIShellBrowser, pidl, SBSP_ABSOLUTE))
+                        && (fodInfos->ofnInfos->Flags & OFN_EXPLORER))
+                    {
+                        SendCustomDlgNotificationMessage(hwnd, CDN_FOLDERCHANGE);
+                        SendMessageA(fodInfos->DlgInfos.hwndFileName, WM_SETTEXT, 0, (LPARAM)"");
+                    }
+                    ILFree(pidl);
+                }
+                ret = FALSE;
+                goto ret;
+            }
+        }
+
         /* Attach the file extension with file name*/
         ext = PathFindExtensionW(lpstrPathAndFile);
         if (! *ext && fodInfos->defext)
