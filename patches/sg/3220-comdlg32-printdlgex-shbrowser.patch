+/* the controls' initial state, from the caller's PRINTDLGEX */
+static void pdex_init_child(struct pdex_state *st)
+{
+    PRINTDLGEXW *pd = st->pd;
+    HWND child = st->child;
+    WCHAR text[256];
+    INT copies;
+    int radio = rad1;
+
+    if (pd->Flags & PD_SELECTION) radio = rad2;
+    else if ((pd->Flags & PD_CURRENTPAGE) && !(pd->Flags & PD_NOCURRENTPAGE)) radio = rad4;
+    else if ((pd->Flags & PD_PAGENUMS) && !(pd->Flags & PD_NOPAGENUMS)) radio = rad3;
+    if (GetDlgItem(child, radio)) CheckRadioButton(child, rad1, rad4, radio);
+
+    if (pd->Flags & PD_NOSELECTION) EnableWindow(GetDlgItem(child, rad2), FALSE);
+    if (pd->Flags & PD_NOCURRENTPAGE) EnableWindow(GetDlgItem(child, rad4), FALSE);
+    if (pd->Flags & PD_NOPAGENUMS)
+    {
+        EnableWindow(GetDlgItem(child, rad3), FALSE);
+        EnableWindow(GetDlgItem(child, edt1), FALSE);
+        EnableWindow(GetDlgItem(child, stc2), FALSE);
+    }
+    else
+    {
+        pdex_format_ranges(pd, text, ARRAY_SIZE(text));
+        SetDlgItemTextW(child, edt1, text);
+    }
+
+    CheckDlgButton(child, chx2, (pd->Flags & PD_COLLATE) ? BST_CHECKED : BST_UNCHECKED);
+    pdex_update_collate_icon(st);
+
+    if (!pd->hDevMode || !st->devmode) copies = pd->nCopies;
+    else copies = st->devmode->dmCopies;
+    if (copies <= 0) copies = 1;
+    SetDlgItemInt(child, edt3, min(copies, MAX_COPIES), FALSE);
+    pdex_update_copies_controls(st);
+}
+
+static INT_PTR CALLBACK pdex_child_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct pdex_state *st = (struct pdex_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+    INT_PTR ret = FALSE;
+    LRESULT result = 0;
+
+    if (msg == WM_INITDIALOG)
+    {
+        st = (struct pdex_state *)lp;
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)st);
+        st->child = hwnd;
+        pdex_init_child(st);
+        if (st->callback)
+            st->callback->lpVtbl->HandleMessage(st->callback, hwnd, msg, wp, (LPARAM)st->pd, &result);
+        return TRUE;
+    }
+    if (!st) return FALSE;
+
+    if (st->callback)
+    {
+        HRESULT hr = st->callback->lpVtbl->HandleMessage(st->callback, hwnd, msg, wp, lp, &result);
+
+#ifdef SG_MUTANT_CDLG_HANDLEMSG
+        hr = S_FALSE;
+#endif
+        if (hr == S_OK)
+        {
+            /* messages whose result is the return value of the dialog procedure */
+            if (msg == WM_INITDIALOG || msg == WM_CTLCOLORMSGBOX || msg == WM_CTLCOLOREDIT ||
+                msg == WM_CTLCOLORLISTBOX || msg == WM_CTLCOLORBTN || msg == WM_CTLCOLORDLG ||
+                msg == WM_CTLCOLORSCROLLBAR || msg == WM_CTLCOLORSTATIC || msg == WM_COMPAREITEM ||
+                msg == WM_VKEYTOITEM || msg == WM_CHARTOITEM || msg == WM_QUERYDRAGICON)
+                return result;
+            SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, result);
+            return TRUE;
+        }
+    }
+
+    switch (msg)
+    {
+    case WM_COMMAND:
+        switch (LOWORD(wp))
+        {
+        case IDABORT:
+            /* a callback closes the sheet by posting this; the result is a cancel */
+#ifndef SG_MUTANT_CDLG_ABORT
+            st->aborted = TRUE;
+#endif
+            PostMessageW(st->sheet, PSM_PRESSBUTTON, PSBTN_CANCEL, 0);
+            return TRUE;
+        case chx2:
+            pdex_update_collate_icon(st);
+            pdex_notify_changed(st);
+            break;
+        case edt1:
+            if (HIWORD(wp) == EN_CHANGE && st->ready)
+            {
+                CheckRadioButton(hwnd, rad1, rad4, rad3);
+                pdex_notify_changed(st);
+            }
+            break;
+        case edt3:
+            if (HIWORD(wp) == EN_CHANGE) pdex_notify_changed(st);
+            break;
+        case rad1:
+        case rad2:
+        case rad3:
+        case rad4:
+            pdex_notify_changed(st);
+            break;
+        }
+        break;
+    }
+    return ret;
+}
