+static void pdex_fill_printers(struct pdex_state *st)
+{
+    HWND list = GetDlgItem(st->page, lst1);
+    PRINTER_INFO_4W *info = NULL;
+    DWORD needed = 0, count = 0, i;
+    SHSTOCKICONINFO sii = { sizeof(sii) };
+    HIMAGELIST himl;
+    HICON icon = NULL;
+    int select = -1;
+
+    EnumPrintersW(PRINTER_ENUM_LOCAL | PRINTER_ENUM_CONNECTIONS, NULL, 4, NULL, 0, &needed, &count);
+    if (needed) info = malloc(needed);
+    if (info && !EnumPrintersW(PRINTER_ENUM_LOCAL | PRINTER_ENUM_CONNECTIONS, NULL, 4, (BYTE *)info, needed,
+                               &needed, &count))
+        count = 0;
+
+    himl = ImageList_Create(32, 32, ILC_COLOR32 | ILC_MASK, 1, 1);
+    if (SUCCEEDED(SHGetStockIconInfo(SIID_PRINTER, SHGSI_ICON | SHGSI_LARGEICON, &sii))) icon = sii.hIcon;
+    if (!icon) icon = LoadIconW(NULL, (LPCWSTR)IDI_APPLICATION);
+    ImageList_AddIcon(himl, icon);
+    if (sii.hIcon) DestroyIcon(sii.hIcon);
+    SendMessageW(list, LVM_SETIMAGELIST, LVSIL_NORMAL, (LPARAM)himl);
+
+    for (i = 0; i < count && i < PDEX_MAX_PRINTERS; i++)
+    {
+        LVITEMW item = { 0 };
+
+        item.mask = LVIF_TEXT | LVIF_IMAGE | LVIF_PARAM;
+        item.iItem = i;
+        item.pszText = info[i].pPrinterName;
+        item.iImage = 0;
+        item.lParam = i;
+        SendMessageW(list, LVM_INSERTITEMW, 0, (LPARAM)&item);
+        if (st->printer && !lstrcmpiW(info[i].pPrinterName, st->printer)) select = i;
+    }
+    free(info);
+    if (select >= 0)
+    {
+        LVITEMW item = { 0 };
+
+        item.stateMask = item.state = LVIS_SELECTED | LVIS_FOCUSED;
+        SendMessageW(list, LVM_SETITEMSTATE, select, (LPARAM)&item);
+        SendMessageW(list, LVM_ENSUREVISIBLE, select, FALSE);
+    }
+}
