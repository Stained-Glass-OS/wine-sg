+/***********************************************************************
+ *      COMDLG32_ResolveLinkTarget
+ *
+ * Without OFN_NODEREFERENCELINKS a selected shortcut stands for the file it
+ * refers to. Returns 0 when path is not a shortcut to a file-system object
+ * (path unchanged), 1 when path now names the target file, 2 when the target
+ * is a folder (path now names the folder).
+ */
+int COMDLG32_ResolveLinkTarget(HWND hwnd, WCHAR *path)
+{
+    IShellLinkW *link = NULL;
+    IPersistFile *file = NULL;
+    WCHAR target[MAX_PATH];
+    HRESULT init, hr;
+    DWORD attrs;
+    int ret = 0;
+#ifdef SG_MUTANT_CDLG_LINK
+    return 0;
+#endif
+
+    if (lstrcmpiW(PathFindExtensionW(path), L".lnk")) return 0;
+    attrs = GetFileAttributesW(path);
+    if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_DIRECTORY)) return 0;
+
+    init = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    hr = CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&link);
+    if (SUCCEEDED(hr)) hr = IShellLinkW_QueryInterface(link, &IID_IPersistFile, (void **)&file);
+    if (SUCCEEDED(hr)) hr = IPersistFile_Load(file, path, STGM_READ);
+    if (SUCCEEDED(hr)) hr = IShellLinkW_Resolve(link, hwnd, SLR_NO_UI | SLR_NOUPDATE | SLR_NOSEARCH);
+    if (SUCCEEDED(hr)) hr = IShellLinkW_GetPath(link, target, ARRAY_SIZE(target), NULL, 0);
+    if (hr == S_OK && target[0])
+    {
+        attrs = GetFileAttributesW(target);
+        if (attrs != INVALID_FILE_ATTRIBUTES)
+        {
+            lstrcpyW(path, target);
+            ret = (attrs & FILE_ATTRIBUTE_DIRECTORY) ? 2 : 1;
+        }
+    }
+    if (file) IPersistFile_Release(file);
+    if (link) IShellLinkW_Release(link);
+    if (SUCCEEDED(init)) CoUninitialize();
+    TRACE("-> %d %s\n", ret, debugstr_w(path));
+    return ret;
+}
+
 /***********************************************************************
  *      FILEDLG95_OnOpen
  *
@@ -2952,6 +3029,30 @@ BOOL FILEDLG95_OnOpen(HWND hwnd)
