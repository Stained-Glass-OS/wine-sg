+/* "1,3,5-12" -> ranges; every number must be within [min, max] */
+static BOOL pdex_parse_ranges(const WCHAR *text, PRINTPAGERANGE *out, DWORD max_ranges, DWORD *count,
+                              DWORD min_page, DWORD max_page)
+{
+    const WCHAR *p = text;
+    DWORD n = 0;
+
+    for (;;)
+    {
+        WCHAR *end;
+        DWORD from, to;
+
+        while (*p == ' ') p++;
+        if (*p < '0' || *p > '9') return FALSE;
+        from = to = wcstoul(p, &end, 10);
+        p = end;
+        while (*p == ' ') p++;
+        if (*p == '-')
+        {
+            p++;
+            while (*p == ' ') p++;
+            if (*p < '0' || *p > '9') return FALSE;
+            to = wcstoul(p, &end, 10);
+            p = end;
+            while (*p == ' ') p++;
+        }
+#ifndef SG_MUTANT_CDLG_VETO
+        if (from > to || from < min_page || to > max_page) return FALSE;
+#endif
+        if (n >= max_ranges) return FALSE;
+#ifdef SG_MUTANT_CDLG_RANGES
+        if (n) break;
+#endif
+        out[n].nFromPage = from;
+        out[n].nToPage = to;
+        n++;
+        if (!*p) break;
+        if (*p != ',') return FALSE;
+        p++;
+    }
+    *count = n;
+    return n > 0;
+}
