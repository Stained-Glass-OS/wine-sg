+static INT_PTR CALLBACK pdex_page_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct pdex_state *st = (struct pdex_state *)GetWindowLongPtrW(hwnd, DWLP_USER);
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+    {
+        PRINTDLGEXW *pd;
+        HWND anchor;
+        RECT rc;
+        HRESULT hr;
+
+        st = (struct pdex_state *)((PROPSHEETPAGEW *)lp)->lParam;
+        SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)st);
+        st->page = hwnd;
+        st->sheet = GetParent(hwnd);
+        pd = st->pd;
+        st->collate_icon = LoadImageW(COMDLG32_hInstance, L"PD32_COLLATE", IMAGE_ICON, 0, 0, 0);
+        st->nocollate_icon = LoadImageW(COMDLG32_hInstance, L"PD32_NOCOLLATE", IMAGE_ICON, 0, 0, 0);
+
+        pdex_fill_printers(st);
+        pdex_update_printer_texts(st);
+        CheckDlgButton(hwnd, chx1, (pd->Flags & PD_PRINTTOFILE) ? BST_CHECKED : BST_UNCHECKED);
+        if (pd->Flags & PD_DISABLEPRINTTOFILE) EnableWindow(GetDlgItem(hwnd, chx1), FALSE);
+        if (pd->Flags & PD_HIDEPRINTTOFILE) ShowWindow(GetDlgItem(hwnd, chx1), SW_HIDE);
+        if (!st->printer) EnableWindow(GetDlgItem(hwnd, psh2), FALSE);
+
+        /* the lower portion: the application's template or ours */
+        anchor = GetDlgItem(hwnd, stc32);
+        GetWindowRect(anchor, &rc);
+        MapWindowPoints(NULL, hwnd, (POINT *)&rc, 2);
+        if (pd->Flags & PD_ENABLEPRINTTEMPLATEHANDLE)
+            CreateDialogIndirectParamW(COMDLG32_hInstance, (const DLGTEMPLATE *)pd->hInstance, hwnd,
+                                       pdex_child_proc, (LPARAM)st);
+        else if (pd->Flags & PD_ENABLEPRINTTEMPLATE)
+            CreateDialogParamW(pd->hInstance, pd->lpPrintTemplateName, hwnd, pdex_child_proc, (LPARAM)st);
+        else
+            CreateDialogParamW(COMDLG32_hInstance, L"PRINTDLGEX_CHILD", hwnd, pdex_child_proc, (LPARAM)st);
+        if (st->child)
+        {
+            SetWindowPos(st->child, NULL, rc.left, rc.top, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+            ShowWindow(st->child, SW_SHOW);
+        }
+
+        if (st->site) IObjectWithSite_SetSite(st->site, (IUnknown *)&st->IPrintDialogServices_iface);
+        if (st->callback)
+        {
+            st->callback->lpVtbl->SelectionChange(st->callback);
+#ifndef SG_MUTANT_CDLG_INITDONE
+            hr = st->callback->lpVtbl->InitDone(st->callback);
+#endif
+            TRACE("InitDone returned %#lx\n", hr);
+        }
+        st->ready = TRUE;
+        return TRUE;
+    }
+    case WM_COMMAND:
+        if (!st) break;
+        switch (LOWORD(wp))
+        {
+        case psh2:
+            if (HIWORD(wp) == BN_CLICKED) pdex_preferences(st);
+            return TRUE;
+        case chx1:
+            pdex_notify_changed(st);
+            return TRUE;
+        }
+        break;
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lp;
+
+        if (!st) break;
+        if (hdr->idFrom == lst1 && hdr->code == LVN_ITEMCHANGED)
+        {
+            NMLISTVIEW *nm = (NMLISTVIEW *)lp;
+
+            if ((nm->uChanged & LVIF_STATE) && (nm->uNewState & LVIS_SELECTED) && st->ready)
+                pdex_select_from_list(st);
+            return TRUE;
+        }
+        switch (hdr->code)
+        {
+        case PSN_APPLY:
+            if (!pdex_collect(st))
+            {
+                SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, PSNRET_INVALID_NOCHANGEPAGE);
+                return TRUE;
+            }
+            if (((PSHNOTIFY *)lp)->lParam) st->printed = TRUE;
+#ifndef SG_MUTANT_CDLG_APPLY
+            else st->applied = TRUE;
+#endif
+            SetWindowLongPtrW(hwnd, DWLP_MSGRESULT, PSNRET_NOERROR);
+            return TRUE;
+        }
+        break;
+    }
+    case WM_DESTROY:
+        if (st)
+        {
+            if (st->collate_icon) DestroyIcon(st->collate_icon);
+            if (st->nocollate_icon) DestroyIcon(st->nocollate_icon);
+            st->collate_icon = st->nocollate_icon = NULL;
+            st->page = st->child = NULL;
+        }
+        break;
+    }
+    return FALSE;
+}
