+    if (FAILED(hr)) return hr;
+    if (grfMode & (STGM_WRITE | STGM_READWRITE))
+    {
+        ULARGE_INTEGER size;
+        size.QuadPart = 0;
+        hr = IStream_SetSize(This->view_state, size);
+        if (FAILED(hr)) return hr;
+    }
+    IStream_AddRef(This->view_state);
+    *ppStrm = This->view_state;
+    return S_OK;
 }
 
