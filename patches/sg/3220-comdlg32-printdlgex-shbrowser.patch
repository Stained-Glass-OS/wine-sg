+/* the printer chosen in the list becomes current */
+static void pdex_select_from_list(struct pdex_state *st)
+{
+    HWND list = GetDlgItem(st->page, lst1);
+    int index = SendMessageW(list, LVM_GETNEXTITEM, -1, LVNI_SELECTED);
+    WCHAR name[256];
+    LVITEMW item = { 0 };
+    HRESULT hr = S_FALSE;
+
+    if (index < 0) return;
+    item.iSubItem = 0;
+    item.pszText = name;
+    item.cchTextMax = ARRAY_SIZE(name);
+    if (!SendMessageW(list, LVM_GETITEMTEXTW, index, (LPARAM)&item)) return;
+    if (st->printer && !lstrcmpW(st->printer, name)) return;
+#ifdef SG_MUTANT_CDLG_SELCHANGE
+    return;
+#endif
+    if (!pdex_set_printer(st, name)) return;
+
+    pdex_update_printer_texts(st);
+    if (st->callback) hr = st->callback->lpVtbl->SelectionChange(st->callback);
+    if (hr != S_OK)
+    {
+        /* default: the copies and collate controls follow what the printer can do */
+        pdex_update_copies_controls(st);
     }
+    pdex_notify_changed(st);
+}
+
+/* the printer the sheet starts with: the DEVNAMES device, else the DEVMODE device, else the default */
+static void pdex_initial_printer(struct pdex_state *st)
+{
+    PRINTDLGEXW *pd = st->pd;
+    WCHAR def[256];
+    DWORD len = ARRAY_SIZE(def);
+
+    if (pd->hDevNames)
+    {
+        DEVNAMES *dn = GlobalLock(pd->hDevNames);
+
+        if (dn)
+        {
+            const WCHAR *name = (const WCHAR *)dn + dn->wDeviceOffset;
+
+            if (pdex_set_printer(st, name)) { GlobalUnlock(pd->hDevNames); return; }
+            GlobalUnlock(pd->hDevNames);
+        }
+    }
+    if (st->input_dm && st->input_dm->dmDeviceName[0] && pdex_set_printer(st, st->input_dm->dmDeviceName)) return;
+    if (GetDefaultPrinterW(def, &len)) pdex_set_printer(st, def);
+}
+
+static void pdex_preferences(struct pdex_state *st)
+{
+    HANDLE hprn;
+    LONG size;
+    DEVMODEW *dm;
 
+    if (!st->printer || !st->devmode) return;
+    if (!OpenPrinterW(st->printer, &hprn, NULL)) return;
+    size = DocumentPropertiesW(st->page, hprn, st->printer, NULL, NULL, 0);
+    dm = size > 0 ? malloc(size) : NULL;
+    if (dm && DocumentPropertiesW(st->page, hprn, st->printer, dm, st->devmode,
+                                  DM_IN_BUFFER | DM_IN_PROMPT | DM_OUT_BUFFER) == IDOK)
+    {
+        free(st->devmode);
+        st->devmode = dm;
+        dm = NULL;
+        pdex_update_copies_controls(st);
+        pdex_notify_changed(st);
+    }
+    free(dm);
+    ClosePrinter(hprn);
+}
