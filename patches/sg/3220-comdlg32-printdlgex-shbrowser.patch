+    DWORD flags = pd->Flags & ~(PD_SELECTION | PD_PAGENUMS | PD_CURRENTPAGE | PD_PRINTTOFILE | PD_COLLATE);
+    PRINTPAGERANGE ranges[64];
+    DWORD count = 0, copies = pd->nCopies;
+    DEVMODEW *dm;
+    const WCHAR *port;
+    HDC dc = NULL;
+
+    if (!st->printer || !st->devmode || !st->pinfo || !st->dinfo)
+    {
+        WARN("no printer selected\n");
+        return FALSE;
+    }
+
+    if (child)
+    {
+        if (IsDlgButtonChecked(child, rad2) == BST_CHECKED) flags |= PD_SELECTION;
+        else if (IsDlgButtonChecked(child, rad4) == BST_CHECKED) flags |= PD_CURRENTPAGE;
+        else if (IsDlgButtonChecked(child, rad3) == BST_CHECKED && !(pd->Flags & PD_NOPAGENUMS))
+        {
+            WCHAR text[256];
+
+            GetDlgItemTextW(child, edt1, text, ARRAY_SIZE(text));
+            if (!pdex_parse_ranges(text, ranges, min(pd->nMaxPageRanges, ARRAY_SIZE(ranges)), &count,
+                                   pd->nMinPage, pd->nMaxPage))
+            {
+                WCHAR fmt[256], msg[320], title[64];
+                DWORD_PTR args[2] = { pd->nMinPage, pd->nMaxPage };
+
+                LoadStringW(COMDLG32_hInstance, PD32_EX_INVALID_RANGES, fmt, ARRAY_SIZE(fmt));
+                FormatMessageW(FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY, fmt, 0, 0,
+                               msg, ARRAY_SIZE(msg), (va_list *)args);
+                LoadStringW(COMDLG32_hInstance, PD32_PRINT_TITLE, title, ARRAY_SIZE(title));
+                MessageBoxW(st->page, msg, title, MB_OK | MB_ICONWARNING);
+                return FALSE;
+            }
+            flags |= PD_PAGENUMS;
+        }
+        if (GetDlgItem(child, edt3))
         {
-            cb->callback->lpVtbl->SelectionChange(cb->callback);
-            cb->callback->lpVtbl->InitDone(cb->callback);
+            BOOL ok;
+            UINT n = GetDlgItemInt(child, edt3, &ok, FALSE);
+
+            copies = ok && n ? min(n, MAX_COPIES) : 1;
         }
+        if (IsDlgButtonChecked(child, chx2) == BST_CHECKED) flags |= PD_COLLATE;
+    }
+    if (IsDlgButtonChecked(st->page, chx1) == BST_CHECKED) flags |= PD_PRINTTOFILE;
+
+    dm = st->devmode;
+#ifdef SG_MUTANT_CDLG_COPIES
+    if (0)
+#else
+    if (pd->Flags & PD_USEDEVMODECOPIESANDCOLLATE)
+#endif
+    {
+        /* the driver does the copies and collation */
+        if (dm->dmFields & DM_COLLATE) dm->dmCollate = (flags & PD_COLLATE) != 0;
+        if (dm->dmFields & DM_COPIES) dm->dmCopies = copies;
+        flags &= ~PD_COLLATE;
+        copies = 1;
     }
     else
     {
-/* FIXME: store interface pointer somewhere in window properties and call it
-        HRESULT hres;
-        cb->callback->lpVtbl->HandleMessage(cb->callback, hwnd, msg, wp, lp, &hres);
-*/
+        dm->dmCopies = 1;
+        dm->dmCollate = DMCOLLATE_FALSE;
+    }
+
+    port = (flags & PD_PRINTTOFILE) ? L"FILE:" : st->pinfo->pPortName;
+    {
+        HGLOBAL hdm = update_devmode_handleW(pd->hDevMode, dm);
+        HGLOBAL hdn = pd->hDevNames;
+
+        if (!hdm) { WARN("devmode handle failed\n"); return FALSE; }
+        pd->hDevMode = hdm;
+        if (!PRINTDLG_CreateDevNamesW(&hdn, st->dinfo->pDriverPath, st->printer, port)) { WARN("devnames failed\n"); return FALSE; }
+        pd->hDevNames = hdn;
+    }
+    if (flags & PD_RETURNDC)
+        dc = CreateDCW(st->dinfo->pDriverPath, st->printer, port, dm);
+    else if (flags & PD_RETURNIC)
+        dc = CreateICW(st->dinfo->pDriverPath, st->printer, port, dm);
+    if (dc)
+    {
+        if (st->created_dc) DeleteDC(st->created_dc);
+        st->created_dc = pd->hDC = dc;
+    }
+
+    if (flags & PD_PAGENUMS)
+    {
+        memcpy(pd->lpPageRanges, ranges, count * sizeof(*ranges));
+        pd->nPageRanges = count;
+    }
+    pd->nCopies = copies;
+    pd->Flags = flags;
+    return TRUE;
+}
