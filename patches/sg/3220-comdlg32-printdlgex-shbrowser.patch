+
+        if (r->nFromPage == r->nToPage)
+            len += swprintf(buf + len, size - len, L"%s%lu", i ? L", " : L"", r->nFromPage);
+        else
+            len += swprintf(buf + len, size - len, L"%s%lu-%lu", i ? L", " : L"", r->nFromPage, r->nToPage);
+    }
