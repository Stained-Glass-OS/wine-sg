From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: MINIDUMP_MISC_INFO_5, VM counters and system memory in every minidump (9553)

Windows writes MiscInfoStream as MINIDUMP_MISC_INFO_5 and adds
SystemMemoryInfoStream and ProcessVmCountersStream to every dump (Wine's
own dbghelp conformance test lists them for every dump type); Wine wrote
a bare MINIDUMP_MISC_INFO with only the process id:

- MiscInfoStream: the process's create time and user/kernel times,
  processor power figures (left out when SecondaryFlagsCallback returns
  MiniSecondaryWithoutPowerInfo), the process's integrity level, its
  execute flags, the time zone, the system's build string (BuildLabEx,
  else the build number) and dbghelp's own (dbghelp.<arch>,<version>),
  the extended processor state layout (XStateData: enabled features,
  context size, each feature's offset and size) and the process cookie;
  each flag set only when its figure could be had;
- ProcessVmCountersStream: MINIDUMP_PROCESS_VM_COUNTERS_2 from the
  process's VM counters (working set, page file, virtual and private
  sizes);
- SystemMemoryInfoStream: MINIDUMP_SYSTEM_MEMORY_INFO_1 from the
  system's basic, file cache and performance information.

Gate: test/dumpmisc-gate.sh (64- and 32-bit; parsed at the SDK's
offsets). Mutants SG_MUTANT_OLD_MISC_INFO, SG_MUTANT_NO_VM_STREAMS
(dbghelp/minidump.c).
---
diff --git a/dlls/dbghelp/dbghelp_private.h b/dlls/dbghelp/dbghelp_private.h
--- a/dlls/dbghelp/dbghelp_private.h
+++ b/dlls/dbghelp/dbghelp_private.h
@@ -642,6 +642,7 @@ struct dump_context
     /* callback information */
     MINIDUMP_CALLBACK_INFORMATION*      cb;
     BOOL                                check_cancel;   /* CancelCallback asked to be called again */
+    ULONG                               secondary_flags; /* SecondaryFlagsCallback's MiniSecondary* flags */
     BOOL                                io_callback;    /* IoStartCallback took the writes */
     HRESULT                             status;         /* why the dump failed (the last error) */
     struct dump_memory*                 removed;        /* RemoveMemoryCallback's ranges */
diff --git a/dlls/dbghelp/minidump.c b/dlls/dbghelp/minidump.c
--- a/dlls/dbghelp/minidump.c
+++ b/dlls/dbghelp/minidump.c
@@ -1908,22 +1908,254 @@ static unsigned         dump_memory64_info(struct dump_context* dc)
     return sz;
 }
 
-static unsigned         dump_misc_info(struct dump_context* dc)
+/* seconds since 1970 of a FILETIME, seconds of a duration */
+static ULONG32 filetime_to_time(const FILETIME* ft)
 {
-    MINIDUMP_MISC_INFO  mmi;
+    ULONG64 t = ((ULONG64)ft->dwHighDateTime << 32) | ft->dwLowDateTime;
+    return t < 116444736000000000ull ? 0 : (ULONG32)((t - 116444736000000000ull) / 10000000);
+}
+
+static ULONG32 filetime_to_seconds(const FILETIME* ft)
+{
+    return (ULONG32)((((ULONG64)ft->dwHighDateTime << 32) | ft->dwLowDateTime) / 10000000);
+}
 
+/* Stained Glass OS: the MINIDUMP_MISC_INFO_5 Windows writes: process times,
+ * processor power, integrity level, execute flags, time zone, build
+ * strings, the processor's extended state layout, the process cookie */
+static  unsigned        dump_misc_info(struct dump_context* dc)
+{
+    MINIDUMP_MISC_INFO_5        mmi;
+    FILETIME                    create, ex, kernel, user;
+    PROCESSOR_POWER_INFORMATION *ppi;
+    SYSTEM_INFO                 si;
+    HANDLE                      token;
+    char                        buf[256];
+    TOKEN_MANDATORY_LABEL       *label = (TOKEN_MANDATORY_LABEL*)buf;
+    DWORD                       len, type;
+    ULONG                       value;
+    HKEY                        key;
+    VS_FIXEDFILEINFO            ffi;
+    WCHAR                       path[MAX_PATH];
+    HMODULE                     self;
+
+    memset(&mmi, 0, sizeof(mmi));
     mmi.SizeOfInfo = sizeof(mmi);
     mmi.Flags1 = MINIDUMP_MISC1_PROCESS_ID;
     mmi.ProcessId = dc->pid;
-    /* FIXME: create/user/kernel time */
-    mmi.ProcessCreateTime = 0;
-    mmi.ProcessKernelTime = 0;
-    mmi.ProcessUserTime = 0;
+#ifdef SG_MUTANT_OLD_MISC_INFO
+    mmi.SizeOfInfo = sizeof(MINIDUMP_MISC_INFO);
+    append(dc, &mmi, sizeof(MINIDUMP_MISC_INFO));
+    return sizeof(MINIDUMP_MISC_INFO);
+#endif
+    if (GetProcessTimes(dc->process->handle, &create, &ex, &kernel, &user))
+    {
+        mmi.Flags1 |= MINIDUMP_MISC1_PROCESS_TIMES;
+        mmi.ProcessCreateTime = filetime_to_time(&create);
+        mmi.ProcessUserTime = filetime_to_seconds(&user);
+        mmi.ProcessKernelTime = filetime_to_seconds(&kernel);
+    }
+    GetSystemInfo(&si);
+    if (!(dc->secondary_flags & MiniSecondaryWithoutPowerInfo) &&
+        (ppi = HeapAlloc(GetProcessHeap(), 0, si.dwNumberOfProcessors * sizeof(*ppi))))
+    {
+        if (!NtPowerInformation(ProcessorInformation, NULL, 0, ppi, si.dwNumberOfProcessors * sizeof(*ppi)))
+        {
+            mmi.Flags1 |= MINIDUMP_MISC1_PROCESSOR_POWER_INFO;
+            mmi.ProcessorMaxMhz = ppi[0].MaxMhz;
+            mmi.ProcessorCurrentMhz = ppi[0].CurrentMhz;
+            mmi.ProcessorMhzLimit = ppi[0].MhzLimit;
+            mmi.ProcessorMaxIdleState = ppi[0].MaxIdleState;
+            mmi.ProcessorCurrentIdleState = ppi[0].CurrentIdleState;
+        }
+        HeapFree(GetProcessHeap(), 0, ppi);
+    }
+    if (OpenProcessToken(dc->process->handle, TOKEN_QUERY, &token))
+    {
+        if (GetTokenInformation(token, TokenIntegrityLevel, buf, sizeof(buf), &len) &&
+            *GetSidSubAuthorityCount(label->Label.Sid))
+        {
+            mmi.Flags1 |= MINIDUMP_MISC3_PROCESS_INTEGRITY;
+            mmi.ProcessIntegrityLevel = *GetSidSubAuthority(label->Label.Sid, *GetSidSubAuthorityCount(label->Label.Sid) - 1);
+        }
+        CloseHandle(token);
+    }
+    if (!NtQueryInformationProcess(dc->process->handle, ProcessExecuteFlags, &value, sizeof(value), NULL))
+    {
+        mmi.Flags1 |= MINIDUMP_MISC3_PROCESS_EXECUTE_FLAGS;
+        mmi.ProcessExecuteFlags = value;
+    }
+    mmi.TimeZoneId = GetTimeZoneInformation(&mmi.TimeZone);
+    if (mmi.TimeZoneId != TIME_ZONE_ID_INVALID) mmi.Flags1 |= MINIDUMP_MISC3_TIMEZONE;
+    else mmi.TimeZoneId = 0;
+    /* the system's build string; the dumper's own build */
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion", 0, KEY_READ, &key))
+    {
+        len = sizeof(mmi.BuildString) - sizeof(WCHAR);
+        if (RegQueryValueExW(key, L"BuildLabEx", NULL, &type, (BYTE*)mmi.BuildString, &len) || type != REG_SZ)
+        {
+            WCHAR build[32] = L"";
+            len = sizeof(build) - sizeof(WCHAR);
+            RegQueryValueExW(key, L"CurrentBuildNumber", NULL, &type, (BYTE*)build, &len);
+            memset(mmi.BuildString, 0, sizeof(mmi.BuildString));
+            swprintf(mmi.BuildString, ARRAY_SIZE(mmi.BuildString), L"%s", build);
+        }
+        RegCloseKey(key);
+    }
+    memset(&ffi, 0, sizeof(ffi));
+    if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (const WCHAR*)dump_misc_info, &self) &&
+        GetModuleFileNameW(self, path, ARRAY_SIZE(path)))
+        fetch_module_versioninfo(path, &ffi);
+    swprintf(mmi.DbgBldStr, ARRAY_SIZE(mmi.DbgBldStr), L"dbghelp.%s,%u.%u.%u.%u",
+             sizeof(void*) == 8 ? L"amd64" : L"i386",
+             HIWORD(ffi.dwFileVersionMS), LOWORD(ffi.dwFileVersionMS),
+             HIWORD(ffi.dwFileVersionLS), LOWORD(ffi.dwFileVersionLS));
+    if (mmi.BuildString[0]) mmi.Flags1 |= MINIDUMP_MISC4_BUILDSTRING;
+#if defined(__i386__) || defined(__x86_64__)
+    {
+        DWORD64 features = GetEnabledXStateFeatures();
+        DWORD ctx_len = 0, flen;
+        void *ctx_buf;
+        CONTEXT *ctx;
+        BYTE *legacy, *p;
+        unsigned i;
+
+        InitializeContext(NULL, CONTEXT_ALL | CONTEXT_XSTATE, NULL, &ctx_len);
+        if (features && ctx_len && (ctx_buf = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, ctx_len)))
+        {
+            if (InitializeContext(ctx_buf, CONTEXT_ALL | CONTEXT_XSTATE, &ctx, &ctx_len) &&
+                SetXStateFeaturesMask(ctx, features) && (legacy = LocateXStateFeature(ctx, 0, &flen)))
+            {
+                mmi.XStateData.SizeOfInfo = sizeof(mmi.XStateData);
+                mmi.XStateData.ContextSize = ctx_len;
+                mmi.XStateData.EnabledFeatures = features;
+                for (i = 0; i < MAXIMUM_XSTATE_FEATURES; i++)
+                {
+                    if (!(features & ((DWORD64)1 << i)) || !(p = LocateXStateFeature(ctx, i, &flen))) continue;
+                    mmi.XStateData.Features[i].Offset = p - legacy;
+                    mmi.XStateData.Features[i].Size = flen;
+                }
+            }
+            HeapFree(GetProcessHeap(), 0, ctx_buf);
+        }
+    }
+#endif
+    if (!NtQueryInformationProcess(dc->process->handle, ProcessCookie, &value, sizeof(value), NULL))
+    {
+        mmi.Flags1 |= MINIDUMP_MISC5_PROCESS_COOKIE;
+        mmi.ProcessCookie = value;
+    }
 
     append(dc, &mmi, sizeof(mmi));
     return sizeof(mmi);
 }
 
+/* Stained Glass OS: ProcessVmCountersStream, which Windows writes in every
+ * dump: the process's memory counters */
+static unsigned dump_process_vm_counters(struct dump_context* dc)
+{
+    MINIDUMP_PROCESS_VM_COUNTERS_2  vm;
+    VM_COUNTERS_EX                  c;
+
+    memset(&vm, 0, sizeof(vm));
+    vm.Revision = 2;
+    memset(&c, 0, sizeof(c));
+    if (!NtQueryInformationProcess(dc->process->handle, ProcessVmCounters, &c, sizeof(c), NULL))
+        vm.Flags = MINIDUMP_PROCESS_VM_COUNTERS | MINIDUMP_PROCESS_VM_COUNTERS_VIRTUALSIZE | MINIDUMP_PROCESS_VM_COUNTERS_EX;
+    else if (!NtQueryInformationProcess(dc->process->handle, ProcessVmCounters, &c, sizeof(VM_COUNTERS), NULL))
+        vm.Flags = MINIDUMP_PROCESS_VM_COUNTERS | MINIDUMP_PROCESS_VM_COUNTERS_VIRTUALSIZE;
+    vm.PageFaultCount = c.PageFaultCount;
+    vm.PeakWorkingSetSize = c.PeakWorkingSetSize;
+    vm.WorkingSetSize = c.WorkingSetSize;
+    vm.QuotaPeakPagedPoolUsage = c.QuotaPeakPagedPoolUsage;
+    vm.QuotaPagedPoolUsage = c.QuotaPagedPoolUsage;
+    vm.QuotaPeakNonPagedPoolUsage = c.QuotaPeakNonPagedPoolUsage;
+    vm.QuotaNonPagedPoolUsage = c.QuotaNonPagedPoolUsage;
+    vm.PagefileUsage = c.PagefileUsage;
+    vm.PeakPagefileUsage = c.PeakPagefileUsage;
+    vm.PeakVirtualSize = c.PeakVirtualSize;
+    vm.VirtualSize = c.VirtualSize;
+    vm.PrivateUsage = c.PrivateUsage;
+    append(dc, &vm, sizeof(vm));
+    return sizeof(vm);
+}
+
+/* Stained Glass OS: SystemMemoryInfoStream, which Windows writes in every
+ * dump: the system's memory, file cache and paging figures */
+static unsigned dump_system_memory_info(struct dump_context* dc)
+{
+    MINIDUMP_SYSTEM_MEMORY_INFO_1   smi;
+    SYSTEM_BASIC_INFORMATION        sbi;
+    SYSTEM_CACHE_INFORMATION        sci;
+    SYSTEM_PERFORMANCE_INFORMATION  spi;
+
+    memset(&smi, 0, sizeof(smi));
+    smi.Revision = 1;
+    if (!NtQuerySystemInformation(SystemBasicInformation, &sbi, sizeof(sbi), NULL))
+    {
+        smi.BasicInfo.TimerResolution = sbi.KeMaximumIncrement;
+        smi.BasicInfo.PageSize = sbi.PageSize;
+        smi.BasicInfo.NumberOfPhysicalPages = sbi.MmNumberOfPhysicalPages;
+        smi.BasicInfo.LowestPhysicalPageNumber = sbi.MmLowestPhysicalPage;
+        smi.BasicInfo.HighestPhysicalPageNumber = sbi.MmHighestPhysicalPage;
+        smi.BasicInfo.AllocationGranularity = sbi.AllocationGranularity;
+        smi.BasicInfo.MinimumUserModeAddress = (ULONG_PTR)sbi.LowestUserAddress;
+        smi.BasicInfo.MaximumUserModeAddress = (ULONG_PTR)sbi.HighestUserAddress;
+        smi.BasicInfo.ActiveProcessorsAffinityMask = sbi.ActiveProcessorsAffinityMask;
+        smi.BasicInfo.NumberOfProcessors = sbi.NumberOfProcessors;
+    }
+    memset(&sci, 0, sizeof(sci));
+    if (!NtQuerySystemInformation(SystemFileCacheInformation, &sci, sizeof(sci), NULL))
+    {
+        smi.Flags |= MINIDUMP_SYSMEMINFO1_FILECACHE_TRANSITIONREPURPOSECOUNT_FLAGS;
+        smi.FileCacheInfo.CurrentSize = sci.CurrentSize;
+        smi.FileCacheInfo.PeakSize = sci.PeakSize;
+        smi.FileCacheInfo.PageFaultCount = sci.PageFaultCount;
+        smi.FileCacheInfo.MinimumWorkingSet = sci.MinimumWorkingSet;
+        smi.FileCacheInfo.MaximumWorkingSet = sci.MaximumWorkingSet;
+        smi.FileCacheInfo.CurrentSizeIncludingTransitionInPages = sci.CurrentSizeIncludingTransitionInPages;
+        smi.FileCacheInfo.PeakSizeIncludingTransitionInPages = sci.PeakSizeIncludingTransitionInPages;
+        smi.FileCacheInfo.TransitionRePurposeCount = sci.TransitionRePurposeCount;
+        smi.FileCacheInfo.Flags = sci.Flags;
+    }
+    if (!NtQuerySystemInformation(SystemPerformanceInformation, &spi, sizeof(spi), NULL))
+    {
+        smi.Flags |= MINIDUMP_SYSMEMINFO1_BASICPERF;
+        smi.BasicPerfInfo.AvailablePages = spi.AvailablePages;
+        smi.BasicPerfInfo.CommittedPages = spi.TotalCommittedPages;
+        smi.BasicPerfInfo.CommitLimit = spi.TotalCommitLimit;
+        smi.BasicPerfInfo.PeakCommitment = spi.PeakCommitment;
+        smi.PerfInfo.IdleProcessTime = spi.IdleTime.QuadPart;
+        smi.PerfInfo.IoReadTransferCount = spi.ReadTransferCount.QuadPart;
+        smi.PerfInfo.IoWriteTransferCount = spi.WriteTransferCount.QuadPart;
+        smi.PerfInfo.IoOtherTransferCount = spi.OtherTransferCount.QuadPart;
+        smi.PerfInfo.IoReadOperationCount = spi.ReadOperationCount;
+        smi.PerfInfo.IoWriteOperationCount = spi.WriteOperationCount;
+        smi.PerfInfo.IoOtherOperationCount = spi.OtherOperationCount;
+        smi.PerfInfo.AvailablePages = spi.AvailablePages;
+        smi.PerfInfo.CommittedPages = spi.TotalCommittedPages;
+        smi.PerfInfo.CommitLimit = spi.TotalCommitLimit;
+        smi.PerfInfo.PeakCommitment = spi.PeakCommitment;
+        smi.PerfInfo.PageFaultCount = spi.PageFaults;
+        smi.PerfInfo.CopyOnWriteCount = spi.WriteCopyFaults;
+        smi.PerfInfo.TransitionCount = spi.TransitionFaults;
+        smi.PerfInfo.DemandZeroCount = spi.DemandZeroFaults;
+        smi.PerfInfo.PageReadCount = spi.PagesRead;
+        smi.PerfInfo.PageReadIoCount = spi.PageReadIos;
+        smi.PerfInfo.DirtyPagesWriteCount = spi.PagefilePagesWritten;
+        smi.PerfInfo.DirtyWriteIoCount = spi.PagefilePageWriteIos;
+        smi.PerfInfo.MappedPagesWriteCount = spi.MappedFilePagesWritten;
+        smi.PerfInfo.MappedWriteIoCount = spi.MappedFilePageWriteIos;
+        smi.PerfInfo.PagedPoolPages = spi.PagedPoolUsage;
+        smi.PerfInfo.NonPagedPoolPages = spi.NonPagedPoolUsage;
+        smi.PerfInfo.ContextSwitches = spi.ContextSwitches;
+        smi.PerfInfo.SystemCalls = spi.SystemCalls;
+    }
+    append(dc, &smi, sizeof(smi));
+    return sizeof(smi);
+}
+
 static DWORD CALLBACK write_minidump(void *_args)
 {
     struct dump_context *dc = _args;
@@ -1950,7 +2182,8 @@ static DWORD CALLBACK write_minidump(void *_args)
         cbout.Status = S_FALSE;
         dump_callback(dc, VmStartCallback, &cbin, &cbout);
         memset(&cbout, 0, sizeof(cbout));
-        dump_callback(dc, SecondaryFlagsCallback, &cbin, &cbout);
+        if (dump_callback(dc, SecondaryFlagsCallback, &cbin, &cbout))
+            dc->secondary_flags = cbout.SecondaryFlags & MiniSecondaryValidFlags;
         /* the writes go to IoWriteAllCallback if the callback takes them */
         memset(&cbin, 0, sizeof(cbin));
         memset(&cbout, 0, sizeof(cbout));
@@ -1970,7 +2203,7 @@ static DWORD CALLBACK write_minidump(void *_args)
     /* 1) init */
     nStreams = 7 + (dc->except_param ? 1 : 0) + ((dc->type & MiniDumpWithHandleData) ? 1 : 0) +
         ((dc->type & MiniDumpWithThreadInfo) ? 1 : 0) + ((dc->type & MiniDumpWithFullMemoryInfo) ? 1 : 0) +
-        ((dc->type & MiniDumpWithUnloadedModules) ? 1 : 0) +
+        ((dc->type & MiniDumpWithUnloadedModules) ? 1 : 0) + 2 /* system memory, VM counters */ +
         (dc->user_stream ? dc->user_stream->UserStreamCount : 0);
 
     /* pad the directory size to a multiple of 4 for alignment purposes */
@@ -2085,6 +2318,20 @@ static DWORD CALLBACK write_minidump(void *_args)
     writeat(dc, mdHead.StreamDirectoryRva + idx_stream++ * sizeof(mdDir),
             &mdDir, sizeof(mdDir));
 
+#ifndef SG_MUTANT_NO_VM_STREAMS
+    mdDir.StreamType = SystemMemoryInfoStream;
+    mdDir.Location.Rva = dc->rva;
+    mdDir.Location.DataSize = dump_system_memory_info(dc);
+    writeat(dc, mdHead.StreamDirectoryRva + idx_stream++ * sizeof(mdDir),
+            &mdDir, sizeof(mdDir));
+
+    mdDir.StreamType = ProcessVmCountersStream;
+    mdDir.Location.Rva = dc->rva;
+    mdDir.Location.DataSize = dump_process_vm_counters(dc);
+    writeat(dc, mdHead.StreamDirectoryRva + idx_stream++ * sizeof(mdDir),
+            &mdDir, sizeof(mdDir));
+#endif
+
     /* 3.2) write exception information (if any) */
     if (dc->except_param)
     {
