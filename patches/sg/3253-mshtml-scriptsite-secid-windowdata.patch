 static HRESULT WINAPI HTMLOptionElement_get_index(IHTMLOptionElement *iface, LONG *p)
diff --git a/dlls/mshtml/htmlwindow.c b/dlls/mshtml/htmlwindow.c
index e16efde..815cf0c 100644
--- a/dlls/mshtml/htmlwindow.c
+++ b/dlls/mshtml/htmlwindow.c
@@ -3466,8 +3466,56 @@ static HRESULT WINAPI TravelLogClient_FindWindowByIndex(ITravelLogClient *iface,
 static HRESULT WINAPI TravelLogClient_GetWindowData(ITravelLogClient *iface, IStream *pStream, LPWINDOWDATA pWinData)
 {
     HTMLWindow *This = impl_from_ITravelLogClient(iface);
-    FIXME("(%p)->(%p %p)\n", This, pStream, pWinData);
-    return E_NOTIMPL;
+    const WCHAR *url, *frag;
+    BSTR title = NULL;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p %p)\n", This, pStream, pWinData);
+
+    if(!pWinData)
+        return E_POINTER;
+    memset(pWinData, 0, sizeof(*pWinData));
+    if(!This->outer_window || !This->inner_window || !This->inner_window->doc)
+        return E_UNEXPECTED;
+
+    url = This->outer_window->url;
+    if(!url)
+        url = L"about:blank";
+    /* pages that have no address worth coming back to */
+#ifndef SG_MUTANT_MSHTML_WINDOWDATA
+    if(!wcsnicmp(url, L"javascript:", 11) || !wcsnicmp(url, L"vbscript:", 9) || !wcsnicmp(url, L"about:", 6))
+        return INET_E_SECURITY_PROBLEM;
+#endif
+
+    frag = wcschr(url, '#');
+    pWinData->uiCP = CP_ACP;
+    pWinData->lpszUrl = CoTaskMemAlloc(((frag ? frag - url : wcslen(url)) + 1) * sizeof(WCHAR));
+    if(!pWinData->lpszUrl)
+        return E_OUTOFMEMORY;
+    memcpy(pWinData->lpszUrl, url, (frag ? frag - url : wcslen(url)) * sizeof(WCHAR));
+    pWinData->lpszUrl[frag ? frag - url : wcslen(url)] = 0;
+
+    /* the local anchor and the title */
+    pWinData->lpszUrlLocation = CoTaskMemAlloc(((frag ? wcslen(frag) : 0) + 1) * sizeof(WCHAR));
+    if(!pWinData->lpszUrlLocation) {
+        CoTaskMemFree(pWinData->lpszUrl);
+        pWinData->lpszUrl = NULL;
+        return E_OUTOFMEMORY;
+    }
+    wcscpy(pWinData->lpszUrlLocation, frag ? frag : L"");
+
+    hres = IHTMLDocument2_get_title(&This->inner_window->doc->IHTMLDocument2_iface, &title);
+    pWinData->lpszTitle = CoTaskMemAlloc(((SUCCEEDED(hres) && title ? wcslen(title) : 0) + 1) * sizeof(WCHAR));
+    if(!pWinData->lpszTitle) {
+        SysFreeString(title);
+        CoTaskMemFree(pWinData->lpszUrl);
+        CoTaskMemFree(pWinData->lpszUrlLocation);
+        memset(pWinData, 0, sizeof(*pWinData));
+        return E_OUTOFMEMORY;
+    }
+    wcscpy(pWinData->lpszTitle, SUCCEEDED(hres) && title ? title : L"");
+    SysFreeString(title);
+    return S_OK;
 }
 
 static HRESULT WINAPI TravelLogClient_LoadHistoryPosition(ITravelLogClient *iface, LPWSTR pszUrlLocation, DWORD dwPosition)
