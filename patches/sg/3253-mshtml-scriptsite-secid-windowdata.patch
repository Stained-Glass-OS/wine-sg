     if(dispex_compat_mode(&This->window->event_target.dispex) >= COMPAT_MODE_IE9)
         *ppiunkItem = (IUnknown*)This->window->event_target.dispex.jsdisp;
     else
@@ -629,7 +634,19 @@ static HRESULT WINAPI ActiveScriptSiteWindow_GetWindow(IActiveScriptSiteWindow *
 static HRESULT WINAPI ActiveScriptSiteWindow_EnableModeless(IActiveScriptSiteWindow *iface, BOOL fEnable)
 {
     ScriptHost *This = impl_from_IActiveScriptSiteWindow(iface);
-    FIXME("(%p)->(%x)\n", This, fEnable);
+    HTMLDocumentObj *doc_obj;
+
+    TRACE("(%p)->(%x)\n", This, fEnable);
+
+    if(!This->window || !This->window->base.outer_window)
+        return E_UNEXPECTED;
+
+    /* as IOleInPlaceFrame::EnableModeless: the container is told, not only the document's own handler */
+    doc_obj = This->window->base.outer_window->browser->doc;
+    if(doc_obj->frame)
+        IOleInPlaceFrame_EnableModeless(doc_obj->frame, fEnable);
+    if(doc_obj->hostui)
+        IDocHostUIHandler_EnableModeless(doc_obj->hostui, fEnable);
     return S_OK;
 }
 
@@ -726,16 +743,29 @@ static HRESULT WINAPI ActiveScriptSiteDebug_GetRootApplicationNode(IActiveScript
             IDebugApplicationNode **ppdanRoot)
 {
     ScriptHost *This = impl_from_IActiveScriptSiteDebug(iface);
-    FIXME("(%p)->(%p)\n", This, ppdanRoot);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppdanRoot);
+
+    /* NULL: the script documents are top level, there is no debug application tree */
+    if(!ppdanRoot)
+        return E_POINTER;
+    *ppdanRoot = NULL;
+    return S_OK;
 }
 
 static HRESULT WINAPI ActiveScriptSiteDebug_OnScriptErrorDebug(IActiveScriptSiteDebug *iface,
             IActiveScriptErrorDebug *pErrorDebug, BOOL *pfEnterDebugger, BOOL *pfCallOnScriptErrorWhenContinuing)
 {
     ScriptHost *This = impl_from_IActiveScriptSiteDebug(iface);
-    FIXME("(%p)->(%p %p %p)\n", This, pErrorDebug, pfEnterDebugger, pfCallOnScriptErrorWhenContinuing);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p %p %p)\n", This, pErrorDebug, pfEnterDebugger, pfCallOnScriptErrorWhenContinuing);
+
+    if(!pfEnterDebugger || !pfCallOnScriptErrorWhenContinuing)
+        return E_POINTER;
+    /* there is no debugger to enter, the error is reported to the page as usual */
+    *pfEnterDebugger = FALSE;
+    *pfCallOnScriptErrorWhenContinuing = TRUE;
+    return S_OK;
 }
 
 static const IActiveScriptSiteDebugVtbl ActiveScriptSiteDebugVtbl = {
@@ -817,9 +847,24 @@ static HRESULT WINAPI OleCommandTarget_QueryStatus(IOleCommandTarget *iface, con
 {
     ScriptHost *This = impl_from_IOleCommandTarget(iface);
 
-    FIXME("(%p)->(%s %ld %p %p)\n", This, debugstr_guid(pguidCmdGroup), cCmds, prgCmds, pCmdText);
+    ULONG i;
 
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s %ld %p %p)\n", This, debugstr_guid(pguidCmdGroup), cCmds, prgCmds, pCmdText);
+
+    if(!prgCmds)
+        return E_POINTER;
+
+    /* the only group of the script host is CGID_ScriptSite */
+    if(pguidCmdGroup && !IsEqualGUID(&CGID_ScriptSite, pguidCmdGroup))
+        return OLECMDERR_E_UNKNOWNGROUP;
+
+    for(i = 0; i < cCmds; i++) {
+        if(pguidCmdGroup && prgCmds[i].cmdID == CMDID_SCRIPTSITE_SECURITY_WINDOW)
+            prgCmds[i].cmdf = OLECMDF_SUPPORTED | OLECMDF_ENABLED;
+        else
+            prgCmds[i].cmdf = 0;
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI OleCommandTarget_Exec(IOleCommandTarget *iface, const GUID *pguidCmdGroup,
diff --git a/dlls/mshtml/secmgr.c b/dlls/mshtml/secmgr.c
