diff --git a/dlls/mshtml/script.c b/dlls/mshtml/script.c
index 22fa623..4eb4968 100644
--- a/dlls/mshtml/script.c
+++ b/dlls/mshtml/script.c
@@ -412,12 +412,14 @@ static HRESULT WINAPI ActiveScriptSite_GetItemInfo(IActiveScriptSite *iface, LPC
 
     TRACE("(%p)->(%s %lx %p %p)\n", This, debugstr_w(pstrName), dwReturnMask, ppiunkItem, ppti);
 
-    if(dwReturnMask != SCRIPTINFO_IUNKNOWN) {
-        FIXME("Unsupported mask %lx\n", dwReturnMask);
