   SEC_WINNT_AUTH_IDENTITY_W *nt_identity;
   LPWSTR server_principal_name;
+  ULONG authz_svc;  /* the authorization service the client asked for (RpcBindingSetAuthInfoEx) */
 } RpcAuthInfo;
 
 typedef struct _RpcQualityOfService
