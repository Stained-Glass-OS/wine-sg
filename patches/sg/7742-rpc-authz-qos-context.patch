From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcrt4: authorization service, quality of service, Authz client contexts and the call's security context

- RpcBindingSetAuthInfoEx keeps the authorization service the client asks for (NONE, NAME, DCE or
  DEFAULT, for any security package), and RpcBindingInqAuthInfoEx reports it. It used to report
  RPC_C_AUTHZ_NONE ("not implemented") and refused it for every package but NTLM.
- RpcBindingInqAuthInfoEx reports the quality of service the binding was given, or the defaults,
  for version 1 and 2 structures. It used to fail with RPC_S_INVALID_BINDING whenever one was
  asked for.
- RpcGetAuthorizationContextForClient makes an Authz client context of a server call's caller from
  the token the call impersonates (authz.dll, one resource manager per process). It can keep the
  impersonation on return. RpcFreeAuthorizationContext frees the context. The first was missing and
  the second was a stub.
- I_RpcBindingInqSecurityContext returns the SSPI context of an authenticated call, or
  RPC_S_BINDING_HAS_NO_AUTH. It was a stub.
---
diff --git a/dlls/rpcrt4/Makefile.in b/dlls/rpcrt4/Makefile.in
index 53bc194..e6954b3 100644
--- a/dlls/rpcrt4/Makefile.in
+++ b/dlls/rpcrt4/Makefile.in
@@ -2,7 +2,7 @@ EXTRADEFS = -D_RPCRT4_ -DMSWMSG
 MODULE    = rpcrt4.dll
 IMPORTLIB = rpcrt4
 IMPORTS   = uuid advapi32
-DELAYIMPORTS = iphlpapi wininet secur32 user32 ws2_32 ole32 oleaut32
+DELAYIMPORTS = authz iphlpapi wininet secur32 user32 ws2_32 ole32 oleaut32
 
 SOURCES = \
 	cproxy.c \
diff --git a/dlls/rpcrt4/rpc_binding.c b/dlls/rpcrt4/rpc_binding.c
index 1ae2042..d225d83 100644
--- a/dlls/rpcrt4/rpc_binding.c
+++ b/dlls/rpcrt4/rpc_binding.c
@@ -38,6 +38,7 @@
 #include "rpcasync.h"
 #define SECURITY_WIN32
 #include "security.h"
+#include "authz.h"
 
 #include "wine/debug.h"
 
@@ -1518,6 +1519,9 @@ RpcBindingInqAuthInfoExA( RPC_BINDING_HANDLE Binding, RPC_CSTR *ServerPrincName,
 
     status = RpcBindingInqAuthInfoExW(Binding, ServerPrincName ? &principal : NULL, AuthnLevel,
                                       AuthnSvc, AuthIdentity, AuthzSvc, RpcQosVersion, SecurityQOS);
+    /* the HTTP credentials kept are the wide ones */
+    if (status == RPC_S_OK && SecurityQOS && RpcQosVersion >= RPC_C_SECURITY_QOS_VERSION_2)
+        ((RPC_SECURITY_QOS_V2_A *)SecurityQOS)->u.HttpCredentials = NULL;
     if (status == RPC_S_OK && ServerPrincName)
     {
         *ServerPrincName = (RPC_CSTR)RPCRT4_strdupWtoA(principal);
@@ -1528,6 +1532,36 @@ RpcBindingInqAuthInfoExA( RPC_BINDING_HANDLE Binding, RPC_CSTR *ServerPrincName,
     return status;
 }
 
+/* the quality of service set on a binding (RpcBindingSetAuthInfoEx), as RpcBindingInqAuthInfoEx reports
+ * it; a binding set without one has the defaults */
+static RPC_STATUS rpc_binding_inq_qos( RpcBinding *bind, ULONG version, RPC_SECURITY_QOS *out )
+{
+    const RPC_SECURITY_QOS_V2_W *qos = bind->QOS ? bind->QOS->qos : NULL;
+
+    if (version < RPC_C_SECURITY_QOS_VERSION_1 || version > RPC_C_SECURITY_QOS_VERSION_2)
+    {
+        FIXME( "QOS version %lu\n", version );
+        return RPC_S_INVALID_ARG;
+    }
+#ifdef SG_MUTANT_RPC_QOS_NOT_REPORTED
+    return RPC_S_INVALID_BINDING;
+#endif
+    out->Version = version;
+    out->Capabilities = qos ? qos->Capabilities : RPC_C_QOS_CAPABILITIES_DEFAULT;
+    out->IdentityTracking = qos ? qos->IdentityTracking : RPC_C_QOS_IDENTITY_STATIC;
+    out->ImpersonationType = qos ? qos->ImpersonationType : RPC_C_IMP_LEVEL_DEFAULT;
+    if (version >= RPC_C_SECURITY_QOS_VERSION_2)
+    {
+        RPC_SECURITY_QOS_V2_W *out2 = (RPC_SECURITY_QOS_V2_W *)out;
+
+        out2->AdditionalSecurityInfoType = qos && qos->Version >= RPC_C_SECURITY_QOS_VERSION_2
+                                           ? qos->AdditionalSecurityInfoType : 0;
+        out2->u.HttpCredentials = out2->AdditionalSecurityInfoType == RPC_C_AUTHN_INFO_TYPE_HTTP
+                                  ? qos->u.HttpCredentials : NULL;
+    }
+    return RPC_S_OK;
+}
+
 /***********************************************************************
  *             RpcBindingInqAuthInfoExW (RPCRT4.@)
  */
@@ -1545,8 +1579,8 @@ RpcBindingInqAuthInfoExW( RPC_BINDING_HANDLE Binding, RPC_WSTR *ServerPrincName,
 
     if (SecurityQOS)
     {
-        FIXME("QOS not implemented\n");
-        return RPC_S_INVALID_BINDING;
+        RPC_STATUS status = rpc_binding_inq_qos( bind, RpcQosVersion, SecurityQOS );
+        if (status != RPC_S_OK) return status;
     }
 
     if (ServerPrincName)
@@ -1561,11 +1595,7 @@ RpcBindingInqAuthInfoExW( RPC_BINDING_HANDLE Binding, RPC_WSTR *ServerPrincName,
     if (AuthnLevel) *AuthnLevel = bind->AuthInfo->AuthnLevel;
     if (AuthnSvc) *AuthnSvc = bind->AuthInfo->AuthnSvc;
     if (AuthIdentity) *AuthIdentity = bind->AuthInfo->identity;
-    if (AuthzSvc)
-    {
-        FIXME("authorization service not implemented\n");
-        *AuthzSvc = RPC_C_AUTHZ_NONE;
-    }
+    if (AuthzSvc) *AuthzSvc = bind->AuthInfo->authz_svc;
 
     return RPC_S_OK;
 }
@@ -1906,8 +1936,11 @@ RpcBindingSetAuthInfoExA( RPC_BINDING_HANDLE Binding, RPC_CSTR ServerPrincName,
     return RPC_S_UNKNOWN_AUTHN_LEVEL;
   }
 
-  /* RPC_C_AUTHN_WINNT ignores the AuthzSvr parameter */
-  if (AuthzSvr && AuthnSvc != RPC_C_AUTHN_WINNT)
+  /* Stained Glass OS 7742: the authorization service is the client's request, kept and reported back
+   * (RpcBindingInqAuthInfoEx); a security package that does no authorization ignores it, as
+   * RPC_C_AUTHN_WINNT always did */
+  if (AuthzSvr != RPC_C_AUTHZ_NONE && AuthzSvr != RPC_C_AUTHZ_NAME && AuthzSvr != RPC_C_AUTHZ_DCE &&
+      AuthzSvr != RPC_C_AUTHZ_DEFAULT)
   {
     FIXME("unsupported AuthzSvr %lu\n", AuthzSvr);
     return RPC_S_UNKNOWN_AUTHZ_SERVICE;
@@ -1944,6 +1977,9 @@ RpcBindingSetAuthInfoExA( RPC_BINDING_HANDLE Binding, RPC_CSTR ServerPrincName,
     if (r == RPC_S_OK)
     {
       new_auth_info->server_principal_name = RPCRT4_strdupAtoW((char *)ServerPrincName);
+#ifndef SG_MUTANT_RPC_AUTHZ_NOT_KEPT
+      new_auth_info->authz_svc = AuthzSvr;
+#endif
       if (!ServerPrincName || new_auth_info->server_principal_name)
       {
         if (bind->AuthInfo) RpcAuthInfo_Release(bind->AuthInfo);
@@ -2037,8 +2073,11 @@ RpcBindingSetAuthInfoExW( RPC_BINDING_HANDLE Binding, RPC_WSTR ServerPrincName,
     return RPC_S_UNKNOWN_AUTHN_LEVEL;
   }
 
-  /* RPC_C_AUTHN_WINNT ignores the AuthzSvr parameter */
-  if (AuthzSvr && AuthnSvc != RPC_C_AUTHN_WINNT)
+  /* Stained Glass OS 7742: the authorization service is the client's request, kept and reported back
+   * (RpcBindingInqAuthInfoEx); a security package that does no authorization ignores it, as
+   * RPC_C_AUTHN_WINNT always did */
+  if (AuthzSvr != RPC_C_AUTHZ_NONE && AuthzSvr != RPC_C_AUTHZ_NAME && AuthzSvr != RPC_C_AUTHZ_DCE &&
+      AuthzSvr != RPC_C_AUTHZ_DEFAULT)
   {
     FIXME("unsupported AuthzSvr %lu\n", AuthzSvr);
     return RPC_S_UNKNOWN_AUTHZ_SERVICE;
@@ -2075,6 +2114,9 @@ RpcBindingSetAuthInfoExW( RPC_BINDING_HANDLE Binding, RPC_WSTR ServerPrincName,
     if (r == RPC_S_OK)
     {
       new_auth_info->server_principal_name = wcsdup(ServerPrincName);
+#ifndef SG_MUTANT_RPC_AUTHZ_NOT_KEPT
+      new_auth_info->authz_svc = AuthzSvr;
+#endif
       if (!ServerPrincName || new_auth_info->server_principal_name)
       {
         if (bind->AuthInfo) RpcAuthInfo_Release(bind->AuthInfo);
@@ -2172,3 +2214,91 @@ RPC_STATUS WINAPI I_RpcBindingInqLocalClientPID(RPC_BINDING_HANDLE ClientBinding
 
     return connection->ops->inquire_client_pid(connection, ClientPID);
 }
+
+/***********************************************************************
+ *             I_RpcBindingInqSecurityContext (RPCRT4.@)
+ *
+ * The SSPI security context of the call a server binding handle stands for (COM's call context).
+ */
+RPC_STATUS WINAPI I_RpcBindingInqSecurityContext( RPC_BINDING_HANDLE Binding, void **SecurityContextHandle )
+{
+    RpcBinding *bind = Binding;
+
+    TRACE( "%p %p\n", Binding, SecurityContextHandle );
+
+    if (!SecurityContextHandle) return RPC_S_INVALID_ARG;
+    *SecurityContextHandle = NULL;
+    if (!bind) bind = I_RpcGetCurrentCallHandle();
+    if (!bind || !bind->FromConn) return RPC_S_INVALID_BINDING;
+    if (!bind->FromConn->AuthInfo || !SecIsValidHandle( &bind->FromConn->ctx )) return RPC_S_BINDING_HAS_NO_AUTH;
+    *SecurityContextHandle = &bind->FromConn->ctx;
+    return RPC_S_OK;
+}
+
+static AUTHZ_RESOURCE_MANAGER_HANDLE rpc_authz_manager;
+
+/***********************************************************************
+ *             RpcGetAuthorizationContextForClient (RPCRT4.@)
+ *
+ * An Authz client context for the caller of a server call, made from the token the call impersonates.
+ */
+RPC_STATUS RPC_ENTRY RpcGetAuthorizationContextForClient( RPC_BINDING_HANDLE ClientBinding, BOOL ImpersonateOnReturn,
+                                                          void *Reserved1, LARGE_INTEGER *pExpirationTime,
+                                                          LUID Reserved2, DWORD Reserved3, void *Reserved4,
+                                                          void **pAuthzClientContext )
+{
+    AUTHZ_RESOURCE_MANAGER_HANDLE manager;
+    AUTHZ_CLIENT_CONTEXT_HANDLE context;
+    RPC_STATUS status;
+    HANDLE token;
+    BOOL ok;
+
+    TRACE( "%p %d %p %p %lx:%lx %lu %p %p\n", ClientBinding, ImpersonateOnReturn, Reserved1, pExpirationTime,
+           Reserved2.HighPart, Reserved2.LowPart, Reserved3, Reserved4, pAuthzClientContext );
+
+    if (!pAuthzClientContext) return RPC_S_INVALID_ARG;
+    *pAuthzClientContext = NULL;
+    if (Reserved1 || Reserved2.LowPart || Reserved2.HighPart || Reserved3 || Reserved4) return RPC_S_INVALID_ARG;
+
+    if (!(manager = rpc_authz_manager))
+    {
+        if (!AuthzInitializeResourceManager( AUTHZ_RM_FLAG_NO_AUDIT, NULL, NULL, NULL, L"rpcrt4", &manager ))
+            return GetLastError();
+        if (InterlockedCompareExchangePointer( (void **)&rpc_authz_manager, manager, NULL ))
+        {
+            AuthzFreeResourceManager( manager );
+            manager = rpc_authz_manager;
+        }
+    }
+
+    if ((status = RpcImpersonateClient( ClientBinding )) != RPC_S_OK) return status;
+    if (!OpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, &token ))
+    {
+        status = GetLastError();
+        RpcRevertToSelfEx( ClientBinding );
+        return status;
+    }
+#ifndef SG_MUTANT_RPC_NO_AUTHZ_CONTEXT
+    ok = AuthzInitializeContextFromToken( 0, token, manager, pExpirationTime, Reserved2, NULL, &context );
+#else
+    ok = FALSE; SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+#endif
+    status = ok ? RPC_S_OK : GetLastError();
+    CloseHandle( token );
+    if (!ImpersonateOnReturn || !ok) RpcRevertToSelfEx( ClientBinding );
+    if (ok) *pAuthzClientContext = context;
+    return status;
+}
+
+/***********************************************************************
+ *             RpcFreeAuthorizationContext (RPCRT4.@)
+ */
+RPC_STATUS RPC_ENTRY RpcFreeAuthorizationContext( void **pAuthzClientContext )
+{
+    TRACE( "%p\n", pAuthzClientContext );
+
+    if (!pAuthzClientContext) return RPC_S_INVALID_ARG;
+    if (*pAuthzClientContext && !AuthzFreeContext( *pAuthzClientContext )) return GetLastError();
+    *pAuthzClientContext = NULL;
+    return RPC_S_OK;
+}
diff --git a/dlls/rpcrt4/rpc_binding.h b/dlls/rpcrt4/rpc_binding.h
