From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: Fail unknown properties with STATUS_NOT_SUPPORTED.

BCryptGetProperty and BCryptSetProperty fail with STATUS_NOT_SUPPORTED
("The named property ... is not supported") for a property or chaining mode
the object does not have, on algorithm, key and hash handles, instead of
STATUS_NOT_IMPLEMENTED (the bcrypt tests show STATUS_NOT_SUPPORTED for 3DES
with GCM). The FIXMEs that name what is missing stay.

Gate: test/bcrypt-propnotsupported-gate.sh (64/32).
---
 dlls/bcrypt/bcrypt_main.c | 29 ++++++++++++++++++++++++-----
 1 file changed, 24 insertions(+), 5 deletions(-)

diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 85bb26d..f9ab633 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -934,6 +934,7 @@ NTSTATUS WINAPI BCryptGetProperty( BCRYPT_HANDLE handle, const WCHAR *prop, UCHA
                                    ULONG flags )
 {
     struct object *object = get_object( handle, 0 );
+    NTSTATUS status;
 
     TRACE( "%p, %s, %p, %lu, %p, %#lx\n", handle, wine_dbgstr_w(prop), buffer, count, res, flags );
 
@@ -945,22 +946,31 @@ NTSTATUS WINAPI BCryptGetProperty( BCRYPT_HANDLE handle, const WCHAR *prop, UCHA
     case MAGIC_ALG:
     {
         const struct algorithm *alg = (const struct algorithm *)object;
-        return get_alg_property( alg, prop, buffer, count, res );
+        status = get_alg_property( alg, prop, buffer, count, res );
+        break;
     }
     case MAGIC_KEY:
     {
         const struct key *key = (const struct key *)object;
-        return get_key_property( key, prop, buffer, count, res );
+        status = get_key_property( key, prop, buffer, count, res );
+        break;
     }
     case MAGIC_HASH:
     {
         const struct hash *hash = (const struct hash *)object;
-        return get_hash_property( hash, prop, buffer, count, res );
+        status = get_hash_property( hash, prop, buffer, count, res );
+        break;
     }
     default:
         WARN( "unknown magic %#lx\n", object->magic );
         return STATUS_INVALID_HANDLE;
     }
+    /* "STATUS_NOT_SUPPORTED: The named property specified by the pszProperty
+     * parameter is not supported"; the getters' FIXMEs name what is missing */
+#ifndef SG_MUTANT_BCRYPT_PROP_NOTIMPL
+    if (status == STATUS_NOT_IMPLEMENTED) status = STATUS_NOT_SUPPORTED;
+#endif
+    return status;
 }
 
 static NTSTATUS hash_prepare( struct hash *hash )
@@ -2443,6 +2453,7 @@ NTSTATUS WINAPI BCryptDecrypt( BCRYPT_KEY_HANDLE handle, UCHAR *input, ULONG inp
 NTSTATUS WINAPI BCryptSetProperty( BCRYPT_HANDLE handle, const WCHAR *prop, UCHAR *value, ULONG size, ULONG flags )
 {
     struct object *object = get_object( handle, 0 );
+    NTSTATUS status;
 
     TRACE( "%p, %s, %p, %lu, %#lx\n", handle, debugstr_w(prop), value, size, flags );
 
@@ -2454,17 +2465,25 @@ NTSTATUS WINAPI BCryptSetProperty( BCRYPT_HANDLE handle, const WCHAR *prop, UCHA
     case MAGIC_ALG:
     {
         struct algorithm *alg = (struct algorithm *)object;
-        return set_alg_property( alg, prop, value, size, flags );
+        status = set_alg_property( alg, prop, value, size, flags );
+        break;
     }
     case MAGIC_KEY:
     {
         struct key *key = (struct key *)object;
-        return set_key_property( key, prop, value, size, flags );
+        status = set_key_property( key, prop, value, size, flags );
+        break;
     }
     default:
         WARN( "unknown magic %#lx\n", object->magic );
         return STATUS_INVALID_HANDLE;
     }
+    /* a property or chaining mode the provider does not have is not
+     * supported, as for 3DES with GCM (bcrypt tests) */
+#ifndef SG_MUTANT_BCRYPT_PROP_NOTIMPL
+    if (status == STATUS_NOT_IMPLEMENTED) status = STATUS_NOT_SUPPORTED;
+#endif
+    return status;
 }
 
 #define HMAC_PAD_LEN 64
