+    dobj_get_value( &button_from_iface( iface )->c.e.d, prop_glyph, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    hr = WindowsCreateString( str ? str : L"", str ? wcslen( str ) : 0, value );
+    free( str );
+    return hr;
+}
+
+static HRESULT WINAPI font_icon_put_Glyph( struct xiface *iface, HSTRING value )
+{
