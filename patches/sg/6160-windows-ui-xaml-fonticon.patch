+    xunbox_ref( box, &IID_IReference_FontWeight, value, sizeof(*value) );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI font_icon_put_FontWeight( struct xiface *iface, UINT16 value )
