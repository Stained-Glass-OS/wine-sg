+/* FontIcon: its Glyph text in its FontFamily (the icon font by default); without the icon font its
+ * private-use glyphs as their standard characters */
+static void font_icon_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct button *icon = button_from_elem( elem );
+    IInspectable *box = NULL;
+    WCHAR *glyph, *family = NULL, *out;
+    const WCHAR *font;
+    UINT16 weight = 400;
+    DOUBLE size;
+    size_t i, o = 0;
+
+    if (icon->glyph) IUnknown_Release( icon->glyph );
+    icon->glyph = NULL;
+    desired->width = desired->height = 0;
+    dobj_get_value( &elem->d, prop_glyph, &box );
+    glyph = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_icon_font_size, &box );
+    size = xunbox_double( box, 20 );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_icon_font_weight, &box );
+    xunbox_ref( box, &IID_IReference_FontWeight, &weight, sizeof(weight) );
+    if (box) IInspectable_Release( box );
+    box = NULL;
+    dobj_get_value( &elem->d, prop_icon_font_family, &box );
+    if (box) family = xaml_font_family_name( box );
+    if (box) IInspectable_Release( box );
+    if (!glyph || !*glyph || !(out = malloc( (wcslen( glyph ) * 2 + 1) * sizeof(WCHAR) )))
+    {
+        free( glyph );
+        free( family );
+        return;
+    }
+    font = family && *family ? family : L"Segoe MDL2 Assets";
+    if (xaml_is_missing_icon_font( font ))
+    {
+        font = xaml_symbol_font();
+        for (i = 0; glyph[i]; i++)
+        {
+            UINT32 fb = glyph[i] >= 0xe000 && glyph[i] <= 0xf8ff ? xaml_symbol_fallback( glyph[i] ) : 0;
+#ifdef SG_MUTANT_FONTICON_NO_STANDIN
+            fb = 0;
+#endif
+            if (fb >= 0x10000)
+            {
+                out[o++] = 0xd800 | ((fb - 0x10000) >> 10);
+                out[o++] = 0xdc00 | ((fb - 0x10000) & 0x3ff);
+            }
+            else out[o++] = fb ? fb : glyph[i];
+        }
+    }
+    else for (i = 0; glyph[i]; i++) out[o++] = glyph[i];
+    out[o] = 0;
+    icon->glyph = xaml_make_text_layout( out, font, size > 0 ? size : 20, weight ? weight : 400, desired );
+    free( out );
+    free( glyph );
+    free( family );
+}
+
