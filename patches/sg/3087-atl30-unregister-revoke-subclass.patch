From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 18:44:27 -0700
Subject: [PATCH] atl: unregistering a server, revoking class objects,
 subclassed window classes (ATL 3.0)

AtlModuleUnregisterServerEx / AtlModuleUnregisterServer unregister the objects of the
module (and their categories, and the type library on request), AtlModuleRevokeClassObjects
revokes the class objects AtlModuleRegisterClassObjects registered, AtlModuleUnRegisterTypeLib
removes the module's type library. AtlModuleRegisterWndClassInfoA/W make a class on the
attributes of an existing one when the information names it (subclass), keeping their own name
and procedure and returning the original procedure.

diff --git a/dlls/atl/atl.spec b/dlls/atl/atl.spec
index 48e136d..7bcb7ee 100644
--- a/dlls/atl/atl.spec
+++ b/dlls/atl/atl.spec
@@ -46,7 +46,7 @@
 52 stdcall AtlIPersistPropertyBag_Load(ptr ptr ptr ptr ptr)
 53 stdcall AtlIPersistPropertyBag_Save(ptr long long ptr ptr ptr)
 54 stdcall AtlGetObjectSourceInterface(ptr ptr ptr ptr ptr)
-55 stub AtlModuleUnRegisterTypeLib
+55 stdcall AtlModuleUnRegisterTypeLib(ptr wstr)
 56 stdcall AtlModuleLoadTypeLib(ptr wstr ptr ptr)
 57 stdcall AtlModuleUnregisterServerEx(ptr long ptr)
 58 stdcall AtlModuleAddTermFunc(ptr ptr long)
diff --git a/dlls/atl/atl30.c b/dlls/atl/atl30.c
index 767fa97..82cbaeb 100644
--- a/dlls/atl/atl30.c
+++ b/dlls/atl/atl30.c
@@ -166,9 +166,49 @@ HRESULT WINAPI AtlModuleRegisterClassObjects(_ATL_MODULEW *pM, DWORD dwClsContex
    return S_OK;
 }
 
+HRESULT WINAPI AtlModuleUnRegisterTypeLib(_ATL_MODULEW *pm, LPCOLESTR lpszIndex);
+
 HRESULT WINAPI AtlModuleUnregisterServerEx(_ATL_MODULEW* pM, BOOL bUnRegTypeLib, const CLSID* pCLSID)
 {
-    FIXME("(%p, %i, %p) stub\n", pM, bUnRegTypeLib, pCLSID);
+    const _ATL_OBJMAP_ENTRYW_V1 *obj;
+    HRESULT hRes;
+    int i;
+
+    TRACE("(%p, %i, %s)\n", pM, bUnRegTypeLib, debugstr_guid(pCLSID));
+
+    if (pM == NULL)
+        return E_INVALIDARG;
+
+    for (i = 0; (obj = get_objmap_entry( pM, i )) != NULL; i++) /* unregister CLSIDs */
+    {
+        if (!pCLSID || IsEqualCLSID(obj->pclsid, pCLSID))
+        {
+            TRACE("Unregistering clsid %s\n", debugstr_guid(obj->pclsid));
+
+            if(pM->cbSize > ATLVer1Size) {
+                const struct _ATL_CATMAP_ENTRY *catmap;
+
+                catmap = ((const _ATL_OBJMAP_ENTRYW*)obj)->pfnGetCategoryMap();
+                if(catmap) {
+                    hRes = AtlRegisterClassCategoriesHelper(obj->pclsid, catmap, FALSE);
+                    if(FAILED(hRes))
+                        return hRes;
+                }
+            }
+
+            hRes = obj->pfnUpdateRegistry(FALSE); /* unregister */
+            if (FAILED(hRes))
+                return hRes;
+        }
+    }
+
+    if (bUnRegTypeLib)
+    {
+        hRes = AtlModuleUnRegisterTypeLib(pM, NULL);
+        if (FAILED(hRes))
+            return hRes;
+    }
+
     return S_OK;
 }
 
@@ -275,8 +315,53 @@ HRESULT WINAPI AtlModuleRegisterTypeLib(_ATL_MODULEW *pm, LPCOLESTR lpszIndex)
  */
 HRESULT WINAPI AtlModuleRevokeClassObjects(_ATL_MODULEW *pm)
 {
-    FIXME("%p\n", pm);
-    return E_FAIL;
+    _ATL_OBJMAP_ENTRYW_V1 *obj;
+    HRESULT hr = S_OK, rc;
+    int i;
+
+    TRACE("%p\n", pm);
+
+    if (!pm)
+        return E_INVALIDARG;
+
+    for (i = 0; (obj = get_objmap_entry( pm, i )) != NULL; i++)
+    {
+#ifdef SG_MUTANT_NO_REVOKE
+        continue;
+#endif
+        if (!obj->dwRegister) continue;
+        rc = CoRevokeClassObject(obj->dwRegister);
+        if (FAILED(rc) && SUCCEEDED(hr)) hr = rc;
+        obj->dwRegister = 0;
+    }
+    return hr;
+}
+
+/***********************************************************************
+ *           AtlModuleUnRegisterTypeLib           [ATL.@]
+ */
+HRESULT WINAPI AtlModuleUnRegisterTypeLib(_ATL_MODULEW *pm, LPCOLESTR lpszIndex)
+{
+    ITypeLib *typelib;
+    TLIBATTR *attr;
+    BSTR path;
+    HRESULT hr;
+
+    TRACE("%p %s\n", pm, debugstr_w(lpszIndex));
+
+    if (!pm)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = AtlLoadTypeLib(pm->m_hInstTypeLib, lpszIndex, &path, &typelib)))
+        return hr;
+    SysFreeString(path);
+    if (SUCCEEDED(hr = ITypeLib_GetLibAttr(typelib, &attr)))
+    {
+        hr = UnRegisterTypeLib(&attr->guid, attr->wMajorVerNum, attr->wMinorVerNum, attr->lcid, attr->syskind);
+        ITypeLib_ReleaseTLibAttr(typelib, attr);
+    }
+    ITypeLib_Release(typelib);
+    return hr;
 }
 
 /***********************************************************************
@@ -284,8 +369,8 @@ HRESULT WINAPI AtlModuleRevokeClassObjects(_ATL_MODULEW *pm)
  */
 HRESULT WINAPI AtlModuleUnregisterServer(_ATL_MODULEW *pm, const CLSID *clsid)
 {
-    FIXME("%p %s\n", pm, debugstr_guid(clsid));
-    return E_FAIL;
+    TRACE("%p %s\n", pm, debugstr_guid(clsid));
+    return AtlModuleUnregisterServerEx(pm, FALSE, clsid);
 }
 
