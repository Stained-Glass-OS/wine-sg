From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, cldapi: placeholders carry the pinned, unpinned and recall attributes

On Windows a cloud file's pin state and whether its data must be recalled are file attributes (FILE_ATTRIBUTE_PINNED, UNPINNED, RECALL_ON_DATA_ACCESS), which programs and the shell read with GetFileAttributes. Wine stored only the hidden and system attributes, so cldapi's pin attributes were lost. ntdll now keeps these with the others, and cldapi keeps them in step with each placeholder's state: pinned or unpinned as set, recall-on-data-access while its data is not all on the disk.
---
diff --git a/dlls/cldapi/main.c b/dlls/cldapi/main.c
index 8fb2148..47b4fa2 100644
--- a/dlls/cldapi/main.c
+++ b/dlls/cldapi/main.c
@@ -392,7 +392,21 @@ static BOOL meta_read(const WCHAR *path, struct meta *meta)
     return ret;
 }
 
+static void apply_attributes(const WCHAR *path, const struct meta *meta);
+
+/* the store's record of a placeholder, and the attributes that show its state (6257) */
+static BOOL meta_write_store(const WCHAR *path, const struct meta *meta);
+
 static BOOL meta_write(const WCHAR *path, const struct meta *meta)
+{
+    if (!meta_write_store(path, meta)) return FALSE;
+#ifndef SG_MUTANT_NO_RECALL_ATTRIB
+    apply_attributes(path, meta);
+#endif
+    return TRUE;
+}
+
+static BOOL meta_write_store(const WCHAR *path, const struct meta *meta)
 {
     WCHAR store[MAX_PATH + 64];
     DWORD written, size = FIELD_OFFSET(struct meta, identity) + meta->identity_length;
@@ -490,10 +504,15 @@ static void apply_attributes(const WCHAR *path, const struct meta *meta)
 {
     DWORD attr = GetFileAttributesW(path);
 
+    DWORD want;
+
     if (attr == INVALID_FILE_ATTRIBUTES) return;
-    attr &= ~(0x00080000 | 0x00100000);
-    attr |= pin_attributes(meta->pin_state);
-    SetFileAttributesW(path, attr);
+    want = attr & ~(0x00080000 | 0x00100000 | 0x00400000);
+    want |= pin_attributes(meta->pin_state);
+    /* Stained Glass OS 6257: a file whose data is not all here is recalled when read */
+    if (!(attr & FILE_ATTRIBUTE_DIRECTORY) && !(meta->flags & META_FULL) && meta->size)
+        want |= 0x00400000;  /* FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS */
+    if (want != attr) SetFileAttributesW(path, want);
 }
 
 /* ---- sync roots and connections -------------------------------------------- */
@@ -1079,7 +1098,7 @@ HRESULT WINAPI CfRevertPlaceholder( HANDLE handle, DWORD flags, void *overlapped
     /* a file whose data is not all on disk cannot become a normal file */
     if (!(meta.flags & META_FULL) && meta.size) return HRESULT_FROM_WIN32( ERROR_CLOUD_FILE_NOT_IN_SYNC );
     meta_delete( path );
-    SetFileAttributesW( path, GetFileAttributesW( path ) & ~(0x00080000 | 0x00100000) );
+    SetFileAttributesW( path, GetFileAttributesW( path ) & ~(0x00080000 | 0x00100000 | 0x00400000) );
     return S_OK;
 }
 
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 553953f..a307021 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -180,7 +180,16 @@ typedef struct
 #endif
 
 #define SAMBA_XATTR_DOS_ATTRIB  XATTR_USER_PREFIX "DOSATTRIB"
+/* Stained Glass OS 6257: and a cloud file's pin and recall attributes, which Windows keeps
+ * with the file (attrib +p / -u; FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS of a file whose data
+ * is in the cloud): cldapi sets them, and programs and the shell read them back */
+#ifndef SG_MUTANT_NO_CLOUD_ATTRIBS
+#define XATTR_ATTRIBS_MASK      (FILE_ATTRIBUTE_HIDDEN|FILE_ATTRIBUTE_SYSTEM|0x00040000 /* RECALL_ON_OPEN */ | \
+                                 0x00080000 /* PINNED */ | 0x00100000 /* UNPINNED */ | \
+                                 0x00400000 /* RECALL_ON_DATA_ACCESS */)
+#else
 #define XATTR_ATTRIBS_MASK      (FILE_ATTRIBUTE_HIDDEN|FILE_ATTRIBUTE_SYSTEM)
+#endif
 
 struct file_identity
 {
@@ -1801,7 +1810,7 @@ static int fd_get_file_info_h( HANDLE handle, int fd, unsigned int options, stru
 
 static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set )
 {
-    /* we only store the HIDDEN and SYSTEM attributes */
+    /* we only store the HIDDEN and SYSTEM attributes (and the cloud ones, 6257) */
     attr &= XATTR_ATTRIBS_MASK;
     if (force_set || attr != 0)
     {
