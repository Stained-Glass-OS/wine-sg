+static void uia_cache_props_free(struct uia_cache_property *props, int count)
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        VariantClear(&props[i].prop_val);
+    free(props);
+}
+
+static void uia_cached_tree_release(struct uia_cached_tree *tree)
+{
+    int i;
+
+    if (!tree || InterlockedDecrement(&tree->ref))
+        return;
+
+    for (i = 0; i < tree->nodes_count; i++)
+    {
+        struct uia_cached_tree_node *node = &tree->nodes[i];
+
+        free(node->children);
+        uia_cache_props_free(node->props, node->props_count);
+        if (node->node)
+            UiaNodeRelease(node->node);
+    }
+    free(tree->nodes);
+    free(tree->cache_req.pProperties);
+    free(tree);
+}
