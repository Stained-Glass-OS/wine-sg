+
+static HRESULT uia_cached_tree_add_node(struct uia_cached_tree *tree, int parent, LONG row, BOOL children_cached,
+        int *idx)
+{
+    struct uia_cached_tree_node *node;
+
+    if (!uia_array_reserve((void **)&tree->nodes, &tree->nodes_size, tree->nodes_count + 1, sizeof(*tree->nodes)))
+        return E_OUTOFMEMORY;
+
+    *idx = tree->nodes_count++;
+    node = &tree->nodes[*idx];
+    memset(node, 0, sizeof(*node));
+    node->parent = parent;
+    node->row = row;
+    node->children_cached = children_cached;
+
+    if (parent >= 0)
+    {
+        struct uia_cached_tree_node *p = &tree->nodes[parent];
+        int *children = realloc(p->children, (p->children_count + 1) * sizeof(*children));
+
+        if (!children)
+        {
+            tree->nodes_count--;
+            return E_OUTOFMEMORY;
+        }
+        p->children = children;
+        p->children[p->children_count++] = *idx;
+    }
+    return S_OK;
+}
+
+/*
+ * A node is 'P', its children in parentheses if it has any, and ')'. The
+ * rows follow in the order the nodes are written.
+ */
+static HRESULT uia_cached_tree_parse_node(struct uia_cached_tree *tree, const WCHAR **p, int parent, int depth,
+        LONG *row, LONG max_rows)
+{
+    HRESULT hr;
+    int idx;
+
+    if (**p != 'P' || *row >= max_rows || depth > 256)
+        return E_FAIL;
+    (*p)++;
+
+    hr = uia_cached_tree_add_node(tree, parent, (*row)++,
+            !!(tree->cache_req.Scope & (depth ? TreeScope_Descendants : (TreeScope_Children | TreeScope_Descendants))),
+            &idx);
+    if (FAILED(hr))
+        return hr;
+
+    if (**p == '(')
+    {
+        (*p)++;
+        while (**p == 'P')
+        {
+            if (FAILED(hr = uia_cached_tree_parse_node(tree, p, idx, depth + 1, row, max_rows)))
+                return hr;
+        }
+        if (**p != ')')
+            return E_FAIL;
+        (*p)++;
     }
+    if (**p != ')')
+        return E_FAIL;
+    (*p)++;
+    return S_OK;
+}
+
+static HRESULT create_uia_element_from_cached_tree(struct uia_cached_tree *tree, int idx,
+        IUIAutomationElement **out)
+{
+    struct uia_cached_tree_node *node = &tree->nodes[idx];
+    struct uia_element *elem_data;
+    HRESULT hr;
+    int i;
 
+    *out = NULL;
+    IUnknown_AddRef((IUnknown *)node->node);
+    if (FAILED(hr = create_uia_element(out, tree->from_cui8, node->node)))
+    {
+        UiaNodeRelease(node->node);
+        return hr;
+    }
+
+    elem_data = impl_from_IUIAutomationElement9((IUIAutomationElement9 *)*out);
+    if (node->props_count)
+    {
+        if (!(elem_data->cached_props = calloc(node->props_count, sizeof(*elem_data->cached_props))))
+        {
+            IUIAutomationElement_Release(*out);
+            *out = NULL;
+            return E_OUTOFMEMORY;
+        }
+        elem_data->cached_props_count = node->props_count;
+        for (i = 0; i < node->props_count; i++)
+        {
+            elem_data->cached_props[i].prop_id = node->props[i].prop_id;
+            VariantCopy(&elem_data->cached_props[i].prop_val, &node->props[i].prop_val);
+        }
+    }
+
+    elem_data->tree = tree;
+    InterlockedIncrement(&tree->ref);
+    elem_data->tree_idx = idx;
+    return S_OK;
+}
+
+static HRESULT create_uia_element_from_cache_req(IUIAutomationElement **iface, BOOL from_cui8,
+        struct UiaCacheRequest *cache_req, LONG start_idx, SAFEARRAY *req_data, BSTR tree_struct)
+{
+    struct uia_cached_tree *tree = NULL;
+    LONG lbound, ubound, row;
+    const WCHAR *p;
+    HRESULT hr;
+    int i;
+
+    if (!(cache_req->Scope & (TreeScope_Children | TreeScope_Descendants)))
+    {
+        hr = create_uia_element_from_rows(iface, from_cui8, cache_req, start_idx, req_data);
+        goto done;
+    }
+
+    *iface = NULL;
+    if (FAILED(hr = SafeArrayGetLBound(req_data, 1, &lbound)) || FAILED(hr = SafeArrayGetUBound(req_data, 1, &ubound)))
+        goto done;
+
+    if (!(tree = calloc(1, sizeof(*tree))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    tree->ref = 1;
+    tree->from_cui8 = from_cui8;
+    tree->cache_req = *cache_req;
+    tree->cache_req.pViewCondition = NULL;
+    tree->cache_req.pProperties = NULL;
+    if (cache_req->cProperties)
+    {
+        if (!(tree->cache_req.pProperties = malloc(cache_req->cProperties * sizeof(*tree->cache_req.pProperties))))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        memcpy(tree->cache_req.pProperties, cache_req->pProperties,
+                cache_req->cProperties * sizeof(*tree->cache_req.pProperties));
+    }
+
+    p = tree_struct;
+    row = start_idx;
+    if (!p || FAILED(uia_cached_tree_parse_node(tree, &p, -1, 0, &row, ubound + 1)))
+    {
+        /* The element is still good; its children are just not available. */
+        WARN("Unexpected cached tree structure %s\n", debugstr_w(tree_struct));
+        hr = create_uia_element_from_rows(iface, from_cui8, cache_req, start_idx, req_data);
+        goto done;
+    }
+
+    for (i = 0; i < tree->nodes_count; i++)
+    {
+        struct uia_cached_tree_node *node = &tree->nodes[i];
+
+        if (FAILED(hr = uia_read_cached_row(from_cui8, &tree->cache_req, node->row, req_data, &node->node,
+                &node->props, &node->props_count)))
+            goto done;
+    }
+
+    hr = create_uia_element_from_cached_tree(tree, 0, iface);
+
+done:
+    uia_cached_tree_release(tree);
     SysFreeString(tree_struct);
     return hr;
 }
