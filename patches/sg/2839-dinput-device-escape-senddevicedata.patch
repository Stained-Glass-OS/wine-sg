@@ -3224,7 +3218,6 @@ static void test_simple_joystick( DWORD version )
     escape.lpvOutBuffer = buffer + 10;
     escape.cbOutBuffer = 10;
     hr = IDirectInputDevice8_Escape( device, &escape );
-    todo_wine
