From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: IDirectInputDevice8::Escape and SendDeviceData

FIXME stubs that returned DI_OK, with the results dinput's conformance tests
(joystick8.c, force_feedback.c) record from native:

- Escape: E_POINTER for NULL, DIERR_INVALIDPARAM unless dwSize is
  sizeof(DIEFFESCAPE), DIERR_NOTEXCLUSIVEACQUIRED for a force feedback device
  that is not exclusively acquired, otherwise DIERR_UNSUPPORTED (no device
  offers an escape command).
- SendDeviceData: DIERR_INVALIDPARAM for unknown flags and for devices without
  force feedback or of DirectInput 8; DI_OK for the force feedback devices of
  the older versions.

The todo_wine marks of those tests that now pass are removed.

---
diff --git a/dlls/dinput/device.c b/dlls/dinput/device.c
index e556acf..66ac2fa 100644
--- a/dlls/dinput/device.c
+++ b/dlls/dinput/device.c
@@ -1797,8 +1797,26 @@ static HRESULT WINAPI dinput_device_EnumCreatedEffectObjects( IDirectInputDevice
 
 static HRESULT WINAPI dinput_device_Escape( IDirectInputDevice8W *iface, DIEFFESCAPE *escape )
 {
-    FIXME( "iface %p, escape %p stub!\n", iface, escape );
+    struct dinput_device *impl = impl_from_IDirectInputDevice8W( iface );
+    HRESULT hr = DIERR_UNSUPPORTED;
+
+    TRACE( "iface %p, escape %p.\n", iface, escape );
+
+    if (!escape) return E_POINTER;
+    if (escape->dwSize != sizeof(*escape)) return DIERR_INVALIDPARAM;
+
+    /* no device offers an escape command: a force feedback device checks its acquisition first */
+    if (impl->caps.dwFlags & DIDC_FORCEFEEDBACK)
+    {
+        EnterCriticalSection( &impl->crit );
+        if (!is_exclusively_acquired( impl )) hr = DIERR_NOTEXCLUSIVEACQUIRED;
+        LeaveCriticalSection( &impl->crit );
+    }
+
+#ifdef SG_MUTANT_DINPUT_ESCAPE
     return DI_OK;
+#endif
+    return hr;
 }
 
 static HRESULT WINAPI dinput_device_Poll( IDirectInputDevice8W *iface )
@@ -1819,7 +1837,17 @@ static HRESULT WINAPI dinput_device_Poll( IDirectInputDevice8W *iface )
 static HRESULT WINAPI dinput_device_SendDeviceData( IDirectInputDevice8W *iface, DWORD size,
                                                     const DIDEVICEOBJECTDATA *data, DWORD *count, DWORD flags )
 {
-    FIXME( "iface %p, size %lu, data %p, count %p, flags %#lx stub!\n", iface, size, data, count, flags );
+    struct dinput_device *impl = impl_from_IDirectInputDevice8W( iface );
+
+    TRACE( "iface %p, size %lu, data %p, count %p, flags %#lx.\n", iface, size, data, count, flags );
+
+    if (flags & ~0x1 /* DISDD_CONTINUE */) return DIERR_INVALIDPARAM;
+
+    /* only the force feedback devices of the older DirectInput versions take data this way */
+#ifdef SG_MUTANT_DINPUT_SENDDATA
+    return DI_OK;
+#endif
+    if (!(impl->caps.dwFlags & DIDC_FORCEFEEDBACK) || impl->dinput->dwVersion >= 0x0800) return DIERR_INVALIDPARAM;
     return DI_OK;
 }
 
