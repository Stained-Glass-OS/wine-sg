+/* Stained Glass OS: the session's Linux programs' windows -- a terminal, any X
+ * program. They are top-levels of their own beside Wine's desktop window, so
+ * no shell hook reports them; the compositor lists them (sg-lockctl
+ * XWINDOWS: id, shown or minimized, focused, class, title), and each gets a
+ * button, behind a hidden stand-in window that holds its title. A click
+ * brings it forward, or minimizes it when it is in front (XACTIVATE,
+ * XMINIMIZE); its menu closes it (XCLOSE). */
+static const WCHAR sg_lockctl[] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-lockctl";
+
+static void sg_run_lockctl( const WCHAR *args )
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR cmd[MAX_PATH * 2], other[MAX_PATH];
+
+    /* SG_LOCKCTL names another (a Unix path): the gate's stand-in */
+    if (GetEnvironmentVariableW( L"SG_LOCKCTL", other, ARRAY_SIZE(other) ) && other[0] == '/')
+    {
+        WCHAR *p;
+        for (p = other; *p; p++) if (*p == '/') *p = '\\';
+        swprintf( cmd, ARRAY_SIZE(cmd), L"\\\\?\\unix%s %s", other, args );
+    }
+    else
+        swprintf( cmd, ARRAY_SIZE(cmd), L"%s %s", sg_lockctl, args );
+    if (CreateProcessW( NULL, cmd, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi ))
+    {
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+    }
+}
+
+static void sg_xwin_command( struct taskbar_button *win, const WCHAR *verb )
+{
+    WCHAR args[64];
+    swprintf( args, ARRAY_SIZE(args), L"%s %lu", verb, win->xwin );
+    sg_run_lockctl( args );
+}
+
+static HICON sg_xwin_icon( const WCHAR *class )
+{
+    HICON icon = NULL;
+    if (!wcscmp( class, L"SgRootTerminal" ))
+        ExtractIconExW( L"Z:\\usr\\libexec\\stained-glass\\shell\\sg-rootterm64.exe", 0, NULL, &icon, 1 );
+    else if (!wcsicmp( class, L"XTerm" ) || wcsstr( class, L"erminal" ))
+        ExtractIconExW( L"C:\\windows\\system32\\cmd.exe", 0, NULL, &icon, 1 );
+    return icon;
+}
+
+static void sg_sync_xwindows(void)
+{
+    static BOOL registered;
+    char list[8192], *line, *next;
+    struct taskbar_button *win, *next_win;
+    BOOL changed = FALSE;
+
+    WCHAR runtime[MAX_PATH], unix_list[MAX_PATH], dos_list[MAX_PATH + 8], args[MAX_PATH + 32], *p;
+    HANDLE file;
+    DWORD got = 0;
+
+    if (!GetEnvironmentVariableW( L"SG_LOCK_CONTROL", NULL, 0 )) return;   /* not in a session */
+    /* Wine hands a native program no pipe for its output: sg-lockctl writes
+     * the list to a file in the session's runtime directory, read at the next
+     * tick, when the next one is asked for */
+    if (!GetEnvironmentVariableW( L"XDG_RUNTIME_DIR", runtime, ARRAY_SIZE(runtime) ) || runtime[0] != '/') return;
+    swprintf( unix_list, ARRAY_SIZE(unix_list), L"%s/sg-taskbar-xwindows-%lu", runtime, GetCurrentProcessId() );
+    swprintf( dos_list, ARRAY_SIZE(dos_list), L"\\\\?\\unix%s", unix_list );
+    for (p = dos_list; *p; p++) if (*p == '/') *p = '\\';
+    list[0] = 0;
+    file = CreateFileW( dos_list, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        if (!ReadFile( file, list, sizeof(list) - 1, &got, NULL )) got = 0;
+        list[got] = 0;
+        CloseHandle( file );
+    }
+    swprintf( args, ARRAY_SIZE(args), L"XWINDOWS --out %s", unix_list );
+    sg_run_lockctl( args );
+    if (file == INVALID_HANDLE_VALUE) return;   /* the first tick: nothing yet */
+    if (!registered)
+    {
+        WNDCLASSW wc = { 0 };
+        wc.lpfnWndProc = DefWindowProcW;
+        wc.lpszClassName = L"SgLinuxWindow";
+        RegisterClassW( &wc );
+        registered = TRUE;
+    }
+    LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry ) win->xwin_seen = FALSE;
+    for (line = list; line && *line; line = next)
+    {
+        char state[16], focus[16], *tab;
+        unsigned long id;
+        WCHAR title[256], class[64];
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        if (!strcmp( line, "END" )) break;
+        if (!(tab = strchr( line, '\t' )) || sscanf( line, "%lu %15s %15s", &id, state, focus ) != 3) continue;
+        *tab = 0;
+        MultiByteToWideChar( CP_UTF8, 0, tab + 1, -1, title, ARRAY_SIZE(title) );
+        MultiByteToWideChar( CP_UTF8, 0, strrchr( line, ' ' ) + 1, -1, class, ARRAY_SIZE(class) );
+
+        LIST_FOR_EACH_ENTRY( win, &taskbar_buttons, struct taskbar_button, entry )
+            if (win->xwin == id) break;
+        if (&win->entry == &taskbar_buttons)
+        {
+            HWND stand_in = CreateWindowExW( WS_EX_TOOLWINDOW, L"SgLinuxWindow", title, WS_POPUP, 0, 0, 0, 0, 0, 0, 0, 0 );
+            if (!stand_in || !(win = calloc( 1, sizeof(*win) ))) { if (stand_in) DestroyWindow( stand_in ); continue; }
+            win->hwnd = stand_in;
+            win->xwin = id;
+            swprintf( win->exe, ARRAY_SIZE(win->exe), L"\\sg-linux\\%s", class );
+            win->exe_icon = sg_xwin_icon( class );
+            win->button = CreateWindowW( WC_BUTTONW, NULL, WS_CHILD | BS_OWNERDRAW, 0, 0, 0, 0,
+                                         tray_window, (HMENU)stand_in, 0, 0 );
+            list_add_tail( &taskbar_buttons, &win->entry );
+            changed = TRUE;
+        }
+        else
+        {
+            WCHAR old[256];
+            GetWindowTextW( win->hwnd, old, ARRAY_SIZE(old) );
+            if (wcscmp( old, title )) { SetWindowTextW( win->hwnd, title ); InvalidateRect( win->button, NULL, FALSE ); }
+        }
+        win->xwin_seen = TRUE;
+        if (win->xwin_focused != !strcmp( focus, "focused" ) || win->xwin_minimized != !strcmp( state, "minimized" ))
+        {
+            win->xwin_focused = !strcmp( focus, "focused" );
+            win->xwin_minimized = !strcmp( state, "minimized" );
+            InvalidateRect( win->button, NULL, FALSE );
+            changed = TRUE;
+        }
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( win, next_win, &taskbar_buttons, struct taskbar_button, entry )
+    {
+        if (!win->xwin || win->xwin_seen) continue;
+        list_remove( &win->entry );
+        DestroyWindow( win->button );
+        DestroyWindow( win->hwnd );
+        if (win->exe_icon) DestroyIcon( win->exe_icon );
+        free( win );
+        changed = TRUE;
+    }
+    if (changed) sync_taskbar_buttons();
+}
