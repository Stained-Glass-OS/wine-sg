From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: overlay handlers asked on a worker thread, views get overlays asynchronously

The file view asked the icon overlay handlers on its window thread while drawing, so OneDrive's IsMemberOf, which waits, left Explorer's window blank for good. As on Windows the handlers are now made and asked on a worker thread of their own (a single-threaded apartment that pumps its messages between jobs). The view asks the folder with OI_ASYNC, gets E_PENDING, shows no overlay, and the overlay is posted to it when the handlers answer. A caller that waits for an answer stops waiting after ten seconds, so a handler that never answers holds only the worker.
---
diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 8d70589..cdad3ab 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -31,6 +31,7 @@
 #include "winuser.h"
 #include "winreg.h"
 #include "wine/debug.h"
+#include "wine/list.h"
 
 #include "shellapi.h"
 #include "objbase.h"
@@ -1232,41 +1233,298 @@ static void overlays_apply(void)
     overlay_lists_made = shell_imagelists[0];
 }
 
-/* the overlay (1..15) of a file, from the handlers by priority; 0 when none marks it */
-int SHELL32_OverlayForPath( const WCHAR *path, DWORD attributes, int *image )
+/* Stained Glass OS 6251: as on Windows the handlers are never asked on a window's thread.
+ * One worker thread (a single-threaded apartment that pumps its messages between jobs) makes
+ * the handlers and asks them; a file view asks for an item's overlay with OI_ASYNC, gets
+ * E_PENDING, and the answer is posted to it when the handlers have given it.  OneDrive's
+ * IsMemberOf waited on Explorer's window thread and its window stayed blank (qa4 637).  A
+ * handler that never answers holds the worker only: views show no overlay, and a caller
+ * that asks and waits (IShellIconOverlay without OI_ASYNC) stops waiting after a while. */
+
+#define OVERLAY_WAIT_MS 10000
+
+enum overlay_job_kind { OVERLAY_JOB_LOAD, OVERLAY_JOB_PATH, OVERLAY_JOB_ITEM };
+
+struct overlay_job
+{
+    struct list entry;
+    LONG refs;
+    enum overlay_job_kind kind;
+    WCHAR *path;                    /* OVERLAY_JOB_PATH */
+    DWORD attributes;
+    IShellIconOverlay *folder;      /* OVERLAY_JOB_ITEM */
+    LPITEMIDLIST child;
+    HWND hwnd;                      /* the answer is posted to it ... */
+    UINT msg;
+    void *cookie;
+    void (*free_cookie)(void *);    /* ... or the cookie freed when it cannot be */
+    HANDLE done;                    /* set when answered, for a caller that waits */
+    int overlay, image;
+};
+
+static struct list overlay_jobs = LIST_INIT( overlay_jobs );
+static HANDLE overlay_wake;
+static DWORD overlay_tid;
+static BOOL overlays_ready;         /* the handlers are made (by the worker) */
+
+static void overlay_job_release( struct overlay_job *job )
+{
+    if (InterlockedDecrement( &job->refs )) return;
+    free( job->path );
+    if (job->folder) IShellIconOverlay_Release( job->folder );
+    ILFree( job->child );
+    if (job->done) CloseHandle( job->done );
+    free( job );
+}
+
+/* on the worker: the handlers made, their pictures in the shell's lists */
+static void overlays_ensure(void)
+{
+    if (!overlays_ready)
+    {
+        overlays_load();
+        EnterCriticalSection( &overlay_cs );
+        overlays_ready = TRUE;
+        LeaveCriticalSection( &overlay_cs );
+    }
+    EnterCriticalSection( &overlay_cs );
+    overlays_apply();
+    LeaveCriticalSection( &overlay_cs );
+}
+
+/* on the worker: ask the handlers by priority */
+static int overlay_ask( const WCHAR *path, DWORD attributes, int *image )
 {
     int best = 0, best_priority = INT_MAX;
     unsigned int i;
 
     if (image) *image = -1;
     if (!path || !path[0]) return 0;
-    EnterCriticalSection( &overlay_cs );
-    overlays_load();
-    overlays_apply();
+    overlays_ensure();
     for (i = 0; i < overlay_count; i++)
     {
         struct overlay_handler *h = &overlay_handlers[i];
 
+        DWORD start, took;
+        HRESULT hr;
+
         if (!h->obj || h->image < 0 || h->priority >= best_priority) continue;
-        if (IShellIconOverlayIdentifier_IsMemberOf( h->obj, path, attributes ) == S_OK)
+        start = GetTickCount();
+        hr = IShellIconOverlayIdentifier_IsMemberOf( h->obj, path, attributes );
+        if ((took = GetTickCount() - start) >= 1000)
+            WARN( "overlay handler %s took %lu ms for %s\n", debugstr_w(h->name), took, debugstr_w(path) );
+        if (hr == S_OK)
         {
             best = h->overlay;
             best_priority = h->priority;
             if (image) *image = h->image;
         }
     }
-    LeaveCriticalSection( &overlay_cs );
     return best;
 }
 
+static DWORD WINAPI overlay_worker( void *arg )
+{
+    struct overlay_job *job;
+    struct list *next;
+    MSG msg;
+
+    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    for (;;)
+    {
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE ))
+        {
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+        }
+        EnterCriticalSection( &overlay_cs );
+        if ((next = list_head( &overlay_jobs ))) list_remove( next );
+        LeaveCriticalSection( &overlay_cs );
+        if (!next)
+        {
+            MsgWaitForMultipleObjects( 1, &overlay_wake, FALSE, INFINITE, QS_ALLINPUT );
+            continue;
+        }
+        job = LIST_ENTRY( next, struct overlay_job, entry );
+        TRACE( "job %p kind %u path %s\n", job, job->kind, debugstr_w(job->path) );
+        switch (job->kind)
+        {
+        case OVERLAY_JOB_LOAD:
+            overlays_ensure();
+            break;
+        case OVERLAY_JOB_PATH:
+            job->overlay = overlay_ask( job->path, job->attributes, &job->image );
+            break;
+        case OVERLAY_JOB_ITEM:
+            job->overlay = 0;
+            if (IShellIconOverlay_GetOverlayIndex( job->folder, job->child, &job->overlay ) != S_OK)
+                job->overlay = 0;
+            break;
+        }
+        if (job->hwnd && (!IsWindow( job->hwnd ) ||
+                          !PostMessageW( job->hwnd, job->msg, (WPARAM)job->cookie, job->overlay )))
+            job->free_cookie( job->cookie );
+        if (job->done) SetEvent( job->done );
+        overlay_job_release( job );
+    }
+    return 0;
+}
+
+static BOOL overlay_queue( struct overlay_job *job )
+{
+    BOOL ok = TRUE;
+
+    EnterCriticalSection( &overlay_cs );
+    if (!overlay_wake)
+    {
+        HANDLE thread;
+        if ((overlay_wake = CreateEventW( NULL, FALSE, FALSE, NULL )) &&
+            (thread = CreateThread( NULL, 0, overlay_worker, NULL, 0, &overlay_tid )))
+            CloseHandle( thread );
+        else
+        {
+            if (overlay_wake) CloseHandle( overlay_wake );
+            overlay_wake = NULL;
+            ok = FALSE;
+        }
+    }
+    if (ok) list_add_tail( &overlay_jobs, &job->entry );
+    LeaveCriticalSection( &overlay_cs );
+    if (ok) SetEvent( overlay_wake );
+    return ok;
+}
+
+static BOOL on_overlay_worker(void)
+{
+    return overlay_tid && GetCurrentThreadId() == overlay_tid;
+}
+
+/* queue a job and wait for it a while; FALSE if it was not answered in time */
+static BOOL overlay_wait( struct overlay_job *job )
+{
+    BOOL answered;
+
+    job->refs = 2;
+    if (!(job->done = CreateEventW( NULL, TRUE, FALSE, NULL )) || !overlay_queue( job ))
+    {
+        job->refs = 1;
+        return FALSE;
+    }
+#ifndef SG_MUTANT_OVERLAY_WAIT_FOREVER
+    answered = WaitForSingleObject( job->done, OVERLAY_WAIT_MS ) == WAIT_OBJECT_0;
+#else
+    answered = WaitForSingleObject( job->done, INFINITE ) == WAIT_OBJECT_0;
+#endif
+    if (!answered) WARN( "the overlay handlers did not answer in %u ms\n", OVERLAY_WAIT_MS );
+    return answered;
+}
+
+/* the handlers made, for a caller that is not the worker */
+static BOOL overlays_wait_ready(void)
+{
+    struct overlay_job *job;
+    BOOL ready;
+
+    EnterCriticalSection( &overlay_cs );
+    ready = overlays_ready;
+    LeaveCriticalSection( &overlay_cs );
+    if (ready) return TRUE;
+    if (on_overlay_worker()) { overlays_ensure(); return TRUE; }
+    if (!(job = calloc( 1, sizeof(*job) ))) return FALSE;
+    job->kind = OVERLAY_JOB_LOAD;
+    overlay_wait( job );
+    overlay_job_release( job );
+    EnterCriticalSection( &overlay_cs );
+    ready = overlays_ready;
+    LeaveCriticalSection( &overlay_cs );
+    return ready;
+}
+
+/* the overlay (1..15) of a file, from the handlers by priority; 0 when none marks it.
+ * Asked on the worker; another thread waits for its answer a while. */
+int SHELL32_OverlayForPath( const WCHAR *path, DWORD attributes, int *image )
+{
+    struct overlay_job *job;
+    int overlay = 0;
+
+    if (image) *image = -1;
+    if (!path || !path[0]) return 0;
+#ifdef SG_MUTANT_OVERLAY_ON_CALLER
+    EnterCriticalSection( &overlay_cs );
+    overlays_load();
+    overlays_ready = TRUE;
+    overlays_apply();
+    LeaveCriticalSection( &overlay_cs );
+    {
+        int best = 0, best_priority = INT_MAX;
+        unsigned int i;
+        for (i = 0; i < overlay_count; i++)
+        {
+            struct overlay_handler *h = &overlay_handlers[i];
+            if (!h->obj || h->image < 0 || h->priority >= best_priority) continue;
+            if (IShellIconOverlayIdentifier_IsMemberOf( h->obj, path, attributes ) == S_OK)
+            {
+                best = h->overlay; best_priority = h->priority;
+                if (image) *image = h->image;
+            }
+        }
+        return best;
+    }
+#endif
+    if (on_overlay_worker()) return overlay_ask( path, attributes, image );
+    if (!(job = calloc( 1, sizeof(*job) ))) return 0;
+    job->kind = OVERLAY_JOB_PATH;
+    job->attributes = attributes;
+    job->image = -1;
+    if (!(job->path = wcsdup( path ))) { free( job ); return 0; }
+    if (overlay_wait( job ))
+    {
+        overlay = job->overlay;
+        if (image) *image = job->image;
+    }
+    overlay_job_release( job );
+    return overlay;
+}
+
+/* whether a caller should get E_PENDING for OI_ASYNC: always, except on the worker itself */
+BOOL SHELL32_OverlayIsSlow(void)
+{
+#ifdef SG_MUTANT_OVERLAY_ON_CALLER
+    return FALSE;
+#endif
+    return !on_overlay_worker();
+}
+
+/* ask a folder for an item's overlay on the worker; the answer is posted to HWND as
+ * MSG (wparam the cookie, lparam the overlay), or the cookie freed if it cannot be */
+BOOL SHELL32_OverlayRequest( IShellIconOverlay *folder, LPCITEMIDLIST child, HWND hwnd, UINT msg,
+                             void *cookie, void (*free_cookie)(void *) )
+{
+    struct overlay_job *job;
+
+    if (!(job = calloc( 1, sizeof(*job) ))) return FALSE;
+    job->kind = OVERLAY_JOB_ITEM;
+    job->refs = 1;
+    if (!(job->child = ILClone( child ))) { free( job ); return FALSE; }
+    job->folder = folder;
+    IShellIconOverlay_AddRef( folder );
+    job->hwnd = hwnd;
+    job->msg = msg;
+    job->cookie = cookie;
+    job->free_cookie = free_cookie;
+    if (overlay_queue( job )) return TRUE;
+    job->free_cookie = NULL;
+    overlay_job_release( job );
+    return FALSE;
+}
+
 /* the system image list index of an overlay (1..15), -1 when it has none */
 int SHELL32_OverlayImage( int overlay )
 {
     int image = -1;
 
+    if (!overlays_wait_ready()) return -1;
     EnterCriticalSection( &overlay_cs );
-    overlays_load();
-    overlays_apply();
     if (overlay >= 1 && overlay <= (int)overlay_count) image = overlay_handlers[overlay - 1].image;
     LeaveCriticalSection( &overlay_cs );
     return image;
@@ -1301,9 +1559,8 @@ INT WINAPI SHGetIconOverlayIndexW(LPCWSTR pszIconPath, INT iIconIndex)
 
   /* the reserved overlays (share, shortcut, slow file): a shortcut's arrow is drawn into its icon here */
   if (!pszIconPath) return -1;
+  if (!overlays_wait_ready()) return -1;
   EnterCriticalSection( &overlay_cs );
-  overlays_load();
-  overlays_apply();
   for (i = 0; i < overlay_count; i++)
       if (overlay_handlers[i].obj && overlay_handlers[i].icon_index == iIconIndex &&
           !wcsicmp( overlay_handlers[i].icon_file, pszIconPath ))
