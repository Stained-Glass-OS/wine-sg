+    if (bitmap->GetBitmapFromDC ? !bitmap->bitmap.hdc : !bitmap->bitmap.pDDS)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = video_mixer_validate_alpha_params(&bitmap->params)))
+        return hr;
+
+    /* Parameters that are not flagged have their documented defaults. */
+    params = bitmap->params;
+    if (!(params.dwFlags & MFVideoAlphaBitmap_SrcColorKey))
+        params.clrSrcKey = 0;
+    if (!(params.dwFlags & MFVideoAlphaBitmap_SrcRect))
+        SetRectEmpty(&params.rcSrc);
+    if (!(params.dwFlags & MFVideoAlphaBitmap_DestRect))
+    {
+        params.nrcDest.left = params.nrcDest.top = 0.0f;
+        params.nrcDest.right = params.nrcDest.bottom = 1.0f;
+    }
+    if (!(params.dwFlags & MFVideoAlphaBitmap_Alpha))
+        params.fAlpha = 1.0f;
+    if (!(params.dwFlags & MFVideoAlphaBitmap_FilterMode))
+        params.dwFilterMode = 0;
+
+    EnterCriticalSection(&mixer->cs);
+
+    video_mixer_clear_alpha_bitmap(mixer);
+    mixer->alpha_bitmap.params = params;
+    if (!bitmap->GetBitmapFromDC)
+    {
+        mixer->alpha_bitmap.surface = bitmap->bitmap.pDDS;
+        IDirect3DSurface9_AddRef(mixer->alpha_bitmap.surface);
+    }
+    mixer->alpha_bitmap.set = TRUE;
+
+    LeaveCriticalSection(&mixer->cs);
+
+    return S_OK;
 }
 
