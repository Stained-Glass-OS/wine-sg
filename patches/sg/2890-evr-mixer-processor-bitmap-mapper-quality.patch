+static HRESULT video_mixer_validate_alpha_params(const MFVideoAlphaBitmapParams *params)
+{
+    if (params->dwFlags & ~MFVideoAlphaBitmap_BitMask)
+        return E_INVALIDARG;
+
+    if ((params->dwFlags & MFVideoAlphaBitmap_Alpha) && !(params->fAlpha >= 0.0f && params->fAlpha <= 1.0f))
+        return E_INVALIDARG;
+
+    if (params->dwFlags & MFVideoAlphaBitmap_DestRect)
+    {
+        const MFVideoNormalizedRect *r = &params->nrcDest;
+
+        if (!(r->left >= 0.0f && r->top >= 0.0f && r->right <= 1.0f && r->bottom <= 1.0f
+                && r->left < r->right && r->top < r->bottom))
+            return E_INVALIDARG;
+    }
+
+    if ((params->dwFlags & MFVideoAlphaBitmap_SrcRect) && !(params->dwFlags & MFVideoAlphaBitmap_EntireDDS)
+            && (params->rcSrc.left < 0 || params->rcSrc.top < 0
+            || params->rcSrc.left >= params->rcSrc.right || params->rcSrc.top >= params->rcSrc.bottom))
+        return E_INVALIDARG;
+
+    return S_OK;
+}
