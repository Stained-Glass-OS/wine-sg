+static HRESULT video_mixer_check_types(const struct video_mixer *mixer)
+{
+    return (!mixer->inputs[0].media_type || !mixer->output.media_type) ? MF_E_TRANSFORM_TYPE_NOT_SET : S_OK;
+}
+
+static DXVA2_Fixed32 video_mixer_fixed32(int value, unsigned int hundredths)
+{
+    DXVA2_Fixed32 ret;
+
+    ret.ll = (LONG)(((unsigned int)value << 16) | ((hundredths * 65536 + 50) / 100));
+    return ret;
+}
+
+static HRESULT video_mixer_get_procamp_range(DWORD prop, DXVA2_ValueRange *range)
+{
+    switch (prop)
+    {
+        case DXVA2_ProcAmp_Brightness:
+            range->MinValue = video_mixer_fixed32(-100, 0);
+            range->MaxValue = video_mixer_fixed32(100, 0);
+            range->DefaultValue = video_mixer_fixed32(0, 0);
+            range->StepSize = video_mixer_fixed32(0, 1);
+            break;
+        case DXVA2_ProcAmp_Contrast:
+            range->MinValue = video_mixer_fixed32(0, 0);
+            range->MaxValue = video_mixer_fixed32(2, 0);
+            range->DefaultValue = video_mixer_fixed32(1, 0);
+            range->StepSize = video_mixer_fixed32(0, 1);
+            break;
+        case DXVA2_ProcAmp_Hue:
+            range->MinValue = video_mixer_fixed32(-180, 0);
+            range->MaxValue = video_mixer_fixed32(180, 0);
+            range->DefaultValue = video_mixer_fixed32(0, 0);
+            range->StepSize = video_mixer_fixed32(0, 1);
+            break;
+        case DXVA2_ProcAmp_Saturation:
+            range->MinValue = video_mixer_fixed32(0, 0);
+            range->MaxValue = video_mixer_fixed32(2, 0);
+            range->DefaultValue = video_mixer_fixed32(1, 0);
+            range->StepSize = video_mixer_fixed32(0, 1);
+            break;
+        default:
+            return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+static HRESULT video_mixer_get_filter_range(DWORD prop, DXVA2_ValueRange *range)
+{
+    if (prop < DXVA2_NoiseFilterLumaLevel || prop > DXVA2_DetailFilterChromaRadius)
+        return E_INVALIDARG;
+
+    range->MinValue = video_mixer_fixed32(0, 0);
+    range->MaxValue = video_mixer_fixed32(100, 0);
+    range->DefaultValue = video_mixer_fixed32(0, 0);
+    range->StepSize = video_mixer_fixed32(1, 0);
+    return S_OK;
+}
