+            HeapFree( GetProcessHeap(), 0, handle );
+        }
+        else if (info->magic == FIND_FIRST_MAGIC)
         {
             RtlEnterCriticalSection( &info->cs );
             if (info->magic == FIND_FIRST_MAGIC)  /* in case someone else freed it in the meantime */
