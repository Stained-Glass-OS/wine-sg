From: Stained Glass OS <dev@stained-glass.example>
Subject: kernelbase: FindFirstFileNameW, FindNextFileNameW

App-V's subsystems (Office) import FindNextFileNameW, which kernel32 did
not export; FindFirstFileNameW was a stub. A file's first name is its path
from its volume's root ("\windows\notepad.exe"; ERROR_MORE_DATA and the
length when the buffer is small); the file system is not asked for other
hard links, so FindNextFileNameW ends the list with ERROR_HANDLE_EOF.
FindClose takes the handle.

Gate: test/avl-gate.sh.
---
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -63,6 +63,13 @@
 
 #define FIND_FIRST_MAGIC  0xc0ffee11
 
+/* Stained Glass OS: a FindFirstFileNameW handle (the names of a file) */
+struct find_name_info
+{
+    DWORD magic;
+};
+#define FIND_NAME_MAGIC  0xc0ffee12
+
 static const UINT max_entry_size = offsetof( FILE_BOTH_DIRECTORY_INFORMATION, FileName[256] );
 
 const WCHAR windows_dir[] = L"C:\\windows";
@@ -1595,9 +1602,69 @@
  */
 HANDLE WINAPI FindFirstFileNameW( const WCHAR *file_name, DWORD flags, DWORD *len, WCHAR *link_name )
 {
-    FIXME( "(%s, %lu, %p, %p): stub!\n", debugstr_w(file_name), flags, len, link_name );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return INVALID_HANDLE_VALUE;
+    /* Stained Glass OS: a file's names (its hard links), as paths from its
+     * volume's root. The file's own is given; the file system here is not
+     * asked for others, so FindNextFileNameW ends the list (App-V's
+     * subsystems, which Office runs in, look for them). */
+    struct find_name_info *info;
+    WCHAR *full, *name;
+    DWORD size, need;
+
+    TRACE( "(%s, %lu, %p, %p)\n", debugstr_w(file_name), flags, len, link_name );
+
+    if (!file_name || !len || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+    if (GetFileAttributesW( file_name ) == INVALID_FILE_ATTRIBUTES) return INVALID_HANDLE_VALUE;
+    if (!(size = GetFullPathNameW( file_name, 0, NULL, NULL ))) return INVALID_HANDLE_VALUE;
+    if (!(full = HeapAlloc( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) return INVALID_HANDLE_VALUE;
+    GetFullPathNameW( file_name, size, full, NULL );
+    name = full;
+    if (name[0] && name[1] == ':') name += 2;                      /* C:\x -> \x */
+    else if (name[0] == '\\' && name[1] == '\\')                   /* \\server\share\x -> \x */
+    {
+        WCHAR *p = wcschr( name + 2, '\\' );
+        name = p ? wcschr( p + 1, '\\' ) : NULL;
+        if (!name) name = full + wcslen( full );
+    }
+    need = wcslen( name ) + 1;
+    if (*len < need || !link_name)
+    {
+        *len = need;
+        HeapFree( GetProcessHeap(), 0, full );
+        SetLastError( ERROR_MORE_DATA );
+        return INVALID_HANDLE_VALUE;
+    }
+    memcpy( link_name, name, need * sizeof(WCHAR) );
+    *len = need;
+    HeapFree( GetProcessHeap(), 0, full );
+    if (!(info = HeapAlloc( GetProcessHeap(), 0, sizeof(*info) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return INVALID_HANDLE_VALUE;
+    }
+    info->magic = FIND_NAME_MAGIC;
+    return info;
+}
+
+/**************************************************************************
+ *	FindNextFileNameW   (kernelbase.@)
+ */
+BOOL WINAPI FindNextFileNameW( HANDLE handle, DWORD *len, WCHAR *link_name )
+{
+    struct find_name_info *info = handle;
+
+    TRACE( "(%p, %p, %p)\n", handle, len, link_name );
+
+    if (!handle || handle == INVALID_HANDLE_VALUE || info->magic != FIND_NAME_MAGIC)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    SetLastError( ERROR_HANDLE_EOF );
+    return FALSE;
 }
 
 /**************************************************************************
