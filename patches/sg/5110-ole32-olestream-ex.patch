diff --git a/dlls/ole32/storage32.c b/dlls/ole32/storage32.c
--- a/dlls/ole32/storage32.c
+++ b/dlls/ole32/storage32.c
@@ -10405,17 +10405,94 @@
  *      and "\001OLE" streams.
  *
  */
-HRESULT WINAPI OleConvertIStorageToOLESTREAM (
-    LPSTORAGE pstg,
-    LPOLESTREAM pOleStream)
+/* The presentation object of OleConvertIStorageToOLESTREAMEx, built from the data the caller supplies
+ * instead of the presentation stream of the storage: a StandardPresentationObject of [MS-OLEDS]
+ * (2.2.2) -- class name "METAFILEPICT", "DIB" or "BITMAP", the width, the height times -1, the size
+ * and the data (a metafile's size counts 8 bytes more, the reserved METAFILEPICT16 in front of it). */
+static HRESULT OLECONVERT_GetExPresData(CLIPFORMAT cf, LONG width, LONG height, DWORD size, STGMEDIUM *medium,
+                                        OLECONVERT_OLESTREAM_DATA *pData)
+{
+    static const char strMetafilePict[] = "METAFILEPICT", strDib[] = "DIB", strBitmap[] = "BITMAP";
+    const char *name;
+    BYTE *bytes;
+    DWORD header = 0;
+
+    switch (cf)
+    {
+    case CF_METAFILEPICT:
+        name = strMetafilePict;
+#ifndef SG_MUTANT_OLESTREAM_META
+        header = 8;
+#endif
+        break;
+    case CF_DIB:          name = strDib; break;
+    case CF_BITMAP:       name = strBitmap; break;
+    default:
+        FIXME("clipboard format %#x not supported\n", cf);
+        return E_INVALIDARG;
+    }
+
+    if (medium->tymed != TYMED_HGLOBAL && medium->tymed != TYMED_ISTREAM)
+        return E_INVALIDARG;
+
+    if (!(bytes = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, header + size + 1)))
+        return E_OUTOFMEMORY;
+
+    if (medium->tymed == TYMED_HGLOBAL)
+    {
+        void *src;
+
+        if (!medium->hGlobal || GlobalSize(medium->hGlobal) < size || !(src = GlobalLock(medium->hGlobal)))
+        {
+            HeapFree(GetProcessHeap(), 0, bytes);
+            return E_INVALIDARG;
+        }
+        memcpy(bytes + header, src, size);
+        GlobalUnlock(medium->hGlobal);
+    }
+    else
+    {
+        ULONG read = 0;
+        HRESULT hr;
+
+        if (!medium->pstm || FAILED(hr = IStream_Read(medium->pstm, bytes + header, size, &read)) || read != size)
+        {
+            HeapFree(GetProcessHeap(), 0, bytes);
+            return E_INVALIDARG;
+        }
+    }
+
+    if (header)
+    {
+        /* the METAFILEPICT16 in front of the metafile: MM_ANISOTROPIC, the extents, no handle */
+        WORD pict[4] = { 8, width, height, 0 };
+        memcpy(bytes, pict, sizeof(pict));
+    }
+
+    HeapFree(GetProcessHeap(), 0, pData->pData);
+    pData->dwOleID = OLESTREAM_ID;
+    pData->dwTypeID = 5;
+    pData->dwOleTypeNameLength = strlen(name) + 1;
+    strcpy(pData->strOleTypeName, name);
+    pData->dwMetaFileWidth = width;
+#ifdef SG_MUTANT_OLESTREAM_HEIGHT
+    pData->dwMetaFileHeight = height;
+#else
+    pData->dwMetaFileHeight = -height;
+#endif
+    pData->dwDataLength = header + size;
+    pData->pData = bytes;
+    return S_OK;
+}
+
+static HRESULT OLECONVERT_ConvertToOLESTREAM(LPSTORAGE pstg, LPOLESTREAM pOleStream, CLIPFORMAT cf, LONG width,
+                                             LONG height, DWORD size, STGMEDIUM *medium)
 {
     int i;
     HRESULT hRes = S_OK;
     IStream *pStream;
     OLECONVERT_OLESTREAM_DATA pOleStreamData[2];
 
-    TRACE("%p %p\n", pstg, pOleStream);
-
     memset(pOleStreamData, 0, sizeof(pOleStreamData));
 
     if(pstg == NULL || pOleStream == NULL)
@@ -10444,8 +10521,14 @@
             OLECONVERT_GetOle20PresData(pstg, pOleStreamData);
         }
 
+        /* the caller's presentation data, if given, stands in for the one of the storage */
+        hRes = S_OK;
+        if(cf)
+            hRes = OLECONVERT_GetExPresData(cf, width, height, size, medium, &(pOleStreamData[1]));
+
         /* Save OLESTREAM */
-        hRes = OLECONVERT_SaveOLE10(&(pOleStreamData[0]), pOleStream);
+        if(hRes == S_OK)
+            hRes = OLECONVERT_SaveOLE10(&(pOleStreamData[0]), pOleStream);
         if(hRes == S_OK)
         {
             hRes = OLECONVERT_SaveOLE10(&(pOleStreamData[1]), pOleStream);
@@ -10462,6 +10545,15 @@
     return hRes;
 }
 
+HRESULT WINAPI OleConvertIStorageToOLESTREAM (
+    LPSTORAGE pstg,
+    LPOLESTREAM pOleStream)
+{
+    TRACE("%p %p\n", pstg, pOleStream);
+
+    return OLECONVERT_ConvertToOLESTREAM(pstg, pOleStream, 0, 0, 0, 0, NULL);
+}
+
 enum stream_1ole_flags {
     OleStream_LinkedObject = 0x00000001,
     OleStream_Convert      = 0x00000004
@@ -10473,9 +10565,12 @@
 HRESULT WINAPI OleConvertIStorageToOLESTREAMEx ( LPSTORAGE stg, CLIPFORMAT cf, LONG width, LONG height,
                                                  DWORD size, LPSTGMEDIUM medium, LPOLESTREAM olestream )
 {
-    FIXME("%p, %x, %ld, %ld, %ld, %p, %p: stub\n", stg, cf, width, height, size, medium, olestream);
+    TRACE("%p, %x, %ld, %ld, %ld, %p, %p\n", stg, cf, width, height, size, medium, olestream);
+
+    /* cf may be 0: then width, height, size and medium are not looked at */
+    if (cf && !medium) return E_INVALIDARG;
 
-    return E_NOTIMPL;
+    return OLECONVERT_ConvertToOLESTREAM(stg, olestream, cf, width, height, size, medium);
 }
 
