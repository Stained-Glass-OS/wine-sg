From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] conhost, server: Claude Code in a Terminal tab

David 2026-10-04, Claude Code in a Terminal tab: "the text and fonts were
jumbled", "everything typed had an underline as I typed", "after exiting
Claude the command line wasn't usable ... typing characters and hitting
enter didn't actually respond". Five causes, each seen with the real
Claude Code (2.1.289) in sg-terminal:

- CSI > 4;2 m (xterm's modifyOtherKeys) was taken for SGR 4;2: everything
  after it underlined and dim. CSI > 5 u and CSI < u (kitty's keyboard,
  pushed and popped) were taken for "restore the cursor": its drawing
  jumped to a stale place. The private forms with > = < are ignored now.
- SI (0x0F, with ESC ( B) was drawn as a character; control characters
  are not drawn while escape sequences are on.
- The tab's colours: from light grey on a colour back to plain light grey
  the console said nothing, so the colour ran on in the tab (its diff's
  green over the rest of the line and the next). Every part that changes
  is said now; the console's defaults as the terminal's own (39, 49, m).
- Ctrl+C from the tab ended the console's reading of keys unless the
  console was a Unix terminal: the tab took no more typing, or closed with
  everything in it. It is now as Windows': a Ctrl+C event with processed
  input, a key the program reads in raw mode (Claude Code, PSReadLine).
- Claude Code's last act is a line read; its process ends with it
  waiting. The console kept serving that read, and the next line typed
  went to no one -- the shell's prompt took no command. wineserver now
  says when a read's reader has gone (STATUS_CANCELLED to the host, and
  wakes it for the reads that waited behind), and the console keeps the
  line for the next reader.

Test: test/claudecon-gate.sh with test/claudecon-probe.c (mutants
SG_MUTANT_VT_PRIVATE_AS_SGR, SG_MUTANT_VT_PRINTS_C0,
SG_MUTANT_TTY_BG_STICKS, SG_MUTANT_CTRLC_ENDS_INPUT,
SG_MUTANT_DEAD_READ_EATS_INPUT).
---
--- a/programs/conhost/conhost.c
+++ b/programs/conhost/conhost.c
@@ -268,7 +268,57 @@
 
 static void set_tty_attr( struct console *console, unsigned int attr )
 {
-    char buf[8];
+    char buf[32];
+    unsigned int old = console->tty_attr;
+
+#ifndef SG_MUTANT_TTY_BG_STICKS
+    /* Stained Glass OS: every part that changed is said -- the console's
+     * default colours (light grey on black) as the terminal's own (39, 49).
+     * Grey on a colour back to plain grey said nothing before: the colour
+     * stayed in the terminal for the rest of the line and the next one
+     * (Claude Code's diff, David 2026-10-04). */
+    if ((attr & 0xc0ff) == (old & 0xc0ff)) { console->tty_attr = attr; return; }
+    if ((attr & 0xc0ff) == 7)
+    {
+        tty_write( console, "\x1b[m", 3 );
+        console->tty_attr = attr;
+        return;
+    }
+    if ((attr & 0x0f) != (old & 0x0f))
+    {
+        unsigned int n = 30;
+        if ((attr & 0x0f) == 7) n = 39;
+        else
+        {
+            if (attr & FOREGROUND_BLUE)  n += 4;
+            if (attr & FOREGROUND_GREEN) n += 2;
+            if (attr & FOREGROUND_RED)   n += 1;
+            if (attr & FOREGROUND_INTENSITY) n += 60;
+        }
+        sprintf( buf, "\x1b[%um", n );
+        tty_write( console, buf, strlen(buf) );
+    }
+    if ((attr & 0xf0) != (old & 0xf0))
+    {
+        unsigned int n = 40;
+        if (!(attr & 0xf0)) n = 49;
+        else
+        {
+            if (attr & BACKGROUND_BLUE)  n += 4;
+            if (attr & BACKGROUND_GREEN) n += 2;
+            if (attr & BACKGROUND_RED)   n += 1;
+            if (attr & BACKGROUND_INTENSITY) n += 60;
+        }
+        sprintf( buf, "\x1b[%um", n );
+        tty_write( console, buf, strlen(buf) );
+    }
+    if ((attr & COMMON_LVB_UNDERSCORE) != (old & COMMON_LVB_UNDERSCORE))
+        tty_write( console, (attr & COMMON_LVB_UNDERSCORE) ? "\x1b[4m" : "\x1b[24m", (attr & COMMON_LVB_UNDERSCORE) ? 4 : 5 );
+    if ((attr & COMMON_LVB_REVERSE_VIDEO) != (old & COMMON_LVB_REVERSE_VIDEO))
+        tty_write( console, (attr & COMMON_LVB_REVERSE_VIDEO) ? "\x1b[7m" : "\x1b[27m", (attr & COMMON_LVB_REVERSE_VIDEO) ? 4 : 5 );
+    console->tty_attr = attr;
+#else
+
 
     if ((attr & 0x0f) != (console->tty_attr & 0x0f))
     {
@@ -312,6 +362,7 @@
     }
 
     console->tty_attr = attr;
+#endif
 }
 
 static void tty_sync( struct console *console )
@@ -490,7 +541,7 @@
         status = wine_server_call( req );
     }
     SERVER_END_REQ;
-    if (status && (console->read_ioctl || status != STATUS_INVALID_HANDLE)) ERR( "failed: %#lx\n", status );
+    if (status && status != STATUS_CANCELLED && (console->read_ioctl || status != STATUS_INVALID_HANDLE)) ERR( "failed: %#lx\n", status );
     console->signaled = signal;
     console->read_ioctl = 0;
     console->pending_read = 0;
@@ -503,8 +554,9 @@
 
     TRACE("count %Iu\n", count);
 
-    read_complete( console, STATUS_SUCCESS, console->records, count * sizeof(*console->records),
-                   console->record_count > count );
+    /* a reader gone (STATUS_CANCELLED): the records stay for the next one */
+    if (read_complete( console, STATUS_SUCCESS, console->records, count * sizeof(*console->records),
+                       console->record_count > count ) == STATUS_CANCELLED) return STATUS_SUCCESS;
 
     if (count < console->record_count)
         memmove( console->records, console->records + count,
@@ -523,8 +575,10 @@
     case IOCTL_CONDRV_READ_CONSOLE:
     case IOCTL_CONDRV_READ_CONSOLE_CONTROL:
         out_size = min( out_size, console->read_buffer_count * sizeof(WCHAR) );
-        read_complete( console, STATUS_SUCCESS, console->read_buffer, out_size, console->record_count != 0 );
         read_len = out_size / sizeof(WCHAR);
+        /* a reader gone: the line stays for the next one (the shell's) */
+        if (read_complete( console, STATUS_SUCCESS, console->read_buffer, out_size,
+                           console->record_count != 0 ) == STATUS_CANCELLED) read_len = 0;
         break;
     case IOCTL_CONDRV_READ_FILE:
         read_len = len = 0;
@@ -543,7 +597,7 @@
             WideCharToMultiByte( console->input_cp, 0, console->read_buffer, read_len, buf, len, NULL, NULL );
         }
         len = min( out_size, len );
-        read_complete( console, STATUS_SUCCESS, buf, len, console->record_count != 0  );
+        if (read_complete( console, STATUS_SUCCESS, buf, len, console->record_count != 0 ) == STATUS_CANCELLED) read_len = 0;
         free( buf );
         break;
     }
@@ -1799,6 +1853,16 @@
             switch (ch)
             {
             case 3: /* end of text */
+#ifndef SG_MUTANT_CTRLC_ENDS_INPUT
+                /* Stained Glass OS: Ctrl+C as Windows' console has it -- with
+                 * processed input a Ctrl+C event (write_console_input), in
+                 * raw mode (Claude Code, PSReadLine) a key the program reads.
+                 * It ended the reading of keys: a Terminal tab's console
+                 * took no more typing, or closed with everything in it
+                 * (David 2026-10-04, after Claude Code). */
+                key_press( console, ch, 'C', LEFT_CTRL_PRESSED );
+                break;
+#else
                 if (console->is_unix && (console->mode & ENABLE_PROCESSED_INPUT))
                 {
                     key_press( console, ch, 'C', LEFT_CTRL_PRESSED );
@@ -1806,6 +1870,7 @@
                 }
                 LeaveCriticalSection( &console_section );
                 goto done;
+#endif
             case '\n':
                 key_press( console, '\n', VK_RETURN, LEFT_CTRL_PRESSED );
                 break;
@@ -1840,7 +1905,9 @@
 
     TRACE( "NtReadFile failed: %#lx\n", status );
 
+#ifdef SG_MUTANT_CTRLC_ENDS_INPUT
 done:
+#endif
     EnterCriticalSection( &console_section );
     /* paused (the terminal handed to a Unix program): a pending read waits
      * for the terminal to come back, and the pause has restored it already */
@@ -2308,6 +2375,16 @@
     int a;
 
     if (i < len - 1 && (seq[i] == '?' || seq[i] == '>' || seq[i] == '=')) { private = seq[i] == '?'; i++; }
+#ifndef SG_MUTANT_VT_PRIVATE_AS_SGR
+    /* Stained Glass OS: the other private forms -- CSI > Ps;Ps m (xterm's
+     * modifyOtherKeys), CSI > flags u / CSI < u (kitty's keyboard, pushed and
+     * popped), CSI > c, CSI = c -- are none of the plain ones: Claude Code's
+     * CSI > 4;2 m was taken for SGR 4;2 (everything after it underlined and
+     * dim) and its CSI > 5 u, CSI < u for "restore the cursor" (its drawing
+     * jumbled; David 2026-10-04). Not done here: ignored, as by terminals
+     * without them. */
+    if (len > 1 && (seq[0] == '>' || seq[0] == '=' || seq[0] == '<')) return;
+#endif
     for (; i < len - 1; i++)
     {
         if (seq[i] >= '0' && seq[i] <= '9') { if (n < 16) p[n] = p[n] * 10 + (seq[i] - '0'); have = TRUE; }
@@ -2582,6 +2659,12 @@
         }
         if (screen_buffer->cursor_x == screen_buffer->width && !(screen_buffer->mode & ENABLE_WRAP_AT_EOL_OUTPUT))
             screen_buffer->cursor_x = update_rect.left;
+#ifndef SG_MUTANT_VT_PRINTS_C0
+        /* Stained Glass OS: with escape sequences on, the other control
+         * characters are not characters -- Claude Code's SI (0x0F, with its
+         * ESC ( B) showed as a glyph where its cursor was */
+        if ((screen_buffer->mode & ENABLE_VIRTUAL_TERMINAL_PROCESSING) && buffer[i] < 0x20) continue;
+#endif
         if (buffer[i] >= 0x20) screen_buffer->vt_last = buffer[i];
         write_char( screen_buffer, buffer[i], &update_rect, NULL );
     }
--- a/server/console.c
+++ b/server/console.c
@@ -1575,6 +1575,7 @@
     {
         struct async *async = ioctl->async;
         unsigned int status = req->status;
+        int gone = 0;
 
         if (status == STATUS_PENDING) status = STATUS_INVALID_PARAMETER;
         if (async)
@@ -1586,6 +1587,14 @@
                 data_size_t result = ioctl->code == IOCTL_CONDRV_WRITE_FILE ? iosb->in_size : out_size;
                 async_request_complete_alloc( async, status, result, out_size, get_req_data() );
             }
+#ifndef SG_MUTANT_DEAD_READ_EATS_INPUT
+            /* Stained Glass OS: the reader is gone (its process ended while it
+             * waited -- Claude Code's last read): what the console read for it
+             * was taken by no one. Say so, and the console keeps it for the
+             * next reader -- the shell's prompt took no typing (David
+             * 2026-10-04) */
+            else if (req->read && !status && get_req_data_size()) gone = 1;
+#endif
 
             release_object( async );
         }
@@ -1594,6 +1603,11 @@
 
         if (req->read)
         {
+            if (gone) set_error( STATUS_CANCELLED );
+#ifndef SG_MUTANT_DEAD_READ_EATS_INPUT
+            /* reads that waited behind this one are the host's to serve now */
+            if (!list_empty( &server->queue )) wake_up( &server->obj, 0 );
+#endif
             release_object( server );
             return;
         }
