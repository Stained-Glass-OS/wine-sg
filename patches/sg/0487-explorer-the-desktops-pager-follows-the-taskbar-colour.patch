From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: the desktops pager follows the taskbar's colour

The pager's desktops (0446) were dark grey cells with grey edges on any
bar -- holes in a light taskbar (the light mode, or 0484's light and light
blue colours). A desktop's cell is now a little of the text colour on the
bar's, its edge more, so they read on every taskbar colour.

Gate: test/darkmode-gate.sh (the pager's cell on the light bar).
---
--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -1270,12 +1270,19 @@
 
 static void pager_paint( HWND hwnd, HDC dc )
 {
-    COLORREF bar, hover, text, accent = taskbar_accent();
+    COLORREF bar, hover, text, cell, edge, accent = taskbar_accent();
     HWND list[256] = {0};
     RECT client, box;
     int d, i;
 
     taskbar_colors( &bar, &hover, &text );
+    /* a desktop's cell and edge: a little and more of the text on the bar, so
+     * they read on every taskbar colour (a fixed dark grey was a hole in a
+     * light bar) */
+    cell = RGB( (GetRValue(bar) * 85 + GetRValue(text) * 15) / 100, (GetGValue(bar) * 85 + GetGValue(text) * 15) / 100,
+                (GetBValue(bar) * 85 + GetBValue(text) * 15) / 100 );
+    edge = RGB( (GetRValue(bar) * 65 + GetRValue(text) * 35) / 100, (GetGValue(bar) * 65 + GetGValue(text) * 35) / 100,
+                (GetBValue(bar) * 65 + GetBValue(text) * 35) / 100 );
     GetClientRect( hwnd, &client );
     fill( dc, &client, bar );
     EnumWindows( mini_collect, (LPARAM)list );
@@ -1284,10 +1291,10 @@
         struct mini m = { &box, d, dc };
 
         pager_box( &client, d, &box );
-        fill( dc, &box, d == vd_current ? accent : d == pager_hot ? hover : RGB(0x40,0x40,0x40) );
+        fill( dc, &box, d == vd_current ? accent : d == pager_hot ? hover : cell );
         for (i = 0; list[i]; i++) ;
         while (i--) mini_proc( list[i], (LPARAM)&m );
-        frame( dc, &box, d == vd_current ? accent : d == pager_hot ? text : RGB(0x70,0x70,0x70), 1 );
+        frame( dc, &box, d == vd_current ? accent : d == pager_hot ? text : edge, 1 );
     }
 }
 
