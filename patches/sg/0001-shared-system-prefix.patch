 /* handle a socket event */
+/* Is this uid a member of the group that owns the shared server directory?
+ *
+ * SO_PEERCRED reports only the peer's primary group, and in practice a user is
+ * admitted to a shared prefix through a supplementary group, so ask the system
+ * for the full list rather than trusting cred.gid. */
+static int uid_in_group( uid_t uid, gid_t gid )
+{
+    struct passwd *pw = getpwuid( uid );
+    gid_t stack[32], *groups = stack;
+    int i, count = ARRAY_SIZE(stack), ret = 0;
+
+    if (!pw) return 0;
+    if (pw->pw_gid == gid) return 1;
+
+    if (getgrouplist( pw->pw_name, pw->pw_gid, groups, &count ) == -1)
+    {
+        /* count now holds the number actually needed */
+        if (!(groups = malloc( count * sizeof(*groups) ))) return 0;
+        if (getgrouplist( pw->pw_name, pw->pw_gid, groups, &count ) == -1) count = 0;
+    }
+    for (i = 0; i < count; i++) if (groups[i] == gid) { ret = 1; break; }
+
+    if (groups != stack) free( groups );
+    return ret;
+}
+
+/* Decide whether a connecting process may use this server.
+ *
+ * On an ordinary prefix this is not reached as a decision: the 0700 directory
+ * and the 0600 socket already make the answer constant, so the peer is
+ * necessarily the owner. On a shared prefix those checks have been relaxed and
+ * this is what replaces them -- it is the whole access control for the machine,
+ * and should be read as such.
+ *
+ * Admitted: root, the owner of the server directory, and members of the group
+ * owning it. Which users that group contains is an administrative decision,
+ * expressed with ordinary Unix tools rather than a policy file of our own. */
+static int check_peer_credentials( int client )
+{
+    struct ucred cred;
+    socklen_t len = sizeof(cred);
+
+    if (!system_prefix) return 1;
+
+    if (getsockopt( client, SOL_SOCKET, SO_PEERCRED, &cred, &len ) == -1)
+    {
+        /* Without credentials there is no basis on which to admit anyone. */
+        fprintf( stderr, "wineserver: cannot read peer credentials, refusing connection\n" );
+        return 0;
+    }
+    if (cred.uid == 0 || cred.uid == server_dir_uid) return 1;
+    if (uid_in_group( cred.uid, server_dir_gid )) return 1;
+
+    fprintf( stderr, "wineserver: refusing connection from uid %u: not a member of gid %u\n",
+             (unsigned int)cred.uid, (unsigned int)server_dir_gid );
+    return 0;
+}
+
 static void master_socket_poll_event( struct fd *fd, int event )
 {
     struct master_socket *sock = get_fd_user( fd );
