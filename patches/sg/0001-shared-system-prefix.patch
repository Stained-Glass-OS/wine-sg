+ * process that starts it. So this detection has to agree exactly with
+ * server/request.c's. Patching one side only produces a mismatch that reads as
+ * "chdir to /tmp/.wine-<uid>/server-<dev>-<ino>: No such file or directory",
+ * which points at neither the cause nor the file to fix. */
+static int system_prefix;
