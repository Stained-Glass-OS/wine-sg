+/* Stained Glass OS: a "system prefix" is one shared by several Unix users on
+ * the same machine, rather than belonging to whoever created it.
+ *
+ * Wine's default is the opposite, and deliberately so: the prefix and the
+ * server directory must be owned by the calling user and unreadable by anyone
+ * else, and the socket is chmod 0600. Those three checks together are what
+ * stops one user reaching another's wineserver, and nothing else in the server
+ * does that job -- there is no authentication anywhere, because none has been
+ * needed.
+ *
+ * Shared mode is opt-in, marked by a file in the prefix, so ordinary Wine
+ * prefixes keep the stricter behaviour untouched. Where this relaxes a check,
+ * the peer-credential check in master_socket_poll_event() takes over; the two
+ * belong together and neither is safe alone.
+ */
+static int system_prefix;        /* nonzero if the prefix is marked shared */
+static gid_t config_dir_gid;     /* group owning the shared prefix */
+static uid_t server_dir_uid;     /* owner of the shared server directory */
+static gid_t server_dir_gid;     /* group allowed to use the shared prefix */
+
+/* name of the marker file that opts a prefix into shared mode */
+static const char * const system_prefix_marker = ".sg-system-prefix";
