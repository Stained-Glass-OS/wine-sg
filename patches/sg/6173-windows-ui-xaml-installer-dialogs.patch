+    L"Windows.UI.Xaml.XamlRoot", xaml_root_ifaces, ARRAY_SIZE(xaml_root_ifaces), xaml_root_destroy,
+};
+
+static struct xaml_root *xaml_root_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct xaml_root, obj );
+}
+
+static FLOAT xaml_root_scale( struct xaml_root *root )
+{
+    UINT dpi = root->window ? GetDpiForWindow( root->window ) : 96;
+    return dpi ? dpi / 96.0f : 1.0f;
+}
+
+static HRESULT WINAPI xaml_root_get_Content( struct xiface *iface, IInspectable **value )
+{
+    struct xaml_root *root = xaml_root_from_iface( iface );
+    if (!value) return E_POINTER;
+    if ((*value = root->window ? root->content : NULL)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI xaml_root_get_Size( struct xiface *iface, struct xsize_f *value )
+{
+    struct xaml_root *root = xaml_root_from_iface( iface );
+    RECT rc = { 0 };
+
+    if (!value) return E_POINTER;
+    if (root->window) GetClientRect( root->window, &rc );
+    value->Width = rc.right / xaml_root_scale( root );
+    value->Height = rc.bottom / xaml_root_scale( root );
+    return S_OK;
+}
+
+static HRESULT WINAPI xaml_root_get_RasterizationScale( struct xiface *iface, DOUBLE *value )
+{
