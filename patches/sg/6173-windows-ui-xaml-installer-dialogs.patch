+static void append_found( struct uielem *elem, void *context )
+{
+    IInspectable *vector = context;
+    ((HRESULT (WINAPI *)( IInspectable *, IInspectable * ))((void **)vector->lpVtbl)[13])( vector, uielem_iface( elem ) );
+}
+
+static HRESULT elements_at( FLOAT x, FLOAT y, IInspectable *subtree, IInspectable **value )
+{
+    struct uielem *root = subtree ? uielem_from_inspectable( subtree ) : NULL;
+    struct xvector *vector;
+    FLOAT ox = 0, oy = 0;
+    struct uielem *e;
+
+    if (!value) return E_POINTER;
+    if (FAILED(xvector_create( &elements_type, NULL, &vector ))) return E_OUTOFMEMORY;
+    *value = xvector_iface( vector );
+    if (!root) return S_OK;
+    /* host coordinates are the root's: the subtree's own origin taken off */
+    for (e = root->parent; e; e = e->parent) { ox += e->offset.x; oy += e->offset.y; }
+    xaml_hit_test_all( root, x - ox, y - oy, append_found, *value );
+    return S_OK;
+}
