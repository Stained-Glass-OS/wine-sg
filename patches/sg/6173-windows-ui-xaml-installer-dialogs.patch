+static HRESULT WINAPI vth_GetChild( struct xfiface *iface, IInspectable *reference, INT32 index, IInspectable **value )
+{
+    struct uielem *elem = uielem_from_inspectable( reference ), *child;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!elem) return E_INVALIDARG;
+#ifdef SG_MUTANT_XAML_VTH_NO_CHILDREN
+    return E_INVALIDARG;
+#endif
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+        if (!index--) return IUnknown_QueryInterface( child->d.obj.outer, &IID_IDependencyObject, (void **)value );
+    return E_INVALIDARG;
+}
