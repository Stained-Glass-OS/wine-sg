+struct canvas
+{
+    struct panel p;
+    struct xiface ICanvas_iface;
+};
+
+static DOUBLE canvas_coord( struct uielem *child, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( &child->d, prop, &box );
+    ret = xunbox_double( box, 0 );
+    if (box) IInspectable_Release( box );
+    return isnan( ret ) ? 0 : ret;
+}
+
+static void canvas_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct xsize infinite = { INFINITY, INFINITY };
+    struct uielem *child;
+
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) uielem_measure( child, infinite );
+    desired->width = desired->height = 0;   /* a Canvas asks for no room of its own */
+}
+
+static void canvas_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct uielem *child;
+
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+    {
+        struct xrect rect = { canvas_coord( child, prop_canvas_left ), canvas_coord( child, prop_canvas_top ),
+                              child->desired.width, child->desired.height };
+#ifdef SG_MUTANT_CANVAS_NO_PLACE
+        rect.x = rect.y = 0;
+#endif
+        uielem_arrange( child, rect );
+    }
+    *used = final;
+}
+
+static const struct elem_ops canvas_ops = { canvas_measure, canvas_arrange, panel_render };
+
+static const void *canvas_vtbl[] = { ICanvas_STUBS };
