+static const void *scalar_transition_vtbl[] =
+{
+    IScalarTransition_STUBS,
+    [IScalarTransition_Duration] = scalar_transition_get_Duration,
+    [IScalarTransition_SetDuration] = scalar_transition_put_Duration,
+};
+
+static HRESULT WINAPI scalar_transition_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner,
+                                                                void **value )
+{
+    struct scalar_transition *t;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(t = calloc( 1, sizeof(*t) ))) return E_OUTOFMEMORY;
+    t->IScalarTransition_iface.vtbl = scalar_transition_vtbl;
+    t->duration = 1500000;   /* 150 ms */
+    xobj_init( &t->obj, &scalar_transition_class, outer );
+    if (outer)
+    {
+        *inner = &t->obj.IInspectable_inner;
+        IUnknown_AddRef( t->obj.outer );
+    }
+    *value = &t->IScalarTransition_iface;
+    return S_OK;
+}
