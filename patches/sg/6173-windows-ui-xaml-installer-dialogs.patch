+static const struct xclass scalar_transition_class =
+{
+    L"Windows.UI.Xaml.ScalarTransition", scalar_transition_ifaces, ARRAY_SIZE(scalar_transition_ifaces), NULL,
+};
+
+static HRESULT WINAPI scalar_transition_get_Duration( struct xiface *iface, INT64 *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct scalar_transition, obj )->duration;
+    return S_OK;
+}
+
+static HRESULT WINAPI scalar_transition_put_Duration( struct xiface *iface, INT64 value )
+{
+    CONTAINING_RECORD( iface->obj, struct scalar_transition, obj )->duration = value;
+    return S_OK;
+}
