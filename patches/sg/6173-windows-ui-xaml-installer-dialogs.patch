+static const struct xiface_entry canvas_ifaces[] =
+{
+    { &IID_ICanvas, offsetof(struct canvas, ICanvas_iface) },
+    PANEL_IFACES,
+};
+
+static void canvas_destroy( struct xobj *obj )
+{
+    panel_cleanup( &CONTAINING_RECORD( obj, struct canvas, p.e.d.obj )->p );
+}
+
+static const struct xclass canvas_class =
+{
+    L"Windows.UI.Xaml.Controls.Canvas", canvas_ifaces, ARRAY_SIZE(canvas_ifaces), canvas_destroy,
+};
+
+static void canvas_init( struct canvas *canvas, IInspectable *outer )
+{
+    panels_init();
+    canvas->ICanvas_iface.vtbl = canvas_vtbl;
+    panel_init( &canvas->p, &canvas_class, &canvas_ops, outer );
+}
+
+#define e_obj p.e.d.obj
+COMPOSABLE_CREATE(canvas_factory_CreateInstance, struct canvas, canvas_init( obj, outer ), ICanvas_iface)
+#undef e_obj
+
+static HRESULT canvas_get( IInspectable *element, struct xaml_property *prop, IInspectable **box )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+
+    panels_init();
+    *box = NULL;
