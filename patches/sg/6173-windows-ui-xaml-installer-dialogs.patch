+/*
+ * A KeyboardAccelerator (Key, Modifiers, IsEnabled, ScopeOwner, Invoked) in an element's
+ * KeyboardAccelerators runs when its keys are pressed while the focus is in that element's subtree
+ * (or anywhere in its island when it has no ScopeOwner limits): Invoked is raised, and unless it is
+ * handled a button clicks and anything else that takes the keyboard takes the focus.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const GUID IID_IVector_KeyboardAccelerator = { 0xe4927feb, 0x1e4a, 0x5be3, { 0xbd, 0xa3, 0x62, 0xcf, 0x4e, 0x52, 0x02, 0x58 } };
+static const GUID IID_IVectorView_KeyboardAccelerator = { 0x4d5e3d08, 0xe27c, 0x5d05, { 0xa1, 0xdc, 0x98, 0x85, 0xa5, 0x1c, 0x37, 0x21 } };
+static const GUID IID_IIterable_KeyboardAccelerator = { 0xaf1e5ff1, 0xd518, 0x5521, { 0xb4, 0x0e, 0x6f, 0x52, 0x4d, 0x04, 0xc1, 0x29 } };
+static const GUID IID_IIterator_KeyboardAccelerator = { 0x8b6ac198, 0xeaa0, 0x50e6, { 0x9a, 0x35, 0x32, 0xdf, 0xdf, 0x1f, 0x59, 0xe1 } };
+
+static struct xaml_property *prop_key, *prop_modifiers, *prop_enabled, *prop_scope_owner;
+
+struct accelerator
+{
+    struct dobj d;
+    struct xiface IKeyboardAccelerator_iface;
+    struct handler_list invoked;
+};
+
+static const struct xiface_entry accelerator_ifaces[] =
+{
+    { &IID_IKeyboardAccelerator, offsetof(struct accelerator, IKeyboardAccelerator_iface) },
+    DOBJ_IFACES(struct dobj),   /* the dobj is first */
+};
+
+static void accelerator_destroy( struct xobj *obj )
+{
+    struct accelerator *acc = CONTAINING_RECORD( obj, struct accelerator, d.obj );
+    handlers_clear( &acc->invoked );
+    dobj_cleanup( &acc->d );
+}
+
+static const struct xclass accelerator_class =
+{
+    L"Windows.UI.Xaml.Input.KeyboardAccelerator", accelerator_ifaces, ARRAY_SIZE(accelerator_ifaces), accelerator_destroy,
+};
+
+static BOOL WINAPI init_accelerators( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR ka[] = L"Windows.UI.Xaml.Input.KeyboardAccelerator";
+    prop_key = xaml_property_register( ka, L"Key", L"Windows.System.VirtualKey", xbox_int32( 0 ), FALSE, NULL );
+    prop_modifiers = xaml_property_register( ka, L"Modifiers", L"Windows.System.VirtualKeyModifiers", xbox_int32( 0 ), FALSE, NULL );
+    prop_enabled = xaml_property_register( ka, L"IsEnabled", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
+    prop_scope_owner = xaml_property_register( ka, L"ScopeOwner", L"Windows.UI.Xaml.DependencyObject", NULL, FALSE, NULL );
+    return TRUE;
+}
+
+static void accelerators_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_accelerators, NULL, NULL );
+}
+
+static struct accelerator *acc_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct accelerator, d.obj );
+}
+
+static INT32 get_int( struct dobj *d, struct xaml_property *prop, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+    dobj_get_value( d, prop, &box );
+    ret = xunbox_enum( box, NULL, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+#define INT_PROP(name, prop) \
+static HRESULT WINAPI acc_get_##name( struct xiface *iface, INT32 *value ) \
+{ if (!value) return E_POINTER; *value = get_int( &acc_from_iface( iface )->d, prop, 0 ); return S_OK; } \
+static HRESULT WINAPI acc_put_##name( struct xiface *iface, INT32 value ) \
+{ IInspectable *box = xbox_int32( value ); HRESULT hr; if (!box) return E_OUTOFMEMORY; \
+  hr = dobj_set_value( &acc_from_iface( iface )->d, prop, box ); IInspectable_Release( box ); return hr; }
+
+INT_PROP(Key, prop_key)
+INT_PROP(Modifiers, prop_modifiers)
+
+static HRESULT WINAPI acc_get_IsEnabled( struct xiface *iface, boolean *value )
+{
+    IInspectable *box = NULL;
+    if (!value) return E_POINTER;
+    dobj_get_value( &acc_from_iface( iface )->d, prop_enabled, &box );
+    *value = xunbox_boolean( box, TRUE );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT WINAPI acc_put_IsEnabled( struct xiface *iface, boolean value )
+{
+    IInspectable *box = xbox_boolean( value );
+    HRESULT hr;
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &acc_from_iface( iface )->d, prop_enabled, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT WINAPI acc_get_ScopeOwner( struct xiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( &acc_from_iface( iface )->d, prop_scope_owner, value );
+}
+
+static HRESULT WINAPI acc_put_ScopeOwner( struct xiface *iface, IInspectable *value )
+{
+    return dobj_set_value( &acc_from_iface( iface )->d, prop_scope_owner, value );
+}
+
+static HRESULT WINAPI acc_add_Invoked( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &acc_from_iface( iface )->invoked, handler, token );
+}
+
+static HRESULT WINAPI acc_remove_Invoked( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &acc_from_iface( iface )->invoked, token );
+}
+
+static const void *accelerator_vtbl[] =
+{
+    IKeyboardAccelerator_STUBS,
+    [IKeyboardAccelerator_Key] = acc_get_Key, [IKeyboardAccelerator_SetKey] = acc_put_Key,
+    [IKeyboardAccelerator_Modifiers] = acc_get_Modifiers, [IKeyboardAccelerator_SetModifiers] = acc_put_Modifiers,
+    [IKeyboardAccelerator_IsEnabled] = acc_get_IsEnabled, [IKeyboardAccelerator_SetIsEnabled] = acc_put_IsEnabled,
+    [IKeyboardAccelerator_ScopeOwner] = acc_get_ScopeOwner, [IKeyboardAccelerator_SetScopeOwner] = acc_put_ScopeOwner,
+    [IKeyboardAccelerator_Invoked] = acc_add_Invoked, [IKeyboardAccelerator_RemoveInvoked] = acc_remove_Invoked,
+};
+
+static HRESULT WINAPI acc_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct accelerator *acc;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    accelerators_init();
+    if (!(acc = calloc( 1, sizeof(*acc) ))) return E_OUTOFMEMORY;
+    acc->IKeyboardAccelerator_iface.vtbl = accelerator_vtbl;
+    handlers_init( &acc->invoked );
+    dobj_init( &acc->d, &accelerator_class, outer );
+    if (outer)
+    {
+        *inner = &acc->d.obj.IInspectable_inner;
+        IUnknown_AddRef( acc->d.obj.outer );
+    }
+    *value = &acc->IKeyboardAccelerator_iface;
+    return S_OK;
+}
+
+static HRESULT activate_accelerator( IInspectable **out )
+{
+    return acc_factory_CreateInstance( NULL, NULL, NULL, (void **)out );
+}
+
+#define STATIC_PROP(name, prop) \
+static HRESULT WINAPI acc_statics_##name( struct xfiface *iface, IInspectable **value ) \
+{ accelerators_init(); if (!value) return E_POINTER; IInspectable_AddRef( (*value = xaml_property_iface( prop )) ); return S_OK; }
+
+STATIC_PROP(KeyProperty, prop_key)
+STATIC_PROP(ModifiersProperty, prop_modifiers)
+STATIC_PROP(IsEnabledProperty, prop_enabled)
+STATIC_PROP(ScopeOwnerProperty, prop_scope_owner)
+
+static const void *acc_factory_vtbl[] = { IKeyboardAcceleratorFactory_FSTUBS, [IKeyboardAcceleratorFactory_new] = acc_factory_CreateInstance };
+static const void *acc_statics_vtbl[] =
+{
+    IKeyboardAcceleratorStatics_FSTUBS,
+    [IKeyboardAcceleratorStatics_KeyProperty] = acc_statics_KeyProperty,
+    [IKeyboardAcceleratorStatics_ModifiersProperty] = acc_statics_ModifiersProperty,
+    [IKeyboardAcceleratorStatics_IsEnabledProperty] = acc_statics_IsEnabledProperty,
+    [IKeyboardAcceleratorStatics_ScopeOwnerProperty] = acc_statics_ScopeOwnerProperty,
+};
+
+static struct xfactory acc_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Input.KeyboardAccelerator",
+    { &IID_IKeyboardAcceleratorFactory, &IID_IKeyboardAcceleratorStatics },
+    { { acc_factory_vtbl }, { acc_statics_vtbl } },
+    activate_accelerator,
+};
+
+IActivationFactory *keyboard_accelerator_factory = &acc_factory_obj.IActivationFactory_iface;
+
+/* ---- KeyboardAcceleratorInvokedEventArgs ---- */
+
+struct invoked_args
+{
+    struct xobj obj;
+    struct xiface iface;
+    boolean handled;
+    IInspectable *element;
+};
+
+static const struct xiface_entry invoked_args_ifaces[] =
+{
+    { &IID_IKeyboardAcceleratorInvokedEventArgs, offsetof(struct invoked_args, iface) },
+};
+
+static void invoked_args_destroy( struct xobj *obj )
+{
+    struct invoked_args *args = CONTAINING_RECORD( obj, struct invoked_args, obj );
+    if (args->element) IInspectable_Release( args->element );
+}
+
+static const struct xclass invoked_args_class =
+{
+    L"Windows.UI.Xaml.Input.KeyboardAcceleratorInvokedEventArgs", invoked_args_ifaces, ARRAY_SIZE(invoked_args_ifaces),
+    invoked_args_destroy,
+};
+
+static HRESULT WINAPI invoked_args_get_Handled( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct invoked_args, obj )->handled;
+    return S_OK;
+}
+
+static HRESULT WINAPI invoked_args_put_Handled( struct xiface *iface, boolean value )
+{
+    CONTAINING_RECORD( iface->obj, struct invoked_args, obj )->handled = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI invoked_args_get_Element( struct xiface *iface, IInspectable **value )
+{
+    struct invoked_args *args = CONTAINING_RECORD( iface->obj, struct invoked_args, obj );
+    if (!value) return E_POINTER;
+    if ((*value = args->element)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static const void *invoked_args_vtbl[] =
+{
+    IKeyboardAcceleratorInvokedEventArgs_STUBS,
+    [IKeyboardAcceleratorInvokedEventArgs_Handled] = invoked_args_get_Handled,
+    [IKeyboardAcceleratorInvokedEventArgs_SetHandled] = invoked_args_put_Handled,
+    [IKeyboardAcceleratorInvokedEventArgs_Element] = invoked_args_get_Element,
+};
+
+/* ---- UIElement.KeyboardAccelerators ---- */
+
+static const struct xvector_type accelerators_type =
+{
+    L"Windows.Foundation.Collections.IVector`1<Windows.UI.Xaml.Input.KeyboardAccelerator>", &IID_IVector_KeyboardAccelerator,
+    &IID_IVectorView_KeyboardAccelerator, &IID_IIterable_KeyboardAccelerator, &IID_IIterator_KeyboardAccelerator,
+    &IID_IKeyboardAccelerator, NULL, NULL, NULL, NULL,
+};
+
+HRESULT xaml_element_accelerators( struct uielem *elem, IInspectable **value )
+{
+    struct xvector *vector;
+
+    if (!value) return E_POINTER;
+    if (!elem->accelerators)
+    {
+        if (FAILED(xvector_create( &accelerators_type, NULL, &vector ))) return E_OUTOFMEMORY;
+        elem->accelerators = vector;
+    }
+    IInspectable_AddRef( (*value = xvector_iface( elem->accelerators )) );
+    return S_OK;
+}
+
+static INT32 current_modifiers(void)
+{
+    /* VirtualKeyModifiers: Control 1, Menu 2, Shift 4, Windows 8 */
+    return (GetKeyState( VK_CONTROL ) < 0 ? 1 : 0) | (GetKeyState( VK_MENU ) < 0 ? 2 : 0) |
+           (GetKeyState( VK_SHIFT ) < 0 ? 4 : 0) | (GetKeyState( VK_LWIN ) < 0 || GetKeyState( VK_RWIN ) < 0 ? 8 : 0);
+}
+
+/* the accelerator of an element's own list for a key: invoked; TRUE when it ran */
+static BOOL try_element( struct uielem *elem, UINT vk, INT32 modifiers, HWND hwnd )
+{
+    unsigned int i;
+
+    if (!elem->accelerators) return FALSE;
+    for (i = 0; i < xvector_size( elem->accelerators ); i++)
+    {
+        IInspectable *item = xvector_item( elem->accelerators, i ), *sender = NULL;
+        struct dobj *d = dobj_from_inspectable( item );
+        struct accelerator *acc;
+        struct invoked_args *args;
+        IInspectable *box = NULL;
+        boolean enabled;
+        BOOL handled = FALSE;
+
+        if (!d || d->obj.cls != &accelerator_class) continue;
+        acc = CONTAINING_RECORD( d, struct accelerator, d );
+        dobj_get_value( d, prop_enabled, &box );
+        enabled = xunbox_boolean( box, TRUE );
+        if (box) IInspectable_Release( box );
+        if (!enabled || get_int( d, prop_key, 0 ) != (INT32)vk || get_int( d, prop_modifiers, 0 ) != modifiers) continue;
+        TRACE( "%p: accelerator %p (key %#x, modifiers %d)\n", elem, acc, vk, modifiers );
+        if (!list_empty( &acc->invoked.entries ) && (args = calloc( 1, sizeof(*args) )))
+        {
+            args->iface.vtbl = invoked_args_vtbl;
+            xobj_init( &args->obj, &invoked_args_class, NULL );
+            IUnknown_QueryInterface( elem->d.obj.outer, &IID_IDependencyObject, (void **)&args->element );
+            IUnknown_QueryInterface( acc->d.obj.outer, &IID_IInspectable, (void **)&sender );
+            xaml_raise_routed( &acc->invoked, sender, (IInspectable *)&args->iface );
+            if (sender) IInspectable_Release( sender );
+            handled = args->handled;
+            IInspectable_Release( (IInspectable *)&args->iface );
+        }
+        /* not handled: the element's own action */
+        if (!handled)
+        {
+            if (xaml_is_button( elem ) && xaml_is_focus_target( elem )) xaml_button_click( elem );
+            else if (xaml_is_focus_target( elem )) xaml_focus_element_state( elem, hwnd, 2 );
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL try_subtree( struct uielem *elem, UINT vk, INT32 modifiers, HWND hwnd )
+{
+    struct uielem *child;
+
+    if (elem->visibility == XCOLLAPSED) return FALSE;
+    if (try_element( elem, vk, modifiers, hwnd )) return TRUE;
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+        if (try_subtree( child, vk, modifiers, hwnd )) return TRUE;
+    return FALSE;
+}
+
+/* an unhandled key down: the accelerators from the focused element up, then the rest of the island */
+BOOL xaml_try_accelerators( struct uielem *focused, struct uielem *root, UINT vk, HWND hwnd )
+{
+    INT32 modifiers = current_modifiers();
+    struct uielem *elem;
+
+#ifdef SG_MUTANT_XAML_NO_ACCELERATORS
+    return FALSE;
+#endif
+    if (vk == VK_CONTROL || vk == VK_SHIFT || vk == VK_MENU || vk == VK_LWIN || vk == VK_RWIN) return FALSE;
+    for (elem = focused; elem; elem = elem->parent)
+        if (try_element( elem, vk, modifiers, hwnd )) return TRUE;
+    return root && try_subtree( root, vk, modifiers, hwnd );
+}
diff --git a/dlls/windows.ui.xaml/application.c b/dlls/windows.ui.xaml/application.c
index 5338b5a..3b7de4e 100644
--- a/dlls/windows.ui.xaml/application.c
+++ b/dlls/windows.ui.xaml/application.c
@@ -264,6 +264,24 @@ static HRESULT WINAPI app_factory_CreateInstance( struct xfiface *iface, IInspec
 
 static const void *app_factory_vtbl[] = { XFIFACE_COMMON, app_factory_CreateInstance };
 
+/* XAML hosted in a program that made no Application of its own (WindowsXamlManager): one of ours, so
+ * that Application.Current and its Resources are there, as they are on Windows; kept for the process */
+void xaml_application_default(void)
+{
+    IInspectable *app = NULL;
+    BOOL have;
+
+    EnterCriticalSection( &app_cs );
+    have = current_app != NULL;
+    LeaveCriticalSection( &app_cs );
+#ifdef SG_MUTANT_XAML_NO_DEFAULT_APP
+    return;
+#endif
+    if (have) return;
+    if (SUCCEEDED(app_factory_CreateInstance( NULL, NULL, NULL, (void **)&app ))) TRACE( "default application %p\n", app );
+    /* the reference is kept: Application.Current lives as long as the process */
+}
+
 static HRESULT WINAPI app_statics_get_Current( struct xfiface *iface, void **value )
 {
     HRESULT hr = S_OK;
@@ -288,6 +306,16 @@ static HRESULT WINAPI app_statics_LoadComponent( struct xfiface *iface, IInspect
     return xaml_load_component( component, locator );
 }
 
+BOOL xaml_current_application_exists(void)
+{
+    BOOL ret;
+
+    EnterCriticalSection( &app_cs );
+    ret = current_app != NULL;
+    LeaveCriticalSection( &app_cs );
+    return ret;
+}
+
 /* the application's Resources (made when first asked for), no reference */
 IInspectable *xaml_application_resources( IInspectable *app_iface )
 {
