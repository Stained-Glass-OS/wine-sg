diff --git a/dlls/windows.ui.xaml/imaging.c b/dlls/windows.ui.xaml/imaging.c
index 0d6307b..5313fd9 100644
--- a/dlls/windows.ui.xaml/imaging.c
+++ b/dlls/windows.ui.xaml/imaging.c
@@ -318,6 +318,35 @@ static HRESULT WINAPI source_Close( struct xiface *iface )
 
 static const void *closable_vtbl[] = { XIFACE_COMMON, source_Close };
 
+static BOOL is_file_name( const WCHAR *str )
+{
+#ifdef SG_MUTANT_IMAGE_NO_FILE_NAME
+    return FALSE;
+#endif
+    if (((str[0] | 0x20) >= 'a' && (str[0] | 0x20) <= 'z') && str[1] == ':' && (str[2] == '\\' || str[2] == '/')) return TRUE;
+    return str[0] == '\\' && str[1] == '\\';
+}
+
+/* a file: Uri's path, its escapes undone */
+static WCHAR *file_uri_path( const WCHAR *str )
+{
+    WCHAR *path = malloc( (wcslen( str ) + 1) * sizeof(WCHAR) ), *out = path;
+
+    if (!path) return NULL;
+    while (*str)
+    {
+        if (str[0] == '%' && iswxdigit( str[1] ) && iswxdigit( str[2] ))
+        {
+            WCHAR hex[3] = { str[1], str[2], 0 };
+            *out++ = wcstoul( hex, NULL, 16 );
+            str += 3;
+        }
+        else *out++ = *str++;
+    }
+    *out = 0;
+    return path;
+}
+
 /* BitmapImage: its UriSource decoded */
 static void load_uri( struct image_source *source, IInspectable *uri )
 {
@@ -329,7 +358,9 @@ static void load_uri( struct image_source *source, IInspectable *uri )
 
     if (!uri || !(str = xaml_uri_string( uri ))) return;
     if (!wcsnicmp( str, L"ms-appx:///", 11 )) path = xaml_app_path( str + 11 );
-    else if (!wcsnicmp( str, L"file:///", 8 )) path = wcsdup( str + 8 );
+    else if (!wcsnicmp( str, L"file:///", 8 )) path = file_uri_path( str + 8 );
+    /* a Uri made from a file name ("C:\\dir\\file", "\\\\server\\share\\file"): that file */
+    else if (is_file_name( str )) path = wcsdup( str );
     else FIXME( "%s: not a file of the application\n", debugstr_w( str ) );
     free( str );
     if (path && SUCCEEDED(hr = WICCreateImagingFactory_Proxy( WINCODEC_SDK_VERSION, &factory )))
@@ -505,7 +536,7 @@ IInspectable *xaml_image_source_from_string( const WCHAR *str )
     WCHAR *full = NULL;
 
     if (!str || !*str) return NULL;
-    if (!wcsstr( str, L"://" ))
+    if (!wcsstr( str, L"://" ) && !is_file_name( str ))   /* a file name: that file, as on Windows */
     {
         while (*str == '/') str++;
         if ((full = malloc( (wcslen( str ) + 12) * sizeof(WCHAR) ))) swprintf( full, wcslen( str ) + 12, L"ms-appx:///%s", str );
