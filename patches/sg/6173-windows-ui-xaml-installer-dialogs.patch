+{ panels_init(); if (!value) return E_POINTER; IInspectable_AddRef( (*value = xaml_property_iface( prop )) ); return S_OK; } \
+static HRESULT WINAPI canvas_statics_Get##name( struct xfiface *iface, IInspectable *element, DOUBLE *value ) \
+{ IInspectable *box; HRESULT hr; if (!value) return E_POINTER; hr = canvas_get( element, prop, &box ); \
