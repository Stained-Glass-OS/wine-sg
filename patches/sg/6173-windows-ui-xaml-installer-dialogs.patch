+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * RangeBase keeps Minimum, Maximum, SmallChange, LargeChange and Value (kept between Minimum and
+ * Maximum) and raises ValueChanged.  Without a template of the application's, a ProgressBar draws
+ * a thin track with its value's part in the accent colour (an indeterminate one, a segment moving
+ * along it; ShowError red, ShowPaused amber), and an active ProgressRing a turning arc.  Moving
+ * looks are redrawn by a thread timer while any of them is drawn.
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+enum range_kind { RANGE_BASE, PROGRESS_BAR, PROGRESS_RING };
+
+struct range
+{
+    struct control c;
+    struct xiface IRangeBase_iface, IProgressBar_iface, IProgressRing_iface;
+    enum range_kind kind;
+    struct handler_list value_changed;
+};
+
+static struct xaml_property *prop_minimum, *prop_maximum, *prop_small_change, *prop_large_change, *prop_value;
+static struct xaml_property *prop_indeterminate, *prop_show_error, *prop_show_paused, *prop_is_active;
+
+static struct range *range_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct range, c.e.d.obj );
+}
+
+static struct range *range_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct range, c.e );
+}
+
+static DOUBLE get_double( struct dobj *obj, struct xaml_property *prop, DOUBLE def )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static boolean get_bool( struct dobj *obj, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    boolean ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static HRESULT put_double( struct dobj *obj, struct xaml_property *prop, DOUBLE value )
+{
+    IInspectable *box = xbox_double( value );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( obj, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT put_bool( struct dobj *obj, struct xaml_property *prop, boolean value )
+{
+    IInspectable *box = xbox_boolean( value );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( obj, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+/* ---- moving looks: redrawn while drawn ---- */
+
+static UINT_PTR anim_timer;
+static BOOL anim_drawn;
+
+static void CALLBACK anim_tick( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    if (!anim_drawn)
+    {
+        KillTimer( NULL, anim_timer );
+        anim_timer = 0;
+        return;
+    }
+    anim_drawn = FALSE;
+    xaml_invalidate_visuals();
+}
+
+static void animate(void)
+{
+#ifdef SG_MUTANT_PROGRESS_NO_ANIMATION
+    return;
+#endif
+    anim_drawn = TRUE;
+    if (!anim_timer) anim_timer = SetTimer( NULL, 0, 50, anim_tick );
+}
+
+/* ---- ValueChanged ---- */
+
+struct value_args
+{
+    struct xobj obj;
+    struct xiface iface;
+    DOUBLE old_value, new_value;
+};
+
+static const struct xiface_entry value_args_ifaces[] =
+{
+    { &IID_IRangeBaseValueChangedEventArgs, offsetof(struct value_args, iface) },
+};
+
+static const struct xclass value_args_class =
+{
+    L"Windows.UI.Xaml.Controls.Primitives.RangeBaseValueChangedEventArgs", value_args_ifaces, ARRAY_SIZE(value_args_ifaces), NULL,
+};
+
+static HRESULT WINAPI value_args_get_OldValue( struct xiface *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct value_args, obj )->old_value;
+    return S_OK;
+}
+
+static HRESULT WINAPI value_args_get_NewValue( struct xiface *iface, DOUBLE *value )
+{
+    if (!value) return E_POINTER;
+    *value = CONTAINING_RECORD( iface->obj, struct value_args, obj )->new_value;
+    return S_OK;
+}
+
+static const void *value_args_vtbl[] =
+{
+    IRangeBaseValueChangedEventArgs_STUBS,
+    [IRangeBaseValueChangedEventArgs_OldValue] = value_args_get_OldValue,
+    [IRangeBaseValueChangedEventArgs_NewValue] = value_args_get_NewValue,
+};
+
+static void value_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct range *range = CONTAINING_RECORD( obj, struct range, c.e.d );
+    IInspectable *sender = NULL;
+    struct value_args *args;
+
+    xaml_invalidate_visuals();
+#ifdef SG_MUTANT_RANGE_NO_VALUE_CHANGED
+    return;
+#endif
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->iface.vtbl = value_args_vtbl;
+    xobj_init( &args->obj, &value_args_class, NULL );
+    args->old_value = xunbox_double( old_value, 0 );
+    args->new_value = xunbox_double( new_value, 0 );
+    TRACE( "%p Value %g -> %g\n", range, args->old_value, args->new_value );
+    IUnknown_QueryInterface( obj->obj.outer, &IID_IInspectable, (void **)&sender );
+    xaml_raise_routed( &range->value_changed, sender, (IInspectable *)&args->iface );
+    IInspectable_Release( (IInspectable *)&args->iface );
+    if (sender) IInspectable_Release( sender );
+}
+
+static void visual_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_invalidate_visuals();
+}
+
+/* Value kept between Minimum and Maximum (Maximum no less than Minimum) */
+static void coerce( struct range *range )
+{
+    struct dobj *d = &range->c.e.d;
+    DOUBLE min = get_double( d, prop_minimum, 0 ), max = get_double( d, prop_maximum, 1 ), value = get_double( d, prop_value, 0 );
+
+    if (max < min) put_double( d, prop_maximum, (max = min) );
+    if (value < min) put_double( d, prop_value, min );
+    else if (value > max) put_double( d, prop_value, max );
+}
+
+/* ---- looks ---- */
+
+static void progress_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct range *range = range_from_elem( elem );
+
+    control_measure( elem, available, desired );
+    if (range->c.template_root) return;
+    if (range->kind == PROGRESS_BAR) desired->height = fmax( desired->height, 4 );
+    else if (range->kind == PROGRESS_RING) desired->width = desired->height = fmax( desired->height, 20 );
+}
+
+static void progress_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct range *range = range_from_elem( elem );
+    struct dobj *d = &range->c.e.d;
+    FLOAT width = elem->render.width, height = elem->render.height;
+    struct xcolor accent = xaml_theme_color( XTHEME_ACCENT ), track = xaml_theme_color( XTHEME_BORDER );
+    DWORD now = GetTickCount();
+
+    if (range->c.template_root) return;
+    control_brush( &range->c, TRUE, &accent );
+    if (range->kind == PROGRESS_RING)
+    {
+        /* a three-quarter arc turning once a second and a third */
+        FLOAT r = fminf( width, height ) / 2 - 1.5f, cx = width / 2, cy = height / 2, start;
+        unsigned int i;
+
+        if (!get_bool( d, prop_is_active ) || r <= 0) return;
+        animate();
+        start = (now % 1333) / 1333.0f * 2 * M_PI;
+        for (i = 0; i < 24; i++)
+        {
+            FLOAT a1 = start + i * (1.5f * M_PI / 24), a2 = a1 + 1.5f * M_PI / 24;
+            xdraw_line( draw, cx + r * cosf( a1 ), cy + r * sinf( a1 ), cx + r * cosf( a2 ), cy + r * sinf( a2 ), accent, 2.5f );
+        }
+        return;
+    }
+    if (range->kind == PROGRESS_BAR)
+    {
+        DOUBLE min = get_double( d, prop_minimum, 0 ), max = get_double( d, prop_maximum, 100 );
+        DOUBLE value = get_double( d, prop_value, 0 );
+        struct xrect all = { 0, 0, width, height }, part = all;
+        FLOAT bar = fminf( height, 4 );
+
+        if (get_bool( d, prop_show_error )) accent = (struct xcolor){ 255, 0xc4, 0x2b, 0x1c };
+        else if (get_bool( d, prop_show_paused )) accent = (struct xcolor){ 255, 0x9d, 0x5d, 0x00 };
+        all.y = part.y = (height - bar) / 2;
+        all.height = part.height = bar;
+        if (get_bool( d, prop_indeterminate ))
+        {
+            /* a segment of two fifths of it crossing it in two seconds */
+            FLOAT pos = (now % 2000) / 2000.0f * (width * 1.4f) - width * 0.4f;
+            animate();
+            part.x = fmaxf( 0, pos );
+            part.width = fminf( width, pos + width * 0.4f ) - part.x;
+            if (part.width > 0) xdraw_fill( draw, &part, accent, NULL );
+            return;
+        }
+        xdraw_fill( draw, &all, track, NULL );
+        part.width = max > min ? width * fmin( 1, fmax( 0, (value - min) / (max - min) ) ) : 0;
+        if (part.width > 0) xdraw_fill( draw, &part, accent, NULL );
+    }
+}
+
+static const struct elem_ops progress_ops = { progress_measure, control_arrange, progress_render };
+
+/* ---- interfaces ---- */
+
+#define DOUBLE_PROP(name, prop, def) \
+static HRESULT WINAPI range_get_##name( struct xiface *iface, DOUBLE *value ) \
+{ if (!value) return E_POINTER; *value = get_double( &range_from_iface( iface )->c.e.d, prop, def ); return S_OK; }
+
+DOUBLE_PROP(Minimum, prop_minimum, 0)
+DOUBLE_PROP(Maximum, prop_maximum, 1)
+DOUBLE_PROP(SmallChange, prop_small_change, 0.1)
+DOUBLE_PROP(LargeChange, prop_large_change, 1)
+DOUBLE_PROP(Value, prop_value, 0)
+
+static HRESULT WINAPI range_put_Minimum( struct xiface *iface, DOUBLE value )
+{
+    struct range *range = range_from_iface( iface );
+    HRESULT hr = put_double( &range->c.e.d, prop_minimum, value );
+    coerce( range );
+    return hr;
+}
+
+static HRESULT WINAPI range_put_Maximum( struct xiface *iface, DOUBLE value )
+{
+    struct range *range = range_from_iface( iface );
+    HRESULT hr = put_double( &range->c.e.d, prop_maximum, value );
+    coerce( range );
+    return hr;
+}
+
+static HRESULT WINAPI range_put_SmallChange( struct xiface *iface, DOUBLE value )
+{
+    return put_double( &range_from_iface( iface )->c.e.d, prop_small_change, value );
+}
+
+static HRESULT WINAPI range_put_LargeChange( struct xiface *iface, DOUBLE value )
+{
+    return put_double( &range_from_iface( iface )->c.e.d, prop_large_change, value );
+}
+
+static HRESULT WINAPI range_put_Value( struct xiface *iface, DOUBLE value )
+{
+    struct range *range = range_from_iface( iface );
+    struct dobj *d = &range->c.e.d;
+    DOUBLE min = get_double( d, prop_minimum, 0 ), max = get_double( d, prop_maximum, 1 );
+
+#ifndef SG_MUTANT_RANGE_NO_COERCE
+    value = fmax( min, fmin( max, value ) );
+#endif
+    return put_double( d, prop_value, value );
+}
+
+static HRESULT WINAPI range_add_ValueChanged( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &range_from_iface( iface )->value_changed, handler, token );
+}
+
+static HRESULT WINAPI range_remove_ValueChanged( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &range_from_iface( iface )->value_changed, token );
+}
+
+static const void *range_vtbl[] =
+{
+    IRangeBase_STUBS,
+    [IRangeBase_Minimum] = range_get_Minimum, [IRangeBase_SetMinimum] = range_put_Minimum,
+    [IRangeBase_Maximum] = range_get_Maximum, [IRangeBase_SetMaximum] = range_put_Maximum,
+    [IRangeBase_SmallChange] = range_get_SmallChange, [IRangeBase_SetSmallChange] = range_put_SmallChange,
+    [IRangeBase_LargeChange] = range_get_LargeChange, [IRangeBase_SetLargeChange] = range_put_LargeChange,
+    [IRangeBase_Value] = range_get_Value, [IRangeBase_SetValue] = range_put_Value,
+    [IRangeBase_ValueChanged] = range_add_ValueChanged, [IRangeBase_RemoveValueChanged] = range_remove_ValueChanged,
+};
+
+#define BOOL_PROP(prefix, name, prop) \
+static HRESULT WINAPI prefix##_get_##name( struct xiface *iface, boolean *value ) \
+{ if (!value) return E_POINTER; *value = get_bool( &range_from_iface( iface )->c.e.d, prop ); return S_OK; } \
+static HRESULT WINAPI prefix##_put_##name( struct xiface *iface, boolean value ) \
+{ return put_bool( &range_from_iface( iface )->c.e.d, prop, value ); }
+
+BOOL_PROP(bar, IsIndeterminate, prop_indeterminate)
+BOOL_PROP(bar, ShowError, prop_show_error)
+BOOL_PROP(bar, ShowPaused, prop_show_paused)
+BOOL_PROP(ring, IsActive, prop_is_active)
+
+static const void *progress_bar_vtbl[] =
