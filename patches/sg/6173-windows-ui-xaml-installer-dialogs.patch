diff --git a/dlls/windows.ui.xaml/range.c b/dlls/windows.ui.xaml/range.c
new file mode 100644
index 0000000..b618aa3
--- /dev/null
+++ b/dlls/windows.ui.xaml/range.c
@@ -0,0 +1,526 @@
+/*
+ * Windows.UI.Xaml range controls: RangeBase, ProgressBar, ProgressRing
+ *
+ * Copyright 2026 Stained Glass OS
+ *
