+
+/*
+ * Raising events, from a thread pool thread as Windows does
+ */
+
+struct toast_event
+{
+    struct toast *toast;
+    enum toast_event_kind kind;
+    HSTRING arguments;
+    ToastDismissalReason reason;
+    HRESULT error;
+};
+
+static void CALLBACK toast_event_callback( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct toast_event *event = context;
+    struct toast *toast = event->toast;
+    ITypedEventHandler_ToastNotification_IInspectable **handlers = NULL;
+    HWND *apartments = NULL;
+    struct toast_event_args *args;
+    struct handler *entry;
+    UINT count = 0, i;
+
+    TRACE( "toast %p, kind %d, arguments %s, reason %d.\n", toast, event->kind, debugstr_hstring( event->arguments ),
+           event->reason );
+
+    if (!(args = calloc( 1, sizeof(*args) ))) goto done;
+    args->IToastActivatedEventArgs_iface.lpVtbl = &activated_args_vtbl;
+    args->IToastDismissedEventArgs_iface.lpVtbl = &dismissed_args_vtbl;
+    args->IToastFailedEventArgs_iface.lpVtbl = &failed_args_vtbl;
+    args->ref = 1;
+    args->kind = event->kind;
+    args->arguments = event->arguments;
+    event->arguments = NULL;
+    args->reason = event->reason;
+    args->error = event->error;
+
+    EnterCriticalSection( &toast->cs );
+    count = list_count( &toast->handlers[event->kind] );
+    if (count && (handlers = calloc( count, sizeof(*handlers) )) && (apartments = calloc( count, sizeof(*apartments) )))
+    {
+        i = 0;
+        LIST_FOR_EACH_ENTRY( entry, &toast->handlers[event->kind], struct handler, entry )
+        {
+            apartments[i] = entry->apartment;
+            handlers[i] = entry->handler;
+            ITypedEventHandler_ToastNotification_IInspectable_AddRef( handlers[i++] );
+        }
+    }
+    else count = 0;
+    LeaveCriticalSection( &toast->cs );
+
+    for (i = 0; i < count; i++)
+    {
+        IInspectable *arg = event->kind == TOAST_ACTIVATED ? (IInspectable *)&args->IToastActivatedEventArgs_iface :
+                            event->kind == TOAST_DISMISSED ? (IInspectable *)&args->IToastDismissedEventArgs_iface :
+                                                             (IInspectable *)&args->IToastFailedEventArgs_iface;
+        struct invocation *call;
+
+        if (!(call = malloc( sizeof(*call) )))
+        {
+            ITypedEventHandler_ToastNotification_IInspectable_Release( handlers[i] );
+            continue;
+        }
+        /* the three handler types differ only in the type of their second argument */
+        call->handler = handlers[i];
+        call->sender = &toast->IToastNotification_iface;
+        IToastNotification_AddRef( call->sender );
+        call->args = arg;
+        IInspectable_AddRef( arg );
+        if (!apartments[i] || !PostMessageW( apartments[i], WM_TOAST_INVOKE, 0, (LPARAM)call )) invoke( call );
+    }
+    free( handlers );
+    free( apartments );
+    IToastActivatedEventArgs_Release( &args->IToastActivatedEventArgs_iface );
+
+done:
+    WindowsDeleteString( event->arguments );
+    IToastNotification_Release( &toast->IToastNotification_iface );
+    free( event );
+}
+
+static void raise_event( struct toast *toast, enum toast_event_kind kind, const WCHAR *arguments,
+                         ToastDismissalReason reason, HRESULT error )
+{
+    struct toast_event *event;
+
+    if (!(event = calloc( 1, sizeof(*event) ))) return;
+    event->toast = toast;
+    IToastNotification_AddRef( &toast->IToastNotification_iface );
+    event->kind = kind;
+    if (arguments) WindowsCreateString( arguments, wcslen( arguments ), &event->arguments );
+    event->reason = reason;
+    event->error = error;
+    if (!TrySubmitThreadpoolCallback( toast_event_callback, event, NULL )) toast_event_callback( NULL, event );
+}
+
+/*
+ * The toast window
+ */
+
+static int scale( int value )
+{
+    static UINT dpi;
+    if (!dpi)
+    {
+        HDC hdc = GetDC( 0 );
+        dpi = GetDeviceCaps( hdc, LOGPIXELSY );
+        ReleaseDC( 0, hdc );
+        if (!dpi) dpi = 96;
+    }
+    return MulDiv( value, dpi, 96 );
+}
+
+#define TOAST_WIDTH   364
+#define TOAST_PAD     16
+#define TOAST_LOGO    48
+#define TOAST_BUTTON  32
+#define TOAST_GAP     8
+
+static const COLORREF color_back = RGB(0x2B, 0x28, 0x33), color_accent = RGB(0x70, 0x30, 0xC0),
+                      color_dim = RGB(0xC8, 0xC2, 0xD4), color_title = RGB(0xFF, 0xFF, 0xFF),
+                      color_body = RGB(0xE8, 0xE4, 0xF0), color_button = RGB(0x45, 0x40, 0x52),
+                      color_button_hot = RGB(0x57, 0x51, 0x66), color_close_hot = RGB(0x45, 0x40, 0x52);
+
+static HFONT font_small, font_title, font_body;
+
+static void create_fonts(void)
+{
+    NONCLIENTMETRICSW metrics = {sizeof(metrics)};
+    LOGFONTW font;
+
+    SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0 );
+    font = metrics.lfMessageFont;
+    font.lfQuality = CLEARTYPE_QUALITY;
+    font.lfHeight = -scale( 12 );
+    font_small = CreateFontIndirectW( &font );
+    font.lfHeight = -scale( 15 );
+    font.lfWeight = FW_SEMIBOLD;
+    font_title = CreateFontIndirectW( &font );
+    font.lfHeight = -scale( 14 );
+    font.lfWeight = FW_NORMAL;
+    font_body = CreateFontIndirectW( &font );
+}
+
+static int text_x( const struct toast_view *view )
+{
+    return scale( TOAST_PAD ) + (view->logo ? scale( TOAST_LOGO ) + scale( 12 ) : 0);
+}
+
+/* lays the toast out; returns its height */
+static int layout( HDC hdc, struct toast_view *view, RECT *title, RECT *body, RECT *attribution )
+{
+    int width = scale( TOAST_WIDTH ), x = text_x( view ), right = width - scale( TOAST_PAD ), y = scale( 40 ), bottom;
+    UINT i;
+
+    SetRect( title, x, y, right, y );
+    if (view->title)
+    {
+        SelectObject( hdc, font_title );
+        DrawTextW( hdc, view->title, -1, title, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX | DT_EDITCONTROL );
+        title->right = right;
+        if (title->bottom - title->top > scale( 42 )) title->bottom = title->top + scale( 42 );
+        y = title->bottom + scale( 2 );
+    }
+    SetRect( body, x, y, right, y );
+    if (view->body)
+    {
+        SelectObject( hdc, font_body );
+        DrawTextW( hdc, view->body, -1, body, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX | DT_EDITCONTROL );
+        body->right = right;
+        if (body->bottom - body->top > scale( 80 )) body->bottom = body->top + scale( 80 );
+        y = body->bottom;
+    }
+    SetRect( attribution, x, y, right, y );
+    if (view->attribution)
+    {
+        SelectObject( hdc, font_small );
+        attribution->top = y + scale( 4 );
+        attribution->bottom = attribution->top + scale( 18 );
+        y = attribution->bottom;
+    }
+    bottom = max( y, view->logo ? scale( 40 + TOAST_LOGO ) : 0 ) + scale( TOAST_PAD );
+
+    if (view->action_count)
+    {
+        int button_width = (width - 2 * scale( TOAST_PAD ) - (view->action_count - 1) * scale( TOAST_GAP )) / view->action_count;
+        for (i = 0; i < view->action_count; i++)
+            SetRect( &view->actions[i].rect, scale( TOAST_PAD ) + i * (button_width + scale( TOAST_GAP )), bottom,
+                     scale( TOAST_PAD ) + i * (button_width + scale( TOAST_GAP )) + button_width, bottom + scale( TOAST_BUTTON ) );
+        bottom += scale( TOAST_BUTTON ) + scale( TOAST_PAD );
+    }
+    SetRect( &view->close_rect, width - scale( 40 ), scale( 4 ), width - scale( 8 ), scale( 36 ) );
+    return bottom;
+}
+
+static void fill( HDC hdc, const RECT *rect, COLORREF color )
+{
+    HBRUSH brush = CreateSolidBrush( color );
+    FillRect( hdc, rect, brush );
+    DeleteObject( brush );
+}
+
+static void paint( HWND hwnd, HDC hdc, struct toast_view *view )
+{
+    RECT client, rect, title, body, attribution;
+    HDC mem = CreateCompatibleDC( hdc );
+    HBITMAP bitmap, old;
+    HDC draw;
+    UINT i;
+
+    GetClientRect( hwnd, &client );
+    bitmap = CreateCompatibleBitmap( hdc, client.right, client.bottom );
+    old = SelectObject( mem, bitmap );
+    draw = mem;
+
+    fill( draw, &client, color_back );
+    SetRect( &rect, 0, 0, scale( 4 ), client.bottom );
+    fill( draw, &rect, color_accent );
+    SetBkMode( draw, TRANSPARENT );
+
+    /* the program's icon and name */
+    if (view->icon) DrawIconEx( draw, scale( TOAST_PAD ), scale( 12 ), view->icon, scale( 16 ), scale( 16 ), 0, NULL, DI_NORMAL );
+    SelectObject( draw, font_small );
+    SetTextColor( draw, color_dim );
+    SetRect( &rect, scale( TOAST_PAD ) + (view->icon ? scale( 24 ) : 0), scale( 10 ), view->close_rect.left, scale( 30 ) );
+    DrawTextW( draw, view->app_name ? view->app_name : L"", -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS );
+
+    /* the close button */
+    if (view->hot == -1) fill( draw, &view->close_rect, color_close_hot );
+    {
+        HPEN pen = CreatePen( PS_SOLID, max( 1, scale( 1 ) ), view->hot == -1 ? color_title : color_dim ), old_pen;
+        int cx = (view->close_rect.left + view->close_rect.right) / 2, cy = (view->close_rect.top + view->close_rect.bottom) / 2, d = scale( 5 );
+        old_pen = SelectObject( draw, pen );
+        MoveToEx( draw, cx - d, cy - d, NULL );
+        LineTo( draw, cx + d + 1, cy + d + 1 );
+        MoveToEx( draw, cx + d, cy - d, NULL );
+        LineTo( draw, cx - d - 1, cy + d + 1 );
+        SelectObject( draw, old_pen );
+        DeleteObject( pen );
+    }
+
+    layout( draw, view, &title, &body, &attribution );
+
+    if (view->logo)
+    {
+        HDC logo_dc = CreateCompatibleDC( draw );
+        BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+        BITMAP info;
+        HBITMAP prev = SelectObject( logo_dc, view->logo );
+        GetObjectW( view->logo, sizeof(info), &info );
+        GdiAlphaBlend( draw, scale( TOAST_PAD ), scale( 40 ), scale( TOAST_LOGO ), scale( TOAST_LOGO ),
+                       logo_dc, 0, 0, info.bmWidth, info.bmHeight, blend );
+        SelectObject( logo_dc, prev );
+        DeleteDC( logo_dc );
+    }
+    if (view->title)
+    {
+        SelectObject( draw, font_title );
+        SetTextColor( draw, color_title );
+        DrawTextW( draw, view->title, -1, &title, DT_WORDBREAK | DT_NOPREFIX | DT_EDITCONTROL | DT_END_ELLIPSIS );
+    }
+    if (view->body)
+    {
+        SelectObject( draw, font_body );
+        SetTextColor( draw, color_body );
+        DrawTextW( draw, view->body, -1, &body, DT_WORDBREAK | DT_NOPREFIX | DT_EDITCONTROL | DT_END_ELLIPSIS );
+    }
+    if (view->attribution)
+    {
+        SelectObject( draw, font_small );
+        SetTextColor( draw, color_dim );
+        DrawTextW( draw, view->attribution, -1, &attribution, DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS );
+    }
+    SelectObject( draw, font_body );
+    for (i = 0; i < view->action_count; i++)
+    {
+        fill( draw, &view->actions[i].rect, view->hot == (int)i ? color_button_hot : color_button );
+        SetTextColor( draw, color_title );
+        rect = view->actions[i].rect;
+        InflateRect( &rect, -scale( 6 ), 0 );
+        DrawTextW( draw, view->actions[i].content, -1, &rect, DT_SINGLELINE | DT_CENTER | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS );
+    }
+
+    BitBlt( hdc, 0, 0, client.right, client.bottom, mem, 0, 0, SRCCOPY );
+    SelectObject( mem, old );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+}
+
+static void free_view( struct toast_view *view )
+{
+    UINT i;
+
+    free( view->app_name );
+    free( view->title );
+    free( view->body );
+    free( view->attribution );
+    free( view->launch );
+    for (i = 0; i < view->action_count; i++)
+    {
+        free( view->actions[i].content );
+        free( view->actions[i].arguments );
+    }
+    if (view->logo) DeleteObject( view->logo );
+    if (view->icon) DestroyIcon( view->icon );
+    if (view->toast) IToastNotification_Release( &view->toast->IToastNotification_iface );
+    free( view );
+}
+
+static BOOL CALLBACK find_lowest_toast( HWND hwnd, LPARAM lparam )
+{
+    int *top = (int *)lparam;
+    WCHAR name[64];
+    RECT rect;
+
+    if (!IsWindowVisible( hwnd ) || !GetClassNameW( hwnd, name, ARRAY_SIZE(name) ) || wcscmp( name, TOAST_CLASS )) return TRUE;
+    GetWindowRect( hwnd, &rect );
+    if (rect.top < *top) *top = rect.top;
+    return TRUE;
+}
+
+/* above the toasts already on screen, whichever program shows them */
+static void place( HWND hwnd, int height )
+{
+    RECT work;
+    int top;
+
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    top = work.bottom - scale( 4 );
+    EnumWindows( find_lowest_toast, (LPARAM)&top );
+    if (top < work.bottom - scale( 4 )) top -= scale( TOAST_GAP );
+    else top -= scale( 8 );
+    if (top - height < work.top) top = work.bottom - scale( 12 );
+    SetWindowPos( hwnd, HWND_TOPMOST, work.right - scale( TOAST_WIDTH ) - scale( 12 ), top - height,
+                  scale( TOAST_WIDTH ), height, SWP_NOACTIVATE | SWP_SHOWWINDOW );
+}
+
+static void close_toast( HWND hwnd, enum toast_event_kind kind, const WCHAR *arguments, ToastDismissalReason reason )
+{
+    struct toast_view *view = (struct toast_view *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+    struct toast *toast;
+
+    if (!view) return;
+    toast = view->toast;
+    EnterCriticalSection( &toast_cs );
+    if (toast->hwnd == hwnd) toast->hwnd = NULL;
+    LeaveCriticalSection( &toast_cs );
+    if (kind == TOAST_ACTIVATED || kind == TOAST_DISMISSED) raise_event( toast, kind, arguments, reason, S_OK );
+    DestroyWindow( hwnd );
+}
+
+static void activate( HWND hwnd, struct toast_view *view, const WCHAR *arguments, BOOL protocol )
+{
+    if (protocol && arguments && *arguments)
+    {
+        /* the argument is a URI to open, not something for the program */
+        ShellExecuteW( NULL, NULL, arguments, NULL, NULL, SW_SHOWNORMAL );
+        close_toast( hwnd, -1, NULL, 0 );
+        return;
+    }
+    close_toast( hwnd, TOAST_ACTIVATED, arguments ? arguments : L"", 0 );
+}
+
+static int hit_test( struct toast_view *view, POINT pt )
+{
+    UINT i;
+    if (PtInRect( &view->close_rect, pt )) return -1;
+    for (i = 0; i < view->action_count; i++) if (PtInRect( &view->actions[i].rect, pt )) return i;
+    return -2;
+}
+
+static LRESULT CALLBACK toast_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct toast_view *view = (struct toast_view *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+    POINT pt;
+
+    switch (msg)
+    {
+    case WM_MOUSEACTIVATE:
+        return MA_NOACTIVATE;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint( hwnd, &ps );
+        if (view) paint( hwnd, hdc, view );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_SETCURSOR:
+        SetCursor( LoadCursorW( NULL, (LPCWSTR)IDC_HAND ) );
+        return TRUE;
+    case WM_MOUSEMOVE:
+        if (!view) break;
+        if (!view->tracking)
+        {
+            TRACKMOUSEEVENT track = {sizeof(track), TME_LEAVE, hwnd};
+            TrackMouseEvent( &track );
+            view->tracking = TRUE;
+            KillTimer( hwnd, 1 );   /* no timing out while the pointer rests on it */
+        }
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        if (hit_test( view, pt ) != view->hot)
+        {
+            view->hot = hit_test( view, pt );
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        break;
+    case WM_MOUSELEAVE:
+        if (!view) break;
+        view->tracking = FALSE;
+        view->hot = -2;
+        InvalidateRect( hwnd, NULL, FALSE );
+        if (view->timeout) SetTimer( hwnd, 1, view->timeout, NULL );
+        break;
+    case WM_LBUTTONUP:
+    {
+        int hit;
+        if (!view) break;
+        pt.x = (short)LOWORD( lparam );
+        pt.y = (short)HIWORD( lparam );
+        hit = hit_test( view, pt );
+        if (hit == -1) close_toast( hwnd, TOAST_DISMISSED, NULL, ToastDismissalReason_UserCanceled );
+        else if (hit >= 0) activate( hwnd, view, view->actions[hit].arguments, view->actions[hit].protocol );
+        else activate( hwnd, view, view->launch, view->launch_protocol );
+        return 0;
+    }
+    case WM_RBUTTONUP:
+        if (view) close_toast( hwnd, TOAST_DISMISSED, NULL, ToastDismissalReason_UserCanceled );
+        return 0;
+    case WM_TIMER:
+        if (wparam == 1 && view) close_toast( hwnd, TOAST_DISMISSED, NULL, ToastDismissalReason_TimedOut );
+        return 0;
+    case WM_TOAST_CLOSE:
+        if (view) close_toast( hwnd, wparam ? TOAST_DISMISSED : -1, NULL, ToastDismissalReason_ApplicationHidden );
+        return 0;
+    case WM_NCDESTROY:
+        SetWindowLongPtrW( hwnd, GWLP_USERDATA, 0 );
+        if (view) free_view( view );
+        break;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static void show_view( struct toast_view *view )
+{
+    struct toast *toast = view->toast;
+    RECT title, body, attribution;
+    HWND hwnd;
+    HDC hdc;
+    int height;
+
+    hwnd = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE, TOAST_CLASS, view->title ? view->title : L"",
+                            WS_POPUP, 0, 0, scale( TOAST_WIDTH ), scale( 100 ), NULL, NULL, module_instance, NULL );
+    if (!hwnd)
+    {
+        raise_event( toast, TOAST_FAILED, NULL, 0, HRESULT_FROM_WIN32( GetLastError() ) );
+        free_view( view );
+        return;
+    }
+    SetWindowLongPtrW( hwnd, GWLP_USERDATA, (LONG_PTR)view );
+    EnterCriticalSection( &toast_cs );
+    toast->hwnd = hwnd;
+    LeaveCriticalSection( &toast_cs );
+
+    hdc = GetDC( hwnd );
+    height = layout( hdc, view, &title, &body, &attribution );
+    ReleaseDC( hwnd, hdc );
+    place( hwnd, height );
+    if (view->timeout) SetTimer( hwnd, 1, view->timeout, NULL );
+    TRACE( "toast %p shown in %p\n", toast, hwnd );
+}
+
+static DWORD WINAPI toast_thread( void *arg )
+{
+    WNDCLASSW class = {0};
+    MSG msg;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_toast_notifications" );
+    class.lpfnWndProc = toast_wndproc;
+    class.hInstance = module_instance;
+    class.hCursor = LoadCursorW( NULL, (LPCWSTR)IDC_ARROW );
+    class.lpszClassName = TOAST_CLASS;
+    RegisterClassW( &class );
+    create_fonts();
+
+    PeekMessageW( &msg, NULL, 0, 0, PM_NOREMOVE );
+    SetEvent( arg );
+
+    while (GetMessageW( &msg, NULL, 0, 0 ))
+    {
+        if (!msg.hwnd && msg.message == WM_TOAST_SHOW)
+        {
+            show_view( (struct toast_view *)msg.lParam );
+            continue;
+        }
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    return 0;
+}
+
+static BOOL start_toast_thread(void)
+{
+    HANDLE thread, ready;
+    DWORD id;
+
+    EnterCriticalSection( &toast_cs );
+    if (!ui_thread_id && (ready = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)start_toast_thread, &module_instance );
+        if ((thread = CreateThread( NULL, 0, toast_thread, ready, 0, &id )))
+        {
+            WaitForSingleObject( ready, INFINITE );
+            CloseHandle( thread );
+            ui_thread_id = id;
+        }
+        CloseHandle( ready );
+    }
+    LeaveCriticalSection( &toast_cs );
+    return !!ui_thread_id;
+}
