+static HRESULT WINAPI manager_statics_GetTemplateContent( IToastNotificationManagerStatics *iface, ToastTemplateType type,
+                                                          IXmlDocument **result )
+{
+    IXmlDocumentIO *io;
+    HSTRING xml;
+    HRESULT hr;
+
+    TRACE( "iface %p, type %d, result %p.\n", iface, type, result );
+
+    *result = NULL;
+    if ((UINT)type >= ARRAY_SIZE(toast_templates)) return E_INVALIDARG;
+    if (FAILED(hr = xml_document_create( result ))) return hr;
+    if (SUCCEEDED(hr = IXmlDocument_QueryInterface( *result, &IID_IXmlDocumentIO, (void **)&io )))
+    {
+        if (SUCCEEDED(hr = WindowsCreateString( toast_templates[type], wcslen( toast_templates[type] ), &xml )))
+        {
+            hr = IXmlDocumentIO_LoadXml( io, xml );
+            WindowsDeleteString( xml );
+        }
+        IXmlDocumentIO_Release( io );
+    }
+    if (FAILED(hr))
+    {
+        IXmlDocument_Release( *result );
+        *result = NULL;
+    }
+    return hr;
