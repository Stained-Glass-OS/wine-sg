+/* A handler that is not agile is called in the apartment that registered
+ * it, as COM would marshal the call: Firefox insists on its main thread.
+ * There are no proxies for these delegates, so a single-threaded apartment
+ * gets the call through a message-only window of its thread. */
+
+#define WM_TOAST_INVOKE (WM_APP + 3)
+
+struct invocation
+{
+    ITypedEventHandler_ToastNotification_IInspectable *handler;
+    IToastNotification *sender;
+    IInspectable *args;
+};
+
+static void invoke( struct invocation *call )
+{
+    ITypedEventHandler_ToastNotification_IInspectable_Invoke( call->handler, call->sender, call->args );
+    ITypedEventHandler_ToastNotification_IInspectable_Release( call->handler );
+    IToastNotification_Release( call->sender );
+    IInspectable_Release( call->args );
+    free( call );
+}
+
+static LRESULT CALLBACK apartment_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_TOAST_INVOKE)
+    {
+        invoke( (struct invocation *)lparam );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HWND apartment_window( IUnknown *handler )
+{
+    static const WCHAR class_name[] = L"WineToastApartment";
+    static ATOM atom;
+    APTTYPEQUALIFIER qualifier;
+    APTTYPE type;
+    IUnknown *agile;
+    HWND hwnd = NULL;
+
+    if (SUCCEEDED(IUnknown_QueryInterface( handler, &IID_IAgileObject, (void **)&agile )))
+    {
+        IUnknown_Release( agile );
+        return NULL;
+    }
+    if (FAILED(CoGetApartmentType( &type, &qualifier )) || (type != APTTYPE_STA && type != APTTYPE_MAINSTA)) return NULL;
+
+    /* one window per thread, found by its class among the thread's windows */
+    while ((hwnd = FindWindowExW( HWND_MESSAGE, hwnd, class_name, NULL )))
+        if (GetWindowThreadProcessId( hwnd, NULL ) == GetCurrentThreadId()) return hwnd;
+
+    if (!atom)
+    {
+        WNDCLASSW class = {0};
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)apartment_wndproc, &class.hInstance );
+        class.lpfnWndProc = apartment_wndproc;
+        class.lpszClassName = class_name;
+        atom = RegisterClassW( &class );
+    }
+    return CreateWindowExW( 0, class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, NULL, NULL );
+}
+
+static HRESULT add_handler( struct toast *impl, enum toast_event_kind kind, void *handler, EventRegistrationToken *token )
+{
+    struct handler *entry;
+
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->handler = handler;
+    entry->apartment = apartment_window( handler );
+    ITypedEventHandler_ToastNotification_IInspectable_AddRef( entry->handler );
+    EnterCriticalSection( &impl->cs );
+    entry->token.value = ++impl->next_token;
+    list_add_tail( &impl->handlers[kind], &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT remove_handler( struct toast *impl, enum toast_event_kind kind, EventRegistrationToken token )
+{
+    struct handler *entry, *found = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->handlers[kind], struct handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (found)
+    {
+        ITypedEventHandler_ToastNotification_IInspectable_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
