+static ULONG WINAPI xml_node_Release( IXmlNode *iface )
+{
+    struct xml_node *impl = impl_from_IXmlNode( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        IXMLDOMNode_Release( impl->node );
+        free( impl );
+    }
+    return ref;
+}
