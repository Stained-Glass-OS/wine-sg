+    case NODE_ELEMENT: name = L"Windows.Data.Xml.Dom.XmlElement"; break;
+    case NODE_ATTRIBUTE: name = L"Windows.Data.Xml.Dom.XmlAttribute"; break;
+    case NODE_TEXT: name = L"Windows.Data.Xml.Dom.XmlText"; break;
+    case NODE_CDATA_SECTION: name = L"Windows.Data.Xml.Dom.XmlCDataSection"; break;
+    case NODE_ENTITY_REFERENCE: name = L"Windows.Data.Xml.Dom.XmlEntityReference"; break;
+    case NODE_PROCESSING_INSTRUCTION: name = L"Windows.Data.Xml.Dom.XmlProcessingInstruction"; break;
+    case NODE_COMMENT: name = L"Windows.Data.Xml.Dom.XmlComment"; break;
+    case NODE_DOCUMENT: name = L"Windows.Data.Xml.Dom.XmlDocument"; break;
+    case NODE_DOCUMENT_TYPE: name = L"Windows.Data.Xml.Dom.XmlDocumentType"; break;
+    case NODE_DOCUMENT_FRAGMENT: name = L"Windows.Data.Xml.Dom.XmlDocumentFragment"; break;
+    case NODE_ENTITY: name = L"Windows.Data.Xml.Dom.DtdEntity"; break;
+    case NODE_NOTATION: name = L"Windows.Data.Xml.Dom.DtdNotation"; break;
+    default: return E_NOTIMPL;
+    }
+    return WindowsCreateString( name, wcslen( name ), class_name );
