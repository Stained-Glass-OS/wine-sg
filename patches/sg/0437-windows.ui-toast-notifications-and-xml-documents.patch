+/* the value of a string, as the IPropertyValue WinRT boxes strings in */
+static HRESULT box_string( BSTR str, IInspectable **out )
+{
+    static const WCHAR property_value[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    HSTRING name, value;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = WindowsCreateString( property_value, wcslen( property_value ), &name ))) return hr;
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = hstring_from_bstr( str, &value )))
+    {
+        hr = IPropertyValueStatics_CreateString( statics, value, out );
+        WindowsDeleteString( value );
+    }
+    IPropertyValueStatics_Release( statics );
+    return hr;
+}
+
+static HRESULT unbox_string( IInspectable *value, BSTR *out )
+{
+    IPropertyValue *property;
+    HSTRING str;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!value) return S_OK;
+    if (FAILED(hr = IInspectable_QueryInterface( value, &IID_IPropertyValue, (void **)&property ))) return hr;
+    hr = IPropertyValue_GetString( property, &str );
+    IPropertyValue_Release( property );
+    if (FAILED(hr)) return hr;
+    *out = bstr_from_hstring( str );
+    WindowsDeleteString( str );
+    return S_OK;
+}
