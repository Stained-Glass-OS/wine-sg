+static HRESULT xml_node_create( IXMLDOMNode *node, REFIID iid, void **out )
+{
+    struct xml_node *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IXmlNode_iface.lpVtbl = &xml_node_vtbl;
+    impl->IXmlNodeSerializer_iface.lpVtbl = &xml_node_serializer_vtbl;
+    impl->IXmlNodeSelector_iface.lpVtbl = &xml_node_selector_vtbl;
+    impl->IXmlElement_iface.lpVtbl = &xml_element_vtbl;
+    impl->IXmlCharacterData_iface.lpVtbl = &xml_character_data_vtbl;
+    impl->IXmlText_iface.lpVtbl = &xml_text_vtbl;
+    impl->IXmlAttribute_iface.lpVtbl = &xml_attribute_vtbl;
+    impl->IXmlDocument_iface.lpVtbl = &xml_document_vtbl;
+    impl->IXmlDocumentIO_iface.lpVtbl = &xml_document_io_vtbl;
+    impl->ref = 1;
+    IXMLDOMNode_AddRef( (impl->node = node) );
+    IXMLDOMNode_get_nodeType( node, &impl->type );
+
+    hr = xml_node_QueryInterface( &impl->IXmlNode_iface, iid, out );
+    xml_node_Release( &impl->IXmlNode_iface );
+    return hr;
+}
+
+HRESULT xml_document_create( IXmlDocument **out )
+{
+    IXMLDOMDocument2 *doc;
+    VARIANT var;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = CoCreateInstance( &CLSID_DOMDocument60, NULL, CLSCTX_INPROC_SERVER, &IID_IXMLDOMDocument2, (void **)&doc )))
+    {
+        ERR( "no MSXML document, hr %#lx\n", hr );
+        return hr;
+    }
+    V_VT( &var ) = VT_BSTR;
+    V_BSTR( &var ) = SysAllocString( L"XPath" );
+    IXMLDOMDocument2_setProperty( doc, (BSTR)L"SelectionLanguage", var );
+    VariantClear( &var );
+    IXMLDOMDocument2_put_async( doc, VARIANT_FALSE );
+    IXMLDOMDocument2_put_preserveWhiteSpace( doc, VARIANT_TRUE );
+    hr = xml_node_create( (IXMLDOMNode *)doc, &IID_IXmlDocument, (void **)out );
+    IXMLDOMDocument2_Release( doc );
+    return hr;
+}
