+/* the name the program registered for its AppUserModelID, or its own */
+static WCHAR *app_display_name( const WCHAR *aumid )
+{
+    static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    WCHAR key[512], name[256], exe[MAX_PATH], *p;
+    DWORD size, handle;
+    void *version;
+    UINT i, len;
+    struct { WORD language, codepage; } *translation;
+
+    if (aumid && *aumid)
+    {
+        swprintf( key, ARRAY_SIZE(key), L"Software\\Classes\\AppUserModelId\\%s", aumid );
+        for (i = 0; i < ARRAY_SIZE(roots); i++)
+        {
+            size = sizeof(name);
+            if (!RegGetValueW( roots[i], key, L"DisplayName", RRF_RT_REG_SZ, NULL, name, &size ) && *name) return wcsdup( name );
+        }
+    }
+
+    GetModuleFileNameW( NULL, exe, ARRAY_SIZE(exe) );
+    if ((size = GetFileVersionInfoSizeW( exe, &handle )) && (version = malloc( size )))
+    {
+        WCHAR *description = NULL, *ret = NULL;
+        if (GetFileVersionInfoW( exe, 0, size, version ) &&
+            VerQueryValueW( version, L"\\VarFileInfo\\Translation", (void **)&translation, &len ) && len >= sizeof(*translation))
+        {
+            swprintf( key, ARRAY_SIZE(key), L"\\StringFileInfo\\%04x%04x\\FileDescription", translation->language,
+                      translation->codepage );
+            if (VerQueryValueW( version, key, (void **)&description, &len ) && len > 1 && *description)
+                ret = wcsdup( description );
+        }
+        free( version );
+        if (ret) return ret;
+    }
+    p = wcsrchr( exe, '\\' );
+    p = p ? p + 1 : exe;
+    if (wcsrchr( p, '.' )) *wcsrchr( p, '.' ) = 0;
+    return wcsdup( p );
+}
+
+static IXMLDOMDocument *toast_dom( IXmlDocument *content )
+{
+    IXMLDOMDocument *doc = xml_document_dom( content );
+    IXmlNodeSerializer *serializer;
+    IXmlDocument *copy;
+    IXmlDocumentIO *io;
+    HSTRING xml;
+
+    if (doc) return doc;
+    /* another XmlDocument implementation: go through its text */
+    if (FAILED(IXmlDocument_QueryInterface( content, &IID_IXmlNodeSerializer, (void **)&serializer ))) return NULL;
+    if (SUCCEEDED(IXmlNodeSerializer_GetXml( serializer, &xml )))
+    {
+        if (SUCCEEDED(xml_document_create( &copy )))
+        {
+            if (SUCCEEDED(IXmlDocument_QueryInterface( copy, &IID_IXmlDocumentIO, (void **)&io )))
+            {
+                if (SUCCEEDED(IXmlDocumentIO_LoadXml( io, xml ))) doc = xml_document_dom( copy );
+                IXmlDocumentIO_Release( io );
+            }
+            IXmlDocument_Release( copy );
+        }
+        WindowsDeleteString( xml );
+    }
+    IXmlNodeSerializer_Release( serializer );
+    return doc;
+}
+
+static struct toast_view *create_view( struct toast *toast, const WCHAR *aumid )
+{
+    IXMLDOMDocument *doc;
+    IXMLDOMNodeList *list;
+    IXMLDOMNode *root, *node;
+    struct toast_view *view;
+    WCHAR *scenario, *duration, *type, *src;
+    BSTR path, text;
+    WCHAR exe[MAX_PATH];
+    BOOL first = TRUE;
+
+    if (!(doc = toast_dom( toast->content ))) return NULL;
+    if (!(view = calloc( 1, sizeof(*view) )))
+    {
+        IXMLDOMDocument_Release( doc );
+        return NULL;
+    }
+    root = (IXMLDOMNode *)doc;
+    view->hot = -2;
+    view->app_name = app_display_name( aumid );
+    GetModuleFileNameW( NULL, exe, ARRAY_SIZE(exe) );
+    ExtractIconExW( exe, 0, NULL, &view->icon, 1 );
+
+    /* the texts of the first binding: a title, then the body */
+    path = SysAllocString( L"/toast/visual/binding[1]/text" );
+    if (SUCCEEDED(IXMLDOMNode_selectNodes( root, path, &list )))
+    {
+        while (IXMLDOMNodeList_nextNode( list, &node ) == S_OK && node)
+        {
+            WCHAR *placement = NULL;
+            IXMLDOMElement *element;
+            VARIANT var;
+
+            if (SUCCEEDED(IXMLDOMNode_QueryInterface( node, &IID_IXMLDOMElement, (void **)&element )))
+            {
+                VariantInit( &var );
+                if (IXMLDOMElement_getAttribute( element, (BSTR)L"placement", &var ) == S_OK && V_VT( &var ) == VT_BSTR)
+                    placement = wcsdup_bstr( V_BSTR( &var ) );
+                VariantClear( &var );
+                IXMLDOMElement_Release( element );
+            }
+            if (SUCCEEDED(IXMLDOMNode_get_text( node, &text )) && text && *text)
+            {
+                if (placement && !wcscmp( placement, L"attribution" )) view->attribution = wcsdup_bstr( text );
+                else if (first) view->title = wcsdup_bstr( text );
+                else view->body = append_line( view->body, text );
+                if (!placement || wcscmp( placement, L"attribution" )) first = FALSE;
+            }
+            SysFreeString( text );
+            free( placement );
+            IXMLDOMNode_Release( node );
+        }
+        IXMLDOMNodeList_Release( list );
+    }
+    SysFreeString( path );
+
+    /* the logo: appLogoOverride, or the image of the old templates */
+    if (!(src = select_text( root, L"/toast/visual/binding[1]/image[@placement='appLogoOverride']/@src" )))
+        src = select_text( root, L"/toast/visual/binding[1]/image[not(@placement)]/@src" );
+    if (src)
+    {
+        view->logo = load_image( src );
+        free( src );
+    }
+
+    view->launch = select_text( root, L"/toast/@launch" );
+    type = select_text( root, L"/toast/@activationType" );
+    view->launch_protocol = type && !wcscmp( type, L"protocol" );
+    free( type );
+
+    path = SysAllocString( L"/toast/actions/action[not(@placement='contextMenu')]" );
+    if (SUCCEEDED(IXMLDOMNode_selectNodes( root, path, &list )))
+    {
+        while (view->action_count < ARRAY_SIZE(view->actions) && IXMLDOMNodeList_nextNode( list, &node ) == S_OK && node)
+        {
+            struct toast_action *action = &view->actions[view->action_count];
+            if ((action->content = select_text( node, L"@content" )))
+            {
+                action->arguments = select_text( node, L"@arguments" );
+                type = select_text( node, L"@activationType" );
+                action->protocol = type && !wcscmp( type, L"protocol" );
+                free( type );
+                view->action_count++;
+            }
+            IXMLDOMNode_Release( node );
+        }
+        IXMLDOMNodeList_Release( list );
+    }
+    SysFreeString( path );
+
+    scenario = select_text( root, L"/toast/@scenario" );
+    duration = select_text( root, L"/toast/@duration" );
+    if (scenario && (!wcscmp( scenario, L"reminder" ) || !wcscmp( scenario, L"alarm" ) ||
+                     !wcscmp( scenario, L"incomingCall" ) || !wcscmp( scenario, L"urgent" )))
+        view->timeout = 0;
+    else if (duration && !wcscmp( duration, L"long" )) view->timeout = 25000;
+    else view->timeout = 7000;
+    free( scenario );
+    free( duration );
+
+    IXMLDOMDocument_Release( doc );
+    TRACE( "title %s, body %s, launch %s, %u actions, timeout %u\n", debugstr_w(view->title), debugstr_w(view->body),
+           debugstr_w(view->launch), view->action_count, view->timeout );
+    view->toast = toast;
+    IToastNotification_AddRef( &toast->IToastNotification_iface );
+    return view;
+}
+
+/* closes the toasts on screen that match; with raise, as the program hiding them */
+struct close_match
+{
+    const WCHAR *aumid;
+    HSTRING tag, group;
+    BOOL match_tag, match_group;
+    struct toast *toast;
+    BOOL raise;
+};
+
+static void close_matching( const struct close_match *match )
+{
+    HWND *windows = NULL, hwnd = NULL;
+    UINT count = 0, capacity = 0, i;
+    WCHAR name[64];
+
+    /* our own toasts only: those of this process */
+    while ((hwnd = FindWindowExW( HWND_DESKTOP, hwnd, TOAST_CLASS, NULL )))
+    {
+        struct toast_view *view;
+        DWORD pid;
+
+        GetWindowThreadProcessId( hwnd, &pid );
+        if (pid != GetCurrentProcessId() || !GetClassNameW( hwnd, name, ARRAY_SIZE(name) )) continue;
+        if (!(view = (struct toast_view *)GetWindowLongPtrW( hwnd, GWLP_USERDATA ))) continue;
+        if (match->toast && view->toast != match->toast) continue;
+        if (match->aumid && (!view->toast->aumid || wcsicmp( view->toast->aumid, match->aumid ))) continue;
+        if (match->match_tag && !hstring_equal( view->toast->tag, match->tag )) continue;
+        if (match->match_group && !hstring_equal( view->toast->group, match->group )) continue;
+        if (count == capacity)
+        {
+            HWND *grown = realloc( windows, (capacity = capacity * 2 + 4) * sizeof(*windows) );
+            if (!grown) break;
+            windows = grown;
+        }
+        windows[count++] = hwnd;
+    }
+    for (i = 0; i < count; i++) SendMessageW( windows[i], WM_TOAST_CLOSE, match->raise, 0 );
+    free( windows );
+}
