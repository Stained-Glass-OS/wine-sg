+static HRESULT WINAPI manager_statics_CreateToastNotifier( IToastNotificationManagerStatics *iface, IToastNotifier **result )
+{
+    WCHAR aumid[256], exe[MAX_PATH], *name;
+    UINT32 len = ARRAY_SIZE(aumid);
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    /* a packaged program's own identity; a desktop program has none on
+     * Windows, and gets its executable's name here */
+    if (GetCurrentApplicationUserModelId( &len, aumid ))
+    {
+        GetModuleFileNameW( NULL, exe, ARRAY_SIZE(exe) );
+        name = wcsrchr( exe, '\\' );
+        lstrcpynW( aumid, name ? name + 1 : exe, ARRAY_SIZE(aumid) );
