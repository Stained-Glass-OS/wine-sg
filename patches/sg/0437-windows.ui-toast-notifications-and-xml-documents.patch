+static HRESULT WINAPI xml_node_view_IndexOf( IVectorView_IXmlNode *iface, IXmlNode *element, UINT32 *index, boolean *found )
+{
+    struct xml_node_list *impl = impl_from_IVectorView_IXmlNode( iface );
+    IXMLDOMNode *wanted = dom_node( (IUnknown *)element ), *item;
+    UINT32 size, i;
+
+    *found = FALSE;
+    *index = 0;
+    if (!wanted || FAILED(xml_node_list_get_Length( &impl->IXmlNodeList_iface, &size ))) return S_OK;
+    for (i = 0; i < size; i++)
+    {
+        if (IXMLDOMNodeList_get_item( impl->list, i, &item ) != S_OK) continue;
+        IXMLDOMNode_Release( item );
+        if (item == wanted)
+        {
+            *found = TRUE;
+            *index = i;
+            break;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI xml_node_view_GetMany( IVectorView_IXmlNode *iface, UINT32 start_index, UINT32 items_size,
+                                             IXmlNode **items, UINT32 *count )
+{
+    struct xml_node_list *impl = impl_from_IVectorView_IXmlNode( iface );
+    UINT32 size, i;
+    HRESULT hr;
+
+    *count = 0;
+    if (FAILED(hr = xml_node_list_get_Length( &impl->IXmlNodeList_iface, &size ))) return hr;
+    if (start_index > size) return E_BOUNDS;
+    for (i = start_index; i < size && i - start_index < items_size; i++)
+    {
+        if (FAILED(hr = xml_node_list_Item( &impl->IXmlNodeList_iface, i, &items[i - start_index] )))
+        {
+            while (i-- > start_index) IXmlNode_Release( items[i - start_index] );
+            return hr;
+        }
+    }
+    *count = i - start_index;
+    return S_OK;
+}
