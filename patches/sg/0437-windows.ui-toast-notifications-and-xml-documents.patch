+/* MSXML indents what it writes; WinRT writes the markup as it is: drop the
+ * line breaks and indentation it puts between tags */
+static UINT compact_xml( WCHAR *str, UINT len )
+{
+    UINT i, j, out = 0;
+
+    for (i = 0; i < len; i++)
+    {
+        if (str[i] == '>' || !i)
+        {
+            BOOL newline = FALSE;
+            if (str[i] == '>') str[out++] = str[i++];
+            for (j = i; j < len && (str[j] == ' ' || str[j] == '\t' || str[j] == '\r' || str[j] == '\n'); j++)
+                if (str[j] == '\n') newline = TRUE;
+            if ((newline || !out) && (j == len || str[j] == '<')) i = j;
+            if (i == len) break;
+        }
+        str[out++] = str[i];
+    }
+    return out;
+}
+
+static HRESULT WINAPI xml_node_serializer_GetXml( IXmlNodeSerializer *iface, HSTRING *outer_xml )
+{
+    struct xml_node *impl = impl_from_IXmlNodeSerializer( iface );
+    HRESULT hr;
+    BSTR str;
+
+    TRACE( "iface %p, outer_xml %p.\n", iface, outer_xml );
+
+    if (FAILED(hr = IXMLDOMNode_get_xml( impl->node, &str ))) return hr;
+    hr = WindowsCreateString( str, str ? compact_xml( str, SysStringLen( str ) ) : 0, outer_xml );
+    SysFreeString( str );
+    return hr;
+}
