+/* A toast is shown by the program that sends it, in a window of its own at
+ * the bottom right of the screen above the taskbar, stacked with the toasts
+ * of other programs.  Clicking it (or one of its buttons) raises Activated,
+ * its close button or its time running out raise Dismissed. */
+
+#define TOAST_CLASS L"WineToastNotification"
+
+enum toast_event_kind
+{
+    TOAST_ACTIVATED,
+    TOAST_DISMISSED,
+    TOAST_FAILED,
+};
+
+struct handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_ToastNotification_IInspectable *handler;
+    HWND apartment;         /* the single-threaded apartment the handler lives in */
+};
+
+struct toast
+{
+    IToastNotification IToastNotification_iface;
+    IToastNotification2 IToastNotification2_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    IXmlDocument *content;
+    IReference_DateTime *expiration;
+    HSTRING tag, group;
+    boolean suppress_popup;
+    struct list handlers[3];
+    INT64 next_token;
+    HWND hwnd;              /* the toast on screen; guarded by toast_cs */
+    WCHAR *aumid;           /* the notifier that showed it */
+};
+
+struct toast_action
+{
+    WCHAR *content;
+    WCHAR *arguments;
+    BOOL protocol;
+    RECT rect;
+};
+
+/* what the toast window shows, from the toast's XML */
+struct toast_view
+{
+    struct toast *toast;
+    WCHAR *app_name;
+    WCHAR *title;
+    WCHAR *body;
+    WCHAR *attribution;
+    WCHAR *launch;
+    BOOL launch_protocol;
+    struct toast_action actions[5];
+    UINT action_count;
+    HBITMAP logo;
+    HICON icon;
+    UINT timeout;
+    int hot;                /* -2 nothing, -1 close button, 0.. action */
+    BOOL tracking;
+    RECT close_rect;
+};
