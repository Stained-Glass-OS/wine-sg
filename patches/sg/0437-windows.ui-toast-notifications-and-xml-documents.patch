+struct toast_event_args
+{
+    IToastActivatedEventArgs IToastActivatedEventArgs_iface;
+    IToastDismissedEventArgs IToastDismissedEventArgs_iface;
+    IToastFailedEventArgs IToastFailedEventArgs_iface;
+    LONG ref;
+    enum toast_event_kind kind;
+    HSTRING arguments;
+    ToastDismissalReason reason;
+    HRESULT error;
+};
+
+static inline struct toast_event_args *impl_from_IToastActivatedEventArgs( IToastActivatedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct toast_event_args, IToastActivatedEventArgs_iface );
+}
+
+static HRESULT WINAPI event_args_QueryInterface( IToastActivatedEventArgs *iface, REFIID iid, void **out )
+{
+    struct toast_event_args *impl = impl_from_IToastActivatedEventArgs( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IToastActivatedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IToastActivatedEventArgs ) && impl->kind == TOAST_ACTIVATED)
+        *out = &impl->IToastActivatedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IToastDismissedEventArgs ) && impl->kind == TOAST_DISMISSED)
+        *out = &impl->IToastDismissedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IToastFailedEventArgs ) && impl->kind == TOAST_FAILED)
+        *out = &impl->IToastFailedEventArgs_iface;
+
+    if (!*out)
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI event_args_AddRef( IToastActivatedEventArgs *iface )
+{
+    struct toast_event_args *impl = impl_from_IToastActivatedEventArgs( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI event_args_Release( IToastActivatedEventArgs *iface )
+{
+    struct toast_event_args *impl = impl_from_IToastActivatedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->arguments );
+        free( impl );
+    }
+    return ref;
+}
