+    struct xml_node *impl = impl_from_IXmlNode( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IXmlNode ))
+        *out = &impl->IXmlNode_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlNodeSerializer ))
+        *out = &impl->IXmlNodeSerializer_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlNodeSelector ))
+        *out = &impl->IXmlNodeSelector_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlElement ) && impl->type == NODE_ELEMENT)
+        *out = &impl->IXmlElement_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlCharacterData ) &&
+             (impl->type == NODE_TEXT || impl->type == NODE_CDATA_SECTION || impl->type == NODE_COMMENT))
+        *out = &impl->IXmlCharacterData_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlText ) && (impl->type == NODE_TEXT || impl->type == NODE_CDATA_SECTION))
+        *out = &impl->IXmlText_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlAttribute ) && impl->type == NODE_ATTRIBUTE)
+        *out = &impl->IXmlAttribute_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlDocument ) && impl->type == NODE_DOCUMENT)
+        *out = &impl->IXmlDocument_iface;
+    else if (IsEqualGUID( iid, &IID_IXmlDocumentIO ) && impl->type == NODE_DOCUMENT)
+        *out = &impl->IXmlDocumentIO_iface;
+    /* interfaces without methods of their own */
+    else if ((IsEqualGUID( iid, &IID_IXmlComment ) && impl->type == NODE_COMMENT) ||
+             (IsEqualGUID( iid, &IID_IXmlCDataSection ) && impl->type == NODE_CDATA_SECTION) ||
+             (IsEqualGUID( iid, &IID_IXmlDocumentFragment ) && impl->type == NODE_DOCUMENT_FRAGMENT) ||
+             (IsEqualGUID( iid, &IID_IXmlEntityReference ) && impl->type == NODE_ENTITY_REFERENCE))
+        *out = &impl->IXmlNode_iface;
+
+    if (!*out)
+    {
+        TRACE( "%s not implemented for node type %d, returning E_NOINTERFACE.\n", debugstr_guid( iid ), impl->type );
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
