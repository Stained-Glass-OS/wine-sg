+static BOOL notifications_enabled( const WCHAR *aumid )
+{
+    WCHAR key[512];
+    DWORD value, size = sizeof(value);
+
+    /* Settings > Notifications turns them off for everyone, or for one program */
+    if (!RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\PushNotifications",
+                       L"ToastEnabled", RRF_RT_REG_DWORD, NULL, &value, &size ) && !value)
+        return FALSE;
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings\\%s", aumid );
+    size = sizeof(value);
+    if (!RegGetValueW( HKEY_CURRENT_USER, key, L"Enabled", RRF_RT_REG_DWORD, NULL, &value, &size ) && !value)
+        return FALSE;
+    return TRUE;
+}
+
+static HRESULT WINAPI notifier_Show( IToastNotifier *iface, IToastNotification *notification )
+{
+    struct notifier *impl = impl_from_IToastNotifier( iface );
+    struct toast *toast = unsafe_impl_from_IToastNotification( notification );
+    struct close_match match = {0};
+    struct toast_view *view;
+
+    TRACE( "iface %p, notification %p.\n", iface, notification );
+
+    if (!toast) return E_INVALIDARG;
+    if (!notifications_enabled( impl->aumid ))
+    {
+        TRACE( "notifications are turned off for %s\n", debugstr_w(impl->aumid) );
+        return S_OK;
+    }
+
+    EnterCriticalSection( &toast->cs );
+    free( toast->aumid );
+    toast->aumid = wcsdup( impl->aumid );
+    LeaveCriticalSection( &toast->cs );
+
+    /* a toast with the same tag and group replaces the one on screen */
+    if (toast->tag && WindowsGetStringLen( toast->tag ))
+    {
+        match.aumid = impl->aumid;
+        match.tag = toast->tag;
+        match.group = toast->group;
+        match.match_tag = match.match_group = TRUE;
+        close_matching( &match );
+    }
+
+    if (toast->suppress_popup) return S_OK;
+    if (!start_toast_thread()) return E_FAIL;
+    if (!(view = create_view( toast, impl->aumid )))
+    {
+        raise_event( toast, TOAST_FAILED, NULL, 0, E_INVALIDARG );
+        return S_OK;
+    }
+    if (!PostThreadMessageW( ui_thread_id, WM_TOAST_SHOW, 0, (LPARAM)view ))
+    {
+        free_view( view );
+        return E_FAIL;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI notifier_Hide( IToastNotifier *iface, IToastNotification *notification )
+{
+    struct toast *toast = unsafe_impl_from_IToastNotification( notification );
+    struct close_match match = {0};
+
+    TRACE( "iface %p, notification %p.\n", iface, notification );
+
+    if (!toast) return E_INVALIDARG;
+    match.toast = toast;
+    match.raise = TRUE;
+    close_matching( &match );
+    return S_OK;
+}
