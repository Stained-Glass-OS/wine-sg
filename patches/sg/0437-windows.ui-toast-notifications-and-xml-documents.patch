+/*
+ * Reading the toast's XML
+ */
+
+static WCHAR *select_text( IXMLDOMNode *root, const WCHAR *xpath )
+{
+    IXMLDOMNode *node = NULL;
+    BSTR path = SysAllocString( xpath ), text = NULL;
+    WCHAR *ret = NULL;
+
+    if (IXMLDOMNode_selectSingleNode( root, path, &node ) == S_OK)
+    {
+        if (SUCCEEDED(IXMLDOMNode_get_text( node, &text )) && text && *text) ret = wcsdup_bstr( text );
+        SysFreeString( text );
+        IXMLDOMNode_Release( node );
+    }
+    SysFreeString( path );
+    return ret;
+}
+
+static WCHAR *append_line( WCHAR *str, const WCHAR *line )
+{
+    size_t len = str ? wcslen( str ) : 0;
+    WCHAR *ret = realloc( str, (len + wcslen( line ) + 2) * sizeof(WCHAR) );
+    if (!ret) return str;
+    if (len) ret[len++] = '\n';
+    wcscpy( ret + len, line );
+    return ret;
+}
