+static ULONG WINAPI xml_node_AddRef( IXmlNode *iface )
+{
+    struct xml_node *impl = impl_from_IXmlNode( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
