+static WCHAR *wcsdup_hstring( HSTRING str )
+{
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( str, &len );
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+    if (ret)
+    {
+        memcpy( ret, buf, len * sizeof(WCHAR) );
+        ret[len] = 0;
+    }
+    return ret;
+}
+
+static WCHAR *wcsdup_bstr( BSTR str )
+{
+    return str ? wcsdup( str ) : NULL;
+}
+
+static BOOL hstring_equal( HSTRING a, HSTRING b )
+{
+    INT32 order = 1;
+    WindowsCompareStringOrdinal( a, b, &order );
+    return !order;
+}
