+static HRESULT WINAPI xml_node_view_GetAt( IVectorView_IXmlNode *iface, UINT32 index, IXmlNode **value )
+{
+    struct xml_node_list *impl = impl_from_IVectorView_IXmlNode( iface );
+    UINT32 size;
+    HRESULT hr;
+
+    if (FAILED(hr = xml_node_list_get_Length( &impl->IXmlNodeList_iface, &size ))) return hr;
+    if (index >= size) return E_BOUNDS;
+    return xml_node_list_Item( &impl->IXmlNodeList_iface, index, value );
+}
