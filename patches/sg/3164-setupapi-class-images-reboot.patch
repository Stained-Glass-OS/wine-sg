-INT WINAPI SetupPromptReboot( HSPFILEQ file_queue, HWND owner, BOOL scan_only )
+/* Class images: the list holds one small icon per registered device class, plus an
+ * "unknown class" icon at index 0. Reserved of SP_CLASSIMAGELIST_DATA points at the
+ * GUID table of that list. */
+struct class_image_entry { GUID guid; INT index; };
+struct class_image_table
+{
+    HIMAGELIST list;
+    UINT count;
+    struct class_image_entry *entries;
+};
+
+static HMODULE comctl32;
+static HIMAGELIST (WINAPI *pImageList_Create)(int, int, UINT, int, int);
+static INT (WINAPI *pImageList_ReplaceIcon)(HIMAGELIST, INT, HICON);
+static BOOL (WINAPI *pImageList_Destroy)(HIMAGELIST);
+
+static BOOL load_imagelist_functions(void)
+{
+    if (pImageList_Destroy) return TRUE;
+    if (!(comctl32 = LoadLibraryW( L"comctl32.dll" ))) return FALSE;
+    pImageList_Create = (void *)GetProcAddress( comctl32, "ImageList_Create" );
+    pImageList_ReplaceIcon = (void *)GetProcAddress( comctl32, "ImageList_ReplaceIcon" );
+    pImageList_Destroy = (void *)GetProcAddress( comctl32, "ImageList_Destroy" );
+    return pImageList_Create && pImageList_ReplaceIcon && pImageList_Destroy;
+}
+
+static HKEY open_class_key( const GUID *guid, const WCHAR *machine )
+{
+    WCHAR path[128], str[40];
+    HKEY key;
+
+    if (machine && machine[0]) return NULL;
+    StringFromGUID2( guid, str, ARRAY_SIZE(str) );
+    swprintf( path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\Class\\%s", str );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key )) return NULL;
+    return key;
+}
+
+static HICON generic_class_icon( int size )
+{
+    HICON icon = LoadImageW( NULL, (const WCHAR *)IDI_APPLICATION, IMAGE_ICON, size, size, LR_SHARED );
+    HICON copy = icon ? CopyIcon( icon ) : NULL;
+    return copy;
+}
+
+/* the class's own icon from IconPath ("file,-resid" or "file,index") or Icon (a resource id
+ * of setupapi.dll); the generic application icon when it has none or cannot be loaded */
+static HICON load_class_icon_size( const GUID *guid, int size )
+{
+    HICON icon = NULL;
+    HKEY key = guid ? open_class_key( guid, NULL ) : NULL;
+
+    if (key)
+    {
+        WCHAR buf[MAX_PATH + 16];
+        DWORD len = sizeof(buf) - 2 * sizeof(WCHAR), type;
+
+        memset( buf, 0, sizeof(buf) );
+        if (!RegQueryValueExW( key, L"IconPath", NULL, &type, (BYTE *)buf, &len ) && buf[0]
+            && (type == REG_MULTI_SZ || type == REG_SZ))
+        {
+            WCHAR *comma = wcsrchr( buf, ',' );
+            int idx = 0;
+            if (comma) { *comma = 0; idx = wcstol( comma + 1, NULL, 10 ); }
+            if (!PrivateExtractIconsW( buf, idx, size, size, &icon, NULL, 1, 0 )) icon = NULL;
+        }
+        else
+        {
+            len = sizeof(buf) - 2 * sizeof(WCHAR);
+            if (!RegQueryValueExW( key, L"Icon", NULL, &type, (BYTE *)buf, &len ) && type == REG_SZ && buf[0])
+            {
+                int id = abs( wcstol( buf, NULL, 10 ) );
+                icon = LoadImageW( GetModuleHandleW( L"setupapi.dll" ), MAKEINTRESOURCEW( id ), IMAGE_ICON,
+                                   size, size, 0 );
+            }
+        }
+        RegCloseKey( key );
+    }
+    if (!icon) icon = generic_class_icon( size );
+    return icon;
+}
+
+static void free_class_image_table( struct class_image_table *table )
+{
+    if (!table) return;
+    if (table->list) pImageList_Destroy( table->list );
+    free( table->entries );
+    free( table );
+}
+
+static struct class_image_table *build_class_image_table(void)
+{
+    struct class_image_table *table;
+    int cx = GetSystemMetrics( SM_CXSMICON ), cy = GetSystemMetrics( SM_CYSMICON );
+    HKEY classes;
+    DWORD i, n = 0;
+    WCHAR name[64];
+    HICON icon;
+
+    if (!load_imagelist_functions()) return NULL;
+    if (!(table = calloc( 1, sizeof(*table) ))) return NULL;
+    table->list = pImageList_Create( cx, cy, ILC_COLOR32 | ILC_MASK, 16, 16 );
+    if (!table->list) { free( table ); return NULL; }
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Class", 0,
+                       KEY_READ, &classes ))
+        classes = NULL;
+    if (classes) RegQueryInfoKeyW( classes, NULL, NULL, NULL, &n, NULL, NULL, NULL, NULL, NULL, NULL, NULL );
+    table->entries = calloc( n + 1, sizeof(*table->entries) );
+    if (!table->entries) { if (classes) RegCloseKey( classes ); free_class_image_table( table ); return NULL; }
+
+    /* index 0: the unknown class */
+    icon = load_class_icon_size( NULL, cx );
+    table->entries[0].index = pImageList_ReplaceIcon( table->list, -1, icon );
+    if (icon) DestroyIcon( icon );
+    table->count = 1;
+
+    for (i = 0; classes && i < n; i++)
+    {
+        DWORD len = ARRAY_SIZE(name);
+        GUID guid;
+        if (RegEnumKeyExW( classes, i, name, &len, NULL, NULL, NULL, NULL )) break;
+#ifdef SG_MUTANT_SETUP_NOCLASSES
+        continue;
+#endif
+        if (CLSIDFromString( name, &guid )) continue;
+        icon = load_class_icon_size( &guid, cx );
+        table->entries[table->count].guid = guid;
+        table->entries[table->count].index = pImageList_ReplaceIcon( table->list, -1, icon );
+        table->count++;
+        if (icon) DestroyIcon( icon );
+    }
+    if (classes) RegCloseKey( classes );
+    return table;
+}
+
+static INT class_table_index( const struct class_image_table *table, const GUID *guid )
 {
-    FIXME("%p, %p, %d: stub\n", file_queue, owner, scan_only);
-    return 0;
+    UINT i;
+
+    if (!guid || IsEqualGUID( guid, &GUID_NULL )) return table->entries[0].index;
+    for (i = 1; i < table->count; i++)
+        if (IsEqualGUID( &table->entries[i].guid, guid )) return table->entries[i].index;
+    return -1;
 }
 
