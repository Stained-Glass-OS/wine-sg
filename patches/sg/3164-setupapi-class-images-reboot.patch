+/***********************************************************************
+ *      SetupDiGetClassImageListExW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetClassImageListExW(PSP_CLASSIMAGELIST_DATA ClassImageListData, PCWSTR MachineName, PVOID Reserved)
+{
+    struct class_image_table *table;
+
+    TRACE("(%p, %s, %p)\n", ClassImageListData, debugstr_w(MachineName), Reserved);
+
+    if (!ClassImageListData || ClassImageListData->cbSize != sizeof(*ClassImageListData) || Reserved)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (MachineName && MachineName[0])
+    {
+        SetLastError(ERROR_INVALID_MACHINENAME);
+        return FALSE;
+    }
+    if (!(table = build_class_image_table()))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    ClassImageListData->ImageList = table->list;
+    ClassImageListData->Reserved = (ULONG_PTR)table;
     return TRUE;
 }
 
+/***********************************************************************
+ *      SetupDiGetClassImageListExA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupDiGetClassImageListExA(PSP_CLASSIMAGELIST_DATA ClassImageListData, PCSTR MachineName, PVOID Reserved)
+{
+    WCHAR *machine = NULL;
+    BOOL ret;
+
+    if (MachineName)
+    {
+        int len = MultiByteToWideChar( CP_ACP, 0, MachineName, -1, NULL, 0 );
+        if (!(machine = malloc( len * sizeof(WCHAR) ))) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return FALSE; }
+        MultiByteToWideChar( CP_ACP, 0, MachineName, -1, machine, len );
+    }
+    ret = SetupDiGetClassImageListExW( ClassImageListData, machine, Reserved );
+    free( machine );
+    return ret;
+}
+
