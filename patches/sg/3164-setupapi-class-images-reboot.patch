 /***********************************************************************
- *      SetupDiGetClassImageList (SETUPAPI.@)
+ *      SetupDiGetClassImageIndex (SETUPAPI.@)
  */
 BOOL WINAPI SetupDiGetClassImageIndex(PSP_CLASSIMAGELIST_DATA ClassImageListData, const GUID *class, PINT index)
 {
-    FIXME("%p %p %p\n", ClassImageListData, class, index);
-    return FALSE;
+    struct class_image_table *table;
+    INT i;
+
+    TRACE("%p %s %p\n", ClassImageListData, debugstr_guid(class), index);
+
+    if (!ClassImageListData || ClassImageListData->cbSize != sizeof(*ClassImageListData)
+        || !ClassImageListData->Reserved || !class || !index)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    table = (struct class_image_table *)ClassImageListData->Reserved;
+    if ((i = class_table_index( table, class )) < 0)
+    {
+        SetLastError(ERROR_INVALID_CLASS);
+        return FALSE;
+    }
+    *index = i;
+    return TRUE;
 }
 
