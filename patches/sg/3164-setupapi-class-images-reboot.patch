+/***********************************************************************
+ *      SetupPromptReboot(SETUPAPI.@)
+ */
+INT WINAPI SetupPromptReboot( HSPFILEQ file_queue, HWND owner, BOOL scan_only )
+{
+    struct file_queue *queue = file_queue;
+    INT ret = 0;
+
+    TRACE("%p, %p, %d\n", file_queue, owner, scan_only);
+
+    if (scan_only && (!queue || queue == INVALID_HANDLE_VALUE))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return -1;
+    }
+
+    if (queue && queue != INVALID_HANDLE_VALUE)
+    {
+        if (queue->magic != FILE_QUEUE_MAGIC)
+        {
+            SetLastError(ERROR_INVALID_HANDLE);
+            return -1;
+        }
+        ret = queue->reboot;
+        /* a restart only matters when a file was replaced at the next boot */
+        if (!(ret & SG_SPFILEQ_REBOOT_RECOMMENDED)) return ret;
+    }
+    else ret = SG_SPFILEQ_REBOOT_RECOMMENDED;
+
+    if (scan_only) return ret;
+
+    if (MessageBoxW( owner, L"You must restart your computer before the new settings will take effect.\n\n"
+                     L"Do you want to restart your computer now?", L"System Settings Change",
+                     MB_YESNO | MB_ICONQUESTION | MB_SETFOREGROUND ) == IDYES)
+    {
+        if (ExitWindowsEx( EWX_REBOOT, SHTDN_REASON_MAJOR_SOFTWARE | SHTDN_REASON_MINOR_INSTALLATION ))
+            ret |= SG_SPFILEQ_REBOOT_IN_PROGRESS;
+    }
+    return ret;
+}
