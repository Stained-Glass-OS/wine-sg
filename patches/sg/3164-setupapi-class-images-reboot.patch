  *      SetupDiGetClassImageList (SETUPAPI.@)
  */
 BOOL WINAPI SetupDiGetClassImageList(PSP_CLASSIMAGELIST_DATA ClassImageListData)
 {
-    FIXME("(%p) stub\n", ClassImageListData);
-    return FALSE;
