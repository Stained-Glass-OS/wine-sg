+    if (LargeIcon && !(*LargeIcon = load_class_icon_size( ClassGuid, GetSystemMetrics( SM_CXICON ) )))
+        return FALSE;
+    if (MiniIconIndex && !SetupDiGetClassBitmapIndex( ClassGuid, MiniIconIndex ))
+    {
+        if (LargeIcon) { DestroyIcon( *LargeIcon ); *LargeIcon = NULL; }
+        return FALSE;
+    }
+    return TRUE;
 }
 
