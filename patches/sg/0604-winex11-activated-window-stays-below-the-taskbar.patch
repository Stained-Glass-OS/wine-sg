From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: an activated window stays below the taskbar

In a virtual desktop, activating a window that is not topmost raised its X
window above every other, the taskbar (explorer's, topmost) too, until the
bar raised itself again: a frame of the window where the bar is (David).
The window now goes right below the lowest topmost window of any process,
and a window whose predecessor is another program's topmost one stacks
below it.
---
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1358,12 +1358,43 @@
      * popup opened hidden under its owner. */
     NtUserGetWindowThread( hwnd, &pid );
     NtUserGetWindowThread( prev, &prev_pid );
-    if (pid != prev_pid) return FALSE;
+    if (pid != prev_pid)
+    {
+        /* ... except a topmost one (the taskbar) over a window that is not:
+         * that one goes right below it. Raised to the top instead, a window
+         * activated from the taskbar was over the bar until the bar raised
+         * itself again -- a frame of the window where the bar is (David). */
+        if ((NtUserGetWindowLongW( prev, GWL_EXSTYLE ) & WS_EX_TOPMOST) &&
+            !(NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) &&
+            !NtUserGetWindowRelative( hwnd, GW_OWNER ))
+        {
+            *below = X11DRV_get_whole_window( prev );
+            if (topmost) *topmost = TRUE;
+        }
+        return FALSE;
+    }
     *below = X11DRV_get_whole_window( prev );
     if (topmost) *topmost = !!(NtUserGetWindowLongW( prev, GWL_EXSTYLE ) & WS_EX_TOPMOST);
     return FALSE;
 }
 
+/* In a virtual desktop, the X window of the lowest visible topmost window,
+ * of any process, other than hwnd: the top of the band a window that is not
+ * topmost may reach (0: none). The taskbar is one. */
+Window get_topmost_floor( HWND hwnd )
+{
+    HWND w = NtUserGetWindowRelative( NtUserGetDesktopWindow(), GW_CHILD );
+    Window floor = 0, x;
+
+    if (!is_virtual_desktop()) return 0;
+    for (; w && (NtUserGetWindowLongW( w, GWL_EXSTYLE ) & WS_EX_TOPMOST); w = NtUserGetWindowRelative( w, GW_HWNDNEXT ))
+    {
+        if (w == hwnd || !(NtUserGetWindowLongW( w, GWL_STYLE ) & WS_VISIBLE)) continue;
+        if ((x = X11DRV_get_whole_window( w ))) floor = x;
+    }
+    return floor;
+}
+
 /* stack the window right below another; FALSE when that is no sibling */
 BOOL stack_window_below( Display *display, Window window, Window below )
 {
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -648,8 +648,16 @@
         (NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) ||
         !stack_window_below( data->display, data->whole_window, below ))
     {
-        changes.stack_mode = Above;
-        XConfigureWindow( data->display, data->whole_window, CWStackMode, &changes );
+        /* the top of its band is right below the topmost windows, other
+         * programs' too: raised above them all, a window the taskbar
+         * activated was over the bar until the bar raised itself again -- a
+         * frame of the window where the bar is (David) */
+        Window floor = (NtUserGetWindowLongW( data->hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) ? 0 : get_topmost_floor( data->hwnd );
+        if (!floor || !stack_window_below( data->display, data->whole_window, floor ))
+        {
+            changes.stack_mode = Above;
+            XConfigureWindow( data->display, data->whole_window, CWStackMode, &changes );
+        }
     }
 
     if (data->embedder)
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -657,6 +657,7 @@
 extern void set_window_parent( struct x11drv_win_data *data, Window parent );
 extern Window X11DRV_get_whole_window( HWND hwnd );
 extern BOOL get_stack_predecessor( HWND hwnd, BOOL managed, Window *below, BOOL *topmost );
+extern Window get_topmost_floor( HWND hwnd );
 extern BOOL stack_window_below( Display *display, Window window, Window below );
 extern Window get_dummy_parent(void);
 
