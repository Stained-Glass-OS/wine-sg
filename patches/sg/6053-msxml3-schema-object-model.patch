+
+    TRACE("(%p)->(%p)\n", This, schema);
+    if (!schema) return E_POINTER;
+    *schema = NULL;
+    if (This->kind == SOM_BUILTIN) return S_OK;
+    if (FAILED(hr = som_create(This->doc, schema_root(This->doc), SOM_SCHEMA, NULL, &item))) return hr;
+    *schema = (ISchema *)item;
+    return S_OK;
+}
