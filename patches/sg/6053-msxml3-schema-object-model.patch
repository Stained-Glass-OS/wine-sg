+    xmlNodePtr decl = declaration_of(This), inline_type;
+    IDispatch *item = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, type);
+    if (!type) return E_POINTER;
+    *type = NULL;
+    if ((inline_type = xs_first(decl, "complexType")) || (inline_type = xs_first(decl, "simpleType")))
+        hr = item_for_node(This->doc, inline_type, &item);
+    else if (FAILED(hr = type_from_qname(decl, "type", &item)) || !item)
+    {
+        /* no type: anyType for an element, anySimpleType for an attribute */
+        hr = builtin_item(This->doc, find_builtin((const xmlChar *)(This->kind == SOM_ELEMENT ? "anyType" : "anySimpleType")),
+                          &item);
+    }
+#ifdef SG_MUTANT_SOM_NO_TYPE
+    if (item) IDispatch_Release(item);
+    item = NULL;
+#endif
+    if (FAILED(hr) || !item) return FAILED(hr) ? hr : S_FALSE;
+    *type = (ISchemaType *)item;
+    return S_OK;
+}
