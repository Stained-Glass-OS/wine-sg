+struct som_item
+{
+    DispatchEx dispex;
+    IDispatch IDispatch_iface;      /* the kind's interface */
+    LONG ref;
+    enum som_kind kind;
+    xmlDocPtr doc;                  /* referenced */
+    xmlNodePtr node;                /* the xs: element; NULL for a built-in type */
+    const struct builtin_type *builtin;
+};
+
+/***********************************************************************
+ *          Built-in datatypes
+ */
+
