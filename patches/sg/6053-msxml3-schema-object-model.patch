+/* the values of a facet's children, or an attribute's space-separated words */
+static HRESULT facet_strings(xmlNodePtr restriction, const char *facet, ISchemaStringCollection **out)
+{
+    struct string_collection *This;
+    xmlNodePtr child;
+
+    if (!out) return E_POINTER;
+    if (!(This = strings_create())) return E_OUTOFMEMORY;
+    for (child = restriction ? restriction->children : NULL; child; child = child->next)
+    {
+        xmlChar *value;
+
+        if (!is_xs(child, facet) || !(value = get_attr(child, "value"))) continue;
+        strings_add(This, value, -1);
+        xmlFree(value);
+    }
+    *out = &This->ISchemaStringCollection_iface;
+    return S_OK;
+}
+
+static HRESULT word_strings(const xmlChar *words, ISchemaStringCollection **out)
+{
+    struct string_collection *This;
+    const xmlChar *p = words, *start;
+
+    if (!out) return E_POINTER;
+    if (!(This = strings_create())) return E_OUTOFMEMORY;
+    while (p && *p)
+    {
+        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
+        if (!*p) break;
+        start = p;
+        while (*p && *p != ' ' && *p != '\t' && *p != '\n' && *p != '\r') p++;
+        strings_add(This, start, p - start);
+    }
+    *out = &This->ISchemaStringCollection_iface;
+    return S_OK;
+}
