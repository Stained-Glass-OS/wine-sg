+
+static const struct builtin_type *find_builtin(const xmlChar *name)
+{
+    unsigned int i;
+
+    if (!name) return NULL;
+    for (i = 0; i < ARRAY_SIZE(builtin_types); i++)
+        if (!xmlStrcmp(name, (const xmlChar *)builtin_types[i].name)) return &builtin_types[i];
+    return NULL;
+}
+
+/***********************************************************************
+ *          Walking the schema document
+ */
+
+static BOOL is_xs(xmlNodePtr node, const char *name)
+{
+    return node && node->type == XML_ELEMENT_NODE && node->ns && !xmlStrcmp(node->ns->href, xsd_ns)
+        && (!name || !xmlStrcmp(node->name, (const xmlChar *)name));
+}
+
+static xmlNodePtr xs_first(xmlNodePtr parent, const char *name)
+{
+    xmlNodePtr child;
+
+    if (!parent) return NULL;
+    for (child = parent->children; child; child = child->next)
+        if (is_xs(child, name)) return child;
+    return NULL;
+}
+
+static xmlNodePtr schema_root(xmlDocPtr doc)
+{
+    xmlNodePtr root = xmlDocGetRootElement(doc);
+    return is_xs(root, "schema") ? root : NULL;
+}
+
+static xmlChar *get_attr(xmlNodePtr node, const char *name)
+{
+    return node ? xmlGetNoNsProp(node, (const xmlChar *)name) : NULL;
+}
+
+static BOOL attr_is(xmlNodePtr node, const char *name, const char *value)
+{
+    xmlChar *v = get_attr(node, name);
+    BOOL ret = v && !xmlStrcmp(v, (const xmlChar *)value);
+    xmlFree(v);
+    return ret;
+}
+
+static HRESULT return_attr(xmlNodePtr node, const char *name, BSTR *p)
+{
+    xmlChar *v;
+
+    if (!p) return E_POINTER;
+    if (!(v = get_attr(node, name)))
+    {
+        *p = NULL;
+        return S_OK;
+    }
+    *p = bstr_from_xmlChar(v);
+    xmlFree(v);
+    return *p ? S_OK : E_OUTOFMEMORY;
+}
+
+/* a QName attribute's namespace and local name */
+static BOOL resolve_qname(xmlNodePtr node, const xmlChar *qname, const xmlChar **ns, const xmlChar **local)
+{
+    const xmlChar *colon;
+    xmlNsPtr xmlns;
+    xmlChar *prefix;
+
+    if (!qname) return FALSE;
+    if ((colon = xmlStrchr(qname, ':')))
+    {
+        prefix = xmlStrndup(qname, colon - qname);
+        xmlns = xmlSearchNs(node->doc, node, prefix);
+        xmlFree(prefix);
+        *local = colon + 1;
+    }
+    else
+    {
+        xmlns = xmlSearchNs(node->doc, node, NULL);
+        *local = qname;
+    }
+    *ns = xmlns ? xmlns->href : NULL;
+    return TRUE;
+}
+
+static const xmlChar *target_namespace(xmlDocPtr doc)
+{
+    xmlNodePtr root = schema_root(doc);
+    xmlAttrPtr attr;
+
+    if (!root || !(attr = xmlHasNsProp(root, (const xmlChar *)"targetNamespace", NULL))) return NULL;
+    return attr->children ? attr->children->content : NULL;
+}
+
+/* a global definition or declaration of this schema by name */
+static xmlNodePtr find_global(xmlDocPtr doc, const char *tag, const xmlChar *name)
+{
+    xmlNodePtr root = schema_root(doc), child;
+
+    if (!root || !name) return NULL;
+    for (child = root->children; child; child = child->next)
+    {
+        xmlChar *n;
+        BOOL match;
+
+        if (!is_xs(child, tag)) continue;
+        n = get_attr(child, "name");
+        match = n && !xmlStrcmp(n, name);
+        xmlFree(n);
+        if (match) return child;
+    }
+    return NULL;
+}
+
+/* the definition a QName attribute refers to, if it is this schema's */
+static xmlNodePtr find_referenced(xmlNodePtr node, const char *attr, const char *tag, const char *tag2)
+{
+    const xmlChar *ns, *local, *tns = target_namespace(node->doc);
+    xmlChar *qname = get_attr(node, attr);
+    xmlNodePtr ret = NULL;
+
+    if (qname && resolve_qname(node, qname, &ns, &local) && !xmlStrcmp(ns, tns))
+    {
+        if (!(ret = find_global(node->doc, tag, local)) && tag2)
+            ret = find_global(node->doc, tag2, local);
+    }
+    xmlFree(qname);
+    return ret;
+}
+
+static BOOL is_global(xmlNodePtr node)
+{
+    return node->parent && is_xs(node->parent, "schema");
+}
+
+/* the complexType a local declaration is in */
+static xmlNodePtr enclosing_complex_type(xmlNodePtr node)
+{
+    for (node = node->parent; node; node = node->parent)
+    {
+        if (is_xs(node, "complexType")) return node;
+        if (is_xs(node, "schema")) break;
+    }
+    return NULL;
+}
+
+static HRESULT som_create(xmlDocPtr doc, xmlNodePtr node, enum som_kind kind, const struct builtin_type *builtin,
+                          IDispatch **out);
+
+static enum som_kind kind_of_node(xmlNodePtr node)
+{
+    if (is_xs(node, "schema")) return SOM_SCHEMA;
+    if (is_xs(node, "element")) return SOM_ELEMENT;
+    if (is_xs(node, "attribute")) return SOM_ATTRIBUTE;
+    if (is_xs(node, "attributeGroup")) return SOM_ATTRIBUTEGROUP;
+    if (is_xs(node, "complexType")) return SOM_COMPLEXTYPE;
+    if (is_xs(node, "simpleType")) return SOM_SIMPLETYPE;
+    if (is_xs(node, "any") || is_xs(node, "anyAttribute")) return SOM_ANY;
+    if (is_xs(node, "notation")) return SOM_NOTATION;
+    if (is_xs(node, "key") || is_xs(node, "keyref") || is_xs(node, "unique")) return SOM_IDENTITY;
+    return SOM_MODELGROUP;
+}
+
+static HRESULT item_for_node(xmlDocPtr doc, xmlNodePtr node, IDispatch **out)
+{
+    return som_create(doc, node, kind_of_node(node), NULL, out);
+}
+
+static HRESULT builtin_item(xmlDocPtr doc, const struct builtin_type *type, IDispatch **out)
+{
+    return som_create(doc, NULL, SOM_BUILTIN, type, out);
+}
+
+/* the type a QName names: a built-in one, or one of this schema */
+static HRESULT type_from_qname(xmlNodePtr node, const char *attr, IDispatch **out)
+{
+    const xmlChar *ns, *local;
+    xmlChar *qname = get_attr(node, attr);
+    xmlNodePtr def;
+    HRESULT hr = S_FALSE;
+
+    *out = NULL;
+    if (qname && resolve_qname(node, qname, &ns, &local))
+    {
+        const struct builtin_type *builtin;
+
+        if (!xmlStrcmp(ns, xsd_ns) && (builtin = find_builtin(local)))
+            hr = builtin_item(node->doc, builtin, out);
+        else if ((def = find_global(node->doc, "complexType", local)) || (def = find_global(node->doc, "simpleType", local)))
+            hr = item_for_node(node->doc, def, out);
+        else
+            FIXME("type %s is not found in this schema\n", debugstr_a((const char *)qname));
+    }
+    xmlFree(qname);
+    return hr;
+}
