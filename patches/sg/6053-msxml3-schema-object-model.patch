+/* attributes declared here and through attribute group references; extensions add their base's */
+static void collect_attributes(struct item_collection *items, xmlDocPtr doc, xmlNodePtr parent, int depth)
+{
+    xmlNodePtr child, group;
+
+    if (!parent || depth > 16) return;
+    for (child = parent->children; child; child = child->next)
+    {
+        if (is_xs(child, "attribute")) items_add_node(items, doc, child);
+        else if (is_xs(child, "attributeGroup") && (group = find_referenced(child, "ref", "attributeGroup", NULL)))
+            collect_attributes(items, doc, group, depth + 1);
+    }
+}
+
+static void collect_type_attributes(struct item_collection *items, struct som_item *This, xmlNodePtr type, int depth)
+{
+    struct som_item tmp = *This;
+    xmlNodePtr derivation, base;
+
+    if (depth > 16) return;
+    tmp.node = type;
+    tmp.kind = SOM_COMPLEXTYPE;
+    derivation = type_derivation(&tmp);
+    if (derivation && is_xs(derivation, "extension") && (base = find_referenced(derivation, "base", "complexType", NULL)))
+        collect_type_attributes(items, This, base, depth + 1);
+    collect_attributes(items, This->doc, derivation ? derivation : type, 0);
+}
+
+static HRESULT WINAPI complex_get_attributes(IDispatch *iface, ISchemaItemCollection **p)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    struct item_collection *items;
+
+    TRACE("(%p)->(%p)\n", This, p);
+    if (!p) return E_POINTER;
+    if (!(items = items_create())) return E_OUTOFMEMORY;
+    collect_type_attributes(items, This, This->node, 0);
+    *p = &items->ISchemaItemCollection_iface;
+    return S_OK;
+}
+
+static xmlNodePtr content_model_node(xmlNodePtr parent)
+{
+    xmlNodePtr child;
+
+    for (child = parent ? parent->children : NULL; child; child = child->next)
+        if (is_xs(child, "sequence") || is_xs(child, "choice") || is_xs(child, "all") || is_xs(child, "group"))
+            return child;
+    return NULL;
+}
+
+static HRESULT WINAPI complex_get_contentType(IDispatch *iface, SCHEMACONTENTTYPE *p)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    xmlNodePtr content;
+
+    if (!p) return E_POINTER;
+    if (xs_first(This->node, "simpleContent")) *p = SCHEMACONTENTTYPE_TEXTONLY;
+    else if (attr_is(This->node, "mixed", "true")
+             || ((content = xs_first(This->node, "complexContent")) && attr_is(content, "mixed", "true")))
+        *p = SCHEMACONTENTTYPE_MIXED;
+    else if (content_model_node(complex_content_parent(This))) *p = SCHEMACONTENTTYPE_ELEMENTONLY;
+    else *p = SCHEMACONTENTTYPE_EMPTY;
+    return S_OK;
+}
+
+static HRESULT WINAPI complex_get_contentModel(IDispatch *iface, ISchemaModelGroup **p)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    xmlNodePtr model = content_model_node(complex_content_parent(This)), group;
+    IDispatch *item;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, p);
+    if (!p) return E_POINTER;
+    *p = NULL;
+    /* a group reference is its group's model */
+    if (is_xs(model, "group") && (group = find_referenced(model, "ref", "group", NULL))) model = content_model_node(group);
+    /* no model: the empty particle */
+    hr = som_create(This->doc, model, SOM_MODELGROUP, NULL, &item);
+    if (FAILED(hr)) return hr;
+    *p = (ISchemaModelGroup *)item;
+    return S_OK;
+}
