+static HRESULT WINAPI type_get_variety(IDispatch *iface, SCHEMATYPEVARIETY *p)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    xmlNodePtr derivation;
+
+    if (!p) return E_POINTER;
+    if (This->kind == SOM_BUILTIN) *p = This->builtin->variety;
+    else if (This->kind == SOM_COMPLEXTYPE) *p = SCHEMATYPEVARIETY_NONE;
+    else if ((derivation = type_derivation(This)) && is_xs(derivation, "list")) *p = SCHEMATYPEVARIETY_LIST;
+    else if (derivation && is_xs(derivation, "union")) *p = SCHEMATYPEVARIETY_UNION;
+    else *p = SCHEMATYPEVARIETY_ATOMIC;
+    return S_OK;
+}
