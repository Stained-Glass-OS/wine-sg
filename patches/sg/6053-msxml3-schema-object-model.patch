+/* a reference's declaration: the global one it refers to */
+static xmlNodePtr declaration_of(struct som_item *This)
+{
+    xmlNodePtr target;
+
+    if (This->kind == SOM_ELEMENT && (target = find_referenced(This->node, "ref", "element", NULL))) return target;
+    if (This->kind == SOM_ATTRIBUTE && (target = find_referenced(This->node, "ref", "attribute", NULL))) return target;
+    return This->node;
+}
+
+static HRESULT WINAPI item_get_name(IDispatch *iface, BSTR *name)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    xmlChar *qname;
+    const xmlChar *ns, *local;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, name);
+    if (!name) return E_POINTER;
+    if (This->kind == SOM_BUILTIN)
+    {
+        xmlChar *n = xmlCharStrdup(This->builtin->name);
+        *name = bstr_from_xmlChar(n);
+        xmlFree(n);
+        return S_OK;
+    }
+    if (This->kind == SOM_SCHEMA || (This->kind == SOM_MODELGROUP && !is_xs(This->node, "group"))
+            || This->kind == SOM_ANY)
+    {
+        *name = SysAllocString(L"");
+        return S_OK;
+    }
+    /* a reference is named after what it refers to */
+    if ((qname = get_attr(This->node, "ref")))
+    {
+        resolve_qname(This->node, qname, &ns, &local);
+        *name = bstr_from_xmlChar(local);
+        xmlFree(qname);
+        return S_OK;
+    }
+    hr = return_attr(This->node, "name", name);
+    if (SUCCEEDED(hr) && !*name) *name = SysAllocString(L"");
+    return hr;
+}
+
+static HRESULT WINAPI item_get_namespaceURI(IDispatch *iface, BSTR *uri)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    const xmlChar *tns = target_namespace(This->doc);
+    xmlNodePtr decl;
+    BOOL qualified = TRUE;
+
+    TRACE("(%p)->(%p)\n", This, uri);
+    if (!uri) return E_POINTER;
+    if (This->kind == SOM_BUILTIN) return return_bstr(xsd_nsW, uri);
+    if (This->kind == SOM_ELEMENT || This->kind == SOM_ATTRIBUTE)
+    {
+        /* a local declaration is in the target namespace when its form is qualified */
+        decl = declaration_of(This);
+        if (!is_global(decl))
+        {
+            xmlChar *form = get_attr(decl, "form");
+            xmlNodePtr root = schema_root(This->doc);
+
+            if (form) qualified = !xmlStrcmp(form, (const xmlChar *)"qualified");
+            else qualified = attr_is(root, This->kind == SOM_ELEMENT ? "elementFormDefault" : "attributeFormDefault",
+                                     "qualified");
+            xmlFree(form);
+        }
+    }
+    if (!qualified || !tns)
+    {
+        *uri = SysAllocString(L"");
+        return S_OK;
+    }
+    *uri = bstr_from_xmlChar(tns);
+    return S_OK;
+}
