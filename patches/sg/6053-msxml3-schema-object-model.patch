+static HRESULT WINAPI item_get_itemType(IDispatch *iface, SOMITEMTYPE *type)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+
+    TRACE("(%p)->(%p)\n", This, type);
+    if (!type) return E_POINTER;
+    switch (This->kind)
+    {
+    case SOM_SCHEMA: *type = SOMITEM_SCHEMA; break;
+    case SOM_ELEMENT: *type = SOMITEM_ELEMENT; break;
+    case SOM_ATTRIBUTE: *type = SOMITEM_ATTRIBUTE; break;
+    case SOM_ATTRIBUTEGROUP: *type = SOMITEM_ATTRIBUTEGROUP; break;
+    case SOM_COMPLEXTYPE: *type = SOMITEM_COMPLEXTYPE; break;
+    case SOM_SIMPLETYPE: *type = SOMITEM_SIMPLETYPE; break;
+    case SOM_BUILTIN: *type = This->builtin->type; break;
+    case SOM_NOTATION: *type = SOMITEM_NOTATION; break;
+    case SOM_ANY: *type = is_xs(This->node, "anyAttribute") ? SOMITEM_ANYATTRIBUTE : SOMITEM_ANY; break;
+    case SOM_IDENTITY:
+        *type = is_xs(This->node, "key") ? SOMITEM_KEY : is_xs(This->node, "keyref") ? SOMITEM_KEYREF : SOMITEM_UNIQUE;
+        break;
+    case SOM_MODELGROUP:
+        if (is_xs(This->node, "sequence")) *type = SOMITEM_SEQUENCE;
+        else if (is_xs(This->node, "choice")) *type = SOMITEM_CHOICE;
+        else if (is_xs(This->node, "all")) *type = SOMITEM_ALL;
+        else if (is_xs(This->node, "group")) *type = SOMITEM_GROUP;
+        else *type = SOMITEM_EMPTYPARTICLE;
+        break;
+    }
+#ifdef SG_MUTANT_SOM_ITEMTYPE
+    *type = SOMITEM_NULL;
+#endif
+    return S_OK;
+}
