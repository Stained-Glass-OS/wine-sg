diff --git a/dlls/msxml3/schema.c b/dlls/msxml3/schema.c
index 0c6979d..94ff4d2 100644
--- a/dlls/msxml3/schema.c
+++ b/dlls/msxml3/schema.c
@@ -1555,20 +1555,44 @@ static HRESULT WINAPI schema_cache_getSchema(IXMLDOMSchemaCollection2* iface,
                                              BSTR namespaceURI, ISchema** schema)
 {
     schema_cache* This = impl_from_IXMLDOMSchemaCollection2(iface);
-    FIXME("(%p)->(%s %p): stub\n", This, debugstr_w(namespaceURI), schema);
-    if (schema)
-        *schema = NULL;
-    return E_NOTIMPL;
+    cache_entry* entry;
+    xmlChar* name;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(namespaceURI), schema);
+
+    if (!schema) return E_POINTER;
+    *schema = NULL;
+
+    name = xmlchar_from_wchar(namespaceURI ? namespaceURI : L"");
+    entry = (cache_entry*) xmlHashLookup(This->cache, name);
+    free(name);
+
+    /* the schema of a namespace in the cache, read from its XSD document */
+    if (!entry || !entry->schema || !entry->schema->doc) return E_INVALIDARG;
+    return som_get_schema(entry->schema->doc, schema);
 }
 
 static HRESULT WINAPI schema_cache_getDeclaration(IXMLDOMSchemaCollection2* iface,
                                                   IXMLDOMNode* node, ISchemaItem** item)
 {
     schema_cache* This = impl_from_IXMLDOMSchemaCollection2(iface);
-    FIXME("(%p)->(%p %p): stub\n", This, node, item);
-    if (item)
-        *item = NULL;
-    return E_NOTIMPL;
+    xmlnode *obj;
+    xmlNodePtr xml;
+    cache_entry* entry;
+
+    TRACE("(%p)->(%p %p)\n", This, node, item);
+
+    if (!item) return E_POINTER;
+    *item = NULL;
+    if (!node || !(obj = get_node_obj(node))) return E_INVALIDARG;
+    xml = obj->node;
+    if (xml->type != XML_ELEMENT_NODE && xml->type != XML_ATTRIBUTE_NODE) return E_INVALIDARG;
+
+    /* the schema of the node's namespace (an unqualified attribute's is its element's) */
+    entry = get_entry(This, get_node_nsURI(xml));
+    if (!entry && xml->type == XML_ATTRIBUTE_NODE && xml->parent) entry = get_entry(This, get_node_nsURI(xml->parent));
+    if (!entry || !entry->schema || !entry->schema->doc) return E_FAIL;
+    return som_get_declaration(entry->schema->doc, xml, item);
 }
 
 static const struct IXMLDOMSchemaCollection2Vtbl XMLDOMSchemaCollection2Vtbl =
