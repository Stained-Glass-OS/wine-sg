+static HRESULT WINAPI type_get_whitespace(IDispatch *iface, SCHEMAWHITESPACE *p)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    xmlNodePtr restriction = NULL, facet;
+    const struct builtin_type *builtin;
+
+    if (!p) return E_POINTER;
+    *p = SCHEMAWHITESPACE_NONE;
+    if (This->kind == SOM_COMPLEXTYPE) return S_OK;
+    if (This->kind != SOM_BUILTIN && (facet = facet_node(This, "whiteSpace")))
+    {
+        *p = attr_is(facet, "value", "preserve") ? SCHEMAWHITESPACE_PRESERVE
+           : attr_is(facet, "value", "replace") ? SCHEMAWHITESPACE_REPLACE : SCHEMAWHITESPACE_COLLAPSE;
+        return S_OK;
+    }
+    if ((builtin = primitive_of(This, &restriction))) *p = builtin->whitespace;
+    return S_OK;
+}
+
+static HRESULT WINAPI type_isValid(IDispatch *iface, BSTR data, VARIANT_BOOL *valid)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    xmlNodePtr restriction = NULL, child;
+    const struct builtin_type *builtin;
+    xmlSchemaTypePtr type;
+    xmlChar *value;
+    BOOL ok = TRUE, enumerated = FALSE, in_enum = FALSE;
+    int len;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(data), valid);
+    if (!valid) return E_POINTER;
+    *valid = VARIANT_FALSE;
+    if (This->kind == SOM_COMPLEXTYPE)
+    {
+        FIXME("complex types are not validated\n");
+        return E_NOTIMPL;
+    }
+    if (!(builtin = primitive_of(This, &restriction)))
+    {
+        FIXME("type is not derived from a built-in type by restriction\n");
+        return E_NOTIMPL;
+    }
+    value = xmlchar_from_wchar(data ? data : L"");
+    /* the built-in type's lexical space */
+    xmlSchemaInitTypes();
+    if ((type = xmlSchemaGetPredefinedType((const xmlChar *)builtin->name, xsd_ns)) && builtin->type != SOMITEM_ANYTYPE)
+        ok = !xmlSchemaValidatePredefinedType(type, value, NULL);
+    /* then this restriction's enumeration and lengths */
+    len = xmlUTF8Strlen(value);
+    for (child = restriction ? restriction->children : NULL; ok && child; child = child->next)
+    {
+        xmlChar *facet = get_attr(child, "value");
+
+        if (!facet) continue;
+        if (is_xs(child, "enumeration"))
+        {
+            enumerated = TRUE;
+            if (!xmlStrcmp(facet, value)) in_enum = TRUE;
+        }
+        else if (is_xs(child, "length")) ok = len == atoi((const char *)facet);
+        else if (is_xs(child, "minLength")) ok = len >= atoi((const char *)facet);
+        else if (is_xs(child, "maxLength")) ok = len <= atoi((const char *)facet);
+        xmlFree(facet);
+    }
+    if (enumerated && !in_enum) ok = FALSE;
+    free(value);
+    *valid = ok ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
