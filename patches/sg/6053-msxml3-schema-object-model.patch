+static HRESULT som_create(xmlDocPtr doc, xmlNodePtr node, enum som_kind kind, const struct builtin_type *builtin,
+                          IDispatch **out)
+{
+    struct som_item *This;
+    dispex_static_data_t *dispex;
+    const void *vtbl;
+
+    *out = NULL;
+    switch (kind)
+    {
+    case SOM_SCHEMA: vtbl = &schema_vtbl; dispex = &schema_dispex; break;
+    case SOM_ELEMENT: vtbl = &element_vtbl; dispex = &element_dispex; break;
+    case SOM_ATTRIBUTE: vtbl = &attribute_vtbl; dispex = &attribute_dispex; break;
+    case SOM_ATTRIBUTEGROUP: vtbl = &attrgroup_vtbl; dispex = &attrgroup_dispex; break;
+    case SOM_COMPLEXTYPE: vtbl = &complex_vtbl; dispex = &complex_dispex; break;
+    case SOM_SIMPLETYPE: case SOM_BUILTIN: vtbl = &type_vtbl; dispex = &type_dispex; break;
+    case SOM_MODELGROUP: vtbl = &group_vtbl; dispex = &group_dispex; break;
+    case SOM_ANY: vtbl = &any_vtbl; dispex = &any_dispex; break;
+    case SOM_NOTATION: vtbl = &notation_vtbl; dispex = &notation_dispex; break;
+    default: vtbl = &identity_vtbl; dispex = &identity_dispex; break;
+    }
+    if (kind == SOM_BUILTIN && !builtin) return E_FAIL;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->IDispatch_iface.lpVtbl = (IDispatchVtbl *)vtbl;
+    This->ref = 1;
+    This->kind = kind;
+    This->doc = doc;
+    xmldoc_add_ref(doc);
+    This->node = node;
+    This->builtin = builtin;
+    init_dispex(&This->dispex, (IUnknown *)&This->IDispatch_iface, dispex);
+    *out = &This->IDispatch_iface;
+    return S_OK;
+}
