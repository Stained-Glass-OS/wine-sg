+    if (This->kind == SOM_BUILTIN)
+        *p = This->builtin->variety == SCHEMATYPEVARIETY_LIST ? SCHEMADERIVATIONMETHOD_LIST
+           : This->builtin->base ? SCHEMADERIVATIONMETHOD_RESTRICTION : SCHEMADERIVATIONMETHOD_EMPTY;
+    else if (!(derivation = type_derivation(This))) *p = SCHEMADERIVATIONMETHOD_RESTRICTION;
+    else if (is_xs(derivation, "extension")) *p = SCHEMADERIVATIONMETHOD_EXTENSION;
+    else if (is_xs(derivation, "list")) *p = SCHEMADERIVATIONMETHOD_LIST;
+    else if (is_xs(derivation, "union")) *p = SCHEMADERIVATIONMETHOD_UNION;
+    else *p = SCHEMADERIVATIONMETHOD_RESTRICTION;
+    return S_OK;
+}
