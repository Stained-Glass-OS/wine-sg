+/* ISchemaType */
+
+/* a simple type's restriction, list or union; a complex type's derivation */
+static xmlNodePtr type_derivation(struct som_item *This)
+{
+    xmlNodePtr content, child;
+
+    if (This->kind == SOM_SIMPLETYPE)
+    {
+        for (child = This->node->children; child; child = child->next)
+            if (is_xs(child, "restriction") || is_xs(child, "list") || is_xs(child, "union")) return child;
+        return NULL;
+    }
+    if (This->kind != SOM_COMPLEXTYPE) return NULL;
+    if (!(content = xs_first(This->node, "complexContent")) && !(content = xs_first(This->node, "simpleContent")))
+        return NULL;
+    for (child = content->children; child; child = child->next)
+        if (is_xs(child, "extension") || is_xs(child, "restriction")) return child;
+    return NULL;
+}
+
+static HRESULT WINAPI type_get_baseTypes(IDispatch *iface, ISchemaItemCollection **p)
+{
+    struct som_item *This = impl_from_IDispatch(iface);
+    struct item_collection *items;
+    xmlNodePtr derivation;
+    IDispatch *item;
+
+    TRACE("(%p)->(%p)\n", This, p);
+    if (!p) return E_POINTER;
+    if (!(items = items_create())) return E_OUTOFMEMORY;
+    if (This->kind == SOM_BUILTIN)
+    {
+        const struct builtin_type *base = find_builtin((const xmlChar *)This->builtin->base);
+        if (base && SUCCEEDED(builtin_item(This->doc, base, &item))) items_add(items, item);
+    }
+    else if ((derivation = type_derivation(This)))
+    {
+        xmlNodePtr inline_type = xs_first(derivation, "simpleType");
+
+        if (is_xs(derivation, "list"))
+        {
+            if (inline_type) items_add_node(items, This->doc, inline_type);
+            else if (type_from_qname(derivation, "itemType", &item) == S_OK) items_add(items, item);
+        }
+        else if (is_xs(derivation, "union"))
+        {
+            xmlChar *members = get_attr(derivation, "memberTypes"), *p2, *word;
+            xmlNodePtr child;
+
+            for (p2 = members; p2 && *p2; )
+            {
+                xmlChar *end;
+                const xmlChar *ns, *local;
+                const struct builtin_type *builtin;
+                xmlNodePtr def;
+
+                while (*p2 == ' ') p2++;
+                if (!*p2) break;
+                for (end = p2; *end && *end != ' '; end++) ;
+                word = xmlStrndup(p2, end - p2);
+                resolve_qname(derivation, word, &ns, &local);
+                if (!xmlStrcmp(ns, xsd_ns) && (builtin = find_builtin(local)))
+                {
+                    if (SUCCEEDED(builtin_item(This->doc, builtin, &item))) items_add(items, item);
+                }
+                else if ((def = find_global(This->doc, "simpleType", local)))
+                    items_add_node(items, This->doc, def);
+                xmlFree(word);
+                p2 = end;
+            }
+            xmlFree(members);
+            for (child = derivation->children; child; child = child->next)
+                if (is_xs(child, "simpleType")) items_add_node(items, This->doc, child);
+        }
+        else if (inline_type) items_add_node(items, This->doc, inline_type);
+        else if (type_from_qname(derivation, "base", &item) == S_OK) items_add(items, item);
+    }
+    else if (This->kind == SOM_COMPLEXTYPE)
+    {
+        /* a complex type derives from anyType by restriction */
+        if (SUCCEEDED(builtin_item(This->doc, find_builtin((const xmlChar *)"anyType"), &item))) items_add(items, item);
+    }
+    *p = &items->ISchemaItemCollection_iface;
+    return S_OK;
+}
