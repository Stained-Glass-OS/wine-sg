+    { "duration",           SOMITEM_DATATYPE_DURATION,           "anySimpleType",    SCHEMAWHITESPACE_COLLAPSE, SCHEMATYPEVARIETY_ATOMIC },
+    { "ENTITIES",           SOMITEM_DATATYPE_ENTITIES,           "ENTITY",           SCHEMAWHITESPACE_COLLAPSE, SCHEMATYPEVARIETY_LIST },
+    { "ENTITY",             SOMITEM_DATATYPE_ENTITY,             "NCName",           SCHEMAWHITESPACE_COLLAPSE, SCHEMATYPEVARIETY_ATOMIC },
+    { "float",              SOMITEM_DATATYPE_FLOAT,              "anySimpleType",    SCHEMAWHITESPACE_COLLAPSE, SCHEMATYPEVARIETY_ATOMIC },
+    { "hexBinary",          SOMITEM_DATATYPE_HEXBINARY,          "anySimpleType",    SCHEMAWHITESPACE_COLLAPSE, SCHEMATYPEVARIETY_ATOMIC },
