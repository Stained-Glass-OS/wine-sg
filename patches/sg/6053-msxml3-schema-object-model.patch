+static void strings_add(struct string_collection *This, const xmlChar *value, int len)
+{
+    BSTR *strings;
+    xmlChar *copy;
+
+    if (!(strings = realloc(This->strings, (This->count + 1) * sizeof(*strings)))) return;
+    This->strings = strings;
+    copy = len < 0 ? xmlStrdup(value) : xmlStrndup(value, len);
+    This->strings[This->count++] = bstr_from_xmlChar(copy);
+    xmlFree(copy);
