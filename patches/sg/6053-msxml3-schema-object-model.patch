+
+static HRESULT find_item(struct item_collection *This, BSTR name, BSTR ns, BOOL use_ns, ISchemaItem **item)
+{
+    LONG i;
+
+    if (!item) return E_POINTER;
+    *item = NULL;
+    for (i = 0; i < This->count; i++)
+    {
+        ISchemaItem *candidate;
+        BSTR n = NULL, u = NULL;
+        BOOL match;
+
+        if (FAILED(IDispatch_QueryInterface(This->items[i], &IID_ISchemaItem, (void **)&candidate))) continue;
+        ISchemaItem_get_name(candidate, &n);
+        if (use_ns) ISchemaItem_get_namespaceURI(candidate, &u);
+        match = !wcscmp(n ? n : L"", name ? name : L"") && (!use_ns || !wcscmp(u ? u : L"", ns ? ns : L""));
+        SysFreeString(n);
+        SysFreeString(u);
+        if (match)
+        {
+            *item = candidate;
+            return S_OK;
+        }
+        ISchemaItem_Release(candidate);
+    }
+    return E_FAIL;
+}
