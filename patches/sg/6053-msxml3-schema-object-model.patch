+/***********************************************************************
+ *          Entry points
+ */
+
+HRESULT som_get_schema(xmlDocPtr xsd, ISchema **schema)
+{
+    IDispatch *item;
+    HRESULT hr;
+
+    if (!schema_root(xsd))
+    {
+        WARN("not an XSD schema document\n");
+        return E_FAIL;
+    }
+    if (FAILED(hr = som_create(xsd, schema_root(xsd), SOM_SCHEMA, NULL, &item))) return hr;
+    *schema = (ISchema *)item;
+    return S_OK;
+}
+
+/* an element declaration's child element of this name, through its type's content model */
+static xmlNodePtr find_in_model(xmlNodePtr model, const xmlChar *name, int depth)
+{
+    xmlNodePtr child, found, group;
+
+    if (!model || depth > 32) return NULL;
+    for (child = model->children; child; child = child->next)
+    {
+        if (is_xs(child, "element"))
+        {
+            xmlChar *n = get_attr(child, "name"), *ref = get_attr(child, "ref");
+            const xmlChar *ns, *local = n;
+            BOOL match;
+
+            if (!n && ref) resolve_qname(child, ref, &ns, &local);
+            match = local && !xmlStrcmp(local, name);
+            xmlFree(n);
+            xmlFree(ref);
+            if (match) return child;
+        }
+        else if (is_xs(child, "group") && (group = find_referenced(child, "ref", "group", NULL)))
+        {
+            if ((found = find_in_model(content_model_node(group), name, depth + 1))) return found;
+        }
+        else if (is_xs(child, "sequence") || is_xs(child, "choice") || is_xs(child, "all"))
+        {
+            if ((found = find_in_model(child, name, depth + 1))) return found;
+        }
+    }
+    return NULL;
+}
+
+/* the complex type an element declaration has */
+static xmlNodePtr element_complex_type(xmlNodePtr decl)
+{
+    xmlNodePtr target, type;
+
+    if ((target = find_referenced(decl, "ref", "element", NULL))) decl = target;
+    if ((type = xs_first(decl, "complexType"))) return type;
+    return find_referenced(decl, "type", "complexType", NULL);
+}
+
+static xmlNodePtr find_child_decl(xmlNodePtr parent_decl, const xmlChar *name)
+{
+    xmlNodePtr type = element_complex_type(parent_decl), derivation, base, found;
+    struct som_item tmp = { 0 };
+    int depth;
+
+    for (depth = 0; type && depth < 16; depth++)
+    {
+        tmp.node = type;
+        tmp.kind = SOM_COMPLEXTYPE;
+        derivation = type_derivation(&tmp);
+        if ((found = find_in_model(derivation ? derivation : type, name, 0))) return found;
+        if ((found = find_in_model(content_model_node(derivation ? derivation : type), name, 0))) return found;
+        /* then the base type's model, for an extension */
+        if (!derivation || !is_xs(derivation, "extension")) break;
+        base = find_referenced(derivation, "base", "complexType", NULL);
+        type = base;
+    }
+    return NULL;
+}
+
+static xmlNodePtr find_element_decl(xmlDocPtr xsd, xmlNodePtr node, int depth)
+{
+    xmlNodePtr parent_decl;
+
+    if (depth > 64) return NULL;
+    if (node->parent && node->parent->type == XML_ELEMENT_NODE
+            && (parent_decl = find_element_decl(xsd, node->parent, depth + 1)))
+    {
+        xmlNodePtr decl = find_child_decl(parent_decl, node->name);
+        if (decl) return decl;
+    }
+    return find_global(xsd, "element", node->name);
+}
+
+HRESULT som_get_declaration(xmlDocPtr xsd, xmlNodePtr node, ISchemaItem **item)
+{
+    xmlNodePtr decl = NULL, owner, type;
+    IDispatch *disp;
+    HRESULT hr;
+
+    if (!schema_root(xsd)) return E_FAIL;
+    if (node->type == XML_ELEMENT_NODE)
+        decl = find_element_decl(xsd, node, 0);
+    else if (node->type == XML_ATTRIBUTE_NODE && (owner = node->parent))
+    {
+        /* the owner element's type's attributes, else a global attribute */
+        xmlNodePtr owner_decl = find_element_decl(xsd, owner, 0);
+        struct item_collection *items;
+        struct som_item tmp = { 0 };
+
+        if (owner_decl && (type = element_complex_type(owner_decl)) && (items = items_create()))
+        {
+            LONG i;
+
+            tmp.doc = xsd;
+            tmp.node = type;
+            tmp.kind = SOM_COMPLEXTYPE;
+            collect_type_attributes(items, &tmp, type, 0);
+            for (i = 0; i < items->count && !decl; i++)
+            {
+                struct som_item *a = impl_from_IDispatch(items->items[i]);
+                xmlNodePtr d = declaration_of(a);
+                xmlChar *n = get_attr(d, "name");
+
+                if (n && !xmlStrcmp(n, node->name)) decl = a->node;
+                xmlFree(n);
+            }
+            ISchemaItemCollection_Release(&items->ISchemaItemCollection_iface);
+        }
+        if (!decl) decl = find_global(xsd, "attribute", node->name);
+    }
+#ifdef SG_MUTANT_SOM_DECL_GLOBAL_ONLY
+    decl = node->type == XML_ELEMENT_NODE ? find_global(xsd, "element", node->name) : NULL;
+#endif
+    if (!decl) return E_FAIL;
+    if (FAILED(hr = item_for_node(xsd, decl, &disp))) return hr;
+    *item = (ISchemaItem *)disp;
+    return S_OK;
+}
