+/* "#all", or a list of extension, restriction, substitution, list, union */
+static SCHEMADERIVATIONMETHOD derivation_flags(xmlNodePtr node, const char *attr, const char *schema_default)
+{
+    xmlChar *value = get_attr(node, attr);
+    SCHEMADERIVATIONMETHOD ret = SCHEMADERIVATIONMETHOD_NONE;
+
+    if (!value && schema_default) value = get_attr(schema_root(node->doc), schema_default);
+    if (!value) return ret;
+    if (xmlStrstr(value, (const xmlChar *)"#all")) ret = SCHEMADERIVATIONMETHOD_ALL;
+    else
+    {
+        ret = SCHEMADERIVATIONMETHOD_EMPTY;
+        if (xmlStrstr(value, (const xmlChar *)"extension")) ret |= SCHEMADERIVATIONMETHOD_EXTENSION;
+        if (xmlStrstr(value, (const xmlChar *)"restriction")) ret |= SCHEMADERIVATIONMETHOD_RESTRICTION;
+        if (xmlStrstr(value, (const xmlChar *)"substitution")) ret |= SCHEMADERIVATIONMETHOD_SUBSTITUTION;
+        if (xmlStrstr(value, (const xmlChar *)"list")) ret |= SCHEMADERIVATIONMETHOD_LIST;
+        if (xmlStrstr(value, (const xmlChar *)"union")) ret |= SCHEMADERIVATIONMETHOD_UNION;
+    }
+    xmlFree(value);
+    return ret;
+}
