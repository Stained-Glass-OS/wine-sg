+/* the built-in type a simple type comes from */
+static const struct builtin_type *primitive_of(struct som_item *This, xmlNodePtr *restriction)
+{
+    xmlNodePtr node = This->node;
+    int depth;
+
+    if (This->kind == SOM_BUILTIN) return This->builtin;
+    *restriction = NULL;
+    for (depth = 0; node && depth < 32; depth++)
+    {
+        xmlNodePtr derivation = NULL, child;
+        const xmlChar *ns, *local;
+        xmlChar *base;
+        const struct builtin_type *builtin = NULL;
+
+        for (child = node->children; child; child = child->next)
+            if (is_xs(child, "restriction")) derivation = child;
+        if (!derivation) return NULL;
+        if (!*restriction) *restriction = derivation;
+        if ((child = xs_first(derivation, "simpleType")))
+        {
+            node = child;
+            continue;
+        }
+        if (!(base = get_attr(derivation, "base"))) return NULL;
+        resolve_qname(derivation, base, &ns, &local);
+        if (!xmlStrcmp(ns, xsd_ns)) builtin = find_builtin(local);
+        else node = find_global(This->doc, "simpleType", local);
+        xmlFree(base);
+        if (builtin) return builtin;
+    }
+    return NULL;
+}
