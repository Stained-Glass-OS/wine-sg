-/* the X map's own layout, from the XKB rules names on the root window */
+/* Stained Glass OS (9153): the XKB layout and variant a group name stands for. Under Xwayland the X map is
+ * the compositor's keymap, compiled from its text: _XKB_RULES_NAMES keeps the X server's defaults
+ * ("evdev", "pc105", "us") and the symbols are "(unnamed)", so the only names the map has are its groups'
+ * ("German", "English (US)") -- the descriptions of the XKB rules' layouts and variants (evdev.xml), which
+ * the symbols files give their groups. */
+static void xml_text( const char *p, const char *end, char *out, size_t size )
+{
+    static const struct { const char *name; char ch; } entities[] =
+        { {"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'}, {"&apos;", '\''}, {"&quot;", '"'} };
+    size_t len = 0;
+    unsigned int i;
+
+    while (p < end && len + 1 < size)
+    {
+        if (*p == '&')
+        {
+            for (i = 0; i < ARRAY_SIZE(entities); i++)
+            {
+                size_t n = strlen( entities[i].name );
+                if ((size_t)(end - p) >= n && !strncmp( p, entities[i].name, n )) { out[len++] = entities[i].ch; p += n; break; }
+            }
+            if (i < ARRAY_SIZE(entities)) continue;
+        }
+        out[len++] = *p++;
+    }
+    out[len] = 0;
+}
+
+static char *read_rules_xml(void)
+{
+    static const char *const files[] = { "/usr/share/X11/xkb/rules/evdev.xml", "/usr/share/X11/xkb/rules/base.xml" };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(files); i++)
+    {
+        FILE *f = fopen( files[i], "r" );
+        char *buf;
+        long size;
+
+        if (!f) continue;
+        if (fseek( f, 0, SEEK_END ) || (size = ftell( f )) <= 0 || size > 16 << 20 || fseek( f, 0, SEEK_SET ) ||
+            !(buf = malloc( size + 1 )))
+        {
+            fclose( f );
+            continue;
+        }
+        size = fread( buf, 1, size, f );
+        fclose( f );
+        buf[size] = 0;
+        return buf;
+    }
+    return NULL;
+}
+
+/* the layout and variant of each group name in names (count of them), from the XKB rules; FALSE for a name
+ * no layout has */
+static void layouts_from_descriptions( const char *xml, char names[][128], UINT count, BOOL *found )
+{
+    const char *p, *end, *tag;
+    char layout[64] = "", variant[64] = "", text[128];
+    BOOL in_variant = FALSE;
+    UINT g;
+
+    if (!(p = strstr( xml, "<layoutList>" ))) return;
+    if (!(end = strstr( p, "</layoutList>" ))) end = p + strlen( p );
+    while (p < end && (tag = strchr( p, '<' )) && tag < end)
+    {
+        const char *close;
+        if (!strncmp( tag, "<layout>", 8 )) { layout[0] = variant[0] = 0; in_variant = FALSE; }
+        else if (!strncmp( tag, "<variant>", 9 )) { variant[0] = 0; in_variant = TRUE; }
+        else if (!strncmp( tag, "</variant>", 10 )) in_variant = FALSE;
+        else if (!strncmp( tag, "<name>", 6 ) && (close = strstr( tag, "</name>" )))
+        {
+            char *dst = in_variant ? variant : layout;
+            if (!dst[0]) xml_text( tag + 6, close, dst, 64 );
+        }
+        else if (!strncmp( tag, "<description>", 13 ) && (close = strstr( tag, "</description>" )))
+        {
+            xml_text( tag + 13, close, text, sizeof(text) );
+            for (g = 0; g < count; g++)
+            {
+                if (found[g] || strcmp( text, names[g] )) continue;
+                strcpy( x_layouts[g], layout );
+                strcpy( x_variants[g], in_variant ? variant : "" );
+                found[g] = TRUE;
+            }
+        }
+        p = tag + 1;
+    }
+}
+
