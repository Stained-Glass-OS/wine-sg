+               n > 2 ? debugstr_a(names[2]) : "", n > 3 ? debugstr_a(names[3]) : "" );
+    }
+#endif
+    if (all) x_groups = n;
+    else
     {
-        /* rules, model, layout, variant, options; the first layout of a list */
-        for (p = (const char *)data, end = p + count, i = 0; p < end && i < 4; p += strlen( p ) + 1, i++)
+        /* rules, model, layout, variant, options: each a comma-separated list, a layout per group */
