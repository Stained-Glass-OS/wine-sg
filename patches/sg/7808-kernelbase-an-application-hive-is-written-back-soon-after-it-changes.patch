+};
+static CRITICAL_SECTION app_hive_save_cs = { &app_hive_save_cs_debug, -1, 0, 0, 0, 0 };
+static BOOL exiting;
 
+/* the hive is written to FILE.sgsave and renamed over FILE, so a process
+ * killed while saving leaves the last whole copy */
 static void save_app_hive( HKEY key, const UNICODE_STRING *file )
 {
+    static const WCHAR suffix[] = L".sgsave";
+    FILE_RENAME_INFORMATION *rename;
+    UNICODE_STRING tmp;
     OBJECT_ATTRIBUTES attr;
     IO_STATUS_BLOCK io;
     HANDLE handle;
+    ULONG size;
 
-    InitializeObjectAttributes( &attr, (UNICODE_STRING *)file, OBJ_CASE_INSENSITIVE, 0, NULL );
-    if (NtCreateFile( &handle, GENERIC_WRITE | SYNCHRONIZE, &attr, &io, NULL, FILE_ATTRIBUTE_NORMAL,
-                      FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OVERWRITE_IF,
-                      FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT, NULL, 0 ))
-        return;
-    NtSaveKey( key, handle );
-    NtClose( handle );
+    tmp.MaximumLength = file->Length + sizeof(suffix);
+    if (!(tmp.Buffer = heap_alloc( tmp.MaximumLength ))) return;
+    memcpy( tmp.Buffer, file->Buffer, file->Length );
+    memcpy( tmp.Buffer + file->Length / sizeof(WCHAR), suffix, sizeof(suffix) );
+    tmp.Length = tmp.MaximumLength - sizeof(WCHAR);
+
+    if (exiting)
+    {
+        /* a thread killed at exit may hold the lock */
+        if (!RtlTryEnterCriticalSection( &app_hive_save_cs )) { heap_free( tmp.Buffer ); return; }
+    }
+    else RtlEnterCriticalSection( &app_hive_save_cs );
+    InitializeObjectAttributes( &attr, &tmp, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (!NtCreateFile( &handle, GENERIC_WRITE | DELETE | SYNCHRONIZE, &attr, &io, NULL, FILE_ATTRIBUTE_NORMAL,
+                       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OVERWRITE_IF,
+                       FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT, NULL, 0 ))
+    {
+        size = offsetof( FILE_RENAME_INFORMATION, FileName[file->Length / sizeof(WCHAR)] );
+        if (!NtSaveKey( key, handle ) && (rename = heap_alloc( size )))
+        {
+            rename->ReplaceIfExists = TRUE;
+            rename->RootDirectory = NULL;
+            rename->FileNameLength = file->Length;
+            memcpy( rename->FileName, file->Buffer, file->Length );
+            NtSetInformationFile( handle, &io, rename, size, FileRenameInformation );
+            heap_free( rename );
+        }
+        else
+        {
+            FILE_DISPOSITION_INFORMATION dispo = { TRUE };
+            NtSetInformationFile( handle, &io, &dispo, sizeof(dispo), FileDispositionInformation );
+        }
+        NtClose( handle );
+    }
+    RtlLeaveCriticalSection( &app_hive_save_cs );
+    heap_free( tmp.Buffer );
+}
+
+/* Stained Glass OS: the hive is written back soon after it changes, as
+ * Windows' lazy writer does, not only when its handle is closed: Visual
+ * Studio keeps its private registry open for its whole life, and what it and
+ * VsRegEdit (which exits without closing it) set was lost, so its first-launch
+ * window came back every time. */
+static void watch_app_hive( struct app_hive *hive )
+{
+#ifndef SG_MUTANT_APPHIVE_NO_LAZY_SAVE
+    NtNotifyChangeKey( hive->key, hive->changed, NULL, NULL, &hive->notify_io,
+                       REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET, TRUE, NULL, 0, TRUE );
+    TpSetWait( hive->wait, hive->changed, NULL );
+#endif
+}
+
+static void CALLBACK app_hive_changed( TP_CALLBACK_INSTANCE *instance, void *context, TP_WAIT *wait, TP_WAIT_RESULT result )
+{
+    struct app_hive *hive = context;
+    LARGE_INTEGER delay;
+
+    delay.QuadPart = -10000 * 1000;   /* a burst of changes is written once */
+    NtDelayExecution( FALSE, &delay );
+    RtlEnterCriticalSection( &app_hive_save_cs );
+    if (!hive->closing) watch_app_hive( hive );
+    RtlLeaveCriticalSection( &app_hive_save_cs );
+    if (!hive->closing) save_app_hive( hive->key, &hive->file );
+}
+
+/* at a normal exit, every changed hive is written (VsRegEdit sets a value and
+ * exits with the hive open) */
+void app_hives_process_exit(void)
+{
+    struct app_hive *hive;
+
+    exiting = TRUE;
+#ifdef SG_MUTANT_APPHIVE_NO_EXIT_SAVE
+    return;
+#endif
+    if (list_empty( &app_hives ) || !RtlTryEnterCriticalSection( &classes_cs )) return;
+    LIST_FOR_EACH_ENTRY( hive, &app_hives, struct app_hive, entry )
+        if (hive->writeback) save_app_hive( hive->key, &hive->file );
+    RtlLeaveCriticalSection( &classes_cs );
 }
 
