+        TpSetWait( hive->wait, NULL, NULL );
+        TpWaitForWait( hive->wait, TRUE );
+        TpReleaseWait( hive->wait );
+    }
+    if (hive->changed) NtClose( hive->changed );
 #ifndef SG_MUTANT_APPHIVE_NO_SAVE
     if (hive->writeback) save_app_hive( key, &hive->file );
 #endif
@@ -4523,6 +4624,11 @@
     RtlEnterCriticalSection( &classes_cs );
     list_add_tail( &app_hives, &hive->entry );
     RtlLeaveCriticalSection( &classes_cs );
+    if (hive->writeback && !NtCreateEvent( &hive->changed, EVENT_ALL_ACCESS, NULL, SynchronizationEvent, FALSE ))
+    {
