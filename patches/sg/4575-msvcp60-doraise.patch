+#if _MSVCP_VER == 60 && !defined(_MSVCIRT)
+/* throw information of the classes that had none: bad_cast and the classes
+ * only msvcp60 has, and a second one for logic_error (its type info is
+ * already shared by its subclasses) */
+typedef logic_error logic_error_raise;
+#define logic_error_raise_type_info logic_error_type_info
+DEFINE_THISCALL_WRAPPER(logic_error_raise_copy_ctor, 8)
+logic_error* __thiscall logic_error_raise_copy_ctor(logic_error *this, const logic_error *rhs)
+{
+    return logic_error_copy_ctor(this, rhs);
+}
+DEFINE_THISCALL_WRAPPER(bad_typeid_copy_ctor, 8)
+bad_typeid* __thiscall bad_typeid_copy_ctor(bad_typeid *this, const bad_typeid *rhs)
+{
+    return MSVCP_bad_typeid_copy_ctor(this, rhs);
+}
+DEFINE_THISCALL_WRAPPER(__non_rtti_object_copy_ctor, 8)
+__non_rtti_object* __thiscall __non_rtti_object_copy_ctor(__non_rtti_object *this, const __non_rtti_object *rhs)
+{
+    return MSVCP___non_rtti_object_copy_ctor(this, rhs);
+}
+DEFINE_THISCALL_WRAPPER(bad_exception_copy_ctor, 8)
+bad_exception* __thiscall bad_exception_copy_ctor(bad_exception *this, const bad_exception *rhs)
+{
+    return MSVCP_bad_exception_copy_ctor(this, rhs);
+}
+DEFINE_CXX_DATA1(logic_error_raise, &exception_cxx_type_info, MSVCP_logic_error_dtor)
+DEFINE_CXX_DATA1(bad_cast, &exception_cxx_type_info, MSVCP_bad_cast_dtor)
+DEFINE_CXX_DATA1(bad_typeid, &exception_cxx_type_info, MSVCP_exception_dtor)
+DEFINE_CXX_DATA2(__non_rtti_object, &bad_typeid_cxx_type_info, &exception_cxx_type_info, MSVCP_exception_dtor)
+DEFINE_CXX_DATA1(bad_exception, &exception_cxx_type_info, MSVCP_exception_dtor)
+DEFINE_CXX_DATA2(underflow_error, &runtime_error_cxx_type_info, &exception_cxx_type_info, MSVCP_runtime_error_dtor)
+DEFINE_CXX_DATA2(domain_error, &logic_error_cxx_type_info, &exception_cxx_type_info, MSVCP_logic_error_dtor)
+
+/* _Doraise of each class throws a copy of the object as that class, as the
+ * VC6 headers' exception::_Raise expects (microsoft/STL stdexcept:
+ * "void _Doraise() const override { _RAISE(*this); }") */
+#ifdef SG_MUTANT_DORAISE_BASE_TYPE
+#define DEFINE_DORAISE(name, type, cxx) \
+    DEFINE_THISCALL_WRAPPER(name##__Doraise, 4) \
+    void __thiscall name##__Doraise(const type *this) \
+    { \
+        type copy; \
+        TRACE("(%p)\n", this); \
+        name##_copy_ctor(&copy, (type *)this); \
+        _CxxThrowException(&copy, &exception_exception_type); \
+    }
+#else
+#define DEFINE_DORAISE(name, type, cxx) \
+    DEFINE_THISCALL_WRAPPER(name##__Doraise, 4) \
+    void __thiscall name##__Doraise(const type *this) \
+    { \
+        type copy; \
+        TRACE("(%p)\n", this); \
+        name##_copy_ctor(&copy, (type *)this); \
+        _CxxThrowException(&copy, &cxx##_exception_type); \
+    }
+#endif
+DEFINE_DORAISE(exception, exception, exception)
+DEFINE_DORAISE(bad_alloc, bad_alloc, bad_alloc)
+DEFINE_DORAISE(logic_error, logic_error, logic_error_raise)
+DEFINE_DORAISE(length_error, length_error, length_error)
+DEFINE_DORAISE(out_of_range, out_of_range, out_of_range)
+DEFINE_DORAISE(invalid_argument, invalid_argument, invalid_argument)
+DEFINE_DORAISE(domain_error, domain_error, domain_error)
+DEFINE_DORAISE(runtime_error, runtime_error, runtime_error)
+DEFINE_DORAISE(range_error, range_error, range_error)
+DEFINE_DORAISE(overflow_error, overflow_error, overflow_error)
+DEFINE_DORAISE(underflow_error, underflow_error, underflow_error)
+DEFINE_DORAISE(failure, failure, failure)
+DEFINE_DORAISE(bad_cast, bad_cast, bad_cast)
+DEFINE_DORAISE(bad_typeid, bad_typeid, bad_typeid)
+DEFINE_DORAISE(__non_rtti_object, __non_rtti_object, __non_rtti_object)
+DEFINE_DORAISE(bad_exception, bad_exception, bad_exception)
+#endif
