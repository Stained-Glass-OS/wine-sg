-    return 0;
+    TRACE("(%p, %08lx, %08lx, %s, %08lx, %08lx, %p)\n", hLineApp, dwDeviceID, dwAPIVersion, debugstr_w(lpszAddressIn), dwCard, dwTranslateOptions, lpTranslateOutput);
+    if (!lpszAddressIn || !lpTranslateOutput) return LINEERR_INVALPOINTER;
