From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tapi32: current location, wide translate caps, translation without a device

- lineSetCurrentLocation checks the application handle and that the
  location exists (LINEERR_INVALLOCATION) and records it as the current
  location (CurrentID of the Telephony Locations key).
- lineGetTranslateCapsW gives what lineGetTranslateCapsA gives with wide
  strings (locations, calling cards), sized the same way: the header alone
  when the buffer is only that big.
- lineTranslateAddress and lineTranslateDialog, A and W, checked their
  nothing and said success. Translating is the job of a line device, of which
  this machine has none: they check the pointers, the output size and the
  application handle, then fail with LINEERR_BADDEVICEID.
---
--- a/dlls/tapi32/line.c
+++ b/dlls/tapi32/line.c
@@ -41,6 +41,8 @@ static const char szCountrylistKey[] =
     "Software\\Microsoft\\Windows\\CurrentVersion\\Telephony\\Country List";
 static const char szLocationsKey[] =
     "Software\\Microsoft\\Windows\\CurrentVersion\\Telephony\\Locations";
+DWORD sg_tapi_check_app( HLINEAPP handle );  /* lineapp.c */
+
 static const char szCardsKey[] =
     "Software\\Microsoft\\Windows\\CurrentVersion\\Telephony\\Cards";
 
@@ -92,6 +94,19 @@ static struct app_priority *find_priority( const char *app, DWORD media_mode, DW
     return NULL;
 }
 
+
+/* Translating a number is the job of a line device, of which this machine has none. */
+static DWORD translate_check( HLINEAPP app, DWORD device, DWORD version )
+{
+    DWORD err;
+
+    if ((err = sg_tapi_check_app( app ))) return err;
+#ifdef SG_MUTANT_TAPIL_XLATE
+    return 0;
+#endif
+    return LINEERR_BADDEVICEID;  /* every device id is out of range */
+}
+
 /***********************************************************************
  *		lineAccept (TAPI32.@)
  */
@@ -769,10 +784,101 @@ DWORD WINAPI lineGetStatusMessages(HLINE hLine, LPDWORD lpdwLineStatus, LPDWORD
 /***********************************************************************
  *		lineGetTranslateCapsW (TAPI32.@)
  */
+DWORD WINAPI lineGetTranslateCapsA(HLINEAPP hLineApp, DWORD dwAPIVersion, LPLINETRANSLATECAPS lpTranslateCaps);
+
 DWORD WINAPI lineGetTranslateCapsW(HLINEAPP line_app, DWORD api_version, LINETRANSLATECAPS *caps)
 {
-    FIXME("(%p, %08lx, %p): stub.\n", line_app, api_version, caps);
-    return LINEERR_OPERATIONFAILED;
+    LINETRANSLATECAPS *ansi = NULL;
+    BYTE *out = (BYTE *)caps;
+    DWORD size = 4096, err, nloc, ncard, i, needed;
+    LINELOCATIONENTRY *aloc, *wloc;
+    LINECARDENTRY *acard, *wcard;
+    BYTE *wstr;
+
+    TRACE("(%p, %08lx, %p)\n", line_app, api_version, caps);
+    if (!caps) return LINEERR_INVALPOINTER;
+    if (caps->dwTotalSize < sizeof(LINETRANSLATECAPS)) return LINEERR_STRUCTURETOOSMALL;
+    for (;;)
+    {
+        if (!(ansi = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size ))) return LINEERR_NOMEM;
+        ansi->dwTotalSize = size;
+        if ((err = lineGetTranslateCapsA( line_app, api_version, ansi )) || ansi->dwNeededSize <= size) break;
+        size = ansi->dwNeededSize;
+        HeapFree( GetProcessHeap(), 0, ansi );
+        ansi = NULL;
+    }
+    if (err)
+    {
+        HeapFree( GetProcessHeap(), 0, ansi );
+        return err;
+    }
+    nloc = ansi->dwNumLocations;
+    ncard = ansi->dwNumCards;
+    aloc = (LINELOCATIONENTRY *)((BYTE *)ansi + ansi->dwLocationListOffset);
+    acard = (LINECARDENTRY *)((BYTE *)ansi + ansi->dwCardListOffset);
+
+    /* the strings, in wide characters: size what they need */
+#define WSIZE(base, field) ((base)->field##Size ? (MultiByteToWideChar( CP_ACP, 0, (char *)ansi + (base)->field##Offset, \
+        (base)->field##Size, NULL, 0 ) * sizeof(WCHAR)) : 0)
+    needed = sizeof(LINETRANSLATECAPS) + nloc * sizeof(LINELOCATIONENTRY) + ncard * sizeof(LINECARDENTRY);
+    for (i = 0; i < nloc; i++)
+        needed += WSIZE( &aloc[i], dwLocationName ) + WSIZE( &aloc[i], dwCityCode ) + WSIZE( &aloc[i], dwLocalAccessCode ) +
+                  WSIZE( &aloc[i], dwLongDistanceAccessCode ) + WSIZE( &aloc[i], dwCancelCallWaiting );
+    for (i = 0; i < ncard; i++)
+        needed += WSIZE( &acard[i], dwCardName ) + WSIZE( &acard[i], dwSameAreaRule ) +
+                  WSIZE( &acard[i], dwLongDistanceRule ) + WSIZE( &acard[i], dwInternationalRule );
+    caps->dwNeededSize = needed;
+    if (needed > caps->dwTotalSize)
+    {
+        caps->dwUsedSize = sizeof(LINETRANSLATECAPS);
+        HeapFree( GetProcessHeap(), 0, ansi );
+        return 0;
+    }
+    caps->dwUsedSize = needed;
+    caps->dwNumLocations = nloc;
+    caps->dwLocationListSize = nloc * sizeof(LINELOCATIONENTRY);
+    caps->dwLocationListOffset = sizeof(LINETRANSLATECAPS);
+    caps->dwCurrentLocationID = ansi->dwCurrentLocationID;
+#ifdef SG_MUTANT_TAPIL_NOCARDS
+    ncard = 0;
+#endif
+    caps->dwNumCards = ncard;
+    caps->dwCardListSize = ncard * sizeof(LINECARDENTRY);
+    caps->dwCardListOffset = caps->dwLocationListOffset + caps->dwLocationListSize;
+    caps->dwCurrentPreferredCardID = ansi->dwCurrentPreferredCardID;
+    wloc = (LINELOCATIONENTRY *)(out + caps->dwLocationListOffset);
+    wcard = (LINECARDENTRY *)(out + caps->dwCardListOffset);
+    wstr = out + caps->dwCardListOffset + caps->dwCardListSize;
+#define WCOPY(dst, src, field) do { \
+        (dst)->field##Size = 0; (dst)->field##Offset = 0; \
+        if ((src)->field##Size) { \
+            int n = MultiByteToWideChar( CP_ACP, 0, (char *)ansi + (src)->field##Offset, (src)->field##Size, (WCHAR *)wstr, \
+                                         (src)->field##Size ); \
+            (dst)->field##Size = n * sizeof(WCHAR); (dst)->field##Offset = wstr - out; wstr += n * sizeof(WCHAR); } \
+    } while (0)
+    for (i = 0; i < nloc; i++)
+    {
+        wloc[i] = aloc[i];
+        WCOPY( &wloc[i], &aloc[i], dwLocationName );
+        WCOPY( &wloc[i], &aloc[i], dwCityCode );
+        WCOPY( &wloc[i], &aloc[i], dwLocalAccessCode );
+        WCOPY( &wloc[i], &aloc[i], dwLongDistanceAccessCode );
+        WCOPY( &wloc[i], &aloc[i], dwCancelCallWaiting );
+        wloc[i].dwTollPrefixListSize = 0;
+        wloc[i].dwTollPrefixListOffset = 0;
+    }
+    for (i = 0; i < ncard; i++)
+    {
+        wcard[i] = acard[i];
+        WCOPY( &wcard[i], &acard[i], dwCardName );
+        WCOPY( &wcard[i], &acard[i], dwSameAreaRule );
+        WCOPY( &wcard[i], &acard[i], dwLongDistanceRule );
+        WCOPY( &wcard[i], &acard[i], dwInternationalRule );
+    }
+#undef WCOPY
+#undef WSIZE
+    HeapFree( GetProcessHeap(), 0, ansi );
+    return 0;
 }
 
 /***********************************************************************
@@ -1388,8 +1494,33 @@ DWORD WINAPI lineSetCallPrivilege(HCALL hCall, DWORD dwCallPrivilege)
  */
 DWORD WINAPI lineSetCurrentLocation(HLINEAPP hLineApp, DWORD dwLocation)
 {
-    FIXME("(%p, %08lx): stub.\n", hLineApp, dwLocation);
-    return 0;
+    HKEY locations, loc;
+    char name[64];
+    DWORD i = 0, id, size, err = LINEERR_INVALLOCATION;
+
+    TRACE("(%p, %08lx)\n", hLineApp, dwLocation);
+    if ((err = sg_tapi_check_app( hLineApp ))) return err;
+    err = LINEERR_INVALLOCATION;
+    if (RegOpenKeyExA( HKEY_LOCAL_MACHINE, szLocationsKey, 0, KEY_READ | KEY_WRITE, &locations ))
+        return LINEERR_INVALLOCATION;
+    while (!RegEnumKeyA( locations, i++, name, sizeof(name) ))
+    {
+        if (_strnicmp( name, "location", 8) || RegOpenKeyExA( locations, name, 0, KEY_READ, &loc )) continue;
+        size = sizeof(id);
+        if (RegQueryValueExA( loc, "ID", NULL, NULL, (BYTE *)&id, &size )) id = atoi( name + 8 );
+        RegCloseKey( loc );
+        if (id != dwLocation) continue;
+        size = sizeof(dwLocation);
+#ifdef SG_MUTANT_TAPIL_NOSET
+        err = 0;
+#else
+        err = RegSetValueExA( locations, "CurrentID", 0, REG_DWORD, (BYTE *)&dwLocation, size ) ?
+              LINEERR_OPERATIONFAILED : 0;
+#endif
+        break;
+    }
+    RegCloseKey( locations );
+    return err;
 }
 
 /***********************************************************************
@@ -1488,8 +1619,10 @@ DWORD WINAPI lineSwapHold(HCALL hActiveCall, HCALL hHeldCall)
  */
 DWORD WINAPI lineTranslateAddressA(HLINEAPP hLineApp, DWORD dwDeviceID, DWORD dwAPIVersion, LPCSTR lpszAddressIn, DWORD dwCard, DWORD dwTranslateOptions, LPLINETRANSLATEOUTPUT lpTranslateOutput)
 {
-    FIXME("(%p, %08lx, %08lx, %s, %08lx, %08lx, %p): stub.\n", hLineApp, dwDeviceID, dwAPIVersion, lpszAddressIn, dwCard, dwTranslateOptions, lpTranslateOutput);
-    return 0;
+    TRACE("(%p, %08lx, %08lx, %s, %08lx, %08lx, %p)\n", hLineApp, dwDeviceID, dwAPIVersion, debugstr_a(lpszAddressIn), dwCard, dwTranslateOptions, lpTranslateOutput);
+    if (!lpszAddressIn || !lpTranslateOutput) return LINEERR_INVALPOINTER;
+    if (lpTranslateOutput->dwTotalSize < sizeof(LINETRANSLATEOUTPUT)) return LINEERR_STRUCTURETOOSMALL;
+    return translate_check( hLineApp, dwDeviceID, dwAPIVersion );
 }
 
