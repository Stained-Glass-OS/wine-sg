-            dwAPIVersion, hwndOwner, debugstr_w(lpszAddressIn));
-    return 0;
+    TRACE("(%p, %08lx, %08lx, %p, %s)\n", hLineApp, dwDeviceID, dwAPIVersion, hwndOwner, debugstr_w(lpszAddressIn));
+    return translate_check( hLineApp, dwDeviceID, dwAPIVersion );
