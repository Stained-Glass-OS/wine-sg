--- a/dlls/tapi32/lineapp.c
+++ b/dlls/tapi32/lineapp.c
@@ -103,6 +103,12 @@ static DWORD check_app( HLINEAPP handle, DWORD *options )
     return ret;
 }
 
+/* for line.c */
+DWORD sg_tapi_check_app( HLINEAPP handle )
+{
+    return check_app( handle, NULL );
+}
+
 static DWORD check_device( DWORD device )
 {
 #ifdef SG_MUTANT_TAPI_NDEV /* every device id is accepted */
