From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shcore, windows.storage: CreateStreamOverRandomAccessStream

A user's report (2026-11-11): Plex for Windows crashed with "unimplemented
function shcore.dll.CreateStreamOverRandomAccessStream called in 64-bit
code", from its media controls (windows.media.mediacontrol loaded), when it
gave them cover art. The function was a stub.

It now makes a COM IStream over a WinRT stream, beside 3653's
CreateRandomAccessStreamOverStream and in the same place (windows.storage,
where the stream classes live, through a private export):
- over one of our own wrappers of a COM stream, that stream itself;
- over any other IRandomAccessStream (InMemoryRandomAccessStream, a file's),
  an IStream that reads and writes through the stream's IInputStream and
  IOutputStream, waiting for each operation, with Seek, SetSize, Stat,
  CopyTo, Commit (FlushAsync) and Clone (CloneStream at the same position).

Gate test-rastream; mutant SG_MUTANT_SHCORE_STREAM_ALWAYS_ADAPT.
---
--- a/dlls/shcore/main.c
+++ b/dlls/shcore/main.c
@@ -2968,6 +2968,31 @@
 }
 
 /*************************************************************************
+ * CreateStreamOverRandomAccessStream        [SHCORE.@]
+ */
+HRESULT WINAPI CreateStreamOverRandomAccessStream(IUnknown *stream, REFIID riid, void **ppv)
+{
+    HRESULT (WINAPI *create)(IUnknown *, REFIID, void **);
+    HMODULE storage;
+
+    TRACE("(%p, %s, %p)\n", stream, debugstr_guid(riid), ppv);
+
+    if (!stream || !riid || !ppv)
+        return E_INVALIDARG;
+    *ppv = NULL;
+
+    /* the WinRT stream classes live in windows.storage */
+    if (!(storage = LoadLibraryW(L"windows.storage.dll")))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(create = (void *)GetProcAddress(storage, "wine_sg_CreateStreamOverRandomAccessStream")))
+    {
+        FreeLibrary(storage);
+        return E_NOTIMPL;
+    }
+    return create(stream, riid, ppv);
+}
+
+/*************************************************************************
  *      IStream_Copy        [SHCORE.@]
  *
  * Copy cb bytes from the current position of one stream to another.
--- a/dlls/shcore/shcore.spec
+++ b/dlls/shcore/shcore.spec
@@ -2,7 +2,7 @@
 @ stdcall CommandLineToArgvW(wstr ptr)
 @ stub CreateRandomAccessStreamOnFile
 @ stdcall CreateRandomAccessStreamOverStream(ptr long ptr ptr)
-@ stub CreateStreamOverRandomAccessStream
+@ stdcall CreateStreamOverRandomAccessStream(ptr ptr ptr)
 @ stdcall -private DllCanUnloadNow()
 @ stub DllGetActivationFactory
 @ stub DllGetClassObject
--- a/dlls/windows.storage/windows.storage.spec
+++ b/dlls/windows.storage/windows.storage.spec
@@ -2,3 +2,4 @@
 @ stdcall -private DllGetActivationFactory(ptr ptr)
 @ stdcall -private DllGetClassObject(ptr ptr ptr)
 @ stdcall -private wine_sg_CreateRandomAccessStreamOverStream(ptr long ptr ptr)
+@ stdcall -private wine_sg_CreateStreamOverRandomAccessStream(ptr ptr ptr)
--- a/dlls/windows.storage/wrapstream.c
+++ b/dlls/windows.storage/wrapstream.c
@@ -408,3 +408,345 @@
     IRandomAccessStream_Release( &impl->IRandomAccessStream_iface );
     return hr;
 }
+
+/* ---- the other way: a COM IStream over a WinRT IRandomAccessStream (shcore
+ * CreateStreamOverRandomAccessStream). Plex hands its media controls' cover
+ * art over this, and crashed on the stub. Our own wrapper gives back the
+ * IStream it wraps; any other stream is read and written through its own
+ * IInputStream / IOutputStream, waiting for each operation as Windows' does. */
+
+struct ras_istream
+{
+    IStream IStream_iface;
+    LONG ref;
+    IRandomAccessStream *ras;
+};
+
+static inline struct ras_istream *impl_from_IStream( IStream *iface )
+{
+    return CONTAINING_RECORD( iface, struct ras_istream, IStream_iface );
+}
+
+/* wait for an operation (any IAsyncInfo) to end; its error, or S_OK */
+static HRESULT ras_wait( IUnknown *operation )
+{
+    AsyncStatus status = Started;
+    IAsyncInfo *info;
+    DWORD start = GetTickCount();
+    HRESULT hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info ))) return hr;
+    for (;;)
+    {
+        if (FAILED(hr = IAsyncInfo_get_Status( info, &status )) || status != Started) break;
+        if (GetTickCount() - start > 60000) { hr = HRESULT_FROM_WIN32( ERROR_TIMEOUT ); break; }
+        Sleep( 1 );   /* ours end at once; another's on its own thread */
+    }
+    if (SUCCEEDED(hr) && status == Error) IAsyncInfo_get_ErrorCode( info, &hr );
+    else if (SUCCEEDED(hr) && status == Canceled) hr = E_ABORT;
+    IAsyncInfo_Release( info );
+    return hr;
+}
+
+static HRESULT WINAPI ras_istream_QueryInterface( IStream *iface, REFIID iid, void **out )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_ISequentialStream ) ||
+        IsEqualGUID( iid, &IID_IStream ))
+    {
+        *out = &impl->IStream_iface;
+        IStream_AddRef( &impl->IStream_iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ras_istream_AddRef( IStream *iface )
+{
+    return InterlockedIncrement( &impl_from_IStream( iface )->ref );
+}
+
+static ULONG WINAPI ras_istream_Release( IStream *iface )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IRandomAccessStream_Release( impl->ras );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI ras_istream_Read( IStream *iface, void *data, ULONG size, ULONG *read )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+    IAsyncOperationWithProgress_IBuffer_UINT32 *operation;
+    IBuffer *buffer, *result = NULL;
+    IInputStream *input;
+    UINT32 length = 0;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, data %p, size %lu, read %p.\n", iface, data, size, read );
+
+    if (read) *read = 0;
+    if (!data) return STG_E_INVALIDPOINTER;
+    if (!size) return S_OK;
+    if (FAILED(hr = IRandomAccessStream_QueryInterface( impl->ras, &IID_IInputStream, (void **)&input ))) return hr;
+    if (SUCCEEDED(hr = buffer_create( size, &buffer )))
+    {
+        if (SUCCEEDED(hr = IInputStream_ReadAsync( input, buffer, size, InputStreamOptions_None, &operation )))
+        {
+            if (SUCCEEDED(hr = ras_wait( (IUnknown *)operation )) &&
+                SUCCEEDED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_GetResults( operation, &result )) &&
+                SUCCEEDED(hr = buffer_get_bytes( result ? result : buffer, &bytes, &length, NULL )))
+            {
+                if (length > size) length = size;
+                memcpy( data, bytes, length );
+            }
+            if (result) IBuffer_Release( result );
+            IAsyncOperationWithProgress_IBuffer_UINT32_Release( operation );
+        }
+        IBuffer_Release( buffer );
+    }
+    IInputStream_Release( input );
+    if (FAILED(hr)) return hr;
+    if (read) *read = length;
+    return length < size ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI ras_istream_Write( IStream *iface, const void *data, ULONG size, ULONG *written )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+    IAsyncOperationWithProgress_UINT32_UINT32 *operation;
+    IOutputStream *output;
+    UINT32 done = 0;
+    IBuffer *buffer;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, data %p, size %lu, written %p.\n", iface, data, size, written );
+
+    if (written) *written = 0;
+    if (!data) return STG_E_INVALIDPOINTER;
+    if (!size) return S_OK;
+    if (FAILED(hr = IRandomAccessStream_QueryInterface( impl->ras, &IID_IOutputStream, (void **)&output ))) return STG_E_ACCESSDENIED;
+    if (SUCCEEDED(hr = buffer_create( size, &buffer )))
+    {
+        if (SUCCEEDED(hr = buffer_get_bytes( buffer, &bytes, NULL, NULL )))
+        {
+            memcpy( bytes, data, size );
+            IBuffer_put_Length( buffer, size );
+            if (SUCCEEDED(hr = IOutputStream_WriteAsync( output, buffer, &operation )))
+            {
+                if (SUCCEEDED(hr = ras_wait( (IUnknown *)operation )))
+                    hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults( operation, &done );
+                IAsyncOperationWithProgress_UINT32_UINT32_Release( operation );
+            }
+        }
+        IBuffer_Release( buffer );
+    }
+    IOutputStream_Release( output );
+    if (FAILED(hr)) return hr;
+    if (written) *written = done;
+    return done < size ? STG_E_MEDIUMFULL : S_OK;
+}
+
+static HRESULT WINAPI ras_istream_Seek( IStream *iface, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *position )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+    UINT64 base = 0;
+    INT64 target;
+    HRESULT hr;
+
+    TRACE( "iface %p, move %I64d, origin %lu, position %p.\n", iface, move.QuadPart, origin, position );
+
+    switch (origin)
+    {
+    case STREAM_SEEK_SET: break;
+    case STREAM_SEEK_CUR: if (FAILED(hr = IRandomAccessStream_get_Position( impl->ras, &base ))) return hr; break;
+    case STREAM_SEEK_END: if (FAILED(hr = IRandomAccessStream_get_Size( impl->ras, &base ))) return hr; break;
+    default: return STG_E_INVALIDFUNCTION;
+    }
+    target = (INT64)base + move.QuadPart;
+    if (target < 0) return STG_E_INVALIDFUNCTION;
+    if (FAILED(hr = IRandomAccessStream_Seek( impl->ras, target ))) return hr;
+    if (position) position->QuadPart = target;
+    return S_OK;
+}
+
+static HRESULT WINAPI ras_istream_SetSize( IStream *iface, ULARGE_INTEGER size )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+
+    TRACE( "iface %p, size %I64u.\n", iface, size.QuadPart );
+
+    return IRandomAccessStream_put_Size( impl->ras, size.QuadPart );
+}
+
+static HRESULT WINAPI ras_istream_CopyTo( IStream *iface, IStream *dest, ULARGE_INTEGER size,
+                                          ULARGE_INTEGER *read, ULARGE_INTEGER *written )
+{
+    BYTE chunk[16384];
+    ULONGLONG total_read = 0, total_written = 0;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, dest %p, size %I64u, read %p, written %p.\n", iface, dest, size.QuadPart, read, written );
+
+    if (!dest) return STG_E_INVALIDPOINTER;
+    while (total_read < size.QuadPart)
+    {
+        ULONG want = (ULONG)min( sizeof(chunk), size.QuadPart - total_read ), got = 0, put = 0;
+        if (FAILED(hr = ras_istream_Read( iface, chunk, want, &got )) || !got) break;
+        total_read += got;
+        if (FAILED(hr = IStream_Write( dest, chunk, got, &put ))) break;
+        total_written += put;
+        if (got < want) break;
+    }
+    if (read) read->QuadPart = total_read;
+    if (written) written->QuadPart = total_written;
+    return FAILED(hr) ? hr : S_OK;
+}
+
+static HRESULT WINAPI ras_istream_Commit( IStream *iface, DWORD flags )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+    IAsyncOperation_boolean *operation;
+    IOutputStream *output;
+    HRESULT hr;
+
+    TRACE( "iface %p, flags %#lx.\n", iface, flags );
+
+    if (FAILED(IRandomAccessStream_QueryInterface( impl->ras, &IID_IOutputStream, (void **)&output ))) return S_OK;
+    if (SUCCEEDED(hr = IOutputStream_FlushAsync( output, &operation )))
+    {
+        hr = ras_wait( (IUnknown *)operation );
+        IAsyncOperation_boolean_Release( operation );
+    }
+    IOutputStream_Release( output );
+    return hr;
+}
+
+static HRESULT WINAPI ras_istream_Revert( IStream *iface )
+{
+    TRACE( "iface %p.\n", iface );
+    return S_OK;   /* nothing is transacted */
+}
+
+static HRESULT WINAPI ras_istream_LockRegion( IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER size, DWORD type )
+{
+    TRACE( "iface %p.\n", iface );
+    return STG_E_INVALIDFUNCTION;
+}
+
+static HRESULT WINAPI ras_istream_UnlockRegion( IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER size, DWORD type )
+{
+    TRACE( "iface %p.\n", iface );
+    return STG_E_INVALIDFUNCTION;
+}
+
+static HRESULT WINAPI ras_istream_Stat( IStream *iface, STATSTG *stat, DWORD flags )
+{
+    struct ras_istream *impl = impl_from_IStream( iface );
+    boolean can_read = TRUE, can_write = TRUE;
+    UINT64 size = 0;
+    HRESULT hr;
+
+    TRACE( "iface %p, stat %p, flags %#lx.\n", iface, stat, flags );
+
+    if (!stat) return STG_E_INVALIDPOINTER;
+    if (FAILED(hr = IRandomAccessStream_get_Size( impl->ras, &size ))) return hr;
+    IRandomAccessStream_get_CanRead( impl->ras, &can_read );
+    IRandomAccessStream_get_CanWrite( impl->ras, &can_write );
+    memset( stat, 0, sizeof(*stat) );
+    stat->type = STGTY_STREAM;
+    stat->cbSize.QuadPart = size;
+    stat->grfMode = can_read && can_write ? STGM_READWRITE : can_write ? STGM_WRITE : STGM_READ;
+    return S_OK;
+}
+
+static HRESULT ras_istream_create( IRandomAccessStream *ras, struct ras_istream **out );
+
+static HRESULT WINAPI ras_istream_Clone( IStream *iface, IStream **clone )
+{
+    struct ras_istream *impl = impl_from_IStream( iface ), *copy;
+    IRandomAccessStream *ras;
+    UINT64 position = 0;
+    HRESULT hr;
+
+    TRACE( "iface %p, clone %p.\n", iface, clone );
+
+    if (!clone) return STG_E_INVALIDPOINTER;
+    *clone = NULL;
+    if (FAILED(hr = IRandomAccessStream_CloneStream( impl->ras, &ras ))) return hr;
+    IRandomAccessStream_get_Position( impl->ras, &position );
+    IRandomAccessStream_Seek( ras, position );
+    hr = ras_istream_create( ras, &copy );
+    IRandomAccessStream_Release( ras );
+    if (SUCCEEDED(hr)) *clone = &copy->IStream_iface;
+    return hr;
+}
+
+static const IStreamVtbl ras_istream_vtbl =
+{
+    ras_istream_QueryInterface,
+    ras_istream_AddRef,
+    ras_istream_Release,
+    ras_istream_Read,
+    ras_istream_Write,
+    ras_istream_Seek,
+    ras_istream_SetSize,
+    ras_istream_CopyTo,
+    ras_istream_Commit,
+    ras_istream_Revert,
+    ras_istream_LockRegion,
+    ras_istream_UnlockRegion,
+    ras_istream_Stat,
+    ras_istream_Clone,
+};
+
+static HRESULT ras_istream_create( IRandomAccessStream *ras, struct ras_istream **out )
+{
+    struct ras_istream *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IStream_iface.lpVtbl = &ras_istream_vtbl;
+    impl->ref = 1;
+    IRandomAccessStream_AddRef( (impl->ras = ras) );
+    *out = impl;
+    return S_OK;
+}
+
+/* called by shcore's CreateStreamOverRandomAccessStream; not a Windows export */
+HRESULT WINAPI wine_sg_CreateStreamOverRandomAccessStream( IUnknown *unknown, REFIID iid, void **out )
+{
+    IRandomAccessStream *ras;
+    struct ras_istream *impl;
+    HRESULT hr;
+
+    TRACE( "unknown %p, iid %s, out %p.\n", unknown, debugstr_guid( iid ), out );
+
+    if (!unknown || !iid || !out) return E_INVALIDARG;
+    *out = NULL;
+    if (FAILED(hr = IUnknown_QueryInterface( unknown, &IID_IRandomAccessStream, (void **)&ras ))) return hr;
+#ifndef SG_MUTANT_SHCORE_STREAM_ALWAYS_ADAPT
+    if (ras->lpVtbl == &wrap_vtbl)   /* one of ours over a COM stream: that stream */
+    {
+        hr = IStream_QueryInterface( impl_from_IRandomAccessStream( ras )->stream, iid, out );
+        IRandomAccessStream_Release( ras );
+        return hr;
+    }
+#endif
+    hr = ras_istream_create( ras, &impl );
+    IRandomAccessStream_Release( ras );
+    if (FAILED(hr)) return hr;
+    hr = IStream_QueryInterface( &impl->IStream_iface, iid, out );
+    IStream_Release( &impl->IStream_iface );
+    return hr;
+}
