From: Stained Glass OS <dev@stained-glass.example>
Subject: user32, wineboot: signing out ends the shell

ExitWindowsEx(EWX_LOGOFF) ran wineboot --end-session, which closes the
session's programs but never the desktop process: Start's Sign out (and
the Ctrl+Alt+Del screen's, and shutdown /l) left a desktop with no Start
menu or taskbar, and the session -- which ends when the shell exits cleanly
-- never ended. ExitWindowsEx now passes --logoff for a sign-out, and
wineboot, once the windows have closed, sends the desktop window WM_CLOSE:
explorer exits with 0. Gate: make test-logoff.
---
--- a/dlls/user32/user_main.c
+++ b/dlls/user32/user_main.c
@@ -310,6 +310,8 @@
         if (flags & EWX_FORCEIFHUNG) lstrcatW( cmdline, L" --force" );
     }
     if (!(flags & EWX_REBOOT)) lstrcatW( cmdline, L" --shutdown" );
+    /* Stained Glass OS: signing out ends the shell as well (wineboot) */
+    if (!(flags & (EWX_SHUTDOWN | EWX_REBOOT | EWX_POWEROFF))) lstrcatW( cmdline, L" --logoff" );
 
     memset( &si, 0, sizeof si );
     si.cb = sizeof si;
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1943,7 +1943,7 @@
 {
     /* First, set the current directory to SystemRoot */
     int i, j;
-    BOOL end_session, force, init, kill, restart, shutdown, update;
+    BOOL end_session, force, init, kill, restart, shutdown, update, logoff = FALSE;
     HANDLE event;
     OBJECT_ATTRIBUTES attr;
     UNICODE_STRING nameW = RTL_CONSTANT_STRING( L"\\KernelObjects\\__wineboot_event" );
@@ -1989,6 +1989,7 @@
             else if (!strcmp( argv[i], "--force" )) force = TRUE;
             else if (!strcmp( argv[i], "--init" )) init = TRUE;
             else if (!strcmp( argv[i], "--kill" )) kill = TRUE;
+            else if (!strcmp( argv[i], "--logoff" )) logoff = TRUE;
             else if (!strcmp( argv[i], "--restart" )) restart = TRUE;
             else if (!strcmp( argv[i], "--shutdown" )) shutdown = TRUE;
             else if (!strcmp( argv[i], "--update" )) update = TRUE;
@@ -2019,6 +2020,12 @@
             if (!shutdown_all_desktops( force )) return 1;
         }
         else if (!shutdown_close_windows( force )) return 1;
+        /* Stained Glass OS: signing out ends the shell too, as on Windows --
+         * its exit ends the session. Without this the session's programs
+         * closed and the desktop stayed, with no Start menu or taskbar left
+         * (ExitWindowsEx(EWX_LOGOFF) passes --logoff). --kill already takes
+         * the desktop process with it. */
+        if (logoff && !kill) PostMessageW( GetDesktopWindow(), WM_CLOSE, 0, 0 );
     }
 
     if (kill) kill_processes( shutdown );
