From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmp: cdromCollection, dvd and playerApplication objects

Stubs (E_NOTIMPL + FIXME), as documented now.

cdromCollection: no optical drive, count 0, Item E_INVALIDARG,
getByDriveSpecifier S_FALSE with a NULL drive. dvd: no disc, isAvailable is
VARIANT_FALSE for every item, domain is "stop", topMenu/titleMenu are
NS_E_DVD_CANNOT_JUMP, back/resume S_FALSE. playerApplication: the control is
not a front end to a separate player, so playerDocked and hasDisplay are
VARIANT_FALSE and switchToPlayerApplication/switchToControl S_FALSE. All are
embedded objects with IDispatch through the type library.
Gate: test/wmp-collections-gate.sh.

---
diff --git a/dlls/wmp/player.c b/dlls/wmp/player.c
--- a/dlls/wmp/player.c
+++ b/dlls/wmp/player.c
@@ -527,8 +527,13 @@ static HRESULT WINAPI WMPPlayer4_put_currentPlaylist(IWMPPlayer4 *iface, IWMPPla
 static HRESULT WINAPI WMPPlayer4_get_cdromCollection(IWMPPlayer4 *iface, IWMPCdromCollection **ppCdromCollection)
 {
     WindowsMediaPlayer *This = impl_from_IWMPPlayer4(iface);
-    FIXME("(%p)->(%p)\n", This, ppCdromCollection);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppCdromCollection);
+
+    if (!ppCdromCollection)
+        return E_POINTER;
+    IWMPCdromCollection_AddRef(*ppCdromCollection = &This->IWMPCdromCollection_iface);
+    return S_OK;
 }
 
 static HRESULT WINAPI WMPPlayer4_get_closedCaption(IWMPPlayer4 *iface, IWMPClosedCaption **ppClosedCaption)
@@ -596,8 +601,13 @@ static HRESULT WINAPI WMPPlayer4_get_Status(IWMPPlayer4 *iface, BSTR *pbstrStatu
 static HRESULT WINAPI WMPPlayer4_get_dvd(IWMPPlayer4 *iface, IWMPDVD **ppDVD)
 {
     WindowsMediaPlayer *This = impl_from_IWMPPlayer4(iface);
-    FIXME("(%p)->(%p)\n", This, ppDVD);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppDVD);
+
+    if (!ppDVD)
+        return E_POINTER;
+    IWMPDVD_AddRef(*ppDVD = &This->IWMPDVD_iface);
+    return S_OK;
 }
 
 static HRESULT WINAPI WMPPlayer4_newPlaylist(IWMPPlayer4 *iface, BSTR name, BSTR url, IWMPPlaylist **playlist)
@@ -762,8 +772,13 @@ static HRESULT WINAPI WMPPlayer4_get_isRemote(IWMPPlayer4 *iface, VARIANT_BOOL *
 static HRESULT WINAPI WMPPlayer4_get_playerApplication(IWMPPlayer4 *iface, IWMPPlayerApplication **ppIWMPPlayerApplication)
 {
     WindowsMediaPlayer *This = impl_from_IWMPPlayer4(iface);
-    FIXME("(%p)->(%p)\n", This, ppIWMPPlayerApplication);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppIWMPPlayerApplication);
+
+    if (!ppIWMPPlayerApplication)
+        return E_POINTER;
+    IWMPPlayerApplication_AddRef(*ppIWMPPlayerApplication = &This->IWMPPlayerApplication_iface);
+    return S_OK;
 }
 
 static HRESULT WINAPI WMPPlayer4_openPlayer(IWMPPlayer4 *iface, BSTR url)
@@ -3649,6 +3664,172 @@ static const IWMPPlaylistCollectionVtbl WMPPlaylistCollectionVtbl = {
     WMPPlaylistCollection_importPlaylist,
 };
 
+/* no optical drive is reported: the collection is empty */
+static HRESULT WINAPI WMPCdromCollection_get_count(IWMPCdromCollection *iface, LONG *plCount)
+{
+    TRACE("(%p)->(%p)\n", iface, plCount);
+    return empty_count(plCount);
+}
+
+static HRESULT WINAPI WMPCdromCollection_Item(IWMPCdromCollection *iface, LONG lIndex, IWMPCdrom **ppItem)
+{
+    TRACE("(%p)->(%ld %p)\n", iface, lIndex, ppItem);
+
+    if (!ppItem)
+        return E_POINTER;
+    *ppItem = NULL;
+#ifdef SG_MUTANT_WMP_CDROM_ITEM_OK
+    return S_OK;
+#else
+    return E_INVALIDARG;
+#endif
+}
+
+/* no drive matches any specifier: S_FALSE with a NULL result */
+static HRESULT WINAPI WMPCdromCollection_getByDriveSpecifier(IWMPCdromCollection *iface, BSTR drive,
+        IWMPCdrom **ppCdrom)
+{
+    TRACE("(%p)->(%s %p)\n", iface, debugstr_w(drive), ppCdrom);
+
+    if (!ppCdrom)
+        return E_POINTER;
+    *ppCdrom = NULL;
+    return drive ? S_FALSE : E_INVALIDARG;
+}
+
+WMP_EMBEDDED_UNKNOWN(WMPCdromCollection, IWMPCdromCollection, IID_IWMPCdromCollection, IWMPCdromCollection_iface)
+WMP_IDISPATCH_METHODS(WMPCdromCollection, IWMPCdromCollection, IWMPCdromCollection_tid)
+
+static const IWMPCdromCollectionVtbl WMPCdromCollectionVtbl = {
+    WMPCdromCollection_QueryInterface,
+    WMPCdromCollection_AddRef,
+    WMPCdromCollection_Release,
+    WMPCdromCollection_GetTypeInfoCount,
+    WMPCdromCollection_GetTypeInfo,
+    WMPCdromCollection_GetIDsOfNames,
+    WMPCdromCollection_Invoke,
+    WMPCdromCollection_get_count,
+    WMPCdromCollection_Item,
+    WMPCdromCollection_getByDriveSpecifier,
+};
+
+/* IWMPDVD, with no disc in any drive: nothing is available, the domain is
+ * "stop" and the navigation commands cannot jump anywhere */
+static HRESULT WINAPI WMPDVD_get_isAvailable(IWMPDVD *iface, BSTR item, VARIANT_BOOL *pIsAvailable)
+{
+    TRACE("(%p)->(%s %p)\n", iface, debugstr_w(item), pIsAvailable);
+
+    if (!pIsAvailable)
+        return E_POINTER;
+#ifdef SG_MUTANT_WMP_DVD_AVAILABLE
+    *pIsAvailable = VARIANT_TRUE;
+#else
+    *pIsAvailable = VARIANT_FALSE;
+#endif
+    return item ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI WMPDVD_get_domain(IWMPDVD *iface, BSTR *strDomain)
+{
+    TRACE("(%p)->(%p)\n", iface, strDomain);
+    return return_bstr(L"stop", strDomain);
+}
+
+static HRESULT WINAPI WMPDVD_topMenu(IWMPDVD *iface)
+{
+    TRACE("(%p)\n", iface);
+    return NS_E_DVD_CANNOT_JUMP;
+}
+
+static HRESULT WINAPI WMPDVD_titleMenu(IWMPDVD *iface)
+{
+    TRACE("(%p)\n", iface);
+    return NS_E_DVD_CANNOT_JUMP;
+}
+
+static HRESULT WINAPI WMPDVD_back(IWMPDVD *iface)
+{
+    TRACE("(%p)\n", iface);
+    return S_FALSE;
+}
+
+static HRESULT WINAPI WMPDVD_resume(IWMPDVD *iface)
+{
+    TRACE("(%p)\n", iface);
+    return S_FALSE;
+}
+
+WMP_EMBEDDED_UNKNOWN(WMPDVD, IWMPDVD, IID_IWMPDVD, IWMPDVD_iface)
+WMP_IDISPATCH_METHODS(WMPDVD, IWMPDVD, IWMPDVD_tid)
+
+static const IWMPDVDVtbl WMPDVDVtbl = {
+    WMPDVD_QueryInterface,
+    WMPDVD_AddRef,
+    WMPDVD_Release,
+    WMPDVD_GetTypeInfoCount,
+    WMPDVD_GetTypeInfo,
+    WMPDVD_GetIDsOfNames,
+    WMPDVD_Invoke,
+    WMPDVD_get_isAvailable,
+    WMPDVD_get_domain,
+    WMPDVD_topMenu,
+    WMPDVD_titleMenu,
+    WMPDVD_back,
+    WMPDVD_resume,
+};
+
+/* IWMPPlayerApplication: the control is not a front end to a separate player
+ * application, so there is nothing to switch to, docked or displayed */
+static HRESULT WINAPI WMPPlayerApplication_switchToPlayerApplication(IWMPPlayerApplication *iface)
+{
+    TRACE("(%p)\n", iface);
+    return S_FALSE;
+}
+
+static HRESULT WINAPI WMPPlayerApplication_switchToControl(IWMPPlayerApplication *iface)
+{
+    TRACE("(%p)\n", iface);
+    return S_FALSE;
+}
+
+static HRESULT WINAPI WMPPlayerApplication_get_playerDocked(IWMPPlayerApplication *iface, VARIANT_BOOL *p)
+{
+    TRACE("(%p)->(%p)\n", iface, p);
+
+    if (!p)
+        return E_POINTER;
+#ifdef SG_MUTANT_WMP_PLAYERAPP_DOCKED
+    *p = VARIANT_TRUE;
+#else
+    *p = VARIANT_FALSE;
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI WMPPlayerApplication_get_hasDisplay(IWMPPlayerApplication *iface, VARIANT_BOOL *p)
+{
+    TRACE("(%p)->(%p)\n", iface, p);
+    return return_bool(VARIANT_FALSE, p);
+}
+
+WMP_EMBEDDED_UNKNOWN(WMPPlayerApplication, IWMPPlayerApplication, IID_IWMPPlayerApplication,
+        IWMPPlayerApplication_iface)
+WMP_IDISPATCH_METHODS(WMPPlayerApplication, IWMPPlayerApplication, IWMPPlayerApplication_tid)
+
+static const IWMPPlayerApplicationVtbl WMPPlayerApplicationVtbl = {
+    WMPPlayerApplication_QueryInterface,
+    WMPPlayerApplication_AddRef,
+    WMPPlayerApplication_Release,
+    WMPPlayerApplication_GetTypeInfoCount,
+    WMPPlayerApplication_GetTypeInfo,
+    WMPPlayerApplication_GetIDsOfNames,
+    WMPPlayerApplication_Invoke,
+    WMPPlayerApplication_switchToPlayerApplication,
+    WMPPlayerApplication_switchToControl,
+    WMPPlayerApplication_get_playerDocked,
+    WMPPlayerApplication_get_hasDisplay,
+};
+
 static HRESULT WINAPI WMPError_QueryInterface(IWMPError *iface, REFIID riid, void **ppv)
 {
     if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch) || IsEqualGUID(riid, &IID_IWMPError))
@@ -3911,6 +4092,9 @@ BOOL init_player(WindowsMediaPlayer *wmp)
     wmp->IWMPClosedCaption_iface.lpVtbl = &WMPClosedCaptionVtbl;
     wmp->IWMPMediaCollection_iface.lpVtbl = &WMPMediaCollectionVtbl;
     wmp->IWMPPlaylistCollection_iface.lpVtbl = &WMPPlaylistCollectionVtbl;
+    wmp->IWMPCdromCollection_iface.lpVtbl = &WMPCdromCollectionVtbl;
+    wmp->IWMPDVD_iface.lpVtbl = &WMPDVDVtbl;
+    wmp->IWMPPlayerApplication_iface.lpVtbl = &WMPPlayerApplicationVtbl;
 
     name = SysAllocString(L"Playlist1");
     if (SUCCEEDED(create_playlist(name, NULL, 0, &playlist)))
