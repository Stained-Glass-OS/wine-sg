+
+/* Stained Glass OS: protected credentials. CredProtect encrypts a
+ * credential string for the user, as DPAPI does (CryptProtectData), so that
+ * only this user can read it back with CredUnprotect, in any process and
+ * after a restart; the protected string is "@@D" and the encrypted blob in
+ * base64. */
+#define PROTECTED_PREFIX L"@@D"
+
+static const char base64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static DWORD base64_encode( const BYTE *data, DWORD len, WCHAR *out )
+{
+    DWORD i, n = 0;
+
+    for (i = 0; i < len; i += 3)
+    {
+        DWORD v = data[i] << 16 | (i + 1 < len ? data[i + 1] << 8 : 0) | (i + 2 < len ? data[i + 2] : 0);
+        if (out)
+        {
+            out[n] = base64[v >> 18];
+            out[n + 1] = base64[(v >> 12) & 0x3f];
+            out[n + 2] = i + 1 < len ? base64[(v >> 6) & 0x3f] : '=';
+            out[n + 3] = i + 2 < len ? base64[v & 0x3f] : '=';
+        }
+        n += 4;
+    }
+    return n;
+}
+
+static int base64_value( WCHAR c )
+{
+    const char *p;
+    if (!c || c > 0x7f || !(p = strchr( base64, c ))) return -1;
+    return p - base64;
+}
+
+static BOOL base64_decode( const WCHAR *in, DWORD len, BYTE *out, DWORD *out_len )
+{
+    DWORD i, n = 0;
+
+    if (len % 4) return FALSE;
+    for (i = 0; i < len; i += 4)
+    {
+        int a = base64_value( in[i] ), b = base64_value( in[i + 1] ), c, d;
+        DWORD v;
+
+        if (a < 0 || b < 0) return FALSE;
+        c = in[i + 2] == '=' ? 0 : base64_value( in[i + 2] );
+        d = in[i + 3] == '=' ? 0 : base64_value( in[i + 3] );
+        if (c < 0 || d < 0) return FALSE;
+        v = a << 18 | b << 12 | c << 6 | d;
+        out[n++] = v >> 16;
+        if (in[i + 2] != '=') out[n++] = (v >> 8) & 0xff;
+        if (in[i + 3] != '=') out[n++] = v & 0xff;
+    }
+    *out_len = n;
+    return TRUE;
+}
+
+static BOOL is_protected( const WCHAR *cred, DWORD len )
+{
+    DWORD prefix = wcslen( PROTECTED_PREFIX );
+    return len > prefix && !wcsncmp( cred, PROTECTED_PREFIX, prefix );
+}
+
+/******************************************************************************
+ * CredIsProtectedW [ADVAPI32.@]
+ */
+BOOL WINAPI CredIsProtectedW( LPWSTR cred, CRED_PROTECTION_TYPE *type )
+{
+    TRACE( "(%p, %p)\n", cred, type );
+
+    if (!cred || !type)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *type = is_protected( cred, wcslen( cred ) ) ? CredUserProtection : CredUnprotected;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredIsProtectedA [ADVAPI32.@]
+ */
+BOOL WINAPI CredIsProtectedA( LPSTR cred, CRED_PROTECTION_TYPE *type )
+{
+    TRACE( "(%p, %p)\n", cred, type );
+
+    if (!cred || !type)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *type = !strncmp( cred, "@@D", 3 ) && cred[3] ? CredUserProtection : CredUnprotected;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredProtectW [ADVAPI32.@]
+ */
+BOOL WINAPI CredProtectW( BOOL as_self, LPWSTR cred, DWORD cred_len, LPWSTR protected, DWORD *protected_len,
+                          CRED_PROTECTION_TYPE *type )
+{
+    DATA_BLOB in, out;
+    DWORD needed;
+
+    TRACE( "(%d, %p, %lu, %p, %p, %p)\n", as_self, cred, cred_len, protected, protected_len, type );
+
+    if (!cred || !cred_len || !protected_len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (cred[cred_len - 1]) cred_len++;  /* the length may count the terminating null or not */
+    if (is_protected( cred, cred_len - 1 ))
+    {
+        /* already protected: as it is */
+        if (*protected_len < cred_len || !protected)
+        {
+            *protected_len = cred_len;
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        memcpy( protected, cred, (cred_len - 1) * sizeof(WCHAR) );
+        protected[cred_len - 1] = 0;
+        *protected_len = cred_len;
+        if (type) *type = CredUserProtection;
+        return TRUE;
+    }
+
+    in.pbData = (BYTE *)cred;
+    in.cbData = (cred_len - 1) * sizeof(WCHAR);
+#ifdef SG_MUTANT_CRED_NOT_ENCRYPTED
+    out.cbData = in.cbData;
+    out.pbData = LocalAlloc( 0, in.cbData + 1 );
+    memcpy( out.pbData, in.pbData, in.cbData );
+#else
+    if (!CryptProtectData( &in, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &out )) return FALSE;
+#endif
+    needed = wcslen( PROTECTED_PREFIX ) + base64_encode( out.pbData, out.cbData, NULL ) + 1;
+    if (*protected_len < needed || !protected)
+    {
+        LocalFree( out.pbData );
+        *protected_len = needed;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    lstrcpyW( protected, PROTECTED_PREFIX );
+    base64_encode( out.pbData, out.cbData, protected + wcslen( PROTECTED_PREFIX ) );
+    protected[needed - 1] = 0;
+    LocalFree( out.pbData );
+    *protected_len = needed;
+    if (type) *type = CredUserProtection;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredUnprotectW [ADVAPI32.@]
+ */
+BOOL WINAPI CredUnprotectW( BOOL as_self, LPWSTR protected, DWORD protected_len, LPWSTR cred, DWORD *cred_len )
+{
+    DWORD prefix = wcslen( PROTECTED_PREFIX ), len, needed;
+    DATA_BLOB in, out;
+    BYTE *blob;
+
+    TRACE( "(%d, %p, %lu, %p, %p)\n", as_self, protected, protected_len, cred, cred_len );
+
+    if (!protected || !protected_len || !cred_len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    len = protected[protected_len - 1] ? protected_len : protected_len - 1;
+    if (!is_protected( protected, len ))
+    {
+        /* not protected: as it is */
+        if (*cred_len < len + 1 || !cred)
+        {
+            *cred_len = len + 1;
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        memcpy( cred, protected, len * sizeof(WCHAR) );
+        cred[len] = 0;
+        *cred_len = len + 1;
+        return TRUE;
+    }
+    if (!(blob = malloc( len )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    if (!base64_decode( protected + prefix, len - prefix, blob, &in.cbData ))
+    {
+        free( blob );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    in.pbData = blob;
+#ifdef SG_MUTANT_CRED_NOT_ENCRYPTED
+    out.cbData = in.cbData;
+    out.pbData = LocalAlloc( 0, in.cbData + 1 );
+    memcpy( out.pbData, in.pbData, in.cbData );
+#else
+    if (!CryptUnprotectData( &in, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &out ))
+    {
+        free( blob );
+        return FALSE;
+    }
+#endif
+    free( blob );
+    needed = out.cbData / sizeof(WCHAR) + 1;
+    if (*cred_len < needed || !cred)
+    {
+        SecureZeroMemory( out.pbData, out.cbData );
+        LocalFree( out.pbData );
+        *cred_len = needed;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memcpy( cred, out.pbData, out.cbData );
+    cred[needed - 1] = 0;
+    SecureZeroMemory( out.pbData, out.cbData );
+    LocalFree( out.pbData );
+    *cred_len = needed;
+    return TRUE;
+}
+
+static WCHAR *strdup_AtoW_len( const char *str, DWORD len, DWORD *lenW )
+{
+    WCHAR *ret;
+
+    *lenW = MultiByteToWideChar( CP_ACP, 0, str, len, NULL, 0 );
+    if (!(ret = malloc( (*lenW + 1) * sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( CP_ACP, 0, str, len, ret, *lenW );
+    ret[*lenW] = 0;
+    return ret;
+}
+
+/******************************************************************************
+ * CredProtectA [ADVAPI32.@]
+ */
+BOOL WINAPI CredProtectA( BOOL as_self, LPSTR cred, DWORD cred_len, LPSTR protected, DWORD *protected_len,
+                          CRED_PROTECTION_TYPE *type )
+{
+    WCHAR *credW, *outW = NULL;
+    DWORD lenW, out_lenW = 0, needed;
+    BOOL ret;
+
+    TRACE( "(%d, %p, %lu, %p, %p, %p)\n", as_self, cred, cred_len, protected, protected_len, type );
+
+    if (!cred || !cred_len || !protected_len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(credW = strdup_AtoW_len( cred, cred[cred_len - 1] ? cred_len : cred_len - 1, &lenW ))) return FALSE;
+    CredProtectW( as_self, credW, lenW + 1, NULL, &out_lenW, NULL );
+    if (!(outW = malloc( out_lenW * sizeof(WCHAR) ))) ret = FALSE;
+    else ret = CredProtectW( as_self, credW, lenW + 1, outW, &out_lenW, type );
+    SecureZeroMemory( credW, lenW * sizeof(WCHAR) );
+    free( credW );
+    if (ret)
+    {
+        needed = WideCharToMultiByte( CP_ACP, 0, outW, -1, NULL, 0, NULL, NULL );
+        if (*protected_len < needed || !protected)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            ret = FALSE;
+        }
+        else WideCharToMultiByte( CP_ACP, 0, outW, -1, protected, needed, NULL, NULL );
+        *protected_len = needed;
+    }
+    free( outW );
+    return ret;
+}
+
+/******************************************************************************
+ * CredUnprotectA [ADVAPI32.@]
+ */
+BOOL WINAPI CredUnprotectA( BOOL as_self, LPSTR protected, DWORD protected_len, LPSTR cred, DWORD *cred_len )
+{
+    WCHAR *protectedW, *outW = NULL;
+    DWORD lenW, out_lenW = 0, needed;
+    BOOL ret;
+
+    TRACE( "(%d, %p, %lu, %p, %p)\n", as_self, protected, protected_len, cred, cred_len );
+
+    if (!protected || !protected_len || !cred_len)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(protectedW = strdup_AtoW_len( protected, protected[protected_len - 1] ? protected_len : protected_len - 1,
+                                        &lenW )))
+        return FALSE;
+    CredUnprotectW( as_self, protectedW, lenW + 1, NULL, &out_lenW );
+    if (!(outW = malloc( out_lenW * sizeof(WCHAR) ))) ret = FALSE;
+    else ret = CredUnprotectW( as_self, protectedW, lenW + 1, outW, &out_lenW );
+    free( protectedW );
+    if (ret)
+    {
+        needed = WideCharToMultiByte( CP_ACP, 0, outW, -1, NULL, 0, NULL, NULL );
+        if (*cred_len < needed || !cred)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            ret = FALSE;
+        }
+        else WideCharToMultiByte( CP_ACP, 0, outW, -1, cred, needed, NULL, NULL );
+        *cred_len = needed;
+        SecureZeroMemory( outW, out_lenW * sizeof(WCHAR) );
+    }
+    free( outW );
+    return ret;
+}
+
+/* "*.example.com" matches "host.example.com"; "*" matches everything;
+ * a domain name target "example.com" matches only itself */
+static int target_match( const WCHAR *pattern, const WCHAR *target )
+{
+    size_t plen = wcslen( pattern ), tlen = wcslen( target );
+
+    if (!wcsicmp( pattern, target )) return 3;
+    if (plen >= 2 && pattern[0] == '*' && pattern[1] == '.' && tlen > plen - 1
+            && !wcsicmp( target + tlen - (plen - 1), pattern + 1 ))
+        return 2;
+    if (!wcscmp( pattern, L"*" )) return 1;
+    return 0;
+}
+
+/******************************************************************************
+ * CredFindBestCredentialW [ADVAPI32.@]
+ */
+BOOL WINAPI CredFindBestCredentialW( LPCWSTR target, DWORD type, DWORD flags, PCREDENTIALW *cred )
+{
+    CREDENTIALW **creds, *best = NULL;
+    DWORD count, i;
+    int best_score = 0, score;
+
+    TRACE( "(%s, %lu, %#lx, %p)\n", debugstr_w(target), type, flags, cred );
+
+    if (!target || !cred || !type || type >= CRED_TYPE_MAXIMUM || flags)
+    {
+        SetLastError( !flags ? ERROR_INVALID_PARAMETER : ERROR_INVALID_FLAGS );
+        return FALSE;
+    }
+    if (CredReadW( target, type, 0, cred )) return TRUE;
+    if (!CredEnumerateW( NULL, CRED_ENUMERATE_ALL_CREDENTIALS, &count, &creds ))
+    {
+        SetLastError( ERROR_NOT_FOUND );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (creds[i]->Type != type) continue;
+        if ((score = target_match( creds[i]->TargetName, target )) > best_score)
+        {
+            best_score = score;
+            best = creds[i];
+        }
+    }
+    if (best && CredReadW( best->TargetName, type, 0, cred ))
+    {
+        CredFree( creds );
+        return TRUE;
+    }
+    CredFree( creds );
+    SetLastError( ERROR_NOT_FOUND );
+    return FALSE;
+}
+
+/******************************************************************************
+ * CredFindBestCredentialA [ADVAPI32.@]
+ */
+BOOL WINAPI CredFindBestCredentialA( LPCSTR target, DWORD type, DWORD flags, PCREDENTIALA *cred )
+{
+    CREDENTIALW *credW;
+    WCHAR *targetW;
+    DWORD lenW;
+    INT len;
+
+    TRACE( "(%s, %lu, %#lx, %p)\n", debugstr_a(target), type, flags, cred );
+
+    if (!target || !cred)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(targetW = strdup_AtoW_len( target, -1, &lenW ))) return FALSE;
+    if (!CredFindBestCredentialW( targetW, type, flags, &credW ))
+    {
+        free( targetW );
+        return FALSE;
+    }
+    free( targetW );
+    len = convert_PCREDENTIALW_to_PCREDENTIALA( credW, NULL, 0 );
+    if (!(*cred = malloc( len )))
+    {
+        CredFree( credW );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    convert_PCREDENTIALW_to_PCREDENTIALA( credW, *cred, len );
+    CredFree( credW );
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredWriteDomainCredentialsW [ADVAPI32.@]
+ */
+BOOL WINAPI CredWriteDomainCredentialsW( PCREDENTIAL_TARGET_INFORMATIONW info, PCREDENTIALW cred, DWORD flags )
+{
+    CREDENTIALW copy;
+
+    TRACE( "(%p, %p, %#lx)\n", info, cred, flags );
+
+    if (!info || !cred)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (cred->Type != CRED_TYPE_DOMAIN_PASSWORD && cred->Type != CRED_TYPE_DOMAIN_CERTIFICATE &&
+        cred->Type != CRED_TYPE_DOMAIN_VISIBLE_PASSWORD)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    copy = *cred;
+    /* the target is the most specific name the target information has */
+    if (!copy.TargetName)
+    {
+        if (info->DnsServerName) copy.TargetName = info->DnsServerName;
+        else if (info->NetbiosServerName) copy.TargetName = info->NetbiosServerName;
+        else if (info->TargetName) copy.TargetName = info->TargetName;
+        else if (info->DnsDomainName) copy.TargetName = info->DnsDomainName;
+        else copy.TargetName = info->NetbiosDomainName;
+    }
+    if (!copy.TargetName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return CredWriteW( &copy, flags );
+}
+
+/******************************************************************************
+ * CredWriteDomainCredentialsA [ADVAPI32.@]
+ */
+BOOL WINAPI CredWriteDomainCredentialsA( PCREDENTIAL_TARGET_INFORMATIONA info, PCREDENTIALA cred, DWORD flags )
+{
+    CREDENTIAL_TARGET_INFORMATIONW infoW;
+    CREDENTIALW *credW;
+    WCHAR *strs[6] = { 0 };
+    DWORD lenW, i;
+    INT len;
+    BOOL ret;
+
+    TRACE( "(%p, %p, %#lx)\n", info, cred, flags );
+
+    if (!info || !cred)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    len = convert_PCREDENTIALA_to_PCREDENTIALW( cred, NULL, 0 );
+    if (!(credW = malloc( len )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    convert_PCREDENTIALA_to_PCREDENTIALW( cred, credW, len );
+    memset( &infoW, 0, sizeof(infoW) );
+    if (info->TargetName) infoW.TargetName = strs[0] = strdup_AtoW_len( info->TargetName, -1, &lenW );
+    if (info->NetbiosServerName) infoW.NetbiosServerName = strs[1] = strdup_AtoW_len( info->NetbiosServerName, -1, &lenW );
+    if (info->DnsServerName) infoW.DnsServerName = strs[2] = strdup_AtoW_len( info->DnsServerName, -1, &lenW );
+    if (info->NetbiosDomainName) infoW.NetbiosDomainName = strs[3] = strdup_AtoW_len( info->NetbiosDomainName, -1, &lenW );
+    if (info->DnsDomainName) infoW.DnsDomainName = strs[4] = strdup_AtoW_len( info->DnsDomainName, -1, &lenW );
+    if (info->DnsTreeName) infoW.DnsTreeName = strs[5] = strdup_AtoW_len( info->DnsTreeName, -1, &lenW );
+    infoW.Flags = info->Flags;
+    infoW.CredTypeCount = info->CredTypeCount;
+    infoW.CredTypes = info->CredTypes;
+    ret = CredWriteDomainCredentialsW( &infoW, credW, flags );
+    for (i = 0; i < ARRAY_SIZE(strs); i++) free( strs[i] );
+    free( credW );
+    return ret;
+}
+
+/******************************************************************************
+ * CredRenameW [ADVAPI32.@]
+ *
+ * Not supported since Windows Vista: ERROR_NOT_SUPPORTED, as there.
+ */
+BOOL WINAPI CredRenameW( LPCWSTR old_target, LPCWSTR new_target, DWORD type, DWORD flags )
+{
+    TRACE( "(%s, %s, %lu, %#lx)\n", debugstr_w(old_target), debugstr_w(new_target), type, flags );
+    SetLastError( ERROR_NOT_SUPPORTED );
+    return FALSE;
+}
+
+/******************************************************************************
