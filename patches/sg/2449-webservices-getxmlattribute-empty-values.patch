From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: WsGetXmlAttribute, and empty strings, byte arrays and XML strings point at something

Ground truth from Wine's reader tests (18 todo_wine marks removed). WsGetXmlAttribute (a stub) returns the value of the current element's attribute of that local name in no namespace as characters on the heap (not null-terminated) with S_OK, or S_FALSE with no characters if there is none. Empty content read as a WS_STRING, WS_BYTES or WS_XML_STRING gives a zero-length value whose chars/bytes are set (a block of no size from the heap); the empty value of a binary-encoded xmlns attribute likewise.
---
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -837,14 +837,72 @@ HRESULT WINAPI WsGetReaderProperty( WS_XML_READER *handle, WS_XML_READER_PROPERT
     return hr;
 }
 
+static HRESULT text_to_string( const WS_XML_TEXT *, WS_HEAP *, WS_STRING * );
+
 /**************************************************************************
  *          WsGetXmlAttribute		[webservices.@]
  */
 HRESULT WINAPI WsGetXmlAttribute( WS_XML_READER *handle, const WS_XML_STRING *attr,
                                   WS_HEAP *heap, WCHAR **str, ULONG *len, WS_ERROR *error )
 {
-    FIXME( "%p %s %p %p %p %p: stub\n", handle, debugstr_xmlstr(attr), heap, str, len, error );
-    return E_NOTIMPL;
+    struct reader *reader = (struct reader *)handle;
+    const WS_XML_ELEMENT_NODE *elem;
+    HRESULT hr = S_FALSE;
+    ULONG i;
+
+    TRACE( "%p %s %p %p %p %p\n", handle, debugstr_xmlstr(attr), heap, str, len, error );
+    if (error) FIXME( "ignoring error parameter\n" );
+
+    if (!reader || !attr || !heap || !str || !len) return E_INVALIDARG;
+
+    EnterCriticalSection( &reader->cs );
+
+    if (reader->magic != READER_MAGIC)
+    {
+        LeaveCriticalSection( &reader->cs );
+        return E_INVALIDARG;
+    }
+
+    if (!reader->input_type)
+    {
+        LeaveCriticalSection( &reader->cs );
+        return WS_E_INVALID_OPERATION;
+    }
+
+    *str = NULL;
+    *len = 0;
+
+    if (node_type( reader->current ) != WS_XML_NODE_TYPE_ELEMENT)
+    {
+        LeaveCriticalSection( &reader->cs );
+        return WS_E_INVALID_OPERATION;
+    }
+
+    /* the value of the attribute of that local name, in no namespace */
+    elem = (const WS_XML_ELEMENT_NODE *)&reader->current->hdr;
+    for (i = 0; i < elem->attributeCount; i++)
+    {
+        const WS_XML_ATTRIBUTE *a = elem->attributes[i];
+#ifndef SG_MUTANT_WSATTR_FIND
+        if (a->ns && a->ns->length) continue;
+#endif
+        if (WsXmlStringEquals( attr, a->localName, NULL ) != S_OK) continue;
+        if (a->value)
+        {
+            WS_STRING val;
+            if ((hr = text_to_string( a->value, heap, &val )) == S_OK)
+            {
+                *str = val.chars;
+                *len = val.length;
+            }
+        }
+        else hr = S_OK;
+        break;
+    }
+
+    LeaveCriticalSection( &reader->cs );
+    TRACE( "returning %#lx\n", hr );
+    return hr;
 }
 
 WS_XML_UTF8_TEXT *alloc_utf8_text( const BYTE *data, ULONG len )
@@ -1928,6 +1986,9 @@ static HRESULT read_attribute_bin( struct reader *reader, WS_XML_ATTRIBUTE **ret
                 hr = E_OUTOFMEMORY;
                 goto error;
             }
+#ifndef SG_MUTANT_WSEMPTY
+            utf8->value.bytes = (BYTE *)(utf8 + 1);   /* binary xmlns attributes: empty, but not null */
+#endif
             attr->value = &utf8->text;
             if ((hr = bind_prefix( reader, attr->prefix, attr->ns )) != S_OK) goto error;
             attr->isXmlNs = 1;
@@ -1946,6 +2007,9 @@ static HRESULT read_attribute_bin( struct reader *reader, WS_XML_ATTRIBUTE **ret
                 hr = E_OUTOFMEMORY;
                 goto error;
             }
+#ifndef SG_MUTANT_WSEMPTY
