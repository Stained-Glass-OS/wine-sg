+        !(val.chars = ws_alloc( heap, 0 ))) return WS_E_QUOTA_EXCEEDED;
+#endif
 
     switch (option)
     {
@@ -5919,6 +5988,11 @@ static HRESULT read_type_bytes( struct reader *reader, WS_TYPE_MAPPING mapping,
 
     if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_bytes( text, heap, &val )) != S_OK) return hr;
+#ifndef SG_MUTANT_WSEMPTY
+    /* an empty value is still a value: it points at something (a block of no size) */
+    if (!*found && (option == WS_READ_REQUIRED_VALUE || option == WS_READ_REQUIRED_POINTER) && !val.bytes &&
+        !(val.bytes = ws_alloc( heap, 0 ))) return WS_E_QUOTA_EXCEEDED;
+#endif
 
     switch (option)
     {
@@ -5978,6 +6052,11 @@ static HRESULT read_type_xml_string( struct reader *reader, WS_TYPE_MAPPING mapp
 
     if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_xml_string( text, heap, &val )) != S_OK) return hr;
+#ifndef SG_MUTANT_WSEMPTY
+    /* an empty value is still a value: it points at something (a block of no size) */
+    if (!*found && (option == WS_READ_REQUIRED_VALUE || option == WS_READ_REQUIRED_POINTER) && !val.bytes &&
+        !(val.bytes = ws_alloc( heap, 0 ))) return WS_E_QUOTA_EXCEEDED;
+#endif
 
     switch (option)
     {
