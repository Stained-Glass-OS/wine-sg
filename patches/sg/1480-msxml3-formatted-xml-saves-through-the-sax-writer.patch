From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: formatted XML saves through the SAX writer

Delphi's xmldoc saves a document formatted by running a SAX reader into
an MXXMLWriter through the VB interfaces, as scripts do. Meedio
Configuration saving its settings got "This has not been implemented
yet" (David's report 20261007-231028-4796e1). Three faults:

- the writer's output set to a string (an empty one: "write to a
  string") was E_NOTIMPL; it now resets the output, as VT_EMPTY does,
  and a variant by reference and a stream handed over as IDispatch are
  taken too;
- the reader handed VB handlers a NULL namespace URI and local name
  for an element in no namespace, which the writer (as on Windows)
  refuses with E_INVALIDARG; they get an empty string;
- indenting put a line break and tabs inside an element's text
  (<b>x\r\n\t</b>, the value grew at every save) and a second line
  break after a comment.

Wine's saxreader conformance tests: 8897, no failures.

Gate: test/mxwriter-save-gate.sh (MSXML 3 and 6). Mutants
SG_MUTANT_MXWRITER_NO_STRING_OUTPUT, SG_MUTANT_MXWRITER_INDENT_TEXT,
SG_MUTANT_SAXREADER_VB_NULL.
---
--- a/dlls/msxml3/mxwriter.c
+++ b/dlls/msxml3/mxwriter.c
@@ -908,8 +908,19 @@
     if (FAILED(hr))
         return hr;
 
+    /* Stained Glass OS (wine-sg 1480): a variant by reference is its value */
+    if (V_VT(&dest) == (VT_BYREF | VT_VARIANT) && V_VARIANTREF(&dest))
+        dest = *V_VARIANTREF(&dest);
+
     switch (V_VT(&dest))
     {
+#ifndef SG_MUTANT_MXWRITER_NO_STRING_OUTPUT
+    /* Stained Glass OS (wine-sg 1480): a string -- an empty one, as Delphi's
+     * xmldoc and VB code set it -- is "write to a string", as on Windows: the
+     * output is reset, as for VT_EMPTY. It was E_NOTIMPL, "This has not been
+     * implemented yet" saving Meedio's configuration. */
+    case VT_BSTR:
+#endif
     case VT_EMPTY:
     {
         if (This->dest) IStream_Release(This->dest);
@@ -935,6 +946,22 @@
         FIXME("unhandled interface type for VT_UNKNOWN destination\n");
         return E_NOTIMPL;
     }
+    /* a stream handed over as a dispatch interface (a script's ADODB.Stream) */
+    case VT_DISPATCH:
+    {
+        IStream *stream;
+
+        if (V_DISPATCH(&dest) &&
+            IDispatch_QueryInterface(V_DISPATCH(&dest), &IID_IStream, (void**)&stream) == S_OK)
+        {
+            close_output_buffer(This);
+            if (This->dest) IStream_Release(This->dest);
+            This->dest = stream;
+            break;
+        }
+        FIXME("unhandled interface type for VT_DISPATCH destination\n");
+        return E_NOTIMPL;
+    }
     default:
         FIXME("unhandled destination type %s\n", debugstr_variant(&dest));
         return E_NOTIMPL;
@@ -1361,6 +1388,7 @@
     int nQName)
 {
     mxwriter *This = impl_from_ISAXContentHandler( iface );
+    BOOL text;
 
     TRACE("(%p)->(%s:%d %s:%d %s:%d)\n", This, debugstr_wn(namespaceUri, nnamespaceUri), nnamespaceUri,
         debugstr_wn(local_name, nlocal_name), nlocal_name, debugstr_wn(QName, nQName), nQName);
@@ -1369,6 +1397,11 @@
          (nQName == -1 && This->class_version == MSXML6))
         return E_INVALIDARG;
 
+    /* Stained Glass OS (wine-sg 1480): an element that held text ends right
+     * after it -- <b>x</b>, not <b>x\r\n\t</b>: lowering the indent forgot
+     * the text, and indenting put a line break and tabs into the element's
+     * value, which grew at every save (Meedio's configuration) */
+    text = This->text;
     writer_dec_indent(This);
 
     if (This->element)
@@ -1381,6 +1414,9 @@
         static const WCHAR closetagW[] = {'<','/'};
         static const WCHAR gtW[] = {'>'};
 
+#ifndef SG_MUTANT_MXWRITER_INDENT_TEXT
+        if (text) This->text = TRUE;
+#endif
         write_node_indent(This);
         write_output_buffer(This, closetagW, 2);
         write_output_buffer(This, QName, nQName);
@@ -1644,6 +1680,8 @@
     if (nchars)
         write_output_buffer(This, chars, nchars);
     write_output_buffer(This, ccloseW, ARRAY_SIZE(ccloseW));
+    /* wine-sg 1480: that line break is the next node's: not a second one */
+    This->newline = TRUE;
 
     return S_OK;
 }
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -1589,6 +1589,26 @@
     }
 }
 
+/* Stained Glass OS (wine-sg 1480): a VB handler gets an empty string, not
+ * NULL, for no namespace or no local name -- as Windows' reader gives it.
+ * MXXMLWriter (rightly) refuses a NULL namespace, so a reader feeding a writer
+ * through the VB interfaces (scripts, Delphi's xmldoc: Meedio saving its
+ * configuration) failed at the first element in no namespace. */
+static BSTR *vb_str(BSTR *str)
+{
+    static BSTR empty;
+#ifdef SG_MUTANT_SAXREADER_VB_NULL
+    return str;
+#endif
+    if (*str) return str;
+    if (!empty)
+    {
+        BSTR e = SysAllocString(L"");
+        if (InterlockedCompareExchangePointer((void **)&empty, e, NULL)) SysFreeString(e);
+    }
+    return &empty;
+}
+
 static void libxmlStartElementNS(
         void *ctx,
         const xmlChar *localname,
@@ -1655,7 +1675,7 @@
 
         if (This->vbInterface)
             hr = IVBSAXContentHandler_startElement(handler->vbhandler,
-                    &uri, &local, &element->qname, &This->IVBSAXAttributes_iface);
+                    vb_str(&uri), vb_str(&local), &element->qname, &This->IVBSAXAttributes_iface);
         else
             hr = ISAXContentHandler_startElement(handler->handler,
                     uri ? uri : &empty_str, SysStringLen(uri),
@@ -1728,7 +1748,7 @@
     if (This->vbInterface)
         hr = IVBSAXContentHandler_endElement(
                 handler->vbhandler,
-                &uri, &local, &element->qname);
+                vb_str(&uri), vb_str(&local), &element->qname);
     else
         hr = ISAXContentHandler_endElement(
                 handler->handler,
