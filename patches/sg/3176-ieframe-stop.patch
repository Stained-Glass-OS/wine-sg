From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 08:05:42 -0700
Subject: [PATCH] ieframe: InternetExplorer.Stop

IWebBrowser2::Stop of the InternetExplorer application asks the document to stop loading
(OLECMDID_STOP), as the WebBrowser control already does, and succeeds.

diff --git a/dlls/ieframe/ie.c b/dlls/ieframe/ie.c
index ef19ec5..350f478 100644
--- a/dlls/ieframe/ie.c
+++ b/dlls/ieframe/ie.c
@@ -255,8 +255,20 @@ static HRESULT WINAPI InternetExplorer_Refresh2(IWebBrowser2 *iface, VARIANT *Le
 static HRESULT WINAPI InternetExplorer_Stop(IWebBrowser2 *iface)
 {
     InternetExplorer *This = impl_from_IWebBrowser2(iface);
-    FIXME("(%p)\n", This);
+    IOleCommandTarget *target;
+
+    TRACE("(%p)\n", This);
+#ifdef SG_MUTANT_IE_STOP
     return E_NOTIMPL;
+#endif
+
+    /* the document stops what it is loading */
+    if(This->doc_host.document &&
+       SUCCEEDED(IUnknown_QueryInterface(This->doc_host.document, &IID_IOleCommandTarget, (void**)&target))) {
+        IOleCommandTarget_Exec(target, NULL, OLECMDID_STOP, 0, NULL, NULL);
+        IOleCommandTarget_Release(target);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI InternetExplorer_get_Application(IWebBrowser2 *iface, IDispatch **ppDisp)
