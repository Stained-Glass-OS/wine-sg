From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: GetGlyphOutline gives CFF curves as cubic splines (6537)

A PostScript-flavoured OpenType font (CFF outlines) has cubic curves.
GetGlyphOutline read every off-curve point as a TrueType quadratic one,
so GGO_NATIVE gave the cubic control points as TT_PRIM_QSPLINE B-splines
and GGO_BEZIER converted them as if they were quadratic: the curves came
out bent. Inter, which stands in for Segoe UI, is such a font, and
cairo's win32 backend (GTK programs), GDI+ path text and GDI path text
draw text from these outlines.

GGO_NATIVE now gives cubic curves as TT_PRIM_CSPLINE (control, control,
end), as Windows does for these fonts (cairo's win32 font backend reads
them so), and GGO_BEZIER passes them on unchanged. TrueType outlines are
unchanged.
---
 dlls/win32u/freetype.c | 70 ++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 68 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index 4d0a983..a5bc4db 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -3214,6 +3214,37 @@ static DWORD get_subpixel_glyph_bitmap( FT_GlyphSlot glyph, FT_BBox bbox, UINT f
     return needed;
 }
 
+static BOOL is_cubic_tag( char tag )
+{
+    return !(tag & FT_Curve_Tag_On) && (tag & 3) == FT_CURVE_TAG_CUBIC;
+}
+
+/* the cubic segments from *point on: (control, control, end) each, the end being the next point or,
+ * at the end of the contour, its first; returns the number of points */
+static unsigned int get_cubic_run( FT_Outline *outline, unsigned int contour, unsigned int first_pt,
+                                   unsigned int *point, POINTFX *out )
+{
+    unsigned int last = outline->contours[contour], cpfx = 0, p = *point;
+
+    while (p <= last && is_cubic_tag( outline->tags[p] ))
+    {
+        const FT_Vector *c1 = &outline->points[p];
+        const FT_Vector *c2 = p + 1 <= last ? &outline->points[p + 1] : &outline->points[first_pt];
+        const FT_Vector *end = p + 2 <= last ? &outline->points[p + 2] : &outline->points[first_pt];
+
+        if (out)
+        {
+            FTVectorToPOINTFX( (FT_Vector *)c1, &out[cpfx] );
+            FTVectorToPOINTFX( (FT_Vector *)c2, &out[cpfx + 1] );
+            FTVectorToPOINTFX( (FT_Vector *)end, &out[cpfx + 2] );
+        }
+        cpfx += 3;
+        p += 3;
+    }
+    *point = p;
+    return cpfx;
+}
+
 static unsigned int get_native_glyph_outline(FT_Outline *outline, unsigned int buflen, char *buf)
 {
     TTPOLYGONHEADER *pph;
@@ -3244,6 +3275,23 @@ static unsigned int get_native_glyph_outline(FT_Outline *outline, unsigned int b
         while (point <= outline->contours[contour])
         {
             ppc = (TTPOLYCURVE *)(buf + needed);
+#ifndef SG_MUTANT_CFF_AS_QSPLINE
+            if (is_cubic_tag( outline->tags[point] ))
+            {
+                /* Stained Glass OS (wine-sg 6537): a PostScript (CFF) outline's curves are cubic;
+                 * GGO_NATIVE gives them as TT_PRIM_CSPLINE (control, control, end), as Windows
+                 * does (cairo's win32 font backend reads them so); they were given as quadratic
+                 * B-splines, which bent the curves of Inter, the Segoe UI stand-in */
+                cpfx = get_cubic_run( outline, contour, first_pt, &point, buf ? ppc->apfx : NULL );
+                if (buf)
+                {
+                    ppc->wType = TT_PRIM_CSPLINE;
+                    ppc->cpfx = cpfx;
+                }
+                needed += sizeof(*ppc) + (cpfx - 1) * sizeof(POINTFX);
+                continue;
+            }
+#endif
             type = outline->tags[point] & FT_Curve_Tag_On ?
                 TT_PRIM_LINE : TT_PRIM_QSPLINE;
             cpfx = 0;
@@ -3255,7 +3303,8 @@ static unsigned int get_native_glyph_outline(FT_Outline *outline, unsigned int b
                 point++;
             } while (point <= outline->contours[contour] &&
                     (outline->tags[point] & FT_Curve_Tag_On) ==
-                    (outline->tags[point-1] & FT_Curve_Tag_On));
+                    (outline->tags[point-1] & FT_Curve_Tag_On) &&
+                    !is_cubic_tag( outline->tags[point] ));
             /* At the end of a contour Windows adds the start point, but
                only for Beziers */
             if (point > outline->contours[contour] &&
@@ -3327,6 +3376,22 @@ static unsigned int get_bezier_glyph_outline(FT_Outline *outline, unsigned int b
         while (point <= outline->contours[contour])
         {
             ppc = (TTPOLYCURVE *)(buf + needed);
+#ifndef SG_MUTANT_CFF_AS_QSPLINE
+            if (is_cubic_tag( outline->tags[point] ))
+            {
+                /* cubic already: the points as they are */
+                unsigned int next = point;
+                cpfx = get_cubic_run( outline, contour, first_pt, &next, buf ? ppc->apfx : NULL );
+                point = next;
+                if (buf)
+                {
+                    ppc->wType = TT_PRIM_CSPLINE;
+                    ppc->cpfx = cpfx;
+                }
+                needed += sizeof(*ppc) + (cpfx - 1) * sizeof(POINTFX);
+                continue;
+            }
+#endif
             type = outline->tags[point] & FT_Curve_Tag_On ?
                 TT_PRIM_LINE : TT_PRIM_CSPLINE;
             cpfx = 0;
@@ -3387,7 +3452,8 @@ static unsigned int get_bezier_glyph_outline(FT_Outline *outline, unsigned int b
                 }
             } while (point <= outline->contours[contour] &&
                     (outline->tags[point] & FT_Curve_Tag_On) ==
-                    (outline->tags[point-1] & FT_Curve_Tag_On));
+                    (outline->tags[point-1] & FT_Curve_Tag_On) &&
+                    !is_cubic_tag( outline->tags[point] ));
             /* At the end of a contour Windows adds the start point,
                but only for Beziers and we've already done that.
             */
