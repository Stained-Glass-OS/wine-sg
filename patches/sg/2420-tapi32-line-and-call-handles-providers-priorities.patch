From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tapi32: calls on line and call handles fail as they must with no devices; providers and priorities

This machine has TAPI and no telephony devices, so no line or call handle can
exist. The sixty calls that took one still answered success (a made-up
request id, or 0) as if there were; they now fail with the error of an invalid
handle of their kind (LINEERR_INVALCALLHANDLE, LINEERR_INVALLINEHANDLE). Those
that name a line or a call by a select value (lineGetID, lineSetMediaControl,
lineSetTerminal) check the one the select names and refuse any other select
(LINEERR_INVALCALLSELECT); lineSetupConference names one or the other;
lineMakeCall clears the call handle it would have returned.

- lineGetProviderList: an empty list of the size it needs, with the
  structure and API version checks.
- lineAddProvider: LINEERR_OPERATIONFAILED after the pointer and name checks
  (no provider can be installed); lineRemoveProvider and lineConfigProvider
  of a provider that is not there: LINEERR_INVALPARAM.
- lineGetAppPriority and lineSetAppPriority keep the handoff priority per
  application, media mode or request mode, case-insensitively, for the
  process, with the mode checks.
---
--- a/dlls/tapi32/line.c
+++ b/dlls/tapi32/line.c
@@ -32,6 +32,7 @@
 #include "objbase.h"
 #include "tapi.h"
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(tapi);
 
@@ -44,13 +45,60 @@ static const char szCardsKey[] =
     "Software\\Microsoft\\Windows\\CurrentVersion\\Telephony\\Cards";
 
 
+
+/* Application priorities for handing off calls: kept for this process only. */
+struct app_priority
+{
+    struct list entry;
+    char *app;
+    DWORD media_mode;
+    DWORD request_mode;
+    DWORD priority;
+};
+
+static struct list app_priorities = LIST_INIT( app_priorities );
+static CRITICAL_SECTION priority_cs;
+static CRITICAL_SECTION_DEBUG priority_cs_debug =
+{
+    0, 0, &priority_cs,
+    { &priority_cs_debug.ProcessLocksList, &priority_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": priority_cs") }
+};
+static CRITICAL_SECTION priority_cs = { &priority_cs_debug, -1, 0, 0, 0, 0 };
+
+/* either one media mode, or none and one request mode */
+static DWORD check_priority_modes( DWORD media_mode, DWORD request_mode )
+{
+    if (media_mode)
+    {
+        /* one of the media mode bits, from UNKNOWN (2) to the last one (0x8000) */
+        if ((media_mode & (media_mode - 1)) || (media_mode & ~0x0000fffe)) return LINEERR_INVALMEDIAMODE;
+        return 0;
+    }
+    if (request_mode != 1 && request_mode != 2 && request_mode != 4) return request_mode ? LINEERR_INVALREQUESTMODE : LINEERR_INVALPARAM;
+    return 0;
+}
+
+static struct app_priority *find_priority( const char *app, DWORD media_mode, DWORD request_mode )
+{
+    struct app_priority *p;
+
+    LIST_FOR_EACH_ENTRY( p, &app_priorities, struct app_priority, entry )
+#ifdef SG_MUTANT_TAPIH_PRIO
+        if (!stricmp( p->app, app )) return p;
+#else
+        if (!stricmp( p->app, app ) && p->media_mode == media_mode && p->request_mode == request_mode) return p;
+#endif
+    return NULL;
+}
+
