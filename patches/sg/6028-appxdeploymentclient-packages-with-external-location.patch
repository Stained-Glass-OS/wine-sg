+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * A package with external location (a "sparse" package) gives its identity
+ * to a program in the external location only when the program's own
+ * side-by-side manifest (RT_MANIFEST 1) names the package:
+ *
+ *   <msix xmlns="urn:schemas-microsoft-com:msix.v1" publisher="CN=..."
+ *         packageName="..." applicationId="..."/>
+ *
+ * appxdeploymentclient records the external location (ExternalLocation),
+ * kernelbase and ntdll check the program's manifest with this.
+ */
+
+#ifndef __WINE_WINE_SPARSEID_H
+#define __WINE_WINE_SPARSEID_H
+
+static inline WCHAR sparseid_fold( WCHAR c )
+{
+    return (c >= 'A' && c <= 'Z') ? c + 'a' - 'A' : c;
+}
+
+/* The value of attribute name in the element at xml[start, end), decoded from UTF-8 and XML entities. */
+static inline BOOL sparseid_attribute( const char *xml, SIZE_T start, SIZE_T end, const char *name,
+                                       WCHAR *value, SIZE_T size )
+{
+    SIZE_T i, len = 0, n = 0, out = 0;
+    char quote;
+
+    while (name[len]) len++;
+    for (i = start; i + len + 2 < end; i++)
+    {
+        if (xml[i] != ' ' && xml[i] != '\t' && xml[i] != '\r' && xml[i] != '\n') continue;
+        for (n = 0; n < len && xml[i + 1 + n] == name[n]; n++);
+        if (n < len) continue;
+        i += 1 + len;
+        while (i < end && (xml[i] == ' ' || xml[i] == '\t' || xml[i] == '\r' || xml[i] == '\n')) i++;
+        if (i >= end || xml[i] != '=') continue;
+        i++;
+        while (i < end && (xml[i] == ' ' || xml[i] == '\t' || xml[i] == '\r' || xml[i] == '\n')) i++;
+        if (i >= end || (xml[i] != '"' && xml[i] != '\'')) return FALSE;
+        quote = xml[i++];
+        while (i < end && xml[i] != quote)
+        {
+            unsigned int c = (unsigned char)xml[i++];
+
+            if (c == '&')
+            {
+                SIZE_T semi = i;
+                while (semi < end && semi - i < 10 && xml[semi] != ';') semi++;
+                if (semi >= end || xml[semi] != ';') return FALSE;
+                if (semi - i == 4 && !memcmp( xml + i, "quot", 4 )) c = '"';
+                else if (semi - i == 3 && !memcmp( xml + i, "amp", 3 )) c = '&';
+                else if (semi - i == 4 && !memcmp( xml + i, "apos", 4 )) c = '\'';
+                else if (semi - i == 2 && !memcmp( xml + i, "lt", 2 )) c = '<';
+                else if (semi - i == 2 && !memcmp( xml + i, "gt", 2 )) c = '>';
+                else if (semi - i >= 2 && xml[i] == '#')
+                {
+                    SIZE_T k = i + 1;
+                    BOOL hex = xml[k] == 'x';
+                    c = 0;
+                    for (k += hex; k < semi; k++)
+                    {
+                        char d = xml[k];
+                        if (d >= '0' && d <= '9') c = c * (hex ? 16 : 10) + d - '0';
+                        else if (hex && d >= 'a' && d <= 'f') c = c * 16 + d - 'a' + 10;
+                        else if (hex && d >= 'A' && d <= 'F') c = c * 16 + d - 'A' + 10;
+                        else return FALSE;
+                        if (c > 0x10ffff) return FALSE;
+                    }
+                }
+                else return FALSE;
+                i = semi + 1;
+            }
+            else if (c >= 0x80)
+            {
+                int more = c >= 0xf0 ? 3 : c >= 0xe0 ? 2 : c >= 0xc0 ? 1 : -1;
+                if (more < 0) return FALSE;
+                c &= 0x3f >> more;
+                while (more--)
+                {
+                    if (i >= end || ((unsigned char)xml[i] & 0xc0) != 0x80) return FALSE;
+                    c = (c << 6) | ((unsigned char)xml[i++] & 0x3f);
+                }
+            }
+            if (c >= 0x10000)
+            {
+                if (out + 2 >= size) return FALSE;
+                c -= 0x10000;
+                value[out++] = 0xd800 | (c >> 10);
+                value[out++] = 0xdc00 | (c & 0x3ff);
+            }
+            else
+            {
+                if (out + 1 >= size) return FALSE;
+                value[out++] = c;
+            }
+        }
+        if (i >= end) return FALSE;
+        value[out] = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static inline BOOL sparseid_equal( const WCHAR *a, const WCHAR *b )
+{
+    while (*a && sparseid_fold( *a ) == sparseid_fold( *b )) a++, b++;
+    return !*a && !*b;
+}
+
+/* Whether a manifest (UTF-8 XML) names the package of this name and publisher in an msix element. */
+static inline BOOL sparseid_manifest_names_package( const char *xml, SIZE_T size, const WCHAR *name,
+                                                    const WCHAR *publisher )
+{
+    WCHAR value[512];
+    SIZE_T i, end;
+
+    if (!xml || !name || !publisher) return FALSE;
+    for (i = 0; i + 6 < size; i++)
+    {
+        if (xml[i] != '<' || memcmp( xml + i + 1, "msix", 4 ) ||
+            (xml[i + 5] != ' ' && xml[i + 5] != '\t' && xml[i + 5] != '\r' && xml[i + 5] != '\n'))
+            continue;
+        for (end = i; end < size && xml[end] != '>'; end++);
+        if (end >= size) return FALSE;
+        if (!sparseid_attribute( xml, i + 4, end, "packageName", value, ARRAY_SIZE(value) ) ||
+            !sparseid_equal( value, name ))
+            continue;
+        if (!sparseid_attribute( xml, i + 4, end, "publisher", value, ARRAY_SIZE(value) ) ||
+            !sparseid_equal( value, publisher ))
+            continue;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+#endif  /* __WINE_WINE_SPARSEID_H */
