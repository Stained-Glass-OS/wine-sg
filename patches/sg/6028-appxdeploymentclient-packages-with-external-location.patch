+static HRESULT WINAPI package_manager9_AddPackageByUriAsync( IPackageManager9 *iface, IUriRuntimeClass *uri,
+    IAddPackageOptions *add_options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    IIterable_Uri *dependencies, *optional, *related;
+    IVector_Uri *vector = NULL;
+    IVector_HSTRING *names = NULL;
+    IPackageVolume *volume = NULL;
+    IUriRuntimeClass *external = NULL;
+    StubPackageOption stub = StubPackageOption_Default;
+    DeploymentOptions options = 0;
+    boolean developer = FALSE;
+    HRESULT hr;
+
+    TRACE( "iface %p, uri %p, options %p, operation %p.\n", iface, uri, add_options, operation );
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!uri || !add_options) return E_INVALIDARG;
+
+    IAddPackageOptions_get_DeveloperMode( add_options, &developer );
+    /* development mode is for registering a loose manifest */
+    if (developer) return E_INVALIDARG;
+    IAddPackageOptions_get_TargetVolume( add_options, &volume );
+    if (volume)
+    {
+        BOOL ours = is_package_volume( volume );
+        IPackageVolume_Release( volume );
+        if (!ours) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+    IAddPackageOptions_get_StubPackageOption( add_options, &stub );
+    /* no stub packages are deployed here: a package is installed in full */
+    if (stub == StubPackageOption_InstallStub) FIXME( "stub packages are installed in full\n" );
+    OPTION_FLAG( IAddPackageOptions_get_ForceAppShutdown, add_options, DeploymentOptions_ForceApplicationShutdown );
+    OPTION_FLAG( IAddPackageOptions_get_ForceTargetAppShutdown, add_options, DeploymentOptions_ForceTargetApplicationShutdown );
+    OPTION_FLAG( IAddPackageOptions_get_ForceUpdateFromAnyVersion, add_options, DeploymentOptions_ForceUpdateFromAnyVersion );
+    OPTION_FLAG( IAddPackageOptions_get_InstallAllResources, add_options, DeploymentOptions_InstallAllResources );
+    OPTION_FLAG( IAddPackageOptions_get_RequiredContentGroupOnly, add_options, DeploymentOptions_RequiredContentGroupOnly );
+    OPTION_FLAG( IAddPackageOptions_get_RetainFilesOnFailure, add_options, DeploymentOptions_RetainFilesOnFailure );
+    OPTION_FLAG( IAddPackageOptions_get_StageInPlace, add_options, DeploymentOptions_StageInPlace );
+    OPTION_FLAG( IAddPackageOptions_get_AllowUnsigned, add_options, DEPLOY_ALLOW_UNSIGNED );
+
+    IAddPackageOptions_get_OptionalPackageFamilyNames( add_options, &names );
+    if (!names_empty( names )) FIXME( "optional packages named by family are not deployed\n" );
+    IAddPackageOptions_get_DependencyPackageUris( add_options, &vector );
+    dependencies = uris_of( vector );
+    vector = NULL;
+    IAddPackageOptions_get_OptionalPackageUris( add_options, &vector );
+    optional = uris_of( vector );
+    vector = NULL;
+    IAddPackageOptions_get_RelatedPackageUris( add_options, &vector );
+    related = uris_of( vector );
+    IAddPackageOptions_get_ExternalLocationUri( add_options, &external );
+
+    hr = start_add_external( uri, external, dependencies, optional, related, options, operation );
+    if (external) IUriRuntimeClass_Release( external );
+    release_uris( dependencies, optional, related );
+    return hr;
+}
