+    }                                                                                              \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    {                                                                                              \
+        return options_release( pfx##_impl( iface ) );                                             \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *iid_count, IID **iids )         \
+    {                                                                                              \
+        return options_iids( pfx##_impl( iface ), iid_count, iids );                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )            \
+    {                                                                                              \
+        const WCHAR *str = class_name( pfx##_impl( iface )->kind );                                \
+        return WindowsCreateString( str, wcslen( str ), name );                                    \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )              \
+    {                                                                                              \
+        *level = BaseTrust;                                                                        \
+        return S_OK;                                                                               \
+    }
