+                                   WCHAR **full_name, WCHAR **error_text );
+
+/* A folder's path without the backslash it may end in (not a drive's root). */
+static WCHAR *folder_dup( const WCHAR *path )
+{
+    WCHAR *ret = wcsdup( path );
+    size_t len = ret ? wcslen( ret ) : 0;
+
+    if (len > 3 && ret[len - 1] == '\\') ret[len - 1] = 0;
+    return ret;
+}
+
+static const WCHAR unsigned_publisher_oid[] = L"OID.2.25.311729368913984317654407730594956997722=1";
+
+/* A package's external location must be allowed by its manifest, and be a folder. The publisher of an
+ * unsigned package must be in the namespace for them, the publisher of a signed one must not. */
+static HRESULT check_external_and_publisher( IAppxManifestReader *manifest, const struct package_record *rec,
+                                             const WCHAR *external, BOOL is_unsigned, WCHAR **error_text )
+{
+    IAppxManifestProperties *props;
+    BOOL allowed = FALSE, oid;
+    DWORD attrs;
+
+    if (SUCCEEDED(IAppxManifestReader_GetProperties( manifest, &props )))
+    {
+        IAppxManifestProperties_GetBoolValue( props, L"AllowExternalContent", &allowed );
+        IAppxManifestProperties_Release( props );
+    }
+    if (external)
+    {
+#ifndef SG_MUTANT_SPARSE_ANY
+        if (!allowed)
+        {
+            set_error( error_text, L"The package does not allow external content", rec->full_name );
+            return HRESULT_FROM_WIN32( ERROR_PACKAGE_EXTERNAL_LOCATION_NOT_ALLOWED );
+        }
+#endif
+        attrs = GetFileAttributesW( external );
+        if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY))
+        {
+            set_error( error_text, L"The external location is not a folder", external );
+            return HRESULT_FROM_WIN32( ERROR_PATH_NOT_FOUND );
+        }
+    }
+    oid = rec->publisher && wcsstr( rec->publisher, unsigned_publisher_oid );
+    if (is_unsigned && !oid)
+    {
+        set_error( error_text, L"An unsigned package's publisher must be in the namespace for unsigned packages", rec->publisher );
+        return HRESULT_FROM_WIN32( ERROR_UNSIGNED_PACKAGE_INVALID_PUBLISHER_NAMESPACE );
+    }
+    if (!is_unsigned && oid)
+    {
+        set_error( error_text, L"A signed package's publisher may not be in the namespace for unsigned packages", rec->publisher );
+        return HRESULT_FROM_WIN32( ERROR_SIGNED_PACKAGE_INVALID_PUBLISHER_NAMESPACE );
+    }
+    return S_OK;
+}
