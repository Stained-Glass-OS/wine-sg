+static struct options_factory add_factory = { {&factory_vtbl}, OPTIONS_ADD };
+static struct options_factory stage_factory = { {&factory_vtbl}, OPTIONS_STAGE };
+static struct options_factory register_factory = { {&factory_vtbl}, OPTIONS_REGISTER };
