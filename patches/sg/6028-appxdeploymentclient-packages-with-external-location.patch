+static const struct vector_iids uri_vector_iids =
+{
+    .element = L"Windows.Foundation.Uri",
+    .iterable = &IID_IIterable_Uri,
+    .iterator = &IID_IIterator_Uri,
+    .vector = &IID_IVector_Uri,
+    .view = &IID_IVectorView_Uri,
+};
+
+static const WCHAR *class_name( enum options_kind kind )
+{
+    switch (kind)
+    {
+    case OPTIONS_ADD: return RuntimeClass_Windows_Management_Deployment_AddPackageOptions;
+    case OPTIONS_STAGE: return RuntimeClass_Windows_Management_Deployment_StagePackageOptions;
+    default: return RuntimeClass_Windows_Management_Deployment_RegisterPackageOptions;
+    }
+}
+
+static inline struct package_options *impl_from_IAddPackageOptions( IAddPackageOptions *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_options, IAddPackageOptions_iface );
+}
+
+/* The default interface of each class is the object's identity. */
+static IInspectable *options_default( struct package_options *impl )
+{
+    switch (impl->kind)
+    {
+    case OPTIONS_ADD: return (IInspectable *)&impl->IAddPackageOptions_iface;
+    case OPTIONS_STAGE: return (IInspectable *)&impl->IStagePackageOptions_iface;
+    default: return (IInspectable *)&impl->IRegisterPackageOptions_iface;
+    }
+}
+
+static HRESULT options_query( struct package_options *impl, REFIID iid, void **out )
+{
+    TRACE( "impl %p, iid %s, out %p.\n", impl, debugstr_guid( iid ), out );
+
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = options_default( impl );
+    else if (impl->kind == OPTIONS_ADD && IsEqualGUID( iid, &IID_IAddPackageOptions ))
+        *out = &impl->IAddPackageOptions_iface;
+    else if (impl->kind == OPTIONS_ADD && IsEqualGUID( iid, &IID_IAddPackageOptions2 ))
+        *out = &impl->IAddPackageOptions2_iface;
+    else if (impl->kind == OPTIONS_STAGE && IsEqualGUID( iid, &IID_IStagePackageOptions ))
+        *out = &impl->IStagePackageOptions_iface;
+    else if (impl->kind == OPTIONS_STAGE && IsEqualGUID( iid, &IID_IStagePackageOptions2 ))
+        *out = &impl->IStagePackageOptions2_iface;
+    else if (impl->kind == OPTIONS_REGISTER && IsEqualGUID( iid, &IID_IRegisterPackageOptions ))
+        *out = &impl->IRegisterPackageOptions_iface;
+    else if (impl->kind == OPTIONS_REGISTER && IsEqualGUID( iid, &IID_IRegisterPackageOptions2 ))
+        *out = &impl->IRegisterPackageOptions2_iface;
+    if (!*out)
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG options_addref( struct package_options *impl )
+{
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "impl %p increasing refcount to %lu.\n", impl, ref );
+    return ref;
+}
+
+static ULONG options_release( struct package_options *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "impl %p decreasing refcount to %lu.\n", impl, ref );
+    if (!ref)
+    {
+        if (impl->dependencies) IVector_Uri_Release( impl->dependencies );
+        if (impl->optional_uris) IVector_Uri_Release( impl->optional_uris );
+        if (impl->related_uris) IVector_Uri_Release( impl->related_uris );
+        if (impl->optional_names) IVector_HSTRING_Release( impl->optional_names );
+        if (impl->volume) IPackageVolume_Release( impl->volume );
+        if (impl->external) IUriRuntimeClass_Release( impl->external );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT options_iids( struct package_options *impl, ULONG *iid_count, IID **iids )
+{
+    IID *list;
+
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    switch (impl->kind)
+    {
+    case OPTIONS_ADD: list[0] = IID_IAddPackageOptions; list[1] = IID_IAddPackageOptions2; break;
+    case OPTIONS_STAGE: list[0] = IID_IStagePackageOptions; list[1] = IID_IStagePackageOptions2; break;
+    default: list[0] = IID_IRegisterPackageOptions; list[1] = IID_IRegisterPackageOptions2; break;
+    }
+    *iid_count = 2;
+    *iids = list;
+    return S_OK;
+}
+
+static HRESULT get_uri_vector( IVector_Uri **vector, IVector_Uri **value )
+{
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (!*vector && FAILED(hr = vector_inspectable_create( &uri_vector_iids, (IVector_IInspectable **)vector ))) return hr;
+    IVector_Uri_AddRef( (*value = *vector) );
+    return S_OK;
+}
+
+static HRESULT get_name_vector( IVector_HSTRING **vector, IVector_HSTRING **value )
+{
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (!*vector && FAILED(hr = vector_hstring_create( vector ))) return hr;
+    IVector_HSTRING_AddRef( (*value = *vector) );
+    return S_OK;
+}
+
+static HRESULT get_object( IUnknown *object, void **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = object)) IUnknown_AddRef( object );
+    return S_OK;
+}
+
+static void put_volume( struct package_options *impl, IPackageVolume *value )
+{
+    if (value) IPackageVolume_AddRef( value );
+    if (impl->volume) IPackageVolume_Release( impl->volume );
+    impl->volume = value;
+}
+
+static void put_external( struct package_options *impl, IUriRuntimeClass *value )
+{
+    if (value) IUriRuntimeClass_AddRef( value );
+    if (impl->external) IUriRuntimeClass_Release( impl->external );
+    impl->external = value;
+}
+
+/* The digests a caller expects for the packages (verified as they are read) are not kept apart here:
+ * every package is checked against its own signed block map. */
+static HRESULT get_digests( IMap_Uri_HSTRING **value )
+{
+    FIXME( "value %p: expected digests are not supported\n", value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_NOTIMPL;
+}
