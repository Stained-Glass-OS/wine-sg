+/* ---- a vector of packages ------------------------------------------------------------------ */
+
+static const struct vector_iids package_vector_iids =
+{
+    .element = L"Windows.ApplicationModel.Package",
+    .iterable = &IID_IIterable_Package,
+    .iterator = &IID_IIterator_Package,
+    .vector = &IID_IVector_Package,
+    .view = &IID_IVectorView_Package,
+};
+
+HRESULT package_vector_create( IIterable_Package *packages, IVector_Package **out )
+{
+    IIterator_Package *it;
+    IPackage *package;
+    boolean has = FALSE;
+    HRESULT hr;
+
+    if (FAILED(hr = vector_inspectable_create( &package_vector_iids, (IVector_IInspectable **)out ))) return hr;
+    if (FAILED(hr = IIterable_Package_First( packages, &it ))) goto failed;
+    IIterator_Package_get_HasCurrent( it, &has );
+    while (has && SUCCEEDED(hr))
+    {
+        if (FAILED(hr = IIterator_Package_get_Current( it, &package ))) break;
+        hr = IVector_Package_Append( *out, package );
+        IPackage_Release( package );
+        if (SUCCEEDED(hr)) hr = IIterator_Package_MoveNext( it, &has );
+    }
+    IIterator_Package_Release( it );
+    if (SUCCEEDED(hr)) return S_OK;
+failed:
+    IVector_Package_Release( *out );
+    *out = NULL;
+    return hr;
+}
