+static HRESULT options_create( enum options_kind kind, IInspectable **out )
+{
+    struct package_options *impl;
+
+    if (!out) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        *out = NULL;
+        return E_OUTOFMEMORY;
+    }
+    impl->IAddPackageOptions_iface.lpVtbl = &add_vtbl;
+    impl->IAddPackageOptions2_iface.lpVtbl = &add2_vtbl;
+    impl->IStagePackageOptions_iface.lpVtbl = &stage_vtbl;
+    impl->IStagePackageOptions2_iface.lpVtbl = &stage2_vtbl;
+    impl->IRegisterPackageOptions_iface.lpVtbl = &reg_vtbl;
+    impl->IRegisterPackageOptions2_iface.lpVtbl = &reg2_vtbl;
+    impl->kind = kind;
+    impl->ref = 1;
+    *out = options_default( impl );
+    return S_OK;
+}
