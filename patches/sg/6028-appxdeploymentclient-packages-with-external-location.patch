+/* The list's external location (DEPLOY_EXTERNAL_MARK), if it starts with one: the rest follows it. */
+static const WCHAR *list_external( const WCHAR **list )
+{
+    const WCHAR *external;
+
+    if ((*list)[0] != DEPLOY_EXTERNAL_MARK) return NULL;
+    external = *list + 1;
+    *list += wcslen( *list ) + 1;
+    return external;
+}
