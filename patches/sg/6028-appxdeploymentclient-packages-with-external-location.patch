+#define OPTIONS_BOOL( pfx, iface_type, name, field )                                              \
+    static HRESULT WINAPI pfx##_get_##name( iface_type *iface, boolean *value )                    \
+    {                                                                                              \
+        struct package_options *impl = pfx##_impl( iface );                                        \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        *value = impl->field;                                                                      \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_put_##name( iface_type *iface, boolean value )                     \
+    {                                                                                              \
+        struct package_options *impl = pfx##_impl( iface );                                        \
+        TRACE( "iface %p, value %d.\n", iface, value );                                            \
+        impl->field = !!value;                                                                     \
+        return S_OK;                                                                               \
+    }
+
+#define OPTIONS_IINSPECTABLE( pfx, iface_type, member )                                           \
+    static inline struct package_options *pfx##_impl( iface_type *iface )                          \
+    {                                                                                              \
