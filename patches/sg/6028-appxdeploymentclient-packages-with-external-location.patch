+    {
+        BOOL ours = is_package_volume( volume );
+        IPackageVolume_Release( volume );
+        if (!ours) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+    OPTION_FLAG( IStagePackageOptions_get_ForceUpdateFromAnyVersion, stage_options, DeploymentOptions_ForceUpdateFromAnyVersion );
+    OPTION_FLAG( IStagePackageOptions_get_InstallAllResources, stage_options, DeploymentOptions_InstallAllResources );
+    OPTION_FLAG( IStagePackageOptions_get_RequiredContentGroupOnly, stage_options, DeploymentOptions_RequiredContentGroupOnly );
+    OPTION_FLAG( IStagePackageOptions_get_StageInPlace, stage_options, DeploymentOptions_StageInPlace );
+    OPTION_FLAG( IStagePackageOptions_get_AllowUnsigned, stage_options, DEPLOY_ALLOW_UNSIGNED );
+
+    IStagePackageOptions_get_DependencyPackageUris( stage_options, &vector );
+    dependencies = uris_of( vector );
+    vector = NULL;
+    IStagePackageOptions_get_OptionalPackageUris( stage_options, &vector );
+    optional = uris_of( vector );
+    vector = NULL;
+    IStagePackageOptions_get_RelatedPackageUris( stage_options, &vector );
