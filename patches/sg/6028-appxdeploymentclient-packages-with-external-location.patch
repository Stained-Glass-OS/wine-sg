+static HRESULT WINAPI package_manager9_StagePackageByUriAsync( IPackageManager9 *iface, IUriRuntimeClass *uri,
+    IStagePackageOptions *stage_options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
