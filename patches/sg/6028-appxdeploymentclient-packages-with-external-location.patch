+static BOOL query_provisioned( struct package_record *rec, void *context )
+{
+    struct query *q = context;
+    IPackage *package, **grown;
+
+    if (!rec->provisioned) return TRUE;
+    if (FAILED(package_create( rec, &package ))) return TRUE;
+    if ((grown = realloc( q->packages, (q->count + 1) * sizeof(*grown) )))
+    {
+        q->packages = grown;
+        q->packages[q->count++] = package;
+    }
+    else IPackage_Release( package );
+    return TRUE;
+}
+
+HRESULT provisioned_packages( IIterable_Package **out )
+{
+    struct query q = { 0 };
+    UINT32 i;
+    HRESULT hr;
+
+    for_each_record( query_provisioned, &q );
+    if (FAILED(hr = package_list_create( q.packages, q.count, out )))
+    {
+        for (i = 0; i < q.count; i++) IPackage_Release( q.packages[i] );
+        free( q.packages );
+    }
+    return hr;
+}
