+/* Deprovision: the family is no longer registered for new users; who has it keeps it. An
+ * administrator's call. */
+HRESULT deprovision_package_work( const WCHAR *family_name, DeploymentOptions options, WCHAR **error_text )
+{
+    struct family_names f = { family_name };
+    BOOL found = FALSE;
+    const WCHAR *p;
+
+    TRACE( "family %s\n", debugstr_w( family_name ) );
+
+    if (!family_name[0] || wcschr( family_name, '\\' ))
+    {
+        set_error( error_text, L"Not a package family name", family_name );
+        return E_INVALIDARG;
+    }
+    if (!caller_is_admin())
+    {
+        set_error( error_text, L"Deprovisioning needs an administrator", NULL );
+        return E_ACCESSDENIED;
+    }
+    for_each_record( collect_family, &f );
+    for (p = f.names.data; p && *p; p += wcslen( p ) + 1)
+    {
+        WCHAR path[MAX_PATH];
+        DWORD value = 0, size = sizeof(value);
+        HKEY key;
+
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, p );
+        if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, &key )) continue;
+        if (!RegGetValueW( key, NULL, L"Provisioned", RRF_RT_REG_DWORD, NULL, &value, &size ) && value)
+        {
+            found = TRUE;
+#ifndef SG_MUTANT_PM8_KEEP
+            value = 0;
+            RegSetValueExW( key, L"Provisioned", 0, REG_DWORD, (const BYTE *)&value, sizeof(value) );
+#endif
+        }
+        RegCloseKey( key );
+    }
+    free( f.names.data );
+    if (!found)
+    {
+        set_error( error_text, L"The package family is not provisioned", family_name );
+        return 0x80073cf1; /* ERROR_INSTALL_PACKAGE_NOT_FOUND */
+    }
+    return S_OK;
+}
