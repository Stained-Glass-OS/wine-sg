+static HRESULT install_package_external( IAppxPackageReader *reader, DeploymentOptions options, const WCHAR *external,
+                                         BOOL is_unsigned, WCHAR **error_text )
+{
+    return install_package_ex( reader, options, FALSE, NULL, external, is_unsigned, NULL, error_text );
