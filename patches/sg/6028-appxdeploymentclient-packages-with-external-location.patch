+static HRESULT WINAPI package_manager9_RegisterPackageByUriAsync( IPackageManager9 *iface, IUriRuntimeClass *uri,
+    IRegisterPackageOptions *register_options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    IUriRuntimeClass *external = NULL;
+    DeploymentOptions options = 0;
+    WCHAR path[MAX_PATH], *list = NULL;
+    size_t used = 0;
+    HRESULT hr;
+
+    TRACE( "iface %p, uri %p, options %p, operation %p.\n", iface, uri, register_options, operation );
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!uri || !register_options) return E_INVALIDARG;
+    /* a manifest of this machine, registered where it is */
+    if (FAILED(hr = uri_to_path( uri, path, ARRAY_SIZE(path) ))) return hr;
+    OPTION_FLAG( IRegisterPackageOptions_get_DeveloperMode, register_options, DeploymentOptions_DevelopmentMode );
+    OPTION_FLAG( IRegisterPackageOptions_get_ForceAppShutdown, register_options, DeploymentOptions_ForceApplicationShutdown );
+    OPTION_FLAG( IRegisterPackageOptions_get_ForceTargetAppShutdown, register_options, DeploymentOptions_ForceTargetApplicationShutdown );
+    OPTION_FLAG( IRegisterPackageOptions_get_ForceUpdateFromAnyVersion, register_options, DeploymentOptions_ForceUpdateFromAnyVersion );
+    OPTION_FLAG( IRegisterPackageOptions_get_InstallAllResources, register_options, DeploymentOptions_InstallAllResources );
+    OPTION_FLAG( IRegisterPackageOptions_get_AllowUnsigned, register_options, DEPLOY_ALLOW_UNSIGNED );
+    IRegisterPackageOptions_get_ExternalLocationUri( register_options, &external );
+    if (SUCCEEDED(hr = append_external( &list, &used, external )) && SUCCEEDED(hr = append_arg( &list, &used, path )))
+        hr = deploy_operation_create( register_package_work, list, options, operation );
+    if (external) IUriRuntimeClass_Release( external );
+    free( list );
+    return hr;
+}
