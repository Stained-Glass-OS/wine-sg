+static HRESULT WINAPI package_manager9_RegisterPackagesByFullNameAsync( IPackageManager9 *iface, IIterable_HSTRING *full_names,
+    IRegisterPackageOptions *register_options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    IIterator_HSTRING *it = NULL;
+    DeploymentOptions options = 0;
+    WCHAR *list = NULL;
+    boolean has = FALSE;
+    size_t used = 0;
+    HRESULT hr;
+    int count = 0;
+
+    TRACE( "iface %p, full_names %p, options %p, operation %p.\n", iface, full_names, register_options, operation );
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!full_names || !register_options) return E_INVALIDARG;
+    OPTION_FLAG( IRegisterPackageOptions_get_ForceAppShutdown, register_options, DeploymentOptions_ForceApplicationShutdown );
+    OPTION_FLAG( IRegisterPackageOptions_get_ForceTargetAppShutdown, register_options, DeploymentOptions_ForceTargetApplicationShutdown );
+    /* the first package is registered with the others it names (register_staged_work) */
+    if (FAILED(hr = IIterable_HSTRING_First( full_names, &it ))) return hr;
+    IIterator_HSTRING_get_HasCurrent( it, &has );
+    while (has && count++ < 64)
+    {
+        HSTRING name;
+
+        if (FAILED(hr = IIterator_HSTRING_get_Current( it, &name ))) break;
+        hr = append_arg( &list, &used, WindowsGetStringRawBuffer( name, NULL ) );
+        WindowsDeleteString( name );
+        if (FAILED(hr)) break;
+        IIterator_HSTRING_MoveNext( it, &has );
+    }
+    IIterator_HSTRING_Release( it );
+    if (SUCCEEDED(hr) && !list) hr = E_INVALIDARG;
+    if (SUCCEEDED(hr)) hr = deploy_operation_create( register_staged_work, list, options, operation );
+    free( list );
+    return hr;
+}
