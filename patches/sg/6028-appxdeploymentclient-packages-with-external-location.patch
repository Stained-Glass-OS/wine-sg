+/* What a vector of URIs has, as an iterable (NULL when it is empty). */
+static IIterable_Uri *uris_of( IVector_Uri *vector )
+{
+    IIterable_Uri *iterable = NULL;
+    UINT32 size = 0;
+
+    if (!vector) return NULL;
+    if (SUCCEEDED(IVector_Uri_get_Size( vector, &size )) && size)
+        IVector_Uri_QueryInterface( vector, &IID_IIterable_Uri, (void **)&iterable );
+    IVector_Uri_Release( vector );
+    return iterable;
+}
