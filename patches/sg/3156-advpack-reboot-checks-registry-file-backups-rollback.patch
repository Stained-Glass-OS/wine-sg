 {
-    FIXME("(%p, %s, %s, %s, %s, %s, %ld): stub\n", hWnd, debugstr_w(pszTitle),
+    static const WCHAR *const keys[] = { L"CopyFiles", L"DelFiles", L"RenFiles" };
+    const WCHAR *section = pszSection;
+    SIZE_T cap = 4096, used = 0;
+    WCHAR *list, name[MAX_PATH];
+    HRESULT hr;
+    INFCONTEXT ctx;
+    HINF hinf;
+    DWORD i, size;
+
+    TRACE("(%p, %s, %s, %s, %s, %s, %ld)\n", hWnd, debugstr_w(pszTitle),
           debugstr_w(pszINF), debugstr_w(pszSection), debugstr_w(pszBackupDir),
           debugstr_w(pszBaseBackupFile), dwFlags);
 
-    return E_FAIL;
+    if (!pszINF || !pszBackupDir || !pszBaseBackupFile) return E_INVALIDARG;
+    hinf = SetupOpenInfFileW(pszINF, NULL, INF_STYLE_WIN4, NULL);
+    if (hinf == INVALID_HANDLE_VALUE) return E_FAIL;
+
+    if (!section || !*section)
+    {
+        section = L"DefaultInstall.NT";
+        if (!SetupFindFirstLineW(hinf, section, NULL, &ctx)) section = L"DefaultInstall";
+    }
+    set_ldids(hinf, section, NULL);
+
+    if (!(list = malloc(cap * sizeof(WCHAR)))) { SetupCloseInfFile(hinf); return E_OUTOFMEMORY; }
+    list[0] = 0;
+
+    for (i = 0; i < ARRAY_SIZE(keys); i++)
+    {
+        BOOL ok = SetupFindFirstLineW(hinf, section, keys[i], &ctx);
+
+        for (; ok; ok = SetupFindNextMatchLineW(&ctx, keys[i], &ctx))
+        {
+            DWORD f, count = SetupGetFieldCount(&ctx);
+
+            for (f = 1; f <= count; f++)
+            {
+                WCHAR dir[MAX_PATH], file[MAX_PATH], path[MAX_PATH * 2];
+                INFCONTEXT line;
+                BOOL more, single;
+                const WCHAR *secname;
+
+                if (!SetupGetStringFieldW(&ctx, f, name, ARRAY_SIZE(name), &size)) continue;
+                single = name[0] == '@';
+                secname = single ? section : name;
+                if (!SetupGetTargetPathW(hinf, NULL, secname, dir, ARRAY_SIZE(dir), &size)) continue;
+
+                more = single ? TRUE : SetupFindFirstLineW(hinf, name, NULL, &line);
+                for (; more; more = single ? FALSE : SetupFindNextLine(&line, &line))
+                {
+                    if (single) lstrcpyW(file, name + 1);
+                    else if (!SetupGetStringFieldW(&line, 1, file, ARRAY_SIZE(file), &size)) continue;
+                    lstrcpyW(path, dir);
+                    lstrcatW(path, L"\\");
+                    lstrcatW(path, file);
+                    size = lstrlenW(path) + 1;
+                    if (used + size + 2 > cap)
+                    {
+                        WCHAR *tmp;
+                        cap = (used + size + 2) * 2;
+                        if (!(tmp = realloc(list, cap * sizeof(WCHAR)))) { free(list); SetupCloseInfFile(hinf); return E_OUTOFMEMORY; }
+                        list = tmp;
+                    }
+                    memcpy(list + used, path, size * sizeof(WCHAR));
+                    used += size;
+                    list[used] = 0;
+                }
+            }
+        }
+    }
+    SetupCloseInfFile(hinf);
+
+    hr = FileSaveRestoreW(hWnd, (dwFlags & AFSR_RESTORE) && !used ? NULL : list,
+                          (WCHAR *)pszBackupDir, (WCHAR *)pszBaseBackupFile, dwFlags);
+    free(list);
+    return hr;
 }
 
