+/* The backup: Base.ini lists, under [backup], each saved file with the number
+ * of its copy in the Base.dat directory ("-1" when it did not exist, which a
+ * restore answers by deleting the file again). */
+static void backup_paths(const WCHAR *dir, const WCHAR *base, WCHAR *ini, WCHAR *dat)
+{
+    lstrcpyW(ini, dir);
+    lstrcatW(ini, L"\\");
+    lstrcatW(ini, base);
+    lstrcpyW(dat, ini);
+    lstrcatW(ini, L".ini");
+    lstrcatW(dat, L".dat");
+}
+
 HRESULT WINAPI FileSaveRestoreW(HWND hDlg, LPWSTR pszFileList, LPWSTR pszDir,
                                 LPWSTR pszBaseName, DWORD dwFlags)
 {
-    FIXME("(%p, %s, %s, %s, %ld) stub\n", hDlg, debugstr_w(pszFileList),
+    WCHAR ini[MAX_PATH], dat[MAX_PATH], copy[MAX_PATH], entry[128], *all = NULL, *names;
+    HRESULT hr = S_OK;
+    DWORD attrs;
+
+    TRACE("(%p, %s, %s, %s, %ld)\n", hDlg, debugstr_w(pszFileList),
           debugstr_w(pszDir), debugstr_w(pszBaseName), dwFlags);
 
-    return E_FAIL;
+    if (!pszDir || !pszBaseName) return E_INVALIDARG;
+    backup_paths(pszDir, pszBaseName, ini, dat);
+
+    if (dwFlags & AFSR_RESTORE)
+    {
+        names = pszFileList;
+        if (!names)
+        {
+            /* everything the backup holds */
+            DWORD size = 4096, got;
+            for (;;)
+            {
+                all = realloc(all, size * sizeof(WCHAR));
+                if (!all) return E_OUTOFMEMORY;
+                got = GetPrivateProfileStringW(L"backup", NULL, L"", all, size, ini);
+                if (got + 2 < size) break;
+                size *= 2;
+            }
+            names = all;
+        }
+        for (; *names; names += lstrlenW(names) + 1)
+        {
+            int idx;
+
+            GetPrivateProfileStringW(L"backup", names, L"", entry, ARRAY_SIZE(entry), ini);
+            if (!entry[0]) continue;
+            idx = wcstol(entry, NULL, 10);
+            if (idx >= 0)
+            {
+                swprintf(copy, ARRAY_SIZE(copy), L"%ls\\%d", dat, idx);
+                attrs = wcstoul(wcschr(entry, ',') ? wcschr(entry, ',') + 1 : L"0", NULL, 10);
+                SetFileAttributesW(names, FILE_ATTRIBUTE_NORMAL);
+                if (!CopyFileW(copy, names, FALSE)) { hr = E_FAIL; continue; }
+                if (attrs) SetFileAttributesW(names, attrs);
+            }
+#ifdef SG_MUTANT_ADV_NODELNEW
+            else if (0)
+#else
+            else if (!(dwFlags & AFSR_NODELETENEW))
+#endif
+            {
+                SetFileAttributesW(names, FILE_ATTRIBUTE_NORMAL);
+                DeleteFileW(names);
+            }
+        }
+        free(all);
+        return hr;
+    }
+
+    if (!pszFileList) return S_OK;
+    CreateDirectoryW(pszDir, NULL);
+    CreateDirectoryW(dat, NULL);
+    SetFileAttributesW(ini, FILE_ATTRIBUTE_NORMAL);
+    for (names = pszFileList; *names; names += lstrlenW(names) + 1)
+    {
+        WCHAR *values = NULL;
+        DWORD size = 4096, got, next = 0;
+
+        /* a file saved before keeps its first state */
+        GetPrivateProfileStringW(L"backup", names, L"", entry, ARRAY_SIZE(entry), ini);
+        if (entry[0]) continue;
+
+        /* the number of the next copy */
+        for (;;)
+        {
+            values = realloc(values, size * sizeof(WCHAR));
+            if (!values) { hr = E_OUTOFMEMORY; break; }
+            got = GetPrivateProfileStringW(L"backup", NULL, L"", values, size, ini);
+            if (got + 2 < size) break;
+            size *= 2;
+        }
+        if (values)
+        {
+            WCHAR *key;
+            for (key = values; *key; key += lstrlenW(key) + 1)
+            {
+                int n;
+                GetPrivateProfileStringW(L"backup", key, L"", entry, ARRAY_SIZE(entry), ini);
+                n = wcstol(entry, NULL, 10);
+                if (n >= (int)next) next = n + 1;
+            }
+            free(values);
+        }
+
+        attrs = GetFileAttributesW(names);
+        if (attrs == INVALID_FILE_ATTRIBUTES)
+            lstrcpyW(entry, L"-1,0,0,0,0,0,-1");
+        else
+        {
+            swprintf(copy, ARRAY_SIZE(copy), L"%ls\\%lu", dat, next);
+            if (!CopyFileW(names, copy, FALSE)) { hr = E_FAIL; continue; }
+            swprintf(entry, ARRAY_SIZE(entry), L"%lu,%lu,0,0,0,0,%lu", next, attrs, next);
+        }
+        WritePrivateProfileStringW(L"backup", names, entry, ini);
+    }
+    SetFileAttributesW(ini, FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN);
+    return hr;
 }
 
