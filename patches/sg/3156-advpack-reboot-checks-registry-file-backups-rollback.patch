+    DWORD i, size;
 
-    return E_FAIL;
+    TRACE("(%p, %s, %s, %ld)\n", hWnd, debugstr_w(pszINF), debugstr_w(pszSec), dwReserved);
+
+    if (!pszINF) return E_INVALIDARG;
+
+    hinf = SetupOpenInfFileW(pszINF, NULL, INF_STYLE_WIN4, NULL);
+    if (hinf == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+
+    if (!section || !*section)
+    {
+        section = L"DefaultInstall.NT";
+        if (!SetupFindFirstLineW(hinf, section, NULL, &ctx)) section = L"DefaultInstall";
+    }
+    set_ldids(hinf, section, NULL);
+
+    for (i = 0; i < ARRAY_SIZE(keys) && hr == S_FALSE; i++)
+    {
+        BOOL ok = SetupFindFirstLineW(hinf, section, keys[i], &ctx);
+
+        for (; ok && hr == S_FALSE; ok = SetupFindNextMatchLineW(&ctx, keys[i], &ctx))
+        {
+            DWORD f, count = SetupGetFieldCount(&ctx);
+
+            for (f = 1; f <= count && hr == S_FALSE; f++)
+            {
+                if (!SetupGetStringFieldW(&ctx, f, secbuf, ARRAY_SIZE(secbuf), &size)) continue;
+                if (secbuf[0] == '@')
+                {
+                    WCHAR dir[MAX_PATH], path[MAX_PATH * 2];
+
+                    if (!SetupGetTargetPathW(hinf, NULL, section, dir, ARRAY_SIZE(dir), &size)) continue;
+                    lstrcpyW(path, dir);
+                    lstrcatW(path, L"\\");
+                    lstrcatW(path, secbuf + 1);
+                    if (file_in_use(path)) hr = S_OK;
+                }
+                else if (section_files_in_use(hinf, secbuf)) hr = S_OK;
+            }
+        }
+    }
+
+    SetupCloseInfFile(hinf);
+    return hr;
 }
 
