@@ -273,10 +273,25 @@ BOOL WINAPI IsNTAdmin(DWORD reserved, LPDWORD pReserved)
  * RETURNS
  *   Value required by NeedReboot.
  */
+/* the size of the pending file operations, plus one so that it is never 0 */
+static DWORD pending_operations_state(void)
+{
+    DWORD size = 0;
+    HKEY key;
+
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Session Manager",
+                       0, KEY_QUERY_VALUE, &key))
+    {
+        if (RegQueryValueExW(key, L"PendingFileRenameOperations", NULL, NULL, NULL, &size)) size = 0;
+        RegCloseKey(key);
+    }
+    return size + 1;
+}
+
 DWORD WINAPI NeedRebootInit(VOID)
 {
-    FIXME("(VOID): stub\n");
-    return 0;
+    TRACE("()\n");
+    return pending_operations_state();
 }
 
 /***********************************************************************
@@ -295,8 +310,9 @@ DWORD WINAPI NeedRebootInit(VOID)
  */
 BOOL WINAPI NeedReboot(DWORD dwRebootCheck)
 {
-    FIXME("(%ld): stub\n", dwRebootCheck);
-    return FALSE;
+    TRACE("(%ld)\n", dwRebootCheck);
+    /* a reboot is needed when files were queued for replacement since NeedRebootInit */
+    return pending_operations_state() != dwRebootCheck;
 }
 
