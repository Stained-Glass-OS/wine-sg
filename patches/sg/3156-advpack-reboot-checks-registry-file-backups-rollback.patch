+/* The backup key holds one value per saved registry value: the name is
+ * "root|subkey|value" and the data is a DWORD (1 when the value existed),
+ * the DWORD type and the data. */
+static HKEY root_from_name(const WCHAR *name)
+{
+    if (!name) return NULL;
+    if (!lstrcmpiW(name, L"HKLM") || !lstrcmpiW(name, L"HKEY_LOCAL_MACHINE")) return HKEY_LOCAL_MACHINE;
+    if (!lstrcmpiW(name, L"HKCU") || !lstrcmpiW(name, L"HKEY_CURRENT_USER")) return HKEY_CURRENT_USER;
+    if (!lstrcmpiW(name, L"HKCR") || !lstrcmpiW(name, L"HKEY_CLASSES_ROOT")) return HKEY_CLASSES_ROOT;
+    if (!lstrcmpiW(name, L"HKU") || !lstrcmpiW(name, L"HKEY_USERS")) return HKEY_USERS;
+    return NULL;
+}
+
+static WCHAR *backup_item_name(const WCHAR *root, const WCHAR *subkey, const WCHAR *value)
+{
+    SIZE_T len = lstrlenW(root) + lstrlenW(subkey) + (value ? lstrlenW(value) : 0) + 3;
+    WCHAR *name = malloc(len * sizeof(WCHAR));
+
+    if (name)
+    {
+        lstrcpyW(name, root);
+        lstrcatW(name, L"|");
+        lstrcatW(name, subkey);
+        lstrcatW(name, L"|");
+        if (value) lstrcatW(name, value);
+    }
+    return name;
+}
+
+static HRESULT save_value(HKEY backup, HKEY root, const WCHAR *rootname, const WCHAR *subkey, const WCHAR *value)
+{
+    DWORD type = 0, size = 0, existed = 0, total;
+    BYTE *blob = NULL;
+    WCHAR *name;
+    HKEY key;
+    LONG ret;
+
+    ret = RegOpenKeyExW(root, subkey, 0, KEY_QUERY_VALUE, &key);
+    if (!ret)
+    {
+        ret = RegQueryValueExW(key, value, NULL, &type, NULL, &size);
+        if (!ret)
+        {
+            existed = 1;
+            blob = malloc(2 * sizeof(DWORD) + size);
+            if (!blob) { RegCloseKey(key); return E_OUTOFMEMORY; }
+            ret = RegQueryValueExW(key, value, NULL, &type, blob + 2 * sizeof(DWORD), &size);
+            if (ret) existed = 0;
+        }
+        RegCloseKey(key);
+    }
+    if (!blob)
+    {
+        blob = malloc(2 * sizeof(DWORD));
+        if (!blob) return E_OUTOFMEMORY;
+        size = 0;
+    }
+    ((DWORD *)blob)[0] = existed;
+    ((DWORD *)blob)[1] = existed ? type : 0;
+    total = 2 * sizeof(DWORD) + (existed ? size : 0);
+
+    if (!(name = backup_item_name(rootname, subkey, value))) { free(blob); return E_OUTOFMEMORY; }
+    /* a value saved before keeps its first state: that is what a restore returns to */
+    if (RegQueryValueExW(backup, name, NULL, NULL, NULL, NULL))
+        ret = RegSetValueExW(backup, name, 0, REG_BINARY, blob, total);
+    else
+        ret = ERROR_SUCCESS;
+    free(name);
+    free(blob);
+    return ret ? E_FAIL : S_OK;
+}
+
+static HRESULT restore_item(HKEY backup, const WCHAR *item, BYTE *blob, DWORD size)
+{
+    WCHAR *copy = wcsdup(item), *subkey, *value;
+    HKEY root, key;
+    HRESULT hr = S_OK;
+
+    if (!copy || size < 2 * sizeof(DWORD)) { free(copy); return E_FAIL; }
+    subkey = wcschr(copy, '|');
+    value = subkey ? wcschr(subkey + 1, '|') : NULL;
+    if (!value) { free(copy); return E_FAIL; }
+    *subkey++ = 0;
+    *value++ = 0;
+    if (!(root = root_from_name(copy))) { free(copy); return E_FAIL; }
+
+    if (((DWORD *)blob)[0])
+    {
+        if (RegCreateKeyExW(root, subkey, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL)) hr = E_FAIL;
+        else
+        {
