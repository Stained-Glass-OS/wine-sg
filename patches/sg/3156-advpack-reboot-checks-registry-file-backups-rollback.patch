+/* TRUE when the file exists and another process holds it open */
+static BOOL file_in_use(const WCHAR *path)
+{
+    HANDLE h = CreateFileW(path, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+#ifdef SG_MUTANT_ADV_NOLOCK
+    if (1) return FALSE;
+#endif
+
+    if (h == INVALID_HANDLE_VALUE) return GetLastError() == ERROR_SHARING_VIOLATION;
+    CloseHandle(h);
+    return FALSE;
+}
+
+/* checks the files named in the lines of a file section (or one @file) */
+static BOOL section_files_in_use(HINF hinf, const WCHAR *name)
+{
+    WCHAR dir[MAX_PATH], path[MAX_PATH * 2];
+    INFCONTEXT ctx;
+    DWORD size;
+
+    if (!SetupGetTargetPathW(hinf, NULL, name, dir, ARRAY_SIZE(dir), &size)) return FALSE;
+    if (!SetupFindFirstLineW(hinf, name, NULL, &ctx)) return FALSE;
+    do
+    {
+        WCHAR file[MAX_PATH];
+
+        if (!SetupGetStringFieldW(&ctx, 1, file, ARRAY_SIZE(file), &size)) continue;
+        lstrcpyW(path, dir);
+        lstrcatW(path, L"\\");
+        lstrcatW(path, file);
+        if (file_in_use(path)) return TRUE;
+    } while (SetupFindNextLine(&ctx, &ctx));
+    return FALSE;
+}
+
