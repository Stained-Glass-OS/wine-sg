+/************************************************************
+ *                NetUserGetLocalGroups  (NETAPI32.@)
+ */
+NET_API_STATUS WINAPI
+NetUserGetLocalGroups(LPCWSTR servername, LPCWSTR username, DWORD level,
+                      DWORD flags, LPBYTE* bufptr, DWORD prefmaxlen,
+                      LPDWORD entriesread, LPDWORD totalentries)
+{
+    NET_API_STATUS status;
+    const WCHAR *names[ARRAY_SIZE(local_groups)];
+    UINT count = 0, i, j;
+    SIZE_T size = 0;
+    BYTE *buf, *ptr;
+
+    TRACE("(%s, %s, %ld, %08lx, %p %ld, %p, %p)\n", debugstr_w(servername), debugstr_w(username), level, flags,
+          bufptr, prefmaxlen, entriesread, totalentries);
+
+    if ((status = NETAPI_ValidateServername( servername ))) return status;
+    if (!NETAPI_IsLocalComputer( servername )) return ERROR_BAD_NETPATH;
+    if (level != 0) return ERROR_INVALID_LEVEL;
+    if (!username || !bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (!account_exists( username )) return NERR_UserNotFound;
+
+    for (i = 0; i < ARRAY_SIZE(local_groups); i++)
+    {
+        WCHAR **members;
+        UINT n = get_group_members( i, &members );
+        BOOL member = FALSE;
+
+        for (j = 0; j < n; j++)
+        {
+            if (!wcsicmp( members[j], username )) member = TRUE;
+            free( members[j] );
+        }
+        free( members );
+        if (!member) continue;
+        names[count++] = local_groups[i].name;
+        size += sizeof(LOCALGROUP_USERS_INFO_0) + (wcslen( local_groups[i].name ) + 1) * sizeof(WCHAR);
+    }
+    *entriesread = *totalentries = count;
+    *bufptr = NULL;
+    if (prefmaxlen != MAX_PREFERRED_LENGTH && prefmaxlen < size)
+    {
+        *entriesread = 0;
+        return ERROR_MORE_DATA;
+    }
+    if ((status = NetApiBufferAllocate( size ? size : 1, (void **)&buf )))
+    {
+        *entriesread = *totalentries = 0;
+        return status;
+    }
+    ptr = buf + count * sizeof(LOCALGROUP_USERS_INFO_0);
+    for (i = 0; i < count; i++)
+    {
+        WCHAR *name = (WCHAR *)ptr;
+
+        wcscpy( name, names[i] );
+        ptr += (wcslen( name ) + 1) * sizeof(WCHAR);
+        ((LOCALGROUP_USERS_INFO_0 *)buf)[i].lgrui0_name = name;
+    }
+    *bufptr = buf;
+    return NERR_Success;
+}
+
+/************************************************************
+ *                NetUserGetGroups (NETAPI32.@)
+ *
+ * A computer has no global groups of its own: every account belongs to the one group named "None".
+ */
+NET_API_STATUS NET_API_FUNCTION NetUserGetGroups(
+        LPCWSTR servername,
+        LPCWSTR username,
+        DWORD level,
+        LPBYTE *bufptr,
+        DWORD prefixmaxlen,
+        LPDWORD entriesread,
+        LPDWORD totalentries)
+{
+    static const WCHAR noneW[] = L"None";
+    NET_API_STATUS status;
+    SIZE_T size;
+    BYTE *buf;
+
+    TRACE("%s %s %ld %p %ld %p %p\n", debugstr_w(servername), debugstr_w(username), level, bufptr, prefixmaxlen,
+          entriesread, totalentries);
+
+    if ((status = NETAPI_ValidateServername( servername ))) return status;
+    if (!NETAPI_IsLocalComputer( servername )) return ERROR_BAD_NETPATH;
+    if (level != 0 && level != 1) return ERROR_INVALID_LEVEL;
+    if (!username || !bufptr || !entriesread || !totalentries) return ERROR_INVALID_PARAMETER;
+    if (!account_exists( username )) return NERR_UserNotFound;
+
+    size = (level == 0 ? sizeof(SG_GROUP_USERS_INFO_0) : sizeof(SG_GROUP_USERS_INFO_1)) + sizeof(noneW);
+    *bufptr = NULL;
+    *entriesread = 0;
+    *totalentries = 1;
+    if (prefixmaxlen != MAX_PREFERRED_LENGTH && prefixmaxlen < size) return ERROR_MORE_DATA;
+    if ((status = NetApiBufferAllocate( size, (void **)&buf ))) return status;
+    if (level == 0)
+    {
+        ((SG_GROUP_USERS_INFO_0 *)buf)->grui0_name = (WCHAR *)(buf + sizeof(SG_GROUP_USERS_INFO_0));
+        wcscpy( ((SG_GROUP_USERS_INFO_0 *)buf)->grui0_name, noneW );
+    }
+    else
+    {
+        ((SG_GROUP_USERS_INFO_1 *)buf)->grui1_name = (WCHAR *)(buf + sizeof(SG_GROUP_USERS_INFO_1));
+        wcscpy( ((SG_GROUP_USERS_INFO_1 *)buf)->grui1_name, noneW );
+        ((SG_GROUP_USERS_INFO_1 *)buf)->grui1_attributes = SE_GROUP_MANDATORY | SE_GROUP_ENABLED_BY_DEFAULT | SE_GROUP_ENABLED;
+    }
+    *bufptr = buf;
+    *entriesread = 1;
+    return NERR_Success;
+}
+
