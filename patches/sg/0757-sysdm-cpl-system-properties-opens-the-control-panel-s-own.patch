+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "cpl.h"
+#include "shellapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(sysdm);
+
+/* control.exe with ARGS, waiting for it as the caller would for a dialog */
+static void run_control( const WCHAR *args )
+{
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+
+    sei.fMask = SEE_MASK_NOCLOSEPROCESS;
+    sei.lpFile = L"control.exe";
+    sei.lpParameters = args;
+    sei.nShow = SW_SHOWNORMAL;
+#ifdef SG_MUTANT_SYSDM_NOTHING
+    return;
+#endif
+    if (!ShellExecuteExW( &sei ))
+    {
+        WARN( "could not run control.exe %s: %lu\n", debugstr_w(args), GetLastError() );
+        return;
+    }
+    if (sei.hProcess)
+    {
+        WaitForSingleObject( sei.hProcess, INFINITE );
+        CloseHandle( sei.hProcess );
+    }
+}
+
+void WINAPI EditEnvironmentVariablesW( HWND hwnd, HINSTANCE inst, const WCHAR *cmdline, int show )
+{
+    TRACE( "%p %p %s %d\n", hwnd, inst, debugstr_w(cmdline), show );
+    run_control( L"EditEnvironmentVariables" );
+}
+
+LONG CALLBACK CPlApplet( HWND hwnd, UINT msg, LPARAM lparam1, LPARAM lparam2 )
+{
+    switch (msg)
+    {
+    case CPL_INIT:
+        return TRUE;
+    case CPL_GETCOUNT:
+        return 1;
+    case CPL_NEWINQUIRE:
+    {
+        NEWCPLINFOW *info = (NEWCPLINFOW *)lparam2;
+        memset( info, 0, sizeof(*info) );
+        info->dwSize = sizeof(*info);
+        info->hIcon = LoadIconW( NULL, (const WCHAR *)IDI_APPLICATION );
+        lstrcpyW( info->szName, L"System" );
+        lstrcpyW( info->szInfo, L"See your computer's name and its system properties" );
+        return 0;
+    }
+    case CPL_DBLCLK:
+        /* the Control Panel's System page */
+        run_control( L"/name Microsoft.System" );
+        return 0;
+    }
+    return 0;
+}
--- /dev/null
+++ b/dlls/sysdm.cpl/sysdm.cpl.spec
@@ -0,0 +1,3 @@
+@ stdcall CPlApplet(long long long long)
+@ stdcall EditEnvironmentVariables(long long wstr long) EditEnvironmentVariablesW
+@ stdcall EditEnvironmentVariablesW(long long wstr long)
