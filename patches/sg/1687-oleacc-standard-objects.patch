+/* Stained Glass OS 1687: buttons: push buttons, check boxes, radio
+ * buttons and group boxes, by their style */
+static void button_init(Client *client)
+{
+    switch(GetWindowLongW(client->hwnd, GWL_STYLE) & BS_TYPEMASK) {
+    case BS_CHECKBOX:
+    case BS_AUTOCHECKBOX:
+    case BS_3STATE:
+    case BS_AUTO3STATE:
+        client->role = ROLE_SYSTEM_CHECKBUTTON;
+        break;
+    case BS_RADIOBUTTON:
+    case BS_AUTORADIOBUTTON:
+        client->role = ROLE_SYSTEM_RADIOBUTTON;
+        break;
+    case BS_GROUPBOX:
+        client->role = ROLE_SYSTEM_GROUPING;
+        break;
+    default:
+        client->role = ROLE_SYSTEM_PUSHBUTTON;
+        break;
+    }
+}
+
+static HRESULT button_get_state(Client *client, VARIANT id, VARIANT *state)
+{
+    LONG style = GetWindowLongW(client->hwnd, GWL_STYLE), type = style & BS_TYPEMASK;
+    LRESULT bst;
+    HRESULT hres;
+
+    hres = client_get_state(client, id, state);
+    if(FAILED(hres))
+        return hres;
+
+    bst = SendMessageW(client->hwnd, BM_GETSTATE, 0, 0);
+    if(client->role == ROLE_SYSTEM_GROUPING)
+        V_I4(state) &= ~STATE_SYSTEM_FOCUSABLE;
+    if(bst & BST_PUSHED)
+        V_I4(state) |= STATE_SYSTEM_PRESSED;
+    if(bst & BST_FOCUS)
+        V_I4(state) |= STATE_SYSTEM_FOCUSED;
+    if((bst & 3) == BST_CHECKED)
+        V_I4(state) |= STATE_SYSTEM_CHECKED;
+    else if((bst & 3) == BST_INDETERMINATE)
+        V_I4(state) |= STATE_SYSTEM_MIXED;
+    if(type == BS_DEFPUSHBUTTON)
+        V_I4(state) |= STATE_SYSTEM_DEFAULT;
+    return S_OK;
+}
+
+static HRESULT button_get_default_action(Client *client, VARIANT id, BSTR *action)
+{
+    const WCHAR *str;
+
+    if(convert_child_id(&id) != CHILDID_SELF)
+        return E_INVALIDARG;
+    switch(client->role) {
+    case ROLE_SYSTEM_CHECKBUTTON:
+        str = (SendMessageW(client->hwnd, BM_GETCHECK, 0, 0) == BST_CHECKED) ? L"Uncheck" : L"Check";
+        break;
+    case ROLE_SYSTEM_RADIOBUTTON:
+        str = L"Check";
+        break;
+    case ROLE_SYSTEM_GROUPING:
+        return S_FALSE;
+    default:
+        str = L"Press";
+        break;
+    }
+    *action = SysAllocString(str);
+    return *action ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT button_do_default_action(Client *client, VARIANT id)
+{
+    if(convert_child_id(&id) != CHILDID_SELF)
+        return E_INVALIDARG;
+    if(client->role == ROLE_SYSTEM_GROUPING)
+        return DISP_E_MEMBERNOTFOUND;
+#ifdef SG_MUTANT_NO_BUTTON_ACTION
+    return S_OK;
+#endif
+    /* as a click would: posted, so the caller is not held by what it does */
+    PostMessageW(client->hwnd, BM_CLICK, 0, 0);
+    return S_OK;
+}
+
+static const win_class_vtbl button_vtbl = {
+    button_init,
+    button_get_state,
+    NULL,
+    NULL,
+    NULL,
+    NULL,
+    button_get_default_action,
+    button_do_default_action,
+};
