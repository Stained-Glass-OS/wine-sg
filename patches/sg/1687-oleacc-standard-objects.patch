+static HRESULT WINAPI Part_get_accValue(IAccessible *iface, VARIANT varid, BSTR *value)
+{
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &varid);
+    SCROLLINFO si = { sizeof(si), SIF_ALL };
+    WCHAR buf[16];
+    int range, percent;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_variant(&varid), value);
+
+    *value = NULL;
+    if (id < 0) return E_INVALIDARG;
+    if (!is_scrollbar(This) || (id != INDEX_SCROLLBAR_SELF && id != INDEX_SCROLLBAR_THUMB))
+        return S_FALSE;
+    /* the position, as a percentage */
+    if (!GetScrollInfo(This->hwnd, This->objid == OBJID_VSCROLL ? SB_VERT : SB_HORZ, &si)) return S_FALSE;
+    range = si.nMax - si.nMin - (si.nPage ? si.nPage - 1 : 0);
+    percent = range > 0 ? (si.nPos - si.nMin) * 100 / range : 0;
+    swprintf(buf, ARRAY_SIZE(buf), L"%d", max(0, min(100, percent)));
+    *value = SysAllocString(buf);
+    return *value ? S_OK : E_OUTOFMEMORY;
+}
