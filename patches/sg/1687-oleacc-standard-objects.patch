+static HRESULT WINAPI Part_get_accState(IAccessible *iface, VARIANT varid, VARIANT *state)
+{
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &varid);
+    TITLEBARINFO tinfo;
+    SCROLLBARINFO sinfo;
+    CURSORINFO cinfo;
+    UINT mstate;
+    RECT rect;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_variant(&varid), state);
+
+    V_VT(state) = VT_EMPTY;
+    if (id < 0) return E_INVALIDARG;
+    V_VT(state) = VT_I4;
+    V_I4(state) = 0;
+    switch (This->objid)
+    {
+    case OBJID_TITLEBAR:
+        if (title_bar_info(This, &tinfo)) V_I4(state) = tinfo.rgstate[id];
+        else V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        break;
+    case OBJID_VSCROLL:
+    case OBJID_HSCROLL:
+        if (scroll_bar_info(This, &sinfo)) V_I4(state) = sinfo.rgstate[id];
+        else V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        break;
+    case OBJID_MENU:
+        if (!part_menu(This)) V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        else if (id != CHILDID_SELF)
+        {
+            mstate = GetMenuState(part_menu(This), id - 1, MF_BYPOSITION);
+            if (mstate & (MF_GRAYED | MF_DISABLED)) V_I4(state) |= STATE_SYSTEM_UNAVAILABLE;
+            if (mstate & MF_CHECKED) V_I4(state) |= STATE_SYSTEM_CHECKED;
+            if (mstate & MF_HILITE) V_I4(state) |= STATE_SYSTEM_HOTTRACKED;
+            if (mstate & MF_POPUP) V_I4(state) |= STATE_SYSTEM_HASPOPUP;
+            V_I4(state) |= STATE_SYSTEM_FOCUSABLE;
+        }
+        break;
+    case OBJID_SYSMENU:
+        if (!(GetWindowLongW(This->hwnd, GWL_STYLE) & WS_SYSMENU)) V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        else if (id != CHILDID_SELF) V_I4(state) = STATE_SYSTEM_HASPOPUP | STATE_SYSTEM_FOCUSABLE;
+        break;
+    case OBJID_SIZEGRIP:
+        if (!size_grip_visible(This)) V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        break;
+    case OBJID_CARET:
+        if (!caret_info(This, &rect)) V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        break;
+    case OBJID_CURSOR:
+        cinfo.cbSize = sizeof(cinfo);
+        if (GetCursorInfo(&cinfo) && !(cinfo.flags & CURSOR_SHOWING)) V_I4(state) = STATE_SYSTEM_INVISIBLE;
+        break;
+    }
+    return S_OK;
+}
