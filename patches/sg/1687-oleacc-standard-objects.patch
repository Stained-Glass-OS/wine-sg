+static HRESULT WINAPI Part_EnumVARIANT_Next(IEnumVARIANT *iface, ULONG count, VARIANT *v, ULONG *fetched)
+{
+    Part *This = impl_from_Part_EnumVARIANT(iface);
+    ULONG total = part_child_count(This), i;
+
+    for (i = 0; i < count && This->enum_pos < total; i++)
+    {
+        V_VT(&v[i]) = VT_I4;
+        V_I4(&v[i]) = ++This->enum_pos;
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI Part_EnumVARIANT_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    Part *This = impl_from_Part_EnumVARIANT(iface);
+    ULONG total = part_child_count(This);
+
+    if (This->enum_pos + count > total)
+    {
+        This->enum_pos = total;
+        return S_FALSE;
+    }
+    This->enum_pos += count;
+    return S_OK;
+}
