+static HRESULT WINAPI Part_get_accName(IAccessible *iface, VARIANT varid, BSTR *name)
+{
+    static const WCHAR *title_buttons[] = { NULL, L"IME", L"Minimize", L"Maximize", L"Context help", L"Close" };
+    static const WCHAR *vscroll[] = { L"Vertical", L"Line up", L"Page up", L"Position", L"Page down", L"Line down" };
+    static const WCHAR *hscroll[] = { L"Horizontal", L"Column left", L"Page left", L"Position", L"Page right",
+                                      L"Column right" };
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &varid);
+    WCHAR buf[256];
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_variant(&varid), name);
+
+    *name = NULL;
+    if (id < 0) return E_INVALIDARG;
+    switch (This->objid)
+    {
+    case OBJID_TITLEBAR:
+        if (id == CHILDID_SELF)
+        {
+            if (!GetWindowTextW(This->hwnd, buf, ARRAY_SIZE(buf))) return S_FALSE;
+            *name = SysAllocString(buf);
+        }
+        else if (id == INDEX_TITLEBAR_MAXBUTTON && IsZoomed(This->hwnd)) *name = SysAllocString(L"Restore");
+        else *name = SysAllocString(title_buttons[id]);
+        break;
+    case OBJID_VSCROLL:
+        *name = SysAllocString(vscroll[id]);
+        break;
+    case OBJID_HSCROLL:
+        *name = SysAllocString(hscroll[id]);
+        break;
+    case OBJID_MENU:
+        if (id == CHILDID_SELF) *name = SysAllocString(L"Application");
+        else
+        {
+            if (!GetMenuStringW(part_menu(This), id - 1, buf, ARRAY_SIZE(buf), MF_BYPOSITION)) return S_FALSE;
+            *name = strip_ampersand(buf);
+        }
+        break;
+    case OBJID_SYSMENU:
+        *name = SysAllocString(L"System");
+        break;
+    case OBJID_SIZEGRIP:
+        *name = SysAllocString(L"Size grip");
+        break;
+    case OBJID_CARET:
+        *name = SysAllocString(L"Caret");
+        break;
+    case OBJID_CURSOR:
+        *name = SysAllocString(L"Normal");
+        break;
+    default:
+        return S_FALSE;
+    }
+    return *name ? S_OK : E_OUTOFMEMORY;
+}
