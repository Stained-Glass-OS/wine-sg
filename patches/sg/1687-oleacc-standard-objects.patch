+static HRESULT WINAPI Part_put_accValue(IAccessible *iface, VARIANT varid, BSTR value)
+{
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &varid);
+    SCROLLINFO si = { sizeof(si), SIF_ALL };
+    int bar, percent, range, pos;
+
+    TRACE("(%p)->(%s %s)\n", This, debugstr_variant(&varid), debugstr_w(value));
+
+    if (id < 0) return E_INVALIDARG;
+    if (!is_scrollbar(This) || id != CHILDID_SELF) return DISP_E_MEMBERNOTFOUND;
+    if (!value) return E_INVALIDARG;
+    percent = wcstol(value, NULL, 10);
+    if (percent < 0 || percent > 100) return E_INVALIDARG;
+    bar = This->objid == OBJID_VSCROLL ? SB_VERT : SB_HORZ;
+    if (!GetScrollInfo(This->hwnd, bar, &si)) return E_FAIL;
+    range = si.nMax - si.nMin - (si.nPage ? si.nPage - 1 : 0);
+    pos = si.nMin + MulDiv(range, percent, 100);
+    SetScrollPos(This->hwnd, bar, pos, TRUE);
+    SendMessageW(This->hwnd, bar == SB_VERT ? WM_VSCROLL : WM_HSCROLL, MAKEWPARAM(SB_THUMBPOSITION, pos), 0);
+    return S_OK;
+}
