+    V_VT(role) = VT_I4;
+    switch (This->objid)
+    {
+    case OBJID_TITLEBAR:
+        V_I4(role) = id == CHILDID_SELF ? ROLE_SYSTEM_TITLEBAR : ROLE_SYSTEM_PUSHBUTTON;
+        break;
+    case OBJID_VSCROLL:
+    case OBJID_HSCROLL:
+        V_I4(role) = id == CHILDID_SELF ? ROLE_SYSTEM_SCROLLBAR :
+                     id == INDEX_SCROLLBAR_THUMB ? ROLE_SYSTEM_INDICATOR : ROLE_SYSTEM_PUSHBUTTON;
+        break;
+    case OBJID_MENU:
+    case OBJID_SYSMENU:
+        V_I4(role) = id == CHILDID_SELF ? ROLE_SYSTEM_MENUBAR : ROLE_SYSTEM_MENUITEM;
+        break;
+    case OBJID_SIZEGRIP:
+        V_I4(role) = ROLE_SYSTEM_GRIP;
+        break;
+    case OBJID_CARET:
+        V_I4(role) = ROLE_SYSTEM_CARET;
+        break;
+    case OBJID_CURSOR:
+        V_I4(role) = ROLE_SYSTEM_CURSOR;
+        break;
+    }
+    return S_OK;
+}
