+static ULONG WINAPI Part_AddRef(IAccessible *iface)
+{
+    return InterlockedIncrement(&impl_from_Part(iface)->ref);
+}
+
+static ULONG WINAPI Part_Release(IAccessible *iface)
+{
+    Part *This = impl_from_Part(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
