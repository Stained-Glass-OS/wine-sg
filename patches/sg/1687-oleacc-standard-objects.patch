+        return E_FAIL;
+#ifdef SG_MUTANT_NO_PARTS
+    return E_NOTIMPL;
+#endif
+    if (!(part = calloc(1, sizeof(*part))))
+        return E_OUTOFMEMORY;
+    part->IAccessible_iface.lpVtbl = &PartVtbl;
+    part->IOleWindow_iface.lpVtbl = &PartOleWindowVtbl;
+    part->IEnumVARIANT_iface.lpVtbl = &PartEnumVARIANTVtbl;
+    part->IServiceProvider_iface.lpVtbl = &PartServiceProviderVtbl;
+    part->ref = 1;
+    part->hwnd = hwnd;
+    part->objid = objid;
+    hr = IAccessible_QueryInterface(&part->IAccessible_iface, iid, obj);
+    IAccessible_Release(&part->IAccessible_iface);
+    return hr;
+}
