+static HRESULT WINAPI Part_get_accKeyboardShortcut(IAccessible *iface, VARIANT varid, BSTR *shortcut)
+{
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &varid);
+    WCHAR buf[256], *amp;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_variant(&varid), shortcut);
+
+    *shortcut = NULL;
+    if (id < 0) return E_INVALIDARG;
+    if (This->objid == OBJID_SYSMENU)
+    {
+        *shortcut = SysAllocString(L"Alt+Space");
+        return S_OK;
+    }
+    if (This->objid != OBJID_MENU || id == CHILDID_SELF ||
+        !GetMenuStringW(part_menu(This), id - 1, buf, ARRAY_SIZE(buf), MF_BYPOSITION))
+        return S_FALSE;
+    for (amp = buf; (amp = wcschr(amp, '&')); amp += 2)
+        if (amp[1] && amp[1] != '&')
+        {
+            WCHAR text[8] = L"Alt+";
+            text[4] = amp[1];
+            text[5] = 0;
+            *shortcut = SysAllocString(text);
+            return S_OK;
+        }
+        else if (!amp[1]) break;
+    return S_FALSE;
+}
