+static const LONG window_parts[] = { OBJID_SYSMENU, OBJID_TITLEBAR, OBJID_MENU, OBJID_CLIENT,
+                                     OBJID_VSCROLL, OBJID_HSCROLL, OBJID_SIZEGRIP };
+
+static HRESULT WINAPI Part_accNavigate(IAccessible *iface, LONG dir, VARIANT start, VARIANT *end)
+{
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &start), count = part_child_count(This);
+    HRESULT hr;
+    int i;
+
+    TRACE("(%p)->(%ld %s %p)\n", This, dir, debugstr_variant(&start), end);
+
+    V_VT(end) = VT_EMPTY;
+    if (id < 0) return E_INVALIDARG;
+    if (id == CHILDID_SELF)
+    {
+        switch (dir)
+        {
+        case NAVDIR_FIRSTCHILD:
+        case NAVDIR_LASTCHILD:
+            if (!count) return S_FALSE;
+            V_VT(end) = VT_I4;
+            V_I4(end) = dir == NAVDIR_FIRSTCHILD ? 1 : count;
+            return S_OK;
+        case NAVDIR_NEXT:
+        case NAVDIR_PREVIOUS:
+            /* the window's parts, in its order */
+            for (i = 0; i < ARRAY_SIZE(window_parts); i++)
+                if (window_parts[i] == This->objid) break;
+            i += dir == NAVDIR_NEXT ? 1 : -1;
+            if (i < 0 || i >= ARRAY_SIZE(window_parts)) return S_FALSE;
+            V_VT(end) = VT_DISPATCH;
+            hr = AccessibleObjectFromWindow(This->hwnd, window_parts[i], &IID_IDispatch, (void **)&V_DISPATCH(end));
+            if (FAILED(hr) || !V_DISPATCH(end)) V_VT(end) = VT_EMPTY;
+            return hr;
+        default:
+            return S_FALSE;
+        }
+    }
+    switch (dir)
+    {
+    case NAVDIR_NEXT:
+    case NAVDIR_RIGHT:
+    case NAVDIR_DOWN:
+        if (id >= count) return S_FALSE;
+        V_VT(end) = VT_I4;
+        V_I4(end) = id + 1;
+        return S_OK;
+    case NAVDIR_PREVIOUS:
+    case NAVDIR_LEFT:
+    case NAVDIR_UP:
+        if (id <= 1) return S_FALSE;
+        V_VT(end) = VT_I4;
+        V_I4(end) = id - 1;
+        return S_OK;
+    default:
+        return S_FALSE;
+    }
+}
+
+static HRESULT WINAPI Part_accHitTest(IAccessible *iface, LONG x, LONG y, VARIANT *v)
+{
+    Part *This = impl_from_Part(iface);
+    LONG id, count = part_child_count(This);
+    POINT pt = { x, y };
+    RECT rect;
+
+    TRACE("(%p)->(%ld %ld %p)\n", This, x, y, v);
+
+    V_VT(v) = VT_EMPTY;
+    for (id = 1; id <= count; id++)
+    {
+        part_rect(This, id, &rect);
+        if (PtInRect(&rect, pt))
+        {
+            V_VT(v) = VT_I4;
+            V_I4(v) = id;
+            return S_OK;
+        }
+    }
+    part_rect(This, CHILDID_SELF, &rect);
+    if (!PtInRect(&rect, pt)) return S_FALSE;
+    V_VT(v) = VT_I4;
+    V_I4(v) = CHILDID_SELF;
+    return S_OK;
+}
+
+static HRESULT WINAPI Part_accDoDefaultAction(IAccessible *iface, VARIANT varid)
+{
+    static const WPARAM scroll_codes[] = { 0, SB_LINEUP, SB_PAGEUP, 0, SB_PAGEDOWN, SB_LINEDOWN };
+    Part *This = impl_from_Part(iface);
+    LONG id = part_child_id(This, &varid);
+    WCHAR buf[256], *amp;
+    UINT item;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&varid));
+
+    if (id < 0) return E_INVALIDARG;
+    if (id == CHILDID_SELF) return DISP_E_MEMBERNOTFOUND;
+#ifdef SG_MUTANT_NO_PART_ACTION
+    return S_OK;
+#endif
+    switch (This->objid)
+    {
+    case OBJID_TITLEBAR:
+        switch (id)
+        {
+        case INDEX_TITLEBAR_MINBUTTON:
+            PostMessageW(This->hwnd, WM_SYSCOMMAND, IsIconic(This->hwnd) ? SC_RESTORE : SC_MINIMIZE, 0);
+            return S_OK;
+        case INDEX_TITLEBAR_MAXBUTTON:
+            PostMessageW(This->hwnd, WM_SYSCOMMAND, IsZoomed(This->hwnd) ? SC_RESTORE : SC_MAXIMIZE, 0);
+            return S_OK;
+        case INDEX_TITLEBAR_HELPBUTTON:
+            PostMessageW(This->hwnd, WM_SYSCOMMAND, SC_CONTEXTHELP, 0);
+            return S_OK;
+        case INDEX_TITLEBAR_CLOSEBUTTON:
+            PostMessageW(This->hwnd, WM_SYSCOMMAND, SC_CLOSE, 0);
+            return S_OK;
+        }
+        return DISP_E_MEMBERNOTFOUND;
+    case OBJID_VSCROLL:
+    case OBJID_HSCROLL:
+        if (id == INDEX_SCROLLBAR_THUMB) return DISP_E_MEMBERNOTFOUND;
+        SendMessageW(This->hwnd, This->objid == OBJID_VSCROLL ? WM_VSCROLL : WM_HSCROLL, scroll_codes[id], 0);
+        return S_OK;
+    case OBJID_MENU:
+        if (!GetMenuStringW(part_menu(This), id - 1, buf, ARRAY_SIZE(buf), MF_BYPOSITION))
+            buf[0] = 0;
+        if (!(GetMenuState(part_menu(This), id - 1, MF_BYPOSITION) & MF_POPUP) &&
+            (item = GetMenuItemID(part_menu(This), id - 1)) != (UINT)-1)
+        {
+            PostMessageW(This->hwnd, WM_COMMAND, MAKEWPARAM(item, 0), 0);
+            return S_OK;
+        }
+        /* open it as its mnemonic would */
+        for (amp = buf; (amp = wcschr(amp, '&')) && amp[1] == '&'; amp += 2) ;
+        PostMessageW(This->hwnd, WM_SYSCOMMAND, SC_KEYMENU, amp && amp[1] ? amp[1] : 0);
+        return S_OK;
+    case OBJID_SYSMENU:
+        PostMessageW(This->hwnd, WM_SYSCOMMAND, SC_KEYMENU, ' ');
+        return S_OK;
+    }
+    return DISP_E_MEMBERNOTFOUND;
+}
