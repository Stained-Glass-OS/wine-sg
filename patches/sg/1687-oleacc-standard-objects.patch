+++ b/dlls/oleacc/nonclient.c
@@ -0,0 +1,1027 @@
+/*
+ * Standard accessible objects for a window's parts (Stained Glass OS 1687):
+ * the title bar, the menu bar and system menu, the scroll bars, the size
+ * grip, the caret and the cursor, as CreateStdAccessibleObject gives them
+ * for OBJID_TITLEBAR, OBJID_MENU, OBJID_SYSMENU, OBJID_VSCROLL,
+ * OBJID_HSCROLL, OBJID_SIZEGRIP, OBJID_CARET and OBJID_CURSOR. Their
+ * children are simple elements, numbered as winuser.h's INDEX_TITLEBAR_*
+ * and INDEX_SCROLLBAR_* say, and their states come from GetTitleBarInfo,
+ * GetScrollBarInfo, GetMenuBarInfo and GetGUIThreadInfo.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdlib.h>
+#include "oleacc_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(oleacc);
+
+typedef struct {
+    IAccessible IAccessible_iface;
+    IOleWindow IOleWindow_iface;
+    IEnumVARIANT IEnumVARIANT_iface;
+    IServiceProvider IServiceProvider_iface;
+
+    LONG ref;
+
+    HWND hwnd;
+    LONG objid;
+    ULONG enum_pos;
+} Part;
+
+static inline Part *impl_from_Part(IAccessible *iface)
+{
+    return CONTAINING_RECORD(iface, Part, IAccessible_iface);
+}
+
+static BOOL is_scrollbar(Part *part)
+{
+    return part->objid == OBJID_VSCROLL || part->objid == OBJID_HSCROLL;
+}
+
+static HMENU part_menu(Part *part)
+{
+    if (part->objid == OBJID_MENU)
+    {
+        if (GetWindowLongW(part->hwnd, GWL_STYLE) & WS_CHILD) return NULL;
+        return GetMenu(part->hwnd);
+    }
+    return NULL;
+}
+
+static LONG part_child_count(Part *part)
+{
+    HMENU menu;
+
+    switch (part->objid)
+    {
+    case OBJID_TITLEBAR:
+        return CCHILDREN_TITLEBAR;
+    case OBJID_VSCROLL:
+    case OBJID_HSCROLL:
+        return CCHILDREN_SCROLLBAR;
+    case OBJID_MENU:
+        menu = part_menu(part);
+        return menu ? max(GetMenuItemCount(menu), 0) : 0;
+    case OBJID_SYSMENU:
+        return (GetWindowLongW(part->hwnd, GWL_STYLE) & WS_SYSMENU) ? 1 : 0;
+    default:
+        return 0;
+    }
+}
+
+/* the child id, or -1 for one this part does not have */
+static LONG part_child_id(Part *part, VARIANT *v)
+{
+    LONG id;
+
+    if (V_VT(v) != VT_I4) return -1;
+    id = V_I4(v);
+    if (id < 0 || id > part_child_count(part)) return -1;
+    return id;
+}
+
+static BSTR strip_ampersand(const WCHAR *text)
+{
+    WCHAR buf[256];
+    int i, j;
+
+    for (i = j = 0; text[i] && j < ARRAY_SIZE(buf) - 1; i++)
+    {
+        if (text[i] == '&' && text[i + 1] != '&') continue;
+        if (text[i] == '\t') break;
+        buf[j++] = text[i];
+    }
+    buf[j] = 0;
+    return SysAllocString(buf);
+}
+
+static BOOL title_bar_info(Part *part, TITLEBARINFO *info)
+{
+    info->cbSize = sizeof(*info);
+    return GetTitleBarInfo(part->hwnd, info);
+}
+
+static BOOL scroll_bar_info(Part *part, SCROLLBARINFO *info)
+{
+    info->cbSize = sizeof(*info);
+    return GetScrollBarInfo(part->hwnd, part->objid, info);
+}
+
+/* the title bar buttons' places, from the right: close, maximize,
+ * minimize, or close and help */
+static void title_button_rect(Part *part, LONG id, RECT *rect)
+{
+    LONG style = GetWindowLongW(part->hwnd, GWL_STYLE), ex_style = GetWindowLongW(part->hwnd, GWL_EXSTYLE);
+    int width = GetSystemMetrics((ex_style & WS_EX_TOOLWINDOW) ? SM_CXSMSIZE : SM_CXSIZE);
+    TITLEBARINFO info;
+    int slot = -1;
+
+    SetRectEmpty(rect);
+    if (!title_bar_info(part, &info)) return;
+    switch (id)
+    {
+    case INDEX_TITLEBAR_CLOSEBUTTON: slot = 0; break;
+    case INDEX_TITLEBAR_MAXBUTTON: slot = 1; break;
+    case INDEX_TITLEBAR_MINBUTTON: slot = 2; break;
+    case INDEX_TITLEBAR_HELPBUTTON: slot = (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) ? 3 : 1; break;
+    default: return;
+    }
+    if (info.rgstate[id] & STATE_SYSTEM_INVISIBLE) return;
+    rect->right = info.rcTitleBar.right - slot * width;
+    rect->left = rect->right - width;
+    rect->top = info.rcTitleBar.top;
+    rect->bottom = info.rcTitleBar.bottom;
+}
+
+static void scroll_part_rect(Part *part, LONG id, RECT *rect)
+{
+    SCROLLBARINFO info;
+    BOOL vert = part->objid == OBJID_VSCROLL;
+    RECT r;
+
+    SetRectEmpty(rect);
+    if (!scroll_bar_info(part, &info)) return;
+    r = info.rcScrollBar;
+    if (id == INDEX_SCROLLBAR_SELF)
+    {
+        *rect = r;
+        return;
+    }
+    if (info.rgstate[id] & STATE_SYSTEM_INVISIBLE) return;
+    *rect = r;
+    if (vert)
+    {
+        switch (id)
+        {
+        case INDEX_SCROLLBAR_UP: rect->bottom = r.top + info.dxyLineButton; break;
+        case INDEX_SCROLLBAR_UPPAGE: rect->top = r.top + info.dxyLineButton; rect->bottom = r.top + info.xyThumbTop; break;
+        case INDEX_SCROLLBAR_THUMB: rect->top = r.top + info.xyThumbTop; rect->bottom = r.top + info.xyThumbBottom; break;
+        case INDEX_SCROLLBAR_DOWNPAGE: rect->top = r.top + info.xyThumbBottom; rect->bottom = r.bottom - info.dxyLineButton; break;
+        case INDEX_SCROLLBAR_DOWN: rect->top = r.bottom - info.dxyLineButton; break;
+        }
+    }
+    else
+    {
+        switch (id)
+        {
+        case INDEX_SCROLLBAR_UP: rect->right = r.left + info.dxyLineButton; break;
+        case INDEX_SCROLLBAR_UPPAGE: rect->left = r.left + info.dxyLineButton; rect->right = r.left + info.xyThumbTop; break;
+        case INDEX_SCROLLBAR_THUMB: rect->left = r.left + info.xyThumbTop; rect->right = r.left + info.xyThumbBottom; break;
+        case INDEX_SCROLLBAR_DOWNPAGE: rect->left = r.left + info.xyThumbBottom; rect->right = r.right - info.dxyLineButton; break;
+        case INDEX_SCROLLBAR_DOWN: rect->left = r.right - info.dxyLineButton; break;
+        }
+    }
+}
+
+static BOOL size_grip_visible(Part *part)
+{
+    LONG style = GetWindowLongW(part->hwnd, GWL_STYLE);
+    return (style & WS_VISIBLE) && (style & WS_VSCROLL) && (style & WS_HSCROLL);
+}
+
+static void size_grip_rect(Part *part, RECT *rect)
+{
+    SCROLLBARINFO v, h;
+
+    SetRectEmpty(rect);
+    if (!size_grip_visible(part)) return;
+    v.cbSize = h.cbSize = sizeof(v);
+    if (!GetScrollBarInfo(part->hwnd, OBJID_VSCROLL, &v) || !GetScrollBarInfo(part->hwnd, OBJID_HSCROLL, &h)) return;
+    rect->left = v.rcScrollBar.left;
+    rect->right = v.rcScrollBar.right;
+    rect->top = h.rcScrollBar.top;
+    rect->bottom = h.rcScrollBar.bottom;
+}
+
+static BOOL caret_info(Part *part, RECT *rect)
+{
+    GUITHREADINFO info;
+    DWORD tid = GetWindowThreadProcessId(part->hwnd, NULL);
+
+    SetRectEmpty(rect);
+    info.cbSize = sizeof(info);
+    if (!tid || !GetGUIThreadInfo(tid, &info) || !info.hwndCaret) return FALSE;
+    if (info.hwndCaret != part->hwnd && !IsChild(part->hwnd, info.hwndCaret)) return FALSE;
+    *rect = info.rcCaret;
+    MapWindowPoints(info.hwndCaret, NULL, (POINT *)rect, 2);
+    return TRUE;
+}
+
+static void part_rect(Part *part, LONG id, RECT *rect)
+{
+    TITLEBARINFO tinfo;
+    MENUBARINFO minfo;
+    POINT pt;
+
+    SetRectEmpty(rect);
+    switch (part->objid)
+    {
+    case OBJID_TITLEBAR:
+        if (id == CHILDID_SELF)
+        {
+            if (title_bar_info(part, &tinfo) && !(tinfo.rgstate[0] & STATE_SYSTEM_INVISIBLE)) *rect = tinfo.rcTitleBar;
+        }
+        else title_button_rect(part, id, rect);
+        break;
+    case OBJID_VSCROLL:
+    case OBJID_HSCROLL:
+        scroll_part_rect(part, id, rect);
+        break;
+    case OBJID_MENU:
+        minfo.cbSize = sizeof(minfo);
+        if (part_menu(part) && GetMenuBarInfo(part->hwnd, OBJID_MENU, id, &minfo)) *rect = minfo.rcBar;
+        break;
+    case OBJID_SYSMENU:
+        if (!(GetWindowLongW(part->hwnd, GWL_STYLE) & WS_SYSMENU) || !title_bar_info(part, &tinfo)) break;
+        /* the icon, left of the title bar's text */
+        rect->right = tinfo.rcTitleBar.left;
+        rect->left = rect->right - GetSystemMetrics(SM_CXSIZE);
+        rect->top = tinfo.rcTitleBar.top;
+        rect->bottom = tinfo.rcTitleBar.bottom;
+        break;
+    case OBJID_SIZEGRIP:
+        size_grip_rect(part, rect);
+        break;
+    case OBJID_CARET:
+        caret_info(part, rect);
+        break;
+    case OBJID_CURSOR:
+        GetCursorPos(&pt);
+        rect->left = pt.x;
+        rect->top = pt.y;
+        rect->right = pt.x + GetSystemMetrics(SM_CXCURSOR);
+        rect->bottom = pt.y + GetSystemMetrics(SM_CYCURSOR);
+        break;
+    }
+}
