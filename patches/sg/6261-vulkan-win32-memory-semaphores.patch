+VkResult wine_vkGetMemoryWin32HandleKHR(VkDevice client_device, const VkMemoryGetWin32HandleInfoKHR *handle_info,
+                                        HANDLE *handle)
+{
+    struct wine_device_memory *memory = wine_device_memory_from_handle(handle_info->memory);
+    NTSTATUS status;
+
+    TRACE("%p, %p, %p: memory %p type %#x\n", client_device, handle_info, handle, memory, handle_info->handleType);
+
+    switch (handle_info->handleType)
+    {
+    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT:
+    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_KMT_BIT:
+        if (!memory->kmt_global) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+        *handle = ULongToHandle(memory->kmt_global);
+        return VK_SUCCESS;
+
+    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT:
+    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_BIT:
+        if (!memory->kmt_shared)
+        {
+            if (!memory->kmt_local) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+            if ((status = NtGdiDdDDIShareObjects(1, &memory->kmt_local, NULL, GENERIC_ALL, &memory->kmt_shared)))
+            {
