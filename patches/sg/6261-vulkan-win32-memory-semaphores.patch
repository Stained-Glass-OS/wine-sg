From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winevulkan: Win32 memory and semaphore handles over host fds, for DXVK shared textures

Direct3D 11 textures shared between devices and processes went blank under DXVK: Qt WebEngine (GOG GALAXY, calibre) and Chromium hand their frames over as shared textures with keyed mutexes. winevulkan now offers VK_KHR_external_memory_win32 and VK_KHR_external_semaphore_win32 over the host's opaque fds, kept behind D3DKMT resources and synchronization objects so that KMT handles, NT handles and DuplicateHandle work across processes. Keyed mutex waits honour DXVK's timeouts, NT handles made with inheritable security attributes are inherited, and DXVK can open the memory it shares before describing it.
---
diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
index 37a1a3c..d31583a 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -177,6 +177,7 @@ NTSTATUS WINAPI NtGdiDdDDIOpenAdapterFromHdc( D3DKMT_OPENADAPTERFROMHDC *desc )
  *           NtGdiDdDDIEscape    (win32u.@)
  */
 static NTSTATUS kmt_escape( struct wine_kmt_escape *escape );
+static NTSTATUS kmt_update_resource( D3DKMT_HANDLE handle, const void *data, UINT size );
 
 NTSTATUS WINAPI NtGdiDdDDIEscape( const D3DKMT_ESCAPE *desc )
 {
@@ -184,6 +185,15 @@ NTSTATUS WINAPI NtGdiDdDDIEscape( const D3DKMT_ESCAPE *desc )
 
     TRACE( "(%p)\n", desc );
 
+    /* Stained Glass OS 6261: Wine's own escapes, which name the object and no adapter (DXVK keeps the
+     * description of a shared texture in its resource's runtime data with this one) */
+    if (desc && desc->Type == D3DKMT_ESCAPE_UPDATE_RESOURCE_WINE)
+    {
+        if (desc->PrivateDriverDataSize && !desc->pPrivateDriverData) return STATUS_INVALID_PARAMETER;
+        return kmt_update_resource( desc->hContext, desc->pPrivateDriverData, desc->PrivateDriverDataSize );
+    }
+    if (desc && desc->Type == D3DKMT_ESCAPE_SET_PRESENT_RECT_WINE) return STATUS_SUCCESS;  /* nothing to do here */
+
     /* Stained Glass OS: parameters are validated as D3DKMTEscape documents (STATUS_INVALID_PARAMETER);
      * there is no kernel-mode display driver to exchange data with, so a valid request is not
      * supported. */
@@ -871,7 +881,8 @@ void free_vulkan_gpu( struct vulkan_gpu *gpu )
  * wine/kmtshare.h for the conventions the runtime follows. */
 
 #define KMT_SHARE_MAGIC     0x4d4b4753   /* "SGKM" */
-#define KMT_SHARE_VERSION   1
+#define KMT_SHARE_VERSION   2
+#define KMT_VK_RUNTIME_MAX  0x1000   /* room for the runtime data of a resource made for GPU memory */
 #define KMT_SHARE_RESOURCE  0x1
 #define KMT_SHARE_MUTEX     0x2
 #define KMT_SHARE_SYNC      0x4
@@ -903,6 +914,13 @@ struct kmt_share_header
     LONG   mutex_abandoned, pad1;
     UINT64 sync_value;
     BYTE   mutex_runtime[KMT_MUTEX_RUNTIME_MAX];    /* private runtime data of the keyed mutex */
+    /* Stained Glass OS 6261: GPU memory (a host Vulkan memory fd) behind the resource: the process
+     * that made it keeps the fd in a file handle, which an opener duplicates */
+    UINT   vk_pid, vk_pad;
+    UINT64 vk_handle, vk_size;
+    /* ... and the timeline semaphore (a host Vulkan semaphore fd) of a sync object, kept the same way */
+    UINT   sem_pid, sem_pad;
+    UINT64 sem_handle;
 };
 
 enum kmt_type { KMT_RESOURCE = 1, KMT_ALLOCATION, KMT_KEYEDMUTEX, KMT_SYNC };
@@ -919,6 +937,8 @@ struct kmt_block
      * the block has mapped stays, so that it does not read freed memory. */
     struct { struct kmt_share_header *hdr; HANDLE section; } old[KMT_MAX_OLD_VIEWS];
     UINT old_count;
+    HANDLE vk_file;     /* 6261: the file handle holding the GPU memory fd, in the process that made it */
+    HANDLE sem_file;    /* 6261: the same for a semaphore fd */
 };
 
 struct kmt_object
@@ -974,6 +994,16 @@ static void kmt_block_unref( struct kmt_block *block )
     UINT i;
 
     if (--block->ref) return;
+    if (block->vk_file)
+    {
+        if (block->hdr->vk_pid == HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess )) block->hdr->vk_handle = 0;
+        NtClose( block->vk_file );
+    }
+    if (block->sem_file)
+    {
+        if (block->hdr->sem_pid == HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess )) block->hdr->sem_handle = 0;
+        NtClose( block->sem_file );
+    }
     NtUnmapViewOfSection( NtCurrentProcess(), block->hdr );
     NtClose( block->section );
     for (i = 0; i < block->old_count; i++)
@@ -1156,9 +1186,22 @@ static NTSTATUS kmt_block_open_global( UINT id, struct kmt_block **ret )
 }
 
 /* A block for a resource, or for an allocation that has no resource. */
+static NTSTATUS kmt_block_create_ex( UINT flags, const void *runtime, UINT runtime_size, UINT runtime_capacity,
+                                     const void *driver, UINT driver_size, UINT count, const void *const *alloc_data,
+                                     const UINT *alloc_data_size, UINT *global, struct kmt_block **ret );
+
 static NTSTATUS kmt_block_create( UINT flags, const void *runtime, UINT runtime_size, const void *driver,
                                   UINT driver_size, UINT count, const void *const *alloc_data,
                                   const UINT *alloc_data_size, UINT *global, struct kmt_block **ret )
+{
+    return kmt_block_create_ex( flags, runtime, runtime_size, runtime_size, driver, driver_size, count, alloc_data,
+                                alloc_data_size, global, ret );
+}
+
+/* the same, with room for runtime data of up to runtime_capacity bytes (D3DKMT_ESCAPE_UPDATE_RESOURCE_WINE) */
+static NTSTATUS kmt_block_create_ex( UINT flags, const void *runtime, UINT runtime_size, UINT runtime_capacity,
+                                     const void *driver, UINT driver_size, UINT count, const void *const *alloc_data,
+                                     const UINT *alloc_data_size, UINT *global, struct kmt_block **ret )
 {
     struct kmt_share_header *hdr;
     struct kmt_share_alloc *allocs;
@@ -1167,11 +1210,12 @@ static NTSTATUS kmt_block_create( UINT flags, const void *runtime, UINT runtime_
     NTSTATUS status;
     UINT i;
 
-    if (runtime_size > KMT_MAX_PRIVATE || driver_size > KMT_MAX_PRIVATE || count > KMT_MAX_ALLOCS)
+    if (runtime_capacity < runtime_size) runtime_capacity = runtime_size;
+    if (runtime_capacity > KMT_MAX_PRIVATE || driver_size > KMT_MAX_PRIVATE || count > KMT_MAX_ALLOCS)
         return STATUS_INVALID_PARAMETER;
 
     off = kmt_align( sizeof(*hdr), 64 );
-    total = off + kmt_align( runtime_size, 8 ) + kmt_align( driver_size, 8 ) + count * sizeof(*allocs);
+    total = off + kmt_align( runtime_capacity, 8 ) + kmt_align( driver_size, 8 ) + count * sizeof(*allocs);
     for (i = 0; i < count; i++)
     {
         content = 0;
@@ -1232,7 +1276,7 @@ static NTSTATUS kmt_block_create( UINT flags, const void *runtime, UINT runtime_
     hdr->runtime_size = runtime_size;
     hdr->runtime_off = off;
     if (runtime_size) memcpy( (char *)hdr + off, runtime, runtime_size );
-    off += kmt_align( runtime_size, 8 );
+    off += kmt_align( runtime_capacity, 8 );
     hdr->driver_size = driver_size;
     hdr->driver_off = off;
     if (driver_size) memcpy( (char *)hdr + off, driver, driver_size );
@@ -1497,15 +1541,45 @@ NTSTATUS WINAPI NtGdiDdDDIDestroyAllocation( const D3DKMT_DESTROYALLOCATION *par
 /******************************************************************************
  *           NtGdiDdDDIShareObjects    (win32u.@)
  */
+/* DXVK (CreateSharedHandle) passes the SECURITY_ATTRIBUTES it was given as the security descriptor of the
+ * object attributes. A security descriptor starts with its revision (1), a SECURITY_ATTRIBUTES with its size
+ * (12 or 24): take the inheritance and the descriptor out of it, as kernelbase would have. */
+static OBJECT_ATTRIBUTES *kmt_fix_attributes( OBJECT_ATTRIBUTES *attr, OBJECT_ATTRIBUTES *fixed )
+{
+    const DWORD *sa;
+
+    if (!attr || !(sa = attr->SecurityDescriptor)) return attr;
+#ifdef SG_MUTANT_KMT_SA_AS_SD
+    return attr;
+#endif
+    if (sa[0] != 12 && sa[0] != 24) return attr;
+    *fixed = *attr;
+    if (sa[0] == 24)  /* 64-bit: size, padding, descriptor, inherit */
+    {
+        fixed->SecurityDescriptor = *(void * const *)(sa + 2);
+        if (sa[4]) fixed->Attributes |= OBJ_INHERIT;
+    }
+    else  /* 32-bit */
+    {
+        fixed->SecurityDescriptor = ULongToPtr( sa[1] );
+        if (sa[2]) fixed->Attributes |= OBJ_INHERIT;
+    }
+    TRACE( "security attributes %p as a descriptor: descriptor %p, attributes %#x\n", sa,
+           fixed->SecurityDescriptor, (int)fixed->Attributes );
+    return fixed;
+}
+
 NTSTATUS WINAPI NtGdiDdDDIShareObjects( UINT count, const D3DKMT_HANDLE *handles, OBJECT_ATTRIBUTES *attr,
                                         UINT access, HANDLE *handle )
 {
     struct kmt_object *resource = NULL, *mutex = NULL, *sync = NULL;
+    OBJECT_ATTRIBUTES fixed_attr;
     struct kmt_block *block;
     NTSTATUS status;
     UINT i;
 
     TRACE( "count %u, handles %p, attr %p, access %#x, handle %p\n", count, handles, attr, access, handle );
+    attr = kmt_fix_attributes( attr, &fixed_attr );
 
     if (!count || !handles || !handle) return STATUS_INVALID_PARAMETER;
     *handle = NULL;
@@ -1574,6 +1648,14 @@ NTSTATUS WINAPI NtGdiDdDDIShareObjects( UINT count, const D3DKMT_HANDLE *handles
         rh->sync_flags = sh->sync_flags;
         rh->sync_max = sh->sync_max;
         rh->sync_value = sh->sync_value;
+        /* 6261: and the semaphore behind it */
+        rh->sem_pid = sh->sem_pid;
+        rh->sem_handle = sh->sem_handle;
+        if (old->sem_file && !resource->block->sem_file)
+        {
+            resource->block->sem_file = old->sem_file;
+            old->sem_file = NULL;
+        }
         rh->flags |= KMT_SHARE_SYNC;
 #ifndef SG_MUTANT_KMT_SYNC_NOMERGE
         sync->block = resource->block;
@@ -1652,6 +1734,12 @@ static NTSTATUS kmt_resource_open( D3DKMT_HANDLE device, struct kmt_block *block
     if (!(hdr->flags & KMT_SHARE_RESOURCE) || count != hdr->alloc_count || (count && !infos))
         return STATUS_INVALID_PARAMETER;
     for (i = 0; i < count; i++) needed += allocs[i].private_size;
+#ifndef SG_MUTANT_KMT_OPEN_EMPTY_BUFFERS
+    /* a buffer of no size asks for nothing: DXVK opens the memory it shares so, before it gave any data */
+    if (!runtime_size) runtime = NULL;
+    if (!resource_driver_size) resource_driver = NULL;
+    if (!total_size) total = NULL;
+#endif
 #ifndef SG_MUTANT_KMT_OPEN_NOCHECK
     if ((runtime && runtime_size < hdr->runtime_size)
         || (resource_driver && resource_driver_size < hdr->driver_size)
@@ -1873,6 +1961,162 @@ static NTSTATUS kmt_escape( struct wine_kmt_escape *escape )
     return status;
 }
 
+/* Stained Glass OS 6261: the runtime data of a resource, replaced (D3DKMT_ESCAPE_UPDATE_RESOURCE_WINE):
+ * every process that has the resource sees it from now on */
+static NTSTATUS kmt_update_resource( D3DKMT_HANDLE handle, const void *data, UINT size )
+{
+    struct kmt_object *object;
+    struct kmt_share_header *hdr;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(object = kmt_find( handle, KMT_RESOURCE ))) status = STATUS_INVALID_PARAMETER;
+    else
+    {
+        hdr = object->block->hdr;
+        /* the room the block has for it: up to the driver data */
+        if (size > hdr->driver_off - hdr->runtime_off) status = STATUS_BUFFER_TOO_SMALL;
+        else
+        {
+            if (size) memcpy( (char *)hdr + hdr->runtime_off, data, size );
+            hdr->runtime_size = size;
+        }
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return status;
+}
+
+/***********************************************************************
+ *      __wine_kmt_vk_create  (win32u.so)
+ *
+ * Stained Glass OS 6261: a resource for exported GPU memory (winevulkan, VK_KHR_external_memory_win32).
+ * The memory is a host fd (Vulkan's opaque fd); this process keeps it in a file handle that an opener of
+ * the resource, here or in another process, duplicates to get the fd. A global share handle comes back for
+ * KMT sharing; NT sharing gives the resource to D3DKMTShareObjects. The runtime data starts empty, with
+ * room for what the D3D runtime keeps there (D3DKMT_ESCAPE_UPDATE_RESOURCE_WINE).
+ */
+NTSTATUS __wine_kmt_vk_create( int fd, UINT64 size, BOOL nt_sharing, D3DKMT_HANDLE *local, UINT *global )
+{
+    struct wine_kmt_alloc_data data = { 0 };
+    const void *alloc_data = &data;
+    UINT alloc_size = sizeof(data), global_id = 0;
+    struct kmt_object *resource, *alloc;
+    struct kmt_block *block;
+    HANDLE file;
+    NTSTATUS status;
+
+    TRACE( "fd %d, size %#llx, nt_sharing %u\n", fd, (unsigned long long)size, nt_sharing );
+
+    if (fd < 0 || !local) return STATUS_INVALID_PARAMETER;
+    if ((status = wine_server_fd_to_handle( fd, GENERIC_READ | GENERIC_WRITE, 0, &file ))) return status;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(status = kmt_block_create_ex( KMT_SHARE_RESOURCE, NULL, 0, KMT_VK_RUNTIME_MAX, NULL, 0, 1, &alloc_data,
+                                        &alloc_size, nt_sharing ? NULL : &global_id, &block )))
+    {
+        block->vk_file = file;
+        file = NULL;
+        block->hdr->vk_pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+        block->hdr->vk_handle = (UINT64)(ULONG_PTR)block->vk_file;
+        block->hdr->vk_size = size;
+        status = kmt_objects_create( 0, block, nt_sharing, &resource, &alloc );
+        kmt_block_unref( block );
+        if (!status)
+        {
+            *local = resource->handle;
+            if (global) *global = global_id;
+        }
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    if (file) NtClose( file );
+    return status;
+}
+
+/* the fd kept in the file handle of a process, or -1 */
+static int kmt_fd_from( UINT pid, UINT64 value )
+{
+    UINT self = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    HANDLE handle = (HANDLE)(ULONG_PTR)value, process, copy;
+    OBJECT_ATTRIBUTES attr;
+    CLIENT_ID cid;
+    int fd = -1;
+
+    if (!handle || !pid) return -1;
+#ifdef SG_MUTANT_KMT_VK_NOFD
+    return -1;
+#endif
+    if (pid == self)
+    {
+        if (wine_server_handle_to_fd( handle, 0, &fd, NULL )) fd = -1;
+        return fd;
+    }
+    InitializeObjectAttributes( &attr, NULL, 0, 0, NULL );
+    cid.UniqueProcess = ULongToHandle( pid );
+    cid.UniqueThread = 0;
+    if (NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid ))
+    {
+        WARN( "the process %04x that has the memory is gone\n", pid );
+        return -1;
+    }
+    if (!NtDuplicateObject( process, handle, NtCurrentProcess(), &copy, 0, 0, DUPLICATE_SAME_ACCESS ))
+    {
+        if (wine_server_handle_to_fd( copy, 0, &fd, NULL )) fd = -1;
+        NtClose( copy );
+    }
+    NtClose( process );
+    return fd;
+}
+
+/* the fd of the GPU memory of a block, or -1 */
+static int kmt_block_vk_fd( struct kmt_block *block, UINT64 *size )
+{
+    if (size) *size = block->hdr->vk_size;
+    return kmt_fd_from( block->hdr->vk_pid, block->hdr->vk_handle );
+}
+
+/***********************************************************************
+ *      __wine_kmt_vk_open_fd  (win32u.so)
+ *
+ * Stained Glass OS 6261: the fd of the GPU memory behind a resource: a resource handle of this process,
+ * a global share handle, or an NT handle (D3DKMTShareObjects). -1 when it has none. The caller closes it.
+ */
+int __wine_kmt_vk_open_fd( D3DKMT_HANDLE local, UINT global, HANDLE nt_handle, UINT64 *size )
+{
+    struct kmt_object *object;
+    struct kmt_block *block = NULL;
+    int fd = -1;
+
+    TRACE( "local %#x, global %#x, nt_handle %p\n", local, global, nt_handle );
+
+    if (local)
+    {
+        pthread_mutex_lock( &d3dkmt_lock );
+        if ((object = kmt_find( local, KMT_RESOURCE ))) fd = kmt_block_vk_fd( object->block, size );
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return fd;
+    }
+    if (global ? kmt_block_open_global( global, &block ) : kmt_block_open( nt_handle, &block )) return -1;
+    fd = kmt_block_vk_fd( block, size );
+    pthread_mutex_lock( &d3dkmt_lock );
+    kmt_block_unref( block );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return fd;
+}
+
+/***********************************************************************
+ *      __wine_kmt_vk_destroy  (win32u.so)
+ */
+void __wine_kmt_vk_destroy( D3DKMT_HANDLE local )
+{
+    struct kmt_object *object;
+
+    TRACE( "local %#x\n", local );
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if ((object = kmt_find( local, KMT_RESOURCE ))) kmt_resource_free( object );
+    pthread_mutex_unlock( &d3dkmt_lock );
+}
+
 /* ---- keyed mutexes ----
  *
  * The state of a keyed mutex (the key, who owns it, whether its owner is gone) is in the header of its block,
@@ -2085,6 +2329,14 @@ static ULONGLONG kmt_deadline( const LARGE_INTEGER *timeout )
     if (!timeout) return ~(ULONGLONG)0;
     if (timeout->QuadPart < 0) wait = -timeout->QuadPart;
     else if (timeout->QuadPart == 0) return 0;
+#ifndef SG_MUTANT_KMT_DXVK_TIMEOUT
+    /* DXVK computes its timeout as "DWORD milliseconds * -10000" in 32 bits, which leaves a small
+     * positive number: an absolute time in 1601, which would end every wait at once. Such a time is
+     * never meant; read it back as the milliseconds it came from (INFINITE leaves 10000). */
+    else if (timeout->QuadPart == 10000) return ~(ULONGLONG)0;
+    else if (timeout->QuadPart < 0x100000000ll && !((0x100000000ull - timeout->QuadPart) % 10000))
+        wait = 0x100000000ull - timeout->QuadPart;
+#endif
     else
     {
         NtQuerySystemTime( &now );
@@ -2729,3 +2981,95 @@ NTSTATUS WINAPI NtGdiDdDDIWaitForSynchronizationObjectFromCpu( const D3DKMT_WAIT
     pthread_mutex_unlock( &d3dkmt_lock );
     return status;
 }
+
+/***********************************************************************
+ *      __wine_kmt_vk_create_sync  (win32u.so)
+ *
+ * Stained Glass OS 6261: a shared synchronization object (a monitored fence) for an exported timeline
+ * semaphore (winevulkan, VK_KHR_external_semaphore_win32): the semaphore's host fd is kept like the
+ * memory of a resource. DXVK shares the fence of a keyed mutex so.
+ */
+NTSTATUS __wine_kmt_vk_create_sync( int fd, BOOL nt_sharing, D3DKMT_HANDLE *local, UINT *global )
+{
+    struct kmt_sync_info info = { .type = D3DDDI_MONITORED_FENCE };
+    D3DDDI_SYNCHRONIZATIONOBJECT_FLAGS flags = { 0 };
+    struct kmt_object *object;
+    struct kmt_block *block;
+    UINT id = 0;
+    HANDLE file;
+    NTSTATUS status;
+
+    TRACE( "fd %d, nt_sharing %u\n", fd, nt_sharing );
+
+    if (fd < 0 || !local) return STATUS_INVALID_PARAMETER;
+    if ((status = wine_server_fd_to_handle( fd, GENERIC_READ | GENERIC_WRITE, 0, &file ))) return status;
+    flags.Shared = 1;
+    flags.NtSecuritySharing = nt_sharing;
+    info.flags = flags.Value;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if (!(status = kmt_block_create( KMT_SHARE_SYNC, NULL, 0, NULL, 0, 0, NULL, NULL, nt_sharing ? NULL : &id, &block )))
+    {
+        kmt_sync_init_state( block->hdr, &info );
+        block->sem_file = file;
+        file = NULL;
+        block->hdr->sem_pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+        block->hdr->sem_handle = (UINT64)(ULONG_PTR)block->sem_file;
+        if (!(object = kmt_object_new( KMT_SYNC, 0, block ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            object->nt_sharing = nt_sharing;
+            *local = object->handle;
+            if (global) *global = id;
+        }
+        kmt_block_unref( block );
+    }
+    pthread_mutex_unlock( &d3dkmt_lock );
+    if (file) NtClose( file );
+    return status;
+}
+
+/***********************************************************************
+ *      __wine_kmt_vk_open_sync_fd  (win32u.so)
+ *
+ * The fd of the semaphore behind a synchronization object: a sync object handle of this process, a global
+ * share handle, or an NT handle (of the sync object, or of a resource it was shared with). -1 when none.
+ */
+int __wine_kmt_vk_open_sync_fd( D3DKMT_HANDLE local, UINT global, HANDLE nt_handle )
+{
+    struct kmt_object *object;
+    struct kmt_block *block = NULL;
+    int fd = -1;
+
+    TRACE( "local %#x, global %#x, nt_handle %p\n", local, global, nt_handle );
+#ifdef SG_MUTANT_KMT_SYNC_NOFD
+    return -1;
+#endif
+
+    if (local)
+    {
+        pthread_mutex_lock( &d3dkmt_lock );
+        if ((object = kmt_find( local, KMT_SYNC )))
+            fd = kmt_fd_from( object->block->hdr->sem_pid, object->block->hdr->sem_handle );
+        pthread_mutex_unlock( &d3dkmt_lock );
+        return fd;
+    }
+    if (global ? kmt_block_open_global( global, &block ) : kmt_block_open( nt_handle, &block )) return -1;
+    fd = kmt_fd_from( block->hdr->sem_pid, block->hdr->sem_handle );
+    pthread_mutex_lock( &d3dkmt_lock );
+    kmt_block_unref( block );
+    pthread_mutex_unlock( &d3dkmt_lock );
+    return fd;
+}
+
+/***********************************************************************
+ *      __wine_kmt_vk_destroy_sync  (win32u.so)
+ */
+void __wine_kmt_vk_destroy_sync( D3DKMT_HANDLE local )
+{
+    struct kmt_object *object;
+
+    pthread_mutex_lock( &d3dkmt_lock );
+    if ((object = kmt_find( local, KMT_SYNC ))) kmt_object_free( object );
+    pthread_mutex_unlock( &d3dkmt_lock );
+}
diff --git a/dlls/winevulkan/loader_thunks.c b/dlls/winevulkan/loader_thunks.c
index dd997b5..5844f28 100644
--- a/dlls/winevulkan/loader_thunks.c
+++ b/dlls/winevulkan/loader_thunks.c
@@ -5025,6 +5025,31 @@ VkResult WINAPI vkGetMemoryHostPointerPropertiesEXT(VkDevice device, VkExternalM
     return params.result;
 }
 
+VkResult WINAPI vkGetMemoryWin32HandleKHR(VkDevice device, const VkMemoryGetWin32HandleInfoKHR *pGetWin32HandleInfo, HANDLE *pHandle)
+{
+    struct vkGetMemoryWin32HandleKHR_params params;
+    NTSTATUS status;
+    params.device = device;
+    params.pGetWin32HandleInfo = pGetWin32HandleInfo;
+    params.pHandle = pHandle;
+    status = UNIX_CALL(vkGetMemoryWin32HandleKHR, &params);
+    assert(!status && "vkGetMemoryWin32HandleKHR");
+    return params.result;
+}
+
