+    struct wine_device *wdevice = CONTAINING_RECORD(device, struct wine_device, obj);
+    VkSemaphoreCreateInfo info = *create_info;
+    VkExportSemaphoreCreateInfo *export_info = NULL;
+    VkBaseOutStructure *prev, *next, *export_win32_prev = NULL, *export_win32 = NULL;
+    VkExternalSemaphoreHandleTypeFlags asked = 0;
