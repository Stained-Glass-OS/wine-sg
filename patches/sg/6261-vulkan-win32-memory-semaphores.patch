+/* An imported semaphore exports the handles of what it imported: the same D3DKMT synchronization object
+ * (DXVK opens the sync object of a shared texture's fence by the handle it gets back). */
+static void sg_semaphore_imported(struct vulkan_device *device, const VkImportSemaphoreWin32HandleInfoKHR *import_info)
+{
+    struct sg_semaphore *shared;
+    D3DKMT_HANDLE local = 0;
+    UINT global = 0;
+
+    if (import_info->handleType == VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT)
+    {
+        D3DKMT_OPENSYNCHRONIZATIONOBJECT open = { .hSharedHandle = HandleToULong(import_info->handle) };
+        if (NtGdiDdDDIOpenSynchronizationObject(&open)) return;
+        local = open.hSyncObject;
+        global = HandleToULong(import_info->handle);
+    }
+    else
+    {
+        D3DKMT_OPENSYNCOBJECTFROMNTHANDLE open = { .hNtHandle = import_info->handle };
+        if (NtGdiDdDDIOpenSyncObjectFromNtHandle(&open)) return;
+        local = open.hSyncObject;
+    }
+#ifdef SG_MUTANT_SEM_IMPORT_FORGETS
+    __wine_kmt_vk_destroy_sync(local);
+    return;
+#endif
+
+    pthread_mutex_lock(&sg_semaphores_lock);
+    if (!(shared = sg_find_semaphore(device->host.device, import_info->semaphore, NULL)) &&
+        (shared = calloc(1, sizeof(*shared))))
+    {
+        shared->device = device->host.device;
+        shared->semaphore = import_info->semaphore;
+        shared->next = sg_semaphores;
+        sg_semaphores = shared;
+    }
+    if (shared)
+    {
+        if (shared->shared) NtClose(shared->shared);
+        if (shared->kmt_local) __wine_kmt_vk_destroy_sync(shared->kmt_local);
+        shared->shared = NULL;
+        shared->kmt_local = local;
+        shared->kmt_global = global;
+        shared->nt_sharing = !global;
+        local = 0;
+    }
+    pthread_mutex_unlock(&sg_semaphores_lock);
+    if (local) __wine_kmt_vk_destroy_sync(local);
+}
