+            shared->semaphore = *semaphore;
+            shared->nt_sharing = !(asked & VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT);
+            pthread_mutex_lock(&sg_semaphores_lock);
