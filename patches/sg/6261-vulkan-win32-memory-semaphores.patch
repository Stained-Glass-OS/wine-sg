+/* the D3DKMT synchronization object of an exported semaphore, made the first time */
+static VkResult sg_semaphore_export(struct vulkan_device *device, struct sg_semaphore *shared)
+{
+    struct wine_device *wdevice = CONTAINING_RECORD(device, struct wine_device, obj);
+    struct sg_semaphore_get_fd_info get_fd =
+    {
+        .sType = SG_VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR,
+        .semaphore = shared->semaphore,
+        .handleType = SG_HOST_SEMAPHORE_TYPE,
+    };
+    NTSTATUS status;
+    VkResult res;
+    int fd = -1;
+
+    if (shared->kmt_local) return VK_SUCCESS;
+    if ((res = wdevice->p_vkGetSemaphoreFdKHR(device->host.device, &get_fd, &fd)))
+    {
+        WARN("vkGetSemaphoreFdKHR failed: %d\n", res);
+        return res;
+    }
+    status = __wine_kmt_vk_create_sync(fd, shared->nt_sharing, &shared->kmt_local, &shared->kmt_global);
+    close(fd);
+    if (status)
+    {
+        WARN("__wine_kmt_vk_create_sync failed: %#x\n", (int)status);
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+    TRACE("Exported semaphore %s as D3DKMT sync %#x, global %#x\n", wine_dbgstr_longlong(shared->semaphore),
+          shared->kmt_local, shared->kmt_global);
+    return VK_SUCCESS;
+}
