@@ -1453,9 +1453,21 @@ NTSTATUS WINAPI wow64_NtGdiDdDDIShareObjects( UINT *args )
     ULONG *handle_ptr = get_ptr( &args );
 
     struct object_attr64 attr;
+    OBJECT_ATTRIBUTES32 fixed32;
     HANDLE handle = 0;
     NTSTATUS status;
 
+    /* DXVK passes the SECURITY_ATTRIBUTES of CreateSharedHandle as the security descriptor: a descriptor
+     * starts with its revision (1), the 32-bit SECURITY_ATTRIBUTES with its size (12) */
+    if (attr32 && attr32->Length == sizeof(*attr32) && attr32->SecurityDescriptor &&
+        *(const ULONG *)ULongToPtr( attr32->SecurityDescriptor ) == 12)
+    {
+        const ULONG *sa = ULongToPtr( attr32->SecurityDescriptor );
+        fixed32 = *attr32;
+        fixed32.SecurityDescriptor = sa[1];
+        if (sa[2]) fixed32.Attributes |= OBJ_INHERIT;
+        attr32 = &fixed32;
+    }
     *handle_ptr = 0;
     status = NtGdiDdDDIShareObjects( count, handles, objattr_32to64( &attr, attr32 ), access, &handle );
     *handle_ptr = HandleToULong( handle );
