+    pthread_mutex_lock(&sg_semaphores_lock);
+    if ((shared = sg_find_semaphore(device->host.device, semaphore, &prev))) *prev = shared->next;
+    pthread_mutex_unlock(&sg_semaphores_lock);
+    if (shared)
+    {
+        if (shared->shared) NtClose(shared->shared);
+        if (shared->kmt_local) __wine_kmt_vk_destroy_sync(shared->kmt_local);
