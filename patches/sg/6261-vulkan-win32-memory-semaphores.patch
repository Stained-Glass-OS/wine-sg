+VkResult wine_vkGetSemaphoreWin32HandleKHR(VkDevice client_device, const VkSemaphoreGetWin32HandleInfoKHR *handle_info,
+                                           HANDLE *handle)
+{
+    struct vulkan_device *device = vulkan_device_from_handle(client_device);
+    struct sg_semaphore *shared;
+    VkResult res = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    NTSTATUS status;
+
+    TRACE("%p, %p, %p: type %#x\n", client_device, handle_info, handle, handle_info->handleType);
+
+    pthread_mutex_lock(&sg_semaphores_lock);
+    if ((shared = sg_find_semaphore(device->host.device, handle_info->semaphore, NULL)) &&
+        !(res = sg_semaphore_export(device, shared)))
+    {
+        switch (handle_info->handleType)
+        {
+        case VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT:
+            if (!shared->kmt_global) res = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+            else *handle = ULongToHandle(shared->kmt_global);
+            break;
+        case VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT:
+        case VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_D3D12_FENCE_BIT:
+            if (!shared->shared &&
+                (status = NtGdiDdDDIShareObjects(1, &shared->kmt_local, NULL, GENERIC_ALL, &shared->shared)))
+            {
+                WARN("D3DKMTShareObjects failed: %#x\n", (int)status);
+                shared->shared = NULL;
+                res = VK_ERROR_TOO_MANY_OBJECTS;
+            }
+            else if (NtDuplicateObject(NtCurrentProcess(), shared->shared, NtCurrentProcess(), handle, 0, 0,
+                                       DUPLICATE_SAME_ATTRIBUTES | DUPLICATE_SAME_ACCESS))
+                res = VK_ERROR_TOO_MANY_OBJECTS;
+            break;
+        default:
+            FIXME("Handle type %#x is not supported.\n", handle_info->handleType);
+            res = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&sg_semaphores_lock);
+    return res;
+}
