From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netsh: advfirewall and firewall rules, through Stained Glass Firewall

Installers and scripts set up the firewall with netsh: "netsh advfirewall
firewall add rule name=... dir=in action=allow program=... protocol=TCP
localport=...", "advfirewall set allprofiles state off", and on older
installers "netsh firewall add allowedprogram" or "add portopening". netsh
accepted all of it and did nothing, so the rules never existed.

netsh now does them, in Windows' words: advfirewall firewall add, delete
and show rule (name=, dir=, action=, program=, protocol=, localport=,
profile=, enable=, description=; "Ok.", "Deleted N rule(s).", "No rules
match the specified criteria."); advfirewall set and show allprofiles,
currentprofile, domainprofile, privateprofile, publicprofile (state on and
off); advfirewall reset; and the older context's add allowedprogram, add
portopening and set opmode. The rules are INetFwPolicy2's (hnetcfg, 1501),
which keeps them where Windows does and hands them to Stained Glass
Firewall; its state is the firewall's own. A change from a program that is
not elevated: "The requested operation requires elevation (Run as
administrator)."

Test: test/fwnetsh-gate.sh (mutant SG_MUTANT_NETSH_FIREWALL_STUB);
test/netsh-gate.sh's "a command netsh does not know" is http add urlacl now.
---
--- a/programs/netsh/Makefile.in
+++ b/programs/netsh/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = netsh.exe
+IMPORTS   = oleaut32 ole32 uuid
 
 EXTRADLLFLAGS = -mconsole -municode
 
--- a/programs/netsh/netsh.c
+++ b/programs/netsh/netsh.c
@@ -26,15 +26,23 @@
  *   interface ip|ipv4 show config|address|dns [[name=]NAME]
  *   interface show interface
  *   wlan show networks | show profiles | connect name=PROFILE [ssid=SSID] | disconnect
+ *   advfirewall firewall add|delete|show rule ...   (INetFwPolicy2's rules: hnetcfg)
+ *   advfirewall set|show allprofiles|currentprofile|domainprofile|privateprofile|publicprofile [state on|off]
+ *   advfirewall reset
+ *   firewall add allowedprogram ... | add portopening ... | set opmode enable|disable
+ *     -- Stained Glass Firewall's (sg-session's sg-firewall)
  *
  * Adapter names are the ones ipconfig and these show. Anything else is
- * accepted and ignored, as before, so installers that configure a firewall
- * do not fail. */
+ * accepted and ignored, as before, so installers do not fail. */
 
+#define COBJMACROS
 #include <stdio.h>
 #include <windows.h>
+#include <ole2.h>
+#include <netfw.h>
 #include "wine/debug.h"
 #include "wine/sgnetctl.h"
+#include "wine/sgfirewall.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(netsh);
 
@@ -401,6 +409,417 @@
 
 static BOOL is( const WCHAR *arg, const WCHAR *word ) { return arg && !wcsicmp( arg, word ); }
 
+/* ---- the firewall: advfirewall, and the older "firewall" context ---------- */
+/* Stained Glass OS: the rules are INetFwPolicy2's (hnetcfg), which keeps
+ * them where Windows does and hands them to Stained Glass Firewall; the
+ * firewall's state is the firewall's own (wine/sgfirewall.h). */
+
+/* key=value arguments, by name (no positions) */
+static const WCHAR *named( int argc, WCHAR **argv, const WCHAR *key )
+{
+    size_t kl = wcslen( key );
+    int i;
+    for (i = 0; i < argc; i++)
+        if (!wcsnicmp( argv[i], key, kl ) && argv[i][kl] == '=') return argv[i] + kl + 1;
+    return NULL;
+}
+
+static BOOL fw_policy( INetFwPolicy2 **policy )
+{
+    if (FAILED(CoInitializeEx( NULL, COINIT_APARTMENTTHREADED ))) return FALSE;
+    return SUCCEEDED(CoCreateInstance( &CLSID_NetFwPolicy2, NULL, CLSCTX_INPROC_SERVER, &IID_INetFwPolicy2,
+                                       (void **)policy ));
+}
+
+static int fw_denied(void)
+{
+    wprintf( L"The requested operation requires elevation (Run as administrator).\n\n" );
+    return 1;
+}
+
+static LONG fw_protocol( const WCHAR *v )
+{
+    if (!v || !wcsicmp( v, L"any" )) return 256;
+    if (!wcsicmp( v, L"tcp" )) return 6;
+    if (!wcsicmp( v, L"udp" )) return 17;
+    if (!wcsicmp( v, L"icmpv4" )) return 1;
+    if (!wcsicmp( v, L"icmpv6" )) return 58;
+    return wcstol( v, NULL, 10 );
+}
+
+static LONG fw_profiles( const WCHAR *v )
+{
+    LONG bits = 0;
+    if (!v || !wcsicmp( v, L"any" ) || !wcsicmp( v, L"all" )) return NET_FW_PROFILE2_ALL;
+    if (wcsstr( v, L"domain" ) || wcsstr( v, L"Domain" )) bits |= NET_FW_PROFILE2_DOMAIN;
+    if (wcsstr( v, L"private" ) || wcsstr( v, L"Private" )) bits |= NET_FW_PROFILE2_PRIVATE;
+    if (wcsstr( v, L"public" ) || wcsstr( v, L"Public" )) bits |= NET_FW_PROFILE2_PUBLIC;
+    return bits ? bits : -1;
+}
+
+static void put_str( INetFwRule *rule, HRESULT (STDMETHODCALLTYPE *put)(INetFwRule *, BSTR), const WCHAR *v )
+{
+    BSTR b;
+    if (!v) return;
+    b = SysAllocString( v );
+    put( rule, b );
+    SysFreeString( b );
+}
+
+static HRESULT add_rule( const WCHAR *name, const WCHAR *dir, const WCHAR *action, const WCHAR *program,
+                         LONG protocol, const WCHAR *ports, LONG profiles, BOOL enabled, const WCHAR *desc )
+{
+    INetFwPolicy2 *policy;
+    INetFwRules *rules;
+    INetFwRule *rule;
+    HRESULT hr;
+
+    if (!fw_policy( &policy )) return E_FAIL;
+    if (FAILED(hr = INetFwPolicy2_get_Rules( policy, &rules ))) { INetFwPolicy2_Release( policy ); return hr; }
+    if (SUCCEEDED(hr = CoCreateInstance( &CLSID_NetFwRule, NULL, CLSCTX_INPROC_SERVER, &IID_INetFwRule, (void **)&rule )))
+    {
+        put_str( rule, rule->lpVtbl->put_Name, name );
+        put_str( rule, rule->lpVtbl->put_Description, desc );
+        put_str( rule, rule->lpVtbl->put_ApplicationName, program );
+        INetFwRule_put_Protocol( rule, protocol );
+        if (ports && wcsicmp( ports, L"any" )) put_str( rule, rule->lpVtbl->put_LocalPorts, ports );
+        INetFwRule_put_Direction( rule, dir && !wcsicmp( dir, L"out" ) ? NET_FW_RULE_DIR_OUT : NET_FW_RULE_DIR_IN );
+        INetFwRule_put_Action( rule, !wcsicmp( action, L"block" ) ? NET_FW_ACTION_BLOCK : NET_FW_ACTION_ALLOW );
+        INetFwRule_put_Profiles( rule, profiles );
+        INetFwRule_put_Enabled( rule, enabled ? VARIANT_TRUE : VARIANT_FALSE );
+        hr = INetFwRules_Add( rules, rule );
+        INetFwRule_Release( rule );
+    }
+    INetFwRules_Release( rules );
+    INetFwPolicy2_Release( policy );
+    return hr;
+}
+
+static int fw_add_rule( int argc, WCHAR **argv )
+{
+    const WCHAR *name = named( argc, argv, L"name" ), *dir = named( argc, argv, L"dir" ),
+                *action = named( argc, argv, L"action" ), *enable = named( argc, argv, L"enable" );
+    LONG profiles = fw_profiles( named( argc, argv, L"profile" ) );
+    HRESULT hr;
+
+    if (!name || !dir || !action || (wcsicmp( dir, L"in" ) && wcsicmp( dir, L"out" )) ||
+        (wcsicmp( action, L"allow" ) && wcsicmp( action, L"block" ) && wcsicmp( action, L"bypass" )) || profiles < 0)
+    {
+        wprintf( L"\nUsage: add rule name=<string>\n      dir=in|out\n      action=allow|block|bypass\n"
+                 L"      [program=<program path>]\n      [profile=public|private|domain|any[,...]]\n"
+                 L"      [protocol=0-255|icmpv4|icmpv6|tcp|udp|any]\n      [localport=0-65535|<port range>[,...]|any]\n"
+                 L"      [enable=yes|no (default=yes)]\n\n" );
+        return 1;
+    }
+    hr = add_rule( name, dir, action, named( argc, argv, L"program" ), fw_protocol( named( argc, argv, L"protocol" ) ),
+                   named( argc, argv, L"localport" ), profiles, !enable || wcsicmp( enable, L"no" ),
+                   named( argc, argv, L"description" ) );
+    if (hr == E_ACCESSDENIED) return fw_denied();
+    if (FAILED(hr)) { wprintf( L"An error occurred (0x%08lx).\n\n", hr ); return 1; }
+    wprintf( L"Ok.\n\n" );
+    return 0;
+}
+
+/* each stored rule in turn: fn returns TRUE to stop */
+static int fw_each( BOOL (*fn)( INetFwRules *, INetFwRule *, void * ), void *ctx )
+{
+    INetFwPolicy2 *policy;
+    INetFwRules *rules;
+    IUnknown *unk;
+    IEnumVARIANT *e;
+    VARIANT v;
+    int n = 0;
+
+    if (!fw_policy( &policy )) return -1;
+    if (SUCCEEDED(INetFwPolicy2_get_Rules( policy, &rules )))
+    {
+        if (SUCCEEDED(INetFwRules_get__NewEnum( rules, &unk )))
+        {
+            if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_IEnumVARIANT, (void **)&e )))
+            {
+                VariantInit( &v );
+                while (IEnumVARIANT_Next( e, 1, &v, NULL ) == S_OK)
+                {
+                    INetFwRule *rule;
+                    BOOL stop = FALSE;
+                    if (V_VT( &v ) == VT_DISPATCH &&
+                        SUCCEEDED(IDispatch_QueryInterface( V_DISPATCH( &v ), &IID_INetFwRule, (void **)&rule )))
+                    {
+                        n++;
+                        stop = fn( rules, rule, ctx );
+                        INetFwRule_Release( rule );
+                    }
+                    VariantClear( &v );
+                    if (stop) break;
+                }
+                IEnumVARIANT_Release( e );
+            }
+            IUnknown_Release( unk );
+        }
+        INetFwRules_Release( rules );
+    }
+    INetFwPolicy2_Release( policy );
+    return n;
+}
+
+struct fw_match { const WCHAR *name, *program, *dir; int found; BSTR names[256]; };
+
+static BOOL fw_matches( INetFwRule *rule, const struct fw_match *m )
+{
+    BSTR name = NULL, app = NULL;
+    NET_FW_RULE_DIRECTION dir = NET_FW_RULE_DIR_IN;
+    BOOL ok;
+    INetFwRule_get_Name( rule, &name );
+    INetFwRule_get_ApplicationName( rule, &app );
+    INetFwRule_get_Direction( rule, &dir );
+    ok = (!wcsicmp( m->name, L"all" ) || (name && !wcsicmp( name, m->name ))) &&
+         (!m->program || (app && !wcsicmp( app, m->program ))) &&
+         (!m->dir || (dir == NET_FW_RULE_DIR_OUT) == !wcsicmp( m->dir, L"out" ));
+    SysFreeString( name );
+    SysFreeString( app );
+    return ok;
+}
+
+static BOOL fw_collect( INetFwRules *rules, INetFwRule *rule, void *ctx )
+{
+    struct fw_match *m = ctx;
+    if (fw_matches( rule, m ) && m->found < (int)ARRAY_SIZE(m->names)) INetFwRule_get_Name( rule, &m->names[m->found++] );
+    return FALSE;
+}
+
+static int fw_delete_rule( int argc, WCHAR **argv )
+{
+    struct fw_match m = { named( argc, argv, L"name" ), named( argc, argv, L"program" ), named( argc, argv, L"dir" ) };
+    INetFwPolicy2 *policy;
+    INetFwRules *rules;
+    HRESULT hr = S_OK;
+    int i, j;
+
+    if (!m.name) { wprintf( L"\nUsage: delete rule name=<string>\n      [dir=in|out]\n      [program=<program path>]\n\n" ); return 1; }
+    if (fw_each( fw_collect, &m ) < 0 || !fw_policy( &policy )) { wprintf( L"An error occurred.\n\n" ); return 1; }
+    if (!m.found)
+    {
+        INetFwPolicy2_Release( policy );
+        wprintf( L"\nNo rules match the specified criteria.\n\n" );
+        return 1;
+    }
+    if (SUCCEEDED(INetFwPolicy2_get_Rules( policy, &rules )))
+    {
+        for (i = 0; i < m.found; i++)
+        {
+            for (j = 0; j < i; j++) if (!wcsicmp( m.names[j], m.names[i] )) break;
+            if (j == i && FAILED(hr = INetFwRules_Remove( rules, m.names[i] ))) break;
+        }
+        INetFwRules_Release( rules );
+    }
+    INetFwPolicy2_Release( policy );
+    for (i = 0; i < m.found; i++) SysFreeString( m.names[i] );
+    if (hr == E_ACCESSDENIED) return fw_denied();
+    wprintf( L"\nDeleted %d rule(s).\nOk.\n\n", m.found );
+    return 0;
+}
+
+static BOOL fw_print( INetFwRules *rules, INetFwRule *rule, void *ctx )
+{
+    struct fw_match *m = ctx;
+    BSTR name = NULL, app = NULL, ports = NULL, group = NULL;
+    LONG proto = 256, profiles = NET_FW_PROFILE2_ALL;
+    NET_FW_RULE_DIRECTION dir = NET_FW_RULE_DIR_IN;
+    NET_FW_ACTION action = NET_FW_ACTION_ALLOW;
+    VARIANT_BOOL enabled = VARIANT_TRUE;
+    WCHAR prof[64] = L"", protocol[16];
+
+    if (!fw_matches( rule, m )) return FALSE;
+    m->found++;
+    INetFwRule_get_Name( rule, &name );
+    INetFwRule_get_ApplicationName( rule, &app );
+    INetFwRule_get_LocalPorts( rule, &ports );
+    INetFwRule_get_Grouping( rule, &group );
+    INetFwRule_get_Protocol( rule, &proto );
+    INetFwRule_get_Profiles( rule, &profiles );
+    INetFwRule_get_Direction( rule, &dir );
+    INetFwRule_get_Action( rule, &action );
+    INetFwRule_get_Enabled( rule, &enabled );
+    if ((profiles & NET_FW_PROFILE2_ALL) == NET_FW_PROFILE2_ALL || (profiles & 7) == 7) lstrcpyW( prof, L"Domain,Private,Public" );
+    else
+    {
+        if (profiles & NET_FW_PROFILE2_DOMAIN) lstrcatW( prof, L"Domain," );
+        if (profiles & NET_FW_PROFILE2_PRIVATE) lstrcatW( prof, L"Private," );
+        if (profiles & NET_FW_PROFILE2_PUBLIC) lstrcatW( prof, L"Public," );
+        if (prof[0]) prof[wcslen( prof ) - 1] = 0;
+    }
+    if (proto == 6) lstrcpyW( protocol, L"TCP" );
+    else if (proto == 17) lstrcpyW( protocol, L"UDP" );
+    else if (proto == 256) lstrcpyW( protocol, L"Any" );
+    else swprintf( protocol, ARRAY_SIZE(protocol), L"%ld", proto );
+    wprintf( L"\nRule Name:                            %ls\n"
+             L"----------------------------------------------------------------------\n"
+             L"Enabled:                              %ls\n"
+             L"Direction:                            %ls\n"
+             L"Profiles:                             %ls\n"
+             L"Grouping:                             %ls\n"
+             L"LocalIP:                              Any\n"
+             L"RemoteIP:                             Any\n"
+             L"Protocol:                             %ls\n",
+             name ? name : L"", enabled ? L"Yes" : L"No", dir == NET_FW_RULE_DIR_OUT ? L"Out" : L"In", prof,
+             group ? group : L"", protocol );
+    if (proto == 6 || proto == 17)
+        wprintf( L"LocalPort:                            %ls\nRemotePort:                           Any\n",
+                 ports && *ports ? ports : L"Any" );
+    if (m->program && app) wprintf( L"Program:                              %ls\n", app );
+    wprintf( L"Edge traversal:                       No\nAction:                               %ls\n",
+             action == NET_FW_ACTION_BLOCK ? L"Block" : L"Allow" );
+    SysFreeString( name ); SysFreeString( app ); SysFreeString( ports ); SysFreeString( group );
+    return FALSE;
+}
+
+static int fw_show_rule( int argc, WCHAR **argv )
+{
+    struct fw_match m = { named( argc, argv, L"name" ), NULL, named( argc, argv, L"dir" ) };
+    const WCHAR *verbose = NULL;
+    int i;
+    for (i = 0; i < argc; i++) if (!wcsicmp( argv[i], L"verbose" )) verbose = argv[i];
+    if (!m.name) { wprintf( L"\nUsage: show rule name=all|<string>\n      [dir=in|out]\n      [verbose]\n\n" ); return 1; }
+    m.program = verbose ? L"" : NULL;
+    if (verbose) m.program = NULL;
+    if (fw_each( fw_print, &m ) < 0) { wprintf( L"An error occurred.\n\n" ); return 1; }
+    if (!m.found) { wprintf( L"No rules match the specified criteria.\n\n" ); return 1; }
+    wprintf( L"Ok.\n\n" );
+    return 0;
+}
+
+/* allprofiles, currentprofile, domainprofile, privateprofile, publicprofile */
+static LONG fw_profile_arg( const WCHAR *v )
+{
+    if (!v) return -1;
+    if (!wcsicmp( v, L"allprofiles" )) return NET_FW_PROFILE2_ALL;
+    if (!wcsicmp( v, L"domainprofile" )) return NET_FW_PROFILE2_DOMAIN;
+    if (!wcsicmp( v, L"privateprofile" )) return NET_FW_PROFILE2_PRIVATE;
+    if (!wcsicmp( v, L"publicprofile" )) return NET_FW_PROFILE2_PUBLIC;
+    if (!wcsicmp( v, L"currentprofile" )) return 0;
+    return -1;
+}
+
+static int fw_set_state( LONG which, BOOL on )
+{
+    INetFwPolicy2 *policy;
+    HRESULT hr = S_OK;
+    LONG bits, current = NET_FW_PROFILE2_PRIVATE;
+    if (!fw_policy( &policy )) { wprintf( L"An error occurred.\n\n" ); return 1; }
+    if (which == 0) INetFwPolicy2_get_CurrentProfileTypes( policy, &current );
+    bits = which == 0 ? current : which;
+    if (bits == NET_FW_PROFILE2_ALL) hr = INetFwPolicy2_put_FirewallEnabled( policy, NET_FW_PROFILE2_ALL, on );
+    else
+    {
+        if (SUCCEEDED(hr) && (bits & NET_FW_PROFILE2_DOMAIN)) hr = INetFwPolicy2_put_FirewallEnabled( policy, NET_FW_PROFILE2_DOMAIN, on );
+        if (SUCCEEDED(hr) && (bits & NET_FW_PROFILE2_PRIVATE)) hr = INetFwPolicy2_put_FirewallEnabled( policy, NET_FW_PROFILE2_PRIVATE, on );
+        if (SUCCEEDED(hr) && (bits & NET_FW_PROFILE2_PUBLIC)) hr = INetFwPolicy2_put_FirewallEnabled( policy, NET_FW_PROFILE2_PUBLIC, on );
+    }
+    INetFwPolicy2_Release( policy );
+    if (hr == E_ACCESSDENIED) return fw_denied();
+    if (FAILED(hr)) { wprintf( L"An error occurred (0x%08lx).\n\n", hr ); return 1; }
+    wprintf( L"Ok.\n\n" );
+    return 0;
+}
+
+static int fw_show_profiles( LONG which )
+{
+    static const struct { LONG bit; const WCHAR *title; } kinds[] = {
+        { NET_FW_PROFILE2_DOMAIN, L"Domain" }, { NET_FW_PROFILE2_PRIVATE, L"Private" }, { NET_FW_PROFILE2_PUBLIC, L"Public" } };
+    INetFwPolicy2 *policy;
+    LONG current = NET_FW_PROFILE2_PRIVATE;
+    VARIANT_BOOL on;
+    int i;
+    if (!fw_policy( &policy )) { wprintf( L"An error occurred.\n\n" ); return 1; }
+    INetFwPolicy2_get_CurrentProfileTypes( policy, &current );
+    for (i = 0; i < ARRAY_SIZE(kinds); i++)
+    {
+        if (which == 0 ? !(current & kinds[i].bit) : !(which & kinds[i].bit)) continue;
+        on = VARIANT_TRUE;
+        INetFwPolicy2_get_FirewallEnabled( policy, kinds[i].bit, &on );
+        wprintf( L"\n%ls Profile Settings: \n----------------------------------------------------------------------\n"
+                 L"State                                 %ls\n"
+                 L"Firewall Policy                       BlockInbound,AllowOutbound\n"
+                 L"LocalFirewallRules                    N/A (GPO-store only)\n"
+                 L"InboundUserNotification               Enable\n",
+                 kinds[i].title, on ? L"ON" : L"OFF" );
+    }
+    INetFwPolicy2_Release( policy );
+    wprintf( L"Ok.\n\n" );
+    return 0;
+}
+
+static int advfirewall( int argc, WCHAR **argv )
+{
+    if (argc >= 3 && is( argv[0], L"firewall" ) && is( argv[2], L"rule" ))
+    {
+        if (is( argv[1], L"add" )) return fw_add_rule( argc - 3, argv + 3 );
+        if (is( argv[1], L"delete" )) return fw_delete_rule( argc - 3, argv + 3 );
+        if (is( argv[1], L"show" )) return fw_show_rule( argc - 3, argv + 3 );
+    }
+    if (argc >= 4 && is( argv[0], L"set" ) && fw_profile_arg( argv[1] ) >= 0 && is( argv[2], L"state" ))
+    {
+        if (is( argv[3], L"on" ) || is( argv[3], L"off" )) return fw_set_state( fw_profile_arg( argv[1] ), is( argv[3], L"on" ) );
+    }
+    if (argc >= 2 && is( argv[0], L"show" ) && fw_profile_arg( argv[1] ) >= 0) return fw_show_profiles( fw_profile_arg( argv[1] ) );
+    if (argc >= 1 && is( argv[0], L"reset" ))
+    {
+        const WCHAR *fields[] = { L"firewall", L"reset" };
+        DWORD err = sgfw_admin_request( fields, 2, 30000, NULL, 0 );
+        if (err == ERROR_PRIVILEGE_NOT_HELD) return fw_denied();
+        if (err) { wprintf( L"An error occurred (%lu).\n\n", err ); return 1; }
+        wprintf( L"Ok.\n\n" );
+        return 0;
+    }
+    return -1;
+}
+
+/* the older context: "netsh firewall add allowedprogram|portopening", "set opmode" */
+static int old_firewall( int argc, WCHAR **argv )
+{
+    static const WCHAR deprecated[] =
+        L"\nIMPORTANT: Command executed successfully.\n"
+        L"However, \"netsh firewall\" is deprecated;\n"
+        L"use \"netsh advfirewall firewall\" instead.\n\n";
+    if (argc >= 2 && is( argv[0], L"add" ) && is( argv[1], L"allowedprogram" ))
+    {
+        static const WCHAR *const slots[] = { L"program", L"name", L"mode", L"scope", L"profile" };
+        struct params p;
+        HRESULT hr;
+        parse_params( argc - 2, argv + 2, slots, ARRAY_SIZE(slots), &p );
+        if (!param( &p, 0 )) { wprintf( L"\nUsage: add allowedprogram program=<path> name=<name> [mode=ENABLE|DISABLE]\n\n" ); return 1; }
+        hr = add_rule( param( &p, 1 ) ? param( &p, 1 ) : param( &p, 0 ), L"in", L"allow", param( &p, 0 ), 256, NULL,
+                       NET_FW_PROFILE2_ALL, !param( &p, 2 ) || wcsicmp( param( &p, 2 ), L"DISABLE" ), NULL );
+        if (hr == E_ACCESSDENIED) return fw_denied();
+        if (FAILED(hr)) { wprintf( L"An error occurred (0x%08lx).\n\n", hr ); return 1; }
+        wprintf( deprecated );
+        wprintf( L"Ok.\n\n" );
+        return 0;
+    }
+    if (argc >= 2 && is( argv[0], L"add" ) && is( argv[1], L"portopening" ))
+    {
+        static const WCHAR *const slots[] = { L"protocol", L"port", L"name", L"mode", L"scope", L"profile" };
+        struct params p;
+        HRESULT hr;
+        parse_params( argc - 2, argv + 2, slots, ARRAY_SIZE(slots), &p );
