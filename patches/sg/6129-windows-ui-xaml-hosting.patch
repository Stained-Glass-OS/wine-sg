diff --git a/dlls/windows.ui.xaml/application.c b/dlls/windows.ui.xaml/application.c
new file mode 100644
index 0000000..af72b1f
--- /dev/null
+++ b/dlls/windows.ui.xaml/application.c
@@ -0,0 +1,316 @@
+/*
+ * Windows.UI.Xaml.Application
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * The application object.  It is composable: an application's App class aggregates it (the
+ * factory's CreateInstance with the App as the outer object) and overrides its methods through
+ * IApplicationOverrides on the outer object.  One per process; Application.Current is it.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+DEFINE_GUID(IID_IApplication,         0x74b861a1, 0x7487, 0x46a9, 0x9a, 0x6e, 0xc7, 0x8b, 0x51, 0x27, 0x26, 0xc5);
+DEFINE_GUID(IID_IApplication2,        0x019104be, 0x522a, 0x5904, 0xf5, 0x2f, 0xde, 0x72, 0x01, 0x04, 0x29, 0xe0);
+DEFINE_GUID(IID_IApplication3,        0xb775ad7c, 0x18b8, 0x45ca, 0xa1, 0xb0, 0xdc, 0x48, 0x3e, 0x4b, 0x10, 0x28);
+DEFINE_GUID(IID_IApplicationFactory,  0x93bbe361, 0xbe5a, 0x4ee3, 0xb4, 0xa3, 0x95, 0x11, 0x8d, 0xc9, 0x7a, 0x89);
+DEFINE_GUID(IID_IApplicationStatics,  0x06499997, 0xf7b4, 0x45fe, 0xb7, 0x63, 0x75, 0x77, 0xd1, 0xd3, 0xcb, 0x4a);
+
+/* ApplicationTheme */
+#define APPLICATION_THEME_LIGHT 0
+#define APPLICATION_THEME_DARK  1
+
+struct application
+{
+    struct xobj obj;
+    struct xiface IApplication_iface;
+    struct xiface IApplication2_iface;
+    struct xiface IApplication3_iface;
+    IInspectable *resources;            /* a ResourceDictionary */
+    INT32 requested_theme;
+    INT32 focus_visual_kind;
+    boolean requires_pointer_mode;
+    INT32 high_contrast_adjustment;
+    struct handler_list unhandled_exception, suspending, resuming, leaving_background, entered_background;
+};
+
+static struct application *current_app;
+static CRITICAL_SECTION app_cs;
+static CRITICAL_SECTION_DEBUG app_cs_debug =
+{
+    0, 0, &app_cs,
+    { &app_cs_debug.ProcessLocksList, &app_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": app_cs") }
+};
+static CRITICAL_SECTION app_cs = { &app_cs_debug, -1, 0, 0, 0, 0 };
+
+static const struct xiface_entry app_ifaces[] =
+{
+    { &IID_IApplication, offsetof(struct application, IApplication_iface) },
+    { &IID_IApplication2, offsetof(struct application, IApplication2_iface) },
+    { &IID_IApplication3, offsetof(struct application, IApplication3_iface) },
+};
+
+static struct application *app_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct application, obj );
+}
+
+static void app_destroy( struct xobj *obj )
+{
+    struct application *app = CONTAINING_RECORD( obj, struct application, obj );
+
+    EnterCriticalSection( &app_cs );
+    if (current_app == app) current_app = NULL;
+    LeaveCriticalSection( &app_cs );
+    if (app->resources) IInspectable_Release( app->resources );
+    handlers_clear( &app->unhandled_exception );
+    handlers_clear( &app->suspending );
+    handlers_clear( &app->resuming );
+    handlers_clear( &app->leaving_background );
+    handlers_clear( &app->entered_background );
+}
+
+static const struct xclass app_class =
+{
+    L"Windows.UI.Xaml.Application", app_ifaces, ARRAY_SIZE(app_ifaces), app_destroy,
+};
+
+/* the theme the system asks for: AppsUseLightTheme, as Settings writes it */
+static INT32 system_app_theme(void)
+{
+    DWORD value = 1, size = sizeof(value);
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                  L"AppsUseLightTheme", RRF_RT_REG_DWORD, NULL, &value, &size );
+    return value ? APPLICATION_THEME_LIGHT : APPLICATION_THEME_DARK;
+}
+
+static HRESULT WINAPI app_get_Resources( struct xiface *iface, IInspectable **value )
+{
+    struct application *app = app_from_iface( iface );
+
+    TRACE( "%p, %p\n", app, value );
+    if (!value) return E_POINTER;
+    if ((*value = app->resources)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI app_put_Resources( struct xiface *iface, IInspectable *value )
+{
+    struct application *app = app_from_iface( iface );
+
+    TRACE( "%p, %p\n", app, value );
+    if (value) IInspectable_AddRef( value );
+    if (app->resources) IInspectable_Release( app->resources );
+    app->resources = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_get_DebugSettings( struct xiface *iface, IInspectable **value )
+{
+    FIXME( "%p, %p stub!\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI app_get_RequestedTheme( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = app_from_iface( iface )->requested_theme;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_put_RequestedTheme( struct xiface *iface, INT32 value )
+{
+    TRACE( "%p, %d\n", iface, value );
+    app_from_iface( iface )->requested_theme = value;
+    return S_OK;
+}
+
+#define EVENT_METHODS(name, field) \
+static HRESULT WINAPI app_add_##name( struct xiface *iface, IUnknown *handler, INT64 *token ) \
+{ return handlers_add( &app_from_iface( iface )->field, handler, token ); } \
+static HRESULT WINAPI app_remove_##name( struct xiface *iface, INT64 token ) \
+{ return handlers_remove( &app_from_iface( iface )->field, token ); }
+
+EVENT_METHODS(UnhandledException, unhandled_exception)
+EVENT_METHODS(Suspending, suspending)
+EVENT_METHODS(Resuming, resuming)
+EVENT_METHODS(LeavingBackground, leaving_background)
+EVENT_METHODS(EnteredBackground, entered_background)
+
+static HRESULT WINAPI app_Exit( struct xiface *iface )
+{
+    TRACE( "%p\n", iface );
+    PostQuitMessage( 0 );
+    return S_OK;
+}
+
+static const void *app_vtbl[] =
+{
+    XIFACE_COMMON,
+    app_get_Resources, app_put_Resources, app_get_DebugSettings, app_get_RequestedTheme, app_put_RequestedTheme,
+    app_add_UnhandledException, app_remove_UnhandledException, app_add_Suspending, app_remove_Suspending,
+    app_add_Resuming, app_remove_Resuming, app_Exit,
+};
+
+static HRESULT WINAPI app2_get_FocusVisualKind( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = app_from_iface( iface )->focus_visual_kind;
+    return S_OK;
+}
+
+static HRESULT WINAPI app2_put_FocusVisualKind( struct xiface *iface, INT32 value )
+{
+    app_from_iface( iface )->focus_visual_kind = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI app2_get_RequiresPointerMode( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = app_from_iface( iface )->requires_pointer_mode;
+    return S_OK;
+}
+
+static HRESULT WINAPI app2_put_RequiresPointerMode( struct xiface *iface, INT32 value )
+{
+    app_from_iface( iface )->requires_pointer_mode = value;
+    return S_OK;
+}
+
+static const void *app2_vtbl[] =
+{
+    XIFACE_COMMON,
+    app2_get_FocusVisualKind, app2_put_FocusVisualKind, app2_get_RequiresPointerMode, app2_put_RequiresPointerMode,
+    app_add_LeavingBackground, app_remove_LeavingBackground, app_add_EnteredBackground, app_remove_EnteredBackground,
+};
+
+static HRESULT WINAPI app3_get_HighContrastAdjustment( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = app_from_iface( iface )->high_contrast_adjustment;
+    return S_OK;
+}
+
+static HRESULT WINAPI app3_put_HighContrastAdjustment( struct xiface *iface, INT32 value )
+{
+    app_from_iface( iface )->high_contrast_adjustment = value;
+    return S_OK;
+}
+
+static const void *app3_vtbl[] = { XIFACE_COMMON, app3_get_HighContrastAdjustment, app3_put_HighContrastAdjustment };
+
+static HRESULT WINAPI app_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner,
+                                                  void **value )
+{
+    struct application *app;
+
+    TRACE( "%p, %p, %p\n", outer, inner, value );
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(app = calloc( 1, sizeof(*app) ))) return E_OUTOFMEMORY;
+    app->IApplication_iface.vtbl = app_vtbl;
+    app->IApplication2_iface.vtbl = app2_vtbl;
+    app->IApplication3_iface.vtbl = app3_vtbl;
+    app->requested_theme = system_app_theme();
+    handlers_init( &app->unhandled_exception );
+    handlers_init( &app->suspending );
+    handlers_init( &app->resuming );
+    handlers_init( &app->leaving_background );
+    handlers_init( &app->entered_background );
+#ifdef SG_MUTANT_XAML_APP_NOT_AGGREGATED
+    xobj_init( &app->obj, &app_class, NULL );
+#else
+    xobj_init( &app->obj, &app_class, outer );
+#endif
+
+    EnterCriticalSection( &app_cs );
+    if (current_app) WARN( "a second application; Application.Current is the new one\n" );
+    current_app = app;
+    LeaveCriticalSection( &app_cs );
+
+    if (outer)
+    {
+        *inner = &app->obj.IInspectable_inner;
+        IUnknown_AddRef( app->obj.outer );
+    }
+    *value = &app->IApplication_iface;
+    return S_OK;
+}
+
+static const void *app_factory_vtbl[] = { XFIFACE_COMMON, app_factory_CreateInstance };
+
+static HRESULT WINAPI app_statics_get_Current( struct xfiface *iface, void **value )
+{
+    HRESULT hr = S_OK;
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &app_cs );
+    if (current_app) hr = IUnknown_QueryInterface( current_app->obj.outer, &IID_IApplication, value );
+    else *value = NULL;
+    LeaveCriticalSection( &app_cs );
+    return hr;
+}
+
+static HRESULT WINAPI app_statics_Start( struct xfiface *iface, IUnknown *callback )
+{
+    FIXME( "%p, %p stub!\n", iface, callback );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI app_statics_LoadComponent( struct xfiface *iface, IInspectable *component, IInspectable *locator )
+{
+    FIXME( "%p, %p, %p: markup not loaded yet\n", iface, component, locator );
+    return S_OK;
+}
+
+static HRESULT WINAPI app_statics_LoadComponentWithResourceLocation( struct xfiface *iface, IInspectable *component,
+                                                                    IInspectable *locator, INT32 location )
+{
+    return app_statics_LoadComponent( iface, component, locator );
+}
+
+static const void *app_statics_vtbl[] =
+{
+    XFIFACE_COMMON,
+    app_statics_get_Current, app_statics_Start, app_statics_LoadComponent, app_statics_LoadComponentWithResourceLocation,
+};
+
+static HRESULT app_activate( IInspectable **instance )
+{
+    IInspectable *inner;
+    return app_factory_CreateInstance( NULL, NULL, &inner, (void **)instance );
+}
+
+static struct xfactory app_factory =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Application",
+    { &IID_IApplicationFactory, &IID_IApplicationStatics },
+    { { app_factory_vtbl }, { app_statics_vtbl } },
+    app_activate,
+};
+
+IActivationFactory *application_factory = &app_factory.IActivationFactory_iface;
