+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS: a desktop thread that initialises XAML (WindowsXamlManager, our
+ * windows.ui.xaml) gets a CoreWindow over a hidden window, as Windows gives it one; programs reach
+ * its window through ICoreWindowInterop (Mile.Xaml -- NanaZip -- hides it).  windows.ui.xaml makes
+ * it with SgCoreWindowForThread; CoreWindow.GetForCurrentThread returns it.
+ *
+ * ICoreWindowInterop: IID and methods per windows-rs (MIT), Windows.Win32.System.WinRT.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "initguid.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+DEFINE_GUID(IID_ICoreWindowInterop_sg, 0x45d64a29, 0xa63e, 0x4cb6, 0xb4, 0x98, 0x57, 0x81, 0xd2, 0x98, 0xcb, 0x4f);
+
+struct thread_corewindow
+{
+    __x_ABI_CWindows_CUI_CCore_CICoreWindow ICoreWindow_iface;
+    IUnknown ICoreWindowInterop_iface;
+    LONG ref;
+    HWND hwnd;
+    DWORD thread;
+    INT64 next_token;
+};
+
+static DWORD corewindow_tls = TLS_OUT_OF_INDEXES;
+
+static struct thread_corewindow *impl_from_ICoreWindow( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface )
+{
+    return CONTAINING_RECORD( iface, struct thread_corewindow, ICoreWindow_iface );
+}
+
+static struct thread_corewindow *impl_from_interop( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct thread_corewindow, ICoreWindowInterop_iface );
+}
+
+static HRESULT WINAPI cw_QueryInterface( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, REFIID iid, void **out )
+{
+    struct thread_corewindow *impl = impl_from_ICoreWindow( iface );
+
+    if (!out) return E_POINTER;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID___x_ABI_CWindows_CUI_CCore_CICoreWindow ))
+    {
+        *out = &impl->ICoreWindow_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_ICoreWindowInterop_sg ))
+    {
+        *out = &impl->ICoreWindowInterop_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cw_AddRef( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface )
+{
+    return InterlockedIncrement( &impl_from_ICoreWindow( iface )->ref );
+}
+
+static ULONG WINAPI cw_Release( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface )
+{
+    /* the thread keeps it for its life */
+    return InterlockedDecrement( &impl_from_ICoreWindow( iface )->ref );
+}
+
+static HRESULT WINAPI cw_GetIids( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, ULONG *count, IID **iids )
+{
+    FIXME( "%p, %p, %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cw_GetRuntimeClassName( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, HSTRING *name )
+{
+    return inspectable_name( RuntimeClass_Windows_UI_Core_CoreWindow, name );
+}
+
+static HRESULT WINAPI cw_GetTrustLevel( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* methods not implemented, by the size of their arguments (stdcall on i386) */
+static HRESULT WINAPI cw_notimpl_1( void *iface, void *a ) { FIXME( "%p: not implemented\n", iface ); return E_NOTIMPL; }
+
+static HRESULT WINAPI cw_get_Bounds( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, __x_ABI_CWindows_CFoundation_CRect *rect )
+{
+    struct thread_corewindow *impl = impl_from_ICoreWindow( iface );
+    RECT rc;
+
+    if (!rect) return E_POINTER;
+    GetWindowRect( impl->hwnd, &rc );
+    rect->X = rc.left;
+    rect->Y = rc.top;
+    rect->Width = rc.right - rc.left;
+    rect->Height = rc.bottom - rc.top;
+    return S_OK;
+}
+
+static HRESULT WINAPI cw_get_Visible( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = IsWindowVisible( impl_from_ICoreWindow( iface )->hwnd );
+    return S_OK;
+}
+
+static HRESULT WINAPI cw_ok_0( void *iface ) { return S_OK; }
+
+static HRESULT WINAPI cw_add_event( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, IUnknown *handler,
+                                    EventRegistrationToken *token )
+{
+    struct thread_corewindow *impl = impl_from_ICoreWindow( iface );
+
+    if (!token) return E_POINTER;
+    /* nothing is raised yet: the window is hidden */
+    token->value = InterlockedIncrement64( &impl->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI cw_remove_event( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI cw_key_state( __x_ABI_CWindows_CUI_CCore_CICoreWindow *iface, int key, void *state )
+{
+    return E_NOTIMPL;
+}
+
+static const void *corewindow_vtbl[] =
+{
+    cw_QueryInterface, cw_AddRef, cw_Release, cw_GetIids, cw_GetRuntimeClassName, cw_GetTrustLevel,
+    cw_notimpl_1,                   /* get_AutomationHostProvider */
+    cw_get_Bounds,
+    cw_notimpl_1,                   /* get_CustomProperties */
+    cw_notimpl_1,                   /* get_Dispatcher */
+    cw_notimpl_1,                   /* get_FlowDirection */
+    cw_notimpl_1,                   /* put_FlowDirection */
+    cw_notimpl_1,                   /* get_IsInputEnabled */
+    cw_notimpl_1,                   /* put_IsInputEnabled */
+    cw_notimpl_1,                   /* get_PointerCursor */
+    cw_notimpl_1,                   /* put_PointerCursor */
+    cw_notimpl_1,                   /* get_PointerPosition */
+    cw_get_Visible,
+    cw_ok_0,                        /* Activate */
+    cw_ok_0,                        /* Close */
+    cw_key_state,                   /* GetAsyncKeyState */
+    cw_key_state,                   /* GetKeyState */
+    cw_ok_0,                        /* ReleasePointerCapture */
+    cw_ok_0,                        /* SetPointerCapture */
+    /* add_/remove_ of Activated, AutomationProviderRequested, CharacterReceived, Closed, InputEnabled,
+     * KeyDown, KeyUp, PointerCaptureLost, PointerEntered, PointerExited, PointerMoved, PointerPressed,
+     * PointerReleased, TouchHitTesting, PointerWheelChanged, SizeChanged, VisibilityChanged */
+    cw_add_event, cw_remove_event, cw_add_event, cw_remove_event, cw_add_event, cw_remove_event,
+    cw_add_event, cw_remove_event, cw_add_event, cw_remove_event, cw_add_event, cw_remove_event,
+    cw_add_event, cw_remove_event, cw_add_event, cw_remove_event, cw_add_event, cw_remove_event,
+    cw_add_event, cw_remove_event, cw_add_event, cw_remove_event, cw_add_event, cw_remove_event,
+    cw_add_event, cw_remove_event, cw_add_event, cw_remove_event, cw_add_event, cw_remove_event,
+    cw_add_event, cw_remove_event, cw_add_event, cw_remove_event,
+};
+
+C_ASSERT( ARRAY_SIZE(corewindow_vtbl) == 58 );
+
+/* ICoreWindowInterop (IUnknown-based) */
+
+static HRESULT WINAPI interop_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    return cw_QueryInterface( &impl_from_interop( iface )->ICoreWindow_iface, iid, out );
+}
+
+static ULONG WINAPI interop_AddRef( IUnknown *iface )
+{
+    return cw_AddRef( &impl_from_interop( iface )->ICoreWindow_iface );
+}
+
+static ULONG WINAPI interop_Release( IUnknown *iface )
+{
+    return cw_Release( &impl_from_interop( iface )->ICoreWindow_iface );
+}
+
+static HRESULT WINAPI interop_get_WindowHandle( IUnknown *iface, HWND *hwnd )
+{
+    if (!hwnd) return E_POINTER;
+    *hwnd = impl_from_interop( iface )->hwnd;
+    return S_OK;
+}
+
+static HRESULT WINAPI interop_put_MessageHandled( IUnknown *iface, boolean handled )
+{
+    return S_OK;
+}
+
+static const void *interop_vtbl[] =
+{
+    interop_QueryInterface, interop_AddRef, interop_Release, interop_get_WindowHandle, interop_put_MessageHandled,
+};
+
+/* the calling thread's CoreWindow, if it has one (with a reference) */
+__x_ABI_CWindows_CUI_CCore_CICoreWindow *thread_corewindow(void)
+{
+    struct thread_corewindow *impl;
+
+    if (corewindow_tls == TLS_OUT_OF_INDEXES || !(impl = TlsGetValue( corewindow_tls ))) return NULL;
+    cw_AddRef( &impl->ICoreWindow_iface );
+    return &impl->ICoreWindow_iface;
+}
+
+/***********************************************************************
+ *           SgCoreWindowForThread   (windows.ui.@)
+ *
+ * Gives the calling thread a CoreWindow over a window of its own (hidden), unless it has one.
+ */
+BOOL WINAPI SgCoreWindowForThread( HWND hwnd )
+{
+    struct thread_corewindow *impl;
+
+    TRACE( "%p\n", hwnd );
+    if (corewindow_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&corewindow_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES)
+            TlsFree( index );
+    }
+    if (TlsGetValue( corewindow_tls )) return TRUE;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return FALSE;
+    impl->ICoreWindow_iface.lpVtbl = (void *)corewindow_vtbl;
+    impl->ICoreWindowInterop_iface.lpVtbl = (void *)interop_vtbl;
+    impl->ref = 1;
+    impl->hwnd = hwnd;
+    impl->thread = GetCurrentThreadId();
+    TlsSetValue( corewindow_tls, impl );
+    return TRUE;
+}
