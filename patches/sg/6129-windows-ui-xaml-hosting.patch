+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static struct xobj *impl_from_inner( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xobj, IInspectable_inner );
+}
+
+static struct xiface *iface_at( struct xobj *obj, unsigned int index )
+{
+    return (struct xiface *)((char *)obj + obj->cls->ifaces[index].offset);
+}
+
+/* ---- the inner, non-delegating IInspectable ----------------------------- */
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct xobj *obj = impl_from_inner( iface );
+    unsigned int i;
+
+    if (!out) return E_POINTER;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        *out = &obj->IInspectable_inner;
+        IInspectable_AddRef( &obj->IInspectable_inner );
+        return S_OK;
+    }
+    for (i = 0; i < obj->cls->count; i++)
+    {
+        if (IsEqualGUID( iid, obj->cls->ifaces[i].iid ))
+        {
+            *out = iface_at( obj, i );
+            IUnknown_AddRef( obj->outer );
+            return S_OK;
+        }
+    }
+    FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( obj->cls->name ), debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_inner( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct xobj *obj = impl_from_inner( iface );
+    ULONG ref = InterlockedDecrement( &obj->ref );
+
+    if (!ref)
+    {
+        if (obj->cls->destroy) obj->cls->destroy( obj );
+        free( obj );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    struct xobj *obj = impl_from_inner( iface );
+    unsigned int i;
+
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( obj->cls->count * sizeof(IID) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < obj->cls->count; i++) (*iids)[i] = *obj->cls->ifaces[i].iid;
+    *count = obj->cls->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    return xaml_hstring( impl_from_inner( iface )->cls->name, name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface, inner_AddRef, inner_Release, inner_GetIids, inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
+
+/* ---- the public interfaces' common methods ------------------------------- */
+
+HRESULT WINAPI xiface_QueryInterface( struct xiface *iface, REFIID iid, void **out )
+{
+    return IUnknown_QueryInterface( iface->obj->outer, iid, out );
+}
+
+ULONG WINAPI xiface_AddRef( struct xiface *iface )
+{
+    return IUnknown_AddRef( iface->obj->outer );
+}
+
+ULONG WINAPI xiface_Release( struct xiface *iface )
+{
+    return IUnknown_Release( iface->obj->outer );
+}
+
+HRESULT WINAPI xiface_GetIids( struct xiface *iface, ULONG *count, IID **iids )
+{
+    return inner_GetIids( &iface->obj->IInspectable_inner, count, iids );
+}
+
+HRESULT WINAPI xiface_GetRuntimeClassName( struct xiface *iface, HSTRING *name )
+{
+    return inner_GetRuntimeClassName( &iface->obj->IInspectable_inner, name );
+}
+
+HRESULT WINAPI xiface_GetTrustLevel( struct xiface *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+void xobj_init( struct xobj *obj, const struct xclass *cls, IInspectable *outer )
+{
+    unsigned int i;
+
+    obj->IInspectable_inner.lpVtbl = &inner_vtbl;
+    obj->outer = outer ? (IUnknown *)outer : (IUnknown *)&obj->IInspectable_inner;
+    obj->ref = 1;
+    obj->cls = cls;
+    for (i = 0; i < cls->count; i++) iface_at( obj, i )->obj = obj;
+}
+
+void *xobj_iface( struct xobj *obj, unsigned int index )
+{
+    IUnknown_AddRef( obj->outer );
+    return iface_at( obj, index );
+}
+
+void *xobj_default( struct xobj *obj )
+{
+    return xobj_iface( obj, 0 );
+}
+
+/* ---- events ----------------------------------------------------------------- */
+
+void handlers_init( struct handler_list *list )
+{
+    list_init( &list->entries );
+    list->next_token = 1;
+}
+
+HRESULT handlers_add( struct handler_list *list, IUnknown *handler, INT64 *token )
+{
+    struct handler_entry *entry;
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->token = list->next_token++;
+    entry->handler = handler;
+    IUnknown_AddRef( handler );
+    list_add_tail( &list->entries, &entry->entry );
+    *token = entry->token;
+    return S_OK;
+}
+
+HRESULT handlers_remove( struct handler_list *list, INT64 token )
+{
+    struct handler_entry *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, &list->entries, struct handler_entry, entry )
+    {
+        if (entry->token != token) continue;
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+        return S_OK;
+    }
+    return S_OK;
+}
+
+void handlers_clear( struct handler_list *list )
+{
+    struct handler_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &list->entries, struct handler_entry, entry )
+    {
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+    }
+}
+
+HRESULT xaml_hstring( const WCHAR *str, HSTRING *out )
+{
+    if (!out) return E_POINTER;
+    return WindowsCreateString( str, str ? wcslen( str ) : 0, out );
+}
