new file mode 100644
index 0000000..e1f41b5
--- /dev/null
+++ b/dlls/windows.ui.xaml/private.h
@@ -0,0 +1,159 @@
+/*
+ * Windows.UI.Xaml -- private declarations
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Stained Glass OS: our own Windows.UI.Xaml.  Interface definitions (IIDs, method order,
+ * parameters) per windows-rs 0.30.0 (MIT OR Apache-2.0), which carried the Windows.UI.Xaml
+ * namespaces, and upstream Wine's IDLs; the implementation is ours.
+ *
+ * Objects: every interface an object has is a struct xiface (its vtable and the object), so one set
+ * of IUnknown/IInspectable methods serves them all.  An object may be aggregated (a composable
+ * class -- an application's App derives from Application): then its public interfaces delegate
+ * IUnknown to the outer object, and the outer object holds the inner, non-delegating IInspectable.
+ */
+
+#ifndef __WINE_WINDOWS_UI_XAML_PRIVATE_H
+#define __WINE_WINDOWS_UI_XAML_PRIVATE_H
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "objbase.h"
+#include "activation.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+struct xobj;
+
+struct xiface
+{
+    const void *vtbl;
+    struct xobj *obj;
+};
+
+struct xiface_entry
+{
+    const IID *iid;
+    size_t offset;          /* of its struct xiface in the object */
+};
+
+struct xclass
+{
+    const WCHAR *name;
+    const struct xiface_entry *ifaces;
+    unsigned int count;
+    void (*destroy)( struct xobj *obj );
+};
+
+struct xobj
+{
+    IInspectable IInspectable_inner;    /* the non-delegating one */
+    IUnknown *outer;                    /* the controlling one: the outer object, or ours */
+    LONG ref;
+    const struct xclass *cls;
+};
+
+#define XIFACE_COMMON \
+    xiface_QueryInterface, xiface_AddRef, xiface_Release, xiface_GetIids, xiface_GetRuntimeClassName, xiface_GetTrustLevel
+
+HRESULT WINAPI xiface_QueryInterface( struct xiface *iface, REFIID iid, void **out );
+ULONG WINAPI xiface_AddRef( struct xiface *iface );
+ULONG WINAPI xiface_Release( struct xiface *iface );
+HRESULT WINAPI xiface_GetIids( struct xiface *iface, ULONG *count, IID **iids );
+HRESULT WINAPI xiface_GetRuntimeClassName( struct xiface *iface, HSTRING *name );
+HRESULT WINAPI xiface_GetTrustLevel( struct xiface *iface, TrustLevel *level );
+
+/* fills the object's header and its interfaces' back pointers; outer is NULL when not aggregated.
+ * inner (optional) gets the non-delegating IInspectable (aggregation's inner) */
+void xobj_init( struct xobj *obj, const struct xclass *cls, IInspectable *outer );
+/* the object's first interface (its default one), with a reference */
+void *xobj_default( struct xobj *obj );
+void *xobj_iface( struct xobj *obj, unsigned int index );
+
+#define XOBJ_IFACE(type, field) { 0 }
+
+/* events */
+struct handler_list
+{
+    struct list entries;
+    INT64 next_token;
+};
+
+struct handler_entry
+{
+    struct list entry;
+    INT64 token;
+    IUnknown *handler;
+};
+
+void handlers_init( struct handler_list *list );
+HRESULT handlers_add( struct handler_list *list, IUnknown *handler, INT64 *token );
+HRESULT handlers_remove( struct handler_list *list, INT64 token );
+void handlers_clear( struct handler_list *list );
+
+HRESULT xaml_hstring( const WCHAR *str, HSTRING *out );
+
+/* a class's activation factory: IActivationFactory and up to four static/factory interfaces, each
+ * a struct xfiface (its vtable and the factory) */
+struct xfactory;
+
+struct xfiface
+{
+    const void *vtbl;
+    struct xfactory *factory;
+};
+
+struct xfactory
+{
+    IActivationFactory IActivationFactory_iface;
+    const WCHAR *name;
+    const IID *iids[4];
+    struct xfiface ifaces[4];
+    HRESULT (*activate)( IInspectable **instance );   /* ActivateInstance; NULL: E_NOTIMPL */
+};
+
+extern const IActivationFactoryVtbl xfactory_vtbl;
+
+#define XFIFACE_COMMON \
+    xfiface_QueryInterface, xfiface_AddRef, xfiface_Release, xfiface_GetIids, xfiface_GetRuntimeClassName, xfiface_GetTrustLevel
+
+HRESULT WINAPI xfiface_QueryInterface( struct xfiface *iface, REFIID iid, void **out );
+ULONG WINAPI xfiface_AddRef( struct xfiface *iface );
+ULONG WINAPI xfiface_Release( struct xfiface *iface );
+HRESULT WINAPI xfiface_GetIids( struct xfiface *iface, ULONG *count, IID **iids );
+HRESULT WINAPI xfiface_GetRuntimeClassName( struct xfiface *iface, HSTRING *name );
+HRESULT WINAPI xfiface_GetTrustLevel( struct xfiface *iface, TrustLevel *level );
+
+/* classes */
+extern IActivationFactory *windows_xaml_manager_factory;
+extern IActivationFactory *desktop_window_xaml_source_factory;
+extern IActivationFactory *application_factory;
+extern IActivationFactory *window_factory_iface;
+
+/* gives the calling thread its Window.Current, over the window of its CoreWindow */
+HRESULT window_for_thread( HWND core_hwnd );
+
+#define DEFINE_XIFACE_IID(name, l, w1, w2, b1, b2, b3, b4, b5, b6, b7, b8) \
+    DEFINE_GUID(IID_##name, l, w1, w2, b1, b2, b3, b4, b5, b6, b7, b8)
+
+#endif
diff --git a/dlls/windows.ui.xaml/window.c b/dlls/windows.ui.xaml/window.c
