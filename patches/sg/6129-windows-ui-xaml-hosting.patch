+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * WindowsXamlManager (XAML for a thread) and DesktopWindowXamlSource: XAML content in a child
+ * window of a Win32 window (AttachToWindow), the island the host positions.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+DEFINE_GUID(IID_IClosable_xaml,                      0x30d5a829, 0x7fa4, 0x4026, 0x83, 0xbb, 0xd7, 0x5b, 0xae, 0x4e, 0xa9, 0x9e);
+DEFINE_GUID(IID_IWindowsXamlManager,                 0x56096c31, 0x1aa0, 0x5288, 0x88, 0x18, 0x6e, 0x74, 0xa2, 0xdc, 0xaf, 0xf5);
+DEFINE_GUID(IID_IWindowsXamlManagerStatics,          0x28258a12, 0x7d82, 0x505b, 0xb2, 0x10, 0x71, 0x2b, 0x04, 0xa5, 0x88, 0x82);
+DEFINE_GUID(IID_IDesktopWindowXamlSource,            0xd585bfe1, 0x00ff, 0x51be, 0xba, 0x1d, 0xa1, 0x32, 0x99, 0x56, 0xea, 0x0a);
+DEFINE_GUID(IID_IDesktopWindowXamlSourceFactory,     0x5cd61dc0, 0x2561, 0x56e1, 0x8e, 0x75, 0x6e, 0x44, 0x17, 0x38, 0x05, 0xe3);
+DEFINE_GUID(IID_IDesktopWindowXamlSourceNative_xaml, 0x3cbcf1bf, 0x2f76, 0x4e9c, 0x96, 0xab, 0xe8, 0x4b, 0x37, 0x97, 0x25, 0x54);
+DEFINE_GUID(IID_IDesktopWindowXamlSourceNative2_xaml,0xe3dcd8c7, 0x3057, 0x4692, 0x99, 0xc3, 0x7b, 0x77, 0x20, 0xaf, 0xda, 0x31);
+
+/* ---- WindowsXamlManager ------------------------------------------------------- */
+
+struct xaml_manager
+{
+    struct xobj obj;
+    struct xiface IWindowsXamlManager_iface;
+    struct xiface IClosable_iface;
+    DWORD thread;
+    BOOL closed;
+};
+
+static const struct xiface_entry manager_ifaces[] =
+{
+    { &IID_IWindowsXamlManager, offsetof(struct xaml_manager, IWindowsXamlManager_iface) },
+    { &IID_IClosable_xaml, offsetof(struct xaml_manager, IClosable_iface) },
+};
+
+static DWORD manager_tls = TLS_OUT_OF_INDEXES;
+
+static ATOM island_class(void);
+
+/* the thread's hidden CoreWindow (windows.ui gives the thread a CoreWindow over it) and its
+ * Window.Current, as a XAML thread has on Windows */
+static void thread_core_window(void)
+{
+    BOOL (WINAPI *core_for_thread)( HWND );
+    HMODULE ui;
+    HWND hwnd;
+
+    if (!island_class()) return;
+    hwnd = CreateWindowExW( WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW, L"Windows.UI.Core.CoreWindow", L"",
+                            WS_POPUP, 0, 0, 0, 0, NULL, NULL, GetModuleHandleW( L"windows.ui.xaml.dll" ), NULL );
+    if (!hwnd) return;
+    if ((ui = LoadLibraryW( L"windows.ui.dll" )) &&
+        (core_for_thread = (void *)GetProcAddress( ui, "SgCoreWindowForThread" )))
+        core_for_thread( hwnd );
+    window_for_thread( hwnd );
+}
+
+static void manager_destroy( struct xobj *obj )
+{
+    struct xaml_manager *manager = CONTAINING_RECORD( obj, struct xaml_manager, obj );
+    if (manager_tls != TLS_OUT_OF_INDEXES && manager->thread == GetCurrentThreadId() &&
+        TlsGetValue( manager_tls ) == manager)
+        TlsSetValue( manager_tls, NULL );
+}
+
+static const struct xclass manager_class =
+{
+    L"Windows.UI.Xaml.Hosting.WindowsXamlManager", manager_ifaces, ARRAY_SIZE(manager_ifaces), manager_destroy,
+};
+
+static const void *manager_vtbl[] = { XIFACE_COMMON };
+
+static HRESULT WINAPI manager_Close( struct xiface *iface )
+{
+    struct xaml_manager *manager = CONTAINING_RECORD( iface->obj, struct xaml_manager, obj );
+    TRACE( "%p\n", manager );
+    manager->closed = TRUE;
+    return S_OK;
+}
+
+static const void *manager_closable_vtbl[] = { XIFACE_COMMON, manager_Close };
+
+static HRESULT WINAPI manager_statics_InitializeForCurrentThread( struct xfiface *iface, void **out )
+{
+    struct xaml_manager *manager;
+
+    TRACE( "%p\n", out );
+    if (!out) return E_POINTER;
+    if (manager_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&manager_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES)
+            TlsFree( index );
+    }
+    /* one per thread: a second call gets the same one */
+    if ((manager = TlsGetValue( manager_tls )))
+    {
+        *out = xobj_default( &manager->obj );
+        return S_OK;
+    }
+    if (!(manager = calloc( 1, sizeof(*manager) ))) return E_OUTOFMEMORY;
+    manager->IWindowsXamlManager_iface.vtbl = manager_vtbl;
+    manager->IClosable_iface.vtbl = manager_closable_vtbl;
+    xobj_init( &manager->obj, &manager_class, NULL );
+    manager->thread = GetCurrentThreadId();
+    TlsSetValue( manager_tls, manager );
+    thread_core_window();
+    *out = &manager->IWindowsXamlManager_iface;
+    return S_OK;
+}
+
+static const void *manager_statics_vtbl[] = { XFIFACE_COMMON, manager_statics_InitializeForCurrentThread };
+
+static struct xfactory manager_factory =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Hosting.WindowsXamlManager",
+    { &IID_IWindowsXamlManagerStatics },
+    { { manager_statics_vtbl } },
+};
+
+IActivationFactory *windows_xaml_manager_factory = &manager_factory.IActivationFactory_iface;
+
+/* ---- DesktopWindowXamlSource ------------------------------------------------- */
+
+struct xaml_source
+{
+    struct xobj obj;
+    struct xiface IDesktopWindowXamlSource_iface;
+    struct xiface IClosable_iface;
+    struct xiface native_iface;     /* IDesktopWindowXamlSourceNative(2): IUnknown-based */
+    HWND window;                    /* the island */
+    IInspectable *content;          /* a UIElement */
+    struct handler_list take_focus_requested;
+    struct handler_list got_focus;
+};
+
+static const struct xiface_entry source_ifaces[] =
+{
+    { &IID_IDesktopWindowXamlSource, offsetof(struct xaml_source, IDesktopWindowXamlSource_iface) },
+    { &IID_IClosable_xaml, offsetof(struct xaml_source, IClosable_iface) },
+    { &IID_IDesktopWindowXamlSourceNative_xaml, offsetof(struct xaml_source, native_iface) },
+    { &IID_IDesktopWindowXamlSourceNative2_xaml, offsetof(struct xaml_source, native_iface) },
+};
+
+static struct xaml_source *source_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct xaml_source, obj );
+}
+
+static void source_close( struct xaml_source *source )
+{
+    if (source->window)
+    {
+        SetWindowLongPtrW( source->window, GWLP_USERDATA, 0 );
+        DestroyWindow( source->window );
+        source->window = NULL;
+    }
+    if (source->content)
+    {
+        IInspectable_Release( source->content );
+        source->content = NULL;
+    }
+    handlers_clear( &source->take_focus_requested );
+    handlers_clear( &source->got_focus );
+}
+
+static void source_destroy( struct xobj *obj )
+{
+    source_close( CONTAINING_RECORD( obj, struct xaml_source, obj ) );
+}
+
+static const struct xclass source_class =
+{
+    L"Windows.UI.Xaml.Hosting.DesktopWindowXamlSource", source_ifaces, ARRAY_SIZE(source_ifaces), source_destroy,
+};
+
+static HRESULT WINAPI source_get_Content( struct xiface *iface, IInspectable **value )
+{
+    struct xaml_source *source = source_from_iface( iface );
+
+    TRACE( "%p, %p\n", source, value );
+    if (!value) return E_POINTER;
+    if ((*value = source->content)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI source_put_Content( struct xiface *iface, IInspectable *value )
+{
+    struct xaml_source *source = source_from_iface( iface );
+
+    TRACE( "%p, %p\n", source, value );
+    if (value) IInspectable_AddRef( value );
+    if (source->content) IInspectable_Release( source->content );
+    source->content = value;
+    if (source->window) InvalidateRect( source->window, NULL, TRUE );
+    return S_OK;
+}
+
+static HRESULT WINAPI source_get_HasFocus( struct xiface *iface, boolean *value )
+{
+    struct xaml_source *source = source_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    *value = source->window && (GetFocus() == source->window || IsChild( source->window, GetFocus() ));
+    return S_OK;
+}
+
+static HRESULT WINAPI source_add_TakeFocusRequested( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &source_from_iface( iface )->take_focus_requested, handler, token );
+}
+
+static HRESULT WINAPI source_remove_TakeFocusRequested( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &source_from_iface( iface )->take_focus_requested, token );
+}
+
+static HRESULT WINAPI source_add_GotFocus( struct xiface *iface, IUnknown *handler, INT64 *token )
+{
+    return handlers_add( &source_from_iface( iface )->got_focus, handler, token );
+}
+
+static HRESULT WINAPI source_remove_GotFocus( struct xiface *iface, INT64 token )
+{
+    return handlers_remove( &source_from_iface( iface )->got_focus, token );
+}
+
+static HRESULT WINAPI source_NavigateFocus( struct xiface *iface, IInspectable *request, IInspectable **result )
+{
+    FIXME( "%p, %p, %p stub!\n", iface, request, result );
+    return E_NOTIMPL;
+}
+
+static const void *source_vtbl[] =
+{
+    XIFACE_COMMON,
+    source_get_Content, source_put_Content, source_get_HasFocus, source_add_TakeFocusRequested,
+    source_remove_TakeFocusRequested, source_add_GotFocus, source_remove_GotFocus, source_NavigateFocus,
+};
+
+static HRESULT WINAPI source_Close( struct xiface *iface )
+{
+    TRACE( "%p\n", iface );
+    source_close( source_from_iface( iface ) );
+    return S_OK;
+}
+
+static const void *source_closable_vtbl[] = { XIFACE_COMMON, source_Close };
+
+/* the island's window */
+
+static LRESULT CALLBACK island_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;   /* the content paints all of it */
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        BeginPaint( hwnd, &ps );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static ATOM island_class(void)
+{
+    static ATOM atom;
+    WNDCLASSEXW cls = { sizeof(cls) };
+
+    if (atom) return atom;
+    cls.lpfnWndProc = island_proc;
+    cls.hInstance = GetModuleHandleW( L"windows.ui.xaml.dll" );
+    cls.hCursor = LoadCursorW( NULL, (const WCHAR *)IDC_ARROW );
+    cls.lpszClassName = L"Windows.UI.Core.CoreWindow";
+    atom = RegisterClassExW( &cls );
+    return atom;
+}
+
+static HRESULT WINAPI native_QueryInterface( struct xiface *iface, REFIID iid, void **out )
+{
+    return xiface_QueryInterface( iface, iid, out );
+}
+
+static HRESULT WINAPI native_AttachToWindow( struct xiface *iface, HWND parent )
+{
+    struct xaml_source *source = source_from_iface( iface );
+
+    TRACE( "%p, %p\n", source, parent );
+    if (!IsWindow( parent )) return E_INVALIDARG;
+    if (source->window) return E_UNEXPECTED;   /* attached already */
+    if (!island_class()) return HRESULT_FROM_WIN32( GetLastError() );
+    source->window = CreateWindowExW( 0, L"Windows.UI.Core.CoreWindow", L"DesktopWindowXamlSource",
+                                      WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_CLIPSIBLINGS, 0, 0, 0, 0,
+                                      parent, NULL, GetModuleHandleW( L"windows.ui.xaml.dll" ), NULL );
+    if (!source->window) return HRESULT_FROM_WIN32( GetLastError() );
+    SetWindowLongPtrW( source->window, GWLP_USERDATA, (LONG_PTR)source );
+    return S_OK;
+}
+
+static HRESULT WINAPI native_get_WindowHandle( struct xiface *iface, HWND *hwnd )
+{
+    struct xaml_source *source = source_from_iface( iface );
+
+    if (!hwnd) return E_POINTER;
+    *hwnd = source->window;
+    return S_OK;
+}
+
+static HRESULT WINAPI native_PreTranslateMessage( struct xiface *iface, const MSG *msg, BOOL *handled )
+{
+    if (!handled) return E_POINTER;
+    *handled = FALSE;
+    return S_OK;
+}
+
+static const void *native_vtbl[] =
+{
+    native_QueryInterface, xiface_AddRef, xiface_Release,
+    native_AttachToWindow, native_get_WindowHandle, native_PreTranslateMessage,
+};
+
+static HRESULT WINAPI source_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner,
+                                                     void **value )
+{
+    struct xaml_source *source;
+
+    TRACE( "%p, %p, %p\n", outer, inner, value );
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(source = calloc( 1, sizeof(*source) ))) return E_OUTOFMEMORY;
+    source->IDesktopWindowXamlSource_iface.vtbl = source_vtbl;
+    source->IClosable_iface.vtbl = source_closable_vtbl;
+    source->native_iface.vtbl = native_vtbl;
+    handlers_init( &source->take_focus_requested );
+    handlers_init( &source->got_focus );
+    xobj_init( &source->obj, &source_class, outer );
+    if (outer)
+    {
+        *inner = &source->obj.IInspectable_inner;
+        *value = &source->IDesktopWindowXamlSource_iface;
+        IUnknown_AddRef( source->obj.outer );
+    }
+    else *value = &source->IDesktopWindowXamlSource_iface;
+    return S_OK;
+}
+
+static const void *source_factory_vtbl[] = { XFIFACE_COMMON, source_factory_CreateInstance };
+
+static HRESULT source_activate( IInspectable **instance )
+{
+    IInspectable *inner;
+    return source_factory_CreateInstance( NULL, NULL, &inner, (void **)instance );
+}
+
+static struct xfactory source_factory =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Hosting.DesktopWindowXamlSource",
+    { &IID_IDesktopWindowXamlSourceFactory },
+    { { source_factory_vtbl } },
+    source_activate,
+};
+
+IActivationFactory *desktop_window_xaml_source_factory = &source_factory.IActivationFactory_iface;
