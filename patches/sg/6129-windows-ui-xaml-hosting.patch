+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A XAML thread's Window (Window.Current): for XAML Islands it is over the thread's hidden
+ * CoreWindow.  It also has the private IWindowPrivate (TransparentBackground) that island hosts
+ * set; its IID is from Mile.Xaml (MIT), which uses it.
+ */
+
+#include <stdlib.h>
+#include "private.h"
+#include "winuser.h"
+#include "roapi.h"
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+DEFINE_GUID(IID_IWindow,        0x3276167d, 0xc9f6, 0x462d, 0x9d, 0xe2, 0xae, 0x4c, 0x1f, 0xd8, 0xc2, 0xe5);
+DEFINE_GUID(IID_IWindow2,       0xd384759f, 0x34f6, 0x4482, 0x84, 0x35, 0xf5, 0x52, 0xf9, 0xb2, 0x4c, 0xc8);
+DEFINE_GUID(IID_IWindow3,       0xb70bdc9d, 0x1c35, 0x462a, 0x9b, 0x97, 0x80, 0x8d, 0x5a, 0xf9, 0xf2, 0x8e);
+DEFINE_GUID(IID_IWindow4,       0xbfe1b8ce, 0x6c40, 0x50f9, 0x85, 0x4c, 0x70, 0x21, 0xd2, 0xbc, 0x9d, 0xe6);
+DEFINE_GUID(IID_IWindowStatics, 0x93328409, 0x4ea1, 0x4afa, 0x83, 0xdc, 0x0c, 0x4e, 0x73, 0xe8, 0x8b, 0xb1);
+DEFINE_GUID(IID_IWindowPrivate, 0x06636c29, 0x5a17, 0x458d, 0x8e, 0xa2, 0x24, 0x22, 0xd9, 0x97, 0xa9, 0x22);
+
+struct xaml_window
+{
+    struct xobj obj;
+    struct xiface IWindow_iface;
+    struct xiface IWindow2_iface;
+    struct xiface IWindow3_iface;
+    struct xiface IWindow4_iface;
+    struct xiface IWindowPrivate_iface;
+    HWND core_hwnd;                 /* the thread's CoreWindow's window */
+    IInspectable *content;
+    boolean transparent_background;
+    struct handler_list activated, closed, size_changed, visibility_changed;
+};
+
+static const struct xiface_entry window_ifaces[] =
+{
+    { &IID_IWindow, offsetof(struct xaml_window, IWindow_iface) },
+    { &IID_IWindow2, offsetof(struct xaml_window, IWindow2_iface) },
+    { &IID_IWindow3, offsetof(struct xaml_window, IWindow3_iface) },
+    { &IID_IWindow4, offsetof(struct xaml_window, IWindow4_iface) },
+    { &IID_IWindowPrivate, offsetof(struct xaml_window, IWindowPrivate_iface) },
+};
+
+static DWORD window_tls = TLS_OUT_OF_INDEXES;
+
+static struct xaml_window *window_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct xaml_window, obj );
+}
+
+static void window_destroy( struct xobj *obj )
+{
+    struct xaml_window *window = CONTAINING_RECORD( obj, struct xaml_window, obj );
+
+    if (window->content) IInspectable_Release( window->content );
+    handlers_clear( &window->activated );
+    handlers_clear( &window->closed );
+    handlers_clear( &window->size_changed );
+    handlers_clear( &window->visibility_changed );
+}
+
+static const struct xclass window_class =
+{
+    L"Windows.UI.Xaml.Window", window_ifaces, ARRAY_SIZE(window_ifaces), window_destroy,
+};
+
+/* Windows.Foundation.Rect */
+struct xrect { FLOAT x, y, width, height; };
+
+static HRESULT WINAPI window_get_Bounds( struct xiface *iface, struct xrect *value )
+{
+    struct xaml_window *window = window_from_iface( iface );
+    RECT rc = { 0 };
+
+    if (!value) return E_POINTER;
+    if (window->core_hwnd) GetClientRect( window->core_hwnd, &rc );
+    value->x = value->y = 0;
+    value->width = rc.right - rc.left;
+    value->height = rc.bottom - rc.top;
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_Visible( struct xiface *iface, boolean *value )
+{
+    struct xaml_window *window = window_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    *value = window->core_hwnd && IsWindowVisible( window->core_hwnd );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_Content( struct xiface *iface, IInspectable **value )
+{
+    struct xaml_window *window = window_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if ((*value = window->content)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_put_Content( struct xiface *iface, IInspectable *value )
+{
+    struct xaml_window *window = window_from_iface( iface );
+
+    if (value) IInspectable_AddRef( value );
+    if (window->content) IInspectable_Release( window->content );
+    window->content = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_CoreWindow( struct xiface *iface, IInspectable **value )
+{
+    static const WCHAR name[] = L"Windows.UI.Core.CoreWindow";
+    IInspectable *statics = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    /* the thread's: CoreWindow.GetForCurrentThread */
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = RoGetActivationFactory( str, &IID_IInspectable, (void **)&statics );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+    {
+        /* ICoreWindowStatic: IInspectable, then GetForCurrentThread */
+        HRESULT (WINAPI *get)( IInspectable *, IInspectable ** );
+        IInspectable *core_statics = NULL;
+        static const GUID iid_core_window_static =
+            { 0x4d239005, 0x3c2a, 0x41b1, { 0x90, 0x22, 0x53, 0x6b, 0xb9, 0xcf, 0x93, 0xb1 } };
+
+        hr = IInspectable_QueryInterface( statics, &iid_core_window_static, (void **)&core_statics );
+        IInspectable_Release( statics );
+        if (FAILED(hr)) return hr;
+        get = (void *)((void **)core_statics->lpVtbl)[6];
+        hr = get( core_statics, value );
+        IInspectable_Release( core_statics );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI window_get_Dispatcher( struct xiface *iface, IInspectable **value )
+{
+    FIXME( "%p, %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+#define WINDOW_EVENT(name, field) \
+static HRESULT WINAPI window_add_##name( struct xiface *iface, IUnknown *handler, INT64 *token ) \
+{ return handlers_add( &window_from_iface( iface )->field, handler, token ); } \
+static HRESULT WINAPI window_remove_##name( struct xiface *iface, INT64 token ) \
+{ return handlers_remove( &window_from_iface( iface )->field, token ); }
+
+WINDOW_EVENT(Activated, activated)
+WINDOW_EVENT(Closed, closed)
+WINDOW_EVENT(SizeChanged, size_changed)
+WINDOW_EVENT(VisibilityChanged, visibility_changed)
+
+static HRESULT WINAPI window_Activate( struct xiface *iface )
+{
+    TRACE( "%p\n", iface );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_Close( struct xiface *iface )
+{
+    TRACE( "%p\n", iface );
+    return S_OK;
+}
+
+static const void *window_vtbl[] =
+{
+    XIFACE_COMMON,
+    window_get_Bounds, window_get_Visible, window_get_Content, window_put_Content, window_get_CoreWindow,
+    window_get_Dispatcher, window_add_Activated, window_remove_Activated, window_add_Closed, window_remove_Closed,
+    window_add_SizeChanged, window_remove_SizeChanged, window_add_VisibilityChanged, window_remove_VisibilityChanged,
+    window_Activate, window_Close,
+};
+
+static HRESULT WINAPI window2_SetTitleBar( struct xiface *iface, IInspectable *element )
+{
+    FIXME( "%p, %p stub!\n", iface, element );
+    return S_OK;
+}
+
+static const void *window2_vtbl[] = { XIFACE_COMMON, window2_SetTitleBar };
+
+static HRESULT WINAPI window3_get_Compositor( struct xiface *iface, IInspectable **value )
+{
+    FIXME( "%p, %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const void *window3_vtbl[] = { XIFACE_COMMON, window3_get_Compositor };
+
+static HRESULT WINAPI window4_get_UIContext( struct xiface *iface, IInspectable **value )
+{
+    FIXME( "%p, %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const void *window4_vtbl[] = { XIFACE_COMMON, window4_get_UIContext };
+
+static HRESULT WINAPI private_get_TransparentBackground( struct xiface *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = window_from_iface( iface )->transparent_background;
+    return S_OK;
+}
+
+static HRESULT WINAPI private_put_TransparentBackground( struct xiface *iface, boolean value )
+{
+    TRACE( "%p, %d\n", iface, value );
+    window_from_iface( iface )->transparent_background = value;
+    return S_OK;
+}
+
+static const void *private_vtbl[] = { XIFACE_COMMON, private_get_TransparentBackground, private_put_TransparentBackground };
+
+/* the thread's Window, made when the thread initialises XAML (WindowsXamlManager) */
+HRESULT window_for_thread( HWND core_hwnd )
+{
+    struct xaml_window *window;
+
+    if (window_tls == TLS_OUT_OF_INDEXES)
+    {
+        DWORD index = TlsAlloc();
+        if (InterlockedCompareExchange( (LONG *)&window_tls, index, TLS_OUT_OF_INDEXES ) != TLS_OUT_OF_INDEXES)
+            TlsFree( index );
+    }
+    if (TlsGetValue( window_tls )) return S_OK;
+    if (!(window = calloc( 1, sizeof(*window) ))) return E_OUTOFMEMORY;
+    window->IWindow_iface.vtbl = window_vtbl;
+    window->IWindow2_iface.vtbl = window2_vtbl;
+    window->IWindow3_iface.vtbl = window3_vtbl;
+    window->IWindow4_iface.vtbl = window4_vtbl;
+    window->IWindowPrivate_iface.vtbl = private_vtbl;
+    window->core_hwnd = core_hwnd;
+    handlers_init( &window->activated );
+    handlers_init( &window->closed );
+    handlers_init( &window->size_changed );
+    handlers_init( &window->visibility_changed );
+    xobj_init( &window->obj, &window_class, NULL );
+    TlsSetValue( window_tls, window );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_statics_get_Current( struct xfiface *iface, void **value )
+{
+    struct xaml_window *window;
+
+    if (!value) return E_POINTER;
+    if (window_tls == TLS_OUT_OF_INDEXES || !(window = TlsGetValue( window_tls )))
+    {
+        *value = NULL;    /* XAML is not initialised on this thread */
+        return S_OK;
+    }
+    *value = xobj_default( &window->obj );
+    return S_OK;
+}
+
+static const void *window_statics_vtbl[] = { XFIFACE_COMMON, window_statics_get_Current };
+
+static struct xfactory window_factory =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Window",
+    { &IID_IWindowStatics },
+    { { window_statics_vtbl } },
+};
+
+IActivationFactory *window_factory_iface = &window_factory.IActivationFactory_iface;
