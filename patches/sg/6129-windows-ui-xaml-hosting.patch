+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static struct xfactory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct xfactory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct xfactory *factory = impl_from_IActivationFactory( iface );
+    unsigned int i;
+
+    if (!out) return E_POINTER;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &factory->IActivationFactory_iface;
+        return S_OK;
+    }
+    for (i = 0; i < ARRAY_SIZE(factory->iids); i++)
+    {
+        if (factory->iids[i] && IsEqualGUID( iid, factory->iids[i] ))
+        {
+            factory->ifaces[i].factory = factory;
+            *out = &factory->ifaces[i];
+            return S_OK;
+        }
+    }
+    FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( factory->name ), debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the factories are static: no reference counting */
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    FIXME( "%p, %p, %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return xaml_hstring( impl_from_IActivationFactory( iface )->name, name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct xfactory *factory = impl_from_IActivationFactory( iface );
+
+    if (!instance) return E_POINTER;
+    if (!factory->activate) return E_NOTIMPL;
+    return factory->activate( instance );
+}
+
+const IActivationFactoryVtbl xfactory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release, factory_GetIids, factory_GetRuntimeClassName,
+    factory_GetTrustLevel, factory_ActivateInstance,
+};
+
+HRESULT WINAPI xfiface_QueryInterface( struct xfiface *iface, REFIID iid, void **out )
+{
+    return factory_QueryInterface( &iface->factory->IActivationFactory_iface, iid, out );
+}
+
+ULONG WINAPI xfiface_AddRef( struct xfiface *iface ) { return 2; }
+ULONG WINAPI xfiface_Release( struct xfiface *iface ) { return 1; }
+
+HRESULT WINAPI xfiface_GetIids( struct xfiface *iface, ULONG *count, IID **iids )
+{
+    return factory_GetIids( &iface->factory->IActivationFactory_iface, count, iids );
+}
+
+HRESULT WINAPI xfiface_GetRuntimeClassName( struct xfiface *iface, HSTRING *name )
+{
+    return factory_GetRuntimeClassName( &iface->factory->IActivationFactory_iface, name );
+}
+
+HRESULT WINAPI xfiface_GetTrustLevel( struct xfiface *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
