+
+HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **factory )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( classid, NULL );
+    unsigned int i;
+
+    TRACE( "class %s, factory %p.\n", debugstr_w(name), factory );
+
+    *factory = NULL;
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        if (wcscmp( name, classes[i].name )) continue;
+        return IActivationFactory_QueryInterface( *classes[i].factory, &IID_IActivationFactory, (void **)factory );
+    }
+    FIXME( "class %s not implemented\n", debugstr_w(name) );
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
diff --git a/dlls/windows.ui.xaml/object.c b/dlls/windows.ui.xaml/object.c
