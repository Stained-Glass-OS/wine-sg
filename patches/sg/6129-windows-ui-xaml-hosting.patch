--- /dev/null
+++ b/dlls/windows.ui/thread_corewindow.c
@@ -0,0 +1,263 @@
+/*
+ * A thread's CoreWindow, for XAML Islands
+ *
+ * Copyright 2026 Stained Glass OS
+ *
