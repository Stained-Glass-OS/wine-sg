From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: Engine paths, lines, fills, blends and gradients for printer drivers (6062)

The path, line, paint, alpha blend and gradient services a user-mode
printer driver imports answered that they did nothing. CLIPOBJ_ppoGetPath
gives a clip's outline, PATHOBJ_vEnumStart/bEnum/vGetBounds enumerate it,
EngFillPath, EngStrokePath, EngStrokeAndFillPath, EngLineTo and EngPaint
draw with a solid brush and a binary raster operation, EngAlphaBlend and
EngGradientFill blend and shade 24 and 32 bit surfaces, and the brush
object keeps a realization. The text, font and transform objects the
engine alone hands out stay unsupported.
---
diff --git a/dlls/gdi32/engblt.c b/dlls/gdi32/engblt.c
index ed27459..7c4cd01 100644
--- a/dlls/gdi32/engblt.c
+++ b/dlls/gdi32/engblt.c
@@ -702,3 +702,626 @@ ULONG WINAPI BRUSHOBJ_ulGetBrushColor( BRUSHOBJ *brush )
 {
     return brush ? brush->iSolidColor : 0;
 }
+
+/* ---- paths, lines and fills ----
+ *
+ * A driver gets a path object from CLIPOBJ_ppoGetPath (the outline of a clip
+ * it built with EngCreateClip) and may draw it, or lines, or the clip area,
+ * on a bitmap surface with a solid brush of its own: the brush's iSolidColor
+ * is a colour of the surface's format, the mix's low byte a binary raster
+ * operation (R2_*). A pattern brush (iSolidColor 0xffffffff) needs the
+ * driver's DrvRealizeBrush, which only the engine's own drawing calls, so
+ * those draw nothing and fail. Coordinates in paths are 28.4 fixed point.
+ */
+
+#define PATH_MAGIC 0x48544150
+
+struct eng_subpath
+{
+    ULONG start, count;
+    FLONG flags;            /* PD_* */
+};
+
+struct eng_path
+{
+    PATHOBJ po;             /* first: drivers get its address */
+    DWORD magic;
+    ULONG point_count, subpath_count, next;
+    POINTFIX *points;
+    struct eng_subpath *subpaths;
+};
+
+static struct eng_path *get_path( PATHOBJ *po )
+{
+    struct eng_path *path = (struct eng_path *)po;
+    return path && path->magic == PATH_MAGIC ? path : NULL;
+}
+
+/***********************************************************************
+ *           CLIPOBJ_ppoGetPath    (GDI32.@)
+ *
+ * The clip's outline: our clips are a rectangle, so a closed figure of its four corners.
+ * A trivial clip has no outline to give.
+ */
+PATHOBJ * WINAPI CLIPOBJ_ppoGetPath( CLIPOBJ *clip )
+{
+    struct eng_path *path;
+    const RECTL *r;
+
+    TRACE( "%p\n", clip );
+    if (!clip || clip->iDComplexity == DC_TRIVIAL) return NULL;
+    if (!(path = calloc( 1, sizeof(*path) ))) return NULL;
+    path->magic = PATH_MAGIC;
+    if (!(path->points = malloc( 4 * sizeof(*path->points) )) || !(path->subpaths = malloc( sizeof(*path->subpaths) )))
+    {
+        free( path->points );
+        free( path );
+        return NULL;
+    }
+    r = &clip->rclBounds;
+    path->points[0].x = r->left * 16;  path->points[0].y = r->top * 16;
+    path->points[1].x = r->right * 16; path->points[1].y = r->top * 16;
+    path->points[2].x = r->right * 16; path->points[2].y = r->bottom * 16;
+    path->points[3].x = r->left * 16;  path->points[3].y = r->bottom * 16;
+    path->point_count = 4;
+    path->subpaths[0].start = 0;
+    path->subpaths[0].count = 4;
+    path->subpaths[0].flags = PD_BEGINSUBPATH | PD_ENDSUBPATH | PD_CLOSEFIGURE;
+    path->subpath_count = 1;
+    path->po.fl = PO_ALL_INTEGERS;
+    path->po.cCurves = 4;
+    return &path->po;
+}
+
+/***********************************************************************
+ *           EngDeletePath    (GDI32.@)
+ */
+void WINAPI EngDeletePath( PATHOBJ *po )
+{
+    struct eng_path *path = get_path( po );
+
+    TRACE( "%p\n", po );
+    if (!path) return;
+    path->magic = 0;
+    free( path->points );
+    free( path->subpaths );
+    free( path );
+}
+
+/***********************************************************************
+ *           PATHOBJ_vEnumStart    (GDI32.@)
+ */
+void WINAPI PATHOBJ_vEnumStart( PATHOBJ *po )
+{
+    struct eng_path *path = get_path( po );
+    if (path) path->next = 0;
+}
+
+/***********************************************************************
+ *           PATHOBJ_bEnum    (GDI32.@)
+ *
+ * One subpath per call; TRUE while more follow.
+ */
+BOOL WINAPI PATHOBJ_bEnum( PATHOBJ *po, PATHDATA *data )
+{
+    struct eng_path *path = get_path( po );
+    const struct eng_subpath *sub;
+
+    if (!data) return FALSE;
+    data->flags = 0;
+    data->count = 0;
+    data->pptfx = NULL;
+    if (!path || path->next >= path->subpath_count) return FALSE;
+    sub = &path->subpaths[path->next++];
+    data->flags = sub->flags;
+    data->count = sub->count;
+    data->pptfx = path->points + sub->start;
+#ifdef SG_MUTANT_PATH_ENUM_MORE
+    return TRUE;
+#endif
+    return path->next < path->subpath_count;
+}
+
+/***********************************************************************
+ *           PATHOBJ_vGetBounds    (GDI32.@)
+ */
+void WINAPI PATHOBJ_vGetBounds( PATHOBJ *po, RECTFX *bounds )
+{
+    struct eng_path *path = get_path( po );
+    ULONG i;
+
+    if (!bounds) return;
+    memset( bounds, 0, sizeof(*bounds) );
+    if (!path || !path->point_count) return;
+    bounds->xLeft = bounds->xRight = path->points[0].x;
+    bounds->yTop = bounds->yBottom = path->points[0].y;
+    for (i = 1; i < path->point_count; i++)
+    {
+        bounds->xLeft = min( bounds->xLeft, path->points[i].x );
+        bounds->xRight = max( bounds->xRight, path->points[i].x );
+        bounds->yTop = min( bounds->yTop, path->points[i].y );
+        bounds->yBottom = max( bounds->yBottom, path->points[i].y );
+    }
+}
+
+/* a binary raster operation: bit (2 * pen + destination) of the code less one */
+static ULONG do_rop2( ULONG rop2, ULONG p, ULONG d )
+{
+    ULONG table = (rop2 - 1) & 0xf, r = 0;
+    if (table & 1) r |= ~p & ~d;
+    if (table & 2) r |= ~p & d;
+    if (table & 4) r |= p & ~d;
+    if (table & 8) r |= p & d;
+    return r;
+}
+
+/* the area drawing may touch: the surface and the clip's bounds */
+static BOOL draw_area( SURFOBJ *so, CLIPOBJ *clip, RECTL *area )
+{
+    area->left = area->top = 0;
+    area->right = so->sizlBitmap.cx;
+    area->bottom = so->sizlBitmap.cy;
+    if (clip && clip->iDComplexity != DC_TRIVIAL && !intersect( area, area, &clip->rclBounds )) return FALSE;
+    return area->left < area->right && area->top < area->bottom;
+}
+
+static BOOL solid_brush( BRUSHOBJ *brush, MIX mix, ULONG *color, ULONG *rop2 )
+{
+    if (!brush || brush->iSolidColor == 0xffffffff) return FALSE;
+    *color = brush->iSolidColor;
+    *rop2 = mix & 0xff;
+    return *rop2 >= R2_BLACK && *rop2 <= R2_WHITE;
+}
+
+static inline void plot( SURFOBJ *so, int bpp, int x, int y, ULONG color, ULONG rop2 )
+{
+    BYTE *row = row_ptr( so, y );
+    ULONG d = get_pixel( row, x, bpp );
+
+    /* a 32 bit pixel's colour is its low 24 bits; the top byte is kept */
+    if (bpp == 32) put_pixel( row, x, bpp, (do_rop2( rop2, color, d ) & 0xffffff) | (d & 0xff000000) );
+    else put_pixel( row, x, bpp, do_rop2( rop2, color, d ) & ((1u << bpp) - 1) );
+}
+
+static void fill_span( SURFOBJ *so, int bpp, const RECTL *area, int y, LONG x0, LONG x1, ULONG color, ULONG rop2 )
+{
+    LONG x;
+
+    if (y < area->top || y >= area->bottom) return;
+    x0 = max( x0, area->left );
+    x1 = min( x1, area->right );
+    for (x = x0; x < x1; x++) plot( so, bpp, x, y, color, rop2 );
+}
+
+/* the subpaths, each closed, as edges for filling: a pixel is inside when its centre is */
+static BOOL fill_path( SURFOBJ *so, struct eng_path *path, const RECTL *area, ULONG color, ULONG rop2, BOOL winding )
+{
+    int bpp = format_bpp( so->iBitmapFormat ), y;
+    LONG *xs;
+    int *dirs;
+    ULONG i, s;
+
+    if (!path->point_count) return TRUE;
+    if (!(xs = malloc( path->point_count * sizeof(*xs) ))) return FALSE;
+    if (!(dirs = malloc( path->point_count * sizeof(*dirs) ))) { free( xs ); return FALSE; }
+    for (y = area->top; y < area->bottom; y++)
+    {
+        LONG yc = y * 16 + 8;
+        ULONG n = 0, a, b;
+
+        for (s = 0; s < path->subpath_count; s++)
+        {
+            const struct eng_subpath *sub = &path->subpaths[s];
+            for (i = 0; i < sub->count; i++)
+            {
+                const POINTFIX *p0 = &path->points[sub->start + i];
+                const POINTFIX *p1 = &path->points[sub->start + (i + 1) % sub->count];
+                if ((p0->y <= yc) == (p1->y <= yc)) continue;
+                /* where the edge crosses the row's centre */
+                xs[n] = p0->x + (LONG)((LONGLONG)(yc - p0->y) * (p1->x - p0->x) / (p1->y - p0->y));
+                dirs[n++] = p1->y > p0->y ? 1 : -1;
+            }
+        }
+        /* sorted by x */
+        for (a = 1; a < n; a++)
+            for (b = a; b > 0 && xs[b - 1] > xs[b]; b--)
+            {
+                LONG tx = xs[b]; int td = dirs[b];
+                xs[b] = xs[b - 1]; dirs[b] = dirs[b - 1];
+                xs[b - 1] = tx; dirs[b - 1] = td;
+            }
+        for (a = 0, b = 0; a + 1 < n; a++)
+        {
+            int wind = 0;
+            BOOL inside;
+            ULONG k;
+
+            if (winding)
+            {
+                for (k = 0; k <= a; k++) wind += dirs[k];
+                inside = wind != 0;
+            }
+            else inside = !(a & 1);
+            /* pixels whose centres lie in [xs[a], xs[a + 1]) */
+            if (inside) fill_span( so, bpp, area, y, (xs[a] - 8 + 15) >> 4, (xs[a + 1] - 8 + 15) >> 4, color, rop2 );
+        }
+        (void)b;
+    }
+    free( xs );
+    free( dirs );
+    return TRUE;
+}
+
+/* a one-pixel line from (x0, y0) to (x1, y1), the last pixel left out */
+static void draw_line( SURFOBJ *so, const RECTL *area, LONG x0, LONG y0, LONG x1, LONG y1, ULONG color, ULONG rop2 )
+{
+    int bpp = format_bpp( so->iBitmapFormat );
+    LONG dx = labs( x1 - x0 ), dy = -labs( y1 - y0 ), sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1, err = dx + dy;
+
+    while (x0 != x1 || y0 != y1)
+    {
+        LONG e2 = 2 * err;
+        if (x0 >= area->left && x0 < area->right && y0 >= area->top && y0 < area->bottom)
+            plot( so, bpp, x0, y0, color, rop2 );
+        if (e2 >= dy) { err += dy; x0 += sx; }
+        if (e2 <= dx) { err += dx; y0 += sy; }
+    }
+}
+
+static inline LONG fix_round( FIX v ) { return (v + 8) >> 4; }
+
+static BOOL stroke_path( SURFOBJ *so, struct eng_path *path, const RECTL *area, LINEATTRS *attrs, ULONG color, ULONG rop2 )
+{
+    ULONG s, i;
+
+    /* cosmetic solid lines only: wide and styled ones are the engine's own drawing */
+    if (attrs && (attrs->fl & (LA_GEOMETRIC | LA_STYLED | LA_ALTERNATE) || attrs->pstyle)) return FALSE;
+    for (s = 0; s < path->subpath_count; s++)
+    {
+        const struct eng_subpath *sub = &path->subpaths[s];
+        ULONG segments = sub->flags & PD_CLOSEFIGURE ? sub->count : sub->count - 1;
+
+        if (!sub->count) continue;
+        for (i = 0; i < segments; i++)
+        {
+            const POINTFIX *p0 = &path->points[sub->start + i];
+            const POINTFIX *p1 = &path->points[sub->start + (i + 1) % sub->count];
+            draw_line( so, area, fix_round( p0->x ), fix_round( p0->y ), fix_round( p1->x ), fix_round( p1->y ), color, rop2 );
+        }
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngFillPath    (GDI32.@)
+ */
+BOOL WINAPI EngFillPath( SURFOBJ *so, PATHOBJ *po, CLIPOBJ *clip, BRUSHOBJ *brush, POINTL *origin, MIX mix, FLONG options )
+{
+    struct eng_path *path = get_path( po );
+    ULONG color, rop2;
+    RECTL area;
+
+    TRACE( "%p %p %p %p %#lx %#lx\n", so, po, clip, brush, mix, options );
+    if (!bitmap_surface( so ) || !path || !solid_brush( brush, mix, &color, &rop2 )) return FALSE;
+    if (!draw_area( so, clip, &area )) return TRUE;
+    return fill_path( so, path, &area, color, rop2, options & FP_WINDINGMODE );
+}
+
+/***********************************************************************
+ *           EngStrokePath    (GDI32.@)
+ */
+BOOL WINAPI EngStrokePath( SURFOBJ *so, PATHOBJ *po, CLIPOBJ *clip, XFORMOBJ *xform, BRUSHOBJ *brush, POINTL *origin,
+                           LINEATTRS *attrs, MIX mix )
+{
+    struct eng_path *path = get_path( po );
+    ULONG color, rop2;
+    RECTL area;
+
+    TRACE( "%p %p %p %p %p %#lx\n", so, po, clip, brush, attrs, mix );
+    if (!bitmap_surface( so ) || !path || !solid_brush( brush, mix, &color, &rop2 )) return FALSE;
+    if (!draw_area( so, clip, &area )) return TRUE;
+    return stroke_path( so, path, &area, attrs, color, rop2 );
+}
+
+/***********************************************************************
+ *           EngStrokeAndFillPath    (GDI32.@)
+ */
+BOOL WINAPI EngStrokeAndFillPath( SURFOBJ *so, PATHOBJ *po, CLIPOBJ *clip, XFORMOBJ *xform, BRUSHOBJ *stroke,
+                                  LINEATTRS *attrs, BRUSHOBJ *fill, POINTL *origin, MIX mix, FLONG options )
+{
+    struct eng_path *path = get_path( po );
+    ULONG fill_color, fill_rop2, stroke_color, stroke_rop2;
+    RECTL area;
+
+    TRACE( "%p %p %p %p %p %p %#lx %#lx\n", so, po, clip, stroke, attrs, fill, mix, options );
+    if (!bitmap_surface( so ) || !path || !solid_brush( fill, mix, &fill_color, &fill_rop2 ) ||
+        !solid_brush( stroke, R2_COPYPEN, &stroke_color, &stroke_rop2 ))
+        return FALSE;
+    if (attrs && (attrs->fl & (LA_GEOMETRIC | LA_STYLED | LA_ALTERNATE) || attrs->pstyle)) return FALSE;
+    if (!draw_area( so, clip, &area )) return TRUE;
+    return fill_path( so, path, &area, fill_color, fill_rop2, options & FP_WINDINGMODE ) &&
+           stroke_path( so, path, &area, attrs, stroke_color, stroke_rop2 );
+}
+
+/***********************************************************************
+ *           EngLineTo    (GDI32.@)
+ */
+BOOL WINAPI EngLineTo( SURFOBJ *so, CLIPOBJ *clip, BRUSHOBJ *brush, LONG x1, LONG y1, LONG x2, LONG y2, RECTL *bounds,
+                       MIX mix )
+{
+    ULONG color, rop2;
+    RECTL area;
+
+    TRACE( "%p %p %p (%ld,%ld)-(%ld,%ld) %#lx\n", so, clip, brush, x1, y1, x2, y2, mix );
+    if (!bitmap_surface( so ) || !solid_brush( brush, mix, &color, &rop2 )) return FALSE;
+    if (!draw_area( so, clip, &area )) return TRUE;
+    draw_line( so, &area, x1, y1, x2, y2, color, rop2 );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           EngPaint    (GDI32.@)
+ *
+ * The clip's area with the brush.
+ */
+BOOL WINAPI EngPaint( SURFOBJ *so, CLIPOBJ *clip, BRUSHOBJ *brush, POINTL *origin, MIX mix )
+{
+    ULONG color, rop2;
+    RECTL area;
+    int bpp, y;
+
+    TRACE( "%p %p %p %#lx\n", so, clip, brush, mix );
+    if (!bitmap_surface( so ) || !solid_brush( brush, mix, &color, &rop2 )) return FALSE;
+    if (!draw_area( so, clip, &area )) return TRUE;
+    bpp = format_bpp( so->iBitmapFormat );
+    for (y = area.top; y < area.bottom; y++) fill_span( so, bpp, &area, y, area.left, area.right, color, rop2 );
+    return TRUE;
+}
+
+/* a 16, 24 or 32 bit pixel as 0x00RRGGBB and back; FALSE for an indexed surface */
+static BOOL rgb_format( SURFOBJ *so )
+{
+    int bpp = format_bpp( so->iBitmapFormat );
+    return bpp == 24 || bpp == 32;
+}
+
+/***********************************************************************
+ *           EngAlphaBlend    (GDI32.@)
+ *
+ * A 24 or 32 bit source onto a 24 or 32 bit destination, stretched, with the
+ * blend function's constant alpha and, for AC_SRC_ALPHA, the source's own
+ * premultiplied alpha (a 32 bit source).
+ */
+BOOL WINAPI EngAlphaBlend( SURFOBJ *dst, SURFOBJ *src, CLIPOBJ *clip, XLATEOBJ *xlate, RECTL *dst_rect, RECTL *src_rect,
+                           BLENDOBJ *blend )
+{
+    const BLENDFUNCTION *bf;
+    LONG dw, dh, sw, sh;
+    int dbpp, sbpp, x, y;
+    RECTL area;
+
+    TRACE( "%p %p %p %p %p %p %p\n", dst, src, clip, xlate, dst_rect, src_rect, blend );
+    if (!bitmap_surface( dst ) || !bitmap_surface( src ) || !dst_rect || !src_rect || !blend) return FALSE;
+    bf = &blend->BlendFunction;
+    if (bf->BlendOp != AC_SRC_OVER || !rgb_format( dst ) || !rgb_format( src )) return FALSE;
+    dbpp = format_bpp( dst->iBitmapFormat );
+    sbpp = format_bpp( src->iBitmapFormat );
+    if ((bf->AlphaFormat & AC_SRC_ALPHA) && sbpp != 32) return FALSE;
+    dw = dst_rect->right - dst_rect->left; dh = dst_rect->bottom - dst_rect->top;
+    sw = src_rect->right - src_rect->left; sh = src_rect->bottom - src_rect->top;
+    if (dw <= 0 || dh <= 0 || sw <= 0 || sh <= 0) return FALSE;
+    if (!blit_area( dst, clip, dst_rect, &area )) return TRUE;
+    for (y = area.top; y < area.bottom; y++)
+    {
+        LONG sy = map_coord( y - dst_rect->top, dh, src_rect->top, sh );
+        BYTE *drow = row_ptr( dst, y );
+        const BYTE *srow;
+
+        if (sy < 0 || sy >= src->sizlBitmap.cy) continue;
+        srow = row_ptr( src, sy );
+        for (x = area.left; x < area.right; x++)
+        {
+            LONG sx = map_coord( x - dst_rect->left, dw, src_rect->left, sw );
+            ULONG s, d, out = 0, ca = bf->SourceConstantAlpha, sa;
+            int c;
+
+            if (sx < 0 || sx >= src->sizlBitmap.cx) continue;
+            s = get_pixel( srow, sx, sbpp );
+            d = get_pixel( drow, x, dbpp );
+            /* the source's alpha, scaled by the constant one */
+            sa = (bf->AlphaFormat & AC_SRC_ALPHA) ? (s >> 24) * ca / 255 : ca;
+#ifdef SG_MUTANT_ALPHA_IGNORE_CONSTANT
+            sa = (bf->AlphaFormat & AC_SRC_ALPHA) ? s >> 24 : 255;
+            ca = 255;
+#endif
+            for (c = 0; c < 24; c += 8)
+            {
+                ULONG sc = (s >> c) & 0xff, dc = (d >> c) & 0xff, v;
+                /* a premultiplied source's colour is scaled by the constant alpha only */
+                if (bf->AlphaFormat & AC_SRC_ALPHA) v = sc * ca / 255 + dc * (255 - sa) / 255;
+                else v = (sc * sa + dc * (255 - sa)) / 255;
+                out |= min( v, 255 ) << c;
+            }
+            if (dbpp == 32) out |= d & 0xff000000;
+            put_pixel( drow, x, dbpp, out );
+        }
+    }
+    return TRUE;
+}
+
+static inline ULONG vertex_rgb( const TRIVERTEX *v )
+{
+    return ((v->Red >> 8) << 16) | ((v->Green >> 8) << 8) | (v->Blue >> 8);
+}
+
+static ULONG lerp_rgb( const TRIVERTEX *a, const TRIVERTEX *b, LONG t, LONG len )
+{
+    ULONG r, g, bl;
+    if (len <= 0) return vertex_rgb( a );
+    r = ((LONGLONG)a->Red * (len - t) + (LONGLONG)b->Red * t) / len;
+    g = ((LONGLONG)a->Green * (len - t) + (LONGLONG)b->Green * t) / len;
+    bl = ((LONGLONG)a->Blue * (len - t) + (LONGLONG)b->Blue * t) / len;
+    return ((r >> 8) << 16) | ((g >> 8) << 8) | (bl >> 8);
+}
+
+/***********************************************************************
+ *           EngGradientFill    (GDI32.@)
+ *
+ * Rectangles (horizontal or vertical) and triangles, on a 24 or 32 bit surface.
+ */
+BOOL WINAPI EngGradientFill( SURFOBJ *so, CLIPOBJ *clip, XLATEOBJ *xlate, TRIVERTEX *vertices, ULONG vertex_count,
+                             void *mesh, ULONG mesh_count, RECTL *extents, POINTL *dither_origin, ULONG mode )
+{
+    RECTL area;
+    ULONG m;
+    int bpp;
+
+    TRACE( "%p %p %p %lu %p %lu %#lx\n", so, clip, vertices, vertex_count, mesh, mesh_count, mode );
+    if (!bitmap_surface( so ) || !vertices || !mesh || !rgb_format( so )) return FALSE;
+    if (mode != GRADIENT_FILL_RECT_H && mode != GRADIENT_FILL_RECT_V && mode != GRADIENT_FILL_TRIANGLE) return FALSE;
+    if (!draw_area( so, clip, &area )) return TRUE;
+    bpp = format_bpp( so->iBitmapFormat );
+    for (m = 0; m < mesh_count; m++)
+    {
+        if (mode == GRADIENT_FILL_TRIANGLE)
+        {
+            const GRADIENT_TRIANGLE *t = (const GRADIENT_TRIANGLE *)mesh + m;
+            const TRIVERTEX *v[3];
+            LONGLONG det;
+            LONG x, y, top, bottom, left, right;
+
+            if (t->Vertex1 >= vertex_count || t->Vertex2 >= vertex_count || t->Vertex3 >= vertex_count) return FALSE;
+            v[0] = &vertices[t->Vertex1]; v[1] = &vertices[t->Vertex2]; v[2] = &vertices[t->Vertex3];
+            det = (LONGLONG)(v[1]->x - v[0]->x) * (v[2]->y - v[0]->y) - (LONGLONG)(v[2]->x - v[0]->x) * (v[1]->y - v[0]->y);
+            if (!det) continue;
+            top = max( area.top, min( v[0]->y, min( v[1]->y, v[2]->y ) ) );
+            bottom = min( area.bottom, max( v[0]->y, max( v[1]->y, v[2]->y ) ) + 1 );
+            left = max( area.left, min( v[0]->x, min( v[1]->x, v[2]->x ) ) );
+            right = min( area.right, max( v[0]->x, max( v[1]->x, v[2]->x ) ) + 1 );
+            for (y = top; y < bottom; y++)
+                for (x = left; x < right; x++)
+                {
+                    /* barycentric weights of the pixel's centre, in units of det / 2 */
+                    LONGLONG px = 2 * x + 1, py = 2 * y + 1;
+                    LONGLONG w1 = ((px - 2 * v[0]->x) * (v[2]->y - v[0]->y) - (LONGLONG)(v[2]->x - v[0]->x) * (py - 2 * v[0]->y));
+                    LONGLONG w2 = ((LONGLONG)(v[1]->x - v[0]->x) * (py - 2 * v[0]->y) - (px - 2 * v[0]->x) * (v[1]->y - v[0]->y));
+                    LONGLONG d2 = 2 * det, w0;
+                    ULONG r, g, b;
+
+                    if (det < 0) { w1 = -w1; w2 = -w2; d2 = -d2; }
+                    w0 = d2 - w1 - w2;
+                    if (w0 < 0 || w1 < 0 || w2 < 0) continue;
+                    r = (w0 * v[0]->Red + w1 * v[1]->Red + w2 * v[2]->Red) / d2;
+                    g = (w0 * v[0]->Green + w1 * v[1]->Green + w2 * v[2]->Green) / d2;
+                    b = (w0 * v[0]->Blue + w1 * v[1]->Blue + w2 * v[2]->Blue) / d2;
+                    put_pixel( row_ptr( so, y ), x, bpp, ((r >> 8) << 16) | ((g >> 8) << 8) | (b >> 8) );
+                }
+        }
+        else
+        {
+            const GRADIENT_RECT *gr = (const GRADIENT_RECT *)mesh + m;
+            const TRIVERTEX *a, *b;
+            RECTL r, fill;
+            LONG x, y;
+
+            if (gr->UpperLeft >= vertex_count || gr->LowerRight >= vertex_count) return FALSE;
+            a = &vertices[gr->UpperLeft];
+            b = &vertices[gr->LowerRight];
+            r.left = min( a->x, b->x ); r.right = max( a->x, b->x );
+            r.top = min( a->y, b->y ); r.bottom = max( a->y, b->y );
+            if (!intersect( &fill, &r, &area )) continue;
+            if (a->x > b->x && mode == GRADIENT_FILL_RECT_H) { const TRIVERTEX *t = a; a = b; b = t; }
+            if (a->y > b->y && mode == GRADIENT_FILL_RECT_V) { const TRIVERTEX *t = a; a = b; b = t; }
+            for (y = fill.top; y < fill.bottom; y++)
+                for (x = fill.left; x < fill.right; x++)
+                {
+                    ULONG c = mode == GRADIENT_FILL_RECT_H ? lerp_rgb( a, b, x - r.left, r.right - r.left )
+                                                           : lerp_rgb( a, b, y - r.top, r.bottom - r.top );
+#ifdef SG_MUTANT_GRADIENT_FLAT
+                    c = vertex_rgb( a );
+#endif
+                    put_pixel( row_ptr( so, y ), x, bpp, c );
+                }
+        }
+    }
+    return TRUE;
+}
+
+/* realized brushes a driver allocated on its own brush objects */
+struct rbrush
+{
+    BRUSHOBJ *brush;
+    void *data;
+};
+static struct rbrush *rbrushes;
+static unsigned int rbrush_count;
+static CRITICAL_SECTION rbrush_cs;
+static CRITICAL_SECTION_DEBUG rbrush_cs_debug =
+{
+    0, 0, &rbrush_cs,
+    { &rbrush_cs_debug.ProcessLocksList, &rbrush_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": rbrush_cs") }
+};
+static CRITICAL_SECTION rbrush_cs = { &rbrush_cs_debug, -1, 0, 0, 0, 0 };
+
+/***********************************************************************
+ *           BRUSHOBJ_pvAllocRbrush    (GDI32.@)
+ *
+ * Memory for the brush's realization, which BRUSHOBJ_pvGetRbrush then gives; a
+ * second allocation for the same brush replaces the first.
+ */
+void * WINAPI BRUSHOBJ_pvAllocRbrush( BRUSHOBJ *brush, ULONG size )
+{
+    struct rbrush *grown;
+    unsigned int i;
+    void *data;
+
+    TRACE( "%p %lu\n", brush, size );
+    if (!brush || !size || !(data = calloc( 1, size ))) return NULL;
+    EnterCriticalSection( &rbrush_cs );
+    for (i = 0; i < rbrush_count; i++)
+        if (rbrushes[i].brush == brush)
+        {
+            free( rbrushes[i].data );
+            rbrushes[i].data = data;
+            break;
+        }
+    if (i == rbrush_count)
+    {
+        if (!(grown = realloc( rbrushes, (rbrush_count + 1) * sizeof(*grown) )))
+        {
+            LeaveCriticalSection( &rbrush_cs );
+            free( data );
+            return NULL;
+        }
+        rbrushes = grown;
+        rbrushes[rbrush_count].brush = brush;
+        rbrushes[rbrush_count++].data = data;
+    }
+    LeaveCriticalSection( &rbrush_cs );
+    brush->pvRbrush = data;
+    return data;
+}
+
+/***********************************************************************
+ *           BRUSHOBJ_pvGetRbrush    (GDI32.@)
+ *
+ * The realization: a brush not realized yet would be realized by the driver's
+ * DrvRealizeBrush, which only the engine's own drawing calls, so it has none.
+ */
+void * WINAPI BRUSHOBJ_pvGetRbrush( BRUSHOBJ *brush )
+{
+    TRACE( "%p\n", brush );
+    return brush ? brush->pvRbrush : NULL;
+}
+
+/***********************************************************************
+ *           BRUSHOBJ_hGetColorTransform    (GDI32.@)
+ *
+ * No colour management in the engine: no transform.
+ */
+HANDLE WINAPI BRUSHOBJ_hGetColorTransform( BRUSHOBJ *brush )
+{
+    TRACE( "%p\n", brush );
+    return NULL;
+}
