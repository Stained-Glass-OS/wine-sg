+    {
+        save_sort(fe.pidl, fv);
+        IFolderView2_Release(fv);
+    }
     ILFree(fe.pending);
     fe.pending = ILClone(pidl);
     return S_OK;
@@ -4001,7 +4037,13 @@
     {
