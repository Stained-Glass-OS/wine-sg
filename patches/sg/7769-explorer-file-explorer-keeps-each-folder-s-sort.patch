From: Stained Glass OS <ke7oxh@gmail.com>
Subject: explorer: File Explorer keeps each folder's sort; a folder never sorted is by date

David (2026-11-15): "The file browser should remember folder settings. I keep
having to sort by date, also the default for detail view should be by date."
A folder's layout and grouping were kept (FolderViews, FolderGroups); its sort
was not, so every folder opened sorted by name again. The sort is now kept
per folder too (HKCU\Software\Stained Glass\Explorer\FolderSorts: the
FMTID_Storage pid | descending << 16), saved from the view itself as the
folder is left and as the window closes -- so a column header's click counts,
not only Sort in the command bar -- and put back when the folder's view is
made. A folder never sorted is by Date modified, newest first.

Gate: test/explorer-sortmem-gate.sh (make test-explorersort): the first open
shows z-new.txt above a-old.txt; a click on Name puts a-old.txt first; opened
again it is still by name, kept as FolderSorts = 0xa. The released File
Explorer fails three of its four checks.
--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -696,6 +696,34 @@
     return mode;
 }
 
+/* A folder's sort: the FMTID_Storage pid | descending << 16, kept per folder
+ * (FolderSorts) as its layout and grouping are -- whether chosen in the menu or
+ * by a column header, saved as the folder is left. A folder never sorted is by
+ * Date modified, newest first (David 2026-11-15: "I keep having to sort by
+ * date"). */
+static DWORD default_sort(const ITEMIDLIST *pidl)
+{
+    WCHAR name[MAX_PATH];
+    DWORD sort;
+    if (folder_key(pidl, name) && (sort = reg_dword(L"FolderSorts", name, 0))) return sort;
+#ifdef SG_MUTANT_SORT_BY_NAME
+    return 10;
+#else
+    return 14 /* PID_STG_WRITETIME */ | (1 << 16);
+#endif
+}
+
+static void save_sort(const ITEMIDLIST *pidl, IFolderView2 *fv)
+{
+    SORTCOLUMN sc;
+    WCHAR name[MAX_PATH];
+    if (!pidl || !fv || !folder_key(pidl, name)) return;
+    if (FAILED(IFolderView2_GetSortColumns(fv, &sc, 1)) || !IsEqualGUID(&sc.propkey.fmtid, &fmtid_storage)) return;
+#ifndef SG_MUTANT_SORT_NOT_SAVED
+    set_reg_dword(L"FolderSorts", name, sc.propkey.pid | (sc.direction == SORT_DESCENDING ? 1 << 16 : 0));
+#endif
+}
+
 /* a folder's grouping: the FMTID_Storage pid | ascending << 16, 0 for none */
 static DWORD default_group(const ITEMIDLIST *pidl)
 {
@@ -3987,6 +4015,14 @@
 
 static HRESULT WINAPI events_OnNavigationPending(IExplorerBrowserEvents *iface, PCIDLIST_ABSOLUTE pidl)
 {
+    IFolderView2 *fv;
+
+    /* the folder being left keeps its sort (a column header's too) */
