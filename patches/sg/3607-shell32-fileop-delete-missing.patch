From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHFileOperation delete with a missing file, copy of nothing (3607)

shell32: SHFileOperation delete with a missing file, copy/move of nothing

FO_DELETE of a list that names a file that does not exist fails as a whole,
before anything is deleted, with the error deleting the missing item gives
(Wine deleted the files before the missing one). A copy or move whose source
list is empty returns 0 instead of access denied. Both are what the shell32
conformance test records for Windows; the two todo_wine marks are removed.

Explorer-facing: SHFileOperation callers (Explorer's own delete goes through
IFileOperation): run the explorer gates at integration.
Gate: test/fastb-shfileop2-gate.sh (mutants SG_MUTANT_DELETE_PARTIAL, SG_MUTANT_EMPTY_FROM caught).
---
diff --git a/dlls/shell32/shlfileop.c b/dlls/shell32/shlfileop.c
index 01464cc..ca74fbc 100644
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1434,6 +1434,25 @@ static int delete_files(LPSHFILEOPSTRUCTW lpFileOp, const FILE_LIST *flFrom)
     if (!flFrom->dwNumFiles)
         return ERROR_SUCCESS;
 
+    /* as Windows (the conformance test records it): a file in the list that does
+     * not exist fails the whole operation before anything is deleted */
+#ifndef SG_MUTANT_DELETE_PARTIAL
+    if (flFrom->bAnyDontExist)
+    {
+        /* the error is the one deleting the first missing item gives */
+        for (i = 0; i < flFrom->dwNumFiles; i++)
+        {
+            fileEntry = &flFrom->feFiles[i];
+            if (fileEntry->bExists || fileEntry->bFromWildcard) continue;
+            if (IsAttribFile(fileEntry->attributes))
+                ret = DeleteFileW(fileEntry->szFullPath) ? ERROR_SUCCESS : GetLastError();
+            else
+                ret = SHELL_DeleteDirectoryW(lpFileOp->hwnd, fileEntry->szFullPath, FALSE);
+            return ret ? ret : ERROR_SHELL_INTERNAL_FILE_NOT_FOUND;
+        }
+    }
+#endif
+
     /* Windows also checks only the first item */
     bTrash = (lpFileOp->fFlags & FOF_ALLOWUNDO) && is_trash_available();
 
@@ -1960,7 +1979,15 @@ static int shfileop_run(LPSHFILEOPSTRUCTW lpFileOp)
     ZeroMemory(&flTo, sizeof(FILE_LIST));
 
     if ((ret = parse_file_list(&flFrom, lpFileOp->pFrom)))
+    {
+#ifndef SG_MUTANT_EMPTY_FROM
+        /* as Windows (the conformance test records it): nothing to copy or move is not an error */
+        if (ret == ERROR_ACCESS_DENIED && !lpFileOp->pFrom[0] &&
+            ((lpFileOp->wFunc & FO_MASK) == FO_COPY || (lpFileOp->wFunc & FO_MASK) == FO_MOVE))
+            return ERROR_SUCCESS;
+#endif
         return ret;
+    }
 
     if (lpFileOp->wFunc != FO_DELETE)
         parse_file_list(&flTo, lpFileOp->pTo);
diff --git a/dlls/shell32/tests/shlfileop.c b/dlls/shell32/tests/shlfileop.c
index 6eada49..f266357 100644
--- a/dlls/shell32/tests/shlfileop.c
+++ b/dlls/shell32/tests/shlfileop.c
@@ -726,7 +726,6 @@ static void test_delete(void)
        ret == ERROR_FILE_NOT_FOUND || /* Vista */
        broken(ret == ERROR_SUCCESS), /* NT4 */
        "Expected 1026 or ERROR_FILE_NOT_FOUND, got %ld\n", ret);
-    todo_wine
     ok(file_exists("test1.txt"), "Expected test1.txt to exist\n");
     ok(file_exists("test2.txt"), "Expected test2.txt to exist\n");
 
@@ -2262,7 +2261,7 @@ static void test_move(void)
     set_curr_dir_path(from, "\0\0");
     set_curr_dir_path(to, "test6.txt\0\0");
     retval = SHFileOperationA(&shfo2);
-    todo_wine ok(!retval, "got %ld\n", retval);
+    ok(!retval, "got %ld\n", retval);
     ok(!file_exists("test6.txt"), "The file should not exist\n");
 
     init_shfo_tests();
