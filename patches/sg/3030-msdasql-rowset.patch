+static HRESULT WINAPI enum_rsinfo_GetProperties(IRowsetInfo *iface, const ULONG count,
+        const DBPROPIDSET propertyidsets[], ULONG *out_count, DBPROPSET **propertysets)
+{
+    struct msdasql_enum_rowset *rowset = msdasql_enum_from_IRowsetInfo( iface );
+    ULONG i, j, total = 0;
+    DBPROPSET *sets;
+
+    TRACE("%p, %lu, %p, %p, %p\n", rowset, count, propertyidsets, out_count, propertysets);
+
+    if (!out_count || !propertysets) return E_INVALIDARG;
+    *out_count = 0;
+    *propertysets = NULL;
+    if (count && !propertyidsets) return E_INVALIDARG;
+    if (!count) return S_OK;
+
+    sets = CoTaskMemAlloc(count * sizeof(*sets));
+    if (!sets) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        ULONG n = propertyidsets[i].cPropertyIDs;
+
+        sets[i].guidPropertySet = propertyidsets[i].guidPropertySet;
+        sets[i].cProperties = n;
+        sets[i].rgProperties = CoTaskMemAlloc((n ? n : 1) * sizeof(DBPROP));
+        if (!sets[i].rgProperties)
+        {
+            while (i--) CoTaskMemFree(sets[i].rgProperties);
+            CoTaskMemFree(sets);
+            return E_OUTOFMEMORY;
+        }
+        for (j = 0; j < n; j++)
+        {
+            DBPROP *p = &sets[i].rgProperties[j];
+
+            memset(p, 0, sizeof(*p));
+            p->dwPropertyID = propertyidsets[i].rgPropertyIDs[j];
+            p->dwOptions = DBPROPOPTIONS_REQUIRED;
+            p->dwStatus = DBPROPSTATUS_NOTSUPPORTED;
+            VariantInit(&p->vValue);
+            total++;
+        }
+    }
+    *out_count = count;
+    *propertysets = sets;
+    return total ? DB_E_ERRORSOCCURRED : S_OK;
+}
