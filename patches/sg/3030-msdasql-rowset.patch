+static const struct
+{
+    const WCHAR *name;
+    DBCOLUMNFLAGS flags;
+    DBLENGTH size;
+    DBTYPE type;
+    BYTE precision;
+}
+source_columns[] =
+{
+    { NULL,                 DBCOLUMNFLAGS_ISFIXEDLENGTH | DBCOLUMNFLAGS_ISBOOKMARK, 4, DBTYPE_UI4, 10 },
+    { L"SOURCES_NAME",        DBCOLUMNFLAGS_MAYBENULL | DBCOLUMNFLAGS_WRITEUNKNOWN, 128, DBTYPE_WSTR, 255 },
+    { L"SOURCES_PARSENAME",   DBCOLUMNFLAGS_MAYBENULL | DBCOLUMNFLAGS_WRITEUNKNOWN, 128, DBTYPE_WSTR, 255 },
+    { L"SOURCES_DESCRIPTION", DBCOLUMNFLAGS_MAYBENULL | DBCOLUMNFLAGS_WRITEUNKNOWN, 128, DBTYPE_WSTR, 255 },
+    { L"SOURCES_TYPE",        DBCOLUMNFLAGS_ISFIXEDLENGTH | DBCOLUMNFLAGS_MAYBENULL | DBCOLUMNFLAGS_WRITEUNKNOWN, 2, DBTYPE_UI2, 5 },
+    { L"SOURCES_ISPARENT",    DBCOLUMNFLAGS_ISFIXEDLENGTH | DBCOLUMNFLAGS_MAYBENULL | DBCOLUMNFLAGS_WRITEUNKNOWN, 2, DBTYPE_BOOL, 255 },
+};
+
+static HRESULT enum_get_columns(DBORDINAL *columns, DBCOLUMNINFO **colinfo, OLECHAR **stringsbuffer)
+{
+    DBCOLUMNINFO *info;
+    SIZE_T chars = 0;
+    OLECHAR *ptr;
+    DBORDINAL i;
+
+    if (!columns || !colinfo || !stringsbuffer) return E_INVALIDARG;
+    *columns = 0;
+    *colinfo = NULL;
+    *stringsbuffer = NULL;
+
+    for (i = 0; i < ARRAY_SIZE(source_columns); i++)
+        if (source_columns[i].name) chars += lstrlenW(source_columns[i].name) + 1;
+
+    info = CoTaskMemAlloc(ARRAY_SIZE(source_columns) * sizeof(*info));
+    ptr = CoTaskMemAlloc(chars * sizeof(WCHAR));
+    if (!info || !ptr)
+    {
+        CoTaskMemFree(info);
+        CoTaskMemFree(ptr);
+        return E_OUTOFMEMORY;
+    }
+    *stringsbuffer = ptr;
+
+    for (i = 0; i < ARRAY_SIZE(source_columns); i++)
+    {
+        memset(&info[i], 0, sizeof(info[i]));
+        if (source_columns[i].name)
+        {
+            lstrcpyW(ptr, source_columns[i].name);
+            info[i].pwszName = ptr;
+            info[i].columnid.eKind = DBKIND_NAME;
+            info[i].columnid.uName.pwszName = ptr;
+            ptr += lstrlenW(ptr) + 1;
+        }
+        else
+            info[i].columnid.eKind = DBKIND_GUID_PROPID;
+        info[i].iOrdinal = i;
+        info[i].dwFlags = source_columns[i].flags;
+        info[i].ulColumnSize = source_columns[i].size;
+        info[i].wType = source_columns[i].type;
+        info[i].bPrecision = source_columns[i].precision;
+        info[i].bScale = 255;
+    }
+
+    *columns = ARRAY_SIZE(source_columns);
+    *colinfo = info;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_colsinfo_GetColumnInfo(IColumnsInfo *iface, DBORDINAL *columns,
+        DBCOLUMNINFO **colinfo, OLECHAR **stringsbuffer)
+{
+    struct msdasql_enum_rowset *rowset = msdasql_enum_from_IColumnsInfo( iface );
+
+    TRACE("%p, %p, %p, %p\n", rowset, columns, colinfo, stringsbuffer);
+
+    return enum_get_columns(columns, colinfo, stringsbuffer);
+}
+
+static HRESULT WINAPI enum_colsinfo_MapColumnIDs(IColumnsInfo *iface, DBORDINAL count, const DBID *dbids,
+        DBORDINAL *columns)
+{
+    struct msdasql_enum_rowset *rowset = msdasql_enum_from_IColumnsInfo( iface );
+    DBCOLUMNINFO *info;
+    OLECHAR *buffer;
+    DBORDINAL ncols;
+    HRESULT hr;
+
+    TRACE("%p, %Iu, %p, %p\n", rowset, count, dbids, columns);
+
+    if (!count) return S_OK;
+    if (!dbids || !columns) return E_INVALIDARG;
+    if (FAILED(hr = enum_get_columns(&ncols, &info, &buffer))) return hr;
+    hr = rt_map_column_ids(count, dbids, ncols, info, columns);
+    CoTaskMemFree(info);
+    CoTaskMemFree(buffer);
+    return hr;
+}
