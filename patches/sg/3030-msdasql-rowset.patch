+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "oledb.h"
+#include "msdadc.h"
+#include "oledberr.h"
+#include "sql.h"
+#include "sqlext.h"
+#include "wine/debug.h"
+
+#include "msdasql_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msdasql);
+
+static const GUID clsid_conversion_library =
+    { 0xc8b522d1, 0x5cf3, 0x11ce, { 0xad, 0xe5, 0x00, 0xaa, 0x00, 0x44, 0x77, 0x3d } };
+
+static const GUID iid_data_convert =
+    { 0x0c733a8d, 0x2a1c, 0x11ce, { 0xad, 0xe5, 0x00, 0xaa, 0x00, 0x44, 0x77, 0x3d } };
+
+#define MAX_ACCESSOR_FLAGS (DBACCESSOR_PASSBYREF | DBACCESSOR_ROWDATA | DBACCESSOR_PARAMETERDATA | \
+                            DBACCESSOR_OPTIMIZED | DBACCESSOR_INHERITED)
+
+void rt_init(struct rowtable *rt, DBORDINAL ncols)
+{
+    TRACE("%p, %Iu columns\n", rt, ncols);
+    memset(rt, 0, sizeof(*rt));
+    rt->ncols = ncols;
+    InitializeCriticalSection(&rt->cs);
+}
+
+static void free_row(struct rowdata *row, DBORDINAL ncols)
+{
+    DBORDINAL i;
+
+    if (!row) return;
+    for (i = 0; i < ncols; i++)
+        free(row->cells[i].data);
+    free(row->cells);
+    free(row);
+}
+
+void rt_free(struct rowtable *rt)
+{
+    ULONG i;
+
+    for (i = 0; i < rt->rows_cap; i++)
+        free_row(rt->rows[i], rt->ncols);
+    free(rt->rows);
+    for (i = 0; i < rt->acc_cap; i++)
+    {
+        if (rt->acc[i]) free(rt->acc[i]->bindings);
+        free(rt->acc[i]);
+    }
+    free(rt->acc);
+    if (rt->convert) IUnknown_Release(rt->convert);
+    DeleteCriticalSection(&rt->cs);
+}
+
+static IDataConvert *get_converter(struct rowtable *rt)
+{
+    IDataConvert *conv = NULL;
+
+    EnterCriticalSection(&rt->cs);
+    if (!rt->convert &&
+        SUCCEEDED(CoCreateInstance(&clsid_conversion_library, NULL, CLSCTX_INPROC_SERVER, &iid_data_convert,
+                                   (void **)&conv)))
+        rt->convert = (IUnknown *)conv;
+    conv = (IDataConvert *)rt->convert;
+    LeaveCriticalSection(&rt->cs);
+    return conv;
+}
+
+/* ---- accessors ---- */
+
+static struct rt_accessor *get_accessor(struct rowtable *rt, HACCESSOR h)
+{
+    if (!h || h > rt->acc_cap) return NULL;
+    return rt->acc[h - 1];
+}
+
+HRESULT rt_create_accessor(struct rowtable *rt, DBACCESSORFLAGS flags, DBCOUNTITEM count,
+        const DBBINDING bindings[], DBLENGTH row_size, HACCESSOR *accessor, DBBINDSTATUS status[])
+{
+    struct rt_accessor *acc;
+    DBCOUNTITEM i;
+    ULONG slot;
+    BOOL bad = FALSE;
+
+    if (!accessor) return E_INVALIDARG;
+    *accessor = 0;
+    if (count && !bindings) return E_INVALIDARG;
+    if (!(flags & (DBACCESSOR_ROWDATA | DBACCESSOR_PARAMETERDATA)) || (flags & ~MAX_ACCESSOR_FLAGS))
+        return DB_E_BADACCESSORFLAGS;
+    if ((flags & DBACCESSOR_ROWDATA) && (flags & DBACCESSOR_PARAMETERDATA))
+        return DB_E_BADACCESSORFLAGS;
+
+    for (i = 0; i < count; i++)
+    {
+        DBBINDSTATUS st = DBBINDSTATUS_OK;
+        const DBBINDING *b = &bindings[i];
+
+        if ((flags & DBACCESSOR_ROWDATA) && (!b->iOrdinal || b->iOrdinal > rt->ncols))
+            st = DBBINDSTATUS_BADORDINAL;
+        else if (!b->iOrdinal && (flags & DBACCESSOR_PARAMETERDATA))
+            st = DBBINDSTATUS_BADORDINAL;
+        else if (!(b->dwPart & (DBPART_VALUE | DBPART_LENGTH | DBPART_STATUS)) || (b->dwPart & ~7u))
+            st = DBBINDSTATUS_BADBINDINFO;
+        else if (b->dwMemOwner > DBMEMOWNER_PROVIDEROWNED)
+            st = DBBINDSTATUS_BADBINDINFO;
+        else if ((b->dwPart & DBPART_VALUE) && !b->wType)
+            st = DBBINDSTATUS_BADBINDINFO;
+        else if (b->pObject)
+            st = DBBINDSTATUS_BADBINDINFO;
+        else if (rt->ncols && (flags & DBACCESSOR_ROWDATA) && (b->dwPart & DBPART_VALUE))
+        {
+            IDataConvert *conv = get_converter(rt);
+            DBTYPE t = b->wType & ~DBTYPE_BYREF;
+
+            if (conv && IDataConvert_CanConvert(conv, DBTYPE_WSTR, t) != S_OK &&
+                t != DBTYPE_VARIANT && t != DBTYPE_BYTES && t != DBTYPE_IUNKNOWN)
+                st = DBBINDSTATUS_UNSUPPORTEDCONVERSION;
+        }
+
+        if (status) status[i] = st;
+        if (st != DBBINDSTATUS_OK) bad = TRUE;
+    }
+    if (bad) return DB_E_ERRORSOCCURRED;
+
+    acc = calloc(1, sizeof(*acc));
+    if (!acc) return E_OUTOFMEMORY;
+    acc->flags = flags;
+    acc->count = count;
+    acc->refs = 1;
+    acc->row_size = row_size;
+    if (count)
+    {
+        acc->bindings = malloc(count * sizeof(*acc->bindings));
+        if (!acc->bindings) { free(acc); return E_OUTOFMEMORY; }
+        memcpy(acc->bindings, bindings, count * sizeof(*acc->bindings));
+        for (i = 0; i < count; i++)
+        {
+            acc->bindings[i].pTypeInfo = NULL;
+            acc->bindings[i].pObject = NULL;
+            acc->bindings[i].pBindExt = NULL;
+        }
+    }
+
+    EnterCriticalSection(&rt->cs);
+    for (slot = 0; slot < rt->acc_cap; slot++)
+        if (!rt->acc[slot]) break;
+    if (slot == rt->acc_cap)
+    {
+        struct rt_accessor **n = realloc(rt->acc, (rt->acc_cap + 8) * sizeof(*n));
+        if (!n)
+        {
+            LeaveCriticalSection(&rt->cs);
+            free(acc->bindings);
+            free(acc);
+            return E_OUTOFMEMORY;
+        }
+        memset(n + rt->acc_cap, 0, 8 * sizeof(*n));
+        rt->acc = n;
+        rt->acc_cap += 8;
+    }
+    rt->acc[slot] = acc;
+    LeaveCriticalSection(&rt->cs);
+
+    *accessor = slot + 1;
+    return S_OK;
+}
+
+HRESULT rt_addref_accessor(struct rowtable *rt, HACCESSOR h, DBREFCOUNT *count)
+{
+    struct rt_accessor *acc;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&rt->cs);
+    if ((acc = get_accessor(rt, h)))
+    {
+        acc->refs++;
+        if (count) *count = acc->refs;
+    }
+    else hr = DB_E_BADACCESSORHANDLE;
+    LeaveCriticalSection(&rt->cs);
+    return hr;
+}
+
+HRESULT rt_release_accessor(struct rowtable *rt, HACCESSOR h, DBREFCOUNT *count)
+{
+    struct rt_accessor *acc;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&rt->cs);
+    if ((acc = get_accessor(rt, h)))
+    {
+        if (count) *count = acc->refs - 1;
+        if (!--acc->refs)
+        {
+            free(acc->bindings);
+            free(acc);
+            rt->acc[h - 1] = NULL;
+        }
+    }
+    else hr = DB_E_BADACCESSORHANDLE;
+    LeaveCriticalSection(&rt->cs);
+    return hr;
+}
+
+HRESULT rt_get_bindings(struct rowtable *rt, HACCESSOR h, DBACCESSORFLAGS *flags, DBCOUNTITEM *count,
+        DBBINDING **bindings)
+{
+    struct rt_accessor *acc;
+    HRESULT hr = S_OK;
+
+    if (!flags || !count || !bindings) return E_INVALIDARG;
+    *flags = 0;
+    *count = 0;
+    *bindings = NULL;
+
+    EnterCriticalSection(&rt->cs);
+    if ((acc = get_accessor(rt, h)))
+    {
+        if (acc->count)
+        {
+            *bindings = CoTaskMemAlloc(acc->count * sizeof(**bindings));
+            if (*bindings) memcpy(*bindings, acc->bindings, acc->count * sizeof(**bindings));
+            else hr = E_OUTOFMEMORY;
+        }
+        if (hr == S_OK)
+        {
+            *flags = acc->flags;
+            *count = acc->count;
+        }
+    }
+    else hr = DB_E_BADACCESSORHANDLE;
+    LeaveCriticalSection(&rt->cs);
+    return hr;
+}
+
+/* ---- rows ---- */
+
+static HRESULT add_row(struct rowtable *rt, struct rowdata *row, HROW *h)
+{
+    ULONG slot;
+
+    for (slot = 0; slot < rt->rows_cap; slot++)
+        if (!rt->rows[slot]) break;
+    if (slot == rt->rows_cap)
+    {
+        struct rowdata **n = realloc(rt->rows, (rt->rows_cap + 32) * sizeof(*n));
+        if (!n) return E_OUTOFMEMORY;
+        memset(n + rt->rows_cap, 0, 32 * sizeof(*n));
+        rt->rows = n;
+        rt->rows_cap += 32;
+    }
+    rt->rows[slot] = row;
+    *h = slot + 1;
+    return S_OK;
+}
+
+HRESULT rt_get_next_rows(struct rowtable *rt, rt_fetch_fn fetch, void *ctx, HCHAPTER chapter,
+        DBROWOFFSET offset, DBROWCOUNT count, DBCOUNTITEM *obtained, HROW **rows)
+{
+    HROW *out = NULL;
+    DBCOUNTITEM got = 0;
+    HRESULT hr = S_OK;
+
+    if (!obtained || !rows) return E_INVALIDARG;
+    *obtained = 0;
+    if (chapter) return DB_E_BADCHAPTER;
+    if (count < 0) return DB_E_CANTFETCHBACKWARDS;
+    if (offset < 0) return DB_E_CANTSCROLLBACKWARDS;
+
+    EnterCriticalSection(&rt->cs);
+    if (rt->ended && (count || offset))
+    {
+        LeaveCriticalSection(&rt->cs);
+        *rows = NULL;
+        return DB_S_ENDOFROWSET;
+    }
+
+    /* skip rows */
+    while (offset > 0)
+    {
+        struct rowdata *tmp = calloc(1, sizeof(*tmp));
+
+        if (tmp) tmp->cells = calloc(rt->ncols ? rt->ncols : 1, sizeof(struct cell));
+        if (!tmp || !tmp->cells) { free(tmp); hr = E_OUTOFMEMORY; break; }
+        hr = fetch(ctx, tmp->cells, rt->ncols);
+        free_row(tmp, rt->ncols);
+        rt->started = TRUE;
+        if (hr != S_OK) break;
+        offset--;
+    }
+
+    if (hr == S_OK && count)
+    {
+        if (!*rows)
+        {
+            out = CoTaskMemAlloc(count * sizeof(HROW));
+            if (!out) hr = E_OUTOFMEMORY;
+        }
+        else out = *rows;
+    }
+
+    while (hr == S_OK && got < (DBCOUNTITEM)count)
+    {
+        struct rowdata *row = calloc(1, sizeof(*row));
+
+        if (row) row->cells = calloc(rt->ncols ? rt->ncols : 1, sizeof(struct cell));
+        if (!row || !row->cells) { free(row); hr = E_OUTOFMEMORY; break; }
+        row->refs = 1;
+        hr = fetch(ctx, row->cells, rt->ncols);
+        rt->started = TRUE;
+        if (hr != S_OK)
+        {
+            free_row(row, rt->ncols);
+            break;
+        }
+        if (FAILED(hr = add_row(rt, row, &out[got])))
+        {
+            free_row(row, rt->ncols);
+            break;
+        }
+        got++;
+    }
+    if (hr == DB_S_ENDOFROWSET) rt->ended = TRUE;
+    LeaveCriticalSection(&rt->cs);
+
+    if (FAILED(hr))
+    {
+        if (!*rows) CoTaskMemFree(out);
+        *obtained = 0;
+        return hr;
+    }
+
+    *obtained = got;
+    if (!got && !*rows)
+    {
+        CoTaskMemFree(out);
+        out = NULL;
+    }
+    if (!*rows) *rows = out;
+    return hr;
+}
+
+HRESULT rt_restart(struct rowtable *rt, rt_restart_fn restart, void *ctx)
+{
+    HRESULT hr = S_OK;
+    ULONG i;
+
+    EnterCriticalSection(&rt->cs);
+    if (rt->started)
+    {
+        /* a forward-only result set cannot be re-read */
+        if (restart) hr = restart(ctx);
+        else hr = DB_E_CANTSCROLLBACKWARDS;
+        if (hr == S_OK)
+        {
+            rt->started = FALSE;
+            rt->ended = FALSE;
+        }
+    }
+    LeaveCriticalSection(&rt->cs);
+    (void)i;
+    return hr;
+}
+
+static struct rowdata *get_row(struct rowtable *rt, HROW h)
+{
+    if (!h || h > rt->rows_cap) return NULL;
+    return rt->rows[h - 1];
+}
+
+static HRESULT row_count_result(DBCOUNTITEM count, DBCOUNTITEM bad)
+{
+    if (!bad) return S_OK;
+    return bad == count ? DB_E_ERRORSOCCURRED : DB_S_ERRORSOCCURRED;
+}
+
+HRESULT rt_addref_rows(struct rowtable *rt, DBCOUNTITEM count, const HROW rows[], DBREFCOUNT ref_counts[],
+        DBROWSTATUS status[])
+{
+    DBCOUNTITEM i, bad = 0;
+
+    if (count && !rows) return E_INVALIDARG;
+    EnterCriticalSection(&rt->cs);
+    for (i = 0; i < count; i++)
+    {
+        struct rowdata *row = get_row(rt, rows[i]);
+
+        if (row)
+        {
+            row->refs++;
+            if (ref_counts) ref_counts[i] = row->refs;
+            if (status) status[i] = DBROWSTATUS_S_OK;
+        }
+        else
+        {
+            bad++;
+            if (ref_counts) ref_counts[i] = 0;
+            if (status) status[i] = DBROWSTATUS_E_INVALID;
+        }
+    }
+    LeaveCriticalSection(&rt->cs);
+    return row_count_result(count, bad);
+}
+
+HRESULT rt_release_rows(struct rowtable *rt, DBCOUNTITEM count, const HROW rows[], DBREFCOUNT ref_counts[],
+        DBROWSTATUS status[])
+{
+    DBCOUNTITEM i, bad = 0;
+
+    if (count && !rows) return E_INVALIDARG;
+    EnterCriticalSection(&rt->cs);
+    for (i = 0; i < count; i++)
+    {
+        struct rowdata *row = get_row(rt, rows[i]);
+
+        if (row)
+        {
+            if (ref_counts) ref_counts[i] = row->refs - 1;
+            if (!--row->refs)
+            {
+                free_row(row, rt->ncols);
+                rt->rows[rows[i] - 1] = NULL;
+            }
+            if (status) status[i] = DBROWSTATUS_S_OK;
+        }
+        else
+        {
+            bad++;
+            if (ref_counts) ref_counts[i] = 0;
+            if (status) status[i] = DBROWSTATUS_E_INVALID;
+        }
+    }
+    LeaveCriticalSection(&rt->cs);
+    return row_count_result(count, bad);
+}
+
+HRESULT rt_get_data(struct rowtable *rt, HROW hrow, HACCESSOR hacc, void *data)
+{
+    struct rt_accessor *acc;
+    struct rowdata *row;
+    IDataConvert *conv;
+    DBCOUNTITEM i, bad = 0;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&rt->cs);
+    row = get_row(rt, hrow);
+    acc = get_accessor(rt, hacc);
+    if (!row) { LeaveCriticalSection(&rt->cs); return DB_E_BADROWHANDLE; }
+    if (!acc) { LeaveCriticalSection(&rt->cs); return DB_E_BADACCESSORHANDLE; }
+    if (!(acc->flags & DBACCESSOR_ROWDATA)) { LeaveCriticalSection(&rt->cs); return DB_E_BADACCESSORTYPE; }
+    if (acc->count && !data) { LeaveCriticalSection(&rt->cs); return E_INVALIDARG; }
+    if (!(conv = get_converter(rt)) && acc->count)
+    {
+        LeaveCriticalSection(&rt->cs);
+        return E_FAIL;
+    }
+
+    for (i = 0; i < acc->count; i++)
+    {
+        const DBBINDING *b = &acc->bindings[i];
+        const struct cell *cell = &row->cells[b->iOrdinal - 1];
+        BYTE *base = data;
+        DBSTATUS dst_status = DBSTATUS_S_OK;
+        DBLENGTH dst_len = 0;
+        HRESULT chr = S_OK;
+
+        if (cell->status == DBSTATUS_S_ISNULL)
+        {
+            dst_status = DBSTATUS_S_ISNULL;
+            dst_len = 0;
+        }
+        else if (b->dwPart & DBPART_VALUE)
+        {
+            DBLENGTH maxlen = b->cbMaxLen;
+            void *dst;
+
+            if (b->wType & DBTYPE_BYREF) maxlen = sizeof(void *);
+            dst = base + b->obValue;
+            chr = IDataConvert_DataConvert(conv, cell->type, b->wType, cell->len, &dst_len,
+                                           cell->data, dst, maxlen, cell->status, &dst_status,
+                                           b->bPrecision, b->bScale, 0);
+            if (FAILED(chr))
+            {
+                if (dst_status == DBSTATUS_S_OK || dst_status == DBSTATUS_E_BADACCESSOR)
+                    dst_status = chr == DB_E_UNSUPPORTEDCONVERSION ? DBSTATUS_E_CANTCONVERTVALUE : DBSTATUS_E_CANTCREATE;
+                bad++;
+            }
+            else if (chr == DB_S_ERRORSOCCURRED)
+                bad++;
+        }
+        else
+        {
+            dst_status = DBSTATUS_S_OK;
+            dst_len = cell->len;
+        }
+
+        if (b->dwPart & DBPART_LENGTH)
+            *(DBLENGTH *)(base + b->obLength) = dst_len;
+        if (b->dwPart & DBPART_STATUS)
+            *(DBSTATUS *)(base + b->obStatus) = dst_status;
+    }
+    LeaveCriticalSection(&rt->cs);
+
+    if (bad)
+        hr = bad == acc->count ? DB_E_ERRORSOCCURRED : DB_S_ERRORSOCCURRED;
+    return hr;
+}
+
+/* ---- column info helpers ---- */
+
+HRESULT rt_map_column_ids(DBORDINAL count, const DBID dbids[], DBORDINAL ncols, const DBCOLUMNINFO *info,
+        DBORDINAL columns[])
+{
+    DBORDINAL i, j, bad = 0;
+
+    if (!count) return S_OK;
+    if (!dbids || !columns) return E_INVALIDARG;
+
+    for (i = 0; i < count; i++)
+    {
+        columns[i] = DB_INVALID_ORDINAL;
+        if (dbids[i].eKind == DBKIND_NAME && dbids[i].uName.pwszName)
+        {
+            for (j = 0; j < ncols; j++)
+            {
+                if (info[j].pwszName && !wcsicmp(info[j].pwszName, dbids[i].uName.pwszName))
+                {
+                    columns[i] = info[j].iOrdinal;
+                    break;
+                }
+            }
+        }
+        if (columns[i] == DB_INVALID_ORDINAL) bad++;
+    }
+    if (!bad) return S_OK;
+    return bad == count ? DB_E_ERRORSOCCURRED : DB_S_ERRORSOCCURRED;
+}
+
+HRESULT rt_can_convert(DBTYPE from, DBTYPE to, DBCONVERTFLAGS flags)
+{
+    IDataConvert *conv;
+    HRESULT hr;
+
+    if (flags & ~(DBCONVERTFLAGS_PARAMETER | DBCONVERTFLAGS_ISFIXEDLENGTH |
+                  DBCONVERTFLAGS_ISLONG | DBCONVERTFLAGS_FROMVARIANT))
+        return DB_E_BADCONVERTFLAG;
+
+    if (FAILED(hr = CoCreateInstance(&clsid_conversion_library, NULL, CLSCTX_INPROC_SERVER, &iid_data_convert,
+                                     (void **)&conv)))
+        return hr;
+    hr = IDataConvert_CanConvert(conv, from, to);
+    IDataConvert_Release(conv);
+    return hr;
+}
