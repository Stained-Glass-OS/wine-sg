diff --git a/dlls/msdasql/rowset.c b/dlls/msdasql/rowset.c
new file mode 100644
index 0000000..d3d22c3
--- /dev/null
+++ b/dlls/msdasql/rowset.c
@@ -0,0 +1,582 @@
+/*
+ * Row cache and accessor table shared by the MSDASQL rowsets
+ *
