+static const IRowsetInfoVtbl enum_rsinfo_vtbl =
+{
+    enum_rsinfo_QueryInterface,
+    enum_rsinfo_AddRef,
+    enum_rsinfo_Release,
+    enum_rsinfo_GetProperties,
+    enum_rsinfo_GetReferencedRowset,
+    enum_rsinfo_GetSpecification
+};
+
+/* the ODBC data sources known to the driver manager */
+static void load_data_sources(struct msdasql_enum_rowset *rowset)
+{
+    SQLHENV env = NULL;
+    SQLWCHAR name[SQL_MAX_DSN_LENGTH + 1], desc[256];
+    SQLSMALLINT namelen, desclen;
+    SQLUSMALLINT dir = SQL_FETCH_FIRST;
+
+    if (!SQL_SUCCEEDED(SQLAllocHandle(SQL_HANDLE_ENV, NULL, &env)))
+        return;
+    if (SQLSetEnvAttr(env, SQL_ATTR_ODBC_VERSION, (void *)SQL_OV_ODBC3, 0) == SQL_ERROR)
+    {
+        SQLFreeHandle(SQL_HANDLE_ENV, env);
+        return;
+    }
+
+    while (SQL_SUCCEEDED(SQLDataSourcesW(env, dir, name, ARRAY_SIZE(name), &namelen, desc, ARRAY_SIZE(desc),
+                                         &desclen)))
+    {
+        struct source_row *n = realloc(rowset->sources, (rowset->source_count + 1) * sizeof(*n));
+
+        dir = SQL_FETCH_NEXT;
+        if (!n) break;
+        rowset->sources = n;
+        n[rowset->source_count].name = wcsdup(name);
+        n[rowset->source_count].description = wcsdup(desc);
+        if (!n[rowset->source_count].name || !n[rowset->source_count].description)
+        {
+            free(n[rowset->source_count].name);
+            free(n[rowset->source_count].description);
+            break;
+        }
+        rowset->source_count++;
+    }
+
+    SQLFreeHandle(SQL_HANDLE_ENV, env);
+}
+
 static HRESULT WINAPI msdasql_enum_GetSourcesRowset(ISourcesRowset *iface, IUnknown *outer, REFIID riid, ULONG sets,
                 DBPROPSET properties[], IUnknown **rowset)
 {
@@ -1022,10 +1383,20 @@ static HRESULT WINAPI msdasql_enum_GetSourcesRowset(ISourcesRowset *iface, IUnkn
 
     TRACE("(%p) %p, %s, %lu, %p, %p\n", enumerator, outer, debugstr_guid(riid), sets, properties, rowset);
 
-    enum_rs = malloc(sizeof(*enum_rs));
+    if (!rowset) return E_INVALIDARG;
+    *rowset = NULL;
+    if (outer) return DB_E_NOAGGREGATION;
+
+    enum_rs = calloc(1, sizeof(*enum_rs));
+    if (!enum_rs) return E_OUTOFMEMORY;
     enum_rs->IRowset_iface.lpVtbl = &enum_rowset_vtbl;
     enum_rs->IAccessor_iface.lpVtbl = &enum_accessor_vtbl;
+    enum_rs->IColumnsInfo_iface.lpVtbl = &enum_colsinfo_vtbl;
+    enum_rs->IRowsetInfo_iface.lpVtbl = &enum_rsinfo_vtbl;
     enum_rs->ref = 1;
+    /* the bookmark column is not part of the row data */
+    rt_init(&enum_rs->table, ARRAY_SIZE(source_columns) - 1);
+    load_data_sources(enum_rs);
 
     hr = IRowset_QueryInterface(&enum_rs->IRowset_iface, riid, (void**)rowset);
     IRowset_Release(&enum_rs->IRowset_iface);
