+static HRESULT stmt_fetch_row(void *ctx, struct cell *cells, DBORDINAL ncols)
+{
+    struct msdasql_rowset *rowset = ctx;
+    DBORDINAL i;
+    SQLRETURN ret;
+
+    ret = SQLFetch(rowset->hstmt);
+    if (ret == SQL_NO_DATA)
+        return DB_S_ENDOFROWSET;
+    if (!SQL_SUCCEEDED(ret))
+    {
+        dump_sql_diag_records(SQL_HANDLE_STMT, rowset->hstmt);
+        return E_FAIL;
+    }
+
+    for (i = 0; i < ncols; i++)
+    {
+        DBTYPE dbtype = sqltype_to_bindtype(rowset->sqltypes[i], !rowset->unsigned_cols[i]);
+        SQLLEN size = 0, ind;
+        SQLSMALLINT ctype = native_ctype(dbtype, &size);
+        BYTE *buf = NULL;
+        SQLLEN used = 0;
+        BYTE chunk[4096];
+
+        if (ctype)
+        {
+            buf = calloc(1, size + sizeof(WCHAR));
+            if (!buf) return E_OUTOFMEMORY;
+            ret = SQLGetData(rowset->hstmt, i + 1, ctype, buf, size, &ind);
+            if (!SQL_SUCCEEDED(ret))
+            {
+                free(buf);
+                return E_FAIL;
+            }
+            if (ind == SQL_NULL_DATA)
+            {
+                free(buf);
+                cells[i].status = DBSTATUS_S_ISNULL;
+                continue;
+            }
+            cells[i].type = dbtype;
+            cells[i].data = buf;
+            cells[i].len = size;
+            cells[i].status = DBSTATUS_S_OK;
+            continue;
+        }
+
+        if (dbtype == DBTYPE_BYTES)
+        {
+            ctype = SQL_C_BINARY;
+            dbtype = DBTYPE_BYTES;
+        }
+        else
+        {
+            ctype = SQL_C_WCHAR;
+            dbtype = DBTYPE_WSTR;
+        }
+
+        for (;;)
+        {
+            SQLLEN got;
+
+            ret = SQLGetData(rowset->hstmt, i + 1, ctype, chunk, ctype == SQL_C_WCHAR ? sizeof(chunk) : sizeof(chunk),
+                             &ind);
+            if (ret == SQL_NO_DATA) break;
+            if (!SQL_SUCCEEDED(ret))
+            {
+                free(buf);
+                return E_FAIL;
+            }
+            if (ind == SQL_NULL_DATA)
+            {
+                free(buf);
+                buf = NULL;
+                used = -1;
+                break;
+            }
+            if (ret == SQL_SUCCESS_WITH_INFO && (ind == SQL_NO_TOTAL || ind > (SQLLEN)sizeof(chunk) -
+                    (ctype == SQL_C_WCHAR ? (SQLLEN)sizeof(WCHAR) : 0)))
+                got = sizeof(chunk) - (ctype == SQL_C_WCHAR ? sizeof(WCHAR) : 0);
+            else
+                got = ind;
+            if (FAILED(append_data(&buf, &used, chunk, got)))
+            {
+                free(buf);
+                return E_OUTOFMEMORY;
+            }
+            if (ret == SQL_SUCCESS) break;
+        }
+
+        if (used < 0)
+        {
+            cells[i].status = DBSTATUS_S_ISNULL;
+            continue;
+        }
+        if (!buf)
+            buf = calloc(1, sizeof(WCHAR));
+        if (!buf) return E_OUTOFMEMORY;
+        memset(buf + used, 0, sizeof(WCHAR));
+        cells[i].type = dbtype;
+        cells[i].data = buf;
+        cells[i].len = used;
+        cells[i].status = DBSTATUS_S_OK;
+    }
+
+    return S_OK;
 }
 
