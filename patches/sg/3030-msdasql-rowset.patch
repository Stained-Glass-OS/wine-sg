+static HRESULT append_data(BYTE **buf, SQLLEN *used, const void *data, SQLLEN len)
+{
+    BYTE *n = realloc(*buf, *used + len + sizeof(WCHAR));
+
+    if (!n) return E_OUTOFMEMORY;
+    memcpy(n + *used, data, len);
+    *used += len;
+    *buf = n;
+    return S_OK;
+}
+
+/* the SQL C type used to read a column of the given type, or 0 for text/binary */
+static SQLSMALLINT native_ctype(DBTYPE type, SQLLEN *size)
+{
+    switch (type)
+    {
+    case DBTYPE_I1:  *size = 1; return SQL_C_STINYINT;
+    case DBTYPE_I2:  *size = 2; return SQL_C_SSHORT;
+    case DBTYPE_UI2: *size = 2; return SQL_C_USHORT;
+    case DBTYPE_I4:  *size = 4; return SQL_C_SLONG;
+    case DBTYPE_UI4: *size = 4; return SQL_C_ULONG;
+    case DBTYPE_I8:  *size = 8; return SQL_C_SBIGINT;
+    case DBTYPE_R4:  *size = 4; return SQL_C_FLOAT;
+    case DBTYPE_R8:  *size = 8; return SQL_C_DOUBLE;
+    case DBTYPE_GUID: *size = sizeof(GUID); return SQL_C_GUID;
+    case DBTYPE_DBDATE: *size = sizeof(DBDATE); return SQL_C_TYPE_DATE;
+    case DBTYPE_DBTIME: *size = sizeof(DBTIME); return SQL_C_TYPE_TIME;
+    case DBTYPE_DBTIMESTAMP: *size = sizeof(DBTIMESTAMP); return SQL_C_TYPE_TIMESTAMP;
+    default: return 0;
+    }
+}
