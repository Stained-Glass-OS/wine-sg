+/* Drawing starts from what the bitmap holds now: a program may put new
+ * pixels in it between uses of the same target (Paint.NET reuses one target
+ * for different tiles of a brush stroke's mask). */
+static void d2d_wic_render_target_begin_draw(IUnknown *outer_unknown)
+{
+    struct d2d_wic_render_target *render_target = impl_from_IUnknown(outer_unknown);
+    WICRect all = {0, 0, render_target->width, render_target->height};
+    ID3D10Resource *resource;
+    IWICBitmapLock *lock;
+    ID3D10Device *device;
+    UINT size, stride;
+    BYTE *data;
+
+    if (FAILED(IWICBitmap_Lock(render_target->bitmap, &all, WICBitmapLockRead, &lock)))
+        return;
+    if (SUCCEEDED(IWICBitmapLock_GetDataPointer(lock, &size, &data))
+            && SUCCEEDED(IWICBitmapLock_GetStride(lock, &stride))
+            && stride >= render_target->bpp * render_target->width
+            && SUCCEEDED(IDXGISurface_QueryInterface(render_target->dxgi_surface,
+                    &IID_ID3D10Resource, (void **)&resource)))
+    {
+        if (render_target->cs)
+            EnterCriticalSection(render_target->cs);
+        ID3D10Texture2D_GetDevice(render_target->readback_texture, &device);
+        ID3D10Device_UpdateSubresource(device, resource, 0, NULL, data, stride, 0);
+        ID3D10Device_Release(device);
+        if (render_target->cs)
+            LeaveCriticalSection(render_target->cs);
+        ID3D10Resource_Release(resource);
+    }
+    IWICBitmapLock_Release(lock);
+}
+
 static const struct d2d_device_context_ops d2d_wic_render_target_ops =
 {
     d2d_wic_render_target_present,
+    d2d_wic_render_target_begin_draw,
 };
 
