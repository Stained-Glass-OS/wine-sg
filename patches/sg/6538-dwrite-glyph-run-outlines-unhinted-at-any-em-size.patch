From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: Glyph run outlines unhinted, at any em size (6538)

GetGlyphRunOutline loaded each glyph at the requested em size, hinted,
and gave its points rounded to 1/64 of a DIP. cairo's DirectWrite font
backend asks for outlines at an em size of 1 and scales them up itself,
so at 1 px the hinted, rounded outlines were broken: Pango's path text
(RawTherapee's image information over the photo, GTK programs that draw
text as paths) showed glyphs with missing strokes and wrong shapes.

The outline is now the glyph's design outline, unhinted, scaled to the
em size (as on Windows); bold simulation emboldens it by the same share
of the em. Fonts without outlines are as before.
---
 dlls/dwrite/freetype.c | 39 ++++++++++++++++++++++++++++++++-------
 1 file changed, 32 insertions(+), 7 deletions(-)

diff --git a/dlls/dwrite/freetype.c b/dlls/dwrite/freetype.c
index 18b2a92..7695324 100644
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -244,17 +244,20 @@ static NTSTATUS get_design_glyph_metrics(void *args)
 struct decompose_context
 {
     struct dwrite_outline *outline;
+    float scale;      /* outline units to DIPs */
     BOOL figure_started;
     BOOL move_to;     /* last call was 'move_to' */
     FT_Vector origin; /* 'pen' position from last call */
 };
 
-static inline void ft_vector_to_d2d_point(const FT_Vector *v, D2D1_POINT_2F *p)
+static inline void ft_vector_to_d2d_point_scaled(const FT_Vector *v, D2D1_POINT_2F *p, float scale)
 {
-    p->x = v->x / 64.0f;
-    p->y = v->y / 64.0f;
+    p->x = v->x * scale;
+    p->y = v->y * scale;
 }
 
+#define ft_vector_to_d2d_point(v, p) ft_vector_to_d2d_point_scaled(v, p, ctxt->scale)
+
 static int dwrite_outline_push_tag(struct dwrite_outline *outline, unsigned char tag)
 {
     if (outline->tags.size < outline->tags.count + 1)
@@ -400,7 +403,7 @@ static int decompose_cubic_to(const FT_Vector *control1, const FT_Vector *contro
     return 0;
 }
 
-static int decompose_outline(FT_Outline *ft_outline, struct dwrite_outline *outline)
+static int decompose_outline(FT_Outline *ft_outline, struct dwrite_outline *outline, float scale)
 {
     static const FT_Outline_Funcs decompose_funcs =
     {
@@ -415,6 +418,7 @@ static int decompose_outline(FT_Outline *ft_outline, struct dwrite_outline *outl
     int ret;
 
     context.outline = outline;
+    context.scale = scale;
 
     ret = pFT_Outline_Decompose(ft_outline, &decompose_funcs, &context);
 
@@ -451,10 +455,25 @@ static NTSTATUS get_glyph_outline(void *args)
     FT_Face face = FaceFromObject(params->object);
     FT_Size size;
 
+    FT_Int load_flags = FT_LOAD_NO_BITMAP;
+    float scale = 1.0f / 64.0f;
+
     if (!(size = freetype_set_face_size(face, params->emsize)))
         return STATUS_UNSUCCESSFUL;
 
-    if (!pFT_Load_Glyph(face, params->glyph, FT_LOAD_NO_BITMAP))
+#ifndef SG_MUTANT_DWRITE_OUTLINE_HINTED
+    /* Stained Glass OS (wine-sg 6538): the outline in design units, unhinted, scaled to the em size
+     * here, as Windows gives it. Loaded at the em size it was hinted and rounded to 1/64 of a DIP:
+     * cairo asks for outlines at an em size of 1 and scales them up, and its path text (Pango in
+     * RawTherapee, GIMP, Inkscape on Windows builds) came out as broken glyphs. */
+    if (FT_IS_SCALABLE(face) && face->units_per_EM)
+    {
+        load_flags |= FT_LOAD_NO_SCALE;
+        scale = params->emsize / face->units_per_EM;
+    }
+#endif
+
+    if (!pFT_Load_Glyph(face, params->glyph, load_flags))
     {
         FT_Outline *ft_outline = &face->glyph->outline;
         FT_Matrix m;
@@ -462,7 +481,13 @@ static NTSTATUS get_glyph_outline(void *args)
         if (params->outline->points.values)
         {
             if (params->simulations & DWRITE_FONT_SIMULATIONS_BOLD)
-                embolden_glyph_outline(ft_outline, params->emsize);
+            {
+                if (load_flags & FT_LOAD_NO_SCALE)
+                    pFT_Outline_EmboldenXY ? pFT_Outline_EmboldenXY(ft_outline, face->units_per_EM / 24, 0)
+                                           : pFT_Outline_Embolden(ft_outline, face->units_per_EM / 24);
+                else
+                    embolden_glyph_outline(ft_outline, params->emsize);
+            }
 
             m.xx = 1 << 16;
             m.xy = params->simulations & DWRITE_FONT_SIMULATIONS_OBLIQUE ? (1 << 16) / 3 : 0;
@@ -471,7 +496,7 @@ static NTSTATUS get_glyph_outline(void *args)
 
             pFT_Outline_Transform(ft_outline, &m);
 
-            decompose_outline(ft_outline, params->outline);
+            decompose_outline(ft_outline, params->outline, scale);
         }
         else
         {
