From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: a class registered for the user is found first (6029)

COM looked for classes and AppIDs in the machine's HKLM\Software\Classes
alone; on Windows HKEY_CLASSES_ROOT is the user's HKCU\Software\Classes
over the machine's, and per-user installs (updaters, chat programs,
toast activators, a package's COM servers) register their classes
there: CoCreateInstance failed with REGDB_E_CLASSNOTREG. A user's
CLSID or AppID key (with the subkey asked for) now comes first; an
elevated process uses the machine's alone, as on Windows.
---
diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 84209cc..96628b4 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -302,6 +302,48 @@ static LSTATUS open_classes_key(HKEY hkey, const WCHAR *name, REGSAM access, HKE
     return RtlNtStatusToDosError(NtOpenKey((HANDLE *)retkey, access, &attr));
 }
 
+/* Stained Glass OS: a class or AppID registered for the user (HKCU\Software\Classes, the user's part of
+ * HKEY_CLASSES_ROOT) comes before the machine's, as COM finds them on Windows -- per-user installs
+ * (updaters, chat programs, a package's COM servers) register there. An elevated process uses the
+ * machine's alone, so a user's registration cannot reach code running with full rights. */
+static BOOL use_user_classes(void)
+{
+    TOKEN_ELEVATION elevation;
+    HANDLE token;
+    DWORD size;
+    BOOL elevated = FALSE;
+
+    if (OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token ))
+    {
+        if (GetTokenInformation( token, TokenElevation, &elevation, sizeof(elevation), &size ))
+            elevated = elevation.TokenIsElevated;
+        CloseHandle( token );
+    }
+    return !elevated;
+}
+
+static LSTATUS open_user_classes_key(const WCHAR *path, const WCHAR *keyname, REGSAM access, HKEY *retkey)
+{
+    WCHAR full[MAX_PATH];
+    HKEY key;
+    LSTATUS res;
+
+#ifdef SG_MUTANT_COM_NO_USER_CLASSES
+    return ERROR_FILE_NOT_FOUND;
+#endif
+    if (wcslen( path ) + 20 >= ARRAY_SIZE(full) || !use_user_classes()) return ERROR_FILE_NOT_FOUND;
+    swprintf( full, ARRAY_SIZE(full), L"Software\\Classes\\%s", path );
+    if ((res = RegOpenKeyExW( HKEY_CURRENT_USER, full, 0, access, &key ))) return res;
+    if (!keyname)
+    {
+        *retkey = key;
+        return ERROR_SUCCESS;
+    }
+    res = RegOpenKeyExW( key, keyname, 0, access, retkey );
+    RegCloseKey( key );
+    return res;
+}
+
 HRESULT open_key_for_clsid(REFCLSID clsid, const WCHAR *keyname, REGSAM access, HKEY *subkey)
 {
     static const WCHAR clsidW[] = L"CLSID\\";
@@ -311,6 +353,7 @@ HRESULT open_key_for_clsid(REFCLSID clsid, const WCHAR *keyname, REGSAM access,
 
     lstrcpyW(path, clsidW);
     StringFromGUID2(clsid, path + lstrlenW(clsidW), CHARS_IN_GUID);
+    if (!open_user_classes_key(path, keyname, access, subkey)) return S_OK;
     res = open_classes_key(HKEY_CLASSES_ROOT, path, access, &key);
     if (res == ERROR_FILE_NOT_FOUND)
         return REGDB_E_CLASSNOTREG;
@@ -360,6 +403,7 @@ HRESULT open_appidkey_from_clsid(REFCLSID clsid, REGSAM access, HKEY *subkey)
 
     lstrcpyW(keyname, appidkeyW);
     lstrcatW(keyname, buf);
+    if (!open_user_classes_key(keyname, NULL, access, subkey)) return S_OK;
     res = open_classes_key(HKEY_CLASSES_ROOT, keyname, access, subkey);
     if (res == ERROR_FILE_NOT_FOUND)
         return REGDB_E_KEYMISSING;
