From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] advapi32: CredReadDomainCredentials (3746)

advapi32: CredReadDomainCredentials

Looks the credentials of a server and a domain up by the names of the target
information (server before domain, wildcards as CredFindBestCredential), one
per credential type, in one block that CredFree frees; a domain password
comes without its blob. It always answered ERROR_NOT_FOUND.
---
diff --git a/dlls/advapi32/cred.c b/dlls/advapi32/cred.c
index 93e07dd..f6d9bf0 100644
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1943,10 +1943,27 @@ BOOL WINAPI CredReadDomainCredentialsA(PCREDENTIAL_TARGET_INFORMATIONA TargetInf
 /******************************************************************************
  * CredReadDomainCredentialsW [ADVAPI32.@]
  */
+#ifndef CRED_CACHE_TARGET_INFORMATION
+#define CRED_CACHE_TARGET_INFORMATION 0x1
+#endif
+
+/* defined after CredFindBestCredentialW */
+static DWORD cred_block_size(const CREDENTIALW *cred);
+static char *cred_block_copy(const CREDENTIALW *cred, char *dst);
+BOOL WINAPI CredFindBestCredentialW( LPCWSTR target, DWORD type, DWORD flags, PCREDENTIALW *cred );
+
 BOOL WINAPI CredReadDomainCredentialsW(PCREDENTIAL_TARGET_INFORMATIONW TargetInformation, DWORD Flags,
                                        DWORD *Size, PCREDENTIALW **Credentials)
 {
-    FIXME("(%p, 0x%lx, %p, %p) stub\n", TargetInformation, Flags, Size, Credentials);
+    static const DWORD domain_types[] = { CRED_TYPE_DOMAIN_PASSWORD, CRED_TYPE_DOMAIN_CERTIFICATE,
+                                          CRED_TYPE_DOMAIN_VISIBLE_PASSWORD };
+    const WCHAR *names[6];
+    CREDENTIALW *found[ARRAY_SIZE(domain_types) * ARRAY_SIZE(names)];
+    const DWORD *types;
+    DWORD type_count, i, j, count = 0, total;
+    char *block;
+
+    TRACE("(%p, 0x%lx, %p, %p)\n", TargetInformation, Flags, Size, Credentials);
 
     /* follow Windows behavior - do not test for NULL, initialize early */
     *Size = 0;
@@ -1956,9 +1973,84 @@ BOOL WINAPI CredReadDomainCredentialsW(PCREDENTIAL_TARGET_INFORMATIONW TargetInf
         SetLastError(ERROR_INVALID_PARAMETER);
         return FALSE;
     }
+    if (Flags & ~CRED_CACHE_TARGET_INFORMATION)
+    {
+        SetLastError(ERROR_INVALID_FLAGS);
+        return FALSE;
+    }
 
-    SetLastError(ERROR_NOT_FOUND);
-    return FALSE;
+    /* the names the credentials are looked up by, the most specific first; the types are those the target
+     * information lists, else the domain types */
+    j = 0;
+    if (TargetInformation->DnsServerName) names[j++] = TargetInformation->DnsServerName;
+    if (TargetInformation->NetbiosServerName) names[j++] = TargetInformation->NetbiosServerName;
+    if (TargetInformation->TargetName) names[j++] = TargetInformation->TargetName;
+    if (TargetInformation->DnsDomainName) names[j++] = TargetInformation->DnsDomainName;
+    if (TargetInformation->NetbiosDomainName) names[j++] = TargetInformation->NetbiosDomainName;
+    if (TargetInformation->DnsTreeName) names[j++] = TargetInformation->DnsTreeName;
+    if (!j)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (TargetInformation->CredTypeCount && TargetInformation->CredTypes)
+    {
+        types = TargetInformation->CredTypes;
+        type_count = min(TargetInformation->CredTypeCount, ARRAY_SIZE(domain_types));
+    }
+    else
+    {
+        types = domain_types;
+        type_count = ARRAY_SIZE(domain_types);
+    }
+
+    /* per type, the credential of the first name that has one (CredFindBestCredential also matches "*.domain") */
+    for (i = 0; i < type_count; i++)
+    {
+        DWORD k;
+
+        if (types[i] != CRED_TYPE_DOMAIN_PASSWORD && types[i] != CRED_TYPE_GENERIC) continue;  /* what CredRead can read */
+        for (k = 0; k < j; k++)
+        {
+            CREDENTIALW *cred;
+
+            if (!CredFindBestCredentialW(names[k], types[i], 0, &cred)) continue;
+            found[count++] = cred;
+            break;
+        }
+    }
+    if (!count)
+    {
+        SetLastError(ERROR_NOT_FOUND);
+        return FALSE;
+    }
+
+    /* one block for the array and what the entries point to, freed by CredFree */
+    /* a domain password is not given back: its blob comes empty (as the Wine tests record for Windows) */
+    for (i = 0; i < count; i++)
+        if (found[i]->Type == CRED_TYPE_DOMAIN_PASSWORD)
+        {
+            found[i]->CredentialBlobSize = 0;
+            found[i]->CredentialBlob = NULL;
+        }
+    total = count * sizeof(CREDENTIALW *);
+    for (i = 0; i < count; i++) total += cred_block_size(found[i]);
+    if (!(block = malloc(total)))
+    {
+        for (i = 0; i < count; i++) CredFree(found[i]);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    *Credentials = (CREDENTIALW **)block;
+    block += count * sizeof(CREDENTIALW *);
+    for (i = 0; i < count; i++)
+    {
+        (*Credentials)[i] = (CREDENTIALW *)block;
+        block = cred_block_copy(found[i], block);
+        CredFree(found[i]);
+    }
+    *Size = count;
+    return TRUE;
 }
 
 /******************************************************************************
@@ -2786,6 +2878,62 @@ static int target_match( const WCHAR *pattern, const WCHAR *target )
     return 0;
 }
 
+/* a credential and all it points to, in one block (CredFree frees the first entry's block) */
+static DWORD cred_block_size(const CREDENTIALW *cred)
+{
+    DWORD i, size = sizeof(*cred);
+
+    #define STRSIZE(s) ((s) ? (lstrlenW(s) + 1) * sizeof(WCHAR) : 0)
+    size += STRSIZE(cred->TargetName) + STRSIZE(cred->Comment) + STRSIZE(cred->TargetAlias) + STRSIZE(cred->UserName);
+    size += cred->CredentialBlobSize + cred->AttributeCount * sizeof(CREDENTIAL_ATTRIBUTEW);
+    for (i = 0; i < cred->AttributeCount; i++)
+        size += STRSIZE(cred->Attributes[i].Keyword) + cred->Attributes[i].ValueSize;
+    #undef STRSIZE
+    return size;
+}
+
+static char *cred_block_copy(const CREDENTIALW *cred, char *dst)
+{
+    CREDENTIALW *out = (CREDENTIALW *)dst;
+    DWORD i;
+
+    #define COPYSTR(field) do { if (cred->field) { DWORD n = (lstrlenW(cred->field) + 1) * sizeof(WCHAR); \
+        out->field = (WCHAR *)dst; memcpy(dst, cred->field, n); dst += n; } } while (0)
+    *out = *cred;
+    dst += sizeof(*out);
+    COPYSTR(TargetName); COPYSTR(Comment); COPYSTR(TargetAlias); COPYSTR(UserName);
+    #undef COPYSTR
+    if (cred->CredentialBlobSize)
+    {
+        out->CredentialBlob = (BYTE *)dst;
+        memcpy(dst, cred->CredentialBlob, cred->CredentialBlobSize);
+        dst += cred->CredentialBlobSize;
+    }
+    if (cred->AttributeCount)
+    {
+        out->Attributes = (CREDENTIAL_ATTRIBUTEW *)dst;
+        dst += cred->AttributeCount * sizeof(CREDENTIAL_ATTRIBUTEW);
+        for (i = 0; i < cred->AttributeCount; i++)
+        {
+            out->Attributes[i] = cred->Attributes[i];
+            if (cred->Attributes[i].Keyword)
+            {
+                DWORD n = (lstrlenW(cred->Attributes[i].Keyword) + 1) * sizeof(WCHAR);
+                out->Attributes[i].Keyword = (WCHAR *)dst;
+                memcpy(dst, cred->Attributes[i].Keyword, n);
+                dst += n;
+            }
+            if (cred->Attributes[i].ValueSize)
+            {
+                out->Attributes[i].Value = (BYTE *)dst;
+                memcpy(dst, cred->Attributes[i].Value, cred->Attributes[i].ValueSize);
+                dst += cred->Attributes[i].ValueSize;
+            }
+        }
+    }
+    return dst;
+}
+
 /******************************************************************************
  * CredFindBestCredentialW [ADVAPI32.@]
  */
