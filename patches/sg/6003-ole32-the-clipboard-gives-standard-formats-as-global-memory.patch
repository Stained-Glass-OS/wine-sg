From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ole32: the OLE clipboard offers the standard formats of other programs as global memory (6003)

OleGetClipboard's data object gave formats put on the clipboard without OLE a
medium of TYMED_NULL unless they were text, metafiles or CF_BITMAP, so asking
it for CF_DIB (the picture Paint copies) failed with DV_E_TYMED. CF_DIB,
CF_DIBV5, CF_SYLK, CF_DIF, CF_TIFF, CF_RIFF, CF_WAVE, CF_LOCALE, CF_PENDATA
and CF_DSPTEXT are global memory (TYMED_HGLOBAL).
---
 dlls/ole32/clipboard.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/dlls/ole32/clipboard.c b/dlls/ole32/clipboard.c
index 23ef643..7f17a95 100644
--- a/dlls/ole32/clipboard.c
+++ b/dlls/ole32/clipboard.c
@@ -1204,6 +1204,21 @@ static DWORD get_tymed_from_nonole_cf(UINT cf)
         return TYMED_MFPICT;
     case CF_BITMAP:
         return TYMED_GDI;
+#ifndef SG_MUTANT_CLIP_DIB_TYMED
+    /* Stained Glass OS: the other standard formats are global memory (a
+     * picture copied by Paint is CF_DIB) */
+    case CF_DIB:
+    case CF_DIBV5:
+    case CF_SYLK:
+    case CF_DIF:
+    case CF_TIFF:
+    case CF_RIFF:
+    case CF_WAVE:
+    case CF_LOCALE:
+    case CF_PENDATA:
+    case CF_DSPTEXT:
+        return TYMED_HGLOBAL;
+#endif
     default:
         FIXME("returning TYMED_NULL for cf %04x\n", cf);
         return TYMED_NULL;
