From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: an administrator's linked token can be copied to identify, as on Windows

WireGuard's tray window learns whether its person is an administrator as
Windows programs commonly do (elevate.TokenIsElevatedOrElevatable): its own
token, or its linked token -> DuplicateTokenEx(TOKEN_QUERY|TOKEN_IMPERSONATE,
SecurityIdentification, TokenImpersonation) -> CheckTokenMembership
(Administrators). The linked token of an unelevated administrator (7737) was
handed to a caller without SeTcbPrivilege query-only, so DuplicateTokenEx
failed with ERROR_ACCESS_DENIED and the window hid its Add Tunnel toolbar,
Import button and editing (i1013).

As Windows gives it, the handle now also has TOKEN_DUPLICATE. The token is
marked as an identification token handed out without consent, and so are its
copies: it is never a process's token (a primary token from it fails with
STATUS_BAD_IMPERSONATION_LEVEL, as Windows refuses one from an
identification-level token) nor a thread's (SetThreadToken fails with
STATUS_BAD_IMPERSONATION_LEVEL; Windows takes it and then refuses every access
made with it), and a copy cannot raise its level (as before). Elevation still
goes through consent and the broker.

Gate test/splittoken-gate.sh (identification copy, its limits, and a program
removing its own privileges as WireGuard's tray window does); mutants
SG_MUTANT_LINKED_NO_DUPLICATE, SG_MUTANT_IDENTIFY_TOKEN_PRIMARY,
SG_MUTANT_IDENTIFY_TOKEN_IMPERSONATE.
---
--- a/server/token.c
+++ b/server/token.c
@@ -151,6 +151,10 @@
      * known), and the requester a LogonUser token was given to (~0: none) */
     unsigned int   sg_unix_uid;
     unsigned int   sg_logon_for;
+    /* Stained Glass OS (vpn2, i1013): a person's linked full token as handed to a caller without
+     * SeTcbPrivilege, and its copies: an identification-level token, used to identify only -- it is
+     * never a thread's or a process's token (elevation goes through consent and the broker) */
+    int            sg_identify_only;
 };
 
 struct privilege
@@ -225,6 +229,18 @@
                                                               handle,
                                                               TOKEN_IMPERSONATE,
                                                               &token_ops );
+        /* a person's linked full token, at identification level, identifies; it does not act
+         * (Windows takes such a token, then refuses every access made with it) */
+#ifndef SG_MUTANT_IDENTIFY_TOKEN_IMPERSONATE
+        if (token && token->sg_identify_only)
+#else
+        if (0)
+#endif
+        {
+            release_object( token );
+            set_error( STATUS_BAD_IMPERSONATION_LEVEL );
+            return;
+        }
         if (token)
         {
             if (thread->token)
@@ -1085,6 +1101,7 @@
         token->write_restricted = 0;
         token->sg_unix_uid = ~0u;
         token->sg_logon_for = ~0u;
+        token->sg_identify_only = 0;
         token->user_deny_only = 0;
         token->package_sid = NULL;
         token->capabilities = NULL;
@@ -1212,6 +1229,14 @@
         set_error( STATUS_BAD_IMPERSONATION_LEVEL );
         return NULL;
     }
+    /* as on Windows, an identification-level token is no process's token */
+#ifndef SG_MUTANT_IDENTIFY_TOKEN_PRIMARY
+    if (primary && src_token->sg_identify_only)
+    {
+        set_error( STATUS_BAD_IMPERSONATION_LEVEL );
+        return NULL;
+    }
+#endif
 
     token = create_token( primary, src_token->session_id, src_token->user, NULL, 0,
                           NULL, 0, src_token->default_dacl, modified_id,
@@ -1219,6 +1244,7 @@
     if (!token) return token;
     token->sg_unix_uid = src_token->sg_unix_uid;
     token->sg_logon_for = src_token->sg_logon_for;
+    token->sg_identify_only = src_token->sg_identify_only;
 
     if (src_token->restricted_count)
     {
@@ -2988,9 +3014,19 @@
             }
             else
             {
+                /* a caller without SeTcbPrivilege may query it and duplicate it at identification
+                 * level, as Windows lets it: WireGuard's tray window learns that its person is an
+                 * administrator so (DuplicateTokenEx, then CheckTokenMembership), and drew no
+                 * Add Tunnel toolbar, Import button or editing otherwise (i1013) */
+                int admin_req = sg_requester_is_admin();
+                if (!admin_req) linked->sg_identify_only = 1;
                 reply->linked = alloc_handle( current->process, linked,
-                                              sg_requester_is_admin() ? TOKEN_ALL_ACCESS
-                                                                      : TOKEN_QUERY | TOKEN_QUERY_SOURCE | READ_CONTROL, 0 );
+                                              admin_req ? TOKEN_ALL_ACCESS
+#ifdef SG_MUTANT_LINKED_NO_DUPLICATE
+                                                        : TOKEN_QUERY | TOKEN_QUERY_SOURCE | READ_CONTROL, 0 );
+#else
+                                                        : TOKEN_QUERY | TOKEN_QUERY_SOURCE | READ_CONTROL | TOKEN_DUPLICATE, 0 );
+#endif
                 release_object( linked );
             }
             release_object( token );
