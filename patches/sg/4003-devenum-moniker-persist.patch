From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] devenum: Device monikers persist and compare, property bag value types.

Device monikers answer IsDirty, Load/Save (their display name),
GetSizeMax, ComposeWith, Enum and IsRunning like other monikers, the
moniker enumerator can be cloned, and the property bag reads REG_EXPAND_SZ
and REG_QWORD values. DllUnregisterServer removes the categories it
registered. Unknown classes log a WARN.
---
 dlls/devenum/devenum_main.c |  24 +++++-
 dlls/devenum/mediacatenum.c | 191 ++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 196 insertions(+), 19 deletions(-)

diff --git a/dlls/devenum/devenum_main.c b/dlls/devenum/devenum_main.c
index 8793974..def933b 100644
--- a/dlls/devenum/devenum_main.c
+++ b/dlls/devenum/devenum_main.c
@@ -107,7 +107,7 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, void **obj)
     else if (IsEqualGUID(clsid, &CLSID_CDeviceMoniker))
         return IClassFactory_QueryInterface(&device_moniker_cf.IClassFactory_iface, iid, obj);
 
-    FIXME("class %s not available\n", debugstr_guid(clsid));
+    WARN("class %s not available\n", debugstr_guid(clsid));
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
@@ -153,6 +153,26 @@ HRESULT WINAPI DllRegisterServer(void)
  */
 HRESULT WINAPI DllUnregisterServer(void)
 {
-    FIXME("stub!\n");
+    static const GUID *categories[] =
+    {
+        &CLSID_AudioCompressorCategory, &CLSID_AudioInputDeviceCategory, &CLSID_AudioRendererCategory,
+        &CLSID_DeviceControlCategory, &CLSID_LegacyAmFilterCategory, &CLSID_MidiRendererCategory,
+        &CLSID_TransmitCategory, &CLSID_VideoInputDeviceCategory, &CLSID_VideoCompressorCategory,
+    };
+    WCHAR path[100];
+    unsigned int i;
+
+    TRACE("\n");
+
+    /* the categories DllRegisterServer() created through the filter mapper */
+    for (i = 0; i < ARRAY_SIZE(categories); ++i)
+    {
+        wcscpy(path, L"CLSID\\");
+        StringFromGUID2(&CLSID_ActiveMovieCategories, path + wcslen(path), CHARS_IN_GUID);
+        wcscat(path, L"\\Instance\\");
+        StringFromGUID2(categories[i], path + wcslen(path), CHARS_IN_GUID);
+        RegDeleteTreeW(HKEY_CLASSES_ROOT, path);
+    }
+
     return __wine_unregister_resources();
 }
diff --git a/dlls/devenum/mediacatenum.c b/dlls/devenum/mediacatenum.c
index 906d01b..0967c2d 100644
--- a/dlls/devenum/mediacatenum.c
+++ b/dlls/devenum/mediacatenum.c
@@ -242,6 +242,42 @@ static HRESULT WINAPI property_bag_Read(IPropertyBag *iface,
 
     switch (type)
     {
+    case REG_EXPAND_SZ:
+    {
+        DWORD len = ExpandEnvironmentStringsW(data, NULL, 0);
+        WCHAR *expanded;
+
+        if (V_VT(var) == VT_EMPTY)
+            V_VT(var) = VT_BSTR;
+        if (V_VT(var) != VT_BSTR)
+        {
+            WARN("Invalid type %s.\n", debugstr_vt(V_VT(var)));
+            free(data);
+            return E_INVALIDARG;
+        }
+        if (!(expanded = malloc(len * sizeof(WCHAR))))
+        {
+            free(data);
+            return E_OUTOFMEMORY;
+        }
+        ExpandEnvironmentStringsW(data, expanded, len);
+        V_BSTR(var) = SysAllocString(expanded);
+        free(expanded);
+        free(data);
+        return V_BSTR(var) ? S_OK : E_OUTOFMEMORY;
+    }
+    case REG_QWORD:
+        if (V_VT(var) == VT_EMPTY)
+            V_VT(var) = VT_I8;
+        if (V_VT(var) != VT_I8 && V_VT(var) != VT_UI8)
+        {
+            WARN("Invalid type %s.\n", debugstr_vt(V_VT(var)));
+            free(data);
+            return E_INVALIDARG;
+        }
+        V_I8(var) = *(LONGLONG *)data;
+        free(data);
+        return S_OK;
     case REG_SZ:
         if (V_VT(var) == VT_EMPTY)
             V_VT(var) = VT_BSTR;
@@ -290,9 +326,10 @@ static HRESULT WINAPI property_bag_Read(IPropertyBag *iface,
         return S_OK;
     }
     default:
-        FIXME("Unhandled type %#lx.\n", type);
+        /* a value of a type no VARIANT carries */
+        WARN("Unhandled type %#lx.\n", type);
         free(data);
-        return E_NOTIMPL;
+        return DISP_E_TYPEMISMATCH;
     }
 }
 
@@ -440,32 +477,96 @@ static HRESULT WINAPI moniker_GetClassID(IMoniker *iface, CLSID *pClassID)
     return S_OK;
 }
 
+/* A device moniker never changes once made. */
 static HRESULT WINAPI moniker_IsDirty(IMoniker *iface)
 {
-    FIXME("(%p)->(): stub\n", iface);
+    TRACE("(%p)->()\n", iface);
 
     return S_FALSE;
 }
 
+/* The persisted form is the display name: a character count (with the
+ * terminator) followed by the characters. */
 static HRESULT WINAPI moniker_Load(IMoniker *iface, IStream *pStm)
 {
-    FIXME("(%p)->(%p): stub\n", iface, pStm);
+    struct moniker *This = impl_from_IMoniker(iface), *parsed;
+    IMoniker *other;
+    WCHAR *name;
+    DWORD count;
+    ULONG read;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", iface, pStm);
 
-    return E_NOTIMPL;
+    if (!pStm)
+        return E_POINTER;
+
+    if (FAILED(hr = IStream_Read(pStm, &count, sizeof(count), &read)))
+        return hr;
+    if (read != sizeof(count) || !count || count > 32768)
+        return E_FAIL;
+    if (!(name = malloc(count * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = IStream_Read(pStm, name, count * sizeof(WCHAR), &read)) || read != count * sizeof(WCHAR))
+    {
+        free(name);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    name[count - 1] = 0;
+
+    hr = IParseDisplayName_ParseDisplayName(&devenum_parser, NULL, name, NULL, &other);
+    free(name);
+    if (FAILED(hr))
+        return hr;
+
+    parsed = impl_from_IMoniker(other);
+    free(This->name);
+    This->class = parsed->class;
+    This->has_class = parsed->has_class;
+    This->type = parsed->type;
+    This->clsid = parsed->clsid;
+    This->name = parsed->name;
+    parsed->name = NULL;
+    IMoniker_Release(other);
+
+    return S_OK;
 }
 
 static HRESULT WINAPI moniker_Save(IMoniker *iface, IStream *pStm, BOOL fClearDirty)
 {
-    FIXME("(%p)->(%p, %s): stub\n", iface, pStm, fClearDirty ? "true" : "false");
+    WCHAR *name;
+    DWORD count;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %s)\n", iface, pStm, fClearDirty ? "true" : "false");
+
+    if (!pStm)
+        return E_POINTER;
+
+    if (FAILED(hr = IMoniker_GetDisplayName(iface, NULL, NULL, &name)))
+        return hr;
+    count = wcslen(name) + 1;
+    if (SUCCEEDED(hr = IStream_Write(pStm, &count, sizeof(count), NULL)))
+        hr = IStream_Write(pStm, name, count * sizeof(WCHAR), NULL);
+    CoTaskMemFree(name);
 
-    return STG_E_CANTSAVE;
+    return hr;
 }
 
 static HRESULT WINAPI moniker_GetSizeMax(IMoniker *iface, ULARGE_INTEGER *pcbSize)
 {
-    FIXME("(%p)->(%p): stub\n", iface, pcbSize);
+    WCHAR *name;
+    HRESULT hr;
 
-    ZeroMemory(pcbSize, sizeof(*pcbSize));
+    TRACE("(%p)->(%p)\n", iface, pcbSize);
+
+    if (!pcbSize)
+        return E_POINTER;
+
+    if (FAILED(hr = IMoniker_GetDisplayName(iface, NULL, NULL, &name)))
+        return hr;
+    pcbSize->QuadPart = sizeof(DWORD) + (wcslen(name) + 1) * sizeof(WCHAR);
+    CoTaskMemFree(name);
 
     return S_OK;
 }
@@ -578,22 +679,31 @@ static HRESULT WINAPI moniker_Reduce(IMoniker *iface, IBindCtx *pbc,
     return MK_S_REDUCED_TO_SELF;
 }
 
+/* A device moniker has no special composition: it makes a generic composite. */
 static HRESULT WINAPI moniker_ComposeWith(IMoniker *iface, IMoniker *pmkRight,
         BOOL fOnlyIfNotGeneric, IMoniker **ppmkComposite)
 {
-    FIXME("(%p)->(%p, %s, %p): stub\n", iface, pmkRight, fOnlyIfNotGeneric ? "true" : "false", ppmkComposite);
+    TRACE("(%p)->(%p, %s, %p)\n", iface, pmkRight, fOnlyIfNotGeneric ? "true" : "false", ppmkComposite);
 
-    /* FIXME: use CreateGenericComposite? */
+    if (!ppmkComposite)
+        return E_POINTER;
     *ppmkComposite = NULL;
+    if (!pmkRight)
+        return E_INVALIDARG;
+    if (fOnlyIfNotGeneric)
+        return MK_E_NEEDGENERIC;
 
-    return E_NOTIMPL;
+    return CreateGenericComposite(iface, pmkRight, ppmkComposite);
 }
 
+/* A simple moniker has no components to enumerate. */
 static HRESULT WINAPI moniker_Enum(IMoniker *iface, BOOL fForward,
         IEnumMoniker **ppenumMoniker)
 {
-    FIXME("(%p)->(%s, %p): stub\n", iface, fForward ? "true" : "false", ppenumMoniker);
+    TRACE("(%p)->(%s, %p)\n", iface, fForward ? "true" : "false", ppenumMoniker);
 
+    if (!ppenumMoniker)
+        return E_POINTER;
     *ppenumMoniker = NULL;
 
     return S_OK;
@@ -642,12 +752,26 @@ static HRESULT WINAPI moniker_Hash(IMoniker *iface, DWORD *pdwHash)
     return S_OK;
 }
 
+/* Running means registered in the running object table (or just started). */
 static HRESULT WINAPI moniker_IsRunning(IMoniker *iface, IBindCtx *pbc,
         IMoniker *pmkToLeft, IMoniker *pmkNewlyRunning)
 {
-    FIXME("(%p)->(%p, %p, %p): stub\n", iface, pbc, pmkToLeft, pmkNewlyRunning);
+    IRunningObjectTable *rot;
+    HRESULT hr;
 
-    return S_FALSE;
+    TRACE("(%p)->(%p, %p, %p)\n", iface, pbc, pmkToLeft, pmkNewlyRunning);
+
+    if (pmkNewlyRunning && IMoniker_IsEqual(iface, pmkNewlyRunning) == S_OK)
+        return S_OK;
+    if (!pbc)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IBindCtx_GetRunningObjectTable(pbc, &rot)))
+        return hr;
+    hr = IRunningObjectTable_IsRunning(rot, iface);
+    IRunningObjectTable_Release(rot);
+
+    return hr == S_OK ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI moniker_GetTimeOfLastChange(IMoniker *iface, IBindCtx *pbc,
@@ -1016,9 +1140,42 @@ static HRESULT WINAPI enum_moniker_Reset(IEnumMoniker *iface)
 
 static HRESULT WINAPI enum_moniker_Clone(IEnumMoniker *iface, IEnumMoniker **ppenum)
 {
-    FIXME("(%p)->(%p): stub\n", iface, ppenum);
+    EnumMonikerImpl *This = impl_from_IEnumMoniker(iface), *clone;
+    IEnumMoniker *object;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", iface, ppenum);
+
+    if (!ppenum)
+        return E_POINTER;
+    *ppenum = NULL;
+
+    if (FAILED(hr = enum_moniker_create(&This->class, &object)))
+        return hr;
+    clone = impl_from_IEnumMoniker(object);
 
-    return E_NOTIMPL;
+    /* the copy continues from the same position */
+    clone->sw_index = This->sw_index;
+    clone->cm_index = This->cm_index;
+    if (clone->dmo_enum)
+    {
+        IEnumDMO_Release(clone->dmo_enum);
+        clone->dmo_enum = NULL;
+    }
+    if (clone->dmo_enum2)
+    {
+        IEnumDMO_Release(clone->dmo_enum2);
+        clone->dmo_enum2 = NULL;
+    }
+    if ((This->dmo_enum && FAILED(hr = IEnumDMO_Clone(This->dmo_enum, &clone->dmo_enum)))
+            || (This->dmo_enum2 && FAILED(hr = IEnumDMO_Clone(This->dmo_enum2, &clone->dmo_enum2))))
+    {
+        IEnumMoniker_Release(object);
+        return hr;
+    }
+
+    *ppenum = object;
+    return S_OK;
 }
 
 /**********************************************************************
