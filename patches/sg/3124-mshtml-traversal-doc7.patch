+#define TREE_WALKER_MOVE(name, nsname) \
+static HRESULT WINAPI TreeWalker_##name(IWineMSHTMLTreeWalker *iface, VARIANT *p) \
+{ \
+    struct tree_walker *This = impl_from_IWineMSHTMLTreeWalker(iface); \
+    nsIDOMNode *nsnode = NULL; \
+    nsresult nsres; \
+    TRACE("(%p)->(%p)\n", This, p); \
+    nsres = nsIDOMTreeWalker_##nsname(This->walker, &nsnode); \
+    if(NS_FAILED(nsres)) \
+        return map_nsresult(nsres); \
+    return return_node_variant(nsnode, p); \
+}
