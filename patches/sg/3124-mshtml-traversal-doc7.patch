+static void *node_iterator_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    struct node_iterator *This = node_iterator_from_DispatchEx(dispex);
+
+    if(IsEqualGUID(&IID_IWineMSHTMLNodeIterator, riid))
+        return &This->IWineMSHTMLNodeIterator_iface;
