+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsIDOMTreeWalker_GetCurrentNode(This->walker, &nsnode);
+    hres = return_node_iface(nsnode, &node);
+    *p = (IDispatch*)node;
+    return hres;
+}
