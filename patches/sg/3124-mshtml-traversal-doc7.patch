+/* NodeIterator and TreeWalker of the script interface (DOM Level 2 Traversal), on top of the
+ * iterators of the engine. */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+
+#include "mshtml_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mshtml);
+
+#define NODE_FILTER_ACCEPT 1
+#define NODE_FILTER_SKIP   3
+
+/* The filter the engine calls for each node: it calls the script function (or the acceptNode
+ * method of the script object). */
+struct js_filter {
+    nsIDOMNodeFilter nsIDOMNodeFilter_iface;
+    LONG ref;
+    IDispatch *callback;
+};
+
+static inline struct js_filter *impl_from_nsIDOMNodeFilter(nsIDOMNodeFilter *iface)
+{
+    return CONTAINING_RECORD(iface, struct js_filter, nsIDOMNodeFilter_iface);
+}
+
+static nsresult NSAPI js_filter_QueryInterface(nsIDOMNodeFilter *iface, nsIIDRef riid, void **result)
+{
+    struct js_filter *This = impl_from_nsIDOMNodeFilter(iface);
+
+    if(IsEqualGUID(&IID_nsISupports, riid) || IsEqualGUID(&IID_nsIDOMNodeFilter, riid)) {
+        nsIDOMNodeFilter_AddRef(&This->nsIDOMNodeFilter_iface);
+        *result = &This->nsIDOMNodeFilter_iface;
+        return NS_OK;
+    }
+    *result = NULL;
+    return NS_NOINTERFACE;
+}
+
+static nsrefcnt NSAPI js_filter_AddRef(nsIDOMNodeFilter *iface)
+{
+    struct js_filter *This = impl_from_nsIDOMNodeFilter(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static nsrefcnt NSAPI js_filter_Release(nsIDOMNodeFilter *iface)
+{
+    struct js_filter *This = impl_from_nsIDOMNodeFilter(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        IDispatch_Release(This->callback);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT call_filter(IDispatch *callback, IDispatch *node, VARIANT *res)
+{
+    VARIANT arg;
+    DISPPARAMS dp = { &arg, NULL, 1, 0 };
+    DISPID id;
+    static const WCHAR *accept_node = L"acceptNode";
+    HRESULT hres;
+
+    V_VT(&arg) = VT_DISPATCH;
+    V_DISPATCH(&arg) = node;
+
+    /* a function is called itself, an object has the method */
+    hres = IDispatch_GetIDsOfNames(callback, &IID_NULL, (WCHAR**)&accept_node, 1, LOCALE_USER_DEFAULT, &id);
+    if(SUCCEEDED(hres))
+        return IDispatch_Invoke(callback, id, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD, &dp, res, NULL, NULL);
+    return call_disp_func(callback, &dp, res);
+}
+
+static nsresult NSAPI js_filter_AcceptNode(nsIDOMNodeFilter *iface, nsIDOMNode *nsnode, short *ret)
+{
+    struct js_filter *This = impl_from_nsIDOMNodeFilter(iface);
+    HTMLDOMNode *node;
+    VARIANT res, num;
+    HRESULT hres;
+
+    *ret = NODE_FILTER_ACCEPT;
+
+    hres = get_node(nsnode, TRUE, &node);
+    if(FAILED(hres))
+        return NS_ERROR_FAILURE;
+
+    V_VT(&res) = VT_EMPTY;
+    hres = call_filter(This->callback, (IDispatch*)&node->IHTMLDOMNode_iface, &res);
+    IHTMLDOMNode_Release(&node->IHTMLDOMNode_iface);
+    if(FAILED(hres)) {
+        WARN("filter failed: %08lx\n", hres);
+        return NS_ERROR_FAILURE;
+    }
+
+    if(V_VT(&res) == VT_BOOL) {
+        *ret = V_BOOL(&res) ? NODE_FILTER_ACCEPT : NODE_FILTER_SKIP;
+    }else if(V_VT(&res) != VT_EMPTY) {
+        V_VT(&num) = VT_EMPTY;
+        if(SUCCEEDED(VariantChangeType(&num, &res, 0, VT_I4)))
+            *ret = V_I4(&num);
+    }
+    VariantClear(&res);
+    return NS_OK;
+}
+
+static const nsIDOMNodeFilterVtbl js_filter_vtbl = {
+    js_filter_QueryInterface,
+    js_filter_AddRef,
+    js_filter_Release,
+    js_filter_AcceptNode
+};
+
+static HRESULT create_js_filter(VARIANT *var, struct js_filter **ret)
+{
+    struct js_filter *filter;
+
+    *ret = NULL;
+    if(!var || V_VT(var) != VT_DISPATCH || !V_DISPATCH(var))
+        return S_OK;
+
+    if(!(filter = malloc(sizeof(*filter))))
+        return E_OUTOFMEMORY;
+    filter->nsIDOMNodeFilter_iface.lpVtbl = &js_filter_vtbl;
+    filter->ref = 1;
+    IDispatch_AddRef(filter->callback = V_DISPATCH(var));
+    *ret = filter;
+    return S_OK;
+}
+
+static HRESULT get_what_to_show(VARIANT *var, UINT32 *ret)
+{
+    VARIANT num;
+    HRESULT hres;
+
+    *ret = 0xffffffff;
+    if(!var || V_VT(var) == VT_EMPTY || V_VT(var) == VT_ERROR || V_VT(var) == VT_NULL)
+        return S_OK;
+    V_VT(&num) = VT_EMPTY;
+    hres = VariantChangeType(&num, var, 0, VT_R8);
+    if(FAILED(hres))
+        return hres;
+    *ret = V_R8(&num) < 0 ? (UINT32)(INT32)V_R8(&num) : (UINT32)V_R8(&num);
+    return S_OK;
+}
+
+static HRESULT return_node_variant(nsIDOMNode *nsnode, VARIANT *p)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    if(!nsnode) {
+        V_VT(p) = VT_NULL;
+        return S_OK;
+    }
+    hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return hres;
+    V_VT(p) = VT_DISPATCH;
+    V_DISPATCH(p) = (IDispatch*)&node->IHTMLDOMNode_iface;
+    return S_OK;
+}
+
+static HRESULT return_node_iface(nsIDOMNode *nsnode, IHTMLDOMNode **p)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    if(!nsnode) {
+        *p = NULL;
+        return S_OK;
+    }
+    hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return hres;
+    *p = &node->IHTMLDOMNode_iface;
+    return S_OK;
+}
+
+static HRESULT return_filter_variant(struct js_filter *filter, VARIANT *p)
+{
+    if(!filter) {
+        V_VT(p) = VT_NULL;
+        return S_OK;
+    }
+    V_VT(p) = VT_DISPATCH;
+    V_DISPATCH(p) = filter->callback;
+    IDispatch_AddRef(filter->callback);
+    return S_OK;
+}
