+HRESULT create_node_iterator(HTMLDocumentNode *doc, IHTMLDOMNode *root, VARIANT *what, VARIANT *filter, IDispatch **ret)
+{
+    struct node_iterator *obj;
+    struct js_filter *js_filter;
+    HTMLDOMNode *root_node;
+    nsIDOMNodeIterator *iter;
+    UINT32 what_to_show;
+    nsresult nsres;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!root || !(root_node = unsafe_impl_from_IHTMLDOMNode(root)) || !doc->dom_document)
+        return E_INVALIDARG;
+    if(FAILED(hres = get_what_to_show(what, &what_to_show)) || FAILED(hres = create_js_filter(filter, &js_filter)))
+        return hres;
+
+#ifdef SG_MUTANT_TRAV_NOFILTER
+    js_filter = NULL;
+#endif
+    nsres = nsIDOMDocument_CreateNodeIterator(doc->dom_document, root_node->nsnode, what_to_show,
+                                              js_filter ? &js_filter->nsIDOMNodeFilter_iface : NULL, 2, &iter);
+    if(NS_FAILED(nsres) || !iter) {
+        if(js_filter) nsIDOMNodeFilter_Release(&js_filter->nsIDOMNodeFilter_iface);
+        return NS_FAILED(nsres) ? map_nsresult(nsres) : E_FAIL;
+    }
+
+    if(!(obj = calloc(1, sizeof(*obj)))) {
+        nsISupports_Release((nsISupports*)iter);
+        if(js_filter) nsIDOMNodeFilter_Release(&js_filter->nsIDOMNodeFilter_iface);
+        return E_OUTOFMEMORY;
+    }
+    obj->IWineMSHTMLNodeIterator_iface.lpVtbl = &NodeIteratorVtbl;
+    obj->iter = iter;
+    obj->filter = js_filter;
+    init_dispatch(&obj->dispex, &NodeIterator_dispex, doc->script_global,
+                  dispex_compat_mode(&doc->node.event_target.dispex));
+
+    *ret = (IDispatch*)&obj->IWineMSHTMLNodeIterator_iface;
+    return S_OK;
+}
