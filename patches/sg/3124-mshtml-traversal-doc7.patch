+static HRESULT WINAPI TreeWalker_put_currentNode(IWineMSHTMLTreeWalker *iface, IDispatch *v)
+{
+    struct tree_walker *This = impl_from_IWineMSHTMLTreeWalker(iface);
+    IHTMLDOMNode *dom_node;
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, v);
+
+    if(!v || FAILED(IDispatch_QueryInterface(v, &IID_IHTMLDOMNode, (void**)&dom_node)))
+        return E_INVALIDARG;
+    node = unsafe_impl_from_IHTMLDOMNode(dom_node);
+    hres = node && NS_SUCCEEDED(nsIDOMTreeWalker_SetCurrentNode(This->walker, node->nsnode)) ? S_OK : E_INVALIDARG;
+    IHTMLDOMNode_Release(dom_node);
+    return hres;
+}
