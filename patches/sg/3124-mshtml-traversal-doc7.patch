+    hres = get_node(nsnode, TRUE, &node);
+    nsIDOMNode_Release(nsnode);
+    if(FAILED(hres))
+        return hres;
+    *newCDATASectionNode = &node->IHTMLDOMNode_iface;
+    return S_OK;
