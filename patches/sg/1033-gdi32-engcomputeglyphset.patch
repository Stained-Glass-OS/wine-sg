From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: EngComputeGlyphSet

A code page's characters as an FD_GLYPHSET (Microsoft Learn,
EngComputeGlyphSet): runs of Unicode characters, each glyph handle the
character's code in the code page. Zebra's ZDesigner 5.x driver builds its
device fonts on it when it is enabled; it was a stub returning NULL, so the
driver refused to load and nothing printed.

Test: test/drvpkg-gate.sh (mutant SG_MUTANT_GLYPHSET).
---
--- a/dlls/gdi32/umpd.c
+++ b/dlls/gdi32/umpd.c
@@ -754,10 +754,68 @@
     return 0;
 }
 
-LONG_PTR WINAPI EngComputeGlyphSet( LONG_PTR a0, LONG_PTR a1, LONG_PTR a2 )
+static int __cdecl cmp_glyph( const void *a, const void *b )
 {
-    FIXME( "not supported\n" );
-    return 0;
+    return (int)((const ULONG *)a)[0] - (int)((const ULONG *)b)[0];
+}
+
+/***********************************************************************
+ *           EngComputeGlyphSet    (GDI32.@)
+ *
+ * The characters first..first+count-1 of a code page as an FD_GLYPHSET:
+ * runs of Unicode characters, each glyph handle the character's code in
+ * the code page.  Drivers keep it (Zebra's builds its device fonts on it).
+ */
+FD_GLYPHSET * WINAPI EngComputeGlyphSet( INT codepage, INT first, INT count )
+{
+    ULONG (*map)[2], i, n = 0, runs = 0, size;
+    FD_GLYPHSET *set;
+    HGLYPH *handles;
+
+    TRACE( "%d %d %d\n", codepage, first, count );
+#ifdef SG_MUTANT_GLYPHSET
+    return NULL;
+#endif
+    if (first < 0 || count <= 0 || first + count > 256) return NULL;
+    if (!(map = malloc( count * sizeof(*map) ))) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        char c = first + i;
+        WCHAR wc;
+
+        if (MultiByteToWideChar( codepage, MB_ERR_INVALID_CHARS, &c, 1, &wc, 1 ) != 1) continue;
+        map[n][0] = wc;
+        map[n][1] = first + i;
+        n++;
+    }
+    qsort( map, n, sizeof(*map), cmp_glyph );
+    for (i = 0; i < n; i++)
+        if (!i || map[i][0] != map[i - 1][0] + 1) runs++;
+    size = offsetof( FD_GLYPHSET, awcrun[runs ? runs : 1] ) + n * sizeof(HGLYPH);
+    /* drivers free it as engine memory: the process heap, as LocalFree takes it */
+    if (!(set = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, size )))
+    {
+        free( map );
+        return NULL;
+    }
+    set->cjThis = size;
+    set->flAccel = GS_8BIT_HANDLES;
+    set->cGlyphsSupported = n;
+    set->cRuns = runs;
+    handles = (HGLYPH *)&set->awcrun[runs ? runs : 1];
+    for (i = 0, runs = 0; i < n; i++)
+    {
+        if (!i || map[i][0] != map[i - 1][0] + 1)
+        {
+            set->awcrun[runs].wcLow = map[i][0];
+            set->awcrun[runs].phg = handles + i;
+            runs++;
+        }
+        set->awcrun[runs - 1].cGlyphs++;
+        handles[i] = map[i][1];
+    }
+    free( map );
+    return set;
 }
 
 LONG_PTR WINAPI EngPlayEnhMetaFile( LONG_PTR a0, LONG_PTR a1, LONG_PTR a2 )
--- a/include/ddk/winddi.h
+++ b/include/ddk/winddi.h
@@ -206,6 +206,26 @@
 typedef struct _GLYPHDEF { union { GLYPHBITS *pgb; PATHOBJ *ppo; }; } GLYPHDEF;
 typedef struct _GLYPHPOS { HGLYPH hg; GLYPHDEF *pgdf; POINTL ptl; } GLYPHPOS;
 
+typedef struct _WCRUN
+{
+    WCHAR   wcLow;
+    USHORT  cGlyphs;
+    HGLYPH *phg;
+} WCRUN, *PWCRUN;
+
+typedef struct _FD_GLYPHSET
+{
+    ULONG cjThis;
+    FLONG flAccel;
+    ULONG cGlyphsSupported;
+    ULONG cRuns;
+    WCRUN awcrun[1];
+} FD_GLYPHSET, *PFD_GLYPHSET;
+
+#define GS_UNICODE_HANDLES 0x00000001
+#define GS_8BIT_HANDLES    0x00000002
+#define GS_16BIT_HANDLES   0x00000004
+
 typedef struct _STROBJ
 {
     ULONG     cGlyphs;
