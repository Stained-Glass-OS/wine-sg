--- a/dlls/win32u/ntgdi_private.h
+++ b/dlls/win32u/ntgdi_private.h
@@ -641,6 +641,23 @@
 
 extern void free_heap_bits( struct gdi_image_bits *bits );
 
+/* The character ExtTextOut draws for str[i]: a UTF-16 surrogate pair is one
+ * character beyond the BMP, drawn at its first half (look it up with
+ * WINE_GGO_FULL_CHAR); its second half draws nothing and returns ~0u. */
+static inline UINT text_char_at( const WCHAR *str, UINT i, UINT count, UINT flags )
+{
+    if (flags & ETO_GLYPH_INDEX) return str[i];
+    if ((str[i] & 0xfc00) == 0xd800 && i + 1 < count && (str[i + 1] & 0xfc00) == 0xdc00)
+        return 0x10000 + ((str[i] - 0xd800) << 10) + (str[i + 1] - 0xdc00);
+    if ((str[i] & 0xfc00) == 0xdc00 && i && (str[i - 1] & 0xfc00) == 0xd800) return ~0u;
+    return str[i];
+}
+
+static inline UINT text_char_ggo_flags( UINT ch )
+{
+    return ch > 0xffff ? WINE_GGO_FULL_CHAR : 0;
+}
