--- a/dlls/gdi32/uniscribe/usp10.c
+++ b/dlls/gdi32/uniscribe/usp10.c
@@ -1890,6 +1890,55 @@
         lstrcpyW(FaceName,scriptInformation[scriptid].fallbackFont);
 }
 
+/* Characters beyond the BMP (Script_Surrogates) have no one fallback font:
+ * take the first installed emoji or symbol font -- the ones Windows' own
+ * fallback ends with, then free fonts covering the same characters -- that
+ * has every character of the run. */
+static HFONT find_surrogates_fallback_font(HDC hdc, LOGFONTW *lf, const WCHAR *str, int len)
+{
+    static const WCHAR * const faces[] =
+    {
+        L"Segoe UI Emoji", L"Segoe UI Symbol", L"Noto Emoji", L"Symbola",
+        L"Noto Sans Symbols2", L"Noto Sans Symbols", L"SimSun-ExtB",
+    };
+    HFONT font, old;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(faces); i++)
+    {
+        SCRIPT_CACHE sc = NULL;
+        WCHAR name[LF_FACESIZE];
+        HRESULT hr;
+
+        lstrcpyW(lf->lfFaceName, faces[i]);
+        if (!(font = CreateFontIndirectW(lf))) continue;
+        old = SelectObject(hdc, font);
+        /* a face that is not installed is substituted: not that one */
+        hr = S_FALSE;
+        if (GetTextFaceW(hdc, LF_FACESIZE, name) && !wcsicmp(name, faces[i]) &&
+            init_script_cache(hdc, &sc) == S_OK)
+        {
+            int j;
+            for (j = 0, hr = S_OK; j < len && hr == S_OK; j++)
+            {
+                DWORD ch = decode_surrogate_pair(str, j, len);
+                WORD glyph = 0;
+
+                if (ch) j++;
+                else ch = str[j];
+                OpenType_CMAP_GetGlyphIndex(hdc, (ScriptCache *)sc, ch, &glyph, GGI_MARK_NONEXISTING_GLYPHS);
+                if (!glyph || glyph == 0xffff) hr = S_FALSE;
+            }
+        }
+        ScriptFreeCache(&sc);
+        SelectObject(hdc, old);
+        if (hr == S_OK) return font;
+        DeleteObject(font);
+    }
+    lf->lfFaceName[0] = 0;
+    return NULL;
+}
