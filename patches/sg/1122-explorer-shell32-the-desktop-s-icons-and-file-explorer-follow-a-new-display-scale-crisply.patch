+/* an icon's width in pixels, 0 for none */
+static int icon_width( HICON icon )
+{
+    ICONINFO info;
+    BITMAP bm;
+    int ret = 0;
+
+    if (!icon || !GetIconInfo( icon, &info )) return 0;
+    if (GetObjectW( info.hbmColor ? info.hbmColor : info.hbmMask, sizeof(bm), &bm )) ret = bm.bmWidth;
+    if (info.hbmColor) DeleteObject( info.hbmColor );
+    if (info.hbmMask) DeleteObject( info.hbmMask );
+    return ret;
+}
