--- a/programs/explorer/fileexplorer.c
+++ b/programs/explorer/fileexplorer.c
@@ -5168,10 +5168,54 @@ static void fe_apply_mode(void)
     RedrawWindow( fe.hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
 }
 
+static void create_fonts(void);
+
+/* Stained Glass OS: a new display scale while File Explorer is open (it is
+ * per-monitor v2): everything at the new DPI -- its fonts, its S() sizes,
+ * the panes' widths, the shell's icons (made again at the new size), the
+ * folder's view made again, the window at the size suggested */
+static void fe_dpi_changed(HWND hwnd, UINT dpi, const RECT *r)
+{
+    HFONT old_fonts[] = { fe.font, fe.font_heading, fe.font_small, fe.font_title };
+    int old = fe.dpi;
+    unsigned int i;
+
+    if (!dpi || dpi == (UINT)old) return;
+    fe.dpi = dpi;
+    create_fonts();
+    SendMessageW(fe.addr_edit, WM_SETFONT, (WPARAM)fe.font, FALSE);
+    SendMessageW(fe.search_edit, WM_SETFONT, (WPARAM)fe.font, FALSE);
+    SendMessageW(fe.pane_edit, WM_SETFONT, (WPARAM)fe.font, FALSE);
+    SendMessageW(fe.tree, WM_SETFONT, (WPARAM)fe.font, FALSE);
+    if (fe.results) SendMessageW(fe.results, WM_SETFONT, (WPARAM)fe.font, FALSE);
+    SendMessageW(fe.tree, TVM_SETITEMHEIGHT, S(26), 0);
+    for (i = 0; i < ARRAY_SIZE(old_fonts); i++) if (old_fonts[i]) DeleteObject(old_fonts[i]);
+    fe.nav_width = MulDiv(fe.nav_width, dpi, old);
+    fe.pane_width = MulDiv(fe.pane_width, dpi, old);
+    Shell_GetImageLists(&fe.big_icons, &fe.small_icons);
+    if (extra_large) IImageList_Release(extra_large);
+    extra_large = NULL;
+    SHGetImageList(SHIL_EXTRALARGE, &IID_IImageList, (void **)&extra_large);
+    if (fe.results) SendMessageW(fe.results, LVM_SETIMAGELIST, LVSIL_SMALL, (LPARAM)fe.small_icons);
+    SetWindowPos(hwnd, NULL, r->left, r->top, r->right - r->left, r->bottom - r->top, SWP_NOZORDER | SWP_NOACTIVATE);
+    /* This PC and Quick access with the new icons (the folder's view, the
+     * shell's, lays itself out again: WM_DPICHANGED_AFTERPARENT) */
+    if (fe.content != CONTENT_FOLDER && fe.content != CONTENT_SEARCH) show_content(fe.content);
+    build_crumbs();
+    cmdbar_layout();
+    layout();
+    RedrawWindow(hwnd, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN);
+}
