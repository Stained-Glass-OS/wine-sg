+        return 0;
+#endif
     case WM_SETTINGCHANGE:
         if (lp && !wcscmp( (const WCHAR *)lp, L"ImmersiveColorSet" )) fe_apply_mode();
         break;
@@ -5467,12 +5511,20 @@ void file_explorer_window(const WCHAR *root, const WCHAR *selection)
 
     if (open_fonts_folder(root)) return;
 #ifndef SG_MUTANT_FE_PM
+#ifndef SG_MUTANT_FE_SYSTEM_AWARE
+    /* Stained Glass OS: File Explorer is per-monitor v2: when the display
+     * scale changes while it is open it lays itself out again at the new
+     * one (fe_dpi_changed) -- crisp, not Wine's scaled picture of a window
+     * aware of the system DPI, which was soft at 175% */
+    SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+#else
     /* Stained Glass OS: File Explorer is laid out at the system DPI (its
      * S() sizes): when the display scale changes while it is open, Wine
      * scales its window to the new one, as Windows does a program that is
