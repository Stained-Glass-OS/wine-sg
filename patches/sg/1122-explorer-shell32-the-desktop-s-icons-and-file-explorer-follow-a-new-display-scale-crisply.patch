 	HMENU		hMenu;
@@ -3029,6 +3031,42 @@ static LRESULT ShellView_OnChange(IShellViewImpl * This, const LPCITEMIDLIST *pi
 *  ShellView_WndProc
 */
 
+/* Stained Glass OS: the display scale changed while the view is open in a
+ * per-monitor v2 window (File Explorer, a file dialog): the list's font,
+ * its icons (the shell's lists, made again at the new size) and its items
+ * at the new scale -- they stayed the old one's, small at 175% */
+static void ShellView_OnDpiChanged(IShellViewImpl *This)
+{
+    HIMAGELIST big_icons, small_icons;
+    HFONT old = This->sg_dpi_font;
+    LOGFONTW lf;
+    UINT dpi;
+
+    if (!This->hWndList) return;
+    /* the columns as wide at the new scale */
+    if ((dpi = GetDpiForWindow(This->hWnd)) && This->sg_dpi && dpi != This->sg_dpi)
+    {
+        HWND header = (HWND)SendMessageW(This->hWndList, LVM_GETHEADER, 0, 0);
+        int i, n = header ? SendMessageW(header, HDM_GETITEMCOUNT, 0, 0) : 0;
+        for (i = 0; i < n; i++)
+            SendMessageW(This->hWndList, LVM_SETCOLUMNWIDTH, i,
+                         MulDiv(SendMessageW(This->hWndList, LVM_GETCOLUMNWIDTH, i, 0), dpi, This->sg_dpi));
+    }
+    if (dpi) This->sg_dpi = dpi;
+    if (SystemParametersInfoW(SPI_GETICONTITLELOGFONT, sizeof(lf), &lf, 0) &&
+        (This->sg_dpi_font = CreateFontIndirectW(&lf)))
+    {
+        SendMessageW(This->hWndList, WM_SETFONT, (WPARAM)This->sg_dpi_font, FALSE);
+        if (old) DeleteObject(old);
+    }
+    Shell_GetImageLists(&big_icons, &small_icons);
+    SendMessageW(This->hWndList, LVM_SETIMAGELIST, LVSIL_SMALL, (LPARAM)small_icons);
+    ShellView_ApplyViewMode(This);
+    SendMessageW(This->hWndList, LVM_DELETEALLITEMS, 0, 0);
+    ShellView_FillList(This);
+    InvalidateRect(This->hWndList, NULL, TRUE);
+}
+
