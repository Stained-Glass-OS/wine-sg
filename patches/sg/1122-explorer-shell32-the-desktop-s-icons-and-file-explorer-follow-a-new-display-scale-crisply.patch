 static CRITICAL_SECTION_DEBUG critsect_debug =
@@ -469,6 +470,7 @@ static BOOL WINAPI SIC_Initialize( INIT_ONCE *once, void *param, void **context
     sizes[SHIL_JUMBO].cx = sizes[SHIL_JUMBO].cy = 256;
 
     TRACE("large %ldx%ld small %ldx%ld\n", sizes[SHIL_LARGE].cx, sizes[SHIL_LARGE].cy, sizes[SHIL_SMALL].cx, sizes[SHIL_SMALL].cy);
+    sic_dpi = GetDpiForSystem();
 
     sic_hdpa = DPA_Create(16);
     if (!sic_hdpa)
@@ -501,6 +503,38 @@ static BOOL WINAPI SIC_Initialize( INIT_ONCE *once, void *param, void **context
     return TRUE;
 }
 
+static INT CALLBACK sic_free( LPVOID ptr, LPVOID lparam );
+
+/* Stained Glass OS: the shell's image lists at the system DPI the process
+ * has now. A per-monitor aware process's follows a new display scale
+ * (wine-sg 1121): the lists are made again at its icon sizes -- File
+ * Explorer's and the desktop's icons stayed the old scale's, small at 175%.
+ * The old lists are kept (a view made before may still draw from them);
+ * the cache starts again. */
+static void sic_init(void)
+{
+    UINT dpi;
+
+    InitOnceExecuteOnce( &sic_init_once, SIC_Initialize, NULL, NULL );
+#ifndef SG_MUTANT_SHELL_ICONS_FIXED
+    if (!sic_dpi || !IsProcessDPIAware() || (dpi = GetDpiForSystem()) == sic_dpi) return;
+    EnterCriticalSection( &SHELL32_SicCS );
+    if (dpi != sic_dpi)
+    {
+        unsigned int i;
+
+        TRACE( "image lists again at %u dpi (were %u)\n", dpi, sic_dpi );
+        if (sic_hdpa) DPA_DestroyCallback( sic_hdpa, sic_free, NULL );
+        sic_hdpa = NULL;
+        for (i = 0; i < ARRAY_SIZE(shell_imagelists); i++) shell_imagelists[i] = NULL;
+        SIC_Initialize( NULL, NULL, NULL );
+    }
+    LeaveCriticalSection( &SHELL32_SicCS );
+#else
+    (void)dpi;
+#endif
+}
