From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 12:22:03 -0700
Subject: [PATCH] mshtml: history back/forward/go, navigator.taintEnabled,
 screen.fontSmoothingEnabled (3018)

window.history.back(), forward() and go(n) travel in the travel log of the
browser that hosts the document (back and forward take an optional distance,
go a relative offset); without a travel log they succeed and do nothing.
navigator.taintEnabled is false and screen.fontSmoothingEnabled reports the
system font smoothing setting.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/mshtml/omnavigator.c b/dlls/mshtml/omnavigator.c
index 6b255d4..f048789 100644
--- a/dlls/mshtml/omnavigator.c
+++ b/dlls/mshtml/omnavigator.c
@@ -366,8 +366,16 @@ static HRESULT WINAPI HTMLScreen_get_availWidth(IHTMLScreen *iface, LONG *p)
 static HRESULT WINAPI HTMLScreen_get_fontSmoothingEnabled(IHTMLScreen *iface, VARIANT_BOOL *p)
 {
     HTMLScreen *This = impl_from_IHTMLScreen(iface);
-    FIXME("(%p)->(%p)\n", This, p);
-    return E_NOTIMPL;
+    BOOL enabled = FALSE;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    if(!p)
+        return E_POINTER;
+
+    SystemParametersInfoW(SPI_GETFONTSMOOTHING, 0, &enabled, 0);
+    *p = variant_bool(enabled);
+    return S_OK;
 }
 
 static const IHTMLScreenVtbl HTMLSreenVtbl = {
@@ -467,25 +475,81 @@ static HRESULT WINAPI OmHistory_get_length(IOmHistory *iface, short *p)
     return S_OK;
 }
 
+static HRESULT travel_history(OmHistory *This, LONG offset)
+{
+    GeckoBrowser *browser = NULL;
+
+    if(This->window->base.outer_window)
+        browser = This->window->base.outer_window->browser;
+    if(!browser || !browser->doc->travel_log)
+        return S_OK;
+
+    return ITravelLog_Travel(browser->doc->travel_log, (IUnknown*)browser->doc->browser_service, offset);
+}
+
+static HRESULT history_distance(const VARIANT *v, LONG def, LONG *distance)
+{
+    VARIANT n;
+    HRESULT hres;
+
+    *distance = def;
+    if(!v || V_VT(v) == VT_EMPTY || V_VT(v) == VT_NULL || (V_VT(v) == VT_ERROR && V_ERROR(v) == DISP_E_PARAMNOTFOUND))
+        return S_OK;
+
+    V_VT(&n) = VT_EMPTY;
+    hres = VariantChangeType(&n, (VARIANT*)v, 0, VT_I4);
+    if(FAILED(hres))
+        return hres;
+
+    *distance = V_I4(&n);
+    return S_OK;
+}
+
 static HRESULT WINAPI OmHistory_back(IOmHistory *iface, VARIANT *pvargdistance)
 {
     OmHistory *This = impl_from_IOmHistory(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
-    return E_NOTIMPL;
+    LONG distance;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
+
+    hres = history_distance(pvargdistance, 1, &distance);
+    if(FAILED(hres))
+        return hres;
+    return travel_history(This, -distance);
 }
 
 static HRESULT WINAPI OmHistory_forward(IOmHistory *iface, VARIANT *pvargdistance)
 {
     OmHistory *This = impl_from_IOmHistory(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
-    return E_NOTIMPL;
+    LONG distance;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
+
+    hres = history_distance(pvargdistance, 1, &distance);
+    if(FAILED(hres))
+        return hres;
+    return travel_history(This, distance);
 }
 
 static HRESULT WINAPI OmHistory_go(IOmHistory *iface, VARIANT *pvargdistance)
 {
     OmHistory *This = impl_from_IOmHistory(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
-    return E_NOTIMPL;
+    LONG distance;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(pvargdistance));
+
+    if(pvargdistance && V_VT(pvargdistance) == VT_BSTR) {
+        FIXME("going to a URL is not supported\n");
+        return E_NOTIMPL;
+    }
+
+    hres = history_distance(pvargdistance, 0, &distance);
+    if(FAILED(hres))
+        return hres;
+    return travel_history(This, distance);
 }
 
 static const IOmHistoryVtbl OmHistoryVtbl = {
@@ -891,8 +955,15 @@ static HRESULT WINAPI OmNavigator_javaEnabled(IOmNavigator *iface, VARIANT_BOOL
 static HRESULT WINAPI OmNavigator_taintEnabled(IOmNavigator *iface, VARIANT_BOOL *enabled)
 {
     OmNavigator *This = impl_from_IOmNavigator(iface);
-    FIXME("(%p)->(%p)\n", This, enabled);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, enabled);
+
+    if(!enabled)
+        return E_POINTER;
+
+    /* data tainting is not available */
+    *enabled = VARIANT_FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI OmNavigator_get_mimeTypes(IOmNavigator *iface, IHTMLMimeTypesCollection **p)
diff --git a/dlls/mshtml/tests/dom.c b/dlls/mshtml/tests/dom.c
index 8b16635..32de0dd 100644
--- a/dlls/mshtml/tests/dom.c
+++ b/dlls/mshtml/tests/dom.c
@@ -6812,6 +6812,13 @@ static void test_navigator(IHTMLDocument2 *doc)
 
     IHTMLWindow2_Release(window);
 
+    {
+        VARIANT_BOOL taint = VARIANT_TRUE;
+
+        hres = IOmNavigator_taintEnabled(navigator, &taint);
+        ok(hres == S_OK && taint == VARIANT_FALSE, "taintEnabled returned %08lx, %x\n", hres, taint);
+    }
+
     hres = IOmNavigator_get_appCodeName(navigator, &bstr);
     ok(hres == S_OK, "get_appCodeName failed: %08lx\n", hres);
     ok(!lstrcmpW(bstr, L"Mozilla"), "Unexpected appCodeName %s\n", wine_dbgstr_w(bstr));
