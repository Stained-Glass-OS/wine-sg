+ * only the window's own thread changes it, through set_window_pos. */
+static void set_cloaked_property( struct window *win, unsigned int cloaked )
+{
+    static const WCHAR nameW[] = {'_','_','w','i','n','e','_','c','l','o','a','k','e','d'};
+    static const struct unicode_str name = { nameW, sizeof(nameW) };
+    atom_t atom;
