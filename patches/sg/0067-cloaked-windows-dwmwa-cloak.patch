 /***********************************************************************
+ *           set_window_cloak
+ *
+ * Cloak or uncloak a top-level window of this thread, as DWM does for
+ * virtual desktops and DWMWA_CLOAK: the window keeps WS_VISIBLE, its
+ * position and its surface, and is sent nothing, but it is not drawn,
+ * does not clip other windows and is not hit-tested. The current position
+ * is re-applied with the request, so the server exposes what it uncovered
+ * (or the window itself) exactly as when a window is hidden or shown.
+ */
+BOOL set_window_cloak( HWND hwnd, UINT flags )
+{
+    static const RECT empty[2];
+    struct window_surface *surface;
+    struct window_rects rects;
+    BOOL ret;
+    WND *win;
+
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    win->cloak_request = ((flags & SET_WINDOW_CLOAK) ? SET_WINPOS_CLOAK : SET_WINPOS_UNCLOAK) |
+                         ((flags & SET_WINDOW_CLOAK_SHELL) ? SET_WINPOS_CLOAK_SHELL : 0);
+    if ((surface = win->surface)) window_surface_add_ref( surface );
+    release_win_ptr( win );
+
+    get_window_rects( hwnd, COORDS_PARENT, &rects, get_thread_dpi() );
+    ret = apply_window_pos( hwnd, 0, SWP_NOSIZE | SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE |
+                            SWP_NOOWNERZORDER | SWP_NOCLIENTSIZE | SWP_NOCLIENTMOVE,
+                            surface, &rects, empty );
+    if (surface) window_surface_release( surface );
+    return ret;
+}
+
+/* from any thread: the window's own thread does it, and nobody waits for it */
+static BOOL request_window_cloak( HWND hwnd, UINT flags )
+{
+    HWND full_handle;
+
+    if ((full_handle = is_current_thread_window( hwnd ))) return set_window_cloak( full_handle, flags );
+    return NtUserMessageCall( hwnd, WM_WINE_SETCLOAK, flags, 0, 0, NtUserSendNotifyMessage, FALSE );
+}
+
+static UINT get_window_cloaked( HWND hwnd )
+{
+    static const WCHAR cloakedW[] = {'_','_','w','i','n','e','_','c','l','o','a','k','e','d',0};
+    WND *win = get_win_ptr( hwnd );
+    UINT ret;
+
+    if (!win || win == WND_DESKTOP) return 0;
+    if (win == WND_OTHER_PROCESS)
+    {
+        DWORD err = RtlGetLastWin32Error();  /* no such property is not an error here */
+        ret = HandleToUlong( NtUserGetProp( hwnd, cloakedW ));
+        RtlSetLastWin32Error( err );
+        return ret;
+    }
+    ret = win->cloaked;
+    release_win_ptr( win );
+    return ret;
+}
