From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: NtSetInformationProcess keeps a process's I/O priority

Setting ProcessIoPriority failed with STATUS_NOT_IMPLEMENTED and a FIXME (WinDirStat lowers its I/O priority while it scans). A process now sets very low, low or normal on itself and reads it back (not enforced, like the memory priority); high takes a privilege that is not given here (STATUS_PRIVILEGE_NOT_HELD), and wow64 passes the call through.
---
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1230,6 +1230,8 @@
 static PROCESS_POWER_THROTTLING_STATE process_power_throttling = { PROCESS_POWER_THROTTLING_CURRENT_VERSION };
 static ULONG process_page_priority = MEMORY_PRIORITY_NORMAL;
 static ULONG process_leap_second_flags;
+/* (wine-sg 8288) ProcessIoPriority, an IO_PRIORITY_HINT: 0 very low, 1 low, 2 normal */
+static ULONG process_io_priority = 2;
 /* ProcessPooledUsageAndLimits (ntddk.h's POOLED_USAGE_AND_LIMITS) */
 typedef struct
 {
@@ -2014,7 +2016,7 @@
         break;
 
     case ProcessIoPriority:
-        /* the I/O priority is not tracked: every process has the normal one */
+        /* (wine-sg 8288) what the process set on itself (not enforced), else the normal one */
         len = sizeof(ULONG);
         if (size != len) ret = STATUS_INFO_LENGTH_MISMATCH;
         else if (!info) ret = STATUS_ACCESS_VIOLATION;
@@ -2022,7 +2024,12 @@
 #ifdef SG_MUTANT_IOPRIO
             *(ULONG *)info = 0;
 #else
-            *(ULONG *)info = 2;  /* IoPriorityNormal */
+        {
+            BOOL current;
+
+            if (!(ret = is_current_process( handle, FALSE, &current )))
+                *(ULONG *)info = current ? process_io_priority : 2;  /* IoPriorityNormal */
+        }
 #endif
         break;
 
@@ -2723,6 +2730,23 @@
         break;
     }
 
+#ifndef SG_MUTANT_NO_SET_IOPRIO
+    case ProcessIoPriority:
+    {
+        /* (wine-sg 8288) SetPriorityClass(PROCESS_MODE_BACKGROUND_BEGIN), WinDirStat: very low, low or normal
+         * are kept and read back, not enforced; high takes a privilege that is not given here, and
+         * critical is the kernel's */
+        BOOL current;
+
+        if (size != sizeof(ULONG)) return STATUS_INFO_LENGTH_MISMATCH;
+        if (*(ULONG *)info >= 5) return STATUS_INVALID_PARAMETER;
+        if (*(ULONG *)info > 2) return STATUS_PRIVILEGE_NOT_HELD;
+        if ((ret = is_current_process( handle, TRUE, &current ))) return ret;
+        if (current) process_io_priority = *(ULONG *)info;
+        break;
+    }
+#endif
+
     case ProcessPriorityBoost:
     {
         BOOL current;
--- a/dlls/wow64/process.c
+++ b/dlls/wow64/process.c
@@ -960,6 +960,9 @@
     case ProcessMitigationPolicy:   /* PROCESS_MITIGATION_POLICY_INFORMATION */
     case ProcessPriorityBoost:   /* ULONG */
     case ProcessBreakOnTermination:   /* ULONG */
+#ifndef SG_MUTANT_NO_SET_IOPRIO
+    case ProcessIoPriority:   /* ULONG (wine-sg 8288) */
+#endif
     case ProcessWineGrantAdminToken:   /* NULL */
         return NtSetInformationProcess( handle, class, ptr, len );
 
