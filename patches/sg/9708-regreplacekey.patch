 }
 
+/* Stained Glass OS (wine-sg 9708): a hive loaded from a file remembers the file, for RegReplaceKey */
+static void sg_note_hive_file( struct key *key, obj_handle_t handle )
+{
+    struct object *obj;
+    struct fd *fd;
+    struct unicode_str name;
+
+    if (!(obj = get_handle_obj( current->process, handle, 0, NULL ))) { clear_error(); return; }
+    if ((fd = get_obj_fd( obj )))
+    {
+        get_nt_name( fd, &name );
+        free( key->hive_file );
+        key->hive_file_len = 0;
+        if ((key->hive_file = memdup( name.str, name.len ))) key->hive_file_len = name.len;
+        release_object( fd );
+    }
+    clear_error();
+    release_object( obj );
+}
+
 DECL_HANDLER(load_registry)
 {
     struct key *key, *parent = NULL;
@@ -3246,7 +3271,11 @@
         /* an application hive is a new key of its own: never loaded into
          * one that exists (another process's hive) */
         if (app_hive && get_error() == STATUS_OBJECT_NAME_EXISTS) set_error( STATUS_OBJECT_NAME_COLLISION );
-        else load_registry( key, req->file );
+        else
+        {
+            load_registry( key, req->file );
+            if (!get_error()) sg_note_hive_file( key, req->file );
+        }
         release_object( key );
     }
     if (parent) release_object( parent );
@@ -3362,3 +3391,28 @@
         release_object( key );
     }
 }
+
+/* Stained Glass OS (wine-sg 9708): the file a hive was loaded from, for NtReplaceKey, which swaps the files
+ * (the hive in memory stays as it is, as on Windows until the hive is loaded again). Only the root of a hive
+ * loaded from a file has one; Wine's own registry files hold many of Windows' hives together, and those
+ * keys cannot be replaced one by one. Needs SeRestorePrivilege, as RegReplaceKey does on Windows. */
+DECL_HANDLER(get_hive_file)
+{
+    struct key *key;
+
+    if (!thread_single_check_privilege( current, SeRestorePrivilege ))
+    {
+        set_error( STATUS_PRIVILEGE_NOT_HELD );
+        return;
+    }
+    if ((key = get_hkey_obj( req->hkey, 0 )))
+    {
+#ifndef SG_MUTANT_NO_HIVE_FILE
+        if (!key->hive_file) set_error( STATUS_INVALID_PARAMETER );
+        else set_reply_data( key->hive_file, min( key->hive_file_len, get_reply_max_size() ) );
+#else
+        set_error( STATUS_INVALID_PARAMETER );
+#endif
+        release_object( key );
+    }
+}
--- a/dlls/ntdll/unix/registry.c
+++ b/dlls/ntdll/unix/registry.c
@@ -1505,10 +1505,71 @@
 /******************************************************************************
  *              NtReplaceKey  (NTDLL.@)
  */
+/* rename an open file to an NT name (relative to root), never over a file that is there */
+static NTSTATUS rename_hive_file( HANDLE file, HANDLE root, const UNICODE_STRING *name )
+{
+    FILE_RENAME_INFORMATION *info;
+    IO_STATUS_BLOCK io;
+    ULONG size = offsetof( FILE_RENAME_INFORMATION, FileName[name->Length / sizeof(WCHAR)] );
+    NTSTATUS status;
+
+    if (!(info = calloc( 1, size ))) return STATUS_NO_MEMORY;
+    info->ReplaceIfExists = FALSE;
+    info->RootDirectory = root;
+    info->FileNameLength = name->Length;
+    memcpy( info->FileName, name->Buffer, name->Length );
+    status = NtSetInformationFile( file, &io, info, size, FileRenameInformation );
+    free( info );
+    return status;
+}
+
+/* Stained Glass OS (wine-sg 9708): RegReplaceKey. As on Windows: the file the hive (key) was loaded from
+ * becomes the backup (replace: it must not exist), and the new file (attr) takes the hive file's name, so the
+ * next time the hive is loaded it has the new file's keys; the hive in memory is unchanged until then. Needs
+ * SeRestorePrivilege (the server checks). Wine's stub did nothing and said it succeeded. */
 NTSTATUS WINAPI NtReplaceKey( OBJECT_ATTRIBUTES *attr, HANDLE key, OBJECT_ATTRIBUTES *replace )
 {
-    FIXME( "(%s,%p,%s),stub!\n", debugstr_us(attr->ObjectName), key, debugstr_us(replace->ObjectName) );
-    return STATUS_SUCCESS;
+    WCHAR hive_name[MAX_PATH * 4];
+    UNICODE_STRING hive_str;
+    OBJECT_ATTRIBUTES hive_attr;
+    IO_STATUS_BLOCK io;
+    HANDLE new_file = 0, hive_file = 0;
+    NTSTATUS status;
+
+    TRACE( "(%s,%p,%s)\n", attr ? debugstr_us(attr->ObjectName) : "(null)", key,
+           replace ? debugstr_us(replace->ObjectName) : "(null)" );
+
+    if (!attr || !attr->ObjectName || !replace || !replace->ObjectName) return STATUS_INVALID_PARAMETER;
+
+    SERVER_START_REQ( get_hive_file )
+    {
+        req->hkey = wine_server_obj_handle( key );
+        wine_server_set_reply( req, hive_name, sizeof(hive_name) );
+        if (!(status = wine_server_call( req ))) hive_str.Length = wine_server_reply_size( reply );
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+    hive_str.Buffer = hive_name;
+    hive_str.MaximumLength = sizeof(hive_name);
+    InitializeObjectAttributes( &hive_attr, &hive_str, OBJ_CASE_INSENSITIVE, 0, NULL );
+
+    if ((status = NtOpenFile( &new_file, DELETE | SYNCHRONIZE, attr, &io, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                              FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE )))
+        return status;
+    if ((status = NtOpenFile( &hive_file, DELETE | SYNCHRONIZE, &hive_attr, &io,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                              FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE )))
+    {
+        NtClose( new_file );
+        return status;
+    }
+    /* the hive's file becomes the backup, then the new file takes its name (or the backup goes back) */
+    if (!(status = rename_hive_file( hive_file, replace->RootDirectory, replace->ObjectName )) &&
+        (status = rename_hive_file( new_file, 0, &hive_str )))
+        rename_hive_file( hive_file, 0, &hive_str );
+    NtClose( hive_file );
+    NtClose( new_file );
+    return status;
 }
 
 /******************************************************************************
--- a/dlls/advapi32/registry.c
+++ b/dlls/advapi32/registry.c
@@ -579,11 +579,37 @@
  *  Failure: nonzero error code from Winerror.h
  */
 LSTATUS WINAPI RegReplaceKeyW( HKEY hkey, LPCWSTR lpSubKey, LPCWSTR lpNewFile,
-                               LPCWSTR lpOldFile )
+                              LPCWSTR lpOldFile )
 {
-    FIXME("(%p,%s,%s,%s): stub\n", hkey, debugstr_w(lpSubKey),
-          debugstr_w(lpNewFile),debugstr_w(lpOldFile));
-    return ERROR_SUCCESS;
+    OBJECT_ATTRIBUTES new_attr, old_attr;
+    UNICODE_STRING new_name, old_name;
+    NTSTATUS status;
+    LSTATUS ret;
+    HKEY key;
+
+    TRACE("(%p,%s,%s,%s)\n", hkey, debugstr_w(lpSubKey), debugstr_w(lpNewFile), debugstr_w(lpOldFile));
+
+    /* Stained Glass OS (wine-sg 9708): the hive's file is swapped for the new one (NtReplaceKey) */
+    if (!lpNewFile || !lpOldFile) return ERROR_INVALID_PARAMETER;
+    if ((ret = RegOpenKeyExW( hkey, lpSubKey, 0, KEY_QUERY_VALUE, &key ))) return ret;
+    if (!RtlDosPathNameToNtPathName_U( lpNewFile, &new_name, NULL, NULL ))
+    {
+        RegCloseKey( key );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (!RtlDosPathNameToNtPathName_U( lpOldFile, &old_name, NULL, NULL ))
+    {
+        RtlFreeUnicodeString( &new_name );
+        RegCloseKey( key );
+        return ERROR_INVALID_PARAMETER;
+    }
+    InitializeObjectAttributes( &new_attr, &new_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    InitializeObjectAttributes( &old_attr, &old_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtReplaceKey( &new_attr, key, &old_attr );
+    RtlFreeUnicodeString( &new_name );
+    RtlFreeUnicodeString( &old_name );
+    RegCloseKey( key );
+    return RtlNtStatusToDosError( status );
 }
 
 
