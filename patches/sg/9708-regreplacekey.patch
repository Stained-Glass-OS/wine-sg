     timeout_t         modif;       /* last modification time */
     struct list       notify_list; /* list of notifications */
+    WCHAR            *hive_file;   /* a hive loaded from a file (NtLoadKey): the file's NT name (wine-sg 9708) */
+    data_size_t       hive_file_len;
 };
 
