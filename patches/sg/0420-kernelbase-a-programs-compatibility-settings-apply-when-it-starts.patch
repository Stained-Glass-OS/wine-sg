+/* Stained Glass OS: per-program compatibility settings (the Compatibility tab
+ * of an .exe's Properties, sg-shell's sgcompat). Under
+ * HKCU\Software\Wine\AppDefaults\<program.exe> -- where Wine already keeps a
+ * program's Version and DllOverrides -- a program may have:
+ *   Environment\  NAME = value   set for it when it starts (an empty value
+ *                                removes NAME); Wine builds the Unix
+ *                                environment from this too, so Mesa, Vulkan
+ *                                and DXVK variables work as on Linux;
+ *   LaunchArgs    = "..."        appended to its command line;
+ * and, as on Windows, AppCompatFlags\Layers\<its full path> containing
+ * RUNASADMIN starts it as an administrator (the consent prompt).
+ * Applied here, in CreateProcess, so it holds however the program starts:
+ * a double-click, a shortcut, a launcher (Steam) starting a game. */
+static HKEY sg_open_app_defaults( const WCHAR *app_name, const WCHAR *sub )
+{
+    WCHAR path[MAX_PATH + 64];
+    const WCHAR *base, *p;
+    HKEY key = 0;
+
+    if (!app_name) return 0;
+    for (base = p = app_name; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (!*base || lstrlenW( base ) > MAX_PATH) return 0;
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\AppDefaults\\%s%s%s", base,
+              sub ? L"\\" : L"", sub ? sub : L"" );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key )) { TRACE( "no %s\n", debugstr_w(path) ); return 0; }
+    TRACE( "%s\n", debugstr_w(path) );
+    return key;
+}
+
+/* A new environment block: env (or this process's, if NULL) with the
+ * program's Environment values applied; NULL when it has none. Free with
+ * RtlDestroyEnvironment. */
+static WCHAR *sg_app_environment( const WCHAR *app_name, const WCHAR *env )
+{
+    WCHAR name[256], value[4096];
+    DWORD i, name_len, value_len, type;
+    const WCHAR *e;
+    WCHAR *block = NULL;
+    HKEY key;
+
+    if (!(key = sg_open_app_defaults( app_name, L"Environment" ))) return NULL;
+    if (env)
+    {
+        if (RtlCreateEnvironment( FALSE, &block )) goto done;
+        for (e = env; *e; e += lstrlenW( e ) + 1)
+        {
+            UNICODE_STRING n, v;
+            const WCHAR *eq = wcschr( e + 1, '=' );  /* "=C:=C:\" names start with '=' */
+            if (!eq) continue;
+            n.Buffer = (WCHAR *)e; n.Length = n.MaximumLength = (eq - e) * sizeof(WCHAR);
+            RtlInitUnicodeString( &v, eq + 1 );
+            RtlSetEnvironmentVariable( &block, &n, &v );
+        }
+    }
+    else if (RtlCreateEnvironment( TRUE, &block )) goto done;
+
+    for (i = 0;; i++)
+    {
+        UNICODE_STRING n, v;
+        name_len = ARRAY_SIZE(name);
+        value_len = sizeof(value) - sizeof(WCHAR);
+        if (RegEnumValueW( key, i, name, &name_len, NULL, &type, (BYTE *)value, &value_len )) break;
+        if (type != REG_SZ && type != REG_EXPAND_SZ) continue;
+        value[value_len / sizeof(WCHAR)] = 0;
+        RtlInitUnicodeString( &n, name );
+        RtlInitUnicodeString( &v, value );
+        RtlSetEnvironmentVariable( &block, &n, value[0] ? &v : NULL );
+        TRACE( "%s: %s=%s\n", debugstr_w(app_name), debugstr_w(name), debugstr_w(value) );
+    }
+done:
+    RegCloseKey( key );
+    return block;
+}
+
+/* The command line with the program's LaunchArgs appended; NULL if none. */
+static WCHAR *sg_app_cmdline( const WCHAR *app_name, const WCHAR *cmdline )
+{
+    WCHAR args[2048], *ret = NULL;
+    DWORD size = sizeof(args) - sizeof(WCHAR), type;
+    HKEY key;
+
+    if (!cmdline || !(key = sg_open_app_defaults( app_name, NULL ))) return NULL;
+    if (!RegQueryValueExW( key, L"LaunchArgs", NULL, &type, (BYTE *)args, &size ) &&
+        (type == REG_SZ || type == REG_EXPAND_SZ))
+    {
+        size_t len;
+        args[size / sizeof(WCHAR)] = 0;
+        if (args[0] && (ret = RtlAllocateHeap( GetProcessHeap(), 0,
+                                               (len = lstrlenW( cmdline ) + lstrlenW( args ) + 2) * sizeof(WCHAR) )))
+            swprintf( ret, len, L"%s %s", cmdline, args );
+    }
+    RegCloseKey( key );
+    return ret;
+}
+
+/* AppCompatFlags\Layers\<full path> (HKCU, then HKLM) says RUNASADMIN. */
+static BOOL sg_layers_run_as_admin( const WCHAR *app_name )
+{
+    static const WCHAR layers[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers";
+    HKEY roots[2] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    WCHAR full[MAX_PATH], flags[1024];
+    DWORD i, size, type;
+    BOOL ret = FALSE;
+
+    if (!app_name || !GetFullPathNameW( app_name, ARRAY_SIZE(full), full, NULL )) return FALSE;
+    for (i = 0; i < 2 && !ret; i++)
+    {
+        HKEY key;
+        if (RegOpenKeyExW( roots[i], layers, 0, KEY_READ, &key )) continue;
+        size = sizeof(flags) - sizeof(WCHAR);
+        if (!RegQueryValueExW( key, full, NULL, &type, (BYTE *)flags, &size ) && type == REG_SZ)
+        {
+            WCHAR *tok = flags, *end;
+            flags[size / sizeof(WCHAR)] = 0;
+            while (*tok && !ret)  /* space-separated layer names */
+            {
+                while (*tok == ' ') tok++;
+                for (end = tok; *end && *end != ' '; end++);
+                if (end - tok == 10 && !wcsnicmp( tok, L"RUNASADMIN", 10 )) ret = TRUE;
+                tok = end;
+            }
+        }
+        RegCloseKey( key );
+    }
+    return ret;
+}
