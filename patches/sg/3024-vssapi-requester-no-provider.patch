+
+static HRESULT WINAPI enum_Next( IVssEnumObject *iface, ULONG count, VSS_OBJECT_PROP *elements, ULONG *fetched )
+{
+    TRACE( "%p, %lu, %p, %p\n", iface, count, elements, fetched );
+    if (fetched) *fetched = 0;
+    else if (count != 1) return E_INVALIDARG;
+    return S_FALSE;
+}
+
+static HRESULT WINAPI enum_Skip( IVssEnumObject *iface, ULONG count )
+{
+    TRACE( "%p, %lu\n", iface, count );
+    return count ? S_FALSE : S_OK;
+}
+
+static HRESULT WINAPI enum_Reset( IVssEnumObject *iface )
+{
+    TRACE( "%p\n", iface );
+    return S_OK;
