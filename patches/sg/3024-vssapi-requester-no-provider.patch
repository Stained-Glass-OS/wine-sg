+/******************************************************************
+ *  IsVolumeSnapshottedInternal (VSSAPI.@)
+ */
+HRESULT WINAPI IsVolumeSnapshottedInternal( VSS_PWSZ volume, BOOL *snapshotted, LONG *compatibility )
+{
+    TRACE( "%s, %p, %p\n", debugstr_w( volume ), snapshotted, compatibility );
+
+    if (!volume || !snapshotted) return E_INVALIDARG;
+    *snapshotted = FALSE;
+    if (compatibility) *compatibility = 0;
+    return S_OK;
+}
+
+/******************************************************************
+ *  ShouldBlockRevertInternal (VSSAPI.@)
+ */
+HRESULT WINAPI ShouldBlockRevertInternal( LPCWSTR volume, BOOL *block )
+{
+    TRACE( "%s, %p\n", debugstr_w( volume ), block );
+
+    if (!volume || !block) return E_INVALIDARG;
+    *block = FALSE;
+    return S_OK;
+}
+
+/******************************************************************
+ *  VssFreeSnapshotPropertiesInternal (VSSAPI.@)
+ */
+void WINAPI VssFreeSnapshotPropertiesInternal( VSS_SNAPSHOT_PROP *prop )
+{
+    TRACE( "%p\n", prop );
+
+    if (!prop) return;
+    CoTaskMemFree( prop->m_pwszSnapshotDeviceObject );
+    CoTaskMemFree( prop->m_pwszOriginalVolumeName );
+    CoTaskMemFree( prop->m_pwszOriginatingMachine );
+    CoTaskMemFree( prop->m_pwszServiceMachine );
+    CoTaskMemFree( prop->m_pwszExposedName );
+    CoTaskMemFree( prop->m_pwszExposedPath );
+    prop->m_pwszSnapshotDeviceObject = NULL;
+    prop->m_pwszOriginalVolumeName = NULL;
+    prop->m_pwszOriginatingMachine = NULL;
+    prop->m_pwszServiceMachine = NULL;
+    prop->m_pwszExposedName = NULL;
+    prop->m_pwszExposedPath = NULL;
+}
