+HRESULT WINAPI CreateVssBackupComponentsInternal( IVssBackupComponents **ret )
+{
+    struct backup *b;
+
+    TRACE( "%p\n", ret );
+
+    if (!ret) return E_INVALIDARG;
+    if (!(b = calloc( 1, sizeof(*b) ))) return E_OUTOFMEMORY;
+    b->IVssBackupComponents_iface.lpVtbl = &backup_vtbl;
+    b->ref = 1;
+    *ret = &b->IVssBackupComponents_iface;
+    return S_OK;
+}
