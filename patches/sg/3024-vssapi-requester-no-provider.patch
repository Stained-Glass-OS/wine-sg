+    ULONG ref = InterlockedDecrement( &b->ref );
+    if (!ref) free( b );
+    return ref;
+}
+
+#define NEED_BACKUP( b ) do { if ((b)->init != STATE_BACKUP) return VSS_E_BAD_STATE; } while (0)
+#define NEED_RESTORE( b ) do { if ((b)->init != STATE_RESTORE) return VSS_E_BAD_STATE; } while (0)
+
+static HRESULT WINAPI backup_GetWriterComponentsCount( IVssBackupComponents *iface, UINT *count )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %p\n", iface, count );
+    if (!count) return E_INVALIDARG;
+    NEED_RESTORE( b );
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_GetWriterComponents( IVssBackupComponents *iface, UINT index, IVssWriterComponentsExt **writer )
