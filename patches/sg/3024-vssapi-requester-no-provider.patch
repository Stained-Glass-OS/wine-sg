+/* ---------------------------------------------------------------------- */
+/* IVssAsync: every operation has already finished                        */
+
+struct async
+{
+    IVssAsync IVssAsync_iface;
+    LONG      ref;
+};
+
+static inline struct async *impl_from_IVssAsync( IVssAsync *iface )
+{
+    return CONTAINING_RECORD( iface, struct async, IVssAsync_iface );
+}
+
+static HRESULT WINAPI async_QueryInterface( IVssAsync *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IVssAsync ))
+    {
+        *obj = iface;
+        IVssAsync_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI async_AddRef( IVssAsync *iface )
+{
+    struct async *async = impl_from_IVssAsync( iface );
+    return InterlockedIncrement( &async->ref );
+}
+
+static ULONG WINAPI async_Release( IVssAsync *iface )
+{
+    struct async *async = impl_from_IVssAsync( iface );
+    ULONG ref = InterlockedDecrement( &async->ref );
+    if (!ref) free( async );
+    return ref;
+}
+
+static HRESULT WINAPI async_Cancel( IVssAsync *iface )
+{
+    TRACE( "%p\n", iface );
+    return VSS_S_ASYNC_FINISHED;
+}
+
+static HRESULT WINAPI async_Wait( IVssAsync *iface, DWORD milliseconds )
+{
+    TRACE( "%p, %lu\n", iface, milliseconds );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_QueryStatus( IVssAsync *iface, HRESULT *result, INT *reserved )
+{
+    TRACE( "%p, %p, %p\n", iface, result, reserved );
+    if (!result) return E_INVALIDARG;
+    *result = VSS_S_ASYNC_FINISHED;
+    if (reserved) *reserved = 0;
+    return S_OK;
+}
+
+static const IVssAsyncVtbl async_vtbl =
+{
+    async_QueryInterface,
+    async_AddRef,
+    async_Release,
+    async_Cancel,
+    async_Wait,
+    async_QueryStatus
+};
+
+static HRESULT create_async( IVssAsync **ret )
+{
+    struct async *async;
+
+    if (!ret) return E_INVALIDARG;
+    if (!(async = calloc( 1, sizeof(*async) ))) return E_OUTOFMEMORY;
+    async->IVssAsync_iface.lpVtbl = &async_vtbl;
+    async->ref = 1;
+    *ret = &async->IVssAsync_iface;
+    return S_OK;
+}
+
