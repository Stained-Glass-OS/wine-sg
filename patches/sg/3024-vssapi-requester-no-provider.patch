+        IVssBackupComponents_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI backup_AddRef( IVssBackupComponents *iface )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    return InterlockedIncrement( &b->ref );
+}
+
+static ULONG WINAPI backup_Release( IVssBackupComponents *iface )
