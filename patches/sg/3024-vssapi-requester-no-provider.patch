+static HRESULT WINAPI backup_QueryInterface( IVssBackupComponents *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IVssBackupComponents ))
+    {
