+static BOOL valid_context( LONG ctx )
+{
+    switch ((DWORD)ctx)
+    {
+    case 0x00:        /* VSS_CTX_BACKUP */
+    case 0x10:        /* VSS_CTX_FILE_SHARE_BACKUP */
+    case 0x19:        /* VSS_CTX_NAS_ROLLBACK */
+    case 0x09:        /* VSS_CTX_APP_ROLLBACK */
+    case 0x1d:        /* VSS_CTX_CLIENT_ACCESSIBLE */
+    case 0x0d:        /* VSS_CTX_CLIENT_ACCESSIBLE_WRITERS */
+    case 0xffffffff:  /* VSS_CTX_ALL */
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
