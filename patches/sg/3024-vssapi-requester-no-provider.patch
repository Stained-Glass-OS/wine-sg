+    *writer = NULL;
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI backup_InitializeForBackup( IVssBackupComponents *iface, BSTR xml )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %s\n", iface, debugstr_w( xml ) );
+    if (b->init != STATE_NONE) return VSS_E_BAD_STATE;
+    b->init = STATE_BACKUP;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_SetBackupState( IVssBackupComponents *iface, BOOL select_components, BOOL state,
+                                             VSS_BACKUP_TYPE type, BOOL partial_support )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %d, %d, %d, %d\n", iface, select_components, state, type, partial_support );
+    NEED_BACKUP( b );
+    if (type <= VSS_BT_UNDEFINED || type > VSS_BT_OTHER) return E_INVALIDARG;
+    b->state_set = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_InitializeForRestore( IVssBackupComponents *iface, BSTR xml )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %s\n", iface, debugstr_w( xml ) );
+    if (!xml) return E_INVALIDARG;
+    if (b->init != STATE_NONE) return VSS_E_BAD_STATE;
+    b->init = STATE_RESTORE;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_SetRestoreState( IVssBackupComponents *iface, VSS_RESTORE_TYPE restore )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %d\n", iface, restore );
+    NEED_RESTORE( b );
+    if (restore <= VSS_RTYPE_UNDEFINED || restore > VSS_RTYPE_OTHER) return E_INVALIDARG;
+    b->state_set = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_GatherWriterMetadata( IVssBackupComponents *iface, IVssAsync **async )
