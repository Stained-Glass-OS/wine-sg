+static HRESULT WINAPI backup_SetContext( IVssBackupComponents *iface, LONG context )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %#lx\n", iface, context );
+    if (b->init == STATE_NONE || b->snapshot_set) return VSS_E_BAD_STATE;
+    if (!valid_context( context )) return VSS_E_UNSUPPORTED_CONTEXT;
+    b->context = context;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_StartSnapshotSet( IVssBackupComponents *iface, VSS_ID *id )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %p\n", iface, id );
+    if (!id) return E_INVALIDARG;
+    NEED_BACKUP( b );
+    if (b->snapshot_set) return VSS_E_SNAPSHOT_SET_IN_PROGRESS;
+    UuidCreate( id );
+    b->snapshot_set = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI backup_AddToSnapshotSet( IVssBackupComponents *iface, VSS_PWSZ volume, VSS_ID provider, VSS_ID *snapshot )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %s, %s, %p\n", iface, debugstr_w( volume ), debugstr_guid( &provider ), snapshot );
+    if (!volume || !snapshot) return E_INVALIDARG;
+    NEED_BACKUP( b );
+    if (!b->snapshot_set) return VSS_E_BAD_STATE;
+    memset( snapshot, 0, sizeof(*snapshot) );
+    /* there is no provider that could snapshot any volume */
+    return IsEqualGUID( &provider, &GUID_NULL ) ? VSS_E_VOLUME_NOT_SUPPORTED : VSS_E_PROVIDER_NOT_REGISTERED;
+}
+
+static HRESULT WINAPI backup_DoSnapshotSet( IVssBackupComponents *iface, IVssAsync **async )
+{
+    struct backup *b = impl_from_IVssBackupComponents( iface );
+    TRACE( "%p, %p\n", iface, async );
+    if (!async) return E_INVALIDARG;
+    NEED_BACKUP( b );
+    /* no volume could be added, so the set is empty */
+    return VSS_E_BAD_STATE;
+}
