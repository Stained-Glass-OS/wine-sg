+/* Stained Glass OS: the Trash folder as the file's own mount sees it. A user's
+ * profile (C:\users\<name>) is a bind mount of their home, and the Trash is in
+ * the home at ~/.local/share/Trash, reached through another mount (/home): a
+ * rename between two mounts fails (EXDEV) even on one disk, so a move to the
+ * Recycle Bin copied the whole file -- 15 GB took a minute behind a progress
+ * window that already said 100%. Windows' Recycle Bin is on the file's own
+ * volume and a move to it is a rename. So: an ancestor of the file that holds
+ * .local\share\Trash, where the .trashinfo just made is seen too, is the same
+ * Trash folder through the file's mount; moving there is a rename. */
+static WCHAR *trash_dir_beside( const WCHAR *path, const WCHAR *info_name )
+{
+    WCHAR *dir, *p, *probe;
+    ULONG len = lstrlenW( path ) + lstrlenW( info_name ) + 40;
+
+#ifdef SG_MUTANT_TRASH_OTHER_MOUNT
+    return NULL;
+#endif
+    if (!info_name || !(dir = malloc( len * sizeof(WCHAR) ))) return NULL;
+    if (!(probe = malloc( len * sizeof(WCHAR) ))) { free( dir ); return NULL; }
+    lstrcpyW( dir, path );
+    while ((p = wcsrchr( dir, '\\' )) && p >= dir + 2)  /* up to the drive's root */
+    {
+        *p = 0;
+        swprintf( probe, len, L"%s\\.local\\share\\Trash\\info\\%s", dir, info_name );
+        if (GetFileAttributesW( probe ) != INVALID_FILE_ATTRIBUTES)
+        {
+            swprintf( probe, len, L"%s\\.local\\share\\Trash\\files", dir );
+            free( dir );
+            return probe;
+        }
+    }
+    free( dir );
+    free( probe );
+    return NULL;
+}
+
