+/* Stained Glass OS: move to the Recycle Bin; a move that has to copy shows its
+ * bytes and stops at Cancel, leaving the file where it was */
+BOOL fileop_trash_file(struct fileop_progress *p, const WCHAR *path)
+{
+    WIN32_FILE_ATTRIBUTE_DATA fad;
+
+    if (!p) return trash_file(path);
+    if (GetFileAttributesExW(path, GetFileExInfoStandard, &fad) && !(fad.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+        p->item_size = ((LONGLONG)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+    return trash_file_progress(path, copy_progress_routine, p);
+}
