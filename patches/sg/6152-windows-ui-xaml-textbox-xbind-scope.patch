+/* ---- RelativePanel: its children placed by their attached alignments to the panel ---- */
+
+static struct xaml_property *prop_rp_left, *prop_rp_right, *prop_rp_top, *prop_rp_bottom, *prop_rp_hcenter, *prop_rp_vcenter;
+
+struct relative_panel
+{
+    struct panel p;
+    struct xiface IRelativePanel_iface;
+};
+
+static BOOL rp_flag( struct uielem *child, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    BOOL ret;
+
+    dobj_get_value( &child->d, prop, &box );
+    ret = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static void rp_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct uielem *child;
+
+    desired->width = desired->height = 0;
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+    {
+        uielem_measure( child, available );
+        if (child->visibility == XCOLLAPSED) continue;
+        desired->width = fmax( desired->width, child->desired.width );
+        desired->height = fmax( desired->height, child->desired.height );
+    }
+}
+
+/* AlignLeft/Right/Top/BottomWithPanel, both of a pair: stretched; the centre alignments; else top left
+ * (relations between children are not followed yet) */
+static void rp_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct uielem *child;
+
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+    {
+        BOOL left = rp_flag( child, prop_rp_left ), right = rp_flag( child, prop_rp_right );
+        BOOL top = rp_flag( child, prop_rp_top ), bottom = rp_flag( child, prop_rp_bottom );
+        struct xrect rect = { 0, 0, child->desired.width, child->desired.height };
+
+        if (left && right) rect.width = final.width;
+        else if (right) rect.x = final.width - rect.width;
+        else if (rp_flag( child, prop_rp_hcenter )) rect.x = (final.width - rect.width) / 2;
+        if (top && bottom) rect.height = final.height;
+        else if (bottom) rect.y = final.height - rect.height;
+        else if (rp_flag( child, prop_rp_vcenter )) rect.y = (final.height - rect.height) / 2;
+#ifdef SG_MUTANT_RELATIVE_NO_STRETCH
+        rect.width = child->desired.width;
+#endif
+        uielem_arrange( child, rect );
+    }
+    *used = final;
+}
+
+static const struct elem_ops rp_ops = { rp_measure, rp_arrange, panel_render };
+
+static const void *rp_vtbl[] = { IRelativePanel_STUBS };
+
+static const struct xiface_entry rp_ifaces[] =
+{
+    { &IID_IRelativePanel, offsetof(struct relative_panel, IRelativePanel_iface) },
+    PANEL_IFACES,
+};
+
+static void rp_destroy( struct xobj *obj )
+{
+    panel_cleanup( &CONTAINING_RECORD( obj, struct relative_panel, p.e.d.obj )->p );
+}
+
+static const struct xclass rp_class =
+{
+    L"Windows.UI.Xaml.Controls.RelativePanel", rp_ifaces, ARRAY_SIZE(rp_ifaces), rp_destroy,
+};
+
+static void rp_init( struct relative_panel *rp, IInspectable *outer )
+{
+    panels_init();
+    rp->IRelativePanel_iface.vtbl = rp_vtbl;
+    panel_init( &rp->p, &rp_class, &rp_ops, outer );
+}
+
+#define e_obj p.e.d.obj
+COMPOSABLE_CREATE(rp_factory_CreateInstance, struct relative_panel, rp_init( obj, outer ), IRelativePanel_iface)
+#undef e_obj
+
+static const void *rp_factory_vtbl[] =
+{
+    IRelativePanelFactory_FSTUBS, [IRelativePanelFactory_CreateInstance] = rp_factory_CreateInstance,
+};
+
+static struct xfactory rp_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Controls.RelativePanel",
+    { &IID_IRelativePanelFactory },
+    { { rp_factory_vtbl } },
+};
