+static struct xaml_property *prop_sv_hmode, *prop_sv_vmode, *prop_sv_hbar, *prop_sv_vbar, *prop_sv_deferred, *prop_sv_hrail,
+                            *prop_sv_vrail, *prop_sv_zoom;
