+static void text_box_destroy( struct xobj *obj )
+{
+    struct text_box *box = CONTAINING_RECORD( obj, struct text_box, c.e.d.obj );
+
+    if (box->view)
+    {
+        if (box->view->parent) uielem_remove_child( box->view->parent, box->view );
+        IUnknown_Release( box->view->d.obj.outer );
+    }
+    handlers_clear( &box->text_changed );
+    control_cleanup( &box->c );
