+};
+
+static HRESULT put_box( struct dobj *obj, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( obj, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static BOOL get_bool( struct dobj *obj, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    BOOL ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static INT32 get_int( struct dobj *obj, struct xaml_property *prop )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    dobj_get_value( obj, prop, &box );
+    ret = xunbox_enum( box, NULL, 0 );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static HRESULT get_hstring( struct dobj *obj, struct xaml_property *prop, HSTRING *value )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    dobj_get_value( obj, prop, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    hr = xaml_hstring( str ? str : L"", value );
+    free( str );
+    return hr;
+}
+
+static HRESULT put_hstring( struct dobj *obj, struct xaml_property *prop, HSTRING value )
+{
+    return put_box( obj, prop, xbox_string( WindowsGetStringRawBuffer( value, NULL ) ) );
+}
+
+/* ---- TextBox ---- */
+
+struct text_box
+{
+    struct control c;
+    struct xiface ITextBox_iface, ITextBox2_iface, ITextBox3_iface;
+    struct uielem *view;            /* our TextBlock showing the text (a reference) */
+    struct uielem *host;            /* its template's ContentElement holding the view, or NULL */
+    struct handler_list text_changed;
+    INT32 selection_start, selection_length;
+};
+
+static struct text_box *box_from_elem( struct uielem *elem )
+{
+    return CONTAINING_RECORD( elem, struct text_box, c.e );
+}
+
+static struct text_box *box_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct text_box, c.e.d.obj );
+}
+
+static void get_padding( struct text_box *box, struct xthickness *padding )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.Control", L"Padding" );
+    IInspectable *value = NULL;
+
+    memset( padding, 0, sizeof(*padding) );
+    if (!prop) return;
+    dobj_get_value( &box->c.e.d, prop, &value );
+    xunbox_ref( value, &IID_IReference_Thickness, padding, sizeof(*padding) );
+    if (value) IInspectable_Release( value );
+}
+
+static void view_set_text( struct text_box *box )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.TextBlock", L"Text" );
+    IInspectable *text = NULL;
+
+    if (!box->view || !prop) return;
+#ifdef SG_MUTANT_TEXTBOX_NO_VIEW
+    return;
+#endif
+    dobj_get_value( &box->c.e.d, prop_text, &text );
+    dobj_set_value( &box->view->d, prop, text );
+    if (text) IInspectable_Release( text );
+}
+
+/* the view in the template's ContentElement, or in the box itself */
+static void place_view( struct text_box *box )
+{
+    struct uielem *host = NULL;
+    IInspectable *view;
+
+    if (box->c.template_root) host = xaml_find_name( box->c.template_root, L"ContentElement" );
+    if (host == box->host && (host || box->view->parent == &box->c.e)) return;
+    if (box->view->parent) uielem_remove_child( box->view->parent, box->view );
+    box->host = host;
+    if (host && control_from_elem( host ))
+    {
+        /* a content control (ScrollViewer): the view is its content */
+        if (SUCCEEDED(IUnknown_QueryInterface( box->view->d.obj.outer, &IID_IInspectable, (void **)&view )))
+        {
+            IInspectable *content = NULL;
+            if (SUCCEEDED(IUnknown_QueryInterface( host->d.obj.outer, &IID_IContentControl, (void **)&content )))
+            {
+                ((HRESULT (WINAPI *)( IInspectable *, IInspectable * ))((void **)content->lpVtbl)[IContentControl_SetContent])( content, view );
+                IInspectable_Release( content );
+            }
+            IInspectable_Release( view );
+        }
+    }
+    else if (!host) uielem_add_child( &box->c.e, box->view );
+    else FIXME( "ContentElement of a type we do not fill\n" );
+}
+
+static void text_box_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct text_box *box = box_from_elem( elem );
+    struct xthickness padding = { 0 };
+
+    control_measure( elem, available, desired );   /* applies its template */
+    place_view( box );
+    if (box->host || box->c.template_root)
+    {
+        if (box->host) control_measure( elem, available, desired );
+        return;
+    }
+    /* the desktop's own field */
+    get_padding( box, &padding );
+    available.width = fmax( 0, available.width - padding.left - padding.right - 2 );
+    available.height = fmax( 0, available.height - padding.top - padding.bottom - 2 );
+    uielem_measure( box->view, available );
+    desired->width = box->view->desired.width + padding.left + padding.right + 2;
+    desired->height = fmax( 24, box->view->desired.height + padding.top + padding.bottom + 2 );
+}
+
+static void text_box_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct text_box *box = box_from_elem( elem );
+    struct xthickness padding = { 0 };
+    struct xrect rect;
+
+    if (box->c.template_root)
+    {
+        control_arrange( elem, final, used );
+        return;
+    }
+    get_padding( box, &padding );
+    rect.x = padding.left + 1;
+    rect.y = fmax( 1, (final.height - box->view->desired.height) / 2 );
+    rect.width = fmax( 0, final.width - padding.left - padding.right - 2 );
+    rect.height = box->view->desired.height;
+    uielem_arrange( box->view, rect );
+    *used = final;
+}
+
+static void text_box_render( struct uielem *elem, struct xdraw *draw )
+{
+    struct text_box *box = box_from_elem( elem );
+    struct xrect rect = { 0, 0, elem->render.width, elem->render.height };
+    struct xthickness one = { 1, 1, 1, 1 };
+    struct xcolor color;
+
+    if (box->c.template_root) return;   /* its template draws it */
+    if (!control_brush( &box->c, FALSE, &color )) color = xaml_theme_color( XTHEME_BACKGROUND );
+    xdraw_fill( draw, &rect, color, NULL );
+    xdraw_border( draw, &rect, &one, xaml_theme_color( XTHEME_BORDER ), NULL );
+}
+
+static const struct elem_ops text_box_ops = { text_box_measure, text_box_arrange, text_box_render };
+
+static void text_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct text_box *box = box_from_elem( CONTAINING_RECORD( obj, struct uielem, d ) );
+    IInspectable *sender = NULL, *args;
+
+    view_set_text( box );
+    uielem_invalidate_measure( &box->c.e );
+    if (list_empty( &box->text_changed.entries )) return;
+    if (FAILED(IUnknown_QueryInterface( box->c.e.d.obj.outer, &IID_IInspectable, (void **)&sender ))) return;
+    if ((args = xaml_routed_args( sender )))
+    {
+        xaml_raise_routed( &box->text_changed, sender, args );
+        IInspectable_Release( args );
+    }
+    IInspectable_Release( sender );
+}
