+static HRESULT WINAPI box_get_Text( struct xiface *iface, HSTRING *value ) { return get_hstring( &box_from_iface( iface )->c.e.d, prop_text, value ); }
+static HRESULT WINAPI box_put_Text( struct xiface *iface, HSTRING value )
+{
+    struct text_box *box = box_from_iface( iface );
+    INT32 max = get_int( &box->c.e.d, prop_max_length );
+    UINT32 len = WindowsGetStringLen( value );
+
+    TRACE( "%p, %s\n", box, debugstr_hstring( value ) );
+    if (max > 0 && len > (UINT32)max)
+    {
+        WCHAR *cut = malloc( (max + 1) * sizeof(WCHAR) );
+        HRESULT hr;
+        if (!cut) return E_OUTOFMEMORY;
+        memcpy( cut, WindowsGetStringRawBuffer( value, NULL ), max * sizeof(WCHAR) );
+        cut[max] = 0;
+        hr = put_box( &box->c.e.d, prop_text, xbox_string( cut ) );
+        free( cut );
+        return hr;
+    }
+    return put_hstring( &box->c.e.d, prop_text, value );
+}
