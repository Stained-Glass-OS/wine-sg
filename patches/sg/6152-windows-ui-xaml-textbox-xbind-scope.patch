+static struct text_box *new_text_box( IInspectable *outer )
+{
+    struct text_box *box;
+    IInspectable *view;
+
+    text_input_init();
+    if (!(box = calloc( 1, sizeof(*box) ))) return NULL;
+    box->ITextBox_iface.vtbl = text_box_vtbl;
+    box->ITextBox2_iface.vtbl = text_box2_vtbl;
+    box->ITextBox3_iface.vtbl = text_box3_vtbl;
+    handlers_init( &box->text_changed );
+    control_init( &box->c, KIND_OTHER, &text_box_class, &text_box_ops, outer );
+    if ((view = xaml_text_block( L"" )))
+    {
+        /* the view keeps the reference */
+        box->view = uielem_from_inspectable( view );
+        if (!box->view) IInspectable_Release( view );
+    }
+    {
+        /* the desktop's field: a little padding */
+        struct xthickness padding = { 6, 3, 6, 3 };
+        IInspectable *pad = xbox_ref( &IID_IReference_Thickness, &padding, sizeof(padding) );
+        if (pad) xaml_control_set( &box->c, L"Padding", pad );
+        if (pad) IInspectable_Release( pad );
+    }
+    return box;
+}
