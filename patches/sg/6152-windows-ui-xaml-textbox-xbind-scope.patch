+static HRESULT WINAPI text_box_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct text_box *box;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(box = new_text_box( outer ))) return E_OUTOFMEMORY;
+    if (outer)
+    {
+        *inner = &box->c.e.d.obj.IInspectable_inner;
+        IUnknown_AddRef( box->c.e.d.obj.outer );
+    }
+    *value = &box->ITextBox_iface;
+    return S_OK;
+}
