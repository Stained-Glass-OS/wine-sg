+/*
+ * A TextBox shows its Text in a text view of ours: inside its template's ContentElement (a
+ * ScrollViewer, as control templates name it) when it has a template, else in the desktop's own
+ * field (background, a one-pixel border, padding).  Text changes raise TextChanged.  Editing with the
+ * keyboard comes in a later step.  A ScrollViewer is a content control (its scroll settings kept, no
+ * scrolling yet); a Popup holds its Child out of the layout (not shown yet); an ItemsControl or
+ * ListView keeps ItemsSource and its Items (not shown yet) -- so that compiled pages and their x:Bind
+ * find the objects they set.
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
