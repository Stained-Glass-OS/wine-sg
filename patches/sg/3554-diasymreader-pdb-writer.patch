+static char *wide_to_utf8(const WCHAR *s)
+{
+    int len = WideCharToMultiByte(CP_UTF8, 0, s, -1, NULL, 0, NULL, NULL);
+    char *r = malloc(max(len, 1));
+    if (!r) return NULL;
+    if (len) WideCharToMultiByte(CP_UTF8, 0, s, -1, r, len, NULL, NULL);
+    else r[0] = 0;
+    return r;
+}
