+/* Write the PDB to the stream or file given at initialization. */
+static HRESULT write_pdb(SymWriter *This)
+{
+    struct buf file = {0};
+    HRESULT hr;
+
+    if (!This->initialized)
+        return E_UNEXPECTED;
+
+    hr = build_pdb(This, &file);
+    if (FAILED(hr))
+    {
+        buf_free(&file);
+        return hr;
+    }
+
+    if (This->stream)
+    {
+        LARGE_INTEGER zero = {{0}};
+        ULARGE_INTEGER size;
+        ULONG written;
+
+        hr = IStream_Seek(This->stream, zero, STREAM_SEEK_SET, NULL);
+        if (SUCCEEDED(hr)) hr = IStream_Write(This->stream, file.data, file.size, &written);
+        if (SUCCEEDED(hr) && written != file.size) hr = E_FAIL;
+        if (SUCCEEDED(hr))
+        {
+            size.QuadPart = file.size;
+            hr = IStream_SetSize(This->stream, size);
+        }
+    }
+    else if (This->write_filename[0])
+    {
+        HANDLE h = CreateFileW(This->write_filename, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                               FILE_ATTRIBUTE_NORMAL, NULL);
+        DWORD written;
+
+        if (h == INVALID_HANDLE_VALUE)
+            hr = HRESULT_FROM_WIN32(GetLastError());
+        else
+        {
+            if (!WriteFile(h, file.data, file.size, &written, NULL) || written != file.size)
+                hr = HRESULT_FROM_WIN32(GetLastError() ? GetLastError() : ERROR_WRITE_FAULT);
+            CloseHandle(h);
+        }
+    }
+    else
+        hr = E_UNEXPECTED;
+
+    buf_free(&file);
+    return hr;
+}
