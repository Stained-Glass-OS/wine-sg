+/* append one zeroed element to a growable array */
+static void *array_add(void **array, DWORD *count, DWORD *cap, size_t size)
+{
+    if (*count == *cap)
+    {
+        DWORD new_cap = *cap ? *cap * 2 : 8;
+        void *p = realloc(*array, (size_t)new_cap * size);
+        if (!p) return NULL;
+        *array = p;
+        *cap = new_cap;
+    }
+    memset((char *)*array + (size_t)*count * size, 0, size);
+    return (char *)*array + (size_t)(*count)++ * size;
+}
+
+static WCHAR *dup_wstr(const WCHAR *s)
+{
+    size_t len = wcslen(s) + 1;
+    WCHAR *r = malloc(len * sizeof(WCHAR));
+    if (r) memcpy(r, s, len * sizeof(WCHAR));
+    return r;
+}
