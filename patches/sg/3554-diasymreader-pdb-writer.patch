+#include <stdarg.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+
+#include "diasymreader_private.h"
+
+#define MSF_BLOCK_SIZE 4096
+#define MSF_MAX_BLOCKS 4096   /* one free-block-map interval */
+
+static const char msf_magic[32] = "Microsoft C/C++ MSF 7.00\r\n\x1a" "DS\0\0\0";
+
+BOOL buf_reserve(struct buf *b, DWORD extra)
+{
+    BYTE *p;
+    DWORD cap;
+
+    if (b->fail) return FALSE;
+    if (b->size + extra < b->size) { b->fail = TRUE; return FALSE; }
+    if (b->size + extra <= b->cap) return TRUE;
+    cap = max(b->cap * 2, max(b->size + extra, 256));
+    p = realloc(b->data, cap);
+    if (!p) { b->fail = TRUE; return FALSE; }
+    b->data = p;
+    b->cap = cap;
+    return TRUE;
+}
+
+void buf_put(struct buf *b, const void *data, DWORD len)
+{
+    if (!len || !buf_reserve(b, len)) return;
+    if (data) memcpy(b->data + b->size, data, len);
+    else memset(b->data + b->size, 0, len);
+    b->size += len;
+}
+
+void buf_u8(struct buf *b, BYTE v)    { buf_put(b, &v, 1); }
+void buf_u16(struct buf *b, WORD v)   { buf_put(b, &v, 2); }
+void buf_u32(struct buf *b, DWORD v)  { buf_put(b, &v, 4); }
+void buf_u64(struct buf *b, UINT64 v) { buf_put(b, &v, 8); }
+
+void buf_cstr(struct buf *b, const char *s)
+{
+    buf_put(b, s, strlen(s) + 1);
+}
+
+void buf_align4(struct buf *b)
+{
+    static const BYTE zero[4];
+    if (b->size & 3) buf_put(b, zero, 4 - (b->size & 3));
+}
+
+void buf_patch32(struct buf *b, DWORD pos, DWORD v)
+{
+    if (!b->fail && pos + 4 <= b->size) memcpy(b->data + pos, &v, 4);
+}
+
+void buf_free(struct buf *b)
+{
+    free(b->data);
+    memset(b, 0, sizeof(*b));
+}
+
+/* The "version 1" string hash used by PDB name tables and the named stream map. */
+DWORD pdb_hash_v1(const BYTE *s, DWORD len)
+{
+    DWORD result = 0, i;
+
+    for (i = 0; i + 4 <= len; i += 4)
+    {
+        DWORD v;
+        memcpy(&v, s + i, 4);
+        result ^= v;
+    }
+    if (len - i >= 2)
+    {
+        WORD v;
+        memcpy(&v, s + i, 2);
+        result ^= v;
+        i += 2;
+    }
+    if (i < len) result ^= s[i];
+    result |= 0x20202020;
+    result ^= result >> 11;
+    return result ^ (result >> 16);
+}
+
+/* Build a "/names" string table.  Offsets of the added strings are those
+ * returned by names_add. */
+void names_init(struct names_table *t)
+{
+    memset(t, 0, sizeof(*t));
+    buf_u8(&t->strings, 0);   /* offset 0 is the empty string */
+}
+
+DWORD names_add(struct names_table *t, const char *s)
+{
+    DWORD i, off;
+
+    /* identical strings share one entry */
+    for (i = 0; i < t->count; i++)
+        if (!strcmp((const char *)t->strings.data + t->offsets[i], s)) return t->offsets[i];
+
+    if (!(t->count % 16))
+    {
+        DWORD *p = realloc(t->offsets, (t->count + 16) * sizeof(*p));
+        if (!p) { t->strings.fail = TRUE; return 0; }
+        t->offsets = p;
+    }
+    off = t->strings.size;
+    buf_cstr(&t->strings, s);
+    t->offsets[t->count++] = off;
+    return off;
+}
+
+void names_serialize(const struct names_table *t, struct buf *out)
+{
+    DWORD buckets, i, *table;
+
+    buckets = t->count * 2 + 1;
+    table = calloc(buckets, sizeof(*table));
+    if (!table) { out->fail = TRUE; return; }
+    for (i = 0; i < t->count; i++)
+    {
+        const char *s = (const char *)t->strings.data + t->offsets[i];
+        DWORD h = pdb_hash_v1((const BYTE *)s, strlen(s)) % buckets;
+        while (table[h]) h = (h + 1) % buckets;
+        table[h] = t->offsets[i];
+    }
+    buf_u32(out, 0xeffeeffe);
+    buf_u32(out, 1);
+    buf_u32(out, t->strings.size);
+    buf_put(out, t->strings.data, t->strings.size);
+    buf_u32(out, buckets);
+    buf_put(out, table, buckets * sizeof(*table));
+    buf_u32(out, t->count);
+    free(table);
+}
+
+void names_free(struct names_table *t)
+{
+    buf_free(&t->strings);
+    free(t->offsets);
+    memset(t, 0, sizeof(*t));
+}
+
+/* PDB info stream (stream 1) with the named stream map. */
+void pdb_build_info(struct buf *out, DWORD timestamp, DWORD age, const GUID *guid,
+                    const struct named_stream *named, DWORD count)
+{
+    struct buf strs = {0};
+    DWORD *offs, i, capacity, words, *keys, *vals, *present;
+
+    offs = calloc(max(count, 1), sizeof(*offs));
+    capacity = count * 3 / 2 + 1;
+    keys = calloc(capacity, sizeof(*keys));
+    vals = calloc(capacity, sizeof(*vals));
+    words = (capacity + 31) / 32;
+    present = calloc(words, sizeof(*present));
+    if (!offs || !keys || !vals || !present) { out->fail = TRUE; goto done; }
+
+    for (i = 0; i < count; i++)
+    {
+        offs[i] = strs.size;
+        buf_cstr(&strs, named[i].name);
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        DWORD h = pdb_hash_v1((const BYTE *)named[i].name, strlen(named[i].name)) % capacity;
+        while (present[h / 32] & (1u << (h % 32))) h = (h + 1) % capacity;
+        present[h / 32] |= 1u << (h % 32);
+        keys[h] = offs[i];
+        vals[h] = named[i].index;
+    }
+
+    buf_u32(out, 20000404);       /* VC70 */
+    buf_u32(out, timestamp);
+    buf_u32(out, age);
+    buf_put(out, guid, sizeof(*guid));
+    buf_u32(out, strs.size);
+    buf_put(out, strs.data, strs.size);
+    buf_u32(out, count);
+    buf_u32(out, capacity);
+    buf_u32(out, words);
+    buf_put(out, present, words * sizeof(*present));
+    buf_u32(out, 0);              /* no deleted entries */
+    for (i = 0; i < capacity; i++)
+    {
+        if (!(present[i / 32] & (1u << (i % 32)))) continue;
+        buf_u32(out, keys[i]);
+        buf_u32(out, vals[i]);
+    }
+    buf_u32(out, 0);              /* niMax */
+    buf_u32(out, 20140508);       /* feature: VC140 */
+
+done:
+    buf_free(&strs);
+    free(offs);
+    free(keys);
+    free(vals);
+    free(present);
+}
+
+/* Assemble the streams into an MSF container. */
+HRESULT msf_build(const struct buf *streams, DWORD count, struct buf *out)
+{
+    DWORD i, data_blocks = 0, dir_bytes, dir_blocks, num_blocks, block, j, fpm_bytes;
+    struct buf dir = {0};
+    BYTE *file;
+    DWORD next;
+
+    for (i = 0; i < count; i++)
+    {
+        if (streams[i].fail) return E_OUTOFMEMORY;
+        data_blocks += (streams[i].size + MSF_BLOCK_SIZE - 1) / MSF_BLOCK_SIZE;
+    }
+    dir_bytes = 4 + count * 4 + data_blocks * 4;
+    dir_blocks = (dir_bytes + MSF_BLOCK_SIZE - 1) / MSF_BLOCK_SIZE;
+    if (dir_blocks > MSF_BLOCK_SIZE / 4) return HRESULT_FROM_WIN32(ERROR_FILE_TOO_LARGE);
+    num_blocks = 4 + dir_blocks + data_blocks;
+    if (num_blocks > MSF_MAX_BLOCKS) return HRESULT_FROM_WIN32(ERROR_FILE_TOO_LARGE);
+
+    file = calloc(num_blocks, MSF_BLOCK_SIZE);
+    if (!file) return E_OUTOFMEMORY;
+
+    /* directory */
+    buf_u32(&dir, count);
+    for (i = 0; i < count; i++) buf_u32(&dir, streams[i].size);
+    next = 4 + dir_blocks;
+    for (i = 0; i < count; i++)
+    {
+        DWORD n = (streams[i].size + MSF_BLOCK_SIZE - 1) / MSF_BLOCK_SIZE;
+        for (j = 0; j < n; j++)
+        {
+            buf_u32(&dir, next);
+            memcpy(file + (size_t)next * MSF_BLOCK_SIZE + 0, streams[i].data + (size_t)j * MSF_BLOCK_SIZE,
+                   min(MSF_BLOCK_SIZE, streams[i].size - j * MSF_BLOCK_SIZE));
+            next++;
+        }
+    }
+    if (dir.fail) { free(file); return E_OUTOFMEMORY; }
+    memcpy(file + 4 * MSF_BLOCK_SIZE, dir.data, dir.size);
+    /* block map: the directory blocks */
+    for (i = 0; i < dir_blocks; i++)
+    {
+        DWORD v = 4 + i;
+        memcpy(file + 3 * MSF_BLOCK_SIZE + i * 4, &v, 4);
+    }
+    /* free block map: bit set = free */
+    fpm_bytes = MSF_BLOCK_SIZE;
+    memset(file + 1 * MSF_BLOCK_SIZE, 0xff, fpm_bytes);
+    for (block = 0; block < num_blocks; block++)
+        file[1 * MSF_BLOCK_SIZE + block / 8] &= ~(1u << (block % 8));
+    memcpy(file + 2 * MSF_BLOCK_SIZE, file + 1 * MSF_BLOCK_SIZE, fpm_bytes);
+    /* super block */
+    memcpy(file, msf_magic, 32);
+    ((DWORD *)(file + 32))[0] = MSF_BLOCK_SIZE;
+    ((DWORD *)(file + 32))[1] = 1;            /* free block map block */
+    ((DWORD *)(file + 32))[2] = num_blocks;
+    ((DWORD *)(file + 32))[3] = dir_bytes;
+    ((DWORD *)(file + 32))[4] = 0;
+    ((DWORD *)(file + 32))[5] = 3;            /* block map address */
+
+    buf_free(&dir);
+    out->data = file;
+    out->size = out->cap = num_blocks * MSF_BLOCK_SIZE;
+    return S_OK;
+}
