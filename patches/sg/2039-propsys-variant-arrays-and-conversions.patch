+static HRESULT variant_array_from(VARTYPE vt, const void *items, ULONG count, ULONG size, VARIANT *var)
+{
+    SAFEARRAY *sa;
+    void *data;
+
+    if (!var) return E_INVALIDARG;
+    VariantInit(var);
+    if (!items && count) return E_INVALIDARG;
+    if (!(sa = SafeArrayCreateVector(vt, 0, count))) return E_OUTOFMEMORY;
+    if (count)
+    {
+        SafeArrayAccessData(sa, &data);
+        memcpy(data, items, count * size);
+        SafeArrayUnaccessData(sa);
+    }
+    V_VT(var) = VT_ARRAY | vt;
+    V_ARRAY(var) = sa;
+    return S_OK;
+}
+
+HRESULT WINAPI InitVariantFromBooleanArray(const BOOL *items, ULONG count, VARIANT *var)
+{
+    VARIANT_BOOL *copy;
+    ULONG i;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p\n", items, count, var);
+
+    if (!items && count) return E_INVALIDARG;
+    if (!(copy = CoTaskMemAlloc(max(count, 1) * sizeof(*copy)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) copy[i] = items[i] ? VARIANT_TRUE : VARIANT_FALSE;
+    hr = variant_array_from(VT_BOOL, copy, count, sizeof(*copy), var);
+    CoTaskMemFree(copy);
+    return hr;
+}
+
+HRESULT WINAPI InitVariantFromStringArray(const WCHAR **items, ULONG count, VARIANT *var)
+{
+    SAFEARRAY *sa;
+    ULONG i;
+
+    TRACE("%p, %lu, %p\n", items, count, var);
+
+    if (!var) return E_INVALIDARG;
+    VariantInit(var);
+    if (!items && count) return E_INVALIDARG;
+    if (!(sa = SafeArrayCreateVector(VT_BSTR, 0, count))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        BSTR str = SysAllocString(items[i]);
+        LONG index = i;
+        SafeArrayPutElement(sa, &index, str);
+        SysFreeString(str);
+    }
+    V_VT(var) = VT_ARRAY | VT_BSTR;
+    V_ARRAY(var) = sa;
+    return S_OK;
+}
+
+static HRESULT variant_vector_op(const VARIANT *var, ULONG max_count, void *items, ULONG *count, BOOL alloc, void **alloc_out,
+        ULONG item_size, HRESULT (WINAPI *convert)(REFPROPVARIANT, void *))
+{
+    PROPVARIANT pv;
+    HRESULT hr;
+
+    if (FAILED(hr = variant_to_propvar(var, &pv))) return hr;
+    if (alloc) hr = propvar_to_vector_alloc(&pv, item_size, alloc_out, count, convert);
+    else hr = propvar_to_vector(&pv, max_count, item_size, items, count, convert);
+    PropVariantClear(&pv);
+    return hr;
+}
+
+HRESULT WINAPI VariantToBooleanArray(const VARIANT *var, BOOL *items, ULONG max_count, ULONG *count)
+{
+    TRACE("%p, %p, %lu, %p\n", var, items, max_count, count);
+    return variant_vector_op(var, max_count, items, count, FALSE, NULL, sizeof(*items), convert_boolean_item);
+}
