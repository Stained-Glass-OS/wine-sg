From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] propsys: VARIANT conversions and arrays (2039)

propsys: the VARIANT forms of the vector work: VariantTo<Int16, Int32,
Int64, UInt16, UInt32, UInt64, Double, Boolean> and their WithDefault,
VariantGetElementCount, VariantGet<type>Elem, InitVariantFrom<type>Array,
VariantTo<type>Array and ...ArrayAlloc, the string forms and
VariantToStringAlloc. A one-dimensional SAFEARRAY is read as a vector and
the PROPVARIANT conversions are reused. All were stubs.
---
--- a/dlls/propsys/propvar.c
+++ b/dlls/propsys/propvar.c
@@ -1984,3 +1984,611 @@
     TRACE("%p, %p, %p\n", pv, items, count);
     return propvar_to_vector_alloc(pv, sizeof(**items), (void **)items, count, convert_Double_item);
 }
+
+/* The VARIANT forms: the same through a PROPVARIANT, a one-dimensional array being a vector */
+
+static HRESULT variant_to_propvar(const VARIANT *var, PROPVARIANT *pv)
+{
+    SAFEARRAY *sa;
+    LONG lower, upper, i;
+    VARTYPE vt;
+    ULONG size;
+    void *data;
+    HRESULT hr;
+
+    if (!var || !pv) return E_INVALIDARG;
+    if (!(V_VT(var) & VT_ARRAY) || (V_VT(var) & VT_BYREF)) return VariantToPropVariant(var, pv);
+
+    sa = V_ARRAY(var);
+    vt = V_VT(var) & ~VT_ARRAY;
+    if (!sa || SafeArrayGetDim(sa) != 1 || !(size = propvar_element_size(vt))) return E_INVALIDARG;
+    if (vt == VT_BSTR) size = sizeof(WCHAR *);
+    if (FAILED(hr = SafeArrayGetLBound(sa, 1, &lower)) || FAILED(hr = SafeArrayGetUBound(sa, 1, &upper))) return hr;
+    if (FAILED(hr = SafeArrayAccessData(sa, &data))) return hr;
+
+    PropVariantInit(pv);
+    pv->vt = vt | VT_VECTOR;
+    pv->caub.cElems = upper - lower + 1;
+    if (!(pv->caub.pElems = CoTaskMemAlloc(max(pv->caub.cElems, 1) * size)))
+    {
+        SafeArrayUnaccessData(sa);
+        return E_OUTOFMEMORY;
+    }
+#ifdef SG_MUTANT_VARARRAY_STRINGS
+    if (vt == VT_BSTR) { SafeArrayUnaccessData(sa); return E_INVALIDARG; }
+#endif
+    if (vt == VT_BSTR)
+    {
+        /* strings become wide strings that the caller can free with the vector */
+        pv->vt = VT_LPWSTR | VT_VECTOR;
+        for (i = 0; i < (LONG)pv->caub.cElems; i++)
+        {
+            const WCHAR *src = ((BSTR *)data)[i];
+            WCHAR **dst = (WCHAR **)pv->caub.pElems + i;
+            *dst = CoTaskMemAlloc((src ? lstrlenW(src) + 1 : 1) * sizeof(WCHAR));
+            lstrcpyW(*dst, src ? src : L"");
+        }
+    }
+    else
+        memcpy(pv->caub.pElems, data, pv->caub.cElems * size);
+    SafeArrayUnaccessData(sa);
+    return S_OK;
+}
+
+ULONG WINAPI VariantGetElementCount(const VARIANT *var)
+{
+    LONG lower, upper;
+
+    TRACE("%p\n", var);
+
+    if (!var || V_VT(var) == VT_EMPTY || V_VT(var) == VT_NULL) return 0;
+#ifdef SG_MUTANT_VARARRAY_COUNT
+    return 1;
+#endif
+    if ((V_VT(var) & VT_ARRAY) && !(V_VT(var) & VT_BYREF))
+    {
+        SAFEARRAY *sa = V_ARRAY(var);
+        if (sa && SafeArrayGetDim(sa) == 1 && SUCCEEDED(SafeArrayGetLBound(sa, 1, &lower)) && SUCCEEDED(SafeArrayGetUBound(sa, 1, &upper)))
+            return upper - lower + 1;
+    }
+    return 1;
+}
