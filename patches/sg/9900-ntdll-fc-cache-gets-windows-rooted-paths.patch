From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wine.inf: fontconfig's fc-cache gets Windows' meaning of a rooted path (9900)

Gramps' installer (NSIS) runs its bundled fc-cache -fv with FC_DEBUG=128
through nsExec::ExecToLog, and crashed in the heap; its crash dialog then
left fc-cache blocked on the pipe (the Store's "Gramps hangs").

It is not a heap tolerance question. NSIS <= 3.11 nsExec grows its
2048-character line buffer with "cbAlloc = cchAlloc / sizeof(TCHAR)" (it
means '*'): a longer line makes GlobalReAlloc shrink the 0x1002-byte block
to 0x602 while the line goes on being written up to 6 KB and more -- past
the original block, a corruption Windows' heap would not survive either.
On Windows no line comes near 2048 characters. Here fc-cache's default
font folders, its XDG defaults "/usr/share/fonts" and
"/usr/local/share/fonts", which on Windows are folders of the current
drive (C:\usr\share\fonts) that do not exist, resolved through Wine's
"may be a Unix path" rule in RtlGetFullPathName_U to the Linux system's
/usr/share/fonts: fc-cache scanned its cmap and X11 encoding files, which
are not fonts and get "Scanning file ..." with no "done" and no newline --
20 lines over 2048 characters, the longest 6247.

Wine's rule stays (Unix paths on command lines rely on it), but like a
Windows compatibility shim a program named in
Software\Wine\AppDefaults\<program.exe> with "SgUnixPaths" = 0 (HKCU,
else HKLM; read once per process) gets Windows' meaning of a rooted path
only, and wine.inf sets it for fc-cache.exe: its cache then holds the
Windows font folders (where the Linux fonts are linked already), as on
Windows. The programs using fontconfig themselves keep the Unix rule.
Gate: test/winpaths-gate.sh; mutant SG_MUTANT_UNIX_PATHS_ALWAYS. Checked
by hand: Gramps 6.0.8's installer completes (it crashed before).
---
 dlls/ntdll/path.c  | 68 +++++++++++++++++++++++++++++++++++++++++++++++++++++-
 loader/wine.inf.in |  3 +++
 2 files changed, 70 insertions(+), 1 deletion(-)

--- a/dlls/ntdll/path.c
+++ b/dlls/ntdll/path.c
@@ -517,6 +517,72 @@ static const WCHAR *skip_unc_prefix( const WCHAR *ptr )
  * Helper for RtlGetFullPathName_U
  * Note: name and buffer are allowed to point to the same memory spot
  */
+/* Stained Glass OS: a Windows program that is a port of Unix software looks in Unix places by
+ * default -- fontconfig's fc-cache scans "/usr/share/fonts" and "/usr/local/share/fonts" (its XDG
+ * defaults). On Windows those are folders of the current drive (C:\usr\share\fonts) that do not
+ * exist; Wine resolves a rooted path that exists as a Unix path to that Unix path (for Unix paths on
+ * command lines), so fc-cache scanned the Linux system's fonts, cmap and encoding files. Gramps'
+ * installer runs it with FC_DEBUG=128 through NSIS <= 3.11 nsExec, whose line buffer shrinks when it
+ * should grow (cbAlloc = cchAlloc / sizeof(TCHAR)): the thousands-of-characters lines of "Scanning
+ * file ..." for non-fonts overran its heap block by kilobytes -- a corruption Windows' heap would not
+ * survive either -- and the installer crashed. Like a Windows compatibility shim, a program named in
+ * Software\Wine\AppDefaults\<program.exe> with "SgUnixPaths" = 0 (HKCU, else HKLM; wine.inf sets it
+ * for fc-cache.exe) gets Windows' meaning of a rooted path only. */
+static BOOL unix_paths_resolved(void)
+{
+    static int resolved = -1;
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    WCHAR path[MAX_PATH + 64];
+    const WCHAR *base, *p, *end;
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    UNICODE_STRING nameW, valueW;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE key, user = 0;
+    ULONG len;
+    int i, ret = -1;
+
+#ifdef SG_MUTANT_UNIX_PATHS_ALWAYS
+    return TRUE;
+#endif
+    if (resolved != -1) return resolved;
+    if (!image->Buffer || !image->Length) return TRUE;  /* not known yet: ask again */
+    end = image->Buffer + image->Length / sizeof(WCHAR);
+    for (base = p = image->Buffer; p < end; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (end - base == 0 || end - base > MAX_PATH) return resolved = TRUE;
+
+    RtlInitUnicodeString( &valueW, L"SgUnixPaths" );
+    for (i = 0; i < 2 && ret == -1; i++)
+    {
+        if (i == 0)
+        {
+            if (RtlOpenCurrentUser( KEY_READ, &user )) continue;
+            wcscpy( path, L"Software\\Wine\\AppDefaults\\" );
+        }
+        else
+        {
+            wcscpy( path, L"\\Registry\\Machine\\Software\\Wine\\AppDefaults\\" );
+        }
+        len = wcslen( path );
+        memcpy( path + len, base, (end - base) * sizeof(WCHAR) );
+        path[len + (end - base)] = 0;
+        RtlInitUnicodeString( &nameW, path );
+        InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, i == 0 ? user : 0, NULL );
+        if (!NtOpenKey( &key, KEY_QUERY_VALUE, &attr ))
+        {
+            if (!NtQueryValueKey( key, &valueW, KeyValuePartialInformation, buffer, sizeof(buffer), &len ) &&
+                info->Type == REG_DWORD && info->DataLength == sizeof(DWORD))
+                ret = *(DWORD *)info->Data != 0;
+            NtClose( key );
+        }
+        if (user) NtClose( user );
+        user = 0;
+    }
+    if (ret == -1) ret = 1;
+    TRACE( "%s: Unix paths %s\n", debugstr_wn( base, end - base ), ret ? "resolved" : "not resolved" );
+    return resolved = ret;
+}
+
 static ULONG get_full_path_helper(LPCWSTR name, LPWSTR buffer, ULONG size)
 {
     ULONG                       reqsize = 0, mark = 0, dep = 0, deplen;
@@ -616,7 +682,7 @@ static ULONG get_full_path_helper(LPCWSTR name, LPWSTR buffer, ULONG size)
         break;
 
     case ABSOLUTE_PATH:         /* \xxx    */
-        if (name[0] == '/')  /* may be a Unix path */
+        if (name[0] == '/' && unix_paths_resolved())  /* may be a Unix path */
         {
             char *unix_name;
             WCHAR *nt_str;
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -3092,6 +3092,9 @@ HKLM,Software\Wine\AppDefaults\OneDrive.exe,"SgXaml",0x10001,1
 ; NanaZip (wine-sg 7710): its file manager's toolbar and menus are a XAML island; without XAML
 ; it stops at "K7ModernInitialize Failed". Its other programs (extraction, console) do not need it.
 HKLM,Software\Wine\AppDefaults\NanaZip.Modern.FileManager.exe,"SgXaml",0x10001,1
+; fontconfig's cache builder (wine-sg 9900): "/usr/share/fonts" is C:\usr\share\fonts for it, as on
+; Windows, not the Linux system's fonts folder -- Gramps' installer crashed on its output.
+HKLM,Software\Wine\AppDefaults\fc-cache.exe,"SgUnixPaths",0x10001,0
 
