+    {
+        /* the clock is root's: sg-admind's "time" takes the local time */
+        WCHAR when[32];
+        DWORD err;
+
+        swprintf( when, ARRAY_SIZE(when), L"%04u-%02u-%02u %02u:%02u:%02u", systime->wYear, systime->wMonth,
