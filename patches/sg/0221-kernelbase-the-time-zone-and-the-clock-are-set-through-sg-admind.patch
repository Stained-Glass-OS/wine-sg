+static const WCHAR *iana_zone( const WCHAR *windows )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(windows_zones); i++)
+        if (!wcsicmp( windows_zones[i].windows, windows )) return windows_zones[i].iana;
+    return NULL;
+}
+
+/***********************************************************************
+ *	sg_admin_request
+ *
+ * Stained Glass: the machine's time zone and clock are root's, so a Windows
+ * program changes them through sg-admind, sg-shell's administration
+ * service (its "timezone" and "time" verbs). A request is a file in its
+ * spool, which only SYSTEM -- an elevated program -- can write: anyone else
+ * gets ERROR_PRIVILEGE_NOT_HELD, as a standard user does on Windows.
+ * SG_ADMIN_SPOOL names another spool (the gates'). Returns a Win32 error.
+ */
+DWORD sg_admin_request( const WCHAR *verb, const WCHAR *arg )
+{
+    WCHAR spool[MAX_PATH], dir[MAX_PATH + 16], tmp[MAX_PATH + 80], req[MAX_PATH + 80], rep[MAX_PATH + 80], id[40];
+    char body[512], answer[1024];
+    LARGE_INTEGER counter;
+    DWORD len, written, i, err;
+    HANDLE file;
+    WCHAR *p;
+
+    if (!GetEnvironmentVariableW( L"SG_ADMIN_SPOOL", spool, ARRAY_SIZE(spool) ))
+        lstrcpyW( spool, L"/run/stained-glass-admin" );
+    if (spool[0] != '/') return ERROR_PRIVILEGE_NOT_HELD;
+    swprintf( dir, ARRAY_SIZE(dir), L"\\\\?\\unix%s", spool );
+    for (p = dir; *p; p++) if (*p == '/') *p = '\\';
+
+    RtlQueryPerformanceCounter( &counter );
+    swprintf( id, ARRAY_SIZE(id), L"%08lx%08lx%08lx%08lx", GetCurrentProcessId(), GetCurrentThreadId(),
+              counter.LowPart, GetTickCount() ^ counter.HighPart );
+    swprintf( tmp, ARRAY_SIZE(tmp), L"%s\\requests\\.%s", dir, id );
+    swprintf( req, ARRAY_SIZE(req), L"%s\\requests\\%s.req", dir, id );
+    swprintf( rep, ARRAY_SIZE(rep), L"%s\\replies\\%s.rep", dir, id );
+
+    len = WideCharToMultiByte( CP_UTF8, 0, verb, -1, body, sizeof(body) - 1, NULL, NULL );
+    if (!len) return ERROR_INVALID_PARAMETER;
+    body[len - 1] = '\n';
+    i = WideCharToMultiByte( CP_UTF8, 0, arg, -1, body + len, sizeof(body) - len - 1, NULL, NULL );
+    if (!i) return ERROR_INVALID_PARAMETER;
+    len += i;
+    body[len - 1] = '\n';
+
+    /* written under another name and renamed: whole when it appears */
+    file = CreateFileW( tmp, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return ERROR_PRIVILEGE_NOT_HELD;
+    err = WriteFile( file, body, len, &written, NULL ) && written == len ? 0 : GetLastError();
+    CloseHandle( file );
+    if (err || !MoveFileExW( tmp, req, 0 ))
+    {
+        DeleteFileW( tmp );
+        return ERROR_PRIVILEGE_NOT_HELD;
+    }
+
+    for (i = 0; i < 300; i++)   /* 30 s */
+    {
+        file = CreateFileW( rep, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL );
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            Sleep( 50 );   /* written whole: sg-admind renames it into place, but be sure */
+            len = 0;
+            ReadFile( file, answer, sizeof(answer) - 1, &len, NULL );
+            CloseHandle( file );
+            answer[len] = 0;
+            if (!strncmp( answer, "OK", 2 ) && (answer[2] == '\n' || !answer[2])) return ERROR_SUCCESS;
+            WARN( "%s %s: %s\n", debugstr_w(verb), debugstr_w(arg), debugstr_a(answer) );
+            return ERROR_ACCESS_DENIED;
+        }
+        Sleep( 100 );
+    }
+    WARN( "%s %s: no answer\n", debugstr_w(verb), debugstr_w(arg) );
+    return ERROR_TIMEOUT;
+}
+
+static BOOL set_zone_by_key( const WCHAR *key, BOOL *known )
+{
+    const WCHAR *zone = key ? iana_zone( key ) : NULL;
+    DWORD err;
+
+    *known = zone != NULL;
+    if (!zone) return FALSE;
+    if ((err = sg_admin_request( L"timezone", zone ))) SetLastError( err );
+    return !err;
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH SetTimeZoneInformation( const TIME_ZONE_INFORMATION *info )
 {
+    BOOL known, ret;
+
+    /* a Windows zone's standard name is its key's name */
+    if (!info) return set_ntstatus( STATUS_INVALID_PARAMETER );
+    ret = set_zone_by_key( info->StandardName, &known );
+    if (known) return ret;
     return set_ntstatus( RtlSetTimeZoneInformation( (const RTL_TIME_ZONE_INFORMATION *)info ));
 }
 
@@ -7293,10 +7535,20 @@
 /***********************************************************************
  *	SetDynamicTimeZoneInformation   (kernelbase.@)
  *
- * The machine's time zone is the host's, as for SetTimeZoneInformation.
+ * The machine's zone is the host's: the zone the key names, set by sg-admind.
  */
 BOOL WINAPI DECLSPEC_HOTPATCH SetDynamicTimeZoneInformation( const DYNAMIC_TIME_ZONE_INFORMATION *info )
 {
+    BOOL known, ret;
+
+    if (!info) return set_ntstatus( STATUS_INVALID_PARAMETER );
+    ret = set_zone_by_key( info->TimeZoneKeyName, &known );
+    if (known) return ret;
+    if (info->TimeZoneKeyName[0])
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
     return SetTimeZoneInformation( (const TIME_ZONE_INFORMATION *)info );
 }
 
