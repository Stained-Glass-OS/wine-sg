From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmp: Implement IOleObject::GetMoniker.

IOleObject::GetMoniker of the player control does what OLE's default
implementation does: it asks the client site for the moniker and returns
E_UNEXPECTED without a client site. The moniker pointer is NULL on any
error, as the method requires.

Gate: test/wmp-moniker-gate.sh (64/32).
---
 dlls/wmp/oleobj.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/dlls/wmp/oleobj.c b/dlls/wmp/oleobj.c
index 079dfdb..3e25413 100644
--- a/dlls/wmp/oleobj.c
+++ b/dlls/wmp/oleobj.c
@@ -390,11 +390,23 @@ static HRESULT WINAPI OleObject_SetMoniker(IOleObject *iface, DWORD dwWhichMonik
     return E_NOTIMPL;
 }
 
+/* As OLE's default implementation does: the client site's moniker, and
+ * E_UNEXPECTED without a client site. */
 static HRESULT WINAPI OleObject_GetMoniker(IOleObject *iface, DWORD dwAssign, DWORD dwWhichMoniker, IMoniker **ppmk)
 {
     WindowsMediaPlayer *This = impl_from_IOleObject(iface);
-    FIXME("(%p)->(%ld %ld %p)\n", This, dwAssign, dwWhichMoniker, ppmk);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%ld %ld %p)\n", This, dwAssign, dwWhichMoniker, ppmk);
+
+    if(!ppmk)
+        return E_POINTER;
+    *ppmk = NULL;
+#ifdef SG_MUTANT_WMP_MONIKER_NOSITE
+    return E_UNEXPECTED;
+#endif
+    if(!This->client_site)
+        return E_UNEXPECTED;
+    return IOleClientSite_GetMoniker(This->client_site, dwAssign, dwWhichMoniker, ppmk);
 }
 
 static HRESULT WINAPI OleObject_InitFromData(IOleObject *iface, IDataObject *pDataObject, BOOL fCreation,
