From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 13:56:30 -0700
Subject: [PATCH] inseng: CheckTrustEx no longer reports success

The function returned TRUE for every file, i.e. it vouched for code it never checked. It now returns
TRUST_E_PROVIDER_UNKNOWN (no verification is implemented) with the HRESULT return type of the real function.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/inseng/inseng_main.c b/dlls/inseng/inseng_main.c
index 841c733..45b5623 100644
--- a/dlls/inseng/inseng_main.c
+++ b/dlls/inseng/inseng_main.c
@@ -29,6 +29,7 @@
 #include "ole2.h"
 #include "rpcproxy.h"
 #include "initguid.h"
+#include "winerror.h"
 #include "inseng.h"
 
 #include "wine/debug.h"
@@ -436,10 +437,12 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID iid, LPVOID *ppv)
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
-BOOL WINAPI CheckTrustEx( LPVOID a, LPVOID b, LPVOID c, LPVOID d, LPVOID e )
+HRESULT WINAPI CheckTrustEx( LPVOID a, LPVOID b, LPVOID c, LPVOID d, LPVOID e )
 {
-    FIXME("%p %p %p %p %p: signatures are not verified\n", a, b, c, d, e );
-    return TRUE;
+    WARN("%p %p %p %p %p: signatures are not verified, refusing\n", a, b, c, d, e );
+
+    /* No code signature check is implemented: never report a file as trusted. */
+    return TRUST_E_PROVIDER_UNKNOWN;
 }
 
 /***********************************************************************
