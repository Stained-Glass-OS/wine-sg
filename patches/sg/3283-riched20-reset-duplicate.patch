From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 22:06:44 -0700
Subject: [PATCH] riched20: ITextPara Reset/SetDuplicate, ITextFont
 Reset(tomDefault) on a range (3283)

ITextPara::Reset(tomDefault) sets the paragraph format of the range back to the RTF \pard defaults; ITextPara::SetDuplicate applies every defined property of another ITextPara; ITextFont::Reset(tomDefault) on a range font resets and applies the character format (the name stays). Reset(tomUndefined) and unknown values are E_INVALIDARG for an object attached to a range.

diff --git a/dlls/riched20/richole.c b/dlls/riched20/richole.c
index 265b40b..30d950a 100644
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -3619,11 +3619,25 @@ static HRESULT WINAPI TextFont_Reset(ITextFont *iface, LONG value)
             This->set_cache_enabled = FALSE;
             textfont_apply_range_props(This);
             break;
+        case tomDefault:
+        {
+            /* the character format of the range goes back to the defaults (GUESS: the font name is kept,
+             * as tomUndefined does for a detached font) */
+            BSTR name = SysAllocString(This->props[FONT_NAME].str);
+
+            textfont_reset_to_default(This);
+            SysFreeString(This->props[FONT_NAME].str);
+            This->props[FONT_NAME].str = name;
+#ifndef SG_MUTANT_RICHED_FONTRESET
+            if (!This->set_cache_enabled)
+                textfont_apply_range_props(This);
+#endif
+            break;
+        }
         case tomUsePoints:
         case tomUseTwips:
-            return E_INVALIDARG;
         default:
-            FIXME("reset mode %ld not supported\n", value);
+            return E_INVALIDARG;
         }
 
         return S_OK;
@@ -4559,8 +4573,93 @@ static HRESULT WINAPI TextPara_GetDuplicate(ITextPara *iface, ITextPara **ret)
 static HRESULT WINAPI TextPara_SetDuplicate(ITextPara *iface, ITextPara *para)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%p)\n", This, para);
-    return E_NOTIMPL;
+    PARAFORMAT2 fmt, cur;
+    FLOAT first, left, right, before, after, spacing, tab;
+    LONG value, rule;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p)\n", This, para);
+
+    if (!para) return E_INVALIDARG;
+    if (FAILED(hr = textpara_get_fmt( This, &cur ))) return hr;   /* CO_E_RELEASED */
+
+    /* every property the source has defined is applied; tomUndefined ones change nothing */
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.cbSize = sizeof(fmt);
+    if (SUCCEEDED(ITextPara_GetAlignment( para, &value )) && value != tomUndefined)
+    {
+        fmt.dwMask |= PFM_ALIGNMENT;
+        fmt.wAlignment = value == tomAlignCenter ? PFA_CENTER : value == tomAlignRight ? PFA_RIGHT
+                       : value == tomAlignJustify ? PFA_JUSTIFY : PFA_LEFT;
+    }
+#define DUP_FLAG(getter, mask, invert) \
+    if (SUCCEEDED(getter( para, &value )) && (value == tomTrue || value == tomFalse)) \
+    { \
+        fmt.dwMask |= (mask); \
+        if ((value == tomTrue) != (invert)) fmt.wEffects |= (mask) >> 16; \
+    }
+    DUP_FLAG(ITextPara_GetHyphenation, PFM_DONOTHYPHEN, TRUE)
+    DUP_FLAG(ITextPara_GetKeepTogether, PFM_KEEP, FALSE)
+    DUP_FLAG(ITextPara_GetKeepWithNext, PFM_KEEPNEXT, FALSE)
+    DUP_FLAG(ITextPara_GetNoLineNumber, PFM_NOLINENUMBER, FALSE)
+    DUP_FLAG(ITextPara_GetPageBreakBefore, PFM_PAGEBREAKBEFORE, FALSE)
+    DUP_FLAG(ITextPara_GetWidowControl, PFM_NOWIDOWCONTROL, TRUE)
+#undef DUP_FLAG
+    if (SUCCEEDED(ITextPara_GetFirstLineIndent( para, &first )) && first != tomUndefined &&
+        SUCCEEDED(ITextPara_GetLeftIndent( para, &left )) && left != tomUndefined)
+    {
+        fmt.dwMask |= PFM_STARTINDENT | PFM_OFFSET;
+        fmt.dxOffset = round_float( points_to_twips( -first ) );
+        fmt.dxStartIndent = round_float( points_to_twips( left ) ) - fmt.dxOffset;
+    }
+    if (SUCCEEDED(ITextPara_GetRightIndent( para, &right )) && right != tomUndefined)
+    {
+        fmt.dwMask |= PFM_RIGHTINDENT;
+        fmt.dxRightIndent = round_float( points_to_twips( right ) );
+    }
+    if (SUCCEEDED(ITextPara_GetSpaceBefore( para, &before )) && before != tomUndefined)
+    {
+        fmt.dwMask |= PFM_SPACEBEFORE;
+        fmt.dySpaceBefore = round_float( points_to_twips( before ) );
+    }
+    if (SUCCEEDED(ITextPara_GetSpaceAfter( para, &after )) && after != tomUndefined)
+    {
+        fmt.dwMask |= PFM_SPACEAFTER;
+        fmt.dySpaceAfter = round_float( points_to_twips( after ) );
+    }
+    if (SUCCEEDED(ITextPara_GetLineSpacingRule( para, &rule )) && rule != tomUndefined &&
+        SUCCEEDED(ITextPara_GetLineSpacing( para, &spacing )) && spacing != tomUndefined)
+    {
+        fmt.dwMask |= PFM_LINESPACING;
+        fmt.bLineSpacingRule = rule;
+        fmt.dyLineSpacing = round_float( points_to_twips( spacing ) );
+    }
+    if (SUCCEEDED(ITextPara_GetListType( para, &value )) && value != tomUndefined)
+    {
+        fmt.dwMask |= PFM_NUMBERING | PFM_NUMBERINGSTYLE;
+        fmt.wNumbering = value & 0xffff;
+        fmt.wNumberingStyle = ((value >> 16) & 0xf) << 8;
+    }
+    if (SUCCEEDED(ITextPara_GetListStart( para, &value )) && value != tomUndefined)
+    {
+        fmt.dwMask |= PFM_NUMBERINGSTART;
+        fmt.wNumberingStart = value;
+    }
+    if (SUCCEEDED(ITextPara_GetListTab( para, &tab )) && tab != tomUndefined)
+    {
+        fmt.dwMask |= PFM_NUMBERINGTAB;
+        fmt.wNumberingTab = round_float( points_to_twips( tab ) );
+    }
+    if (SUCCEEDED(ITextPara_GetStyle( para, &value )) && value != tomUndefined)
+    {
+        fmt.dwMask |= PFM_STYLE;
+        fmt.sStyle = value;
+    }
+#ifdef SG_MUTANT_RICHED_PARADUP
+    fmt.dwMask = 0;
+#endif
+    if (!fmt.dwMask) return S_OK;
+    return textpara_set_fmt( This, &fmt );
 }
 
 static HRESULT WINAPI TextPara_CanChange(ITextPara *iface, LONG *ret)
@@ -4580,8 +4679,29 @@ static HRESULT WINAPI TextPara_IsEqual(ITextPara *iface, ITextPara *para, LONG *
 static HRESULT WINAPI TextPara_Reset(ITextPara *iface, LONG value)
 {
     ITextParaImpl *This = impl_from_ITextPara(iface);
-    FIXME("(%p)->(%ld)\n", This, value);
-    return E_NOTIMPL;
+    PARAFORMAT2 fmt;
+    PARAFORMAT2 cur;
+    HRESULT hr;
+
+    TRACE("(%p)->(%ld)\n", This, value);
+
+    if (FAILED(hr = textpara_get_fmt( This, &cur ))) return hr;   /* CO_E_RELEASED */
+
+    /* tomUndefined is for a detached duplicate; this object formats a range */
+    if (value != tomDefault) return E_INVALIDARG;
+
+    /* what RTF \pard sets: left aligned, no indents, no spacing, no list, none of the flags */
+    memset(&fmt, 0, sizeof(fmt));
+    fmt.cbSize = sizeof(fmt);
+    fmt.dwMask = PFM_ALIGNMENT | PFM_STARTINDENT | PFM_OFFSET | PFM_RIGHTINDENT | PFM_SPACEBEFORE | PFM_SPACEAFTER |
+                 PFM_LINESPACING | PFM_NUMBERING | PFM_NUMBERINGSTYLE | PFM_NUMBERINGSTART | PFM_NUMBERINGTAB |
+                 PFM_KEEP | PFM_KEEPNEXT | PFM_PAGEBREAKBEFORE | PFM_NOLINENUMBER | PFM_NOWIDOWCONTROL | PFM_DONOTHYPHEN;
+    fmt.wAlignment = PFA_LEFT;
+    fmt.bLineSpacingRule = 0;
+#ifdef SG_MUTANT_RICHED_PARARESET
+    fmt.dwMask &= ~PFM_ALIGNMENT;
+#endif
+    return textpara_set_fmt( This, &fmt );
 }
 
 static HRESULT WINAPI TextPara_GetStyle(ITextPara *iface, LONG *value)
