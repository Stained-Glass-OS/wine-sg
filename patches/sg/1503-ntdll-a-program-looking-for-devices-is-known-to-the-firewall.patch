From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: a program looking for devices is known to the firewall

A program that looks for devices on the network -- Sonos's app finding its
speakers (SSDP), anything using mDNS -- sends from a UDP socket to a
multicast group, and the devices answer to that socket's port. Stained
Glass Firewall opens an allowed program's ports, but it learns whose a
socket is only when Wine tells it (1500), and 1500 told it on a bind: a
socket the program never binds (the system gives it a port as it sends)
was never named, its port stayed closed, and the answers were dropped --
the speakers were never found.

Sending from a UDP socket to a multicast or broadcast address now tells
the firewall too (once per socket), with the port it was given.

Test: test/fwlisten-gate.sh (an unbound socket's M-SEARCH to
239.255.255.250:1900 is told, once; a unicast sender is not; mutant
SG_MUTANT_FW_LISTEN_NOTIFY).
---
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -28,6 +28,7 @@
 #include <sys/types.h>
 #include <sys/socket.h>
 #include <sys/ioctl.h>
+#include <sys/stat.h>
 #include <sys/un.h>
 #include <unistd.h>
 #ifdef HAVE_IFADDRS_H
@@ -1538,7 +1539,7 @@
  * Only a TCP socket that listens and a UDP socket that is bound, on an
  * address other computers can reach; never waits: a firewall that is not
  * running changes nothing. */
-void sg_firewall_notify( HANDLE handle, ULONG code )
+static void sg_firewall_notify_fd( int fd, int want_type )
 {
 #ifndef SG_MUTANT_FW_LISTEN_NOTIFY
     static const char default_path[] = "/run/stained-glass-firewall/notify";
@@ -1551,37 +1552,34 @@
     struct cmsghdr *cmsg;
     const UNICODE_STRING *image;
     const char *path;
-    int fd, needs_close = FALSE, type = 0, out, n;
+    int type = 0, out, n;
 
-    if (code != IOCTL_AFD_LISTEN && code != IOCTL_AFD_BIND) return;
-    if (server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )) return;
     tlen = sizeof(type);
-    if (getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &tlen ) ||
-        type != (code == IOCTL_AFD_LISTEN ? SOCK_STREAM : SOCK_DGRAM)) goto done;
-    if (getsockname( fd, &addr.addr, &len )) goto done;
+    if (getsockopt( fd, SOL_SOCKET, SO_TYPE, &type, &tlen ) || type != want_type) return;
+    if (getsockname( fd, &addr.addr, &len )) return;
     if (addr.addr.sa_family == AF_INET)
     {
-        if ((ntohl( addr.in.sin_addr.s_addr ) >> 24) == 127) goto done;
+        if ((ntohl( addr.in.sin_addr.s_addr ) >> 24) == 127) return;
     }
     else if (addr.addr.sa_family == AF_INET6)
     {
-        if (IN6_IS_ADDR_LOOPBACK( &addr.in6.sin6_addr )) goto done;
-        if (IN6_IS_ADDR_V4MAPPED( &addr.in6.sin6_addr ) && addr.in6.sin6_addr.s6_addr[12] == 127) goto done;
+        if (IN6_IS_ADDR_LOOPBACK( &addr.in6.sin6_addr )) return;
+        if (IN6_IS_ADDR_V4MAPPED( &addr.in6.sin6_addr ) && addr.in6.sin6_addr.s6_addr[12] == 127) return;
     }
-    else goto done;
+    else return;
 
     image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
     memcpy( text, "SGFW1\n", 6 );
     n = ntdll_wcstoumbs( image->Buffer, image->Length / sizeof(WCHAR), text + 6, sizeof(text) - 8, FALSE );
-    if (n <= 0) goto done;
+    if (n <= 0) return;
     text[6 + n] = '\n';
 
     if (!(path = getenv( "SG_FIREWALL_NOTIFY" )) || !path[0]) path = default_path;
-    if (strlen( path ) >= sizeof(to.sun_path)) goto done;
+    if (strlen( path ) >= sizeof(to.sun_path)) return;
     memset( &to, 0, sizeof(to) );
     to.sun_family = AF_UNIX;
     strcpy( to.sun_path, path );
-    if ((out = socket( AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0 )) == -1) goto done;
+    if ((out = socket( AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0 )) == -1) return;
     iov.iov_base = text;
     iov.iov_len = 7 + n;
     memset( &msg, 0, sizeof(msg) );
@@ -1599,11 +1597,48 @@
     if (sendmsg( out, &msg, MSG_DONTWAIT | MSG_NOSIGNAL ) == -1)
         TRACE( "firewall not told: %s\n", strerror( errno ) );
     close( out );
-done:
-    if (needs_close) close( fd );
 #endif
 }
 
+void sg_firewall_notify( HANDLE handle, ULONG code )
+{
+    int fd, needs_close = FALSE;
+
+    if (code != IOCTL_AFD_LISTEN && code != IOCTL_AFD_BIND) return;
+    if (server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )) return;
+    sg_firewall_notify_fd( fd, code == IOCTL_AFD_LISTEN ? SOCK_STREAM : SOCK_DGRAM );
+    if (needs_close) close( fd );
+}
+
+/* A UDP socket that sends to a multicast or broadcast address -- a program
+ * looking for devices (SSDP, mDNS): the answers come back from the devices
+ * to its port, which the firewall opens only if it knows whose the socket
+ * is. Such a socket is often never bound by the program (the system picks
+ * its port), so it is told now, once per socket. */
+static void sg_firewall_notify_send( int fd, const struct afd_sendmsg_params *params )
+{
+    static ino_t told[16];
+    static unsigned int next;
+    const struct WS_sockaddr *to = u64_to_user_ptr( params->addr_ptr );
+    struct stat st;
+    unsigned int i;
+    BOOL group = FALSE;
+
+    if (!to || params->addr_len < sizeof(struct WS_sockaddr_in)) return;
+    if (to->sa_family == WS_AF_INET)
+    {
+        const unsigned char *a = (const unsigned char *)&((const struct WS_sockaddr_in *)to)->sin_addr;
+        group = (a[0] & 0xf0) == 0xe0 || (a[0] == 255 && a[1] == 255 && a[2] == 255 && a[3] == 255);
+    }
+    else if (to->sa_family == WS_AF_INET6 && params->addr_len >= sizeof(struct WS_sockaddr_in6))
+        group = ((const unsigned char *)&((const struct WS_sockaddr_in6 *)to)->sin6_addr)[0] == 0xff;
+    if (!group || fstat( fd, &st )) return;
+    for (i = 0; i < ARRAY_SIZE(told); i++) if (told[i] == st.st_ino) return;
+    told[next++ % ARRAY_SIZE(told)] = st.st_ino;
+    sg_firewall_notify_fd( fd, SOCK_DGRAM );
+}
+
+
 
 NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc_user, IO_STATUS_BLOCK *io,
                      UINT code, void *in_buffer, UINT in_size, void *out_buffer, UINT out_size )
@@ -1809,6 +1844,8 @@
             status = sock_ioctl_send( handle, event, apc, apc_user, io, fd, u64_to_user_ptr( params->buffers_ptr ),
                                       params->count, u64_to_user_ptr( params->addr_ptr ), params->addr_len,
                                       unix_flags, params->force_async );
+            /* Stained Glass OS: the firewall learns whose discovery this is */
+            if (!status || status == STATUS_PENDING) sg_firewall_notify_send( fd, params );
             if (needs_close) close( fd );
             return status;
         }
