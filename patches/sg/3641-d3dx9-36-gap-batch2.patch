+/* The preprocessor leaves #line directives behind. */
+static char *fragment_clean_source(const char *text, SIZE_T length)
+{
+    char *out = malloc(length + 1), *o = out;
+    const char *p = text, *end = text + length;
+
+    if (!out)
+        return NULL;
+    while (p < end && *p)
+    {
+        const char *line_end = memchr(p, '\n', end - p);
+        size_t n = line_end ? line_end - p + 1 : end - p;
+        const char *q = p;
+
+        while (q < p + n && (*q == ' ' || *q == '\t')) ++q;
+        if (!(q < p + n && *q == '#'))
+        {
+            memcpy(o, p, n);
+            o += n;
+        }
+        p += n;
+    }
+    *o = 0;
+    return out;
+}
