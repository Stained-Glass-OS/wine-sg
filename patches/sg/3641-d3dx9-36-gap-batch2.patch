+/* Direction seen by texel (s, t) of a projected map, s and t in [-1, 1], t up.
+ * Returns FALSE outside the map.  "back" selects the -Z hemisphere map. */
+static BOOL envmap_direction(enum envmap_kind kind, BOOL back, float s, float t, float *d)
+{
+    float r2 = s * s + t * t;
+
+    if (r2 > 1.0f)
+        return FALSE;
+
+    switch (kind)
+    {
+        case ENVMAP_SPHERE:
+        {
+            /* The view direction is +Z; the sphere normal is (s, t, -nz) and the lookup
+             * direction is the reflection of the view vector. */
+            float nz = sqrtf(1.0f - r2);
+
+            d[0] = 2.0f * nz * s;
+            d[1] = 2.0f * nz * t;
+#ifdef SG_MUTANT_ENV_SPHERE
+            d[2] = 2.0f * nz * nz - 1.0f;
+#else
+            d[2] = 1.0f - 2.0f * nz * nz;
+#endif
+            return TRUE;
+        }
+        case ENVMAP_HEMISPHERE:
+        {
+            /* Orthographic projection of the hemisphere onto the xy plane. */
+            float z = sqrtf(1.0f - r2);
+
+            d[0] = s;
+            d[1] = t;
+            d[2] = back ? -z : z;
+            return TRUE;
+        }
+        default:
+        {
+            /* Paraboloid: (x, y) / (1 + |z|) = (s, t). */
+            float z = (1.0f - r2) / (1.0f + r2);
+            float k = 1.0f + z;
+
+            d[0] = s * k;
+            d[1] = t * k;
+            d[2] = back ? -z : z;
+            return TRUE;
+        }
+    }
+}
