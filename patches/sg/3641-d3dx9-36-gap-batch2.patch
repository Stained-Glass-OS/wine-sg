+HRESULT WINAPI D3DXGatherFragmentsFromFileA(const char *filename, const D3DXMACRO *defines,
+        ID3DXInclude *include, DWORD options, ID3DXBuffer **fragments, ID3DXBuffer **errors)
+{
+    WCHAR *filename_w;
+    DWORD len;
+    HRESULT hr;
+
+    TRACE("filename %s, defines %p, include %p, options %#lx, fragments %p, errors %p.\n",
+            debugstr_a(filename), defines, include, options, fragments, errors);
