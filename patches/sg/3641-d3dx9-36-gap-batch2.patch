+            struct link_value *v = NULL;
+
+            if (p->dir != 1)
+            {
+#ifndef SG_MUTANT_FRAG_NOMATCH
+                for (k = 0; k < value_count; ++k)
+                    if (fragment_semantic_equal(values[k].semantic, p->semantic))
+                        v = &values[k];
