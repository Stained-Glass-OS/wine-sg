+static void dis_printf(struct dis_text *t, const char *format, ...)
+{
+    va_list args;
+    int n;
+
+    if (t->failed)
+        return;
+    for (;;)
+    {
+        va_start(args, format);
+        n = vsnprintf(t->data + t->len, t->size - t->len, format, args);
+        va_end(args);
+        if (n < 0)
+        {
+            t->failed = TRUE;
+            return;
+        }
+        if (t->len + n < t->size)
+        {
+            t->len += n;
+            return;
+        }
+        {
+            size_t new_size = max(t->size * 2, t->len + n + 1);
+            char *p = realloc(t->data, new_size);
+
+            if (!p)
+            {
+                t->failed = TRUE;
+                return;
+            }
+            t->data = p;
+            t->size = new_size;
+        }
+    }
+}
