+static void test_sg_gap4_surface(IDirect3DDevice9 *device)
+{
+    static const DWORD xr_pixels[2] =
+    {
+        384 | (894 << 10) | (639 << 20) | (3u << 30),
+        0 | (1023 << 10) | (0 << 20) | (0u << 30),
+    };
+    static const WORD l6v5u5[2] = {0xfc00, 0x1f1};
+    static const DWORD x8l8v8u8[2] = {0x00ff0000, 0x00007f81};
+    static const BYTE indices[4] = {0, 1, 2, 3};
+    D3DXIMAGE_INFO info;
+    PALETTEENTRY palette[256] = {{0}};
+    ID3DXBuffer *buffer;
+    IDirect3DSurface9 *surf, *rgb;
+    D3DLOCKED_RECT lock;
+    DWORD a[2], b[2];
+    RECT rect = {0, 0, 2, 1};
+    unsigned int i;
+    HRESULT hr;
+
+    check_dds_pixel_format(DDS_PF_FOURCC, 0x77, 0, 0, 0, 0, 0, D3DFMT_A2B10G10R10_XR_BIAS);
+    check_dds_pixel_format(DDS_PF_FOURCC, 0x76, 0, 0, 0, 0, 0, D3DFMT_A1);
+
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, 2, 1, D3DFMT_A8R8G8B8, D3DPOOL_SCRATCH, &surf, NULL);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+
+    /* 10 bit extended range: (value - 384) / 510, clamped to the destination range */
+    hr = D3DXLoadSurfaceFromMemory(surf, NULL, NULL, xr_pixels, D3DFMT_A2B10G10R10_XR_BIAS, sizeof(xr_pixels), NULL,
+            &rect, D3DX_FILTER_NONE, 0);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    IDirect3DSurface9_LockRect(surf, &lock, NULL, D3DLOCK_READONLY);
+    a[0] = ((DWORD *)lock.pBits)[0];
+    a[1] = ((DWORD *)lock.pBits)[1];
+    IDirect3DSurface9_UnlockRect(surf);
+    ok(a[0] == 0xff00ff80, "Got %#lx.\n", a[0]);
+    ok(a[1] == 0x0000ff00, "Got %#lx.\n", a[1]);
+
+    /* and back */
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, 2, 1, D3DFMT_A2B10G10R10_XR_BIAS, D3DPOOL_SCRATCH, &rgb, NULL);
+    if (SUCCEEDED(hr))
+    {
+        hr = D3DXLoadSurfaceFromSurface(rgb, NULL, NULL, surf, NULL, NULL, D3DX_FILTER_NONE, 0);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        IDirect3DSurface9_LockRect(rgb, &lock, NULL, D3DLOCK_READONLY);
+        b[0] = ((DWORD *)lock.pBits)[0];
+        IDirect3DSurface9_UnlockRect(rgb);
+        /* red 0 -> 384, green 1.0 -> 894, blue 128/255 -> 640, alpha 3 */
+        ok(b[0] == (384 | (894 << 10) | (640 << 20) | (3u << 30)), "Got %#lx.\n", b[0]);
+        IDirect3DSurface9_Release(rgb);
+    }
+    else skip("XR_BIAS surfaces are not supported, hr %#lx.\n", hr);
+
+    /* L6V5U5 and X8L8V8U8 describe the same values */
+    hr = D3DXLoadSurfaceFromMemory(surf, NULL, NULL, l6v5u5, D3DFMT_L6V5U5, sizeof(l6v5u5), NULL, &rect,
+            D3DX_FILTER_NONE, 0);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    IDirect3DSurface9_LockRect(surf, &lock, NULL, D3DLOCK_READONLY);
+    a[0] = ((DWORD *)lock.pBits)[0];
+    a[1] = ((DWORD *)lock.pBits)[1];
+    IDirect3DSurface9_UnlockRect(surf);
+    hr = D3DXLoadSurfaceFromMemory(surf, NULL, NULL, x8l8v8u8, D3DFMT_X8L8V8U8, sizeof(x8l8v8u8), NULL, &rect,
+            D3DX_FILTER_NONE, 0);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    IDirect3DSurface9_LockRect(surf, &lock, NULL, D3DLOCK_READONLY);
+    b[0] = ((DWORD *)lock.pBits)[0];
+    b[1] = ((DWORD *)lock.pBits)[1];
+    IDirect3DSurface9_UnlockRect(surf);
+    for (i = 0; i < 2; ++i)
+        ok(a[i] == b[i], "Pixel %u: L6V5U5 gives %#lx, X8L8V8U8 %#lx.\n", i, a[i], b[i]);
+    IDirect3DSurface9_Release(surf);
+
+    /* a palettized surface can be saved to the other file formats, with its palette */
+    palette[0].peRed = 255; palette[0].peFlags = 255;
+    palette[1].peGreen = 255; palette[1].peFlags = 255;
+    palette[2].peBlue = 255; palette[2].peFlags = 255;
+    palette[3].peRed = 10; palette[3].peGreen = 20; palette[3].peBlue = 30; palette[3].peFlags = 255;
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, 2, 2, D3DFMT_P8, D3DPOOL_SCRATCH, &surf, NULL);
+    if (FAILED(hr))
+    {
+        skip("P8 surfaces are not supported, hr %#lx.\n", hr);
+        return;
+    }
+    IDirect3DSurface9_LockRect(surf, &lock, NULL, 0);
+    for (i = 0; i < 4; ++i)
+        ((BYTE *)lock.pBits)[(i / 2) * lock.Pitch + i % 2] = indices[i];
+    IDirect3DSurface9_UnlockRect(surf);
+
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, 2, 2, D3DFMT_A8R8G8B8, D3DPOOL_SCRATCH, &rgb, NULL);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    for (i = 0; i < 3; ++i)
+    {
+        static const D3DXIMAGE_FILEFORMAT formats[] = {D3DXIFF_PNG, D3DXIFF_BMP, D3DXIFF_JPG};
+
+        hr = D3DXSaveSurfaceToFileInMemory(&buffer, formats[i], surf, palette, NULL);
+        ok(hr == D3D_OK, "Format %u: got hr %#lx.\n", formats[i], hr);
+        if (FAILED(hr))
+            continue;
+        hr = D3DXGetImageInfoFromFileInMemory(ID3DXBuffer_GetBufferPointer(buffer),
+                ID3DXBuffer_GetBufferSize(buffer), &info);
+        ok(hr == D3D_OK && info.Width == 2 && info.Height == 2, "Got hr %#lx, %ux%u.\n", hr, info.Width, info.Height);
+        hr = D3DXLoadSurfaceFromFileInMemory(rgb, NULL, NULL, ID3DXBuffer_GetBufferPointer(buffer),
+                ID3DXBuffer_GetBufferSize(buffer), NULL, D3DX_FILTER_NONE, 0, NULL);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        IDirect3DSurface9_LockRect(rgb, &lock, NULL, D3DLOCK_READONLY);
+        if (formats[i] != D3DXIFF_JPG)
+        {
+            ok(((DWORD *)lock.pBits)[0] == 0xffff0000, "Format %u: got %#lx.\n", formats[i], ((DWORD *)lock.pBits)[0]);
+            ok(((DWORD *)lock.pBits)[1] == 0xff00ff00, "Format %u: got %#lx.\n", formats[i], ((DWORD *)lock.pBits)[1]);
+            ok(((DWORD *)((BYTE *)lock.pBits + lock.Pitch))[0] == 0xff0000ff, "Format %u: got %#lx.\n", formats[i],
+                    ((DWORD *)((BYTE *)lock.pBits + lock.Pitch))[0]);
+            ok(((DWORD *)((BYTE *)lock.pBits + lock.Pitch))[1] == 0xff0a141e, "Format %u: got %#lx.\n", formats[i],
+                    ((DWORD *)((BYTE *)lock.pBits + lock.Pitch))[1]);
+        }
+        else
+        {
+            /* lossy, with subsampled chroma: only the size is checked */
+            ok(info.ImageFileFormat == D3DXIFF_JPG, "Got format %u.\n", info.ImageFileFormat);
+        }
+        IDirect3DSurface9_UnlockRect(rgb);
+        ID3DXBuffer_Release(buffer);
+    }
+    /* without a palette the pixels are black */
+    hr = D3DXSaveSurfaceToFileInMemory(&buffer, D3DXIFF_PNG, surf, NULL, NULL);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        D3DXLoadSurfaceFromFileInMemory(rgb, NULL, NULL, ID3DXBuffer_GetBufferPointer(buffer),
+                ID3DXBuffer_GetBufferSize(buffer), NULL, D3DX_FILTER_NONE, 0, NULL);
+        IDirect3DSurface9_LockRect(rgb, &lock, NULL, D3DLOCK_READONLY);
+        ok(((DWORD *)lock.pBits)[0] == 0xff000000, "Got %#lx.\n", ((DWORD *)lock.pBits)[0]);
+        IDirect3DSurface9_UnlockRect(rgb);
+        ID3DXBuffer_Release(buffer);
+    }
+    /* a sub-rectangle */
+    {
+        RECT sub = {1, 1, 2, 2};
+
+        hr = D3DXSaveSurfaceToFileInMemory(&buffer, D3DXIFF_PNG, surf, palette, &sub);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = D3DXGetImageInfoFromFileInMemory(ID3DXBuffer_GetBufferPointer(buffer),
+                    ID3DXBuffer_GetBufferSize(buffer), &info);
+            ok(hr == D3D_OK && info.Width == 1 && info.Height == 1, "Got hr %#lx, %ux%u.\n", hr, info.Width, info.Height);
+            ID3DXBuffer_Release(buffer);
+        }
+    }
+    IDirect3DSurface9_Release(rgb);
+    IDirect3DSurface9_Release(surf);
+}
