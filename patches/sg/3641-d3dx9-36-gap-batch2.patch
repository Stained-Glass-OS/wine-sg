+                sem = f->params[j].semantic;
+                type = f->params[j].type;
+                snprintf(expr, sizeof(expr), "a%u_%u", i, j);
+            }
+            else
+            {
+                if (!f->return_type)
+                    continue;
+                sem = f->return_semantic;
+                type = f->return_type;
+                snprintf(expr, sizeof(expr), "r%u", i);
+            }
