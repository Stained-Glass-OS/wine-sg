+static unsigned int teapot_weld(D3DXVECTOR3 *positions, unsigned int count, unsigned int *remap)
+{
+    unsigned int i, j, out = 0;
+
+    for (i = 0; i < count; ++i)
+    {
+        for (j = 0; j < out; ++j)
+        {
+            float dx = positions[j].x - positions[i].x;
+            float dy = positions[j].y - positions[i].y;
+            float dz = positions[j].z - positions[i].z;
+
+            if (dx * dx + dy * dy + dz * dz < 1.0e-8f)
+                break;
+        }
+        if (j == out)
+            positions[out++] = positions[i];
+        remap[i] = j;
+    }
+    return out;
+}
