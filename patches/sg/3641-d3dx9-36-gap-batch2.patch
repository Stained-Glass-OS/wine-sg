+    for (i = 0; i < effect->technique_count; ++i)
+    {
+        struct d3dx_technique *tech = &effect->techniques[i];
+
+        dis_printf(&t, "technique %s\n{\n", tech->name ? tech->name : "");
+        for (j = 0; j < tech->pass_count; ++j)
+        {
+            struct d3dx_pass *pass = &tech->passes[j];
+
+            dis_printf(&t, "    pass %s\n    {\n", pass->name ? pass->name : "");
+            for (k = 0; k < pass->state_count; ++k)
+                dis_state(&t, effect, pass, &pass->states[k], enable_color_code, "        ");
+            dis_printf(&t, "    }\n");
