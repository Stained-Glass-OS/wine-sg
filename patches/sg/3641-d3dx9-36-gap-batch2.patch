+    if (!f)
+        return;
+    for (i = 0; i < f->param_count; ++i)
+    {
+        free(f->params[i].type);
+        free(f->params[i].name);
+        free(f->params[i].semantic);
+    }
+    free(f->params);
+    free(f->name);
+    free(f->return_type);
+    free(f->return_semantic);
+    free(f);
