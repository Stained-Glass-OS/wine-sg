+/* Parses one "[qualifiers] type name [[n]] [: SEMANTIC] [= value]" parameter. */
+static BOOL fragment_parse_param(const char *start, const char *end, struct fragment_param *param)
+{
+    const char *colon = NULL, *eq = NULL, *p, *name_end, *name_start, *type_start, *type_end;
+    int depth = 0;
+
+    memset(param, 0, sizeof(*param));
+    for (p = start; p < end; ++p)
+    {
+        if (*p == '(' || *p == '[') ++depth;
+        else if (*p == ')' || *p == ']') --depth;
+        else if (!depth && *p == ':' && !colon && !eq) colon = p;
+        else if (!depth && *p == '=' && !eq) eq = p;
+    }
+    if (!colon)
+        return FALSE;
+
+    {
+        const char *sem_start = colon + 1, *sem_end = eq ? eq : end;
+
+        frag_trim(&sem_start, &sem_end);
+        if (sem_start == sem_end || !(param->semantic = frag_strndup(sem_start, sem_end - sem_start)))
+            return FALSE;
+    }
+
+    name_end = colon;
+    frag_trim(&start, &name_end);
+    /* drop an array suffix from the name */
+    if (name_end > start && name_end[-1] == ']')
+    {
+        while (name_end > start && name_end[-1] != '[') --name_end;
+        if (name_end > start) --name_end;
+        frag_trim(&start, &name_end);
+    }
+    name_start = name_end;
+    while (name_start > start && (isalnum((unsigned char)name_start[-1]) || name_start[-1] == '_')) --name_start;
+    if (name_start == name_end)
+        return FALSE;
+    param->name = frag_strndup(name_start, name_end - name_start);
+
+    /* qualifiers and the type are what precedes the name */
+    type_end = name_start;
+    frag_trim(&start, &type_end);
+    type_start = start;
+    param->dir = 0;
+    for (;;)
+    {
+        const char *word_end = type_start;
+        size_t len;
+
+        while (word_end < type_end && !isspace((unsigned char)*word_end)) ++word_end;
+        len = word_end - type_start;
+        if (word_end >= type_end)
+            break;
+        if (len == 3 && !strncmp(type_start, "out", 3)) param->dir = 1;
+        else if (len == 5 && !strncmp(type_start, "inout", 5)) param->dir = 2;
+        else if (!(len == 2 && !strncmp(type_start, "in", 2))
+                && !(len == 5 && !strncmp(type_start, "const", 5))
+                && !(len == 7 && !strncmp(type_start, "uniform", 7)))
+            break;
+        type_start = word_end;
+        while (type_start < type_end && isspace((unsigned char)*type_start)) ++type_start;
+    }
+    if (type_start >= type_end || !param->name)
+        return FALSE;
+    param->type = frag_strndup(type_start, type_end - type_start);
+    return !!param->type;
+}
