+/* Removes the keys that the interpolation of their remaining neighbours reproduces within "tolerance". */
+static unsigned int anim_reduce_vector_keys(D3DXKEY_VECTOR3 *keys, unsigned int count, float tolerance)
+{
+    unsigned int i, out = count ? 1 : 0;
+
+#ifdef SG_MUTANT_COMPRESS_KEEPALL
+    return count;
+#endif
+    for (i = 1; i + 1 < count; ++i)
+    {
+        D3DXKEY_VECTOR3 pair[2] = {keys[out - 1], keys[i + 1]};
+        D3DXVECTOR3 v;
+
+        if (anim_interpolate_vector(pair, 2, keys[i].Time, &v) && anim_vec_error(&v, &keys[i].Value) <= tolerance)
+            continue;
+        keys[out++] = keys[i];
+    }
+    if (count > 1)
+        keys[out++] = keys[count - 1];
+    return out;
+}
+
+static unsigned int anim_reduce_quat_keys(D3DXKEY_QUATERNION *keys, unsigned int count, float tolerance)
+{
+    unsigned int i, out = count ? 1 : 0;
+
+    for (i = 1; i + 1 < count; ++i)
+    {
+        D3DXKEY_QUATERNION pair[2] = {keys[out - 1], keys[i + 1]};
+        D3DXQUATERNION q;
+
+        if (anim_interpolate_quaternion(pair, 2, keys[i].Time, &q) && anim_quat_error(&q, &keys[i].Value) <= tolerance)
+            continue;
+        keys[out++] = keys[i];
+    }
+    if (count > 1)
+        keys[out++] = keys[count - 1];
+    return out;
+}
