     return D3D_OK;
 }
 
+/* The compressed data of a set is private to d3dx9: it is only meant to be handed back to
+ * D3DXCreateCompressedAnimationSet().  This implementation stores, per animation, its name and
+ * the keys that remain after dropping the ones interpolation can restore within the loss tolerance. */
+#define COMPRESSED_ANIM_MAGIC 0x43414753 /* "SGAC" */
+
+struct compressed_anim_header
+{
+    DWORD magic;
+    DWORD version;
+    DWORD animation_count;
+};
+
+static float anim_vec_error(const D3DXVECTOR3 *a, const D3DXVECTOR3 *b)
+{
+    D3DXVECTOR3 d = {a->x - b->x, a->y - b->y, a->z - b->z};
