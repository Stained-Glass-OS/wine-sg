+static D3DCOLOR sg_get_pixel(IDirect3DTexture9 *tex, unsigned int x, unsigned int y)
+{
+    IDirect3DSurface9 *surf, *sys;
+    D3DSURFACE_DESC desc;
+    IDirect3DDevice9 *device;
+    D3DLOCKED_RECT lock;
+    D3DCOLOR c = 0;
+    HRESULT hr;
+
+    IDirect3DTexture9_GetDevice(tex, &device);
+    IDirect3DTexture9_GetLevelDesc(tex, 0, &desc);
+    IDirect3DTexture9_GetSurfaceLevel(tex, 0, &surf);
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, desc.Width, desc.Height, D3DFMT_A8R8G8B8,
+            D3DPOOL_SCRATCH, &sys, NULL);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    hr = D3DXLoadSurfaceFromSurface(sys, NULL, NULL, surf, NULL, NULL, D3DX_FILTER_NONE, 0);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(IDirect3DSurface9_LockRect(sys, &lock, NULL, D3DLOCK_READONLY)))
+    {
+        c = ((DWORD *)((BYTE *)lock.pBits + y * lock.Pitch))[x];
+        IDirect3DSurface9_UnlockRect(sys);
+    }
+    IDirect3DSurface9_Release(sys);
+    IDirect3DSurface9_Release(surf);
+    IDirect3DDevice9_Release(device);
+    return c;
+}
