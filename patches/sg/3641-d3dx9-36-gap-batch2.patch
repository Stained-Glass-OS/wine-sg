+static void test_sg_fragments(IDirect3DDevice9 *device)
+{
+    static const char fragments_source[] =
+        "void Transform(float4 pos : POSITION, out float4 opos : POSITION, out float3 wpos : TEXCOORD0)\n"
+        "{\n"
+        "    opos = pos;\n"
+        "    wpos = pos.xyz;\n"
+        "}\n"
+        "void Tint(float3 wpos : TEXCOORD0, out float4 col : COLOR0)\n"
+        "{\n"
+        "    col = float4(wpos, 1.0);\n"
+        "}\n"
+        "float4 Pixel(float2 t : TEXCOORD0) : COLOR0\n"
+        "{\n"
+        "    return float4(t, 0.0, 1.0);\n"
+        "}\n"
+        "float helper(float x) { return x * 2.0; }\n";
+    ID3DXBuffer *fragments, *errors, *code, *one, *all, *dis;
+    D3DXFRAGMENT_DESC desc;
+    ID3DXFragmentLinker *linker, *linker2;
+    D3DXHANDLE handles[3], handle;
+    IDirect3DVertexShader9 *vs;
+    IDirect3DPixelShader9 *ps;
+    const char *text;
+    HRESULT hr;
+
+    hr = D3DXGatherFragments(NULL, 10, NULL, NULL, 0, &fragments, &errors);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    hr = D3DXGatherFragments("float4 f(float4 a) { return a; }", 31, NULL, NULL, 0, &fragments, &errors);
+    ok(hr == D3DXERR_INVALIDDATA, "Got hr %#lx.\n", hr);
+    if (errors)
+        ID3DXBuffer_Release(errors);
+    errors = NULL;
+
+    hr = D3DXGatherFragments(fragments_source, sizeof(fragments_source) - 1, NULL, NULL, 0, &fragments, &errors);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        if (errors)
+            skip("Gathering failed: %s\n", (char *)ID3DXBuffer_GetBufferPointer(errors));
+        return;
+    }
+    ok(!errors, "Unexpected errors.\n");
+
+    hr = D3DXCreateFragmentLinker(device, 1024, &linker);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    ok(!linker->lpVtbl->GetNumberOfFragments(linker), "Got fragments before adding any.\n");
+    hr = linker->lpVtbl->AddFragments(linker, NULL);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    {
+        DWORD junk[8] = {0};
+
+        hr = linker->lpVtbl->AddFragments(linker, junk);
+        ok(hr == D3DXERR_INVALIDDATA, "Got hr %#lx.\n", hr);
+    }
+    hr = linker->lpVtbl->AddFragments(linker, ID3DXBuffer_GetBufferPointer(fragments));
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    /* the helper has no semantics, so it is not a fragment */
+    ok(linker->lpVtbl->GetNumberOfFragments(linker) == 3, "Got %u fragments.\n",
+            linker->lpVtbl->GetNumberOfFragments(linker));
+    ok(!linker->lpVtbl->GetFragmentHandleByName(linker, "helper"), "helper is a fragment.\n");
+    ok(!linker->lpVtbl->GetFragmentHandleByIndex(linker, 3), "Got a fourth handle.\n");
+    handles[0] = linker->lpVtbl->GetFragmentHandleByName(linker, "Transform");
+    handles[1] = linker->lpVtbl->GetFragmentHandleByName(linker, "Tint");
+    handles[2] = linker->lpVtbl->GetFragmentHandleByName(linker, "Pixel");
+    ok(handles[0] && handles[1] && handles[2], "Missing handles.\n");
+    ok(handles[0] == linker->lpVtbl->GetFragmentHandleByIndex(linker, 0), "Handles differ.\n");
+    hr = linker->lpVtbl->GetFragmentDesc(linker, handles[1], &desc);
+    ok(hr == D3D_OK && !strcmp(desc.Name, "Tint"), "Got hr %#lx.\n", hr);
+    hr = linker->lpVtbl->GetFragmentDesc(linker, "Pixel", &desc);
+    ok(hr == D3D_OK && !strcmp(desc.Name, "Pixel"), "Got hr %#lx.\n", hr);
+    hr = linker->lpVtbl->GetFragmentDesc(linker, "nothing", &desc);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+
+    /* the same fragments again change nothing */
+    hr = linker->lpVtbl->AddFragments(linker, ID3DXBuffer_GetBufferPointer(fragments));
+    ok(hr == D3D_OK && linker->lpVtbl->GetNumberOfFragments(linker) == 3, "Got hr %#lx.\n", hr);
+
+    /* vertex shader: Tint consumes what Transform produced, so only the position is an input */
+    hr = linker->lpVtbl->LinkShader(linker, "vs_2_0", 0, handles, 2, &code, &errors);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(D3DXGetShaderVersion(ID3DXBuffer_GetBufferPointer(code)) == D3DVS_VERSION(2, 0), "Wrong version.\n");
+        hr = D3DXDisassembleShader(ID3DXBuffer_GetBufferPointer(code), FALSE, NULL, &dis);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        text = ID3DXBuffer_GetBufferPointer(dis);
+        ok(!!strstr(text, "dcl_position"), "Missing the position input:\n%s\n", text);
+        ok(!strstr(text, "dcl_texcoord"), "The texture coordinate was not matched:\n%s\n", text);
+        ok(!!strstr(text, "oD0") && !!strstr(text, "oT0") && !!strstr(text, "oPos"), "Missing outputs:\n%s\n", text);
+        ID3DXBuffer_Release(dis);
+        ID3DXBuffer_Release(code);
+    }
+    /* without Transform the texture coordinate becomes an input */
+    hr = linker->lpVtbl->LinkShader(linker, "vs_2_0", 0, &handles[1], 1, &code, &errors);
+    ok(hr == D3D_OK || hr == D3DXERR_INVALIDDATA || FAILED(hr), "Got hr %#lx.\n", hr);
+    if (errors) { ID3DXBuffer_Release(errors); errors = NULL; }
+    if (SUCCEEDED(hr))
+    {
+        D3DXDisassembleShader(ID3DXBuffer_GetBufferPointer(code), FALSE, NULL, &dis);
+        ok(!!strstr(ID3DXBuffer_GetBufferPointer(dis), "dcl_texcoord"), "Missing the texcoord input.\n");
+        ID3DXBuffer_Release(dis);
+        ID3DXBuffer_Release(code);
+    }
+
+    hr = linker->lpVtbl->LinkVertexShader(linker, "vs_2_0", 0, handles, 2, &vs, &errors);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IDirect3DVertexShader9_Release(vs);
+    hr = linker->lpVtbl->LinkPixelShader(linker, "ps_2_0", 0, &handles[2], 1, &ps, &errors);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IDirect3DPixelShader9_Release(ps);
+    hr = linker->lpVtbl->LinkVertexShader(linker, "ps_2_0", 0, handles, 2, &vs, &errors);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+
+    hr = linker->lpVtbl->LinkShader(linker, "vs_2_0", 0, handles, 0, &code, &errors);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    hr = linker->lpVtbl->LinkShader(linker, "vs_2_0", 0, NULL, 2, &code, &errors);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    handle = "nonsense";
+    hr = linker->lpVtbl->LinkShader(linker, "vs_2_0", 0, &handle, 1, &code, &errors);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    hr = linker->lpVtbl->LinkShader(linker, "bad_profile", 0, handles, 2, &code, &errors);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    /* compile errors come back in the error buffer */
+    {
+        static const char bad_source[] =
+            "void Bad(float4 a : POSITION, out float4 b : COLOR0) { b = undefined_variable; }\n";
+        ID3DXBuffer *bad;
+        D3DXHANDLE bad_handle;
+
+        hr = D3DXGatherFragments(bad_source, sizeof(bad_source) - 1, NULL, NULL, 0, &bad, &errors);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        hr = linker->lpVtbl->AddFragments(linker, ID3DXBuffer_GetBufferPointer(bad));
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        bad_handle = linker->lpVtbl->GetFragmentHandleByName(linker, "Bad");
+        ok(!!bad_handle, "Missing the Bad fragment.\n");
+        code = NULL;
+        errors = NULL;
+        hr = linker->lpVtbl->LinkShader(linker, "vs_2_0", 0, &bad_handle, 1, &code, &errors);
+        ok(FAILED(hr) && !code && !!errors, "Got hr %#lx, code %p, errors %p.\n", hr, code, errors);
+        if (errors) { ID3DXBuffer_Release(errors); errors = NULL; }
+        ID3DXBuffer_Release(bad);
+    }
+    ok(linker->lpVtbl->ClearCache(linker) == D3D_OK, "ClearCache failed.\n");
+
+    /* single fragments and the whole set are containers a second linker accepts */
+    hr = linker->lpVtbl->GetFragment(linker, handles[2], &one);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    hr = linker->lpVtbl->GetAllFragments(linker, &all);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    hr = linker->lpVtbl->GetFragment(linker, "nothing", &dis);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+
+    D3DXCreateFragmentLinker(device, 1024, &linker2);
+    hr = linker2->lpVtbl->AddFragments(linker2, ID3DXBuffer_GetBufferPointer(one));
+    ok(hr == D3D_OK && linker2->lpVtbl->GetNumberOfFragments(linker2) == 1, "Got hr %#lx.\n", hr);
+    ok(!!linker2->lpVtbl->GetFragmentHandleByName(linker2, "Pixel"), "Missing Pixel.\n");
+    hr = linker2->lpVtbl->AddFragments(linker2, ID3DXBuffer_GetBufferPointer(all));
+    ok(hr == D3D_OK && linker2->lpVtbl->GetNumberOfFragments(linker2) == 4, "Got hr %#lx, %u.\n", hr,
+            linker2->lpVtbl->GetNumberOfFragments(linker2));
+    linker2->lpVtbl->Release(linker2);
+    ID3DXBuffer_Release(one);
+    ID3DXBuffer_Release(all);
+
+    linker->lpVtbl->Release(linker);
+    ID3DXBuffer_Release(fragments);
+}
+
+static void test_sg_fragments_device(void)
+{
+    D3DPRESENT_PARAMETERS d3dpp;
+    IDirect3DDevice9 *device;
+    IDirect3D9 *d3d;
+    HWND window;
+    HRESULT hr;
+
+    window = CreateWindowA("static", "d3dx9_test", WS_OVERLAPPEDWINDOW, 0, 0, 640, 480, NULL, NULL, NULL, NULL);
+    if (!(d3d = Direct3DCreate9(D3D_SDK_VERSION)))
+    {
+        skip("Failed to create a D3D object.\n");
+        DestroyWindow(window);
+        return;
+    }
+
+    ZeroMemory(&d3dpp, sizeof(d3dpp));
+    d3dpp.Windowed = TRUE;
+    d3dpp.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    hr = IDirect3D9_CreateDevice(d3d, D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, window,
+            D3DCREATE_MIXED_VERTEXPROCESSING, &d3dpp, &device);
+    if (FAILED(hr))
+    {
+        skip("Failed to create a D3D device, hr %#lx.\n", hr);
+        IDirect3D9_Release(d3d);
+        DestroyWindow(window);
+        return;
+    }
+
+    test_sg_fragments(device);
+
+    IDirect3DDevice9_Release(device);
+    IDirect3D9_Release(d3d);
+    DestroyWindow(window);
+}
