+    IDirect3DSurface9_GetDesc(src_surface, &desc);
+    if (src_rect)
+    {
+        if (src_rect->left == src_rect->right || src_rect->top == src_rect->bottom)
+            return D3DXCreateBuffer(64, dst_buffer);
+        if (src_rect->left < 0 || src_rect->top < 0 || src_rect->left > src_rect->right
+                || src_rect->top > src_rect->bottom || src_rect->right > desc.Width
+                || src_rect->bottom > desc.Height)
+            return D3DERR_INVALIDCALL;
+        rect = *src_rect;
+    }
+    else
+    {
+        SetRect(&rect, 0, 0, desc.Width, desc.Height);
+    }
+
+    if (!src_palette)
+    {
+        if (!default_palette[0].peFlags)
+            for (i = 0; i < ARRAY_SIZE(default_palette); ++i)
+                default_palette[i].peFlags = 0xff;
+        src_palette = default_palette;
+    }
+
+#ifdef SG_MUTANT_PALSAVE_NOPALETTE
+    src_palette = default_palette;
+#endif
+    src_desc = get_format_info(desc.Format);
+    dst_desc = get_format_info(D3DFMT_A8R8G8B8);
+    size.width = rect.right - rect.left;
+    size.height = rect.bottom - rect.top;
+    size.depth = 1;
+
+    IDirect3DSurface9_GetDevice(src_surface, &device);
+    hr = IDirect3DDevice9_CreateOffscreenPlainSurface(device, size.width, size.height, D3DFMT_A8R8G8B8,
+            D3DPOOL_SCRATCH, &rgb_surface, NULL);
+    IDirect3DDevice9_Release(device);
+    if (FAILED(hr))
+        return hr;
+
+    if (SUCCEEDED(hr = lock_surface(src_surface, &rect, &src_lock, &temp_src, FALSE)))
+    {
+        if (SUCCEEDED(hr = IDirect3DSurface9_LockRect(rgb_surface, &dst_lock, NULL, 0)))
+        {
+            convert_argb_pixels(src_lock.pBits, src_lock.Pitch, 0, &size, src_desc, dst_lock.pBits,
+                    dst_lock.Pitch, 0, &size, dst_desc, 0, src_palette);
+            IDirect3DSurface9_UnlockRect(rgb_surface);
+        }
+        unlock_surface(src_surface, &rect, temp_src, FALSE);
+    }
+    if (SUCCEEDED(hr))
+        hr = D3DXSaveSurfaceToFileInMemory(dst_buffer, file_format, rgb_surface, NULL, NULL);
+    IDirect3DSurface9_Release(rgb_surface);
+    return hr;
+}
