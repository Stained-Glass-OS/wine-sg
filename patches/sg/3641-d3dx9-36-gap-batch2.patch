+HRESULT WINAPI D3DXGatherFragments(const char *data, UINT data_len, const D3DXMACRO *defines,
+        ID3DXInclude *include, DWORD options, ID3DXBuffer **fragments, ID3DXBuffer **errors)
+{
+    ID3DXBuffer *preprocessed;
+    HRESULT hr;
+
+    TRACE("data %s, data_len %u, defines %p, include %p, options %#lx, fragments %p, errors %p.\n",
+            debugstr_an(data, data_len), data_len, defines, include, options, fragments, errors);
+
+    if (!data || !data_len || !fragments)
+        return D3DERR_INVALIDCALL;
+    if (errors)
+        *errors = NULL;
+    *fragments = NULL;
+
+    if (FAILED(hr = D3DXPreprocessShader(data, data_len, defines, include, &preprocessed, errors)))
+        return hr;
+    hr = fragment_gather_source(ID3DXBuffer_GetBufferPointer(preprocessed),
+            ID3DXBuffer_GetBufferSize(preprocessed), fragments, errors);
+    ID3DXBuffer_Release(preprocessed);
+    return hr;
+}
