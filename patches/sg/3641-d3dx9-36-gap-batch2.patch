+            values[k].expr = strdup(expr);
+            values[k].type = type;
+            values[k].produced = TRUE;
+        }
+        for (j = 0; j < arg_count; ++j)
+            free(args[j]);
+    }
+
+    for (k = 0; k < value_count; ++k)
+    {
+        if (!values[k].produced)
+            continue;
+        if (!link_append(&outputs, "    %s out%u : %s;\n", values[k].type, output_count, values[k].semantic)
+                || !link_append(&body, "    o.out%u = %s;\n", output_count, values[k].expr))
+            goto done;
+        ++output_count;
+    }
+    if (!output_count)
+    {
+        hr = D3DXERR_INVALIDDATA;
+        goto done;
+    }
+
+    if (input_count && !link_append(&text, "struct sg_link_in\n{\n%s};\n", inputs.data))
+        goto done;
+    if (!link_append(&text, "struct sg_link_out\n{\n%s};\n", outputs.data))
+        goto done;
+    if (!link_append(&text, "sg_link_out " FRAGMENT_ENTRY "(%s)\n{\n    sg_link_out o;\n%s    return o;\n}\n",
+            input_count ? "sg_link_in i" : "", body.data))
+        goto done;
+
+    *source_out = text.data;
+    text.data = NULL;
+    hr = D3D_OK;
+
+done:
+    if (values)
+    {
+        for (k = 0; k < value_count; ++k)
+        {
+            free(values[k].semantic);
+            free(values[k].expr);
+        }
+        free(values);
+    }
+    free(text.data);
+    free(inputs.data);
+    free(outputs.data);
+    free(body.data);
+    return hr;
 }
 
