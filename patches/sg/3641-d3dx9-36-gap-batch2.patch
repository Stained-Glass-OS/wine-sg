+/* Finds the functions of the source that can be fragments.  Calls "callback" for each one. */
+static HRESULT fragment_scan(const char *source, struct fragment ***out, unsigned int *out_count)
+{
+    struct fragment **list = NULL;
+    unsigned int count = 0, capacity = 0;
+    const char *chunk = source, *p = source;
+    int brace = 0, paren = 0;
+
+    for (; *p; ++p)
+    {
+        if (*p == '(') ++paren;
+        else if (*p == ')') --paren;
+        else if (*p == '{') ++brace;
+        else if (*p == '}')
+        {
+            const char *open_paren, *body, *header_end, *name_end, *name_start, *close, *sem;
+            struct fragment *f;
+            unsigned int n, i;
+            BOOL valid = TRUE;
+
+            if (--brace)
+                continue;
+
+            /* [chunk, p] is a declaration ending with a braced block */
+            body = chunk;
+            while (body < p && *body != '{') ++body;
+            header_end = body;
+            if (!(open_paren = memchr(chunk, '(', header_end - chunk)) || !strncmp(chunk + strspn(chunk, " \t\r\n"), "struct", 6)
+                    || !strncmp(chunk + strspn(chunk, " \t\r\n"), "cbuffer", 7))
+            {
+                chunk = p + 1;
+                continue;
+            }
+            /* the closing parenthesis of the parameter list */
+            close = NULL;
+            {
+                int d = 0;
+                const char *q;
+
+                for (q = open_paren; q < header_end; ++q)
+                {
+                    if (*q == '(') ++d;
+                    else if (*q == ')' && !--d) { close = q; break; }
+                }
+            }
+            if (!close)
+            {
+                chunk = p + 1;
+                continue;
+            }
+
+            name_end = open_paren;
+            frag_trim(&chunk, &name_end);
+            name_start = name_end;
+            while (name_start > chunk && (isalnum((unsigned char)name_start[-1]) || name_start[-1] == '_')) --name_start;
+            if (name_start == name_end)
+            {
+                chunk = p + 1;
+                continue;
+            }
+
+            if (!(f = calloc(1, sizeof(*f))))
+                goto oom;
+            f->name = frag_strndup(name_start, name_end - name_start);
+            {
+                const char *rt_end = name_start, *rt_start = chunk;
+
+                frag_trim(&rt_start, &rt_end);
+                if (rt_end - rt_start == 4 && !strncmp(rt_start, "void", 4))
+                    f->return_type = NULL;
+                else if (rt_end > rt_start)
+                {
+                    /* drop leading qualifiers such as "inline" */
+                    while (rt_end - rt_start > 7 && !strncmp(rt_start, "inline ", 7))
+                    {
+                        rt_start += 7;
+                        while (rt_start < rt_end && isspace((unsigned char)*rt_start)) ++rt_start;
+                    }
+                    f->return_type = frag_strndup(rt_start, rt_end - rt_start);
+                }
+            }
+
+            /* the parameters, split at the commas outside of nested brackets */
+            n = 1;
+            {
+                const char *q;
+                int d = 0;
+
+                for (q = open_paren + 1; q < close; ++q)
+                {
+                    if (*q == '(' || *q == '[') ++d;
+                    else if (*q == ')' || *q == ']') --d;
+                    else if (*q == ',' && !d) ++n;
+                }
+                {
+                    const char *a = open_paren + 1, *b = close;
+
+                    frag_trim(&a, &b);
+                    if (a == b || (b - a == 4 && !strncmp(a, "void", 4)))
+                        n = 0;
+                }
+            }
+            if (n && !(f->params = calloc(n, sizeof(*f->params))))
+            {
+                fragment_free(f);
+                goto oom;
+            }
+            f->param_count = n;
+            {
+                const char *a = open_paren + 1, *q;
+                int d = 0;
+
+                i = 0;
+                for (q = open_paren + 1; q <= close && n; ++q)
+                {
+                    if (q == close || (*q == ',' && !d))
+                    {
+                        const char *b = q;
+
+                        frag_trim(&a, &b);
+                        if (i >= n || !fragment_parse_param(a, b, &f->params[i]))
+                            valid = FALSE;
+                        ++i;
+                        a = q + 1;
+                    }
+                    else if (*q == '(' || *q == '[') ++d;
+                    else if (*q == ')' || *q == ']') --d;
+                }
+            }
+
+            /* ": SEMANTIC" of the return value */
+            sem = close + 1;
+            while (sem < header_end && isspace((unsigned char)*sem)) ++sem;
+            if (sem < header_end && *sem == ':')
+            {
+                const char *a = sem + 1, *b = header_end;
+
+                frag_trim(&a, &b);
+                if (a < b)
+                    f->return_semantic = frag_strndup(a, b - a);
+            }
+            if (f->return_type && !f->return_semantic)
+                valid = FALSE;
+            if (!f->return_type && f->return_semantic)
+                valid = FALSE;
+            if (!f->param_count && !f->return_semantic)
+                valid = FALSE;
+
+            if (!valid)
+            {
+                fragment_free(f);
+                chunk = p + 1;
+                continue;
+            }
+
+            if (count == capacity)
+            {
+                struct fragment **new_list = realloc(list, (capacity ? capacity * 2 : 8) * sizeof(*list));
+
+                if (!new_list)
+                {
+                    fragment_free(f);
+                    goto oom;
+                }
+                list = new_list;
+                capacity = capacity ? capacity * 2 : 8;
+            }
+            list[count++] = f;
+            chunk = p + 1;
+        }
+        else if (*p == ';' && !brace && !paren)
+            chunk = p + 1;
+    }
+
+    *out = list;
+    *out_count = count;
+    return D3D_OK;
+
+oom:
+    while (count)
+        fragment_free(list[--count]);
+    free(list);
+    return E_OUTOFMEMORY;
+}
