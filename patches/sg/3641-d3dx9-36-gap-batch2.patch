+    MultiByteToWideChar(CP_ACP, 0, filename, -1, filename_w, len);
+    hr = D3DXGatherFragmentsFromFileW(filename_w, defines, include, options, fragments, errors);
+    free(filename_w);
+    return hr;
+}
