+
+    TRACE("filename %s, defines %p, include %p, options %#lx, fragments %p, errors %p.\n",
+            debugstr_w(filename), defines, include, options, fragments, errors);
+
+    if (!filename || !fragments)
+        return D3DERR_INVALIDCALL;
+    if (errors)
