+/* Cube map lookup with the Direct3D face orientation. */
+static uint32_t envmap_sample_cube(uint32_t *const faces[6], unsigned int size, float x, float y, float z)
+{
+    float ax = fabsf(x), ay = fabsf(y), az = fabsf(z), sc, tc, ma;
+    unsigned int face, px, py;
+    float u, v;
+
+    if (ax >= ay && ax >= az)
+    {
+        ma = ax;
+        if (x > 0) { face = D3DCUBEMAP_FACE_POSITIVE_X; sc = -z; tc = -y; }
+        else       { face = D3DCUBEMAP_FACE_NEGATIVE_X; sc = z;  tc = -y; }
+    }
+    else if (ay >= az)
+    {
+        ma = ay;
+        if (y > 0) { face = D3DCUBEMAP_FACE_POSITIVE_Y; sc = x; tc = z; }
+        else       { face = D3DCUBEMAP_FACE_NEGATIVE_Y; sc = x; tc = -z; }
+    }
+    else
+    {
+        ma = az;
+        if (z > 0) { face = D3DCUBEMAP_FACE_POSITIVE_Z; sc = x;  tc = -y; }
+        else       { face = D3DCUBEMAP_FACE_NEGATIVE_Z; sc = -x; tc = -y; }
+    }
+    if (ma == 0.0f)
+        return 0;
+
+    u = (sc / ma + 1.0f) * 0.5f * size;
+    v = (tc / ma + 1.0f) * 0.5f * size;
+    px = u < 0.0f ? 0 : u >= size ? size - 1 : (unsigned int)u;
+    py = v < 0.0f ? 0 : v >= size ? size - 1 : (unsigned int)v;
+    return faces[face][py * size + px];
+}
