+static HRESULT fragment_container_create(const char *source, struct fragment **fragments, unsigned int count,
+        ID3DXBuffer **out)
+{
+    struct fragment_container_header *header;
+    size_t source_size = strlen(source) + 1, size = sizeof(*header) + source_size, names = 0;
+    unsigned int i;
+    ID3DXBuffer *buffer;
+    char *ptr;
+    HRESULT hr;
+
+    for (i = 0; i < count; ++i)
+        names += strlen(fragments[i]->name) + 1;
+    size += names;
+
+    if (FAILED(hr = D3DXCreateBuffer(size, &buffer)))
+        return hr;
+    header = ID3DXBuffer_GetBufferPointer(buffer);
+    header->magic = FRAGMENT_CONTAINER_MAGIC;
+    header->size = size;
+    header->fragment_count = count;
+    header->source_count = 1;
+    header->source_size = source_size;
+    ptr = (char *)(header + 1);
+    memcpy(ptr, source, source_size);
+    ptr += source_size;
+    for (i = 0; i < count; ++i)
+    {
+        size_t len = strlen(fragments[i]->name) + 1;
+
+        memcpy(ptr, fragments[i]->name, len);
+        ptr += len;
+    }
+    *out = buffer;
+    return D3D_OK;
+}
+
+static HRESULT fragment_gather_source(const char *preprocessed, SIZE_T length, ID3DXBuffer **fragments_out,
+        ID3DXBuffer **errors)
+{
+    struct fragment **list;
+    unsigned int count, i;
+    char *source;
+    HRESULT hr;
+
+    if (!(source = fragment_clean_source(preprocessed, length)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = fragment_scan(source, &list, &count)))
+    {
+        free(source);
+        return hr;
+    }
+    if (!count)
+    {
+        static const char message[] = "no function can be used as a fragment: every parameter and the return value need semantics\n";
+
+        if (errors && SUCCEEDED(D3DXCreateBuffer(sizeof(message), errors)))
+            memcpy(ID3DXBuffer_GetBufferPointer(*errors), message, sizeof(message));
+        free(source);
+        free(list);
+        return D3DXERR_INVALIDDATA;
+    }
+    hr = fragment_container_create(source, list, count, fragments_out);
+    for (i = 0; i < count; ++i)
+        fragment_free(list[i]);
+    free(list);
+    free(source);
+    return hr;
+}
