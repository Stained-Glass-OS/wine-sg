+static void test_sg_gap4_mesh(void)
+{
+    struct test_context *test_context;
+    ID3DXMesh *mesh;
+    ID3DXBuffer *adj;
+    HRESULT hr;
+    struct vertex { D3DXVECTOR3 p, n; } *v;
+    D3DXVECTOR3 lo = {1e9f, 1e9f, 1e9f}, hi = {-1e9f, -1e9f, -1e9f};
+    DWORD nv, nf, i, open_edges = 0, bad = 0, flipped = 0;
+    DWORD *a;
+    WORD *idx;
+
+    test_context = new_test_context();
+    if (!test_context)
+    {
+        skip("Couldn't create a test context.\n");
+        return;
+    }
+
+    hr = D3DXCreateTeapot(NULL, &mesh, NULL);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    hr = D3DXCreateTeapot(test_context->device, NULL, NULL);
+    ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+    hr = D3DXCreateTeapot(test_context->device, &mesh, &adj);
+    ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+    nv = mesh->lpVtbl->GetNumVertices(mesh);
+    nf = mesh->lpVtbl->GetNumFaces(mesh);
+    ok(nf >= 1000 && nv >= 500, "Got %lu faces and %lu vertices.\n", nf, nv);
+    ok(mesh->lpVtbl->GetFVF(mesh) == (D3DFVF_XYZ | D3DFVF_NORMAL), "Got FVF %#lx.\n", mesh->lpVtbl->GetFVF(mesh));
+    ok(ID3DXBuffer_GetBufferSize(adj) == nf * 3 * sizeof(DWORD), "Got adjacency size %lu.\n",
+            ID3DXBuffer_GetBufferSize(adj));
+    a = ID3DXBuffer_GetBufferPointer(adj);
+    for (i = 0; i < nf * 3; ++i)
+        open_edges += a[i] == ~0u;
+
+    mesh->lpVtbl->LockVertexBuffer(mesh, D3DLOCK_READONLY, (void **)&v);
+    mesh->lpVtbl->LockIndexBuffer(mesh, D3DLOCK_READONLY, (void **)&idx);
+    for (i = 0; i < nv; ++i)
+    {
+        float len = D3DXVec3Length(&v[i].n);
+
+        lo.x = min(lo.x, v[i].p.x); lo.y = min(lo.y, v[i].p.y); lo.z = min(lo.z, v[i].p.z);
+        hi.x = max(hi.x, v[i].p.x); hi.y = max(hi.y, v[i].p.y); hi.z = max(hi.z, v[i].p.z);
+        bad += fabsf(len - 1.0f) > 0.001f;
+    }
+    for (i = 0; i < nf; ++i)
+    {
+        D3DXVECTOR3 e1 = {0}, e2 = {0}, n, avg;
+
+        D3DXVec3Subtract(&e1, &v[idx[i * 3 + 1]].p, &v[idx[i * 3]].p);
+        D3DXVec3Subtract(&e2, &v[idx[i * 3 + 2]].p, &v[idx[i * 3]].p);
+        D3DXVec3Cross(&n, &e1, &e2);
+        avg.x = v[idx[i * 3]].n.x + v[idx[i * 3 + 1]].n.x + v[idx[i * 3 + 2]].n.x;
+        avg.y = v[idx[i * 3]].n.y + v[idx[i * 3 + 1]].n.y + v[idx[i * 3 + 2]].n.y;
+        avg.z = v[idx[i * 3]].n.z + v[idx[i * 3 + 1]].n.z + v[idx[i * 3 + 2]].n.z;
+        flipped += D3DXVec3Dot(&n, &avg) <= 0.0f;
+    }
+    mesh->lpVtbl->UnlockIndexBuffer(mesh);
+    mesh->lpVtbl->UnlockVertexBuffer(mesh);
+
+    ok(!bad, "%lu normals are not unit length.\n", bad);
+    ok(!flipped, "%lu faces wind against their normals.\n", flipped);
+    /* the pot spans the Newell data: spout to +x, handle to -x, 3.15 high, 4 deep */
+    ok(hi.x > 3.4f && hi.x < 3.5f && lo.x > -3.01f && lo.x < -2.99f, "Got x range %f..%f.\n", lo.x, hi.x);
+    ok(hi.y - lo.y > 3.14f && hi.y - lo.y < 3.16f, "Got height %f.\n", hi.y - lo.y);
+    ok(hi.z > 1.99f && lo.z < -1.99f, "Got z range %f..%f.\n", lo.z, hi.z);
+    /* the body is a closed surface, only the rim and the lid are open */
+    ok(open_edges < 600, "Got %lu open edges.\n", open_edges);
+    ID3DXBuffer_Release(adj);
+    mesh->lpVtbl->Release(mesh);
+
+    free_test_context(test_context);
+}
