+/* Shader fragments.
+ *
+ * A fragment is an HLSL function whose parameters (and return value) all carry semantics.  The
+ * container D3DXGatherFragments() returns is private to d3dx9: it holds the preprocessed source and
+ * the names of the fragments.  The linker calls the chosen fragments one after the other from a
+ * generated entry point: the inputs of a fragment are the outputs of the closest earlier fragment
+ * that produced the same semantic, and the semantics nobody produced become inputs of the shader.
+ * The semantics that were produced become its outputs. */
+
+#define FRAGMENT_CONTAINER_MAGIC 0x52464753 /* "SGFR" */
+#define FRAGMENT_ENTRY "sg_link_main"
+
+struct fragment_container_header
+{
+    DWORD magic;
+    DWORD size;           /* of the whole container, in bytes */
+    DWORD fragment_count;
+    DWORD source_count;
+    DWORD source_size;    /* of all the sources, including their terminating zeros */
+    /* followed by the sources, then fragment_count zero terminated names */
+};
+
+struct fragment_param
+{
+    char *type;
+    char *name;
+    char *semantic;
+    int dir;              /* 0 in, 1 out, 2 inout */
+};
+
+struct fragment
+{
+    char *name;
+    char *source;         /* the source this function is defined in, shared with other fragments */
+    char *return_type;    /* NULL for void */
+    char *return_semantic;
+    struct fragment_param *params;
+    unsigned int param_count;
+    D3DXFRAGMENT_DESC desc;
+};
+
 struct d3dx9_fragment_linker
