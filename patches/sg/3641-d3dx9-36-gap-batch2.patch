+/* Control point of copy "c" of a patch; the original data lies in x >= 0,
+ * y <= 0 (body) and is reflected into the other quadrants. */
+static void teapot_control(const struct teapot_patch *patch, unsigned int copy, unsigned int i, D3DXVECTOR3 *p)
+{
+    const float *src = teapot_points[patch->idx[i]];
+    float x = src[0], y = src[1], z = src[2];
+
+    if (patch->copies == 4)
+    {
+        if (copy & 1) x = -x;
+        if (copy & 2) y = -y;
+    }
+    else if (copy & 1)
+        y = -y;
+
+    /* Convert from z up to y up (a proper rotation) and centre vertically. */
+    p->x = x;
+    p->y = z - 1.575f;
+    p->z = -y;
+}
