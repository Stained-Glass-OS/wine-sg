+HRESULT WINAPI D3DXCreateCompressedAnimationSet(const char *name, double ticks_per_second,
+        D3DXPLAYBACK_TYPE playback_type, ID3DXBuffer *compressed_data, UINT callback_key_count,
+        const D3DXKEY_CALLBACK *callback_keys, ID3DXCompressedAnimationSet **animation_set)
+{
+    struct d3dx9_compressed_animation_set *object;
+    const struct compressed_anim_header *header;
+    ID3DXKeyframedAnimationSet *keys;
+    const BYTE *ptr, *end;
+    unsigned int i;
+    SIZE_T size;
+    HRESULT hr;
+
+    TRACE("name %s, ticks_per_second %.16e, playback_type %u, compressed_data %p, callback_key_count %u, "
+            "callback_keys %p, animation_set %p.\n", debugstr_a(name), ticks_per_second, playback_type,
+            compressed_data, callback_key_count, callback_keys, animation_set);
+
+    if (!name || !compressed_data || !animation_set || (callback_key_count && !callback_keys))
+        return D3DERR_INVALIDCALL;
+
+    size = ID3DXBuffer_GetBufferSize(compressed_data);
+    header = ID3DXBuffer_GetBufferPointer(compressed_data);
+    if (size < sizeof(*header) || header->magic != COMPRESSED_ANIM_MAGIC || header->version != 1
+            || !header->animation_count)
+        return D3DERR_INVALIDCALL;
+
+    if (FAILED(hr = D3DXCreateKeyframedAnimationSet(name, ticks_per_second, playback_type,
+            header->animation_count, callback_key_count, callback_keys, &keys)))
+        return hr;
+
+    ptr = (const BYTE *)(header + 1);
+    end = (const BYTE *)header + size;
+    for (i = 0; i < header->animation_count; ++i)
+    {
+        DWORD name_len, counts[3];
+        const char *anim_name;
+        const D3DXKEY_VECTOR3 *scale, *trans;
+        const D3DXKEY_QUATERNION *rot;
+        SIZE_T needed;
+
+        if (end - ptr < sizeof(name_len) + sizeof(counts))
+            goto invalid;
+        memcpy(&name_len, ptr, sizeof(name_len)); ptr += sizeof(name_len);
+        memcpy(counts, ptr, sizeof(counts)); ptr += sizeof(counts);
+        if (!name_len || name_len > end - ptr)
+            goto invalid;
+        anim_name = (const char *)ptr;
+        if (anim_name[name_len - 1])
+            goto invalid;
+        ptr += name_len;
+        if (counts[0] > size || counts[1] > size || counts[2] > size)
+            goto invalid;
+        needed = (SIZE_T)counts[0] * sizeof(*scale) + (SIZE_T)counts[1] * sizeof(*rot)
+                + (SIZE_T)counts[2] * sizeof(*trans);
+        if (needed > end - ptr)
+            goto invalid;
+        scale = (const D3DXKEY_VECTOR3 *)ptr; ptr += counts[0] * sizeof(*scale);
+        rot = (const D3DXKEY_QUATERNION *)ptr; ptr += counts[1] * sizeof(*rot);
+        trans = (const D3DXKEY_VECTOR3 *)ptr; ptr += counts[2] * sizeof(*trans);
+        if (FAILED(hr = keys->lpVtbl->RegisterAnimationSRTKeys(keys, anim_name, counts[0], counts[1],
+                counts[2], scale, rot, trans, NULL)))
+        {
+            keys->lpVtbl->Release(keys);
+            return hr;
+        }
+    }
+
+    if (!(object = calloc(1, sizeof(*object))))
+    {
+        keys->lpVtbl->Release(keys);
+        return E_OUTOFMEMORY;
+    }
+    object->ID3DXCompressedAnimationSet_iface.lpVtbl = &d3dx9_compressed_animation_vtbl;
+    object->ref = 1;
+    object->keys = keys;
+    object->ticks_per_second = ticks_per_second;
+    object->playback_type = playback_type;
+    object->callback_key_count = callback_key_count;
+    if (callback_key_count && !(object->callback_keys = anim_dup(callback_keys,
+            callback_key_count * sizeof(*callback_keys))))
+    {
+        keys->lpVtbl->Release(keys);
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    ID3DXBuffer_AddRef(compressed_data);
+    object->data = compressed_data;
+
+    *animation_set = &object->ID3DXCompressedAnimationSet_iface;
+    return D3D_OK;
+
+invalid:
+    keys->lpVtbl->Release(keys);
+    return D3DERR_INVALIDCALL;
+}
