+/* Sphere, hemisphere and parabolic environment maps are resampled from the six rendered cube faces. */
+static void test_sg_envmap_projections(IDirect3DDevice9 *device)
+{
+    static const D3DCOLOR face_color[6] = {0xffff0000, 0xff800000, 0xff00ff00, 0xff008000, 0xff0000ff, 0xff000080};
+    IDirect3DTexture9 *tex[2];
+    ID3DXRenderToEnvMap *render;
+    unsigned int kind, f;
+    HRESULT hr;
+
+    hr = D3DXCreateRenderToEnvMap(device, 16, 1, D3DFMT_A8R8G8B8, FALSE, D3DFMT_UNKNOWN, &render);
+    if (FAILED(hr))
+    {
+        skip("Failed to create ID3DXRenderToEnvMap, hr %#lx.\n", hr);
+        return;
+    }
+    for (kind = 0; kind < 3; ++kind)
+    {
+        D3DCOLOR c;
+
+        if (FAILED(hr = IDirect3DDevice9_CreateTexture(device, 16, 16, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8,
+                D3DPOOL_DEFAULT, &tex[0], NULL)))
+        {
+            skip("Failed to create a render target texture, hr %#lx.\n", hr);
+            break;
+        }
+        IDirect3DDevice9_CreateTexture(device, 16, 16, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8,
+                D3DPOOL_DEFAULT, &tex[1], NULL);
+
+        /* the same texture size and format are required */
+        if (kind == 0)
+        {
+            IDirect3DTexture9 *little;
+
+            hr = IDirect3DDevice9_CreateTexture(device, 8, 8, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8,
+                    D3DPOOL_DEFAULT, &little, NULL);
+            ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+            hr = ID3DXRenderToEnvMap_BeginSphere(render, little);
+            ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+            IDirect3DTexture9_Release(little);
+        }
+
+        if (kind == 0)
+            hr = ID3DXRenderToEnvMap_BeginSphere(render, tex[0]);
+        else if (kind == 1)
+            hr = ID3DXRenderToEnvMap_BeginHemisphere(render, tex[0], tex[1]);
+        else
+            hr = ID3DXRenderToEnvMap_BeginParabolic(render, tex[0], tex[1]);
+        ok(hr == D3D_OK, "Kind %u: got hr %#lx.\n", kind, hr);
+        if (FAILED(hr))
+            goto next;
+
+        hr = ID3DXRenderToEnvMap_BeginSphere(render, tex[0]);
+        ok(hr == D3DERR_INVALIDCALL, "Got hr %#lx.\n", hr);
+
+        for (f = 0; f < 6; ++f)
+        {
+            hr = ID3DXRenderToEnvMap_Face(render, f, D3DX_FILTER_NONE);
+            ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+            hr = IDirect3DDevice9_Clear(device, 0, NULL, D3DCLEAR_TARGET, face_color[f], 1.0f, 0);
+            ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+        }
+        hr = ID3DXRenderToEnvMap_End(render, D3DX_FILTER_NONE);
+        ok(hr == D3D_OK, "Got hr %#lx.\n", hr);
+
+        if (kind == 0)
+        {
+            /* the middle of a sphere map shows the direction behind the viewer */
+            c = sg_get_pixel(tex[0], 8, 8);
+            ok(c == face_color[D3DCUBEMAP_FACE_NEGATIVE_Z], "Sphere centre is %#lx.\n", c);
+            /* the rim shows the direction away from the viewer */
+            c = sg_get_pixel(tex[0], 8, 0);
+            ok(c != face_color[D3DCUBEMAP_FACE_NEGATIVE_Z], "Sphere rim is %#lx.\n", c);
+            /* outside the disc there is nothing */
+            c = sg_get_pixel(tex[0], 0, 0);
+            ok(c == 0, "Sphere corner is %#lx.\n", c);
+        }
+        else
+        {
+            c = sg_get_pixel(tex[0], 8, 8);
+            ok(c == face_color[D3DCUBEMAP_FACE_POSITIVE_Z], "Kind %u: +Z centre is %#lx.\n", kind, c);
+            c = sg_get_pixel(tex[1], 8, 8);
+            ok(c == face_color[D3DCUBEMAP_FACE_NEGATIVE_Z], "Kind %u: -Z centre is %#lx.\n", kind, c);
+            c = sg_get_pixel(tex[0], 0, 0);
+            ok(c == 0, "Kind %u: corner is %#lx.\n", kind, c);
+            /* a texel right of the centre looks towards +X, one above the centre towards +Y */
+            c = sg_get_pixel(tex[0], 14, 8);
+            ok(c == face_color[D3DCUBEMAP_FACE_POSITIVE_X] || c == face_color[D3DCUBEMAP_FACE_POSITIVE_Z],
+                    "Kind %u: right texel is %#lx.\n", kind, c);
+            c = sg_get_pixel(tex[0], 8, 1);
+            ok(c == face_color[D3DCUBEMAP_FACE_POSITIVE_Y] || c == face_color[D3DCUBEMAP_FACE_POSITIVE_Z],
+                    "Kind %u: top texel is %#lx.\n", kind, c);
+        }
+next:
+        IDirect3DTexture9_Release(tex[0]);
+        IDirect3DTexture9_Release(tex[1]);
+    }
+    check_release((IUnknown *)render, 0);
+}
