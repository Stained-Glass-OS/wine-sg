+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A server creates a named connection port; a client connecting to it gets a client communication port and
+ * the server, accepting, a server communication port. Everything sent to the server side, connection
+ * requests and the messages of all its clients, is queued on the connection port, where the server receives
+ * it through any of its ports; messages for a client are queued on its client port. A request is kept, once
+ * received, until it is replied to; the reply goes to the port it came through, for the thread that sent it.
+ *
+ * The ntdll side waits on a port handle and asks again: a port is signaled for a thread that waits for a
+ * reply when the reply is there (or the other side went away), and otherwise when there is a message to
+ * receive (for a connecting client: when the connection was accepted or refused).
+ */
+
+#include "config.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <sys/types.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "handle.h"
+#include "thread.h"
+#include "process.h"
+#include "request.h"
+#include "security.h"
+
+#define PORT_CONNECT     0x0001
+#define PORT_ALL_ACCESS  (STANDARD_RIGHTS_REQUIRED | SYNCHRONIZE | PORT_CONNECT)
+
+/* LPC message types */
+#define LPC_REQUEST             1
+#define LPC_REPLY               2
+#define LPC_DATAGRAM            3
+#define LPC_PORT_CLOSED         5
+#define LPC_CLIENT_DIED         6
+#define LPC_CONNECTION_REQUEST  10
+
+/* the message buffer carries at most this much data; more needs a shared section */
+#define PORT_MAX_DATA      304
+#define PORT_MAX_INFO      260
+
+static const WCHAR port_name[] = {'P','o','r','t'};
+
+struct type_descr port_type =
+{
+    { port_name, sizeof(port_name) },   /* name */
+    PORT_ALL_ACCESS,                    /* valid_access */
+    {                                   /* mapping */
+        STANDARD_RIGHTS_READ,
+        STANDARD_RIGHTS_WRITE,
+        STANDARD_RIGHTS_EXECUTE,
+        PORT_ALL_ACCESS
+    },
+};
+
+enum port_kind { PORT_KIND_CONNECTION, PORT_KIND_CLIENT, PORT_KIND_SERVER };
+enum client_state { CLIENT_CONNECTING, CLIENT_CONNECTED, CLIENT_REFUSED, CLIENT_DISCONNECTED };
+
+struct port
+{
+    struct object      obj;            /* object header */
+    enum port_kind     kind;
+    struct port       *connection;     /* communication ports: the server's connection port (holds a ref) */
+    struct port       *peer;           /* communication ports: the other end, NULL once it went */
+    struct list        queue;          /* connection and client ports: messages to receive */
+    struct list        replies;        /* communication ports: replies to the requests sent through them */
+    struct list        servers;        /* connection port: its server communication ports */
+    struct list        server_entry;   /* server port: entry in the connection port's list */
+    data_size_t        max_info;       /* connection port: largest connection information */
+    data_size_t        max_data;       /* largest message data */
+    client_ptr_t       context;        /* server port: the context the server gave on accepting */
+    enum client_state  state;          /* client port */
+    void              *info;           /* client port: the server's connection information */
+    data_size_t        info_len;
+    struct sid        *server_sid;     /* connection port: the user of the process that created it */
+    int                closed;         /* the last handle was closed */
+    int                connect_done;   /* client port: accepted or refused, the client was not told yet */
+};
+
+struct port_msg
+{
+    struct list    entry;
+    unsigned int   id;
+    unsigned int   type;
+    process_id_t   pid;
+    thread_id_t    tid;
+    struct thread *thread;             /* sender (requests, replies: who waits); holds a ref */
+    struct port   *sender;             /* port it came through, where a reply goes; holds a ref */
+    struct port   *owner;              /* once received: the port whose queue it was taken from */
+    struct process *receiver;          /* once received: the process that took it (no ref) */
+    client_ptr_t   context;
+    data_size_t    size;
+    char           data[1];
+};
+
+struct terminate_port
+{
+    struct list    entry;
+    struct thread *thread;             /* holds a ref */
+    struct port   *port;               /* holds a ref */
+};
+
+static struct list awaiting = LIST_INIT( awaiting );         /* received requests and connection requests */
+static struct list terminate_ports = LIST_INIT( terminate_ports );
+static unsigned int next_msg_id = 1;
+
+static void port_dump( struct object *obj, int verbose );
+static int port_signaled( struct object *obj, struct wait_queue_entry *entry );
+static int port_close_handle( struct object *obj, struct process *process, obj_handle_t handle );
+static void port_destroy( struct object *obj );
+
+static const struct object_ops port_ops =
+{
+    sizeof(struct port),       /* size */
+    &port_type,                /* type */
+    port_dump,                 /* dump */
+    add_queue,                 /* add_queue */
+    remove_queue,              /* remove_queue */
+    port_signaled,             /* signaled */
+    no_satisfied,              /* satisfied */
+    no_signal,                 /* signal */
+    no_get_fd,                 /* get_fd */
+    default_map_access,        /* map_access */
+    default_get_sd,            /* get_sd */
+    default_set_sd,            /* set_sd */
+    default_get_full_name,     /* get_full_name */
+    no_lookup_name,            /* lookup_name */
+    directory_link_name,       /* link_name */
+    default_unlink_name,       /* unlink_name */
+    no_open_file,              /* open_file */
+    no_kernel_obj_list,        /* get_kernel_obj_list */
+    port_close_handle,         /* close_handle */
+    port_destroy               /* destroy */
+};
+
+static void port_dump( struct object *obj, int verbose )
+{
+    struct port *port = (struct port *)obj;
+    assert( obj->ops == &port_ops );
+    fprintf( stderr, "Port kind=%d state=%d\n", port->kind, port->state );
+}
+
+static void init_port( struct port *port, enum port_kind kind )
+{
+    port->kind       = kind;
+    port->connection = NULL;
+    port->peer       = NULL;
+    list_init( &port->queue );
+    list_init( &port->replies );
+    list_init( &port->servers );
+    list_init( &port->server_entry );
+    port->max_info   = 0;
+    port->max_data   = 0;
+    port->context    = 0;
+    port->state      = CLIENT_CONNECTING;
+    port->info       = NULL;
+    port->info_len   = 0;
+    port->server_sid = NULL;
+    port->closed     = 0;
+    port->connect_done = 0;
+}
+
+static struct port *alloc_port( enum port_kind kind )
+{
+    struct port *port;
+
+    if ((port = alloc_object( &port_ops ))) init_port( port, kind );
+    return port;
+}
+
+static struct port_msg *alloc_msg( unsigned int type, const void *data, data_size_t size )
+{
+    struct port_msg *msg;
+
+    if (!(msg = mem_alloc( offsetof( struct port_msg, data[size] ) ))) return NULL;
+    msg->id       = 0;
+    msg->type     = type;
+    msg->pid      = current ? current->process->id : 0;
+    msg->tid      = current ? current->id : 0;
+    msg->thread   = NULL;
+    msg->sender   = NULL;
+    msg->owner    = NULL;
+    msg->receiver = NULL;
+    msg->context  = 0;
+    msg->size     = size;
+    if (size) memcpy( msg->data, data, size );
+    return msg;
+}
+
+static void free_msg( struct port_msg *msg )
+{
+    if (msg->thread) release_object( msg->thread );
+    if (msg->sender) release_object( msg->sender );
+    free( msg );
+}
+
+static unsigned int new_msg_id(void)
+{
+    unsigned int id = next_msg_id++;
+    if (!next_msg_id) next_msg_id = 1;
+    return id;
+}
+
+/* the port whose queue a port's owner receives from */
+static struct port *receive_port( struct port *port )
+{
+    return port->kind == PORT_KIND_SERVER ? port->connection : port;
+}
+
+/* wake whoever may receive from this queue: the port and, for a connection port, its server ports */
+static void wake_receivers( struct port *queue )
+{
+    struct port *server;
+
+    wake_up( &queue->obj, 0 );
+    if (queue->kind != PORT_KIND_CONNECTION) return;
+    LIST_FOR_EACH_ENTRY( server, &queue->servers, struct port, server_entry )
+        wake_up( &server->obj, 0 );
+}
+
+static void queue_msg( struct port *queue, struct port_msg *msg )
+{
+    list_add_tail( &queue->queue, &msg->entry );
+    wake_receivers( queue );
+}
+
+static int has_reply_for( struct port *port, struct thread *thread )
+{
+    struct port_msg *msg;
+
+    LIST_FOR_EACH_ENTRY( msg, &port->replies, struct port_msg, entry )
+        if (msg->thread == thread) return 1;
+    return 0;
+}
+
+/* a request this thread sent through this port still waits for its reply */
+static int request_in_flight( struct port *port, struct thread *thread )
+{
+    struct port_msg *msg;
+    struct port *queue;
+
+    LIST_FOR_EACH_ENTRY( msg, &awaiting, struct port_msg, entry )
+        if (msg->type == LPC_REQUEST && msg->sender == port && msg->thread == thread) return 1;
+    if (port->peer && (queue = receive_port( port->peer )))
+        LIST_FOR_EACH_ENTRY( msg, &queue->queue, struct port_msg, entry )
+            if (msg->type == LPC_REQUEST && msg->sender == port && msg->thread == thread) return 1;
+    return 0;
+}
+
+static int port_signaled( struct object *obj, struct wait_queue_entry *entry )
+{
+    struct port *port = (struct port *)obj;
+    struct thread *thread = get_wait_queue_thread( entry );
+    struct port *queue;
+
+    assert( obj->ops == &port_ops );
+
+    if (port->kind == PORT_KIND_CLIENT)
+    {
+        if (port->connect_done) return 1;
+        if (port->state == CLIENT_CONNECTING) return 0;
+        if (port->state != CLIENT_CONNECTED) return 1;
+    }
+    if (port->kind != PORT_KIND_CONNECTION)
+    {
+        if (has_reply_for( port, thread )) return 1;
+        if (request_in_flight( port, thread )) return !port->peer;
+        if (!port->peer && port->kind == PORT_KIND_CLIENT) return 1;
+    }
+    queue = receive_port( port );
+    return queue && !list_empty( &queue->queue );
+}
+
+/* a connecting client's request was answered */
+static void connect_answered( struct port *client, enum client_state state )
+{
+    client->state = state;
+    client->connect_done = 1;
+    wake_up( &client->obj, 0 );
+}
+
+static void flush_list( struct list *list )
+{
+    struct port_msg *msg, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( msg, next, list, struct port_msg, entry )
+    {
+        list_remove( &msg->entry );
+        free_msg( msg );
+    }
+}
+
+/* drop received requests that can no longer be replied to */
+static void drop_awaiting( struct port *port )
+{
+    struct port_msg *msg, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( msg, next, &awaiting, struct port_msg, entry )
+    {
+        if (msg->owner != port && msg->sender != port) continue;
+        if (msg->type == LPC_CONNECTION_REQUEST && msg->sender && msg->sender->state == CLIENT_CONNECTING)
+        {
+            connect_answered( msg->sender, CLIENT_REFUSED );
+        }
+        list_remove( &msg->entry );
+        free_msg( msg );
+    }
+}
+
+/* the last handle of a port went: tell the other side */
+static void port_disconnect( struct port *port )
+{
+    struct port_msg *msg, *next;
+
+    if (port->closed) return;
+    port->closed = 1;
+
+    switch (port->kind)
+    {
+    case PORT_KIND_CONNECTION:
+        if (port->obj.name) unlink_named_object( &port->obj );
+        /* pending connection requests are refused */
+        LIST_FOR_EACH_ENTRY_SAFE( msg, next, &port->queue, struct port_msg, entry )
+        {
+            if (msg->type == LPC_CONNECTION_REQUEST && msg->sender && msg->sender->state == CLIENT_CONNECTING)
+            {
+                connect_answered( msg->sender, CLIENT_REFUSED );
+            }
+        }
+        flush_list( &port->queue );
+        break;
+    case PORT_KIND_CLIENT:
+        if (port->peer)
+        {
+            struct port *server = port->peer;
+
+            server->peer = NULL;
+            port->peer = NULL;
+            if (server->connection && !server->connection->closed &&
+                (msg = alloc_msg( LPC_PORT_CLOSED, NULL, 0 )))
+            {
+                msg->id = new_msg_id();
+                msg->context = server->context;
+                queue_msg( server->connection, msg );
+            }
+            wake_up( &server->obj, 0 );
+        }
+        port->state = CLIENT_DISCONNECTED;
+        flush_list( &port->queue );
+        break;
+    case PORT_KIND_SERVER:
+#ifndef SG_MUTANT_LPC_KEEP_WAITING
+        if (port->peer)
+#else
+        if (0)
+#endif
+        {
+            struct port *client = port->peer;
+
+            client->peer = NULL;
+            port->peer = NULL;
+            if (client->state == CLIENT_CONNECTING) connect_answered( client, CLIENT_REFUSED );
+            else wake_up( &client->obj, 0 );
+        }
+        break;
+    }
+    drop_awaiting( port );
+}
+
+static int port_close_handle( struct object *obj, struct process *process, obj_handle_t handle )
+{
+    struct port *port = (struct port *)obj;
+
+    if (obj->handle_count == 1) port_disconnect( port );
+    return 1;
+}
+
+static void port_destroy( struct object *obj )
+{
+    struct port *port = (struct port *)obj;
+
+    assert( obj->ops == &port_ops );
+
+    flush_list( &port->queue );
+    flush_list( &port->replies );
+    if (port->peer) port->peer->peer = NULL;
+    list_remove( &port->server_entry );
+    if (port->connection) release_object( port->connection );
+    free( port->info );
+    free( port->server_sid );
+}
+
+static struct port *get_port_obj( struct process *process, obj_handle_t handle, unsigned int access )
+{
+    return (struct port *)get_handle_obj( process, handle, access, &port_ops );
+}
+
+/* a thread ends: LPC_CLIENT_DIED through every port it registered */
+void port_thread_terminated( struct thread *thread )
+{
+    struct terminate_port *reg, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( reg, next, &terminate_ports, struct terminate_port, entry )
+    {
+        struct port *port = reg->port, *queue = NULL;
+        struct port_msg *msg;
+
+        if (reg->thread != thread) continue;
+        list_remove( &reg->entry );
+
+        if (port->peer) queue = receive_port( port->peer );
+        if (queue && !queue->closed && (msg = alloc_msg( LPC_CLIENT_DIED, NULL, 0 )))
+        {
+            msg->id = new_msg_id();
+            msg->pid = thread->process->id;
+            msg->tid = thread->id;
+            if (port->peer->kind == PORT_KIND_SERVER) msg->context = port->peer->context;
+            queue_msg( queue, msg );
+        }
+        release_object( reg->port );
+        release_object( reg->thread );
+        free( reg );
+    }
+}
+
+/* create a connection port */
+DECL_HANDLER(create_port)
+{
+    struct port *port;
+    struct unicode_str name;
+    struct object *root;
+    const struct security_descriptor *sd;
+    const struct object_attributes *objattr = get_req_object_attributes( &sd, &name, &root );
+    const struct sid *user;
+
+    if (!objattr) return;
+
+    if (req->max_info > PORT_MAX_INFO)
+        set_error( STATUS_INVALID_PARAMETER );
+    else if ((port = create_named_object( root, &port_ops, &name, objattr->attributes & ~OBJ_OPENIF, sd )))
+    {
+        if (get_error() == STATUS_OBJECT_NAME_EXISTS)
+            set_error( STATUS_OBJECT_NAME_COLLISION );
+        else
+        {
+            if (!sd) set_creator_owner_group( &port->obj );
+            init_port( port, PORT_KIND_CONNECTION );
+            port->max_info = req->max_info;
+            port->max_data = min( req->max_data, PORT_MAX_DATA );
+            if ((user = token_get_user( current->process->token )))
+                port->server_sid = memdup( user, sid_len( user ));
+            reply->handle = alloc_handle_no_access_check( current->process, port, req->access,
+                                                          objattr->attributes );
+        }
+        release_object( port );
+    }
+
+    if (root) release_object( root );
+}
+
+/* connect to a named connection port */
+DECL_HANDLER(connect_port)
+{
+    struct unicode_str name;
+    struct object *root = NULL;
+    struct port *connection, *client;
+    struct port_msg *msg;
+    unsigned int access = PORT_CONNECT;
+    const void *info = (const char *)get_req_data() + req->name_len;
+    data_size_t info_len;
+
+    if (req->name_len > get_req_data_size() || (req->name_len & 1))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    name.str = get_req_data();
+    name.len = req->name_len;
+    info_len = get_req_data_size() - req->name_len;
+
+    if (req->rootdir && !(root = get_directory_obj( current->process, req->rootdir ))) return;
+    connection = open_named_object( root, &port_ops, &name, 0 );
+    if (root) release_object( root );
+    if (!connection) return;
+
+    if (connection->kind != PORT_KIND_CONNECTION || connection->closed)
+        set_error( STATUS_OBJECT_NAME_NOT_FOUND );
+    else if (!check_object_access( NULL, &connection->obj, &access ))
+        set_error( STATUS_ACCESS_DENIED );
+    else if (info_len > connection->max_info)
+        set_error( STATUS_PORT_MESSAGE_TOO_LONG );
+    else if ((client = alloc_port( PORT_KIND_CLIENT )))
+    {
+        client->connection = (struct port *)grab_object( connection );
+        client->max_data   = connection->max_data;
+        if ((msg = alloc_msg( LPC_CONNECTION_REQUEST, info, info_len )))
+        {
+            msg->id     = new_msg_id();
+            msg->thread = (struct thread *)grab_object( current );
+            msg->sender = (struct port *)grab_object( client );
+            if ((reply->handle = alloc_handle_no_access_check( current->process, client, PORT_ALL_ACCESS, 0 )))
+            {
+                reply->max_data = client->max_data;
+                if (connection->server_sid)
+                    set_reply_data( connection->server_sid,
+                                    min( sid_len( connection->server_sid ), get_reply_max_size() ));
+                queue_msg( connection, msg );
+            }
+            else free_msg( msg );
+        }
+        release_object( client );
+    }
+    release_object( connection );
+}
+
+/* the outcome of a connection request */
+DECL_HANDLER(get_port_connect_result)
+{
+    struct port *port;
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    if (port->kind != PORT_KIND_CLIENT) set_error( STATUS_INVALID_PORT_HANDLE );
+    else switch (port->state)
+    {
+    case CLIENT_CONNECTING:
+        set_error( STATUS_PENDING );
+        break;
+    case CLIENT_CONNECTED:
+        reply->info_len = port->info_len;
+        if (port->info_len) set_reply_data( port->info, min( port->info_len, get_reply_max_size() ));
+        break;
+    case CLIENT_REFUSED:
+        set_error( STATUS_PORT_CONNECTION_REFUSED );
+        break;
+    case CLIENT_DISCONNECTED:
+        set_error( STATUS_PORT_DISCONNECTED );
+        break;
+    }
+    if (port->kind == PORT_KIND_CLIENT && port->state != CLIENT_CONNECTING) port->connect_done = 0;
+    release_object( port );
+}
+
+/* accept or refuse a connection request the calling process received */
+DECL_HANDLER(accept_port_connect)
+{
+    struct port_msg *msg, *found = NULL;
+    struct port *client, *server, *connection;
+
+    LIST_FOR_EACH_ENTRY( msg, &awaiting, struct port_msg, entry )
+    {
+        if (msg->type == LPC_CONNECTION_REQUEST && msg->id == req->msg_id && msg->receiver == current->process)
+        {
+            found = msg;
+            break;
+        }
+    }
+    if (!found)
+    {
+        set_error( STATUS_REPLY_MESSAGE_MISMATCH );
+        return;
+    }
+
+    client = found->sender;
+    connection = client->connection;
+    if (client->state != CLIENT_CONNECTING || client->closed)
+    {
+        set_error( STATUS_PORT_DISCONNECTED );
+        list_remove( &found->entry );
+        free_msg( found );
+        return;
+    }
+
+    if (!req->accept)
+    {
+        connect_answered( client, CLIENT_REFUSED );
+        list_remove( &found->entry );
+        free_msg( found );
+        return;
+    }
+
+    if (get_req_data_size() > connection->max_info)
+    {
+        set_error( STATUS_PORT_MESSAGE_TOO_LONG );
+        return;
+    }
+    if (!(server = alloc_port( PORT_KIND_SERVER ))) return;
+    server->connection = (struct port *)grab_object( connection );
+    server->max_data   = connection->max_data;
+    server->context    = req->context;
+    if ((reply->handle = alloc_handle_no_access_check( current->process, server, PORT_ALL_ACCESS, 0 )))
+    {
+        free( client->info );
+        client->info_len = get_req_data_size();
+        client->info = client->info_len ? memdup( get_req_data(), client->info_len ) : NULL;
+        server->peer = client;
+        client->peer = server;
+        list_add_tail( &connection->servers, &server->server_entry );
+        list_remove( &found->entry );
+        free_msg( found );
+    }
+    release_object( server );
+}
+
+/* the server is ready: the client's NtConnectPort returns */
+DECL_HANDLER(complete_port_connect)
+{
+    struct port *port;
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    if (port->kind != PORT_KIND_SERVER) set_error( STATUS_INVALID_PORT_HANDLE );
+    else if (!port->peer) set_error( STATUS_PORT_DISCONNECTED );
+    else if (port->peer->state != CLIENT_CONNECTING) set_error( STATUS_INVALID_PARAMETER );
+    else
+    {
+        connect_answered( port->peer, CLIENT_CONNECTED );
+    }
+    release_object( port );
+}
+
+/* send a datagram, a request or a reply */
+DECL_HANDLER(send_port_message)
+{
+    struct port *port, *queue;
+    struct port_msg *msg;
+    data_size_t size = get_req_data_size();
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    if (size > port->max_data)
+    {
+        set_error( STATUS_PORT_MESSAGE_TOO_LONG );
+        goto done;
+    }
+
+    if (req->type == LPC_REPLY)
+    {
+        struct port_msg *request = NULL;
+
+        queue = receive_port( port );
+        LIST_FOR_EACH_ENTRY( msg, &awaiting, struct port_msg, entry )
+        {
+            if (msg->type == LPC_REQUEST && msg->id == req->reply_to && msg->owner == queue &&
+                msg->receiver == current->process)
+            {
+                request = msg;
+                break;
+            }
+        }
+        if (!request)
+        {
+            set_error( STATUS_REPLY_MESSAGE_MISMATCH );
+            goto done;
+        }
+        list_remove( &request->entry );
+        if (request->sender && request->sender->peer && (msg = alloc_msg( LPC_REPLY, get_req_data(), size )))
+        {
+            msg->id     = request->id;
+            msg->thread = request->thread ? (struct thread *)grab_object( request->thread ) : NULL;
+            list_add_tail( &request->sender->replies, &msg->entry );
+            wake_up( &request->sender->obj, 0 );
+        }
+        reply->msg_id = request->id;
+        free_msg( request );
+        goto done;
+    }
+
+    if (req->type != LPC_REQUEST && req->type != LPC_DATAGRAM)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        goto done;
+    }
+    if (port->kind == PORT_KIND_CONNECTION)
+    {
+        set_error( STATUS_INVALID_PORT_HANDLE );
+        goto done;
+    }
+    if (port->kind == PORT_KIND_CLIENT && port->state != CLIENT_CONNECTED)
+    {
+        set_error( port->state == CLIENT_CONNECTING ? STATUS_INVALID_PORT_HANDLE : STATUS_PORT_DISCONNECTED );
+        goto done;
+    }
+    if (!port->peer || !(queue = receive_port( port->peer )) || queue->closed)
+    {
+        set_error( STATUS_PORT_DISCONNECTED );
+        goto done;
+    }
+    if ((msg = alloc_msg( req->type, get_req_data(), size )))
+    {
+        msg->id      = new_msg_id();
+        msg->sender  = (struct port *)grab_object( port );
+#ifdef SG_MUTANT_LPC_NO_CONTEXT
+        msg->context = 0;
+#else
+        msg->context = port->peer->kind == PORT_KIND_SERVER ? port->peer->context : 0;
+#endif
+        if (req->type == LPC_REQUEST) msg->thread = (struct thread *)grab_object( current );
+        reply->msg_id = msg->id;
+        queue_msg( queue, msg );
+    }
+
+done:
+    release_object( port );
+}
+
+/* take the next message, or the reply to a request */
+DECL_HANDLER(receive_port_message)
+{
+    struct port *port, *queue;
+    struct port_msg *msg, *next;
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    if (req->reply_to)
+    {
+        LIST_FOR_EACH_ENTRY( msg, &port->replies, struct port_msg, entry )
+        {
+            if (msg->id != req->reply_to) continue;
+            list_remove( &msg->entry );
+            reply->type       = LPC_REPLY;
+            reply->msg_id     = msg->id;
+            reply->client_pid = msg->pid;
+            reply->client_tid = msg->tid;
+            reply->data_len   = msg->size;
+            set_reply_data( msg->data, min( msg->size, get_reply_max_size() ));
+            free_msg( msg );
+            goto done;
+        }
+        set_error( request_in_flight( port, current ) && port->peer ? STATUS_PENDING : STATUS_PORT_DISCONNECTED );
+        goto done;
+    }
+
+    if (port->kind == PORT_KIND_CLIENT && port->state == CLIENT_CONNECTING)
+    {
+        set_error( STATUS_INVALID_PORT_HANDLE );
+        goto done;
+    }
+    queue = receive_port( port );
+    LIST_FOR_EACH_ENTRY_SAFE( msg, next, &queue->queue, struct port_msg, entry )
+    {
+        list_remove( &msg->entry );
+        if (req->connect_only && msg->type != LPC_CONNECTION_REQUEST)
+        {
+            free_msg( msg );
+            continue;
+        }
+        reply->type       = msg->type;
+        reply->msg_id     = msg->id;
+        reply->client_pid = msg->pid;
+        reply->client_tid = msg->tid;
+        reply->context    = msg->context;
+        reply->data_len   = msg->size;
+        set_reply_data( msg->data, min( msg->size, get_reply_max_size() ));
+        if (msg->type == LPC_REQUEST || msg->type == LPC_CONNECTION_REQUEST)
+        {
+            /* kept until replied to, accepted or refused */
+            msg->owner    = queue;
+            msg->receiver = current->process;
+            list_add_tail( &awaiting, &msg->entry );
+        }
+        else free_msg( msg );
+        goto done;
+    }
+    if (port->kind == PORT_KIND_CLIENT && !port->peer) set_error( STATUS_PORT_DISCONNECTED );
+    else set_error( STATUS_PENDING );
+
+done:
+    release_object( port );
+}
+
+/* LPC_CLIENT_DIED through this port when the calling thread ends */
+DECL_HANDLER(register_terminate_port)
+{
+    struct terminate_port *reg;
+    struct port *port;
+
+    if (!(port = get_port_obj( current->process, req->handle, 0 ))) return;
+
+    if (port->kind == PORT_KIND_CONNECTION) set_error( STATUS_INVALID_PORT_HANDLE );
+    else if ((reg = mem_alloc( sizeof(*reg) )))
+    {
+        reg->thread = (struct thread *)grab_object( current );
+        reg->port   = (struct port *)grab_object( port );
+        list_add_tail( &terminate_ports, &reg->entry );
+    }
+    release_object( port );
+}
diff --git a/server/protocol.def b/server/protocol.def
index f9b7125..5279f76 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -4345,3 +4345,86 @@ struct handle_info
     data_size_t  desc_len;      /* length of the full description */
     VARARG(description,unicode_str); /* description */
 @END
+
+
+/* Create an LPC connection port */
+@REQ(create_port)
+    unsigned int access;        /* wanted access rights */
+    data_size_t  max_info;      /* largest connection information */
+    data_size_t  max_data;      /* largest message data */
+    VARARG(objattr,object_attributes); /* object attributes */
+@REPLY
+    obj_handle_t handle;        /* handle to the port */
+@END
+
+
+/* Ask a named connection port for a connection; the reply's port is the client communication port */
+@REQ(connect_port)
+    obj_handle_t rootdir;       /* root directory */
+    data_size_t  name_len;      /* length of the port name */
+    VARARG(name,unicode_str,name_len); /* port name */
+    VARARG(info,bytes);         /* connection information */
+@REPLY
+    obj_handle_t handle;        /* client communication port, connecting */
+    data_size_t  max_data;      /* largest message data */
+    VARARG(server_sid,sid);     /* the server process's user */
+@END
+
+
+/* Result of a connection request, once the client port is signaled */
+@REQ(get_port_connect_result)
+    obj_handle_t handle;        /* client communication port */
+@REPLY
+    data_size_t  info_len;      /* length of the server's connection information */
+    VARARG(info,bytes);         /* the server's connection information */
+@END
+
+
+/* Accept or refuse a connection request */
+@REQ(accept_port_connect)
+    unsigned int msg_id;        /* id of the connection request */
+    client_ptr_t context;       /* port context given back with each message */
+    int          accept;        /* accept or refuse */
+    VARARG(info,bytes);         /* connection information for the client */
+@REPLY
+    obj_handle_t handle;        /* server communication port */
+@END
+
+
+/* Let the client of an accepted connection go */
+@REQ(complete_port_connect)
+    obj_handle_t handle;        /* server communication port */
+@END
+
+
+/* Send a datagram, a request or a reply on a port */
+@REQ(send_port_message)
+    obj_handle_t handle;        /* port handle */
+    unsigned int type;          /* LPC message type */
+    unsigned int reply_to;      /* for a reply: the id of the request */
+    VARARG(data,bytes);         /* message data */
+@REPLY
+    unsigned int msg_id;        /* id of the message */
+@END
+
+
+/* Take a message from a port, or the reply to a request */
+@REQ(receive_port_message)
+    obj_handle_t handle;        /* port handle */
+    unsigned int reply_to;      /* 0: the next message; else the reply to this request */
+    int          connect_only;  /* drop everything but connection requests */
+@REPLY
+    unsigned int type;          /* LPC message type */
+    unsigned int msg_id;        /* message id */
+    process_id_t client_pid;    /* sender's process */
+    thread_id_t  client_tid;    /* sender's thread */
+    client_ptr_t context;       /* context of the port it came through */
+    data_size_t  data_len;      /* length of the data */
+    VARARG(data,bytes);         /* message data */
+@END
+
+
+/* Send LPC_CLIENT_DIED through this port when the calling thread ends */
+@REQ(register_terminate_port)
+    obj_handle_t handle;        /* port handle */
+@END
