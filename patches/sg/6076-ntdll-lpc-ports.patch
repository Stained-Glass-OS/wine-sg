+/* LPC ports. The message layout is the 64-bit one, also for 32-bit callers (as Windows' WoW64 does). */
+
+#define LPC_REQUEST             1
+#define LPC_REPLY               2
+#define LPC_DATAGRAM            3
+#define LPC_CONNECTION_REQUEST  10
+#define LPC_HEADER_SIZE         offsetof( LPC_MESSAGE, Data )
+
+/* a message given by the caller: its data must fit in the size it claims */
+static NTSTATUS check_lpc_message( const LPC_MESSAGE *msg )
+{
+    if (!msg) return STATUS_INVALID_PARAMETER;
+    if (msg->DataSize + LPC_HEADER_SIZE > msg->MessageSize) return STATUS_INVALID_PARAMETER;
+    return STATUS_SUCCESS;
+}
+
+/* waits for a port to be signaled for this thread, then asks again */
+static NTSTATUS wait_port( HANDLE handle, const LARGE_INTEGER *timeout )
+{
+    NTSTATUS status = NtWaitForSingleObject( handle, FALSE, timeout );
+
+    if (status == STATUS_WAIT_0) return STATUS_SUCCESS;
+    if (status == STATUS_TIMEOUT) return STATUS_TIMEOUT;
+    return NT_SUCCESS(status) ? STATUS_UNSUCCESSFUL : status;
+}
+
+/* receives the next message (reply_to 0) or the reply to a request into msg */
+static NTSTATUS receive_port_message( HANDLE handle, ULONG reply_to, BOOL connect_only, LPC_MESSAGE *msg,
+                                      void **context, const LARGE_INTEGER *timeout )
+{
+    NTSTATUS status;
+
+    for (;;)
+    {
+        SERVER_START_REQ( receive_port_message )
+        {
+            req->handle       = wine_server_obj_handle( handle );
+            req->reply_to     = reply_to;
+            req->connect_only = connect_only;
+            wine_server_set_reply( req, msg->Data, 0xffff );
+            status = wine_server_call( req );
+            if (!status)
+            {
+                msg->DataSize            = reply->data_len;
+                msg->MessageSize         = LPC_HEADER_SIZE + reply->data_len;
+                msg->MessageType         = reply->type;
+                msg->VirtualRangesOffset = 0;
+                msg->ClientId.UniqueProcess = ULongToHandle( reply->client_pid );
+                msg->ClientId.UniqueThread  = ULongToHandle( reply->client_tid );
+                msg->MessageId           = reply->msg_id;
+                msg->SectionSize         = 0;
+                if (context) *context = wine_server_get_ptr( reply->context );
+            }
+        }
+        SERVER_END_REQ;
+        if (status != STATUS_PENDING) return status;
+        if ((status = wait_port( handle, timeout ))) return status;
+    }
+}
+
+static NTSTATUS send_port_message( HANDLE handle, ULONG type, ULONG reply_to, const LPC_MESSAGE *msg, ULONG *id )
+{
+    NTSTATUS status;
+
+    if ((status = check_lpc_message( msg ))) return status;
+    SERVER_START_REQ( send_port_message )
+    {
+        req->handle   = wine_server_obj_handle( handle );
+        req->type     = type;
+        req->reply_to = reply_to;
+        wine_server_add_data( req, msg->Data, msg->DataSize );
+        status = wine_server_call( req );
+        if (id) *id = reply->msg_id;
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+
 /***********************************************************************
  *             NtCreatePort (NTDLL.@)
  */
 NTSTATUS WINAPI NtCreatePort( HANDLE *handle, OBJECT_ATTRIBUTES *attr, ULONG info_len,
                               ULONG data_len, ULONG *reserved )
 {
-    FIXME( "(%p,%p,%u,%u,%p),stub!\n", handle, attr, (int)info_len, (int)data_len, reserved );
-    return STATUS_NOT_IMPLEMENTED;
+    struct object_attributes *objattr;
+    unsigned int ret;
+    data_size_t len;
+
+    TRACE( "(%p,%p,%u,%u,%p)\n", handle, attr, (int)info_len, (int)data_len, reserved );
+
+    if (!handle || !attr) return STATUS_INVALID_PARAMETER;
+    *handle = 0;
+    if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
+
+    SERVER_START_REQ( create_port )
+    {
+        req->access   = STANDARD_RIGHTS_REQUIRED | SYNCHRONIZE | 1 /* PORT_CONNECT */;
+        req->max_info = info_len;
+        /* the largest message, header included */
+        req->max_data = data_len > LPC_HEADER_SIZE ? data_len - LPC_HEADER_SIZE : 0;
+        wine_server_add_data( req, objattr, len );
+        ret = wine_server_call( req );
+        *handle = wine_server_ptr_handle( reply->handle );
+    }
+    SERVER_END_REQ;
+
+    free( objattr );
+    return ret;
+}
+
+
+/***********************************************************************
+ *             NtCreateWaitablePort (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCreateWaitablePort( HANDLE *handle, OBJECT_ATTRIBUTES *attr, ULONG info_len,
+                                      ULONG data_len, ULONG *reserved )
+{
+    return NtCreatePort( handle, attr, info_len, data_len, reserved );
+}
+
+
+static NTSTATUS connect_port( HANDLE *handle, UNICODE_STRING *name, LPC_SECTION_WRITE *write, PSID sid,
+                              LPC_SECTION_READ *read, ULONG *max_len, void *info, ULONG *info_len )
+{
+    char sid_buffer[SECURITY_MAX_SID_SIZE];
+    ULONG in_len = (info && info_len) ? *info_len : 0, sid_len = 0, out_len = 0;
+    NTSTATUS status;
+    HANDLE port = 0;
+
+    if (!handle || !name) return STATUS_INVALID_PARAMETER;
+    *handle = 0;
+    if (write && write->SectionHandle)
+    {
+        FIXME( "shared sections are not supported\n" );
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    SERVER_START_REQ( connect_port )
+    {
+        req->rootdir  = 0;
+        req->name_len = name->Length;
+        wine_server_add_data( req, name->Buffer, name->Length );
+        if (in_len) wine_server_add_data( req, info, in_len );
+        wine_server_set_reply( req, sid_buffer, sizeof(sid_buffer) );
+        status = wine_server_call( req );
+        port = wine_server_ptr_handle( reply->handle );
+        if (!status && max_len) *max_len = LPC_HEADER_SIZE + reply->max_data;
+        sid_len = wine_server_reply_size( reply );
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+
+#ifndef SG_MUTANT_LPC_NO_SID_CHECK
+    if (sid && (sid_len < offsetof( SID, SubAuthority[0] ) ||
+                sid_len != offsetof( SID, SubAuthority[((SID *)sid)->SubAuthorityCount] ) ||
+                memcmp( sid, sid_buffer, sid_len )))
+    {
+        NtClose( port );
+        return STATUS_SERVER_SID_MISMATCH;
+    }
+#endif
+
+    for (;;)
+    {
+        SERVER_START_REQ( get_port_connect_result )
