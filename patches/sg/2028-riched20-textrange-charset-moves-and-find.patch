 }
 
+/* The text of the whole story, one character to an offset of a range, with
+ * the final paragraph mark. */
+static HRESULT story_text(ME_TextEditor *editor, WCHAR **text, LONG *length)
+{
+    LONG total = ME_GetTextLength(editor) + 1, got;
+    ME_Cursor cursor;
+    WCHAR *buf;
+
+    if (!(buf = malloc((total + 1) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+
+    cursor_from_char_ofs(editor, 0, &cursor);
+    got = ME_GetTextObjW(editor, buf, total, &cursor, total, FALSE, TRUE);
+    while (got < total) buf[got++] = '\r';
+    buf[total] = 0;
+    *text = buf;
+    *length = total;
+    return S_OK;
+}
+
+/* Whether a character is in the set a range method was given: a string of
+ * characters, or a number whose bits select C1_ character types. */
+static BOOL charset_has(const VARIANT *set, WCHAR ch)
+{
+    if (V_VT(set) == VT_BSTR)
+        return V_BSTR(set) && wcschr(V_BSTR(set), ch) != NULL;
+    else
+    {
+        WORD type = 0;
+        GetStringTypeW(CT_CTYPE1, &ch, 1, &type);
+        return (type & V_I4(set)) != 0;
+    }
+}
+
+enum charset_move { MOVE_RANGE, MOVE_START, MOVE_END };
+
+/* MoveWhile, MoveUntil and their Start and End forms: the position moves
+ * over characters that are in the set (while) or not in it (until), count
+ * characters at most (negative counts go backwards). */
+static HRESULT textrange_move_charset(ITextRange *range, ME_TextEditor *editor, enum charset_move which,
+                                      BOOL until, VARIANT *set, LONG count, LONG *delta)
+{
+    LONG start, end, pos, moved = 0, total, limit;
+    BOOL forward = count > 0;
+    WCHAR *text;
+    HRESULT hr;
+
+    if (delta) *delta = 0;
+    if (!set || (V_VT(set) != VT_BSTR && V_VT(set) != VT_I4))
+        return E_INVALIDARG;
+    if (!count)
+        return S_FALSE;
+
+    if (FAILED(hr = story_text(editor, &text, &total)))
+        return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    if (end > total) end = total;
+    if (start > end) start = end;
+
+    if (which == MOVE_START) pos = start;
+    else if (which == MOVE_END) pos = end;
+    else pos = forward ? end : start;
+
+    /* an insertion point cannot be after the final paragraph mark */
+    limit = which == MOVE_END ? total : total - 1;
+
+    if (forward)
+    {
+        if (count == tomForward) count = total;
+        while (moved < count && pos < limit && charset_has(set, text[pos]) == !until)
+        {
+            pos++;
+            moved++;
+        }
+    }
+    else
+    {
+        if (count == tomBackward) count = -total;
+        while (moved < -count && pos > 0 && charset_has(set, text[pos - 1]) == !until)
+        {
+            pos--;
+            moved++;
+        }
+        moved = -moved;
+    }
+    free(text);
+
+    switch (which)
+    {
+    case MOVE_RANGE: start = end = pos; break;
+#ifndef SG_MUTANT_CSET_ENDS
+    case MOVE_START: start = pos; if (end < pos) end = pos; break;
+    case MOVE_END:   end = pos; if (start > pos) start = pos; break;
+#else
+    case MOVE_START: start = pos; break;
+    case MOVE_END:   end = pos; break;
+#endif
+    }
+    ITextRange_SetStart(range, start);
+    ITextRange_SetEnd(range, end);
+    if (delta) *delta = moved;
+    return moved ? S_OK : S_FALSE;
+}
+
+/* Wildcard-less, case-insensitive (unless tomMatchCase) search for text in
+ * the story between from and to; a whole word match needs non-alphanumeric
+ * neighbours. Returns the offset of the first (or last) match or -1. */
+static LONG story_find(const WCHAR *story, LONG total, LONG from, LONG to, BOOL backward,
+                       const WCHAR *text, LONG flags)
+{
+    LONG len = lstrlenW(text), i, step = backward ? -1 : 1;
+
+    for (i = backward ? to - len : from; i >= from && i + len <= to; i += step)
+    {
+        if (flags & tomMatchCase ? wcsncmp(story + i, text, len) : _wcsnicmp(story + i, text, len))
+            continue;
+        if (flags & tomMatchWord)
+        {
+            if (i > 0 && iswalnum(story[i - 1])) continue;
+            if (i + len < total && iswalnum(story[i + len])) continue;
+        }
+        return i;
+    }
+    return -1;
+}
+
+enum find_place { FIND_RANGE, FIND_START, FIND_END };
+
+static HRESULT textrange_find(ITextRange *range, ME_TextEditor *editor, enum find_place where,
+                              BSTR text, LONG count, LONG flags, LONG *length)
+{
+    LONG start, end, from, to, total, found;
+    WCHAR *story;
+    HRESULT hr;
+
+    if (length) *length = 0;
+    if (!text || !*text)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = story_text(editor, &story, &total)))
+        return hr;
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    if (end > total) end = total;
+    if (start > end) start = end;
+
+    if (!count)
+    {
+        from = start;
+        to = end;
+    }
+    else if (count > 0)
+    {
+        from = end;
+        to = count == tomForward || count > total - end ? total : end + count;
+    }
+    else
+    {
+        to = start;
+        from = count == tomBackward || -count > start ? 0 : start + count;
+    }
+
+    found = story_find(story, total, from, to, count < 0, text, flags);
+    free(story);
+    if (found < 0)
+        return S_FALSE;
+
+    if (length) *length = lstrlenW(text);
+    switch (where)
+    {
+#ifndef SG_MUTANT_FIND_PLACE
+    case FIND_START: start = end = found; break;
+    case FIND_END:   start = end = found + lstrlenW(text); break;
+#else
+    case FIND_START: start = found; end = found + lstrlenW(text); break;
+    case FIND_END:   start = found; end = found + lstrlenW(text); break;
+#endif
+    default:         start = found; end = found + lstrlenW(text); break;
+    }
+    ITextRange_SetStart(range, start);
+    ITextRange_SetEnd(range, end);
+    return S_OK;
+}
+
