+static const struct ISoftwareBitmapNativeFactoryVtbl nativef_vtbl =
+{
+    nativef_QueryInterface, nativef_AddRef, nativef_Release, nativef_GetIids, nativef_GetRuntimeClassName,
+    nativef_GetTrustLevel, nativef_CreateFromWICBitmap, nativef_CreateFromMF2DBuffer2,
+};
+
+static struct factory factory =
+{
+    { &factory_vtbl },
+    { &ctor_vtbl },
+    { &statics_vtbl },
+    { &nativef_vtbl },
+};
+
+IActivationFactory *software_bitmap_factory = &factory.IActivationFactory_iface;
