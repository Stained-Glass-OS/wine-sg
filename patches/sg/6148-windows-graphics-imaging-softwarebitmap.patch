+};
+
+DEFINE_FACTORY_FORWARD( nativef, ISoftwareBitmapNativeFactory, ISoftwareBitmapNativeFactory_iface )
+
+/* a WIC bitmap's pixels in a SoftwareBitmap of the matching format (others become straight Bgra8) */
+static HRESULT WINAPI nativef_CreateFromWICBitmap( ISoftwareBitmapNativeFactory *iface, IWICBitmap *data, BOOL read_only,
+                                                   REFIID iid, void **out )
+{
+    IWICBitmapSource *source = NULL;
+    WICPixelFormatGUID format;
+    struct bitmap *impl;
+    UINT width, height, i;
+    HRESULT hr;
+
+    TRACE( "iface %p, data %p, read_only %d, iid %s, out %p.\n", iface, data, read_only, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!data) return E_INVALIDARG;
+    if (FAILED(hr = IWICBitmap_GetSize( data, &width, &height ))) return hr;
+    if (FAILED(hr = IWICBitmap_GetPixelFormat( data, &format ))) return hr;
+    for (i = 0; i < ARRAY_SIZE(wic_formats); i++)
+        if (IsEqualGUID( &format, wic_formats[i].wic )) break;
+    if (i == ARRAY_SIZE(wic_formats))
+    {
+        for (i = 0; i < ARRAY_SIZE(wic_formats); i++) if (wic_formats[i].wic == &GUID_WICPixelFormat32bppBGRA) break;
+        if (FAILED(hr = WICConvertBitmapSource( &GUID_WICPixelFormat32bppBGRA, (IWICBitmapSource *)data, &source ))) return hr;
+    }
+    else IWICBitmap_QueryInterface( data, &IID_IWICBitmapSource, (void **)&source );
+    if (width > MAX_DIMENSION || height > MAX_DIMENSION) hr = E_INVALIDARG;
+    else hr = bitmap_new( wic_formats[i].format, width, height, wic_formats[i].alpha, NULL, &impl );
+    if (SUCCEEDED(hr))
+    {
+        hr = IWICBitmapSource_CopyPixels( source, NULL, impl->stride, impl->pixels->size, impl->pixels->data );
+        impl->read_only = !!read_only;
+        IWICBitmapSource_GetResolution( source, &impl->dpi_x, &impl->dpi_y );
+        if (SUCCEEDED(hr)) hr = bitmap_QueryInterface( &impl->ISoftwareBitmap_iface, iid, out );
+        bitmap_Release( &impl->ISoftwareBitmap_iface );
+    }
+    IWICBitmapSource_Release( source );
+    return hr;
+}
+
+static HRESULT WINAPI nativef_CreateFromMF2DBuffer2( ISoftwareBitmapNativeFactory *iface, IUnknown *data, REFGUID subtype,
+                                                     UINT32 width, UINT32 height, BOOL read_only, const void *aperture,
+                                                     REFIID iid, void **out )
+{
+    FIXME( "iface %p, data %p, subtype %s stub!\n", iface, data, debugstr_guid( subtype ) );
+    if (out) *out = NULL;
+    return E_NOTIMPL;
+}
