+{
+    statics_QueryInterface, statics_AddRef, statics_Release, statics_GetIids, statics_GetRuntimeClassName,
+    statics_GetTrustLevel, statics_Copy, statics_Convert, statics_ConvertWithAlpha, statics_CreateCopyFromBuffer,
