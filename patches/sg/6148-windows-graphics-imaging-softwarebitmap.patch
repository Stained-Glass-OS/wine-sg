+    impl->IMemoryBufferReference_iface.lpVtbl = &ref_vtbl;
+    impl->IClosable_iface.lpVtbl = &refclose_vtbl;
+    impl->IMemoryBufferByteAccess_iface.lpVtbl = &bytes_vtbl;
+    impl->ref = 1;
+    IBitmapBuffer_AddRef( &(impl->buffer = buffer)->IBitmapBuffer_iface );
+    *out = &impl->IMemoryBufferReference_iface;
+    return S_OK;
+}
