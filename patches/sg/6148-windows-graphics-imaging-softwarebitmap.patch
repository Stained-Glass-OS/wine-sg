diff --git a/dlls/windows.graphics.imaging/bitmap.c b/dlls/windows.graphics.imaging/bitmap.c
new file mode 100644
index 0000000..5a2741a
--- /dev/null
+++ b/dlls/windows.graphics.imaging/bitmap.c
@@ -0,0 +1,1155 @@
+/*
+ * Windows.Graphics.Imaging.SoftwareBitmap, BitmapBuffer
+ *
+ * Copyright 2026 Stained Glass OS
+ *
