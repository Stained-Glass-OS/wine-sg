+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A SoftwareBitmap is pixels in memory: one plane of Bgra8, Rgba8, Rgba16, Gray8 or Gray16, rows
+ * packed (stride = width * bytes per pixel), with an alpha mode.  Its pixels are shared with its
+ * read-only views and reached through LockBuffer (BitmapBuffer -> IMemoryBufferReference ->
+ * IMemoryBufferByteAccess), CopyToBuffer/CopyFromBuffer, or a WIC bitmap (ISoftwareBitmapNative);
+ * a WIC bitmap becomes one through ISoftwareBitmapNativeFactory.  Convert changes between the 8-bit
+ * formats and alpha modes.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(imaging);
+
+#define MAX_DIMENSION 32768
+
+struct pixels
+{
+    LONG ref;
+    size_t size;
+    BYTE data[1];
+};
+
+static void pixels_release( struct pixels *p )
+{
+    if (p && !InterlockedDecrement( &p->ref )) free( p );
+}
+
+struct bitmap
+{
+    ISoftwareBitmap ISoftwareBitmap_iface;
+    IClosable IClosable_iface;
+    ISoftwareBitmapNative ISoftwareBitmapNative_iface;
+    LONG ref;
+    BitmapPixelFormat format;
+    BitmapAlphaMode alpha;
+    INT32 width, height;
+    UINT32 stride;
+    struct pixels *pixels;
+    boolean read_only;
+    BOOL closed;
+    DOUBLE dpi_x, dpi_y;
+};
+
+static UINT32 format_bpp( BitmapPixelFormat format )
+{
+    switch (format)
+    {
+    case BitmapPixelFormat_Bgra8:
+    case BitmapPixelFormat_Rgba8: return 4;
+    case BitmapPixelFormat_Rgba16: return 8;
+    case BitmapPixelFormat_Gray8: return 1;
+    case BitmapPixelFormat_Gray16: return 2;
+    default: return 0;
+    }
+}
+
+static const struct { BitmapPixelFormat format; BitmapAlphaMode alpha; const GUID *wic; } wic_formats[] =
+{
+    { BitmapPixelFormat_Bgra8, BitmapAlphaMode_Premultiplied, &GUID_WICPixelFormat32bppPBGRA },
+    { BitmapPixelFormat_Bgra8, BitmapAlphaMode_Straight, &GUID_WICPixelFormat32bppBGRA },
+    { BitmapPixelFormat_Bgra8, BitmapAlphaMode_Ignore, &GUID_WICPixelFormat32bppBGR },
+    { BitmapPixelFormat_Rgba8, BitmapAlphaMode_Premultiplied, &GUID_WICPixelFormat32bppPRGBA },
+    { BitmapPixelFormat_Rgba8, BitmapAlphaMode_Straight, &GUID_WICPixelFormat32bppRGBA },
+    { BitmapPixelFormat_Rgba8, BitmapAlphaMode_Ignore, &GUID_WICPixelFormat32bppRGBA },
+    { BitmapPixelFormat_Rgba16, BitmapAlphaMode_Premultiplied, &GUID_WICPixelFormat64bppPRGBA },
+    { BitmapPixelFormat_Rgba16, BitmapAlphaMode_Straight, &GUID_WICPixelFormat64bppRGBA },
+    { BitmapPixelFormat_Rgba16, BitmapAlphaMode_Ignore, &GUID_WICPixelFormat64bppRGBA },
+    { BitmapPixelFormat_Gray8, BitmapAlphaMode_Ignore, &GUID_WICPixelFormat8bppGray },
+    { BitmapPixelFormat_Gray16, BitmapAlphaMode_Ignore, &GUID_WICPixelFormat16bppGray },
+};
+
+static struct bitmap *impl_from_ISoftwareBitmap( ISoftwareBitmap *iface )
+{
+    return CONTAINING_RECORD( iface, struct bitmap, ISoftwareBitmap_iface );
+}
+
+static struct bitmap *unsafe_bitmap( ISoftwareBitmap *iface );
+
+static HRESULT WINAPI bitmap_QueryInterface( ISoftwareBitmap *iface, REFIID iid, void **out )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ISoftwareBitmap ))
+        *out = &impl->ISoftwareBitmap_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable )) *out = &impl->IClosable_iface;
+    else if (IsEqualGUID( iid, &IID_ISoftwareBitmapNative )) *out = &impl->ISoftwareBitmapNative_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI bitmap_AddRef( ISoftwareBitmap *iface )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI bitmap_Release( ISoftwareBitmap *iface )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        pixels_release( impl->pixels );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI bitmap_GetIids( ISoftwareBitmap *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p, count %p, iids %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI bitmap_GetRuntimeClassName( ISoftwareBitmap *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Graphics_Imaging_SoftwareBitmap,
+                                wcslen( RuntimeClass_Windows_Graphics_Imaging_SoftwareBitmap ), name );
+}
+
+static HRESULT WINAPI bitmap_GetTrustLevel( ISoftwareBitmap *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_BitmapPixelFormat( ISoftwareBitmap *iface, BitmapPixelFormat *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->format;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_BitmapAlphaMode( ISoftwareBitmap *iface, BitmapAlphaMode *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->alpha;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_PixelWidth( ISoftwareBitmap *iface, INT32 *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->width;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_PixelHeight( ISoftwareBitmap *iface, INT32 *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->height;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_IsReadOnly( ISoftwareBitmap *iface, boolean *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->read_only;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_put_DpiX( ISoftwareBitmap *iface, DOUBLE value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (impl->closed) return RO_E_CLOSED;
+    impl->dpi_x = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_DpiX( ISoftwareBitmap *iface, DOUBLE *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->dpi_x;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_put_DpiY( ISoftwareBitmap *iface, DOUBLE value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (impl->closed) return RO_E_CLOSED;
+    impl->dpi_y = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_get_DpiY( ISoftwareBitmap *iface, DOUBLE *value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    *value = impl->dpi_y;
+    return S_OK;
+}
+
+static HRESULT buffer_create( struct bitmap *bitmap, BitmapBufferAccessMode mode, IBitmapBuffer **out );
+
+static HRESULT WINAPI bitmap_LockBuffer( ISoftwareBitmap *iface, BitmapBufferAccessMode mode, IBitmapBuffer **value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+
+    TRACE( "iface %p, mode %d, value %p.\n", iface, mode, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (impl->closed) return RO_E_CLOSED;
+    if (mode != BitmapBufferAccessMode_Read && impl->read_only) return E_ACCESSDENIED;
+    return buffer_create( impl, mode, value );
+}
+
+static HRESULT WINAPI bitmap_CopyTo( ISoftwareBitmap *iface, ISoftwareBitmap *target )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface ), *dst;
+
+    TRACE( "iface %p, target %p.\n", iface, target );
+
+    if (!(dst = unsafe_bitmap( target ))) return E_INVALIDARG;
+    if (impl->closed || dst->closed) return RO_E_CLOSED;
+    if (dst->read_only) return E_ACCESSDENIED;
+    if (dst->format != impl->format || dst->width != impl->width || dst->height != impl->height) return E_INVALIDARG;
+    if (dst->pixels != impl->pixels) memcpy( dst->pixels->data, impl->pixels->data, impl->pixels->size );
+    return S_OK;
+}
+
+/* the bytes of an IBuffer */
+static HRESULT buffer_bytes( IBuffer *buffer, BYTE **bytes, UINT32 *length, UINT32 *capacity )
+{
+    IBufferByteAccess *access;
+    HRESULT hr;
+
+    if (!buffer) return E_INVALIDARG;
+    if (FAILED(hr = IBuffer_get_Length( buffer, length ))) return hr;
+    if (FAILED(hr = IBuffer_get_Capacity( buffer, capacity ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+    hr = access->lpVtbl->Buffer( access, bytes );
+    access->lpVtbl->Release( access );
+    return hr;
+}
+
+static HRESULT WINAPI bitmap_CopyFromBuffer( ISoftwareBitmap *iface, IBuffer *buffer )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    UINT32 length, capacity;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p.\n", iface, buffer );
+
+    if (impl->closed) return RO_E_CLOSED;
+    if (impl->read_only) return E_ACCESSDENIED;
+    if (FAILED(hr = buffer_bytes( buffer, &bytes, &length, &capacity ))) return hr;
+    if (length < impl->pixels->size) return E_INVALIDARG;
+    memcpy( impl->pixels->data, bytes, impl->pixels->size );
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_CopyToBuffer( ISoftwareBitmap *iface, IBuffer *buffer )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface );
+    UINT32 length, capacity;
+    BYTE *bytes;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p.\n", iface, buffer );
+
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = buffer_bytes( buffer, &bytes, &length, &capacity ))) return hr;
+    if (capacity < impl->pixels->size) return E_INVALIDARG;
+    memcpy( bytes, impl->pixels->data, impl->pixels->size );
+    return IBuffer_put_Length( buffer, impl->pixels->size );
+}
+
+static HRESULT bitmap_new( BitmapPixelFormat format, INT32 width, INT32 height, BitmapAlphaMode alpha,
+                           struct pixels *shared, struct bitmap **out );
+
+static HRESULT WINAPI bitmap_GetReadOnlyView( ISoftwareBitmap *iface, ISoftwareBitmap **value )
+{
+    struct bitmap *impl = impl_from_ISoftwareBitmap( iface ), *view;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = bitmap_new( impl->format, impl->width, impl->height, impl->alpha, impl->pixels, &view ))) return hr;
+    view->read_only = TRUE;
+    view->dpi_x = impl->dpi_x;
+    view->dpi_y = impl->dpi_y;
+    *value = &view->ISoftwareBitmap_iface;
+    return S_OK;
+}
+
+static const struct ISoftwareBitmapVtbl bitmap_vtbl =
+{
+    bitmap_QueryInterface,
+    bitmap_AddRef,
+    bitmap_Release,
+    bitmap_GetIids,
+    bitmap_GetRuntimeClassName,
+    bitmap_GetTrustLevel,
+    bitmap_get_BitmapPixelFormat,
+    bitmap_get_BitmapAlphaMode,
+    bitmap_get_PixelWidth,
+    bitmap_get_PixelHeight,
+    bitmap_get_IsReadOnly,
+    bitmap_put_DpiX,
+    bitmap_get_DpiX,
+    bitmap_put_DpiY,
+    bitmap_get_DpiY,
+    bitmap_LockBuffer,
+    bitmap_CopyTo,
+    bitmap_CopyFromBuffer,
+    bitmap_CopyToBuffer,
+    bitmap_GetReadOnlyView,
+};
+
+/* only our own bitmaps, recognised by their vtable */
+static struct bitmap *unsafe_bitmap( ISoftwareBitmap *iface )
+{
+    if (!iface || iface->lpVtbl != &bitmap_vtbl) return NULL;
+    return impl_from_ISoftwareBitmap( iface );
+}
+
+#define DEFINE_FORWARD( pfx, type, member ) \
+    static struct bitmap *pfx##_impl( type *iface ) { return CONTAINING_RECORD( iface, struct bitmap, member ); } \
+    static HRESULT WINAPI pfx##_QueryInterface( type *iface, REFIID iid, void **out ) \
+    { return bitmap_QueryInterface( &pfx##_impl( iface )->ISoftwareBitmap_iface, iid, out ); } \
+    static ULONG WINAPI pfx##_AddRef( type *iface ) { return bitmap_AddRef( &pfx##_impl( iface )->ISoftwareBitmap_iface ); } \
+    static ULONG WINAPI pfx##_Release( type *iface ) { return bitmap_Release( &pfx##_impl( iface )->ISoftwareBitmap_iface ); } \
+    static HRESULT WINAPI pfx##_GetIids( type *iface, ULONG *count, IID **iids ) \
+    { return bitmap_GetIids( &pfx##_impl( iface )->ISoftwareBitmap_iface, count, iids ); } \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( type *iface, HSTRING *name ) \
+    { return bitmap_GetRuntimeClassName( &pfx##_impl( iface )->ISoftwareBitmap_iface, name ); } \
+    static HRESULT WINAPI pfx##_GetTrustLevel( type *iface, TrustLevel *level ) \
+    { return bitmap_GetTrustLevel( &pfx##_impl( iface )->ISoftwareBitmap_iface, level ); }
+
+DEFINE_FORWARD( closable, IClosable, IClosable_iface )
+
+static HRESULT WINAPI closable_Close( IClosable *iface )
+{
+    struct bitmap *impl = closable_impl( iface );
+
+    TRACE( "iface %p.\n", iface );
+    impl->closed = TRUE;
+    return S_OK;
+}
+
+static const struct IClosableVtbl closable_vtbl =
+{
+    closable_QueryInterface, closable_AddRef, closable_Release,
+    closable_GetIids, closable_GetRuntimeClassName, closable_GetTrustLevel,
+    closable_Close,
+};
+
+static HRESULT wic_factory( IWICImagingFactory **out )
+{
+    return WICCreateImagingFactory_Proxy( WINCODEC_SDK_VERSION, out );
+}
+
+DEFINE_FORWARD( native, ISoftwareBitmapNative, ISoftwareBitmapNative_iface )
+
+/* a WIC bitmap of the pixels (a copy) */
+static HRESULT WINAPI native_GetData( ISoftwareBitmapNative *iface, REFIID iid, void **out )
+{
+    struct bitmap *impl = native_impl( iface );
+    IWICImagingFactory *factory;
+    IWICBitmap *wic = NULL;
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (impl->closed) return RO_E_CLOSED;
+    for (i = 0; i < ARRAY_SIZE(wic_formats); i++)
+        if (wic_formats[i].format == impl->format && wic_formats[i].alpha == impl->alpha) break;
+    if (i == ARRAY_SIZE(wic_formats)) return E_NOTIMPL;
+    if (FAILED(hr = wic_factory( &factory ))) return hr;
+    hr = IWICImagingFactory_CreateBitmapFromMemory( factory, impl->width, impl->height, wic_formats[i].wic, impl->stride,
+                                                    impl->pixels->size, impl->pixels->data, &wic );
+    IWICImagingFactory_Release( factory );
+    if (FAILED(hr)) return hr;
+    hr = IWICBitmap_QueryInterface( wic, iid, out );
+    IWICBitmap_Release( wic );
+    return hr;
+}
+
+static const struct ISoftwareBitmapNativeVtbl native_vtbl =
+{
+    native_QueryInterface, native_AddRef, native_Release,
+    native_GetIids, native_GetRuntimeClassName, native_GetTrustLevel,
+    native_GetData,
+};
+
+static HRESULT bitmap_new( BitmapPixelFormat format, INT32 width, INT32 height, BitmapAlphaMode alpha,
+                           struct pixels *shared, struct bitmap **out )
+{
+    UINT32 bpp = format_bpp( format );
+    struct bitmap *impl;
+    size_t size;
+
+    *out = NULL;
+    if (!bpp)
+    {
+        FIXME( "pixel format %d\n", format );
+        return E_INVALIDARG;
+    }
+    if (width <= 0 || height <= 0 || width > MAX_DIMENSION || height > MAX_DIMENSION) return E_INVALIDARG;
+    if (alpha != BitmapAlphaMode_Premultiplied && alpha != BitmapAlphaMode_Straight && alpha != BitmapAlphaMode_Ignore)
+        return E_INVALIDARG;
+    /* gray formats have no alpha */
+    if ((format == BitmapPixelFormat_Gray8 || format == BitmapPixelFormat_Gray16) && alpha != BitmapAlphaMode_Ignore)
+        return E_INVALIDARG;
+    size = (size_t)width * height * bpp;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (shared) InterlockedIncrement( &(impl->pixels = shared)->ref );
+    else if (!(impl->pixels = calloc( 1, offsetof(struct pixels, data[size]) )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    else
+    {
+        impl->pixels->ref = 1;
+        impl->pixels->size = size;
+    }
+    impl->ISoftwareBitmap_iface.lpVtbl = &bitmap_vtbl;
+    impl->IClosable_iface.lpVtbl = &closable_vtbl;
+    impl->ISoftwareBitmapNative_iface.lpVtbl = &native_vtbl;
+    impl->ref = 1;
+    impl->format = format;
+    impl->alpha = alpha;
+    impl->width = width;
+    impl->height = height;
+    impl->stride = width * bpp;
+    impl->dpi_x = impl->dpi_y = 96.0;
+    *out = impl;
+    return S_OK;
+}
+
+/* ---- conversion between formats and alpha modes ---- */
+
+static BYTE mul_div( BYTE v, BYTE a ) { return (v * a + 127) / 255; }
+static BYTE div_mul( BYTE v, BYTE a ) { return a ? min( 255, (v * 255 + a / 2) / a ) : 0; }
+
+/* one pixel to straight BGRA */
+static void read_pixel( const struct bitmap *b, const BYTE *p, BYTE bgra[4] )
+{
+    switch (b->format)
+    {
+    case BitmapPixelFormat_Bgra8: memcpy( bgra, p, 4 ); break;
+    case BitmapPixelFormat_Rgba8: bgra[0] = p[2]; bgra[1] = p[1]; bgra[2] = p[0]; bgra[3] = p[3]; break;
+    case BitmapPixelFormat_Rgba16: bgra[0] = p[5]; bgra[1] = p[3]; bgra[2] = p[1]; bgra[3] = p[7]; break;
+    case BitmapPixelFormat_Gray8: bgra[0] = bgra[1] = bgra[2] = p[0]; bgra[3] = 255; break;
+    case BitmapPixelFormat_Gray16: bgra[0] = bgra[1] = bgra[2] = p[1]; bgra[3] = 255; break;
+    default: memset( bgra, 0, 4 ); break;
+    }
+    if (b->alpha == BitmapAlphaMode_Premultiplied)
+    {
+        bgra[0] = div_mul( bgra[0], bgra[3] );
+        bgra[1] = div_mul( bgra[1], bgra[3] );
+        bgra[2] = div_mul( bgra[2], bgra[3] );
+    }
+    else if (b->alpha == BitmapAlphaMode_Ignore) bgra[3] = 255;
+}
+
+static void write_pixel( const struct bitmap *b, BYTE *p, const BYTE straight[4] )
+{
+    BYTE bgra[4];
+
+    memcpy( bgra, straight, 4 );
+    if (b->alpha == BitmapAlphaMode_Premultiplied)
+    {
+        bgra[0] = mul_div( bgra[0], bgra[3] );
+        bgra[1] = mul_div( bgra[1], bgra[3] );
+        bgra[2] = mul_div( bgra[2], bgra[3] );
+    }
+    switch (b->format)
+    {
+    case BitmapPixelFormat_Bgra8: memcpy( p, bgra, 4 ); break;
+    case BitmapPixelFormat_Rgba8: p[0] = bgra[2]; p[1] = bgra[1]; p[2] = bgra[0]; p[3] = bgra[3]; break;
+    case BitmapPixelFormat_Rgba16:
+        p[0] = p[1] = bgra[2]; p[2] = p[3] = bgra[1]; p[4] = p[5] = bgra[0]; p[6] = p[7] = bgra[3];
+        break;
+    case BitmapPixelFormat_Gray8: p[0] = (bgra[2] * 77 + bgra[1] * 150 + bgra[0] * 29 + 128) >> 8; break;
+    case BitmapPixelFormat_Gray16: p[0] = p[1] = (bgra[2] * 77 + bgra[1] * 150 + bgra[0] * 29 + 128) >> 8; break;
+    default: break;
+    }
+}
+
+static HRESULT convert( struct bitmap *src, BitmapPixelFormat format, BitmapAlphaMode alpha, ISoftwareBitmap **value )
+{
+    UINT32 src_bpp = format_bpp( src->format ), dst_bpp = format_bpp( format );
+    struct bitmap *dst;
+    size_t i, count;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (src->closed) return RO_E_CLOSED;
+    if (FAILED(hr = bitmap_new( format, src->width, src->height, alpha, NULL, &dst ))) return hr;
+    dst->dpi_x = src->dpi_x;
+    dst->dpi_y = src->dpi_y;
+    count = (size_t)src->width * src->height;
+    if (src->format == format && src->alpha == alpha) memcpy( dst->pixels->data, src->pixels->data, src->pixels->size );
+    else
+    {
+        for (i = 0; i < count; i++)
+        {
+            BYTE bgra[4];
+            read_pixel( src, src->pixels->data + i * src_bpp, bgra );
+            write_pixel( dst, dst->pixels->data + i * dst_bpp, bgra );
+        }
+    }
+    *value = &dst->ISoftwareBitmap_iface;
+    return S_OK;
+}
