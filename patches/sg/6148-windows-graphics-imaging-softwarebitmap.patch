+/* the bitmap's pixels: written through it unless the buffer was locked for reading (the caller's
+ * promise; the pixels are not copied) */
+static HRESULT WINAPI bytes_GetBuffer( IMemoryBufferByteAccess *iface, BYTE **value, UINT32 *capacity )
+{
+    struct reference *impl = bytes_impl( iface );
+
+    if (!value || !capacity) return E_POINTER;
+    if (impl->closed || impl->buffer->closed)
+    {
+        *value = NULL;
+        *capacity = 0;
+        return RO_E_CLOSED;
+    }
+#ifdef SG_MUTANT_BITMAP_NO_BUFFER
+    *value = NULL;
+    *capacity = 0;
+    return S_OK;
+#endif
+    *value = impl->buffer->impl->pixels->data;
+    *capacity = impl->buffer->impl->pixels->size;
+    return S_OK;
+}
