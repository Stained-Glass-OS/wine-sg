+static HRESULT WINAPI statics_Convert( ISoftwareBitmapStatics *iface, ISoftwareBitmap *source, BitmapPixelFormat format,
+                                       ISoftwareBitmap **value )
+{
+    BitmapAlphaMode alpha = format == BitmapPixelFormat_Gray8 || format == BitmapPixelFormat_Gray16
+                            ? BitmapAlphaMode_Ignore : BitmapAlphaMode_Premultiplied;
+    return statics_ConvertWithAlpha( iface, source, format, alpha, value );
+}
+
+static HRESULT WINAPI statics_CreateCopyWithAlphaFromBuffer( ISoftwareBitmapStatics *iface, IBuffer *source, BitmapPixelFormat format,
+                                                             INT32 width, INT32 height, BitmapAlphaMode alpha,
+                                                             ISoftwareBitmap **value )
+{
+    struct bitmap *impl;
+    HRESULT hr;
+
+    TRACE( "iface %p, source %p, format %d, size %dx%d, alpha %d, value %p.\n", iface, source, format, width, height, alpha, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = bitmap_new( format, width, height, alpha, NULL, &impl ))) return hr;
+    if (FAILED(hr = bitmap_CopyFromBuffer( &impl->ISoftwareBitmap_iface, source )))
+    {
+        bitmap_Release( &impl->ISoftwareBitmap_iface );
+        return hr;
+    }
+    *value = &impl->ISoftwareBitmap_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_CreateCopyFromBuffer( ISoftwareBitmapStatics *iface, IBuffer *source, BitmapPixelFormat format,
+                                                    INT32 width, INT32 height, ISoftwareBitmap **value )
+{
+    BitmapAlphaMode alpha = format == BitmapPixelFormat_Gray8 || format == BitmapPixelFormat_Gray16
+                            ? BitmapAlphaMode_Ignore : BitmapAlphaMode_Premultiplied;
+    return statics_CreateCopyWithAlphaFromBuffer( iface, source, format, width, height, alpha, value );
+}
+
+static HRESULT WINAPI statics_CreateCopyFromSurfaceAsync( ISoftwareBitmapStatics *iface, IDirect3DSurface *surface,
+                                                          IAsyncOperation_SoftwareBitmap **value )
+{
+    FIXME( "iface %p, surface %p, value %p stub!\n", iface, surface, value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI statics_CreateCopyWithAlphaFromSurfaceAsync( ISoftwareBitmapStatics *iface, IDirect3DSurface *surface,
+                                                                   BitmapAlphaMode alpha, IAsyncOperation_SoftwareBitmap **value )
+{
+    FIXME( "iface %p, surface %p, alpha %d, value %p stub!\n", iface, surface, alpha, value );
+    return E_NOTIMPL;
+}
