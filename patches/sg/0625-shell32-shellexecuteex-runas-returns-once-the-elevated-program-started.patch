From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: ShellExecuteEx runas returns once the elevated program has started

Windows' ShellExecuteEx "runas" returns after the consent and the elevated
program's start. Here it returned at once, with rundll32's SgElevate (which
asks the broker) just started: Total Commander's installer then connects to
its elevated copy's pipe, retried for a few seconds while the consent prompt
was still up, and gave up ("Failed to connect to elevated process!"). Now
SgElevate hands sg-elevate --ready FILE (where /usr/share/stained-glass/
sg-elevate.features says it can), watches the file for the broker's answer and
sets an event; ShellExecuteEx waits for it, or for SgElevate to end, up to
three minutes.
---
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -320,7 +320,9 @@
                                    STARTUPINFOW *startup, PROCESS_INFORMATION *info )
 {
     WCHAR broker[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-elevate", *broker_cmd, *p;
-    WCHAR rundll[MAX_PATH];
+    WCHAR rundll[MAX_PATH], ready_name[64];
+    static LONG ready_count;
+    HANDLE ready;
     BOOL ret;
 
     if (GetEnvironmentVariableW( L"SG_IN_BROKER", NULL, 0 )) return FALSE;
@@ -339,12 +341,40 @@
      * waits for the elevated program, and ends with its code. */
     GetSystemDirectoryW( rundll, MAX_PATH - 32 );
     wcscat( rundll, L"\\rundll32.exe" );
-    if (!(broker_cmd = malloc( (wcslen( rundll ) + wcslen( L" shell32.dll,SgElevate " ) + wcslen( lpCmd ) + 1) * sizeof(WCHAR) ))) return FALSE;
+    /* ShellExecuteEx returns once the elevated program has started (or the
+     * person said no), as Windows' does: an installer that connects to its
+     * elevated copy straight after (Total Commander's, by a pipe the copy
+     * makes) gave up while the consent prompt was still up. SgElevate sets
+     * the event when the broker answers. */
+    swprintf( ready_name, ARRAY_SIZE(ready_name), L"Local\\SgElevateReady-%lx-%lx",
+              GetCurrentProcessId(), InterlockedIncrement( &ready_count ) );
+    ready = CreateEventW( NULL, TRUE, FALSE, ready_name );
+    if (!(broker_cmd = malloc( (wcslen( rundll ) + wcslen( L" shell32.dll,SgElevate " ) + wcslen( ready_name ) + 16 +
+                                wcslen( lpCmd ) + 1) * sizeof(WCHAR) )))
+    {
+        if (ready) CloseHandle( ready );
+        return FALSE;
+    }
     wcscpy( broker_cmd, rundll );
     wcscat( broker_cmd, L" shell32.dll,SgElevate " );
+    if (ready)
+    {
+        wcscat( broker_cmd, L"/sgready:" );
+        wcscat( broker_cmd, ready_name );
+        wcscat( broker_cmd, L" " );
+    }
     wcscat( broker_cmd, lpCmd );
     ret = CreateProcessW( rundll, broker_cmd, NULL, NULL, FALSE, flags, env, NULL, startup, info );
     free( broker_cmd );
+#ifndef SG_MUTANT_NOREADYWAIT
+    if (ret && ready)
+    {
+        /* the prompt waits two minutes for an answer; then the launch */
+        HANDLE handles[2] = { ready, info->hProcess };
+        WaitForMultipleObjects( 2, handles, FALSE, 180000 );
+    }
+#endif
+    if (ready) CloseHandle( ready );
     return ret;
 }
 
@@ -355,10 +385,69 @@
  * elevated through sg-elevate (the broker's client, a Unix program), waits for
  * it and ends with its exit code. See sg_execute_via_broker.
  */
+/* sg-elevate --ready, when the installed one has it (SG_ELEVATE_FEATURES:
+ * a stand-in's list, an absolute Unix path, for gates) */
+static BOOL sg_elevate_supports_ready(void)
+{
+    WCHAR path[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\share\\stained-glass\\sg-elevate.features", *p;
+    char buf[256];
+    DWORD got = 0;
+    HANDLE f;
+
+    if (GetEnvironmentVariableW( L"SG_ELEVATE_FEATURES", path + 8, MAX_PATH ) && path[8] == '/')
+        for (p = path + 8; *p; p++) if (*p == '/') *p = '\\';
+    f = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (f == INVALID_HANDLE_VALUE) return FALSE;
+    ReadFile( f, buf, sizeof(buf) - 1, &got, NULL );
+    CloseHandle( f );
+    buf[got] = 0;
+    return strstr( buf, "ready" ) != NULL;
+}
+
+/* a new, empty file for sg-elevate's answer; its Unix name in UNIX */
+static const WCHAR *sg_ready_file( char *unix_name, DWORD size )
+{
+    static WCHAR path[MAX_PATH];
+    WCHAR dir[MAX_PATH];
+    char *name;
+
+    if (!GetTempPathW( MAX_PATH, dir ) || !GetTempFileNameW( dir, L"sge", 0, path )) return NULL;
+    if (!(name = wine_get_unix_file_name( path )) || strlen( name ) >= size)
+    {
+        HeapFree( GetProcessHeap(), 0, name );
+        DeleteFileW( path );
+        return NULL;
+    }
+    strcpy( unix_name, name );
+    HeapFree( GetProcessHeap(), 0, name );
+    return path;
+}
+
+struct sg_ready { HANDLE event; WCHAR file[MAX_PATH]; };
+
+/* the broker's answer arrives in the file: tell ShellExecuteEx */
+static DWORD WINAPI sg_ready_thread( void *arg )
+{
+    struct sg_ready *r = arg;
+    WIN32_FILE_ATTRIBUTE_DATA data;
+    int i;
+
+    for (i = 0; i < 3000; i++)   /* five minutes */
+    {
+        if (GetFileAttributesExW( r->file, GetFileExInfoStandard, &data ) && data.nFileSizeLow) break;
+        Sleep( 100 );
+    }
+    SetEvent( r->event );
+    DeleteFileW( r->file );
+    return 0;
+}
+
 void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
 {
     LONG (WINAPI *spawnvp)( char * const argv[], int wait );
     char broker[MAX_PATH * 3] = "/usr/libexec/stained-glass/sg-elevate", **argv;
+    char ready_unix[MAX_PATH * 3];
+    const WCHAR *ready_path;
     WCHAR **args, value[MAX_PATH];
     int count = 0, i, len, n;
     WCHAR ** (WINAPI *to_argv)( const WCHAR *, int * );
@@ -369,10 +458,30 @@
     if (!spawnvp || !to_argv || !cmdline || !*cmdline || !(args = to_argv( cmdline, &count ))) ExitProcess( 2 );
     if (GetEnvironmentVariableW( L"SG_ELEVATE", value, MAX_PATH ) && value[0] == '/')
         WideCharToMultiByte( CP_UNIXCP, 0, value, -1, broker, sizeof(broker), NULL, NULL );
-    if (!(argv = calloc( count + 3, sizeof(*argv) ))) ExitProcess( 2 );
+    if (!(argv = calloc( count + 5, sizeof(*argv) ))) ExitProcess( 2 );
     argv[0] = broker;
-    argv[1] = (char *)"--wine";
-    for (i = 0, n = 2; i < count; i++)
+    n = 1;
+    i = 0;
+    /* /sgready:NAME (sg_execute_via_broker): the event to set when the
+     * broker answers -- told by sg-elevate --ready, where it supports it */
+    if (count > 0 && !wcsnicmp( args[0], L"/sgready:", 9 ))
+    {
+        if (sg_elevate_supports_ready() && (ready_path = sg_ready_file( ready_unix, sizeof(ready_unix) )))
+        {
+            struct sg_ready *r = malloc( sizeof(*r) );
+            if (r && (r->event = OpenEventW( EVENT_MODIFY_STATE, FALSE, args[0] + 9 )))
+            {
+                lstrcpynW( r->file, ready_path, MAX_PATH );
+                CloseHandle( CreateThread( NULL, 0, sg_ready_thread, r, 0, NULL ) );
+                argv[n++] = (char *)"--ready";
+                argv[n++] = ready_unix;
+            }
+            else free( r );
+        }
+        i = 1;
+    }
+    argv[n++] = (char *)"--wine";
+    for (; i < count; i++)
     {
         /* NSIS's UAC plugin (Firefox's installer, many others) starts itself
          * elevated with /UAC:<window> and has the elevated copy call back to
