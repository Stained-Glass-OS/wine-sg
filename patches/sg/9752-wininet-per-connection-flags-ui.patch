From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wininet: the per-connection option INTERNET_PER_CONN_FLAGS_UI

Firefox, Thunderbird and Pale Moon read the system proxy settings with
INTERNET_PER_CONN_FLAGS_UI (10) first; Wine did not know the option ('Unknown dwOption
10'), so the whole option list failed with ERROR_INVALID_PARAMETER and they had to
ask again; setting it was silently ignored. On Windows it is the connection's flags
as the Internet Options dialog shows them: it reads and sets the same flags as
INTERNET_PER_CONN_FLAGS, for the process's settings and a session's, and converts
between the A and W lists like it.

Gate: test/proxyflagsui-gate.sh; mutant SG_MUTANT_NO_FLAGS_UI.
---
--- a/include/wininet.h
+++ b/include/wininet.h
@@ -347,6 +347,7 @@
 #define INTERNET_PER_CONN_AUTOCONFIG_RELOAD_DELAY_MINS 7
 #define INTERNET_PER_CONN_AUTOCONFIG_LAST_DETECT_TIME  8
 #define INTERNET_PER_CONN_AUTOCONFIG_LAST_DETECT_URL   9
+#define INTERNET_PER_CONN_FLAGS_UI                     10
 
 /* Values for INTERNET_PER_CONN_FLAGS */
 #define PROXY_TYPE_DIRECT         0x00000001
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -1284,6 +1284,9 @@
             INTERNET_PER_CONN_OPTIONA *optionA = conA->pOptions + i;
 
             switch (optionW->dwOption) {
+#ifndef SG_MUTANT_NO_FLAGS_UI
+            case INTERNET_PER_CONN_FLAGS_UI:  /* as the Internet Options UI shows it: the same flags (wine-sg 9752) */
+#endif
             case INTERNET_PER_CONN_FLAGS:
                 optionW->Value.dwValue = global_proxy.flags;
                 break;
@@ -1403,6 +1406,9 @@
                 global_proxy.proxy = wcsdup(option->Value.pszValue);
                 break;
 
+#ifndef SG_MUTANT_NO_FLAGS_UI
+            case INTERNET_PER_CONN_FLAGS_UI:  /* as the Internet Options UI shows it: the same flags (wine-sg 9752) */
+#endif
             case INTERNET_PER_CONN_FLAGS:
                 if(option->Value.dwValue & ~(PROXY_TYPE_PROXY | PROXY_TYPE_DIRECT))
                     FIXME("Unhandled flags: 0x%lx\n", option->Value.dwValue);
@@ -3253,6 +3259,9 @@
             INTERNET_PER_CONN_OPTIONA *optionA = conA->pOptions + i;
 
             switch (optionW->dwOption) {
+#ifndef SG_MUTANT_NO_FLAGS_UI
+            case INTERNET_PER_CONN_FLAGS_UI:  /* as the Internet Options UI shows it: the same flags (wine-sg 9752) */
+#endif
             case INTERNET_PER_CONN_FLAGS:
                 optionW->Value.dwValue = pi.flags;
                 break;
@@ -3919,6 +3928,9 @@
                 pi.proxy = wcsdup(option->Value.pszValue);
                 break;
 
+#ifndef SG_MUTANT_NO_FLAGS_UI
+            case INTERNET_PER_CONN_FLAGS_UI:  /* as the Internet Options UI shows it: the same flags (wine-sg 9752) */
+#endif
             case INTERNET_PER_CONN_FLAGS:
                 if(option->Value.dwValue & ~(PROXY_TYPE_PROXY | PROXY_TYPE_DIRECT))
                     FIXME("Unhandled flags: 0x%lx\n", option->Value.dwValue);
@@ -4064,6 +4076,9 @@
                     optW->Value.pszValue = NULL;
                 break;
             case INTERNET_PER_CONN_AUTODISCOVERY_FLAGS:
+#ifndef SG_MUTANT_NO_FLAGS_UI
+            case INTERNET_PER_CONN_FLAGS_UI:  /* as the Internet Options UI shows it: the same flags (wine-sg 9752) */
+#endif
             case INTERNET_PER_CONN_FLAGS:
             case INTERNET_PER_CONN_AUTOCONFIG_RELOAD_DELAY_MINS:
                 optW->Value.dwValue = optA->Value.dwValue;
