From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, shell32: an elevated program's full exit code reaches its requester

A Unix exit status has eight bits: the elevation broker, which waits for the
Unix process of an elevated program, saw an installer's 1223 (REAPER's success
code) as 199 and 3010 as 194, and the Store called a good install a failure.
ntdll: SG_EXIT_CODE_FILE (an absolute Unix path) in the Unix environment of the
process the wine loader starts gets its full exit code, as decimal, when it
ends (exit_process and abort_process, before the eight-bit _exit); the
variable is taken out of the Unix and Windows environments at once, so no
child inherits it. shell32's SgElevate relay: when sg-elevate's features list
"code", it passes --code FILE and ends with the code found there, else with
sg-elevate's status as before. sg-session's half (sg-elevated-run, sg-elevate,
the features file) is separate; either half works with an old other.
---
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index 624d77c..1db48af 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -2201,6 +2201,42 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params( void **module )
 /*************************************************************************
  *		init_startup_info
  */
+/* Stained Glass OS: SG_EXIT_CODE_FILE (an absolute Unix path) in the Unix
+ * environment of the process the wine loader starts asks for its full exit
+ * code in that file when it ends. A Unix exit status has eight bits, so the
+ * elevation broker (sg-elevated-run), which waits for the Unix process, saw an
+ * installer's 1223 (REAPER's success code) as 199 and 3010 as 194. Taken out
+ * of the Unix and Windows environments at once, so no child process inherits
+ * it and writes over the file. */
+static char sg_exit_code_file[1024];
+
+static void sg_take_exit_code_file(void)
+{
+    const char *path = getenv( "SG_EXIT_CODE_FILE" );
+
+#ifdef SG_MUTANT_NO_EXIT_CODE_FILE
+    return;
+#endif
+    if (!path) return;
+    if (path[0] == '/' && strlen( path ) < sizeof(sg_exit_code_file)) strcpy( sg_exit_code_file, path );
+    unsetenv( "SG_EXIT_CODE_FILE" );
+}
+
+/* called where the process's exit code is final, before the eight-bit _exit */
+void sg_write_exit_code( int status )
+{
+    char buf[16];
+    int fd, len;
+
+    if (!sg_exit_code_file[0]) return;
+    len = snprintf( buf, sizeof(buf), "%u\n", (unsigned int)status );
+    fd = open( sg_exit_code_file, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0600 );
+    if (fd == -1) return;
+    if (write( fd, buf, len ) != len) { /* nothing to say */ }
+    close( fd );
+    sg_exit_code_file[0] = 0;
+}
+
 void init_startup_info(void)
 {
     WCHAR *src, *dst, *env, *image;
@@ -2213,6 +2249,7 @@ void init_startup_info(void)
 
     if (!startup_info_size)
     {
+        sg_take_exit_code_file();  /* before the Windows environment is built from the Unix one */
         params = build_initial_params( &module );
         init_peb( params, module );
         return;
diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index 4801acb..1b782b9 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1447,6 +1447,7 @@ void abort_thread( int status )
  */
 void abort_process( int status )
 {
+    sg_write_exit_code( status );
     _exit( get_unix_exit_code( status ));
 }
 
@@ -1483,6 +1484,7 @@ static DECLSPEC_NORETURN void exit_thread( int status )
 void exit_process( int status )
 {
     pthread_sigmask( SIG_BLOCK, &server_block_set, NULL );
+    sg_write_exit_code( status );
     process_exit_wrapper( get_unix_exit_code( status ));
 }
 
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index 4ed585f..7e32f11 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -197,6 +197,7 @@ extern struct ldt_copy __wine_ldt_copy;
 
 extern void init_environment(void);
 extern void init_startup_info(void);
+extern void sg_write_exit_code( int status );
 extern void *create_startup_info( const UNICODE_STRING *nt_image, ULONG process_flags,
                                   const RTL_USER_PROCESS_PARAMETERS *params,
                                   const struct pe_image_info *pe_info, DWORD *info_size );
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index 9dd691e..3a8523e 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -524,10 +524,12 @@ static BOOL sg_execute_via_broker( const WCHAR *lpCmd, DWORD flags, void *env,
  */
 /* sg-elevate --ready, when the installed one has it (SG_ELEVATE_FEATURES:
  * a stand-in's list, an absolute Unix path, for gates) */
-static BOOL sg_elevate_supports_ready(void)
+/* whether the features file lists WORD on a line of its own (one feature per
+ * line: "ready", "code") */
+static BOOL sg_elevate_has_feature( const char *word )
 {
     WCHAR path[MAX_PATH + 16] = L"\\\\?\\unix\\usr\\share\\stained-glass\\sg-elevate.features", *p;
-    char buf[256];
+    char buf[1024], *line, *end;
     DWORD got = 0;
     HANDLE f;
 
@@ -538,7 +540,38 @@ static BOOL sg_elevate_supports_ready(void)
     ReadFile( f, buf, sizeof(buf) - 1, &got, NULL );
     CloseHandle( f );
     buf[got] = 0;
-    return strstr( buf, "ready" ) != NULL;
+    for (line = buf; *line; line = *end ? end + 1 : end)
+    {
+        char *start = line + strspn( line, " \t" ), *last;
+
+        end = line + strcspn( line, "\r\n" );
+        for (last = end; last > start && (last[-1] == ' ' || last[-1] == '\t'); last--) ;
+        if (last - start == strlen( word ) && !strncmp( start, word, last - start )) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL sg_elevate_supports_ready(void)
+{
+    return sg_elevate_has_feature( "ready" );
+}
+
+/* a new, empty file for an answer of sg-elevate's, in PATH; its Unix name in UNIX */
+static const WCHAR *sg_answer_file( WCHAR *path, const WCHAR *prefix, char *unix_name, DWORD size )
+{
+    WCHAR dir[MAX_PATH];
+    char *name;
+
+    if (!GetTempPathW( MAX_PATH, dir ) || !GetTempFileNameW( dir, prefix, 0, path )) return NULL;
+    if (!(name = wine_get_unix_file_name( path )) || strlen( name ) >= size)
+    {
+        HeapFree( GetProcessHeap(), 0, name );
+        DeleteFileW( path );
+        return NULL;
+    }
+    strcpy( unix_name, name );
+    HeapFree( GetProcessHeap(), 0, name );
+    return path;
 }
 
 /* a new, empty file for sg-elevate's answer; its Unix name in UNIX */
@@ -604,8 +637,9 @@ void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
 {
     LONG (WINAPI *spawnvp)( char * const argv[], int wait );
     char broker[MAX_PATH * 3] = "/usr/libexec/stained-glass/sg-elevate", **argv;
-    char ready_unix[MAX_PATH * 3];
-    const WCHAR *ready_path;
+    char ready_unix[MAX_PATH * 3], code_unix[MAX_PATH * 3];
+    const WCHAR *ready_path, *code_path = NULL;
+    WCHAR code_file[MAX_PATH];
     struct sg_ready *ready = NULL;
     WCHAR **args, value[MAX_PATH];
     int count = 0, i, len, n;
@@ -617,7 +651,7 @@ void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
     if (!spawnvp || !to_argv || !cmdline || !*cmdline || !(args = to_argv( cmdline, &count ))) ExitProcess( 2 );
     if (GetEnvironmentVariableW( L"SG_ELEVATE", value, MAX_PATH ) && value[0] == '/')
         WideCharToMultiByte( CP_UNIXCP, 0, value, -1, broker, sizeof(broker), NULL, NULL );
-    if (!(argv = calloc( count + 5, sizeof(*argv) ))) ExitProcess( 2 );
+    if (!(argv = calloc( count + 7, sizeof(*argv) ))) ExitProcess( 2 );
     argv[0] = broker;
     n = 1;
     i = 0;
@@ -641,6 +675,16 @@ void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
         }
         i = 1;
     }
+    /* --code FILE: the elevated program's full exit code, which sg-elevate's
+     * own eight-bit exit status cannot carry (an installer's 1223 or 3010) */
+#ifndef SG_MUTANT_RELAY_IGNORES_CODE
+    if (sg_elevate_has_feature( "code" ) &&
+        (code_path = sg_answer_file( code_file, L"sgc", code_unix, sizeof(code_unix) )))
+    {
+        argv[n++] = (char *)"--code";
+        argv[n++] = code_unix;
+    }
+#endif
     argv[n++] = (char *)"--wine";
     for (; i < count; i++)
     {
@@ -667,9 +711,36 @@ void WINAPI SgElevateW( HWND hwnd, HINSTANCE inst, LPWSTR cmdline, INT show )
     {
         char answer = (char)ready->answer;
         if (!answer) answer = sg_ready_answer( ready->file );
-        if (answer == '1') ExitProcess( ERROR_CANCELLED );
+        if (answer == '1')
+        {
+            if (code_path) DeleteFileW( code_path );
+            ExitProcess( ERROR_CANCELLED );
+        }
     }
 #endif
+    if (code_path)
+    {
+        /* the program's own code, when sg-elevate wrote one (decimal) */
+        HANDLE f = CreateFileW( code_path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                NULL, OPEN_EXISTING, 0, NULL );
+        char buf[32];
+        DWORD got = 0;
+        BOOL have = FALSE;
+        unsigned int code = 0;
+
+        if (f != INVALID_HANDLE_VALUE)
+        {
+            if (ReadFile( f, buf, sizeof(buf) - 1, &got, NULL ) && got)
+            {
+                char *p = buf;
+                buf[got] = 0;
+                while (*p >= '0' && *p <= '9') { code = code * 10 + (*p - '0'); have = TRUE; p++; }
+            }
+            CloseHandle( f );
+        }
+        DeleteFileW( code_path );
+        if (have && ret >= 0 && ret <= 255) ExitProcess( code );
+    }
     /* an exit status, or an NTSTATUS if sg-elevate could not be started */
     ExitProcess( ret > 255 ? 2 : ret );
 }
