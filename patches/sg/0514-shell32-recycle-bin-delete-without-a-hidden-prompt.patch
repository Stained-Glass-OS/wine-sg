+/* Stained Glass OS: create a directory and any missing parents. A new
+ * profile (or a live session) has no ~/.local/share yet: creating only the
+ * last component failed, the Recycle Bin counted as unavailable, and Delete
+ * fell back to deleting for good behind a prompt. */
+static void create_dir_path( WCHAR *path )
+{
+    WCHAR *p = path + 4;  /* past \\?\ */
+
+    while ((p = wcschr( p + 1, '\\' )))
+    {
+        *p = 0;
+        CreateDirectoryW( path, NULL );
+        *p = '\\';
+    }
+    CreateDirectoryW( path, NULL );
+}
+
 static BOOL WINAPI init_trash_dirs( INIT_ONCE *once, void *param, void **context )
 {
     const WCHAR *home = _wgetenv( L"WINEHOMEDIR" );
@@ -118,7 +135,7 @@
         swprintf( files, len, fmt, home );
         files[1] = '\\';  /* change \??\ to \\?\ */
         for (p = files; *p; p++) if (*p == '/') *p = '\\';
-        CreateDirectoryW( files, NULL );
+        create_dir_path( files );
         info = malloc( len * sizeof(WCHAR) );
         lstrcpyW( info, files );
         lstrcatW( files, L"\\files" );
