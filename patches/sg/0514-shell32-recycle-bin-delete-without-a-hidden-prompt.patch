From: Stained Glass OS <ke7oxh@gmail.com>
Subject: shell32: right-click Delete moves to the Recycle Bin without a hidden prompt

File Explorer's right-click Delete (the folder view's "delete" verb,
ISFHelper::DeleteItems) did nothing visible. Two causes:

- SHFileOperation asked "move to the Recycle Bin?" whenever
  FOF_NOCONFIRMATION was absent; the prompt, owned by GetActiveWindow(),
  often sat hidden behind the window. Windows 10 asks only when "Display
  delete confirmation dialog" is on (SHELLSTATE.fNoConfirmRecycle clear in
  HKCU\...\Explorer\ShellState) or a ConfirmFileDelete policy says so.
- The XDG trash was created one level at a time from its last component: a
  new profile has no ~/.local/share yet, so the Recycle Bin counted as
  unavailable and Delete fell back to deleting for good, after a prompt.

Gate: make test-recycle.
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1349,6 +1349,33 @@
     return TRUE;
 }
 
+/* Stained Glass OS: moving to the Recycle Bin asks first only when the user
+ * turned on "Display delete confirmation dialog" (SHELLSTATE.fNoConfirmRecycle
+ * clear, in HKCU\...\Explorer\ShellState) or a ConfirmFileDelete policy asks
+ * for it; unset, Windows 10 does not ask. Without this every shell "delete"
+ * verb (the folder view's right-click Delete) raised a prompt, often hidden
+ * behind the window, and seemed to do nothing. */
+static BOOL recycle_confirm_wanted(void)
+{
+    static const WCHAR policy[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer";
+    HKEY roots[] = { HKEY_LOCAL_MACHINE, HKEY_CURRENT_USER };
+    BYTE state[64];
+    DWORD value, size, i;
+
+    for (i = 0; i < ARRAY_SIZE(roots); i++)
+    {
+        size = sizeof(value);
+        if (!RegGetValueW(roots[i], policy, L"ConfirmFileDelete", RRF_RT_REG_DWORD, NULL, &value, &size) && value)
+            return TRUE;
+    }
+    size = sizeof(state);
+    /* REGSHELLSTATE: a UINT size, then SHELLSTATE, whose third flag bit is fNoConfirmRecycle */
+    if (!RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer",
+                      L"ShellState", RRF_RT_REG_BINARY, NULL, state, &size) && size >= 8)
+        return !(state[4] & 0x04);
+    return FALSE;
+}
+
 /* the FO_DELETE operation */
 static int delete_files(LPSHFILEOPSTRUCTW lpFileOp, const FILE_LIST *flFrom)
 {
@@ -1363,7 +1390,8 @@
     /* Windows also checks only the first item */
     bTrash = (lpFileOp->fFlags & FOF_ALLOWUNDO) && is_trash_available();
 
-    if (!(lpFileOp->fFlags & FOF_NOCONFIRMATION) || (!bTrash && lpFileOp->fFlags & FOF_WANTNUKEWARNING))
+    if ((!(lpFileOp->fFlags & FOF_NOCONFIRMATION) && (!bTrash || recycle_confirm_wanted()))
+        || (!bTrash && lpFileOp->fFlags & FOF_WANTNUKEWARNING))
     {
         BOOL ok;
         fileop_progress_pause(fileop_progress_current(), TRUE);
