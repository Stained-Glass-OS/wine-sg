+/* Stained Glass OS: a structure of DWORD fields kept as one registry value per field */
+struct access_field
+{
+    union sysparam_all_entry *entry;
+    UINT                      offset;
+};
+
+struct access_desc
+{
+    UINT                       size;
+    const struct access_field *fields;
+    UINT                       count;
+};
+
+#define ACCESS_FIELD(type,member,e) { &entry_##e, offsetof( type, member ) }
+
+static const struct access_field sticky_fields[] = { ACCESS_FIELD( STICKYKEYS, dwFlags, STICKYKEYS_FLAGS ) };
+static const struct access_field filter_fields[] =
+{
+    ACCESS_FIELD( FILTERKEYS, dwFlags, FILTERKEYS_FLAGS ),
+    ACCESS_FIELD( FILTERKEYS, iWaitMSec, FILTERKEYS_WAIT ),
+    ACCESS_FIELD( FILTERKEYS, iDelayMSec, FILTERKEYS_DELAY ),
+    ACCESS_FIELD( FILTERKEYS, iRepeatMSec, FILTERKEYS_REPEAT ),
+    ACCESS_FIELD( FILTERKEYS, iBounceMSec, FILTERKEYS_BOUNCE ),
+};
+static const struct access_field toggle_fields[] = { ACCESS_FIELD( TOGGLEKEYS, dwFlags, TOGGLEKEYS_FLAGS ) };
+static const struct access_field mouse_fields[] =
+{
+    ACCESS_FIELD( MOUSEKEYS, dwFlags, MOUSEKEYS_FLAGS ),
+    ACCESS_FIELD( MOUSEKEYS, iMaxSpeed, MOUSEKEYS_MAXSPEED ),
+    ACCESS_FIELD( MOUSEKEYS, iTimeToMaxSpeed, MOUSEKEYS_TIMETOMAX ),
+    ACCESS_FIELD( MOUSEKEYS, iCtrlSpeed, MOUSEKEYS_CTRLSPEED ),
+};
+static const struct access_field timeout_fields[] =
+{
+    ACCESS_FIELD( ACCESSTIMEOUT, dwFlags, ACCESSTIMEOUT_FLAGS ),
+    ACCESS_FIELD( ACCESSTIMEOUT, iTimeOutMSec, ACCESSTIMEOUT_MSEC ),
+};
+static const struct access_field sentry_fields[] =
+{
+    ACCESS_FIELD( SOUNDSENTRYW, dwFlags, SOUNDSENTRY_FLAGS ),
+    ACCESS_FIELD( SOUNDSENTRYW, iFSTextEffect, SOUNDSENTRY_FSTEXT ),
+    ACCESS_FIELD( SOUNDSENTRYW, iFSTextEffectMSec, SOUNDSENTRY_FSTEXT_MSEC ),
+    ACCESS_FIELD( SOUNDSENTRYW, iFSTextEffectColorBits, SOUNDSENTRY_FSTEXT_COLOR ),
+    ACCESS_FIELD( SOUNDSENTRYW, iFSGrafEffect, SOUNDSENTRY_FSGRAF ),
+    ACCESS_FIELD( SOUNDSENTRYW, iFSGrafEffectMSec, SOUNDSENTRY_FSGRAF_MSEC ),
+    ACCESS_FIELD( SOUNDSENTRYW, iFSGrafEffectColor, SOUNDSENTRY_FSGRAF_COLOR ),
+    ACCESS_FIELD( SOUNDSENTRYW, iWindowsEffect, SOUNDSENTRY_WINDOWS ),
+    ACCESS_FIELD( SOUNDSENTRYW, iWindowsEffectMSec, SOUNDSENTRY_WINDOWS_MSEC ),
+    ACCESS_FIELD( SOUNDSENTRYW, iWindowsEffectOrdinal, SOUNDSENTRY_WINDOWS_ORDINAL ),
+};
+static const struct access_field serial_fields[] =
+{
+    ACCESS_FIELD( SERIALKEYSW, dwFlags, SERIALKEYS_FLAGS ),
+    ACCESS_FIELD( SERIALKEYSW, iBaudRate, SERIALKEYS_BAUD ),
+    ACCESS_FIELD( SERIALKEYSW, iPortState, SERIALKEYS_PORTSTATE ),
+    ACCESS_FIELD( SERIALKEYSW, iActive, SERIALKEYS_ACTIVE ),
+};
+static const struct access_field contrast_fields[] = { ACCESS_FIELD( HIGHCONTRASTW, dwFlags, HIGHCONTRAST_FLAGS ) };
+
+#define ACCESS_DESC(name,type,fields) static const struct access_desc name = { sizeof(type), fields, ARRAY_SIZE(fields) }
+ACCESS_DESC( sticky_desc, STICKYKEYS, sticky_fields );
+ACCESS_DESC( filter_desc, FILTERKEYS, filter_fields );
+ACCESS_DESC( toggle_desc, TOGGLEKEYS, toggle_fields );
+ACCESS_DESC( mouse_desc, MOUSEKEYS, mouse_fields );
+ACCESS_DESC( timeout_desc, ACCESSTIMEOUT, timeout_fields );
+ACCESS_DESC( sentry_desc, SOUNDSENTRYW, sentry_fields );
+ACCESS_DESC( serial_desc, SERIALKEYSW, serial_fields );
+ACCESS_DESC( contrast_desc, HIGHCONTRASTW, contrast_fields );
+
+static BOOL get_access_struct( const struct access_desc *desc, void *ptr )
+{
+    UINT i;
+
+    if (!ptr || *(UINT *)ptr != desc->size) return FALSE;
+    for (i = 0; i < desc->count; i++)
+        if (!get_entry( desc->fields[i].entry, 0, (char *)ptr + desc->fields[i].offset )) return FALSE;
+    return TRUE;
+}
+
+static BOOL set_access_struct( const struct access_desc *desc, void *ptr, UINT winini )
+{
+    UINT i;
+
+    if (!ptr || *(UINT *)ptr != desc->size)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+#ifdef SG_MUTANT_SPI_ACCESS_NOSAVE
+    winini &= ~SPIF_UPDATEINIFILE;
+#endif
+    for (i = 0; i < desc->count; i++)
+    {
+        UINT field = *(UINT *)((char *)ptr + desc->fields[i].offset);
+#ifdef SG_MUTANT_SPI_ACCESS_NOSET
+        break;
+#endif
+        if (!set_entry( desc->fields[i].entry, field, NULL, winini )) return FALSE;
+    }
+    return TRUE;
+}
