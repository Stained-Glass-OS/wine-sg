From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wtsapi32: session filter for WTSEnumerateProcessesEx, WTSWaitSystemEvent (3737)

wtsapi32: WTSEnumerateProcessesEx honours the session id, WTSWaitSystemEvent waits

WTS_CURRENT_SESSION and a session id filter the process list. WTSWaitSystemEvent
blocks until WTS_EVENT_FLUSH releases it; WTS_EVENT_* are defined.
---
diff --git a/dlls/wtsapi32/wtsapi32.c b/dlls/wtsapi32/wtsapi32.c
index cddf690..4d4a5cd 100644
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -551,8 +551,15 @@ BOOL WINAPI WTSEnumerateProcessesExW(HANDLE server, DWORD *level, DWORD session_
         return FALSE;
     }
 
-    if (session_id != WTS_ANY_SESSION)
-        FIXME("ignoring session id %#lx\n", session_id);
+    if (!level)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    /* WTS_CURRENT_SESSION is the session of the caller, WTS_ANY_SESSION every session */
+    if (session_id == WTS_CURRENT_SESSION && !ProcessIdToSessionId(GetCurrentProcessId(), &session_id))
+        return FALSE;
 
     if (*level)
     {
@@ -593,9 +600,12 @@ BOOL WINAPI WTSEnumerateProcessesExW(HANDLE server, DWORD *level, DWORD session_
     nt_process = nt_info;
     for (;;)
     {
-        size += sizeof(WTS_PROCESS_INFOW) + nt_process->ProcessName.Length + sizeof(WCHAR);
-        size += offsetof(SID, SubAuthority[SID_MAX_SUB_AUTHORITIES]);
-        ++count;
+        if (session_id == WTS_ANY_SESSION || nt_process->SessionId == session_id)
+        {
+            size += sizeof(WTS_PROCESS_INFOW) + nt_process->ProcessName.Length + sizeof(WCHAR);
+            size += offsetof(SID, SubAuthority[SID_MAX_SUB_AUTHORITIES]);
+            ++count;
+        }
 
         if (!nt_process->NextEntryOffset)
             break;
@@ -616,6 +626,13 @@ BOOL WINAPI WTSEnumerateProcessesExW(HANDLE server, DWORD *level, DWORD session_
     {
         HANDLE process, token;
 
+        if (session_id != WTS_ANY_SESSION && nt_process->SessionId != session_id)
+        {
+            if (!nt_process->NextEntryOffset) break;
+            nt_process = (SYSTEM_PROCESS_INFORMATION *)((char *)nt_process + nt_process->NextEntryOffset);
+            continue;
+        }
+
         info[count].SessionId = nt_process->SessionId;
         info[count].ProcessId = (DWORD_PTR)nt_process->UniqueProcessId;
 
@@ -2079,9 +2096,45 @@ BOOL WINAPI WTSVirtualChannelWrite(HANDLE hChannelHandle, PCHAR Buffer, ULONG Le
 /************************************************************
  *                WTSWaitSystemEvent (WTSAPI32.@)
  */
+static CRITICAL_SECTION wait_cs = { NULL, -1, 0, 0, 0, 0 };
+static CONDITION_VARIABLE wait_cv = CONDITION_VARIABLE_INIT;
+static LONG flush_generation;
+
 BOOL WINAPI WTSWaitSystemEvent(HANDLE hServer, DWORD Mask, DWORD* Flags)
 {
-    /* FIXME: Forward request to winsta.dll::WinStationWaitSystemEvent */
-    FIXME("Stub %p 0x%08lx %p\n", hServer, Mask, Flags);
-    return FALSE;
+    DWORD generation;
+
+    TRACE("%p 0x%08lx %p\n", hServer, Mask, Flags);
+
+    if (!Flags || (Mask & ~(WTS_EVENT_ALL | WTS_EVENT_FLUSH)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (hServer != WTS_CURRENT_SERVER_HANDLE)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+
+    *Flags = WTS_EVENT_NONE;
+    if (Mask == WTS_EVENT_NONE) return TRUE;   /* nothing is waited for */
+
+    /* WTS_EVENT_FLUSH releases every waiter; this computer announces no session events to this process
+     * (nothing posts them), so a waiter is released by a flush only */
+    EnterCriticalSection(&wait_cs);
+    if (Mask & WTS_EVENT_FLUSH)
+    {
+        flush_generation++;
+        WakeAllConditionVariable(&wait_cv);
+        LeaveCriticalSection(&wait_cs);
+        *Flags = WTS_EVENT_FLUSH;
+        return TRUE;
+    }
+    generation = flush_generation;
+    while (generation == flush_generation)
+        SleepConditionVariableCS(&wait_cv, &wait_cs, INFINITE);
+    LeaveCriticalSection(&wait_cs);
+    *Flags = WTS_EVENT_FLUSH;
+    return TRUE;
 }
diff --git a/include/wtsapi32.h b/include/wtsapi32.h
index dba53a6..76faeba 100644
--- a/include/wtsapi32.h
+++ b/include/wtsapi32.h
@@ -322,6 +322,19 @@ typedef struct _WTS_CLIENT_DISPLAY
 #define WTS_WSD_FASTREBOOT  0x00000010
 #define WTS_ANY_SESSION ((DWORD)-2)
 
+#define WTS_EVENT_NONE        0x00000000
+#define WTS_EVENT_CREATE      0x00000001
+#define WTS_EVENT_DELETE      0x00000002
+#define WTS_EVENT_RENAME      0x00000004
+#define WTS_EVENT_CONNECT     0x00000008
+#define WTS_EVENT_DISCONNECT  0x00000010
+#define WTS_EVENT_LOGON       0x00000020
+#define WTS_EVENT_LOGOFF      0x00000040
+#define WTS_EVENT_STATECHANGE 0x00000080
+#define WTS_EVENT_LICENSE     0x00000100
+#define WTS_EVENT_ALL         0x7fffffff
+#define WTS_EVENT_FLUSH       0x80000000
+
 void WINAPI WTSCloseServer(HANDLE);
 BOOL WINAPI WTSConnectSessionA(ULONG, ULONG, PSTR, BOOL);
 BOOL WINAPI WTSConnectSessionW(ULONG, ULONG, PWSTR, BOOL);
