From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase, ntdll: the file information classes Windows has

SetFileInformationByHandle(FileAllocationInfo) failed with
ERROR_CALL_NOT_IMPLEMENTED (1920 hits in the logs: downloaders and
installers reserve a file's space before writing it), and so did
FileRenameInfoEx; GetFileInformationByHandleEx did not answer
FileStorageInfo, FileCaseSensitiveInfo or FileNormalizedNameInfo; the
query-only classes passed to SetFileInformationByHandle were "not
implemented" where Windows refuses them with ERROR_INVALID_PARAMETER.

ntdll gains FileAllocationInformation (below the end of file it truncates
there, as Windows does; above it the space is reserved with
fallocate(FALLOC_FL_KEEP_SIZE) and the end of file stays) and
FileFsSectorSizeInformation (512-byte sectors, as get_full_size_info
says; the physical sector is the block size, 4096 on today's disks).
FileStorageInfo is that structure; case sensitivity is never set per
directory here; names are always the long ones, so the normalized name
is the file's name. FILE_STORAGE_INFO, FILE_CASE_SENSITIVE_INFO and
FILE_FS_SECTOR_SIZE_INFORMATION are added to the headers.

Wine's kernel32 file tests: no new failures.

Gate: test/fileinfo-gate.sh. Mutants SG_MUTANT_NO_ALLOCATION_INFO,
SG_MUTANT_NO_SECTOR_SIZE (ntdll/unix/file.c), SG_MUTANT_NO_FILE_INFO_EX
(kernelbase/file.c).
---
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -3409,14 +3409,52 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetFileInformationByHandleEx( HANDLE handle, FILE_
     switch (class)
     {
     case FileRemoteProtocolInfo:
+        FIXME( "%p, %u, %p, %lu\n", handle, class, info, size );
+        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        return FALSE;
+
+#ifndef SG_MUTANT_NO_FILE_INFO_EX
     case FileStorageInfo:
-    case FileDispositionInfoEx:
-    case FileRenameInfoEx:
+    {
+        /* the volume's sector sizes (FileFsSectorSizeInformation); the
+         * structures are the same */
+        if (size < sizeof(FILE_STORAGE_INFO))
+        {
+            SetLastError( ERROR_BAD_LENGTH );
+            return FALSE;
+        }
+        status = NtQueryVolumeInformationFile( handle, &io, info, sizeof(FILE_STORAGE_INFO),
+                                               FileFsSectorSizeInformation );
+        break;
+    }
+
     case FileCaseSensitiveInfo:
+    {
+        /* per-directory case sensitivity (fsutil setCaseSensitiveInfo) is
+         * never set here: names are matched without case everywhere */
+        FILE_BASIC_INFORMATION basic;
+
+        if (size < sizeof(FILE_CASE_SENSITIVE_INFO))
+        {
+            SetLastError( ERROR_BAD_LENGTH );
+            return FALSE;
+        }
+        if (!(status = NtQueryInformationFile( handle, &io, &basic, sizeof(basic), FileBasicInformation )))
+            ((FILE_CASE_SENSITIVE_INFO *)info)->Flags = 0;
+        break;
+    }
+
     case FileNormalizedNameInfo:
-        FIXME( "%p, %u, %p, %lu\n", handle, class, info, size );
-        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        /* names here are always the long, real ones */
+        status = NtQueryInformationFile( handle, &io, info, size, FileNameInformation );
+        break;
+
+    case FileDispositionInfoEx:
+    case FileRenameInfoEx:
+        /* set-only classes */
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
+#endif
 
     case FileStreamInfo:
         status = NtQueryInformationFile( handle, &io, info, size, FileStreamInformation );
@@ -4007,8 +4045,10 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetFileInformationByHandle( HANDLE file, FILE_INFO
 
     switch (class)
     {
-    case FileNameInfo:
+#ifdef SG_MUTANT_NO_FILE_INFO_EX
     case FileAllocationInfo:
+#endif
+    case FileNameInfo:
     case FileStreamInfo:
     case FileIdBothDirectoryInfo:
     case FileIdBothDirectoryRestartInfo:
@@ -4019,10 +4059,15 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetFileInformationByHandle( HANDLE file, FILE_INFO
     case FileIdInfo:
     case FileIdExtdDirectoryInfo:
     case FileIdExtdDirectoryRestartInfo:
-        FIXME( "%p, %u, %p, %lu\n", file, class, info, size );
-        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        /* query-only classes, as on Windows */
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
 
+#ifndef SG_MUTANT_NO_FILE_INFO_EX
+    case FileAllocationInfo:
+        status = NtSetInformationFile( file, &io, info, size, FileAllocationInformation );
+        break;
+#endif
     case FileEndOfFileInfo:
         status = NtSetInformationFile( file, &io, info, size, FileEndOfFileInformation );
         break;
@@ -4039,6 +4084,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetFileInformationByHandle( HANDLE file, FILE_INFO
         status = NtSetInformationFile( file, &io, info, size, FileIoPriorityHintInformation );
         break;
     case FileRenameInfo:
+    case FileRenameInfoEx:
         {
             FILE_RENAME_INFORMATION *rename_info;
             UNICODE_STRING nt_name;
@@ -4054,7 +4100,8 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetFileInformationByHandle( HANDLE file, FILE_INFO
                 memcpy( rename_info, info, sizeof(*rename_info) );
                 memcpy( rename_info->FileName, nt_name.Buffer, nt_name.Length + sizeof(WCHAR) );
                 rename_info->FileNameLength = nt_name.Length;
-                status = NtSetInformationFile( file, &io, rename_info, size, FileRenameInformation );
+                status = NtSetInformationFile( file, &io, rename_info, size, class == FileRenameInfoEx ?
+                                               FileRenameInformationEx : FileRenameInformation );
                 HeapFree( GetProcessHeap(), 0, rename_info );
             }
             RtlFreeUnicodeString( &nt_name );
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5466,6 +5466,48 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         status = STATUS_INVALID_INFO_CLASS;
         break;
 
+#ifndef SG_MUTANT_NO_ALLOCATION_INFO
+    case FileAllocationInformation:
+        /* SetFileInformationByHandle(FileAllocationInfo), SetFileValidData's
+         * companion: downloaders and installers reserve a file's space
+         * before writing it. Below the end of file it truncates the file
+         * there, as Windows does; above it the space is reserved and the
+         * end of file stays. */
+        if (len >= sizeof(FILE_ALLOCATION_INFORMATION))
+        {
+            const FILE_ALLOCATION_INFORMATION *info = ptr;
+            struct stat st;
+
+            if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
+                return io->Status = status;
+
+            if (info->AllocationSize.QuadPart < 0) status = STATUS_INVALID_PARAMETER;
+            else if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
+            else if (!S_ISREG( st.st_mode )) status = STATUS_INVALID_PARAMETER;
+            else if ((off_t)info->AllocationSize.QuadPart < st.st_size)
+            {
+                SERVER_START_REQ( set_fd_eof_info )
+                {
+                    req->handle   = wine_server_obj_handle( handle );
+                    req->eof      = info->AllocationSize.QuadPart;
+                    status = wine_server_call( req );
+                }
+                SERVER_END_REQ;
+            }
+#ifdef FALLOC_FL_KEEP_SIZE
+            else if ((off_t)info->AllocationSize.QuadPart > st.st_size &&
+                     fallocate( fd, FALLOC_FL_KEEP_SIZE, 0, (off_t)info->AllocationSize.QuadPart ) == -1)
+            {
+                if (errno == ENOSPC) status = STATUS_DISK_FULL;
+                else if (errno != EOPNOTSUPP && errno != ENOSYS) status = errno_to_status( errno );
+            }
+#endif
+            if (needs_close) close( fd );
+        }
+        else status = STATUS_INVALID_PARAMETER_3;
+        break;
+#endif
+
     case FileValidDataLengthInformation:
         if (len >= sizeof(FILE_VALID_DATA_LENGTH_INFORMATION))
         {
@@ -8134,6 +8176,38 @@ NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io
         }
         break;
 
+#ifndef SG_MUTANT_NO_SECTOR_SIZE
+    case FileFsSectorSizeInformation:
+        /* GetFileInformationByHandleEx(FileStorageInfo): SQLite and .NET size
+         * their writes by it. Sectors are 512 bytes, as get_full_size_info
+         * says; the device is written in its block size. */
+        if (length < sizeof(FILE_FS_SECTOR_SIZE_INFORMATION))
+            status = STATUS_BUFFER_TOO_SMALL;
+        else
+        {
+            FILE_FS_SECTOR_SIZE_INFORMATION *info = buffer;
+            struct stat st;
+
+            if (fstat( fd, &st ) < 0) status = errno_to_status( errno );
+            else
+            {
+                ULONG physical = 512;
+
+                if (st.st_blksize >= 4096) physical = 4096;
+                info->LogicalBytesPerSector = 512;
+                info->PhysicalBytesPerSectorForAtomicity = physical;
+                info->PhysicalBytesPerSectorForPerformance = physical;
+                info->FileSystemEffectivePhysicalBytesPerSectorForAtomicity = physical;
+                info->Flags = SSINFO_FLAGS_ALIGNED_DEVICE | SSINFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE;
+                info->ByteOffsetForSectorAlignment = 0;
+                info->ByteOffsetForPartitionAlignment = 0;
+                io->Information = sizeof(*info);
+                status = STATUS_SUCCESS;
+            }
+        }
+        break;
+#endif
+
     case FileFsObjectIdInformation:
         FIXME( "%p: object id info not supported\n", handle );
         status = STATUS_NOT_IMPLEMENTED;
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -808,6 +808,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
     case FileIoCompletionNotificationInformation:   /* FILE_IO_COMPLETION_NOTIFICATION_INFORMATION */
     case FileIoPriorityHintInformation:   /* FILE_IO_PRIORITY_HINT_INFO */
     case FileValidDataLengthInformation:   /* FILE_VALID_DATA_LENGTH_INFORMATION */
+    case FileAllocationInformation:   /* FILE_ALLOCATION_INFORMATION */
     case FileDispositionInformation:   /* FILE_DISPOSITION_INFORMATION */
     case FileDispositionInformationEx:   /* FILE_DISPOSITION_INFORMATION_EX */
         status = NtSetInformationFile( handle, iosb_32to64( &io, io32 ), ptr, len, class );
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -901,6 +901,26 @@ typedef struct _FILE_REMOTE_PROTOCOL_INFO {
     } ProtocolSpecificReserved;
 } FILE_REMOTE_PROTOCOL_INFO, *PFILE_REMOTE_PROTOCOL_INFO;
 
+typedef struct _FILE_STORAGE_INFO {
+    ULONG LogicalBytesPerSector;
+    ULONG PhysicalBytesPerSectorForAtomicity;
+    ULONG PhysicalBytesPerSectorForPerformance;
+    ULONG FileSystemEffectivePhysicalBytesPerSectorForAtomicity;
+    ULONG Flags;
+    ULONG ByteOffsetForSectorAlignment;
+    ULONG ByteOffsetForPartitionAlignment;
+} FILE_STORAGE_INFO, *PFILE_STORAGE_INFO;
+
+#define STORAGE_INFO_FLAGS_ALIGNED_DEVICE                 0x00000001
+#define STORAGE_INFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE    0x00000002
+#define STORAGE_INFO_OFFSET_UNKNOWN                       0xffffffff
+
+typedef struct _FILE_CASE_SENSITIVE_INFO {
+    ULONG Flags;
+} FILE_CASE_SENSITIVE_INFO, *PFILE_CASE_SENSITIVE_INFO;
+
+#define FILE_CS_FLAG_CASE_SENSITIVE_DIR 0x00000001
+
 #define PIPE_ACCESS_INBOUND  1
 #define PIPE_ACCESS_OUTBOUND 2
 #define PIPE_ACCESS_DUPLEX   3
--- a/include/winioctl.h
+++ b/include/winioctl.h
@@ -652,6 +652,24 @@ typedef struct _FILE_FS_FULL_SIZE_INFORMATION {
 	ULONG		BytesPerSector;
 } FILE_FS_FULL_SIZE_INFORMATION, *PFILE_FS_FULL_SIZE_INFORMATION;
 
+/*FileFsSectorSizeInformation = 11 */
+typedef struct _FILE_FS_SECTOR_SIZE_INFORMATION {
+	ULONG	LogicalBytesPerSector;
+	ULONG	PhysicalBytesPerSectorForAtomicity;
+	ULONG	PhysicalBytesPerSectorForPerformance;
+	ULONG	FileSystemEffectivePhysicalBytesPerSectorForAtomicity;
+	ULONG	Flags;
+	ULONG	ByteOffsetForSectorAlignment;
+	ULONG	ByteOffsetForPartitionAlignment;
+} FILE_FS_SECTOR_SIZE_INFORMATION, *PFILE_FS_SECTOR_SIZE_INFORMATION;
+
+#define SSINFO_FLAGS_ALIGNED_DEVICE              0x00000001
+#define SSINFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE 0x00000002
+#define SSINFO_FLAGS_NO_SEEK_PENALTY             0x00000004
+#define SSINFO_FLAGS_TRIM_ENABLED                0x00000008
+#define SSINFO_FLAGS_BYTE_ADDRESSABLE            0x00000010
+#define SSINFO_OFFSET_UNKNOWN                    0xffffffff
+
 typedef struct _FILE_PIPE_WAIT_FOR_BUFFER {
     LARGE_INTEGER   Timeout;
     ULONG           NameLength;
