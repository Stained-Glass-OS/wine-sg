From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, kernel32: named pipe process/session id error semantics

GetNamedPipeClientProcessId/ServerProcessId (and the session id
versions) now fail the way Windows does where Wine's conformance tests
(todo_wine) say so: a NULL result pointer is ERROR_INSUFFICIENT_BUFFER;
a server end that is disconnected or listening has no client
(ERROR_NOT_FOUND); the client end of a disconnected pipe is
ERROR_PIPE_NOT_CONNECTED.  The wineserver answers; no protocol change.

---
--- a/dlls/kernel32/sync.c
+++ b/dlls/kernel32/sync.c
@@ -513,6 +513,13 @@ BOOL WINAPI GetNamedPipeClientProcessId( HANDLE pipe, ULONG *id )
 {
     IO_STATUS_BLOCK iosb;
 
+#ifndef SG_MUTANT_NO_PIPE_NULL
+    if (!id)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+#endif
     return set_ntstatus( NtFsControlFile( pipe, NULL, NULL, NULL, &iosb,
                                           FSCTL_PIPE_GET_CONNECTION_ATTRIBUTE, (void *)"ClientProcessId",
                                           sizeof("ClientProcessId"), id, sizeof(*id) ));
@@ -525,6 +532,13 @@ BOOL WINAPI GetNamedPipeServerProcessId( HANDLE pipe, ULONG *id )
 {
     IO_STATUS_BLOCK iosb;
 
+#ifndef SG_MUTANT_NO_PIPE_NULL
+    if (!id)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+#endif
     return set_ntstatus( NtFsControlFile( pipe, NULL, NULL, NULL, &iosb,
                                           FSCTL_PIPE_GET_CONNECTION_ATTRIBUTE, (void *)"ServerProcessId",
                                           sizeof("ServerProcessId"), id, sizeof(*id) ));
@@ -537,7 +551,13 @@ BOOL WINAPI GetNamedPipeClientSessionId( HANDLE pipe, ULONG *id )
 {
     FIXME( "%p, %p\n", pipe, id );
 
-    if (!id) return FALSE;
+#ifndef SG_MUTANT_NO_PIPE_NULL
+    if (!id)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+#endif
     *id = NtCurrentTeb()->Peb->SessionId;
     return TRUE;
 }
@@ -549,7 +569,13 @@ BOOL WINAPI GetNamedPipeServerSessionId( HANDLE pipe, ULONG *id )
 {
     FIXME( "%p, %p\n", pipe, id );
 
-    if (!id) return FALSE;
+#ifndef SG_MUTANT_NO_PIPE_NULL
+    if (!id)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+#endif
     *id = NtCurrentTeb()->Peb->SessionId;
     return TRUE;
 }
--- a/dlls/kernel32/tests/pipe.c
+++ b/dlls/kernel32/tests/pipe.c
@@ -3473,7 +3473,7 @@ static void test_namedpipe_process_id(void)
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeClientProcessId(server, NULL);
     ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
+    ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
 
     pid = 0;
     ret = pGetNamedPipeClientProcessId(server, &pid);
@@ -3488,7 +3488,7 @@ static void test_namedpipe_process_id(void)
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeServerProcessId(server, NULL);
     ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
+    ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
 
     pid = 0;
     ret = pGetNamedPipeServerProcessId(client, &pid);
@@ -3519,8 +3519,8 @@ static void test_namedpipe_process_id(void)
 
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeClientProcessId(server, &pid);
-    todo_wine ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_NOT_FOUND, "got %lu\n", GetLastError());
+    ok(!ret, "success\n");
+    ok(GetLastError() == ERROR_NOT_FOUND, "got %lu\n", GetLastError());
 
     pid = 0;
     ret = pGetNamedPipeServerProcessId(server, &pid);
@@ -3529,13 +3529,13 @@ static void test_namedpipe_process_id(void)
 
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeClientProcessId(client, &pid);
-    todo_wine ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
+    ok(!ret, "success\n");
+    ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
 
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeServerProcessId(client, &pid);
-    todo_wine ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
+    ok(!ret, "success\n");
+    ok(GetLastError() == ERROR_PIPE_NOT_CONNECTED, "got %lu\n", GetLastError());
     CloseHandle(client);
     CloseHandle(server);
 
@@ -3630,7 +3630,7 @@ static void test_namedpipe_session_id(void)
     SetLastError(0xdeadbeef);
     ret = pGetNamedPipeServerSessionId(server, NULL);
     ok(!ret, "success\n");
-    todo_wine ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
+    ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
 
     id = 0;
     ret = pGetNamedPipeServerSessionId(client, &id);
--- a/server/named_pipe.c
+++ b/server/named_pipe.c
@@ -1287,6 +1287,26 @@ static void pipe_end_get_connection_attribute( struct pipe_end *pipe_end )
         return;
     }
 
+#ifndef SG_MUTANT_NO_PIPE_STATE_CHECK
+    /* the client of a pipe that was disconnected has nothing to ask about, and
+     * a server that is not connected (disconnected, or listening again) has
+     * no client to name */
+    if (pipe_end->obj.ops == &pipe_client_ops)
+    {
+        if (pipe_end->state == FILE_PIPE_DISCONNECTED_STATE)
+        {
+            set_error( STATUS_PIPE_DISCONNECTED );
+            return;
+        }
+    }
+    else if (value == &pipe_end->client_pid &&
+             (pipe_end->state == FILE_PIPE_DISCONNECTED_STATE || pipe_end->state == FILE_PIPE_LISTENING_STATE))
+    {
+        set_error( STATUS_NOT_FOUND );
+        return;
+    }
+#endif
+
     if (get_reply_max_size() < value_size)
     {
         set_error( STATUS_INFO_LENGTH_MISMATCH );
