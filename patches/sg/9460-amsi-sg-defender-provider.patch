From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] amsi: SG Defender is the system's own provider

SG Defender is the system's own AMSI provider, as Windows Defender is
Windows': AmsiScanBuffer/AmsiScanString send the text (as UTF-8 when it came
as UTF-16, which PowerShell and AmsiScanString pass) to the same engine as the
files, in a sealed memfd through 9456's __wine_sg_defender_scan; a detection
is AMSI_RESULT_DETECTED. Registered providers still run first. Gate
test-defender-exec.
---
--- a/dlls/amsi/main.c
+++ b/dlls/amsi/main.c
@@ -317,6 +317,53 @@
     free( s );
 }
 
+/* text a script host passes as UTF-16 (PowerShell, AmsiScanString): every
+ * other byte zero */
+static BOOL looks_utf16( const BYTE *p, ULONG len )
+{
+    ULONG i, n = min( len, 1024 ) & ~1, odd = 0, even = 0;
+    for (i = 0; i < n; i += 2)
+    {
+        if (!p[i + 1]) odd++;
+        if (!p[i]) even++;
+    }
+    return n && odd * 10 >= (n / 2) * 6 && even * 10 < (n / 2);
+}
+
+/* Stained Glass OS: SG Defender is the system's own AMSI provider, as
+ * Windows Defender is Windows': the text goes to the same engine as the
+ * files (ntdll's __wine_sg_defender_scan, a sealed memfd to sg-defender),
+ * as UTF-8 when it came as UTF-16 -- the signatures are for the text. */
+static BOOL sg_defender_detects( const WCHAR *app, const WCHAR *name, const BYTE *buffer, ULONG length )
+{
+    static LONG (CDECL *scan)( HANDLE, const void *, ULONG, const WCHAR *, ULONG );
+    WCHAR label[300];
+    char *utf8 = NULL;
+    const void *data = buffer;
+    ULONG size = length;
+    LONG status;
+
+#ifdef SG_MUTANT_AMSI_NO_DEFENDER
+    return FALSE;
+#endif
+    if (!scan) scan = (void *)GetProcAddress( GetModuleHandleW( L"ntdll.dll" ), "__wine_sg_defender_scan" );
+    if (!scan) return FALSE;
+    if (length >= 2 && !(length & 1) && looks_utf16( buffer, length ))
+    {
+        int n = WideCharToMultiByte( CP_UTF8, 0, (const WCHAR *)buffer, length / 2, NULL, 0, NULL, NULL );
+        if (n > 0 && (utf8 = malloc( n )))
+        {
+            WideCharToMultiByte( CP_UTF8, 0, (const WCHAR *)buffer, length / 2, utf8, n, NULL, NULL );
+            data = utf8;
+            size = n;
+        }
+    }
+    swprintf( label, ARRAY_SIZE(label), L"%.100s %.180s", app ? app : L"", name ? name : L"" );
+    status = scan( NULL, data, size, label, 3 );
+    free( utf8 );
+    return status == (LONG)0xc0000906; /* STATUS_VIRUS_INFECTED */
+}
+
 HRESULT WINAPI AmsiScanBuffer( HAMSICONTEXT context, void *buffer, ULONG length, const WCHAR *name,
                                HAMSISESSION session, AMSI_RESULT *result )
 {
@@ -361,6 +408,8 @@
 #endif
     }
     if (SUCCEEDED(init)) CoUninitialize();
+    if (best < AMSI_RESULT_DETECTED && sg_defender_detects( c->app_name, name, buffer, length ))
+        best = AMSI_RESULT_DETECTED;
     *result = best;
     return S_OK;
 }
