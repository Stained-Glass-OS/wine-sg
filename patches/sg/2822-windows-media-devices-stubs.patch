+/* IInspectable::GetIids: a CoTaskMem copy of the interfaces an object answers to. */
+static HRESULT sg_get_iids(ULONG *count, IID **iids, const GUID *const *list, ULONG n)
+{
+    IID *out;
+    ULONG i;
+
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+#ifdef SG_MUTANT_MD_IIDS
+    if (n > 1) n--;
+#endif
+    if (!(out = CoTaskMemAlloc(n * sizeof(*out)))) return E_OUTOFMEMORY;
+    for (i = 0; i < n; i++) out[i] = *list[i];
+    *count = n;
+    *iids = out;
+    return S_OK;
+}
+#define SG_GET_IIDS(count, iids, ...) \
+    sg_get_iids(count, iids, (const GUID *const[]){ __VA_ARGS__ }, ARRAY_SIZE(((const GUID *const[]){ __VA_ARGS__ })))
+
+/* Event sources: handlers are kept with the token returned to the caller.
+ * Nothing here raises them (see the note about default-device changes). */
+struct handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    IUnknown *handler;
+};
+
+static SRWLOCK event_lock = SRWLOCK_INIT;
+static LONG64 next_token;
+static struct list capture_handlers = LIST_INIT(capture_handlers);
+static struct list render_handlers = LIST_INIT(render_handlers);
+
+static HRESULT event_add(struct list *list, IUnknown *handler, EventRegistrationToken *token)
+{
+    struct handler *entry;
+
+    if (!token) return E_POINTER;
+    token->value = 0;
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc(1, sizeof(*entry)))) return E_OUTOFMEMORY;
+    entry->handler = handler;
+    IUnknown_AddRef(handler);
+    entry->token.value = InterlockedIncrement64(&next_token);
+    AcquireSRWLockExclusive(&event_lock);
+    list_add_tail(list, &entry->entry);
+    ReleaseSRWLockExclusive(&event_lock);
+    *token = entry->token;
+    return S_OK;
+}
+
+/* Removing a token that is not registered is not an error. */
+static HRESULT event_remove(struct list *list, EventRegistrationToken token)
+{
+    struct handler *entry;
+
+    AcquireSRWLockExclusive(&event_lock);
+    LIST_FOR_EACH_ENTRY(entry, list, struct handler, entry)
+    {
+#ifdef SG_MUTANT_MD_EVENT_REMOVE
+        break;
+#endif
+        if (entry->token.value != token.value) continue;
+        list_remove(&entry->entry);
+        ReleaseSRWLockExclusive(&event_lock);
+        IUnknown_Release(entry->handler);
+        free(entry);
+        return S_OK;
+    }
+    ReleaseSRWLockExclusive(&event_lock);
+    return S_OK;
+}
+
