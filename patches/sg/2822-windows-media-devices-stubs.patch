+static HRESULT make_selector(const GUID *class_guid, HSTRING *value)
+{
+    static const WCHAR pre[] = L"System.Devices.InterfaceClassGuid:=\"";
+    static const WCHAR post[] = L"\" AND System.Devices.InterfaceEnabled:=System.StructuredQueryType.Boolean#True";
+    WCHAR buf[ARRAY_SIZE(pre) + 38 + ARRAY_SIZE(post)], *p;
+    int i;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    wcscpy(buf, pre);
+    p = buf + wcslen(buf);
+    StringFromGUID2(class_guid, p, 39);
+    for (i = 0; i < 38; i++) if (p[i] >= L'A' && p[i] <= L'F') p[i] += L'a' - L'A';
+    wcscat(buf, post);
+    return WindowsCreateString(buf, wcslen(buf), value);
+}
+
+DEFINE_GUID(SG_KSCATEGORY_VIDEO_CAMERA, 0xe5323777, 0xf976, 0x4f5b, 0x9b, 0x55, 0xb9, 0x46, 0x99, 0xc4, 0x6e, 0x44);
+
