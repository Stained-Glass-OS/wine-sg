From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u: a sandboxed program's own desktop comes up

Firefox's sandbox starts each content process on an alternate window station
and desktop with a restricted, low-integrity token. The first window there
starts that desktop's explorer under the same token, which may not write the
registry: the display setup recorded no GPU and add_source asserted
(!list_empty( &gpus )), the abort left the explorer spinning at 100% CPU, and
the sandboxed process waited for its desktop forever. Every Firefox start
added spinning explorers until the machine could no longer create threads.

add_source, add_monitor, add_modes, the default display devices and the
virtual source now give up quietly when an earlier step recorded nothing; the
desktop then reads what the session already recorded.

Found by the 2026-09-26 ISO QA pass. Gate: test/sandboxdesk-gate.sh
(make test-sandboxdesk).
---
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -1418,7 +1418,15 @@
 
     TRACE( "name %s, state_flags %#x\n", name, state_flags );
 
-    assert( !list_empty( &gpus ) );
+    /* Stained Glass OS: no GPU was recorded -- a process whose token may not
+     * write the registry (a sandbox's, on a desktop of its own): give up on
+     * this pass quietly. An assert here aborted that desktop's explorer,
+     * which then spun at 100% CPU while the process waited for its desktop. */
+    if (list_empty( &gpus ))
+    {
+        WARN( "no GPU recorded, source %s skipped\n", debugstr_a(name) );
+        return;
+    }
     gpu = LIST_ENTRY( list_tail( &gpus ), struct gpu, entry );
 
     /* in virtual desktop mode, report all physical sources as detached */
@@ -1577,7 +1585,7 @@
     char buffer[MAX_PATH];
     char monitor_id_string[16];
 
-    assert( !list_empty( &sources ) );
+    if (list_empty( &sources )) return;  /* Stained Glass OS: see add_source */
     source = LIST_ENTRY( list_tail( &sources ), struct source, entry );
 
     if (!(monitor = calloc( 1, sizeof(*monitor) ))) return;
@@ -1712,7 +1720,7 @@
 
     TRACE( "current %s, modes_count %u, modes %p, param %p\n", debugstr_devmodew( current ), modes_count, modes, param );
 
-    assert( !list_empty( &sources ) );
+    if (list_empty( &sources )) return;  /* Stained Glass OS: see add_source */
     source = LIST_ENTRY( list_tail( &sources ), struct source, entry );
 
     if (emulate_modeset)
@@ -2142,7 +2150,7 @@
     add_gpu( "Wine GPU", &pci_id, NULL, ctx );
     add_source( "Default", source_flags, system_dpi, ctx );
 
-    assert( !list_empty( &sources ) );
+    if (list_empty( &sources )) return STATUS_UNSUCCESSFUL;  /* Stained Glass OS: see add_source */
     source = LIST_ENTRY( list_tail( &sources ), struct source, entry );
 
     if (!read_source_mode( source->key, ENUM_CURRENT_SETTINGS, &mode ))
@@ -2201,7 +2209,7 @@
     UINT modes_count;
     struct gpu *gpu;
 
-    assert( !list_empty( &gpus ) );
+    if (list_empty( &gpus )) return STATUS_UNSUCCESSFUL;  /* Stained Glass OS: see add_source */
     gpu = LIST_ENTRY( list_tail( &gpus ), struct gpu, entry );
 
     if (list_empty( &sources )) physical = NULL;
