+/* RequestCommitAsync's: Started; done at the next frame on the compositor's thread */
+static HRESULT commit_action_create( struct compositor *compositor, IAsyncAction **action )
+{
+    struct done_action *impl;
+    BOOL first;
+    HRESULT hr;
+
+    if (FAILED(hr = done_action_create( action ))) return hr;
+#ifndef SG_MUTANT_COMMIT_ACTION_DONE_AT_ONCE
+    if (!compositor->notify_window) return S_OK;
+    impl = impl_from_IAsyncAction( *action );
+    impl->status = Started;
+    IAsyncAction_AddRef( *action );
+    EnterCriticalSection( &compositor->cs );
+    first = list_empty( &compositor->commit_actions );
+    list_add_tail( &compositor->commit_actions, &impl->entry );
+    LeaveCriticalSection( &compositor->cs );
+    /* one frame timer for all the actions asked for before it */
+    if (first) PostMessageW( compositor->notify_window, WM_COMPOSITION_FRAME, 0, 0 );
+#else
+    (void)impl; (void)first;
+#endif
+    return S_OK;
+}
+
+/* the frame came: the actions asked for before it finish, their handlers run (outside the locks; a handler
+ * that asks for another commit gets one for the next frame) */
+static void commit_actions_complete( struct compositor *compositor, AsyncStatus status )
+{
+    struct list done = LIST_INIT( done );
+    struct done_action *impl, *next;
+
+    EnterCriticalSection( &compositor->cs );
+    list_move_tail( &done, &compositor->commit_actions );
+    LeaveCriticalSection( &compositor->cs );
+    LIST_FOR_EACH_ENTRY_SAFE( impl, next, &done, struct done_action, entry )
+    {
+        IAsyncActionCompletedHandler *handler;
+
+        list_remove( &impl->entry );
+        EnterCriticalSection( &action_cs );
+        impl->status = status;
+        if ((handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( handler );
+        LeaveCriticalSection( &action_cs );
+        if (handler)
+        {
+            IAsyncActionCompletedHandler_Invoke( handler, &impl->IAsyncAction_iface, status );
+            IAsyncActionCompletedHandler_Release( handler );
+        }
+        IAsyncAction_Release( &impl->IAsyncAction_iface );
+    }
+}
