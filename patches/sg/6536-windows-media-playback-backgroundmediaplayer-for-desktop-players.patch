diff --git a/dlls/windows.media.mediacontrol/main.c b/dlls/windows.media.mediacontrol/main.c
index bb07404..7f5c924 100644
--- a/dlls/windows.media.mediacontrol/main.c
+++ b/dlls/windows.media.mediacontrol/main.c
@@ -2824,6 +2824,53 @@ static const struct ISystemMediaTransportControlsVtbl media_control_vtbl =
 
 DEFINE_IINSPECTABLE( media_control_statics, ISystemMediaTransportControlsInterop, struct media_control_statics, IActivationFactory_iface )
 
+struct window_controls
+{
+    struct list entry;
+    HWND window;
+    ISystemMediaTransportControls *controls;   /* the system's reference */
+};
+
+static struct list window_controls = LIST_INIT( window_controls );
+static CRITICAL_SECTION window_controls_cs;
+static CRITICAL_SECTION_DEBUG window_controls_cs_debug =
+{
+    0, 0, &window_controls_cs,
+    { &window_controls_cs_debug.ProcessLocksList, &window_controls_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": window_controls_cs") }
+};
+static CRITICAL_SECTION window_controls_cs = { &window_controls_cs_debug, -1, 0, 0, 0, 0 };
+
+/* keep the window's controls (dropping those of windows that are gone, and a stale entry for a
+ * handle that was reused) */
+static void remember_window_controls( HWND window, ISystemMediaTransportControls *controls )
+{
+    struct window_controls *entry, *next;
+    struct list gone = LIST_INIT( gone );
+
+    EnterCriticalSection( &window_controls_cs );
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &window_controls, struct window_controls, entry )
+    {
+        if (entry->window != window && IsWindow( entry->window )) continue;
+        list_remove( &entry->entry );
+        list_add_tail( &gone, &entry->entry );
+    }
+    if ((entry = malloc( sizeof(*entry) )))
+    {
+        entry->window = window;
+        entry->controls = controls;
+        ISystemMediaTransportControls_AddRef( controls );
+        list_add_tail( &window_controls, &entry->entry );
+    }
+    LeaveCriticalSection( &window_controls_cs );
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &gone, struct window_controls, entry )
+    {
+        ISystemMediaTransportControls_Release( entry->controls );
+        free( entry );
+    }
+}
+
 static HRESULT WINAPI media_control_statics_GetForWindow( ISystemMediaTransportControlsInterop *iface, HWND window, REFIID riid, void **control )
 {
     struct media_control *impl;
@@ -2833,6 +2880,25 @@ static HRESULT WINAPI media_control_statics_GetForWindow( ISystemMediaTransportC
 
     if (!window || !control) return E_POINTER;
     *control = NULL;
+
+    /* Stained Glass OS (wine-sg 6536): one object per window, which the system keeps (as on Windows:
+     * a second GetForWindow gets the same controls, and they live while the window does) */
+    EnterCriticalSection( &window_controls_cs );
+#ifndef SG_MUTANT_SMTC_NEW_PER_CALL
+    {
+        struct window_controls *entry;
+        LIST_FOR_EACH_ENTRY( entry, &window_controls, struct window_controls, entry )
+        {
+            if (entry->window != window) continue;
+            if (!IsWindow( window )) break;
+            hr = ISystemMediaTransportControls_QueryInterface( entry->controls, riid, control );
+            LeaveCriticalSection( &window_controls_cs );
+            return hr;
+        }
+    }
+#endif
+    LeaveCriticalSection( &window_controls_cs );
+
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
 
     impl->ISystemMediaTransportControls_iface.lpVtbl = &media_control_vtbl;
@@ -2877,6 +2943,7 @@ static HRESULT WINAPI media_control_statics_GetForWindow( ISystemMediaTransportC
     TRACE( "created ISystemMediaTransportControls %p.\n", impl );
 
     hr = ISystemMediaTransportControls_QueryInterface( &impl->ISystemMediaTransportControls_iface, riid, control );
+    if (SUCCEEDED(hr)) remember_window_controls( window, &impl->ISystemMediaTransportControls_iface );
     ISystemMediaTransportControls_Release( &impl->ISystemMediaTransportControls_iface );
     return hr;
 }
