+/* ------------------------------------------------------------------------ */
+/* tabs (David 2026-10-02: "the file explorer needs to be able to have      */
+/* tabs"): each its own folder and its own back and forward; the window     */
+/* shows one. Ctrl+T opens one, Ctrl+W closes it (the last, the window),     */
+/* Ctrl+Tab and Ctrl+Shift+Tab go through them, a middle click closes one.  */
+
+#define TABBAR_H 36
+#define MAX_TABS 24
+struct fe_tab
+{
+    ITEMIDLIST *pidl;
+    ITEMIDLIST *history[100];
+    int nhistory, history_pos;
+    WCHAR title[MAX_PATH];
+    RECT rc, rc_close;
+};
+static struct fe_tab tabs[MAX_TABS];
+static int ntabs = 1, cur_tab, tab_hot = -1, tab_hot_close = -1, tab_hot_new;
+static RECT rc_newtab;
+static HWND tabbar;
+
+static void tabbar_layout(void)
+{
+    RECT rc;
+    int i, w, x;
+    if (!tabbar) return;
+    GetClientRect(tabbar, &rc);
+    w = ntabs ? (rc.right - S(56)) / ntabs : S(220);
+    w = max(S(90), min(S(230), w));
+    for (i = 0, x = S(6); i < ntabs; i++, x += w)
+    {
+        SetRect(&tabs[i].rc, x, S(6), x + w, rc.bottom);
+        SetRect(&tabs[i].rc_close, x + w - S(30), S(10), x + w - S(6), rc.bottom - S(4));
+    }
+    SetRect(&rc_newtab, x + S(4), S(8), x + S(36), rc.bottom - S(2));
+}
+
+/* the strip says what it shows: for programs that read windows (the gate) */
+static void tabbar_update(void)
+{
+    WCHAR text[1024];
+    int i, n;
+    if (!tabbar) return;
+    n = swprintf(text, ARRAY_SIZE(text), L"tabs=%d current=%d:", ntabs, cur_tab + 1);
+    for (i = 0; i < ntabs && n > 0 && n < ARRAY_SIZE(text) - 2; i++)
+        n += swprintf(text + n, ARRAY_SIZE(text) - n, L"%s%s", i ? L" | " : L" ", tabs[i].title);
+    SetWindowTextW(tabbar, text);
+    tabbar_layout();
+    InvalidateRect(tabbar, NULL, FALSE);
+}
+
+static void tab_navigated(const ITEMIDLIST *pidl)
+{
+    struct fe_tab *t = &tabs[cur_tab];
+    ILFree(t->pidl);
+    t->pidl = ILClone(pidl);
+    display_name(pidl, t->title, ARRAY_SIZE(t->title));
+    tabbar_update();
+}
+
+static void tab_free(struct fe_tab *t)
+{
+    int i;
+    for (i = 0; i < t->nhistory; i++) ILFree(t->history[i]);
+    ILFree(t->pidl);
+    memset(t, 0, sizeof(*t));
+}
+
+/* the window's back and forward are the current tab's: kept in it while
+ * another is shown */
+static void tab_save(void)
+{
+    struct fe_tab *t = &tabs[cur_tab];
+    memcpy(t->history, fe.history, sizeof(fe.history));
+    t->nhistory = fe.nhistory;
+    t->history_pos = fe.history_pos;
+    fe.nhistory = fe.history_pos = 0;
+}
+
+static void tab_load(int i)
+{
+    struct fe_tab *t = &tabs[i];
+    cur_tab = i;
+    memcpy(fe.history, t->history, sizeof(fe.history));
+    fe.nhistory = t->nhistory;
+    fe.history_pos = t->history_pos;
+    t->nhistory = t->history_pos = 0;
+    fe.history_move = 0;
+    if (t->pidl) { ITEMIDLIST *go = ILClone(t->pidl); navigate(go); ILFree(go); }
+    tabbar_update();
+}
+
+static void tab_switch(int i)
+{
+    if (i < 0 || i >= ntabs || i == cur_tab) return;
+    tab_save();
+    tab_load(i);
+}
+
+static void tab_new(const ITEMIDLIST *pidl)
+{
+    if (ntabs >= MAX_TABS) return;
+    tab_save();
+    memset(&tabs[ntabs], 0, sizeof(tabs[ntabs]));
+    lstrcpyW(tabs[ntabs].title, L"Home");
+    cur_tab = ntabs++;
+    fe.history_move = 0;
+    tabbar_update();
+    navigate(pidl ? pidl : fe.quick);
+}
+
+static void tab_close(int i)
+{
+    if (i < 0 || i >= ntabs) return;
+#ifndef SG_MUTANT_TABS_CLOSE_WINDOW
+    if (ntabs == 1)
+#endif
+    {
+        PostMessageW(fe.hwnd, WM_CLOSE, 0, 0);
+        return;
+    }
+    if (i == cur_tab)
+    {
+        int k;
+        for (k = 0; k < fe.nhistory; k++) ILFree(fe.history[k]);
+        fe.nhistory = fe.history_pos = 0;
+        tab_free(&tabs[i]);
+        memmove(&tabs[i], &tabs[i + 1], (ntabs - i - 1) * sizeof(tabs[0]));
+        ntabs--;
+        tab_load(min(i, ntabs - 1));
+        return;
+    }
+    tab_free(&tabs[i]);
+    memmove(&tabs[i], &tabs[i + 1], (ntabs - i - 1) * sizeof(tabs[0]));
+    ntabs--;
+    if (i < cur_tab) cur_tab--;
+    tabbar_update();
+}
+
+static void draw_x(HDC dc, const RECT *rc, COLORREF color, int size)
+{
+    int cx = (rc->left + rc->right) / 2, cy = (rc->top + rc->bottom) / 2, h = size / 2;
+    HPEN pen = CreatePen(PS_SOLID, max(1, S(1)), color), old = SelectObject(dc, pen);
+    MoveToEx(dc, cx - h, cy - h, NULL); LineTo(dc, cx + h + 1, cy + h + 1);
+    MoveToEx(dc, cx + h, cy - h, NULL); LineTo(dc, cx - h - 1, cy + h + 1);
+    SelectObject(dc, old);
+    DeleteObject(pen);
+}
+
+static void tabbar_paint(HWND hwnd)
+{
+    struct paint p;
+    HDC dc = begin_paint(hwnd, &p);
+    RECT rc;
+    int i;
+
+    fill(dc, &p.rc, blend(C_BG, C_TEXT, 6));
+    SetBkMode(dc, TRANSPARENT);
+    for (i = 0; i < ntabs; i++)
+    {
+        struct fe_tab *t = &tabs[i];
+        rc = t->rc;
+        if (i == cur_tab)
+        {
+            HPEN pen = CreatePen(PS_SOLID, 1, C_BORDER), oldp = SelectObject(dc, pen);
+            SetDCBrushColor(dc, C_BG);
+            SelectObject(dc, GetStockObject(DC_BRUSH));
+            RoundRect(dc, rc.left, rc.top, rc.right, rc.bottom + S(8), S(10), S(10));
+            SelectObject(dc, oldp);
+            DeleteObject(pen);
+        }
+        else if (i == tab_hot)
+        {
+            RECT hot = { rc.left + S(2), rc.top + S(2), rc.right - S(2), rc.bottom - S(4) };
+            fill(dc, &hot, blend(C_BG, C_TEXT, 12));
+        }
+        else if (i + 1 != cur_tab && i + 1 < ntabs)   /* a divider between tabs */
+        {
+            RECT d = { rc.right - 1, rc.top + S(8), rc.right, rc.bottom - S(8) };
+            fill(dc, &d, C_BORDER);
+        }
+        rc.left += S(12); rc.right = t->rc_close.left - S(4);
+        SetTextColor(dc, i == cur_tab ? C_TEXT : C_MUTED);
+        DrawTextW(dc, t->title[0] ? t->title : L"Home", -1, &rc, DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS | DT_NOPREFIX);
+        if (i == tab_hot_close) fill(dc, &t->rc_close, i == cur_tab ? C_HOT : blend(C_BG, C_TEXT, 18));
+        draw_x(dc, &t->rc_close, C_MUTED, S(8));
+    }
+    if (tab_hot_new) fill(dc, &rc_newtab, blend(C_BG, C_TEXT, 12));
+    {
+        int cx = (rc_newtab.left + rc_newtab.right) / 2, cy = (rc_newtab.top + rc_newtab.bottom) / 2, h = S(6);
+        HPEN pen = CreatePen(PS_SOLID, max(1, S(1)), C_TEXT), old = SelectObject(dc, pen);
+        MoveToEx(dc, cx - h, cy, NULL); LineTo(dc, cx + h + 1, cy);
+        MoveToEx(dc, cx, cy - h, NULL); LineTo(dc, cx, cy + h + 1);
+        SelectObject(dc, old);
+        DeleteObject(pen);
+    }
+    end_paint(hwnd, &p);
+}
+
+static int tab_at(POINT pt, BOOL *on_close)
+{
+    int i;
+    for (i = 0; i < ntabs; i++)
+        if (PtInRect(&tabs[i].rc, pt))
+        {
+            if (on_close) *on_close = PtInRect(&tabs[i].rc_close, pt);
+            return i;
+        }
+    return -1;
+}
+
+static LRESULT CALLBACK tabbar_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    POINT pt = { GET_X_LPARAM(lp), GET_Y_LPARAM(lp) };
+    BOOL on_close = FALSE;
+    int i;
+
+    switch (msg)
+    {
+    case WM_PAINT: tabbar_paint(hwnd); return 0;
+    case WM_ERASEBKGND: return 1;
+    case WM_SIZE: tabbar_layout(); InvalidateRect(hwnd, NULL, FALSE); return 0;
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        int hot_new = PtInRect(&rc_newtab, pt);
+        i = tab_at(pt, &on_close);
+        if (i != tab_hot || (on_close ? i : -1) != tab_hot_close || hot_new != tab_hot_new)
+        {
+            tab_hot = i; tab_hot_close = on_close ? i : -1; tab_hot_new = hot_new;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        TrackMouseEvent(&tme);
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        tab_hot = tab_hot_close = -1; tab_hot_new = FALSE;
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONDOWN:
+        if (PtInRect(&rc_newtab, pt)) { tab_new(NULL); return 0; }
+        if ((i = tab_at(pt, &on_close)) < 0) return 0;
+        if (on_close) tab_close(i); else tab_switch(i);
+        return 0;
+    case WM_MBUTTONUP:
+        if ((i = tab_at(pt, NULL)) >= 0) tab_close(i);
+        return 0;
+    case WM_LBUTTONDBLCLK:
+        if (tab_at(pt, NULL) < 0 && !PtInRect(&rc_newtab, pt)) tab_new(NULL);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
 /* back and forward: where the window has been */
 static void record_navigation(const ITEMIDLIST *pidl)
 {
@@ -4019,6 +4276,7 @@
     }
     fe.can_back = fe.history_pos > 0;
     fe.can_forward = fe.history_pos < fe.nhistory - 1;
+    tab_navigated(pidl);
 }
 
