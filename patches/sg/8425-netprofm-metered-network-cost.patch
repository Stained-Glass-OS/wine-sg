From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netprofm: a metered network costs Fixed, as Windows tells programs

A network set as metered (Settings > Network > "Set as metered connection",
NetworkManager's connection.metered; sg-session 0.1.0-308) made no difference
to Windows programs: the Network List Manager's cost came only from the
medium's DefaultMediaCost (i1074). As Windows reports it, a metered network's
cost is now NLM_CONNECTION_COST_FIXED -- INetworkCostManager::GetCost (also to
a destination) and the connection's INetworkConnectionCost::GetCost, so
Windows.Networking.Connectivity's ConnectionCost too -- and a network set as
not metered Unrestricted; NetworkManager's own guess of metered (a phone's
hotspot, mobile broadband) is Fixed too, as Windows takes cellular as metered;
otherwise the medium's cost as before. The setting is asked from sg-netctl's
"cost" (every adapter's, matched by MAC address) only when a program asks for
the cost, at most every 10 seconds.

Gate test/nlmmetered-gate.sh (probe test/nlmmetered-probe.c); mutant
SG_MUTANT_NLM_NO_METERED.
---
--- a/dlls/netprofm/list.c
+++ b/dlls/netprofm/list.c
@@ -38,6 +38,7 @@
 
 #include "wine/debug.h"
 #include "wine/list.h"
+#include "wine/sgnetctl.h"
 #include "netprofm_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(netprofm);
@@ -75,6 +76,11 @@
     NLM_CONNECTIVITY       connectivity;
     NLM_DOMAIN_TYPE        domain_type;
     DWORD                  cost;
+    /* Stained Glass OS (vpn2): the medium's cost, and the adapter's address, by which its
+     * network's metered setting is found */
+    DWORD                  media_cost;
+    BYTE                   mac[MAX_ADAPTER_ADDRESS_LENGTH];
+    DWORD                  mac_len;
 };
 
 struct connection_point
@@ -1043,6 +1049,7 @@
 }
 
 static BOOL map_address_6to4( const SOCKADDR_IN6 *addr6, SOCKADDR_IN *addr4 );
+static DWORD connection_cost( struct connection *connection );
 
 static HRESULT WINAPI cost_manager_GetCost(
     INetworkCostManager *iface, DWORD *pCost, NLM_SOCKADDR *pDestIPAddr)
@@ -1059,6 +1066,17 @@
 
     if (!pCost) return E_POINTER;
     EnterCriticalSection( &mgr->cs );
+    /* the cost of the connection that reaches the internet, as update_totals picks it; with
+     * none, of a network the machine is on (a metered network is metered without the internet) */
+    {
+        struct connection *pick = NULL;
+        LIST_FOR_EACH_ENTRY( connection, &mgr->connections, struct connection, entry )
+        {
+            if (connection->connected_to_internet) { pick = connection; break; }
+            if (!pick && connection->connected) pick = connection;
+        }
+        if (pick) mgr->cost = connection_cost( pick );
+    }
     *pCost = mgr->cost;
     /* to a destination: the cost of the connection that reaches it */
     if (dst && dst->sa_family == AF_INET) dst4 = (SOCKADDR_IN *)dst;
@@ -1067,7 +1085,7 @@
         !ConvertInterfaceIndexToLuid( index, &luid ) && !ConvertInterfaceLuidToGuid( &luid, &id ))
     {
         LIST_FOR_EACH_ENTRY( connection, &mgr->connections, struct connection, entry )
-            if (IsEqualGUID( &connection->id, &id )) *pCost = connection->cost;
+            if (IsEqualGUID( &connection->id, &id )) *pCost = connection_cost( connection );
     }
     LeaveCriticalSection( &mgr->cs );
     return S_OK;
@@ -2450,7 +2468,7 @@
     TRACE( "%p, %p\n", iface, pCost );
 
     if (!pCost) return E_POINTER;
-    *pCost = conn->cost;
+    *pCost = connection_cost( conn );
     return S_OK;
 }
 
@@ -2531,7 +2549,89 @@
     network->connected_to_internet = connection->connected_to_internet =
         (conn & (NLM_CONNECTIVITY_IPV4_INTERNET | NLM_CONNECTIVITY_IPV6_INTERNET)) ? VARIANT_TRUE : VARIANT_FALSE;
     network->domain_type = connection->domain_type = adapter_domain_type( aa );
-    connection->cost = media_cost( aa->IfType );
+    connection->cost = connection->media_cost = media_cost( aa->IfType );
+    connection->mac_len = min( aa->PhysicalAddressLength, sizeof(connection->mac) );
+    memcpy( connection->mac, aa->PhysicalAddress, connection->mac_len );
+}
+
+/* Stained Glass OS (vpn2): "Set as metered connection" (Settings > Network) is the network's,
+ * NetworkManager's connection.metered, which Linux programs honour too; sg-netctl's "cost" gives
+ * every adapter's (yes, no, guess-yes, guess-no, unknown) in one call. Asked only when a program
+ * asks the cost, and again after 10 seconds at the earliest. A metered network costs Fixed, as
+ * Windows reports a network set as metered; NetworkManager's own guess of metered (a phone's
+ * hotspot, mobile broadband) too; otherwise the medium's cost (DefaultMediaCost). */
+static CRITICAL_SECTION metered_cs;
+static CRITICAL_SECTION_DEBUG metered_cs_debug =
+{
+    0, 0, &metered_cs,
+    { &metered_cs_debug.ProcessLocksList, &metered_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": metered_cs") }
+};
+static CRITICAL_SECTION metered_cs = { &metered_cs_debug, -1, 0, 0, 0, 0 };
+static struct { BYTE mac[6]; int metered; } metered_list[32];
+static int metered_count;
+static DWORD metered_when;
+static BOOL metered_asked;
+
+static int parse_mac( const WCHAR *str, BYTE *mac )
+{
+    unsigned int b[6];
+    int i;
+    if (swscanf( str, L"%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5] ) != 6) return 0;
+    for (i = 0; i < 6; i++) mac[i] = b[i];
+    return 1;
+}
+
+static void refresh_metered(void)
+{
+    struct sgnet_reply r;
+    int i;
+
+    EnterCriticalSection( &metered_cs );
+    if (metered_asked && GetTickCount() - metered_when < 10000)
+    {
+        LeaveCriticalSection( &metered_cs );
+        return;
+    }
+    metered_asked = TRUE;
+    metered_count = 0;
+#ifndef SG_MUTANT_NLM_NO_METERED
+    if (sgnet_request( (const WCHAR *const[]){ L"cost" }, 1, &r ) > 0)
+    {
+        for (i = 0; i < r.count && metered_count < ARRAY_SIZE(metered_list); i++)
+        {
+            WCHAR dev[64], mac[64], state[32];
+            if (swscanf( r.lines[i], L"COST %63s %63s %31s", dev, mac, state ) != 3) continue;
+            if (!parse_mac( mac, metered_list[metered_count].mac )) continue;
+            metered_list[metered_count].metered = !wcscmp( state, L"yes" ) || !wcscmp( state, L"guess-yes" ) ? 1
+                                                  : !wcscmp( state, L"no" ) ? 0 : -1;
+            metered_count++;
+        }
+        sgnet_free( &r );
+    }
+#endif
+    metered_when = GetTickCount();     /* from the answer: the next look is 10 s after it */
+    LeaveCriticalSection( &metered_cs );
+}
+
+/* the connection's cost now: its network's metered setting, else its medium's */
+static DWORD connection_cost( struct connection *connection )
+{
+    DWORD cost = connection->media_cost;
+    int i;
+
+    refresh_metered();
+    EnterCriticalSection( &metered_cs );
+    for (i = 0; i < metered_count; i++)
+    {
+        if (connection->mac_len != 6 || memcmp( metered_list[i].mac, connection->mac, 6 )) continue;
+        if (metered_list[i].metered == 1) cost = NLM_CONNECTION_COST_FIXED;
+        else if (!metered_list[i].metered) cost = NLM_CONNECTION_COST_UNRESTRICTED;
+        break;
+    }
+    LeaveCriticalSection( &metered_cs );
+    connection->cost = cost;
+    return cost;
 }
 
 static void update_totals( struct list_manager *mgr )
