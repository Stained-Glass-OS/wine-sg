     if (IsEqualIID(&IID_IUnknown, riid) ||
+#ifdef SG_MUTANT_MONIKER_IPERSIST
         IsEqualIID(&IID_IPersist, riid) ||
+#endif
         IsEqualIID(&IID_IPersistStream, riid) ||
         IsEqualIID(&IID_IMoniker, riid) ||
         IsEqualGUID(&CLSID_AntiMoniker, riid))
