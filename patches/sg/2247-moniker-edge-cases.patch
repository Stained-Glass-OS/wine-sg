     if (FAILED(hr))
     {
         hr = FileMoniker_CreateFromDisplayName(pbc, szDisplayName, &chEaten, &moniker);
+        /* Stained Glass OS: a name without a path separator (an unknown
+         * ProgID, "clsid:") is a syntax error, not a file that can't be opened */
