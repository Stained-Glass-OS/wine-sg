@@ -1819,8 +1840,83 @@ HRESULT WINAPI CreateGenericComposite(IMoniker *left, IMoniker *right, IMoniker
 HRESULT WINAPI
 MonikerCommonPrefixWith(IMoniker* pmkThis,IMoniker* pmkOther,IMoniker** ppmkCommon)
 {
-    FIXME("(),stub!\n");
+    CompositeMonikerImpl *this_composite, *other_composite;
+    IMoniker **components, **other_components;
+    unsigned int count, other_count, n;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", pmkThis, pmkOther, ppmkCommon);
+
+#ifdef SG_MUTANT_MONIKER_PREFIX
     return E_NOTIMPL;
+#endif
+    /* Stained Glass OS: the generic prefix of two monikers where at least one
+     * is a generic composite (the simple monikers call this for anything
+     * they can't compare themselves); two simple monikers have none. */
+    if (!ppmkCommon)
+        return E_INVALIDARG;
+    *ppmkCommon = NULL;
+
+    if (!pmkThis || !pmkOther)
+        return MK_E_NOPREFIX;
+
+    this_composite = unsafe_impl_from_IMoniker(pmkThis);
+    other_composite = unsafe_impl_from_IMoniker(pmkOther);
+
+    if (!this_composite && !other_composite)
+        return MK_E_NOPREFIX;
+
+    if (!this_composite || !other_composite)
+    {
+        /* a simple moniker against a composite: only its leftmost component
+         * can be a common prefix */
+        IMoniker *simple = this_composite ? pmkOther : pmkThis, *first, *prefix;
+
+        if (FAILED(hr = composite_get_leftmost(this_composite ? this_composite : other_composite, &first)))
+            return hr;
+
+        if (IMoniker_IsEqual(simple, first) == S_OK)
+        {
+            *ppmkCommon = first;
+            return this_composite ? MK_S_HIM : MK_S_ME;
+        }
+
+        hr = IMoniker_CommonPrefixWith(simple, first, &prefix);
+        IMoniker_Release(first);
+        if (FAILED(hr))
+            return hr;
+
+        *ppmkCommon = prefix;
+        /* MK_S_ME: the simple moniker is the prefix of the first component
+         * and so of the composite; otherwise a proper prefix of both */
+        if (hr == MK_S_ME)
+            return this_composite ? MK_S_HIM : MK_S_ME;
+        return S_OK;
+    }
+
+    if (FAILED(hr = composite_get_components_alloc(pmkThis, &count, &components)))
+        return hr;
+    if (FAILED(hr = composite_get_components_alloc(pmkOther, &other_count, &other_components)))
+    {
+        free(components);
+        return hr;
+    }
+
+    for (n = 0; n < min(count, other_count); ++n)
+        if (IMoniker_IsEqual(components[n], other_components[n]) != S_OK) break;
+
+    hr = S_OK;
+    if (n)
+        hr = composite_compose_components(components, n, ppmkCommon);
+    free(components);
+    free(other_components);
+    if (FAILED(hr))
+        return hr;
+
+    if (n == count && n == other_count) return MK_S_US;
+    if (n == count) return MK_S_ME;
+    if (n == other_count) return MK_S_HIM;
+    return S_OK;
 }
 
