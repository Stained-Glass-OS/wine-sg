         IsEqualGUID(&CLSID_PointerMoniker, riid))
@@ -388,6 +390,11 @@ static HRESULT WINAPI PointerMonikerImpl_GetDisplayName(IMoniker *iface, IBindCt
         return E_INVALIDARG;
     }
 
+    /* Stained Glass OS: a pointer moniker has no display name, and one that
+     * holds no object at all isn't even a valid ROT key (E_INVALIDARG) */
+#ifndef SG_MUTANT_POINTER_NULL
+    if (!impl_from_IMoniker(iface)->pObject) return E_INVALIDARG;
+#endif
     return E_NOTIMPL;
 }
 
