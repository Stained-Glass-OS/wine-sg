+        if (hr == MK_E_CANTOPENFILE && !wcspbrk( szDisplayName, L"\\/" ))
+            hr = MK_E_SYNTAX;
+#endif
         if (FAILED(hr) && (hr != MK_E_SYNTAX))
             return hr;
     }
