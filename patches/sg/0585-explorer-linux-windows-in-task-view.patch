+/* Stained Glass OS: the session's Linux programs' windows (a terminal) are
+ * shown too -- as the taskbar knows them, by their hidden stand-in window --
+ * on every desktop, as a card with their icon; clicking one brings the
+ * program forward, and Close closes it (David: the Linux terminal was missing
+ * from Task View). */
+static BOOL is_linux_window( HWND hwnd )
+{
+    WCHAR class[32];
+    DWORD pid;
+    return GetWindowThreadProcessId( hwnd, &pid ) && pid == GetCurrentProcessId() &&
+           GetClassNameW( hwnd, class, ARRAY_SIZE(class) ) && !wcscmp( class, L"SgLinuxWindow" );
+}
+
+static HICON window_icon( HWND hwnd, BOOL little )
+{
+    HICON icon = (HICON)GetClassLongPtrW( hwnd, little ? GCLP_HICONSM : GCLP_HICON );
+    if (!icon) icon = (HICON)SendMessageW( hwnd, WM_GETICON, little ? ICON_SMALL : ICON_BIG, 0 );
+    return icon;
+}
+
 static BOOL CALLBACK collect_proc( HWND hwnd, LPARAM lparam )
 {
     int want = (int)lparam, d;
 
     if (tv.n >= ARRAY_SIZE(tv.items)) return FALSE;
+    if (is_linux_window( hwnd ))
+    {
+        tv.items[tv.n++].hwnd = hwnd;
+        return TRUE;
+    }
     if (!IsWindowVisible( hwnd ) || !is_app_window( hwnd )) return TRUE;
     d = desktop_of( hwnd );
     if (d >= 0 && d != want) return TRUE;
