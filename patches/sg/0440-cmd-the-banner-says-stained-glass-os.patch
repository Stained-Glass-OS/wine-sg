From: Stained Glass OS <dev@stained-glass.example>
Subject: cmd: the banner says Stained Glass OS; the console title is not Wine's

An interactive Command Prompt opened with "Microsoft Windows 10.0.19045"
under a "Wine Command Prompt" title. The banner now reads "Stained Glass OS
[Version 10.0.19045]" and the title "Command Prompt". `ver` and the %V
prompt code keep "Microsoft Windows <version>": batch scripts parse it.
Gate: make test-cmdbanner.
---
--- a/programs/cmd/wcmd.h
+++ b/programs/cmd/wcmd.h
@@ -449,4 +449,5 @@
 #define WCMD_FILENAMETOOLONG  1046
 #define WCMD_BADTOKEN         1047
 #define WCMD_ENDOFLINE        1048
+#define WCMD_BANNER           1050
 #define WCMD_ENDOFFILE        1049
--- a/programs/cmd/cmd.rc
+++ b/programs/cmd/cmd.rc
@@ -388,8 +388,9 @@
   WCMD_VOLUMESERIALNO, "Volume Serial Number is %1!04x!-%2!04x!\n\n"
   WCMD_VOLUMEPROMPT, "Volume label (11 characters, <Enter> for none)?"
   WCMD_ANYKEY,"Press any key to continue... "
-  WCMD_CONSTITLE,"Wine Command Prompt"
+  WCMD_CONSTITLE,"Command Prompt"
   WCMD_VERSION,"Microsoft Windows %1!S!\n"
+  WCMD_BANNER,"Stained Glass OS [Version %1!S!]\n"
   WCMD_MOREPROMPT, "More? "
   WCMD_LINETOOLONG, "The input line is too long.\n"
   WCMD_VOLUMELABEL, "Volume in drive %1!c! is %2\n"
--- a/programs/cmd/wcmdmain.c
+++ b/programs/cmd/wcmdmain.c
@@ -45,7 +45,7 @@
 int defaultColor = 7;
 BOOL echo_mode = TRUE;
 
-WCHAR anykey[100], version_string[100];
+WCHAR anykey[100], version_string[100], banner_string[100];
 
 static BOOL opt_c, opt_k, opt_s, unicodeOutput = FALSE;
 
@@ -3886,6 +3886,11 @@
   cmd = WCMD_format_string(WCMD_LoadMessage(WCMD_VERSION), osver);
   lstrcpyW(version_string, cmd);
   LocalFree(cmd);
+  /* Stained Glass OS: the banner an interactive prompt opens with names our
+   * system; `ver` (and the %V prompt code) keep the text scripts parse. */
+  cmd = WCMD_format_string(WCMD_LoadMessage(WCMD_BANNER), osver);
+  lstrcpyW(banner_string, cmd);
+  LocalFree(cmd);
   cmd = NULL;
 
   /* init for loop context */
@@ -4218,7 +4223,7 @@
  */
 
   interactive = TRUE;
-  if (!opt_k) WCMD_output_asis(version_string);
+  if (!opt_k) WCMD_output_asis(banner_string);
   if (echo_mode) WCMD_output_asis(L"\r\n");
   /* Read until EOF (which for std input is never, but if redirect in place, may occur */
   while ((rpl_status = WCMD_ReadAndParseLine(NULL, &toExecute)) != RPL_EOF)
