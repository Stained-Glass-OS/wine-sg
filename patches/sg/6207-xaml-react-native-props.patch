+/* attached booleans: an element's value */
+static HRESULT get_attached_boolean( struct xaml_property *prop, IInspectable *element, boolean *value )
+{
+    struct dobj *d = dobj_from_inspectable( element );
+    IInspectable *box = NULL;
+
+    if (!value) return E_POINTER;
+    if (!d) return E_INVALIDARG;
+    dobj_get_value( d, prop, &box );
+    *value = xunbox_boolean( box, FALSE );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT set_attached_boolean( struct xaml_property *prop, IInspectable *element, boolean value )
+{
+    struct dobj *d = dobj_from_inspectable( element );
+    IInspectable *box;
+    HRESULT hr;
+
+    if (!d) return E_INVALIDARG;
+    if (!(box = xbox_boolean( value ))) return E_OUTOFMEMORY;
+    hr = dobj_set_value( d, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
