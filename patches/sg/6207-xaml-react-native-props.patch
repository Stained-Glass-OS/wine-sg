+}
+
+/* the rectangle its Clip leaves drawn, in its own coordinates; FALSE: none */
+BOOL xaml_element_clip( struct uielem *elem, struct xrect *rect )
+{
+    IInspectable *clip = NULL;
+    BOOL ret;
+
+#ifdef SG_MUTANT_XAML_CLIP_IGNORED
+    return FALSE;
+#endif
+    if (!prop_clip || FAILED(dobj_get_value( &elem->d, prop_clip, &clip )) || !clip) return FALSE;
+    ret = xaml_geometry_rect( clip, rect );
+    IInspectable_Release( clip );
+    return ret;
+}
