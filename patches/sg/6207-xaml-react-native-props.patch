+/* ---- RectangleGeometry: its Rect, a dependency property (an element's Clip is one) ---- */
+
+static const GUID IID_IReference_Rect_geometry = { 0x80423f11, 0x054f, 0x5eac, { 0xaf, 0xd3, 0x63, 0xb6, 0xce, 0x15, 0xe7, 0x7b } };
+static struct xaml_property *prop_rect;
+
+static void rect_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    xaml_invalidate_visuals();
+}
+
+static BOOL WINAPI init_rect_props( INIT_ONCE *once, void *param, void **context )
+{
+    struct xrect empty = { 0 };
+    prop_rect = xaml_property_register( L"Windows.UI.Xaml.Media.RectangleGeometry", L"Rect", L"Windows.Foundation.Rect",
+                                        xbox_ref( &IID_IReference_Rect_geometry, &empty, sizeof(empty) ), FALSE, rect_changed );
+    return TRUE;
+}
+
+static void rect_props_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_rect_props, NULL, NULL );
+}
+
+struct rect_geometry
+{
+    struct dobj d;
+    struct xiface IGeometry_iface, IRectangleGeometry_iface;
+};
+
+static const struct xiface_entry rect_geometry_ifaces[] =
+{
+    { &IID_IRectangleGeometry, offsetof(struct rect_geometry, IRectangleGeometry_iface) },
+    { &IID_IGeometry, offsetof(struct rect_geometry, IGeometry_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void rect_geometry_destroy( struct xobj *obj )
+{
+    dobj_cleanup( &CONTAINING_RECORD( obj, struct rect_geometry, d.obj )->d );
+}
+
+static const struct xclass rect_geometry_class =
+{
+    L"Windows.UI.Xaml.Media.RectangleGeometry", rect_geometry_ifaces, ARRAY_SIZE(rect_geometry_ifaces), rect_geometry_destroy,
+};
+
+static void get_rect( struct rect_geometry *geometry, struct xrect *rect )
+{
+    IInspectable *box = NULL;
+
+    memset( rect, 0, sizeof(*rect) );
+    dobj_get_value( &geometry->d, prop_rect, &box );
+    if (box)
+    {
+        xunbox_ref( box, &IID_IReference_Rect_geometry, rect, sizeof(*rect) );
+        IInspectable_Release( box );
+    }
+}
+
+static HRESULT WINAPI rect_geometry_get_Bounds( struct xiface *iface, struct xrect *value )
+{
+    if (!value) return E_POINTER;
+    get_rect( CONTAINING_RECORD( iface->obj, struct rect_geometry, d.obj ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_geometry_get_Rect( struct xiface *iface, struct xrect *value )
+{
+    return rect_geometry_get_Bounds( iface, value );
+}
+
+static HRESULT WINAPI rect_geometry_put_Rect( struct xiface *iface, struct xrect value )
+{
+    struct rect_geometry *geometry = CONTAINING_RECORD( iface->obj, struct rect_geometry, d.obj );
+    IInspectable *box = xbox_ref( &IID_IReference_Rect_geometry, &value, sizeof(value) );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &geometry->d, prop_rect, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static const void *rect_geometry_vtbl[] = { IGeometry_STUBS, [IGeometry_Bounds] = rect_geometry_get_Bounds };
+static const void *rectangle_geometry_vtbl[] =
+{
+    IRectangleGeometry_STUBS,
+    [IRectangleGeometry_Rect] = rect_geometry_get_Rect,
+    [IRectangleGeometry_SetRect] = rect_geometry_put_Rect,
+};
+
+/* the rectangle of a RectangleGeometry of ours */
+BOOL xaml_geometry_rect( IInspectable *obj, struct xrect *rect )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+
+    if (!d || d->obj.cls != &rect_geometry_class) return FALSE;
+    get_rect( CONTAINING_RECORD( d, struct rect_geometry, d ), rect );
+    return TRUE;
+}
+
+static HRESULT activate_rect_geometry( IInspectable **out )
+{
+    struct rect_geometry *geometry;
+
+#ifdef SG_MUTANT_NO_RECTANGLE_GEOMETRY
+    return E_NOTIMPL;
+#endif
+    rect_props_init();
+    if (!(geometry = calloc( 1, sizeof(*geometry) ))) return E_OUTOFMEMORY;
+    geometry->IGeometry_iface.vtbl = rect_geometry_vtbl;
+    geometry->IRectangleGeometry_iface.vtbl = rectangle_geometry_vtbl;
+    dobj_init( &geometry->d, &rect_geometry_class, NULL );
+    *out = (IInspectable *)&geometry->IRectangleGeometry_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI rect_statics_get_RectProperty( struct xfiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    rect_props_init();
+    IInspectable_AddRef( (*value = xaml_property_iface( prop_rect )) );
+    return S_OK;
+}
+
+static const void *rect_statics_vtbl[] = { XFIFACE_COMMON, rect_statics_get_RectProperty };
+C_ASSERT( ARRAY_SIZE(rect_statics_vtbl) == IRectangleGeometryStatics_slots );
+
+static struct xfactory rect_geometry_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Media.RectangleGeometry",
+                                                     { &IID_IRectangleGeometryStatics }, { { rect_statics_vtbl } },
+                                                     activate_rect_geometry };
+IActivationFactory *rect_geometry_factory = &rect_geometry_factory_obj.IActivationFactory_iface;
