diff --git a/dlls/windows.ui.xaml/transforms3d.c b/dlls/windows.ui.xaml/transforms3d.c
new file mode 100644
index 0000000..42b762d
--- /dev/null
+++ b/dlls/windows.ui.xaml/transforms3d.c
@@ -0,0 +1,205 @@
+/*
+ * Windows.UI.Xaml.Media.Media3D: PerspectiveTransform3D, CompositeTransform3D
+ *
+ * Copyright 2026 Stained Glass OS
+ *
