+/******************************************************************************
+ * SetStandardColorSpaceProfileW               [MSCMS.@]
+ *
+ * Register the profile used for a standard color space id.
+ */
+BOOL WINAPI SetStandardColorSpaceProfileW( PCWSTR machine, DWORD id, PWSTR profile )
+{
+    WCHAR name[5];
+    HKEY key;
+    LONG res;
+
+    TRACE( "( %s, %#lx, %s )\n", debugstr_w(machine), id, debugstr_w(profile) );
+
+    if (machine)
+    {
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (!profile || !*profile)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if ((res = RegCreateKeyExW( HKEY_CURRENT_USER, icm_registered_profiles, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    standard_space_name( id, name );
+    res = RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)profile, (lstrlenW( profile ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    if (res)
+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/******************************************************************************
