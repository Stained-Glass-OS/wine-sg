+/* Returns TRUE when a profile was registered for the color space and fits in the buffer; with a
+   registered profile that does not fit the last error is set to ERROR_MORE_DATA and *size updated. */
+static BOOL standard_profile_from_registry( DWORD id, PWSTR profile, PDWORD size )
+{
+    WCHAR name[5], path[MAX_PATH], full[MAX_PATH];
+    DWORD len = sizeof(path), type;
+    HKEY key;
+    BOOL ret = FALSE;
+
+    SetLastError( ERROR_SUCCESS );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, icm_registered_profiles, 0, KEY_READ, &key )) return FALSE;
+    standard_space_name( id, name );
+    if (!RegQueryValueExW( key, name, NULL, &type, (BYTE *)path, &len ) && type == REG_SZ && path[0])
+    {
+        path[ARRAY_SIZE(path) - 1] = 0;
+        if (PathIsRelativeW( path ))
+        {
+            DWORD dirlen = sizeof(full);
+            GetColorDirectoryW( NULL, full, &dirlen );
+            PathAddBackslashW( full );
+            lstrcatW( full, path );
+        }
+        else lstrcpyW( full, path );
+        len = (lstrlenW( full ) + 1) * sizeof(WCHAR);
+        if (*size < len)
+        {
+            *size = len;
+            SetLastError( ERROR_MORE_DATA );
+        }
+        else
+        {
+            lstrcpyW( profile, full );
+            *size = len;
+            ret = TRUE;
+        }
+    }
+    RegCloseKey( key );
+    return ret;
+}
