+/* Named color profiles: the 'ncl2' tag */
+
+#ifndef LCS_SIGNATURE
+#define LCS_SIGNATURE 0x50534f43 /* 'PSOC' */
+#endif
+
+#define NCL2_SIG 0x6e636c32 /* 'ncl2' */
+#define NMCL_CLASS 0x6e6d636c /* 'nmcl' */
+
+static inline DWORD be32( const BYTE *p )
+{
+    return (p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+struct ncl2
+{
+    const BYTE *data;     /* start of the tag data */
+    DWORD size;
+    DWORD flags, count, ncoords;
+    char prefix[32], suffix[32];
+    DWORD entry_size;     /* 32 byte name + 3 PCS values + device coordinates */
+};
+
+static BOOL get_ncl2( const struct profile *profile, struct ncl2 *ncl )
+{
+    struct tag_entry tag;
+    const BYTE *p;
+
+    if (!get_adjusted_tag( profile, NCL2_SIG, &tag ) || tag.size < 84) return FALSE;
+    p = (const BYTE *)profile->data + tag.offset;
+    if (be32( p ) != NCL2_SIG) return FALSE;
+    ncl->data = p;
+    ncl->size = tag.size;
+    ncl->flags = be32( p + 8 );
+    ncl->count = be32( p + 12 );
+    ncl->ncoords = be32( p + 16 );
+    memcpy( ncl->prefix, p + 20, 32 );
+    memcpy( ncl->suffix, p + 52, 32 );
+    ncl->prefix[31] = ncl->suffix[31] = 0;
+    if (ncl->ncoords > MAX_COLOR_CHANNELS) return FALSE;
+    ncl->entry_size = 32 + 6 + ncl->ncoords * 2;
+    if (ncl->count > (tag.size - 84) / ncl->entry_size) return FALSE;
+    return TRUE;
+}
+
+static void ncl2_entry_name( const struct ncl2 *ncl, DWORD index, char *name )
+{
+    char root[33], full[32 * 3 + 1];
+
+    memcpy( root, ncl->data + 84 + index * ncl->entry_size, 32 );
+    root[32] = 0;
+    snprintf( full, sizeof(full), "%s%s%s", ncl->prefix, root, ncl->suffix );
+    memset( name, 0, 32 );
+    memcpy( name, full, min( strlen( full ), 31 ) );
+}
+
+/******************************************************************************
+ * GetNamedProfileInfo               [MSCMS.@]
+ */
+BOOL WINAPI GetNamedProfileInfo( HPROFILE handle, PNAMED_PROFILE_INFO info )
+{
+    struct profile *profile = (struct profile *)grab_object( handle, OBJECT_TYPE_PROFILE );
+    struct ncl2 ncl;
+    BOOL ret = FALSE;
+
+    TRACE( "( %p, %p )\n", handle, info );
+
+    if (!profile) return FALSE;
+    if (!info)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+    }
+    else if (!get_ncl2( profile, &ncl ))
+    {
+        SetLastError( ERROR_INVALID_PROFILE );
+    }
+    else
+    {
+        info->dwFlags = ncl.flags;
+        info->dwCount = ncl.count;
+        info->dwCountDevCoordinates = ncl.ncoords;
+        memcpy( info->szPrefix, ncl.prefix, sizeof(info->szPrefix) );
+        memcpy( info->szSuffix, ncl.suffix, sizeof(info->szSuffix) );
+        ret = TRUE;
+    }
+    release_object( &profile->hdr );
+    return ret;
+}
+
+/******************************************************************************
+ * ConvertColorNameToIndex               [MSCMS.@]
+ */
+BOOL WINAPI ConvertColorNameToIndex( HPROFILE handle, PCOLOR_NAME names, PDWORD indices, DWORD count )
+{
+    struct profile *profile = (struct profile *)grab_object( handle, OBJECT_TYPE_PROFILE );
+    BOOL ret = FALSE;
+    struct ncl2 ncl;
+    DWORD i, j;
+
+    TRACE( "( %p, %p, %p, %lu )\n", handle, names, indices, count );
+
+    if (!profile) return FALSE;
+    if (!names || !indices || !count)
+        SetLastError( ERROR_INVALID_PARAMETER );
+    else if (!get_ncl2( profile, &ncl ))
+        SetLastError( ERROR_INVALID_PROFILE );
+    else
+    {
+        ret = TRUE;
+        for (i = 0; i < count; i++)
+        {
+            char full[32], root[33];
+
+            indices[i] = ~0u;
+            for (j = 0; j < ncl.count; j++)
+            {
+                ncl2_entry_name( &ncl, j, full );
+                memcpy( root, ncl.data + 84 + j * ncl.entry_size, 32 );
+                root[32] = 0;
+                if (!strncmp( names[i], full, 32 ) || !strncmp( names[i], root, 32 ))
+                {
+                    indices[i] = j + 1; /* indices start at one */
+                    break;
+                }
+            }
+            if (indices[i] == ~0u)
+            {
+                SetLastError( ERROR_INVALID_PARAMETER );
+                ret = FALSE;
+                break;
+            }
+        }
+    }
+    release_object( &profile->hdr );
+    return ret;
+}
+
+/******************************************************************************
+ * ConvertIndexToColorName               [MSCMS.@]
+ */
+BOOL WINAPI ConvertIndexToColorName( HPROFILE handle, PDWORD indices, PCOLOR_NAME names, DWORD count )
+{
+    struct profile *profile = (struct profile *)grab_object( handle, OBJECT_TYPE_PROFILE );
+    BOOL ret = FALSE;
+    struct ncl2 ncl;
+    DWORD i;
+
+    TRACE( "( %p, %p, %p, %lu )\n", handle, indices, names, count );
+
+    if (!profile) return FALSE;
+    if (!names || !indices || !count)
+        SetLastError( ERROR_INVALID_PARAMETER );
+    else if (!get_ncl2( profile, &ncl ))
+        SetLastError( ERROR_INVALID_PROFILE );
+    else
+    {
+        ret = TRUE;
+        for (i = 0; i < count; i++)
+        {
+            if (!indices[i] || indices[i] > ncl.count)
+            {
+                SetLastError( ERROR_INVALID_PARAMETER );
+                ret = FALSE;
+                break;
+            }
+            ncl2_entry_name( &ncl, indices[i] - 1, names[i] );
+        }
+    }
+    release_object( &profile->hdr );
+    return ret;
+}
+
+/* Rebuilding a profile with a changed tag table */
+
+struct blob
+{
+    DWORD offset, size;      /* in the old profile */
+    DWORD new_size;
+};
+
+static BOOL rebuild_profile( struct profile *profile, TAGTYPE type, TAGTYPE ref, DWORD new_size, BOOL link )
+{
+    DWORD i, count = get_tag_count( profile ), nblobs = 0, nsigs, pos, total;
+    struct tag_entry *entries = NULL;
+    struct blob *blobs = NULL;
+    DWORD *blob_of = NULL;
+    char *out = NULL;
+    BOOL ret = FALSE, found = FALSE;
+    cmsHPROFILE cmsprofile;
+    DWORD target_blob = ~0u, ref_blob = ~0u;
+
+    if (count > 4096 || profile->size < sizeof(PROFILEHEADER) + sizeof(DWORD)) return FALSE;
+    nsigs = count + 1;
+    entries = calloc( nsigs, sizeof(*entries) );
+    blobs = calloc( nsigs, sizeof(*blobs) );
+    blob_of = calloc( nsigs, sizeof(*blob_of) );
+    if (!entries || !blobs || !blob_of) goto done;
+
+    for (i = 0; i < count; i++)
+    {
+        DWORD b;
+
+        if (!get_tag_entry( profile, i + 1, &entries[i] )) goto done;
+        for (b = 0; b < nblobs; b++)
+            if (blobs[b].offset == entries[i].offset && blobs[b].size == entries[i].size) break;
+        if (b == nblobs)
+        {
+            blobs[b].offset = entries[i].offset;
+            blobs[b].size = blobs[b].new_size = entries[i].size;
+            nblobs++;
+        }
+        blob_of[i] = b;
+        if (entries[i].sig == type) { found = TRUE; target_blob = b; }
+        if (link && entries[i].sig == ref) ref_blob = b;
+    }
+
+    if (link && ref_blob == ~0u) goto done;
+
+    if (!found)
+    {
+        entries[count].sig = type;
+        if (link) blob_of[count] = ref_blob;
+        else
+        {
+            blobs[nblobs].offset = ~0u;
+            blobs[nblobs].size = 0;
+            blobs[nblobs].new_size = new_size;
+            blob_of[count] = nblobs++;
+        }
+        count++;
+    }
+    else if (link)
+    {
+        for (i = 0; i < count; i++) if (entries[i].sig == type) blob_of[i] = ref_blob;
+    }
+    else blobs[target_blob].new_size = new_size;
+
+    /* layout: header, tag count, tag table, then the data blobs in their original order */
+    pos = sizeof(PROFILEHEADER) + sizeof(DWORD) + count * 12;
+    {
+        DWORD *new_off = calloc( nblobs, sizeof(*new_off) );
+        BOOL *used = calloc( nblobs, sizeof(*used) );
+        DWORD *order = calloc( nblobs, sizeof(*order) );
+        DWORD n, k;
+
+        if (!new_off || !used || !order)
+        {
+            free( new_off ); free( used ); free( order );
+            goto done;
+        }
+        for (i = 0; i < count; i++) used[blob_of[i]] = TRUE;
+        for (n = 0; n < nblobs; n++) order[n] = n;
+        /* new blob goes last, the others keep the file order */
+        for (n = 0; n < nblobs; n++)
+            for (k = n + 1; k < nblobs; k++)
+                if (blobs[order[k]].offset < blobs[order[n]].offset)
+                {
+                    DWORD t = order[n]; order[n] = order[k]; order[k] = t;
+                }
+        for (n = 0; n < nblobs; n++)
+        {
+            DWORD b = order[n];
+
+            if (!used[b]) continue;
+            new_off[b] = pos;
+            pos += (blobs[b].new_size + 3) & ~3u;
+        }
+        total = pos;
+        if (!(out = calloc( 1, total )))
+        {
+            free( new_off ); free( used ); free( order );
+            goto done;
+        }
+        memcpy( out, profile->data, sizeof(PROFILEHEADER) );
+        out[0] = total >> 24; out[1] = total >> 16; out[2] = total >> 8; out[3] = total;
+        out[128] = count >> 24; out[129] = count >> 16; out[130] = count >> 8; out[131] = count;
+        for (i = 0; i < count; i++)
+        {
+            char *e = out + sizeof(PROFILEHEADER) + sizeof(DWORD) + i * 12;
+            DWORD sig = entries[i].sig, off = new_off[blob_of[i]], size = blobs[blob_of[i]].new_size;
+
+            e[0] = sig >> 24; e[1] = sig >> 16; e[2] = sig >> 8; e[3] = sig;
+            e[4] = off >> 24; e[5] = off >> 16; e[6] = off >> 8; e[7] = off;
+            e[8] = size >> 24; e[9] = size >> 16; e[10] = size >> 8; e[11] = size;
+        }
+        for (n = 0; n < nblobs; n++)
+        {
+            if (!used[n] || blobs[n].offset == ~0u) continue;
+            memcpy( out + new_off[n], profile->data + blobs[n].offset, min( blobs[n].size, blobs[n].new_size ) );
+        }
+        free( new_off ); free( used ); free( order );
+    }
+
+    if (!(cmsprofile = cmsOpenProfileFromMem( out, total ))) goto done;
+    cmsCloseProfile( profile->cmsprofile );
+    profile->cmsprofile = cmsprofile;
+    free( profile->data );
+    profile->data = out;
+    profile->size = total;
+    out = NULL;
+    ret = TRUE;
+
+done:
+    free( out );
+    free( entries );
+    free( blobs );
+    free( blob_of );
+    return ret;
+}
