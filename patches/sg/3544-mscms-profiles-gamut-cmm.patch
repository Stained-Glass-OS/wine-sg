+static const WCHAR icm_registered_profiles[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\ICM\\RegisteredProfiles";
+
+static void standard_space_name( DWORD id, WCHAR *name )
+{
+    swprintf( name, 5, L"%c%c%c%c", (id >> 24) & 0xff, (id >> 16) & 0xff, (id >> 8) & 0xff, id & 0xff );
+}
