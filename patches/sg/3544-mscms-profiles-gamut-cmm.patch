+/******************************************************************************
+ * SetColorProfileElementSize               [MSCMS.@]
+ *
+ * Resize a tag, or add it when it is not in the profile yet. The new data is zero filled.
+ */
+BOOL WINAPI SetColorProfileElementSize( HPROFILE handle, TAGTYPE type, DWORD size )
+{
+    struct profile *profile = (struct profile *)grab_object( handle, OBJECT_TYPE_PROFILE );
+    BOOL ret;
+
+    TRACE( "( %p, %#lx, %#lx )\n", handle, type, size );
+
+    if (!profile) return FALSE;
+    if (!(profile->access & PROFILE_READWRITE))
+    {
+        release_object( &profile->hdr );
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    if (!size)
+    {
+        release_object( &profile->hdr );
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    ret = rebuild_profile( profile, type, 0, size, FALSE );
+    if (!ret) SetLastError( ERROR_INVALID_PROFILE );
+    release_object( &profile->hdr );
+    return ret;
+}
+
+/******************************************************************************
+ * SetColorProfileElementReference               [MSCMS.@]
+ *
+ * Make a tag share the data of another tag.
+ */
+BOOL WINAPI SetColorProfileElementReference( HPROFILE handle, TAGTYPE type, TAGTYPE ref )
+{
+    struct profile *profile = (struct profile *)grab_object( handle, OBJECT_TYPE_PROFILE );
+    BOOL ret;
+
+    TRACE( "( %p, %#lx, %#lx )\n", handle, type, ref );
+
+    if (!profile) return FALSE;
+    if (!(profile->access & PROFILE_READWRITE))
+    {
+        release_object( &profile->hdr );
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    ret = rebuild_profile( profile, type, ref, 0, TRUE );
+    if (!ret) SetLastError( ERROR_INVALID_PROFILE );
+    release_object( &profile->hdr );
+    return ret;
+}
+
+/******************************************************************************
+ * GetPS2ColorRenderingIntent               [MSCMS.@]
+ *
+ * Name of the PostScript rendering intent stored in the header of a profile.
+ */
+BOOL WINAPI GetPS2ColorRenderingIntent( HPROFILE handle, DWORD intent, PBYTE buffer, PDWORD size )
+{
+    static const char *names[] = { "Perceptual", "RelativeColorimetric", "Saturation", "AbsoluteColorimetric" };
+    struct profile *profile = (struct profile *)grab_object( handle, OBJECT_TYPE_PROFILE );
+    PROFILEHEADER header;
+    BOOL ret = FALSE;
+    DWORD len;
+
+    TRACE( "( %p, %#lx, %p, %p )\n", handle, intent, buffer, size );
+
+    if (!profile) return FALSE;
+    if (!size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        release_object( &profile->hdr );
+        return FALSE;
+    }
+    if (profile->size < sizeof(header))
+    {
+        SetLastError( ERROR_INVALID_PROFILE );
+        release_object( &profile->hdr );
+        return FALSE;
+    }
+    get_profile_header( profile, &header );
+    if (header.phRenderingIntent > 3)
+        SetLastError( ERROR_INVALID_PROFILE );
+    else
+    {
+        len = strlen( names[header.phRenderingIntent] ) + 1;
+        if (!buffer || *size < len)
+        {
+            *size = len;
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        }
+        else
+        {
+            memcpy( buffer, names[header.phRenderingIntent], len );
+            *size = len;
+            ret = TRUE;
+        }
+    }
+    release_object( &profile->hdr );
+    return ret;
+}
+
+/******************************************************************************
+ * CreateProfileFromLogColorSpaceW               [MSCMS.@]
+ *
+ * Build an ICC profile for a logical color space. The profile is returned in a buffer
+ * the caller releases with LocalFree.
+ */
+BOOL WINAPI CreateProfileFromLogColorSpaceW( LPLOGCOLORSPACEW space, PBYTE *buffer )
+{
+    cmsHPROFILE cmsprofile;
+    cmsUInt32Number size = 0;
+    BYTE *data;
+
+    TRACE( "( %p, %p )\n", space, buffer );
+
+    if (!space || !buffer || space->lcsSignature != LCS_SIGNATURE || space->lcsSize < sizeof(LOGCOLORSPACEW) - sizeof(WCHAR) * MAX_PATH ||
+            space->lcsVersion != 0x400)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (space->lcsCSType == LCS_CALIBRATED_RGB)
+    {
+        const CIEXYZTRIPLE *e = &space->lcsEndpoints;
+        cmsCIExyY white, prim[3];
+        cmsToneCurve *curves[3];
+        double r[3] = { e->ciexyzRed.ciexyzX / 1073741824.0, e->ciexyzRed.ciexyzY / 1073741824.0, e->ciexyzRed.ciexyzZ / 1073741824.0 };
+        double g[3] = { e->ciexyzGreen.ciexyzX / 1073741824.0, e->ciexyzGreen.ciexyzY / 1073741824.0, e->ciexyzGreen.ciexyzZ / 1073741824.0 };
+        double b[3] = { e->ciexyzBlue.ciexyzX / 1073741824.0, e->ciexyzBlue.ciexyzY / 1073741824.0, e->ciexyzBlue.ciexyzZ / 1073741824.0 };
+        double w[3] = { r[0] + g[0] + b[0], r[1] + g[1] + b[1], r[2] + g[2] + b[2] };
+        double gammas[3] = { space->lcsGammaRed / 65536.0, space->lcsGammaGreen / 65536.0, space->lcsGammaBlue / 65536.0 };
+        double ws = w[0] + w[1] + w[2], rs = r[0] + r[1] + r[2], gs = g[0] + g[1] + g[2], bs = b[0] + b[1] + b[2];
+        int i;
+
+        if (ws <= 0.0 || rs <= 0.0 || gs <= 0.0 || bs <= 0.0 || gammas[0] <= 0.0 || gammas[1] <= 0.0 || gammas[2] <= 0.0)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        white.x = w[0] / ws; white.y = w[1] / ws; white.Y = 1.0;
+        prim[0].x = r[0] / rs; prim[0].y = r[1] / rs; prim[0].Y = r[1];
+        prim[1].x = g[0] / gs; prim[1].y = g[1] / gs; prim[1].Y = g[1];
+        prim[2].x = b[0] / bs; prim[2].y = b[1] / bs; prim[2].Y = b[1];
+        for (i = 0; i < 3; i++) curves[i] = cmsBuildGamma( NULL, gammas[i] );
+        cmsprofile = cmsCreateRGBProfile( &white, (cmsCIExyYTRIPLE *)prim, curves );
+        for (i = 0; i < 3; i++) cmsFreeToneCurve( curves[i] );
+    }
+    else if (space->lcsCSType == LCS_sRGB || space->lcsCSType == LCS_WINDOWS_COLOR_SPACE)
+        cmsprofile = cmsCreate_sRGBProfile();
+    else
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (!cmsprofile) return FALSE;
+    if (!cmsSaveProfileToMem( cmsprofile, NULL, &size ) || !(data = LocalAlloc( LMEM_FIXED, size )) ||
+            !cmsSaveProfileToMem( cmsprofile, data, &size ))
+    {
+        cmsCloseProfile( cmsprofile );
+        return FALSE;
+    }
+    cmsCloseProfile( cmsprofile );
+    *buffer = data;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CreateProfileFromLogColorSpaceA               [MSCMS.@]
+ */
+BOOL WINAPI CreateProfileFromLogColorSpaceA( LPLOGCOLORSPACEA space, PBYTE *buffer )
+{
+    LOGCOLORSPACEW spaceW;
+
+    TRACE( "( %p, %p )\n", space, buffer );
+
+    if (!space || !buffer || space->lcsSize < FIELD_OFFSET(LOGCOLORSPACEA, lcsFilename))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    memset( &spaceW, 0, sizeof(spaceW) );
+    memcpy( &spaceW, space, FIELD_OFFSET(LOGCOLORSPACEA, lcsFilename) );
+    spaceW.lcsSize = sizeof(spaceW);
+    MultiByteToWideChar( CP_ACP, 0, space->lcsFilename, -1, spaceW.lcsFilename, MAX_PATH );
+    return CreateProfileFromLogColorSpaceW( &spaceW, buffer );
+}
+
+/* Color management modules are registered by their four character id. */
+
+static const WCHAR cmm_key_name[] = L"System\\CurrentControlSet\\Control\\CMM";
+#define CMM_ID_WIN 0x57696e20 /* 'Win ' */
+
+/******************************************************************************
+ * RegisterCMMW               [MSCMS.@]
+ */
+BOOL WINAPI RegisterCMMW( PCWSTR machine, DWORD id, PCWSTR dll )
+{
+    WCHAR name[5];
+    HKEY key;
+    LONG res;
+
+    TRACE( "( %s, %s, %s )\n", debugstr_w(machine), debugstr_fourcc(id), debugstr_w(dll) );
+
+    if (machine)
+    {
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (!dll || !*dll || !id)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((res = RegCreateKeyExW( HKEY_LOCAL_MACHINE, cmm_key_name, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    standard_space_name( id, name );
+    res = RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)dll, (lstrlenW( dll ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    if (res)
+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/******************************************************************************
+ * RegisterCMMA               [MSCMS.@]
+ */
+BOOL WINAPI RegisterCMMA( PCSTR machine, DWORD id, PCSTR dll )
+{
+    WCHAR *dllW, *machineW = NULL;
+    BOOL ret;
+
+    TRACE( "( %s, %s, %s )\n", debugstr_a(machine), debugstr_fourcc(id), debugstr_a(dll) );
+
+    if (!dll)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(dllW = strdupW( dll ))) return FALSE;
+    if (machine && !(machineW = strdupW( machine )))
+    {
+        free( dllW );
+        return FALSE;
+    }
+    ret = RegisterCMMW( machineW, id, dllW );
+    free( machineW );
+    free( dllW );
+    return ret;
+}
+
+/******************************************************************************
+ * UnregisterCMMW               [MSCMS.@]
+ */
+BOOL WINAPI UnregisterCMMW( PCWSTR machine, DWORD id )
+{
+    WCHAR name[5];
+    HKEY key;
+    LONG res;
+
+    TRACE( "( %s, %s )\n", debugstr_w(machine), debugstr_fourcc(id) );
+
+    if (machine)
+    {
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if ((res = RegOpenKeyExW( HKEY_LOCAL_MACHINE, cmm_key_name, 0, KEY_SET_VALUE, &key )))
+    {
+        SetLastError( res );
+        return FALSE;
+    }
+    standard_space_name( id, name );
+    res = RegDeleteValueW( key, name );
+    RegCloseKey( key );
+    if (res)
+    {
+        SetLastError( res == ERROR_FILE_NOT_FOUND ? ERROR_INVALID_PARAMETER : res );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/******************************************************************************
+ * UnregisterCMMA               [MSCMS.@]
+ */
+BOOL WINAPI UnregisterCMMA( PCSTR machine, DWORD id )
+{
+    WCHAR *machineW = NULL;
+    BOOL ret;
+
+    TRACE( "( %s, %s )\n", debugstr_a(machine), debugstr_fourcc(id) );
+
+    if (machine && !(machineW = strdupW( machine ))) return FALSE;
+    ret = UnregisterCMMW( machineW, id );
+    free( machineW );
+    return ret;
+}
+
+static DWORD selected_cmm = CMM_ID_WIN;
+
+/******************************************************************************
+ * SelectCMM               [MSCMS.@]
+ *
+ * Select the color management module of this process. Only registered modules and the default one can be used.
+ */
+BOOL WINAPI SelectCMM( DWORD id )
+{
+    WCHAR name[5];
+    DWORD type, size = 0;
+    HKEY key;
+    BOOL found = id == CMM_ID_WIN;
+
+    TRACE( "(%s)\n", debugstr_fourcc(id) );
+
+    if (!found && !RegOpenKeyExW( HKEY_LOCAL_MACHINE, cmm_key_name, 0, KEY_QUERY_VALUE, &key ))
+    {
+        standard_space_name( id, name );
+        found = !RegQueryValueExW( key, name, NULL, &type, NULL, &size );
+        RegCloseKey( key );
+    }
+    if (!found)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    selected_cmm = id;
+    return TRUE;
+}
+
+DWORD get_selected_cmm( void )
+{
+    return selected_cmm;
+}
