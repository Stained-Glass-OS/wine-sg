+SECURITY_STATUS WINAPI NCryptSetProperty(NCRYPT_HANDLE handle, const WCHAR *name, BYTE *input, DWORD insize, DWORD flags)
+{
+    static const WCHAR * const settable[] =
+    {
+        NCRYPT_LENGTH_PROPERTY, NCRYPT_EXPORT_POLICY_PROPERTY, NCRYPT_KEY_USAGE_PROPERTY, NCRYPT_UI_POLICY_PROPERTY,
+        NCRYPT_WINDOW_HANDLE_PROPERTY, NCRYPT_USE_CONTEXT_PROPERTY, NCRYPT_SECURITY_DESCR_PROPERTY,
+        NCRYPT_ECC_CURVE_NAME_PROPERTY,
