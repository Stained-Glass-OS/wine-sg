+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1767,6 +1767,12 @@ static NTSTATUS key_import_pair( struct algorithm *alg, const WCHAR *type, BCRYP
             magic = BCRYPT_ECDSA_PRIVATE_P256_MAGIC;
             break;
 
+        case ALG_ID_ECDSA_P384:
+            /* Stained Glass OS 1679: as for the other curves (the unix side imports it) */
+            key_size = 48;
+            magic = BCRYPT_ECDSA_PRIVATE_P384_MAGIC;
+            break;
+
         default:
             FIXME( "algorithm %u does not yet support importing blob of type %s\n", alg->id, debugstr_w(type) );
             return STATUS_NOT_SUPPORTED;
