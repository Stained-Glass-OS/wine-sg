+                status = NCryptOpenKey(prov, &key, cng_info->pwszContainerName, cng_info->dwKeySpec,
+                                       (cng_info->dwFlags & CRYPT_MACHINE_KEYSET ? NCRYPT_MACHINE_KEY_FLAG : 0) |
+                                       (dwFlags & CRYPT_ACQUIRE_SILENT_FLAG ? NCRYPT_SILENT_FLAG : 0));
