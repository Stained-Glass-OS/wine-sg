+SECURITY_STATUS WINAPI NCryptSecretAgreement(NCRYPT_KEY_HANDLE private_key, NCRYPT_KEY_HANDLE public_key,
+                                             NCRYPT_SECRET_HANDLE *secret, DWORD flags)
+{
+    struct object *priv, *pub, *object;
+    SECURITY_STATUS ret;
+    NTSTATUS status;
+
+    TRACE("(%#Ix, %#Ix, %p, %#lx)\n", private_key, public_key, secret, flags);
+
+    if (!(priv = get_usable_key(private_key, &ret))) return ret;
+    if (!(pub = get_usable_key(public_key, &ret))) return ret;
+    if (!secret) return NTE_INVALID_PARAMETER;
+    if (flags & ~NCRYPT_SILENT_FLAG) return NTE_BAD_FLAGS;
+    if (!(get_dword_property(priv, NCRYPT_KEY_USAGE_PROPERTY, NCRYPT_ALLOW_ALL_USAGES) & NCRYPT_ALLOW_KEY_AGREEMENT_FLAG))
+        return NTE_PERM;
+    if (!(object = allocate_object(SECRET))) return NTE_NO_MEMORY;
+    if ((status = BCryptSecretAgreement(priv->key.bcrypt_key, pub->key.bcrypt_key, &object->secret.bcrypt_secret, 0)))
