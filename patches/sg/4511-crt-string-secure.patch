+#if _MSVCR_VER >= 80
+/*********************************************************************
+ *              _strset_s (MSVCR80.@)
+ *
+ * Sets every character of a string, which must end within size bytes.
+ */
+int CDECL _strset_s(char *str, size_t size, int c)
+{
+    char *p = str;
+
+    if(!MSVCRT_CHECK_PMT(str != NULL)) return EINVAL;
+    if(!MSVCRT_CHECK_PMT(size)) return EINVAL;
+
+    while(*p && --size) *p++ = c;
+    if(!size) {
+        str[0] = 0;
+        _invalid_parameter(NULL, NULL, NULL, 0, 0);
+        *_errno() = EINVAL;
+        return EINVAL;
+    }
+    return 0;
+}
+#endif
