 #endif /* _MSVCR_VER >= 140 */
+
+#if _MSVCR_VER >= 80
+/**********************************************************************
+ *		_strerror_s	(MSVCR80.@)
+ *
+ * The message of _strerror (an optional prefix, ": ", the message of errno,
+ * a newline) in the caller's buffer, truncated to fit.
+ */
+int CDECL _strerror_s(char *buffer, size_t size, const char *str)
+{
+    int err = *_errno();
+    char msg[512];
+
+    if (!MSVCRT_CHECK_PMT(buffer != NULL)) return EINVAL;
+    if (!MSVCRT_CHECK_PMT(size)) return EINVAL;
+
+    if (err < 0 || err > MSVCRT__sys_nerr) err = MSVCRT__sys_nerr;
+    if (str && *str)
+        snprintf(msg, sizeof(msg), "%s: %s\n", str, MSVCRT__sys_errlist[err]);
+    else
+        snprintf(msg, sizeof(msg), "%s\n", MSVCRT__sys_errlist[err]);
+    lstrcpynA(buffer, msg, size);
+    return 0;
+}
+#endif
