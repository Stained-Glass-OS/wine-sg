+int CDECL _mbsset_s_l(unsigned char *str, size_t size, unsigned int c, _locale_t locale)
+{
+    if (!mbs_check_s(str, size)) return EINVAL;
+    _mbsset_l(str, c, locale);
+    return 0;
+}
+
+/*********************************************************************
