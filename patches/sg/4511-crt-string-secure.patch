     FIXME("(%p): stub\n", callback);
 }
 #endif
+
+#if _MSVCR_VER >= 80
+/*********************************************************************
+ *		_lsearch_s (MSVCR80.@)
+ *
+ * _lsearch with a context passed to the comparison: a missing key is
+ * appended and counted.
+ */
+void* CDECL _lsearch_s(const void *match, void *start, unsigned int *array_size, size_t elem_size,
+        int (__cdecl *cf)(void*, const void*, const void*), void *context)
+{
+    void *found;
+
+    if (!MSVCRT_CHECK_PMT(match != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(array_size != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(!*array_size || start != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(cf != NULL)) return NULL;
+    if (!MSVCRT_CHECK_PMT(elem_size)) return NULL;
+
+    if ((found = _lfind_s(match, start, array_size, elem_size, cf, context)))
+        return found;
+#ifndef SG_MUTANT_LSEARCH_NO_APPEND
+    found = (char *)start + *array_size * elem_size;
+    memcpy(found, match, elem_size);
+    (*array_size)++;
+#endif
+    return found;
+}
+#endif
