 }
+
+/* the number of bytes of the first count characters of str */
+static size_t mbs_char_bytes(const unsigned char *str, size_t count, _locale_t locale)
+{
+    return _mbsnbcnt_l(str, count, locale);
+}
+
+/*********************************************************************
+ *		_mbsncoll_l(MSVCRT.@)
+ *
+ * Compares (with the locale's collation) the first count characters.
+ */
+int CDECL _mbsncoll_l(const unsigned char *str1, const unsigned char *str2, size_t count, _locale_t locale)
+{
+    pthreadmbcinfo mbcinfo = locale ? locale->mbcinfo : get_mbcinfo();
+    size_t len1, len2;
+
+    if (!MSVCRT_CHECK_PMT(str1 && str2)) return _NLSCMPERROR;
+    len1 = mbs_char_bytes(str1, count, locale);
+    len2 = mbs_char_bytes(str2, count, locale);
+    if (!mbcinfo->ismbcodepage)
+        return _strncoll_l((const char*)str1, (const char*)str2, count, locale);
+    return CompareStringA(mbcinfo->mblcid, 0, (const char*)str1, len1, (const char*)str2, len2) - CSTR_EQUAL;
+}
+
+/*********************************************************************
+ *		_mbsncoll(MSVCRT.@)
+ */
+int CDECL _mbsncoll(const unsigned char *str1, const unsigned char *str2, size_t count)
+{
+    return _mbsncoll_l(str1, str2, count, NULL);
+}
+
+/*********************************************************************
+ *		_mbsnicoll_l(MSVCRT.@)
+ *
+ * As _mbsncoll_l, ignoring case.
+ */
+int CDECL _mbsnicoll_l(const unsigned char *str1, const unsigned char *str2, size_t count, _locale_t locale)
+{
+    pthreadmbcinfo mbcinfo = locale ? locale->mbcinfo : get_mbcinfo();
+    size_t len1, len2;
+
+    if (!MSVCRT_CHECK_PMT(str1 && str2)) return _NLSCMPERROR;
+    len1 = mbs_char_bytes(str1, count, locale);
+    len2 = mbs_char_bytes(str2, count, locale);
+    if (!mbcinfo->ismbcodepage)
+        return _strnicoll_l((const char*)str1, (const char*)str2, count, locale);
+    return CompareStringA(mbcinfo->mblcid, NORM_IGNORECASE, (const char*)str1, len1,
+            (const char*)str2, len2) - CSTR_EQUAL;
+}
+
+/*********************************************************************
+ *		_mbsnicoll(MSVCRT.@)
+ */
+int CDECL _mbsnicoll(const unsigned char *str1, const unsigned char *str2, size_t count)
+{
+    return _mbsnicoll_l(str1, str2, count, NULL);
+}
+
+#if _MSVCR_VER >= 80
+/*********************************************************************
+ *		_mbsninc_l(MSVCR80.@)
+ */
+unsigned char* CDECL _mbsninc_l(const unsigned char *str, size_t num, _locale_t locale)
+{
+    if (!str) return NULL;
+    while (num > 0 && *str)
+    {
+        if (_ismbblead_l(*str, locale))
+        {
+            if (!str[1]) break;
+            str++;
+        }
+        str++;
+        num--;
+    }
+    return (unsigned char*)str;
+}
+
+/*********************************************************************
+ *		_mbsstr_l(MSVCR80.@)
+ *
+ * The first occurrence of needle starting on a character boundary.
+ */
+unsigned char* CDECL _mbsstr_l(const unsigned char *haystack, const unsigned char *needle, _locale_t locale)
+{
+    size_t len;
+
+    if (!MSVCRT_CHECK_PMT(haystack && needle)) return NULL;
+    if (!*needle) return (unsigned char*)haystack;
+    len = strlen((const char*)needle);
+    while (*haystack)
+    {
+        if (!strncmp((const char*)haystack, (const char*)needle, len))
+            return (unsigned char*)haystack;
+        haystack = _mbsninc_l(haystack, 1, locale);
+    }
+    return NULL;
+}
+
+/*********************************************************************
+ *		_mbstrnlen_l(MSVCR80.@)
+ *
+ * The number of characters in at most size bytes; -1 (EILSEQ) when a lead
+ * byte has no trail byte.
+ */
+size_t CDECL _mbstrnlen_l(const char *str, size_t size, _locale_t locale)
+{
+    size_t count = 0, i;
+
+    if (!MSVCRT_CHECK_PMT(str != NULL)) return -1;
+    if (!MSVCRT_CHECK_PMT(size <= INT_MAX)) return -1;
+
+    for (i = 0; i < size && str[i]; i++, count++)
+    {
+        if (_ismbblead_l((unsigned char)str[i], locale))
+        {
+            if (i + 1 >= size || !str[i + 1])
+            {
+                *_errno() = EILSEQ;
+                return -1;
+            }
+            i++;
+        }
+    }
+    return count;
+}
+
+/*********************************************************************
+ *		_mbstrnlen(MSVCR80.@)
+ */
+size_t CDECL _mbstrnlen(const char *str, size_t size)
+{
+    return _mbstrnlen_l(str, size, NULL);
+}
+
+/* the checks of the secure set functions: a string ending within size bytes */
+static BOOL mbs_check_s(unsigned char *str, size_t size)
+{
+    if (!MSVCRT_CHECK_PMT(str != NULL)) return FALSE;
+    if (!MSVCRT_CHECK_PMT(size)) return FALSE;
+    if (strnlen((const char*)str, size) == size)
+    {
+        str[0] = 0;
+        MSVCRT_INVALID_PMT("string is not terminated", EINVAL);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/*********************************************************************
+ *		_mbsset_s_l(MSVCR80.@)
