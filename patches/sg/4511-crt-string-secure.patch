+ *
+ * _mbsnbcat_s_l for the bytes of the first count characters of src.
+ */
+int CDECL _mbsncat_s_l(unsigned char *dst, size_t size, const unsigned char *src, size_t count, _locale_t locale)
+{
+    if (!MSVCRT_CHECK_PMT(src != NULL || !count)) return EINVAL;
+    if (count != _TRUNCATE && src)
+        count = mbs_char_bytes(src, count, locale);
+    return _mbsnbcat_s_l(dst, size, src, count, locale);
+}
+
+/*********************************************************************
+ *		_mbsncat_s(MSVCR80.@)
+ */
+int CDECL _mbsncat_s(unsigned char *dst, size_t size, const unsigned char *src, size_t count)
+{
+    return _mbsncat_s_l(dst, size, src, count, NULL);
+}
+#endif
+
