+/* (wine-sg 8018) the registry key of a device interface instance:
+ * ...\Control\DeviceClasses\{class}\##?#<device path with # for \>#{class}\#<reference string> */
+static NTSTATUS open_interface_key( UNICODE_STRING *name, ACCESS_MASK access, HANDLE *key )
+{
+    static const WCHAR DeviceClassesW[] = L"\\REGISTRY\\Machine\\System\\CurrentControlSet\\Control\\DeviceClasses\\";
+    size_t namelen = name->Length / sizeof(WCHAR);
+    OBJECT_ATTRIBUTES attr = {0};
+    UNICODE_STRING string;
+    WCHAR *path, *refstr, *p;
+    NTSTATUS ret;
+    ULONG len;
+
+    if (namelen < 4 + 38) return STATUS_INVALID_PARAMETER;
+    for (p = name->Buffer + 4, refstr = NULL; p < name->Buffer + namelen; p++)
+        if (*p == '\\') refstr = p;
+    if (!refstr) refstr = p;
+    if (refstr - name->Buffer < 4 + 38) return STATUS_INVALID_PARAMETER;
+
+    len = lstrlenW(DeviceClassesW) + 38 + 1 + namelen + 2 + 1;
+    if (!(path = heap_alloc( len * sizeof(WCHAR) )))
+        return STATUS_NO_MEMORY;
+
+    lstrcpyW( path, DeviceClassesW );
+    lstrcpynW( path + lstrlenW( path ), refstr - 38, 39 );
+    lstrcatW( path, L"\\" );
+    p = path + lstrlenW( path );
+    lstrcpynW( path + lstrlenW( path ), name->Buffer, (refstr - name->Buffer) + 1 );
+    p[0] = p[1] = p[3] = '#';
+    lstrcatW( path, L"\\#" );
+    if (refstr < name->Buffer + namelen)
+        lstrcpynW( path + lstrlenW( path ), refstr, name->Buffer + namelen - refstr + 1 );
+
+    attr.Length = sizeof(attr);
+    attr.ObjectName = &string;
+    RtlInitUnicodeString( &string, path );
+    ret = NtOpenKey( key, access, &attr );
+    heap_free(path);
+    return ret;
+}
+
+/***********************************************************************
+ *           IoOpenDeviceInterfaceRegistryKey   (NTOSKRNL.EXE.@)
+ *
+ * (wine-sg 8018) The "Device Parameters" key of a registered device interface, created if needed, as
+ * Learn describes it.
+ */
+NTSTATUS WINAPI IoOpenDeviceInterfaceRegistryKey( UNICODE_STRING *name, ACCESS_MASK access, HANDLE *key )
+{
+    UNICODE_STRING params = RTL_CONSTANT_STRING( L"Device Parameters" );
+    OBJECT_ATTRIBUTES attr = {0};
+    HANDLE iface_key;
+    NTSTATUS ret;
+
+    TRACE( "name %s, access %#lx, key %p.\n", debugstr_us(name), access, key );
+
+    if (!name || !name->Buffer || !key) return STATUS_INVALID_PARAMETER;
+    *key = NULL;
+#ifdef SG_MUTANT_NO_IFACE_KEY
+    return STATUS_OBJECT_NAME_NOT_FOUND;
+#endif
+    if (!wine_rb_get( &device_interfaces, name )) return STATUS_OBJECT_NAME_NOT_FOUND;
+    if ((ret = open_interface_key( name, KEY_CREATE_SUB_KEY, &iface_key ))) return ret;
+    attr.Length = sizeof(attr);
+    attr.RootDirectory = iface_key;
+    attr.ObjectName = &params;
+    attr.Attributes = OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE;
+    ret = NtCreateKey( key, access, &attr, 0, NULL, 0, NULL );
+    NtClose( iface_key );
+    return ret;
+}
+
