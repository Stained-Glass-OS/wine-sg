 /***********************************************************************
+ *           IoBuildPartialMdl   (NTOSKRNL.EXE.@)
+ *
+ * (wine-sg 8018) The target MDL describes the part of the source's buffer that starts at va (Length 0:
+ * to the source's end): its pages are the source's, it is locked, nonpaged, I/O space and mapped as the
+ * source is, and marked MDL_PARTIAL. The target must be large enough for the pages (IoAllocateMdl of the
+ * same va and length).
+ */
+void WINAPI IoBuildPartialMdl( MDL *source, MDL *target, void *va, ULONG length )
+{
+    char *src_va = (char *)source->StartVa + source->ByteOffset;
+    ULONG_PTR offset = (char *)va - src_va;
+    PFN_NUMBER *src_pfns = (PFN_NUMBER *)(source + 1), *dst_pfns = (PFN_NUMBER *)(target + 1);
+    ULONG first, count, i;
+
+    TRACE( "(%p, %p, %p, %lu)\n", source, target, va, length );
+
+    if ((char *)va < src_va || offset > source->ByteCount)
+    {
+        ERR( "%p is not in the source mdl %p\n", va, source );
+        return;
+    }
+    if (!length) length = source->ByteCount - offset;
+    first = ((ULONG_PTR)PAGE_ALIGN( va ) - (ULONG_PTR)source->StartVa) >> PAGE_SHIFT;
+    count = ADDRESS_AND_SIZE_TO_SPAN_PAGES( va, length );
+
+    target->StartVa = PAGE_ALIGN( va );
+    target->ByteOffset = BYTE_OFFSET( va );
+    target->ByteCount = length;
+    target->Process = source->Process;
+    target->MdlFlags &= MDL_ALLOCATED_FIXED_SIZE | MDL_ALLOCATED_MUST_SUCCEED;
+#ifndef SG_MUTANT_NO_PARTIAL_MDL
+    target->MdlFlags |= MDL_PARTIAL | (source->MdlFlags & (MDL_PAGES_LOCKED | MDL_SOURCE_IS_NONPAGED_POOL | MDL_IO_SPACE));
+#endif
+    if (source->MdlFlags & (MDL_MAPPED_TO_SYSTEM_VA | MDL_SOURCE_IS_NONPAGED_POOL))
+    {
+        target->MappedSystemVa = (char *)source->MappedSystemVa + offset;
+        if (source->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA) target->MdlFlags |= MDL_PARTIAL_HAS_BEEN_MAPPED;
+    }
+    else target->MappedSystemVa = NULL;
+    for (i = 0; i < count; i++) dst_pfns[i] = src_pfns[first + i];
+}
