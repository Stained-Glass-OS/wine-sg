From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 01:02:17 -0800
Subject: [PATCH] sane.ds, gphoto2.ds: a 64-bit program's TWAIN native transfer gets the DIB's whole handle (9815)

TWAIN 2 passes a native transfer's DIB handle pointer-sized (TW_HANDLE);
sane.ds and gphoto2.ds wrote it as a TW_UINT32, so a 64-bit program
(IrfanView 64-bit's Acquire, NAPS2's TWAIN driver) got only the low 32
bits of a GlobalAlloc pointer -- above 4 GB, a cut handle with the upper
half whatever its variable held: a black or broken page, or a crash. The
handle is written whole.

Gate test/twainscan-gate.sh (SANE's test device, a SANE configuration of
its own).

--- a/dlls/gphoto2.ds/ds_image.c
+++ b/dlls/gphoto2.ds/ds_image.c
@@ -417,7 +417,13 @@
 TW_UINT16 GPHOTO2_ImageNativeXferGet (pTW_IDENTITY pOrigin, 
                                     TW_MEMREF pData)
 {
+    /* Stained Glass OS (9815): the DIB's handle, pointer-sized (TWAIN 2's TW_HANDLE): a 64-bit
+     * program's handle variable got only its low 32 bits, a GlobalAlloc pointer above 4 GB cut */
+#ifndef SG_MUTANT_TWAIN_HANDLE32
+    HANDLE *pHandle = (HANDLE *) pData;
+#else
     pTW_UINT32 pHandle = (pTW_UINT32) pData;
+#endif
     HBITMAP hDIB;
     BITMAPINFO bmpInfo;
     LPBYTE bits;
@@ -490,7 +496,11 @@
     }
     HeapFree (GetProcessHeap(), 0, samprow);
     close_current_file();
+#ifndef SG_MUTANT_TWAIN_HANDLE32
+    *pHandle = hDIB;
+#else
     *pHandle = (UINT_PTR)hDIB;
+#endif
     activeDS.twCC = TWCC_SUCCESS;
     activeDS.currentState = 7;
     return TWRC_XFERDONE;
--- a/dlls/sane.ds/ds_image.c
+++ b/dlls/sane.ds/ds_image.c
@@ -296,7 +296,13 @@
                                     TW_MEMREF pData)
 {
     TW_UINT16 twRC = TWRC_SUCCESS;
+    /* Stained Glass OS (9815): the DIB's handle, pointer-sized (TWAIN 2's TW_HANDLE): a 64-bit
+     * program's handle variable got only its low 32 bits, a GlobalAlloc pointer above 4 GB cut */
+#ifndef SG_MUTANT_TWAIN_HANDLE32
+    HANDLE *pHandle = (HANDLE *) pData;
+#else
     pTW_UINT32 pHandle = (pTW_UINT32) pData;
+#endif
     HANDLE hDIB;
     BITMAPINFOHEADER *header = NULL;
     int dib_bytes;
@@ -458,7 +464,11 @@
         }
 
         SANE_CALL( cancel_device, NULL );
+#ifndef SG_MUTANT_TWAIN_HANDLE32
+        *pHandle = hDIB;
+#else
         *pHandle = (UINT_PTR)hDIB;
+#endif
         twRC = TWRC_XFERDONE;
         activeDS.twCC = TWCC_SUCCESS;
         activeDS.currentState = 7;
