+/* The CryptoAPI private key blob: BLOBHEADER, RSAPUBKEY, then the modulus, prime1, prime2, exponent1, exponent2,
+ * coefficient and private exponent, all little-endian. */
+static BOOL WINAPI CRYPT_AsnEncodeRsaPrivKey(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const BLOBHEADER *hdr = pvStructInfo;
+        const RSAPUBKEY *rsaPubKey = (const RSAPUBKEY *)(hdr + 1);
+
+        if (hdr->bType != PRIVATEKEYBLOB || rsaPubKey->magic != 0x32415352 /* RSA2 */)
+            SetLastError(E_INVALIDARG);
+        else
+        {
+            DWORD version = 0, half = (rsaPubKey->bitlen + 15) / 16, full = (rsaPubKey->bitlen + 7) / 8;
+            const BYTE *data = (const BYTE *)(rsaPubKey + 1);
+            CRYPT_INTEGER_BLOB modulus = { full, (BYTE *)data };
+            CRYPT_INTEGER_BLOB exponent = { sizeof(DWORD), (BYTE *)&rsaPubKey->pubexp };
+            CRYPT_INTEGER_BLOB prime1 = { half, (BYTE *)data + full };
+            CRYPT_INTEGER_BLOB prime2 = { half, (BYTE *)data + full + half };
+            CRYPT_INTEGER_BLOB exponent1 = { half, (BYTE *)data + full + half * 2 };
+            CRYPT_INTEGER_BLOB exponent2 = { half, (BYTE *)data + full + half * 3 };
+            CRYPT_INTEGER_BLOB coefficient = { half, (BYTE *)data + full + half * 4 };
+            CRYPT_INTEGER_BLOB privexp = { full, (BYTE *)data + full + half * 5 };
+            struct AsnEncodeSequenceItem items[] = {
+             { &version, CRYPT_AsnEncodeInt, 0 },
+             { &modulus, CRYPT_AsnEncodeUnsignedInteger, 0 },
+             { &exponent, CRYPT_AsnEncodeUnsignedInteger, 0 },
+             { &privexp, CRYPT_AsnEncodeUnsignedInteger, 0 },
+#ifndef SG_MUTANT_ENC_RSA_ORDER
+             { &prime1, CRYPT_AsnEncodeUnsignedInteger, 0 },
+             { &prime2, CRYPT_AsnEncodeUnsignedInteger, 0 },
+#else
+             { &prime2, CRYPT_AsnEncodeUnsignedInteger, 0 },
+             { &prime1, CRYPT_AsnEncodeUnsignedInteger, 0 },
+#endif
+             { &exponent1, CRYPT_AsnEncodeUnsignedInteger, 0 },
+             { &exponent2, CRYPT_AsnEncodeUnsignedInteger, 0 },
+             { &coefficient, CRYPT_AsnEncodeUnsignedInteger, 0 },
+            };
+
+            ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items,
+             ARRAY_SIZE(items), dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
+
+static BOOL WINAPI CRYPT_AsnEncodeObjectIdentifier(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        LPCSTR oid = *(LPCSTR const *)pvStructInfo;
+        DWORD bytesNeeded = 0;
+
+        if (!oid)
+            SetLastError(E_INVALIDARG);
+        else if ((ret = CRYPT_AsnEncodeOid(dwCertEncodingType, lpszStructType, oid,
+         dwFlags & ~CRYPT_ENCODE_ALLOC_FLAG, NULL, NULL, &bytesNeeded)))
+        {
+            if (!pbEncoded)
+                *pcbEncoded = bytesNeeded;
+            else if ((ret = CRYPT_EncodeEnsureSpace(dwFlags, pEncodePara, pbEncoded, pcbEncoded, bytesNeeded)))
+            {
+                if (dwFlags & CRYPT_ENCODE_ALLOC_FLAG)
+                    pbEncoded = *(BYTE **)pbEncoded;
+                ret = CRYPT_AsnEncodeOid(dwCertEncodingType, lpszStructType, oid,
+                 dwFlags & ~CRYPT_ENCODE_ALLOC_FLAG, NULL, pbEncoded, &bytesNeeded);
+                if (!ret && (dwFlags & CRYPT_ENCODE_ALLOC_FLAG))
+                    CRYPT_FreeSpace(pEncodePara, pbEncoded);
+            }
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
+
 static BOOL WINAPI CRYPT_AsnEncodeOCSPSignedRequest(DWORD dwCertEncodingType,
  LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
  PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
@@ -4792,6 +5247,45 @@ static CryptEncodeObjectExFunc CRYPT_GetBuiltinEncoder(DWORD dwCertEncodingType,
     {
         switch (LOWORD(lpszStructType))
         {
+        case LOWORD(X509_DSS_PARAMETERS):
+            encodeFunc = CRYPT_AsnEncodeDssParameters;
+            break;
+        case LOWORD(X509_DSS_SIGNATURE):
+            encodeFunc = CRYPT_AsnEncodeDssSignature;
+            break;
+        case LOWORD(PKCS_RC2_CBC_PARAMETERS):
+            encodeFunc = CRYPT_AsnEncodeRc2CbcParameters;
+            break;
+        case LOWORD(PKCS_RSA_PRIVATE_KEY):
+            encodeFunc = CRYPT_AsnEncodeRsaPrivKey;
+            break;
+        case LOWORD(PKCS_PRIVATE_KEY_INFO):
+            encodeFunc = CRYPT_AsnEncodePrivateKeyInfo;
+            break;
+        case LOWORD(PKCS_ENCRYPTED_PRIVATE_KEY_INFO):
+            encodeFunc = CRYPT_AsnEncodeEncryptedPrivateKeyInfo;
+            break;
+        case LOWORD(X509_ECC_SIGNATURE):
+            encodeFunc = CRYPT_AsnEncodeEccSignature;
+            break;
+        case LOWORD(X509_CERT_PAIR):
+            encodeFunc = CRYPT_AsnEncodeCertPair;
+            break;
+        case LOWORD(X509_CERT_REQUEST_TO_BE_SIGNED):
+            encodeFunc = CRYPT_AsnEncodeCertRequestInfo;
+            break;
+        case LOWORD(X509_KEYGEN_REQUEST_TO_BE_SIGNED):
+            encodeFunc = CRYPT_AsnEncodeKeygenRequestInfo;
+            break;
+        case LOWORD(PKCS_TIME_REQUEST):
+            encodeFunc = CRYPT_AsnEncodeTimeRequest;
+            break;
+        case LOWORD(PKCS_CONTENT_INFO_SEQUENCE_OF_ANY):
+            encodeFunc = CRYPT_AsnEncodeContentInfoSequenceOfAny;
+            break;
+        case LOWORD(X509_OBJECT_IDENTIFIER):
+            encodeFunc = CRYPT_AsnEncodeObjectIdentifier;
+            break;
         case LOWORD(X509_CERT):
             encodeFunc = CRYPT_AsnEncodeCert;
             break;
