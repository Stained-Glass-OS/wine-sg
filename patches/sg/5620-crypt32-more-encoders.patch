+static void check_sg_encode(const char *what, LPCSTR type, const void *info, const BYTE *expected, DWORD expected_size)
+{
+    BYTE *buf = NULL;
+    DWORD size = 0, size2 = 0;
+    BOOL ret;
+
+    ret = CryptEncodeObjectEx(X509_ASN_ENCODING, type, info, CRYPT_ENCODE_ALLOC_FLAG, NULL, &buf, &size);
+    ok(ret, "%s: encode failed: %08lx\n", what, GetLastError());
+    if (!ret) return;
+    ok(size == expected_size && !memcmp(buf, expected, min(size, expected_size)), "%s: wrong encoding (%lu bytes)\n",
+            what, size);
+    ret = CryptEncodeObjectEx(X509_ASN_ENCODING, type, info, 0, NULL, NULL, &size2);
+    ok(ret && size2 == expected_size, "%s: sizing gave %lu\n", what, size2);
+    LocalFree(buf);
+}
+
+static void check_sg_roundtrip(const char *what, LPCSTR type, const BYTE *der, DWORD size)
+{
+    DWORD len, err;
+    void *p = sg_decode(type, der, size, &len, &err);
+
+    ok(!!p, "%s: decode failed: %08lx\n", what, err);
+    if (p)
+    {
+        check_sg_encode(what, type, p, der, size);
+        LocalFree(p);
+    }
+}
+
+static void test_encode_more_types(void)
+{
+    static const CHAR obj_id[] = "1.2.840.113549.1.7.1";
+    static const BYTE obj_der[] = { 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x07, 0x01 };
+    static const BYTE ecc_der[] = { 0x30, 0x08, 0x02, 0x02, 0x00, 0x80, 0x02, 0x02, 0x01, 0x02 };
+    static const BYTE ecc_r[] = { 0x80 }, ecc_s[] = { 0x02, 0x01 };
+    BYTE sig[40] = { 0 };
+    rc2_params rc2 = { CRYPT_RC2_40BIT_VERSION, TRUE, { 1, 2, 3, 4, 5, 6, 7, 8 } };
+    const char *oid = obj_id;
+    CERT_ECC_SIGNATURE ecc;
+    DWORD size, err, len;
+    BYTE *blob;
+    int i;
+    void *p;
+
+    check_sg_roundtrip("dss parameters", X509_DSS_PARAMETERS, sg_dss_params, sizeof(sg_dss_params));
+    check_sg_roundtrip("rc2", PKCS_RC2_CBC_PARAMETERS, sg_rc2, sizeof(sg_rc2));
+    check_sg_roundtrip("rc2 no iv", PKCS_RC2_CBC_PARAMETERS, sg_rc2_noiv, sizeof(sg_rc2_noiv));
+    check_sg_roundtrip("private key info", PKCS_PRIVATE_KEY_INFO, sg_pki, sizeof(sg_pki));
+    check_sg_roundtrip("private key info with attributes", PKCS_PRIVATE_KEY_INFO, sg_pki_attr, sizeof(sg_pki_attr));
+    check_sg_roundtrip("encrypted private key info", PKCS_ENCRYPTED_PRIVATE_KEY_INFO, sg_epki, sizeof(sg_epki));
+    check_sg_roundtrip("pair", X509_CERT_PAIR, sg_pair, sizeof(sg_pair));
+    check_sg_roundtrip("pair reverse only", X509_CERT_PAIR, sg_pair_rev, sizeof(sg_pair_rev));
+    check_sg_roundtrip("request", X509_CERT_REQUEST_TO_BE_SIGNED, sg_req, sizeof(sg_req));
+    check_sg_roundtrip("request with attributes", X509_CERT_REQUEST_TO_BE_SIGNED, sg_req_attr, sizeof(sg_req_attr));
+    check_sg_roundtrip("keygen", X509_KEYGEN_REQUEST_TO_BE_SIGNED, sg_keygen, sizeof(sg_keygen));
+    check_sg_roundtrip("time request", PKCS_TIME_REQUEST, sg_time, sizeof(sg_time));
+    check_sg_roundtrip("time request with attributes", PKCS_TIME_REQUEST, sg_time_attr, sizeof(sg_time_attr));
