+static BOOL WINAPI CRYPT_AsnEncodeRc2CbcParameters(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CRYPT_RC2_CBC_PARAMETERS_8 *params = pvStructInfo;
+        CRYPT_DATA_BLOB iv = { 8, (BYTE *)params->rgbIV };
+        struct AsnEncodeSequenceItem items[2] = {
+         { &params->dwVersion, CRYPT_AsnEncodeInt, 0 },
+         { &iv, CRYPT_AsnEncodeOctets, 0 },
+        };
+
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items,
+         params->fIV ? 2 : 1, dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
