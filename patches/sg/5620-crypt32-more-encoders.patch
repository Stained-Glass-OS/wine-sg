+static BOOL WINAPI CRYPT_AsnEncodeCertRequestInfo(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CERT_REQUEST_INFO *info = pvStructInfo;
+        CRYPT_ATTRIBUTES attrs = { info->cAttribute, info->rgAttribute };
+        struct AsnEncodeTagSwappedItem swapped = { ASN_CONTEXT | ASN_CONSTRUCTOR | 0, &attrs,
+         CRYPT_AsnEncodePKCSAttributes };
+        struct AsnEncodeSequenceItem items[] = {
+         { &info->dwVersion, CRYPT_AsnEncodeInt, 0 },
+         { &info->Subject, CRYPT_CopyEncodedBlob, 0 },
+         { &info->SubjectPublicKeyInfo, CRYPT_AsnEncodePubKeyInfo, 0 },
+         { &swapped, CRYPT_AsnEncodeSwapTag, 0 },
+        };
+
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items,
+         ARRAY_SIZE(items), dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
