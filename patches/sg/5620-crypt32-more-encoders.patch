+    /* the RC2 parameters built by hand */
+    check_sg_encode("rc2 by hand", PKCS_RC2_CBC_PARAMETERS, &rc2, sg_rc2, sizeof(sg_rc2));
+
+    /* a DSS signature: r then s, little-endian, 20 bytes each */
+    for (i = 0; i < 19; i++) sig[i] = 19 - i;
+    sig[19] = 0x80;
+    sig[20] = 0x02;
+    sig[21] = 0x01;
+    check_sg_encode("dss signature", X509_DSS_SIGNATURE, sig, sg_dss_sig, sizeof(sg_dss_sig));
+    p = sg_decode(X509_DSS_SIGNATURE, sg_dss_sig, sizeof(sg_dss_sig), &len, &err);
+    ok(p && !memcmp(p, sig, 40), "wrong signature round trip\n");
