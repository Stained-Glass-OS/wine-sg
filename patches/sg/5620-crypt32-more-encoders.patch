+    check_sg_encode("object identifier", X509_OBJECT_IDENTIFIER, &oid, obj_der, sizeof(obj_der));
+    oid = NULL;
+    SetLastError(0xdeadbeef);
+    ok(!CryptEncodeObjectEx(X509_ASN_ENCODING, X509_OBJECT_IDENTIFIER, &oid, 0, NULL, NULL, &size) &&
+            GetLastError() == E_INVALIDARG, "got error %08lx\n", GetLastError());
+
+    /* the RSA private key from the CryptoAPI blob */
+    blob = NULL;
+    ok(CryptDecodeObjectEx(X509_ASN_ENCODING, PKCS_RSA_PRIVATE_KEY, rsaPrivKeyDer, sizeof(rsaPrivKeyDer),
+            CRYPT_DECODE_ALLOC_FLAG, NULL, &blob, &size), "decode failed: %08lx\n", GetLastError());
+    if (blob)
+    {
+        check_sg_encode("rsa private key", PKCS_RSA_PRIVATE_KEY, blob, rsaPrivKeyDer, sizeof(rsaPrivKeyDer));
+        blob[0] = 0x06; /* a public key blob */
+        SetLastError(0xdeadbeef);
+        ok(!CryptEncodeObjectEx(X509_ASN_ENCODING, PKCS_RSA_PRIVATE_KEY, blob, 0, NULL, NULL, &size) &&
+                GetLastError() == E_INVALIDARG, "got error %08lx\n", GetLastError());
+        LocalFree(blob);
+    }
+
+    /* a challenge that is not IA5 */
+    {
+        CERT_KEYGEN_REQUEST_INFO req;
+        CERT_PUBLIC_KEY_INFO *pub;
+
+        p = sg_decode(X509_KEYGEN_REQUEST_TO_BE_SIGNED, sg_keygen, sizeof(sg_keygen), &len, &err);
+        req = *(CERT_KEYGEN_REQUEST_INFO *)p;
+        pub = &req.SubjectPublicKeyInfo;
+        (void)pub;
+        req.pwszChallengeString = (WCHAR *)L"t\x00e9st";
+        SetLastError(0xdeadbeef);
+        blob = NULL;
+        ok(!CryptEncodeObjectEx(X509_ASN_ENCODING, X509_KEYGEN_REQUEST_TO_BE_SIGNED, &req, CRYPT_ENCODE_ALLOC_FLAG,
+                NULL, &blob, &size) && GetLastError() == CRYPT_E_INVALID_IA5_STRING, "got error %08lx\n", GetLastError());
+        LocalFree(p);
+    }
+
+    /* a pair needs one certificate */
+    {
+        CERT_PAIR pair = { { 0, NULL }, { 0, NULL } };
+
+        SetLastError(0xdeadbeef);
+        ok(!CryptEncodeObjectEx(X509_ASN_ENCODING, X509_CERT_PAIR, &pair, 0, NULL, NULL, &size) &&
+                GetLastError() == E_INVALIDARG, "got error %08lx\n", GetLastError());
+    }
+}
