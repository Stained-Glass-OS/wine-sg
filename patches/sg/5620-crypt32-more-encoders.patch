+static BOOL WINAPI CRYPT_AsnEncodeCertPair(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CERT_PAIR *pair = pvStructInfo;
+        struct AsnConstructedItem forward = { 0, &pair->Forward, CRYPT_CopyEncodedBlob };
+        struct AsnConstructedItem reverse = { 1, &pair->Reverse, CRYPT_CopyEncodedBlob };
+        struct AsnEncodeSequenceItem items[2];
+        DWORD cItem = 0;
+
+        if (pair->Forward.cbData)
+        {
+            items[cItem].pvStructInfo = &forward;
+            items[cItem].encodeFunc = CRYPT_AsnEncodeConstructed;
+            items[cItem++].size = 0;
+        }
+#ifdef SG_MUTANT_ENC_PAIR_NO_REVERSE
+        if (0)
+#else
+        if (pair->Reverse.cbData)
+#endif
+        {
+            items[cItem].pvStructInfo = &reverse;
+            items[cItem].encodeFunc = CRYPT_AsnEncodeConstructed;
+            items[cItem++].size = 0;
+        }
+        if (!cItem)
+            SetLastError(E_INVALIDARG);
+        else
+            ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items, cItem,
+             dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
