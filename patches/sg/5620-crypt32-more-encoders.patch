+static BOOL WINAPI CRYPT_AsnEncodePrivateKeyInfo(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CRYPT_PRIVATE_KEY_INFO_ *info = pvStructInfo;
+        struct AsnEncodeTagSwappedItem attrs;
+        struct AsnEncodeSequenceItem items[4] = {
+         { &info->Version, CRYPT_AsnEncodeInt, 0 },
+         { &info->Algorithm, CRYPT_AsnEncodeAlgorithmId, 0 },
+         { &info->PrivateKey, CRYPT_AsnEncodeOctets, 0 },
+         { NULL, NULL, 0 },
+        };
+        DWORD cItem = 3;
+
+#ifdef SG_MUTANT_ENC_PKCS8_NO_ATTRS
+        if (0)
+#else
+        if (info->pAttributes)
+#endif
+        {
+            attrs.tag = ASN_CONTEXT | ASN_CONSTRUCTOR | 0;
+            attrs.pvStructInfo = info->pAttributes;
+            attrs.encodeFunc = CRYPT_AsnEncodePKCSAttributes;
+            items[cItem].pvStructInfo = &attrs;
+            items[cItem].encodeFunc = CRYPT_AsnEncodeSwapTag;
+            cItem++;
+        }
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items, cItem,
+         dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
