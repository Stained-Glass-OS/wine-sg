+static BOOL WINAPI CRYPT_AsnEncodeTimeRequest(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CRYPT_TIME_STAMP_REQUEST_INFO *info = pvStructInfo;
+        CRYPT_ATTRIBUTES attrs = { info->cAttribute, info->rgAttribute };
+        struct AsnEncodeSequenceItem items[3] = {
+         { info->pszTimeStampAlgorithm, CRYPT_AsnEncodeOid, 0 },
+         { NULL, NULL, 0 },
+         { NULL, NULL, 0 },
+        };
+        DWORD cItem = 1;
+
+        if (!info->pszTimeStampAlgorithm || !info->pszContentType)
+            SetLastError(E_INVALIDARG);
+        else
+        {
+            if (info->cAttribute)
+            {
+                items[cItem].pvStructInfo = &attrs;
+                items[cItem++].encodeFunc = CRYPT_AsnEncodePKCSAttributes;
+            }
+            /* pszContentType and Content are laid out as a CRYPT_CONTENT_INFO */
+            items[cItem].pvStructInfo = &info->pszContentType;
+            items[cItem++].encodeFunc = CRYPT_AsnEncodePKCSContentInfo;
+            ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items, cItem,
+             dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
+
+static BOOL WINAPI CRYPT_AsnEncodeContentInfoSequenceOfAny(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CRYPT_CONTENT_INFO_SEQUENCE_OF_ANY *info = pvStructInfo;
+
+        if (!info->pszObjId)
+            SetLastError(E_INVALIDARG);
+        else
+        {
+            /* cValue and rgValue are laid out as a CRYPT_SEQUENCE_OF_ANY */
+            struct AsnConstructedItem constructed = { 0, &info->cValue, CRYPT_AsnEncodeSequenceOfAny };
+            struct AsnEncodeSequenceItem items[] = {
+             { info->pszObjId, CRYPT_AsnEncodeOid, 0 },
+             { &constructed, CRYPT_AsnEncodeConstructed, 0 },
+            };
+
+            ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items,
+             ARRAY_SIZE(items), dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
