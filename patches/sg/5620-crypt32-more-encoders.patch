From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: encoders for DSS, RC2, PKCS #8, certificate pair, request and time request structures

crypt32: encoders for DSS, RC2, PKCS #8, certificate pair, request and time request structures

CryptEncodeObjectEx encodes the types 5619 decodes, plus PKCS_RSA_PRIVATE_KEY
(from the CryptoAPI private key blob), X509_ECC_SIGNATURE and
X509_OBJECT_IDENTIFIER.
---
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -4749,6 +4749,461 @@ static BOOL WINAPI CRYPT_AsnEncodeOCSPRequest(DWORD dwCertEncodingType,
     return ret;
 }
 
+static BOOL WINAPI CRYPT_AsnEncodeDssParameters(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const CERT_DSS_PARAMETERS *params = pvStructInfo;
+        struct AsnEncodeSequenceItem items[] = {
+         { &params->p, CRYPT_AsnEncodeUnsignedInteger, 0 },
+         { &params->q, CRYPT_AsnEncodeUnsignedInteger, 0 },
+         { &params->g, CRYPT_AsnEncodeUnsignedInteger, 0 },
+        };
+
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items,
+         ARRAY_SIZE(items), dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
+
+/* A DSS signature is the 20 bytes of r followed by the 20 bytes of s, little-endian */
+static BOOL WINAPI CRYPT_AsnEncodeDssSignature(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret = FALSE;
+
+    __TRY
+    {
+        const BYTE *sig = pvStructInfo;
+        CERT_ECC_SIGNATURE ecc;
+        struct AsnEncodeSequenceItem items[] = {
+         { &ecc.r, CRYPT_AsnEncodeUnsignedInteger, 0 },
+         { &ecc.s, CRYPT_AsnEncodeUnsignedInteger, 0 },
+        };
+
+        ecc.r.cbData = CERT_DSS_R_LEN;
+        ecc.s.cbData = CERT_DSS_S_LEN;
+#ifndef SG_MUTANT_ENC_DSS_SWAP
+        ecc.r.pbData = (BYTE *)sig;
+        ecc.s.pbData = (BYTE *)sig + CERT_DSS_R_LEN;
+#else
+        ecc.s.pbData = (BYTE *)sig;
+        ecc.r.pbData = (BYTE *)sig + CERT_DSS_R_LEN;
+#endif
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items,
+         ARRAY_SIZE(items), dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+    }
+    __ENDTRY
+    return ret;
+}
