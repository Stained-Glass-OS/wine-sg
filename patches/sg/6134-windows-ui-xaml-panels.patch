+/* a composable class's factory CreateInstance */
+#define COMPOSABLE_CREATE(name, type, init, iface_field) \
+static HRESULT WINAPI name( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value ) \
+{ \
+    type *obj; \
+    if (!value) return E_POINTER; \
+    if (outer && !inner) return E_INVALIDARG; \
+    if (!(obj = calloc( 1, sizeof(*obj) ))) return E_OUTOFMEMORY; \
+    init; \
+    if (outer) \
+    { \
+        *inner = &obj->e_obj.IInspectable_inner; \
+        IUnknown_AddRef( obj->e_obj.outer ); \
+    } \
+    *value = &obj->iface_field; \
+    return S_OK; \
+}
