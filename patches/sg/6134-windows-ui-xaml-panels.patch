+/* ---- IVectorView<T> (live) ---- */
+
+static struct xview *view_from_iface( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xview, IVectorView_iface );
+}
+
+static struct xview *view_from_iterable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xview, IIterable_iface );
+}
+
+static HRESULT WINAPI view_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct xview *view = view_from_iface( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, view->vector->type->view_iid ))
+        *out = &view->IVectorView_iface;
+    else if (IsEqualGUID( iid, view->vector->type->iterable_iid ))
+        *out = &view->IIterable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &view->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI view_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &view_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( IInspectable *iface )
+{
+    struct xview *view = view_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &view->ref );
+
+    if (!ref)
+    {
+        IInspectable_Release( &view->vector->IVector_iface );
+        free( view );
+    }
+    return ref;
+}
