+struct griddef
+{
+    struct dobj d;
+    struct xiface IDefinition_iface;    /* IRowDefinition or IColumnDefinition */
+    BOOL column;
+    struct uielem *grid;                /* the grid it is in (no reference) */
+    struct xgrid_length length;
+    DOUBLE min, max, actual;
+};
+
+static struct griddef *def_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct griddef, d.obj );
+}
+
+static void def_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct griddef *def = CONTAINING_RECORD( obj, struct griddef, d );
+    struct xgrid_length star = { 1, XGRID_STAR };
+
+    if (prop == prop_row_height || prop == prop_col_width)
+    {
+        if (!xunbox_ref( new_value, &IID_IReference_GridLength, &def->length, sizeof(def->length) )) def->length = star;
+    }
+    else if (prop == prop_row_min || prop == prop_col_min) def->min = xunbox_double( new_value, 0 );
+    else if (prop == prop_row_max || prop == prop_col_max) def->max = xunbox_double( new_value, INFINITY );
+    if (def->grid) uielem_invalidate_measure( def->grid );
+}
+
+static HRESULT WINAPI def_get_Length( struct xiface *iface, struct xgrid_length *value )
+{
+    if (!value) return E_POINTER;
+    *value = def_from_iface( iface )->length;
+    return S_OK;
+}
