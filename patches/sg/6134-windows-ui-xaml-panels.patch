+
+static HRESULT WINAPI vector_GetView( IInspectable *iface, IInspectable **out )
+{
+    struct xvector *vector = vector_from_iface( iface );
+    struct xview *view;
+
+    if (!out) return E_POINTER;
+    if (!(view = calloc( 1, sizeof(*view) ))) return E_OUTOFMEMORY;
+    view->IVectorView_iface.lpVtbl = (void *)view_vtbl;
+    view->IIterable_iface.lpVtbl = (void *)view_iterable_vtbl;
+    view->ref = 1;
+    view->vector = vector;
+    IInspectable_AddRef( &vector->IVector_iface );
+    *out = &view->IVectorView_iface;
+    return S_OK;
+}
+
+/* ---- creation, and the owner's access ---- */
+
+HRESULT xvector_create( const struct xvector_type *type, void *owner, struct xvector **out )
+{
+    struct xvector *vector;
+
+    if (!(vector = calloc( 1, sizeof(*vector) ))) return E_OUTOFMEMORY;
+    vector->IVector_iface.lpVtbl = (void *)vector_vtbl;
+    vector->IIterable_iface.lpVtbl = (void *)iterable_vtbl;
+    vector->IExtra_iface.lpVtbl = (void *)extra_vtbl;
+    vector->ref = 1;
+    vector->type = type;
+    vector->owner = owner;
+    *out = vector;
+    return S_OK;
+}
+
+IInspectable *xvector_iface( struct xvector *vector )
+{
+    return &vector->IVector_iface;
+}
+
+UINT32 xvector_size( struct xvector *vector )
+{
+    return vector ? vector->size : 0;
+}
+
+IInspectable *xvector_item( struct xvector *vector, UINT32 index )
+{
+    return index < vector->size ? vector->items[index] : NULL;
+}
+
+/* the owner goes: its items are let go, the collection may live on (a program holds it) */
+void xvector_detach( struct xvector *vector )
+{
+    while (vector->size) vector_remove( vector, vector->size - 1, FALSE );
+    vector->owner = NULL;
+    IInspectable_Release( &vector->IVector_iface );
+}
