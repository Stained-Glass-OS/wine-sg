+static HRESULT WINAPI def_put_Length( struct xiface *iface, struct xgrid_length value )
+{
+    struct griddef *def = def_from_iface( iface );
+    return put_boxed( &def->d, def->column ? prop_col_width : prop_row_height,
+                      xbox_ref( &IID_IReference_GridLength, &value, sizeof(value) ) );
+}
