+static HRESULT new_def( BOOL column, IInspectable **out )
+{
+    struct griddef *def;
+
+    panels_init();
+    if (!(def = calloc( 1, sizeof(*def) ))) return E_OUTOFMEMORY;
+    def->IDefinition_iface.vtbl = column ? col_def_vtbl : row_def_vtbl;
+    def->column = column;
+    def->length.value = 1;
+    def->length.unit = XGRID_STAR;
+    def->max = INFINITY;
+    dobj_init( &def->d, column ? &col_def_class : &row_def_class, NULL );
+    *out = (IInspectable *)&def->IDefinition_iface;
+    return S_OK;
+}
