+static void invalidate_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    uielem_invalidate_measure( CONTAINING_RECORD( obj, struct uielem, d ) );
+}
+
+/* an attached Grid property changed on a child: its grid lays out again */
+static void child_cell_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct uielem *elem = uielem_from_inspectable( (IInspectable *)&obj->IDependencyObject_iface );
+
+    if (elem && elem->parent) uielem_invalidate_measure( elem->parent );
+}
+
+static struct xsize deflate( struct xsize size, const struct xthickness *t )
+{
+    size.width = fmax( 0, size.width - t->left - t->right );
+    size.height = fmax( 0, size.height - t->top - t->bottom );
+    return size;
+}
