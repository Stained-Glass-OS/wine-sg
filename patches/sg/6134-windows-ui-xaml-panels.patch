+static void stack_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    BOOL horizontal = dobj_enum( &elem->d, prop_orientation, &IID_IReference_Orientation, 0 ) == 1;
+    DOUBLE spacing = dobj_double( &elem->d, prop_spacing, 0 );
+    struct xthickness padding;
+    struct xsize avail;
+    struct uielem *child;
+    DOUBLE along = 0, across = 0;
+    UINT32 n = 0;
+
+    dobj_ref( &elem->d, prop_stack_padding, &IID_IReference_Thickness, &padding, sizeof(padding) );
+    avail = deflate( available, &padding );
+    if (horizontal) avail.width = INFINITY;
+    else avail.height = INFINITY;
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+    {
+        uielem_measure( child, avail );
+        if (child->visibility == XCOLLAPSED) continue;
+        along += horizontal ? child->desired.width : child->desired.height;
+        across = fmax( across, horizontal ? child->desired.height : child->desired.width );
+        n++;
+    }
+    if (n > 1) along += spacing * (n - 1);
+    desired->width = (horizontal ? along : across) + padding.left + padding.right;
+    desired->height = (horizontal ? across : along) + padding.top + padding.bottom;
+}
+
+static void stack_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    BOOL horizontal = dobj_enum( &elem->d, prop_orientation, &IID_IReference_Orientation, 0 ) == 1;
+    DOUBLE spacing = dobj_double( &elem->d, prop_spacing, 0 );
+    struct xthickness padding;
+    struct xsize inner;
+    struct uielem *child;
+    DOUBLE pos;
+
+    dobj_ref( &elem->d, prop_stack_padding, &IID_IReference_Thickness, &padding, sizeof(padding) );
+    inner = deflate( final, &padding );
+    pos = horizontal ? padding.left : padding.top;
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+    {
+        struct xrect rect;
+        if (child->visibility == XCOLLAPSED)
+        {
+            struct xrect none = { 0, 0, 0, 0 };
+            uielem_arrange( child, none );
+            continue;
+        }
+        if (horizontal)
+        {
+            rect.x = pos; rect.y = padding.top;
+            rect.width = child->desired.width; rect.height = inner.height;
+            pos += rect.width + spacing;
+        }
+        else
+        {
+            rect.x = padding.left; rect.y = pos;
+            rect.width = inner.width; rect.height = child->desired.height;
+            pos += rect.height + spacing;
+        }
+        uielem_arrange( child, rect );
+    }
+    *used = final;
+}
