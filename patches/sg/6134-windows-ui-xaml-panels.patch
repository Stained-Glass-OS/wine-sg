+static HRESULT WINAPI extra_Move( IInspectable *iface, UINT32 old_index, UINT32 new_index )
+{
+    struct xvector *vector = vector_from_extra( iface );
+    IInspectable *item;
+
+    if (old_index >= vector->size || new_index >= vector->size) return E_BOUNDS;
+    item = vector->items[old_index];
+    if (old_index < new_index)
+        memmove( vector->items + old_index, vector->items + old_index + 1, (new_index - old_index) * sizeof(item) );
+    else
+        memmove( vector->items + new_index + 1, vector->items + new_index, (old_index - new_index) * sizeof(item) );
+    vector->items[new_index] = item;
+    if (vector->type->changed) vector->type->changed( vector->owner );
+    return S_OK;
+}
