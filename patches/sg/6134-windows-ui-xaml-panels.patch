+
+/* the layout's tracks: a grid's rows or columns */
+struct track
+{
+    struct griddef *def;    /* NULL: the implicit one */
+    INT32 unit;
+    DOUBLE value, min, max;
+    DOUBLE size;            /* in the layout */
+    DOUBLE content;         /* what its content asks for */
+    DOUBLE offset;
+};
+
+struct cell
+{
+    struct uielem *child;
+    UINT32 row, column, row_span, column_span;
+};
+
+static struct track *get_tracks( struct xvector *defs, UINT32 *count )
+{
+    struct track *tracks;
+    UINT32 i, n = xvector_size( defs );
+
+    *count = max( n, 1 );
+    if (!(tracks = calloc( *count, sizeof(*tracks) ))) return NULL;
+    if (!n)
+    {
+        tracks[0].unit = XGRID_STAR;
+        tracks[0].value = 1;
+        tracks[0].max = INFINITY;
+        return tracks;
+    }
+    for (i = 0; i < n; i++)
+    {
+        struct griddef *def = def_from_inspectable( xvector_item( defs, i ) );
+        tracks[i].def = def;
+        tracks[i].unit = def ? def->length.unit : XGRID_STAR;
+        tracks[i].value = def ? def->length.value : 1;
+        tracks[i].min = def ? def->min : 0;
+        tracks[i].max = def ? def->max : INFINITY;
+        if (tracks[i].unit == XGRID_STAR && tracks[i].value <= 0) tracks[i].value = 0;
+    }
+    return tracks;
+}
+
+static struct cell *get_cells( struct grid *grid, UINT32 rows, UINT32 columns, UINT32 *count )
+{
+    struct uielem *child;
+    struct cell *cells;
+    UINT32 n = 0;
+
+    *count = list_count( &grid->p.e.children );
+    if (!(cells = calloc( max( *count, 1 ), sizeof(*cells) ))) return NULL;
+    LIST_FOR_EACH_ENTRY( child, &grid->p.e.children, struct uielem, entry )
+    {
+        INT32 r = dobj_int( &child->d, prop_row, 0 ), c = dobj_int( &child->d, prop_column, 0 );
+        INT32 rs = dobj_int( &child->d, prop_row_span, 1 ), cs = dobj_int( &child->d, prop_column_span, 1 );
+
+        cells[n].child = child;
+        cells[n].row = min( max( r, 0 ), rows - 1 );
+        cells[n].column = min( max( c, 0 ), columns - 1 );
+        cells[n].row_span = min( max( rs, 1 ), rows - cells[n].row );
+        cells[n].column_span = min( max( cs, 1 ), columns - cells[n].column );
+        n++;
+    }
+    return cells;
+}
+
+static BOOL spans_star( const struct track *tracks, UINT32 first, UINT32 span )
+{
+    UINT32 i;
+    for (i = first; i < first + span; i++) if (tracks[i].unit == XGRID_STAR) return TRUE;
+    return FALSE;
+}
+
+static DOUBLE span_size( const struct track *tracks, UINT32 first, UINT32 span, DOUBLE spacing, BOOL auto_infinite )
+{
+    DOUBLE size = spacing * (span - 1);
+    UINT32 i;
+
+    for (i = first; i < first + span; i++)
+    {
+        if (auto_infinite && tracks[i].unit != XGRID_PIXEL) return INFINITY;
+        size += tracks[i].size;
+    }
+    return size;
+}
+
+/* a child's need beyond its tracks goes to the last Auto (or star-as-auto) track of its span */
+static void grow_tracks( struct track *tracks, UINT32 first, UINT32 span, DOUBLE spacing, DOUBLE need )
+{
+    DOUBLE have = spacing * (span - 1);
+    INT32 i, last = -1;
+
+    for (i = first; i < (INT32)(first + span); i++)
+    {
+        have += tracks[i].size;
+        if (tracks[i].unit != XGRID_PIXEL) last = i;
+    }
+    if (last >= 0 && need > have) tracks[last].size = fmin( tracks[last].size + need - have, tracks[last].max );
+}
+
+static void init_sizes( struct track *tracks, UINT32 count )
+{
+    UINT32 i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (tracks[i].unit == XGRID_PIXEL) tracks[i].size = fmin( fmax( tracks[i].value, tracks[i].min ), tracks[i].max );
+        else tracks[i].size = tracks[i].min;
+        tracks[i].content = 0;
+    }
+}
+
+/* the stars share what is left of the space, by weight, within their min and max */
+static void share_stars( struct track *tracks, UINT32 count, DOUBLE space, DOUBLE spacing )
+{
+    DOUBLE fixed = spacing * (count - 1), weight = 0, left;
+    BOOL again = TRUE;
+    BOOL *done;
+    UINT32 i;
+
+#ifdef SG_MUTANT_GRID_NO_STARS
+    return;
+#endif
+    if (!(done = calloc( count, sizeof(*done) ))) return;
+    for (i = 0; i < count; i++)
+    {
+        if (tracks[i].unit == XGRID_STAR) weight += tracks[i].value;
+        else { fixed += tracks[i].size; done[i] = TRUE; }
+    }
+    /* a star clamped by its min or max takes that much, and the others share the rest */
+    while (again && weight > 0)
+    {
+        again = FALSE;
+        left = fmax( 0, space - fixed );
+        for (i = 0; i < count; i++)
+        {
+            DOUBLE share;
+            if (done[i]) continue;
+            share = left * tracks[i].value / weight;
+            if (share < tracks[i].min || share > tracks[i].max)
+            {
+                tracks[i].size = share < tracks[i].min ? tracks[i].min : tracks[i].max;
+                fixed += tracks[i].size;
+                weight -= tracks[i].value;
+                done[i] = again = TRUE;
+                break;
+            }
+        }
+    }
+    left = fmax( 0, space - fixed );
+    for (i = 0; i < count; i++)
+        if (!done[i]) tracks[i].size = weight > 0 ? left * tracks[i].value / weight : 0;
+    free( done );
+}
+
+/* what the stars need for their content, keeping their proportions */
+static DOUBLE stars_content( const struct track *tracks, UINT32 count )
+{
+    DOUBLE weight = 0, unit = 0;
+    UINT32 i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (tracks[i].unit != XGRID_STAR) continue;
+        weight += tracks[i].value;
+        if (tracks[i].value > 0) unit = fmax( unit, fmax( tracks[i].content, tracks[i].min ) / tracks[i].value );
+    }
+    return unit * weight;
+}
+
+static void grid_padding( struct grid *grid, struct xthickness *padding )
+{
+    dobj_ref( &grid->p.e.d, prop_grid_padding, &IID_IReference_Thickness, padding, sizeof(*padding) );
+}
+
+static DOUBLE sum_tracks( const struct track *tracks, UINT32 count, DOUBLE spacing, BOOL stars_by_content )
+{
+    DOUBLE size = spacing * (count - 1);
+    UINT32 i;
+
+    for (i = 0; i < count; i++) if (!stars_by_content || tracks[i].unit != XGRID_STAR) size += tracks[i].size;
+    if (stars_by_content) size += stars_content( tracks, count );
+    return size;
+}
+
+static void grid_tracks( struct grid *grid, struct xsize space, BOOL measure, struct track **rows_out, UINT32 *nrows,
+                         struct track **cols_out, UINT32 *ncols, struct cell **cells_out, UINT32 *ncells )
+{
+    DOUBLE row_spacing = dobj_double( &grid->p.e.d, prop_row_spacing, 0 );
+    DOUBLE col_spacing = dobj_double( &grid->p.e.d, prop_column_spacing, 0 );
+    struct track *rows, *cols;
+    struct cell *cells;
+    BOOL inf_w = isinf( space.width ), inf_h = isinf( space.height );
+    UINT32 i;
+
+    rows = get_tracks( grid->rows, nrows );
+    cols = get_tracks( grid->columns, ncols );
+    cells = get_cells( grid, *nrows, *ncols, ncells );
+    init_sizes( rows, *nrows );
+    init_sizes( cols, *ncols );
+    /* stars in an unbounded direction size to their content, as Auto does */
+    if (inf_w) for (i = 0; i < *ncols; i++) if (cols[i].unit == XGRID_STAR) cols[i].unit = XGRID_AUTO;
+    if (inf_h) for (i = 0; i < *nrows; i++) if (rows[i].unit == XGRID_STAR) rows[i].unit = XGRID_AUTO;
+
+    /* columns: the content of the Auto ones, then the stars' shares */
+    for (i = 0; i < *ncells; i++)
+    {
+        struct xsize avail;
+        if (spans_star( cols, cells[i].column, cells[i].column_span )) continue;
+        avail.width = span_size( cols, cells[i].column, cells[i].column_span, col_spacing, TRUE );
+        avail.height = INFINITY;
+        if (measure) uielem_measure( cells[i].child, avail );
+        grow_tracks( cols, cells[i].column, cells[i].column_span, col_spacing, cells[i].child->desired.width );
+    }
+    share_stars( cols, *ncols, space.width, col_spacing );
+    /* rows: the content of the Auto ones (children as wide as their cells), then the stars */
+    for (i = 0; i < *ncells; i++)
+    {
+        struct xsize avail;
+        if (spans_star( rows, cells[i].row, cells[i].row_span )) continue;
+        avail.width = span_size( cols, cells[i].column, cells[i].column_span, col_spacing, FALSE );
+        avail.height = span_size( rows, cells[i].row, cells[i].row_span, row_spacing, TRUE );
+        if (measure) uielem_measure( cells[i].child, avail );
+        grow_tracks( rows, cells[i].row, cells[i].row_span, row_spacing, cells[i].child->desired.height );
+    }
+    share_stars( rows, *nrows, space.height, row_spacing );
+    /* every child in its cell; the stars' content for the grid's own desired size */
+    for (i = 0; i < *ncells; i++)
+    {
+        struct xsize avail;
+        avail.width = span_size( cols, cells[i].column, cells[i].column_span, col_spacing, FALSE );
+        avail.height = span_size( rows, cells[i].row, cells[i].row_span, row_spacing, FALSE );
+        if (measure) uielem_measure( cells[i].child, avail );
+        if (cells[i].column_span == 1 && cols[cells[i].column].unit == XGRID_STAR)
+            cols[cells[i].column].content = fmax( cols[cells[i].column].content, cells[i].child->desired.width );
+        if (cells[i].row_span == 1 && rows[cells[i].row].unit == XGRID_STAR)
+            rows[cells[i].row].content = fmax( rows[cells[i].row].content, cells[i].child->desired.height );
+    }
+    *rows_out = rows;
+    *cols_out = cols;
+    *cells_out = cells;
+}
+
+static void grid_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    struct grid *grid = grid_from_elem( elem );
+    DOUBLE row_spacing = dobj_double( &elem->d, prop_row_spacing, 0 );
+    DOUBLE col_spacing = dobj_double( &elem->d, prop_column_spacing, 0 );
+    struct track *rows, *cols;
+    struct cell *cells;
+    struct xthickness padding;
+    UINT32 nrows, ncols, ncells;
+
+    grid_padding( grid, &padding );
+    grid_tracks( grid, deflate( available, &padding ), TRUE, &rows, &nrows, &cols, &ncols, &cells, &ncells );
+    if (!rows || !cols || !cells) goto done;
+    desired->width = sum_tracks( cols, ncols, col_spacing, TRUE ) + padding.left + padding.right;
+    desired->height = sum_tracks( rows, nrows, row_spacing, TRUE ) + padding.top + padding.bottom;
+done:
+    free( rows );
+    free( cols );
+    free( cells );
+}
+
+static void grid_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    struct grid *grid = grid_from_elem( elem );
+    DOUBLE row_spacing = dobj_double( &elem->d, prop_row_spacing, 0 );
+    DOUBLE col_spacing = dobj_double( &elem->d, prop_column_spacing, 0 );
+    struct track *rows, *cols;
+    struct cell *cells;
+    struct xthickness padding;
+    UINT32 nrows, ncols, ncells, i;
+    DOUBLE pos;
+
+    grid_padding( grid, &padding );
+    grid_tracks( grid, deflate( final, &padding ), FALSE, &rows, &nrows, &cols, &ncols, &cells, &ncells );
+    if (!rows || !cols || !cells) goto done;
+    for (i = 0, pos = padding.left; i < ncols; i++)
+    {
+        cols[i].offset = pos;
+        pos += cols[i].size + col_spacing;
+        if (cols[i].def) cols[i].def->actual = cols[i].size;
+    }
+    for (i = 0, pos = padding.top; i < nrows; i++)
+    {
+        rows[i].offset = pos;
+        pos += rows[i].size + row_spacing;
+        if (rows[i].def) rows[i].def->actual = rows[i].size;
+    }
+    for (i = 0; i < ncells; i++)
+    {
+        struct xrect rect;
+        rect.x = cols[cells[i].column].offset;
+        rect.y = rows[cells[i].row].offset;
+        rect.width = span_size( cols, cells[i].column, cells[i].column_span, col_spacing, FALSE );
+        rect.height = span_size( rows, cells[i].row, cells[i].row_span, row_spacing, FALSE );
+        uielem_arrange( cells[i].child, rect );
+    }
+    *used = final;
+done:
+    free( rows );
+    free( cols );
+    free( cells );
+}
+
+static const struct elem_ops grid_ops = { grid_measure, grid_arrange };
