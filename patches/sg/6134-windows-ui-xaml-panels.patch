+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * One implementation for the XAML collections of objects (a panel's Children, a grid's row and
+ * column definitions): a vector of T, its live view and iterators.  The parameterized interfaces'
+ * IIDs are those of their signatures (the WinRT rule), given by the collection's type
+ * (struct xvector_type); its owner hears of every item that comes and goes, and may refuse one.
+ * Method order per Wine's windows.foundation.collections.idl.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+struct xvector
+{
+    IInspectable IVector_iface;
+    IInspectable IIterable_iface;
+    IInspectable IExtra_iface;          /* the type's own extra interface (UIElementCollection.Move) */
+    LONG ref;
+    const struct xvector_type *type;
+    void *owner;
+    IInspectable **items;
+    UINT32 size, capacity;
+};
+
+struct xview
+{
+    IInspectable IVectorView_iface;
+    IInspectable IIterable_iface;
+    LONG ref;
+    struct xvector *vector;
+};
+
+struct xiterator
+{
+    IInspectable IIterator_iface;
+    LONG ref;
+    struct xvector *vector;
+    UINT32 index;
+};
+
+static struct xvector *vector_from_iface( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xvector, IVector_iface );
+}
+
+static struct xvector *vector_from_iterable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xvector, IIterable_iface );
+}
+
+static struct xvector *vector_from_extra( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xvector, IExtra_iface );
+}
+
+/* ---- common IInspectable ---- */
+
+static HRESULT WINAPI vector_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, vector->type->vector_iid ))
+        *out = &vector->IVector_iface;
+    else if (IsEqualGUID( iid, vector->type->iterable_iid ))
+        *out = &vector->IIterable_iface;
+    else if (vector->type->extra_iid && IsEqualGUID( iid, vector->type->extra_iid ))
+        *out = &vector->IExtra_iface;
+    else
+    {
+        FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( vector->type->name ), debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &vector->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI vector_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &vector_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI vector_Release( IInspectable *iface )
+{
+    struct xvector *vector = vector_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &vector->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < vector->size; i++) IInspectable_Release( vector->items[i] );
+        free( vector->items );
+        free( vector );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI vector_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = *vector->type->vector_iid;
+    (*iids)[1] = *vector->type->iterable_iid;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    return xaml_hstring( vector_from_iface( iface )->type->name, name );
+}
+
+static HRESULT WINAPI vector_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* ---- IVector<T> ---- */
+
+static HRESULT WINAPI vector_GetAt( IInspectable *iface, UINT32 index, IInspectable **value )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (index >= vector->size) return E_BOUNDS;
+    IInspectable_AddRef( (*value = vector->items[index]) );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_get_Size( IInspectable *iface, UINT32 *size )
+{
+    if (!size) return E_POINTER;
+    *size = vector_from_iface( iface )->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetView( IInspectable *iface, IInspectable **view );
+
+static BOOL same_object( IInspectable *a, IInspectable *b )
+{
+    IUnknown *ua, *ub;
+    BOOL ret;
+
+    if (a == b) return TRUE;
+    if (!a || !b) return FALSE;
+    IInspectable_QueryInterface( a, &IID_IUnknown, (void **)&ua );
+    IInspectable_QueryInterface( b, &IID_IUnknown, (void **)&ub );
+    ret = ua == ub;
+    IUnknown_Release( ua );
+    IUnknown_Release( ub );
+    return ret;
+}
+
+static HRESULT WINAPI vector_IndexOf( IInspectable *iface, IInspectable *value, UINT32 *index, boolean *found )
+{
+    struct xvector *vector = vector_from_iface( iface );
+    UINT32 i;
+
+    if (!index || !found) return E_POINTER;
+    for (i = 0; i < vector->size; i++)
+        if (same_object( vector->items[i], value )) break;
+    *found = i < vector->size;
+    *index = *found ? i : 0;
+    return S_OK;
+}
+
+/* the item as the collection's T (its default interface), with a reference */
+static HRESULT item_of_type( struct xvector *vector, IInspectable *value, IInspectable **item )
+{
+    if (!value) return E_INVALIDARG;
+    return IInspectable_QueryInterface( value, vector->type->item_iid, (void **)item );
+}
+
+static HRESULT vector_insert( struct xvector *vector, UINT32 index, IInspectable *value )
+{
+    IInspectable *item;
+    HRESULT hr;
+
+    if (index > vector->size) return E_BOUNDS;
+    if (FAILED(hr = item_of_type( vector, value, &item ))) return hr;
+    if (vector->type->added && FAILED(hr = vector->type->added( vector->owner, item )))
+    {
+        IInspectable_Release( item );
+        return hr;
+    }
+    if (vector->size == vector->capacity)
+    {
+        UINT32 capacity = max( 8, vector->capacity * 2 );
+        IInspectable **items = realloc( vector->items, capacity * sizeof(*items) );
+        if (!items)
+        {
+            if (vector->type->removed) vector->type->removed( vector->owner, item );
+            IInspectable_Release( item );
+            return E_OUTOFMEMORY;
+        }
+        vector->items = items;
+        vector->capacity = capacity;
+    }
+    memmove( vector->items + index + 1, vector->items + index, (vector->size - index) * sizeof(*vector->items) );
+    vector->items[index] = item;
+    vector->size++;
+    if (vector->type->changed) vector->type->changed( vector->owner );
+    return S_OK;
+}
+
+static void vector_remove( struct xvector *vector, UINT32 index, BOOL notify )
+{
+    IInspectable *item = vector->items[index];
+
+    memmove( vector->items + index, vector->items + index + 1, (vector->size - index - 1) * sizeof(*vector->items) );
+    vector->size--;
+    if (vector->type->removed) vector->type->removed( vector->owner, item );
+    IInspectable_Release( item );
+    if (notify && vector->type->changed) vector->type->changed( vector->owner );
+}
+
+static HRESULT WINAPI vector_SetAt( IInspectable *iface, UINT32 index, IInspectable *value )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    if (index >= vector->size) return E_BOUNDS;
+    vector_remove( vector, index, FALSE );
+    return vector_insert( vector, index, value );
+}
+
+static HRESULT WINAPI vector_InsertAt( IInspectable *iface, UINT32 index, IInspectable *value )
+{
+    return vector_insert( vector_from_iface( iface ), index, value );
+}
+
+static HRESULT WINAPI vector_RemoveAt( IInspectable *iface, UINT32 index )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    if (index >= vector->size) return E_BOUNDS;
+    vector_remove( vector, index, TRUE );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_Append( IInspectable *iface, IInspectable *value )
+{
+    struct xvector *vector = vector_from_iface( iface );
+    return vector_insert( vector, vector->size, value );
+}
+
+static HRESULT WINAPI vector_RemoveAtEnd( IInspectable *iface )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    if (!vector->size) return E_BOUNDS;
+    vector_remove( vector, vector->size - 1, TRUE );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_Clear( IInspectable *iface )
+{
+    struct xvector *vector = vector_from_iface( iface );
+
+    while (vector->size) vector_remove( vector, vector->size - 1, FALSE );
+    if (vector->type->changed) vector->type->changed( vector->owner );
+    return S_OK;
+}
+
+static HRESULT get_many( struct xvector *vector, UINT32 start, UINT32 count, IInspectable **items, UINT32 *actual )
+{
+    UINT32 i;
+
+    if (!actual) return E_POINTER;
+    *actual = 0;
+    if (start > vector->size) return E_BOUNDS;
+    for (i = start; i < vector->size && i - start < count; i++)
+        IInspectable_AddRef( (items[i - start] = vector->items[i]) );
+    *actual = i - start;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetMany( IInspectable *iface, UINT32 start, UINT32 count, IInspectable **items, UINT32 *actual )
+{
+    return get_many( vector_from_iface( iface ), start, count, items, actual );
+}
+
+static HRESULT WINAPI vector_ReplaceAll( IInspectable *iface, UINT32 count, IInspectable **items )
+{
+    struct xvector *vector = vector_from_iface( iface );
+    HRESULT hr;
+    UINT32 i;
+
+    while (vector->size) vector_remove( vector, vector->size - 1, FALSE );
+    for (i = 0; i < count; i++)
+        if (FAILED(hr = vector_insert( vector, vector->size, items[i] ))) return hr;
+    if (!count && vector->type->changed) vector->type->changed( vector->owner );
+    return S_OK;
+}
+
+static const void *vector_vtbl[] =
+{
+    vector_QueryInterface, vector_AddRef, vector_Release, vector_GetIids, vector_GetRuntimeClassName, vector_GetTrustLevel,
+    vector_GetAt, vector_get_Size, vector_GetView, vector_IndexOf, vector_SetAt, vector_InsertAt, vector_RemoveAt,
+    vector_Append, vector_RemoveAtEnd, vector_Clear, vector_GetMany, vector_ReplaceAll,
+};
+
+/* ---- IIterator<T> ---- */
+
+static struct xiterator *iterator_from_iface( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct xiterator, IIterator_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct xiterator *it = iterator_from_iface( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, it->vector->type->iterator_iid ))
+    {
+        *out = iface;
+        IInspectable_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &iterator_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IInspectable *iface )
+{
+    struct xiterator *it = iterator_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &it->ref );
+
+    if (!ref)
+    {
+        IInspectable_Release( &it->vector->IVector_iface );
+        free( it );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_get_Current( IInspectable *iface, IInspectable **value )
+{
+    struct xiterator *it = iterator_from_iface( iface );
+    return vector_GetAt( &it->vector->IVector_iface, it->index, value );
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IInspectable *iface, boolean *value )
+{
+    struct xiterator *it = iterator_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    *value = it->index < it->vector->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IInspectable *iface, boolean *value )
+{
+    struct xiterator *it = iterator_from_iface( iface );
+
+    if (it->index < it->vector->size) it->index++;
+    return iterator_get_HasCurrent( iface, value );
+}
+
+static HRESULT WINAPI iterator_GetMany( IInspectable *iface, UINT32 count, IInspectable **items, UINT32 *actual )
+{
+    struct xiterator *it = iterator_from_iface( iface );
+    HRESULT hr = get_many( it->vector, it->index, count, items, actual );
+
+    if (SUCCEEDED(hr)) it->index += *actual;
+    return hr;
+}
+
+static const void *iterator_vtbl[] =
+{
+    iterator_QueryInterface, iterator_AddRef, iterator_Release, vector_GetIids, vector_GetRuntimeClassName,
+    vector_GetTrustLevel, iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany,
+};
+
+static HRESULT new_iterator( struct xvector *vector, IInspectable **out )
+{
+    struct xiterator *it;
+
+    if (!out) return E_POINTER;
+    if (!(it = calloc( 1, sizeof(*it) ))) return E_OUTOFMEMORY;
+    it->IIterator_iface.lpVtbl = (void *)iterator_vtbl;
+    it->ref = 1;
+    it->vector = vector;
+    IInspectable_AddRef( &vector->IVector_iface );
+    *out = &it->IIterator_iface;
+    return S_OK;
+}
+
+/* ---- IIterable<T> of the vector ---- */
+
+static HRESULT WINAPI iterable_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    return vector_QueryInterface( &vector_from_iterable( iface )->IVector_iface, iid, out );
+}
+
+static ULONG WINAPI iterable_AddRef( IInspectable *iface )
+{
+    return vector_AddRef( &vector_from_iterable( iface )->IVector_iface );
+}
+
+static ULONG WINAPI iterable_Release( IInspectable *iface )
+{
+    return vector_Release( &vector_from_iterable( iface )->IVector_iface );
+}
+
+static HRESULT WINAPI iterable_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
