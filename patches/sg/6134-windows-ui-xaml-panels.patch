+{
+    struct xiface *iface = (struct xiface *)item;   /* kept as IRowDefinition/IColumnDefinition */
+
+    if (iface->vtbl != row_def_vtbl && iface->vtbl != col_def_vtbl) return NULL;
+    return def_from_iface( iface );
+}
