+    border_insets( elem, &insets );
+    desired->width = insets.left + insets.right;
+    desired->height = insets.top + insets.bottom;
+    if (!border->child) return;
+    uielem_measure( border->child, deflate( available, &insets ) );
+    desired->width += border->child->desired.width;
+    desired->height += border->child->desired.height;
