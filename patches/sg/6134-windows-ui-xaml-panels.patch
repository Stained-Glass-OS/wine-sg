+static INT32 dobj_enum( struct dobj *obj, struct xaml_property *prop, const GUID *iid, INT32 def )
+{
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    if (FAILED(dobj_get_value( obj, prop, &box ))) return def;
+    ret = xunbox_enum( box, iid, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static INT32 dobj_int( struct dobj *obj, struct xaml_property *prop, INT32 def )
+{
+    return dobj_enum( obj, prop, NULL, def );
+}
+
+static DOUBLE dobj_double( struct dobj *obj, struct xaml_property *prop, DOUBLE def )
+{
+    IInspectable *box = NULL;
+    DOUBLE ret;
+
+    if (FAILED(dobj_get_value( obj, prop, &box ))) return def;
+    ret = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static void dobj_ref( struct dobj *obj, struct xaml_property *prop, const GUID *iid, void *value, size_t size )
+{
+    IInspectable *box = NULL;
+
+    memset( value, 0, size );
+    if (FAILED(dobj_get_value( obj, prop, &box ))) return;
+    xunbox_ref( box, iid, value, size );
+    if (box) IInspectable_Release( box );
+}
+
+static HRESULT put_boxed( struct dobj *obj, struct xaml_property *prop, IInspectable *box )
+{
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( obj, prop, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT get_object( struct dobj *obj, struct xaml_property *prop, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( obj, prop, value );
+}
