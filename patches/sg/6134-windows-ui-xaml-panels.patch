+static struct panel *panel_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct panel, e.d.obj );
+}
+
+/* the visual children follow the collection's order */
+static void panel_sync( struct panel *panel )
+{
+    struct uielem *child;
+    UINT32 i;
+
+    for (i = 0; i < xvector_size( panel->children ); i++)
+    {
+        if (!(child = uielem_from_inspectable( xvector_item( panel->children, i ) ))) continue;
+        list_remove( &child->entry );
+        list_add_tail( &panel->e.children, &child->entry );
+    }
+    uielem_invalidate_measure( &panel->e );
+}
+
+static HRESULT children_added( void *owner, IInspectable *item )
+{
+    struct uielem *child = uielem_from_inspectable( item );
+    struct panel *panel = owner;
+
+    if (!child)
+    {
+        FIXME( "%p is not one of our elements\n", item );
+        return E_INVALIDARG;
+    }
+    if (child->parent && child->parent != &panel->e) return E_INVALIDARG;   /* already another's child */
+    if (panel) uielem_add_child( &panel->e, child );
+    return S_OK;
+}
+
+static void children_removed( void *owner, IInspectable *item )
+{
+    struct uielem *child = uielem_from_inspectable( item );
+    struct panel *panel = owner;
+
+    if (panel && child) uielem_remove_child( &panel->e, child );
+}
+
+static void children_changed( void *owner )
+{
+    if (owner) panel_sync( owner );
+}
