 static HRESULT WINAPI shellfolderviewdual_get_GroupBy(IShellFolderViewDual3 *iface, BSTR *groupby)
 {
     IShellViewImpl *This = impl_from_IShellFolderViewDual3(iface);
-    FIXME("%p %p\n", This, groupby);
-    return E_NOTIMPL;
+    PROPERTYKEY key;
+    WCHAR *name = NULL;
+    BOOL ascending;
+    HRESULT hr;
+
+    TRACE("%p %p\n", This, groupby);
+
+    if (!groupby) return E_INVALIDARG;
+    *groupby = NULL;
+    if (FAILED(hr = IFolderView2_GetGroupBy(&This->IFolderView2_iface, &key, &ascending))) return hr;
+    /* no grouping: the empty string */
+    if (IsEqualGUID(&key.fmtid, &GUID_NULL) || FAILED(PSGetNameFromPropertyKey(&key, &name)) || !name)
+    {
+        *groupby = SysAllocString(L"");
+        return *groupby ? S_OK : E_OUTOFMEMORY;
+    }
+    *groupby = SysAllocString(name);
+    CoTaskMemFree(name);
+    return *groupby ? S_OK : E_OUTOFMEMORY;
