+/* The Folder object of an absolute id list, for the objects of a folder view. */
+HRESULT SHELL_CreateFolderObject(PCIDLIST_ABSOLUTE pidl, Folder **ret)
+{
+    LPITEMIDLIST copy = ILClone(pidl);
+    HRESULT hr;
+
+    *ret = NULL;
+    if (!copy) return E_OUTOFMEMORY;
+    hr = create_folder_for_pidl(copy, ret);
+    ILFree(copy);
+    return hr == S_OK && *ret ? S_OK : E_FAIL;
+}
+
+static BSTR folder_child_name(FolderImpl *folder, PCUITEMID_CHILD pidl)
+{
+    STRRET strret;
+    BSTR name = NULL;
+
+    if (SUCCEEDED(IShellFolder2_GetDisplayNameOf(folder->folder, pidl, SHGDN_FORPARSING, &strret)))
+        StrRetToBSTR(&strret, pidl, &name);
+    return name;
+}
+
+/* The FolderItem of one item of a Folder. */
+HRESULT SHELL_CreateFolderItemObject(Folder *folder, PCUITEMID_CHILD pidl, FolderItem **ret)
+{
+    FolderImpl *impl = impl_from_Folder((Folder3 *)folder);
+    BSTR name = folder_child_name(impl, pidl);
+    HRESULT hr;
+
+    *ret = NULL;
+    if (!name) return E_FAIL;
+    hr = FolderItem_Constructor(impl, name, ret);
+    SysFreeString(name);
+    return hr;
+}
+
+/* The FolderItems of some of the items of a Folder (the selection of a view). */
+HRESULT SHELL_CreateFolderItemsObject(Folder *folder, UINT count, PCUITEMID_CHILD_ARRAY pidls, FolderItems **ret)
+{
+    FolderImpl *impl = impl_from_Folder((Folder3 *)folder);
+    FolderItemsImpl *This;
+    UINT i;
+
+    *ret = NULL;
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    This->FolderItems3_iface.lpVtbl = &FolderItemsImpl_Vtbl;
+    This->ref = 1;
+    This->folder = impl;
+    Folder3_AddRef(&impl->Folder3_iface);
+    if (count && !(This->item_names = calloc(count, sizeof(*This->item_names))))
+    {
+        FolderItemsImpl_Release(&This->FolderItems3_iface);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+        if ((This->item_names[This->item_count] = folder_child_name(impl, pidls[i]))) This->item_count++;
+    *ret = (FolderItems *)&This->FolderItems3_iface;
+    return S_OK;
+}
