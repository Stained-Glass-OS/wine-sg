 static HRESULT WINAPI shellfolderviewdual_get_SortColumns(IShellFolderViewDual3 *iface, BSTR *sortcolumns)
 {
     IShellViewImpl *This = impl_from_IShellFolderViewDual3(iface);
-    FIXME("%p %p\n", This, sortcolumns);
-    return E_NOTIMPL;
+    SORTCOLUMN column;
+    WCHAR *name = NULL, text[256];
+    HRESULT hr;
+
+    TRACE("%p %p\n", This, sortcolumns);
+
+    if (!sortcolumns) return E_INVALIDARG;
+    *sortcolumns = NULL;
+    if (FAILED(hr = IFolderView2_GetSortColumns(&This->IFolderView2_iface, &column, 1))) return hr;
+    if (FAILED(hr = PSGetNameFromPropertyKey(&column.propkey, &name)) || !name) return FAILED(hr) ? hr : E_FAIL;
+    /* "prop:" and the columns with their direction: + ascending, - descending */
+    swprintf(text, ARRAY_SIZE(text), L"prop:%c%s;", column.direction == SORT_DESCENDING ? '-' : '+', name);
+    CoTaskMemFree(name);
+    *sortcolumns = SysAllocString(text);
+    return *sortcolumns ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI shellfolderviewdual_put_SortColumns(IShellFolderViewDual3 *iface, BSTR sortcolumns)
 {
     IShellViewImpl *This = impl_from_IShellFolderViewDual3(iface);
-    FIXME("%p %s\n", This, debugstr_w(sortcolumns));
-    return E_NOTIMPL;
+    WCHAR *copy, *p, *end;
+    SORTCOLUMN column;
+    HRESULT hr = E_INVALIDARG;
+
+    TRACE("%p %s\n", This, debugstr_w(sortcolumns));
+
+    if (!sortcolumns || wcsnicmp(sortcolumns, L"prop:", 5)) return E_INVALIDARG;
+    if (!(copy = wcsdup(sortcolumns + 5))) return E_OUTOFMEMORY;
+    /* the first column decides, as the view sorts by one */
+    p = copy;
+    column.direction = SORT_ASCENDING;
+    if (*p == '-') { column.direction = SORT_DESCENDING; p++; }
+    else if (*p == '+') p++;
+    if ((end = wcschr(p, ';'))) *end = 0;
+#ifdef SG_MUTANT_FV_SORT
+    *p = 0;
+#endif
+    if (*p && SUCCEEDED(PSGetPropertyKeyFromName(p, &column.propkey)))
+        hr = IFolderView2_SetSortColumns(&This->IFolderView2_iface, &column, 1);
+    free(copy);
+    return hr;
 }
 
