 static HRESULT WINAPI shellfolderviewdual_get_FocusedItem(IShellFolderViewDual3 *iface,
     FolderItem **item)
 {
     IShellViewImpl *This = impl_from_IShellFolderViewDual3(iface);
-    FIXME("%p %p\n", This, item);
-    return E_NOTIMPL;
+    PIDLIST_ABSOLUTE pidl;
+    PITEMID_CHILD child;
+    Folder *folder;
+    int index;
+    HRESULT hr;
+
+    TRACE("%p %p\n", This, item);
+
+    if (!item) return E_INVALIDARG;
+    *item = NULL;
+    if (!This->hWndList) return S_FALSE;
+    if (SendMessageW(This->hWndList, LVM_GETITEMCOUNT, 0, 0) <= 0) return S_FALSE;
+    if ((index = SendMessageW(This->hWndList, LVM_GETNEXTITEM, -1, LVNI_FOCUSED)) < 0) return S_FALSE;
+    if (FAILED(hr = FolderView_Item(&This->IFolderView2_iface, index, &child))) return hr;
+    if (SUCCEEDED(hr = dual_get_folder_pidl(This, &pidl)))
+    {
+        hr = SHELL_CreateFolderObject(pidl, &folder);
+        ILFree(pidl);
+        if (SUCCEEDED(hr))
+        {
+            hr = SHELL_CreateFolderItemObject(folder, child, item);
+            Folder_Release(folder);
+        }
+    }
+    ILFree(child);
+    return hr;
 }
 
 static HRESULT WINAPI shellfolderviewdual_SelectItem(IShellFolderViewDual3 *iface,
     VARIANT *v, int flags)
 {
     IShellViewImpl *This = impl_from_IShellFolderViewDual3(iface);
-    FIXME("%p %s %x\n", This, debugstr_variant(v), flags);
-    return E_NOTIMPL;
+    PITEMID_CHILD child = NULL;
+    HRESULT hr = E_INVALIDARG;
+
+    TRACE("%p %s %x\n", This, debugstr_variant(v), flags);
+
+    if (!v || !This->hWndList) return E_INVALIDARG;
+    if (V_VT(v) == (VT_VARIANT | VT_BYREF)) v = V_VARIANTREF(v);
+    if (V_VT(v) == VT_I4 || V_VT(v) == VT_I2)
+    {
+        /* an item by its position */
+        hr = FolderView_Item(&This->IFolderView2_iface, V_VT(v) == VT_I4 ? V_I4(v) : V_I2(v), &child);
+    }
+    else if (V_VT(v) == VT_DISPATCH && V_DISPATCH(v))
+    {
+        /* a FolderItem: found by its path in the folder of the view */
+        FolderItem *fi;
+
+        if (SUCCEEDED(IDispatch_QueryInterface(V_DISPATCH(v), &IID_FolderItem, (void **)&fi)))
+        {
+            BSTR path = NULL;
+            PIDLIST_ABSOLUTE abs;
+
+            if (SUCCEEDED(FolderItem_get_Path(fi, &path)) && path && SUCCEEDED(SHParseDisplayName(path, NULL, &abs, 0, NULL)))
+            {
+                child = ILClone(ILFindLastID(abs));
+                ILFree(abs);
+                hr = child ? S_OK : E_OUTOFMEMORY;
+            }
+            SysFreeString(path);
+            FolderItem_Release(fi);
+        }
+    }
+    if (FAILED(hr)) return hr;
+#ifdef SG_MUTANT_FV_ITEM
+    ILFree(child);
+    return S_OK;
+#endif
+    hr = IShellView3_SelectItem(&This->IShellView3_iface, child, flags);
+    ILFree(child);
+    return hr;
 }
 
