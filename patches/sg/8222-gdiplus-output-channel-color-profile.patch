@@ -1021,6 +1038,71 @@
     return fmt;
 }
 
+#ifndef SG_MUTANT_GDIP_NO_CHANNEL_PROFILE
+/* the output channel through a CMYK profile: each pixel's ink of the channel, in gray (white: none) */
+static BOOL separate_with_profile( const WCHAR *path, BYTE *data, UINT width, UINT height, INT stride,
+                                   ColorChannelFlags channel )
+{
+    PROFILE src = { PROFILE_FILENAME }, dst = { PROFILE_FILENAME };
+    WCHAR srgb[MAX_PATH];
+    DWORD size = sizeof(srgb), intents[2] = { INTENT_PERCEPTUAL, INTENT_PERCEPTUAL };
+    HPROFILE profiles[2] = { 0 };
+    PROFILEHEADER header;
+    HTRANSFORM xform = 0;
+    BYTE *cmyk = NULL;
+    BOOL ret = FALSE;
+    UINT x, y;
+
+    if (!GetStandardColorSpaceProfileW( NULL, LCS_sRGB, srgb, &size )) return FALSE;
+    src.pProfileData = srgb;
+    src.cbDataSize = (lstrlenW( srgb ) + 1) * sizeof(WCHAR);
+    dst.pProfileData = (void *)path;
+    dst.cbDataSize = (lstrlenW( path ) + 1) * sizeof(WCHAR);
+    if (!(profiles[0] = OpenColorProfileW( &src, PROFILE_READ, FILE_SHARE_READ, OPEN_EXISTING ))) goto done;
+    if (!(profiles[1] = OpenColorProfileW( &dst, PROFILE_READ, FILE_SHARE_READ, OPEN_EXISTING )))
+    {
+        WARN( "cannot open %s\n", debugstr_w(path) );
+        goto done;
+    }
+    if (!GetColorProfileHeader( profiles[1], &header ) || header.phDataColorSpace != SPACE_CMYK)
+    {
+        WARN( "%s is not a CMYK profile\n", debugstr_w(path) );
+        goto done;
+    }
+    if (!(xform = CreateMultiProfileTransform( profiles, 2, intents, 2, BEST_MODE, INDEX_DONT_CARE ))) goto done;
+    if (!(cmyk = malloc( width * 4 ))) goto done;
+    for (y = 0; y < height; y++)
+    {
+        BYTE *row = data + stride * y;
+        if (!TranslateBitmapBits( xform, row, BM_xRGBQUADS, width, 1, width * 4, cmyk, BM_KYMCQUADS, width * 4,
+                                  NULL, 0 ))
+            goto done;
+        for (x = 0; x < width; x++)
+        {
+            ARGB *px = (ARGB *)(row + 4 * x);
+            BYTE ink;
+            /* BM_KYMCQUADS (K in the high byte): C, M, Y, K in memory */
+            switch (channel)
+            {
+            case ColorChannelFlagsC: ink = cmyk[4 * x]; break;
+            case ColorChannelFlagsM: ink = cmyk[4 * x + 1]; break;
+            case ColorChannelFlagsY: ink = cmyk[4 * x + 2]; break;
+            default: ink = cmyk[4 * x + 3]; break;
+            }
+            ink = 255 - ink;
+            *px = (*px & 0xff000000) | (ink << 16) | (ink << 8) | ink;
+        }
+    }
+    ret = TRUE;
+done:
+    free( cmyk );
+    if (xform) DeleteColorTransform( xform );
+    if (profiles[1]) CloseColorProfile( profiles[1] );
+    if (profiles[0]) CloseColorProfile( profiles[0] );
+    return ret;
+}
+#endif
