 #include "objbase.h"
 
@@ -251,14 +258,34 @@
     ColorAdjustType type, BOOL enableFlag,
     GDIPCONST WCHAR *colorProfileFilename)
 {
-    static int calls;
-
     TRACE("(%p,%u,%i,%s)\n", imageAttr, type, enableFlag, debugstr_w(colorProfileFilename));
 
-    if(!(calls++))
-        FIXME("not implemented\n");
-
+#ifndef SG_MUTANT_GDIP_NO_CHANNEL_PROFILE
+    /* Stained Glass OS (wine-sg 8222): the CMYK profile the output channel separates the colours with; a bare
+     * file name is one in the colour directory (as documented) */
+    if (!imageAttr || type >= ColorAdjustTypeCount)
+        return InvalidParameter;
+    if (!enableFlag)
+    {
+        imageAttr->output_profile[type][0] = 0;
+        return Ok;
+    }
+    if (!colorProfileFilename || !*colorProfileFilename)
+        return InvalidParameter;
+    if (wcspbrk( colorProfileFilename, L"\\/:" ))
+        lstrcpynW( imageAttr->output_profile[type], colorProfileFilename, MAX_PATH );
+    else
+    {
+        WCHAR dir[MAX_PATH];
+        DWORD size = sizeof(dir);
+        if (!GetColorDirectoryW( NULL, dir, &size )) return Win32Error;
+        if (wcslen( dir ) + 1 + wcslen( colorProfileFilename ) >= MAX_PATH) return InvalidParameter;
+        swprintf( imageAttr->output_profile[type], MAX_PATH, L"%s\\%s", dir, colorProfileFilename );
+    }
+    return Ok;
+#else
     return NotImplemented;
+#endif
 }
 
