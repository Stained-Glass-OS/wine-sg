From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: GdipSetImageAttributesOutputChannelColorProfile

The CMYK profile the output channel separates colours with: kept per adjust type (a bare name is one in the colour directory, as documented); drawing translates sRGB to that profile with mscms (BM_KYMCQUADS) and shows the channel's ink in gray. Without a usable CMYK profile the plain conversion stays. It returned NotImplemented.
---
--- a/dlls/gdiplus/Makefile.in
+++ b/dlls/gdiplus/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = gdiplus.dll
 IMPORTLIB = gdiplus
 IMPORTS   = uuid shlwapi ole32 oleaut32 user32 gdi32 mlang
-DELAYIMPORTS = windowscodecs
+DELAYIMPORTS = windowscodecs mscms
 
 SOURCES = \
 	brush.c \
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -555,6 +555,7 @@
     enum imageattr_noop noop[ColorAdjustTypeCount];
     BOOL output_channel_enabled[ColorAdjustTypeCount];   /* 6505 */
     ColorChannelFlags output_channel[ColorAdjustTypeCount];
+    WCHAR output_profile[ColorAdjustTypeCount][MAX_PATH];   /* 8222: the CMYK profile of the output channel, "" none */
 };
 
