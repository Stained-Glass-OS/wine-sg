From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] oleacc: IAccessible objects are real IDispatch; LresultFromObject takes any wParam

The IAccessible objects for a window's client area, the window itself and its
parts (title bar, menu, scroll bars...) answered E_NOTIMPL to GetTypeInfoCount,
GetTypeInfo, GetIDsOfNames and Invoke, so scripting clients and anything that
late-binds through IDispatch could not use them. They now delegate to the
embedded Accessibility type library (IAccessible type info, cached per process
and released at DLL detach); a non-null riid gives DISP_E_UNKNOWNINTERFACE.
LresultFromObject no longer FIXMEs on a non-zero wParam (the marshalling is
always local) and returns a proper failure HRESULT when the mapping cannot be
created.
---
--- a/dlls/oleacc/client.c
+++ b/dlls/oleacc/client.c
@@ -159,36 +159,32 @@ static ULONG WINAPI Client_Release(IAccessible *iface)
 
 static HRESULT WINAPI Client_GetTypeInfoCount(IAccessible *iface, UINT *pctinfo)
 {
-    Client *This = impl_from_Client(iface);
-    FIXME("(%p)->(%p)\n", This, pctinfo);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", iface, pctinfo);
+    return accessible_get_typeinfo_count(pctinfo);
 }
 
 static HRESULT WINAPI Client_GetTypeInfo(IAccessible *iface,
         UINT iTInfo, LCID lcid, ITypeInfo **ppTInfo)
 {
-    Client *This = impl_from_Client(iface);
-    FIXME("(%p)->(%u %lx %p)\n", This, iTInfo, lcid, ppTInfo);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%u %lx %p)\n", iface, iTInfo, lcid, ppTInfo);
+    return accessible_get_typeinfo(iTInfo, lcid, ppTInfo);
 }
 
 static HRESULT WINAPI Client_GetIDsOfNames(IAccessible *iface, REFIID riid,
         LPOLESTR *rgszNames, UINT cNames, LCID lcid, DISPID *rgDispId)
 {
-    Client *This = impl_from_Client(iface);
-    FIXME("(%p)->(%s %p %u %lx %p)\n", This, debugstr_guid(riid),
-            rgszNames, cNames, lcid, rgDispId);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s %p %u %lx %p)\n", iface, debugstr_guid(riid), rgszNames, cNames, lcid, rgDispId);
+    return accessible_get_ids_of_names(riid, rgszNames, cNames, lcid, rgDispId);
 }
 
 static HRESULT WINAPI Client_Invoke(IAccessible *iface, DISPID dispIdMember,
         REFIID riid, LCID lcid, WORD wFlags, DISPPARAMS *pDispParams,
         VARIANT *pVarResult, EXCEPINFO *pExcepInfo, UINT *puArgErr)
 {
-    Client *This = impl_from_Client(iface);
-    FIXME("(%p)->(%lx %s %lx %x %p %p %p %p)\n", This, dispIdMember, debugstr_guid(riid),
+    TRACE("(%p)->(%lx %s %lx %x %p %p %p %p)\n", iface, dispIdMember, debugstr_guid(riid),
             lcid, wFlags, pDispParams, pVarResult, pExcepInfo, puArgErr);
-    return E_NOTIMPL;
+    return accessible_invoke(iface, dispIdMember, riid, lcid, wFlags, pDispParams, pVarResult,
+            pExcepInfo, puArgErr);
 }
 
 static HRESULT WINAPI Client_get_accParent(IAccessible *iface, IDispatch **ppdispParent)
--- a/dlls/oleacc/main.c
+++ b/dlls/oleacc/main.c
@@ -39,6 +39,95 @@ extern HRESULT WINAPI OLEACC_DllRegisterServer(void);
 extern HRESULT WINAPI OLEACC_DllUnregisterServer(void);
 
 static HINSTANCE oleacc_handle = 0;
+static ITypeInfo *accessible_typeinfo;
+static const GUID null_iid;
+
+static HRESULT load_accessible_typeinfo(ITypeInfo **ret)
+{
+    WCHAR path[MAX_PATH];
+    ITypeInfo *info;
+    ITypeLib *lib;
+    HRESULT hr;
+
+    if (accessible_typeinfo)
+    {
+        ITypeInfo_AddRef(accessible_typeinfo);
+        *ret = accessible_typeinfo;
+        return S_OK;
+    }
+
+    if (!GetModuleFileNameW(oleacc_handle, path, ARRAY_SIZE(path)))
+        return E_FAIL;
+    if (FAILED(hr = LoadTypeLibEx(path, REGKIND_NONE, &lib)))
+    {
+        WARN("Failed to load the type library, hr %#lx.\n", hr);
+        return hr;
+    }
+    hr = ITypeLib_GetTypeInfoOfGuid(lib, &IID_IAccessible, &info);
+    ITypeLib_Release(lib);
+    if (FAILED(hr))
+        return hr;
+
+    if (InterlockedCompareExchangePointer((void **)&accessible_typeinfo, info, NULL))
+        ITypeInfo_Release(info);
+    ITypeInfo_AddRef(accessible_typeinfo);
+    *ret = accessible_typeinfo;
+    return S_OK;
+}
+
+HRESULT accessible_get_typeinfo_count(UINT *count)
+{
+    if (!count)
+        return E_POINTER;
+#ifdef SG_MUTANT_ACC_TYPEINFO_COUNT_ZERO
+    *count = 0;
+#else
+    *count = 1;
+#endif
+    return S_OK;
+}
+
+HRESULT accessible_get_typeinfo(UINT index, LCID lcid, ITypeInfo **info)
+{
+    if (!info)
+        return E_POINTER;
+    *info = NULL;
+    if (index)
+        return DISP_E_BADINDEX;
+    return load_accessible_typeinfo(info);
+}
+
+HRESULT accessible_get_ids_of_names(REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *ids)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (!IsEqualIID(riid, &null_iid))
+        return DISP_E_UNKNOWNINTERFACE;
+    if (FAILED(hr = load_accessible_typeinfo(&info)))
+        return hr;
+    hr = ITypeInfo_GetIDsOfNames(info, names, count, ids);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
+HRESULT accessible_invoke(IAccessible *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (!IsEqualIID(riid, &null_iid))
+        return DISP_E_UNKNOWNINTERFACE;
+#ifdef SG_MUTANT_ACC_INVOKE_NOTIMPL
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = load_accessible_typeinfo(&info)))
+        return hr;
+    hr = ITypeInfo_Invoke(info, iface, id, flags, params, result, excep, arg_err);
+    ITypeInfo_Release(info);
+    return hr;
+}
 
 int convert_child_id(VARIANT *v)
 {
@@ -197,9 +286,13 @@ LRESULT WINAPI LresultFromObject( REFIID riid, WPARAM wParam, LPUNKNOWN pAcc )
 
     TRACE("%s %Id %p\n", debugstr_guid(riid), wParam, pAcc);
 
+    /* wParam is the one received with WM_GETOBJECT. The object is always
+     * marshalled for the local machine, so the client side does not need
+     * it to find the result again. */
+#ifdef SG_MUTANT_LRESULT_WPARAM_REJECT
     if(wParam)
-        FIXME("unsupported wParam = %Ix\n", wParam);
-
+        return E_NOTIMPL;
+#endif
     if(!pAcc)
         return E_INVALIDARG;
 
@@ -234,9 +327,11 @@ LRESULT WINAPI LresultFromObject( REFIID riid, WPARAM wParam, LPUNKNOWN pAcc )
     mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
             stat.cbSize.u.HighPart, stat.cbSize.u.LowPart, NULL);
     if(!mapping) {
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        IStream_Seek(stream, seek_zero, STREAM_SEEK_SET, NULL);
         CoReleaseMarshalData(stream);
         IStream_Release(stream);
-        return hr;
+        return FAILED(hr) ? hr : E_OUTOFMEMORY;
     }
 
     view = MapViewOfFile(mapping, FILE_MAP_WRITE, 0, 0, 0);
@@ -492,6 +587,12 @@ BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason,
             oleacc_handle = hinstDLL;
             DisableThreadLibraryCalls(hinstDLL);
             break;
+        case DLL_PROCESS_DETACH:
+            if (lpvReserved) break;
+            if (accessible_typeinfo)
+                ITypeInfo_Release(accessible_typeinfo);
+            accessible_typeinfo = NULL;
+            break;
     }
 
     return OLEACC_DllMain(hinstDLL, fdwReason, lpvReserved);
