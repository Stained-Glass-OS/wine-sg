+static HRESULT WINAPI Part_GetIDsOfNames(IAccessible *iface, REFIID riid,
+        LPOLESTR *rgszNames, UINT cNames, LCID lcid, DISPID *rgDispId)
 {
-    return E_NOTIMPL;
+    TRACE("(%p)->(%s %p %u %lx %p)\n", iface, debugstr_guid(riid), rgszNames, cNames, lcid, rgDispId);
+    return accessible_get_ids_of_names(riid, rgszNames, cNames, lcid, rgDispId);
 }
 
-static HRESULT WINAPI Part_Invoke(IAccessible *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
-        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err)
+static HRESULT WINAPI Part_Invoke(IAccessible *iface, DISPID dispIdMember,
+        REFIID riid, LCID lcid, WORD wFlags, DISPPARAMS *pDispParams,
+        VARIANT *pVarResult, EXCEPINFO *pExcepInfo, UINT *puArgErr)
 {
-    return E_NOTIMPL;
+    TRACE("(%p)->(%lx %s %lx %x %p %p %p %p)\n", iface, dispIdMember, debugstr_guid(riid),
+            lcid, wFlags, pDispParams, pVarResult, pExcepInfo, puArgErr);
+    return accessible_invoke(iface, dispIdMember, riid, lcid, wFlags, pDispParams, pVarResult,
+            pExcepInfo, puArgErr);
 }
 
 static HRESULT WINAPI Part_get_accParent(IAccessible *iface, IDispatch **parent)
--- a/dlls/oleacc/oleacc_private.h
+++ b/dlls/oleacc/oleacc_private.h
@@ -33,3 +33,11 @@ HRESULT create_nonclient_object(HWND, LONG, const IID*, void**);
 HRESULT get_accpropservices_factory(REFIID, void**);
 
 int convert_child_id(VARIANT *v);
+
+/* IDispatch half of the IAccessible objects, driven by the Accessibility
+ * type library embedded in this module. */
