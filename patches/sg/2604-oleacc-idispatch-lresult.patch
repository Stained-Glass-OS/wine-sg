+HRESULT accessible_get_ids_of_names(REFIID riid, LPOLESTR *names, UINT count, LCID lcid, DISPID *ids);
+HRESULT accessible_invoke(IAccessible *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err);
