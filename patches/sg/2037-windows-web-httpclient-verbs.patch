From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.web: HttpClient Get, Delete, Post and Put (2037)

HttpClient.GetAsync, GetAsync with a completion option, DeleteAsync,
PostAsync and PutAsync build an HttpRequestMessage with the verb, the Uri
and, for Post and Put, the content, and send it through the client (its
default headers merged, its filter used) like SendRequestAsync; they were
not implemented. GetBufferAsync, GetInputStreamAsync and GetStringAsync
still are.
---
--- a/dlls/windows.web/http_client.c
+++ b/dlls/windows.web/http_client.c
@@ -86,24 +86,56 @@
     return S_OK;
 }
 
+static HRESULT WINAPI client_SendRequestAsync( IHttpClient *iface, IInspectable *request, IInspectable **op );
+
+/* The verb methods build a request and send it through the client. */
+static HRESULT client_send_verb( IHttpClient *iface, const WCHAR *verb, IInspectable *uri, IInspectable *content,
+        IInspectable **op )
+{
+    IHttpRequestMessage *request;
+    IHttpMethod *method;
+    HRESULT hr;
+
+    *op = NULL;
+    if (!uri) return E_INVALIDARG;
+    if (FAILED( hr = http_method_create( verb, &method ) )) return hr;
+    hr = http_request_create( method, uri, &request );
+    IHttpMethod_Release( method );
+    if (FAILED( hr )) return hr;
+
+#ifdef SG_MUTANT_WEB_VERB_CONTENT
+    content = NULL;
+#endif
+    if (content)
+    {
+        IHttpContent *body;
+        if (SUCCEEDED( hr = IInspectable_QueryInterface( content, &IID_IHttpContent, (void **)&body ) ))
+        {
+            hr = IHttpRequestMessage_put_Content( request, body );
+            IHttpContent_Release( body );
+        }
+    }
+    if (SUCCEEDED( hr )) hr = client_SendRequestAsync( iface, (IInspectable *)request, op );
+    IHttpRequestMessage_Release( request );
+    return hr;
+}
+
 static HRESULT WINAPI client_DeleteAsync( IHttpClient *iface, IInspectable *uri, IInspectable **op )
 {
-    FIXME( "iface %p, uri %p: not yet implemented.\n", iface, uri );
-    *op = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, uri %p, op %p.\n", iface, uri, op );
+    return client_send_verb( iface, L"DELETE", uri, NULL, op );
 }
 static HRESULT WINAPI client_GetAsync( IHttpClient *iface, IInspectable *uri, IInspectable **op )
 {
-    FIXME( "iface %p, uri %p: not yet implemented.\n", iface, uri );
-    *op = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, uri %p, op %p.\n", iface, uri, op );
+    return client_send_verb( iface, L"GET", uri, NULL, op );
 }
 static HRESULT WINAPI client_GetWithOptionAsync( IHttpClient *iface, IInspectable *uri,
         HttpCompletionOption option, IInspectable **op )
 {
-    FIXME( "iface %p, uri %p, option %d: not yet implemented.\n", iface, uri, option );
-    *op = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, uri %p, option %d, op %p.\n", iface, uri, option, op );
+    /* the whole response is read before the operation completes either way */
+    return client_send_verb( iface, L"GET", uri, NULL, op );
 }
 static HRESULT WINAPI client_GetBufferAsync( IHttpClient *iface, IInspectable *uri, IInspectable **op )
 {
@@ -125,15 +157,17 @@
 }
 static HRESULT WINAPI client_PostAsync( IHttpClient *iface, IInspectable *uri, IInspectable *content, IInspectable **op )
 {
-    FIXME( "iface %p, uri %p, content %p: not yet implemented.\n", iface, uri, content );
-    *op = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, uri %p, content %p, op %p.\n", iface, uri, content, op );
+#ifdef SG_MUTANT_WEB_VERB_POST
+    return client_send_verb( iface, L"PUT", uri, content, op );
+#else
+    return client_send_verb( iface, L"POST", uri, content, op );
+#endif
 }
 static HRESULT WINAPI client_PutAsync( IHttpClient *iface, IInspectable *uri, IInspectable *content, IInspectable **op )
 {
-    FIXME( "iface %p, uri %p, content %p: not yet implemented.\n", iface, uri, content );
-    *op = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, uri %p, content %p, op %p.\n", iface, uri, content, op );
+    return client_send_verb( iface, L"PUT", uri, content, op );
 }
