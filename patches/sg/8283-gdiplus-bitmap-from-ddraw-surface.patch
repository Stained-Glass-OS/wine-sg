From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: GdipCreateBitmapFromDirectDrawSurface

GdipCreateBitmapFromDirectDrawSurface makes a bitmap with a copy of a DirectDraw surface's pixels: 32-bit (with or without alpha), 24-bit and 16-bit (565 or 555) RGB surfaces, read through a lock of the surface. It was a spec stub; gdiplusflat.h gains it.
---
--- a/include/gdiplusflat.h
+++ b/include/gdiplusflat.h
@@ -58,6 +58,8 @@
 GpStatus WINGDIPAPI GdipCreateBitmapFromHBITMAP(HBITMAP, HPALETTE, GpBitmap**);
 GpStatus WINGDIPAPI GdipCreateBitmapFromHICON(HICON, GpBitmap**);
 GpStatus WINGDIPAPI GdipCreateBitmapFromResource(HINSTANCE,GDIPCONST WCHAR*,GpBitmap**);
+struct IDirectDrawSurface7;
+GpStatus WINGDIPAPI GdipCreateBitmapFromDirectDrawSurface(struct IDirectDrawSurface7*,GpBitmap**);
 GpStatus WINGDIPAPI GdipCreateBitmapFromScan0(INT,INT,INT,PixelFormat,BYTE*,
     GpBitmap**);
 GpStatus WINGDIPAPI GdipCreateBitmapFromStream(IStream*,GpBitmap**);
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -35,6 +35,7 @@
 #include "wincodec.h"
 #include "gdiplus.h"
 #include "gdiplus_private.h"
+#include "ddraw.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(gdiplus);
@@ -6675,3 +6676,75 @@
 
     return InvalidParameter;
 }
+
+#ifndef SG_MUTANT_NO_DDRAW_SURFACE_BITMAP
+/*****************************************************************************
+ * GdipCreateBitmapFromDirectDrawSurface [GDIPLUS.@]
+ *
+ * (wine-sg 8283) A bitmap with a copy of a DirectDraw surface's pixels: 32-bit (with or without alpha),
+ * 24-bit and 16-bit (565 or 555) RGB surfaces, read through a lock of the whole surface.
+ */
+GpStatus WINGDIPAPI GdipCreateBitmapFromDirectDrawSurface(IDirectDrawSurface7 *surface, GpBitmap **bitmap)
+{
+    DDSURFACEDESC2 desc;
+    PixelFormat format;
+    GpStatus status;
+    BitmapData data;
+    GpRect rect;
+    HRESULT hr;
+    UINT y, row;
+
+    TRACE("(%p, %p)\n", surface, bitmap);
+
+    if (!surface || !bitmap) return InvalidParameter;
+    *bitmap = NULL;
+    memset(&desc, 0, sizeof(desc));
+    desc.dwSize = sizeof(desc);
+    if (FAILED(hr = IDirectDrawSurface7_Lock(surface, NULL, &desc, DDLOCK_WAIT | DDLOCK_READONLY, NULL)))
+    {
+        WARN("lock failed %#lx\n", hr);
+        return GenericError;
+    }
+    if (!(desc.ddpfPixelFormat.dwFlags & DDPF_RGB))
+        format = 0;
+    else switch (desc.ddpfPixelFormat.dwRGBBitCount)
+    {
+    case 32: format = (desc.ddpfPixelFormat.dwFlags & DDPF_ALPHAPIXELS) ? PixelFormat32bppARGB : PixelFormat32bppRGB; break;
+    case 24: format = PixelFormat24bppRGB; break;
+    case 16: format = desc.ddpfPixelFormat.dwGBitMask == 0x07e0 ? PixelFormat16bppRGB565 : PixelFormat16bppRGB555; break;
+    default: format = 0; break;
+    }
+    if (!format)
+    {
+        IDirectDrawSurface7_Unlock(surface, NULL);
+        FIXME("surface format flags %#lx, %lu bits\n", desc.ddpfPixelFormat.dwFlags, desc.ddpfPixelFormat.dwRGBBitCount);
+        return NotImplemented;
+    }
+    status = GdipCreateBitmapFromScan0(desc.dwWidth, desc.dwHeight, 0, format, NULL, bitmap);
+    if (status == Ok)
+    {
+        rect.X = rect.Y = 0;
+        rect.Width = desc.dwWidth;
+        rect.Height = desc.dwHeight;
+        if ((status = GdipBitmapLockBits(*bitmap, &rect, ImageLockModeWrite, format, &data)) == Ok)
+        {
+            row = desc.dwWidth * (desc.ddpfPixelFormat.dwRGBBitCount / 8);
+            for (y = 0; y < desc.dwHeight; y++)
+                memcpy((BYTE *)data.Scan0 + y * data.Stride, (const BYTE *)desc.lpSurface + y * desc.lPitch, row);
+            GdipBitmapUnlockBits(*bitmap, &data);
+        }
+        if (status != Ok)
+        {
+            GdipDisposeImage(&(*bitmap)->image);
+            *bitmap = NULL;
+        }
+    }
+    IDirectDrawSurface7_Unlock(surface, NULL);
+    return status;
+}
+#else
+GpStatus WINGDIPAPI GdipCreateBitmapFromDirectDrawSurface(IDirectDrawSurface7 *surface, GpBitmap **bitmap)
+{
+    return NotImplemented;
+}
+#endif
--- a/dlls/gdiplus/gdiplus.spec
+++ b/dlls/gdiplus/gdiplus.spec
@@ -62,7 +62,7 @@
 62 stdcall GdipCombineRegionRegion(ptr ptr long)
 63 stdcall GdipComment(ptr long ptr)
 64 stdcall GdipCreateAdjustableArrowCap(float float long ptr)
-65 stub GdipCreateBitmapFromDirectDrawSurface
+65 stdcall GdipCreateBitmapFromDirectDrawSurface(ptr ptr)
 66 stdcall GdipCreateBitmapFromFile(wstr ptr)
 67 stdcall GdipCreateBitmapFromFileICM(wstr ptr)
 68 stdcall GdipCreateBitmapFromGdiDib(ptr ptr ptr)
