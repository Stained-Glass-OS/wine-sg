+static HRESULT STDMETHODCALLTYPE matrix3d_SetMatrix(IDCompositionMatrixTransform3D *iface, const D3DMATRIX *m)
+{
+    struct dc_transform *t = unsafe_transform((IUnknown *)iface);
+    unsigned int i;
+
+    TRACE("iface %p, matrix %p.\n", iface, m);
+
+    if (!m)
+        return E_INVALIDARG;
+    for (i = 0; i < 16; ++i)
+        if (!dc_finite(((const float *)m->m)[i]))
+            return E_INVALIDARG;
+    for (i = 0; i < 16; ++i)
+        value_set(&t->v[i], ((const float *)m->m)[i]);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE matrix3d_SetMatrixElement(IDCompositionMatrixTransform3D *iface, int row,
+        int column, float value)
+{
+    struct dc_transform *t = unsafe_transform((IUnknown *)iface);
+
+    TRACE("iface %p, row %d, column %d, value %.8e.\n", iface, row, column, value);
+
+#ifndef SG_MUTANT_DC_MATRIX3D_BOUNDS
+    if (row < 0 || row > 3 || column < 0 || column > 3)
+        return E_INVALIDARG;
+#endif
+    return value_set(&t->v[row * 4 + column], value);
+}
+
+static HRESULT STDMETHODCALLTYPE matrix3d_SetMatrixElementAnimation(IDCompositionMatrixTransform3D *iface, int row,
+        int column, IDCompositionAnimation *animation)
+{
+    struct dc_transform *t = unsafe_transform((IUnknown *)iface);
+
+    TRACE("iface %p, row %d, column %d, animation %p.\n", iface, row, column, animation);
+
+    if (row < 0 || row > 3 || column < 0 || column > 3)
+        return E_INVALIDARG;
+    return value_set_animation(&t->v[row * 4 + column], animation);
+}
