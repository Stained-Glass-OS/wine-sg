--- a/dlls/browseui/Makefile.in
+++ b/dlls/browseui/Makefile.in
@@ -1,5 +1,6 @@
 MODULE    = browseui.dll
 IMPORTS   = uuid ole32 comctl32 user32 advapi32
+DELAYIMPORTS = shell32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/browseui/aclsource.c b/dlls/browseui/aclsource.c
index 72bf323..e300953 100644
--- a/dlls/browseui/aclsource.c
+++ b/dlls/browseui/aclsource.c
@@ -43,8 +43,88 @@ typedef struct tagACLShellSource {
     IACList2 IACList2_iface;
     LONG refCount;
     DWORD dwOptions;
+    WCHAR **items;      /* the names produced for the last Expand */
+    ULONG count, pos;
 } ACLShellSource;
 
+/* IACList2 option flags */
+#define ACLO_CURRENTDIR  0x01
+#define ACLO_MYCOMPUTER  0x02
+#define ACLO_DESKTOP     0x04
+#define ACLO_FAVORITES   0x08
+#define ACLO_FILESYSONLY 0x10
+#define ACLO_FILESYSDIRS 0x20
+
+static void acl_free_items(ACLShellSource *This)
+{
+    ULONG i;
+    for (i = 0; i < This->count; i++) free(This->items[i]);
+    free(This->items);
+    This->items = NULL;
+    This->count = This->pos = 0;
+}
+
+static BOOL acl_add(ACLShellSource *This, ULONG *cap, const WCHAR *dir, const WCHAR *name, BOOL isdir)
+{
+    size_t dl = wcslen(dir), nl = wcslen(name);
+    WCHAR *str;
+
+    if (This->count == *cap)
+    {
+        WCHAR **n = realloc(This->items, (*cap ? *cap * 2 : 16) * sizeof(*n));
+        if (!n) return FALSE;
+        This->items = n;
+        *cap = *cap ? *cap * 2 : 16;
+    }
+    if (!(str = malloc((dl + nl + 2) * sizeof(WCHAR)))) return FALSE;
+    memcpy(str, dir, dl * sizeof(WCHAR));
+    memcpy(str + dl, name, (nl + 1) * sizeof(WCHAR));
+    if (isdir) wcscat(str, L"\\");
+    This->items[This->count++] = str;
+    return TRUE;
+}
+
+/* list the entries of one directory as "dir" + name; dir ends in a separator
+ * or is empty (then the names are relative to the current directory) */
+static void acl_list_dir(ACLShellSource *This, ULONG *cap, const WCHAR *dir, const WCHAR *prefix)
+{
+    WCHAR pattern[MAX_PATH + 4];
+    WIN32_FIND_DATAW fd;
+    HANDLE h;
+    size_t pl = wcslen(prefix);
+
+    if (wcslen(dir) + 2 > MAX_PATH) return;
+    wcscpy(pattern, dir);
+    wcscat(pattern, L"*");
+    h = FindFirstFileW(pattern, &fd);
+    if (h == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        BOOL isdir = (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L"..")) continue;
+#ifndef SG_MUTANT_ACL_DIRSONLY
+        if ((This->dwOptions & ACLO_FILESYSDIRS) && !isdir) continue;
+#endif
+#ifndef SG_MUTANT_ACL_PREFIX
+        if (pl && _wcsnicmp(fd.cFileName, prefix, pl)) continue;
+#endif
+        if (!acl_add(This, cap, dir, fd.cFileName, isdir)) break;
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+}
+
+static void acl_list_known(ACLShellSource *This, ULONG *cap, int csidl, const WCHAR *prefix)
+{
+    WCHAR dir[MAX_PATH + 2];
+    size_t l;
+
+    if (FAILED(SHGetFolderPathW(NULL, csidl, NULL, SHGFP_TYPE_CURRENT, dir))) return;
+    l = wcslen(dir);
+    if (l && dir[l - 1] != '\\') { dir[l++] = '\\'; dir[l] = 0; }
+    acl_list_dir(This, cap, dir, prefix);
+}
+
 static inline ACLShellSource *impl_from_IACList2(IACList2 *iface)
 {
     return CONTAINING_RECORD(iface, ACLShellSource, IACList2_iface);
@@ -98,7 +178,10 @@ static ULONG WINAPI ACLShellSource_Release(IEnumString *iface)
     TRACE("(%p)->(%lu)\n", This, ref);
 
     if (ref == 0)
+    {
+        acl_free_items(This);
         free(This);
+    }
     return ref;
 }
 
@@ -106,29 +189,88 @@ static HRESULT WINAPI ACLShellSource_Next(IEnumString *iface, ULONG celt, LPOLES
     ULONG *fetched)
 {
     ACLShellSource *This = impl_from_IEnumString(iface);
-    FIXME("(%p)->(%lu %p %p): stub\n", This, celt, rgelt, fetched);
-    return E_NOTIMPL;
+    ULONG n = 0;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, celt, rgelt, fetched);
+
+    if (!rgelt || (!fetched && celt != 1)) return E_POINTER;
+
+    while (n < celt && This->pos < This->count)
+    {
+        size_t len = wcslen(This->items[This->pos]) + 1;
+        WCHAR *copy = CoTaskMemAlloc(len * sizeof(WCHAR));
+        if (!copy)
+        {
+            while (n) CoTaskMemFree(rgelt[--n]);
+            if (fetched) *fetched = 0;
+            return E_OUTOFMEMORY;
+        }
+        memcpy(copy, This->items[This->pos], len * sizeof(WCHAR));
+        rgelt[n++] = copy;
+#ifndef SG_MUTANT_ACL_NOADVANCE
+        This->pos++;
+#endif
+    }
+    if (fetched) *fetched = n;
+    return n == celt ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI ACLShellSource_Skip(IEnumString *iface, ULONG celt)
 {
     ACLShellSource *This = impl_from_IEnumString(iface);
-    FIXME("(%p)->(%lu): stub\n", This, celt);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%lu)\n", This, celt);
+
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
 }
 
 static HRESULT WINAPI ACLShellSource_Reset(IEnumString *iface)
 {
     ACLShellSource *This = impl_from_IEnumString(iface);
-    FIXME("(%p): stub\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)\n", This);
+#ifndef SG_MUTANT_ACL_RESET
+    This->pos = 0;
+#endif
+    return S_OK;
 }
 
 static HRESULT WINAPI ACLShellSource_Clone(IEnumString *iface, IEnumString **ppenum)
 {
     ACLShellSource *This = impl_from_IEnumString(iface);
-    FIXME("(%p)->(%p): stub\n", This, ppenum);
-    return E_NOTIMPL;
+    ACLShellSource *copy;
+    IUnknown *unk;
+    ULONG i;
+
+    TRACE("(%p)->(%p)\n", This, ppenum);
+
+    if (!ppenum) return E_POINTER;
+    *ppenum = NULL;
+    if (FAILED(ACLShellSource_Constructor(NULL, &unk))) return E_OUTOFMEMORY;
+    copy = impl_from_IEnumString((IEnumString *)unk);
+    copy->dwOptions = This->dwOptions;
+    if (This->count && !(copy->items = calloc(This->count, sizeof(*copy->items))))
+    {
+        IUnknown_Release(unk);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < This->count; i++)
+    {
+        copy->items[i] = wcsdup(This->items[i]);
+        if (!copy->items[i]) { copy->count = i; IUnknown_Release(unk); return E_OUTOFMEMORY; }
+    }
+    copy->count = This->count;
+#ifndef SG_MUTANT_ACL_CLONEPOS
+    copy->pos = This->pos;
+#endif
+    *ppenum = (IEnumString *)unk;
+    return S_OK;
 }
 
 static const IEnumStringVtbl ACLShellSourceVtbl = {
@@ -159,11 +301,55 @@ static ULONG WINAPI ACList_Release(IACList2 *iface)
     return IEnumString_Release(&This->IEnumString_iface);
 }
 
+/* Expand("C:\\dir\\pre") makes the source produce the entries of C:\\dir whose
+ * names start with "pre", as complete paths.  Expand("") lists the places
+ * the options ask for. */
 static HRESULT WINAPI ACList_Expand(IACList2 *iface, LPCWSTR wstr)
 {
     ACLShellSource *This = impl_from_IACList2(iface);
-    FIXME("STUB:(%p) %s\n",This,debugstr_w(wstr));
-    return E_NOTIMPL;
+    const WCHAR *sep, *p;
+    WCHAR dir[MAX_PATH + 2];
+    ULONG cap = 0;
+    size_t dl;
+
+    TRACE("(%p)->(%s)\n", This, debugstr_w(wstr));
+
+    if (!wstr) return E_INVALIDARG;
+    acl_free_items(This);
+
+    sep = NULL;
+    for (p = wstr; *p; p++) if (*p == '\\' || *p == '/') sep = p;
+    dl = sep ? sep - wstr + 1 : 0;
+    if (dl >= MAX_PATH) return S_OK;
+    memcpy(dir, wstr, dl * sizeof(WCHAR));
+    dir[dl] = 0;
+
+    if (dl)
+        acl_list_dir(This, &cap, dir, wstr + dl);
+    else
+    {
+        const WCHAR *prefix = wstr;
+#ifndef SG_MUTANT_ACL_CURDIR
+        if (This->dwOptions & ACLO_CURRENTDIR) acl_list_dir(This, &cap, L"", prefix);
+#endif
+        if (This->dwOptions & ACLO_DESKTOP) acl_list_known(This, &cap, CSIDL_DESKTOPDIRECTORY, prefix);
+        if (This->dwOptions & ACLO_FAVORITES) acl_list_known(This, &cap, CSIDL_FAVORITES, prefix);
+#ifndef SG_MUTANT_ACL_DRIVES
+        if (This->dwOptions & ACLO_MYCOMPUTER)
+        {
+            DWORD drives = GetLogicalDrives();
+            int i;
+            for (i = 0; i < 26; i++)
+            {
+                WCHAR root[3] = { 'A' + i, ':', 0 };
+                if (!(drives & (1 << i))) continue;
+                if (*prefix && _wcsnicmp(root, prefix, wcslen(prefix))) continue;
+                acl_add(This, &cap, L"", root, TRUE);
+            }
+        }
+#endif
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI ACList_GetOptions(IACList2 *iface, DWORD *pdwFlag)
diff --git a/dlls/browseui/compcatcachedaemon.c b/dlls/browseui/compcatcachedaemon.c
index 6ea9836..902681a 100644
--- a/dlls/browseui/compcatcachedaemon.c
+++ b/dlls/browseui/compcatcachedaemon.c
@@ -33,6 +33,7 @@
 
 #include "shlguid.h"
 #include "shlobj.h"
+#include "comcat.h"
 
 #include "browseui.h"
 #include "resids.h"
@@ -43,8 +44,18 @@ typedef struct tagCCCD {
     IRunnableTask IRunnableTask_iface;
     LONG refCount;
     CRITICAL_SECTION cs;
+    ULONG state;
+    BOOL kill;
+    HANDLE resumed;     /* signalled while the task is not suspended */
 } CompCatCacheDaemon;
 
+/* IRunnableTask::IsRunning results */
+#define IRTIR_TASK_NOT_RUNNING 0
+#define IRTIR_TASK_RUNNING     1
+#define IRTIR_TASK_SUSPENDED   2
+#define IRTIR_TASK_PENDING     3
+#define IRTIR_TASK_FINISHED    4
+
 static inline CompCatCacheDaemon *impl_from_IRunnableTask(IRunnableTask *iface)
 {
     return CONTAINING_RECORD(iface, CompCatCacheDaemon, IRunnableTask_iface);
@@ -55,6 +66,7 @@ static void CompCatCacheDaemon_Destructor(CompCatCacheDaemon *This)
     TRACE("destroying %p\n", This);
     This->cs.DebugInfo->Spare[0] = 0;
     DeleteCriticalSection(&This->cs);
+    CloseHandle(This->resumed);
     free(This);
     InterlockedDecrement(&BROWSEUI_refCount);
 }
@@ -96,34 +108,167 @@ static ULONG WINAPI CompCatCacheDaemon_Release(IRunnableTask *iface)
     return ret;
 }
 
+/* The work of the task: walk the registered component categories and the
+ * classes of each one, which is what fills the category cache.  The walk is
+ * the unit of suspension and cancellation. */
+static BOOL daemon_step(CompCatCacheDaemon *This)
+{
+    BOOL killed;
+
+#ifndef SG_MUTANT_CCD_SUSPEND
+    WaitForSingleObject(This->resumed, INFINITE);
+#endif
+    EnterCriticalSection(&This->cs);
+    killed = This->kill;
+    LeaveCriticalSection(&This->cs);
+    return !killed;
+}
+
 static HRESULT WINAPI CompCatCacheDaemon_Run(IRunnableTask *iface)
 {
-    FIXME("stub\n");
-    return S_OK;
+    CompCatCacheDaemon *This = impl_from_IRunnableTask(iface);
+    ICatInformation *info;
+    IEnumCATEGORYINFO *cats;
+    CATEGORYINFO ci;
+    BOOL ok = TRUE;
+    HRESULT hr, init;
+
+    TRACE("(%p)\n", This);
+
+    EnterCriticalSection(&This->cs);
+#ifndef SG_MUTANT_CCD_RUNTWICE
+    if (This->state == IRTIR_TASK_RUNNING || This->state == IRTIR_TASK_SUSPENDED)
+    {
+        LeaveCriticalSection(&This->cs);
+        return E_PENDING;
+    }
+#endif
+    This->state = IRTIR_TASK_RUNNING;
+    This->kill = FALSE;
+    LeaveCriticalSection(&This->cs);
+
+    /* a worker thread that runs the task may not have initialized COM */
+    init = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    hr = CoCreateInstance(&CLSID_StdComponentCategoriesMgr, NULL, CLSCTX_INPROC_SERVER,
+                          &IID_ICatInformation, (void **)&info);
+    if (SUCCEEDED(hr))
+    {
+        hr = ICatInformation_EnumCategories(info, GetUserDefaultLCID(), &cats);
+        if (SUCCEEDED(hr))
+        {
+            ULONG got;
+            while (ok && (hr = IEnumCATEGORYINFO_Next(cats, 1, &ci, &got)) == S_OK && got)
+            {
+                IEnumGUID *clsids;
+                CLSID clsid;
+
+                ok = daemon_step(This);
+                if (!ok) break;
+                if (SUCCEEDED(ICatInformation_EnumClassesOfCategories(info, 1, &ci.catid, 0, NULL, &clsids)))
+                {
+                    while (IEnumGUID_Next(clsids, 1, &clsid, &got) == S_OK && got)
+                    {
+                        ok = daemon_step(This);
+                        if (!ok) break;
+                    }
+                    IEnumGUID_Release(clsids);
+                }
+            }
+            IEnumCATEGORYINFO_Release(cats);
+        }
+        ICatInformation_Release(info);
+    }
+    else ok = daemon_step(This);
+    if (SUCCEEDED(init)) CoUninitialize();
+
+    EnterCriticalSection(&This->cs);
+#ifdef SG_MUTANT_CCD_FINISH
+    This->state = ok ? IRTIR_TASK_NOT_RUNNING : IRTIR_TASK_NOT_RUNNING;
+#else
+    This->state = ok ? IRTIR_TASK_FINISHED : IRTIR_TASK_NOT_RUNNING;
+#endif
+    LeaveCriticalSection(&This->cs);
+    SetEvent(This->resumed);
+    return ok ? S_OK : E_ABORT;
 }
 
 static HRESULT WINAPI CompCatCacheDaemon_Kill(IRunnableTask *iface, BOOL fWait)
 {
-    FIXME("stub\n");
+    CompCatCacheDaemon *This = impl_from_IRunnableTask(iface);
+    BOOL running;
+
+    TRACE("(%p, %d)\n", This, fWait);
+
+    EnterCriticalSection(&This->cs);
+    running = This->state == IRTIR_TASK_RUNNING || This->state == IRTIR_TASK_SUSPENDED;
+    if (running) This->kill = TRUE;
+    LeaveCriticalSection(&This->cs);
+    if (!running) return S_OK;
+
+#ifndef SG_MUTANT_CCD_KILLWAKE
+    SetEvent(This->resumed);    /* a suspended task must see the request */
+#endif
+    if (fWait)
+    {
+        for (;;)
+        {
+            ULONG st;
+            EnterCriticalSection(&This->cs);
+            st = This->state;
+            LeaveCriticalSection(&This->cs);
+            if (st != IRTIR_TASK_RUNNING && st != IRTIR_TASK_SUSPENDED) break;
+            Sleep(1);
+        }
+    }
     return S_OK;
 }
 
 static HRESULT WINAPI CompCatCacheDaemon_Suspend(IRunnableTask *iface)
 {
-    FIXME("stub\n");
-    return S_OK;
+    CompCatCacheDaemon *This = impl_from_IRunnableTask(iface);
+    HRESULT hr = E_FAIL;
+
+    TRACE("(%p)\n", This);
+
+    EnterCriticalSection(&This->cs);
+    if (This->state == IRTIR_TASK_RUNNING)
+    {
+        This->state = IRTIR_TASK_SUSPENDED;
+        ResetEvent(This->resumed);
+        hr = S_OK;
+    }
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
 static HRESULT WINAPI CompCatCacheDaemon_Resume(IRunnableTask *iface)
 {
-    FIXME("stub\n");
-    return S_OK;
+    CompCatCacheDaemon *This = impl_from_IRunnableTask(iface);
+    HRESULT hr = E_FAIL;
+
+    TRACE("(%p)\n", This);
+
+    EnterCriticalSection(&This->cs);
+    if (This->state == IRTIR_TASK_SUSPENDED)
+    {
+        This->state = IRTIR_TASK_RUNNING;
+        SetEvent(This->resumed);
+        hr = S_OK;
+    }
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
 static ULONG WINAPI CompCatCacheDaemon_IsRunning(IRunnableTask *iface)
 {
-    FIXME("stub\n");
-    return 0;
+    CompCatCacheDaemon *This = impl_from_IRunnableTask(iface);
+    ULONG st;
+
+    EnterCriticalSection(&This->cs);
+    st = This->state;
+    LeaveCriticalSection(&This->cs);
+    TRACE("(%p) -> %lu\n", This, st);
+    return st;
 }
 
 static const IRunnableTaskVtbl CompCatCacheDaemonVtbl =
@@ -149,6 +294,7 @@ HRESULT CompCatCacheDaemon_Constructor(IUnknown *pUnkOuter, IUnknown **ppOut)
 
     This->IRunnableTask_iface.lpVtbl = &CompCatCacheDaemonVtbl;
     This->refCount = 1;
+    This->resumed = CreateEventW(NULL, TRUE, TRUE, NULL);
     InitializeCriticalSectionEx(&This->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     This->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": CompCatCacheDaemon.cs");
 
diff --git a/dlls/browseui/progressdlg.c b/dlls/browseui/progressdlg.c
index da73dbb..64fde60 100644
--- a/dlls/browseui/progressdlg.c
+++ b/dlls/browseui/progressdlg.c
@@ -70,6 +70,7 @@ typedef struct tagProgressDialog {
     ULONGLONG ullTotal;
     HWND hwndDisabledParent;    /* For modal dialog: the parent that need to be re-enabled when the dialog ends */
     ULONGLONG startTime;
+    ULONGLONG pauseTime;    /* nonzero while the time estimate is paused */
     LPWSTR remainingMsg[2];
     LPWSTR timeMsg[3];
 } ProgressDialog;
@@ -369,6 +370,7 @@ static HRESULT WINAPI ProgressDialog_StartProgressDialog(IProgressDialog *iface,
         load_time_strings(This);
 
     This->startTime = GetTickCount64();
+    This->pauseTime = 0;
     LeaveCriticalSection(&This->cs);
 
     return S_OK;
@@ -437,7 +439,11 @@ static void update_time_remaining(ProgressDialog *This, ULONGLONG ullCompleted,
     if (!This->startTime || !ullCompleted || !ullTotal)
         return;
 
+#ifdef SG_MUTANT_PD_FREEZE
     elapsed = GetTickCount64() - This->startTime;
+#else
+    elapsed = (This->pauseTime ? This->pauseTime : GetTickCount64()) - This->startTime;
+#endif
     remaining = (elapsed * ullTotal / ullCompleted - elapsed) / 1000;
 
     for (i = 0; remaining >= 60 && i < 2; i++)
@@ -541,11 +547,36 @@ static HRESULT WINAPI ProgressDialog_Timer(IProgressDialog *iface, DWORD dwTimer
 {
     ProgressDialog *This = impl_from_IProgressDialog(iface);
 
-    FIXME("(%p, %ld, %p) - stub\n", This, dwTimerAction, reserved);
+    TRACE("(%p, %ld, %p)\n", This, dwTimerAction, reserved);
 
     if (reserved)
         FIXME("Reserved field not NULL but %p\n", reserved);
 
+    EnterCriticalSection(&This->cs);
+    switch (dwTimerAction)
+    {
+    case PDTIMER_RESET:
+        This->startTime = GetTickCount64();
+        This->pauseTime = 0;
+        break;
+    case PDTIMER_PAUSE:
+        if (!This->pauseTime) This->pauseTime = GetTickCount64();
+        break;
+    case PDTIMER_RESUME:
+        /* the time spent paused does not count towards the estimate */
+        if (This->pauseTime)
+        {
+#ifndef SG_MUTANT_PD_RESUME
+            This->startTime += GetTickCount64() - This->pauseTime;
+#endif
+            This->pauseTime = 0;
+        }
+        break;
+    default:
+        break;
+    }
+    LeaveCriticalSection(&This->cs);
+
     return S_OK;
 }
 
