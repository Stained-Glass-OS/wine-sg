 }
+
+
+#ifndef SG_MUTANT_NO_LOGCONF
+/* (wine-sg 8246) Logical configurations: the resource lists (I/O ports, memory, IRQs, DMA) of a device.
+ * Devices here have none -- no driver assigns hardware resources -- so a device has no configuration of
+ * any kind and no configuration handle can exist; the device and flags are still checked. */
+CONFIGRET WINAPI CM_Get_First_Log_Conf_Ex(LOG_CONF *conf, DEVINST devnode, ULONG flags, HMACHINE machine)
+{
+    WCHAR id[MAX_DEVICE_ID_LEN];
+    CONFIGRET cr;
+
+    TRACE("%p %lu %#lx %p\n", conf, devnode, flags, machine);
+
+    if (conf) *conf = 0;
+    if (flags & ~LOG_CONF_BITS) return CR_INVALID_FLAG;
+    if ((cr = devnode_id(devnode, id))) return cr;
+    return CR_NO_MORE_LOG_CONF;
+}
+
+CONFIGRET WINAPI CM_Get_First_Log_Conf(LOG_CONF *conf, DEVINST devnode, ULONG flags)
+{
+    return CM_Get_First_Log_Conf_Ex(conf, devnode, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_Next_Log_Conf_Ex(LOG_CONF *next, LOG_CONF conf, ULONG flags, HMACHINE machine)
+{
+    TRACE("%p %#Ix %#lx %p\n", next, conf, flags, machine);
+
+    if (next) *next = 0;
+    if (flags) return CR_INVALID_FLAG;
+    return CR_INVALID_LOG_CONF;
+}
+
+CONFIGRET WINAPI CM_Get_Next_Log_Conf(LOG_CONF *next, LOG_CONF conf, ULONG flags)
+{
+    return CM_Get_Next_Log_Conf_Ex(next, conf, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Free_Log_Conf_Handle(LOG_CONF conf)
+{
+    TRACE("%#Ix\n", conf);
+    return CR_INVALID_LOG_CONF;
+}
+
+CONFIGRET WINAPI CM_Get_Log_Conf_Priority_Ex(LOG_CONF conf, PRIORITY *priority, ULONG flags, HMACHINE machine)
+{
+    TRACE("%#Ix %p %#lx %p\n", conf, priority, flags, machine);
+
+    if (!priority) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    return CR_INVALID_LOG_CONF;
+}
+
+CONFIGRET WINAPI CM_Get_Log_Conf_Priority(LOG_CONF conf, PRIORITY *priority, ULONG flags)
+{
+    return CM_Get_Log_Conf_Priority_Ex(conf, priority, flags, NULL);
+}
+
+/* Hardware profiles: there is one, the current configuration IDConfigDB names (0001 unless set), with the
+ * friendly name stored for it ("Profile 1" unless set); it is not a docking profile. */
+static ULONG current_hw_profile(void)
+{
+    DWORD value = 1, size = sizeof(value);
+
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\IDConfigDB", L"CurrentConfig",
+                     RRF_RT_REG_DWORD, NULL, &value, &size) || !value)
+        value = 1;
+    return value;
+}
+
+CONFIGRET WINAPI CM_Get_Hardware_Profile_Info_ExW(ULONG index, HWPROFILEINFO_W *info, ULONG flags, HMACHINE machine)
+{
+    WCHAR path[128];
+    DWORD size;
+
+    TRACE("%#lx %p %#lx %p\n", index, info, flags, machine);
+
+    if (!info) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if (index && index != ~0u) return CR_NO_MORE_HW_PROFILES;
+    memset(info, 0, sizeof(*info));
+    info->HWPI_ulHWProfile = current_hw_profile();
+    swprintf(path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\IDConfigDB\\Hardware Profiles\\%04lu",
+             info->HWPI_ulHWProfile);
+    size = sizeof(info->HWPI_szFriendlyName);
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, path, L"FriendlyName", RRF_RT_REG_SZ, NULL, info->HWPI_szFriendlyName, &size))
+        swprintf(info->HWPI_szFriendlyName, ARRAY_SIZE(info->HWPI_szFriendlyName), L"Profile %lu",
+                 info->HWPI_ulHWProfile);
+    info->HWPI_dwFlags = CM_HWPI_NOT_DOCKABLE;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_Hardware_Profile_InfoW(ULONG index, HWPROFILEINFO_W *info, ULONG flags)
+{
+    return CM_Get_Hardware_Profile_Info_ExW(index, info, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_Hardware_Profile_Info_ExA(ULONG index, HWPROFILEINFO_A *info, ULONG flags, HMACHINE machine)
+{
+    HWPROFILEINFO_W infoW;
+    CONFIGRET cr;
+
+    if (!info) return CR_INVALID_POINTER;
+    if ((cr = CM_Get_Hardware_Profile_Info_ExW(index, &infoW, flags, machine))) return cr;
+    info->HWPI_ulHWProfile = infoW.HWPI_ulHWProfile;
+    WideCharToMultiByte(CP_ACP, 0, infoW.HWPI_szFriendlyName, -1, info->HWPI_szFriendlyName,
+                        sizeof(info->HWPI_szFriendlyName), NULL, NULL);
+    info->HWPI_dwFlags = infoW.HWPI_dwFlags;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_Hardware_Profile_InfoA(ULONG index, HWPROFILEINFO_A *info, ULONG flags)
+{
+    return CM_Get_Hardware_Profile_Info_ExA(index, info, flags, NULL);
+}
+
+/* a device's configuration flags in a hardware profile (CSCONFIGFLAG_*: disabled, do not create, do not
+ * start), kept under the profile's copy of the Enum tree; none set unless stored there */
+CONFIGRET WINAPI CM_Get_HW_Prof_Flags_ExW(DEVINSTID_W id, ULONG profile, ULONG *value, ULONG flags, HMACHINE machine)
+{
+    WCHAR path[MAX_DEVICE_ID_LEN + 128];
+    DWORD size;
+    HKEY key;
+
+    TRACE("%s %lu %p %#lx %p\n", debugstr_w(id), profile, value, flags, machine);
+
+    if (!value) return CR_INVALID_POINTER;
+    *value = 0;
+    if (flags) return CR_INVALID_FLAG;
+    if (!profile) profile = current_hw_profile();
+    else if (profile != current_hw_profile()) return CR_NO_SUCH_VALUE;
+    if (!id || !*id) return CR_SUCCESS; /* the root device */
+    if (wcslen(id) >= MAX_DEVICE_ID_LEN) return CR_INVALID_DEVICE_ID;
+    if (!(key = open_enum_subkey(id, NULL))) return CR_NO_SUCH_DEVINST;
+    RegCloseKey(key);
+    swprintf(path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Hardware Profiles\\%04lu\\System\\CurrentControlSet\\Enum\\%s",
+             profile, id);
+    size = sizeof(*value);
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, path, L"CSConfigFlags", RRF_RT_REG_DWORD, NULL, value, &size)) *value = 0;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_HW_Prof_FlagsW(DEVINSTID_W id, ULONG profile, ULONG *value, ULONG flags)
+{
+    return CM_Get_HW_Prof_Flags_ExW(id, profile, value, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_HW_Prof_Flags_ExA(DEVINSTID_A id, ULONG profile, ULONG *value, ULONG flags, HMACHINE machine)
+{
+    WCHAR idW[MAX_DEVICE_ID_LEN];
+
+    if (id && !MultiByteToWideChar(CP_ACP, 0, id, -1, idW, ARRAY_SIZE(idW))) return CR_INVALID_DEVICE_ID;
+    return CM_Get_HW_Prof_Flags_ExW(id ? idW : NULL, profile, value, flags, machine);
+}
+
+CONFIGRET WINAPI CM_Get_HW_Prof_FlagsA(DEVINSTID_A id, ULONG profile, ULONG *value, ULONG flags)
+{
+    return CM_Get_HW_Prof_Flags_ExA(id, profile, value, flags, NULL);
+}
+#else
+CONFIGRET WINAPI CM_Get_First_Log_Conf_Ex(LOG_CONF *conf, DEVINST devnode, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_First_Log_Conf(LOG_CONF *conf, DEVINST devnode, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Next_Log_Conf_Ex(LOG_CONF *next, LOG_CONF conf, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Next_Log_Conf(LOG_CONF *next, LOG_CONF conf, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Free_Log_Conf_Handle(LOG_CONF conf) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Log_Conf_Priority_Ex(LOG_CONF conf, PRIORITY *priority, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Log_Conf_Priority(LOG_CONF conf, PRIORITY *priority, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Hardware_Profile_Info_ExW(ULONG index, HWPROFILEINFO_W *info, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Hardware_Profile_InfoW(ULONG index, HWPROFILEINFO_W *info, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Hardware_Profile_Info_ExA(ULONG index, HWPROFILEINFO_A *info, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_Hardware_Profile_InfoA(ULONG index, HWPROFILEINFO_A *info, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_HW_Prof_Flags_ExW(DEVINSTID_W id, ULONG profile, ULONG *value, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_HW_Prof_FlagsW(DEVINSTID_W id, ULONG profile, ULONG *value, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_HW_Prof_Flags_ExA(DEVINSTID_A id, ULONG profile, ULONG *value, ULONG flags, HMACHINE machine) { return CR_CALL_NOT_IMPLEMENTED; }
+CONFIGRET WINAPI CM_Get_HW_Prof_FlagsA(DEVINSTID_A id, ULONG profile, ULONG *value, ULONG flags) { return CR_CALL_NOT_IMPLEMENTED; }
+#endif
