From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: pasted into its own folder, a copy named "name - Copy"

Copying a file or a folder into the folder it is in -- File Explorer's
Ctrl+C then Ctrl+V, or a Ctrl-drag within the folder -- asked "Replace,
Skip or Keep both" about the item itself, and "Keep both" named the copy
"a (2).txt" (regression walk, 2026-10-05). Windows makes the copy beside
it without asking: "a - Copy.txt", then "a - Copy (2).txt" and on; a
folder "F - Copy" with what is in it. SHFileOperation's copy into a folder
now does that when the destination is the item itself.

Test: test/selfcopy-gate.sh with test/selfcopy-probe.c (mutant
SG_MUTANT_SELF_COPY_ASKS: the probe's copy waits on the question).
---
--- a/dlls/shell32/shlfileop.c
+++ b/dlls/shell32/shlfileop.c
@@ -1177,18 +1177,54 @@
 }
 
 /* copy a file or directory to another directory */
+/* Stained Glass OS: the name a copy of dst gets beside it, as Windows names
+ * it -- "name - Copy.ext", then "name - Copy (2).ext" and on; a folder's
+ * "name - Copy" */
+static void copy_name(const WCHAR *dst, BOOL folder, WCHAR *out)
+{
+    WCHAR base[MAX_PATH], ext[MAX_PATH] = L"";
+    const WCHAR *dot = folder ? dst + lstrlenW(dst) : PathFindExtensionW(dst);
+    int i;
+
+    lstrcpynW(base, dst, MAX_PATH);
+    if (!folder) lstrcpynW(ext, dot, MAX_PATH);
+    base[dot - dst] = 0;
+    swprintf(out, MAX_PATH, L"%s - Copy%s", base, ext);
+    for (i = 2; i < 10000 && GetFileAttributesW(out) != INVALID_FILE_ATTRIBUTES; i++)
+        swprintf(out, MAX_PATH, L"%s - Copy (%d)%s", base, i, ext);
+}
+
 static void copy_to_dir(FILE_OPERATION *op, const FILE_ENTRY *feFrom, const FILE_ENTRY *feTo)
 {
+    WCHAR szDestPath[MAX_PATH], copy[MAX_PATH];
+
     if (!PathFileExistsW(feTo->szFullPath))
         SHNotifyCreateDirectoryW(feTo->szFullPath, NULL);
 
-    if (IsAttribFile(feFrom->attributes))
+    PathCombineW(szDestPath, feTo->szFullPath, feFrom->szFilename);
+#ifndef SG_MUTANT_SELF_COPY_ASKS
+    /* Stained Glass OS: pasted into its own folder, a copy beside it, named
+     * as Windows names it, with nothing asked (it asked Replace, Skip or
+     * Keep both, and its own "Keep both" said "name (2)") */
+    if (!lstrcmpiW(feFrom->szFullPath, szDestPath))
     {
-        WCHAR szDestPath[MAX_PATH];
+        if (IsAttribFile(feFrom->attributes))
+        {
+            copy_name(szDestPath, FALSE, copy);
+            copy_file_to_file(op, feFrom->szFullPath, copy);
+        }
+        else if (!(op->req->fFlags & FOF_FILESONLY && feFrom->bFromWildcard))
+        {
+            copy_name(szDestPath, TRUE, copy);
+            copy[lstrlenW(copy) + 1] = 0;
+            copy_dir_to_dir(op, feFrom, copy);
+        }
+        return;
+    }
+#endif
 
-        PathCombineW(szDestPath, feTo->szFullPath, feFrom->szFilename);
+    if (IsAttribFile(feFrom->attributes))
         copy_file_to_file(op, feFrom->szFullPath, szDestPath);
-    }
     else if (!(op->req->fFlags & FOF_FILESONLY && feFrom->bFromWildcard))
         copy_dir_to_dir(op, feFrom, feTo->szFullPath);
 }
