From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: the Control Panel's category view, FOLDERID_ControlPanelFolder parses (9860)

Windows names FOLDERID_ControlPanelFolder "::{26EE0668-A00A-44D7-9371-BEB064C98683}\0": the
Control Panel's category view {26EE0668-...} and in it "0", All Control Panel Items. Launchers that list
the Control Panel parse that name (Wox 2.5, Open-Shell 4.4). shell32 had no class {26EE0668-...}:
CoCreateInstance said REGDB_E_CLASSNOTREG, SHParseDisplayName failed and their Control Panel entries
were missing.

The class is now the Control Panel folder in its category view. Its "0" parses to All Control Panel
Items (the classic Control Panel, named so, parsing name "::{26EE0668-...}\0"), which binds and lists
the applets. There are no category pages here, so the category view itself lists the same items.
---
--- a/dlls/shell32/cpanelfolder.c
+++ b/dlls/shell32/cpanelfolder.c
@@ -62,8 +62,26 @@
     /* both paths are parsible from the desktop */
     LPITEMIDLIST pidlRoot;	/* absolute pidl */
     int dwAttributes;		/* attributes returned by GetAttributesOf FIXME: use it */
+    BOOL category;		/* the category view, {26EE0668-...} */
 } ICPanelImpl;
 
+/* Stained Glass OS 9860: the Control Panel's category view. Windows names
+ * FOLDERID_ControlPanelFolder "::{26EE0668-A00A-44D7-9371-BEB064C98683}\0":
+ * the category view, and in it "0", All Control Panel Items. Launchers that
+ * list the Control Panel (Wox, Open-Shell's menu) parse that name; the class
+ * was not there, so parsing it failed and the Control Panel was missing.
+ * There are no category pages here, so the category view lists the same items
+ * as All Control Panel Items, and its "0" is the classic Control Panel. */
+const CLSID CLSID_ControlPanelCategory = { 0x26ee0668, 0xa00a, 0x44d7, { 0x93, 0x71, 0xbe, 0xb0, 0x64, 0xc9, 0x86, 0x83 } };
+
+static BOOL is_all_items( const ICPanelImpl *This, LPCITEMIDLIST pidl )
+{
+    const GUID *guid;
+
+    if (!This->category || !pidl || !pidl->mkid.cb) return FALSE;
+    return (guid = _ILGetGUIDPointer( pidl )) && IsEqualGUID( guid, &CLSID_ControlPanel );
+}
+
 static const WCHAR name_spaceW[] = L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ControlPanel\\NameSpace";
 
 static const IShellFolder2Vtbl vt_ShellFolder2;
@@ -107,7 +125,7 @@
 /**************************************************************************
 *	IControlPanel_Constructor
 */
-HRESULT WINAPI IControlPanel_Constructor(IUnknown* pUnkOuter, REFIID riid, LPVOID * ppv)
+static HRESULT create_control_panel(IUnknown* pUnkOuter, REFIID riid, LPVOID * ppv, BOOL category)
 {
     ICPanelImpl *sf;
 
@@ -127,7 +145,11 @@
     sf->IPersistFolder2_iface.lpVtbl = &vt_PersistFolder2;
     sf->IShellExecuteHookW_iface.lpVtbl = &vt_ShellExecuteHookW;
     sf->IShellExecuteHookA_iface.lpVtbl = &vt_ShellExecuteHookA;
-    sf->pidlRoot = _ILCreateControlPanel();	/* my qualified pidl */
+#ifndef SG_MUTANT_NO_CPANEL_CATEGORY
+    sf->category = category;
+#endif
+    sf->pidlRoot = category ? _ILCreateGuid(PT_GUID, &CLSID_ControlPanelCategory)
+                            : _ILCreateControlPanel();	/* my qualified pidl */
     sf->pUnkOuter = pUnkOuter ? pUnkOuter : (IUnknown *)&sf->IShellFolder2_iface;
 
     if (FAILED(IShellFolder2_QueryInterface(&sf->IShellFolder2_iface, riid, ppv))) {
@@ -140,6 +162,16 @@
     return S_OK;
 }
 
+HRESULT WINAPI IControlPanel_Constructor(IUnknown* pUnkOuter, REFIID riid, LPVOID * ppv)
+{
+    return create_control_panel(pUnkOuter, riid, ppv, FALSE);
+}
+
+HRESULT WINAPI IControlPanelCategory_Constructor(IUnknown* pUnkOuter, REFIID riid, LPVOID * ppv)
+{
+    return create_control_panel(pUnkOuter, riid, ppv, TRUE);
+}
+
 /**************************************************************************
  *	ISF_ControlPanel_fnQueryInterface
  *
@@ -210,6 +242,23 @@
 
     HRESULT hr = E_INVALIDARG;
 
+    if (This->category && lpszDisplayName && lpszDisplayName[0] == '0' &&
+        (!lpszDisplayName[1] || lpszDisplayName[1] == '\\'))
+    {
+        /* "0": All Control Panel Items */
+        TRACE("(%p)->(%s) all items\n", This, debugstr_w(lpszDisplayName));
+        if (!ppidl) return E_INVALIDARG;
+        if (!(*ppidl = _ILCreateGuid(PT_GUID, &CLSID_ControlPanel))) return E_OUTOFMEMORY;
+        hr = S_OK;
+        if (lpszDisplayName[1] && lpszDisplayName[2])
+            hr = SHELL32_ParseNextElement(iface, hwndOwner, pbc, ppidl, (LPOLESTR)lpszDisplayName + 2,
+                                          pchEaten, pdwAttributes);
+        else if (pdwAttributes && *pdwAttributes)
+            hr = IShellFolder2_GetAttributesOf(iface, 1, (LPCITEMIDLIST *)ppidl, pdwAttributes);
+        if (FAILED(hr)) { ILFree(*ppidl); *ppidl = NULL; }
+        return hr;
+    }
+
     FIXME("(%p)->(HWND=%p,%p,%p=%s,%p,pidl=%p,%p)\n",
 	   This, hwndOwner, pbc, lpszDisplayName, debugstr_w(lpszDisplayName), pchEaten, ppidl, pdwAttributes);
 
@@ -593,8 +642,10 @@
     while(cidl > 0 && *apidl) {
 	pdump(*apidl);
 
+        if (is_all_items(This, *apidl))
+            *rgfInOut &= SFGAO_CANLINK | SFGAO_FOLDER | SFGAO_HASSUBFOLDER | SFGAO_BROWSABLE;
         /* TODO: panel with GUID can contain sub-items but we don't support it yet */
-        if (!(*rgfInOut & SFGAO_VALIDATE) || _ILGetCPanelPointer(*apidl)
+        else if (!(*rgfInOut & SFGAO_VALIDATE) || _ILGetCPanelPointer(*apidl)
                 || validate_name_space(*apidl))
             *rgfInOut &= SFGAO_CANLINK;
         else
@@ -688,6 +739,35 @@
     if (!pidl || !strRet)
 	return E_INVALIDARG;
 
+    if (is_all_items(This, pidl))
+    {
+        if (!(dwFlags & SHGDN_FORPARSING))
+            lstrcpyW(wszPath, L"All Control Panel Items");
+        else
+        {
+            if (dwFlags & SHGDN_INFOLDER) lstrcpyW(wszPath, L"0");
+            else lstrcpyW(wszPath, L"::{26EE0668-A00A-44D7-9371-BEB064C98683}\\0");
+            if (!_ILIsPidlSimple(pidl))
+            {
+                IShellFolder2 *child;
+                LPITEMIDLIST first = ILCloneFirst(pidl);
+                HRESULT hr = first ? IShellFolder2_BindToObject(iface, first, NULL, &IID_IShellFolder2, (void **)&child)
+                                   : E_OUTOFMEMORY;
+                ILFree(first);
+                if (FAILED(hr)) return hr;
+                PathAddBackslashW(wszPath);
+                hr = SHELL32_GetDisplayNameOfChild(child, ILGetNext(pidl), dwFlags | SHGDN_INFOLDER,
+                                                   wszPath + lstrlenW(wszPath), MAX_PATH + 1 - lstrlenW(wszPath));
+                IShellFolder2_Release(child);
+                if (FAILED(hr)) return hr;
+            }
+        }
+        strRet->uType = STRRET_WSTR;
+        if (!(strRet->pOleStr = CoTaskMemAlloc((lstrlenW(wszPath) + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        lstrcpyW(strRet->pOleStr, wszPath);
+        return S_OK;
+    }
+
     pcpanel = _ILGetCPanelPointer(pidl);
 
     if (pcpanel) {
@@ -906,7 +986,7 @@
 
     if (!lpClassId)
 	return E_POINTER;
-    *lpClassId = CLSID_ControlPanel;
+    *lpClassId = This->category ? CLSID_ControlPanelCategory : CLSID_ControlPanel;
 
     return S_OK;
 }
