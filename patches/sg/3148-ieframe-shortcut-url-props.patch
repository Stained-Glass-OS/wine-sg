-        FIXME("ignoring unsupported flags 0x%lx\n", dwInFlags);
     if (pcszURL != NULL)
     {
         newURL = co_strdupAtoW(pcszURL);
         if (newURL == NULL)
             return E_OUTOFMEMORY;
     }
-    CoTaskMemFree(This->url);
-    This->url = newURL;
-    This->isDirty = TRUE;
-    return S_OK;
+    hr = UniformResourceLocatorW_SetUrl(&This->IUniformResourceLocatorW_iface, newURL, dwInFlags);
+    CoTaskMemFree(newURL);
+    return hr;
 }
 
