@@ -695,6 +722,199 @@ static ULONG WINAPI PropertySetStorage_Release(IPropertySetStorage *iface)
     return Unknown_Release(This);
 }
 
+/* A writable property storage handed to the application. The icon properties are also kept
+   in the .url file once the shortcut has one, so setting them after Save still reaches the file. */
+typedef struct
+{
+    IPropertyStorage IPropertyStorage_iface;
+    LONG ref;
+    IPropertyStorage *inner;
+    InternetShortcut *shortcut;
+} ShortcutPropertyStorage;
+
+static inline ShortcutPropertyStorage *impl_from_IPropertyStorage(IPropertyStorage *iface)
+{
+    return CONTAINING_RECORD(iface, ShortcutPropertyStorage, IPropertyStorage_iface);
+}
+
+static void shortcut_update_icon_key(InternetShortcut *shortcut, PROPID id, const PROPVARIANT *value)
+{
+    static const WCHAR header[] = L"InternetShortcut";
+    WCHAR number[32];
+    const WCHAR *key, *text = NULL;
+
+    TRACE("%p, %lu, %p, file %s\n", shortcut, id, value, debugstr_w(shortcut->currentFile));
+    if (!shortcut->currentFile) return;
+
+    if (id == PID_IS_ICONFILE)
+    {
+        key = L"IconFile";
+        if (value && value->vt == VT_LPWSTR) text = value->pwszVal;
+    }
+    else if (id == PID_IS_ICONINDEX)
+    {
+        key = L"IconIndex";
+        if (value && value->vt == VT_I4)
+        {
+            swprintf(number, ARRAY_SIZE(number), L"%ld", value->lVal);
+            text = number;
+        }
+    }
+    else return;
+
+    /* a missing value (or one of another type) removes the key */
+    WritePrivateProfileStringW(header, key, text, shortcut->currentFile);
+}
+
+static HRESULT WINAPI SPS_QueryInterface(IPropertyStorage *iface, REFIID riid, void **obj)
+{
+    ShortcutPropertyStorage *This = impl_from_IPropertyStorage(iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IPropertyStorage))
+    {
+        *obj = &This->IPropertyStorage_iface;
+        IPropertyStorage_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI SPS_AddRef(IPropertyStorage *iface)
+{
+    ShortcutPropertyStorage *This = impl_from_IPropertyStorage(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI SPS_Release(IPropertyStorage *iface)
+{
+    ShortcutPropertyStorage *This = impl_from_IPropertyStorage(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        IPropertyStorage_Release(This->inner);
+        Unknown_Release(This->shortcut);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI SPS_ReadMultiple(IPropertyStorage *iface, ULONG count, const PROPSPEC *spec, PROPVARIANT *var)
+{
+    return IPropertyStorage_ReadMultiple(impl_from_IPropertyStorage(iface)->inner, count, spec, var);
+}
+
+static HRESULT WINAPI SPS_WriteMultiple(IPropertyStorage *iface, ULONG count, const PROPSPEC *spec,
+        const PROPVARIANT *var, PROPID first)
+{
+    ShortcutPropertyStorage *This = impl_from_IPropertyStorage(iface);
+    HRESULT hr = IPropertyStorage_WriteMultiple(This->inner, count, spec, var, first);
+    ULONG i;
+
+#ifndef SG_MUTANT_URL_ICONFILE
+    if (SUCCEEDED(hr))
+        for (i = 0; i < count; i++)
+            if (spec[i].ulKind == PRSPEC_PROPID)
+                shortcut_update_icon_key(This->shortcut, spec[i].propid, &var[i]);
+#endif
+    return hr;
+}
+
+static HRESULT WINAPI SPS_DeleteMultiple(IPropertyStorage *iface, ULONG count, const PROPSPEC *spec)
+{
+    ShortcutPropertyStorage *This = impl_from_IPropertyStorage(iface);
+    HRESULT hr = IPropertyStorage_DeleteMultiple(This->inner, count, spec);
+    ULONG i;
+
+    if (SUCCEEDED(hr))
+        for (i = 0; i < count; i++)
+            if (spec[i].ulKind == PRSPEC_PROPID)
+                shortcut_update_icon_key(This->shortcut, spec[i].propid, NULL);
+    return hr;
+}
+
+static HRESULT WINAPI SPS_ReadPropertyNames(IPropertyStorage *iface, ULONG count, const PROPID *ids, LPOLESTR *names)
+{
+    return IPropertyStorage_ReadPropertyNames(impl_from_IPropertyStorage(iface)->inner, count, ids, names);
+}
+
+static HRESULT WINAPI SPS_WritePropertyNames(IPropertyStorage *iface, ULONG count, const PROPID *ids,
+        const LPOLESTR *names)
+{
+    return IPropertyStorage_WritePropertyNames(impl_from_IPropertyStorage(iface)->inner, count, ids, names);
+}
+
+static HRESULT WINAPI SPS_DeletePropertyNames(IPropertyStorage *iface, ULONG count, const PROPID *ids)
+{
+    return IPropertyStorage_DeletePropertyNames(impl_from_IPropertyStorage(iface)->inner, count, ids);
+}
+
+static HRESULT WINAPI SPS_Commit(IPropertyStorage *iface, DWORD flags)
+{
+    return IPropertyStorage_Commit(impl_from_IPropertyStorage(iface)->inner, flags);
+}
+
+static HRESULT WINAPI SPS_Revert(IPropertyStorage *iface)
+{
+    return IPropertyStorage_Revert(impl_from_IPropertyStorage(iface)->inner);
+}
+
+static HRESULT WINAPI SPS_Enum(IPropertyStorage *iface, IEnumSTATPROPSTG **enum_stat)
+{
+    return IPropertyStorage_Enum(impl_from_IPropertyStorage(iface)->inner, enum_stat);
+}
+
+static HRESULT WINAPI SPS_SetTimes(IPropertyStorage *iface, const FILETIME *ctime, const FILETIME *atime,
+        const FILETIME *mtime)
+{
+    return IPropertyStorage_SetTimes(impl_from_IPropertyStorage(iface)->inner, ctime, atime, mtime);
+}
+
+static HRESULT WINAPI SPS_SetClass(IPropertyStorage *iface, REFCLSID clsid)
+{
+    return IPropertyStorage_SetClass(impl_from_IPropertyStorage(iface)->inner, clsid);
+}
+
+static HRESULT WINAPI SPS_Stat(IPropertyStorage *iface, STATPROPSETSTG *stat)
+{
+    return IPropertyStorage_Stat(impl_from_IPropertyStorage(iface)->inner, stat);
+}
+
+static const IPropertyStorageVtbl ShortcutPropertyStorageVtbl =
+{
+    SPS_QueryInterface,
+    SPS_AddRef,
+    SPS_Release,
+    SPS_ReadMultiple,
+    SPS_WriteMultiple,
+    SPS_DeleteMultiple,
+    SPS_ReadPropertyNames,
+    SPS_WritePropertyNames,
+    SPS_DeletePropertyNames,
+    SPS_Commit,
+    SPS_Revert,
+    SPS_Enum,
+    SPS_SetTimes,
+    SPS_SetClass,
+    SPS_Stat
+};
+
+/* replaces *storage by a wrapper that follows the shortcut's file; keeps it on failure */
+static void shortcut_wrap_property_storage(InternetShortcut *shortcut, IPropertyStorage **storage)
+{
+    ShortcutPropertyStorage *wrapper = calloc(1, sizeof(*wrapper));
+
+    if (!wrapper) return;
+    wrapper->IPropertyStorage_iface.lpVtbl = &ShortcutPropertyStorageVtbl;
+    wrapper->ref = 1;
+    wrapper->inner = *storage;      /* takes over the caller's reference */
+    wrapper->shortcut = shortcut;
+    Unknown_AddRef(shortcut);
+    *storage = &wrapper->IPropertyStorage_iface;
+}
+
+
 static HRESULT WINAPI PropertySetStorage_Create(
         IPropertySetStorage* iface,
         REFFMTID rfmtid,
@@ -704,14 +924,18 @@ static HRESULT WINAPI PropertySetStorage_Create(
         IPropertyStorage **ppprstg)
 {
     InternetShortcut *This = impl_from_IPropertySetStorage(iface);
+    HRESULT hr;
     TRACE("(%s, %p, 0x%lx, 0x%lx, %p)\n", debugstr_guid(rfmtid), pclsid, grfFlags, grfMode, ppprstg);
 
-    return IPropertySetStorage_Create(This->property_set_storage,
-                                      rfmtid,
-                                      pclsid,
-                                      grfFlags,
-                                      grfMode,
-                                      ppprstg);
+    hr = IPropertySetStorage_Create(This->property_set_storage,
+                                    rfmtid,
+                                    pclsid,
+                                    grfFlags,
+                                    grfMode,
+                                    ppprstg);
+    if (SUCCEEDED(hr) && ppprstg && *ppprstg && IsEqualGUID(rfmtid, &FMTID_Intshcut))
+        shortcut_wrap_property_storage(This, ppprstg);
+    return hr;
 }
 
 static HRESULT WINAPI PropertySetStorage_Open(
@@ -722,6 +946,7 @@ static HRESULT WINAPI PropertySetStorage_Open(
 {
     const DWORD STGM_ACCESS_MASK = 0x0000000f;
     InternetShortcut *This = impl_from_IPropertySetStorage(iface);
+    HRESULT hr;
     TRACE("(%s, 0x%lx, %p)\n", debugstr_guid(rfmtid), grfMode, ppprstg);
 
     /* ole32 doesn't like STGM_WRITE */
@@ -729,10 +954,14 @@ static HRESULT WINAPI PropertySetStorage_Open(
         grfMode = (grfMode & ~STGM_ACCESS_MASK) | STGM_READWRITE;
 
     /* Note:  The |STGM_SHARE_EXCLUSIVE is to cope with a bug in the implementation.  Should be fixed in ole32. */
-    return IPropertySetStorage_Open(This->property_set_storage,
-                                    rfmtid,
-                                    grfMode|STGM_SHARE_EXCLUSIVE,
-                                    ppprstg);
+    hr = IPropertySetStorage_Open(This->property_set_storage,
+                                  rfmtid,
+                                  grfMode|STGM_SHARE_EXCLUSIVE,
+                                  ppprstg);
+    if (SUCCEEDED(hr) && ppprstg && *ppprstg && (grfMode & STGM_ACCESS_MASK) != STGM_READ
+            && IsEqualGUID(rfmtid, &FMTID_Intshcut))
+        shortcut_wrap_property_storage(This, ppprstg);
+    return hr;
 }
 
 static HRESULT WINAPI PropertySetStorage_Delete(IPropertySetStorage *iface, REFFMTID rfmtid)
@@ -747,8 +976,11 @@ static HRESULT WINAPI PropertySetStorage_Delete(IPropertySetStorage *iface, REFF
 
 static HRESULT WINAPI PropertySetStorage_Enum(IPropertySetStorage *iface, IEnumSTATPROPSETSTG **ppenum)
 {
-    FIXME("(%p): stub\n", ppenum);
-    return E_NOTIMPL;
+    InternetShortcut *This = impl_from_IPropertySetStorage(iface);
+
+    TRACE("(%p)\n", ppenum);
+
+    return IPropertySetStorage_Enum(This->property_set_storage, ppenum);
 }
 
