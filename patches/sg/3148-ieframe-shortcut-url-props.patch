From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 02:36:42 -0700
Subject: [PATCH] ieframe: InternetShortcut SetURL flags and syntax, icon
 properties follow the file

SetURL keeps only absolute URLs: a string without a scheme is dropped
(GetURL then returns S_FALSE and NULL), and with
IURL_SETURL_FL_GUESS_PROTOCOL or IURL_SETURL_FL_USE_DEFAULT_PROTOCOL the
scheme is applied and the URL canonicalized ("www.winehq.org" becomes
"http://www.winehq.org/"). The ANSI SetURL goes through the same code.

A writable IPropertyStorage of the shortcut now keeps the IconFile and
IconIndex keys of the .url file up to date, so icon properties set after
Save reach the file. IPropertySetStorage::Enum is forwarded. The icon index
read from a file is stored as a full VT_I4. Removes the todo_wine marks in
tests/intshcut.c.

diff --git a/dlls/ieframe/intshcut.c b/dlls/ieframe/intshcut.c
index 9515731..de969fa 100644
--- a/dlls/ieframe/intshcut.c
+++ b/dlls/ieframe/intshcut.c
@@ -223,13 +223,42 @@ static HRESULT WINAPI UniformResourceLocatorW_SetUrl(IUniformResourceLocatorW *u
     WCHAR *newURL = NULL;
     InternetShortcut *This = impl_from_IUniformResourceLocatorW(url);
     TRACE("(%p, %s, 0x%lx)\n", url, debugstr_w(pcszURL), dwInFlags);
-    if (dwInFlags != 0)
+    if (dwInFlags & ~ALL_IURL_SETURL_FLAGS)
         FIXME("ignoring unsupported flags 0x%lx\n", dwInFlags);
     if (pcszURL != NULL)
     {
-        newURL = co_strdupW(pcszURL);
-        if (newURL == NULL)
-            return E_OUTOFMEMORY;
+        WCHAR guessed[INTERNET_MAX_URL_LENGTH], canon[INTERNET_MAX_URL_LENGTH];
+        const WCHAR *src = pcszURL;
+        DWORD len;
+
+        if (dwInFlags & (IURL_SETURL_FL_GUESS_PROTOCOL | IURL_SETURL_FL_USE_DEFAULT_PROTOCOL))
+        {
+            len = ARRAY_SIZE(guessed);
+            if (UrlApplySchemeW(pcszURL, guessed, &len,
+                    (dwInFlags & IURL_SETURL_FL_GUESS_PROTOCOL) ? URL_APPLY_GUESSSCHEME : URL_APPLY_DEFAULT) == S_OK)
+            {
+                len = ARRAY_SIZE(canon);
+                if (UrlCanonicalizeW(guessed, canon, &len, 0) == S_OK)
+                    src = canon;
+                else
+                    src = guessed;
+            }
+        }
+
+        /* a string that is not an absolute URL is not kept */
+#ifndef SG_MUTANT_URL_SYNTAX
+        {
+            PARSEDURLW parsed = { sizeof(parsed) };
+            if (ParseURLW(src, &parsed) != S_OK)
+                src = NULL;
+        }
+#endif
+        if (src)
+        {
+            newURL = co_strdupW(src);
+            if (newURL == NULL)
+                return E_OUTOFMEMORY;
+        }
     }
     CoTaskMemFree(This->url);
     This->url = newURL;
@@ -325,19 +354,17 @@ static HRESULT WINAPI UniformResourceLocatorA_SetUrl(IUniformResourceLocatorA *u
