From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mapi32: plain export names on 64-bit

On x64 there is no stdcall @N decoration, and Windows' 64-bit MAPI32.DLL exports its functions by their plain names. Wine's mapi32 exported only the x86 decorated names (HrGetOneProp@12 and so on) for 64-bit too, so a 64-bit program importing HrGetOneProp, HrSetOneProp, HrQueryAllRows, FreeProws or any of the other utility functions did not get them. The 64-bit DLL now also exports the 59 plain names of the decorated functions that had none.
---
--- a/dlls/mapi32/mapi32.spec
+++ b/dlls/mapi32/mapi32.spec
@@ -189,3 +189,64 @@
 254 stdcall FGetComponentPath(str str ptr long long)
 255 stdcall FGetComponentPath@20(str str ptr long long) FGetComponentPath
 256 stdcall MAPISendMailW(ptr long ptr long long)
+
+# (wine-sg 8264) the 64-bit DLL exports the stdcall functions by their plain names (there is no @N
+# decoration on x64)
+@ stdcall -arch=win64 ScInitMapiUtil(long) ScInitMapiUtil
+@ stdcall -arch=win64 DeinitMapiUtil() DeinitMapiUtil
+@ stdcall -arch=win64 WrapProgress(ptr ptr ptr ptr ptr) WrapProgress
+@ stdcall -arch=win64 HrThisThreadAdviseSink(ptr ptr) HrThisThreadAdviseSink
+@ stdcall -arch=win64 FBinFromHex(ptr ptr) FBinFromHex
+@ stdcall -arch=win64 HexFromBin(ptr long ptr) HexFromBin
+@ stdcall -arch=win64 SwapPlong(ptr long) SwapPlong
+@ stdcall -arch=win64 SwapPword(ptr long) SwapPword
+@ stdcall -arch=win64 MAPIGetDefaultMalloc() MAPIGetDefaultMalloc
+@ stdcall -arch=win64 CreateIProp(ptr ptr ptr ptr ptr ptr) CreateIProp
+@ stdcall -arch=win64 MNLS_lstrlenW(wstr) MNLS_lstrlenW
+@ stdcall -arch=win64 MNLS_lstrcmpW(wstr wstr) MNLS_lstrcmpW
+@ stdcall -arch=win64 MNLS_lstrcpyW(ptr wstr) MNLS_lstrcpyW
+@ stdcall -arch=win64 MNLS_CompareStringW(long wstr wstr) MNLS_CompareStringW
+@ stdcall -arch=win64 MNLS_MultiByteToWideChar(long long str long ptr long) kernel32.MultiByteToWideChar
+@ stdcall -arch=win64 MNLS_WideCharToMultiByte(long long wstr long ptr long ptr ptr) kernel32.WideCharToMultiByte
+@ stdcall -arch=win64 MNLS_IsBadStringPtrW(ptr long) kernel32.IsBadStringPtrW
+@ stdcall -arch=win64 FEqualNames(ptr ptr) FEqualNames
+@ stdcall -arch=win64 IsBadBoundedStringPtr(ptr long) IsBadBoundedStringPtr
+@ stdcall -arch=win64 HrQueryAllRows(ptr ptr ptr ptr long ptr) HrQueryAllRows
+@ stdcall -arch=win64 PropCopyMore(ptr ptr ptr ptr) PropCopyMore
+@ stdcall -arch=win64 UlPropSize(ptr) UlPropSize
+@ stdcall -arch=win64 FPropContainsProp(ptr ptr long) FPropContainsProp
+@ stdcall -arch=win64 FPropCompareProp(ptr long ptr) FPropCompareProp
+@ stdcall -arch=win64 LPropCompareProp(ptr ptr) LPropCompareProp
+@ stdcall -arch=win64 FtAddFt(int64 int64) MAPI32_FtAddFt
+@ stdcall -arch=win64 FtSubFt(int64 int64) MAPI32_FtSubFt
+@ stdcall -arch=win64 FtMulDw(long int64) MAPI32_FtMulDw
+@ stdcall -arch=win64 FtMulDwDw(long long) MAPI32_FtMulDwDw
+@ stdcall -arch=win64 FtNegFt(int64) MAPI32_FtNegFt
+@ stdcall -arch=win64 UlAddRef(ptr) UlAddRef
+@ stdcall -arch=win64 UlRelease(ptr) UlRelease
+@ stdcall -arch=win64 SzFindCh(str long) shlwapi.StrChrA
+@ stdcall -arch=win64 SzFindLastCh(str str long) shlwapi.StrRChrA
+@ stdcall -arch=win64 SzFindSz(str str) shlwapi.StrStrA
+@ stdcall -arch=win64 UFromSz(str) UFromSz
+@ stdcall -arch=win64 HrGetOneProp(ptr long ptr) HrGetOneProp
+@ stdcall -arch=win64 HrSetOneProp(ptr ptr) HrSetOneProp
+@ stdcall -arch=win64 FPropExists(ptr long) FPropExists
+@ stdcall -arch=win64 PpropFindProp(ptr long long) PpropFindProp
+@ stdcall -arch=win64 FreePadrlist(ptr) FreePadrlist
+@ stdcall -arch=win64 FreeProws(ptr) FreeProws
+@ stdcall -arch=win64 UlFromSzHex(wstr) UlFromSzHex
+@ stdcall -arch=win64 ScCountProps(long ptr ptr) ScCountProps
+@ stdcall -arch=win64 ScCopyProps(long ptr ptr ptr) ScCopyProps
+@ stdcall -arch=win64 ScRelocProps(long ptr ptr ptr ptr) ScRelocProps
+@ stdcall -arch=win64 LpValFindProp(long long ptr) LpValFindProp
+@ stdcall -arch=win64 ScDupPropset(long ptr ptr ptr) ScDupPropset
+@ stdcall -arch=win64 FBadRglpszA(ptr long) FBadRglpszA
+@ stdcall -arch=win64 FBadRglpszW(ptr long) FBadRglpszW
+@ stdcall -arch=win64 FBadRowSet(ptr) FBadRowSet
+@ stdcall -arch=win64 FBadPropTag(long) FBadPropTag
+@ stdcall -arch=win64 FBadRow(ptr) FBadRow
+@ stdcall -arch=win64 FBadProp(ptr) FBadProp
+@ stdcall -arch=win64 FBadColumnSet(ptr) FBadColumnSet
+@ stdcall -arch=win64 FBadEntryList(ptr) FBadEntryList
+@ stdcall -arch=win64 CbOfEncoded(str) CbOfEncoded
+@ stdcall -arch=win64 HrDispatchNotifications(long) HrDispatchNotifications
