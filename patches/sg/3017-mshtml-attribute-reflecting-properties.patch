+static void _test_attr_prop(unsigned line, IHTMLElement *elem, const WCHAR *name, const WCHAR *value, const WCHAR *expected,
+        const WCHAR *attr)
+{
+    DISPID dispid, propput = DISPID_PROPERTYPUT;
+    DISPPARAMS dp = { NULL, NULL, 0, 0 };
+    VARIANT arg, res, str;
+    IDispatch *disp;
+    BSTR bstr_name, attr_val;
+    HRESULT hres;
+
+    hres = IHTMLElement_QueryInterface(elem, &IID_IDispatch, (void**)&disp);
+    ok_(__FILE__,line)(hres == S_OK, "QueryInterface(IDispatch) failed: %08lx\n", hres);
+
+    bstr_name = SysAllocString(name);
+    hres = IDispatch_GetIDsOfNames(disp, &IID_NULL, &bstr_name, 1, LOCALE_NEUTRAL, &dispid);
+    SysFreeString(bstr_name);
+    ok_(__FILE__,line)(hres == S_OK, "GetIDsOfNames(%s) failed: %08lx\n", wine_dbgstr_w(name), hres);
+    if(FAILED(hres)) {
+        IDispatch_Release(disp);
+        return;
+    }
+
+    V_VT(&arg) = VT_BSTR;
+    V_BSTR(&arg) = SysAllocString(value);
+    dp.rgvarg = &arg;
+    dp.cArgs = 1;
+    dp.rgdispidNamedArgs = &propput;
+    dp.cNamedArgs = 1;
+    hres = IDispatch_Invoke(disp, dispid, &IID_NULL, LOCALE_NEUTRAL, DISPATCH_PROPERTYPUT, &dp, NULL, NULL, NULL);
+    ok_(__FILE__,line)(hres == S_OK, "put %s failed: %08lx\n", wine_dbgstr_w(name), hres);
+    VariantClear(&arg);
+
+    dp.cArgs = dp.cNamedArgs = 0;
+    dp.rgvarg = NULL;
+    dp.rgdispidNamedArgs = NULL;
+    V_VT(&res) = VT_EMPTY;
+    hres = IDispatch_Invoke(disp, dispid, &IID_NULL, LOCALE_NEUTRAL, DISPATCH_PROPERTYGET, &dp, &res, NULL, NULL);
+    ok_(__FILE__,line)(hres == S_OK, "get %s failed: %08lx\n", wine_dbgstr_w(name), hres);
+    if(hres == S_OK) {
+        V_VT(&str) = VT_EMPTY;
+        hres = VariantChangeType(&str, &res, 0, VT_BSTR);
+        ok_(__FILE__,line)(hres == S_OK, "VariantChangeType failed: %08lx\n", hres);
+        if(hres == S_OK) {
+            ok_(__FILE__,line)(V_BSTR(&str) && !wcscmp(V_BSTR(&str), expected), "%s = %s, expected %s\n",
+                    wine_dbgstr_w(name), wine_dbgstr_w(V_BSTR(&str)), wine_dbgstr_w(expected));
+            VariantClear(&str);
+        }
+        VariantClear(&res);
+    }
+
+    /* the value is stored in the attribute */
+    if(attr) {
+        BSTR attr_name = SysAllocString(attr);
+
+        V_VT(&res) = VT_EMPTY;
+        hres = IHTMLElement_getAttribute(elem, attr_name, 0, &res);
+        ok_(__FILE__,line)(hres == S_OK, "getAttribute(%s) failed: %08lx\n", wine_dbgstr_w(attr), hres);
+        V_VT(&str) = VT_EMPTY;
+        attr_val = (hres == S_OK && SUCCEEDED(VariantChangeType(&str, &res, 0, VT_BSTR))) ? V_BSTR(&str) : NULL;
+        ok_(__FILE__,line)(attr_val && !wcscmp(attr_val, expected), "attribute %s = %s, expected %s\n",
+                wine_dbgstr_w(attr), wine_dbgstr_w(attr_val), wine_dbgstr_w(expected));
+        VariantClear(&str);
+        VariantClear(&res);
+        SysFreeString(attr_name);
+    }
+    IDispatch_Release(disp);
+}
+#define test_attr_prop(a,b,c,d,e) _test_attr_prop(__LINE__,a,b,c,d,e)
+
+static void test_attribute_properties(IHTMLDocument2 *doc)
+{
+    IHTMLElement *elem;
+
+    elem = test_create_elem(doc, L"img");
+    test_attr_prop(elem, L"useMap", L"#map", L"#map", L"usemap");
+    test_attr_prop(elem, L"hspace", L"7", L"7", L"hspace");
+    test_attr_prop(elem, L"vspace", L"9", L"9", L"vspace");
+    test_attr_prop(elem, L"border", L"2", L"2", L"border");
+    test_attr_prop(elem, L"lowsrc", L"low.png", L"low.png", L"lowsrc");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"input");
+    test_attr_prop(elem, L"alt", L"alternative", L"alternative", L"alt");
+    test_attr_prop(elem, L"align", L"left", L"left", L"align");
+    test_attr_prop(elem, L"hspace", L"3", L"3", L"hspace");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"area");
+    test_attr_prop(elem, L"shape", L"rect", L"rect", L"shape");
+    test_attr_prop(elem, L"coords", L"1,2,3,4", L"1,2,3,4", L"coords");
+    test_attr_prop(elem, L"target", L"_blank", L"_blank", L"target");
+    test_attr_prop(elem, L"alt", L"a", L"a", L"alt");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"table");
+    test_attr_prop(elem, L"border", L"4", L"4", L"border");
+    test_attr_prop(elem, L"rules", L"all", L"all", L"rules");
+    test_attr_prop(elem, L"borderColor", L"red", L"red", L"bordercolor");
+    test_attr_prop(elem, L"background", L"bg.png", L"bg.png", L"background");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"td");
+    test_attr_prop(elem, L"vAlign", L"top", L"top", L"valign");
+    test_attr_prop(elem, L"background", L"c.png", L"c.png", L"background");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"tr");
+    test_attr_prop(elem, L"borderColorLight", L"blue", L"blue", L"bordercolorlight");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"iframe");
+    test_attr_prop(elem, L"hspace", L"5", L"5", L"hspace");
+    test_attr_prop(elem, L"align", L"right", L"right", L"align");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"textarea");
+    test_attr_prop(elem, L"wrap", L"off", L"off", L"wrap");
+    test_attr_prop(elem, L"cols", L"30", L"30", L"cols");
+    IHTMLElement_Release(elem);
+
+    elem = test_create_elem(doc, L"script");
+    test_attr_prop(elem, L"htmlFor", L"btn", L"btn", L"for");
+    IHTMLElement_Release(elem);
+}
