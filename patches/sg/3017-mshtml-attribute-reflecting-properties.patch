diff --git a/dlls/mshtml/htmlelem.c b/dlls/mshtml/htmlelem.c
index 0b4a62a..016bddd 100644
--- a/dlls/mshtml/htmlelem.c
+++ b/dlls/mshtml/htmlelem.c
@@ -288,6 +288,101 @@ HRESULT elem_string_attr_setter(HTMLElement *elem, const WCHAR *name, const WCHA
     return S_OK;
 }
 
+HRESULT elem_variant_attr_getter(HTMLElement *elem, const WCHAR *name, VARIANT *p)
+{
+    BSTR str;
+    HRESULT hres;
+
+    hres = elem_string_attr_getter(elem, name, TRUE, &str);
+    if(FAILED(hres))
+        return hres;
+
+    V_VT(p) = VT_BSTR;
+    V_BSTR(p) = str;
+    return S_OK;
+}
+
+HRESULT elem_variant_attr_setter(HTMLElement *elem, const WCHAR *name, VARIANT *v)
+{
+    VARIANT str;
+    HRESULT hres;
+
+    V_VT(&str) = VT_EMPTY;
+    hres = VariantChangeType(&str, v, 0, VT_BSTR);
+    if(FAILED(hres))
+        return hres;
+
+    hres = elem_string_attr_setter(elem, name, V_BSTR(&str) ? V_BSTR(&str) : L"");
+    VariantClear(&str);
+    return hres;
+}
+
+HRESULT elem_int_attr_getter(HTMLElement *elem, const WCHAR *name, LONG *p)
+{
+    BSTR str;
+    HRESULT hres;
+
+    hres = elem_string_attr_getter(elem, name, TRUE, &str);
+    if(FAILED(hres))
+        return hres;
+
+    *p = str ? wcstol(str, NULL, 10) : 0;
+    SysFreeString(str);
+    return S_OK;
+}
+
+HRESULT elem_short_attr_getter(HTMLElement *elem, const WCHAR *name, short *p)
+{
+    LONG val;
+    HRESULT hres;
+
+    hres = elem_int_attr_getter(elem, name, &val);
+    if(SUCCEEDED(hres))
+        *p = val;
+    return hres;
+}
+
+HRESULT elem_int_attr_setter(HTMLElement *elem, const WCHAR *name, LONG val)
+{
+    WCHAR buf[16];
+
+    swprintf(buf, ARRAY_SIZE(buf), L"%ld", val);
+    return elem_string_attr_setter(elem, name, buf);
+}
+
+HRESULT elem_bool_attr_getter(HTMLElement *elem, const WCHAR *name, VARIANT_BOOL *p)
+{
+    nsAString name_str;
+    cpp_bool has;
+    nsresult nsres;
+
+    nsAString_InitDepend(&name_str, name);
+    nsres = nsIDOMElement_HasAttribute(elem->dom_element, &name_str, &has);
+    nsAString_Finish(&name_str);
+    if(NS_FAILED(nsres))
+        return E_FAIL;
+
+    *p = variant_bool(has);
+    return S_OK;
+}
+
+HRESULT elem_bool_attr_setter(HTMLElement *elem, const WCHAR *name, VARIANT_BOOL val)
+{
+    nsAString name_str;
+    nsresult nsres;
+    HRESULT hres = S_OK;
+
+    if(val)
+        return elem_string_attr_setter(elem, name, name);
+
+    nsAString_InitDepend(&name_str, name);
+    nsres = nsIDOMElement_RemoveAttribute(elem->dom_element, &name_str);
+    nsAString_Finish(&name_str);
+    if(NS_FAILED(nsres))
+        hres = E_FAIL;
+    return hres;
+}
+
 static VARIANT_BOOL element_has_attribute(HTMLElement *element, const WCHAR *name)
 {
     nsAString name_str;
