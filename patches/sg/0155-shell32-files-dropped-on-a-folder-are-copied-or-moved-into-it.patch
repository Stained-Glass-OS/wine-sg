+/* Stained Glass: the files a drop carries, as a double-null-terminated list of
+ * paths (from CF_HDROP, else from the shell's ID list) */
+static WCHAR *drop_source_paths(IDataObject *data, UINT *count)
+{
+    FORMATETC format;
+    STGMEDIUM medium;
+    WCHAR *list = NULL, path[MAX_PATH];
+    size_t len = 0, cap = 0;
+    UINT i, n;
+
+    *count = 0;
+    InitFormatEtc(format, CF_HDROP, TYMED_HGLOBAL);
+    if (SUCCEEDED(IDataObject_GetData(data, &format, &medium)))
+    {
+        HDROP drop = GlobalLock(medium.hGlobal);
+        n = drop ? DragQueryFileW(drop, ~0u, NULL, 0) : 0;
+        for (i = 0; i < n; i++)
+        {
+            size_t l;
+            if (!DragQueryFileW(drop, i, path, MAX_PATH)) continue;
+            l = lstrlenW(path) + 1;
+            if (len + l + 1 > cap)
+            {
+                WCHAR *grown;
+                cap = max(cap * 2, len + l + 1 + MAX_PATH);
+                if (!(grown = realloc(list, cap * sizeof(WCHAR)))) break;
+                list = grown;
+            }
+            lstrcpyW(list + len, path);
+            len += l;
+            (*count)++;
+        }
+        if (drop) GlobalUnlock(medium.hGlobal);
+        ReleaseStgMedium(&medium);
+    }
+    if (!*count)
+    {
+        InitFormatEtc(format, cfShellIDList, TYMED_HGLOBAL);
+        if (SUCCEEDED(IDataObject_GetData(data, &format, &medium)))
+        {
+            LPIDA ida = GlobalLock(medium.hGlobal);
+            for (i = 0; ida && i < ida->cidl; i++)
+            {
+                ITEMIDLIST *full = ILCombine(HIDA_GetPIDLFolder(ida), HIDA_GetPIDLItem(ida, i));
+                size_t l;
+                if (!full || !SHGetPathFromIDListW(full, path)) { ILFree(full); continue; }
+                ILFree(full);
+                l = lstrlenW(path) + 1;
+                if (len + l + 1 > cap)
+                {
+                    WCHAR *grown;
+                    cap = max(cap * 2, len + l + 1 + MAX_PATH);
+                    if (!(grown = realloc(list, cap * sizeof(WCHAR)))) break;
+                    list = grown;
+                }
+                lstrcpyW(list + len, path);
+                len += l;
+                (*count)++;
+            }
+            if (ida) GlobalUnlock(medium.hGlobal);
+            ReleaseStgMedium(&medium);
+        }
+    }
+    if (list) list[len] = 0;
+    else *count = 0;
+    return list;
+}
+
+/* the volume a path is on, as far as a move is concerned */
+static BOOL same_volume(const WCHAR *a, const WCHAR *b)
+{
+    WCHAR va[MAX_PATH], vb[MAX_PATH];
+
+    if (!GetVolumePathNameW(a, va, MAX_PATH) || !GetVolumePathNameW(b, vb, MAX_PATH)) return FALSE;
+    return !wcsicmp(va, vb);
+}
+
+/* Windows' rule: Ctrl copies, Shift moves, Ctrl+Shift or Alt links; otherwise
+ * a move on the same drive and a copy to another */
+static DWORD drop_effect(IGenericSFImpl *This, DWORD keys)
+{
+    DWORD effect;
+
+    if ((keys & (MK_CONTROL | MK_SHIFT)) == (MK_CONTROL | MK_SHIFT) || (keys & MK_ALT)) effect = DROPEFFECT_LINK;
+    else if (keys & MK_CONTROL) effect = DROPEFFECT_COPY;
+    else if (keys & MK_SHIFT) effect = DROPEFFECT_MOVE;
+    else effect = (This->drop_effects_mask & DROPEFFECT_MOVE) && This->drop_same_volume ? DROPEFFECT_MOVE : DROPEFFECT_COPY;
+    if (!(effect & This->drop_effects_mask)) effect = This->drop_effects_mask & DROPEFFECT_COPY;
+    return effect;
+}
