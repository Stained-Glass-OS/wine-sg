+/* a shortcut to each dropped item, in the target folder */
+static HRESULT drop_links(const WCHAR *target, const WCHAR *list)
+{
+    const WCHAR *src;
+    HRESULT hr = S_OK;
+
+    for (src = list; *src; src += lstrlenW(src) + 1)
+    {
+        WCHAR link[MAX_PATH], name[MAX_PATH];
+        IShellLinkW *sl;
+        IPersistFile *pf;
+        int n = 2;
+
+        lstrcpynW(name, PathFindFileNameW(src), MAX_PATH);
+        PathRemoveExtensionW(name);
+        swprintf(link, MAX_PATH, L"%s\\%s - Shortcut.lnk", target, name);
+        while (GetFileAttributesW(link) != INVALID_FILE_ATTRIBUTES && n < 1000)
+            swprintf(link, MAX_PATH, L"%s\\%s - Shortcut (%d).lnk", target, name, n++);
+        if (FAILED(hr = CoCreateInstance(&CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&sl)))
+            break;
+        IShellLinkW_SetPath(sl, src);
+        if (SUCCEEDED(hr = IShellLinkW_QueryInterface(sl, &IID_IPersistFile, (void **)&pf)))
+        {
+            hr = IPersistFile_Save(pf, link, TRUE);
+            IPersistFile_Release(pf);
+        }
+        IShellLinkW_Release(sl);
+        if (FAILED(hr)) break;
+    }
+    return hr;
+}
