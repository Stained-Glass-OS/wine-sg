From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, msi, kernelbase, ntdll: a filtered administrator's linked token is not used to start programs; elevation goes through consent

Upstream Wine starts elevated programs with the token's linked token: shell32's runas and msi's
custom action server use it in CreateProcessAsUser, kernelbase leaves a requireAdministrator program
of a Limited token to the loader, and the loader duplicates the linked token into the process.
Since 7737 a filtered administrator's linked token is the person's full token at identification
level, with a handle that only queries it. "Run as administrator" then failed with ACCESS_DENIED,
and a requireAdministrator program ran unelevated, without consent.
Now each of them uses the linked token only when it can be used (a primary token, or impersonation
level at least SecurityImpersonation):
- runas and requireAdministrator programs go to the elevation broker, as a filtered administrator
  gets consent on Windows;
- msi's custom action server runs as the caller;
- the loader no longer goes on with a token it could not duplicate.
---
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index 4be112e..4f62691 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -801,7 +801,29 @@ static BOOL sg_elevation_required( const WCHAR *app_name, HANDLE token )
     if (GetTokenInformation( tok, TokenElevation, &elevation, sizeof(elevation), &size ) &&
         elevation.TokenIsElevated) return FALSE;
     if (GetTokenInformation( tok, TokenElevationType, &type, sizeof(type), &size ) &&
-        type == TokenElevationTypeLimited) return FALSE;  /* the loader elevates with the linked token */
+        type == TokenElevationTypeLimited)
+    {
+        /* the loader elevates with the linked token -- when it is a usable one (upstream Wine's admin
+         * token). Stained Glass OS 7740: a filtered administrator's is at identification level, and
+         * elevation goes through consent, the broker */
+        TOKEN_LINKED_TOKEN linked;
+        SECURITY_IMPERSONATION_LEVEL level = SecurityAnonymous;
+        TOKEN_TYPE tok_type = TokenImpersonation;
+        BOOL usable = FALSE;
+
+        if (GetTokenInformation( tok, TokenLinkedToken, &linked, sizeof(linked), &size ))
+        {
+            usable = GetTokenInformation( linked.LinkedToken, TokenType, &tok_type, sizeof(tok_type), &size ) &&
+                     (tok_type == TokenPrimary ||
+                      (GetTokenInformation( linked.LinkedToken, TokenImpersonationLevel, &level, sizeof(level), &size ) &&
+                       level >= SecurityImpersonation));
+            CloseHandle( linked.LinkedToken );
+        }
+#ifdef SG_MUTANT_LOADER_LIMITED_ANY
+        usable = TRUE;
+#endif
+        if (usable) return FALSE;
+    }
 
     if (sg_layers_run_as_admin( app_name ))
     {
diff --git a/dlls/msi/custom.c b/dlls/msi/custom.c
index a0cbc63..0b4496a 100644
--- a/dlls/msi/custom.c
+++ b/dlls/msi/custom.c
@@ -589,6 +589,21 @@ static HANDLE get_admin_token(void)
 
     if (!GetTokenInformation(GetCurrentThreadEffectiveToken(), TokenLinkedToken, &linked, sizeof(linked), &size))
         return NULL;
+    /* Stained Glass OS 7740: a filtered administrator's linked token can be read, not used to start the
+     * custom action server (identification level, query-only); the server then runs as the caller */
+    {
+        SECURITY_IMPERSONATION_LEVEL level = SecurityAnonymous;
+        TOKEN_TYPE tok_type = TokenImpersonation;
+
+        if (!GetTokenInformation(linked.LinkedToken, TokenType, &tok_type, sizeof(tok_type), &size) ||
+            (tok_type != TokenPrimary &&
+             (!GetTokenInformation(linked.LinkedToken, TokenImpersonationLevel, &level, sizeof(level), &size) ||
+              level < SecurityImpersonation)))
+        {
+            CloseHandle(linked.LinkedToken);
+            return NULL;
+        }
+    }
     return linked.LinkedToken;
 }
 
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 7414628..7ddba88 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -4474,9 +4474,15 @@ static void elevate_token(void)
 
     if (type == TokenElevationTypeFull) return;
 
-    NtQueryInformationToken( GetCurrentThreadEffectiveToken(),
-                             TokenLinkedToken, &linked, sizeof(linked), NULL );
-    NtDuplicateToken( linked.LinkedToken, 0, NULL, FALSE, TokenPrimary, &token.Token );
+    /* Stained Glass OS 7740: a filtered administrator's linked token is at identification level and
+     * cannot be duplicated: such a program is elevated through consent (kernelbase asks the broker) */
+    if (NtQueryInformationToken( GetCurrentThreadEffectiveToken(),
+                                 TokenLinkedToken, &linked, sizeof(linked), NULL )) return;
+    if (NtDuplicateToken( linked.LinkedToken, 0, NULL, FALSE, TokenPrimary, &token.Token ))
+    {
+        NtClose( linked.LinkedToken );
+        return;
+    }
 
     token.Thread = NULL;
     NtSetInformationProcess( GetCurrentProcess(), ProcessAccessToken, &token, sizeof(token) );
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index 833507d..92f4f37 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -431,6 +431,24 @@ static HANDLE get_admin_token(void)
 
     if (!GetTokenInformation(GetCurrentThreadEffectiveToken(), TokenLinkedToken, &linked, sizeof(linked), &size))
         return NULL;
+#ifndef SG_MUTANT_RUNAS_IDENTIFY_TOKEN
+    /* Stained Glass OS 7740: a filtered administrator's linked token is the person's full token at
+     * identification level, which can be read but not used to start a program (as Windows gives it to
+     * a caller without SeTcbPrivilege); elevation then goes through consent, the elevation broker */
+    {
+        SECURITY_IMPERSONATION_LEVEL level = SecurityAnonymous;
+        TOKEN_TYPE tok_type = TokenImpersonation;
+
+        if (!GetTokenInformation(linked.LinkedToken, TokenType, &tok_type, sizeof(tok_type), &size) ||
+            (tok_type != TokenPrimary &&
+             (!GetTokenInformation(linked.LinkedToken, TokenImpersonationLevel, &level, sizeof(level), &size) ||
+              level < SecurityImpersonation)))
+        {
+            CloseHandle(linked.LinkedToken);
+            return NULL;
+        }
+    }
+#endif
     return linked.LinkedToken;
 }
 
