From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: a command list another context made and drew into outlives the program's last Release a while

PowerPoint crashed at the first click on Designer. Office draws each
preview into a command list made by one device context, through a context of
its own; it then closes the list, releases it, and makes it an effect's
input. On Windows that works. Here the drawing context dropped its reference
when it went, the program's Release freed the list, and the effect's input
was freed memory. The drawing context's reference to such a list (one another
context made, which it drew into) is now dropped a while later; such a list
does not read back as the target, as on Windows; a context left with no
target draws nothing instead of binding no view; and a context going away no
longer leaves the list pointing at it. The device keeps such lists, under its
own lock, and lets them go when it goes or its resources are cleared.
---
diff --git a/dlls/d2d1/command_list.c b/dlls/d2d1/command_list.c
index 297d51c..c2f78a0 100644
--- a/dlls/d2d1/command_list.c
+++ b/dlls/d2d1/command_list.c
@@ -559,6 +559,44 @@ HRESULT d2d_command_list_create(ID2D1Factory *factory, struct d2d_command_list *
     return S_OK;
 }
 
+/* Stained Glass OS: a context's reference to a command list another context made, which it drew
+ * into, is dropped a while later. Office's Designer draws its previews so, closes and releases
+ * the list, and then makes it an effect's input -- which works on Windows; dropped at once, the
+ * list was freed under it (PowerPoint crashed at the first Designer click). The device keeps the
+ * last few such references, under its own lock (contexts of a multi-threaded factory are used
+ * from several threads), and lets them go when it goes or its resources are cleared. */
+void d2d_command_list_release_later(struct d2d_device *device, struct d2d_command_list *command_list)
+{
+    struct d2d_command_list *old;
+
+#ifdef SG_MUTANT_D2D_LIST_RELEASE_NOW
+    ID2D1CommandList_Release(&command_list->ID2D1CommandList_iface);
+    return;
+#endif
+    EnterCriticalSection(&device->lists_cs);
+    old = device->release_later[device->release_later_next];
+    device->release_later[device->release_later_next] = command_list;
+    device->release_later_next = (device->release_later_next + 1) % ARRAY_SIZE(device->release_later);
+    LeaveCriticalSection(&device->lists_cs);
+    if (old) ID2D1CommandList_Release(&old->ID2D1CommandList_iface);
+}
+
+void d2d_command_list_release_kept(struct d2d_device *device)
+{
+    struct d2d_command_list *kept[ARRAY_SIZE(device->release_later)];
+    unsigned int i;
+
+#ifdef SG_MUTANT_D2D_KEEP_LISTS
+    return;
+#endif
+    EnterCriticalSection(&device->lists_cs);
+    memcpy(kept, device->release_later, sizeof(kept));
+    memset(device->release_later, 0, sizeof(device->release_later));
+    LeaveCriticalSection(&device->lists_cs);
+    for (i = 0; i < ARRAY_SIZE(kept); ++i)
+        if (kept[i]) ID2D1CommandList_Release(&kept[i]->ID2D1CommandList_iface);
+}
+
 struct d2d_command_list *unsafe_impl_from_ID2D1CommandList(ID2D1CommandList *iface)
 {
     if (!iface)
diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index da05603..f17b793 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -676,6 +676,11 @@ struct d2d_device
     UINT64 max_texture_memory;
     UINT64 max_color_glyph_cache;
     D2D1_RENDERING_PRIORITY rendering_priority;
+
+    /* command lists other contexts made, kept a while (d2d_command_list_release_later) */
+    CRITICAL_SECTION lists_cs;
+    struct d2d_command_list *release_later[32];
+    unsigned int release_later_next;
 };
 
 struct d2d_device *unsafe_impl_from_ID2D1Device(ID2D1Device1 *iface);
@@ -997,10 +1002,14 @@ struct d2d_command_list
 
     /* the device context this is the target of */
     struct d2d_device_context *target_of;
+    /* the device context that created it (compared only, not referenced) */
+    struct d2d_device_context *creator;
 };
 
 HRESULT d2d_command_list_create(ID2D1Factory *factory, struct d2d_command_list **command_list);
 struct d2d_command_list *unsafe_impl_from_ID2D1CommandList(ID2D1CommandList *iface);
+void d2d_command_list_release_later(struct d2d_device *device, struct d2d_command_list *command_list);
+void d2d_command_list_release_kept(struct d2d_device *device);
 ID2D1CommandList *d2d_command_list_from_image(ID2D1Image *image);
 BOOL d2d_command_list_get_bounds(ID2D1CommandList *list, D2D1_RECT_F *bounds);
 HRESULT d2d_command_list_replay(ID2D1CommandList *list, ID2D1DeviceContext *context,
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index c1b9454..ef6637d 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -23,6 +23,8 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(d2d);
 
+static void d2d_device_context_release_target(struct d2d_device_context *context);
+
 #define INITIAL_CLIP_STACK_SIZE 4
 
 static const D2D1_MATRIX_3X2_F identity =
@@ -187,6 +189,16 @@ static void d2d_device_context_draw(struct d2d_device_context *render_target, en
     unsigned int offset;
     D3D11_VIEWPORT vp;
 
+    /* Stained Glass OS: a context with no bitmap target (none set, or a command list it did not
+     * make, refused) draws nothing; it had bound a NULL view. */
+#ifndef SG_MUTANT_D2D_DRAW_NO_TARGET
+    if (render_target->target.type != D2D_TARGET_BITMAP || !render_target->target.bitmap)
+    {
+        WARN("No bitmap target.\n");
+        return;
+    }
+#endif
+
     vp.TopLeftX = 0;
     vp.TopLeftY = 0;
     vp.Width = render_target->pixel_size.width;
@@ -364,8 +376,9 @@ static ULONG STDMETHODCALLTYPE d2d_device_context_inner_Release(IUnknown *iface)
         }
         if (context->d3d_state)
             ID3DDeviceContextState_Release(context->d3d_state);
+        /* the list it drew into does not point back to it any more */
         if (context->target.object)
-            IUnknown_Release(context->target.object);
+            d2d_device_context_release_target(context);
         ID3D11Device1_Release(context->d3d_device);
         ID2D1Factory_Release(context->factory);
         ID2D1Device6_Release(&context->device->ID2D1Device6_iface);
@@ -2897,7 +2910,10 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_CreateCommandList(ID2D1Devic
     TRACE("iface %p, command_list %p.\n", iface, command_list);
 
     if (SUCCEEDED(hr = d2d_command_list_create(context->factory, &object)))
+    {
+        object->creator = context;
         *command_list = &object->ID2D1CommandList_iface;
+    }
 
     return hr;
 }
@@ -3120,15 +3136,31 @@ static void STDMETHODCALLTYPE d2d_device_context_GetDevice(ID2D1DeviceContext6 *
     ID2D1Device_AddRef(*device);
 }
 
+/* Stained Glass OS: a command list another context made, once this context drew into it, is let
+ * go a while later (d2d_command_list_release_later): programs count on it outliving their own
+ * last Release. */
+static void d2d_device_context_release_target(struct d2d_device_context *context)
+{
+    if (context->target.type == D2D_TARGET_COMMAND_LIST)
+    {
+        struct d2d_command_list *list = context->target.command_list;
+
+        list->target_of = NULL;
+        if (list->creator != context && list->state != D2D_COMMAND_LIST_STATE_INITIAL)
+        {
+            d2d_command_list_release_later(context->device, list);
+            return;
+        }
+    }
+    IUnknown_Release(context->target.object);
+}
+
 void d2d_device_context_reset_target(struct d2d_device_context *context)
 {
     if (!context->target.object)
         return;
 
-    if (context->target.type == D2D_TARGET_COMMAND_LIST)
-        context->target.command_list->target_of = NULL;
-
-    IUnknown_Release(context->target.object);
+    d2d_device_context_release_target(context);
     memset(&context->target, 0, sizeof(context->target));
 
     /* Note that DPI settings are kept. */
@@ -3195,6 +3227,7 @@ static void STDMETHODCALLTYPE d2d_device_context_SetTarget(ID2D1DeviceContext6 *
     {
         command_list_impl = unsafe_impl_from_ID2D1CommandList(command_list);
 
+
         d2d_device_context_reset_target(context);
 
         context->target.command_list = command_list_impl;
@@ -3219,6 +3252,9 @@ static void STDMETHODCALLTYPE d2d_device_context_GetTarget(ID2D1DeviceContext6 *
     TRACE("iface %p, target %p.\n", iface, target);
 
     *target = context->target.object ? context->target.object : NULL;
+    /* as on Windows, a command list another context made does not read back as the target */
+    if (context->target.type == D2D_TARGET_COMMAND_LIST && context->target.command_list->creator != context)
+        *target = NULL;
     if (*target)
         ID2D1Image_AddRef(*target);
 }
@@ -5637,6 +5673,9 @@ static ULONG WINAPI d2d_device_Release(ID2D1Device6 *iface)
 
     if (!refcount)
     {
+        d2d_command_list_release_kept(device);
+        device->lists_cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&device->lists_cs);
         IDXGIDevice_Release(device->dxgi_device);
         ID2D1Factory1_Release(device->factory);
         d2d_device_indexed_objects_clear(&device->shaders);
@@ -5728,7 +5767,8 @@ static HRESULT WINAPI d2d_device_ClearResources(ID2D1Device6 *iface, UINT msec_s
 {
     TRACE("iface %p, msec_since_use %u.\n", iface, msec_since_use);
 
-    /* nothing is kept in caches that outlive a drawing operation */
+    /* the command lists kept a while are all that outlives a drawing operation */
+    d2d_command_list_release_kept(impl_from_ID2D1Device(iface));
     return S_OK;
 }
 
@@ -5940,6 +5980,8 @@ void d2d_device_init(struct d2d_device *device, struct d2d_factory *factory, IDX
 #endif
     device->max_color_glyph_cache = 4 * 1024 * 1024;
     device->rendering_priority = D2D1_RENDERING_PRIORITY_NORMAL;
+    InitializeCriticalSectionEx(&device->lists_cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    device->lists_cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": d2d_device.lists_cs");
 }
 
 HRESULT d2d_device_add_indexed_object(struct d2d_indexed_objects *objects,
