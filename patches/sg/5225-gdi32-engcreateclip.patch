From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] gdi32: EngCreateClip and EngDeleteClip

EngCreateClip returns a new trivial CLIPOBJ for the driver to fill in and
EngDeleteClip releases it, instead of both being stubs. CORE: integrator must
review (patches/notes/5225.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/gdi32/umpd.c b/dlls/gdi32/umpd.c
--- a/dlls/gdi32/umpd.c
+++ b/dlls/gdi32/umpd.c
@@ -742,16 +742,30 @@
     return 0;
 }
 
-LONG_PTR WINAPI EngDeleteClip( LONG_PTR a0 )
+/***********************************************************************
+ *           EngCreateClip    (GDI32.@)
+ *
+ * A CLIPOBJ for the driver to fill in: trivial clipping (DC_TRIVIAL) until the driver sets
+ * the complexity (and, for DC_RECT, the bounds) itself, as the documentation describes.
+ */
+CLIPOBJ * WINAPI EngCreateClip( void )
 {
-    FIXME( "not supported\n" );
-    return 0;
+    CLIPOBJ *clip = calloc( 1, sizeof(*clip) );
+
+    TRACE( "-> %p\n", clip );
+#ifdef SG_MUTANT_UMPD_CLIP
+    return NULL;
+#endif
+    return clip;
 }
 
-LONG_PTR WINAPI EngCreateClip( void )
+/***********************************************************************
+ *           EngDeleteClip    (GDI32.@)
+ */
+void WINAPI EngDeleteClip( CLIPOBJ *clip )
 {
-    FIXME( "not supported\n" );
-    return 0;
+    TRACE( "%p\n", clip );
+    free( clip );
 }
 
 static int __cdecl cmp_glyph( const void *a, const void *b )
