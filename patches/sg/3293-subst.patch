-#include "wine/debug.h"
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wincon.h"
+#include "winnls.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "winioctl.h"
+#define WINE_MOUNTMGR_EXTENSIONS
+#include "ddk/mountmgr.h"
+
+#include "subst.h"
+
+
+static void output( const WCHAR *str )
+{
+    DWORD count, mode;
+    HANDLE out = GetStdHandle( STD_OUTPUT_HANDLE );
+    int len = lstrlenW( str ), n;
+    char *buf;
+
+    if (!len) return;
+    if (GetConsoleMode( out, &mode ))
+    {
+        WriteConsoleW( out, str, len, &count, NULL );
+        return;
+    }
+    n = WideCharToMultiByte( GetOEMCP(), 0, str, len, NULL, 0, NULL, NULL );
+    if (!(buf = malloc( n ))) return;
+    WideCharToMultiByte( GetOEMCP(), 0, str, len, buf, n, NULL, NULL );
+    WriteFile( out, buf, n, &count, NULL );
+    free( buf );
+}
+
+/* print resource string id; the %1, %2 inserts are arg1 and arg2 */
+static void message( UINT id, const WCHAR *arg1, const WCHAR *arg2 )
+{
+    WCHAR fmt[1024], *text;
+    DWORD_PTR args[2] = { (DWORD_PTR)arg1, (DWORD_PTR)arg2 };
+
+    if (!LoadStringW( GetModuleHandleW( NULL ), id, fmt, ARRAY_SIZE(fmt) )) return;
+    if (!FormatMessageW( FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY | FORMAT_MESSAGE_ALLOCATE_BUFFER,
+                         fmt, 0, 0, (WCHAR *)&text, 0, (va_list *)args ))
+        return;
+    output( text );
+    LocalFree( text );
+}
+
+static BOOL is_drive_spec( const WCHAR *s )
+{
+    return ((s[0] >= 'A' && s[0] <= 'Z') || (s[0] >= 'a' && s[0] <= 'z')) && s[1] == ':' && !s[2];
+}
+
+/* A substitution is a drive mounted on the host directory of the path (so every program sees it)
+ * and recorded under HKCU\Software\Wine\Subst\<letter> with the DOS path it stands for. */
+static const WCHAR subst_key[] = L"Software\\Wine\\Subst";
+
+static BOOL drive_exists( const WCHAR *drive )
+{
+    WCHAR raw[MAX_PATH + 8];
+    return QueryDosDeviceW( drive, raw, ARRAY_SIZE(raw) ) != 0;
+}
+
+/* The DOS path a substituted drive stands for, or FALSE when the drive is not a substitution. */
+static BOOL get_subst_target( const WCHAR *drive, WCHAR *target, DWORD size )
+{
+    WCHAR name[2] = { drive[0], 0 };
+    DWORD type, len = size * sizeof(WCHAR);
+    HKEY key;
+    LSTATUS ret;
+
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, subst_key, 0, KEY_READ | KEY_WRITE, &key )) return FALSE;
+    ret = RegQueryValueExW( key, name, NULL, &type, (BYTE *)target, &len );
+    if (!ret && type == REG_SZ && drive_exists( drive ))
+    {
+        RegCloseKey( key );
+        return TRUE;
+    }
+    if (!ret) RegDeleteValueW( key, name );      /* the drive went away behind our back */
+    RegCloseKey( key );
+    return FALSE;
+}
+
+static void set_subst_record( const WCHAR *drive, const WCHAR *target )
+{
+    WCHAR name[2] = { drive[0], 0 };
+    HKEY key;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, subst_key, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL )) return;
+    if (target) RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)target, (lstrlenW( target ) + 1) * sizeof(WCHAR) );
+    else RegDeleteValueW( key, name );
+    RegCloseKey( key );
+}
 
-WINE_DEFAULT_DEBUG_CHANNEL(subst);
+/* mount (unix_path != NULL) or unmount a drive letter through the mount manager */
+static BOOL mount_drive( WCHAR letter, const char *unix_path )
+{
+    struct mountmgr_unix_drive *ioctl;
+    DWORD len = sizeof(*ioctl) + (unix_path ? strlen( unix_path ) + 1 : 0);
+    HANDLE mgr;
+    BOOL ret;
+
+    if ((mgr = CreateFileW( MOUNTMGR_DOS_DEVICE_NAME, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                            NULL, OPEN_EXISTING, 0, 0 )) == INVALID_HANDLE_VALUE) return FALSE;
+    if (!(ioctl = calloc( 1, len ))) { CloseHandle( mgr ); return FALSE; }
+    ioctl->size = len;
+    ioctl->letter = letter;
+    if (unix_path)
+    {
+        ioctl->type = DRIVE_FIXED;
+        strcpy( (char *)(ioctl + 1), unix_path );
+        ioctl->mount_point_offset = sizeof(*ioctl);
+    }
+    else ioctl->type = DRIVE_NO_ROOT_DIR;
+    ret = DeviceIoControl( mgr, IOCTL_MOUNTMGR_DEFINE_UNIX_DRIVE, ioctl, len, NULL, 0, NULL, NULL );
+    free( ioctl );
+    CloseHandle( mgr );
+    return ret;
+}
 
-int __cdecl wmain(int argc, WCHAR *argv[])
+static int list_substs(void)
 {
+    WCHAR drive[3] = L"A:", target[MAX_PATH + 8];
     int i;
 
-    WINE_FIXME("stub:");
-    for (i = 0; i < argc; i++)
-        WINE_FIXME(" %s", wine_dbgstr_w(argv[i]));
-    WINE_FIXME("\n");
+    for (i = 0; i < 26; i++)
+    {
+        drive[0] = 'A' + i;
+#ifdef SG_MUTANT_SUBST_LISTALL
+        if (drive_exists( drive ) && (get_subst_target( drive, target, ARRAY_SIZE(target) ) || lstrcpyW( target, L"?" ))) message( STRING_LISTING, drive, target );
+#else
+        if (get_subst_target( drive, target, ARRAY_SIZE(target) )) message( STRING_LISTING, drive, target );
+#endif
+    }
+    return 0;
+}
+
+static int remove_subst( const WCHAR *drive )
+{
+    WCHAR target[MAX_PATH + 8], dev[3];
+
+    dev[0] = towupper( drive[0] ); dev[1] = ':'; dev[2] = 0;
+    if (!is_drive_spec( drive ) || !get_subst_target( dev, target, ARRAY_SIZE(target) ))
+    {
+        message( STRING_INVALID_PARAMETER, drive, NULL );
+        return 1;
+    }
+    if (!mount_drive( dev[0], NULL ))
+    {
+        message( STRING_ACCESS_DENIED, drive, NULL );
+        return 1;
+    }
+    set_subst_record( dev, NULL );
+    return 0;
+}
+
+static int add_subst( const WCHAR *drive, const WCHAR *path )
+{
+    WCHAR dev[3], full[MAX_PATH], target[MAX_PATH + 8];
+    char *(CDECL *get_unix_file_name)( const WCHAR * );
+    char *unix_path;
+    DWORD attr, len;
+    BOOL ok;
+
+    if (!is_drive_spec( drive ))
+    {
+        message( STRING_INVALID_PARAMETER, drive, NULL );
+        return 1;
+    }
+    dev[0] = towupper( drive[0] ); dev[1] = ':'; dev[2] = 0;
+#ifdef SG_MUTANT_SUBST_ALREADY
+    if (0)
+#else
+    if (get_subst_target( dev, target, ARRAY_SIZE(target) ))
+#endif
+    {
+        message( STRING_ALREADY_SUBSTED, NULL, NULL );
+        return 1;
+    }
+#ifndef SG_MUTANT_SUBST_REAL
+    if (drive_exists( dev ))
+    {
+        message( STRING_INVALID_PARAMETER, drive, NULL );
+        return 1;
+    }
+#endif
+    len = GetFullPathNameW( path, ARRAY_SIZE(full), full, NULL );
+    if (!len || len >= ARRAY_SIZE(full) || full[1] != ':')
+    {
+        message( STRING_PATH_NOT_FOUND, path, NULL );
+        return 1;
+    }
+    /* a path on a substituted drive is recorded as the path it stands for */
+    {
+        WCHAR base[3] = { towupper( full[0] ), ':', 0 };
+#ifdef SG_MUTANT_SUBST_RESOLVE
+        if (0)
+#else
+        if (get_subst_target( base, target, ARRAY_SIZE(target) ))
+#endif
+        {
+            lstrcatW( target, full + 2 );
+            lstrcpynW( full, target, ARRAY_SIZE(full) );
+        }
+    }
+    attr = GetFileAttributesW( full );
+#ifdef SG_MUTANT_SUBST_PATHCHK
+    if (0)
+#else
+    if (attr == INVALID_FILE_ATTRIBUTES || !(attr & FILE_ATTRIBUTE_DIRECTORY))
+#endif
+    {
+        message( STRING_PATH_NOT_FOUND, path, NULL );
+        return 1;
+    }
+    len = lstrlenW( full );
+    if (len > 3 && full[len - 1] == '\\') full[len - 1] = 0;     /* "C:\dir\" is recorded as "C:\dir" */
 
+    get_unix_file_name = (void *)GetProcAddress( GetModuleHandleW( L"kernel32.dll" ), "wine_get_unix_file_name" );
+    if (!get_unix_file_name || !(unix_path = get_unix_file_name( full )))
+    {
+        message( STRING_PATH_NOT_FOUND, path, NULL );
+        return 1;
+    }
+    ok = mount_drive( dev[0], unix_path );
+    HeapFree( GetProcessHeap(), 0, unix_path );
+    if (!ok)
+    {
+        message( STRING_ACCESS_DENIED, drive, NULL );
+        return 1;
+    }
+    set_subst_record( dev, full );
     return 0;
 }
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    int i;
+
+    for (i = 1; i < argc; i++)
+        if (!wcscmp( argv[i], L"/?" ))
+        {
+            message( STRING_USAGE1, NULL, NULL );
+            message( STRING_USAGE2, NULL, NULL );
+            message( STRING_USAGE3, NULL, NULL );
+            message( STRING_USAGE4, NULL, NULL );
+            message( STRING_USAGE5, NULL, NULL );
+            message( STRING_USAGE6, NULL, NULL );
+            message( STRING_USAGE7, NULL, NULL );
+            message( STRING_USAGE8, NULL, NULL );
+            return 0;
+        }
+
+    if (argc == 1) return list_substs();
+
+#ifdef SG_MUTANT_SUBST_CASE
+    if (argc == 3 && !wcscmp( argv[2], L"/D" )) return remove_subst( argv[1] );
+#else
+    if (argc == 3 && !wcsicmp( argv[2], L"/D" )) return remove_subst( argv[1] );
+#endif
+    if (argc == 3 && !wcsicmp( argv[1], L"/D" )) return remove_subst( argv[2] );
+    if (argc == 3 && argv[1][0] != '/' && argv[2][0] != '/') return add_subst( argv[1], argv[2] );
+
+    message( STRING_INVALID_PARAMETER, argc > 1 ? argv[argc - 1] : L"", NULL );
+    return 1;
+}
