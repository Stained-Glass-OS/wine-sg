+#include "subst.h"
+
+LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
+
+STRINGTABLE
+{
+    STRING_USAGE1, "Associates a path with a drive letter.\n\n"
+    STRING_USAGE2, "SUBST [drive1: [drive2:]path]\n"
+    STRING_USAGE3, "SUBST drive1: /D\n\n"
+    STRING_USAGE4, "  drive1:        Specifies a virtual drive to which you want to assign a path.\n"
+    STRING_USAGE5, "  [drive2:]path  Specifies a physical drive and path that you want to assign to\n"
+    STRING_USAGE6, "                 a virtual drive.\n"
+    STRING_USAGE7, "  /D             Deletes a substituted (virtual) drive.\n\n"
+    STRING_USAGE8, "Type SUBST with no parameters to display a list of current virtual drives.\n"
+    STRING_INVALID_PARAMETER, "Invalid parameter - %1\n"
+    STRING_ALREADY_SUBSTED,   "Drive already SUBSTed\n"
+    STRING_PATH_NOT_FOUND,    "Path not found - %1\n"
+    STRING_LISTING,           "%1\\: => %2\n"
+    STRING_ACCESS_DENIED,     "Access denied - %1\n"
+}
