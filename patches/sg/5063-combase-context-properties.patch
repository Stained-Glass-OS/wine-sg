From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase: Implement context properties on the thread object context.

IContext SetProperty, GetProperty, RemoveProperty and EnumContextProps on the
object context of a thread keep a list of context properties (policy GUID,
flags, a reference to the property object); the context releases them when it
goes away. They returned E_NOTIMPL. Setting a GUID that is already there, and
getting or removing one that is not, fail with E_FAIL.

Gate: test/combase-ctxprops-gate.sh.
---
 dlls/combase/combase.c | 263 +++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 254 insertions(+), 9 deletions(-)

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index f270ebe..375718b 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -2648,8 +2648,21 @@ struct thread_context
     LONG refcount;
     DWORD tid;      /* the thread whose context this is */
     BOOL mta;       /* made in the MTA, whose threads share one context */
+    SRWLOCK props_lock;
+    ContextProperty *props;     /* IContext properties, each holding a reference */
+    ULONG props_count, props_size;
 };
 
+static void thread_context_free(struct thread_context *context)
+{
+    ULONG i;
+
+    for (i = 0; i < context->props_count; i++)
+        IUnknown_Release(context->props[i].pUnk);
+    free(context->props);
+    free(context);
+}
+
 static inline struct thread_context *impl_from_IComThreadingInfo(IComThreadingInfo *iface)
 {
     return CONTAINING_RECORD(iface, struct thread_context, IComThreadingInfo_iface);
@@ -2709,7 +2722,7 @@ static ULONG WINAPI thread_context_info_Release(IComThreadingInfo *iface)
        releasing context while refcount is at 0 destroys it. */
     if (!context->refcount)
     {
-        free(context);
+        thread_context_free(context);
         return 0;
     }
 
@@ -2864,32 +2877,264 @@ static ULONG WINAPI thread_object_context_Release(IObjContext *iface)
     return IComThreadingInfo_Release(&context->IComThreadingInfo_iface);
 }
 
+/* the index of a property in the context's list, or -1 */
+static int thread_context_find_prop(const struct thread_context *context, REFGUID propid)
+{
+    ULONG i;
+
+#ifdef SG_MUTANT_PROPS_LOST
+    return -1;
+#endif
+    for (i = 0; i < context->props_count; i++)
+        if (IsEqualGUID(&context->props[i].policyId, propid)) return i;
+    return -1;
+}
+
 static HRESULT WINAPI thread_object_context_SetProperty(IObjContext *iface, REFGUID propid, CPFLAGS flags, IUnknown *punk)
 {
-    FIXME("%p, %s, %lx, %p\n", iface, debugstr_guid(propid), flags, punk);
+    struct thread_context *context = impl_from_IObjContext(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p, %s, %lx, %p\n", iface, debugstr_guid(propid), flags, punk);
+
+    if (!propid || !punk)
+        return E_INVALIDARG;
+
+    AcquireSRWLockExclusive(&context->props_lock);
+    if (thread_context_find_prop(context, propid) >= 0)
+        hr = E_FAIL;
+    else if (context->props_count == context->props_size)
+    {
+        ULONG size = context->props_size ? context->props_size * 2 : 4;
+        ContextProperty *props = realloc(context->props, size * sizeof(*props));
+
+        if (!props) hr = E_OUTOFMEMORY;
+        else
+        {
+            context->props = props;
+            context->props_size = size;
+        }
+    }
+    if (hr == S_OK)
+    {
+        ContextProperty *prop = &context->props[context->props_count++];
+
+        prop->policyId = *propid;
+        prop->flags = flags;
+        prop->pUnk = punk;
+        IUnknown_AddRef(punk);
+    }
+    ReleaseSRWLockExclusive(&context->props_lock);
+    return hr;
 }
 
 static HRESULT WINAPI thread_object_context_RemoveProperty(IObjContext *iface, REFGUID propid)
 {
-    FIXME("%p, %s\n", iface, debugstr_guid(propid));
+    struct thread_context *context = impl_from_IObjContext(iface);
+    IUnknown *punk = NULL;
+    int i;
 
-    return E_NOTIMPL;
+    TRACE("%p, %s\n", iface, debugstr_guid(propid));
+
+    if (!propid)
+        return E_INVALIDARG;
+
+    AcquireSRWLockExclusive(&context->props_lock);
+    if ((i = thread_context_find_prop(context, propid)) >= 0)
+    {
+        punk = context->props[i].pUnk;
+        memmove(&context->props[i], &context->props[i + 1], (context->props_count - i - 1) * sizeof(*context->props));
+        context->props_count--;
+    }
+    ReleaseSRWLockExclusive(&context->props_lock);
+
+    if (!punk) return E_FAIL;
+    IUnknown_Release(punk);
+    return S_OK;
 }
 
 static HRESULT WINAPI thread_object_context_GetProperty(IObjContext *iface, REFGUID propid, CPFLAGS *flags, IUnknown **punk)
 {
-    FIXME("%p, %s, %p, %p\n", iface, debugstr_guid(propid), flags, punk);
+    struct thread_context *context = impl_from_IObjContext(iface);
+    HRESULT hr = E_FAIL;
+    int i;
 
-    return E_NOTIMPL;
+    TRACE("%p, %s, %p, %p\n", iface, debugstr_guid(propid), flags, punk);
+
+    if (!propid || !flags || !punk)
+        return E_INVALIDARG;
+
+    *punk = NULL;
+    AcquireSRWLockShared(&context->props_lock);
+    if ((i = thread_context_find_prop(context, propid)) >= 0)
+    {
+        *flags = context->props[i].flags;
+        *punk = context->props[i].pUnk;
+        IUnknown_AddRef(*punk);
+        hr = S_OK;
+    }
+    ReleaseSRWLockShared(&context->props_lock);
+    return hr;
+}
+
+/* IEnumContextProps: a copy of a context's properties taken when it is made */
+struct context_props_enum
+{
+    IEnumContextProps IEnumContextProps_iface;
+    LONG refcount;
+    ContextProperty *props;
+    ULONG count, pos;
+};
+
+static inline struct context_props_enum *impl_from_IEnumContextProps(IEnumContextProps *iface)
+{
+    return CONTAINING_RECORD(iface, struct context_props_enum, IEnumContextProps_iface);
+}
+
+static HRESULT context_props_enum_create(const ContextProperty *props, ULONG count, ULONG pos, IEnumContextProps **out);
+
+static HRESULT WINAPI context_props_enum_QueryInterface(IEnumContextProps *iface, REFIID riid, void **obj)
+{
+    TRACE("%p, %s, %p\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualIID(riid, &IID_IEnumContextProps) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IEnumContextProps_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI context_props_enum_AddRef(IEnumContextProps *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumContextProps(iface)->refcount);
+}
+
+static ULONG WINAPI context_props_enum_Release(IEnumContextProps *iface)
+{
+    struct context_props_enum *props = impl_from_IEnumContextProps(iface);
+    ULONG refcount = InterlockedDecrement(&props->refcount), i;
+
+    if (!refcount)
+    {
+        for (i = 0; i < props->count; i++) IUnknown_Release(props->props[i].pUnk);
+        free(props->props);
+        free(props);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI context_props_enum_Next(IEnumContextProps *iface, ULONG count, ContextProperty *out, ULONG *fetched)
+{
+    struct context_props_enum *props = impl_from_IEnumContextProps(iface);
+    ULONG n = 0;
+
+    TRACE("%p, %lu, %p, %p\n", iface, count, out, fetched);
+
+    if (!out || (count > 1 && !fetched))
+        return E_INVALIDARG;
+
+    while (n < count && props->pos < props->count)
+    {
+        out[n] = props->props[props->pos++];
+        IUnknown_AddRef(out[n].pUnk);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI context_props_enum_Skip(IEnumContextProps *iface, ULONG count)
+{
+    struct context_props_enum *props = impl_from_IEnumContextProps(iface);
+    ULONG left = props->count - props->pos;
+
+    TRACE("%p, %lu\n", iface, count);
+
+    props->pos += min(count, left);
+    return count <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI context_props_enum_Reset(IEnumContextProps *iface)
+{
+    TRACE("%p\n", iface);
+
+    impl_from_IEnumContextProps(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI context_props_enum_Clone(IEnumContextProps *iface, IEnumContextProps **out)
+{
+    struct context_props_enum *props = impl_from_IEnumContextProps(iface);
+
+    TRACE("%p, %p\n", iface, out);
+
+    if (!out) return E_INVALIDARG;
+    return context_props_enum_create(props->props, props->count, props->pos, out);
+}
+
+static HRESULT WINAPI context_props_enum_Count(IEnumContextProps *iface, ULONG *count)
+{
+    TRACE("%p, %p\n", iface, count);
+
+    if (!count) return E_INVALIDARG;
+    *count = impl_from_IEnumContextProps(iface)->count;
+    return S_OK;
+}
+
+static const IEnumContextPropsVtbl context_props_enum_vtbl =
+{
+    context_props_enum_QueryInterface,
+    context_props_enum_AddRef,
+    context_props_enum_Release,
+    context_props_enum_Next,
+    context_props_enum_Skip,
+    context_props_enum_Reset,
+    context_props_enum_Clone,
+    context_props_enum_Count,
+};
+
+static HRESULT context_props_enum_create(const ContextProperty *props, ULONG count, ULONG pos, IEnumContextProps **out)
+{
+    struct context_props_enum *object;
+    ULONG i;
+
+    *out = NULL;
+    if (!(object = calloc(1, sizeof(*object)))) return E_OUTOFMEMORY;
+    if (count && !(object->props = malloc(count * sizeof(*props))))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    object->IEnumContextProps_iface.lpVtbl = &context_props_enum_vtbl;
+    object->refcount = 1;
+    object->count = count;
+    object->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        object->props[i] = props[i];
+        IUnknown_AddRef(object->props[i].pUnk);
+    }
+    *out = &object->IEnumContextProps_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI thread_object_context_EnumContextProps(IObjContext *iface, IEnumContextProps **props)
 {
-    FIXME("%p, %p\n", iface, props);
+    struct thread_context *context = impl_from_IObjContext(iface);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p\n", iface, props);
+
+    if (!props)
+        return E_INVALIDARG;
+
+    AcquireSRWLockShared(&context->props_lock);
+    hr = context_props_enum_create(context->props, context->props_count, 0, props);
+    ReleaseSRWLockShared(&context->props_lock);
+    return hr;
 }
 
 static void WINAPI thread_object_context_Reserved1(IObjContext *iface)
