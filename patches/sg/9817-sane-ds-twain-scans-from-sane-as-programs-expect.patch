From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 02:13:51 -0800
Subject: [PATCH] sane.ds: TWAIN scans from SANE as programs expect -- whole strips in place, one page from a flatbed, interleaved RGB, fixed-point resolutions (9817)

Scanning through TWAIN from SANE (sane.ds), as NAPS2 and IrfanView scan,
went wrong four ways:

- A memory transfer's strip claimed a full buffer's rows and sat at row 0:
  the last, short strip said more rows than its bytes, so NAPS2 stopped
  with "Source byte array length is less than expected" and no page. The
  strip's rows are now the whole rows it holds, below the strips before
  (YOffset).
- After a page, sane.ds started the device again for the next: on a
  flatbed that scans the glass again, page after page without end. A
  flatbed gives one page per scan, as a Windows TWAIN driver's does; only a
  document feeder (its SANE "source" names one) goes on until it is empty.
- ImageInfo said an RGB page was planar; SANE's RGB frame is interleaved
  per pixel (TWAIN's chunky), so programs that heed the flag unpicked it as
  three planes.
- "resolution" (and x-/y-resolution) given as SANE_TYPE_FIXED, as the test
  device, plustek and snapscan give it, could not be read or set: every
  scan came at the device's default resolution whatever the program asked.
  Fixed-point number options are read and set in whole units, their
  constraints too.

Gate test/twainscan-gate.sh (more checks).

--- a/dlls/sane.ds/ds_ctrl.c
+++ b/dlls/sane.ds/ds_ctrl.c
@@ -17,6 +17,8 @@
  */
 
 #include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
 #include "sane_i.h"
 #include "wine/debug.h"
 
@@ -191,6 +193,20 @@
 }
 
 /* DG_CONTROL/DAT_PENDINGXFERS/MSG_ENDXFER */
+/* the scan source is a document feeder (its SANE "source" names one) */
+static BOOL source_is_feeder(void)
+{
+    static const char *const feeder[] = { "adf", "feeder", "duplex", "auto" };
+    char source[64] = "", lower[64];
+    unsigned int i;
+
+    if (sane_option_get_str("source", source, sizeof(source)) != TWCC_SUCCESS) return FALSE;
+    for (i = 0; source[i] && i < sizeof(lower) - 1; i++) lower[i] = tolower((unsigned char)source[i]);
+    lower[i] = 0;
+    for (i = 0; i < ARRAY_SIZE(feeder); i++) if (strstr(lower, feeder[i])) return TRUE;
+    return FALSE;
+}
+
 TW_UINT16 SANE_PendingXfersEndXfer (pTW_IDENTITY pOrigin, 
                                      TW_MEMREF pData)
 {
@@ -208,6 +224,18 @@
     {
         pPendingXfers->Count = -1;
         activeDS.currentState = 6;
+#ifndef SG_MUTANT_TWAIN_FLATBED_LOOPS
+        /* Stained Glass OS (9817): a flatbed gives one page per scan, as a Windows TWAIN driver's does;
+         * starting the device again scanned the glass again, page after page, without end (NAPS2,
+         * IrfanView). Only a document feeder has more pages, until it says it has none. */
+        if (!source_is_feeder())
+        {
+            pPendingXfers->Count = 0;
+            activeDS.currentState = 5;
+            SANE_Notify(MSG_CLOSEDSREQ);
+        }
+        else
+#endif
         if (SANE_CALL( start_device, NULL ))
         {
             pPendingXfers->Count = 0;
--- a/dlls/sane.ds/ds_image.c
+++ b/dlls/sane.ds/ds_image.c
@@ -73,7 +73,14 @@
         case FMT_RGB:
             pImageInfo->BitsPerPixel = activeDS.frame_params.depth * 3;
             pImageInfo->Compression = TWCP_NONE;
+#ifndef SG_MUTANT_TWAIN_PLANAR
+            /* Stained Glass OS (9817): SANE's RGB frame is one plane, red, green and blue interleaved
+             * per pixel (TWAIN's chunky); "planar" had programs that heed it unpick the bytes as three
+             * planes -- NAPS2's page came out as coloured stripes */
+            pImageInfo->Planar = FALSE;
+#else
             pImageInfo->Planar = TRUE;
+#endif
             pImageInfo->SamplesPerPixel = 3;
             pImageInfo->BitsPerSample[0] = activeDS.frame_params.depth;
             pImageInfo->BitsPerSample[1] = activeDS.frame_params.depth;
@@ -83,7 +90,7 @@
         case FMT_GRAY:
             pImageInfo->BitsPerPixel = activeDS.frame_params.depth;
             pImageInfo->Compression = TWCP_NONE;
-            pImageInfo->Planar = TRUE;
+            pImageInfo->Planar = FALSE;
             pImageInfo->SamplesPerPixel = 1;
             pImageInfo->BitsPerSample[0] = activeDS.frame_params.depth;
             if (activeDS.frame_params.depth == 1)
@@ -227,6 +234,7 @@
               activeDS.frame_params.last_frame);
 
             activeDS.currentState = 7;
+            activeDS.memxfer_rows = 0;
         }
 
         /* access memory buffer */
@@ -259,10 +267,21 @@
             pImageMemXfer->Compression = TWCP_NONE;
             pImageMemXfer->BytesPerRow = activeDS.frame_params.bytes_per_line;
             pImageMemXfer->Columns = activeDS.frame_params.pixels_per_line;
+#ifndef SG_MUTANT_TWAIN_MEMXFER_ROWS
+            /* Stained Glass OS (9817): the strip's rows are the ones written (the last strip is short:
+             * it claimed a full buffer's rows, more than its bytes -- NAPS2 "Source byte array length is
+             * less than expected", no page), and it lies below the strips already given */
+            pImageMemXfer->Rows = retlen / activeDS.frame_params.bytes_per_line;
+            pImageMemXfer->XOffset = 0;
+            pImageMemXfer->YOffset = activeDS.memxfer_rows;
+            pImageMemXfer->BytesWritten = pImageMemXfer->Rows * activeDS.frame_params.bytes_per_line;
+            activeDS.memxfer_rows += pImageMemXfer->Rows;
+#else
             pImageMemXfer->Rows = rows;
             pImageMemXfer->XOffset = 0;
             pImageMemXfer->YOffset = 0;
             pImageMemXfer->BytesWritten = retlen;
+#endif
 
             ScanningDialogBox(activeDS.progressWnd, retlen);
 
--- a/dlls/sane.ds/options.c
+++ b/dlls/sane.ds/options.c
@@ -46,23 +46,37 @@
     return SANE_CALL( option_find_descriptor, &params ) ? TWCC_CAPUNSUPPORTED : TWCC_SUCCESS;
 }
 
+/* Stained Glass OS (9817): a number option is SANE_TYPE_INT or SANE_TYPE_FIXED: many backends (the
+ * test device, plustek, snapscan...) give "resolution" as fixed point, and it could not be read or
+ * set -- every scan came at the device's default resolution, whatever the program asked for */
+static TW_UINT16 sane_find_number_option( const char *name, struct option_descriptor *opt )
+{
+    TW_UINT16 rc = sane_find_option( name, TYPE_INT, opt );
+#ifndef SG_MUTANT_TWAIN_NO_FIXED
+    if (rc != TWCC_SUCCESS) rc = sane_find_option( name, TYPE_FIXED, opt );
+#endif
+    return rc;
+}
+
 TW_UINT16 sane_option_get_int(const char *option_name, int *val)
 {
     struct option_descriptor opt;
-    TW_UINT16 rc = sane_find_option(option_name, TYPE_INT, &opt);
+    TW_UINT16 rc = sane_find_number_option(option_name, &opt);
 
     if (rc == TWCC_SUCCESS) rc = sane_option_get_value( opt.optno, val );
+    if (rc == TWCC_SUCCESS && opt.type == TYPE_FIXED) *val = (*val + 0x8000) >> 16;
     return rc;
 }
 
 TW_UINT16 sane_option_set_int(const char *option_name, int val, BOOL *needs_reload )
 {
     struct option_descriptor opt;
-    TW_UINT16 rc = sane_find_option(option_name, TYPE_INT, &opt);
-    if (!opt.is_settable) return TWCC_OPERATIONERROR;
+    TW_UINT16 rc = sane_find_number_option(option_name, &opt);
 
-    if (rc == TWCC_SUCCESS) rc = sane_option_set_value( opt.optno, &val, needs_reload );
-    return rc;
+    if (rc != TWCC_SUCCESS) return rc;
+    if (!opt.is_settable) return TWCC_OPERATIONERROR;
+    if (opt.type == TYPE_FIXED) val <<= 16;
+    return sane_option_set_value( opt.optno, &val, needs_reload );
 }
 
 TW_UINT16 sane_option_get_bool(const char *option_name, int *val)
@@ -112,7 +126,23 @@
 
 TW_UINT16 sane_option_probe_resolution(const char *option_name, struct option_descriptor *opt)
 {
-    return sane_find_option(option_name, TYPE_INT, opt);
+    TW_UINT16 rc = sane_find_number_option(option_name, opt);
+    int i;
+
+    /* a fixed-point option's constraint, in whole units as an integer option's is */
+    if (rc == TWCC_SUCCESS && opt->type == TYPE_FIXED)
+    {
+        if (opt->constraint_type == CONSTRAINT_RANGE)
+        {
+            opt->constraint.range.min = (opt->constraint.range.min + 0x8000) >> 16;
+            opt->constraint.range.max = (opt->constraint.range.max + 0x8000) >> 16;
+            opt->constraint.range.quant = (opt->constraint.range.quant + 0x8000) >> 16;
+        }
+        else if (opt->constraint_type == CONSTRAINT_WORD_LIST)
+            for (i = 1; i <= opt->constraint.word_list[0] && i < ARRAY_SIZE(opt->constraint.word_list); i++)
+                opt->constraint.word_list[i] = (opt->constraint.word_list[i] + 0x8000) >> 16;
+    }
+    return rc;
 }
 
 static TW_UINT32 sane_categorize_value(const WCHAR* value, const WCHAR* const* filter[], char* categories, int buf_len)
--- a/dlls/sane.ds/sane_i.h
+++ b/dlls/sane.ds/sane_i.h
@@ -42,6 +42,7 @@
     HWND		progressWnd;		/* window handle of the scanning window */
 
     struct frame_parameters frame_params;       /* parameters about the image transferred */
+    TW_UINT32           memxfer_rows;           /* Stained Glass OS (9817): rows a memory transfer has given */
 
     /* Capabilities */
     TW_UINT16		capXferMech;		/* ICAP_XFERMECH */
