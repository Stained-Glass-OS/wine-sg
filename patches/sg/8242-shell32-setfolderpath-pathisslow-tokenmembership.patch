From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHSetFolderPathA/W, PathIsSlowA/W, SHTestTokenMembership

SHSetFolderPathA/W (ordinals 231/232) set a CSIDL folder's path through SHSetKnownFolderPath (the CSIDL flags ignored, fixed and unknown folders E_INVALIDARG). PathIsSlowA/W (239/240) say whether reaching a file is high-latency: an offline file (by the given attributes, or the file's for -1). SHTestTokenMembership (245) checks a token's membership of the built-in local group of a RID. They were spec stubs.
---
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -4964,3 +4964,92 @@
         register_system_knownfolders();
     return hr;
 }
+
+
+#ifndef SG_MUTANT_NO_SH32_SMALL
+/*************************************************************************
+ * SHSetFolderPathW			[SHELL32.232]
+ *
+ * (wine-sg 8242) The path of a CSIDL folder, as SHSetKnownFolderPath sets a known folder's.
+ */
+HRESULT WINAPI SHSetFolderPathW( int csidl, HANDLE token, DWORD flags, const WCHAR *path )
+{
+    int folder = csidl & ~CSIDL_FLAG_MASK;
+
+    TRACE( "%#x, %p, %#lx, %s\n", csidl, token, flags, debugstr_w(path) );
+
+    if (folder < 0 || folder >= ARRAY_SIZE(CSIDL_Data) || !CSIDL_Data[folder].id) return E_INVALIDARG;
+    return SHSetKnownFolderPath( CSIDL_Data[folder].id, flags, token, path );
+}
+
+/*************************************************************************
+ * SHSetFolderPathA			[SHELL32.231]
+ */
+HRESULT WINAPI SHSetFolderPathA( int csidl, HANDLE token, DWORD flags, const char *path )
+{
+    WCHAR *pathW = NULL;
+    HRESULT hr;
+    int len;
+
+    if (path)
+    {
+        len = MultiByteToWideChar( CP_ACP, 0, path, -1, NULL, 0 );
+        if (!(pathW = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        MultiByteToWideChar( CP_ACP, 0, path, -1, pathW, len );
+    }
+    hr = SHSetFolderPathW( csidl, token, flags, pathW );
+    free( pathW );
+    return hr;
+}
+
+/*************************************************************************
+ * PathIsSlowW			[SHELL32.239]
+ *
+ * Whether reaching a file is high-latency: a file that is offline (its attributes say so -- the given ones, or
+ * the file's when dwAttr is -1). Network paths are not judged slow here (GUESS: SG's shares are local network).
+ */
+BOOL WINAPI PathIsSlowW( const WCHAR *path, DWORD attr )
+{
+    TRACE( "%s, %#lx\n", debugstr_w(path), attr );
+
+    if (!path) return FALSE;
+    if (attr == INVALID_FILE_ATTRIBUTES) attr = GetFileAttributesW( path );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_OFFLINE);
+}
+
+/*************************************************************************
+ * PathIsSlowA			[SHELL32.240]
+ */
+BOOL WINAPI PathIsSlowA( const char *path, DWORD attr )
+{
+    WCHAR pathW[MAX_PATH];
+
+    if (!path || !MultiByteToWideChar( CP_ACP, 0, path, -1, pathW, MAX_PATH )) return FALSE;
+    return PathIsSlowW( pathW, attr );
+}
+
+/*************************************************************************
+ * SHTestTokenMembership			[SHELL32.245]
+ *
+ * Whether a token (the thread's or process's for NULL) is a member of the built-in local group of the RID.
+ */
+BOOL WINAPI SHTestTokenMembership( HANDLE token, ULONG rid )
+{
+    SID_IDENTIFIER_AUTHORITY nt = { SECURITY_NT_AUTHORITY };
+    BOOL member = FALSE;
+    PSID sid;
+
+    TRACE( "%p, %lu\n", token, rid );
+
+    if (!AllocateAndInitializeSid( &nt, 2, SECURITY_BUILTIN_DOMAIN_RID, rid, 0, 0, 0, 0, 0, 0, &sid )) return FALSE;
+    if (!CheckTokenMembership( token, sid, &member )) member = FALSE;
+    FreeSid( sid );
+    return member;
+}
+#else
+HRESULT WINAPI SHSetFolderPathW( int csidl, HANDLE token, DWORD flags, const WCHAR *path ) { return E_NOTIMPL; }
+HRESULT WINAPI SHSetFolderPathA( int csidl, HANDLE token, DWORD flags, const char *path ) { return E_NOTIMPL; }
+BOOL WINAPI PathIsSlowW( const WCHAR *path, DWORD attr ) { return FALSE; }
+BOOL WINAPI PathIsSlowA( const char *path, DWORD attr ) { return FALSE; }
+BOOL WINAPI SHTestTokenMembership( HANDLE token, ULONG rid ) { return FALSE; }
+#endif
