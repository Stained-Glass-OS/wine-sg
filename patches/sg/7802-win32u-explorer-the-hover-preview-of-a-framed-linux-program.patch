From: Stained Glass OS <ke7oxh@gmail.com>
Subject: win32u, winex11, explorer: the taskbar's hover preview of a framed Linux program shows it; a right-click puts the preview away

David (2026-11-15): hovering a framed Linux program's taskbar button showed
a black preview, while Alt+Tab and Task View showed the window; and the
preview stayed up over the button's right-click menu, so Close was hard to
reach.

The taskbar takes PrintWindow(PW_RENDERFULLCONTENT) of the window. For its
own process's windows that was WM_PRINT, which cannot draw the program's X
window inside explorer's frame. The frame is now marked by sg_embed.c, and
PrintWindow takes its picture as another process's window's (6501): its
surface, and from X the part the surface leaves to the program -- covered or
not under the desktop compositor, where visible otherwise.

A hover asked for by the pointer's last move fired inside the menu's loop
and showed the preview again over the menu. Thumbnails are not shown (and
are put away) while the thread is in menu mode, and a click on a button
cancels a pending hover.

Gate: test/embedthumb-gate.sh (make test-embedthumb), a framed stand-in X
program: its hover preview has its colour; a right-click shows the menu and
no preview, at once and 3 s later. Mutants SG_MUTANT_PRINT_EMBED_BLACK and
SG_MUTANT_THUMB_OVER_MENU each fail it.
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 7b8eed4..85d4e18 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -2618,6 +2618,19 @@ BOOL WINAPI NtUserPrintWindow( HWND hwnd, HDC hdc, UINT flags )
 {
     UINT prf_flags = PRF_CHILDREN | PRF_ERASEBKGND | PRF_OWNED | PRF_CLIENT;
     if (!is_current_process_window( hwnd )) return print_other_process_window( hwnd, hdc, flags );
+#ifndef SG_MUTANT_PRINT_EMBED_BLACK
+    /* Stained Glass OS: a window of ours holding another program's X window
+     * (winex11's sg_embed.c: the taskbar's frame round a Linux program) shows
+     * what WM_PRINT cannot draw; its picture is taken as another process's
+     * window's is -- its surface, and from X what the driver has there. The
+     * taskbar's hover preview of a framed Linux program was black (David
+     * 2026-11-15). */
+    {
+        static const WCHAR x_child_prop[] = {'_','_','w','i','n','e','_','s','g','_','x','_','c','h','i','l','d',0};
+        if ((flags & PW_RENDERFULLCONTENT) && NtUserGetProp( hwnd, x_child_prop ))
+            return print_other_process_window( hwnd, hdc, flags );
+    }
+#endif
     if (!(flags & PW_CLIENTONLY)) prf_flags |= PRF_NONCLIENT;
     send_message( hwnd, WM_PRINT, (WPARAM)hdc, prf_flags );
     return TRUE;
diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
index dae0fc0..6424fed 100644
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -799,6 +799,12 @@ LRESULT sg_embed_attach( HWND hwnd, Window child )
     XFlush( data->display );
     TRACE( "%p: %lx embedded in %lx at %d,%d %dx%d\n", hwnd, child, data->whole_window, x, y, w, h );
     release_win_data( data );
+    /* its picture (PrintWindow: the taskbar's hover preview) is taken from X
+     * (win32u dce.c, vulkan.c print_window_frames) */
+    {
+        static const WCHAR x_child_prop[] = {'_','_','w','i','n','e','_','s','g','_','x','_','c','h','i','l','d',0};
+        NtUserSetProp( hwnd, x_child_prop, (HANDLE)1 );
+    }
     return 1;
 }
 
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
index 0dc5535..20f5435 100644
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -2584,6 +2584,21 @@ static void sg_show_thumbnails( HWND button )
     UINT n = 0, j;
 
     if (!win || win->xwin) return;
+#ifndef SG_MUTANT_THUMB_OVER_MENU
+    {
+        /* Stained Glass OS: not while a menu is up -- a button's right-click
+         * menu or jump list (David 2026-11-15: the preview stayed over it,
+         * Close was hard to reach): the pointer resting on the button while
+         * the menu was open brought it back over the menu, as on Windows it
+         * never comes */
+        GUITHREADINFO info = { sizeof(info) };
+        if (GetGUIThreadInfo( GetCurrentThreadId(), &info ) && (info.flags & GUI_INMENUMODE))
+        {
+            sg_hide_thumbnails();
+            return;
+        }
+    }
+#endif
     leader = win->group ? win->group : win;
     if (sg_thumb_popup && sg_thumb_button_for == button) return;
     sg_hide_thumbnails();
@@ -2744,6 +2759,16 @@ static void sg_thumb_hover( HWND button, UINT msg )
     case WM_LBUTTONDOWN:
     case WM_RBUTTONDOWN:
         sg_hide_thumbnails();
+#ifndef SG_MUTANT_THUMB_OVER_MENU
+        {
+            /* and no hover pending from before the click: it fired with the
+             * click's menu up */
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_HOVER | TME_CANCEL, button, 0 };
+            TrackMouseEvent( &tme );
+            RemovePropW( button, L"sg_tracking" );
+            KillTimer( tray_window, SG_THUMB_RESHOW_TIMER );
+        }
+#endif
         break;
     }
 }
