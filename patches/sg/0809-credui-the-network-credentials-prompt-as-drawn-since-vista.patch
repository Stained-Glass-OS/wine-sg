From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] credui: the network credentials prompt as drawn since Vista

CredUIPromptForCredentials -- a mapped drive's or a proxy's password, an
installer that asks for a share's -- showed Windows 2000's form: a banner
bitmap across the top, "User name:" and "Password:" labels beside short
fields, on the grey dialog colour. It is now drawn as people know it: a
heading "Enter network credentials" in a larger face, "Enter your
credentials to connect to: <target>", full-width user name and password
fields labelled by cue banners, "Remember my credentials", OK and Cancel,
on the window colour. The cue banners are comctl32 v6's: credui carries a
manifest naming Common Controls 6 and activates it around the dialog, as
comdlg32 does. An application's banner bitmap is no longer shown.

Test: test/credui-look-gate.sh with test/credui-look-probe.c (mutants
SG_MUTANT_CREDUI_V5, SG_MUTANT_CREDUI_GREY).
---
--- a/dlls/credui/Makefile.in
+++ b/dlls/credui/Makefile.in
@@ -1,7 +1,7 @@
 EXTRADEFS = -D_CREDUI_
 MODULE    = credui.dll
 IMPORTLIB = credui
-IMPORTS   = comctl32 user32 advapi32
+IMPORTS   = comctl32 user32 gdi32 advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
--- a/dlls/credui/credui.manifest
+++ b/dlls/credui/credui.manifest
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
+<assemblyIdentity type="win32" name="Microsoft.Windows.CredUI" version="0.0.0.0"/>
+<dependency>
+    <dependentAssembly>
+        <assemblyIdentity
+            type="win32"
+            name="Microsoft.Windows.Common-Controls"
+            version="6.0.0.0"
+            processorArchitecture="*"
+            publicKeyToken="6595b64144ccf1df"
+            language="*"
+        />
+    </dependentAssembly>
+</dependency>
+</assembly>
--- a/dlls/credui/credui.rc
+++ b/dlls/credui/credui.rc
@@ -27,32 +27,35 @@
 STRINGTABLE
 {
     IDS_TITLEFORMAT     "Connect to %s"
-    IDS_MESSAGEFORMAT   "Connecting to %s"
+    IDS_MESSAGEFORMAT   "Enter your credentials to connect to: %s"
+    IDS_HEADER          "Enter network credentials"
+    IDS_CUEUSERNAME     "User name"
+    IDS_CUEPASSWORD     "Password"
     IDS_INCORRECTPASSWORDTITLE  "Logon unsuccessful"
     IDS_INCORRECTPASSWORD       "Make sure that your user name\nand password are correct."
     IDS_CAPSLOCKONTITLE "Caps Lock is On"
     IDS_CAPSLOCKON      "Having Caps Lock on may cause you to enter your password incorrectly.\n\nPress the Caps Lock key on your keyboard to turn off Caps Lock before\nentering your password."
 }
 
-IDD_CREDDIALOG DIALOG  0, 0, 213, 149
-STYLE DS_MODALFRAME | DS_NOIDLEMSG | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
-FONT 8, "MS Shell Dlg"
+IDD_CREDDIALOG DIALOGEX  0, 0, 240, 150
+STYLE DS_MODALFRAME | DS_NOIDLEMSG | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
+FONT 9, "Segoe UI"
 BEGIN
-    CONTROL         IDB_BANNER,-1,"Static",SS_BITMAP | SS_CENTERIMAGE,0,
-                    0,213,37
-    LTEXT           "",IDC_MESSAGE,8,48,199,8,NOT WS_GROUP
-    LTEXT           "&User name:",-1,8,62,72,12,SS_CENTERIMAGE
+    LTEXT           "",IDC_HEADER,12,10,216,16,NOT WS_GROUP
+    LTEXT           "",IDC_MESSAGE,12,30,216,18,NOT WS_GROUP
     CONTROL         "",IDC_USERNAME,"ComboBoxEx32",CBS_DROPDOWN |
-                    CBS_NOINTEGRALHEIGHT | WS_TABSTOP,80,62,126,87
-    LTEXT           "&Password:",-1,8,80,72,12,SS_CENTERIMAGE
-    EDITTEXT        IDC_PASSWORD,80,80,126,12,ES_PASSWORD | ES_AUTOHSCROLL
-    CONTROL         "&Remember my password",IDC_SAVE,"Button",
-                    BS_AUTOCHECKBOX | WS_TABSTOP,80,98,126,12
-    DEFPUSHBUTTON   "OK",IDOK,97,128,50,14
-    PUSHBUTTON      "Cancel",IDCANCEL,156,128,50,14
+                    CBS_NOINTEGRALHEIGHT | WS_TABSTOP,12,54,216,87
+    EDITTEXT        IDC_PASSWORD,12,74,216,14,ES_PASSWORD | ES_AUTOHSCROLL
+    CONTROL         "&Remember my credentials",IDC_SAVE,"Button",
+                    BS_AUTOCHECKBOX | WS_TABSTOP,12,96,216,12
+    DEFPUSHBUTTON   "OK",IDOK,118,126,52,14
+    PUSHBUTTON      "Cancel",IDCANCEL,176,126,52,14
 END
 
 LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
 
 /* @makedep: banner.bmp */
 IDB_BANNER BITMAP banner.bmp
+
+/* @makedep: credui.manifest */
+123 RT_MANIFEST credui.manifest
--- a/dlls/credui/credui_main.c
+++ b/dlls/credui/credui_main.c
@@ -63,6 +63,9 @@
 };
 static CRITICAL_SECTION csPendingCredentials = { &critsect_debug, -1, 0, 0, 0, 0 };
 
+/* comctl32 v6 for the dialog: cue banners in the user name and password */
+static HANDLE credui_actctx = INVALID_HANDLE_VALUE;
+
 
 BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
 {
@@ -75,6 +78,19 @@
         DisableThreadLibraryCalls(hinstDLL);
         hinstCredUI = hinstDLL;
         InitCommonControls();
+#ifndef SG_MUTANT_CREDUI_V5
+        {
+            ACTCTXW actctx = {0};
+
+            actctx.cbSize = sizeof(actctx);
+            actctx.hModule = hinstDLL;
+            actctx.lpResourceName = MAKEINTRESOURCEW(123);
+            actctx.dwFlags = ACTCTX_FLAG_HMODULE_VALID | ACTCTX_FLAG_RESOURCE_NAME_VALID;
+            credui_actctx = CreateActCtxW(&actctx);
+            if (credui_actctx == INVALID_HANDLE_VALUE)
+                ERR("failed to create activation context, last error %lu\n", GetLastError());
+        }
+#endif
         break;
 
     case DLL_PROCESS_DETACH:
@@ -90,6 +106,7 @@
             HeapFree(GetProcessHeap(), 0, entry);
         }
         DeleteCriticalSection(&csPendingCredentials);
+        if (credui_actctx != INVALID_HANDLE_VALUE) ReleaseActCtx(credui_actctx);
         break;
     }
 
@@ -139,6 +156,7 @@
     DWORD dwFlags;
     HWND hwndBalloonTip;
     BOOL fBalloonTipActive;
+    HFONT hfontHeader;
 };
 
 static void CredDialogFillUsernameCombo(HWND hwndUsername, const struct cred_dialog_params *params)
@@ -374,11 +392,29 @@
     HWND hwndUsername = GetDlgItem(hwndDlg, IDC_USERNAME);
     HWND hwndPassword = GetDlgItem(hwndDlg, IDC_PASSWORD);
 
+    WCHAR cue[64];
+    HWND hwndUserEdit;
+    LOGFONTW lf;
+
     SetWindowLongPtrW(hwndDlg, DWLP_USER, (LONG_PTR)params);
 
-    if (params->hbmBanner)
-        SendMessageW(GetDlgItem(hwndDlg, IDB_BANNER), STM_SETIMAGE,
-                     IMAGE_BITMAP, (LPARAM)params->hbmBanner);
+    /* a heading in a larger face, the fields labelled by cue banners, as
+     * the network credentials prompt is drawn since Vista; an application's
+     * banner bitmap is not shown */
+    LoadStringW(hinstCredUI, IDS_HEADER, cue, ARRAY_SIZE(cue));
+    SetDlgItemTextW(hwndDlg, IDC_HEADER, cue);
+    params->hfontHeader = NULL;
+    if (GetObjectW((HFONT)SendMessageW(hwndDlg, WM_GETFONT, 0, 0), sizeof(lf), &lf))
+    {
+        lf.lfHeight = lf.lfHeight * 3 / 2;
+        params->hfontHeader = CreateFontIndirectW(&lf);
+        SendDlgItemMessageW(hwndDlg, IDC_HEADER, WM_SETFONT, (WPARAM)params->hfontHeader, FALSE);
+    }
+    hwndUserEdit = (HWND)SendMessageW(hwndUsername, CBEM_GETEDITCONTROL, 0, 0);
+    LoadStringW(hinstCredUI, IDS_CUEUSERNAME, cue, ARRAY_SIZE(cue));
+    SendMessageW(hwndUserEdit ? hwndUserEdit : hwndUsername, EM_SETCUEBANNER, TRUE, (LPARAM)cue);
+    LoadStringW(hinstCredUI, IDS_CUEPASSWORD, cue, ARRAY_SIZE(cue));
+    SendMessageW(hwndPassword, EM_SETCUEBANNER, TRUE, (LPARAM)cue);
 
     if (params->pszMessageText)
         SetDlgItemTextW(hwndDlg, IDC_MESSAGE, params->pszMessageText);
@@ -490,6 +526,14 @@
 
             return CredDialogInit(hwndDlg, params);
         }
+#ifndef SG_MUTANT_CREDUI_GREY
+        case WM_CTLCOLORDLG:
+            return (INT_PTR)GetSysColorBrush(COLOR_WINDOW);
+        case WM_CTLCOLORSTATIC:
+            SetTextColor((HDC)wParam, GetSysColor(COLOR_WINDOWTEXT));
+            SetBkColor((HDC)wParam, GetSysColor(COLOR_WINDOW));
+            return (INT_PTR)GetSysColorBrush(COLOR_WINDOW);
+#endif
         case WM_COMMAND:
             switch (wParam)
             {
@@ -547,6 +591,7 @@
             struct cred_dialog_params *params =
                 (struct cred_dialog_params *)GetWindowLongPtrW(hwndDlg, DWLP_USER);
             if (params->hwndBalloonTip) DestroyWindow(params->hwndBalloonTip);
+            if (params->hfontHeader) DeleteObject(params->hfontHeader);
             return TRUE;
         }
         default:
@@ -644,9 +689,16 @@
     params.hwndBalloonTip = NULL;
     params.fBalloonTipActive = FALSE;
 
-    ret = DialogBoxParamW(hinstCredUI, MAKEINTRESOURCEW(IDD_CREDDIALOG),
-                          pUIInfo ? pUIInfo->hwndParent : NULL,
-                          CredDialogProc, (LPARAM)&params);
+    {
+        ULONG_PTR cookie = 0;
+        BOOL active = credui_actctx != INVALID_HANDLE_VALUE && ActivateActCtx(credui_actctx, &cookie);
+
+        params.hfontHeader = NULL;
+        ret = DialogBoxParamW(hinstCredUI, MAKEINTRESOURCEW(IDD_CREDDIALOG),
+                              pUIInfo ? pUIInfo->hwndParent : NULL,
+                              CredDialogProc, (LPARAM)&params);
+        if (active) DeactivateActCtx(0, cookie);
+    }
     if (ret <= 0)
         return GetLastError();
 
--- a/dlls/credui/credui_resources.h
+++ b/dlls/credui/credui_resources.h
@@ -24,6 +24,7 @@
 #define IDC_PASSWORD        102
 #define IDC_MESSAGE         103
 #define IDC_SAVE            104
+#define IDC_HEADER          105
 
 #define IDB_BANNER          200
 
@@ -33,3 +34,6 @@
 #define IDS_INCORRECTPASSWORD       303
 #define IDS_CAPSLOCKON      304
 #define IDS_CAPSLOCKONTITLE 305
+#define IDS_HEADER          306
+#define IDS_CUEUSERNAME     307
+#define IDS_CUEPASSWORD     308
