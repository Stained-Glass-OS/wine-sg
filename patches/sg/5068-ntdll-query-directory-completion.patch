From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Complete NtQueryDirectoryFile through an event, an APC or a completion port.

NtQueryDirectoryFile takes an event and an APC routine (it returned
STATUS_NOT_IMPLEMENTED for either): the query still runs at once, and like
any request that completes at once it sets the event, queues the APC, or
posts the ApcContext to the handle's completion port. A request that fails
does none of this. The listing is gathered in a local IO_STATUS_BLOCK so a
32-bit caller's block is written only through the usual completion path.

Gate: test/ntdll-querydir-async-gate.sh (64/32).
---
 dlls/ntdll/unix/file.c | 29 ++++++++++++++++++-----------
 1 file changed, 18 insertions(+), 11 deletions(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 37fc32a..44dffd9 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3003,6 +3003,9 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
                                       UNICODE_STRING *mask, BOOLEAN restart_scan )
 {
     int cwd, fd, needs_close;
+    unsigned int options;
+    BOOL scanned = FALSE;
+    IO_STATUS_BLOCK scan = { 0 };   /* the 32-bit caller's io stays untouched until the end */
     enum server_fd_type type;
     struct dir_data *data;
     unsigned int status;
@@ -3012,11 +3015,6 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
           (int)length, info_class, single_entry, debugstr_us(mask),
           restart_scan);
 
-    if (event || apc_routine)
-    {
-        FIXME( "Unsupported yet option\n" );
-        return STATUS_NOT_IMPLEMENTED;
-    }
     switch (info_class)
     {
     case FileDirectoryInformation:
@@ -3042,7 +3040,7 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
     }
     if (!buffer) return STATUS_ACCESS_VIOLATION;
 
-    if ((status = server_get_unix_fd( handle, FILE_LIST_DIRECTORY, &fd, &needs_close, &type, NULL )))
+    if ((status = server_get_unix_fd( handle, FILE_LIST_DIRECTORY, &fd, &needs_close, &type, &options )))
         return status;
 
     if (type != FD_TYPE_DIR)
@@ -3051,8 +3049,6 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
         return STATUS_INVALID_PARAMETER;
     }
 
-    io->Information = 0;
-
     mutex_lock( &dir_mutex );
 
     cwd = open( ".", O_RDONLY );
@@ -3066,7 +3062,7 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
 
             while (!status && data->pos < data->count)
             {
-                status = get_dir_data_entry( data, buffer, io, length, info_class, &last_info );
+                status = get_dir_data_entry( data, buffer, &scan, length, info_class, &last_info );
                 if (!status || status == STATUS_BUFFER_OVERFLOW) data->pos++;
                 if (single_entry && last_info) break;
             }
@@ -3074,7 +3070,7 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
             if (!last_info) status = STATUS_NO_MORE_FILES;
             else if (status == STATUS_MORE_ENTRIES) status = STATUS_SUCCESS;
 
-            io->Status = status;
+            scanned = TRUE;
         }
         if (cwd == -1 || fchdir( cwd ) == -1) chdir( "/" );
     }
@@ -3084,7 +3080,18 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
 
     if (needs_close) close( fd );
     if (cwd != -1) close( cwd );
-    TRACE( "=> %x (%ld)\n", status, io->Information );
+    /* the query is done at once; an event, an APC or the completion port hear of it as of
+     * any other request that completes at once */
+#ifndef SG_MUTANT_DIR_NO_COMPLETION
+    if (scanned && !NT_ERROR(status))
+        file_complete_async( handle, options, event, apc_routine, apc_context, io, status, scan.Information );
+    else
+#endif
+    {
+        if (scanned) io->Status = status;
+        io->Information = scan.Information;
+    }
+    TRACE( "=> %x (%ld)\n", status, scan.Information );
     return status;
 }
 
