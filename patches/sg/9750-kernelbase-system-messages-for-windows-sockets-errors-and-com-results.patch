 LanguageNames=(ENU=0x409:winerr)
 SeverityNames=(CoError=0x2:STATUS_SEVERITY_COERROR)
-FacilityNames=(Trust=0xb:FACILITY_CERT)
+FacilityNames=(Trust=0xb:FACILITY_CERT
+               Rpc=0x1:FACILITY_RPC
+               Dispatch=0x2:FACILITY_DISPATCH
+               Itf=0x4:FACILITY_ITF)
 
