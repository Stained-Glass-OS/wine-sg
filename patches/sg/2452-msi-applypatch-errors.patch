From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: MsiApplyMultiplePatches errors, missing patches are not found

Ground truth from Wine's msi package tests (17 todo_wine marks removed, 10 of them already satisfied by 2445's package/handle fix): in a list of patches an empty entry is ERROR_PATH_NOT_FOUND and one of blanks ERROR_PATCH_PACKAGE_OPEN_FAILED when the current drive is a fixed one (ERROR_INVALID_NAME otherwise); a patch that is not there is ERROR_FILE_NOT_FOUND (ERROR_PATH_NOT_FOUND if the directory is missing) instead of the failure from reading its product codes.
---
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -367,6 +367,15 @@ static UINT MSI_ApplyPatchW(LPCWSTR szPatchPackage, LPCWSTR szProductCode, LPCWS
     if (!szPatchPackage || !szPatchPackage[0])
         return ERROR_INVALID_PARAMETER;
 
+#ifndef SG_MUTANT_MSI_PATCH_ERRORS
+    /* a patch that is not there is not found, whatever the reason the product codes cannot be read */
+    if (!UrlIsW( szPatchPackage, URLIS_URL ) && GetFileAttributesW( szPatchPackage ) == INVALID_FILE_ATTRIBUTES)
+    {
+        r = GetLastError();
+        return (r == ERROR_PATH_NOT_FOUND || r == ERROR_FILE_NOT_FOUND) ? r : ERROR_FILE_NOT_FOUND;
+    }
+#endif
+
     if (!szProductCode && (r = get_patch_product_codes( szPatchPackage, &codes )))
         return r;
 
@@ -472,13 +481,23 @@ UINT WINAPI MsiApplyMultiplePatchesW(LPCWSTR szPatchPackages,
         DWORD len;
         LPWSTR patch;
 
+        LPCWSTR raw = beg;
+
         while (*beg == ' ') beg++;
         while (*end && *end != ';') end++;
 
         len = end - beg;
         while (len && beg[len - 1] == ' ') len--;
 
-        if (!len) return ERROR_INVALID_NAME;
+        if (!len)
+        {
+            /* on a fixed drive: nothing at all is a path not found, blanks a package that cannot be opened */
+#ifndef SG_MUTANT_MSI_PATCH_ERRORS
+            if (GetDriveTypeW( NULL ) == DRIVE_FIXED)
+                return end == raw ? ERROR_PATH_NOT_FOUND : ERROR_PATCH_PACKAGE_OPEN_FAILED;
+#endif
+            return ERROR_INVALID_NAME;
+        }
 
         patch = malloc((len + 1) * sizeof(WCHAR));
         if (!patch)
