+
+static const GUID node_volume = {0x3a5acc00,0xc557,0x11d0,{0x8a,0x2b,0x00,0xa0,0xc9,0x25,0x5a,0xc1}};
+static const GUID node_mute = {0x02b223c0,0xc557,0x11d0,{0x8a,0x2b,0x00,0xa0,0xc9,0x25,0x5a,0xc1}};
+static const GUID node_speaker = {0xdff21ce1,0xf70f,0x11d0,{0xb9,0x17,0x00,0xa0,0xc9,0x22,0x31,0x96}};
+static const GUID node_microphone = {0xdff21be1,0xf70f,0x11d0,{0xb9,0x17,0x00,0xa0,0xc9,0x22,0x31,0x96}};
+
+#ifndef E_NOTFOUND
+#define E_NOTFOUND HRESULT_FROM_WIN32(ERROR_NOT_FOUND)
+#endif
+
+enum part_index
+{
+    PART_ENDPOINT,      /* the endpoint topology's connector */
+    PART_STREAM,        /* the adapter's: the stream's connector */
+    PART_VOLUME,
+    PART_MUTE,
+    PART_JACK,          /* the adapter's bridge connector */
+    PART_COUNT
+};
+
+struct control_sink
+{
+    struct list entry;
+    enum part_index part;
+    IControlChangeNotify *notify;
+};
+
+/* what one activation of IDeviceTopology describes: both topologies */
+struct model
+{
+    LONG ref;
+    IMMDevice *device;
+    EDataFlow flow;
+    WCHAR endpoint_id[256];
+    WCHAR adapter_id[300];
+    WCHAR endpoint_name[256];
+    DWORD channel_mask;
+    UINT form_factor;
+    IAudioEndpointVolume *volume;
+    IAudioEndpointVolumeCallback IAudioEndpointVolumeCallback_iface;
+    CRITICAL_SECTION cs;
+    struct list sinks;
+    BOOL watching;
+    BOOL muted;
+    float master;
+    float levels[32];
+    UINT channels;
+    /* a software link of the stream connector (ConnectTo) */
+    IConnector *stream_link;
+};
+
+struct topology
+{
+    IDeviceTopology IDeviceTopology_iface;
+    LONG ref;
+    struct model *model;
+    BOOL adapter;       /* the adapter's topology, else the endpoint's */
+};
+
+struct part
+{
+    IPart IPart_iface;
+    IConnector IConnector_iface;
+    ISubUnit ISubUnit_iface;
+    IAudioVolumeLevel IAudioVolumeLevel_iface;
+    IAudioMute IAudioMute_iface;
+    IKsJackDescription IKsJackDescription_iface;
+    IKsJackDescription2 IKsJackDescription2_iface;
+    LONG ref;
+    struct model *model;
+    enum part_index index;
+};
+
+static HRESULT create_part( struct model *model, enum part_index index, REFIID riid, void **out );
+static HRESULT create_topology( struct model *model, BOOL adapter, IDeviceTopology **out );
+
+static BOOL is_connector( enum part_index index )
+{
+    return index == PART_ENDPOINT || index == PART_STREAM || index == PART_JACK;
+}
+
+static BOOL in_adapter( enum part_index index )
+{
+    return index != PART_ENDPOINT;
+}
+
+/* local IDs: connectors 0x10000 + n, subunits 0x20000 + n, per topology */
+static UINT local_id( enum part_index index )
+{
+    switch (index)
+    {
+    case PART_ENDPOINT: return 0x10000;
+    case PART_STREAM: return 0x10000;
+    case PART_JACK: return 0x10001;
+    case PART_VOLUME: return 0x20000;
+    case PART_MUTE: return 0x20001;
+    default: return 0;
+    }
+}
+
+/* the adapter's parts in the order the signal passes them */
+static void signal_order( const struct model *model, enum part_index order[4] )
+{
+    if (model->flow == eCapture)
+    {
+        order[0] = PART_JACK; order[1] = PART_VOLUME; order[2] = PART_MUTE; order[3] = PART_STREAM;
+    }
+    else
+    {
+        order[0] = PART_STREAM; order[1] = PART_VOLUME; order[2] = PART_MUTE; order[3] = PART_JACK;
+    }
+}
+
+static int signal_position( const struct model *model, enum part_index index )
+{
+    enum part_index order[4];
+    int i;
+
+    signal_order( model, order );
+    for (i = 0; i < 4; i++) if (order[i] == index) return i;
+    return -1;
+}
+
+static void model_addref( struct model *model )
+{
+    InterlockedIncrement( &model->ref );
+}
+
+static void model_release( struct model *model )
+{
+    struct control_sink *sink, *next;
+
+    if (InterlockedDecrement( &model->ref )) return;
+    if (model->watching) IAudioEndpointVolume_UnregisterControlChangeNotify( model->volume,
+                                                                             &model->IAudioEndpointVolumeCallback_iface );
+    LIST_FOR_EACH_ENTRY_SAFE( sink, next, &model->sinks, struct control_sink, entry )
+    {
+        IControlChangeNotify_Release( sink->notify );
+        free( sink );
+    }
+    if (model->stream_link) IConnector_Release( model->stream_link );
+    if (model->volume) IAudioEndpointVolume_Release( model->volume );
+    IMMDevice_Release( model->device );
+    model->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &model->cs );
+    free( model );
+}
+
+static WCHAR *co_strdup( const WCHAR *str )
+{
+    size_t len = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = CoTaskMemAlloc( len );
+    if (ret) memcpy( ret, str, len );
+    return ret;
+}
+
+/* ---- the endpoint volume's changes, for the controls' callbacks --------------- */
+
+static inline struct model *impl_from_IAudioEndpointVolumeCallback( IAudioEndpointVolumeCallback *iface )
+{
+    return CONTAINING_RECORD( iface, struct model, IAudioEndpointVolumeCallback_iface );
+}
+
+static HRESULT WINAPI volume_cb_QueryInterface( IAudioEndpointVolumeCallback *iface, REFIID riid, void **out )
+{
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IAudioEndpointVolumeCallback ))
+    {
+        *out = iface;
+        IAudioEndpointVolumeCallback_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the model holds the registration: no reference of its own */
+static ULONG WINAPI volume_cb_AddRef( IAudioEndpointVolumeCallback *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI volume_cb_Release( IAudioEndpointVolumeCallback *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI volume_cb_OnNotify( IAudioEndpointVolumeCallback *iface, AUDIO_VOLUME_NOTIFICATION_DATA *data )
+{
+    struct model *model = impl_from_IAudioEndpointVolumeCallback( iface );
+    IControlChangeNotify *notify[32];
+    BOOL level_changed = FALSE, mute_changed;
+    struct control_sink *sink;
+    UINT i, n = 0;
+
+    EnterCriticalSection( &model->cs );
+    mute_changed = !data->bMuted != !model->muted;
+    model->muted = data->bMuted;
+    if (data->fMasterVolume != model->master)
+    {
+        model->master = data->fMasterVolume;
+        level_changed = TRUE;
+    }
+    for (i = 0; i < data->nChannels && i < ARRAY_SIZE(model->levels); i++)
+        if (data->afChannelVolumes[i] != model->levels[i])
+        {
+            model->levels[i] = data->afChannelVolumes[i];
+            level_changed = TRUE;
+        }
+    LIST_FOR_EACH_ENTRY( sink, &model->sinks, struct control_sink, entry )
+    {
+        if (n == ARRAY_SIZE(notify)) break;
+        if ((sink->part == PART_VOLUME && level_changed) || (sink->part == PART_MUTE && mute_changed))
+            IControlChangeNotify_AddRef( (notify[n++] = sink->notify) );
+    }
+    LeaveCriticalSection( &model->cs );
+    for (i = 0; i < n; i++)
+    {
+        IControlChangeNotify_OnNotify( notify[i], GetCurrentProcessId(), &data->guidEventContext );
+        IControlChangeNotify_Release( notify[i] );
+    }
+    return S_OK;
+}
+
+static const IAudioEndpointVolumeCallbackVtbl volume_cb_vtbl =
+{
+    volume_cb_QueryInterface,
+    volume_cb_AddRef,
+    volume_cb_Release,
+    volume_cb_OnNotify,
+};
+
+static HRESULT model_volume( struct model *model, IAudioEndpointVolume **out )
+{
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &model->cs );
+    if (!model->volume)
+        hr = IMMDevice_Activate( model->device, &IID_IAudioEndpointVolume, CLSCTX_INPROC_SERVER, NULL,
+                                 (void **)&model->volume );
+    if (SUCCEEDED(hr))
+    {
+        *out = model->volume;
+        IAudioEndpointVolume_AddRef( *out );
+    }
+    LeaveCriticalSection( &model->cs );
+    return hr;
+}
+
+/* ---- IPartsList -------------------------------------------------------------- */
+
+struct parts_list
+{
+    IPartsList IPartsList_iface;
+    LONG ref;
+    struct model *model;
+    enum part_index parts[PART_COUNT];
+    UINT count;
+};
+
+static inline struct parts_list *impl_from_IPartsList( IPartsList *iface )
+{
+    return CONTAINING_RECORD( iface, struct parts_list, IPartsList_iface );
+}
+
+static HRESULT WINAPI parts_QueryInterface( IPartsList *iface, REFIID riid, void **out )
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IPartsList ))
+    {
+        *out = iface;
+        IPartsList_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI parts_AddRef( IPartsList *iface )
+{
+    struct parts_list *This = impl_from_IPartsList( iface );
+    return InterlockedIncrement( &This->ref );
+}
+
+static ULONG WINAPI parts_Release( IPartsList *iface )
+{
+    struct parts_list *This = impl_from_IPartsList( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    if (!ref)
+    {
+        model_release( This->model );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI parts_GetCount( IPartsList *iface, UINT *count )
+{
+    struct parts_list *This = impl_from_IPartsList( iface );
+
+    if (!count) return E_POINTER;
+    *count = This->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI parts_GetPart( IPartsList *iface, UINT index, IPart **part )
+{
+    struct parts_list *This = impl_from_IPartsList( iface );
+
+    if (!part) return E_POINTER;
+    *part = NULL;
+    if (index >= This->count) return E_INVALIDARG;
+    return create_part( This->model, This->parts[index], &IID_IPart, (void **)part );
+}
+
+static const IPartsListVtbl parts_vtbl =
+{
+    parts_QueryInterface,
+    parts_AddRef,
+    parts_Release,
+    parts_GetCount,
+    parts_GetPart,
+};
+
+static HRESULT create_parts_list( struct model *model, const enum part_index *parts, UINT count, IPartsList **out )
+{
+    struct parts_list *list;
+
+    *out = NULL;
+    if (!(list = calloc( 1, sizeof(*list) ))) return E_OUTOFMEMORY;
+    list->IPartsList_iface.lpVtbl = &parts_vtbl;
+    list->ref = 1;
+    list->model = model;
+    model_addref( model );
+    memcpy( list->parts, parts, count * sizeof(*parts) );
+    list->count = count;
+    *out = &list->IPartsList_iface;
+    return S_OK;
+}
+
+/* ---- IControlInterface ------------------------------------------------------ */
+
+struct control_interface
+{
+    IControlInterface IControlInterface_iface;
+    LONG ref;
+    const WCHAR *name;
+    const IID *iid;
+};
+
+static inline struct control_interface *impl_from_IControlInterface( IControlInterface *iface )
+{
+    return CONTAINING_RECORD( iface, struct control_interface, IControlInterface_iface );
+}
+
+static HRESULT WINAPI ci_QueryInterface( IControlInterface *iface, REFIID riid, void **out )
+{
+    if (!out) return E_POINTER;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IControlInterface ))
+    {
+        *out = iface;
+        IControlInterface_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ci_AddRef( IControlInterface *iface )
+{
+    return InterlockedIncrement( &impl_from_IControlInterface( iface )->ref );
+}
+
+static ULONG WINAPI ci_Release( IControlInterface *iface )
+{
+    struct control_interface *This = impl_from_IControlInterface( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+    if (!ref) free( This );
+    return ref;
+}
+
+static HRESULT WINAPI ci_GetName( IControlInterface *iface, WCHAR **name )
+{
+    if (!name) return E_POINTER;
+    return (*name = co_strdup( impl_from_IControlInterface( iface )->name )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI ci_GetIID( IControlInterface *iface, GUID *iid )
+{
+    if (!iid) return E_POINTER;
+    *iid = *impl_from_IControlInterface( iface )->iid;
+    return S_OK;
+}
+
+static const IControlInterfaceVtbl ci_vtbl =
+{
+    ci_QueryInterface,
+    ci_AddRef,
+    ci_Release,
+    ci_GetName,
+    ci_GetIID,
+};
+
+/* the controls a part has */
+static UINT part_controls( enum part_index index, const WCHAR **names, const IID **iids )
+{
+    switch (index)
+    {
+    case PART_VOLUME:
+        names[0] = L"Volume"; iids[0] = &IID_IAudioVolumeLevel;
+        return 1;
+    case PART_MUTE:
+        names[0] = L"Mute"; iids[0] = &IID_IAudioMute;
+        return 1;
+    case PART_JACK:
+        names[0] = L"Jack Description"; iids[0] = &IID_IKsJackDescription;
+        names[1] = L"Jack Description 2"; iids[1] = &IID_IKsJackDescription2;
+        return 2;
+    default:
+        return 0;
+    }
+}
+
+/* ---- IPart ------------------------------------------------------------------- */
+
+static inline struct part *impl_from_IPart( IPart *iface )
+{
+    return CONTAINING_RECORD( iface, struct part, IPart_iface );
+}
+
+static HRESULT WINAPI part_QueryInterface( IPart *iface, REFIID riid, void **out )
+{
+    struct part *This = impl_from_IPart( iface );
+
+    TRACE( "(%p)->(%s, %p)\n", This, debugstr_guid( riid ), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IPart )) *out = &This->IPart_iface;
+    else if (IsEqualIID( riid, &IID_IConnector ) && is_connector( This->index )) *out = &This->IConnector_iface;
+    else if (IsEqualIID( riid, &IID_ISubUnit ) && !is_connector( This->index )) *out = &This->ISubUnit_iface;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI part_AddRef( IPart *iface )
+{
+    struct part *This = impl_from_IPart( iface );
+    ULONG ref = InterlockedIncrement( &This->ref );
+    TRACE( "(%p) new ref %lu\n", This, ref );
+    return ref;
+}
+
+static ULONG WINAPI part_Release( IPart *iface )
+{
+    struct part *This = impl_from_IPart( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    TRACE( "(%p) new ref %lu\n", This, ref );
+    if (!ref)
+    {
+        model_release( This->model );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI part_GetName( IPart *iface, WCHAR **name )
+{
+    struct part *This = impl_from_IPart( iface );
+    const WCHAR *str;
+
+    TRACE( "(%p)->(%p)\n", This, name );
+
+    if (!name) return E_POINTER;
+    switch (This->index)
+    {
+    case PART_ENDPOINT: str = This->model->endpoint_name; break;
+    case PART_STREAM: str = This->model->flow == eCapture ? L"Capture" : L"Playback"; break;
+    case PART_VOLUME: str = L"Volume"; break;
+    case PART_MUTE: str = L"Mute"; break;
+    default: str = This->model->flow == eCapture ? L"Microphone" : L"Speakers"; break;
+    }
+    return (*name = co_strdup( str )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI part_GetLocalId( IPart *iface, UINT *id )
+{
+    struct part *This = impl_from_IPart( iface );
+
+    if (!id) return E_POINTER;
+    *id = local_id( This->index );
+    return S_OK;
+}
+
+static HRESULT WINAPI part_GetGlobalId( IPart *iface, WCHAR **id )
+{
+    struct part *This = impl_from_IPart( iface );
+    WCHAR buf[400];
+
+    if (!id) return E_POINTER;
+    swprintf( buf, ARRAY_SIZE(buf), L"%s/%08x", in_adapter( This->index ) ? This->model->adapter_id :
+              This->model->endpoint_id, local_id( This->index ) );
+    return (*id = co_strdup( buf )) ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI part_GetPartType( IPart *iface, PartType *type )
+{
+    struct part *This = impl_from_IPart( iface );
+
+    if (!type) return E_POINTER;
+    *type = is_connector( This->index ) ? Connector : Subunit;
+    return S_OK;
+}
+
+static HRESULT WINAPI part_GetSubType( IPart *iface, GUID *subtype )
+{
+    struct part *This = impl_from_IPart( iface );
+
+    if (!subtype) return E_POINTER;
+    switch (This->index)
+    {
+    case PART_VOLUME: *subtype = node_volume; break;
+    case PART_MUTE: *subtype = node_mute; break;
+    case PART_ENDPOINT:
+    case PART_JACK: *subtype = This->model->flow == eCapture ? node_microphone : node_speaker; break;
+    default: *subtype = GUID_NULL; break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI part_GetControlInterfaceCount( IPart *iface, UINT *count )
+{
+    struct part *This = impl_from_IPart( iface );
+    const WCHAR *names[2];
+    const IID *iids[2];
+
+    if (!count) return E_POINTER;
+    *count = part_controls( This->index, names, iids );
+    return S_OK;
+}
+
+static HRESULT WINAPI part_GetControlInterface( IPart *iface, UINT index, IControlInterface **out )
+{
+    struct part *This = impl_from_IPart( iface );
+    struct control_interface *ci;
+    const WCHAR *names[2];
+    const IID *iids[2];
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (index >= part_controls( This->index, names, iids )) return E_INVALIDARG;
+    if (!(ci = calloc( 1, sizeof(*ci) ))) return E_OUTOFMEMORY;
+    ci->IControlInterface_iface.lpVtbl = &ci_vtbl;
+    ci->ref = 1;
+    ci->name = names[index];
+    ci->iid = iids[index];
+    *out = &ci->IControlInterface_iface;
+    return S_OK;
+}
+
+static HRESULT enum_parts( struct part *This, BOOL outgoing, IPartsList **out )
+{
+    enum part_index order[4];
+    int pos;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    /* the endpoint's connector has nothing beside it in its topology */
+    if (This->index == PART_ENDPOINT) return E_NOTFOUND;
+    signal_order( This->model, order );
+    pos = signal_position( This->model, This->index ) + (outgoing ? 1 : -1);
+    if (pos < 0 || pos > 3) return E_NOTFOUND;
+    return create_parts_list( This->model, &order[pos], 1, out );
+}
+
+static HRESULT WINAPI part_EnumPartsIncoming( IPart *iface, IPartsList **parts )
+{
+    return enum_parts( impl_from_IPart( iface ), FALSE, parts );
+}
+
+static HRESULT WINAPI part_EnumPartsOutgoing( IPart *iface, IPartsList **parts )
+{
+    return enum_parts( impl_from_IPart( iface ), TRUE, parts );
+}
+
+static HRESULT WINAPI part_GetTopologyObject( IPart *iface, IDeviceTopology **topology )
+{
+    struct part *This = impl_from_IPart( iface );
+
+    if (!topology) return E_POINTER;
+    return create_topology( This->model, in_adapter( This->index ), topology );
+}
+
+static HRESULT WINAPI part_Activate( IPart *iface, DWORD clsctx, REFIID riid, void **out )
+{
+    struct part *This = impl_from_IPart( iface );
+
+    TRACE( "(%p)->(%#lx, %s, %p)\n", This, clsctx, debugstr_guid( riid ), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualIID( riid, &IID_IAudioVolumeLevel ) && This->index == PART_VOLUME)
+        *out = &This->IAudioVolumeLevel_iface;
+    else if (IsEqualIID( riid, &IID_IAudioMute ) && This->index == PART_MUTE)
+        *out = &This->IAudioMute_iface;
+    else if (IsEqualIID( riid, &IID_IKsJackDescription ) && This->index == PART_JACK)
+        *out = &This->IKsJackDescription_iface;
+    else if (IsEqualIID( riid, &IID_IKsJackDescription2 ) && This->index == PART_JACK)
+        *out = &This->IKsJackDescription2_iface;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static HRESULT WINAPI part_RegisterControlChangeCallback( IPart *iface, REFGUID riid, IControlChangeNotify *notify )
+{
+    struct part *This = impl_from_IPart( iface );
+    struct model *model = This->model;
+    struct control_sink *sink;
+    IAudioEndpointVolume *volume;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%s, %p)\n", This, debugstr_guid( riid ), notify );
+
+    if (!notify) return E_POINTER;
+    if (!(This->index == PART_VOLUME && IsEqualIID( riid, &IID_IAudioVolumeLevel )) &&
+        !(This->index == PART_MUTE && IsEqualIID( riid, &IID_IAudioMute )))
+        return E_INVALIDARG;
+    if (FAILED(hr = model_volume( model, &volume ))) return hr;
+    if (!(sink = calloc( 1, sizeof(*sink) )))
+    {
+        IAudioEndpointVolume_Release( volume );
+        return E_OUTOFMEMORY;
+    }
+    sink->part = This->index;
+    sink->notify = notify;
+    IControlChangeNotify_AddRef( notify );
+    EnterCriticalSection( &model->cs );
+    list_add_tail( &model->sinks, &sink->entry );
+    if (!model->watching)
+    {
+        IAudioEndpointVolume_GetMute( volume, &model->muted );
+        IAudioEndpointVolume_GetMasterVolumeLevelScalar( volume, &model->master );
+        IAudioEndpointVolume_GetChannelCount( volume, &model->channels );
+        for (UINT i = 0; i < model->channels && i < ARRAY_SIZE(model->levels); i++)
+            IAudioEndpointVolume_GetChannelVolumeLevelScalar( volume, i, &model->levels[i] );
+#ifndef SG_MUTANT_NO_CONTROL_CALLBACKS
+        model->watching = SUCCEEDED(IAudioEndpointVolume_RegisterControlChangeNotify( volume,
+                                    &model->IAudioEndpointVolumeCallback_iface ));
+#endif
+    }
+    LeaveCriticalSection( &model->cs );
+    IAudioEndpointVolume_Release( volume );
+    return S_OK;
+}
+
+static HRESULT WINAPI part_UnregisterControlChangeCallback( IPart *iface, IControlChangeNotify *notify )
+{
+    struct part *This = impl_from_IPart( iface );
+    struct control_sink *sink, *found = NULL;
+
+    TRACE( "(%p)->(%p)\n", This, notify );
+
+    if (!notify) return E_POINTER;
+    EnterCriticalSection( &This->model->cs );
+    LIST_FOR_EACH_ENTRY( sink, &This->model->sinks, struct control_sink, entry )
+        if (sink->notify == notify && sink->part == This->index)
+        {
+            found = sink;
+            list_remove( &sink->entry );
+            break;
+        }
+    LeaveCriticalSection( &This->model->cs );
+    if (!found) return E_INVALIDARG;
+    IControlChangeNotify_Release( found->notify );
+    free( found );
+    return S_OK;
+}
+
+static const IPartVtbl part_vtbl =
+{
+    part_QueryInterface,
+    part_AddRef,
+    part_Release,
+    part_GetName,
+    part_GetLocalId,
+    part_GetGlobalId,
+    part_GetPartType,
+    part_GetSubType,
+    part_GetControlInterfaceCount,
+    part_GetControlInterface,
+    part_EnumPartsIncoming,
+    part_EnumPartsOutgoing,
+    part_GetTopologyObject,
+    part_Activate,
+    part_RegisterControlChangeCallback,
+    part_UnregisterControlChangeCallback,
+};
