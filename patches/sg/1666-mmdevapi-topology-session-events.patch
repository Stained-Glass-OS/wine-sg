+
+static HRESULT WINAPI level_GetChannelCount( IAudioVolumeLevel *iface, UINT *count )
+{
+    struct part *This = impl_from_IAudioVolumeLevel( iface );
+    IAudioEndpointVolume *volume;
+    HRESULT hr;
+
+    if (!count) return E_POINTER;
+    if (FAILED(hr = model_volume( This->model, &volume ))) return hr;
+    hr = IAudioEndpointVolume_GetChannelCount( volume, count );
+    IAudioEndpointVolume_Release( volume );
+    return hr;
+}
+
+static HRESULT WINAPI level_GetLevelRange( IAudioVolumeLevel *iface, UINT channel, float *min, float *max,
+                                           float *step )
+{
+    struct part *This = impl_from_IAudioVolumeLevel( iface );
+    IAudioEndpointVolume *volume;
+    UINT count;
+    HRESULT hr;
+
+    if (!min || !max || !step) return E_POINTER;
+    if (FAILED(hr = model_volume( This->model, &volume ))) return hr;
+    if (SUCCEEDED(hr = IAudioEndpointVolume_GetChannelCount( volume, &count )))
+        hr = channel >= count ? E_INVALIDARG : IAudioEndpointVolume_GetVolumeRange( volume, min, max, step );
+    IAudioEndpointVolume_Release( volume );
+    return hr;
+}
+
+static HRESULT WINAPI level_GetLevel( IAudioVolumeLevel *iface, UINT channel, float *db )
+{
+    struct part *This = impl_from_IAudioVolumeLevel( iface );
+    IAudioEndpointVolume *volume;
+    HRESULT hr;
+
+    if (!db) return E_POINTER;
+    if (FAILED(hr = model_volume( This->model, &volume ))) return hr;
+    hr = IAudioEndpointVolume_GetChannelVolumeLevel( volume, channel, db );
+    IAudioEndpointVolume_Release( volume );
+    return hr;
+}
+
+static HRESULT WINAPI level_SetLevel( IAudioVolumeLevel *iface, UINT channel, float db, const GUID *ctx )
+{
+    struct part *This = impl_from_IAudioVolumeLevel( iface );
+    IAudioEndpointVolume *volume;
+    float min, max, step;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%u, %f, %s)\n", This, channel, db, debugstr_guid( ctx ) );
+
+    if (FAILED(hr = model_volume( This->model, &volume ))) return hr;
+    /* a level past the range is the range's end, as a hardware control's is */
+    if (SUCCEEDED(IAudioEndpointVolume_GetVolumeRange( volume, &min, &max, &step )))
+        db = db < min ? min : db > max ? max : db;
+    hr = IAudioEndpointVolume_SetChannelVolumeLevel( volume, channel, db, ctx );
+    IAudioEndpointVolume_Release( volume );
+    return hr;
+}
+
+static HRESULT WINAPI level_SetLevelUniform( IAudioVolumeLevel *iface, float db, const GUID *ctx )
+{
+    UINT count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = level_GetChannelCount( iface, &count ))) return hr;
+    for (i = 0; i < count && SUCCEEDED(hr); i++) hr = level_SetLevel( iface, i, db, ctx );
+    return hr;
+}
+
+static HRESULT WINAPI level_SetLevelAllChannels( IAudioVolumeLevel *iface, float *dbs, ULONG channels,
+                                                 const GUID *ctx )
+{
+    UINT count, i;
+    HRESULT hr;
+
+    if (!dbs) return E_POINTER;
+    if (FAILED(hr = level_GetChannelCount( iface, &count ))) return hr;
+    if (channels != count) return E_INVALIDARG;
+    for (i = 0; i < count && SUCCEEDED(hr); i++) hr = level_SetLevel( iface, i, dbs[i], ctx );
+    return hr;
+}
+
+static const IAudioVolumeLevelVtbl level_vtbl =
+{
+    level_QueryInterface,
+    level_AddRef,
+    level_Release,
+    level_GetChannelCount,
+    level_GetLevelRange,
+    level_GetLevel,
+    level_SetLevel,
+    level_SetLevelUniform,
+    level_SetLevelAllChannels,
+};
