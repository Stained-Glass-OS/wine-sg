+/* the buffer durations a stream of the format may ask for: from the
+ * engine's shortest period up to two seconds */
 static HRESULT WINAPI client_GetBufferSizeLimits(IAudioClient3 *iface, const WAVEFORMATEX *format,
                                           BOOL event_driven, REFERENCE_TIME *min_duration,
                                           REFERENCE_TIME *max_duration)
 {
     struct audio_client *This = impl_from_IAudioClient3(iface);
-    FIXME("(%p)->(%p, %u, %p, %p) - stub\n", This, format, event_driven, min_duration, max_duration);
-    return E_NOTIMPL;
+    REFERENCE_TIME def_period, min_period;
+    WAVEFORMATEX *closest = NULL;
+    HRESULT hr;
+
+    TRACE("(%p)->(%p, %u, %p, %p)\n", This, format, event_driven, min_duration, max_duration);
+
+    if (!format || !min_duration || !max_duration)
+        return E_POINTER;
+    hr = IAudioClient3_IsFormatSupported(iface, AUDCLNT_SHAREMODE_SHARED, format, &closest);
+    CoTaskMemFree(closest);
+    if (hr != S_OK)
+        return FAILED(hr) ? hr : AUDCLNT_E_UNSUPPORTED_FORMAT;
+    if (FAILED(hr = IAudioClient3_GetDevicePeriod(iface, &def_period, &min_period)))
+        return hr;
+    *min_duration = event_driven ? min_period : def_period;
+    *max_duration = 20000000;
+    return S_OK;
 }
 
