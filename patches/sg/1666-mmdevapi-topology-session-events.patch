+static const IDeviceTopologyVtbl DeviceTopology_Vtbl =
+{
+    DT_QueryInterface,
+    DT_AddRef,
+    DT_Release,
+    DT_GetConnectorCount,
+    DT_GetConnector,
+    DT_GetSubunitCount,
+    DT_GetSubunit,
+    DT_GetPartById,
+    DT_GetDeviceId,
+    DT_GetSignalPath,
+};
+
+static HRESULT create_topology( struct model *model, BOOL adapter, IDeviceTopology **out )
+{
+    struct topology *topology;
+
+    *out = NULL;
+    if (!(topology = calloc( 1, sizeof(*topology) ))) return E_OUTOFMEMORY;
+    topology->IDeviceTopology_iface.lpVtbl = &DeviceTopology_Vtbl;
+    topology->ref = 1;
+    topology->model = model;
+    topology->adapter = adapter;
+    model_addref( model );
+    *out = &topology->IDeviceTopology_iface;
+    return S_OK;
+}
+
+HRESULT DeviceTopology_Create( IMMDevice *device, IDeviceTopology **out )
+{
+    IMMEndpoint *endpoint;
+    IPropertyStore *store;
+    struct model *model;
+    PROPVARIANT pv;
+    WCHAR *id = NULL;
+    HRESULT hr;
+
+    if (!(model = calloc( 1, sizeof(*model) ))) return E_OUTOFMEMORY;
+    model->ref = 1;
+    model->device = device;
+    IMMDevice_AddRef( device );
+    model->IAudioEndpointVolumeCallback_iface.lpVtbl = &volume_cb_vtbl;
+    InitializeCriticalSectionEx( &model->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    model->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": topology model");
+    list_init( &model->sinks );
+    model->flow = eRender;
+    model->form_factor = Speakers;
+    model->channel_mask = KSAUDIO_SPEAKER_STEREO;
+
+    if (SUCCEEDED(IMMDevice_QueryInterface( device, &IID_IMMEndpoint, (void **)&endpoint )))
+    {
+        IMMEndpoint_GetDataFlow( endpoint, &model->flow );
+        IMMEndpoint_Release( endpoint );
+    }
+    if (SUCCEEDED(IMMDevice_GetId( device, &id )) && id)
+    {
+        const WCHAR *guid = wcsrchr( id, '{' );
+        lstrcpynW( model->endpoint_id, id, ARRAY_SIZE(model->endpoint_id) );
+        /* the adapter's topology filter, named after the endpoint */
+        swprintf( model->adapter_id, ARRAY_SIZE(model->adapter_id),
+                  L"{2}.\\\\?\\swd#sgaudio#%s#{6994ad04-93ef-11d0-a3cc-00a0c9223196}\\topology",
+                  guid ? guid : id );
+        CoTaskMemFree( id );
+    }
+    if (SUCCEEDED(IMMDevice_OpenPropertyStore( device, STGM_READ, &store )))
+    {
+        PropVariantInit( &pv );
+        if (SUCCEEDED(IPropertyStore_GetValue( store, (const PROPERTYKEY *)&DEVPKEY_Device_FriendlyName, &pv )) &&
+            pv.vt == VT_LPWSTR)
+            lstrcpynW( model->endpoint_name, pv.pwszVal, ARRAY_SIZE(model->endpoint_name) );
+        PropVariantClear( &pv );
+        if (SUCCEEDED(IPropertyStore_GetValue( store, &PKEY_AudioEndpoint_FormFactor, &pv )) && pv.vt == VT_UI4)
+            model->form_factor = pv.ulVal;
+        PropVariantClear( &pv );
+        if (SUCCEEDED(IPropertyStore_GetValue( store, &PKEY_AudioEndpoint_PhysicalSpeakers, &pv )) && pv.vt == VT_UI4)
+            model->channel_mask = pv.ulVal;
+        PropVariantClear( &pv );
+        IPropertyStore_Release( store );
+    }
+    if (model->flow == eCapture && model->form_factor == Speakers) model->form_factor = Microphone;
+    hr = create_topology( model, FALSE, out );
+    model_release( model );
+    return hr;
+}
