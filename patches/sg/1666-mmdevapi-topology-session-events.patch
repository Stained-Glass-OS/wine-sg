+/* Stained Glass OS 1666: who is told of new sessions, and of ducking */
+struct manager_sink
+{
+    struct list entry;
+    IMMDevice *device;
+    IUnknown *sink;
+    WCHAR *session_id;      /* ducking: the session it is for */
+};
+
+static struct list session_sinks = LIST_INIT(session_sinks);
+static struct list duck_sinks = LIST_INIT(duck_sinks);
+
+extern struct audio_session_wrapper *session_wrapper_create(struct audio_client *client);
+
+static HRESULT add_manager_sink(struct list *list, IMMDevice *device, IUnknown *sink, const WCHAR *session_id)
+{
+    struct manager_sink *entry;
+
+    if (!sink)
+        return E_POINTER;
+    if (!(entry = calloc(1, sizeof(*entry))))
+        return E_OUTOFMEMORY;
+    entry->device = device;
+    entry->sink = sink;
+    if (session_id && !(entry->session_id = wcsdup(session_id))) {
+        free(entry);
+        return E_OUTOFMEMORY;
+    }
+    IUnknown_AddRef(sink);
+    sessions_lock();
+    list_add_tail(list, &entry->entry);
+    sessions_unlock();
+    return S_OK;
+}
+
+static HRESULT remove_manager_sink(struct list *list, IMMDevice *device, IUnknown *sink)
+{
+    struct manager_sink *entry, *found = NULL;
+
+    if (!sink)
+        return E_POINTER;
+    sessions_lock();
+    LIST_FOR_EACH_ENTRY(entry, list, struct manager_sink, entry) {
+        if (entry->sink == sink && entry->device == device) {
+            list_remove(&entry->entry);
+            found = entry;
+            break;
+        }
+    }
+    sessions_unlock();
+    if (!found)
+        return E_INVALIDARG;
+    IUnknown_Release(found->sink);
+    free(found->session_id);
+    free(found);
+    return S_OK;
+}
+
+/* a stream made a session: the device's session managers' sinks are told */
+void session_announce(struct audio_session *session)
+{
+    IAudioSessionNotification *sinks[32];
+    struct audio_session_wrapper *wrapper;
+    struct manager_sink *entry;
+    UINT n = 0, i;
+
+    sessions_lock();
+    if (session->announced) {
+        sessions_unlock();
+        return;
+    }
+    session->announced = TRUE;
+    LIST_FOR_EACH_ENTRY(entry, &session_sinks, struct manager_sink, entry) {
+        if (n == ARRAY_SIZE(sinks)) break;
+        if (entry->device == session->device)
+            IAudioSessionNotification_AddRef((sinks[n++] = (IAudioSessionNotification *)entry->sink));
+    }
+    sessions_unlock();
+    if (!n)
+        return;
+    if ((wrapper = session_wrapper_create(NULL))) {
+        wrapper->session = session;
+#ifndef SG_MUTANT_NO_SESSION_EVENTS
+        for (i = 0; i < n; i++)
+            IAudioSessionNotification_OnSessionCreated(sinks[i], (IAudioSessionControl *)&wrapper->IAudioSessionControl2_iface);
+#endif
+        IAudioSessionControl2_Release(&wrapper->IAudioSessionControl2_iface);
+    }
+    for (i = 0; i < n; i++)
+        IAudioSessionNotification_Release(sinks[i]);
+}
+
 static struct session_enum *impl_from_IAudioSessionEnumerator(IAudioSessionEnumerator *iface)
 {
     return CONTAINING_RECORD(iface, struct session_enum, IAudioSessionEnumerator_iface);
@@ -274,33 +366,37 @@ static HRESULT WINAPI ASM_RegisterSessionNotification(IAudioSessionManager2 *ifa
                                                       IAudioSessionNotification *notification)
 {
     struct session_mgr *This = impl_from_IAudioSessionManager2(iface);
-    FIXME("(%p)->(%p) - stub\n", This, notification);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, notification);
+    return add_manager_sink(&session_sinks, This->device, (IUnknown *)notification, NULL);
 }
 
 static HRESULT WINAPI ASM_UnregisterSessionNotification(IAudioSessionManager2 *iface,
                                                         IAudioSessionNotification *notification)
 {
     struct session_mgr *This = impl_from_IAudioSessionManager2(iface);
-    FIXME("(%p)->(%p) - stub\n", This, notification);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, notification);
+    return remove_manager_sink(&session_sinks, This->device, (IUnknown *)notification);
 }
 
+/* Ducking lowers the other sessions while a communications session plays;
+ * the sinks are kept for it, and told when it happens. No communications
+ * session ducks others here: the sessions of other processes are not
