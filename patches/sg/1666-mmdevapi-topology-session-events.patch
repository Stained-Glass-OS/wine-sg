+/* ---- IDeviceTopology ------------------------------------------------------------ */
+
+static inline struct topology *impl_from_IDeviceTopology( IDeviceTopology *iface )
+{
+    return CONTAINING_RECORD( iface, struct topology, IDeviceTopology_iface );
+}
+
+static HRESULT WINAPI DT_QueryInterface( IDeviceTopology *iface, REFIID riid, void **ppv )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+
+    TRACE( "(%p)->(%s, %p)\n", This, debugstr_guid( riid ), ppv );
+
+    if (!ppv) return E_POINTER;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IDeviceTopology ))
+    {
+        *ppv = &This->IDeviceTopology_iface;
+        IDeviceTopology_AddRef( iface );
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI DT_AddRef( IDeviceTopology *iface )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+    ULONG ref = InterlockedIncrement( &This->ref );
+    TRACE( "(%p) new ref %lu\n", This, ref );
+    return ref;
+}
+
+static ULONG WINAPI DT_Release( IDeviceTopology *iface )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    TRACE( "(%p) new ref %lu\n", This, ref );
+    if (!ref)
+    {
+        model_release( This->model );
+        free( This );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI DT_GetConnectorCount( IDeviceTopology *iface, UINT *count )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+
+    TRACE( "(%p)->(%p)\n", This, count );
+
+    if (!count) return E_POINTER;
+    *count = This->adapter ? 2 : 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI DT_GetConnector( IDeviceTopology *iface, UINT index, IConnector **connector )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+
+    TRACE( "(%p)->(%u, %p)\n", This, index, connector );
+
+    if (!connector) return E_POINTER;
+    *connector = NULL;
+    if (!This->adapter)
+        return index ? E_INVALIDARG : create_part( This->model, PART_ENDPOINT, &IID_IConnector, (void **)connector );
+    if (index > 1) return E_INVALIDARG;
+    return create_part( This->model, index ? PART_JACK : PART_STREAM, &IID_IConnector, (void **)connector );
+}
+
+static HRESULT WINAPI DT_GetSubunitCount( IDeviceTopology *iface, UINT *count )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+
+    TRACE( "(%p)->(%p)\n", This, count );
+
+    if (!count) return E_POINTER;
+    *count = This->adapter ? 2 : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI DT_GetSubunit( IDeviceTopology *iface, UINT index, ISubUnit **subunit )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+
+    TRACE( "(%p)->(%u, %p)\n", This, index, subunit );
+
+    if (!subunit) return E_POINTER;
+    *subunit = NULL;
+    if (!This->adapter || index > 1) return E_INVALIDARG;
+    return create_part( This->model, index ? PART_MUTE : PART_VOLUME, &IID_ISubUnit, (void **)subunit );
+}
+
+static HRESULT WINAPI DT_GetPartById( IDeviceTopology *iface, UINT id, IPart **part )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+    enum part_index index;
+
+    TRACE( "(%p)->(%#x, %p)\n", This, id, part );
+
+    if (!part) return E_POINTER;
+    *part = NULL;
+    for (index = 0; index < PART_COUNT; index++)
+        if (in_adapter( index ) == This->adapter && local_id( index ) == id)
+            return create_part( This->model, index, &IID_IPart, (void **)part );
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI DT_GetDeviceId( IDeviceTopology *iface, WCHAR **id )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+
+    TRACE( "(%p)->(%p)\n", This, id );
+
+    if (!id) return E_POINTER;
+    *id = co_strdup( This->adapter ? This->model->adapter_id : This->model->endpoint_id );
+    return *id ? S_OK : E_OUTOFMEMORY;
+}
+
+/* the parts from one to the other, both included, along the signal */
+static HRESULT WINAPI DT_GetSignalPath( IDeviceTopology *iface, IPart *from, IPart *to, BOOL reject_mixed,
+                                        IPartsList **parts )
+{
+    struct topology *This = impl_from_IDeviceTopology( iface );
+    enum part_index order[4];
+    UINT from_id, to_id;
+    int start = -1, end = -1, i;
+
+    TRACE( "(%p)->(%p, %p, %d, %p)\n", This, from, to, reject_mixed, parts );
+
+    if (!from || !to || !parts) return E_POINTER;
+    *parts = NULL;
+    if (!This->adapter) return E_NOTFOUND;
+    IPart_GetLocalId( from, &from_id );
+    IPart_GetLocalId( to, &to_id );
+    signal_order( This->model, order );
+    for (i = 0; i < 4; i++)
+    {
+        if (local_id( order[i] ) == from_id) start = i;
+        if (local_id( order[i] ) == to_id) end = i;
+    }
+    if (start < 0 || end < 0 || start > end) return E_NOTFOUND;
+    return create_parts_list( This->model, &order[start], end - start + 1, parts );
+}
