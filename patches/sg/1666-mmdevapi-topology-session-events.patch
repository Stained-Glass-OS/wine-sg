+
+static HRESULT WINAPI level_QueryInterface( IAudioVolumeLevel *iface, REFIID riid, void **out )
+{
+    struct part *This = impl_from_IAudioVolumeLevel( iface );
+
+    if (!out) return E_POINTER;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IPerChannelDbLevel ) ||
+        IsEqualIID( riid, &IID_IAudioVolumeLevel ))
