@@ -50,6 +50,116 @@ extern void set_stream_volumes(struct audio_client *This);
 
 static struct list sessions = LIST_INIT(sessions);
 
+/* Stained Glass OS 1666: session events. Sinks are told outside the
+ * sessions lock: they may call back into the session. */
+struct session_sink
+{
+    struct list entry;
+    IAudioSessionEvents *sink;
+};
+
+struct sink_set
+{
+    IAudioSessionEvents *sinks[32];
+    UINT count;
+};
+
+/* with the sessions lock held */
+static void grab_sinks(struct audio_session *session, struct sink_set *set)
+{
+    struct session_sink *s;
+
+    set->count = 0;
+    LIST_FOR_EACH_ENTRY(s, &session->sinks, struct session_sink, entry) {
+        if (set->count == ARRAY_SIZE(set->sinks)) break;
+        IAudioSessionEvents_AddRef((set->sinks[set->count++] = s->sink));
+    }
+}
+
+static void release_sinks(struct sink_set *set)
+{
+    UINT i;
+    for (i = 0; i < set->count; i++) IAudioSessionEvents_Release(set->sinks[i]);
+    set->count = 0;
+}
+
+/* with the sessions lock held */
+static AudioSessionState session_state(struct audio_session *session)
+{
+    struct is_started_params params;
+    struct audio_client *client;
+
+    if (list_empty(&session->clients))
+        return AudioSessionStateExpired;
+    LIST_FOR_EACH_ENTRY(client, &session->clients, struct audio_client, entry) {
+        if (!client->stream) continue;
+        params.stream = client->stream;
+        wine_unix_call(is_started, &params);
+        if (params.result == S_OK)
+            return AudioSessionStateActive;
+    }
+    return AudioSessionStateInactive;
+}
+
+/* a stream started, stopped, joined or left the session */
+void session_state_changed(struct audio_session *session)
+{
+    struct sink_set set;
+    AudioSessionState state;
+    UINT i;
+
+    if (!session) return;
+    sessions_lock();
+    state = session_state(session);
+    if (state == session->notified_state) {
+        sessions_unlock();
+        return;
+    }
+    session->notified_state = state;
+    grab_sinks(session, &set);
+    sessions_unlock();
+#ifndef SG_MUTANT_NO_SESSION_EVENTS
+    for (i = 0; i < set.count; i++)
+        IAudioSessionEvents_OnStateChanged(set.sinks[i], state);
+#endif
+    release_sinks(&set);
+}
+
+static void notify_simple_volume(struct audio_session *session, const GUID *context)
+{
+    struct sink_set set;
+    float level;
+    BOOL mute;
+    UINT i;
+
+    sessions_lock();
+    level = session->master_vol;
+    mute = session->mute;
+    grab_sinks(session, &set);
+    sessions_unlock();
+#ifndef SG_MUTANT_NO_SESSION_EVENTS
+    for (i = 0; i < set.count; i++)
+        IAudioSessionEvents_OnSimpleVolumeChanged(set.sinks[i], level, mute, context);
+#endif
+    release_sinks(&set);
+}
+
+static void notify_channel_volume(struct audio_session *session, DWORD changed, const GUID *context)
+{
+    float levels[32];
+    struct sink_set set;
+    UINT count, i;
+
+    sessions_lock();
+    count = min(session->channel_count, ARRAY_SIZE(levels));
+    for (i = 0; i < count; i++) levels[i] = session->channel_vols[i];
+    grab_sinks(session, &set);
+    sessions_unlock();
+    for (i = 0; i < set.count; i++)
+        IAudioSessionEvents_OnChannelVolumeChanged(set.sinks[i], count, levels, changed, context);
+    release_sinks(&set);
+}
