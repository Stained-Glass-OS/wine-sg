+static HRESULT create_part( struct model *model, enum part_index index, REFIID riid, void **out )
+{
+    struct part *part;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(part = calloc( 1, sizeof(*part) ))) return E_OUTOFMEMORY;
+    part->IPart_iface.lpVtbl = &part_vtbl;
+    part->IConnector_iface.lpVtbl = &connector_vtbl;
+    part->ISubUnit_iface.lpVtbl = &subunit_vtbl;
+    part->IAudioVolumeLevel_iface.lpVtbl = &level_vtbl;
+    part->IAudioMute_iface.lpVtbl = &mute_vtbl;
+    part->IKsJackDescription_iface.lpVtbl = &jack_vtbl;
+    part->IKsJackDescription2_iface.lpVtbl = &jack2_vtbl;
+    part->ref = 1;
+    part->model = model;
+    part->index = index;
+    model_addref( model );
+    hr = part_QueryInterface( &part->IPart_iface, riid, out );
+    part_Release( &part->IPart_iface );
+    return hr;
+}
