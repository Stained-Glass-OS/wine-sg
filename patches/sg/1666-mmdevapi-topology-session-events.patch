+/* ---- IConnector -------------------------------------------------------------- */
+
+static inline struct part *impl_from_IConnector( IConnector *iface )
+{
+    return CONTAINING_RECORD( iface, struct part, IConnector_iface );
+}
+
+static HRESULT WINAPI connector_QueryInterface( IConnector *iface, REFIID riid, void **out )
+{
+    return part_QueryInterface( &impl_from_IConnector( iface )->IPart_iface, riid, out );
+}
+
+static ULONG WINAPI connector_AddRef( IConnector *iface )
+{
+    return part_AddRef( &impl_from_IConnector( iface )->IPart_iface );
+}
+
+static ULONG WINAPI connector_Release( IConnector *iface )
+{
+    return part_Release( &impl_from_IConnector( iface )->IPart_iface );
+}
+
+static HRESULT WINAPI connector_GetType( IConnector *iface, ConnectorType *type )
+{
+    struct part *This = impl_from_IConnector( iface );
+
+    TRACE( "(%p)->(%p)\n", This, type );
+
+    if (!type) return E_POINTER;
+    switch (This->index)
+    {
+    case PART_STREAM: *type = Software_IO; break;
+    case PART_JACK:
+        *type = (This->model->form_factor == Speakers && This->model->flow == eRender) ||
+                This->model->form_factor == Microphone ? Physical_External : Physical_Internal;
+        if (This->model->form_factor == Headphones || This->model->form_factor == Headset ||
+            This->model->form_factor == LineLevel || This->model->form_factor == SPDIF ||
+            This->model->form_factor == DigitalAudioDisplayDevice)
+            *type = Physical_External;
+        break;
+    default: *type = Physical_External; break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI connector_GetDataFlow( IConnector *iface, DataFlow *flow )
+{
+    struct part *This = impl_from_IConnector( iface );
+    BOOL render = This->model->flow != eCapture;
+
+    TRACE( "(%p)->(%p)\n", This, flow );
+
+    if (!flow) return E_POINTER;
+    /* data comes into the endpoint, and goes from the stream through to the
+     * jack; capture is the other way round */
+    switch (This->index)
+    {
+    case PART_ENDPOINT: *flow = render ? In : Out; break;
+    case PART_STREAM: *flow = render ? In : Out; break;
+    default: *flow = render ? Out : In; break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI connector_ConnectTo( IConnector *iface, IConnector *other )
+{
+    struct part *This = impl_from_IConnector( iface );
+    DataFlow mine, theirs;
+    BOOL connected;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", This, other );
+
+    if (!other) return E_POINTER;
+    /* the jack and the endpoint are linked for good; the stream connector
+     * may be linked to a software connector of the other direction */
+    if (This->index != PART_STREAM) return E_ACCESSDENIED;
+    if (This->model->stream_link) return HRESULT_FROM_WIN32( ERROR_DEVICE_ALREADY_ATTACHED );
+    if (FAILED(hr = IConnector_IsConnected( other, &connected ))) return hr;
+    if (connected) return HRESULT_FROM_WIN32( ERROR_DEVICE_ALREADY_ATTACHED );
+    IConnector_GetDataFlow( iface, &mine );
+    if (FAILED(hr = IConnector_GetDataFlow( other, &theirs ))) return hr;
+    if (mine == theirs) return E_INVALIDARG;
+    EnterCriticalSection( &This->model->cs );
+    IConnector_AddRef( (This->model->stream_link = other) );
+    LeaveCriticalSection( &This->model->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI connector_Disconnect( IConnector *iface )
+{
+    struct part *This = impl_from_IConnector( iface );
+    IConnector *link;
+
+    TRACE( "(%p)\n", This );
+
+    if (This->index != PART_STREAM) return E_ACCESSDENIED;
+    EnterCriticalSection( &This->model->cs );
+    link = This->model->stream_link;
+    This->model->stream_link = NULL;
+    LeaveCriticalSection( &This->model->cs );
+    if (!link) return E_NOTFOUND;
+    IConnector_Release( link );
+    return S_OK;
+}
+
+static HRESULT WINAPI connector_IsConnected( IConnector *iface, BOOL *connected )
+{
+    struct part *This = impl_from_IConnector( iface );
+
+    if (!connected) return E_POINTER;
+    *connected = This->index != PART_STREAM || This->model->stream_link != NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI connector_GetConnectedTo( IConnector *iface, IConnector **to )
+{
+    struct part *This = impl_from_IConnector( iface );
+
+    TRACE( "(%p)->(%p)\n", This, to );
+
+    if (!to) return E_POINTER;
+    *to = NULL;
+    switch (This->index)
+    {
+    case PART_ENDPOINT: return create_part( This->model, PART_JACK, &IID_IConnector, (void **)to );
+    case PART_JACK: return create_part( This->model, PART_ENDPOINT, &IID_IConnector, (void **)to );
+    default:
+        if (!This->model->stream_link) return E_NOTFOUND;
+        IConnector_AddRef( (*to = This->model->stream_link) );
+        return S_OK;
+    }
+}
+
+static HRESULT WINAPI connector_GetConnectorIdConnectedTo( IConnector *iface, WCHAR **id )
+{
+    struct part *This = impl_from_IConnector( iface );
+    IConnector *to;
+    IPart *part;
+    HRESULT hr;
+
+    if (!id) return E_POINTER;
+    *id = NULL;
+    if (FAILED(hr = connector_GetConnectedTo( iface, &to ))) return hr;
+    if (SUCCEEDED(hr = IConnector_QueryInterface( to, &IID_IPart, (void **)&part )))
+    {
+        hr = IPart_GetGlobalId( part, id );
+        IPart_Release( part );
+    }
+    IConnector_Release( to );
+    TRACE( "(%p) -> %s\n", This, debugstr_w( *id ) );
+    return hr;
+}
+
+static HRESULT WINAPI connector_GetDeviceIdConnectedTo( IConnector *iface, WCHAR **id )
+{
+    struct part *This = impl_from_IConnector( iface );
+    IDeviceTopology *topology;
+    IConnector *to;
+    IPart *part;
+    HRESULT hr;
+
+    if (!id) return E_POINTER;
+    *id = NULL;
+    switch (This->index)
+    {
+    case PART_ENDPOINT: return (*id = co_strdup( This->model->adapter_id )) ? S_OK : E_OUTOFMEMORY;
+    case PART_JACK: return (*id = co_strdup( This->model->endpoint_id )) ? S_OK : E_OUTOFMEMORY;
+    default:
+        if (FAILED(hr = connector_GetConnectedTo( iface, &to ))) return hr;
+        if (SUCCEEDED(hr = IConnector_QueryInterface( to, &IID_IPart, (void **)&part )))
+        {
+            if (SUCCEEDED(hr = IPart_GetTopologyObjects( part, &topology )))
+            {
+                hr = IDeviceTopology_GetDeviceId( topology, id );
+                IDeviceTopology_Release( topology );
+            }
+            IPart_Release( part );
+        }
+        IConnector_Release( to );
+        return hr;
+    }
+}
+
+static const IConnectorVtbl connector_vtbl =
+{
+    connector_QueryInterface,
+    connector_AddRef,
+    connector_Release,
+    connector_GetType,
+    connector_GetDataFlow,
+    connector_ConnectTo,
+    connector_Disconnect,
+    connector_IsConnected,
+    connector_GetConnectedTo,
+    connector_GetConnectorIdConnectedTo,
+    connector_GetDeviceIdConnectedTo,
+};
