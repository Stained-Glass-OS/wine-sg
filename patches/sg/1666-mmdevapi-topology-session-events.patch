+{
+    return CONTAINING_RECORD( iface, struct part, IKsJackDescription_iface );
+}
+
+static HRESULT WINAPI jack_QueryInterface( IKsJackDescription *iface, REFIID riid, void **out )
+{
+    struct part *This = impl_from_IKsJackDescription( iface );
+
+    if (!out) return E_POINTER;
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IKsJackDescription ))
+    {
+        *out = iface;
+        IKsJackDescription_AddRef( iface );
+        return S_OK;
+    }
+    if (IsEqualIID( riid, &IID_IKsJackDescription2 ))
+    {
+        *out = &This->IKsJackDescription2_iface;
+        IKsJackDescription2_AddRef( &This->IKsJackDescription2_iface );
+        return S_OK;
+    }
+    return part_QueryInterface( &This->IPart_iface, riid, out );
+}
+
+static ULONG WINAPI jack_AddRef( IKsJackDescription *iface )
+{
+    return part_AddRef( &impl_from_IKsJackDescription( iface )->IPart_iface );
+}
+
+static ULONG WINAPI jack_Release( IKsJackDescription *iface )
+{
+    return part_Release( &impl_from_IKsJackDescription( iface )->IPart_iface );
+}
+
+static HRESULT WINAPI jack_GetJackCount( IKsJackDescription *iface, UINT *count )
+{
+    if (!count) return E_POINTER;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI jack_GetJackDescription( IKsJackDescription *iface, UINT index, KSJACK_DESCRIPTION *desc )
+{
+    struct part *This = impl_from_IKsJackDescription( iface );
+    struct model *model = This->model;
+
+    if (!desc) return E_POINTER;
+    if (index) return E_INVALIDARG;
+    memset( desc, 0, sizeof(*desc) );
+    desc->ChannelMapping = model->flow == eCapture ? 0 : model->channel_mask;
+    desc->GenLocation = eGenLocPrimaryBox;
+    desc->PortConnection = ePortConnJack;
+    desc->IsConnected = TRUE;
+    switch (model->form_factor)
+    {
+    case DigitalAudioDisplayDevice:
+        desc->ConnectionType = eConnTypeOtherDigital;
+        desc->GeoLocation = eGeoLocHDMI;
+        break;
+    case SPDIF:
+        desc->ConnectionType = eConnTypeOptical;
+        desc->GeoLocation = eGeoLocRear;
+        break;
+    case Speakers:
+    case Microphone:
+        /* a laptop's own speakers and microphone */
+        desc->ConnectionType = eConnTypeAtapiInternal;
+        desc->GeoLocation = eGeoLocFront;
+        desc->GenLocation = eGenLocInternal;
+        desc->PortConnection = ePortConnIntegratedDevice;
+        break;
+    default:
+        desc->ConnectionType = eConnType3Point5mm;
+        desc->GeoLocation = model->form_factor == Headphones || model->form_factor == Headset ? eGeoLocFront :
+                            eGeoLocRear;
+        break;
+    }
+    /* the PC 99 colours of the jacks: green out, pink in */
+    desc->Color = model->flow == eCapture ? RGB(0xff, 0x80, 0xc0) : RGB(0x00, 0xb0, 0x00);
+    return S_OK;
+}
+
+static const IKsJackDescriptionVtbl jack_vtbl =
+{
+    jack_QueryInterface,
+    jack_AddRef,
+    jack_Release,
+    jack_GetJackCount,
+    jack_GetJackDescription,
+};
