 static HRESULT WINAPI uia_element_GetClickablePoint(IUIAutomationElement9 *iface, POINT *clickable, BOOL *got_clickable)
 {
-    FIXME("%p: stub\n", iface);
-    return E_NOTIMPL;
+    struct uia_element *element = impl_from_IUIAutomationElement9(iface);
+    VARIANT v;
+    RECT rect;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", iface, clickable, got_clickable);
+
+    if (!clickable || !got_clickable)
+        return E_POINTER;
+
+    *got_clickable = FALSE;
+    clickable->x = clickable->y = 0;
+
+    /* what the provider says is clickable, else the middle of the element */
+    VariantInit(&v);
+    if (SUCCEEDED(UiaGetPropertyValue(element->node, UIA_ClickablePointPropertyId, &v))
+            && V_VT(&v) == (VT_R8 | VT_ARRAY) && V_ARRAY(&v))
+    {
+        double *vals;
+
+        if (SUCCEEDED(SafeArrayAccessData(V_ARRAY(&v), (void **)&vals)))
+        {
+            clickable->x = vals[0];
+            clickable->y = vals[1];
+            *got_clickable = TRUE;
+            SafeArrayUnaccessData(V_ARRAY(&v));
+        }
+    }
+    VariantClear(&v);
+    if (*got_clickable)
+        return S_OK;
+
+    VariantInit(&v);
+    if (FAILED(hr = UiaGetPropertyValue(element->node, UIA_BoundingRectanglePropertyId, &v)))
+        return hr;
+    uia_variant_rect_to_rect(&v, &rect);
+    VariantClear(&v);
+    if (rect.right > rect.left && rect.bottom > rect.top)
+    {
+#ifdef SG_MUTANT_UIACOM_CLICK_CORNER
+        clickable->x = rect.left - 10;
+        clickable->y = rect.top - 10;
+#else
+        clickable->x = rect.left + (rect.right - rect.left) / 2;
+        clickable->y = rect.top + (rect.bottom - rect.top) / 2;
+#endif
+        *got_clickable = TRUE;
+    }
+    return S_OK;
 }
 
