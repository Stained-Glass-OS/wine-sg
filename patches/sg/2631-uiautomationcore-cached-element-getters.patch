+/* ---- the properties of an element that were cached with it ---- */
+
+static struct uia_cache_property *element_find_cached(struct uia_element *element, PROPERTYID prop_id)
+{
+    if (!element->cached_props)
+        return NULL;
+    return bsearch(&prop_id, element->cached_props, element->cached_props_count, sizeof(*element->cached_props),
+            uia_cached_property_id_compare);
+}
+
+static HRESULT cached_get_bstr(struct uia_element *element, PROPERTYID prop_id, BSTR *ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+#ifdef SG_MUTANT_UIACOM_CACHED_STUB
+    return E_NOTIMPL;
+#endif
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+    *ret_val = SysAllocString(V_VT(&prop->prop_val) == VT_BSTR && V_BSTR(&prop->prop_val) ? V_BSTR(&prop->prop_val) : L"");
+    return *ret_val ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT cached_get_bool(struct uia_element *element, PROPERTYID prop_id, BOOL *ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_UIACOM_BOOL_INVERTED
+    *ret_val = !(V_VT(&prop->prop_val) == VT_BOOL && V_BOOL(&prop->prop_val) == VARIANT_TRUE);
+#else
+    *ret_val = V_VT(&prop->prop_val) == VT_BOOL && V_BOOL(&prop->prop_val) == VARIANT_TRUE;
+#endif
+    return S_OK;
+}
+
+static HRESULT cached_get_int(struct uia_element *element, PROPERTYID prop_id, int *ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+    *ret_val = V_VT(&prop->prop_val) == VT_I4 ? V_I4(&prop->prop_val) : 0;
+    return S_OK;
+}
+
+static HRESULT cached_get_hwnd(struct uia_element *element, PROPERTYID prop_id, UIA_HWND *ret_val)
+{
+    int h = 0;
+    HRESULT hr = cached_get_int(element, prop_id, &h);
+
+    if (ret_val)
+        *ret_val = (UIA_HWND)(LONG_PTR)h;
+    return hr;
+}
+
+/* an element, or an array of them, a property gives: the value was made into a COM object when it
+ * was fetched; nothing set is no object */
+static HRESULT variant_get_element(const VARIANT *v, IUIAutomationElement **ret_val)
+{
+    *ret_val = NULL;
+    /* what is not an element (the object that says "not supported") is no element */
+    if (V_VT(v) == VT_UNKNOWN && V_UNKNOWN(v))
+        IUnknown_QueryInterface(V_UNKNOWN(v), &IID_IUIAutomationElement, (void **)ret_val);
+    return S_OK;
+}
+
+static HRESULT variant_get_elements(const VARIANT *v, IUIAutomationElementArray **ret_val)
+{
+    HRESULT hr;
+
+    *ret_val = NULL;
+    if (V_VT(v) == VT_UNKNOWN && V_UNKNOWN(v))
+        IUnknown_QueryInterface(V_UNKNOWN(v), &IID_IUIAutomationElementArray, (void **)ret_val);
+    if (*ret_val)
+        return S_OK;
+#ifdef SG_MUTANT_UIACOM_ARRAY_NULL
+    return S_OK;
+#endif
+    /* none: an empty array */
+    if (FAILED(hr = create_uia_element_array_iface(ret_val, 0)))
+        return hr;
+    return S_OK;
+}
+
+static HRESULT cached_get_element(struct uia_element *element, PROPERTYID prop_id, IUIAutomationElement **ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+    return variant_get_element(&prop->prop_val, ret_val);
+}
+
+static HRESULT cached_get_elements(struct uia_element *element, PROPERTYID prop_id, IUIAutomationElementArray **ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+    return variant_get_elements(&prop->prop_val, ret_val);
+}
+
+static HRESULT cached_get_array(struct uia_element *element, PROPERTYID prop_id, SAFEARRAY **ret_val)
+{
+    struct uia_cache_property *prop;
+
+    if (!ret_val)
+        return E_POINTER;
+    *ret_val = NULL;
+    if (!(prop = element_find_cached(element, prop_id)))
+        return E_INVALIDARG;
+    if ((V_VT(&prop->prop_val) & VT_ARRAY) && V_ARRAY(&prop->prop_val))
+        return SafeArrayCopy(V_ARRAY(&prop->prop_val), ret_val);
+    return S_OK;
+}
+
+static HRESULT element_get_element(struct uia_element *element, PROPERTYID prop_id, IUIAutomationElement **ret_val)
+{
+    const struct uia_prop_info *info = uia_prop_info_from_id(prop_id);
+    VARIANT v;
+    HRESULT hr;
+
+    if (!ret_val)
+        return E_POINTER;
+    *ret_val = NULL;
+    VariantInit(&v);
+    if (FAILED(hr = UiaGetPropertyValue(element->node, prop_id, &v)))
+        return hr;
+    if (V_VT(&v) == VT_UNKNOWN || V_VT(&v) == VT_EMPTY)
+    {
+        /* not supported, or not set */
+        VariantClear(&v);
+        return S_OK;
+    }
+    if (FAILED(hr = get_element_variant_from_node_variant(&v, element->from_cui8, info ? info->type : UIAutomationType_Element)))
+        return hr;
+    hr = variant_get_element(&v, ret_val);
+    VariantClear(&v);
+    return hr;
+}
+
+static HRESULT element_get_elements(struct uia_element *element, PROPERTYID prop_id, IUIAutomationElementArray **ret_val)
+{
+    const struct uia_prop_info *info = uia_prop_info_from_id(prop_id);
+    VARIANT v;
+    HRESULT hr;
+
+    if (!ret_val)
+        return E_POINTER;
+    *ret_val = NULL;
+    VariantInit(&v);
+    if (FAILED(hr = UiaGetPropertyValue(element->node, prop_id, &v)))
+        return hr;
+    if (V_VT(&v) != VT_UNKNOWN && V_VT(&v) != VT_EMPTY && (V_VT(&v) & VT_ARRAY)
+            && FAILED(hr = get_element_variant_from_node_variant(&v, element->from_cui8,
+                    info ? info->type : UIAutomationType_ElementArray)))
+        return hr;
+    hr = variant_get_elements(&v, ret_val);
+    VariantClear(&v);
+    return hr;
+}
+
+static HRESULT element_get_array(struct uia_element *element, PROPERTYID prop_id, SAFEARRAY **ret_val)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    if (!ret_val)
+        return E_POINTER;
+    *ret_val = NULL;
+    VariantInit(&v);
+    if (FAILED(hr = UiaGetPropertyValue(element->node, prop_id, &v)))
+        return hr;
+    if ((V_VT(&v) & VT_ARRAY) && V_ARRAY(&v))
+        hr = SafeArrayCopy(V_ARRAY(&v), ret_val);
+    VariantClear(&v);
+    return hr;
+}
