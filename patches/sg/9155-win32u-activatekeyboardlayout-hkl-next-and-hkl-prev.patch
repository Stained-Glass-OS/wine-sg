From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: ActivateKeyboardLayout with HKL_NEXT and HKL_PREV (9155)

ActivateKeyboardLayout(HKL_NEXT) and (HKL_PREV) activate the next or the
previous layout of the loaded list, after the last the first -- what
input-language switchers and AutoHotkey scripts that cycle layouts call.
Wine failed them with ERROR_CALL_NOT_IMPLEMENTED. Now they take the layout
after or before the thread's in GetKeyboardLayoutList (the first when the
thread's is not in it) and activate it as any other, returning the
previous layout.

Gate: test/kbdgroups-gate.sh (the session's two layouts). Mutant
SG_MUTANT_KBD_NO_NEXT.
---
 dlls/win32u/input.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -1444,9 +1444,24 @@ HKL WINAPI NtUserActivateKeyboardLayout( HKL layout, UINT flags )
 
     if (layout == (HKL)HKL_NEXT || layout == (HKL)HKL_PREV)
     {
+#ifndef SG_MUTANT_KBD_NO_NEXT
+        /* Stained Glass OS (9155): the next or previous layout of the loaded list (GetKeyboardLayoutList),
+         * after the last the first, as the input-language hotkeys go */
+        HKL list[64], current = NtUserGetKeyboardLayout( 0 );
+        UINT count = NtUserGetKeyboardLayoutList( ARRAY_SIZE(list), list ), i;
+
+        if (count > ARRAY_SIZE(list)) count = ARRAY_SIZE(list);
+        if (!count) return 0;
+        for (i = 0; i < count; i++) if (list[i] == current) break;
+        if (i == count) layout = list[0];
+        else if (layout == (HKL)HKL_NEXT) layout = list[(i + 1) % count];
+        else layout = list[(i + count - 1) % count];
+        TRACE_(keyboard)( "HKL_NEXT/HKL_PREV: %p\n", layout );
+#else
         RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
         FIXME_(keyboard)( "HKL_NEXT and HKL_PREV not supported\n" );
         return 0;
+#endif
     }
 
     if (LOWORD(layout) != MAKELANGID(LANG_INVARIANT, SUBLANG_DEFAULT) &&
