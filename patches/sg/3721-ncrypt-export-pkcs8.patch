From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ncrypt: NCryptExportKey PKCS #8 private key blobs (3721)

ncrypt: NCryptExportKey PKCS #8 private key blobs

Unencrypted PrivateKeyInfo for RSA and P-256/P-384 EC keys, behind the
usual export policy. Details in notes/3721.txt.

Rebased at integration (integ-2026-10) onto 5621 (stubs-6d): NCryptExportKey(PKCS8_PRIVATEKEY) was implemented twice; merged: an RSA key exported in the clear or under an NCRYPTBUFFER_PKCS_SECRET goes through 5621's pkcs8_export (PBES2), EC keys and keys wrapped for another key through 3721's export_pkcs8; 3721's NTE_BAD_FLAGS check kept; parameter buffers on any other blob type stay NTE_NOT_SUPPORTED. The export policy check before both is unchanged.
---
diff --git a/dlls/ncrypt/main.c b/dlls/ncrypt/main.c
--- a/dlls/ncrypt/main.c
+++ b/dlls/ncrypt/main.c
@@ -1272,6 +1272,213 @@ static BOOL is_private_blob(const WCHAR *type)
            !lstrcmpW(type, BCRYPT_DH_PRIVATE_BLOB) || !lstrcmpW(type, L"PKCS8_PRIVATEKEY");
 }
 
+/* ---- PKCS #8 export (NCRYPT_PKCS8_PRIVATE_KEY_BLOB) ----
+ * An unencrypted PrivateKeyInfo (RFC 5208): RSA keys carry an RSAPrivateKey
+ * (RFC 8017) under rsaEncryption, EC keys an ECPrivateKey (RFC 5915) under
+ * id-ecPublicKey with the named curve. */
+struct der
+{
+    BYTE *data;
+    DWORD len, cap;
+    BOOL failed;
+};
+
+static void der_put(struct der *d, const BYTE *src, DWORD n)
+{
+    if (d->failed) return;
+    if (d->len + n > d->cap)
+    {
+        DWORD cap = max(d->cap * 2, d->len + n + 64);
+        BYTE *p = realloc(d->data, cap);
+        if (!p) { d->failed = TRUE; return; }
+        d->data = p;
+        d->cap = cap;
+    }
+    if (n) memcpy(d->data + d->len, src, n);
+    d->len += n;
+}
+
+static void der_header(struct der *d, BYTE tag, DWORD len)
+{
+    BYTE h[6];
+    DWORD n = 0;
+
+    h[n++] = tag;
+    if (len < 0x80) h[n++] = len;
+    else if (len < 0x100) { h[n++] = 0x81; h[n++] = len; }
+    else if (len < 0x10000) { h[n++] = 0x82; h[n++] = len >> 8; h[n++] = len; }
+    else { h[n++] = 0x83; h[n++] = len >> 16; h[n++] = len >> 8; h[n++] = len; }
+    der_put(d, h, n);
+}
+
+/* appends tag, length and the content of `inner` */
+static void der_wrap(struct der *d, BYTE tag, const struct der *inner)
+{
+    if (inner->failed) { d->failed = TRUE; return; }
+    der_header(d, tag, inner->len);
+    der_put(d, inner->data, inner->len);
+}
+
+/* big-endian unsigned integer */
+static void der_uint(struct der *d, const BYTE *be, DWORD n)
+{
+    BYTE zero = 0;
+
+    while (n > 1 && !be[0]) { be++; n--; }
+#ifdef SG_MUTANT_P8_NOSIGN
+    zero = 0;
+    der_header(d, 0x02, n);
+#else
+    der_header(d, 0x02, n + ((n && (be[0] & 0x80)) ? 1 : 0));
+    if (n && (be[0] & 0x80)) der_put(d, &zero, 1);
+#endif
+    der_put(d, be, n);
+}
+
+static void der_small_int(struct der *d, BYTE v)
+{
+    der_uint(d, &v, 1);
+}
+
+static SECURITY_STATUS export_pkcs8(struct object *object, BYTE **out, DWORD *out_len)
+{
+    static const BYTE oid_rsa[] = { 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01 };
+    static const BYTE oid_ec[] = { 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01 };
+    static const BYTE oid_p256[] = { 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07 };
+    static const BYTE oid_p384[] = { 0x2b, 0x81, 0x04, 0x00, 0x22 };
+    struct der key = {0}, alg = {0}, info = {0}, tmp = {0}, inner = {0};
+    BYTE *blob = NULL, null_param[2] = { 0x05, 0x00 };
+    DWORD blob_len;
+    SECURITY_STATUS ret = NTE_NOT_SUPPORTED;
+    const WCHAR *blob_type;
+    NTSTATUS status;
+
+    switch (object->key.algid)
+    {
+    case RSA: blob_type = BCRYPT_RSAFULLPRIVATE_BLOB; break;
+    case ECDSA_P256: case ECDSA_P384: case ECDH_P256: case ECDH_P384: blob_type = BCRYPT_ECCPRIVATE_BLOB; break;
+    default:
+        WARN("PKCS #8 export of algorithm %d is not supported\n", object->key.algid);
+        return NTE_NOT_SUPPORTED;
+    }
+
+    if ((status = BCryptExportKey(object->key.bcrypt_key, NULL, blob_type, NULL, 0, &blob_len, 0)))
+        return map_ntstatus(status);
+    if (!(blob = malloc(blob_len))) return NTE_NO_MEMORY;
+    if ((status = BCryptExportKey(object->key.bcrypt_key, NULL, blob_type, blob, blob_len, &blob_len, 0)))
+    {
+        ret = map_ntstatus(status);
+        goto done;
+    }
+
+    if (object->key.algid == RSA)
+    {
+        const BCRYPT_RSAKEY_BLOB *rsa = (const BCRYPT_RSAKEY_BLOB *)blob;
+        const BYTE *p = (const BYTE *)(rsa + 1);
+        const BYTE *e, *n, *p1, *p2, *dp, *dq, *iq, *dd;
+        DWORD mod = rsa->cbModulus, h = rsa->cbPrime1, l = rsa->cbPrime2;
+
+        if (blob_len < sizeof(*rsa) + rsa->cbPublicExp + 2 * mod + 3 * h + 2 * l || rsa->Magic != BCRYPT_RSAFULLPRIVATE_MAGIC)
+        {
+            ret = NTE_BAD_KEY;
+            goto done;
+        }
+        e = p; p += rsa->cbPublicExp;
+        n = p; p += mod;
+        p1 = p; p += h;
+        p2 = p; p += l;
+        dp = p; p += h;
+        dq = p; p += l;
+        iq = p; p += h;
+        dd = p;
+        der_small_int(&tmp, 0);
+        der_uint(&tmp, n, mod);
+        der_uint(&tmp, e, rsa->cbPublicExp);
+        der_uint(&tmp, dd, mod);
+#ifdef SG_MUTANT_P8_SWAPPQ
+        der_uint(&tmp, p2, l);
+        der_uint(&tmp, p1, h);
+#else
+        der_uint(&tmp, p1, h);
+        der_uint(&tmp, p2, l);
+#endif
+        der_uint(&tmp, dp, h);
+        der_uint(&tmp, dq, l);
+        der_uint(&tmp, iq, h);
+        der_wrap(&key, 0x30, &tmp);
+
+        der_header(&alg, 0x06, sizeof(oid_rsa));
+        der_put(&alg, oid_rsa, sizeof(oid_rsa));
+        der_put(&alg, null_param, 2);
+    }
+    else
+    {
+        const BCRYPT_ECCKEY_BLOB *ec = (const BCRYPT_ECCKEY_BLOB *)blob;
+        const BYTE *x = (const BYTE *)(ec + 1), *y, *d;
+#ifdef SG_MUTANT_P8_CURVE
+        BOOL p384 = FALSE;
+#else
+        BOOL p384 = object->key.algid == ECDSA_P384 || object->key.algid == ECDH_P384;
+#endif
+        const BYTE *curve = p384 ? oid_p384 : oid_p256;
+        DWORD curve_len = p384 ? sizeof(oid_p384) : sizeof(oid_p256), cb = ec->cbKey;
+        BYTE one = 1, zero = 0;
+
+        if (blob_len < sizeof(*ec) + 3 * cb)
+        {
+            ret = NTE_BAD_KEY;
+            goto done;
+        }
+        y = x + cb;
+        d = y + cb;
+        der_small_int(&tmp, 1);
+        der_header(&tmp, 0x04, cb);
+        der_put(&tmp, d, cb);
+        /* [1] publicKey: BIT STRING 0x04 || X || Y */
+        der_header(&inner, 0x03, 2 * cb + 2);
+        der_put(&inner, &zero, 1);
+        { BYTE unc = 4; der_put(&inner, &unc, 1); }
+        der_put(&inner, x, cb);
+        der_put(&inner, y, cb);
+#ifndef SG_MUTANT_P8_NOPUB
+        der_header(&tmp, 0xa1, inner.len);
+        der_put(&tmp, inner.data, inner.len);
+#endif
+        (void)one;
+        der_wrap(&key, 0x30, &tmp);
+
+        der_header(&alg, 0x06, sizeof(oid_ec));
+        der_put(&alg, oid_ec, sizeof(oid_ec));
+        der_header(&alg, 0x06, curve_len);
+        der_put(&alg, curve, curve_len);
+    }
+
+    /* PrivateKeyInfo ::= SEQUENCE { version 0, AlgorithmIdentifier, OCTET STRING privateKey } */
+    {
+        struct der body = {0}, algseq = {0};
+
+        der_small_int(&body, 0);
+        der_wrap(&algseq, 0x30, &alg);
+        der_put(&body, algseq.data, algseq.len);
+        free(algseq.data);
+        der_wrap(&body, 0x04, &key);
+        der_wrap(&info, 0x30, &body);
+        free(body.data);
+    }
+    if (info.failed) { ret = NTE_NO_MEMORY; goto done; }
+    *out = info.data;
+    *out_len = info.len;
+    info.data = NULL;
+    ret = ERROR_SUCCESS;
+
+done:
+    if (blob) { SecureZeroMemory(blob, blob_len); free(blob); }
+    if (key.data) SecureZeroMemory(key.data, key.len);
+    if (tmp.data) SecureZeroMemory(tmp.data, tmp.len);
+    free(key.data); free(alg.data); free(info.data); free(tmp.data); free(inner.data);
+    return ret;
+}
+
 SECURITY_STATUS WINAPI NCryptExportKey(NCRYPT_KEY_HANDLE key, NCRYPT_KEY_HANDLE encrypt_key, const WCHAR *type,
                                        NCryptBufferDesc *params, BYTE *output, DWORD output_len, DWORD *ret_len,
                                        DWORD flags)
@@ -1284,12 +1491,16 @@ SECURITY_STATUS WINAPI NCryptExportKey(NCRYPT_KEY_HANDLE key, NCRYPT_KEY_HANDLE
     if (!object) return NTE_INVALID_HANDLE;
     if (!type || !ret_len) return NTE_INVALID_PARAMETER;
     if (!object->key.finalized || !object->key.bcrypt_key) return NTE_BAD_KEY_STATE;
-    if (params && lstrcmpW(type, L"PKCS8_PRIVATEKEY"))
+    if (flags & ~NCRYPT_SILENT_FLAG) return NTE_BAD_FLAGS;
+    if (params && params->cBuffers && lstrcmpW(type, L"PKCS8_PRIVATEKEY"))
     {
-        FIXME("Parameter information not implemented\n");
+        /* NCRYPT_PKCS8_PRIVATE_KEY_BLOB takes NCRYPTBUFFER_PKCS_ALG_OID, _ALG_PARAM and _SECRET to
+         * produce an encrypted PrivateKeyInfo, and NCRYPT_PKCS7_ENVELOPE_BLOB needs a certificate
+         * plus an algorithm: the layout of the buffers is not documented, so no guess is made. */
+        FIXME("Parameter information (%lu buffers) for %s is not implemented\n", params->cBuffers,
+              debugstr_w(type));
         return NTE_NOT_SUPPORTED;
     }
-    if (flags & ~NCRYPT_SILENT_FLAG) return NTE_BAD_FLAGS;
     /* a private key leaves in the clear only if its export policy allows
      * that; wrapped for another key (encrypt_key) it only needs the
      * weaker "exportable at all" flag, same as Windows: that is the
@@ -1308,9 +1519,29 @@ SECURITY_STATUS WINAPI NCryptExportKey(NCRYPT_KEY_HANDLE key, NCRYPT_KEY_HANDLE
 
     if (!lstrcmpW(type, L"PKCS8_PRIVATEKEY"))
     {
-        /* an RSA key, with an optional secret to encrypt it under */
-        if (encrypt_key || object->key.algid != RSA) return NTE_NOT_SUPPORTED;
-        return pkcs8_export(object->key.bcrypt_key, params, output, output_len, ret_len);
+        BYTE *der = NULL;
+        DWORD der_len = 0;
+        SECURITY_STATUS ret;
+
+        /* an RSA key in the clear or under a secret (5621); other keys, and keys
+         * wrapped for another key, as a plain PrivateKeyInfo (3721) */
+        if (object->key.algid == RSA && !encrypt_key)
+            return pkcs8_export(object->key.bcrypt_key, params, output, output_len, ret_len);
+        if (params && params->cBuffers) return NTE_NOT_SUPPORTED;
+        if ((ret = export_pkcs8(object, &der, &der_len))) return ret;
+        if (encrypt_key) ret = wrap_key_for_transport(encrypt_key, der, der_len, output, output_len, ret_len);
+        else
+        {
+            *ret_len = der_len;
+            if (output)
+            {
+                if (output_len < der_len) ret = NTE_BUFFER_TOO_SMALL;
+                else memcpy(output, der, der_len);
+            }
+        }
+        SecureZeroMemory(der, der_len);
+        free(der);
+        return ret;
     }
 
     if (encrypt_key)
