From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a shell item's PKEY_DescriptionID

IShellItem2::GetProperty(PKEY_DescriptionID) gave S_OK with no value. OneDrive's sync service asks it of C:\ while setting up (to learn the drive's type) and read the buffer it expects through a null pointer: OneDrive.Sync.Service.exe crashed during OneDrive setup. It is now the item's SHDESCRIPTIONID as a byte vector, as SHGetDataFromIDList gives it: a fixed drive, a folder, a file, a registered item.
---
diff --git a/dlls/shell32/shellitem.c b/dlls/shell32/shellitem.c
index 3f402e3..f274914 100644
--- a/dlls/shell32/shellitem.c
+++ b/dlls/shell32/shellitem.c
@@ -532,6 +532,22 @@ static HRESULT shellitem_get_variant(struct shell_item *This, const PROPERTYKEY
     LPCITEMIDLIST child;
     HRESULT hr;
 
+#ifndef SG_MUTANT_NO_ITEM_DESCRIPTION_ID
+    /* what kind of item it is (SHDESCRIPTIONID, as a buffer): a drive's type, a folder, a file, a
+     * registered item; OneDrive's sync service asks it of C:\ */
+    if (IsEqualPropertyKey(*key, PKEY_DescriptionID) && !_ILIsDesktop(This->pidl))
+    {
+        SHDESCRIPTIONID desc;
+        IShellFolder *parent;
+
+        PropVariantInit(var);
+        if (FAILED(hr = SHBindToParent(This->pidl, &IID_IShellFolder, (void **)&parent, &child))) return hr;
+        hr = SHGetDataFromIDListW(parent, child, SHGDFIL_DESCRIPTIONID, &desc, sizeof(desc));
+        IShellFolder_Release(parent);
+        if (FAILED(hr)) return hr;
+        return InitPropVariantFromBuffer(&desc, sizeof(desc), var);
+    }
+#endif
     hr = shellitem_get_value(This, key, var);
     if (FAILED(hr) || var->vt != VT_EMPTY || _ILIsDesktop(This->pidl))
         return hr;
