From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: Alt+F4 on the desktop or the taskbar asks

Alt+F4 with the desktop focused signed out at once (DefWindowProc's SC_CLOSE
reached the desktop, which called ExitWindows), and with the taskbar focused
-- as it is after the last window closes -- it hid the taskbar for good
(QA B18). Both now open the "Shut Down" dialog: "What do you want the
computer to do?" with Sign out, Restart and Shut down (the default), OK and
Cancel; OK calls ExitWindowsEx (0241 hands shutting down and restarting to
the system). Escape keeps the session. Built from an in-memory template, one
at a time.

Alt+F4 in File Explorer's windows already closed them (DefWindowProc); the
Terminal's is sg-shell's.

Gate: test/desktop-gate.sh (make test-desktop).
---
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -1199,6 +1199,86 @@
     sg_dump();
 }
 
+/* Stained Glass OS: Alt+F4 on the desktop or the taskbar asks, as Windows'
+ * "Shut Down" dialog does -- it used to sign out at once (the desktop) or
+ * hide the taskbar for good. "What do you want the computer to do?" */
+#define SG_SD_COMBO 100
+static INT_PTR CALLBACK sg_shutdown_proc( HWND dlg, UINT msg, WPARAM wp, LPARAM lp )
+{
+    static const WCHAR *const choices[] = { L"Sign out", L"Restart", L"Shut down" };
+    HWND combo = GetDlgItem( dlg, SG_SD_COMBO );
+    unsigned int i;
+
+    switch (msg)
+    {
+    case WM_INITDIALOG:
+        for (i = 0; i < ARRAY_SIZE(choices); i++) SendMessageW( combo, CB_ADDSTRING, 0, (LPARAM)choices[i] );
+        SendMessageW( combo, CB_SETCURSEL, 2, 0 );
+        SetForegroundWindow( dlg );
+        SetFocus( combo );
+        return FALSE;
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDOK) EndDialog( dlg, 1 + SendMessageW( combo, CB_GETCURSEL, 0, 0 ) );
+        else if (LOWORD(wp) == IDCANCEL) EndDialog( dlg, 0 );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void *sg_dlg_word( void *p, WORD w ) { *(WORD *)p = w; return (WORD *)p + 1; }
+static void *sg_dlg_str( void *p, const WCHAR *s ) { size_t n = wcslen( s ) + 1; memcpy( p, s, n * sizeof(WCHAR) ); return (WCHAR *)p + n; }
+
+static void *sg_dlg_item( void *p, DWORD style, short x, short y, short cx, short cy, WORD id, WORD cls, const WCHAR *text )
+{
+    DLGITEMTEMPLATE *it;
+    p = (void *)(((ULONG_PTR)p + 3) & ~3);
+    it = p;
+    it->style = style | WS_CHILD | WS_VISIBLE;
+    it->dwExtendedStyle = 0;
+    it->x = x; it->y = y; it->cx = cx; it->cy = cy; it->id = id;
+    p = it + 1;
+    p = sg_dlg_word( p, 0xffff );
+    p = sg_dlg_word( p, cls );
+    p = sg_dlg_str( p, text );
+    return sg_dlg_word( p, 0 );
+}
+
+static BOOL sg_shutdown_busy;
+
+void shell_shutdown_dialog(void)
+{
+    static WORD buf[512];
+    DLGTEMPLATE *t = (DLGTEMPLATE *)buf;
+    void *p;
+    INT_PTR choice;
+
+    if (sg_shutdown_busy) return;
+    memset( buf, 0, sizeof(buf) );
+    t->style = DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU;
+    t->cdit = 4;
+    t->cx = 230; t->cy = 82;
+    p = t + 1;
+    p = sg_dlg_word( p, 0 );                  /* no menu */
+    p = sg_dlg_word( p, 0 );                  /* the dialog class */
+    p = sg_dlg_str( p, L"Shut Down" );
+    p = sg_dlg_word( p, 9 );
+    p = sg_dlg_str( p, L"Segoe UI" );
+    p = sg_dlg_item( p, SS_LEFT, 10, 10, 210, 10, 0xffff, 0x0082, L"What do you want the computer to do?" );
+    p = sg_dlg_item( p, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL, 10, 24, 210, 60, SG_SD_COMBO, 0x0085, L"" );
+    p = sg_dlg_item( p, BS_DEFPUSHBUTTON | WS_TABSTOP, 110, 60, 52, 14, IDOK, 0x0080, L"OK" );
+    sg_dlg_item( p, BS_PUSHBUTTON | WS_TABSTOP, 168, 60, 52, 14, IDCANCEL, 0x0080, L"Cancel" );
+
+    sg_shutdown_busy = TRUE;
+    choice = DialogBoxIndirectW( GetModuleHandleW( NULL ), t, NULL, sg_shutdown_proc );
+    sg_shutdown_busy = FALSE;
+    switch (choice)
+    {
+    case 1: ExitWindowsEx( EWX_LOGOFF, SHTDN_REASON_FLAG_PLANNED ); break;
+    case 2: ExitWindowsEx( EWX_REBOOT, SHTDN_REASON_FLAG_PLANNED ); break;
+    case 3: ExitWindowsEx( EWX_SHUTDOWN | EWX_POWEROFF, SHTDN_REASON_FLAG_PLANNED ); break;
+    }
+}
+
 static LRESULT CALLBACK sg_keys_proc( HWND hwnd, UINT message, WPARAM wp, LPARAM lp )
 {
     switch (message)
