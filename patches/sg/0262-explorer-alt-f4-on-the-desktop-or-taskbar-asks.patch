         break;
     case WM_CONTEXTMENU:
         return 0;
+    case WM_SYSCOMMAND:
+        if ((wp & 0xfff0) == SC_CLOSE) { shell_shutdown_dialog(); return 0; }
+        break;
     }
     return DefWindowProcW( hwnd, message, wp, lp );
 }
@@ -1254,7 +1337,8 @@
         switch(wp & 0xfff0)
         {
         case SC_CLOSE:
-            ExitWindows( 0, 0 );
+            /* Stained Glass OS: ask (it signed out at once) */
+            shell_shutdown_dialog();
             return 0;
         }
         break;
