From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] usp10: far-edge tab stops in ScriptStringAnalyse

A negative SCRIPT_TABDEF.pTabStops entry is a far-edge stop (as documented): the text after the tab, up to the next tab or the end, ends at it. Once every item is shaped the tabs are placed again in logical order with the width of what follows them; left-to-right items only. They were near stops with a FIXME.
---
--- a/dlls/gdi32/uniscribe/usp10.c
+++ b/dlls/gdi32/uniscribe/usp10.c
@@ -1841,6 +1841,90 @@
     return x;
 }
 
+#ifndef SG_MUTANT_USP_NEAR_TABS_ONLY
+/* Stained Glass OS (wine-sg 8223): far-edge tab stops (negative pTabStops entries): the text after the tab, up to
+ * the next tab or the end, ends at the stop. The tabs are placed again once every item is shaped, in logical
+ * order, as near stops are; left-to-right items only. */
+static BOOL has_far_tab_stop(const SCRIPT_TABDEF *tabdef)
+{
+    int i;
+
+    for (i = 0; i < tabdef->cTabStops; i++) if (tabdef->pTabStops[i] < 0) return TRUE;
+    return FALSE;
+}
+
+static int tab_units(const ScriptCache *psc, const SCRIPT_TABDEF *tabdef, int value)
+{
+    return tabdef->iScale ? (value * tabdef->iScale) / 4 : value * psc->tm.tmAveCharWidth;
+}
+
+/* the advance of the tab at current_x, the text after it being following wide */
+static int far_tab_width(const ScriptCache *psc, const SCRIPT_TABDEF *tabdef, int current_x, int following)
+{
+    int origin = tabdef->iTabOrigin ? tab_units(psc, tabdef, tabdef->iTabOrigin) : 0;
+    int def_width, i, stop;
+
+    for (i = 0; tabdef->cTabStops > 1 && i < tabdef->cTabStops; i++)
+    {
+        stop = origin + tab_units(psc, tabdef, abs(tabdef->pTabStops[i]));
+        if (tabdef->pTabStops[i] < 0)
+        {
+            if (stop - following > current_x) return stop - following - current_x;
+        }
+        else if (stop > current_x) return stop - current_x;
+    }
+    if (tabdef->cTabStops == 1)
+    {
+        stop = tab_units(psc, tabdef, abs(tabdef->pTabStops[0]));
+        if (tabdef->pTabStops[0] < 0 && stop > 0)
+        {
+            /* every stop far-edge: the first one the text fits before */
+            int n = (current_x - origin + following) / stop + 1;
+            return origin + n * stop - following - current_x;
+        }
+        def_width = stop;
+    }
+    else def_width = tabdef->iScale ? (32 * tabdef->iScale) / 4 : 8 * psc->tm.tmAveCharWidth;
+    if (def_width <= 0) return 0;
+    return (((current_x - origin) / def_width) + 1) * def_width - current_x;
+}
+
+static void place_far_tabs(StringAnalysis *analysis, const WCHAR *str, int len, const SCRIPT_TABDEF *tabdef)
+{
+    int i, j, k, x = 0;
+
+    for (i = 0; i < analysis->numItems; i++)
+    {
+        int start = analysis->pItem[i].iCharPos, count = analysis->pItem[i + 1].iCharPos - start;
+
+        if (analysis->pItem[i].a.fRTL) return;
+        for (j = 0; j < count && j < analysis->glyphs[i].numGlyphs; j++)
+        {
+            if (str[start + j] == 0x0009)
+            {
+                int following = 0, ii = i, jj = j + 1;
+
+                /* up to the next tab or the end of the string */
+                while (ii < analysis->numItems)
+                {
+                    int s2 = analysis->pItem[ii].iCharPos, c2 = analysis->pItem[ii + 1].iCharPos - s2;
+                    for (k = jj; k < c2 && k < analysis->glyphs[ii].numGlyphs; k++)
+                    {
+                        if (str[s2 + k] == 0x0009) goto found;
+                        following += analysis->glyphs[ii].piAdvance[k];
+                    }
+                    ii++;
+                    jj = 0;
+                }
+found:
+                analysis->glyphs[i].piAdvance[j] = far_tab_width(analysis->glyphs[i].sc, tabdef, x, following);
+            }
+            x += analysis->glyphs[i].piAdvance[j];
+        }
+    }
+}
+#endif
+
 /***********************************************************************
  * Helper function for ScriptStringAnalyse
  */
@@ -2133,6 +2217,10 @@
 
             BidiLevel[i] = analysis->pItem[i].a.s.uBidiLevel;
         }
+#ifndef SG_MUTANT_USP_NEAR_TABS_ONLY
+        if ((dwFlags & SSA_TAB) && pTabdef && has_far_tab_stop(pTabdef))
+            place_far_tabs(analysis, (const WCHAR *)pString, cString, pTabdef);
+#endif
     }
     else
     {
