 #include "wine/debug.h"
 
 
@@ -52,6 +53,13 @@ typedef struct DebugProcess
     HANDLE thread;
     LONG stop_count;   /* ICorDebugController stop counter: the process starts stopped */
 
+    /* Stained Glass OS: Wine Mono's debugger agent in the process (wine-sg 7792, sdb.c) */
+    CRITICAL_SECTION cs;
+    struct sdb_conn *sdb;   /* connected */
+    HANDLE connector;       /* connecting, after the first Continue of a process we started */
+    HANDLE abort;           /* ...given up (the process released or terminated) */
+    BOOL agent;             /* we gave it the agent */
+
     LONG ref;
 } DebugProcess;
 
@@ -122,6 +130,16 @@ static ULONG WINAPI cordebugprocess_Release(ICorDebugProcess *iface)
 
     if (ref == 0)
     {
+        if (This->connector)
+        {
+            SetEvent(This->abort);
+            WaitForSingleObject(This->connector, INFINITE);
+            CloseHandle(This->connector);
+        }
+        if (This->abort) CloseHandle(This->abort);
+        sdb_close(This->sdb, FALSE);
+        DeleteCriticalSection(&This->cs);
+
         if(This->handle)
             CloseHandle(This->handle);
 
@@ -137,11 +155,64 @@ static ULONG WINAPI cordebugprocess_Release(ICorDebugProcess *iface)
     return ref;
 }
 
+/* the agent, once the connection made after the first Continue is there */
+static struct sdb_conn *process_agent(DebugProcess *This)
+{
+    HANDLE connector;
+
+    EnterCriticalSection(&This->cs);
+    connector = This->connector;
+    LeaveCriticalSection(&This->cs);
+    if (connector) WaitForSingleObject(connector, 30000);
+    return sdb_alive(This->sdb) ? This->sdb : NULL;
+}
+
 static HRESULT WINAPI cordebugprocess_Stop(ICorDebugProcess *iface, DWORD dwTimeoutIgnored)
 {
     DebugProcess *This = impl_from_ICorDebugProcess(iface);
-    FIXME("stub %p\n", This);
-    return E_NOTIMPL;
+    struct sdb_conn *sdb;
+    HRESULT hr = S_OK;
+
+    TRACE("%p\n", This);
+
+    if (!This->handle)
+        return CORDBG_E_OBJECT_NEUTERED;
+    /* documented: Stop increments the stop counter; the managed threads stop at the first */
+    EnterCriticalSection(&This->cs);
+    if (This->stop_count > 0)
+    {
+        This->stop_count++;
+        LeaveCriticalSection(&This->cs);
+        return S_OK;
+    }
+    LeaveCriticalSection(&This->cs);
+    if (!(sdb = process_agent(This)))
+        return CORDBG_E_PROCESS_TERMINATED;
+    EnterCriticalSection(&This->cs);
+#ifndef SG_MUTANT_CDB_STOP_NOOP
+    if (!This->stop_count && sdb_request(sdb, SDB_SET_VM, SDB_VM_SUSPEND, NULL, 0, NULL, NULL))
+        hr = CORDBG_E_PROCESS_TERMINATED;
+#endif
+    if (hr == S_OK) This->stop_count++;
+    LeaveCriticalSection(&This->cs);
+    return hr;
+}
+
+static DWORD WINAPI connect_thread(void *arg)
+{
+    DebugProcess *This = arg;
+    struct sdb_conn *sdb = sdb_connect(This->dwProcessID, This->handle, This->abort, 30000);
+
+    EnterCriticalSection(&This->cs);
+    This->sdb = sdb;
+    /* the agent holds the program until told to go (suspend=y): it goes unless the debugger stopped it meanwhile */
+    if (sdb && !This->stop_count)
+        sdb_request(sdb, SDB_SET_VM, SDB_VM_RESUME, NULL, 0, NULL, NULL);
+    else if (sdb)
+        TRACE("stopped before the agent came: it stays suspended\n");
+    LeaveCriticalSection(&This->cs);
+    if (!sdb) WARN("no debugger agent in process %lu\n", This->dwProcessID);
+    return 0;
 }
 
 static HRESULT WINAPI cordebugprocess_Continue(ICorDebugProcess *iface, BOOL fIsOutOfBand)
@@ -155,8 +226,22 @@ static HRESULT WINAPI cordebugprocess_Continue(ICorDebugProcess *iface, BOOL fIs
         return CORDBG_E_PROCESS_NOT_SYNCHRONIZED;
 #endif
 
-    if (!--This->stop_count && This->thread)
-        ResumeThread(This->thread);
+    EnterCriticalSection(&This->cs);
+    if (!--This->stop_count)
+    {
+        if (This->thread && This->agent && !This->connector && !This->sdb)
+        {
+            /* the first: the program starts, and its agent is connected to as it comes */
+            ResumeThread(This->thread);
+            if ((This->abort = CreateEventW(NULL, TRUE, FALSE, NULL)))
+                This->connector = CreateThread(NULL, 0, connect_thread, This, 0, NULL);
+        }
+        else if (This->sdb)
+            sdb_request(This->sdb, SDB_SET_VM, SDB_VM_RESUME, NULL, 0, NULL, NULL);
+        else if (This->thread && !This->connector)
+            ResumeThread(This->thread);
+    }
+    LeaveCriticalSection(&This->cs);
 
     return S_OK;
 }
@@ -193,12 +278,27 @@ static HRESULT WINAPI cordebugprocess_HasQueuedCallbacks(ICorDebugProcess *iface
     return S_OK;
 }
 
+static HRESULT get_threads(DebugProcess *This, ICorDebugThread ***threads, ULONG *count);
+static HRESULT thread_enum_create(ICorDebugThread **threads, ULONG count, ULONG pos, ICorDebugThreadEnum **ret);
+
 static HRESULT WINAPI cordebugprocess_EnumerateThreads(ICorDebugProcess *iface,
                 ICorDebugThreadEnum **ppThreads)
 {
     DebugProcess *This = impl_from_ICorDebugProcess(iface);
-    FIXME("stub %p\n", This);
-    return E_NOTIMPL;
+    ICorDebugThread **threads;
+    ULONG count, i;
+    HRESULT hr;
+
+    TRACE("%p, %p\n", This, ppThreads);
+
+    if (!ppThreads) return E_INVALIDARG;
+    if (FAILED(hr = get_threads(This, &threads, &count))) return hr;
+    if (FAILED(hr = thread_enum_create(threads, count, 0, ppThreads)))
+    {
+        for (i = 0; i < count; i++) ICorDebugThread_Release(threads[i]);
+        free(threads);
+    }
+    return hr;
 }
 
 static HRESULT WINAPI cordebugprocess_SetAllThreadsDebugState(ICorDebugProcess *iface,
@@ -234,7 +334,13 @@ static HRESULT WINAPI cordebugprocess_Detach(ICorDebugProcess *iface)
             break;
         }
     }
-    if (This->stop_count > 0 && This->thread)
+    /* the agent lets the program go on, unwatched (VM DISPOSE resumes it) */
+    if (process_agent(This))
+    {
+        sdb_close(This->sdb, TRUE);
+        This->sdb = NULL;
+    }
+    else if (This->stop_count > 0 && This->thread)
         ResumeThread(This->thread);
     This->stop_count = 0;
     CloseHandle(This->handle);
@@ -252,6 +358,13 @@ static HRESULT WINAPI cordebugprocess_Terminate(ICorDebugProcess *iface, UINT ex
     if(This->handle)
     {
         ret = TerminateProcess(This->handle, exitCode);
+        if (This->connector)
+        {
+            SetEvent(This->abort);
+            WaitForSingleObject(This->connector, INFINITE);
+        }
+        sdb_close(This->sdb, FALSE);
+        This->sdb = NULL;
         CloseHandle(This->handle);
         This->handle = NULL;
     }
@@ -309,8 +422,27 @@ static HRESULT WINAPI cordebugprocess_GetThread(ICorDebugProcess *iface, DWORD d
                 ICorDebugThread **ppThread)
 {
     DebugProcess *This = impl_from_ICorDebugProcess(iface);
-    FIXME("stub %p\n", This);
-    return E_NOTIMPL;
+    ICorDebugThread **threads;
+    ULONG count, i;
+    DWORD tid;
+    HRESULT hr;
+
+    TRACE("%p, %#lx, %p\n", This, dwThreadId, ppThread);
+
+    if (!ppThread) return E_INVALIDARG;
+    *ppThread = NULL;
+    if (FAILED(hr = get_threads(This, &threads, &count))) return hr;
+    for (i = 0; i < count; i++)
+    {
+        if (!*ppThread && SUCCEEDED(ICorDebugThread_GetID(threads[i], &tid)) && tid == dwThreadId)
+        {
+            *ppThread = threads[i];
+            continue;
+        }
+        ICorDebugThread_Release(threads[i]);
+    }
+    free(threads);
+    return *ppThread ? S_OK : E_INVALIDARG;
 }
 
 static HRESULT WINAPI cordebugprocess_EnumerateObjects(ICorDebugProcess *iface,
@@ -501,6 +633,395 @@ static HRESULT WINAPI cordebugprocess_GetHelperThreadID(ICorDebugProcess *iface,
 }
 
 
+/* Stained Glass OS: the debuggee's managed threads, as its agent has them (wine-sg 7792) */
+typedef struct DebugThread
+{
+    ICorDebugThread ICorDebugThread_iface;
+    LONG ref;
+    DebugProcess *process;
+    DWORD tid;
+    UINT32 objid;
+    UINT32 state;
+    CorDebugThreadState debug_state;
+} DebugThread;
+
+static inline DebugThread *impl_from_ICorDebugThread(ICorDebugThread *iface)
+{
+    return CONTAINING_RECORD(iface, DebugThread, ICorDebugThread_iface);
+}
+
+static HRESULT WINAPI cordebugthread_QueryInterface(ICorDebugThread *iface, REFIID riid, void **ppv)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (IsEqualGUID(riid, &IID_ICorDebugThread) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = &This->ICorDebugThread_iface;
+        ICorDebugThread_AddRef(iface);
+        return S_OK;
+    }
+    TRACE("no %s\n", debugstr_guid(riid));
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cordebugthread_AddRef(ICorDebugThread *iface)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI cordebugthread_Release(ICorDebugThread *iface)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        ICorDebugProcess_Release(&This->process->ICorDebugProcess_iface);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI cordebugthread_GetProcess(ICorDebugThread *iface, ICorDebugProcess **ppProcess)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (!ppProcess) return E_INVALIDARG;
+    *ppProcess = &This->process->ICorDebugProcess_iface;
+    ICorDebugProcess_AddRef(*ppProcess);
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_GetID(ICorDebugThread *iface, DWORD *pdwThreadId)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (!pdwThreadId) return E_INVALIDARG;
+    *pdwThreadId = This->tid;
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_GetHandle(ICorDebugThread *iface, HTHREAD *phThreadHandle)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (!phThreadHandle) return E_INVALIDARG;
+    if (!(*phThreadHandle = OpenThread(THREAD_ALL_ACCESS, FALSE, This->tid))) return E_FAIL;
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_GetAppDomain(ICorDebugThread *iface, ICorDebugAppDomain **ppAppDomain)
+{
+    FIXME("%p: application domains not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_SetDebugState(ICorDebugThread *iface, CorDebugThreadState state)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (state != THREAD_RUN && state != THREAD_SUSPEND) return E_INVALIDARG;
+    FIXME("%p: %d kept, not applied to the thread yet\n", iface, state);
+    This->debug_state = state;
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_GetDebugState(ICorDebugThread *iface, CorDebugThreadState *pState)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (!pState) return E_INVALIDARG;
+    *pState = This->debug_state;
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_GetUserState(ICorDebugThread *iface, CorDebugUserState *pState)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+
+    if (!pState) return E_INVALIDARG;
+    /* System.Threading.ThreadState's low bits are CorDebugUserState's */
+    *pState = This->state & (USER_STOP_REQUESTED | USER_SUSPEND_REQUESTED | USER_BACKGROUND | USER_UNSTARTED |
+                             USER_STOPPED | USER_WAIT_SLEEP_JOIN | USER_SUSPENDED);
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_GetCurrentException(ICorDebugThread *iface, ICorDebugValue **ppExceptionObject)
+{
+    if (!ppExceptionObject) return E_INVALIDARG;
+    *ppExceptionObject = NULL;
+    return S_FALSE;   /* none being thrown: exceptions are not reported yet */
+}
+
+static HRESULT WINAPI cordebugthread_ClearCurrentException(ICorDebugThread *iface)
+{
+    FIXME("%p\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_CreateStepper(ICorDebugThread *iface, ICorDebugStepper **ppStepper)
+{
+    FIXME("%p: stepping not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_EnumerateChains(ICorDebugThread *iface, ICorDebugChainEnum **ppChains)
+{
+    FIXME("%p: stacks not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_GetActiveChain(ICorDebugThread *iface, ICorDebugChain **ppChain)
+{
+    FIXME("%p: stacks not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_GetActiveFrame(ICorDebugThread *iface, ICorDebugFrame **ppFrame)
+{
+    FIXME("%p: stacks not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_GetRegisterSet(ICorDebugThread *iface, ICorDebugRegisterSet **ppRegisters)
+{
+    FIXME("%p\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_CreateEval(ICorDebugThread *iface, ICorDebugEval **ppEval)
+{
+    FIXME("%p: evaluation not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cordebugthread_GetObject(ICorDebugThread *iface, ICorDebugValue **ppObject)
+{
+    FIXME("%p: values not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static const ICorDebugThreadVtbl cordebugthreadVtbl =
+{
+    cordebugthread_QueryInterface,
+    cordebugthread_AddRef,
+    cordebugthread_Release,
+    cordebugthread_GetProcess,
+    cordebugthread_GetID,
+    cordebugthread_GetHandle,
+    cordebugthread_GetAppDomain,
+    cordebugthread_SetDebugState,
+    cordebugthread_GetDebugState,
+    cordebugthread_GetUserState,
+    cordebugthread_GetCurrentException,
+    cordebugthread_ClearCurrentException,
+    cordebugthread_CreateStepper,
+    cordebugthread_EnumerateChains,
+    cordebugthread_GetActiveChain,
+    cordebugthread_GetActiveFrame,
+    cordebugthread_GetRegisterSet,
+    cordebugthread_CreateEval,
+    cordebugthread_GetObject,
+};
+
+typedef struct ThreadEnum
+{
+    ICorDebugThreadEnum ICorDebugThreadEnum_iface;
+    LONG ref;
+    ICorDebugThread **threads;
+    ULONG count, pos;
+} ThreadEnum;
+
+static inline ThreadEnum *impl_from_ICorDebugThreadEnum(ICorDebugThreadEnum *iface)
+{
+    return CONTAINING_RECORD(iface, ThreadEnum, ICorDebugThreadEnum_iface);
+}
+
+static HRESULT WINAPI thread_enum_QueryInterface(ICorDebugThreadEnum *iface, REFIID riid, void **ppv)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+
+    if (IsEqualGUID(riid, &IID_ICorDebugThreadEnum) || IsEqualGUID(riid, &IID_ICorDebugEnum) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = &This->ICorDebugThreadEnum_iface;
+        ICorDebugThreadEnum_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI thread_enum_AddRef(ICorDebugThreadEnum *iface)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI thread_enum_Release(ICorDebugThreadEnum *iface)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) ICorDebugThread_Release(This->threads[i]);
+        free(This->threads);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI thread_enum_Skip(ICorDebugThreadEnum *iface, ULONG celt)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI thread_enum_Reset(ICorDebugThreadEnum *iface)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+    This->pos = 0;
+    return S_OK;
+}
+
+static HRESULT thread_enum_create(ICorDebugThread **threads, ULONG count, ULONG pos, ICorDebugThreadEnum **ret);
+
+static HRESULT WINAPI thread_enum_Clone(ICorDebugThreadEnum *iface, ICorDebugEnum **ppEnum)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+    ICorDebugThread **copy;
+    ULONG i;
+    HRESULT hr;
+
+    if (!ppEnum) return E_INVALIDARG;
+    if (!(copy = calloc(This->count ? This->count : 1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++)
+    {
+        copy[i] = This->threads[i];
+        ICorDebugThread_AddRef(copy[i]);
+    }
+    hr = thread_enum_create(copy, This->count, This->pos, (ICorDebugThreadEnum **)ppEnum);
+    if (FAILED(hr))
+    {
+        for (i = 0; i < This->count; i++) ICorDebugThread_Release(copy[i]);
+        free(copy);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI thread_enum_GetCount(ICorDebugThreadEnum *iface, ULONG *pcelt)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+
+    if (!pcelt) return E_INVALIDARG;
+    *pcelt = This->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI thread_enum_Next(ICorDebugThreadEnum *iface, ULONG celt, ICorDebugThread **threads,
+                                       ULONG *pceltFetched)
+{
+    ThreadEnum *This = impl_from_ICorDebugThreadEnum(iface);
+    ULONG n = 0;
+
+    if (!threads || (celt > 1 && !pceltFetched)) return E_INVALIDARG;
+    while (n < celt && This->pos < This->count)
+    {
+        threads[n] = This->threads[This->pos++];
+        ICorDebugThread_AddRef(threads[n++]);
+    }
+    if (pceltFetched) *pceltFetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
+
+static const ICorDebugThreadEnumVtbl thread_enum_vtbl =
+{
+    thread_enum_QueryInterface,
+    thread_enum_AddRef,
+    thread_enum_Release,
+    thread_enum_Skip,
+    thread_enum_Reset,
+    thread_enum_Clone,
+    thread_enum_GetCount,
+    thread_enum_Next,
+};
+
+static HRESULT thread_enum_create(ICorDebugThread **threads, ULONG count, ULONG pos, ICorDebugThreadEnum **ret)
+{
+    ThreadEnum *This = calloc(1, sizeof(*This));
+
+    if (!This) return E_OUTOFMEMORY;
+    This->ICorDebugThreadEnum_iface.lpVtbl = &thread_enum_vtbl;
+    This->ref = 1;
+    This->threads = threads;
+    This->count = count;
+    This->pos = pos;
+    *ret = &This->ICorDebugThreadEnum_iface;
+    return S_OK;
+}
+
+/* the managed threads now, from the agent (the process stopped) */
+static HRESULT get_threads(DebugProcess *This, ICorDebugThread ***threads, ULONG *count)
+{
+    struct sdb_conn *sdb;
+    BYTE *reply = NULL, *info = NULL, id[4];
+    UINT32 len, ilen, n, i;
+    DebugThread *thread;
+
+    *threads = NULL;
+    *count = 0;
+    if (!This->handle) return CORDBG_E_OBJECT_NEUTERED;
+    if (This->stop_count <= 0) return CORDBG_E_PROCESS_NOT_SYNCHRONIZED;
+    if (!(sdb = process_agent(This))) return CORDBG_E_PROCESS_TERMINATED;
+    if (sdb_request(sdb, SDB_SET_VM, SDB_VM_ALL_THREADS, NULL, 0, &reply, &len) || len < 4)
+    {
+        free(reply);
+        return CORDBG_E_PROCESS_TERMINATED;
+    }
+    n = sdb_get32(reply);
+    if (n > (len - 4) / 4 || !(*threads = calloc(n ? n : 1, sizeof(**threads))))
+    {
+        free(reply);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < n; i++)
+    {
+        if (!(thread = calloc(1, sizeof(*thread)))) break;
+        thread->ICorDebugThread_iface.lpVtbl = &cordebugthreadVtbl;
+        thread->ref = 1;
+        thread->process = This;
+        ICorDebugProcess_AddRef(&This->ICorDebugProcess_iface);
+        thread->objid = sdb_get32(reply + 4 + 4 * i);
+        thread->debug_state = THREAD_RUN;
+        memcpy(id, reply + 4 + 4 * i, 4);
+        if (!sdb_request(sdb, SDB_SET_THREAD, SDB_THREAD_GET_TID, id, 4, &info, &ilen) && ilen >= 8)
+#ifndef SG_MUTANT_CDB_THREAD_ID
+            thread->tid = sdb_get64(info);
+#else
+            thread->tid = thread->objid;
+#endif
+        free(info);
+        info = NULL;
+        if (!sdb_request(sdb, SDB_SET_THREAD, SDB_THREAD_GET_STATE, id, 4, &info, &ilen) && ilen >= 4)
+            thread->state = sdb_get32(info);
