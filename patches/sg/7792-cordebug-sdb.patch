+extern UINT16 sdb_request( struct sdb_conn *conn, BYTE set, BYTE cmd, const BYTE *payload, UINT32 len,
+                           BYTE **reply, UINT32 *reply_len );
+extern BOOL sdb_alive( struct sdb_conn *conn );
+extern void sdb_close( struct sdb_conn *conn, BOOL dispose );
+extern UINT32 sdb_get32( const BYTE *p );
+extern UINT64 sdb_get64( const BYTE *p );
