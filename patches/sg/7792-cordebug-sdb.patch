index 0000000..6d01d8a
--- /dev/null
+++ b/dlls/mscoree/sdb.c
@@ -0,0 +1,269 @@
+/*
+ * Stained Glass OS: ICorDebug's link to Wine Mono's soft debugger agent (wine-sg 7792)
+ *
+ * Wine Mono has no CLR debugging services; its debugger agent speaks Mono's
+ * soft debugger protocol (SDB). ICorDebug (cordebug.c) is a client of it: a
+ * debuggee started by ICorDebug::CreateProcess gets the agent (dt_unix,
+ * server=y, suspend=y), one attached to by DebugActiveProcess has it already;
+ * the connection is the user's own Unix socket named after the debuggee's
+ * process id (sgdbgsock.dll, wine-sg 7791). Packets: a 11-byte header
+ * (length, id, flags, then command set and command, or a reply's error code),
+ * big-endian; a thread here reads them, answers go to the request waiting.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+#include "sdb.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL( mscoree );
+
+typedef BOOL (WINAPI *SgDbgConnectFunc)( const char *name, UINT64 *conn );
+typedef int (WINAPI *SgDbgSendFunc)( UINT64 conn, const void *buf, int len );
+typedef int (WINAPI *SgDbgRecvFunc)( UINT64 conn, void *buf, int len );
+typedef void (WINAPI *SgDbgShutdownFunc)( UINT64 conn, int how );
+typedef void (WINAPI *SgDbgCloseFunc)( UINT64 conn );
+
+static SgDbgConnectFunc p_connect;
+static SgDbgSendFunc p_send;
+static SgDbgRecvFunc p_recv;
+static SgDbgShutdownFunc p_shutdown;
+static SgDbgCloseFunc p_close;
+
+struct sdb_pending
+{
+    struct list entry;
+    UINT32 id;
+    HANDLE event;
+    BOOL done;
+    UINT16 error;
+    BYTE *data;
+    UINT32 len;
+};
+
+struct sdb_conn
+{
+    UINT64 sock;
+    CRITICAL_SECTION cs;
+    struct list pending;
+    UINT32 next_id;
+    BOOL dead;
+    HANDLE reader;
+    LONG ref;
+};
+
+static BOOL load_sgdbgsock(void)
+{
+    static HMODULE dll;
+
+    if (dll) return p_connect != NULL;
+    if (!(dll = LoadLibraryW( L"sgdbgsock.dll" ))) return FALSE;
+    p_connect = (void *)GetProcAddress( dll, "SgDbgConnect" );
+    p_send = (void *)GetProcAddress( dll, "SgDbgSend" );
+    p_recv = (void *)GetProcAddress( dll, "SgDbgRecv" );
+    p_shutdown = (void *)GetProcAddress( dll, "SgDbgShutdown" );
+    p_close = (void *)GetProcAddress( dll, "SgDbgClose" );
+    if (!p_connect || !p_send || !p_recv || !p_shutdown || !p_close) p_connect = NULL;
+    return p_connect != NULL;
+}
+
+static void put32( BYTE *p, UINT32 v ) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+UINT32 sdb_get32( const BYTE *p ) { return (UINT32)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]; }
+UINT64 sdb_get64( const BYTE *p ) { return (UINT64)sdb_get32( p ) << 32 | sdb_get32( p + 4 ); }
+
+static void conn_release( struct sdb_conn *conn )
+{
+    if (InterlockedDecrement( &conn->ref )) return;
+    DeleteCriticalSection( &conn->cs );
+    free( conn );
+}
+
+/* the agent's packets: replies to the requests waiting, events dropped (none asked for) */
+static DWORD WINAPI reader_thread( void *arg )
+{
+    struct sdb_conn *conn = arg;
+    struct sdb_pending *p;
+    BYTE header[11], *data;
+    UINT32 len, id;
+
+    for (;;)
+    {
+        if (p_recv( conn->sock, header, sizeof(header) ) != sizeof(header)) break;
+        len = sdb_get32( header );
+        id = sdb_get32( header + 4 );
+        if (len < sizeof(header) || len > 64 * 1024 * 1024) break;
+        len -= sizeof(header);
+        data = len ? malloc( len ) : NULL;
+        if (len && (!data || p_recv( conn->sock, data, len ) != len)) { free( data ); break; }
+        if (!(header[8] & 0x80))
+        {
+            TRACE( "event packet %u/%u, %u bytes\n", header[9], header[10], len );
+            free( data );
+            continue;
+        }
+        EnterCriticalSection( &conn->cs );
+        LIST_FOR_EACH_ENTRY( p, &conn->pending, struct sdb_pending, entry )
+        {
+            if (p->id != id) continue;
+            p->error = header[9] << 8 | header[10];
+            p->data = data;
+            p->len = len;
+            p->done = TRUE;
+            data = NULL;
+            SetEvent( p->event );
+            break;
+        }
+        LeaveCriticalSection( &conn->cs );
+        free( data );
+    }
+    EnterCriticalSection( &conn->cs );
+    conn->dead = TRUE;
+    LIST_FOR_EACH_ENTRY( p, &conn->pending, struct sdb_pending, entry ) SetEvent( p->event );
+    LeaveCriticalSection( &conn->cs );
+    TRACE( "the agent is gone\n" );
+    conn_release( conn );
+    return 0;
+}
+
+/* a request and its reply (*reply freed by the caller): the agent's error code, or SDB_ERR_GONE */
+UINT16 sdb_request( struct sdb_conn *conn, BYTE set, BYTE cmd, const BYTE *payload, UINT32 len,
+                    BYTE **reply, UINT32 *reply_len )
+{
+    struct sdb_pending p = { .event = CreateEventW( NULL, TRUE, FALSE, NULL ) };
+    BYTE *packet;
+    BOOL sent;
+
+    if (reply) *reply = NULL;
+    if (reply_len) *reply_len = 0;
+    if (!conn || !p.event) return SDB_ERR_GONE;
+    if (!(packet = malloc( 11 + len ))) { CloseHandle( p.event ); return SDB_ERR_GONE; }
+
+    EnterCriticalSection( &conn->cs );
+    if (conn->dead)
+    {
+        LeaveCriticalSection( &conn->cs );
+        free( packet );
+        CloseHandle( p.event );
+        return SDB_ERR_GONE;
+    }
+    p.id = ++conn->next_id;
+    list_add_tail( &conn->pending, &p.entry );
+    put32( packet, 11 + len );
+    put32( packet + 4, p.id );
+    packet[8] = 0;
+    packet[9] = set;
+    packet[10] = cmd;
+    if (len) memcpy( packet + 11, payload, len );
+    sent = p_send( conn->sock, packet, 11 + len ) == 11 + len;
+    LeaveCriticalSection( &conn->cs );
+    free( packet );
+
+    if (sent) WaitForSingleObject( p.event, 30000 );
+    EnterCriticalSection( &conn->cs );
+    list_remove( &p.entry );
+    LeaveCriticalSection( &conn->cs );
+    CloseHandle( p.event );
+    if (!p.done)
+    {
+        free( p.data );
+        return SDB_ERR_GONE;
+    }
+    if (reply) *reply = p.data; else free( p.data );
+    if (reply_len) *reply_len = p.len;
+    return p.error;
+}
+
+/* the agent of process PID, waited for until TIMEOUT ms, PROCESS exits or ABORT is set */
+struct sdb_conn *sdb_connect( DWORD pid, HANDLE process, HANDLE abort, DWORD timeout )
+{
+    struct sdb_conn *conn;
+    char name[16], hs[13];
+    DWORD start = GetTickCount();
+    BYTE version[8];
+    UINT64 sock;
+
+    if (!load_sgdbgsock())
+    {
+        WARN( "no sgdbgsock.dll\n" );
+        return NULL;
+    }
+    sprintf( name, "%lu", pid );
+    for (;;)
+    {
+        HANDLE handles[2];
+        DWORD count = 0;
+
+        if (p_connect( name, &sock )) break;
+        if (GetTickCount() - start >= timeout) return NULL;
+        if (process) handles[count++] = process;
+        if (abort) handles[count++] = abort;
+        if (count ? WaitForMultipleObjects( count, handles, FALSE, 50 ) != WAIT_TIMEOUT : (Sleep( 50 ), FALSE))
+            return NULL;
+    }
+    if (p_send( sock, "DWP-Handshake", 13 ) != 13 || p_recv( sock, hs, 13 ) != 13 || memcmp( hs, "DWP-Handshake", 13 ))
+    {
+        WARN( "no handshake from %s\n", name );
+        p_close( sock );
+        return NULL;
+    }
+    if (!(conn = calloc( 1, sizeof(*conn) )))
+    {
+        p_close( sock );
+        return NULL;
+    }
+    conn->sock = sock;
+    conn->ref = 2;   /* ours and the reader's */
+    list_init( &conn->pending );
+    InitializeCriticalSectionEx( &conn->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    if (!(conn->reader = CreateThread( NULL, 0, reader_thread, conn, 0, NULL )))
+    {
+        p_close( sock );
+        DeleteCriticalSection( &conn->cs );
+        free( conn );
+        return NULL;
+    }
+    put32( version, 2 );
+    put32( version + 4, 50 );
+    sdb_request( conn, SDB_SET_VM, SDB_VM_SET_PROTOCOL_VERSION, version, sizeof(version), NULL, NULL );
+    TRACE( "connected to the agent of %lu\n", pid );
+    return conn;
+}
+
+BOOL sdb_alive( struct sdb_conn *conn )
+{
+    return conn && !conn->dead;
+}
+
+/* VM DISPOSE (the debuggee runs on, unwatched) and the connection closed */
+void sdb_close( struct sdb_conn *conn, BOOL dispose )
+{
+    if (!conn) return;
+    if (dispose) sdb_request( conn, SDB_SET_VM, SDB_VM_DISPOSE, NULL, 0, NULL, NULL );
+    p_shutdown( conn->sock, 2 );
+    WaitForSingleObject( conn->reader, 5000 );
+    CloseHandle( conn->reader );
+    p_close( conn->sock );
+    conn_release( conn );
+}
