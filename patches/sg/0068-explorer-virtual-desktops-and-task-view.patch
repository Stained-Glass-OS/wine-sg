@@ -0,0 +1,187 @@
+/*
+ * IVirtualDesktopManager (Stained Glass OS)
+ *
+ * The documented interface programs use to follow the user's virtual
+ * desktops -- browsers ask IsWindowOnCurrentVirtualDesktop before reusing a
+ * window. The desktops are explorer's (programs/explorer/vdesktop.c): the
+ * list and the current one where Windows keeps them, HKCU\...\Explorer\
+ * VirtualDesktops; a window's desktop in its root owner's "__sg_vdesk"
+ * property (1-based index).
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "shobjidl.h"
+#include "wine/debug.h"
+#include "shell32_main.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+#define MAX_DESKTOPS 16
+
+static const WCHAR vd_key[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VirtualDesktops";
+
+struct vdm
+{
+    IVirtualDesktopManager IVirtualDesktopManager_iface;
+    LONG ref;
+};
+
+static inline struct vdm *impl_from_IVirtualDesktopManager( IVirtualDesktopManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct vdm, IVirtualDesktopManager_iface );
+}
+
+/* the desktops' ids and the current one; FALSE when there is only the one */
+static BOOL read_desktops( GUID *ids, int *count, GUID *current )
+{
+    DWORD size = MAX_DESKTOPS * sizeof(GUID);
+    HKEY key;
+    BOOL ret = FALSE;
+
+    *count = 0;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, vd_key, 0, KEY_READ, &key )) return FALSE;
+    if (!RegQueryValueExW( key, L"VirtualDesktopIDs", NULL, NULL, (BYTE *)ids, &size ))
+    {
+        *count = size / sizeof(GUID);
+        size = sizeof(*current);
+        ret = !RegQueryValueExW( key, L"CurrentVirtualDesktop", NULL, NULL, (BYTE *)current, &size ) && *count;
+    }
+    RegCloseKey( key );
+    return ret;
+}
+
+/* 0-based desktop of a top-level window; -1: on every desktop, or not placed */
+static int window_desktop( HWND hwnd )
+{
+    HWND root = GetAncestor( hwnd, GA_ROOTOWNER );
+    if (!root || GetPropW( root, L"__sg_vdesk_pinned" )) return -1;
+    return (int)(INT_PTR)GetPropW( root, L"__sg_vdesk" ) - 1;
+}
+
+static HRESULT WINAPI vdm_QueryInterface( IVirtualDesktopManager *iface, REFIID riid, void **out )
+{
+    struct vdm *vdm = impl_from_IVirtualDesktopManager( iface );
+
+    TRACE( "(%p)->(%s, %p)\n", vdm, debugstr_guid(riid), out );
+    if (IsEqualIID( riid, &IID_IUnknown ) || IsEqualIID( riid, &IID_IVirtualDesktopManager ))
+    {
+        *out = &vdm->IVirtualDesktopManager_iface;
+        IVirtualDesktopManager_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI vdm_AddRef( IVirtualDesktopManager *iface )
+{
+    struct vdm *vdm = impl_from_IVirtualDesktopManager( iface );
+    return InterlockedIncrement( &vdm->ref );
+}
+
+static ULONG WINAPI vdm_Release( IVirtualDesktopManager *iface )
+{
+    struct vdm *vdm = impl_from_IVirtualDesktopManager( iface );
+    ULONG ref = InterlockedDecrement( &vdm->ref );
+    if (!ref) free( vdm );
+    return ref;
+}
+
+static HRESULT WINAPI vdm_IsWindowOnCurrentVirtualDesktop( IVirtualDesktopManager *iface, HWND hwnd, BOOL *on_current )
+{
+    GUID ids[MAX_DESKTOPS], current;
+    int count, d;
+
+    TRACE( "(%p, %p)\n", hwnd, on_current );
+    if (!on_current) return E_POINTER;
+    if (!IsWindow( hwnd )) return E_INVALIDARG;
+    *on_current = TRUE;
+    if (!read_desktops( ids, &count, &current )) return S_OK;
+    if ((d = window_desktop( hwnd )) < 0 || d >= count) return S_OK;
+    *on_current = IsEqualGUID( &ids[d], &current );
+    return S_OK;
+}
+
+static HRESULT WINAPI vdm_GetWindowDesktopId( IVirtualDesktopManager *iface, HWND hwnd, GUID *id )
+{
+    GUID ids[MAX_DESKTOPS], current;
+    int count, d;
+
+    TRACE( "(%p, %p)\n", hwnd, id );
+    if (!id) return E_POINTER;
+    if (!IsWindow( hwnd )) return E_INVALIDARG;
+    memset( id, 0, sizeof(*id) );
+    if (!read_desktops( ids, &count, &current )) return S_OK;
+    d = window_desktop( hwnd );
+    *id = (d >= 0 && d < count) ? ids[d] : current;
+    return S_OK;
+}
+
+static HRESULT WINAPI vdm_MoveWindowToDesktop( IVirtualDesktopManager *iface, HWND hwnd, REFGUID id )
+{
+    GUID ids[MAX_DESKTOPS], current;
+    DWORD pid;
+    int count, d;
+    HWND tray;
+
+    TRACE( "(%p, %s)\n", hwnd, debugstr_guid(id) );
+    if (!IsWindow( hwnd ) || !id) return E_INVALIDARG;
+    /* as on Windows, a program moves only its own windows */
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (pid != GetCurrentProcessId()) return E_ACCESSDENIED;
+    if (!read_desktops( ids, &count, &current )) return IsEqualGUID( id, &current ) ? S_OK : E_INVALIDARG;
+    for (d = 0; d < count; d++) if (IsEqualGUID( &ids[d], id )) break;
+    if (d == count) return E_INVALIDARG;
+    if (!(tray = FindWindowW( L"Shell_TrayWnd", NULL ))) return E_FAIL;
+    SendMessageTimeoutW( tray, RegisterWindowMessageW( L"SgVirtualDesktopCommand" ), 0x100 + d,
+                         (LPARAM)hwnd, SMTO_ABORTIFHUNG, 5000, NULL );
+    return S_OK;
+}
+
+static const IVirtualDesktopManagerVtbl vdm_vtbl =
+{
+    vdm_QueryInterface,
+    vdm_AddRef,
+    vdm_Release,
+    vdm_IsWindowOnCurrentVirtualDesktop,
+    vdm_GetWindowDesktopId,
+    vdm_MoveWindowToDesktop,
+};
+
+HRESULT WINAPI VirtualDesktopManager_Constructor( IUnknown *outer, REFIID riid, void **out )
+{
+    struct vdm *vdm;
+    HRESULT hr;
+
+    TRACE( "(%p, %s, %p)\n", outer, debugstr_guid(riid), out );
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(vdm = calloc( 1, sizeof(*vdm) ))) return E_OUTOFMEMORY;
+    vdm->IVirtualDesktopManager_iface.lpVtbl = &vdm_vtbl;
+    vdm->ref = 1;
+    hr = IVirtualDesktopManager_QueryInterface( &vdm->IVirtualDesktopManager_iface, riid, out );
+    IVirtualDesktopManager_Release( &vdm->IVirtualDesktopManager_iface );
+    return hr;
+}
--- /dev/null
+++ b/programs/explorer/vdesktop.c
@@ -0,0 +1,1191 @@
+/*
+ * Virtual desktops and Task View (Stained Glass OS)
+ *
+ * Several desktops, as Windows 10 has them: each application window belongs
+ * to one; the others' windows are cloaked by the shell (DWM_CLOAKED_SHELL,
+ * NtUserSetWindowCloak) -- still visible to their programs, not drawn. The
+ * taskbar shows the current desktop's windows. Win+Ctrl+D adds a desktop,
+ * Win+Ctrl+Left/Right switch, Win+Ctrl+F4 closes the current one (its windows
+ * move to a neighbour), Win+Ctrl+Shift+Left/Right carry the active window
+ * along, and Win+Tab (or the taskbar's Task View button) opens Task View:
+ * the desktops in a strip, the windows as thumbnails; click to switch, drag a
+ * window onto a desktop to move it there. Alt+Tab switches among the current
+ * desktop's windows.
+ *
+ * State is kept where Windows keeps it, HKCU\...\Explorer\VirtualDesktops
+ * (VirtualDesktopIDs, CurrentVirtualDesktop, Desktops\{id}\Name); a window's
+ * desktop is its root owner's "__sg_vdesk" property (1-based index), so any
+ * process can ask (IVirtualDesktopManager in shell32 does).
