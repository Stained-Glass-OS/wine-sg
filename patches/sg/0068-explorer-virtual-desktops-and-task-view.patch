+WINE_DEFAULT_DEBUG_CHANNEL(explorer);
+
+#define VD_MAX 16
+#ifndef MOD_NOREPEAT
+#define MOD_NOREPEAT 0x4000
+#endif
+
+static int vd_count = 1, vd_current;
+static GUID vd_ids[VD_MAX];
+static WCHAR vd_names[VD_MAX][64];
+static HWND vd_tray;
+static HWND taskview, osd, switcher;
+
+static const WCHAR prop_desktop[] = L"__sg_vdesk";         /* root owner's desktop, 1-based */
+static const WCHAR prop_pinned[] = L"__sg_vdesk_pinned";   /* on every desktop */
+static const GUID null_guid;
+static const WCHAR vd_key[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VirtualDesktops";
+
+enum { HK_NEW = 0x5600, HK_CLOSE, HK_LEFT, HK_RIGHT, HK_MOVE_LEFT, HK_MOVE_RIGHT, HK_TASKVIEW,
+       HK_ALTTAB, HK_ALTTAB_BACK };
+
+#define COL_BG        RGB(0x20,0x20,0x20)
+#define COL_TILE_BG   RGB(0x33,0x33,0x33)
+#define COL_TEXT      RGB(0xF0,0xF0,0xF0)
+#define COL_SUBTLE    RGB(0xA0,0xA0,0xA0)
+#define COL_ACCENT    RGB(0x8A,0x2B,0xE2)
+#define COL_HOVER     RGB(0x4A,0x4A,0x4A)
+
+/* ---- thumbnails ------------------------------------------------------- */
+
+/* The last picture of each window, taken from the screen while it was the
+ * foreground window (so on top and unobscured): cross-process PrintWindow
+ * does not exist in Wine, a cloaked window has no pixels on the screen, and
+ * this keeps a recent picture of every window that was ever active. */
+struct thumb
+{
+    struct list entry;
+    HWND        hwnd;
+    HBITMAP     bitmap;
+    SIZE        size;
+};
+static struct list thumbs = LIST_INIT( thumbs );
+
+static struct thumb *find_thumb( HWND hwnd )
+{
+    struct thumb *t;
+    LIST_FOR_EACH_ENTRY( t, &thumbs, struct thumb, entry ) if (t->hwnd == hwnd) return t;
+    return NULL;
+}
+
+static void capture_thumb( HWND hwnd )
+{
+    struct thumb *t;
+    RECT rc, screen;
+    HDC sdc, mdc;
+    HBITMAP bmp;
+    int w, h, tw, th;
+
+    if (!GetWindowRect( hwnd, &rc ) || IsIconic( hwnd )) return;
+    SetRect( &screen, 0, 0, GetSystemMetrics( SM_CXSCREEN ), GetSystemMetrics( SM_CYSCREEN ));
+    if (!IntersectRect( &rc, &rc, &screen )) return;
+    w = rc.right - rc.left; h = rc.bottom - rc.top;
+    if (w < 16 || h < 16) return;
+    /* keep them small: 480 px on the long side */
+    if (w >= h) { tw = min( w, 480 ); th = MulDiv( h, tw, w ); }
+    else { th = min( h, 480 ); tw = MulDiv( w, th, h ); }
+
+    sdc = GetDC( 0 );
+    mdc = CreateCompatibleDC( sdc );
+    bmp = CreateCompatibleBitmap( sdc, tw, th );
+    SelectObject( mdc, bmp );
+    SetStretchBltMode( mdc, HALFTONE );
+    StretchBlt( mdc, 0, 0, tw, th, sdc, rc.left, rc.top, w, h, SRCCOPY );
+    DeleteDC( mdc );
+    ReleaseDC( 0, sdc );
+
+    if (!(t = find_thumb( hwnd )))
+    {
+        if (!(t = calloc( 1, sizeof(*t) ))) { DeleteObject( bmp ); return; }
+        t->hwnd = hwnd;
+        list_add_tail( &thumbs, &t->entry );
+    }
+    if (t->bitmap) DeleteObject( t->bitmap );
+    t->bitmap = bmp;
+    t->size.cx = tw; t->size.cy = th;
+}
+
+static void drop_dead_thumbs(void)
+{
+    struct thumb *t, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( t, next, &thumbs, struct thumb, entry )
+    {
+        if (IsWindow( t->hwnd )) continue;
+        list_remove( &t->entry );
+        if (t->bitmap) DeleteObject( t->bitmap );
+        free( t );
+    }
+}
+
+/* ---- which window is where -------------------------------------------- */
+
+static void vd_name( int i, WCHAR *buf, int len )
+{
+    if (vd_names[i][0]) lstrcpynW( buf, vd_names[i], len );
+    else swprintf( buf, len, L"Desktop %d", i + 1 );
+}
+
+/* An application window: what gets a taskbar button. Its owned windows go
+ * with it; everything else (the shell's own surfaces, tool windows) is on
+ * every desktop. */
+static BOOL is_app_window( HWND hwnd )
+{
+    DWORD pid;
+    LONG ex = GetWindowLongW( hwnd, GWL_EXSTYLE );
+
+    if (GetAncestor( hwnd, GA_PARENT ) != GetDesktopWindow()) return FALSE;
+    if (GetWindow( hwnd, GW_OWNER )) return FALSE;
+    if (!GetWindowThreadProcessId( hwnd, &pid ) || pid == GetCurrentProcessId()) return FALSE;
+    if ((ex & WS_EX_TOOLWINDOW) && !(ex & WS_EX_APPWINDOW)) return FALSE;
+    if (ex & WS_EX_NOACTIVATE) return FALSE;
+    return TRUE;
+}
+
+/* The desktop a top-level window is on, placing it on the current one if it
+ * has none yet; -1: on every desktop. */
+static int desktop_of( HWND hwnd )
+{
+    HWND root = GetAncestor( hwnd, GA_ROOTOWNER );
+    int d;
+
+    if (!root || !is_app_window( root )) return -1;
+    if (GetPropW( root, prop_pinned )) return -1;
+    d = (int)(INT_PTR)GetPropW( root, prop_desktop ) - 1;
+    if (d < 0 || d >= vd_count)
+    {
+        d = vd_current;
+        SetPropW( root, prop_desktop, (HANDLE)(INT_PTR)(d + 1) );
+    }
+    return d;
+}
+
+static void set_cloaked( HWND hwnd, BOOL cloak )
+{
+    BOOL is = !!(NtUserGetWindowCloaked( hwnd ) & 2 /* DWM_CLOAKED_SHELL */);
+    if (is != cloak) NtUserSetWindowCloak( hwnd, SET_WINDOW_CLOAK_SHELL | (cloak ? SET_WINDOW_CLOAK : 0) );
+}
+
+static BOOL CALLBACK apply_proc( HWND hwnd, LPARAM lparam )
+{
+    int d = desktop_of( hwnd );
+    set_cloaked( hwnd, d >= 0 && d != vd_current );
+    return TRUE;
+}
+
+/* the topmost application window of the current desktop */
+static BOOL CALLBACK top_proc( HWND hwnd, LPARAM lparam )
+{
+    if (!IsWindowVisible( hwnd ) || IsIconic( hwnd ) || !is_app_window( hwnd )) return TRUE;
+    if (desktop_of( hwnd ) != vd_current) return TRUE;
+    *(HWND *)lparam = hwnd;
+    return FALSE;
+}
+
+static void save_state(void)
+{
+    HKEY key, sub;
+    WCHAR path[80], guid[40];
+    int i;
+
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, vd_key, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return;
+    RegSetValueExW( key, L"VirtualDesktopIDs", 0, REG_BINARY, (BYTE *)vd_ids, vd_count * sizeof(GUID) );
+    RegSetValueExW( key, L"CurrentVirtualDesktop", 0, REG_BINARY, (BYTE *)&vd_ids[vd_current], sizeof(GUID) );
+    for (i = 0; i < vd_count; i++)
+    {
+        if (!vd_names[i][0]) continue;
+        StringFromGUID2( &vd_ids[i], guid, ARRAY_SIZE(guid) );
+        swprintf( path, ARRAY_SIZE(path), L"Desktops\\%s", guid );
+        if (RegCreateKeyExW( key, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sub, NULL )) continue;
+        RegSetValueExW( sub, L"Name", 0, REG_SZ, (BYTE *)vd_names[i], (lstrlenW( vd_names[i] ) + 1) * sizeof(WCHAR) );
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+}
+
+static void load_state(void)
+{
+    HKEY key, sub;
+    DWORD size = sizeof(vd_ids), type;
+    GUID current;
+    WCHAR path[80], guid[40];
+    int i;
+
+    vd_count = 1; vd_current = 0;
+    if (!RegOpenKeyExW( HKEY_CURRENT_USER, vd_key, 0, KEY_READ, &key ))
+    {
+        if (!RegQueryValueExW( key, L"VirtualDesktopIDs", NULL, &type, (BYTE *)vd_ids, &size ) &&
+            type == REG_BINARY && size >= sizeof(GUID))
+            vd_count = min( size / sizeof(GUID), VD_MAX );
+        size = sizeof(current);
+        if (!RegQueryValueExW( key, L"CurrentVirtualDesktop", NULL, NULL, (BYTE *)&current, &size ))
+            for (i = 0; i < vd_count; i++) if (IsEqualGUID( &current, &vd_ids[i] )) vd_current = i;
+        for (i = 0; i < vd_count; i++)
+        {
+            StringFromGUID2( &vd_ids[i], guid, ARRAY_SIZE(guid) );
+            swprintf( path, ARRAY_SIZE(path), L"Desktops\\%s", guid );
+            size = sizeof(vd_names[i]);
+            if (!RegOpenKeyExW( key, path, 0, KEY_READ, &sub ))
+            {
+                RegQueryValueExW( sub, L"Name", NULL, NULL, (BYTE *)vd_names[i], &size );
+                RegCloseKey( sub );
+            }
+        }
+        RegCloseKey( key );
+    }
+    if (vd_count == 1 && IsEqualGUID( &vd_ids[0], &null_guid )) CoCreateGuid( &vd_ids[0] );
+}
+
+/* ---- the switch indicator --------------------------------------------- */
+
+static LRESULT CALLBACK osd_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint( hwnd, &ps );
+        RECT rc;
+        WCHAR text[64];
+        NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+        HFONT font;
+        HBRUSH brush = CreateSolidBrush( COL_BG );
+
+        GetClientRect( hwnd, &rc );
+        FillRect( dc, &rc, brush );
+        DeleteObject( brush );
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        ncm.lfMessageFont.lfHeight = -20;
+        ncm.lfMessageFont.lfWeight = FW_SEMIBOLD;
+        font = CreateFontIndirectW( &ncm.lfMessageFont );
+        SelectObject( dc, font );
+        SetBkMode( dc, TRANSPARENT );
+        SetTextColor( dc, COL_TEXT );
+        vd_name( vd_current, text, ARRAY_SIZE(text) );
+        DrawTextW( dc, text, -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE );
+        DeleteObject( font );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_TIMER:
+        DestroyWindow( hwnd );
+        return 0;
+    case WM_DESTROY:
+        osd = 0;
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+static void show_osd(void)
+{
+    int w = 260, h = 64;
+    RECT work;
+
+    if (osd) DestroyWindow( osd );
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    osd = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE, L"SgVirtualDesktopOsd", L"",
+                           WS_POPUP, (work.left + work.right - w) / 2, (work.top + work.bottom - h) / 2, w, h,
+                           0, 0, 0, 0 );
+    if (!osd) return;
+    ShowWindow( osd, SW_SHOWNOACTIVATE );
+    UpdateWindow( osd );
+    SetTimer( osd, 1, 900, NULL );
+}
+
+/* ---- operations -------------------------------------------------------- */
+
+static void activate_top(void)
+{
+    HWND top = 0;
+    EnumWindows( top_proc, (LPARAM)&top );
+    if (top) SetForegroundWindow( top );
+    else SetForegroundWindow( vd_tray );
+}
+
+void vd_switch( int d, BOOL indicate )
+{
+    HWND fg;
+
+    if (d < 0 || d >= vd_count || d == vd_current) return;
+    TRACE( "switching from desktop %d to %d of %d\n", vd_current, d, vd_count );
+    if ((fg = GetForegroundWindow()) && GetAncestor( fg, GA_ROOTOWNER ) && is_app_window( GetAncestor( fg, GA_ROOTOWNER )))
+        capture_thumb( GetAncestor( fg, GA_ROOTOWNER ));
+    vd_current = d;
+    EnumWindows( apply_proc, 0 );
+    save_state();
+    activate_top();
+    taskbar_windows_changed();
+    if (indicate && !taskview) show_osd();
+}
+
+void vd_new( BOOL go )
+{
+    if (vd_count >= VD_MAX) return;
+    CoCreateGuid( &vd_ids[vd_count] );
+    vd_names[vd_count][0] = 0;
+    vd_count++;
+    save_state();
+    if (go) vd_switch( vd_count - 1, TRUE );
+}
+
+struct move_params { HWND root; int to; };
+
+static BOOL CALLBACK renumber_proc( HWND hwnd, LPARAM lparam )
+{
+    int removed = (int)lparam, d;
+
+    if (!is_app_window( hwnd )) return TRUE;
+    d = (int)(INT_PTR)GetPropW( hwnd, prop_desktop ) - 1;
+    if (d == removed) d = removed ? removed - 1 : 0;
+    else if (d > removed) d--;
+    else return TRUE;
+    SetPropW( hwnd, prop_desktop, (HANDLE)(INT_PTR)(d + 1) );
+    return TRUE;
+}
+
+void vd_close( int d )
+{
+    int i;
+
+    if (vd_count <= 1 || d < 0 || d >= vd_count) return;
+    /* its windows go to the desktop on its left, or the new first one */
+    EnumWindows( renumber_proc, d );
+    for (i = d; i < vd_count - 1; i++)
+    {
+        vd_ids[i] = vd_ids[i + 1];
+        lstrcpyW( vd_names[i], vd_names[i + 1] );
+    }
+    vd_count--;
+    if (vd_current > d || vd_current == vd_count) vd_current = max( 0, vd_current - 1 );
+    EnumWindows( apply_proc, 0 );
+    save_state();
+    activate_top();
+    taskbar_windows_changed();
+}
+
+static BOOL CALLBACK move_proc( HWND hwnd, LPARAM lparam )
+{
+    const struct move_params *p = (const struct move_params *)lparam;
+    if (GetAncestor( hwnd, GA_ROOTOWNER ) == p->root) set_cloaked( hwnd, p->to != vd_current );
+    return TRUE;
+}
+
+void vd_move_window( HWND hwnd, int to )
+{
+    struct move_params p;
+
+    if (!hwnd || to < 0 || to >= vd_count) return;
+    p.root = GetAncestor( hwnd, GA_ROOTOWNER );
+    if (!p.root || !is_app_window( p.root )) return;
+    RemovePropW( p.root, prop_pinned );
+    SetPropW( p.root, prop_desktop, (HANDLE)(INT_PTR)(to + 1) );
+    p.to = to;
+    EnumWindows( move_proc, (LPARAM)&p );
+    if (to != vd_current && GetAncestor( GetForegroundWindow(), GA_ROOTOWNER ) == p.root) activate_top();
+    taskbar_windows_changed();
+}
+
+void vd_pin_window( HWND hwnd, BOOL pin )
+{
+    HWND root = GetAncestor( hwnd, GA_ROOTOWNER );
+    if (!root || !is_app_window( root )) return;
+    if (pin) SetPropW( root, prop_pinned, (HANDLE)1 );
+    else
+    {
+        RemovePropW( root, prop_pinned );
+        SetPropW( root, prop_desktop, (HANDLE)(INT_PTR)(vd_current + 1) );
+    }
+    EnumWindows( apply_proc, 0 );
+    taskbar_windows_changed();
+}
+
+/* for the taskbar: does this window's button show on this desktop? */
+BOOL vd_on_current( HWND hwnd )
+{
+    int d = desktop_of( hwnd );
+    return d < 0 || d == vd_current;
+}
+
+/* A new top-level window: it opens on the current desktop, unless it
+ * belongs to (is owned by) a window on another one. */
+void vd_window_created( HWND hwnd )
+{
+    int d = desktop_of( hwnd );
+    if (d >= 0 && d != vd_current) set_cloaked( hwnd, TRUE );
+}
+
+/* Something activated a window on another desktop (a program, a
+ * notification, Alt+Tab): go there, as Windows does. Also keeps the
+ * foreground window's thumbnail current. */
+static void CALLBACK watch_foreground( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    static int ticks;
+    HWND fg = GetForegroundWindow(), root = fg ? GetAncestor( fg, GA_ROOTOWNER ) : 0;
+    int d;
+
+    if (!root || taskview || !is_app_window( root )) return;
+    d = desktop_of( root );
+    if (d >= 0 && d != vd_current) { vd_switch( d, TRUE ); return; }
+    if (++ticks % 4 == 0 && !IsIconic( root )) capture_thumb( root );
+    if (ticks % 40 == 0) drop_dead_thumbs();
+}
+
+/* ---- Task View ---------------------------------------------------------- */
+
+struct tv_item { HWND hwnd; RECT rect; };
+struct tv_state
+{
+    int         shown;          /* desktop whose windows are shown */
+    int         n;
+    struct tv_item items[64];
+    RECT        tiles[VD_MAX];
+    RECT        tile_close[VD_MAX];
+    RECT        new_tile;
+    int         hot_item, hot_tile, hot_close, sel;
+    BOOL        hot_new;
+    int         drag;           /* item being dragged, -1 */
+    POINT       drag_from, drag_at;
+    BOOL        dragging;
+};
+static struct tv_state tv;
+
+static BOOL CALLBACK collect_proc( HWND hwnd, LPARAM lparam )
+{
+    int want = (int)lparam, d;
+
+    if (tv.n >= ARRAY_SIZE(tv.items)) return FALSE;
+    if (!IsWindowVisible( hwnd ) || !is_app_window( hwnd )) return TRUE;
+    d = desktop_of( hwnd );
+    if (d >= 0 && d != want) return TRUE;
+    tv.items[tv.n++].hwnd = hwnd;
+    return TRUE;
+}
+
+static void tv_layout( HWND hwnd )
+{
+    RECT rc;
+    int i, tile_w, tile_h, strip_h, x, cols, rows, cell_w, cell_h, top, W, H;
+    double aspect = (double)GetSystemMetrics( SM_CYSCREEN ) / GetSystemMetrics( SM_CXSCREEN );
+
+    GetClientRect( hwnd, &rc );
+    W = rc.right; H = rc.bottom;
+
+    /* the desktops strip, across the top, as macOS Mission Control has it */
+    tile_w = min( 200, (W - 40) / (vd_count + 1) - 20 );
+    tile_h = (int)(tile_w * aspect);
+    strip_h = tile_h + 56;
+    x = (W - (vd_count + 1) * (tile_w + 20) + 20) / 2;
+    for (i = 0; i < vd_count; i++)
+    {
+        SetRect( &tv.tiles[i], x, 16, x + tile_w, 16 + tile_h );
+        SetRect( &tv.tile_close[i], x + tile_w - 22, 18, x + tile_w - 2, 38 );
+        x += tile_w + 20;
+    }
+    SetRect( &tv.new_tile, x, 16, x + tile_w, 16 + tile_h );
+
+    /* the windows, in a grid */
+    tv.n = 0;
+    EnumWindows( collect_proc, tv.shown );
+    if (!tv.n) return;
+    cols = 1;
+    while (cols * cols < tv.n) cols++;
+    rows = (tv.n + cols - 1) / cols;
+    top = strip_h + 24;
+    cell_w = (W - 80) / cols;
+    cell_h = (H - top - 40) / rows;
+    for (i = 0; i < tv.n; i++)
+    {
+        int c = i % cols, r = i / cols, cx = 40 + c * cell_w, cy = top + r * cell_h;
+        struct thumb *t = find_thumb( tv.items[i].hwnd );
+        int bw = cell_w - 40, bh = cell_h - 64, tw, th;
+        double ta = t ? (double)t->size.cy / t->size.cx : 0.66;
+
+        tw = bw; th = (int)(tw * ta);
+        if (th > bh) { th = bh; tw = (int)(th / ta); }
+        if (tw > 480) { tw = 480; th = (int)(tw * ta); }
+        SetRect( &tv.items[i].rect, cx + (cell_w - tw) / 2, cy + 30 + (bh - th) / 2,
+                 cx + (cell_w - tw) / 2 + tw, cy + 30 + (bh - th) / 2 + th );
+    }
+}
+
+static HFONT make_font( int height, int weight )
+{
+    NONCLIENTMETRICSW ncm = { sizeof(ncm) };
+    SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+    ncm.lfMessageFont.lfHeight = height;
+    ncm.lfMessageFont.lfWeight = weight;
+    return CreateFontIndirectW( &ncm.lfMessageFont );
+}
+
+static void fill( HDC dc, const RECT *r, COLORREF c )
+{
+    HBRUSH b = CreateSolidBrush( c );
+    FillRect( dc, r, b );
+    DeleteObject( b );
+}
+
+static void frame( HDC dc, const RECT *r, COLORREF c, int width )
+{
+    RECT e;
+    SetRect( &e, r->left - width, r->top - width, r->right + width, r->top ); fill( dc, &e, c );
+    SetRect( &e, r->left - width, r->bottom, r->right + width, r->bottom + width ); fill( dc, &e, c );
+    SetRect( &e, r->left - width, r->top, r->left, r->bottom ); fill( dc, &e, c );
+    SetRect( &e, r->right, r->top, r->right + width, r->bottom ); fill( dc, &e, c );
+}
+
+struct mini { const RECT *tile; int desktop; HDC dc; };
+
+/* a desktop tile: the desktop colour with its windows' outlines, drawn to scale */
+static BOOL CALLBACK mini_proc( HWND hwnd, LPARAM lparam )
+{
+    struct mini *m = (struct mini *)lparam;
+    RECT rc, r;
+    int sw = GetSystemMetrics( SM_CXSCREEN ), sh = GetSystemMetrics( SM_CYSCREEN );
+    int tw = m->tile->right - m->tile->left, th = m->tile->bottom - m->tile->top;
+
+    if (!IsWindowVisible( hwnd ) || IsIconic( hwnd ) || !is_app_window( hwnd )) return TRUE;
+    if (desktop_of( hwnd ) != m->desktop) return TRUE;
+    GetWindowRect( hwnd, &rc );
+    SetRect( &r, m->tile->left + MulDiv( rc.left, tw, sw ), m->tile->top + MulDiv( rc.top, th, sh ),
+             m->tile->left + MulDiv( rc.right, tw, sw ), m->tile->top + MulDiv( rc.bottom, th, sh ));
+    IntersectRect( &r, &r, m->tile );
+    fill( m->dc, &r, RGB(0xF4,0xF4,0xF4) );
+    frame( m->dc, &r, RGB(0x60,0x60,0x60), 1 );
+    return TRUE;
+}
+
+/* EnumWindows is top to bottom; outlines must be drawn bottom to top */
+static BOOL CALLBACK mini_collect( HWND hwnd, LPARAM lparam )
+{
+    HWND *list = (HWND *)lparam;
+    int i;
+    for (i = 0; list[i] && i < 255; i++) ;
+    if (i < 255) list[i] = hwnd;
+    return TRUE;
+}
+
+static void draw_tile( HDC dc, int d )
+{
+    const RECT *r = &tv.tiles[d];
+    HWND list[256] = {0};
+    struct mini m = { r, d, dc };
+    RECT label;
+    WCHAR name[64];
+    int i;
+
+    fill( dc, r, GetSysColor( COLOR_DESKTOP ));
+    EnumWindows( mini_collect, (LPARAM)list );
+    for (i = 0; list[i]; i++) ;
+    while (i--) mini_proc( list[i], (LPARAM)&m );
+    if (d == vd_current) frame( dc, r, COL_ACCENT, 3 );
+    else if (d == tv.hot_tile || d == tv.shown) frame( dc, r, COL_SUBTLE, 2 );
+
+    vd_name( d, name, ARRAY_SIZE(name) );
+    SetRect( &label, r->left, r->bottom + 6, r->right, r->bottom + 30 );
+    SetTextColor( dc, COL_TEXT );
+    DrawTextW( dc, name, -1, &label, DT_CENTER | DT_SINGLELINE | DT_END_ELLIPSIS );
+
+    if (vd_count > 1 && d == tv.hot_tile)
+    {
+        fill( dc, &tv.tile_close[d], d == tv.hot_close ? RGB(0xC4,0x2B,0x1C) : RGB(0x40,0x40,0x40) );
+        DrawTextW( dc, L"\x2715", -1, (RECT *)&tv.tile_close[d], DT_CENTER | DT_VCENTER | DT_SINGLELINE );
+    }
+}
+
+static void draw_item( HDC dc, int i )
+{
+    struct tv_item *it = &tv.items[i];
+    struct thumb *t = find_thumb( it->hwnd );
+    RECT title = it->rect, r = it->rect;
+    WCHAR text[256];
+    HICON icon;
+
+    if (tv.dragging && tv.drag == i)
+        OffsetRect( &r, tv.drag_at.x - tv.drag_from.x, tv.drag_at.y - tv.drag_from.y );
+
+    if (t && t->bitmap)
+    {
+        HDC mdc = CreateCompatibleDC( dc );
+        SelectObject( mdc, t->bitmap );
+        SetStretchBltMode( dc, HALFTONE );
+        StretchBlt( dc, r.left, r.top, r.right - r.left, r.bottom - r.top, mdc, 0, 0, t->size.cx, t->size.cy, SRCCOPY );
+        DeleteDC( mdc );
+    }
+    else
+    {
+        /* never seen active: a card with its icon */
+        fill( dc, &r, COL_TILE_BG );
+        icon = (HICON)GetClassLongPtrW( it->hwnd, GCLP_HICON );
+        if (!icon) icon = LoadIconW( 0, (const WCHAR *)IDI_APPLICATION );
+        DrawIconEx( dc, (r.left + r.right) / 2 - 24, (r.top + r.bottom) / 2 - 24, icon, 48, 48, 0, 0, DI_NORMAL );
+    }
+    if (i == tv.hot_item || i == tv.sel) frame( dc, &r, COL_ACCENT, 3 );
+
+    /* icon and title above it */
+    title.top = r.top - 28; title.bottom = r.top - 6; title.left = r.left; title.right = r.right;
+    icon = (HICON)GetClassLongPtrW( it->hwnd, GCLP_HICONSM );
+    if (icon) DrawIconEx( dc, title.left, title.top + 3, icon, 16, 16, 0, 0, DI_NORMAL );
+    title.left += icon ? 22 : 0;
+    GetWindowTextW( it->hwnd, text, ARRAY_SIZE(text) );
+    SetTextColor( dc, COL_TEXT );
+    DrawTextW( dc, text, -1, &title, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS );
+}
+
+static void tv_paint( HWND hwnd, HDC dc )
+{
+    RECT rc;
+    HFONT font = make_font( -13, FW_NORMAL ), big = make_font( -48, FW_LIGHT ), old;
+    int i;
+
+    GetClientRect( hwnd, &rc );
+    fill( dc, &rc, COL_BG );
+    SetBkMode( dc, TRANSPARENT );
+    old = SelectObject( dc, font );
+
+    for (i = 0; i < vd_count; i++) draw_tile( dc, i );
+    if (vd_count < VD_MAX)
+    {
+        RECT label = tv.new_tile;
+        fill( dc, &tv.new_tile, tv.hot_new ? COL_HOVER : COL_TILE_BG );
+        SelectObject( dc, big );
+        SetTextColor( dc, COL_TEXT );
+        DrawTextW( dc, L"+", -1, &tv.new_tile, DT_CENTER | DT_VCENTER | DT_SINGLELINE );
+        SelectObject( dc, font );
+        SetRect( &label, tv.new_tile.left, tv.new_tile.bottom + 6, tv.new_tile.right, tv.new_tile.bottom + 30 );
+        DrawTextW( dc, L"New desktop", -1, &label, DT_CENTER | DT_SINGLELINE );
+    }
+
+    for (i = 0; i < tv.n; i++) if (!(tv.dragging && i == tv.drag)) draw_item( dc, i );
+    if (!tv.n)
+    {
+        RECT msg = rc;
+        msg.top = tv.tiles[0].bottom + 40;
+        SetTextColor( dc, COL_SUBTLE );
+        DrawTextW( dc, L"No windows open on this desktop", -1, &msg, DT_CENTER | DT_TOP | DT_SINGLELINE );
+    }
+    if (tv.dragging && tv.drag >= 0) draw_item( dc, tv.drag );  /* dragged on top */
+
+    SelectObject( dc, old );
+    DeleteObject( font );
+    DeleteObject( big );
+}
+
+static int hit_item( POINT pt )
+{
+    int i;
+    for (i = 0; i < tv.n; i++) if (PtInRect( &tv.items[i].rect, pt )) return i;
+    return -1;
+}
+
+static int hit_tile( POINT pt )
+{
+    int i;
+    for (i = 0; i < vd_count; i++) if (PtInRect( &tv.tiles[i], pt )) return i;
+    return -1;
+}
+
+static void tv_close(void)
+{
+    if (taskview) DestroyWindow( taskview );
+}
+
+static void tv_refresh( HWND hwnd )
+{
+    tv_layout( hwnd );
+    InvalidateRect( hwnd, NULL, FALSE );
+}
+
+static void tv_item_menu( HWND hwnd, int i, POINT screen )
+{
+    HMENU menu = CreatePopupMenu(), move = CreatePopupMenu();
+    HWND target = tv.items[i].hwnd;
+    WCHAR name[64];
+    int d, cmd;
+    BOOL pinned = !!GetPropW( target, prop_pinned );
+
+    for (d = 0; d < vd_count; d++)
+    {
+        vd_name( d, name, ARRAY_SIZE(name) );
+        AppendMenuW( move, MF_STRING | (d == desktop_of( target ) ? MF_GRAYED : 0), 100 + d, name );
+    }
+    AppendMenuW( move, MF_STRING | (vd_count >= VD_MAX ? MF_GRAYED : 0), 99, L"New desktop" );
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)move, L"Move to" );
+    AppendMenuW( menu, MF_STRING | (pinned ? MF_CHECKED : 0), 98, L"Show this window on all desktops" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, 97, L"Close" );
+    cmd = TrackPopupMenu( menu, TPM_RETURNCMD | TPM_RIGHTBUTTON, screen.x, screen.y, 0, hwnd, NULL );
+    DestroyMenu( menu );
+    if (cmd >= 100) vd_move_window( target, cmd - 100 );
+    else if (cmd == 99) { vd_new( FALSE ); vd_move_window( target, vd_count - 1 ); }
+    else if (cmd == 98) vd_pin_window( target, !pinned );
+    else if (cmd == 97) PostMessageW( target, WM_SYSCOMMAND, SC_CLOSE, 0 );
+    if (cmd) tv_refresh( hwnd );
+}
+
+static void tv_activate( int i )
+{
+    HWND target = tv.items[i].hwnd;
+    int d = desktop_of( target );
+
+    tv_close();
+    if (d >= 0 && d != vd_current) vd_switch( d, FALSE );
+    if (IsIconic( target )) ShowWindow( target, SW_RESTORE );
+    SetForegroundWindow( target );
+}
+
+static LRESULT CALLBACK tv_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    POINT pt = { (short)LOWORD(lp), (short)HIWORD(lp) };
+
+    switch (msg)
+    {
+    case WM_CREATE:
+        tv.shown = vd_current;
+        tv.hot_item = tv.hot_tile = tv.hot_close = tv.drag = tv.sel = -1;
+        tv.hot_new = tv.dragging = FALSE;
+        tv_layout( hwnd );
+        return 0;
+
+    case WM_ERASEBKGND:
+        return 1;
+
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        RECT rc;
+        HDC dc = BeginPaint( hwnd, &ps ), mdc;
+        HBITMAP bmp;
+
+        GetClientRect( hwnd, &rc );
+        mdc = CreateCompatibleDC( dc );
+        bmp = CreateCompatibleBitmap( dc, rc.right, rc.bottom );
+        SelectObject( mdc, bmp );
+        tv_paint( hwnd, mdc );
+        BitBlt( dc, 0, 0, rc.right, rc.bottom, mdc, 0, 0, SRCCOPY );
+        DeleteDC( mdc );
+        DeleteObject( bmp );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+
+    case WM_MOUSEMOVE:
+    {
+        int item = hit_item( pt ), tile = hit_tile( pt ), close = -1;
+        BOOL new_hot = PtInRect( &tv.new_tile, pt );
+
+        if (tile >= 0 && PtInRect( &tv.tile_close[tile], pt )) close = tile;
+        if (tv.drag >= 0 && (wp & MK_LBUTTON))
+        {
+            if (!tv.dragging && (abs( pt.x - tv.drag_from.x ) > 6 || abs( pt.y - tv.drag_from.y ) > 6))
+                tv.dragging = TRUE;
+            tv.drag_at = pt;
+        }
+        /* hovering a desktop shows its windows, as in Windows 10 */
+        if (!tv.dragging && tile >= 0 && tile != tv.shown)
+        {
+            tv.shown = tile;
+            tv_layout( hwnd );
+            item = -1;
+        }
+        if (item != tv.hot_item || tile != tv.hot_tile || close != tv.hot_close || new_hot != tv.hot_new || tv.dragging)
+        {
+            tv.hot_item = item; tv.hot_tile = tile; tv.hot_close = close; tv.hot_new = new_hot;
+            InvalidateRect( hwnd, NULL, FALSE );
+        }
+        return 0;
+    }
+
+    case WM_LBUTTONDOWN:
+        tv.drag = hit_item( pt );
+        tv.drag_from = tv.drag_at = pt;
+        tv.dragging = FALSE;
+        SetCapture( hwnd );
+        return 0;
+
+    case WM_LBUTTONUP:
+    {
+        int item = tv.drag, tile = hit_tile( pt );
+        BOOL was_drag = tv.dragging;
+
+        ReleaseCapture();
+        tv.drag = -1; tv.dragging = FALSE;
+        if (was_drag && item >= 0)
+        {
+            /* dropped on a desktop: move it there */
+            if (tile >= 0) vd_move_window( tv.items[item].hwnd, tile );
+            else if (PtInRect( &tv.new_tile, pt )) { vd_new( FALSE ); vd_move_window( tv.items[item].hwnd, vd_count - 1 ); }
+            tv_refresh( hwnd );
+            return 0;
+        }
+        if (item >= 0 && item == hit_item( pt )) { tv_activate( item ); return 0; }
+        if (tile >= 0 && PtInRect( &tv.tile_close[tile], pt ) && vd_count > 1)
+        {
+            vd_close( tile );
+            tv.shown = vd_current;
+            tv_refresh( hwnd );
+            return 0;
+        }
+        if (tile >= 0) { tv_close(); vd_switch( tile, FALSE ); return 0; }
+        if (PtInRect( &tv.new_tile, pt )) { vd_new( FALSE ); tv_refresh( hwnd ); return 0; }
+        tv_close();  /* the empty background closes it */
+        return 0;
+    }
+
+    case WM_RBUTTONUP:
+    {
+        int item = hit_item( pt );
+        if (item >= 0)
+        {
+            ClientToScreen( hwnd, &pt );
+            tv_item_menu( hwnd, item, pt );
+        }
+        return 0;
+    }
+
+    case WM_MBUTTONUP:
+    {
+        int item = hit_item( pt );
+        if (item >= 0) { PostMessageW( tv.items[item].hwnd, WM_SYSCOMMAND, SC_CLOSE, 0 ); SetTimer( hwnd, 1, 400, NULL ); }
+        return 0;
+    }
+
+    case WM_TIMER:
+        KillTimer( hwnd, 1 );
+        tv_refresh( hwnd );
+        return 0;
+
+    case WM_KEYDOWN:
+        switch (wp)
+        {
+        case VK_ESCAPE: tv_close(); return 0;
+        case VK_RETURN: if (tv.sel >= 0 && tv.sel < tv.n) tv_activate( tv.sel ); return 0;
+        case VK_RIGHT: case VK_DOWN: case VK_TAB:
+            if (tv.n) tv.sel = (tv.sel + 1) % tv.n;
+            InvalidateRect( hwnd, NULL, FALSE ); return 0;
+        case VK_LEFT: case VK_UP:
+            if (tv.n) tv.sel = (tv.sel <= 0 ? tv.n : tv.sel) - 1;
+            InvalidateRect( hwnd, NULL, FALSE ); return 0;
+        case VK_DELETE:
+            if (tv.sel >= 0 && tv.sel < tv.n) { PostMessageW( tv.items[tv.sel].hwnd, WM_SYSCOMMAND, SC_CLOSE, 0 ); SetTimer( hwnd, 1, 400, NULL ); }
+            return 0;
+        }
+        break;
+
+    case WM_ACTIVATE:
+        if (LOWORD(wp) == WA_INACTIVE && !GetCapture()) tv_close();
+        return 0;
+
+    case WM_DESTROY:
+        taskview = 0;
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+void vd_taskview( BOOL toggle )
+{
+    RECT work;
+    HWND fg;
+
+    if (taskview) { if (toggle) tv_close(); return; }
+    if ((fg = GetForegroundWindow()) && (fg = GetAncestor( fg, GA_ROOTOWNER )) && is_app_window( fg ))
+        capture_thumb( fg );
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    taskview = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW, L"SgTaskView", L"Task View", WS_POPUP,
+                                work.left, work.top, work.right - work.left, work.bottom - work.top,
+                                0, 0, 0, 0 );
+    if (!taskview) return;
+    ShowWindow( taskview, SW_SHOW );
+    SetForegroundWindow( taskview );
+    SetFocus( taskview );
+}
+
+/* ---- Alt+Tab ------------------------------------------------------------ */
+
+/* The current desktop's windows, most recently used first (Z order), each
+ * with its thumbnail; Tab moves on while Alt is held, releasing Alt
+ * activates the selection, Escape cancels. */
+static struct { HWND items[32]; int n, sel; HHOOK hook; DWORD opened; } sw;
+
+#define WM_SWITCHER_COMMIT (WM_USER + 1)
+#define WM_SWITCHER_CANCEL (WM_USER + 2)
+
+/* while the switcher is up: Alt's release commits, Escape cancels */
+static LRESULT CALLBACK switcher_keys( int code, WPARAM wp, LPARAM lp )
+{
+    const KBDLLHOOKSTRUCT *k = (const KBDLLHOOKSTRUCT *)lp;
+
+    if (code == HC_ACTION && switcher)
+    {
+        BOOL up = (wp == WM_KEYUP || wp == WM_SYSKEYUP);
+        if (up && (k->vkCode == VK_MENU || k->vkCode == VK_LMENU || k->vkCode == VK_RMENU))
+            PostMessageW( switcher, WM_SWITCHER_COMMIT, 0, 0 );
+        else if (!up && k->vkCode == VK_ESCAPE)
+        {
+            PostMessageW( switcher, WM_SWITCHER_CANCEL, 0, 0 );
+            return 1;
+        }
+    }
+    return CallNextHookEx( 0, code, wp, lp );
+}
+
+
+static void switcher_commit( HWND hwnd )
+{
+    HWND target = sw.sel >= 0 && sw.sel < sw.n ? sw.items[sw.sel] : 0;
+    DestroyWindow( hwnd );
+    if (!target) return;
+    if (IsIconic( target )) ShowWindow( target, SW_RESTORE );
+    SetForegroundWindow( target );
+}
+
+static BOOL CALLBACK switcher_collect( HWND hwnd, LPARAM lparam )
+{
+    int d;
+    if (sw.n >= ARRAY_SIZE(sw.items)) return FALSE;
+    if (!IsWindowVisible( hwnd ) || !is_app_window( hwnd )) return TRUE;
+    if ((d = desktop_of( hwnd )) >= 0 && d != vd_current) return TRUE;
+    sw.items[sw.n++] = hwnd;
+    return TRUE;
+}
+
+#define SW_CELL_W 240
+#define SW_CELL_H 190
+
+static void switcher_cell( int i, RECT *r )
+{
+    SetRect( r, 16 + i * SW_CELL_W, 16, 16 + (i + 1) * SW_CELL_W, 16 + SW_CELL_H );
+}
+
+static LRESULT CALLBACK switcher_proc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        RECT rc;
+        HDC dc = BeginPaint( hwnd, &ps );
+        HFONT font = make_font( -13, FW_NORMAL ), old;
+        int i;
+
+        GetClientRect( hwnd, &rc );
+        fill( dc, &rc, COL_BG );
+        SetBkMode( dc, TRANSPARENT );
+        old = SelectObject( dc, font );
+        for (i = 0; i < sw.n; i++)
+        {
+            RECT cell, pic, title;
+            struct thumb *t = find_thumb( sw.items[i] );
+            WCHAR text[256];
+            int bw = SW_CELL_W - 24, bh = SW_CELL_H - 48, tw = bw, th;
+            double a = t ? (double)t->size.cy / t->size.cx : 0.66;
+
+            switcher_cell( i, &cell );
+            if (i == sw.sel) fill( dc, &cell, COL_HOVER );
+            th = (int)(tw * a);
+            if (th > bh) { th = bh; tw = (int)(th / a); }
+            SetRect( &pic, cell.left + (SW_CELL_W - tw) / 2, cell.top + 36 + (bh - th) / 2, 0, 0 );
+            pic.right = pic.left + tw; pic.bottom = pic.top + th;
+            if (t && t->bitmap)
+            {
+                HDC mdc = CreateCompatibleDC( dc );
+                SelectObject( mdc, t->bitmap );
+                SetStretchBltMode( dc, HALFTONE );
+                StretchBlt( dc, pic.left, pic.top, tw, th, mdc, 0, 0, t->size.cx, t->size.cy, SRCCOPY );
+                DeleteDC( mdc );
+            }
+            else
+            {
+                HICON icon = (HICON)GetClassLongPtrW( sw.items[i], GCLP_HICON );
+                fill( dc, &pic, COL_TILE_BG );
+                if (!icon) icon = LoadIconW( 0, (const WCHAR *)IDI_APPLICATION );
+                DrawIconEx( dc, (pic.left + pic.right) / 2 - 24, (pic.top + pic.bottom) / 2 - 24, icon, 48, 48, 0, 0, DI_NORMAL );
+            }
+            if (i == sw.sel) frame( dc, &cell, COL_ACCENT, 2 );
+            SetRect( &title, cell.left + 10, cell.top + 8, cell.right - 10, cell.top + 30 );
+            {
+                HICON icon = (HICON)GetClassLongPtrW( sw.items[i], GCLP_HICONSM );
+                if (icon) { DrawIconEx( dc, title.left, title.top + 3, icon, 16, 16, 0, 0, DI_NORMAL ); title.left += 22; }
+            }
+            GetWindowTextW( sw.items[i], text, ARRAY_SIZE(text) );
+            SetTextColor( dc, COL_TEXT );
+            DrawTextW( dc, text, -1, &title, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS );
+        }
+        SelectObject( dc, old );
+        DeleteObject( font );
+        EndPaint( hwnd, &ps );
+        return 0;
+    }
+    case WM_SWITCHER_COMMIT:
+        switcher_commit( hwnd );
+        return 0;
+    case WM_SWITCHER_CANCEL:
+        DestroyWindow( hwnd );
+        return 0;
+    case WM_TIMER:
+        /* in case the hook saw nothing: Alt has been up for a while */
+        if (GetTickCount() - sw.opened > 1000 && GetAsyncKeyState( VK_MENU ) >= 0) switcher_commit( hwnd );
+        return 0;
+    case WM_DESTROY:
+        if (sw.hook) UnhookWindowsHookEx( sw.hook );
+        sw.hook = 0;
+        switcher = 0;
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wp, lp );
+}
+
+void vd_alttab( BOOL back )
+{
+    HWND fg;
+    int w, h;
+
+    if (switcher)
+    {
+        if (sw.n) sw.sel = (sw.sel + (back ? sw.n - 1 : 1)) % sw.n;
+        InvalidateRect( switcher, NULL, FALSE );
+        return;
+    }
+    if (taskview) return;
+    if ((fg = GetForegroundWindow()) && (fg = GetAncestor( fg, GA_ROOTOWNER )) && is_app_window( fg ))
+        capture_thumb( fg );
+    sw.n = 0;
+    EnumWindows( switcher_collect, 0 );
+    if (sw.n < 1) return;
+    /* the first press already moves to the previous window, as on Windows */
+    sw.sel = sw.n > 1 ? (back ? sw.n - 1 : 1) : 0;
+    w = min( sw.n, (GetSystemMetrics( SM_CXSCREEN ) - 64) / SW_CELL_W ) * SW_CELL_W + 32;
+    h = SW_CELL_H + 32;
+    switcher = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE, L"SgTaskSwitcher", L"Task Switching",
+                                WS_POPUP, (GetSystemMetrics( SM_CXSCREEN ) - w) / 2,
+                                (GetSystemMetrics( SM_CYSCREEN ) - h) / 2, w, h, 0, 0, 0, 0 );
+    if (!switcher) return;
+    sw.opened = GetTickCount();
+    sw.hook = SetWindowsHookExW( WH_KEYBOARD_LL, switcher_keys, GetModuleHandleW( NULL ), 0 );
+    ShowWindow( switcher, SW_SHOWNOACTIVATE );
+    UpdateWindow( switcher );
+    SetTimer( switcher, 1, 100, NULL );
+}
+
+/* ---- hotkeys and the setup --------------------------------------------- */
+
+BOOL vd_hotkey( WPARAM id )
+{
+    HWND fg = GetForegroundWindow();
+
+    switch (id)
+    {
+    case HK_NEW: vd_new( TRUE ); return TRUE;
+    case HK_CLOSE: vd_close( vd_current ); show_osd(); return TRUE;
+    case HK_LEFT: vd_switch( vd_current - 1, TRUE ); return TRUE;
+    case HK_RIGHT: vd_switch( vd_current + 1, TRUE ); return TRUE;
+    case HK_MOVE_LEFT:
+    case HK_MOVE_RIGHT:
+    {
+        int to = vd_current + (id == HK_MOVE_LEFT ? -1 : 1);
+        HWND root = fg ? GetAncestor( fg, GA_ROOTOWNER ) : 0;
+        if (to < 0 || to >= vd_count || !root || !is_app_window( root )) return TRUE;
+        SetPropW( root, prop_desktop, (HANDLE)(INT_PTR)(to + 1) );
+        vd_switch( to, TRUE );   /* the window goes along */
+        SetForegroundWindow( root );
+        return TRUE;
+    }
+    case HK_TASKVIEW: vd_taskview( TRUE ); return TRUE;
+    case HK_ALTTAB: vd_alttab( FALSE ); return TRUE;
+    case HK_ALTTAB_BACK: vd_alttab( TRUE ); return TRUE;
+    }
+    return FALSE;
+}
+
+/* The Task View button on the taskbar: two overlapping frames. */
+void vd_paint_button( HDC dc, const RECT *rect, COLORREF fg )
+{
+    int cx = (rect->left + rect->right) / 2, cy = (rect->top + rect->bottom) / 2;
+    RECT a, b;
+
+    SetRect( &a, cx - 8, cy - 7, cx + 4, cy + 3 );
+    SetRect( &b, cx - 4, cy - 3, cx + 8, cy + 7 );
+    frame( dc, &a, fg, 1 );
+    frame( dc, &b, fg, 1 );
+}
+
+void initialize_vdesktops( HWND tray )
+{
+    WNDCLASSW wc = { 0 };
+
+    vd_tray = tray;
+    load_state();
+    if (vd_current >= vd_count) vd_current = 0;
+
+    wc.lpfnWndProc = tv_proc;
+    wc.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+    wc.lpszClassName = L"SgTaskView";
+    RegisterClassW( &wc );
+    wc.lpfnWndProc = osd_proc;
+    wc.lpszClassName = L"SgVirtualDesktopOsd";
+    RegisterClassW( &wc );
+    wc.lpfnWndProc = switcher_proc;
+    wc.lpszClassName = L"SgTaskSwitcher";
+    RegisterClassW( &wc );
+
+    RegisterHotKey( tray, HK_NEW, MOD_WIN | MOD_CONTROL | MOD_NOREPEAT, 'D' );
+    RegisterHotKey( tray, HK_CLOSE, MOD_WIN | MOD_CONTROL | MOD_NOREPEAT, VK_F4 );
+    RegisterHotKey( tray, HK_LEFT, MOD_WIN | MOD_CONTROL, VK_LEFT );
+    RegisterHotKey( tray, HK_RIGHT, MOD_WIN | MOD_CONTROL, VK_RIGHT );
+    RegisterHotKey( tray, HK_MOVE_LEFT, MOD_WIN | MOD_CONTROL | MOD_SHIFT, VK_LEFT );
+    RegisterHotKey( tray, HK_MOVE_RIGHT, MOD_WIN | MOD_CONTROL | MOD_SHIFT, VK_RIGHT );
+    RegisterHotKey( tray, HK_TASKVIEW, MOD_WIN | MOD_NOREPEAT, VK_TAB );
+    RegisterHotKey( tray, HK_ALTTAB, MOD_ALT, VK_TAB );
+    RegisterHotKey( tray, HK_ALTTAB_BACK, MOD_ALT | MOD_SHIFT, VK_TAB );
+    SetTimer( tray, 0x5646, 250, watch_foreground );
+    EnumWindows( apply_proc, 0 );
+}
+
+/* Requests from other processes (IVirtualDesktopManager, sg tools, the
+ * gate): the registered message "SgVirtualDesktopCommand". */
+LRESULT vd_command( WPARAM wp, LPARAM lp )
+{
+    switch (wp)
+    {
+    case 0: return vd_count | (vd_current << 8);            /* query */
+    case 1: vd_switch( (int)lp, TRUE ); return vd_current;  /* switch to lp */
+    case 2: vd_new( lp != 0 ); return vd_count;             /* new (and go) */
+    case 3: vd_close( (int)lp ); return vd_count;           /* close lp */
+    case 4: vd_taskview( TRUE ); return taskview != 0;      /* toggle Task View */
+    }
+    if (wp >= 0x100 && wp < 0x100 + VD_MAX) { vd_move_window( (HWND)lp, wp - 0x100 ); return 1; } /* move window lp */
+    return 0;
+}
