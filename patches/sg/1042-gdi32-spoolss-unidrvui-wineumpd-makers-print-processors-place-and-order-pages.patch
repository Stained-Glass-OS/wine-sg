--- a/dlls/spoolss/spoolss_main.c
+++ b/dlls/spoolss/spoolss_main.c
@@ -307,6 +307,47 @@
  * page order and copies, from the job's devmode.  We let the processor do
  * the copies; the driver gets one of each page.
  */
+/* the printer's configuration DLL answers (DrvQueryJobAttributes), as on
+ * Windows; a processor opened with the port's name ("port, Port") has the
+ * printer's name in the job's devmode */
+static BOOL driver_job_attributes( const WCHAR *printer, DEVMODEW *devmode, struct attribute_info_3 *attr )
+{
+    BOOL (WINAPI *query)( HANDLE, DEVMODEW *, DWORD, BYTE * );
+    WCHAR name[MAX_PATH];
+    DRIVER_INFO_2W *di = NULL;
+    HANDLE handle = NULL;
+    HMODULE module = NULL;
+    DWORD needed = 0;
+    size_t len;
+    BOOL ret = FALSE;
+
+#ifdef SG_MUTANT_QUERYJOBATTR
+    return FALSE;
+#endif
+    lstrcpynW( name, printer, ARRAY_SIZE(name) );
+    len = wcslen( name );
+    if (len > 6 && !wcscmp( name + len - 6, L", Port" ))
+    {
+        if (!devmode) return FALSE;
+        lstrcpynW( name, devmode->dmDeviceName, CCHDEVICENAME );
+    }
+    if (!OpenPrinterW( name, &handle, NULL )) return FALSE;
+    GetPrinterDriverW( handle, NULL, 2, NULL, 0, &needed );
+    if (needed && (di = malloc( needed )) && GetPrinterDriverW( handle, NULL, 2, (BYTE *)di, needed, &needed ) &&
+        di->pConfigFile && (module = LoadLibraryW( di->pConfigFile )) &&
+        (query = (void *)GetProcAddress( module, "DrvQueryJobAttributes" )))
+    {
+        ret = query( handle, devmode, 3, (BYTE *)attr ) ||
+              (memset( attr, 0, sizeof(*attr) ), query( handle, devmode, 1, (BYTE *)attr ));
+        TRACE( "%s: page order job %lu driver %lu, copies %lu/%lu\n", debugstr_w(name), attr->dwJobPageOrderFlags,
+               attr->dwDrvPageOrderFlags, attr->dwJobNumberOfCopies, attr->dwDrvNumberOfCopies );
+    }
+    if (module) FreeLibrary( module );
+    free( di );
+    ClosePrinter( handle );
+    return ret;
+}
+
 BOOL WINAPI GetJobAttributes( WCHAR *printer, DEVMODEW *devmode, void *info )
 {
     struct attribute_info_3 *attr = info;
@@ -314,6 +355,8 @@
     TRACE( "%s %p %p\n", debugstr_w(printer), devmode, info );
     if (!attr) return FALSE;
     memset( attr, 0, sizeof(*attr) );
+    if (printer && driver_job_attributes( printer, devmode, attr )) return TRUE;
+    memset( attr, 0, sizeof(*attr) );
     attr->dwJobNumberOfPagesPerSide = 1;
     attr->dwDrvNumberOfPagesPerSide = 1;
     attr->dwJobNumberOfCopies = devmode && (devmode->dmFields & DM_COPIES) && devmode->dmCopies > 0 ? devmode->dmCopies : 1;
--- a/dlls/unidrvui/ui.c
+++ b/dlls/unidrvui/ui.c
@@ -705,6 +705,75 @@
 }
 
 /***********************************************************************
+ *           DrvQueryJobAttributes    (UNIDRVUI.@)
+ *
+ * What a print processor plays a job with (Microsoft Learn,
+ * DrvQueryJobAttributes, ATTRIBUTE_INFO_1-4): one page per side, copies
+ * done by the processor, and the page order the user chose. A printer whose
+ * GPD has a page order feature (the print schema's JobPageOrder) orders the
+ * pages itself, so the driver reports it can (Lexmark's processor otherwise
+ * sends the last page first).
+ */
+#define SG_NORMAL_PRINT  0x00000000
+#define SG_REVERSE_PRINT 0x00000001
+BOOL WINAPI DrvQueryJobAttributes( HANDLE printer, DEVMODEW *dm, DWORD level, BYTE *info )
+{
+    DWORD *a = (DWORD *)info;  /* ATTRIBUTE_INFO_1's members, then 2's, 3's, 4's */
+    struct uni_ui *uu;
+    unsigned int f;
+    BOOL has_order = FALSE, reverse = FALSE;
+
+    TRACE( "%p %p %lu %p\n", printer, dm, level, info );
+    if (!info || !level || level > 4) return FALSE;
+    {
+        PRINTER_INFO_4W *pi = NULL;
+        DWORD needed = 0;
+        WCHAR name[MAX_PATH] = L"";
+
+        GetPrinterW( printer, 4, NULL, 0, &needed );
+        if (needed && (pi = malloc( needed )) && GetPrinterW( printer, 4, (BYTE *)pi, needed, &needed ) &&
+            pi->pPrinterName)
+            lstrcpynW( name, pi->pPrinterName, ARRAY_SIZE(name) );
+        free( pi );
+        uu = uni_ui_create( printer, name, dm, FALSE );
+    }
+    if (uu)
+    {
+        for (f = 0; f < uu->ui.feature_count; f++)
+        {
+            struct drvui_feature *df = &uu->ui.features[f];
+            const char *opt;
+
+            if (!df->name) continue;
+            if (_stricmp( df->name, "ReverseOrderPrinting" ) && _stricmp( df->name, "JobPageOrder" ) &&
+                _stricmp( df->name, "PageOrder" ) && _stricmp( df->name, "OutputOrder" )) continue;
+            has_order = TRUE;
+            if (df->sel < 0 || df->sel >= df->count) continue;
+            if (!(opt = df->options[df->sel].name)) continue;
+            reverse = !_stricmp( opt, "Reverse" ) || !_stricmp( opt, "BackToFront" ) || !_stricmp( opt, "Back2Front" );
+        }
+        uni_ui_free( uu );
+    }
+    memset( a, 0, 7 * sizeof(DWORD) );
+    a[0] = a[1] = 1;                                           /* pages per side: job, driver */
+    a[3] = reverse ? SG_REVERSE_PRINT : SG_NORMAL_PRINT;       /* job page order */
+#ifndef SG_MUTANT_DRVORDER
+    a[4] = has_order ? SG_REVERSE_PRINT : SG_NORMAL_PRINT;     /* the driver's */
+#endif
+    a[5] = dm && (dm->dmFields & DM_COPIES) && dm->dmCopies > 0 ? dm->dmCopies : 1;
+    a[6] = 1;                                                  /* the processor makes the copies */
+    if (level >= 2) a[7] = 0;                                  /* no colour optimization */
+    if (level >= 3)
+    {
+        short *q = (short *)(a + 8);
+        q[0] = dm && (dm->dmFields & DM_PRINTQUALITY) ? dm->dmPrintQuality : 0;
+        q[1] = dm && (dm->dmFields & DM_YRESOLUTION) ? dm->dmYResolution : 0;
+    }
+    TRACE( "page order job %lu driver %lu, copies %lu\n", a[3], a[4], a[5] );
+    return TRUE;
+}
+
+/***********************************************************************
  *           __wine_driver_features    (UNIDRVUI.@)
  *
  * The driver's own settings, for the print schema (prntvpt): one line per
--- a/dlls/unidrvui/unidrvui.spec
+++ b/dlls/unidrvui/unidrvui.spec
@@ -5,5 +5,6 @@
 @ stdcall DrvDocumentPropertySheets(ptr long)
 @ stdcall DrvDriverEvent(long long ptr long)
 @ stdcall DrvPrinterEvent(wstr long long long)
+@ stdcall DrvQueryJobAttributes(ptr ptr long ptr)
 @ stdcall __wine_driver_features(ptr wstr ptr ptr long)
 @ stdcall __wine_driver_set_feature(ptr wstr ptr wstr wstr)
--- a/dlls/wineumpd.drv/unixlib.c
+++ b/dlls/wineumpd.drv/unixlib.c
@@ -135,7 +135,13 @@
     case COLORRES: return 0;
     case NUMRESERVED: return 0;
     case SCALINGFACTORX: case SCALINGFACTORY: return 0;
-    case VREFRESH: case DESKTOPHORZRES: case DESKTOPVERTRES: case BLTALIGNMENT: return 0;
+#ifndef SG_MUTANT_DESKTOPRES
+    /* a printer's "desktop" is its printable area, as GDI answers for any
+     * device but a display (makers' print processors size the page by it) */
+    case DESKTOPHORZRES: return sw ? c->phys_h : c->phys_w;
+    case DESKTOPVERTRES: return sw ? c->phys_w : c->phys_h;
+#endif
+    case VREFRESH: case BLTALIGNMENT: return 0;
     }
     dev = GET_NEXT_PHYSDEV( dev, pGetDeviceCaps );
     return dev->funcs->pGetDeviceCaps( dev, cap );
