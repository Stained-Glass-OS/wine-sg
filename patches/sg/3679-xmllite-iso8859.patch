From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] xmllite: built-in ISO 8859 encodings and the encoding named for an input (3679)

xmllite: built-in ISO 8859 encodings and the encoding named for an input

The reader and writer know ISO-8859-1 to ISO-8859-9 besides US-ASCII, UTF-16
and UTF-8, the encodings Microsoft documents as built in. An encoding named
with CreateXmlReaderInputWithEncodingName (or by code page) is now used for
the input unless a byte order mark says otherwise; it used to be ignored.
---
diff --git a/dlls/xmllite/reader.c b/dlls/xmllite/reader.c
index ad462e2..ce5e1f7 100644
--- a/dlls/xmllite/reader.c
+++ b/dlls/xmllite/reader.c
@@ -144,6 +144,20 @@ struct xml_encoding_data
 
 static const struct xml_encoding_data xml_encoding_map[] =
 {
+    /* the ISO 8859 encodings that the Microsoft documentation lists as built in */
+    { L"ISO-8859-1", XmlEncoding_ISO8859_1, 28591 },
+    { L"ISO-8859-2", XmlEncoding_ISO8859_2, 28592 },
+    { L"ISO-8859-3", XmlEncoding_ISO8859_3, 28593 },
+    { L"ISO-8859-4", XmlEncoding_ISO8859_4, 28594 },
+    { L"ISO-8859-5", XmlEncoding_ISO8859_5, 28595 },
+    { L"ISO-8859-6", XmlEncoding_ISO8859_6, 28596 },
+#ifdef XML_MUT_CP
+    { L"ISO-8859-7", XmlEncoding_ISO8859_7, 28591 },
+#else
+    { L"ISO-8859-7", XmlEncoding_ISO8859_7, 28597 },
+#endif
+    { L"ISO-8859-8", XmlEncoding_ISO8859_8, 28598 },
+    { L"ISO-8859-9", XmlEncoding_ISO8859_9, 28599 },
     { L"US-ASCII", XmlEncoding_USASCII, 20127 },
     { L"UTF-16",   XmlEncoding_UTF16,   1200 },
     { L"UTF-8",    XmlEncoding_UTF8,    CP_UTF8 },
@@ -901,6 +915,33 @@ static HRESULT readerinput_detectencoding(xmlreaderinput *readerinput, xml_encod
     }
 
     ptrW = (WCHAR *)buffer->data;
+
+    /* an encoding named when the input was created is used unless a BOM says otherwise */
+#ifdef XML_MUT_HINT
+    if (0)
+#else
+    if (readerinput->encoding != XmlEncoding_Unknown)
+#endif
+    {
+#ifdef XML_MUT_BOM
+        if (0)
+#else
+        if (!memcmp(buffer->data, utf8bom, sizeof(utf8bom)))
+#endif
+        {
+            buffer->cur += sizeof(utf8bom);
+            *enc = XmlEncoding_UTF8;
+        }
+        else if (!memcmp(buffer->data, utf16lebom, sizeof(utf16lebom)))
+        {
+            buffer->cur += sizeof(utf16lebom);
+            *enc = XmlEncoding_UTF16;
+        }
+        else
+            *enc = readerinput->encoding;
+        return S_OK;
+    }
+
     /* try start symbols if we have enough data to do that, input buffer should contain
        first chunk already */
     if (readerinput_is_utf8(readerinput))
diff --git a/dlls/xmllite/xmllite_private.h b/dlls/xmllite/xmllite_private.h
index fc3e6d2..223bdce 100644
--- a/dlls/xmllite/xmllite_private.h
+++ b/dlls/xmllite/xmllite_private.h
@@ -47,6 +47,15 @@ static inline void m_free(IMalloc *imalloc, void *mem)
 
 typedef enum
 {
+    XmlEncoding_ISO8859_1,
+    XmlEncoding_ISO8859_2,
+    XmlEncoding_ISO8859_3,
+    XmlEncoding_ISO8859_4,
+    XmlEncoding_ISO8859_5,
+    XmlEncoding_ISO8859_6,
+    XmlEncoding_ISO8859_7,
+    XmlEncoding_ISO8859_8,
+    XmlEncoding_ISO8859_9,
     XmlEncoding_USASCII,
     XmlEncoding_UTF16,
     XmlEncoding_UTF8,
