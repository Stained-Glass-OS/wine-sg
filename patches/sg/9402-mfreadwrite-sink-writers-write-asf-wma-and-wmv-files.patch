From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfreadwrite: Sink writers write .asf, .wma and .wmv files (9402)

MFCreateSinkWriterFromURL knew .mp4/.mp3/.wav/.avi only; .asf, .wma and .wmv (and
MF_TRANSCODE_CONTAINERTYPE ASF) now get mf.dll's ASF file sink on a read-write byte stream.
---
--- a/dlls/mfreadwrite/writer.c
+++ b/dlls/mfreadwrite/writer.c
@@ -22,6 +22,7 @@
 #include "mfapi.h"
 #include "mfidl.h"
 #include "mfreadwrite.h"
+#include "wmcontainer.h"
 #include "pathcch.h"
 #include "wine/mfinternal.h"
 #include "mf_private.h"
@@ -1557,6 +1558,9 @@
         { L".mp3", &MFTranscodeContainerType_MP3 },
         { L".wav", &MFTranscodeContainerType_WAVE },
         { L".avi", &MFTranscodeContainerType_AVI },
+        { L".asf", &MFTranscodeContainerType_ASF },
+        { L".wma", &MFTranscodeContainerType_ASF },
+        { L".wmv", &MFTranscodeContainerType_ASF },
     };
     static const struct
     {
@@ -1605,6 +1609,18 @@
         if (FAILED(IMFAttributes_GetGUID(attributes, &MF_TRANSCODE_CONTAINERTYPE, &container))) return E_INVALIDARG;
     }
 
+    /* Stained Glass OS (wine-sg 9405): ASF files are written by mf.dll's ASF file sink, which has no
+     * class factory of its own */
+#ifndef SG_MUTANT_WRITER_NO_ASF
+    if (IsEqualGUID(&container, &MFTranscodeContainerType_ASF))
+#else
+    if (0)
+#endif
+    {
+        *clsid = GUID_NULL;
+        return S_FALSE;
+    }
+
     for (i = 0; i < ARRAY_SIZE(class_map); ++i)
     {
         if (IsEqualGUID(&container, class_map[i].container))
@@ -1621,10 +1637,11 @@
 HRESULT create_sink_writer_from_url(const WCHAR *url, IMFByteStream *bytestream, IMFAttributes *attributes,
         REFIID riid, void **out)
 {
-    IMFSinkClassFactory *factory;
+    IMFSinkClassFactory *factory = NULL;
     IMFMediaSink *sink;
     CLSID clsid;
     HRESULT hr;
+    BOOL asf;
 
     *out = NULL;
 
@@ -1632,8 +1649,9 @@
         return E_INVALIDARG;
 
     if (FAILED(hr = sink_writer_get_sink_factory_class(url, attributes, &clsid))) return hr;
+    asf = hr == S_FALSE;
 
-    if (FAILED(hr = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IMFSinkClassFactory, (void **)&factory)))
+    if (!asf && FAILED(hr = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IMFSinkClassFactory, (void **)&factory)))
     {
         WARN("Failed to create a sink factory, hr %#lx.\n", hr);
         return hr;
@@ -1641,15 +1659,22 @@
 
     if (bytestream)
         IMFByteStream_AddRef(bytestream);
-    else if (FAILED(hr = MFCreateFile(MF_ACCESSMODE_WRITE, MF_OPENMODE_DELETE_IF_EXIST, 0, url, &bytestream)))
+    else if (FAILED(hr = MFCreateFile(asf ? MF_ACCESSMODE_READWRITE : MF_ACCESSMODE_WRITE,
+            MF_OPENMODE_DELETE_IF_EXIST, 0, url, &bytestream)))
     {
         WARN("Failed to create output file stream, hr %#lx.\n", hr);
-        IMFSinkClassFactory_Release(factory);
+        if (factory)
+            IMFSinkClassFactory_Release(factory);
         return hr;
     }
 
-    hr = IMFSinkClassFactory_CreateMediaSink(factory, bytestream, NULL, NULL, &sink);
-    IMFSinkClassFactory_Release(factory);
+    if (asf)
+        hr = MFCreateASFMediaSink(bytestream, &sink);
+    else
+    {
+        hr = IMFSinkClassFactory_CreateMediaSink(factory, bytestream, NULL, NULL, &sink);
+        IMFSinkClassFactory_Release(factory);
+    }
     IMFByteStream_Release(bytestream);
     if (FAILED(hr))
     {
