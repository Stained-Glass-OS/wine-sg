From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msado15, msdasql: commands with parameters (6034)

Command.Execute refused a command with parameters
(adErrFeatureNotAvailable), and MSDASQL's ICommand::Execute ignored
the DBPARAMS it was given: no parameterized query of an ADO program
(VB6, Access front ends, ASP pages) ran over ODBC.

msado15: Execute creates the provider's command, sets its parameter
information (type, size, direction) and binds each parameter as a
VARIANT through a parameter accessor -- the Parameters collection's, or
the values given to Execute -- runs it, and puts output and return
values back into the parameters; a stored procedure is sent as an ODBC
call with a marker per parameter; Options left out (-1) is no options.
msdasql: commands have IAccessor; Execute binds each parameter of the
accessor with SQLBindParameter (a VARIANT as its declared type),
writes output values back, and gives a rowset for any statement that
has a result set, not only one beginning with "select".
---
diff --git a/dlls/msado15/command.c b/dlls/msado15/command.c
index 16b224e..d5d4255 100644
--- a/dlls/msado15/command.c
+++ b/dlls/msado15/command.c
@@ -807,6 +807,301 @@ static HRESULT WINAPI command_put_Prepared( _Command *iface, VARIANT_BOOL prepar
     return S_OK;
 }
 
+/* ---- Stained Glass OS: executing a command with parameters ------------------------------------- */
+
+/* The provider's type of an ADO parameter type: the same numbers but for the variable-length ones. */
+static DBTYPE param_dbtype( DataTypeEnum type )
+{
+    switch (type)
+    {
+    case adVarChar: case adLongVarChar: case adChar: return DBTYPE_STR;
+    case adVarWChar: case adLongVarWChar: case adWChar: case adBSTR: return DBTYPE_WSTR;
+    case adVarBinary: case adLongVarBinary: case adBinary: return DBTYPE_BYTES;
+    case adVarNumeric: return DBTYPE_NUMERIC;
+    case adDBTimeStamp: return DBTYPE_DBTIMESTAMP;
+    default: return (DBTYPE)type;
+    }
+}
+
+static const WCHAR *dbtype_name( DBTYPE type )
+{
+    switch (type)
+    {
+    case DBTYPE_I1: return L"DBTYPE_I1";
+    case DBTYPE_UI1: return L"DBTYPE_UI1";
+    case DBTYPE_I2: return L"DBTYPE_I2";
+    case DBTYPE_UI2: return L"DBTYPE_UI2";
+    case DBTYPE_I4: return L"DBTYPE_I4";
+    case DBTYPE_UI4: return L"DBTYPE_UI4";
+    case DBTYPE_I8: return L"DBTYPE_I8";
+    case DBTYPE_UI8: return L"DBTYPE_UI8";
+    case DBTYPE_R4: return L"DBTYPE_R4";
+    case DBTYPE_R8: return L"DBTYPE_R8";
+    case DBTYPE_BOOL: return L"DBTYPE_BOOL";
+    case DBTYPE_CY: return L"DBTYPE_CY";
+    case DBTYPE_NUMERIC: return L"DBTYPE_NUMERIC";
+    case DBTYPE_DECIMAL: return L"DBTYPE_DECIMAL";
+    case DBTYPE_DATE: return L"DBTYPE_DATE";
+    case DBTYPE_DBDATE: return L"DBTYPE_DBDATE";
+    case DBTYPE_DBTIME: return L"DBTYPE_DBTIME";
+    case DBTYPE_DBTIMESTAMP: return L"DBTYPE_DBTIMESTAMP";
+    case DBTYPE_GUID: return L"DBTYPE_GUID";
+    case DBTYPE_STR: return L"DBTYPE_VARCHAR";
+    case DBTYPE_WSTR: return L"DBTYPE_WVARCHAR";
+    case DBTYPE_BYTES: return L"DBTYPE_VARBINARY";
+    }
+    return NULL;
+}
+
+struct exec_param
+{
+    _Parameter *param;
+    ParameterDirectionEnum direction;
+    DataTypeEnum type;
+    ADO_LONGPTR size;
+    BYTE precision, scale;
+    BSTR name;
+};
+
+/* The text sent for the command type: a stored procedure is an ODBC call with a marker per parameter
+ * (and one for its return value), as ADO sends it. */
+static BSTR command_text_for( struct command *command, LONG type, const struct exec_param *params, ULONG count )
+{
+    WCHAR *text;
+    ULONG i, first = 0;
+    size_t len;
+
+    if (type != adCmdStoredProc) return SysAllocString( command->text );
+    len = wcslen( command->text ) + 16 + 3 * count;
+    if (!(text = malloc( len * sizeof(WCHAR) ))) return NULL;
+    if (count && params[0].direction == adParamReturnValue)
+    {
+        wcscpy( text, L"{ ? = call " );
+        first = 1;
+    }
+    else wcscpy( text, L"{ call " );
+    wcscat( text, command->text );
+    if (count > first)
+    {
+        wcscat( text, L"(" );
+        for (i = first; i < count; i++) wcscat( text, i > first ? L", ?" : L"?" );
+        wcscat( text, L")" );
+    }
+    wcscat( text, L" }" );
+    {
+        BSTR ret = SysAllocString( text );
+        free( text );
+        return ret;
+    }
+}
+
+static HRESULT execute_with_parameters( struct command *command, VARIANT *affected, VARIANT *values, LONG options,
+                                        _Recordset **recordset )
+{
+    ADOConnectionConstruction15 *construct = NULL;
+    IDispatch *conn_disp = NULL;
+    IUnknown *session = NULL, *rowset = NULL;
+    IDBCreateCommand *create = NULL;
+    ICommandText *text = NULL;
+    ICommandWithParameters *with_params = NULL;
+    IAccessor *accessor = NULL;
+    HACCESSOR haccessor = 0;
+    struct exec_param *params = NULL;
+    DBPARAMBINDINFO *info = NULL;
+    DB_UPARAMS *ordinals = NULL;
+    DBBINDING *bindings = NULL;
+    BYTE *data = NULL;
+    struct param_item *item;
+    DBPARAMS dbparams;
+    DBROWCOUNT rows = -1;
+    ULONG count = 0, i;
+    LONG type = options & 0xff;
+    SAFEARRAY *array = NULL;
+    LONG lower = 0, upper = -1;
+    BSTR sent = NULL;
+    HRESULT hr;
+
+    if (!type || type == adCmdUnknown || type == 0xff) type = command->type == adCmdUnknown ? adCmdText : command->type;
+    if (values && V_VT(values) != VT_ERROR && V_VT(values) != VT_EMPTY)
+    {
+        if (!(V_VT(values) & VT_ARRAY)) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+        array = (V_VT(values) & VT_BYREF) ? *V_ARRAYREF(values) : V_ARRAY(values);
+        SafeArrayGetLBound( array, 1, &lower );
+        SafeArrayGetUBound( array, 1, &upper );
+    }
+
+    /* the parameters: the collection's, or one input per value given */
+    count = list_count( &command->parameters );
+    if (!count && array) count = upper - lower + 1;
+    if (count && !(params = calloc( count, sizeof(*params) ))) return E_OUTOFMEMORY;
+    i = 0;
+    LIST_FOR_EACH_ENTRY( item, &command->parameters, struct param_item, entry )
+    {
+        struct exec_param *p = &params[i++];
+        if (FAILED(hr = IDispatch_QueryInterface( item->param, &IID__Parameter, (void **)&p->param ))) goto done;
+        _Parameter_get_Direction( p->param, &p->direction );
+        _Parameter_get_Type( p->param, &p->type );
+        _Parameter_get_Size( p->param, &p->size );
+        _Parameter_get_Precision( p->param, &p->precision );
+        _Parameter_get_NumericScale( p->param, &p->scale );
+        _Parameter_get_Name( p->param, &p->name );
+        if (p->direction == adParamUnknown) p->direction = adParamInput;
+    }
+    for (; i < count; i++)
+    {
+        params[i].direction = adParamInput;
+        params[i].type = adVariant;
+    }
+
+    if (FAILED(hr = _Connection_QueryInterface( command->connection, &IID_IDispatch, (void **)&conn_disp ))) goto done;
+    if (FAILED(hr = IDispatch_QueryInterface( conn_disp, &IID_ADOConnectionConstruction15, (void **)&construct ))) goto done;
+    if (FAILED(hr = ADOConnectionConstruction15_get_Session( construct, &session ))) goto done;
+    if (!session) { hr = MAKE_ADO_HRESULT( adErrObjectClosed ); goto done; }
+    if (FAILED(IUnknown_QueryInterface( session, &IID_IDBCreateCommand, (void **)&create )))
+    {
+        hr = MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+        goto done;
+    }
+    if (FAILED(hr = IDBCreateCommand_CreateCommand( create, NULL, &IID_ICommandText, (IUnknown **)&text ))) goto done;
+    if (!(sent = command_text_for( command, type, params, count ))) { hr = E_OUTOFMEMORY; goto done; }
+    TRACE( "%s with %lu parameters\n", debugstr_w( sent ), count );
+    if (FAILED(hr = ICommandText_SetCommandText( text, &DBGUID_DEFAULT, sent ))) goto done;
+
+    if (count)
+    {
+        DBLENGTH offset = 0;
+
+        if (!(info = calloc( count, sizeof(*info) )) || !(ordinals = calloc( count, sizeof(*ordinals) )) ||
+            !(bindings = calloc( count, sizeof(*bindings) )))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        for (i = 0; i < count; i++)
+        {
+            const struct exec_param *p = &params[i];
+            DBTYPE dbtype = param_dbtype( p->type );
+
+            ordinals[i] = i + 1;
+            info[i].pwszDataSourceType = p->type == adVariant ? NULL : (WCHAR *)dbtype_name( dbtype );
+            info[i].pwszName = p->name;
+            info[i].ulParamSize = p->size;
+            info[i].dwFlags = (p->direction & adParamInput ? DBPARAMFLAGS_ISINPUT : 0) |
+                              (p->direction & (adParamOutput | adParamReturnValue) ? DBPARAMFLAGS_ISOUTPUT : 0) |
+                              DBPARAMFLAGS_ISNULLABLE;
+            info[i].bPrecision = p->precision;
+            info[i].bScale = p->scale;
+
+            /* every parameter is given to the provider as a variant, as ADO does */
+            bindings[i].iOrdinal = i + 1;
+            bindings[i].obValue = offset;
+            bindings[i].obStatus = offset + sizeof(VARIANT);
+            bindings[i].obLength = offset + sizeof(VARIANT) + sizeof(DBSTATUS) + 4;
+            bindings[i].dwPart = DBPART_VALUE | DBPART_STATUS | DBPART_LENGTH;
+            bindings[i].dwMemOwner = DBMEMOWNER_CLIENTOWNED;
+            bindings[i].eParamIO = (p->direction & adParamInput ? DBPARAMIO_INPUT : 0) |
+                                   (p->direction & (adParamOutput | adParamReturnValue) ? DBPARAMIO_OUTPUT : 0);
+            bindings[i].cbMaxLen = sizeof(VARIANT);
+            bindings[i].wType = DBTYPE_VARIANT;
+            offset += sizeof(VARIANT) + sizeof(DBSTATUS) + 4 + sizeof(DBLENGTH);
+            offset = (offset + 15) & ~15;
+        }
+        if (SUCCEEDED(ICommandText_QueryInterface( text, &IID_ICommandWithParameters, (void **)&with_params )))
+            ICommandWithParameters_SetParameterInfo( with_params, count, ordinals, info );
+        if (FAILED(ICommandText_QueryInterface( text, &IID_IAccessor, (void **)&accessor )))
+        {
+            hr = MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+            goto done;
+        }
+        if (FAILED(hr = IAccessor_CreateAccessor( accessor, DBACCESSOR_PARAMETERDATA, count, bindings, offset,
+                                                  &haccessor, NULL ))) goto done;
+        if (!(data = calloc( 1, offset ))) { hr = E_OUTOFMEMORY; goto done; }
+        for (i = 0; i < count; i++)
+        {
+            VARIANT *v = (VARIANT *)(data + bindings[i].obValue);
+            DBSTATUS *status = (DBSTATUS *)(data + bindings[i].obStatus);
+            VARIANT given;
+
+            VariantInit( v );
+            VariantInit( &given );
+            /* a value given to Execute replaces the parameter's (inputs only, in order) */
+            if (array && lower + (LONG)i <= upper && params[i].direction != adParamReturnValue)
+            {
+                LONG index = lower + i;
+                SafeArrayGetElement( array, &index, &given );
+                while (V_VT(&given) == (VT_BYREF | VT_VARIANT)) VariantCopy( &given, V_VARIANTREF(&given) );
+                if (params[i].param) _Parameter_put_Value( params[i].param, given );
+                VariantCopy( v, &given );
+            }
+            else if (params[i].param && (params[i].direction & adParamInput)) _Parameter_get_Value( params[i].param, v );
+            VariantClear( &given );
+            *status = (V_VT(v) == VT_NULL || V_VT(v) == VT_EMPTY) && (params[i].direction & adParamInput) ?
+                      DBSTATUS_S_ISNULL : DBSTATUS_S_OK;
+        }
+    }
+
+    dbparams.pData = data;
+    dbparams.cParamSets = 1;
+    dbparams.hAccessor = haccessor;
+    hr = ICommandText_Execute( text, NULL, &IID_IUnknown, count ? &dbparams : NULL, &rows,
+                               recordset ? &rowset : NULL );
+    if (FAILED(hr)) goto done;
+
+    /* the output parameters' values, after the statement */
+    for (i = 0; i < count; i++)
+    {
+        VARIANT *v = (VARIANT *)(data + bindings[i].obValue);
+        if (params[i].param && (params[i].direction & (adParamOutput | adParamReturnValue)))
+            _Parameter_put_Value( params[i].param, *v );
+    }
+
+    if (affected)
+    {
+        V_VT(affected) = VT_I4;
+        V_I4(affected) = rows;
+    }
+    if (recordset)
+    {
+        *recordset = NULL;
+        if (rowset && !(options & adExecuteNoRecords))
+        {
+            if (SUCCEEDED(hr = Recordset_create( (void **)recordset )) &&
+                FAILED(hr = Recordset_open_rowset( *recordset, rowset, conn_disp )))
+            {
+                _Recordset_Release( *recordset );
+                *recordset = NULL;
+            }
+        }
+    }
+
+done:
+    if (data)
+    {
+        for (i = 0; i < count; i++) VariantClear( (VARIANT *)(data + bindings[i].obValue) );
+        free( data );
+    }
+    if (haccessor) IAccessor_ReleaseAccessor( accessor, haccessor, NULL );
+    if (accessor) IAccessor_Release( accessor );
+    if (with_params) ICommandWithParameters_Release( with_params );
+    if (rowset) IUnknown_Release( rowset );
+    if (text) ICommandText_Release( text );
+    if (create) IDBCreateCommand_Release( create );
+    if (session) IUnknown_Release( session );
+    if (construct) ADOConnectionConstruction15_Release( construct );
+    if (conn_disp) IDispatch_Release( conn_disp );
+    for (i = 0; i < count; i++)
+    {
+        if (params[i].param) _Parameter_Release( params[i].param );
+        SysFreeString( params[i].name );
+    }
+    free( params );
+    free( info );
+    free( ordinals );
+    free( bindings );
+    SysFreeString( sent );
+    return hr;
+}
+
 static HRESULT WINAPI command_Execute( _Command *iface, VARIANT *affected, VARIANT *parameters,
                                        LONG options, _Recordset **recordset )
 {
@@ -817,10 +1112,19 @@ static HRESULT WINAPI command_Execute( _Command *iface, VARIANT *affected, VARIA
 
     if (!command->connection) return MAKE_ADO_HRESULT( adErrInvalidConnection );
     if (!command->text) return MAKE_ADO_HRESULT( adErrInvalidArgument );
-
-    /* parameters are bound through the provider's command object, which is not created here */
+    /* Stained Glass OS: Options left out is adOptionUnspecified (-1): no options */
+    if (options == adOptionUnspecified) options = 0;
+    type = options & 0xff;
+
+    /* Stained Glass OS: parameters are bound through the provider's command */
+    while (parameters && V_VT(parameters) == (VT_BYREF | VT_VARIANT) && V_VARIANTREF(parameters))
+        parameters = V_VARIANTREF(parameters);
+#ifndef SG_MUTANT_ADO_NO_PARAMS
     if (list_count( &command->parameters ) || (parameters && V_VT(parameters) != VT_ERROR && V_VT(parameters) != VT_EMPTY))
-        return MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+        return execute_with_parameters( command, affected, parameters, options, recordset );
+#else
+    if (list_count( &command->parameters )) return MAKE_ADO_HRESULT( adErrFeatureNotAvailable );
+#endif
 
     /* the command type of the call overrides the CommandType property */
     if (!type || type == adCmdUnknown) type = command->type == adCmdUnknown ? 0 : command->type;
diff --git a/dlls/msdasql/Makefile.in b/dlls/msdasql/Makefile.in
index 3281c4e..5510e18 100644
--- a/dlls/msdasql/Makefile.in
+++ b/dlls/msdasql/Makefile.in
@@ -7,5 +7,6 @@ SOURCES = \
 	msdasql.rc \
 	msdasql_classes.idl \
 	msdasql_main.c \
+	params.c \
 	rowset.c \
 	session.c
diff --git a/dlls/msdasql/msdasql_private.h b/dlls/msdasql/msdasql_private.h
index 1715e5c..6dd2e8e 100644
--- a/dlls/msdasql/msdasql_private.h
+++ b/dlls/msdasql/msdasql_private.h
@@ -62,6 +62,23 @@ void rt_free(struct rowtable *rt);
 HRESULT rt_create_accessor(struct rowtable *rt, DBACCESSORFLAGS flags, DBCOUNTITEM count,
         const DBBINDING bindings[], DBLENGTH row_size, HACCESSOR *accessor, DBBINDSTATUS status[]);
 HRESULT rt_addref_accessor(struct rowtable *rt, HACCESSOR h, DBREFCOUNT *count);
+struct rt_accessor *rt_find_accessor(struct rowtable *rt, HACCESSOR h);
+
+/* Stained Glass OS: a command's parameters (session.c's SetParameterInfo, params.c) */
+struct param_info
+{
+    DB_UPARAMS ordinal;
+    DBPARAMFLAGS flags;
+    DBLENGTH size;
+    BYTE precision, scale;
+    WCHAR *name;
+    WCHAR *type_name;
+};
+struct param_set;
+HRESULT param_set_bind(SQLHSTMT hstmt, const struct rt_accessor *acc, DBPARAMS *params,
+        const struct param_info *infos, DB_UPARAMS ninfo, struct param_set **out);
+void param_set_finish(struct param_set *set, DBPARAMS *params);
+void param_set_free(struct param_set *set);
 HRESULT rt_release_accessor(struct rowtable *rt, HACCESSOR h, DBREFCOUNT *count);
 HRESULT rt_get_bindings(struct rowtable *rt, HACCESSOR h, DBACCESSORFLAGS *flags, DBCOUNTITEM *count,
         DBBINDING **bindings);
diff --git a/dlls/msdasql/params.c b/dlls/msdasql/params.c
new file mode 100644
index 0000000..b382ab2
--- /dev/null
+++ b/dlls/msdasql/params.c
@@ -0,0 +1,522 @@
+/*
+ * MSDASQL: a command's parameters, bound to the ODBC statement
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * ICommand::Execute's DBPARAMS: the parameter accessor's bindings, each
+ * the value of a parameter (its ordinal) in the consumer's buffer, given to
+ * the driver with SQLBindParameter as the matching C type; output parameters
+ * are written back into the buffer after the statement ran. A DBTYPE_VARIANT
+ * binding (ADO binds all its parameters so) is given as the type the
+ * parameter was declared with (ICommandWithParameters::SetParameterInfo),
+ * else as the variant's own type, and an output VARIANT gets that type back.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "oleauto.h"
+#include "oledb.h"
+#include "oledberr.h"
+#include "sql.h"
+#include "sqlext.h"
+#include "wine/debug.h"
+
+#include "msdasql_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msdasql);
+
+struct bound_param
+{
+    const DBBINDING *binding;
+    DBTYPE type;              /* the type given to the driver */
+    SQLSMALLINT ctype, sqltype, io;
+    SQLULEN size;
+    SQLSMALLINT digits;
+    SQLLEN ind;
+    void *buffer;             /* the driver's buffer: the consumer's, or one of ours */
+    SQLLEN buflen;
+    BOOL ours;                /* buffer was allocated here */
+};
+
+struct param_set
+{
+    DBCOUNTITEM count;
+    struct bound_param params[1];
+};
+
+static const struct { const WCHAR *name; DBTYPE type; } type_names[] =
+{
+    { L"DBTYPE_I1", DBTYPE_I1 }, { L"DBTYPE_UI1", DBTYPE_UI1 }, { L"DBTYPE_I2", DBTYPE_I2 },
+    { L"DBTYPE_UI2", DBTYPE_UI2 }, { L"DBTYPE_I4", DBTYPE_I4 }, { L"DBTYPE_UI4", DBTYPE_UI4 },
+    { L"DBTYPE_I8", DBTYPE_I8 }, { L"DBTYPE_UI8", DBTYPE_UI8 }, { L"DBTYPE_R4", DBTYPE_R4 },
+    { L"DBTYPE_R8", DBTYPE_R8 }, { L"DBTYPE_BOOL", DBTYPE_BOOL }, { L"DBTYPE_CY", DBTYPE_CY },
+    { L"DBTYPE_NUMERIC", DBTYPE_NUMERIC }, { L"DBTYPE_DECIMAL", DBTYPE_DECIMAL },
+    { L"DBTYPE_DATE", DBTYPE_DATE }, { L"DBTYPE_DBDATE", DBTYPE_DBDATE }, { L"DBTYPE_DBTIME", DBTYPE_DBTIME },
+    { L"DBTYPE_DBTIMESTAMP", DBTYPE_DBTIMESTAMP }, { L"DBTYPE_GUID", DBTYPE_GUID },
+    { L"DBTYPE_CHAR", DBTYPE_STR }, { L"DBTYPE_VARCHAR", DBTYPE_STR }, { L"DBTYPE_LONGVARCHAR", DBTYPE_STR },
+    { L"DBTYPE_WCHAR", DBTYPE_WSTR }, { L"DBTYPE_WVARCHAR", DBTYPE_WSTR }, { L"DBTYPE_WLONGVARCHAR", DBTYPE_WSTR },
+    { L"DBTYPE_BINARY", DBTYPE_BYTES }, { L"DBTYPE_VARBINARY", DBTYPE_BYTES }, { L"DBTYPE_LONGVARBINARY", DBTYPE_BYTES },
+    { L"DBTYPE_STR", DBTYPE_STR }, { L"DBTYPE_WSTR", DBTYPE_WSTR }, { L"DBTYPE_BYTES", DBTYPE_BYTES },
+};
+
+static DBTYPE declared_type( const struct param_info *infos, DB_UPARAMS count, DBORDINAL ordinal, SQLULEN *size )
+{
+    DB_UPARAMS i;
+    unsigned int t;
+
+    for (i = 0; i < count; i++)
+    {
+        if (infos[i].ordinal != ordinal || !infos[i].type_name) continue;
+        if (size && infos[i].size) *size = infos[i].size;
+        for (t = 0; t < ARRAY_SIZE(type_names); t++)
+            if (!wcsicmp( infos[i].type_name, type_names[t].name )) return type_names[t].type;
+    }
+    return DBTYPE_EMPTY;
+}
+
+/* The C and SQL types of an OLE DB type, and the size of its C value. */
+static BOOL odbc_types( DBTYPE type, SQLSMALLINT *ctype, SQLSMALLINT *sqltype, SQLLEN *csize )
+{
+    switch (type)
+    {
+    case DBTYPE_I1:   *ctype = SQL_C_STINYINT; *sqltype = SQL_TINYINT; *csize = 1; return TRUE;
+    case DBTYPE_UI1:  *ctype = SQL_C_UTINYINT; *sqltype = SQL_TINYINT; *csize = 1; return TRUE;
+    case DBTYPE_I2:   *ctype = SQL_C_SSHORT; *sqltype = SQL_SMALLINT; *csize = 2; return TRUE;
+    case DBTYPE_UI2:  *ctype = SQL_C_USHORT; *sqltype = SQL_SMALLINT; *csize = 2; return TRUE;
+    case DBTYPE_I4:   *ctype = SQL_C_SLONG; *sqltype = SQL_INTEGER; *csize = 4; return TRUE;
+    case DBTYPE_UI4:  *ctype = SQL_C_ULONG; *sqltype = SQL_INTEGER; *csize = 4; return TRUE;
+    case DBTYPE_I8:   *ctype = SQL_C_SBIGINT; *sqltype = SQL_BIGINT; *csize = 8; return TRUE;
+    case DBTYPE_UI8:  *ctype = SQL_C_UBIGINT; *sqltype = SQL_BIGINT; *csize = 8; return TRUE;
+    case DBTYPE_R4:   *ctype = SQL_C_FLOAT; *sqltype = SQL_REAL; *csize = 4; return TRUE;
+    case DBTYPE_R8:   *ctype = SQL_C_DOUBLE; *sqltype = SQL_DOUBLE; *csize = 8; return TRUE;
+    case DBTYPE_BOOL: *ctype = SQL_C_BIT; *sqltype = SQL_BIT; *csize = 1; return TRUE;
+    case DBTYPE_GUID: *ctype = SQL_C_GUID; *sqltype = SQL_GUID; *csize = sizeof(GUID); return TRUE;
+    case DBTYPE_DBDATE: *ctype = SQL_C_TYPE_DATE; *sqltype = SQL_TYPE_DATE; *csize = sizeof(SQL_DATE_STRUCT); return TRUE;
+    case DBTYPE_DBTIME: *ctype = SQL_C_TYPE_TIME; *sqltype = SQL_TYPE_TIME; *csize = sizeof(SQL_TIME_STRUCT); return TRUE;
+    case DBTYPE_DATE:
+    case DBTYPE_DBTIMESTAMP:
+        *ctype = SQL_C_TYPE_TIMESTAMP; *sqltype = SQL_TYPE_TIMESTAMP; *csize = sizeof(SQL_TIMESTAMP_STRUCT); return TRUE;
+    case DBTYPE_CY:
+    case DBTYPE_NUMERIC:
+    case DBTYPE_DECIMAL:
+        /* as text, which every driver converts exactly */
+        *ctype = SQL_C_WCHAR; *sqltype = SQL_DECIMAL; *csize = 0; return TRUE;
+    case DBTYPE_WSTR: *ctype = SQL_C_WCHAR; *sqltype = SQL_WVARCHAR; *csize = 0; return TRUE;
+    case DBTYPE_STR:  *ctype = SQL_C_CHAR; *sqltype = SQL_VARCHAR; *csize = 0; return TRUE;
+    case DBTYPE_BYTES: *ctype = SQL_C_BINARY; *sqltype = SQL_VARBINARY; *csize = 0; return TRUE;
+    }
+    return FALSE;
+}
+
+/* The type a variant's value is given as, when nothing was declared. */
+static DBTYPE variant_type( const VARIANT *v )
+{
+    switch (V_VT(v))
+    {
+    case VT_I1: return DBTYPE_I1;
+    case VT_UI1: return DBTYPE_UI1;
+    case VT_I2: return DBTYPE_I2;
+    case VT_UI2: return DBTYPE_UI2;
+    case VT_I4: case VT_INT: return DBTYPE_I4;
+    case VT_UI4: case VT_UINT: return DBTYPE_UI4;
+    case VT_I8: return DBTYPE_I8;
+    case VT_UI8: return DBTYPE_UI8;
+    case VT_R4: return DBTYPE_R4;
+    case VT_R8: return DBTYPE_R8;
+    case VT_BOOL: return DBTYPE_BOOL;
+    case VT_CY: return DBTYPE_CY;
+    case VT_DECIMAL: return DBTYPE_DECIMAL;
+    case VT_DATE: return DBTYPE_DATE;
+    case VT_ARRAY | VT_UI1: return DBTYPE_BYTES;
+    default: return DBTYPE_WSTR;
+    }
+}
+
+static void date_to_timestamp( double date, SQL_TIMESTAMP_STRUCT *ts )
+{
+    SYSTEMTIME st;
+
+    memset( ts, 0, sizeof(*ts) );
+    if (!VariantTimeToSystemTime( date, &st )) return;
+    ts->year = st.wYear;
+    ts->month = st.wMonth;
+    ts->day = st.wDay;
+    ts->hour = st.wHour;
+    ts->minute = st.wMinute;
+    ts->second = st.wSecond;
+    ts->fraction = st.wMilliseconds * 1000000;
+}
+
+static double timestamp_to_date( const SQL_TIMESTAMP_STRUCT *ts )
+{
+    SYSTEMTIME st = { ts->year, ts->month, 0, ts->day, ts->hour, ts->minute, ts->second, ts->fraction / 1000000 };
+    double date = 0;
+
+    SystemTimeToVariantTime( &st, &date );
+    return date;
+}
+
+/* A value of type into the driver's buffer (ours, of size bytes): from a variant, or from typed data. */
+static HRESULT fill_from_variant( struct bound_param *p, const VARIANT *src, SQLULEN size )
+{
+    VARIANT v;
+    HRESULT hr = S_OK;
+    VARTYPE vt;
+
+    if (V_VT(src) == VT_NULL || V_VT(src) == VT_EMPTY)
+    {
+        p->ind = SQL_NULL_DATA;
+        return S_OK;
+    }
+    switch (p->type)
+    {
+    case DBTYPE_I1: vt = VT_I1; break;
+    case DBTYPE_UI1: vt = VT_UI1; break;
+    case DBTYPE_I2: vt = VT_I2; break;
+    case DBTYPE_UI2: vt = VT_UI2; break;
+    case DBTYPE_I4: vt = VT_I4; break;
+    case DBTYPE_UI4: vt = VT_UI4; break;
+    case DBTYPE_I8: vt = VT_I8; break;
+    case DBTYPE_UI8: vt = VT_UI8; break;
+    case DBTYPE_R4: vt = VT_R4; break;
+    case DBTYPE_R8: vt = VT_R8; break;
+    case DBTYPE_BOOL: vt = VT_BOOL; break;
+    case DBTYPE_DATE: case DBTYPE_DBTIMESTAMP: case DBTYPE_DBDATE: case DBTYPE_DBTIME: vt = VT_DATE; break;
+    case DBTYPE_BYTES: vt = VT_ARRAY | VT_UI1; break;
+    default: vt = VT_BSTR; break;
+    }
+    VariantInit( &v );
+    if (vt == (VT_ARRAY | VT_UI1))
+    {
+        if (V_VT(src) != (VT_ARRAY | VT_UI1)) return DB_E_CANTCONVERTVALUE;
+        hr = VariantCopy( &v, src );
+    }
+    else hr = VariantChangeTypeEx( &v, src, MAKELCID( MAKELANGID( LANG_ENGLISH, SUBLANG_ENGLISH_US ), SORT_DEFAULT ),
+                                   0, vt );
+    if (FAILED(hr)) return DB_E_CANTCONVERTVALUE;
+
+    switch (p->type)
+    {
+    case DBTYPE_I1: case DBTYPE_UI1: *(BYTE *)p->buffer = V_UI1(&v); p->ind = 1; break;
+    case DBTYPE_I2: case DBTYPE_UI2: *(SHORT *)p->buffer = V_I2(&v); p->ind = 2; break;
+    case DBTYPE_I4: case DBTYPE_UI4: *(LONG *)p->buffer = V_I4(&v); p->ind = 4; break;
+    case DBTYPE_I8: case DBTYPE_UI8: *(LONGLONG *)p->buffer = V_I8(&v); p->ind = 8; break;
+    case DBTYPE_R4: *(float *)p->buffer = V_R4(&v); p->ind = 4; break;
+    case DBTYPE_R8: *(double *)p->buffer = V_R8(&v); p->ind = 8; break;
+    case DBTYPE_BOOL: *(BYTE *)p->buffer = V_BOOL(&v) != VARIANT_FALSE; p->ind = 1; break;
+    case DBTYPE_DATE: case DBTYPE_DBTIMESTAMP: case DBTYPE_DBDATE: case DBTYPE_DBTIME:
+        date_to_timestamp( V_DATE(&v), p->buffer );
+        p->ind = sizeof(SQL_TIMESTAMP_STRUCT);
+        break;
+    case DBTYPE_BYTES:
+    {
+        SAFEARRAY *sa = V_ARRAY(&v);
+        LONG lo = 0, hi = -1;
+        void *data;
+
+        SafeArrayGetLBound( sa, 1, &lo );
+        SafeArrayGetUBound( sa, 1, &hi );
+        p->ind = hi - lo + 1;
+        if ((SQLULEN)p->ind > size) { hr = DB_E_DATAOVERFLOW; break; }
+        if (SUCCEEDED(SafeArrayAccessData( sa, &data )))
+        {
+            memcpy( p->buffer, data, p->ind );
+            SafeArrayUnaccessData( sa );
+        }
+        break;
+    }
+    case DBTYPE_STR:
+        p->ind = WideCharToMultiByte( CP_ACP, 0, V_BSTR(&v), SysStringLen( V_BSTR(&v) ), p->buffer, size, NULL, NULL );
+        break;
+    default: /* WSTR, and CY/NUMERIC/DECIMAL as text */
+    {
+        size_t chars = SysStringLen( V_BSTR(&v) );
+        if (chars * sizeof(WCHAR) > size) { hr = DB_E_DATAOVERFLOW; break; }
+        memcpy( p->buffer, V_BSTR(&v), chars * sizeof(WCHAR) );
+        p->ind = chars * sizeof(WCHAR);
+        break;
+    }
+    }
+    VariantClear( &v );
+    return hr;
+}
+
+/* An output parameter's value back into a variant of the type it was given as. */
+static void output_to_variant( const struct bound_param *p, VARIANT *dst )
+{
+    VariantClear( dst );
+    if (p->ind == SQL_NULL_DATA)
+    {
+        V_VT(dst) = VT_NULL;
+        return;
+    }
+    switch (p->type)
+    {
+    case DBTYPE_I1: V_VT(dst) = VT_I1; V_I1(dst) = *(CHAR *)p->buffer; break;
+    case DBTYPE_UI1: V_VT(dst) = VT_UI1; V_UI1(dst) = *(BYTE *)p->buffer; break;
+    case DBTYPE_I2: V_VT(dst) = VT_I2; V_I2(dst) = *(SHORT *)p->buffer; break;
+    case DBTYPE_UI2: V_VT(dst) = VT_UI2; V_UI2(dst) = *(USHORT *)p->buffer; break;
+    case DBTYPE_I4: V_VT(dst) = VT_I4; V_I4(dst) = *(LONG *)p->buffer; break;
+    case DBTYPE_UI4: V_VT(dst) = VT_UI4; V_UI4(dst) = *(ULONG *)p->buffer; break;
+    case DBTYPE_I8: V_VT(dst) = VT_I8; V_I8(dst) = *(LONGLONG *)p->buffer; break;
+    case DBTYPE_UI8: V_VT(dst) = VT_UI8; V_UI8(dst) = *(ULONGLONG *)p->buffer; break;
+    case DBTYPE_R4: V_VT(dst) = VT_R4; V_R4(dst) = *(float *)p->buffer; break;
+    case DBTYPE_R8: V_VT(dst) = VT_R8; V_R8(dst) = *(double *)p->buffer; break;
+    case DBTYPE_BOOL: V_VT(dst) = VT_BOOL; V_BOOL(dst) = *(BYTE *)p->buffer ? VARIANT_TRUE : VARIANT_FALSE; break;
+    case DBTYPE_DATE: case DBTYPE_DBTIMESTAMP: case DBTYPE_DBDATE: case DBTYPE_DBTIME:
+        V_VT(dst) = VT_DATE; V_DATE(dst) = timestamp_to_date( p->buffer ); break;
+    case DBTYPE_STR:
+    {
+        int chars = MultiByteToWideChar( CP_ACP, 0, p->buffer, p->ind, NULL, 0 );
+        V_VT(dst) = VT_BSTR;
+        if ((V_BSTR(dst) = SysAllocStringLen( NULL, chars )))
+            MultiByteToWideChar( CP_ACP, 0, p->buffer, p->ind, V_BSTR(dst), chars );
+        break;
+    }
+    case DBTYPE_BYTES:
+    {
+        SAFEARRAY *sa = SafeArrayCreateVector( VT_UI1, 0, p->ind );
+        void *data;
+        if (sa && SUCCEEDED(SafeArrayAccessData( sa, &data )))
+        {
+            memcpy( data, p->buffer, p->ind );
+            SafeArrayUnaccessData( sa );
+        }
+        V_VT(dst) = VT_ARRAY | VT_UI1;
+        V_ARRAY(dst) = sa;
+        break;
+    }
+    default:
+        V_VT(dst) = VT_BSTR;
+        V_BSTR(dst) = SysAllocStringLen( p->buffer, p->ind / sizeof(WCHAR) );
+        break;
+    }
+}
+
+static DBSTATUS *status_of( const DBBINDING *b, BYTE *data )
+{
+    return (b->dwPart & DBPART_STATUS) ? (DBSTATUS *)(data + b->obStatus) : NULL;
+}
+
+static DBLENGTH *length_of( const DBBINDING *b, BYTE *data )
+{
+    return (b->dwPart & DBPART_LENGTH) ? (DBLENGTH *)(data + b->obLength) : NULL;
+}
+
+static void *value_of( const DBBINDING *b, BYTE *data )
+{
+    void *value = data + b->obValue;
+    if (b->wType & DBTYPE_BYREF) value = *(void **)value;
+    return value;
+}
+
+void param_set_free( struct param_set *set )
+{
+    DBCOUNTITEM i;
+
+    if (!set) return;
+    for (i = 0; i < set->count; i++) if (set->params[i].ours) free( set->params[i].buffer );
+    free( set );
+}
+
+/* The bindings of the accessor, given to the statement (the first parameter set). */
+HRESULT param_set_bind( SQLHSTMT hstmt, const struct rt_accessor *acc, DBPARAMS *params,
+                        const struct param_info *infos, DB_UPARAMS ninfo, struct param_set **out )
+{
+    struct param_set *set;
+    BYTE *data = params->pData;
+    DBCOUNTITEM i;
+    HRESULT hr = S_OK;
+
+    *out = NULL;
+    if (!(acc->flags & DBACCESSOR_PARAMETERDATA)) return DB_E_BADACCESSORTYPE;
+    if (params->cParamSets > 1) FIXME( "%Iu parameter sets: only the first is used\n", params->cParamSets );
+    if (!(set = calloc( 1, offsetof( struct param_set, params[acc->count + 1] ) ))) return E_OUTOFMEMORY;
+    set->count = acc->count;
+
+    for (i = 0; i < acc->count && SUCCEEDED(hr); i++)
+    {
+        const DBBINDING *b = &acc->bindings[i];
+        struct bound_param *p = &set->params[i];
+        DBTYPE base = b->wType & ~DBTYPE_BYREF;
+        DBSTATUS *status = status_of( b, data );
+        DBLENGTH *length = length_of( b, data );
+        SQLULEN declared_size = 0;
+        SQLLEN csize;
+        RETCODE ret;
+
+        p->binding = b;
+        p->io = b->eParamIO == DBPARAMIO_OUTPUT ? SQL_PARAM_OUTPUT :
+                b->eParamIO == (DBPARAMIO_INPUT | DBPARAMIO_OUTPUT) ? SQL_PARAM_INPUT_OUTPUT : SQL_PARAM_INPUT;
+        p->type = declared_type( infos, ninfo, b->iOrdinal, &declared_size );
+        if (base == DBTYPE_VARIANT)
+        {
+            if (p->type == DBTYPE_EMPTY) p->type = variant_type( value_of( b, data ) );
+        }
+        else p->type = base;
+        if (!odbc_types( p->type, &p->ctype, &p->sqltype, &csize ))
+        {
+            WARN( "parameter %Iu: type %u is not supported\n", b->iOrdinal, p->type );
+            hr = DB_E_UNSUPPORTEDCONVERSION;
+            break;
+        }
+
+        if (base == DBTYPE_VARIANT || base == DBTYPE_BOOL || base == DBTYPE_DATE || base == DBTYPE_CY ||
+            base == DBTYPE_NUMERIC || base == DBTYPE_DECIMAL)
+        {
+            /* converted into a buffer of ours, and out of it for an output */
+            SQLULEN size = csize ? csize : max( declared_size ? declared_size * sizeof(WCHAR) : 0, 8000 );
+            VARIANT tmp, *src = NULL;
+
+            if (!(p->buffer = calloc( 1, size + sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; break; }
+            p->ours = TRUE;
+            p->buflen = size;
+            p->size = csize ? 0 : (declared_size ? declared_size : size / (p->ctype == SQL_C_WCHAR ? sizeof(WCHAR) : 1));
+            VariantInit( &tmp );
+            if (base == DBTYPE_VARIANT) src = value_of( b, data );
+            else if (base == DBTYPE_BOOL) { V_VT(&tmp) = VT_BOOL; V_BOOL(&tmp) = *(VARIANT_BOOL *)value_of( b, data ); src = &tmp; }
+            else if (base == DBTYPE_DATE) { V_VT(&tmp) = VT_DATE; V_DATE(&tmp) = *(DATE *)value_of( b, data ); src = &tmp; }
+            else if (base == DBTYPE_CY) { V_VT(&tmp) = VT_CY; V_CY(&tmp) = *(CY *)value_of( b, data ); src = &tmp; }
+            else if (base == DBTYPE_DECIMAL) { V_VT(&tmp) = VT_DECIMAL; V_DECIMAL(&tmp) = *(DECIMAL *)value_of( b, data ); src = &tmp; }
+            else
+            {
+                /* NUMERIC: its precision and scale as text */
+                const DB_NUMERIC *num = value_of( b, data );
+                ULONGLONG lo = *(const ULONGLONG *)num->val;
+                WCHAR text[48];
+                int len, s = num->scale;
+
+                swprintf( text, ARRAY_SIZE(text), L"%s%I64u", num->sign ? L"" : L"-", lo );
+                len = wcslen( text );
+                if (s > 0 && s < len)
+                {
+                    memmove( text + len - s + 1, text + len - s, (s + 1) * sizeof(WCHAR) );
+                    text[len - s] = '.';
+                }
+                V_VT(&tmp) = VT_BSTR;
+                V_BSTR(&tmp) = SysAllocString( text );
+                src = &tmp;
+            }
+            if (p->io != SQL_PARAM_OUTPUT)
+            {
+                if (status && *status == DBSTATUS_S_ISNULL) p->ind = SQL_NULL_DATA;
+                else hr = fill_from_variant( p, src, size );
+            }
+            else p->ind = SQL_NULL_DATA;
+            VariantClear( &tmp );
+            if (FAILED(hr)) break;
+        }
+        else
+        {
+            /* the consumer's own buffer */
+            p->buffer = value_of( b, data );
+            p->buflen = csize ? csize : b->cbMaxLen;
+            p->size = csize ? 0 : (declared_size ? declared_size :
+                                   (p->ctype == SQL_C_WCHAR ? b->cbMaxLen / sizeof(WCHAR) : b->cbMaxLen));
+            if (p->io != SQL_PARAM_OUTPUT && status && *status == DBSTATUS_S_ISNULL) p->ind = SQL_NULL_DATA;
+            else if (p->io == SQL_PARAM_OUTPUT) p->ind = 0;
+            else if (!csize)
+            {
+                /* the length part, else up to the terminating zero */
+                if (length) p->ind = *length;
+                else if (p->ctype == SQL_C_WCHAR) p->ind = wcslen( p->buffer ) * sizeof(WCHAR);
+                else if (p->ctype == SQL_C_CHAR) p->ind = strlen( p->buffer );
+                else p->ind = b->cbMaxLen;
+            }
+            else p->ind = csize;
+        }
+        if (!p->size) p->size = p->ctype == SQL_C_WCHAR || p->ctype == SQL_C_CHAR ? max( p->ind, 1 ) : 0;
+        if (p->ctype == SQL_C_WCHAR && p->size > 1 && p->ind > 0 && p->size < (SQLULEN)p->ind / sizeof(WCHAR))
+            p->size = p->ind / sizeof(WCHAR);
+        p->digits = p->type == DBTYPE_DBTIMESTAMP || p->type == DBTYPE_DATE ? 3 : 0;
+
+        TRACE( "parameter %Iu: io %d, type %u -> C %d SQL %d, size %Iu, ind %Id\n", b->iOrdinal, p->io, p->type,
+               p->ctype, p->sqltype, p->size, p->ind );
+#ifdef SG_MUTANT_DASQL_NO_BIND
+        continue;
+#endif
+        ret = SQLBindParameter( hstmt, b->iOrdinal, p->io, p->ctype, p->sqltype, p->size, p->digits, p->buffer,
+                                p->buflen, &p->ind );
+        if (!SQL_SUCCEEDED(ret))
+        {
+            WARN( "SQLBindParameter %Iu failed %d\n", b->iOrdinal, ret );
+            hr = DB_E_ERRORSOCCURRED;
+            if (status) *status = DBSTATUS_E_BADACCESSOR;
+        }
+        else if (status && p->io == SQL_PARAM_INPUT) *status = p->ind == SQL_NULL_DATA ? DBSTATUS_S_ISNULL : DBSTATUS_S_OK;
+    }
+    if (FAILED(hr))
+    {
+        param_set_free( set );
+        return hr;
+    }
+    *out = set;
+    return S_OK;
+}
+
+/* After the statement: the output parameters' values, lengths and statuses back into the buffer. */
+void param_set_finish( struct param_set *set, DBPARAMS *params )
+{
+    BYTE *data = params->pData;
+    DBCOUNTITEM i;
+
+    for (i = 0; i < set->count; i++)
+    {
+        struct bound_param *p = &set->params[i];
+        const DBBINDING *b = p->binding;
+        DBSTATUS *status = status_of( b, data );
+        DBLENGTH *length = length_of( b, data );
+        DBTYPE base = b->wType & ~DBTYPE_BYREF;
+
+        if (p->io == SQL_PARAM_INPUT) continue;
+        if (status) *status = p->ind == SQL_NULL_DATA ? DBSTATUS_S_ISNULL : DBSTATUS_S_OK;
+        if (p->ind == SQL_NULL_DATA)
+        {
+            if (base == DBTYPE_VARIANT && (b->dwPart & DBPART_VALUE))
+            {
+                VARIANT *v = value_of( b, data );
+                VariantClear( v );
+                V_VT(v) = VT_NULL;
+            }
+            continue;
+        }
+        if (base == DBTYPE_VARIANT)
+        {
+            if (b->dwPart & DBPART_VALUE) output_to_variant( p, value_of( b, data ) );
+            if (length) *length = sizeof(VARIANT);
+        }
+        else if (p->ours)
+        {
+            VARIANT v;
+            VariantInit( &v );
+            output_to_variant( p, &v );
+            if (base == DBTYPE_BOOL && V_VT(&v) == VT_BOOL) *(VARIANT_BOOL *)value_of( b, data ) = V_BOOL(&v);
+            else if (base == DBTYPE_DATE && V_VT(&v) == VT_DATE) *(DATE *)value_of( b, data ) = V_DATE(&v);
+            else if (base == DBTYPE_CY && SUCCEEDED(VariantChangeType( &v, &v, 0, VT_CY )))
+                *(CY *)value_of( b, data ) = V_CY(&v);
+            else if (base == DBTYPE_DECIMAL && SUCCEEDED(VariantChangeType( &v, &v, 0, VT_DECIMAL )))
+                *(DECIMAL *)value_of( b, data ) = V_DECIMAL(&v);
+            VariantClear( &v );
+        }
+        else if (length) *length = p->ind;
+    }
+}
