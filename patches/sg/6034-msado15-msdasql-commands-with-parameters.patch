+/* Stained Glass OS: the command's parameter accessors */
+static inline struct command *impl_from_IAccessor_cmd( IAccessor *iface )
+{
+    return CONTAINING_RECORD( iface, struct command, IAccessor_iface );
+}
+
+static HRESULT WINAPI command_accessor_QueryInterface(IAccessor *iface, REFIID riid, void **out)
+{
+    return ICommandText_QueryInterface(&impl_from_IAccessor_cmd(iface)->ICommandText_iface, riid, out);
+}
+
+static ULONG WINAPI command_accessor_AddRef(IAccessor *iface)
+{
+    return ICommandText_AddRef(&impl_from_IAccessor_cmd(iface)->ICommandText_iface);
+}
+
+static ULONG WINAPI command_accessor_Release(IAccessor *iface)
+{
+    return ICommandText_Release(&impl_from_IAccessor_cmd(iface)->ICommandText_iface);
+}
+
+static HRESULT WINAPI command_accessor_AddRefAccessor(IAccessor *iface, HACCESSOR accessor, DBREFCOUNT *count)
+{
+    return rt_addref_accessor(&impl_from_IAccessor_cmd(iface)->param_rt, accessor, count);
+}
+
+static HRESULT WINAPI command_accessor_CreateAccessor(IAccessor *iface, DBACCESSORFLAGS flags, DBCOUNTITEM count,
+        const DBBINDING bindings[], DBLENGTH row_size, HACCESSOR *accessor, DBBINDSTATUS status[])
+{
+    struct command *command = impl_from_IAccessor_cmd(iface);
+
+    TRACE("%p, %#lx, %Iu, %p, %Iu, %p, %p\n", command, flags, count, bindings, row_size, accessor, status);
+    /* a command's accessors are for its parameters and for the rows of what it executes */
+    return rt_create_accessor(&command->param_rt, flags, count, bindings, row_size, accessor, status);
+}
+
+static HRESULT WINAPI command_accessor_GetBindings(IAccessor *iface, HACCESSOR accessor, DBACCESSORFLAGS *flags,
+        DBCOUNTITEM *count, DBBINDING **bindings)
+{
+    return rt_get_bindings(&impl_from_IAccessor_cmd(iface)->param_rt, accessor, flags, count, bindings);
+}
+
+static HRESULT WINAPI command_accessor_ReleaseAccessor(IAccessor *iface, HACCESSOR accessor, DBREFCOUNT *count)
+{
+    return rt_release_accessor(&impl_from_IAccessor_cmd(iface)->param_rt, accessor, count);
+}
