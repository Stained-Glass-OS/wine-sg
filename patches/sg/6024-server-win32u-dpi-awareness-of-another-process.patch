From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, win32u: the DPI awareness of another process (6024)

A process records its DPI awareness context in the server, so
GetDpiAwarenessContextForProcess, GetProcessDpiAwareness and
GetSystemDpiForProcess of another process answer (SH-DPI).
---
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index c3346f3..799983d 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -4583,10 +4583,14 @@ MONITORINFO monitor_info_from_window( HWND hwnd, UINT flags )
  */
 ULONG WINAPI NtUserGetSystemDpiForProcess( HANDLE process )
 {
+    /* Stained Glass OS: a process that is not DPI aware sees 96, the others the system DPI */
     if (process && process != GetCurrentProcess())
     {
-        FIXME( "not supported on other process %p\n", process );
-        return 0;
+        ULONG context = NtUserGetProcessDpiAwarenessContext( process );
+
+        if (!context) return 0; /* not a process the caller may query */
+        if (NTUSER_DPI_CONTEXT_GET_AWARENESS( context ) == DPI_AWARENESS_UNAWARE) return USER_DEFAULT_SCREEN_DPI;
+        return system_dpi;
     }
 
     return system_dpi;
@@ -7439,6 +7443,14 @@ BOOL WINAPI NtUserSetProcessDpiAwarenessContext( ULONG context, ULONG unknown )
         return FALSE;
     }
 
+    /* Stained Glass OS: other processes read it from the server */
+    SERVER_START_REQ( set_process_dpi_context )
+    {
+        req->context = context;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+
     TRACE( "set to %#x\n", (UINT)context );
     return TRUE;
 }
@@ -7450,10 +7462,22 @@ ULONG WINAPI NtUserGetProcessDpiAwarenessContext( HANDLE process )
 {
     ULONG context;
 
+    /* Stained Glass OS: another process's from the server */
     if (process && process != GetCurrentProcess())
     {
-        WARN( "not supported on other process %p\n", process );
-        return NTUSER_DPI_UNAWARE;
+        context = 0;
+        SERVER_START_REQ( get_process_dpi_context )
+        {
+            req->handle = wine_server_obj_handle( process );
+            if (wine_server_call_err( req )) context = ~0u;
+            else context = reply->context;
+        }
+        SERVER_END_REQ;
+#ifdef SG_MUTANT_DPI_OTHER_PROCESS_UNAWARE
+        context = 0;
+#endif
+        if (context == ~0u) return 0;
+        return context ? context : NTUSER_DPI_UNAWARE;
     }
 
     context = ReadNoFence( &dpi_context );
diff --git a/include/wine/server_protocol.h b/include/wine/server_protocol.h
index abe43be..d1457b8 100644
--- a/include/wine/server_protocol.h
+++ b/include/wine/server_protocol.h
@@ -1247,6 +1247,32 @@ struct get_process_info_reply
 
 
 
+struct set_process_dpi_context_request
+{
+    struct request_header __header;
+    unsigned int   context;
+};
+struct set_process_dpi_context_reply
+{
+    struct reply_header __header;
+};
+
+
+
+struct get_process_dpi_context_request
+{
+    struct request_header __header;
+    obj_handle_t   handle;
+};
+struct get_process_dpi_context_reply
+{
+    struct reply_header __header;
+    unsigned int   context;
+    char __pad_12[4];
+};
+
+
+
 struct get_process_creation_policy_request
 {
     struct request_header __header;
@@ -6271,6 +6297,8 @@ enum request
     REQ_terminate_process,
     REQ_terminate_thread,
     REQ_get_process_info,
+    REQ_set_process_dpi_context,
+    REQ_get_process_dpi_context,
     REQ_get_process_creation_policy,
     REQ_get_process_debug_info,
     REQ_get_process_image_name,
@@ -6590,6 +6618,8 @@ union generic_request
     struct terminate_process_request terminate_process_request;
     struct terminate_thread_request terminate_thread_request;
     struct get_process_info_request get_process_info_request;
+    struct set_process_dpi_context_request set_process_dpi_context_request;
+    struct get_process_dpi_context_request get_process_dpi_context_request;
     struct get_process_creation_policy_request get_process_creation_policy_request;
     struct get_process_debug_info_request get_process_debug_info_request;
     struct get_process_image_name_request get_process_image_name_request;
@@ -6907,6 +6937,8 @@ union generic_reply
     struct terminate_process_reply terminate_process_reply;
     struct terminate_thread_reply terminate_thread_reply;
     struct get_process_info_reply get_process_info_reply;
+    struct set_process_dpi_context_reply set_process_dpi_context_reply;
+    struct get_process_dpi_context_reply get_process_dpi_context_reply;
     struct get_process_creation_policy_reply get_process_creation_policy_reply;
     struct get_process_debug_info_reply get_process_debug_info_reply;
     struct get_process_image_name_reply get_process_image_name_reply;
@@ -7211,6 +7243,6 @@ union generic_reply
     struct query_transaction_reply query_transaction_reply;
 };
 
-#define SERVER_PROTOCOL_VERSION 874
+#define SERVER_PROTOCOL_VERSION 875
 
 #endif /* __WINE_WINE_SERVER_PROTOCOL_H */
diff --git a/server/process.c b/server/process.c
index ebe2a2b..784d0c9 100644
--- a/server/process.c
+++ b/server/process.c
@@ -710,6 +710,7 @@ struct process *create_process( int fd, struct process *parent, unsigned int fla
     process->exit_code       = STILL_ACTIVE;
     process->running_threads = 0;
     process->priority        = PROCESS_PRIOCLASS_NORMAL;
+    process->dpi_context     = 0;
     process->suspend         = 0;
     process->is_system       = 0;
     process->debug_children  = 1;
@@ -2266,3 +2267,21 @@ DECL_HANDLER(list_processes)
         }
     }
 }
+
+/* Stained Glass OS: the DPI awareness context of the calling process, for the others to read */
+DECL_HANDLER(set_process_dpi_context)
+{
+    current->process->dpi_context = req->context;
+}
+
+/* Stained Glass OS: the DPI awareness context a process set (GetProcessDpiAwareness, GetSystemDpiForProcess) */
+DECL_HANDLER(get_process_dpi_context)
+{
+    struct process *process;
+
+    if ((process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION )))
+    {
+        reply->context = process->dpi_context;
+        release_object( process );
+    }
+}
diff --git a/server/process.h b/server/process.h
index 30483a1..c50aaef 100644
--- a/server/process.h
+++ b/server/process.h
@@ -88,6 +88,7 @@ struct process
     struct list          kernel_object;   /* list of kernel object pointers */
     struct pe_image_info image_info;      /* main exe image info */
     unsigned int         child_policy;    /* PROCESS_CREATION_CHILD_PROCESS_* in force (Stained Glass 1641) */
+    unsigned int         dpi_context;     /* DPI awareness context the process set, 0 for none (Stained Glass) */
     unsigned __int64     mitigation[2];   /* PROCESS_CREATION_MITIGATION_POLICY(2)_* it was created with */
     unsigned char       *uipi_allow;      /* Stained Glass OS: ChangeWindowMessageFilter's messages (a bit each) */
 };
diff --git a/server/protocol.def b/server/protocol.def
index 730f9ea..f9b7125 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1199,6 +1199,20 @@ struct obj_locator
 @END
 
 
+/* Stained Glass OS: record the calling process's DPI awareness context */
+@REQ(set_process_dpi_context)
+    unsigned int   context;        /* the context, 0 for none */
+@END
+
+
+/* Stained Glass OS: the DPI awareness context a process recorded */
+@REQ(get_process_dpi_context)
+    obj_handle_t   handle;         /* process handle */
+@REPLY
+    unsigned int   context;        /* the context, 0 for none */
+@END
+
+
 /* Retrieve what a process was created with, and its child process policy */
 @REQ(get_process_creation_policy)
     obj_handle_t handle;           /* process handle */
diff --git a/server/request_handlers.h b/server/request_handlers.h
index 423f54c..763698e 100644
--- a/server/request_handlers.h
+++ b/server/request_handlers.h
@@ -17,6 +17,8 @@ DECL_HANDLER(init_thread);
 DECL_HANDLER(terminate_process);
 DECL_HANDLER(terminate_thread);
 DECL_HANDLER(get_process_info);
+DECL_HANDLER(set_process_dpi_context);
+DECL_HANDLER(get_process_dpi_context);
 DECL_HANDLER(get_process_creation_policy);
 DECL_HANDLER(get_process_debug_info);
 DECL_HANDLER(get_process_image_name);
@@ -333,6 +335,8 @@ static const req_handler req_handlers[REQ_NB_REQUESTS] =
     (req_handler)req_terminate_process,
     (req_handler)req_terminate_thread,
     (req_handler)req_get_process_info,
+    (req_handler)req_set_process_dpi_context,
+    (req_handler)req_get_process_dpi_context,
     (req_handler)req_get_process_creation_policy,
     (req_handler)req_get_process_debug_info,
     (req_handler)req_get_process_image_name,
@@ -771,6 +775,12 @@ C_ASSERT( offsetof(struct get_process_info_reply, exit_code) == 52 );
 C_ASSERT( offsetof(struct get_process_info_reply, priority) == 56 );
 C_ASSERT( offsetof(struct get_process_info_reply, machine) == 60 );
 C_ASSERT( sizeof(struct get_process_info_reply) == 64 );
+C_ASSERT( offsetof(struct set_process_dpi_context_request, context) == 12 );
+C_ASSERT( sizeof(struct set_process_dpi_context_request) == 16 );
+C_ASSERT( offsetof(struct get_process_dpi_context_request, handle) == 12 );
+C_ASSERT( sizeof(struct get_process_dpi_context_request) == 16 );
+C_ASSERT( offsetof(struct get_process_dpi_context_reply, context) == 8 );
+C_ASSERT( sizeof(struct get_process_dpi_context_reply) == 16 );
 C_ASSERT( offsetof(struct get_process_creation_policy_request, handle) == 12 );
 C_ASSERT( sizeof(struct get_process_creation_policy_request) == 16 );
 C_ASSERT( offsetof(struct get_process_creation_policy_reply, child_policy) == 8 );
diff --git a/server/request_trace.h b/server/request_trace.h
index 2570d4c..c519595 100644
--- a/server/request_trace.h
+++ b/server/request_trace.h
@@ -210,6 +210,21 @@ static void dump_get_process_info_reply( const struct get_process_info_reply *re
     dump_varargs_pe_image_info( ", image=", cur_size );
 }
 
+static void dump_set_process_dpi_context_request( const struct set_process_dpi_context_request *req )
+{
+    fprintf( stderr, " context=%08x", req->context );
+}
+
+static void dump_get_process_dpi_context_request( const struct get_process_dpi_context_request *req )
+{
+    fprintf( stderr, " handle=%04x", req->handle );
+}
+
+static void dump_get_process_dpi_context_reply( const struct get_process_dpi_context_reply *req )
+{
+    fprintf( stderr, " context=%08x", req->context );
+}
+
 static void dump_get_process_creation_policy_request( const struct get_process_creation_policy_request *req )
 {
     fprintf( stderr, " handle=%04x", req->handle );
@@ -3598,6 +3613,8 @@ static const dump_func req_dumpers[REQ_NB_REQUESTS] =
     (dump_func)dump_terminate_process_request,
     (dump_func)dump_terminate_thread_request,
     (dump_func)dump_get_process_info_request,
+    (dump_func)dump_set_process_dpi_context_request,
+    (dump_func)dump_get_process_dpi_context_request,
     (dump_func)dump_get_process_creation_policy_request,
     (dump_func)dump_get_process_debug_info_request,
     (dump_func)dump_get_process_image_name_request,
@@ -3914,6 +3931,8 @@ static const dump_func reply_dumpers[REQ_NB_REQUESTS] =
     (dump_func)dump_terminate_process_reply,
     (dump_func)dump_terminate_thread_reply,
     (dump_func)dump_get_process_info_reply,
+    NULL,
+    (dump_func)dump_get_process_dpi_context_reply,
     (dump_func)dump_get_process_creation_policy_reply,
     (dump_func)dump_get_process_debug_info_reply,
     (dump_func)dump_get_process_image_name_reply,
@@ -4230,6 +4249,8 @@ static const char * const req_names[REQ_NB_REQUESTS] =
     "terminate_process",
     "terminate_thread",
     "get_process_info",
+    "set_process_dpi_context",
+    "get_process_dpi_context",
     "get_process_creation_policy",
     "get_process_debug_info",
     "get_process_image_name",
