     ptr = "SplInitializeWinSpoolDrv";
     pSplInitializeWinSpoolDrv = (void *) GetProcAddress(hspl, ptr);
     if (!pSplInitializeWinSpoolDrv) return ptr;
@@ -164,12 +171,44 @@ static void test_BuildOtherNamesFromMachineName(void)
       entry_#y: <ip-address> Tunnel adapter (string with a IPv6 ip-address)
     */
 
-    todo_wine
-    ok( res && (buffers != NULL) && (numentries >= 3) && (buffers[0] != NULL) && (buffers[0][0] == '\0'),
+    ok( res && (buffers != NULL) && (numentries >= 2) && (buffers[0] != NULL) && (buffers[0][0] == '\0'),
         "got %lu with %lu and %p,%lu (%p:%d)\n", res, GetLastError(), buffers, numentries,
         ((numentries > 0) && buffers) ? buffers[0] : NULL,
         ((numentries > 0) && buffers && buffers[0]) ? lstrlenW(buffers[0]) : -1);
 
+    if (res && buffers && numentries >= 2)
+    {
+        WCHAR host[MAX_COMPUTERNAME_LENGTH + 1];
+        DWORD len = ARRAY_SIZE(host), i;
+        ULONG size = 0;
+        BOOL adapter_up = FALSE;
+
+        ok(GetComputerNameW(host, &len), "GetComputerNameW failed: %lu\n", GetLastError());
+        ok(buffers[1] && !lstrcmpW(buffers[1], host), "got %s, expected the computer name %s\n",
+           wine_dbgstr_w(buffers[1]), wine_dbgstr_w(host));
+        for (i = 2; i < numentries; i++)
+            ok(buffers[i] && buffers[i][0], "entry %lu is empty\n", i);
+
+        /* "1 entry per ... adapter: <ip-address>" */
+        if (GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST, NULL, NULL, &size)
+                == ERROR_BUFFER_OVERFLOW)
+        {
+            IP_ADAPTER_ADDRESSES *adapters = HeapAlloc(GetProcessHeap(), 0, size), *adapter;
+
+            if (adapters && !GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST,
+                                                  NULL, adapters, &size))
+            {
+                for (adapter = adapters; adapter; adapter = adapter->Next)
+                    if (adapter->OperStatus == IfOperStatusUp && adapter->IfType != IF_TYPE_SOFTWARE_LOOPBACK
+                            && adapter->FirstUnicastAddress)
+                        adapter_up = TRUE;
+            }
+            HeapFree(GetProcessHeap(), 0, adapters);
+        }
+        if (adapter_up)
+            ok(numentries >= 3, "got %lu entries with an adapter that is up\n", numentries);
+    }
+
 }
 
 /* ########################### */
@@ -204,6 +243,46 @@ static void test_SplInitializeWinSpoolDrv(VOID)
 
 /* ########################### */
 
+static void test_printer_client_impersonation(void)
+{
+    HANDLE token, thread_token;
+    BOOL ret;
+
+    if (!pRevertToPrinterSelf || !pImpersonatePrinterClient)
+    {
+        win_skip("RevertToPrinterSelf and ImpersonatePrinterClient not found\n");
+        return;
+    }
+
+    /* not impersonating: nothing to revert */
+    token = pRevertToPrinterSelf();
+    ok(!token, "got %p, expected NULL while not impersonating\n", token);
+
+    ret = ImpersonateSelf(SecurityImpersonation);
+    ok(ret, "ImpersonateSelf failed: %lu\n", GetLastError());
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(ret, "OpenThreadToken failed while impersonating: %lu\n", GetLastError());
+    if (ret) CloseHandle(thread_token);
+
+    token = pRevertToPrinterSelf();
+    ok(token != NULL, "got NULL while impersonating\n");
+    SetLastError(0xdeadbeef);
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(!ret && GetLastError() == ERROR_NO_TOKEN, "got %d with %lu: the thread still impersonates\n", ret, GetLastError());
+    if (ret) CloseHandle(thread_token);
+
+    ret = pImpersonatePrinterClient(token);
+    ok(ret, "ImpersonatePrinterClient failed: %lu\n", GetLastError());
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(ret, "OpenThreadToken failed after ImpersonatePrinterClient: %lu\n", GetLastError());
+    if (ret) CloseHandle(thread_token);
+    /* the handle was cleaned up */
+    SetLastError(0xdeadbeef);
+    ok(!GetHandleInformation(token, (DWORD[1]){0}), "the token handle is still open\n");
+
+    RevertToSelf();
+}
+
 START_TEST(spoolss)
 {
     LPCSTR ptr;
@@ -217,5 +296,6 @@ START_TEST(spoolss)
 
     test_BuildOtherNamesFromMachineName();
     test_SplInitializeWinSpoolDrv();
+    test_printer_client_impersonation();
 
 }
