From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] spoolss: BuildOtherNamesFromMachineName, RevertToPrinterSelf, ImpersonatePrinterClient

BuildOtherNamesFromMachineName returned FALSE with nothing; the Wine test
records what Windows gives (its comment, behind a todo_wine): an array of
strings, the empty string first, then the computer name, then the IP address
of every interface that is up. It builds that, in one block of the spooler
heap; IPv6 addresses come before IPv4 ones and the loopback is left out.

RevertToPrinterSelf was a stub returning a made-up handle and
ImpersonatePrinterClient did nothing. As documented, RevertToPrinterSelf
returns the thread's impersonation token and stops the impersonation, NULL
when the thread is not impersonating; ImpersonatePrinterClient resumes it with
that token and closes the handle.
---
--- a/dlls/spoolss/Makefile.in
+++ b/dlls/spoolss/Makefile.in
@@ -1,6 +1,6 @@
 MODULE      = spoolss.dll
 IMPORTLIB   = spoolss
-IMPORTS     = winspool
+IMPORTS     = winspool iphlpapi
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
--- a/dlls/spoolss/spoolss_main.c
+++ b/dlls/spoolss/spoolss_main.c
@@ -22,6 +22,11 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winsock2.h"
+#include "ws2ipdef.h"
+#include "winternl.h"
+#include "ip2string.h"
+#include "iphlpapi.h"
 #include "winerror.h"
 #include "winreg.h"
 
@@ -88,16 +93,128 @@ LPWSTR WINAPI AllocSplStr(LPCWSTR pwstr)
     return res;
 }
 
+LPVOID WINAPI DllAllocSplMem(DWORD size);
+
 /******************************************************************
  *   BuildOtherNamesFromMachineName   [SPOOLSS.@]
+ *
+ * The names this machine is known by: an array of strings with the empty
+ * string first, then the computer name, then the IP address of every
+ * interface that is up (IPv6 first, then IPv4; the loopback is left out)
+ *
+ * PARAMS
+ *  names [O] receives the array, in one block of the spooler heap
+ *  count [O] receives the number of strings
+ *
+ * RETURNS
+ *  Success: TRUE
+ *  Failure: FALSE
  */
-BOOL WINAPI BuildOtherNamesFromMachineName(LPVOID * ptr1, LPVOID * ptr2)
+BOOL WINAPI BuildOtherNamesFromMachineName(LPWSTR **names, LPDWORD count)
 {
-    FIXME("(%p, %p) stub\n", ptr1, ptr2);
+    WCHAR host[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD host_len = ARRAY_SIZE(host), size = 0, n = 0, strings = 0, pass;
+    IP_ADAPTER_ADDRESSES *adapters = NULL, *adapter;
+    IP_ADAPTER_UNICAST_ADDRESS *unicast;
+    WCHAR **array;
+    WCHAR *text;
+    ULONG ret;
 
-    *ptr1 = NULL;
-    *ptr2 = NULL;
-    return FALSE;
+    TRACE("(%p, %p)\n", names, count);
+
+    if (!names || !count)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    *names = NULL;
+    *count = 0;
+
+    if (!GetComputerNameW(host, &host_len)) return FALSE;
+
+    ret = GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER,
+                               NULL, NULL, &size);
+    if (ret == ERROR_BUFFER_OVERFLOW)
+    {
+        if (!(adapters = HeapAlloc(GetProcessHeap(), 0, size))) return FALSE;
+        if (GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER,
+                                 NULL, adapters, &size))
+        {
+            HeapFree(GetProcessHeap(), 0, adapters);
+            adapters = NULL;
+        }
+    }
+
+    /* the first pass counts, the second one fills the one block: the
+     * pointers, then the strings */
+    array = NULL;
+    text = NULL;
+    for (pass = 0; pass < 2; pass++)
+    {
+        WCHAR *out = text;
+        DWORD family_pass;
+
+        n = 0;
+        if (pass)
+        {
+            array[n++] = out;
+            *out++ = 0;
+            array[n++] = out;
+            lstrcpyW(out, host);
+            out += host_len + 1;
+        }
+        else
+        {
+            n = 2;
+            strings = 1 + host_len + 1;
+        }
+        for (family_pass = 0; family_pass < 2; family_pass++)
+        {
+            ADDRESS_FAMILY family = family_pass ? AF_INET : AF_INET6;
+
+            for (adapter = adapters; adapter; adapter = adapter->Next)
+            {
+#ifdef SG_MUTANT_SPL_NO_NAMES
+                break;
+#endif
+                if (adapter->OperStatus != IfOperStatusUp || adapter->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+                for (unicast = adapter->FirstUnicastAddress; unicast; unicast = unicast->Next)
+                {
+                    WCHAR buffer[64];
+
+                    if (unicast->Address.lpSockaddr->sa_family != family) continue;
+                    if (family == AF_INET)
+                        RtlIpv4AddressToStringW(&((SOCKADDR_IN *)unicast->Address.lpSockaddr)->sin_addr, buffer);
+                    else
+                        RtlIpv6AddressToStringW(&((SOCKADDR_IN6 *)unicast->Address.lpSockaddr)->sin6_addr, buffer);
+                    if (pass)
+                    {
+                        array[n] = out;
+                        lstrcpyW(out, buffer);
+                        out += lstrlenW(buffer) + 1;
+                    }
+                    else strings += lstrlenW(buffer) + 1;
+                    n++;
+                }
+            }
+        }
+        if (!pass)
+        {
+            array = DllAllocSplMem(n * sizeof(WCHAR *) + strings * sizeof(WCHAR));
+            if (!array)
+            {
+                HeapFree(GetProcessHeap(), 0, adapters);
+                SetLastError(ERROR_OUTOFMEMORY);
+                return FALSE;
+            }
+            text = (WCHAR *)(array + n);
+        }
+    }
+    HeapFree(GetProcessHeap(), 0, adapters);
+
+    *names = array;
+    *count = n;
+    return TRUE;
 }
 
 /******************************************************************
@@ -174,10 +291,24 @@ BOOL WINAPI DllFreeSplStr(LPWSTR pwstr)
  */
 BOOL WINAPI ImpersonatePrinterClient(HANDLE hToken)
 {
-    FIXME("(%p) stub\n", hToken);
-    return TRUE;
-}
+    BOOL ret;
+
+    TRACE("(%p)\n", hToken);
 
+    /* the token RevertToPrinterSelf returned: impersonation resumes and the
+     * handle is closed */
+    if (!hToken)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    ret = SetThreadToken(NULL, hToken);
+#ifdef SG_MUTANT_SPL_NO_CLOSE
+    return ret;
+#endif
+    if (ret) CloseHandle(hToken);
+    return ret;
+}
 /******************************************************************
  *   InitializeRouter   [SPOOLSS.@]
  */
@@ -201,10 +332,22 @@ BOOL WINAPI IsLocalCall(void)
  */
 HANDLE WINAPI RevertToPrinterSelf(void)
 {
-    FIXME("() stub\n");
-    return (HANDLE) 0xdead0947;
-}
+    HANDLE token;
 
+    TRACE("()\n");
+
+    /* the thread's impersonation token; NULL when it is not impersonating */
+    if (!OpenThreadToken(GetCurrentThread(), TOKEN_IMPERSONATE | TOKEN_QUERY, TRUE, &token))
+        return NULL;
+#ifndef SG_MUTANT_SPL_NO_REVERT
+    if (!SetThreadToken(NULL, NULL))
+    {
+        CloseHandle(token);
+        return NULL;
+    }
+#endif
+    return token;
+}
