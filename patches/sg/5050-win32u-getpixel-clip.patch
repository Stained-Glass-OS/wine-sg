From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Return CLR_INVALID from GetPixel outside the clip region.

GetPixel returns CLR_INVALID for a pixel outside the DC's clipping region,
as documented ("If the pixel is outside of the current clipping region, the
return value is CLR_INVALID"); it read the pixel through the clip region.
The point is taken in logical coordinates.

Gate: test/win32u-getpixelclip-gate.sh (64/32).
---
 dlls/win32u/painting.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/painting.c b/dlls/win32u/painting.c
index 8a538da..6c1f52b 100644
--- a/dlls/win32u/painting.c
+++ b/dlls/win32u/painting.c
@@ -442,12 +442,23 @@ COLORREF WINAPI NtGdiGetPixel( HDC hdc, INT x, INT y )
 {
     PHYSDEV physdev;
     COLORREF ret;
+    POINT pt = { x, y };
     DC * dc = get_dc_ptr( hdc );
 
     if (!dc) return CLR_INVALID;
     update_dc( dc );
-    physdev = GET_DC_PHYSDEV( dc, pGetPixel );
-    ret = physdev->funcs->pGetPixel( physdev, x, y );
+    /* "If the pixel is outside of the current clipping region, the return
+     * value is CLR_INVALID" */
+    lp_to_dp( dc, &pt, 1 );
+#ifndef SG_MUTANT_GETPIXEL_NO_CLIP
+    if (get_dc_region( dc ) && !NtGdiPtInRegion( get_dc_region( dc ), pt.x, pt.y ))
+        ret = CLR_INVALID;
+    else
+#endif
+    {
+        physdev = GET_DC_PHYSDEV( dc, pGetPixel );
+        ret = physdev->funcs->pGetPixel( physdev, x, y );
+    }
     release_dc_ptr( dc );
     return ret;
 }
