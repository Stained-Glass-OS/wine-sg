From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, combase: a failed overlay handler takes no slot; COM gives the load error

An icon overlay handler that could not be made still used one of the 15 overlay slots, so the handlers after it lost theirs. Only handlers that are made and give a picture now take a slot. COM returned E_ACCESSDENIED for any in-process server it could not load; like Windows it now returns the loader's error as an HRESULT (0x8007007e for a missing DLL, 0x800700c1 for a 32-bit DLL in a 64-bit process).
---
diff --git a/dlls/combase/apartment.c b/dlls/combase/apartment.c
index 231de16..3cd4a6c 100644
--- a/dlls/combase/apartment.c
+++ b/dlls/combase/apartment.c
@@ -130,9 +130,16 @@ static HRESULT apartment_add_dll(const WCHAR *library_name, struct opendll **ret
     hLibrary = LoadLibraryExW(library_name, 0, LOAD_WITH_ALTERED_SEARCH_PATH);
     if (!hLibrary)
     {
-        ERR("couldn't load in-process dll %s\n", debugstr_w(library_name));
-        /* failure: DLL could not be loaded */
-        return E_ACCESSDENIED; /* FIXME: or should this be CO_E_DLLNOTFOUND? */
+        DWORD error = GetLastError();
+
+        ERR("couldn't load in-process dll %s: %lu\n", debugstr_w(library_name), error);
+#ifndef SG_MUTANT_LOAD_ACCESSDENIED
+        /* Stained Glass OS 6248: as on Windows the loader's error, e.g. 0x800700c1 for a
+         * 32-bit server in a 64-bit process, 0x8007007e for a missing one */
+        return error ? HRESULT_FROM_WIN32(error) : E_FAIL;
+#else
+        return E_ACCESSDENIED;
+#endif
     }
 
     /* DllCanUnloadNow is optional */
diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 93919cd..8d70589 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -1181,11 +1181,14 @@ static void overlays_load(void)
 
         *h = all[i];
         h->image = -1;
-        h->overlay = overlay_count + 1;     /* the slot is the place in the sorted list, loaded or not */
+        h->overlay = overlay_count + 1;
+#ifdef SG_MUTANT_FAILED_SLOT
         overlay_count++;
+#endif
         hr = CoCreateInstance( &h->clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IShellIconOverlayIdentifier, (void **)&h->obj );
         if (FAILED(hr))
         {
+            /* Stained Glass OS 6248: a handler that cannot be made takes no slot; the next one does */
             WARN( "overlay handler %s %s not made: %#lx\n", debugstr_w(h->name), debugstr_guid(&h->clsid), hr );
             h->obj = NULL;
             continue;
@@ -1199,6 +1202,9 @@ static void overlays_load(void)
             h->obj = NULL;
             continue;
         }
+#ifndef SG_MUTANT_FAILED_SLOT
+        overlay_count++;
+#endif
         if (!(flags & ISIOI_ICONINDEX)) h->icon_index = 0;
         if (FAILED(IShellIconOverlayIdentifier_GetPriority( h->obj, &h->priority ))) h->priority = 100;
         TRACE( "overlay %d: %s %s %s,%d priority %d\n", h->overlay, debugstr_w(h->name), debugstr_guid(&h->clsid),
