diff --git a/dlls/dnsapi/mdnsunix.c b/dlls/dnsapi/mdnsunix.c
index 8e032da..dc0becf 100644
--- a/dlls/dnsapi/mdnsunix.c
+++ b/dlls/dnsapi/mdnsunix.c
@@ -39,6 +39,10 @@
 #include <stdint.h>
 #include <dlfcn.h>
 #include <pthread.h>
+#include <unistd.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -552,3 +556,55 @@ NTSTATUS mdns_close( void *args )
     session_free( s );
     return STATUS_SUCCESS;
 }
+
+/* a DNS message over UDP (dynamic updates go to the zone's primary server): two tries, the answer with the
+ * message's ID */
+NTSTATUS dns_send( void *args )
+{
+    struct dns_send_params *params = args;
+    struct sockaddr_storage sa;
+    socklen_t salen;
+    int fd, try;
+
+    params->reply_len = 0;
+    if (params->len < 12 || params->len > sizeof(params->msg)) return STATUS_INVALID_PARAMETER;
+    memset( &sa, 0, sizeof(sa) );
+    if (params->family == AF_INET)
+    {
+        struct sockaddr_in *in = (struct sockaddr_in *)&sa;
+        in->sin_family = AF_INET;
+        in->sin_port = htons( params->port );
+        memcpy( &in->sin_addr, params->addr, 4 );
+        salen = sizeof(*in);
+    }
+    else if (params->family == AF_INET6)
+    {
+        struct sockaddr_in6 *in6 = (struct sockaddr_in6 *)&sa;
+        in6->sin6_family = AF_INET6;
+        in6->sin6_port = htons( params->port );
+        memcpy( &in6->sin6_addr, params->addr, 16 );
+        salen = sizeof(*in6);
+    }
+    else return STATUS_INVALID_PARAMETER;
+    if ((fd = socket( params->family, SOCK_DGRAM, 0 )) < 0) return STATUS_NETWORK_UNREACHABLE;
+    for (try = 0; try < 2; try++)
+    {
+        struct pollfd pfd = { fd, POLLIN };
+        ssize_t n;
+
+        if (sendto( fd, params->msg, params->len, 0, (struct sockaddr *)&sa, salen ) < 0) break;
+        while (poll( &pfd, 1, params->timeout ) > 0)
+        {
+            n = recv( fd, params->reply, sizeof(params->reply), 0 );
+            if (n >= 12 && !memcmp( params->reply, params->msg, 2 ))
+            {
+                params->reply_len = n;
+                close( fd );
+                return STATUS_SUCCESS;
+            }
+            if (n < 0) break;
+        }
+    }
+    close( fd );
+    return STATUS_IO_TIMEOUT;
+}
diff --git a/dlls/dnsapi/update.c b/dlls/dnsapi/update.c
new file mode 100644
index 0000000..323cba5
--- /dev/null
+++ b/dlls/dnsapi/update.c
@@ -0,0 +1,389 @@
+/*
+ * DNS dynamic update (RFC 2136): DnsModifyRecordsInSet and DnsReplaceRecordSet
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * An update goes to the primary server of the zone that holds the name: the
+ * zone is the nearest enclosing name with an SOA record, its primary the SOA's
+ * MNAME (both found with the default name servers). The message deletes,
+ * then adds, as the documentation says; the server's response code is the
+ * result. Updates are sent unsigned: a secure (GSS-TSIG) update, which a
+ * caller can require with DNS_UPDATE_SECURITY_ON or _ONLY, is not made, and
+ * such a call fails without sending anything.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "windns.h"
+#include "ws2def.h"
+#include "dnsapi.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dnsapi);
+
+#define CLASS_IN   1
+#define CLASS_NONE 254
+#define CLASS_ANY  255
+#define OPCODE_UPDATE 5
+
+struct msg
+{
+    BYTE *data;
+    DWORD len, size;
+    BOOL overflow;
+};
+
+static void put( struct msg *m, const void *data, DWORD len )
+{
+    if (m->len + len > m->size) { m->overflow = TRUE; return; }
+    memcpy( m->data + m->len, data, len );
+    m->len += len;
+}
+
+static void put16( struct msg *m, WORD v )
+{
+    BYTE b[2] = { v >> 8, v };
+    put( m, b, 2 );
+}
+
+static void put32( struct msg *m, DWORD v )
+{
+    BYTE b[4] = { v >> 24, v >> 16, v >> 8, v };
+    put( m, b, 4 );
+}
+
+/* a name in labels, uncompressed */
+static BOOL put_name( struct msg *m, const WCHAR *name )
+{
+    char utf8[DNS_MAX_NAME_BUFFER_LENGTH * 3], *label, *dot;
+
+    if (!name || !WideCharToMultiByte( CP_UTF8, 0, name, -1, utf8, sizeof(utf8), NULL, NULL )) return FALSE;
+    label = utf8;
+    while (*label)
+    {
+        size_t len;
+        BYTE b;
+
+        dot = strchr( label, '.' );
+        len = dot ? dot - label : strlen( label );
+        if (!len || len > 63) return FALSE;
+        b = len;
+        put( m, &b, 1 );
+        put( m, label, len );
+        if (!dot) break;
+        label = dot + 1;
+    }
+    put( m, "", 1 );
+    return !m->overflow;
+}
+
+/* a record's data in wire format, for the types an update commonly carries */
+static DNS_STATUS put_rdata( struct msg *m, const DNS_RECORDW *r )
+{
+    DWORD start, i;
+    WORD rdlen;
+
+    put16( m, 0 );          /* the length, filled in below */
+    start = m->len;
+    switch (r->wType)
+    {
+    case DNS_TYPE_A:
+        put( m, &r->Data.A.IpAddress, 4 );
+        break;
+    case DNS_TYPE_AAAA:
+        put( m, &r->Data.AAAA.Ip6Address, 16 );
+        break;
+    case DNS_TYPE_PTR:
+    case DNS_TYPE_CNAME:
+    case DNS_TYPE_NS:
+        if (!put_name( m, r->Data.PTR.pNameHost )) return ERROR_INVALID_PARAMETER;
+        break;
+    case DNS_TYPE_MX:
+        put16( m, r->Data.MX.wPreference );
+        if (!put_name( m, r->Data.MX.pNameExchange )) return ERROR_INVALID_PARAMETER;
+        break;
+    case DNS_TYPE_SRV:
+        put16( m, r->Data.SRV.wPriority );
+        put16( m, r->Data.SRV.wWeight );
+        put16( m, r->Data.SRV.wPort );
+        if (!put_name( m, r->Data.SRV.pNameTarget )) return ERROR_INVALID_PARAMETER;
+        break;
+    case DNS_TYPE_TEXT:
+        for (i = 0; i < r->Data.TXT.dwStringCount; i++)
+        {
+            char str[256 * 3];
+            int len = WideCharToMultiByte( CP_UTF8, 0, r->Data.TXT.pStringArray[i], -1, str, sizeof(str), NULL, NULL );
+            BYTE b;
+            if (len <= 0 || len - 1 > 255) return ERROR_INVALID_PARAMETER;
+            b = len - 1;
+            put( m, &b, 1 );
+            put( m, str, len - 1 );
+        }
+        break;
+    default:
+        FIXME( "record type %u\n", r->wType );
+        return DNS_ERROR_INVALID_TYPE;
+    }
+    if (m->overflow) return ERROR_INSUFFICIENT_BUFFER;
+    rdlen = m->len - start;
+    m->data[start - 2] = rdlen >> 8;
+    m->data[start - 1] = rdlen;
+    return ERROR_SUCCESS;
+}
+
+/* the zone that holds the name, and its primary server */
+static DNS_STATUS find_zone( const WCHAR *name, WCHAR **zone, WCHAR **primary )
+{
+    const WCHAR *candidate = name;
+    DNS_RECORDW *records, *r;
+
+    *zone = *primary = NULL;
+    while (candidate && *candidate)
+    {
+        if (!DnsQuery_W( candidate, DNS_TYPE_SOA, DNS_QUERY_STANDARD, NULL, (DNS_RECORD **)&records, NULL ))
+        {
+            for (r = records; r; r = r->pNext)
+                if (r->wType == DNS_TYPE_SOA && DnsNameCompare_W( r->pName, candidate ))
+                {
+                    *zone = wcsdup( candidate );
+                    *primary = wcsdup( r->Data.SOA.pNamePrimaryServer );
+                    break;
+                }
+            DnsRecordListFree( (DNS_RECORD *)records, DnsFreeRecordList );
+            if (*zone) return *primary ? ERROR_SUCCESS : ERROR_OUTOFMEMORY;
+        }
+        if ((candidate = wcschr( candidate, '.' ))) candidate++;
+    }
+    return DNS_ERROR_RCODE_NAME_ERROR;
+}
+
+static DNS_STATUS rcode_status( BYTE rcode )
+{
+    static const DNS_STATUS map[] =
+    {
+        ERROR_SUCCESS, DNS_ERROR_RCODE_FORMAT_ERROR, DNS_ERROR_RCODE_SERVER_FAILURE, DNS_ERROR_RCODE_NAME_ERROR,
+        DNS_ERROR_RCODE_NOT_IMPLEMENTED, DNS_ERROR_RCODE_REFUSED, DNS_ERROR_RCODE_YXDOMAIN,
+        DNS_ERROR_RCODE_YXRRSET, DNS_ERROR_RCODE_NXRRSET, DNS_ERROR_RCODE_NOTAUTH, DNS_ERROR_RCODE_NOTZONE,
+    };
+    return rcode < ARRAY_SIZE(map) ? map[rcode] : DNS_ERROR_RCODE;
+}
+
+static DNS_STATUS send_update( const WCHAR *primary, struct dns_send_params *params )
+{
+    DNS_RECORDW *records, *r;
+    DNS_STATUS status = DNS_ERROR_RCODE_SERVER_FAILURE;
+    WORD types[2] = { DNS_TYPE_A, DNS_TYPE_AAAA };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(types); i++)
+    {
+        if (DnsQuery_W( primary, types[i], DNS_QUERY_STANDARD, NULL, (DNS_RECORD **)&records, NULL )) continue;
+        for (r = records; r; r = r->pNext)
+        {
+            if (r->wType != types[i]) continue;
+            params->family = types[i] == DNS_TYPE_A ? AF_INET : AF_INET6;
+            memcpy( params->addr, types[i] == DNS_TYPE_A ? (void *)&r->Data.A.IpAddress : (void *)&r->Data.AAAA.Ip6Address,
+                    types[i] == DNS_TYPE_A ? 4 : 16 );
+            params->port = 53;
+            params->timeout = 3000;
+            if (!RESOLV_CALL( dns_send, params ))
+            {
+                /* the response to our update, its code */
+                if (params->reply_len < 12 || !(params->reply[2] & 0x80) || ((params->reply[2] >> 3) & 0xf) != OPCODE_UPDATE)
+                    status = DNS_ERROR_BAD_PACKET;
+                else status = rcode_status( params->reply[3] & 0xf );
+                DnsRecordListFree( (DNS_RECORD *)records, DnsFreeRecordList );
+                return status;
+            }
+            status = ERROR_TIMEOUT;
+        }
+        DnsRecordListFree( (DNS_RECORD *)records, DnsFreeRecordList );
+    }
+    return status;
+}
+
+/* deletes (the records of delete, or the set of replace's name and type), then adds */
+static DNS_STATUS update( DNS_RECORDW *add, DNS_RECORDW *delete, BOOL replace, DWORD options )
+{
+    DNS_RECORDW *first = add ? add : delete, *r;
+    struct dns_send_params *params;
+    WCHAR *zone = NULL, *primary = NULL;
+    struct msg m;
+    DNS_STATUS status;
+    WORD count = 0;
+
+    if (!first) return ERROR_INVALID_PARAMETER;
+    if (options & (DNS_UPDATE_SECURITY_ON | DNS_UPDATE_SECURITY_ONLY))
+    {
+        WARN( "secure dynamic update is not available\n" );
+        return ERROR_NOT_SUPPORTED;
+    }
+    /* every record names the same owner */
+    for (r = add; r; r = r->pNext) if (!DnsNameCompare_W( r->pName, first->pName )) return ERROR_INVALID_PARAMETER;
+    for (r = delete; r; r = r->pNext) if (!DnsNameCompare_W( r->pName, first->pName )) return ERROR_INVALID_PARAMETER;
+
+    if ((status = find_zone( first->pName, &zone, &primary ))) return status;
+    TRACE( "zone %s, primary %s\n", debugstr_w(zone), debugstr_w(primary) );
+    if (!(params = calloc( 1, sizeof(*params) )))
+    {
+        status = ERROR_OUTOFMEMORY;
+        goto done;
+    }
+    m.data = params->msg;
+    m.size = sizeof(params->msg);
+    m.len = 0;
+    m.overflow = FALSE;
+    put16( &m, GetTickCount() ^ GetCurrentThreadId() );
+    put16( &m, OPCODE_UPDATE << 11 );
+    put16( &m, 1 );             /* the zone */
+    put16( &m, 0 );             /* no prerequisite */
+    put16( &m, 0 );             /* the updates, filled in below */
+    put16( &m, 0 );
+    if (!put_name( &m, zone )) { status = ERROR_INVALID_PARAMETER; goto done; }
+    put16( &m, DNS_TYPE_SOA );
+    put16( &m, CLASS_IN );
+
+    if (replace)
+    {
+        /* the whole set of the name and type goes */
+        put_name( &m, first->pName );
+        put16( &m, first->wType );
+        put16( &m, CLASS_ANY );
+        put32( &m, 0 );
+        put16( &m, 0 );
+        count++;
+    }
+    for (r = delete; r; r = r->pNext, count++)
+    {
+        /* one record of the set: class NONE, no time to live */
+        if (!put_name( &m, r->pName )) { status = ERROR_INVALID_PARAMETER; goto done; }
+        put16( &m, r->wType );
+        put16( &m, CLASS_NONE );
+        put32( &m, 0 );
+        if ((status = put_rdata( &m, r ))) goto done;
+    }
+    for (r = add; r; r = r->pNext, count++)
+    {
+        if (!put_name( &m, r->pName )) { status = ERROR_INVALID_PARAMETER; goto done; }
+        put16( &m, r->wType );
+        put16( &m, CLASS_IN );
+        put32( &m, r->dwTtl ? r->dwTtl : 1200 );
+        if ((status = put_rdata( &m, r ))) goto done;
+    }
+#ifdef SG_MUTANT_UPDATE_NO_DELETE
+    if (delete && !replace) count = 0;
+#endif
+    if (m.overflow) { status = ERROR_INSUFFICIENT_BUFFER; goto done; }
+    params->msg[8] = count >> 8;
+    params->msg[9] = count;
+    params->len = m.len;
+    status = send_update( primary, params );
+done:
+    free( params );
+    free( zone );
+    free( primary );
+    return status;
+}
+
+static DNS_RECORDW *to_unicode( DNS_RECORDA *list, DNS_CHARSET charset )
+{
+    return list ? (DNS_RECORDW *)DnsRecordSetCopyEx( (DNS_RECORD *)list, charset, DnsCharSetUnicode ) : NULL;
+}
+
+static DNS_STATUS update_converted( DNS_RECORDA *add, DNS_RECORDA *delete, BOOL replace, DWORD options,
+                                    DNS_CHARSET charset )
+{
+    DNS_RECORDW *addW = to_unicode( add, charset ), *deleteW = to_unicode( delete, charset );
+    DNS_STATUS status;
+
+    if ((add && !addW) || (delete && !deleteW)) status = ERROR_OUTOFMEMORY;
+    else status = update( addW, deleteW, replace, options );
+    DnsRecordListFree( (DNS_RECORD *)addW, DnsFreeRecordList );
+    DnsRecordListFree( (DNS_RECORD *)deleteW, DnsFreeRecordList );
+    return status;
+}
+
+/******************************************************************************
+ * DnsModifyRecordsInSet_A                 [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsModifyRecordsInSet_A( DNS_RECORDA *add, DNS_RECORDA *delete, DWORD options, HANDLE context,
+                                           void *servers, void *reserved )
+{
+    TRACE( "(%p, %p, %#lx, %p, %p, %p)\n", add, delete, options, context, servers, reserved );
+    return update_converted( add, delete, FALSE, options, DnsCharSetAnsi );
+}
+
+/******************************************************************************
+ * DnsModifyRecordsInSet_UTF8              [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsModifyRecordsInSet_UTF8( DNS_RECORDA *add, DNS_RECORDA *delete, DWORD options, HANDLE context,
+                                              void *servers, void *reserved )
+{
+    TRACE( "(%p, %p, %#lx, %p, %p, %p)\n", add, delete, options, context, servers, reserved );
+    return update_converted( add, delete, FALSE, options, DnsCharSetUtf8 );
+}
+
+/******************************************************************************
+ * DnsModifyRecordsInSet_W                 [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsModifyRecordsInSet_W( DNS_RECORDW *add, DNS_RECORDW *delete, DWORD options, HANDLE context,
+                                           void *servers, void *reserved )
+{
+    TRACE( "(%p, %p, %#lx, %p, %p, %p)\n", add, delete, options, context, servers, reserved );
+    return update( add, delete, FALSE, options );
+}
+
+/******************************************************************************
+ * DnsReplaceRecordSetA                    [DNSAPI.@]
+ */
+DNS_STATUS WINAPI DnsReplaceRecordSetA( DNS_RECORDA *set, DWORD options, HANDLE context, void *servers,
+                                        void *reserved )
+{
+    TRACE( "(%p, %#lx, %p, %p, %p)\n", set, options, context, servers, reserved );
