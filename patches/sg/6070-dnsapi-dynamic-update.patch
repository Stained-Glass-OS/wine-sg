+/* a DNS message to a server over UDP, its answer back (update.c) */
+#define DNS_SEND_LEN 4096
+struct dns_send_params
+{
+    UINT32 family;                  /* AF_INET or AF_INET6 */
+    UINT8  addr[16];
+    UINT16 port;
+    UINT16 pad;
+    UINT32 timeout;                 /* milliseconds per try */
+    UINT32 len;
+    UINT8  msg[DNS_SEND_LEN];
+    UINT32 reply_len;               /* out */
+    UINT8  reply[DNS_SEND_LEN];
+};
+
