     unix_get_searchlist,
@@ -187,6 +202,7 @@ enum unix_funcs
     unix_mdns_wait,
     unix_mdns_cancel,
     unix_mdns_close,
+    unix_dns_send,
     unix_funcs_count
 };
 
@@ -194,5 +210,6 @@ extern NTSTATUS mdns_start( void *args );
 extern NTSTATUS mdns_wait( void *args );
 extern NTSTATUS mdns_cancel( void *args );
 extern NTSTATUS mdns_close( void *args );
+extern NTSTATUS dns_send( void *args );
 
 #define RESOLV_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
