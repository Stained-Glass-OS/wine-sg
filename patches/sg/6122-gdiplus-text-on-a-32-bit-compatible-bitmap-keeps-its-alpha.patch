From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: text on a 32-bit compatible bitmap keeps its alpha

GDI+ text on an HDC holding a 32-bit device bitmap (CreateCompatibleBitmap of a 32-bit screen) went through GDI's ExtTextOut, which leaves alpha 0; on a 32-bit DIB section it is drawn by the software path and its opaque pixels get alpha 255. SumatraPDF draws its tab bar, shown in the DWM extended frame, into such a bitmap: the selected tab's label was transparent and the others washed out. Text on a 32-bit device bitmap is drawn as on a DIB now; nothing else changes.
---
diff --git a/dlls/gdiplus/gdiplus_private.h b/dlls/gdiplus/gdiplus_private.h
index abdee20..f0dee99 100644
--- a/dlls/gdiplus/gdiplus_private.h
+++ b/dlls/gdiplus/gdiplus_private.h
@@ -260,6 +260,7 @@ struct GpGraphics{
     INT hdc_refs;
     BOOL owndc;
     BOOL alpha_hdc;
+    BOOL alpha_ddb;     /* Stained Glass OS: the HDC holds a 32-bit device bitmap (text keeps its alpha) */
     BOOL printer_display;
     GpImage *image;
     ImageType image_type;
diff --git a/dlls/gdiplus/graphics.c b/dlls/gdiplus/graphics.c
index f86a717..42f462f 100644
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -2702,6 +2702,7 @@ GpStatus WINGDIPAPI GdipCreateFromHDC2(HDC hdc, HANDLE hDevice, GpGraphics **gra
     GpStatus retval;
     HBITMAP hbitmap;
     DIBSECTION dib;
+    INT size;
 
     TRACE("(%p, %p, %p)\n", hdc, hDevice, graphics);
 
@@ -2725,11 +2726,20 @@ GpStatus WINGDIPAPI GdipCreateFromHDC2(HDC hdc, HANDLE hDevice, GpGraphics **gra
     }
 
     hbitmap = GetCurrentObject(hdc, OBJ_BITMAP);
-    if (hbitmap && GetObjectW(hbitmap, sizeof(dib), &dib) == sizeof(dib) &&
+    size = hbitmap ? GetObjectW(hbitmap, sizeof(dib), &dib) : 0;
+    if (size == sizeof(dib) &&
         dib.dsBmih.biBitCount == 32 && dib.dsBmih.biCompression == BI_RGB)
     {
         (*graphics)->alpha_hdc = 1;
     }
+    /* Stained Glass OS: a 32-bit compatible bitmap (CreateCompatibleBitmap of a
+     * 32-bit screen) keeps an alpha channel too: SumatraPDF draws its tab bar,
+     * shown in the DWM frame, into one, and GDI's text left the labels' pixels
+     * at alpha 0 -- transparent there.  Text on it is drawn as on a 32-bit DIB. */
+    else if (size == sizeof(BITMAP) && dib.dsBm.bmBitsPixel == 32)
+    {
+        (*graphics)->alpha_ddb = 1;
+    }
 
     (*graphics)->hdc = hdc;
     (*graphics)->hwnd = WindowFromDC(hdc);
@@ -8404,6 +8414,9 @@ static GpStatus draw_driver_string(GpGraphics *graphics, GDIPCONST UINT16 *text,
     }
 
     if (has_gdi_dc(graphics) && !graphics->alpha_hdc &&
+#ifndef SG_MUTANT_DDB_TEXT_BY_GDI
+        !graphics->alpha_ddb &&
+#endif
         brush->bt == BrushTypeSolidColor &&
         (((GpSolidFill*)brush)->color & 0xff000000) == 0xff000000)
         stat = GDI32_GdipDrawDriverString(graphics, text, length, font, format,
