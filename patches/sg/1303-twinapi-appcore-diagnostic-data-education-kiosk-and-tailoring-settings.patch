+ */
+
+#include "private.h"
+
+#include "winreg.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+static DWORD reg_dword( HKEY root, const WCHAR *key, const WCHAR *name, DWORD def )
+{
+    DWORD value, size = sizeof(value);
+    if (RegGetValueW( root, key, name, RRF_RT_REG_DWORD, NULL, &value, &size )) return def;
+    return value;
+}
+
+/* the diagnostic data level: Group Policy's AllowTelemetry, else the one set
+ * in Settings, else "Required" (Basic), the default */
+static PlatformDataCollectionLevel collection_level(void)
+{
+    DWORD level = reg_dword( HKEY_LOCAL_MACHINE, L"Software\\Policies\\Microsoft\\Windows\\DataCollection", L"AllowTelemetry", ~0u );
+    if (level == ~0u)
+        level = reg_dword( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\DataCollection",
+                           L"AllowTelemetry", PlatformDataCollectionLevel_Basic );
+    if (level > PlatformDataCollectionLevel_Full) level = PlatformDataCollectionLevel_Full;
+    return level;
+}
+
+/* a factory: IActivationFactory and one statics interface, both on one
+ * static object */
+#define DEFINE_FACTORY( name, statics_type, statics_iid )                                          \
+    struct name##_factory                                                                          \
+    {                                                                                              \
+        IActivationFactory IActivationFactory_iface;                                               \
+        statics_type statics;                                                                      \
+    };                                                                                             \
+    static inline struct name##_factory *name##_from_factory( IActivationFactory *iface )          \
+    {                                                                                              \
+        return CONTAINING_RECORD( iface, struct name##_factory, IActivationFactory_iface );        \
+    }                                                                                              \
+    static HRESULT WINAPI name##_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out ) \
+    {                                                                                              \
+        struct name##_factory *impl = name##_from_factory( iface );                                \
+        TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );                  \
+        if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||          \
+            IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))  \
+        {                                                                                          \
+            *out = &impl->IActivationFactory_iface;                                                \
+            return S_OK;                                                                           \
+        }                                                                                          \
+        if (IsEqualGUID( iid, &statics_iid ))                                                      \
+        {                                                                                          \
+            *out = &impl->statics;                                                                 \
+            return S_OK;                                                                           \
+        }                                                                                          \
+        *out = NULL;                                                                               \
+        return E_NOINTERFACE;                                                                      \
+    }                                                                                              \
+    static const struct IActivationFactoryVtbl name##_factory_vtbl =                               \
+    {                                                                                              \
+        name##_factory_QueryInterface, static_AddRef, static_Release,                              \
+        static_GetIids, static_GetRuntimeClassName, static_GetTrustLevel,                          \
+        static_ActivateInstance,                                                                   \
+    };                                                                                             \
+    DEFINE_IINSPECTABLE_( name##_statics, statics_type, struct name##_factory, name##_from_statics, statics, \
+                          &impl->IActivationFactory_iface )
+
+/* static objects: nothing to count */
+static ULONG WINAPI static_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI static_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI static_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI static_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name ) { return E_NOTIMPL; }
+static HRESULT WINAPI static_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI static_ActivateInstance( IActivationFactory *iface, IInspectable **out ) { return E_NOTIMPL; }
+
+/* Windows.System.Profile.PlatformDiagnosticsAndUsageDataSettings */
+
+DEFINE_FACTORY( diag_data, IPlatformDiagnosticsAndUsageDataSettingsStatics, IID_IPlatformDiagnosticsAndUsageDataSettingsStatics );
+
+static HRESULT WINAPI diag_data_statics_get_CollectionLevel( IPlatformDiagnosticsAndUsageDataSettingsStatics *iface,
+                                                             PlatformDataCollectionLevel *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = collection_level();
+    return S_OK;
+}
+
+static HRESULT WINAPI diag_data_statics_add_CollectionLevelChanged( IPlatformDiagnosticsAndUsageDataSettingsStatics *iface,
+                                                                    IEventHandler_IInspectable *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    /* the level changes only with policy or Settings, never under a running
+     * program here: there is nothing to tell */
+    if (!handler || !token) return E_POINTER;
+    token->value = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI diag_data_statics_remove_CollectionLevelChanged( IPlatformDiagnosticsAndUsageDataSettingsStatics *iface,
+                                                                       EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %I64d.\n", iface, token.value );
+    return S_OK;
+}
+
+static HRESULT WINAPI diag_data_statics_CanCollectDiagnostics( IPlatformDiagnosticsAndUsageDataSettingsStatics *iface,
+                                                               PlatformDataCollectionLevel level, boolean *result )
+{
+    TRACE( "iface %p, level %d, result %p.\n", iface, level, result );
+    if (!result) return E_POINTER;
+    *result = level <= collection_level();
+    return S_OK;
+}
+
+static const struct IPlatformDiagnosticsAndUsageDataSettingsStaticsVtbl diag_data_statics_vtbl =
+{
+    diag_data_statics_QueryInterface,
+    diag_data_statics_AddRef,
+    diag_data_statics_Release,
+    diag_data_statics_GetIids,
+    diag_data_statics_GetRuntimeClassName,
+    diag_data_statics_GetTrustLevel,
+    diag_data_statics_get_CollectionLevel,
+    diag_data_statics_add_CollectionLevelChanged,
+    diag_data_statics_remove_CollectionLevelChanged,
+    diag_data_statics_CanCollectDiagnostics,
+};
+
+static struct diag_data_factory diag_data_factory = { {&diag_data_factory_vtbl}, {&diag_data_statics_vtbl} };
+IActivationFactory *diag_data_settings_factory = &diag_data_factory.IActivationFactory_iface;
+
+/* Windows.System.Profile.EducationSettings: not a school's managed PC */
+
+DEFINE_FACTORY( education, IEducationSettingsStatics, IID_IEducationSettingsStatics );
+
+static HRESULT WINAPI education_statics_get_IsEducationEnvironment( IEducationSettingsStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct IEducationSettingsStaticsVtbl education_statics_vtbl =
+{
+    education_statics_QueryInterface,
+    education_statics_AddRef,
+    education_statics_Release,
+    education_statics_GetIids,
+    education_statics_GetRuntimeClassName,
+    education_statics_GetTrustLevel,
+    education_statics_get_IsEducationEnvironment,
+};
+
+static struct education_factory education_factory = { {&education_factory_vtbl}, {&education_statics_vtbl} };
+IActivationFactory *education_settings_factory = &education_factory.IActivationFactory_iface;
+
+/* the per-user settings objects: one static object each, the same answer
+ * for every user */
+
+static HRESULT WINAPI settings_object_QueryInterface( IInspectable *iface, REFIID iid, void **out, REFIID own )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, own ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* Windows.System.UserProfile.AssignedAccessSettings: not a kiosk */
+
+static HRESULT WINAPI assigned_access_QueryInterface( IAssignedAccessSettings *iface, REFIID iid, void **out )
+{
+    return settings_object_QueryInterface( (IInspectable *)iface, iid, out, &IID_IAssignedAccessSettings );
+}
+static ULONG WINAPI assigned_access_AddRef( IAssignedAccessSettings *iface ) { return 2; }
+static ULONG WINAPI assigned_access_Release( IAssignedAccessSettings *iface ) { return 1; }
+static HRESULT WINAPI assigned_access_GetIids( IAssignedAccessSettings *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI assigned_access_GetRuntimeClassName( IAssignedAccessSettings *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_System_UserProfile_AssignedAccessSettings,
+                                wcslen( RuntimeClass_Windows_System_UserProfile_AssignedAccessSettings ), name );
+}
+static HRESULT WINAPI assigned_access_GetTrustLevel( IAssignedAccessSettings *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI assigned_access_get_IsEnabled( IAssignedAccessSettings *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI assigned_access_get_IsSingleAppKioskMode( IAssignedAccessSettings *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI assigned_access_get_User( IAssignedAccessSettings *iface, __x_ABI_CWindows_CSystem_CIUser **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IAssignedAccessSettingsVtbl assigned_access_vtbl =
+{
+    assigned_access_QueryInterface,
+    assigned_access_AddRef,
+    assigned_access_Release,
+    assigned_access_GetIids,
+    assigned_access_GetRuntimeClassName,
+    assigned_access_GetTrustLevel,
+    assigned_access_get_IsEnabled,
+    assigned_access_get_IsSingleAppKioskMode,
+    assigned_access_get_User,
+};
+static IAssignedAccessSettings assigned_access = { &assigned_access_vtbl };
+
+DEFINE_FACTORY( assigned, IAssignedAccessSettingsStatics, IID_IAssignedAccessSettingsStatics );
+
+static HRESULT WINAPI assigned_statics_GetDefault( IAssignedAccessSettingsStatics *iface, IAssignedAccessSettings **result )
+{
+    TRACE( "iface %p, result %p.\n", iface, result );
+    if (!result) return E_POINTER;
+    *result = &assigned_access;
+    return S_OK;
+}
+static HRESULT WINAPI assigned_statics_GetForUser( IAssignedAccessSettingsStatics *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                   IAssignedAccessSettings **result )
+{
+    TRACE( "iface %p, user %p, result %p.\n", iface, user, result );
+    if (!result) return E_POINTER;
+    *result = &assigned_access;
+    return S_OK;
+}
+
+static const struct IAssignedAccessSettingsStaticsVtbl assigned_statics_vtbl =
+{
+    assigned_statics_QueryInterface,
+    assigned_statics_AddRef,
+    assigned_statics_Release,
+    assigned_statics_GetIids,
+    assigned_statics_GetRuntimeClassName,
+    assigned_statics_GetTrustLevel,
+    assigned_statics_GetDefault,
+    assigned_statics_GetForUser,
+};
+
+static struct assigned_factory assigned_factory = { {&assigned_factory_vtbl}, {&assigned_statics_vtbl} };
+IActivationFactory *assigned_access_settings_factory = &assigned_factory.IActivationFactory_iface;
+
+/* Windows.System.UserProfile.DiagnosticsSettings: tailored experiences only
+ * when the user turned them on and optional diagnostic data is sent */
+
+static HRESULT WINAPI user_diag_QueryInterface( IDiagnosticsSettings *iface, REFIID iid, void **out )
+{
+    return settings_object_QueryInterface( (IInspectable *)iface, iid, out, &IID_IDiagnosticsSettings );
+}
+static ULONG WINAPI user_diag_AddRef( IDiagnosticsSettings *iface ) { return 2; }
+static ULONG WINAPI user_diag_Release( IDiagnosticsSettings *iface ) { return 1; }
+static HRESULT WINAPI user_diag_GetIids( IDiagnosticsSettings *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI user_diag_GetRuntimeClassName( IDiagnosticsSettings *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_System_UserProfile_DiagnosticsSettings,
+                                wcslen( RuntimeClass_Windows_System_UserProfile_DiagnosticsSettings ), name );
+}
+static HRESULT WINAPI user_diag_GetTrustLevel( IDiagnosticsSettings *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI user_diag_get_CanUseDiagnosticsToTailorExperiences( IDiagnosticsSettings *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = reg_dword( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Privacy",
+                        L"TailoredExperiencesWithDiagnosticDataEnabled", 0 ) == 1 &&
+             !reg_dword( HKEY_CURRENT_USER, L"Software\\Policies\\Microsoft\\Windows\\CloudContent",
+                         L"DisableTailoredExperiencesWithDiagnosticData", 0 ) &&
+             collection_level() >= PlatformDataCollectionLevel_Full;
+    return S_OK;
+}
+static HRESULT WINAPI user_diag_get_User( IDiagnosticsSettings *iface, __x_ABI_CWindows_CSystem_CIUser **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
