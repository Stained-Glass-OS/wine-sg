From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cryptext: CryptExtAddPFX opens the certificate import wizard

cryptext: CryptExtAddPFX and CryptExtAddPFXW open the certificate import wizard

The shell handler for .pfx files runs the import wizard (CryptUIWizImport) on
the file; the ANSI form converts the name and forwards.
---
--- a/dlls/cryptext/Makefile.in
+++ b/dlls/cryptext/Makefile.in
@@ -1,4 +1,5 @@
 MODULE = cryptext.dll
+IMPORTS = cryptui
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
--- a/dlls/cryptext/cryptext_main.c
+++ b/dlls/cryptext/cryptext_main.c
@@ -22,24 +22,63 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winerror.h"
+#include "winnls.h"
+#include "winuser.h"
+#include "wincrypt.h"
+#include "cryptuiapi.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(cryptext);
 
 /***********************************************************************
- * CryptExtAddPFX (CRYPTEXT.@)
+ * CryptExtAddPFXW (CRYPTEXT.@)
+ *
+ * The shell's handler for importing a .pfx file: the Certificate Import Wizard
+ * on that file.
  */
-HRESULT WINAPI CryptExtAddPFX(LPCSTR filename)
+HRESULT WINAPI CryptExtAddPFXW(LPCWSTR filename)
 {
-    FIXME("stub: %s\n", debugstr_a(filename));
+    CRYPTUI_WIZ_IMPORT_SRC_INFO src;
+    DWORD err;
+
+    TRACE("(%s)\n", debugstr_w(filename));
+#ifdef SG_MUTANT_PFX_STUB
     return E_NOTIMPL;
+#endif
+
+    memset(&src, 0, sizeof(src));
+    src.dwSize = sizeof(src);
+    src.dwSubjectChoice = CRYPTUI_WIZ_IMPORT_SUBJECT_FILE;
+#ifndef SG_MUTANT_PFX_NOFILE
+    src.pwszFileName = filename;
+#endif
+    SetLastError(ERROR_SUCCESS);
+    if (CryptUIWizImport(0, NULL, NULL, &src, NULL)) return S_OK;
+    err = GetLastError();
+    return err ? HRESULT_FROM_WIN32(err) : E_FAIL;
 }
 
 /***********************************************************************
- * CryptExtAddPFXW (CRYPTEXT.@)
+ * CryptExtAddPFX (CRYPTEXT.@)
  */
-HRESULT WINAPI CryptExtAddPFXW(LPCWSTR filename)
+HRESULT WINAPI CryptExtAddPFX(LPCSTR filename)
 {
-    FIXME("stub: %s\n", debugstr_w(filename));
-    return E_NOTIMPL;
+    WCHAR *nameW = NULL;
+    HRESULT hr;
+    int len;
+
+    TRACE("(%s)\n", debugstr_a(filename));
+
+    if (filename)
+    {
+        if (!(len = MultiByteToWideChar(CP_ACP, MB_ERR_INVALID_CHARS, filename, -1, NULL, 0)))
+            return HRESULT_FROM_WIN32(GetLastError());
+        if (!(nameW = HeapAlloc(GetProcessHeap(), 0, len * sizeof(WCHAR))))
+            return E_OUTOFMEMORY;
+        MultiByteToWideChar(CP_ACP, 0, filename, -1, nameW, len);
+    }
+    hr = CryptExtAddPFXW(nameW);
+    HeapFree(GetProcessHeap(), 0, nameW);
+    return hr;
 }
--- a/dlls/cryptui/tests/cryptui.c
+++ b/dlls/cryptui/tests/cryptui.c
@@ -25,6 +25,7 @@
 #include <winuser.h>
 #include <wincrypt.h>
 #include <cryptuiapi.h>
+#include <prsht.h>
 
 #include "wine/test.h"
 
@@ -642,6 +643,116 @@ static void test_crypt_ui_wiz_import(void)
     UnhookWindowsHookEx(hook);
 }
 
+struct add_pfx_params
+{
+    HRESULT (WINAPI *func)(const void *);
+    const void *name;
+    HRESULT hr;
+};
+
+static DWORD WINAPI add_pfx_thread(void *arg)
+{
+    struct add_pfx_params *params = arg;
+
+    params->hr = params->func(params->name);
+    return 0;
+}
+
+struct find_wizard
+{
+    HWND sheet;
+    HWND edit;
+};
+
+static BOOL CALLBACK find_wizard_proc(HWND hwnd, LPARAM lp)
+{
+    struct find_wizard *found = (struct find_wizard *)lp;
+
+    if (IsWindowVisible(hwnd)) found->sheet = hwnd;
+    return TRUE;
+}
+
+static BOOL CALLBACK find_filename_proc(HWND hwnd, LPARAM lp)
+{
+    struct find_wizard *found = (struct find_wizard *)lp;
+
+    if (GetDlgCtrlID(hwnd) == 2701 /* the file name box */) found->edit = hwnd;
+    return TRUE;
+}
+
+static void run_add_pfx(const char *name, HRESULT (WINAPI *func)(const void *), const void *arg,
+        const WCHAR *expect, const char *what)
+{
+    struct add_pfx_params params;
+    struct find_wizard found = { 0 };
+    DWORD tid, i;
+    HANDLE thread;
+    WCHAR text[MAX_PATH];
+
+    params.func = func;
+    params.name = arg;
+    params.hr = 0xdeadbeef;
+    thread = CreateThread(NULL, 0, add_pfx_thread, &params, 0, &tid);
+    ok(!!thread, "%s: CreateThread failed: %lu\n", what, GetLastError());
+
+    for (i = 0; i < 200 && !found.sheet; i++)
+    {
+        EnumThreadWindows(tid, find_wizard_proc, (LPARAM)&found);
+        if (!found.sheet) Sleep(100);
+    }
+    ok(!!found.sheet, "%s: the import wizard did not appear\n", what);
+    if (found.sheet)
+    {
+        /* the welcome page, then the page with the file */
+        PostMessageW(found.sheet, PSM_PRESSBUTTON, PSBTN_NEXT, 0);
+        for (i = 0; i < 100 && !found.edit; i++)
+        {
+            EnumChildWindows(found.sheet, find_filename_proc, (LPARAM)&found);
+            if (found.edit && !IsWindowVisible(found.edit)) found.edit = NULL;
+            if (!found.edit) Sleep(100);
+        }
+        ok(!!found.edit, "%s: no file name box\n", what);
+        if (found.edit)
+        {
+            memset(text, 0, sizeof(text));
+            SendMessageW(found.edit, WM_GETTEXT, ARRAY_SIZE(text), (LPARAM)text);
+            ok(!lstrcmpiW(text, expect), "%s: got file name %s\n", what, wine_dbgstr_w(text));
+        }
+        PostMessageW(found.sheet, PSM_PRESSBUTTON, PSBTN_CANCEL, 0);
+    }
+    ok(WaitForSingleObject(thread, found.sheet ? 20000 : 0) == WAIT_OBJECT_0, "%s: the wizard did not end\n", what);
+    if (found.sheet) ok(params.hr == S_OK, "%s: got %#lx\n", what, params.hr);
+    CloseHandle(thread);
+}
+
+static void test_cryptext_add_pfx(void)
+{
+    static const WCHAR pathW[] = L"C:\\nonexistent\\wine test.pfx";
+    static const char pathA[] = "C:\\nonexistent\\wine test.pfx";
+    HRESULT (WINAPI *pCryptExtAddPFXW)(const void *);
+    HRESULT (WINAPI *pCryptExtAddPFX)(const void *);
+    HMODULE lib = LoadLibraryA("cryptext");
+
+    if (!lib)
+    {
+        win_skip("cryptext.dll not available\n");
+        return;
+    }
+    pCryptExtAddPFXW = (void *)GetProcAddress(lib, "CryptExtAddPFXW");
+    pCryptExtAddPFX = (void *)GetProcAddress(lib, "CryptExtAddPFX");
+    if (!pCryptExtAddPFXW || !pCryptExtAddPFX)
+    {
+        win_skip("CryptExtAddPFX not exported\n");
+        FreeLibrary(lib);
+        return;
+    }
+
+    /* each form opens the import wizard on the file */
+    run_add_pfx("W", pCryptExtAddPFXW, pathW, pathW, "CryptExtAddPFXW");
+    run_add_pfx("A", pCryptExtAddPFX, pathA, pathW, "CryptExtAddPFX");
+    FreeLibrary(lib);
+}
+
 START_TEST(cryptui)
 {
     HMODULE lib = LoadLibraryA("cryptui");
@@ -653,4 +764,5 @@ START_TEST(cryptui)
         test_crypt_ui_wiz_import();
         FreeLibrary(lib);
     }
+    test_cryptext_add_pfx();
 }
