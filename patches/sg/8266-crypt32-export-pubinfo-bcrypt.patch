From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptExportPublicKeyInfoFromBCryptKeyHandle

CryptExportPublicKeyInfoFromBCryptKeyHandle gives the CERT_PUBLIC_KEY_INFO of a CNG key: an RSA key as its RSA_CSP_PUBLICKEYBLOB encoding under szOID_RSA_RSA with NULL parameters, a NIST P-256/384/521 key as its uncompressed point under szOID_ECC_PUBLIC_KEY with the curve's OID as the parameters; a given OID names the algorithm instead. It was not exported. wincrypt.h gains it.
---
--- a/include/wincrypt.h
+++ b/include/wincrypt.h
@@ -4547,6 +4547,7 @@
 WINCRYPT32API BOOL WINAPI CryptExportPublicKeyInfoEx(HCRYPTPROV_OR_NCRYPT_KEY_HANDLE hCryptProv, DWORD dwKeySpec,
  DWORD dwCertEncodingType, LPSTR pszPublicKeyObjId, DWORD dwFlags,
  void *pvAuxInfo, PCERT_PUBLIC_KEY_INFO pInfo, DWORD *pcbInfo);
+WINCRYPT32API BOOL WINAPI CryptExportPublicKeyInfoFromBCryptKeyHandle(BCRYPT_KEY_HANDLE,DWORD,LPSTR,DWORD,void*,PCERT_PUBLIC_KEY_INFO,DWORD*);
 WINCRYPT32API BOOL WINAPI CryptImportPublicKeyInfo(HCRYPTPROV hCryptProv,
  DWORD dwCertEncodingType, PCERT_PUBLIC_KEY_INFO pInfo, HCRYPTKEY *phKey);
 WINCRYPT32API BOOL WINAPI CryptImportPublicKeyInfoEx(HCRYPTPROV hCryptProv,
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -5806,6 +5806,162 @@
     return ret;
 }
 
+#ifndef SG_MUTANT_NO_BCRYPT_PUBINFO
+/* (wine-sg 8266) The public key info of a CNG key: an RSA key as RSA_CSP_PUBLICKEYBLOB under szOID_RSA_RSA
+ * (NULL parameters), an elliptic curve key as the uncompressed point under szOID_ECC_PUBLIC_KEY with its
+ * curve's OID as the parameters; a given OID names the algorithm instead. */
+BOOL WINAPI CryptExportPublicKeyInfoFromBCryptKeyHandle(BCRYPT_KEY_HANDLE key, DWORD encoding, LPSTR oid,
+        DWORD flags, void *aux, PCERT_PUBLIC_KEY_INFO info, DWORD *size)
+{
+    static const BYTE null_params[] = { 0x05, 0x00 };
+    WCHAR alg[64] = L"";
+    BYTE *blob = NULL, *bits = NULL, *params = NULL;
+    DWORD bits_len = 0, params_len = 0, len, needed;
+    const char *alg_oid = NULL, *curve_oid = NULL;
+    BOOL ret = FALSE;
+    ULONG got;
+
+    TRACE_(crypt)("(%p, %#lx, %s, %#lx, %p, %p, %p)\n", key, encoding, debugstr_a(oid), flags, aux, info, size);
+
+    if (!key || !size)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    /* the key's kind from the magic of the public blob it exports */
+    {
+        BYTE probe[1024];
+
+        if (!BCryptExportKey(key, NULL, BCRYPT_RSAPUBLIC_BLOB, probe, sizeof(probe), &got, 0) && got >= sizeof(ULONG) &&
+            *(ULONG *)probe == BCRYPT_RSAPUBLIC_MAGIC)
+            wcscpy(alg, BCRYPT_RSA_ALGORITHM);
+        else if (!BCryptExportKey(key, NULL, BCRYPT_ECCPUBLIC_BLOB, probe, sizeof(probe), &got, 0) && got >= sizeof(ULONG))
+        {
+            switch (*(ULONG *)probe)
+            {
+            case BCRYPT_ECDSA_PUBLIC_P256_MAGIC: case BCRYPT_ECDSA_PUBLIC_P384_MAGIC: case BCRYPT_ECDSA_PUBLIC_P521_MAGIC:
+            case BCRYPT_ECDH_PUBLIC_P256_MAGIC: case BCRYPT_ECDH_PUBLIC_P384_MAGIC: case BCRYPT_ECDH_PUBLIC_P521_MAGIC:
+            case 0x50444345 /* ECDSA generic */: case BCRYPT_ECDH_PUBLIC_GENERIC_MAGIC:
+                wcscpy(alg, L"ECDSA");
+                break;
+            }
+        }
+    }
+    if (!wcscmp(alg, BCRYPT_RSA_ALGORITHM))
+    {
+        BCRYPT_RSAKEY_BLOB *rsa;
+        struct { BLOBHEADER hdr; RSAPUBKEY rsa; } *capi;
+        BYTE *modulus;
+        DWORD i, exp = 0;
+
+        if (BCryptExportKey(key, NULL, BCRYPT_RSAPUBLIC_BLOB, NULL, 0, &got, 0) || !(blob = malloc(got)) ||
+            BCryptExportKey(key, NULL, BCRYPT_RSAPUBLIC_BLOB, blob, got, &got, 0))
+        {
+            SetLastError(NTE_BAD_KEY);
+            goto done;
+        }
+        rsa = (BCRYPT_RSAKEY_BLOB *)blob;
+        for (i = 0; i < rsa->cbPublicExp && i < 4; i++) exp = (exp << 8) | blob[sizeof(*rsa) + i];
+        len = sizeof(*capi) + rsa->cbModulus;
+        if (!(capi = malloc(len))) goto done;
+        capi->hdr.bType = PUBLICKEYBLOB;
+        capi->hdr.bVersion = CUR_BLOB_VERSION;
+        capi->hdr.reserved = 0;
+        capi->hdr.aiKeyAlg = CALG_RSA_KEYX;
+        capi->rsa.magic = 0x31415352; /* RSA1 */
+        capi->rsa.bitlen = rsa->BitLength;
+        capi->rsa.pubexp = exp;
+        modulus = blob + sizeof(*rsa) + rsa->cbPublicExp;
+        for (i = 0; i < rsa->cbModulus; i++) ((BYTE *)(capi + 1))[i] = modulus[rsa->cbModulus - 1 - i];
+        ret = CryptEncodeObjectEx(encoding, RSA_CSP_PUBLICKEYBLOB, capi, CRYPT_ENCODE_ALLOC_FLAG, NULL, &bits, &bits_len);
+        free(capi);
+        if (!ret) goto done;
+        ret = FALSE;
+        alg_oid = szOID_RSA_RSA;
+        params = (BYTE *)null_params;
+        params_len = sizeof(null_params);
+    }
+    else if (!wcsncmp(alg, L"ECDSA", 5) || !wcsncmp(alg, L"ECDH", 4))
+    {
+        BCRYPT_ECCKEY_BLOB *ecc;
+
+        if (BCryptExportKey(key, NULL, BCRYPT_ECCPUBLIC_BLOB, NULL, 0, &got, 0) || !(blob = malloc(got)) ||
+            BCryptExportKey(key, NULL, BCRYPT_ECCPUBLIC_BLOB, blob, got, &got, 0))
+        {
+            SetLastError(NTE_BAD_KEY);
+            goto done;
+        }
+        ecc = (BCRYPT_ECCKEY_BLOB *)blob;
+        /* the NIST curves by their coordinate size */
+        if (ecc->cbKey == 32) curve_oid = szOID_ECC_CURVE_P256;
+        else if (ecc->cbKey == 48) curve_oid = szOID_ECC_CURVE_P384;
+        else if (ecc->cbKey == 66) curve_oid = szOID_ECC_CURVE_P521;
+        else
+        {
+            SetLastError(NTE_BAD_KEY);
+            goto done;
+        }
+        bits_len = 1 + 2 * ecc->cbKey;
+        if (!(bits = LocalAlloc(LMEM_FIXED, bits_len))) goto done;
+        bits[0] = 0x04; /* uncompressed point */
+        memcpy(bits + 1, ecc + 1, 2 * ecc->cbKey);
+        if (!CryptEncodeObjectEx(encoding, X509_OBJECT_IDENTIFIER, &curve_oid, CRYPT_ENCODE_ALLOC_FLAG, NULL,
+                                 &params, &params_len))
+            goto done;
+        alg_oid = szOID_ECC_PUBLIC_KEY;
+    }
+    else
+    {
+        SetLastError(NTE_BAD_ALGID);
+        goto done;
+    }
+    if (oid) alg_oid = oid;
+
+    needed = sizeof(*info) + strlen(alg_oid) + 1 + params_len + bits_len;
+    if (!info)
+    {
+        *size = needed;
+        ret = TRUE;
+    }
+    else if (*size < needed)
+    {
+        *size = needed;
+        SetLastError(ERROR_MORE_DATA);
+    }
+    else
+    {
+        BYTE *p = (BYTE *)(info + 1);
+
+        *size = needed;
+        info->Algorithm.pszObjId = (char *)p;
+        strcpy((char *)p, alg_oid);
+        p += strlen(alg_oid) + 1;
+        info->Algorithm.Parameters.cbData = params_len;
+        info->Algorithm.Parameters.pbData = p;
+        memcpy(p, params, params_len);
+        p += params_len;
+        info->PublicKey.cbData = bits_len;
+        info->PublicKey.pbData = p;
+        info->PublicKey.cUnusedBits = 0;
+        memcpy(p, bits, bits_len);
+        ret = TRUE;
+    }
+
+done:
+    free(blob);
+    if (bits) LocalFree(bits);
+    if (params && params != null_params) LocalFree(params);
+    return ret;
+}
+#else
+BOOL WINAPI CryptExportPublicKeyInfoFromBCryptKeyHandle(BCRYPT_KEY_HANDLE key, DWORD encoding, LPSTR oid,
+        DWORD flags, void *aux, PCERT_PUBLIC_KEY_INFO info, DWORD *size)
+{
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
+#endif
+
 BOOL WINAPI CryptImportPublicKeyInfo(HCRYPTPROV hCryptProv,
  DWORD dwCertEncodingType, PCERT_PUBLIC_KEY_INFO pInfo, HCRYPTKEY *phKey)
 {
--- a/dlls/crypt32/crypt32.spec
+++ b/dlls/crypt32/crypt32.spec
@@ -125,6 +125,7 @@
 @ stub CryptExportPKCS8
 @ stdcall CryptExportPublicKeyInfo(long long long ptr ptr)
 @ stdcall CryptExportPublicKeyInfoEx(long long long str long ptr ptr ptr)
+@ stdcall CryptExportPublicKeyInfoFromBCryptKeyHandle(ptr long str long ptr ptr ptr)
 @ stdcall CryptFindCertificateKeyProvInfo(ptr long ptr)
 @ stdcall CryptFindLocalizedName(wstr)
 @ stdcall CryptFindOIDInfo(long ptr long)
