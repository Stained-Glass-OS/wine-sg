From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: CryptVerifyCertificateSignatureEx chain and hash issuers

crypt32: CryptVerifyCertificateSignatureEx supports what the documentation
says and Wine failed on: CRYPT_VERIFY_CERT_SIGN_ISSUER_CHAIN (the issuer's
key is the first certificate of the first chain of the CERT_CHAIN_CONTEXT),
CRYPT_VERIFY_CERT_SIGN_ISSUER_NULL for a signature algorithm that is a hash
(the signature is the unencrypted hash of the signed part, compared with the
hash; NTE_BAD_SIGNATURE if it differs), E_INVALIDARG for such a signature with
any other issuer type, and CRYPT_VERIFY_CERT_SIGN_DISABLE_MD2_MD4_FLAG (a good
MD2 or MD4 signature is reported as NTE_BAD_ALGID).
---
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -3179,6 +3179,12 @@ static BOOL CRYPT_VerifyCertSignatureFromPublicKeyInfo(HCRYPTPROV_LEGACY hCryptP
     CCRYPT_OID_INFO *info;
 
     info = CryptFindOIDInfo(CRYPT_OID_INFO_OID_KEY, signedCert->SignatureAlgorithm.pszObjId, 0);
+    if (info && info->dwGroupId == CRYPT_HASH_ALG_OID_GROUP_ID)
+    {
+        /* a signature that is only a hash can be verified only with CRYPT_VERIFY_CERT_SIGN_ISSUER_NULL */
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
     if (!info || info->dwGroupId != CRYPT_SIGN_ALG_OID_GROUP_ID)
     {
         SetLastError(NTE_BAD_ALGID);
@@ -3191,6 +3197,37 @@ static BOOL CRYPT_VerifyCertSignatureFromPublicKeyInfo(HCRYPTPROV_LEGACY hCryptP
         return CRYPT_VerifySignature(hCryptProv, dwCertEncodingType, pubKeyInfo, signedCert, info);
 }
 
+/* the signature is only the hash of the signed part: CRYPT_VERIFY_CERT_SIGN_ISSUER_NULL */
+static BOOL CRYPT_VerifyCertSignatureHash(const CERT_SIGNED_CONTENT_INFO *signedCert)
+{
+    const CRYPT_OID_INFO *info;
+    BYTE *hash_value;
+    DWORD hash_len, i;
+    BOOL ret;
+
+    info = CryptFindOIDInfo(CRYPT_OID_INFO_OID_KEY, signedCert->SignatureAlgorithm.pszObjId, CRYPT_HASH_ALG_OID_GROUP_ID);
+    if (!info || !info->pwszCNGAlgid)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    if (!CNG_CalcHash(info->pwszCNGAlgid, signedCert, &hash_value, &hash_len)) return FALSE;
+
+    /* the signature bytes are kept in the reverse order of the encoding */
+    ret = hash_len == signedCert->Signature.cbData;
+#ifdef SG_MUTANT_VERIFY_HASH_ACCEPTS
+    ret = TRUE;
+#else
+    for (i = 0; ret && i < hash_len; i++)
+        ret = hash_value[i] == signedCert->Signature.pbData[hash_len - i - 1];
+#endif
+    if (!ret) SetLastError(NTE_BAD_SIGNATURE);
+    CryptMemFree(hash_value);
+    return ret;
+}
+
+#define CRYPT_VERIFY_CERT_SIGN_DISABLE_MD2_MD4_FLAG_ 0x00000001
+
 BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
  DWORD dwCertEncodingType, DWORD dwSubjectType, void *pvSubject,
  DWORD dwIssuerType, void *pvIssuer, DWORD dwFlags, void *pvReserved)
@@ -3258,9 +3295,24 @@ BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
                  signedCert);
                 break;
             case CRYPT_VERIFY_CERT_SIGN_ISSUER_CHAIN:
-                FIXME("CRYPT_VERIFY_CERT_SIGN_ISSUER_CHAIN: stub\n");
-                ret = FALSE;
+            {
+                PCCERT_CHAIN_CONTEXT chain = pvIssuer;
+
+                /* the issuer is the first certificate of the first chain */
+                if (!chain || chain->cbSize < sizeof(*chain) || !chain->cChain || !chain->rgpChain[0]->cElement)
+                {
+                    SetLastError(E_INVALIDARG);
+                    ret = FALSE;
+                    break;
+                }
+#ifdef SG_MUTANT_VERIFY_CHAIN_ISSUER_ACCEPTS
+                ret = TRUE;
                 break;
+#endif
+                ret = CRYPT_VerifyCertSignatureFromPublicKeyInfo(hCryptProv, dwCertEncodingType,
+                 &chain->rgpChain[0]->rgpElement[0]->pCertContext->pCertInfo->SubjectPublicKeyInfo, signedCert);
+                break;
+            }
             case CRYPT_VERIFY_CERT_SIGN_ISSUER_NULL:
                 if (pvIssuer)
                 {
@@ -3269,15 +3321,28 @@ BOOL WINAPI CryptVerifyCertificateSignatureEx(HCRYPTPROV_LEGACY hCryptProv,
                 }
                 else
                 {
-                    FIXME("unimplemented for NULL signer\n");
-                    SetLastError(E_INVALIDARG);
-                    ret = FALSE;
+                    ret = CRYPT_VerifyCertSignatureHash(signedCert);
                 }
                 break;
             default:
                 SetLastError(E_INVALIDARG);
                 ret = FALSE;
             }
+            /* with the flag, a signature made with MD2 or MD4 is verified but reported as bad algorithm,
+             * for the caller to decide */
+            if (ret && (dwFlags & CRYPT_VERIFY_CERT_SIGN_DISABLE_MD2_MD4_FLAG_))
+            {
+                const CRYPT_OID_INFO *info = CryptFindOIDInfo(CRYPT_OID_INFO_OID_KEY,
+                 signedCert->SignatureAlgorithm.pszObjId, 0);
+
+#ifndef SG_MUTANT_VERIFY_MD2_MD4_ALLOWED
+                if (info && (info->Algid == CALG_MD2 || info->Algid == CALG_MD4))
+                {
+                    SetLastError(NTE_BAD_ALGID);
+                    ret = FALSE;
+                }
+#endif
+            }
             LocalFree(signedCert);
         }
     }
--- a/dlls/crypt32/tests/cert.c
+++ b/dlls/crypt32/tests/cert.c
@@ -2156,6 +2156,102 @@ static const BYTE self_signed_ecc_prime256v1[] = {
 0x26,0xfd,0x2a,0x3c,0x4e,0x08,0x55,0x09,0x35,0x40,0x7c,0xf8,0xf9,0x1b,0x22,0x55,
 0x08,0x9b,0x3f,0x37,0x29, };
 
+static BYTE *encode_signed_cert(HCRYPTPROV csp, const CRYPT_DATA_BLOB *toBeSigned, LPSTR sigOID, DWORD *size)
+{
+    CERT_SIGNED_CONTENT_INFO info = { { 0 } };
+    CRYPT_ALGORITHM_IDENTIFIER algo = { sigOID, { 0, NULL } };
+    BYTE sig[256], *cert = NULL;
+    DWORD sig_size = sizeof(sig);
+    BOOL ret;
+
+    ret = CryptSignCertificate(csp, AT_SIGNATURE, 0, toBeSigned->pbData, toBeSigned->cbData, &algo, NULL,
+            sig, &sig_size);
+    ok(ret, "CryptSignCertificate failed: %08lx\n", GetLastError());
+    info.ToBeSigned = *toBeSigned;
+    info.SignatureAlgorithm.pszObjId = sigOID;
+    info.Signature.cbData = sig_size;
+    info.Signature.pbData = sig;
+    ret = CryptEncodeObjectEx(X509_ASN_ENCODING, X509_CERT, &info, CRYPT_ENCODE_ALLOC_FLAG, NULL, &cert, size);
+    ok(ret, "CryptEncodeObjectEx failed: %08lx\n", GetLastError());
+    return cert;
+}
+
+static void testVerifyCertSigExMore(HCRYPTPROV csp, const CRYPT_DATA_BLOB *toBeSigned)
+{
+    static char md2rsa[] = szOID_RSA_MD2RSA;
+    static char sha1rsa[] = szOID_RSA_SHA1RSA;
+    CERT_PUBLIC_KEY_INFO *pub_key = NULL;
+    CRYPT_DATA_BLOB cert_blob;
+    BYTE *cert;
+    DWORD size;
+    BOOL ret;
+
+    CryptExportPublicKeyInfoEx(csp, AT_SIGNATURE, X509_ASN_ENCODING, sha1rsa, 0, NULL, NULL, &size);
+    pub_key = malloc(size);
+    ret = CryptExportPublicKeyInfoEx(csp, AT_SIGNATURE, X509_ASN_ENCODING, sha1rsa, 0, NULL, pub_key, &size);
+    ok(ret, "CryptExportPublicKeyInfoEx failed: %08lx\n", GetLastError());
+
+    /* the issuer given as a chain: its first certificate's key */
+    {
+        CERT_INFO issuer_info = { 0 }, other_info = { 0 };
+        CERT_CONTEXT issuer = { X509_ASN_ENCODING, NULL, 0, &issuer_info };
+        CERT_CONTEXT other = { X509_ASN_ENCODING, NULL, 0, &other_info };
+        CERT_CHAIN_ELEMENT element = { sizeof(element), &issuer };
+        PCERT_CHAIN_ELEMENT elements[1] = { &element };
+        CERT_SIMPLE_CHAIN simple = { sizeof(simple), { 0 }, 1, elements };
+        PCERT_SIMPLE_CHAIN simples[1] = { &simple };
+        CERT_CHAIN_CONTEXT chain = { sizeof(chain), { 0 }, 1, simples };
+
+        issuer_info.SubjectPublicKeyInfo = *pub_key;
+        other_info.SubjectPublicKeyInfo = *pub_key;
+        other_info.SubjectPublicKeyInfo.PublicKey.pbData = calloc(1, pub_key->PublicKey.cbData);
+
+        cert = encode_signed_cert(csp, toBeSigned, sha1rsa, &size);
+        cert_blob.cbData = size;
+        cert_blob.pbData = cert;
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+                &cert_blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_CHAIN, &chain, 0, NULL);
+        ok(ret, "CryptVerifyCertificateSignatureEx failed: %08lx\n", GetLastError());
+
+        element.pCertContext = &other;
+        SetLastError(0xdeadbeef);
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+                &cert_blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_CHAIN, &chain, 0, NULL);
+        ok(!ret, "succeeded.\n");
+        free(other_info.SubjectPublicKeyInfo.PublicKey.pbData);
+        LocalFree(cert);
+
+        element.pCertContext = &issuer;
+        simple.cElement = 0;
+        SetLastError(0xdeadbeef);
+        ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+                &cert_blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_CHAIN, &chain, 0, NULL);
+        ok(!ret && GetLastError() == E_INVALIDARG, "got ret %d, error %#lx.\n", ret, GetLastError());
+    }
+
+    /* CRYPT_VERIFY_CERT_SIGN_DISABLE_MD2_MD4_FLAG: the signature is good, but the algorithm is rejected */
+    cert = encode_signed_cert(csp, toBeSigned, md2rsa, &size);
+    cert_blob.cbData = size;
+    cert_blob.pbData = cert;
+    ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+            &cert_blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 0, NULL);
+    ok(ret, "CryptVerifyCertificateSignatureEx failed: %08lx\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+            &cert_blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 1 /* ..._DISABLE_MD2_MD4_FLAG */, NULL);
+    ok(!ret && GetLastError() == NTE_BAD_ALGID, "got ret %d, error %#lx.\n", ret, GetLastError());
+    LocalFree(cert);
+
+    cert = encode_signed_cert(csp, toBeSigned, sha1rsa, &size);
+    cert_blob.cbData = size;
+    cert_blob.pbData = cert;
+    ret = CryptVerifyCertificateSignatureEx(csp, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+            &cert_blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, pub_key, 1, NULL);
+    ok(ret, "CryptVerifyCertificateSignatureEx failed: %08lx\n", GetLastError());
+    LocalFree(cert);
+    free(pub_key);
+}
+
 static void testCertSigs(void)
 {
     HCRYPTPROV csp;
@@ -2175,6 +2271,7 @@ static void testCertSigs(void)
     testSignCert(csp, &toBeSigned, szOID_RSA_SHA1RSA, sig, &sigSize);
     testVerifyCertSig(csp, &toBeSigned, szOID_RSA_SHA1RSA, sig, sigSize);
     testVerifyCertSigEx(csp, &toBeSigned, szOID_RSA_SHA1RSA, sig, sigSize);
+    testVerifyCertSigExMore(csp, &toBeSigned);
 
     CryptReleaseContext(csp, 0);
     ret = CryptAcquireContextA(&csp, cspNameA, MS_DEF_PROV_A, PROV_RSA_FULL,
@@ -2282,6 +2379,34 @@ static void testSignAndEncodeCert(void)
     }
 }
 
+static void testVerifyHashSignature(void)
+{
+    CRYPT_DATA_BLOB blob = { sizeof(md5SignedEmptyCert), (BYTE *)md5SignedEmptyCert };
+    CERT_PUBLIC_KEY_INFO key_info = { { (char *)szOID_RSA_RSA } };
+    BYTE bad[sizeof(md5SignedEmptyCert)];
+    BOOL ret;
+
+    /* a signature that is only the MD5 of the signed part, verified without a key */
+    ret = CryptVerifyCertificateSignatureEx(0, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+            &blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_NULL, NULL, 0, NULL);
+    ok(ret, "CryptVerifyCertificateSignatureEx failed: %08lx\n", GetLastError());
+
+    memcpy(bad, md5SignedEmptyCert, sizeof(bad));
+    bad[sizeof(bad) - 1] ^= 1;
+    blob.pbData = bad;
+    SetLastError(0xdeadbeef);
+    ret = CryptVerifyCertificateSignatureEx(0, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+            &blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_NULL, NULL, 0, NULL);
+    ok(!ret && GetLastError() == NTE_BAD_SIGNATURE, "got ret %d, error %#lx.\n", ret, GetLastError());
+
+    /* any other issuer type is an error for such a signature */
+    blob.pbData = (BYTE *)md5SignedEmptyCert;
+    SetLastError(0xdeadbeef);
+    ret = CryptVerifyCertificateSignatureEx(0, X509_ASN_ENCODING, CRYPT_VERIFY_CERT_SIGN_SUBJECT_BLOB,
+            &blob, CRYPT_VERIFY_CERT_SIGN_ISSUER_PUBKEY, &key_info, 0, NULL);
+    ok(!ret && GetLastError() == E_INVALIDARG, "got ret %d, error %#lx.\n", ret, GetLastError());
+}
+
 static void testCreateSelfSignCert(void)
 {
     PCCERT_CONTEXT context;
@@ -4600,6 +4725,7 @@ START_TEST(cert)
     testCryptHashCert2();
     testCertSigs();
     testSignAndEncodeCert();
+    testVerifyHashSignature();
     testCreateSelfSignCert();
     testIntendedKeyUsage();
     testKeyUsage();
