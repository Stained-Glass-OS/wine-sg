@@ -3695,11 +3714,44 @@ HRESULT WINAPI CoResumeClassObjects(void)
 /***********************************************************************
  *           CoRegisterSurrogate    (combase.@)
  */
+static ISurrogate *registered_surrogate;
+static CRITICAL_SECTION surrogate_cs;
+static CRITICAL_SECTION_DEBUG surrogate_cs_debug =
+{
+    0, 0, &surrogate_cs,
+    { &surrogate_cs_debug.ProcessLocksList, &surrogate_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": surrogate_cs") }
+};
+static CRITICAL_SECTION surrogate_cs = { &surrogate_cs_debug, -1, 0, 0, 0, 0 };
+
 HRESULT WINAPI CoRegisterSurrogate(ISurrogate *surrogate)
 {
-    FIXME("%p stub\n", surrogate);
+    ISurrogate *old;
 
-    return E_NOTIMPL;
+    TRACE("%p\n", surrogate);
+
+    if (!surrogate) return E_INVALIDARG;
+
+    /* COM keeps the surrogate of the process (a global interface pointer) and calls it to load and to free
+     * the DLL servers; a surrogate that registers again replaces the first */
+    ISurrogate_AddRef(surrogate);
+    EnterCriticalSection(&surrogate_cs);
+    old = registered_surrogate;
+    registered_surrogate = surrogate;
+    LeaveCriticalSection(&surrogate_cs);
+    if (old) ISurrogate_Release(old);
+    return S_OK;
+}
+
+/* the surrogate of the process, if it registered one: with a reference */
+ISurrogate *com_get_registered_surrogate(void)
+{
+    ISurrogate *ret;
+
+    EnterCriticalSection(&surrogate_cs);
+    if ((ret = registered_surrogate)) ISurrogate_AddRef(ret);
+    LeaveCriticalSection(&surrogate_cs);
+    return ret;
 }
 
