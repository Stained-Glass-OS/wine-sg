     return S_OK;
 }
 
+/* The calls this process makes to its own apartments, for CoGetCallerTID: the callee finds who called by the
+ * causality id the call carries (a logical thread makes one call at a time; a call it is served meanwhile
+ * pushes its own entry on top).  A call that has no entry comes from another process. */
+struct caller_entry
+{
+    struct list entry;
+    GUID        cid;
+    DWORD       tid;   /* the calling thread when it is in an STA, 0 in the MTA */
+};
+static struct list callers = LIST_INIT(callers);
+static CRITICAL_SECTION callers_cs;
+static CRITICAL_SECTION_DEBUG callers_cs_debug =
+{
+    0, 0, &callers_cs,
+    { &callers_cs_debug.ProcessLocksList, &callers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": callers_cs") }
+};
+static CRITICAL_SECTION callers_cs = { &callers_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct caller_entry *caller_push(const GUID *cid, DWORD tid)
+{
+    struct caller_entry *entry = malloc(sizeof(*entry));
+
+    if (!entry) return NULL;
+    entry->cid = *cid;
+    entry->tid = tid;
+    EnterCriticalSection(&callers_cs);
+    list_add_tail(&callers, &entry->entry);
+    LeaveCriticalSection(&callers_cs);
+    return entry;
+}
+
+static void caller_pop(struct caller_entry *entry)
+{
+    if (!entry) return;
+    EnterCriticalSection(&callers_cs);
+    list_remove(&entry->entry);
+    LeaveCriticalSection(&callers_cs);
+    free(entry);
+}
+
+static DWORD caller_lookup(const GUID *cid, DWORD *tid)
+{
+    struct caller_entry *entry;
+    DWORD kind = CALLER_REMOTE;
+
+    *tid = 0;
+    EnterCriticalSection(&callers_cs);
+    LIST_FOR_EACH_ENTRY_REV(entry, &callers, struct caller_entry, entry)
+    {
+        if (!IsEqualGUID(&entry->cid, cid)) continue;
+        kind = CALLER_INPROC;
+        *tid = entry->tid;
+        break;
+    }
+    LeaveCriticalSection(&callers_cs);
+    return kind;
+}
+
+/* The call was rejected by the callee's message filter: ask the caller's filter what to do.  TRUE: call again;
+ * FALSE: report the rejection (no filter, or it asked to cancel). */
+static BOOL ClientRpcChannelBuffer_RetryRejected(struct apartment *apt, struct message_state *state, DWORD start_tick)
+{
+    IMessageFilter *filter;
+    DWORD type, wait;
+
+    if (apt->multi_threaded) return FALSE;
+    EnterCriticalSection(&apt->cs);
+    if ((filter = apt->filter)) IMessageFilter_AddRef(filter);
+    LeaveCriticalSection(&apt->cs);
+    if (!filter) return FALSE;
+
+    type = state->params.hr == RPC_E_SERVERCALL_RETRYLATER ? SERVERCALL_RETRYLATER : SERVERCALL_REJECTED;
+    wait = IMessageFilter_RetryRejectedCall(filter, UlongToHandle(state->target_tid), GetTickCount() - start_tick, type);
+    IMessageFilter_Release(filter);
+    TRACE("RetryRejectedCall(type %lu) returned %ld\n", type, wait);
+    if (wait == ~0u)                                     /* cancel: the call fails as rejected */
+    {
+        state->params.hr = RPC_E_CALL_REJECTED;
+        return FALSE;
+    }
+    if (wait >= 100)
+    {
+        /* wait this long, taking messages, and call again */
+        HANDLE event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        DWORD index;
+
+        if (event)
+        {
+            CoWaitForMultipleHandles(0, wait, 1, &event, &index);
+            CloseHandle(event);
+        }
+    }
+    return TRUE;
+}
