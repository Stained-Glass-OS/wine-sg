+
+        hr = IMetaDataImport2_GetNameFromToken(import, 0x02000003, &utf8);
+        ok(hr == S_OK && !strcmp(utf8, "Derived"), "Got hr %#lx.\n", hr);
+        hr = IMetaDataImport2_IsGlobal(import, 0x02000001, &global);
+        ok(hr == S_OK && global, "Got hr %#lx.\n", hr);
+        hr = IMetaDataImport2_IsGlobal(import, td, &global);
+        ok(hr == S_OK && !global, "Got hr %#lx.\n", hr);
+    }
+    hr = IMetaDataImport2_GetRVA(import, 0x06000003, &rva, &impl);
+    ok(hr == S_OK && rva == 0x2060, "Got hr %#lx, rva %#lx.\n", hr, rva);
+
+    /* assembly */
+    {
+        ASSEMBLYMETADATA amd = { 0 };
+        WCHAR locale[8];
+        const void *key;
+        ULONG keylen, alg;
+
+        hr = IMetaDataAssemblyImport_GetAssemblyFromScope(asm_import, &tk);
+        ok(hr == S_OK && tk == 0x20000001, "Got hr %#lx.\n", hr);
+        amd.szLocale = locale;
+        amd.cbLocale = ARRAY_SIZE(locale);
+        hr = IMetaDataAssemblyImport_GetAssemblyProps(asm_import, tk, &key, &keylen, &alg, name, ARRAY_SIZE(name), &len,
+                                                      &amd, &flags);
+        ok(hr == S_OK && alg == 0x8004 && amd.usMajorVersion == 1 && amd.usRevisionNumber == 4 && !keylen,
+           "Got hr %#lx, alg %#lx.\n", hr, alg);
+        CHECK_STR(name, "Asm");
+        e = NULL;
+        hr = IMetaDataAssemblyImport_EnumAssemblyRefs(asm_import, &e, tokens, ARRAY_SIZE(tokens), &count);
+        ok(hr == S_OK && count == 1 && tokens[0] == 0x23000001, "Got hr %#lx, count %lu.\n", hr, count);
+        IMetaDataAssemblyImport_CloseEnum(asm_import, e);
+        memset(&amd, 0, sizeof(amd));
+        hr = IMetaDataAssemblyImport_GetAssemblyRefProps(asm_import, 0x23000001, &key, &keylen, name, ARRAY_SIZE(name),
+                                                         &len, &amd, NULL, NULL, &flags);
+        ok(hr == S_OK && amd.usMajorVersion == 5 && amd.usRevisionNumber == 8, "Got hr %#lx.\n", hr);
+        CHECK_STR(name, "mscorlib");
+    }
+
+    IMetaDataAssemblyImport_Release(asm_import);
+    IMetaDataImport2_Release(import);
+    IMetaDataDispenser_Release(dispenser);
+    free(md.p);
+    (void)td2; (void)md1;
+}
+
+static void test_real_file(void)
+{
+    WCHAR path[MAX_PATH];
+    IMetaDataDispenser *dispenser;
+    IMetaDataImport2 *import;
+    mdTypeDef tds[64];
+    HCORENUM e = NULL;
+    ULONG count, total = 0;
+    WCHAR name[256];
+    IUnknown *unk;
+    HRESULT hr;
+
+    if (!GetEnvironmentVariableW(L"SG_METADATA_FILE", path, ARRAY_SIZE(path)))
+    {
+        skip("SG_METADATA_FILE not set.\n");
+        return;
+    }
+    hr = MetaDataGetDispenser(&CLSID_CorMetaDataDispenser, &IID_IMetaDataDispenser, (void **)&dispenser);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IMetaDataDispenser_OpenScope(dispenser, path, 0, &IID_IMetaDataImport2, &unk);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr == S_OK)
+    {
+        import = (IMetaDataImport2 *)unk;
+        while ((hr = IMetaDataImport2_EnumTypeDefs(import, &e, tds, ARRAY_SIZE(tds), &count)) == S_OK)
+        {
+            ULONG i;
+            for (i = 0; i < count; i++)
+            {
+                mdMethodDef methods[256];
+                mdToken extends;
+                HCORENUM me = NULL;
+                ULONG mcount;
+                DWORD flags;
+
+                hr = IMetaDataImport2_GetTypeDefProps(import, tds[i], name, ARRAY_SIZE(name), NULL, &flags, &extends);
+                ok(SUCCEEDED(hr), "Got hr %#lx for %#x.\n", hr, tds[i]);
+                hr = IMetaDataImport2_EnumMethods(import, &me, tds[i], methods, ARRAY_SIZE(methods), &mcount);
+                ok(SUCCEEDED(hr), "Got hr %#lx.\n", hr);
+                IMetaDataImport2_CloseEnum(import, me);
+            }
+            total += count;
+        }
+        trace("%s: %lu types\n", wine_dbgstr_w(path), total);
+        IMetaDataImport2_CloseEnum(import, e);
+        {
+            mdTypeDef point, stringable;
+            mdFieldDef field;
+            mdMethodDef method;
+            const BYTE *sig;
+            const void *blob;
+            ULONG size;
+
+            hr = IMetaDataImport2_FindTypeDefByName(import, L"Windows.Foundation.Point", 0, &point);
+            if (hr == S_OK)
+            {
+                hr = IMetaDataImport2_FindField(import, point, L"X", NULL, 0, &field);
+                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                hr = IMetaDataImport2_GetFieldProps(import, field, NULL, NULL, 0, NULL, NULL, &sig, &size, NULL, NULL, NULL);
+                ok(hr == S_OK && size == 2 && sig[0] == 0x06 && sig[1] == ELEMENT_TYPE_R4, "Got hr %#lx.\n", hr);
+            }
+            hr = IMetaDataImport2_FindTypeDefByName(import, L"Windows.Foundation.IStringable", 0, &stringable);
+            if (hr == S_OK)
+            {
+                hr = IMetaDataImport2_FindMethod(import, stringable, L"ToString", NULL, 0, &method);
+                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                hr = IMetaDataImport2_GetCustomAttributeByName(import, stringable,
+                                                               L"Windows.Foundation.Metadata.GuidAttribute", &blob, &size);
+                ok(hr == S_OK && size == 20 && *(const unsigned int *)((const BYTE *)blob + 2) == 0x96369f54,
+                   "Got hr %#lx, size %lu.\n", hr, size);
+            }
+        }
+        hr = IMetaDataImport2_GetVersionString(import, name, ARRAY_SIZE(name), NULL);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        trace("version %s\n", wine_dbgstr_w(name));
+        IMetaDataImport2_Release(import);
+    }
+    IMetaDataDispenser_Release(dispenser);
+}
