+/* fill ASSEMBLYMETADATA from the four version columns at col .. col+3 and the culture string */
+static void fill_asm_metadata(const struct md_scope *m, unsigned int table, ULONG rid, unsigned int col,
+                              unsigned int culture_col, ASSEMBLYMETADATA *md)
+{
+    const char *culture;
+    ULONG len;
+    WCHAR *w;
+
+    if (!md) return;
+    md->usMajorVersion = cell(m, table, rid, col);
+    md->usMinorVersion = cell(m, table, rid, col + 1);
+    md->usBuildNumber = cell(m, table, rid, col + 2);
+    md->usRevisionNumber = cell(m, table, rid, col + 3);
+    culture = cell_str(m, table, rid, culture_col);
+    w = make_wide(NULL, culture, &len);
+    if (md->szLocale && md->cbLocale && w)
+    {
+        ULONG copy = min(len, md->cbLocale);
+
+        memcpy(md->szLocale, w, copy * sizeof(WCHAR));
+        md->szLocale[copy - 1] = 0;
+    }
+    md->cbLocale = w ? len : 0;
+    md->ulProcessor = 0;
+    md->ulOS = 0;
+    free(w);
+}
