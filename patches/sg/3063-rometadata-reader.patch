+/* method semantics of an event or property: fills well-known slots, collects the "other" methods */
+static void semantics_of(const struct md_scope *m, ULONG32 assoc, ULONG32 *setter, ULONG32 *getter, ULONG32 *adder,
+                         ULONG32 *remover, ULONG32 *fire, ULONG32 *others, ULONG cMax, ULONG *pcOthers)
+{
+    ULONG v = encode_coded(CI_HASSEMANTICS, assoc), i, nother = 0;
+
+    if (setter) *setter = 0;
+    if (getter) *getter = 0;
+    if (adder) *adder = 0;
+    if (remover) *remover = 0;
+    if (fire) *fire = 0;
+    for (i = 1; i <= rows(m, T_METHODSEM); i++)
+    {
+        ULONG sem = cell(m, T_METHODSEM, i, 0);
+        ULONG32 method = MKTK(T_METHOD, cell(m, T_METHODSEM, i, 1));
+
+        if (cell(m, T_METHODSEM, i, 2) != v) continue;
+        if ((sem & 1) && setter) *setter = method;
+        else if ((sem & 2) && getter) *getter = method;
+        else if ((sem & 8) && adder) *adder = method;
+        else if ((sem & 0x10) && remover) *remover = method;
+        else if ((sem & 0x20) && fire) *fire = method;
+        else if (sem & 4)
+        {
+            if (others && nother < cMax) others[nother] = method;
+            nother++;
+        }
+    }
+    if (pcOthers) *pcOthers = nother;
+}
+
+static HRESULT WINAPI import_GetEventProps(IMetaDataImport2 *iface, ULONG32 ev, ULONG32 *cls, WCHAR *name, ULONG cch,
+                                           ULONG *pch, DWORD *flags, ULONG32 *type, ULONG32 *add, ULONG32 *remove,
+                                           ULONG32 *fire, ULONG32 *others, ULONG cMax, ULONG *pcOthers)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG i;
+
+    TRACE("%p %#x %p %p %lu %p\n", iface, ev, cls, name, cch, pch);
+
+    if (!tk_is(m, ev, T_EVENT)) return TK_T(ev) == T_EVENT ? CLDB_E_INDEX_NOTFOUND : E_INVALIDARG;
+    if (cls)
+    {
+        *cls = 0;
+        for (i = 1; i <= rows(m, T_EVENTMAP); i++)
+        {
+            ULONG s, e;
+            child_range(m, T_EVENTMAP, i, 1, T_EVENT, &s, &e);
+            if (TK_R(ev) >= s && TK_R(ev) < e) { *cls = MKTK(T_TYPEDEF, cell(m, T_EVENTMAP, i, 0)); break; }
+        }
+    }
+    if (flags) *flags = cell(m, T_EVENT, TK_R(ev), 0);
+    if (type) *type = cell_tok(m, T_EVENT, TK_R(ev), 2, CI_TYPEDEFORREF);
+    semantics_of(m, ev, NULL, NULL, add, remove, fire, others, cMax, pcOthers);
+    return put_name(cell_str(m, T_EVENT, TK_R(ev), 1), name, cch, pch);
+}
+
+static HRESULT WINAPI import_GetMethodSemantics(IMetaDataImport2 *iface, ULONG32 mb, ULONG32 evprop, DWORD *flags)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG v = encode_coded(CI_HASSEMANTICS, evprop), i;
+
+    TRACE("%p %#x %#x %p\n", iface, mb, evprop, flags);
+
+    if (!flags || v == ~0u || !tk_is(m, mb, T_METHOD)) return E_INVALIDARG;
+    *flags = 0;
+    for (i = 1; i <= rows(m, T_METHODSEM); i++)
+        if (cell(m, T_METHODSEM, i, 1) == TK_R(mb) && cell(m, T_METHODSEM, i, 2) == v)
+        {
+            *flags = cell(m, T_METHODSEM, i, 0);
+            return S_OK;
+        }
+    return CLDB_E_RECORD_NOTFOUND;
