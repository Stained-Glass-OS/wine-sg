+        if (cell_tok(m, T_TYPEREF, i, 0, CI_RESSCOPE) != scope) continue;
+        if (!name_eq(cell_str(m, T_TYPEREF, i, 1), n) || !name_eq(cell_str(m, T_TYPEREF, i, 2), ns)) continue;
+        *ptr = MKTK(T_TYPEREF, i);
+        hr = S_OK;
+        break;
+    }
+    free(u);
+    return hr;
+}
