+/* events (kind 0) and properties (kind 1) of a class, via the map tables */
+static HRESULT enum_evprop(struct md_scope *m, void **phEnum, ULONG32 td, int kind, ULONG32 *out, ULONG cMax, ULONG *pc)
+{
+    ENUM_BEGIN(phEnum)
+    {
+        unsigned int map = kind ? T_PROPMAP : T_EVENTMAP, child = kind ? T_PROPERTY : T_EVENT;
+        ULONG i, s, e, j;
+
+        if (!tk_is(m, td, T_TYPEDEF)) return CLDB_E_INDEX_NOTFOUND;
+        for (i = 1; i <= rows(m, map); i++)
+        {
+            if (cell(m, map, i, 0) != TK_R(td)) continue;
+            child_range(m, map, i, 1, child, &s, &e);
+            for (j = s; j < e; j++) tk_add(&list, MKTK(child, j));
+        }
+    }
+    ENUM_END(phEnum, out, cMax, pc);
+}
