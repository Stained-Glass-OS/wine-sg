+/* members of a class: kind 0 = methods, 1 = fields */
+static void list_members(const struct md_scope *m, ULONG32 cl, int kind, const char *filter, struct tklist *list)
+{
+    unsigned int child = kind ? T_FIELD : T_METHOD;
+    ULONG s, e, i;
+
+    child_range(m, T_TYPEDEF, TK_R(cl), kind ? 4 : 5, child, &s, &e);
+    for (i = s; i < e; i++)
+        if (!filter || name_eq(cell_str(m, child, i, kind ? 1 : 3), filter)) tk_add(list, MKTK(child, i));
+}
+
+static HRESULT enum_members_common(struct md_scope *m, void **phEnum, ULONG32 cl, const WCHAR *name, int kinds,
+                                   ULONG32 *out, ULONG cMax, ULONG *pc)
+{
+    ENUM_BEGIN(phEnum)
+    {
+        char *u = NULL;
+
+        if (!tk_is(m, cl, T_TYPEDEF)) return CLDB_E_INDEX_NOTFOUND;
+        if (name && !(u = to_utf8(name))) return E_OUTOFMEMORY;
+        if (kinds & 1) list_members(m, cl, 0, u, &list);
+        if (kinds & 2) list_members(m, cl, 1, u, &list);
+        free(u);
+    }
+    ENUM_END(phEnum, out, cMax, pc);
+}
