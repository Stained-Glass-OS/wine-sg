+static ULONG WINAPI import_AddRef(IMetaDataImport2 *iface)
+{
+    struct md_scope *m = impl_from_import(iface);
+    return InterlockedIncrement(&m->refcount);
+}
+
+static ULONG WINAPI import_Release(IMetaDataImport2 *iface)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG ref = InterlockedDecrement(&m->refcount);
+
+    if (!ref)
+    {
+        free(m->file);
+        free(m);
+    }
+    return ref;
+}
