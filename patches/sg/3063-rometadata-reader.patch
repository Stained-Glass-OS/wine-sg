+static HRESULT WINAPI import_FindTypeDefByName(IMetaDataImport2 *iface, const WCHAR *name, ULONG32 enclosing, ULONG32 *ptd)
+{
+    struct md_scope *m = impl_from_import(iface);
+    const char *ns, *n;
+    char *u;
+    ULONG i;
+    HRESULT hr = CLDB_E_RECORD_NOTFOUND;
+
+    TRACE("%p %s %#x %p\n", iface, debugstr_w(name), enclosing, ptd);
+
+    if (!name || !ptd) return E_INVALIDARG;
+    *ptd = 0;
+    if (enclosing && !tk_is(m, enclosing, T_TYPEDEF) && !tk_is(m, enclosing, T_TYPEREF)) return E_INVALIDARG;
+    if (!(u = split_name(name, &ns, &n))) return E_OUTOFMEMORY;
+
+    for (i = 1; i <= rows(m, T_TYPEDEF); i++)
+    {
+        ULONG k;
+
+        if (!name_eq(cell_str(m, T_TYPEDEF, i, 1), n)) continue;
+        if (!enclosing)
+        {
+            if (!name_eq(cell_str(m, T_TYPEDEF, i, 2), ns)) continue;
+            /* a nested type cannot be found without its enclosing class */
+            for (k = 1; k < rows(m, T_NESTED) + 1; k++)
+                if (cell(m, T_NESTED, k, 0) == i) break;
+#ifndef SG_MUTANT_NESTED
+            if (k <= rows(m, T_NESTED)) continue;
+#endif
+        }
+        else
+        {
+            for (k = 1; k <= rows(m, T_NESTED); k++)
+                if (cell(m, T_NESTED, k, 0) == i && MKTK(T_TYPEDEF, cell(m, T_NESTED, k, 1)) == enclosing) break;
+            if (k > rows(m, T_NESTED)) continue;
+        }
+        *ptd = MKTK(T_TYPEDEF, i);
+        hr = S_OK;
+        break;
+    }
+    free(u);
+    return hr;
+}
+
+static HRESULT find_member(struct md_scope *m, ULONG32 td, const WCHAR *name, const BYTE *sig, ULONG cbsig, int kinds,
+                           ULONG32 *pmb)
+{
+    HRESULT hr = CLDB_E_RECORD_NOTFOUND;
+    ULONG32 kind;
+    char *u;
+
+    if (!name || !pmb) return E_INVALIDARG;
+    *pmb = 0;
+    if (!tk_is(m, td, T_TYPEDEF)) return CLDB_E_INDEX_NOTFOUND;
+    if (!(u = to_utf8(name))) return E_OUTOFMEMORY;
+
+    for (kind = 0; kind < 2 && hr != S_OK; kind++)
+    {
+        unsigned int child = kind ? T_FIELD : T_METHOD;
+        ULONG s, e, i, col = kind ? 2 : 4;
+
+        if (!(kinds & (1 << kind))) continue;
+        child_range(m, T_TYPEDEF, TK_R(td), kind ? 4 : 5, child, &s, &e);
+        for (i = s; i < e; i++)
+        {
+            const BYTE *data;
+            ULONG size;
+
+            if (!name_eq(cell_str(m, child, i, kind ? 1 : 3), u)) continue;
+            if (sig && cbsig)
+            {
+                cell_blob(m, child, i, col, &data, &size);
+                if (size != cbsig || memcmp(data, sig, size)) continue;
+            }
+            /* private-scope members are not found by name */
+            if ((cell(m, child, i, kind ? 0 : 2) & 7) == 0) continue;
+            *pmb = MKTK(child, i);
+            hr = S_OK;
+            break;
+        }
+    }
+    free(u);
+    return hr;
+}
+
+static HRESULT WINAPI import_FindMember(IMetaDataImport2 *iface, ULONG32 td, const WCHAR *name, const BYTE *sig,
+                                        ULONG cbsig, ULONG32 *pmb)
+{
+    TRACE("%p %#x %s %p %lu %p\n", iface, td, debugstr_w(name), sig, cbsig, pmb);
+    return find_member(impl_from_import(iface), td, name, sig, cbsig, 3, pmb);
+}
+
+static HRESULT WINAPI import_FindMethod(IMetaDataImport2 *iface, ULONG32 td, const WCHAR *name, const BYTE *sig,
+                                        ULONG cbsig, ULONG32 *pmb)
+{
+    TRACE("%p %#x %s %p %lu %p\n", iface, td, debugstr_w(name), sig, cbsig, pmb);
+    return find_member(impl_from_import(iface), td, name, sig, cbsig, 1, pmb);
+}
+
+static HRESULT WINAPI import_FindField(IMetaDataImport2 *iface, ULONG32 td, const WCHAR *name, const BYTE *sig,
+                                       ULONG cbsig, ULONG32 *pmb)
+{
+    TRACE("%p %#x %s %p %lu %p\n", iface, td, debugstr_w(name), sig, cbsig, pmb);
+    return find_member(impl_from_import(iface), td, name, sig, cbsig, 2, pmb);
+}
