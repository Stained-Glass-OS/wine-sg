+static HRESULT WINAPI import_ResolveTypeRef(IMetaDataImport2 *iface, ULONG32 tr, REFIID riid, IUnknown **scope, ULONG32 *ptd)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG32 res, td;
+    WCHAR *full;
+    ULONG len;
+    HRESULT hr;
+
+    TRACE("%p %#x %s %p %p\n", iface, tr, debugstr_guid(riid), scope, ptd);
+
+    if (!tk_is(m, tr, T_TYPEREF)) return TK_T(tr) == T_TYPEREF ? CLDB_E_INDEX_NOTFOUND : E_INVALIDARG;
+    if (!scope && !ptd) return E_INVALIDARG;
+    res = cell_tok(m, T_TYPEREF, TK_R(tr), 0, CI_RESSCOPE);
+    /* only references into this very module can be resolved without loading other assemblies */
+    if (TK_T(res) != T_MODULE) return CLDB_E_RECORD_NOTFOUND;
+    if (!(full = make_wide(cell_str(m, T_TYPEREF, TK_R(tr), 2), cell_str(m, T_TYPEREF, TK_R(tr), 1), &len)))
+        return E_OUTOFMEMORY;
+    hr = IMetaDataImport2_FindTypeDefByName(iface, full, 0, &td);
+    free(full);
+    if (FAILED(hr)) return hr;
+    if (ptd) *ptd = td;
+    if (scope) hr = IMetaDataImport2_QueryInterface(iface, riid, (void **)scope);
+    return hr;
+}
