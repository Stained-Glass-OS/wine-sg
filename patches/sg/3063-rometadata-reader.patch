+static HRESULT WINAPI import_GetCustomAttributeByName(IMetaDataImport2 *iface, ULONG32 obj, const WCHAR *name,
+                                                      const void **data, ULONG *cb)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG v = encode_coded(CI_HASCA, obj), i;
+    HRESULT hr = S_FALSE;
+    const char *ns, *n;
+    char *u;
+
+    TRACE("%p %#x %s %p %p\n", iface, obj, debugstr_w(name), data, cb);
+
+    if (!name || v == ~0u || !valid_token(m, obj)) return E_INVALIDARG;
+    if (data) *data = NULL;
+    if (cb) *cb = 0;
+    if (!(u = split_name(name, &ns, &n))) return E_OUTOFMEMORY;
+    for (i = 1; i <= rows(m, T_CA); i++)
+    {
+        ULONG32 type = cell_tok(m, T_CA, i, 1, CI_CATYPE), parent;
+        const char *cns, *cn;
+        const BYTE *blob;
+        ULONG size;
+
+        if (cell(m, T_CA, i, 0) != v) continue;
+        if (TK_T(type) == T_METHOD) parent = typedef_owner_of_method(m, type);
+        else if (TK_T(type) == T_MEMBERREF && tk_is(m, type, T_MEMBERREF))
+            parent = cell_tok(m, T_MEMBERREF, TK_R(type), 0, CI_MEMBERREFPARENT);
+        else continue;
+        if (tk_is(m, parent, T_TYPEDEF)) { cns = cell_str(m, T_TYPEDEF, TK_R(parent), 2); cn = cell_str(m, T_TYPEDEF, TK_R(parent), 1); }
+        else if (tk_is(m, parent, T_TYPEREF)) { cns = cell_str(m, T_TYPEREF, TK_R(parent), 2); cn = cell_str(m, T_TYPEREF, TK_R(parent), 1); }
+        else continue;
+        if (!name_eq(cn, n) || !name_eq(cns, ns)) continue;
+        cell_blob(m, T_CA, i, 2, &blob, &size);
+        if (data) *data = blob;
+        if (cb) *cb = size;
+        hr = S_OK;
+        break;
+    }
+    free(u);
+    return hr;
+}
