+static HRESULT find_by_name(struct md_scope *m, unsigned int table, unsigned int ns_col, unsigned int name_col,
+                            const WCHAR *name, ULONG32 *out)
+{
+    HRESULT hr = CLDB_E_RECORD_NOTFOUND;
+    const char *ns = "", *n;
+    ULONG i;
+    char *u;
+
+    if (!name || !out) return E_INVALIDARG;
+    *out = 0;
+    if (ns_col != ~0u) u = split_name(name, &ns, &n);
+    else if ((u = to_utf8(name))) n = u;
+    if (!u) return E_OUTOFMEMORY;
+    for (i = 1; i <= rows(m, table); i++)
+    {
+        if (!name_eq(cell_str(m, table, i, name_col), n)) continue;
+        if (ns_col != ~0u && !name_eq(cell_str(m, table, i, ns_col), ns)) continue;
+        *out = MKTK(table, i);
+        hr = S_OK;
+        break;
+    }
+    free(u);
+    return hr;
+}
