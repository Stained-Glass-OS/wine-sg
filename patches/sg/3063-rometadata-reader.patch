+static HRESULT WINAPI import_GetClassLayout(IMetaDataImport2 *iface, ULONG32 td, DWORD *pack, COR_FIELD_OFFSET *offsets,
+                                            ULONG cMax, ULONG *pcOffsets, ULONG *classsize)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG i, row = 0, n = 0, s, e;
+
+    TRACE("%p %#x %p %p %lu %p %p\n", iface, td, pack, offsets, cMax, pcOffsets, classsize);
+
+    if (!tk_is(m, td, T_TYPEDEF)) return TK_T(td) == T_TYPEDEF ? CLDB_E_INDEX_NOTFOUND : E_INVALIDARG;
+    for (i = 1; i <= rows(m, T_CLASSLAYOUT); i++)
+        if (cell(m, T_CLASSLAYOUT, i, 2) == TK_R(td)) { row = i; break; }
+    if (!row) return CLDB_E_RECORD_NOTFOUND;
+    if (pack) *pack = cell(m, T_CLASSLAYOUT, row, 0);
+    if (classsize) *classsize = cell(m, T_CLASSLAYOUT, row, 1);
+    child_range(m, T_TYPEDEF, TK_R(td), 4, T_FIELD, &s, &e);
+    for (i = 1; i <= rows(m, T_FIELDLAYOUT); i++)
+    {
+        ULONG f = cell(m, T_FIELDLAYOUT, i, 1);
+
+        if (f < s || f >= e) continue;
+        if (offsets && n < cMax)
+        {
+            offsets[n].ridOfField = MKTK(T_FIELD, f);
+            offsets[n].ulOffset = cell(m, T_FIELDLAYOUT, i, 0);
+        }
+        n++;
+    }
+    if (pcOffsets) *pcOffsets = n;
+    return S_OK;
+}
