+static HRESULT WINAPI import_GetUserString(IMetaDataImport2 *iface, ULONG32 stk, WCHAR *str, ULONG cch, ULONG *pch)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG off = TK_R(stk), len, hdr, n;
+    const BYTE *p;
+
+    TRACE("%p %#x %p %lu %p\n", iface, stk, str, cch, pch);
+
+    if (TK_T(stk) != (mdtString >> 24) || off >= m->us_size
+        || !uncompress(m->us + off, m->us + m->us_size, &len, &hdr) || len > m->us_size - off - hdr)
+        return CLDB_E_INDEX_NOTFOUND;
+    p = m->us + off + hdr;
+    n = len / 2;    /* the final byte is a flag */
+    if (pch) *pch = n;
+    if (str && cch)
+    {
+        ULONG copy = min(n, cch), j;
+
+        for (j = 0; j < copy; j++) str[j] = rd16(p + j * 2);
+        if (n > cch) return CLDB_S_TRUNCATION;
+    }
+    return S_OK;
+}
