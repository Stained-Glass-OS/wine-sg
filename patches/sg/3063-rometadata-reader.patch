+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "cor.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rometadata);
+
+#define NUM_TABLES 0x2d
+#define MAX_COLS   9
+
+struct md_table
+{
+    const BYTE *data;
+    ULONG rows, rowsize;
+    ULONG col_off[MAX_COLS];
+    BYTE col_width[MAX_COLS];
+};
+
+struct md_scope
+{
+    IMetaDataImport2 import_iface;
+    IMetaDataAssemblyImport asm_iface;
+    LONG refcount;
+
+    BYTE *file;                 /* owned copy of the image or metadata blob */
+    SIZE_T file_size;
+    const BYTE *root;           /* start of the metadata root */
+    SIZE_T root_size;
+    const char *version;
+    ULONG version_len;
+    const BYTE *strings, *us, *guid, *blob;
+    SIZE_T strings_size, us_size, guid_size, blob_size;
+    BYTE heap_sizes;
+    struct md_table tables[NUM_TABLES];
+    DWORD pe_kind, machine;
+};
+
+
+/* column types: 0..0x2c = simple index into that table */
+#define C_U1     0x80
+#define C_U2     0x81
+#define C_U4     0x82
+#define C_STR    0x83
+#define C_GUID   0x84
+#define C_BLOB   0x85
+#define C_CODED  0x90   /* + coded index kind */
+
+enum coded_kind
+{
+    CI_TYPEDEFORREF, CI_HASCONSTANT, CI_HASCA, CI_HASFIELDMARSHAL, CI_HASDECLSEC, CI_MEMBERREFPARENT,
+    CI_HASSEMANTICS, CI_METHODDEFORREF, CI_MEMBERFORWARDED, CI_IMPLEMENTATION, CI_CATYPE, CI_RESSCOPE,
+    CI_TYPEORMETHODDEF, CI_COUNT
+};
+
+#define CI(k) (C_CODED + (k))
+
+static const struct { BYTE bits; BYTE count; BYTE tables[22]; } coded_info[CI_COUNT] =
+{
+    /* TypeDefOrRef */ { 2, 3, { 0x02, 0x01, 0x1b } },
+    /* HasConstant */ { 2, 3, { 0x04, 0x08, 0x17 } },
+    /* HasCustomAttribute */ { 5, 22, { 0x06, 0x04, 0x01, 0x02, 0x08, 0x09, 0x0a, 0x00, 0x0e, 0x17, 0x14, 0x11, 0x1a,
+                                    0x1b, 0x20, 0x23, 0x26, 0x27, 0x28, 0x2a, 0x2c, 0x2b } },
+    /* HasFieldMarshal */ { 1, 2, { 0x04, 0x08 } },
+    /* HasDeclSecurity */ { 2, 3, { 0x02, 0x06, 0x20 } },
+    /* MemberRefParent */ { 3, 5, { 0x02, 0x01, 0x1a, 0x06, 0x1b } },
+    /* HasSemantics */ { 1, 2, { 0x14, 0x17 } },
+    /* MethodDefOrRef */ { 1, 2, { 0x06, 0x0a } },
+    /* MemberForwarded */ { 1, 2, { 0x04, 0x06 } },
+    /* Implementation */ { 2, 3, { 0x26, 0x23, 0x27 } },
+    /* CustomAttributeType */ { 3, 5, { 0xff, 0xff, 0x06, 0x0a, 0xff } },
+    /* ResolutionScope */ { 2, 4, { 0x00, 0x1a, 0x23, 0x01 } },
+    /* TypeOrMethodDef */ { 1, 2, { 0x02, 0x06 } },
+};
+
+static const BYTE schema[NUM_TABLES][MAX_COLS] =
+{
+    /* 00 Module */ { C_U2, C_STR, C_GUID, C_GUID, C_GUID },
+    /* 01 TypeRef */ { CI(CI_RESSCOPE), C_STR, C_STR },
+    /* 02 TypeDef */ { C_U4, C_STR, C_STR, CI(CI_TYPEDEFORREF), 0x04, 0x06 },
+    /* 03 FieldPtr */ { 0x04 },
+    /* 04 Field */ { C_U2, C_STR, C_BLOB },
+    /* 05 MethodPtr */ { 0x06 },
+    /* 06 MethodDef */ { C_U4, C_U2, C_U2, C_STR, C_BLOB, 0x08 },
+    /* 07 ParamPtr */ { 0x08 },
+    /* 08 Param */ { C_U2, C_U2, C_STR },
+    /* 09 InterfaceImpl */ { 0x02, CI(CI_TYPEDEFORREF) },
+    /* 0a MemberRef */ { CI(CI_MEMBERREFPARENT), C_STR, C_BLOB },
+    /* 0b Constant */ { C_U1, C_U1, CI(CI_HASCONSTANT), C_BLOB },
+    /* 0c CustomAttribute */ { CI(CI_HASCA), CI(CI_CATYPE), C_BLOB },
+    /* 0d FieldMarshal */ { CI(CI_HASFIELDMARSHAL), C_BLOB },
+    /* 0e DeclSecurity */ { C_U2, CI(CI_HASDECLSEC), C_BLOB },
+    /* 0f ClassLayout */ { C_U2, C_U4, 0x02 },
+    /* 10 FieldLayout */ { C_U4, 0x04 },
+    /* 11 StandAloneSig */ { C_BLOB },
+    /* 12 EventMap */ { 0x02, 0x14 },
+    /* 13 EventPtr */ { 0x14 },
+    /* 14 Event */ { C_U2, C_STR, CI(CI_TYPEDEFORREF) },
+    /* 15 PropertyMap */ { 0x02, 0x17 },
+    /* 16 PropertyPtr */ { 0x17 },
+    /* 17 Property */ { C_U2, C_STR, C_BLOB },
+    /* 18 MethodSemantics */ { C_U2, 0x06, CI(CI_HASSEMANTICS) },
+    /* 19 MethodImpl */ { 0x02, CI(CI_METHODDEFORREF), CI(CI_METHODDEFORREF) },
+    /* 1a ModuleRef */ { C_STR },
+    /* 1b TypeSpec */ { C_BLOB },
+    /* 1c ImplMap */ { C_U2, CI(CI_MEMBERFORWARDED), C_STR, 0x1a },
+    /* 1d FieldRVA */ { C_U4, 0x04 },
+    /* 1e EncLog */ { C_U4, C_U4 },
+    /* 1f EncMap */ { C_U4 },
+    /* 20 Assembly */ { C_U4, C_U2, C_U2, C_U2, C_U2, C_U4, C_BLOB, C_STR, C_STR },
+    /* 21 AssemblyProcessor */ { C_U4 },
+    /* 22 AssemblyOS */ { C_U4, C_U4, C_U4 },
+    /* 23 AssemblyRef */ { C_U2, C_U2, C_U2, C_U2, C_U4, C_BLOB, C_STR, C_STR, C_BLOB },
+    /* 24 AssemblyRefProcessor */ { C_U4, 0x23 },
+    /* 25 AssemblyRefOS */ { C_U4, C_U4, C_U4, 0x23 },
+    /* 26 File */ { C_U4, C_STR, C_BLOB },
+    /* 27 ExportedType */ { C_U4, C_U4, C_STR, C_STR, CI(CI_IMPLEMENTATION) },
+    /* 28 ManifestResource */ { C_U4, C_U4, C_STR, CI(CI_IMPLEMENTATION) },
+    /* 29 NestedClass */ { 0x02, 0x02 },
+    /* 2a GenericParam */ { C_U2, C_U2, CI(CI_TYPEORMETHODDEF), C_STR },
+    /* 2b MethodSpec */ { CI(CI_METHODDEFORREF), C_BLOB },
+    /* 2c GenericParamConstraint */ { 0x2a, CI(CI_TYPEDEFORREF) },
+};
+
+static inline UINT16 rd16(const BYTE *p) { return p[0] | (p[1] << 8); }
+static inline UINT32 rd32(const BYTE *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((UINT32)p[3] << 24); }
+
+static BOOL is_coded(BYTE col) { return col >= C_CODED && col < C_CODED + CI_COUNT; }
+
+static ULONG max_rows_of(const struct md_scope *m, enum coded_kind k)
+{
+    ULONG max = 0;
+    unsigned int i;
+
+    for (i = 0; i < coded_info[k].count; i++)
+    {
+        BYTE t = coded_info[k].tables[i];
+        if (t < NUM_TABLES && m->tables[t].rows > max) max = m->tables[t].rows;
+    }
+    return max;
+}
+
+static unsigned int col_width(const struct md_scope *m, BYTE col)
+{
+    switch (col)
+    {
+    case C_U1: return 1;
+    case C_U2: return 2;
+    case C_U4: return 4;
+    case C_STR: return (m->heap_sizes & 1) ? 4 : 2;
+    case C_GUID: return (m->heap_sizes & 2) ? 4 : 2;
+    case C_BLOB: return (m->heap_sizes & 4) ? 4 : 2;
+    }
+    if (is_coded(col))
+    {
+        enum coded_kind k = col - C_CODED;
+#ifdef SG_MUTANT_CODED_WIDTH
+        return 4;
+#endif
+        return max_rows_of(m, k) < (1u << (16 - coded_info[k].bits)) ? 2 : 4;
+    }
+    return m->tables[col].rows > 0xffff ? 4 : 2;
+}
+
+/* raw value of a column, rid is 1-based and must be in range */
+static ULONG cell(const struct md_scope *m, unsigned int t, ULONG rid, unsigned int col)
+{
+    const struct md_table *tb = &m->tables[t];
+    const BYTE *p = tb->data + (SIZE_T)(rid - 1) * tb->rowsize + tb->col_off[col];
+
+    switch (tb->col_width[col])
+    {
+    case 1: return *p;
+    case 2: return rd16(p);
+    default: return rd32(p);
+    }
+}
+
+static ULONG32 decode_coded(enum coded_kind k, ULONG v)
+{
+    ULONG tag = v & ((1u << coded_info[k].bits) - 1), rid = v >> coded_info[k].bits;
+    BYTE t;
+
+    if (tag >= coded_info[k].count) return 0;
+    t = coded_info[k].tables[tag];
+    if (t == 0xff) return 0;
+    return ((ULONG32)t << 24) | rid;
+}
+
+/* returns the coded value for a token, or ~0 if the token's table is not part of the kind */
+static ULONG encode_coded(enum coded_kind k, ULONG32 token)
+{
+    unsigned int i;
+    BYTE t = token >> 24;
+
+    for (i = 0; i < coded_info[k].count; i++)
+        if (coded_info[k].tables[i] == t)
+            return ((token & 0xffffff) << coded_info[k].bits) | i;
+    return ~0u;
+}
+
+static ULONG32 cell_tok(const struct md_scope *m, unsigned int t, ULONG rid, unsigned int col, enum coded_kind k)
+{
+    return decode_coded(k, cell(m, t, rid, col));
+}
+
+static ULONG rows(const struct md_scope *m, unsigned int t) { return m->tables[t].rows; }
+
+static const char *get_str(const struct md_scope *m, ULONG idx)
+{
+    if (idx >= m->strings_size || !memchr(m->strings + idx, 0, m->strings_size - idx)) return "";
+    return (const char *)m->strings + idx;
+}
+
+static const char *cell_str(const struct md_scope *m, unsigned int t, ULONG rid, unsigned int col)
+{
+    return get_str(m, cell(m, t, rid, col));
+}
+
+/* decode an ECMA-335 compressed unsigned integer */
+static BOOL uncompress(const BYTE *p, const BYTE *end, ULONG *val, ULONG *len)
+{
+    if (p >= end) return FALSE;
+    if (!(p[0] & 0x80)) { *val = p[0]; *len = 1; return TRUE; }
+    if ((p[0] & 0xc0) == 0x80)
+    {
+        if (end - p < 2) return FALSE;
+        *val = ((p[0] & 0x3f) << 8) | p[1]; *len = 2; return TRUE;
+    }
+    if ((p[0] & 0xe0) == 0xc0)
+    {
+        if (end - p < 4) return FALSE;
+        *val = ((p[0] & 0x1f) << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; *len = 4; return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL get_blob(const struct md_scope *m, ULONG idx, const BYTE **data, ULONG *size)
+{
+    ULONG len, hdr;
+    const BYTE *end = m->blob + m->blob_size;
+
+    *data = NULL;
+    *size = 0;
+    if (idx >= m->blob_size) return !idx;
+    if (!uncompress(m->blob + idx, end, &len, &hdr) || len > end - (m->blob + idx + hdr)) return FALSE;
+    *data = m->blob + idx + hdr;
+    *size = len;
+    return TRUE;
+}
+
+static void cell_blob(const struct md_scope *m, unsigned int t, ULONG rid, unsigned int col,
+                      const BYTE **data, ULONG *size)
+{
+    if (!get_blob(m, cell(m, t, rid, col), data, size)) { *data = NULL; *size = 0; }
+}
+
+static WCHAR *make_wide(const char *ns, const char *name, ULONG *len)
+{
+    int n1 = ns && *ns ? MultiByteToWideChar(CP_UTF8, 0, ns, -1, NULL, 0) - 1 : 0;
+    int n2 = MultiByteToWideChar(CP_UTF8, 0, name, -1, NULL, 0);
+    WCHAR *ret;
+
+    if (n2 <= 0) n2 = 1;
+    if (!(ret = malloc((n1 + 1 + n2) * sizeof(WCHAR)))) return NULL;
+    if (n1)
+    {
+        MultiByteToWideChar(CP_UTF8, 0, ns, -1, ret, n1 + 1);
+        ret[n1] = '.';
+        n1++;
+    }
+    if (!MultiByteToWideChar(CP_UTF8, 0, name, -1, ret + n1, n2)) ret[n1] = 0;
+    *len = n1 + n2;
+    return ret;
+}
+
+/* copy a name out with the metadata truncation convention */
+static HRESULT put_wide(const WCHAR *w, ULONG len, WCHAR *buf, ULONG cch, ULONG *pch)
+{
+    if (pch) *pch = len;
+    if (!buf) return S_OK;
+    if (cch < len
+#ifdef SG_MUTANT_TRUNC
+        && 0
+#endif
+       )
+    {
+        if (cch)
+        {
+            memcpy(buf, w, (cch - 1) * sizeof(WCHAR));
+            buf[cch - 1] = 0;
+        }
+        return CLDB_S_TRUNCATION;
+    }
+    memcpy(buf, w, len * sizeof(WCHAR));
+    return S_OK;
+}
+
+static HRESULT put_name2(const char *ns, const char *name, WCHAR *buf, ULONG cch, ULONG *pch)
+{
+    ULONG len;
+    WCHAR *w;
+    HRESULT hr;
+
+    if (!buf && !pch) return S_OK;
+    if (!(w = make_wide(ns, name, &len))) return E_OUTOFMEMORY;
+    hr = put_wide(w, len, buf, cch, pch);
+    free(w);
+    return hr;
+}
+
+static HRESULT put_name(const char *name, WCHAR *buf, ULONG cch, ULONG *pch)
+{
+    return put_name2(NULL, name, buf, cch, pch);
+}
+
+/* UTF-8 copy of a wide string for comparisons; caller frees */
+static char *to_utf8(const WCHAR *s)
+{
+    int n = WideCharToMultiByte(CP_UTF8, 0, s, -1, NULL, 0, NULL, NULL);
+    char *ret;
+
+    if (n <= 0 || !(ret = malloc(n))) return NULL;
+    WideCharToMultiByte(CP_UTF8, 0, s, -1, ret, n, NULL, NULL);
+    return ret;
+}
+
+static BOOL valid_token(const struct md_scope *m, ULONG32 tk)
+{
+    ULONG t = tk >> 24, rid = tk & 0xffffff;
+
+    if (t == (mdtString >> 24))
+        return rid && rid < m->us_size;
+    if (t >= NUM_TABLES) return FALSE;
+    return rid >= 1 && rid <= m->tables[t].rows;
+}
+
+/* ---- enumerations ---- */
+
+struct tklist
+{
+    ULONG32 *v, *v2;
+    ULONG n, cap;
+    BOOL two;
+    BOOL oom;
+};
+
+static void tk_add2(struct tklist *l, ULONG32 a, ULONG32 b)
+{
+    if (l->oom) return;
+    if (l->n == l->cap)
+    {
+        ULONG ncap = l->cap ? l->cap * 2 : 64;
+        ULONG32 *nv = realloc(l->v, ncap * sizeof(*nv)), *nv2 = l->v2;
+
+        if (!nv) { l->oom = TRUE; return; }
+        l->v = nv;
+        if (l->two && !(nv2 = realloc(l->v2, ncap * sizeof(*nv2)))) { l->oom = TRUE; return; }
+        l->v2 = nv2;
+        l->cap = ncap;
+    }
+    l->v[l->n] = a;
+    if (l->two) l->v2[l->n] = b;
+    l->n++;
+}
+
+static void tk_add(struct tklist *l, ULONG32 a) { tk_add2(l, a, 0); }
+
+struct md_enum
+{
+    ULONG32 *v, *v2;
+    ULONG count, pos;
+};
+
+/* finish an enumeration: create the handle on first call, then hand out tokens */
+static HRESULT enum_finish(struct tklist *l, void **phEnum, ULONG32 *out, ULONG32 *out2, ULONG cMax, ULONG *pc)
+{
+    struct md_enum *e = *phEnum;
+    ULONG n;
+
+    if (!e)
+    {
+        if (l->oom || !(e = calloc(1, sizeof(*e))))
+        {
+            free(l->v);
+            free(l->v2);
+            return E_OUTOFMEMORY;
+        }
+        e->v = l->v;
+        e->v2 = l->v2;
+        e->count = l->n;
+        *phEnum = e;
+    }
+    else
+    {
+        free(l->v);
+        free(l->v2);
+    }
+    n = e->count - e->pos;
+    if (n > cMax) n = cMax;
+    if (out && n) memcpy(out, e->v + e->pos, n * sizeof(*out));
+    if (out2 && e->v2 && n) memcpy(out2, e->v2 + e->pos, n * sizeof(*out2));
+    e->pos += n;
+    if (pc) *pc = n;
+    return n ? S_OK : S_FALSE;
+}
+
+#define ENUM_BEGIN(phEnum) \
+    struct tklist list = { 0 }; \
+    if (!*(phEnum))
+
+#define ENUM_END(phEnum, out, cMax, pc) \
+    return enum_finish(&list, (phEnum), (out), NULL, (cMax), (pc))
+
+/* ---- loading ---- */
+
+static HRESULT parse_tables(struct md_scope *m, const BYTE *p, SIZE_T size)
+{
+    ULONG64 valid;
+    const BYTE *end = p + size, *rowp;
+    unsigned int t, c, nvalid = 0;
+
+    if (size < 24) return CLDB_E_FILE_CORRUPT;
+    m->heap_sizes = p[6];
+    valid = rd32(p + 8) | ((ULONG64)rd32(p + 12) << 32);
+    if (valid >> NUM_TABLES) return CLDB_E_FILE_CORRUPT;
+    rowp = p + 24;
+    for (t = 0; t < 64; t++) if (valid & ((ULONG64)1 << t)) nvalid++;
+    if ((SIZE_T)(end - rowp) < nvalid * 4) return CLDB_E_FILE_CORRUPT;
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        if (!(valid & ((ULONG64)1 << t))) continue;
+        m->tables[t].rows = rd32(rowp);
+        if (m->tables[t].rows > 0x1000000) return CLDB_E_FILE_CORRUPT;
+        rowp += 4;
+    }
+    if (m->heap_sizes & 0x40) rowp += 4;   /* extra data word */
+    if (rowp > end) return CLDB_E_FILE_CORRUPT;
+
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        struct md_table *tb = &m->tables[t];
+        ULONG off = 0;
+
+        for (c = 0; c < MAX_COLS && schema[t][c]; c++)
+        {
+            tb->col_width[c] = col_width(m, schema[t][c]);
+            tb->col_off[c] = off;
+            off += tb->col_width[c];
+        }
+        tb->rowsize = off;
+    }
+    for (t = 0; t < NUM_TABLES; t++)
+    {
+        struct md_table *tb = &m->tables[t];
+        ULONG64 bytes = (ULONG64)tb->rows * tb->rowsize;
+
+        if (bytes > (ULONG64)(end - rowp)) return CLDB_E_FILE_CORRUPT;
+        tb->data = rowp;
+        rowp += bytes;
+    }
+    if (!m->tables[0].rows) return CLDB_E_FILE_CORRUPT;
+    return S_OK;
+}
+
+static HRESULT parse_root(struct md_scope *m, const BYTE *root, SIZE_T size)
+{
+    const BYTE *p, *end = root + size;
+    ULONG len, i, nstreams;
+    const BYTE *tables = NULL;
+    SIZE_T tables_size = 0;
+
+    if (size < 20 || rd32(root) != 0x424a5342) return CLDB_E_FILE_CORRUPT;
+    len = rd32(root + 12);
+    if (len > size - 16 || size - 16 - len < 4) return CLDB_E_FILE_CORRUPT;
+    m->root = root;
+    m->root_size = size;
+    m->version = (const char *)root + 16;
+    m->version_len = strnlen(m->version, len);
+    p = root + 16 + len;
+    nstreams = rd16(p + 2);
+    p += 4;
+
+    for (i = 0; i < nstreams; i++)
+    {
+        ULONG off, ssize, nl;
+        const char *name;
+
+        if (end - p < 9) return CLDB_E_FILE_CORRUPT;
+        off = rd32(p);
+        ssize = rd32(p + 4);
+        name = (const char *)p + 8;
+        nl = strnlen(name, end - p - 8);
+        if (nl == (ULONG)(end - p - 8)) return CLDB_E_FILE_CORRUPT;
+        p += 8 + ((nl + 4) & ~3u);
+        if (off > size || ssize > size - off) return CLDB_E_FILE_CORRUPT;
+        if (!strcmp(name, "#Strings")) { m->strings = root + off; m->strings_size = ssize; }
+        else if (!strcmp(name, "#US")) { m->us = root + off; m->us_size = ssize; }
+        else if (!strcmp(name, "#GUID")) { m->guid = root + off; m->guid_size = ssize; }
+        else if (!strcmp(name, "#Blob")) { m->blob = root + off; m->blob_size = ssize; }
+        else if (!strcmp(name, "#~") || !strcmp(name, "#-")) { tables = root + off; tables_size = ssize; }
+    }
+    if (!tables) return CLDB_E_FILE_CORRUPT;
+    return parse_tables(m, tables, tables_size);
+}
+
+static HRESULT parse_image(struct md_scope *m, BYTE *data, SIZE_T size)
+{
+    const BYTE *nt, *opt, *sect, *cor;
+    ULONG lfanew, nsect, optsize, i, rva_cor, cor_size, md_rva, md_size, off = 0, flags;
+    BOOL pe32plus;
+    HRESULT hr;
+
+    if (size >= 4 && rd32(data) == 0x424a5342)
+        return parse_root(m, data, size);
+
+    if (size < 0x40 || data[0] != 'M' || data[1] != 'Z') return CLDB_E_FILE_CORRUPT;
+    lfanew = rd32(data + 0x3c);
+    if (lfanew > size || size - lfanew < 24 + 96 || rd32(data + lfanew) != 0x4550) return CLDB_E_FILE_CORRUPT;
+    nt = data + lfanew;
+    nsect = rd16(nt + 6);
+    optsize = rd16(nt + 20);
+    m->machine = rd16(nt + 4);
+    opt = nt + 24;
+    if (optsize > size - lfanew - 24) return CLDB_E_FILE_CORRUPT;
+    pe32plus = rd16(opt) == 0x20b;
+    if (!pe32plus && rd16(opt) != 0x10b) return CLDB_E_FILE_CORRUPT;
+    {
+        ULONG dd = pe32plus ? 112 : 96;
+        if (optsize < dd + 15 * 8) return CLDB_E_FILE_CORRUPT;   /* no COM descriptor directory */
+        rva_cor = rd32(opt + dd + 14 * 8);
+        cor_size = rd32(opt + dd + 14 * 8 + 4);
+    }
+    if (!rva_cor || cor_size < 16) return CLDB_E_FILE_CORRUPT;
+    sect = opt + optsize;
+    if (nsect > (size - (sect - data)) / 40) return CLDB_E_FILE_CORRUPT;
+
+#define RVA_TO_OFF(rva, out) do { \
+        BOOL found_ = FALSE; \
+        for (i = 0; i < nsect; i++) { \
+            const BYTE *s_ = sect + i * 40; \
+            ULONG va_ = rd32(s_ + 12), vs_ = rd32(s_ + 8), raw_ = rd32(s_ + 20), rs_ = rd32(s_ + 16); \
+            if (!vs_ || vs_ < rs_) vs_ = rs_; \
+            if ((rva) >= va_ && (rva) - va_ < vs_) { (out) = raw_ + ((rva) - va_); found_ = TRUE; break; } \
+        } \
+        if (!found_) return CLDB_E_FILE_CORRUPT; \
+    } while (0)
+
+    RVA_TO_OFF(rva_cor, off);
+    if (off > size || size - off < 16) return CLDB_E_FILE_CORRUPT;
+    cor = data + off;
+    md_rva = rd32(cor + 8);
+    md_size = rd32(cor + 12);
+    flags = size - off >= 20 ? rd32(cor + 16) : 0;
+    RVA_TO_OFF(md_rva, off);
+#undef RVA_TO_OFF
+    if (off > size || md_size > size - off) return CLDB_E_FILE_CORRUPT;
+
+    m->pe_kind = 0;
+    if (flags & 1) m->pe_kind |= 1;          /* COMIMAGE_FLAGS_ILONLY -> peILonly */
+    if (flags & 2) m->pe_kind |= 2;          /* 32BITREQUIRED -> pe32BitRequired */
+    if (flags & 0x20000) m->pe_kind |= 0x10; /* 32BITPREFERRED */
+    if (pe32plus) m->pe_kind |= 4;           /* pe32Plus */
+
+    hr = parse_root(m, data + off, md_size);
+    return hr;
+}
