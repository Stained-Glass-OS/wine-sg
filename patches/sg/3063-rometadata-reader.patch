+#define TK_T(tk) ((tk) >> 24)
+#define TK_R(tk) ((tk) & 0xffffff)
+#define MKTK(t, r) (((ULONG32)(t) << 24) | (r))
+
+enum { T_MODULE = 0, T_TYPEREF = 1, T_TYPEDEF = 2, T_FIELD = 4, T_METHOD = 6, T_PARAM = 8, T_IFACEIMPL = 9,
+       T_MEMBERREF = 0xa, T_CONSTANT = 0xb, T_CA = 0xc, T_FMARSHAL = 0xd, T_DECLSEC = 0xe, T_CLASSLAYOUT = 0xf,
+       T_FIELDLAYOUT = 0x10, T_STANDALONESIG = 0x11, T_EVENTMAP = 0x12, T_EVENT = 0x14, T_PROPMAP = 0x15,
+       T_PROPERTY = 0x17, T_METHODSEM = 0x18, T_METHODIMPL = 0x19, T_MODULEREF = 0x1a, T_TYPESPEC = 0x1b,
+       T_IMPLMAP = 0x1c, T_FIELDRVA = 0x1d, T_ASSEMBLY = 0x20, T_ASMREF = 0x23, T_FILE = 0x26,
+       T_EXPORTED = 0x27, T_MANIFESTRES = 0x28, T_NESTED = 0x29, T_GENERICPARAM = 0x2a, T_METHODSPEC = 0x2b,
+       T_GPC = 0x2c };
+
+static BOOL tk_is(const struct md_scope *m, ULONG32 tk, unsigned int table)
+{
+    return TK_T(tk) == table && TK_R(tk) >= 1 && TK_R(tk) <= m->tables[table].rows;
+}
+
+/* [start, end) row range of the children of a parent row, via a "list" column */
+static void child_range(const struct md_scope *m, unsigned int parent, ULONG prid, unsigned int listcol,
+                        unsigned int child, ULONG *start, ULONG *end)
+{
+    ULONG crows = m->tables[child].rows;
+
+    *start = cell(m, parent, prid, listcol);
+    *end = prid < m->tables[parent].rows ? cell(m, parent, prid + 1, listcol) : crows + 1;
+#ifdef SG_MUTANT_RANGE
+    if (prid < m->tables[parent].rows) (*end)++;
+#endif
+    if (*end > crows + 1) *end = crows + 1;
+    if (*start > *end) *start = *end;
+}
+
+/* the parent row whose list range contains child row rid */
+static ULONG owner_of(const struct md_scope *m, unsigned int parent, unsigned int listcol, ULONG rid)
+{
+    ULONG lo = 1, hi = m->tables[parent].rows, best = 0;
+
+    while (lo <= hi && hi)
+    {
+        ULONG mid = lo + (hi - lo) / 2;
+        if (cell(m, parent, mid, listcol) <= rid) { best = mid; lo = mid + 1; }
+        else hi = mid - 1;
+    }
+    return best;
+}
+
+static BOOL name_eq(const char *a, const char *b) { return !strcmp(a, b); }
+
+/* "Ns.Name" split at the last dot; returns malloc'd utf8 */
+static char *split_name(const WCHAR *w, const char **ns, const char **name)
+{
+    char *u = to_utf8(w), *dot;
+
+    if (!u) return NULL;
+    dot = strrchr(u, '.');
+    if (dot) { *dot = 0; *ns = u; *name = dot + 1; }
+    else { *ns = ""; *name = u; }
+    return u;
+}
+
+static ULONG32 typedef_owner_of_method(const struct md_scope *m, ULONG32 mb)
+{
+    ULONG o = owner_of(m, T_TYPEDEF, 5, TK_R(mb));
+    return o ? MKTK(T_TYPEDEF, o) : 0;
+}
+
+static ULONG32 typedef_owner_of_field(const struct md_scope *m, ULONG32 fd)
+{
+    ULONG o = owner_of(m, T_TYPEDEF, 4, TK_R(fd));
+    return o ? MKTK(T_TYPEDEF, o) : 0;
+}
+
+static ULONG find_constant(const struct md_scope *m, ULONG32 parent)
+{
+    ULONG v = encode_coded(CI_HASCONSTANT, parent), i;
+
+    if (v == ~0u) return 0;
+    for (i = 1; i <= rows(m, T_CONSTANT); i++)
+        if (cell(m, T_CONSTANT, i, 2) == v) return i;
+    return 0;
+}
+
+static void constant_out(const struct md_scope *m, ULONG32 parent, DWORD *type, const void **value, ULONG *cch)
+{
+    ULONG row = find_constant(m, parent), size;
+    const BYTE *data;
+
+    if (type) *type = ELEMENT_TYPE_END;
+    if (value) *value = NULL;
+    if (cch) *cch = 0;
+    if (!row) return;
+    if (type) *type = cell(m, T_CONSTANT, row, 0);
+    cell_blob(m, T_CONSTANT, row, 3, &data, &size);
+    if (value) *value = data;
+    if (cch && cell(m, T_CONSTANT, row, 0) == ELEMENT_TYPE_STRING) *cch = size / sizeof(WCHAR);
+}
