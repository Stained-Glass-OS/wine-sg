+static HRESULT WINAPI import_GetNameFromToken(IMetaDataImport2 *iface, ULONG32 tk, const char **name)
+{
+    struct md_scope *m = impl_from_import(iface);
+    static const signed char name_col[NUM_TABLES] =
+    {
+        [T_MODULE] = 1, [T_TYPEREF] = 1, [T_TYPEDEF] = 1, [T_FIELD] = 1, [T_METHOD] = 3, [T_PARAM] = 2,
+        [T_MEMBERREF] = 1, [T_EVENT] = 1, [T_PROPERTY] = 1, [T_MODULEREF] = 0, [T_ASSEMBLY] = 7, [T_ASMREF] = 6,
+        [T_FILE] = 1, [T_EXPORTED] = 2, [T_MANIFESTRES] = 2, [T_GENERICPARAM] = 3,
+    };
+    unsigned int t = TK_T(tk);
+
+    TRACE("%p %#x %p\n", iface, tk, name);
+
+    if (!name) return E_INVALIDARG;
+    *name = NULL;
+    if (t == (mdtName >> 24))
+    {
+        if (TK_R(tk) >= m->strings_size) return CLDB_E_INDEX_NOTFOUND;
+        *name = get_str(m, TK_R(tk));
+        return S_OK;
+    }
+    if (t >= NUM_TABLES || !(name_col[t] || t == T_MODULE || t == T_MODULEREF)) return META_E_INVALID_TOKEN_TYPE;
+    if (!tk_is(m, tk, t)) return CLDB_E_INDEX_NOTFOUND;
+    *name = cell_str(m, t, TK_R(tk), name_col[t]);
+    return S_OK;
+}
