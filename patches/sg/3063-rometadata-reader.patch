+static HRESULT WINAPI import_FindMemberRef(IMetaDataImport2 *iface, ULONG32 td, const WCHAR *name, const BYTE *sig,
+                                           ULONG cbsig, ULONG32 *pmr)
+{
+    struct md_scope *m = impl_from_import(iface);
+    ULONG v = encode_coded(CI_MEMBERREFPARENT, td), i;
+    HRESULT hr = CLDB_E_RECORD_NOTFOUND;
+    char *u;
+
+    TRACE("%p %#x %s %p %lu %p\n", iface, td, debugstr_w(name), sig, cbsig, pmr);
+
+    if (!name || !pmr || v == ~0u) return E_INVALIDARG;
+    *pmr = 0;
+    if (!(u = to_utf8(name))) return E_OUTOFMEMORY;
+    for (i = 1; i <= rows(m, T_MEMBERREF); i++)
+    {
+        const BYTE *data;
+        ULONG size;
+
+        if (cell(m, T_MEMBERREF, i, 0) != v || !name_eq(cell_str(m, T_MEMBERREF, i, 1), u)) continue;
+        if (sig && cbsig)
+        {
+            cell_blob(m, T_MEMBERREF, i, 2, &data, &size);
+            if (size != cbsig || memcmp(data, sig, size)) continue;
+        }
+        *pmr = MKTK(T_MEMBERREF, i);
+        hr = S_OK;
+        break;
+    }
+    free(u);
+    return hr;
+}
