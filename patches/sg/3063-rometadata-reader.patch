+static HRESULT WINAPI import_QueryInterface(IMetaDataImport2 *iface, REFIID riid, void **obj)
+{
+    struct md_scope *m = impl_from_import(iface);
+
+    TRACE("%p %s %p\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IMetaDataImport)
+        || IsEqualGUID(riid, &IID_IMetaDataImport2))
+        *obj = &m->import_iface;
+    else if (IsEqualGUID(riid, &IID_IMetaDataAssemblyImport))
+        *obj = &m->asm_iface;
+    else
+    {
+        WARN("Unsupported interface %s\n", debugstr_guid(riid));
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*obj);
+    return S_OK;
+}
