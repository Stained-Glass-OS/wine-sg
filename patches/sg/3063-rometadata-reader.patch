+/* ---- entry points ---- */
+
+static HRESULT scope_create(const void *data, SIZE_T size, struct md_scope **ret)
+{
+    struct md_scope *m;
+    HRESULT hr;
+
+    if (!(m = calloc(1, sizeof(*m)))) return E_OUTOFMEMORY;
+    if (!(m->file = malloc(size ? size : 1)))
+    {
+        free(m);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(m->file, data, size);
+    m->file_size = size;
+    m->import_iface.lpVtbl = &import_vtbl;
+    m->asm_iface.lpVtbl = &asm_vtbl;
+    m->refcount = 1;
+    if (FAILED(hr = parse_image(m, m->file, size)))
+    {
+        free(m->file);
+        free(m);
+        return hr;
+    }
+    *ret = m;
+    return S_OK;
+}
+
+#define OPEN_FLAG_WRITE 0x1
+
+HRESULT metadata_open_memory(const void *data, ULONG size, DWORD flags, REFIID riid, IUnknown **obj)
+{
+    struct md_scope *m;
+    HRESULT hr;
+
+    if (!obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (!data || !size) return E_INVALIDARG;
+    if (flags & OPEN_FLAG_WRITE) return E_NOTIMPL;
+    if (FAILED(hr = scope_create(data, size, &m))) return hr;
+    hr = IMetaDataImport2_QueryInterface(&m->import_iface, riid, (void **)obj);
+    IMetaDataImport2_Release(&m->import_iface);
+    return hr;
+}
+
+HRESULT metadata_open_file(const WCHAR *path, DWORD flags, REFIID riid, IUnknown **obj)
+{
+    LARGE_INTEGER size;
+    HANDLE file;
+    BYTE *buf;
+    DWORD read;
+    HRESULT hr;
+
+    if (!path || !obj) return E_INVALIDARG;
+    *obj = NULL;
+    if (flags & OPEN_FLAG_WRITE) return E_NOTIMPL;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                       FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    if (!GetFileSizeEx(file, &size) || size.QuadPart > 0x10000000 || !size.QuadPart)
+    {
+        CloseHandle(file);
+        return size.QuadPart ? CLDB_E_FILE_CORRUPT : CLDB_E_NO_DATA;
+    }
+    if (!(buf = malloc(size.LowPart)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, buf, size.LowPart, &read, NULL) || read != size.LowPart)
+    {
+        hr = CLDB_E_FILE_BADREAD;
+        goto done;
+    }
+    hr = metadata_open_memory(buf, size.LowPart, flags, riid, obj);
+done:
+    free(buf);
+    CloseHandle(file);
+    return hr;
+}
