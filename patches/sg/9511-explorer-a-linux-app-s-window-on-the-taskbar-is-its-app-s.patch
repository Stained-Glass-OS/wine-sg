+/* Stained Glass OS 9511: pin a program by its own shortcut (a Linux app's
+ * in Start: what starts it is the shortcut, and its AppUserModelID is in
+ * it), as Windows pins a window whose program a shortcut started: a copy,
+ * named after it, last in the order */
+BOOL pins_add_link( const WCHAR *src, const WCHAR *name )
+{
+    WCHAR dir[MAX_PATH], lnk[MAX_PATH], clean[MAX_PATH], *p;
+    struct taskbar_pin *pins;
+    int count;
+
+    if (!pins_dir( dir )) return FALSE;
+    SHCreateDirectoryExW( NULL, dir, NULL );
+    if (name && name[0]) lstrcpynW( clean, name, MAX_PATH );
+    else
+    {
+        lstrcpynW( clean, wcsrchr( src, '\\' ) ? wcsrchr( src, '\\' ) + 1 : src, MAX_PATH );
+        if (wcsrchr( clean, '.' )) *wcsrchr( clean, '.' ) = 0;
+    }
+    for (p = clean; *p; p++) if (wcschr( L"\\/:*?\"<>|", *p )) *p = '_';
+    swprintf( lnk, MAX_PATH, L"%s\\%s.lnk", dir, clean );
+    if (!CopyFileW( src, lnk, FALSE )) return FALSE;
+    if ((pins = pins_load( &count )))
+    {
+        int i, at = -1;
+        for (i = 0; i < count; i++) if (!wcsicmp( pins[i].lnk, lnk )) at = i;
+        if (at >= 0 && at != count - 1)
+        {
+            struct taskbar_pin moved = pins[at];
+            memmove( &pins[at], &pins[at + 1], (count - at - 1) * sizeof(*pins) );
+            pins[count - 1] = moved;
+        }
+        pins_save_order( pins, count );
+        pins_free( pins, count );
+    }
+    return TRUE;
+}
