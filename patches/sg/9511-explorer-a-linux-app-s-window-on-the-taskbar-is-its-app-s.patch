+/* Stained Glass OS 9511: the shortcut's own System.AppUserModel.ID, as
+ * Windows' taskbar matches a pinned shortcut with its program's running
+ * windows: by that ID when the shortcut has one (a Linux app's shortcut --
+ * every one starts sg-linuxapp64.exe -- names its app this way), else by the
+ * program it starts */
+static const PROPERTYKEY pin_pkey_aumid = {{0x9f4c2855, 0x9f79, 0x4b39, {0xa8, 0xd0, 0xe1, 0xd4, 0x2d, 0xe1, 0xd5, 0xf3}}, 5};
+
+static void pin_appid( IShellLinkW *link, WCHAR *appid, int size )
+{
+    IPropertyStore *store;
+    PROPVARIANT value;
+
+    appid[0] = 0;
+    if (FAILED(IShellLinkW_QueryInterface( link, &IID_IPropertyStore, (void **)&store ))) return;
+    PropVariantInit( &value );
+    if (SUCCEEDED(IPropertyStore_GetValue( store, &pin_pkey_aumid, &value )) && value.vt == VT_LPWSTR && value.pwszVal)
+        lstrcpynW( appid, value.pwszVal, size );
+    PropVariantClear( &value );
+    IPropertyStore_Release( store );
+}
+
+/* whether a pin is the button of windows with this AppUserModelID / program */
+BOOL pins_match( const struct taskbar_pin *pin, const WCHAR *appid, const WCHAR *exe )
+{
+#ifndef SG_MUTANT_PIN_NO_APPID
+    if (pin->appid[0] && appid && appid[0] && !wcsicmp( pin->appid, appid )) return TRUE;
+#endif
+    return exe && exe[0] && pin->target[0] && !wcsicmp( pin->target, exe );
+}
