+/* Stained Glass OS 9511: the app a Linux window is, as Windows knows a
+ * window's app by its AppUserModelID. sg-shell's sg-linuxapp gives each
+ * Linux app's Start shortcut the ID SG.LinuxApp.<desktop id>, lists the
+ * window classes its windows have (StartupWMClass, its program's name, its
+ * desktop id) under HKCU\Software\Stained Glass\Linux apps\Window classes,
+ * and registers the ID (HKCU\Software\Classes\AppUserModelId\<ID>:
+ * DisplayName, RelaunchCommand, SgShortcut) -- so the window's button is its
+ * pinned shortcut's, takes the app's jump list (its .desktop actions), and
+ * its menu names the app, starts another and pins it. */
+static void sg_linux_app_ids( struct taskbar_button *win )
+{
+    WCHAR key[200], command[MAX_PATH * 2];
+    DWORD size;
+
+    win->appid[0] = 0;
+    free( win->relaunch );
+    win->relaunch = NULL;
+    if (!win->xclass[0]) return;
+    size = sizeof(win->appid) - sizeof(WCHAR);
+    if (RegGetValueW( HKEY_CURRENT_USER, L"Software\\Stained Glass\\Linux apps\\Window classes", win->xclass,
+                      RRF_RT_REG_SZ, NULL, win->appid, &size ))
+    {
+        win->appid[0] = 0;
+        return;
+    }
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Classes\\AppUserModelId\\%s", win->appid );
+    size = sizeof(command);
+    if (!RegGetValueW( HKEY_CURRENT_USER, key, L"RelaunchCommand", RRF_RT_REG_SZ, NULL, command, &size ) && command[0])
+        win->relaunch = wcsdup( command );
+}
+
+/* a value of a Linux app's AppUserModelID key (DisplayName, SgShortcut) */
+static BOOL sg_linux_app_value( const WCHAR *appid, const WCHAR *name, WCHAR *out, DWORD len )
+{
+    WCHAR key[200];
+    DWORD size = len * sizeof(WCHAR);
+
+    out[0] = 0;
+    if (!appid[0]) return FALSE;
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Classes\\AppUserModelId\\%s", appid );
+    if (RegGetValueW( HKEY_CURRENT_USER, key, name, RRF_RT_REG_SZ, NULL, out, &size )) out[0] = 0;
+    return out[0] != 0;
+}
