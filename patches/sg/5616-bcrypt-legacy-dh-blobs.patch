From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: export and import the version 3 Diffie-Hellman blobs

bcrypt: export and import the version 3 Diffie-Hellman blobs

LEGACY_DH_PUBLIC_BLOB ("CAPIDHPUBLICBLOB") and LEGACY_DH_PRIVATE_BLOB
("CAPIDHPRIVATEBLOB") are the CryptoAPI version 3 layouts (BLOBHEADER, the
DHPUBKEY_VER3 / DHPRIVKEY_VER3 header, P, Q, G, J, Y and X, little-endian).
---
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1331,6 +1331,164 @@ static NTSTATUS key_import( struct algorithm *alg, const WCHAR *type, BCRYPT_KEY
     return STATUS_NOT_IMPLEMENTED;
 }
 
+static NTSTATUS key_export( struct key *key, const WCHAR *type, UCHAR *output, ULONG output_len, ULONG *size );
+
+struct legacy_dh_blobheader
+{
+    BYTE  bType;
+    BYTE  bVersion;
+    WORD  reserved;
+    DWORD aiKeyAlg;
+};
+
+struct legacy_dh_seed
+{
+    DWORD counter;
+    BYTE  seed[20];
+};
+
+struct legacy_dh_header
+{
+    DWORD magic;
+    DWORD bitlenP;
+    DWORD bitlenQ;
+    DWORD bitlenJ;
+};
+
+#define LEGACY_DH_PUBLIC_MAGIC  0x33484400  /* "DH3" */
+#define LEGACY_DH_PRIVATE_MAGIC 0x34484400  /* "DH4" */
+#define LEGACY_PUBLICKEYBLOB    6
+#define LEGACY_PRIVATEKEYBLOB   7
+#define LEGACY_CALG_DH_SF       0xaa05
+
+static void copy_reversed( UCHAR *dst, const UCHAR *src, ULONG len )
+{
+    ULONG i;
+#ifdef SG_MUTANT_LEGACY_DH_BE
+    memcpy( dst, src, len );
+    return;
+#endif
+    for (i = 0; i < len; i++) dst[i] = src[len - 1 - i];
+}
+
+/* version 3 Diffie-Hellman blobs: BLOBHEADER, a header (with bitlenX before the seed in the private
+ * one), then P, Q, G, J, Y (and X), little-endian. Q and J are absent when their length is 0. */
+static NTSTATUS key_export_legacy_dh( struct key *key, BOOL priv, UCHAR *output, ULONG output_len, ULONG *size )
+{
+    ULONG blob_len, cb, hdr_len, req_size;
+    BCRYPT_DH_KEY_BLOB *blob;
+    NTSTATUS status;
+    UCHAR *src, *dst;
+    int fields = priv ? 4 : 3;
+
+    status = key_export( key, priv ? BCRYPT_DH_PRIVATE_BLOB : BCRYPT_DH_PUBLIC_BLOB, NULL, 0, &blob_len );
+    if (status && status != STATUS_BUFFER_TOO_SMALL) return status;
+    if (!(blob = malloc( blob_len ))) return STATUS_NO_MEMORY;
+    if ((status = key_export( key, priv ? BCRYPT_DH_PRIVATE_BLOB : BCRYPT_DH_PUBLIC_BLOB, (UCHAR *)blob, blob_len,
+                              &blob_len )))
+    {
+        free( blob );
+        return status;
+    }
+    cb = blob->cbKey;
+    hdr_len = sizeof(struct legacy_dh_blobheader) + sizeof(struct legacy_dh_header) + (priv ? sizeof(DWORD) : 0) +
+              sizeof(struct legacy_dh_seed);
+    req_size = hdr_len + cb * fields;
+    *size = req_size;
+    if (!output) { free( blob ); return STATUS_SUCCESS; }
+    if (output_len < req_size) { free( blob ); return STATUS_BUFFER_TOO_SMALL; }
+
+    {
+        struct legacy_dh_blobheader *bh = (struct legacy_dh_blobheader *)output;
+        struct legacy_dh_header *h = (struct legacy_dh_header *)(bh + 1);
+        DWORD *bitlen_x = (DWORD *)(h + 1);
+        struct legacy_dh_seed *seed = (struct legacy_dh_seed *)(priv ? bitlen_x + 1 : (DWORD *)(h + 1));
+
+        bh->bType = priv ? LEGACY_PRIVATEKEYBLOB : LEGACY_PUBLICKEYBLOB;
+        bh->bVersion = 3;
+        bh->reserved = 0;
+        bh->aiKeyAlg = LEGACY_CALG_DH_SF;
+        h->magic = priv ? LEGACY_DH_PRIVATE_MAGIC : LEGACY_DH_PUBLIC_MAGIC;
+        h->bitlenP = cb * 8;
+        h->bitlenQ = 0;
+        h->bitlenJ = 0;
+        if (priv) *bitlen_x = cb * 8;
+        seed->counter = 0xffffffff; /* no generation seed */
+        memset( seed->seed, 0, sizeof(seed->seed) );
+    }
+
+    /* BCRYPT_DH_KEY_BLOB: P, G, Y (, X) big-endian, cbKey each; the legacy order is P, G, Y (, X) as Q and J are absent */
+    src = (UCHAR *)(blob + 1);
+    dst = output + hdr_len;
+    {
+        int i;
+        for (i = 0; i < fields; i++) copy_reversed( dst + i * cb, src + i * cb, cb );
+    }
+    free( blob );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS key_import_pair( struct algorithm *alg, const WCHAR *type, BCRYPT_KEY_HANDLE *ret_key, UCHAR *input,
+                                 ULONG input_len );
+
+static NTSTATUS key_import_legacy_dh( struct algorithm *alg, BOOL priv, BCRYPT_KEY_HANDLE *key, UCHAR *input,
+                                      ULONG input_len )
+{
+    const struct legacy_dh_blobheader *bh = (const struct legacy_dh_blobheader *)input;
+    const struct legacy_dh_header *h = (const struct legacy_dh_header *)(bh + 1);
+    ULONG cb, qb, jb, xb = 0, hdr_len, i;
+    const UCHAR *p, *q_, *g, *j, *y, *x = NULL;
+    BCRYPT_DH_KEY_BLOB *blob;
+    NTSTATUS status;
+    UCHAR *dst;
+
+    hdr_len = sizeof(*bh) + sizeof(*h) + (priv ? sizeof(DWORD) : 0) + sizeof(struct legacy_dh_seed);
+    if (input_len < hdr_len) return STATUS_INVALID_PARAMETER;
+    if (bh->bType != (priv ? LEGACY_PRIVATEKEYBLOB : LEGACY_PUBLICKEYBLOB) || bh->bVersion != 3)
+        return STATUS_INVALID_PARAMETER;
+    if (h->magic != (priv ? LEGACY_DH_PRIVATE_MAGIC : LEGACY_DH_PUBLIC_MAGIC)) return STATUS_NOT_SUPPORTED;
+    if (alg->id != ALG_ID_DH) return STATUS_NOT_SUPPORTED;
+    if (h->bitlenP % 8 || h->bitlenQ % 8 || h->bitlenJ % 8 || !h->bitlenP) return STATUS_INVALID_PARAMETER;
+    cb = h->bitlenP / 8;
+    qb = h->bitlenQ / 8;
+    jb = h->bitlenJ / 8;
+    if (priv)
+    {
+        DWORD bitlen_x = *(const DWORD *)(h + 1);
+        if (bitlen_x % 8 || bitlen_x / 8 > cb) return STATUS_INVALID_PARAMETER;
+        xb = bitlen_x / 8;
+    }
+#ifdef SG_MUTANT_LEGACY_DH_NOQJ
+    qb = jb = 0;
+#endif
+    if (qb > cb || jb > cb || input_len != hdr_len + cb * 3 + qb + jb + xb) return STATUS_INVALID_PARAMETER;
+
+    p = input + hdr_len;
+    q_ = p + cb;
+    g = q_ + qb;
+    j = g + cb;
+    y = j + jb;
+    x = y + cb;
+    (void)q_; (void)j;
+
+    if (!(blob = malloc( sizeof(*blob) + cb * (priv ? 4 : 3) ))) return STATUS_NO_MEMORY;
+    blob->dwMagic = priv ? BCRYPT_DH_PRIVATE_MAGIC : BCRYPT_DH_PUBLIC_MAGIC;
+    blob->cbKey = cb;
+    dst = (UCHAR *)(blob + 1);
+    copy_reversed( dst, p, cb );
+    copy_reversed( dst + cb, g, cb );
+    copy_reversed( dst + 2 * cb, y, cb );
+    if (priv)
+    {
+        memset( dst + 3 * cb, 0, cb - xb );
+        for (i = 0; i < xb; i++) dst[3 * cb + cb - 1 - i] = x[i];
+    }
+    status = key_import_pair( alg, priv ? BCRYPT_DH_PRIVATE_BLOB : BCRYPT_DH_PUBLIC_BLOB, key, (UCHAR *)blob,
+                              sizeof(*blob) + cb * (priv ? 4 : 3) );
+    free( blob );
+    return status;
+}
+
 static NTSTATUS key_export( struct key *key, const WCHAR *type, UCHAR *output, ULONG output_len, ULONG *size )
 {
     struct key_asymmetric_export_params params;
@@ -1395,6 +1553,11 @@ static NTSTATUS key_export( struct key *key, const WCHAR *type, UCHAR *output, U
         return UNIX_CALL( key_asymmetric_export, &params );
     }
 
+    else if (!wcscmp( type, LEGACY_DH_PUBLIC_BLOB ) || !wcscmp( type, LEGACY_DH_PRIVATE_BLOB ))
+    {
+        if (key->alg_id != ALG_ID_DH) return STATUS_NOT_SUPPORTED;
+        return key_export_legacy_dh( key, !wcscmp( type, LEGACY_DH_PRIVATE_BLOB ), output, output_len, size );
+    }
     else if (!wcscmp( type, BCRYPT_PUBLIC_KEY_BLOB ) || !wcscmp( type, BCRYPT_PRIVATE_KEY_BLOB ))
     {
         /* the generic blob types are the key's own, whatever its algorithm */
@@ -2024,6 +2187,10 @@ static NTSTATUS key_import_pair( struct algorithm *alg, const WCHAR *type, BCRYP
             return status;
         }
     }
+    else if (!wcscmp( type, LEGACY_DH_PUBLIC_BLOB ) || !wcscmp( type, LEGACY_DH_PRIVATE_BLOB ))
+    {
+        return key_import_legacy_dh( alg, !wcscmp( type, LEGACY_DH_PRIVATE_BLOB ), ret_key, input, input_len );
+    }
     else
     {
         FIXME( "unsupported key type %s\n", debugstr_w(type) );
--- a/dlls/bcrypt/tests/bcrypt.c
+++ b/dlls/bcrypt/tests/bcrypt.c
@@ -4549,6 +4549,115 @@ static void test_generic_key_blobs(void)
     }
 }
 
+static void reverse_bytes(BYTE *dst, const BYTE *src, ULONG len)
+{
+    ULONG i;
+    for (i = 0; i < len; i++) dst[i] = src[len - 1 - i];
+}
+
+static void test_legacy_dh_blobs(void)
+{
+    struct { BYTE type, version; WORD reserved; DWORD alg; } *header;
+    DWORD *dwords;
+    BYTE *buf, *check, *legacy;
+    BCRYPT_KEY_HANDLE key, key2;
+    ULONG size, size2, cb = 64, hdr, i;
+    NTSTATUS status;
+    int priv;
+
+    if (!pBCryptHash) return; /* broken DH */
+
+    for (priv = 0; priv <= 1; priv++)
+    {
+        const WCHAR *type = priv ? LEGACY_DH_PRIVATE_BLOB : LEGACY_DH_PUBLIC_BLOB;
+        const BYTE *fixture = priv ? dh_privkey : dh_pubkey;
+        ULONG fixture_size = priv ? sizeof(dh_privkey) : sizeof(dh_pubkey);
+        ULONG fields = priv ? 4 : 3;
+
+        key = NULL;
+        status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, priv ? BCRYPT_DH_PRIVATE_BLOB : BCRYPT_DH_PUBLIC_BLOB,
+                &key, (BYTE *)fixture, fixture_size, 0);
+        ok(!status, "%d: got %#lx\n", priv, status);
+
+        size = 0;
+        status = BCryptExportKey(key, NULL, type, NULL, 0, &size, 0);
+        ok(!status, "%d: got %#lx\n", priv, status);
+        hdr = 8 + 16 + (priv ? 4 : 0) + 24;
+        ok(size == hdr + cb * fields, "%d: got size %lu\n", priv, size);
+
+        buf = calloc(1, size);
+        status = BCryptExportKey(key, NULL, type, buf, size - 1, &size2, 0);
+        ok(status == STATUS_BUFFER_TOO_SMALL, "%d: got %#lx\n", priv, status);
+        status = BCryptExportKey(key, NULL, type, buf, size, &size2, 0);
+        ok(!status && size2 == size, "%d: got %#lx, %lu\n", priv, status, size2);
+
+        header = (void *)buf;
+        dwords = (DWORD *)(buf + 8);
+        ok(header->type == (priv ? 7 : 6) && header->version == 3, "%d: got type %u version %u\n", priv, header->type,
+                header->version);
+        ok(dwords[0] == (priv ? 0x34484400 : 0x33484400), "%d: got magic %#lx\n", priv, dwords[0]);
+        ok(dwords[1] == 512 && dwords[2] == 0 && dwords[3] == 0, "%d: got lengths %lu %lu %lu\n", priv, dwords[1],
+                dwords[2], dwords[3]);
+        if (priv) ok(dwords[4] == 512, "got bitlenX %lu\n", dwords[4]);
+
+        /* P, G, Y (and X) are the BCRYPT blob's values, little-endian */
+        check = malloc(cb);
+        for (i = 0; i < fields; i++)
+        {
+            reverse_bytes(check, fixture + 8 + i * cb, cb);
+            ok(!memcmp(buf + hdr + i * cb, check, cb), "%d: field %lu differs\n", priv, i);
+        }
+        free(check);
+
+        /* and it goes back in */
+        key2 = NULL;
+        status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, type, &key2, buf, size, 0);
+        ok(!status, "%d: got %#lx\n", priv, status);
+        size2 = 0;
+        check = malloc(fixture_size);
+        status = BCryptExportKey(key2, NULL, priv ? BCRYPT_DH_PRIVATE_BLOB : BCRYPT_DH_PUBLIC_BLOB, check, fixture_size,
+                &size2, 0);
+        ok(!status && size2 == fixture_size && !memcmp(check, fixture, fixture_size), "%d: got %#lx, wrong data\n",
+                priv, status);
+        free(check);
+        BCryptDestroyKey(key2);
+
+        /* Q and J, when present, are skipped */
+        {
+            ULONG extra_q = 20, extra_j = 4, xb = priv ? cb : 0, total = size + extra_q + extra_j;
+
+            legacy = calloc(1, total);
+            memcpy(legacy, buf, hdr + cb);                       /* header, P */
+            memset(legacy + hdr + cb, 0xa5, extra_q);            /* Q */
+            memcpy(legacy + hdr + cb + extra_q, buf + hdr + cb, cb);          /* G */
+            memset(legacy + hdr + cb * 2 + extra_q, 0x5a, extra_j);           /* J */
+            memcpy(legacy + hdr + cb * 2 + extra_q + extra_j, buf + hdr + cb * 2, cb + xb);  /* Y, X */
+            ((DWORD *)(legacy + 8))[2] = extra_q * 8;
+            ((DWORD *)(legacy + 8))[3] = extra_j * 8;
+            key2 = NULL;
+            status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, type, &key2, legacy, total, 0);
+            ok(!status, "%d: got %#lx\n", priv, status);
+            if (!status) BCryptDestroyKey(key2);
+
+            status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, type, &key2, legacy, total - 1, 0);
+            ok(status == STATUS_INVALID_PARAMETER, "%d: got %#lx\n", priv, status);
+            free(legacy);
+        }
+
+        /* the wrong magic */
+        buf[8] ^= 1;
+        status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, type, &key2, buf, size, 0);
+        ok(status == STATUS_NOT_SUPPORTED, "%d: got %#lx\n", priv, status);
+        buf[8] ^= 1;
+        status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, type, &key2, buf, size - 1, 0);
+        ok(status == STATUS_INVALID_PARAMETER, "%d: got %#lx\n", priv, status);
+        status = BCryptImportKeyPair(BCRYPT_DH_ALG_HANDLE, NULL, type, &key2, buf, 10, 0);
+        ok(status == STATUS_INVALID_PARAMETER, "%d: got %#lx\n", priv, status);
+        free(buf);
+        BCryptDestroyKey(key);
+    }
+}
+
 START_TEST(bcrypt)
 {
     HMODULE module;
@@ -4578,6 +4687,7 @@ START_TEST(bcrypt)
     test_RSA_SIGN();
     test_ECDH();
     test_DH();
+    test_legacy_dh_blobs();
     test_generic_key_blobs();
     test_BCryptEnumContextFunctions();
     test_BCryptSignHash();
--- a/include/bcrypt.h
+++ b/include/bcrypt.h
@@ -80,6 +80,8 @@ typedef LONG NTSTATUS;
 #define LEGACY_DSA_V2_PRIVATE_BLOB  L"V2CAPIDSAPRIVATEBLOB"
 #define LEGACY_RSAPUBLIC_BLOB       L"CAPIPUBLICBLOB"
 #define LEGACY_RSAPRIVATE_BLOB      L"CAPIPRIVATEBLOB"
+#define LEGACY_DH_PUBLIC_BLOB       L"CAPIDHPUBLICBLOB"
+#define LEGACY_DH_PRIVATE_BLOB      L"CAPIDHPRIVATEBLOB"
 
 #define MS_PRIMITIVE_PROVIDER       L"Microsoft Primitive Provider"
 #define MS_PLATFORM_CRYPTO_PROVIDER L"Microsoft Platform Crypto Provider"
