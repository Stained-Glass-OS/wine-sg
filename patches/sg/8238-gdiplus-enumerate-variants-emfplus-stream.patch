From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: metafile enumeration variants, GdipConvertToEmfPlusToStream

GdipEnumerateMetafileDestPoints/DestPointsI (three points, the whole metafile), GdipEnumerateMetafileSrcRectDestPoint/SrcRectDestPointI (a source rectangle drawn at a point at its own size) and GdipEnumerateMetafileSrcRectDestPointsI forward to the implemented variants. GdipConvertToEmfPlusToStream records the converted EMF+ into a stream as GdipConvertToEmfPlusToFile does into a file. They were spec stubs. gdiplusflat.h gains the enumeration prototypes.
---
--- a/include/gdiplusflat.h
+++ b/include/gdiplusflat.h
@@ -212,6 +212,16 @@
     GDIPCONST GpBrush*);
 GpStatus WINGDIPAPI GdipEnumerateMetafileDestPoint(GpGraphics*,GDIPCONST GpMetafile*,
     GDIPCONST GpPointF*,EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
+GpStatus WINGDIPAPI GdipEnumerateMetafileDestPoints(GpGraphics*,GDIPCONST GpMetafile*,GDIPCONST GpPointF*,INT,
+    EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
+GpStatus WINGDIPAPI GdipEnumerateMetafileDestPointsI(GpGraphics*,GDIPCONST GpMetafile*,GDIPCONST GpPoint*,INT,
+    EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPoint(GpGraphics*,GDIPCONST GpMetafile*,GDIPCONST GpPointF*,
+    GDIPCONST GpRectF*,Unit,EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPointI(GpGraphics*,GDIPCONST GpMetafile*,GDIPCONST GpPoint*,
+    GDIPCONST GpRect*,Unit,EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPointsI(GpGraphics*,GDIPCONST GpMetafile*,GDIPCONST GpPoint*,INT,
+    GDIPCONST GpRect*,Unit,EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
 GpStatus WINGDIPAPI GdipEnumerateMetafileDestPointI(GpGraphics*,GDIPCONST GpMetafile*,
     GDIPCONST GpPoint*,EnumerateMetafileProc,VOID*,GDIPCONST GpImageAttributes*);
 GpStatus WINGDIPAPI GdipEnumerateMetafileDestRect(GpGraphics*,GDIPCONST GpMetafile*,
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4475,6 +4475,104 @@
     return GdipEnumerateMetafileDestPoint(graphics, metafile, &ptf, callback, cb_data, attrs);
 }
 
+#ifndef SG_MUTANT_GP_ENUM_VARIANTS
+/* (wine-sg 8238) the enumeration variants of the flat API that were spec stubs: points to parallelograms,
+ * integer coordinates to floats, a source rectangle drawn at a point at its own size */
+GpStatus WINGDIPAPI GdipEnumerateMetafileDestPoints(GpGraphics *graphics, GDIPCONST GpMetafile *metafile,
+    GDIPCONST GpPointF *dests, INT count, EnumerateMetafileProc callback, VOID *cb_data,
+    GDIPCONST GpImageAttributes *attrs)
+{
+    TRACE("(%p,%p,%p,%d,%p,%p,%p)\n", graphics, metafile, dests, count, callback, cb_data, attrs);
+
+    if (!graphics || !metafile || !dests) return InvalidParameter;
+    return GdipEnumerateMetafileSrcRectDestPoints(graphics, metafile, dests, count, &metafile->bounds,
+        metafile->unit, callback, cb_data, attrs);
+}
+
+static void points_from_int(const GpPoint *in, GpPointF *out, INT count)
+{
+    INT i;
+    for (i = 0; i < count; i++)
+    {
+        out[i].X = in[i].X;
+        out[i].Y = in[i].Y;
+    }
+}
+
+GpStatus WINGDIPAPI GdipEnumerateMetafileDestPointsI(GpGraphics *graphics, GDIPCONST GpMetafile *metafile,
+    GDIPCONST GpPoint *dests, INT count, EnumerateMetafileProc callback, VOID *cb_data,
+    GDIPCONST GpImageAttributes *attrs)
+{
+    GpPointF points[3];
+
+    TRACE("(%p,%p,%p,%d,%p,%p,%p)\n", graphics, metafile, dests, count, callback, cb_data, attrs);
+
+    if (!graphics || !metafile || !dests || count != 3) return InvalidParameter;
+    points_from_int(dests, points, 3);
+    return GdipEnumerateMetafileDestPoints(graphics, metafile, points, 3, callback, cb_data, attrs);
+}
+
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPoint(GpGraphics *graphics, GDIPCONST GpMetafile *metafile,
+    GDIPCONST GpPointF *dest, GDIPCONST GpRectF *src, Unit srcUnit, EnumerateMetafileProc callback,
+    VOID *cb_data, GDIPCONST GpImageAttributes *attrs)
+{
+    GpRectF destf;
+
+    TRACE("(%p,%p,%p,%p,%d,%p,%p,%p)\n", graphics, metafile, dest, src, srcUnit, callback, cb_data, attrs);
+
+    if (!graphics || !metafile || !dest || !src) return InvalidParameter;
+    destf.X = dest->X;
+    destf.Y = dest->Y;
+    destf.Width = units_to_pixels(src->Width, srcUnit, metafile->image.xres, metafile->printer_display);
+    destf.Height = units_to_pixels(src->Height, srcUnit, metafile->image.yres, metafile->printer_display);
+    return GdipEnumerateMetafileSrcRectDestRect(graphics, metafile, &destf, src, srcUnit, callback, cb_data, attrs);
+}
+
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPointI(GpGraphics *graphics, GDIPCONST GpMetafile *metafile,
+    GDIPCONST GpPoint *dest, GDIPCONST GpRect *src, Unit srcUnit, EnumerateMetafileProc callback,
+    VOID *cb_data, GDIPCONST GpImageAttributes *attrs)
+{
+    GpPointF destf;
+    GpRectF srcf;
+
+    if (!graphics || !metafile || !dest || !src) return InvalidParameter;
+    destf.X = dest->X;
+    destf.Y = dest->Y;
+    srcf.X = src->X;
+    srcf.Y = src->Y;
+    srcf.Width = src->Width;
+    srcf.Height = src->Height;
+    return GdipEnumerateMetafileSrcRectDestPoint(graphics, metafile, &destf, &srcf, srcUnit, callback, cb_data, attrs);
+}
+
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPointsI(GpGraphics *graphics, GDIPCONST GpMetafile *metafile,
+    GDIPCONST GpPoint *dests, INT count, GDIPCONST GpRect *src, Unit srcUnit, EnumerateMetafileProc callback,
+    VOID *cb_data, GDIPCONST GpImageAttributes *attrs)
+{
+    GpPointF points[3];
+    GpRectF srcf;
+
+    if (!graphics || !metafile || !dests || !src || count != 3) return InvalidParameter;
+    points_from_int(dests, points, 3);
+    srcf.X = src->X;
+    srcf.Y = src->Y;
+    srcf.Width = src->Width;
+    srcf.Height = src->Height;
+    return GdipEnumerateMetafileSrcRectDestPoints(graphics, metafile, points, 3, &srcf, srcUnit, callback, cb_data, attrs);
+}
+#else
+GpStatus WINGDIPAPI GdipEnumerateMetafileDestPoints(GpGraphics *g, GDIPCONST GpMetafile *m, GDIPCONST GpPointF *d, INT c,
+    EnumerateMetafileProc cb, VOID *data, GDIPCONST GpImageAttributes *a) { return NotImplemented; }
+GpStatus WINGDIPAPI GdipEnumerateMetafileDestPointsI(GpGraphics *g, GDIPCONST GpMetafile *m, GDIPCONST GpPoint *d, INT c,
+    EnumerateMetafileProc cb, VOID *data, GDIPCONST GpImageAttributes *a) { return NotImplemented; }
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPoint(GpGraphics *g, GDIPCONST GpMetafile *m, GDIPCONST GpPointF *d,
+    GDIPCONST GpRectF *s, Unit u, EnumerateMetafileProc cb, VOID *data, GDIPCONST GpImageAttributes *a) { return NotImplemented; }
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPointI(GpGraphics *g, GDIPCONST GpMetafile *m, GDIPCONST GpPoint *d,
+    GDIPCONST GpRect *s, Unit u, EnumerateMetafileProc cb, VOID *data, GDIPCONST GpImageAttributes *a) { return NotImplemented; }
+GpStatus WINGDIPAPI GdipEnumerateMetafileSrcRectDestPointsI(GpGraphics *g, GDIPCONST GpMetafile *m, GDIPCONST GpPoint *d,
+    INT c, GDIPCONST GpRect *s, Unit u, EnumerateMetafileProc cb, VOID *data, GDIPCONST GpImageAttributes *a) { return NotImplemented; }
+#endif
+
 GpStatus WINGDIPAPI GdipGetMetafileHeaderFromMetafile(GpMetafile * metafile,
     MetafileHeader * header)
 {
@@ -4858,7 +4956,7 @@
  * recording through a device context, so an EMF+ recording holds them behind a GetDC record, as a program
  * that draws with GDI on a GDI+ graphics object leaves them. */
 static GpStatus convert_to_emfplus(const GpGraphics *ref, GpMetafile *metafile, BOOL *succ, EmfType type,
-        const WCHAR *description, const WCHAR *filename, GpMetafile **out)
+        const WCHAR *description, const WCHAR *filename, IStream *stream, GpMetafile **out)
 {
     GpMetafile *recorded;
     GpGraphics *graphics;
@@ -4890,7 +4988,10 @@
     frame.Y = header.Y;
     frame.Width = header.Width;
     frame.Height = header.Height;
-    stat = GdipRecordMetafileFileName(filename, ref_dc, type, &frame, MetafileFrameUnitPixel, description, &recorded);
+    if (stream)   /* (wine-sg 8238) GdipConvertToEmfPlusToStream */
+        stat = GdipRecordMetafileStream(stream, ref_dc, type, &frame, MetafileFrameUnitPixel, description, &recorded);
+    else
+        stat = GdipRecordMetafileFileName(filename, ref_dc, type, &frame, MetafileFrameUnitPixel, description, &recorded);
     DeleteDC(ref_dc);
     if (stat != Ok)
         return stat;
@@ -4942,7 +5043,7 @@
         *succ = FALSE;
     *out_metafile = NULL;
 
-    return convert_to_emfplus(ref, metafile, succ, emfType, description, NULL, out_metafile);
+    return convert_to_emfplus(ref, metafile, succ, emfType, description, NULL, NULL, out_metafile);
 }
 
 #pragma pack(push,1)
@@ -5175,8 +5276,32 @@
         *conversionSuccess = FALSE;
     *out_metafile = NULL;
 
-    return convert_to_emfplus(refGraphics, metafile, conversionSuccess, emfType, description, filename, out_metafile);
+    return convert_to_emfplus(refGraphics, metafile, conversionSuccess, emfType, description, filename, NULL, out_metafile);
+}
+
+#ifndef SG_MUTANT_GP_ENUM_VARIANTS
+/*****************************************************************************
+ * GdipConvertToEmfPlusToStream [GDIPLUS.@]
+ *
+ * (wine-sg 8238) As GdipConvertToEmfPlusToFile, the EMF+ recorded into a stream.
+ */
+GpStatus WINGDIPAPI GdipConvertToEmfPlusToStream(const GpGraphics *ref, GpMetafile *metafile, INT *succ,
+        IStream *stream, EmfType emfType, const WCHAR *description, GpMetafile **out_metafile)
+{
+    TRACE("(%p,%p,%p,%p,%u,%s,%p)\n", ref, metafile, succ, stream, emfType, debugstr_w(description), out_metafile);
+
+    if (!ref || !metafile || !stream || !out_metafile || emfType < EmfTypeEmfOnly || emfType > EmfTypeEmfPlusDual)
+        return InvalidParameter;
+    if (metafile->metafile_type == MetafileTypeEmfPlusOnly || metafile->metafile_type == MetafileTypeEmfPlusDual)
+        return InvalidParameter;
+    if (succ) *succ = FALSE;
+    *out_metafile = NULL;
+    return convert_to_emfplus(ref, metafile, (BOOL *)succ, emfType, description, NULL, stream, out_metafile);
 }
+#else
+GpStatus WINGDIPAPI GdipConvertToEmfPlusToStream(const GpGraphics *ref, GpMetafile *metafile, INT *succ,
+        IStream *stream, EmfType emfType, const WCHAR *description, GpMetafile **out_metafile) { return NotImplemented; }
+#endif
 
 static GpStatus METAFILE_CreateCompressedImageStream(GpImage *image, IStream **stream, DWORD *size)
 {
