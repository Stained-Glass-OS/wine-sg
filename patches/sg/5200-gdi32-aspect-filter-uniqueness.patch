From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] gdi32: GetAspectRatioFilterEx and DdQueryDisplaySettingsUniqueness

GetAspectRatioFilterEx returns the device's pixel aspect (the filter that
SetMapperFlags(ASPECT_FILTERING) matches fonts against) and checks its
arguments. GdiEntry13 (DdQueryDisplaySettingsUniqueness) returns the mode
switch counter from win32u's shared monitor serial through a new
NtUserCallNoParam code, instead of 0 with a FIXME. CORE: integrator must
review (patches/notes/5200.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/include/ntuser.h b/include/ntuser.h
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -992,6 +992,7 @@
     NtUserCallNoParam_GetTaskmanWindow,
     NtUserCallNoParam_ReleaseCapture,
     NtUserCallNoParam_DisplayModeChanged,
+    NtUserCallNoParam_GetDisplaySettingsUniqueness,
     /* temporary exports */
     NtUserExitingThread,
     NtUserThreadDetach,
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7451,6 +7451,10 @@
         display_mode_changed( FALSE );
         return TRUE;
 
+    case NtUserCallNoParam_GetDisplaySettingsUniqueness:
+        /* the shared monitor serial changes with every mode, desktop or session switch */
+        return (ULONG)get_monitor_update_serial();
+
     /* temporary exports */
     case NtUserExitingThread:
         exiting_thread_id = GetCurrentThreadId();
diff --git a/dlls/gdi32/dc.c b/dlls/gdi32/dc.c
--- a/dlls/gdi32/dc.c
+++ b/dlls/gdi32/dc.c
@@ -2944,9 +2944,11 @@
  */
 ULONG WINAPI DdQueryDisplaySettingsUniqueness(void)
 {
-    static int warn_once;
-    if (!warn_once++) FIXME( "stub\n" );
+    TRACE( "\n" );
+#ifdef SG_MUTANT_UNIQ_ZERO
     return 0;
+#endif
+    return NtUserCallNoParam( NtUserCallNoParam_GetDisplaySettingsUniqueness );
 }
 
 /*******************************************************************
diff --git a/dlls/gdi32/text.c b/dlls/gdi32/text.c
--- a/dlls/gdi32/text.c
+++ b/dlls/gdi32/text.c
@@ -2078,8 +2078,29 @@
  */
 BOOL WINAPI GetAspectRatioFilterEx( HDC hdc, SIZE *aspect_ratio )
 {
-  FIXME( "(%p, %p): stub\n", hdc, aspect_ratio );
-  return FALSE;
+    TRACE( "(%p, %p)\n", hdc, aspect_ratio );
+
+#ifdef SG_MUTANT_ASPECT_STUB
+    return FALSE;
+#endif
+    if (!get_dc_attr( hdc ))
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (!aspect_ratio)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* the filter SetMapperFlags( ASPECT_FILTERING ) matches fonts against is the device's
+     * own pixel aspect */
+    aspect_ratio->cx = GetDeviceCaps( hdc, ASPECTX );
+    aspect_ratio->cy = GetDeviceCaps( hdc, ASPECTY );
+#ifdef SG_MUTANT_ASPECT_ZERO
+    aspect_ratio->cx = aspect_ratio->cy = 0;
+#endif
+    return TRUE;
 }
 
 /***********************************************************************
