From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msado15: a value given to a field takes the field's type (9614)

Field.Value stored whatever variant it was given. Windows' cursor engine
stores the column's type: a page that copies form fields (strings) into
Integer columns reads numbers back, so rs("a") + rs("b") is 8 -- under Wine
it was the string "53", VarType said String, and dates given as text stayed
text. Values now convert to the field's type (integers, Single/Double,
Currency, Decimal/Numeric, Boolean, the date types, the text types); Null and
Empty stay, adVariant, binary, GUID and other fields keep the value as given,
and a value that does not convert is refused with DB_E_ERRORSOCCURRED
("Multiple-step operation generated errors"), leaving the old value.
---
--- a/dlls/msado15/recordset.c
+++ b/dlls/msado15/recordset.c
@@ -24,6 +24,7 @@
 #include "objbase.h"
 #include "msado15_backcompat.h"
 #include "oledb.h"
+#include "oledberr.h"
 #include "sqlucode.h"
 
 #include "msxml2.h"
@@ -480,6 +481,49 @@
     recordset->editmode = adEditNone;
 }
 
+/* A value given to a field takes the field's type, the way Windows' cursor engine stores it:
+ * rs("count") = "5" reads back the Integer 5, rs("name") = 5 the String "5" (wine-sg 9614).
+ * Null and Empty stay; a value that does not convert is refused ("Multiple-step operation
+ * generated errors"); variant, binary, GUID and other fields keep what they are given. */
+static HRESULT coerce_to_field_type( DataTypeEnum type, VARIANT *value )
+{
+    VARIANT conv;
+    VARTYPE vt;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_ADO_NO_COERCE
+    return S_OK;
+#endif
+    if (V_VT(value) == VT_NULL || V_VT(value) == VT_EMPTY) return S_OK;
+    switch (type)
+    {
+    case adTinyInt: vt = VT_I1; break;
+    case adSmallInt: vt = VT_I2; break;
+    case adInteger: vt = VT_I4; break;
+    case adBigInt: vt = VT_I8; break;
+    case adUnsignedTinyInt: vt = VT_UI1; break;
+    case adUnsignedSmallInt: vt = VT_UI2; break;
+    case adUnsignedInt: vt = VT_UI4; break;
+    case adUnsignedBigInt: vt = VT_UI8; break;
+    case adSingle: vt = VT_R4; break;
+    case adDouble: vt = VT_R8; break;
+    case adCurrency: vt = VT_CY; break;
+    case adNumeric: case adDecimal: case adVarNumeric: vt = VT_DECIMAL; break;
+    case adBoolean: vt = VT_BOOL; break;
+    case adDate: case adDBDate: case adDBTime: case adDBTimeStamp: vt = VT_DATE; break;
+    case adBSTR: case adChar: case adVarChar: case adLongVarChar:
+    case adWChar: case adVarWChar: case adLongVarWChar: vt = VT_BSTR; break;
+    default: return S_OK;
+    }
+    if (V_VT(value) == vt) return S_OK;
+    VariantInit( &conv );
+    hr = VariantChangeType( &conv, value, 0, vt );
+    if (FAILED(hr)) return DB_E_ERRORSOCCURRED;
+    VariantClear( value );
+    *value = conv;
+    return S_OK;
+}
+
 static HRESULT WINAPI field_put_Value( Field *iface, VARIANT val )
 {
     struct field *field = impl_from_Field( iface );
@@ -501,6 +545,11 @@
 #else
     if ((hr = VariantCopyInd( &copy, &val )) != S_OK) return hr;
 #endif
+    if ((hr = coerce_to_field_type( field->type, &copy )) != S_OK)
+    {
+        VariantClear( &copy );
+        return hr;
+    }
 
     if (!field->recordset->edit_backup || field->recordset->edit_row != row)
     {
