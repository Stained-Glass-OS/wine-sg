+#ifndef SG_MUTANT_NO_HTA_OBJECT
+/* Stained Glass OS (wine-sg 9608): an application's window takes the styles its <HTA:APPLICATION>
+ * element asks for, as mshta does: BORDER (thick, thin, dialog, none), CAPTION, SYSMENU,
+ * MAXIMIZEBUTTON, MINIMIZEBUTTON, SHOWINTASKBAR, WINDOWSTATE and ICON. */
+static BOOL attr_is(nsIDOMElement *elem, const WCHAR *name, const WCHAR *value)
+{
+    nsAString name_str, val_str;
+    const PRUnichar *val;
+    BOOL ret = FALSE;
+
+    nsAString_InitDepend(&name_str, name);
+    nsAString_Init(&val_str, NULL);
+    if(NS_SUCCEEDED(nsIDOMElement_GetAttribute(elem, &name_str, &val_str))) {
+        nsAString_GetData(&val_str, &val);
+        ret = val && !wcsicmp(val, value);
+    }
+    nsAString_Finish(&name_str);
+    nsAString_Finish(&val_str);
+    return ret;
+}
+
+static WCHAR *attr_value(nsIDOMElement *elem, const WCHAR *name)
+{
+    nsAString name_str, val_str;
+    const PRUnichar *val;
+    WCHAR *ret = NULL;
+
+    nsAString_InitDepend(&name_str, name);
+    nsAString_Init(&val_str, NULL);
+    if(NS_SUCCEEDED(nsIDOMElement_GetAttribute(elem, &name_str, &val_str))) {
+        nsAString_GetData(&val_str, &val);
+        if(val && *val)
+            ret = wcsdup(val);
+    }
+    nsAString_Finish(&name_str);
+    nsAString_Finish(&val_str);
+    return ret;
+}
+
+static void dialog_apply_hta(struct html_dialog *dlg)
+{
+    nsIDOMNodeList *list = NULL;
+    nsIDOMNode *node = NULL;
+    nsIDOMElement *elem = NULL;
+    HTMLDocumentNode *doc;
+    nsAString tag;
+    UINT32 len = 0;
+    DWORD style, exstyle;
+    WCHAR *value;
+
+    if(dlg->hta_applied || !dlg->doc_obj || !(doc = dlg->doc_obj->doc_node) || !doc->dom_document)
+        return;
+    nsAString_InitDepend(&tag, L"HTA:APPLICATION");
+    nsIDOMDocument_GetElementsByTagName(doc->dom_document, &tag, &list);
+    nsAString_Finish(&tag);
+    if(list) {
+        nsIDOMNodeList_GetLength(list, &len);
+        if(len)
+            nsIDOMNodeList_Item(list, 0, &node);
+        nsIDOMNodeList_Release(list);
+    }
+    if(!node)
+        return;
+    nsIDOMNode_QueryInterface(node, &IID_nsIDOMElement, (void**)&elem);
+    nsIDOMNode_Release(node);
+    if(!elem)
+        return;
+    dlg->hta_applied = TRUE;
+
+    style = GetWindowLongW(dlg->hwnd, GWL_STYLE);
+    exstyle = GetWindowLongW(dlg->hwnd, GWL_EXSTYLE);
+    if(attr_is(elem, L"border", L"none")) {
+        style &= ~(WS_CAPTION | WS_THICKFRAME | WS_BORDER | WS_DLGFRAME);
+    }else if(attr_is(elem, L"border", L"thin")) {
+        style &= ~WS_THICKFRAME;
+        style |= WS_BORDER;
+    }else if(attr_is(elem, L"border", L"dialog")) {
+        style &= ~WS_THICKFRAME;
+        exstyle |= WS_EX_DLGMODALFRAME;
+    }
+    if(attr_is(elem, L"caption", L"no"))
+        style &= ~WS_CAPTION;
+    if(attr_is(elem, L"sysmenu", L"no"))
+        style &= ~WS_SYSMENU;
+    if(attr_is(elem, L"maximizebutton", L"no"))
+        style &= ~WS_MAXIMIZEBOX;
+    if(attr_is(elem, L"minimizebutton", L"no"))
+        style &= ~WS_MINIMIZEBOX;
+    if(attr_is(elem, L"showintaskbar", L"no"))
+        exstyle |= WS_EX_TOOLWINDOW;
+    SetWindowLongW(dlg->hwnd, GWL_STYLE, style);
+    SetWindowLongW(dlg->hwnd, GWL_EXSTYLE, exstyle);
+    SetWindowPos(dlg->hwnd, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+
+    if((value = attr_value(elem, L"icon"))) {
+        WCHAR path[MAX_PATH];
+        DWORD size = ARRAY_SIZE(path);
+        HICON big, little;
+
+        /* a file path, or a file: URL */
+        if(FAILED(PathCreateFromUrlW(value, path, &size, 0)))
+            lstrcpynW(path, value, ARRAY_SIZE(path));
+        big = LoadImageW(NULL, path, IMAGE_ICON, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON), LR_LOADFROMFILE);
+        little = LoadImageW(NULL, path, IMAGE_ICON, GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON), LR_LOADFROMFILE);
+        if(big) SendMessageW(dlg->hwnd, WM_SETICON, ICON_BIG, (LPARAM)big);
+        if(little) SendMessageW(dlg->hwnd, WM_SETICON, ICON_SMALL, (LPARAM)little);
+        free(value);
+    }
+    if(attr_is(elem, L"windowstate", L"maximize"))
+        ShowWindow(dlg->hwnd, SW_MAXIMIZE);
+    else if(attr_is(elem, L"windowstate", L"minimize"))
+        ShowWindow(dlg->hwnd, SW_MINIMIZE);
+    if(attr_is(elem, L"singleinstance", L"yes"))
+        FIXME("SINGLEINSTANCE is not enforced\n");
+    nsIDOMElement_Release(elem);
+}
+
+/* <HTA:APPLICATION>.commandLine: the application's command line; NULL outside an application */
+const WCHAR *hta_command_line(HTMLDocumentObj *doc_obj)
+{
+    if(!doc_obj || !doc_obj->dialog || !doc_obj->dialog->hta)
+        return NULL;
+    return doc_obj->dialog->command_line ? doc_obj->dialog->command_line : L"";
+}
+#else
+static void dialog_apply_hta(struct html_dialog *dlg) {}
+const WCHAR *hta_command_line(HTMLDocumentObj *doc_obj) { return NULL; }
+#endif
+
