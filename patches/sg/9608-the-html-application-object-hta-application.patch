+/* Stained Glass OS (wine-sg 9608): the HTML application object. In an application mshta started, the
+ * <HTA:APPLICATION> element has commandLine and its attributes as the properties Internet Explorer names,
+ * with their documented defaults. */
+static void init_hta_application(HTMLElement *elem, nsIDOMElement *nselem)
+{
+    static const struct { const WCHAR *name; const WCHAR *def; } props[] = {
+        { L"applicationName", L"" }, { L"border", L"thick" }, { L"borderStyle", L"normal" },
+        { L"caption", L"yes" }, { L"contextMenu", L"yes" }, { L"icon", L"" }, { L"innerBorder", L"yes" },
+        { L"maximizeButton", L"yes" }, { L"minimizeButton", L"yes" }, { L"navigable", L"no" },
+        { L"scroll", L"yes" }, { L"scrollFlat", L"no" }, { L"selection", L"yes" },
+        { L"showInTaskbar", L"yes" }, { L"singleInstance", L"no" }, { L"sysMenu", L"yes" },
+        { L"version", L"" }, { L"windowState", L"normal" },
+    };
+    const WCHAR *cmdline;
+    VARIANT *var;
+    unsigned i;
+
+#ifdef SG_MUTANT_NO_HTA_OBJECT
+    return;
+#endif
+    if(!elem->node.doc || !(cmdline = hta_command_line(elem->node.doc->doc_obj)))
+        return;
+    if(SUCCEEDED(dispex_get_dprop_ref(&elem->node.event_target.dispex, L"commandLine", TRUE, &var))) {
+        VariantClear(var);
+        V_VT(var) = VT_BSTR;
+        V_BSTR(var) = SysAllocString(cmdline);
+    }
+    for(i = 0; i < ARRAY_SIZE(props); i++) {
+        nsAString name_str, val_str;
+        const PRUnichar *val;
+
+        nsAString_InitDepend(&name_str, props[i].name);
+        nsAString_Init(&val_str, NULL);
+        val = NULL;
+        if(NS_SUCCEEDED(nsIDOMElement_GetAttribute(nselem, &name_str, &val_str)))
+            nsAString_GetData(&val_str, &val);
+        if(SUCCEEDED(dispex_get_dprop_ref(&elem->node.event_target.dispex, props[i].name, TRUE, &var))) {
+            VariantClear(var);
+            V_VT(var) = VT_BSTR;
+            V_BSTR(var) = SysAllocString(val && *val ? val : props[i].def);
+        }
+        nsAString_Finish(&name_str);
+        nsAString_Finish(&val_str);
+    }
+}
+
