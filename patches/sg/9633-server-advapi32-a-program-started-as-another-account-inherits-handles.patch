+/* Stained Glass OS (i1010): a program started as another account (CreateProcessAsUser with a
+ * person's token: the elevation broker starts it) inherits its starter's handles as a child
+ * does, at the same values: the starter's inheritable handles (all of them, or those it listed),
+ * kept with their object at the request, put into the new process's table as it starts. */
+unsigned int sg_inheritable_handles( struct process *process, obj_handle_t *handles, unsigned int max )
+{
+    struct handle_table *table = process->handles;
+    unsigned int n = 0;
+    int i;
+
+    if (!table) return 0;
+    for (i = 0; i <= table->last && n < max; i++)
+        if (table->entries[i].ptr && (table->entries[i].access & RESERVED_INHERIT)) handles[n++] = index_to_handle( i );
+    return n;
+}
+
+/* the object of an inheritable handle, referenced; its access with the inherit flag */
+struct object *sg_inheritable_object( struct process *process, obj_handle_t handle, unsigned int *access )
+{
+    struct handle_entry *entry;
+
+    if (handle_is_global( handle ) || !(entry = get_handle( process, handle ))) return NULL;
+    if (!(entry->access & RESERVED_INHERIT)) return NULL;
+    *access = entry->access & ~RESERVED_CLOSE_PROTECT;
+    return grab_object( entry->ptr );
+}
+
+/* put obj into process's table at handle, which must be free */
+int sg_put_handle_at( struct process *process, obj_handle_t handle, struct object *obj, unsigned int access )
+{
+    struct handle_table *table = process->handles;
+    int index = handle_to_index( handle ), i;
+
+    if (!table || handle_is_global( handle ) || index < 0 || index >= MAX_HANDLE_ENTRIES) return 0;
+    while (index >= table->count) if (!grow_handle_table( table )) return 0;
+    if (index <= table->last && table->entries[index].ptr) return 0;
+    for (i = table->last + 1; i < index; i++) table->entries[i].ptr = NULL;
+    if (index > table->last) table->last = index;
+    table->entries[index].ptr = grab_object_for_handle( obj );
+    table->entries[index].access = access;
+    return 1;
+}
+
 /* copy the handle table of the parent process */
 /* return 1 if OK, 0 on error */
 struct handle_table *copy_handle_table( struct process *process, struct process *parent,
