+/* kernelbase's attribute list (InitializeProcThreadAttributeList), for the handle list */
+struct sg_proc_thread_attr
+{
+    DWORD_PTR attr;
+    SIZE_T size;
+    void *value;
+};
+struct sg_proc_thread_attr_list
+{
+    DWORD mask;
+    DWORD size;
+    DWORD count;
+    DWORD pad;
+    DWORD_PTR unk;
+    struct sg_proc_thread_attr attrs[1];
+};
+
+/* Stained Glass OS (i1010): the handles a program started as another account inherits, as
+ * CreateProcessAsUser's child does: with bInheritHandles, every inheritable handle, or only
+ * those of PROC_THREAD_ATTRIBUTE_HANDLE_LIST (STARTUPINFOEX). The server keeps them with the
+ * launch ticket and gives them to the program, at the same values, as it starts: a service's
+ * helper in a person's session finds its pipes where its command line says (WireGuard's tray
+ * window, started by its manager service, ended at once without them). */
+static obj_handle_t *launch_inherit( BOOL inherit, DWORD flags, const STARTUPINFOW *startup, unsigned int *count )
+{
+    static obj_handle_t all = ~0u;
+    obj_handle_t *list;
+    unsigned int i, j;
+
+    *count = 0;
+    if (!inherit) return NULL;
+    if ((flags & EXTENDED_STARTUPINFO_PRESENT) && startup && startup->cb >= sizeof(STARTUPINFOEXW))
+    {
+        const struct sg_proc_thread_attr_list *attrs = (void *)((const STARTUPINFOEXW *)startup)->lpAttributeList;
+
+        for (i = 0; attrs && i < attrs->count; i++)
+        {
+            const HANDLE *handles;
+            unsigned int n;
+
+            if (attrs->attrs[i].attr != PROC_THREAD_ATTRIBUTE_HANDLE_LIST) continue;
+            handles = attrs->attrs[i].value;
+            n = attrs->attrs[i].size / sizeof(HANDLE);
+            if (!(list = malloc( (n + 1) * sizeof(*list) ))) return NULL;
+            for (j = 0; j < n; j++) list[j] = wine_server_obj_handle( handles[j] );
+            *count = n;
+            return list;
+        }
+    }
+    *count = 1;
+    return &all;
+}
+
