+    unsigned int   *inherit_access;
 } sg_launches[SG_LAUNCH_MAX];
 
+static void sg_launch_drop_inherit( struct sg_launch *l )
+{
+    unsigned int i;
+
+    for (i = 0; i < l->inherit_count; i++) release_object( l->inherit_objs[i] );
+    free( l->inherit_handles );
+    free( l->inherit_objs );
+    free( l->inherit_access );
+    l->inherit_handles = NULL;
+    l->inherit_objs = NULL;
+    l->inherit_access = NULL;
+    l->inherit_count = 0;
+}
+
+/* the handles the requester asks the process to inherit (optional request data: the handle
+ * values, or the one value ~0 for every inheritable handle, as CreateProcess with bInheritHandles
+ * and no handle list); only inheritable ones are taken, as Windows requires */
+static void sg_launch_take_inherit( struct sg_launch *l, const obj_handle_t *want, data_size_t size )
+{
+    unsigned int count = size / sizeof(obj_handle_t), i, n = 0, access;
+    obj_handle_t *all = NULL;
+    struct object *obj;
+
+#ifdef SG_MUTANT_LAUNCH_NO_INHERIT
+    return;
+#endif
+    if (!count) return;
+    if (count == 1 && want[0] == ~0u)
+    {
+        if (!(all = mem_alloc( 4096 * sizeof(*all) ))) return;
+        count = sg_inheritable_handles( current->process, all, 4096 );
+        want = all;
+    }
+    if (count > 4096) count = 4096;
+    if (count && (l->inherit_handles = mem_alloc( count * sizeof(*l->inherit_handles) )) &&
+        (l->inherit_objs = mem_alloc( count * sizeof(*l->inherit_objs) )) &&
+        (l->inherit_access = mem_alloc( count * sizeof(*l->inherit_access) )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (!(obj = sg_inheritable_object( current->process, want[i], &access ))) continue;
+            l->inherit_handles[n] = want[i];
+            l->inherit_objs[n] = obj;
+            l->inherit_access[n] = access;
+            n++;
+        }
+    }
+    l->inherit_count = n;
+    free( all );
+    clear_error();
+}
+
