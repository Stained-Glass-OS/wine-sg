+++ b/dlls/windows.ui.xaml/classes.idl
@@ -452,6 +452,12 @@ namespace Windows.UI.Xaml.Media {
     interface ISolidColorBrushFactory : IInspectable {}
     [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(e1a65efa-2b23-41ba-b9ba-7094ec8e4e9f)]
     interface ISolidColorBrushStatics : IInspectable {}
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(8e96d16b-bb84-4c6f-9dbf-9d6c5c6d9c39)]
+    interface ILinearGradientBrush : IInspectable {}
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(665f44fe-2e59-4c4a-ab53-076a100ccd81)]
+    interface IGradientStop : IInspectable {}
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(2166e69f-935a-4191-8e3c-1c8dfdfcdc78)]
+    interface IGradientBrush : IInspectable {}
     [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(9fd11377-c12a-4493-bf7d-f3a8ad74b554)]
     interface IImageBrush : IInspectable {}
     [contract(Windows.Foundation.UniversalApiContract, 1.0), uuid(1255b1b2-dd18-42e5-892c-eae30c305b8c)]
@@ -479,6 +485,16 @@ namespace Windows.UI.Xaml.Media {
         [default] interface Windows.UI.Xaml.Media.IBrush;
     }
 
+    /* (wine-sg 6229) GradientBrush is composable on Windows: activatable here so that widl registers it */
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass GradientBrush { [default] interface Windows.UI.Xaml.Media.IGradientBrush; }
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass LinearGradientBrush { [default] interface Windows.UI.Xaml.Media.ILinearGradientBrush; }
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass GradientStop { [default] interface Windows.UI.Xaml.Media.IGradientStop; }
+    [activatable(Windows.Foundation.UniversalApiContract, 1.0), contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile)]
+    runtimeclass GradientStopCollection { [default] interface Windows.UI.Xaml.Media.IGradientStop; }
+
     /* composable on Windows; marked activatable so that widl registers it (wine-sg 6227) */
     [
         activatable(Windows.Foundation.UniversalApiContract, 1.0),
