+static HRESULT activate_linear( IInspectable **out )
+{
+    struct brush *brush = new_brush( BRUSH_LINEAR, NULL );
+    IInspectable *stops;
+
+    if (!brush) return E_OUTOFMEMORY;
+    gradient_stops( brush, &stops );   /* the collection markup adds the stops to */
+    if (stops) IInspectable_Release( stops );
+    *out = (IInspectable *)&brush->ILinearGradientBrush_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI linear_factory_CreateInstanceWithGradientStopCollectionAndAngle( struct xfiface *iface,
+        IInspectable *stops, DOUBLE angle, IInspectable **value )
+{
+    struct brush *brush;
+    struct xpoint end;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = activate_linear( value ))) return hr;
+    brush = CONTAINING_RECORD( dobj_from_inspectable( *value ), struct brush, d );
+    if (stops) dobj_set_value( &brush->d, prop_gradient_stops, stops );
+    /* the angle from the start (0,0), in degrees */
+    end.x = cos( angle * M_PI / 180 );
+    end.y = sin( angle * M_PI / 180 );
+    put_point( brush, prop_end_point, end );
+    return S_OK;
+}
