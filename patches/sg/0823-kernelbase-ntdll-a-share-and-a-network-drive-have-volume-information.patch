From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase, ntdll: a share and a network drive have volume information

GetVolumeInformation failed for a mapped network drive (P:\, "Incorrect
function": the mount manager does not know the user's SMB mounts, so ntdll
answered FileFsVolumeInformation with STATUS_NOT_IMPLEMENTED) and for
\\server\share\ (ERROR_DIR_NOT_ROOT: the server's backslash was taken for a
subdirectory). cmd's DIR of a mapped drive printed nothing at all -- not
even an error -- and programs that check the volume they install to or
work on refused network drives.

A share is now a volume, as a Windows file server's shares are: no label,
a serial number of its own (from the mount's device), its file system
named as before. \\server\share\ is a root; a folder below it is not.

Test: test/smbshare-gate.sh (mutants SG_MUTANT_UNC_NOT_ROOT in
dlls/kernelbase/volume.c, SG_MUTANT_SMB_NO_VOLUME in
dlls/ntdll/unix/file.c).
---
--- a/dlls/kernelbase/volume.c
+++ b/dlls/kernelbase/volume.c
@@ -171,7 +171,17 @@
         return FALSE;
     }
     /* there must be exactly one backslash in the name, at the end */
-    for (i = 4; i < nt_name.Length / sizeof(WCHAR); i++) if (nt_name.Buffer[i] == '\\') break;
+    i = 4;
+#ifndef SG_MUTANT_UNC_NOT_ROOT
+    /* Stained Glass OS: \\server\share\ is a root too, the share's: its
+     * server's backslash is not a subdirectory's */
+    if (nt_name.Length / sizeof(WCHAR) > 8 && !wcsnicmp( nt_name.Buffer + 4, L"UNC\\", 4 ))
+    {
+        for (i = 8; i < nt_name.Length / sizeof(WCHAR); i++) if (nt_name.Buffer[i] == '\\') break;
+        i++;
+    }
+#endif
+    for (; i < nt_name.Length / sizeof(WCHAR); i++) if (nt_name.Buffer[i] == '\\') break;
     if (i != nt_name.Length / sizeof(WCHAR) - 1)
     {
         /* check if root contains an explicit subdir */
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -8072,6 +8072,32 @@
 
         if (get_mountmgr_fs_info( handle, fd, drive, sizeof(data) ))
         {
+#ifndef SG_MUTANT_SMB_NO_VOLUME
+            /* Stained Glass OS: a network drive or \\server\share is no drive
+             * the mount manager knows -- the share is an SMB mount of the
+             * user's -- and asking its volume failed: cmd's DIR of a mapped
+             * drive printed nothing at all, and programs that check the
+             * volume they install to refused a mapped drive. A share is a
+             * volume with no label and a serial number of its own, as a
+             * Windows file server's shares are. */
+            struct statfs stfs;
+
+            if (!fstatfs( fd, &stfs ) && ((unsigned int)stfs.f_type == SG_CIFS_MAGIC_NUMBER ||
+                                          (unsigned int)stfs.f_type == SG_SMB2_MAGIC_NUMBER))
+            {
+                struct stat st;
+                ULONG serial = 0;
+
+                if (!fstat( fd, &st )) serial = (ULONG)(st.st_dev * 2654435761u) ^ (ULONG)(st.st_dev >> 32);
+                info->VolumeCreationTime.QuadPart = 0;
+                info->VolumeSerialNumber = serial;
+                info->VolumeLabelLength = 0;
+                info->SupportsObjects = FALSE;
+                io->Information = offsetof( FILE_FS_VOLUME_INFORMATION, VolumeLabel );
+                status = STATUS_SUCCESS;
+                break;
+            }
+#endif
             status = STATUS_NOT_IMPLEMENTED;
             break;
         }
