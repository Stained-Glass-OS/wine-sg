From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dwrite: the names FontSubstitutes give another font are DirectWrite families

sg-shell maps "Segoe UI" (and Tahoma, Verdana, MS Sans Serif...) to the
fonts Stained Glass ships, in the machine's FontSubstitutes. GDI drew
"Segoe UI" with its substitute; DirectWrite's system collection had no
such family. A program that measures and draws text with DirectWrite --
Skia does, and DYMO Connect lays out and prints its labels with Skia --
was told the family does not exist and fell back to the collection's first
family, another font than the same text showed in on screen: DYMO's "Auto
fit" text came out small (the fallback's wide line spacing), or was cut
off on the label at the width measured for the screen's font, and its
font list showed no font for the default text.

The system collection now has a family for each FontSubstitutes name whose
substitute it has, as it has for Wine's Replacements (the same fonts, under
that name, listed). Names with a character set ("Arial CE,238") and the
names Windows itself knows only in GDI (MS Shell Dlg, Helv, Tms Rmn...)
are left out.

Test: test/dwsubst-gate.sh with test/dwsubst-probe.c (mutant
SG_MUTANT_DWSUBST).
---
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -4699,6 +4699,59 @@
     RegCloseKey(hkey);
 }
 
+/* Stained Glass OS: the names the machine's FontSubstitutes give another
+ * font (HKLM\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes;
+ * sg-shell maps "Segoe UI", "Tahoma", "Verdana"... to the fonts it ships) are
+ * families of the system collection too, as Replacements are: GDI drew
+ * "Segoe UI" with its substitute, DirectWrite knew no such family, and a
+ * program measuring and drawing with DirectWrite (Skia: DYMO Connect's
+ * labels, Chromium) fell back to the collection's first family -- another
+ * font, of other widths, than the one the same text showed in on screen.
+ * Names with a character set ("Arial CE,238") and the names Windows itself
+ * knows only in GDI are left out. */
+static void fontcollection_add_substitutes(struct dwrite_fontcollection *collection)
+{
+    static const WCHAR * const gdi_only[] = { L"MS Shell Dlg", L"MS Shell Dlg 2", L"Helv", L"Tms Rmn", L"Times",
+        L"Helvetica", L"Courier" };
+    DWORD max_namelen, max_datalen, i = 0, j, type, datalen, namelen;
+    WCHAR *name, *data;
+    HKEY hkey;
+
+    if (RegOpenKeyA(HKEY_LOCAL_MACHINE, "Software\\Microsoft\\Windows NT\\CurrentVersion\\FontSubstitutes", &hkey))
+        return;
+
+    if (RegQueryInfoKeyW(hkey, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &max_namelen, &max_datalen, NULL, NULL)) {
+        RegCloseKey(hkey);
+        return;
+    }
+
+    max_namelen++;
+    name = malloc(max_namelen * sizeof(WCHAR));
+    data = malloc(max_datalen + sizeof(WCHAR));
+
+    datalen = max_datalen;
+    namelen = max_namelen;
+    while (name && data && RegEnumValueW(hkey, i++, name, &namelen, NULL, &type, (BYTE *)data, &datalen) == ERROR_SUCCESS) {
+        BOOL skip = type != REG_SZ || !name[0] || wcschr(name, ',');
+
+        data[datalen / sizeof(WCHAR)] = 0;
+        if (wcschr(data, ',')) skip = TRUE;
+        for (j = 0; j < ARRAY_SIZE(gdi_only) && !skip; j++)
+            if (!wcsicmp(name, gdi_only[j])) skip = TRUE;
+
+        if (!skip && collection_find_family(collection, name) == ~0u)
+            fontcollection_add_replacement(collection, name, data);
+
+        datalen = max_datalen;
+        namelen = max_namelen;
+    }
+
+    free(data);
+    free(name);
+    RegCloseKey(hkey);
+}
+
+
 HRESULT create_font_collection(IDWriteFactory7 *factory, IDWriteFontFileEnumerator *enumerator, BOOL is_system,
     IDWriteFontCollection3 **ret)
 {
@@ -4855,7 +4908,12 @@
     }
 
     if (is_system)
+    {
         fontcollection_add_replacements(collection);
+#ifndef SG_MUTANT_DWSUBST
+        fontcollection_add_substitutes(collection);
+#endif
+    }
 
     return hr;
 }
