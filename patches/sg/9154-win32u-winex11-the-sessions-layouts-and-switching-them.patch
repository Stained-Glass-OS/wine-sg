From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u, winex11: the session's layouts, and switching them is an input language change (9154)

Setup and the first-run setup let a person pick two keyboard layouts; the
session's keymap has both as XKB groups and the Windows logo key + Space
switches them (sg-session sg_keyboard_env, grp:win_space_toggle), and HKCU
Keyboard Layout\Preload lists both. On Windows those are the loaded
layouts: GetKeyboardLayoutList returns them in that order, and the
input-language hotkey posts WM_INPUTLANGCHANGEREQUEST to the focus window,
whose DefWindowProc activates the layout (WM_INPUTLANGCHANGE), after which
GetKeyboardLayout, MapVirtualKeyEx, ToUnicodeEx and the keys' virtual keys
are the new layout's. Wine knew one layout: the list was the default only,
a switch on the display server changed the characters but not the HKL or
the virtual keys (with US and German, German Z still came as VK_Y: Ctrl+Z
was Ctrl+Y), and no program was told.

- The display driver entry GetKeyboardLayoutDevice takes an index: the
  session's layout n (XKB group n), or KBD_DEVICE_CURRENT, the one the
  keyboard types with now, which is the default HKL (WINE_GDI_DRIVER_VERSION
  104).
- GetKeyboardLayoutList with nothing loaded: the session's layouts, in
  order.
- winex11: a key event in another XKB group than the thread's last one
  posts WM_INPUTLANGCHANGEREQUEST (INPUTLANGCHANGE_FORWARD/BACKWARD |
  SYSCHARSET) with that group's HKL to the focus window; until the thread
  has the layout its keys are already that layout's. A thread's first key
  only notes the group, so a layout a program activated stays. A group
  other than the first gets tables built from its own XKB layout and
  variant.

Gate test/kbdgroups-gate.sh (Xvfb, us,de and grp:win_space_toggle, keys
sent with XTEST). Mutant SG_MUTANT_KBD_ONE_GROUP.
---
 dlls/win32u/driver.c         |  6 ++--
 dlls/win32u/input.c          | 28 +++++++++++++++++-
 dlls/winex11.drv/keyboard.c  | 39 ++++++++++++++++++++++++-
 dlls/winex11.drv/x11drv.h    |  5 +++-
 dlls/winex11.drv/xkbtables.c | 69 +++++++++++++++++++++++++++++++++++---------
 include/wine/gdi_driver.h    |  8 +++--
 6 files changed, 134 insertions(+), 21 deletions(-)

--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -677,7 +677,7 @@ static void nulldrv_ReleaseKbdTables( const KBDTABLES *tables )
 {
 }
 
-static UINT nulldrv_GetKeyboardLayoutDevice(void)
+static UINT nulldrv_GetKeyboardLayoutDevice( UINT index )
 {
     return 0; /* the user locale's layout */
 }
@@ -1104,9 +1104,9 @@ static void loaderdrv_ReleaseKbdTables( const KBDTABLES *tables )
     return load_driver()->pReleaseKbdTables( tables );
 }
 
-static UINT loaderdrv_GetKeyboardLayoutDevice(void)
+static UINT loaderdrv_GetKeyboardLayoutDevice( UINT index )
 {
-    return load_driver()->pGetKeyboardLayoutDevice();
+    return load_driver()->pGetKeyboardLayoutDevice( index );
 }
 
 static UINT loaderdrv_ImeProcessKey( HIMC himc, UINT wparam, UINT lparam, const BYTE *state )
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -984,7 +984,7 @@ static HKL get_locale_kbd_layout(void)
          * layout (Preload) is the one the person types with: an English (US) session typing with
          * a German map is 0x04070409, with US Dvorak 0xf0020409 (the display driver knows which
          * Windows layout its keyboard map is; 0 when it does not, or has not loaded yet) */
-        UINT device = kbd_device_deferred ? 0 : user_driver->pGetKeyboardLayoutDevice();
+        UINT device = kbd_device_deferred ? 0 : user_driver->pGetKeyboardLayoutDevice( KBD_DEVICE_CURRENT );
         if (device) return ULongToHandle( MAKELONG( layout, device ) );
     }
 #endif
@@ -1539,6 +1539,32 @@ UINT WINAPI NtUserGetKeyboardLayoutList( INT size, HKL *layouts )
     layout = get_locale_kbd_layout();
     count = 0;
 
+#ifndef SG_MUTANT_KBD_ONE_GROUP
+    /* Stained Glass OS (9153): the session's keyboard layouts, in the order the person put them (the
+     * layouts of the display's keyboard map, as Windows loads the Preload list at sign-in) */
+    {
+        HKL seen[4];
+        LCID locale;
+        UINT device, index, j;
+
+        NtQueryDefaultLocale( TRUE, &locale );
+        for (index = 0; index < 4 && (device = user_driver->pGetKeyboardLayoutDevice( index )); index++)
+        {
+            HKL hkl = ULongToHandle( MAKELONG( locale, device ) );
+
+            for (j = 0; j < count; j++) if (seen[j] == hkl) break;
+            if (j < count) continue;
+            seen[count++] = hkl;
+            if (size && layouts)
+            {
+                layouts[count - 1] = hkl;
+                if (count == size) return count;
+            }
+        }
+    }
+    if (count) return count;
+#endif
+
     count++;
     if (size && layouts)
     {
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -97,6 +97,13 @@ static void check_keyboard_mapping( Display *display )
 
 static char KEYBOARD_MapDeadKeysym(KeySym keysym);
 
+/* (9154) WM_INPUTLANGCHANGEREQUEST's wParam */
+#ifndef INPUTLANGCHANGE_SYSCHARSET
+#define INPUTLANGCHANGE_SYSCHARSET 0x0001
+#define INPUTLANGCHANGE_FORWARD    0x0002
+#define INPUTLANGCHANGE_BACKWARD   0x0004
+#endif
+
 /* (9152) a digit or OEM character key's virtual key: the ones a Windows layout places by scan code */
 static BOOL is_character_vkey( BYTE vk )
 {
@@ -1368,6 +1375,7 @@ BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *xev )
     WORD vkey = 0, bScan;
     DWORD dwFlags;
     int ascii_chars;
+    HKL layout;
     XIC xic = X11DRV_get_ic( hwnd );
     DWORD event_time = EVENT_x11_time_to_win32_time(event->time);
     Status status = 0;
@@ -1447,6 +1455,35 @@ BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *xev )
 
     pthread_mutex_unlock( &kbd_mutex );
 
+    /* Stained Glass OS (9154): the session's keyboard layouts are the X map's groups, and the person
+     * switches them (Windows logo key + Space) on the display server. On Windows that switch is an input
+     * language change: the focus window is posted WM_INPUTLANGCHANGEREQUEST with the new layout, and
+     * DefWindowProc activates it (WM_INPUTLANGCHANGE). Until it has, the keys are already the new
+     * layout's. A thread's first key event only notes the group: a layout the program activated stays. */
+    layout = NtUserGetKeyboardLayout( 0 );
+#ifndef SG_MUTANT_KBD_ONE_GROUP
+    {
+        struct x11drv_thread_data *data = x11drv_thread_data();
+        UINT group = XkbGroupForCoreState( event->state );
+        HKL group_layout = x11drv_group_layout( group );
+
+        if (group_layout && data->kbd_group && data->kbd_group != group + 1)
+        {
+            HWND focus = get_focus();
+            WPARAM flags = INPUTLANGCHANGE_SYSCHARSET |
+                           (group + 1 > data->kbd_group ? INPUTLANGCHANGE_FORWARD : INPUTLANGCHANGE_BACKWARD);
+
+            TRACE_(key)( "the keyboard switched to group %u: layout %p\n", group, group_layout );
+            if (!focus) focus = hwnd;
+            NtUserPostMessage( focus, WM_INPUTLANGCHANGEREQUEST, flags, (LPARAM)group_layout );
+            data->kbd_switch_layout = group_layout;
+        }
+        data->kbd_group = group + 1;
+        if (data->kbd_switch_layout == layout) data->kbd_switch_layout = 0;
+        if (data->kbd_switch_layout) layout = data->kbd_switch_layout;
+    }
+#endif
+
     /* Stained Glass OS: in a layout that is not the X map's, a key of the main
      * block is that layout's virtual key (the French A key sends VK_A) */
 #ifndef SG_MUTANT_KBD_EVENT_X
@@ -1455,7 +1492,7 @@ BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *xev )
     if (0)
 #endif
     {
-        const KBDTABLES *tables = x11drv_foreign_kbd_tables( NtUserGetKeyboardLayout(0) );
+        const KBDTABLES *tables = x11drv_foreign_kbd_tables( layout );
         WORD layout_vkey = tables ? tables->pusVSCtoVK[bScan] : 0;
         if (layout_vkey && !(layout_vkey & (KBDEXT | KBDNUMPAD))) vkey = layout_vkey & 0xff;
     }
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -204,7 +204,8 @@ extern void X11DRV_Beep(void);
 extern INT X11DRV_GetKeyNameText( LONG lparam, LPWSTR buffer, INT size );
 extern const KBDTABLES *X11DRV_KbdLayerDescriptor( HKL hkl );
 extern void X11DRV_ReleaseKbdTables( const KBDTABLES *tables );
-extern UINT X11DRV_GetKeyboardLayoutDevice(void);
+extern UINT X11DRV_GetKeyboardLayoutDevice( UINT index );
+extern HKL x11drv_group_layout( UINT group );
 extern const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl );
 extern void x11drv_foreign_kbd_reset(void);
 extern void x11drv_x_map_windows_vks( Display *display, BYTE vks[0x80] );
@@ -472,6 +473,8 @@ struct x11drv_thread_data
     HWND     keymapnotify_hwnd;    /* window that should receive modifier release events */
     XIM      xim;                  /* input method */
     HWND     last_xic_hwnd;        /* last xic window */
+    UINT     kbd_group;            /* (Stained Glass OS 9154) XKB group of the last key event + 1, 0 if none yet */
+    HKL      kbd_switch_layout;    /* (9154) the layout the person switched to, until the thread has it */
     XFontSet font_set;             /* international text drawing font set */
     Window   selection_wnd;        /* window used for selection interactions */
     unsigned long warp_serial;     /* serial number of last pointer warp request */
--- a/dlls/winex11.drv/xkbtables.c
+++ b/dlls/winex11.drv/xkbtables.c
@@ -362,7 +362,7 @@ typedef struct
 struct foreign_layout
 {
     struct list entry;
-    DWORD key;             /* the LANGID, or (8212) the KLID of a layout-id layout */
+    char names[128];       /* (9154) the XKB layout(variant) it is built from */
     BOOL valid;            /* FALSE: the layout could not be built, the X map answers */
     KBDTABLES tables;
     USHORT vsc2vk[0x80];
@@ -934,24 +934,37 @@ const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
     struct foreign_layout *layout;
     LANGID lang = HIWORD( (UINT_PTR)hkl );
     const char *xkb_layout, *xkb_variant;
-    DWORD key;
+    char names[128], group_layout[64], group_variant[64];
     LCID locale;
-    UINT device;
+    UINT device, g;
     int name;
 
     if (!hkl) return NULL;
+    group_layout[0] = 0;
     pthread_mutex_lock( &foreign_mutex );
     if (!x_names_known) read_x_layout_names( thread_init_display() );
     device = x_device;
+    /* (9154) another of the session's layouts (an XKB group but the first): that group's own layout */
+    for (g = 1; g < x_groups; g++)
+    {
+        if (!x_devices[g] || x_devices[g] != lang || lang == device) continue;
+        strcpy( group_layout, x_layouts[g] );
+        strcpy( group_variant, x_variants[g] );
+        break;
+    }
     pthread_mutex_unlock( &foreign_mutex );
     if (device && lang == device) return NULL; /* the X map's own layout */
-    if ((lang & 0xf000) == 0xf000)
+    if (group_layout[0])
+    {
+        xkb_layout = group_layout;
+        xkb_variant = group_variant[0] ? group_variant : NULL;
+    }
+    else if ((lang & 0xf000) == 0xf000)
     {
 #ifndef SG_MUTANT_KBD_NO_KLID
         /* a layout id: the KLID that has it, and that KLID's XKB variant (8212) */
         DWORD klid = klid_from_layout_id( lang & 0xfff );
         if ((name = find_xkb_klid( klid )) < 0) return NULL; /* not one of ours: the X map */
-        key = klid;
         xkb_layout = xkb_klids[name].layout;
         xkb_variant = xkb_klids[name].variant;
 #else
@@ -969,7 +982,6 @@ const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
         if (lang == LANGIDFROMLCID( locale )) return NULL;
 #endif
         if ((name = find_xkb_name( lang )) < 0) return NULL;
-        key = xkb_names[name].lang;
         xkb_layout = xkb_names[name].layout;
         xkb_variant = xkb_names[name].variant;
     }
@@ -984,12 +996,13 @@ const KBDTABLES *x11drv_foreign_kbd_tables( HKL hkl )
         return NULL;
     }
 
+    snprintf( names, sizeof(names), "%s(%s)", xkb_layout, xkb_variant ? xkb_variant : "" );
     LIST_FOR_EACH_ENTRY( layout, &foreign_layouts, struct foreign_layout, entry )
-        if (layout->key == key) goto done;
+        if (!strcmp( layout->names, names )) goto done;
 
     if ((layout = calloc( 1, sizeof(*layout) )))
     {
-        layout->key = key;
+        strcpy( layout->names, names );
         build_layout( layout, xkb_layout, xkb_variant );
         list_add_tail( &foreign_layouts, &layout->entry );
         TRACE( "hkl %p: layout %s(%s) %s\n", hkl, xkb_layout, debugstr_a(xkb_variant),
@@ -1023,18 +1036,43 @@ void x11drv_foreign_kbd_reset(void)
     pthread_mutex_unlock( &foreign_mutex );
 }
 
-/* the high word of the X map's Windows layout, 0 if it has none (win32u: the default HKL) */
-UINT X11DRV_GetKeyboardLayoutDevice(void)
+/* the high word of the Windows layout the keyboard types with now (KBD_DEVICE_CURRENT: win32u's default
+ * HKL), or (9154) of the session's layout index -- XKB group index -- 0 if it has none */
+UINT X11DRV_GetKeyboardLayoutDevice( UINT index )
 {
-    UINT device;
+    UINT device = 0;
 
     pthread_mutex_lock( &foreign_mutex );
     if (!x_names_known) read_x_layout_names( thread_init_display() );
-    device = x_device;
+    if (index == KBD_DEVICE_CURRENT)
+    {
+#ifndef SG_MUTANT_KBD_ONE_GROUP
+        device = x_group < x_groups ? x_devices[x_group] : 0;
+#endif
+        if (!device) device = x_device;
+    }
+    else if (index < x_groups) device = x_devices[index];
     pthread_mutex_unlock( &foreign_mutex );
     return device;
 }
 
+/* (9154) the HKL of XKB group group (the session's layout the person switched to), 0 if it has none; the
+ * group becomes the one the keyboard types with */
+HKL x11drv_group_layout( UINT group )
+{
+    LCID locale;
+    UINT device;
+
+    pthread_mutex_lock( &foreign_mutex );
+    if (!x_names_known) read_x_layout_names( thread_init_display() );
+    device = group < x_groups ? x_devices[group] : 0;
+    if (group < x_groups) x_group = group;
+    pthread_mutex_unlock( &foreign_mutex );
+    if (!device) return 0;
+    NtQueryDefaultLocale( TRUE, &locale );
+    return ULongToHandle( MAKELONG( LANGIDFROMLCID( locale ), device ) );
+}
+
 #else  /* HAVE_XKBCOMMON_XKBCOMMON_H */
 
 void x11drv_x_map_windows_vks( Display *display, BYTE vks[0x80] )
@@ -1051,7 +1089,12 @@ void x11drv_foreign_kbd_reset(void)
 {
 }
 
-UINT X11DRV_GetKeyboardLayoutDevice(void)
+UINT X11DRV_GetKeyboardLayoutDevice( UINT index )
+{
+    return 0;
+}
+
+HKL x11drv_group_layout( UINT group )
 {
     return 0;
 }
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -218,8 +218,12 @@ struct gdi_dc_funcs
     UINT       priority;
 };
 
+/* pGetKeyboardLayoutDevice: the high word of the layout (HKL) the keyboard types with now, or of the
+ * session's layout n (0 past the last) -- Stained Glass OS 9901/9153 */
+#define KBD_DEVICE_CURRENT (~0u)
+
 /* increment this when you change the DC function table */
-#define WINE_GDI_DRIVER_VERSION 103
+#define WINE_GDI_DRIVER_VERSION 104
 
 #define GDI_PRIORITY_NULL_DRV        0  /* null driver */
 #define GDI_PRIORITY_FONT_DRV      100  /* any font driver */
@@ -338,7 +342,7 @@ struct user_driver_funcs
     SHORT   (*pVkKeyScanEx)(WCHAR, HKL);
     const KBDTABLES *(*pKbdLayerDescriptor)(HKL);
     void    (*pReleaseKbdTables)(const KBDTABLES *);
-    UINT    (*pGetKeyboardLayoutDevice)(void);
+    UINT    (*pGetKeyboardLayoutDevice)(UINT);
     /* IME functions */
     UINT    (*pImeProcessKey)(HIMC,UINT,UINT,const BYTE*);
     void    (*pNotifyIMEStatus)(HWND,UINT);
