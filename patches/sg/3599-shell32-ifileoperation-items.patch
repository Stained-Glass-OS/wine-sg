+static HRESULT get_item_path(IShellItem *item, WCHAR *path, DWORD size)
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    if (FAILED(hr = IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &str)))
+        return hr;
+    hr = wcscpy_s(path, size, str) ? HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE) : S_OK;
+    CoTaskMemFree(str);
+    return hr;
+}
+
+static HRESULT copy_tree(const WCHAR *src, const WCHAR *dst)
+{
+    WCHAR from[MAX_PATH], to[MAX_PATH];
+    WIN32_FIND_DATAW wfd;
+    HANDLE fh;
+    HRESULT hr = S_OK;
+
+    if (!CreateDirectoryW(dst, NULL) && GetLastError() != ERROR_ALREADY_EXISTS)
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    if (!PathCombineW(from, src, L"*.*"))
+        return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    fh = FindFirstFileW(from, &wfd);
+    if (fh == INVALID_HANDLE_VALUE) return S_OK;
+    do
+    {
+        if (!wcscmp(wfd.cFileName, L".") || !wcscmp(wfd.cFileName, L".."))
+            continue;
+        if (!PathCombineW(from, src, wfd.cFileName) || !PathCombineW(to, dst, wfd.cFileName))
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+            break;
+        }
+        if (IsAttribDir(wfd.dwFileAttributes))
+            hr = copy_tree(from, to);
+        else if (!CopyFileW(from, to, FALSE))
+            hr = HRESULT_FROM_WIN32(GetLastError());
+        if (FAILED(hr))
+            break;
+    } while (FindNextFileW(fh, &wfd));
+    FindClose(fh);
+    return hr;
+}
+
+static HRESULT copy_engine_copy(struct file_operation *operation, struct copy_engine_operation *op,
+        IShellItem *src_item, IShellItem **new_item)
+{
+    WCHAR path[MAX_PATH], item_path[MAX_PATH], folder_path[MAX_PATH];
+    DWORD src_attrs, dst_attrs;
+    HRESULT hr;
+    WCHAR *ptr;
+
+    *new_item = NULL;
+    if (FAILED(hr = get_item_path(src_item, item_path, ARRAY_SIZE(item_path))))
+        return hr;
+    if (!*op->name && (ptr = StrRChrW(item_path, NULL, '\\')))
+    {
+        free(op->name);
+        op->name = wcsdup(ptr + 1);
+    }
+    if (FAILED(hr = get_item_path(op->folder, folder_path, ARRAY_SIZE(folder_path))))
+        return hr;
+    if (!PathCombineW(path, folder_path, op->name))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    if ((src_attrs = GetFileAttributesW(item_path)) == INVALID_FILE_ATTRIBUTES)
+        return HRESULT_FROM_WIN32(GetLastError());
+    dst_attrs = GetFileAttributesW(path);
+    if (IsAttribFile(src_attrs) && IsAttribDir(dst_attrs))
+        return COPYENGINE_E_FILE_IS_FLD_DEST;
+    if (IsAttribDir(src_attrs) && IsAttribFile(dst_attrs))
+        return COPYENGINE_E_FLD_IS_FILE_DEST;
+
+#ifdef SG_MUTANT_FILEOP_COPY
+    return SHCreateItemFromParsingName(path, NULL, &IID_IShellItem, (void **)new_item);
+#endif
+    if (IsAttribDir(src_attrs))
+        hr = copy_tree(item_path, path);
+    else if (!CopyFileW(item_path, path, FALSE))
+        hr = HRESULT_FROM_WIN32(GetLastError());
+    else
+        hr = S_OK;
+    if (FAILED(hr))
+        return hr;
+
+    return SHCreateItemFromParsingName(path, NULL, &IID_IShellItem, (void **)new_item);
+}
+
+static HRESULT copy_engine_delete(struct file_operation *operation, struct copy_engine_operation *op,
+        IShellItem *item)
+{
+    WCHAR path[MAX_PATH + 1];
+    SHFILEOPSTRUCTW fo = {0};
+    HRESULT hr;
+    int ret;
+
+    if (FAILED(hr = get_item_path(item, path, MAX_PATH)))
+        return hr;
+    path[lstrlenW(path) + 1] = 0;
+#ifdef SG_MUTANT_FILEOP_DELETE
+    return S_OK;
+#endif
+
+    fo.wFunc = FO_DELETE;
+    fo.pFrom = path;
+    fo.fFlags = FOF_NOCONFIRMATION | FOF_NOERRORUI | FOF_SILENT;
+    if (op->tsf & TSF_DELETE_RECYCLE_IF_POSSIBLE)
+        fo.fFlags |= FOF_ALLOWUNDO;
+    ret = SHFileOperationW(&fo);
+    if (ret)
+        return HRESULT_FROM_WIN32(ret);
+    if (fo.fAnyOperationsAborted)
+        return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    return S_OK;
+}
+
+static HRESULT copy_engine_rename(struct file_operation *operation, struct copy_engine_operation *op,
+        IShellItem *item, IShellItem **new_item)
+{
+    WCHAR path[MAX_PATH], new_path[MAX_PATH];
+    HRESULT hr;
+
+    *new_item = NULL;
+    if (!*op->name || wcspbrk(op->name, L"\\/"))
+        return E_INVALIDARG;
+    if (FAILED(hr = get_item_path(item, path, ARRAY_SIZE(path))))
+        return hr;
+    wcscpy(new_path, path);
+    if (!PathRemoveFileSpecW(new_path) || !PathAppendW(new_path, op->name))
+        return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    if (!MoveFileW(path, new_path))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return SHCreateItemFromParsingName(new_path, NULL, &IID_IShellItem, (void **)new_item);
+}
+
+static HRESULT copy_engine_new(struct file_operation *operation, struct copy_engine_operation *op,
+        IShellItem **new_item)
+{
+    WCHAR folder_path[MAX_PATH], path[MAX_PATH];
+    HRESULT hr;
+
+    *new_item = NULL;
+    if (!*op->name || wcspbrk(op->name, L"\\/"))
+        return E_INVALIDARG;
+    if (FAILED(hr = get_item_path(op->folder, folder_path, ARRAY_SIZE(folder_path))))
+        return hr;
+    if (!PathCombineW(path, folder_path, op->name))
+        return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+
+    if (op->attributes & FILE_ATTRIBUTE_DIRECTORY)
+    {
+        if (!CreateDirectoryW(path, NULL))
+            return HRESULT_FROM_WIN32(GetLastError());
+    }
+    else if (op->template && *op->template)
+    {
+        if (!CopyFileW(op->template, path, TRUE))
+            return HRESULT_FROM_WIN32(GetLastError());
+    }
+    else
+    {
+        HANDLE file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                (op->attributes & ~FILE_ATTRIBUTE_DIRECTORY) ? (op->attributes & ~FILE_ATTRIBUTE_DIRECTORY)
+                : FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE)
+            return HRESULT_FROM_WIN32(GetLastError());
+        CloseHandle(file);
+    }
+
+    return SHCreateItemFromParsingName(path, NULL, &IID_IShellItem, (void **)new_item);
+}
+
+static HRESULT perform_item_operation(struct file_operation *operation, struct copy_engine_operation *op)
+{
+    HRESULT (*pre)(IFileOperationProgressSink *, struct file_operation *, struct copy_engine_operation *, void *);
+    HRESULT (*post)(IFileOperationProgressSink *, struct file_operation *, struct copy_engine_operation *, void *);
+    struct notify_item_param p = {0};
+    HRESULT hr;
+
+    switch (op->opcode)
+    {
+        case COPY_ENGINE_COPY:   pre = notify_pre_copy_item;   post = notify_post_copy_item;   break;
+        case COPY_ENGINE_DELETE: pre = notify_pre_delete_item; post = notify_post_delete_item; break;
+        case COPY_ENGINE_RENAME: pre = notify_pre_rename_item; post = notify_post_rename_item; break;
+        default:                 pre = notify_pre_new_item;    post = notify_post_new_item;    break;
+    }
+
+    if (op->item_pidl && FAILED(hr = SHCreateItemFromIDList(op->item_pidl, &IID_IShellItem, (void **)&p.item)))
+        return hr;
+    if (FAILED(hr = file_operation_notify(operation, op, FALSE, &p, pre)))
+        goto done;
+
+    switch (op->opcode)
+    {
+        case COPY_ENGINE_COPY:   p.result = copy_engine_copy(operation, op, p.item, &p.new_item); break;
+        case COPY_ENGINE_DELETE: p.result = copy_engine_delete(operation, op, p.item); break;
+        case COPY_ENGINE_RENAME: p.result = copy_engine_rename(operation, op, p.item, &p.new_item); break;
+        default:                 p.result = copy_engine_new(operation, op, &p.new_item); break;
+    }
+
+    if (FAILED(hr = file_operation_notify(operation, op, TRUE, &p, post)))
+        goto done;
+    hr = p.result;
+
+done:
+    if (p.new_item) IShellItem_Release(p.new_item);
+    if (p.item) IShellItem_Release(p.item);
+    return hr;
+}
