+/* items is an IShellItemArray or an IDataObject */
+static HRESULT add_items(struct file_operation *operation, enum copy_engine_opcode opcode, IUnknown *items,
+        IShellItem *folder, const WCHAR *name, DWORD tsf)
+{
+    IShellItemArray *array;
+    DWORD count, i;
+    HRESULT hr;
+
+    if (!items)
+        return E_INVALIDARG;
+
+    if (FAILED(IUnknown_QueryInterface(items, &IID_IShellItemArray, (void **)&array)))
+    {
+        IDataObject *data;
+
+        if (FAILED(IUnknown_QueryInterface(items, &IID_IDataObject, (void **)&data)))
+            return E_NOINTERFACE;
+        hr = SHCreateShellItemArrayFromDataObject(data, &IID_IShellItemArray, (void **)&array);
+        IDataObject_Release(data);
+        if (FAILED(hr))
+            return hr;
+    }
+
+    if (SUCCEEDED(hr = IShellItemArray_GetCount(array, &count)))
+    {
+        for (i = 0; i < count; i++)
+        {
+            IShellItem *item;
+
+            if (FAILED(hr = IShellItemArray_GetItemAt(array, i, &item)))
+                break;
+            hr = add_operation(operation, opcode, item, folder, name, NULL, tsf, NULL);
+            IShellItem_Release(item);
+            if (FAILED(hr))
+                break;
+        }
+    }
+    IShellItemArray_Release(array);
+    return hr;
+}
