+static DWORD delete_tsf(const struct file_operation *operation)
+{
+    return (operation->flags & (FOF_ALLOWUNDO | 0x80000 /* FOFX_RECYCLEONDELETE */)) ? TSF_DELETE_RECYCLE_IF_POSSIBLE : TSF_NORMAL;
+}
