+/* a string of a JOB_INFO: counted, then copied after the structure */
+static WCHAR *job_string(const WCHAR *str, WCHAR **p, DWORD *size, BOOL fill)
+{
+    WCHAR *ret = *p;
+
+    if (!str) return NULL;
+    *size += (wcslen(str) + 1) * sizeof(WCHAR);
+    if (!fill) return NULL;
+    wcscpy(*p, str);
+    *p += wcslen(str) + 1;
+    return ret;
+}
