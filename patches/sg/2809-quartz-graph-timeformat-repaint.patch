From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] quartz: filter graph time formats and EC_REPAINT default handling

The filter graph's IMediaSeeking handles media time only: SetTimeFormat
accepts TIME_FORMAT_MEDIA_TIME and TIME_FORMAT_NONE (S_OK, no change) and
returns E_NOTIMPL for every other format; ConvertTimeFormat between two
different formats returns E_NOTIMPL (equal formats copy the value). The
FIXMEs on these paths and in the IMediaPosition helpers are now WARNs.
EC_REPAINT gets the documented default handling and is not passed to the
application: the event goes to the IMediaEventSink of the output pin
connected to the renderer's pin; failing that the graph seeks to its
current position when paused, pauses and stops when stopped, and ignores
the event when running. It runs on a thread pool thread, since renderers
send the event from their streaming threads. The todo_wine marks in
tests/filtergraph.c that now pass are removed.

---
diff --git a/dlls/quartz/filtergraph.c b/dlls/quartz/filtergraph.c
index eed6207..35103af 100644
--- a/dlls/quartz/filtergraph.c
+++ b/dlls/quartz/filtergraph.c
@@ -2315,11 +2315,20 @@ static HRESULT WINAPI MediaSeeking_SetTimeFormat(IMediaSeeking *iface, const GUI
 
     TRACE("(%p/%p)->(%s)\n", This, iface, debugstr_guid(pFormat));
 
+    /* The graph only handles media time; the other formats are not supported
+     * (E_NOTIMPL), and TIME_FORMAT_NONE is accepted without changing it. */
+#ifdef SG_MUTANT_TF_SET
     if (!IsEqualGUID(&TIME_FORMAT_MEDIA_TIME, pFormat))
-    {
-        FIXME("Unhandled time format %s\n", debugstr_guid(pFormat));
         return E_INVALIDARG;
+#else
+    if (IsEqualGUID(&TIME_FORMAT_NONE, pFormat))
+        return S_OK;
+    if (!IsEqualGUID(&TIME_FORMAT_MEDIA_TIME, pFormat))
+    {
+        WARN("Unsupported time format %s.\n", debugstr_guid(pFormat));
+        return E_NOTIMPL;
     }
+#endif
 
     return S_OK;
 }
@@ -2454,11 +2463,18 @@ static HRESULT WINAPI MediaSeeking_ConvertTimeFormat(IMediaSeeking *iface, LONGL
         pTargetFormat = &This->timeformatseek;
 
     if (IsEqualGUID(pTargetFormat, pSourceFormat))
+    {
         *pTarget = Source;
-    else
-        FIXME("conversion %s->%s not supported\n", debugstr_guid(pSourceFormat), debugstr_guid(pTargetFormat));
+        return S_OK;
+    }
 
+    /* Only media time is handled, so there is nothing to convert between. */
+    WARN("conversion %s->%s not supported\n", debugstr_guid(pSourceFormat), debugstr_guid(pTargetFormat));
+#ifdef SG_MUTANT_TF_CONVERT
     return S_OK;
+#else
+    return E_NOTIMPL;
+#endif
 }
 
 static HRESULT WINAPI MediaSeeking_SetPositions(IMediaSeeking *iface, LONGLONG *current_ptr,
@@ -2806,7 +2822,7 @@ static HRESULT ConvertFromREFTIME(IMediaSeeking *seek, REFTIME time_in, LONGLONG
         return hr;
     if (!IsEqualGUID(&TIME_FORMAT_MEDIA_TIME, &time_format))
     {
-        FIXME("Unsupported time format.\n");
+        WARN("Unsupported time format.\n");
         return E_NOTIMPL;
     }
 
@@ -2824,7 +2840,7 @@ static HRESULT ConvertToREFTIME(IMediaSeeking *seek, LONGLONG time_in, REFTIME *
         return hr;
     if (!IsEqualGUID(&TIME_FORMAT_MEDIA_TIME, &time_format))
     {
-        FIXME("Unsupported time format.\n");
+        WARN("Unsupported time format.\n");
         return E_NOTIMPL;
     }
 
@@ -5571,6 +5587,67 @@ static ULONG WINAPI MediaEventSink_Release(IMediaEventSink *iface)
     return IUnknown_Release(graph->outer_unk);
 }
 
+struct repaint_work
+{
+    struct filter_graph *graph;
+    IPin *pin;
+    LONG_PTR param1, param2;
+};
+
+/* Default handling of EC_REPAINT. It runs on a thread pool thread: the event
+ * comes from a renderer's streaming thread, which may hold locks that a seek
+ * or a state change has to wait for. */
+static DWORD WINAPI handle_repaint(void *context)
+{
+    struct repaint_work *work = context;
+    struct filter_graph *graph = work->graph;
+    IMediaEventSink *sink;
+    IPin *peer;
+    HRESULT hr = E_FAIL;
+    FILTER_STATE state;
+
+    TRACE("graph %p, pin %p.\n", graph, work->pin);
+
+    /* First the upstream output pin, which may re-send its last sample. */
+    if (work->pin && SUCCEEDED(IPin_ConnectedTo(work->pin, &peer)))
+    {
+        if (SUCCEEDED(IPin_QueryInterface(peer, &IID_IMediaEventSink, (void **)&sink)))
+        {
+            hr = IMediaEventSink_Notify(sink, EC_REPAINT, work->param1, work->param2);
+            IMediaEventSink_Release(sink);
+        }
+        IPin_Release(peer);
+    }
+
+    if (FAILED(hr))
+    {
+        EnterCriticalSection(&graph->cs);
+        state = graph->state;
+        LeaveCriticalSection(&graph->cs);
+
+        if (state == State_Paused)
+        {
+            /* Seek to the current position, which flushes and re-queues the data. */
+            LONGLONG pos;
+
+            if (SUCCEEDED(IMediaSeeking_GetCurrentPosition(&graph->IMediaSeeking_iface, &pos)))
+                IMediaSeeking_SetPositions(&graph->IMediaSeeking_iface, &pos,
+                        AM_SEEKING_AbsolutePositioning, NULL, AM_SEEKING_NoPositioning);
+        }
+        else if (state == State_Stopped)
+        {
+            if (SUCCEEDED(IMediaControl_Pause(&graph->IMediaControl_iface)))
+                IMediaControl_Stop(&graph->IMediaControl_iface);
+        }
+        /* While running the renderer gets the next sample anyway. */
+    }
+
+    if (work->pin) IPin_Release(work->pin);
+    IUnknown_Release(graph->outer_unk);
+    free(work);
+    return 0;
+}
+
 static HRESULT WINAPI MediaEventSink_Notify(IMediaEventSink *iface, LONG code,
         LONG_PTR param1, LONG_PTR param2)
 {
@@ -5595,7 +5672,24 @@ static HRESULT WINAPI MediaEventSink_Notify(IMediaEventSink *iface, LONG code,
     }
     else if ((code == EC_REPAINT) && graph->HandleEcRepaint)
     {
-        FIXME("EC_REPAINT is not handled.\n");
+        /* Default action; the event is not passed on to the application. */
+#ifdef SG_MUTANT_REPAINT
+        struct repaint_work *work = NULL;
+#else
+        struct repaint_work *work = calloc(1, sizeof(*work));
+#endif
+
+        if (work)
+        {
+            work->graph = graph;
+            work->pin = (IPin *)param1;
+            work->param1 = param1;
+            work->param2 = param2;
+            if (work->pin) IPin_AddRef(work->pin);
+            IUnknown_AddRef(graph->outer_unk);
+            if (!QueueUserWorkItem(handle_repaint, work, WT_EXECUTEDEFAULT))
+                handle_repaint(work);
+        }
     }
     else if (!graph->media_events_disabled)
     {
