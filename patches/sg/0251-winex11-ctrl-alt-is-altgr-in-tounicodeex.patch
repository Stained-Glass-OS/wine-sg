From: Stained Glass OS <dev@stained-glass.example>
Subject: winex11: Ctrl+Alt is AltGr in ToUnicodeEx

Windows reads Ctrl+Alt in the key state as AltGr: ToUnicodeEx gives the
key's third-level character (German @ on Q, | on <, French # on 3), and
that is what an on-screen keyboard -- which sends AltGr as left Ctrl +
right Alt, as Windows' AltGr is -- or any program that sends Ctrl+Alt+key
types. Wine answered nothing for any Ctrl+Alt key. Now, when the X layout
has a third level on the key (XKB level 3, Shift: level 4, in the current
group), the lookup is made with the ISO_Level3_Shift (or Mode_switch)
modifier instead of Control; a key without one still gives nothing (the US
layout's Ctrl+Alt+Q), as before and as on Windows.

user32:input: 0 failures, as before.

Gate: test/kbdlayout-gate.sh (make test-kbdlayout).
---
diff --git a/dlls/winex11.drv/keyboard.c b/dlls/winex11.drv/keyboard.c
index d46b366..bf61fa2 100644
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -2339,6 +2339,7 @@ INT X11DRV_ToUnicodeEx( UINT virtKey, UINT scanCode, const BYTE *lpKeyState,
     HWND focus;
     XIC xic;
     Status status = 0;
+    BOOL altgr;
 
     check_keyboard_mapping( display );
 
@@ -2348,11 +2349,11 @@ INT X11DRV_ToUnicodeEx( UINT virtKey, UINT scanCode, const BYTE *lpKeyState,
         return 0;
     }
 
-    if ((lpKeyState[VK_MENU] & 0x80) && (lpKeyState[VK_CONTROL] & 0x80))
-    {
-        TRACE_(key)("Ctrl+Alt+[key] won't generate a character\n");
-        return 0;
-    }
+    /* Stained Glass OS: Windows reads Ctrl+Alt as AltGr -- what an on-screen
+     * keyboard sends, and what layouts with a third level (German @ on Q,
+     * French # on 3 ...) type. Such a key gives its third-level character;
+     * one without it gives none, as before. */
+    altgr = (lpKeyState[VK_MENU] & 0x80) && (lpKeyState[VK_CONTROL] & 0x80);
 
     e.display = display;
     e.keycode = 0;
@@ -2445,6 +2446,26 @@ INT X11DRV_ToUnicodeEx( UINT virtKey, UINT scanCode, const BYTE *lpKeyState,
       }
     else TRACE_(key)("Found keycode %u\n",e.keycode);
 
+    if (altgr)
+    {
+        unsigned int level3 = XkbKeysymToModifiers( display, XK_ISO_Level3_Shift );
+        XkbStateRec xkb_state;
+        KeySym sym3;
+        int group = 0;
+
+        if (!level3) level3 = XkbKeysymToModifiers( display, XK_Mode_switch );
+        if (XkbGetState( display, XkbUseCoreKbd, &xkb_state ) == Success) group = xkb_state.group;
+        sym3 = e.keycode ? XkbKeycodeToKeysym( display, e.keycode, group, (e.state & ShiftMask) ? 3 : 2 ) : NoSymbol;
+        if (!level3 || sym3 == NoSymbol)
+        {
+            TRACE_(key)("Ctrl+Alt+[key] won't generate a character\n");
+            pthread_mutex_unlock( &kbd_mutex );
+            return 0;
+        }
+        e.state = (e.state & ~ControlMask) | level3;
+        TRACE_(key)("AltGr: level-3 modifier %04x, keysym %lx\n", level3, sym3);
+    }
+
     TRACE_(key)("type %d, window %lx, state 0x%04x, keycode %u\n",
 		e.type, e.window, e.state, e.keycode);
 
