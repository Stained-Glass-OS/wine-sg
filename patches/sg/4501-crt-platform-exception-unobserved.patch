+++ b/dlls/msvcrt/except.c
@@ -1071,3 +1071,55 @@ int* CDECL __processing_throw(void)
 }
 
 #endif /* _MSVCR_VER>=140 */
+
+#if _MSVCR_VER >= 120
+
+/* the ThrowInfo attribute of exceptions thrown by C++/CX code (Platform::Exception) */
+#define THROW_INFO_WINRT 0x10
+
+/*********************************************************************
+ *  __GetPlatformExceptionInfo (MSVCR120.@)
+ *
+ * Returns the WinRT error information of the exception being handled when it
+ * is a C++/CX Platform::Exception, otherwise NULL; *is_bad_alloc tells whether
+ * it is a std::bad_alloc (callers report out of memory for those).
+ */
+void * CDECL __GetPlatformExceptionInfo(int *is_bad_alloc)
+{
+    EXCEPTION_RECORD *rec = msvcrt_get_thread_data()->exc_record;
+    const cxx_type_info_table *table;
+    const cxx_exception_type *type;
+    uintptr_t base;
+    UINT i;
+
+    TRACE("(%p)\n", is_bad_alloc);
+
+    if (is_bad_alloc) *is_bad_alloc = 0;
+    if (!rec || !is_cxx_exception(rec) || !(type = (const cxx_exception_type *)rec->ExceptionInformation[2]))
+        return NULL;
+    base = (CXX_EXCEPTION_PARAMS == 4) ? rec->ExceptionInformation[3] : 0;
+
+    if (type->flags & THROW_INFO_WINRT)
+    {
+        FIXME("WinRT exception information is not available\n");
+        return NULL;
+    }
+
+    table = rtti_rva(type->type_info_table, base);
+    for (i = 0; i < table->count; i++)
+    {
+        const cxx_type_info *info = rtti_rva(table->info[i], base);
+        const type_info *ti = rtti_rva(info->type_info, base);
+
+#ifndef SG_MUTANT_PLATFORM_NO_BADALLOC
+        if (!strcmp(ti->mangled, ".?AVbad_alloc@std@@"))
+        {
+            if (is_bad_alloc) *is_bad_alloc = 1;
+            break;
+        }
+#endif
+    }
+    return NULL;
+}
+
+#endif /* _MSVCR_VER >= 120 */
