+#if _MSVCR_VER >= 110
+/* ?_ReportUnobservedException@details@Concurrency@@YAXXZ */
+/* A task's exception that nobody observed (no get/wait, no continuation)
+ * ends the program, as the Concurrency Runtime documents. */
