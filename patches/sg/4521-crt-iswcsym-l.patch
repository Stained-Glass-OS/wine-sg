 @ cdecl _o___std_exception_copy(ptr ptr) __std_exception_copy
 @ cdecl _o___std_exception_destroy(ptr) __std_exception_destroy
 @ cdecl _o___std_type_info_destroy_list(ptr) __std_type_info_destroy_list
