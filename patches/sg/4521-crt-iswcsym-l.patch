diff --git a/dlls/msvcrt/ctype.c b/dlls/msvcrt/ctype.c
index 1297bc5..8ca2f76 100644
--- a/dlls/msvcrt/ctype.c
+++ b/dlls/msvcrt/ctype.c
@@ -468,6 +468,27 @@ int CDECL __iswcsymf(wint_t c)
   return (iswalpha(c) || c == '_');
 }
 
+#if _MSVCR_VER>=80
+/*********************************************************************
+ *		_iswcsym_l (MSVCR80.@)
+ */
+int CDECL _iswcsym_l(wint_t c, _locale_t locale)
+{
+  return (_iswalnum_l(c, locale) || c == '_');
+}
+
+/*********************************************************************
+ *		_iswcsymf_l (MSVCR80.@)
+ */
+int CDECL _iswcsymf_l(wint_t c, _locale_t locale)
+{
+#ifdef SG_MUTANT_ISWCSYMF_DIGITS
+  return (_iswalnum_l(c, locale) || c == '_');
+#endif
+  return (_iswalpha_l(c, locale) || c == '_');
+}
+#endif
+
 /*********************************************************************
  *		_toupper_l (MSVCRT.@)
  */
