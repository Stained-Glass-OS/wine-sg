+static HRESULT disp_to_nsnode(IDispatch *disp, nsIDOMNode **ret)
+{
+    IHTMLDOMNode *dom_node;
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    *ret = NULL;
+    if(!disp)
+        return E_INVALIDARG;
+
+    hres = IDispatch_QueryInterface(disp, &IID_IHTMLDOMNode, (void**)&dom_node);
+    if(FAILED(hres))
+        return E_INVALIDARG;
+
+    node = unsafe_impl_from_IHTMLDOMNode(dom_node);
+    if(node && node->nsnode)
+        *ret = node->nsnode;
+    IHTMLDOMNode_Release(dom_node);
+    return *ret ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT return_dom_node(nsIDOMNode *nsnode, IHTMLDOMNode **ret)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    if(!nsnode) {
+        *ret = NULL;
+        return S_OK;
+    }
+
+    hres = get_node(nsnode, TRUE, &node);
+    if(FAILED(hres))
+        return hres;
+
+    IHTMLDOMNode_AddRef(&node->IHTMLDOMNode_iface);
+    *ret = &node->IHTMLDOMNode_iface;
+    return S_OK;
+}
+
+/* A document node needed to create new objects related to the range. */
+static HRESULT get_range_document(HTMLDOMRange *This, HTMLDocumentNode **ret)
+{
+    nsIDOMNode *container;
+    nsIDOMDocument *dom_doc;
+    nsresult nsres;
+    HRESULT hres;
+
+    nsres = nsIDOMRange_GetStartContainer(This->nsrange, &container);
+    if(NS_FAILED(nsres) || !container)
+        return E_FAIL;
+
+    nsres = nsIDOMNode_GetOwnerDocument(container, &dom_doc);
+    nsIDOMNode_Release(container);
+    if(NS_FAILED(nsres) || !dom_doc)
+        return E_FAIL;
+
+    hres = get_document_node(dom_doc, ret);
+    nsIDOMDocument_Release(dom_doc);
+    return hres;
+}
+
+static HRESULT return_fragment(nsIDOMDocumentFragment *fragment, IDispatch **ret)
+{
+    IHTMLDOMNode *node;
+    HRESULT hres;
+
+    hres = return_dom_node((nsIDOMNode*)fragment, &node);
+    if(FAILED(hres))
+        return hres;
+
+    *ret = (IDispatch*)node;
+    return S_OK;
+}
