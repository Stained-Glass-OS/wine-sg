+static void test_adjacent_text_and_attributes(IHTMLDocument2 *doc)
+{
+    IHTMLDOMNode *first, *second;
+    IHTMLElement *parent, *a1, *a2;
+    IHTMLElement2 *a1_2, *a2_2;
+    IHTMLElement6 *a1_6;
+    VARIANT_BOOL b;
+    BSTR str;
+    HRESULT hres;
+
+    parent = test_create_elem(doc, L"div");
+    str = SysAllocString(L"<div id=\"a1\" class=\"c1\" title=\"t1\">in</div>xx<span id=\"a2\" lang=\"en\">sp</span>");
+    hres = IHTMLElement_put_innerHTML(parent, str);
+    ok(hres == S_OK, "put_innerHTML failed: %08lx\n", hres);
+    SysFreeString(str);
+
+    first = get_first_child((IUnknown*)parent);
+    a1 = get_elem_iface((IUnknown*)first);
+    hres = IHTMLDOMNode_get_nextSibling(first, &second);
+    ok(hres == S_OK, "get_nextSibling failed: %08lx\n", hres);
+    IHTMLDOMNode_Release(first);
+    IHTMLDOMNode_get_nextSibling(second, &first);
+    IHTMLDOMNode_Release(second);
+    a2 = get_elem_iface((IUnknown*)first);
+    IHTMLDOMNode_Release(first);
+
+    a1_2 = get_elem2_iface((IUnknown*)a1);
+    a2_2 = get_elem2_iface((IUnknown*)a2);
+
+    hres = IHTMLElement2_get_scopeName(a1_2, &str);
+    ok(hres == S_OK && str && !wcscmp(str, L"HTML"), "scopeName = %08lx, %s\n", hres, wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    hres = IHTMLElement_QueryInterface(a1, &IID_IHTMLElement6, (void**)&a1_6);
+    if(hres == S_OK) {
+        b = VARIANT_FALSE;
+        hres = IHTMLElement6_hasAttributes(a1_6, &b);
+        ok(hres == S_OK && b == VARIANT_TRUE, "hasAttributes = %08lx, %x\n", hres, b);
+        IHTMLElement6_Release(a1_6);
+    }
+
+    /* the text between the two elements */
+    str = get_adjacent_text(a1_2, L"afterEnd");
+    ok(str && !wcscmp(str, L"xx"), "getAdjacentText(afterEnd) = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = get_adjacent_text(a2_2, L"beforeBegin");
+    ok(str && !wcscmp(str, L"xx"), "getAdjacentText(beforeBegin) = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = get_adjacent_text(a1_2, L"afterBegin");
+    ok(str && !wcscmp(str, L"in"), "getAdjacentText(afterBegin) = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = get_adjacent_text(a1_2, L"beforeBegin");
+    ok(str && !*str, "getAdjacentText(beforeBegin) = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = replace_adjacent_text(a1_2, L"afterEnd", L"yy");
+    ok(str && !wcscmp(str, L"xx"), "replaceAdjacentText = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = get_adjacent_text(a2_2, L"beforeBegin");
+    ok(str && !wcscmp(str, L"yy"), "getAdjacentText = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    /* no text yet before the first element: one is created */
+    str = replace_adjacent_text(a1_2, L"beforeBegin", L"pre");
+    ok(str && !*str, "replaceAdjacentText = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+    str = get_adjacent_text(a1_2, L"beforeBegin");
+    ok(str && !wcscmp(str, L"pre"), "getAdjacentText = %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    /* merging keeps the identity of the target */
