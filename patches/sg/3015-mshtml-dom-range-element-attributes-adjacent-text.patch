+static void test_dom_range_ops(IHTMLDocument2 *doc, IHTMLDOMRange *range)
+{
+    IHTMLDOMNode *node, *node2;
+    IHTMLDOMRange *range2;
+    IHTMLElement *body, *div;
+    IDispatch *disp, *frag;
+    VARIANT_BOOL b;
+    LONG l;
+    BSTR str;
+    HRESULT hres;
+
+    hres = IHTMLDocument2_get_body(doc, &body);
+    ok(hres == S_OK && body, "get_body failed: %08lx\n", hres);
+    div = test_create_elem(doc, L"div");
+    str = SysAllocString(L"<b id=\"r1\">hello</b> world");
+    hres = IHTMLElement_put_innerHTML(div, str);
+    ok(hres == S_OK, "put_innerHTML failed: %08lx\n", hres);
+    SysFreeString(str);
+
+    hres = IHTMLDOMRange_selectNodeContents(range, (IDispatch*)div);
+    ok(hres == S_OK, "selectNodeContents failed: %08lx\n", hres);
+
+    node = NULL;
+    hres = IHTMLDOMRange_get_startContainer(range, &node);
+    ok(hres == S_OK && node, "get_startContainer returned %08lx, %p\n", hres, node);
+    if(node) {
+        hres = IHTMLDOMNode_QueryInterface(node, &IID_IDispatch, (void**)&disp);
+        ok(hres == S_OK, "QueryInterface(IDispatch) failed: %08lx\n", hres);
+        IDispatch_Release(disp);
+        IHTMLDOMNode_Release(node);
+    }
+
+    l = -1;
+    hres = IHTMLDOMRange_get_startOffset(range, &l);
+    ok(hres == S_OK && l == 0, "get_startOffset returned %08lx, %ld\n", hres, l);
+    l = -1;
+    hres = IHTMLDOMRange_get_endOffset(range, &l);
+    ok(hres == S_OK && l == 2, "get_endOffset returned %08lx, %ld\n", hres, l);
+    b = VARIANT_TRUE;
+    hres = IHTMLDOMRange_get_collapsed(range, &b);
+    ok(hres == S_OK && b == VARIANT_FALSE, "get_collapsed returned %08lx, %x\n", hres, b);
+
+    str = NULL;
+    hres = IHTMLDOMRange_toString(range, &str);
+    ok(hres == S_OK && str && !wcscmp(str, L"hello world"), "toString returned %08lx, %s\n", hres, wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    hres = IHTMLDOMRange_cloneRange(range, &range2);
+    ok(hres == S_OK && range2, "cloneRange failed: %08lx\n", hres);
+    if(range2) {
+        l = 5;
+        hres = IHTMLDOMRange_compareBoundaryPoints(range, 0, (IDispatch*)range2, &l);
+        ok(hres == S_OK && l == 0, "compareBoundaryPoints returned %08lx, %ld\n", hres, l);
+
+        hres = IHTMLDOMRange_collapse(range2, VARIANT_TRUE);
+        ok(hres == S_OK, "collapse failed: %08lx\n", hres);
+        b = VARIANT_FALSE;
+        hres = IHTMLDOMRange_get_collapsed(range2, &b);
+        ok(hres == S_OK && b == VARIANT_TRUE, "get_collapsed returned %08lx, %x\n", hres, b);
+        IHTMLDOMRange_Release(range2);
+    }
+
+    frag = NULL;
+    hres = IHTMLDOMRange_cloneContents(range, &frag);
+    ok(hres == S_OK && frag, "cloneContents returned %08lx, %p\n", hres, frag);
+    if(frag) {
+        hres = IDispatch_QueryInterface(frag, &IID_IHTMLDOMNode, (void**)&node);
+        ok(hres == S_OK, "fragment is not a node: %08lx\n", hres);
+        if(hres == S_OK) {
+            hres = IHTMLDOMNode_get_nodeType(node, &l);
+            ok(hres == S_OK && l == 11, "nodeType = %08lx, %ld\n", hres, l);
+            IHTMLDOMNode_Release(node);
+        }
+        IDispatch_Release(frag);
+    }
+
+    /* the original contents are still there; extracting moves them */
+    frag = NULL;
+    hres = IHTMLDOMRange_extractContents(range, &frag);
+    ok(hres == S_OK && frag, "extractContents returned %08lx, %p\n", hres, frag);
+    if(frag) IDispatch_Release(frag);
+    b = VARIANT_FALSE;
+    hres = IHTMLDOMRange_get_collapsed(range, &b);
+    ok(hres == S_OK && b == VARIANT_TRUE, "get_collapsed returned %08lx, %x\n", hres, b);
+    hres = IHTMLElement_get_innerHTML(div, &str);
+    ok(hres == S_OK && (!str || !*str), "innerHTML after extractContents: %s\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    node2 = NULL;
+    hres = IHTMLDOMRange_get_commonAncestorContainer(range, &node2);
+    ok(hres == S_OK && node2, "get_commonAncestorContainer returned %08lx, %p\n", hres, node2);
+    if(node2) IHTMLDOMNode_Release(node2);
+
+    hres = IHTMLDOMRange_detach(range);
+    ok(hres == S_OK, "detach failed: %08lx\n", hres);
+
+    IHTMLElement_Release(div);
+    IHTMLElement_Release(body);
+}
