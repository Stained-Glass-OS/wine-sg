+/* Copies (merge) or removes (src == NULL) the attributes of an element. */
+static HRESULT process_attributes(HTMLElement *dst, HTMLElement *src, BOOL preserve_identity)
+{
+    nsIDOMMozNamedAttrMap *attrs;
+    HTMLElement *elem = src ? src : dst;
+    UINT32 i, length;
+    nsresult nsres;
+    HRESULT hres = S_OK;
+
+    if(!elem->dom_element || (src && !dst->dom_element))
+        return E_UNEXPECTED;
+
+    nsres = nsIDOMElement_GetAttributes(elem->dom_element, &attrs);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+
+    nsres = nsIDOMMozNamedAttrMap_GetLength(attrs, &length);
+    if(NS_FAILED(nsres)) {
+        nsIDOMMozNamedAttrMap_Release(attrs);
+        return map_nsresult(nsres);
+    }
+
+    /* walk backwards so that removals don't shift the remaining attributes */
+    for(i = length; i--; ) {
+        nsAString name_str, value_str;
+        nsIDOMAttr *attr;
+        const WCHAR *name;
+
+        nsres = nsIDOMMozNamedAttrMap_Item(attrs, i, &attr);
+        if(NS_FAILED(nsres) || !attr)
+            continue;
+
+        nsAString_Init(&name_str, NULL);
+        nsIDOMAttr_GetName(attr, &name_str);
+        nsAString_GetData(&name_str, &name);
+
+        if(preserve_identity && (!wcsicmp(name, L"id") || !wcsicmp(name, L"name"))) {
+            nsAString_Finish(&name_str);
+            nsIDOMAttr_Release(attr);
+            continue;
+        }
+
+        if(src) {
+            nsAString_Init(&value_str, NULL);
+            nsIDOMAttr_GetValue(attr, &value_str);
+            nsres = nsIDOMElement_SetAttribute(dst->dom_element, &name_str, &value_str);
+            nsAString_Finish(&value_str);
+        }else
+            nsres = nsIDOMElement_RemoveAttribute(dst->dom_element, &name_str);
+        if(NS_FAILED(nsres))
+            hres = map_nsresult(nsres);
+
+        nsAString_Finish(&name_str);
+        nsIDOMAttr_Release(attr);
+    }
+
+    nsIDOMMozNamedAttrMap_Release(attrs);
+    return hres;
+}
+
