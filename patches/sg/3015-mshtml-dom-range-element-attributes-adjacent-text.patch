+static HRESULT get_adjacent_text_node(HTMLElement *elem, const WCHAR *where, nsIDOMNode **ret, nsIDOMNode **parent, nsIDOMNode **before)
+{
+    nsIDOMNode *node = NULL;
+    nsresult nsres;
+
+    *ret = *parent = *before = NULL;
+
+    if(!wcsicmp(where, L"beforeBegin")) {
+        nsres = nsIDOMNode_GetPreviousSibling(elem->node.nsnode, &node);
+        nsIDOMNode_GetParentNode(elem->node.nsnode, parent);
+        nsIDOMNode_AddRef(elem->node.nsnode);
+        *before = elem->node.nsnode;
+    }else if(!wcsicmp(where, L"afterBegin")) {
+        nsres = nsIDOMNode_GetFirstChild(elem->node.nsnode, &node);
+        nsIDOMNode_AddRef(elem->node.nsnode);
+        *parent = elem->node.nsnode;
+        if(node) {
+            nsIDOMNode_AddRef(node);
+            *before = node;
+        }
+    }else if(!wcsicmp(where, L"beforeEnd")) {
+        nsres = nsIDOMNode_GetLastChild(elem->node.nsnode, &node);
+        nsIDOMNode_AddRef(elem->node.nsnode);
+        *parent = elem->node.nsnode;
+    }else if(!wcsicmp(where, L"afterEnd")) {
+        nsres = nsIDOMNode_GetNextSibling(elem->node.nsnode, &node);
+        nsIDOMNode_GetParentNode(elem->node.nsnode, parent);
+        if(node) {
+            nsIDOMNode_AddRef(node);
+            *before = node;
+        }
+    }else
+        return E_INVALIDARG;
+
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+
+    if(node) {
+        UINT16 type = 0;
+
+        nsIDOMNode_GetNodeType(node, &type);
+        if(type == TEXT_NODE) {
+            *ret = node;
+            return S_OK;
+        }
+        nsIDOMNode_Release(node);
+    }
+    return S_OK;
+}
+
 static HRESULT WINAPI HTMLElement2_getAdjacentText(IHTMLElement2 *iface, BSTR where, BSTR *text)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%s %p)\n", This, debugstr_w(where), text);
-    return E_NOTIMPL;
+    nsIDOMNode *node, *parent, *before;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %p)\n", This, debugstr_w(where), text);
+
+    if(!where || !text)
+        return E_INVALIDARG;
+
+    hres = get_adjacent_text_node(This, where, &node, &parent, &before);
+    if(FAILED(hres))
+        return hres;
+    if(parent) nsIDOMNode_Release(parent);
+    if(before) nsIDOMNode_Release(before);
+
+    if(node) {
+        nsAString str;
+        nsresult nsres;
+
+        nsAString_Init(&str, NULL);
+        nsres = nsIDOMNode_GetNodeValue(node, &str);
+        nsIDOMNode_Release(node);
+        return return_nsstr(nsres, &str, text);
+    }
+
+    *text = SysAllocString(L"");
+    return *text ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI HTMLElement2_replaceAdjacentText(IHTMLElement2 *iface, BSTR where,
                                                        BSTR newText, BSTR *oldText)
 {
     HTMLElement *This = impl_from_IHTMLElement2(iface);
-    FIXME("(%p)->(%s %s %p)\n", This, debugstr_w(where), debugstr_w(newText), oldText);
-    return E_NOTIMPL;
+    nsIDOMNode *node, *parent, *before;
+    nsAString str;
+    nsresult nsres;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %s %p)\n", This, debugstr_w(where), debugstr_w(newText), oldText);
+
+    if(!where || !oldText)
+        return E_INVALIDARG;
+
+    hres = get_adjacent_text_node(This, where, &node, &parent, &before);
+    if(FAILED(hres))
+        return hres;
+
+    nsAString_InitDepend(&str, newText ? newText : L"");
+
+    if(node) {
+        nsAString old;
+
+        nsAString_Init(&old, NULL);
+        nsres = nsIDOMNode_GetNodeValue(node, &old);
+        hres = return_nsstr(nsres, &old, oldText);
+        if(SUCCEEDED(hres)) {
+            nsres = nsIDOMNode_SetNodeValue(node, &str);
+            hres = map_nsresult(nsres);
+        }
+        nsIDOMNode_Release(node);
+    }else {
+        nsIDOMText *text_node;
+
+        *oldText = SysAllocString(L"");
+        if(!*oldText)
+            hres = E_OUTOFMEMORY;
+        else if(!parent)
+            hres = E_FAIL;
+        else {
+            nsres = nsIDOMDocument_CreateTextNode(This->node.doc->dom_document, &str, &text_node);
+            if(NS_SUCCEEDED(nsres)) {
+                nsIDOMNode *tmp = NULL;
+
+                if(before)
+                    nsres = nsIDOMNode_InsertBefore(parent, (nsIDOMNode*)text_node, before, &tmp);
+                else
+                    nsres = nsIDOMNode_AppendChild(parent, (nsIDOMNode*)text_node, &tmp);
+                if(tmp)
+                    nsIDOMNode_Release(tmp);
+                nsIDOMText_Release(text_node);
+            }
+            hres = map_nsresult(nsres);
+        }
+    }
+
+    nsAString_Finish(&str);
+    if(parent) nsIDOMNode_Release(parent);
+    if(before) nsIDOMNode_Release(before);
+    return hres;
 }
 
