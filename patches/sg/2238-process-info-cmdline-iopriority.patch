From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: ProcessCommandLineInformation, ProcessIoPriority, ProcessProtectionInformation

NtQueryInformationProcess answered STATUS_NOT_IMPLEMENTED / INVALID_INFO_CLASS
for three classes programs use: ProcessIoPriority (a ULONG, the normal
priority 2: Windows' own tests expect it to succeed),
ProcessProtectionInformation (a PS_PROTECTION byte, 0: no protected
processes) and ProcessCommandLineInformation (a UNICODE_STRING followed by
the text, read from the target's process parameters; a zero length buffer
returns the size needed). wow64 passes the first two through and converts
the string header of the third.

---
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1460,6 +1460,75 @@ static ULONG get_process_cookie(void)
     return cookie;
 }
 
+/* check a process handle can be queried */
+static NTSTATUS validate_process_handle( HANDLE handle )
+{
+    NTSTATUS status;
+
+    SERVER_START_REQ( get_process_info )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+/* the command line of a process, read from its parameters block */
+static NTSTATUS get_process_command_line( HANDLE handle, UNICODE_STRING *str, ULONG size, ULONG *ret_len )
+{
+    RTL_USER_PROCESS_PARAMETERS *params = NULL;
+    UNICODE_STRING cmd;
+    PEB *peb = NULL;
+    NTSTATUS status;
+    BOOL self = FALSE;
+    SIZE_T read;
+
+    if (is_old_wow64()) return STATUS_NOT_IMPLEMENTED;
+
+    SERVER_START_REQ( get_process_info )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        if (!(status = wine_server_call( req )))
+        {
+            peb = wine_server_get_ptr( reply->peb );
+            self = (HANDLE)(ULONG_PTR)reply->pid == NtCurrentTeb()->ClientId.UniqueProcess;
+#ifdef SG_MUTANT_CMDLINE_OWN
+            self = TRUE;
+#endif
+        }
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+    if (!peb) return STATUS_PROCESS_IS_TERMINATING;
+
+    if (self) params = peb->ProcessParameters;
+    else if (NtReadVirtualMemory( handle, &peb->ProcessParameters, &params, sizeof(params), &read ) ||
+             read != sizeof(params))
+        return STATUS_PARTIAL_COPY;
+    if (!params) return STATUS_PROCESS_IS_TERMINATING;
+
+    if (self) cmd = params->CommandLine;
+    else if (NtReadVirtualMemory( handle, &params->CommandLine, &cmd, sizeof(cmd), &read ) || read != sizeof(cmd))
+        return STATUS_PARTIAL_COPY;
+
+    *ret_len = sizeof(UNICODE_STRING) + cmd.Length + sizeof(WCHAR);
+    if (size < *ret_len) return STATUS_INFO_LENGTH_MISMATCH;
+    if (!str) return STATUS_ACCESS_VIOLATION;
+    if (cmd.Length)
+    {
+        if (self) memcpy( str + 1, cmd.Buffer, cmd.Length );
+        else if (NtReadVirtualMemory( handle, cmd.Buffer, str + 1, cmd.Length, &read ) || read != cmd.Length)
+            return STATUS_PARTIAL_COPY;
+    }
+    ((WCHAR *)(str + 1))[cmd.Length / sizeof(WCHAR)] = 0;
+    str->Length = cmd.Length;
+    str->MaximumLength = cmd.Length + sizeof(WCHAR);
+    str->Buffer = (WCHAR *)(str + 1);
+    return STATUS_SUCCESS;
+}
+
+
 /**********************************************************************
  *           NtQueryInformationProcess  (NTDLL.@)
  */
@@ -1944,6 +2013,36 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
         SERVER_END_REQ;
         break;
 
+    case ProcessIoPriority:
+        /* the I/O priority is not tracked: every process has the normal one */
+        len = sizeof(ULONG);
+        if (size != len) ret = STATUS_INFO_LENGTH_MISMATCH;
+        else if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else if (!(ret = validate_process_handle( handle )))
+#ifdef SG_MUTANT_IOPRIO
+            *(ULONG *)info = 0;
+#else
+            *(ULONG *)info = 2;  /* IoPriorityNormal */
+#endif
+        break;
+
+    case ProcessProtectionInformation:
+        /* PS_PROTECTION: nothing is a protected process here */
+        len = sizeof(BYTE);
+        if (size != len) ret = STATUS_INFO_LENGTH_MISMATCH;
+        else if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else if (!(ret = validate_process_handle( handle )))
+            *(BYTE *)info = 0;
+        break;
+
+    case ProcessCommandLineInformation:
+        {
+            ULONG needed = sizeof(UNICODE_STRING);
+            ret = get_process_command_line( handle, info, size, &needed );
+            len = needed;
+        }
+        break;
+
     case ProcessExecuteFlags:
         len = sizeof(ULONG);
         if (size != len)
--- a/dlls/wow64/process.c
+++ b/dlls/wow64/process.c
@@ -569,6 +569,8 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
     case ProcessLeapSecondInformation:  /* PROCESS_LEAP_SECOND_INFO */
     case ProcessPriorityBoost:  /* ULONG */
     case ProcessLUIDDeviceMapsEnabled:  /* ULONG */
+    case ProcessIoPriority:  /* ULONG */
+    case ProcessProtectionInformation:  /* PS_PROTECTION */
     case ProcessWorkingSetWatch:  /* never enabled: nothing to return */
     case ProcessHandleTracing:  /* never enabled: nothing to return */
         /* FIXME: check buffer alignment */
@@ -703,6 +705,7 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
 
     case ProcessImageFileName:
     case ProcessImageFileNameWin32:  /* UNICODE_STRING + string */
+    case ProcessCommandLineInformation:
         {
             ULONG retsize, size = len + sizeof(UNICODE_STRING) - sizeof(UNICODE_STRING32);
             UNICODE_STRING *str = Wow64AllocateTemp( size );
