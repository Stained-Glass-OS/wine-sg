Subject: [PATCH] netio.sys: WskControlSocket (patch 5096)

Set/get option and ioctl requests via setsockopt/getsockopt/WSAIoctl, with and
without an IRP; gap-CORE item 1175. Gate with three mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/netio.sys/netio.c b/dlls/netio.sys/netio.c
--- a/dlls/netio.sys/netio.c
+++ b/dlls/netio.sys/netio.c
@@ -230,16 +230,100 @@
     io->irp = NULL;
 }
 
+static void WINAPI send_receive_callback(TP_CALLBACK_INSTANCE *instance, void *socket_, TP_WAIT *wait,
+        TP_WAIT_RESULT wait_result);
+
+/* WskControlSocket: options map to setsockopt / getsockopt at the given level, I/O controls
+ * to WSAIoctl (asynchronously when the caller gave an IRP).  The WSK specific options
+ * (SO_WSK_EVENT_CALLBACK, SO_WSK_SECURITY, ...) are not known to Winsock and fail. */
 static NTSTATUS WINAPI wsk_control_socket(WSK_SOCKET *socket, WSK_CONTROL_SOCKET_TYPE request_type,
         ULONG control_code, ULONG level, SIZE_T input_size, void *input_buffer, SIZE_T output_size,
         void *output_buffer, SIZE_T *output_size_returned, IRP *irp)
 {
-    FIXME("socket %p, request_type %u, control_code %#lx, level %lu, input_size %Iu, input_buffer %p, "
-            "output_size %Iu, output_buffer %p, output_size_returned %p, irp %p stub.\n",
+    struct wsk_socket_internal *s = wsk_socket_internal_from_wsk_socket(socket);
+    struct wsk_pending_io *io;
+    NTSTATUS status;
+    DWORD returned = 0;
+    int length, error = 0;
+
+    TRACE("socket %p, request_type %u, control_code %#lx, level %lu, input_size %Iu, input_buffer %p, "
+            "output_size %Iu, output_buffer %p, output_size_returned %p, irp %p.\n",
             socket, request_type, control_code, level, input_size, input_buffer, output_size,
             output_buffer, output_size_returned, irp);
 
-    return STATUS_NOT_IMPLEMENTED;
+    if (input_size && !input_buffer)
+        return STATUS_INVALID_PARAMETER;
+    if (output_size && !output_buffer)
+        return STATUS_INVALID_PARAMETER;
+
+    if (irp)
+        irp->IoStatus.Information = 0;
+    if (output_size_returned)
+        *output_size_returned = 0;
+
+    switch (request_type)
+    {
+#ifndef SG_MUTANT_NETIO_SETOPT
+        case WskSetOption:
+            if (setsockopt(s->s, level, control_code, input_buffer, input_size))
+                error = WSAGetLastError();
+            break;
+#endif
+
+#ifndef SG_MUTANT_NETIO_GETOPT
+        case WskGetOption:
+            length = output_size;
+            if (getsockopt(s->s, level, control_code, output_buffer, &length))
+                error = WSAGetLastError();
+            else
+                returned = length;
+            break;
+#endif
+
+#ifndef SG_MUTANT_NETIO_IOCTL
+        case WskIoctl:
+            if (irp)
+            {
+                lock_socket(s);
+                if (!(io = allocate_pending_io(s, send_receive_callback, irp)))
+                {
+                    dispatch_irp(irp, STATUS_UNSUCCESSFUL);
+                    unlock_socket(s);
+                    return STATUS_PENDING;
+                }
+                if (!WSAIoctl(s->s, control_code, input_buffer, input_size, output_buffer, output_size,
+                        &returned, &io->ovr, NULL))
+                    dispatch_pending_io(io, STATUS_SUCCESS, returned);
+                else if ((error = WSAGetLastError()) == WSA_IO_PENDING)
+                    SetThreadpoolWait(io->tp_wait, io->ovr.hEvent, NULL);
+                else
+                    dispatch_pending_io(io, sock_error_to_ntstatus(error), 0);
+                unlock_socket(s);
+                if (output_size_returned)
+                    *output_size_returned = returned;
+                return STATUS_PENDING;
+            }
+            if (WSAIoctl(s->s, control_code, input_buffer, input_size, output_buffer, output_size,
+                    &returned, NULL, NULL))
+                error = WSAGetLastError();
+            break;
+#endif
+
+        default:
+            error = WSAEINVAL;
+            break;
+    }
+
+    status = sock_error_to_ntstatus(error);
+    if (output_size_returned)
+        *output_size_returned = returned;
+    if (irp)
+    {
+        irp->IoStatus.Information = returned;
+        dispatch_irp(irp, status);
+        return STATUS_PENDING;
+    }
+    return status;
 }
 
 static NTSTATUS WINAPI wsk_close_socket(WSK_SOCKET *socket, IRP *irp)
diff --git a/dlls/ntoskrnl.exe/tests/driver_netio.c b/dlls/ntoskrnl.exe/tests/driver_netio.c
--- a/dlls/ntoskrnl.exe/tests/driver_netio.c
+++ b/dlls/ntoskrnl.exe/tests/driver_netio.c
@@ -169,6 +169,61 @@
 
 #define TEST_BUFFER_LENGTH 256
 
+#ifndef SOL_SOCKET
+#define SOL_SOCKET 0xffff
+#endif
+#ifndef SO_KEEPALIVE
+#define SO_KEEPALIVE 0x0008
+#endif
+#define TEST_FIONREAD 0x4004667f
+
+/* prepares the shared IRP for the next WSK call */
+static IRP *prepare_irp(void)
+{
+    IoReuseIrp(wsk_irp, STATUS_UNSUCCESSFUL);
+    IoSetCompletionRoutine(wsk_irp, irp_completion_routine, &irp_complete_event, TRUE, TRUE, TRUE);
+    wsk_irp->IoStatus.Status = 0xdeadbeef;
+    wsk_irp->IoStatus.Information = 0xdeadbeef;
+    return wsk_irp;
+}
+
+/* waits for the shared IRP when the call returned pending; returns the IRP status */
+static NTSTATUS finish_irp(NTSTATUS call_status)
+{
+    LARGE_INTEGER timeout;
+    NTSTATUS status;
+
+    timeout.QuadPart = -5000 * 10000;
+    ok(call_status == STATUS_PENDING, "Got unexpected status %#lx.\n", call_status);
+    status = KeWaitForSingleObject(&irp_complete_event, Executive, KernelMode, FALSE, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected wait status %#lx.\n", status);
+    return wsk_irp->IoStatus.Status;
+}
+
+static WSK_SOCKET *create_test_socket(USHORT type, ULONG protocol, ULONG flags)
+{
+    static struct socket_context context;
+    const void *dispatch;
+    NTSTATUS status;
+
+    prepare_irp();
+    status = provider_npi.Dispatch->WskSocket(provider_npi.Client, AF_INET, type, protocol, flags,
+            &context, &dispatch, NULL, NULL, NULL, wsk_irp);
+    status = finish_irp(status);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    return (WSK_SOCKET *)wsk_irp->IoStatus.Information;
+}
+
+static void close_test_socket(WSK_SOCKET *socket)
+{
+    const WSK_PROVIDER_BASIC_DISPATCH *basic = socket->Dispatch;
+    NTSTATUS status;
+
+    prepare_irp();
+    status = finish_irp(basic->WskCloseSocket(socket, wsk_irp));
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+}
+
 static void test_wsk_listen_socket(void)
 {
     static const char test_receive_string[] = "Client test string 1.";
@@ -526,6 +581,81 @@
             wsk_irp->IoStatus.Information);
 }
 
+
+static void test_wsk_control_socket(void)
+{
+    static const struct
+    {
+        WSK_CONTROL_SOCKET_TYPE type;
+        ULONG code;
+        ULONG level;
+        ULONG input;
+        NTSTATUS status;
+        ULONG output;
+        const char *name;
+    }
+    tests[] =
+    {
+        {WskSetOption, SO_KEEPALIVE, SOL_SOCKET, 1, STATUS_SUCCESS, 0, "set keepalive on"},
+        {WskGetOption, SO_KEEPALIVE, SOL_SOCKET, 0, STATUS_SUCCESS, 1, "get keepalive"},
+        {WskSetOption, SO_KEEPALIVE, SOL_SOCKET, 0, STATUS_SUCCESS, 0, "set keepalive off"},
+        {WskGetOption, SO_KEEPALIVE, SOL_SOCKET, 0, STATUS_SUCCESS, 1, "get keepalive 2"},
+        {WskSetOption, TCP_NODELAY, IPPROTO_TCP, 1, STATUS_SUCCESS, 0, "set nodelay"},
+        {WskGetOption, TCP_NODELAY, IPPROTO_TCP, 0, STATUS_SUCCESS, 1, "get nodelay"},
+        {WskGetOption, 0x7fff, SOL_SOCKET, 0, STATUS_INVALID_PARAMETER, 0, "bad option"},
+        {WskIoctl, TEST_FIONREAD, 0, 0, STATUS_SUCCESS, 4, "ioctl fionread"},
+        {WskIoctl, 0xc8000006 /* SIO_GET_EXTENSION_FUNCTION_POINTER */, 0, 0, STATUS_INVALID_PARAMETER, 0, "bad ioctl"},
+        {(WSK_CONTROL_SOCKET_TYPE)7, 0, 0, 0, STATUS_INVALID_PARAMETER, 0, "bad request type"},
+    };
+    const WSK_PROVIDER_BASIC_DISPATCH *basic;
+    SIZE_T returned;
+    WSK_SOCKET *socket;
+    NTSTATUS status;
+    unsigned int i;
+    ULONG in, out;
+
+    socket = create_test_socket(SOCK_STREAM, IPPROTO_TCP, WSK_FLAG_CONNECTION_SOCKET);
+    basic = socket->Dispatch;
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        /* without an IRP the call completes synchronously */
+        in = tests[i].input;
+        out = 0xdeadbeef;
+        returned = 0xdeadbeef;
+        status = basic->WskControlSocket(socket, tests[i].type, tests[i].code, tests[i].level,
+                sizeof(in), &in, sizeof(out), &out, &returned, NULL);
+        ok(status == tests[i].status, "%s: got unexpected status %#lx.\n", tests[i].name, status);
+        ok(tests[i].type == WskGetOption && !status ? !!returned : returned == tests[i].output,
+                "%s: got returned %Iu.\n", tests[i].name, returned);
+        if (tests[i].type == WskGetOption && !status)
+            ok(i == 3 ? !(out & 0xff) : !!(out & 0xff), "%s: got value %#lx.\n", tests[i].name, out);
+        if (tests[i].type == WskIoctl && !status)
+            ok(!out, "%s: got value %#lx.\n", tests[i].name, out);
+
+        /* with an IRP the status is the IRP's */
+        in = tests[i].input;
+        out = 0xdeadbeef;
+        returned = 0xdeadbeef;
+        prepare_irp();
+        status = basic->WskControlSocket(socket, tests[i].type, tests[i].code, tests[i].level,
+                sizeof(in), &in, sizeof(out), &out, &returned, wsk_irp);
+        status = finish_irp(status);
+        ok(status == tests[i].status, "%s: irp: got unexpected status %#lx.\n", tests[i].name, status);
+        ok(tests[i].type == WskGetOption && !status ? !!wsk_irp->IoStatus.Information
+                : wsk_irp->IoStatus.Information == tests[i].output, "%s: irp: got Information %Iu.\n",
+                tests[i].name, wsk_irp->IoStatus.Information);
+        if (tests[i].type == WskGetOption && !status)
+            ok(i == 3 ? !(out & 0xff) : !!(out & 0xff), "%s: irp: got value %#lx.\n", tests[i].name, out);
+    }
+
+    /* an input size without an input buffer */
+    status = basic->WskControlSocket(socket, WskSetOption, SO_KEEPALIVE, SOL_SOCKET, 4, NULL, 0, NULL, NULL, NULL);
+    ok(status == STATUS_INVALID_PARAMETER, "Got unexpected status %#lx.\n", status);
+
+    close_test_socket(socket);
+}
+
 static NTSTATUS main_test(DEVICE_OBJECT *device, IRP *irp, IO_STACK_LOCATION *stack)
 {
     void *buffer = irp->AssociatedIrp.SystemBuffer;
@@ -537,6 +667,7 @@
     test_wsk_get_address_info();
     test_wsk_listen_socket();
     test_wsk_connect_socket();
+    test_wsk_control_socket();
 
     irp->IoStatus.Information = 0;
     return STATUS_SUCCESS;
