Date: Mon, 12 Oct 2026 16:06:27 -0700
Subject: [PATCH] windows.storage.applicationdata: LocalFolder, RoamingFolder,
 TemporaryFolder

The folders of an application are StorageFolders on %LOCALAPPDATA%\Packages\<family>\{LocalState,
RoamingState,TempState}, created on demand.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/windows.storage.applicationdata/applicationdata.c b/dlls/windows.storage.applicationdata/applicationdata.c
index d0f3373..d7401ed 100644
--- a/dlls/windows.storage.applicationdata/applicationdata.c
+++ b/dlls/windows.storage.applicationdata/applicationdata.c
@@ -963,26 +963,64 @@ static HRESULT WINAPI application_data_get_RoamingSettings( IApplicationData *if
     return get_settings( impl_from_IApplicationData( iface ), ApplicationDataLocality_Roaming, value );
 }
 
-/* The folders need Windows.Storage.StorageFolder, which is not implemented. */
+/* %LOCALAPPDATA%\\Packages\\<family>\\<sub>, created, as a StorageFolder */
+static HRESULT get_folder( struct application_data *impl, const WCHAR *sub, IStorageFolder **value )
+{
+    IStorageFolderStatics *statics;
+    IAsyncOperation_StorageFolder *operation;
+    WCHAR path[MAX_PATH * 2], *p;
+    HSTRING class_name, str;
+    DWORD len;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(len = GetEnvironmentVariableW( L"LOCALAPPDATA", path, MAX_PATH )) || len >= MAX_PATH) return E_FAIL;
+    swprintf( path + len, ARRAY_SIZE(path) - len, L"\\Packages\\%ls\\%ls", impl->family, sub );
+    for (p = path + len + 1; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW( path, NULL );
+        *p = '\\';
+    }
+    if (!CreateDirectoryW( path, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
+        return HRESULT_FROM_WIN32( GetLastError() );
+
+    if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Storage_StorageFolder,
+                                         wcslen( RuntimeClass_Windows_Storage_StorageFolder ), &class_name ))) return hr;
+    hr = RoGetActivationFactory( class_name, &IID_IStorageFolderStatics, (void **)&statics );
+    WindowsDeleteString( class_name );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = WindowsCreateString( path, wcslen( path ), &str )))
+    {
+        if (SUCCEEDED(hr = IStorageFolderStatics_GetFolderFromPathAsync( statics, str, &operation )))
+        {
+            hr = IAsyncOperation_StorageFolder_GetResults( operation, value );
+            IAsyncOperation_StorageFolder_Release( operation );
+        }
+        WindowsDeleteString( str );
+    }
+    IStorageFolderStatics_Release( statics );
+    return hr;
+}
+
 static HRESULT WINAPI application_data_get_LocalFolder( IApplicationData *iface, IStorageFolder **value )
 {
-    FIXME( "iface %p, value %p: StorageFolder is not implemented.\n", iface, value );
-    if (value) *value = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_folder( impl_from_IApplicationData( iface ), L"LocalState", value );
 }
 
 static HRESULT WINAPI application_data_get_RoamingFolder( IApplicationData *iface, IStorageFolder **value )
 {
-    FIXME( "iface %p, value %p: StorageFolder is not implemented.\n", iface, value );
-    if (value) *value = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_folder( impl_from_IApplicationData( iface ), L"RoamingState", value );
 }
 
 static HRESULT WINAPI application_data_get_TemporaryFolder( IApplicationData *iface, IStorageFolder **value )
 {
-    FIXME( "iface %p, value %p: StorageFolder is not implemented.\n", iface, value );
-    if (value) *value = NULL;
-    return E_NOTIMPL;
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_folder( impl_from_IApplicationData( iface ), L"TempState", value );
 }
 
 static HRESULT WINAPI application_data_add_DataChanged( IApplicationData *iface, ITypedEventHandler_ApplicationData_IInspectable *handler,
diff --git a/dlls/windows.storage.applicationdata/tests/data.c b/dlls/windows.storage.applicationdata/tests/data.c
index b1eaaf8..a74b1dd 100644
--- a/dlls/windows.storage.applicationdata/tests/data.c
+++ b/dlls/windows.storage.applicationdata/tests/data.c
@@ -197,6 +197,37 @@ static void test_packaged_data(void)
     hr = IApplicationData_get_Version( data, &version );
     ok( hr == S_OK && version == 3, "got hr %#lx, version %u.\n", hr, version );
 
+    {
+        static const WCHAR *folders[] = { L"LocalState", L"RoamingState", L"TempState" };
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(folders); i++)
+        {
+            IStorageFolder *folder;
+            IStorageItem *item;
+            HSTRING path;
+            WCHAR expect[MAX_PATH * 2];
+
+            if (i == 0) hr = IApplicationData_get_LocalFolder( data, &folder );
+            else if (i == 1) hr = IApplicationData_get_RoamingFolder( data, &folder );
+            else hr = IApplicationData_get_TemporaryFolder( data, &folder );
+            ok( hr == S_OK && folder, "%s: got hr %#lx.\n", debugstr_w( folders[i] ), hr );
+            if (!folder) continue;
+            hr = IStorageFolder_QueryInterface( folder, &IID_IStorageItem, (void **)&item );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IStorageItem_get_Path( item, &path );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            GetEnvironmentVariableW( L"LOCALAPPDATA", expect, MAX_PATH );
+            swprintf( expect + wcslen( expect ), MAX_PATH, L"\\Packages\\Wine.DataTest_8wekyb3d8bbwe\\%ls", folders[i] );
+            ok( !wcsicmp( WindowsGetStringRawBuffer( path, NULL ), expect ), "got %s, expected %s.\n",
+                debugstr_w( WindowsGetStringRawBuffer( path, NULL ) ), debugstr_w( expect ) );
+            ok( GetFileAttributesW( expect ) & FILE_ATTRIBUTE_DIRECTORY, "%s is not a directory.\n", debugstr_w( expect ) );
+            WindowsDeleteString( path );
+            IStorageItem_Release( item );
+            IStorageFolder_Release( folder );
+        }
+    }
+
     hr = IApplicationData_add_DataChanged( data, (ITypedEventHandler_ApplicationData_IInspectable *)&data_handler, &token );
     ok( hr == S_OK && token.value, "got hr %#lx.\n", hr );
     hr = IApplicationData_SignalDataChanged( data );
