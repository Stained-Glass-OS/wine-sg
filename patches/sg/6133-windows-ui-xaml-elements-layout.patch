+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Every element of ours is a FrameworkElement (struct uielem).  Layout is the documented two-pass
+ * model: Measure gives an element the space available and it reports the size it wants
+ * (DesiredSize, its margin included); Arrange gives it its final rectangle in its parent and it
+ * takes a RenderSize there.  Width/Height, Min/Max, Margin and the alignments apply around the
+ * element's own MeasureOverride/ArrangeOverride -- ours (elem_ops), or an application's when it
+ * derives the class (it overrides IFrameworkElementOverrides on its outer object).
+ */
+
+#include <stdlib.h>
+#include <math.h>
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* ---- properties ---- */
+
+static struct xaml_property *prop_visibility, *prop_opacity, *prop_is_hit_test_visible, *prop_allow_drop,
+                            *prop_use_layout_rounding;
+static struct xaml_property *prop_width, *prop_height, *prop_min_width, *prop_min_height, *prop_max_width,
+                            *prop_max_height, *prop_halign, *prop_valign, *prop_margin, *prop_name, *prop_tag,
+                            *prop_data_context, *prop_language, *prop_flow_direction, *prop_style,
+                            *prop_actual_width, *prop_actual_height, *prop_requested_theme;
+
+static struct uielem *elem_from_dobj( struct dobj *obj )
+{
+    return CONTAINING_RECORD( obj, struct uielem, d );
+}
+
+/* the layout properties are kept in the element too */
+static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct uielem *elem = elem_from_dobj( obj );
+
+    if (prop == prop_width) elem->width = xunbox_double( new_value, NAN );
+    else if (prop == prop_height) elem->height = xunbox_double( new_value, NAN );
+    else if (prop == prop_min_width) elem->min_width = xunbox_double( new_value, 0 );
+    else if (prop == prop_min_height) elem->min_height = xunbox_double( new_value, 0 );
+    else if (prop == prop_max_width) elem->max_width = xunbox_double( new_value, INFINITY );
+    else if (prop == prop_max_height) elem->max_height = xunbox_double( new_value, INFINITY );
+    else if (prop == prop_halign) elem->halign = xunbox_enum( new_value, &IID_IReference_HorizontalAlignment, XALIGN_STRETCH );
+    else if (prop == prop_valign) elem->valign = xunbox_enum( new_value, &IID_IReference_VerticalAlignment, XALIGN_STRETCH );
+    else if (prop == prop_visibility) elem->visibility = xunbox_enum( new_value, &IID_IReference_Visibility, XVISIBLE );
+    else if (prop == prop_margin)
+    {
+        struct xthickness zero = { 0 };
+        if (!xunbox_ref( new_value, &IID_IReference_Thickness, &elem->margin, sizeof(elem->margin) )) elem->margin = zero;
+    }
+    uielem_invalidate_measure( elem );
+}
+
+static BOOL WINAPI init_elements( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR ui[] = L"Windows.UI.Xaml.UIElement", fe[] = L"Windows.UI.Xaml.FrameworkElement";
+    struct xthickness zero = { 0 };
+    INT32 stretch = XALIGN_STRETCH, visible = XVISIBLE, zero_enum = 0;
+
+    prop_visibility = xaml_property_register( ui, L"Visibility", L"Windows.UI.Xaml.Visibility",
+            xbox_ref( &IID_IReference_Visibility, &visible, sizeof(visible) ), FALSE, layout_changed );
+    prop_opacity = xaml_property_register( ui, L"Opacity", L"Double", xbox_double( 1.0 ), FALSE, NULL );
+    prop_is_hit_test_visible = xaml_property_register( ui, L"IsHitTestVisible", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
+    prop_allow_drop = xaml_property_register( ui, L"AllowDrop", L"Boolean", xbox_boolean( FALSE ), FALSE, NULL );
+    prop_use_layout_rounding = xaml_property_register( ui, L"UseLayoutRounding", L"Boolean", xbox_boolean( TRUE ), FALSE, NULL );
+
+    prop_width = xaml_property_register( fe, L"Width", L"Double", xbox_double( NAN ), FALSE, layout_changed );
+    prop_height = xaml_property_register( fe, L"Height", L"Double", xbox_double( NAN ), FALSE, layout_changed );
+    prop_min_width = xaml_property_register( fe, L"MinWidth", L"Double", xbox_double( 0 ), FALSE, layout_changed );
+    prop_min_height = xaml_property_register( fe, L"MinHeight", L"Double", xbox_double( 0 ), FALSE, layout_changed );
+    prop_max_width = xaml_property_register( fe, L"MaxWidth", L"Double", xbox_double( INFINITY ), FALSE, layout_changed );
+    prop_max_height = xaml_property_register( fe, L"MaxHeight", L"Double", xbox_double( INFINITY ), FALSE, layout_changed );
+    prop_halign = xaml_property_register( fe, L"HorizontalAlignment", L"Windows.UI.Xaml.HorizontalAlignment",
+            xbox_ref( &IID_IReference_HorizontalAlignment, &stretch, sizeof(stretch) ), FALSE, layout_changed );
+    prop_valign = xaml_property_register( fe, L"VerticalAlignment", L"Windows.UI.Xaml.VerticalAlignment",
+            xbox_ref( &IID_IReference_VerticalAlignment, &stretch, sizeof(stretch) ), FALSE, layout_changed );
+    prop_margin = xaml_property_register( fe, L"Margin", L"Windows.UI.Xaml.Thickness",
+            xbox_ref( &IID_IReference_Thickness, &zero, sizeof(zero) ), FALSE, layout_changed );
+    prop_name = xaml_property_register( fe, L"Name", L"String", xbox_string( L"" ), FALSE, NULL );
+    prop_tag = xaml_property_register( fe, L"Tag", L"Object", NULL, FALSE, NULL );
+    prop_data_context = xaml_property_register( fe, L"DataContext", L"Object", NULL, FALSE, NULL );
+    prop_language = xaml_property_register( fe, L"Language", L"String", xbox_string( L"en-US" ), FALSE, NULL );
+    prop_flow_direction = xaml_property_register( fe, L"FlowDirection", L"Windows.UI.Xaml.FlowDirection",
+            NULL, FALSE, layout_changed );
+    prop_style = xaml_property_register( fe, L"Style", L"Windows.UI.Xaml.Style", NULL, FALSE, NULL );
+    prop_actual_width = xaml_property_register( fe, L"ActualWidth", L"Double", xbox_double( 0 ), FALSE, NULL );
+    prop_actual_height = xaml_property_register( fe, L"ActualHeight", L"Double", xbox_double( 0 ), FALSE, NULL );
+    prop_requested_theme = xaml_property_register( fe, L"RequestedTheme", L"Windows.UI.Xaml.ElementTheme",
+            NULL, FALSE, NULL );
+    (void)zero_enum;
+    return TRUE;
+}
+
+void xaml_elements_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_elements, NULL, NULL );
+}
+
+/* ---- the element ---- */
+
+static struct uielem *elem_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct uielem, d.obj );
+}
+
+IInspectable *uielem_iface( struct uielem *elem )
+{
+    return (IInspectable *)&elem->IUIElement_iface;
+}
+
+static HRESULT get_prop( struct uielem *elem, struct xaml_property *prop, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    return dobj_get_value( &elem->d, prop, value );
+}
+
+static HRESULT set_prop( struct uielem *elem, struct xaml_property *prop, IInspectable *value )
+{
+    HRESULT hr;
+
+    if (!value) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &elem->d, prop, value );
+    IInspectable_Release( value );
+    return hr;
+}
+
+static HRESULT get_double( struct uielem *elem, struct xaml_property *prop, DOUBLE *value, DOUBLE def )
+{
+    IInspectable *box;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = dobj_get_value( &elem->d, prop, &box ))) return hr;
+    *value = xunbox_double( box, def );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+static HRESULT get_boolean( struct uielem *elem, struct xaml_property *prop, boolean *value, boolean def )
+{
+    IInspectable *box;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = dobj_get_value( &elem->d, prop, &box ))) return hr;
+    *value = xunbox_boolean( box, def );
+    if (box) IInspectable_Release( box );
+    return S_OK;
+}
+
+/* ---- layout ---- */
+
+static void min_max( DOUBLE value, DOUBLE min, DOUBLE max, DOUBLE *lo, DOUBLE *hi )
+{
+    /* an explicit size wins over Max, Min wins over both */
+    *hi = isnan( value ) ? max : fmin( value, max );
+    *hi = fmax( *hi, min );
+    *lo = isnan( value ) ? 0 : fmin( value, *hi );
+    *lo = fmax( *lo, min );
+}
+
+static BOOL is_aggregated( struct uielem *elem )
+{
+    return elem->d.obj.outer != (IUnknown *)&elem->d.obj.IInspectable_inner;
+}
+
+typedef HRESULT (WINAPI *measure_override_fn)( void *iface, struct xsize available, struct xsize *result );
+typedef HRESULT (WINAPI *arrange_override_fn)( void *iface, struct xsize final, struct xsize *result );
+
+/* MeasureOverride: the application's when it overrides it, else ours */
+static struct xsize call_measure_override( struct uielem *elem, struct xsize available )
+{
+    struct xsize desired = { 0, 0 };
+    struct xiface *overrides;
+
+    if (is_aggregated( elem ) &&
+        SUCCEEDED(IUnknown_QueryInterface( elem->d.obj.outer, &IID_IFrameworkElementOverrides, (void **)&overrides )))
+    {
+        if (overrides != &elem->IFrameworkElementOverrides_iface)
+        {
+            ((measure_override_fn)((void **)overrides->vtbl)[IFrameworkElementOverrides_MeasureOverride])( overrides, available, &desired );
+            IUnknown_Release( (IUnknown *)overrides );
+            return desired;
+        }
+        IUnknown_Release( (IUnknown *)overrides );
+    }
+    if (elem->ops && elem->ops->measure) elem->ops->measure( elem, available, &desired );
+    return desired;
+}
+
+static struct xsize call_arrange_override( struct uielem *elem, struct xsize final )
+{
+    struct xsize used = final;
+    struct xiface *overrides;
+
+    if (is_aggregated( elem ) &&
+        SUCCEEDED(IUnknown_QueryInterface( elem->d.obj.outer, &IID_IFrameworkElementOverrides, (void **)&overrides )))
+    {
+        if (overrides != &elem->IFrameworkElementOverrides_iface)
+        {
+            ((arrange_override_fn)((void **)overrides->vtbl)[IFrameworkElementOverrides_ArrangeOverride])( overrides, final, &used );
+            IUnknown_Release( (IUnknown *)overrides );
+            return used;
+        }
+        IUnknown_Release( (IUnknown *)overrides );
+    }
+    if (elem->ops && elem->ops->arrange) elem->ops->arrange( elem, final, &used );
+    return used;
+}
+
+void uielem_measure( struct uielem *elem, struct xsize available )
+{
+    DOUBLE min_w, max_w, min_h, max_h, w, h;
+    struct xsize inner, desired;
+
+    if (elem->measure_valid && elem->measured && elem->constraint.width == available.width &&
+        elem->constraint.height == available.height) return;
+    elem->constraint = available;
+    elem->measured = TRUE;
+    elem->measure_valid = TRUE;
+    elem->arrange_valid = FALSE;
+    if (elem->visibility == XCOLLAPSED)
+    {
+        elem->desired.width = elem->desired.height = 0;
+        return;
+    }
+    min_max( elem->width, elem->min_width, elem->max_width, &min_w, &max_w );
+    min_max( elem->height, elem->min_height, elem->max_height, &min_h, &max_h );
+    w = fmax( available.width - elem->margin.left - elem->margin.right, 0 );
+    h = fmax( available.height - elem->margin.top - elem->margin.bottom, 0 );
+    inner.width = fmax( min_w, fmin( w, max_w ) );
+    inner.height = fmax( min_h, fmin( h, max_h ) );
+    desired = call_measure_override( elem, inner );
+    desired.width = fmin( fmax( desired.width, min_w ), max_w );
+    desired.height = fmin( fmax( desired.height, min_h ), max_h );
+    elem->unclipped = desired;
+    w = desired.width + elem->margin.left + elem->margin.right;
+    h = desired.height + elem->margin.top + elem->margin.bottom;
+#ifndef SG_MUTANT_LAYOUT_NO_MARGIN
+    elem->desired.width = fmax( 0, fmin( w, available.width ) );
+    elem->desired.height = fmax( 0, fmin( h, available.height ) );
+#else
+    elem->desired = desired;
+#endif
+    TRACE( "%p: available %.1fx%.1f -> desired %.1fx%.1f\n", elem, available.width, available.height,
+           elem->desired.width, elem->desired.height );
+}
+
+static FLOAT align_offset( INT32 align, FLOAT slot, FLOAT size )
+{
+    if (size >= slot) return 0;
+    switch (align)
+    {
+    case XALIGN_LEFT: return 0;
+    case XALIGN_RIGHT: return slot - size;
+    default: return (slot - size) / 2;   /* Center, and Stretch when the element is smaller */
+    }
+}
+
+void uielem_arrange( struct uielem *elem, struct xrect final )
+{
+    DOUBLE min_w, max_w, min_h, max_h;
+    struct xsize slot, size, used, old_render = elem->render;
+
+    if (elem->arrange_valid && elem->final.x == final.x && elem->final.y == final.y &&
+        elem->final.width == final.width && elem->final.height == final.height) return;
+    if (!elem->measure_valid || !elem->measured)
+    {
+        struct xsize available = { final.width, final.height };
+        if (elem->measured && !elem->measure_valid) available = elem->constraint;
+        elem->measure_valid = FALSE;
+        uielem_measure( elem, available );
+    }
+    elem->final = final;
+    elem->arrange_valid = TRUE;
+    if (elem->visibility == XCOLLAPSED)
+    {
+        elem->render.width = elem->render.height = 0;
+        return;
+    }
+    slot.width = fmax( final.width - elem->margin.left - elem->margin.right, 0 );
+    slot.height = fmax( final.height - elem->margin.top - elem->margin.bottom, 0 );
+    size = slot;
+    if (elem->halign != XALIGN_STRETCH) size.width = elem->unclipped.width;
+    if (elem->valign != XALIGN_STRETCH) size.height = elem->unclipped.height;
+    min_max( elem->width, elem->min_width, elem->max_width, &min_w, &max_w );
+    min_max( elem->height, elem->min_height, elem->max_height, &min_h, &max_h );
+    size.width = fmin( fmax( size.width, min_w ), max_w );
+    size.height = fmin( fmax( size.height, min_h ), max_h );
+    used = call_arrange_override( elem, size );
+    elem->render.width = fmin( used.width, max_w );
+    elem->render.height = fmin( used.height, max_h );
+    elem->offset.x = final.x + elem->margin.left + align_offset( elem->halign, slot.width, elem->render.width );
+    elem->offset.y = final.y + elem->margin.top + align_offset( elem->valign, slot.height, elem->render.height );
+    TRACE( "%p: final %.1f,%.1f %.1fx%.1f -> render %.1fx%.1f at %.1f,%.1f\n", elem, final.x, final.y,
+           final.width, final.height, elem->render.width, elem->render.height, elem->offset.x, elem->offset.y );
+    if (old_render.width != elem->render.width || old_render.height != elem->render.height)
+    {
+        IInspectable *box;
+        if ((box = xbox_double( elem->render.width ))) set_prop( elem, prop_actual_width, box );
+        if ((box = xbox_double( elem->render.height ))) set_prop( elem, prop_actual_height, box );
+    }
+}
+
+void uielem_invalidate_measure( struct uielem *elem )
+{
+    for (; elem; elem = elem->parent)
+    {
+        if (!elem->measure_valid && !elem->arrange_valid) break;
+        elem->measure_valid = FALSE;
+        elem->arrange_valid = FALSE;
+    }
+}
+
+void uielem_invalidate_arrange( struct uielem *elem )
+{
+    for (; elem; elem = elem->parent)
+    {
+        if (!elem->arrange_valid) break;
+        elem->arrange_valid = FALSE;
+    }
+}
+
+/* the layout of the tree the element is in, from its root, with the root's last sizes */
+void uielem_update_layout( struct uielem *elem )
+{
+    struct uielem *root = elem;
+
+    while (root->parent) root = root->parent;
+    if (!root->measured) return;
+    if (!root->measure_valid) uielem_measure( root, root->constraint );
+    if (!root->arrange_valid) uielem_arrange( root, root->final );
+}
+
+void uielem_add_child( struct uielem *parent, struct uielem *child )
+{
+    if (child->parent) uielem_remove_child( child->parent, child );
+    child->parent = parent;
+    list_add_tail( &parent->children, &child->entry );
+    IUnknown_AddRef( child->d.obj.outer );
+    child->measure_valid = child->arrange_valid = FALSE;
+    uielem_invalidate_measure( parent );
+}
+
+void uielem_remove_child( struct uielem *parent, struct uielem *child )
+{
+    if (child->parent != parent) return;
+    list_remove( &child->entry );
+    child->parent = NULL;
+    uielem_invalidate_measure( parent );
+    IUnknown_Release( child->d.obj.outer );
+}
+
+/* ---- IUIElement ---- */
+
+static HRESULT WINAPI uielement_get_DesiredSize( struct xiface *iface, struct xsize *value )
+{
+    if (!value) return E_POINTER;
+    *value = elem_from_iface( iface )->desired;
+    return S_OK;
+}
+
+static HRESULT WINAPI uielement_get_AllowDrop( struct xiface *iface, boolean *value )
+{
+    return get_boolean( elem_from_iface( iface ), prop_allow_drop, value, FALSE );
+}
+
+static HRESULT WINAPI uielement_put_AllowDrop( struct xiface *iface, boolean value )
+{
+    return set_prop( elem_from_iface( iface ), prop_allow_drop, xbox_boolean( value ) );
+}
+
+static HRESULT WINAPI uielement_get_Opacity( struct xiface *iface, DOUBLE *value )
+{
+    return get_double( elem_from_iface( iface ), prop_opacity, value, 1.0 );
+}
+
+static HRESULT WINAPI uielement_put_Opacity( struct xiface *iface, DOUBLE value )
+{
+    return set_prop( elem_from_iface( iface ), prop_opacity, xbox_double( value ) );
+}
+
+static HRESULT WINAPI uielement_get_IsHitTestVisible( struct xiface *iface, boolean *value )
+{
+    return get_boolean( elem_from_iface( iface ), prop_is_hit_test_visible, value, TRUE );
+}
+
+static HRESULT WINAPI uielement_put_IsHitTestVisible( struct xiface *iface, boolean value )
+{
+    return set_prop( elem_from_iface( iface ), prop_is_hit_test_visible, xbox_boolean( value ) );
+}
+
