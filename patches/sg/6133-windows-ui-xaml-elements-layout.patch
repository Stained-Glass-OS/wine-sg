+/* the element of that name in the tree under this one */
+static struct uielem *find_name( struct uielem *elem, const WCHAR *name )
+{
+    struct uielem *child, *found;
+    IInspectable *box = NULL;
+    WCHAR *str;
+    BOOL match = FALSE;
+
+    if (SUCCEEDED(dobj_get_value( &elem->d, prop_name, &box )) && box)
+    {
+        if ((str = xunbox_string( box ))) match = !wcscmp( str, name );
+        free( str );
+        IInspectable_Release( box );
+    }
+    if (match) return elem;
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry )
+        if ((found = find_name( child, name ))) return found;
+    return NULL;
+}
+
+static HRESULT WINAPI fe_FindName( struct xiface *iface, HSTRING name, IInspectable **result )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( name, NULL );
+    struct uielem *found;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!str || !*str) return S_OK;
+    if ((found = find_name( elem_from_iface( iface ), str )))
+        IUnknown_QueryInterface( found->d.obj.outer, &IID_IInspectable, (void **)result );
+    return S_OK;
+}
