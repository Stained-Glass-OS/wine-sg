+static HRESULT get_string( struct uielem *elem, struct xaml_property *prop, HSTRING *value )
+{
+    IInspectable *box;
+    WCHAR *str = NULL;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    if (FAILED(hr = dobj_get_value( &elem->d, prop, &box ))) return hr;
+    if (box)
+    {
+        str = xunbox_string( box );
+        IInspectable_Release( box );
+    }
+    hr = WindowsCreateString( str, str ? wcslen( str ) : 0, value );
+    free( str );
+    return hr;
+}
+
+static HRESULT put_string( struct uielem *elem, struct xaml_property *prop, HSTRING value )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( value, NULL );
+    return set_prop( elem, prop, xbox_string( str ? str : L"" ) );
+}
