+/* an event nothing raises yet: its handler is accepted, with a token */
+HRESULT xaml_event_accept( const char *name, void *iface, void *token )
+{
+    static LONG64 next_token;
+
+    TRACE( "%p: %s: handler accepted, the event is not raised yet\n", iface, name );
+    if (!token) return E_POINTER;
+    *(INT64 *)token = InterlockedIncrement64( &next_token );
+    return S_OK;
+}
