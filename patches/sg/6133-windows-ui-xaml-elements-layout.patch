+
+/*
+ * Property values are boxed: numbers, booleans and strings as Windows.Foundation.PropertyValue
+ * makes them (wintypes), enums and XAML structs as IReference<T> of our own, the way programs
+ * unbox them (C++/WinRT's unbox_value<T> asks for IReference<T>).  The IIDs of IReference<T> are
+ * those of their type signatures (the WinRT parameterized-interface rule).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+#include "roapi.h"
+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+const GUID IID_IReference_Thickness = { 0xa19f7ba8, 0xd8cd, 0x5df2, { 0xab, 0x44, 0xfe, 0xfd, 0x26, 0x64, 0x44, 0x84 } };
+const GUID IID_IReference_Visibility = { 0xc19bf229, 0x815a, 0x5cbd, { 0xa5, 0x06, 0xe3, 0x1f, 0x9b, 0x67, 0xe3, 0x17 } };
+const GUID IID_IReference_HorizontalAlignment = { 0xaed792e1, 0x3c65, 0x50d8, { 0xba, 0x76, 0x01, 0xc8, 0xb6, 0xb6, 0x5a, 0x33 } };
+const GUID IID_IReference_VerticalAlignment = { 0x3e95e30b, 0x557a, 0x5bf3, { 0xbf, 0x64, 0x23, 0x5a, 0x1a, 0x2c, 0x0c, 0xbf } };
+const GUID IID_IReference_FlowDirection = { 0x72ea6754, 0x2418, 0x5ded, { 0x91, 0x88, 0x86, 0x65, 0xf5, 0x98, 0x7a, 0xd2 } };
+const GUID IID_IReference_ElementTheme = { 0x0e1d2a39, 0xfeb3, 0x5913, { 0x8a, 0x73, 0x21, 0xab, 0x23, 0xab, 0x9d, 0x48 } };
+static const GUID IID_IPropertyValue_box = { 0x4bd682dd, 0x7554, 0x40e9, { 0x9a, 0x9b, 0x82, 0x65, 0x4e, 0xde, 0x7e, 0x62 } };
+static const GUID IID_IPropertyValueStatics_box = { 0x629bdbc8, 0xd932, 0x4ff4, { 0x96, 0xb9, 0x8d, 0x96, 0xc5, 0xc1, 0xe8, 0x58 } };
+
+static IPropertyValueStatics *statics;
+static INIT_ONCE statics_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI init_statics( INIT_ONCE *once, void *param, void **context )
+{
+    static const WCHAR name[] = L"Windows.Foundation.PropertyValue";
+    HSTRING str;
+
+    if (FAILED(WindowsCreateString( name, wcslen( name ), &str ))) return TRUE;
+    if (FAILED(RoGetActivationFactory( str, &IID_IPropertyValueStatics_box, (void **)&statics )))
+        ERR( "no Windows.Foundation.PropertyValue\n" );
+    WindowsDeleteString( str );
+    return TRUE;
+}
+
+static IPropertyValueStatics *pv_statics(void)
+{
+    InitOnceExecuteOnce( &statics_once, init_statics, NULL, NULL );
+    return statics;
+}
+
+IInspectable *xbox_double( DOUBLE value )
+{
+    IInspectable *box = NULL;
+    if (pv_statics()) IPropertyValueStatics_CreateDouble( pv_statics(), value, &box );
+    return box;
+}
+
+IInspectable *xbox_boolean( boolean value )
+{
+    IInspectable *box = NULL;
+    if (pv_statics()) IPropertyValueStatics_CreateBoolean( pv_statics(), value, &box );
+    return box;
+}
+
+IInspectable *xbox_string( const WCHAR *value )
+{
+    IInspectable *box = NULL;
+    HSTRING str;
+
+    if (!pv_statics() || FAILED(WindowsCreateString( value, wcslen( value ), &str ))) return NULL;
+    IPropertyValueStatics_CreateString( pv_statics(), str, &box );
+    WindowsDeleteString( str );
+    return box;
+}
+
+/* ---- IReference<T> of an enum or a struct ---- */
+
+struct ref_box
+{
+    IInspectable IInspectable_iface;
+    LONG ref;
+    const GUID *iid;
+    size_t size;
+    BYTE value[64];
+};
+
+static struct ref_box *impl_from_ref( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct ref_box, IInspectable_iface );
+}
+
+static HRESULT WINAPI ref_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct ref_box *box = impl_from_ref( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, box->iid ))
+    {
+        *out = iface;
+        IInspectable_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ref_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_ref( iface )->ref );
+}
+
+static ULONG WINAPI ref_Release( IInspectable *iface )
+{
+    struct ref_box *box = impl_from_ref( iface );
+    ULONG ref = InterlockedDecrement( &box->ref );
+    if (!ref) free( box );
+    return ref;
+}
+
+static HRESULT WINAPI ref_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    struct ref_box *box = impl_from_ref( iface );
+
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = *box->iid;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI ref_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    return xaml_hstring( L"Windows.Foundation.IReference`1", name );
+}
+
+static HRESULT WINAPI ref_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+/* IReference<T>.Value: the value, whatever T is */
+static HRESULT WINAPI ref_get_Value( IInspectable *iface, void *value )
+{
+    struct ref_box *box = impl_from_ref( iface );
+
+    if (!value) return E_POINTER;
+    memcpy( value, box->value, box->size );
+    return S_OK;
+}
+
+static const void *ref_vtbl[] =
+{
+    ref_QueryInterface, ref_AddRef, ref_Release, ref_GetIids, ref_GetRuntimeClassName, ref_GetTrustLevel,
+    ref_get_Value,
+};
+
+IInspectable *xbox_ref( const GUID *iid, const void *value, size_t size )
+{
+    struct ref_box *box;
+
+    if (size > sizeof(box->value) || !(box = calloc( 1, sizeof(*box) ))) return NULL;
+    box->IInspectable_iface.lpVtbl = (void *)ref_vtbl;
+    box->ref = 1;
+    box->iid = iid;
+    box->size = size;
+    memcpy( box->value, value, size );
+    return &box->IInspectable_iface;
+}
+
+BOOL xunbox_ref( IInspectable *value, const GUID *iid, void *out, size_t size )
+{
+    IInspectable *ref;
+    HRESULT hr;
+
+    if (!value) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( value, iid, (void **)&ref ))) return FALSE;
+    hr = ((HRESULT (WINAPI *)( IInspectable *, void * ))((void **)ref->lpVtbl)[6])( ref, out );
+    IInspectable_Release( ref );
+    (void)size;
+    return SUCCEEDED(hr);
+}
+
+/* ---- unboxing ---- */
+
+DOUBLE xunbox_double( IInspectable *value, DOUBLE def )
+{
+    IPropertyValue *pv;
+    PropertyType type;
+    DOUBLE ret = def;
+
+    if (!value || FAILED(IInspectable_QueryInterface( value, &IID_IPropertyValue_box, (void **)&pv ))) return def;
+    if (SUCCEEDED(IPropertyValue_get_Type( pv, &type )))
+    {
+        switch (type)
+        {
+        case PropertyType_Double: IPropertyValue_GetDouble( pv, &ret ); break;
+        case PropertyType_Single: { FLOAT f; if (SUCCEEDED(IPropertyValue_GetSingle( pv, &f ))) ret = f; break; }
+        case PropertyType_Int32: { INT32 i; if (SUCCEEDED(IPropertyValue_GetInt32( pv, &i ))) ret = i; break; }
+        case PropertyType_UInt32: { UINT32 i; if (SUCCEEDED(IPropertyValue_GetUInt32( pv, &i ))) ret = i; break; }
+        case PropertyType_Int64: { INT64 i; if (SUCCEEDED(IPropertyValue_GetInt64( pv, &i ))) ret = i; break; }
+        default: break;
+        }
+    }
+    IPropertyValue_Release( pv );
+    return ret;
+}
+
+boolean xunbox_boolean( IInspectable *value, boolean def )
+{
+    IPropertyValue *pv;
+    boolean ret = def;
+
+    if (!value || FAILED(IInspectable_QueryInterface( value, &IID_IPropertyValue_box, (void **)&pv ))) return def;
+    if (FAILED(IPropertyValue_GetBoolean( pv, &ret ))) ret = def;
+    IPropertyValue_Release( pv );
+    return ret;
+}
+
+INT32 xunbox_enum( IInspectable *value, const GUID *iid, INT32 def )
+{
+    IPropertyValue *pv;
+    INT32 ret = def;
+
+    if (!value) return def;
+    if (iid && xunbox_ref( value, iid, &ret, sizeof(ret) )) return ret;
+    if (FAILED(IInspectable_QueryInterface( value, &IID_IPropertyValue_box, (void **)&pv ))) return def;
+    if (FAILED(IPropertyValue_GetInt32( pv, &ret )))
+    {
+        UINT32 u;
+        ret = SUCCEEDED(IPropertyValue_GetUInt32( pv, &u )) ? (INT32)u : def;
+    }
+    IPropertyValue_Release( pv );
+    return ret;
+}
+
+WCHAR *xunbox_string( IInspectable *value )
+{
+    IPropertyValue *pv;
+    HSTRING str = NULL;
+    WCHAR *ret = NULL;
+
+    if (!value || FAILED(IInspectable_QueryInterface( value, &IID_IPropertyValue_box, (void **)&pv ))) return NULL;
+    if (SUCCEEDED(IPropertyValue_GetString( pv, &str )))
+    {
+        const WCHAR *buf = WindowsGetStringRawBuffer( str, NULL );
+        ret = wcsdup( buf ? buf : L"" );
+        WindowsDeleteString( str );
+    }
+    IPropertyValue_Release( pv );
+    return ret;
+}
