diff --git a/dlls/windows.ui.xaml/make_ifaces.py b/dlls/windows.ui.xaml/make_ifaces.py
new file mode 100644
index 0000000..1995467
--- /dev/null
+++ b/dlls/windows.ui.xaml/make_ifaces.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+# Stained Glass OS: generates ifaces.h and ifaces.c of windows.ui.xaml from ifaces.txt -- the
+# interfaces' identity (IIDs; per vtable slot the method's name and its arguments' stack size on
+# i386), per windows-rs 0.30.0 (MIT OR Apache-2.0).  For every interface: its IID, an enum of its
+# slots, and a stub per method (E_NOTIMPL, with a FIXME naming it) so that a class's vtable is
+#   static const void *vtbl[] = { IFoo_STUBS, [IFoo_Bar] = our_bar, ... };
+# with every slot it does not implement yet answering correctly.
+#   make_ifaces.py ifaces.txt ifaces.h ifaces.c
+import sys, re
+
+src, out_h, out_c = sys.argv[1:4]
+ifaces = []
+for line in open(src):
+    line = line.rstrip('\n')
+    if not line or line.startswith('#'): continue
+    if not line.startswith(' '):
+        name, iid, n = line.split()
+        ifaces.append((name, iid, int(n), []))
+    else:
+        f = line.split()
+        ifaces[-1][3].append((int(f[0]), f[1], int(f[2]), f[3] if len(f) > 3 else '-'))
+
+def guid_args(iid):
+    p = iid.split('-')
+    b = p[3] + p[4]
+    return '0x%s, 0x%s, 0x%s, %s' % (p[0], p[1], p[2], ', '.join('0x' + b[i:i+2] for i in range(0, 16, 2)))
+
+hdr = ['/* generated by make_ifaces.py from ifaces.txt -- do not edit */', '',
+       '#ifndef __WINE_WINDOWS_UI_XAML_IFACES_H', '#define __WINE_WINDOWS_UI_XAML_IFACES_H', '',
+       '#ifdef XAML_IFACES_DEFINE',
+       '#define XAML_IID(name, l, w1, w2, b1, b2, b3, b4, b5, b6, b7, b8) \\',
+       '    const GUID IID_##name = { l, w1, w2, { b1, b2, b3, b4, b5, b6, b7, b8 } }',
+       '#else',
+       '#define XAML_IID(name, l, w1, w2, b1, b2, b3, b4, b5, b6, b7, b8) extern const GUID IID_##name',
+       '#endif', '']
+c = ['/* generated by make_ifaces.py from ifaces.txt -- do not edit */', '',
+     '#define XAML_IFACES_DEFINE', '#include "private.h"', '',
+     'WINE_DEFAULT_DEBUG_CHANNEL(xaml);', '',
+     '/* an event nothing raises yet: its handler is accepted, with a token */',
+     'HRESULT xaml_event_accept( const char *name, void *iface, void *token )',
+     '{',
+     '    static LONG64 next_token;',
+     '',
+     '    TRACE( "%p: %s: handler accepted, the event is not raised yet\\n", iface, name );',
+     '    if (!token) return E_POINTER;',
+     '    *(INT64 *)token = InterlockedIncrement64( &next_token );',
+     '    return S_OK;',
+     '}', '']
+for name, iid, n, methods in ifaces:
+    hdr.append('XAML_IID(%s, %s);' % (name, guid_args(iid)))
+    seen = set()
+    enum = []
+    for slot, meth, stack, types in methods:
+        e = '%s_%s' % (name, meth)
+        if e in seen: e = '%s_%d' % (e, slot)
+        seen.add(e)
+        enum.append('%s = %d' % (e, slot))
+    enum.append('%s_slots = %d' % (name, n))
+    hdr.append('enum { %s };' % ', '.join(enum))
+    stubs = []
+    names = [m[1] for m in methods]
+    for i, (slot, meth, stack, types) in enumerate(methods):
+        args = ', '.join(['void *iface'] + ['ULONG_PTR a%d' % i for i in range(1, stack // 4)])
+        fn = 'stub_%s_%d' % (name, slot)
+        # an event's add and remove: accepted (nothing raises it yet), so programs that register
+        # handlers keep going
+        is_add = types == 'ptr,ptr' and i + 1 < len(methods) and methods[i + 1][1] == 'Remove' + meth and \
+                 methods[i + 1][3] == 'type:EventRegistrationToken'
+        is_remove = meth.startswith('Remove') and types == 'type:EventRegistrationToken' and i > 0 and \
+                    names[i - 1] == meth[6:]
+        hdr.append('HRESULT WINAPI %s( %s );' % (fn, args))
+        c.append('HRESULT WINAPI %s( %s )' % (fn, args))
+        c.append('{')
+        if is_add:
+            c.append('    return xaml_event_accept( "%s.%s", iface, (void *)(ULONG_PTR)a2 );' % (name, meth))
+        elif is_remove:
+            c.append('    return S_OK;')
+        else:
+            c.append('    FIXME( "%%p: %s.%s not implemented\\n", iface );' % (name, meth))
+            c.append('    return E_NOTIMPL;')
+        c.append('}')
+        c.append('')
+        stubs.append(fn)
+    hdr.append('#define %s_STUBS XIFACE_COMMON%s' % (name, ''.join(', ' + s for s in stubs)))
+    hdr.append('#define %s_FSTUBS XFIFACE_COMMON%s' % (name, ''.join(', ' + s for s in stubs)))
+    hdr.append('')
+hdr.append('HRESULT xaml_event_accept( const char *name, void *iface, void *token );')
+hdr.append('')
+hdr.append('#endif')
+open(out_h, 'w').write('\n'.join(hdr) + '\n')
+open(out_c, 'w').write('\n'.join(c))
