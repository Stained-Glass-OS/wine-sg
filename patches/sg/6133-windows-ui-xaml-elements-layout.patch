+WCHAR *xunbox_string( IInspectable *value );
+
+/* ---- elements (element.c) ---- */
+
+#include "ifaces.h"
+
+struct uielem;
+
+/* what our classes do in place of the overridable methods */
+struct elem_ops
+{
+    void (*measure)( struct uielem *elem, struct xsize available, struct xsize *desired );   /* MeasureOverride */
+    void (*arrange)( struct uielem *elem, struct xsize final, struct xsize *used );        /* ArrangeOverride */
+};
+
+/* a UIElement (and FrameworkElement: every element of ours is one) */
+struct uielem
+{
+    struct dobj d;
+    struct xiface IUIElement_iface, IUIElement2_iface, IUIElement3_iface, IUIElement4_iface, IUIElement5_iface,
+                  IUIElement7_iface, IUIElement8_iface, IUIElement9_iface, IUIElement10_iface,
+                  IUIElementOverrides_iface, IUIElementOverrides7_iface, IUIElementOverrides8_iface,
+                  IUIElementOverrides9_iface;
+    struct xiface IFrameworkElement_iface, IFrameworkElement2_iface, IFrameworkElement3_iface,
+                  IFrameworkElement4_iface, IFrameworkElement6_iface, IFrameworkElement7_iface,
+                  IFrameworkElementOverrides_iface, IFrameworkElementOverrides2_iface,
+                  IFrameworkElementProtected7_iface;
+    const struct elem_ops *ops;
+    struct uielem *parent;          /* visual parent (no reference) */
+    struct list children;           /* visual children: struct uielem.entry */
+    struct list entry;
+    /* the layout properties, kept by their change functions */
+    DOUBLE width, height, min_width, min_height, max_width, max_height;
+    struct xthickness margin;
+    INT32 halign, valign, visibility;
+    /* layout */
+    BOOL measure_valid, arrange_valid, measured;
+    struct xsize constraint;        /* of the last Measure */
+    struct xsize desired;           /* DesiredSize, margin included */
+    struct xsize unclipped;         /* MeasureOverride's result clamped by min/max, margin excluded */
+    struct xrect final;             /* of the last Arrange */
+    struct xsize render;            /* RenderSize */
+    struct xpoint offset;           /* in the parent */
+    struct handler_list loaded, unloaded, size_changed, layout_updated;
+};
+
+enum { XALIGN_LEFT = 0, XALIGN_CENTER = 1, XALIGN_RIGHT = 2, XALIGN_STRETCH = 3 };   /* Top/Center/Bottom/Stretch */
+enum { XVISIBLE = 0, XCOLLAPSED = 1 };
+
+#define UIELEM_IFACES \
+    { &IID_IFrameworkElement, offsetof(struct uielem, IFrameworkElement_iface) }, \
