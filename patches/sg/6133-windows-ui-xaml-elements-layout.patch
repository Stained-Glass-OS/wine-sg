+    { &IID_IFrameworkElementOverrides2, offsetof(struct uielem, IFrameworkElementOverrides2_iface) }, \
+    { &IID_IFrameworkElementProtected7, offsetof(struct uielem, IFrameworkElementProtected7_iface) }, \
+    { &IID_IUIElement, offsetof(struct uielem, IUIElement_iface) }, \
+    { &IID_IUIElement2, offsetof(struct uielem, IUIElement2_iface) }, \
