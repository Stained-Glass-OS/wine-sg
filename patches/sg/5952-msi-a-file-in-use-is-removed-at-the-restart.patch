From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: a file in use at uninstall is removed at the next restart (5952)

msi: a file in use at uninstall is removed at the next restart

RemoveFiles only logged a file it could not delete, and it then stayed
forever: DYMO Connect's PnP service program was left in Program Files
after every uninstall (qa4 Store walk 2026-10-22), though msiexec said
3010. Windows Installer deletes such a file at the next restart: a file
in use (ERROR_SHARING_VIOLATION, or ERROR_ACCESS_DENIED for a running
program) is now queued with MoveFileEx(MOVEFILE_DELAY_UNTIL_REBOOT) and
the removal asks for a restart (ERROR_SUCCESS_REBOOT_REQUIRED). A folder
of the product that stays because of it is queued after it, and stays if
anything else is in it by then. wineboot carries out the queue.
Gate: test/msirmuse-gate.sh (install, the file held open, uninstall:
3010, file then folder queued; after wineboot both gone); mutant
SG_MUTANT_MSIRMUSE.
---
diff --git a/dlls/msi/files.c b/dlls/msi/files.c
index 0daea89..d8317f4 100644
--- a/dlls/msi/files.c
+++ b/dlls/msi/files.c
@@ -1513,17 +1513,21 @@ done:
     return ret;
 }
 
-static void remove_folder( MSIFOLDER *folder )
+static void remove_folder( MSIPACKAGE *package, MSIFOLDER *folder, BOOL pending )
 {
     FolderList *fl;
 
     LIST_FOR_EACH_ENTRY( fl, &folder->children, FolderList, entry )
     {
-        remove_folder( fl->folder );
+        remove_folder( package, fl->folder, pending );
     }
     if (!folder->persistent && folder->State != FOLDER_STATE_REMOVED)
     {
         if (RemoveDirectoryW( folder->ResolvedTarget )) folder->State = FOLDER_STATE_REMOVED;
+        /* a file in it goes at the next restart: the folder follows it there, after it (the
+           operations run in order), and stays if anything else is in it by then */
+        else if (pending && GetFileAttributesW( folder->ResolvedTarget ) != INVALID_FILE_ATTRIBUTES)
+            msi_move_file( package, folder->ResolvedTarget, NULL, MOVEFILE_DELAY_UNTIL_REBOOT );
     }
 }
 
@@ -1533,6 +1537,7 @@ UINT ACTION_RemoveFiles( MSIPACKAGE *package )
     MSICOMPONENT *comp;
     MSIFILE *file;
     UINT r;
+    BOOL pending = FALSE;
 
     if (package->script == SCRIPT_NONE)
         return msi_schedule_action(package, SCRIPT_INSTALL, L"RemoveFiles");
@@ -1587,7 +1592,20 @@ UINT ACTION_RemoveFiles( MSIPACKAGE *package )
         msi_set_file_attributes( package, file->TargetPath, FILE_ATTRIBUTE_NORMAL );
         if (!msi_delete_file( package, file->TargetPath ))
         {
-            WARN( "failed to delete %s (%lu)\n",  debugstr_w(file->TargetPath), GetLastError() );
+            DWORD gle = GetLastError();
+
+            WARN( "failed to delete %s (%lu)\n",  debugstr_w(file->TargetPath), gle );
+            /* in use (a program still running, a file open without sharing): Windows Installer
+               deletes it at the next restart and the removal asks for one, 3010. Kept, it stayed
+               forever (DYMO Connect's PnP service program, qa4 2026-10-22) */
+#ifndef SG_MUTANT_MSIRMUSE
+            if ((gle == ERROR_SHARING_VIOLATION || gle == ERROR_ACCESS_DENIED) &&
+                msi_move_file( package, file->TargetPath, NULL, MOVEFILE_DELAY_UNTIL_REBOOT ))
+            {
+                package->need_reboot_at_end = 1;
+                pending = TRUE;
+            }
+#endif
         }
         file->state = msifs_missing;
 
@@ -1613,7 +1631,7 @@ UINT ACTION_RemoveFiles( MSIPACKAGE *package )
         else
         {
             MSIFOLDER *folder = msi_get_loaded_folder( package, comp->Directory );
-            if (folder) remove_folder( folder );
+            if (folder) remove_folder( package, folder, pending );
         }
     }
     return ERROR_SUCCESS;
