From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wmphoto: Multi-frame JPEG XR, end of stream, CopyPixels stride.

The decoder exposes each frame of a JPEG XR container, stops at end of
stream, and CopyPixels honours the caller's stride; the class factory
counts LockServer.
---
 dlls/wmphoto/jxrlib.c | 131 ++++++++++++++++++++++++++++++++------------------
 dlls/wmphoto/main.c   |  14 ++++--
 2 files changed, 96 insertions(+), 49 deletions(-)

diff --git a/dlls/wmphoto/jxrlib.c b/dlls/wmphoto/jxrlib.c
index c5ce59b..6d7af5c 100644
--- a/dlls/wmphoto/jxrlib.c
+++ b/dlls/wmphoto/jxrlib.c
@@ -86,9 +86,11 @@ struct wmp_decoder
     struct WMPStream WMPStream_iface;
     PKImageDecode *decoder;
     IStream *stream;
-    struct decoder_frame frame;
+    struct decoder_frame frame;  /* of the selected frame */
     UINT frame_stride;
-    BYTE *frame_data;
+    BYTE *frame_data;            /* decoded pixels of the selected frame */
+    UINT frame_count;
+    UINT current_frame;
 };
 
 static inline struct wmp_decoder *impl_from_decoder(struct decoder *iface)
@@ -109,8 +111,17 @@ static JXR_ERR wmp_stream_Close(struct WMPStream **piface)
 
 static Bool wmp_stream_EOS(struct WMPStream *iface)
 {
-    FIXME("iface %p, stub!\n", iface);
-    return FALSE;
+    struct wmp_decoder *This = impl_from_WMPStream(iface);
+    ULONGLONG pos, size;
+
+    TRACE("iface %p\n", iface);
+
+    /* the end is where seeking to the end lands */
+    if (FAILED(stream_seek(This->stream, 0, STREAM_SEEK_CUR, &pos))
+            || FAILED(stream_seek(This->stream, 0, STREAM_SEEK_END, &size))
+            || FAILED(stream_seek(This->stream, pos, STREAM_SEEK_SET, NULL)))
+        return TRUE;
+    return pos >= size;
 }
 
 static JXR_ERR wmp_stream_Read(struct WMPStream *iface, void *buf, size_t len)
@@ -161,45 +172,26 @@ static JXR_ERR wmp_stream_GetPos(struct WMPStream *iface, size_t *pos)
     return WMP_errSuccess;
 }
 
-static HRESULT CDECL wmp_decoder_initialize(struct decoder *iface, IStream *stream, struct decoder_stat *st)
+/* Makes "index" the frame jxrlib decodes, and reads its description. */
+static HRESULT wmp_decoder_select_frame(struct wmp_decoder *This, UINT index)
 {
-    struct wmp_decoder *This = impl_from_decoder(iface);
-    HRESULT hr;
     Float dpix, dpiy;
     I32 width, height;
     U32 count;
 
-    TRACE("iface %p, stream %p, st %p\n", iface, stream, st);
-
-    if (This->stream)
-        return WINCODEC_ERR_WRONGSTATE;
-
-    This->stream = stream;
-    if (FAILED(hr = stream_seek(This->stream, 0, STREAM_SEEK_SET, NULL)))
-        return hr;
-    if (This->decoder->Initialize(This->decoder, &This->WMPStream_iface))
-    {
-        ERR("Failed to initialize jxrlib decoder!\n");
-        return E_FAIL;
-    }
+    if (index == This->current_frame && This->frame.bpp)
+        return S_OK;
 
-    if (This->decoder->GetFrameCount(This->decoder, &st->frame_count))
+    if (This->decoder->SelectFrame(This->decoder, index))
     {
-        ERR("Failed to get frame count!\n");
+        ERR("Failed to select frame %u!\n", index);
         return E_FAIL;
     }
+    RtlFreeHeap(GetProcessHeap(), 0, This->frame_data);
+    This->frame_data = NULL;
+    memset(&This->frame, 0, sizeof(This->frame));
+    This->current_frame = index;
 
-    if (st->frame_count > 1) FIXME("multi frame JPEG-XR not implemented\n");
-    st->frame_count = 1;
-    st->flags = WICBitmapDecoderCapabilityCanDecodeAllImages |
-                WICBitmapDecoderCapabilityCanDecodeSomeImages |
-                WICBitmapDecoderCapabilityCanEnumerateMetadata;
-
-    if (This->decoder->SelectFrame(This->decoder, 0))
-    {
-        ERR("Failed to select frame 0!\n");
-        return E_FAIL;
-    }
     if (This->decoder->GetPixelFormat(This->decoder, &This->frame.pixel_format))
     {
         ERR("Failed to get frame pixel format!\n");
@@ -227,8 +219,48 @@ static HRESULT CDECL wmp_decoder_initialize(struct decoder *iface, IStream *stre
     This->frame.dpix = dpix;
     This->frame.dpiy = dpiy;
     This->frame.num_colors = 0;
-    if (count) This->frame.num_color_contexts = 1;
-    else This->frame.num_color_contexts = 0;
+    This->frame.num_color_contexts = count ? 1 : 0;
+    return S_OK;
+}
+
+static HRESULT CDECL wmp_decoder_initialize(struct decoder *iface, IStream *stream, struct decoder_stat *st)
+{
+    struct wmp_decoder *This = impl_from_decoder(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, stream %p, st %p\n", iface, stream, st);
+
+    if (This->stream)
+        return WINCODEC_ERR_WRONGSTATE;
+
+    This->stream = stream;
+    if (FAILED(hr = stream_seek(This->stream, 0, STREAM_SEEK_SET, NULL)))
+        return hr;
+    if (This->decoder->Initialize(This->decoder, &This->WMPStream_iface))
+    {
+        ERR("Failed to initialize jxrlib decoder!\n");
+        return E_FAIL;
+    }
+
+    if (This->decoder->GetFrameCount(This->decoder, &st->frame_count))
+    {
+        ERR("Failed to get frame count!\n");
+        return E_FAIL;
+    }
+
+    if (!st->frame_count)
+    {
+        ERR("No frame!\n");
+        return E_FAIL;
+    }
+    This->frame_count = st->frame_count;
+    st->flags = WICBitmapDecoderCapabilityCanDecodeAllImages |
+                WICBitmapDecoderCapabilityCanDecodeSomeImages |
+                WICBitmapDecoderCapabilityCanEnumerateMetadata;
+
+    This->current_frame = ~0u;
+    if (FAILED(hr = wmp_decoder_select_frame(This, 0)))
+        return hr;
 
     return S_OK;
 }
@@ -239,11 +271,12 @@ static HRESULT CDECL wmp_decoder_get_frame_info(struct decoder *iface, UINT fram
 
     TRACE("iface %p, frame %d, info %p\n", iface, frame, info);
 
-    if (frame > 0)
-    {
-        FIXME("multi frame JPEG-XR not implemented\n");
-        return E_NOTIMPL;
-    }
+    HRESULT hr;
+
+    if (frame >= This->frame_count)
+        return WINCODEC_ERR_FRAMEMISSING;
+    if (FAILED(hr = wmp_decoder_select_frame(This, frame)))
+        return hr;
 
     *info = This->frame;
     return S_OK;
@@ -257,11 +290,12 @@ static HRESULT CDECL wmp_decoder_copy_pixels(struct decoder *iface, UINT frame,
 
     TRACE("iface %p, frame %d, rect %p, stride %d, buffersize %d, buffer %p\n", iface, frame, prc, stride, buffersize, buffer);
 
-    if (frame > 0)
-    {
-        FIXME("multi frame JPEG-XR not implemented\n");
-        return E_NOTIMPL;
-    }
+    HRESULT hr;
+
+    if (frame >= This->frame_count)
+        return WINCODEC_ERR_FRAMEMISSING;
+    if (FAILED(hr = wmp_decoder_select_frame(This, frame)))
+        return hr;
 
     if (!This->frame_data)
     {
@@ -272,7 +306,7 @@ static HRESULT CDECL wmp_decoder_copy_pixels(struct decoder *iface, UINT frame,
         This->frame_stride = (This->frame.width * This->frame.bpp + 7) / 8;
         if (!(frame_data = RtlAllocateHeap(GetProcessHeap(), HEAP_ZERO_MEMORY, This->frame.height * This->frame_stride)))
             return E_FAIL;
-        if (This->decoder->Copy(This->decoder, &pkrect, frame_data, stride))
+        if (This->decoder->Copy(This->decoder, &pkrect, frame_data, This->frame_stride))
         {
             ERR("Failed to copy frame data!\n");
             RtlFreeHeap(GetProcessHeap(), 0, frame_data);
@@ -307,6 +341,11 @@ static HRESULT CDECL wmp_decoder_get_color_context(struct decoder* iface, UINT f
     *datasize = 0;
     *data = NULL;
 
+    if (frame >= This->frame_count)
+        return WINCODEC_ERR_FRAMEMISSING;
+    if (FAILED(wmp_decoder_select_frame(This, frame)))
+        return E_FAIL;
+
     if (This->decoder->GetColorContext(This->decoder, NULL, &count))
     {
         ERR("Failed to get frame color context size!\n");
diff --git a/dlls/wmphoto/main.c b/dlls/wmphoto/main.c
index 6765688..81c023c 100644
--- a/dlls/wmphoto/main.c
+++ b/dlls/wmphoto/main.c
@@ -81,7 +81,7 @@ static HRESULT WINAPI wmp_class_factory_QueryInterface(IClassFactory *iface, REF
     }
 
     *out = NULL;
-    FIXME("%s not implemented.\n", debugstr_guid(iid));
+    WARN("%s not implemented.\n", debugstr_guid(iid));
     return E_NOINTERFACE;
 }
 
@@ -108,9 +108,17 @@ static HRESULT WINAPI wmp_class_factory_CreateInstance(IClassFactory *iface, IUn
     return hr;
 }
 
+static LONG server_locks;
+
 static HRESULT WINAPI wmp_class_factory_LockServer(IClassFactory *iface, BOOL lock)
 {
-    FIXME("iface %p, lock %d, stub!\n", iface, lock);
+    TRACE("iface %p, lock %d.\n", iface, lock);
+
+    /* the factory is static, the count is only kept for the record */
+    if (lock)
+        InterlockedIncrement(&server_locks);
+    else
+        InterlockedDecrement(&server_locks);
     return S_OK;
 }
 
@@ -151,7 +159,7 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, LPVOID *out)
     if (IsEqualGUID(clsid, &CLSID_WICWmpDecoder)) factory = &wmp_class_factory;
     else
     {
-        FIXME("%s not implemented.\n", debugstr_guid(clsid));
+        WARN("%s not implemented.\n", debugstr_guid(clsid));
         return CLASS_E_CLASSNOTAVAILABLE;
     }
 
