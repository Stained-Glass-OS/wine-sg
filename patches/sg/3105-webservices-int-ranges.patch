+    if (*found && desc && (val < desc->minValue || val > desc->maxValue)) return WS_E_INVALID_FORMAT;
 
     switch (option)
     {
@@ -5030,13 +5016,9 @@ static HRESULT read_type_uint8( struct reader *reader, WS_TYPE_MAPPING mapping,
     HRESULT hr;
     UINT64 val = 0;
 
-    if (desc)
