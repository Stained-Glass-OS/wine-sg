     if (*found && (hr = text_to_int32( text, &val )) != S_OK) return hr;
+    if (*found && desc && (val < desc->minValue || val > desc->maxValue)) return WS_E_INVALID_FORMAT;
 
     switch (option)
     {
@@ -4949,13 +4939,9 @@ static HRESULT read_type_int64( struct reader *reader, WS_TYPE_MAPPING mapping,
