-    }
     if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_int16( text, &val )) != S_OK) return hr;
+    if (*found && desc && (val < desc->minValue || val > desc->maxValue)) return WS_E_INVALID_FORMAT;
 
     switch (option)
     {
@@ -4869,13 +4863,9 @@ static HRESULT read_type_int32( struct reader *reader, WS_TYPE_MAPPING mapping,
     HRESULT hr;
