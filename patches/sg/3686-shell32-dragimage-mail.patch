From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32, winspool: drag images, unread mail accounts, spool file handle (3686)

shell32, winspool: drag images, unread mail accounts, spool file handle

IDragSourceHelper::InitializeFromBitmap keeps the drag image in the data
object and IDropTargetHelper shows it in a layered window that follows the
cursor (DragEnter, DragOver, Show, DragLeave, Drop); InitializeFromWindow
asks the window for its image (ShellGetDragImage). SHSetUnreadMailCountW
records the count, time and application of a mail account under
UnreadMail, SHEnumerateUnreadMailAccountsW lists the accounts.
GetSpoolFileHandle fails with ERROR_INVALID_HANDLE: only a print processor
has a spool file to read.
---
diff --git a/dlls/shell32/dragdrophelper.c b/dlls/shell32/dragdrophelper.c
index 8a41eee..28c6e5c 100644
--- a/dlls/shell32/dragdrophelper.c
+++ b/dlls/shell32/dragdrophelper.c
@@ -29,6 +29,7 @@
 #include "winreg.h"
 #include "wingdi.h"
 #include "winuser.h"
+#include <stdlib.h>
 
 #include "objbase.h"
 #include "ole2.h"
@@ -44,13 +45,136 @@ WINE_DEFAULT_DEBUG_CHANNEL (shell);
 *   IDropTargetHelper implementation
 */
 
+/* The drag image a source gives its data object (format "DragImageBits"): the size, the point
+ * of the image under the cursor, the colour key and the 32 bit top-down pixels. The layout is
+ * private to this helper: the source half writes it and the target half reads it. */
+struct drag_image_bits
+{
+    LONG cx, cy;
+    LONG offset_x, offset_y;
+    COLORREF key;
+    DWORD pixels[1];
+};
+
 typedef struct
 {
     IDropTargetHelper IDropTargetHelper_iface;
     IDragSourceHelper2 IDragSourceHelper2_iface;
     LONG ref;
+
+    DWORD flags;
+    HWND window;            /* the layered window that shows the image while it is dragged */
+    SIZE size;
+    POINT offset;
+    HBITMAP bitmap;
+    BOOL visible;
 } dragdrophelper;
 
+static UINT drag_image_format(void)
+{
+    return RegisterClipboardFormatW(L"DragImageBits");
+}
+
+static LRESULT CALLBACK drag_image_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_NCHITTEST) return HTTRANSPARENT;
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static void drag_image_destroy(dragdrophelper *This)
+{
+    if (This->window) DestroyWindow(This->window);
+    if (This->bitmap) DeleteObject(This->bitmap);
+    This->window = NULL;
+    This->bitmap = NULL;
+    This->visible = FALSE;
+}
+
+/* the window with the image at the cursor, hidden until it is moved there */
+static BOOL drag_image_create(dragdrophelper *This, const struct drag_image_bits *bits)
+{
+    static const WCHAR class_name[] = L"SGDragImage";
+    static BOOL registered;
+    BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER), bits->cx, -bits->cy, 1, 32, BI_RGB }};
+    WNDCLASSW cls = {0};
+    void *dib;
+    HDC hdc;
+
+    if (!registered)
+    {
+        cls.lpfnWndProc = drag_image_proc;
+        cls.hInstance = GetModuleHandleW(NULL);
+        cls.lpszClassName = class_name;
+        RegisterClassW(&cls);
+        registered = TRUE;
+    }
+    hdc = GetDC(NULL);
+    This->bitmap = CreateDIBSection(hdc, &info, DIB_RGB_COLORS, &dib, NULL, 0);
+    ReleaseDC(NULL, hdc);
+    if (!This->bitmap) return FALSE;
+    memcpy(dib, bits->pixels, (size_t)bits->cx * bits->cy * 4);
+    This->size.cx = bits->cx;
+    This->size.cy = bits->cy;
+    This->offset.x = bits->offset_x;
+    This->offset.y = bits->offset_y;
+    This->window = CreateWindowExW(WS_EX_LAYERED | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+            class_name, NULL, WS_POPUP, 0, 0, bits->cx, bits->cy, NULL, NULL, GetModuleHandleW(NULL), NULL);
+    if (!This->window)
+    {
+        DeleteObject(This->bitmap);
+        This->bitmap = NULL;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void drag_image_move(dragdrophelper *This, const POINT *pt)
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 192, AC_SRC_ALPHA };
+    POINT pos, src = {0, 0};
+    SIZE size;
+    HDC screen, mem;
+    HGDIOBJ old;
+
+    if (!This->window || !pt) return;
+    pos.x = pt->x - This->offset.x;
+    pos.y = pt->y - This->offset.y;
+    size = This->size;
+    screen = GetDC(NULL);
+    mem = CreateCompatibleDC(screen);
+    old = SelectObject(mem, This->bitmap);
+    UpdateLayeredWindow(This->window, screen, &pos, &size, mem, &src, 0, &blend, ULW_ALPHA);
+    SelectObject(mem, old);
+    DeleteDC(mem);
+    ReleaseDC(NULL, screen);
+    if (This->visible) ShowWindow(This->window, SW_SHOWNOACTIVATE);
+}
+
+static BOOL get_drag_image_bits(IDataObject *object, struct drag_image_bits **out)
+{
+    FORMATETC fmt = { drag_image_format(), NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med;
+    SIZE_T size;
+    void *data;
+
+    *out = NULL;
+    if (!object || FAILED(IDataObject_GetData(object, &fmt, &med))) return FALSE;
+    size = GlobalSize(med.hGlobal);
+    if (size >= sizeof(struct drag_image_bits) && (data = GlobalLock(med.hGlobal)))
+    {
+        const struct drag_image_bits *bits = data;
+
+        if (bits->cx > 0 && bits->cy > 0 && bits->cx <= 4096 && bits->cy <= 4096 &&
+                size >= offsetof(struct drag_image_bits, pixels) + (size_t)bits->cx * bits->cy * 4)
+        {
+            if ((*out = malloc(size))) memcpy(*out, data, size);
+        }
+        GlobalUnlock(med.hGlobal);
+    }
+    ReleaseStgMedium(&med);
+    return *out != NULL;
+}
+
 static inline dragdrophelper *impl_from_IDropTargetHelper(IDropTargetHelper *iface)
 {
     return CONTAINING_RECORD(iface, dragdrophelper, IDropTargetHelper_iface);
@@ -109,6 +233,7 @@ static ULONG WINAPI IDropTargetHelper_fnRelease (IDropTargetHelper * iface)
 
     if (!refCount) {
         TRACE ("-- destroying (%p)\n", This);
+        drag_image_destroy(This);
         LocalFree (This);
         return 0;
     }
@@ -123,35 +248,70 @@ static HRESULT WINAPI IDropTargetHelper_fnDragEnter (
 	DWORD dwEffect)
 {
     dragdrophelper *This = impl_from_IDropTargetHelper(iface);
-    FIXME ("(%p)->(%p %p %p 0x%08lx)\n", This,hwndTarget, pDataObject, ppt, dwEffect);
-    return E_NOTIMPL;
+    struct drag_image_bits *bits;
+
+    TRACE ("(%p)->(%p %p %p 0x%08lx)\n", This,hwndTarget, pDataObject, ppt, dwEffect);
+
+    if (!ppt) return E_INVALIDARG;
+    drag_image_destroy(This);
+    /* a source that gave a drag image gets it shown at the cursor */
+    if (get_drag_image_bits(pDataObject, &bits))
+    {
+        if (drag_image_create(This, bits))
+        {
+            This->visible = TRUE;
+            drag_image_move(This, ppt);
+        }
+        free(bits);
+    }
+    return S_OK;
 }
 
 static HRESULT WINAPI IDropTargetHelper_fnDragLeave (IDropTargetHelper * iface)
 {
     dragdrophelper *This = impl_from_IDropTargetHelper(iface);
-    FIXME ("(%p)->()\n", This);
-    return E_NOTIMPL;
+
+    TRACE ("(%p)->()\n", This);
+#ifdef SG_MUTANT_DRAGLEAVE
+    return S_OK;
+#endif
+    drag_image_destroy(This);
+    return S_OK;
 }
 
 static HRESULT WINAPI IDropTargetHelper_fnDragOver (IDropTargetHelper * iface, POINT* ppt, DWORD dwEffect)
 {
     dragdrophelper *This = impl_from_IDropTargetHelper(iface);
-    FIXME ("(%p)->(%p 0x%08lx)\n", This, ppt, dwEffect);
-    return E_NOTIMPL;
+
+    TRACE ("(%p)->(%p 0x%08lx)\n", This, ppt, dwEffect);
+
+    if (!ppt) return E_INVALIDARG;
+#ifdef SG_MUTANT_DRAGMOVE
+    return S_OK;
+#endif
+    drag_image_move(This, ppt);
+    return S_OK;
 }
 
 static HRESULT WINAPI IDropTargetHelper_fnDrop (IDropTargetHelper * iface, IDataObject* pDataObject, POINT* ppt, DWORD dwEffect)
 {
     dragdrophelper *This = impl_from_IDropTargetHelper(iface);
-    FIXME ("(%p)->(%p %p 0x%08lx)\n", This, pDataObject, ppt, dwEffect);
-    return E_NOTIMPL;
+
+    TRACE ("(%p)->(%p %p 0x%08lx)\n", This, pDataObject, ppt, dwEffect);
+    drag_image_destroy(This);
+    return S_OK;
 }
 
 static HRESULT WINAPI IDropTargetHelper_fnShow (IDropTargetHelper * iface, BOOL fShow)
 {
     dragdrophelper *This = impl_from_IDropTargetHelper(iface);
-    FIXME ("(%p)->(%u)\n", This, fShow);
+
+    TRACE ("(%p)->(%u)\n", This, fShow);
+    if (This->window)
+    {
+        This->visible = fShow;
+        ShowWindow(This->window, fShow ? SW_SHOWNOACTIVATE : SW_HIDE);
+    }
     return S_OK;
 }
 
@@ -189,28 +349,85 @@ static HRESULT WINAPI DragSourceHelper2_InitializeFromBitmap(IDragSourceHelper2
     SHDRAGIMAGE *dragimage, IDataObject *object)
 {
     dragdrophelper *This = impl_from_IDragSourceHelper2(iface);
-
-    FIXME("(%p)->(%p, %p): stub\n", This, dragimage, object);
-
-    return E_NOTIMPL;
+    FORMATETC fmt = { drag_image_format(), NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM med = { TYMED_HGLOBAL };
+    struct drag_image_bits *bits;
+    BITMAP bm;
+    HGLOBAL global;
+    SIZE_T size;
+    HRESULT hr;
+    HDC hdc;
+
+    TRACE("(%p)->(%p, %p)\n", This, dragimage, object);
+
+    if (!dragimage || !object || !dragimage->hbmpDragImage) return E_INVALIDARG;
+    if (!GetObjectW(dragimage->hbmpDragImage, sizeof(bm), &bm) || bm.bmWidth <= 0 || bm.bmHeight <= 0 ||
+            bm.bmWidth > 4096 || bm.bmHeight > 4096)
+        return E_INVALIDARG;
+
+    size = offsetof(struct drag_image_bits, pixels) + (size_t)bm.bmWidth * bm.bmHeight * 4;
+    if (!(global = GlobalAlloc(GMEM_MOVEABLE, size))) return E_OUTOFMEMORY;
+    bits = GlobalLock(global);
+    bits->cx = bm.bmWidth;
+    bits->cy = bm.bmHeight;
+    bits->offset_x = dragimage->ptOffset.x;
+    bits->offset_y = dragimage->ptOffset.y;
+    bits->key = dragimage->crColorKey;
+    {
+        BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER), bm.bmWidth, -bm.bmHeight, 1, 32, BI_RGB }};
+        BOOL ok;
+
+        hdc = GetDC(NULL);
+        ok = GetDIBits(hdc, dragimage->hbmpDragImage, 0, bm.bmHeight, bits->pixels, &info, DIB_RGB_COLORS) != 0;
+        ReleaseDC(NULL, hdc);
+        GlobalUnlock(global);
+        if (!ok)
+        {
+            GlobalFree(global);
+            return E_FAIL;
+        }
+    }
+    med.hGlobal = global;
+#ifdef SG_MUTANT_DRAGBITS
+    return S_OK;
+#endif
+    if (FAILED(hr = IDataObject_SetData(object, &fmt, &med, TRUE)))
+    {
+        GlobalFree(global);
+        return hr;
+    }
+    /* the helper owns the bitmap now */
+    DeleteObject(dragimage->hbmpDragImage);
+    return S_OK;
 }
 
+static HRESULT WINAPI DragSourceHelper2_InitializeFromBitmap(IDragSourceHelper2 *iface, SHDRAGIMAGE *dragimage, IDataObject *object);
 static HRESULT WINAPI DragSourceHelper2_InitializeFromWindow(IDragSourceHelper2 *iface, HWND hwnd,
     POINT *pt, IDataObject *object)
 {
     dragdrophelper *This = impl_from_IDragSourceHelper2(iface);
+    SHDRAGIMAGE image = {{0}};
+    HRESULT hr;
 
-    FIXME("(%p)->(%p, %s, %p): stub\n", This, hwnd, wine_dbgstr_point(pt), object);
+    TRACE("(%p)->(%p, %s, %p)\n", This, hwnd, wine_dbgstr_point(pt), object);
 
-    return E_NOTIMPL;
+    if (!hwnd || !object) return E_INVALIDARG;
+    /* a window that supports drag images answers "ShellGetDragImage" with the image */
+    if (!SendMessageW(hwnd, RegisterWindowMessageW(L"ShellGetDragImage"), 0, (LPARAM)&image) || !image.hbmpDragImage)
+        return E_FAIL;
+    hr = DragSourceHelper2_InitializeFromBitmap(iface, &image, object);
+    if (FAILED(hr)) DeleteObject(image.hbmpDragImage);
+    return hr;
 }
 
 static HRESULT WINAPI DragSourceHelper2_SetFlags(IDragSourceHelper2 *iface, DWORD flags)
 {
     dragdrophelper *This = impl_from_IDragSourceHelper2(iface);
 
-    FIXME("(%p)->(%08lx): stub\n", This, flags);
+    TRACE("(%p)->(%08lx)\n", This, flags);
 
+    /* DSH_ALLOWDROPDESCRIPTIONTEXT: the source takes drop descriptions, which the helper does not draw */
+    This->flags = flags;
     return S_OK;
 }
 
diff --git a/dlls/shell32/shell32_main.c b/dlls/shell32/shell32_main.c
index b3f0e82..a6f6e85 100644
--- a/dlls/shell32/shell32_main.c
+++ b/dlls/shell32/shell32_main.c
@@ -1463,8 +1463,29 @@ LRESULT CALLBACK ShellHookProc(DWORD a, DWORD b, DWORD c)
  */
 HRESULT WINAPI SHSetUnreadMailCountW(LPCWSTR mailaddress, DWORD count, LPCWSTR executecommand)
 {
-    FIXME("%s %lx %s: stub\n", debugstr_w(mailaddress), count, debugstr_w(executecommand));
-    return E_NOTIMPL;
+    static const WCHAR base[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\UnreadMail";
+    WCHAR key[MAX_PATH + 64];
+    FILETIME ft;
+    LONG res;
+
+    TRACE("%s %lx %s\n", debugstr_w(mailaddress), count, debugstr_w(executecommand));
+
+    if (!mailaddress || !*mailaddress || wcschr(mailaddress, '\\') || wcslen(mailaddress) >= MAX_PATH) return E_INVALIDARG;
+
+#ifdef SG_MUTANT_MAILSET
+    return S_OK;
+#endif
+    /* the account's key holds the count, when it was set and what to run to read the mail */
+    swprintf(key, ARRAY_SIZE(key), L"%s\\%s", base, mailaddress);
+    GetSystemTimeAsFileTime(&ft);
+    if ((res = RegSetKeyValueW(HKEY_CURRENT_USER, key, L"MessageCount", REG_DWORD, &count, sizeof(count))))
+        return HRESULT_FROM_WIN32(res);
+    if ((res = RegSetKeyValueW(HKEY_CURRENT_USER, key, L"TimeStamp", REG_BINARY, &ft, sizeof(ft))))
+        return HRESULT_FROM_WIN32(res);
+    if (executecommand && *executecommand)
+        res = RegSetKeyValueW(HKEY_CURRENT_USER, key, L"Application", REG_SZ, executecommand,
+                (lstrlenW(executecommand) + 1) * sizeof(WCHAR));
+    return HRESULT_FROM_WIN32(res);
 }
 
 /***********************************************************************
@@ -1472,8 +1493,26 @@ HRESULT WINAPI SHSetUnreadMailCountW(LPCWSTR mailaddress, DWORD count, LPCWSTR e
  */
 HRESULT WINAPI SHEnumerateUnreadMailAccountsW(HKEY user, DWORD idx, LPWSTR mailaddress, INT mailaddresslen)
 {
-    FIXME("%p %ld %p %d: stub\n", user, idx, mailaddress, mailaddresslen);
-    return E_NOTIMPL;
+    HKEY hkey;
+    DWORD len = mailaddresslen;
+    LONG res;
+
+    TRACE("%p %ld %p %d\n", user, idx, mailaddress, mailaddresslen);
+
+    if (!mailaddress || mailaddresslen <= 0) return E_INVALIDARG;
+    if ((res = RegOpenKeyExW(user ? user : HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\UnreadMail",
+            0, KEY_READ, &hkey)))
+        return HRESULT_FROM_WIN32(res == ERROR_FILE_NOT_FOUND ? ERROR_NO_MORE_ITEMS : res);
+#ifdef SG_MUTANT_MAILENUM
+    res = ERROR_NO_MORE_ITEMS;
+    len = 0;
+    mailaddress[0] = 0;
+    RegCloseKey(hkey);
+    return HRESULT_FROM_WIN32(res);
+#endif
+    res = RegEnumKeyExW(hkey, idx, mailaddress, &len, NULL, NULL, NULL, NULL);
+    RegCloseKey(hkey);
+    return res == ERROR_MORE_DATA ? HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER) : HRESULT_FROM_WIN32(res);
 }
 
 /***********************************************************************
diff --git a/dlls/winspool.drv/info.c b/dlls/winspool.drv/info.c
index ecf9208..119bba7 100644
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -9811,7 +9811,12 @@ DWORD WINAPI PerfCollect(LPWSTR query, LPVOID *data, LPDWORD size, LPDWORD obj_c
  */
 HANDLE WINAPI GetSpoolFileHandle( HANDLE printer )
 {
-    FIXME( "%p: stub\n", printer );
+    TRACE( "%p\n", printer );
+
+    /* Only a print processor, given a handle by the spooler for the job it processes, has a
+     * spool file to read: an application's printer handle fails. There is no spooler or print
+     * processor here, so no handle can be one. */
+    SetLastError( ERROR_INVALID_HANDLE );
     return INVALID_HANDLE_VALUE;
 }
 
