+        if (event->xconfigure.x != ex || event->xconfigure.y != ey)
+        {
+            X11DRV_expect_error( display, ignore_error, NULL );
+            XMoveWindow( display, event->xany.window, ex, ey );
+            X11DRV_check_error();
+        }
+        if (event->xconfigure.width != ew || event->xconfigure.height != eh)
+            NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_SIZE,
+                               (WPARAM)(event->xconfigure.width | event->xconfigure.height << 16),
+                               (LPARAM)(ew | eh << 16) );
+        break;
+    case PropertyNotify:
+        if (event->xproperty.atom == x11drv_atom(_NET_WM_NAME) || event->xproperty.atom == XA_WM_NAME)
+            NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_TITLE, 0, 0 );
+        break;
+    case UnmapNotify:
+        if (event->xunmap.window == event->xunmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 0, 0 );
+        break;
+    case MapNotify:
+        if (event->xmap.window == event->xmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 1, 0 );
+        break;
+    case DestroyNotify:
+        if (event->xdestroywindow.window == event->xdestroywindow.event) NtUserPostMessage( hwnd, WM_SG_EMBED_GONE, 0, 0 );
+        break;
+    }
+    return TRUE;
+}
