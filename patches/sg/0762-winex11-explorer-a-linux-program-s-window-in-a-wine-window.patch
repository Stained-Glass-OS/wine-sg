+/* A Linux window into a Wine window of its own, where it was (winex11's
+ * sg_embed.c): it then stacks among Wine's windows, is activated, minimized,
+ * snapped and switched to as they are (David 2026-10-02: Linux windows
+ * "should stack like regular Windows windows"). NULL when it cannot be (not
+ * a plain top-level): the hidden stand-in, as before. */
+static HWND sg_embed_frame( unsigned long xid, const WCHAR *title, HICON icon )
+{
+    HWND frame;
+    ULONGLONG g;
+    RECT rc;
+
+#ifdef SG_MUTANT_NO_EMBED
+    return NULL;
+#endif
+    frame = CreateWindowExW( WS_EX_APPWINDOW, L"SgLinuxWindow", title, WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, 0, 0, 0, 0 );
+    if (!frame) return NULL;
+    if (!(g = (ULONGLONG)sg_embed_call( frame, SG_EMBED_QUERY, xid ))) { DestroyWindow( frame ); return NULL; }
+    rc.left = (short)(g & 0xffff);
+    rc.top = (short)((g >> 16) & 0xffff);
+    rc.right = rc.left + (int)((g >> 32) & 0xffff);
+    rc.bottom = rc.top + (int)((g >> 48) & 0xffff);
+    AdjustWindowRectEx( &rc, WS_OVERLAPPEDWINDOW, FALSE, WS_EX_APPWINDOW );
+    if (rc.top < 0) OffsetRect( &rc, 0, -rc.top );   /* the title bar on the screen */
+    if (rc.left < 0) OffsetRect( &rc, -rc.left, 0 );
+    if (icon)
+    {
+        SendMessageW( frame, WM_SETICON, ICON_BIG, (LPARAM)icon );
+        SendMessageW( frame, WM_SETICON, ICON_SMALL, (LPARAM)icon );
+    }
+    SetWindowPos( frame, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER | SWP_NOACTIVATE );
+    ShowWindow( frame, SW_SHOWNORMAL );
+    if (!sg_embed_call( frame, SG_EMBED_ATTACH, xid ))
+    {
+        DestroyWindow( frame );
+        return NULL;
+    }
+    SetForegroundWindow( frame );
+    return frame;
 }
 
