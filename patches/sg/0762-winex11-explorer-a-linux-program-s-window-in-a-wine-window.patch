--- /dev/null
+++ b/dlls/winex11.drv/sg_embed.c
@@ -0,0 +1,559 @@
+/*
+ * Stained Glass OS: a Linux program's window inside a Wine window
+ *
+ * Every Wine window lives in Wine's desktop, one X window; a Linux program's
+ * window (Xwayland, the same X server) was a top-level of its own beside it,
+ * so it could only be above every Wine window or below them all (David
+ * 2026-10-01: Linux windows "should stack like regular Windows windows").
+ *
+ * The taskbar keeps a Wine window for each Linux window (explorer's
+ * SgLinuxWindow). Asked to (WM_X11DRV_SG_EMBED_ATTACH), the Linux window goes
+ * into that Wine window's client area, as a window manager puts a client in
+ * its frame: reparented, in this connection's save-set (should this process
+ * die, the X server gives it back to the root, the program lives on), its
+ * size kept to the client area and the frame to its size. Then it is a Wine
+ * window in every way the shell knows -- stacked among the others, activated,
+ * minimized and snapped, in Alt+Tab, Task View and Task Manager.
+ *
+ * What a window manager does, for this one window:
+ *   - focus: activating the frame gives the X focus to the program
+ *     (set_input_focus); a click into the program activates the frame first
+ *     (a synchronous button grab on the frame, the press then replayed)
+ *   - the shell's keys stay the shell's while the program has the focus:
+ *     the Windows key, Alt+Tab, Alt+F4 and Ctrl+Shift+Esc are grabbed on the
+ *     frame, so Wine sees them as keys to the frame
+ *   - its title follows the program's (_NET_WM_NAME, WM_NAME); it closes with
+ *     WM_DELETE_WINDOW (or the client is killed when it does not speak it);
+ *     the program hiding (unmapping) or destroying its window tells explorer
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <X11/Xatom.h>
+#include <X11/keysym.h>
+
+#include "x11drv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(x11drv);
+
+/* to explorer's frame window: the program unmapped (wp 0) or mapped (wp 1)
+ * its window; the program's window is gone */
+#define WM_SG_EMBED_SHOWN (WM_USER + 0x5350)
+#define WM_SG_EMBED_GONE  (WM_USER + 0x5351)
+
+#define MAX_EMBEDS 64
+
+struct sg_embed
+{
+    HWND     hwnd;
+    Display *display;
+    Window   frame;     /* the Wine window's whole_window */
+    Window   child;     /* the program's window */
+    int      x, y, w, h; /* where we put it in the frame */
+};
+
+static struct sg_embed embeds[MAX_EMBEDS];
+static int embed_count;
+static pthread_mutex_t embed_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static struct sg_embed *find_hwnd( HWND hwnd )
+{
+    int i;
+    for (i = 0; i < embed_count; i++) if (embeds[i].hwnd == hwnd) return &embeds[i];
+    return NULL;
+}
+
+static struct sg_embed *find_child( Display *display, Window child )
+{
+    int i;
+    for (i = 0; i < embed_count; i++)
+        if (embeds[i].child == child && embeds[i].display == display) return &embeds[i];
+    return NULL;
+}
+
+/* the program's window may be gone at any moment: an X error on it is
+ * expected, never fatal */
+static int ignore_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+static void remove_embed( struct sg_embed *e )
+{
+    *e = embeds[--embed_count];
+}
+
+/* the client area, in the frame's X window */
+static BOOL client_in_frame( struct x11drv_win_data *data, int *x, int *y, int *w, int *h )
+{
+    if (!data->whole_window) return FALSE;
+    *x = data->rects.client.left - data->rects.visible.left;
+    *y = data->rects.client.top - data->rects.visible.top;
+    *w = max( 1, data->rects.client.right - data->rects.client.left );
+    *h = max( 1, data->rects.client.bottom - data->rects.client.top );
+    return TRUE;
+}
+
+/* a window the session may put in a frame: a top-level, shown, not a menu */
+static BOOL embeddable( Display *display, Window child, XWindowAttributes *attr )
+{
+    Window root, parent, *children = NULL;
+    unsigned int n;
+
+    BOOL ok;
+
+    if (!child) return FALSE;
+    X11DRV_expect_error( display, ignore_error, NULL );
+    ok = XGetWindowAttributes( display, child, attr );
+    if (X11DRV_check_error() || !ok) { WARN( "%lx: no such window\n", child ); return FALSE; }
+    if (attr->override_redirect || attr->class != InputOutput)
+    {
+        WARN( "%lx: override-redirect or input-only\n", child );
+        return FALSE;
+    }
+    X11DRV_expect_error( display, ignore_error, NULL );
+    ok = XQueryTree( display, child, &root, &parent, &children, &n );
+    if (X11DRV_check_error() || !ok) return FALSE;
+    if (children) XFree( children );
+    if (parent != root) WARN( "%lx: not a top-level (parent %lx)\n", child, parent );
+    return parent == root;
+}
+
+/***********************************************************************
+ *      sg_embed_query
+ *
+ * Where the program's window is now, for the frame to be made around it:
+ * left, top, width, height, 16 bits each (0: it cannot be embedded).
+ */
+LRESULT sg_embed_query( HWND hwnd, Window child )
+{
+    Display *display = thread_init_display();
+    XWindowAttributes attr;
+    Window dummy;
+    int x, y;
+
+    BOOL ok;
+
+    if (!embeddable( display, child, &attr )) return 0;
+    X11DRV_expect_error( display, ignore_error, NULL );
+    ok = XTranslateCoordinates( display, child, attr.root, 0, 0, &x, &y, &dummy );
+    if (X11DRV_check_error() || !ok) return 0;
+    TRACE( "%p: %lx at %d,%d %dx%d\n", hwnd, child, x, y, attr.width, attr.height );
+    return (LRESULT)((ULONGLONG)(USHORT)x | (ULONGLONG)(USHORT)y << 16 |
+                     (ULONGLONG)(USHORT)attr.width << 32 | (ULONGLONG)(USHORT)attr.height << 48);
+}
+
+static void grab_shell_keys( Display *display, Window frame )
+{
+    static const unsigned int locks[] = { 0, LockMask, Mod2Mask, LockMask | Mod2Mask };
+    static const struct { KeySym sym; unsigned int mods; } keys[] =
+    {
+        { XK_Super_L, AnyModifier }, { XK_Super_R, AnyModifier },
+        { XK_Tab, Mod1Mask }, { XK_Tab, Mod1Mask | ShiftMask },
+        { XK_F4, Mod1Mask },
+        { XK_Escape, (1 << 2) /* ControlMask, which Wine's headers take away */ | ShiftMask },
+    };
+    unsigned int i, j;
+
+    for (i = 0; i < ARRAY_SIZE(keys); i++)
+    {
+        KeyCode code = XKeysymToKeycode( display, keys[i].sym );
+        if (!code) continue;
+        if (keys[i].mods == AnyModifier)
+            XGrabKey( display, code, AnyModifier, frame, False, GrabModeAsync, GrabModeAsync );
+        else
+            for (j = 0; j < ARRAY_SIZE(locks); j++)
+                XGrabKey( display, code, keys[i].mods | locks[j], frame, False, GrabModeAsync, GrabModeAsync );
+    }
+}
+
+/***********************************************************************
+ *      sg_embed_attach
+ *
+ * The program's window into the Wine window's client area.
+ */
+LRESULT sg_embed_attach( HWND hwnd, Window child )
+{
+    struct x11drv_win_data *data;
+    XWindowAttributes attr;
+    struct sg_embed *e;
+    int x, y, w, h;
+
+    if (!(data = get_win_data( hwnd ))) return 0;
+    if (!client_in_frame( data, &x, &y, &w, &h ) || !embeddable( data->display, child, &attr ))
+    {
+        release_win_data( data );
+        return 0;
+    }
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( hwnd )) || embed_count == MAX_EMBEDS)
+    {
+        pthread_mutex_unlock( &embed_mutex );
+        release_win_data( data );
+        return 0;
+    }
+    e = &embeds[embed_count++];
+    e->hwnd = hwnd;
+    e->display = data->display;
+    e->frame = data->whole_window;
+    e->child = child;
+    e->x = x; e->y = y; e->w = w; e->h = h;
+    pthread_mutex_unlock( &embed_mutex );
+
+    /* should this process go, the program's window goes back to the root,
+     * not with our frame */
+    X11DRV_expect_error( data->display, ignore_error, NULL );
+    XAddToSaveSet( data->display, child );
+    XSelectInput( data->display, child, StructureNotifyMask | PropertyChangeMask );
+    XReparentWindow( data->display, child, data->whole_window, x, y );
+    XResizeWindow( data->display, child, w, h );
+    XMapRaised( data->display, child );
+    if (X11DRV_check_error())   /* gone meanwhile */
+    {
+        pthread_mutex_lock( &embed_mutex );
+        if ((e = find_hwnd( hwnd ))) remove_embed( e );
+        pthread_mutex_unlock( &embed_mutex );
+        release_win_data( data );
+        return 0;
+    }
+#ifndef SG_MUTANT_EMBED_NO_CLICK_FOCUS
+    /* a click into the program activates the frame (then is replayed to it) */
+    /* owner_events, and the release and motion asked for: on the frame
+     * itself (its buttons, its title bar dragged) Wine must see the rest of
+     * the click -- with the press alone, the close button waited for ever */
+    XGrabButton( data->display, AnyButton, AnyModifier, data->whole_window, True,
+                 ButtonPressMask | ButtonReleaseMask | PointerMotionMask, GrabModeSync, GrabModeAsync, None, None );
+#endif
+    grab_shell_keys( data->display, data->whole_window );
+    XFlush( data->display );
+    TRACE( "%p: %lx embedded in %lx at %d,%d %dx%d\n", hwnd, child, data->whole_window, x, y, w, h );
+    release_win_data( data );
+    return 1;
+}
+
+/***********************************************************************
+ *      sg_embed_layout
+ *
+ * The frame moved or was sized (X11DRV_WindowPosChanged): the program's
+ * window fills its client area.
+ */
+void sg_embed_layout( struct x11drv_win_data *data )
+{
+    struct sg_embed *e;
+    int x, y, w, h;
+
+    if (!embed_count || !client_in_frame( data, &x, &y, &w, &h )) return;
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( data->hwnd )) && (e->x != x || e->y != y || e->w != w || e->h != h))
+    {
+        e->x = x; e->y = y; e->w = w; e->h = h;
+        X11DRV_expect_error( e->display, ignore_error, NULL );
+        XMoveResizeWindow( e->display, e->child, x, y, w, h );
+        X11DRV_check_error();
+    }
+    pthread_mutex_unlock( &embed_mutex );
+}
+
+/***********************************************************************
+ *      sg_embed_focus
+ *
+ * The frame is given the focus: the program has the X focus.
+ */
+BOOL sg_embed_focus( struct x11drv_win_data *data )
+{
+    struct sg_embed *e;
+    Window child = 0;
+
+    if (!embed_count) return FALSE;
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( data->hwnd ))) child = e->child;
+    pthread_mutex_unlock( &embed_mutex );
+    if (!child) return FALSE;
+#ifndef SG_MUTANT_EMBED_NO_FOCUS
+    X11DRV_expect_error( data->display, ignore_error, NULL );
+    XSetInputFocus( data->display, child, RevertToParent, CurrentTime );
+    if (X11DRV_check_error()) return FALSE;   /* gone: the frame has it */
+#endif
+    return TRUE;
+}
+
+/* an X window holding a program's window: painted around it */
+BOOL sg_embed_is_frame( Window window )
+{
+    BOOL ret = FALSE;
+    int i;
+    if (!embed_count || !window) return FALSE;
+    pthread_mutex_lock( &embed_mutex );
+    for (i = 0; i < embed_count; i++) if (embeds[i].frame == window) ret = TRUE;
+    pthread_mutex_unlock( &embed_mutex );
+#ifdef SG_MUTANT_EMBED_PAINT_OVER
+    ret = FALSE;
+#endif
+    return ret;
+}
+
+/* the frame holds a program's window (the X focus there is still ours) */
+BOOL sg_embed_has_child( HWND hwnd )
+{
+    BOOL ret;
+    if (!embed_count) return FALSE;
+    pthread_mutex_lock( &embed_mutex );
+    ret = find_hwnd( hwnd ) != NULL;
+    pthread_mutex_unlock( &embed_mutex );
+    return ret;
+}
+
+/***********************************************************************
+ *      sg_embed_button
+ *
+ * A press on a frame (its button grab): into the program, the frame is
+ * activated and the press goes on to the program; on the frame itself, Wine
+ * has it as always.
+ */
+BOOL sg_embed_button( HWND hwnd, XButtonEvent *event )
+{
+    struct sg_embed *e;
+    Window child = 0;
+
+    if (!embed_count) return FALSE;
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( hwnd )) && event->window == e->frame) child = e->child;
+    pthread_mutex_unlock( &embed_mutex );
+    if (!child) return FALSE;
+    if (event->subwindow != child)
+    {
+        XAllowEvents( event->display, AsyncPointer, event->time );
+        return FALSE;
+    }
+    XAllowEvents( event->display, ReplayPointer, event->time );
+    NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_ACTIVATE, 0, 0 );
+    return TRUE;
+}
+
+static void set_title( HWND hwnd, Display *display, Window child )
+{
+    Atom type;
+    int format;
+    unsigned long count, remaining;
+    unsigned char *prop = NULL;
+    WCHAR title[256];
+    DWORD len = 0;
+
+    X11DRV_expect_error( display, ignore_error, NULL );
+    if (XGetWindowProperty( display, child, x11drv_atom(_NET_WM_NAME), 0, 256, False, x11drv_atom(UTF8_STRING),
+                            &type, &format, &count, &remaining, &prop ) || !prop || !count)
+    {
+        if (prop) XFree( prop );
+        prop = NULL;
+        if (XGetWindowProperty( display, child, XA_WM_NAME, 0, 256, False, AnyPropertyType,
+                                &type, &format, &count, &remaining, &prop ) || !prop)
+        {
+            if (prop) XFree( prop );
+            X11DRV_check_error();
+            return;
+        }
+    }
+    if (X11DRV_check_error()) { XFree( prop ); return; }
+    if (format == 8) RtlUTF8ToUnicodeN( title, sizeof(title) - sizeof(WCHAR), &len, (char *)prop, count );
+    XFree( prop );
+    title[len / sizeof(WCHAR)] = 0;
+    send_message( hwnd, WM_SETTEXT, 0, (LPARAM)title );
+}
+
+/***********************************************************************
+ *      sg_embed_message
+ *
+ * WM_X11DRV_SG_EMBED_* on the frame's thread.
+ */
+LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    struct x11drv_win_data *data;
+    struct sg_embed *e;
+    Window child = 0;
+    Display *display = NULL;
+
+    TRACE( "%p msg %x wp %lx\n", hwnd, msg, (long)wp );
+    switch (msg)
+    {
+    case WM_X11DRV_SG_EMBED_QUERY:
+        return sg_embed_query( hwnd, (Window)wp );
+    case WM_X11DRV_SG_EMBED_ATTACH:
+    {
+        LRESULT ret = sg_embed_attach( hwnd, (Window)wp );
+        if (ret && (data = get_win_data( hwnd )))
+        {
+            set_title( hwnd, data->display, (Window)wp );
+            release_win_data( data );
+        }
+        return ret;
+    }
+    }
+
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( hwnd ))) { child = e->child; display = e->display; }
+    pthread_mutex_unlock( &embed_mutex );
+    if (!child) return 0;
+
+    switch (msg)
+    {
+    case WM_X11DRV_SG_EMBED_ACTIVATE:
+        NtUserSetForegroundWindow( hwnd );
+        if ((data = get_win_data( hwnd )))
+        {
+            sg_embed_focus( data );
+            release_win_data( data );
+        }
+        return 0;
+    case WM_X11DRV_SG_EMBED_TITLE:
+        set_title( hwnd, display, child );
+        return 0;
+    case WM_X11DRV_SG_EMBED_SIZE:
+    {
+        /* the program sized its window: the frame follows */
+        RECT rect;
+        int dw = (int)wp - (int)(lp & 0xffff), dh = (int)(wp >> 16) - (int)(lp >> 16);
+        if (!(data = get_win_data( hwnd ))) return 0;
+        rect = data->rects.window;
+        release_win_data( data );
+        if (dw || dh)
+            NtUserSetWindowPos( hwnd, 0, 0, 0, rect.right - rect.left + dw, rect.bottom - rect.top + dh,
+                                SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE );
+        return 0;
+    }
+    case WM_X11DRV_SG_EMBED_CLOSE:
+    {
+        Atom *protocols;
+        int i, n;
+        BOOL polite = FALSE;
+        X11DRV_expect_error( display, ignore_error, NULL );
+        if (XGetWMProtocols( display, child, &protocols, &n ))
+        {
+            for (i = 0; i < n; i++) if (protocols[i] == x11drv_atom(WM_DELETE_WINDOW)) polite = TRUE;
+            XFree( protocols );
+        }
+        if (polite)
+        {
+            XEvent ev = { 0 };
+            ev.xclient.type = ClientMessage;
+            ev.xclient.window = child;
+            ev.xclient.message_type = x11drv_atom(WM_PROTOCOLS);
+            ev.xclient.format = 32;
+            ev.xclient.data.l[0] = x11drv_atom(WM_DELETE_WINDOW);
+            ev.xclient.data.l[1] = CurrentTime;
+            XSendEvent( display, child, False, NoEventMask, &ev );
+        }
+        else XKillClient( display, child );
+        X11DRV_check_error();
+        return 0;
+    }
+    }
+    return 0;
+}
+
+/***********************************************************************
+ *      sg_embed_event
+ *
+ * An event on a program's window we framed (call_event_handler): handled
+ * here, never as an event of a Wine window.
+ */
+BOOL sg_embed_event( Display *display, XEvent *event )
+{
+    struct sg_embed *e;
+    HWND hwnd = 0;
+    int ew = 0, eh = 0, ex = 0, ey = 0;
+
+    if (!embed_count) return FALSE;
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_child( display, event->xany.window )))
+    {
