+/***********************************************************************
+ *      sg_embed_destroy
+ *
+ * The frame goes (X11DRV_DestroyWindow) with the program's window still in
+ * it: back to the root, a top-level again, where it was.
+ */
+void sg_embed_destroy( HWND hwnd )
+{
+    struct sg_embed *e, copy;
+    BOOL found = FALSE;
+    Window dummy;
+    int x, y;
+
+    if (!embed_count) return;
+    pthread_mutex_lock( &embed_mutex );
+    if ((e = find_hwnd( hwnd ))) { copy = *e; remove_embed( e ); found = TRUE; }
+    pthread_mutex_unlock( &embed_mutex );
+    if (!found) return;
+    X11DRV_expect_error( copy.display, ignore_error, NULL );
+    if (!XTranslateCoordinates( copy.display, copy.child, DefaultRootWindow( copy.display ), 0, 0, &x, &y, &dummy ))
+        x = y = 0;
+    XSelectInput( copy.display, copy.child, 0 );
+    XReparentWindow( copy.display, copy.child, DefaultRootWindow( copy.display ), x, y );
+    XRemoveFromSaveSet( copy.display, copy.child );
+    X11DRV_check_error();
+}
