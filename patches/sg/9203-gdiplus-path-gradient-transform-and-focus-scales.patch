From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: a path gradient's transform and focus scales are drawn

Path gradient brushes drew as if their transform were identity and their
focus scales (0, 0) ("path gradient transform not implemented", "focus not
implemented"). The brush's transform now maps the boundary and centre into
the world before the device transform (an affine map keeps the triangle-fan
interpolation exact). Focus scales: the boundary scaled about the centre is
filled with the centre colour and the gradient runs from the boundary to it,
as Windows draws them (per ray for unequal X and Y scales).
---
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -1809,14 +1809,29 @@
         INT min_y, max_y, min_x, max_x;
         INT x, y;
         ARGB outer_color;
+#ifdef SG_MUTANT_PATHGRAD_NO_TRANSFORM_FOCUS
         static BOOL transform_fixme_once;
+#endif
+        /* wine-sg 9203: focus scales -- the boundary scaled about the centre is filled with the centre
+         * colour and the gradient runs from the boundary to it */
+        BOOL focus = FALSE;
+        REAL focus_x = 1.0f, focus_y = 1.0f;
 
+#ifndef SG_MUTANT_PATHGRAD_NO_TRANSFORM_FOCUS
+        if ((fill->focus.X != 0.0f || fill->focus.Y != 0.0f) && fill->focus.X > 0.0f && fill->focus.Y > 0.0f)
+        {
+            focus = TRUE;
+            focus_x = fill->focus.X;
+            focus_y = fill->focus.Y;
+        }
+#else
         if (fill->focus.X != 0.0 || fill->focus.Y != 0.0)
         {
             static int once;
             if (!once++)
                 FIXME("path gradient focus not implemented\n");
         }
+#endif
 
         if (fill->gamma)
         {
@@ -1841,6 +1856,7 @@
         }
 #endif
 
+#ifdef SG_MUTANT_PATHGRAD_NO_TRANSFORM_FOCUS
         if (!transform_fixme_once)
         {
             BOOL is_identity=TRUE;
@@ -1851,6 +1867,7 @@
                 transform_fixme_once = TRUE;
             }
         }
+#endif
 
         stat = GdipClonePath(fill->path, &flat_path);
 
@@ -1859,6 +1876,16 @@
 
         stat = get_graphics_transform(graphics, WineCoordinateSpaceGdiDevice,
             CoordinateSpaceWorld, &world_to_device);
+#ifndef SG_MUTANT_PATHGRAD_NO_TRANSFORM_FOCUS
+        /* wine-sg 9203: the brush's transform maps the boundary and the centre into the world, as on
+         * Windows (an affine map keeps the gradient's linear interpolation exact) */
+        if (stat == Ok)
+        {
+            GpMatrix brush_to_world = fill->transform;
+            stat = GdipMultiplyMatrix(&brush_to_world, &world_to_device, MatrixOrderAppend);
+            if (stat == Ok) world_to_device = brush_to_world;
+        }
+#endif
         if (stat == Ok)
         {
             stat = GdipTransformPath(flat_path, &world_to_device);
@@ -2011,6 +2038,28 @@
 
                     distance = distance / center_distance;
 
+                    if (focus && distance < 1.0f)
+                    {
+                        /* the same distance for the point unscaled from the centre by the focus scales:
+                         * 1 - t_q, t_q the point's place between centre (0) and the scaled boundary (1);
+                         * along this ray the scaled boundary sits at t = t_p / t_q */
+                        REAL qx = center_point.X + (xf - center_point.X) / focus_x;
+                        REAL qy = center_point.Y + (yf - center_point.Y) / focus_y;
+                        REAL tq = 1.0f - ((end_point.Y - start_point.Y) * (start_point.X - qx) +
+                                (end_point.X - start_point.X) * (qy - start_point.Y)) / center_distance;
+                        REAL tp = 1.0f - distance;
+
+                        if (tq <= 1.0f)
+                            distance = 1.0f;
+                        else
+                        {
+                            REAL inner = tp / tq;
+                            distance = inner < 1.0f ? 1.0f - (tp - inner) / (1.0f - inner) : 0.0f;
+                        }
+                    }
+                    if (distance < 0.0f) distance = 0.0f;
+                    if (distance > 1.0f) distance = 1.0f;
+
                     argb_pixels[(x-fill_area->X) + (y-fill_area->Y)*cdwStride] =
                         path_gradient_color(fill, outer_color, distance);
                 }
