+/* Called once the sync reader has the source open. */
+static void async_reader_init_outputs(struct async_reader *reader)
+{
+    DWORD i, count = 0;
+
+    if (FAILED(IWMSyncReader2_GetOutputCount(reader->reader, &count)) || !count)
+        return;
+    if (!(reader->outputs = calloc(count, sizeof(*reader->outputs))))
+        return;
+    reader->output_count = count;
+
+    for (i = 0; i < count; i++)
+    {
+        IWMOutputMediaProps *props;
+        GUID type;
+        unsigned int j;
+
+        if (SUCCEEDED(IWMSyncReader2_GetOutputProps(reader->reader, i, &props)))
+        {
+            if (SUCCEEDED(IWMOutputMediaProps_GetType(props, &type)) && IsEqualGUID(&type, &WMMEDIATYPE_Video))
+                reader->outputs[i].kind = OUTPUT_VIDEO;
+            TRACE("output %lu: major type %s, kind %d\n", i, debugstr_guid(&type), reader->outputs[i].kind);
+            IWMOutputMediaProps_Release(props);
+        }
+        else
+            WARN("Failed to get the properties of output %lu.\n", i);
+#ifdef SG_MUTANT_WMV_KIND_AUDIO
+        reader->outputs[i].kind = OUTPUT_AUDIO;
+#endif
+        for (j = 0; j < SETTING_COUNT; j++)
+            reader->outputs[i].values[j] = output_settings[j].deflt;
+    }
+}
