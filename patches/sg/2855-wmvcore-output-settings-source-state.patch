+        return E_INVALIDARG;
+
+    EnterCriticalSection(&reader->cs);
+    if (!reader->callback_thread)
+        hr = E_UNEXPECTED;
+    else if (output_num >= reader->output_count || !(setting = find_output_setting(name, &id)))
