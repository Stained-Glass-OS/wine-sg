     len = lstrlenW(str);
-    cursor = editor->pCursors[0];
+    saved[0] = editor->pCursors[0];
+    saved[1] = editor->pCursors[1];
     cursor_from_char_ofs( editor, This->start, &editor->pCursors[0] );
+#ifndef SG_MUTANT_SETTEXT_SELECTION
+    /* the text goes in at the range, not over the selection (which the two cursors make) */
+    editor->pCursors[1] = editor->pCursors[0];
+#endif
