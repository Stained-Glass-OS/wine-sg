     ME_InsertTextFromCursor(editor, 0, str, len, style);
     ME_ReleaseStyle(style);
-    editor->pCursors[0] = cursor;
+    editor->pCursors[0] = saved[0];
+    editor->pCursors[1] = saved[1];
 
     if (len < This->end - This->start)
         textranges_update_ranges(This->child.reole, This->start + len, This->end, RANGE_UPDATE_DELETE);
     else
-        This->end = len - This->start;
+        This->end = This->start + len;
 
     return S_OK;
 }
@@ -2915,28 +2921,155 @@
     return textrange_copy_or_cut(me, This->child.reole->editor, FALSE, v);
 }
 
+/* The text a paste would bring: a data object the caller gives, or the clipboard.
+ * format 0 is whatever text there is; S_FALSE when there is none of the format. */
+static HRESULT textrange_paste_text(VARIANT *v, LONG format, BSTR *text)
+{
+    IDataObject *obj = NULL;
+    FORMATETC fmt = { CF_UNICODETEXT, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    STGMEDIUM medium;
+    HRESULT hr = S_FALSE;
+    BOOL want_wide = !format || format == CF_UNICODETEXT, want_ansi = !format || format == CF_TEXT;
+
+    if (text) *text = NULL;
+    if (format && format != CF_UNICODETEXT && format != CF_TEXT) return S_FALSE;
+
+    if (v && (V_VT(v) == VT_UNKNOWN || V_VT(v) == (VT_UNKNOWN | VT_BYREF)))
+    {
+        IUnknown *unk = V_VT(v) == VT_UNKNOWN ? V_UNKNOWN(v) : (V_UNKNOWNREF(v) ? *V_UNKNOWNREF(v) : NULL);
+        if (unk) IUnknown_QueryInterface(unk, &IID_IDataObject, (void **)&obj);
+    }
+
+    if (obj)
+    {
+        if (want_wide && IDataObject_GetData(obj, &fmt, &medium) == S_OK)
+        {
+            const WCHAR *src = GlobalLock(medium.hGlobal);
+            if (src && text) *text = SysAllocString(src);
+            hr = (!src || (text && !*text)) ? E_OUTOFMEMORY : S_OK;
+            GlobalUnlock(medium.hGlobal);
+            ReleaseStgMedium(&medium);
+        }
+        else if (want_ansi)
+        {
+            fmt.cfFormat = CF_TEXT;
+            if (IDataObject_GetData(obj, &fmt, &medium) == S_OK)
+            {
+                const char *src = GlobalLock(medium.hGlobal);
+                if (src && text)
+                {
+                    int len = MultiByteToWideChar(CP_ACP, 0, src, -1, NULL, 0);
+                    if ((*text = SysAllocStringLen(NULL, len - 1))) MultiByteToWideChar(CP_ACP, 0, src, -1, *text, len);
+                }
+                hr = (!src || (text && !*text)) ? E_OUTOFMEMORY : S_OK;
+                GlobalUnlock(medium.hGlobal);
+                ReleaseStgMedium(&medium);
+            }
+        }
+        IDataObject_Release(obj);
+        return hr;
+    }
+
+    if (!OpenClipboard(NULL)) return E_FAIL;
+    if (want_wide && IsClipboardFormatAvailable(CF_UNICODETEXT))
+    {
+        HANDLE h = GetClipboardData(CF_UNICODETEXT);
+        const WCHAR *src = h ? GlobalLock(h) : NULL;
+        if (src)
+        {
+            if (text && !(*text = SysAllocString(src))) hr = E_OUTOFMEMORY; else hr = S_OK;
+            GlobalUnlock(h);
+        }
+    }
+    else if (want_ansi && IsClipboardFormatAvailable(CF_TEXT))
+    {
+        HANDLE h = GetClipboardData(CF_TEXT);
+        const char *src = h ? GlobalLock(h) : NULL;
+        if (src)
+        {
+            int len = MultiByteToWideChar(CP_ACP, 0, src, -1, NULL, 0);
+            if (text && !(*text = SysAllocStringLen(NULL, len - 1))) hr = E_OUTOFMEMORY;
+            else
+            {
+                if (text) MultiByteToWideChar(CP_ACP, 0, src, -1, *text, len);
+                hr = S_OK;
+            }
+            GlobalUnlock(h);
+        }
+    }
+    CloseClipboard();
+    return hr;
+}
+
+static HRESULT textrange_paste(ITextRange *range, VARIANT *v, LONG format)
+{
+    BSTR text;
+    HRESULT hr;
+
+    if ((hr = textrange_paste_text(v, format, &text)) != S_OK) return hr == S_FALSE ? DV_E_FORMATETC : hr;
+    hr = ITextRange_SetText(range, text);
+    SysFreeString(text);
+    return hr;
+}
+
+static HRESULT textrange_canpaste(VARIANT *v, LONG format, LONG *ret)
+{
+    HRESULT hr;
+
+    if (!ret) return E_INVALIDARG;
+    hr = textrange_paste_text(v, format, NULL);
+    if (FAILED(hr)) return hr;
+#ifdef SG_MUTANT_RANGE_PASTE
+    *ret = tomFalse;
+#else
+    *ret = hr == S_OK ? tomTrue : tomFalse;
+#endif
+    return S_OK;
+}
+
+/* where the start or the end of a range is on the screen (or in the window with tomClientCoord) */
+static HRESULT textrange_point(ME_TextEditor *editor, LONG ofs, LONG type, LONG *cx, LONG *cy)
+{
+    ME_Cursor cursor;
+    POINT pt;
+    int x, y, height;
+
+    if (!cx || !cy) return E_INVALIDARG;
+    cursor_from_char_ofs( editor, ofs, &cursor );
+    cursor_coords( editor, &cursor, &x, &y, &height );
+    pt.x = x;
+    pt.y = y;
+    if (!(type & tomClientCoord))
+    {
+        if (!ITextHost_TxClientToScreen( editor->texthost, &pt )) return E_FAIL;
+    }
+    *cx = pt.x;
+    *cy = pt.y;
+    return S_OK;
+}
+
 static HRESULT WINAPI ITextRange_fnPaste(ITextRange *me, VARIANT *v, LONG format)
 {
     ITextRangeImpl *This = impl_from_ITextRange(me);
 
-    FIXME("(%p)->(%s %lx): stub\n", This, debugstr_variant(v), format);
