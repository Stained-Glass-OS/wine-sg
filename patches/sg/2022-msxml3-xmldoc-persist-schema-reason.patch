From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msxml3: XMLDocument persistence and schema validation reasons (2022)

msxml3: XMLDocument persistence and schema validation reasons (2022)

From Wine's todo_wine blocks, which record Windows: the old XMLDocument's
IPersistStreamInit::IsDirty is S_FALSE and Save writes the document (and
refuses a NULL stream); IXMLDOMDocument::validate against a schema hands
back a parse error that has a reason, the first message of the validation.
---
--- a/dlls/msxml3/xmldoc.c
+++ b/dlls/msxml3/xmldoc.c
@@ -580,8 +580,12 @@
 static HRESULT WINAPI xmldoc_IPersistStreamInit_IsDirty(
     IPersistStreamInit *iface)
 {
-    FIXME("(%p): stub!\n", iface);
-    return E_NOTIMPL;
+    TRACE("(%p)\n", iface);
+    /* the document is never modified through this interface */
+#ifdef SG_MUTANT_XMLDOC_DIRTY
+    return S_OK;
+#endif
+    return S_FALSE;
 }
 
 static xmlDocPtr parse_xml(char *ptr, int len)
@@ -648,8 +652,24 @@
 static HRESULT WINAPI xmldoc_IPersistStreamInit_Save(
     IPersistStreamInit *iface, LPSTREAM pStm, BOOL fClearDirty)
 {
-    FIXME("(%p, %p, %d): stub!\n", iface, pStm, fClearDirty);
-    return E_NOTIMPL;
+    xmldoc *This = impl_from_IPersistStreamInit(iface);
+    xmlChar *mem = NULL;
+    int size = 0;
+    ULONG written = 0;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %d)\n", iface, pStm, fClearDirty);
+
+    if (!pStm) return E_INVALIDARG;
+
+    xmlDocDumpMemory(This->xmldoc, &mem, &size);
+    if (!mem) return E_FAIL;
+#ifdef SG_MUTANT_XMLDOC_SAVE
+    size = 0;
+#endif
+    hr = IStream_Write(pStm, mem, size, &written);
+    xmlFree(mem);
+    return hr;
 }
 
 static HRESULT WINAPI xmldoc_IPersistStreamInit_GetSizeMax(
--- a/dlls/msxml3/schema.c
+++ b/dlls/msxml3/schema.c
@@ -273,9 +273,29 @@
     va_end(ap);
 }
 
+/* the first message of a validation that failed, for IXMLDOMParseError::reason */
+struct validate_reason { BSTR reason; };
+
 static void validate_serror(void* ctx, const xmlError* err)
 {
+    struct validate_reason *info = ctx;
+
     LIBXML2_CALLBACK_SERROR(Schema_validate_tree, err);
+
+#ifndef SG_MUTANT_SCHEMA_REASON
+    if (info && !info->reason && err && err->message)
+    {
+        int len = MultiByteToWideChar(CP_UTF8, 0, err->message, -1, NULL, 0);
+        WCHAR *text = malloc(len * sizeof(WCHAR));
+        if (text)
+        {
+            MultiByteToWideChar(CP_UTF8, 0, err->message, -1, text, len);
+            while (len > 1 && (text[len - 2] == '\n' || text[len - 2] == '\r')) text[--len - 1] = 0;
+            info->reason = SysAllocString(text);
+            free(text);
+        }
+    }
+#endif
 }
 
 static HRESULT schema_cache_get_item(IUnknown *iface, LONG index, VARIANT *item)
@@ -289,9 +309,10 @@
     NULL
 };
 
-static inline HRESULT Schema_validate_tree(xmlSchemaPtr schema, xmlNodePtr tree)
+static inline HRESULT Schema_validate_tree(xmlSchemaPtr schema, xmlNodePtr tree, BSTR *reason)
 {
     xmlSchemaValidCtxtPtr svctx;
+    struct validate_reason info = { NULL };
     int err;
 
     TRACE("(%p, %p)\n", schema, tree);
@@ -299,7 +320,7 @@
      *       we probably need to validate the schema here. */
     svctx = xmlSchemaNewValidCtxt(schema);
     xmlSchemaSetValidErrors(svctx, validate_error, validate_warning, NULL);
-    xmlSchemaSetValidStructuredErrors(svctx, validate_serror, NULL);
+    xmlSchemaSetValidStructuredErrors(svctx, validate_serror, &info);
 
     if (tree->type == XML_DOCUMENT_NODE)
         err = xmlSchemaValidateDoc(svctx, (xmlDocPtr)tree);
@@ -307,6 +328,8 @@
         err = xmlSchemaValidateOneElement(svctx, tree);
 
     xmlSchemaFreeValidCtxt(svctx);
+    if (reason) *reason = info.reason;
+    else SysFreeString(info.reason);
     return err? S_FALSE : S_OK;
 }
 
@@ -655,7 +678,7 @@
                 xmlSetNs(node, ns);
                 xmlDocSetRootElement(tmp_doc, node);
 
-                hr = Schema_validate_tree(datatypes_schema, (xmlNodePtr)tmp_doc);
+                hr = Schema_validate_tree(datatypes_schema, (xmlNodePtr)tmp_doc, NULL);
                 xmlFreeDoc(tmp_doc);
             }
             else
@@ -1605,7 +1628,7 @@
     return (decl != NULL)? decl->node : NULL;
 }
 
-HRESULT SchemaCache_validate_tree(IXMLDOMSchemaCollection2* iface, xmlNodePtr tree)
+HRESULT SchemaCache_validate_tree(IXMLDOMSchemaCollection2* iface, xmlNodePtr tree, BSTR *reason)
 {
     schema_cache* This = impl_from_IXMLDOMSchemaCollection2(iface);
     xmlSchemaPtr schema;
@@ -1622,7 +1645,7 @@
     /* TODO: if the ns is not in the cache, and it's a URL,
      *       do we try to load from that? */
     if (schema)
-        return Schema_validate_tree(schema, tree);
+        return Schema_validate_tree(schema, tree, reason);
     else
         WARN("no schema found for xmlns=%s\n", get_node_nsURI(tree));
 
