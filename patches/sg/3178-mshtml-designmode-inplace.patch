From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 09:13:26 -0700
Subject: [PATCH] mshtml: document.designMode='on' from a script edits in place

A script that set designMode = 'on' page-faulted: the call reloaded the page from
about:blank (the host's edit-mode switch) while the script's own window was still
running, and the script engine went on against a destroyed window. This predates
3177 (the 'on' path is unchanged apart from the design_mode field).

The document node now switches the loaded document to editing in place
(nsIDOMHTMLDocument::SetDesignMode, then the editor controller), keeping the
document and its script alive; execCommand and queryCommand work straight away.
The host-facing document object (IHTMLDocument2 on the object itself) keeps its
reload, which the conformance tests exercise, but reads and writes the node's
state: designMode now reads back On / Off / Inherit instead of a constant Off.

Gate: test/fastmshtmldm-gate.sh (mutant SG_MUTANT_MSHTML_DM_RELOAD).
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/mshtml/htmldoc.c b/dlls/mshtml/htmldoc.c
index 6c07e67..f182ec1 100644
--- a/dlls/mshtml/htmldoc.c
+++ b/dlls/mshtml/htmldoc.c
@@ -954,6 +954,33 @@ static HRESULT WINAPI HTMLDocument_put_designMode(IHTMLDocument2 *iface, BSTR v)
 
     This->design_mode = 1;
     doc_obj = This->doc_obj;
+    if(doc_obj->nscontainer->usermode == EDITMODE)
+        return S_OK;
+#ifdef SG_MUTANT_MSHTML_DM_RELOAD
+    if(0) {
+#else
+    if(This == doc_obj->doc_node && This->html_document) {
+#endif
+        /* Switch the loaded document to editing in place, the way a script
+         * expects (it keeps running against the same document). Reloading
+         * the page, as the host command does, would destroy the script's
+         * own window under it. */
+        nsAString mode_str;
+        nsresult nsres;
+
+        doc_obj->nscontainer->usermode = EDITMODE;
+        nsAString_InitDepend(&mode_str, L"on");
+        nsres = nsIDOMHTMLDocument_SetDesignMode(This->html_document, &mode_str);
+        nsAString_Finish(&mode_str);
+        if(NS_SUCCEEDED(nsres)) {
+            setup_editor_controller(doc_obj->nscontainer);
+            init_editor(This);
+            call_property_onchanged(&This->cp_container, DISPID_IHTMLDOCUMENT2_DESIGNMODE);
+            return S_OK;
+        }
+        WARN("SetDesignMode failed: %08lx\n", nsres);
+        doc_obj->nscontainer->usermode = BROWSEMODE;
+    }
     IUnknown_AddRef(doc_obj->outer_unk);
     hres = setup_edit_mode(doc_obj);
     IUnknown_Release(doc_obj->outer_unk);
diff --git a/dlls/mshtml/oleobj.c b/dlls/mshtml/oleobj.c
index 57eb7c6..df07765 100644
--- a/dlls/mshtml/oleobj.c
+++ b/dlls/mshtml/oleobj.c
@@ -2349,9 +2349,14 @@ static HRESULT WINAPI DocObjHTMLDocument2_put_designMode(IHTMLDocument2 *iface,
 
     TRACE("(%p)->(%s)\n", This, debugstr_w(v));
 
+    if(!v)
+        return E_INVALIDARG;
+
     if(wcsicmp(v, L"on")) {
-        FIXME("Unsupported arg %s\n", debugstr_w(v));
-        return E_NOTIMPL;
+        /* "off" and "inherit" leave the edit mode: handled by the document node */
+        if(!This->doc_node)
+            return E_UNEXPECTED;
+        return IHTMLDocument2_put_designMode(&This->doc_node->IHTMLDocument2_iface, v);
     }
 
     hres = setup_edit_mode(This);
@@ -2366,13 +2371,16 @@ static HRESULT WINAPI DocObjHTMLDocument2_get_designMode(IHTMLDocument2 *iface,
 {
     HTMLDocumentObj *This = impl_from_IHTMLDocument2(iface);
 
-    FIXME("(%p)->(%p) always returning Off\n", This, p);
+    TRACE("(%p)->(%p)\n", This, p);
 
     if(!p)
         return E_INVALIDARG;
 
-    *p = SysAllocString(L"Off");
-    return S_OK;
+    if(This->doc_node)
+        return IHTMLDocument2_get_designMode(&This->doc_node->IHTMLDocument2_iface, p);
+
+    *p = SysAllocString(This->nscontainer && This->nscontainer->usermode == EDITMODE ? L"On" : L"Inherit");
+    return *p ? S_OK : E_OUTOFMEMORY;
 }
 
 HTMLDOCUMENTOBJ_FWD_TO_NODE_1(HTMLDocument2, get_selection, IHTMLSelectionObject**)
