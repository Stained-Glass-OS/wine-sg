+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "winuser.h"
+#include "wincrypt.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(crypt);
+
+struct async_param
+{
+    struct list entry;
+    char *oid;            /* NULL when the parameter is named by an integer */
+    ULONG_PTR id;
+    void *value;
+    PFN_CRYPT_ASYNC_PARAM_FREE_FUNC free;
+};
+
+struct async_handle
+{
+    struct list entry;    /* in async_handles */
+    struct list params;
+};
+
+static struct list async_handles = LIST_INIT( async_handles );
+static CRITICAL_SECTION async_cs;
+static CRITICAL_SECTION_DEBUG async_cs_debug =
+{
+    0, 0, &async_cs,
+    { &async_cs_debug.ProcessLocksList, &async_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": async_cs") }
+};
+static CRITICAL_SECTION async_cs = { &async_cs_debug, -1, 0, 0, 0, 0 };
+
+static const char *debugstr_oid( const char *oid )
+{
+    if (IS_INTRESOURCE( oid )) return wine_dbg_sprintf( "#%Iu", (ULONG_PTR)oid );
+    return debugstr_a( oid );
+}
+
+static struct async_handle *find_handle( HCRYPTASYNC handle )
+{
+    struct async_handle *h;
+
+    LIST_FOR_EACH_ENTRY( h, &async_handles, struct async_handle, entry )
+        if (h == (struct async_handle *)handle) return h;
+    return NULL;
+}
+
+static BOOL name_matches( const struct async_param *p, const char *oid )
+{
+#ifdef SG_MUTANT_ASYNC_INTRES
+    if (IS_INTRESOURCE( oid )) return !p->oid;
+#else
+    if (IS_INTRESOURCE( oid )) return !p->oid && p->id == (ULONG_PTR)oid;
+#endif
+    return p->oid && !strcmp( p->oid, oid );
+}
+
+static void free_param( struct async_param *p )
+{
+    list_remove( &p->entry );
+#ifdef SG_MUTANT_ASYNC_NOFREE
+    if (0)
+#else
+    if (p->free)
+#endif
+        p->free( p->oid ? p->oid : (char *)p->id, p->value );
+    free( p->oid );
+    free( p );
+}
+
+/***********************************************************************
+ *           CryptCreateAsyncHandle (CRYPT32.@)
+ */
+BOOL WINAPI CryptCreateAsyncHandle( DWORD flags, HCRYPTASYNC *handle )
+{
+    struct async_handle *h;
+
+    TRACE( "(%08lx, %p)\n", flags, handle );
+
+    if (!handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(h = calloc( 1, sizeof(*h) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    list_init( &h->params );
+    EnterCriticalSection( &async_cs );
+    list_add_tail( &async_handles, &h->entry );
+    LeaveCriticalSection( &async_cs );
+    *handle = h;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           CryptSetAsyncParam (CRYPT32.@)
+ *
+ * Attaches a value under a name (an OID string or an integer). Setting a
+ * name again replaces the value, freeing the old one with its function.
+ */
+BOOL WINAPI CryptSetAsyncParam( HCRYPTASYNC handle, LPSTR oid, LPVOID value, PFN_CRYPT_ASYNC_PARAM_FREE_FUNC free_func )
+{
+    struct async_handle *h;
+    struct async_param *p, *old = NULL;
+
+    TRACE( "(%p, %s, %p, %p)\n", handle, debugstr_oid( oid ),
+           value, free_func );
+
+    if (!oid)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    EnterCriticalSection( &async_cs );
+#ifdef SG_MUTANT_ASYNC_HANDLE
+    if (!(h = (struct async_handle *)handle))
+#else
+    if (!(h = find_handle( handle )))
+#endif
+    {
+        LeaveCriticalSection( &async_cs );
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    LIST_FOR_EACH_ENTRY( p, &h->params, struct async_param, entry )
+        if (name_matches( p, oid )) { old = p; break; }
+
+    if (!(p = calloc( 1, sizeof(*p) )) || (!IS_INTRESOURCE( oid ) && !(p->oid = strdup( oid ))))
+    {
+        free( p );
+        LeaveCriticalSection( &async_cs );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    if (IS_INTRESOURCE( oid )) p->id = (ULONG_PTR)oid;
+    p->value = value;
+    p->free = free_func;
+    list_add_tail( &h->params, &p->entry );
+#ifdef SG_MUTANT_ASYNC_REPLACE
+    if (old) list_remove( &old->entry );
+#else
+    if (old) free_param( old );
+#endif
+    LeaveCriticalSection( &async_cs );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           CryptGetAsyncParam (CRYPT32.@)
+ */
+BOOL WINAPI CryptGetAsyncParam( HCRYPTASYNC handle, LPSTR oid, LPVOID *value, PFN_CRYPT_ASYNC_PARAM_FREE_FUNC *free_func )
+{
+    struct async_handle *h;
+    struct async_param *p;
+    BOOL ret = FALSE;
+
+    TRACE( "(%p, %s, %p, %p)\n", handle, debugstr_oid( oid ),
+           value, free_func );
+
+    if (!oid || !value)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    EnterCriticalSection( &async_cs );
+    if (!(h = find_handle( handle ))) SetLastError( ERROR_INVALID_HANDLE );
+    else
+    {
+#ifdef SG_MUTANT_ASYNC_GET
+        SetLastError( ERROR_SUCCESS ); ret = TRUE; *value = NULL;
+#else
+        SetLastError( ERROR_NOT_FOUND );
+#endif
+        LIST_FOR_EACH_ENTRY( p, &h->params, struct async_param, entry )
+        {
+            if (!name_matches( p, oid )) continue;
+            *value = p->value;
+            if (free_func) *free_func = p->free;
+            SetLastError( ERROR_SUCCESS );
+            ret = TRUE;
+            break;
+        }
+    }
+    LeaveCriticalSection( &async_cs );
+    return ret;
+}
+
+/***********************************************************************
+ *           CryptCloseAsyncHandle (CRYPT32.@)
+ *
+ * Frees every parameter with the function it was set with.
+ */
+BOOL WINAPI CryptCloseAsyncHandle( HCRYPTASYNC handle )
+{
+    struct async_handle *h;
+    struct async_param *p, *next;
+
+    TRACE( "(%p)\n", handle );
+
+    EnterCriticalSection( &async_cs );
+    if (!(h = find_handle( handle )))
+    {
+        LeaveCriticalSection( &async_cs );
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    list_remove( &h->entry );
+    LeaveCriticalSection( &async_cs );
+
+    LIST_FOR_EACH_ENTRY_SAFE( p, next, &h->params, struct async_param, entry ) free_param( p );
+    free( h );
+    return TRUE;
+}
