From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wsock32: GetTypeByName (3656)

wsock32: GetTypeByName

GetTypeByNameA/W return the SVCID_TCP or SVCID_UDP service type GUID of a service found
in the TCP, then UDP, services database.
---
diff --git a/dlls/wsock32/service.c b/dlls/wsock32/service.c
index 56a5740..33bdb33 100644
--- a/dlls/wsock32/service.c
+++ b/dlls/wsock32/service.c
@@ -183,6 +183,51 @@ INT WINAPI GetAddressByNameA(DWORD dwNameSpace, LPGUID lpServiceType, LPSTR lpSe
     return ret;
 }
 
+static INT get_type_by_name( const char *name, GUID *type )
+{
+    /* the service type GUIDs of the TCP and UDP services: Data1 = (0x9 or 0xa) << 16 | port,
+     * Data4 = C0 00 00 00 00 00 00 46 (svcguid.h) */
+    static const BYTE tail[8] = { 0xc0, 0, 0, 0, 0, 0, 0, 0x46 };
+    struct servent *service;
+    DWORD kind = 0x0009;
+
+    if (!name || !type)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return SOCKET_ERROR;
+    }
+
+#ifdef SG_MUTANT_WSOCK_UDPFIRST
+    if (!(service = getservbyname( name, "udp" )))
+    {
+        kind = 0x0009;
+        service = getservbyname( name, "tcp" );
+    }
+    else kind = 0x000a;
+#else
+    if (!(service = getservbyname( name, "tcp" )))
+    {
+        kind = 0x000a;
+        service = getservbyname( name, "udp" );
+    }
+#endif
+    if (!service)
+    {
+        SetLastError( ERROR_SERVICE_DOES_NOT_EXIST );
+        return SOCKET_ERROR;
+    }
+
+#ifdef SG_MUTANT_WSOCK_PORT
+    type->Data1 = (kind << 16) | service->s_port;
+#else
+    type->Data1 = (kind << 16) | ntohs( service->s_port );
+#endif
+    type->Data2 = 0;
+    type->Data3 = 0;
+    memcpy( type->Data4, tail, sizeof(tail) );
+    return 0;
+}
+
 /******************************************************************************
  *          GetTypeByNameA     [WSOCK32.1113]
  *
@@ -200,17 +245,14 @@ INT WINAPI GetAddressByNameA(DWORD dwNameSpace, LPGUID lpServiceType, LPSTR lpSe
  *      Obsolete Microsoft-specific extension to Winsock 1.1.
  *      Protocol-independent name resolution provides equivalent functionality in Winsock 2.
  *
- * BUGS
- *      Unimplemented
+ * NOTES (continued)
+ *      The TCP services database is searched first, then the UDP one.
  */
 INT WINAPI GetTypeByNameA(LPSTR lpServiceName, LPGUID lpServiceType)
 {
-   /* tell the user they've got a substandard implementation */
-   FIXME("wsock32: GetTypeByNameA(%p, %p): stub\n", lpServiceName, lpServiceType);
-   
-   /* some programs may be able to compensate if they know what happened */
-   SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-   return SOCKET_ERROR; /* error value */
+    TRACE( "(%s, %p)\n", debugstr_a(lpServiceName), lpServiceType );
+
+    return get_type_by_name( lpServiceName, lpServiceType );
 }
 
 
@@ -221,12 +263,16 @@ INT WINAPI GetTypeByNameA(LPSTR lpServiceName, LPGUID lpServiceType)
  */
 INT WINAPI GetTypeByNameW(LPWSTR lpServiceName, LPGUID lpServiceType)
 {
-    /* tell the user they've got a substandard implementation */
-    FIXME("wsock32: GetTypeByNameW(%p, %p): stub\n", lpServiceName, lpServiceType);
-    
-    /* some programs may be able to compensate if they know what happened */
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return SOCKET_ERROR; /* error value */
+    char name[256];
+
+    TRACE( "(%s, %p)\n", debugstr_w(lpServiceName), lpServiceType );
+
+    if (!lpServiceName || !WideCharToMultiByte( CP_ACP, 0, lpServiceName, -1, name, sizeof(name), NULL, NULL ))
+    {
+        SetLastError( lpServiceName ? ERROR_SERVICE_DOES_NOT_EXIST : ERROR_INVALID_PARAMETER );
+        return SOCKET_ERROR;
+    }
+    return get_type_by_name( name, lpServiceType );
 }
 
 /******************************************************************************
