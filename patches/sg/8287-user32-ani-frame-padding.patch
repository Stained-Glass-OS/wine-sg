From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] user32: animated cursor frames after an odd-sized one are read

RIFF pads a chunk of odd size to an even size. riff_find_chunk knows it, but the loop over an animated cursor's frames did not: after a frame of odd size it read the next one a byte early, did not find a cursor there and read through a NULL entry (a crash), or kept only the first frame. The loop now pads, and a frame that is not a cursor fails like any bad frame.
---
--- a/dlls/user32/cursoricon.c
+++ b/dlls/user32/cursoricon.c
@@ -1453,6 +1453,14 @@
         entry = CURSORICON_FindBestIconFile((const CURSORICONFILEDIR *) icon_data,
                                             bits + bits_size - icon_data,
                                             width, height, depth, loadflags );
+#ifndef SG_MUTANT_ANI_NO_PAD
+        /* (wine-sg 8287) a frame that is not a cursor/icon fails like a bad one, not by a NULL read */
+        if (!entry)
+        {
+            error = TRUE;
+            goto frame_done;
+        }
+#endif
 
         hotspot.x = entry->xHotspot;
         hotspot.y = entry->yHotspot;
@@ -1475,6 +1483,9 @@
                                         is_icon, frameWidth, frameHeight, loadflags, &desc.frames[i] );
         }
 
+#ifndef SG_MUTANT_ANI_NO_PAD
+frame_done:
+#endif
         if (error)
         {
             if (i == 0)
@@ -1493,7 +1504,12 @@
         }
 
         /* Advance to the next chunk */
+#ifndef SG_MUTANT_ANI_NO_PAD
+        /* (wine-sg 8287) RIFF pads a chunk of odd size to an even one, as riff_find_chunk knows */
+        icon_chunk += ((chunk_size + 1) & ~1) + (2 * sizeof(DWORD));
+#else
         icon_chunk += chunk_size + (2 * sizeof(DWORD));
+#endif
         icon_data = icon_chunk + (2 * sizeof(DWORD));
     }
 
