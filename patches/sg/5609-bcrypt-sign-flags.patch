From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: BCryptSignHash rejects flags the algorithm does not take

bcrypt: BCryptSignHash rejects flags the algorithm does not take

Only BCRYPT_PAD_PKCS1 and BCRYPT_PAD_PSS are valid sign flags, and PSS only
for RSA keys.
---
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -2537,6 +2537,20 @@ static NTSTATUS key_asymmetric_sign( void *args )
     NTSTATUS status;
     int ret;
 
+    /* the flags allowed depend on the key: none, PKCS1 and PSS exist, and PSS is for RSA keys */
+    if (flags && flags != BCRYPT_PAD_PKCS1 && flags != BCRYPT_PAD_PSS)
+    {
+        WARN( "invalid flags %#x\n", flags );
+        return STATUS_INVALID_PARAMETER;
+    }
+#ifndef SG_MUTANT_SIGN_PSS_NONRSA
+    if (flags == BCRYPT_PAD_PSS && key->alg_id != ALG_ID_RSA && key->alg_id != ALG_ID_RSA_SIGN)
+    {
+        WARN( "BCRYPT_PAD_PSS not supported for key algorithm %u\n", key->alg_id );
+        return STATUS_INVALID_PARAMETER;
+    }
+#endif
+
     if (key->alg_id == ALG_ID_ECDSA_P256 || key->alg_id == ALG_ID_ECDSA_P384)
     {
         /* With ECDSA, we find the digest algorithm from the hash length, and verify it */
@@ -2596,11 +2610,6 @@ static NTSTATUS key_asymmetric_sign( void *args )
             WARN( "padding info not found\n" );
             return STATUS_INVALID_PARAMETER;
         }
-        if (key->alg_id != ALG_ID_RSA && key->alg_id != ALG_ID_RSA_SIGN)
-        {
-            FIXME( "BCRYPT_PAD_PSS not supported for key algorithm %u\n", key->alg_id );
-            return STATUS_NOT_SUPPORTED;
-        }
         if ((hash_alg = get_digest_from_id( pad->pszAlgId )) == GNUTLS_DIG_UNKNOWN)
         {
             FIXME( "hash algorithm %s not recognized\n", debugstr_w(pad->pszAlgId) );
@@ -2610,16 +2619,11 @@ static NTSTATUS key_asymmetric_sign( void *args )
         if ((status = privkey_set_rsa_pss_params( key_data(key)->a.privkey, hash_alg, pad->cbSalt ))) return status;
         gnutls_flags = GNUTLS_PRIVKEY_SIGN_FLAG_RSA_PSS;
     }
-    else if (!flags)
+    else
     {
          WARN( "invalid flags %#x\n", flags );
          return STATUS_INVALID_PARAMETER;
     }
-    else
-    {
-        FIXME( "flags %#x not implemented\n", flags );
-        return STATUS_NOT_IMPLEMENTED;
-    }
 
     if (!params->output)
     {
--- a/dlls/bcrypt/tests/bcrypt.c
+++ b/dlls/bcrypt/tests/bcrypt.c
@@ -3472,6 +3472,16 @@ static void test_BCryptSignHash(void)
     ok(!ret, "got %#lx\n", ret);
     ok(len == 256, "got %lu\n", len);
 
+    /* the flags are none, BCRYPT_PAD_PKCS1 and BCRYPT_PAD_PSS: anything else is a bad parameter */
+    ret = BCryptSignHash(key, &pad, NULL, 0, NULL, 0, &len, 0x10);
+    ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+    ret = BCryptSignHash(key, &pad, NULL, 0, NULL, 0, &len, BCRYPT_PAD_PKCS1 | BCRYPT_PAD_PSS);
+    ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+    ret = BCryptSignHash(key, &pad, NULL, 0, NULL, 0, &len, BCRYPT_PAD_NONE);
+    ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+    ret = BCryptSignHash(key, &pad, NULL, 0, NULL, 0, &len, 0);
+    ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+
     /* test len return when only output is NULL, as described in BCryptSignHash doc */
     ret = BCryptSignHash(key, &pad, hash, sizeof(hash), NULL, 0, &len, BCRYPT_PAD_PKCS1);
     ok(!ret, "got %#lx\n", ret);
@@ -3555,6 +3565,18 @@ static void test_BCryptSignHash(void)
     ret  = BCryptSignHash(key, &pad, hash_sha256, sizeof(hash_sha256), sig, sizeof(sig), &len, BCRYPT_PAD_PKCS1);
     ok (ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
 
+    /* PSS is for RSA keys, and no other flag exists */
+    {
+        BCRYPT_PSS_PADDING_INFO pad_pss = { BCRYPT_SHA256_ALGORITHM, 32 };
+
+        ret = BCryptSignHash(key, &pad_pss, hash_sha256, sizeof(hash_sha256), sig, sizeof(sig), &len, BCRYPT_PAD_PSS);
+        ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+        ret = BCryptSignHash(key, NULL, hash_sha256, sizeof(hash_sha256), sig, sizeof(sig), &len, 0x1234);
+        ok(ret == STATUS_INVALID_PARAMETER, "got %#lx\n", ret);
+        ret = BCryptSignHash(key, NULL, hash_sha256, sizeof(hash_sha256), sig, sizeof(sig), &len, 0);
+        ok(ret == STATUS_SUCCESS, "got %#lx\n", ret);
+    }
+
     ret = BCryptDestroyKey(key);
     ok(!ret, "got %#lx\n", ret);
 
