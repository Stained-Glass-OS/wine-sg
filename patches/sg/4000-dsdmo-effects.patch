+/* Sample conversion: the effects work on floats in [-1, 1]. */
+static void effect_to_float(const WAVEFORMATEX *format, const BYTE *data, float *out, DWORD samples)
+{
+    DWORD i;
+
+    if (format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+        memcpy(out, data, samples * sizeof(float));
+    else if (format->wBitsPerSample == 16)
+        for (i = 0; i < samples; ++i) out[i] = ((const short *)data)[i] / 32768.0f;
+    else
+        for (i = 0; i < samples; ++i) out[i] = (data[i] - 128) / 128.0f;
+}
+
+static void effect_from_float(const WAVEFORMATEX *format, const float *in, BYTE *data, DWORD samples)
+{
+    DWORD i;
+    float v;
+
+    if (format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT)
+        memcpy(data, in, samples * sizeof(float));
+    else if (format->wBitsPerSample == 16)
+    {
+        for (i = 0; i < samples; ++i)
+        {
+            v = in[i] * 32768.0f;
+            ((short *)data)[i] = v >= 32767.0f ? 32767 : v <= -32768.0f ? -32768 : (short)lrintf(v);
+        }
+    }
+    else
+    {
+        for (i = 0; i < samples; ++i)
+        {
+            v = in[i] * 128.0f + 128.0f;
+            data[i] = v >= 255.0f ? 255 : v <= 0.0f ? 0 : (BYTE)lrintf(v);
+        }
+    }
+}
+
+static float effect_get_param(struct effect *effect, const struct effect_param *param)
+{
+    BYTE *params = effect->ops->params(effect);
+
+    if (param->integer)
+        return *(LONG *)(params + param->offset);
+    return *(float *)(params + param->offset);
+}
+
+static void effect_set_param(struct effect *effect, const struct effect_param *param, float value)
+{
+    BYTE *params = effect->ops->params(effect);
+
+    if (param->integer)
+        *(LONG *)(params + param->offset) = lrintf(value);
+    else
+        *(float *)(params + param->offset) = value;
+}
+
+static BOOL effect_param_valid(const struct effect_param *param, float value)
+{
+    return value >= param->min && value <= param->max;
+}
+
+/* Value of an envelope at "time", or FALSE when the envelope does not cover it. */
+static BOOL envelope_value(const struct envelope *envelope, REFERENCE_TIME time, float *value)
+{
+    const MP_ENVELOPE_SEGMENT *segment;
+    double x;
+    DWORD i;
+
+    for (i = 0; i < envelope->count; ++i)
+    {
+        segment = &envelope->segments[i];
+        if (time < segment->rtStart || time > segment->rtEnd)
+            continue;
+
+        x = segment->rtEnd > segment->rtStart ? (double)(time - segment->rtStart) / (segment->rtEnd - segment->rtStart) : 1.0;
+        switch (segment->iCurve)
+        {
+            case MP_CURVE_JUMP: x = 1.0; break;
+            case MP_CURVE_LINEAR: break;
+            case MP_CURVE_SQUARE: x = x * x; break;
+            case MP_CURVE_INVSQUARE: x = sqrt(x); break;
+            case MP_CURVE_SINE: x = (1.0 - cos(x * M_PI)) / 2.0; break;
+        }
+        *value = segment->valStart + (segment->valEnd - segment->valStart) * x;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* Called with the lock held: applies the envelopes at "time" to the parameters. */
+/* New parameter values take effect without cutting off what is playing. */
+static void effect_params_changed(struct effect *effect)
+{
+    if (effect->ops->update)
+        effect->ops->update(effect);
+}
+
+static void effect_apply_envelopes(struct effect *effect, REFERENCE_TIME time)
+{
+    const struct effect_param *param;
+    BOOL changed = FALSE;
+    float value;
+    DWORD i;
+
+    if (!effect->envelopes)
+        return;
+
+    for (i = 0; i < effect->ops->param_count; ++i)
+    {
+        param = &effect->ops->param_info[i];
+        if (!envelope_value(&effect->envelopes[i], time, &value))
+            continue;
+        value = max(param->min, min(param->max, value));
+        if (value != effect_get_param(effect, param))
+        {
+            effect_set_param(effect, param, value);
+            changed = TRUE;
+        }
+    }
+
+    if (changed && effect->format.nSamplesPerSec)
+        effect_params_changed(effect);
+}
+
+/* Called with the lock held. */
+static void effect_process_data(struct effect *effect, BYTE *data, DWORD size, REFERENCE_TIME time, BOOL time_valid)
+{
+    DWORD frames, samples, chunk;
+    unsigned int channels;
+    float buffer[4096];
+
+    if (!effect->format.nBlockAlign)
+        return;
+
+    if (time_valid)
+        effect_apply_envelopes(effect, time);
+
+    channels = effect->format.nChannels;
+    frames = size / effect->format.nBlockAlign;
+    while (frames)
+    {
+        chunk = min(frames, ARRAY_SIZE(buffer) / channels);
+        samples = chunk * channels;
+        effect_to_float(&effect->format, data, buffer, samples);
+        effect->ops->process(effect, buffer, chunk, channels);
+        effect_from_float(&effect->format, buffer, data, samples);
+        data += chunk * effect->format.nBlockAlign;
+        frames -= chunk;
+    }
+}
