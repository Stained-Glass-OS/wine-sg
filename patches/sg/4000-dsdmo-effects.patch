+
+static HRESULT effect_init_media_type(const WAVEFORMATEX *format, DMO_MEDIA_TYPE *type)
+{
+    memset(type, 0, sizeof(*type));
+    if (!(type->pbFormat = CoTaskMemAlloc(sizeof(*format))))
+        return E_OUTOFMEMORY;
+    memcpy(type->pbFormat, format, sizeof(*format));
+    ((WAVEFORMATEX *)type->pbFormat)->cbSize = 0;
+    type->cbFormat = sizeof(*format);
+    type->majortype = MEDIATYPE_Audio;
+    type->subtype = format->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ? MEDIASUBTYPE_IEEE_FLOAT : MEDIASUBTYPE_PCM;
+    type->formattype = FORMAT_WaveFormatEx;
+    type->bFixedSizeSamples = TRUE;
+    type->lSampleSize = format->nBlockAlign;
+    return S_OK;
 }
 
