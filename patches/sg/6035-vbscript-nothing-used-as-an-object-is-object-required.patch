From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vbscript: Nothing used as an object is "Object required" (6035)

x(0) with x Nothing called a NULL dispatch and crashed the script host;
a property, assignment, Set or method of Nothing failed with E_FAIL.
Each is now VBScript's error 424, "Object required", which On Error
Resume Next skips.
---
diff --git a/dlls/vbscript/interp.c b/dlls/vbscript/interp.c
index 2c242c4..595c264 100644
--- a/dlls/vbscript/interp.c
+++ b/dlls/vbscript/interp.c
@@ -605,6 +605,11 @@ static HRESULT variant_call(exec_ctx_t *ctx, VARIANT *v, unsigned arg_cnt, VARIA
         array = V_ARRAY(v);
         break;
     case VT_DISPATCH:
+        /* Stained Glass OS: Nothing called with arguments is an error, not a NULL dispatch call */
+#ifndef SG_MUTANT_VBS_NOTHING_CALL
+        if(!V_DISPATCH(v))
+            return MAKE_VBSERROR(VBSE_OBJECT_REQUIRED);
+#endif
         vbstack_to_dp(ctx, arg_cnt, FALSE, &dp);
         hres = disp_call(ctx->script, V_DISPATCH(v), DISPID_VALUE, &dp, res);
         break;
@@ -799,8 +804,9 @@ static HRESULT do_mcall(exec_ctx_t *ctx, VARIANT *res)
         return hres;
 
     if(!obj) {
-        FIXME("NULL obj\n");
-        return E_FAIL;
+        /* Stained Glass OS: a member of Nothing: "Object required" */
+        WARN("NULL obj\n");
+        return MAKE_VBSERROR(VBSE_OBJECT_REQUIRED);
     }
 
     vbstack_to_dp(ctx, arg_cnt, FALSE, &dp);
@@ -1033,8 +1039,9 @@ static HRESULT interp_assign_member(exec_ctx_t *ctx)
         return hres;
 
     if(!obj) {
-        FIXME("NULL obj\n");
-        return E_FAIL;
+        /* Stained Glass OS: a member of Nothing: "Object required" */
+        WARN("NULL obj\n");
+        return MAKE_VBSERROR(VBSE_OBJECT_REQUIRED);
     }
 
     hres = disp_get_id(obj, identifier, VBDISP_LET, FALSE, &id);
@@ -1065,8 +1072,9 @@ static HRESULT interp_set_member(exec_ctx_t *ctx)
         return hres;
 
     if(!obj) {
-        FIXME("NULL obj\n");
-        return E_FAIL;
+        /* Stained Glass OS: a member of Nothing: "Object required" */
+        WARN("NULL obj\n");
+        return MAKE_VBSERROR(VBSE_OBJECT_REQUIRED);
     }
 
     hres = stack_assume_disp(ctx, arg_cnt, NULL);
