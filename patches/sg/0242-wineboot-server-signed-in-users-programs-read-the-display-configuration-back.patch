From: Stained Glass OS <dev@stained-glass.example>
Subject: wineboot, server: signed-in users' programs read the display configuration back

win32u records the adapters, sources and modes it finds under
HKLM\HARDWARE\DEVICEMAP\VIDEO and Hardware Profiles\Current\System\
CurrentControlSet\Control\Video, then reads them back. In a shared (system)
prefix HKLM is administrators-write, and the machine's own first process runs
on the services' window station, which records no display: nobody who may
create those containers ever did, and a signed-in user -- even an
administrator, whose token is filtered -- cannot create them. Every program
logged "Failed to read display config": Settings offered a "0 x 0" resolution
and nothing else, and DirectDraw's primary surface failed, so Media Player's
video renderer crashed on any video.

wineboot, which runs as SYSTEM when the machine server starts, now creates
them (volatile, like the rest of HARDWARE), and the server gives keys named
...\DEVICEMAP\VIDEO the user-writable DACL 0011 gives \Control\Video (the
profile path already matches that). The rest of HKLM\HARDWARE\DEVICEMAP stays
administrators-only.

Found by the 2026-09-26 ISO QA pass. Gate: test/dispcfg-gate.sh
(make test-dispcfg): a standard user's program on its own desktop gets
1280x800 and the screen's modes; without the wineboot half it gets 0 x 0,
without the server half no modes.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -485,12 +485,16 @@
 {
     static const WCHAR videoW[] = {'\\','C','o','n','t','r','o','l','\\','V','i','d','e','o'};
     static const WCHAR gfxW[]   = {'\\','C','o','n','t','r','o','l','\\','G','r','a','p','h','i','c','s','D','r','i','v','e','r','s'};
+    /* HKLM\HARDWARE\DEVICEMAP\VIDEO: which source is which, read by every
+     * program's display setup (wine-sg 0242) */
+    static const WCHAR mapW[]   = {'\\','D','E','V','I','C','E','M','A','P','\\','V','I','D','E','O'};
     data_size_t chars = len / sizeof(WCHAR), i;
 
     for (i = 0; i + ARRAY_SIZE(videoW) <= chars; i++)
     {
         if (!memicmp_strW( name + i, videoW, sizeof(videoW) )) return 1;
         if (i + ARRAY_SIZE(gfxW) <= chars && !memicmp_strW( name + i, gfxW, sizeof(gfxW) )) return 1;
+        if (i + ARRAY_SIZE(mapW) <= chars && !memicmp_strW( name + i, mapW, sizeof(mapW) )) return 1;
     }
     return 0;
 }
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -954,6 +954,45 @@
 }
 
 /* create the volatile hardware registry keys */
+/* Stained Glass OS: the display setup's volatile containers.
+ *
+ * Every program's win32u records the adapters, sources and modes it found
+ * under HKLM\HARDWARE\DEVICEMAP\VIDEO and Hardware Profiles\Current\System\
+ * CurrentControlSet\Control\Video, then reads them back. In a shared (system)
+ * prefix HKLM is administrators-write: a signed-in user -- even an
+ * administrator, whose token is filtered -- cannot create these containers
+ * under the administrator-owned parents, so the read-back failed ("Failed to
+ * read display config"): no current mode (0 x 0), one resolution, and
+ * DirectDraw's primary surface (Media Player's video renderer) failing. This
+ * wineboot runs as the machine's SYSTEM account when the machine server
+ * starts, so it creates them each boot (they are volatile, like the rest of
+ * HARDWARE); the server gives keys under these names a DACL signed-in users
+ * may write (wine-sg 0011, 0242). */
+static void create_display_config_keys(void)
+{
+    static const WCHAR *keys[] =
+    {
+        L"HARDWARE\\DEVICEMAP\\VIDEO",
+        L"System\\CurrentControlSet\\Hardware Profiles\\Current\\System",
+        L"System\\CurrentControlSet\\Hardware Profiles\\Current\\System\\CurrentControlSet",
+        L"System\\CurrentControlSet\\Hardware Profiles\\Current\\System\\CurrentControlSet\\Control",
+        L"System\\CurrentControlSet\\Hardware Profiles\\Current\\System\\CurrentControlSet\\Control\\Video",
+    };
+    unsigned int i;
+    HKEY key;
+
+    for (i = 0; i < ARRAY_SIZE(keys); i++)
+    {
+        if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, keys[i], 0, NULL, REG_OPTION_VOLATILE,
+                             KEY_ALL_ACCESS, NULL, &key, NULL ))
+        {
+            WARN( "cannot create %s\n", debugstr_w(keys[i]) );
+            break;
+        }
+        RegCloseKey( key );
+    }
+}
+
 static void create_hardware_registry_keys(void)
 {
     HKEY system_key, bios_key;
@@ -1994,6 +2033,7 @@
 
     create_user_shared_data();
     create_hardware_registry_keys();
+    create_display_config_keys();
     create_dynamic_registry_keys();
     create_computer_name_keys();
     wininit();
