From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: startup programs from the shell's own thread, and lasting keys

Two faults of 0754's startup programs:

- They ran on a thread of their own. A new thread is on the process's
  default desktop from the moment it starts, before any of its code runs;
  Wine started a second explorer to manage that desktop and the shell's
  message loop ended -- a black screen in the gates, a stray
  "explorer.exe /desktop" on the QA VM. They now run from a one-shot timer
  on the shell's thread, which is on its desktop and has OLE already.

- The sign-in's mark is a volatile key, Software\Stained Glass\Explorer\
  Session; made where Software\Stained Glass or ...\Explorer was missing (a
  new profile), it made them volatile too, and no lasting key could be made
  under them any more (ERROR_CHILD_MUST_BE_VOLATILE): settings kept there
  did not save. The parents are made as ordinary keys first.

Gates: test/signin-startup-gate.sh (settings under Software\Stained Glass
still save -- mutant SG_MUTANT_VOLATILE_PARENTS fails it; the shell still
there), test/taskview-linux-gate.sh (mutant SG_MUTANT_STARTUP_THREAD fails
it: the shell was gone).
---
--- a/programs/explorer/startup.c
+++ b/programs/explorer/startup.c
@@ -50,7 +50,8 @@
 #define RUN_KEY      L"Software\\Microsoft\\Windows\\CurrentVersion\\Run"
 #define RUNONCE_KEY  L"Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce"
 #define APPROVED_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved"
-#define SESSION_KEY  L"Software\\Stained Glass\\Explorer\\Session"
+#define SESSION_PARENT L"Software\\Stained Glass\\Explorer"
+#define SESSION_KEY  SESSION_PARENT L"\\Session"
 
 /* turned off in Task Manager's Startup tab: StartupApproved\SUB has the value
  * with an odd first byte (Windows writes 02 on, 03 off); absent is on. The
@@ -175,6 +176,14 @@
     return TRUE;
 #endif
     if (!GetEnvironmentVariableW( L"XDG_SESSION_ID", id, ARRAY_SIZE(id) )) lstrcpyW( id, L"-" );
+    /* the parents first, as ordinary keys: a volatile key made where they
+     * are missing makes them volatile too, and no lasting key can then be
+     * made under them (ERROR_CHILD_MUST_BE_VOLATILE) -- every setting kept
+     * under Software\Stained Glass failed to save on a new profile */
+#ifndef SG_MUTANT_VOLATILE_PARENTS
+    if (!RegCreateKeyExW( HKEY_CURRENT_USER, SESSION_PARENT, 0, NULL, 0, KEY_READ, NULL, &key, NULL ))
+        RegCloseKey( key );
+#endif
     if (RegCreateKeyExW( HKEY_CURRENT_USER, SESSION_KEY, 0, NULL, REG_OPTION_VOLATILE, KEY_READ | KEY_SET_VALUE,
                          NULL, &key, NULL ))
         return TRUE;
@@ -184,13 +193,15 @@
     return first;
 }
 
-static DWORD WINAPI startup_thread( void *arg )
+/* On the shell's own thread, from a timer: a thread of its own was on the
+ * process's default desktop the moment it started, Wine started a second
+ * explorer to manage that one, and the shell ended (a black screen in the
+ * gates). The thread has OLE already (drag and drop). */
+static void CALLBACK startup_timer( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
 {
     BOOL wow64 = FALSE;
 
-    /* the desktop and the taskbar first, as Windows starts them after the shell */
-    Sleep( 2000 );
-    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    KillTimer( NULL, id );
     run_once();
     run_key( HKEY_LOCAL_MACHINE, KEY_WOW64_64KEY, L"Run" );
     if (sizeof(void *) == 8 || (IsWow64Process( GetCurrentProcess(), &wow64 ) && wow64))
@@ -198,13 +209,13 @@
     run_key( HKEY_CURRENT_USER, 0, L"Run" );
     run_folder( CSIDL_COMMON_STARTUP, HKEY_LOCAL_MACHINE );
     run_folder( CSIDL_STARTUP, HKEY_CURRENT_USER );
-    CoUninitialize();
-    return 0;
 }
 
 void run_startup_programs(void)
 {
+#ifdef SG_MUTANT_STARTUP_THREAD
     HANDLE thread;
+#endif
 
 #ifdef SG_MUTANT_NO_STARTUP
     return;
@@ -214,5 +225,9 @@
         TRACE( "this sign-in's startup programs ran already\n" );
         return;
     }
-    if ((thread = CreateThread( NULL, 0, startup_thread, NULL, 0, NULL ))) CloseHandle( thread );
+    /* the desktop and the taskbar first, as Windows starts them after the shell */
+#ifdef SG_MUTANT_STARTUP_THREAD
+    if ((thread = CreateThread( NULL, 0, (LPTHREAD_START_ROUTINE)Sleep, (void *)2000, 0, NULL ))) CloseHandle( thread );
+#endif
+    SetTimer( NULL, 0, 2000, startup_timer );
 }
