+static HRESULT media_player_get_audio_volume(const struct media_player *player, IMFSimpleAudioVolume **volume)
+{
+    return MFGetService((IUnknown *)player->session, &MR_POLICY_VOLUME_SERVICE, &IID_IMFSimpleAudioVolume,
+            (void **)volume);
+}
+
+/* Hands the volume and mute state to the audio renderer, when the session has one. */
+static void media_player_apply_audio_volume(const struct media_player *player)
+{
+    IMFSimpleAudioVolume *volume;
+
+    if (SUCCEEDED(media_player_get_audio_volume(player, &volume)))
+    {
+        IMFSimpleAudioVolume_SetMasterVolume(volume, player->volume);
+        IMFSimpleAudioVolume_SetMute(volume, player->mute);
+        IMFSimpleAudioVolume_Release(volume);
+    }
+}
