+/***********************************************************************
+ *      DllGetClassObject (mfplay.@)
+ */
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **obj)
+{
+    TRACE("%s, %s, %p.\n", debugstr_guid(clsid), debugstr_guid(riid), obj);
+
+    if (!obj)
+        return E_POINTER;
+
+    /* No class is created through a class factory: players come from MFPCreateMediaPlayer(). */
+    *obj = NULL;
+
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
 static void media_player_register_window_class(void)
 {
     WNDCLASSW cls = { 0 };
