 static HRESULT WINAPI media_player_InsertEffect(IMFPMediaPlayer *iface, IUnknown *effect,
         BOOL optional)
 {
-    FIXME("%p, %p, %d.\n", iface, effect, optional);
+    struct media_player *player = impl_from_IMFPMediaPlayer(iface);
+    IUnknown *unk;
+    HRESULT hr;
+    size_t i;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %d.\n", iface, effect, optional);
+
+    if (!effect)
+        return E_POINTER;
+
+    /* An effect is an MFT or an activator for one. */
+    if (SUCCEEDED(IUnknown_QueryInterface(effect, &IID_IMFTransform, (void **)&unk)))
+        IUnknown_Release(unk);
+    else if (SUCCEEDED(IUnknown_QueryInterface(effect, &IID_IMFActivate, (void **)&unk)))
+        IUnknown_Release(unk);
+    else
+        return E_INVALIDARG;
+
+    EnterCriticalSection(&player->cs);
+    if (player->state == MFP_MEDIAPLAYER_STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        hr = S_OK;
+        for (i = 0; i < player->effect_count; ++i)
+        {
+#ifndef SG_MUTANT_MFP_EFFECT_DUP
+            if (player->effects[i].object == effect)
+            {
+                hr = MF_E_INVALIDREQUEST;
+                break;
+            }
+#endif
+        }
+        if (hr == S_OK)
+        {
+            void *ptr = realloc(player->effects, (player->effect_count + 1) * sizeof(*player->effects));
+
+            if (!ptr)
+                hr = E_OUTOFMEMORY;
+            else
+            {
+                player->effects = ptr;
+                player->effects[player->effect_count].object = effect;
+                player->effects[player->effect_count].optional = !!optional;
+                IUnknown_AddRef(effect);
+                player->effect_count++;
+            }
+        }
+    }
+    LeaveCriticalSection(&player->cs);
+
+    return hr;
 }
 
 static HRESULT WINAPI media_player_RemoveEffect(IMFPMediaPlayer *iface, IUnknown *effect)
 {
-    FIXME("%p, %p.\n", iface, effect);
+    struct media_player *player = impl_from_IMFPMediaPlayer(iface);
+    HRESULT hr;
+    size_t i;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p.\n", iface, effect);
+
+    if (!effect)
+        return E_POINTER;
+
+    EnterCriticalSection(&player->cs);
+    if (player->state == MFP_MEDIAPLAYER_STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else
+    {
+        hr = MF_E_NOT_FOUND;
+        for (i = 0; i < player->effect_count; ++i)
+        {
+            if (player->effects[i].object == effect)
+            {
+                IUnknown_Release(effect);
+                memmove(&player->effects[i], &player->effects[i + 1],
+                        (player->effect_count - i - 1) * sizeof(*player->effects));
+                player->effect_count--;
+                hr = S_OK;
+                break;
+            }
+        }
+    }
+    LeaveCriticalSection(&player->cs);
+
+    return hr;
 }
 
