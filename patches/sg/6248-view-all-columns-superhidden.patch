+/* Stained Glass: the folder's column behind a list column (the view shows only those on by default) */
+static UINT folder_column(const IShellViewImpl *This, int column)
+{
+    if (column >= 0 && (UINT)column < This->columns) return This->col_map[column];
+    return column;
+}
