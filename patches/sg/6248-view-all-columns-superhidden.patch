-    if (FAILED(IShellFolder2_MapColumnToSCID(This->pSF2Parent, column, &scid))) return FALSE;
+    if (FAILED(IShellFolder2_MapColumnToSCID(This->pSF2Parent, folder_column(This, column), &scid))) return FALSE;
