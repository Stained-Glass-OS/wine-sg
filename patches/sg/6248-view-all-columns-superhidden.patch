From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: the file view shows every column on by default; protected files hidden

The file view stopped at the first column a folder does not show by default, so a sync root's Status column (after Attributes, which is off) was never shown. As on Windows the view now walks all of the folder's columns and shows those on by default, keeping which folder column each list column holds. A file that is both hidden and system (desktop.ini) is enumerated only with SHCONTF_INCLUDESUPERHIDDEN or when the user shows protected operating system files (Advanced\ShowSuperHidden), not whenever hidden items are shown.
---
diff --git a/dlls/shell32/enumidlist.c b/dlls/shell32/enumidlist.c
index d39a539..5a9c1c3 100644
--- a/dlls/shell32/enumidlist.c
+++ b/dlls/shell32/enumidlist.c
@@ -58,6 +58,35 @@ BOOL AddToEnumList(IEnumIDListImpl *list, LPITEMIDLIST pidl)
     return TRUE;
 }
 
+/* Stained Glass OS 6248: Explorer's "Hide protected operating system files" (off when
+ * Advanced\ShowSuperHidden is 1) */
+static BOOL show_super_hidden(void)
+{
+    DWORD data = 0, size = sizeof(data);
+
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                  L"ShowSuperHidden", RRF_RT_REG_DWORD, NULL, &data, &size );
+    return data != 0;
+}
+
+/* whether an item with these attributes is listed: as on Windows a hidden item only with
+ * SHCONTF_INCLUDEHIDDEN, and a hidden system one (desktop.ini) only with
+ * SHCONTF_INCLUDESUPERHIDDEN or when the user shows protected operating system files */
+static BOOL enum_attributes_listed(DWORD attributes, DWORD flags, int *super_hidden)
+{
+    if (!(attributes & FILE_ATTRIBUTE_HIDDEN)) return TRUE;
+#ifndef SG_MUTANT_SUPERHIDDEN_LISTED
+    if (attributes & FILE_ATTRIBUTE_SYSTEM)
+    {
+        if (flags & SHCONTF_INCLUDESUPERHIDDEN) return TRUE;
+        if (!(flags & SHCONTF_INCLUDEHIDDEN)) return FALSE;
+        if (*super_hidden < 0) *super_hidden = show_super_hidden();
+        return *super_hidden;
+    }
+#endif
+    return (flags & SHCONTF_INCLUDEHIDDEN) != 0;
+}
+
 /**************************************************************************
  *  CreateFolderEnumList()
  */
@@ -68,6 +97,7 @@ BOOL CreateFolderEnumList(IEnumIDListImpl *list, LPCWSTR lpszPath, DWORD dwFlags
     HANDLE hFile;
     WCHAR  szPath[MAX_PATH];
     BOOL succeeded = TRUE;
+    int super_hidden = -1;
 
     TRACE("(%p)->(path=%s flags=0x%08lx)\n", list, debugstr_w(lpszPath), dwFlags);
 
@@ -84,8 +114,7 @@ BOOL CreateFolderEnumList(IEnumIDListImpl *list, LPCWSTR lpszPath, DWORD dwFlags
 
         do
         {
-            if ( !(stffile.dwFileAttributes & FILE_ATTRIBUTE_HIDDEN) 
-             || (dwFlags & SHCONTF_INCLUDEHIDDEN) )
+            if (enum_attributes_listed( stffile.dwFileAttributes, dwFlags, &super_hidden ))
             {
                 if ( (stffile.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) &&
                  dwFlags & SHCONTF_FOLDERS &&
