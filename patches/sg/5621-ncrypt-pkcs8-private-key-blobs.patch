+static void test_pkcs8_export(void)
+{
+    static const WCHAR secret[] = L"correct horse", wrong[] = L"battery staple";
+    static const char aes128[] = "2.16.840.1.101.3.4.1.2";
+    NCryptBuffer buffers[2];
+    NCryptBufferDesc desc = { 0, 1, buffers };
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key, key2;
+    BYTE plain[2048], enc[2048], blob1[1024], blob2[1024];
+    DWORD size, plain_size, enc_size, size1, size2, policy;
+    test_private_key_info *info;
+    test_encrypted_info *einfo;
+    SECURITY_STATUS ret;
+    DWORD decoded_size;
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_RSA_ALGORITHM, NULL, 0, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    policy = NCRYPT_ALLOW_EXPORT_FLAG | NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
+    ret = NCryptSetProperty(key, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&policy, sizeof(policy), 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptFinalizeKey(key, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    /* without parameters: a PrivateKeyInfo holding the RSAPrivateKey */
+    size = 0;
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", NULL, NULL, 0, &size, 0);
+    ok(ret == ERROR_SUCCESS && size > 0, "got %#lx, %lu\n", ret, size);
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", NULL, plain, size - 1, &plain_size, 0);
+    ok(ret == NTE_BUFFER_TOO_SMALL, "got %#lx\n", ret);
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", NULL, plain, sizeof(plain), &plain_size, 0);
+    ok(ret == ERROR_SUCCESS && plain_size == size, "got %#lx, %lu\n", ret, plain_size);
+    ok(CryptDecodeObjectEx(X509_ASN_ENCODING, (LPCSTR)44, plain, plain_size, CRYPT_DECODE_ALLOC_FLAG, NULL, &info,
+            &decoded_size), "decode failed: %08lx\n", GetLastError());
+    if (info)
+    {
+        BYTE *capi;
+
+        ok(info->Version == 0, "got version %lu\n", info->Version);
+        ok(!strcmp(info->Algorithm.pszObjId, "1.2.840.113549.1.1.1"), "got %s\n", info->Algorithm.pszObjId);
+        ok(info->Algorithm.Parameters.cbData == 2 && info->Algorithm.Parameters.pbData[0] == 5, "wrong parameters\n");
+        ok(CryptDecodeObjectEx(X509_ASN_ENCODING, PKCS_RSA_PRIVATE_KEY, info->PrivateKey.pbData, info->PrivateKey.cbData,
+                CRYPT_DECODE_ALLOC_FLAG, NULL, &capi, &decoded_size), "RSA key decode failed: %08lx\n", GetLastError());
+        if (capi) LocalFree(capi);
+        LocalFree(info);
+    }
+
+    /* and it imports back as the same key (the private exponent, the last 128 bytes of a 1024 bit key's blob, may be
+     * another of the equivalent values) */
+    ret = NCryptImportKey(prov, 0, L"PKCS8_PRIVATEKEY", NULL, &key2, plain, plain_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    if (!ret)
+    {
+        policy = NCRYPT_ALLOW_EXPORT_FLAG | NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
+        ret = NCryptSetProperty(key2, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&policy, sizeof(policy), 0);
+        ret = NCryptExportKey(key, 0, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, blob1, sizeof(blob1), &size1, 0);
+        ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+        ret = NCryptExportKey(key2, 0, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, blob2, sizeof(blob2), &size2, 0);
+        ok(ret == ERROR_SUCCESS && size1 == size2 && !memcmp(blob1, blob2, size1 - 128), "got %#lx: not the same key (%lu, %lu, first difference at %lu)\n", ret, size1, size2, first_difference(blob1, blob2, min(size1, size2)));
+        NCryptFreeObject(key2);
+    }
+
+    /* under a secret: PBES2 */
+    buffers[0].cbBuffer = sizeof(secret);
+    buffers[0].BufferType = NCRYPTBUFFER_PKCS_SECRET;
+    buffers[0].pvBuffer = (void *)secret;
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", &desc, enc, sizeof(enc), &enc_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(enc_size != plain_size && memcmp(enc, plain, min(enc_size, plain_size)), "not encrypted\n");
+    ok(!CryptDecodeObjectEx(X509_ASN_ENCODING, (LPCSTR)44, enc, enc_size, CRYPT_DECODE_ALLOC_FLAG, NULL, &info,
+            &decoded_size), "decoded an encrypted key as plain\n");
+    ok(CryptDecodeObjectEx(X509_ASN_ENCODING, (LPCSTR)45, enc, enc_size, CRYPT_DECODE_ALLOC_FLAG, NULL, &einfo,
+            &decoded_size), "decode failed: %08lx\n", GetLastError());
+    if (einfo)
+    {
+        ok(!strcmp(einfo->EncryptionAlgorithm.pszObjId, "1.2.840.113549.1.5.13"), "got %s\n",
+                einfo->EncryptionAlgorithm.pszObjId);
+        ok(einfo->EncryptedPrivateKey.cbData >= plain_size && !(einfo->EncryptedPrivateKey.cbData % 16),
+                "got %lu bytes\n", einfo->EncryptedPrivateKey.cbData);
+        LocalFree(einfo);
+    }
+
+    ret = NCryptImportKey(prov, 0, L"PKCS8_PRIVATEKEY", NULL, &key2, enc, enc_size, 0);
+    ok(ret == NTE_INVALID_PARAMETER, "without the secret: got %#lx\n", ret);
+    buffers[0].cbBuffer = sizeof(wrong);
+    buffers[0].pvBuffer = (void *)wrong;
+    ret = NCryptImportKey(prov, 0, L"PKCS8_PRIVATEKEY", &desc, &key2, enc, enc_size, 0);
+    ok(ret == NTE_BAD_DATA, "wrong secret: got %#lx\n", ret);
+    buffers[0].cbBuffer = sizeof(secret);
+    buffers[0].pvBuffer = (void *)secret;
+    ret = NCryptImportKey(prov, 0, L"PKCS8_PRIVATEKEY", &desc, &key2, enc, enc_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    if (!ret)
+    {
+        policy = NCRYPT_ALLOW_EXPORT_FLAG | NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
+        NCryptSetProperty(key2, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&policy, sizeof(policy), 0);
+        ret = NCryptExportKey(key2, 0, BCRYPT_RSAFULLPRIVATE_BLOB, NULL, blob2, sizeof(blob2), &size2, 0);
+        ok(ret == ERROR_SUCCESS && size1 == size2 && !memcmp(blob1, blob2, size1 - 128), "got %#lx: not the same key (%lu, %lu, first difference at %lu)\n", ret, size1, size2, first_difference(blob1, blob2, min(size1, size2)));
+        NCryptFreeObject(key2);
+    }
+
+    /* two exports of the same key under the same secret differ (salt and iv) */
+    {
+        BYTE enc2[2048];
+        DWORD enc2_size;
+
+        ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", &desc, enc2, sizeof(enc2), &enc2_size, 0);
+        ok(ret == ERROR_SUCCESS && (enc2_size != enc_size || memcmp(enc, enc2, enc_size)), "same encoding twice\n");
+    }
+
+    /* a cipher by object identifier */
+    buffers[1].cbBuffer = sizeof(aes128);
+    buffers[1].BufferType = NCRYPTBUFFER_PKCS_ALG_OID;
+    buffers[1].pvBuffer = (void *)aes128;
+    desc.cBuffers = 2;
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", &desc, enc, sizeof(enc), &enc_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ret = NCryptImportKey(prov, 0, L"PKCS8_PRIVATEKEY", &desc, &key2, enc, enc_size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    if (!ret) NCryptFreeObject(key2);
+    buffers[1].pvBuffer = (void *)"1.2.3.4";
+    buffers[1].cbBuffer = 8;
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", &desc, enc, sizeof(enc), &enc_size, 0);
+    ok(ret == NTE_NOT_SUPPORTED, "got %#lx\n", ret);
+
+    /* a buffer type the blob does not use */
+    desc.cBuffers = 1;
+    buffers[0].BufferType = NCRYPTBUFFER_PKCS_ALG_ID;
+    ret = NCryptExportKey(key, 0, L"PKCS8_PRIVATEKEY", &desc, enc, sizeof(enc), &enc_size, 0);
+    ok(ret == NTE_BAD_FLAGS, "got %#lx\n", ret);
+
+    NCryptFreeObject(key);
+    NCryptFreeObject(prov);
+}
+
 START_TEST(ncrypt)
