+++ b/dlls/ncrypt/pkcs8.c
@@ -0,0 +1,713 @@
+/*
+ * PKCS #8 private key blobs for NCryptExportKey and NCryptImportKey
+ *
+ * A PrivateKeyInfo (RFC 5208) holding an RSA key, optionally encrypted under
+ * a secret with PBES2 (RFC 8018): PBKDF2 with an HMAC, then AES in CBC mode.
