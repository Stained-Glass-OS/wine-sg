@@ -770,14 +796,67 @@ static HRESULT WINAPI uia_cache_request_AddProperty(IUIAutomationCacheRequest *i
 
 static HRESULT WINAPI uia_cache_request_AddPattern(IUIAutomationCacheRequest *iface, PATTERNID pattern_id)
 {
-    FIXME("%p, %d: stub\n", iface, pattern_id);
-    return E_NOTIMPL;
+    struct uia_cache_request *uia_cache_request = impl_from_IUIAutomationCacheRequest(iface);
+    int i;
+
+    TRACE("%p, %d\n", iface, pattern_id);
+
+    if (!uia_pattern_info_from_id(pattern_id))
+        return E_INVALIDARG;
+
+    /* Don't add a duplicate pattern to the cache request. */
+    for (i = 0; i < uia_cache_request->pattern_ids_count; i++)
+    {
+        if (uia_cache_request->pattern_ids[i] == pattern_id)
+            return S_OK;
+    }
+
+    if (!uia_array_reserve((void **)&uia_cache_request->pattern_ids, &uia_cache_request->pattern_ids_arr_size,
+                uia_cache_request->pattern_ids_count + 1, sizeof(*uia_cache_request->pattern_ids)))
+        return E_OUTOFMEMORY;
+
+    uia_cache_request->pattern_ids[uia_cache_request->pattern_ids_count++] = pattern_id;
+    uia_cache_request->cache_req.pPatterns = uia_cache_request->pattern_ids;
+    uia_cache_request->cache_req.cPatterns = uia_cache_request->pattern_ids_count;
+
+    return S_OK;
 }
 
+static HRESULT create_uia_cache_request_iface(IUIAutomationCacheRequest **out_cache_req);
+
 static HRESULT WINAPI uia_cache_request_Clone(IUIAutomationCacheRequest *iface, IUIAutomationCacheRequest **out_req)
 {
-    FIXME("%p, %p: stub\n", iface, out_req);
-    return E_NOTIMPL;
+    struct uia_cache_request *uia_cache_request = impl_from_IUIAutomationCacheRequest(iface);
+    IUIAutomationCacheRequest *clone;
+    HRESULT hr;
+    int i;
+
+    TRACE("%p, %p\n", iface, out_req);
+
+    if (!out_req)
+        return E_POINTER;
+    *out_req = NULL;
+
+    if (FAILED(hr = create_uia_cache_request_iface(&clone)))
+        return hr;
+
+    hr = IUIAutomationCacheRequest_put_TreeScope(clone, uia_cache_request->cache_req.Scope);
+    if (SUCCEEDED(hr))
+        hr = IUIAutomationCacheRequest_put_TreeFilter(clone, uia_cache_request->view_condition);
+    for (i = 0; SUCCEEDED(hr) && i < uia_cache_request->prop_ids_count; i++)
+        hr = IUIAutomationCacheRequest_AddProperty(clone, uia_cache_request->prop_ids[i]);
+    for (i = 0; SUCCEEDED(hr) && i < uia_cache_request->pattern_ids_count; i++)
+        hr = IUIAutomationCacheRequest_AddPattern(clone, uia_cache_request->pattern_ids[i]);
+    if (SUCCEEDED(hr))
+        hr = IUIAutomationCacheRequest_put_AutomationElementMode(clone, uia_cache_request->cache_req.automationElementMode);
+    if (FAILED(hr))
+    {
+        IUIAutomationCacheRequest_Release(clone);
+        return hr;
+    }
+
+    *out_req = clone;
+    return S_OK;
 }
 
