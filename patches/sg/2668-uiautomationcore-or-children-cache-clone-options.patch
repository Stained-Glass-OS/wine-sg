From: Stained Glass OS <ke7oxh@gmail.com>
uiautomationcore: Or condition children, cache request patterns and Clone, options

GetChildren of an Or condition returns its conditions in an array, a cache
request keeps the patterns added to it and can be cloned, the connection
recovery and event coalescing options are kept (both enabled at first and
checked), and the FindXWithOptions methods with the default traversal order
search like FindX.
---
--- a/dlls/uiautomationcore/uia_com_client.c
+++ b/dlls/uiautomationcore/uia_com_client.c
@@ -147,8 +147,29 @@ static HRESULT WINAPI uia_or_condition_GetChildrenAsNativeArray(IUIAutomationOrC
 
 static HRESULT WINAPI uia_or_condition_GetChildren(IUIAutomationOrCondition *iface, SAFEARRAY **out_children)
 {
-    FIXME("%p, %p: stub\n", iface, out_children);
-    return E_NOTIMPL;
+    struct uia_or_condition *uia_or_condition = impl_from_IUIAutomationOrCondition(iface);
+    SAFEARRAY *sa;
+    HRESULT hr = S_OK;
+    LONG i;
+
+    TRACE("%p, %p\n", iface, out_children);
+
+    if (!out_children)
+        return E_POINTER;
+    *out_children = NULL;
+
+    if (!(sa = SafeArrayCreateVector(VT_UNKNOWN, 0, uia_or_condition->child_count)))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < uia_or_condition->child_count; i++)
+    {
+        if (FAILED(hr = SafeArrayPutElement(sa, &i, uia_or_condition->child_ifaces[i])))
+        {
+            SafeArrayDestroy(sa);
+            return hr;
+        }
+    }
+    *out_children = sa;
+    return S_OK;
 }
 
