From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: A swap chain's message crosses UIPI only from the window's own renderer (6502)

6500 let WM_WINE_CLIENT_SURFACE through UIPI from any process of less
integrity, so a sandboxed page's process could have an elevated
program's or the shell's window leave an area to frames it never
presents -- blanking or freezing it. It now crosses UIPI only when the
sender names itself, was started by the window's own process (a browser
starts its GPU process and hands it its window), is in the same session
and on the same desktop, and the window belongs to the receiving thread.
---
diff --git a/server/queue.c b/server/queue.c
index a03a80b..442cee5 100644
--- a/server/queue.c
+++ b/server/queue.c
@@ -3448,17 +3448,44 @@ int uipi_allows( struct process *sender, struct process *receiver, unsigned int
      * owner and viewers are sent whoever changed it */
     case WM_DESTROYCLIPBOARD: case WM_RENDERALLFORMATS: case WM_CLIPBOARDUPDATE:
         return 1;
-#ifndef SG_MUTANT_UIPI_CLIENT_SURFACE
-    /* Stained Glass OS (6500): a swap chain of a process with less integrity in the window
-     * (Chromium's sandboxed GPU process in the browser's): it only leaves the window's area
-     * to the frames, which that process presents into it anyway */
-    case WM_WINE_CLIENT_SURFACE:
-        return 1;
-#endif
     }
     return 0;
 }
 
+/* Stained Glass OS (6500): WM_WINE_CLIENT_SURFACE from a process with less integrity than
+ * the window's (Chromium's GPU process, sandboxed at low integrity, tells its browser that
+ * it presents into its window). UIPI lets only this through: the sender names itself, it
+ * is a process the window's own process started (the browser starts its GPU process and
+ * hands it the window), in the same session and on the same desktop, and the window
+ * belongs to the receiving thread. Any other sender -- a sandboxed page's process aiming at
+ * an elevated program's or the shell's window -- is refused as UIPI refuses it. */
+static int client_surface_message_allowed( struct thread *receiver, const struct send_message_request *req )
+{
+    struct process *sender = current->process, *owner = receiver->process;
+    struct thread *win_thread;
+    struct desktop *a, *b;
+    int ret;
+
+    if (req->msg != WM_WINE_CLIENT_SURFACE) return 0;
+#ifdef SG_MUTANT_UIPI_CLIENT_SURFACE_ANY
+    return 1;
+#endif
+    if (req->wparam != sender->id) return 0;
+    if (sender->parent_id != owner->id) return 0;
+    if (sender->session_id != owner->session_id) return 0;
+    if (!(win_thread = get_window_thread( req->win ))) return 0;
+    ret = win_thread == receiver;
+    release_object( win_thread );
+    if (!ret) return 0;
+    a = get_thread_desktop( current, 0 );
+    b = get_thread_desktop( receiver, 0 );
+    ret = a && a == b;
+    if (a) release_object( a );
+    if (b) release_object( b );
+    clear_error();
+    return ret;
+}
+
 DECL_HANDLER(send_message)
 {
     struct message *msg;
@@ -3471,6 +3498,9 @@ DECL_HANDLER(send_message)
     if (!uipi_allows( current->process, thread->process, req->msg )
 #ifndef SG_MUTANT_UIPI_NO_FILTER
         && !window_or_process_allows_message( req->win, req->msg )
+#endif
+#ifndef SG_MUTANT_UIPI_CLIENT_SURFACE
+        && !client_surface_message_allowed( thread, req )
 #endif
        )
     {
