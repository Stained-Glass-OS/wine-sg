From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: the screen as the compositor shows it, for programs that capture it.

A program reading the screen -- BitBlt or GetPixel from the screen DC, a
display DC, DXGI output duplication -- read the X server: Wine's windows, but
not the Linux programs' windows the compositor shows beside them, and the same
pixels while the session was locked or a consent prompt was up. Under the
session's compositor the screen DC's pixels now come from its screen capture
for ordinary programs (its public wlr-screencopy: the lock screen, consent
prompts and the security screen black), translated from the X root to the
compositor's layout, one capture per output. An output's picture is kept for
a frame (20 ms), so a program reading pixel by pixel -- 10000 GetPixel calls
of a colour picker, an AutoHotkey PixelSearch -- costs a capture a frame, not
one a call, and still sees a change on the next frame. Without a compositor that offers
it, the X server's picture is used as before.
---
diff --git a/dlls/winex11.drv/Makefile.in b/dlls/winex11.drv/Makefile.in
index 4d20716..d904479 100644
--- a/dlls/winex11.drv/Makefile.in
+++ b/dlls/winex11.drv/Makefile.in
@@ -1,8 +1,8 @@
 MODULE    = winex11.drv
 UNIXLIB   = winex11.so
 IMPORTS   = uuid user32 gdi32 win32u
-UNIX_CFLAGS  = $(X_CFLAGS) $(XKBCOMMON_CFLAGS)
-UNIX_LIBS    = -lwin32u $(X_LIBS) $(XKBCOMMON_LIBS) $(PTHREAD_LIBS) -lm
+UNIX_CFLAGS  = $(X_CFLAGS) $(XKBCOMMON_CFLAGS) $(WAYLAND_CLIENT_CFLAGS)
+UNIX_LIBS    = -lwin32u $(X_LIBS) $(XKBCOMMON_LIBS) $(WAYLAND_CLIENT_LIBS) $(PTHREAD_LIBS) -lm
 
 SOURCES = \
 	bitblt.c \
@@ -21,11 +21,14 @@ SOURCES = \
 	pen.c \
 	sg_dragsrc.c \
 	sg_embed.c \
+	sg_wlcapture.c \
 	version.rc \
 	vulkan.c \
 	window.c \
 	wintab.c \
+	wlr-screencopy-unstable-v1.xml \
 	x11drv_main.c \
+	xdg-output-unstable-v1.xml \
 	xim.c \
 	xinerama.c \
 	xkbtables.c \
diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index f013a5c..2d6cd2f 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -1369,6 +1369,32 @@ DWORD X11DRV_GetImage( PHYSDEV dev, BITMAPINFO *info,
     src->y -= y;
     OffsetRect( &src->visrect, -x, -y );
 
+    image = NULL;
+    /* Stained Glass OS: the screen as the compositor shows it (the screen and
+     * display DCs draw on the desktop's window): Linux programs' windows too,
+     * and black while the session is locked or a secure prompt is up -- what
+     * any program capturing the screen gets (sg_wlcapture.c) */
+    if (physdev->drawable == root_window && format->bits_per_pixel == 32 && vis.depth >= 24)
+    {
+        Window child;
+        int root_x, root_y;
+        RECT rect;
+        char *data;
+
+        XTranslateCoordinates( gdi_display, root_window, DefaultRootWindow( gdi_display ),
+                               physdev->dc_rect.left + x, physdev->dc_rect.top + y, &root_x, &root_y, &child );
+        SetRect( &rect, root_x, root_y, root_x + width, root_y + height );
+        if ((data = malloc( (size_t)width * height * 4 )))
+        {
+            if (x11drv_compositor_capture( &rect, (BYTE *)data, width * 4, FALSE ) &&
+                (image = XCreateImage( gdi_display, default_visual.visual, vis.depth, ZPixmap, 0, data,
+                                       width, height, 32, width * 4 )))
+                data = NULL;   /* the image's now */
+            free( data );
+        }
+    }
+    if (!image)
+    {
     X11DRV_expect_error( gdi_display, XGetImage_handler, NULL );
     image = XGetImage( gdi_display, physdev->drawable,
                        physdev->dc_rect.left + x, physdev->dc_rect.top + y,
@@ -1386,6 +1412,7 @@ DWORD X11DRV_GetImage( PHYSDEV dev, BITMAPINFO *info,
         XFreePixmap( gdi_display, pixmap );
         XFreeGC( gdi_display, gc );
     }
+    }
 
     if (!image) return ERROR_OUTOFMEMORY;
 
diff --git a/dlls/winex11.drv/sg_wlcapture.c b/dlls/winex11.drv/sg_wlcapture.c
new file mode 100644
index 0000000..71646ca
--- /dev/null
+++ b/dlls/winex11.drv/sg_wlcapture.c
@@ -0,0 +1,389 @@
+/*
+ * The screen as the compositor shows it (Stained Glass OS)
+ *
+ * A Windows program reading the screen -- BitBlt from the screen DC, GetPixel,
+ * DXGI output duplication, Windows.Graphics.Capture -- read the X server: Wine's
+ * own windows, but not the Linux programs' windows the compositor shows beside
+ * them, and the same pixels while the session was locked or a consent prompt
+ * was up. Under the session's compositor (sg-compositor) the pixels now come
+ * from its screen capture for ordinary programs, the same any program gets
+ * (its public wlr-screencopy: the secure screens -- lock, consent, the
+ * security screen -- black). Without a compositor that offers it (no
+ * WAYLAND_DISPLAY, a plain X server) the X server's picture is used as before.
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+/* before Wine's headers: they define "interface", a name the Wayland ones use */
+#include <wayland-client.h>
+#include "wlr-screencopy-unstable-v1-client-protocol.h"
+#include "xdg-output-unstable-v1-client-protocol.h"
+
+#include "x11drv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(bitblt);
+
+#define MAX_OUTPUTS 16
+
+struct capture_output
+{
+    struct wl_output *output;
+    struct zxdg_output_v1 *xdg;
+    int x, y, width, height;   /* logical, in the compositor's layout */
+    /* the output's last picture, for reads in quick succession (a loop of
+     * GetPixel calls costs a capture a frame, not one a call) */
+    UINT *cache;
+    int cache_width, cache_height;   /* the output's pixels */
+    ULONGLONG cache_time;            /* monotonic, in milliseconds */
+    BOOL cache_cursor;               /* whether it shows the pointer */
+};
+
+/* a picture is reused for about one frame of a 60 Hz output */
+#define CACHE_MS 20
+
+static ULONGLONG now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static pthread_mutex_t capture_mutex = PTHREAD_MUTEX_INITIALIZER;
+static BOOL capture_tried;
+static struct wl_display *capture_display;
+static struct wl_shm *capture_shm;
+static struct zwlr_screencopy_manager_v1 *capture_manager;
+static struct zxdg_output_manager_v1 *capture_xdg_manager;
+static struct capture_output capture_outputs[MAX_OUTPUTS];
+static int capture_output_count;
+
+static void xdg_output_position( void *data, struct zxdg_output_v1 *xdg, int32_t x, int32_t y )
+{
+    struct capture_output *out = data;
+    out->x = x;
+    out->y = y;
+}
+
+static void xdg_output_size( void *data, struct zxdg_output_v1 *xdg, int32_t w, int32_t h )
+{
+    struct capture_output *out = data;
+    out->width = w;
+    out->height = h;
+}
+
+static void xdg_output_ignore( void *data, struct zxdg_output_v1 *xdg ) {}
+static void xdg_output_ignore_str( void *data, struct zxdg_output_v1 *xdg, const char *s ) {}
+
+static const struct zxdg_output_v1_listener xdg_output_listener =
+{
+    xdg_output_position, xdg_output_size, xdg_output_ignore, xdg_output_ignore_str, xdg_output_ignore_str
+};
+
+static void registry_global( void *data, struct wl_registry *registry, uint32_t name,
+                             const char *name_str, uint32_t version )
+{
+    if (!strcmp( name_str, wl_shm_interface.name ))
+        capture_shm = wl_registry_bind( registry, name, &wl_shm_interface, 1 );
+    else if (!strcmp( name_str, zwlr_screencopy_manager_v1_interface.name ))
+        capture_manager = wl_registry_bind( registry, name, &zwlr_screencopy_manager_v1_interface,
+                                            version < 3 ? version : 3 );
+    else if (!strcmp( name_str, zxdg_output_manager_v1_interface.name ))
+        capture_xdg_manager = wl_registry_bind( registry, name, &zxdg_output_manager_v1_interface,
+                                                version < 2 ? version : 2 );
+    else if (!strcmp( name_str, wl_output_interface.name ) && capture_output_count < MAX_OUTPUTS)
+        capture_outputs[capture_output_count++].output = wl_registry_bind( registry, name, &wl_output_interface, 1 );
+}
+
+static void registry_global_remove( void *data, struct wl_registry *registry, uint32_t name ) {}
+
+static const struct wl_registry_listener registry_listener = { registry_global, registry_global_remove };
+
+/* Connect once: the compositor named by WAYLAND_DISPLAY, with its screen
+ * capture, outputs and their places. FALSE: read the X server instead. */
+static BOOL capture_init(void)
+{
+    struct wl_registry *registry;
+    int i;
+
+    if (capture_tried) return capture_manager && capture_shm && capture_output_count;
+    capture_tried = TRUE;
+#ifdef SG_MUTANT_CAPTURE_X_ONLY
+    return FALSE;
+#endif
+    if (!getenv( "WAYLAND_DISPLAY" ) || !*getenv( "WAYLAND_DISPLAY" )) return FALSE;
+    if (!(capture_display = wl_display_connect( NULL )))
+    {
+        WARN( "no compositor at WAYLAND_DISPLAY: the screen is read from X\n" );
+        return FALSE;
+    }
+    registry = wl_display_get_registry( capture_display );
+    wl_registry_add_listener( registry, &registry_listener, NULL );
+    wl_display_roundtrip( capture_display );
+    if (capture_xdg_manager)
+    {
+        for (i = 0; i < capture_output_count; i++)
+        {
+            capture_outputs[i].xdg = zxdg_output_manager_v1_get_xdg_output( capture_xdg_manager,
+                                                                           capture_outputs[i].output );
+            zxdg_output_v1_add_listener( capture_outputs[i].xdg, &xdg_output_listener, &capture_outputs[i] );
+        }
+        wl_display_roundtrip( capture_display );
+    }
+    TRACE( "compositor capture: manager %p shm %p outputs %d\n", capture_manager, capture_shm, capture_output_count );
+    for (i = 0; i < capture_output_count; i++)
+        TRACE( "  output %d: %d,%d %dx%d\n", i, capture_outputs[i].x, capture_outputs[i].y,
+               capture_outputs[i].width, capture_outputs[i].height );
+    if (!capture_manager || !capture_shm || !capture_output_count || !capture_xdg_manager)
+    {
+        WARN( "the compositor offers no screen capture: the screen is read from X\n" );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+struct capture_frame
+{
+    uint32_t format, width, height, stride;
+    BOOL have_buffer, done, failed, y_invert;
+    struct wl_buffer *buffer;
+    void *data;
+    size_t size;
+};
+
+static BOOL frame_make_buffer( struct capture_frame *f );
+
+static void frame_buffer( void *data, struct zwlr_screencopy_frame_v1 *frame, uint32_t format,
+                          uint32_t width, uint32_t height, uint32_t stride )
+{
+    struct capture_frame *f = data;
+    f->format = format;
+    f->width = width;
+    f->height = height;
+    f->stride = stride;
+    f->have_buffer = TRUE;
+    /* before version 3 there is no buffer_done: this is the only buffer */
+    if (zwlr_screencopy_frame_v1_get_version( frame ) < 3)
+    {
+        if (!frame_make_buffer( f )) f->failed = f->done = TRUE;
+        else zwlr_screencopy_frame_v1_copy( frame, f->buffer );
+    }
+}
+
+static void frame_flags( void *data, struct zwlr_screencopy_frame_v1 *frame, uint32_t flags )
+{
+    struct capture_frame *f = data;
+    f->y_invert = !!(flags & ZWLR_SCREENCOPY_FRAME_V1_FLAGS_Y_INVERT);
+}
+
+static void frame_ready( void *data, struct zwlr_screencopy_frame_v1 *frame, uint32_t hi, uint32_t lo, uint32_t ns )
+{
+    struct capture_frame *f = data;
+    f->done = TRUE;
+}
+
+static void frame_failed( void *data, struct zwlr_screencopy_frame_v1 *frame )
+{
+    struct capture_frame *f = data;
+    f->failed = f->done = TRUE;
+}
+
+static void frame_damage( void *data, struct zwlr_screencopy_frame_v1 *frame, uint32_t x, uint32_t y,
+                          uint32_t w, uint32_t h ) {}
+static void frame_dmabuf( void *data, struct zwlr_screencopy_frame_v1 *frame, uint32_t format,
+                          uint32_t w, uint32_t h ) {}
+
+static void frame_buffer_done( void *data, struct zwlr_screencopy_frame_v1 *frame )
+{
+    struct capture_frame *f = data;
+    if (!frame_make_buffer( f )) { f->failed = f->done = TRUE; return; }
+    zwlr_screencopy_frame_v1_copy( frame, f->buffer );
+}
+
+static const struct zwlr_screencopy_frame_v1_listener frame_listener =
+{
+    frame_buffer, frame_flags, frame_ready, frame_failed, frame_damage, frame_dmabuf, frame_buffer_done
+};
+
+static BOOL frame_make_buffer( struct capture_frame *f )
+{
+    struct wl_shm_pool *pool;
+    int fd;
+
+    if (!f->have_buffer || (f->format != WL_SHM_FORMAT_XRGB8888 && f->format != WL_SHM_FORMAT_ARGB8888)) return FALSE;
+    f->size = (size_t)f->stride * f->height;
+    if ((fd = memfd_create( "wine-screen-capture", MFD_CLOEXEC )) < 0) return FALSE;
+    if (ftruncate( fd, f->size ) < 0 ||
+        (f->data = mmap( NULL, f->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+    {
+        f->data = NULL;
+        close( fd );
+        return FALSE;
+    }
+    pool = wl_shm_create_pool( capture_shm, fd, f->size );
+    f->buffer = wl_shm_pool_create_buffer( pool, 0, f->width, f->height, f->stride, f->format );
+    wl_shm_pool_destroy( pool );
+    close( fd );
+    return TRUE;
+}
+
+/* wait for the frame, at most a second: a compositor that never answers must
+ * not hang the program */
+static BOOL frame_wait( struct capture_frame *f )
+{
+    struct pollfd pfd = { wl_display_get_fd( capture_display ), POLLIN };
+    int waited = 0;
+
+    while (!f->done)
+    {
+        while (wl_display_prepare_read( capture_display ) != 0)
+            if (wl_display_dispatch_pending( capture_display ) < 0) return FALSE;
+        if (f->done) { wl_display_cancel_read( capture_display ); break; }
+        wl_display_flush( capture_display );
+        if (poll( &pfd, 1, 100 ) <= 0)
+        {
+            wl_display_cancel_read( capture_display );
+            if ((waited += 100) >= 1000) return FALSE;
+            continue;
+        }
+        if (wl_display_read_events( capture_display ) < 0) return FALSE;
+        if (wl_display_dispatch_pending( capture_display ) < 0) return FALSE;
+    }
+    return !f->failed;
+}
+
+/* the whole output's picture, fresh: the last one while it is younger than a
+ * frame, else a new capture */
+static BOOL output_picture( struct capture_output *out, BOOL cursor )
+{
+    struct zwlr_screencopy_frame_v1 *frame;
+    struct capture_frame f = { 0 };
+    ULONGLONG now = now_ms();
+    BOOL ret = FALSE;
+    int row;
+
+#ifdef SG_MUTANT_CAPTURE_CACHE_FOREVER
+    if (out->cache) return TRUE;
+#else
+    if (out->cache && out->cache_cursor == cursor && now - out->cache_time < CACHE_MS) return TRUE;
+#endif
+    frame = zwlr_screencopy_manager_v1_capture_output( capture_manager, cursor, out->output );
+    zwlr_screencopy_frame_v1_add_listener( frame, &frame_listener, &f );
+    if (frame_wait( &f ) && f.data && f.width && f.height)
+    {
+        if (out->cache_width != f.width || out->cache_height != f.height)
+        {
+            free( out->cache );
+            out->cache = malloc( (size_t)f.width * f.height * 4 );
+            out->cache_width = f.width;
+            out->cache_height = f.height;
+        }
+        if (out->cache)
+        {
+            for (row = 0; row < (int)f.height; row++)
+                memcpy( out->cache + (size_t)row * f.width,
+                        (BYTE *)f.data + (f.y_invert ? f.height - 1 - row : row) * f.stride, f.width * 4 );
+            out->cache_time = now_ms();
+            out->cache_cursor = cursor;
+            ret = TRUE;
+        }
+    }
+    else WARN( "the compositor did not capture output %d,%d\n", out->x, out->y );
+    zwlr_screencopy_frame_v1_destroy( frame );
+    if (f.buffer) wl_buffer_destroy( f.buffer );
+    if (f.data) munmap( f.data, f.size );
+    return ret;
+}
+
+/* one output's part of the rectangle into dst (BGRX, rect-relative) */
+static BOOL capture_from_output( struct capture_output *out, int x, int y, int width, int height,
+                                 BYTE *dst, int dst_stride, const RECT *rect, BOOL cursor )
+{
+    int row, col;
+
+    if (!output_picture( out, cursor )) return FALSE;
+    /* the picture is in the output's pixels: a scaled output's are more */
+    for (row = 0; row < height; row++)
+    {
+        int sy = (y - out->y + row) * out->cache_height / out->height;
+        const UINT *src = out->cache + (size_t)min( sy, out->cache_height - 1 ) * out->cache_width;
+        UINT *d = (UINT *)(dst + (y - rect->top + row) * dst_stride) + (x - rect->left);
+        for (col = 0; col < width; col++)
+        {
+            int sx = min( (x - out->x + col) * out->cache_width / out->width, out->cache_width - 1 );
+#ifdef SG_MUTANT_CAPTURE_RB_SWAPPED
+            UINT p = src[sx];
+            d[col] = (p & 0xff00) | ((p >> 16) & 0xff) | ((p & 0xff) << 16);
+#else
+            d[col] = src[sx] & 0xffffff;
+#endif
+        }
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           x11drv_compositor_capture
+ *
+ * The rectangle of the compositor's layout (the X server's root coordinates)
+ * as it is shown, 32 bits per pixel (BGRX), parts on no output black.
+ * FALSE: there is no compositor capture; read the X server.
+ */
+BOOL x11drv_compositor_capture( const RECT *rect, BYTE *bits, int stride, BOOL cursor )
+{
+    BOOL ret = FALSE;
+    int i, row;
+
+    pthread_mutex_lock( &capture_mutex );
+    if (capture_init())
+    {
+        for (row = 0; row < rect->bottom - rect->top; row++)
+            memset( bits + row * stride, 0, (rect->right - rect->left) * 4 );
+        for (i = 0; i < capture_output_count; i++)
+        {
+            struct capture_output *out = &capture_outputs[i];
+            RECT o = { out->x, out->y, out->x + out->width, out->y + out->height }, part;
+            if (!intersect_rect( &part, &o, rect )) continue;
+            if (capture_from_output( out, part.left, part.top, part.right - part.left,
+                                     part.bottom - part.top, bits, stride, rect, cursor ))
+                ret = TRUE;
+        }
+        if (!ret)
+        {
+            /* the compositor went away: keep reading X from now on */
+            WARN( "compositor capture failed\n" );
+        }
+    }
+    pthread_mutex_unlock( &capture_mutex );
+    return ret;
+}
