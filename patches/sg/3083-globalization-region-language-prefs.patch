+
+
+struct nation_search
+{
+    const WCHAR *code;
+    GEOTYPE type;
+    WCHAR iso2[8];
+    BOOL found;
+};
+
+static SRWLOCK nation_lock = SRWLOCK_INIT;
+static struct nation_search *current_search;   /* the enumeration has no parameter: guarded by nation_lock */
+
+static BOOL CALLBACK find_nation( GEOID id )
+{
+    struct nation_search *search = current_search;
+    WCHAR value[16];
+
+    if (!GetGeoInfoW( id, search->type, value, ARRAY_SIZE(value), 0 )) return TRUE;
+    if (wcsicmp( value, search->code )) return TRUE;
+    if (!GetGeoInfoW( id, GEO_ISO2, search->iso2, ARRAY_SIZE(search->iso2), 0 )) return TRUE;
+    search->found = TRUE;
+    return FALSE;
+}
+
+/* the ISO 3166 two-letter code of a region named by its two-letter, three-letter or numeric code */
+static BOOL region_lookup( const WCHAR *code, WCHAR *iso2 )
+{
+    WCHAR upper[8], check[8];
+    struct nation_search search = {0};
+    size_t len = code ? wcslen( code ) : 0, i;
+
+    if (len < 2 || len > 3) return FALSE;
+    for (i = 0; i < len; i++) upper[i] = towupper( code[i] );
+    upper[len] = 0;
+
+    if (len == 2)
+    {
+        if (!GetGeoInfoEx( upper, GEO_ISO2, check, ARRAY_SIZE(check) )) return FALSE;
+        wcscpy( iso2, check );
+        return TRUE;
+    }
+#ifdef SG_MUTANT_NO_ISO3
+    return FALSE;
+#endif
+    search.code = upper;
+    search.type = iswdigit( upper[0] ) ? GEO_ISO_UN_NUMBER : GEO_ISO3;
+    AcquireSRWLockExclusive( &nation_lock );
+    current_search = &search;
+    EnumSystemGeoID( GEOCLASS_NATION, 0, find_nation );   /* stops at the match */
+    current_search = NULL;
+    ReleaseSRWLockExclusive( &nation_lock );
+    if (!search.found) return FALSE;
+    wcscpy( iso2, search.iso2 );
+    return TRUE;
+}
+
+static HRESULT geo_string( const struct geographic_region *region, GEOTYPE type, HSTRING *value )
+{
+    WCHAR buffer[128];
+    WCHAR code[8];
+
+    if (!value) return E_POINTER;
+    wcscpy( code, region->iso2 );
+    if (!GetGeoInfoEx( code, type, buffer, ARRAY_SIZE(buffer) )) return HRESULT_FROM_WIN32( GetLastError() );
+    return WindowsCreateString( buffer, wcslen( buffer ), value );
+}
+
+struct native_name_search
+{
+    const WCHAR *iso2;
+    WCHAR name[128];
+    BOOL found;
+};
+
+static BOOL CALLBACK find_native_name( WCHAR *locale, DWORD flags, LPARAM param )
+{
+    struct native_name_search *search = (struct native_name_search *)param;
+    WCHAR region[16];
+
+    if (!GetLocaleInfoEx( locale, LOCALE_SISO3166CTRYNAME, region, ARRAY_SIZE(region) )) return TRUE;
+    if (wcsicmp( region, search->iso2 )) return TRUE;
+    if (!GetLocaleInfoEx( locale, LOCALE_SNATIVECOUNTRYNAME, search->name, ARRAY_SIZE(search->name) )) return TRUE;
+    search->found = TRUE;
+    return FALSE;
 }
 
 static HRESULT WINAPI geographic_region_get_Code( IGeographicRegion *iface, HSTRING *value )
 {
-    FIXME( "iface %p stub!\n", iface );
