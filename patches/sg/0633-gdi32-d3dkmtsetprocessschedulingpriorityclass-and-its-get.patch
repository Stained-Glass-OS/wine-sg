From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdi32: D3DKMTSetProcessSchedulingPriorityClass and its Get

OBS Studio imports D3DKMTSetProcessSchedulingPriorityClass from gdi32 to
raise its renderer's GPU priority. Wine did not export it, so the loader
bound the import to a stub and OBS aborted right after its log said "D3D11
loaded successfully" (its own crash handler then died in dbghelp, so the
walk saw only "no window"). gdi32 now exports the call and
D3DKMTGetProcessSchedulingPriorityClass: the class of this process is kept
and read back (there is no GPU scheduler to hand it to), a class past
REALTIME or a missing output is STATUS_INVALID_PARAMETER, a handle that is
no process STATUS_INVALID_HANDLE. The enum and prototypes go in d3dkmthk.h.
---
--- a/include/ddk/d3dkmthk.h
+++ b/include/ddk/d3dkmthk.h
@@ -720,6 +720,16 @@
     D3DKMT_GET_QUEUEDLIMIT_PRESENT
 } D3DKMT_QUEUEDLIMIT_TYPE;
 
+typedef enum _D3DKMT_SCHEDULINGPRIORITYCLASS
+{
+    D3DKMT_SCHEDULINGPRIORITYCLASS_IDLE,
+    D3DKMT_SCHEDULINGPRIORITYCLASS_BELOW_NORMAL,
+    D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL,
+    D3DKMT_SCHEDULINGPRIORITYCLASS_ABOVE_NORMAL,
+    D3DKMT_SCHEDULINGPRIORITYCLASS_HIGH,
+    D3DKMT_SCHEDULINGPRIORITYCLASS_REALTIME,
+} D3DKMT_SCHEDULINGPRIORITYCLASS;
+
 typedef struct _D3DKMT_SETQUEUEDLIMIT
 {
     D3DKMT_HANDLE hDevice;
@@ -1301,6 +1311,8 @@
 NTSTATUS WINAPI D3DKMTQueryResourceInfoFromNtHandle( D3DKMT_QUERYRESOURCEINFOFROMNTHANDLE *params );
 NTSTATUS WINAPI D3DKMTQueryStatistics(D3DKMT_QUERYSTATISTICS *stats);
 NTSTATUS WINAPI D3DKMTQueryVideoMemoryInfo(D3DKMT_QUERYVIDEOMEMORYINFO *desc);
+NTSTATUS WINAPI D3DKMTGetProcessSchedulingPriorityClass(HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS *priority);
+NTSTATUS WINAPI D3DKMTSetProcessSchedulingPriorityClass(HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS priority);
 NTSTATUS WINAPI D3DKMTSetQueuedLimit(D3DKMT_SETQUEUEDLIMIT *desc);
 NTSTATUS WINAPI D3DKMTSetVidPnSourceOwner(const D3DKMT_SETVIDPNSOURCEOWNER *desc);
 NTSTATUS WINAPI D3DKMTShareObjects( UINT count, const D3DKMT_HANDLE *handles, OBJECT_ATTRIBUTES *attr, UINT access, HANDLE *handle );
--- a/dlls/gdi32/gdi32.spec
+++ b/dlls/gdi32/gdi32.spec
@@ -118,6 +118,7 @@
 @ stdcall D3DKMTEnumAdapters(ptr) win32u.NtGdiDdDDIEnumAdapters
 @ stdcall D3DKMTEnumAdapters2(ptr) win32u.NtGdiDdDDIEnumAdapters2
 @ stdcall D3DKMTEscape(ptr) win32u.NtGdiDdDDIEscape
+@ stdcall D3DKMTGetProcessSchedulingPriorityClass(long ptr)
 @ stdcall D3DKMTOpenAdapterFromDeviceName(ptr) win32u.NtGdiDdDDIOpenAdapterFromDeviceName
 @ stdcall D3DKMTOpenAdapterFromGdiDisplayName(ptr)
 @ stdcall D3DKMTOpenAdapterFromHdc(ptr) win32u.NtGdiDdDDIOpenAdapterFromHdc
@@ -137,6 +138,7 @@
 @ stdcall D3DKMTQueryResourceInfoFromNtHandle(ptr) win32u.NtGdiDdDDIQueryResourceInfoFromNtHandle
 @ stdcall D3DKMTQueryStatistics(ptr) win32u.NtGdiDdDDIQueryStatistics
 @ stdcall D3DKMTQueryVideoMemoryInfo(ptr) win32u.NtGdiDdDDIQueryVideoMemoryInfo
+@ stdcall D3DKMTSetProcessSchedulingPriorityClass(long long)
 @ stdcall D3DKMTSetQueuedLimit(ptr) win32u.NtGdiDdDDISetQueuedLimit
 @ stdcall D3DKMTSetVidPnSourceOwner(ptr) win32u.NtGdiDdDDISetVidPnSourceOwner
 @ stdcall D3DKMTShareObjects(long ptr ptr long ptr) win32u.NtGdiDdDDIShareObjects
--- a/dlls/gdi32/objects.c
+++ b/dlls/gdi32/objects.c
@@ -897,6 +897,52 @@
     return NtUserD3DKMTOpenAdapterFromGdiDisplayName( desc );
 }
 
+/* The GPU scheduling priority class of this process, as set by
+ * D3DKMTSetProcessSchedulingPriorityClass. There is no GPU scheduler to give
+ * it to; programs set it and go on (OBS Studio imports the call and aborted
+ * at start without it). */
+static LONG gpu_priority_class = D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL;
+
+static BOOL is_current_process( HANDLE process )
+{
+    return process == GetCurrentProcess() || GetProcessId( process ) == GetCurrentProcessId();
+}
+
+/***********************************************************************
+ *           D3DKMTSetProcessSchedulingPriorityClass    (GDI32.@)
+ */
+NTSTATUS WINAPI D3DKMTSetProcessSchedulingPriorityClass( HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS priority )
+{
+    TRACE( "(%p, %d)\n", process, priority );
+
+#ifdef SG_MUTANT_NOGPUPRIORITY
+    return STATUS_NOT_IMPLEMENTED;
+#endif
+    if ((UINT)priority > D3DKMT_SCHEDULINGPRIORITYCLASS_REALTIME) return STATUS_INVALID_PARAMETER;
+    if (!is_current_process( process ))
+        return GetProcessId( process ) ? STATUS_SUCCESS : STATUS_INVALID_HANDLE;
+    InterlockedExchange( &gpu_priority_class, priority );
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           D3DKMTGetProcessSchedulingPriorityClass    (GDI32.@)
+ */
+NTSTATUS WINAPI D3DKMTGetProcessSchedulingPriorityClass( HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS *priority )
+{
+    TRACE( "(%p, %p)\n", process, priority );
+
+    if (!priority) return STATUS_INVALID_PARAMETER;
+    if (!is_current_process( process ))
+    {
+        if (!GetProcessId( process )) return STATUS_INVALID_HANDLE;
+        *priority = D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL;
+        return STATUS_SUCCESS;
+    }
+    *priority = gpu_priority_class;
+    return STATUS_SUCCESS;
+}
+
 /***********************************************************************
  *           SetObjectOwner    (GDI32.@)
  */
