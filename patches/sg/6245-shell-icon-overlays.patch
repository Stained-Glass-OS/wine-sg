+/* an item's overlay (1..15, 0 for none), asked of the folder once and kept */
+static int ShellView_Overlay(IShellViewImpl *This, LPCITEMIDLIST pidl)
+{
+    UINT size, i;
+    int overlay = 0;
+
+    if (!pidl) return 0;
+    if (!This->overlay_asked)
+    {
+        This->overlay_asked = TRUE;
+        if (FAILED(IShellFolder_QueryInterface(This->pSFParent, &IID_IShellIconOverlay, (void **)&This->icon_overlay)))
+            This->icon_overlay = NULL;
+    }
+    if (!This->icon_overlay) return 0;
+    size = ILGetSize(pidl);
+    for (i = 0; i < This->n_overlays; i++)
+        if (ILGetSize(This->overlays[i].child) == size && !memcmp(This->overlays[i].child, pidl, size))
+            return This->overlays[i].overlay;
+
+    if (IShellIconOverlay_GetOverlayIndex(This->icon_overlay, pidl, &overlay) != S_OK) overlay = 0;
+    if (overlay < 0 || overlay > 15) overlay = 0;
+    if (This->n_overlays == This->max_overlays)
+    {
+        UINT n = max(64, This->max_overlays * 2);
+        struct view_overlay *grown = realloc(This->overlays, n * sizeof(*grown));
+        if (!grown) return overlay;
+        This->overlays = grown;
+        This->max_overlays = n;
+    }
+    if ((This->overlays[This->n_overlays].child = ILClone(pidl)))
+        This->overlays[This->n_overlays++].overlay = overlay;
+
+    /* the view's own list (large icons, thumbnails) holds the picture too */
+    if (overlay && This->own_icons && !This->own_overlay_set[overlay])
+    {
+        int own = ShellView_OwnIcon(This, SHELL32_OverlayImage(overlay));
+        if (own >= 0) ImageList_SetOverlayImage(This->own_icons, own, overlay);
+        This->own_overlay_set[overlay] = TRUE;
+    }
+    return overlay;
+}
+
+/* an item's overlay asked again (its state changed) */
+static void ShellView_ForgetOverlay(IShellViewImpl *This, LPCITEMIDLIST pidl)
+{
+    UINT size = ILGetSize(pidl), i;
+
+    for (i = 0; i < This->n_overlays; i++)
+        if (ILGetSize(This->overlays[i].child) == size && !memcmp(This->overlays[i].child, pidl, size))
+        {
+            ILFree(This->overlays[i].child);
+            This->overlays[i] = This->overlays[--This->n_overlays];
+            return;
+        }
+}
+
+static void ShellView_FreeOverlays(IShellViewImpl *This)
+{
+    UINT i;
+
+    for (i = 0; i < This->n_overlays; i++) ILFree(This->overlays[i].child);
+    free(This->overlays);
+    This->overlays = NULL;
+    This->n_overlays = This->max_overlays = 0;
+}
