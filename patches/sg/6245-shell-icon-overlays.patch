         if (!cfShellIDList) cfShellIDList = RegisterClipboardFormatW(CFSTR_SHELLIDLISTW);
@@ -1354,6 +1364,69 @@ static const ISFHelperVtbl shvt =
     ISFHelper_fnDeleteItems,
 };
 
+/* ---- IShellIconOverlay: the overlay of an item, from the registered overlay handlers (6245) ---- */
+static HRESULT WINAPI overlay_QueryInterface(IShellIconOverlay *iface, REFIID riid, void **obj)
+{
+    IGenericSFImpl *This = impl_from_IShellIconOverlay(iface);
+    return IUnknown_QueryInterface(This->outer_unk, riid, obj);
+}
+
+static ULONG WINAPI overlay_AddRef(IShellIconOverlay *iface)
+{
+    IGenericSFImpl *This = impl_from_IShellIconOverlay(iface);
+    return IUnknown_AddRef(This->outer_unk);
+}
+
+static ULONG WINAPI overlay_Release(IShellIconOverlay *iface)
+{
+    IGenericSFImpl *This = impl_from_IShellIconOverlay(iface);
+    return IUnknown_Release(This->outer_unk);
+}
+
+static int item_overlay(IGenericSFImpl *This, PCUITEMID_CHILD pidl, int *image)
+{
+    WCHAR path[MAX_PATH], name[MAX_PATH];
+    SFGAOF attributes = SFGAO_FOLDER | SFGAO_FILESYSTEM | SFGAO_LINK | SFGAO_READONLY | SFGAO_HIDDEN | SFGAO_SHARE;
+
+    if (!pidl || !This->sPathTarget || !_ILSimpleGetTextW(pidl, name, ARRAY_SIZE(name))) return 0;
+    if (!PathCombineW(path, This->sPathTarget, name)) return 0;
+    if (FAILED(IShellFolder2_GetAttributesOf(&This->IShellFolder2_iface, 1, &pidl, &attributes))) attributes = 0;
+    return SHELL32_OverlayForPath(path, attributes, image);
+}
+
+static HRESULT WINAPI overlay_GetOverlayIndex(IShellIconOverlay *iface, PCUITEMID_CHILD pidl, int *index)
+{
+    IGenericSFImpl *This = impl_from_IShellIconOverlay(iface);
+    int overlay;
+
+    TRACE("(%p)->(%p %p)\n", This, pidl, index);
+    if (!index) return E_INVALIDARG;
+    if (!(overlay = item_overlay(This, pidl, NULL))) return S_FALSE;
+    *index = overlay;
+    return S_OK;
+}
+
+static HRESULT WINAPI overlay_GetOverlayIconIndex(IShellIconOverlay *iface, PCUITEMID_CHILD pidl, int *icon_index)
+{
+    IGenericSFImpl *This = impl_from_IShellIconOverlay(iface);
+    int image;
+
+    TRACE("(%p)->(%p %p)\n", This, pidl, icon_index);
+    if (!icon_index) return E_INVALIDARG;
+    if (!item_overlay(This, pidl, &image) || image < 0) return S_FALSE;
+    *icon_index = image;
+    return S_OK;
+}
+
+static const IShellIconOverlayVtbl overlay_vtbl =
+{
+    overlay_QueryInterface,
+    overlay_AddRef,
+    overlay_Release,
+    overlay_GetOverlayIndex,
+    overlay_GetOverlayIconIndex,
+};
+
