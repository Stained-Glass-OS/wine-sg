From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: icon overlay handlers

The icon overlay handlers programs register under Explorer\ShellIconOverlayIdentifiers -- OneDrive's cloud and check marks, Dropbox's, a version control client's -- were never asked, so File Explorer showed no overlays. As on Windows, the registered names are taken in sorted order (the leading spaces programs put on them count), at most 15; each handler gives its picture, which becomes overlay image 1 to 15 of the shell's image lists; a file system folder answers IShellIconOverlay, the overlay of the first handler, by priority, whose IsMemberOf says the file is its; File Explorer's view shows each item's overlay, asked when the item is first shown and again when the item or its attributes are notified changed. SHGetIconOverlayIndex gives the image of a loaded handler's picture.
---
diff --git a/dlls/shell32/iconcache.c b/dlls/shell32/iconcache.c
index 3ccbda9..93919cd 100644
--- a/dlls/shell32/iconcache.c
+++ b/dlls/shell32/iconcache.c
@@ -21,6 +21,7 @@
 #include <stdarg.h>
 #include <string.h>
 #include <sys/types.h>
+#include <limits.h>
 
 #define COBJMACROS
 
@@ -1087,6 +1088,184 @@ HRESULT WINAPI SHDefExtractIconA(LPCSTR pszIconFile, int iIndex, UINT uFlags,
 }
 
 
+/* ---- icon overlay handlers (Stained Glass OS 6245) ----
+ * The handlers registered under Explorer\ShellIconOverlayIdentifiers (OneDrive's, Dropbox's, a
+ * version control client's) mark the files they know with a small picture over the icon.  As on
+ * Windows: the registered names are taken in sorted order (their leading spaces put them first),
+ * at most 15; each handler is asked for its picture, which becomes an overlay image of the shell's
+ * image lists (1 to 15, LVIS_OVERLAYMASK's range); a file gets the overlay of the first handler,
+ * by priority, whose IsMemberOf says S_OK. */
+
+#define MAX_OVERLAY_HANDLERS 15
+
+struct overlay_handler
+{
+    WCHAR name[64];
+    CLSID clsid;
+    IShellIconOverlayIdentifier *obj;
+    int priority;
+    int image;          /* in the shell's image lists, -1 when not loaded */
+    int overlay;        /* 1..15 */
+    WCHAR icon_file[MAX_PATH];
+    int icon_index;
+};
+
+static struct overlay_handler overlay_handlers[MAX_OVERLAY_HANDLERS];
+static unsigned int overlay_count;
+static BOOL overlays_read;
+static HIMAGELIST overlay_lists_made;   /* the shell's lists the images were put in */
+static CRITICAL_SECTION overlay_cs;
+static CRITICAL_SECTION_DEBUG overlay_cs_debug =
+{
+    0, 0, &overlay_cs,
+    { &overlay_cs_debug.ProcessLocksList, &overlay_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": overlay_cs") }
+};
+static CRITICAL_SECTION overlay_cs = { &overlay_cs_debug, -1, 0, 0, 0, 0 };
+
+static int __cdecl overlay_name_cmp( const void *a, const void *b )
+{
+    return wcscmp( ((const struct overlay_handler *)a)->name, ((const struct overlay_handler *)b)->name );
+}
+
+static void overlay_read_key( HKEY root, struct overlay_handler *list, unsigned int *count, unsigned int max )
+{
+    WCHAR name[64], value[64];
+    DWORD i, len, size;
+    HKEY key, sub;
+
+    if (RegOpenKeyExW( root, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers",
+                       0, KEY_READ, &key )) return;
+    for (i = 0; *count < max; i++)
+    {
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+        if (RegOpenKeyExW( key, name, 0, KEY_READ, &sub )) continue;
+        size = sizeof(value);
+        if (!RegQueryValueExW( sub, NULL, NULL, NULL, (BYTE *)value, &size ) &&
+            SUCCEEDED(CLSIDFromString( value, &list[*count].clsid )))
+        {
+            unsigned int j;
+            for (j = 0; j < *count; j++) if (!wcscmp( list[j].name, name )) break;   /* HKLM's wins */
+            if (j == *count)
+            {
+                lstrcpynW( list[*count].name, name, ARRAY_SIZE(list[*count].name) );
+                (*count)++;
+            }
+        }
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+}
+
+/* the handlers, made the first time an overlay is asked for on this thread's apartment */
+static void overlays_load(void)
+{
+    struct overlay_handler all[64];
+    unsigned int count = 0, i;
+
+    if (overlays_read) return;
+    overlays_read = TRUE;
+#ifdef SG_MUTANT_NO_OVERLAY_HANDLERS
+    return;
+#endif
+    memset( all, 0, sizeof(all) );
+    overlay_read_key( HKEY_LOCAL_MACHINE, all, &count, ARRAY_SIZE(all) );
+    overlay_read_key( HKEY_CURRENT_USER, all, &count, ARRAY_SIZE(all) );
+    qsort( all, count, sizeof(all[0]), overlay_name_cmp );
+    for (i = 0; i < count && overlay_count < MAX_OVERLAY_HANDLERS; i++)
+    {
+        struct overlay_handler *h = &overlay_handlers[overlay_count];
+        DWORD flags = 0;
+        HRESULT hr;
+
+        *h = all[i];
+        h->image = -1;
+        h->overlay = overlay_count + 1;     /* the slot is the place in the sorted list, loaded or not */
+        overlay_count++;
+        hr = CoCreateInstance( &h->clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IShellIconOverlayIdentifier, (void **)&h->obj );
+        if (FAILED(hr))
+        {
+            WARN( "overlay handler %s %s not made: %#lx\n", debugstr_w(h->name), debugstr_guid(&h->clsid), hr );
+            h->obj = NULL;
+            continue;
+        }
+        h->icon_index = 0;
+        if (FAILED(IShellIconOverlayIdentifier_GetOverlayInfo( h->obj, h->icon_file, ARRAY_SIZE(h->icon_file),
+                                                                 &h->icon_index, &flags )) || !(flags & ISIOI_ICONFILE))
+        {
+            WARN( "overlay handler %s gives no picture\n", debugstr_w(h->name) );
+            IShellIconOverlayIdentifier_Release( h->obj );
+            h->obj = NULL;
+            continue;
+        }
+        if (!(flags & ISIOI_ICONINDEX)) h->icon_index = 0;
+        if (FAILED(IShellIconOverlayIdentifier_GetPriority( h->obj, &h->priority ))) h->priority = 100;
+        TRACE( "overlay %d: %s %s %s,%d priority %d\n", h->overlay, debugstr_w(h->name), debugstr_guid(&h->clsid),
+               debugstr_w(h->icon_file), h->icon_index, h->priority );
+    }
+}
+
+/* the pictures as overlay images of the shell's lists (again when the lists are made again) */
+static void overlays_apply(void)
+{
+    unsigned int i, l;
+
+    sic_init();
+    if (overlay_lists_made == shell_imagelists[0]) return;
+    for (i = 0; i < overlay_count; i++)
+    {
+        struct overlay_handler *h = &overlay_handlers[i];
+
+        if (!h->obj) continue;
+        h->image = SIC_GetIconIndex( h->icon_file, h->icon_index, 0 );
+        if (h->image < 0) continue;
+        for (l = 0; l < ARRAY_SIZE(shell_imagelists); l++)
+            if (shell_imagelists[l]) ImageList_SetOverlayImage( shell_imagelists[l], h->image, h->overlay );
+    }
+    overlay_lists_made = shell_imagelists[0];
+}
+
+/* the overlay (1..15) of a file, from the handlers by priority; 0 when none marks it */
+int SHELL32_OverlayForPath( const WCHAR *path, DWORD attributes, int *image )
+{
+    int best = 0, best_priority = INT_MAX;
+    unsigned int i;
+
+    if (image) *image = -1;
+    if (!path || !path[0]) return 0;
+    EnterCriticalSection( &overlay_cs );
+    overlays_load();
+    overlays_apply();
+    for (i = 0; i < overlay_count; i++)
+    {
+        struct overlay_handler *h = &overlay_handlers[i];
+
+        if (!h->obj || h->image < 0 || h->priority >= best_priority) continue;
+        if (IShellIconOverlayIdentifier_IsMemberOf( h->obj, path, attributes ) == S_OK)
+        {
+            best = h->overlay;
+            best_priority = h->priority;
+            if (image) *image = h->image;
+        }
+    }
+    LeaveCriticalSection( &overlay_cs );
+    return best;
+}
+
+/* the system image list index of an overlay (1..15), -1 when it has none */
+int SHELL32_OverlayImage( int overlay )
+{
+    int image = -1;
+
+    EnterCriticalSection( &overlay_cs );
+    overlays_load();
+    overlays_apply();
+    if (overlay >= 1 && overlay <= (int)overlay_count) image = overlay_handlers[overlay - 1].image;
+    LeaveCriticalSection( &overlay_cs );
+    return image;
+}
+
 /****************************************************************************
  * SHGetIconOverlayIndexA    [SHELL32.@]
  *
@@ -1094,9 +1273,12 @@ HRESULT WINAPI SHDefExtractIconA(LPCSTR pszIconFile, int iIndex, UINT uFlags,
  */
 INT WINAPI SHGetIconOverlayIndexA(LPCSTR pszIconPath, INT iIconIndex)
 {
-  FIXME("%s, %d\n", debugstr_a(pszIconPath), iIconIndex);
+  WCHAR path[MAX_PATH];
 
-  return -1;
+  TRACE("%s, %d\n", debugstr_a(pszIconPath), iIconIndex);
+  if (!pszIconPath) return SHGetIconOverlayIndexW(NULL, iIconIndex);
+  MultiByteToWideChar(CP_ACP, 0, pszIconPath, -1, path, ARRAY_SIZE(path));
+  return SHGetIconOverlayIndexW(path, iIconIndex);
 }
 
 /****************************************************************************
@@ -1106,9 +1288,25 @@ INT WINAPI SHGetIconOverlayIndexA(LPCSTR pszIconPath, INT iIconIndex)
  */
 INT WINAPI SHGetIconOverlayIndexW(LPCWSTR pszIconPath, INT iIconIndex)
 {
-  FIXME("%s, %d\n", debugstr_w(pszIconPath), iIconIndex);
-
-  return -1;
+  int ret = -1;
+  unsigned int i;
+
+  TRACE("%s, %d\n", debugstr_w(pszIconPath), iIconIndex);
+
+  /* the reserved overlays (share, shortcut, slow file): a shortcut's arrow is drawn into its icon here */
+  if (!pszIconPath) return -1;
+  EnterCriticalSection( &overlay_cs );
+  overlays_load();
+  overlays_apply();
+  for (i = 0; i < overlay_count; i++)
+      if (overlay_handlers[i].obj && overlay_handlers[i].icon_index == iIconIndex &&
+          !wcsicmp( overlay_handlers[i].icon_file, pszIconPath ))
+      {
+          ret = overlay_handlers[i].image;
+          break;
+      }
+  LeaveCriticalSection( &overlay_cs );
+  return ret;
 }
 
