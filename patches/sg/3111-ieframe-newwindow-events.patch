From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 21:58:16 -0700
Subject: [PATCH] ieframe, mshtml: window.open in a browser goes through the
 host's NewWindow events

A page in a WebBrowser/InternetExplorer browser that calls window.open (or
follows a link to a new window) now fires NewWindow3 at the host, with the
context URL and the target URL, and NewWindow2 at a sink that does not know
NewWindow3. The host can cancel (window.open returns null) or hand over the
browser that gets the page (ppDisp); otherwise the browser creates a new
Internet Explorer window as before. IHlinkFrame::Navigate accepts
HLNF_OPENINNEWWINDOW for this; mshtml asks the host's frame first and only
falls back to making a browser itself when the document is not hosted by a
WebBrowser.

diff --git a/dlls/ieframe/events.c b/dlls/ieframe/events.c
index 00b2a35..02fad02 100644
--- a/dlls/ieframe/events.c
+++ b/dlls/ieframe/events.c
@@ -25,6 +25,7 @@
 #include <string.h>
 
 #include "ieframe.h"
+#include "exdispid.h"
 
 #include "wine/debug.h"
 
@@ -588,6 +589,61 @@ void call_sink(ConnectionPoint *This, DISPID dispid, DISPPARAMS *dispparams)
     }
 }
 
+/* NewWindow3 goes to every sink; a sink that does not know it gets NewWindow2 instead. */
+void fire_new_window(ConnectionPoint *This, DWORD flags, const WCHAR *context_url, const WCHAR *url,
+                     IDispatch **ppdisp, VARIANT_BOOL *cancel)
+{
+    DWORD i;
+
+    *ppdisp = NULL;
+    *cancel = VARIANT_FALSE;
+
+    for(i=0; i<This->sinks_size; i++) {
+        VARIANT args[5];
+        DISPPARAMS dp = {args, NULL, 0, 0};
+        IDispatch *sink = This->sinks[i];
+        BSTR bstr_context, bstr_url;
+        HRESULT hres;
+
+        if(!sink)
+            continue;
+        IDispatch_AddRef(sink);
+
+        bstr_context = SysAllocString(context_url ? context_url : L"");
+        bstr_url = SysAllocString(url ? url : L"");
+
+        V_VT(args) = VT_BSTR;
+        V_BSTR(args) = bstr_url;
+        V_VT(args+1) = VT_BSTR;
+        V_BSTR(args+1) = bstr_context;
+        V_VT(args+2) = VT_I4;
+        V_I4(args+2) = flags;
+        V_VT(args+3) = VT_BOOL|VT_BYREF;
+        V_BOOLREF(args+3) = cancel;
+        V_VT(args+4) = VT_DISPATCH|VT_BYREF;
+        V_DISPATCHREF(args+4) = ppdisp;
+        dp.cArgs = 5;
+        hres = IDispatch_Invoke(sink, DISPID_NEWWINDOW3, &IID_NULL, LOCALE_SYSTEM_DEFAULT,
+                                DISPATCH_METHOD, &dp, NULL, NULL, NULL);
+#ifdef SG_MUTANT_IEFRAME_NOFALLBACK
+        hres = S_OK;
+#endif
+        if(hres == DISP_E_MEMBERNOTFOUND || hres == E_NOTIMPL) {
+            V_VT(args) = VT_BOOL|VT_BYREF;
+            V_BOOLREF(args) = cancel;
+            V_VT(args+1) = VT_DISPATCH|VT_BYREF;
+            V_DISPATCHREF(args+1) = ppdisp;
+            dp.cArgs = 2;
+            IDispatch_Invoke(sink, DISPID_NEWWINDOW2, &IID_NULL, LOCALE_SYSTEM_DEFAULT,
+                             DISPATCH_METHOD, &dp, NULL, NULL, NULL);
+        }
+
+        SysFreeString(bstr_context);
+        SysFreeString(bstr_url);
+        IDispatch_Release(sink);
+    }
+}
+
 static void ConnectionPoint_Create(REFIID riid, ConnectionPoint **cp,
                                    IConnectionPointContainer *container)
 {
diff --git a/dlls/ieframe/ieframe.h b/dlls/ieframe/ieframe.h
index 8abc398..6d189de 100644
--- a/dlls/ieframe/ieframe.h
+++ b/dlls/ieframe/ieframe.h
@@ -288,6 +288,7 @@ void ConnectionPointContainer_Init(ConnectionPointContainer*,IUnknown*);
 void ConnectionPointContainer_Destroy(ConnectionPointContainer*);
 
 void call_sink(ConnectionPoint*,DISPID,DISPPARAMS*);
+void fire_new_window(ConnectionPoint*,DWORD,const WCHAR*,const WCHAR*,IDispatch**,VARIANT_BOOL*);
 HRESULT navigate_url(DocHost*,LPCWSTR,const VARIANT*,const VARIANT*,VARIANT*,VARIANT*);
 HRESULT go_home(DocHost*);
 HRESULT go_back(DocHost*);
diff --git a/dlls/ieframe/navigate.c b/dlls/ieframe/navigate.c
index 48cd599..ee098f6 100644
--- a/dlls/ieframe/navigate.c
+++ b/dlls/ieframe/navigate.c
@@ -1224,16 +1224,93 @@ static HRESULT WINAPI HlinkFrame_GetBrowseContext(IHlinkFrame *iface,
     return E_NOTIMPL;
 }
 
+/* A navigation to a new window: the host gets NewWindow3/NewWindow2 first. It can cancel,
+ * or hand over the browser that gets the page; otherwise a new browser is created.
+ * The browser that got the navigation is left in the bind context's object parameters
+ * under L"WineNewWindowBrowser" for the caller, which wants its window. */
+static HRESULT navigate_new_window_hlink(HlinkFrame *This, DWORD grfHLNF, LPBC pbc, IBindStatusCallback *pibsc,
+                                         IMoniker *mon, const WCHAR *name)
+{
+    ITargetFramePriv2 *target_frame;
+    IWebBrowser2 *browser = NULL;
+    VARIANT_BOOL cancel;
+    IDispatch *disp;
+    BOOL created = FALSE;
+    IUriContainer *uri_container;
+    IUri *uri = NULL;
+    LPWSTR url;
+    HRESULT hres;
+
+    hres = IMoniker_GetDisplayName(mon, NULL, NULL, &url);
+    if(FAILED(hres))
+        return hres;
+
+#ifdef SG_MUTANT_IEFRAME_NONEWWIN
+    disp = NULL; cancel = VARIANT_FALSE;
+    if(0)
+#endif
+    fire_new_window(This->doc_host->cps.wbe2, 0, This->doc_host->url, url, &disp, &cancel);
+    CoTaskMemFree(url);
+    if(cancel) {
+        if(disp)
+            IDispatch_Release(disp);
+        TRACE("cancelled by the host\n");
+        return S_OK;
+    }
+
+    if(disp) {
+        hres = IDispatch_QueryInterface(disp, &IID_IWebBrowser2, (void**)&browser);
+        IDispatch_Release(disp);
+        if(FAILED(hres))
+            return hres;
+    }else {
+        hres = CoCreateInstance(&CLSID_InternetExplorer, NULL, CLSCTX_LOCAL_SERVER, &IID_IWebBrowser2, (void**)&browser);
+        if(FAILED(hres))
+            return hres;
+        created = TRUE;
+    }
+
+    hres = IMoniker_QueryInterface(mon, &IID_IUriContainer, (void**)&uri_container);
+    if(SUCCEEDED(hres)) {
+        hres = IUriContainer_GetIUri(uri_container, &uri);
+        IUriContainer_Release(uri_container);
+    }
+    if(SUCCEEDED(hres))
+        hres = IWebBrowser2_QueryInterface(browser, &IID_ITargetFramePriv2, (void**)&target_frame);
+    if(SUCCEEDED(hres)) {
+        hres = ITargetFramePriv2_AggregatedNavigation2(target_frame, HLNF_DISABLEWINDOWRESTRICTIONS|HLNF_OPENINNEWWINDOW,
+                pbc, pibsc, name, uri, L"");
+        ITargetFramePriv2_Release(target_frame);
+    }
+    if(uri)
+        IUri_Release(uri);
+
+    if(FAILED(hres)) {
+        if(created)
+            IWebBrowser2_Quit(browser);
+        IWebBrowser2_Release(browser);
+        return hres;
+    }
+
+    if(created)
+        IWebBrowser2_put_Visible(browser, VARIANT_TRUE);
+    if(pbc)
+        IBindCtx_RegisterObjectParam(pbc, (LPOLESTR)L"WineNewWindowBrowser", (IUnknown*)browser);
+    IWebBrowser2_Release(browser);
+    return S_OK;
+}
+
 static HRESULT WINAPI HlinkFrame_Navigate(IHlinkFrame *iface, DWORD grfHLNF, LPBC pbc,
                                           IBindStatusCallback *pibsc, IHlink *pihlNavigate)
 {
     HlinkFrame *This = impl_from_IHlinkFrame(iface);
     IMoniker *mon;
     LPWSTR location = NULL;
+    HRESULT hres;
 
     TRACE("(%p)->(%08lx %p %p %p)\n", This, grfHLNF, pbc, pibsc, pihlNavigate);
 
-    if(grfHLNF)
+    if(grfHLNF & ~HLNF_OPENINNEWWINDOW)
         FIXME("unsupported grfHLNF=%08lx\n", grfHLNF);
 
     /* Windows calls GetTargetFrameName here. */
@@ -1248,8 +1325,15 @@ static HRESULT WINAPI HlinkFrame_Navigate(IHlinkFrame *iface, DWORD grfHLNF, LPB
     /* Windows calls GetHlinkSite here */
 
     if(grfHLNF & HLNF_OPENINNEWWINDOW) {
-        FIXME("Not supported HLNF_OPENINNEWWINDOW\n");
-        return E_NOTIMPL;
+        LPWSTR name = NULL;
+
+        if(!mon)
+            return E_FAIL;
+        IHlink_GetTargetFrameName(pihlNavigate, &name);
+        hres = navigate_new_window_hlink(This, grfHLNF, pbc, pibsc, mon, name);
+        CoTaskMemFree(name);
+        IMoniker_Release(mon);
+        return hres;
     }
 
     return navigate_hlink(This->doc_host, mon, pbc, pibsc);
diff --git a/dlls/mshtml/navigate.c b/dlls/mshtml/navigate.c
index 90ca22e..bf8b6fa 100644
--- a/dlls/mshtml/navigate.c
+++ b/dlls/mshtml/navigate.c
@@ -2367,6 +2367,74 @@ done:
     return hres;
 }
 
+/* In a WebBrowser host the new window is the host's to decide on: it gets NewWindow3/NewWindow2
+ * from the browser, which also makes the window when the host provides none. */
+static HRESULT navigate_new_window_in_host(HTMLOuterWindow *window, IUri *uri, const WCHAR *name,
+        request_data_t *request_data, IHTMLWindow2 **ret)
+{
+    IHlinkFrame *hlink_frame;
+    IWebBrowser2 *browser;
+    nsChannelBSC *bsc;
+    IBindCtx *bind_ctx;
+    IHlink *hlink;
+    IMoniker *mon;
+    IUnknown *unk;
+    HRESULT hres;
+
+    hres = do_query_service((IUnknown*)window->browser->doc->client, &IID_IHlinkFrame, &IID_IHlinkFrame,
+                            (void**)&hlink_frame);
+    if(FAILED(hres))
+        return E_NOTIMPL;
+
+    if(request_data)
+        hres = create_channelbsc(NULL, request_data->headers, request_data->post_data, request_data->post_data_len,
+                                 FALSE, &bsc);
+    else
+        hres = create_channelbsc(NULL, NULL, NULL, 0, FALSE, &bsc);
+    if(FAILED(hres)) {
+        IHlinkFrame_Release(hlink_frame);
+        return hres;
+    }
+
+    hres = CreateAsyncBindCtx(0, &bsc->bsc.IBindStatusCallback_iface, NULL, &bind_ctx);
+    if(SUCCEEDED(hres))
+        hres = CoCreateInstance(&CLSID_StdHlink, NULL, CLSCTX_INPROC_SERVER, &IID_IHlink, (void**)&hlink);
+    if(SUCCEEDED(hres)) {
+        hres = CreateURLMonikerEx2(NULL, uri, &mon, 0);
+        if(SUCCEEDED(hres)) {
+            IHlink_SetMonikerReference(hlink, HLINKSETF_TARGET, mon, NULL);
+            IHlink_SetTargetFrameName(hlink, name && *name ? name : L"_blank");
+            hres = IHlinkFrame_Navigate(hlink_frame, HLNF_OPENINNEWWINDOW, bind_ctx,
+                    &bsc->bsc.IBindStatusCallback_iface, hlink);
+            IMoniker_Release(mon);
+        }
+        IHlink_Release(hlink);
+    }
+
+    if(hres == S_OK) {
+        /* the browser that got the page: none when the host cancelled the window */
+        *ret = NULL;
+        if(SUCCEEDED(IBindCtx_GetObjectParam(bind_ctx, (LPOLESTR)L"WineNewWindowBrowser", &unk))) {
+            if(SUCCEEDED(IUnknown_QueryInterface(unk, &IID_IWebBrowser2, (void**)&browser))) {
+                IHTMLWindow2 *new_window;
+
+                if(SUCCEEDED(do_query_service((IUnknown*)browser, &SID_SHTMLWindow, &IID_IHTMLWindow2,
+                                              (void**)&new_window))) {
+                    *ret = new_window;
+                }
+                IWebBrowser2_Release(browser);
+            }
+            IUnknown_Release(unk);
+        }
+    }
+
+    if(bind_ctx)
+        IBindCtx_Release(bind_ctx);
+    IBindStatusCallback_Release(&bsc->bsc.IBindStatusCallback_iface);
+    IHlinkFrame_Release(hlink_frame);
+    return hres;
+}
+
 HRESULT navigate_new_window(HTMLOuterWindow *window, IUri *uri, const WCHAR *name, request_data_t *request_data, IHTMLWindow2 **ret)
 {
     INewWindowManager *new_window_mgr;
@@ -2412,6 +2480,21 @@ HRESULT navigate_new_window(HTMLOuterWindow *window, IUri *uri, const WCHAR *nam
     }
 
 
+    if(window->browser->doc->webbrowser) {
+        IHTMLWindow2 *host_window = NULL;
+
+        hres = navigate_new_window_in_host(window, uri, name, request_data, &host_window);
+        if(hres != E_NOTIMPL) {
+            if(SUCCEEDED(hres)) {
+                if(ret)
+                    *ret = host_window;
+                else if(host_window)
+                    IHTMLWindow2_Release(host_window);
+            }
+            return hres;
+        }
+    }
+
     if(request_data)
         hres = create_channelbsc(NULL, request_data->headers,
                 request_data->post_data, request_data->post_data_len, FALSE,
