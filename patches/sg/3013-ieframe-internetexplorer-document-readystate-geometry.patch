 static HRESULT WINAPI InternetExplorer_PutProperty(IWebBrowser2 *iface, BSTR szProperty, VARIANT vtValue)
 {
     InternetExplorer *This = impl_from_IWebBrowser2(iface);
-    FIXME("(%p)->(%s %s)\n", This, debugstr_w(szProperty), debugstr_variant(&vtValue));
-    return E_NOTIMPL;
+    struct ie_property *props;
+    unsigned int i;
+    HRESULT hres;
+
+    TRACE("(%p)->(%s %s)\n", This, debugstr_w(szProperty), debugstr_variant(&vtValue));
+
+    if(!szProperty)
+        return E_INVALIDARG;
+
+    for(i = 0; i < This->prop_count; i++) {
+        if(!wcsicmp(This->props[i].name, szProperty)) {
+            VariantClear(&This->props[i].value);
+            return VariantCopy(&This->props[i].value, &vtValue);
+        }
+    }
+
+    props = realloc(This->props, (This->prop_count + 1) * sizeof(*props));
+    if(!props)
+        return E_OUTOFMEMORY;
+    This->props = props;
+
+    This->props[This->prop_count].name = SysAllocString(szProperty);
+    VariantInit(&This->props[This->prop_count].value);
+    hres = VariantCopy(&This->props[This->prop_count].value, &vtValue);
+    if(FAILED(hres)) {
+        SysFreeString(This->props[This->prop_count].name);
+        return hres;
+    }
+    This->prop_count++;
+    return S_OK;
 }
 
