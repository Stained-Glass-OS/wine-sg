+static BOOL get_ie_exe_path(WCHAR *path)
+{
+    static const WCHAR iexplore[] = L"\\Internet Explorer\\iexplore.exe";
+    WCHAR *ptr;
+
+    if(GetModuleFileNameW(NULL, path, MAX_PATH)) {
+        ptr = wcsrchr(path, '\\');
+        if(ptr && !wcsicmp(ptr + 1, L"iexplore.exe"))
+            return TRUE;
+    }
+
+    if(FAILED(SHGetFolderPathW(NULL, CSIDL_PROGRAM_FILES, NULL, SHGFP_TYPE_CURRENT, path)))
+        return FALSE;
+    if(wcslen(path) + ARRAY_SIZE(iexplore) > MAX_PATH)
+        return FALSE;
+    wcscat(path, iexplore);
+    return TRUE;
+}
