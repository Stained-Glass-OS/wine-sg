+static void test_properties(IWebBrowser2 *wb)
+{
+    VARIANT_BOOL b;
+    IDispatch *disp;
+    VARIANT v;
+    LONG l;
+    BSTR str;
+    HRESULT hres;
+
+    hres = IWebBrowser2_put_Left(wb, 10);
+    ok(hres == S_OK, "put_Left failed: %08lx\n", hres);
+    hres = IWebBrowser2_put_Top(wb, 20);
+    ok(hres == S_OK, "put_Top failed: %08lx\n", hres);
+    hres = IWebBrowser2_put_Width(wb, 500);
+    ok(hres == S_OK, "put_Width failed: %08lx\n", hres);
+    hres = IWebBrowser2_put_Height(wb, 400);
+    ok(hres == S_OK, "put_Height failed: %08lx\n", hres);
+
+    l = 0;
+    hres = IWebBrowser2_get_Left(wb, &l);
+    ok(hres == S_OK && l == 10, "get_Left returned %08lx, %ld\n", hres, l);
+    l = 0;
+    hres = IWebBrowser2_get_Top(wb, &l);
+    ok(hres == S_OK && l == 20, "get_Top returned %08lx, %ld\n", hres, l);
+    l = 0;
+    hres = IWebBrowser2_get_Width(wb, &l);
+    ok(hres == S_OK && l == 500, "get_Width returned %08lx, %ld\n", hres, l);
+    l = 0;
+    hres = IWebBrowser2_get_Height(wb, &l);
+    ok(hres == S_OK && l == 400, "get_Height returned %08lx, %ld\n", hres, l);
+
+    disp = NULL;
+    hres = IWebBrowser2_get_Application(wb, &disp);
+    ok(hres == S_OK && disp, "get_Application returned %08lx, %p\n", hres, disp);
+    if(disp) IDispatch_Release(disp);
+
+    b = VARIANT_FALSE;
+    hres = IWebBrowser2_get_TopLevelContainer(wb, &b);
+    ok(hres == S_OK && b == VARIANT_TRUE, "get_TopLevelContainer returned %08lx, %x\n", hres, b);
+
+    str = NULL;
+    hres = IWebBrowser2_get_Name(wb, &str);
+    ok(hres == S_OK && str && *str, "get_Name returned %08lx, %s\n", hres, wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = NULL;
+    hres = IWebBrowser2_get_FullName(wb, &str);
+    ok(hres == S_OK && str && wcsstr(str, L".exe"), "get_FullName returned %08lx, %s\n", hres, wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    str = SysAllocString(L"TestProp");
+    V_VT(&v) = VT_I4;
+    V_I4(&v) = 42;
+    hres = IWebBrowser2_PutProperty(wb, str, v);
+    ok(hres == S_OK, "PutProperty failed: %08lx\n", hres);
+    SysFreeString(str);
+
+    str = SysAllocString(L"testprop");
+    V_VT(&v) = VT_EMPTY;
+    hres = IWebBrowser2_GetProperty(wb, str, &v);
+    ok(hres == S_OK, "GetProperty failed: %08lx\n", hres);
+    ok(V_VT(&v) == VT_I4 && V_I4(&v) == 42, "GetProperty returned vt %d\n", V_VT(&v));
+    SysFreeString(str);
+
+    str = SysAllocString(L"NoSuchProp");
+    V_VT(&v) = VT_I4;
+    hres = IWebBrowser2_GetProperty(wb, str, &v);
+    ok(hres == S_OK, "GetProperty failed: %08lx\n", hres);
+    ok(V_VT(&v) == VT_EMPTY, "GetProperty returned vt %d\n", V_VT(&v));
+    SysFreeString(str);
+
+    hres = IWebBrowser2_put_Silent(wb, VARIANT_TRUE);
+    ok(hres == S_OK, "put_Silent failed: %08lx\n", hres);
+    b = VARIANT_FALSE;
+    hres = IWebBrowser2_get_Silent(wb, &b);
+    ok(hres == S_OK && b == VARIANT_TRUE, "get_Silent returned %08lx, %x\n", hres, b);
+    IWebBrowser2_put_Silent(wb, VARIANT_FALSE);
+
+    hres = IWebBrowser2_put_StatusBar(wb, VARIANT_FALSE);
+    ok(hres == S_OK, "put_StatusBar failed: %08lx\n", hres);
+    b = VARIANT_TRUE;
+    hres = IWebBrowser2_get_StatusBar(wb, &b);
+    ok(hres == S_OK && b == VARIANT_FALSE, "get_StatusBar returned %08lx, %x\n", hres, b);
+    IWebBrowser2_put_StatusBar(wb, VARIANT_TRUE);
+}
