From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: closing a power request's handle ends the request

On Windows the handle is the power request: closing it ends whatever it
asked for. 1678 kept a request set until PowerClearRequest or the
process's end, so a program that closed the handle without clearing it
kept the screen on. NtClose now tells the power request table, which
drops the request and lets the hold go when nothing else asks for it.

Gate: test/powerreq-gate.sh (a request set, its handle closed).
Mutant SG_MUTANT_CLOSE_KEEPS_REQUEST (ntdll/unix/system.c).
---
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1935,6 +1935,8 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
 
     /* Stained Glass OS: deletions the server left to this process (ADR 0013) */
     if (!ret && unlinks_size) sg_client_unlinks( unlinks, unlinks_size );
+    /* Stained Glass OS: a power request goes with its handle */
+    if (!ret) power_request_closed( handle );
 
     if (ret != STATUS_INVALID_HANDLE || !handle) return ret;
     if (!peb->BeingDebugged) return ret;
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4507,6 +4507,30 @@ static BOOL update_power_hold(void)
     return hold;
 }
 
+static LONG power_requests_open;
+
+/* NtClose: the request of a handle closed goes (as on Windows, where the
+ * handle is the request) */
+void power_request_closed( HANDLE handle )
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_CLOSE_KEEPS_REQUEST
+    return;
+#endif
+    if (!ReadNoFence( &power_requests_open )) return;
+    pthread_mutex_lock( &power_mutex );
+    for (i = 0; i < power_request_count; i++)
+    {
+        if (power_requests[i].handle != handle) continue;
+        power_requests[i] = power_requests[--power_request_count];
+        InterlockedDecrement( &power_requests_open );
+        update_power_hold();
+        break;
+    }
+    pthread_mutex_unlock( &power_mutex );
+}
+
 static NTSTATUS power_request_create( HANDLE *ret )
 {
     OBJECT_ATTRIBUTES attr;
@@ -4531,6 +4555,7 @@ static NTSTATUS power_request_create( HANDLE *ret )
     }
     memset( &power_requests[power_request_count], 0, sizeof(power_requests[0]) );
     power_requests[power_request_count++].handle = handle;
+    InterlockedIncrement( &power_requests_open );
     pthread_mutex_unlock( &power_mutex );
     *ret = handle;
     return STATUS_SUCCESS;
@@ -4549,7 +4574,10 @@ static NTSTATUS power_request_action( HANDLE handle, int type, BOOL set )
         if (power_requests[i].handle != handle) continue;
         status = STATUS_SUCCESS;
         if (type < 0)
+        {
             power_requests[i] = power_requests[--power_request_count];
+            InterlockedDecrement( &power_requests_open );
+        }
         else if (set)
             power_requests[i].count[type]++;
         else if (power_requests[i].count[type] > 0)
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -179,6 +179,7 @@ extern SIZE_T startup_info_size;
 extern BOOL is_prefix_bootstrap;
 extern int main_argc;
 extern char **main_argv;
+extern void power_request_closed( HANDLE handle );
 extern WCHAR **main_wargv;
 extern const WCHAR system_dir[];
 extern unsigned int supported_machines_count;
