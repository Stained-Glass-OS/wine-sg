+            memcpy( &value, optval, sizeof(value) );
+            if (server_setsockopt( s, IOCTL_AFD_WINE_SET_SO_ERROR, (char *)&value, sizeof(value) )) return SOCKET_ERROR;
             SetLastError( ERROR_SUCCESS );
             return 0;
+        }
 
         case SO_KEEPALIVE:
             if (optlen <= 0 || !optval)
