+static BOOL WINAPI WS2_DisconnectEx( SOCKET s, OVERLAPPED *overlapped, DWORD flags, DWORD reserved );
+
+/* Stained Glass OS 1688: TransmitPackets. The elements (memory buffers and
+ * file ranges) are sent in order, in pieces of nSendSize; TF_DISCONNECT
+ * and TF_REUSE_SOCKET disconnect after them, as TransmitFile does. The
+ * sending is done here and an overlapped call completes with the bytes
+ * sent (and its completion port told). */
+static int transmit_send_all( SOCKET s, const char *buf, DWORD len, DWORD piece )
+{
+    while (len)
+    {
+        int chunk = piece && piece < len ? piece : len, ret;
+
+        ret = send( s, buf, chunk, 0 );
+        if (ret == SOCKET_ERROR)
+        {
+            fd_set set;
+
+            if (WSAGetLastError() != WSAEWOULDBLOCK) return WSAGetLastError();
+            FD_ZERO( &set );
+            FD_SET( s, &set );
+            if (select( 0, NULL, &set, NULL, NULL ) == SOCKET_ERROR) return WSAGetLastError();
+            continue;
+        }
+        buf += ret;
+        len -= ret;
+    }
+    return 0;
+}
+
+static BOOL WINAPI WS2_TransmitPackets( SOCKET s, TRANSMIT_PACKETS_ELEMENT *elements, DWORD count, DWORD send_size,
+                                        OVERLAPPED *overlapped, DWORD flags )
+{
+    struct { NTSTATUS status; ULONG info; } done;
+    DWORD i, sent = 0;
+    char *buffer = NULL;
+    int err = 0;
+
+    TRACE( "socket %#Ix, elements %p, count %lu, send_size %lu, overlapped %p, flags %#lx\n",
+           s, elements, count, send_size, overlapped, flags );
+
+    if (count && !elements)
+    {
+        SetLastError( WSAEINVAL );
+        return FALSE;
+    }
+    if (send_size == ~0u) send_size = 0;
+
+    for (i = 0; i < count && !err; i++)
+    {
+        TRANSMIT_PACKETS_ELEMENT *el = &elements[i];
+
+        if (el->dwElFlags & TP_ELEMENT_MEMORY)
+        {
+            if (el->cLength && !el->pBuffer)
+            {
+                err = WSAEINVAL;
+                break;
+            }
+#ifndef SG_MUTANT_NO_TRANSMIT
+            err = transmit_send_all( s, el->pBuffer, el->cLength, send_size );
+#endif
+            if (!err) sent += el->cLength;
+        }
+        else if (el->dwElFlags & TP_ELEMENT_FILE)
+        {
+            LARGE_INTEGER offset = el->nFileOffset, size;
+            ULONGLONG left;
+            DWORD got;
+
+            if (!buffer && !(buffer = malloc( 65536 )))
+            {
+                err = WSAENOBUFS;
+                break;
+            }
+            if (offset.QuadPart == -1)
+            {
+                LARGE_INTEGER zero = {{0}};
+                SetFilePointerEx( el->hFile, zero, &offset, FILE_CURRENT );
+            }
+            if (el->cLength) left = el->cLength;
+            else
+            {
+                if (!GetFileSizeEx( el->hFile, &size ))
+                {
+                    err = WSAEINVAL;
+                    break;
+                }
+                left = size.QuadPart > offset.QuadPart ? size.QuadPart - offset.QuadPart : 0;
+            }
+            while (left && !err)
+            {
+                OVERLAPPED ov = {0};
+
+                ov.Offset = offset.LowPart;
+                ov.OffsetHigh = offset.HighPart;
+                if (!ReadFile( el->hFile, buffer, left < 65536 ? left : 65536, &got, &ov ) &&
+                    !(GetLastError() == ERROR_IO_PENDING && GetOverlappedResult( el->hFile, &ov, &got, TRUE )))
+                {
+                    err = GetLastError() == ERROR_HANDLE_EOF ? 0 : WSAEINVAL;
+                    break;
+                }
+                if (!got) break;
+                err = transmit_send_all( s, buffer, got, send_size );
+                if (err) break;
+                sent += got;
+                left -= got;
+                offset.QuadPart += got;
+            }
+        }
+        else if (!(el->dwElFlags & TP_ELEMENT_EOP))
+            err = WSAEINVAL;
+    }
+    free( buffer );
+
+    if (!err && (flags & (TF_DISCONNECT | TF_REUSE_SOCKET)))
+    {
+        if (!WS2_DisconnectEx( s, NULL, flags & TF_REUSE_SOCKET, 0 )) err = WSAGetLastError();
+    }
+
+    if (overlapped)
+    {
+        IO_STATUS_BLOCK *piosb = (IO_STATUS_BLOCK *)overlapped;
+        void *cvalue = ((ULONG_PTR)overlapped->hEvent & 1) ? NULL : overlapped;
+        NTSTATUS status;
+
+        overlapped->Internal = STATUS_PENDING;
+        overlapped->InternalHigh = 0;
+        done.status = err ? STATUS_UNSUCCESSFUL : STATUS_SUCCESS;
+        if (err == WSAECONNRESET) done.status = STATUS_CONNECTION_RESET;
+        done.info = sent;
+        status = NtDeviceIoControlFile( (HANDLE)s, overlapped->hEvent, NULL, cvalue, piosb,
+                                        IOCTL_AFD_WINE_COMPLETE_ASYNC, &done, sizeof(done), NULL, 0 );
+        if (status == STATUS_PENDING) status = STATUS_SUCCESS;
+        if (!err && status) err = NtStatusToWSAError( status );
+    }
+    SetLastError( err );
+    return !err;
+}
+
 static BOOL WINAPI WS2_DisconnectEx( SOCKET s, OVERLAPPED *overlapped, DWORD flags, DWORD reserved )
 {
     IO_STATUS_BLOCK iosb, *piosb = &iosb;
@@ -2614,7 +2754,7 @@ INT WINAPI WSAIoctl(SOCKET s, DWORD code, LPVOID in_buff, DWORD in_size, LPVOID
             EXTENSION_FUNCTION(WSAID_ACCEPTEX, WS2_AcceptEx)
             EXTENSION_FUNCTION(WSAID_GETACCEPTEXSOCKADDRS, WS2_GetAcceptExSockaddrs)
             EXTENSION_FUNCTION(WSAID_TRANSMITFILE, WS2_TransmitFile)
-            /* EXTENSION_FUNCTION(WSAID_TRANSMITPACKETS, WS2_TransmitPackets) */
+            EXTENSION_FUNCTION(WSAID_TRANSMITPACKETS, WS2_TransmitPackets)
             EXTENSION_FUNCTION(WSAID_WSARECVMSG, WS2_WSARecvMsg)
             EXTENSION_FUNCTION(WSAID_WSASENDMSG, WSASendMsg)
         };
@@ -2639,7 +2779,7 @@ INT WINAPI WSAIoctl(SOCKET s, DWORD code, LPVOID in_buff, DWORD in_size, LPVOID
             }
         }
 
-        FIXME("SIO_GET_EXTENSION_FUNCTION_POINTER %s: stub\n", debugstr_guid(in_buff));
+        WARN("SIO_GET_EXTENSION_FUNCTION_POINTER %s: no such function\n", debugstr_guid(in_buff));
         SetLastError( WSAEINVAL );
         return -1;
     }
@@ -3303,9 +3443,20 @@ int WINAPI setsockopt( SOCKET s, int level, int optname, const char *optval, int
         }
 
         case SO_ERROR:
-            FIXME( "SO_ERROR, stub.\n" );
+        {
+            /* Stained Glass OS 1688: kept, getsockopt(SO_ERROR) gives it back */
+            int value;
+
+            if (optlen < sizeof(value) || !optval)
+            {
+                SetLastError( WSAEFAULT );
+                return SOCKET_ERROR;
