             if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
@@ -1877,7 +1880,8 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
             if (needs_close) close( fd );
 
