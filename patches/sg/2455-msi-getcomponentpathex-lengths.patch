From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msi: MsiGetComponentPathEx lengths

Ground truth from Wine's msi test (10 todo_wine marks removed): MsiGetComponentPathEx leaves a length of 0 when it refuses its arguments or does not know the component; given no buffer, the ANSI function reports twice the length it was given; and when the buffer is too small the ANSI function reports the size in bytes of the wide path (the characters otherwise). MsiGetComponentPath (without Ex) keeps leaving the length alone.
---
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -2842,17 +2842,26 @@ static BOOL open_userdata_comp_key( const WCHAR *comp, const WCHAR *usersid, MSI
 
 static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *szComponent,
                                           const WCHAR *szUserSid, MSIINSTALLCONTEXT ctx,
-                                          awstring *lpPathBuf, DWORD *pcchBuf )
+                                          awstring *lpPathBuf, DWORD *pcchBuf, BOOL report_size )
 {
     WCHAR *path = NULL, squashed_pc[SQUASHED_GUID_SIZE], squashed_comp[SQUASHED_GUID_SIZE];
     HKEY hkey;
     INSTALLSTATE state;
     DWORD version;
 
-    if (!szProduct || !szComponent)
+    if (lpPathBuf->str.w && !pcchBuf)
         return INSTALLSTATE_INVALIDARG;
 
-    if (lpPathBuf->str.w && !pcchBuf)
+    /* a refused call reports a length of nothing */
+#ifndef SG_MUTANT_MSI_COMPPATH_SIZE
+    if (!szProduct || !szComponent || !squash_guid( szProduct, squashed_pc ) ||
+        !squash_guid( szComponent, squashed_comp ) || (szUserSid && ctx == MSIINSTALLCONTEXT_MACHINE))
+    {
+        if (pcchBuf && report_size) *pcchBuf = 0;
+        return INSTALLSTATE_INVALIDARG;
+    }
+#else
+    if (!szProduct || !szComponent)
         return INSTALLSTATE_INVALIDARG;
 
     if (!squash_guid( szProduct, squashed_pc ) || !squash_guid( szComponent, squashed_comp ))
@@ -2860,6 +2869,7 @@ static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *s
 
     if (szUserSid && ctx == MSIINSTALLCONTEXT_MACHINE)
         return INSTALLSTATE_INVALIDARG;
+#endif
 
     state = INSTALLSTATE_UNKNOWN;
 
@@ -2900,13 +2910,29 @@ static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *s
     }
 
     if (!path)
+    {
+#ifndef SG_MUTANT_MSI_COMPPATH_SIZE
+        /* unknown: no length, or for the A function asked for the length twice what was given */
+        if (pcchBuf && report_size)
+        {
+            if (lpPathBuf->str.w) *pcchBuf = 0;
+            else if (!lpPathBuf->unicode) *pcchBuf *= 2;
+        }
+#endif
         return INSTALLSTATE_UNKNOWN;
+    }
 
     if (state == INSTALLSTATE_LOCAL && !*path)
         state = INSTALLSTATE_NOTUSED;
 
     if (msi_strcpy_to_awstring(path, -1, lpPathBuf, pcchBuf) == ERROR_MORE_DATA)
+    {
         state = INSTALLSTATE_MOREDATA;
+#ifndef SG_MUTANT_MSI_COMPPATH_SIZE
+        /* the A function reports the length in bytes of the wide string */
+        if (!lpPathBuf->unicode && pcchBuf && report_size) *pcchBuf = lstrlenW( path ) * sizeof(WCHAR);
+#endif
+    }
 
     free(path);
     return state;
@@ -2915,30 +2941,33 @@ static INSTALLSTATE MSI_GetComponentPath( const WCHAR *szProduct, const WCHAR *s
 /******************************************************************
  * MsiGetComponentPathExW      [MSI.@]
  */
-INSTALLSTATE WINAPI MsiGetComponentPathExW( LPCWSTR product, LPCWSTR comp, LPCWSTR usersid,
-                                            MSIINSTALLCONTEXT ctx, LPWSTR buf, LPDWORD buflen )
+static INSTALLSTATE component_path_w( LPCWSTR product, LPCWSTR comp, LPCWSTR usersid, MSIINSTALLCONTEXT ctx,
+                                     LPWSTR buf, LPDWORD buflen, BOOL report_size )
 {
     awstring path;
 
-    TRACE( "%s %s %s 0x%x %p %p\n", debugstr_w(product), debugstr_w(comp), debugstr_w(usersid),
-           ctx, buf, buflen );
-
     path.unicode = TRUE;
     path.str.w   = buf;
 
-    return MSI_GetComponentPath( product, comp, usersid, ctx, &path, buflen );
+    return MSI_GetComponentPath( product, comp, usersid, ctx, &path, buflen, report_size );
 }
 
-INSTALLSTATE WINAPI MsiGetComponentPathExA( LPCSTR product, LPCSTR comp, LPCSTR usersid,
-                                            MSIINSTALLCONTEXT ctx, LPSTR buf, LPDWORD buflen )
+INSTALLSTATE WINAPI MsiGetComponentPathExW( LPCWSTR product, LPCWSTR comp, LPCWSTR usersid,
+                                            MSIINSTALLCONTEXT ctx, LPWSTR buf, LPDWORD buflen )
+{
+    TRACE( "%s %s %s 0x%x %p %p\n", debugstr_w(product), debugstr_w(comp), debugstr_w(usersid),
+           ctx, buf, buflen );
+
+    return component_path_w( product, comp, usersid, ctx, buf, buflen, TRUE );
+}
+
+static INSTALLSTATE component_path_a( LPCSTR product, LPCSTR comp, LPCSTR usersid, MSIINSTALLCONTEXT ctx,
+                                     LPSTR buf, LPDWORD buflen, BOOL report_size )
 {
     WCHAR *productW = NULL, *compW = NULL, *usersidW =  NULL;
     INSTALLSTATE r = INSTALLSTATE_UNKNOWN;
     awstring path;
 
-    TRACE( "%s %s %s 0x%x %p %p\n", debugstr_a(product), debugstr_a(comp), debugstr_a(usersid),
-           ctx, buf, buflen );
-
     if (product && !(productW = strdupAtoW( product ))) return INSTALLSTATE_UNKNOWN;
     if (comp && !(compW = strdupAtoW( comp ))) goto end;
     if (usersid && !(usersidW = strdupAtoW( usersid ))) goto end;
@@ -2946,7 +2975,7 @@ INSTALLSTATE WINAPI MsiGetComponentPathExA( LPCSTR product, LPCSTR comp, LPCSTR
     path.unicode = FALSE;
     path.str.a   = buf;
 
-    r = MSI_GetComponentPath( productW, compW, usersidW, ctx, &path, buflen );
+    r = MSI_GetComponentPath( productW, compW, usersidW, ctx, &path, buflen, report_size );
 
 end:
     free( productW );
@@ -2956,12 +2985,21 @@ end:
     return r;
 }
 
+INSTALLSTATE WINAPI MsiGetComponentPathExA( LPCSTR product, LPCSTR comp, LPCSTR usersid,
+                                            MSIINSTALLCONTEXT ctx, LPSTR buf, LPDWORD buflen )
+{
+    TRACE( "%s %s %s 0x%x %p %p\n", debugstr_a(product), debugstr_a(comp), debugstr_a(usersid),
+           ctx, buf, buflen );
+
+    return component_path_a( product, comp, usersid, ctx, buf, buflen, TRUE );
+}
+
 /******************************************************************
  * MsiGetComponentPathW      [MSI.@]
  */
 INSTALLSTATE WINAPI MsiGetComponentPathW( LPCWSTR product, LPCWSTR comp, LPWSTR buf, LPDWORD buflen )
 {
-    return MsiGetComponentPathExW( product, comp, L"S-1-1-0", MSIINSTALLCONTEXT_ALL, buf, buflen );
+    return component_path_w( product, comp, L"S-1-1-0", MSIINSTALLCONTEXT_ALL, buf, buflen, FALSE );
 }
 
 /******************************************************************
@@ -2969,7 +3007,7 @@ INSTALLSTATE WINAPI MsiGetComponentPathW( LPCWSTR product, LPCWSTR comp, LPWSTR
  */
 INSTALLSTATE WINAPI MsiGetComponentPathA( LPCSTR product, LPCSTR comp, LPSTR buf, LPDWORD buflen )
 {
-    return MsiGetComponentPathExA( product, comp, "s-1-1-0", MSIINSTALLCONTEXT_ALL, buf, buflen );
+    return component_path_a( product, comp, "s-1-1-0", MSIINSTALLCONTEXT_ALL, buf, buflen, FALSE );
 }
 
 static UINT query_feature_state( const WCHAR *product, const WCHAR *squashed, const WCHAR *usersid,
@@ -3485,7 +3523,7 @@ static UINT MSI_ProvideQualifiedComponentEx(LPCWSTR szComponent,
         StringFromGUID2( &guid, comp, ARRAY_SIZE( comp ));
     }
 
-    state = MSI_GetComponentPath( szProduct, comp, L"S-1-1-0", MSIINSTALLCONTEXT_ALL, lpPathBuf, pcchPathBuf );
+    state = MSI_GetComponentPath( szProduct, comp, L"S-1-1-0", MSIINSTALLCONTEXT_ALL, lpPathBuf, pcchPathBuf, FALSE );
 
     if (state == INSTALLSTATE_MOREDATA) return ERROR_MORE_DATA;
     if (state != INSTALLSTATE_LOCAL) return ERROR_FILE_NOT_FOUND;
--- a/dlls/msi/tests/msi.c
+++ b/dlls/msi/tests/msi.c
@@ -2956,25 +2956,25 @@ static void test_MsiGetComponentPathEx(void)
     size = MAX_PATH;
     state = MsiGetComponentPathExA( NULL, comp, NULL, MSIINSTALLCONTEXT_USERMANAGED, path, &size );
     ok( state == INSTALLSTATE_INVALIDARG, "got %d\n", state );
-    todo_wine ok( !size, "got %lu\n", size );
+    ok( !size, "got %lu\n", size );
 
     /* NULL component */
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, NULL, NULL, MSIINSTALLCONTEXT_USERMANAGED, path, &size );
     ok( state == INSTALLSTATE_INVALIDARG, "got %d\n", state );
-    todo_wine ok( !size, "got %lu\n", size );
+    ok( !size, "got %lu\n", size );
 
     /* non-NULL usersid, MSIINSTALLCONTEXT_MACHINE */
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, usersid, MSIINSTALLCONTEXT_MACHINE, path, &size);
     ok( state == INSTALLSTATE_INVALIDARG, "got %d\n", state );
-    todo_wine ok( !size, "got %lu\n", size );
+    ok( !size, "got %lu\n", size );
 
     /* NULL buf */
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_MACHINE, NULL, &size );
     ok( state == INSTALLSTATE_UNKNOWN, "got %d\n", state );
-    todo_wine ok( size == MAX_PATH * 2, "got %lu\n", size );
+    ok( size == MAX_PATH * 2, "got %lu\n", size );
 
     /* NULL buflen */
     size = MAX_PATH;
@@ -2986,7 +2986,7 @@ static void test_MsiGetComponentPathEx(void)
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_MACHINE, path, &size );
     ok( state == INSTALLSTATE_UNKNOWN, "got %d\n", state );
-    todo_wine ok( !size, "got %lu\n", size );
+    ok( !size, "got %lu\n", size );
 
     lstrcpyA( path_key, "Software\\Microsoft\\Windows\\CurrentVersion\\" );
     lstrcatA( path_key, "Installer\\UserData\\S-1-5-18\\Components\\" );
@@ -3045,7 +3045,7 @@ static void test_MsiGetComponentPathEx(void)
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_MACHINE, path, &size );
     ok( state == INSTALLSTATE_MOREDATA, "got %d\n", state );
     ok( !path[0], "got %s\n", path );
-    todo_wine ok( size == 40, "got %lu\n", size );
+    ok( size == 40, "got %lu\n", size );
 
     path[0] = 0;
     size = MAX_PATH;
@@ -3072,7 +3072,7 @@ static void test_MsiGetComponentPathEx(void)
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_USERUNMANAGED, path, &size );
     ok( state == INSTALLSTATE_UNKNOWN, "got %d\n", state );
-    todo_wine ok(!size, "got %lu\n", size);
+    ok(!size, "got %lu\n", size);
 
     lstrcpyA( path_key, "Software\\Microsoft\\Windows\\CurrentVersion\\" );
     lstrcatA( path_key, "Installer\\UserData\\" );
@@ -3087,7 +3087,7 @@ static void test_MsiGetComponentPathEx(void)
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_USERUNMANAGED, path, &size );
     ok( state == INSTALLSTATE_UNKNOWN, "got %d\n", state );
-    todo_wine ok(!size, "got %lu\n", size);
+    ok(!size, "got %lu\n", size);
 
     res = RegSetValueExA( key_comp, prod_squashed, 0, REG_SZ, (const BYTE *)"c:\\testcomponentpath", 20 );
     ok( res == ERROR_SUCCESS, "got %ld\n", res );
@@ -3211,7 +3211,7 @@ static void test_MsiGetComponentPathEx(void)
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_MACHINE, path, &size );
     ok( state == INSTALLSTATE_UNKNOWN, "got %d\n", state );
-    todo_wine ok(!size, "got %lu\n", size);
+    ok(!size, "got %lu\n", size);
 
     lstrcpyA( path_key, "Software\\Microsoft\\Windows\\CurrentVersion\\" );
     lstrcatA( path_key, "Installer\\UserData\\S-1-5-18\\Components\\" );
@@ -3224,7 +3224,7 @@ static void test_MsiGetComponentPathEx(void)
     size = MAX_PATH;
     state = MsiGetComponentPathExA( prod, comp, NULL, MSIINSTALLCONTEXT_MACHINE, path, &size );
     ok( state == INSTALLSTATE_UNKNOWN, "got %d\n", state );
-    todo_wine ok(!size, "got %lu\n", size);
+    ok(!size, "got %lu\n", size);
 
     res = RegSetValueExA( key_comp, prod_squashed, 0, REG_SZ, (const BYTE *)"c:\\testcomponentpath", 20 );
     ok( res == ERROR_SUCCESS, "got %ld\n", res );
