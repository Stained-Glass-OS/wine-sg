 }
 
+/* Stained Glass OS (wine-sg 7880): a windowed primary surface is presented once a refresh, as
+ * Windows' compositor shows a window's changes -- at the next vertical blank, whatever was drawn
+ * since. 7860 presented the whole window after every Blt, BltFast, Unlock or ReleaseDC: a
+ * program drawing 200 sprites a frame paid 200 presents a frame (on llvmpipe a third of the
+ * old front buffer path's speed). An update now only marks the primary as waiting; a thread of
+ * ours presents it at the next blank on the grid WaitForVerticalBlank keeps (ddraw.c: a frame
+ * every 1 / refresh rate from a fixed origin), so it shows within one refresh, also when the
+ * program draws nothing more. WaitForVerticalBlank presents at once (the program says its
+ * frame is done), and so does the end of the surface or of the swap chain. Reading the primary
+ * (Lock, GetDC) needs no present: it holds everything drawn to it, the screen only shows it.
+ * The waiting ddraw objects are listed under the wined3d lock, which the thread takes to
+ * present, so an object leaves the list before it is gone. */
+static struct list sg_pending_list = LIST_INIT(sg_pending_list);
+static HANDLE sg_presenter_event;
+
+static HRESULT ddraw_surface_present_window(struct ddraw_surface *surface);
+
+static LONGLONG ddraw_refresh_period(struct ddraw *ddraw)
+{
+    struct wined3d_display_mode mode;
+    LARGE_INTEGER freq;
+
+    QueryPerformanceFrequency(&freq);
+    if (FAILED(wined3d_output_get_display_mode(ddraw->wined3d_output, &mode, NULL)) || mode.refresh_rate < 2)
+        mode.refresh_rate = 60;
+    return max(freq.QuadPart / mode.refresh_rate, 1);
+}
+
+/* the wined3d lock is held */
+void ddraw_surface_flush_present(struct ddraw *ddraw)
+{
+    struct ddraw_surface *surface = ddraw->sg_pending_surface;
+
+    if (!surface)
+        return;
+    ddraw->sg_pending_surface = NULL;
+    list_remove(&ddraw->sg_pending_entry);
+    if (ddraw->wined3d_swapchain && ddraw->swapchain_window && !(ddraw->cooperative_level & DDSCL_EXCLUSIVE))
+        ddraw_surface_present_window(surface);
+}
+
+static DWORD WINAPI ddraw_presenter_thread(void *arg)
+{
+    DWORD timeout = INFINITE;
+    LARGE_INTEGER freq, now;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_ddraw_present");
+    QueryPerformanceFrequency(&freq);
+    for (;;)
+    {
+        struct ddraw *ddraw, *next;
+        LONGLONG soonest = 0;
+
+        WaitForSingleObject(sg_presenter_event, timeout);
+        wined3d_mutex_lock();
+        QueryPerformanceCounter(&now);
+        LIST_FOR_EACH_ENTRY_SAFE(ddraw, next, &sg_pending_list, struct ddraw, sg_pending_entry)
+        {
+            if (ddraw->sg_pending_due <= now.QuadPart)
+            {
+                ddraw_surface_flush_present(ddraw);
+                /* the display mode may have changed since */
+                ddraw->sg_refresh_period = ddraw_refresh_period(ddraw);
+            }
+            else if (!soonest || ddraw->sg_pending_due < soonest)
+                soonest = ddraw->sg_pending_due;
+        }
+        wined3d_mutex_unlock();
+        timeout = soonest ? (DWORD)(((soonest - now.QuadPart) * 1000 + freq.QuadPart - 1) / freq.QuadPart) : INFINITE;
+    }
+    return 0;
+}
+
+/* the wined3d lock is held */
+static HRESULT ddraw_surface_present_later(struct ddraw_surface *surface)
+{
+    struct ddraw *ddraw = surface->ddraw;
+    LARGE_INTEGER now;
+
+    if (!sg_presenter_event)
+    {
+        HMODULE module;
+        HANDLE event, thread;
+
+        /* the thread runs code of ours until the process ends */
+        if (!(event = CreateEventW(NULL, FALSE, FALSE, NULL)))
+            return ddraw_surface_present_window(surface);
+        GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                (const WCHAR *)ddraw_presenter_thread, &module);
+        sg_presenter_event = event;
+        if (!(thread = CreateThread(NULL, 0, ddraw_presenter_thread, NULL, 0, NULL)))
+        {
+            sg_presenter_event = NULL;
+            CloseHandle(event);
+            return ddraw_surface_present_window(surface);
+        }
+        SetThreadPriority(thread, THREAD_PRIORITY_ABOVE_NORMAL);
+        CloseHandle(thread);
+    }
+
+    if (ddraw->sg_pending_surface)
+    {
+        ddraw->sg_pending_surface = surface;
+        return DD_OK;
+    }
+    if (!ddraw->sg_refresh_period)
+        ddraw->sg_refresh_period = ddraw_refresh_period(ddraw);
+    QueryPerformanceCounter(&now);
+    ddraw->sg_pending_due = (now.QuadPart / ddraw->sg_refresh_period + 1) * ddraw->sg_refresh_period;
+    ddraw->sg_pending_surface = surface;
+    list_add_tail(&sg_pending_list, &ddraw->sg_pending_entry);
+    TRACE("surface %p presented in %I64d counts.\n", surface, ddraw->sg_pending_due - now.QuadPart);
+    SetEvent(sg_presenter_event);
+    return DD_OK;
+}
+
 /* This is slow, of course. Also, in case of locks, we can't prevent other
  * applications from drawing to the screen while we've locked the frontbuffer.
  * We'd like to do this in wined3d instead, but for that to work wined3d needs
@@ -192,8 +308,12 @@
 
 #ifndef SG_MUTANT_DDRAW_FRONT_BUFFER_DRAWN
         if (!swap_interval && !(ddraw->cooperative_level & DDSCL_EXCLUSIVE))
+#ifndef SG_MUTANT_DDRAW_PRESENT_EACH_UPDATE
+            return ddraw_surface_present_later(surface);
+#else
             return ddraw_surface_present_window(surface);
 #endif
