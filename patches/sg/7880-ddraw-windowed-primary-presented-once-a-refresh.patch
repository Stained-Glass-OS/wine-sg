--- a/dlls/ddraw/ddraw.c
+++ b/dlls/ddraw/ddraw.c
@@ -381,6 +381,11 @@
 
     TRACE("Destroying the swapchain.\n");
 
+    /* wine-sg 7880: a windowed primary waiting for the next refresh is shown now */
+    wined3d_mutex_lock();
+    ddraw_surface_flush_present(ddraw);
+    wined3d_mutex_unlock();
+
     wined3d_swapchain_decref(ddraw->wined3d_swapchain);
 
     for (i = 0; i < ddraw->numConvertedDecls; ++i)
@@ -436,6 +441,8 @@
 
     wined3d_mutex_lock();
     list_remove(&This->ddraw_list_entry);
+    /* wine-sg 7880: off the presenter's list (surface.c) */
+    ddraw_surface_flush_present(This);
     wined3d_mutex_unlock();
 
     if (This->wined3d_swapchain)
@@ -2217,6 +2224,12 @@
     if (Flags != DDWAITVB_BLOCKBEGIN && Flags != DDWAITVB_BLOCKEND)
         return DDERR_INVALIDPARAMS;
 
+    /* wine-sg 7880: the program's frame is done: a windowed primary waiting for the next
