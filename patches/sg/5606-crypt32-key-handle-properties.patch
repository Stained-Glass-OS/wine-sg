--- a/dlls/crypt32/crypt32_private.h
+++ b/dlls/crypt32/crypt32_private.h
@@ -431,8 +431,35 @@ struct store_CERT_KEY_CONTEXT
     DWORD   cbSize;
     DWORD64 hCryptProv;
     DWORD   dwKeySpec;
+    DWORD   dwOwned;   /* the context releases the handle when it is replaced or removed */
 };
 void CRYPT_ConvertKeyContext(const struct store_CERT_KEY_CONTEXT *src, CERT_KEY_CONTEXT *dst);
+BOOL CRYPT_SetKeyProperty(CONTEXT_PROPERTY_LIST *properties, DWORD dwPropId, DWORD dwFlags, const void *pvData,
+ BOOL *handled);
+BOOL CRYPT_GetKeyProperty(CONTEXT_PROPERTY_LIST *properties, DWORD dwPropId, void *pvData, DWORD *pcbData,
+ BOOL *handled);
+
+static inline BOOL CRYPT_IsKeyProperty(DWORD id)
+{
+    switch (id)
+    {
+    case CERT_KEY_CONTEXT_PROP_ID:
+    case CERT_KEY_PROV_HANDLE_PROP_ID:
+    case CERT_KEY_PROV_INFO_PROP_ID:
+    case CERT_KEY_SPEC_PROP_ID:
+    case CERT_NCRYPT_KEY_HANDLE_PROP_ID:
+    case CERT_HCRYPTPROV_OR_NCRYPT_KEY_HANDLE_PROP_ID:
+    case 99: /* CERT_NCRYPT_KEY_HANDLE_TRANSFER_PROP_ID */
+    case 100: /* CERT_HCRYPTPROV_TRANSFER_PROP_ID */
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+/* property ids Windows' wincrypt.h gives the transfer properties */
+#define CERT_NCRYPT_KEY_HANDLE_TRANSFER_PROP_ID_ 99
+#define CERT_HCRYPTPROV_TRANSFER_PROP_ID_        100
 
