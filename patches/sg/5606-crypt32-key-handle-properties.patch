From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] crypt32: key handle properties of certificates, CRLs and CTLs

crypt32: key handle properties on certificates, CRLs and CTLs

CERT_KEY_PROV_HANDLE_PROP_ID, CERT_NCRYPT_KEY_HANDLE_PROP_ID,
CERT_KEY_CONTEXT_PROP_ID, CERT_KEY_SPEC_PROP_ID and the two transfer ids are
kept in the property list the way a certificate keeps them. A handle the
context owns is released when it is replaced; one set with
CERT_STORE_NO_CRYPT_RELEASE_FLAG is not. CRLs and CTLs accept the same
properties.
---
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -633,15 +633,18 @@ BOOL WINAPI CertGetCertificateContextProperty(PCCERT_CONTEXT pCertContext,
         ret = CertGetStoreProperty(cert->ctx.hCertStore, dwPropId, pvData, pcbData);
         break;
     case CERT_KEY_PROV_HANDLE_PROP_ID:
+    case CERT_NCRYPT_KEY_HANDLE_PROP_ID:
+    case CERT_HCRYPTPROV_OR_NCRYPT_KEY_HANDLE_PROP_ID:
     {
-        CERT_KEY_CONTEXT keyContext;
-        DWORD size = sizeof(keyContext);
+        BOOL handled;
 
-        ret = CertContext_GetProperty(cert,
-         CERT_KEY_CONTEXT_PROP_ID, &keyContext, &size);
-        if (ret)
-            ret = CertContext_CopyParam(pvData, pcbData, &keyContext.hCryptProv,
-             sizeof(keyContext.hCryptProv));
+        if (!cert->base.properties)
+        {
+            SetLastError(CRYPT_E_NOT_FOUND);
+            ret = FALSE;
+        }
+        else
+            ret = CRYPT_GetKeyProperty(cert->base.properties, dwPropId, pvData, pcbData, &handled);
         break;
     }
     case CERT_KEY_PROV_INFO_PROP_ID:
@@ -691,19 +694,230 @@ static BOOL CertContext_SetKeyProvInfoProperty(CONTEXT_PROPERTY_LIST *properties
     return ret;
 }
 
-static BOOL CertContext_SetKeyContextProperty(CONTEXT_PROPERTY_LIST *properties,
- const CERT_KEY_CONTEXT *keyContext)
+static BOOL CertContext_SetKeyContextOwned(CONTEXT_PROPERTY_LIST *properties,
+ const CERT_KEY_CONTEXT *keyContext, BOOL owned)
 {
     struct store_CERT_KEY_CONTEXT ctx;
 
     ctx.cbSize = sizeof(ctx);
     ctx.hCryptProv = keyContext->hCryptProv;
     ctx.dwKeySpec = keyContext->dwKeySpec;
+    ctx.dwOwned = owned;
 
     return ContextPropertyList_SetProperty(properties, CERT_KEY_CONTEXT_PROP_ID,
      (const BYTE *)&ctx, ctx.cbSize);
 }
 
+static BOOL CertContext_SetKeyContextProperty(CONTEXT_PROPERTY_LIST *properties,
+ const CERT_KEY_CONTEXT *keyContext)
+{
+    return CertContext_SetKeyContextOwned(properties, keyContext, FALSE);
+}
+
+static BOOL get_key_context(CONTEXT_PROPERTY_LIST *properties, CERT_KEY_CONTEXT *keyContext, BOOL *owned)
+{
+    CRYPT_DATA_BLOB blob;
+    const struct store_CERT_KEY_CONTEXT *stored;
+
+    if (!ContextPropertyList_FindProperty(properties, CERT_KEY_CONTEXT_PROP_ID, &blob))
+        return FALSE;
+    stored = (const struct store_CERT_KEY_CONTEXT *)blob.pbData;
+    CRYPT_ConvertKeyContext(stored, keyContext);
+    if (owned) *owned = blob.cbData >= sizeof(*stored) && stored->dwOwned;
+    return TRUE;
+}
+
+static void release_key_handle(ULONG_PTR handle, DWORD key_spec)
+{
+    if (!handle) return;
+#ifdef SG_MUTANT_KEY_NO_RELEASE
+    return;
+#endif
+    if (key_spec == CERT_NCRYPT_KEY_SPEC) NCryptFreeObject(handle);
+    else CryptReleaseContext(handle, 0);
+}
+
+/* the key handle in a context's key context is replaced; the previous one is
+ * released if the context owned it */
+static BOOL set_key_handle(CONTEXT_PROPERTY_LIST *properties, ULONG_PTR handle, DWORD key_spec, BOOL owned)
+{
+    CERT_KEY_CONTEXT keyContext;
+    DWORD prov_spec = 0;
+    CRYPT_DATA_BLOB blob;
+    BOOL old_owned;
+
+    if (get_key_context(properties, &keyContext, &old_owned))
+    {
+#ifdef SG_MUTANT_KEY_ALWAYS_RELEASE
+        old_owned = TRUE;
+#endif
+        if (old_owned) release_key_handle(keyContext.hCryptProv, keyContext.dwKeySpec);
+        prov_spec = keyContext.dwKeySpec;
+    }
+    else if (ContextPropertyList_FindProperty(properties, CERT_KEY_PROV_INFO_PROP_ID, &blob))
+        prov_spec = ((const CRYPT_KEY_PROV_INFO *)blob.pbData)->dwKeySpec;
+    keyContext.cbSize = sizeof(keyContext);
+    keyContext.hCryptProv = handle;
+#ifdef SG_MUTANT_KEY_NO_NCRYPT_SPEC
+    if (key_spec == CERT_NCRYPT_KEY_SPEC) key_spec = AT_KEYEXCHANGE;
+#endif
+    keyContext.dwKeySpec = key_spec ? key_spec : (prov_spec == CERT_NCRYPT_KEY_SPEC ? 0 : prov_spec);
+    return CertContext_SetKeyContextOwned(properties, &keyContext, owned);
+}
+
+/* Setting the properties that describe a context's private key; shared by
+ * certificates, CRLs and CTLs. Sets *handled to FALSE for any other property. */
+BOOL CRYPT_SetKeyProperty(CONTEXT_PROPERTY_LIST *properties, DWORD dwPropId, DWORD dwFlags, const void *pvData,
+ BOOL *handled)
+{
+    BOOL ret;
+
+    *handled = TRUE;
+    switch (dwPropId)
+    {
+    case CERT_KEY_SPEC_PROP_ID:
+        if (pvData)
+            ret = ContextPropertyList_SetProperty(properties, dwPropId, pvData, sizeof(DWORD));
+        else
+        {
+            ContextPropertyList_RemoveProperty(properties, dwPropId);
+            ret = TRUE;
+        }
+        break;
+    case CERT_KEY_CONTEXT_PROP_ID:
+        if (pvData)
+        {
+            const CERT_KEY_CONTEXT *keyContext = pvData;
+
+            if (keyContext->cbSize != sizeof(CERT_KEY_CONTEXT))
+            {
+                SetLastError(E_INVALIDARG);
+                ret = FALSE;
+            }
+            else
+                ret = CertContext_SetKeyContextProperty(properties, pvData);
+        }
+        else
+        {
+            ContextPropertyList_RemoveProperty(properties, dwPropId);
+            ret = TRUE;
+        }
+        break;
+    case CERT_KEY_PROV_INFO_PROP_ID:
+        if (pvData)
+            ret = CertContext_SetKeyProvInfoProperty(properties, pvData);
+        else
+        {
+            ContextPropertyList_RemoveProperty(properties, dwPropId);
+            ret = TRUE;
+        }
+        break;
+    case CERT_KEY_PROV_HANDLE_PROP_ID:
+    case CERT_HCRYPTPROV_TRANSFER_PROP_ID_:
+    {
+        BOOL owned = dwPropId == CERT_HCRYPTPROV_TRANSFER_PROP_ID_ || !(dwFlags & CERT_STORE_NO_CRYPT_RELEASE_FLAG);
+
+        if (pvData)
+            ret = set_key_handle(properties, *(const HCRYPTPROV *)pvData, 0, owned);
+        else
+        {
+            CERT_KEY_CONTEXT keyContext;
+            BOOL old_owned;
+
+            if (get_key_context(properties, &keyContext, &old_owned) && old_owned)
+                release_key_handle(keyContext.hCryptProv, keyContext.dwKeySpec);
+            keyContext.cbSize = sizeof(keyContext);
+            keyContext.hCryptProv = 0;
+            keyContext.dwKeySpec = AT_SIGNATURE;
+            ret = CertContext_SetKeyContextProperty(properties, &keyContext);
+        }
+        break;
+    }
+    case CERT_HCRYPTPROV_OR_NCRYPT_KEY_HANDLE_PROP_ID:
+        if (pvData && NCryptIsKeyHandle(*(const NCRYPT_KEY_HANDLE *)pvData))
+        {
+            ret = set_key_handle(properties, *(const NCRYPT_KEY_HANDLE *)pvData, CERT_NCRYPT_KEY_SPEC,
+             !(dwFlags & CERT_STORE_NO_CRYPT_RELEASE_FLAG));
+            break;
+        }
+        if (pvData)
+        {
+            ret = set_key_handle(properties, *(const HCRYPTPROV_OR_NCRYPT_KEY_HANDLE *)pvData, 0,
+             !(dwFlags & CERT_STORE_NO_CRYPT_RELEASE_FLAG));
+            break;
+        }
+        /* fall through */
+    case CERT_NCRYPT_KEY_HANDLE_PROP_ID:
+    case CERT_NCRYPT_KEY_HANDLE_TRANSFER_PROP_ID_:
+    {
+        BOOL owned = dwPropId == CERT_NCRYPT_KEY_HANDLE_TRANSFER_PROP_ID_ || !(dwFlags & CERT_STORE_NO_CRYPT_RELEASE_FLAG);
+
+        if (pvData)
+            ret = set_key_handle(properties, *(const NCRYPT_KEY_HANDLE *)pvData, CERT_NCRYPT_KEY_SPEC, owned);
+        else
+        {
+            CERT_KEY_CONTEXT keyContext;
+            BOOL old_owned;
+
+            if (get_key_context(properties, &keyContext, &old_owned) && keyContext.dwKeySpec == CERT_NCRYPT_KEY_SPEC)
+            {
+                if (old_owned) release_key_handle(keyContext.hCryptProv, keyContext.dwKeySpec);
+                ContextPropertyList_RemoveProperty(properties, CERT_KEY_CONTEXT_PROP_ID);
+            }
+            ret = TRUE;
+        }
+        break;
+    }
+    default:
+        *handled = FALSE;
+        ret = FALSE;
+    }
+    return ret;
+}
+
+/* Reading them back: the key context in the layout programs use, and the handles in it */
+BOOL CRYPT_GetKeyProperty(CONTEXT_PROPERTY_LIST *properties, DWORD dwPropId, void *pvData, DWORD *pcbData,
+ BOOL *handled)
+{
+    CERT_KEY_CONTEXT keyContext;
+    ULONG_PTR handle;
+
+    *handled = TRUE;
+    switch (dwPropId)
+    {
+    case CERT_KEY_CONTEXT_PROP_ID:
+        if (!get_key_context(properties, &keyContext, NULL)) break;
+        return CertContext_CopyParam(pvData, pcbData, &keyContext, keyContext.cbSize);
+    case CERT_KEY_PROV_INFO_PROP_ID:
+    {
+        CRYPT_DATA_BLOB blob;
+        BOOL ret;
+
+        if (!ContextPropertyList_FindProperty(properties, dwPropId, &blob)) break;
+        ret = CertContext_CopyParam(pvData, pcbData, blob.pbData, blob.cbData);
+        if (ret && pvData) fix_KeyProvInfoProperty(pvData);
+        return ret;
+    }
+    case CERT_KEY_PROV_HANDLE_PROP_ID:
+        if (!get_key_context(properties, &keyContext, NULL)) break;
+        handle = keyContext.hCryptProv;
+        return CertContext_CopyParam(pvData, pcbData, &handle, sizeof(handle));
+    case CERT_NCRYPT_KEY_HANDLE_PROP_ID:
+        if (!get_key_context(properties, &keyContext, NULL) || keyContext.dwKeySpec != CERT_NCRYPT_KEY_SPEC) break;
+        handle = keyContext.hCryptProv;
+        return CertContext_CopyParam(pvData, pcbData, &handle, sizeof(handle));
+    case CERT_HCRYPTPROV_OR_NCRYPT_KEY_HANDLE_PROP_ID:
+        if (!get_key_context(properties, &keyContext, NULL)) break;
+        handle = keyContext.hCryptProv;
+        return CertContext_CopyParam(pvData, pcbData, &handle, sizeof(handle));
+    default:
+        *handled = FALSE;
+        return FALSE;
+    }
+    SetLastError(CRYPT_E_NOT_FOUND);
+    return FALSE;
+}
+
 static BOOL CertContext_SetProperty(cert_t *cert, DWORD dwPropId,
  DWORD dwFlags, const void *pvData)
 {
@@ -728,6 +942,10 @@ static BOOL CertContext_SetProperty(cert_t *cert, DWORD dwPropId,
