+static NCRYPT_KEY_HANDLE create_ncrypt_key(NCRYPT_PROV_HANDLE *prov)
+{
+    NCRYPT_KEY_HANDLE key = 0;
+    SECURITY_STATUS status;
+
+    status = NCryptOpenStorageProvider(prov, NULL, 0);
+    if (status) return 0;
+    status = NCryptCreatePersistedKey(*prov, &key, BCRYPT_RSA_ALGORITHM, NULL, 0, 0);
+    if (!status) status = NCryptFinalizeKey(key, 0);
+    if (status)
+    {
+        if (key) NCryptFreeObject(key);
+        return 0;
+    }
+    return key;
+}
+
+static void testCertKeyHandleProperties(void)
+{
+    NCRYPT_PROV_HANDLE nprov = 0;
+    NCRYPT_KEY_HANDLE k1, k2, k3, got;
+    HCRYPTPROV capi = 0, capi_got;
+    CERT_KEY_CONTEXT ctx;
+    PCCERT_CONTEXT cert;
+    DWORD size;
+    BOOL ret;
+
+    k1 = create_ncrypt_key(&nprov);
+    if (!k1)
+    {
+        skip("no software key\n");
+        return;
+    }
+    k2 = create_ncrypt_key(&nprov);
+    k3 = create_ncrypt_key(&nprov);
+    ok(k2 && k3 && k2 != k1 && k3 != k2, "got keys %#Ix, %#Ix, %#Ix\n", k1, k2, k3);
+    ret = CryptAcquireContextA(&capi, NULL, MS_DEF_PROV_A, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT);
+    ok(ret, "CryptAcquireContextA failed: %08lx\n", GetLastError());
+
+    cert = CertCreateCertificateContext(X509_ASN_ENCODING, bigCert, sizeof(bigCert));
+    ok(!!cert, "CertCreateCertificateContext failed: %08lx\n", GetLastError());
+
+    /* nothing is set */
+    size = sizeof(got);
+    SetLastError(0xdeadbeef);
+    ret = CertGetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, &got, &size);
+    ok(!ret && GetLastError() == CRYPT_E_NOT_FOUND, "got %d, error %08lx\n", ret, GetLastError());
+
+    /* an NCRYPT_KEY_HANDLE, and the key spec becomes CERT_NCRYPT_KEY_SPEC */
+    ret = CertSetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, CERT_STORE_NO_CRYPT_RELEASE_FLAG, &k1);
+    ok(ret, "CertSetCertificateContextProperty failed: %08lx\n", GetLastError());
+    size = sizeof(got);
+    got = 0;
+    ret = CertGetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, &got, &size);
+    ok(ret && got == k1 && size == sizeof(got), "got %d, handle %#Ix, size %lu\n", ret, got, size);
+    size = sizeof(ctx);
+    memset(&ctx, 0, sizeof(ctx));
+    ret = CertGetCertificateContextProperty(cert, CERT_KEY_CONTEXT_PROP_ID, &ctx, &size);
+    ok(ret, "CertGetCertificateContextProperty failed: %08lx\n", GetLastError());
+    ok(ctx.cbSize == sizeof(ctx) && ctx.hCryptProv == k1, "got size %lu, key %#Ix\n", ctx.cbSize, ctx.hCryptProv);
+    ok(ctx.dwKeySpec == CERT_NCRYPT_KEY_SPEC, "got key spec %#lx\n", ctx.dwKeySpec);
+    size = sizeof(got);
+    got = 0;
+    ret = CertGetCertificateContextProperty(cert, CERT_HCRYPTPROV_OR_NCRYPT_KEY_HANDLE_PROP_ID, &got, &size);
+    ok(ret && got == k1, "got %d, handle %#Ix\n", ret, got);
+
+    /* the context releases a handle it owns when the handle is replaced: that is
+     * every handle set without CERT_STORE_NO_CRYPT_RELEASE_FLAG */
+    ret = CertSetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, CERT_STORE_NO_CRYPT_RELEASE_FLAG, &k2);
+    ok(ret, "CertSetCertificateContextProperty failed: %08lx\n", GetLastError());
+    ok(NCryptIsKeyHandle(k1), "a handle the context did not own was released\n");
+    ret = CertSetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, 0, &k3);
+    ok(ret, "CertSetCertificateContextProperty failed: %08lx\n", GetLastError());
+    ok(NCryptIsKeyHandle(k2), "a handle the context did not own was released\n");
+    ret = CertSetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, CERT_STORE_NO_CRYPT_RELEASE_FLAG, &k1);
+    ok(ret, "CertSetCertificateContextProperty failed: %08lx\n", GetLastError());
+    ok(!NCryptIsKeyHandle(k3), "the handle the context owned was not released\n");
+
+    /* the transfer property gives the handle to the context */
+    ret = CertSetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_TRANSFER_PROP_ID, CERT_STORE_NO_CRYPT_RELEASE_FLAG, &k2);
+    ok(ret, "CertSetCertificateContextProperty failed: %08lx\n", GetLastError());
+    ok(NCryptIsKeyHandle(k1), "a handle the context did not own was released\n");
+    size = sizeof(got);
+    got = 0;
+    ret = CertGetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, &got, &size);
+    ok(ret && got == k2, "got %d, handle %#Ix\n", ret, got);
+    ret = CertSetCertificateContextProperty(cert, CERT_NCRYPT_KEY_HANDLE_PROP_ID, CERT_STORE_NO_CRYPT_RELEASE_FLAG, &k1);
+    ok(ret, "CertSetCertificateContextProperty failed: %08lx\n", GetLastError());
+    ok(!NCryptIsKeyHandle(k2), "the transferred handle was not released\n");
+
