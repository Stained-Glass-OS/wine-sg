+    if (FAILED(ret)) goto cleanup;
+
+    if (resolve_id)
+    {
+        ret = add_child_element(context, search_element, addressingNsUri, endpointReferenceString, NULL, &epr_element);
+        if (FAILED(ret)) goto cleanup;
+        ret = add_child_element(context, epr_element, addressingNsUri, addressString, resolve_id, NULL);
+        if (FAILED(ret)) goto cleanup;
+    }
+    else
+    {
+        if (types_list)
+        {
+            ret = E_OUTOFMEMORY;
+            if (!(buffer = WSDAllocateLinkedMemory(search_element, WSD_MAX_TEXT_LENGTH * sizeof(WCHAR)))) goto cleanup;
+            ret = build_types_list(buffer, WSD_MAX_TEXT_LENGTH * sizeof(WCHAR), types_list, discovered_namespaces);
+            if (FAILED(ret)) goto cleanup;
+            ret = add_child_element(context, search_element, discoveryNsUri, typesString, buffer, NULL);
+            if (FAILED(ret)) goto cleanup;
+        }
+        if (scopes_list)
+        {
+            ret = E_OUTOFMEMORY;
+            if (!(buffer = WSDAllocateLinkedMemory(search_element, WSD_MAX_TEXT_LENGTH * sizeof(WCHAR)))) goto cleanup;
+            ret = build_uri_list(buffer, WSD_MAX_TEXT_LENGTH * sizeof(WCHAR), scopes_list);
+            if (FAILED(ret)) goto cleanup;
+            ret = add_child_element(context, search_element, discoveryNsUri, scopesString, buffer, &scopes_element);
+            if (FAILED(ret)) goto cleanup;
+            if (match_by && FAILED(ret = add_string_attribute(context, scopes_element, NULL, L"MatchBy", match_by)))
+                goto cleanup;
+        }
+    }
+
+    ret = create_soap_envelope(context, &soap_header, body_element, &heap, &xml, &xml_length, discovered_namespaces);
+    if (FAILED(ret)) goto cleanup;
+    ret = E_OUTOFMEMORY;
+    if (!(*out_xml = malloc(xml_length + sizeof(xml_header)))) goto cleanup;
+    memcpy(*out_xml, xml_header, sizeof(xml_header) - 1);
+    memcpy(*out_xml + sizeof(xml_header) - 1, xml, xml_length);
+    *out_len = xml_length + sizeof(xml_header) - 1;
+    (*out_xml)[*out_len] = 0;
+    ret = S_OK;
+
+cleanup:
+    if (heap) WsFreeHeap(heap);
+    WSDFreeLinkedMemory(body_name);
+    WSDFreeLinkedMemory(body_element);
+    WSDFreeLinkedMemory(discovered_namespaces);
+    return ret;
+}
