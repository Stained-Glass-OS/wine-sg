From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wsdapi: the discovery provider (WS-Discovery client)

WSDCreateDiscoveryProvider returned E_NOTIMPL. IWSDiscoveryProvider now searches by type and scope
(multicast Probe, ProbeMatches relating to it for MATCH_TIMEOUT), by id (Resolve, ends at its
match) and by address (directed Probe over HTTP), reports IWSDiscoveredService objects through
the sink with SearchComplete or SearchFailed(S_FALSE), and hears Hello/Bye only while a sink is
attached (the UDP 3702 listener is closed by Detach or by releasing the provider).
The publisher's listener now binds the wildcard address (bound to the adapter's unicast address
it never received the group's datagrams on Linux), and Probes without Types reach its handler.
Also fixed: a Types list of two or more names crashed the reader; the types and URI list writers
checked their bounds in bytes against characters; Probe/Resolve need no AppSequence.
---
diff --git a/dlls/wsdapi/Makefile.in b/dlls/wsdapi/Makefile.in
index d669ed1..b11f4c5 100644
--- a/dlls/wsdapi/Makefile.in
+++ b/dlls/wsdapi/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = wsdapi.dll
 IMPORTLIB = wsdapi
-IMPORTS   = bcrypt iphlpapi rpcrt4 user32 webservices ws2_32
+IMPORTS   = bcrypt iphlpapi rpcrt4 user32 webservices winhttp ws2_32
 
 SOURCES = \
 	address.c \
@@ -8,5 +8,6 @@ SOURCES = \
 	memory.c \
 	msgparams.c \
 	network.c \
+	provider.c \
 	soap.c \
 	xml.c
diff --git a/dlls/wsdapi/discovery.c b/dlls/wsdapi/discovery.c
index 360100e..fe68140 100644
--- a/dlls/wsdapi/discovery.c
+++ b/dlls/wsdapi/discovery.c
@@ -693,7 +693,9 @@ HRESULT WINAPI WSDCreateDiscoveryPublisher(IWSDXMLContext *pContext, IWSDiscover
 
 HRESULT WINAPI WSDCreateDiscoveryProvider(IWSDXMLContext *context, IWSDiscoveryProvider **provider)
 {
-    FIXME("(%p, %p) stub\n", context, provider);
+    TRACE("(%p, %p)\n", context, provider);
 
-    return E_NOTIMPL;
+    if (!provider) return E_POINTER;
+    *provider = NULL;
+    return create_discovery_provider(context, provider);
 }
diff --git a/dlls/wsdapi/network.c b/dlls/wsdapi/network.c
index 97573c5..fab2ada 100644
--- a/dlls/wsdapi/network.c
+++ b/dlls/wsdapi/network.c
@@ -412,8 +412,15 @@ static int start_listening(IWSDiscoveryPublisherImpl *impl, SOCKADDR_STORAGE *bi
         address_length = sizeof(SOCKADDR_IN6);
     }
 
-    /* Update the port for the binding address */
+    /* Bind to the wildcard address with the discovery port: on Linux a socket bound to the adapter's unicast
+     * address never receives the datagrams sent to the multicast group, so probes went unheard. The group is
+     * still joined on this adapter only, below. */
+#ifdef SG_MUTANT_WSD_BIND_UNICAST
     memcpy(&bind_addr, bind_address, address_length);
+#else
+    memset(&bind_addr, 0, sizeof(bind_addr));
+    bind_addr.ss_family = bind_address->ss_family;
+#endif
     ((SOCKADDR_IN *)&bind_addr)->sin_port = htons(SEND_PORT);
 
     /* Update the port for the interface address */
diff --git a/dlls/wsdapi/provider.c b/dlls/wsdapi/provider.c
new file mode 100644
index 0000000..6adf97f
--- /dev/null
+++ b/dlls/wsdapi/provider.c
@@ -0,0 +1,1061 @@
+/*
+ * Web Services on Devices: the discovery provider (the client side of WS-Discovery)
+ *
