+/* ---- for the discovery provider (provider.c) ---- */
+
+/* a Probe (types, scopes) or, with resolve_id, a Resolve, to "to" (the discovery URN for multicast, the device's
+ * address for a directed probe): the whole document, with its message ID */
+HRESULT build_search_message(IWSDXMLContext *context, LPCWSTR to, const WSD_NAME_LIST *types_list,
+    const WSD_URI_LIST *scopes_list, LPCWSTR match_by, LPCWSTR resolve_id, char **out_xml, ULONG *out_len,
+    WCHAR *message_id)
+{
+    static const char xml_header[] = "<?xml version=\"1.0\" encoding=\"utf-8\"?>";
+    WSDXML_ELEMENT *body_element = NULL, *search_element, *scopes_element = NULL, *epr_element;
+    struct list *discovered_namespaces = NULL;
+    WSDXML_NAME *body_name = NULL;
+    WSD_SOAP_HEADER soap_header;
+    WS_HEAP *heap = NULL;
+    ULONG xml_length = 0;
+    char *xml = NULL;
+    LPWSTR buffer;
+    HRESULT ret = E_OUTOFMEMORY;
+
+    *out_xml = NULL;
+    if (!create_guid(message_id)) return E_FAIL;
+    if (!(discovered_namespaces = WSDAllocateLinkedMemory(NULL, sizeof(struct list)))) return E_OUTOFMEMORY;
+    list_init(discovered_namespaces);
+
+    populate_soap_header(&soap_header, to ? to : discoveryTo, resolve_id ?
+            L"http://schemas.xmlsoap.org/ws/2005/04/discovery/Resolve" : actionProbe, message_id, NULL, NULL);
