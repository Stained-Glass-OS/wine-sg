From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 21:26:02 -0700
Subject: [PATCH] ntdll: getsockopt answers set the status block status for
 wow64 (3280)

In a wow64 build a 32-bit program's status block is copied back by the wow64 thunk only when the unix side wrote the status. The getsockopt answers the unix side builds itself (SO_LINGER, IP_DONTFRAGMENT, IPV6_DONTFRAG) set only Information, so a 32-bit getsockopt returned success with the stack leftover as the option length (ws2_32 sock test: 8 failures in 32-bit, none in 64-bit or on a stock 32-bit build). They now set the status too. CORE review: ntdll unix socket.c, three lines.

diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
index dcc701f..6c9fbb0 100644
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -2132,6 +2132,9 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
             {
                 ws_linger->l_onoff = unix_linger.l_onoff;
                 ws_linger->l_linger = unix_linger.l_linger;
+#ifndef SG_MUTANT_SOCKIOSB_LINGER
+                io->Status = STATUS_SUCCESS;  /* wow64: put_iosb copies back only when the status was set */
+#endif
                 io->Information = sizeof(*ws_linger);
             }
 
@@ -2202,6 +2205,9 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
             }
             else
             {
+#ifndef SG_MUTANT_SOCKIOSB_DONTFRAG
+                io->Status = STATUS_SUCCESS;  /* wow64: put_iosb copies back only when the status was set */
+#endif
                 io->Information = len;
                 status = STATUS_SUCCESS;
             }
@@ -2434,6 +2440,9 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
             }
             else
             {
+#ifndef SG_MUTANT_SOCKIOSB_DONTFRAG
+                io->Status = STATUS_SUCCESS;  /* wow64: put_iosb copies back only when the status was set */
+#endif
                 io->Information = len;
                 status = STATUS_SUCCESS;
             }
