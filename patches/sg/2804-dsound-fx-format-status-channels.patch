+/* the data the mixer reads: the application's buffer, or its processed copy
+ * when the buffer has effects */
+static inline BYTE *dsb_source(const IDirectSoundBufferImpl *dsb)
+{
+    return dsb->fx_shadow ? dsb->fx_shadow : dsb->buffer->memory;
+}
+
+/* Run the buffer's effects over the next source frames. The effects work on
+ * the buffer's own format; the application's data is left untouched, the
+ * mixer reads the processed copy instead. */
+static void DSOUND_FxPrepare(IDirectSoundBufferImpl *dsb, UINT frames)
+{
+    DWORD stride = dsb->pwfx->nBlockAlign, pos = dsb->sec_mixpos, left;
+    int i;
+
+    if (!dsb->num_filters || !stride)
+        return;
+    if (!dsb->fx_shadow && !(dsb->fx_shadow = malloc(dsb->buflen)))
+        return;
+
+    left = min((DWORD)frames * stride, dsb->buflen);
+    while (left && pos < dsb->buflen) {
+        DWORD chunk = min(left, dsb->buflen - pos);
+
+        memcpy(dsb->fx_shadow + pos, dsb->buffer->memory + pos, chunk);
+        for (i = 0; i < dsb->num_filters; i++) {
+            HRESULT hr;
+
+            if (!dsb->filters[i].inplace) {
+                WARN("filter %u has no inplace object - unsupported\n", i);
+                continue;
+            }
+            hr = IMediaObjectInPlace_Process(dsb->filters[i].inplace, chunk, dsb->fx_shadow + pos, 0,
+                    DMO_INPLACE_NORMAL);
+            if (FAILED(hr))
+                WARN("IMediaObjectInPlace_Process failed for filter %u\n", i);
+        }
+        left -= chunk;
+        pos = (pos + chunk) % dsb->buflen;
+        if (!pos && !(dsb->playflags & DSBPLAY_LOOPING))
+            break;
+    }
+}
