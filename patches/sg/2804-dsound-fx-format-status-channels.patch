+/* Channel layouts without a dedicated mapping: the channels the input and the
+ * device have in common are copied one to one (a mono input feeds the front
+ * pair), the device's remaining channels are silent. */
+static void put_silence_from(const IDirectSoundBufferImpl *dsb, DWORD pos, DWORD first)
+{
+    DWORD c, ochannels = dsb->device->pwfx->nChannels;
+
+    for (c = first; c < ochannels; c++)
+        dsb->put_aux(dsb, pos, c, 0.0f);
+}
+
+void put_direct(const IDirectSoundBufferImpl *dsb, DWORD pos, DWORD channel, float value)
+{
+    dsb->put_aux(dsb, pos, channel, value);
+    if (channel == dsb->mix_channels - 1)
+        put_silence_from(dsb, pos, dsb->mix_channels);
+}
+
+void put_mono2front(const IDirectSoundBufferImpl *dsb, DWORD pos, DWORD channel, float value)
+{
+    dsb->put_aux(dsb, pos, 0, value);
+    dsb->put_aux(dsb, pos, 1, value);
+    put_silence_from(dsb, pos, 2);
+}
+
 void put_mono2stereo(const IDirectSoundBufferImpl *dsb, DWORD pos, DWORD channel, float value)
 {
     dsb->put_aux(dsb, pos, 0, value);
