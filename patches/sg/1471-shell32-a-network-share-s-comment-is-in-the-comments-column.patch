From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: a network share's comment is in the Comments column

A computer's shares in Network showed an empty Comments column (0469
left it "no comment yet"). sg-netbrowse's shares2 request gives each
share as "name<tab>comment" (smbclient's list); the folder keeps the
comments of its last listing by \\server\share -- a share is a file
system item with no room for one -- and GetDetailsOf's column 1 answers
with it. An older sg-netbrowse (no shares2: exit status 2) is asked for
the names as before.

Gate: test/netplaces-gate.sh. Mutant: SG_MUTANT_NO_SHARE_COMMENT.
---
--- a/dlls/shell32/shfldr_netplaces.c
+++ b/dlls/shell32/shfldr_netplaces.c
@@ -78,7 +78,7 @@
 /* Stained Glass OS: what is on the network, from sg-session's sg-netbrowse
  * (a Unix program: smbclient for a computer's shares, mDNS and NetBIOS for the
  * computers), one name per line in a file. NULL-terminated list, or NULL. */
-static WCHAR **net_browse(const char *what, const WCHAR *server)
+static WCHAR **net_browse(const char *what, const WCHAR *server, LONG *status)
 {
     static const WCHAR helperW[] = L"\\\\?\\unix\\usr\\libexec\\stained-glass\\sg-netbrowse";
     LONG (WINAPI *spawnvp)(char * const argv[], int wait);
@@ -109,7 +109,8 @@
     argv[2] = unix_out;
     argv[3] = server ? serverA : NULL;
     argv[4] = NULL;
-    spawnvp(argv, TRUE);
+    n = spawnvp(argv, TRUE);
+    if (status) *status = n;
     HeapFree(GetProcessHeap(), 0, unix_out);
 
     h = CreateFileW(file, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
@@ -145,6 +146,83 @@
     free(names);
 }
 
+/* Stained Glass OS (wine-sg 1471): a share's comment, as the server gives it
+ * (smbclient's list), for the Comments column -- it was always empty. A share
+ * is a file system item with no room for it, so the folder keeps what its
+ * last listing said, by \\server\share. */
+static CRITICAL_SECTION net_comments_cs;
+static CRITICAL_SECTION_DEBUG net_comments_cs_debug =
+{
+    0, 0, &net_comments_cs,
+    { &net_comments_cs_debug.ProcessLocksList, &net_comments_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": net_comments_cs") }
+};
+static CRITICAL_SECTION net_comments_cs = { &net_comments_cs_debug, -1, 0, 0, 0, 0 };
+static struct { WCHAR unc[300]; WCHAR comment[256]; } net_comments[128];
+static unsigned int net_comments_next;
+
+static void net_set_comment(const WCHAR *server, const WCHAR *share, const WCHAR *comment)
+{
+    WCHAR unc[300];
+    unsigned int i;
+
+    swprintf(unc, ARRAY_SIZE(unc), L"\\\\%s\\%s", server, share);
+    EnterCriticalSection(&net_comments_cs);
+    for (i = 0; i < ARRAY_SIZE(net_comments); i++)
+        if (!wcsicmp(net_comments[i].unc, unc)) break;
+    if (i == ARRAY_SIZE(net_comments))
+    {
+        i = net_comments_next++ % ARRAY_SIZE(net_comments);
+        lstrcpynW(net_comments[i].unc, unc, ARRAY_SIZE(net_comments[i].unc));
+    }
+    lstrcpynW(net_comments[i].comment, comment, ARRAY_SIZE(net_comments[i].comment));
+    LeaveCriticalSection(&net_comments_cs);
+}
+
+static void net_get_comment(const WCHAR *server, const WCHAR *share, WCHAR *comment, int len)
+{
+    WCHAR unc[300];
+    unsigned int i;
+
+    swprintf(unc, ARRAY_SIZE(unc), L"\\\\%s\\%s", server, share);
+    comment[0] = 0;
+    EnterCriticalSection(&net_comments_cs);
+    for (i = 0; i < ARRAY_SIZE(net_comments); i++)
+        if (net_comments[i].unc[0] && !wcsicmp(net_comments[i].unc, unc))
+        {
+            lstrcpynW(comment, net_comments[i].comment, len);
+            break;
+        }
+    LeaveCriticalSection(&net_comments_cs);
+}
+
+/* a computer's shares, each "name<tab>comment" from sg-netbrowse's shares2;
+ * an older helper knows only "shares" (names) and says so with status 2 */
+static WCHAR **net_browse_shares(const WCHAR *server)
+{
+    WCHAR **names, **p, *tab;
+    LONG status = 0;
+
+    names = net_browse("shares2", server, &status);
+#ifndef SG_MUTANT_NO_SHARE_COMMENT
+    if (status != 2)
+    {
+        for (p = names; p && *p; p++)
+        {
+            if ((tab = wcschr(*p, '\t'))) *tab++ = 0;
+            net_set_comment(server, *p, tab ? tab : L"");
+        }
+        return names;
+    }
+#endif
+    net_free(names);
+    names = net_browse("shares", server, NULL);
+    /* a name is never a name<tab>comment */
+    for (p = names; p && *p; p++)
+        if ((tab = wcschr(*p, '\t'))) *tab = 0;
+    return names;
+}
+
 /* a share as a file system folder item: the folder is \\server\share */
 static LPITEMIDLIST net_create_share(const WCHAR *share)
 {
@@ -411,7 +489,7 @@
     /* Stained Glass OS: the computers on the network, or a computer's shares */
     if (dwFlags & SHCONTF_FOLDERS)
     {
-        WCHAR **names = net_browse(This->server[0] ? "shares" : "computers", This->server[0] ? This->server : NULL);
+        WCHAR **names = This->server[0] ? net_browse_shares(This->server) : net_browse("computers", NULL, NULL);
         WCHAR **p;
         for (p = names; p && *p; p++)
         {
@@ -794,12 +872,17 @@
         return E_FAIL;
     if (!pidl)
         return SHELL32_GetColumnDetails(networkplaces_header, iColumn, psd);
-    /* Stained Glass OS: the name; no comment yet */
+    /* Stained Glass OS: the name; a share's comment (1471) */
     psd->fmt = networkplaces_header[iColumn].fmt;
     if (iColumn == 0)
         return IShellFolder2_GetDisplayNameOf(iface, pidl, SHGDN_NORMAL | SHGDN_INFOLDER, &psd->str);
-    psd->str.uType = STRRET_WSTR;
-    return SHStrDupW(L"", &psd->str.pOleStr);
+    {
+        WCHAR name[MAX_PATH], comment[256] = L"";
+        if (This->server[0] && _ILIsPidlSimple(pidl) && _ILSimpleGetTextW(pidl, name, ARRAY_SIZE(name)))
+            net_get_comment(This->server, name, comment, ARRAY_SIZE(comment));
+        psd->str.uType = STRRET_WSTR;
+        return SHStrDupW(comment, &psd->str.pOleStr);
+    }
 }
 
 static HRESULT WINAPI ISF_NetworkPlaces_fnMapColumnToSCID (IShellFolder2 *iface, UINT column, SHCOLUMNID *scid)
