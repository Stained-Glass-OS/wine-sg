From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] combase, ole32: CoGetSystemSecurityPermissions

Dependencies delay-imports it from ole32 (missing). The machine-wide COM launch and access permissions
and limits as a self-relative security descriptor freed with LocalFree: the HKLM\Software\Microsoft\Ole
value (DefaultLaunchPermission, DefaultAccessPermission, MachineLaunchRestriction,
MachineAccessRestriction) when it holds one, else Windows' default for it. Read only.
Gate: test/syssecperm-gate.sh. Mutant: SG_MUTANT_SYSSECPERM_NODEFAULT.
---
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -26,6 +26,7 @@
 #include "oleauto.h"
 #include "dde.h"
 #include "winternl.h"
+#include "sddl.h"
 
 #include "combase_private.h"
 
@@ -1274,6 +1275,62 @@
 }
 
 /***********************************************************************
+ *           CoGetSystemSecurityPermissions    (combase.@)
+ *
+ * Stained Glass OS (wine-sg 9703): the machine-wide COM launch and access permissions and limits, a
+ * self-relative security descriptor the caller frees with LocalFree. Read from where Windows keeps them
+ * (HKLM\Software\Microsoft\Ole: DefaultLaunchPermission, DefaultAccessPermission, MachineLaunchRestriction,
+ * MachineAccessRestriction); a value that is not set gives the system default those values stand for.
+ * Reading only: nothing is granted or changed.
+ */
+HRESULT WINAPI CoGetSystemSecurityPermissions(COMSD type, PSECURITY_DESCRIPTOR *sd)
+{
+    static const struct { const WCHAR *value, *sddl; } sds[] =
+    {
+        /* SD_LAUNCHPERMISSIONS: administrators, SYSTEM and the interactive user may launch and activate */
+        { L"DefaultLaunchPermission",  L"O:BAG:BAD:(A;;0x1f;;;BA)(A;;0x1f;;;SY)(A;;0xb;;;IU)" },
+        /* SD_ACCESSPERMISSIONS: the server's own account (SELF), SYSTEM and administrators may call */
+        { L"DefaultAccessPermission",  L"O:BAG:BAD:(A;;0x7;;;PS)(A;;0x7;;;SY)(A;;0x7;;;BA)" },
+        /* SD_LAUNCHRESTRICTIONS: everyone local launch/activation; administrators, Distributed COM Users and
+         * Performance Log Users everything */
+        { L"MachineLaunchRestriction", L"O:BAG:BAD:(A;;0xb;;;WD)(A;;0x1f;;;BA)(A;;0x1f;;;S-1-5-32-562)(A;;0x1f;;;S-1-5-32-559)" },
+        /* SD_ACCESSRESTRICTIONS: everyone local and remote access, anonymous local, the two groups everything */
+        { L"MachineAccessRestriction", L"O:BAG:BAD:(A;;0x7;;;WD)(A;;0x3;;;AN)(A;;0x7;;;S-1-5-32-562)(A;;0x7;;;S-1-5-32-559)" },
+    };
+    PSECURITY_DESCRIPTOR result = NULL;
+    DWORD size = 0, value_type;
+    HKEY key;
+    BYTE *data;
+
+    TRACE("%d, %p\n", type, sd);
+
+    if (!sd) return E_INVALIDARG;
+    *sd = NULL;
+    if ((unsigned int)type >= ARRAY_SIZE(sds)) return E_INVALIDARG;
+
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Ole", 0, KEY_QUERY_VALUE, &key))
+    {
+        if (!RegQueryValueExW(key, sds[type].value, NULL, &value_type, NULL, &size) && value_type == REG_BINARY &&
+            size >= sizeof(SECURITY_DESCRIPTOR_RELATIVE) && (data = LocalAlloc(LMEM_FIXED, size)))
+        {
+            if (!RegQueryValueExW(key, sds[type].value, NULL, NULL, data, &size) && IsValidSecurityDescriptor(data) &&
+                GetSecurityDescriptorLength(data) <= size)
+                result = data;
+            else
+                LocalFree(data);
+        }
+        RegCloseKey(key);
+    }
+#ifndef SG_MUTANT_SYSSECPERM_NODEFAULT
+    if (!result && !ConvertStringSecurityDescriptorToSecurityDescriptorW(sds[type].sddl, SDDL_REVISION_1, &result, NULL))
+        return HRESULT_FROM_WIN32(GetLastError());
+#endif
+    if (!result) return E_FAIL;
+    *sd = result;
+    return S_OK;
+}
+
+/***********************************************************************
  *           CoInitializeSecurity    (combase.@)
  */
 /* the process's COM security, as CoInitializeSecurity set it */
--- a/dlls/combase/combase.spec
+++ b/dlls/combase/combase.spec
@@ -119,7 +119,7 @@
 @ stub CoGetProcessIdentifier
 @ stdcall CoGetStandardMarshal(ptr ptr long ptr long ptr)
 @ stdcall CoGetStdMarshalEx(ptr long ptr)
-@ stub CoGetSystemSecurityPermissions
+@ stdcall CoGetSystemSecurityPermissions(long ptr)
 @ stdcall CoGetTreatAsClass(ptr ptr)
 @ stdcall CoImpersonateClient()
 @ stdcall CoIncrementMTAUsage(ptr)
--- a/dlls/ole32/ole32.spec
+++ b/dlls/ole32/ole32.spec
@@ -30,6 +30,7 @@
 @ stdcall CoGetActivationState(int128 long ptr) combase.CoGetActivationState
 @ stdcall CoGetApartmentType(ptr ptr) combase.CoGetApartmentType
 @ stdcall CoGetCallContext(ptr ptr) combase.CoGetCallContext
+@ stdcall CoGetSystemSecurityPermissions(long ptr) combase.CoGetSystemSecurityPermissions
 @ stdcall CoGetCallState(long ptr) combase.CoGetCallState
 @ stdcall CoGetCallerTID(ptr) combase.CoGetCallerTID
 @ stdcall CoGetCancelObject(long ptr ptr) combase.CoGetCancelObject
--- a/include/objbase.h
+++ b/include/objbase.h
@@ -376,6 +376,14 @@
 WINOLE32API HRESULT WINAPI CoEnableCallCancellation(void *reserved);
 
 /* security */
+typedef enum tagCOMSD
+{
+    SD_LAUNCHPERMISSIONS = 0,
+    SD_ACCESSPERMISSIONS = 1,
+    SD_LAUNCHRESTRICTIONS = 2,
+    SD_ACCESSRESTRICTIONS = 3
+} COMSD;
+WINOLE32API HRESULT WINAPI CoGetSystemSecurityPermissions(COMSD comSDType, PSECURITY_DESCRIPTOR *ppSD);
 WINOLE32API HRESULT WINAPI CoInitializeSecurity(PSECURITY_DESCRIPTOR pSecDesc, LONG cAuthSvc, SOLE_AUTHENTICATION_SERVICE* asAuthSvc, void* pReserved1, DWORD dwAuthnLevel, DWORD dwImpLevel, void* pReserved2, DWORD dwCapabilities, void* pReserved3);
 WINOLE32API HRESULT WINAPI CoGetCallContext(REFIID riid, void** ppInterface);
 WINOLE32API HRESULT WINAPI CoSwitchCallContext(IUnknown *pContext, IUnknown **ppOldContext);
