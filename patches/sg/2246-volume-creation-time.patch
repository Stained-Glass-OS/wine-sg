From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: FileFsVolumeInformation reports a creation time

FileFsVolumeInformation (GetVolumeInformationByHandle, Explorer's volume
properties) reported a volume creation time of zero (a FIXME). It is the
creation time of the root of the volume's mount now (the file system keeps
no better one that Wine can see), so programs that show or compare it get a
real, stable date. The ntdll test's todo_wine for it is removed.

---
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -4727,7 +4727,7 @@ static void test_query_volume_information_file(void)
     "expected %ld, got %Iu\n", (FIELD_OFFSET(FILE_FS_VOLUME_INFORMATION, VolumeLabel) + ffvi->VolumeLabelLength),
      io.Information);
 
-    todo_wine ok(ffvi->VolumeCreationTime.QuadPart != 0, "Missing VolumeCreationTime\n");
+    ok(ffvi->VolumeCreationTime.QuadPart != 0, "Missing VolumeCreationTime\n");
     ok(ffvi->VolumeSerialNumber != 0, "Missing VolumeSerialNumber\n");
     ok(ffvi->SupportsObjects == 1,"expected 1, got %d\n", ffvi->SupportsObjects);
     ok(ffvi->VolumeLabelLength == lstrlenW(ffvi->VolumeLabel) * sizeof(WCHAR), "got %ld\n", ffvi->VolumeLabelLength);
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -8316,7 +8316,23 @@ NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io
         }
 
         label = (WCHAR *)((char *)drive + drive->label_offset);
-        info->VolumeCreationTime.QuadPart = 0; /* FIXME */
+        /* the volume's creation time: that of the root of its mount, which is
+         * as stable as a time can be here */
+        {
+            const char *root = drive->mount_point_offset ? (const char *)drive + drive->mount_point_offset : "/";
+            LARGE_INTEGER mtime, ctime, atime, creation;
+            struct stat root_st;
+
+            info->VolumeCreationTime.QuadPart = 0;
+#ifndef SG_MUTANT_NO_VOLUME_TIME
+            if (stat( root, &root_st ) && stat( "/", &root_st )) root_st.st_mtime = 0;
+            else
+            {
+                get_file_times( &root_st, &mtime, &ctime, &atime, &creation );
+                info->VolumeCreationTime = creation;
+            }
+#endif
+        }
         info->VolumeSerialNumber = drive->serial;
         info->VolumeLabelLength = min( wcslen( label ) * sizeof(WCHAR),
                                        length - offsetof( FILE_FS_VOLUME_INFORMATION, VolumeLabel ) );
