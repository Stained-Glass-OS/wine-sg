From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: GetTempPath2 gives the SYSTEM account its SystemTemp folder

On Windows, GetTempPath2 called by a SYSTEM process returns
%SystemRoot%\SystemTemp\, a folder only SYSTEM can write in; everyone else
gets GetTempPath. Wine left it a semi-stub (GetTempPath for all). Elevated
installers unpack there (Omaha, the updater of Chrome and Brave; without
the folder they fell back to one of their own under Program Files). It is
returned only when the folder exists; sg-session's prefix setup makes it.
---
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -2773,14 +2773,51 @@
 }
 
 
+/* Stained Glass OS: the SYSTEM account's temporary folder, as on Windows: a
+ * SYSTEM process gets %SystemRoot%\SystemTemp\ from GetTempPath2 when it
+ * exists (only SYSTEM can write there). Installers run elevated take it for
+ * the files they unpack (Omaha: Chrome's and Brave's updaters; without it
+ * they fell back to a folder of their own under Program Files). */
+static BOOL system_temp_path( WCHAR *buf )
+{
+    static const SID local_system = { SID_REVISION, 1, { SECURITY_NT_AUTHORITY }, { SECURITY_LOCAL_SYSTEM_RID } };
+    char user_buf[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+    TOKEN_USER *user = (TOKEN_USER *)user_buf;
+    HANDLE token;
+    DWORD len, attr;
+    BOOL system;
+
+    if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )) return FALSE;
+    system = GetTokenInformation( token, TokenUser, user, sizeof(user_buf), &len ) &&
+             EqualSid( user->User.Sid, (PSID)&local_system );
+    CloseHandle( token );
+#ifdef SG_MUTANT_NOSYSTEMTEMP
+    system = FALSE;
+#endif
+    if (!system) return FALSE;
+    len = GetSystemWindowsDirectoryW( buf, MAX_PATH - 13 );
+    if (!len || len >= MAX_PATH - 13) return FALSE;
+    if (buf[len - 1] != '\\') buf[len++] = '\\';
+    lstrcpyW( buf + len, L"SystemTemp\\" );
+    attr = GetFileAttributesW( buf );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
 /***********************************************************************
  *	GetTempPath2A   (kernelbase.@)
  */
 DWORD WINAPI DECLSPEC_HOTPATCH GetTempPath2A(DWORD count, LPSTR path)
 {
-    /* TODO: Set temp path to C:\Windows\SystemTemp\ when a SYSTEM process calls this function */
-    FIXME("(%lu, %p) semi-stub\n", count, path);
-    return GetTempPathA(count, path);
+    WCHAR pathW[MAX_PATH];
+    UINT ret;
+
+    if (!(ret = GetTempPath2W( MAX_PATH, pathW ))) return 0;
+    if (ret > MAX_PATH)
+    {
+        SetLastError( ERROR_FILENAME_EXCED_RANGE );
+        return 0;
+    }
+    return copy_filename_WtoA( pathW, path, count );
 }
 
 
@@ -2789,9 +2826,14 @@
  */
 DWORD WINAPI DECLSPEC_HOTPATCH GetTempPath2W(DWORD count, LPWSTR path)
 {
-    /* TODO: Set temp path to C:\Windows\SystemTemp\ when a SYSTEM process calls this function */
-    FIXME("(%lu, %p) semi-stub\n", count, path);
-    return GetTempPathW(count, path);
+    WCHAR buf[MAX_PATH];
+    DWORD len;
+
+    if (!system_temp_path( buf )) return GetTempPathW( count, path );
+    len = lstrlenW( buf );
+    if (count <= len) return len + 1;
+    if (path) lstrcpyW( path, buf );
+    return len;
 }
 
 
