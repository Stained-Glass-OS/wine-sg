From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d2d1: a source transform is told its render info and draws into a bitmap it is handed

An ID2D1SourceTransform was never given its render info nor asked to Draw:
its node drew nothing. Paint.NET 5.2's adjustments read the layer through
its own "Bitmap Source 2" effect (a source transform), so Auto-Level came
out transparent once its histogram worked. As Direct2D does: SetRenderInfo
at graph initialisation; drawing the node hands Draw() a bitmap of the
rectangle in the buffer precision the transform asked for, writable by the
CPU (Paint.NET maps it WRITE | DISCARD; CopyFromMemory works too), and that
bitmap is the node's output. Paint.NET 5.2 Auto-Level now stretches a
grey ramp to black..white.
---
--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -3416,6 +3416,7 @@
 
 static HRESULT d2d_transform_node_initialize(struct d2d_transform_node *node)
 {
+    ID2D1SourceTransform *source_transform;
     ID2D1ComputeTransform *compute_transform;
     ID2D1DrawTransform *draw_transform;
     HRESULT hr;
@@ -3439,6 +3440,21 @@
             return hr;
         }
     }
+#ifndef SG_MUTANT_D2D_NO_SOURCE
+    /* wine-sg 9208: a source transform is told its render info (ID2D1RenderInfo: the output buffer, cached) */
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1SourceTransform,
+            (void **)&source_transform)))
+    {
+        hr = ID2D1SourceTransform_SetRenderInfo(source_transform,
+                (ID2D1RenderInfo *)&node->render_info->ID2D1DrawInfo_iface);
+        ID2D1SourceTransform_Release(source_transform);
+        if (FAILED(hr))
+        {
+            WARN("Failed to set render info, hr %#lx.\n", hr);
+            return hr;
+        }
+    }
+#endif
 #ifndef SG_MUTANT_D2D_NO_COMPUTE
     else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1ComputeTransform,
             (void **)&compute_transform)))
--- a/dlls/d2d1/effect_render.c
+++ b/dlls/d2d1/effect_render.c
@@ -2258,6 +2258,7 @@
     D2D1_RECT_L stack_rects[8], *rects = stack_rects, *effect_rects = NULL, bounds, rect;
     struct fx_texture stack_textures[8], *textures = stack_textures;
     ID2D1OffsetTransform *offset_transform;
+    ID2D1SourceTransform *source;
     ID2D1ComputeTransform *compute;
     ID2D1DrawTransform *draw;
     struct d2d_effect *nested;
@@ -2351,6 +2352,74 @@
         ID3D11PixelShader_Release(ps);
         ID3D11VertexShader_Release(vs);
     }
+#ifndef SG_MUTANT_D2D_NO_SOURCE
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1SourceTransform, (void **)&source)))
+    {
+        /* wine-sg 9208: a source transform draws its pixels itself: Direct2D hands it a bitmap of the
+         * rectangle (in the buffer precision it asked for, CPU-writable: Paint.NET maps it WRITE | DISCARD)
+         * and Draw() fills it; the bitmap is the node's output. Paint.NET's "Bitmap Source 2" feeds its
+         * adjustments so. */
+        const struct d2d_render_info *info = node->render_info;
+        D2D1_POINT_2U origin = { 0, 0 };
+        D3D11_TEXTURE2D_DESC texture_desc;
+        D2D1_BITMAP_PROPERTIES1 desc;
+        ID3D11Texture2D *texture;
+        struct d2d_bitmap *bitmap;
+        IDXGISurface *surface;
+
+        /* the target is written by the CPU: Map(WRITE | DISCARD) or CopyFromMemory */
+        memset(&desc, 0, sizeof(desc));
+        switch (info ? info->output_precision : D2D1_BUFFER_PRECISION_UNKNOWN)
+        {
+            case D2D1_BUFFER_PRECISION_32BPC_FLOAT: desc.pixelFormat.format = DXGI_FORMAT_R32G32B32A32_FLOAT; break;
+            case D2D1_BUFFER_PRECISION_16BPC_FLOAT: desc.pixelFormat.format = DXGI_FORMAT_R16G16B16A16_FLOAT; break;
+            case D2D1_BUFFER_PRECISION_16BPC_UNORM: desc.pixelFormat.format = DXGI_FORMAT_R16G16B16A16_UNORM; break;
+            default: desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM; break;
+        }
+        desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+        desc.dpiX = desc.dpiY = 96.0f;
+        desc.bitmapOptions = D2D1_BITMAP_OPTIONS_CPU_READ;
+        texture_desc.Width = rect.right - rect.left;
+        texture_desc.Height = rect.bottom - rect.top;
+        texture_desc.MipLevels = 1;
+        texture_desc.ArraySize = 1;
+        texture_desc.Format = desc.pixelFormat.format;
+        texture_desc.SampleDesc.Count = 1;
+        texture_desc.SampleDesc.Quality = 0;
+        texture_desc.Usage = D3D11_USAGE_DYNAMIC;
+        texture_desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        texture_desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        texture_desc.MiscFlags = 0;
+        if (SUCCEEDED(hr = ID3D11Device1_CreateTexture2D(r->device, &texture_desc, NULL, &texture)))
+        {
+            if (SUCCEEDED(hr = ID3D11Texture2D_QueryInterface(texture, &IID_IDXGISurface, (void **)&surface)))
+            {
+                if (SUCCEEDED(hr = d2d_bitmap_create_shared(r->context, &IID_IDXGISurface, surface, &desc, &bitmap)))
+                {
+                    if (SUCCEEDED(hr = ID2D1SourceTransform_Draw(source, &bitmap->ID2D1Bitmap1_iface, &rect, origin)))
+                    {
+                        if (bitmap->mapped_resource.pData)
+                            ID2D1Bitmap1_Unmap(&bitmap->ID2D1Bitmap1_iface);
+                        if (bitmap->srv)
+                        {
+                            out->texture = texture;
+                            ID3D11Texture2D_AddRef(texture);
+                            out->srv = bitmap->srv;
+                            ID3D11ShaderResourceView_AddRef(out->srv);
+                            out->rect = rect;
+                        }
+                    }
+                    else
+                        WARN("Source transform %p failed to draw, hr %#lx.\n", node->object, hr);
+                    ID2D1Bitmap1_Release(&bitmap->ID2D1Bitmap1_iface);
+                }
+                IDXGISurface_Release(surface);
+            }
+            ID3D11Texture2D_Release(texture);
+        }
+        ID2D1SourceTransform_Release(source);
+    }
+#endif
 #ifndef SG_MUTANT_D2D_NO_COMPUTE
     else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1ComputeTransform, (void **)&compute)))
     {
