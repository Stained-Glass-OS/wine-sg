+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A TextBlock's text can be a list of inlines: runs of text and line breaks (spans hold more of
+ * them).  The TextBlock lays out their text, run after run, a line break as a new line; a change in
+ * a run lays it out again.  Per-run formatting comes later: the runs take the TextBlock's.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+
+
+static const GUID IID_IVector_Inline = { 0x92ec9252, 0x8ee3, 0x55d6, { 0x84, 0xb4, 0x30, 0xb6, 0x35, 0x07, 0x77, 0x78 } };
+static const GUID IID_IVectorView_Inline = { 0xc2dd082f, 0x8cb4, 0x51d6, { 0xb9, 0x1b, 0x7e, 0x23, 0x77, 0x78, 0x0c, 0xee } };
+static const GUID IID_IIterable_Inline = { 0xe1d2b910, 0x18c2, 0x5906, { 0x8f, 0x8a, 0xd6, 0x2a, 0x63, 0xf9, 0x3f, 0x18 } };
+static const GUID IID_IIterator_Inline = { 0xf80dc964, 0x2542, 0x5c6a, { 0xba, 0x65, 0xb0, 0x48, 0x24, 0xb5, 0xed, 0x75 } };
+
+enum inline_kind { INLINE_RUN, INLINE_LINE_BREAK, INLINE_SPAN };
+
+struct text_inline
+{
+    struct dobj d;
+    struct xiface IInline_iface, ITextElement_iface, ITextElement2_iface, IRun_iface, ILineBreak_iface, ISpan_iface;
+    enum inline_kind kind;
+    struct uielem *owner;           /* the TextBlock it is in (no reference) */
+    struct text_inline *parent;     /* the Span it is in */
+    struct xvector *inlines;        /* a Span's */
+};
+
+static struct xaml_property *prop_run_text;
+
+static struct text_inline *inline_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct text_inline, d.obj );
+}
+
+static struct uielem *owner_of( struct text_inline *in )
+{
+    while (in->parent) in = in->parent;
+    return in->owner;
+}
+
+static void run_text_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct uielem *owner = owner_of( CONTAINING_RECORD( obj, struct text_inline, d ) );
+    if (owner) xaml_text_inherited_changed( owner );
+}
+
+static BOOL WINAPI init_documents( INIT_ONCE *once, void *param, void **context )
+{
+    prop_run_text = xaml_property_register( L"Windows.UI.Xaml.Documents.Run", L"Text", L"String", xbox_string( L"" ),
+                                            FALSE, run_text_changed );
+    return TRUE;
+}
+
+static void documents_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_documents, NULL, NULL );
+}
+
+/* ---- the collection of inlines (a TextBlock's or a Span's) ---- */
+
+static struct text_inline *inline_from_inspectable( IInspectable *item );
+
+static HRESULT inlines_added( void *owner, IInspectable *item )
+{
+    struct text_inline *in = inline_from_inspectable( item );
+    struct xvector_owner *o = owner;
+
+    if (!in) return E_INVALIDARG;
+    if (o)
+    {
+        in->owner = o->text_block;
+        in->parent = o->span;
+    }
+    return S_OK;
+}
+
+static void inlines_removed( void *owner, IInspectable *item )
+{
+    struct text_inline *in = inline_from_inspectable( item );
+    if (in) in->owner = NULL, in->parent = NULL;
+}
+
+static void inlines_changed( void *owner )
+{
+    struct xvector_owner *o = owner;
+    struct uielem *text_block = o ? (o->span ? owner_of( o->span ) : o->text_block) : NULL;
+
+    if (text_block) xaml_text_inherited_changed( text_block );
+}
+
+static const struct xvector_type inlines_type =
+{
+    L"Windows.UI.Xaml.Documents.InlineCollection",
+    &IID_IVector_Inline, &IID_IVectorView_Inline, &IID_IIterable_Inline, &IID_IIterator_Inline,
+    &IID_IInline, NULL, inlines_added, inlines_removed, inlines_changed,
+};
+
+HRESULT xaml_inlines_create( struct xvector_owner *owner, struct xvector **out )
+{
+    documents_init();
+    return xvector_create( &inlines_type, owner, out );
+}
+
+/* the text of inlines: runs one after the other, line breaks as new lines (allocated) */
+static void append( WCHAR **buf, size_t *len, size_t *size, const WCHAR *str )
+{
+    size_t n = wcslen( str );
+    WCHAR *p;
+
+    if (!*buf) return;
+    if (*len + n + 1 > *size)
+    {
+        *size = max( *size * 2, *len + n + 1 );
+        if (!(p = realloc( *buf, *size * sizeof(WCHAR) ))) { free( *buf ); *buf = NULL; return; }
+        *buf = p;
+    }
+    memcpy( *buf + *len, str, n * sizeof(WCHAR) );
+    *len += n;
+    (*buf)[*len] = 0;
+}
+
+static void collect( struct xvector *inlines, WCHAR **buf, size_t *len, size_t *size, int depth )
+{
+    UINT32 i;
+
+    if (!inlines || depth > 32) return;
+    for (i = 0; i < xvector_size( inlines ); i++)
+    {
+        struct text_inline *in = inline_from_inspectable( xvector_item( inlines, i ) );
+        IInspectable *box = NULL;
+        WCHAR *str;
+
+        if (!in) continue;
+        switch (in->kind)
+        {
+        case INLINE_RUN:
+#ifdef SG_MUTANT_INLINES_NO_TEXT
+            break;
+#endif
+            dobj_get_value( &in->d, prop_run_text, &box );
+            if ((str = xunbox_string( box ))) append( buf, len, size, str );
+            free( str );
+            if (box) IInspectable_Release( box );
+            break;
+        case INLINE_LINE_BREAK:
+            append( buf, len, size, L"\n" );
+            break;
+        case INLINE_SPAN:
+            collect( in->inlines, buf, len, size, depth + 1 );
+            break;
+        }
+    }
+}
+
+WCHAR *xaml_inlines_text( struct xvector *inlines )
+{
+    size_t len = 0, size = 64;
+    WCHAR *buf = malloc( size * sizeof(WCHAR) );
+
+    if (!buf) return NULL;
+    buf[0] = 0;
+    collect( inlines, &buf, &len, &size, 0 );
+    return buf;
+}
+
+/* ---- interfaces ---- */
+
+static const void *inline_vtbl[] = { IInline_STUBS };
+static const void *line_break_vtbl[] = { ILineBreak_STUBS };
+
+static HRESULT WINAPI element_get_Name( struct xiface *iface, HSTRING *value )
+{
+    return xaml_hstring( L"", value );
+}
+
+static const void *text_element_vtbl[] = { ITextElement_STUBS, [ITextElement_Name] = element_get_Name };
+static const void *text_element2_vtbl[] = { ITextElement2_STUBS };
+
+static HRESULT WINAPI run_get_Text( struct xiface *iface, HSTRING *value )
+{
+    IInspectable *box = NULL;
+    WCHAR *str;
+    HRESULT hr;
+
+    dobj_get_value( &inline_from_iface( iface )->d, prop_run_text, &box );
+    str = xunbox_string( box );
+    if (box) IInspectable_Release( box );
+    hr = xaml_hstring( str ? str : L"", value );
+    free( str );
+    return hr;
+}
+
+static HRESULT WINAPI run_put_Text( struct xiface *iface, HSTRING value )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( value, NULL );
+    IInspectable *box = xbox_string( str ? str : L"" );
+    HRESULT hr;
+
+    if (!box) return E_OUTOFMEMORY;
+    hr = dobj_set_value( &inline_from_iface( iface )->d, prop_run_text, box );
+    IInspectable_Release( box );
+    return hr;
+}
+
+static const void *run_vtbl[] = { IRun_STUBS, [IRun_Text] = run_get_Text, [IRun_SetText] = run_put_Text };
+
+static HRESULT WINAPI span_get_Inlines( struct xiface *iface, IInspectable **value )
+{
+    struct text_inline *span = inline_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    IInspectable_AddRef( (*value = xvector_iface( span->inlines )) );
+    return S_OK;
+}
+
+static const void *span_vtbl[] = { ISpan_STUBS, [ISpan_Inlines] = span_get_Inlines };
+
+#define INLINE_IFACES \
+    { &IID_IInline, offsetof(struct text_inline, IInline_iface) }, \
+    { &IID_ITextElement, offsetof(struct text_inline, ITextElement_iface) }, \
+    { &IID_ITextElement2, offsetof(struct text_inline, ITextElement2_iface) }, \
+    DOBJ_IFACES(struct dobj)
+
+static const struct xiface_entry run_ifaces[] = { { &IID_IRun, offsetof(struct text_inline, IRun_iface) }, INLINE_IFACES };
+static const struct xiface_entry line_break_ifaces[] = { { &IID_ILineBreak, offsetof(struct text_inline, ILineBreak_iface) }, INLINE_IFACES };
+static const struct xiface_entry span_ifaces[] = { { &IID_ISpan, offsetof(struct text_inline, ISpan_iface) }, INLINE_IFACES };
+
+static void inline_destroy( struct xobj *obj )
+{
+    struct text_inline *in = CONTAINING_RECORD( obj, struct text_inline, d.obj );
+
+    if (in->inlines) xvector_detach( in->inlines );
+    dobj_cleanup( &in->d );
+}
+
+static const struct xclass run_class = { L"Windows.UI.Xaml.Documents.Run", run_ifaces, ARRAY_SIZE(run_ifaces), inline_destroy };
+static const struct xclass line_break_class = { L"Windows.UI.Xaml.Documents.LineBreak", line_break_ifaces, ARRAY_SIZE(line_break_ifaces), inline_destroy };
+static const struct xclass span_class = { L"Windows.UI.Xaml.Documents.Span", span_ifaces, ARRAY_SIZE(span_ifaces), inline_destroy };
+
+static struct text_inline *inline_from_inspectable( IInspectable *item )
+{
+    struct xiface *iface = NULL;
+    struct text_inline *in = NULL;
+
+    if (!item || FAILED(IInspectable_QueryInterface( item, &IID_IInline, (void **)&iface ))) return NULL;
+    if (iface->vtbl == inline_vtbl) in = inline_from_iface( iface );
+    IUnknown_Release( (IUnknown *)iface );
+    return in;
+}
+
+static struct text_inline *new_inline( enum inline_kind kind, IInspectable *outer )
+{
+    static const struct xclass *classes[] = { &run_class, &line_break_class, &span_class };
+    struct text_inline *in;
+
+    documents_init();
+    if (!(in = calloc( 1, sizeof(*in) + sizeof(struct xvector_owner) ))) return NULL;
+    in->kind = kind;
+    in->IInline_iface.vtbl = inline_vtbl;
+    in->ITextElement_iface.vtbl = text_element_vtbl;
+    in->ITextElement2_iface.vtbl = text_element2_vtbl;
+    in->IRun_iface.vtbl = run_vtbl;
+    in->ILineBreak_iface.vtbl = line_break_vtbl;
+    in->ISpan_iface.vtbl = span_vtbl;
+    dobj_init( &in->d, classes[kind], outer );
+    if (kind == INLINE_SPAN)
+    {
+        struct xvector_owner *owner = (struct xvector_owner *)(in + 1);
+        owner->text_block = NULL;
+        owner->span = in;
+        xvector_create( &inlines_type, owner, &in->inlines );
+    }
+    return in;
+}
+
+static HRESULT activate_run( IInspectable **out )
+{
+    struct text_inline *in = new_inline( INLINE_RUN, NULL );
+    if (!in) return E_OUTOFMEMORY;
+    *out = (IInspectable *)&in->IRun_iface;
+    return S_OK;
+}
+
+static HRESULT activate_line_break( IInspectable **out )
+{
+    struct text_inline *in = new_inline( INLINE_LINE_BREAK, NULL );
+    if (!in) return E_OUTOFMEMORY;
+    *out = (IInspectable *)&in->ILineBreak_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI span_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct text_inline *in;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(in = new_inline( INLINE_SPAN, outer ))) return E_OUTOFMEMORY;
+    if (outer)
+    {
+        *inner = &in->d.obj.IInspectable_inner;
+        IUnknown_AddRef( in->d.obj.outer );
+    }
+    *value = &in->ISpan_iface;
+    return S_OK;
+}
+
+static const void *span_factory_vtbl[] = { ISpanFactory_FSTUBS, [ISpanFactory_CreateInstance] = span_factory_CreateInstance };
+
+static HRESULT WINAPI run_statics_FlowDirectionProperty( struct xfiface *iface, IInspectable **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static const void *run_statics_vtbl[] = { IRunStatics_FSTUBS, [IRunStatics_FlowDirectionProperty] = run_statics_FlowDirectionProperty };
+
+static struct xfactory run_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Documents.Run",
+                                           { &IID_IRunStatics }, { { run_statics_vtbl } }, activate_run };
+static struct xfactory line_break_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Documents.LineBreak",
+                                                  { NULL }, { { NULL } }, activate_line_break };
+static struct xfactory span_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.Documents.Span",
+                                            { &IID_ISpanFactory }, { { span_factory_vtbl } } };
+
+IActivationFactory *run_factory = &run_factory_obj.IActivationFactory_iface;
+IActivationFactory *line_break_factory = &line_break_factory_obj.IActivationFactory_iface;
+IActivationFactory *span_factory = &span_factory_obj.IActivationFactory_iface;
+
+/* is it an inline of ours */
+BOOL xaml_is_inline( IInspectable *obj )
+{
+    return inline_from_inspectable( obj ) != NULL;
+}
