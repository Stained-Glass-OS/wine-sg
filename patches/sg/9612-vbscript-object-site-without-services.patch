From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] vbscript: objects that take a site are created under hosts without services (9612)

CreateObject of an object that implements IObjectWithSite -- MSXML's
DOMDocument (every version, Microsoft.XMLDOM), XMLHTTP, Microsoft.XMLHTTP --
failed with error 429 "ActiveX component can't create object" under Windows
Script Host (cscript, wscript): vbscript wanted the host's site to be an
IServiceProvider to build the object's site from, and WSH's is not one. Every
.vbs that reads or writes XML or calls a web service stopped at its first
line. The object now gets a site that offers no services, as Wine's jscript
already does; QueryService answers E_NOINTERFACE. The site also releases the
host's service provider when it goes.
---
--- a/dlls/vbscript/vbscript.c
+++ b/dlls/vbscript/vbscript.c
@@ -1987,8 +1987,11 @@
 
     TRACE("(%p) ref=%ld\n", This, ref);
 
-    if(!ref)
+    if(!ref) {
+        if(This->sp)
+            IServiceProvider_Release(This->sp);
         free(This);
+    }
 
     return ref;
 }
@@ -2000,6 +2003,10 @@
 
     TRACE("(%p)->(%s %s %p)\n", This, debugstr_guid(guidService), debugstr_guid(riid), ppv);
 
+    if(!This->sp) {
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
     return IServiceProvider_QueryService(This->sp, guidService, riid, ppv);
 }
 
@@ -2012,19 +2019,26 @@
 
 IUnknown *create_ax_site(script_ctx_t *ctx)
 {
-    IServiceProvider *sp;
+    IServiceProvider *sp = NULL;
     AXSite *ret;
     HRESULT hres;
 
+    /* A host's site need not be a service provider -- Windows Script Host's is not: an object
+     * that wants a site (XMLHTTP, ServerXMLHTTP, DOMDocument, XMLDOM) still gets one, which
+     * offers no services, the way jscript does it (wine-sg 9612). */
     hres = IActiveScriptSite_QueryInterface(ctx->site, &IID_IServiceProvider, (void**)&sp);
     if(FAILED(hres)) {
-        ERR("Could not get IServiceProvider iface: %08lx\n", hres);
+        TRACE("Could not get IServiceProvider iface: %08lx\n", hres);
+        sp = NULL;
+#ifdef SG_MUTANT_VBS_AXSITE_NEEDS_SP
         return NULL;
+#endif
     }
 
     ret = malloc(sizeof(*ret));
     if(!ret) {
-        IServiceProvider_Release(sp);
+        if(sp)
+            IServiceProvider_Release(sp);
         return NULL;
     }
 
