Date: Mon, 12 Oct 2026 21:04:30 -0700
Subject: [PATCH] msxml3: IXMLDOMElement::normalize

Adjacent text nodes below the element become one node and empty text nodes
are removed.

diff --git a/dlls/msxml3/element.c b/dlls/msxml3/element.c
index 2b06aab..d0cbe39 100644
--- a/dlls/msxml3/element.c
+++ b/dlls/msxml3/element.c
@@ -1580,12 +1580,50 @@ static HRESULT WINAPI domelem_getElementsByTagName(
     return hr;
 }
 
+/* Adjacent text nodes become one and empty ones go away, below this node. */
+static void normalize_children(xmlNodePtr parent)
+{
+    xmlNodePtr child = parent->children;
+
+    while (child)
+    {
+        xmlNodePtr next = child->next;
+
+        if (child->type == XML_TEXT_NODE)
+        {
+            while (next && next->type == XML_TEXT_NODE)
+            {
+                xmlNodePtr merged = next;
+
+                if (merged->content && *merged->content)
+                    xmlNodeAddContent(child, merged->content);
+                next = merged->next;
+                xmlUnlinkNode(merged);
+                xmldoc_add_orphan(merged->doc, merged);
+            }
+            if (!child->content || !*child->content)
+            {
+                xmlUnlinkNode(child);
+                xmldoc_add_orphan(child->doc, child);
+            }
+        }
+        else if (child->type == XML_ELEMENT_NODE)
+            normalize_children(child);
+        child = next;
+    }
+}
+
 static HRESULT WINAPI domelem_normalize(
     IXMLDOMElement *iface )
 {
     domelem *This = impl_from_IXMLDOMElement( iface );
-    FIXME("%p\n", This);
-    return E_NOTIMPL;
+
+    TRACE("%p\n", This);
+
+#ifndef SG_MUTANT_MSXML_NORMALIZE_NOOP
+    normalize_children(get_element(This));
+#endif
+    return S_OK;
 }
 
 static const struct IXMLDOMElementVtbl domelem_vtbl =
