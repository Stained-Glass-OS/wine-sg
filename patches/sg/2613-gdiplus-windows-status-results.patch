From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] gdiplus: status results recorded from Windows by Wine's own tests

Wine's gdiplus conformance tests carry todo_wine marks where Windows behaviour
was verified and Wine differed. Fixed here, with the marks removed:
GdipCreateBitmapFromFile answers InvalidParameter for a file that cannot be
opened and GdipLoadImageFromFile/ICM answer OutOfMemory; the resolution and the
size of a metafile that is still being recorded are InvalidParameter until the
recording is finished; an EMF+ metafile is not converted again by
GdipConvertToEmfPlus (InvalidParameter); no graphics can be made for a 16 bit
gray bitmap (OutOfMemory); and the container/state values returned by
GdipBeginContainer2 and GdipSaveGraphics no longer repeat across graphics objects
(a metafile still numbers its own containers from 1 as its records say).

Left alone on purpose: the NotTrueTypeFont result for a zeroed LOGFONT whose face
is unknown (todo_wine in font.c). A zeroed LOGFONT with only a face name is how
many programs ask for a font, and Wine substitutes faces it does not have, so
that rule would turn working text into errors.
---
--- a/dlls/gdiplus/graphics.c
+++ b/dlls/gdiplus/graphics.c
@@ -2580,6 +2580,17 @@ void get_font_hfont(GpGraphics *graphics, GDIPCONST GpFont *font,
     DeleteObject(unscaled_font);
 }
 
+/* Container (state) values of different graphics objects must not repeat. */
+static GraphicsContainer new_container_base(void)
+{
+    static LONG counter;
+
+#ifdef SG_MUTANT_GDIPSTAT_STATE_REPEATS
+    return 0;
+#endif
+    return (InterlockedIncrement(&counter) & 0xffff) << 16;
+}
+
 GpStatus WINGDIPAPI GdipCreateFromHDC(HDC hdc, GpGraphics **graphics)
 {
     TRACE("(%p, %p)\n", hdc, graphics);
@@ -2650,7 +2661,7 @@ GpStatus WINGDIPAPI GdipCreateFromHDC2(HDC hdc, HANDLE hDevice, GpGraphics **gra
     (*graphics)->busy = FALSE;
     (*graphics)->textcontrast = 4;
     list_init(&(*graphics)->containers);
-    (*graphics)->contid = 0;
+    (*graphics)->contid = new_container_base();
     (*graphics)->printer_display = (GetDeviceCaps(hdc, TECHNOLOGY) == DT_RASPRINTER);
     get_gdi_transform(hdc, &(*graphics)->gdi_transform);
 
@@ -2700,7 +2711,8 @@ GpStatus graphics_from_image(GpImage *image, GpGraphics **graphics)
     (*graphics)->busy = FALSE;
     (*graphics)->textcontrast = 4;
     list_init(&(*graphics)->containers);
-    (*graphics)->contid = 0;
+    /* a metafile numbers its containers from 1, the records say so */
+    (*graphics)->contid = image->type == ImageTypeMetafile ? 0 : new_container_base();
 
     TRACE("<-- %p\n", *graphics);
 
--- a/dlls/gdiplus/image.c
+++ b/dlls/gdiplus/image.c
@@ -1449,8 +1449,14 @@ GpStatus WINGDIPAPI GdipCreateBitmapFromFile(GDIPCONST WCHAR* filename,
 
     stat = GdipCreateStreamOnFile(filename, GENERIC_READ, &stream);
 
+    /* A file that cannot be opened is an invalid parameter. */
+#ifdef SG_MUTANT_GDIPSTAT_OPEN_STATUS
     if(stat != Ok)
         return stat;
+#else
+    if(stat != Ok)
+        return InvalidParameter;
+#endif
 
     stat = GdipCreateBitmapFromStream(stream, bitmap);
 
@@ -2204,6 +2210,12 @@ GpStatus WINGDIPAPI GdipGetImageGraphicsContext(GpImage *image,
 
     if (image->type == ImageTypeMetafile)
         stat = METAFILE_GetGraphicsContext((GpMetafile*)image, graphics);
+#ifndef SG_MUTANT_GDIPSTAT_GRAY16
+    else if (image->type == ImageTypeBitmap && ((GpBitmap *)image)->format == PixelFormat16bppGrayScale)
+#else
+    else if (0)
+#endif
+        stat = OutOfMemory; /* nothing can be drawn in 16 bit gray */
     else
         stat = graphics_from_image(image, graphics);
 
@@ -2217,6 +2229,9 @@ GpStatus WINGDIPAPI GdipGetImageHeight(GpImage *image, UINT *height)
     if(!image || !height)
         return InvalidParameter;
 
+    if(image->type == ImageTypeMetafile && ((GpMetafile *)image)->record_dc)
+        return InvalidParameter;
+
     if(image->type == ImageTypeMetafile)
         *height = units_to_pixels(((GpMetafile*)image)->bounds.Height, ((GpMetafile*)image)->unit,
                                   image->yres, ((GpMetafile*)image)->printer_display);
@@ -2238,6 +2253,10 @@ GpStatus WINGDIPAPI GdipGetImageHorizontalResolution(GpImage *image, REAL *res)
     if(!image || !res)
         return InvalidParameter;
 
+    /* the size of a metafile that is still being recorded is not known yet */
+    if (image->type == ImageTypeMetafile && ((GpMetafile *)image)->record_dc)
+        return InvalidParameter;
+
     *res = image->xres;
 
     TRACE("(%p) <-- %0.2f\n", image, *res);
@@ -2313,6 +2332,9 @@ GpStatus WINGDIPAPI GdipGetImageVerticalResolution(GpImage *image, REAL *res)
     if(!image || !res)
         return InvalidParameter;
 
+    if (image->type == ImageTypeMetafile && ((GpMetafile *)image)->record_dc)
+        return InvalidParameter;
+
     *res = image->yres;
 
     TRACE("(%p) <-- %0.2f\n", image, *res);
@@ -2327,6 +2349,11 @@ GpStatus WINGDIPAPI GdipGetImageWidth(GpImage *image, UINT *width)
     if(!image || !width)
         return InvalidParameter;
 
+#ifndef SG_MUTANT_GDIPSTAT_RECORDING_SIZE
+    if(image->type == ImageTypeMetafile && ((GpMetafile *)image)->record_dc)
+        return InvalidParameter;
+#endif
+
     if(image->type == ImageTypeMetafile)
         *width = units_to_pixels(((GpMetafile*)image)->bounds.Width, ((GpMetafile*)image)->unit,
                                  image->xres, ((GpMetafile*)image)->printer_display);
@@ -2930,8 +2957,9 @@ GpStatus WINGDIPAPI GdipLoadImageFromFile(GDIPCONST WCHAR* filename,
 
     stat = GdipCreateStreamOnFile(filename, GENERIC_READ, &stream);
 
+    /* ... but loading an image from it runs out of memory, as far as the caller is told. */
     if (stat != Ok)
-        return stat;
+        return OutOfMemory;
 
     stat = GdipLoadImageFromStream(stream, image);
 
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4445,6 +4445,12 @@ GpStatus WINGDIPAPI GdipConvertToEmfPlus(const GpGraphics* ref,
     if(!ref || !metafile || !out_metafile || emfType < EmfTypeEmfOnly || emfType > EmfTypeEmfPlusDual)
         return InvalidParameter;
 
+    /* only a plain EMF can be converted */
+#ifndef SG_MUTANT_GDIPSTAT_CONVERT_AGAIN
+    if(metafile->metafile_type == MetafileTypeEmfPlusOnly || metafile->metafile_type == MetafileTypeEmfPlusDual)
+        return InvalidParameter;
+#endif
+
     if(succ)
         *succ = FALSE;
     *out_metafile = NULL;
--- a/dlls/gdiplus/tests/graphics.c
+++ b/dlls/gdiplus/tests/graphics.c
@@ -390,8 +390,7 @@ static void test_save_restore(void)
     log_state(state_b, &state_log);
 
     /* The same state value should never be returned twice. */
-    todo_wine
-        check_no_duplicates(state_log);
+    check_no_duplicates(state_log);
 
     ReleaseDC(hwnd, hdc);
 }
@@ -3172,7 +3171,7 @@ static void test_GdipGetNearestColor(void)
     status = GdipCreateBitmapFromScan0(10, 10, 10, PixelFormat16bppGrayScale, NULL, &bitmap);
     expect(Ok, status);
     status = GdipGetImageGraphicsContext((GpImage*)bitmap, &graphics);
-    todo_wine expect(OutOfMemory, status);
+    expect(OutOfMemory, status);
     if (status == Ok)
         GdipDeleteGraphics(graphics);
     GdipDisposeImage((GpImage*)bitmap);
--- a/dlls/gdiplus/tests/image.c
+++ b/dlls/gdiplus/tests/image.c
@@ -502,7 +502,7 @@ static void test_LoadingImages(void)
 
     bm = (GpBitmap *)0xdeadbeef;
     stat = GdipCreateBitmapFromFile(L"nonexistent", &bm);
-    todo_wine expect(InvalidParameter, stat);
+    expect(InvalidParameter, stat);
     ok(!bm, "returned %p\n", bm);
 
     stat = GdipLoadImageFromFile(0, 0);
@@ -515,7 +515,7 @@ static void test_LoadingImages(void)
 
     img = (GpImage *)0xdeadbeef;
     stat = GdipLoadImageFromFile(L"nonexistent", &img);
-    todo_wine expect(OutOfMemory, stat);
+    expect(OutOfMemory, stat);
     ok(!img, "returned %p\n", img);
 
     stat = GdipLoadImageFromFileICM(0, 0);
@@ -528,7 +528,7 @@ static void test_LoadingImages(void)
 
     img = (GpImage *)0xdeadbeef;
     stat = GdipLoadImageFromFileICM(L"nonexistent", &img);
-    todo_wine expect(OutOfMemory, stat);
+    expect(OutOfMemory, stat);
     ok(!img, "returned %p\n", img);
 }
 
--- a/dlls/gdiplus/tests/metafile.c
+++ b/dlls/gdiplus/tests/metafile.c
@@ -1478,16 +1478,16 @@ static void test_pagetransform(void)
         return;
 
     stat = GdipGetImageHorizontalResolution((GpImage*)metafile, &dpix);
-    todo_wine expect(InvalidParameter, stat);
+    expect(InvalidParameter, stat);
 
     stat = GdipGetImageVerticalResolution((GpImage*)metafile, &dpiy);
-    todo_wine expect(InvalidParameter, stat);
+    expect(InvalidParameter, stat);
 
     stat = GdipGetImageWidth((GpImage*)metafile, &width);
-    todo_wine expect(InvalidParameter, stat);
+    expect(InvalidParameter, stat);
 
     stat = GdipGetImageHeight((GpImage*)metafile, &height);
-    todo_wine expect(InvalidParameter, stat);
+    expect(InvalidParameter, stat);
 
     stat = GdipGetImageGraphicsContext((GpImage*)metafile, &graphics);
     expect(Ok, stat);
@@ -1969,7 +1969,7 @@ static void test_converttoemfplus(void)
 
     /* If we are already an Enhanced Metafile then the conversion fails. */
     stat = pGdipConvertToEmfPlus(graphics, emhmeta, NULL, EmfTypeEmfPlusOnly, NULL, &metafile2);
-    todo_wine expect(InvalidParameter, stat);
+    expect(InvalidParameter, stat);
 
     stat = pGdipConvertToEmfPlus(graphics, metafile, NULL, EmfTypeEmfPlusOnly, NULL, &metafile2);
     todo_wine expect(Ok, stat);
