+/*
+ * Stained Glass OS: the Network Connectivity Status Indicator's active probes (wine-sg 9661)
+ *
+ * Windows' NCSI decides whether a network reaches the internet by asking: an HTTP GET of
+ * http://<ActiveWebProbeHost>/<ActiveWebProbePath> must answer ActiveWebProbeContent
+ * (www.msftconnecttest.com/connecttest.txt, "Microsoft Connect Test"; ipv6.msftconnecttest.com
+ * for IPv6). A network whose probe gets no answer has no internet ("No internet access"); one
+ * whose probe gets another page or a redirect is behind a captive portal (a hotel's sign-in
+ * page: NLM_INTERNET_CONNECTIVITY_WEBHIJACK). This is the Unix side: one probe over one address
+ * family, with the host's own resolver and sockets.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
