+/* Stained Glass OS: the Network Connectivity Status Indicator (wine-sg 9661). Windows' NCSI
+ * probes each address family that has a default route -- an HTTP GET of ActiveWebProbeHost/
+ * ActiveWebProbePath that must answer ActiveWebProbeContent, configured under NlaSvc\Parameters\
+ * Internet (EnableActiveProbing, and the policy NetworkConnectivityStatusIndicator\NoActiveProbe,
+ * turn it off) -- when the network changes, and again while it finds no internet (a captive
+ * portal signed in to). The answer is kept beside the configuration, where the Network List
+ * Manager (netprofm) reads it in every program and watches for changes: SgActiveProbeResultV4/V6,
+ * enum ncsi_result. Without it a default route was "the internet": a network with a gateway and
+ * no way out (a hotel's before sign-in, a router with its line down) showed "Internet access". */
+static const WCHAR ncsi_path[] = L"System\\CurrentControlSet\\Services\\NlaSvc\\Parameters\\Internet";
+static const WCHAR ncsi_policy_path[] = L"Software\\Policies\\Microsoft\\Windows\\NetworkConnectivityStatusIndicator";
+
+static void ncsi_config_a( HKEY key, const WCHAR *name, const char *def, char *buf, DWORD size )
+{
+    WCHAR value[256];
+
+    if (key && get_sz( key, name, value, ARRAY_SIZE(value) ) && value[0])
+        WideCharToMultiByte( CP_UTF8, 0, value, -1, buf, size, NULL, NULL );
+    else
+        lstrcpynA( buf, def, size );
+}
+
+static UINT ncsi_probe_family( HKEY key, UINT family )
+{
+    struct nsi_ncsi_probe_params params = { 0 };
+    BOOL v6 = family == 6;
+
+    params.family = family;
+    params.timeout_ms = 5000;
+    ncsi_config_a( key, v6 ? L"ActiveWebProbeHostV6" : L"ActiveWebProbeHost",
+                   v6 ? "ipv6.msftconnecttest.com" : "www.msftconnecttest.com", params.host, sizeof(params.host) );
+    ncsi_config_a( key, v6 ? L"ActiveWebProbePathV6" : L"ActiveWebProbePath", "connecttest.txt",
+                   params.path, sizeof(params.path) );
+    ncsi_config_a( key, v6 ? L"ActiveWebProbeContentV6" : L"ActiveWebProbeContent", "Microsoft Connect Test",
+                   params.content, sizeof(params.content) );
+    if (nsiproxy_ncsi_probe( &params )) return NCSI_UNKNOWN;
+    TRACE( "IPv%u probe of %s: %u\n", family, debugstr_a(params.host), params.result );
+    return params.result;
+}
+
+/* probes the families with a default route; force: all of them, else only those not on the internet */
+static void update_ncsi( BOOL force )
+{
+    static const UINT families[2] = { 4, 6 };
+    static const WCHAR *const names[2] = { L"SgActiveProbeResultV4", L"SgActiveProbeResultV6" };
+    IP_ADAPTER_ADDRESSES *addrs = NULL, *aa;
+    IP_ADAPTER_GATEWAY_ADDRESS *gw;
+    BOOL route[2] = { FALSE, FALSE };
+    DWORD enabled = 1, off = 0, old;
+    ULONG size = 0, err;
+    HKEY key, policy;
+    unsigned int i;
+
+    if (!(key = create_key( HKEY_LOCAL_MACHINE, ncsi_path ))) return;
+    get_dword( key, L"EnableActiveProbing", &enabled );
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, ncsi_policy_path, 0, KEY_QUERY_VALUE, &policy ))
+    {
+        get_dword( policy, L"NoActiveProbe", &off );
+        RegCloseKey( policy );
+    }
+    for (;;)
+    {
+        err = GetAdaptersAddresses( AF_UNSPEC, GAA_FLAG_INCLUDE_GATEWAYS | GAA_FLAG_SKIP_ANYCAST |
+                                    GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, NULL, addrs, &size );
+        if (err != ERROR_BUFFER_OVERFLOW) break;
+        free( addrs );
+        if (!(addrs = malloc( size ))) { RegCloseKey( key ); return; }
+    }
+    for (aa = err ? NULL : addrs; aa; aa = aa->Next)
+    {
+        if (aa->OperStatus != IfOperStatusUp || aa->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+        for (gw = aa->FirstGatewayAddress; gw; gw = gw->Next)
+        {
+            if (gw->Address.lpSockaddr->sa_family == AF_INET) route[0] = TRUE;
+            else if (gw->Address.lpSockaddr->sa_family == AF_INET6) route[1] = TRUE;
+        }
+    }
+    free( addrs );
+    for (i = 0; i < 2; i++)
+    {
+        UINT result = NCSI_UNKNOWN;
+
+        if (!get_dword( key, names[i], &old )) old = NCSI_UNKNOWN;
+        if (route[i] && enabled && !off)
+        {
+            if (!force && old == NCSI_INTERNET) continue;
+            result = ncsi_probe_family( key, families[i] );
+        }
+        if (result != old) set_dword( key, names[i], result );
+    }
+    RegCloseKey( key );
+}
+
 static DWORD WINAPI tcpip_registry_thread( void *arg )
 {
+    BOOL changed = TRUE;
+
     for (;;)
     {
         update_tcpip_registry();
+#ifndef SG_MUTANT_NO_NCSI
+        update_ncsi( changed );
+#endif
         /* a change comes as a burst of notifications (addresses, routes, the link): settle first */
-        if (!WaitForSingleObject( changed_event, 120 * 1000 ))
-            while (!WaitForSingleObject( changed_event, 300 )) ;
+        changed = !WaitForSingleObject( changed_event, 120 * 1000 );
+        if (changed) while (!WaitForSingleObject( changed_event, 300 )) ;
     }
     return 0;
 }
