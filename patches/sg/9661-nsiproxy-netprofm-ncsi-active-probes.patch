+/* Stained Glass OS 9661: the NCSI probes answered again (their key changed) */
+static void CALLBACK ncsi_changed( void *ctx, BOOLEAN timeout )
+{
+    struct list_manager *mgr = ctx;
+
+    RegNotifyChangeKeyValue( mgr->ncsi_key, FALSE, REG_NOTIFY_CHANGE_LAST_SET, mgr->ncsi_event, TRUE );
+    refresh_networks( mgr );
+}
+
+static void watch_ncsi( struct list_manager *mgr )
+{
+#ifdef SG_MUTANT_NLM_IGNORE_NCSI
+    return;
+#endif
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, NCSI_KEY, 0, KEY_NOTIFY | KEY_QUERY_VALUE, &mgr->ncsi_key ))
+    {
+        mgr->ncsi_key = NULL;
+        return;
+    }
+    if (!(mgr->ncsi_event = CreateEventW( NULL, FALSE, FALSE, NULL )) ||
+        RegNotifyChangeKeyValue( mgr->ncsi_key, FALSE, REG_NOTIFY_CHANGE_LAST_SET, mgr->ncsi_event, TRUE ) ||
+        !RegisterWaitForSingleObject( &mgr->ncsi_wait, mgr->ncsi_event, ncsi_changed, mgr, INFINITE, 0 ))
+        mgr->ncsi_wait = NULL;
+}
