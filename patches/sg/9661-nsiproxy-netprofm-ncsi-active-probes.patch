+/* Stained Glass OS: one NCSI active probe (ncsi.c, wine-sg 9661) */
+enum ncsi_result
+{
+    NCSI_UNKNOWN = 0,   /* not probed (no default route, probing off) */
+    NCSI_NONE = 1,      /* nothing answered: no internet */
+    NCSI_PORTAL = 2,    /* another page answered: a captive portal */
+    NCSI_INTERNET = 3,  /* the expected page: the internet */
+};
+
+struct nsi_ncsi_probe_params
+{
+    UINT family;            /* 4 or 6 */
+    UINT timeout_ms;
+    char host[256];
+    char path[256];
+    char content[256];
+    UINT result;            /* enum ncsi_result */
+};
+
