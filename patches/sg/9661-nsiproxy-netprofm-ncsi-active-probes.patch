+/* Stained Glass OS 9661: what the Network Connectivity Status Indicator's probes found (nsiproxy
+ * keeps it under NlaSvc\Parameters\Internet): a family whose probe got no answer, or a captive
+ * portal's page, reaches the local network only, as on Windows ("No internet access"). Not
+ * probed (probing off, not yet): the default route decides, as before. */
+#define NCSI_KEY L"System\\CurrentControlSet\\Services\\NlaSvc\\Parameters\\Internet"
+static BOOL ncsi_no_internet( int family )
+{
+    DWORD value = 0, size = sizeof(value);
+
+#ifdef SG_MUTANT_NLM_IGNORE_NCSI
+    return FALSE;
+#endif
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, NCSI_KEY, family == AF_INET6 ? L"SgActiveProbeResultV6" : L"SgActiveProbeResultV4",
+                      RRF_RT_REG_DWORD, NULL, &value, &size )) return FALSE;
+    return value == 1 /* nothing answered */ || value == 2 /* a captive portal */;
+}
+
 /* an adapter's connectivity: addresses for the local network, a gateway
  * (a default route) for the internet, IPv4 and IPv6 apart */
 static NLM_CONNECTIVITY adapter_connectivity( const IP_ADAPTER_ADDRESSES *aa )
@@ -964,6 +984,10 @@
         else if (gw->Address.lpSockaddr->sa_family == AF_INET6 && v6)
             ret = (ret & ~NLM_CONNECTIVITY_IPV6_LOCALNETWORK) | NLM_CONNECTIVITY_IPV6_INTERNET;
     }
+    if ((ret & NLM_CONNECTIVITY_IPV4_INTERNET) && ncsi_no_internet( AF_INET ))
+        ret = (ret & ~NLM_CONNECTIVITY_IPV4_INTERNET) | NLM_CONNECTIVITY_IPV4_LOCALNETWORK;
+    if ((ret & NLM_CONNECTIVITY_IPV6_INTERNET) && ncsi_no_internet( AF_INET6 ))
+        ret = (ret & ~NLM_CONNECTIVITY_IPV6_INTERNET) | NLM_CONNECTIVITY_IPV6_LOCALNETWORK;
     return ret;
 }
 
