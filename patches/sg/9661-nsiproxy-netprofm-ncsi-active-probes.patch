+#include "nsiproxy_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(nsi);
+
+static int ms_left( struct timespec *end )
+{
+    struct timespec now;
+    clock_gettime( CLOCK_MONOTONIC, &now );
+    return (end->tv_sec - now.tv_sec) * 1000 + (end->tv_nsec - now.tv_nsec) / 1000000;
+}
+
+/* connect to one of host's addresses of the family, port 80, before the deadline */
+static int probe_connect( const char *host, int family, struct timespec *end )
+{
+    struct addrinfo hints = { .ai_family = family, .ai_socktype = SOCK_STREAM }, *res, *ai;
+    int fd = -1;
+
+    if (getaddrinfo( host, "80", &hints, &res )) return -2;   /* the name is not known */
+    for (ai = res; ai && fd < 0; ai = ai->ai_next)
+    {
+        struct pollfd pfd;
+        int err = 0, left;
+        socklen_t len = sizeof(err);
+
+        if ((fd = socket( ai->ai_family, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0 )) < 0) continue;
+        if (connect( fd, ai->ai_addr, ai->ai_addrlen ) && errno != EINPROGRESS) { close( fd ); fd = -1; continue; }
+        pfd.fd = fd; pfd.events = POLLOUT;
+        if ((left = ms_left( end )) <= 0 || poll( &pfd, 1, left ) != 1 ||
+            getsockopt( fd, SOL_SOCKET, SO_ERROR, &err, &len ) || err)
+        {
+            close( fd );
+            fd = -1;
+        }
+    }
+    freeaddrinfo( res );
+    return fd;
+}
+
+NTSTATUS unix_nsi_ncsi_probe( void *args )
+{
+    struct nsi_ncsi_probe_params *params = args;
+    int family = params->family == 6 ? AF_INET6 : AF_INET;
+    struct timespec end;
+    char req[1024], buf[4096], *body;
+    size_t got = 0;
+    ssize_t r;
+    int fd, status = 0;
+
+    clock_gettime( CLOCK_MONOTONIC, &end );
+    end.tv_sec += params->timeout_ms / 1000;
+    end.tv_nsec += (params->timeout_ms % 1000) * 1000000;
+    if (end.tv_nsec >= 1000000000) { end.tv_sec++; end.tv_nsec -= 1000000000; }
+
+    params->result = NCSI_NONE;
+    if ((fd = probe_connect( params->host, family, &end )) < 0)
+    {
+        TRACE( "%s over IPv%u: no answer (%d)\n", debugstr_a(params->host), params->family, fd );
+        return STATUS_SUCCESS;
+    }
+    snprintf( req, sizeof(req), "GET /%s HTTP/1.1\r\nConnection: Close\r\nUser-Agent: Microsoft NCSI\r\nHost: %s\r\n\r\n",
+              params->path[0] == '/' ? params->path + 1 : params->path, params->host );
+    if (send( fd, req, strlen(req), MSG_NOSIGNAL ) != (ssize_t)strlen(req)) { close( fd ); return STATUS_SUCCESS; }
+    for (;;)
+    {
+        struct pollfd pfd = { fd, POLLIN };
+        int left = ms_left( &end );
+        if (left <= 0 || poll( &pfd, 1, left ) != 1) break;
+        if ((r = recv( fd, buf + got, sizeof(buf) - 1 - got, 0 )) <= 0) break;
+        if ((got += r) >= sizeof(buf) - 1) break;
+    }
+    close( fd );
+    buf[got] = 0;
+    if (!got)
+    {
+        TRACE( "%s over IPv%u: connected, no reply\n", debugstr_a(params->host), params->family );
+        return STATUS_SUCCESS;
+    }
+    /* something answered: the expected page is the internet, anything else (a redirect, a sign-in
+     * page) a captive portal */
+    sscanf( buf, "HTTP/%*s %d", &status );
+    body = strstr( buf, "\r\n\r\n" );
+    if (status == 200 && body && !strncmp( body + 4, params->content, strlen(params->content) ))
+        params->result = NCSI_INTERNET;
+    else
+        params->result = NCSI_PORTAL;
+#ifdef SG_MUTANT_NCSI_ALWAYS_INTERNET
+    params->result = NCSI_INTERNET;
+#endif
+    TRACE( "%s over IPv%u: HTTP %d -> %u\n", debugstr_a(params->host), params->family, status, params->result );
+    return STATUS_SUCCESS;
+}
