 /*
+ * Stained Glass OS: clicking a notification in the notification centre
+ *
+ * Windows hands the click on a notification -- a toast in its action centre
+ * or on screen -- to the program that sent it: to the COM activator the
+ * program registered (its shortcut's System.AppUserModel.ToastActivatorCLSID,
+ * or CustomActivator under HKCU\Software\Classes\AppUserModelId\<id>), the
+ * program started for it if it is not running, through
+ * INotificationActivationCallback::Activate with the toast's launch
+ * arguments; or, to a program that is running and still holds the toast, as
+ * the toast's Activated event. sg-shell's notification centre (sg-notify)
+ * lists the notification history (0815), and asks for this through
+ * SgActivateNotification: each history entry keeps what is needed -- the
+ * program's AppUserModelID and activator, its process, file and the toast's
+ * number there, and the window of this process that takes the click -- and
+ * a balloon's entry its icon's window and callback message.
+ */
+
+#define SG_HISTORY_ROOT L"Software\\Stained Glass\\Notifications\\History"
+#define SG_TOAST_ACTIVATE 0x53475441    /* WM_COPYDATA to the activation window: 'SGTA' */
+#define ACTIVATION_CLASS L"WineToastActivation"
+
+/* this module's own copies: libuuid's would clash with main.c's */
+static const IID iid_activation_callback = {0x53e31837, 0x6600, 0x4a81, {0x93, 0x95, 0x75, 0xcf, 0xfe, 0x74, 0x6f, 0x94}};
+static const IID iid_property_store = {0x886d8eeb, 0x8cf2, 0x4446, {0x8d, 0x02, 0xcd, 0xba, 0x1d, 0xbd, 0xcf, 0x99}};
+static const CLSID clsid_shell_link = {0x00021401, 0x0000, 0x0000, {0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46}};
+static const PROPERTYKEY pkey_aumid = {{0x9f4c2855, 0x9f79, 0x4b39, {0xa8, 0xd0, 0xe1, 0xd4, 0x2d, 0xe1, 0xd5, 0xf3}}, 5};
+static const PROPERTYKEY pkey_toast_activator = {{0x9f4c2855, 0x9f79, 0x4b39, {0xa8, 0xd0, 0xe1, 0xd4, 0x2d, 0xe1, 0xd5, 0xf3}}, 26};
+
+static struct list live_toasts = LIST_INIT( live_toasts );   /* guarded by toast_cs */
+static LONG last_toast_id;
+static HWND activation_window;
+
+/* a reference to the toast with this number, if the program still holds it */
+static struct toast *grab_live_toast( DWORD id )
+{
+    struct toast *toast, *found = NULL;
+    LONG ref;
+
+    EnterCriticalSection( &toast_cs );
+    LIST_FOR_EACH_ENTRY( toast, &live_toasts, struct toast, live_entry )
+    {
+        if (toast->id != id) continue;
+        /* not one already going away */
+        while ((ref = toast->ref) > 0)
+            if (InterlockedCompareExchange( &toast->ref, ref + 1, ref ) == ref)
+            {
+                found = toast;
+                break;
+            }
+        break;
+    }
+    LeaveCriticalSection( &toast_cs );
+    return found;
+}
+
+static void sg_notifications_changed(void)
+{
+    HWND centre;
+    if ((centre = FindWindowW( L"SgNotifyTray", NULL )))
+        PostMessageW( centre, RegisterWindowMessageW( L"SgNotificationsChanged" ), 0, 0 );
+}
+
+/* the history entry of a toast of this process goes: it was activated */
+static void sg_forget_notification( struct toast *toast )
+{
+    WCHAR path[128];
+    DWORD pid = 0, id = 0, size;
+    HKEY key;
+
+    if (!toast->seq) return;
+    swprintf( path, ARRAY_SIZE(path), SG_HISTORY_ROOT L"\\%08u", toast->seq - 1 );
+    toast->seq = 0;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key )) return;
+    size = sizeof(pid);
+    RegQueryValueExW( key, L"Pid", NULL, NULL, (BYTE *)&pid, &size );
+    size = sizeof(id);
+    RegQueryValueExW( key, L"ToastId", NULL, NULL, (BYTE *)&id, &size );
+    RegCloseKey( key );
+    if (pid != GetCurrentProcessId() || id != toast->id) return;
+    if (!RegDeleteKeyW( HKEY_CURRENT_USER, path )) sg_notifications_changed();
+}
+
+/* the activator the program registered for its AppUserModelID */
+static BOOL activator_of_shortcut( const WCHAR *file, const WCHAR *aumid, CLSID *clsid )
+{
+    IPersistFile *persist;
+    IPropertyStore *store;
+    PROPVARIANT value;
+    BOOL ret = FALSE;
+
+    if (FAILED(CoCreateInstance( &clsid_shell_link, NULL, CLSCTX_INPROC_SERVER, &IID_IPersistFile, (void **)&persist )))
+        return FALSE;
+    if (SUCCEEDED(IPersistFile_Load( persist, file, STGM_READ )) &&
+        SUCCEEDED(IPersistFile_QueryInterface( persist, &iid_property_store, (void **)&store )))
+    {
+        PropVariantInit( &value );
+        if (SUCCEEDED(IPropertyStore_GetValue( store, &pkey_aumid, &value )) && value.vt == VT_LPWSTR &&
+            value.pwszVal && !wcsicmp( value.pwszVal, aumid ))
+        {
+            PropVariantClear( &value );
+            if (SUCCEEDED(IPropertyStore_GetValue( store, &pkey_toast_activator, &value )) &&
+                value.vt == VT_CLSID && value.puuid && (value.puuid->Data1 || value.puuid->Data2 || value.puuid->Data3 || *(const UINT64 *)value.puuid->Data4))
+            {
+                *clsid = *value.puuid;
+                ret = TRUE;
+            }
+        }
+        PropVariantClear( &value );
+        IPropertyStore_Release( store );
+    }
+    IPersistFile_Release( persist );
+    return ret;
+}
+
+static BOOL activator_in_shortcuts( const WCHAR *dir, const WCHAR *aumid, CLSID *clsid, int depth, UINT *budget )
+{
+    WIN32_FIND_DATAW data;
+    WCHAR path[MAX_PATH];
+    HANDLE find;
+    BOOL ret = FALSE;
+    size_t len;
+
+    if (depth > 4 || (len = wcslen( dir )) + 4 >= ARRAY_SIZE(path)) return FALSE;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\*", dir );
+    if ((find = FindFirstFileW( path, &data )) == INVALID_HANDLE_VALUE) return FALSE;
+    do
+    {
+        const WCHAR *ext = wcsrchr( data.cFileName, '.' );
+        if (!wcscmp( data.cFileName, L"." ) || !wcscmp( data.cFileName, L".." )) continue;
+        if (len + wcslen( data.cFileName ) + 2 >= ARRAY_SIZE(path)) continue;
+        swprintf( path, ARRAY_SIZE(path), L"%s\\%s", dir, data.cFileName );
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            ret = activator_in_shortcuts( path, aumid, clsid, depth + 1, budget );
+        else if (ext && !wcsicmp( ext, L".lnk" ) && *budget && (*budget)--)
+            ret = activator_of_shortcut( path, aumid, clsid );
+    } while (!ret && *budget && FindNextFileW( find, &data ));
+    FindClose( find );
+    return ret;
+}
+
+static CRITICAL_SECTION activator_cs;
+static CRITICAL_SECTION_DEBUG activator_cs_debug =
+{
+    0, 0, &activator_cs,
+    { &activator_cs_debug.ProcessLocksList, &activator_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": activator_cs") }
+};
+static CRITICAL_SECTION activator_cs = { &activator_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL find_activator( const WCHAR *aumid, CLSID *clsid )
+{
+    static const HKEY roots[] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE };
+    static const int folders[] = { CSIDL_PROGRAMS, CSIDL_COMMON_PROGRAMS };
+    static WCHAR *cached_aumid;
+    static CLSID cached_clsid;
+    static BOOL cached_found;
+    WCHAR key[512], value[64], dir[MAX_PATH];
+    DWORD size;
+    UINT i, budget = 500;
+    BOOL found = FALSE;
+    HRESULT init;
+
+#ifdef SG_MUTANT_NO_TOAST_ACTIVATOR
+    return FALSE;
+#endif
+    if (!aumid || !*aumid) return FALSE;
+    EnterCriticalSection( &activator_cs );
+    if (cached_aumid && !wcsicmp( cached_aumid, aumid ))
+    {
+        if ((found = cached_found)) *clsid = cached_clsid;
+        LeaveCriticalSection( &activator_cs );
+        return found;
+    }
+
+    /* registered for the AppUserModelID */
+    swprintf( key, ARRAY_SIZE(key), L"Software\\Classes\\AppUserModelId\\%s", aumid );
+    for (i = 0; !found && i < ARRAY_SIZE(roots); i++)
+    {
+        size = sizeof(value);
+        if (!RegGetValueW( roots[i], key, L"CustomActivator", RRF_RT_REG_SZ, NULL, value, &size ) &&
+            SUCCEEDED(CLSIDFromString( value, clsid )))
+            found = TRUE;
+    }
+    /* or by the program's shortcut in the Start menu */
+    if (!found)
+    {
+        init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+        for (i = 0; !found && i < ARRAY_SIZE(folders); i++)
+            if (SUCCEEDED(SHGetFolderPathW( NULL, folders[i], NULL, SHGFP_TYPE_CURRENT, dir )))
+                found = activator_in_shortcuts( dir, aumid, clsid, 0, &budget );
+        if (SUCCEEDED(init)) CoUninitialize();
+    }
+    TRACE( "%s: %s\n", debugstr_w(aumid), found ? debugstr_guid( clsid ) : "no activator" );
+
+    free( cached_aumid );
+    cached_aumid = wcsdup( aumid );
+    cached_found = found;
+    if (found) cached_clsid = *clsid;
+    LeaveCriticalSection( &activator_cs );
+    return found;
+}
+
+/* calls the program's activator, starting the program if need be */
+static HRESULT activate_com( const CLSID *clsid, const WCHAR *aumid, const WCHAR *arguments )
+{
+    NOTIFICATION_USER_INPUT_DATA none = { L"", L"" };
+    INotificationActivationCallback *callback;
+    HRESULT hr, init;
+
+    init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    hr = CoCreateInstance( clsid, NULL, CLSCTX_LOCAL_SERVER, &iid_activation_callback, (void **)&callback );
+    if (SUCCEEDED(hr))
+    {
+        hr = INotificationActivationCallback_Activate( callback, aumid ? aumid : L"", arguments ? arguments : L"", &none, 0 );
+        INotificationActivationCallback_Release( callback );
+    }
+    TRACE( "%s %s %s: %#lx\n", debugstr_guid( clsid ), debugstr_w(aumid), debugstr_w(arguments), hr );
+    if (SUCCEEDED(init)) CoUninitialize();
+    return hr;
+}
+
+struct com_activation
+{
+    CLSID clsid;
+    WCHAR *aumid;
+    WCHAR *arguments;
+};
+
+static void CALLBACK com_activation_callback( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct com_activation *call = context;
+    activate_com( &call->clsid, call->aumid, call->arguments );
+    free( call->aumid );
+    free( call->arguments );
+    free( call );
+}
+
+/* a click on a toast on screen: its program's activator too, as Windows calls it */
+static void queue_com_activation( struct toast *toast, const WCHAR *arguments )
+{
+    struct com_activation *call;
+
+#ifdef SG_MUTANT_NO_TOAST_ACTIVATOR
+    return;
+#endif
+    if (!toast->has_activator || !(call = calloc( 1, sizeof(*call) ))) return;
+    call->clsid = toast->activator;
+    call->aumid = toast->aumid ? wcsdup( toast->aumid ) : NULL;
+    call->arguments = wcsdup( arguments ? arguments : L"" );
+    if (!TrySubmitThreadpoolCallback( com_activation_callback, call, NULL )) com_activation_callback( NULL, call );
+}
+
+/* the notification centre's click, delivered to this process (WM_COPYDATA:
+ * the toast's number, then the arguments): the toast's Activated event */
+static LRESULT CALLBACK activation_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_COPYDATA)
+    {
+        const COPYDATASTRUCT *data = (const COPYDATASTRUCT *)lparam;
+        struct toast *toast;
+        WCHAR *arguments;
+        HWND popup;
+        DWORD id, len;
+
+        if (!data || data->dwData != SG_TOAST_ACTIVATE || data->cbData < sizeof(DWORD) + sizeof(WCHAR)) return FALSE;
+        memcpy( &id, data->lpData, sizeof(id) );
+        len = (data->cbData - sizeof(DWORD)) / sizeof(WCHAR);
+        if (!(arguments = calloc( len + 1, sizeof(WCHAR) ))) return FALSE;
+        memcpy( arguments, (const BYTE *)data->lpData + sizeof(DWORD), len * sizeof(WCHAR) );
+#ifdef SG_MUTANT_NO_CENTRE_ACTIVATION
+        free( arguments );
+        return FALSE;
+#endif
+        if (!(toast = grab_live_toast( id )))
+        {
+            TRACE( "toast %lu is gone\n", id );
+            free( arguments );
+            return FALSE;
+        }
+        TRACE( "toast %lu activated from the notification centre: %s\n", id, debugstr_w(arguments) );
+        EnterCriticalSection( &toast_cs );
+        popup = toast->hwnd;
+        LeaveCriticalSection( &toast_cs );
+        /* still on screen: it goes, without a Dismissed */
+        if (popup) SendMessageW( popup, WM_TOAST_CLOSE, 0, 0 );
+        raise_event( toast, TOAST_ACTIVATED, arguments, 0, S_OK );
+        IToastNotification_Release( &toast->IToastNotification_iface );
+        free( arguments );
+        return TRUE;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static void read_value( HKEY key, const WCHAR *name, WCHAR *buf, DWORD len )
+{
+    DWORD size = len * sizeof(WCHAR);
+    buf[0] = 0;
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_SZ, NULL, buf, &size )) buf[0] = 0;
+}
+
+static DWORD read_dword( HKEY key, const WCHAR *name )
+{
+    DWORD value = 0, size = sizeof(value);
+    if (RegGetValueW( key, NULL, name, RRF_RT_REG_DWORD, NULL, &value, &size )) return 0;
+    return value;
+}
+
+struct front_search
+{
+    DWORD pid;
+    HWND found;
+};
+
+static BOOL CALLBACK find_front_window( HWND hwnd, LPARAM lparam )
+{
+    struct front_search *search = (struct front_search *)lparam;
+    DWORD pid;
+
+    if (!IsWindowVisible( hwnd ) || GetWindow( hwnd, GW_OWNER ) ||
+        (GetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOOLWINDOW)) return TRUE;
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (pid != search->pid) return TRUE;
+    search->found = hwnd;
+    return FALSE;
+}
+
+/* the process that sent it, if it still runs */
+static BOOL process_runs( DWORD pid, const WCHAR *exe )
+{
+    WCHAR image[MAX_PATH];
+    DWORD len = ARRAY_SIZE(image);
+    HANDLE process;
+    BOOL ret = FALSE;
+
+    if (!pid || !(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE, pid ))) return FALSE;
+    if (WaitForSingleObject( process, 0 ) == WAIT_TIMEOUT && QueryFullProcessImageNameW( process, 0, image, &len ))
+        ret = !*exe || !wcsicmp( image, exe );
+    CloseHandle( process );
+    return ret;
+}
+
+/***********************************************************************
+ *      SgActivateNotification (windows.ui.@)
+ *
+ * Stained Glass OS: activates the notification history entry SEQ (a toast,
+ * or a balloon), as clicking it in the notification centre does: ARGUMENTS
+ * are a button's, or NULL for the notification's own launch arguments.
+ * Returns S_OK when the program (or the link) was given it, S_FALSE when
+ * there was nobody to give it to.
+ */
+HRESULT WINAPI SgActivateNotification( DWORD seq, const WCHAR *arguments )
+{
+    WCHAR path[128], launch[2048], aumid[512], activator[64], exe[MAX_PATH];
+    DWORD protocol, pid, toast_id, owner_pid = 0;
+    HWND window, owner;
+    UINT callback, icon_id, version;
+    CLSID clsid;
+    HKEY key;
+
+    TRACE( "%lu %s\n", seq, debugstr_w(arguments) );
+
+    swprintf( path, ARRAY_SIZE(path), SG_HISTORY_ROOT L"\\%08u", seq );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key )) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    read_value( key, L"Launch", launch, ARRAY_SIZE(launch) );
+    read_value( key, L"AUMID", aumid, ARRAY_SIZE(aumid) );
+    read_value( key, L"Activator", activator, ARRAY_SIZE(activator) );
+    read_value( key, L"Exe", exe, ARRAY_SIZE(exe) );
+    protocol = read_dword( key, L"Protocol" );
+    pid = read_dword( key, L"Pid" );
+    toast_id = read_dword( key, L"ToastId" );
