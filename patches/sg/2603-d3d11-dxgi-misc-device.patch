+/* No hardware performance counters are exposed: every device-dependent
+ * counter is reported as unsupported, and values outside the documented
+ * device-dependent range are invalid. */
+static HRESULT d3d_check_counter_desc(unsigned int counter, unsigned int misc_flags)
+{
+#ifndef SG_MUTANT_COUNTER_RANGE_UNCHECKED
+    if (counter < 0x40000000u)
+        return E_INVALIDARG;
+#endif
+    if (misc_flags)
+        return E_INVALIDARG;
+    return DXGI_ERROR_UNSUPPORTED;
+}
+
 static HRESULT STDMETHODCALLTYPE d3d11_device_CreateCounter(ID3D11Device2 *iface, const D3D11_COUNTER_DESC *desc,
         ID3D11Counter **counter)
 {
-    FIXME("iface %p, desc %p, counter %p stub!\n", iface, desc, counter);
+    TRACE("iface %p, desc %p, counter %p.\n", iface, desc, counter);
 
-    return E_NOTIMPL;
+    if (!desc)
+        return E_INVALIDARG;
+    if (counter)
+        *counter = NULL;
+    return d3d_check_counter_desc(desc->Counter, desc->MiscFlags);
 }
 
