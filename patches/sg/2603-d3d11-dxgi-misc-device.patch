+
+/* A D3D resource and its aggregated DXGI resource share one eviction
+ * priority, DXGI_RESOURCE_PRIORITY_NORMAL until it is set. */
+void d3d_resource_set_eviction_priority(IUnknown *dxgi_resource, UINT eviction_priority)
+{
+    IDXGIResource *resource;
+
+    if (FAILED(IUnknown_QueryInterface(dxgi_resource, &IID_IDXGIResource, (void **)&resource)))
+        return;
+    IDXGIResource_SetEvictionPriority(resource, eviction_priority);
+    IDXGIResource_Release(resource);
+}
+
+UINT d3d_resource_get_eviction_priority(IUnknown *dxgi_resource)
+{
+    UINT priority = DXGI_RESOURCE_PRIORITY_NORMAL;
+    IDXGIResource *resource;
+
+    if (FAILED(IUnknown_QueryInterface(dxgi_resource, &IID_IDXGIResource, (void **)&resource)))
+        return priority;
+    IDXGIResource_GetEvictionPriority(resource, &priority);
+    IDXGIResource_Release(resource);
+    return priority;
+}
