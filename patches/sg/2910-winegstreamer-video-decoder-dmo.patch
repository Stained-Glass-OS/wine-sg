+/* The compressed formats come with a bitmap header that must be well formed, with a
+ * size of at most 4096 by 4096 pixels and a codec identifier. */
+static BOOL check_dmo_input_format(const DMO_MEDIA_TYPE *type)
+{
+    const VIDEOINFOHEADER *info = (const VIDEOINFOHEADER *)type->pbFormat;
+    LONG width, height;
+
+    if (!IsEqualGUID(&type->formattype, &FORMAT_VideoInfo) || !info || type->cbFormat < sizeof(*info))
+        return TRUE;
+
+#ifdef SG_MUTANT_WMVDEC_FORMAT
+    return TRUE;
+#endif
+    if (info->bmiHeader.biSize < sizeof(BITMAPINFOHEADER)
+            || info->bmiHeader.biSize - sizeof(BITMAPINFOHEADER) > type->cbFormat - sizeof(*info))
+        return FALSE;
+
+    width = info->bmiHeader.biWidth;
+    height = info->bmiHeader.biHeight;
+    if (width < 1 || width > 4096 || !height || height < -4096 || height > 4096)
+        return FALSE;
+    return !!info->bmiHeader.biCompression;
+}
