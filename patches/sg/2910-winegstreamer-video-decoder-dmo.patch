+    if (!size || !lookahead || !alignment)
+        return E_POINTER;
+    if (index > 0)
+        return DMO_E_INVALIDSTREAMINDEX;
+    if (IsEqualGUID(&decoder->dmo_input_type.majortype, &GUID_NULL))
+        return DMO_E_TYPE_NOT_SET;
+
+    if (IsEqualGUID(&decoder->dmo_output_type.majortype, &GUID_NULL)
+            || FAILED(media_object_GetOutputSizeInfo(iface, 0, size, alignment)))
+    {
+        *size = 0;
+        if (decoder->dmo_input_type.pbFormat && decoder->dmo_input_type.cbFormat >= sizeof(*info))
