From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dcomp: a swap chain with alpha shows its alpha

Chrome draws its menus as a composition swap chain with premultiplied
alpha on a popup, a soft shadow in a transparent margin; drawn into an
ordinary window that margin was a big black frame (David). Committing a
swap chain whose alpha mode is premultiplied or straight makes its window
a sheet of glass (__wine_dwm_glass, 0435): an ARGB X window keeping the
pixels' alpha.
---
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -491,6 +491,25 @@
     if (visual->content && SUCCEEDED(IUnknown_QueryInterface(visual->content,
             &IID_IWineDXGICompositionSwapChain, (void **)&swapchain)))
     {
+        IDXGISwapChain1 *chain;
+        DXGI_SWAP_CHAIN_DESC1 desc;
+
+        /* A swap chain with alpha makes its window a sheet of glass (as
+         * DwmExtendFrameIntoClientArea's negative margins do, 0435): the
+         * pixels' own alpha is shown. Chrome's menus are such windows, with
+         * a shadow in a transparent margin -- drawn black without it. */
+        if (SUCCEEDED(IUnknown_QueryInterface(visual->content, &IID_IDXGISwapChain1, (void **)&chain)))
+        {
+            if (SUCCEEDED(IDXGISwapChain1_GetDesc1(chain, &desc)) &&
+                (desc.AlphaMode == DXGI_ALPHA_MODE_PREMULTIPLIED || desc.AlphaMode == DXGI_ALPHA_MODE_STRAIGHT) &&
+                !GetPropW(window, L"__wine_dwm_glass"))
+            {
+                SetPropW(window, L"__wine_dwm_glass", (HANDLE)1);
+                SetWindowPos(window, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
+                             SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+            }
+            IDXGISwapChain1_Release(chain);
+        }
         IWineDXGICompositionSwapChain_set_target(swapchain, window, (int)x, (int)y);
         IWineDXGICompositionSwapChain_Release(swapchain);
     }
