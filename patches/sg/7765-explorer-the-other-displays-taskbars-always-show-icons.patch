From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: the other displays' taskbars always show icons

A window's icon on the other displays' bars was asked for (WM_GETICON, 100 ms) at every paint and
drawn only when it came in time: a busy program's icon came and went, and a window with no icon of
its own had none (the main bar shows the plain program icon). The last icon a window gave is kept,
and the plain program icon is the fallback. Also moves a call below the declarations in
paint_taskbar_button (-Wdeclaration-after-statement).
---
diff --git a/programs/explorer/systray.c b/programs/explorer/systray.c
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -4575,14 +4575,14 @@
 
 static void paint_taskbar_button( const DRAWITEMSTRUCT *dis )
 {
-#ifndef SG_MUTANT_TASKBAR_NAMELESS
-    sg_name_taskbar_button( dis );
-#endif
-
     RECT rect;
     struct taskbar_button *win;
     COLORREF bg = SG_COL_BAR;
 
+#ifndef SG_MUTANT_TASKBAR_NAMELESS
+    sg_name_taskbar_button( dis );
+#endif
+
     if (sg_look != SG_LOOK_FLAT)
     {
         sg_look_paint_button( dis );
@@ -5703,14 +5703,29 @@
     }
 }
 
+/* A window's icon on the other displays' taskbars: the program's, else the
+ * window's own -- the last one it gave kept, as a busy program answers no
+ * WM_GETICON in time -- else Windows' plain program icon, as the main bar
+ * has it. Asked afresh at every paint and drawn only when it answered, a
+ * button's icon came and went (David 2026-11-13: "sometimes the icons on
+ * the other monitors disappear"). */
 static HICON sg_window_small_icon( HWND hwnd )
 {
+    static struct { HWND hwnd; HICON icon; } kept[64];
     struct taskbar_button *win = find_taskbar_button( hwnd );
     HICON icon = NULL;
+    unsigned int i, slot = hwnd ? (ULONG_PTR)hwnd % ARRAY_SIZE(kept) : 0;
     if (win && win->exe_icon) return win->exe_icon;
     SendMessageTimeoutW( hwnd, WM_GETICON, ICON_SMALL2, 0, SMTO_ABORTIFHUNG, 100, (DWORD_PTR *)&icon );
     if (!icon) icon = (HICON)GetClassLongPtrW( hwnd, GCLP_HICONSM );
     if (!icon) icon = (HICON)GetClassLongPtrW( hwnd, GCLP_HICON );
+#ifndef SG_MUTANT_SECOND_ICON_GAPS
+    for (i = 0; i < ARRAY_SIZE(kept); i++)
+        if (kept[i].hwnd == hwnd) { slot = i; break; }
+    if (icon) { kept[slot].hwnd = hwnd; kept[slot].icon = icon; }
+    else if (kept[slot].hwnd == hwnd) icon = kept[slot].icon;
+    if (!icon) icon = LoadIconW( 0, (const WCHAR *)IDI_APPLICATION );
+#endif
     return icon;
 }
 
