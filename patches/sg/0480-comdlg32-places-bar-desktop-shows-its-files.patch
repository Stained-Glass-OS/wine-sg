From: Stained Glass OS contributors
Subject: comdlg32: the places bar's Desktop shows the desktop's files

David: in Notepad's Save As, the places bar's Desktop showed "Documents"
and "This PC" (and "/") among the desktop's files -- the namespace root --
though a file saved there went to the right folder. Desktop now browses to
the desktop's folder (CSIDL_DESKTOPDIRECTORY); its button keeps its name
and icon, and the Look in list still has the namespace.

--- a/dlls/comdlg32/filedlg.c
+++ b/dlls/comdlg32/filedlg.c
@@ -2044,8 +2044,19 @@
   case TBPLACES_CMDID_PLACE2:
   case TBPLACES_CMDID_PLACE3:
   case TBPLACES_CMDID_PLACE4:
-    filedlg_browse_to_pidl(fodInfos, fodInfos->places[id - TBPLACES_CMDID_PLACE0]);
+  {
+    /* Stained Glass OS: Desktop shows what is on the desktop -- its folder --
+     * not the namespace's root, where Documents and This PC sat among the
+     * files */
+    LPITEMIDLIST place = fodInfos->places[id - TBPLACES_CMDID_PLACE0], desktop_dir = NULL;
+    if (place && !place->mkid.cb && SUCCEEDED(SHGetSpecialFolderLocation(hwnd, CSIDL_DESKTOPDIRECTORY, &desktop_dir)))
+    {
+        filedlg_browse_to_pidl(fodInfos, desktop_dir);
+        ILFree(desktop_dir);
+    }
+    else filedlg_browse_to_pidl(fodInfos, place);
     break;
+  }
 
   case edt1:
   case cmb13:
