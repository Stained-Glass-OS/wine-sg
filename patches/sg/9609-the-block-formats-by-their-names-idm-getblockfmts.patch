From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mshtml: the block formats by their names (IDM_GETBLOCKFMTS) (9609)

Editors fill their paragraph-style lists from IDM_GETBLOCKFMTS (the DHTML
Editing Control's DECMD_GETBLOCKFMTNAMES) and match them against
IDM_BLOCKFMT (queryCommandValue("FormatBlock"), DECMD_GETBLOCKFMT).
IDM_GETBLOCKFMTS was not supported and IDM_BLOCKFMT read the tag ("h1")
where Internet Explorer gives the name ("Heading 1"). It now lists the
names (Normal, Formatted, Address, Heading 1-6, Numbered List, Bulleted
List, Directory List, Menu List, Definition Term, Definition, Paragraph),
reads the selection's block format by its name, and setting one by name
makes the lists with the list commands and the rest with their tags.
---
--- a/dlls/mshtml/editor.c
+++ b/dlls/mshtml/editor.c
@@ -884,6 +884,54 @@
     return S_OK;
 }
 
+#ifndef SG_MUTANT_NO_BLOCKFMTS
+/* Stained Glass OS (wine-sg 9609): the block formats by the names Internet Explorer gives them
+ * (IDM_GETBLOCKFMTS lists them, IDM_BLOCKFMT reads and sets them) and the tags they are */
+static const struct { const WCHAR *name; const char *tag; } block_formats[] = {
+    { L"Normal",          "p" },
+    { L"Formatted",       "pre" },
+    { L"Address",         "address" },
+    { L"Heading 1",       "h1" },
+    { L"Heading 2",       "h2" },
+    { L"Heading 3",       "h3" },
+    { L"Heading 4",       "h4" },
+    { L"Heading 5",       "h5" },
+    { L"Heading 6",       "h6" },
+    { L"Numbered List",   "ol" },
+    { L"Bulleted List",   "ul" },
+    { L"Directory List",  "dir" },
+    { L"Menu List",       "menu" },
+    { L"Definition Term", "dt" },
+    { L"Definition",      "dd" },
+    { L"Paragraph",       "p" },
+};
+
+static HRESULT exec_getblockfmts(HTMLDocumentNode *doc, DWORD cmdexecopt, VARIANT *in, VARIANT *out)
+{
+    SAFEARRAY *sa;
+    LONG i;
+
+    TRACE("(%p)->(%p %p)\n", doc, in, out);
+
+    if(!out)
+        return E_INVALIDARG;
+    if(!(sa = SafeArrayCreateVector(VT_BSTR, 0, ARRAY_SIZE(block_formats))))
+        return E_OUTOFMEMORY;
+    for(i = 0; i < ARRAY_SIZE(block_formats); i++) {
+        BSTR name = SysAllocString(block_formats[i].name);
+        HRESULT hres = name ? SafeArrayPutElement(sa, &i, name) : E_OUTOFMEMORY;
+        SysFreeString(name);
+        if(FAILED(hres)) {
+            SafeArrayDestroy(sa);
+            return hres;
+        }
+    }
+    V_VT(out) = VT_ARRAY | VT_BSTR;
+    V_ARRAY(out) = sa;
+    return S_OK;
+}
+#endif
+
 /* the block format ("h1", "p", "pre"...) of the selection, IDM_BLOCKFMT */
 static HRESULT exec_blockfmt(HTMLDocumentNode *doc, DWORD cmdexecopt, VARIANT *in, VARIANT *out)
 {
@@ -897,6 +945,21 @@
         V_BSTR(out) = NULL;
         if(NS_SUCCEEDED(get_ns_command_state(doc->browser, NSCMD_PARAGRAPHSTATE, nsparam))) {
             nsICommandParams_GetCStringValue(nsparam, NSSTATE_ATTRIBUTE, &stra);
+#ifndef SG_MUTANT_NO_BLOCKFMTS
+            if(stra) {
+                /* by its name, as Internet Explorer reads it */
+                unsigned i;
+                for(i = 0; i < ARRAY_SIZE(block_formats); i++)
+                    if(!_stricmp(stra, block_formats[i].tag)) {
+                        V_BSTR(out) = SysAllocString(block_formats[i].name);
+                        break;
+                    }
+                if(V_BSTR(out)) {
+                    nsfree(stra);
+                    stra = NULL;
+                }
+            }
+#endif
             if(stra) {
                 int len = MultiByteToWideChar(CP_ACP, 0, stra, -1, NULL, 0);
                 WCHAR *strw = malloc(len * sizeof(WCHAR));
@@ -928,6 +991,24 @@
         p = format;
         if(*p == '<')
             p++;
+#ifndef SG_MUTANT_NO_BLOCKFMTS
+        {
+            /* the lists are list commands, the other names their tags */
+            unsigned i;
+            for(i = 0; i < ARRAY_SIZE(block_formats); i++)
+                if(!wcsicmp(V_BSTR(in), block_formats[i].name)) break;
+            if(i < ARRAY_SIZE(block_formats) && i >= 9 && i <= 12) {
+                do_ns_command(doc, i == 9 ? NSCMD_OL : NSCMD_UL, NULL);
+                free(format);
+                update_doc(doc->browser->doc, UPDATE_UI);
+                return S_OK;
+            }
+            if(i < ARRAY_SIZE(block_formats) && i >= 13) {
+                strcpy(format, block_formats[i].tag);
+                p = format;
+            }
+        }
+#endif
         if(!_strnicmp(p, "Heading ", 8)) {
             memmove(format, "h", 1);
             memmove(format + 1, p + 8, strlen(p + 8) + 1);
@@ -1190,6 +1271,9 @@
     case IDM_UNDO:
     case IDM_REDO:
     case IDM_BLOCKFMT:
+#ifndef SG_MUTANT_NO_BLOCKFMTS
+    case IDM_GETBLOCKFMTS:
+#endif
         cmd->cmdf = query_ns_edit_status(doc, NULL);
         break;
     }
@@ -1416,6 +1500,9 @@
     {IDM_UNDO,            query_edit_status,    exec_undo_edit},
     {IDM_REDO,            query_edit_status,    exec_redo_edit},
     {IDM_BLOCKFMT,        query_edit_status,    exec_blockfmt},
+#ifndef SG_MUTANT_NO_BLOCKFMTS
+    {IDM_GETBLOCKFMTS,    query_edit_status,    exec_getblockfmts},
+#endif
     {IDM_SETDIRTY,        NULL,                 exec_setdirty},
     {0,NULL,NULL}
 };
