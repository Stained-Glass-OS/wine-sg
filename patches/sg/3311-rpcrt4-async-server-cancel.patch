-    FIXME("(%p, %ld/0x%lx): stub\n", pAsync, ExceptionCode, ExceptionCode);
-    return RPC_S_INVALID_ASYNC_HANDLE;
+    TRACE("(%p, %ld/0x%lx)\n", pAsync, ExceptionCode, ExceptionCode);
+    return I_RpcAsyncAbortCall(pAsync, ExceptionCode);
 }
 
 /***********************************************************************
@@ -166,8 +176,10 @@
  *
  * PARAMS
  *  pAsync        [I] Asynchronous client state to abort.
- *  fAbortCall    [I] If TRUE, then send a cancel to the server, otherwise
- *                    just wait for the call to complete.
+ *  fAbortCall    [I] If TRUE, then the call is abandoned: its notification is
+ *                    sent now and RpcAsyncCompleteCall gives RPC_S_CALL_CANCELLED;
+ *                    otherwise the server is told to cancel the call and
+ *                    the call ends when it answers.
  *
  * RETURNS
  *  Success: RPC_S_OK.
@@ -175,6 +187,36 @@
  */
 RPC_STATUS WINAPI RpcAsyncCancelCall(PRPC_ASYNC_STATE pAsync, BOOL fAbortCall)
 {
-    FIXME("(%p, %s): stub\n", pAsync, fAbortCall ? "TRUE" : "FALSE");
-    return RPC_S_INVALID_ASYNC_HANDLE;
+    struct async_call_data *data;
+    RpcConnection *conn;
+
+    TRACE("(%p, %s)\n", pAsync, fAbortCall ? "TRUE" : "FALSE");
+
+    if (!pAsync || !valid_async_handle(pAsync)) return RPC_S_INVALID_ASYNC_HANDLE;
+    if (!(data = pAsync->StubInfo) || !data->pStubMsg->IsClient) return RPC_S_INVALID_ASYNC_HANDLE;
+
+    /* nothing to cancel in a call which has ended */
+    if (data->call_status != RPC_S_ASYNC_CALL_PENDING) return RPC_S_OK;
+
+    conn = data->pStubMsg->RpcMsg->ReservedForRuntime;
+    if (!conn) return RPC_S_INVALID_ASYNC_HANDLE;
+
+    if (fAbortCall)
+    {
+        int i;
+
+        InterlockedExchange(&data->cancelled, 1);
+        /* the thread waiting for the response gives up, and the notification is sent; it may be
+         * about to start waiting, when there is nothing to cancel yet: try again for a while */
+        for (i = 0; i < 100 && data->call_status == RPC_S_ASYNC_CALL_PENDING; i++)
+        {
+#ifndef SG_MUTANT_ASYNCRPC_NOCANCELIO
+            rpcrt4_conn_cancel_call(conn);
+#endif
+            Sleep(10);
+        }
+        return RPC_S_OK;
+    }
+
+    return RPCRT4_SendCancel(conn);
 }
