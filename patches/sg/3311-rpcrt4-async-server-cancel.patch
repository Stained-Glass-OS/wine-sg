+/***********************************************************************
+ *             RpcServerTestCancel (RPCRT4.@)
+ *
+ * Tells a manager routine whether the client cancelled the call (RpcAsyncCancelCall), for the
+ * call being served by this thread (a NULL binding), or, with the RpcAsyncGetCallHandle of an
+ * asynchronous call, for that call.
+ */
+RPC_STATUS WINAPI RpcServerTestCancel(RPC_BINDING_HANDLE binding)
+{
+    RpcBinding *bind = binding ? binding : RPCRT4_GetThreadCurrentCallHandle();
+
