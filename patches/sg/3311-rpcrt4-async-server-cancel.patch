+/* ends a server call: the parameters (if the manager routine has had them), the buffers, the stack,
+ * and the state of the call, which is freed too */
+void NdrpFreeAsyncServerCall(RPC_ASYNC_STATE *pAsync, BOOL free_params)
+{
+    struct async_call_data *async_call_data = pAsync->StubInfo;
+    PMIDL_STUB_MESSAGE pStubMsg = async_call_data->pStubMsg;
+    const NDR_PROC_HEADER *header = async_call_data->pProcHeader;
+
+    if (free_params)
+    {
+        stub_do_args(pStubMsg, async_call_data->pHandleFormat, STUBLESS_MUSTFREE, async_call_data->number_of_params, NULL);
+        stub_do_args(pStubMsg, async_call_data->pHandleFormat, STUBLESS_FREE, async_call_data->number_of_params, NULL);
+    }
+    if (pStubMsg->fHasNewCorrDesc) NdrCorrelationFree(pStubMsg);
+    if (header->Oi_flags & Oi_FULL_PTR_USED) NdrFullPointerXlatFree(pStubMsg->FullPtrXlatTables);
+
+    /* the response, if there is one, and the request */
+    if (pStubMsg->RpcMsg->Buffer != async_call_data->request_buffer) I_RpcFree(pStubMsg->RpcMsg->Buffer);
+    I_RpcFree(async_call_data->request_buffer);
+
+    free(pStubMsg->StackTop);
+    I_RpcFree(async_call_data);
+    I_RpcFree(pAsync);
+}
+
 RPC_STATUS NdrpCompleteAsyncServerCall(RPC_ASYNC_STATE *pAsync, void *Reply)
 {
     /* pointer to start of stack where arguments start */
     PMIDL_STUB_MESSAGE pStubMsg;
