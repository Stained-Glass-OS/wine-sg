+            if (phase == STUBLESS_MARSHAL)
             {
-                pStubMsg->RpcMsg->BufferLength = pStubMsg->BufferLength;
-                /* allocate buffer for [out] and [ret] params */
-                status = I_RpcGetBuffer(pStubMsg->RpcMsg);
-                if (status)
