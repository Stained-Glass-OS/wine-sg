+
+static struct record *copy_record( const struct record *src )
+{
+    struct record *record;
+    UINT i;
+
+    if (!(record = create_record( src->table ))) return NULL;
+    for (i = 0; i < src->count; i++)
+    {
+        const struct field *from = &src->fields[i];
+        struct field *to = &record->fields[i];
+
+        to->type = from->type;
+        to->is_set = from->is_set;
+        if (from->type & CIM_FLAG_ARRAY)
+        {
+            const struct array *a = from->u.aval;
+            struct array *copy;
+
+            if (!a) continue;
+            if (!(copy = calloc( 1, sizeof(*copy) )) || !(copy->ptr = calloc( a->count ? a->count : 1, a->elem_size )))
+            {
+                free( copy );
+                destroy_record( record );
+                return NULL;
+            }
+            copy->elem_size = a->elem_size;
+            copy->count = a->count;
+            if ((from->type & CIM_TYPE_MASK) == CIM_STRING || (from->type & CIM_TYPE_MASK) == CIM_DATETIME ||
+                (from->type & CIM_TYPE_MASK) == CIM_REFERENCE)
+            {
+                UINT j;
+                for (j = 0; j < a->count; j++)
+                {
+                    const WCHAR *str = ((WCHAR **)a->ptr)[j];
+                    if (str && !(((WCHAR **)copy->ptr)[j] = wcsdup( str )))
+                    {
+                        to->u.aval = copy;
+                        destroy_record( record );
+                        return NULL;
+                    }
+                }
+            }
+            else memcpy( copy->ptr, a->ptr, a->count * a->elem_size );
+            to->u.aval = copy;
+        }
+        else if (from->type == CIM_STRING || from->type == CIM_DATETIME || from->type == CIM_REFERENCE)
+        {
+            if (from->u.sval && !(to->u.sval = wcsdup( from->u.sval )))
+            {
+                destroy_record( record );
+                return NULL;
+            }
+        }
+        else to->u.ival = from->u.ival;
+    }
+    return record;
+}
