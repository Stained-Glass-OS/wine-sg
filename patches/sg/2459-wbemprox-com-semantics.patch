+struct next_async
+{
+    IEnumWbemClassObject *iter;
+    IWbemObjectSink *sink;
+    ULONG count;
+};
+
+static DWORD CALLBACK next_async_proc( void *arg )
+{
+    struct next_async *async = arg;
+    IWbemClassObject *obj;
+    ULONG i, returned;
+    HRESULT hr = WBEM_S_NO_ERROR;
+
+    for (i = 0; i < async->count; i++)
+    {
+        hr = IEnumWbemClassObject_Next( async->iter, WBEM_INFINITE, 1, &obj, &returned );
+        if (FAILED(hr) || !returned)
+        {
+            hr = FAILED(hr) ? hr : WBEM_S_NO_ERROR;
+            break;
+        }
+        IWbemObjectSink_Indicate( async->sink, 1, &obj );
+        IWbemClassObject_Release( obj );
+        hr = WBEM_S_NO_ERROR;
+    }
+    IWbemObjectSink_SetStatus( async->sink, WBEM_STATUS_COMPLETE, hr, NULL, NULL );
+    IWbemObjectSink_Release( async->sink );
+    IEnumWbemClassObject_Release( async->iter );
+    free( async );
+    return 0;
+}
