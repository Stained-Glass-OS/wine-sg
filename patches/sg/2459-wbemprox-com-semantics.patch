+
+    if (!pSink) return WBEM_E_INVALID_PARAMETER;
+    if (!(async = malloc( sizeof(*async) ))) return E_OUTOFMEMORY;
+
+    async->iter = iface;
+    async->sink = pSink;
+    async->count = uCount;
+    IEnumWbemClassObject_AddRef( iface );
+    IWbemObjectSink_AddRef( pSink );
+    if (!QueueUserWorkItem( next_async_proc, async, WT_EXECUTELONGFUNCTION ))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        IWbemObjectSink_Release( pSink );
+        IEnumWbemClassObject_Release( iface );
+        free( async );
+        return hr;
+    }
+    return WBEM_S_NO_ERROR;
 }
 
