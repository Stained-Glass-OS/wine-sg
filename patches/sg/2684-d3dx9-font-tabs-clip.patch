From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] d3dx9: DrawText tabs and clipped wrapped text, RenderToEnvMap arguments

ID3DXFont::DrawText follows the heights the Windows library gives (the
todo_wine tests of the font): without DT_EXPANDTABS tabs take no room and
text of tabs only is not drawn (height 0); with it a tab is four average
characters wide and a tab at a line break stays with the line before it
instead of being swallowed like a space; wrapped text (DT_WORDBREAK) in a
rectangle that is too small goes on for one line past the bottom, text with
only line breaks does not. ID3DXRenderToEnvMap::BeginSphere, BeginHemisphere
and BeginParabolic refuse NULL textures with D3DERR_INVALIDCALL. Removes
eleven todo_wine marks of the core test.
---
--- a/dlls/d3dx9_36/font.c
+++ b/dlls/d3dx9_36/font.c
@@ -556,7 +556,8 @@ static void word_break(HDC hdc, const WCHAR *str, unsigned int *str_len,
         i = chars_fit;
 
     *chars_used = i;
-    if (sla[i].fWhiteSpace)
+    /* a space at the break goes with the line before; a tab does not */
+    if (sla[i].fWhiteSpace && str[i] != '\t')
         ++(*chars_used);
 
     /* Remove extra spaces */
@@ -569,6 +570,29 @@ static void word_break(HDC hdc, const WCHAR *str, unsigned int *str_len,
     free(sla);
 }
 
+static BOOL has_tab(const WCHAR *str, unsigned int len)
+{
+    while (len--)
+        if (*str++ == '\t')
+            return TRUE;
+    return FALSE;
+}
+
+/* With DT_EXPANDTABS a tab is as wide as four average characters; the font gives it some other width, so the
+ * positions of the characters after it are moved by the difference. */
+static int tab_width_difference(HDC hdc)
+{
+    TEXTMETRICW tm;
+    SIZE tab;
+
+    GetTextMetricsW(hdc, &tm);
+    GetTextExtentPoint32W(hdc, L"\t", 1, &tab);
+#ifdef SG_MUTANT_D3DXFONT_TAB_ZERO
+    return -tab.cx;
+#endif
+    return 4 * tm.tmAveCharWidth - tab.cx;
+}
+
 static const WCHAR *read_line(HDC hdc, const WCHAR *str, unsigned int *count,
         WCHAR *dest, unsigned int *dest_len, int width, DWORD format, SIZE *size)
 {
@@ -580,13 +604,37 @@ static const WCHAR *read_line(HDC hdc, const WCHAR *str, unsigned int *count,
     while (*count && (str[i] != '\n' || (format & DT_SINGLELINE)))
     {
         --(*count);
-        if (str[i] != '\r' && str[i] != '\n')
+        if (str[i] != '\r' && str[i] != '\n' && (str[i] != '\t' || (format & DT_EXPANDTABS)))
             dest[(*dest_len)++] = str[i];
         ++i;
     }
 
     num_fit = 0;
+    if ((format & DT_EXPANDTABS) && has_tab(dest, *dest_len))
+    {
+        int *positions = malloc(*dest_len * sizeof(*positions));
+
+        if (positions)
+        {
+            int diff = tab_width_difference(hdc), tabs = 0;
+            unsigned int j;
+
+            GetTextExtentExPointW(hdc, dest, *dest_len, 0, &num_fit, positions, size);
+            for (j = 0, num_fit = 0; j < *dest_len; ++j)
+            {
+                if (dest[j] == '\t')
+                    tabs++;
+                positions[j] += tabs * diff;
+                if (positions[j] <= width)
+                    num_fit = j + 1;
+            }
+            size->cx = *dest_len ? positions[*dest_len - 1] : 0;
+            free(positions);
+            goto fitted;
+        }
+    }
     GetTextExtentExPointW(hdc, dest, *dest_len, width, &num_fit, NULL, size);
+fitted:
 
     if (num_fit < *dest_len && (format & DT_WORDBREAK))
     {
@@ -608,6 +656,16 @@ static const WCHAR *read_line(HDC hdc, const WCHAR *str, unsigned int *count,
     return NULL;
 }
 
+/* Text that wraps goes on for one line past the bottom of the rectangle, text that only has line breaks does not
+ * (the heights the Windows library gives for the same text in a rectangle that is too small). */
+static int extra_line(const struct d3dx_font *font, DWORD format)
+{
+#ifdef SG_MUTANT_D3DXFONT_NO_EXTRA_LINE
+    return 0;
+#endif
+    return (format & DT_WORDBREAK) ? font->metrics.tmHeight : 0;
+}
+
 static int compute_rect(struct d3dx_font *font, const WCHAR *string, unsigned int count,
         WCHAR *line, RECT *rect, DWORD format)
 {
@@ -629,7 +687,7 @@ static int compute_rect(struct d3dx_font *font, const WCHAR *string, unsigned in
             max_width = size.cx;
 
         y += lh;
-        if (!(format & DT_NOCLIP) && (y > rect->bottom))
+        if (!(format & DT_NOCLIP) && (y > rect->bottom + extra_line(font, format)))
             break;
     }
 
@@ -687,6 +745,17 @@ static INT WINAPI ID3DXFontImpl_DrawTextW(ID3DXFont *iface, ID3DXSprite *sprite,
     if (!count)
         return 0;
 
+    /* tabs that are not expanded take no room: text of nothing else is not drawn at all */
+    if (!(format & DT_EXPANDTABS))
+    {
+        unsigned int k;
+
+        for (k = 0; k < count && string[k] == '\t'; ++k)
+            ;
+        if (k == count)
+            return 0;
+    }
+
     if (format & DT_CALCRECT)
         format |= DT_NOCLIP;
 
@@ -762,6 +831,18 @@ static INT WINAPI ID3DXFontImpl_DrawTextW(ID3DXFont *iface, ID3DXSprite *sprite,
 
         GetCharacterPlacementW(font->hdc, line, line_len, 0, &results, 0);
 
+        if (format & DT_EXPANDTABS)
+        {
+            int diff = tab_width_difference(font->hdc), tabs = 0;
+
+            for (i = 0; i < results.nGlyphs; ++i)
+            {
+                results.lpCaretPos[i] += tabs * diff;
+                if (line[i] == '\t')
+                    tabs++;
+            }
+        }
+
         for (i = 0; i < results.nGlyphs; ++i)
         {
             IDirect3DTexture9 *texture;
@@ -789,6 +870,12 @@ static INT WINAPI ID3DXFontImpl_DrawTextW(ID3DXFont *iface, ID3DXSprite *sprite,
                 if (pos.x + black_box.right - black_box.left > rect->right)
                     black_box.right = black_box.left + rect->right - pos.x;
 
+                if (pos.y >= rect->bottom)
+                {
+                    IDirect3DTexture9_Release(texture);
+                    continue;
+                }
+
                 if (pos.y + black_box.bottom - black_box.top > rect->bottom)
                     black_box.bottom = black_box.top + rect->bottom - pos.y;
             }
@@ -807,7 +894,7 @@ static INT WINAPI ID3DXFontImpl_DrawTextW(ID3DXFont *iface, ID3DXSprite *sprite,
         free(results.lpGlyphs);
 
         y += lh;
-        if (!(DT_NOCLIP & format) && (y > rect->bottom))
+        if (!(DT_NOCLIP & format) && (y > rect->bottom + extra_line(font, format)))
             break;
     }
 
--- a/dlls/d3dx9_36/render.c
+++ b/dlls/d3dx9_36/render.c
@@ -601,7 +601,14 @@ cleanup:
 static HRESULT WINAPI D3DXRenderToEnvMap_BeginSphere(ID3DXRenderToEnvMap *iface,
                                                      IDirect3DTexture9 *texture)
 {
-    FIXME("iface %p, texture %p stub!\n", iface, texture);
+    TRACE("iface %p, texture %p.\n", iface, texture);
+
+#ifndef SG_MUTANT_D3DXENV_NO_CHECK
+    if (!texture)
+        return D3DERR_INVALIDCALL;
+#endif
+
+    FIXME("Rendering to a sphere map is not implemented.\n");
     return E_NOTIMPL;
 }
 
@@ -609,7 +616,12 @@ static HRESULT WINAPI D3DXRenderToEnvMap_BeginHemisphere(ID3DXRenderToEnvMap *if
                                                          IDirect3DTexture9 *pos_z_texture,
                                                          IDirect3DTexture9 *neg_z_texture)
 {
-    FIXME("iface %p, pos_z_texture %p, neg_z_texture %p stub!\n", iface, pos_z_texture, neg_z_texture);
+    TRACE("iface %p, pos_z_texture %p, neg_z_texture %p.\n", iface, pos_z_texture, neg_z_texture);
+
+    if (!pos_z_texture || !neg_z_texture)
+        return D3DERR_INVALIDCALL;
+
+    FIXME("Rendering to hemisphere maps is not implemented.\n");
     return E_NOTIMPL;
 }
 
@@ -617,7 +629,12 @@ static HRESULT WINAPI D3DXRenderToEnvMap_BeginParabolic(ID3DXRenderToEnvMap *ifa
                                                         IDirect3DTexture9 *pos_z_texture,
                                                         IDirect3DTexture9 *neg_z_texture)
 {
-    FIXME("iface %p, pos_z_texture %p, neg_z_texture %p stub!\n", iface, pos_z_texture, neg_z_texture);
+    TRACE("iface %p, pos_z_texture %p, neg_z_texture %p.\n", iface, pos_z_texture, neg_z_texture);
+
+    if (!pos_z_texture || !neg_z_texture)
+        return D3DERR_INVALIDCALL;
+
+    FIXME("Rendering to hemisphere maps is not implemented.\n");
     return E_NOTIMPL;
 }
 
