+/* ---- the Layout and Paper/Quality pages ---- */
+
+static BOOL on_std_page( enum page_kind kind, BYTE dmpub )
+{
+    static const BYTE layout[] = { DMPUB_ORIENTATION, DMPUB_DUPLEX, DMPUB_PAGEORDER, DMPUB_NUP, DMPUB_NUP_DIRECTION,
+                                   DMPUB_BOOKLET_EDGE, DMPUB_MANUAL_DUPLEX, DMPUB_STAPLE };
+    static const BYTE paper[] = { DMPUB_DEFSOURCE, DMPUB_FORMNAME, DMPUB_MEDIATYPE, DMPUB_COLOR, DMPUB_PRINTQUALITY,
+                                  DMPUB_QUALITY, DMPUB_COPIES_COLLATE, DMPUB_OUTPUTBIN, DMPUB_SCALE };
+    const BYTE *list = kind == PAGE_LAYOUT ? layout : paper;
+    unsigned int i, count = kind == PAGE_LAYOUT ? ARRAY_SIZE(layout) : ARRAY_SIZE(paper);
+
+    for (i = 0; i < count; i++) if (list[i] == dmpub) return TRUE;
+    return FALSE;
+}
+
+static void std_create( struct cp_page *page )
+{
+    RECT client, du = { 10, 10, 10, 4 }, rect;
+    int i, y;
+
+    GetClientRect( page->hwnd, &client );
+    MapDialogRect( page->hwnd, &du );
+    y = du.top;
+    page->row_count = 0;
+    for (i = 0; i < page->cp->ui->cOptItem && page->row_count < MAX_ROWS; i++)
+    {
+        OPTITEM *item = &page->cp->ui->pOptItem[i];
+        if (!on_std_page( page->kind, item->DMPubID )) continue;
+        SetRect( &rect, du.left, y, client.right - du.right, y );
+        y += row_create( page, page->row_count++, i, &rect ) + du.bottom;
+    }
+}
+
+/* ---- the caller's own pages: controls numbered from BegCtrlID ---- */
+
+static int ext_offset( BYTE type )
+{
+    switch (type)
+    {
+    case TVOT_2STATES: return 6;
+    case TVOT_3STATES: return 8;
+    case TVOT_UDARROW: return 7;
+    case TVOT_TRACKBAR:
+    case TVOT_SCROLLBAR: return 7;
+    case TVOT_EDITBOX: return 6;
+    default: return 4;
+    }
+}
+
+static BOOL bound_here( const struct cp_page *page, const OPTITEM *item )
+{
+    return item->pOptType && item->pOptType->BegCtrlID && item->DlgPageIdx == page->index;
+}
+
+static void custom_update( struct cp_page *page )
+{
+    struct comprop *cp = page->cp;
+    WCHAR text[MAX_RES_STR_CHARS];
+    int i, j;
+
+    page->updating = TRUE;
+    for (i = 0; i < cp->ui->cOptItem; i++)
+    {
+        OPTITEM *item = &cp->ui->pOptItem[i];
+        const OPTTYPE *type = item->pOptType;
+        WORD id;
+        HWND ctl;
+        BOOL hidden, disabled;
+
+        if (!bound_here( page, item )) continue;
+        id = type->BegCtrlID;
+        hidden = item_hidden( cp, item );
+        disabled = item_disabled( cp, item );
+        if ((ctl = GetDlgItem( page->hwnd, id + 1 )) && item->pName)
+        {
+            cpsui_string( cp, item->pName, text, ARRAY_SIZE(text) );
+            SetWindowTextW( ctl, text );
+        }
+        switch (type->Type)
+        {
+        case TVOT_2STATES:
+        case TVOT_3STATES:
+            for (j = 0; j < (type->Type == TVOT_2STATES ? 2 : 3); j++)
+            {
+                if (!(ctl = GetDlgItem( page->hwnd, id + 2 + j * 2 ))) continue;
+                cpsui_string( cp, type->pOptParam[j].pData, text, ARRAY_SIZE(text) );
+                SetWindowTextW( ctl, text );
+                SendMessageW( ctl, BM_SETCHECK, item->Sel == j ? BST_CHECKED : BST_UNCHECKED, 0 );
+                EnableWindow( ctl, !disabled && !(type->pOptParam[j].Flags & OPTPF_DISABLED) );
+            }
+            break;
+        case TVOT_COMBOBOX:
+        case TVOT_LISTBOX:
+            if ((ctl = GetDlgItem( page->hwnd, id + 2 )))
+            {
+                WCHAR cls[32];
+                GetClassNameW( ctl, cls, ARRAY_SIZE(cls) );
+                fill_list( cp, item, ctl, !wcsicmp( cls, WC_LISTBOXW ) );
+                EnableWindow( ctl, !disabled );
+            }
+            break;
+        case TVOT_CHKBOX:
+            if ((ctl = GetDlgItem( page->hwnd, id + 2 )))
+            {
+                SendMessageW( ctl, BM_SETCHECK, item->Sel ? BST_CHECKED : BST_UNCHECKED, 0 );
+                EnableWindow( ctl, !disabled );
+            }
+            break;
+        case TVOT_EDITBOX:
+            if ((ctl = GetDlgItem( page->hwnd, id + 2 )))
+            {
+                cpsui_string( cp, item->pSel, text, ARRAY_SIZE(text) );
+                SetWindowTextW( ctl, text );
+                EnableWindow( ctl, !disabled );
+            }
+            if ((ctl = GetDlgItem( page->hwnd, id + 4 )))
+            {
+                cpsui_string( cp, type->pOptParam[0].pData, text, ARRAY_SIZE(text) );
+                SetWindowTextW( ctl, text );
+            }
+            if ((ctl = GetDlgItem( page->hwnd, id + 5 )))
+            {
+                cpsui_string( cp, type->pOptParam[1].pData, text, ARRAY_SIZE(text) );
+                SetWindowTextW( ctl, text );
+            }
+            break;
+        case TVOT_UDARROW:
+        {
+            LONG low, high;
+            item_range( item, &low, &high );
+            if ((ctl = GetDlgItem( page->hwnd, id + 6 )))
+            {
+                SendMessageW( ctl, UDM_SETBUDDY, (WPARAM)GetDlgItem( page->hwnd, id + 2 ), 0 );
+                SendMessageW( ctl, UDM_SETRANGE32, low, high );
+                SendMessageW( ctl, UDM_SETPOS32, 0, item->Sel );
+            }
+            if ((ctl = GetDlgItem( page->hwnd, id + 2 )))
+            {
+                swprintf( text, ARRAY_SIZE(text), L"%ld", item->Sel );
+                SetWindowTextW( ctl, text );
+                EnableWindow( ctl, !disabled );
+            }
+            if ((ctl = GetDlgItem( page->hwnd, id + 4 )))
+            {
+                cpsui_string( cp, type->pOptParam[0].pData, text, ARRAY_SIZE(text) );
+                SetWindowTextW( ctl, text );
+            }
+            break;
+        }
+        case TVOT_TRACKBAR:
+        case TVOT_SCROLLBAR:
+        {
+            LONG low, high;
+            item_range( item, &low, &high );
+            if ((ctl = GetDlgItem( page->hwnd, id + 2 )))
+            {
+                if (type->Type == TVOT_TRACKBAR)
+                {
+                    SendMessageW( ctl, TBM_SETRANGEMIN, FALSE, low );
+                    SendMessageW( ctl, TBM_SETRANGEMAX, FALSE, high );
+                    SendMessageW( ctl, TBM_SETPOS, TRUE, item->Sel );
+                }
+                else
+                {
+                    SetScrollRange( ctl, SB_CTL, low, high, FALSE );
+                    SetScrollPos( ctl, SB_CTL, item->Sel, TRUE );
+                }
+                EnableWindow( ctl, !disabled );
+            }
+            for (j = 0; j < 3; j++)
+            {
+                if (!(ctl = GetDlgItem( page->hwnd, id + 4 + j ))) continue;
+                cpsui_string( cp, type->pOptParam[j == 2 ? 0 : j + 1].pData, text, ARRAY_SIZE(text) );
+                SetWindowTextW( ctl, text );
+            }
+            break;
+        }
+        case TVOT_PUSHBUTTON:
+            if ((ctl = GetDlgItem( page->hwnd, id + 2 ))) EnableWindow( ctl, !disabled );
+            break;
+        }
+        if ((ctl = GetDlgItem( page->hwnd, id + ext_offset( type->Type ) )) && item->pExtChkBox)
+        {
+            if (!(item->Flags & OPTIF_EXT_IS_EXTPUSH))
+                SendMessageW( ctl, BM_SETCHECK, (item->Flags & OPTIF_ECB_CHECKED) ? BST_CHECKED : BST_UNCHECKED, 0 );
+            EnableWindow( ctl, !(item->Flags & OPTIF_EXT_DISABLED) && !disabled );
+        }
+        for (j = 0; j <= ext_offset( type->Type ) + 1; j++)
+            if ((ctl = GetDlgItem( page->hwnd, id + j ))) ShowWindow( ctl, hidden ? SW_HIDE : SW_SHOWNA );
+    }
+    page->updating = FALSE;
+}
+
+static BOOL custom_command( struct cp_page *page, int id, int code, HWND ctl )
+{
+    struct comprop *cp = page->cp;
+    int i;
+
+    if (page->updating) return FALSE;
+    for (i = 0; i < cp->ui->cOptItem; i++)
+    {
+        OPTITEM *item = &cp->ui->pOptItem[i];
+        const OPTTYPE *type = item->pOptType;
+        int off;
+
+        if (!bound_here( page, item )) continue;
+        off = id - type->BegCtrlID;
+        if (off < 0 || off > ext_offset( type->Type ) + 1) continue;
+        if (off == ext_offset( type->Type ))
+        {
+            if (code == BN_CLICKED) ext_clicked( page, i, SendMessageW( ctl, BM_GETCHECK, 0, 0 ) == BST_CHECKED );
+            return TRUE;
+        }
+        switch (type->Type)
+        {
+        case TVOT_2STATES:
+        case TVOT_3STATES:
+            if (code == BN_CLICKED && off >= 2 && !(off & 1)) item_set_sel( page, i, (off - 2) / 2, NULL );
+            return TRUE;
+        case TVOT_COMBOBOX:
+            if (off == 2 && code == CBN_SELCHANGE)
+            {
+                int pos = SendMessageW( ctl, CB_GETCURSEL, 0, 0 );
+                if (pos >= 0) item_set_sel( page, i, SendMessageW( ctl, CB_GETITEMDATA, pos, 0 ), NULL );
+            }
+            return TRUE;
+        case TVOT_LISTBOX:
+            if (off == 2 && code == LBN_SELCHANGE)
+            {
+                int pos = SendMessageW( ctl, LB_GETCURSEL, 0, 0 );
+                if (pos >= 0) item_set_sel( page, i, SendMessageW( ctl, LB_GETITEMDATA, pos, 0 ), NULL );
+            }
+            return TRUE;
+        case TVOT_CHKBOX:
+            if (off == 2 && code == BN_CLICKED)
+                item_set_sel( page, i, SendMessageW( ctl, BM_GETCHECK, 0, 0 ) == BST_CHECKED, NULL );
+            return TRUE;
+        case TVOT_EDITBOX:
+        case TVOT_UDARROW:
+            if (off == 2 && code == EN_CHANGE)
+            {
+                WCHAR text[1024];
+                GetWindowTextW( ctl, text, ARRAY_SIZE(text) );
+                if (type->Type == TVOT_EDITBOX) item_set_sel( page, i, 0, text );
+                else
+                {
+                    LONG low, high, value = wcstol( text, NULL, 10 );
+                    item_range( item, &low, &high );
+                    if (value >= low && value <= high) item_set_sel( page, i, value, NULL );
+                }
+            }
+            return TRUE;
+        case TVOT_PUSHBUTTON:
+            if (off == 2 && code == BN_CLICKED) push_button( page, i );
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL custom_scroll( struct cp_page *page, HWND ctl, WPARAM wparam )
+{
+    struct comprop *cp = page->cp;
+    int i, id = GetDlgCtrlID( ctl );
+
+    if (page->updating) return FALSE;
+    for (i = 0; i < cp->ui->cOptItem; i++)
+    {
+        OPTITEM *item = &cp->ui->pOptItem[i];
+        LONG pos, low, high;
+
+        if (!bound_here( page, item ) || id != item->pOptType->BegCtrlID + 2) continue;
+        if (item->pOptType->Type == TVOT_TRACKBAR) pos = SendMessageW( ctl, TBM_GETPOS, 0, 0 );
+        else if (item->pOptType->Type == TVOT_SCROLLBAR)
+        {
+            pos = GetScrollPos( ctl, SB_CTL );
+            item_range( item, &low, &high );
+            switch (LOWORD(wparam))
+            {
+            case SB_LINELEFT: pos--; break;
+            case SB_LINERIGHT: pos++; break;
+            case SB_PAGELEFT: pos -= max( 1, (high - low) / 10 ); break;
+            case SB_PAGERIGHT: pos += max( 1, (high - low) / 10 ); break;
+            case SB_THUMBTRACK:
+            case SB_THUMBPOSITION: pos = (SHORT)HIWORD(wparam); break;
+            }
+            pos = max( low, min( high, pos ) );
+            SetScrollPos( ctl, SB_CTL, pos, TRUE );
+        }
+        else continue;
+        item_set_sel( page, i, pos, NULL );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void refresh_page( struct cp_page *page )
+{
+    unsigned int i;
+
+    switch (page->kind)
+    {
+    case PAGE_TREE:
+        tree_fill( page );
+        if (page->row_count) row_update( page, &page->rows[0] );
+        break;
+    case PAGE_LAYOUT:
+    case PAGE_PAPER:
+        for (i = 0; i < page->row_count; i++) row_update( page, &page->rows[i] );
+        break;
+    case PAGE_CUSTOM:
+        custom_update( page );
+        break;
+    }
+}
+
+/* OK or Apply: the caller checks and takes the options */
+LONG comprop_apply( struct comprop *cp, HWND hwnd, BOOL ok_cancel )
+{
+    LONG action;
+    int i;
+
+    if (!hwnd)
+    {
+        unsigned int j;
+        for (j = 0; j < cp->page_count && !hwnd; j++) hwnd = cp->pages[j]->hwnd;
+    }
+    action = call_callback( cp, hwnd, CPSUICB_REASON_APPLYNOW, NULL, 0 );
+    if (action == CPSUICB_ACTION_NO_APPLY_EXIT) return 0;
+    for (i = 0; i < cp->ui->cOptItem; i++) cp->ui->pOptItem[i].Flags &= ~OPTIF_CHANGED;
+#ifndef SG_MUTANT_APPLYRESULT
+    set_result( cp->node, CPSUI_OK );
+#endif
+    return 1;
+}
+
+static INT_PTR CALLBACK page_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct cp_page *page = GetPropW( hwnd, L"__wine_cpsui_page" );
+    INT_PTR ret;
+
+    if (msg == WM_INITDIALOG)
+    {
+        PROPSHEETPAGEW *psp = (PROPSHEETPAGEW *)lparam;
+        struct page_extra *extra = (struct page_extra *)((BYTE *)psp + psp->dwSize - sizeof(*extra));
+
+        page = extra->page;
+        SetPropW( hwnd, L"__wine_cpsui_page", page );
+        page->hwnd = hwnd;
+        page->node->hwnd = hwnd;
+        switch (page->kind)
+        {
+        case PAGE_TREE: tree_create( page ); break;
+        case PAGE_LAYOUT:
+        case PAGE_PAPER: std_create( page ); break;
+        case PAGE_CUSTOM: custom_update( page ); break;
+        }
+        if (page->user_proc)
+        {
+            /* the caller's procedure sees the PSPINFO right after the PROPSHEETPAGE */
+            psp->dwSize -= sizeof(*extra);
+            ret = page->user_proc( hwnd, msg, wparam, lparam );
+            psp->dwSize += sizeof(*extra);
+            return ret;
+        }
+        return TRUE;
+    }
+    if (!page) return FALSE;
+    if (page->user_proc && (ret = page->user_proc( hwnd, msg, wparam, lparam ))) return ret;
+
+    switch (msg)
+    {
+    case WM_COMMAND:
+        if (page->kind == PAGE_CUSTOM) return custom_command( page, LOWORD(wparam), HIWORD(wparam), (HWND)lparam );
+        if (row_command( page, LOWORD(wparam), HIWORD(wparam), (HWND)lparam ))
+        {
+            if (page->kind == PAGE_TREE) tree_fill( page );
+            return TRUE;
+        }
+        break;
+    case WM_HSCROLL:
+    case WM_VSCROLL:
+        if (!lparam) break;
+        if (page->kind == PAGE_CUSTOM) return custom_scroll( page, (HWND)lparam, wparam );
+        if (row_scroll( page, (HWND)lparam ))
+        {
+            if (page->kind == PAGE_TREE) tree_fill( page );
+            return TRUE;
+        }
+        break;
+    case WM_NOTIFY:
+    {
+        NMHDR *nm = (NMHDR *)lparam;
+        if (nm->idFrom == ID_TREE && nm->code == TVN_SELCHANGEDW && !page->updating)
+        {
+            NMTREEVIEWW *tv = (NMTREEVIEWW *)lparam;
+            tree_show_item( page, tv->itemNew.lParam );
+            return TRUE;
+        }
+        switch (nm->code)
+        {
+        case PSN_SETACTIVE:
+            after_callback( page->cp, call_callback( page->cp, hwnd, CPSUICB_REASON_SETACTIVE, NULL, 0 ) );
+            SetWindowLongPtrW( hwnd, DWLP_MSGRESULT, 0 );
+            return TRUE;
+        case PSN_KILLACTIVE:
+            call_callback( page->cp, hwnd, CPSUICB_REASON_KILLACTIVE, NULL, 0 );
+            SetWindowLongPtrW( hwnd, DWLP_MSGRESULT, FALSE );
+            return TRUE;
+        case PSN_APPLY:
+        {
+            struct comprop *cp = page->cp;
+            unsigned int i;
+            LONG res = PSNRET_NOERROR;
+
+            /* once for all the pages of the list: on its first page that exists */
+            for (i = 0; i < cp->page_count; i++) if (cp->pages[i]->hwnd) break;
+            if (i < cp->page_count && cp->pages[i] == page && !cp->ignore_apply &&
+                !comprop_apply( cp, hwnd, ((PSHNOTIFY *)lparam)->lParam != 0 ))
+                res = PSNRET_INVALID_NOCHANGEPAGE;
+            SetWindowLongPtrW( hwnd, DWLP_MSGRESULT, res );
+            return TRUE;
+        }
+        }
+        break;
+    }
+    case WM_DESTROY:
+        page->hwnd = NULL;
+        if (page->node) page->node->hwnd = NULL;
+        RemovePropW( hwnd, L"__wine_cpsui_page" );
+        RemovePropW( hwnd, L"__wine_cpsui_user_data" );
+        break;
+    }
+    return FALSE;
+}
+
+/* the empty page CPSUI lays its own pages out on: 252 x 216 dialog units */
+static const DLGTEMPLATE *page_template(void)
+{
+    static WORD buffer[64];
+    DLGTEMPLATE *tmpl = (DLGTEMPLATE *)buffer;
+    WORD *p;
+
+    if (tmpl->cx) return tmpl;
+    tmpl->style = WS_CHILD | DS_CONTROL | DS_SETFONT | DS_3DLOOK;
+    tmpl->cx = 252;
+    tmpl->cy = 216;
+    p = (WORD *)(tmpl + 1);
+    *p++ = 0;   /* menu */
+    *p++ = 0;   /* class */
+    *p++ = 0;   /* title */
+    *p++ = 8;   /* point size */
+    memcpy( p, L"MS Shell Dlg", sizeof(L"MS Shell Dlg") );
+    return tmpl;
+}
+
+static struct cp_page *add_cp_page( struct comprop *cp, enum page_kind kind, unsigned int index, const DLGPAGE *dlg,
+                                    UINT title_id )
+{
+    struct {
+        PROPSHEETPAGEW psp;
+        struct page_extra extra;
+    } data;
+    struct cp_page *page;
+    WCHAR title[MAX_RES_STR_CHARS];
+    HPROPSHEETPAGE hpsp;
+
+    if (cp->page_count >= ARRAY_SIZE(cp->pages) || !(page = calloc( 1, sizeof(*page) ))) return NULL;
+    page->cp = cp;
+    page->kind = kind;
+    page->index = index;
+    page->cur_item = -1;
+    if (dlg) page->user_proc = dlg->DlgProc;
+    if (dlg && dlg->pTabName) cpsui_string( cp, dlg->pTabName, title, ARRAY_SIZE(title) );
+    else if (title_id) cpsui_string( cp, (void *)(ULONG_PTR)title_id, title, ARRAY_SIZE(title) );
+    else if (cp->ui->pOptItemName) cpsui_string( cp, cp->ui->pOptItemName, title, ARRAY_SIZE(title) );
+    else cpsui_string( cp, (void *)IDS_CPSUI_OPTIONS, title, ARRAY_SIZE(title) );
+    page->title = wcsdup( title );
+
+    memset( &data, 0, sizeof(data) );
+    data.psp.dwSize = sizeof(data);
+    data.psp.dwFlags = PSP_USETITLE;
+    data.psp.pszTitle = page->title;
+    data.psp.pfnDlgProc = page_proc;
+    data.psp.lParam = cp->ui->UserData;
+    if (kind == PAGE_CUSTOM && !(dlg->Flags & DPF_USE_HDLGTEMPLATE))
+    {
+        data.psp.hInstance = cp->ui->hInstCaller;
+        data.psp.pszTemplate = MAKEINTRESOURCEW(dlg->DlgTemplateID);
+    }
+    else
+    {
+        data.psp.dwFlags |= PSP_DLGINDIRECT;
+        data.psp.pResource = kind == PAGE_CUSTOM ? dlg->hDlgTemplate : page_template();
+    }
+    data.extra.info.cbSize = sizeof(PSPINFO);
+    data.extra.info.hComPropSheet = cp->node->parent ? cp->node->parent->handle : NULL;
+    data.extra.info.pfnComPropSheet = cps_callback;
+    data.extra.page = page;
+
+    /* the page's node first: its handle is in the PSPINFO */
+    if (!(page->node = node_new( cp->node, NODE_PAGE, NULL )))
+    {
+        free( page->title );
+        free( page );
+        return NULL;
+    }
+    data.extra.info.hCPSUIPage = page->node->handle;
+    page->node->comprop = cp;
+    if (!(hpsp = CreatePropertySheetPageW( &data.psp )))
+    {
+        node_delete( page->node );
+        free( page->title );
+        free( page );
+        return NULL;
+    }
+    page->node->hpsp = hpsp;
+    cp->pages[cp->page_count++] = page;
+    return page;
+}
+
+struct node *comprop_create( struct node *parent, COMPROPSHEETUI *ui, BOOL ansi, struct node *before, LONG *result )
+{
+    struct comprop *cp;
+    struct node *node;
+    unsigned int i;
+
+    *result = ERR_CPSUI_INVALID_PDATA;
+    if (!ui || ui->cbSize < sizeof(*ui)) return NULL;
+    if (ui->cOptItem && !ui->pOptItem)
+    {
+        *result = ERR_CPSUI_NULL_POPTITEM;
+        return NULL;
+    }
+    *result = ERR_CPSUI_ALLOCMEM_FAILED;
+    if (!(cp = calloc( 1, sizeof(*cp) ))) return NULL;
+    if (!(node = node_new( parent, NODE_COMPROP, before )))
+    {
+        free( cp );
+        return NULL;
+    }
+    cp->ui = ui;
+    cp->ansi = ansi;
+    cp->node = node;
+    cp->hide_bits = node->sheet->hide_bits;
+    node->comprop = cp;
+
+    if (ui->pDlgPage == CPSUI_PDLGPAGE_DOCPROP)
+    {
+        add_cp_page( cp, PAGE_LAYOUT, 0, NULL, IDS_CPSUI_STDDOCPROPTAB1 );
+        add_cp_page( cp, PAGE_PAPER, 1, NULL, IDS_CPSUI_STDDOCPROPTAB2 );
+        add_cp_page( cp, PAGE_TREE, 2, NULL, IDS_CPSUI_ADVANCED );
+    }
+    else if (ui->pDlgPage == CPSUI_PDLGPAGE_ADVDOCPROP)
+        add_cp_page( cp, PAGE_TREE, 0, NULL, IDS_CPSUI_ADVANCED );
+    else if (ui->pDlgPage == CPSUI_PDLGPAGE_PRINTERPROP)
+        add_cp_page( cp, PAGE_TREE, 0, NULL, IDS_CPSUI_DEVICE_SETTINGS );
+    else if (ui->pDlgPage == CPSUI_PDLGPAGE_TREEVIEWONLY || !ui->pDlgPage)
+        add_cp_page( cp, PAGE_TREE, 0, NULL, 0 );
+    else
+    {
+        for (i = 0; i < ui->cDlgPage && i < MAX_DLGPAGE_COUNT; i++)
+        {
+            const DLGPAGE *dlg = &ui->pDlgPage[i];
+            enum page_kind kind = PAGE_CUSTOM;
+            UINT title = 0;
+
+            if (!(dlg->Flags & DPF_USE_HDLGTEMPLATE))
+            {
+                if (dlg->DlgTemplateID == DP_STD_TREEVIEWPAGE) kind = PAGE_TREE;
+                else if (dlg->DlgTemplateID == DP_STD_DOCPROPPAGE1) { kind = PAGE_LAYOUT; title = IDS_CPSUI_STDDOCPROPTAB1; }
+                else if (dlg->DlgTemplateID == DP_STD_DOCPROPPAGE2) { kind = PAGE_PAPER; title = IDS_CPSUI_STDDOCPROPTAB2; }
+            }
+            add_cp_page( cp, kind, i, dlg, title );
+        }
+    }
+    if (!cp->page_count)
+    {
+        *result = ERR_CPSUI_NO_PROPSHEETPAGE;
+        node_delete( node );
+        return NULL;
+    }
+    /* now that the list is whole, the pages join a sheet that shows */
+    for (i = 0; i < cp->page_count; i++) show_new_page( cp->pages[i]->node );
+    *result = cp->page_count;
+    TRACE( "%u options, %u pages\n", ui->cOptItem, cp->page_count );
+    return node;
+}
+
+void comprop_free( struct comprop *cp )
+{
+    unsigned int i, j;
+
+    for (i = 0; i < cp->page_count; i++)
+    {
+        for (j = 0; j < MAX_ROWS; j++) cp->pages[i]->rows[j].item = -1;
+        free( cp->pages[i]->title );
+        free( cp->pages[i] );
+    }
+    free( cp );
+}
