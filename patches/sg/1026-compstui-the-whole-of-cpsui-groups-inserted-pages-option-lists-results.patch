+#ifndef __COMPSTUI_PRIVATE_H
+#define __COMPSTUI_PRIVATE_H
+
+#include "wine/list.h"
+
+extern HMODULE compstui_hmod;
+
+/* A property sheet is a tree: the sheet itself, groups (a PFNPROPSHEETUI
+ * function's pages, a group parent, a COMPROPSHEETUI's pages) and pages.
+ * The sheet's pages are the tree's pages in order. */
+enum node_type
+{
+    NODE_SHEET,
+    NODE_GROUP,         /* PSUIPAGEINSERT_GROUP_PARENT */
+    NODE_PFN,           /* a PFNPROPSHEETUI function and what it added */
+    NODE_COMPROP,       /* a COMPROPSHEETUI's pages */
+    NODE_PAGE,
+};
+
+struct comprop;
+
+struct node
+{
+    struct list     entry;          /* in the parent's children */
+    struct list     children;
+    struct node    *parent;
+    struct node    *sheet;          /* the sheet the node belongs to */
+    HANDLE          handle;
+    enum node_type  type;
+
+    /* NODE_PFN */
+    PFNPROPSHEETUI  func;
+    LPARAM          lparam;
+    BOOL            unicode;
+    ULONG_PTR       user_data;
+    ULONG_PTR       result;
+    HMODULE         dll;            /* PSUIPAGEINSERT_DLL */
+    BOOL            inited;
+
+    /* NODE_PAGE */
+    HPROPSHEETPAGE  hpsp;
+    DLGPROC         dlg_proc;
+    HWND            hwnd;           /* once the page exists */
+    WCHAR          *title;          /* CPSFUNC_SET_PSUIPAGE_TITLE before the sheet shows */
+
+    /* NODE_COMPROP (and its pages) */
+    struct comprop *comprop;
+
+    /* NODE_SHEET */
+    HWND            sheet_hwnd;
+    struct list     datablocks;
+    DWORD           hide_bits;      /* CPSFUNC_SET_DMPUB_HIDEBITS */
+    struct node    *start_page;
+    int             start_index;
+};
+
+/* a COMPROPSHEETUI shown as pages */
+struct comprop
+{
+    COMPROPSHEETUI *ui;             /* the caller's, valid while the sheet shows */
+    BOOL            ansi;
+    struct node    *node;
+    DWORD           hide_bits;
+    BOOL            ignore_apply;
+    BOOL            applying;
+    unsigned int    page_count;
+    struct cp_page *pages[MAX_DLGPAGE_COUNT + 3];
+};
+
+extern struct node *node_from_handle( HANDLE handle );
+extern struct node *node_new( struct node *parent, enum node_type type, struct node *before );
+extern unsigned int node_delete( struct node *node );
+extern void show_new_page( struct node *page );
+extern struct node *add_page_node( struct node *parent, HPROPSHEETPAGE hpsp, struct node *before );
+extern LONG set_result( struct node *from, LRESULT result );
+extern LONG_PTR WINAPI cps_callback( HANDLE hcps, UINT func, LPARAM lparam1, LPARAM lparam2 );
+
+/* optitem.c */
+extern struct node *comprop_create( struct node *parent, COMPROPSHEETUI *ui, BOOL ansi, struct node *before,
+                                    LONG *result );
+extern LONG comprop_apply( struct comprop *cp, HWND hwnd, BOOL ok_cancel );
+extern void comprop_free( struct comprop *cp );
+extern void cpsui_string( const struct comprop *cp, const void *str, WCHAR *buf, int size );
+
+#endif /* __COMPSTUI_PRIVATE_H */
