@@ -0,0 +1,1361 @@
+/*
+ * Common Property Sheet User Interface: option item pages (COMPROPSHEETUI)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A COMPROPSHEETUI is a list of options (OPTITEMs, each of a CPSUI option
+ * type) that CPSUI shows and edits itself, on pages it makes -- the
+ * treeview page ("Advanced", "Device Settings") and the Layout and
+ * Paper/Quality pages -- or on the caller's own dialog templates, whose
+ * controls are numbered from each option type's BegCtrlID as the option
+ * types' documentation lays out.  Changes go back into the OPTITEMs and
+ * to the caller's _CPSUICALLBACK; OK and Apply reach it as APPLYNOW, and
+ * the PFNPROPSHEETUI functions above it as SET_RESULT.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winuser.h"
+#include "commctrl.h"
+#include "ddk/compstui.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "compstui_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(compstui);
+
+enum page_kind { PAGE_TREE, PAGE_LAYOUT, PAGE_PAPER, PAGE_CUSTOM };
+
+/* the controls showing one option on a page CPSUI lays out */
+struct row
+{
+    int  item;
+    HWND label, ctl, buddy, units, ext;
+};
+
+#define MAX_ROWS 24
+
+struct cp_page
+{
+    struct comprop *cp;
+    enum page_kind  kind;
+    unsigned int    index;          /* the DlgPageIdx it shows (custom pages) */
+    DLGPROC         user_proc;
+    WCHAR          *title;
+    HWND            hwnd;
+    HWND            tree;
+    HWND            group;
+    struct row      rows[MAX_ROWS];
+    unsigned int    row_count;
+    int             cur_item;       /* the tree's selected option */
+    BOOL            updating;
+    struct node    *node;
+};
+
+/* what follows the PROPSHEETPAGE a page is made from */
+struct page_extra
+{
+    PSPINFO         info;
+    struct cp_page *page;
+};
+
+#define ID_TREE     100
+#define ID_GROUP    101
+#define ID_ROW      1000        /* row r: ID_ROW + r * 8 + part */
+#define ROW_LABEL   0
+#define ROW_CTL     1
+#define ROW_BUDDY   2
+#define ROW_UNITS   3
+#define ROW_EXT     4
+
+static OPTITEM *item_at( const struct comprop *cp, int i )
+{
+    if (i < 0 || i >= cp->ui->cOptItem) return NULL;
+    return &cp->ui->pOptItem[i];
+}
+
+void cpsui_string( const struct comprop *cp, const void *str, WCHAR *buf, int size )
+{
+    buf[0] = 0;
+    if (!str) return;
+    if (IS_INTRESOURCE(str))
+    {
+        UINT id = LOWORD(str);
+        HINSTANCE inst = cp ? cp->ui->hInstCaller : NULL;
+        if (id >= IDS_CPSUI_STRID_FIRST && id <= IDS_CPSUI_STRID_LAST) inst = compstui_hmod;
+        if (!LoadStringW( inst, id, buf, size ) && inst != compstui_hmod) LoadStringW( compstui_hmod, id, buf, size );
+        return;
+    }
+    if (cp && cp->ansi) MultiByteToWideChar( CP_ACP, 0, str, -1, buf, size );
+    else lstrcpynW( buf, str, size );
+}
+
+static BOOL item_hidden( const struct comprop *cp, const OPTITEM *item )
+{
+    if (item->Flags & OPTIF_HIDE) return TRUE;
+    if (item->DMPubID >= DMPUB_FIRST && item->DMPubID <= 32 && IS_DMPUB_HIDDEN( cp->hide_bits, item->DMPubID ))
+        return TRUE;
+    return FALSE;
+}
+
+static BOOL item_disabled( const struct comprop *cp, const OPTITEM *item )
+{
+    if (item->Flags & OPTIF_DISABLED) return TRUE;
+    if (item->pOptType && (item->pOptType->Flags & OPTTF_TYPE_DISABLED)) return TRUE;
+    if (!(cp->ui->Flags & CPSUIF_UPDATE_PERMISSION))
+        return !(item->pOptType && item->pOptType->Type == TVOT_PUSHBUTTON &&
+                 (item->pOptType->Style & OTS_PUSH_ENABLE_ALWAYS));
+    return FALSE;
+}
+
+/* range of a TVOT_UDARROW, TVOT_TRACKBAR or TVOT_SCROLLBAR */
+static void item_range( const OPTITEM *item, LONG *low, LONG *high )
+{
+    const OPTPARAM *p = item->pOptType->pOptParam;
+    *low = (SHORT)p[1].IconID;
+    *high = (SHORT)p[1].lParam;
+    if (*high < *low) { LONG t = *low; *low = *high; *high = t; }
+}
+
+/* the value of an option, as text */
+static void item_value_text( const struct comprop *cp, const OPTITEM *item, WCHAR *buf, int size )
+{
+    const OPTTYPE *type = item->pOptType;
+    WCHAR units[MAX_RES_STR_CHARS];
+    UINT id;
+
+    buf[0] = 0;
+    if (!type || !type->pOptParam) return;
+    switch (type->Type)
+    {
+    case TVOT_2STATES:
+    case TVOT_3STATES:
+    case TVOT_LISTBOX:
+    case TVOT_COMBOBOX:
+    case TVOT_NSTATES_EX:
+        if (item->Sel < 0 || item->Sel >= type->Count) cpsui_string( cp, (void *)IDS_CPSUI_NONE, buf, size );
+        else cpsui_string( cp, type->pOptParam[item->Sel].pData, buf, size );
+        break;
+    case TVOT_UDARROW:
+    case TVOT_TRACKBAR:
+    case TVOT_SCROLLBAR:
+    {
+        LONG mult = type->Type == TVOT_UDARROW ? 1 : (LONG)type->pOptParam[2].IconID;
+        cpsui_string( cp, type->pOptParam[0].pData, units, ARRAY_SIZE(units) );
+        swprintf( buf, size, (type->Flags & OPTTF_NOSPACE_BEFORE_POSTFIX) ? L"%ld%s" : L"%ld %s",
+                  item->Sel * (mult ? mult : 1), units );
+        break;
+    }
+    case TVOT_EDITBOX:
+        cpsui_string( cp, item->pSel, buf, size );
+        break;
+    case TVOT_CHKBOX:
+        switch (type->Style)
+        {
+        case CHKBOXS_NO_YES: id = item->Sel ? IDS_CPSUI_YES : IDS_CPSUI_NO; break;
+        case CHKBOXS_OFF_ON: id = item->Sel ? IDS_CPSUI_ON : IDS_CPSUI_OFF; break;
+        case CHKBOXS_FALSE_PDATA: id = item->Sel ? 0 : IDS_CPSUI_FALSE; break;
+        case CHKBOXS_NO_PDATA: id = item->Sel ? 0 : IDS_CPSUI_NO; break;
+        case CHKBOXS_OFF_PDATA: id = item->Sel ? 0 : IDS_CPSUI_OFF; break;
+        case CHKBOXS_NONE_PDATA: id = item->Sel ? 0 : IDS_CPSUI_NONE; break;
+        default: id = item->Sel ? IDS_CPSUI_TRUE : IDS_CPSUI_FALSE; break;
+        }
+        if (id) cpsui_string( cp, (void *)(ULONG_PTR)id, buf, size );
+        else cpsui_string( cp, type->pOptParam[0].pData, buf, size );
+        break;
+    case TVOT_PUSHBUTTON:
+        break;
+    }
+}
+
+static LONG call_callback( struct comprop *cp, HWND hwnd, WORD reason, OPTITEM *cur, LONG old_sel )
+{
+    CPSUICBPARAM param;
+    LONG ret;
+
+    if (!cp->ui->pfnCallBack) return CPSUICB_ACTION_NONE;
+    memset( &param, 0, sizeof(param) );
+    param.cbSize = sizeof(param);
+    param.Reason = reason;
+    param.hDlg = hwnd;
+    param.pOptItem = cp->ui->pOptItem;
+    param.cOptItem = cp->ui->cOptItem;
+    param.Flags = cp->ui->Flags;
+    param.pCurItem = cur ? cur : cp->ui->pOptItem;
+    param.OldSel = old_sel;
+    param.UserData = cp->ui->UserData;
+    ret = cp->ui->pfnCallBack( &param );
+    TRACE( "reason %u item %d -> %ld\n", reason, cur ? (int)(cur - cp->ui->pOptItem) : -1, ret );
+    return ret;
+}
+
+static void refresh_page( struct cp_page *page );
+
+static void refresh_all( struct comprop *cp )
+{
+    unsigned int i;
+    for (i = 0; i < cp->page_count; i++) if (cp->pages[i]->hwnd) refresh_page( cp->pages[i] );
+}
+
+static void after_callback( struct comprop *cp, LONG action )
+{
+    if (action == CPSUICB_ACTION_OPTIF_CHANGED || action == CPSUICB_ACTION_REINIT_ITEMS) refresh_all( cp );
+}
+
+/* the user chose a value */
+static void item_set_sel( struct cp_page *page, int index, LONG sel, const WCHAR *text )
+{
+    struct comprop *cp = page->cp;
+    OPTITEM *item = item_at( cp, index );
+    LONG old = 0;
+    LONG action = CPSUICB_ACTION_NONE;
+
+    if (!item || !item->pOptType) return;
+    if (item->pOptType->Type == TVOT_EDITBOX)
+    {
+        DWORD size = item->pOptType->pOptParam[1].IconID;
+        if (!item->pSel || IS_INTRESOURCE(item->pSel) || !size) return;
+        if (cp->ansi) WideCharToMultiByte( CP_ACP, 0, text, -1, (char *)item->pSel, size, NULL, NULL );
+        else lstrcpynW( item->pSel, text, size / sizeof(WCHAR) ? size / sizeof(WCHAR) : size );
+    }
+    else
+    {
+        if (item->Sel == sel) return;
+        old = item->Sel;
+        item->Sel = sel;
+    }
+    item->Flags |= OPTIF_CHANGED;
+    if (page->hwnd) SendMessageW( GetParent( page->hwnd ), PSM_CHANGED, (WPARAM)page->hwnd, 0 );
+#ifndef SG_MUTANT_CPSUICALLBACK
+    if (item->Flags & OPTIF_CALLBACK)
+        action = call_callback( cp, page->hwnd, CPSUICB_REASON_SEL_CHANGED, item, old );
+#endif
+    TRACE( "item %d sel %ld\n", index, item->Sel );
+    if (action == CPSUICB_ACTION_NONE) refresh_all( cp );
+    else after_callback( cp, action );
+}
+
+static void push_button( struct cp_page *page, int index )
+{
+    struct comprop *cp = page->cp;
+    OPTITEM *item = item_at( cp, index );
+    OPTPARAM *param;
+    CPSUICBPARAM cb;
+
+    if (!item || !item->pOptType || !(param = item->pOptType->pOptParam)) return;
+    memset( &cb, 0, sizeof(cb) );
+    cb.cbSize = sizeof(cb);
+    cb.hDlg = page->hwnd;
+    cb.pOptItem = cp->ui->pOptItem;
+    cb.cOptItem = cp->ui->cOptItem;
+    cb.Flags = cp->ui->Flags;
+    cb.pCurItem = item;
+    cb.OldSel = item->Sel;
+    cb.UserData = cp->ui->UserData;
+    switch (param->Style)
+    {
+    case PUSHBUTTON_TYPE_CALLBACK:
+        cb.Reason = CPSUICB_REASON_PUSHBUTTON;
+        if (param->pData) after_callback( cp, ((_CPSUICALLBACK)param->pData)( &cb ) );
+        else after_callback( cp, call_callback( cp, page->hwnd, CPSUICB_REASON_PUSHBUTTON, item, item->Sel ) );
+        break;
+    case PUSHBUTTON_TYPE_DLGPROC:
+        cb.Reason = CPSUICB_REASON_DLGPROC;
+        if (param->Flags & OPTPF_USE_HDLGTEMPLATE)
+            item->Sel = DialogBoxIndirectParamW( cp->ui->hInstCaller, (DLGTEMPLATE *)param->lParam, page->hwnd,
+                                                 (DLGPROC)param->pData, (LPARAM)&cb );
+        else
+            item->Sel = DialogBoxParamW( cp->ui->hInstCaller, MAKEINTRESOURCEW(param->lParam), page->hwnd,
+                                         (DLGPROC)param->pData, (LPARAM)&cb );
+        refresh_all( cp );
+        break;
+    default:
+        FIXME( "halftone push button %u\n", param->Style );
+        break;
+    }
+}
+
+/* the extended check box or push button of an option */
+static void ext_clicked( struct cp_page *page, int index, BOOL checked )
+{
+    struct comprop *cp = page->cp;
+    OPTITEM *item = item_at( cp, index );
+    LONG action = CPSUICB_ACTION_NONE;
+
+    if (!item || !item->pExtChkBox) return;
+    if (item->Flags & OPTIF_EXT_IS_EXTPUSH)
+    {
+        EXTPUSH *push = item->pExtPush;
+        if (push->Flags & EPF_PUSH_TYPE_DLGPROC)
+        {
+            CPSUICBPARAM cb;
+            memset( &cb, 0, sizeof(cb) );
+            cb.cbSize = sizeof(cb);
+            cb.Reason = CPSUICB_REASON_DLGPROC;
+            cb.hDlg = page->hwnd;
+            cb.pOptItem = cp->ui->pOptItem;
+            cb.cOptItem = cp->ui->cOptItem;
+            cb.pCurItem = item;
+            cb.UserData = cp->ui->UserData;
+            if (push->Flags & EPF_USE_HDLGTEMPLATE)
+                DialogBoxIndirectParamW( cp->ui->hInstCaller, push->hDlgTemplate, page->hwnd, push->DlgProc,
+                                         (LPARAM)&cb );
+            else
+                DialogBoxParamW( cp->ui->hInstCaller, MAKEINTRESOURCEW(push->DlgTemplateID), page->hwnd,
+                                 push->DlgProc, (LPARAM)&cb );
+        }
+        else action = call_callback( cp, page->hwnd, CPSUICB_REASON_EXTPUSH, item, item->Sel );
+    }
+    else
+    {
+        if (checked) item->Flags |= OPTIF_ECB_CHECKED;
+        else item->Flags &= ~OPTIF_ECB_CHECKED;
+        item->Flags |= OPTIF_CHANGED;
+        if (item->Flags & OPTIF_CALLBACK)
+            action = call_callback( cp, page->hwnd, CPSUICB_REASON_ECB_CHANGED, item, item->Sel );
+    }
+    after_callback( cp, action );
+    if (action == CPSUICB_ACTION_NONE) refresh_all( cp );
+}
+
+/* ---- the controls of a row ---- */
+
+static HWND make_control( struct cp_page *page, const WCHAR *cls, const WCHAR *text, DWORD style, int id )
+{
+    HWND hwnd = CreateWindowExW( 0, cls, text, WS_CHILD | style, 0, 0, 10, 10, page->hwnd,
+                                 (HMENU)(INT_PTR)id, NULL, NULL );
+    SendMessageW( hwnd, WM_SETFONT, SendMessageW( page->hwnd, WM_GETFONT, 0, 0 ), FALSE );
+    return hwnd;
+}
+
+static void row_destroy( struct row *row )
+{
+    if (row->label) DestroyWindow( row->label );
+    if (row->ctl) DestroyWindow( row->ctl );
+    if (row->buddy) DestroyWindow( row->buddy );
+    if (row->units) DestroyWindow( row->units );
+    if (row->ext) DestroyWindow( row->ext );
+    memset( row, 0, sizeof(*row) );
+    row->item = -1;
+}
+
+/* fills a list control with an option's parameters; each entry's data is
+ * its parameter index (-1 for "None") */
+static void fill_list( struct comprop *cp, const OPTITEM *item, HWND ctl, BOOL listbox )
+{
+    const OPTTYPE *type = item->pOptType;
+    UINT add = listbox ? LB_ADDSTRING : CB_ADDSTRING, setdata = listbox ? LB_SETITEMDATA : CB_SETITEMDATA;
+    UINT setsel = listbox ? LB_SETCURSEL : CB_SETCURSEL;
+    WCHAR text[MAX_RES_STR_CHARS];
+    int i, pos, sel = -1;
+
+    SendMessageW( ctl, listbox ? LB_RESETCONTENT : CB_RESETCONTENT, 0, 0 );
+    if (type->Style & OTS_LBCB_INCL_ITEM_NONE)
+    {
+        cpsui_string( cp, (void *)IDS_CPSUI_NONE, text, ARRAY_SIZE(text) );
+        pos = SendMessageW( ctl, add, 0, (LPARAM)text );
+        SendMessageW( ctl, setdata, pos, -1 );
+        if (item->Sel < 0) sel = pos;
+    }
+    for (i = 0; i < type->Count; i++)
+    {
+        if (type->pOptParam[i].Flags & OPTPF_HIDE) continue;
+        cpsui_string( cp, type->pOptParam[i].pData, text, ARRAY_SIZE(text) );
+        pos = SendMessageW( ctl, add, 0, (LPARAM)text );
+        SendMessageW( ctl, setdata, pos, i );
+        if (i == item->Sel) sel = pos;
+    }
+    if (sel >= 0) SendMessageW( ctl, setsel, sel, 0 );
+}
+
+static void row_update( struct cp_page *page, struct row *row )
+{
+    struct comprop *cp = page->cp;
+    OPTITEM *item = item_at( cp, row->item );
+    const OPTTYPE *type;
+    WCHAR text[MAX_RES_STR_CHARS];
+    BOOL disabled, hidden;
+
+    if (!item) return;
+    page->updating = TRUE;
+    type = item->pOptType;
+    disabled = item_disabled( cp, item );
+    hidden = item_hidden( cp, item );
+    if (row->ctl && type)
+    {
+        switch (type->Type)
+        {
+        case TVOT_2STATES:
+        case TVOT_3STATES:
+        case TVOT_LISTBOX:
+        case TVOT_COMBOBOX:
+        case TVOT_NSTATES_EX:
+            fill_list( cp, item, row->ctl, FALSE );
+            break;
+        case TVOT_CHKBOX:
+            SendMessageW( row->ctl, BM_SETCHECK, item->Sel ? BST_CHECKED : BST_UNCHECKED, 0 );
+            break;
+        case TVOT_UDARROW:
+        {
+            LONG low, high;
+            item_range( item, &low, &high );
+            SendMessageW( row->buddy, UDM_SETRANGE32, low, high );
+            SendMessageW( row->buddy, UDM_SETPOS32, 0, item->Sel );
+            swprintf( text, ARRAY_SIZE(text), L"%ld", item->Sel );
+            SetWindowTextW( row->ctl, text );
+            break;
+        }
+        case TVOT_TRACKBAR:
+        case TVOT_SCROLLBAR:
+        {
+            LONG low, high;
+            item_range( item, &low, &high );
+            SendMessageW( row->ctl, TBM_SETRANGEMIN, FALSE, low );
+            SendMessageW( row->ctl, TBM_SETRANGEMAX, FALSE, high );
+            SendMessageW( row->ctl, TBM_SETPOS, TRUE, item->Sel );
+            item_value_text( cp, item, text, ARRAY_SIZE(text) );
+            SetWindowTextW( row->units, text );
+            break;
+        }
+        case TVOT_EDITBOX:
+            cpsui_string( cp, item->pSel, text, ARRAY_SIZE(text) );
+            SetWindowTextW( row->ctl, text );
+            break;
+        }
+        EnableWindow( row->ctl, !disabled );
+        if (row->buddy) EnableWindow( row->buddy, !disabled );
+    }
+    if (row->ext)
+    {
+        if (!(item->Flags & OPTIF_EXT_IS_EXTPUSH))
+            SendMessageW( row->ext, BM_SETCHECK, (item->Flags & OPTIF_ECB_CHECKED) ? BST_CHECKED : BST_UNCHECKED, 0 );
+        EnableWindow( row->ext, !(item->Flags & OPTIF_EXT_DISABLED) && !disabled );
+        ShowWindow( row->ext, (item->Flags & OPTIF_EXT_HIDE) || hidden ? SW_HIDE : SW_SHOWNA );
+    }
+    if (row->label) ShowWindow( row->label, hidden ? SW_HIDE : SW_SHOWNA );
+    if (row->ctl) ShowWindow( row->ctl, hidden ? SW_HIDE : SW_SHOWNA );
+    if (row->buddy) ShowWindow( row->buddy, hidden ? SW_HIDE : SW_SHOWNA );
+    if (row->units) ShowWindow( row->units, hidden ? SW_HIDE : SW_SHOWNA );
+    page->updating = FALSE;
+}
+
+/* the controls for an option, laid out in a rectangle; returns their height */
+static int row_create( struct cp_page *page, unsigned int slot, int index, const RECT *rect )
+{
+    struct comprop *cp = page->cp;
+    struct row *row = &page->rows[slot];
+    OPTITEM *item = item_at( cp, index );
+    const OPTTYPE *type;
+    WCHAR name[MAX_RES_STR_CHARS], text[MAX_RES_STR_CHARS + 8];
+    int id = ID_ROW + slot * 8, x = rect->left, w = rect->right - rect->left, label_w = w * 2 / 5;
+    int h = 0, line;
+    RECT du = { 0, 0, 4, 14 };
+
+    MapDialogRect( page->hwnd, &du );
+    line = du.bottom;
+    row_destroy( row );
+    if (!item) return 0;
+    row->item = index;
+    type = item->pOptType;
+    cpsui_string( cp, item->pName, name, ARRAY_SIZE(name) );
+
+    if (!type)
+    {
+        row->label = make_control( page, WC_STATICW, name, SS_LEFT, id + ROW_LABEL );
+        MoveWindow( row->label, x, rect->top + 2, w, line - 4, FALSE );
+        row_update( page, row );
+        return line;
+    }
+    if (type->Type != TVOT_CHKBOX && type->Type != TVOT_PUSHBUTTON)
+    {
+        swprintf( text, ARRAY_SIZE(text), L"%s:", name );
+        row->label = make_control( page, WC_STATICW, text, SS_LEFT | SS_CENTERIMAGE, id + ROW_LABEL );
+        MoveWindow( row->label, x, rect->top, label_w - 4, line, FALSE );
+    }
+    else label_w = 0;
+
+    switch (type->Type)
+    {
+    case TVOT_2STATES:
+    case TVOT_3STATES:
+    case TVOT_LISTBOX:
+    case TVOT_COMBOBOX:
+    case TVOT_NSTATES_EX:
+        row->ctl = make_control( page, WC_COMBOBOXW, NULL, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, id + ROW_CTL );
+        MoveWindow( row->ctl, x + label_w, rect->top, w - label_w, line * 8, FALSE );
+        h = line;
+        break;
+    case TVOT_CHKBOX:
+        cpsui_string( cp, type->pOptParam ? type->pOptParam[0].pData : NULL, text, ARRAY_SIZE(text) );
+        row->ctl = make_control( page, WC_BUTTONW, (type->Style >= CHKBOXS_FALSE_PDATA && text[0]) ? text : name,
+                                 BS_AUTOCHECKBOX | WS_TABSTOP, id + ROW_CTL );
+        MoveWindow( row->ctl, x, rect->top, w, line, FALSE );
+        h = line;
+        break;
+    case TVOT_UDARROW:
+        row->ctl = make_control( page, WC_EDITW, NULL, WS_BORDER | ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP,
+                                 id + ROW_CTL );
+        MoveWindow( row->ctl, x + label_w, rect->top, (w - label_w) / 3, line, FALSE );
+        row->buddy = make_control( page, UPDOWN_CLASSW, NULL, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_NOTHOUSANDS,
+                                   id + ROW_BUDDY );
+        SendMessageW( row->buddy, UDM_SETBUDDY, (WPARAM)row->ctl, 0 );
+        cpsui_string( cp, type->pOptParam[0].pData, text, ARRAY_SIZE(text) );
+        row->units = make_control( page, WC_STATICW, text, SS_LEFT | SS_CENTERIMAGE, id + ROW_UNITS );
+        MoveWindow( row->units, x + label_w + (w - label_w) / 3 + 6, rect->top, (w - label_w) / 2, line, FALSE );
+        h = line;
+        break;
+    case TVOT_TRACKBAR:
+    case TVOT_SCROLLBAR:
+        row->ctl = make_control( page, TRACKBAR_CLASSW, NULL, TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, id + ROW_CTL );
+        MoveWindow( row->ctl, x + label_w, rect->top, (w - label_w) * 2 / 3, line, FALSE );
+        row->units = make_control( page, WC_STATICW, NULL, SS_LEFT | SS_CENTERIMAGE, id + ROW_UNITS );
+        MoveWindow( row->units, x + label_w + (w - label_w) * 2 / 3 + 4, rect->top, (w - label_w) / 3 - 4, line, FALSE );
+        h = line;
+        break;
+    case TVOT_EDITBOX:
+        row->ctl = make_control( page, WC_EDITW, NULL, WS_BORDER | ES_AUTOHSCROLL | WS_TABSTOP, id + ROW_CTL );
+        MoveWindow( row->ctl, x + label_w, rect->top, w - label_w, line, FALSE );
+        if (type->pOptParam[1].IconID)
+            SendMessageW( row->ctl, EM_LIMITTEXT, max( 1, type->pOptParam[1].IconID / (cp->ansi ? 1 : 2) ) - 1, 0 );
+        h = line;
+        break;
+    case TVOT_PUSHBUTTON:
+    {
+        WCHAR setup[64] = L"";
+        if (type->Style & OTS_PUSH_INCL_SETUP_TITLE)
+            cpsui_string( cp, (void *)IDS_CPSUI_SETUP, setup, ARRAY_SIZE(setup) );
+        swprintf( text, ARRAY_SIZE(text), L"%s%s%s%s", name, setup[0] ? L" " : L"", setup,
+                  (type->Style & OTS_PUSH_NO_DOT_DOT_DOT) ? L"" : L"..." );
+        row->ctl = make_control( page, WC_BUTTONW, text, BS_PUSHBUTTON | WS_TABSTOP, id + ROW_CTL );
+        MoveWindow( row->ctl, x, rect->top, min( w, max( w / 2, 120 ) ), line + 2, FALSE );
+        h = line + 2;
+        break;
+    }
+    default:
+        h = line;
+        break;
+    }
+    if (item->pExtChkBox && !(item->Flags & OPTIF_EXT_HIDE))
+    {
+        if (item->Flags & OPTIF_EXT_IS_EXTPUSH)
+        {
+            cpsui_string( cp, item->pExtPush->pTitle, name, ARRAY_SIZE(name) );
+            row->ext = make_control( page, WC_BUTTONW, name, BS_PUSHBUTTON | WS_TABSTOP, id + ROW_EXT );
+        }
+        else
+        {
+            cpsui_string( cp, item->pExtChkBox->pTitle, name, ARRAY_SIZE(name) );
+            row->ext = make_control( page, WC_BUTTONW, name, BS_AUTOCHECKBOX | WS_TABSTOP, id + ROW_EXT );
+        }
+        MoveWindow( row->ext, x + label_w, rect->top + h + 2, w - label_w, line, FALSE );
+        h += line + 2;
+    }
+    row_update( page, row );
+    return h;
+}
+
+/* a message from a row's control */
+static BOOL row_command( struct cp_page *page, int id, int code, HWND ctl )
+{
+    struct row *row;
+    OPTITEM *item;
+    unsigned int slot;
+    int part;
+
+    if (id < ID_ROW || page->updating) return FALSE;
+    slot = (id - ID_ROW) / 8;
+    part = (id - ID_ROW) % 8;
+    if (slot >= MAX_ROWS) return FALSE;
+    row = &page->rows[slot];
+    if (!(item = item_at( page->cp, row->item )) || !item->pOptType) return FALSE;
+
+    if (part == ROW_EXT)
+    {
+        if (code == BN_CLICKED) ext_clicked( page, row->item, SendMessageW( ctl, BM_GETCHECK, 0, 0 ) == BST_CHECKED );
+        return TRUE;
+    }
+    if (part != ROW_CTL) return FALSE;
+    switch (item->pOptType->Type)
+    {
+    case TVOT_2STATES:
+    case TVOT_3STATES:
+    case TVOT_LISTBOX:
+    case TVOT_COMBOBOX:
+    case TVOT_NSTATES_EX:
+        if (code == CBN_SELCHANGE)
+        {
+            int pos = SendMessageW( ctl, CB_GETCURSEL, 0, 0 );
+            if (pos >= 0) item_set_sel( page, row->item, SendMessageW( ctl, CB_GETITEMDATA, pos, 0 ), NULL );
+        }
+        return TRUE;
+    case TVOT_CHKBOX:
+        if (code == BN_CLICKED)
+            item_set_sel( page, row->item, SendMessageW( ctl, BM_GETCHECK, 0, 0 ) == BST_CHECKED, NULL );
+        return TRUE;
+    case TVOT_UDARROW:
+        if (code == EN_CHANGE)
+        {
+            WCHAR text[32];
+            LONG low, high, value;
+            GetWindowTextW( ctl, text, ARRAY_SIZE(text) );
+            value = wcstol( text, NULL, 10 );
+            item_range( item, &low, &high );
+            if (value >= low && value <= high) item_set_sel( page, row->item, value, NULL );
+        }
+        return TRUE;
+    case TVOT_EDITBOX:
+        if (code == EN_CHANGE)
+        {
+            WCHAR text[1024];
+            GetWindowTextW( ctl, text, ARRAY_SIZE(text) );
+            item_set_sel( page, row->item, 0, text );
+        }
+        return TRUE;
+    case TVOT_PUSHBUTTON:
+        if (code == BN_CLICKED) push_button( page, row->item );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL row_scroll( struct cp_page *page, HWND ctl )
+{
+    unsigned int i;
+
+    if (page->updating) return FALSE;
+    for (i = 0; i < page->row_count; i++)
+    {
+        if (page->rows[i].ctl != ctl) continue;
+        item_set_sel( page, page->rows[i].item, SendMessageW( ctl, TBM_GETPOS, 0, 0 ), NULL );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* ---- the treeview page ---- */
+
+static void tree_item_text( struct comprop *cp, const OPTITEM *item, WCHAR *buf, int size )
+{
+    WCHAR name[MAX_RES_STR_CHARS], value[MAX_RES_STR_CHARS];
+
+    cpsui_string( cp, item->pName, name, ARRAY_SIZE(name) );
+    item_value_text( cp, item, value, ARRAY_SIZE(value) );
+    if (item->pOptType && item->pOptType->Type != TVOT_PUSHBUTTON && value[0])
+        swprintf( buf, size, L"%s: %s", name, value );
+    else lstrcpynW( buf, name, size );
+}
+
+static void tree_show_item( struct cp_page *page, int index )
+{
+    RECT rect, du = { 7, 0, 7, 12 };
+    WCHAR name[MAX_RES_STR_CHARS];
+    OPTITEM *item = item_at( page->cp, index );
+
+    page->cur_item = index;
+    GetWindowRect( page->group, &rect );
+    MapWindowPoints( NULL, page->hwnd, (POINT *)&rect, 2 );
+    MapDialogRect( page->hwnd, &du );
+    if (item) cpsui_string( page->cp, item->pName, name, ARRAY_SIZE(name) );
+    else name[0] = 0;
+    SetWindowTextW( page->group, name );
+    rect.left += du.left;
+    rect.right -= du.right;
+    rect.top += du.bottom + 2;
+    row_create( page, 0, item && item->pOptType ? index : -1, &rect );
+    page->row_count = 1;
+    if (item && (item->Flags & OPTIF_CALLBACK))
+        call_callback( page->cp, page->hwnd, CPSUICB_REASON_OPTITEM_SETFOCUS, item, item->Sel );
+}
+
+static void tree_fill( struct cp_page *page )
+{
+    struct comprop *cp = page->cp;
+    HTREEITEM parents[256], root, last = TVI_ROOT, select = NULL, node;
+    WCHAR text[MAX_RES_STR_CHARS * 2];
+    TVINSERTSTRUCTW ins;
+    int i;
+
+    page->updating = TRUE;
+    SendMessageW( page->tree, WM_SETREDRAW, FALSE, 0 );
+    SendMessageW( page->tree, TVM_DELETEITEM, 0, (LPARAM)TVI_ROOT );
+    memset( &ins, 0, sizeof(ins) );
+    ins.hParent = TVI_ROOT;
+    ins.hInsertAfter = TVI_LAST;
+    ins.item.mask = TVIF_TEXT | TVIF_PARAM | TVIF_STATE;
+    ins.item.stateMask = TVIS_EXPANDED;
+    ins.item.state = TVIS_EXPANDED;
+    if (cp->ui->pOptItemName) cpsui_string( cp, cp->ui->pOptItemName, text, ARRAY_SIZE(text) );
+    else cpsui_string( cp, cp->ui->pCallerName, text, ARRAY_SIZE(text) );
+    if (!text[0]) cpsui_string( cp, (void *)IDS_CPSUI_OPTIONS, text, ARRAY_SIZE(text) );
+    ins.item.pszText = text;
+    ins.item.lParam = -1;
+    root = (HTREEITEM)SendMessageW( page->tree, TVM_INSERTITEMW, 0, (LPARAM)&ins );
+    parents[0] = root;
+    for (i = 0; i < cp->ui->cOptItem; i++)
+    {
+        OPTITEM *item = &cp->ui->pOptItem[i];
+        BYTE level = min( item->Level, ARRAY_SIZE(parents) - 2 );
+
+        if (item_hidden( cp, item )) continue;
+        ins.hParent = parents[level] ? parents[level] : root;
+        tree_item_text( cp, item, text, ARRAY_SIZE(text) );
+        ins.item.pszText = text;
+        ins.item.lParam = i;
+        ins.item.state = (item->Flags & OPTIF_COLLAPSE) ? 0 : TVIS_EXPANDED;
+        node = (HTREEITEM)SendMessageW( page->tree, TVM_INSERTITEMW, 0, (LPARAM)&ins );
+        parents[level + 1] = node;
+        memset( parents + level + 2, 0, sizeof(parents) - (level + 2) * sizeof(parents[0]) );
+        if (i == page->cur_item || (!select && page->cur_item < 0 && (item->Flags & OPTIF_INITIAL_TVITEM)))
+            select = node;
+        last = node;
+    }
+    (void)last;
+    SendMessageW( page->tree, TVM_SELECTITEM, TVGN_CARET, (LPARAM)(select ? select : root) );
+    SendMessageW( page->tree, WM_SETREDRAW, TRUE, 0 );
+    page->updating = FALSE;
+}
+
+static void tree_create( struct cp_page *page )
+{
+    RECT client, du = { 7, 7, 7, 52 };
+
+    GetClientRect( page->hwnd, &client );
+    MapDialogRect( page->hwnd, &du );
+    page->tree = CreateWindowExW( WS_EX_CLIENTEDGE, WC_TREEVIEWW, NULL,
+                                  WS_CHILD | WS_VISIBLE | WS_TABSTOP | TVS_HASBUTTONS | TVS_HASLINES |
+                                  TVS_LINESATROOT | TVS_SHOWSELALWAYS,
+                                  du.left, du.top, client.right - du.left - du.right,
+                                  client.bottom - du.top - du.bottom - du.top, page->hwnd,
+                                  (HMENU)ID_TREE, NULL, NULL );
+    SendMessageW( page->tree, WM_SETFONT, SendMessageW( page->hwnd, WM_GETFONT, 0, 0 ), FALSE );
+    page->group = CreateWindowExW( 0, WC_BUTTONW, NULL, WS_CHILD | WS_VISIBLE | BS_GROUPBOX,
+                                   du.left, client.bottom - du.bottom - du.top / 2, client.right - du.left - du.right,
+                                   du.bottom, page->hwnd, (HMENU)ID_GROUP, NULL, NULL );
+    SendMessageW( page->group, WM_SETFONT, SendMessageW( page->hwnd, WM_GETFONT, 0, 0 ), FALSE );
+    page->cur_item = -1;
+    tree_fill( page );
+}
