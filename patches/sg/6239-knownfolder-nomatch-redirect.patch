From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: known folder lookups fail when nothing matches; per-user known folders are redirectable

IKnownFolderManager::FindFolderFromPath and FindFolderFromIDList returned S_FALSE when no known folder is at the path, a success code, so a program checking for success took every folder for a known folder: OneDrive's folder backup refused Documents and Desktop as containing "other important folders" because each had subfolders. They now fail (E_FAIL) as documented. IKnownFolder::GetRedirectionCapabilities said every folder could not be redirected, so OneDrive refused to back up any of them ("redirection blocked"). Per-user folders, which SHSetKnownFolderPath moves, are now redirectable unless the DisablePersonalDirChange policy is set (then denied by policy); common folders are redirectable when the caller may change the machine's folder settings and denied for lack of permission otherwise; virtual folders stay non-redirectable and fixed ones report nothing.
---
diff --git a/dlls/shell32/shellpath.c b/dlls/shell32/shellpath.c
index a96db59..7d6cfc5 100644
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -4219,6 +4219,27 @@ static HRESULT WINAPI knownfolder_GetFolderType(
     FreeKnownFolderDefinitionFields(&kfd);
     return S_OK;
 }
+static BOOL policy_denies_personal_dir_change(void)
+{
+    static const WCHAR key[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer";
+    DWORD value = 0, size = sizeof(value);
+
+    if (!RegGetValueW( HKEY_CURRENT_USER, key, L"DisablePersonalDirChange", RRF_RT_REG_DWORD, NULL, &value, &size ) && value)
+        return TRUE;
+    size = sizeof(value);
+    return !RegGetValueW( HKEY_LOCAL_MACHINE, key, L"DisablePersonalDirChange", RRF_RT_REG_DWORD, NULL, &value, &size ) && value;
+}
+
+static BOOL can_write_common_folders(void)
+{
+    HKEY key;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders",
+                       0, KEY_SET_VALUE, &key )) return FALSE;
+    RegCloseKey( key );
+    return TRUE;
+}
+
 static HRESULT WINAPI knownfolder_GetRedirectionCapabilities(
     IKnownFolder *iface,
     KF_REDIRECTION_CAPABILITIES *pCapabilities)
@@ -4232,9 +4253,28 @@ static HRESULT WINAPI knownfolder_GetRedirectionCapabilities(
 #ifdef SG_MUTANT_KF_REDIRCAPS
     return S_OK;
 #endif
-    /* a fixed folder (the Windows directory) cannot be redirected: no capability and no denial are set */
-    if(SUCCEEDED(knownfolder_GetCategory(iface, &category)) && category == KF_CATEGORY_FIXED)
+    if(FAILED(knownfolder_GetCategory(iface, &category))) return S_OK;
+    switch (category)
+    {
+    case KF_CATEGORY_FIXED:
+        /* a fixed folder (the Windows directory) cannot be redirected: no capability and no denial are set */
         *pCapabilities = 0;
+        break;
+#ifndef SG_MUTANT_KF_REDIRCAPS_DENY
+    case KF_CATEGORY_PERUSER:
+        /* SHSetKnownFolderPath moves these (wine-sg 6236), unless policy forbids it */
+        *pCapabilities = policy_denies_personal_dir_change() ? KF_REDIRECTION_CAPABILITIES_DENY_POLICY
+                                                             : KF_REDIRECTION_CAPABILITIES_ALLOW_ALL;
+        break;
+    case KF_CATEGORY_COMMON:
+        /* machine-wide: the caller must be able to change HKLM's User Shell Folders */
+        *pCapabilities = can_write_common_folders() ? KF_REDIRECTION_CAPABILITIES_ALLOW_ALL
+                                                    : KF_REDIRECTION_CAPABILITIES_DENY_PERMISSIONS;
+        break;
+#endif
+    default: /* virtual folders have no path to move */
+        break;
+    }
     return S_OK;
 }
 
@@ -4654,7 +4694,11 @@ static HRESULT WINAPI foldermanager_FindFolderFromPath(
 #ifdef SG_MUTANT_KFM_NOMATCH
     if (best_len < 0) return S_OK;
 #endif
+    /* no known folder there: a failure, as documented (S_FALSE read as a match to SUCCEEDED callers) */
+#ifdef SG_MUTANT_KFM_NOMATCH_SFALSE
     if (best_len < 0) return S_FALSE;
+#endif
+    if (best_len < 0) return E_FAIL;
     return IKnownFolderManager_GetFolder(iface, &fm->ids[best_i], ppkf);
 }
 static HRESULT WINAPI foldermanager_FindFolderFromIDList(
@@ -4688,7 +4732,7 @@ static HRESULT WINAPI foldermanager_FindFolderFromIDList(
     if (SHGetPathFromIDListW(pidl, path))
         return foldermanager_FindFolderFromPath(iface, path, FFFP_EXACTMATCH, ppkf);
 
-    return S_FALSE;
+    return E_FAIL;
 }
 static HRESULT WINAPI foldermanager_Redirect(
     IKnownFolderManager *iface,
