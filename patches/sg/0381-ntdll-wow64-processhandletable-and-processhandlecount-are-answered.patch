From: Stained Glass OS <dev@stained-glass.example>
Subject: ntdll, wow64: ProcessHandleTable and ProcessHandleCount are answered

NtQueryInformationProcess(ProcessHandleTable) returned nothing (and in a
32-bit process WoW64 rejected the class, STATUS_INVALID_INFO_CLASS);
ProcessHandleCount said 0. Chromium's sandbox, in every renderer, counts
the process's handles with GetProcessHandleCount and lists them with
ProcessHandleTable to close the ones it must not keep; when that fails the
process exits with SBOX_FATAL_CLOSEHANDLES (7010). Spotify is 32-bit: each
renderer died that way, and Spotify's browser process, having logged the
renderer's termination status, crashes on purpose (a store of 0x4711
through a null pointer: the access violation at start).

Both classes are now answered from the server's list of every process's
handles (get_system_handles, as SystemHandleInformation is), filtered by
the process's id: the table as ULONG handle values, the count as their
number; a too-small table buffer gets STATUS_INFO_LENGTH_MISMATCH with the
size needed. WoW64 passes ProcessHandleTable through (an array of ULONGs is
the same in both).

Gate: test/commapps-gate.sh.
---
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1117,6 +1117,52 @@
 
 #endif
 
+/* The handles a process holds, from the server's list of every process's
+ * handles. Stores their number in "count", and up to "max" of their values
+ * in "handles" (which may be NULL). */
+static NTSTATUS get_process_handle_list( HANDLE process, ULONG *handles, ULONG max, ULONG *count )
+{
+    struct handle_info *info = NULL;
+    unsigned int alloc = 1024, total = 0, i;
+    process_id_t pid = 0;
+    NTSTATUS status;
+
+    SERVER_START_REQ( get_process_info )
+    {
+        req->handle = wine_server_obj_handle( process );
+        if (!(status = wine_server_call( req ))) pid = reply->pid;
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+
+    for (;;)
+    {
+        if (!(info = malloc( alloc * sizeof(*info) ))) return STATUS_NO_MEMORY;
+        SERVER_START_REQ( get_system_handles )
+        {
+            wine_server_set_reply( req, info, alloc * sizeof(*info) );
+            status = wine_server_call( req );
+            total = status ? reply->count : wine_server_reply_size( reply ) / sizeof(*info);
+        }
+        SERVER_END_REQ;
+        if (status != STATUS_BUFFER_TOO_SMALL) break;
+        free( info );
+        alloc = total + 256;
+    }
+    if (!status)
+    {
+        *count = 0;
+        for (i = 0; i < total; i++)
+        {
+            if (info[i].owner != pid) continue;
+            if (handles && *count < max) handles[*count] = info[i].handle;
+            (*count)++;
+        }
+    }
+    free( info );
+    return status;
+}
