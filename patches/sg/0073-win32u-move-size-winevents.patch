From: Stained Glass OS <dev@stained-glass.example>
Subject: win32u: EVENT_SYSTEM_MOVESIZESTART and EVENT_SYSTEM_MOVESIZEEND

Windows sends these WinEvents when a window's move/size loop starts (after
WM_ENTERSIZEMOVE) and when it has ended and the window is placed;
accessibility tools, window managers and the shell's snapping use them.
Wine sent neither.
---
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -765,6 +765,7 @@
     NtUserRedrawWindow( hwnd, NULL, 0, RDW_UPDATENOW | RDW_ALLCHILDREN );
 
     send_message( hwnd, WM_ENTERSIZEMOVE, 0, 0 );
+    NtUserNotifyWinEvent( EVENT_SYSTEM_MOVESIZESTART, hwnd, OBJID_WINDOW, CHILDID_SELF );
     set_capture_window( hwnd, GUI_INMOVESIZE, NULL );
 
     for (;;)
@@ -916,6 +917,8 @@
         }
     }
 
+    NtUserNotifyWinEvent( EVENT_SYSTEM_MOVESIZEEND, hwnd, OBJID_WINDOW, CHILDID_SELF );
+
     if (is_iconic(hwnd) && !moved && (style & WS_SYSMENU))
     {
         /* Single click brings up the system menu when iconized */
