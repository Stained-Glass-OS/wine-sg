From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32, crypt32: Schannel checks the server's certificate, as Windows' does

Issue #16 brought curl.exe (Schannel) to System32, and it took any server
certificate: Wine's Schannel never checked one. Windows' Schannel checks
the server's certificate itself when the handshake is done unless the
caller does (ISC_REQ_MANUAL_CRED_VALIDATION,
SCH_CRED_MANUAL_CRED_VALIDATION; wininet and winhttp ask for that and keep
their own checks): the chain to a trusted root and the server's name with
the SSL policy, its revocation when the credentials ask
(SCH_CRED_REVOCATION_CHECK_*, SCH_CRED_IGNORE_NO_REVOCATION_CHECK /
IGNORE_REVOCATION_OFFLINE), SCH_CRED_NO_SERVERNAME_CHECK. Errors as
Windows': SEC_E_UNTRUSTED_ROOT, SEC_E_WRONG_PRINCIPAL, SEC_E_CERT_EXPIRED,
CRYPT_E_NO_REVOCATION_CHECK, ... In crypt32's SSL policy, as on Windows: a
chain that stops short of any root (the server's own certificate and no
issuer known here) fails with CERT_E_CHAINING -- it passed -- and a server
named by its address matches an iPAddress subject alternative name. Gate:
test/curltar-gate.sh. Mutants: SG_MUTANT_SCHANNEL_NO_VERIFY,
SG_MUTANT_SSL_PARTIAL_OK, SG_MUTANT_NO_IP_SAN.
---
--- a/dlls/secur32/schannel.c
+++ b/dlls/secur32/schannel.c
@@ -66,6 +66,9 @@
     enum control_token control_token;
     unsigned int alert_type;
     unsigned int alert_number;
+    DWORD sg_cred_flags;  /* Stained Glass OS: the credentials' dwFlags */
+    WCHAR *sg_target;     /* the server's name the caller gave (pszTargetName) */
+    BOOL sg_verified;     /* the server's certificate was checked */
 };
 
 static struct schan_handle *schan_handle_table;
@@ -484,6 +487,22 @@
     return status;
 }
 
+/* Stained Glass OS: the credentials' dwFlags (SCHANNEL_CRED and SCH_CREDENTIALS alike) */
+static DWORD get_cred_flags(const void *credentials)
+{
+    const SCH_CREDENTIALS *cred = credentials;
+
+    switch (cred->dwVersion)
+    {
+    case SCH_CRED_V3:
+    case SCHANNEL_CRED_VERSION:
+        return ((const SCHANNEL_CRED *)credentials)->dwFlags;
+    case SCH_CREDENTIALS_VERSION:
+        return cred->dwFlags;
+    }
+    return 0;
+}
+
 static DWORD get_enabled_protocols(const void *credentials)
 {
     const SCHANNEL_CRED *cred_old;
@@ -689,6 +708,7 @@
     if (!(creds = malloc(sizeof(*creds)))) return SEC_E_INSUFFICIENT_MEMORY;
     creds->credential_use = fCredentialUse;
     creds->enabled_protocols = enabled_protocols;
+    creds->sg_cred_flags = schanCred ? get_cred_flags(schanCred) : 0;
 
     if (cert && !(key_blob = get_key_blob(cert, &key_size))) goto fail;
     params.c = creds;
@@ -840,6 +860,54 @@
     return TRUE;
 }
 
+static SECURITY_STATUS ensure_remote_cert(struct schan_context *ctx);
+
+/* Stained Glass OS: Schannel's automatic validation of a server's certificate (see establish_context) */
+static SECURITY_STATUS verify_server_certificate(struct schan_context *ctx)
+{
+    CERT_CHAIN_PARA chain_para = { sizeof(chain_para) };
+    SSL_EXTRA_CERT_CHAIN_POLICY_PARA ssl = { { sizeof(ssl) } };
+    CERT_CHAIN_POLICY_PARA policy = { sizeof(policy) };
+    CERT_CHAIN_POLICY_STATUS status = { sizeof(status) };
+    const CERT_CHAIN_CONTEXT *chain;
+    DWORD flags = 0, err;
+    SECURITY_STATUS ret;
+
+#ifdef SG_MUTANT_SCHANNEL_NO_VERIFY
+    return SEC_E_OK;
+#endif
+    if ((ret = ensure_remote_cert(ctx)) != SEC_E_OK) return ret;
+    if (ctx->sg_cred_flags & SCH_CRED_REVOCATION_CHECK_CHAIN_END_CERT) flags |= CERT_CHAIN_REVOCATION_CHECK_END_CERT;
+    if (ctx->sg_cred_flags & SCH_CRED_REVOCATION_CHECK_CHAIN) flags |= CERT_CHAIN_REVOCATION_CHECK_CHAIN;
+    if (ctx->sg_cred_flags & SCH_CRED_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT)
+        flags |= CERT_CHAIN_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT;
+    if (!CertGetCertificateChain(NULL, ctx->cert, NULL, ctx->cert->hCertStore, &chain_para, flags, NULL, &chain))
+        return SEC_E_CERT_UNKNOWN;
+
+    ssl.dwAuthType = AUTHTYPE_SERVER;
+    ssl.pwszServerName = (ctx->sg_cred_flags & SCH_CRED_NO_SERVERNAME_CHECK) ? NULL : ctx->sg_target;
+    policy.pvExtraPolicyPara = &ssl;
+    if (ctx->sg_cred_flags & (SCH_CRED_IGNORE_NO_REVOCATION_CHECK | SCH_CRED_IGNORE_REVOCATION_OFFLINE))
+        policy.dwFlags |= CERT_CHAIN_POLICY_IGNORE_END_REV_UNKNOWN_FLAG | CERT_CHAIN_POLICY_IGNORE_CTL_SIGNER_REV_UNKNOWN_FLAG |
+                          CERT_CHAIN_POLICY_IGNORE_CA_REV_UNKNOWN_FLAG | CERT_CHAIN_POLICY_IGNORE_ROOT_REV_UNKNOWN_FLAG;
+    if (!CertVerifyCertificateChainPolicy(CERT_CHAIN_POLICY_SSL, chain, &policy, &status))
+        status.dwError = GetLastError() ? GetLastError() : (DWORD)SEC_E_CERT_UNKNOWN;
+    CertFreeCertificateChain(chain);
+
+    err = status.dwError;
+    TRACE("server %s: %#lx\n", debugstr_w(ctx->sg_target), err);
+    switch (err)
+    {
+    case ERROR_SUCCESS: return SEC_E_OK;
+    case CERT_E_UNTRUSTEDROOT:
+    case CERT_E_CHAINING:
+    case TRUST_E_CERT_SIGNATURE: return SEC_E_UNTRUSTED_ROOT;
+    case CERT_E_CN_NO_MATCH: return SEC_E_WRONG_PRINCIPAL;
+    case CERT_E_EXPIRED: return SEC_E_CERT_EXPIRED;
+    default: return err;  /* CRYPT_E_REVOKED, CRYPT_E_NO_REVOCATION_CHECK, CRYPT_E_REVOCATION_OFFLINE, ... */
+    }
+}
+
 static SECURITY_STATUS establish_context(
  PCredHandle phCredential, PCtxtHandle phContext, SEC_WCHAR *pszTargetName,
  PSecBufferDesc pInput, ULONG fContextReq, ULONG TargetDataRep,
@@ -911,6 +979,9 @@
             return SEC_E_INTERNAL_ERROR;
         }
 
+        ctx->sg_cred_flags = cred->sg_cred_flags;
+        if (pszTargetName && *pszTargetName) ctx->sg_target = wcsdup(pszTargetName);
+
         if (cred->enabled_protocols & SP_PROT_DTLS1_X)
             ctx->header_size = HEADER_SIZE_DTLS;
         else
@@ -1080,6 +1151,18 @@
         if (buffer->BufferType == SECBUFFER_ALERT) buffer->cbBuffer = 0;
     }
 
+    /* Stained Glass OS: as Windows' Schannel, a client checks the server's certificate itself once
+     * the handshake is done -- its chain to a trusted root, its name, and its revocation when the
+     * credentials ask -- unless the caller validates it (ISC_REQ_MANUAL_CRED_VALIDATION,
+     * SCH_CRED_MANUAL_CRED_VALIDATION). Wine's did not check at all: curl.exe (Schannel) took any
+     * certificate, a man in the middle's too. */
+    if (!bIsServer && ret == SEC_E_OK && !ctx->sg_verified)
+    {
+        ctx->sg_verified = TRUE;
+        if (!(fContextReq & ISC_REQ_MANUAL_CRED_VALIDATION) && !(ctx->sg_cred_flags & SCH_CRED_MANUAL_CRED_VALIDATION))
+            ret = verify_server_certificate(ctx);
+    }
+
     if (bIsServer)
     {
         *pfContextAttr = ASC_RET_REPLAY_DETECT | ASC_RET_SEQUENCE_DETECT | ASC_RET_CONFIDENTIALITY | ASC_RET_STREAM;
@@ -1681,6 +1764,7 @@
     if (ctx->cert) CertFreeCertificateContext(ctx->cert);
     params.session = ctx->session;
     GNUTLS_CALL( dispose_session, &params );
+    free(ctx->sg_target);
     free(ctx);
     return SEC_E_OK;
 }
@@ -1859,6 +1943,7 @@
             struct schan_context *ctx = schan_free_handle(i, SCHAN_HANDLE_CTX);
             struct session_params params = { ctx->session };
             GNUTLS_CALL( dispose_session, &params );
+            free(ctx->sg_target);
             free(ctx);
         }
     }
--- a/dlls/secur32/secur32_priv.h
+++ b/dlls/secur32/secur32_priv.h
@@ -88,6 +88,7 @@
     ULONG credential_use;
     DWORD enabled_protocols;
     UINT64 credentials;
+    DWORD sg_cred_flags;  /* Stained Glass OS: SCHANNEL_CRED/SCH_CREDENTIALS dwFlags (validation, revocation) */
 } schan_credentials;
 
 struct session_params
--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -28,6 +28,9 @@
 #include "wincrypt.h"
 #include "ncrypt.h"
 #include "wininet.h"
+#include "inaddr.h"
+#include "in6addr.h"
+#include "ip2string.h"
 #include "wine/debug.h"
 #include "crypt32_private.h"
 
@@ -3468,6 +3471,24 @@
                  subjectName->rgAltEntry[i].pwszDNSName))
                     matches = TRUE;
             }
+#ifndef SG_MUTANT_NO_IP_SAN
+            /* Stained Glass OS: a server named by its address (https://127.0.0.1/) matches an
+             * iPAddress entry, as on Windows: curl.exe with Schannel (wine-sg 9410) refused it */
+            else if (subjectName->rgAltEntry[i].dwAltNameChoice == CERT_ALT_NAME_IP_ADDRESS)
+            {
+                const CRYPT_DATA_BLOB *ip = &subjectName->rgAltEntry[i].IPAddress;
+                const WCHAR *end;
+                IN_ADDR v4;
+                IN6_ADDR v6;
+
+                if (ip->cbData == sizeof(v4) && !RtlIpv4StringToAddressW(server_name, TRUE, &end, &v4) &&
+                    !*end && !memcmp(ip->pbData, &v4, sizeof(v4)))
+                    matches = TRUE;
+                else if (ip->cbData == sizeof(v6) && !RtlIpv6StringToAddressW(server_name, &end, &v6) &&
+                         !*end && !memcmp(ip->pbData, &v6, sizeof(v6)))
+                    matches = TRUE;
+            }
+#endif
         }
         LocalFree(subjectName);
     }
@@ -3776,6 +3797,22 @@
          CERT_TRUST_IS_NOT_SIGNATURE_VALID, &pPolicyStatus->lChainIndex,
          &pPolicyStatus->lElementIndex);
     }
+#ifndef SG_MUTANT_SSL_PARTIAL_OK
+    /* Stained Glass OS: a chain that stops short of any root (the server sent
+     * its own certificate and no issuer here knows it) is no more trusted than
+     * an unknown root, as on Windows: the SSL policy passed it, and Schannel's
+     * check of a server (wine-sg 9410) took a stranger's certificate */
+    else if (pChainContext->TrustStatus.dwErrorStatus &
+     CERT_TRUST_IS_PARTIAL_CHAIN &&
+     !(checks & SECURITY_FLAG_IGNORE_UNKNOWN_CA) &&
+     !(baseChecks & CERT_CHAIN_POLICY_ALLOW_UNKNOWN_CA_FLAG))
+    {
+        pPolicyStatus->dwError = CERT_E_CHAINING;
+        find_element_with_error(pChainContext,
+         CERT_TRUST_IS_PARTIAL_CHAIN, &pPolicyStatus->lChainIndex,
+         &pPolicyStatus->lElementIndex);
+    }
+#endif
     else if (pChainContext->TrustStatus.dwErrorStatus &
      CERT_TRUST_IS_UNTRUSTED_ROOT &&
      !(checks & SECURITY_FLAG_IGNORE_UNKNOWN_CA) &&
