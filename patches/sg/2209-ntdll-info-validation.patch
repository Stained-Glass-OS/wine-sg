From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll, wow64: status codes for VM counters, remote reads, SetSystemInformation, processor relations, thread alignment fixup, NtOpenThread

Several ntdll calls answered with the wrong status where Wine's own
conformance tests (todo_wine, written against Windows) say what Windows
does.  ProcessVmCounters reports the base structure size for a length
mismatch (wow64 too), reading unreadable memory of another process is
STATUS_PARTIAL_COPY (a handle without PROCESS_VM_READ stays access
denied), NtSetSystemInformation checks the time-adjustment length,
processor-die/NUMA-ex/module relations are STATUS_UNSUCCESSFUL,
ThreadEnableAlignmentFaultFixup checks its handle, and NtOpenThread
checks the process id of the client id (STATUS_INVALID_CID).  The
matching todo_wine marks in ntdll's info.c test are removed.

---
--- a/dlls/ntdll/tests/info.c
+++ b/dlls/ntdll/tests/info.c
@@ -1119,10 +1119,8 @@ static void test_time_adjustment(void)
     status = pNtSetSystemInformation( SystemTimeAdjustmentInformation, &adjust, sizeof(adjust) );
     ok( status == STATUS_SUCCESS || status == STATUS_PRIVILEGE_NOT_HELD, "got %08lx\n", status );
     status = pNtSetSystemInformation( SystemTimeAdjustmentInformation, &adjust, sizeof(adjust)-1 );
-    todo_wine
     ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %08lx\n", status );
     status = pNtSetSystemInformation( SystemTimeAdjustmentInformation, &adjust, sizeof(adjust)+1 );
-    todo_wine
     ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %08lx\n", status );
 }
 
@@ -1282,19 +1280,19 @@ static void test_query_logicalprocex(void)
 
     relationship = RelationProcessorDie;
     status = pNtQuerySystemInformationEx(SystemLogicalProcessorInformationEx, &relationship, sizeof(relationship), NULL, 0, &len_die);
-    todo_wine ok(status == STATUS_INFO_LENGTH_MISMATCH || status == STATUS_UNSUCCESSFUL || broken(status == STATUS_SUCCESS),
+    ok(status == STATUS_INFO_LENGTH_MISMATCH || status == STATUS_UNSUCCESSFUL || broken(status == STATUS_SUCCESS),
        "got 0x%08lx\n", status);
 
     len_numa_ex = 0;
     relationship = RelationNumaNodeEx;
     status = pNtQuerySystemInformationEx(SystemLogicalProcessorInformationEx, &relationship, sizeof(relationship), NULL, 0, &len_numa_ex);
-    todo_wine ok(status == STATUS_INFO_LENGTH_MISMATCH || status == STATUS_UNSUCCESSFUL || broken(status == STATUS_SUCCESS),
+    ok(status == STATUS_INFO_LENGTH_MISMATCH || status == STATUS_UNSUCCESSFUL || broken(status == STATUS_SUCCESS),
        "got 0x%08lx\n", status);
 
     len_module = 0;
     relationship = RelationProcessorModule;
     status = pNtQuerySystemInformationEx(SystemLogicalProcessorInformationEx, &relationship, sizeof(relationship), NULL, 0, &len_module);
-    todo_wine ok(status == STATUS_INFO_LENGTH_MISMATCH || status == STATUS_UNSUCCESSFUL || broken(status == STATUS_SUCCESS),
+    ok(status == STATUS_INFO_LENGTH_MISMATCH || status == STATUS_UNSUCCESSFUL || broken(status == STATUS_SUCCESS),
        "got 0x%08lx\n", status);
 
     len_public = 0;
@@ -1889,7 +1887,7 @@ static void test_query_process_vm(void)
 
     status = NtQueryInformationProcess( GetCurrentProcess(), ProcessVmCounters, &pvi, 46, &ReturnLength);
     ok( status == STATUS_INFO_LENGTH_MISMATCH, "Expected STATUS_INFO_LENGTH_MISMATCH, got %08lx\n", status);
-    todo_wine ok( ReturnLength == sizeof(VM_COUNTERS), "wrong size %ld\n", ReturnLength);
+    ok( ReturnLength == sizeof(VM_COUNTERS), "wrong size %ld\n", ReturnLength);
 
     /* Check if we have some return values */
     if (winetest_debug > 1)
@@ -2758,12 +2756,10 @@ static void test_readvirtualmemory(void)
     ok( strcmp(teststring, buffer) == 0, "Expected read memory to be the same as original memory\n");
 
     /* illegal remote address */
-    todo_wine{
     status = pNtReadVirtualMemory(process, (void *) 0x1234, buffer, 12, &readcount);
     ok( status == STATUS_PARTIAL_COPY, "Expected STATUS_PARTIAL_COPY, got %08lx\n", status);
     if (status == STATUS_PARTIAL_COPY)
         ok( readcount == 0, "Expected to read 0 bytes, got %Id\n",readcount);
-    }
 
     /* 0 handle */
     status = pNtReadVirtualMemory(0, teststring, buffer, 12, &readcount);
@@ -3377,9 +3373,9 @@ static void test_ThreadEnableAlignmentFaultFixup(void)
     status = pNtSetInformationThread( (HANDLE)0xdeadbeef, ThreadEnableAlignmentFaultFixup, NULL, 1 );
     ok( status == STATUS_ACCESS_VIOLATION, "Expected STATUS_ACCESS_VIOLATION, got %08lx\n", status );
     status = pNtSetInformationThread( (HANDLE)0xdeadbeef, ThreadEnableAlignmentFaultFixup, &dummy, 1 );
-    todo_wine ok( status == STATUS_INVALID_HANDLE, "Expected STATUS_INVALID_HANDLE, got %08lx\n", status );
+    ok( status == STATUS_INVALID_HANDLE, "Expected STATUS_INVALID_HANDLE, got %08lx\n", status );
     status = pNtSetInformationThread( GetCurrentProcess(), ThreadEnableAlignmentFaultFixup, &dummy, 1 );
-    todo_wine ok( status == STATUS_OBJECT_TYPE_MISMATCH, "Expected STATUS_OBJECT_TYPE_MISMATCH, got %08lx\n", status );
+    ok( status == STATUS_OBJECT_TYPE_MISMATCH, "Expected STATUS_OBJECT_TYPE_MISMATCH, got %08lx\n", status );
     dummy = 1;
     status = pNtSetInformationThread( GetCurrentThread(), ThreadEnableAlignmentFaultFixup, &dummy, 1 );
     ok( status == STATUS_SUCCESS, "Expected STATUS_SUCCESS, got %08lx\n", status );
@@ -3526,9 +3522,7 @@ static void test_thread_lookup(void)
     cid.UniqueThread = ULongToHandle(GetCurrentThreadId());
     handle = (HANDLE)0xdeadbeef;
     status = NtOpenThread(&handle, THREAD_QUERY_INFORMATION, &attr, &cid);
-    todo_wine
     ok(status == STATUS_INVALID_CID, "NtOpenThread returned %#lx\n", status);
-    todo_wine
     ok( !handle || broken(handle == (HANDLE)0xdeadbeef) /* vista */, "handle set %p\n", handle );
     if (!status) pNtClose(handle);
 
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -1690,8 +1690,9 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
                     }
                     if (size >= sizeof(VM_COUNTERS_EX))
                         pvmi.PrivateUsage = pvmi.PagefileUsage;
-                    len = size;
-                    if (len != sizeof(VM_COUNTERS)) len = sizeof(VM_COUNTERS_EX);
+                    /* an odd size between the two structures reports the smaller one */
+                    len = size < sizeof(VM_COUNTERS_EX) ? sizeof(VM_COUNTERS) : sizeof(VM_COUNTERS_EX);
+                    if (size == sizeof(VM_COUNTERS_EX)) len = size;
                     memcpy(info, &pvmi, min(size, sizeof(pvmi)));
                 }
                 if (size != sizeof(VM_COUNTERS) && size != sizeof(VM_COUNTERS_EX))
@@ -1699,7 +1700,7 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
             }
             else
             {
-                len = sizeof(pvmi);
+                len = sizeof(VM_COUNTERS);
                 ret = STATUS_INFO_LENGTH_MISMATCH;
             }
         }
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4014,6 +4014,14 @@ NTSTATUS WINAPI NtQuerySystemInformationEx( SYSTEM_INFORMATION_CLASS class,
         }
 
         relation = *(DWORD *)query;
+#ifndef SG_MUTANT_NO_UNKNOWN_RELATION
+        /* die, NUMA node (extended) and module relations are not reported here */
+        if (relation >= RelationProcessorDie && relation != RelationAll)
+        {
+            ret = STATUS_UNSUCCESSFUL;
+            break;
+        }
+#endif
         len = 0;
         p = logical_proc_info_ex;
         while ((char *)p != (char *)logical_proc_info_ex + logical_proc_info_ex_size)
@@ -4118,6 +4126,16 @@ NTSTATUS WINAPI NtQuerySystemInformationEx( SYSTEM_INFORMATION_CLASS class,
  */
 NTSTATUS WINAPI NtSetSystemInformation( SYSTEM_INFORMATION_CLASS class, void *info, ULONG length )
 {
+    switch (class)
+    {
+    case SystemTimeAdjustmentInformation:
+#ifndef SG_MUTANT_NO_SETSYS_LENGTH
+        if (length != sizeof(SYSTEM_TIME_ADJUSTMENT)) return STATUS_INFO_LENGTH_MISMATCH;
+#endif
+        break;
+    default:
+        break;
+    }
     FIXME( "(0x%08x,%p,0x%08x) stub\n", class, info, (int)length );
     return STATUS_SUCCESS;
 }
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1610,6 +1610,36 @@ NTSTATUS WINAPI NtOpenThread( HANDLE *handle, ACCESS_MASK access,
 
     *handle = 0;
 
+    /* the thread must belong to the process the client id names */
+#ifndef SG_MUTANT_NO_CID_CHECK
+    if (id->UniqueProcess)
+    {
+        HANDLE probe = 0;
+        ULONG pid = 0;
+
+        SERVER_START_REQ( open_thread )
+        {
+            req->tid        = HandleToULong(id->UniqueThread);
+            req->access     = THREAD_QUERY_LIMITED_INFORMATION;
+            req->attributes = 0;
+            if (!(ret = wine_server_call( req ))) probe = wine_server_ptr_handle( reply->handle );
+        }
+        SERVER_END_REQ;
+        if (!ret)
+        {
+            SERVER_START_REQ( get_thread_info )
+            {
+                req->handle = wine_server_obj_handle( probe );
+                req->access = THREAD_QUERY_LIMITED_INFORMATION;
+                if (!(ret = wine_server_call( req ))) pid = reply->pid;
+            }
+            SERVER_END_REQ;
+            NtClose( probe );
+            if (!ret && pid != HandleToULong(id->UniqueProcess)) return STATUS_INVALID_CID;
+        }
+    }
+#endif
+
     SERVER_START_REQ( open_thread )
     {
         req->tid        = HandleToULong(id->UniqueThread);
@@ -2663,6 +2693,14 @@ NTSTATUS WINAPI NtSetInformationThread( HANDLE handle, THREADINFOCLASS class,
          * either way, and the setting is taken as Windows takes it */
         if (length != sizeof(BOOLEAN)) return STATUS_INFO_LENGTH_MISMATCH;
         if (!data) return STATUS_ACCESS_VIOLATION;
+        {
+            struct ntdll_thread_data *thread_data;
+
+            /* the handle must still be a thread handle that may be set */
+#ifndef SG_MUTANT_NO_ALIGN_HANDLE_CHECK
+            if ((status = get_thread_settings( handle, TRUE, &thread_data ))) return status;
+#endif
+        }
         return STATUS_SUCCESS;
 
 #ifndef SG_MUTANT_NO_THREAD_SETTINGS
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -6166,6 +6166,11 @@ NTSTATUS WINAPI NtReadVirtualMemory( HANDLE process, const void *addr, void *buf
             if ((status = wine_server_call( req ))) size = 0;
         }
         SERVER_END_REQ;
+        /* memory that cannot be read in the other process is a partial copy;
+         * a handle without PROCESS_VM_READ stays STATUS_ACCESS_DENIED */
+#ifndef SG_MUTANT_NO_PARTIAL_COPY
+        if (status == STATUS_ACCESS_VIOLATION) status = STATUS_PARTIAL_COPY;
+#endif
     }
     if (bytes_read) *bytes_read = size;
     return status;
--- a/dlls/wow64/process.c
+++ b/dlls/wow64/process.c
@@ -672,7 +672,11 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
             }
             return status;
         }
+#ifdef SG_MUTANT_VM_LEN
         if (retlen) *retlen = sizeof(VM_COUNTERS_EX32);
+#else
+        if (retlen) *retlen = sizeof(VM_COUNTERS32);  /* the base structure, as the native side reports */
+#endif
         return STATUS_INFO_LENGTH_MISMATCH;
 
     case ProcessDebugPort:  /* ULONG_PTR */
