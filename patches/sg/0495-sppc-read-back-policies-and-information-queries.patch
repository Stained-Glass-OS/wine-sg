From: Stained Glass OS <dev@stained-glass.example>
Subject: sppc: reading the store back, policies and information queries

Word (Office 365), once installed, aborted on SLLoadApplicationPolicies,
one of sppc's stubs; Office queries the licensing client with several.

- What the store (0491) holds reads back: SLGetLicenseFileId (the
  identifier of a license installed, SL_E_LICENSE_FILE_NOT_INSTALLED
  otherwise), SLGetLicense (its content, LocalAlloc'ed), SLGetPKeyId.
- Application policies load (SLLoadApplicationPolicies,
  SLUnloadApplicationPolicies) and hold none: SLGetApplicationPolicy answers
  SL_E_VALUE_NOT_FOUND, as do SLGetPolicyInformation[DWORD] and the product
  SKU, application, service, license and product-key information queries;
  SLGetInstalledProductKeyIds finds none.
- SLConsumeRight grants nothing (SL_E_RIGHT_NOT_GRANTED).

The store still grants no right and activates nothing; Office's own
licensing (its account sign-in) decides.

Gate: test/sppc-gate.sh.
---
--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -161,6 +161,158 @@
     return SL_E_VALUE_NOT_FOUND;
 }
 
+/* Stained Glass OS: what the store holds can be read back -- a license file's
+ * identifier and content, a product key's identifier. What licenses grant is
+ * not read: policies and information values are not found, and no right is
+ * consumed, so nothing is licensed or activated by this store (Office's
+ * sign-in licenses it). Office's Word aborted on SLLoadApplicationPolicies. */
+HRESULT WINAPI SLGetLicenseFileId(HSLC handle, UINT size, const BYTE *blob, SLID *id)
+{
+    WCHAR path[MAX_PATH];
+
+    TRACE("(%p %u %p %p)\n", handle, size, blob, id);
+    if (!handle || !size || !blob || !id) return E_INVALIDARG;
+    content_id(blob, size, id);
+    if (!item_path(L"licenses", id, path)) return HRESULT_FROM_WIN32(GetLastError());
+    return GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES ? S_OK : SL_E_LICENSE_FILE_NOT_INSTALLED;
+}
+
+HRESULT WINAPI SLGetLicense(HSLC handle, const SLID *id, UINT *size, BYTE **blob)
+{
+    WCHAR path[MAX_PATH];
+    LARGE_INTEGER length;
+    HANDLE file;
+    DWORD read;
+    BYTE *data;
+
+    TRACE("(%p %s %p %p)\n", handle, debugstr_guid(id), size, blob);
+    if (!handle || !id || !size || !blob) return E_INVALIDARG;
+    if (!item_path(L"licenses", id, path)) return HRESULT_FROM_WIN32(GetLastError());
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return SL_E_LICENSE_FILE_NOT_INSTALLED;
+    if (!GetFileSizeEx(file, &length) || length.QuadPart > 0x1000000 || !(data = LocalAlloc(0, length.LowPart ? length.LowPart : 1)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, data, length.LowPart, &read, NULL) || read != length.LowPart)
+    {
+        CloseHandle(file);
+        LocalFree(data);
+        return E_FAIL;
+    }
+    CloseHandle(file);
+    *size = read;
+    *blob = data;
+    return S_OK;
+}
+
+HRESULT WINAPI SLGetPKeyId(HSLC handle, const WCHAR *algorithm, const WCHAR *key, UINT size, BYTE *data, SLID *id)
+{
+    WCHAR path[MAX_PATH];
+
+    TRACE("(%p %s (key) %u %p %p)\n", handle, debugstr_w(algorithm), size, data, id);
+    if (!handle || !key || !*key || !id) return E_INVALIDARG;
+    content_id((const BYTE *)key, lstrlenW(key) * sizeof(WCHAR), id);
+    if (!item_path(L"keys", id, path)) return HRESULT_FROM_WIN32(GetLastError());
+    return GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES ? S_OK : SL_E_PKEY_NOT_INSTALLED;
+}
+
+HRESULT WINAPI SLGetInstalledProductKeyIds(HSLC handle, const SLID *sku, UINT *count, SLID **ids)
+{
+    TRACE("(%p %s %p %p)\n", handle, debugstr_guid(sku), count, ids);
+    if (!handle || !count || !ids) return E_INVALIDARG;
+    *count = 0;
+    *ids = NULL;
+    return SL_E_VALUE_NOT_FOUND;
+}
+
+/* the application policies of a product: a context that holds none */
+HRESULT WINAPI SLLoadApplicationPolicies(const SLID *app, const SLID *sku, DWORD flags, HSLP *context)
+{
+    TRACE("(%s %s %#lx %p)\n", debugstr_guid(app), debugstr_guid(sku), flags, context);
+    if (!app || !context) return E_INVALIDARG;
+    *context = (HSLP)0x51c0de;
+    return S_OK;
+}
+
+HRESULT WINAPI SLUnloadApplicationPolicies(HSLP context, DWORD flags)
+{
+    TRACE("(%p %#lx)\n", context, flags);
+    return context ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT not_found(const WCHAR *name, SLDATATYPE *type, UINT *size, BYTE **value)
+{
+    TRACE("%s: not found\n", debugstr_w(name));
+    if (!name || !size || !value) return E_INVALIDARG;
+    if (type) *type = SL_DATA_NONE;
+    *size = 0;
+    *value = NULL;
+    return SL_E_VALUE_NOT_FOUND;
+}
+
+HRESULT WINAPI SLGetApplicationPolicy(HSLP context, const WCHAR *name, SLDATATYPE *type, UINT *size, BYTE **value)
+{
+    if (!context) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLGetPolicyInformation(HSLC handle, const WCHAR *name, SLDATATYPE *type, UINT *size, BYTE **value)
+{
+    if (!handle) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLGetPolicyInformationDWORD(HSLC handle, const WCHAR *name, DWORD *value)
+{
+    TRACE("(%p %s %p)\n", handle, debugstr_w(name), value);
+    if (!handle || !name || !value) return E_INVALIDARG;
+    return SL_E_VALUE_NOT_FOUND;
+}
+
+HRESULT WINAPI SLGetProductSkuInformation(HSLC handle, const SLID *sku, const WCHAR *name, SLDATATYPE *type,
+                                          UINT *size, BYTE **value)
+{
+    if (!handle || !sku) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLGetApplicationInformation(HSLC handle, const SLID *app, const WCHAR *name, SLDATATYPE *type,
+                                           UINT *size, BYTE **value)
+{
+    if (!handle || !app) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLGetServiceInformation(HSLC handle, const WCHAR *name, SLDATATYPE *type, UINT *size, BYTE **value)
+{
+    if (!handle) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLGetLicenseInformation(HSLC handle, const SLID *license, const WCHAR *name, SLDATATYPE *type,
+                                       UINT *size, BYTE **value)
+{
+    if (!handle || !license) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLGetPKeyInformation(HSLC handle, const SLID *key, const WCHAR *name, SLDATATYPE *type,
+                                    UINT *size, BYTE **value)
+{
+    if (!handle || !key) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+/* no right is granted by this store */
+HRESULT WINAPI SLConsumeRight(HSLC handle, const SLID *app, const SLID *sku, const WCHAR *right, void *reserved)
+{
+    TRACE("(%p %s %s %s %p)\n", handle, debugstr_guid(app), debugstr_guid(sku), debugstr_w(right), reserved);
+    if (!handle || !app) return E_INVALIDARG;
+    return SL_E_RIGHT_NOT_GRANTED;
+}
+
