diff --git a/dlls/shlwapi/thread.c b/dlls/shlwapi/thread.c
index ee79f73..5f160fb 100644
--- a/dlls/shlwapi/thread.c
+++ b/dlls/shlwapi/thread.c
@@ -247,3 +247,59 @@ HANDLE WINAPI SHGlobalCounterCreate (REFGUID guid)
   SHStringFromGUIDA(guid, szName, sizeof(szName) - 1);
   return SHGlobalCounterCreateNamedA(szName, 0);
 }
+
+/* Stained Glass OS 7703: the shell's global counters by number (SHGLOBALCOUNTER, Windows 8 and
+ * later), SHLWAPI ordinals 632-634: each is a counter every process of the session shares, kept as
+ * the named semaphore "shell.GlobalCounter<n>" (as SHGlobalCounterCreateNamedW names them). */
+static HANDLE global_counters[256];
+
+static HANDLE global_counter( unsigned int id )
+{
+    WCHAR name[32];
+    HANDLE handle, old;
+
+    if (id >= ARRAY_SIZE(global_counters)) return NULL;
+    if ((handle = global_counters[id])) return handle;
+    swprintf( name, ARRAY_SIZE(name), L"GlobalCounter%u", id );
+    if (!(handle = SHGlobalCounterCreateNamedW( name, 0 ))) return NULL;
+    if ((old = InterlockedCompareExchangePointer( &global_counters[id], handle, NULL )))
+    {
+        CloseHandle( handle );
+        handle = old;
+    }
+    return handle;
+}
+
+/*************************************************************************
+ *      SHGlobalCounterGetValue_Id	[SHLWAPI.632]
+ */
+LONG WINAPI SHGlobalCounterGetValue_Id( unsigned int id )
+{
+    HANDLE handle = global_counter( id );
+    TRACE( "(%u)\n", id );
+    return handle ? SHGlobalCounterGetValue( handle ) : 0;
+}
+
+/*************************************************************************
+ *      SHGlobalCounterIncrement_Id	[SHLWAPI.633]
+ */
+LONG WINAPI SHGlobalCounterIncrement_Id( unsigned int id )
+{
+    HANDLE handle = global_counter( id );
+    TRACE( "(%u)\n", id );
+#ifdef SG_MUTANT_GLOBALCOUNTER_NO_COUNT
+    return 0;
+#endif
+    return handle ? SHGlobalCounterIncrement( handle ) : 0;
+}
+
+/*************************************************************************
+ *      SHGlobalCounterDecrement_Id	[SHLWAPI.634]
+ */
+LONG WINAPI SHGlobalCounterDecrement_Id( unsigned int id )
+{
+    HANDLE handle = global_counter( id );
+    TRACE( "(%u)\n", id );
+    if (!handle || !SHGlobalCounterGetValue( handle )) return 0;
+    return SHGlobalCounterDecrement( handle );
+}
