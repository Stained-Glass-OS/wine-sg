Date: Mon, 12 Oct 2026 16:59:19 -0700
Subject: [PATCH] ddraw: BeginIndexed/Index/End, clip status, border colour,
 vblank wait, background depth

Device3 BeginIndexed/Index/End draw through DrawIndexedPrimitive with the indices
collected by Index. Set/GetClipStatus keep the status the application sets.
D3DRENDERSTATE_BORDERCOLOR forwards to sampler 0's border colour.
IDirectDraw::WaitForVerticalBlank blocks until the next edge of a frame period
modelled on the display refresh rate (BLOCKBEGIN, BLOCKEND); other flag values
are refused. Viewport Set/GetBackgroundDepth(2) keep the surface (referenced).
GetPickRecords reports no records, EvaluateMode leaves no time on a test,
ClassFactory::LockServer counts locks, DllCanUnloadNow is exported.
Stubs that are valid as they are (obsolete texture palette hook, overlay z-order
with no overlays, vertex buffer Optimize flag) no longer say FIXME.

diff --git a/dlls/ddraw/ddraw.c b/dlls/ddraw/ddraw.c
index ed342bf..271dffd 100644
--- a/dlls/ddraw/ddraw.c
+++ b/dlls/ddraw/ddraw.c
@@ -2185,20 +2185,47 @@ static HRESULT WINAPI ddraw1_FlipToGDISurface(IDirectDraw *iface)
  *****************************************************************************/
 static HRESULT WINAPI ddraw7_WaitForVerticalBlank(IDirectDraw7 *iface, DWORD Flags, HANDLE event)
 {
-    static BOOL hide;
+    struct ddraw *ddraw = impl_from_IDirectDraw7(iface);
+    struct wined3d_display_mode mode;
+    LARGE_INTEGER freq, now;
+    UINT64 period, phase, wait;
+    DWORD ms;
 
     TRACE("iface %p, flags %#lx, event %p.\n", iface, Flags, event);
 
-    /* This function is called often, so print the fixme only once */
-    if(!hide)
-    {
-        FIXME("iface %p, flags %#lx, event %p stub!\n", iface, Flags, event);
-        hide = TRUE;
-    }
-
     /* MSDN says DDWAITVB_BLOCKBEGINEVENT is not supported */
-    if(Flags & DDWAITVB_BLOCKBEGINEVENT)
+    if (Flags & DDWAITVB_BLOCKBEGINEVENT)
         return DDERR_UNSUPPORTED; /* unchecked */
+    if (Flags != DDWAITVB_BLOCKBEGIN && Flags != DDWAITVB_BLOCKEND)
+        return DDERR_INVALIDPARAMS;
+
+    /* The blank is modelled on the refresh rate: a frame starts every
+     * 1 / rate seconds, counted from an arbitrary but fixed origin, and the
+     * blank is the first 5% of it. */
+    wined3d_mutex_lock();
+    if (FAILED(wined3d_output_get_display_mode(ddraw->wined3d_output, &mode, NULL)) || mode.refresh_rate < 2)
+        mode.refresh_rate = 60;
+    wined3d_mutex_unlock();
+
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&now);
+    period = freq.QuadPart / mode.refresh_rate;
+    TRACE("refresh rate %u, period %I64u ticks.\n", mode.refresh_rate, period);
+    if (!period)
+        return DD_OK;
+    phase = now.QuadPart % period;
+    wait = period - phase;                          /* until the next blank begins */
+    if (Flags == DDWAITVB_BLOCKEND)
+    {
+        if (phase < period / 20)                    /* in the blank: until it ends */
+            wait = period / 20 - phase;
+        else
+            wait += period / 20;
+    }
+    /* round up, so that the wait ends after the edge it waits for, not before it */
+    ms = (DWORD)((wait * 1000 + freq.QuadPart - 1) / freq.QuadPart);
+    if (ms)
+        Sleep(ms);
 
     return DD_OK;
 }
