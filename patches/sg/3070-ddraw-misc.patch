 static HRESULT WINAPI d3d_device3_Index(IDirect3DDevice3 *iface, WORD index)
 {
-    FIXME("iface %p, index %#x stub!\n", iface, index);
+    struct d3d_device *device = impl_from_IDirect3DDevice3(iface);
+    HRESULT hr = D3D_OK;
 
-    return D3D_OK;
+    TRACE("iface %p, index %#x.\n", iface, index);
+
+    wined3d_mutex_lock();
+    if (!device->indexed)
+        hr = DDERR_INVALIDPARAMS;
+    else if (device->index_count == device->index_capacity)
+    {
+        DWORD capacity = device->index_capacity ? device->index_capacity * 2 : 16;
+        WORD *grown = realloc(device->indices, capacity * sizeof(*grown));
+
+        if (grown)
+        {
+            device->indices = grown;
+            device->index_capacity = capacity;
+        }
+        else
+            hr = E_OUTOFMEMORY;
+    }
+    if (hr == D3D_OK)
+        device->indices[device->index_count++] = index;
+    wined3d_mutex_unlock();
+
+    return hr;
 }
 
