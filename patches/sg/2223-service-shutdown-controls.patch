From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] services, wineboot: preshutdown and shutdown controls before services are ended

PreshutdownTimeout was stored and returned but never used, and services never
heard that the system was going down.  Before wineboot --kill ends the
processes it now asks services.exe (named events, default security: SYSTEM
and administrators only) to tell the services first: those that accept
SERVICE_ACCEPT_PRESHUTDOWN get SERVICE_CONTROL_PRESHUTDOWN and their
PreshutdownTimeout to stop, whatever still runs and accepts
SERVICE_ACCEPT_SHUTDOWN gets SERVICE_CONTROL_SHUTDOWN and the kill timeout.
If the server goes down on its own, services.exe does the same when its exit
event fires.  Without services.exe or the right to set the event, wineboot
does not wait.

---
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -674,6 +674,90 @@ static void scmdatabase_autostart_services(struct scmdatabase *db)
     SetupDiDestroyDeviceInfoList(set);
 }
 
+/* At shutdown services that ask for it are told first, as on Windows: those
+ * accepting SERVICE_ACCEPT_PRESHUTDOWN get SERVICE_CONTROL_PRESHUTDOWN and
+ * their PreshutdownTimeout to stop; whatever still runs and accepts
+ * SERVICE_ACCEPT_SHUTDOWN gets SERVICE_CONTROL_SHUTDOWN and the kill timeout.
+ * Only then are the remaining processes ended. */
+static void scmdatabase_shutdown_phase(struct scmdatabase *db, DWORD control, DWORD accept_flag, BOOL preshutdown)
+{
+    struct service_entry **list = NULL, *service;
+    ULONGLONG *deadline = NULL;
+    unsigned int count = 0, size = 0, i;
+
+    scmdatabase_lock(db);
+    LIST_FOR_EACH_ENTRY(service, &db->services, struct service_entry, entry)
+    {
+        if (!service->process || service->status.dwCurrentState == SERVICE_STOPPED ||
+            !(service->status.dwControlsAccepted & accept_flag)) continue;
+        if (count == size)
+        {
+            struct service_entry **new_list = realloc(list, (size = size ? size * 2 : 8) * sizeof(*list));
+            if (!new_list) break;
+            list = new_list;
+        }
+        list[count++] = grab_service(service);
+    }
+    scmdatabase_unlock(db);
+    if (!count || !(deadline = calloc(count, sizeof(*deadline)))) goto done;
+
+    for (i = 0; i < count; i++)
+    {
+        struct process_entry *process;
+        BOOL shared;
+        DWORD result;
+
+        service = list[i];
+        service_lock(service);
+        process = grab_process(service->process);
+        shared = service->shared_process;
+        deadline[i] = GetTickCount64() + (preshutdown ? service->preshutdown_timeout : service_kill_timeout);
+        service_unlock(service);
+        if (!process) { deadline[i] = 0; continue; }
+        WINE_TRACE("sending control %lu to %s\n", control, wine_dbgstr_w(service->name));
+        if (WaitForSingleObject(process->control_mutex, 5000) == WAIT_OBJECT_0)
+        {
+            process_send_control(process, shared, service->name, control, NULL, 0, &result);
+            ReleaseMutex(process->control_mutex);
+        }
+        release_process(process);
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        service = list[i];
+        while (deadline[i])
+        {
+            struct process_entry *process;
+            DWORD state;
+
+            service_lock(service);
+            state = service->status.dwCurrentState;
+            process = grab_process(service->process);
+            service_unlock(service);
+            if (state == SERVICE_STOPPED || !process) { if (process) release_process(process); break; }
+            if (GetTickCount64() > deadline[i])
+            {
+                WINE_WARN("service %s did not stop in time\n", wine_dbgstr_w(service->name));
+                release_process(process);
+                break;
+            }
+            WaitForSingleObject(process->process, 100);
+            release_process(process);
+        }
+    }
+done:
+    for (i = 0; i < count; i++) release_service(list[i]);
+    free(deadline);
+    free(list);
+}
+
+static void scmdatabase_shutdown_services(struct scmdatabase *db)
+{
+    scmdatabase_shutdown_phase(db, SERVICE_CONTROL_PRESHUTDOWN, SERVICE_ACCEPT_PRESHUTDOWN, TRUE);
+    scmdatabase_shutdown_phase(db, SERVICE_CONTROL_SHUTDOWN, SERVICE_ACCEPT_SHUTDOWN, FALSE);
+}
+
 static void scmdatabase_wait_terminate(struct scmdatabase *db)
 {
     struct list pending = LIST_INIT(pending);
@@ -1827,6 +1911,9 @@ static void load_registry_parameters(void)
     RegCloseKey( key );
 }
 
+static HANDLE shutdown_request_event, shutdown_done_event;
+static BOOL services_told_to_shut_down;
+
 static DWORD WINAPI process_monitor_thread_proc( void *arg )
 {
     struct scmdatabase *db = active_database;
@@ -1883,6 +1970,11 @@ int __cdecl main(int argc, char *argv[])
     InitializeCriticalSection(&failure_cs);
     failure_cs_ready = TRUE;
 
+    /* named events with the default security: only SYSTEM and administrators can ask */
+    shutdown_request_event = CreateEventW(NULL, TRUE, FALSE, L"__wine_SvcctlShutdownEvent");
+    shutdown_done_event = CreateEventW(NULL, TRUE, FALSE, L"__wine_SvcctlShutdownDoneEvent");
+    if (!shutdown_request_event || !shutdown_done_event) shutdown_request_event = NULL;
+
     job_object = CreateJobObjectW(NULL, NULL);
     job_limit.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_BREAKAWAY_OK | JOB_OBJECT_LIMIT_SILENT_BREAKAWAY_OK;
     if (!SetInformationJobObject(job_object, JobObjectExtendedLimitInformation, &job_limit, sizeof(job_limit)))
@@ -1930,7 +2022,26 @@ int __cdecl main(int argc, char *argv[])
         scmdatabase_autostart_services(active_database);
         process_monitor_thread = CreateThread(NULL, 0, process_monitor_thread_proc, NULL, 0, NULL);
         SetEvent(started_event);
-        WaitForSingleObject(exit_event, INFINITE);
+        /* wineboot asks for the shutdown controls before it ends the processes; if
+         * the server goes down on its own they are sent when the exit event fires */
+        if (shutdown_request_event)
+        {
+            HANDLE handles[2] = { exit_event, shutdown_request_event };
+
+            while (WaitForMultipleObjects(2, handles, FALSE, INFINITE) == WAIT_OBJECT_0 + 1)
+            {
+                ResetEvent(shutdown_request_event);
+#ifndef SG_MUTANT_NO_SHUTDOWN_CONTROLS
+                scmdatabase_shutdown_services(active_database);
+#endif
+                services_told_to_shut_down = TRUE;
+                SetEvent(shutdown_done_event);
+            }
+        }
+        else WaitForSingleObject(exit_event, INFINITE);
+#ifndef SG_MUTANT_NO_SHUTDOWN_CONTROLS
+        if (!services_told_to_shut_down) scmdatabase_shutdown_services(active_database);
+#endif
         PostQueuedCompletionStatus(job_completion_port, 0, 0, NULL);
         WaitForSingleObject(process_monitor_thread, INFINITE);
         scmdatabase_wait_terminate(active_database);
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1939,6 +1939,25 @@ static void usage( int status )
     exit( status );
 }
 
+/* Before the processes are ended, the services get the controls a service that asks for
+ * them is owed: preshutdown (with its timeout) and shutdown.  services.exe does it when
+ * its named event is set, and says so on another; without services.exe, or without the
+ * right to set the event, nothing waits. */
+static void shutdown_services(void)
+{
+    HANDLE request, done;
+
+    if (!(request = OpenEventW( EVENT_MODIFY_STATE, FALSE, L"__wine_SvcctlShutdownEvent" ))) return;
+    if ((done = OpenEventW( SYNCHRONIZE | EVENT_MODIFY_STATE, FALSE, L"__wine_SvcctlShutdownDoneEvent" )))
+    {
+        ResetEvent( done );
+        SetEvent( request );
+        WaitForSingleObject( done, 300000 );
+        CloseHandle( done );
+    }
+    CloseHandle( request );
+}
+
 int __cdecl main( int argc, char *argv[] )
 {
     /* First, set the current directory to SystemRoot */
@@ -2028,7 +2047,11 @@ int __cdecl main( int argc, char *argv[] )
         if (logoff && !kill) PostMessageW( GetDesktopWindow(), WM_CLOSE, 0, 0 );
     }
 
-    if (kill) kill_processes( shutdown );
+    if (kill)
+    {
+        shutdown_services();
+        kill_processes( shutdown );
+    }
 
     if (shutdown) return 0;
 
