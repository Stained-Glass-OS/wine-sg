From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: event handler groups

IUIAutomation6::CreateEventHandlerGroup returns a group object whose Add*
methods (automation, property, structure, notification, text edit, changes,
active text position) remember a handler with its scope, cache request and
arguments. AddEventHandlerGroup registers all of them on an element through
the IUIAutomation methods that exist, undoing the ones already added if one
fails; RemoveEventHandlerGroup takes them all off. A NULL element or group is
E_POINTER, a group of another maker E_INVALIDARG, a NULL handler E_POINTER,
no scope E_INVALIDARG. These were E_NOTIMPL stubs.
---
--- a/dlls/uiautomationcore/uia_com_client.c
+++ b/dlls/uiautomationcore/uia_com_client.c
@@ -6587,26 +6587,378 @@ static HRESULT WINAPI uia_iface_RemoveNotificationEventHandler(IUIAutomation6 *i
     return hr;
 }
 
+#ifndef UIA_ActiveTextPositionChangedEventId
+#define UIA_ActiveTextPositionChangedEventId 20036
+#endif
+
+enum uia_group_entry_kind {
+    GROUP_ENTRY_AUTOMATION,
+    GROUP_ENTRY_PROPERTY,
+    GROUP_ENTRY_STRUCTURE,
+    GROUP_ENTRY_TEXT_EDIT,
+    GROUP_ENTRY_CHANGES,
+    GROUP_ENTRY_NOTIFICATION,
+    GROUP_ENTRY_ACTIVE_TEXT_POSITION,
+};
+
+struct uia_group_entry {
+    enum uia_group_entry_kind kind;
+    EVENTID event_id;
+    enum TreeScope scope;
+    IUIAutomationCacheRequest *cache_req;
+    IUnknown *handler;
+    PROPERTYID *props;
+    int props_count;
+    int *change_types;
+    int change_types_count;
+    enum TextEditChangeType text_change_type;
+};
+
+struct uia_event_handler_group {
+    IUIAutomationEventHandlerGroup IUIAutomationEventHandlerGroup_iface;
+    LONG ref;
+
+    struct uia_group_entry *entries;
+    int entries_count;
+    int entries_size;
+};
+
+static inline struct uia_event_handler_group *impl_from_IUIAutomationEventHandlerGroup(
+        IUIAutomationEventHandlerGroup *iface)
+{
+    return CONTAINING_RECORD(iface, struct uia_event_handler_group, IUIAutomationEventHandlerGroup_iface);
+}
+
+static HRESULT WINAPI uia_event_handler_group_QueryInterface(IUIAutomationEventHandlerGroup *iface,
+        REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUIAutomationEventHandlerGroup) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+
+    IUIAutomationEventHandlerGroup_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI uia_event_handler_group_AddRef(IUIAutomationEventHandlerGroup *iface)
+{
+    struct uia_event_handler_group *group = impl_from_IUIAutomationEventHandlerGroup(iface);
+    ULONG ref = InterlockedIncrement(&group->ref);
+
+    TRACE("%p, refcount %ld\n", group, ref);
+    return ref;
+}
+
+static ULONG WINAPI uia_event_handler_group_Release(IUIAutomationEventHandlerGroup *iface)
+{
+    struct uia_event_handler_group *group = impl_from_IUIAutomationEventHandlerGroup(iface);
+    ULONG ref = InterlockedDecrement(&group->ref);
+    int i;
+
+    TRACE("%p, refcount %ld\n", group, ref);
+    if (!ref)
+    {
+        for (i = 0; i < group->entries_count; i++)
+        {
+            struct uia_group_entry *entry = &group->entries[i];
+
+            if (entry->cache_req)
+                IUIAutomationCacheRequest_Release(entry->cache_req);
+            IUnknown_Release(entry->handler);
+            free(entry->props);
+            free(entry->change_types);
+        }
+        free(group->entries);
+        free(group);
+    }
+    return ref;
+}
+
+/* Takes over nothing: every pointer is copied or referenced. */
+static HRESULT uia_event_handler_group_add(IUIAutomationEventHandlerGroup *iface, enum uia_group_entry_kind kind,
+        EVENTID event_id, enum TreeScope scope, IUIAutomationCacheRequest *cache_req, IUnknown *handler,
+        const PROPERTYID *props, int props_count, const int *change_types, int change_types_count,
+        enum TextEditChangeType text_change_type)
+{
+    struct uia_event_handler_group *group = impl_from_IUIAutomationEventHandlerGroup(iface);
+    struct uia_group_entry *entry;
+
+    if (!handler)
+        return E_POINTER;
+    if (!scope || (scope & ~TreeScope_Subtree))
+        return E_INVALIDARG;
+
+    if (group->entries_count == group->entries_size)
+    {
+        int new_size = group->entries_size ? group->entries_size * 2 : 4;
+        struct uia_group_entry *new_entries = realloc(group->entries, new_size * sizeof(*new_entries));
+
+        if (!new_entries)
+            return E_OUTOFMEMORY;
+        group->entries = new_entries;
+        group->entries_size = new_size;
+    }
+
+    entry = &group->entries[group->entries_count];
+    memset(entry, 0, sizeof(*entry));
+    if (props_count > 0)
+    {
+        if (!(entry->props = malloc(props_count * sizeof(*props))))
+            return E_OUTOFMEMORY;
+        memcpy(entry->props, props, props_count * sizeof(*props));
+        entry->props_count = props_count;
+    }
+    if (change_types_count > 0)
+    {
+        if (!(entry->change_types = malloc(change_types_count * sizeof(*change_types))))
+        {
+            free(entry->props);
+            return E_OUTOFMEMORY;
+        }
+        memcpy(entry->change_types, change_types, change_types_count * sizeof(*change_types));
+        entry->change_types_count = change_types_count;
+    }
+    entry->kind = kind;
+    entry->event_id = event_id;
+    entry->scope = scope;
+    entry->cache_req = cache_req;
+    if (cache_req)
+        IUIAutomationCacheRequest_AddRef(cache_req);
+    entry->handler = handler;
+    IUnknown_AddRef(handler);
+    entry->text_change_type = text_change_type;
+    group->entries_count++;
+    return S_OK;
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddActiveTextPositionChangedEventHandler(
+        IUIAutomationEventHandlerGroup *iface, enum TreeScope scope, IUIAutomationCacheRequest *cache_req,
+        IUIAutomationActiveTextPositionChangedEventHandler *handler)
+{
+    TRACE("%p, %#x, %p, %p\n", iface, scope, cache_req, handler);
+
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_ACTIVE_TEXT_POSITION,
+            UIA_ActiveTextPositionChangedEventId, scope, cache_req, (IUnknown *)handler, NULL, 0, NULL, 0, 0);
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddAutomationEventHandler(IUIAutomationEventHandlerGroup *iface,
+        EVENTID event_id, enum TreeScope scope, IUIAutomationCacheRequest *cache_req,
+        IUIAutomationEventHandler *handler)
+{
+    TRACE("%p, %d, %#x, %p, %p\n", iface, event_id, scope, cache_req, handler);
+
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_AUTOMATION, event_id, scope, cache_req,
+            (IUnknown *)handler, NULL, 0, NULL, 0, 0);
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddChangesEventHandler(IUIAutomationEventHandlerGroup *iface,
+        enum TreeScope scope, int *change_types, int change_types_count, IUIAutomationCacheRequest *cache_req,
+        IUIAutomationChangesEventHandler *handler)
+{
+    TRACE("%p, %#x, %p, %d, %p, %p\n", iface, scope, change_types, change_types_count, cache_req, handler);
+
+    if (handler && (!change_types || change_types_count <= 0))
+        return change_types ? E_INVALIDARG : E_POINTER;
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_CHANGES, UIA_ChangesEventId, scope, cache_req,
+            (IUnknown *)handler, NULL, 0, change_types, change_types_count, 0);
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddNotificationEventHandler(IUIAutomationEventHandlerGroup *iface,
+        enum TreeScope scope, IUIAutomationCacheRequest *cache_req, IUIAutomationNotificationEventHandler *handler)
+{
+    TRACE("%p, %#x, %p, %p\n", iface, scope, cache_req, handler);
+
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_NOTIFICATION, UIA_NotificationEventId, scope, cache_req,
+            (IUnknown *)handler, NULL, 0, NULL, 0, 0);
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddPropertyChangedEventHandler(IUIAutomationEventHandlerGroup *iface,
+        enum TreeScope scope, IUIAutomationCacheRequest *cache_req, IUIAutomationPropertyChangedEventHandler *handler,
+        PROPERTYID *props, int props_count)
+{
+    TRACE("%p, %#x, %p, %p, %p, %d\n", iface, scope, cache_req, handler, props, props_count);
+
+    if (!props)
+        return E_POINTER;
+    if (props_count <= 0)
+        return E_INVALIDARG;
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_PROPERTY, UIA_AutomationPropertyChangedEventId, scope,
+            cache_req, (IUnknown *)handler, props, props_count, NULL, 0, 0);
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddStructureChangedEventHandler(IUIAutomationEventHandlerGroup *iface,
+        enum TreeScope scope, IUIAutomationCacheRequest *cache_req, IUIAutomationStructureChangedEventHandler *handler)
+{
+    TRACE("%p, %#x, %p, %p\n", iface, scope, cache_req, handler);
+
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_STRUCTURE, UIA_StructureChangedEventId, scope, cache_req,
+            (IUnknown *)handler, NULL, 0, NULL, 0, 0);
+}
+
+static HRESULT WINAPI uia_event_handler_group_AddTextEditTextChangedEventHandler(
+        IUIAutomationEventHandlerGroup *iface, enum TreeScope scope, enum TextEditChangeType change_type,
+        IUIAutomationCacheRequest *cache_req, IUIAutomationTextEditTextChangedEventHandler *handler)
+{
+    TRACE("%p, %#x, %d, %p, %p\n", iface, scope, change_type, cache_req, handler);
+
+    return uia_event_handler_group_add(iface, GROUP_ENTRY_TEXT_EDIT, UIA_TextEdit_TextChangedEventId, scope,
+            cache_req, (IUnknown *)handler, NULL, 0, NULL, 0, change_type);
+}
+
+static const IUIAutomationEventHandlerGroupVtbl uia_event_handler_group_vtbl = {
+    uia_event_handler_group_QueryInterface,
+    uia_event_handler_group_AddRef,
+    uia_event_handler_group_Release,
+    uia_event_handler_group_AddActiveTextPositionChangedEventHandler,
+    uia_event_handler_group_AddAutomationEventHandler,
+    uia_event_handler_group_AddChangesEventHandler,
+    uia_event_handler_group_AddNotificationEventHandler,
+    uia_event_handler_group_AddPropertyChangedEventHandler,
+    uia_event_handler_group_AddStructureChangedEventHandler,
+    uia_event_handler_group_AddTextEditTextChangedEventHandler,
+};
+
+static struct uia_event_handler_group *uia_event_handler_group_from_iface(IUIAutomationEventHandlerGroup *iface)
+{
+    if (!iface || iface->lpVtbl != &uia_event_handler_group_vtbl)
+        return NULL;
+    return impl_from_IUIAutomationEventHandlerGroup(iface);
+}
+
 /* IUIAutomation6 methods */
 static HRESULT WINAPI uia_iface_CreateEventHandlerGroup(IUIAutomation6 *iface,
         IUIAutomationEventHandlerGroup **out_handler_group)
 {
-    FIXME("%p, %p: stub\n", iface, out_handler_group);
-    return E_NOTIMPL;
+    struct uia_event_handler_group *group;
+
+    TRACE("%p, %p\n", iface, out_handler_group);
+
+    if (!out_handler_group)
+        return E_POINTER;
+
+    *out_handler_group = NULL;
+    if (!(group = calloc(1, sizeof(*group))))
+        return E_OUTOFMEMORY;
+
+    group->IUIAutomationEventHandlerGroup_iface.lpVtbl = &uia_event_handler_group_vtbl;
+    group->ref = 1;
+    *out_handler_group = &group->IUIAutomationEventHandlerGroup_iface;
+    return S_OK;
+}
+
+static HRESULT uia_group_entry_remove(IUIAutomation6 *iface, IUIAutomationElement *elem,
+        const struct uia_group_entry *entry)
+{
+    IUIAutomation6 *uia = iface;
+
+    switch (entry->kind)
+    {
+    case GROUP_ENTRY_AUTOMATION:
+        return IUIAutomation6_RemoveAutomationEventHandler(uia, entry->event_id, elem,
+                (IUIAutomationEventHandler *)entry->handler);
+    case GROUP_ENTRY_PROPERTY:
+        return IUIAutomation6_RemovePropertyChangedEventHandler(uia, elem,
+                (IUIAutomationPropertyChangedEventHandler *)entry->handler);
+    case GROUP_ENTRY_STRUCTURE:
+        return IUIAutomation6_RemoveStructureChangedEventHandler(uia, elem,
+                (IUIAutomationStructureChangedEventHandler *)entry->handler);
+    case GROUP_ENTRY_TEXT_EDIT:
+        return IUIAutomation6_RemoveTextEditTextChangedEventHandler(uia, elem,
+                (IUIAutomationTextEditTextChangedEventHandler *)entry->handler);
+    case GROUP_ENTRY_CHANGES:
+        return IUIAutomation6_RemoveChangesEventHandler(uia, elem, (IUIAutomationChangesEventHandler *)entry->handler);
+    case GROUP_ENTRY_NOTIFICATION:
+        return IUIAutomation6_RemoveNotificationEventHandler(uia, elem,
+                (IUIAutomationNotificationEventHandler *)entry->handler);
+    case GROUP_ENTRY_ACTIVE_TEXT_POSITION:
+        return IUIAutomation6_RemoveActiveTextPositionChangedEventHandler(uia, elem,
+                (IUIAutomationActiveTextPositionChangedEventHandler *)entry->handler);
+    }
+    return E_INVALIDARG;
+}
+
+static HRESULT uia_group_entry_add(IUIAutomation6 *uia, IUIAutomationElement *elem,
+        const struct uia_group_entry *entry)
+{
+    switch (entry->kind)
+    {
+    case GROUP_ENTRY_AUTOMATION:
+        return IUIAutomation6_AddAutomationEventHandler(uia, entry->event_id, elem, entry->scope, entry->cache_req,
+                (IUIAutomationEventHandler *)entry->handler);
+    case GROUP_ENTRY_PROPERTY:
+        return IUIAutomation6_AddPropertyChangedEventHandlerNativeArray(uia, elem, entry->scope, entry->cache_req,
+                (IUIAutomationPropertyChangedEventHandler *)entry->handler, entry->props, entry->props_count);
+    case GROUP_ENTRY_STRUCTURE:
+        return IUIAutomation6_AddStructureChangedEventHandler(uia, elem, entry->scope, entry->cache_req,
+                (IUIAutomationStructureChangedEventHandler *)entry->handler);
+    case GROUP_ENTRY_TEXT_EDIT:
+        return IUIAutomation6_AddTextEditTextChangedEventHandler(uia, elem, entry->scope, entry->text_change_type,
+                entry->cache_req, (IUIAutomationTextEditTextChangedEventHandler *)entry->handler);
+    case GROUP_ENTRY_CHANGES:
+        return IUIAutomation6_AddChangesEventHandler(uia, elem, entry->scope, entry->change_types,
+                entry->change_types_count, entry->cache_req, (IUIAutomationChangesEventHandler *)entry->handler);
+    case GROUP_ENTRY_NOTIFICATION:
+        return IUIAutomation6_AddNotificationEventHandler(uia, elem, entry->scope, entry->cache_req,
+                (IUIAutomationNotificationEventHandler *)entry->handler);
+    case GROUP_ENTRY_ACTIVE_TEXT_POSITION:
+        return IUIAutomation6_AddActiveTextPositionChangedEventHandler(uia, elem, entry->scope, entry->cache_req,
+                (IUIAutomationActiveTextPositionChangedEventHandler *)entry->handler);
+    }
+    return E_INVALIDARG;
 }
 
 static HRESULT WINAPI uia_iface_AddEventHandlerGroup(IUIAutomation6 *iface, IUIAutomationElement *elem,
         IUIAutomationEventHandlerGroup *handler_group)
 {
-    FIXME("%p, %p, %p: stub\n", iface, elem, handler_group);
-    return E_NOTIMPL;
+    struct uia_event_handler_group *group;
+    HRESULT hr = S_OK;
+    int i;
+
+    TRACE("%p, %p, %p\n", iface, elem, handler_group);
+
+    if (!elem || !handler_group)
+        return E_POINTER;
+    if (!(group = uia_event_handler_group_from_iface(handler_group)))
+        return E_INVALIDARG;
+
+    for (i = 0; i < group->entries_count; i++)
+    {
+#ifdef SG_MUTANT_GROUP_ADD_FIRST_ONLY
+        if (i) break;
+#endif
+        hr = uia_group_entry_add(iface, elem, &group->entries[i]);
+        if (FAILED(hr))
+            break;
+    }
+
+    /* All or nothing: undo what was registered before the failure. */
+    if (FAILED(hr))
+        while (--i >= 0)
+            uia_group_entry_remove(iface, elem, &group->entries[i]);
+    return hr;
 }
 
 static HRESULT WINAPI uia_iface_RemoveEventHandlerGroup(IUIAutomation6 *iface, IUIAutomationElement *elem,
         IUIAutomationEventHandlerGroup *handler_group)
 {
-    FIXME("%p, %p, %p: stub\n", iface, elem, handler_group);
-    return E_NOTIMPL;
+    struct uia_event_handler_group *group;
+    int i;
+
+    TRACE("%p, %p, %p\n", iface, elem, handler_group);
+
+    if (!elem || !handler_group)
+        return E_POINTER;
+    if (!(group = uia_event_handler_group_from_iface(handler_group)))
+        return E_INVALIDARG;
+
+#ifdef SG_MUTANT_GROUP_REMOVE_NOOP
+    return S_OK;
+#endif
+    for (i = 0; i < group->entries_count; i++)
+        uia_group_entry_remove(iface, elem, &group->entries[i]);
+    return S_OK;
 }
 
 static HRESULT WINAPI uia_iface_get_ConnectionRecoveryBehavior(IUIAutomation6 *iface,
