 static HRESULT WINAPI LangBarMgr_UnAdviseEventSink( ITfLangBarMgr* iface, DWORD dwCookie)
 {
     LangBarMgr *This = impl_from_ITfLangBarMgr(iface);
+    LangBarSink *entry;
 
-    FIXME("STUB:(%p)\n",This);
-    return E_NOTIMPL;
+    TRACE("(%p) %#lx\n", This, dwCookie);
+
+    LIST_FOR_EACH_ENTRY(entry, &This->eventSinks, LangBarSink, entry)
+    {
+        if (entry->cookie != dwCookie) continue;
+        list_remove(&entry->entry);
+        IUnknown_Release(entry->sink);
+        free(entry);
+        return S_OK;
+    }
+    return CONNECT_E_NOCONNECTION;
 }
 
