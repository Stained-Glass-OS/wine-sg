@@ -92,17 +172,45 @@ static ULONG WINAPI LangBarMgr_Release(ITfLangBarMgr *iface)
 static HRESULT WINAPI LangBarMgr_AdviseEventSink( ITfLangBarMgr* iface, ITfLangBarEventSink *pSink, HWND hwnd, DWORD dwflags, DWORD *pdwCookie)
 {
     LangBarMgr *This = impl_from_ITfLangBarMgr(iface);
+    LangBarSink *entry;
+    IUnknown *unk;
 
-    FIXME("STUB:(%p)\n",This);
-    return E_NOTIMPL;
+    TRACE("(%p) %p %p %#lx %p\n", This, pSink, hwnd, dwflags, pdwCookie);
+
+    if (!pSink || !pdwCookie)
+        return E_INVALIDARG;
+    if (FAILED(ITfLangBarEventSink_QueryInterface(pSink, &IID_ITfLangBarEventSink, (void **)&unk)))
