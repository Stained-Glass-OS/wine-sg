@@ -184,10 +328,14 @@ HRESULT LangBarMgr_Constructor(IUnknown *pUnkOuter, IUnknown **ppOut)
     if (pUnkOuter)
         return CLASS_E_NOAGGREGATION;
 
-    This = malloc(sizeof(LangBarMgr));
+    This = calloc(1, sizeof(LangBarMgr));
     if (This == NULL)
         return E_OUTOFMEMORY;
 
+    list_init(&This->eventSinks);
+    This->nextCookie = 1;
+    This->floating = TF_SFT_HIDDEN;
+
     This->ITfLangBarMgr_iface.lpVtbl = &LangBarMgr_LangBarMgrVtbl;
     This->refCount = 1;
 
@@ -195,3 +343,419 @@ HRESULT LangBarMgr_Constructor(IUnknown *pUnkOuter, IUnknown **ppOut)
     TRACE("returning %p\n", *ppOut);
     return S_OK;
 }
+
+/*****************************************************
+ * IEnumTfLangBarItems
+ *****************************************************/
+
+static HRESULT WINAPI EnumLangBarItems_QueryInterface(IEnumTfLangBarItems *iface, REFIID iid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_IEnumTfLangBarItems))
+    {
+        *ppv = iface;
+        IEnumTfLangBarItems_AddRef(iface);
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI EnumLangBarItems_AddRef(IEnumTfLangBarItems *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumTfLangBarItems(iface)->refCount);
+}
+
+static ULONG WINAPI EnumLangBarItems_Release(IEnumTfLangBarItems *iface)
+{
+    EnumLangBarItems *This = impl_from_IEnumTfLangBarItems(iface);
+    ULONG ret = InterlockedDecrement(&This->refCount);
+    ULONG i;
+
+    if (!ret)
+    {
+        for (i = 0; i < This->count; i++) ITfLangBarItem_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ret;
+}
+
+static const IEnumTfLangBarItemsVtbl EnumLangBarItemsVtbl;
+
+static HRESULT EnumLangBarItems_Create(ITfLangBarItem **items, ULONG count, ULONG pos, IEnumTfLangBarItems **ret)
+{
+    EnumLangBarItems *This;
+    ULONG i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (count && !(This->items = calloc(count, sizeof(*items))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumTfLangBarItems_iface.lpVtbl = &EnumLangBarItemsVtbl;
+    This->refCount = 1;
+    This->count = count;
+    This->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        This->items[i] = items[i];
+        ITfLangBarItem_AddRef(items[i]);
+    }
+    *ret = &This->IEnumTfLangBarItems_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumLangBarItems_Clone(IEnumTfLangBarItems *iface, IEnumTfLangBarItems **ret)
+{
+    EnumLangBarItems *This = impl_from_IEnumTfLangBarItems(iface);
+
+    if (!ret) return E_INVALIDARG;
+    return EnumLangBarItems_Create(This->items, This->count, This->pos, ret);
+}
+
+static HRESULT WINAPI EnumLangBarItems_Next(IEnumTfLangBarItems *iface, ULONG count, ITfLangBarItem **item, ULONG *fetched)
+{
+    EnumLangBarItems *This = impl_from_IEnumTfLangBarItems(iface);
+    ULONG n = 0;
+
+    if (!item || (!fetched && count != 1)) return E_INVALIDARG;
+    while (n < count && This->pos < This->count)
+    {
+        item[n] = This->items[This->pos++];
+        ITfLangBarItem_AddRef(item[n]);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI EnumLangBarItems_Reset(IEnumTfLangBarItems *iface)
+{
+    impl_from_IEnumTfLangBarItems(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI EnumLangBarItems_Skip(IEnumTfLangBarItems *iface, ULONG count)
+{
+    EnumLangBarItems *This = impl_from_IEnumTfLangBarItems(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static const IEnumTfLangBarItemsVtbl EnumLangBarItemsVtbl =
+{
+    EnumLangBarItems_QueryInterface,
+    EnumLangBarItems_AddRef,
+    EnumLangBarItems_Release,
+    EnumLangBarItems_Clone,
+    EnumLangBarItems_Next,
+    EnumLangBarItems_Reset,
+    EnumLangBarItems_Skip,
+};
+
+/*****************************************************
+ * ITfLangBarItemMgr
+ *****************************************************/
+
+static HRESULT WINAPI LangBarItemMgr_QueryInterface(ITfLangBarItemMgr *iface, REFIID iid, void **ppv)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+
+    *ppv = NULL;
+    if (IsEqualIID(iid, &IID_IUnknown) || IsEqualIID(iid, &IID_ITfLangBarItemMgr))
+    {
+        *ppv = &This->ITfLangBarItemMgr_iface;
+        ITfLangBarItemMgr_AddRef(iface);
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI LangBarItemMgr_AddRef(ITfLangBarItemMgr *iface)
+{
+    return InterlockedIncrement(&impl_from_ITfLangBarItemMgr(iface)->refCount);
+}
+
+/* the manager of a thread lives as long as the process, so a release never frees it */
+static ULONG WINAPI LangBarItemMgr_Release(ITfLangBarItemMgr *iface)
+{
+    return InterlockedDecrement(&impl_from_ITfLangBarItemMgr(iface)->refCount);
+}
+
+static LangBarItem *find_lang_bar_item(LangBarItemMgr *This, REFGUID guid)
+{
+    LangBarItem *item;
+
+    LIST_FOR_EACH_ENTRY(item, &This->items, LangBarItem, entry)
+        if (IsEqualGUID(&item->guid, guid)) return item;
+    return NULL;
+}
+
+static HRESULT WINAPI LangBarItemMgr_EnumItems(ITfLangBarItemMgr *iface, IEnumTfLangBarItems **ppEnum)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    ITfLangBarItem **items = NULL;
+    LangBarItem *item;
+    ULONG count = 0, i = 0;
+    HRESULT hr;
+
+    TRACE("(%p) %p\n", This, ppEnum);
+
+    if (!ppEnum) return E_INVALIDARG;
+    LIST_FOR_EACH_ENTRY(item, &This->items, LangBarItem, entry) count++;
+    if (count && !(items = malloc(count * sizeof(*items)))) return E_OUTOFMEMORY;
+    LIST_FOR_EACH_ENTRY(item, &This->items, LangBarItem, entry) items[i++] = item->item;
+    hr = EnumLangBarItems_Create(items, count, 0, ppEnum);
+    free(items);
+    return hr;
+}
+
+static HRESULT WINAPI LangBarItemMgr_GetItem(ITfLangBarItemMgr *iface, REFGUID rguid, ITfLangBarItem **ppItem)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    LangBarItem *item;
+
+    TRACE("(%p) %s %p\n", This, debugstr_guid(rguid), ppItem);
+
+    if (!rguid || !ppItem) return E_INVALIDARG;
+    *ppItem = NULL;
+    if (!(item = find_lang_bar_item(This, rguid))) return E_FAIL;
+    ITfLangBarItem_AddRef((*ppItem = item->item));
+    return S_OK;
+}
+
+static HRESULT WINAPI LangBarItemMgr_AddItem(ITfLangBarItemMgr *iface, ITfLangBarItem *punk)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    TF_LANGBARITEMINFO info;
+    LangBarItem *item;
+    HRESULT hr;
+
+    TRACE("(%p) %p\n", This, punk);
+
+    if (!punk) return E_INVALIDARG;
+    if (FAILED(hr = ITfLangBarItem_GetInfo(punk, &info))) return hr;
+#ifndef SG_MUTANT_DUP_ITEM
+    if (find_lang_bar_item(This, &info.guidItem)) return E_INVALIDARG;
+#endif
+    if (!(item = malloc(sizeof(*item)))) return E_OUTOFMEMORY;
+    item->item = punk;
+    item->guid = info.guidItem;
+    ITfLangBarItem_AddRef(punk);
+    list_add_tail(&This->items, &item->entry);
+    return S_OK;
+}
+
+static HRESULT WINAPI LangBarItemMgr_RemoveItem(ITfLangBarItemMgr *iface, ITfLangBarItem *punk)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    LangBarItem *item;
+
+    TRACE("(%p) %p\n", This, punk);
+
+    if (!punk) return E_INVALIDARG;
+    LIST_FOR_EACH_ENTRY(item, &This->items, LangBarItem, entry)
+    {
+        if (item->item != punk) continue;
+        list_remove(&item->entry);
+        ITfLangBarItem_Release(item->item);
+        free(item);
+        return S_OK;
+    }
+    return E_FAIL;
+}
+
+static HRESULT WINAPI LangBarItemMgr_AdviseItemSink(ITfLangBarItemMgr *iface, ITfLangBarItemSink *punk,
+                                                    DWORD *pdwCookie, REFGUID rguidItem)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    ItemSink *entry;
+
+    TRACE("(%p) %p %p %s\n", This, punk, pdwCookie, debugstr_guid(rguidItem));
+
+    if (!punk || !pdwCookie || !rguidItem) return E_INVALIDARG;
+    if (!find_lang_bar_item(This, rguidItem)) return E_FAIL;
+    if (!(entry = malloc(sizeof(*entry)))) return E_OUTOFMEMORY;
+    entry->cookie = This->nextCookie++;
+    entry->guid = *rguidItem;
+    entry->sink = punk;
+    ITfLangBarItemSink_AddRef(punk);
+    list_add_tail(&This->sinks, &entry->entry);
+    *pdwCookie = entry->cookie;
+    return S_OK;
+}
+
+static HRESULT WINAPI LangBarItemMgr_UnadviseItemSink(ITfLangBarItemMgr *iface, DWORD dwCookie)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    ItemSink *entry;
+
+    TRACE("(%p) %#lx\n", This, dwCookie);
+
+    LIST_FOR_EACH_ENTRY(entry, &This->sinks, ItemSink, entry)
+    {
+        if (entry->cookie != dwCookie) continue;
+        list_remove(&entry->entry);
+        ITfLangBarItemSink_Release(entry->sink);
+        free(entry);
+        return S_OK;
+    }
+    return E_FAIL;
+}
+
+static HRESULT WINAPI LangBarItemMgr_GetItemFloatingRect(ITfLangBarItemMgr *iface, DWORD dwThreadId,
+                                                         REFGUID rguid, RECT *prc)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+
+    TRACE("(%p) %lu %s %p\n", This, dwThreadId, debugstr_guid(rguid), prc);
+
+    if (!rguid || !prc) return E_INVALIDARG;
+    /* no language bar is shown, so no item has a place on it */
+    memset(prc, 0, sizeof(*prc));
+    return E_FAIL;
+}
+
+static HRESULT WINAPI LangBarItemMgr_GetItemsStatus(ITfLangBarItemMgr *iface, ULONG ulCount,
+                                                    const GUID *prgguid, DWORD *pdwStatus)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    HRESULT result = S_OK;
+    ULONG i;
+
+    TRACE("(%p) %lu %p %p\n", This, ulCount, prgguid, pdwStatus);
+
+    if (ulCount && (!prgguid || !pdwStatus)) return E_INVALIDARG;
+    for (i = 0; i < ulCount; i++)
+    {
+        LangBarItem *item = find_lang_bar_item(This, &prgguid[i]);
+        pdwStatus[i] = 0;
+        if (!item || FAILED(ITfLangBarItem_GetStatus(item->item, &pdwStatus[i]))) result = E_FAIL;
+    }
+    return result;
+}
+
+static HRESULT WINAPI LangBarItemMgr_GetItemNum(ITfLangBarItemMgr *iface, ULONG *pulCount)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    LangBarItem *item;
+    ULONG count = 0;
+
+    TRACE("(%p) %p\n", This, pulCount);
+
+    if (!pulCount) return E_INVALIDARG;
+    LIST_FOR_EACH_ENTRY(item, &This->items, LangBarItem, entry) count++;
+    *pulCount = count;
+    return S_OK;
+}
+
+static HRESULT WINAPI LangBarItemMgr_GetItems(ITfLangBarItemMgr *iface, ULONG ulCount, ITfLangBarItem **ppItem,
+                                              TF_LANGBARITEMINFO *pInfo, DWORD *pdwStatus, ULONG *pcFetched)
+{
+    LangBarItemMgr *This = impl_from_ITfLangBarItemMgr(iface);
+    LangBarItem *item;
+    ULONG n = 0;
+
+    TRACE("(%p) %lu %p %p %p %p\n", This, ulCount, ppItem, pInfo, pdwStatus, pcFetched);
+
+    if (ulCount && !ppItem) return E_INVALIDARG;
+    LIST_FOR_EACH_ENTRY(item, &This->items, LangBarItem, entry)
+    {
+        if (n >= ulCount) break;
+        ITfLangBarItem_AddRef((ppItem[n] = item->item));
+        if (pInfo) ITfLangBarItem_GetInfo(item->item, &pInfo[n]);
+        if (pdwStatus) ITfLangBarItem_GetStatus(item->item, &pdwStatus[n]);
+        n++;
+    }
+    if (pcFetched) *pcFetched = n;
+    return n == ulCount ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI LangBarItemMgr_AdviseItemsSink(ITfLangBarItemMgr *iface, ULONG ulCount,
+                                                     ITfLangBarItemSink **ppunk, const GUID *pguidItem,
+                                                     DWORD *pdwCookie)
+{
+    ULONG i, j;
+    HRESULT hr;
+
+    TRACE("(%p) %lu %p %p %p\n", iface, ulCount, ppunk, pguidItem, pdwCookie);
+
+    if (ulCount && (!ppunk || !pguidItem || !pdwCookie)) return E_INVALIDARG;
+    for (i = 0; i < ulCount; i++)
+    {
+        if (FAILED(hr = ITfLangBarItemMgr_AdviseItemSink(iface, ppunk[i], &pdwCookie[i], &pguidItem[i])))
+        {
+            for (j = 0; j < i; j++) ITfLangBarItemMgr_UnadviseItemSink(iface, pdwCookie[j]);
+            return hr;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI LangBarItemMgr_UnadviseItemsSink(ITfLangBarItemMgr *iface, ULONG ulCount, DWORD *pdwCookie)
+{
+    HRESULT result = S_OK, hr;
+    ULONG i;
+
+    TRACE("(%p) %lu %p\n", iface, ulCount, pdwCookie);
+
+    if (ulCount && !pdwCookie) return E_INVALIDARG;
+    for (i = 0; i < ulCount; i++)
+        if (FAILED(hr = ITfLangBarItemMgr_UnadviseItemSink(iface, pdwCookie[i]))) result = hr;
+    return result;
+}
+
+static const ITfLangBarItemMgrVtbl LangBarItemMgrVtbl =
+{
+    LangBarItemMgr_QueryInterface,
+    LangBarItemMgr_AddRef,
+    LangBarItemMgr_Release,
+    LangBarItemMgr_EnumItems,
+    LangBarItemMgr_GetItem,
+    LangBarItemMgr_AddItem,
+    LangBarItemMgr_RemoveItem,
+    LangBarItemMgr_AdviseItemSink,
+    LangBarItemMgr_UnadviseItemSink,
+    LangBarItemMgr_GetItemFloatingRect,
+    LangBarItemMgr_GetItemsStatus,
+    LangBarItemMgr_GetItemNum,
+    LangBarItemMgr_GetItems,
+    LangBarItemMgr_AdviseItemsSink,
+    LangBarItemMgr_UnadviseItemsSink,
+};
+
+/* the item manager of the calling thread */
+HRESULT LangBarItemMgr_GetForThread(ITfLangBarItemMgr **ret)
+{
+    DWORD tid = GetCurrentThreadId();
+    LangBarItemMgr *mgr;
+
+    EnterCriticalSection(&item_mgrs_cs);
+    LIST_FOR_EACH_ENTRY(mgr, &item_mgrs, LangBarItemMgr, entry)
+        if (mgr->threadId == tid) goto found;
+
+    if (!(mgr = calloc(1, sizeof(*mgr))))
+    {
+        LeaveCriticalSection(&item_mgrs_cs);
+        return E_OUTOFMEMORY;
+    }
+    mgr->threadId = tid;
+    mgr->ITfLangBarItemMgr_iface.lpVtbl = &LangBarItemMgrVtbl;
+    mgr->refCount = 1;                  /* the list's */
+    mgr->nextCookie = 1;
+    list_init(&mgr->items);
+    list_init(&mgr->sinks);
+    list_add_tail(&item_mgrs, &mgr->entry);
+
+found:
+    ITfLangBarItemMgr_AddRef((*ret = &mgr->ITfLangBarItemMgr_iface));
+    LeaveCriticalSection(&item_mgrs_cs);
+    return S_OK;
+}
