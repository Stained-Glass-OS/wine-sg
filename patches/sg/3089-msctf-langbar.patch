From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 19:03:15 -0700
Subject: [PATCH] msctf: language bar manager and per-thread language bar item
 manager

ITfLangBarMgr keeps event sinks (cookies, unadvise), the modal input sink and the floating
bar state, and hands out the calling thread's item manager and input processor profiles.
TF_CreateLangBarItemMgr, which failed, returns the item manager of the calling thread:
ITfLangBarItemMgr holds the added items (unique by item GUID), enumerates them, reports
their status and keeps item sinks.

diff --git a/dlls/msctf/langbarmgr.c b/dlls/msctf/langbarmgr.c
index cd21085..b24d841 100644
--- a/dlls/msctf/langbarmgr.c
+++ b/dlls/msctf/langbarmgr.c
@@ -21,22 +21,92 @@
 #define COBJMACROS
 
 #include "wine/debug.h"
+#include "wine/list.h"
 #include "winbase.h"
 #include "winreg.h"
 #include "shlwapi.h"
+#include "olectl.h"
 
 #include "msctf.h"
 #include "msctf_internal.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(msctf);
 
+#define TF_SFT_SHOWNORMAL 0x1
+#define TF_SFT_HIDDEN     0x8
+
+typedef struct tagLangBarSink {
+    struct list entry;
+    DWORD cookie;
+    IUnknown *sink;
+    HWND hwnd;
+    DWORD flags;
+} LangBarSink;
+
 typedef struct tagLangBarMgr {
     ITfLangBarMgr ITfLangBarMgr_iface;
 
     LONG refCount;
 
+    struct list eventSinks;
+    DWORD nextCookie;
+    ITfLangBarEventSink *modalSink;
+    DWORD modalThread;
+    DWORD floating;
 } LangBarMgr;
 
+typedef struct tagLangBarItem {
+    struct list entry;
+    ITfLangBarItem *item;
+    GUID guid;
+} LangBarItem;
+
+typedef struct tagItemSink {
+    struct list entry;
+    DWORD cookie;
+    ITfLangBarItemSink *sink;
+    GUID guid;
+} ItemSink;
+
+typedef struct tagLangBarItemMgr {
+    struct list entry;                  /* global list, one manager per thread */
+    DWORD threadId;
+    ITfLangBarItemMgr ITfLangBarItemMgr_iface;
+    LONG refCount;
+
+    struct list items;
+    struct list sinks;
+    DWORD nextCookie;
+} LangBarItemMgr;
+
+typedef struct tagEnumLangBarItems {
+    IEnumTfLangBarItems IEnumTfLangBarItems_iface;
+    LONG refCount;
+
+    ITfLangBarItem **items;
+    ULONG count, pos;
+} EnumLangBarItems;
+
+static struct list item_mgrs = LIST_INIT(item_mgrs);
+static CRITICAL_SECTION item_mgrs_cs;
+static CRITICAL_SECTION_DEBUG item_mgrs_cs_debug =
+{
+    0, 0, &item_mgrs_cs,
+    { &item_mgrs_cs_debug.ProcessLocksList, &item_mgrs_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": item_mgrs_cs") }
+};
+static CRITICAL_SECTION item_mgrs_cs = { &item_mgrs_cs_debug, -1, 0, 0, 0, 0 };
+
+static inline LangBarItemMgr *impl_from_ITfLangBarItemMgr(ITfLangBarItemMgr *iface)
+{
+    return CONTAINING_RECORD(iface, LangBarItemMgr, ITfLangBarItemMgr_iface);
+}
+
+static inline EnumLangBarItems *impl_from_IEnumTfLangBarItems(IEnumTfLangBarItems *iface)
+{
+    return CONTAINING_RECORD(iface, EnumLangBarItems, IEnumTfLangBarItems_iface);
+}
+
 static inline LangBarMgr *impl_from_ITfLangBarMgr(ITfLangBarMgr *iface)
 {
     return CONTAINING_RECORD(iface, LangBarMgr, ITfLangBarMgr_iface);
@@ -44,7 +114,17 @@ static inline LangBarMgr *impl_from_ITfLangBarMgr(ITfLangBarMgr *iface)
 
 static void LangBarMgr_Destructor(LangBarMgr *This)
 {
+    struct list *cursor, *cursor2;
+
     TRACE("destroying %p\n", This);
+    LIST_FOR_EACH_SAFE(cursor, cursor2, &This->eventSinks)
+    {
+        LangBarSink *sink = LIST_ENTRY(cursor, LangBarSink, entry);
+        list_remove(cursor);
+        IUnknown_Release(sink->sink);
