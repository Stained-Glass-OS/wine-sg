@@ -141,24 +273,36 @@ static HRESULT WINAPI LangBarMgr_SetModalInput( ITfLangBarMgr* iface, ITfLangBar
 {
     LangBarMgr *This = impl_from_ITfLangBarMgr(iface);
 
-    FIXME("STUB:(%p)\n",This);
-    return E_NOTIMPL;
+    TRACE("(%p) %p %lu %#lx\n", This, pSink, dwThreadId, dwFlags);
