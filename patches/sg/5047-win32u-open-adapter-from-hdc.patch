From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: Implement D3DKMTOpenAdapterFromHdc.

D3DKMTOpenAdapterFromHdc opens the adapter of the DC's display (its GPU
LUID, VidPnSourceId numbered as D3DKMTOpenAdapterFromGdiDisplayName does);
a desktop DC over several displays, a non-display DC or a zeroed
description fails with STATUS_INVALID_PARAMETER. It returned
STATUS_NO_MEMORY. Removes four todo_wine in the gdi32 driver test.

Gate: test/win32u-openadapterhdc-gate.sh (64/32, private Xvfb).
---
 dlls/gdi32/tests/driver.c    |  8 ++++----
 dlls/win32u/d3dkmt.c         | 29 ++++++++++++++++++++++++++++-
 dlls/win32u/sysparams.c      | 36 ++++++++++++++++++++++++++++++++++++
 dlls/win32u/win32u_private.h |  1 +
 4 files changed, 69 insertions(+), 5 deletions(-)

diff --git a/dlls/gdi32/tests/driver.c b/dlls/gdi32/tests/driver.c
index 3a7944e..df33b71 100644
--- a/dlls/gdi32/tests/driver.c
+++ b/dlls/gdi32/tests/driver.c
@@ -150,7 +150,7 @@ static void test_D3DKMTOpenAdapterFromHdc(void)
         win_skip("D3DKMTOpenAdapterFromHdc() is not supported.\n");
         return;
     }
-    todo_wine ok(status == STATUS_INVALID_PARAMETER, "Got unexpected return code %#lx.\n", status);
+    ok(status == STATUS_INVALID_PARAMETER, "Got unexpected return code %#lx.\n", status);
 
     /* Open adapter */
     for (i = 0; EnumDisplayDevicesW(NULL, i, &display_device, 0); ++i)
@@ -163,8 +163,8 @@ static void test_D3DKMTOpenAdapterFromHdc(void)
         hdc = CreateDCW(0, display_device.DeviceName, 0, NULL);
         open_adapter_hdc_desc.hDc = hdc;
         status = pD3DKMTOpenAdapterFromHdc(&open_adapter_hdc_desc);
-        todo_wine ok(status == STATUS_SUCCESS, "Got unexpected return code %#lx.\n", status);
-        todo_wine ok(open_adapter_hdc_desc.hAdapter, "Expect not null.\n");
+        ok(status == STATUS_SUCCESS, "Got unexpected return code %#lx.\n", status);
+        ok(open_adapter_hdc_desc.hAdapter, "Expect not null.\n");
         DeleteDC(hdc);
 
         if (status == STATUS_SUCCESS)
@@ -180,7 +180,7 @@ static void test_D3DKMTOpenAdapterFromHdc(void)
     open_adapter_hdc_desc.hDc = hdc;
     status = pD3DKMTOpenAdapterFromHdc(&open_adapter_hdc_desc);
     ReleaseDC(0, hdc);
-    todo_wine ok(status == (adapter_count > 1 ? STATUS_INVALID_PARAMETER : STATUS_SUCCESS),
+    ok(status == (adapter_count > 1 ? STATUS_INVALID_PARAMETER : STATUS_SUCCESS),
                  "Got unexpected return code %#lx.\n", status);
     if (status == STATUS_SUCCESS)
     {
diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
index 24a668a..331f17a 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -131,8 +131,35 @@ static struct d3dkmt_adapter *find_adapter_from_handle( D3DKMT_HANDLE handle )
  */
 NTSTATUS WINAPI NtGdiDdDDIOpenAdapterFromHdc( D3DKMT_OPENADAPTERFROMHDC *desc )
 {
-    FIXME( "(%p): stub\n", desc );
+    D3DKMT_OPENADAPTERFROMLUID desc_luid;
+    WCHAR display[CCHDEVICENAME];
+    UINT source_id;
+    NTSTATUS status;
+    BOOL is_display;
+    DC *dc;
+
+    TRACE( "(%p)\n", desc );
+
+#ifndef SG_MUTANT_OPENADAPTER_HDC_STUB
+    if (!desc || !desc->hDc || !(dc = get_dc_ptr( desc->hDc ))) return STATUS_INVALID_PARAMETER;
+    is_display = dc->is_display;
+    memcpy( display, dc->display, sizeof(display) );
+    release_dc_ptr( dc );
+
+    /* the adapter of the DC's display; a DC over several displays has none */
+    memset( &desc_luid, 0, sizeof(desc_luid) );
+    if (!is_display || !get_display_source_luid( display, &desc_luid.AdapterLuid, &source_id ))
+        return STATUS_INVALID_PARAMETER;
+    if ((status = NtGdiDdDDIOpenAdapterFromLuid( &desc_luid ))) return status;
+
+    desc->hAdapter = desc_luid.hAdapter;
+    desc->AdapterLuid = desc_luid.AdapterLuid;
+    desc->VidPnSourceId = source_id;
+    return STATUS_SUCCESS;
+#else
+    (void)desc_luid; (void)display; (void)source_id; (void)status; (void)is_display; (void)dc;
     return STATUS_NO_MEMORY;
+#endif
 }
 
 /******************************************************************************
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index a347ba1..497c269 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -3441,6 +3441,42 @@ static struct source *find_source_by_name( UNICODE_STRING *name )
     return NULL;
 }
 
+/* The GPU LUID and source id of the display named (\\.\DISPLAYn), or with no
+ * name of the one display attached to the desktop: FALSE if there is none or,
+ * without a name, more than one (D3DKMTOpenAdapterFromHdc). */
+BOOL get_display_source_luid( const WCHAR *name, LUID *luid, UINT *source_id )
+{
+    struct source *source, *found = NULL;
+    UNICODE_STRING str;
+    UINT count = 0;
+    BOOL ret = FALSE;
+
+    if (!lock_display_devices( FALSE )) return FALSE;
+    if (name && name[0])
+    {
+        RtlInitUnicodeString( &str, name );
+        if ((found = find_source_by_name( &str ))) count = 1;
+    }
+    else
+    {
+        LIST_FOR_EACH_ENTRY(source, &sources, struct source, entry)
+        {
+            if (!(source->state_flags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP)) continue;
+            found = source;
+            count++;
+        }
+    }
+    if (found && count == 1 && found->gpu)
+    {
+        *luid = found->gpu->luid;
+        /* numbered as d3dkmt_open_adapter_from_gdi_display_name does */
+        *source_id = found->id + 1;
+        ret = TRUE;
+    }
+    unlock_display_devices();
+    return ret;
+}
+
 /* Find and acquire the source matching name, or primary source if name is NULL.
  * If not NULL, the returned source needs to be released with source_release.
  */
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 1336b46..15960dd 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -224,6 +224,7 @@ extern void follow_display_scale( UINT dpi );
 extern BOOL system_dpi_follows_scale(void);
 extern void post_display_change(void);
 extern BOOL update_display_cache( BOOL force );
+extern BOOL get_display_source_luid( const WCHAR *name, LUID *luid, UINT *source_id );
 extern void reset_monitor_update_serial(void);
 extern void user_lock(void);
 extern void user_unlock(void);
