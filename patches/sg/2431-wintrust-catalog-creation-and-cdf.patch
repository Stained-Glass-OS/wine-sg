+struct cdf
+{
+    CRYPTCATCDF pub;        /* what callers may look at, first */
+    char       *text;       /* the definition file, with a terminating zero */
+    DWORD       size;
+    HANDLE      catalog;
+    DWORD       next_attr;  /* the next CATATTRn / [CatalogFiles] entry to hand out */
