+
+/* the next line of an INI text: no terminator, surrounding blanks gone; FALSE at the end */
+static BOOL ini_line(const char **pos, const char *end, const char **line, DWORD *len)
+{
+    const char *p = *pos, *e;
+
+    while (p < end && (*p == '\r' || *p == '\n')) p++;
+    if (p >= end) return FALSE;
+    e = p;
+    while (e < end && *e != '\r' && *e != '\n') e++;
+    *pos = e;
+    while (p < e && (*p == ' ' || *p == '\t')) p++;
+    while (e > p && (e[-1] == ' ' || e[-1] == '\t')) e--;
+    *line = p;
+    *len = e - p;
+    return TRUE;
+}
+
+static BOOL ini_is_section(const char *line, DWORD len, const char *name)
+{
+    DWORD n = strlen(name);
+
+    return len == n + 2 && line[0] == '[' && line[len - 1] == ']' && !_strnicmp(line + 1, name, n);
+}
+
+static BOOL ini_has_section(const struct cdf *cdf, const char *section)
+{
+    const char *pos = cdf->text, *end = cdf->text + cdf->size, *line;
+    DWORD len;
+
+    while (ini_line(&pos, end, &line, &len))
+        if (ini_is_section(line, len, section)) return TRUE;
     return FALSE;
 }
 
+/* the index'th "key=value" of a section; index -1 means the first with the given key name */
+static char *ini_entry(const struct cdf *cdf, const char *section, const char *key, int index, char **found_key)
+{
+    const char *pos = cdf->text, *end = cdf->text + cdf->size, *line;
+    DWORD len, klen = key ? strlen(key) : 0;
+    BOOL in_section = FALSE;
+    int n = 0;
+
+    while (ini_line(&pos, end, &line, &len))
+    {
+        const char *eq, *k_end, *v;
+        char *value;
+
+        if (line[0] == '[')
+        {
+            in_section = ini_is_section(line, len, section);
+            continue;
+        }
+        if (!in_section || line[0] == ';') continue;
+        if (!(eq = memchr(line, '=', len))) continue;
+        k_end = eq;
+        while (k_end > line && (k_end[-1] == ' ' || k_end[-1] == '\t')) k_end--;
+        if (key && (k_end - line != klen || _strnicmp(line, key, klen))) continue;
+        if (!key && n++ != index) continue;
+        v = eq + 1;
+        while (v < line + len && (*v == ' ' || *v == '\t')) v++;
+        if (!(value = malloc(line + len - v + 1))) return NULL;
+        memcpy(value, v, line + len - v);
+        value[line + len - v] = 0;
+        if (found_key)
+        {
+            *found_key = malloc(k_end - line + 1);
+            if (*found_key)
+            {
+                memcpy(*found_key, line, k_end - line);
+                (*found_key)[k_end - line] = 0;
+            }
+        }
+        return value;
+    }
+    return NULL;
+}
+
+static WCHAR *ansi_to_wide(const char *str)
+{
+    int len = MultiByteToWideChar(CP_ACP, 0, str, -1, NULL, 0);
+    WCHAR *ret = malloc(len * sizeof(WCHAR));
+
+    if (ret) MultiByteToWideChar(CP_ACP, 0, str, -1, ret, len);
+    return ret;
+}
+
+static void cdf_error(PFN_CDF_PARSE_ERROR_CALLBACK cb, DWORD area, DWORD error, const char *text)
+{
+    WCHAR *wide;
+
+#ifdef SG_MUTANT_CDF_NOCB
+    return;
+#endif
+    if (!cb) return;
+    wide = text ? ansi_to_wide(text) : NULL;
+    cb(area, error, wide);
+    free(wide);
+}
