+static BOOL writable_catalog(HANDLE h)
+{
+    struct cryptcat *cc = h;
+
+    if (!valid_catalog_handle(h))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!cc->writable)
+    {
+        SetLastError(ERROR_ACCESS_DENIED);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static CRYPTCATATTRIBUTE *alloc_attribute(const WCHAR *name, DWORD type, DWORD size, const BYTE *data, DWORD index)
+{
+    DWORD name_len = (lstrlenW(name) + 1) * sizeof(WCHAR);
+    CRYPTCATATTRIBUTE *attr;
+
+    if (!(attr = calloc(1, sizeof(*attr) + name_len + size))) return NULL;
+    attr->cbStruct            = sizeof(*attr);
+    attr->pwszReferenceTag    = (WCHAR *)(attr + 1);
+    memcpy(attr->pwszReferenceTag, name, name_len);
+    attr->dwAttrTypeAndAction = type;
+    attr->cbValue             = size;
+    attr->pbValue             = (BYTE *)attr->pwszReferenceTag + name_len;
+    if (size) memcpy(attr->pbValue, data, size);
+    attr->dwReserved          = index;
+    return attr;
+}
+
+static BOOL add_pointer(void ***array, DWORD *count, void *item)
+{
+    void **new = realloc(*array, (*count + 1) * sizeof(*new));
+
+    if (!new) return FALSE;
+    new[(*count)++] = item;
+    *array = new;
+    return TRUE;
+}
+
+static struct wmember *find_wmember(struct cryptcat *cc, const CRYPTCATMEMBER *member)
+{
+    DWORD i;
+
+    for (i = 0; member && i < cc->wmember_count; i++)
+        if (&cc->wmembers[i]->pub == member) return cc->wmembers[i];
+    return NULL;
+}
+
+static void free_write_model(struct cryptcat *cc)
+{
+    DWORD i, j;
+
+    for (i = 0; i < cc->wattr_count; i++) free(cc->wattrs[i]);
+    free(cc->wattrs);
+    for (i = 0; i < cc->wmember_count; i++)
+    {
+        struct wmember *m = cc->wmembers[i];
+
+        for (j = 0; j < m->attr_count; j++) free(m->attrs[j]);
+        free(m->attrs);
+        free(m->pub.pwszReferenceTag);
+        free(m->pub.pwszFileName);
+        free(m->pub.pIndirectData);
+        free(m->pub.sEncodedIndirectData.pbData);
+        free(m->pub.sEncodedMemberInfo.pbData);
+        free(m);
+    }
+    free(cc->wmembers);
+    free(cc->file);
+}
