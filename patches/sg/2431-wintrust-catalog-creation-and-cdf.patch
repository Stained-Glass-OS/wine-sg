+/***********************************************************************
+ *      CryptCATCDFOpen  (WINTRUST.@)
+ */
+CRYPTCATCDF * WINAPI CryptCATCDFOpen(LPWSTR pwszFilePath, PFN_CDF_PARSE_ERROR_CALLBACK pfnParseError)
+{
+    struct cdf *cdf;
+    HANDLE file;
+    LARGE_INTEGER size;
+    DWORD read;
+    char *name, *dir, *version, *encoding;
+    WCHAR *cat_path;
+    DWORD cat_version = 1, cat_encoding = 0;
+
+    TRACE("(%s %p)\n", debugstr_w(pwszFilePath), pfnParseError);
+
+    if (!pwszFilePath)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    file = CreateFileW(pwszFilePath, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                       FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+
+    if (!(cdf = calloc(1, sizeof(*cdf))))
+    {
+        CloseHandle(file);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return NULL;
+    }
+    if (!GetFileSizeEx(file, &size) || size.QuadPart > 0x7fffffff || !(cdf->text = malloc(size.u.LowPart + 1)) ||
+        !ReadFile(file, cdf->text, size.u.LowPart, &read, NULL) || read != size.u.LowPart)
+    {
+        DWORD err = GetLastError();
+        CloseHandle(file);
+        free(cdf->text);
+        free(cdf);
+        SetLastError(err ? err : ERROR_OUTOFMEMORY);
+        return NULL;
+    }
+    CloseHandle(file);
+    cdf->text[read] = 0;
+    cdf->size = read;
+
+    if (!ini_has_section(cdf, "CatalogHeader"))
+    {
+        cdf_error(pfnParseError, CRYPTCAT_E_AREA_HEADER, CRYPTCAT_E_CDF_TAGNOTFOUND, NULL);
+        goto fail_success;
+    }
+
+    /* without a name the catalog cannot be created: that is what the error is on Windows */
+    name = ini_entry(cdf, "CatalogHeader", "Name", 0, NULL);
+    if (!name || !*name)
+    {
+        free(name);
+        free(cdf->text);
+        free(cdf);
+#ifndef SG_MUTANT_CDF_SHARING
+        SetLastError(ERROR_SHARING_VIOLATION);
+#else
+        SetLastError(ERROR_INVALID_PARAMETER);
+#endif
+        return NULL;
+    }
+    dir      = ini_entry(cdf, "CatalogHeader", "ResultDir", 0, NULL);
+    version  = ini_entry(cdf, "CatalogHeader", "PublicVersion", 0, NULL);
+    encoding = ini_entry(cdf, "CatalogHeader", "EncodingType", 0, NULL);
+    if (version && *version) cat_version = strtoul(version, NULL, 0);
+    if (encoding && *encoding) cat_encoding = strtoul(encoding, NULL, 0);
+    free(version);
+    free(encoding);
+
+    {
+        size_t dir_len = dir ? strlen(dir) : 0;
+        char *full = malloc(dir_len + strlen(name) + 2);
+
+        if (full)
+        {
+            strcpy(full, dir ? dir : "");
+            if (dir_len && dir[dir_len - 1] != '\\' && dir[dir_len - 1] != '/') strcat(full, "\\");
+            strcat(full, name);
+        }
+        cat_path = full ? ansi_to_wide(full) : NULL;
+        free(full);
+    }
+    free(dir);
+    free(name);
+    if (!cat_path)
+    {
+        free(cdf->text);
+        free(cdf);
+        SetLastError(ERROR_OUTOFMEMORY);
+        return NULL;
+    }
+
+    cdf->catalog = CryptCATOpen(cat_path, CRYPTCAT_OPEN_CREATENEW, 0, cat_version, cat_encoding);
+    if (cdf->catalog == INVALID_HANDLE_VALUE)
+    {
+        DWORD err = GetLastError();
+        free(cat_path);
+        free(cdf->text);
+        free(cdf);
+        SetLastError(err);
+        return NULL;
+    }
+    cdf->pub.cbStruct     = sizeof(cdf->pub);
+    cdf->pub.hCATStore    = cdf->catalog;
+    cdf->pub.pwszResultDir = cat_path;
+    SetLastError(ERROR_SUCCESS);
+    return &cdf->pub;
+
+fail_success:
+    free(cdf->text);
+    free(cdf);
+    SetLastError(ERROR_SUCCESS);
+    return NULL;
+}
 
