+/* the Authenticode digest of a PE image: everything but the checksum, the certificate table entry
+ * and the certificate table itself, with the sections in file order */
+static BOOL hash_pe_image(HCRYPTHASH hash, const BYTE *data, DWORD size)
+{
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)data;
+    DWORD nt, opt, checksum_off, cert_off, headers, sum, i, j, n, cert_size = 0;
+    const IMAGE_FILE_HEADER *file;
+    const IMAGE_SECTION_HEADER **sorted, *sections;
+    BOOL ret = FALSE, pe64;
+
+    if (size < sizeof(*dos) || dos->e_magic != IMAGE_DOS_SIGNATURE) return FALSE;
+    nt = dos->e_lfanew;
+    if (nt > size || size - nt < 4 + sizeof(IMAGE_FILE_HEADER) + 96 || *(const DWORD *)(data + nt) != IMAGE_NT_SIGNATURE)
+        return FALSE;
+    file = (const IMAGE_FILE_HEADER *)(data + nt + 4);
+    opt = nt + 4 + sizeof(*file);
+    pe64 = *(const WORD *)(data + opt) == IMAGE_NT_OPTIONAL_HDR64_MAGIC;
+    if (!pe64 && *(const WORD *)(data + opt) != IMAGE_NT_OPTIONAL_HDR32_MAGIC) return FALSE;
+    checksum_off = opt + 64;
+    cert_off     = opt + (pe64 ? 112 : 96) + 4 * 8;
+    if (cert_off + 8 > size || opt + file->SizeOfOptionalHeader > size) return FALSE;
+    headers = *(const DWORD *)(data + opt + 60);
+    if (headers > size || headers < cert_off + 8) return FALSE;
+    cert_size = *(const DWORD *)(data + cert_off + 4);
+
+    if (!hash_data(hash, data, checksum_off) ||
+        !hash_data(hash, data + checksum_off + 4, cert_off - (checksum_off + 4)) ||
+        !hash_data(hash, data + cert_off + 8, headers - (cert_off + 8)))
+        return FALSE;
+    sum = headers;
+
+    n = file->NumberOfSections;
+    sections = (const IMAGE_SECTION_HEADER *)(data + opt + file->SizeOfOptionalHeader);
+    if ((BYTE *)(sections + n) > data + size) return FALSE;
+    if (!(sorted = malloc((n ? n : 1) * sizeof(*sorted)))) return FALSE;
+    for (i = 0; i < n; i++)
+    {
+        for (j = i; j > 0 && sorted[j - 1]->PointerToRawData > sections[i].PointerToRawData; j--)
+            sorted[j] = sorted[j - 1];
+        sorted[j] = &sections[i];
+    }
+    ret = TRUE;
+    for (i = 0; i < n && ret; i++)
+    {
+        DWORD start = sorted[i]->PointerToRawData, len = sorted[i]->SizeOfRawData;
+
+        if (!len) continue;
+        if (start > size) start = size;
+        if (len > size - start) len = size - start;
+        ret = hash_data(hash, data + start, len);
+        sum += len;
+    }
+    free(sorted);
+    if (ret && size > sum)
+    {
+        DWORD extra = size - sum;
+
+        if (cert_size < extra) extra -= cert_size; else extra = 0;
+        ret = hash_data(hash, data + sum, extra);
+    }
+    return ret;
+}
+
+static BOOL read_subject_file(SIP_SUBJECTINFO *info, BYTE **data, DWORD *size)
+{
+    HANDLE file = info->hFile;
+    LARGE_INTEGER len;
+    BOOL ret = FALSE, own = FALSE;
+    DWORD read;
+
+    if (!file || file == INVALID_HANDLE_VALUE)
+    {
+        if (!info->pwsFileName)
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        file = CreateFileW(info->pwsFileName, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                           OPEN_EXISTING, 0, NULL);
+        if (file == INVALID_HANDLE_VALUE) return FALSE;
+        own = TRUE;
+    }
+    if (GetFileSizeEx(file, &len) && len.QuadPart <= 0x7fffffff && (*data = malloc(len.u.LowPart + 1)))
+    {
+        if (SetFilePointer(file, 0, NULL, FILE_BEGIN) != INVALID_SET_FILE_POINTER &&
+            ReadFile(file, *data, len.u.LowPart, &read, NULL) && read == len.u.LowPart)
+        {
+            *size = read;
+            ret = TRUE;
+        }
+        else free(*data);
+    }
+    if (own) CloseHandle(file);
+    return ret;
+}
