+/* the attributes of an entry or the extensions of the list, in the order they are written: the reverse
+ * of the order they were added in */
+static BOOL encode_name_value(const CRYPTCATATTRIBUTE *attr, CRYPT_DATA_BLOB *out)
+{
+    CAT_NAMEVALUE nv;
+
+    nv.pwszTag      = attr->pwszReferenceTag;
+    nv.fdwFlags     = attr->dwAttrTypeAndAction;
+    nv.Value.cbData = attr->cbValue;
+    nv.Value.pbData = attr->pbValue;
+    out->pbData = encode_object(WVTAsn1CatNameValueEncode, CAT_NAMEVALUE_OBJID, &nv, &out->cbData);
+    return out->pbData != NULL;
+}
