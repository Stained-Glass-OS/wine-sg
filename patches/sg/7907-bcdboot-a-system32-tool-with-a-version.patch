From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcdboot: a system32 tool with a version.

Windows always has bcdboot.exe in system32, and programs look for it: Rufus reads
its version (GetExecutableVersion on %windir%\sysnative\bcdboot.exe, then
version_to_uint64 with no NULL check) to know which options it takes, and with no
such file it crashed at start with a read at address 2. bcdboot.exe is a program
here, with a version resource (10.0.19041, without the 26100 /bootex options); run,
it answers as Windows' does when it cannot copy boot files, exit code 1: the
machine starts through Linux's boot loader, there are no Windows boot files to
put in a system partition.
---
diff --git a/configure b/configure
index 0c0029b..a7f6052 100755
--- a/configure
+++ b/configure
@@ -1688,6 +1688,7 @@ enable_arp
 enable_aspnet_regiis
 enable_attrib
 enable_bash
+enable_bcdboot
 enable_cabarc
 enable_cacls
 enable_calc
@@ -23179,6 +23180,7 @@ wine_fn_config_makefile programs/arp enable_arp
 wine_fn_config_makefile programs/aspnet_regiis enable_aspnet_regiis
 wine_fn_config_makefile programs/attrib enable_attrib
 wine_fn_config_makefile programs/bash enable_bash
+wine_fn_config_makefile programs/bcdboot enable_bcdboot
 wine_fn_config_makefile programs/cabarc enable_cabarc
 wine_fn_config_makefile programs/cacls enable_cacls
 wine_fn_config_makefile programs/calc enable_calc
diff --git a/configure.ac b/configure.ac
index 26ef1c4..c52681b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3470,6 +3470,7 @@ WINE_CONFIG_MAKEFILE(programs/arp)
 WINE_CONFIG_MAKEFILE(programs/aspnet_regiis)
 WINE_CONFIG_MAKEFILE(programs/attrib)
 WINE_CONFIG_MAKEFILE(programs/bash)
+WINE_CONFIG_MAKEFILE(programs/bcdboot)
 WINE_CONFIG_MAKEFILE(programs/cabarc)
 WINE_CONFIG_MAKEFILE(programs/cacls)
 WINE_CONFIG_MAKEFILE(programs/calc)
diff --git a/programs/bcdboot/Makefile.in b/programs/bcdboot/Makefile.in
new file mode 100644
index 0000000..9cb70d6
--- /dev/null
+++ b/programs/bcdboot/Makefile.in
@@ -0,0 +1,7 @@
+MODULE    = bcdboot.exe
+
+EXTRADLLFLAGS = -mconsole -municode
+
+SOURCES = \
+	main.c \
+	version.rc
diff --git a/programs/bcdboot/main.c b/programs/bcdboot/main.c
new file mode 100644
index 0000000..1af7618
--- /dev/null
+++ b/programs/bcdboot/main.c
@@ -0,0 +1,45 @@
+/*
+ * bcdboot -- the boot files setup tool
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Windows always has bcdboot.exe in system32, and programs look for it: Rufus reads its version
+ * to know which options it takes, and ended with a NULL read when there was none. The machine's
+ * boot loader is Linux's here, so there are no Windows boot files to copy into a system
+ * partition: the tool answers as Windows' does when it cannot copy them, with exit code 1.
+ */
+
+#include <stdio.h>
+#include <windows.h>
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    int i;
+
+    for (i = 1; i < argc; i++)
+    {
+        if (!wcscmp( argv[i], L"/?" ) || !wcscmp( argv[i], L"-?" ))
+        {
+            printf( "bcdboot <source> [/l <locale>] [/s <volume-letter> [/f <firmware>]] [/v] [/m [{OS Loader ID}]]\n"
+                    "Copies the boot files of the installation in <source> to a system partition.\n"
+                    "This computer starts through its own boot loader: there are no boot files to copy.\n" );
+            return 0;
+        }
+    }
+    printf( "Failure when attempting to copy boot files.\n" );
+    return 1;
+}
diff --git a/programs/bcdboot/version.rc b/programs/bcdboot/version.rc
new file mode 100644
index 0000000..791d94e
--- /dev/null
+++ b/programs/bcdboot/version.rc
@@ -0,0 +1,29 @@
+/*
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define WINE_FILEDESCRIPTION_STR "Boot files setup"
+#define WINE_FILENAME_STR "bcdboot.exe"
+#define WINE_FILETYPE VFT_APP
+#define WINE_FILEVERSION 10,0,19041,1
+#define WINE_FILEVERSION_STR "10.0.19041.1"
+#define WINE_PRODUCTVERSION 10,0,19041,1
+#define WINE_PRODUCTVERSION_STR "10.0.19041.1"
+
+#ifndef SG_MUTANT_BCDBOOT_NO_VERSION
+#include "wine/wine_common_ver.rc"
+#endif
