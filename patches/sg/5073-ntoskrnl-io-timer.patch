From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntoskrnl.exe: Implement IoInitializeTimer, IoStartTimer and IoStopTimer.

IoInitializeTimer sets up a device's IoTimer routine (it returned
STATUS_NOT_IMPLEMENTED), IoStartTimer has it called once a second with the
device and the context, IoStopTimer stops the calls (waiting for one under
way, unless the routine itself stops the timer). IoDeleteDevice frees the
timer. PIO_TIMER_ROUTINE in ddk/wdm.h becomes the routine's type.

Gate: test/ntoskrnl-iotimer-gate.sh (a probe driver; 64-bit, a WoW64 host skips).
---
 dlls/ntoskrnl.exe/ntoskrnl.c | 74 +++++++++++++++++++++++++++++++++++++++++---
 include/ddk/wdm.h            |  2 +-
 2 files changed, 71 insertions(+), 5 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 0c4215f..93ad7dd 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1167,6 +1167,25 @@ void WINAPI IoReuseIrp(IRP *irp, NTSTATUS iostatus)
     irp->IoStatus.Status = iostatus;
 }
 
+/* a device's IoTimer routine, called once a second while started */
+struct _IO_TIMER
+{
+    TP_TIMER *tp;
+    PIO_TIMER_ROUTINE routine;
+    void *context;
+    DEVICE_OBJECT *device;
+    DWORD calling_thread;   /* the thread running the routine, 0 when none */
+};
+
+static void CALLBACK io_timer_proc( TP_CALLBACK_INSTANCE *instance, void *arg, TP_TIMER *tp )
+{
+    struct _IO_TIMER *timer = arg;
+
+    timer->calling_thread = GetCurrentThreadId();
+    timer->routine( timer->device, timer->context );
+    timer->calling_thread = 0;
+}
+
 /***********************************************************************
  *           IoInitializeTimer   (NTOSKRNL.EXE.@)
  */
@@ -1174,8 +1193,24 @@ NTSTATUS WINAPI IoInitializeTimer(PDEVICE_OBJECT DeviceObject,
                                   PIO_TIMER_ROUTINE TimerRoutine,
                                   PVOID Context)
 {
-    FIXME( "stub: %p, %p, %p\n", DeviceObject, TimerRoutine, Context );
-    return STATUS_NOT_IMPLEMENTED;
+    struct _IO_TIMER *timer = DeviceObject->Timer;
+
+    TRACE( "%p, %p, %p\n", DeviceObject, TimerRoutine, Context );
+
+    if (!timer)
+    {
+        if (!(timer = calloc( 1, sizeof(*timer) ))) return STATUS_INSUFFICIENT_RESOURCES;
+        if (!(timer->tp = CreateThreadpoolTimer( io_timer_proc, timer, NULL )))
+        {
+            free( timer );
+            return STATUS_INSUFFICIENT_RESOURCES;
+        }
+        timer->device = DeviceObject;
+        DeviceObject->Timer = timer;
+    }
+    timer->routine = TimerRoutine;
+    timer->context = Context;
+    return STATUS_SUCCESS;
 }
 
 
@@ -1184,7 +1219,18 @@ NTSTATUS WINAPI IoInitializeTimer(PDEVICE_OBJECT DeviceObject,
  */
 void WINAPI IoStartTimer(PDEVICE_OBJECT DeviceObject)
 {
-    FIXME( "stub: %p\n", DeviceObject );
+    struct _IO_TIMER *timer = DeviceObject->Timer;
+    LARGE_INTEGER due;
+
+    TRACE( "%p\n", DeviceObject );
+
+    if (!timer) return;
+    due.QuadPart = -10000000;   /* once a second, the first a second from now */
+#ifndef SG_MUTANT_IOTIMER_ONCE
+    SetThreadpoolTimer( timer->tp, (FILETIME *)&due, 1000, 0 );
+#else
+    SetThreadpoolTimer( timer->tp, (FILETIME *)&due, 0, 0 );
+#endif
 }
 
 
@@ -1193,7 +1239,26 @@ void WINAPI IoStartTimer(PDEVICE_OBJECT DeviceObject)
  */
 void WINAPI IoStopTimer(PDEVICE_OBJECT DeviceObject)
 {
-    FIXME( "stub: %p\n", DeviceObject );
+    struct _IO_TIMER *timer = DeviceObject->Timer;
+
+    TRACE( "%p\n", DeviceObject );
+
+    if (!timer) return;
+    SetThreadpoolTimer( timer->tp, NULL, 0, 0 );
+    /* a call under way finishes first, unless it is the one stopping the timer */
+    if (timer->calling_thread != GetCurrentThreadId())
+        WaitForThreadpoolTimerCallbacks( timer->tp, TRUE );
+}
+
+static void free_io_timer( DEVICE_OBJECT *device )
+{
+    struct _IO_TIMER *timer = device->Timer;
+
+    if (!timer) return;
+    IoStopTimer( device );
+    CloseThreadpoolTimer( timer->tp );
+    free( timer );
+    device->Timer = NULL;
 }
 
 
@@ -1776,6 +1841,7 @@ void WINAPI IoDeleteDevice( DEVICE_OBJECT *device )
         DEVICE_RELATIONS *children;
         unsigned int i;
 
+        free_io_timer( device );
         while (*prev && *prev != device) prev = &(*prev)->NextDevice;
         if (*prev) *prev = (*prev)->NextDevice;
         if ((children = wine_device->children))
diff --git a/include/ddk/wdm.h b/include/ddk/wdm.h
index 2ea6a81..edf0ae9 100644
--- a/include/ddk/wdm.h
+++ b/include/ddk/wdm.h
@@ -229,7 +229,7 @@ typedef struct _ERESOURCE
 } ERESOURCE, *PERESOURCE;
 
 typedef struct _IO_TIMER *PIO_TIMER;
-typedef struct _IO_TIMER_ROUTINE *PIO_TIMER_ROUTINE;
+typedef VOID (WINAPI *PIO_TIMER_ROUTINE)(struct _DEVICE_OBJECT *,PVOID);
 typedef struct _ETHREAD *PETHREAD;
 typedef struct _KTHREAD *PKTHREAD, *PRKTHREAD;
 typedef struct _EPROCESS *PEPROCESS;
