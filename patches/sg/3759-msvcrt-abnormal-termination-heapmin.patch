From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt, ntdll: _abnormal_termination, _heapmin and RtlCompactHeap (3759)

_abnormal_termination was a stub that always said "normal" and _heapmin
failed (-1) whenever HeapCompact returned 0, which the RtlCompactHeap stub
always did. _abnormal_termination now tells whether a __finally block runs
because its __try was left abnormally (on i386 from msvcrt's local unwind,
elsewhere from the unwinder in ntdll), RtlCompactHeap reports the largest free
block of the heap, and _heapmin returns 0 unless HeapCompact fails with an
error. CORE review (patches/notes/3759.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---
diff --git a/dlls/msvcrt/except.c b/dlls/msvcrt/except.c
index 50f131e..5a6c05b 100644
--- a/dlls/msvcrt/except.c
+++ b/dlls/msvcrt/except.c
@@ -809,10 +809,26 @@ unsigned int CDECL __CxxQueryExceptionSize(void)
 /*********************************************************************
  *		_abnormal_termination (MSVCRT.@)
  */
+#ifdef __i386__
+BOOL msvcrt_in_local_unwind(void);   /* except_i386.c */
+#endif
+
 int CDECL __intrinsic_abnormal_termination(void)
 {
-  FIXME("(void)stub\n");
-  return 0;
+    /* Stained Glass OS: called by the code of a __finally block, this tells whether the block runs
+     * because the __try body was left abnormally (an exception, a return or goto out of it) and not
+     * by falling off its end.  An abnormal termination runs the block from the unwinder: on i386
+     * msvcrt's _local_unwind2 / _local_unwind4 with their nested handler registered; elsewhere the
+     * unwinder is ntdll's (__C_specific_handler), the caller of the block's funclet. */
+#ifdef __i386__
+    return msvcrt_in_local_unwind();
+#else
+    void *frames[2];
+    void *base;
+
+    if (RtlCaptureStackBackTrace( 1, 2, frames, NULL ) < 2) return 0;
+    return RtlPcToFileHeader( frames[1], &base ) && base == GetModuleHandleW( L"ntdll.dll" );
+#endif
 }
 
 /******************************************************************
diff --git a/dlls/msvcrt/except_i386.c b/dlls/msvcrt/except_i386.c
index 7d1faa9..2ac9e15 100644
--- a/dlls/msvcrt/except_i386.c
+++ b/dlls/msvcrt/except_i386.c
@@ -494,6 +494,14 @@ static DWORD MSVCRT_nested_handler(PEXCEPTION_RECORD rec,
   return ExceptionCollidedUnwind;
 }
 
+/* is the code running from a local unwind (a __finally block of an abnormal termination)? */
+BOOL msvcrt_in_local_unwind(void)
+{
+    const EXCEPTION_REGISTRATION_RECORD *reg = NtCurrentTeb()->Tib.ExceptionList;
+
+    return reg && reg != (void *)~0 && reg->Handler == MSVCRT_nested_handler;
+}
+
 static void msvcrt_local_unwind2(MSVCRT_EXCEPTION_FRAME* frame, int trylevel, void *ebp)
 {
   EXCEPTION_REGISTRATION_RECORD reg;
diff --git a/dlls/msvcrt/heap.c b/dlls/msvcrt/heap.c
index 70e4ecb..fdf5080 100644
--- a/dlls/msvcrt/heap.c
+++ b/dlls/msvcrt/heap.c
@@ -257,8 +257,10 @@ int CDECL _heapchk(void)
  */
 int CDECL _heapmin(void)
 {
-  if (!HeapCompact( heap, 0 ) ||
-          (sb_heap && !HeapCompact( sb_heap, 0 )))
+  /* HeapCompact returns the largest free block: 0 is a failure only when it sets an error */
+  SetLastError( ERROR_SUCCESS );
+  if ((!HeapCompact( heap, 0 ) && GetLastError()) ||
+          (sb_heap && !HeapCompact( sb_heap, 0 ) && GetLastError()))
   {
     if (GetLastError() != ERROR_CALL_NOT_IMPLEMENTED)
       msvcrt_set_errno(GetLastError());
diff --git a/dlls/ntdll/heap.c b/dlls/ntdll/heap.c
index 696e129..d1db4c1 100644
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -2270,16 +2270,45 @@ void *WINAPI RtlReAllocateHeap( HANDLE handle, ULONG flags, void *ptr, SIZE_T si
  *  flags [I] HEAP_ flags from "winnt.h"
  *
  * RETURNS
- *  The number of bytes compacted.
+ *  The size of the largest committed free block, 0 if there is none (or the heap is invalid:
+ *  the last error says which).
  *
  * NOTES
- *  This function is a harmless stub.
+ *  Stained Glass OS: free blocks are merged with their neighbours as they are freed, and
+ *  a free tail of a sub heap is decommitted then, so there is nothing left to move; the
+ *  call reports what is available.
  */
 ULONG WINAPI RtlCompactHeap( HANDLE handle, ULONG flags )
 {
-    static BOOL reported;
-    if (!reported++) FIXME( "handle %p, flags %#lx stub!\n", handle, flags );
-    return 0;
+    const struct block *block;
+    const SUBHEAP *subheap;
+    SIZE_T largest = 0;
+    struct heap *heap;
+    ULONG heap_flags;
+
+    if (!(heap = unsafe_heap_from_handle( handle, flags, &heap_flags )))
+    {
+        RtlSetLastWin32ErrorAndNtStatusFromNtStatus( STATUS_INVALID_HANDLE );
+        return 0;
+    }
+    heap_lock( heap, heap_flags );
+    LIST_FOR_EACH_ENTRY( subheap, &heap->subheap_list, SUBHEAP, entry )
+    {
+        for (block = first_block( subheap ); block; block = next_block( subheap, block ))
+        {
+            SIZE_T size;
+
+            if (!(block_get_flags( block ) & BLOCK_FLAG_FREE)) continue;
+            size = block_get_size( block ) - sizeof(*block);
+            /* only what is committed can be used at once */
+            if ((const char *)block + block_get_size( block ) <= (const char *)subheap_base( subheap ) + subheap_size( subheap ) &&
+                size > largest) largest = size;
+        }
+    }
+    heap_unlock( heap, heap_flags );
+    RtlSetLastWin32Error( ERROR_SUCCESS );   /* 0 with no error: no free block */
+    TRACE( "handle %p, flags %#lx, return %#Ix\n", handle, flags, largest );
+    return largest > ~0u ? ~0u : largest;
 }
 
 
