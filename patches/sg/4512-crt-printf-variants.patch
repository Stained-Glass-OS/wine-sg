+#if _MSVCR_VER>=80
+/* the console printf of the _p (positional parameters) and _s (checked)
+ * variants: the options as vfprintf_helper takes them */
+static int vcprintf_helper(DWORD options, const char *format, _locale_t locale, va_list valist)
+{
+    printf_arg args_ctx[_ARGMAX+1];
+    int ret;
+
+    if (!MSVCRT_CHECK_PMT(format != NULL)) return -1;
+    if (options & MSVCRT_PRINTF_POSITIONAL_PARAMS)
+    {
+        memset(args_ctx, 0, sizeof(args_ctx));
+        ret = create_positional_ctx_a(args_ctx, format, valist);
+        if (ret < 0)
+        {
+            _invalid_parameter(NULL, NULL, NULL, 0, 0);
+            *_errno() = EINVAL;
+            return ret;
+        }
+        else if (!ret)
+            options &= ~MSVCRT_PRINTF_POSITIONAL_PARAMS;
+    }
+    return pf_printf_a(puts_clbk_console_a, NULL, format, locale, options,
+            options & MSVCRT_PRINTF_POSITIONAL_PARAMS ? arg_clbk_positional : arg_clbk_valist,
+            options & MSVCRT_PRINTF_POSITIONAL_PARAMS ? args_ctx : NULL, &valist);
+}
+
+static int vcwprintf_helper(DWORD options, const wchar_t *format, _locale_t locale, va_list valist)
+{
+    printf_arg args_ctx[_ARGMAX+1];
+    int ret;
+
+    if (!MSVCRT_CHECK_PMT(format != NULL)) return -1;
+    if (options & MSVCRT_PRINTF_POSITIONAL_PARAMS)
+    {
+        memset(args_ctx, 0, sizeof(args_ctx));
+        ret = create_positional_ctx_w(args_ctx, format, valist);
+        if (ret < 0)
+        {
+            _invalid_parameter(NULL, NULL, NULL, 0, 0);
+            *_errno() = EINVAL;
+            return ret;
+        }
+        else if (!ret)
+            options &= ~MSVCRT_PRINTF_POSITIONAL_PARAMS;
+    }
+    return pf_printf_w(puts_clbk_console_w, NULL, format, locale, options,
+            options & MSVCRT_PRINTF_POSITIONAL_PARAMS ? arg_clbk_positional : arg_clbk_valist,
+            options & MSVCRT_PRINTF_POSITIONAL_PARAMS ? args_ctx : NULL, &valist);
+}
+
+#define CPRINTF_P (MSVCRT_PRINTF_POSITIONAL_PARAMS | MSVCRT_PRINTF_INVOKE_INVALID_PARAM_HANDLER)
+#ifndef SG_MUTANT_CPRINTF_P_NOT_POSITIONAL
+#define CPRINTF_P_OPTIONS CPRINTF_P
+#else
+#define CPRINTF_P_OPTIONS MSVCRT_PRINTF_INVOKE_INVALID_PARAM_HANDLER
+#endif
+#define CPRINTF_S MSVCRT_PRINTF_INVOKE_INVALID_PARAM_HANDLER
+#endif
+
+#if _MSVCR_VER>=80 && _MSVCR_VER<=120
+/*********************************************************************
+ *		_vcprintf_p_l (MSVCR80.@)
+ */
+int CDECL _vcprintf_p_l(const char *format, _locale_t locale, va_list valist)
+{
+    return vcprintf_helper(CPRINTF_P_OPTIONS, format, locale, valist);
+}
+
+/*********************************************************************
+ *		_vcprintf_p (MSVCR80.@)
+ */
+int CDECL _vcprintf_p(const char *format, va_list valist)
+{
+    return vcprintf_helper(CPRINTF_P_OPTIONS, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		_vcprintf_s_l (MSVCR80.@)
+ */
+int CDECL _vcprintf_s_l(const char *format, _locale_t locale, va_list valist)
+{
+    return vcprintf_helper(CPRINTF_S, format, locale, valist);
+}
+
+/*********************************************************************
+ *		_vcprintf_s (MSVCR80.@)
+ */
+int CDECL _vcprintf_s(const char *format, va_list valist)
+{
+    return vcprintf_helper(CPRINTF_S, format, NULL, valist);
+}
+
+/*********************************************************************
+ *		_vcwprintf_p_l (MSVCR80.@)
+ */
+int CDECL _vcwprintf_p_l(const wchar_t *format, _locale_t locale, va_list valist)
+{
