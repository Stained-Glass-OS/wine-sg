+DEFINE_CPRINTF(_cprintf_s, char, _vcprintf_s)
+/* _cprintf_s_l (MSVCR80.@) */
+DEFINE_CPRINTF_L(_cprintf_s_l, char, _vcprintf_s_l)
+/* _cwprintf_p (MSVCR80.@) */
+DEFINE_CPRINTF(_cwprintf_p, wchar_t, _vcwprintf_p)
+/* _cwprintf_p_l (MSVCR80.@) */
+DEFINE_CPRINTF_L(_cwprintf_p_l, wchar_t, _vcwprintf_p_l)
+/* _cwprintf_s (MSVCR80.@) */
+DEFINE_CPRINTF(_cwprintf_s, wchar_t, _vcwprintf_s)
+/* _cwprintf_s_l (MSVCR80.@) */
+DEFINE_CPRINTF_L(_cwprintf_s_l, wchar_t, _vcwprintf_s_l)
+#endif
