+#define DEFINE_CPRINTF(name, type, vfunc) \
+int WINAPIV name(const type *format, ...) \
+{ \
+    va_list valist; \
+    int ret; \
+    va_start(valist, format); \
+    ret = vfunc(format, valist); \
+    va_end(valist); \
+    return ret; \
+}
+#define DEFINE_CPRINTF_L(name, type, vfunc) \
+int WINAPIV name(const type *format, _locale_t locale, ...) \
+{ \
+    va_list valist; \
