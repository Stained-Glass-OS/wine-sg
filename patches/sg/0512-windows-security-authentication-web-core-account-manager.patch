+
+static HRESULT find_provider( HSTRING id, HSTRING authority, IAsyncOperation_WebAccountProvider **operation )
+{
+    TRACE( "id %s, authority %s: no provider is installed.\n", debugstr_hstring( id ), debugstr_hstring( authority ) );
