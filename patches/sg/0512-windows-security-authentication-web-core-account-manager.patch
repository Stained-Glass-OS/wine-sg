+static HRESULT token_request( IInspectable *request, IInspectable **operation )
+{
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!request) return E_INVALIDARG;
+    WARN( "request %p: no account provider is installed.\n", request );
+    return E_INVALIDARG;
