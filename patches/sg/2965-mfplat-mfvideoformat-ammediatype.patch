From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mfplat: MFVIDEOFORMAT stride/overflow, AM media type conversions

- MFInitMediaTypeFromMFVideoFormat: a width or height above INT_MAX is
  HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW) (checked before anything is
  set); the default stride of NV12/I420/IYUV/YV12/IMC2/IMC4 is rounded up to
  whole 2x2 chroma blocks (124 for width 123) and NV11 to a multiple of 4,
  matching MFCalculateImageSize.
- MFInitMediaTypeFromAMMediaType: an AM type with a null major type becomes a
  media type with null major type and subtype (S_OK); a video type with
  FORMAT_MFVideoFormat is converted with MFInitMediaTypeFromMFVideoFormat (the
  aperture is kept); for audio the AM subtype, when not null, replaces the
  subtype derived from the wave format tag.
  MFCreateMediaTypeFromRepresentation follows.
dlls/mfplat/tests/mfplat.c is the ground truth; its seven todo_wine groups that
now pass are removed.

---
diff --git a/dlls/mfplat/mediatype.c b/dlls/mfplat/mediatype.c
index 2c85124..38e17d1 100644
--- a/dlls/mfplat/mediatype.c
+++ b/dlls/mfplat/mediatype.c
@@ -4250,6 +4250,10 @@ HRESULT WINAPI MFInitMediaTypeFromMFVideoFormat(IMFMediaType *media_type, const
         return E_INVALIDARG;
     if (size < offsetof(MFVIDEOFORMAT, surfaceInfo.Palette[format->surfaceInfo.PaletteEntries + 1]))
         return E_INVALIDARG;
+#ifndef SG_MUTANT_MFVF_NO_OVERFLOW
+    if (format->videoInfo.dwWidth > INT_MAX || format->videoInfo.dwHeight > INT_MAX)
+        return HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW);
+#endif
 
     mediatype_set_guid(media_type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video, &hr);
     if (!IsEqualGUID(&format->guidFormat, &GUID_NULL))
@@ -4266,6 +4270,24 @@ HRESULT WINAPI MFInitMediaTypeFromMFVideoFormat(IMFMediaType *media_type, const
 
         if (video_format && (stride = mf_get_stride_for_format(video_format, format->videoInfo.dwWidth)))
         {
+            /* the 4:2:0 and 4:1:1 planar formats come in whole chroma blocks */
+            switch (format->guidFormat.Data1)
+            {
+                case MAKEFOURCC('I','M','C','2'):
+                case MAKEFOURCC('I','M','C','4'):
+                case MAKEFOURCC('N','V','1','2'):
+                case MAKEFOURCC('Y','V','1','2'):
+                case MAKEFOURCC('I','4','2','0'):
+                case MAKEFOURCC('I','Y','U','V'):
+#ifndef SG_MUTANT_MFVF_STRIDE_RAW
+                    stride = (format->videoInfo.dwWidth + 1) & ~1;
+#endif
+                    break;
+                case MAKEFOURCC('N','V','1','1'):
+                    stride = (format->videoInfo.dwWidth + 3) & ~3;
+                    break;
+            }
+
             if (!video_format->yuv && (format->videoInfo.VideoFlags & MFVideoFlag_BottomUpLinearRep))
                 stride = -stride;
             mediatype_set_uint32(media_type, &MF_MT_DEFAULT_STRIDE, stride, &hr);
@@ -4943,6 +4965,13 @@ HRESULT WINAPI MFInitMediaTypeFromAMMediaType(IMFMediaType *media_type, const AM
         else if (IsEqualGUID(&am_type->formattype, &FORMAT_MPEG2Video)
                 && am_type->cbFormat >= sizeof(MPEG2VIDEOINFO))
             hr = MFInitMediaTypeFromMPEG2VideoInfo(media_type, (MPEG2VIDEOINFO *)am_type->pbFormat, am_type->cbFormat, subtype);
+#ifndef SG_MUTANT_AMMT_NO_MFVF
+        else if (IsEqualGUID(&am_type->formattype, &FORMAT_MFVideoFormat)
+                && am_type->cbFormat >= sizeof(MFVIDEOFORMAT))
+#else
+        else if (0)
+#endif
+            hr = MFInitMediaTypeFromMFVideoFormat(media_type, (MFVIDEOFORMAT *)am_type->pbFormat, am_type->cbFormat);
         else
         {
             FIXME("Unsupported format type %s / size %ld.\n", debugstr_guid(&am_type->formattype), am_type->cbFormat);
@@ -4955,13 +4984,31 @@ HRESULT WINAPI MFInitMediaTypeFromAMMediaType(IMFMediaType *media_type, const AM
             hr = E_INVALIDARG;
         else if (IsEqualGUID(&am_type->formattype, &FORMAT_WaveFormatEx)
                 && am_type->cbFormat >= sizeof(WAVEFORMATEX))
+        {
             hr = MFInitMediaTypeFromWaveFormatEx(media_type, (WAVEFORMATEX *)am_type->pbFormat, am_type->cbFormat);
+            /* the subtype of the AM type wins over the format tag */
+#ifdef SG_MUTANT_AMMT_TAG_SUBTYPE
+            if (0)
+#endif
+            if (SUCCEEDED(hr) && !IsEqualGUID(&am_type->subtype, &GUID_NULL))
+                mediatype_set_guid(media_type, &MF_MT_SUBTYPE, &am_type->subtype, &hr);
+        }
         else
         {
             FIXME("Unsupported format type %s / size %ld.\n", debugstr_guid(&am_type->formattype), am_type->cbFormat);
             return E_NOTIMPL;
         }
     }
+#ifdef SG_MUTANT_AMMT_NO_NULL
+    else if (0)
+#else
+    else if (IsEqualGUID(&am_type->majortype, &GUID_NULL))
+#endif
+    {
+        /* nothing to interpret: only the (null) major type and subtype carry over */
+        mediatype_set_guid(media_type, &MF_MT_MAJOR_TYPE, &am_type->majortype, &hr);
+        mediatype_set_guid(media_type, &MF_MT_SUBTYPE, &am_type->subtype, &hr);
+    }
     else
     {
         FIXME("Unsupported major type %s.\n", debugstr_guid(&am_type->majortype));
diff --git a/dlls/mfplat/tests/mfplat.c b/dlls/mfplat/tests/mfplat.c
index 1f36f69..9707846 100644
--- a/dlls/mfplat/tests/mfplat.c
+++ b/dlls/mfplat/tests/mfplat.c
@@ -8724,9 +8724,9 @@ static void test_MFInitAMMediaTypeFromMFMediaType(void)
     hr = MFInitAMMediaTypeFromMFMediaType(media_type, FORMAT_MFVideoFormat, &am_type);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     hr = MFInitMediaTypeFromAMMediaType(other_type, &am_type);
-    todo_wine ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     hr = IMFMediaType_GetAllocatedBlob(other_type, &MF_MT_MINIMUM_DISPLAY_APERTURE, (BYTE **)&area, &value32);
-    todo_wine ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     if (hr == S_OK) CoTaskMemFree(area);
     IMFMediaType_DeleteAllItems(other_type);
     CoTaskMemFree(am_type.pbFormat);
@@ -9034,7 +9034,6 @@ static void test_MFInitMediaTypeFromMFVideoFormat(void)
 
     format.videoInfo.dwWidth = -123;
     hr = MFInitMediaTypeFromMFVideoFormat(media_type, &format, sizeof(format));
-    todo_wine
     ok(hr == HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW), "Unexpected hr %#lx.\n", hr);
     format.videoInfo.dwWidth = 123;
     hr = MFInitMediaTypeFromMFVideoFormat(media_type, &format, sizeof(format));
@@ -9044,7 +9043,6 @@ static void test_MFInitMediaTypeFromMFVideoFormat(void)
     IMFMediaType_DeleteAllItems(media_type);
     format.videoInfo.dwHeight = -456;
     hr = MFInitMediaTypeFromMFVideoFormat(media_type, &format, sizeof(format));
-    todo_wine
     ok(hr == HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW), "Unexpected hr %#lx.\n", hr);
     format.videoInfo.dwHeight = 456;
     hr = MFInitMediaTypeFromMFVideoFormat(media_type, &format, sizeof(format));
@@ -9095,7 +9093,6 @@ static void test_MFInitMediaTypeFromMFVideoFormat(void)
     value32 = 0xdeadbeef;
     hr = IMFMediaType_GetUINT32(media_type, &MF_MT_DEFAULT_STRIDE, &value32);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(value32 == 124, "got %u.\n", value32);
     value32 = 0xdeadbeef;
     hr = IMFMediaType_GetUINT32(media_type, &MF_MT_SAMPLE_SIZE, &value32);
@@ -9507,7 +9504,6 @@ static void test_MFCreateMediaTypeFromRepresentation(void)
     ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
 
     hr = MFCreateMediaTypeFromRepresentation(AM_MEDIA_TYPE_REPRESENTATION, &amt, &media_type);
-    todo_wine
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     if (hr == S_OK)
     {
@@ -9536,7 +9532,6 @@ static void test_MFCreateMediaTypeFromRepresentation(void)
     memset(&guid, 0xcd, sizeof(guid));
     hr = IMFMediaType_GetGUID(media_type, &MF_MT_SUBTYPE, &guid);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(IsEqualGUID(&guid, &MFAudioFormat_PCM), "got %s.\n", debugstr_guid(&guid));
     IMFMediaType_Release(media_type);
 }
