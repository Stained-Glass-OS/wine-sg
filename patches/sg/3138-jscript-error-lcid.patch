From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 01:38:23 -0700
Subject: [PATCH] jscript: report the user's locale in the error info for a
 plain failure code

A failure code returned by a host call (E_FAIL from IDispatch::Invoke without
EXCEPINFO) reaches IActiveScriptError::GetExceptionInfo with wReserved set to
the user's locale, like a thrown Error object. Removes the todo_wine for that
case from run.c.

diff --git a/dlls/jscript/engine.c b/dlls/jscript/engine.c
index bb297bf..f510eeb 100644
--- a/dlls/jscript/engine.c
+++ b/dlls/jscript/engine.c
@@ -3205,8 +3205,14 @@ static HRESULT unwind_exception(script_ctx_t *ctx, HRESULT exception_hres)
     }
 
     frame = ctx->call_ctx;
-    if(exception_hres != DISP_E_EXCEPTION)
+    if(exception_hres != DISP_E_EXCEPTION) {
         throw_error(ctx, exception_hres, NULL);
+        /* a failure code returned by a host call also carries the user's locale */
+#ifndef SG_MUTANT_JS_NOLCID
+        if(!is_jscript_error(exception_hres))
+            ei->error_object = TRUE;
+#endif
+    }
     set_error_location(ei, frame->bytecode, frame->bytecode->instrs[frame->ip].loc, IDS_RUNTIME_ERROR, NULL);
 
     while(!frame->except_frame) {
diff --git a/dlls/jscript/engine.h b/dlls/jscript/engine.h
index 4649b79..d36eba5 100644
--- a/dlls/jscript/engine.h
+++ b/dlls/jscript/engine.h
@@ -252,7 +252,7 @@ struct _jsexcept_t {
     HRESULT error;
 
     BOOL valid_value;
-    BOOL error_object;  /* the thrown value is an Error instance */
+    BOOL error_object;  /* the thrown value is an Error instance, or a plain failure code: reports the user's locale */
     jsval_t value;
 
     jsstr_t *source;
diff --git a/dlls/jscript/jscript.c b/dlls/jscript/jscript.c
index 404c081..8b05b17 100644
--- a/dlls/jscript/jscript.c
+++ b/dlls/jscript/jscript.c
@@ -253,7 +253,7 @@ static HRESULT WINAPI JScriptError_GetExceptionInfo(IActiveScriptError *iface, E
 
     memset(excepinfo, 0, sizeof(*excepinfo));
     excepinfo->scode = This->ei.error;
-    /* an Error object thrown by the script carries the user's locale */
+    /* an Error object thrown by the script, or a plain failure code, carries the user's locale */
     if(This->ei.error_object)
         excepinfo->wReserved = LOWORD(GetUserDefaultLCID());
     if(This->ei.source)
diff --git a/dlls/jscript/tests/run.c b/dlls/jscript/tests/run.c
index bca44ef..e85e774 100644
--- a/dlls/jscript/tests/run.c
+++ b/dlls/jscript/tests/run.c
@@ -2442,7 +2442,7 @@ static void test_error_reports(void)
             NULL,
             NULL, 0,
             NULL,
-            ERROR_TODO_LCID,
+            0,
             TRUE
         },
         {
