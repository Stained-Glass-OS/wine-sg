+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "wincrypt.h"
+#include "strongname.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL( mscoree );
+
+
+/* a strong name public key: two algorithm ids, the length, then a CryptoAPI PUBLICKEYBLOB */
+#include "pshpack1.h"
+struct sn_public_key
+{
+    ALG_ID sig_alg;
+    ALG_ID hash_alg;
+    ULONG  len;
+    BYTE   blob[1];
+};
+#include "poppack.h"
+
+#define SN_HEADER_SIZE   12
+#define PUBKEY_MIN_SIZE  (sizeof(BLOBHEADER) + sizeof(RSAPUBKEY))
+
+static LONG error_tls = -1;
+
+static void set_error( HRESULT hr )
+{
+    DWORD index = error_tls;
+
+    if (index == (DWORD)-1)
+    {
+        DWORD new_index = TlsAlloc();
+        if (new_index == TLS_OUT_OF_INDEXES) return;
+        if (InterlockedCompareExchange( &error_tls, new_index, -1 ) != -1) TlsFree( new_index );
+        index = error_tls;
+    }
+    TlsSetValue( index, (void *)(ULONG_PTR)hr );
+}
+
+static BOOLEAN fail( HRESULT hr )
+{
+    set_error( hr );
+    return FALSE;
+}
+
+/* the error of a CryptoAPI call: NTE_* codes already are HRESULTs */
+static BOOLEAN fail_crypt(void)
+{
+    DWORD err = GetLastError();
+    return fail( err ? HRESULT_FROM_WIN32( err ) : CORSEC_E_CRYPTO );
+}
+
+/* Windows does not document what this returns when nothing failed */
+DWORD WINAPI StrongNameErrorInfo(void)
+{
+    DWORD index = error_tls;
+
+    TRACE( "()\n" );
+    if (index == (DWORD)-1) return S_OK;
+    return (DWORD)(ULONG_PTR)TlsGetValue( index );
+}
+
+void WINAPI StrongNameFreeBuffer( BYTE *buffer )
+{
+    TRACE( "(%p)\n", buffer );
+    free( buffer );
+}
+
+BOOLEAN WINAPI StrongNameHashSize( ULONG alg, DWORD *size )
+{
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    DWORD len = sizeof(*size), value;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "(%#lx, %p)\n", alg, size );
+
+    if (!size) return fail( E_POINTER );
+#ifndef SG_MUTANT_SN_HASH0
+    if (!alg) alg = CALG_SHA1;
+#endif
+
+    if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_AES, CRYPT_VERIFYCONTEXT )) return fail_crypt();
+    if (CryptCreateHash( prov, alg, 0, 0, &hash ))
+    {
+        if (CryptGetHashParam( hash, HP_HASHSIZE, (BYTE *)&value, &len, 0 ))
+        {
+            *size = value;
+            ret = TRUE;
+        }
+        CryptDestroyHash( hash );
+    }
+    if (!ret) fail_crypt();
+    CryptReleaseContext( prov, 0 );
+    return ret;
+}
+
+static BOOL check_public_key( const BYTE *key, ULONG len, const RSAPUBKEY **rsa )
+{
+    const struct sn_public_key *pk = (const struct sn_public_key *)key;
+    const BLOBHEADER *header;
+
+    if (len < SN_HEADER_SIZE + PUBKEY_MIN_SIZE) return FALSE;
+    if (pk->len != len - SN_HEADER_SIZE) return FALSE;
+    header = (const BLOBHEADER *)pk->blob;
+    if (header->bType != PUBLICKEYBLOB) return FALSE;
+    *rsa = (const RSAPUBKEY *)(header + 1);
+    if ((*rsa)->magic != 0x31415352 /* RSA1 */) return FALSE;
+    if (pk->len != PUBKEY_MIN_SIZE + (*rsa)->bitlen / 8) return FALSE;
+    return TRUE;
+}
+
+BOOLEAN WINAPI StrongNameSignatureSize( BYTE *key, ULONG len, ULONG *size )
+{
+    const RSAPUBKEY *rsa;
+
+    TRACE( "(%p, %lu, %p)\n", key, len, size );
+
+    if (!key || !size) return fail( E_POINTER );
+    if (!check_public_key( key, len, &rsa )) return fail( CORSEC_E_INVALID_PUBLICKEY );
+#ifndef SG_MUTANT_SN_SIZE
+    *size = rsa->bitlen / 8;
+#else
+    *size = rsa->bitlen;
+#endif
+    return TRUE;
+}
+
+BOOLEAN WINAPI StrongNameTokenFromPublicKey( BYTE *key, ULONG len, BYTE **token, ULONG *token_len )
+{
+    const RSAPUBKEY *rsa;
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    BYTE digest[20], *out;
+    DWORD size = sizeof(digest);
+    BOOLEAN ret = FALSE;
+    unsigned int i;
+
+    TRACE( "(%p, %lu, %p, %p)\n", key, len, token, token_len );
+
+    if (!key || !token || !token_len) return fail( E_POINTER );
+    if (!check_public_key( key, len, &rsa )) return fail( CORSEC_E_INVALID_PUBLICKEY );
+
+    if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT )) return fail_crypt();
+    if (CryptCreateHash( prov, CALG_SHA1, 0, 0, &hash ))
+    {
+        if (CryptHashData( hash, key, len, 0 ) && CryptGetHashParam( hash, HP_HASHVAL, digest, &size, 0 ))
+            ret = TRUE;
+        CryptDestroyHash( hash );
+    }
+    if (!ret) fail_crypt();
+    CryptReleaseContext( prov, 0 );
+    if (!ret) return FALSE;
+
+    if (!(out = malloc( 8 ))) return fail( E_OUTOFMEMORY );
+    /* the last eight bytes of the SHA-1, in reverse order */
+#ifndef SG_MUTANT_SN_TOKEN
+    for (i = 0; i < 8; i++) out[i] = digest[19 - i];
+#else
+    for (i = 0; i < 8; i++) out[i] = digest[12 + i];
+#endif
+    *token = out;
+    *token_len = 8;
+    return TRUE;
+}
+
+static BOOLEAN acquire_container( const WCHAR *container, DWORD flags, HCRYPTPROV *prov )
+{
+    if (CryptAcquireContextW( prov, container, MS_ENHANCED_PROV_W, PROV_RSA_FULL, flags )) return TRUE;
+    return fail_crypt();
+}
+
+/* a signing key pair, as a CryptoAPI PRIVATEKEYBLOB */
+static BOOLEAN key_gen( const WCHAR *container, DWORD flags, DWORD bits, BYTE **blob, ULONG *blob_len )
+{
+    WCHAR temp_name[48];
+    const WCHAR *name = container;
+    HCRYPTPROV prov;
+    HCRYPTKEY key;
+    DWORD size = 0;
+    BYTE *buf;
+    BOOLEAN ret = FALSE;
+
+    if (!blob || !blob_len) return fail( E_POINTER );
+    if (!bits) bits = 1024;
+
+    if (!name)
+    {
+        GUID guid;
+        CoCreateGuid( &guid );
+        swprintf( temp_name, ARRAY_SIZE(temp_name), L"%08lx%04x%04x%02x%02x%02x%02x%02x%02x%02x%02x",
+                  guid.Data1, guid.Data2, guid.Data3, guid.Data4[0], guid.Data4[1], guid.Data4[2],
+                  guid.Data4[3], guid.Data4[4], guid.Data4[5], guid.Data4[6], guid.Data4[7] );
+        name = temp_name;
+    }
+    if (!acquire_container( name, CRYPT_NEWKEYSET, &prov )) return FALSE;
+
+    if (CryptGenKey( prov, AT_SIGNATURE, (bits << 16) | CRYPT_EXPORTABLE, &key ))
+    {
+        if (CryptExportKey( key, 0, PRIVATEKEYBLOB, 0, NULL, &size ) && (buf = malloc( size )))
+        {
+            if (CryptExportKey( key, 0, PRIVATEKEYBLOB, 0, buf, &size ))
+            {
+                *blob = buf;
+                *blob_len = size;
+                ret = TRUE;
+            }
+            else free( buf );
+        }
+        if (!ret) fail_crypt();
+        CryptDestroyKey( key );
+    }
+    else fail_crypt();
+
+    CryptReleaseContext( prov, 0 );
+    /* a container the caller did not name, or did not ask to keep, must not stay behind */
+#ifndef SG_MUTANT_SN_LEAVE
+    if (!container || !(flags & SN_LEAVE_KEY))
+#endif
+        CryptAcquireContextW( &prov, name, MS_ENHANCED_PROV_W, PROV_RSA_FULL, CRYPT_DELETEKEYSET );
+    return ret;
+}
+
+BOOLEAN WINAPI StrongNameKeyGen( const WCHAR *container, DWORD flags, BYTE **blob, ULONG *blob_len )
+{
+    TRACE( "(%s, %#lx, %p, %p)\n", debugstr_w(container), flags, blob, blob_len );
+    return key_gen( container, flags, 1024, blob, blob_len );
+}
+
+BOOLEAN WINAPI StrongNameKeyGenEx( const WCHAR *container, DWORD flags, DWORD bits, BYTE **blob, ULONG *blob_len )
+{
+    TRACE( "(%s, %#lx, %lu, %p, %p)\n", debugstr_w(container), flags, bits, blob, blob_len );
+    return key_gen( container, flags, bits, blob, blob_len );
+}
+
+BOOLEAN WINAPI StrongNameKeyDelete( const WCHAR *container )
+{
+    HCRYPTPROV prov;
+
+    TRACE( "(%s)\n", debugstr_w(container) );
+
+    if (!container) return fail( E_POINTER );
+    if (!CryptAcquireContextW( &prov, container, MS_ENHANCED_PROV_W, PROV_RSA_FULL, CRYPT_DELETEKEYSET ))
+        return fail_crypt();
+    return TRUE;
+}
+
+BOOLEAN WINAPI StrongNameKeyInstall( const WCHAR *container, BYTE *blob, ULONG blob_len )
+{
+    HCRYPTPROV prov;
+    HCRYPTKEY key;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "(%s, %p, %lu)\n", debugstr_w(container), blob, blob_len );
+
+    if (!container || !blob) return fail( E_POINTER );
+    if (!acquire_container( container, CRYPT_NEWKEYSET, &prov ))
+    {
+        /* a container that exists already takes the key too */
+        if (GetLastError() != NTE_EXISTS || !acquire_container( container, 0, &prov )) return FALSE;
+    }
+    if (CryptImportKey( prov, blob, blob_len, 0, CRYPT_EXPORTABLE, &key ))
+    {
+        CryptDestroyKey( key );
+        ret = TRUE;
+    }
+    else fail_crypt();
+    CryptReleaseContext( prov, 0 );
+    return ret;
+}
+
+BOOLEAN WINAPI StrongNameGetPublicKey( const WCHAR *container, BYTE *blob, ULONG blob_len,
+                                        BYTE **public_key, ULONG *public_key_len )
+{
+    HCRYPTPROV prov;
+    HCRYPTKEY key = 0;
+    DWORD size = 0;
+    BYTE *buf = NULL;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "(%s, %p, %lu, %p, %p)\n", debugstr_w(container), blob, blob_len, public_key, public_key_len );
+
+    if (!public_key || !public_key_len || (!container && !blob)) return fail( E_POINTER );
+
+    if (blob)
+    {
+        if (!CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT )) return fail_crypt();
+        if (!CryptImportKey( prov, blob, blob_len, 0, CRYPT_EXPORTABLE, &key ))
+        {
+            fail_crypt();
+            CryptReleaseContext( prov, 0 );
+            return FALSE;
+        }
+    }
+    else
+    {
+        if (!acquire_container( container, 0, &prov )) return FALSE;
+        if (!CryptGetUserKey( prov, AT_SIGNATURE, &key ))
+        {
+            fail_crypt();
+            CryptReleaseContext( prov, 0 );
+            return FALSE;
+        }
+    }
+
+    if (CryptExportKey( key, 0, PUBLICKEYBLOB, 0, NULL, &size ) && (buf = malloc( SN_HEADER_SIZE + size )))
+    {
+        struct sn_public_key *pk = (struct sn_public_key *)buf;
+
+        if (CryptExportKey( key, 0, PUBLICKEYBLOB, 0, pk->blob, &size ))
+        {
+#ifndef SG_MUTANT_SN_ALG
+            pk->sig_alg  = CALG_RSA_SIGN;
+#else
+            pk->sig_alg  = CALG_RSA_KEYX;
+#endif
+            pk->hash_alg = CALG_SHA1;
+            pk->len      = size;
+            *public_key     = buf;
+            *public_key_len = SN_HEADER_SIZE + size;
+            ret = TRUE;
+        }
+        else free( buf );
+    }
+    if (!ret) fail_crypt();
+    CryptDestroyKey( key );
+    CryptReleaseContext( prov, 0 );
+    return ret;
+}
--- a/include/strongname.h
+++ b/include/strongname.h
@@ -37,4 +37,17 @@ BOOLEAN __stdcall StrongNameSignatureVerification(const WCHAR *path, DWORD flags
 BOOLEAN __stdcall StrongNameSignatureVerificationEx(const WCHAR *path, BOOLEAN force, BOOLEAN *verified);
 BOOLEAN __stdcall StrongNameTokenFromAssembly(const WCHAR *path, BYTE **token, ULONG *size);
 
+#define SN_LEAVE_KEY            0x00000001
+
+DWORD   __stdcall StrongNameErrorInfo(void);
+void    __stdcall StrongNameFreeBuffer(BYTE *buffer);
+BOOLEAN __stdcall StrongNameGetPublicKey(const WCHAR *container, BYTE *blob, ULONG blob_len, BYTE **key, ULONG *key_len);
+BOOLEAN __stdcall StrongNameHashSize(ULONG alg, DWORD *size);
+BOOLEAN __stdcall StrongNameKeyDelete(const WCHAR *container);
+BOOLEAN __stdcall StrongNameKeyGen(const WCHAR *container, DWORD flags, BYTE **blob, ULONG *blob_len);
+BOOLEAN __stdcall StrongNameKeyGenEx(const WCHAR *container, DWORD flags, DWORD bits, BYTE **blob, ULONG *blob_len);
+BOOLEAN __stdcall StrongNameKeyInstall(const WCHAR *container, BYTE *blob, ULONG blob_len);
+BOOLEAN __stdcall StrongNameSignatureSize(BYTE *key, ULONG key_len, ULONG *size);
+BOOLEAN __stdcall StrongNameTokenFromPublicKey(BYTE *key, ULONG key_len, BYTE **token, ULONG *token_len);
+
 #endif
