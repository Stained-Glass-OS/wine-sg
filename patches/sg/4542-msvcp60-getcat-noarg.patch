diff --git a/dlls/msvcp90/locale.c b/dlls/msvcp90/locale.c
index 22c6cce..07af0b3 100644
--- a/dlls/msvcp90/locale.c
+++ b/dlls/msvcp90/locale.c
@@ -3560,6 +3560,22 @@ static const mpunct *money_use_mpunct(const locale *loc, BOOL intl, int type)
 }
 #endif
 
+#if _MSVCP_VER < 70
+/* VC6's argument-less _Getcat: the category of the facet, -1 for the
+ * facet base class */
+size_t __cdecl locale_facet__Getcat_noarg(void) { return -1; }
+size_t __cdecl collate__Getcat_noarg(void) { return LC_COLLATE; }
+size_t __cdecl ctype__Getcat_noarg(void) { return LC_CTYPE; }
+size_t __cdecl numeric__Getcat_noarg(void)
+{
+#ifdef SG_MUTANT_GETCAT60_NUMERIC_IS_TIME
+    return LC_TIME;
+#endif
+    return LC_NUMERIC;
+}
+size_t __cdecl time__Getcat_noarg(void) { return LC_TIME; }
+#endif
+
 /* ?id@?$collate@D@std@@2V0locale@2@A */
 locale_id collate_char_id = {0};
 
