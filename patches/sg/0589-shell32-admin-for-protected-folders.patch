+/* "Destination Folder Access Denied": the user may not write there -- an
+ * administrator may. Continue (with the shield) or Cancel, as Windows asks. */
+struct denied
+{
+    HFONT font, big;
+    const WCHAR *heading, *what, *dir;
+    int result;
+};
+
+static LRESULT CALLBACK denied_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct denied *d = (struct denied *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CREATE:
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)((CREATESTRUCTW *)lp)->lpCreateParams);
+        return 0;
+    case WM_ERASEBKGND:
+    {
+        RECT rc;
+        HBRUSH brush = CreateSolidBrush(C_BG);
+        GetClientRect(hwnd, &rc);
+        FillRect((HDC)wp, &rc, brush);
+        DeleteObject(brush);
+        return 1;
+    }
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(hwnd, &ps);
+        HICON shield = LoadImageW(NULL, (LPCWSTR)IDI_SHIELD, IMAGE_ICON, scale(32), scale(32), LR_SHARED);
+        RECT rc;
+
+        GetClientRect(hwnd, &rc);
+        SetBkMode(hdc, TRANSPARENT);
+        if (shield) DrawIconEx(hdc, scale(20), scale(20), shield, scale(32), scale(32), 0, NULL, DI_NORMAL);
+        SelectObject(hdc, d->big);
+        SetTextColor(hdc, C_ACCENT_DK);
+        SetRect(&rc, scale(64), scale(18), rc.right - scale(20), scale(52));
+        DrawTextW(hdc, d->heading, -1, &rc, DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);
+        SelectObject(hdc, d->font);
+        SetTextColor(hdc, C_TEXT);
+        OffsetRect(&rc, 0, scale(44));
+        rc.bottom = rc.top + scale(40);
+        DrawTextW(hdc, d->what, -1, &rc, DT_WORDBREAK);
+        SetTextColor(hdc, C_MUTED);
+        OffsetRect(&rc, 0, scale(44));
+        rc.bottom = rc.top + scale(20);
+        DrawTextW(hdc, d->dir, -1, &rc, DT_SINGLELINE | DT_PATH_ELLIPSIS);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDOK || LOWORD(wp) == IDCANCEL) d->result = LOWORD(wp);
+        return 0;
+    case WM_CLOSE:
+        d->result = IDCANCEL;
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+/* TRUE to go on as an administrator */
+BOOL fileop_access_denied(HWND owner, UINT func, const WCHAR *dir)
+{
+    struct denied d = { 0 };
+    WNDCLASSW wc = { 0 };
+    RECT rc, orc;
+    HWND hwnd, button;
+    MSG msg;
+    int w = scale(460), h = scale(190);
+
+    switch (func)
+    {
+    case FO_COPY:
+        d.heading = L"Destination Folder Access Denied";
+        d.what = L"You'll need to provide administrator permission to copy to this folder.";
+        break;
+    case FO_MOVE:
+        d.heading = L"Destination Folder Access Denied";
+        d.what = L"You'll need to provide administrator permission to move to this folder.";
+        break;
+    case FO_RENAME:
+        d.heading = L"File Access Denied";
+        d.what = L"You'll need to provide administrator permission to rename this item.";
+        break;
+    default:
+        d.heading = L"File Access Denied";
+        d.what = L"You'll need to provide administrator permission to delete this item.";
+        break;
+    }
+    d.dir = dir;
+
+    wc.lpfnWndProc = denied_proc;
+    wc.hInstance = shell32_hInstance;
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.lpszClassName = L"SGFileAccessDenied";
+    RegisterClassW(&wc);
+
+    d.font = ui_font(0, 0);
+    d.big = ui_font(120, FW_NORMAL);
+    SetRect(&rc, 0, 0, w, h);
+    AdjustWindowRectEx(&rc, WS_CAPTION | WS_SYSMENU, FALSE, WS_EX_DLGMODALFRAME);
+    if (!owner || !GetWindowRect(owner, &orc)) SystemParametersInfoW(SPI_GETWORKAREA, 0, &orc, 0);
+    hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME, L"SGFileAccessDenied", d.heading, WS_POPUP | WS_CAPTION | WS_SYSMENU,
+                           max(0, orc.left + (orc.right - orc.left - (rc.right - rc.left)) / 2),
+                           max(0, orc.top + (orc.bottom - orc.top - (rc.bottom - rc.top)) / 3),
+                           rc.right - rc.left, rc.bottom - rc.top, owner, NULL, shell32_hInstance, &d);
+    button = CreateWindowExW(0, L"Button", L"&Continue", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
+                             w - scale(20) - scale(88) * 2 - scale(8), h - scale(16) - scale(28), scale(88), scale(28),
+                             hwnd, (HMENU)IDOK, shell32_hInstance, NULL);
+    SendMessageW(button, WM_SETFONT, (WPARAM)d.font, FALSE);
+    SendMessageW(button, BCM_SETSHIELD, 0, TRUE);
+    SetFocus(button);
+    button = CreateWindowExW(0, L"Button", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
+                             w - scale(20) - scale(88), h - scale(16) - scale(28), scale(88), scale(28), hwnd,
+                             (HMENU)IDCANCEL, shell32_hInstance, NULL);
+    SendMessageW(button, WM_SETFONT, (WPARAM)d.font, FALSE);
+
+    if (owner) EnableWindow(owner, FALSE);
+    ShowWindow(hwnd, SW_SHOWNORMAL);
+    SetForegroundWindow(hwnd);
+    TRACE("access denied to %s: asking for an administrator\n", debugstr_w(dir));
+    while (!d.result && GetMessageW(&msg, NULL, 0, 0))
+    {
+        if (IsDialogMessageW(hwnd, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    if (owner) EnableWindow(owner, TRUE);
+    DestroyWindow(hwnd);
+    DeleteObject(d.font);
+    DeleteObject(d.big);
+    return d.result == IDOK;
+}
