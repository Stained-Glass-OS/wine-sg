+/* words and "quoted paths" -- paths hold no quotes; the string is split in place */
+static WCHAR **split_args(WCHAR *str, int *count)
+{
+    WCHAR **argv = calloc(lstrlenW(str) / 2 + 2, sizeof(WCHAR *));
+    int n = 0;
+
+    if (!argv) return NULL;
+    while (*str)
+    {
+        while (*str == ' ' || *str == '\t') str++;
+        if (!*str) break;
+        if (*str == '"')
+        {
+            argv[n++] = ++str;
+            while (*str && *str != '"') str++;
+        }
+        else
+        {
+            argv[n++] = str;
+            while (*str && *str != ' ' && *str != '\t') str++;
+        }
+        if (*str) *str++ = 0;
+    }
+    *count = n;
+    return argv;
+}
