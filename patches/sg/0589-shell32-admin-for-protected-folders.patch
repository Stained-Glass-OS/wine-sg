+/*************************************************************************
+ * SgFileOperationElevated (SHELL32.@)
+ *
+ * Stained Glass OS: the elevated half of the above, run by rundll32.
+ */
+void WINAPI SgFileOperationElevatedW(HWND hwnd, HINSTANCE inst, LPWSTR cmdline, int show)
+{
+    SHFILEOPSTRUCTW op = { 0 };
+    WCHAR **argv, *from, *to, *p;
+    int argc, i, ret;
+    size_t from_len = 1, to_len = 1;
+    BOOL in_to = FALSE;
+
+    if (!(argv = split_args(cmdline, &argc)) || argc < 3) ExitProcess(ERROR_INVALID_PARAMETER);
+    for (i = 2; i < argc; i++)
+    {
+        if (!wcscmp(argv[i], L"--")) { in_to = TRUE; continue; }
+        if (in_to) to_len += lstrlenW(argv[i]) + 1;
+        else from_len += lstrlenW(argv[i]) + 1;
+    }
+    from = calloc(from_len + 1, sizeof(WCHAR));
+    to = calloc(to_len + 1, sizeof(WCHAR));
+    if (!from || !to) ExitProcess(ERROR_OUTOFMEMORY);
+    in_to = FALSE;
+    for (i = 2, p = from; i < argc; i++)
+    {
+        if (!wcscmp(argv[i], L"--")) { in_to = TRUE; p = to; continue; }
+        lstrcpyW(p, argv[i]);
+        p += lstrlenW(p) + 1;
+    }
+    op.hwnd = NULL;
+    op.wFunc = wcstoul(argv[0], NULL, 10);
+    op.fFlags = wcstoul(argv[1], NULL, 10) | FOF_NOCONFIRMMKDIR;
+    op.pFrom = from;
+    op.pTo = *to ? to : NULL;
+    ret = SHFileOperationW(&op);
+    if (!ret && op.fAnyOperationsAborted) ret = ERROR_CANCELLED;
+    ExitProcess(ret);
+}
