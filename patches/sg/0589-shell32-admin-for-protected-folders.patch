  *
  * See SHFileOperationA
  */
+/* Stained Glass OS: a folder the user may not write to asks for an
+ * administrator, as Windows does ("You'll need to provide administrator
+ * permission to copy to this folder"), and the operation is done again,
+ * elevated. It failed without a word: Paste in a folder an installer made
+ * did nothing (David). */
+static BOOL fileop_dir_writable(const WCHAR *dir)
+{
+    WCHAR probe[MAX_PATH];
+    HANDLE h;
+
+    if (!PathCombineW(probe, dir, L".sg-write-probe.tmp")) return TRUE;
+    h = CreateFileW(probe, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                    FILE_ATTRIBUTE_HIDDEN | FILE_FLAG_DELETE_ON_CLOSE, NULL);
+    if (h != INVALID_HANDLE_VALUE)
+    {
+        CloseHandle(h);
+        return TRUE;
+    }
+    return GetLastError() != ERROR_ACCESS_DENIED;
+}
+
+/* the folder the operation writes to that the user may not, if any */
+static BOOL fileop_denied_dir(const SHFILEOPSTRUCTW *op, WCHAR *dir)
+{
+    UINT func = op->wFunc & FO_MASK;
+
+    if ((func == FO_COPY || func == FO_MOVE) && op->pTo && *op->pTo)
+    {
+        lstrcpynW(dir, op->pTo, MAX_PATH);
+        while (!PathIsDirectoryW(dir) && PathRemoveFileSpecW(dir)) ;
+        if (*dir && !fileop_dir_writable(dir)) return TRUE;
+    }
+    if ((func == FO_MOVE || func == FO_DELETE || func == FO_RENAME) && op->pFrom && *op->pFrom)
+    {
+        lstrcpynW(dir, op->pFrom, MAX_PATH);
+        if (PathRemoveFileSpecW(dir) && *dir && !fileop_dir_writable(dir)) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL process_elevated(void)
+{
+    TOKEN_ELEVATION elevation = { 0 };
+    HANDLE token;
+    DWORD size;
+
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return FALSE;
+    if (!GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &size)) elevation.TokenIsElevated = 0;
+    CloseHandle(token);
+    return elevation.TokenIsElevated != 0;
+}
+
+static WCHAR *append_quoted_list(WCHAR *cmd, size_t *len, const WCHAR *list)
+{
+    const WCHAR *p;
+
+    for (p = list; p && *p; p += lstrlenW(p) + 1)
+    {
+        size_t add = lstrlenW(p) + 3;
+        WCHAR *tmp = realloc(cmd, (*len + add + 1) * sizeof(WCHAR));
+        if (!tmp) { free(cmd); return NULL; }
+        cmd = tmp;
+        swprintf(cmd + *len, add + 1, L" \"%s\"", p);
+        *len += lstrlenW(cmd + *len);
+    }
+    return cmd;
+}
+
+/* the operation again, as an administrator: rundll32 shell32.dll,SgFileOperationElevated
+ * FUNC FLAGS "from"... -- "to"... */
+static int fileop_run_elevated(LPSHFILEOPSTRUCTW op, const WCHAR *dir)
+{
+    SHELLEXECUTEINFOW sei = { sizeof(sei) };
+    size_t len;
+    WCHAR *cmd = malloc(64 * sizeof(WCHAR));
+    DWORD code = ERROR_CANCELLED;
+
+    if (!cmd) return ERROR_OUTOFMEMORY;
+    swprintf(cmd, 64, L"shell32.dll,SgFileOperationElevated %u %u", op->wFunc & FO_MASK, op->fFlags);
+    len = lstrlenW(cmd);
+    if (!(cmd = append_quoted_list(cmd, &len, op->pFrom))) return ERROR_OUTOFMEMORY;
+    if (!(cmd = append_quoted_list(cmd, &len, L"--\0"))) return ERROR_OUTOFMEMORY;
+    if ((op->wFunc & FO_MASK) != FO_DELETE && !(cmd = append_quoted_list(cmd, &len, op->pTo))) return ERROR_OUTOFMEMORY;
+
+    sei.fMask = SEE_MASK_NOCLOSEPROCESS | SEE_MASK_FLAG_NO_UI;
+    sei.hwnd = op->hwnd;
+    sei.lpVerb = L"runas";
+    sei.lpFile = L"rundll32.exe";
+    sei.lpParameters = cmd;
+    sei.nShow = SW_SHOWNORMAL;
+    TRACE("elevated: %s\n", debugstr_w(cmd));
+    if (ShellExecuteExW(&sei) && sei.hProcess)
+    {
+        while (MsgWaitForMultipleObjects(1, &sei.hProcess, FALSE, INFINITE, QS_ALLINPUT) == WAIT_OBJECT_0 + 1)
+        {
+            MSG msg;
+            while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE)) DispatchMessageW(&msg);
+        }
+        if (!GetExitCodeProcess(sei.hProcess, &code)) code = ERROR_ACCESS_DENIED;
+        CloseHandle(sei.hProcess);
+    }
+    free(cmd);
+    if (code == ERROR_CANCELLED) op->fAnyOperationsAborted = TRUE;
+    /* the elevated process's changes are not seen here: the folders shown
+     * are told to read themselves again */
+    SHChangeNotify(SHCNE_UPDATEDIR, SHCNF_PATHW | SHCNF_FLUSH, dir, NULL);
+    if ((op->wFunc & FO_MASK) == FO_MOVE && op->pFrom && *op->pFrom)
+    {
+        WCHAR src[MAX_PATH];
+        lstrcpynW(src, op->pFrom, MAX_PATH);
+        if (PathRemoveFileSpecW(src)) SHChangeNotify(SHCNE_UPDATEDIR, SHCNF_PATHW | SHCNF_FLUSH, src, NULL);
+    }
+    return code;
+}
