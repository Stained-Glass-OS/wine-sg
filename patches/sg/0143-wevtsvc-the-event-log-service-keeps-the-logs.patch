+#ifndef __WINE_WINE_EVENTLOG_H
+#define __WINE_WINE_EVENTLOG_H
+
+/* One request per connection to this message-mode pipe; one reply message.
+ * The service decides what the caller may do from the caller's token
+ * (ImpersonateNamedPipeClient), never from anything in the request. */
+#define WINE_EVENTLOG_PIPE L"\\\\.\\pipe\\wine_eventlog"
+#define WINE_EVENTLOG_MAGIC 0x4c564557  /* "WEVL" */
+
+/* Logs and backups on disk: this header, then EVENTLOGRECORDs (the Unicode
+ * layout ReadEventLogW returns), oldest first. */
+#define WINE_EVENTLOG_FILE_MAGIC   "SGEVTLOG"
+#define WINE_EVENTLOG_FILE_VERSION 1
+struct wine_eventlog_file_header
+{
+    char  magic[8];
+    DWORD version;
+    DWORD next_record;      /* the number the next record will get */
+};
+
+enum wine_eventlog_op
+{
+    WINE_EVENTLOG_OPEN = 1, /* name -> log; access READ or WRITE */
+    WINE_EVENTLOG_REPORT,   /* a record, in the reply its number */
+    WINE_EVENTLOG_READ,     /* records from a position */
+    WINE_EVENTLOG_INFO,     /* count, oldest, full */
+    WINE_EVENTLOG_CLEAR,
+    WINE_EVENTLOG_BACKUP,   /* the whole log as a file image */
+    WINE_EVENTLOG_WAIT,     /* returns when the log changes (or a timeout) */
+};
+
+#define WINE_EVENTLOG_ACCESS_READ  1
+#define WINE_EVENTLOG_ACCESS_WRITE 2
+
+#define WINE_EVENTLOG_NAME_LEN 256
+#define WINE_EVENTLOG_MAX_REQUEST (512 * 1024)
+
+struct wine_eventlog_request
+{
+    DWORD magic;
+    DWORD op;
+    DWORD size;             /* of the whole message */
+    DWORD access;           /* OPEN */
+    WCHAR log[WINE_EVENTLOG_NAME_LEN];     /* a log's name (OPEN: the name given) */
+    WCHAR source[WINE_EVENTLOG_NAME_LEN];  /* REPORT: the source recorded */
+    /* READ: seek to `record` (0: sequential from `pos`; `pos` 0: from the
+     * start in the direction read); at least one record, then more while
+     * `budget` bytes allow.  WAIT: `pos` is the change count last seen,
+     * ~0 to learn it at once. */
+    DWORD record;
+    DWORD pos;
+    DWORD backwards;
+    DWORD budget;
+    /* REPORT: followed by the SID, the strings (each NUL-terminated) and the data */
+    WORD  type;
+    WORD  category;
+    DWORD event_id;
+    DWORD sid_len;
+    DWORD num_strings;
+    DWORD strings_len;      /* bytes */
+    DWORD data_len;
+};
+
+struct wine_eventlog_reply
+{
+    DWORD magic;
+    DWORD status;           /* a Win32 error code */
+    DWORD size;             /* of the whole message */
+    WCHAR log[WINE_EVENTLOG_NAME_LEN];     /* OPEN: the log's own name */
+    DWORD count;            /* INFO: records; READ: records that follow */
+    DWORD oldest;           /* INFO: the oldest record's number, 0 if empty */
+    DWORD full;             /* INFO */
+    DWORD value;            /* REPORT: the record's number; WAIT: the change count */
+    /* READ: the records; BACKUP: a file image */
+};
+
+/* Where a read starts, in the numbers of a log whose records are first..next-1:
+ * a seek (record) must name one of them; otherwise the position between
+ * records (pos: 0 not yet) is read forwards or backwards from. */
+static inline DWORD wine_eventlog_start( DWORD first, DWORD next, DWORD record, DWORD pos,
+                                         BOOL backwards, DWORD *start )
+{
+    DWORD s;
+
+    if (record)
+    {
+        if (record < first || record >= next) return ERROR_INVALID_PARAMETER;
+        *start = record;
+        return ERROR_SUCCESS;
+    }
+    if (!backwards)
+    {
+        *start = pos ? (pos > first ? pos : first) : first;
+        return *start < next ? ERROR_SUCCESS : ERROR_HANDLE_EOF;
+    }
+    s = pos ? (pos < next ? pos : next) : next;
+    if (s <= first) return ERROR_HANDLE_EOF;
+    *start = s - 1;
+    return ERROR_SUCCESS;
+}
+
+#endif /* __WINE_WINE_EVENTLOG_H */
