From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: NtQueryQuotaInformationFile, NtSetQuotaInformationFile

The volumes here track and enforce no disk quotas (FileFsControlInformation says so), and a volume without quotas answers both calls with STATUS_INVALID_DEVICE_REQUEST, as Windows documents it; the handle is checked first. They, and their Zw names, were not exported.
---
--- a/dlls/ntdll/misc.c
+++ b/dlls/ntdll/misc.c
@@ -299,3 +299,39 @@
     *size = 0;
     return STATUS_SUCCESS;
 }
+
+/* (wine-sg 8282) Disk quotas: the volumes here track and enforce none (FileFsControlInformation says so), and
+ * a volume without quotas answers both calls with STATUS_INVALID_DEVICE_REQUEST, as Windows documents it for
+ * file systems that do not support them. The handle is checked first. */
+static NTSTATUS quota_file_check( HANDLE file, IO_STATUS_BLOCK *io )
+{
+    FILE_ACCESS_INFORMATION info;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+
+    if (!io) return STATUS_ACCESS_VIOLATION;
+    if ((status = NtQueryInformationFile( file, &iosb, &info, sizeof(info), FileAccessInformation ))) return status;
+#ifdef SG_MUTANT_QUOTA_ANY
+    return STATUS_SUCCESS;
+#endif
+    return STATUS_INVALID_DEVICE_REQUEST;
+}
+
+/******************************************************************
+ *              NtQueryQuotaInformationFile  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtQueryQuotaInformationFile( HANDLE file, IO_STATUS_BLOCK *io, void *buffer, ULONG length,
+                                             BOOLEAN single, void *sids, ULONG sids_length, PSID start, BOOLEAN restart )
+{
+    TRACE( "(%p, %p, %p, %lu, %u, %p, %lu, %p, %u)\n", file, io, buffer, length, single, sids, sids_length, start, restart );
+    return quota_file_check( file, io );
+}
+
+/******************************************************************
+ *              NtSetQuotaInformationFile  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtSetQuotaInformationFile( HANDLE file, IO_STATUS_BLOCK *io, void *buffer, ULONG length )
+{
+    TRACE( "(%p, %p, %p, %lu)\n", file, io, buffer, length );
+    return quota_file_check( file, io );
+}
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -331,7 +331,7 @@
 # @ stub NtQueryOpenSubKeys
 @ stdcall -syscall NtQueryPerformanceCounter(ptr ptr)
 # @ stub NtQueryPortInformationProcess
-# @ stub NtQueryQuotaInformationFile
+@ stdcall NtQueryQuotaInformationFile(long ptr ptr long long ptr long ptr long)
 @ stdcall -syscall NtQuerySection(long long ptr long ptr)
 @ stdcall -syscall NtQuerySecurityObject(long long ptr long ptr)
 @ stdcall -syscall NtQuerySemaphore (long long ptr long ptr)
@@ -425,7 +425,7 @@
 # @ stub NtSetLowEventPair
 # @ stub NtSetLowWaitHighEventPair
 # @ stub NtSetLowWaitHighThread
-# @ stub NtSetQuotaInformationFile
+@ stdcall NtSetQuotaInformationFile(long ptr ptr long)
 @ stdcall -syscall NtSetSecurityObject(long long ptr)
 # @ stub NtSetSystemEnvironmentValue
 # @ stub NtSetSystemEnvironmentValueEx
@@ -1422,7 +1422,7 @@
 # @ stub ZwQueryOpenSubKeys
 @ stdcall -private -syscall ZwQueryPerformanceCounter(ptr ptr) NtQueryPerformanceCounter
 # @ stub ZwQueryPortInformationProcess
-# @ stub ZwQueryQuotaInformationFile
+@ stdcall -private ZwQueryQuotaInformationFile(long ptr ptr long long ptr long ptr long) NtQueryQuotaInformationFile
 @ stdcall -private -syscall ZwQuerySection(long long ptr long ptr) NtQuerySection
 @ stdcall -private -syscall ZwQuerySecurityObject(long long ptr long ptr) NtQuerySecurityObject
 @ stdcall -private -syscall ZwQuerySemaphore(long long ptr long ptr) NtQuerySemaphore
@@ -1506,7 +1506,7 @@
 # @ stub ZwSetLowEventPair
 # @ stub ZwSetLowWaitHighEventPair
 # @ stub ZwSetLowWaitHighThread
-# @ stub ZwSetQuotaInformationFile
+@ stdcall -private ZwSetQuotaInformationFile(long ptr ptr long) NtSetQuotaInformationFile
 @ stdcall -private -syscall ZwSetSecurityObject(long long ptr) NtSetSecurityObject
 # @ stub ZwSetSystemEnvironmentValue
 # @ stub ZwSetSystemEnvironmentValueEx
