+/* "mm:ss", and "h:mm:ss" from one hour on */
+static void format_time(unsigned int seconds, WCHAR *buffer)
+{
+#ifdef SG_MUTANT_WMP_TIMESTRING
+    swprintf(buffer, 32, L"%u", seconds);
+    return;
+#endif
+    if (seconds >= 3600)
+        swprintf(buffer, 32, L"%u:%02u:%02u", seconds / 3600, (seconds / 60) % 60, seconds % 60);
+    else
+        swprintf(buffer, 32, L"%02u:%02u", seconds / 60, seconds % 60);
+}
+
+
+static HRESULT attrs_set(struct wmp_attribute **attrs, unsigned int *count, unsigned int *size, const WCHAR *name,
+        const WCHAR *value)
+{
+    WCHAR *value_copy;
+    unsigned int i;
+
+    for (i = 0; i < *count; i++)
+        if (!_wcsicmp((*attrs)[i].name, name)) break;
+
+    if (!(value_copy = wcsdup(value ? value : L"")))
+        return E_OUTOFMEMORY;
+
+    if (i < *count)
+    {
+        free((*attrs)[i].value);
+        (*attrs)[i].value = value_copy;
+        return S_OK;
+    }
+
+    if (*count == *size)
+    {
+        unsigned int new_size = *size ? *size * 2 : 4;
+        struct wmp_attribute *new_attrs = realloc(*attrs, new_size * sizeof(**attrs));
+        if (!new_attrs)
+        {
+            free(value_copy);
+            return E_OUTOFMEMORY;
+        }
+        *attrs = new_attrs;
+        *size = new_size;
+    }
+    (*attrs)[*count].name = wcsdup(name);
+    (*attrs)[*count].value = value_copy;
+    if (!(*attrs)[*count].name)
+    {
+        free(value_copy);
+        return E_OUTOFMEMORY;
+    }
+    (*count)++;
+    return S_OK;
+}
+
+static const WCHAR *attrs_get(const struct wmp_attribute *attrs, unsigned int count, const WCHAR *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+        if (!_wcsicmp(attrs[i].name, name)) return attrs[i].value;
+    return NULL;
+}
+
+static void attrs_free(struct wmp_attribute *attrs, unsigned int count)
+{
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+    {
+        free(attrs[i].name);
+        free(attrs[i].value);
+    }
+    free(attrs);
+}
