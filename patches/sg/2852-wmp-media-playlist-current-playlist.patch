+/* the position of the current media in the current playlist, or -1 */
+static LONG current_item_index(WindowsMediaPlayer *This)
+{
+    LONG i;
+
+    if (!This->playlist || !This->media)
+        return -1;
+    for (i = 0; i < This->playlist->count; i++)
+        if (This->playlist->items[i] == &This->media->IWMPMedia_iface) return i;
+    return -1;
