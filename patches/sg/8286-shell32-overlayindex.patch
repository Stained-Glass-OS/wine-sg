From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHGetFileInfoW gives the overlay index for SHGFI_OVERLAYINDEX

SHGFI_OVERLAYINDEX was ignored with a FIXME. As documented, with SHGFI_ICON the item's overlay index now goes in the top eight bits of iIcon: what its folder's IShellIconOverlay gives (the icon overlay handlers). Shotcut and WinDirStat ask for it.
---
--- a/dlls/shell32/shell32_main.c
+++ b/dlls/shell32/shell32_main.c
@@ -353,8 +353,6 @@
     }
 
 
-    if (flags & SHGFI_OVERLAYINDEX)
-        FIXME("SHGFI_OVERLAYINDEX unhandled\n");
 
     /* get the iconlocation */
     if (SUCCEEDED(hr) && (flags & SHGFI_ICONLOCATION ))
@@ -515,6 +513,24 @@
         IImageList_Release( icon_list );
     }
 
+#ifndef SG_MUTANT_NO_OVERLAY_INDEX
+    /* (wine-sg 8286) SHGFI_OVERLAYINDEX (with SHGFI_ICON): the item's overlay index in the top eight bits of
+     * iIcon -- what its folder's IShellIconOverlay gives (the overlay handlers; a shortcut's arrow is drawn
+     * into its icon here, so it has no overlay of its own) */
+    if (ret && (flags & SHGFI_OVERLAYINDEX) && (flags & SHGFI_ICON) && psfParent && pidlLast)
+    {
+        IShellIconOverlay *overlay;
+        int index = -1;
+
+        if (SUCCEEDED(IShellFolder_QueryInterface( psfParent, &IID_IShellIconOverlay, (void **)&overlay )))
+        {
+            if (IShellIconOverlay_GetOverlayIndex( overlay, pidlLast, &index ) != S_OK) index = -1;
+            IShellIconOverlay_Release( overlay );
+        }
+        if (index > 0) psfi->iIcon = (psfi->iIcon & 0x00ffffff) | ((index & 0xff) << 24);
+    }
+#endif
+
     if (flags & ~SHGFI_KNOWN_FLAGS)
         FIXME("unknown flags %08x\n", flags & ~SHGFI_KNOWN_FLAGS);
 
