+/* a stream opened on a file for writing gives its data back to it */
+static HRESULT write_back( struct stream *stream )
+{
+    HRESULT hr;
+
+#ifdef SG_MUTANT_STREAM_NO_WRITEBACK
+    return S_OK;
+#endif
+    if (!stream->path || !stream->dirty) return S_OK;
+    if ((hr = save_file( stream, stream->path, TRUE )) == S_OK) stream->dirty = FALSE;
+    return hr;
+}
