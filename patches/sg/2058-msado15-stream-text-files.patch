+/* bytes put at the position, over what is there; a gap before them is zero */
+static HRESULT put_bytes( struct stream *stream, const BYTE *data, LONG len )
+{
+    HRESULT hr;
+
+    if (len < 0 || stream->pos > MAXLONG - len) return E_OUTOFMEMORY;
+    if ((hr = reserve_buffer( stream, stream->pos + len )) != S_OK) return hr;
+    if (len) memcpy( stream->buf + stream->pos, data, len );
+    stream->pos += len;
+    if (stream->pos > stream->size) stream->size = stream->pos;
+    stream->dirty = TRUE;
+    return S_OK;
