+static HRESULT load_file( struct stream *stream, const WCHAR *path )
+{
+    HANDLE file;
+    LARGE_INTEGER size;
+    BYTE *data = NULL;
+    DWORD read = 0;
+    HRESULT hr = S_OK;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return MAKE_ADO_HRESULT( adErrOpeningFile );
+    if (!GetFileSizeEx( file, &size ) || size.QuadPart > MAXLONG) hr = MAKE_ADO_HRESULT( adErrReadFile );
+    else if (!(data = malloc( max( size.LowPart, 1 ) ))) hr = E_OUTOFMEMORY;
+    else if (size.LowPart && (!ReadFile( file, data, size.LowPart, &read, NULL ) || read != size.LowPart))
+        hr = MAKE_ADO_HRESULT( adErrReadFile );
+    CloseHandle( file );
+    if (hr != S_OK)
+    {
+        free( data );
+        return hr;
+    }
+
+    free( stream->buf );
+    stream->buf = data;
+    stream->size = stream->allocated = size.LowPart;
+    stream->pos = 0;
+    return S_OK;
+}
+
+static HRESULT save_file( struct stream *stream, const WCHAR *path, BOOL overwrite )
+{
+    HANDLE file;
+    DWORD written = 0;
+    BOOL ok;
+
+#ifdef SG_MUTANT_STREAM_NO_OVERWRITE
+    overwrite = TRUE;
+#endif
+    file = CreateFileW( path, GENERIC_WRITE, FILE_SHARE_READ, NULL, overwrite ? CREATE_ALWAYS : CREATE_NEW,
+                        FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return MAKE_ADO_HRESULT( adErrWriteFile );
+    ok = !stream->size || (WriteFile( file, stream->buf, stream->size, &written, NULL ) && written == (DWORD)stream->size);
+    CloseHandle( file );
+    return ok ? S_OK : MAKE_ADO_HRESULT( adErrWriteFile );
+}
