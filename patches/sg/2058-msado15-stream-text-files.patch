+static HRESULT resize_buffer( struct stream *stream, LONG size )
+{
+    HRESULT hr;
+
+    if ((hr = reserve_buffer( stream, size )) != S_OK) return hr;
+    if (size < stream->size) memset( stream->buf + size, 0, stream->size - size );
