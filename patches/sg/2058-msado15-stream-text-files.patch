+static inline WCHAR swap16( WCHAR c )
+{
+    return (c << 8) | (c >> 8);
+}
+
+/* the code page a character set name stands for: the common names, windows-N and iso-8859-N, else the
+ * registered names; 0 when unknown */
+static UINT charset_codepage( const WCHAR *name )
+{
+    static const struct { const WCHAR *name; UINT cp; } names[] =
+    {
+        { L"unicode", 1200 }, { L"utf-16", 1200 }, { L"utf-16le", 1200 }, { L"ucs-2", 1200 }, { L"utf16", 1200 },
+        { L"unicodefffe", 1201 }, { L"utf-16be", 1201 },
+        { L"utf-8", CP_UTF8 }, { L"utf8", CP_UTF8 }, { L"utf-7", CP_UTF7 },
+        { L"us-ascii", 20127 }, { L"ascii", 20127 }, { L"ansi_x3.4-1968", 20127 },
+        { L"latin1", 28591 }, { L"shift_jis", 932 }, { L"shift-jis", 932 }, { L"euc-kr", 949 }, { L"big5", 950 },
+        { L"gb2312", 936 }, { L"koi8-r", 20866 }, { L"_autodetect", 0 },
+    };
+    WCHAR key[MAX_PATH], value[64], *end;
+    DWORD size, cp;
+    HKEY hkey;
+    unsigned int i;
+
+    if (!name) return 1200;
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcsicmp( name, names[i].name )) return names[i].cp;
+    if (!wcsnicmp( name, L"windows-", 8 ) && (cp = wcstoul( name + 8, &end, 10 )) && !*end) return cp;
+    if (!wcsnicmp( name, L"iso-8859-", 9 ) && (cp = wcstoul( name + 9, &end, 10 )) && !*end && cp >= 1 && cp <= 15)
+        return 28590 + cp;
+    if (!wcsnicmp( name, L"cp", 2 ) && (cp = wcstoul( name + 2, &end, 10 )) && !*end) return cp;
+
+    if (lstrlenW( name ) < 100)
+    {
+        swprintf( key, ARRAY_SIZE(key), L"MIME\\Database\\Charset\\%s", name );
+        if (!RegOpenKeyExW( HKEY_CLASSES_ROOT, key, 0, KEY_READ, &hkey ))
+        {
+            size = sizeof(cp);
+            if (!RegQueryValueExW( hkey, L"InternetEncoding", NULL, NULL, (BYTE *)&cp, &size ))
+            {
+                RegCloseKey( hkey );
+                return cp;
+            }
+            size = sizeof(value) - sizeof(WCHAR);
+            if (!RegQueryValueExW( hkey, L"AliasForCharset", NULL, NULL, (BYTE *)value, &size ))
+            {
+                value[size / sizeof(WCHAR)] = 0;
+                RegCloseKey( hkey );
+                if (wcsicmp( value, name )) return charset_codepage( value );
+                return 0;
+            }
+            RegCloseKey( hkey );
+        }
+    }
+    return 0;
+}
+
+static UINT stream_codepage( const struct stream *stream )
+{
+    return charset_codepage( stream->charset );
+}
+
+/* the byte order mark of a character set, which text begins with */
+static const BYTE *bom_for( UINT cp, LONG *len )
+{
+#ifdef SG_MUTANT_STREAM_NOBOM
+    *len = 0;
+    return NULL;
+#endif
+    static const BYTE utf16le[] = { 0xff, 0xfe }, utf16be[] = { 0xfe, 0xff }, utf8[] = { 0xef, 0xbb, 0xbf };
+
+    switch (cp)
+    {
+    case 1200: *len = 2; return utf16le;
+    case 1201: *len = 2; return utf16be;
+    case CP_UTF8: *len = 3; return utf8;
+    }
+    *len = 0;
+    return NULL;
+}
+
+/* the bytes of a text in a code page */
+static HRESULT encode_text( UINT cp, const WCHAR *text, int chars, BYTE **out, LONG *len )
+{
+    int n;
+
+    *out = NULL;
+    if (cp == 1200 || cp == 1201)
+    {
+        WCHAR *buf;
+        int i;
+
+        if (!(buf = malloc( chars * sizeof(WCHAR) + 1 ))) return E_OUTOFMEMORY;
+        for (i = 0; i < chars; i++) buf[i] = cp == 1201 ? swap16( text[i] ) : text[i];
+        *out = (BYTE *)buf;
+        *len = chars * sizeof(WCHAR);
+        return S_OK;
+    }
+    if (!chars)
+    {
+        *out = malloc( 1 );
+        *len = 0;
+        return *out ? S_OK : E_OUTOFMEMORY;
+    }
+    if (!(n = WideCharToMultiByte( cp, 0, text, chars, NULL, 0, NULL, NULL ))) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (!(*out = malloc( n ))) return E_OUTOFMEMORY;
+    WideCharToMultiByte( cp, 0, text, chars, (char *)*out, n, NULL, NULL );
+    *len = n;
+    return S_OK;
+}
+
+/* the characters of bytes in a code page (whole characters only) */
+static HRESULT decode_text( UINT cp, const BYTE *data, LONG len, WCHAR **out, int *chars )
+{
+    int n;
+
+    *out = NULL;
+    if (cp == 1200 || cp == 1201)
+    {
+        int i;
+
+        n = len / sizeof(WCHAR);
+        if (!(*out = malloc( (n + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        for (i = 0; i < n; i++)
+        {
+            WCHAR c = ((const WCHAR *)data)[i];
+            (*out)[i] = cp == 1201 ? swap16( c ) : c;
+        }
+        *chars = n;
+        return S_OK;
+    }
+    if (!len)
+    {
+        *out = malloc( sizeof(WCHAR) );
+        *chars = 0;
+        return *out ? S_OK : E_OUTOFMEMORY;
+    }
+    if (!(n = MultiByteToWideChar( cp, 0, (const char *)data, len, NULL, 0 ))) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    if (!(*out = malloc( (n + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    MultiByteToWideChar( cp, 0, (const char *)data, len, *out, n );
+    *chars = n;
+    return S_OK;
+}
+
+/* text begins after the byte order mark; the position moves past it when it is at the start */
+static void skip_bom( struct stream *stream, UINT cp )
+{
+    LONG len;
+    const BYTE *bom = bom_for( cp, &len );
+
+    if (bom && !stream->pos && stream->size >= len && !memcmp( stream->buf, bom, len )) stream->pos = len;
+}
