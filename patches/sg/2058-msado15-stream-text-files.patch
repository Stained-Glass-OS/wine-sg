+/* A source that names a file: "URL=" and "file:" forms are taken apart to the path */
+static WCHAR *source_path( const WCHAR *src )
+{
+    WCHAR *path, *p;
+
+    if (!wcsnicmp( src, L"URL=", 4 )) src += 4;
+    if (!wcsnicmp( src, L"file:///", 8 )) src += 8;
+    else if (!wcsnicmp( src, L"file://", 7 )) src += 5;   /* file://server/share -> //server/share */
+    else if (!wcsnicmp( src, L"file:", 5 )) src += 5;
+    if (!(path = wcsdup( src ))) return NULL;
+    for (p = path; *p; p++) if (*p == '/') *p = '\\';
+    return path;
+}
