+/* decode the rest of a text stream; the byte length of the first count characters is told */
+static HRESULT remaining_text( struct stream *stream, WCHAR **text, int *chars )
+{
+    UINT cp = stream_codepage( stream );
+
+    if (!cp) return MAKE_ADO_HRESULT( adErrInvalidArgument );
+    skip_bom( stream, cp );
+    if (stream->pos >= stream->size)
+    {
+        *text = malloc( sizeof(WCHAR) );
+        *chars = 0;
+        return *text ? S_OK : E_OUTOFMEMORY;
+    }
+    return decode_text( cp, stream->buf + stream->pos, stream->size - stream->pos, text, chars );
+}
+
+/* how many bytes the first count characters of the text take in the character set */
+static LONG text_bytes( struct stream *stream, const WCHAR *text, int count )
+{
+    UINT cp = stream_codepage( stream );
+    BYTE *bytes;
+    LONG len = 0;
+
+    if (cp == 1200 || cp == 1201) return count * sizeof(WCHAR);
+    if (encode_text( cp, text, count, &bytes, &len ) != S_OK) return 0;
+    free( bytes );
+    return len;
 }
 
