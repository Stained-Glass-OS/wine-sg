+/******************************************************************
+ *              SymEnumSourceLines (DBGHELP.@)
+ *
+ */
+#define ESLFLAG_FULLPATH 0x1
+#define ESLFLAG_NEAR     0x2
+#define ESLFLAG_PREV     0x4
+#define ESLFLAG_NEXT     0x8
+
+struct enum_source_lines
+{
+    DWORD line;
+    DWORD flags;
+    PSYM_ENUMLINES_CALLBACK cb;
+    PSYM_ENUMLINES_CALLBACKW cbW;
+    PVOID user;
+    BOOL have_best, stop;
+    DWORD best_line;
+    SRCCODEINFO best;
+    SRCCODEINFOW bestW;
+};
+
+/* Whether line number l is a better answer than the one kept for this search. */
+static BOOL esl_better(const struct enum_source_lines *esl, DWORD l)
+{
+    DWORD diff, best_diff;
+
+    if (!esl->have_best) return TRUE;
+    if (esl->flags & ESLFLAG_PREV) return l > esl->best_line;
+    if (esl->flags & ESLFLAG_NEXT) return l < esl->best_line;
+    diff = l > esl->line ? l - esl->line : esl->line - l;
+    best_diff = esl->best_line > esl->line ? esl->best_line - esl->line : esl->line - esl->best_line;
+    return diff < best_diff;
+}
+
+static BOOL esl_wanted(const struct enum_source_lines *esl, DWORD l)
+{
+    if (!esl->line) return TRUE;
+    if (esl->flags & ESLFLAG_PREV) return l <= esl->line;
+    if (esl->flags & ESLFLAG_NEXT) return l >= esl->line;
+    return l == esl->line;
+}
+
+static BOOL CALLBACK enum_source_lines_cb(PSRCCODEINFO sci, PVOID user)
+{
+    struct enum_source_lines *esl = user;
+
+    if (!esl->line || (!(esl->flags & (ESLFLAG_NEAR | ESLFLAG_PREV | ESLFLAG_NEXT)) && sci->LineNumber == esl->line))
+    {
+        if (!esl->cb(sci, esl->user)) return FALSE;
+        return TRUE;
+    }
+    if (esl->flags & (ESLFLAG_NEAR | ESLFLAG_PREV | ESLFLAG_NEXT))
+    {
+        if ((esl->flags & ESLFLAG_NEAR) || esl_wanted(esl, sci->LineNumber))
+        {
+            if (esl_better(esl, sci->LineNumber))
+            {
+                esl->best = *sci;
+                esl->best_line = sci->LineNumber;
+                esl->have_best = TRUE;
+            }
+        }
+    }
+    return TRUE;
+}
+
+static BOOL CALLBACK enum_source_lines_cbW(PSRCCODEINFOW sci, PVOID user)
+{
+    struct enum_source_lines *esl = user;
+
+    if (!esl->line || (!(esl->flags & (ESLFLAG_NEAR | ESLFLAG_PREV | ESLFLAG_NEXT)) && sci->LineNumber == esl->line))
+        return esl->cbW(sci, esl->user);
+    if (esl->flags & (ESLFLAG_NEAR | ESLFLAG_PREV | ESLFLAG_NEXT))
+    {
+        if ((esl->flags & ESLFLAG_NEAR) || esl_wanted(esl, sci->LineNumber))
+        {
+            if (esl_better(esl, sci->LineNumber))
+            {
+                esl->bestW = *sci;
+                esl->best_line = sci->LineNumber;
+                esl->have_best = TRUE;
+            }
+        }
+    }
+    return TRUE;
+}
+
 /******************************************************************
  *              SymEnumSourceLines (DBGHELP.@)
  *
@@ -293,11 +381,24 @@ BOOL WINAPI SymEnumSourceLines(HANDLE hProcess, ULONG64 base, PCSTR obj,
                                PSYM_ENUMLINES_CALLBACK EnumLinesCallback,
                                PVOID UserContext)
 {
-    FIXME("%p %I64x %s %s %lu %lu %p %p: stub!\n",
-          hProcess, base, debugstr_a(obj), debugstr_a(file),
+    struct enum_source_lines esl = {0};
+    BOOL ret;
+
+    TRACE("%p %I64x %s %s %lu %lu %p %p\n", hProcess, base, debugstr_a(obj), debugstr_a(file),
           line, flags, EnumLinesCallback, UserContext);
-    SetLastError(ERROR_NOT_SUPPORTED);
-    return FALSE;
+
+    if (!EnumLinesCallback)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    esl.line = line;
+    esl.flags = flags;
+    esl.cb = EnumLinesCallback;
+    esl.user = UserContext;
+    ret = SymEnumLines(hProcess, base, obj, file, enum_source_lines_cb, &esl);
+    if (ret && esl.have_best) ret = EnumLinesCallback(&esl.best, UserContext) || TRUE;
+    return ret;
 }
 
