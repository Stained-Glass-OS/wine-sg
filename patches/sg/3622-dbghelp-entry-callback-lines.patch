  */
 BOOL WINAPI SymSrvGetFileIndexesW(PCWSTR file, GUID* guid, PDWORD pdw1, PDWORD pdw2, DWORD flags)
 {
-    FIXME("(%s, %p, %p, %p, 0x%08lx): stub!\n", debugstr_w(file), guid, pdw1, pdw2, flags);
+    SYMSRV_INDEX_INFOW info;
+    const WCHAR *ext;
 
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    TRACE("(%s, %p, %p, %p, 0x%08lx)\n", debugstr_w(file), guid, pdw1, pdw2, flags);
+
+    if (!file || !guid || !pdw1 || !pdw2)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    info.sizeofstruct = sizeof(info);
+    if (!SymSrvGetFileIndexInfoW(file, &info, 0)) return FALSE;
+    /* the three values a symbol store files a file under: images by time stamp and
+     * size, PDB files by GUID (or signature) and age */
+    memset(guid, 0, sizeof(*guid));
+    ext = wcsrchr(file, '.');
+    if (ext && !wcsicmp(ext, L".pdb"))
+    {
+        if (!memcmp(&info.guid, guid, sizeof(*guid)))
+        {
+            *pdw1 = info.sig;
+            *pdw2 = info.age;
+        }
+        else
+        {
+            *guid = info.guid;
+            *pdw1 = info.age;
+            *pdw2 = 0;
+        }
+    }
+    else
+    {
+        *pdw1 = info.timestamp;
+        *pdw2 = info.size;
+    }
+    return TRUE;
 }
