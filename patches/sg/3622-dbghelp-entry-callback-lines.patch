diff --git a/dlls/dbghelp/tests/dbghelp.c b/dlls/dbghelp/tests/dbghelp.c
index f7313c3..7158e67 100644
--- a/dlls/dbghelp/tests/dbghelp.c
+++ b/dlls/dbghelp/tests/dbghelp.c
@@ -1650,6 +1650,35 @@ static void test_refresh_modules(void)
     ok(ret, "SymCleanup failed: %lu\n", GetLastError());
 }
 
+static PVOID WINAPI sg_fentry_cb(HANDLE process, ULONG64 addr, ULONG64 user)
+{
+    return user == 0x1234 && addr == 0x4000 ? (PVOID)0xdead : NULL;
+}
+
+static void test_sg_function_entry_callback(void)
+{
+    PVOID entry;
+    BOOL ret;
+
+    ret = SymRegisterFunctionEntryCallback64(GetCurrentProcess(), sg_fentry_cb, 0x1234);
+    ok(ret, "got error %lu\n", GetLastError());
+    entry = SymFunctionTableAccess64(GetCurrentProcess(), 0x4000);
+    ok(entry == (PVOID)0xdead, "got %p\n", entry);
+    entry = SymFunctionTableAccess64(GetCurrentProcess(), 0x5000);
+    ok(!entry, "got %p\n", entry);
+    ret = SymRegisterFunctionEntryCallback64(GetCurrentProcess(), NULL, 0);
+    ok(ret, "got error %lu\n", GetLastError());
+    entry = SymFunctionTableAccess64(GetCurrentProcess(), 0x4000);
+    ok(!entry, "got %p\n", entry);
+    ret = SymRegisterFunctionEntryCallback64((HANDLE)0xdeadbeef, NULL, 0);
+    ok(!ret, "expected failure\n");
+
+    ret = SymSrvGetFileIndexesW(L"nonexistent-file.dll", &(GUID){0}, &(DWORD){0}, &(DWORD){0}, 0);
+    ok(!ret, "expected failure\n");
+    ret = SymEnumSourceLines(GetCurrentProcess(), 0, NULL, NULL, 0, 0, NULL, NULL);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d error %lu\n", ret, GetLastError());
+}
+
 START_TEST(dbghelp)
 {
     BOOL ret;
@@ -1665,6 +1694,7 @@ START_TEST(dbghelp)
 
     test_stack_walk();
     test_search_path();
+    test_sg_function_entry_callback();
 
     ret = SymCleanup(GetCurrentProcess());
     ok(ret, "got error %lu\n", GetLastError());
