-    FIXME("(%p) (%s, %s, %ld %p %p): stub\n", hProcess, debugstr_w(ModuleName), debugstr_w(FileName),
-                dwLineNumber, plDisplacement, Line);
-    return FALSE;
+    struct line_from_name lfn;
+    char moduleA[MAX_PATH], fileA[MAX_PATH];
+    static WCHAR fileW[MAX_PATH];
+
+    TRACE("(%p) (%s, %s, %ld %p %p)\n", hProcess, debugstr_w(ModuleName), debugstr_w(FileName),
+          dwLineNumber, plDisplacement, Line);
+
+    if (!Line || Line->SizeOfStruct < sizeof(*Line) || !FileName)
+    {
