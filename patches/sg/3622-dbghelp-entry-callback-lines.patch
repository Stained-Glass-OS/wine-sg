From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dbghelp: function entry callbacks, line lookups, source index values (3622)

dbghelp: function entry callbacks, SymGetLineFromName, SymEnumSourceLines, SymSrvGetFileIndexes

SymRegisterFunctionEntryCallback(64) keeps the callback per process and
SymFunctionTableAccess(64) asks it first. SymGetLineFromName/64/W64 find the
address of a numbered source line by walking the module's line tables.
SymEnumSourceLines(W) filter the line tables by line number and the
NEAR/PREV/NEXT flags. SymSrvGetFileIndexesW returns the symbol store index
values (time stamp and size of an image, GUID and age of a PDB).
---
diff --git a/dlls/dbghelp/dbghelp_private.h b/dlls/dbghelp/dbghelp_private.h
index 8def6a7..563adab 100644
--- a/dlls/dbghelp/dbghelp_private.h
+++ b/dlls/dbghelp/dbghelp_private.h
@@ -499,6 +499,9 @@ struct process
 
     PSYMBOL_REGISTERED_CALLBACK64       reg_cb;
     PSYMBOL_REGISTERED_CALLBACK reg_cb32;
+    PSYMBOL_FUNCENTRY_CALLBACK64 fentry_cb;
+    PSYMBOL_FUNCENTRY_CALLBACK  fentry_cb32;
+    ULONG64                     fentry_user;
     BOOL                        reg_is_unicode;
     DWORD64                     reg_user;
 
diff --git a/dlls/dbghelp/module.c b/dlls/dbghelp/module.c
index b8848f4..fc86283 100644
--- a/dlls/dbghelp/module.c
+++ b/dlls/dbghelp/module.c
@@ -1682,6 +1682,19 @@ PVOID WINAPI SymFunctionTableAccess64(HANDLE hProcess, DWORD64 AddrBase)
     struct module*      module;
 
     if (!pcs) return NULL;
+    /* a registered function entry callback gets the first try */
+#ifndef SG_MUTANT_DBG_FENTRY
+    if (pcs->fentry_cb)
+    {
+        PVOID entry = pcs->fentry_cb(hProcess, AddrBase, pcs->fentry_user);
+        if (entry) return entry;
+    }
+    else if (pcs->fentry_cb32)
+    {
+        PVOID entry = pcs->fentry_cb32(hProcess, (DWORD)AddrBase, (PVOID)(ULONG_PTR)pcs->fentry_user);
+        if (entry) return entry;
+    }
+#endif
     module = module_find_by_addr(pcs, AddrBase);
     if (!module || !module->cpu->find_runtime_function) return NULL;
 
