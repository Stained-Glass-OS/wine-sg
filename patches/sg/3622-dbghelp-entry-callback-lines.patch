+struct line_from_name
+{
+    DWORD line;
+    BOOL found;
+    SRCCODEINFO sci;
+};
+
+static BOOL CALLBACK line_from_name_cb(PSRCCODEINFO sci, PVOID user)
+{
+    struct line_from_name *lfn = user;
+
+    if (sci->LineNumber != lfn->line) return TRUE;
+    lfn->sci = *sci;
+    lfn->found = TRUE;
+    return FALSE;
+}
+
+/* the line of a source file by its number: the address of the first code
+ * generated for it (found by walking the module's line tables) */
+static BOOL get_line_from_name(HANDLE hProcess, PCSTR ModuleName, PCSTR FileName, DWORD dwLineNumber,
+                               struct line_from_name *lfn)
+{
+    struct process *pcs = process_find_by_handle(hProcess);
+    struct module *module;
+
+    if (!pcs || !FileName)
+    {
+        SetLastError(pcs ? ERROR_INVALID_PARAMETER : ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (ModuleName)
+    {
+        WCHAR nameW[MAX_PATH];
+        MultiByteToWideChar(CP_ACP, 0, ModuleName, -1, nameW, ARRAY_SIZE(nameW));
+        module = module_find_by_nameW(pcs, nameW);
+    }
+    else
+        module = pcs->lmodules;
+    if (!module || module->type == DMT_UNKNOWN)
+    {
+        SetLastError(ERROR_MOD_NOT_FOUND);
+        return FALSE;
+    }
+    lfn->line = dwLineNumber;
+    lfn->found = FALSE;
+    SymEnumLines(hProcess, module->module.BaseOfImage, NULL, FileName, line_from_name_cb, lfn);
+    if (!lfn->found)
+    {
+        SetLastError(ERROR_NOT_FOUND);
+        return FALSE;
+    }
+    return TRUE;
+}
+
 BOOL WINAPI SymGetLineFromName(HANDLE hProcess, PCSTR ModuleName, PCSTR FileName,
                 DWORD dwLineNumber, PLONG plDisplacement, PIMAGEHLP_LINE Line)
 {
-    FIXME("(%p) (%s, %s, %ld %p %p): stub\n", hProcess, debugstr_a(ModuleName), debugstr_a(FileName),
-                dwLineNumber, plDisplacement, Line);
-    return FALSE;
+    struct line_from_name lfn;
+
+    TRACE("(%p) (%s, %s, %ld %p %p)\n", hProcess, debugstr_a(ModuleName), debugstr_a(FileName),
+          dwLineNumber, plDisplacement, Line);
+
+    if (!Line || Line->SizeOfStruct < sizeof(*Line))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!get_line_from_name(hProcess, ModuleName, FileName, dwLineNumber, &lfn)) return FALSE;
+    Line->Key = lfn.sci.Key;
+    Line->LineNumber = lfn.sci.LineNumber;
+    Line->FileName = (PCHAR)lfn.sci.FileName;
+    Line->Address = (DWORD)lfn.sci.Address;
+    if (plDisplacement) *plDisplacement = 0;
+    return TRUE;
 }
 
