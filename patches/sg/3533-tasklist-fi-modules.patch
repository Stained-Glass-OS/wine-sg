From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] tasklist: /fi MODULES (3533)

tasklist: /fi MODULES

tasklist /fi "MODULES eq pattern" (and ne) keeps the processes that have a module matching the pattern, wildcards allowed.
---
--- a/programs/tasklist/tasklist.c
+++ b/programs/tasklist/tasklist.c
@@ -184,6 +184,8 @@
     return TRUE;
 }
 
+static WCHAR *tasklist_get_modules(DWORD pid, const WCHAR *pattern);
+
 static BOOL tasklist_check_filters(const struct tasklist_filter *filter,
                                    const struct tasklist_process_info *info)
 {
@@ -197,6 +199,18 @@
         left_dword_operand = 0;
         eval = FALSE;
 
+        if (filter->name == MODULES)
+        {
+            /* the process has a module matching the pattern */
+            WCHAR *found = tasklist_get_modules(info->pid_value, filter->value);
+
+            eval = found != NULL;
+            free(found);
+            if (filter->op == NE) eval = !eval;
+            if (!eval) return FALSE;
+            filter = filter->next;
+            continue;
+        }
         if (filter->name == IMAGENAME)
             left_string_operand = info->image_name;
         else if (filter->name == SESSIONNAME)
@@ -702,6 +716,8 @@
                 filter->name = SERVICES;
             else if (!wcsicmp(filter_name, L"WINDOWTITLE"))
                 filter->name = WINDOWTITLE;
+            else if (!wcsicmp(filter_name, L"MODULES"))
+                filter->name = MODULES;
             else
             {
                 WINE_WARN("Ignoring filter %s.\n", wine_dbgstr_w(filter_name));
--- a/programs/tasklist/tasklist.h
+++ b/programs/tasklist/tasklist.h
@@ -48,6 +48,7 @@
     USERNAME    = 7,
     SERVICES    = 8,
     WINDOWTITLE = 9,
+    MODULES     = 10,
 };
 
 enum tasklist_filter_operator
