+/* the printer's queue window (printui /o), in a process of its own as
+ * Windows' queue windows outlive the program that opened them */
+static BOOL open_printer_queue(const WCHAR *name)
+{
+    WCHAR dir[MAX_PATH], *line;
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    size_t len;
+    BOOL ret;
+
+    GetSystemDirectoryW(dir, ARRAY_SIZE(dir));
+    len = wcslen(dir) + wcslen(name) + 64;
+    if (!(line = malloc(len * sizeof(WCHAR)))) return FALSE;
+    swprintf(line, len, L"\"%s\\rundll32.exe\" printui.dll,PrintUIEntry /o /n \"%s\"", dir, name);
+    ret = CreateProcessW(NULL, line, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi);
+    free(line);
+    if (!ret) return FALSE;
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return TRUE;
+}
