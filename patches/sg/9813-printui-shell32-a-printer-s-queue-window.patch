From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Sat, 28 Nov 2026 00:05:46 -0800
Subject: [PATCH] printui, shell32: a printer's queue window (printui /o), /p /e /k (9813)

Windows opens a printer's queue window from Settings ("Open queue"), the
Printers folder and SHInvokePrinterCommand(PRINTACTION_OPEN), with
rundll32 printui.dll,PrintUIEntry /o /n "printer": the documents waiting,
with their status, owner, pages, size, time submitted and port, and the
Printer menu (Set As Default Printer, Printing Preferences, Pause
Printing, Cancel All Documents, Properties) and Document menu (Pause,
Resume, Restart, Cancel; also on the right-click menu and the Delete
key). printui had none of it, and PRINTACTION_OPEN opened Settings.

- printui: /o is the queue window (queue.c), following the queue every
  second (with 9812, CUPS's queue); /p, /e and /k are the printer's
  properties, printing preferences and a test page (SHInvokePrinterCommand).
- shell32: PRINTACTION_OPEN and PRINTACTION_OPENNETPRN open the queue
  window in a process of its own.

Gate test/cupsjobs-gate.sh (window part).

--- a/dlls/printui/Makefile.in
+++ b/dlls/printui/Makefile.in
@@ -1,8 +1,9 @@
 MODULE    = printui.dll
-IMPORTS   = shell32 winspool user32
+IMPORTS   = shell32 winspool comctl32 user32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
 	printui.c \
+	queue.c \
 	printui.rc
--- a/dlls/printui/printui.c
+++ b/dlls/printui/printui.c
@@ -340,6 +340,24 @@
                 if (error) report_error(&cx, error);
                 break;
 
+#ifndef SG_MUTANT_PRINTUI_NO_QUEUE
+            case 'o':   /* the printer's queue window */
+                if (!printer_name(&cx)) error = ERROR_INVALID_PARAMETER;
+                else error = queue_window(cx.hWnd, printer_name(&cx), cx.nCmdShow);
+                if (error) report_error(&cx, error);
+                break;
+#endif
+            case 'p':   /* the printer's properties */
+            case 'e':   /* its printing preferences */
+            case 'k':   /* a test page */
+                if (!printer_name(&cx)) error = ERROR_INVALID_PARAMETER;
+                else if (!SHInvokePrinterCommandW(cx.hWnd, cx.command == 'p' ? PRINTACTION_PROPERTIES :
+                                                  cx.command == 'e' ? PRINTACTION_DOCUMENTDEFAULTS :
+                                                  PRINTACTION_TESTPAGE, printer_name(&cx), NULL, TRUE))
+                    error = GetLastError();
+                if (error) report_error(&cx, error);
+                break;
+
             default:
             {
                 WCHAR   txtW[3];
--- a/dlls/printui/printui_private.h
+++ b/dlls/printui/printui_private.h
@@ -63,4 +63,7 @@
     LPWSTR  options[OPT_MAX];
     BOOL    flags[FLAG_MAX];
 } context_t;
+
+/* queue.c (wine-sg 9813) */
+DWORD queue_window(HWND owner, const WCHAR *name, int show);
 #endif
--- /dev/null
+++ b/dlls/printui/queue.c
@@ -0,0 +1,538 @@
