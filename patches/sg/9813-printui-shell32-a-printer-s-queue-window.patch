+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winnls.h"
+#include "winspool.h"
+#include "commctrl.h"
+#include "shellapi.h"
+
+#include "wine/debug.h"
+#include "printui_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(printui);
+
+#define QUEUE_CLASS L"PrintUI_PrinterQueue"
+
+#ifndef JOB_STATUS_RESTART
+#define JOB_STATUS_RESTART  0x00000800
+#endif
+#ifndef JOB_STATUS_COMPLETE
+#define JOB_STATUS_COMPLETE 0x00001000
+#endif
+
+enum
+{
+    IDM_DEFAULT = 100,
+    IDM_PREFERENCES,
+    IDM_PAUSE_PRINTER,
+    IDM_CANCEL_ALL,
+    IDM_PROPERTIES,
+    IDM_CLOSE,
+    IDM_DOC_PAUSE,
+    IDM_DOC_RESUME,
+    IDM_DOC_RESTART,
+    IDM_DOC_CANCEL,
+    IDM_REFRESH,
+    IDC_LIST = 200,
+    IDC_STATUS,
+    TIMER_REFRESH = 1,
+};
+
+struct queue
+{
+    WCHAR  *name;
+    HANDLE  printer;
+    HWND    hwnd, list, status;
+    HMENU   printer_menu, doc_menu;
+    BOOL    paused;
+    DWORD   njobs;
+    WCHAR   port[MAX_PATH];
+};
+
+static const struct { const WCHAR *title; int width; int fmt; } columns[] =
+{
+    { L"Document Name", 220, LVCFMT_LEFT },
+    { L"Status",        110, LVCFMT_LEFT },
+    { L"Owner",          90, LVCFMT_LEFT },
+    { L"Pages",          60, LVCFMT_RIGHT },
+    { L"Size",          110, LVCFMT_RIGHT },
+    { L"Submitted",     170, LVCFMT_LEFT },
+    { L"Port",          120, LVCFMT_LEFT },
+};
+
+/* a job's status, as Windows words it in the queue */
+static void job_status_text(const JOB_INFO_2W *job, WCHAR *out, int count)
+{
+    static const struct { DWORD bit; const WCHAR *text; } words[] =
+    {
+        { JOB_STATUS_DELETING,       L"Deleting" },
+        { JOB_STATUS_ERROR,          L"Error" },
+        { JOB_STATUS_PAPEROUT,       L"Paper out" },
+        { JOB_STATUS_OFFLINE,        L"Offline" },
+        { JOB_STATUS_BLOCKED_DEVQ,   L"Blocked" },
+        { JOB_STATUS_USER_INTERVENTION, L"User intervention" },
+        { JOB_STATUS_PAUSED,         L"Paused" },
+        { JOB_STATUS_RESTART,        L"Restarting" },
+        { JOB_STATUS_SPOOLING,       L"Spooling" },
+        { JOB_STATUS_PRINTING,       L"Printing" },
+        { JOB_STATUS_PRINTED,        L"Printed" },
+        { JOB_STATUS_COMPLETE,       L"Sent to printer" },
+        { JOB_STATUS_DELETED,        L"Deleted" },
+    };
+    unsigned int i;
+
+    out[0] = 0;
+    if (job->pStatus && job->pStatus[0])
+    {
+        lstrcpynW(out, job->pStatus, count);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(words); i++)
+    {
+        if (!(job->Status & words[i].bit)) continue;
+        if (out[0]) wcsncat(out, L" - ", count - wcslen(out) - 1);
+        wcsncat(out, words[i].text, count - wcslen(out) - 1);
+    }
+}
+
+static void size_text(DWORD size, WCHAR *out, int count)
+{
+    if (size < 1024) swprintf(out, count, L"%lu bytes", size);
+    else if (size < 1024 * 1024) swprintf(out, count, L"%lu KB", (size + 1023) / 1024);
+    else swprintf(out, count, L"%.1f MB", size / (1024.0 * 1024.0));
+}
+
+/* "4:05:03 PM 11/27/2026": the submitted time is UTC, shown local */
+static void time_text(const SYSTEMTIME *utc, WCHAR *out, int count)
+{
+    SYSTEMTIME local;
+    WCHAR date[64];
+    int len;
+
+    out[0] = 0;
+    if (!utc->wYear) return;
+    if (!SystemTimeToTzSpecificLocalTime(NULL, utc, &local)) local = *utc;
+    if (!(len = GetTimeFormatW(LOCALE_USER_DEFAULT, 0, &local, NULL, out, count))) return;
+    if (len < count - 1 && GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &local, NULL, date, ARRAY_SIZE(date)))
+        swprintf(out + len - 1, count - len + 1, L" %s", date);
+}
+
+static void message_error(struct queue *q, const WCHAR *what, DWORD error)
+{
+    WCHAR text[512], reason[256];
+
+    if (!FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL, error, 0,
+                        reason, ARRAY_SIZE(reason), NULL))
+        swprintf(reason, ARRAY_SIZE(reason), L"Error 0x%08lx.", error);
+    swprintf(text, ARRAY_SIZE(text), L"%s %s", what, reason);
+    MessageBoxW(q->hwnd, text, q->name, MB_OK | MB_ICONERROR);
+}
+
+static void update_title(struct queue *q)
+{
+    WCHAR title[512];
+
+    swprintf(title, ARRAY_SIZE(title), q->paused ? L"%s - Paused" : L"%s", q->name);
+    SetWindowTextW(q->hwnd, title);
+}
+
+/* the printer's status and the documents in its queue, the selection kept */
+static void refresh(struct queue *q)
+{
+    PRINTER_INFO_2W *pi = NULL;
+    JOB_INFO_2W *jobs = NULL;
+    DWORD needed = 0, count = 0, i, *selected = NULL, nsel = 0;
+    WCHAR text[256];
+    int item, focus_id = -1;
+    LVITEMW lvi;
+
+    GetPrinterW(q->printer, 2, NULL, 0, &needed);
+    if (needed && (pi = malloc(needed)) && GetPrinterW(q->printer, 2, (BYTE *)pi, needed, &needed))
+    {
+        BOOL paused = !!(pi->Status & PRINTER_STATUS_PAUSED);
+        if (pi->pPortName) lstrcpynW(q->port, pi->pPortName, ARRAY_SIZE(q->port));
+        if (paused != q->paused)
+        {
+            q->paused = paused;
+            update_title(q);
+        }
+    }
+    free(pi);
+
+    needed = 0;
+    if (!EnumJobsW(q->printer, 0, 0xffff, 2, NULL, 0, &needed, &count) && needed &&
+        (jobs = malloc(needed)) && !EnumJobsW(q->printer, 0, 0xffff, 2, (BYTE *)jobs, needed, &needed, &count))
+        count = 0;
+    if (!jobs) count = 0;
+
+    /* keep what was selected */
+    if ((nsel = SendMessageW(q->list, LVM_GETSELECTEDCOUNT, 0, 0)) && (selected = calloc(nsel, sizeof(DWORD))))
+    {
+        nsel = 0;
+        item = -1;
+        while ((item = SendMessageW(q->list, LVM_GETNEXTITEM, item, LVNI_SELECTED)) != -1)
+        {
+            lvi.mask = LVIF_PARAM;
+            lvi.iItem = item;
+            lvi.iSubItem = 0;
+            if (SendMessageW(q->list, LVM_GETITEMW, 0, (LPARAM)&lvi)) selected[nsel++] = lvi.lParam;
+        }
+    }
+    else nsel = 0;
+    if ((item = SendMessageW(q->list, LVM_GETNEXTITEM, -1, LVNI_FOCUSED)) != -1)
+    {
+        lvi.mask = LVIF_PARAM;
+        lvi.iItem = item;
+        lvi.iSubItem = 0;
+        if (SendMessageW(q->list, LVM_GETITEMW, 0, (LPARAM)&lvi)) focus_id = lvi.lParam;
+    }
+
+    SendMessageW(q->list, WM_SETREDRAW, FALSE, 0);
+    SendMessageW(q->list, LVM_DELETEALLITEMS, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        JOB_INFO_2W *job = &jobs[i];
+        DWORD k;
+
+        memset(&lvi, 0, sizeof(lvi));
+        lvi.mask = LVIF_TEXT | LVIF_PARAM | LVIF_STATE;
+        lvi.iItem = i;
+        lvi.pszText = job->pDocument && job->pDocument[0] ? job->pDocument : (WCHAR *)L"(document)";
+        lvi.lParam = job->JobId;
+        lvi.stateMask = LVIS_SELECTED | LVIS_FOCUSED;
+        for (k = 0; k < nsel; k++) if (selected[k] == job->JobId) lvi.state |= LVIS_SELECTED;
+        if ((int)job->JobId == focus_id) lvi.state |= LVIS_FOCUSED;
+        item = SendMessageW(q->list, LVM_INSERTITEMW, 0, (LPARAM)&lvi);
+        if (item < 0) continue;
+
+        lvi.mask = LVIF_TEXT;
+        lvi.iItem = item;
+        job_status_text(job, text, ARRAY_SIZE(text));
+        lvi.iSubItem = 1; lvi.pszText = text;
+        SendMessageW(q->list, LVM_SETITEMTEXTW, item, (LPARAM)&lvi);
+        lvi.iSubItem = 2; lvi.pszText = job->pUserName ? job->pUserName : (WCHAR *)L"";
+        SendMessageW(q->list, LVM_SETITEMTEXTW, item, (LPARAM)&lvi);
+        if (!job->TotalPages) lstrcpyW(text, L"N/A");
+        else if (job->PagesPrinted && (job->Status & JOB_STATUS_PRINTING) && job->PagesPrinted < job->TotalPages)
+            swprintf(text, ARRAY_SIZE(text), L"%lu of %lu", job->PagesPrinted, job->TotalPages);
+        else swprintf(text, ARRAY_SIZE(text), L"%lu", job->TotalPages);
+        lvi.iSubItem = 3; lvi.pszText = text;
+        SendMessageW(q->list, LVM_SETITEMTEXTW, item, (LPARAM)&lvi);
+        size_text(job->Size, text, ARRAY_SIZE(text));
+        lvi.iSubItem = 4; lvi.pszText = text;
+        SendMessageW(q->list, LVM_SETITEMTEXTW, item, (LPARAM)&lvi);
+        time_text(&job->Submitted, text, ARRAY_SIZE(text));
+        lvi.iSubItem = 5; lvi.pszText = text;
+        SendMessageW(q->list, LVM_SETITEMTEXTW, item, (LPARAM)&lvi);
+        lvi.iSubItem = 6; lvi.pszText = q->port;
+        SendMessageW(q->list, LVM_SETITEMTEXTW, item, (LPARAM)&lvi);
+    }
+    SendMessageW(q->list, WM_SETREDRAW, TRUE, 0);
+    free(selected);
+    free(jobs);
+
+    q->njobs = count;
+    if (count == 1) lstrcpyW(text, L"1 document(s) in queue");
+    else swprintf(text, ARRAY_SIZE(text), L"%lu document(s) in queue", count);
+    SendMessageW(q->status, SB_SETTEXTW, 0, (LPARAM)text);
+}
+
+/* the command on every selected document */
+static void control_selected(struct queue *q, DWORD command)
+{
+    LVITEMW lvi;
+    int item = -1, n = 0;
+
+    if (command == JOB_CONTROL_DELETE)
+    {
+        if (!SendMessageW(q->list, LVM_GETSELECTEDCOUNT, 0, 0)) return;
+        if (MessageBoxW(q->hwnd, L"Are you sure you want to cancel the selected document(s)?", L"Printers",
+                        MB_YESNO | MB_ICONQUESTION) != IDYES) return;
+    }
+    while ((item = SendMessageW(q->list, LVM_GETNEXTITEM, item, LVNI_SELECTED)) != -1)
+    {
+        lvi.mask = LVIF_PARAM;
+        lvi.iItem = item;
+        lvi.iSubItem = 0;
+        if (!SendMessageW(q->list, LVM_GETITEMW, 0, (LPARAM)&lvi)) continue;
+        n++;
+#ifndef SG_MUTANT_QUEUE_NO_CONTROL
+        if (!SetJobW(q->printer, lvi.lParam, 0, NULL, command))
+        {
+            DWORD error = GetLastError();
+            message_error(q, command == JOB_CONTROL_DELETE ? L"The document could not be cancelled." :
+                             command == JOB_CONTROL_PAUSE ? L"The document could not be paused." :
+                             command == JOB_CONTROL_RESUME ? L"The document could not be resumed." :
+                             L"The document could not be restarted.", error);
+            break;
+        }
+#endif
+    }
+    if (n) refresh(q);
+}
+
+/* pause and resume, cancel all: the printer opened for administering it */
+static void control_printer(struct queue *q, DWORD command)
+{
+    PRINTER_DEFAULTSW defaults = { NULL, NULL, PRINTER_ACCESS_ADMINISTER | PRINTER_ACCESS_USE };
+    HANDLE admin;
+    DWORD error = ERROR_SUCCESS;
+
+    if (command == PRINTER_CONTROL_PURGE &&
+        MessageBoxW(q->hwnd, L"Are you sure you want to cancel all documents? The documents will be deleted from "
+                    L"the list of documents to be printed.", q->name, MB_YESNO | MB_ICONQUESTION) != IDYES)
+        return;
+    if (!OpenPrinterW(q->name, &admin, &defaults)) error = GetLastError();
+    else
+    {
+        if (!SetPrinterW(admin, 0, NULL, command)) error = GetLastError();
+        ClosePrinter(admin);
+    }
+    if (error)
+        message_error(q, command == PRINTER_CONTROL_PURGE ? L"The documents could not be cancelled." :
+                         command == PRINTER_CONTROL_PAUSE ? L"The printer could not be paused." :
+                         L"The printer could not be resumed.", error);
+    refresh(q);
+}
+
+static void preferences(struct queue *q)
+{
+    SHInvokePrinterCommandW(q->hwnd, PRINTACTION_DOCUMENTDEFAULTS, q->name, NULL, TRUE);
+    refresh(q);
+}
+
+static void update_menus(struct queue *q)
+{
+    WCHAR def[256];
+    DWORD size = ARRAY_SIZE(def);
+    BOOL any = SendMessageW(q->list, LVM_GETSELECTEDCOUNT, 0, 0) > 0;
+    BOOL is_default = GetDefaultPrinterW(def, &size) && !wcsicmp(def, q->name);
+    UINT i;
+
+    CheckMenuItem(q->printer_menu, IDM_DEFAULT, MF_BYCOMMAND | (is_default ? MF_CHECKED : MF_UNCHECKED));
+    CheckMenuItem(q->printer_menu, IDM_PAUSE_PRINTER, MF_BYCOMMAND | (q->paused ? MF_CHECKED : MF_UNCHECKED));
+    EnableMenuItem(q->printer_menu, IDM_CANCEL_ALL, MF_BYCOMMAND | (q->njobs ? MF_ENABLED : MF_GRAYED));
+    for (i = IDM_DOC_PAUSE; i <= IDM_DOC_CANCEL; i++)
+        EnableMenuItem(q->doc_menu, i, MF_BYCOMMAND | (any ? MF_ENABLED : MF_GRAYED));
+}
+
+static HMENU doc_menu(void)
+{
+    HMENU menu = CreatePopupMenu();
+
+    AppendMenuW(menu, MF_STRING, IDM_DOC_PAUSE, L"&Pause");
+    AppendMenuW(menu, MF_STRING, IDM_DOC_RESUME, L"&Resume");
+    AppendMenuW(menu, MF_STRING, IDM_DOC_RESTART, L"Res&tart");
+    AppendMenuW(menu, MF_STRING, IDM_DOC_CANCEL, L"&Cancel");
+    return menu;
+}
+
+static HMENU main_menu(struct queue *q)
+{
+    HMENU bar = CreateMenu(), view = CreatePopupMenu();
+
+    q->printer_menu = CreatePopupMenu();
+    AppendMenuW(q->printer_menu, MF_STRING, IDM_DEFAULT, L"Set As &Default Printer");
+    AppendMenuW(q->printer_menu, MF_STRING, IDM_PREFERENCES, L"Printing Pr&eferences...");
+    AppendMenuW(q->printer_menu, MF_SEPARATOR, 0, NULL);
+    AppendMenuW(q->printer_menu, MF_STRING, IDM_PAUSE_PRINTER, L"P&ause Printing");
+    AppendMenuW(q->printer_menu, MF_STRING, IDM_CANCEL_ALL, L"Cancel All D&ocuments");
+    AppendMenuW(q->printer_menu, MF_SEPARATOR, 0, NULL);
+    AppendMenuW(q->printer_menu, MF_STRING, IDM_PROPERTIES, L"P&roperties");
+    AppendMenuW(q->printer_menu, MF_SEPARATOR, 0, NULL);
+    AppendMenuW(q->printer_menu, MF_STRING, IDM_CLOSE, L"&Close");
+    q->doc_menu = doc_menu();
+    AppendMenuW(view, MF_STRING, IDM_REFRESH, L"&Refresh\tF5");
+    AppendMenuW(bar, MF_POPUP, (UINT_PTR)q->printer_menu, L"&Printer");
+    AppendMenuW(bar, MF_POPUP, (UINT_PTR)q->doc_menu, L"&Document");
+    AppendMenuW(bar, MF_POPUP, (UINT_PTR)view, L"&View");
+    return bar;
+}
+
+static void command(struct queue *q, UINT id)
+{
+    switch (id)
+    {
+    case IDM_DEFAULT:
+        if (!SetDefaultPrinterW(q->name)) message_error(q, L"The default printer could not be set.", GetLastError());
+        break;
+    case IDM_PREFERENCES:   preferences(q); break;
+    case IDM_PAUSE_PRINTER: control_printer(q, q->paused ? PRINTER_CONTROL_RESUME : PRINTER_CONTROL_PAUSE); break;
+    case IDM_CANCEL_ALL:    control_printer(q, PRINTER_CONTROL_PURGE); break;
+    case IDM_PROPERTIES:    PrinterProperties(q->hwnd, q->printer); refresh(q); break;
+    case IDM_CLOSE:         DestroyWindow(q->hwnd); break;
+    case IDM_DOC_PAUSE:     control_selected(q, JOB_CONTROL_PAUSE); break;
+    case IDM_DOC_RESUME:    control_selected(q, JOB_CONTROL_RESUME); break;
+    case IDM_DOC_RESTART:   control_selected(q, JOB_CONTROL_RESTART); break;
+    case IDM_DOC_CANCEL:    control_selected(q, JOB_CONTROL_DELETE); break;
+    case IDM_REFRESH:       refresh(q); break;
+    }
+}
+
+static void layout(struct queue *q)
+{
+    RECT rc, sb;
+
+    GetClientRect(q->hwnd, &rc);
+    SendMessageW(q->status, WM_SIZE, 0, 0);
+    GetWindowRect(q->status, &sb);
+    MoveWindow(q->list, 0, 0, rc.right, rc.bottom - (sb.bottom - sb.top), TRUE);
+}
+
+static LRESULT CALLBACK queue_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct queue *q = (struct queue *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CREATE:
+    {
+        CREATESTRUCTW *cs = (CREATESTRUCTW *)lparam;
+        LVCOLUMNW col;
+        unsigned int i;
+
+        q = cs->lpCreateParams;
+        q->hwnd = hwnd;
+        SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)q);
+        q->list = CreateWindowExW(0, WC_LISTVIEWW, NULL,
+                                  WS_CHILD | WS_VISIBLE | WS_TABSTOP | LVS_REPORT | LVS_SHOWSELALWAYS,
+                                  0, 0, 0, 0, hwnd, (HMENU)IDC_LIST, NULL, NULL);
+        SendMessageW(q->list, LVM_SETEXTENDEDLISTVIEWSTYLE, LVS_EX_FULLROWSELECT, LVS_EX_FULLROWSELECT);
+        for (i = 0; i < ARRAY_SIZE(columns); i++)
+        {
+            memset(&col, 0, sizeof(col));
+            col.mask = LVCF_TEXT | LVCF_WIDTH | LVCF_FMT | LVCF_SUBITEM;
+            col.fmt = columns[i].fmt;
+            col.cx = columns[i].width;
+            col.pszText = (WCHAR *)columns[i].title;
+            col.iSubItem = i;
+            SendMessageW(q->list, LVM_INSERTCOLUMNW, i, (LPARAM)&col);
+        }
+        q->status = CreateWindowExW(0, STATUSCLASSNAMEW, NULL, WS_CHILD | WS_VISIBLE | SBARS_SIZEGRIP,
+                                    0, 0, 0, 0, hwnd, (HMENU)IDC_STATUS, NULL, NULL);
+        refresh(q);
+        update_title(q);
+        SetTimer(hwnd, TIMER_REFRESH, 1000, NULL);
+        return 0;
+    }
+    case WM_SIZE:
+        if (q) layout(q);
+        return 0;
+    case WM_SETFOCUS:
+        if (q) SetFocus(q->list);
+        return 0;
+    case WM_TIMER:
+        if (q && wparam == TIMER_REFRESH) refresh(q);
+        return 0;
+    case WM_INITMENUPOPUP:
+        if (q) update_menus(q);
+        return 0;
+    case WM_COMMAND:
+        if (q) command(q, LOWORD(wparam));
+        return 0;
+    case WM_CONTEXTMENU:
+        if (q && (HWND)wparam == q->list && SendMessageW(q->list, LVM_GETSELECTEDCOUNT, 0, 0))
+        {
+            HMENU menu = doc_menu();
+            POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+
+            if (pt.x == -1 && pt.y == -1) GetCursorPos(&pt);
+            TrackPopupMenu(menu, TPM_RIGHTBUTTON, pt.x, pt.y, 0, hwnd, NULL);
+            DestroyMenu(menu);
+        }
+        return 0;
+    case WM_NOTIFY:
+    {
+        NMHDR *hdr = (NMHDR *)lparam;
+
+        if (q && hdr->idFrom == IDC_LIST && hdr->code == LVN_KEYDOWN)
+        {
+            NMLVKEYDOWN *key = (NMLVKEYDOWN *)lparam;
+            if (key->wVKey == VK_DELETE) control_selected(q, JOB_CONTROL_DELETE);
+            else if (key->wVKey == VK_F5) refresh(q);
+        }
+        return 0;
+    }
+    case WM_DESTROY:
+        KillTimer(hwnd, TIMER_REFRESH);
+        PostQuitMessage(0);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+/* /o: the queue window of printer "name", until it is closed */
+DWORD queue_window(HWND owner, const WCHAR *name, int show)
+{
+    INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_LISTVIEW_CLASSES | ICC_BAR_CLASSES };
+    struct queue q;
+    WNDCLASSEXW wc;
+    HACCEL accel;
+    ACCEL keys[1] = { { FVIRTKEY, VK_F5, IDM_REFRESH } };
+    MSG msg;
+
+    TRACE("(%p, %s, %d)\n", owner, debugstr_w(name), show);
+    if (!name || !name[0]) return ERROR_INVALID_PARAMETER;
+    memset(&q, 0, sizeof(q));
+    if (!OpenPrinterW((WCHAR *)name, &q.printer, NULL)) return GetLastError();
+    q.name = (WCHAR *)name;
+
+    InitCommonControlsEx(&icc);
+    memset(&wc, 0, sizeof(wc));
+    wc.cbSize = sizeof(wc);
+    wc.lpfnWndProc = queue_proc;
+    wc.hInstance = GetModuleHandleW(L"printui.dll");
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW);
+    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
+    wc.lpszClassName = QUEUE_CLASS;
+    wc.hIcon = LoadImageW(GetModuleHandleW(L"shell32.dll"), MAKEINTRESOURCEW(17), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE | LR_SHARED);
+    wc.hIconSm = LoadImageW(GetModuleHandleW(L"shell32.dll"), MAKEINTRESOURCEW(17), IMAGE_ICON, 16, 16, LR_SHARED);
+    RegisterClassExW(&wc);
+
+    if (!CreateWindowExW(0, QUEUE_CLASS, name, WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 900, 360,
+                         owner, main_menu(&q), wc.hInstance, &q))
+    {
+        DWORD error = GetLastError();
+        ClosePrinter(q.printer);
+        return error ? error : ERROR_OUTOFMEMORY;
+    }
+    ShowWindow(q.hwnd, show ? show : SW_SHOWNORMAL);
+    UpdateWindow(q.hwnd);
+    accel = CreateAcceleratorTableW(keys, ARRAY_SIZE(keys));
+    while (GetMessageW(&msg, NULL, 0, 0) > 0)
+    {
+        if (accel && TranslateAcceleratorW(q.hwnd, accel, &msg)) continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    if (accel) DestroyAcceleratorTable(accel);
+    ClosePrinter(q.printer);
+    return ERROR_SUCCESS;
+}
