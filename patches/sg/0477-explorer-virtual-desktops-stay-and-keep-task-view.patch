From: Stained Glass OS contributors
Subject: explorer: virtual desktops -- closing a desktop's last window stays; Task View stays open to remove more

Two of David's reports:
- Closing the last window on a virtual desktop switched to another desktop
  that had a window: Wine gave the foreground to the next window in z-order,
  on another desktop, and explorer follows the foreground to its desktop.
  When the window that was in front has just been destroyed, the current
  desktop's top window (or the taskbar) is activated instead; a window
  brought forward on purpose still switches.
- Removing a desktop in Task View closed Task View, so removing several
  meant reopening it each time: vd_close activated a window, and Task View
  closes when it loses the foreground. It leaves that to Task View while
  Task View is open.

--- a/programs/explorer/vdesktop.c
+++ b/programs/explorer/vdesktop.c
@@ -417,7 +417,9 @@
     if (vd_current > d || vd_current == vd_count) vd_current = max( 0, vd_current - 1 );
     EnumWindows( apply_proc, 0 );
     save_state();
-    activate_top();
+    /* Task View stays open to remove more (taking the foreground from it
+     * closed it); it activates a window itself when it closes */
+    if (!taskview) activate_top();
     taskbar_windows_changed();
 }
 
@@ -478,12 +480,27 @@
 static void CALLBACK watch_foreground( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
 {
     static int ticks;
+    static HWND last_root;
     HWND fg = GetForegroundWindow(), root = fg ? GetAncestor( fg, GA_ROOTOWNER ) : 0;
     int d;
 
     if (!root || taskview || !is_app_window( root )) return;
     d = desktop_of( root );
-    if (d >= 0 && d != vd_current) { vd_switch( d, TRUE ); return; }
+    if (d >= 0 && d != vd_current)
+    {
+        /* the window in front closed and Windows' rule gave the foreground
+         * to the next window, on another desktop: stay here, as Windows
+         * does -- only a window brought forward on purpose switches */
+        if (last_root && !IsWindow( last_root ))
+        {
+            last_root = 0;
+            activate_top();
+            return;
+        }
+        vd_switch( d, TRUE );
+        return;
+    }
+    last_root = root;
     if (++ticks % 4 == 0 && !IsIconic( root )) capture_thumb( root );
     if (ticks % 40 == 0) drop_dead_thumbs();
 }
