From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ntdll: Return the largest committed free block from RtlCompactHeap.

RtlCompactHeap (HeapCompact) returns the size of the largest committed free
block in the heap, as HeapCompact is documented to; with nothing free it
returns 0 and sets no error. Free blocks are already coalesced when freed,
so there is nothing to compact. It returned 0 always, which also made
msvcrt's _heapmin fail.

Gate: test/ntdll-compactheap-gate.sh (64/32).
---
 dlls/ntdll/heap.c | 40 +++++++++++++++++++++++++++++++++++++---
 1 file changed, 37 insertions(+), 3 deletions(-)

diff --git a/dlls/ntdll/heap.c b/dlls/ntdll/heap.c
index 696e129..5fe9ccf 100644
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -2277,9 +2277,43 @@ void *WINAPI RtlReAllocateHeap( HANDLE handle, ULONG flags, void *ptr, SIZE_T si
  */
 ULONG WINAPI RtlCompactHeap( HANDLE handle, ULONG flags )
 {
-    static BOOL reported;
-    if (!reported++) FIXME( "handle %p, flags %#lx stub!\n", handle, flags );
-    return 0;
+    struct list *ptr;
+    struct heap *heap;
+    ULONG heap_flags;
+    SIZE_T largest = 0;
+
+    TRACE( "handle %p, flags %#lx\n", handle, flags );
+
+    /* free blocks are coalesced when they are freed, so there is nothing to
+     * compact: report the largest committed free block (HeapCompact) */
+    if (!(heap = unsafe_heap_from_handle( handle, flags, &heap_flags )))
+    {
+        RtlSetLastWin32ErrorAndNtStatusFromNtStatus( STATUS_INVALID_HANDLE );
+        return 0;
+    }
+    heap_lock( heap, heap_flags );
+    /* every free block is linked from the first free list's sentinel */
+    ptr = &heap->free_lists[0].entry;
+    while ((ptr = list_next( &heap->free_lists[0].entry, ptr )))
+    {
+        struct entry *entry = LIST_ENTRY( ptr, struct entry, entry );
+        struct block *block = &entry->block;
+        char *start, *end, *commit_end;
+
+        if (block_get_flags( block ) == BLOCK_FLAG_FREE_LINK) continue;
+        start = (char *)(block + 1);
+        end = (char *)block + block_get_size( block );
+        commit_end = (char *)subheap_commit_end( block_get_subheap( heap, block ) );
+        if (end > commit_end) end = commit_end;
+        if (end > start && (SIZE_T)(end - start) > largest) largest = end - start;
+    }
+    heap_unlock( heap, heap_flags );
+#ifdef SG_MUTANT_COMPACT_ZERO
+    largest = 0;
+#endif
+    /* nothing free: 0 with no error set (HeapCompact docs) */
+    if (!largest) RtlSetLastWin32Error( NO_ERROR );
+    return min( largest, (SIZE_T)~0u );
 }
 
 
