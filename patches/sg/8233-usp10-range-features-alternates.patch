+/* Stained Glass OS: the features a run is shaped with when the caller gives range properties
+ * (ScriptShapeOpenType / ScriptPlaceOpenType). Every feature of the script's defaults or turned on by some
+ * range is applied to the glyphs of the ranges that have it: a range's own record decides (lParameter 0 off,
+ * >= 1 on, the alternate index of alternate substitutions, wine-sg 8233), else whether it is a default. */
+struct range_features
+{
+    int count;              /* the features */
+    OPENTYPE_TAG *tags;
+    LONG *param;            /* [range][feature]: the lParameter, 0 for off */
+    int range_count;
+    int *char_range;        /* the range of each character */
+};
+
+static void free_range_features(struct range_features *rf)
+{
+    if (!rf) return;
+    heap_free(rf->tags);
+    heap_free(rf->param);
+    heap_free(rf->char_range);
+    heap_free(rf);
+}
+
+static struct range_features *get_range_features(const TEXTRANGE_PROPERTIES *defaults, const int *range_chars,
+        TEXTRANGE_PROPERTIES **ranges, int range_count, int char_count)
+{
+    struct range_features *rf;
+    int i, j, r, t, max = defaults->cotfRecords, pos;
 
-    if (!ranges || range_count <= 0 || !(range = ranges[0])) return NULL;
-    for (i = 1; i < range_count; i++)
+    if (!ranges || range_count <= 0) return NULL;
+    for (r = 0; r < range_count; r++) if (ranges[r]) max += ranges[r]->cotfRecords;
+    if (!(rf = heap_alloc_zero(sizeof(*rf)))) return NULL;
+    rf->range_count = range_count;
+    if (!(rf->tags = heap_alloc(max * sizeof(*rf->tags))) ||
+        !(rf->param = heap_alloc_zero((size_t)max * range_count * sizeof(*rf->param))) ||
+        !(rf->char_range = heap_alloc_zero(max(char_count, 1) * sizeof(*rf->char_range))))
     {
-        if (!ranges[i] || ranges[i]->cotfRecords != range->cotfRecords ||
-            memcmp(ranges[i]->potfRecords, range->potfRecords, range->cotfRecords * sizeof(*range->potfRecords)))
+        free_range_features(rf);
+        return NULL;
+    }
+    for (i = 0; i < defaults->cotfRecords; i++) rf->tags[rf->count++] = defaults->potfRecords[i].tagFeature;
+    for (r = 0; r < range_count; r++)
+    {
+        if (!ranges[r]) continue;
+        for (j = 0; j < ranges[r]->cotfRecords; j++)
         {
-            static int once;
-            if (!once++) FIXME("ranges with different features: the first range's are used\n");
-            break;
+            if (ranges[r]->potfRecords[j].lParameter <= 0) continue;
+            for (t = 0; t < rf->count; t++) if (rf->tags[t] == ranges[r]->potfRecords[j].tagFeature) break;
+#ifdef SG_MUTANT_USP_RANGE_ON_IGNORED
+            continue;
+#endif
+            if (t == rf->count) rf->tags[rf->count++] = ranges[r]->potfRecords[j].tagFeature;
         }
     }
-    if (!(merged = heap_alloc(sizeof(*merged) + (defaults->cotfRecords + range->cotfRecords) * sizeof(OPENTYPE_FEATURE_RECORD))))
-        return NULL;
-    merged->potfRecords = (OPENTYPE_FEATURE_RECORD *)(merged + 1);
-    for (i = 0; i < defaults->cotfRecords; i++)
+    for (r = 0; r < range_count; r++)
     {
-        BOOL off = FALSE;
-        for (j = 0; j < range->cotfRecords; j++)
-            if (range->potfRecords[j].tagFeature == defaults->potfRecords[i].tagFeature && !range->potfRecords[j].lParameter)
-                off = TRUE;
+#ifdef SG_MUTANT_USP_FIRST_RANGE_ONLY
+        const TEXTRANGE_PROPERTIES *range = ranges[0];
+#else
+        const TEXTRANGE_PROPERTIES *range = ranges[r];
+#endif
+        for (t = 0; t < rf->count; t++)
+        {
+            LONG param = 0;
+            for (i = 0; i < defaults->cotfRecords; i++)
+                if (defaults->potfRecords[i].tagFeature == rf->tags[t]) param = defaults->potfRecords[i].lParameter;
+            if (range)
+                for (j = 0; j < range->cotfRecords; j++)
+                {
+                    if (range->potfRecords[j].tagFeature != rf->tags[t]) continue;
 #ifdef SG_MUTANT_USP_RANGE_OFF_IGNORED
-        off = FALSE;
+                    if (!range->potfRecords[j].lParameter) continue;
 #endif
-        if (!off) merged->potfRecords[n++] = defaults->potfRecords[i];
+                    param = range->potfRecords[j].lParameter;
+                }
+            rf->param[r * rf->count + t] = param;
+        }
     }
-    for (j = 0; j < range->cotfRecords; j++)
+    /* the characters of each range, from rcRangeChars; the rest belong to the last range */
+    for (i = pos = 0, r = 0; i < char_count; i++)
     {
-        BOOL known = FALSE;
-        if (range->potfRecords[j].lParameter <= 0) continue;
-        for (i = 0; i < n; i++)
-            if (merged->potfRecords[i].tagFeature == range->potfRecords[j].tagFeature) known = TRUE;
-#ifdef SG_MUTANT_USP_RANGE_ON_IGNORED
-        known = TRUE;
-#endif
-        if (!known) merged->potfRecords[n++] = range->potfRecords[j];
+        while (range_chars && r < range_count - 1 && i >= pos + range_chars[r]) pos += range_chars[r++];
+        rf->char_range[i] = range_chars ? r : 0;
     }
-    merged->cotfRecords = n;
-    return merged;
+    return rf;
+}
+
+/* the range of a glyph: that of the first character of its cluster */
+static int glyph_range(const struct range_features *rf, const WORD *log_clust, int char_count, int glyph)
+{
+    int c, best = -1, best_glyph = -1;
+
+    for (c = 0; c < char_count; c++)
+    {
+        if (log_clust[c] == glyph) return rf->char_range[c];
+        if (log_clust[c] < glyph && log_clust[c] > best_glyph) { best_glyph = log_clust[c]; best = c; }
+    }
+    return best >= 0 ? rf->char_range[best] : 0;
+}
+
+static LONG range_param(const struct range_features *rf, int range, int feature)
+{
+    return rf->param[range * rf->count + feature];
 }
 
