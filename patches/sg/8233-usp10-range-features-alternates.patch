+    if (scriptInformation[psa->eScript].a.fRTL && (!psa->fLogicalOrder || !psa->fRTL)) dir = -1;
+    else dir = 1;
+
+    for (t = 0; t < rf->count; t++)
+    {
+        LoadedFeature *feature;
+        int r;
+
+        for (r = 0; r < rf->range_count; r++) if (range_param(rf, r, t) > 0) break;
+        if (r == rf->range_count) continue;
+        if (!(feature = load_OT_feature(hdc, psa, psc, FEATURE_GSUB_TABLE, (const char *)&rf->tags[t]))) continue;
+        TRACE("applying feature %s by range\n", debugstr_an((const char *)&rf->tags[t], 4));
+        for (lookup = 0; lookup < feature->lookup_count; lookup++)
+        {
+            int i = dir > 0 ? 0 : *glyph_count - 1;
+            while (i < *glyph_count && i >= 0)
+            {
+                INT next, prev = *glyph_count;
+                LONG param = range_param(rf, glyph_range(rf, log_clust, char_count, i), t);
+
+                if (param <= 0)
+                {
+                    i += dir;
+                    continue;
+                }
+                next = OpenType_apply_GSUB_lookup_alt(psc->GSUB_Table, feature->lookups[lookup], glyphs, i, dir,
+                                                      glyph_count, param);
+                if (*glyph_count != prev)
+                {
+                    UpdateClusters(next, *glyph_count - prev, dir, char_count, log_clust);
+                    i = next;
+                }
+                else i += dir;
+            }
+        }
+    }
+done:
+    free_range_features(rf);
 }
 
 static void apply_positions(HDC hdc, ScriptCache *psc, SCRIPT_ANALYSIS *psa, const WORD *pwGlyphs, INT cGlyphs,
         int *piAdvance, GOFFSET *pGoffset, const TEXTRANGE_PROPERTIES *rpRangeProperties);
 
+/* positioning features by range: a feature on in some ranges only is applied to the run, and the glyphs of the
