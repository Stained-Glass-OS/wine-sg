+
+    for (t = 0; t < rf->count; t++)
+    {
+        OPENTYPE_FEATURE_RECORD record = { rf->tags[t], 1 };
+        TEXTRANGE_PROPERTIES one = { &record, 1 };
+        int r, on = 0;
+
+        for (r = 0; r < rf->range_count; r++) if (range_param(rf, r, t) > 0) on++;
+        if (!on) continue;
+        if (advances) memcpy(saved_adv, advances, glyph_count * sizeof(*advances));
+        if (offsets) memcpy(saved_off, offsets, glyph_count * sizeof(*offsets));
+        apply_positions(hdc, psc, psa, glyphs, glyph_count, advances, offsets, &one);
+        if (on == rf->range_count) continue;
+        for (i = 0; i < glyph_count; i++)
+        {
