From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msident: identities from HKCU (3559)

msident: identities from HKCU\Identities

IUserIdentityManager lists the {GUID} keys under HKCU\Identities that have a Username, or the single
"Main Identity" when there are none. IEnumUserIdentity walks a snapshot (Next, Skip, Reset, Clone,
GetCount); IUserIdentity gives cookie, name, registry key and the roaming / local identity folders.
Logon returns the first identity and makes it current (forced UI gives E_USER_CANCELLED, as there is no
dialog), Logoff gives E_NO_CURRENT_IDENTITY when nobody is logged on, GetIdentityByCookie
E_IDENTITY_NOT_FOUND for unknown cookies.
---
--- a/dlls/msident/Makefile.in
+++ b/dlls/msident/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = msident.dll
+IMPORTS   = ole32 advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
--- a/dlls/msident/msident.c
+++ b/dlls/msident/msident.c
@@ -19,6 +19,7 @@
 #define COBJMACROS
 
 #include "windows.h"
+#include "winreg.h"
 #include "initguid.h"
 #include "msident.h"
 #include "rpcproxy.h"
@@ -27,9 +28,204 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(msident);
 
+
+#define MAX_IDENTITIES 32
+#define IDENTITY_NAME_MAX 128
+
+struct identity_info
+{
+    GUID cookie;
+    WCHAR name[IDENTITY_NAME_MAX];
+};
+
+/* Cookie of the identity that exists when nothing is registered under HKCU\Identities. */
+static const GUID default_cookie = { 0x4e8b5c1a, 0x2f6d, 0x4c0e, { 0x9a, 0x3b, 0x7d, 0x52, 0x1f, 0xe8, 0xc0, 0x01 } };
+
+static CRITICAL_SECTION current_cs = { NULL, -1, 0, 0, 0, 0 };
+static GUID current_cookie;
+static BOOL has_current;
+
+static BOOL parse_cookie(const WCHAR *str, GUID *guid)
+{
+    return str[0] == '{' && !CLSIDFromString(str, guid);
+}
+
+/* The identities of the current user: the {GUID} keys under HKCU\Identities that have a Username,
+ * or the one default identity when there are none. */
+static ULONG load_identities(struct identity_info *list)
+{
+    ULONG count = 0, i;
+    HKEY root, key;
+    WCHAR name[64];
+
+    if (!RegOpenKeyExW(HKEY_CURRENT_USER, L"Identities", 0, KEY_READ, &root))
+    {
+        for (i = 0; count < MAX_IDENTITIES; i++)
+        {
+            DWORD len = ARRAY_SIZE(name), size, type;
+            struct identity_info *info = &list[count];
+
+            if (RegEnumKeyExW(root, i, name, &len, NULL, NULL, NULL, NULL)) break;
+            if (!parse_cookie(name, &info->cookie)) continue;
+            if (RegOpenKeyExW(root, name, 0, KEY_READ, &key)) continue;
+            size = sizeof(info->name);
+            if (!RegQueryValueExW(key, L"Username", NULL, &type, (BYTE *)info->name, &size) && type == REG_SZ)
+            {
+                info->name[IDENTITY_NAME_MAX - 1] = 0;
+                count++;
+            }
+            RegCloseKey(key);
+        }
+        RegCloseKey(root);
+    }
+
+    if (!count)
+    {
+        list[0].cookie = default_cookie;
+        wcscpy(list[0].name, L"Main Identity");
+        count = 1;
+    }
+    return count;
+}
+
+/* ---- IUserIdentity ---- */
+
+typedef struct {
+    IUserIdentity IUserIdentity_iface;
+    LONG ref;
+    struct identity_info info;
+} UserIdentity;
+
+static inline UserIdentity *impl_from_IUserIdentity(IUserIdentity *iface)
+{
+    return CONTAINING_RECORD(iface, UserIdentity, IUserIdentity_iface);
+}
+
+static HRESULT WINAPI UserIdentity_QueryInterface(IUserIdentity *iface, REFIID riid, void **ppv)
+{
+    UserIdentity *This = impl_from_IUserIdentity(iface);
+
+    if (IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IUserIdentity, riid))
+    {
+        *ppv = &This->IUserIdentity_iface;
+        IUserIdentity_AddRef(*ppv);
+        return S_OK;
+    }
+    WARN("(%s %p)\n", debugstr_guid(riid), ppv);
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI UserIdentity_AddRef(IUserIdentity *iface)
+{
+    return InterlockedIncrement(&impl_from_IUserIdentity(iface)->ref);
+}
+
+static ULONG WINAPI UserIdentity_Release(IUserIdentity *iface)
+{
+    UserIdentity *This = impl_from_IUserIdentity(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
+
+static HRESULT WINAPI UserIdentity_GetCookie(IUserIdentity *iface, GUID *puidCookie)
+{
+    UserIdentity *This = impl_from_IUserIdentity(iface);
+
+    TRACE("(%p)->(%p)\n", This, puidCookie);
+
+    if (!puidCookie) return E_INVALIDARG;
+    *puidCookie = This->info.cookie;
+    return S_OK;
+}
+
+static HRESULT WINAPI UserIdentity_GetName(IUserIdentity *iface, WCHAR *pszName, ULONG ulBuffSize)
+{
+    UserIdentity *This = impl_from_IUserIdentity(iface);
+
+    TRACE("(%p)->(%p %lu)\n", This, pszName, ulBuffSize);
+
+    if (!pszName) return E_INVALIDARG;
+    if (ulBuffSize < wcslen(This->info.name) + 1) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    wcscpy(pszName, This->info.name);
+    return S_OK;
+}
+
+static void identity_key_path(const struct identity_info *info, WCHAR *path)
+{
+    wcscpy(path, L"Identities\\");
+    StringFromGUID2(&info->cookie, path + wcslen(path), 39);
+}
+
+static HRESULT WINAPI UserIdentity_OpenIdentityRegKey(IUserIdentity *iface, DWORD dwDesiredAccess, HKEY *phKey)
+{
+    UserIdentity *This = impl_from_IUserIdentity(iface);
+    WCHAR path[80];
+    LONG err;
+
+    TRACE("(%p)->(%#lx %p)\n", This, dwDesiredAccess, phKey);
+
+    if (!phKey) return E_INVALIDARG;
+    identity_key_path(&This->info, path);
+    if ((err = RegCreateKeyExW(HKEY_CURRENT_USER, path, 0, NULL, 0, dwDesiredAccess, NULL, phKey, NULL)))
+    {
+        *phKey = NULL;
+        return HRESULT_FROM_WIN32(err);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI UserIdentity_GetIdentityFolder(IUserIdentity *iface, DWORD dwFlags, WCHAR *pszPath, ULONG ulBuffSize)
+{
+    UserIdentity *This = impl_from_IUserIdentity(iface);
+    WCHAR path[MAX_PATH], guid[39];
+    DWORD len;
+
+    TRACE("(%p)->(%#lx %p %lu)\n", This, dwFlags, pszPath, ulBuffSize);
+
+    if (!pszPath || (dwFlags != GIF_ROAMING_FOLDER && dwFlags != GIF_NON_ROAMING_FOLDER)) return E_INVALIDARG;
+
+    len = ExpandEnvironmentStringsW(dwFlags == GIF_ROAMING_FOLDER ? L"%APPDATA%" : L"%LOCALAPPDATA%", path, ARRAY_SIZE(path));
+    if (!len || len > ARRAY_SIZE(path) - 50) return HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
+    StringFromGUID2(&This->info.cookie, guid, ARRAY_SIZE(guid));
+    wcscat(path, L"\\Identities\\");
+    wcscat(path, guid);
+    if (ulBuffSize < wcslen(path) + 1) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    wcscpy(pszPath, path);
+    return S_OK;
+}
+
+static const IUserIdentityVtbl UserIdentityVtbl = {
+    UserIdentity_QueryInterface,
+    UserIdentity_AddRef,
+    UserIdentity_Release,
+    UserIdentity_GetCookie,
+    UserIdentity_GetName,
+    UserIdentity_OpenIdentityRegKey,
+    UserIdentity_GetIdentityFolder
+};
+
+static HRESULT create_identity(const struct identity_info *info, IUserIdentity **out)
+{
+    UserIdentity *ret = malloc(sizeof(*ret));
+
+    if (!ret) return E_OUTOFMEMORY;
+    ret->IUserIdentity_iface.lpVtbl = &UserIdentityVtbl;
+    ret->ref = 1;
+    ret->info = *info;
+    *out = &ret->IUserIdentity_iface;
+    return S_OK;
+}
+
+/* ---- IEnumUserIdentity: a snapshot of the identities ---- */
+
 typedef struct {
     IEnumUserIdentity IEnumUserIdentity_iface;
     LONG ref;
+    struct identity_info list[MAX_IDENTITIES];
+    ULONG count, pos;
 } EnumUserIdentity;
 
 static inline EnumUserIdentity *impl_from_IEnumUserIdentity(IEnumUserIdentity *iface)
@@ -60,11 +256,7 @@
 static ULONG WINAPI EnumUserIdentity_AddRef(IEnumUserIdentity *iface)
 {
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
-    LONG ref = InterlockedIncrement(&This->ref);
-
-    TRACE("(%p) ref=%ld\n", This, ref);
-
-    return ref;
+    return InterlockedIncrement(&This->ref);
 }
 
 static ULONG WINAPI EnumUserIdentity_Release(IEnumUserIdentity *iface)
@@ -72,8 +264,6 @@
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
     LONG ref = InterlockedDecrement(&This->ref);
 
-    TRACE("(%p) ref=%ld\n", This, ref);
-
     if(!ref)
         free(This);
 
@@ -83,38 +273,73 @@
 static HRESULT WINAPI EnumUserIdentity_Next(IEnumUserIdentity *iface, ULONG celt, IUnknown **rgelt, ULONG *pceltFetched)
 {
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
-    FIXME("(%p)->(%lu %p %p)\n", This, celt, rgelt, pceltFetched);
-    return E_NOTIMPL;
+    ULONG fetched = 0;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, celt, rgelt, pceltFetched);
+
+    if (!rgelt || (!pceltFetched && celt != 1)) return E_INVALIDARG;
+    while (fetched < celt && This->pos < This->count)
+    {
+        IUserIdentity *identity;
+
+        if (FAILED(hr = create_identity(&This->list[This->pos], &identity))) break;
+        rgelt[fetched++] = (IUnknown *)identity;
+        This->pos++;
+    }
+    if (pceltFetched) *pceltFetched = fetched;
+    if (FAILED(hr)) return hr;
+    return fetched == celt ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI EnumUserIdentity_Skip(IEnumUserIdentity *iface, ULONG celt)
 {
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
-    FIXME("(%p)->(%lu)\n", This, celt);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%lu)\n", This, celt);
+
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumUserIdentity_Reset(IEnumUserIdentity *iface)
 {
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
-    FIXME("(%p)->()\n", This);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->()\n", This);
+
+    This->pos = 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumUserIdentity_Clone(IEnumUserIdentity *iface, IEnumUserIdentity **ppenum)
 {
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
-    FIXME("(%p)->(%p)\n", This, ppenum);
-    return E_NOTIMPL;
+    EnumUserIdentity *ret;
+
+    TRACE("(%p)->(%p)\n", This, ppenum);
+
+    if (!ppenum) return E_INVALIDARG;
+    if (!(ret = malloc(sizeof(*ret)))) return E_OUTOFMEMORY;
+    memcpy(ret, This, sizeof(*ret));
+    ret->ref = 1;
+    *ppenum = &ret->IEnumUserIdentity_iface;
+    return S_OK;
 }
 
 static HRESULT WINAPI EnumUserIdentity_GetCount(IEnumUserIdentity *iface, ULONG *pnCount)
 {
     EnumUserIdentity *This = impl_from_IEnumUserIdentity(iface);
 
-    FIXME("(%p)->(%p)\n", This, pnCount);
+    TRACE("(%p)->(%p)\n", This, pnCount);
 
-    *pnCount = 0;
+    if (!pnCount) return E_INVALIDARG;
+    *pnCount = This->count;
     return S_OK;
 }
 
@@ -165,12 +390,15 @@
 
     TRACE("(%p)\n", ppEnumUser);
 
+    if (!ppEnumUser) return E_INVALIDARG;
     ret = malloc(sizeof(*ret));
     if(!ret)
         return E_OUTOFMEMORY;
 
     ret->IEnumUserIdentity_iface.lpVtbl = &EnumUserIdentityVtbl;
     ret->ref = 1;
+    ret->count = load_identities(ret->list);
+    ret->pos = 0;
 
     *ppEnumUser = &ret->IEnumUserIdentity_iface;
     return S_OK;
@@ -178,28 +406,68 @@
 
 static HRESULT WINAPI UserIdentityManager_ManageIdentities(IUserIdentityManager *iface, HWND hwndParent, DWORD dwFlags)
 {
-    FIXME("(%p %lx)\n", hwndParent, dwFlags);
+    FIXME("(%p %lx): no identity management dialog\n", hwndParent, dwFlags);
     return E_NOTIMPL;
 }
 
 static HRESULT WINAPI UserIdentityManager_Logon(IUserIdentityManager *iface, HWND hwndParent,
         DWORD dwFlags, IUserIdentity **ppIdentity)
 {
-    FIXME("(%p %lx %p)\n", hwndParent, dwFlags, ppIdentity);
-    return E_USER_CANCELLED;
+    struct identity_info list[MAX_IDENTITIES];
+    ULONG count;
+    HRESULT hr;
+
+    TRACE("(%p %lx %p)\n", hwndParent, dwFlags, ppIdentity);
+
+    if (!ppIdentity) return E_INVALIDARG;
+    *ppIdentity = NULL;
+
+    /* asking for the identity picker can only be answered by the user, and there is no picker */
+    if ((dwFlags & UIL_FORCE_UI) == UIL_FORCE_UI) return E_USER_CANCELLED;
+
+    count = load_identities(list);
+    if (count > 1)
+    {
+        FIXME("several identities, no logon dialog: using the first\n");
+    }
+    if (SUCCEEDED(hr = create_identity(&list[0], ppIdentity)))
+    {
+        EnterCriticalSection(&current_cs);
+        current_cookie = list[0].cookie;
+        has_current = TRUE;
+        LeaveCriticalSection(&current_cs);
+    }
+    return hr;
 }
 
 static HRESULT WINAPI UserIdentityManager_Logoff(IUserIdentityManager *iface, HWND hwndParent)
 {
-    FIXME("(%p)\n", hwndParent);
-    return E_NOTIMPL;
+    HRESULT hr = S_OK;
+
+    TRACE("(%p)\n", hwndParent);
+
+    EnterCriticalSection(&current_cs);
+    if (!has_current) hr = E_NO_CURRENT_IDENTITY;
+    has_current = FALSE;
+    LeaveCriticalSection(&current_cs);
+    return hr;
 }
 
 static HRESULT WINAPI UserIdentityManager_GetIdentityByCookie(IUserIdentityManager *iface, GUID *uidCookie,
         IUserIdentity **ppIdentity)
 {
-    FIXME("(%p %p)\n", uidCookie, ppIdentity);
-    return E_NOTIMPL;
+    struct identity_info list[MAX_IDENTITIES];
+    ULONG count, i;
+
+    TRACE("(%s %p)\n", debugstr_guid(uidCookie), ppIdentity);
+
+    if (!uidCookie || !ppIdentity) return E_INVALIDARG;
+    *ppIdentity = NULL;
+
+    count = load_identities(list);
+    for (i = 0; i < count; i++)
+        if (IsEqualGUID(&list[i].cookie, uidCookie)) return create_identity(&list[i], ppIdentity);
+    return E_IDENTITY_NOT_FOUND;
 }
 
 static const IUserIdentityManagerVtbl UserIdentityManagerVtbl = {
