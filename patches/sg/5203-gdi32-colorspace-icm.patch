 /***********************************************************************
+ *           NtGdiSetColorSpace    (win32u.@)
+ *
+ * Select a colour space as the DC's input colour space; returns the one replaced.
+ */
+HCOLORSPACE WINAPI NtGdiSetColorSpace( HDC hdc, HCOLORSPACE handle )
+{
+    HCOLORSPACE ret = 0;
+    DWORD type;
+    DC *dc;
+
+    if (!(dc = get_dc_ptr( hdc ))) return 0;
+    if (get_any_obj_ptr( handle, &type ))
+    {
+        GDI_ReleaseObj( handle );
+        if (type == NTGDI_OBJ_COLORSPACE)
+        {
+            GDI_inc_ref_count( handle );
+            ret = dc->hColorSpace;
+#ifndef SG_MUTANT_CS_NOSELECT
+            dc->hColorSpace = handle;
+#endif
+            GDI_dec_ref_count( ret );
+        }
+    }
+    release_dc_ptr( dc );
+    return ret;
+}
+
+/***********************************************************************
+ *           NtGdiSetIcmMode    (win32u.@)
+ *
+ * ICM_ON and ICM_OFF are kept as the DC's state; no colours are converted.
+ */
+INT WINAPI NtGdiSetIcmMode( HDC hdc, INT mode )
+{
+    INT ret;
+    DC *dc;
+
+    if (mode != ICM_OFF && mode != ICM_ON && mode != ICM_QUERY && mode != ICM_DONE_OUTSIDEDC)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    if (!(dc = get_dc_ptr( hdc ))) return 0;
+#ifndef SG_MUTANT_ICM_STUB
+    if (mode != ICM_QUERY) dc->icm_mode = mode;
+#endif
+    ret = dc->icm_mode;
+    release_dc_ptr( dc );
+    return ret;
+}
+
+/***********************************************************************
+ *           NtGdiSetIcmProfile    (win32u.@)
+ */
+BOOL WINAPI NtGdiSetIcmProfile( HDC hdc, const WCHAR *filename )
+{
+    WCHAR *copy;
+    DC *dc;
+
+    if (!filename || !filename[0])
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(copy = malloc( (wcslen( filename ) + 1) * sizeof(WCHAR) ))) return FALSE;
+    wcscpy( copy, filename );
+    if (!(dc = get_dc_ptr( hdc )))
+    {
+        free( copy );
+        RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    free( dc->icm_profile );
+    dc->icm_profile = copy;
+    release_dc_ptr( dc );
+    return TRUE;
+}
