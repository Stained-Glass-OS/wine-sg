+/* ICM colour spaces (CreateColorSpace): an object holding the LOGCOLORSPACEW it was made from */
+typedef struct
+{
+    struct gdi_obj_header obj;
+    LOGCOLORSPACEW        logcs;
+} COLORSPACEOBJ;
+
+HCOLORSPACE default_colorspace;
+
+static INT colorspace_get_object( HGDIOBJ handle, INT count, void *buffer )
+{
+    COLORSPACEOBJ *cs = GDI_GetObjPtr( handle, NTGDI_OBJ_COLORSPACE );
+    INT ret = 0;
+
+    if (!cs) return 0;
+    if (!buffer) ret = sizeof(cs->logcs);
+    else if (count >= sizeof(cs->logcs))
+    {
+        *(LOGCOLORSPACEW *)buffer = cs->logcs;
+        ret = sizeof(cs->logcs);
+    }
+    GDI_ReleaseObj( handle );
+    return ret;
+}
+
+static BOOL colorspace_delete( HGDIOBJ handle )
+{
+    COLORSPACEOBJ *cs = free_gdi_handle( handle );
+    free( cs );
+    return TRUE;
+}
+
+static const struct gdi_obj_funcs colorspace_funcs =
+{
+    colorspace_get_object,  /* pGetObjectW */
+    NULL,                   /* pUnrealizeObject */
+    colorspace_delete       /* pDeleteObject */
+};
+
+/***********************************************************************
+ *           NtGdiCreateColorSpace    (win32u.@)
+ */
+HCOLORSPACE WINAPI NtGdiCreateColorSpace( const LOGCOLORSPACEW *logcs )
+{
+    COLORSPACEOBJ *cs;
+    HCOLORSPACE ret;
+
+    if (!logcs)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    if (!(cs = calloc( 1, sizeof(*cs) ))) return 0;
+    cs->logcs = *logcs;
+    if (!(ret = alloc_gdi_handle( &cs->obj, NTGDI_OBJ_COLORSPACE, &colorspace_funcs ))) free( cs );
+    return ret;
+}
+
+static void init_default_colorspace(void)
+{
+    /* the colour space every device context starts with: sRGB, rendering intent "images" */
+    LOGCOLORSPACEW logcs = { LCS_SIGNATURE, 0x400, sizeof(logcs), LCS_sRGB, LCS_GM_IMAGES };
+
+    default_colorspace = NtGdiCreateColorSpace( &logcs );
+    make_gdi_object_system( default_colorspace, TRUE );
+}
