+/*
+ * Stained Glass OS: ICU's UText (text a program provides in chunks through callbacks) and its regular
+ * expressions, as far as programs use them: Windows Terminal gives its buffer as a UText and searches
+ * it (find, URL detection) with uregex_open/setUText/find/findNext/start64/end64.  The UText layout
+ * and the functions follow ICU's public API (utext.h, uregex.h).  The matcher is our own: a
+ * backtracking machine over a compiled program, for ICU's common syntax -- literals and escapes,
+ * ., classes with ranges, \d \w \s and their negations, \b \B, ^ $ \A \z \Z, groups (capturing,
+ * (?:...)), alternation, the greedy, lazy and possessive-less quantifiers * + ? {m,n}, and the
+ * CASE_INSENSITIVE, MULTILINE, DOTALL and LITERAL flags.  Look-around, back references, named
+ * groups and Unicode property classes are refused (U_REGEX_UNIMPLEMENTED).  Text is matched by
+ * UTF-16 code unit; native indexes are taken to be UTF-16 offsets within a provider's
+ * nativeIndexingLimit, as for UTF-16 providers.
+ */
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(icu);
+
+typedef WCHAR UChar;
+typedef int32_t UChar32;
+typedef int UErrorCode;
+typedef signed char UBool;
+
+#define U_ZERO_ERROR                 0
+#define U_ILLEGAL_ARGUMENT_ERROR     1
+#define U_MEMORY_ALLOCATION_ERROR    7
+#define U_INDEX_OUTOFBOUNDS_ERROR    8
+#define U_UNSUPPORTED_ERROR          16
+#define U_REGEX_INTERNAL_ERROR       0x10300
+#define U_REGEX_RULE_SYNTAX          0x10301
+#define U_REGEX_INVALID_STATE        0x10302
+#define U_REGEX_BAD_ESCAPE_SEQUENCE  0x10303
+#define U_REGEX_UNIMPLEMENTED        0x10305
+#define U_REGEX_MISMATCHED_PAREN     0x10306
+#define U_REGEX_NUMBER_TOO_BIG       0x10307
+#define U_REGEX_BAD_INTERVAL         0x10308
+#define U_REGEX_MAX_LT_MIN           0x10309
+#define U_REGEX_INVALID_FLAG         0x1030b
+#define U_REGEX_MISSING_CLOSE_BRACKET 0x1030f
+#define U_REGEX_INVALID_RANGE        0x10310
+#define U_REGEX_STACK_OVERFLOW       0x10311
+#define U_REGEX_TIME_OUT             0x10312
+#define U_FAILURE(s) ((s) > U_ZERO_ERROR)
+
+#define UREGEX_CASE_INSENSITIVE 2
+#define UREGEX_COMMENTS         4
+#define UREGEX_MULTILINE        8
+#define UREGEX_LITERAL          16
+#define UREGEX_DOTALL           32
+
+int8_t CDECL u_charType( UChar32 c );
+UChar32 CDECL u_foldCase( UChar32 c, uint32_t options );
+
+/* ---- UText ---- */
+
+typedef struct UText UText;
+
+typedef struct UTextFuncs
+{
+    int32_t tableSize;
+    int32_t reserved1, reserved2, reserved3;
+    UText *(CDECL *clone)( UText *dest, const UText *src, UBool deep, UErrorCode *status );
+    int64_t (CDECL *nativeLength)( UText *ut );
+    UBool (CDECL *access)( UText *ut, int64_t index, UBool forward );
+    int32_t (CDECL *extract)( UText *ut, int64_t start, int64_t limit, UChar *dest, int32_t capacity, UErrorCode *status );
+    int32_t (CDECL *replace)( UText *ut, int64_t start, int64_t limit, const UChar *src, int32_t length, UErrorCode *status );
+    void (CDECL *copy)( UText *ut, int64_t start, int64_t limit, int64_t dest, UBool move, UErrorCode *status );
+    int64_t (CDECL *mapOffsetToNative)( const UText *ut );
+    int32_t (CDECL *mapNativeIndexToUTF16)( const UText *ut, int64_t index );
+    void (CDECL *close)( UText *ut );
+    void (CDECL *spare1)( UText *ut );
+    void (CDECL *spare2)( UText *ut );
+    void (CDECL *spare3)( UText *ut );
+} UTextFuncs;
+
+struct UText   /* 144 bytes on 64-bit, as ICU's */
+{
+    uint32_t magic;
+    int32_t flags;
+    int32_t providerProperties;
+    int32_t sizeOfStruct;
+    int64_t chunkNativeLimit;
+    int32_t extraSize;
+    int32_t nativeIndexingLimit;
+    int64_t chunkNativeStart;
+    int32_t chunkOffset;
+    int32_t chunkLength;
+    const UChar *chunkContents;
+    const UTextFuncs *pFuncs;
+    void *pExtra;
+    const void *context;
+    const void *p, *q, *r;
+    void *privP;
+    int64_t a;
+    int32_t b, c;
+    int64_t privA;
+#ifdef SG_MUTANT_UTEXT_PRIVB_64
+    int64_t privB;
+    int32_t privC;
+#else
+    int32_t privB, privC;
+#endif
+};
+
+#define UTEXT_MAGIC             0x345ad82c
+#define UTEXT_HEAP_OWNED        1
+#define UTEXT_EXTRA_HEAP_OWNED  2
+#define UTEXT_OPEN              4
+
+/***********************************************************************
+ *           utext_setup   (icu.@)
+ *
+ * A UText made ready for a provider: allocated when none is given, with extraSpace bytes it owns.
+ */
+UText * CDECL utext_setup( UText *ut, int32_t extra, UErrorCode *status )
+{
+    TRACE( "%p, %d, %p\n", ut, extra, status );
+
+    if (!status || U_FAILURE(*status)) return ut;
+    if (!ut)
+    {
+        if (!(ut = calloc( 1, sizeof(*ut) )))
+        {
+            *status = U_MEMORY_ALLOCATION_ERROR;
+            return NULL;
+        }
+        ut->magic = UTEXT_MAGIC;
+        ut->sizeOfStruct = sizeof(*ut);
+        ut->flags = UTEXT_HEAP_OWNED;
+    }
+    else
+    {
+        if (ut->magic != UTEXT_MAGIC)
+        {
+            *status = U_ILLEGAL_ARGUMENT_ERROR;
+            return ut;
+        }
+        if ((ut->flags & UTEXT_OPEN) && ut->pFuncs && ut->pFuncs->close) ut->pFuncs->close( ut );
+        ut->flags &= ~UTEXT_OPEN;
+    }
+    if (extra > ut->extraSize)
+    {
+        if (ut->flags & UTEXT_EXTRA_HEAP_OWNED) free( ut->pExtra );
+        ut->extraSize = 0;
+        ut->flags &= ~UTEXT_EXTRA_HEAP_OWNED;
+        if (!(ut->pExtra = calloc( 1, extra )))
+        {
+            *status = U_MEMORY_ALLOCATION_ERROR;
+            return ut;
+        }
+        ut->extraSize = extra;
+        ut->flags |= UTEXT_EXTRA_HEAP_OWNED;
+    }
+    ut->flags |= UTEXT_OPEN;
+    ut->providerProperties = 0;
+    ut->chunkNativeLimit = ut->chunkNativeStart = 0;
+    ut->nativeIndexingLimit = ut->chunkOffset = ut->chunkLength = 0;
+    ut->chunkContents = NULL;
+    ut->pFuncs = NULL;
+    ut->context = ut->p = ut->q = ut->r = NULL;
+    ut->privP = NULL;
+    ut->a = ut->privA = 0;
+    ut->b = ut->c = ut->privB = ut->privC = 0;
+    if (ut->pExtra && ut->extraSize) memset( ut->pExtra, 0, ut->extraSize );
+    return ut;
+}
+
+/***********************************************************************
+ *           utext_close   (icu.@)
+ */
+UText * CDECL utext_close( UText *ut )
+{
+    TRACE( "%p\n", ut );
+
+    if (!ut || ut->magic != UTEXT_MAGIC || !(ut->flags & UTEXT_OPEN)) return ut;
+    if (ut->pFuncs && ut->pFuncs->close) ut->pFuncs->close( ut );
+    ut->pFuncs = NULL;
+    ut->flags &= ~UTEXT_OPEN;
+    if (ut->flags & UTEXT_EXTRA_HEAP_OWNED)
+    {
+        free( ut->pExtra );
+        ut->pExtra = NULL;
+        ut->extraSize = 0;
+        ut->flags &= ~UTEXT_EXTRA_HEAP_OWNED;
+    }
+    if (ut->flags & UTEXT_HEAP_OWNED)
+    {
+        ut->magic = 0;
+        free( ut );
+        return NULL;
+    }
+    return ut;
+}
+
+/***********************************************************************
+ *           utext_nativeLength   (icu.@)
+ */
+int64_t CDECL utext_nativeLength( UText *ut )
+{
+    return ut && ut->pFuncs && ut->pFuncs->nativeLength ? ut->pFuncs->nativeLength( ut ) : 0;
+}
+
+/* the code unit at a native index, or -1 past the ends */
+static int text_at( UText *ut, int64_t index )
+{
+    int32_t offset;
+
+    if (index < 0) return -1;
+    if (index < ut->chunkNativeStart || index >= ut->chunkNativeLimit || index - ut->chunkNativeStart >= ut->nativeIndexingLimit)
+    {
+        if (!ut->pFuncs || !ut->pFuncs->access || !ut->pFuncs->access( ut, index, TRUE )) return -1;
+        if (index < ut->chunkNativeStart || index >= ut->chunkNativeLimit) return -1;
+    }
+    if (index - ut->chunkNativeStart < ut->nativeIndexingLimit) offset = index - ut->chunkNativeStart;
+    else if (ut->pFuncs->mapNativeIndexToUTF16) offset = ut->pFuncs->mapNativeIndexToUTF16( ut, index );
+    else return -1;
+    if (offset < 0 || offset >= ut->chunkLength || !ut->chunkContents) return -1;
+    return ut->chunkContents[offset];
+}
+
+/* a UText over a string of ours (uregex_setText) */
+static UBool CDECL string_access( UText *ut, int64_t index, UBool forward )
+{
+    int64_t length = ut->a;
+
+    if (index < 0 || index > length) return FALSE;
+    ut->chunkContents = ut->context;
+    ut->chunkNativeStart = 0;
+    ut->chunkNativeLimit = length;
+    ut->chunkLength = ut->nativeIndexingLimit = length;
+    ut->chunkOffset = index;
+    return forward ? index < length : index > 0;
+}
+
+static int64_t CDECL string_length( UText *ut )
+{
+    return ut->a;
+}
+
+static const UTextFuncs string_funcs = { sizeof(UTextFuncs), 0, 0, 0, NULL, string_length, string_access };
+
+/* ---- the compiled program ---- */
+
+enum op
+{
+    OP_CHAR,        /* arg: a code unit */
+    OP_ANY,         /* any but a line end (all with DOTALL: arg 1) */
+    OP_CLASS,       /* arg: the class index */
+    OP_SPLIT,       /* try x first, then y */
+    OP_JMP,         /* to x */
+    OP_SAVE,        /* arg: a capture slot */
+    OP_ASSERT,      /* arg: what */
+    OP_MATCH,
+};
+
+enum { AS_BOL, AS_EOL, AS_START, AS_END, AS_END_LINE, AS_WORD, AS_NOT_WORD };
+
+struct inst
+{
+    BYTE op;
+    int arg;
+    int x, y;
+};
+
+struct range { UChar first, last; };
+
+struct cclass
+{
+    BOOL negated;
+    unsigned int count;
+    struct range *ranges;
+    unsigned int kinds;     /* \d \w \s and their negations inside it: CK_* bits */
+};
+
+enum { CK_DIGIT = 1, CK_NOT_DIGIT = 2, CK_WORD = 4, CK_NOT_WORD = 8, CK_SPACE = 16, CK_NOT_SPACE = 32 };
+
+struct uregex
+{
+    UChar *pattern;
+    uint32_t flags;
+    struct inst *prog;
+    unsigned int count, size;
+    struct cclass *classes;
+    unsigned int nclasses;
+    int ngroups;
+    /* the text and the state of the search */
+    UText *text;
+    UText own_text;         /* for uregex_setText */
+    UChar *own_string;
+    int64_t region_start, region_end;
+    int64_t next;           /* where findNext starts */
+    BOOL matched;
+    int64_t *slots;         /* 2 per group, group 0 the match */
+    int32_t time_limit;
+};
+
+/* ---- the parser: pattern -> program ---- */
+
+struct parser
+{
+    struct uregex *re;
+    const UChar *s;
+    int pos, len;
+    UErrorCode status;
+};
+
+static int emit( struct parser *p, BYTE op, int arg, int x, int y )
+{
+    struct uregex *re = p->re;
+
+    if (re->count == re->size)
+    {
+        unsigned int size = re->size ? re->size * 2 : 64;
+        struct inst *prog = realloc( re->prog, size * sizeof(*prog) );
+        if (!prog || size > 1000000)
+        {
+            p->status = U_MEMORY_ALLOCATION_ERROR;
+            return 0;
+        }
+        re->prog = prog;
+        re->size = size;
+    }
+    re->prog[re->count].op = op;
+    re->prog[re->count].arg = arg;
+    re->prog[re->count].x = x;
+    re->prog[re->count].y = y;
+    return re->count++;
+}
+
+static BOOL at_end( struct parser *p ) { return p->pos >= p->len; }
+static int peek( struct parser *p ) { return at_end( p ) ? -1 : p->s[p->pos]; }
+
+static void class_add( struct cclass *cl, UChar first, UChar last, UErrorCode *status )
+{
+    struct range *ranges = realloc( cl->ranges, (cl->count + 1) * sizeof(*ranges) );
+
+    if (!ranges)
+    {
+        *status = U_MEMORY_ALLOCATION_ERROR;
+        return;
+    }
+    cl->ranges = ranges;
+    cl->ranges[cl->count].first = first;
+    cl->ranges[cl->count].last = last;
+    cl->count++;
+}
+
+static int new_class( struct parser *p )
+{
+    struct uregex *re = p->re;
+    struct cclass *classes = realloc( re->classes, (re->nclasses + 1) * sizeof(*classes) );
+
+    if (!classes)
+    {
+        p->status = U_MEMORY_ALLOCATION_ERROR;
+        return -1;
+    }
+    re->classes = classes;
+    memset( &classes[re->nclasses], 0, sizeof(*classes) );
+    return re->nclasses++;
+}
+
+static int hex_value( int c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* an escape after the backslash: a code unit (>= 0), or a class kind (-CK_*), or an assertion (-100 - AS_*) */
+static int parse_escape( struct parser *p, BOOL in_class )
+{
+    int c = peek( p ), v, n, digits;
+
+    if (c < 0)
+    {
+        p->status = U_REGEX_BAD_ESCAPE_SEQUENCE;
+        return 0;
+    }
+    p->pos++;
+    switch (c)
+    {
+    case 'd': return -CK_DIGIT;
+    case 'D': return -CK_NOT_DIGIT;
+    case 'w': return -CK_WORD;
+    case 'W': return -CK_NOT_WORD;
+    case 's': return -CK_SPACE;
+    case 'S': return -CK_NOT_SPACE;
+    case 't': return '\t';
+    case 'n': return '\n';
+    case 'r': return '\r';
+    case 'f': return '\f';
+    case 'a': return 7;
+    case 'e': return 27;
+    case '0':
+        for (v = 0, n = 0; n < 3 && peek( p ) >= '0' && peek( p ) <= '7'; n++) v = v * 8 + (p->s[p->pos++] - '0');
+        return v;
+    case 'x':
+    case 'u':
+        digits = c == 'u' ? 4 : 2;
+        if (c == 'x' && peek( p ) == '{')
+        {
+            p->pos++;
+            for (v = 0; (n = hex_value( peek( p ) )) >= 0; p->pos++) v = v * 16 + n;
+            if (peek( p ) != '}' || v > 0xffff)
+            {
+                p->status = v > 0xffff ? U_REGEX_UNIMPLEMENTED : U_REGEX_BAD_ESCAPE_SEQUENCE;
+                return 0;
+            }
+            p->pos++;
+            return v;
+        }
+        for (v = 0, n = 0; n < digits; n++, p->pos++)
+        {
+            int h = hex_value( peek( p ) );
+            if (h < 0)
+            {
+                p->status = U_REGEX_BAD_ESCAPE_SEQUENCE;
+                return 0;
+            }
+            v = v * 16 + h;
+        }
+        return v;
+    }
+    if (!in_class) switch (c)
+    {
+    case 'b': return -100 - AS_WORD;
+    case 'B': return -100 - AS_NOT_WORD;
+    case 'A': return -100 - AS_START;
+    case 'z': return -100 - AS_END;
+    case 'Z': return -100 - AS_END_LINE;
+    }
+    else if (c == 'b') return 8;
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '1' && c <= '9'))
+    {
+        /* \p, \k, back references, \G, \X, \N, \Q...: not ours yet */
+        FIXME( "escape \\%c not supported\n", c );
+        p->status = U_REGEX_UNIMPLEMENTED;
+        return 0;
+    }
+    return c;   /* an escaped symbol stands for itself */
+}
+
+static void parse_class( struct parser *p )
+{
+    int index = new_class( p ), c, first, last;
+    struct cclass *cl;
+
+    if (index < 0) return;
+    cl = &p->re->classes[index];
+    if (peek( p ) == '^')
+    {
+        cl->negated = TRUE;
+        p->pos++;
+    }
+    if (peek( p ) == ']')   /* a ] first is itself */
+    {
+        class_add( cl, ']', ']', &p->status );
+        p->pos++;
+    }
+    for (;;)
+    {
+        if (at_end( p ))
+        {
+            p->status = U_REGEX_MISSING_CLOSE_BRACKET;
+            return;
+        }
+        c = p->s[p->pos++];
+        if (c == ']') break;
+        if (c == '[')
+        {
+            FIXME( "nested or POSIX classes not supported\n" );
+            p->status = U_REGEX_UNIMPLEMENTED;
+            return;
+        }
+        if (c == '\\')
+        {
+            first = parse_escape( p, TRUE );
+            if (p->status) return;
+            if (first < 0)
+            {
+                cl = &p->re->classes[index];
+                cl->kinds |= -first;
+                continue;
+            }
+        }
+        else first = c;
+        last = first;
+        if (peek( p ) == '-' && p->pos + 1 < p->len && p->s[p->pos + 1] != ']')
+        {
+            p->pos++;
+            c = p->s[p->pos++];
+            if (c == '\\')
+            {
+                last = parse_escape( p, TRUE );
+                if (p->status) return;
+                if (last < 0)
+                {
+                    p->status = U_REGEX_INVALID_RANGE;
+                    return;
+                }
+            }
+            else last = c;
+            if (last < first)
+            {
+                p->status = U_REGEX_INVALID_RANGE;
+                return;
+            }
+        }
+        cl = &p->re->classes[index];
+        class_add( cl, first, last, &p->status );
+        if (p->status) return;
+    }
+    emit( p, OP_CLASS, index, 0, 0 );
+}
+
+static void parse_alternation( struct parser *p );
+
+/* one atom; FALSE if there is none here */
+static BOOL parse_atom( struct parser *p )
+{
+    int c = peek( p ), v, index;
+
+    switch (c)
+    {
+    case -1: case '|': case ')':
+        return FALSE;
+    case '(':
+    {
+        int group = -1;
+        p->pos++;
+        if (peek( p ) == '?')
+        {
+            p->pos++;
+            if (peek( p ) != ':')
+            {
+                FIXME( "group (?%c not supported\n", peek( p ) );
+                p->status = U_REGEX_UNIMPLEMENTED;
+                return FALSE;
+            }
+            p->pos++;
+        }
+        else group = ++p->re->ngroups;
+        if (group > 0) emit( p, OP_SAVE, group * 2, 0, 0 );
+        parse_alternation( p );
+        if (p->status) return FALSE;
+        if (peek( p ) != ')')
+        {
+            p->status = U_REGEX_MISMATCHED_PAREN;
+            return FALSE;
+        }
+        p->pos++;
+        if (group > 0) emit( p, OP_SAVE, group * 2 + 1, 0, 0 );
+        return TRUE;
+    }
+    case '[':
+        p->pos++;
+        parse_class( p );
+        return !p->status;
+    case '.':
+        p->pos++;
+        emit( p, OP_ANY, !!(p->re->flags & UREGEX_DOTALL), 0, 0 );
+        return TRUE;
+    case '^':
+        p->pos++;
+        emit( p, OP_ASSERT, AS_BOL, 0, 0 );
+        return TRUE;
+    case '$':
+        p->pos++;
+        emit( p, OP_ASSERT, AS_EOL, 0, 0 );
+        return TRUE;
+    case '*': case '+': case '?':
+        p->status = U_REGEX_RULE_SYNTAX;
+        return FALSE;
+    case '\\':
+        p->pos++;
+        v = parse_escape( p, FALSE );
+        if (p->status) return FALSE;
+        if (v <= -100) emit( p, OP_ASSERT, -100 - v, 0, 0 );
+        else if (v < 0)
+        {
+            if ((index = new_class( p )) < 0) return FALSE;
+            p->re->classes[index].kinds = -v;
+            emit( p, OP_CLASS, index, 0, 0 );
+        }
+        else emit( p, OP_CHAR, v, 0, 0 );
+        return TRUE;
+    default:
+        p->pos++;
+        emit( p, OP_CHAR, c, 0, 0 );
+        return TRUE;
+    }
+}
+
+static int parse_number( struct parser *p )
+{
+    int v = -1;
+
+    while (peek( p ) >= '0' && peek( p ) <= '9')
+    {
+        v = (v < 0 ? 0 : v * 10) + (p->s[p->pos++] - '0');
+        if (v > 10000)
+        {
+            p->status = U_REGEX_NUMBER_TOO_BIG;
+            return -1;
+        }
+    }
+    return v;
+}
+
+/* a quantified atom at [start, end) of the program, made into its repetition */
+static void quantify( struct parser *p, int start, int min, int max, BOOL greedy )
+{
+    struct uregex *re = p->re;
+    int len = re->count - start, i, split, piece;
+    struct inst *saved;
+
+    /* the atom moves to the end, copied min times and then (max - min) optional times or a loop */
+    if (!(saved = malloc( len * sizeof(*saved) )))
+    {
+        p->status = U_MEMORY_ALLOCATION_ERROR;
+        return;
+    }
+    memcpy( saved, re->prog + start, len * sizeof(*saved) );
+    re->count = start;
+    for (i = 0; i < min; i++)
+    {
+        piece = re->count;
+        for (int k = 0; k < len; k++)
+        {
+            struct inst in = saved[k];
+            if (in.op == OP_SPLIT || in.op == OP_JMP)
+            {
+                in.x += piece - start;
+                if (in.op == OP_SPLIT) in.y += piece - start;
+            }
+            emit( p, in.op, in.arg, in.x, in.y );
+        }
+        if (p->status) goto done;
+    }
+    if (max < 0)
+    {
+        /* L: split body, out; body; jmp L */
+        split = emit( p, OP_SPLIT, 0, 0, 0 );
+        piece = re->count;
+        for (int k = 0; k < len; k++)
+        {
+            struct inst in = saved[k];
+            if (in.op == OP_SPLIT || in.op == OP_JMP)
+            {
+                in.x += piece - start;
+                if (in.op == OP_SPLIT) in.y += piece - start;
+            }
+            emit( p, in.op, in.arg, in.x, in.y );
+        }
+        emit( p, OP_JMP, 0, split, 0 );
+        if (p->status) goto done;
+        re->prog[split].x = greedy ? piece : re->count;
+        re->prog[split].y = greedy ? re->count : piece;
+    }
+    else
+    {
+        int *splits = malloc( (max - min + 1) * sizeof(int) ), n = 0;
+        if (!splits)
+        {
+            p->status = U_MEMORY_ALLOCATION_ERROR;
+            goto done;
+        }
+        for (i = min; i < max; i++)
+        {
+            splits[n++] = emit( p, OP_SPLIT, 0, 0, 0 );
+            piece = re->count;
+            for (int k = 0; k < len; k++)
+            {
+                struct inst in = saved[k];
+                if (in.op == OP_SPLIT || in.op == OP_JMP)
+                {
+                    in.x += piece - start;
+                    if (in.op == OP_SPLIT) in.y += piece - start;
+                }
+                emit( p, in.op, in.arg, in.x, in.y );
+            }
+            if (p->status) break;
+            re->prog[splits[n - 1]].x = piece;   /* its y: past them all, below */
+        }
+        for (i = 0; !p->status && i < n; i++)
+        {
+            int body = re->prog[splits[i]].x;
+            re->prog[splits[i]].x = greedy ? body : re->count;
+            re->prog[splits[i]].y = greedy ? re->count : body;
+        }
+        free( splits );
+    }
+done:
+    free( saved );
+}
+
+static void parse_sequence( struct parser *p )
+{
+    while (!p->status)
+    {
+        int start = p->re->count, c, min, max;
+        BOOL greedy = TRUE;
+
+        if (p->re->flags & UREGEX_COMMENTS)
+            while (peek( p ) == ' ' || peek( p ) == '\t' || peek( p ) == '\n' || peek( p ) == '\r') p->pos++;
+        if (!parse_atom( p )) return;
+        c = peek( p );
+        switch (c)
+        {
+        case '*': min = 0; max = -1; p->pos++; break;
+        case '+': min = 1; max = -1; p->pos++; break;
+        case '?': min = 0; max = 1; p->pos++; break;
+        case '{':
+            p->pos++;
+            min = parse_number( p );
+            max = min;
+            if (peek( p ) == ',')
+            {
+                p->pos++;
+                max = parse_number( p );
+            }
+            if (p->status) return;
+            if (min < 0 || peek( p ) != '}')
+            {
+                p->status = U_REGEX_BAD_INTERVAL;
+                return;
+            }
+            p->pos++;
+            if (max >= 0 && max < min)
+            {
+                p->status = U_REGEX_MAX_LT_MIN;
+                return;
+            }
+            break;
+        default:
+            continue;
+        }
+        if (peek( p ) == '?')
+        {
+            greedy = FALSE;
+            p->pos++;
+        }
+        else if (peek( p ) == '+')   /* possessive: matched as greedy */
+            p->pos++;
+        quantify( p, start, min, max, greedy );
+    }
+}
+
+static void parse_alternation( struct parser *p )
+{
+    struct uregex *re = p->re;
+    int start = re->count, end, i, jmp;
+
+    parse_sequence( p );
+    if (p->status || peek( p ) != '|') return;
+    p->pos++;
+    /* split first, rest; first; jmp out; rest */
+    end = re->count;
+    emit( p, OP_JMP, 0, 0, 0 );   /* room for the split */
+    if (p->status) return;
+    memmove( re->prog + start + 1, re->prog + start, (end - start) * sizeof(struct inst) );
+    for (i = start + 1; i <= end; i++)
+    {
+        if (re->prog[i].op != OP_SPLIT && re->prog[i].op != OP_JMP) continue;
+        re->prog[i].x++;
+        if (re->prog[i].op == OP_SPLIT) re->prog[i].y++;
+    }
+    jmp = emit( p, OP_JMP, 0, 0, 0 );
+    if (p->status) return;
+    re->prog[start].op = OP_SPLIT;
+    re->prog[start].arg = 0;
+    re->prog[start].x = start + 1;
+    re->prog[start].y = jmp + 1;
+    parse_alternation( p );
+    re->prog[jmp].x = re->count;
+}
+
+static void compile( struct uregex *re, const UChar *pattern, int len, UErrorCode *status )
+{
+    struct parser p = { re, pattern, 0, len, U_ZERO_ERROR };
+    int i;
+
+    emit( &p, OP_SAVE, 0, 0, 0 );
+    if (re->flags & UREGEX_LITERAL)
+        for (i = 0; i < len && !p.status; i++) emit( &p, OP_CHAR, pattern[i], 0, 0 );
+    else
+    {
+        parse_alternation( &p );
+        if (!p.status && !at_end( &p )) p.status = peek( &p ) == ')' ? U_REGEX_MISMATCHED_PAREN : U_REGEX_RULE_SYNTAX;
+    }
+    emit( &p, OP_SAVE, 1, 0, 0 );
+    emit( &p, OP_MATCH, 0, 0, 0 );
+#ifdef SG_MUTANT_UREGEX_NOT_COMPILED
+    p.status = U_REGEX_UNIMPLEMENTED;
+#endif
+    *status = p.status;
+}
+
+/* ---- the matcher ---- */
+
+static BOOL is_word( int c )
+{
+    int type;
+    if (c < 0) return FALSE;
+    if (c == '_') return TRUE;
+    type = u_charType( c );
+    return (type >= 1 && type <= 9) || type == 22;   /* letters, marks, decimal digits, connectors */
+}
+
+static BOOL is_space( int c )
+{
+    int type;
+    if (c < 0) return FALSE;
+    if ((c >= 9 && c <= 13) || c == 0x85) return TRUE;
+    type = u_charType( c );
+    return type >= 12 && type <= 14;
+}
+
+static BOOL is_line_end( int c )
+{
+    return c == '\n' || c == '\r' || c == 0x0b || c == 0x0c || c == 0x85 || c == 0x2028 || c == 0x2029;
+}
+
+static int fold( int c )
+{
+    return c < 0 ? c : u_foldCase( c, 0 );
+}
+
+static BOOL class_has( const struct cclass *cl, int c, BOOL nocase )
+{
+    unsigned int i;
+    BOOL in = FALSE;
+
+    for (i = 0; i < cl->count && !in; i++)
+    {
+        if (c >= cl->ranges[i].first && c <= cl->ranges[i].last) in = TRUE;
+        else if (nocase)
+        {
+            int f = fold( c ), u = c;
+            if (f >= 'a' && f <= 'z') u = f - 'a' + 'A';
+            if ((f >= cl->ranges[i].first && f <= cl->ranges[i].last) || (u >= cl->ranges[i].first && u <= cl->ranges[i].last)) in = TRUE;
+            else
+            {
+                UChar first = cl->ranges[i].first, last = cl->ranges[i].last, k;
+                for (k = first; !in && k <= last && last - first < 512; k++) if (fold( k ) == f) in = TRUE;
+            }
+        }
+    }
+    if (!in && cl->kinds)
+    {
+        int type = u_charType( c );
+        if ((cl->kinds & CK_DIGIT) && type == 9) in = TRUE;
+        if ((cl->kinds & CK_NOT_DIGIT) && type != 9) in = TRUE;
+        if ((cl->kinds & CK_WORD) && is_word( c )) in = TRUE;
+        if ((cl->kinds & CK_NOT_WORD) && !is_word( c )) in = TRUE;
+        if ((cl->kinds & CK_SPACE) && is_space( c )) in = TRUE;
+        if ((cl->kinds & CK_NOT_SPACE) && !is_space( c )) in = TRUE;
+    }
+    return in != cl->negated;
+}
+
+struct frame { int pc; int64_t pos; int slot; int64_t old; };
+
+/* the program from a start position: TRUE and the slots set on a match */
+static BOOL run( struct uregex *re, int64_t start, UErrorCode *status, int64_t *steps )
+{
+    struct frame *stack = NULL;
+    unsigned int depth = 0, size = 0;
+    int ngroup_slots = (re->ngroups + 1) * 2, i;
+    BOOL nocase = !!(re->flags & UREGEX_CASE_INSENSITIVE), multiline = !!(re->flags & UREGEX_MULTILINE);
+    int pc = 0;
+    int64_t pos = start;
+    UText *ut = re->text;
+
+    for (i = 0; i < ngroup_slots; i++) re->slots[i] = -1;
+    for (;;)
+    {
+        const struct inst *in = &re->prog[pc];
+        BOOL fail = FALSE;
+        int c;
+
+        if (++*steps > 50000000)
+        {
+            *status = U_REGEX_TIME_OUT;
+            free( stack );
+            return FALSE;
+        }
+        switch (in->op)
+        {
+        case OP_CHAR:
+            c = pos < re->region_end ? text_at( ut, pos ) : -1;
+            if (c == in->arg || (nocase && c >= 0 && fold( c ) == fold( in->arg ))) { pc++; pos++; }
+            else fail = TRUE;
+            break;
+        case OP_ANY:
+            c = pos < re->region_end ? text_at( ut, pos ) : -1;
+            if (c >= 0 && (in->arg || !is_line_end( c ))) { pc++; pos++; }
+            else fail = TRUE;
+            break;
+        case OP_CLASS:
+            c = pos < re->region_end ? text_at( ut, pos ) : -1;
+            if (c >= 0 && class_has( &re->classes[in->arg], c, nocase )) { pc++; pos++; }
+            else fail = TRUE;
+            break;
+        case OP_JMP:
+            pc = in->x;
+            break;
+        case OP_SPLIT:
+        case OP_SAVE:
+            if (depth == size)
+            {
+                unsigned int new_size = size ? size * 2 : 256;
+                struct frame *s = realloc( stack, new_size * sizeof(*s) );
+                if (!s || new_size > 4000000)
+                {
+                    free( s ? s : stack );
+                    *status = U_REGEX_STACK_OVERFLOW;
+                    return FALSE;
+                }
+                stack = s;
+                size = new_size;
+            }
+            if (in->op == OP_SPLIT)
+            {
+                stack[depth].pc = in->y;
+                stack[depth].pos = pos;
+                stack[depth].slot = -1;
+                depth++;
+                pc = in->x;
+            }
+            else
+            {
+                stack[depth].pc = -1;   /* undo the save */
+                stack[depth].slot = in->arg;
+                stack[depth].old = re->slots[in->arg];
+                depth++;
+                re->slots[in->arg] = pos;
+                pc++;
+            }
+            break;
+        case OP_ASSERT:
+        {
+            int before = pos > re->region_start ? text_at( ut, pos - 1 ) : -1;
+            int after = pos < re->region_end ? text_at( ut, pos ) : -1;
+            BOOL ok;
+            switch (in->arg)
+            {
+            case AS_BOL: ok = pos == re->region_start || (multiline && is_line_end( before ) &&
+                                 !(before == '\r' && after == '\n')); break;
+            case AS_EOL:
+                if (multiline) ok = after < 0 || (is_line_end( after ) && !(after == '\n' && before == '\r'));
+                else ok = after < 0 || (is_line_end( after ) && (pos + 1 >= re->region_end ||
+                          (after == '\r' && pos + 2 >= re->region_end && text_at( ut, pos + 1 ) == '\n')));
+                break;
+            case AS_START: ok = pos == re->region_start; break;
+            case AS_END: ok = after < 0; break;
+            case AS_END_LINE: ok = after < 0 || (is_line_end( after ) && pos + 1 >= re->region_end); break;
+            case AS_WORD: ok = is_word( before ) != is_word( after ); break;
+            default: ok = is_word( before ) == is_word( after ); break;
+            }
+            if (ok) pc++;
+            else fail = TRUE;
+            break;
+        }
+        case OP_MATCH:
+            free( stack );
+            return TRUE;
+        }
+        if (!fail) continue;
+        /* back to the last choice, undoing saves on the way */
+        for (;;)
+        {
+            if (!depth)
+            {
+                free( stack );
+                return FALSE;
+            }
+            depth--;
+            if (stack[depth].slot >= 0)
+            {
+                re->slots[stack[depth].slot] = stack[depth].old;
+                continue;
+            }
+            pc = stack[depth].pc;
+            pos = stack[depth].pos;
+            break;
+        }
+    }
+}
+
+/* the first match from a position on */
+static BOOL search( struct uregex *re, int64_t from, UErrorCode *status )
+{
+    int64_t start, steps = 0;
+
+    re->matched = FALSE;
+    if (!re->text)
+    {
+        *status = U_REGEX_INVALID_STATE;
+        return FALSE;
+    }
+#ifdef SG_MUTANT_UREGEX_NEVER_MATCHES
+    return FALSE;
+#endif
+    for (start = from; start <= re->region_end; start++)
+    {
+        if (run( re, start, status, &steps ))
+        {
+            re->matched = TRUE;
+            re->next = re->slots[1] > re->slots[0] ? re->slots[1] : re->slots[1] + 1;
+            return TRUE;
+        }
+        if (U_FAILURE(*status)) return FALSE;
+    }
+    re->next = re->region_end + 1;
+    return FALSE;
+}
+
+/* ---- the API ---- */
+
+/***********************************************************************
+ *           uregex_open   (icu.@)
+ */
+struct uregex * CDECL uregex_open( const UChar *pattern, int32_t length, uint32_t flags, void *parse_error, UErrorCode *status )
+{
+    struct uregex *re;
+
+    TRACE( "%s, %d, %#x, %p, %p\n", debugstr_wn( pattern, length < 0 ? -1 : length ), length, flags, parse_error, status );
+
+    if (!status || U_FAILURE(*status)) return NULL;
+    if (!pattern || length < -1 || (length == 0 && !pattern))
+    {
+        *status = U_ILLEGAL_ARGUMENT_ERROR;
+        return NULL;
+    }
+    if (length == -1) length = lstrlenW( pattern );
+    if (parse_error) memset( parse_error, 0, 8 + 2 * 16 * sizeof(UChar) );   /* UParseError: line, offset, pre/postContext[16] */
+    if (!(re = calloc( 1, sizeof(*re) )) || !(re->pattern = malloc( (length + 1) * sizeof(UChar) )))
+    {
+        free( re );
+        *status = U_MEMORY_ALLOCATION_ERROR;
+        return NULL;
+    }
+    memcpy( re->pattern, pattern, length * sizeof(UChar) );
+    re->pattern[length] = 0;
+    re->flags = flags;
+    compile( re, pattern, length, status );
+    if (!U_FAILURE(*status) && !(re->slots = calloc( (re->ngroups + 1) * 2, sizeof(*re->slots) )))
+        *status = U_MEMORY_ALLOCATION_ERROR;
+    if (U_FAILURE(*status))
+    {
+        WARN( "%s not compiled: %#x\n", debugstr_wn( pattern, length ), *status );
+        free( re->prog );
+        for (unsigned int i = 0; i < re->nclasses; i++) free( re->classes[i].ranges );
+        free( re->classes );
+        free( re->pattern );
+        free( re->slots );
+        free( re );
+        return NULL;
+    }
+    return re;
+}
+
+/***********************************************************************
+ *           uregex_close   (icu.@)
+ */
+void CDECL uregex_close( struct uregex *re )
+{
+    unsigned int i;
+
+    TRACE( "%p\n", re );
+    if (!re) return;
+    free( re->prog );
+    for (i = 0; i < re->nclasses; i++) free( re->classes[i].ranges );
+    free( re->classes );
+    free( re->pattern );
+    free( re->slots );
+    free( re->own_string );
+    free( re );
+}
+
+static BOOL check( struct uregex *re, UErrorCode *status )
+{
+    if (!status || U_FAILURE(*status)) return FALSE;
+    if (!re)
+    {
+        *status = U_ILLEGAL_ARGUMENT_ERROR;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           uregex_setUText   (icu.@)
+ */
+void CDECL uregex_setUText( struct uregex *re, UText *text, UErrorCode *status )
+{
+    TRACE( "%p, %p, %p\n", re, text, status );
+
+    if (!check( re, status )) return;
+    if (!text || text->magic != UTEXT_MAGIC)
+    {
+        *status = U_ILLEGAL_ARGUMENT_ERROR;
+        return;
+    }
+    re->text = text;
+    re->region_start = 0;
+    re->region_end = utext_nativeLength( text );
+    re->next = 0;
+    re->matched = FALSE;
+}
+
+/***********************************************************************
+ *           uregex_setText   (icu.@)
+ */
+void CDECL uregex_setText( struct uregex *re, const UChar *text, int32_t length, UErrorCode *status )
+{
+    TRACE( "%p, %s, %d, %p\n", re, debugstr_wn( text, length < 0 ? -1 : length ), length, status );
+
+    if (!check( re, status )) return;
+    if (!text || length < -1)
+    {
+        *status = U_ILLEGAL_ARGUMENT_ERROR;
+        return;
+    }
+    if (length == -1) length = lstrlenW( text );
+    memset( &re->own_text, 0, sizeof(re->own_text) );
+    re->own_text.magic = UTEXT_MAGIC;
+    re->own_text.sizeOfStruct = sizeof(re->own_text);
+    re->own_text.flags = UTEXT_OPEN;
+    re->own_text.pFuncs = &string_funcs;
+    re->own_text.context = text;   /* the caller keeps it, as ICU requires */
+    re->own_text.a = length;
+    uregex_setUText( re, &re->own_text, status );
+}
+
+/***********************************************************************
+ *           uregex_setTimeLimit   (icu.@)
+ */
+void CDECL uregex_setTimeLimit( struct uregex *re, int32_t limit, UErrorCode *status )
+{
+    if (!check( re, status )) return;
+    re->time_limit = limit;   /* our machine stops after a fixed number of steps */
+}
+
+/***********************************************************************
+ *           uregex_setStackLimit   (icu.@)
+ */
+void CDECL uregex_setStackLimit( struct uregex *re, int32_t limit, UErrorCode *status )
+{
+    check( re, status );
+}
+
+/***********************************************************************
+ *           uregex_reset64   (icu.@)
+ */
+void CDECL uregex_reset64( struct uregex *re, int64_t index, UErrorCode *status )
+{
+    if (!check( re, status )) return;
+    if (index < re->region_start || index > re->region_end)
+    {
+        *status = U_INDEX_OUTOFBOUNDS_ERROR;
+        return;
+    }
+    re->next = index;
+    re->matched = FALSE;
+}
+
+/***********************************************************************
+ *           uregex_reset   (icu.@)
+ */
+void CDECL uregex_reset( struct uregex *re, int32_t index, UErrorCode *status )
+{
+    uregex_reset64( re, index, status );
+}
+
+/***********************************************************************
+ *           uregex_find64   (icu.@)
+ *
+ * The first match from an index on; -1: from where the last one ended.
+ */
+UBool CDECL uregex_find64( struct uregex *re, int64_t start, UErrorCode *status )
+{
+    TRACE( "%p, %s, %p\n", re, wine_dbgstr_longlong( start ), status );
+
+    if (!check( re, status )) return FALSE;
+    if (start == -1) start = re->next;
+    else if (start < 0 || start > re->region_end)
+    {
+        *status = U_INDEX_OUTOFBOUNDS_ERROR;
+        return FALSE;
+    }
+    return search( re, start, status );
+}
+
+/***********************************************************************
+ *           uregex_find   (icu.@)
+ */
+UBool CDECL uregex_find( struct uregex *re, int32_t start, UErrorCode *status )
+{
+    return uregex_find64( re, start, status );
+}
+
+/***********************************************************************
+ *           uregex_findNext   (icu.@)
+ */
+UBool CDECL uregex_findNext( struct uregex *re, UErrorCode *status )
+{
+    TRACE( "%p, %p\n", re, status );
+
+    if (!check( re, status )) return FALSE;
+    if (re->next > re->region_end)
+    {
+        re->matched = FALSE;
+        return FALSE;
+    }
+    return search( re, re->next, status );
+}
+
+/***********************************************************************
+ *           uregex_matches64   (icu.@)
+ */
+UBool CDECL uregex_matches64( struct uregex *re, int64_t start, UErrorCode *status )
+{
+    int64_t from, steps = 0;
+
+    if (!check( re, status )) return FALSE;
+    if (!re->text)
+    {
+        *status = U_REGEX_INVALID_STATE;
+        return FALSE;
+    }
+    from = start == -1 ? re->region_start : start;
+    re->matched = run( re, from, status, &steps ) && re->slots[1] == re->region_end;
+    return re->matched;
+}
+
+/***********************************************************************
+ *           uregex_matches   (icu.@)
+ */
+UBool CDECL uregex_matches( struct uregex *re, int32_t start, UErrorCode *status )
+{
+    return uregex_matches64( re, start, status );
+}
+
+/***********************************************************************
+ *           uregex_groupCount   (icu.@)
+ */
+int32_t CDECL uregex_groupCount( struct uregex *re, UErrorCode *status )
+{
+    if (!check( re, status )) return 0;
+    return re->ngroups;
+}
+
+static BOOL group_check( struct uregex *re, int32_t group, UErrorCode *status )
+{
+    if (!check( re, status )) return FALSE;
+    if (!re->matched)
+    {
+        *status = U_REGEX_INVALID_STATE;
+        return FALSE;
+    }
+    if (group < 0 || group > re->ngroups)
+    {
+        *status = U_INDEX_OUTOFBOUNDS_ERROR;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           uregex_start64   (icu.@)
+ */
+int64_t CDECL uregex_start64( struct uregex *re, int32_t group, UErrorCode *status )
+{
+    if (!group_check( re, group, status )) return -1;
+    return re->slots[group * 2];
+}
+
+/***********************************************************************
+ *           uregex_end64   (icu.@)
+ */
+int64_t CDECL uregex_end64( struct uregex *re, int32_t group, UErrorCode *status )
+{
+    if (!group_check( re, group, status )) return -1;
+    return re->slots[group * 2] < 0 ? -1 : re->slots[group * 2 + 1];
+}
+
+/***********************************************************************
+ *           uregex_start   (icu.@)
+ */
+int32_t CDECL uregex_start( struct uregex *re, int32_t group, UErrorCode *status )
+{
+    return uregex_start64( re, group, status );
+}
+
+/***********************************************************************
+ *           uregex_end   (icu.@)
+ */
+int32_t CDECL uregex_end( struct uregex *re, int32_t group, UErrorCode *status )
+{
+    return uregex_end64( re, group, status );
+}
+
+/***********************************************************************
+ *           uregex_pattern   (icu.@)
+ */
+const UChar * CDECL uregex_pattern( struct uregex *re, int32_t *length, UErrorCode *status )
+{
+    if (!check( re, status )) return NULL;
+    if (length) *length = lstrlenW( re->pattern );
+    return re->pattern;
+}
+
+/***********************************************************************
+ *           uregex_flags   (icu.@)
+ */
+int32_t CDECL uregex_flags( struct uregex *re, UErrorCode *status )
+{
+    if (!check( re, status )) return 0;
+    return re->flags;
+}
+
+/***********************************************************************
+ *           uregex_clone   (icu.@)
+ *
+ * The same expression, without its text or state (for another thread).
+ */
+struct uregex * CDECL uregex_clone( struct uregex *re, UErrorCode *status )
+{
+    struct uregex *copy;
+
+    TRACE( "%p, %p\n", re, status );
+    if (!check( re, status )) return NULL;
+    if ((copy = uregex_open( re->pattern, -1, re->flags, NULL, status ))) copy->time_limit = re->time_limit;
+    return copy;
+}
