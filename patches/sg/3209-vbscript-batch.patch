+            funcs++;
+        }
+    }
+    for (i = 0, vars = 0; i < desc->prop_cnt; i++)
+        if (desc->props[i].is_public) type_info->var_ids[vars++] = desc->func_cnt + i;
+
+    IDispatchEx_AddRef(&obj->IDispatchEx_iface);
