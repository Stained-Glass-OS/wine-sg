+    return S_OK;
+}
+
+static HRESULT WINAPI SubMatchesEnum_Clone(IEnumVARIANT *iface, IEnumVARIANT **ppEnum)
+{
+    SubMatchesEnum *This = impl_from_SubMatchesEnum(iface);
+
