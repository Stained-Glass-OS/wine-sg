+/* enumerator of the sub matches of a match: the strings, Empty for a group that did not take part */
+typedef struct {
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    ISubMatches *sm;
+    LONG pos;
+    LONG count;
+} SubMatchesEnum;
+
+static inline SubMatchesEnum *impl_from_SubMatchesEnum(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, SubMatchesEnum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI SubMatchesEnum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **ppv)
+{
+    SubMatchesEnum *This = impl_from_SubMatchesEnum(iface);
+
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumVARIANT)) {
+        *ppv = &This->IEnumVARIANT_iface;
+        IUnknown_AddRef((IUnknown*)*ppv);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI SubMatchesEnum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_SubMatchesEnum(iface)->ref);
+}
+
+static ULONG WINAPI SubMatchesEnum_Release(IEnumVARIANT *iface)
+{
+    SubMatchesEnum *This = impl_from_SubMatchesEnum(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref) {
+        ISubMatches_Release(This->sm);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI SubMatchesEnum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *rgVar, ULONG *pCeltFetched)
+{
+    SubMatchesEnum *This = impl_from_SubMatchesEnum(iface);
+    ULONG i;
+    HRESULT hres;
+
+    TRACE("(%p)->(%lu %p %p)\n", This, celt, rgVar, pCeltFetched);
+
+    if(!rgVar || (!pCeltFetched && celt != 1))
+        return E_POINTER;
+
+    for(i = 0; i < celt && This->pos < This->count; i++) {
+        VariantInit(rgVar + i);
+        hres = ISubMatches_get_Item(This->sm, This->pos, rgVar + i);
+        if(FAILED(hres)) {
+            while(i--)
+                VariantClear(rgVar + i);
+            if(pCeltFetched)
+                *pCeltFetched = 0;
+            return hres;
+        }
+        This->pos++;
+    }
+    if(pCeltFetched)
+        *pCeltFetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI SubMatchesEnum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    SubMatchesEnum *This = impl_from_SubMatchesEnum(iface);
+    ULONG left = This->count - This->pos;
+
+    TRACE("(%p)->(%lu)\n", This, celt);
+
+    This->pos += min(celt, left);
+    return celt <= left ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI SubMatchesEnum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_SubMatchesEnum(iface)->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl SubMatchesEnum_Vtbl;
+
+static HRESULT create_sub_matches_enum(ISubMatches *sm, LONG pos, IEnumVARIANT **ret)
+{
+    SubMatchesEnum *This = calloc(1, sizeof(*This));
