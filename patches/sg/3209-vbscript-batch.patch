+
+/* Drops the type libraries of the script (the persistent ones stay unless all is TRUE) and the
+ * constants looked up in them */
+static void release_typelibs(script_ctx_t *ctx, BOOL all)
+{
+    typelib_entry_t *iter, *next;
+
+    while(ctx->typelib_vars) {
+        dynamic_var_t *var = ctx->typelib_vars;
+
+        ctx->typelib_vars = var->next;
+        release_dynamic_var(var);
+        free((WCHAR*)var->name);
+        free(var);
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(iter, next, &ctx->typelibs, typelib_entry_t, entry) {
+#ifndef SG_MUTANT_VBB1_TLPERSIST
+        if(!all && (iter->flags & SCRIPTTYPELIB_ISPERSISTENT))
+            continue;
+#endif
+        list_remove(&iter->entry);
+        ITypeLib_Release(iter->lib);
+        free(iter);
+    }
+}
+
+/* The constants of the enumerations and modules of the added type libraries are global names of
+ * the script. A constant is read once; its value then lives as long as the libraries. */
+VARIANT *lookup_typelib_const(script_ctx_t *ctx, const WCHAR *name)
+{
+    typelib_entry_t *entry;
+    dynamic_var_t *var;
+    UINT i, count;
+
+    for(var = ctx->typelib_vars; var; var = var->next) {
+        if(!wcsicmp(var->name, name))
+            return &var->v;
+    }
+
+#ifdef SG_MUTANT_VBB1_TYPELIB
+    return NULL;
+#endif
+    LIST_FOR_EACH_ENTRY(entry, &ctx->typelibs, typelib_entry_t, entry) {
+        count = ITypeLib_GetTypeInfoCount(entry->lib);
+        for(i = 0; i < count; i++) {
+            ITypeInfo *info;
+            TYPEATTR *attr;
+            UINT v;
+
+            if(FAILED(ITypeLib_GetTypeInfo(entry->lib, i, &info)))
+                continue;
+            if(FAILED(ITypeInfo_GetTypeAttr(info, &attr))) {
+                ITypeInfo_Release(info);
+                continue;
+            }
+            if(attr->typekind == TKIND_ENUM || attr->typekind == TKIND_MODULE) {
+                for(v = 0; v < attr->cVars; v++) {
+                    VARDESC *vd;
+                    BSTR vname;
+                    UINT n;
+
+                    if(FAILED(ITypeInfo_GetVarDesc(info, v, &vd)))
+                        continue;
+                    if(vd->varkind == VAR_CONST && vd->lpvarValue &&
+                       SUCCEEDED(ITypeInfo_GetNames(info, vd->memid, &vname, 1, &n)) && n) {
+                        BOOL match = !wcsicmp(vname, name);
+
+                        SysFreeString(vname);
+                        if(match && (var = calloc(1, sizeof(*var)))) {
+                            var->name = wcsdup(name);
+                            if(var->name && SUCCEEDED(VariantCopy(&var->v, vd->lpvarValue))) {
+                                var->is_const = TRUE;
+                                var->next = ctx->typelib_vars;
+                                ctx->typelib_vars = var;
+                            }else {
+                                free((WCHAR*)var->name);
+                                free(var);
+                                var = NULL;
+                            }
+                            ITypeInfo_ReleaseVarDesc(info, vd);
+                            ITypeInfo_ReleaseTypeAttr(info, attr);
+                            ITypeInfo_Release(info);
+                            return var ? &var->v : NULL;
+                        }
+                    }
+                    ITypeInfo_ReleaseVarDesc(info, vd);
+                }
+            }
+            ITypeInfo_ReleaseTypeAttr(info, attr);
+            ITypeInfo_Release(info);
+        }
+    }
+    return NULL;
+}
