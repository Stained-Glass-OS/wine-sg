+                    }
+                    VariantClear(&v);
+                }
+            }else {
+                IDispatch_AddRef(target);
+            }
+            if(SUCCEEDED(hres)) {
+                hres = IDispatch_QueryInterface(target, &IID_IBindEventHandler, (void**)&binder);
+                if(SUCCEEDED(hres)) {
+                    hres = IBindEventHandler_BindHandler(binder, pstrEventName, handler);
+                    IBindEventHandler_Release(binder);
+                }
+                IDispatch_Release(target);
+            }
+            IDispatch_Release(handler);
+        }
+    }
+
+    if(SUCCEEDED(hres)) {
+#ifdef SG_MUTANT_VBB1_SCRIPTLET
+        *pbstrName = SysAllocString(L"x");
+#else
+        *pbstrName = SysAllocString(name);
+#endif
+        if(!*pbstrName)
+            hres = E_OUTOFMEMORY;
+    }
+    free(name);
+    return hres;
 }
 
