+                DISPID id;
+                BSTR sub_name = SysAllocString(pstrSubItemName);
+
+                target = NULL;
+                hres = disp_get_id(item->disp, sub_name, VBDISP_CALLGET, FALSE, &id);
+                SysFreeString(sub_name);
+                if(SUCCEEDED(hres)) {
+                    V_VT(&v) = VT_EMPTY;
+                    hres = disp_call(This->ctx, item->disp, id, &dp, &v);
+                }
+                if(SUCCEEDED(hres)) {
+                    if(V_VT(&v) == VT_DISPATCH && V_DISPATCH(&v)) {
+                        target = V_DISPATCH(&v);
+                        IDispatch_AddRef(target);
+                    }else {
