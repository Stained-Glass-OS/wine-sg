+    L"function", L"get", L"goto", L"if", L"imp", L"in", L"is", L"let", L"loop", L"me", L"mod", L"new", L"next",
+    L"not", L"nothing", L"null", L"on", L"option", L"or", L"preserve", L"private", L"property", L"public",
+    L"randomize", L"redim", L"rem", L"resume", L"select", L"set", L"step", L"stop", L"sub", L"then", L"to",
+    L"true", L"until", L"wend", L"while", L"with", L"xor"
