+#ifndef SG_MUTANT_VBB1_SLETDELIM
+    if(pstrDelimiter && *pstrDelimiter) {
+        const WCHAR *end = wcsstr(pstrCode, pstrDelimiter);
+        if(end)
+            code_len = end - pstrCode;
+    }
+#endif
+
+    /* the code is the body of a procedure of that name without parameters */
+    len = wcslen(L"Sub ") + wcslen(name) + wcslen(L"()\r\n") + code_len + wcslen(L"\r\nEnd Sub") + 1;
+    if(!(src = malloc(len * sizeof(WCHAR)))) {
+        free(name);
+        return E_OUTOFMEMORY;
+    }
+    swprintf(src, len, L"Sub %s()\r\n%.*s\r\nEnd Sub", name, (int)code_len, pstrCode);
+
+    hres = compile_script(This->ctx, src, pstrItemName, NULL, dwSourceContextCookie,
+                          ulStartingLineNumber ? ulStartingLineNumber - 1 : 0,
+                          dwFlags & SCRIPTTEXT_ISPERSISTENT, &code);
+    free(src);
+    if(FAILED(hres)) {
