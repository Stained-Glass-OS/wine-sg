+/* Takes the interrupt requested by InterruptScriptThread: the error to raise in the running script
+ * is recorded in ctx->ei. Without SCRIPTINTERRUPT_RAISEEXCEPTION the script is aborted: On Error
+ * Resume Next does not resume it. */
+HRESULT take_interrupt(script_ctx_t *ctx)
+{
+    EnterCriticalSection(&ctx->interrupt_cs);
