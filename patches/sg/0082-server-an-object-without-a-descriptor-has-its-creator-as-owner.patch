+/* A pipe, event, mutex, semaphore, timer or section created with no
+ * security descriptor still has an owner and a group on Windows -- its
+ * creator's (the effective token's owner and primary group) -- and programs
+ * read them: the Cygwin/MSYS runtime takes a pty's owner from its pipes'
+ * security, and crashed on the NULL owner Wine reported. Only owner and
+ * group are recorded: no DACL is added, and an object without a DACL is open
+ * to everyone exactly as one without a descriptor was, so access checks are
+ * unchanged. Called by those object types' creators only: others (registry
+ * keys, window stations, desktops, directories, links) have their own
+ * defaults, which a descriptor here would override. */
+void set_creator_owner_group( struct object *obj )
+{
+    struct security_descriptor *sd;
+    const struct sid *owner, *group;
+    struct token *token;
+    char *ptr;
+
+    if (obj->sd || !current) return;
+    token = current->token ? current->token : current->process->token;
+    if (!token || !(owner = token_get_owner( token )) || !(group = token_get_primary_group( token ))) return;
+    if (!(ptr = mem_alloc( sizeof(*sd) + sid_len( owner ) + sid_len( group ) ))) return;
+    sd = (struct security_descriptor *)ptr;
+    memset( sd, 0, sizeof(*sd) );
+    sd->owner_len = sid_len( owner );
+    sd->group_len = sid_len( group );
+    ptr = mem_append( ptr + sizeof(*sd), owner, sd->owner_len );
+    mem_append( ptr, group, sd->group_len );
+    obj->sd = sd;
+}
+
 static struct object *create_object( struct object *parent, const struct object_ops *ops,
                                      const struct unicode_str *name, unsigned int attributes,
                                      const struct security_descriptor *sd )
