From: Stained Glass OS <dev@stained-glass.example>
Subject: server: an object created without a descriptor has its creator as owner

On Windows a pipe, event, mutex, semaphore or section created with no
security descriptor is still owned by its creator: owner and group come from
the creating token. Wine kept no descriptor at all, and NtQuerySecurityObject
returned an empty one -- no owner, no group. The Cygwin/MSYS runtime takes a
pty's owner from its pipes' security (cygpsid::get_id) and dereferenced the
NULL owner: every program run in Git for Windows' terminal (bash, tty, sh)
died of a segmentation fault.

Objects created through create_object/create_named_object without a
descriptor now record the effective token's owner and primary group. Only
those: no DACL is added, and an object without a DACL grants everyone full
access exactly as one without a descriptor did, so no access check changes
(this matters on the shared multi-user server).

Gate: test/objowner-gate.sh -- each kind of object is owned by its creator
with no DACL, and a process without Administrators still opens them fully.
---
--- a/server/object.c
+++ b/server/object.c
@@ -400,6 +400,33 @@
     return i * sizeof(WCHAR);
 }
 
+/* An object created with no security descriptor still has an owner and a
+ * group on Windows -- its creator's (the effective token's owner and primary
+ * group) -- and programs read them: the Cygwin/MSYS runtime takes a pty's
+ * owner from its pipes' security, and crashed on the NULL owner Wine
+ * reported. Only owner and group are recorded: no DACL is added, and an
+ * object without a DACL is open to everyone exactly as one without a
+ * descriptor was, so access checks are unchanged. */
+static void set_creator_owner_group( struct object *obj )
+{
+    struct security_descriptor *sd;
+    const struct sid *owner, *group;
+    struct token *token;
+    char *ptr;
+
+    if (obj->sd || !current) return;
+    token = current->token ? current->token : current->process->token;
+    if (!token || !(owner = token_get_owner( token )) || !(group = token_get_primary_group( token ))) return;
+    if (!(ptr = mem_alloc( sizeof(*sd) + sid_len( owner ) + sid_len( group ) ))) return;
+    sd = (struct security_descriptor *)ptr;
+    memset( sd, 0, sizeof(*sd) );
+    sd->owner_len = sid_len( owner );
+    sd->group_len = sid_len( group );
+    ptr = mem_append( ptr + sizeof(*sd), owner, sd->owner_len );
+    mem_append( ptr, group, sd->group_len );
+    obj->sd = sd;
+}
+
 static struct object *create_object( struct object *parent, const struct object_ops *ops,
                                      const struct unicode_str *name, unsigned int attributes,
                                      const struct security_descriptor *sd )
@@ -412,6 +439,7 @@
     if (sd && !default_set_sd( obj, sd, OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
                                DACL_SECURITY_INFORMATION | SACL_SECURITY_INFORMATION ))
         goto failed;
+    if (!sd) set_creator_owner_group( obj );
     if (!obj->ops->link_name( obj, name_ptr, parent )) goto failed;
 
     name_ptr->obj = obj;
@@ -443,6 +471,7 @@
             free_object( new_obj );
             return NULL;
         }
+        if (!sd) set_creator_owner_group( new_obj );
     }
     else
     {
