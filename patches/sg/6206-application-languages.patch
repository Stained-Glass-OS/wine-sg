+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * The languages an application shows itself in: its PrimaryLanguageOverride first (the process's,
+ * set by the program), then the user's preferred UI languages.  A program without a package
+ * manifest declares the same ones (ManifestLanguages).
+ */
+
+#include "private.h"
+#include "winnls.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(locale);
+
+static CRITICAL_SECTION override_cs;
+static CRITICAL_SECTION_DEBUG override_cs_debug =
+{
+    0, 0, &override_cs,
+    { &override_cs_debug.ProcessLocksList, &override_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": override_cs") }
+};
+static CRITICAL_SECTION override_cs = { &override_cs_debug, -1, 0, 0, 0, 0 };
+static HSTRING primary_override;
+
+struct app_languages
+{
+    IActivationFactory IActivationFactory_iface;
+    IApplicationLanguagesStatics IApplicationLanguagesStatics_iface;
+    IApplicationLanguagesStatics2 IApplicationLanguagesStatics2_iface;
+};
+
+static inline struct app_languages *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct app_languages, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct app_languages *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IApplicationLanguagesStatics ))
+        *out = &impl->IApplicationLanguagesStatics_iface;
+    else if (IsEqualGUID( iid, &IID_IApplicationLanguagesStatics2 ))
+        *out = &impl->IApplicationLanguagesStatics2_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_Globalization_ApplicationLanguages;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;   /* a static class */
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+/* the override (if any), then the user's UI languages, each once */
+static HRESULT languages( BOOL with_override, IVectorView_HSTRING **out )
+{
+    WCHAR *names = NULL, *name;
+    HSTRING *values = NULL;
+    ULONG count = 0, size = 0;
+    SIZE_T n = 0, i;
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    if (!GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, NULL, &size ) || !size ||
+        !(names = malloc( size * sizeof(WCHAR) )) ||
+        !GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, names, &size ))
+    {
+        free( names );
+        names = NULL;
+        count = 0;
+    }
+    if (!(values = calloc( count + 2, sizeof(*values) )))
+    {
+        free( names );
+        return E_OUTOFMEMORY;
+    }
+
+    if (with_override)
+    {
+        EnterCriticalSection( &override_cs );
+        if (primary_override) hr = WindowsDuplicateString( primary_override, &values[n++] );
+        LeaveCriticalSection( &override_cs );
+    }
+    for (name = names; SUCCEEDED(hr) && name && *name; name += wcslen( name ) + 1)
+    {
+        BOOL seen = FALSE;
+        for (i = 0; i < n; i++)
+            if (!wcsicmp( WindowsGetStringRawBuffer( values[i], NULL ), name )) seen = TRUE;
+        if (!seen) hr = WindowsCreateString( name, wcslen( name ), &values[n++] );
+        if (n == count + 2) break;
+    }
+    if (SUCCEEDED(hr) && !n) hr = WindowsCreateString( L"en-US", 5, &values[n++] );
+    free( names );
+    if (SUCCEEDED(hr)) hr = hstring_vector_create( values, n, out );
+    if (FAILED(hr)) for (i = 0; i < n; i++) WindowsDeleteString( values[i] );
+    free( values );
+    return hr;
+}
+
+DEFINE_IINSPECTABLE( statics, IApplicationLanguagesStatics, struct app_languages, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_get_PrimaryLanguageOverride( IApplicationLanguagesStatics *iface, HSTRING *value )
+{
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &override_cs );
+    hr = WindowsDuplicateString( primary_override, value );
+    LeaveCriticalSection( &override_cs );
+    return hr;
+}
+
+static HRESULT WINAPI statics_put_PrimaryLanguageOverride( IApplicationLanguagesStatics *iface, HSTRING value )
+{
+    const WCHAR *tag = WindowsGetStringRawBuffer( value, NULL );
+    HSTRING copy = NULL;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    /* an empty one clears it; others are language tags */
+    if (tag[0] && !IsValidLocaleName( tag )) return E_INVALIDARG;
+    if (tag[0] && FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    EnterCriticalSection( &override_cs );
+    WindowsDeleteString( primary_override );
+    primary_override = copy;
+    LeaveCriticalSection( &override_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_get_Languages( IApplicationLanguagesStatics *iface, IVectorView_HSTRING **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+#ifdef SG_MUTANT_NO_APP_LANGUAGES
+    return E_NOTIMPL;
+#endif
+    return languages( TRUE, value );
+}
+
+static HRESULT WINAPI statics_get_ManifestLanguages( IApplicationLanguagesStatics *iface, IVectorView_HSTRING **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return languages( FALSE, value );
+}
+
+static const struct IApplicationLanguagesStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_get_PrimaryLanguageOverride, statics_put_PrimaryLanguageOverride,
+    statics_get_Languages, statics_get_ManifestLanguages,
+};
+
+DEFINE_IINSPECTABLE( statics2, IApplicationLanguagesStatics2, struct app_languages, IActivationFactory_iface )
+
+static HRESULT WINAPI statics2_GetLanguagesForUser( IApplicationLanguagesStatics2 *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                    IVectorView_HSTRING **value )
+{
+    TRACE( "iface %p, user %p, value %p.\n", iface, user, value );
+    /* the user here is the one running the program */
+    return languages( TRUE, value );
+}
+
+static const struct IApplicationLanguagesStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface, statics2_AddRef, statics2_Release,
+    statics2_GetIids, statics2_GetRuntimeClassName, statics2_GetTrustLevel,
+    statics2_GetLanguagesForUser,
+};
+
+static struct app_languages app_languages = { {&factory_vtbl}, {&statics_vtbl}, {&statics2_vtbl} };
+IActivationFactory *app_languages_factory = &app_languages.IActivationFactory_iface;
diff --git a/dlls/windows.globalization/main.c b/dlls/windows.globalization/main.c
index fb6233f..9c70525 100644
--- a/dlls/windows.globalization/main.c
+++ b/dlls/windows.globalization/main.c
@@ -1263,6 +1263,11 @@ HRESULT WINAPI DllGetActivationFactory(HSTRING classid, IActivationFactory **fac
         *factory = geographic_region_factory;
         IUnknown_AddRef(*factory);
     }
+    else if (!wcscmp(name, RuntimeClass_Windows_Globalization_ApplicationLanguages))
+    {
+        *factory = app_languages_factory;
+        IUnknown_AddRef(*factory);
+    }
 #ifndef SG_MUTANT_NO_NUMBER_FORMATTING
     else if ((*factory = number_formatting_factory(name)))
         IUnknown_AddRef(*factory);
diff --git a/dlls/windows.globalization/private.h b/dlls/windows.globalization/private.h
index 78aeb09..e24dc88 100644
--- a/dlls/windows.globalization/private.h
+++ b/dlls/windows.globalization/private.h
@@ -38,6 +38,7 @@
 #include "windows.system.userprofile.h"
 
 extern IActivationFactory *geographic_region_factory;
+extern IActivationFactory *app_languages_factory;
 HRESULT hstring_vector_create( HSTRING *values, SIZE_T count, IVectorView_HSTRING **out );
 IActivationFactory *number_formatting_factory( const WCHAR *name );
 
