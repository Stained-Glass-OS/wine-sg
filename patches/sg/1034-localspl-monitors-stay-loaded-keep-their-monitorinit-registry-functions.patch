+            pm->root = hroot;
+            hroot = 0;
+            memset(&pm->init, 0, sizeof(pm->init));
+            pm->init.cbSize = sizeof(pm->init);
+            pm->init.hckRegistryRoot = pm->root;
+            pm->init.pMonitorReg = &monreg;
+            pm->init.bLocal = TRUE;
+
+            monitor2 = pInitializePrintMonitor2(&pm->init, &hmon);
+#ifdef SG_MUTANT_MONINIT
+            memset(&pm->init, 0, sizeof(pm->init));
+#endif
             TRACE("%p: MONITOR2 from %s,InitializePrintMonitor2(%s)\n",
                     monitor2, debugstr_w(driver), debugstr_w(regroot));
             if (monitor2)
@@ -992,6 +1010,14 @@
             SetLastError(ERROR_PROC_NOT_FOUND);
             pm = NULL;
         }
+        /* as Windows' spooler does, a monitor stays loaded once it is: makers'
