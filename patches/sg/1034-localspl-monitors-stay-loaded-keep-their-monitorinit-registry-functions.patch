+#ifdef SG_MUTANT_MONREG
     return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
+    return RegOpenKeyExW(hcKey, pszSubKey, 0, samDesired, (HKEY *)phkResult);
 }
 
 static LONG WINAPI CloseKey(HANDLE hcKey, HANDLE hSpooler)
 {
-    FIXME("stub\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    return RegCloseKey(hcKey);
 }
 
 static LONG WINAPI DeleteKey(HANDLE hcKey, LPCWSTR pszSubKey, HANDLE hSpooler)
 {
-    FIXME("stub\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    return RegDeleteKeyW(hcKey, pszSubKey);
 }
 
 static LONG WINAPI EnumKey(HANDLE hcKey, DWORD dwIndex, LPWSTR pszName,
                 PDWORD pcchName, PFILETIME pftLastWriteTime, HANDLE hSpooler)
 {
-    FIXME("stub\n");
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    return RegEnumKeyExW(hcKey, dwIndex, pszName, pcchName, NULL, NULL, NULL, pftLastWriteTime);
 }
 
