 static MONITORREG monreg =
@@ -923,17 +934,24 @@
         }
 
         if (pInitializePrintMonitor2 && hroot) {
-            MONITORINIT init;
             MONITOR2 *monitor2;
             HANDLE hmon;
 
-            memset(&init, 0, sizeof(init));
-            init.cbSize = sizeof(init);
-            init.hckRegistryRoot = hroot;
-            init.pMonitorReg = &monreg;
-            init.bLocal = TRUE;
-
