+/*
+ *
+ * Windows.Globalization.Language for the recognizer's languages
+ *
+ */
+
+static HRESULT create_language( const WCHAR *tag, ILanguage **out )
+{
+    static const WCHAR *class_name = L"Windows.Globalization.Language";
+    ILanguageFactory *factory;
+    HSTRING str, tag_str;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = WindowsCreateString(class_name, wcslen(class_name), &str))) return hr;
+    hr = RoGetActivationFactory(str, &IID_ILanguageFactory, (void **)&factory);
+    WindowsDeleteString(str);
+    if (FAILED(hr)) return hr;
+
+    if (SUCCEEDED(hr = WindowsCreateString(tag, wcslen(tag), &tag_str)))
+    {
+        hr = ILanguageFactory_CreateLanguage(factory, tag_str, out);
+        WindowsDeleteString(tag_str);
+    }
+    ILanguageFactory_Release(factory);
+    return hr;
+}
+
+/* The speech language of the system follows the user's locale: there are no language packs to choose from. */
+static HRESULT create_system_language( ILanguage **out )
+{
+    WCHAR tag[LOCALE_NAME_MAX_LENGTH];
+
+    if (!GetUserDefaultLocaleName(tag, ARRAY_SIZE(tag))) return HRESULT_FROM_WIN32(GetLastError());
+    return create_language(tag, out);
+}
+
+static HRESULT create_empty_language_view( IVectorView_Language **out )
+{
+    struct vector_iids iids =
+    {
+        .iterable = &IID_IIterable_Language,
+        .iterator = &IID_IIterator_Language,
+        .vector = &IID_IVector_Language,
+        .view = &IID_IVectorView_Language,
+        .element = L"Windows.Globalization.Language",
+    };
+    IVector_IInspectable *vector;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = vector_inspectable_create(&iids, &vector))) return hr;
+    hr = IVector_IInspectable_GetView(vector, (IVectorView_IInspectable **)out);
+    IVector_IInspectable_Release(vector);
+    return hr;
+}
