+
+    if (!ref) free(impl);
+    return ref;
+}
+
+#define TIMEOUT_PROPERTY( name, field )                                                                     \
+    static HRESULT WINAPI timeouts_get_##name( ISpeechRecognizerTimeouts *iface, TimeSpan *value )          \
+    {                                                                                                       \
+        TRACE("iface %p, value %p.\n", iface, value);                                                       \
+        *value = timeouts_impl_from(iface)->field;                                                          \
+        return S_OK;                                                                                        \
+    }                                                                                                       \
+    static HRESULT WINAPI timeouts_put_##name( ISpeechRecognizerTimeouts *iface, TimeSpan value )           \
+    {                                                                                                       \
+        TRACE("iface %p, value %#I64x.\n", iface, value.Duration);                                          \
+        if (value.Duration < 0) return E_INVALIDARG;                                                        \
+        timeouts_impl_from(iface)->field = value;                                                           \
+        return S_OK;                                                                                        \
+    }
+TIMEOUT_PROPERTY(InitialSilenceTimeout, initial_silence)
+TIMEOUT_PROPERTY(EndSilenceTimeout, end_silence)
+TIMEOUT_PROPERTY(BabbleTimeout, babble)
+
