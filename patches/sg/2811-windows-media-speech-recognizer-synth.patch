+static HRESULT timeouts_create( ISpeechRecognizerTimeouts **out )
+{
+    struct timeouts *impl;
+
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->ISpeechRecognizerTimeouts_iface.lpVtbl = &timeouts_vtbl;
+    impl->ref = 1;
+    #ifdef SG_MUTANT_WMS_TIMEOUTS
+    impl->initial_silence.Duration = 0;
+#else
+    impl->initial_silence.Duration = 5 * 10000000LL; /* 5 seconds */
+#endif
+    impl->end_silence.Duration = 1500000;            /* 150 ms */
+    impl->babble.Duration = 0;                       /* off */
+    *out = &impl->ISpeechRecognizerTimeouts_iface;
+    return S_OK;
+}
