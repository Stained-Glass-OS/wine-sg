From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: an ECMA-key assembly is trusted only inside a Wine Mono installation (5906)

CORE review: security. fast-a 3316 let an assembly whose public key field is
the 16-byte ECMA neutral key pass StrongNameSignatureVerification[Ex] with no
signature check at all: anybody could make one. On Windows such an assembly is
verified against the platform's own key, which an assembly made by anybody
else fails. Wine Mono's framework assemblies carry the ECMA key but no such
signature, so they are now trusted by where they are, not by what they claim:
inside a Wine Mono installation that only an administrator or the system can
write (the prefix's C:\windows\mono, Wine's data directories
INSTALL_DATADIR/wine/mono, /usr/share/wine/mono, /opt/wine/mono, and the data
directory of the Wine being run). HKCU's Mono RuntimePath is NOT trusted (a
user sets it). Paths are compared as full Unix names (".." resolved, a
look-alike directory such as C:\windows\monoevil does not match). Elsewhere an
ECMA-key assembly fails with CORSEC_E_INVALID_STRONGNAME.

Coordinator decision (integration review of 3316, integ-2026-10).
Gate: test/sn-ecma-gate.sh (Mono's System.dll in place and in C:\windows\mono
pass; copies in C:\forged, through C:\windows\mono\..\.., in
C:\windows\monoevil and C:\users\Public\mono fail; 64/32). Mutants
SG_MUTANT_SN_ECMA_ANY, SG_MUTANT_SN_ANYWHERE.
---
diff --git a/dlls/mscoree/metahost.c b/dlls/mscoree/metahost.c
--- a/dlls/mscoree/metahost.c
+++ b/dlls/mscoree/metahost.c
@@ -1111,6 +1111,82 @@ BOOL get_mono_path(LPWSTR path, BOOL skip_local)
         get_mono_path_unix("/opt/wine/mono", path);
 }
 
+/* Is the file inside a Wine Mono installation that only an administrator (or the system) can
+ * write: the prefix's %windir%\mono, or Wine's data directories. HKCU's RuntimePath is not one: a
+ * user chooses it. Strong-name verification trusts the ECMA-key framework assemblies there (5906). */
+static char *unix_name_of( const WCHAR *dos )
+{
+    static char * (CDECL *p_wine_get_unix_file_name)(const WCHAR *);
+
+    if (!p_wine_get_unix_file_name &&
+        !(p_wine_get_unix_file_name = (void *)GetProcAddress( GetModuleHandleA("kernel32"), "wine_get_unix_file_name" )))
+        return NULL;
+    return p_wine_get_unix_file_name( dos );
+}
+
+static BOOL unix_path_under( const char *file, const char *dir )
+{
+    size_t len = strlen( dir );
+
+    while (len && dir[len - 1] == '/') len--;
+    return len && !strncmp( file, dir, len ) && file[len] == '/';
+}
+
+BOOL is_trusted_mono_location( const WCHAR *path )
+{
+    static const char *unix_roots[] =
+    {
+        INSTALL_DATADIR "/wine/mono", "/usr/share/wine/mono", "/opt/wine/mono",
+    };
+    WCHAR windir[MAX_PATH + 8], *full;
+    const WCHAR *data_dir;
+    char *file, *dir;
+    BOOL ret = FALSE;
+    DWORD len;
+    unsigned int i;
+
+    if (!path || !(len = GetFullPathNameW( path, 0, NULL, NULL ))) return FALSE;
+    if (!(full = malloc( len * sizeof(WCHAR) ))) return FALSE;
+    GetFullPathNameW( path, len, full, NULL );
+    file = unix_name_of( full );
+    free( full );
+    if (!file) return FALSE;
+
+#ifndef SG_MUTANT_SN_ANYWHERE
+    for (i = 0; i < ARRAY_SIZE(unix_roots) && !ret; i++) ret = unix_path_under( file, unix_roots[i] );
+    if (!ret && GetWindowsDirectoryW( windir, MAX_PATH ))
+    {
+        lstrcatW( windir, L"\\mono" );
+        if ((dir = unix_name_of( windir )))
+        {
+            ret = unix_path_under( file, dir );
+            HeapFree( GetProcessHeap(), 0, dir );
+        }
+    }
+    /* the Wine being run from its data directory (WINEDATADIR, as get_mono_path_datadir) */
+    if (!ret && (data_dir = _wgetenv( L"WINEDATADIR" )) && !wcsncmp( data_dir, L"\\??\\", 4 ))
+    {
+        WCHAR *mono = malloc( (wcslen( data_dir ) + 8) * sizeof(WCHAR) );
+        if (mono)
+        {
+            lstrcpyW( mono, data_dir + 4 );
+            lstrcatW( mono, L"\\mono" );
+            if ((dir = unix_name_of( mono )))
+            {
+                ret = unix_path_under( file, dir );
+                HeapFree( GetProcessHeap(), 0, dir );
+            }
+            free( mono );
+        }
+    }
+#else
+    ret = TRUE;
+#endif
+    TRACE( "%s: %s\n", debugstr_a(file), ret ? "a Wine Mono installation" : "not trusted by location" );
+    HeapFree( GetProcessHeap(), 0, file );
+    return ret;
+}
+
 struct InstalledRuntimeEnum
 {
     IEnumUnknown IEnumUnknown_iface;
diff --git a/dlls/mscoree/mscoree_private.h b/dlls/mscoree/mscoree_private.h
--- a/dlls/mscoree/mscoree_private.h
+++ b/dlls/mscoree/mscoree_private.h
@@ -111,6 +111,7 @@ extern HRESULT get_runtime_info(LPCWSTR exefile, LPCWSTR version, LPCWSTR config
     ICLRRuntimeInfo **result);
 
 extern BOOL get_mono_path(LPWSTR path, BOOL skip_local);
+extern BOOL is_trusted_mono_location(const WCHAR *path);
 
 extern MonoDomain* get_root_domain(void);
 
diff --git a/dlls/mscoree/strongname.c b/dlls/mscoree/strongname.c
--- a/dlls/mscoree/strongname.c
+++ b/dlls/mscoree/strongname.c
@@ -618,7 +618,7 @@ static BOOL skip_registered( const struct sn_assembly *as )
 }
 
 /* verify the signature; FALSE with the error set when the image is not validly signed */
-static BOOLEAN verify_image( const struct sn_image *img, const struct sn_assembly *as )
+static BOOLEAN verify_image( const struct sn_image *img, const struct sn_assembly *as, const WCHAR *path )
 {
     const struct sn_public_key *pk = (const struct sn_public_key *)as->key;
     const RSAPUBKEY *rsa;
@@ -629,8 +629,18 @@ static BOOLEAN verify_image( const struct sn_image *img, const struct sn_assembl
     BOOLEAN ret = FALSE;
 
     if (!as->key || !as->key_len || !(as->flags & 1 /* afPublicKey */)) return fail( CORSEC_E_MISSING_STRONGNAME );
-    /* the ECMA key marks standard-library assemblies: there is no signature to check */
-    if (as->key_len == sizeof(ecma_key) && !memcmp( as->key, ecma_key, sizeof(ecma_key) )) return TRUE;
+    /* The ECMA key marks a framework assembly. Windows verifies such an assembly against the platform's
+     * own key, which an assembly made by anybody else does not pass; this runtime's framework assemblies
+     * (Wine Mono's) carry no such signature, so they are trusted by where they are: a Wine Mono
+     * installation, which only an administrator can write (5906, CORE review: security). The key field
+     * alone proves nothing. */
+    if (as->key_len == sizeof(ecma_key) && !memcmp( as->key, ecma_key, sizeof(ecma_key) ))
+    {
+#ifndef SG_MUTANT_SN_ECMA_ANY
+        if (!is_trusted_mono_location( path )) return fail( CORSEC_E_INVALID_STRONGNAME );
+#endif
+        return TRUE;
+    }
     if (!check_public_key( as->key, as->key_len, &rsa )) return fail( CORSEC_E_INVALID_PUBLICKEY );
     if (!(img->cor_flags & COMIMAGE_FLAGS_STRONGNAMESIGNED) || !img->sig_len) return fail( CORSEC_E_INVALID_STRONGNAME );
     if (img->sig_len != rsa->bitlen / 8) return fail( CORSEC_E_INVALID_STRONGNAME );
@@ -685,12 +695,12 @@ static BOOLEAN verify_file( const WCHAR *path, BOOLEAN force, BOOLEAN *performed
 #ifndef SG_MUTANT_SNV_SKIP
         ret = TRUE;
 #else
-        ret = verify_image( &img, &as );
+        ret = verify_image( &img, &as, path );
 #endif
     }
     else
     {
-        ret = verify_image( &img, &as );
+        ret = verify_image( &img, &as, path );
         *performed = ret;
     }
     free( as.key );
