  */
@@ -213,6 +567,40 @@ static DWORD get_local_info(HANDLE radio, BTH_LOCAL_RADIO_INFO *info)
     return ERROR_SUCCESS;
 }
 
+/*********************************************************************
+ *  BluetoothIsVersionAvailable
+ *
+ * Whether the first radio supports the Bluetooth core specification version
+ * (its LMP version is the number of the specification: 0 is 1.0b, 3 is 2.0,
+ * 4 is 2.1, 5 is 3.0, 6 is 4.0 and so on).
+ */
+BOOL WINAPI BluetoothIsVersionAvailable(UCHAR major, UCHAR minor)
+{
+    static const UCHAR versions[][2] =
+    {
+        {1,0}, {1,1}, {1,2}, {2,0}, {2,1}, {3,0}, {4,0}, {4,1}, {4,2}, {5,0}, {5,1}, {5,2}, {5,3}, {5,4},
+    };
+    BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof(params) };
+    HBLUETOOTH_RADIO_FIND find;
+    BTH_LOCAL_RADIO_INFO local;
+    HANDLE radio;
+    DWORD ret;
+    UINT i;
+
+    TRACE("(%u, %u)\n", major, minor);
+
+    if (!(find = BluetoothFindFirstRadio( &params, &radio ))) return FALSE;
+    ret = get_local_info( radio, &local );
+    CloseHandle( radio );
+    BluetoothFindRadioClose( find );
+    if (ret) return FALSE;
+
+    for (i = 0; i < ARRAY_SIZE(versions); i++)
+        if (versions[i][0] > major || (versions[i][0] == major && versions[i][1] >= minor)) break;
+    /* a version past the ones known needs a radio past them too */
+    return i < ARRAY_SIZE(versions) && local.radioInfo.lmpVersion >= i;
+}
+
