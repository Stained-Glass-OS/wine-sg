- */
-BOOL WINAPI BluetoothFindDeviceClose(HBLUETOOTH_DEVICE_FIND find)
-{
-    TRACE("(%p)\n", find);
-
-    /* BluetoothFindFirstDevice never returns a search handle */
-    SetLastError(ERROR_INVALID_HANDLE);
-    return FALSE;
-}
