+#define __WINE_WINE_WINEBTH_H
+
+/* Control codes of a radio's device, beside the IOCTL_BTH_* ones: the devices
+ * the host knows of, and changes to one of them or to the radio. */
+#ifdef CTL_CODE  /* the user includes winioctl.h before it needs the control codes */
+#define IOCTL_WINEBTH_RADIO_GET_DEVICES CTL_CODE(FILE_DEVICE_BLUETOOTH, 0x800, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEBTH_RADIO_DEVICE_OP   CTL_CODE(FILE_DEVICE_BLUETOOTH, 0x801, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#endif
+
+#define WINEBTH_MAX_UUIDS    32
+#define WINEBTH_MAX_NAME     248
+
+#define WINEBTH_DEVICE_PAIRED     0x00000001
+#define WINEBTH_DEVICE_CONNECTED  0x00000002
+#define WINEBTH_DEVICE_TRUSTED    0x00000004
+#define WINEBTH_DEVICE_HAS_RSSI   0x00000008
+
+/* A device the radio knows of (BlueZ's Device1). The address is in the order
+ * it is written in, most significant byte first. */
+struct winebth_device_info
+{
+    unsigned char address[6];
+    unsigned char reserved[2];
+    unsigned int  class_of_device;
+    unsigned int  flags;
+    int           rssi;
+    unsigned int  num_uuids;
+    GUID          uuids[WINEBTH_MAX_UUIDS];
+    char          name[WINEBTH_MAX_NAME];  /* UTF-8, the alias */
+};
+
+/* IOCTL_WINEBTH_RADIO_GET_DEVICES: no input; the output is a count and the
+ * devices. A buffer that is too small gets STATUS_BUFFER_OVERFLOW with the size
+ * the list needs as the number of bytes returned. */
+struct winebth_device_list
+{
+    unsigned int count;
+    struct winebth_device_info devices[1];
+};
+
+enum winebth_device_op_type
+{
+    WINEBTH_OP_REMOVE_DEVICE = 1,       /* forget the device (BlueZ RemoveDevice) */
+    WINEBTH_OP_SET_ALIAS,               /* arg: the new name, UTF-8 */
+    WINEBTH_OP_CONNECT_PROFILE,         /* arg: the profile's UUID as text */
+    WINEBTH_OP_DISCONNECT_PROFILE,      /* arg: the profile's UUID as text */
+    WINEBTH_OP_SET_DISCOVERABLE,        /* the radio itself: value 0 or 1 */
+};
+
+/* IOCTL_WINEBTH_RADIO_DEVICE_OP: input only. */
+struct winebth_device_op
+{
+    unsigned int  op;
+    unsigned char address[6];
+    unsigned char reserved[2];
+    unsigned int  value;
+    char          arg[64];
+};
+
+#endif /* __WINE_WINE_WINEBTH_H */
