diff --git a/dlls/winebth.sys/dbus.c b/dlls/winebth.sys/dbus.c
index 38636db..e6eeffd 100644
--- a/dlls/winebth.sys/dbus.c
+++ b/dlls/winebth.sys/dbus.c
@@ -967,12 +967,275 @@ NTSTATUS bluez_dbus_loop( void *c, void *watcher,
         }
     }
 }
+
+/* ---- remote devices: each request uses a connection of its own, so that it
+ * never meets the watcher's loop ---- */
+
+#define BLUEZ_INTERFACE_DEVICE "org.bluez.Device1"
+#define BLUEZ_TIMEOUT 10000
+
+static void parse_uuid_string( const char *str, GUID *guid )
+{
+    unsigned int d1, d2, d3, b[8];
+
+    memset( guid, 0, sizeof(*guid) );
+    if (sscanf( str, "%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x", &d1, &d2, &d3, &b[0], &b[1], &b[2], &b[3],
+                &b[4], &b[5], &b[6], &b[7] ) != 11)
+        return;
+    guid->Data1 = d1;
+    guid->Data2 = d2;
+    guid->Data3 = d3;
+    for (int i = 0; i < 8; i++) guid->Data4[i] = b[i];
+}
+
+static void bluez_device_prop( const char *name, DBusMessageIter *variant, struct winebth_device_info *info,
+                               const char *adapter_path, BOOL *belongs )
+{
+    int type = p_dbus_message_iter_get_arg_type( variant );
+
+    if (!strcmp( name, "Adapter" ) && type == DBUS_TYPE_OBJECT_PATH)
+    {
+        const char *path;
+        p_dbus_message_iter_get_basic( variant, &path );
+        *belongs = !strcmp( path, adapter_path );
+    }
+    else if (!strcmp( name, "Address" ) && type == DBUS_TYPE_STRING)
+    {
+        const char *str;
+        BYTE addr[6];
+        p_dbus_message_iter_get_basic( variant, &str );
+        parse_mac_address( str, addr );
+        memcpy( info->address, addr, 6 );
+    }
+    else if ((!strcmp( name, "Alias" ) || (!strcmp( name, "Name" ) && !info->name[0])) && type == DBUS_TYPE_STRING)
+    {
+        const char *str;
+        p_dbus_message_iter_get_basic( variant, &str );
+        snprintf( info->name, sizeof(info->name), "%s", str );
+    }
+    else if (!strcmp( name, "Class" ) && type == DBUS_TYPE_UINT32)
+    {
+        dbus_uint32_t class;
+        p_dbus_message_iter_get_basic( variant, &class );
+        info->class_of_device = class;
+    }
+    else if (type == DBUS_TYPE_BOOLEAN)
+    {
+        dbus_bool_t value;
+        p_dbus_message_iter_get_basic( variant, &value );
+        if (!strcmp( name, "Paired" ) && value) info->flags |= WINEBTH_DEVICE_PAIRED;
+        else if (!strcmp( name, "Connected" ) && value) info->flags |= WINEBTH_DEVICE_CONNECTED;
+        else if (!strcmp( name, "Trusted" ) && value) info->flags |= WINEBTH_DEVICE_TRUSTED;
+    }
+    else if (!strcmp( name, "RSSI" ) && type == DBUS_TYPE_INT16)
+    {
+        dbus_int16_t rssi;
+        p_dbus_message_iter_get_basic( variant, &rssi );
+        info->rssi = rssi;
+        info->flags |= WINEBTH_DEVICE_HAS_RSSI;
+    }
+    else if (!strcmp( name, "UUIDs" ) && type == DBUS_TYPE_ARRAY)
+    {
+        DBusMessageIter array;
+        p_dbus_message_iter_recurse( variant, &array );
+        while (p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_STRING && info->num_uuids < WINEBTH_MAX_UUIDS)
+        {
+            const char *str;
+            p_dbus_message_iter_get_basic( &array, &str );
+            parse_uuid_string( str, &info->uuids[info->num_uuids++] );
+            p_dbus_message_iter_next( &array );
+        }
+    }
+}
+
+NTSTATUS bluez_adapter_get_devices( const char *adapter_path, struct winebth_device_info *devices, ULONG capacity,
+                                    ULONG *count )
+{
+    DBusConnection *connection;
+    DBusMessage *request, *reply;
+    DBusMessageIter iter, objects, object, interfaces, iface_entry;
+    DBusError error;
+    NTSTATUS status = STATUS_SUCCESS;
+    ULONG total = 0;
+
+    *count = 0;
+    if (!(connection = bluez_dbus_init())) return STATUS_NOT_SUPPORTED;
+    if (!(request = p_dbus_message_new_method_call( BLUEZ_DEST, "/", DBUS_INTERFACE_OBJECTMANAGER, "GetManagedObjects" )))
+    {
+        bluez_dbus_close( connection );
+        bluez_dbus_free( connection );
+        return STATUS_NO_MEMORY;
+    }
+    p_dbus_error_init( &error );
+    reply = p_dbus_connection_send_with_reply_and_block( connection, request, BLUEZ_TIMEOUT, &error );
+    p_dbus_message_unref( request );
+    if (!reply)
+    {
+        status = bluez_dbus_error_to_ntstatus( &error );
+        WARN( "GetManagedObjects failed: %s: %s\n", debugstr_a( error.name ), debugstr_a( error.message ) );
+        p_dbus_error_free( &error );
+        goto done;
+    }
+
+    if (!p_dbus_message_has_signature( reply, DBUS_OBJECTMANAGER_METHOD_GETMANAGEDOBJECTS_RETURN_SIGNATURE ))
+    {
+        status = STATUS_INTERNAL_ERROR;
+        goto done_reply;
+    }
+    p_dbus_message_iter_init( reply, &iter );
+    p_dbus_message_iter_recurse( &iter, &objects );
+    while (p_dbus_message_iter_get_arg_type( &objects ) == DBUS_TYPE_DICT_ENTRY)
+    {
+        const char *path;
+
+        p_dbus_message_iter_recurse( &objects, &object );
+        p_dbus_message_iter_get_basic( &object, &path );
+        p_dbus_message_iter_next( &object );
+        p_dbus_message_iter_recurse( &object, &interfaces );
+        while (p_dbus_message_iter_get_arg_type( &interfaces ) == DBUS_TYPE_DICT_ENTRY)
+        {
+            const char *iface_name;
+
+            p_dbus_message_iter_recurse( &interfaces, &iface_entry );
+            p_dbus_message_iter_get_basic( &iface_entry, &iface_name );
+            if (!strcmp( iface_name, BLUEZ_INTERFACE_DEVICE ) && !strncmp( path, adapter_path, strlen( adapter_path ) ))
+            {
+                struct winebth_device_info info;
+                DBusMessageIter props, variant;
+                BOOL belongs = FALSE;
+                const char *prop;
+
+                memset( &info, 0, sizeof(info) );
+                p_dbus_message_iter_next( &iface_entry );
+                p_dbus_message_iter_recurse( &iface_entry, &props );
+                while ((prop = bluez_next_dict_entry( &props, &variant )))
+                    bluez_device_prop( prop, &variant, &info, adapter_path, &belongs );
+                if (belongs)
+                {
+                    if (total < capacity) devices[total] = info;
+                    total++;
+                }
+            }
+            p_dbus_message_iter_next( &interfaces );
+        }
+        p_dbus_message_iter_next( &objects );
+    }
+    *count = total;
+
+done_reply:
+    p_dbus_message_unref( reply );
+done:
+    bluez_dbus_close( connection );
+    bluez_dbus_free( connection );
+    return status;
+}
+
+static void device_object_path( char *buf, size_t size, const char *adapter_path, const BYTE address[6] )
+{
+    snprintf( buf, size, "%s/dev_%02X_%02X_%02X_%02X_%02X_%02X", adapter_path, address[0], address[1], address[2],
+              address[3], address[4], address[5] );
+}
+
+NTSTATUS bluez_adapter_device_op( const char *adapter_path, ULONG op, const BYTE address[6], ULONG value,
+                                  const char *arg )
+{
+    static const char *device_iface = BLUEZ_INTERFACE_DEVICE, *adapter_iface = BLUEZ_INTERFACE_ADAPTER;
+    char device_path[128];
+    DBusConnection *connection;
+    DBusMessage *request, *reply;
+    DBusMessageIter iter, variant;
+    DBusError error;
+    NTSTATUS status;
+
+    device_object_path( device_path, sizeof(device_path), adapter_path, address );
+    switch (op)
+    {
+    case WINEBTH_OP_REMOVE_DEVICE:
+        request = p_dbus_message_new_method_call( BLUEZ_DEST, adapter_path, BLUEZ_INTERFACE_ADAPTER, "RemoveDevice" );
+        if (request)
+        {
+            const char *path = device_path;
+            p_dbus_message_append_args( request, DBUS_TYPE_OBJECT_PATH, &path, DBUS_TYPE_INVALID );
+        }
+        break;
+    case WINEBTH_OP_SET_ALIAS:
+        request = p_dbus_message_new_method_call( BLUEZ_DEST, device_path, DBUS_INTERFACE_PROPERTIES, "Set" );
+        if (request)
+        {
+            const char *name = "Alias";
+            p_dbus_message_iter_init_append( request, &iter );
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &device_iface );
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &name );
+            p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "s", &variant );
+            p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_STRING, &arg );
+            p_dbus_message_iter_close_container( &iter, &variant );
+        }
+        break;
+    case WINEBTH_OP_CONNECT_PROFILE:
+    case WINEBTH_OP_DISCONNECT_PROFILE:
+        request = p_dbus_message_new_method_call( BLUEZ_DEST, device_path, BLUEZ_INTERFACE_DEVICE,
+                                                  op == WINEBTH_OP_CONNECT_PROFILE ? "ConnectProfile" : "DisconnectProfile" );
+        if (request) p_dbus_message_append_args( request, DBUS_TYPE_STRING, &arg, DBUS_TYPE_INVALID );
+        break;
+    case WINEBTH_OP_SET_DISCOVERABLE:
+        request = p_dbus_message_new_method_call( BLUEZ_DEST, adapter_path, DBUS_INTERFACE_PROPERTIES, "Set" );
+        if (request)
+        {
+            const char *name = "Discoverable";
+            dbus_bool_t discoverable = !!value;
+            p_dbus_message_iter_init_append( request, &iter );
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &adapter_iface );
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_STRING, &name );
+            p_dbus_message_iter_open_container( &iter, DBUS_TYPE_VARIANT, "b", &variant );
+            p_dbus_message_iter_append_basic( &variant, DBUS_TYPE_BOOLEAN, &discoverable );
+            p_dbus_message_iter_close_container( &iter, &variant );
+        }
+        break;
+    default:
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (!request) return STATUS_NO_MEMORY;
+
+    if (!(connection = bluez_dbus_init()))
+    {
+        p_dbus_message_unref( request );
+        return STATUS_NOT_SUPPORTED;
+    }
+    p_dbus_error_init( &error );
+    reply = p_dbus_connection_send_with_reply_and_block( connection, request, BLUEZ_TIMEOUT, &error );
+    p_dbus_message_unref( request );
+    if (reply)
+    {
+        p_dbus_message_unref( reply );
+        status = STATUS_SUCCESS;
+    }
+    else
+    {
+        status = bluez_dbus_error_to_ntstatus( &error );
+        WARN( "BlueZ call (op %u) failed: %s: %s\n", op, debugstr_a( error.name ), debugstr_a( error.message ) );
+        p_dbus_error_free( &error );
+    }
+    bluez_dbus_close( connection );
+    bluez_dbus_free( connection );
+    return status;
+}
+
 #else
 
 void *bluez_dbus_init( void ) { return NULL; }
 void bluez_dbus_close( void *connection ) {}
 void bluez_dbus_free( void *connection ) {}
 NTSTATUS bluez_watcher_init( void *connection, void **ctx ) { return STATUS_NOT_SUPPORTED; }
