@@ -47,16 +51,124 @@ struct bluetooth_find_radio_handle
     DWORD idx;
 };
 
-static BOOL any_radio_present(void)
+/* ---- remote devices, from the radios' lists ---- */
+
+/* the order of BLUETOOTH_ADDRESS: the least significant byte first */
+static void address_from_bytes( BLUETOOTH_ADDRESS *address, const BYTE bytes[6] )
+{
+    int i;
+
+    address->ullLong = 0;
+    for (i = 0; i < 6; i++) address->rgBytes[i] = bytes[5 - i];
+}
+
+static void address_to_bytes( const BLUETOOTH_ADDRESS *address, BYTE bytes[6] )
+{
+    int i;
+
+    for (i = 0; i < 6; i++) bytes[5 - i] = address->rgBytes[i];
+}
+
+/* The devices of one radio; free() the list. */
+static DWORD radio_get_devices( HANDLE radio, struct winebth_device_list **list )
+{
+    DWORD size = offsetof( struct winebth_device_list, devices[16] ), returned;
+    struct winebth_device_list *buf;
+
+    *list = NULL;
+    for (;;)
+    {
+        if (!(buf = malloc( size ))) return ERROR_OUTOFMEMORY;
+        memset( buf, 0, size );
+        if (DeviceIoControl( radio, IOCTL_WINEBTH_RADIO_GET_DEVICES, NULL, 0, buf, size, &returned, NULL ))
+        {
+            *list = buf;
+            return ERROR_SUCCESS;
+        }
+        free( buf );
+        if (GetLastError() != ERROR_MORE_DATA || returned <= size) return GetLastError();
+        size = returned;
+    }
+}
+
+static void device_info_from_winebth( BLUETOOTH_DEVICE_INFO *info, const struct winebth_device_info *device )
+{
+    memset( info, 0, sizeof(*info) );
+    info->dwSize = sizeof(*info);
+    address_from_bytes( &info->Address, device->address );
+    info->ulClassofDevice = device->class_of_device;
+    info->fConnected = !!(device->flags & WINEBTH_DEVICE_CONNECTED);
+    info->fAuthenticated = !!(device->flags & WINEBTH_DEVICE_PAIRED);
+    info->fRemembered = !!(device->flags & (WINEBTH_DEVICE_PAIRED | WINEBTH_DEVICE_TRUSTED));
+    MultiByteToWideChar( CP_UTF8, 0, device->name, -1, info->szName, ARRAY_SIZE(info->szName) );
+    info->szName[ARRAY_SIZE(info->szName) - 1] = 0;
+}
+
+/* Calls func for every radio (the one given, else each radio there is) until it
+ * returns something but ERROR_NOT_FOUND. */
+typedef DWORD (*radio_func)( HANDLE radio, void *context );
+
+static DWORD for_each_radio( HANDLE radio, radio_func func, void *context )
 {
     BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof(params) };
     HBLUETOOTH_RADIO_FIND find;
-    HANDLE radio;
+    DWORD ret = ERROR_NOT_FOUND;
 
-    if (!(find = BluetoothFindFirstRadio( &params, &radio ))) return FALSE;
-    CloseHandle( radio );
+    if (radio) return func( radio, context );
+
+    if (!(find = BluetoothFindFirstRadio( &params, &radio ))) return ERROR_NOT_FOUND;
+    do
+    {
+        ret = func( radio, context );
+        CloseHandle( radio );
+    } while (ret == ERROR_NOT_FOUND && BluetoothFindNextRadio( find, &radio ));
     BluetoothFindRadioClose( find );
-    return TRUE;
+    return ret;
+}
+
+struct device_search
+{
+    BLUETOOTH_DEVICE_INFO *devices;
+    DWORD count, capacity, next;
+    const BLUETOOTH_DEVICE_SEARCH_PARAMS *params;
+};
+
+static DWORD add_matching_devices( HANDLE radio, void *context )
+{
+    struct device_search *search = context;
+    struct winebth_device_list *list;
+    DWORD ret, i;
+
+    if ((ret = radio_get_devices( radio, &list )))
+    {
+        /* a radio that cannot tell is a radio with no devices here */
+        WARN( "radio %p: %lu\n", radio, ret );
+        return ERROR_NOT_FOUND;
+    }
+    for (i = 0; i < list->count; i++)
+    {
+        const struct winebth_device_info *device = &list->devices[i];
+        BOOL authenticated = device->flags & WINEBTH_DEVICE_PAIRED;
+        BOOL remembered = device->flags & (WINEBTH_DEVICE_PAIRED | WINEBTH_DEVICE_TRUSTED);
+        BOOL connected = device->flags & WINEBTH_DEVICE_CONNECTED;
+
+        if (!((search->params->fReturnAuthenticated && authenticated) ||
+              (search->params->fReturnRemembered && remembered) ||
+              (search->params->fReturnUnknown && !remembered) ||
+              (search->params->fReturnConnected && connected)))
+            continue;
+        if (search->count == search->capacity)
+        {
+            DWORD capacity = search->capacity ? search->capacity * 2 : 8;
+            BLUETOOTH_DEVICE_INFO *tmp = realloc( search->devices, capacity * sizeof(*tmp) );
+            if (!tmp) break;
+            search->devices = tmp;
+            search->capacity = capacity;
+        }
+        device_info_from_winebth( &search->devices[search->count++], device );
+    }
+    free( list );
+    return ERROR_NOT_FOUND;  /* go on with the next radio */
 }
 
 /*********************************************************************
@@ -65,6 +177,8 @@ static BOOL any_radio_present(void)
 HBLUETOOTH_DEVICE_FIND WINAPI BluetoothFindFirstDevice(BLUETOOTH_DEVICE_SEARCH_PARAMS *params,
                                                        BLUETOOTH_DEVICE_INFO *info)
 {
+    struct device_search *search;
+
     TRACE("(%p %p)\n", params, info);
 
     if (!params || !info || params->dwSize != sizeof(*params) || info->dwSize != sizeof(*info))
@@ -73,11 +187,263 @@ HBLUETOOTH_DEVICE_FIND WINAPI BluetoothFindFirstDevice(BLUETOOTH_DEVICE_SEARCH_P
         return NULL;
     }
 
-    /* The radio driver does not list remote devices, so no search can find one:
-     * the same answer as a machine with a radio and no known device, or no radio at all. */
-    if (any_radio_present()) FIXME("remote device lists are not available from the radio driver\n");
-    SetLastError(ERROR_NO_MORE_ITEMS);
-    return NULL;
+    if (!(search = calloc( 1, sizeof(*search) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return NULL;
+    }
+    /* Only the devices the radios know are listed: an inquiry would change the
+     * radio's state, so fIssueInquiry finds what was found before. */
+    search->params = params;
+    for_each_radio( params->hRadio, add_matching_devices, search );
+    search->params = NULL;
+    if (!search->count)
+    {
+        free( search->devices );
+        free( search );
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return NULL;
+    }
+    *info = search->devices[search->next++];
+    SetLastError( ERROR_SUCCESS );
+    return search;
+}
+
+/*********************************************************************
+ *  BluetoothFindNextDevice
+ */
+BOOL WINAPI BluetoothFindNextDevice(HBLUETOOTH_DEVICE_FIND find, BLUETOOTH_DEVICE_INFO *info)
+{
+    struct device_search *search = find;
+
+    TRACE("(%p, %p)\n", find, info);
+
+    if (!find || !info || info->dwSize != sizeof(*info))
+    {
+        SetLastError(!find ? ERROR_INVALID_HANDLE : ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (search->next >= search->count)
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+    *info = search->devices[search->next++];
+    return TRUE;
+}
+
+/*********************************************************************
+ *  BluetoothFindDeviceClose
+ */
+BOOL WINAPI BluetoothFindDeviceClose(HBLUETOOTH_DEVICE_FIND find)
+{
+    struct device_search *search = find;
+
+    TRACE("(%p)\n", find);
+
+    if (!find)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    free( search->devices );
+    free( search );
+    SetLastError(ERROR_SUCCESS);
+    return TRUE;
+}
+
+struct device_lookup
+{
+    BYTE address[6];
+    struct winebth_device_info device;
+    HANDLE radio;      /* a duplicate of the radio's handle, kept open */
+    BOOL keep_radio;
+};
+
+static DWORD find_device_on_radio( HANDLE radio, void *context )
+{
+    struct device_lookup *lookup = context;
+    struct winebth_device_list *list;
+    DWORD i, ret;
+
+    if ((ret = radio_get_devices( radio, &list ))) return ERROR_NOT_FOUND;
+    ret = ERROR_NOT_FOUND;
+    for (i = 0; i < list->count; i++)
+    {
+        if (memcmp( list->devices[i].address, lookup->address, 6 )) continue;
+        lookup->device = list->devices[i];
+        if (lookup->keep_radio &&
+            !DuplicateHandle( GetCurrentProcess(), radio, GetCurrentProcess(), &lookup->radio, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+            lookup->radio = NULL;
+        ret = ERROR_SUCCESS;
+        break;
+    }
+    free( list );
+    return ret;
+}
+
+/* The device with the address, and the radio that has it (close it). */
+static DWORD lookup_device( HANDLE radio, const BLUETOOTH_ADDRESS *address, struct device_lookup *lookup )
+{
+    memset( lookup, 0, sizeof(*lookup) );
+    address_to_bytes( address, lookup->address );
+    lookup->keep_radio = TRUE;
+    return for_each_radio( radio, find_device_on_radio, lookup );
+}
+
+/*********************************************************************
+ *  BluetoothGetDeviceInfo
+ */
+DWORD WINAPI BluetoothGetDeviceInfo(HANDLE radio, BLUETOOTH_DEVICE_INFO *info)
+{
+    struct device_lookup lookup;
+    BLUETOOTH_ADDRESS address;
+    DWORD ret;
+
+    TRACE("(%p, %p)\n", radio, info);
+
+    if (!info || info->dwSize != sizeof(*info)) return ERROR_INVALID_PARAMETER;
+
+    address = info->Address;
+    memset( &lookup, 0, sizeof(lookup) );
+    address_to_bytes( &address, lookup.address );
+    if ((ret = for_each_radio( radio, find_device_on_radio, &lookup ))) return ret;
+    device_info_from_winebth( info, &lookup.device );
+    return ERROR_SUCCESS;
+}
+
+static DWORD device_op( HANDLE radio, const BLUETOOTH_ADDRESS *address, unsigned int op, unsigned int value, const char *arg )
+{
+    struct device_lookup lookup;
+    struct winebth_device_op request;
+    DWORD ret, returned;
+
+    if ((ret = lookup_device( radio, address, &lookup ))) return ret;
+    memset( &request, 0, sizeof(request) );
+    request.op = op;
+    memcpy( request.address, lookup.address, 6 );
+    request.value = value;
+    if (arg) lstrcpynA( request.arg, arg, sizeof(request.arg) );
+    if (!lookup.radio) return ERROR_NOT_FOUND;
+    ret = DeviceIoControl( lookup.radio, IOCTL_WINEBTH_RADIO_DEVICE_OP, &request, sizeof(request), NULL, 0, &returned, NULL )
+        ? ERROR_SUCCESS : GetLastError();
+    CloseHandle( lookup.radio );
+    return ret;
+}
+
+/*********************************************************************
+ *  BluetoothRemoveDevice
+ */
+DWORD WINAPI BluetoothRemoveDevice(BLUETOOTH_ADDRESS *address)
+{
+    TRACE("(%p)\n", address);
+
+    if (!address) return ERROR_INVALID_PARAMETER;
+    return device_op( NULL, address, WINEBTH_OP_REMOVE_DEVICE, 0, NULL );
+}
+
+/*********************************************************************
+ *  BluetoothUpdateDeviceRecord
+ */
+DWORD WINAPI BluetoothUpdateDeviceRecord(BLUETOOTH_DEVICE_INFO *info)
+{
+    char name[BLUETOOTH_MAX_NAME_SIZE * 3];
+
+    TRACE("(%p)\n", info);
+
+    if (!info || info->dwSize != sizeof(*info)) return ERROR_INVALID_PARAMETER;
+    WideCharToMultiByte( CP_UTF8, 0, info->szName, -1, name, sizeof(name), NULL, NULL );
+    name[sizeof(name) - 1] = 0;
+    return device_op( NULL, &info->Address, WINEBTH_OP_SET_ALIAS, 0, name );
+}
+
+static void uuid_to_string( const GUID *guid, char *buf, size_t size )
+{
+    snprintf( buf, size, "%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x", (unsigned int)guid->Data1, guid->Data2,
+              guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4],
+              guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+}
+
+/*********************************************************************
+ *  BluetoothEnumerateInstalledServices
+ *
+ * The services a device offers, as the host lists them.
+ */
+DWORD WINAPI BluetoothEnumerateInstalledServices(HANDLE radio, BLUETOOTH_DEVICE_INFO *info, DWORD *count, GUID *guids)
+{
+    struct device_lookup lookup;
+    DWORD ret;
+
+    TRACE("(%p, %p, %p, %p)\n", radio, info, count, guids);
+
+    if (!info || info->dwSize != sizeof(*info) || !count) return ERROR_INVALID_PARAMETER;
+    if ((ret = lookup_device( radio, &info->Address, &lookup ))) return ret;
+    if (lookup.radio) CloseHandle( lookup.radio );
+
+    if (guids && *count < lookup.device.num_uuids)
+    {
+        *count = lookup.device.num_uuids;
+        return ERROR_MORE_DATA;
+    }
+    if (guids) memcpy( guids, lookup.device.uuids, lookup.device.num_uuids * sizeof(GUID) );
+    *count = lookup.device.num_uuids;
+    return ERROR_SUCCESS;
+}
+
+/*********************************************************************
+ *  BluetoothSetServiceState
+ *
+ * Enabling a service connects the profile, disabling it disconnects it.
+ */
+DWORD WINAPI BluetoothSetServiceState(HANDLE radio, BLUETOOTH_DEVICE_INFO *info, GUID *service, DWORD flags)
+{
+    struct device_lookup lookup;
+    char uuid[40];
+    DWORD ret, i;
+
+    TRACE("(%p, %p, %s, %#lx)\n", radio, info, debugstr_guid( service ), flags);
+
+    if (!info || info->dwSize != sizeof(*info) || !service ||
+        (flags != BLUETOOTH_SERVICE_ENABLE && flags != BLUETOOTH_SERVICE_DISABLE))
+        return ERROR_INVALID_PARAMETER;
+    if ((ret = lookup_device( radio, &info->Address, &lookup ))) return ret;
+    if (lookup.radio) CloseHandle( lookup.radio );
+    for (i = 0; i < lookup.device.num_uuids; i++)
+        if (IsEqualGUID( &lookup.device.uuids[i], service )) break;
+    if (i == lookup.device.num_uuids) return ERROR_SERVICE_DOES_NOT_EXIST;
+
+    uuid_to_string( service, uuid, sizeof(uuid) );
+    return device_op( radio, &info->Address, flags == BLUETOOTH_SERVICE_ENABLE ? WINEBTH_OP_CONNECT_PROFILE :
+                      WINEBTH_OP_DISCONNECT_PROFILE, 0, uuid );
+}
+
+/*********************************************************************
+ *  BluetoothEnableDiscovery
+ */
+BOOL WINAPI BluetoothEnableDiscovery(HANDLE radio, BOOL enable)
+{
+    struct winebth_device_op request;
+    DWORD returned;
+    BOOL ret = FALSE;
+    HANDLE first = NULL;
+
+    TRACE("(%p, %d)\n", radio, enable);
+
+    if (!radio)
+    {
+        BLUETOOTH_FIND_RADIO_PARAMS params = { sizeof(params) };
+        HBLUETOOTH_RADIO_FIND find;
+
+        if (!(find = BluetoothFindFirstRadio( &params, &first ))) return FALSE;
+        BluetoothFindRadioClose( find );
+        radio = first;
+    }
+    memset( &request, 0, sizeof(request) );
+    request.op = WINEBTH_OP_SET_DISCOVERABLE;
+    request.value = !!enable;
+    ret = DeviceIoControl( radio, IOCTL_WINEBTH_RADIO_DEVICE_OP, &request, sizeof(request), NULL, 0, &returned, NULL );
+    if (first) CloseHandle( first );
+    return ret;
 }
 
 /*********************************************************************
@@ -148,18 +514,6 @@ BOOL WINAPI BluetoothFindRadioClose( HBLUETOOTH_RADIO_FIND find_handle )
     return TRUE;
 }
 
-/*********************************************************************
