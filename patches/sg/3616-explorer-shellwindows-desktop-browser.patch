+/* Windows that were registered but whose program has gone away (killed, crashed) are dropped; sw->cs held. */
+static void shellwindows_remove_window(struct shellwindows *sw, unsigned int i)
+{
+    free(sw->windows[i].pidl);
+    if (sw->windows[i].disp) IDispatch_Release(sw->windows[i].disp);
+    --sw->count;
+    memmove(&sw->windows[i], &sw->windows[i + 1], (sw->count - i) * sizeof(*sw->windows));
+}
+
+static void shellwindows_purge(struct shellwindows *sw)
+{
+    unsigned int i;
+
+#ifdef SG_MUTANT_SW_NOPURGE
+    return;
+#endif
+    for (i = 0; i < sw->count; ++i)
+    {
+        if (sw->windows[i].hwnd && !IsWindow(LongToHandle(sw->windows[i].hwnd)))
+        {
+            shellwindows_remove_window(sw, i);
+            --i;
+        }
+    }
+}
+
+/* The windows ShellWindows lists are the ones that gave an IDispatch (the objects Item returns). */
+static BOOL shellwindows_listed(const struct window *window)
+{
+#ifdef SG_MUTANT_SW_LISTALL
+    return TRUE;
+#endif
+#ifdef SG_MUTANT_SW_PENDING
+    return window->disp && window->class != SWC_DESKTOP;
+#endif
+    return window->disp && !window->pending && window->class != SWC_DESKTOP;
+}
+
+struct shellwindows_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    IDispatch **items;
+    unsigned int count, pos;
+};
+
+static inline struct shellwindows_enum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct shellwindows_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI swenum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **out)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IEnumVARIANT))
+    {
+        IEnumVARIANT_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI swenum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI swenum_Release(IEnumVARIANT *iface)
+{
+    struct shellwindows_enum *This = impl_from_IEnumVARIANT(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    unsigned int i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; ++i) IDispatch_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI swenum_Next(IEnumVARIANT *iface, ULONG count, VARIANT *out, ULONG *fetched)
+{
+    struct shellwindows_enum *This = impl_from_IEnumVARIANT(iface);
+    ULONG n = 0;
+
+    if (!out && count) return E_POINTER;
+    while (n < count && This->pos < This->count)
+    {
+        V_VT(&out[n]) = VT_DISPATCH;
+        V_DISPATCH(&out[n]) = This->items[This->pos++];
+        IDispatch_AddRef(V_DISPATCH(&out[n]));
+        ++n;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI swenum_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct shellwindows_enum *This = impl_from_IEnumVARIANT(iface);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI swenum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl swenum_vtbl;
+
+static HRESULT WINAPI swenum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct shellwindows_enum *This = impl_from_IEnumVARIANT(iface), *copy;
+    unsigned int i;
+
+    if (!out) return E_POINTER;
+    if (!(copy = calloc(1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    if (This->count && !(copy->items = malloc(This->count * sizeof(*copy->items))))
+    {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    copy->IEnumVARIANT_iface.lpVtbl = &swenum_vtbl;
+    copy->ref = 1;
+    copy->count = This->count;
+    copy->pos = This->pos;
+    for (i = 0; i < This->count; ++i) IDispatch_AddRef(copy->items[i] = This->items[i]);
+    *out = &copy->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static const IEnumVARIANTVtbl swenum_vtbl =
+{
+    swenum_QueryInterface,
+    swenum_AddRef,
+    swenum_Release,
+    swenum_Next,
+    swenum_Skip,
+    swenum_Reset,
+    swenum_Clone,
+};
+
 static HRESULT WINAPI shellwindows_get_Count(IShellWindows *iface, LONG *count)
 {
-    FIXME("%p\n", count);
