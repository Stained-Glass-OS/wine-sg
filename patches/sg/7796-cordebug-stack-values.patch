From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscoree: ICorDebug stacks and values over Wine Mono's debugger agent

NET-DBG phase 2, second part. A stopped thread now gives its stack and its
values through ICorDebug, from Wine Mono's agent (7792):
- EnumerateChains/GetActiveChain: one managed chain; EnumerateFrames and
  GetActiveFrame: IL frames (THREAD GET_FRAME_INFO), caller and callee,
  GetIP (the IL offset), GetFunction/GetFunctionToken (METHOD GET_INFO:
  the MethodDef token).
- GetLocalVariable/EnumerateLocalVariables (the method's locals as the
  agent knows them, an index past them refused before the agent sees it),
  GetArgument/EnumerateArguments ("this" first for an instance method).
- Values: primitives as ICorDebugGenericValue (GetValue's bytes), null and
  object references as ICorDebugReferenceValue, a string dereferenced as
  ICorDebugStringValue. Structs, fields, arrays, evaluation, breakpoints and
  stepping are not there yet.
include/cordebug.idl gets the interfaces this hands out, as the .NET
runtime's cordebug.idl declares them (dotnet/runtime, MIT license):
ICorDebugILFrame, ICorDebugGenericValue, ICorDebugReferenceValue,
ICorDebugHeapValue, ICorDebugStringValue, ICorDebugValueEnum.
---
diff --git a/dlls/mscoree/cordebug.c b/dlls/mscoree/cordebug.c
index 58a2c5c..ac3af7c 100644
--- a/dlls/mscoree/cordebug.c
+++ b/dlls/mscoree/cordebug.c
@@ -767,22 +767,1223 @@ static HRESULT WINAPI cordebugthread_CreateStepper(ICorDebugThread *iface, ICorD
     return E_NOTIMPL;
 }
 
-static HRESULT WINAPI cordebugthread_EnumerateChains(ICorDebugThread *iface, ICorDebugChainEnum **ppChains)
+
+/***************************************************************************
+ * Stained Glass OS: the stack and the values of a stopped thread, from Wine Mono's agent (wine-sg 7796)
+ *
+ * One managed chain per thread; its frames are IL frames (THREAD GET_FRAME_INFO); a frame's function is the
+ * agent's method (METHOD GET_INFO gives the metadata token); its locals are the method's locals as the agent
+ * knows them (METHOD GET_LOCALS_INFO, in its order), its arguments "this" first for an instance method, then
+ * the parameters (STACK_FRAME GET_THIS, GET_VALUES). A value is a primitive (ICorDebugGenericValue), a null or
+ * object reference (ICorDebugReferenceValue) or a string, reached by Dereference (ICorDebugStringValue).
+ * Values of structs, objects' fields, arrays: not yet.
+ */
+#define SDB_SET_OBJECT_REF   9
+#define SDB_SET_STRING_REF   10
+#define SDB_SET_STACK_FRAME  16
+#define SDB_SET_METHOD       22
+#define SDB_THREAD_GET_FRAME_INFO   1
+#define SDB_FRAME_GET_VALUES        1
+#define SDB_FRAME_GET_THIS          2
+#define SDB_METHOD_GET_PARAM_INFO   4
+#define SDB_METHOD_GET_LOCALS_INFO  5
+#define SDB_METHOD_GET_INFO         6
+#define SDB_STRING_GET_VALUE        1
+#define SDB_VALUE_NULL              0xf0
+
+static void put_be32(BYTE *p, UINT32 v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+
+enum value_kind { VALUE_PRIMITIVE, VALUE_REFERENCE, VALUE_STRING };
+
+typedef struct DebugValue
+{
+    ICorDebugGenericValue ICorDebugGenericValue_iface;
+    ICorDebugReferenceValue ICorDebugReferenceValue_iface;
+    ICorDebugStringValue ICorDebugStringValue_iface;
+    LONG ref;
+    DebugProcess *process;
+    enum value_kind kind;
+    CorElementType type;
+    BYTE raw[8];          /* a primitive, little-endian, as GetValue gives it */
+    ULONG32 size;
+    UINT32 objid;         /* a reference's object, 0: null */
+    WCHAR *string;        /* a string's characters */
+    ULONG32 length;
+} DebugValue;
+
+static HRESULT value_create(DebugProcess *process, enum value_kind kind, CorElementType type, const BYTE *raw,
+                            ULONG32 size, UINT32 objid, ICorDebugValue **ret);
+
+/* one value of the agent's encoding at *P: an ICorDebugValue, or E_NOTIMPL for what is not handled yet;
+ * *P moves past it either way when it can */
+static HRESULT parse_value(DebugProcess *process, const BYTE **p, const BYTE *end, ICorDebugValue **ret, BOOL skip)
+{
+    BYTE type, raw[8] = { 0 };
+    UINT32 v32, n, i;
+    UINT64 v64;
+    HRESULT hr;
+
+    if (ret) *ret = NULL;
+    if (*p >= end) return E_FAIL;
+    type = *(*p)++;
+    switch (type)
+    {
+    case ELEMENT_TYPE_VOID:
+        return E_NOTIMPL;
+    case ELEMENT_TYPE_BOOLEAN: case ELEMENT_TYPE_I1: case ELEMENT_TYPE_U1:
+    case ELEMENT_TYPE_CHAR: case ELEMENT_TYPE_I2: case ELEMENT_TYPE_U2:
+    case ELEMENT_TYPE_I4: case ELEMENT_TYPE_U4: case ELEMENT_TYPE_R4:
+        if (end - *p < 4) return E_FAIL;
+        v32 = sdb_get32(*p);
+        *p += 4;
+        memcpy(raw, &v32, 4);
+        if (skip) return S_OK;
+        n = (type == ELEMENT_TYPE_BOOLEAN || type == ELEMENT_TYPE_I1 || type == ELEMENT_TYPE_U1) ? 1 :
+            (type == ELEMENT_TYPE_CHAR || type == ELEMENT_TYPE_I2 || type == ELEMENT_TYPE_U2) ? 2 : 4;
+        return value_create(process, VALUE_PRIMITIVE, type, raw, n, 0, ret);
+    case ELEMENT_TYPE_I8: case ELEMENT_TYPE_U8: case ELEMENT_TYPE_R8:
+        if (end - *p < 8) return E_FAIL;
+        v64 = sdb_get64(*p);
+        *p += 8;
+        memcpy(raw, &v64, 8);
+        if (skip) return S_OK;
+        return value_create(process, VALUE_PRIMITIVE, type, raw, 8, 0, ret);
+    case ELEMENT_TYPE_PTR: case ELEMENT_TYPE_FNPTR:
+        if (end - *p < 12) return E_FAIL;
+        *p += 12;   /* the address and its type */
+        return skip ? S_OK : E_NOTIMPL;
+    case ELEMENT_TYPE_STRING: case ELEMENT_TYPE_CLASS: case ELEMENT_TYPE_OBJECT:
+    case ELEMENT_TYPE_SZARRAY: case ELEMENT_TYPE_ARRAY: case ELEMENT_TYPE_GENERICINST:
+        if (end - *p < 4) return E_FAIL;
+        v32 = sdb_get32(*p);
+        *p += 4;
+        if (skip) return S_OK;
+        return value_create(process, VALUE_REFERENCE, type == ELEMENT_TYPE_GENERICINST ? ELEMENT_TYPE_CLASS : type,
+                            NULL, sizeof(void *), v32, ret);
+    case SDB_VALUE_NULL:
+        if (skip) return S_OK;
+        return value_create(process, VALUE_REFERENCE, ELEMENT_TYPE_CLASS, NULL, sizeof(void *), 0, ret);
+    case ELEMENT_TYPE_VALUETYPE:
+        /* is enum, class, field count, the fields */
+        if (end - *p < 9) return E_FAIL;
+        n = sdb_get32(*p + 5);
+        *p += 9;
+        for (i = 0; i < n; i++)
+            if (FAILED(hr = parse_value(process, p, end, NULL, TRUE)) && hr != E_NOTIMPL) return hr;
+        return skip ? S_OK : E_NOTIMPL;
+    default:
+        WARN("value of type %#x not understood\n", type);
+        return E_FAIL;
+    }
+}
+
+static inline DebugValue *impl_from_ICorDebugGenericValue(ICorDebugGenericValue *iface)
+{
+    return CONTAINING_RECORD(iface, DebugValue, ICorDebugGenericValue_iface);
+}
+static inline DebugValue *impl_from_ICorDebugReferenceValue(ICorDebugReferenceValue *iface)
+{
+    return CONTAINING_RECORD(iface, DebugValue, ICorDebugReferenceValue_iface);
+}
+static inline DebugValue *impl_from_ICorDebugStringValue(ICorDebugStringValue *iface)
+{
+    return CONTAINING_RECORD(iface, DebugValue, ICorDebugStringValue_iface);
+}
+
+static HRESULT value_qi(DebugValue *This, REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    switch (This->kind)
+    {
+    case VALUE_PRIMITIVE:
+        if (IsEqualGUID(riid, &IID_ICorDebugGenericValue) || IsEqualGUID(riid, &IID_ICorDebugValue) ||
+            IsEqualGUID(riid, &IID_IUnknown))
+            *ppv = &This->ICorDebugGenericValue_iface;
+        break;
+    case VALUE_REFERENCE:
+        if (IsEqualGUID(riid, &IID_ICorDebugReferenceValue) || IsEqualGUID(riid, &IID_ICorDebugValue) ||
+            IsEqualGUID(riid, &IID_IUnknown))
+            *ppv = &This->ICorDebugReferenceValue_iface;
+        break;
+    case VALUE_STRING:
+        if (IsEqualGUID(riid, &IID_ICorDebugStringValue) || IsEqualGUID(riid, &IID_ICorDebugHeapValue) ||
+            IsEqualGUID(riid, &IID_ICorDebugValue) || IsEqualGUID(riid, &IID_IUnknown))
+            *ppv = &This->ICorDebugStringValue_iface;
+        break;
+    }
+    if (!*ppv) return E_NOINTERFACE;
+    InterlockedIncrement(&This->ref);
+    return S_OK;
+}
+
+static ULONG value_release(DebugValue *This)
+{
+    ULONG ref = InterlockedDecrement(&This->ref);
+    if (!ref)
+    {
+        ICorDebugProcess_Release(&This->process->ICorDebugProcess_iface);
+        free(This->string);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT value_get_type(DebugValue *This, CorElementType *pType)
+{
+    if (!pType) return E_INVALIDARG;
+    *pType = This->type;
+    return S_OK;
+}
+
+static HRESULT value_get_size(DebugValue *This, ULONG32 *pSize)
+{
+    if (!pSize) return E_INVALIDARG;
+    *pSize = This->size;
+    return S_OK;
+}
+
+static HRESULT value_get_address(DebugValue *This, CORDB_ADDRESS *pAddress)
+{
+    if (!pAddress) return E_INVALIDARG;
+    *pAddress = 0;   /* the agent gives no addresses */
+    return S_OK;
+}
+
+/* ICorDebugGenericValue */
+static HRESULT WINAPI genericvalue_QueryInterface(ICorDebugGenericValue *iface, REFIID riid, void **ppv)
+{ return value_qi(impl_from_ICorDebugGenericValue(iface), riid, ppv); }
+static ULONG WINAPI genericvalue_AddRef(ICorDebugGenericValue *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugGenericValue(iface)->ref); }
+static ULONG WINAPI genericvalue_Release(ICorDebugGenericValue *iface)
+{ return value_release(impl_from_ICorDebugGenericValue(iface)); }
+static HRESULT WINAPI genericvalue_GetType(ICorDebugGenericValue *iface, CorElementType *pType)
+{ return value_get_type(impl_from_ICorDebugGenericValue(iface), pType); }
+static HRESULT WINAPI genericvalue_GetSize(ICorDebugGenericValue *iface, ULONG32 *pSize)
+{ return value_get_size(impl_from_ICorDebugGenericValue(iface), pSize); }
+static HRESULT WINAPI genericvalue_GetAddress(ICorDebugGenericValue *iface, CORDB_ADDRESS *pAddress)
+{ return value_get_address(impl_from_ICorDebugGenericValue(iface), pAddress); }
+static HRESULT WINAPI genericvalue_CreateBreakpoint(ICorDebugGenericValue *iface, ICorDebugValueBreakpoint **ppBreakpoint)
+{ return E_NOTIMPL; }
+
+static HRESULT WINAPI genericvalue_GetValue(ICorDebugGenericValue *iface, void *pTo)
+{
+    DebugValue *This = impl_from_ICorDebugGenericValue(iface);
+
+    if (!pTo) return E_INVALIDARG;
+#ifndef SG_MUTANT_CDB_VALUE_ZERO
+    memcpy(pTo, This->raw, This->size);
+#else
+    memset(pTo, 0, This->size);
+#endif
+    return S_OK;
+}
+
+static HRESULT WINAPI genericvalue_SetValue(ICorDebugGenericValue *iface, void *pFrom)
+{
+    FIXME("%p: setting values not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static const ICorDebugGenericValueVtbl genericvalue_vtbl =
+{
+    genericvalue_QueryInterface, genericvalue_AddRef, genericvalue_Release,
+    genericvalue_GetType, genericvalue_GetSize, genericvalue_GetAddress, genericvalue_CreateBreakpoint,
+    genericvalue_GetValue, genericvalue_SetValue,
+};
+
+/* ICorDebugReferenceValue */
+static HRESULT WINAPI refvalue_QueryInterface(ICorDebugReferenceValue *iface, REFIID riid, void **ppv)
+{ return value_qi(impl_from_ICorDebugReferenceValue(iface), riid, ppv); }
+static ULONG WINAPI refvalue_AddRef(ICorDebugReferenceValue *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugReferenceValue(iface)->ref); }
+static ULONG WINAPI refvalue_Release(ICorDebugReferenceValue *iface)
+{ return value_release(impl_from_ICorDebugReferenceValue(iface)); }
+static HRESULT WINAPI refvalue_GetType(ICorDebugReferenceValue *iface, CorElementType *pType)
+{ return value_get_type(impl_from_ICorDebugReferenceValue(iface), pType); }
+static HRESULT WINAPI refvalue_GetSize(ICorDebugReferenceValue *iface, ULONG32 *pSize)
+{ return value_get_size(impl_from_ICorDebugReferenceValue(iface), pSize); }
+static HRESULT WINAPI refvalue_GetAddress(ICorDebugReferenceValue *iface, CORDB_ADDRESS *pAddress)
+{ return value_get_address(impl_from_ICorDebugReferenceValue(iface), pAddress); }
+static HRESULT WINAPI refvalue_CreateBreakpoint(ICorDebugReferenceValue *iface, ICorDebugValueBreakpoint **ppBreakpoint)
+{ return E_NOTIMPL; }
+
+static HRESULT WINAPI refvalue_IsNull(ICorDebugReferenceValue *iface, BOOL *pbNull)
+{
+    DebugValue *This = impl_from_ICorDebugReferenceValue(iface);
+
+    if (!pbNull) return E_INVALIDARG;
+    *pbNull = !This->objid;
+    return S_OK;
+}
+
+static HRESULT WINAPI refvalue_GetValue(ICorDebugReferenceValue *iface, CORDB_ADDRESS *pValue)
+{
+    DebugValue *This = impl_from_ICorDebugReferenceValue(iface);
+
+    if (!pValue) return E_INVALIDARG;
+    *pValue = This->objid;   /* the agent's object id stands for the address */
+    return S_OK;
+}
+
+static HRESULT WINAPI refvalue_SetValue(ICorDebugReferenceValue *iface, CORDB_ADDRESS value)
+{
+    FIXME("%p: setting values not yet\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI refvalue_Dereference(ICorDebugReferenceValue *iface, ICorDebugValue **ppValue)
+{
+    DebugValue *This = impl_from_ICorDebugReferenceValue(iface);
+    struct sdb_conn *sdb;
+    BYTE id[4], *reply = NULL;
+    UINT32 len, n;
+    ICorDebugValue *value;
+    DebugValue *str;
+    HRESULT hr;
+    int wlen;
+
+    if (!ppValue) return E_INVALIDARG;
+    *ppValue = NULL;
+    if (!This->objid) return CORDBG_E_BAD_REFERENCE_VALUE;
+    if (This->type != ELEMENT_TYPE_STRING)
+    {
+        FIXME("%p: objects other than strings not yet\n", iface);
+        return E_NOTIMPL;
+    }
+    if (!(sdb = process_agent(This->process))) return CORDBG_E_PROCESS_TERMINATED;
+    put_be32(id, This->objid);
+    if (sdb_request(sdb, SDB_SET_STRING_REF, SDB_STRING_GET_VALUE, id, 4, &reply, &len) || len < 5)
+    {
+        free(reply);
+        return CORDBG_E_BAD_REFERENCE_VALUE;
+    }
+    if (FAILED(hr = value_create(This->process, VALUE_STRING, ELEMENT_TYPE_STRING, NULL, sizeof(void *), This->objid,
+                                 &value)))
+    {
+        free(reply);
+        return hr;
+    }
+    str = CONTAINING_RECORD(value, DebugValue, ICorDebugStringValue_iface);
+    n = sdb_get32(reply + 1);
+    if (n > len - 5) n = len - 5;
+    if (reply[0])   /* UTF-16 (it has a NUL) */
+    {
+        str->length = n / 2;
+        if ((str->string = malloc((str->length + 1) * sizeof(WCHAR))))
+        {
+            memcpy(str->string, reply + 5, str->length * sizeof(WCHAR));
+            str->string[str->length] = 0;
+        }
+    }
+    else
+    {
+        wlen = MultiByteToWideChar(CP_UTF8, 0, (char *)reply + 5, n, NULL, 0);
+        if ((str->string = malloc((wlen + 1) * sizeof(WCHAR))))
+        {
+            MultiByteToWideChar(CP_UTF8, 0, (char *)reply + 5, n, str->string, wlen);
+            str->string[wlen] = 0;
+            str->length = wlen;
+        }
+    }
+    free(reply);
+    *ppValue = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI refvalue_DereferenceStrong(ICorDebugReferenceValue *iface, ICorDebugValue **ppValue)
+{
+    return refvalue_Dereference(iface, ppValue);
+}
+
+static const ICorDebugReferenceValueVtbl refvalue_vtbl =
+{
+    refvalue_QueryInterface, refvalue_AddRef, refvalue_Release,
+    refvalue_GetType, refvalue_GetSize, refvalue_GetAddress, refvalue_CreateBreakpoint,
+    refvalue_IsNull, refvalue_GetValue, refvalue_SetValue, refvalue_Dereference, refvalue_DereferenceStrong,
+};
+
+/* ICorDebugStringValue */
+static HRESULT WINAPI stringvalue_QueryInterface(ICorDebugStringValue *iface, REFIID riid, void **ppv)
+{ return value_qi(impl_from_ICorDebugStringValue(iface), riid, ppv); }
+static ULONG WINAPI stringvalue_AddRef(ICorDebugStringValue *iface)
+{ return InterlockedIncrement(&impl_from_ICorDebugStringValue(iface)->ref); }
+static ULONG WINAPI stringvalue_Release(ICorDebugStringValue *iface)
+{ return value_release(impl_from_ICorDebugStringValue(iface)); }
+static HRESULT WINAPI stringvalue_GetType(ICorDebugStringValue *iface, CorElementType *pType)
+{ return value_get_type(impl_from_ICorDebugStringValue(iface), pType); }
+static HRESULT WINAPI stringvalue_GetSize(ICorDebugStringValue *iface, ULONG32 *pSize)
+{ return value_get_size(impl_from_ICorDebugStringValue(iface), pSize); }
+static HRESULT WINAPI stringvalue_GetAddress(ICorDebugStringValue *iface, CORDB_ADDRESS *pAddress)
+{ return value_get_address(impl_from_ICorDebugStringValue(iface), pAddress); }
+static HRESULT WINAPI stringvalue_CreateBreakpoint(ICorDebugStringValue *iface, ICorDebugValueBreakpoint **ppBreakpoint)
+{ return E_NOTIMPL; }
+
+static HRESULT WINAPI stringvalue_IsValid(ICorDebugStringValue *iface, BOOL *pbValid)
+{
+    if (!pbValid) return E_INVALIDARG;
+    *pbValid = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI stringvalue_CreateRelocBreakpoint(ICorDebugStringValue *iface, ICorDebugValueBreakpoint **ppBreakpoint)
+{ return E_NOTIMPL; }
+
+static HRESULT WINAPI stringvalue_GetLength(ICorDebugStringValue *iface, ULONG32 *pcchString)
+{
+    DebugValue *This = impl_from_ICorDebugStringValue(iface);
+
+    if (!pcchString) return E_INVALIDARG;
+    *pcchString = This->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI stringvalue_GetString(ICorDebugStringValue *iface, ULONG32 cchString, ULONG32 *pcchString,
+                                            WCHAR szString[])
+{
+    DebugValue *This = impl_from_ICorDebugStringValue(iface);
+    ULONG32 n = min(cchString, This->length);
+
+    if (!pcchString || (cchString && !szString)) return E_INVALIDARG;
+    if (n && This->string) memcpy(szString, This->string, n * sizeof(WCHAR));
+    *pcchString = n;
+    return S_OK;
+}
+
+static const ICorDebugStringValueVtbl stringvalue_vtbl =
+{
+    stringvalue_QueryInterface, stringvalue_AddRef, stringvalue_Release,
+    stringvalue_GetType, stringvalue_GetSize, stringvalue_GetAddress, stringvalue_CreateBreakpoint,
+    stringvalue_IsValid, stringvalue_CreateRelocBreakpoint, stringvalue_GetLength, stringvalue_GetString,
+};
+
+static HRESULT value_create(DebugProcess *process, enum value_kind kind, CorElementType type, const BYTE *raw,
+                            ULONG32 size, UINT32 objid, ICorDebugValue **ret)
+{
+    DebugValue *This = calloc(1, sizeof(*This));
+
+    if (!This) return E_OUTOFMEMORY;
+    This->ICorDebugGenericValue_iface.lpVtbl = &genericvalue_vtbl;
+    This->ICorDebugReferenceValue_iface.lpVtbl = &refvalue_vtbl;
+    This->ICorDebugStringValue_iface.lpVtbl = &stringvalue_vtbl;
+    This->ref = 1;
+    This->process = process;
+    ICorDebugProcess_AddRef(&process->ICorDebugProcess_iface);
+    This->kind = kind;
+    This->type = type;
+    This->size = size;
+    This->objid = objid;
+    if (raw) memcpy(This->raw, raw, min(size, sizeof(This->raw)));
+    switch (kind)
+    {
+    case VALUE_PRIMITIVE: *ret = (ICorDebugValue *)&This->ICorDebugGenericValue_iface; break;
+    case VALUE_REFERENCE: *ret = (ICorDebugValue *)&This->ICorDebugReferenceValue_iface; break;
+    case VALUE_STRING:    *ret = (ICorDebugValue *)&This->ICorDebugStringValue_iface; break;
+    }
+    return S_OK;
+}
+
+/* a generic enumerator of COM objects (frames, chains, values): the same layout as every ICorDebug*Enum */
+typedef struct ObjectEnum
+{
+    ICorDebugEnum ICorDebugEnum_iface;
+    LONG ref;
+    const IID *iid;
+    IUnknown **items;
+    ULONG count, pos;
+} ObjectEnum;
+
+static inline ObjectEnum *impl_from_ObjectEnum(ICorDebugEnum *iface)
+{
+    return CONTAINING_RECORD(iface, ObjectEnum, ICorDebugEnum_iface);
+}
+
+static HRESULT object_enum_create(const IID *iid, IUnknown **items, ULONG count, ULONG pos, ICorDebugEnum **ret);
+
+static HRESULT WINAPI object_enum_QueryInterface(ICorDebugEnum *iface, REFIID riid, void **ppv)
+{
+    ObjectEnum *This = impl_from_ObjectEnum(iface);
+
+    if (IsEqualGUID(riid, This->iid) || IsEqualGUID(riid, &IID_ICorDebugEnum) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *ppv = iface;
+        InterlockedIncrement(&This->ref);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI object_enum_AddRef(ICorDebugEnum *iface)
+{
+    return InterlockedIncrement(&impl_from_ObjectEnum(iface)->ref);
+}
+
+static ULONG WINAPI object_enum_Release(ICorDebugEnum *iface)
+{
+    ObjectEnum *This = impl_from_ObjectEnum(iface);
+    ULONG ref = InterlockedDecrement(&This->ref), i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) if (This->items[i]) IUnknown_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI object_enum_Skip(ICorDebugEnum *iface, ULONG celt)
+{
+    ObjectEnum *This = impl_from_ObjectEnum(iface);
+
+    if (celt > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI object_enum_Reset(ICorDebugEnum *iface)
+{
+    impl_from_ObjectEnum(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI object_enum_Clone(ICorDebugEnum *iface, ICorDebugEnum **ppEnum)
+{
+    ObjectEnum *This = impl_from_ObjectEnum(iface);
+    IUnknown **copy;
+    ULONG i;
+    HRESULT hr;
+
+    if (!ppEnum) return E_INVALIDARG;
+    if (!(copy = calloc(This->count ? This->count : 1, sizeof(*copy)))) return E_OUTOFMEMORY;
+    for (i = 0; i < This->count; i++) if ((copy[i] = This->items[i])) IUnknown_AddRef(copy[i]);
+    if (FAILED(hr = object_enum_create(This->iid, copy, This->count, This->pos, ppEnum)))
+    {
+        for (i = 0; i < This->count; i++) if (copy[i]) IUnknown_Release(copy[i]);
+        free(copy);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI object_enum_GetCount(ICorDebugEnum *iface, ULONG *pcelt)
+{
+    if (!pcelt) return E_INVALIDARG;
+    *pcelt = impl_from_ObjectEnum(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI object_enum_Next(ICorDebugEnum *iface, ULONG celt, IUnknown **items, ULONG *pceltFetched)
+{
+    ObjectEnum *This = impl_from_ObjectEnum(iface);
+    ULONG n = 0;
+
+    if (!items || (celt > 1 && !pceltFetched)) return E_INVALIDARG;
+    while (n < celt && This->pos < This->count)
+    {
+        items[n] = This->items[This->pos++];
+        if (items[n]) IUnknown_AddRef(items[n]);
+        n++;
+    }
+    if (pceltFetched) *pceltFetched = n;
+    return n == celt ? S_OK : S_FALSE;
+}
