+    if (!pReason) return E_INVALIDARG;
+    *pReason = CHAIN_NONE;
+    return S_OK;
+}
+
+static const ICorDebugChainVtbl chain_vtbl =
+{
+    chain_QueryInterface, chain_AddRef, chain_Release,
+    chain_GetThread, chain_GetStackRange, chain_GetContext, chain_GetCaller, chain_GetCallee,
+    chain_GetPrevious, chain_GetNext, chain_IsManaged, chain_EnumerateFrames, chain_GetActiveFrame,
+    chain_GetRegisterSet, chain_GetReason,
+};
+
+/* the thread's chain now (THREAD GET_FRAME_INFO), the process stopped */
+static HRESULT thread_chain(DebugThread *thread, DebugChain **ret)
+{
+    DebugProcess *process = thread->process;
+    struct sdb_conn *sdb;
+    BYTE payload[12], *reply = NULL;
+    UINT32 len, n, i;
+    DebugChain *chain;
+    DebugFrame *frame;
+
+    if (process->stop_count <= 0) return CORDBG_E_PROCESS_NOT_SYNCHRONIZED;
+    if (!(sdb = process_agent(process))) return CORDBG_E_PROCESS_TERMINATED;
+    put_be32(payload, thread->objid);
+    put_be32(payload + 4, 0);
+    put_be32(payload + 8, (UINT32)-1);
+    if (sdb_request(sdb, SDB_SET_THREAD, SDB_THREAD_GET_FRAME_INFO, payload, 12, &reply, &len) || len < 4)
+    {
+        free(reply);
+        return CORDBG_E_BAD_THREAD_STATE;
+    }
+    n = sdb_get32(reply);
+    if (n > (len - 4) / 13 || !(chain = calloc(1, sizeof(*chain))))
+    {
+        free(reply);
+        return E_OUTOFMEMORY;
+    }
+    chain->ICorDebugChain_iface.lpVtbl = &chain_vtbl;
+    chain->ref = 1;
+    chain->thread = thread;
+    ICorDebugThread_AddRef(&thread->ICorDebugThread_iface);
+    chain->frames = calloc(n ? n : 1, sizeof(*chain->frames));
+    for (i = 0; chain->frames && i < n; i++)
+    {
+        const BYTE *f = reply + 4 + 13 * i;
+        if (!(frame = calloc(1, sizeof(*frame)))) break;
+        frame->ICorDebugILFrame_iface.lpVtbl = &frame_vtbl;
+        frame->ref = 1;
+        frame->thread = thread;
+        ICorDebugThread_AddRef(&thread->ICorDebugThread_iface);
+        frame->chain = chain;
+        frame->frame_id = sdb_get32(f);
+        frame->method = sdb_get32(f + 4);
+        frame->il_offset = sdb_get32(f + 8);
+        frame->index = i;
+        chain->frames[chain->count++] = frame;
+    }
+    free(reply);
+    *ret = chain;
+    return S_OK;
+}
+
+static HRESULT WINAPI cordebugthread_EnumerateChains(ICorDebugThread *iface, ICorDebugChainEnum **ppChains)
+{
+    DebugThread *This = impl_from_ICorDebugThread(iface);
+    DebugChain *chain;
+    IUnknown **items;
+    HRESULT hr;
+
+    if (!ppChains) return E_INVALIDARG;
+    if (FAILED(hr = thread_chain(This, &chain))) return hr;
+    if (!(items = malloc(sizeof(*items))))
+    {
+        ICorDebugChain_Release(&chain->ICorDebugChain_iface);
+        return E_OUTOFMEMORY;
+    }
+    items[0] = (IUnknown *)&chain->ICorDebugChain_iface;
+    if (FAILED(hr = object_enum_create(&IID_ICorDebugChainEnum, items, 1, 0, (ICorDebugEnum **)ppChains)))
+    {
+        ICorDebugChain_Release(&chain->ICorDebugChain_iface);
+        free(items);
+    }
+    return hr;
+}
+
 static HRESULT WINAPI cordebugthread_GetActiveChain(ICorDebugThread *iface, ICorDebugChain **ppChain)
 {
-    FIXME("%p: stacks not yet\n", iface);
