+/* METHOD GET_INFO: flags and token */
+static HRESULT method_info(DebugProcess *process, UINT32 method, UINT32 *flags, mdMethodDef *token)
+{
+    struct sdb_conn *sdb = process_agent(process);
+    BYTE id[4], *reply = NULL;
+    UINT32 len;
+
+    if (!sdb) return CORDBG_E_PROCESS_TERMINATED;
+    put_be32(id, method);
+    if (sdb_request(sdb, SDB_SET_METHOD, SDB_METHOD_GET_INFO, id, 4, &reply, &len) || len < 12)
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    if (flags) *flags = sdb_get32(reply);
+    if (token) *token = sdb_get32(reply + 8);
+    free(reply);
+    return S_OK;
+}
