+/* the frame's values at the agent's positions (locals from 0, parameters -1 down) */
+static HRESULT frame_values(DebugFrame *This, const INT32 *positions, UINT32 count, ICorDebugValue **values)
+{
+    struct sdb_conn *sdb = process_agent(This->thread->process);
+    BYTE *payload, *reply = NULL;
+    const BYTE *p, *end;
+    UINT32 len, i;
+    HRESULT hr = S_OK;
+
+    if (!sdb) return CORDBG_E_PROCESS_TERMINATED;
+    if (!(payload = malloc(12 + 4 * count))) return E_OUTOFMEMORY;
+    put_be32(payload, This->thread->objid);
+    put_be32(payload + 4, This->frame_id);
+    put_be32(payload + 8, count);
+    for (i = 0; i < count; i++) put_be32(payload + 12 + 4 * i, positions[i]);
+    if (sdb_request(sdb, SDB_SET_STACK_FRAME, SDB_FRAME_GET_VALUES, payload, 12 + 4 * count, &reply, &len))
+        hr = CORDBG_E_IL_VAR_NOT_AVAILABLE;
+    free(payload);
+    p = reply;
+    end = reply + len;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++)
+    {
+        HRESULT vhr = parse_value(This->thread->process, &p, end, &values[i], FALSE);
+        if (vhr == E_FAIL) hr = vhr;   /* a value not handled yet stays NULL */
+    }
+    free(reply);
+    return hr;
+}
+
+static HRESULT frame_local_count(DebugFrame *This, UINT32 *count)
+{
+    struct sdb_conn *sdb = process_agent(This->thread->process);
+    BYTE id[4], *reply = NULL;
+    UINT32 len, blocks;
+
+    if (!sdb) return CORDBG_E_PROCESS_TERMINATED;
+    put_be32(id, This->method);
+    if (sdb_request(sdb, SDB_SET_METHOD, SDB_METHOD_GET_LOCALS_INFO, id, 4, &reply, &len) || len < 4)
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    blocks = sdb_get32(reply);   /* the scopes come first (protocol 2.43) */
+    if (blocks > (len - 8) / 8)
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    *count = sdb_get32(reply + 4 + 8 * blocks);
+    free(reply);
+    return S_OK;
+}
+
+/* the arguments: "this" (an instance method) and the parameters */
+static HRESULT frame_argument_count(DebugFrame *This, UINT32 *count, BOOL *has_this)
+{
+    struct sdb_conn *sdb = process_agent(This->thread->process);
+    BYTE id[4], *reply = NULL;
+    UINT32 len, flags;
+    HRESULT hr;
+
+    if (!sdb) return CORDBG_E_PROCESS_TERMINATED;
+    if (FAILED(hr = method_info(This->thread->process, This->method, &flags, NULL))) return hr;
+    *has_this = !(flags & 0x10 /* mdStatic */);
+    put_be32(id, This->method);
+    if (sdb_request(sdb, SDB_SET_METHOD, SDB_METHOD_GET_PARAM_INFO, id, 4, &reply, &len) || len < 8)
+    {
+        free(reply);
+        return E_FAIL;
+    }
+    *count = sdb_get32(reply + 4) + *has_this;
+    free(reply);
+    return S_OK;
+}
+
+static HRESULT frame_this(DebugFrame *This, ICorDebugValue **value)
+{
+    struct sdb_conn *sdb = process_agent(This->thread->process);
+    BYTE payload[8], *reply = NULL;
+    const BYTE *p;
+    UINT32 len;
+    HRESULT hr;
+
+    if (!sdb) return CORDBG_E_PROCESS_TERMINATED;
+    put_be32(payload, This->thread->objid);
+    put_be32(payload + 4, This->frame_id);
+    if (sdb_request(sdb, SDB_SET_STACK_FRAME, SDB_FRAME_GET_THIS, payload, 8, &reply, &len))
+    {
+        free(reply);
+        return CORDBG_E_IL_VAR_NOT_AVAILABLE;
+    }
+    p = reply;
+    hr = parse_value(This->thread->process, &p, reply + len, value, FALSE);
+    free(reply);
+    return hr;
+}
+
+static HRESULT WINAPI frame_GetLocalVariable(ICorDebugILFrame *iface, DWORD dwIndex, ICorDebugValue **ppValue)
+{
+    DebugFrame *This = impl_from_ICorDebugILFrame(iface);
+    INT32 pos = dwIndex;
+    UINT32 count;
+    HRESULT hr;
+
+    if (!ppValue) return E_INVALIDARG;
+    *ppValue = NULL;
+    if (FAILED(hr = frame_local_count(This, &count))) return hr;
+    if (dwIndex >= count) return E_INVALIDARG;   /* (the agent would assert) */
+    if (FAILED(hr = frame_values(This, &pos, 1, ppValue))) return hr;
+    return *ppValue ? S_OK : E_NOTIMPL;
+}
+
+static HRESULT WINAPI frame_GetArgument(ICorDebugILFrame *iface, DWORD dwIndex, ICorDebugValue **ppValue)
+{
+    DebugFrame *This = impl_from_ICorDebugILFrame(iface);
+    UINT32 count;
+    BOOL has_this;
+    INT32 pos;
+    HRESULT hr;
+
+    if (!ppValue) return E_INVALIDARG;
+    *ppValue = NULL;
+    if (FAILED(hr = frame_argument_count(This, &count, &has_this))) return hr;
+    if (dwIndex >= count) return E_INVALIDARG;
+    if (has_this && !dwIndex) hr = frame_this(This, ppValue);
+    else
+    {
+#ifndef SG_MUTANT_CDB_ARG_SHIFT
+        pos = -(INT32)(dwIndex - has_this) - 1;
+#else
+        pos = -(INT32)dwIndex - 1;
+        if (-pos > (INT32)(count - has_this)) return E_INVALIDARG;
+#endif
+        hr = frame_values(This, &pos, 1, ppValue);
+    }
+    if (FAILED(hr)) return hr;
+    return *ppValue ? S_OK : E_NOTIMPL;
+}
+
+static HRESULT frame_enum_values(DebugFrame *This, BOOL arguments, ICorDebugValueEnum **ppValueEnum)
+{
+    ICorDebugValue **values;
+    UINT32 count, i;
+    HRESULT hr;
+
+    if (!ppValueEnum) return E_INVALIDARG;
+    if (arguments)
+    {
+        BOOL has_this;
+        if (FAILED(hr = frame_argument_count(This, &count, &has_this))) return hr;
+    }
+    else if (FAILED(hr = frame_local_count(This, &count))) return hr;
+    if (!(values = calloc(count ? count : 1, sizeof(*values)))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        if (arguments) frame_GetArgument(&This->ICorDebugILFrame_iface, i, &values[i]);
+        else frame_GetLocalVariable(&This->ICorDebugILFrame_iface, i, &values[i]);
+    }
+    if (FAILED(hr = object_enum_create(&IID_ICorDebugValueEnum, (IUnknown **)values, count, 0,
+                                       (ICorDebugEnum **)ppValueEnum)))
+    {
+        for (i = 0; i < count; i++) if (values[i]) ICorDebugValue_Release(values[i]);
+        free(values);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI frame_EnumerateLocalVariables(ICorDebugILFrame *iface, ICorDebugValueEnum **ppValueEnum)
+{ return frame_enum_values(impl_from_ICorDebugILFrame(iface), FALSE, ppValueEnum); }
+static HRESULT WINAPI frame_EnumerateArguments(ICorDebugILFrame *iface, ICorDebugValueEnum **ppValueEnum)
+{ return frame_enum_values(impl_from_ICorDebugILFrame(iface), TRUE, ppValueEnum); }
