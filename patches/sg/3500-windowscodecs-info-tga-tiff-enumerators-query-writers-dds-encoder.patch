+static HRESULT ComponentInfo_GetColorManagementVersion(HKEY classkey, UINT size, WCHAR *buffer, UINT *actual)
+{
+    static const WCHAR default_version[] = L"1.0.0";
+    HRESULT hr = ComponentInfo_GetStringValue(classkey, L"ColorManagementVersion", size, buffer, actual);
+
+    if (SUCCEEDED(hr) && !*actual)
+    {
+        /* built-in codecs name the version of the colour management they follow */
+        *actual = ARRAY_SIZE(default_version);
+        if (!buffer && size) return E_INVALIDARG;
+        if (buffer)
+        {
+            if (size < ARRAY_SIZE(default_version)) return WINCODEC_ERR_INSUFFICIENTBUFFER;
+            memcpy(buffer, default_version, sizeof(default_version));
+        }
+    }
+    return hr;
+}
