+static HRESULT ComponentInfo_GetSigningStatus(DWORD *status)
+{
+    if (!status) return E_INVALIDARG;
+    /* The built-in components are part of the system and count as signed. */
+    *status = WICComponentSigned;
+    return S_OK;
+}
