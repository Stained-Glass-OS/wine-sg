+static HRESULT ComponentInfo_GetCapability(HKEY classkey, const WCHAR *value, size_t offset, BOOL *result)
+{
+    GUID container;
+    DWORD data, size = sizeof(data);
+    unsigned int i;
+
+    if (!result) return E_INVALIDARG;
+
+    if (!RegGetValueW(classkey, NULL, value, RRF_RT_DWORD, NULL, &data, &size))
+    {
+        *result = data != 0;
+        return S_OK;
+    }
+
+    *result = FALSE;
+    if (SUCCEEDED(ComponentInfo_GetGUIDValue(classkey, L"ContainerFormat", &container)))
+    {
+        for (i = 0; i < ARRAY_SIZE(container_caps); ++i)
+        {
+            if (IsEqualGUID(container_caps[i].container, &container))
+            {
+                *result = *(const BOOL *)((const char *)&container_caps[i] + offset);
+                break;
+            }
+        }
+    }
+    return S_OK;
+}
+
+#define COMPONENT_CAP(classkey, name, field, result) \
+    ComponentInfo_GetCapability(classkey, name, offsetof(typeof(container_caps[0]), field), result)
+
+static HRESULT ComponentInfo_MatchesMimeType(HKEY classkey, const WCHAR *mime, BOOL *matches)
+{
+    WCHAR *list, *p, *next;
+    DWORD size = 0;
+
+    if (!mime || !matches) return E_INVALIDARG;
+    *matches = FALSE;
+
+    if (RegGetValueW(classkey, NULL, L"MimeTypes", RRF_RT_REG_SZ, NULL, NULL, &size) || !size)
+        return S_OK;
+    if (!(list = malloc(size + sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if (RegGetValueW(classkey, NULL, L"MimeTypes", RRF_RT_REG_SZ, NULL, list, &size))
+    {
+        free(list);
+        return S_OK;
+    }
+    for (p = list; p; p = next)
+    {
+        if ((next = wcschr(p, ','))) *next++ = 0;
+        while (*p == ' ') ++p;
+        if (!wcsicmp(p, mime)) { *matches = TRUE; break; }
+    }
+    free(list);
+    return S_OK;
+}
