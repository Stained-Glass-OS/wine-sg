+static enum iterator_result match_metadata_content_iterator(IUnknown *item, struct iterator_context *context)
+{
+    IWICMetadataReaderInfo *info;
+    BOOL matches = FALSE;
+    GUID guid;
+
+    if (FAILED(IUnknown_QueryInterface(item, &IID_IWICMetadataReaderInfo, (void **)&info)))
+        return ITER_SKIP;
+
+    if (context->vendor && (FAILED(IWICMetadataReaderInfo_GetVendorGUID(info, &guid))
+            || !IsEqualGUID(context->vendor, &guid)))
+    {
+        IWICMetadataReaderInfo_Release(info);
+        return ITER_SKIP;
+    }
+
+    if (SUCCEEDED(IWICMetadataReaderInfo_MatchesPattern(info, context->format, context->stream, &matches)) && matches)
+    {
+        *context->result = info;
+        return ITER_DONE;
+    }
+
+    IWICMetadataReaderInfo_Release(info);
+    return ITER_SKIP;
+}
+
+/***********************************************************************
+ *      WICMatchMetadataContent (WINCODEC.@)
+ */
+HRESULT WINAPI WICMatchMetadataContent(REFGUID container, const GUID *vendor, IStream *stream, GUID *format)
+{
+    struct iterator_context context = { 0 };
+    IWICMetadataReaderInfo *info = NULL;
+    LARGE_INTEGER zero = {{0}};
+    HRESULT hr;
+
+    TRACE("%s,%s,%p,%p\n", debugstr_guid(container), debugstr_guid(vendor), stream, format);
+
+    if (!container || !stream || !format) return E_INVALIDARG;
+
+    context.format = container;
+    context.vendor = vendor;
+    context.stream = stream;
+    context.result = (void **)&info;
+
+    hr = foreach_component(WICMetadataReader, match_metadata_content_iterator, &context);
+    if (FAILED(hr) && vendor)
+    {
+        context.vendor = NULL;
+        hr = foreach_component(WICMetadataReader, match_metadata_content_iterator, &context);
+    }
+    if (FAILED(hr)) return hr;
+
+    hr = IWICMetadataReaderInfo_GetMetadataFormat(info, format);
+    IWICMetadataReaderInfo_Release(info);
+    IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    return hr;
+}
+
+/***********************************************************************
+ *      WICGetMetadataContentSize (WINCODEC.@)
