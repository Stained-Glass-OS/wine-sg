+struct enum_unknown
+{
+    IEnumUnknown IEnumUnknown_iface;
+    LONG ref;
+    IUnknown **items;
+    UINT count;
+    UINT pos;
+};
+
+static inline struct enum_unknown *impl_from_IEnumUnknown(IEnumUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct enum_unknown, IEnumUnknown_iface);
+}
+
+static HRESULT WINAPI enum_unknown_QueryInterface(IEnumUnknown *iface, REFIID iid, void **ppv)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+
+    TRACE("(%p,%s,%p)\n", iface, debugstr_guid(iid), ppv);
+
+    if (!ppv) return E_INVALIDARG;
+    if (IsEqualIID(&IID_IUnknown, iid) || IsEqualIID(&IID_IEnumUnknown, iid))
+        *ppv = &This->IEnumUnknown_iface;
+    else
+    {
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef((IUnknown *)*ppv);
+    return S_OK;
+}
+
+static ULONG WINAPI enum_unknown_AddRef(IEnumUnknown *iface)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI enum_unknown_Release(IEnumUnknown *iface)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < This->count; i++) IUnknown_Release(This->items[i]);
+        free(This->items);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI enum_unknown_Next(IEnumUnknown *iface, ULONG count, IUnknown **out, ULONG *fetched)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+    ULONG n = 0;
+
+    TRACE("(%p,%lu,%p,%p)\n", iface, count, out, fetched);
+
+    if (!out || (!fetched && count > 1)) return E_INVALIDARG;
+
+    while (n < count && This->pos < This->count)
+    {
+        out[n] = This->items[This->pos++];
+        IUnknown_AddRef(out[n]);
+        n++;
+    }
+    if (fetched) *fetched = n;
+    return n == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_unknown_Skip(IEnumUnknown *iface, ULONG count)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+
+    TRACE("(%p,%lu)\n", iface, count);
+
+    if (count > This->count - This->pos)
+    {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_unknown_Reset(IEnumUnknown *iface)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+
+    TRACE("(%p)\n", iface);
+
+    This->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_unknown_Clone(IEnumUnknown *iface, IEnumUnknown **out)
+{
+    struct enum_unknown *This = impl_from_IEnumUnknown(iface);
+    HRESULT hr;
+
+    TRACE("(%p,%p)\n", iface, out);
+
+    if (!out) return E_INVALIDARG;
+    if (SUCCEEDED(hr = create_enum_unknown(This->items, This->count, out)))
+        impl_from_IEnumUnknown(*out)->pos = This->pos;
+    return hr;
+}
+
+static const IEnumUnknownVtbl enum_unknown_vtbl =
+{
+    enum_unknown_QueryInterface,
+    enum_unknown_AddRef,
+    enum_unknown_Release,
+    enum_unknown_Next,
+    enum_unknown_Skip,
+    enum_unknown_Reset,
+    enum_unknown_Clone
+};
+
+HRESULT create_enum_unknown(IUnknown * const *items, UINT count, IEnumUnknown **out)
+{
+    struct enum_unknown *This;
+    UINT i;
+
+    if (!(This = calloc(1, sizeof(*This)))) return E_OUTOFMEMORY;
+    if (count && !(This->items = calloc(count, sizeof(*This->items))))
+    {
+        free(This);
+        return E_OUTOFMEMORY;
+    }
+    This->IEnumUnknown_iface.lpVtbl = &enum_unknown_vtbl;
+    This->ref = 1;
+    This->count = count;
+    for (i = 0; i < count; i++)
+    {
+        This->items[i] = items[i];
+        IUnknown_AddRef(items[i]);
+    }
+    *out = &This->IEnumUnknown_iface;
+    return S_OK;
+}
