+HRESULT WINAPI WICGetMetadataContentSize(REFGUID container, IWICMetadataWriter *writer, ULARGE_INTEGER *size)
+{
+    IWICPersistStream *persist;
+    HRESULT hr;
+
+    TRACE("%s,%p,%p\n", debugstr_guid(container), writer, size);
+
+    if (!container || !writer || !size) return E_INVALIDARG;
+
+    if (FAILED(hr = IWICMetadataWriter_QueryInterface(writer, &IID_IWICPersistStream, (void **)&persist)))
+        return hr;
+    hr = IWICPersistStream_GetSizeMax(persist, size);
+    IWICPersistStream_Release(persist);
+    return hr;
+}
+
+/***********************************************************************
+ *      WICSerializeMetadataContent (WINCODEC.@)
+ */
+HRESULT WINAPI WICSerializeMetadataContent(REFGUID container, IWICMetadataWriter *writer, DWORD options,
+        IStream *stream)
+{
+    IWICPersistStream *persist;
+    HRESULT hr;
+
+    TRACE("%s,%p,%#lx,%p\n", debugstr_guid(container), writer, options, stream);
+
+    if (!container || !writer || !stream) return E_INVALIDARG;
+
+    if (FAILED(hr = IWICMetadataWriter_QueryInterface(writer, &IID_IWICPersistStream, (void **)&persist)))
+        return hr;
+    hr = IWICPersistStream_SaveEx(persist, stream, options & WICPersistOptionMask, TRUE);
+    IWICPersistStream_Release(persist);
+    return hr;
+}
