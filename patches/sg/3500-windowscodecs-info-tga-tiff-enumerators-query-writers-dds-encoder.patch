+HRESULT enum_block_readers(IWICMetadataBlockReader *blocks, IEnumUnknown **out)
+{
+    IUnknown **readers = NULL;
+    UINT count, i, got = 0;
+    HRESULT hr;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+
+    if (FAILED(hr = IWICMetadataBlockReader_GetCount(blocks, &count))) return hr;
+    if (count && !(readers = calloc(count, sizeof(*readers)))) return E_OUTOFMEMORY;
+
+    for (i = 0; i < count; i++)
+    {
+        IWICMetadataReader *reader;
+        if (FAILED(hr = IWICMetadataBlockReader_GetReaderByIndex(blocks, i, &reader))) break;
+        readers[got++] = (IUnknown *)reader;
+    }
+    if (SUCCEEDED(hr)) hr = create_enum_unknown(readers, got, out);
+    for (i = 0; i < got; i++) IUnknown_Release(readers[i]);
+    free(readers);
+    return hr;
+}
