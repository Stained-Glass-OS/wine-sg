+/* ---- block compression for the encoder: BC1, BC2 and BC3 -------------------- */
+
+static BOOL dds_encodable_format(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+    case DXGI_FORMAT_BC1_TYPELESS: case DXGI_FORMAT_BC1_UNORM: case DXGI_FORMAT_BC1_UNORM_SRGB:
+    case DXGI_FORMAT_BC2_TYPELESS: case DXGI_FORMAT_BC2_UNORM: case DXGI_FORMAT_BC2_UNORM_SRGB:
+    case DXGI_FORMAT_BC3_TYPELESS: case DXGI_FORMAT_BC3_UNORM: case DXGI_FORMAT_BC3_UNORM_SRGB:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static void rgb565_to_rgb(WORD c, int *rgb)
+{
+    int r = GET_RGB565_R(c), g = GET_RGB565_G(c), b = GET_RGB565_B(c);
+
+    rgb[0] = (r << 3) | (r >> 2);
+    rgb[1] = (g << 2) | (g >> 4);
+    rgb[2] = (b << 3) | (b >> 2);
+}
+
+static WORD rgb_to_rgb565(int r, int g, int b)
+{
+    return MAKE_RGB565((r * 31 + 127) / 255, (g * 63 + 127) / 255, (b * 31 + 127) / 255);
+}
+
+/* the colour half of a block (8 bytes) for 16 BGRA pixels; with transparent_ok
+ * a pixel with alpha under 128 takes the transparent entry of a three colour block */
+static void dds_encode_color_block(const BYTE *pixels, BOOL transparent_ok, BYTE *out)
+{
+    int min[3] = {255, 255, 255}, max[3] = {0, 0, 0}, palette[4][3], i, j, inset;
+    BOOL any_transparent = FALSE;
+    WORD c0, c1, tmp;
+    DWORD indices = 0;
+    int opaque = 0;
+
+    for (i = 0; i < 16; i++)
+    {
+        const BYTE *p = pixels + i * 4;
+
+        if (transparent_ok && p[3] < 128)
+        {
+            any_transparent = TRUE;
+            continue;
+        }
+        opaque++;
+        for (j = 0; j < 3; j++)
+        {
+            int v = p[2 - j];   /* r, g, b */
+
+            if (v < min[j]) min[j] = v;
+            if (v > max[j]) max[j] = v;
+        }
+    }
+    if (!opaque)
+    {
+        /* all transparent */
+        c0 = 0x0001;
+        c1 = 0x0001;
+        memset(out, 0, 8);
+        *(WORD *)out = c0;
+        *(WORD *)(out + 2) = c1;
+        memset(out + 4, 0xff, 4);
+        return;
+    }
+
+    /* the bounding box of the colours, pulled in a little: its corners are rarely in the block */
+    for (j = 0; j < 3; j++)
+    {
+        inset = (max[j] - min[j]) / 16;
+        min[j] += inset;
+        max[j] -= inset;
+    }
+    c0 = rgb_to_rgb565(max[0], max[1], max[2]);
+    c1 = rgb_to_rgb565(min[0], min[1], min[2]);
+
+    if (any_transparent)
+    {
+        /* three colours and a transparent one: c0 <= c1; black would read as transparent */
+        if (c0 > c1) { tmp = c0; c0 = c1; c1 = tmp; }
+        if (!c0) c0 = 1;
+        if (!c1) c1 = 1;
+        if (c0 > c1) { tmp = c0; c0 = c1; c1 = tmp; }
+    }
+    else
+    {
+        if (c0 == c1)
+        {
+            if (c0 < 0xffff) c0++;
+            else c1--;
+        }
+        if (c0 < c1) { tmp = c0; c0 = c1; c1 = tmp; }
+    }
+
+    rgb565_to_rgb(c0, palette[0]);
+    rgb565_to_rgb(c1, palette[1]);
+    if (any_transparent)
+    {
+        for (j = 0; j < 3; j++) palette[2][j] = (palette[0][j] + palette[1][j] + 1) / 2;
+    }
+    else
+    {
+        WORD m2 = MAKE_RGB565((GET_RGB565_R(c0) * 2 + GET_RGB565_R(c1) + 1) / 3,
+                              (GET_RGB565_G(c0) * 2 + GET_RGB565_G(c1) + 1) / 3,
+                              (GET_RGB565_B(c0) * 2 + GET_RGB565_B(c1) + 1) / 3);
+        WORD m3 = MAKE_RGB565((GET_RGB565_R(c0) + GET_RGB565_R(c1) * 2 + 1) / 3,
+                              (GET_RGB565_G(c0) + GET_RGB565_G(c1) * 2 + 1) / 3,
+                              (GET_RGB565_B(c0) + GET_RGB565_B(c1) * 2 + 1) / 3);
+        rgb565_to_rgb(m2, palette[2]);
+        rgb565_to_rgb(m3, palette[3]);
+    }
+
+    for (i = 0; i < 16; i++)
+    {
+        const BYTE *p = pixels + i * 4;
+        int best = 0, best_dist = 1 << 30, count = any_transparent ? 3 : 4;
+        DWORD index;
+
+        if (any_transparent && p[3] < 128)
+        {
+            index = 3;
+        }
+        else
+        {
+            for (j = 0; j < count; j++)
+            {
+                int dr = p[2] - palette[j][0], dg = p[1] - palette[j][1], db = p[0] - palette[j][2];
+                int dist = dr * dr + dg * dg + db * db;
+
+                if (dist < best_dist) { best_dist = dist; best = j; }
+            }
+            index = best;
+        }
+        indices |= index << (i * 2);
+    }
+
+    *(WORD *)out = c0;
+    *(WORD *)(out + 2) = c1;
+    *(DWORD *)(out + 4) = indices;
+}
+
+/* the alpha half of a BC3 block (8 bytes): two end points and 3 bit indices */
+static void dds_encode_alpha_block(const BYTE *pixels, BYTE *out)
+{
+    int a0 = 0, a1 = 255, i, j, table[8];
+    UINT64 bits = 0;
+
+    for (i = 0; i < 16; i++)
+    {
+        int a = pixels[i * 4 + 3];
+
+        if (a > a0) a0 = a;
+        if (a < a1) a1 = a;
+    }
+    if (a0 == a1)
+    {
+        /* one value: eight steps need a0 > a1 */
+        if (a0 < 255) a0++;
+        else a1--;
+    }
+    table[0] = a0;
+    table[1] = a1;
+    for (j = 2; j < 8; j++) table[j] = (a0 * (8 - j) + a1 * (j - 1) + 3) / 7;
+    for (i = 0; i < 16; i++)
+    {
+        int a = pixels[i * 4 + 3], best = 0, best_dist = 1 << 30;
+
+        for (j = 0; j < 8; j++)
+        {
+            int dist = a > table[j] ? a - table[j] : table[j] - a;
+
+            if (dist < best_dist) { best_dist = dist; best = j; }
+        }
+        bits |= (UINT64)best << (i * 3);
+    }
+    out[0] = a0;
+    out[1] = a1;
+    for (i = 0; i < 6; i++) out[2 + i] = (bits >> (i * 8)) & 0xff;
+}
+
+static void dds_encode_blocks(const BYTE *bgra, UINT width, UINT height, DXGI_FORMAT format, BYTE *out)
+{
+    UINT bx, by, x, y, wb = (width + 3) / 4, hb = (height + 3) / 4;
+    BOOL bc1 = format == DXGI_FORMAT_BC1_TYPELESS || format == DXGI_FORMAT_BC1_UNORM
+               || format == DXGI_FORMAT_BC1_UNORM_SRGB;
+    BOOL bc2 = format == DXGI_FORMAT_BC2_TYPELESS || format == DXGI_FORMAT_BC2_UNORM
+               || format == DXGI_FORMAT_BC2_UNORM_SRGB;
+    UINT block_size = bc1 ? 8 : 16;
+
+    for (by = 0; by < hb; by++)
+    {
+        for (bx = 0; bx < wb; bx++)
+        {
+            BYTE block_pixels[64], *dst = out + (by * wb + bx) * block_size;
+
+            for (y = 0; y < 4; y++)
+            {
+                for (x = 0; x < 4; x++)
+                {
+                    /* a block that sticks out of the image repeats its last row and column */
+                    UINT sx = min(bx * 4 + x, width - 1), sy = min(by * 4 + y, height - 1);
+
+                    memcpy(block_pixels + (y * 4 + x) * 4, bgra + ((size_t)sy * width + sx) * 4, 4);
+                }
+            }
+            if (bc1)
+            {
+                dds_encode_color_block(block_pixels, TRUE, dst);
+            }
+            else if (bc2)
+            {
+                int i;
+
+                for (i = 0; i < 8; i++)
+                {
+                    BYTE a0 = (block_pixels[(i * 2) * 4 + 3] * 15 + 127) / 255;
+                    BYTE a1 = (block_pixels[(i * 2 + 1) * 4 + 3] * 15 + 127) / 255;
+
+                    dst[i] = a0 | (a1 << 4);
+                }
+                dds_encode_color_block(block_pixels, FALSE, dst + 8);
+            }
+            else
+            {
+                dds_encode_alpha_block(block_pixels, dst);
+                dds_encode_color_block(block_pixels, FALSE, dst + 8);
+            }
+        }
+    }
+}
+
+static HRESULT dds_frame_dimensions(const dds_info *info, UINT mip_level, UINT *width, UINT *height)
+{
+    *width = max(1, info->width >> mip_level);
+    *height = max(1, info->height >> mip_level);
+    return S_OK;
+}
