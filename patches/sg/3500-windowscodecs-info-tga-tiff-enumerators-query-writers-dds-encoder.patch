+/* the buffer the pixels are collected in, once the size is known */
+static HRESULT dds_frame_prepare(DdsFrameEncode *This)
+{
+    if (!This->initialized) return WINCODEC_ERR_NOTINITIALIZED;
+    if (This->committed) return WINCODEC_ERR_WRONGSTATE;
+    if (!This->width || !This->height) return WINCODEC_ERR_WRONGSTATE;
+    if (!This->pixels && !(This->pixels = calloc((size_t)This->width * This->height, 4))) return E_OUTOFMEMORY;
+    This->frame_created = TRUE;
+    return S_OK;
+}
+
 static HRESULT WINAPI DdsFrameEncode_WritePixels(IWICBitmapFrameEncode *iface,
                                                  UINT lineCount, UINT stride, UINT bufferSize, BYTE *pixels)
 {
-    FIXME("(%p,%u,%u,%u,%p): stub\n", iface, lineCount, stride, bufferSize, pixels);
-    return E_NOTIMPL;
+    DdsFrameEncode *This = impl_from_IWICBitmapFrameEncode(iface);
+    UINT line;
+    HRESULT hr;
+
+    TRACE("(%p,%u,%u,%u,%p)\n", iface, lineCount, stride, bufferSize, pixels);
+
+    if (!lineCount || !pixels) return E_INVALIDARG;
+
+    EnterCriticalSection(&This->parent->lock);
+    if (FAILED(hr = dds_frame_prepare(This))) goto done;
+
+    if (lineCount > This->height - This->lines_written || stride < This->width * 4
+            || bufferSize < (size_t)(lineCount - 1) * stride + This->width * 4)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    for (line = 0; line < lineCount; line++)
+        memcpy(This->pixels + (size_t)(This->lines_written + line) * This->width * 4, pixels + (size_t)line * stride,
+               This->width * 4);
+    This->lines_written += lineCount;
+    hr = S_OK;
+
+done:
+    LeaveCriticalSection(&This->parent->lock);
+    return hr;
 }
 
