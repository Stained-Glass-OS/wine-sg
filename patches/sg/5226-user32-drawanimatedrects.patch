From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] user32: DrawAnimatedRects animates the caption frame and honours MinAnimate

DrawAnimatedRects was a stub returning TRUE. It now moves a dotted frame from
the first rectangle to the second in about 200 ms and erases it, unless
SPI_GETANIMATION (iMinAnimate) or the client-area animation setting is off.
win32u keeps MinAnimate under WindowMetrics for SPI_GETANIMATION and
SPI_SETANIMATION (default still off).

CORE: integrator must review. Gate user32-animrects with four mutants.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -1509,12 +1509,113 @@
 }
 
 
+#define IDANI_CAPTION       3     /* not in the Wine headers yet */
+#define ANIMATED_RECT_MS    200   /* how long the caption animation runs */
+#define ANIMATED_RECT_STEP  15    /* time between two drawn frames */
+
+/* a dotted wireframe, 3 pixels thick, XORed onto the DC (twice erases it) */
+static void animated_frame( HDC hdc, HBRUSH brush, const RECT *rc )
+{
+    HBRUSH old = SelectObject( hdc, brush );
+    int w = rc->right - rc->left, h = rc->bottom - rc->top, t = 3;
+
+    if (w < 0) w = 0;
+    if (h < 0) h = 0;
+    if (t > w) t = w;
+    if (t > h) t = h;
+    PatBlt( hdc, rc->left, rc->top, w, t, PATINVERT );
+    PatBlt( hdc, rc->left, rc->bottom - t, w, t, PATINVERT );
+    if (h > 2 * t)
+    {
+        PatBlt( hdc, rc->left, rc->top + t, t, h - 2 * t, PATINVERT );
+        PatBlt( hdc, rc->right - t, rc->top + t, t, h - 2 * t, PATINVERT );
+    }
+    SelectObject( hdc, old );
+}
+
+static LONG animated_lerp( LONG from, LONG to, DWORD elapsed )
+{
+    return from + (LONG)(((LONGLONG)(to - from) * elapsed) / ANIMATED_RECT_MS);
+}
+
 /**********************************************************************
  *		DrawAnimatedRects (USER32.@)
+ *
+ * IDANI_CAPTION: a dotted frame moves and resizes from lprcFrom to lprcTo in about
+ * 200 ms, as when a window minimizes or is restored. Nothing is drawn when the
+ * user turned the minimize animation (SPI_GETANIMATION, "MinAnimate") or the
+ * client-area animations off. The rectangles are relative to the parent of hwnd
+ * (the screen for a top-level window). The frame is erased before returning; no
+ * timer is left behind.
  */
 BOOL WINAPI DrawAnimatedRects( HWND hwnd, INT idAni, const RECT* lprcFrom, const RECT* lprcTo )
 {
-    FIXME("(%p,%d,%p,%p): stub\n",hwnd,idAni,lprcFrom,lprcTo);
+    static const WORD bits[8] = { 0xaa, 0x55, 0xaa, 0x55, 0xaa, 0x55, 0xaa, 0x55 };
+    ANIMATIONINFO info = { sizeof(info) };
+    BOOL enabled = TRUE;
+    HWND clip;
+    HBITMAP pattern;
+    HBRUSH brush;
+    HDC hdc;
+    RECT cur, last;
+    DWORD start, elapsed;
+    BOOL drawn = FALSE;
+
+    if (!lprcFrom || !lprcTo)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (idAni != IDANI_CAPTION) return TRUE;
+    if (hwnd && !IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+
+#ifndef SG_MUTANT_ANIMALWAYS
+    if (SystemParametersInfoW( SPI_GETANIMATION, sizeof(info), &info, 0 ) && !info.iMinAnimate) return TRUE;
+#endif
+#ifndef SG_MUTANT_ANIMCLIENT
+    if (SystemParametersInfoW( SPI_GETCLIENTAREAANIMATION, 0, &enabled, 0 ) && !enabled) return TRUE;
+#endif
+#ifdef SG_MUTANT_ANIMNONE
+    return TRUE;
+#endif
+
+    clip = hwnd ? NtUserGetAncestor( hwnd, GA_PARENT ) : NULL;
+    if (!clip) clip = NtUserGetDesktopWindow();
+    if (!(hdc = NtUserGetDCEx( clip, 0, DCX_CACHE | DCX_LOCKWINDOWUPDATE ))) return FALSE;
+    pattern = CreateBitmap( 8, 8, 1, 1, bits );
+    brush = CreatePatternBrush( pattern );
+
+    start = GetTickCount();
+    for (;;)
+    {
+        elapsed = GetTickCount() - start;
+        if (elapsed > ANIMATED_RECT_MS) elapsed = ANIMATED_RECT_MS;
+        cur.left   = animated_lerp( lprcFrom->left,   lprcTo->left,   elapsed );
+        cur.top    = animated_lerp( lprcFrom->top,    lprcTo->top,    elapsed );
+        cur.right  = animated_lerp( lprcFrom->right,  lprcTo->right,  elapsed );
+        cur.bottom = animated_lerp( lprcFrom->bottom, lprcTo->bottom, elapsed );
+#ifndef SG_MUTANT_ANIMLEAVE
+        if (drawn)
+#else
+        if (drawn && elapsed < ANIMATED_RECT_MS)
+#endif
+            animated_frame( hdc, brush, &last );
+        if (elapsed >= ANIMATED_RECT_MS) break;
+        animated_frame( hdc, brush, &cur );
+        GdiFlush();
+        last = cur;
+        drawn = TRUE;
+        Sleep( ANIMATED_RECT_STEP );
+    }
+    GdiFlush();
+
+    DeleteObject( brush );
+    DeleteObject( pattern );
+    NtUserReleaseDC( clip, hdc );
     return TRUE;
 }
 
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5421,6 +5421,9 @@
 
 static BOOL_ENTRY( BLOCKSENDINPUTRESETS, FALSE, DESKTOP_KEY, "BlockSendInputResets" );
 static BOOL_ENTRY( DRAGFULLWINDOWS, FALSE, DESKTOP_KEY, "DragFullWindows" );
+/* SPI_GETANIMATION iMinAnimate: Windows keeps it as the string "MinAnimate" under WindowMetrics.
+ * Wine reports it disabled; the default stays off, so only a user who sets it sees the animation */
+static BOOL_ENTRY( MINANIMATE, FALSE, METRICS_KEY, "MinAnimate" );
 static BOOL_ENTRY( KEYBOARDPREF, TRUE, KEYBOARDPREF_KEY, "On" );
 static BOOL_ENTRY( LOWPOWERACTIVE, FALSE, DESKTOP_KEY, "LowPowerActive" );
 static BOOL_ENTRY( MOUSEBUTTONSWAP, FALSE, MOUSE_KEY, "SwapMouseButtons" );
@@ -5595,6 +5598,7 @@
     (union sysparam_all_entry *)&entry_DOUBLECLKHEIGHT,
     (union sysparam_all_entry *)&entry_DOUBLECLKWIDTH,
     (union sysparam_all_entry *)&entry_DRAGFULLWINDOWS,
+    (union sysparam_all_entry *)&entry_MINANIMATE,
     (union sysparam_all_entry *)&entry_DRAGHEIGHT,
     (union sysparam_all_entry *)&entry_DRAGWIDTH,
     (union sysparam_all_entry *)&entry_FOCUSBORDERHEIGHT,
@@ -6552,17 +6556,22 @@
     {
         ANIMATIONINFO *anim_info = ptr;
 
-	/* Tell it "disabled" */
-	if (anim_info && anim_info->cbSize == sizeof(ANIMATIONINFO))
+        if (anim_info && anim_info->cbSize == sizeof(ANIMATIONINFO))
         {
-            /* Minimize and restore animation is disabled (nonzero == enabled) */
-	    anim_info->iMinAnimate = 0;
-            ret = TRUE;
+            UINT enabled;
+            /* minimize and restore animation (nonzero == enabled), off unless set */
+            if ((ret = get_entry( &entry_MINANIMATE, 0, &enabled ))) anim_info->iMinAnimate = enabled != 0;
         }
-	break;
+        break;
     }
+    case SPI_SETANIMATION:
+    {
+        ANIMATIONINFO *anim_info = ptr;
 
-    WINE_SPI_WARN(SPI_SETANIMATION);
+        if (anim_info && anim_info->cbSize == sizeof(ANIMATIONINFO))
+            ret = set_entry( &entry_MINANIMATE, anim_info->iMinAnimate != 0, NULL, winini );
+        break;
+    }
 
     case SPI_GETFONTSMOOTHING:
         ret = get_entry( &entry_FONTSMOOTHING, val, ptr );
