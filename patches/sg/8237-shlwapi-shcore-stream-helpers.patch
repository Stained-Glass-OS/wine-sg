From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shlwapi, shcore: IStream_ReadStr/WriteStr, IStream_ReadPidl/WritePidl and stubs that shcore implements

IStream_WriteStr and IStream_ReadStr (shcore; shlwapi 596/597 forward to them) write a string as its USHORT character count and characters and read it back, freed with CoTaskMemFree. IStream_WritePidl and IStream_ReadPidl (shlwapi 512/513) write an item id list as its DWORD size and bytes and read it back, a list that does not end exactly at its size being refused. shlwapi 568 IStream_Copy, 629 SHRegGetValueFromHKCUHKLM and 630 SHRegGetBoolValueFromHKCUHKLM were stubs while shcore implements them: they forward. The layouts are undocumented; the pairs read what they write.
---
--- a/dlls/shcore/main.c
+++ b/dlls/shcore/main.c
@@ -3011,6 +3011,61 @@
     return IStream_CopyTo(src, dst, count, NULL, NULL);
 }
 
+#ifndef SG_MUTANT_NO_ISTREAM_STR
+/*************************************************************************
+ *      IStream_WriteStr        [SHCORE.@]
+ *
+ * (wine-sg 8237) A string to a stream: its length in characters as a USHORT, then its characters without the
+ * terminating null (the layout is undocumented: IStream_ReadStr reads it back).
+ */
+HRESULT WINAPI IStream_WriteStr(IStream *stream, const WCHAR *str)
+{
+    size_t len;
+    USHORT count;
+    HRESULT hr;
+
+    TRACE("%p, %s.\n", stream, debugstr_w(str));
+
+    if (!stream || !str) return E_INVALIDARG;
+    if ((len = wcslen(str)) > 0xffff) return HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW);
+    count = len;
+    if (FAILED(hr = IStream_Write(stream, &count, sizeof(count), NULL))) return hr;
+    if (count && FAILED(hr = IStream_Write(stream, str, count * sizeof(WCHAR), NULL))) return hr;
+    return S_OK;
+}
+
+/*************************************************************************
+ *      IStream_ReadStr        [SHCORE.@]
+ *
+ * A string IStream_WriteStr wrote; freed with CoTaskMemFree.
+ */
+HRESULT WINAPI IStream_ReadStr(IStream *stream, WCHAR **str)
+{
+    USHORT count;
+    WCHAR *buf;
+    HRESULT hr;
+
+    TRACE("%p, %p.\n", stream, str);
+
+    if (!str) return E_INVALIDARG;
+    *str = NULL;
+    if (!stream) return E_INVALIDARG;
+    if (FAILED(hr = _IStream_Read(stream, &count, sizeof(count)))) return hr;
+    if (!(buf = CoTaskMemAlloc((count + 1) * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if (count && FAILED(hr = _IStream_Read(stream, buf, count * sizeof(WCHAR))))
+    {
+        CoTaskMemFree(buf);
+        return hr;
+    }
+    buf[count] = 0;
+    *str = buf;
+    return S_OK;
+}
+#else
+HRESULT WINAPI IStream_WriteStr(IStream *stream, const WCHAR *str) { return E_NOTIMPL; }
+HRESULT WINAPI IStream_ReadStr(IStream *stream, WCHAR **str) { return E_NOTIMPL; }
+#endif
+
