+#ifndef SG_MUTANT_NO_ISTREAM_PIDL
+/* (wine-sg 8237) the size of an item id list with its terminator, 0 if it runs past max bytes */
+static ULONG pidl_size( const ITEMIDLIST *pidl, ULONG max )
+{
+    ULONG size = 0;
+
+    for (;;)
+    {
+        USHORT cb;
+        if (size + sizeof(USHORT) > max) return 0;
+        memcpy( &cb, (const BYTE *)pidl + size, sizeof(cb) );
+        size += cb ? cb : sizeof(USHORT);
+        if (!cb) return size;
+        if (cb < sizeof(USHORT)) return 0;
+    }
+}
+
+/*************************************************************************
+ *      IStream_WritePidl   [SHLWAPI.513]
+ *
+ * An item id list to a stream: its size in bytes with the terminator as a DWORD, then the list (the layout is
+ * undocumented: IStream_ReadPidl reads it back).
+ */
+HRESULT WINAPI IStream_WritePidl( IStream *stream, const ITEMIDLIST *pidl )
+{
+    DWORD size;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", stream, pidl );
+
+    if (!stream || !pidl) return E_INVALIDARG;
+    if (!(size = pidl_size( pidl, ~0u ))) return E_INVALIDARG;
+    if (FAILED(hr = IStream_Write( stream, &size, sizeof(size), NULL ))) return hr;
+    return IStream_Write( stream, pidl, size, NULL );
+}
+
+/*************************************************************************
+ *      IStream_ReadPidl   [SHLWAPI.512]
+ *
+ * An item id list IStream_WritePidl wrote; freed with CoTaskMemFree (ILFree).
+ */
+HRESULT WINAPI IStream_ReadPidl( IStream *stream, ITEMIDLIST **pidl )
+{
+    DWORD size;
+    ULONG read;
+    BYTE *buf;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", stream, pidl );
+
+    if (!pidl) return E_INVALIDARG;
+    *pidl = NULL;
+    if (!stream) return E_INVALIDARG;
+    if (FAILED(hr = IStream_Read( stream, &size, sizeof(size), &read ))) return hr;
+    if (read != sizeof(size)) return HRESULT_FROM_WIN32( ERROR_HANDLE_EOF );
+    if (size < sizeof(USHORT) || size > 0x100000) return E_INVALIDARG;
+    if (!(buf = CoTaskMemAlloc( size ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = IStream_Read( stream, buf, size, &read )) || read != size)
+    {
+        CoTaskMemFree( buf );
+        return FAILED(hr) ? hr : HRESULT_FROM_WIN32( ERROR_HANDLE_EOF );
+    }
+    /* a well-formed list that ends with its terminator exactly at the size */
+    if (pidl_size( (ITEMIDLIST *)buf, size ) != size)
+    {
+        CoTaskMemFree( buf );
+        return E_INVALIDARG;
+    }
+    *pidl = (ITEMIDLIST *)buf;
+    return S_OK;
+}
+#else
+HRESULT WINAPI IStream_WritePidl( IStream *stream, const ITEMIDLIST *pidl ) { return E_NOTIMPL; }
+HRESULT WINAPI IStream_ReadPidl( IStream *stream, ITEMIDLIST **pidl ) { return E_NOTIMPL; }
+#endif
