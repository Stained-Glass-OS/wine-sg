+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "icm.h"
+
+#include "wine/test.h"
+
+static BOOL (WINAPI *pWcsEnumColorProfilesSize)(WCS_PROFILE_MANAGEMENT_SCOPE, ENUMTYPEW *, DWORD *);
+
+static void test_WcsEnumColorProfilesSize(void)
+{
+    ENUMTYPEW record = { sizeof(record), ENUM_TYPE_VERSION };
+    DWORD size, expected = 0, ret_size;
+    BOOL ret;
+
+    if (!pWcsEnumColorProfilesSize)
+    {
+        win_skip("WcsEnumColorProfilesSize is not available.\n");
+        return;
+    }
+
+    SetLastError(0xdeadbeef);
+    ret = pWcsEnumColorProfilesSize(WCS_PROFILE_MANAGEMENT_SCOPE_SYSTEM_WIDE, NULL, &size);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, %lu\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = pWcsEnumColorProfilesSize(WCS_PROFILE_MANAGEMENT_SCOPE_SYSTEM_WIDE, &record, NULL);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, %lu\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = pWcsEnumColorProfilesSize(7, &record, &size);
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, %lu\n", ret, GetLastError());
+
+    SetLastError(0xdeadbeef);
+    ret = EnumColorProfilesW(NULL, &record, NULL, &expected, NULL);
+    if (ret || GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+    {
+        skip("No color profiles to count.\n");
+        return;
+    }
+    ok(expected > sizeof(WCHAR), "got %lu\n", expected);
+
+    size = 0xdeadbeef;
+    ret = pWcsEnumColorProfilesSize(WCS_PROFILE_MANAGEMENT_SCOPE_SYSTEM_WIDE, &record, &size);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(size == expected, "got %lu, expected %lu\n", size, expected);
+    ret_size = size;
+
+    size = 0xdeadbeef;
+    ret = pWcsEnumColorProfilesSize(WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER, &record, &size);
+    ok(ret && size == ret_size, "got %d %lu vs %lu\n", ret, size, ret_size);
+}
+
+START_TEST(sgcalls)
+{
+    HMODULE mscms = GetModuleHandleA("mscms.dll");
+
+    pWcsEnumColorProfilesSize = (void *)GetProcAddress(mscms, "WcsEnumColorProfilesSize");
+    test_WcsEnumColorProfilesSize();
+}
