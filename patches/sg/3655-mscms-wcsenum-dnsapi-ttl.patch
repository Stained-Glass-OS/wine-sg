From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mscms WcsEnumColorProfilesSize; dnsapi TTL option quiet (3655)

mscms WcsEnumColorProfilesSize; dnsapi TTL-reset option quiet

WcsEnumColorProfilesSize returns the buffer size EnumColorProfilesW needs and validates the scope.
DNS_QUERY_DONT_RESET_TTL_VALUES needs no action without a DNS cache, so it only traces.
---
diff --git a/dlls/dnsapi/libresolv.c b/dlls/dnsapi/libresolv.c
index 9034651..1047d33 100644
--- a/dlls/dnsapi/libresolv.c
+++ b/dlls/dnsapi/libresolv.c
@@ -86,8 +86,10 @@ static unsigned long map_options( DWORD options )
     if (options & DNS_QUERY_TREAT_AS_FQDN)
         ret &= ~RES_DEFNAMES;
 
+    /* DNS_QUERY_DONT_RESET_TTL_VALUES only matters for answers served from the DNS client cache;
+     * there is no cache here, so every answer already carries the TTL of the response. */
     if (options & DNS_QUERY_DONT_RESET_TTL_VALUES)
-        FIXME( "option DNS_QUERY_DONT_RESET_TTL_VALUES not implemented\n" );
+        TRACE( "option DNS_QUERY_DONT_RESET_TTL_VALUES: no cache, TTLs come from the response\n" );
     if (options & DNS_QUERY_RESERVED)
         FIXME( "option DNS_QUERY_RESERVED not implemented\n" );
     if (options & DNS_QUERY_WIRE_ONLY)
diff --git a/dlls/mscms/profile.c b/dlls/mscms/profile.c
index e72c486..442ee56 100644
--- a/dlls/mscms/profile.c
+++ b/dlls/mscms/profile.c
@@ -1571,9 +1571,30 @@ BOOL WINAPI WcsGetUsePerUserProfiles( const WCHAR* name, DWORD class, BOOL* use_
  */
 BOOL WINAPI WcsEnumColorProfilesSize( WCS_PROFILE_MANAGEMENT_SCOPE scope, ENUMTYPEW *record, DWORD *size )
 {
-    FIXME( "%d %p %p\n", scope, record, size );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    DWORD needed = 0;
+
+    TRACE( "%d %p %p\n", scope, record, size );
+
+#ifdef SG_MUTANT_MSCMS_SCOPE
+    if (!record || !size)
+#else
+    if (!record || !size || (scope != WCS_PROFILE_MANAGEMENT_SCOPE_SYSTEM_WIDE &&
+                             scope != WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER))
+#endif
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    /* the profiles live in the one color directory whatever the scope */
+    if (!EnumColorProfilesW( NULL, record, NULL, &needed, NULL ) && GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+        return FALSE;
+
+#ifdef SG_MUTANT_MSCMS_SIZE
+    needed++;
+#endif
+    *size = needed;
+    return TRUE;
 }
 
 /******************************************************************************
diff --git a/dlls/mscms/tests/Makefile.in b/dlls/mscms/tests/Makefile.in
index 41ac721..d4f1c3f 100644
--- a/dlls/mscms/tests/Makefile.in
+++ b/dlls/mscms/tests/Makefile.in
@@ -2,4 +2,5 @@ TESTDLL   = mscms.dll
 IMPORTS   = mscms user32 advapi32
 
 SOURCES = \
-	profile.c
+	profile.c \
+	sgcalls.c
diff --git a/dlls/mscms/tests/sgcalls.c b/dlls/mscms/tests/sgcalls.c
new file mode 100644
index 0000000..2cbc90f
--- /dev/null
+++ b/dlls/mscms/tests/sgcalls.c
@@ -0,0 +1,79 @@
