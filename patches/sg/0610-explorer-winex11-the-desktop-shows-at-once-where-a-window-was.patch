From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer, winex11: the desktop shows at once where a window was

The virtual desktop's X window had no background, so where a window moved
off it X left what was there until explorer repainted: a window dragged
fast left copies of itself for a moment (David). explorer now draws the
whole desktop off screen shortly after it is drawn and hands it to winex11
(an X11DRV escape), which makes it the desktop window's background pixmap:
the X server fills an exposed spot with the desktop by itself.
---
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -259,6 +259,41 @@
 /**********************************************************************
  *           ExtEscape  (X11DRV.@)
  */
+/* Stained Glass OS: the virtual desktop's picture becomes its X window's
+ * background (see struct x11drv_escape_sg_background) */
+static BOOL set_desktop_background( const struct x11drv_escape_sg_background *bg )
+{
+    XImage *image;
+    Pixmap pixmap;
+    GC gc;
+
+    if (!is_virtual_desktop() || root_window == DefaultRootWindow( gdi_display )) return FALSE;
+    if (!bg->bits || bg->width <= 0 || bg->height <= 0 || bg->width > 16384 || bg->height > 16384) return FALSE;
+    if (default_visual.class != TrueColor || (default_visual.depth != 24 && default_visual.depth != 32) ||
+        default_visual.red_mask != 0xff0000 || default_visual.green_mask != 0xff00 || default_visual.blue_mask != 0xff)
+        return FALSE;
+    if (!(image = XCreateImage( gdi_display, default_visual.visual, default_visual.depth, ZPixmap, 0,
+                                (char *)bg->bits, bg->width, bg->height, 32, bg->width * 4 )))
+        return FALSE;
+    if (image->bits_per_pixel != 32 || image->byte_order != LSBFirst)
+    {
+        image->data = NULL;
+        XDestroyImage( image );
+        return FALSE;
+    }
+    pixmap = XCreatePixmap( gdi_display, root_window, bg->width, bg->height, default_visual.depth );
+    gc = XCreateGC( gdi_display, pixmap, 0, NULL );
+    XPutImage( gdi_display, pixmap, gc, image, 0, 0, 0, 0, bg->width, bg->height );
+    XSetWindowBackgroundPixmap( gdi_display, root_window, pixmap );
+    XFreeGC( gdi_display, gc );
+    XFreePixmap( gdi_display, pixmap );
+    XFlush( gdi_display );
+    image->data = NULL;
+    XDestroyImage( image );
+    TRACE( "desktop background %dx%d\n", bg->width, bg->height );
+    return TRUE;
+}
+
 static INT X11DRV_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID in_data,
                              INT out_count, LPVOID out_data )
 {
@@ -307,6 +342,10 @@
                     return TRUE;
                 }
                 break;
+            case X11DRV_SG_DESKTOP_BACKGROUND:
+                if (in_count >= sizeof(struct x11drv_escape_sg_background))
+                    return set_desktop_background( in_data );
+                break;
             case X11DRV_START_EXPOSURES:
                 XSetGraphicsExposures( gdi_display, physDev->gc, True );
                 physDev->exposures = 0;
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -337,6 +337,19 @@
     X11DRV_GET_DRAWABLE,     /* get current drawable for a DC */
     X11DRV_START_EXPOSURES,  /* start graphics exposures */
     X11DRV_END_EXPOSURES,    /* end graphics exposures */
+    X11DRV_SG_DESKTOP_BACKGROUND = 0x5347, /* Stained Glass OS: the desktop's picture, for X to show */
+};
+
+/* The virtual desktop's picture -- wallpaper and icons, 32-bit top-down BGRX,
+ * width x height -- made the desktop X window's background: where a window
+ * moves off it, X shows the desktop at once instead of what was there until
+ * the desktop repaints (a fast-dragged window left copies of itself). */
+struct x11drv_escape_sg_background
+{
+    enum x11drv_escape_codes code;         /* escape code (X11DRV_SG_DESKTOP_BACKGROUND) */
+    int                      width;
+    int                      height;
+    const void              *bits;
 };
 
 struct x11drv_escape_set_drawable
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -1210,6 +1210,7 @@
 
 /* window procedure for the desktop window */
 #define SG_WALLPAPER_REPAINT 0x5750
+#define SG_BACKGROUND_TIMER  0x5347
 
 static BOOL CALLBACK repaint_window( HWND hwnd, LPARAM lparam )
 {
@@ -1548,6 +1549,8 @@
     fclose( f );
 }
 
+static void sg_background_later( HWND hwnd );
+
 /* draw the desktop now, before a menu's loop: UpdateWindow gives the desktop window
  * only WM_ERASEBKGND, and its WM_PAINT would wait for the menu to close */
 static void sg_draw_now( HWND hwnd )
@@ -1561,6 +1564,59 @@
     ReleaseDC( hwnd, hdc );
     ValidateRect( hwnd, NULL );
     sg_dump();
+    sg_background_later( hwnd );
+}
+
+/* Stained Glass OS: the desktop's picture, handed to the display driver as
+ * its X window's background, so where a window moves off the desktop the
+ * desktop shows at once (a fast-dragged window left copies of itself until
+ * the desktop repainted). Made shortly after the desktop is drawn. */
+struct sg_background_escape
+{
+    int code;                    /* X11DRV_SG_DESKTOP_BACKGROUND */
+    int width, height;
+    const void *bits;            /* 32-bit, top-down */
+};
+
+static void sg_set_background( HWND hwnd )
+{
+    BITMAPINFO bi = {{ sizeof(BITMAPINFOHEADER) }};
+    struct sg_background_escape esc;
+    HDC hdc, mem;
+    HBITMAP dib;
+    void *bits;
+    RECT rc;
+
+    GetClientRect( hwnd, &rc );
+    if (IsRectEmpty( &rc )) return;
+    bi.bmiHeader.biWidth = rc.right;
+    bi.bmiHeader.biHeight = -rc.bottom;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    bi.bmiHeader.biCompression = BI_RGB;
+    hdc = GetDC( hwnd );
+    mem = CreateCompatibleDC( hdc );
+    if ((dib = CreateDIBSection( hdc, &bi, DIB_RGB_COLORS, &bits, NULL, 0 )))
+    {
+        HGDIOBJ old = SelectObject( mem, dib );
+        PaintDesktop( mem );
+        draw_launchers( mem, rc );
+        GdiFlush();
+        esc.code = 0x5347;
+        esc.width = rc.right;
+        esc.height = rc.bottom;
+        esc.bits = bits;
+        ExtEscape( hdc, 6789 /* X11DRV_ESCAPE */, sizeof(esc), (const char *)&esc, 0, NULL );
+        SelectObject( mem, old );
+        DeleteObject( dib );
+    }
+    DeleteDC( mem );
+    ReleaseDC( hwnd, hdc );
+}
+
+static void sg_background_later( HWND hwnd )
+{
+    if (!using_root) SetTimer( hwnd, SG_BACKGROUND_TIMER, 300, NULL );
 }
 
 /* Stained Glass OS: draw part of the desktop at once, off screen first (a
@@ -1587,6 +1643,7 @@
     }
