From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 04:31:34 -0700
Subject: [PATCH] msi: transactions and MsiGetPatchFileList

MsiBeginTransaction/MsiJoinTransaction/MsiEndTransaction keep one transaction
per process with the documented parameter checks and error codes, and signal
the previous owner's event when ownership changes. MsiGetPatchFileList opens
the installed product, applies the listed patches, costs the files and returns
one record per patched file with its target path in field 1.

diff --git a/dlls/msi/msi.c b/dlls/msi/msi.c
index abd28d1..3e2d2dd 100644
--- a/dlls/msi/msi.c
+++ b/dlls/msi/msi.c
@@ -1623,20 +1623,104 @@ done:
     return r;
 }
 
-UINT WINAPI MsiGetPatchFileListA(LPCSTR szProductCode, LPCSTR szPatchList,
-                                 LPDWORD pcFiles, MSIHANDLE **pphFileRecords)
+static UINT patch_file_list( const WCHAR *product, const WCHAR *patches, DWORD *count, MSIHANDLE **records )
 {
-    FIXME("(%s, %s, %p, %p) stub!\n", debugstr_a(szProductCode),
-          debugstr_a(szPatchList), pcFiles, pphFileRecords);
-    return ERROR_FUNCTION_FAILED;
+    static const MSIINSTALLCONTEXT contexts[] = { MSIINSTALLCONTEXT_USERUNMANAGED, MSIINSTALLCONTEXT_USERMANAGED,
+                                                  MSIINSTALLCONTEXT_MACHINE };
+    MSIPACKAGE *package = NULL;
+    MSIQUERY *view;
+    MSIRECORD *row;
+    MSIHANDLE *handles = NULL;
+    DWORD n = 0, alloc = 0;
+    UINT r = ERROR_FUNCTION_FAILED, i;
+
+    for (i = 0; i < ARRAY_SIZE(contexts); i++)
+    {
+        r = open_package( product, NULL, contexts[i], &package );
+        if (r == ERROR_SUCCESS) break;
+    }
+    if (r != ERROR_SUCCESS) return ERROR_FUNCTION_FAILED;
+
+    msi_set_property( package->db, L"PATCH", patches, -1 );
+    msi_apply_patches( package );
+    ACTION_PerformAction( package, L"CostInitialize" );
+    ACTION_PerformAction( package, L"FileCost" );
+    ACTION_PerformAction( package, L"CostFinalize" );
+
+    r = ERROR_SUCCESS;
+    if (MSI_DatabaseOpenViewW( package->db, L"SELECT `File_` FROM `Patch`", &view ) == ERROR_SUCCESS)
+    {
+        if (MSI_ViewExecute( view, 0 ) == ERROR_SUCCESS)
+        {
+            while (r == ERROR_SUCCESS && MSI_ViewFetch( view, &row ) == ERROR_SUCCESS)
+            {
+                const WCHAR *key = MSI_RecordGetString( row, 1 );
+                MSIFILE *file = key ? msi_get_loaded_file( package, key ) : NULL;
+                if (file && file->TargetPath)
+                {
+                    MSIRECORD *rec = MSI_CreateRecord( 1 );
+                    if (!rec) r = ERROR_OUTOFMEMORY;
+                    else
+                    {
+                        MSI_RecordSetStringW( rec, 1, file->TargetPath );
+                        if (n == alloc)
+                        {
+                            MSIHANDLE *tmp = realloc( handles, (alloc + 16) * sizeof(*handles) );
+                            if (!tmp) r = ERROR_OUTOFMEMORY;
+                            else { handles = tmp; alloc += 16; }
+                        }
+                        if (r == ERROR_SUCCESS && !(handles[n] = alloc_msihandle( &rec->hdr ))) r = ERROR_OUTOFMEMORY;
+                        else if (r == ERROR_SUCCESS) n++;
+                        msiobj_release( &rec->hdr );
+                    }
+                }
+                msiobj_release( &row->hdr );
+            }
+        }
+        MSI_ViewClose( view );
+        msiobj_release( &view->hdr );
+    }
+    msiobj_release( &package->hdr );
+
+    if (r == ERROR_SUCCESS)
+    {
+        MSIHANDLE *out = LocalAlloc( LMEM_FIXED, max( n, 1 ) * sizeof(*out) );
+        if (out) { memcpy( out, handles, n * sizeof(*out) ); *records = out; *count = n; }
+        else r = ERROR_OUTOFMEMORY;
+    }
+    if (r != ERROR_SUCCESS) while (n) MsiCloseHandle( handles[--n] );
+    free( handles );
+    return r;
 }
 
 UINT WINAPI MsiGetPatchFileListW(LPCWSTR szProductCode, LPCWSTR szPatchList,
                                  LPDWORD pcFiles, MSIHANDLE **pphFileRecords)
 {
-    FIXME("(%s, %s, %p, %p) stub!\n", debugstr_w(szProductCode),
-          debugstr_w(szPatchList), pcFiles, pphFileRecords);
-    return ERROR_FUNCTION_FAILED;
+    TRACE("(%s, %s, %p, %p)\n", debugstr_w(szProductCode), debugstr_w(szPatchList), pcFiles, pphFileRecords);
+
+    if (!szProductCode || !szPatchList || !szPatchList[0] || !pcFiles || !pphFileRecords)
+        return ERROR_INVALID_PARAMETER;
+    if (wcslen( szProductCode ) != 38) return ERROR_INVALID_PARAMETER;
+
+    return patch_file_list( szProductCode, szPatchList, pcFiles, pphFileRecords );
+}
+
+UINT WINAPI MsiGetPatchFileListA(LPCSTR szProductCode, LPCSTR szPatchList,
+                                 LPDWORD pcFiles, MSIHANDLE **pphFileRecords)
+{
+    WCHAR *product, *patches;
+    UINT r;
+
+    TRACE("(%s, %s, %p, %p)\n", debugstr_a(szProductCode), debugstr_a(szPatchList), pcFiles, pphFileRecords);
+
+    if (!szProductCode || !szPatchList) return ERROR_INVALID_PARAMETER;
+    product = strdupAtoW( szProductCode );
+    patches = strdupAtoW( szPatchList );
+    if (!product || !patches) r = ERROR_OUTOFMEMORY;
+    else r = MsiGetPatchFileListW( product, patches, pcFiles, pphFileRecords );
+    free( product );
+    free( patches );
+    return r;
 }
 
 UINT WINAPI MsiGetPatchInfoExA(LPCSTR szPatchCode, LPCSTR szProductCode,
@@ -4432,6 +4516,23 @@ UINT WINAPI MsiProvideComponentW( const WCHAR *product, const WCHAR *feature, co
     }
 }
 
+#define SG_MSITRANSACTION_CHAIN_EMBEDDEDUI         0x1
+#define SG_MSITRANSACTION_JOIN_EXISTING_EMBEDDEDUI 0x2
+
+/* One multiple-package transaction at a time, owned by this process.
+ * Rolling back or committing the installs that ran inside it is not done:
+ * each install in the chain already commits by itself. */
+static CRITICAL_SECTION transaction_cs;
+static CRITICAL_SECTION_DEBUG transaction_cs_debug =
+{
+    0, 0, &transaction_cs,
+    { &transaction_cs_debug.ProcessLocksList, &transaction_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": transaction_cs") }
+};
+static CRITICAL_SECTION transaction_cs = { &transaction_cs_debug, -1, 0, 0, 0, 0 };
+static struct { BOOL active; MSIHANDLE id; HANDLE owner_event; } transaction;
+static MSIHANDLE next_transaction_id = 0x7000;
+
 /***********************************************************************
  * MsiBeginTransactionA     [MSI.@]
  */
@@ -4440,11 +4541,11 @@ UINT WINAPI MsiBeginTransactionA( const char *name, DWORD attrs, MSIHANDLE *id,
     WCHAR *nameW;
     UINT r;
 
-    FIXME( "%s, %#lx, %p, %p\n", debugstr_a(name), attrs, id, event );
+    TRACE( "%s, %#lx, %p, %p\n", debugstr_a(name), attrs, id, event );
 
+    if (!name) return ERROR_INVALID_PARAMETER;
     nameW = strdupAtoW( name );
-    if (name && !nameW)
-        return ERROR_OUTOFMEMORY;
+    if (!nameW) return ERROR_OUTOFMEMORY;
 
     r = MsiBeginTransactionW( nameW, attrs, id, event );
     free( nameW );
@@ -4456,12 +4557,28 @@ UINT WINAPI MsiBeginTransactionA( const char *name, DWORD attrs, MSIHANDLE *id,
  */
 UINT WINAPI MsiBeginTransactionW( const WCHAR *name, DWORD attrs, MSIHANDLE *id, HANDLE *event )
 {
-    FIXME( "%s, %#lx, %p, %p\n", debugstr_w(name), attrs, id, event );
+    HANDLE ev;
+    UINT r = ERROR_SUCCESS;
 
-    *id = (MSIHANDLE)0xdeadbeef;
-    *event = (HANDLE)0xdeadbeef;
+    TRACE( "%s, %#lx, %p, %p\n", debugstr_w(name), attrs, id, event );
 
-    return ERROR_SUCCESS;
+    if (!name || !name[0] || !id || !event || (attrs & ~SG_MSITRANSACTION_CHAIN_EMBEDDEDUI))
+        return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection( &transaction_cs );
+    if (transaction.active) r = ERROR_INSTALL_ALREADY_RUNNING;
+    else if (!(ev = CreateEventW( NULL, TRUE, FALSE, NULL ))) r = GetLastError();
+    else
+    {
+        transaction.active = TRUE;
+        transaction.id = next_transaction_id++;
+        transaction.owner_event = ev;
+        *id = transaction.id;
+        if (!DuplicateHandle( GetCurrentProcess(), ev, GetCurrentProcess(), event, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+            *event = ev;
+    }
+    LeaveCriticalSection( &transaction_cs );
+    return r;
 }
 
 /***********************************************************************
@@ -4469,10 +4586,28 @@ UINT WINAPI MsiBeginTransactionW( const WCHAR *name, DWORD attrs, MSIHANDLE *id,
  */
 UINT WINAPI MsiJoinTransaction( MSIHANDLE handle, DWORD attrs, HANDLE *event )
 {
-    FIXME( "%lu, %#lx, %p\n", handle, attrs, event );
+    HANDLE ev;
+    UINT r = ERROR_SUCCESS;
 
-    *event = (HANDLE)0xdeadbeef;
-    return ERROR_SUCCESS;
+    TRACE( "%lu, %#lx, %p\n", handle, attrs, event );
+
+    if (!event || (attrs & ~(SG_MSITRANSACTION_CHAIN_EMBEDDEDUI | SG_MSITRANSACTION_JOIN_EXISTING_EMBEDDEDUI)))
+        return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection( &transaction_cs );
+    if (!transaction.active || transaction.id != handle) r = ERROR_INVALID_HANDLE_STATE;
+    else if (!(ev = CreateEventW( NULL, TRUE, FALSE, NULL ))) r = GetLastError();
+    else
+    {
+        /* the previous owner learns about the change through its event */
+        SetEvent( transaction.owner_event );
+        CloseHandle( transaction.owner_event );
+        transaction.owner_event = ev;
+        if (!DuplicateHandle( GetCurrentProcess(), ev, GetCurrentProcess(), event, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+            *event = ev;
+    }
+    LeaveCriticalSection( &transaction_cs );
+    return r;
 }
 
 /***********************************************************************
@@ -4480,8 +4615,23 @@ UINT WINAPI MsiJoinTransaction( MSIHANDLE handle, DWORD attrs, HANDLE *event )
  */
 UINT WINAPI MsiEndTransaction( DWORD state )
 {
-    FIXME( "%#lx\n", state );
-    return ERROR_SUCCESS;
+    UINT r = ERROR_SUCCESS;
+
+    TRACE( "%#lx\n", state );
+
+    if (state > 1) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection( &transaction_cs );
+#ifndef SG_MUTANT_MSI_TXN
+    if (!transaction.active) r = ERROR_ACCESS_DENIED;
+    else
+#endif
+    {
+        CloseHandle( transaction.owner_event );
+        memset( &transaction, 0, sizeof(transaction) );
+    }
+    LeaveCriticalSection( &transaction_cs );
+    return r;
 }
 
