From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] netapi32: NetUserGetInfo levels 2, 3, 4, 11, 20 and 23

- Levels 2, 3, 4, 11, 20 and 23 answered NERR_InternalError (a FIXME).
  They are now built from the same account data levels 0, 1 and 10 use,
  as one block each: password never returned, never-expiring account,
  unlimited storage, logon server "\\*", ANSI code page, Domain Users as
  the primary group, empty strings that are real empty strings.
- usri3_user_id / usri20_user_id are the account's relative id (last
  sub-authority of its SID, 1000 when the name has no OS account behind
  it). Levels 4 and 23 carry the account SID inside the buffer when the
  account resolves. Level 4 is built field by field: USER_INFO_4 has a
  PSID where USER_INFO_3 has a DWORD, so every field after it sits at a
  different offset on a 64-bit build and copying a level 3 would be wrong.
- The single-field levels 1003 ... 1053 belong to NetUserSetInfo; for
  NetUserGetInfo they answer ERROR_INVALID_LEVEL, as every other unknown
  level does, not NERR_InternalError.

Gate: test/netuserinfo-gate.sh (64- and 32-bit, test/netuserinfo-probe.c).
Mutants SG_MUTANT_NUI_L4_COPY/NO_SID/LEVEL/RID (netapi32/netapi32.c).

Integrator: a failed NetApiBufferAllocate returns its error (and frees the
level-1 data) instead of writing through a NULL buffer.
---
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -924,6 +924,9 @@
     }
     default:
         TRACE("Invalid level %ld is specified\n", level);
+#ifdef SG_MUTANT_NUI_LEVEL
+        if (level >= 1003 && level <= 1053) return NERR_InternalError;
+#endif
         return ERROR_INVALID_LEVEL;
     }
     return NERR_Success;
@@ -1383,6 +1386,23 @@
 /************************************************************
  *                NetUserGetInfo  (NETAPI32.@)
  */
+/* The relative id (last sub-authority of the account SID) the account list
+ * reports as usri*_user_id; 1000, the first ordinary account, when the name
+ * has no OS account behind it. */
+static DWORD get_user_rid(const WCHAR *username)
+{
+    BYTE sidbuf[SECURITY_MAX_SID_SIZE];
+    WCHAR domain[MAX_COMPUTERNAME_LENGTH + 1];
+    DWORD sidsize = sizeof(sidbuf), domainsize = ARRAY_SIZE(domain);
+    SID_NAME_USE use;
+
+#ifdef SG_MUTANT_NUI_RID
+    return 7;
+#endif
+    if (!LookupAccountNameW(NULL, username, (PSID)sidbuf, &sidsize, domain, &domainsize, &use)) return 1000;
+    return *GetSidSubAuthority((PSID)sidbuf, *GetSidSubAuthorityCount((PSID)sidbuf) - 1);
+}
+
 NET_API_STATUS WINAPI
 NetUserGetInfo(LPCWSTR servername, LPCWSTR username, DWORD level,
                LPBYTE* bufptr)
@@ -1517,36 +1537,278 @@
       }
     case 2:
     case 3:
+    {
+        /* USER_INFO_2 and USER_INFO_3 share every field USER_INFO_2 has
+         * (3 adds only usri3_user_id, usri3_primary_group_id and
+         * usri3_password_expired at the end); build the USER_INFO_2 part
+         * from level 1, the same ground truth NetUserGetInfo already
+         * gives for 0/1/10, then append 3's extra fields in place when
+         * that's the level asked for. */
+        PUSER_INFO_2 ui;
+        PUSER_INFO_1 ui1;
+        WCHAR *p;
+        DWORD extra;
+        static const WCHAR empty[] = L"";
+        static const WCHAR any_server[] = L"\\\\*";
+
+        status = NetUserGetInfo(servername, username, 1, (LPBYTE *)&ui1);
+        if (status != NERR_Success) return status;
+
+        extra = (lstrlenW(ui1->usri1_name) + 1 + lstrlenW(ui1->usri1_home_dir) + 1 +
+                 lstrlenW(ui1->usri1_comment) + 1 + lstrlenW(ui1->usri1_script_path) + 1 +
+                 7 * 1 + lstrlenW(any_server) + 1) * sizeof(WCHAR);
+
+        if ((status = NetApiBufferAllocate((level == 3 ? sizeof(USER_INFO_3) : sizeof(USER_INFO_2)) + extra, (LPVOID *)bufptr)))
+        {
+            NetApiBufferFree(ui1);
+            return status;
+        }
+        ui = (PUSER_INFO_2) *bufptr;
+        p = (WCHAR *)((char *)*bufptr + (level == 3 ? sizeof(USER_INFO_3) : sizeof(USER_INFO_2)));
+
+#define APPEND(dst, src) do { (dst) = p; lstrcpyW(p, (src)); p += lstrlenW(src) + 1; } while (0)
+        APPEND(ui->usri2_name, ui1->usri1_name);
+        ui->usri2_password = NULL;  /* never returned, as on Windows */
+        ui->usri2_password_age = ui1->usri1_password_age;
+        ui->usri2_priv = ui1->usri1_priv;
+        APPEND(ui->usri2_home_dir, ui1->usri1_home_dir);
+        APPEND(ui->usri2_comment, ui1->usri1_comment);
+        ui->usri2_flags = ui1->usri1_flags;
+        APPEND(ui->usri2_script_path, ui1->usri1_script_path);
+        ui->usri2_auth_flags = 0;
+        APPEND(ui->usri2_full_name, empty);
+        APPEND(ui->usri2_usr_comment, empty);
+        APPEND(ui->usri2_parms, empty);
+        APPEND(ui->usri2_workstations, empty);
+        ui->usri2_last_logon = 0;
+        ui->usri2_last_logoff = 0;
+        ui->usri2_acct_expires = ~0u;       /* TIMEQ_FOREVER: never */
+        ui->usri2_max_storage = ~0u;        /* USER_MAXSTORAGE_UNLIMITED */
+        ui->usri2_units_per_week = 0;
+        ui->usri2_logon_hours = NULL;
+        ui->usri2_bad_pw_count = 0;
+        ui->usri2_num_logons = 0;
+        APPEND(ui->usri2_logon_server, any_server);
+        ui->usri2_country_code = 0;
+        ui->usri2_code_page = GetACP();
+        if (level == 3)
+        {
+            PUSER_INFO_3 ui3 = (PUSER_INFO_3)ui;
+            ui3->usri3_user_id = get_user_rid(username);
+            ui3->usri3_primary_group_id = 513;  /* DOMAIN_GROUP_RID_USERS */
+            APPEND(ui3->usri3_profile, empty);
+            APPEND(ui3->usri3_home_dir_drive, empty);
+            ui3->usri3_password_expired = FALSE;
+        }
+#undef APPEND
+        NetApiBufferFree(ui1);
+        break;
+    }
+
     case 4:
+    case 23:
+    {
+        /* USER_INFO_23 is USER_INFO_20 with a real SID instead of a user
+         * id; USER_INFO_4 is USER_INFO_3 the same way. Both need a SID:
+         * the real one for the current user (there is a real Unix/SG
+         * account and token to ask), else none -- a NetUserAdd'd test
+         * account here has no backing OS account for LookupAccountNameW
+         * to resolve. */
+        BYTE sidbuf[SECURITY_MAX_SID_SIZE];
+        WCHAR domain[MAX_COMPUTERNAME_LENGTH + 1];
+        DWORD sidsize = sizeof(sidbuf), domainsize = ARRAY_SIZE(domain);
+        SID_NAME_USE use;
+        BOOL have_sid = LookupAccountNameW(NULL, username, (PSID)sidbuf, &sidsize, domain, &domainsize, &use);
+#ifdef SG_MUTANT_NUI_NO_SID
+        have_sid = FALSE;
+#endif
+
+        if (level == 4)
+        {
+            /* USER_INFO_4 is not binary-compatible with USER_INFO_3 from
+             * usri4_user_sid on: a PSID is 8 bytes on a 64-bit build where
+             * usri3_user_id is a 4-byte DWORD, which shifts every field
+             * after it. Built straight from level 1 instead of copied out
+             * of a USER_INFO_3, so no such layout assumption is needed. */
+            PUSER_INFO_4 ui;
+            PUSER_INFO_1 ui1;
+            WCHAR *p;
+            DWORD extra, sid_len = have_sid ? GetLengthSid((PSID)sidbuf) : 0;
+            static const WCHAR empty[] = L"";
+            static const WCHAR any_server[] = L"\\\\*";
+
+            status = NetUserGetInfo(servername, username, 1, (LPBYTE *)&ui1);
+            if (status != NERR_Success) return status;
+
+            extra = (lstrlenW(ui1->usri1_name) + 1 + lstrlenW(ui1->usri1_home_dir) + 1 +
+                     lstrlenW(ui1->usri1_comment) + 1 + lstrlenW(ui1->usri1_script_path) + 1 +
+                     6 + lstrlenW(any_server) + 1) * sizeof(WCHAR) + sid_len;
+            if ((status = NetApiBufferAllocate(sizeof(USER_INFO_4) + extra, (LPVOID *)bufptr)))
+            {
+                NetApiBufferFree(ui1);
+                return status;
+            }
+            ui = (PUSER_INFO_4) *bufptr;
+            p = (WCHAR *)(ui + 1);
+#define APPEND(dst, src) do { (dst) = p; lstrcpyW(p, (src)); p += lstrlenW(src) + 1; } while (0)
+            APPEND(ui->usri4_name, ui1->usri1_name);
+            ui->usri4_password = NULL;
+            ui->usri4_password_age = ui1->usri1_password_age;
+            ui->usri4_priv = ui1->usri1_priv;
+            APPEND(ui->usri4_home_dir, ui1->usri1_home_dir);
+            APPEND(ui->usri4_comment, ui1->usri1_comment);
+            ui->usri4_flags = ui1->usri1_flags;
+            APPEND(ui->usri4_script_path, ui1->usri1_script_path);
+            ui->usri4_auth_flags = 0;
+            APPEND(ui->usri4_full_name, empty);
+            APPEND(ui->usri4_usr_comment, empty);
+            APPEND(ui->usri4_parms, empty);
+            APPEND(ui->usri4_workstations, empty);
+            ui->usri4_last_logon = 0;
+            ui->usri4_last_logoff = 0;
+            ui->usri4_acct_expires = ~0u;   /* TIMEQ_FOREVER */
+            ui->usri4_max_storage = ~0u;    /* USER_MAXSTORAGE_UNLIMITED */
+            ui->usri4_units_per_week = 0;
+            ui->usri4_logon_hours = NULL;
+            ui->usri4_bad_pw_count = 0;
+            ui->usri4_num_logons = 0;
+            APPEND(ui->usri4_logon_server, any_server);
+            ui->usri4_country_code = 0;
+#ifdef SG_MUTANT_NUI_L4_COPY
+            ui->usri4_code_page = 0;
+#else
+            ui->usri4_code_page = GetACP();
+#endif
+            ui->usri4_user_sid = NULL;
+            if (have_sid)
+            {
+                ui->usri4_user_sid = p;
+                CopySid(sid_len, ui->usri4_user_sid, (PSID)sidbuf);
+                p = (WCHAR *)((char *)p + sid_len);
+            }
+            ui->usri4_primary_group_id = 513;  /* DOMAIN_GROUP_RID_USERS */
+            APPEND(ui->usri4_profile, empty);
+            APPEND(ui->usri4_home_dir_drive, empty);
+            ui->usri4_password_expired = FALSE;
+#undef APPEND
+            NetApiBufferFree(ui1);
+        }
+        else
+        {
+            PUSER_INFO_23 ui;
+            PUSER_INFO_1 ui1;
+
+            status = NetUserGetInfo(servername, username, 1, (LPBYTE *)&ui1);
+            if (status != NERR_Success) return status;
+
+            if ((status = NetApiBufferAllocate(sizeof(USER_INFO_23) + (lstrlenW(ui1->usri1_name) + 1) * sizeof(WCHAR) +
+                                 1 * sizeof(WCHAR) + (have_sid ? GetLengthSid((PSID)sidbuf) : 0), (LPVOID *)bufptr)))
+            {
+                NetApiBufferFree(ui1);
+                return status;
+            }
+            ui = (PUSER_INFO_23) *bufptr;
+            ui->usri23_name = (LPWSTR)(ui + 1);
+            lstrcpyW(ui->usri23_name, ui1->usri1_name);
+            ui->usri23_full_name = ui->usri23_name + lstrlenW(ui1->usri1_name) + 1;
+            ui->usri23_full_name[0] = 0;
+            ui->usri23_comment = ui->usri23_full_name;  /* shares the same empty string */
+            ui->usri23_flags = ui1->usri1_flags;
+            ui->usri23_user_sid = NULL;
+            if (have_sid)
+            {
+                ui->usri23_user_sid = (PSID)(ui->usri23_full_name + 1);
+                CopySid(GetLengthSid((PSID)sidbuf), ui->usri23_user_sid, (PSID)sidbuf);
+            }
+            NetApiBufferFree(ui1);
+        }
+        break;
+    }
+
     case 11:
+    {
+        PUSER_INFO_11 ui;
+        PUSER_INFO_1 ui1;
+        WCHAR *p;
+        DWORD extra;
+        static const WCHAR empty[] = L"";
+        static const WCHAR any_server[] = L"\\\\*";
+
+        status = NetUserGetInfo(servername, username, 1, (LPBYTE *)&ui1);
+        if (status != NERR_Success) return status;
+
+        extra = (lstrlenW(ui1->usri1_name) + 1 + 3 * 1 + lstrlenW(ui1->usri1_home_dir) + 1 +
+                 1 + lstrlenW(any_server) + 1 + lstrlenW(ui1->usri1_comment) + 1) * sizeof(WCHAR);
+        if ((status = NetApiBufferAllocate(sizeof(USER_INFO_11) + extra, (LPVOID *)bufptr)))
+        {
+            NetApiBufferFree(ui1);
+            return status;
+        }
+        ui = (PUSER_INFO_11) *bufptr;
+        p = (WCHAR *)(ui + 1);
+#define APPEND(dst, src) do { (dst) = p; lstrcpyW(p, (src)); p += lstrlenW(src) + 1; } while (0)
+        APPEND(ui->usri11_name, ui1->usri1_name);
+        APPEND(ui->usri11_comment, ui1->usri1_comment);
+        APPEND(ui->usri11_usr_comment, empty);
+        APPEND(ui->usri11_full_name, empty);
+        ui->usri11_priv = ui1->usri1_priv;
+        ui->usri11_auth_flags = 0;
+        ui->usri11_password_age = ui1->usri1_password_age;
+        APPEND(ui->usri11_home_dir, ui1->usri1_home_dir);
+        APPEND(ui->usri11_parms, empty);
+        ui->usri11_last_logon = 0;
+        ui->usri11_last_logoff = 0;
+        ui->usri11_bad_pw_count = 0;
+        ui->usri11_num_logons = 0;
+        APPEND(ui->usri11_logon_server, any_server);
+        ui->usri11_country_code = 0;
+        ui->usri11_workstations = p;
+        *p++ = 0;
+        ui->usri11_max_storage = ~0u;
+        ui->usri11_units_per_week = 0;
+        ui->usri11_logon_hours = NULL;
+        ui->usri11_code_page = GetACP();
+#undef APPEND
+        NetApiBufferFree(ui1);
+        break;
+    }
+
     case 20:
-    case 23:
-    case 1003:
-    case 1005:
-    case 1006:
-    case 1007:
-    case 1008:
-    case 1009:
-    case 1010:
-    case 1011:
-    case 1012:
-    case 1013:
-    case 1014:
-    case 1017:
-    case 1018:
-    case 1020:
-    case 1023:
-    case 1024:
-    case 1025:
-    case 1051:
-    case 1052:
-    case 1053:
     {
-        FIXME("Level %ld is not implemented\n", level);
-        return NERR_InternalError;
+        PUSER_INFO_20 ui;
+        PUSER_INFO_1 ui1;
+
+        status = NetUserGetInfo(servername, username, 1, (LPBYTE *)&ui1);
+        if (status != NERR_Success) return status;
+
+        if ((status = NetApiBufferAllocate(sizeof(USER_INFO_20) + (lstrlenW(ui1->usri1_name) + 2) * sizeof(WCHAR),
+                             (LPVOID *)bufptr)))
+        {
+            NetApiBufferFree(ui1);
+            return status;
+        }
+        ui = (PUSER_INFO_20) *bufptr;
+        ui->usri20_name = (LPWSTR)(ui + 1);
+        lstrcpyW(ui->usri20_name, ui1->usri1_name);
+        ui->usri20_full_name = ui->usri20_name + lstrlenW(ui1->usri1_name) + 1;
+        ui->usri20_full_name[0] = 0;
+        ui->usri20_comment = ui->usri20_full_name;  /* shares the same empty string */
+        ui->usri20_flags = ui1->usri1_flags;
+        ui->usri20_user_id = get_user_rid(username);
+        NetApiBufferFree(ui1);
+        break;
     }
+
     default:
+        /* 1003, 1005-1053: USER_INFO_1003.. are NetUserSetInfo's
+         * single-field "parmnum" levels, not NetUserGetInfo's -- MSDN
+         * lists only 0, 1, 2, 3, 4, 10, 11, 20 and 23 as valid here.
+         * Windows itself answers ERROR_INVALID_LEVEL for all of them,
+         * not NERR_InternalError as this used to claim for most. */
         TRACE("Invalid level %ld is specified\n", level);
+#ifdef SG_MUTANT_NUI_LEVEL
+        if (level >= 1003 && level <= 1053) return NERR_InternalError;
+#endif
         return ERROR_INVALID_LEVEL;
     }
     return NERR_Success;
