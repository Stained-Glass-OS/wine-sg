     return hr;
 }
 
+/* the message carries a fault (an HTTP reply then has status 500) */
+HRESULT message_set_fault( WS_MESSAGE *handle )
+{
+    struct msg *msg = (struct msg *)handle;
+    BOOL isfault = TRUE;
+    HRESULT hr;
+
+    EnterCriticalSection( &msg->cs );
+    if (msg->magic != MSG_MAGIC) hr = E_INVALIDARG;
+    else hr = prop_set( msg->prop, msg->prop_count, WS_MESSAGE_PROPERTY_IS_FAULT, &isfault, sizeof(isfault) );
+    LeaveCriticalSection( &msg->cs );
+    return hr;
+}
+
 HRESULT message_get_id( WS_MESSAGE *handle, GUID *id )
 {
     struct msg *msg = (struct msg *)handle;
