From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] webservices: faults from errors, fault details, fault replies

WsCreateFaultFromError, WsSetFaultErrorDetail and WsSendFaultMessageForError were stubs. A fault is
made from the error's own fault or a generic one (reason: the error strings, else the code's text;
minimal disclosure: a generic text) in the error's language; the detail is written into the error's
fault with its action; WsSendFaultMessageForError answers a request with the fault (HTTP 500).
Also: a received fault made WsRequestReply/WsReceiveMessage return WS_E_INVALID_FORMAT instead of
WS_E_ENDPOINT_FAULT_RECEIVED; standard fault codes are mapped between SOAP 1.1 and 1.2 and other code
namespaces declared; the detail is written as the version's detail element and read in either form.
---
diff --git a/dlls/webservices/channel.c b/dlls/webservices/channel.c
index 20136c0..f72f5b7 100644
--- a/dlls/webservices/channel.c
+++ b/dlls/webservices/channel.c
@@ -1903,9 +1903,21 @@ HRESULT WINAPI WsSendMessage( WS_CHANNEL *handle, WS_MESSAGE *msg, const WS_MESS
     return set_error( error, WsSendMessage_impl( handle, msg, desc, option, body, size, ctx, error ) );
 }
 
+static HRESULT send_reply( WS_CHANNEL *handle, WS_MESSAGE *msg, WS_MESSAGE_INITIALIZATION init,
+                           const WS_MESSAGE_DESCRIPTION *desc, WS_WRITE_OPTION option, const void *body, ULONG size,
+                           WS_MESSAGE *request, const WS_ASYNC_CONTEXT *ctx );
+
 static HRESULT WsSendReplyMessage_impl( WS_CHANNEL *handle, WS_MESSAGE *msg, const WS_MESSAGE_DESCRIPTION *desc,
                                    WS_WRITE_OPTION option, const void *body, ULONG size, WS_MESSAGE *request,
                                    const WS_ASYNC_CONTEXT *ctx, WS_ERROR *error )
+{
+    TRACE( "%p %p %p %u %p %lu %p %p %p\n", handle, msg, desc, option, body, size, request, ctx, error );
+    return send_reply( handle, msg, WS_REPLY_MESSAGE, desc, option, body, size, request, ctx );
+}
+
+static HRESULT send_reply( WS_CHANNEL *handle, WS_MESSAGE *msg, WS_MESSAGE_INITIALIZATION init,
+                           const WS_MESSAGE_DESCRIPTION *desc, WS_WRITE_OPTION option, const void *body, ULONG size,
+                           WS_MESSAGE *request, const WS_ASYNC_CONTEXT *ctx )
 {
     struct channel *channel = (struct channel *)handle;
     WS_ASYNC_CONTEXT ctx_local;
@@ -1913,8 +1925,6 @@ static HRESULT WsSendReplyMessage_impl( WS_CHANNEL *handle, WS_MESSAGE *msg, con
     GUID id;
     HRESULT hr;
 
-    TRACE( "%p %p %p %u %p %lu %p %p %p\n", handle, msg, desc, option, body, size, request, ctx, error );
-
     if (!channel || !msg || !desc || !request) return E_INVALIDARG;
 
     EnterCriticalSection( &channel->cs );
@@ -1930,7 +1940,8 @@ static HRESULT WsSendReplyMessage_impl( WS_CHANNEL *handle, WS_MESSAGE *msg, con
         return hr;
     }
 
-    WsInitializeMessage( msg, WS_REPLY_MESSAGE, NULL, NULL );
+    WsInitializeMessage( msg, init, NULL, NULL );
+    if (init == WS_FAULT_MESSAGE && (hr = message_set_fault( msg )) != S_OK) goto done;
     if ((hr = message_get_id( request, &id )) != S_OK) goto done;
     if ((hr = message_set_request_id( msg, &id )) != S_OK) goto done;
 
@@ -1958,6 +1969,58 @@ HRESULT WINAPI WsSendReplyMessage( WS_CHANNEL *handle, WS_MESSAGE *msg, const WS
     return set_error( error, WsSendReplyMessage_impl( handle, msg, desc, option, body, size, request, ctx, error ) );
 }
 
+/**************************************************************************
+ *          WsSendFaultMessageForError		[webservices.@]
+ */
+HRESULT WINAPI WsSendFaultMessageForError( WS_CHANNEL *handle, WS_MESSAGE *reply, WS_ERROR *fault_error,
+                                           HRESULT code, WS_FAULT_DISCLOSURE disclosure, WS_MESSAGE *request,
+                                           WS_ERROR *error )
+{
+    static const WS_XML_STRING fault_name = {5, (BYTE *)"Fault"};
+    static const WS_XML_STRING soap11_ns = {41, (BYTE *)"http://schemas.xmlsoap.org/soap/envelope/"};
+    static const WS_XML_STRING soap12_ns = {39, (BYTE *)"http://www.w3.org/2003/05/soap-envelope"};
+    static const WS_XML_STRING fault_action10 = {47, (BYTE *)"http://www.w3.org/2005/08/addressing/soap/fault"};
+    static const WS_XML_STRING fault_action09 = {54, (BYTE *)"http://schemas.xmlsoap.org/ws/2004/08/addressing/fault"};
+    WS_ENVELOPE_VERSION env = WS_ENVELOPE_VERSION_SOAP_1_2;
+    WS_ADDRESSING_VERSION addr = WS_ADDRESSING_VERSION_1_0;
+    WS_FAULT_DESCRIPTION fault_desc;
+    WS_ELEMENT_DESCRIPTION body_desc;
+    WS_MESSAGE_DESCRIPTION msg_desc;
+    WS_XML_STRING action;
+    WS_FAULT fault;
+    WS_HEAP *heap;
+    HRESULT hr;
+
+    TRACE( "%p %p %p %#lx %u %p %p\n", handle, reply, fault_error, code, disclosure, request, error );
+
+    if (!handle || !reply || !fault_error || !request) return set_error( error, E_INVALIDARG );
+
+    if ((hr = WsCreateHeap( 1 << 16, 0, NULL, 0, &heap, NULL )) != S_OK) return set_error( error, hr );
+    if ((hr = WsCreateFaultFromError( fault_error, code, disclosure, heap, &fault )) != S_OK) goto done;
+
+    WsGetMessageProperty( reply, WS_MESSAGE_PROPERTY_ENVELOPE_VERSION, &env, sizeof(env), NULL );
+    WsGetMessageProperty( reply, WS_MESSAGE_PROPERTY_ADDRESSING_VERSION, &addr, sizeof(addr), NULL );
+    memset( &action, 0, sizeof(action) );
+    WsGetFaultErrorProperty( fault_error, WS_FAULT_ERROR_PROPERTY_ACTION, &action, sizeof(action) );
+    if (!action.length) action = addr == WS_ADDRESSING_VERSION_0_9 ? fault_action09 : fault_action10;
+
+    fault_desc.envelopeVersion   = env;
+    body_desc.elementLocalName   = (WS_XML_STRING *)&fault_name;
+    body_desc.elementNs          = (WS_XML_STRING *)(env == WS_ENVELOPE_VERSION_SOAP_1_1 ? &soap11_ns : &soap12_ns);
+    body_desc.type               = WS_FAULT_TYPE;
+    body_desc.typeDescription    = &fault_desc;
+    msg_desc.action                 = &action;
+    msg_desc.bodyElementDescription = &body_desc;
+
+    hr = send_reply( handle, reply, WS_FAULT_MESSAGE, &msg_desc, WS_WRITE_REQUIRED_VALUE, &fault, sizeof(fault),
+                     request, NULL );
+
+done:
+    WsFreeHeap( heap );
+    TRACE( "returning %#lx\n", hr );
+    return set_error( error, hr );
+}
+
 static HRESULT resize_read_buffer( struct channel *channel, ULONG size )
 {
     if (!channel->read_buf)
@@ -2471,6 +2534,8 @@ static HRESULT receive_message( struct channel *channel, WS_MESSAGE *msg, const
             if (index) *index = i;
             break;
         }
+        /* a fault answers whatever was expected: reported as such, the channel stays usable */
+        if (hr == WS_E_ENDPOINT_FAULT_RECEIVED) return hr;
         if ((hr = WsResetMessage( msg, NULL )) != S_OK) goto done;
         if ((hr = init_reader( channel )) != S_OK) goto done;
     }
