diff --git a/dlls/webservices/writer.c b/dlls/webservices/writer.c
index 51c7204..05aae55 100644
--- a/dlls/webservices/writer.c
+++ b/dlls/webservices/writer.c
@@ -4502,6 +4502,100 @@ static HRESULT write_fault_string_element( WS_XML_WRITER *writer, const WS_XML_S
     return WsWriteEndElement( writer, NULL );
 }
 
+static const WS_XML_STRING fault_soap11_ns = {41, (BYTE *)"http://schemas.xmlsoap.org/soap/envelope/"};
+static const WS_XML_STRING fault_soap12_ns = {39, (BYTE *)"http://www.w3.org/2003/05/soap-envelope"};
+
+static BOOL xml_string_is( const WS_XML_STRING *str, const char *value )
+{
+    return str->length == strlen( value ) && !memcmp( str->bytes, value, str->length );
+}
+
+/* a fault code QName for the given envelope version: the standard codes of the other SOAP version are mapped
+ * (SOAP 1.1 Client/Server are SOAP 1.2 Sender/Receiver), and a namespace that is not the envelope's is declared */
+static HRESULT write_fault_code_value( WS_XML_WRITER *writer, const WS_XML_QNAME *qname, WS_ENVELOPE_VERSION version )
+{
+    static const struct { const char *soap11, *soap12; } codes[] =
+    {
+        { "VersionMismatch", "VersionMismatch" },
+        { "MustUnderstand", "MustUnderstand" },
+        { "Client", "Sender" },
+        { "Server", "Receiver" },
+        { "Client", "DataEncodingUnknown" },
+    };
+    static const WS_XML_STRING code_prefix = {2, (BYTE *)"fc"};
+    const WS_XML_STRING *env_ns = version == WS_ENVELOPE_VERSION_SOAP_1_1 ? &fault_soap11_ns : &fault_soap12_ns;
+    const WS_XML_STRING *other_ns = version == WS_ENVELOPE_VERSION_SOAP_1_1 ? &fault_soap12_ns : &fault_soap11_ns;
+    WS_XML_QNAME mapped = *qname;
+    WS_XML_STRING name;
+    unsigned int i;
+    HRESULT hr;
+
+    if (WsXmlStringEquals( &qname->ns, other_ns, NULL ) == S_OK)
+    {
+        for (i = 0; i < ARRAY_SIZE(codes); i++)
+        {
+            const char *from = version == WS_ENVELOPE_VERSION_SOAP_1_1 ? codes[i].soap12 : codes[i].soap11;
+            const char *to = version == WS_ENVELOPE_VERSION_SOAP_1_1 ? codes[i].soap11 : codes[i].soap12;
+
+            if (!xml_string_is( &qname->localName, from )) continue;
+            name.length = strlen( to );
+            name.bytes = (BYTE *)to;
+            name.dictionary = NULL;
+            name.id = 0;
+            mapped.localName = name;
+            mapped.ns = *env_ns;
+            break;
+        }
+    }
+    if (mapped.ns.length && WsXmlStringEquals( &mapped.ns, env_ns, NULL ) != S_OK &&
+        (hr = WsWriteXmlnsAttribute( writer, &code_prefix, &mapped.ns, FALSE, NULL )) != S_OK) return hr;
+    return WsWriteType( writer, WS_ELEMENT_CONTENT_TYPE_MAPPING, WS_XML_QNAME_TYPE, NULL, WS_WRITE_REQUIRED_VALUE,
+                        &mapped, sizeof(mapped), NULL );
+}
+
+/* the fault detail: the stored buffer holds a detail element; it is written as the version's detail element
+ * (SOAP 1.1 "detail" without a namespace, SOAP 1.2 "Detail" in the envelope namespace) with its children */
+static HRESULT write_fault_detail( WS_XML_WRITER *writer, WS_XML_BUFFER *detail, WS_ENVELOPE_VERSION version )
+{
+    static const WS_XML_STRING detail11 = {6, (BYTE *)"detail"}, detail12 = {6, (BYTE *)"Detail"};
+    const WS_XML_STRING *name = version == WS_ENVELOPE_VERSION_SOAP_1_1 ? &detail11 : &detail12;
+    const WS_XML_STRING *ns = version == WS_ENVELOPE_VERSION_SOAP_1_1 ? &soap11_empty_ns : &fault_soap12_ns;
+    const WS_XML_ELEMENT_NODE *elem;
