+
+/* the reason text of a fault made from an error object: its strings (oldest first), else the text of the
+ * failure code; with minimal disclosure a generic text only */
+static HRESULT fault_reason_text( struct error *error, HRESULT code, WS_FAULT_DISCLOSURE disclosure,
+                                  WS_HEAP *heap, WS_STRING *text )
+{
+    static const WCHAR generic[] = L"The server was unable to process the request.";
+    WCHAR buf[256], *dst;
+    const WCHAR *src = generic;
+    ULONG i, len = 0;
+
+#ifdef SG_MUTANT_WSFAULT_NO_STRINGS
+    if (0)
+#else
+    if (disclosure == WS_FULL_FAULT_DISCLOSURE && error->strs_count)
+#endif
+    {
+        for (i = 0; i < error->strs_count; i++) len += error->strs[i].length + (i ? 1 : 0);
+        if (!(dst = ws_alloc( heap, len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        text->chars = dst;
+        text->length = len;
+        for (i = 0; i < error->strs_count; i++)
+        {
+            if (i) *dst++ = ' ';
+            memcpy( dst, error->strs[i].chars, error->strs[i].length * sizeof(WCHAR) );
+            dst += error->strs[i].length;
+        }
+        return S_OK;
+    }
+    if (disclosure == WS_FULL_FAULT_DISCLOSURE)
+    {
+        buf[0] = 0;
+        for (i = 0; i < ARRAY_SIZE(error_texts); i++)
+            if (error_texts[i].hr == code) { lstrcpynW( buf, error_texts[i].text, ARRAY_SIZE(buf) ); break; }
+        if (!buf[0])
+        {
+            DWORD n = FormatMessageW( FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL,
+                                      HRESULT_CODE(code), 0, buf, ARRAY_SIZE(buf), NULL );
+            while (n && (buf[n - 1] == '\r' || buf[n - 1] == '\n' || buf[n - 1] == ' ')) buf[--n] = 0;
+            if (!n) swprintf( buf, ARRAY_SIZE(buf), L"The operation failed with error %#lx.", (ULONG)code );
+        }
+        src = buf;
+    }
+    len = wcslen( src );
+    if (!(text->chars = ws_alloc( heap, len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( text->chars, src, len * sizeof(WCHAR) );
+    text->length = len;
+    return S_OK;
+}
+
+/**************************************************************************
+ *          WsCreateFaultFromError		[webservices.@]
+ */
+HRESULT WINAPI WsCreateFaultFromError( WS_ERROR *handle, HRESULT code, WS_FAULT_DISCLOSURE disclosure,
+                                       WS_HEAP *heap, WS_FAULT *ret )
+{
+    static const WS_XML_STRING receiver = {8, (BYTE *)"Receiver"};
+    static const WS_XML_STRING soap12_ns = {39, (BYTE *)"http://www.w3.org/2003/05/soap-envelope"};
+    struct error *error = (struct error *)handle;
+    WCHAR lang[LOCALE_NAME_MAX_LENGTH];
+    WS_FAULT *fault = NULL;
+    LANGID langid;
+    HRESULT hr = S_OK;
+    int len;
+
+    TRACE( "%p %#lx %u %p %p\n", handle, code, disclosure, heap, ret );
+
+    if (!error || !heap || !ret || SUCCEEDED(code)) return E_INVALIDARG;
+    if (disclosure != WS_MINIMAL_FAULT_DISCLOSURE && disclosure != WS_FULL_FAULT_DISCLOSURE) return E_INVALIDARG;
+
+    EnterCriticalSection( &error->cs );
+
+    if (error->magic != ERROR_MAGIC)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    /* the fault the error object carries, else a generic one */
+    if (error->fault) fault = dup_fault( heap, error->fault );
+    else fault = ws_alloc_zero( heap, sizeof(*fault) );
+    if (!fault)
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (!fault->code)
+    {
+        /* a generic code, for the receiver (a fault set through its detail alone has none) */
+        if (!(fault->code = ws_alloc_zero( heap, sizeof(*fault->code) )) ||
+            !copy_xml_string( heap, &receiver, &fault->code->value.localName ) ||
+            !copy_xml_string( heap, &soap12_ns, &fault->code->value.ns ))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+    }
+
+    if (!fault->reasonCount)
+    {
+        if (!(fault->reasons = ws_alloc_zero( heap, sizeof(*fault->reasons) ))) { hr = E_OUTOFMEMORY; goto done; }
+        fault->reasonCount = 1;
+        if ((hr = fault_reason_text( error, code, disclosure, heap, &fault->reasons[0].text )) != S_OK) goto done;
+
+        prop_get( error->prop, error->prop_count, WS_ERROR_PROPERTY_LANGID, &langid, sizeof(langid) );
+        if (!(len = LCIDToLocaleName( MAKELCID( langid, SORT_DEFAULT ), lang, ARRAY_SIZE(lang), 0 )))
+            len = LCIDToLocaleName( LOCALE_USER_DEFAULT, lang, ARRAY_SIZE(lang), 0 );
+        if (len > 1)
+        {
+            if (!(fault->reasons[0].lang.chars = ws_alloc( heap, (len - 1) * sizeof(WCHAR) )))
+            {
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+            memcpy( fault->reasons[0].lang.chars, lang, (len - 1) * sizeof(WCHAR) );
+            fault->reasons[0].lang.length = len - 1;
+        }
+    }
+
+    *ret = *fault;
+    ws_free( heap, fault, sizeof(*fault) );
+    fault = NULL;
+
+done:
+    if (fault) free_fault( heap, fault );
+    LeaveCriticalSection( &error->cs );
+    TRACE( "returning %#lx\n", hr );
+    return hr;
+}
+
+/**************************************************************************
+ *          WsSetFaultErrorDetail		[webservices.@]
+ */
+HRESULT WINAPI WsSetFaultErrorDetail( WS_ERROR *handle, const WS_FAULT_DETAIL_DESCRIPTION *desc,
+                                      WS_WRITE_OPTION option, const void *value, ULONG size )
+{
+    static const WS_XML_STRING detail = {6, (BYTE *)"detail"}, empty_ns = {0, NULL};
+    struct error *error = (struct error *)handle;
+    const WS_ELEMENT_DESCRIPTION *elem;
+    WS_XML_WRITER *writer = NULL;
+    WS_XML_BUFFER *buffer = NULL;
+    struct xmlbuf *src, *copy;
+    WS_HEAP *heap = NULL;
+    HRESULT hr;
+
+    TRACE( "%p %p %u %p %lu\n", handle, desc, option, value, size );
+
+    if (!error || !desc || !(elem = desc->detailElementDescription)) return E_INVALIDARG;
+    /* several elements as one value: a structure, written as a value or through a pointer */
+    if (!elem->elementLocalName && (elem->type != WS_STRUCT_TYPE ||
+        (option != WS_WRITE_REQUIRED_VALUE && option != WS_WRITE_REQUIRED_POINTER)))
+        return E_INVALIDARG;
+
+    if ((hr = WsCreateHeap( 1 << 16, 0, NULL, 0, &heap, NULL )) != S_OK) return hr;
+    if ((hr = WsCreateXmlBuffer( heap, NULL, 0, &buffer, NULL )) != S_OK) goto done;
+    if ((hr = WsCreateWriter( NULL, 0, &writer, NULL )) != S_OK) goto done;
+    if ((hr = WsSetOutputToBuffer( writer, buffer, NULL, 0, NULL )) != S_OK) goto done;
+    if ((hr = WsWriteStartElement( writer, NULL, &detail, &empty_ns, NULL )) != S_OK) goto done;
+    if (elem->elementLocalName)
+        hr = WsWriteElement( writer, elem, option, value, size, NULL );
+    else
+        hr = WsWriteType( writer, WS_ELEMENT_CONTENT_TYPE_MAPPING, elem->type, elem->typeDescription, option,
+                          value, size, NULL );
+    if (hr != S_OK) goto done;
+    if ((hr = WsWriteEndElement( writer, NULL )) != S_OK) goto done;
+
+    EnterCriticalSection( &error->cs );
+    if (error->magic != ERROR_MAGIC) hr = E_INVALIDARG;
+    else if (!error->fault && !(error->fault = ws_alloc_zero( error->heap, sizeof(*error->fault) )))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        src = (struct xmlbuf *)buffer;
+        if (!(copy = alloc_xmlbuf( error->heap, src->bytes.length, src->encoding, src->charset, src->dict_static,
+                                   src->dict ))) hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy( copy->bytes.bytes, src->bytes.bytes, src->bytes.length );
+            copy->bytes.length = src->bytes.length;
+#ifdef SG_MUTANT_WSFAULT_NO_DETAIL
+            free_xmlbuf( copy );
+#else
+            free_xmlbuf( (struct xmlbuf *)error->fault->detail );
+            error->fault->detail = (WS_XML_BUFFER *)copy;
+#endif
+            if (desc->action) hr = set_action( error, desc->action );
+        }
+    }
+    LeaveCriticalSection( &error->cs );
+
+done:
+    WsFreeWriter( writer );
+    WsFreeHeap( heap );
+    TRACE( "returning %#lx\n", hr );
+    return hr;
+}
