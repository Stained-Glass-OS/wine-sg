From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server: the users' read and execute is every account's

A descriptor granting BUILTIN\Users (or Authenticated Users, Interactive) read and execute mapped to the group's bits only, and the folder's group is its maker's unless the users' write made it the users' group: CCleaner's folders, set by its elevated installer to SYSTEM, Administrators and Users (read, execute), ended 0750 with group sgsystem, and no user could run or uninstall it. The users' read and execute now also sets the others' bits; their write stays the group's.
---
diff --git a/server/file.c b/server/file.c
index 563f3e1..63f2f88 100644
--- a/server/file.c
+++ b/server/file.c
@@ -614,6 +614,9 @@ mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner
                     else if (sg_is_users_sid( sid ))
                     {
                         bits_to_set &= ~(mode << 3);  /* the users: the group */
+#ifndef SG_MUTANT_USERS_READ_GROUP_ONLY
+                        bits_to_set &= ~(mode & (S_IROTH | S_IXOTH));  /* and every account's read */
+#endif
                     }
                     else if (token_sid_present( current->process->token, owner, TRUE ) &&
                              token_sid_present( current->process->token, sid, TRUE ))
@@ -634,6 +637,20 @@ mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner
                     }
                     else if (sg_is_users_sid( sid ))
                     {
+#ifndef SG_MUTANT_USERS_READ_GROUP_ONLY
+                        /* Stained Glass OS: the users' read and execute is
+                         * every account's (others): a folder's group is its
+                         * maker's unless the users' write made it sgwine, and
+                         * a descriptor of SYSTEM, Administrators and Users
+                         * (read, execute) -- an installer's own, Inno
+                         * [Permissions], SetSecurityInfo -- left 0750 with
+                         * group sgsystem: no user could open CCleaner's
+                         * folder, run it or uninstall it. Write stays the
+                         * group's, as before. */
+                        mode_t others = mode & (S_IROTH | S_IXOTH);
+                        new_mode |= others & bits_to_set;
+                        bits_to_set &= ~others;
+#endif
                         mode = mode << 3;  /* the users: the group */
                         if (mode & bits_to_set & S_IWGRP) sg_users_granted = 1;
                         new_mode |= mode & bits_to_set;
