From: Stained Glass OS <dev@stained-glass.example>
Subject: sppc: a store for installed licenses and product keys

Office's installer (Click-to-Run's integrator.exe /I /License) installs its
license files with SLInstallLicense, which sppc did not export: the
integrator aborted on the unimplemented function and Office stopped with
error 30015-11 ("Licenses Installation", 0x80000100).

SLInstallLicense / SLUninstallLicense and SLInstallProofOfPurchase /
SLUninstallProofOfPurchase keep what is installed, as it was given, in
%SystemRoot%\System32\spp\sg-store (licenses\, keys\), under an identifier
made from the content -- installing the same license again gives the same
one -- and remove it; removing what is not there answers
SL_E_LICENSE_FILE_NOT_INSTALLED / SL_E_PKEY_NOT_INSTALLED. SLGetSLIDList
finds nothing (the store does not read what licenses grant).

Nothing here grants a right or activates anything: the licensing status
(SLGetLicensingStatusInformation) is unchanged, and a product's own
licensing (Office's is its account sign-in) decides.

Gate: test/sppc-gate.sh.
---
--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -39,6 +39,128 @@
     return SL_E_RIGHT_NOT_CONSUMED;
 }
 
+/* Stained Glass OS: a store for the licenses and product keys programs
+ * install -- Office's installer (Click-to-Run's integrator.exe) installs its
+ * license files as it integrates, and stopped with 30015-11 when
+ * SLInstallLicense was missing. What is installed is kept, as it was given,
+ * in %SystemRoot%\System32\spp\sg-store (licenses\ and keys\), under an
+ * identifier made from its content, so installing it again gives the same
+ * one; uninstalling removes it. Nothing here grants a right or activates a
+ * product: the licensing status stays what it was (SLGetLicensingStatus-
+ * Information), and a product's own licensing decides. */
+static BOOL store_dir(const WCHAR *kind, WCHAR *dir)
+{
+    if (!GetSystemDirectoryW(dir, MAX_PATH - 40)) return FALSE;
+    lstrcatW(dir, L"\\spp");
+    CreateDirectoryW(dir, NULL);
+    lstrcatW(dir, L"\\sg-store");
+    CreateDirectoryW(dir, NULL);
+    lstrcatW(dir, L"\\");
+    lstrcatW(dir, kind);
+    CreateDirectoryW(dir, NULL);
+    return TRUE;
+}
+
+/* an identifier from the content: two 64-bit FNV-1a hashes, as a GUID */
+static void content_id(const BYTE *data, UINT size, SLID *id)
+{
+    ULONGLONG a = 0xcbf29ce484222325ull, b = 0x84222325cbf29ce4ull;
+    UINT i;
+
+    for (i = 0; i < size; i++)
+    {
+        a = (a ^ data[i]) * 0x100000001b3ull;
+        b = (b ^ data[size - 1 - i]) * 0x100000001b3ull;
+    }
+    id->Data1 = (DWORD)a;
+    id->Data2 = (WORD)(a >> 32);
+    id->Data3 = (WORD)(((a >> 48) & 0x0fff) | 0x5000);   /* a name-based GUID's version */
+    for (i = 0; i < 8; i++) id->Data4[i] = (BYTE)(b >> (8 * i));
+    id->Data4[0] = (id->Data4[0] & 0x3f) | 0x80;
+}
+
+static BOOL item_path(const WCHAR *kind, const SLID *id, WCHAR *path)
+{
+    WCHAR dir[MAX_PATH];
+
+    if (!store_dir(kind, dir)) return FALSE;
+    swprintf(path, MAX_PATH, L"%s\\{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", dir, id->Data1, id->Data2,
+             id->Data3, id->Data4[0], id->Data4[1], id->Data4[2], id->Data4[3], id->Data4[4], id->Data4[5],
+             id->Data4[6], id->Data4[7]);
+    return TRUE;
+}
+
+static HRESULT store_put(const WCHAR *kind, const BYTE *data, UINT size, SLID *id)
+{
+    WCHAR path[MAX_PATH];
+    HANDLE file;
+    DWORD written;
+    BOOL ok;
+
+    content_id(data, size, id);
+    if (!item_path(kind, id, path)) return HRESULT_FROM_WIN32(GetLastError());
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+    ok = WriteFile(file, data, size, &written, NULL) && written == size;
+    CloseHandle(file);
+    if (!ok) { DeleteFileW(path); return E_FAIL; }
+    return S_OK;
+}
+
+static HRESULT store_remove(const WCHAR *kind, const SLID *id, HRESULT missing)
+{
+    WCHAR path[MAX_PATH];
+
+    if (!item_path(kind, id, path)) return HRESULT_FROM_WIN32(GetLastError());
+    if (DeleteFileW(path)) return S_OK;
+    return GetLastError() == ERROR_FILE_NOT_FOUND ? missing : HRESULT_FROM_WIN32(GetLastError());
+}
+
+HRESULT WINAPI SLInstallLicense(HSLC handle, UINT size, const BYTE *blob, SLID *id)
+{
+    HRESULT hr;
+
+    TRACE("(%p %u %p %p)\n", handle, size, blob, id);
+    if (!handle || !size || !blob || !id) return E_INVALIDARG;
+    hr = store_put(L"licenses", blob, size, id);
+    TRACE("license %s: %#lx\n", debugstr_guid(id), hr);
+    return hr;
+}
+
+HRESULT WINAPI SLUninstallLicense(HSLC handle, const SLID *id)
+{
+    TRACE("(%p %s)\n", handle, debugstr_guid(id));
+    if (!handle || !id) return E_INVALIDARG;
+    return store_remove(L"licenses", id, SL_E_LICENSE_FILE_NOT_INSTALLED);
+}
+
+HRESULT WINAPI SLInstallProofOfPurchase(HSLC handle, const WCHAR *algorithm, const WCHAR *key, UINT size,
+                                        BYTE *data, SLID *id)
+{
+    TRACE("(%p %s (key) %u %p %p)\n", handle, debugstr_w(algorithm), size, data, id);
+    if (!handle || !key || !*key || !id) return E_INVALIDARG;
+    /* the key as it was given; it is not checked here */
+    return store_put(L"keys", (const BYTE *)key, lstrlenW(key) * sizeof(WCHAR), id);
+}
+
+HRESULT WINAPI SLUninstallProofOfPurchase(HSLC handle, const SLID *id)
+{
+    TRACE("(%p %s)\n", handle, debugstr_guid(id));
+    if (!handle || !id) return E_INVALIDARG;
+    return store_remove(L"keys", id, SL_E_PKEY_NOT_INSTALLED);
+}
+
+HRESULT WINAPI SLGetSLIDList(HSLC handle, SLIDTYPE query_type, const SLID *query, SLIDTYPE return_type,
+                             UINT *count, SLID **ids)
+{
+    FIXME("(%p %u %s %u %p %p) semi-stub\n", handle, query_type, debugstr_guid(query), return_type, count, ids);
+    if (!handle || !count || !ids) return E_INVALIDARG;
+    /* the store does not read what the licenses grant: nothing is found */
+    *count = 0;
+    *ids = NULL;
+    return SL_E_VALUE_NOT_FOUND;
+}
+
 HRESULT WINAPI SLOpen(HSLC *handle)
 {
     FIXME("(%p) stub\n", handle );
