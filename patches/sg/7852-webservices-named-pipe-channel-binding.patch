+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * A net.pipe endpoint is found as WCF's NetNamedPipeBinding finds one, so that either side may
+ * be WCF (the scheme is in WCF's MIT-licensed sources, PipeConnectionInitiator.cs): the service
+ * publishes a named file mapping whose name is built from its URL, holding a "set" flag (byte 0)
+ * and the GUID (offset 4) that names its pipe, \\.\pipe\<guid>. The mapping's name is
+ * "Global\" or "Local\", then "net.pipe:E" and the base64 of the UTF-8 of
+ * "net.pipe://" + HOST + PATH -- HOST "+" (any host name, as a service registers by default),
+ * the client's host name or "*", PATH the URL's path in upper case ending in "/" -- or, for 128
+ * bytes or more, "net.pipe:H" and the base64 of its SHA-256 (SHA-1 in older .NET). A client tries
+ * the hosts in that order, Global before Local, from its URL's path up to "/". The bytes on the
+ * pipe are the .NET message framing a net.tcp session sends (channel.c).
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "bcrypt.h"
+#include "webservices.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "webservices_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(webservices);
+
+#define PIPE_PREFIX L"\\\\.\\pipe\\"
+
+#ifndef PIPE_REJECT_REMOTE_CLIENTS
+#define PIPE_REJECT_REMOTE_CLIENTS 0x00000008
+#endif
+
+struct pipe_contents
+{
+    BYTE set;
+    BYTE pad[3];
+    GUID guid;
+};
+
+static char *base64( const BYTE *data, ULONG len )
+{
+    static const char tab[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    char *ret, *p;
+    ULONG i;
+
+    if (!(ret = p = malloc( (len + 2) / 3 * 4 + 1 ))) return NULL;
+    for (i = 0; i + 2 < len; i += 3)
+    {
+        *p++ = tab[data[i] >> 2];
+        *p++ = tab[((data[i] & 3) << 4) | (data[i + 1] >> 4)];
+        *p++ = tab[((data[i + 1] & 15) << 2) | (data[i + 2] >> 6)];
+        *p++ = tab[data[i + 2] & 63];
+    }
+    if (i < len)
+    {
+        *p++ = tab[data[i] >> 2];
+        if (i + 1 < len)
+        {
+            *p++ = tab[((data[i] & 3) << 4) | (data[i + 1] >> 4)];
+            *p++ = tab[(data[i + 1] & 15) << 2];
+        }
+        else
+        {
+            *p++ = tab[(data[i] & 3) << 4];
+            *p++ = '=';
+        }
+        *p++ = '=';
+    }
+    *p = 0;
+    return ret;
+}
+
+static WCHAR *upper( const WCHAR *str, ULONG len )
+{
+    WCHAR *ret;
+    int n;
+
+    if (!(ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    n = len ? LCMapStringEx( LOCALE_NAME_INVARIANT, LCMAP_UPPERCASE, str, len, ret, len, NULL, NULL, 0 ) : 0;
+    ret[n] = 0;
+    return ret;
+}
+
+/* "Global\net.pipe:E..." for HOST and PATH (both upper case already) */
+static WCHAR *mapping_name( const WCHAR *host, const WCHAR *path, BOOL global, BOOL sha1 )
+{
+    WCHAR *canon, *ret = NULL;
+    char *utf8 = NULL, *b64 = NULL;
+    BYTE hash[32];
+    ULONG len, hash_len;
+    int n;
+
+    len = wcslen( L"net.pipe://" ) + wcslen( host ) + wcslen( path ) + 1;
+    if (!(canon = malloc( len * sizeof(WCHAR) ))) return NULL;
+    wcscpy( canon, L"net.pipe://" );
+    wcscat( canon, host );
+    wcscat( canon, path );
+    n = WideCharToMultiByte( CP_UTF8, 0, canon, -1, NULL, 0, NULL, NULL ) - 1;
+    if (n < 0 || !(utf8 = malloc( n + 1 ))) goto done;
+    WideCharToMultiByte( CP_UTF8, 0, canon, -1, utf8, n + 1, NULL, NULL );
+
+    if (n >= 128)
+    {
+        hash_len = sha1 ? 20 : 32;
+        if (BCryptHash( sha1 ? BCRYPT_SHA1_ALG_HANDLE : BCRYPT_SHA256_ALG_HANDLE, NULL, 0, (UCHAR *)utf8, n,
+                        hash, hash_len )) goto done;
+        b64 = base64( hash, hash_len );
+    }
+    else b64 = base64( (const BYTE *)utf8, n );
+    if (!b64) goto done;
+
+    len = strlen( b64 ) + 32;
+    if (!(ret = malloc( len * sizeof(WCHAR) ))) goto done;
+    swprintf( ret, len, L"%s%s%S", global ? L"Global\\" : L"Local\\", n >= 128 ? L"net.pipe:H" : L"net.pipe:E", b64 );
+
+done:
+    free( canon );
+    free( utf8 );
+    free( b64 );
+    return ret;
+}
+
+/* the URL's host (upper case) and path (upper case, ending in "/") */
+static HRESULT split_url( const WS_STRING *url, WCHAR **host, WCHAR **path )
+{
+    WS_HEAP *heap;
+    WS_URL *decoded;
+    WS_NETPIPE_URL *pipe;
+    HRESULT hr;
+    ULONG len;
+
+    *host = *path = NULL;
+    if ((hr = WsCreateHeap( 1 << 16, 0, NULL, 0, &heap, NULL )) != S_OK) return hr;
+    if ((hr = WsDecodeUrl( url, 0, heap, &decoded, NULL )) != S_OK) goto done;
+    if (decoded->scheme != WS_URL_NETPIPE_SCHEME_TYPE)
+    {
+        hr = WS_E_INVALID_ENDPOINT_URL;
+        goto done;
+    }
+    pipe = (WS_NETPIPE_URL *)decoded;
+    len = pipe->path.length;
+    *host = upper( pipe->host.chars, pipe->host.length );
+    if ((*path = malloc( (len + 3) * sizeof(WCHAR) )))
+    {
+        WCHAR *up = upper( pipe->path.chars, len );
+        if (up)
+        {
+            (*path)[0] = 0;
+            if (!len || up[0] != '/') wcscat( *path, L"/" );
+            wcscat( *path, up );
+            len = wcslen( *path );
+            if ((*path)[len - 1] != '/') wcscat( *path, L"/" );
+            free( up );
+        }
+        else
+        {
+            free( *path );
+            *path = NULL;
+        }
+    }
+    if (!*host || !*path)
+    {
+        free( *host );
+        free( *path );
+        *host = *path = NULL;
+        hr = E_OUTOFMEMORY;
+    }
+
+done:
+    WsFreeHeap( heap );
+    return hr;
+}
+
+static WCHAR *pipe_name_from_guid( const GUID *guid )
+{
+    WCHAR *ret = malloc( (ARRAY_SIZE(PIPE_PREFIX) + 37) * sizeof(WCHAR) );
+    if (!ret) return NULL;
+    swprintf( ret, ARRAY_SIZE(PIPE_PREFIX) + 37, PIPE_PREFIX L"%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+              guid->Data1, guid->Data2, guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2],
+              guid->Data4[3], guid->Data4[4], guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+    return ret;
+}
+
+static WCHAR *read_mapping( const WCHAR *name )
+{
+    struct pipe_contents *contents;
+    WCHAR *ret = NULL;
+    HANDLE mapping;
+
+    if (!(mapping = OpenFileMappingW( FILE_MAP_READ, FALSE, name ))) return NULL;
+    if ((contents = MapViewOfFile( mapping, FILE_MAP_READ, 0, 0, sizeof(*contents) )))
+    {
+        if (contents->set) ret = pipe_name_from_guid( &contents->guid );
+        UnmapViewOfFile( contents );
+    }
+    CloseHandle( mapping );
+    TRACE( "%s -> %s\n", debugstr_w(name), debugstr_w(ret) );
+    return ret;
+}
+
+/* the pipe of the service at URL, as a WCF client finds it */
+HRESULT pipe_find( const WS_STRING *url, WCHAR **ret )
+{
+    WCHAR *host, *path, *name, *found = NULL;
+    const WCHAR *hosts[3];
+    ULONG h, g, s, len;
+    HRESULT hr;
+
+    *ret = NULL;
+    if ((hr = split_url( url, &host, &path )) != S_OK) return hr;
+    hosts[0] = L"+";
+    hosts[1] = host;
+    hosts[2] = L"*";
+    for (h = 0; h < ARRAY_SIZE(hosts) && !found; h++)
+    {
+        for (g = 0; g < 2 && !found; g++)
+        {
+            len = wcslen( path );
+            while (len && !found)
+            {
+                path[len] = 0;
+                for (s = 0; s < 2 && !found; s++)
+                {
+                    if (!(name = mapping_name( hosts[h], path, !g, s ))) continue;
+                    found = read_mapping( name );
+                    free( name );
+                }
+                /* up to the parent path: "/A/B/" -> "/A/" */
+                if (len == 1) break;
+                len--;
+                while (len && path[len - 1] != '/') len--;
+            }
+        }
+    }
+    free( host );
+    free( path );
+    if (!found) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    *ret = found;
+    return S_OK;
+}
+
+/* a service at URL: its pipe's name published (Global if it may, else Local), as WCF's is */
+HRESULT pipe_publish( const WS_STRING *url, HANDLE *mapping, WCHAR **pipe_name )
+{
+    struct pipe_contents *contents;
+    WCHAR *host, *path, *name;
+    GUID guid;
+    HRESULT hr;
+    int g;
+
+    *mapping = NULL;
+    *pipe_name = NULL;
+    if ((hr = split_url( url, &host, &path )) != S_OK) return hr;
+    free( host );
+    UuidCreate( &guid );
+    hr = HRESULT_FROM_WIN32( ERROR_ACCESS_DENIED );
+    for (g = 0; g < 2 && !*mapping; g++)
+    {
+        if (!(name = mapping_name( L"+", path, !g, FALSE )))
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        SetLastError( 0 );
+        *mapping = CreateFileMappingW( INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(*contents), name );
+        if (*mapping && GetLastError() == ERROR_ALREADY_EXISTS)
+        {
+            /* another service has this address */
+            CloseHandle( *mapping );
+            *mapping = NULL;
+            hr = HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+            free( name );
+            break;
+        }
+        TRACE( "%s: %p\n", debugstr_w(name), *mapping );
+        free( name );
+    }
+    free( path );
+    if (!*mapping) return hr;
+
+    if (!(contents = MapViewOfFile( *mapping, FILE_MAP_WRITE, 0, 0, sizeof(*contents) )) ||
+        !(*pipe_name = pipe_name_from_guid( &guid )))
+    {
+        if (contents) UnmapViewOfFile( contents );
+        CloseHandle( *mapping );
+        *mapping = NULL;
+        return E_OUTOFMEMORY;
+    }
+    contents->guid = guid;
+    contents->set = 1;
+    UnmapViewOfFile( contents );
+    return S_OK;
+}
+
+/* an instance of the service's pipe, local clients only */
+HANDLE pipe_create_instance( const WCHAR *name, BOOL first )
+{
+    return CreateNamedPipeW( name, PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | (first ? FILE_FLAG_FIRST_PIPE_INSTANCE : 0),
+                             PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+                             PIPE_UNLIMITED_INSTANCES, 0x10000, 0x10000, 0, NULL );
+}
+
+static HRESULT wait_io( HANDLE pipe, OVERLAPPED *ov, HANDLE cancel, DWORD *count )
+{
+    HANDLE handles[2] = { ov->hEvent, cancel };
+    DWORD ret = WaitForMultipleObjects( cancel ? 2 : 1, handles, FALSE, INFINITE );
+
+    if (ret != WAIT_OBJECT_0)
+    {
+        CancelIoEx( pipe, ov );
+        GetOverlappedResult( pipe, ov, count, TRUE );
+        return WS_E_OPERATION_ABORTED;
+    }
+    if (GetOverlappedResult( pipe, ov, count, FALSE )) return S_OK;
+    return HRESULT_FROM_WIN32( GetLastError() );
+}
+
+/* a client connected to the instance (or WS_E_OPERATION_ABORTED: CANCEL signaled) */
+HRESULT pipe_accept( HANDLE pipe, HANDLE cancel )
+{
+    OVERLAPPED ov = {0};
+    DWORD count;
+    HRESULT hr;
+
+    if (!(ov.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL ))) return HRESULT_FROM_WIN32( GetLastError() );
+    if (ConnectNamedPipe( pipe, &ov )) hr = S_OK;
+    else if (GetLastError() == ERROR_PIPE_CONNECTED) hr = S_OK;
+    else if (GetLastError() == ERROR_IO_PENDING) hr = wait_io( pipe, &ov, cancel, &count );
+    else hr = HRESULT_FROM_WIN32( GetLastError() );
+    CloseHandle( ov.hEvent );
+    return hr;
+}
+
+/* the client's end, its pipe found from URL */
+HRESULT pipe_open( const WS_STRING *url, HANDLE *ret )
+{
+    DWORD mode = PIPE_READMODE_MESSAGE;
+    WCHAR *name;
+    HRESULT hr;
+    int tries;
+
+    *ret = INVALID_HANDLE_VALUE;
+    if ((hr = pipe_find( url, &name )) != S_OK)
+    {
+        WARN( "no service at %s\n", debugstr_wn(url->chars, url->length) );
+        return hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ) ? WS_E_ENDPOINT_NOT_FOUND : hr;
+    }
+    for (tries = 0; tries < 3; tries++)
+    {
+        *ret = CreateFileW( name, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
+                            FILE_FLAG_OVERLAPPED | SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION, NULL );
+        if (*ret != INVALID_HANDLE_VALUE || GetLastError() != ERROR_PIPE_BUSY) break;
+        WaitNamedPipeW( name, 5000 );
+    }
+    if (*ret == INVALID_HANDLE_VALUE)
+    {
+        hr = GetLastError() == ERROR_FILE_NOT_FOUND ? WS_E_ENDPOINT_NOT_FOUND : HRESULT_FROM_WIN32( GetLastError() );
+        free( name );
+        return hr;
+    }
+    free( name );
+    SetNamedPipeHandleState( *ret, &mode, NULL, NULL );
+    return S_OK;
+}
+
+HRESULT pipe_write( HANDLE pipe, const void *buf, ULONG len )
+{
+    OVERLAPPED ov = {0};
+    DWORD count = 0;
+    HRESULT hr;
+
+    if (!(ov.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL ))) return HRESULT_FROM_WIN32( GetLastError() );
+    if (WriteFile( pipe, buf, len, &count, &ov )) hr = S_OK;
+    else if (GetLastError() == ERROR_IO_PENDING) hr = wait_io( pipe, &ov, NULL, &count );
+    else hr = HRESULT_FROM_WIN32( GetLastError() );
+    CloseHandle( ov.hEvent );
+    if (hr == S_OK && count != len) hr = WS_E_OTHER;
+    return hr;
+}
+
+/* up to LEN bytes; 0 read: the other end has gone */
+HRESULT pipe_read( HANDLE pipe, void *buf, ULONG len, ULONG *ret )
+{
+    OVERLAPPED ov = {0};
+    DWORD count = 0, err;
+    HRESULT hr;
+
+    *ret = 0;
+    if (!(ov.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL ))) return HRESULT_FROM_WIN32( GetLastError() );
+    if (ReadFile( pipe, buf, len, &count, &ov ))
+    {
+        count = ov.InternalHigh;
+        hr = S_OK;
+    }
+    else if ((err = GetLastError()) == ERROR_IO_PENDING) hr = wait_io( pipe, &ov, NULL, &count );
+    else hr = HRESULT_FROM_WIN32( err );
+    CloseHandle( ov.hEvent );
+    /* a message longer than the buffer (the rest comes with the next read); the other end gone */
+    if (hr == HRESULT_FROM_WIN32( ERROR_MORE_DATA ))
+    {
+        /* (the count of an overlapped read is the OVERLAPPED's) */
+        count = ov.InternalHigh;
+        hr = S_OK;
+    }
+    else if (hr == HRESULT_FROM_WIN32( ERROR_BROKEN_PIPE ) || hr == HRESULT_FROM_WIN32( ERROR_PIPE_NOT_CONNECTED ))
+    {
+        count = 0;
+        hr = S_OK;
+    }
+    if (hr == S_OK) *ret = count;
+    return hr;
+}
