new file mode 100644
index 0000000..e233eb3
--- /dev/null
+++ b/dlls/webservices/pipe.c
@@ -0,0 +1,435 @@
+/*
+ * Named pipe transport (WS_NAMEDPIPE_CHANNEL_BINDING)
+ *
+ * Copyright 2026 Stained Glass OS
+ *
