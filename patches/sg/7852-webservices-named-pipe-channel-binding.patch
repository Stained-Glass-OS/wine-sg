+/* a named pipe channel's session from a client connecting to PIPE, an instance of the listener's pipe
+ * (a handle of its own: the channel keeps it) */
+HRESULT channel_accept_pipe( HANDLE pipe, HANDLE cancel, WS_CHANNEL *handle )
+{
+    struct channel *channel = (struct channel *)handle;
+    HRESULT hr;
+
+    EnterCriticalSection( &channel->cs );
+
+    if (channel->magic != CHANNEL_MAGIC || channel->binding != WS_NAMEDPIPE_CHANNEL_BINDING)
+    {
+        LeaveCriticalSection( &channel->cs );
+        return E_INVALIDARG;
+    }
+
+    if ((hr = pipe_accept( pipe, cancel )) == S_OK)
+    {
+        if (channel->u.tcp.pipe != INVALID_HANDLE_VALUE) CloseHandle( channel->u.tcp.pipe );
+        channel->u.tcp.pipe = pipe;
+        channel->state = WS_CHANNEL_STATE_OPEN;
+    }
+
+    LeaveCriticalSection( &channel->cs );
+    return hr;
+}
+
