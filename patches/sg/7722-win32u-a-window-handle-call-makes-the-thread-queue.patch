From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: a window-handle call makes the thread a GUI thread with its queue

---
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -3182,6 +3182,22 @@
 }
 
 /***********************************************************************
+ *           connect_user_thread
+ *
+ * A thread becomes a GUI thread, with its message queue, on its first call
+ * that looks up a window handle, as user32's handle validation does on
+ * Windows.  Programs start a worker that does only that, signal it ready, and
+ * post it work with PostThreadMessage without the PeekMessage call first; a
+ * lazily made queue would make that post fail and the work be lost.
+ */
+void connect_user_thread(void)
+{
+#ifndef SG_MUTANT_LAZY_QUEUE
+    if (!get_user_thread_info()->server_queue) get_server_queue_handle();
+#endif
+}
+
+/***********************************************************************
  *           is_gui_thread
  *
  * Whether this thread has a message queue, making one when asked to
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -152,6 +152,7 @@
 
 /* message.c */
 extern BOOL is_gui_thread( BOOL convert );
+extern void connect_user_thread(void);
 extern BOOL kill_system_timer( HWND hwnd, UINT_PTR id );
 extern BOOL reply_message_result( LRESULT result );
 extern BOOL post_quit_message( int exit_code );
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -659,6 +659,7 @@
 {
     HWND *list, ret = 0;
     WND *win;
+    connect_user_thread();
 
     switch(type)
     {
@@ -6459,6 +6460,7 @@
  */
 ULONG_PTR WINAPI NtUserCallHwnd( HWND hwnd, DWORD code )
 {
+    connect_user_thread();
     switch (code)
     {
     case NtUserCallHwnd_ActivateOtherWindow:
@@ -6564,6 +6566,7 @@
  */
 ULONG_PTR WINAPI NtUserCallHwndParam( HWND hwnd, DWORD_PTR param, DWORD code )
 {
+    connect_user_thread();
     switch (code)
     {
     case NtUserCallHwndParam_ClientToScreen:
