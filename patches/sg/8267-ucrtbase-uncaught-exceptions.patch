From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ucrtbase: __uncaught_exceptions

__uncaught_exceptions, behind std::uncaught_exceptions in programs built with Visual C++ 2017 and later, gives how many exceptions the thread has thrown and not yet caught. It was missing from ucrtbase.
---
--- a/dlls/msvcrt/except.c
+++ b/dlls/msvcrt/except.c
@@ -862,6 +862,20 @@
     return msvcrt_get_thread_data()->processing_throw != 0;
 }
 
+#if _MSVCR_VER >= 140 && !defined(SG_MUTANT_NO_UNCAUGHT_EXCEPTIONS)
+/******************************************************************
+ *		__uncaught_exceptions (UCRTBASE.@)
+ *
+ * (wine-sg 8267) How many exceptions this thread has thrown and not yet caught (std::uncaught_exceptions).
+ */
+int CDECL __uncaught_exceptions(void)
+{
+    return msvcrt_get_thread_data()->processing_throw;
+}
+#elif _MSVCR_VER >= 140
+int CDECL __uncaught_exceptions(void) { return -1; }
+#endif
+
 /*********************************************************************
  *              _fpieee_flt (MSVCRT.@)
  */
--- a/dlls/ucrtbase/ucrtbase.spec
+++ b/dlls/ucrtbase/ucrtbase.spec
@@ -178,6 +178,7 @@
 @ cdecl __unDName(ptr str long ptr ptr long)
 @ cdecl __unDNameEx(ptr str long ptr ptr ptr long)
 @ cdecl __uncaught_exception()
+@ cdecl __uncaught_exceptions()
 @ cdecl __wcserror(wstr)
 @ cdecl __wcserror_s(ptr long wstr)
 @ cdecl __wcsncnt(ptr long) __wcsncnt
