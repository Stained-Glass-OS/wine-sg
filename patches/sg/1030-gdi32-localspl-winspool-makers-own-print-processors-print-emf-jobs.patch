+/* where the page's metafile is in the spool file */
+static BOOL add_page( struct spool_handle *sh, LONGLONG offset, DWORD size )
+{
+    if (sh->pages_no == sh->pages_size)
+    {
+        int count = max( 8, sh->pages_size * 2 );
+        void *alloc = sh->pages ? HeapReAlloc( GetProcessHeap(), 0, sh->pages, count * sizeof(*sh->pages) ) :
+                                  HeapAlloc( GetProcessHeap(), 0, count * sizeof(*sh->pages) );
+        if (!alloc) return FALSE;
+        sh->pages = alloc;
+        sh->pages_size = count;
+    }
+    sh->pages[sh->pages_no].offset = offset;
+    sh->pages[sh->pages_no].size = size;
+    sh->pages_no++;
+    return TRUE;
+}
+
+static BOOL spool_position( struct spool_handle *sh, LONGLONG *pos )
+{
+    LARGE_INTEGER zero, now;
+    zero.QuadPart = 0;
+    if (!SeekPrinter( sh->spool, zero, &now, FILE_CURRENT, FALSE )) return FALSE;
+    *pos = now.QuadPart;
+    return TRUE;
+}
