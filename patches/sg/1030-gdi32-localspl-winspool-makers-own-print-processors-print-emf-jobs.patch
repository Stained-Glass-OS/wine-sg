+/* the newest EMF spool datatype the printer's print processor takes: a
+ * maker's processor may take only "NT EMF 1.008", as Windows spools */
+static const WCHAR *emf_datatype( HANDLE printer )
+{
+    static const WCHAR *emf[] = { L"NT EMF 1.008", L"NT EMF 1.007", L"NT EMF 1.006", L"NT EMF 1.003" };
+    PRINTER_INFO_2W *pi = NULL;
+    DATATYPES_INFO_1W *types = NULL;
+    DWORD needed = 0, count = 0, i, j;
+    const WCHAR *ret = emf[3];
+
+#ifdef SG_MUTANT_EMFTYPE
+    return ret;
+#endif
+    GetPrinterW( printer, 2, NULL, 0, &needed );
+    if (!needed || !(pi = HeapAlloc( GetProcessHeap(), 0, needed )) ||
+        !GetPrinterW( printer, 2, (BYTE *)pi, needed, &needed ) || !pi->pPrintProcessor)
+        goto done;
+    needed = 0;
+    EnumPrintProcessorDatatypesW( NULL, pi->pPrintProcessor, 1, NULL, 0, &needed, &count );
+    if (!needed || !(types = HeapAlloc( GetProcessHeap(), 0, needed )) ||
+        !EnumPrintProcessorDatatypesW( NULL, pi->pPrintProcessor, 1, (BYTE *)types, needed, &needed, &count ))
+        goto done;
+    for (i = 0; i < ARRAY_SIZE(emf); i++)
+        for (j = 0; j < count; j++)
+            if (!wcsicmp( types[j].pName, emf[i] ))
+            {
+                ret = emf[i];
+                goto done;
+            }
+done:
+    HeapFree( GetProcessHeap(), 0, pi );
+    HeapFree( GetProcessHeap(), 0, types );
+    return ret;
+}
