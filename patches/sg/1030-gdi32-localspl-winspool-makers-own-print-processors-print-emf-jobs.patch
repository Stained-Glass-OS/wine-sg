+/*
+ * A print processor of a printer maker's (Canon's, HP's...) prints the
+ * pages of an EMF spool file itself on a DC of the printer, through these
+ * documented functions; the DC's job goes straight to the port (localspl).
+ */
+
+/*******************************************************************
+ *           GdiGetPageCount    (GDI32.@)
+ */
+DWORD WINAPI GdiGetPageCount( HANDLE h )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p\n", h );
+    if (!sh) return 0;
+    while (read_emfspool_record( sh ));
+    return sh->pages_no;
+}
+
+/*******************************************************************
+ *           GdiGetPageHandle    (GDI32.@)
+ */
+HANDLE WINAPI GdiGetPageHandle( HANDLE h, DWORD page, DWORD *type )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p %lu %p\n", h, page, type );
+    if (!sh || !page) return NULL;
+    while (sh->pages_no < page && read_emfspool_record( sh ));
+    if (page > sh->pages_no)
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return NULL;
+    }
+    if (type) *type = 1;    /* EMF_PP_NORMAL */
+    return (HANDLE)(ULONG_PTR)page;
+}
+
+/*******************************************************************
+ *           GdiGetDC    (GDI32.@)
+ */
+HDC WINAPI GdiGetDC( HANDLE h )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p\n", h );
+    if (!sh) return NULL;
+    /* its drawing is spooled, and printed by the spooler as the job it is
+     * rendering (localspl) */
+    if (!sh->hdc) sh->hdc = CreateDCW( NULL, sh->printer, NULL, sh->devmodes[0].devmode );
+    return sh->hdc;
+}
+
+/*******************************************************************
+ *           GdiStartDocEMF    (GDI32.@)
+ */
+BOOL WINAPI GdiStartDocEMF( HANDLE h, DOCINFOW *info )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p %p\n", h, info );
+    if (!sh || !GdiGetDC( h )) return FALSE;
+    return StartDocW( sh->hdc, info ) > 0;
+}
+
+/*******************************************************************
+ *           GdiStartPageEMF    (GDI32.@)
+ */
+BOOL WINAPI GdiStartPageEMF( HANDLE h )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p\n", h );
+    return sh && sh->hdc && StartPage( sh->hdc ) > 0;
+}
+
+/*******************************************************************
+ *           GdiPlayPageEMF    (GDI32.@)
+ */
+BOOL WINAPI GdiPlayPageEMF( HANDLE h, HANDLE page, RECT *document, RECT *border, RECT *clip )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+    ULONG_PTR index = (ULONG_PTR)page;
+    LARGE_INTEGER at;
+    LONGLONG here = 0;
+    HENHMETAFILE emf;
+    RECT full;
+    BYTE *bits;
+    DWORD r;
+    BOOL ret;
+
+    TRACE( "%p %p %s %s %s\n", h, page, wine_dbgstr_rect( document ), wine_dbgstr_rect( border ),
+           wine_dbgstr_rect( clip ) );
+    if (!sh || !sh->hdc || !index || index > sh->pages_no) return FALSE;
+    if (!(bits = HeapAlloc( GetProcessHeap(), 0, sh->pages[index - 1].size ))) return FALSE;
+
+    /* read the page where it is, and come back for the records still to read */
+    spool_position( sh, &here );
+    at.QuadPart = sh->pages[index - 1].offset;
+    ret = SeekPrinter( sh->spool, at, NULL, FILE_BEGIN, FALSE ) &&
+          ReadPrinter( sh->spool, bits, sh->pages[index - 1].size, &r ) && r == sh->pages[index - 1].size;
+    at.QuadPart = here;
+    SeekPrinter( sh->spool, at, NULL, FILE_BEGIN, FALSE );
+    if (!ret || !(emf = SetEnhMetaFileBits( sh->pages[index - 1].size, bits )))
+    {
+        HeapFree( GetProcessHeap(), 0, bits );
+        return FALSE;
+    }
+    HeapFree( GetProcessHeap(), 0, bits );
+
+    if (!document)
+    {
+        SetRect( &full, 0, 0, GetDeviceCaps( sh->hdc, HORZRES ), GetDeviceCaps( sh->hdc, VERTRES ) );
+        document = &full;
+    }
+    SaveDC( sh->hdc );
+    if (clip) IntersectClipRect( sh->hdc, clip->left, clip->top, clip->right, clip->bottom );
+#ifndef SG_MUTANT_PLAYPAGE
+    ret = PlayEnhMetaFile( sh->hdc, emf, document );
+#endif
+    RestoreDC( sh->hdc, -1 );
+    DeleteEnhMetaFile( emf );
+    return ret;
+}
+
+/*******************************************************************
+ *           GdiEndPageEMF    (GDI32.@)
+ */
+BOOL WINAPI GdiEndPageEMF( HANDLE h, DWORD optimization )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p %lu\n", h, optimization );
+    return sh && sh->hdc && EndPage( sh->hdc ) > 0;
+}
+
+/*******************************************************************
+ *           GdiEndDocEMF    (GDI32.@)
+ */
+BOOL WINAPI GdiEndDocEMF( HANDLE h )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p\n", h );
+    return sh && sh->hdc && EndDoc( sh->hdc ) > 0;
+}
+
+/*******************************************************************
+ *           GdiResetDCEMF    (GDI32.@)
+ */
+BOOL WINAPI GdiResetDCEMF( HANDLE h, DEVMODEW *devmode )
+{
+    struct spool_handle *sh = (struct spool_handle *)h;
+
+    TRACE( "%p %p\n", h, devmode );
+    return sh && sh->hdc && ResetDCW( sh->hdc, devmode ) != NULL;
+}
