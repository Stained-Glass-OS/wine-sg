+/* Windows.Foundation.Uri, parsed by urlmon's RFC 3986 IUri: each property
+ * of the runtime class is the matching Uri_PROPERTY of the parsed URI. */
 struct uri
 {
     IUriRuntimeClass IUriRuntimeClass_iface;
     HSTRING raw_uri;
+    IUri *uri;
     LONG ref;
 };
 
+static HRESULT uri_create(const WCHAR *raw, IUriRuntimeClass **instance);
+
+static HRESULT uri_property(struct uri *impl, Uri_PROPERTY property, HSTRING *value)
+{
+    BSTR bstr = NULL;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    hr = IUri_GetPropertyBSTR(impl->uri, property, &bstr, 0);
+    if (FAILED(hr)) return hr;
+    /* S_FALSE: the URI has no such component; that is an empty string. */
+    hr = WindowsCreateString(bstr, bstr ? SysStringLen(bstr) : 0, value);
+    SysFreeString(bstr);
+    return hr;
+}
+
 static inline struct uri *impl_from_IUriRuntimeClass(IUriRuntimeClass *iface)
 {
     return CONTAINING_RECORD(iface, struct uri, IUriRuntimeClass_iface);
@@ -68,6 +89,7 @@
     if (!ref)
     {
         WindowsDeleteString(impl->raw_uri);
+        if (impl->uri) IUri_Release(impl->uri);
