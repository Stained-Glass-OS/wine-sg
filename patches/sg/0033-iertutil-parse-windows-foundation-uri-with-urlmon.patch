+static HRESULT combine(IUri *base, const WCHAR *relative, IUriRuntimeClass **instance)
+{
+    IUri *combined = NULL;
+    BSTR absolute = NULL;
+    HRESULT hr;
+
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    if (FAILED(hr = CoInternetCombineUrlEx(base, relative ? relative : L"", 0, &combined, 0)))
+        return E_INVALIDARG;
+    if (SUCCEEDED(hr = IUri_GetAbsoluteUri(combined, &absolute)))
+        hr = uri_create(absolute, instance);
+    SysFreeString(absolute);
+    IUri_Release(combined);
+    return hr;
 }
 
