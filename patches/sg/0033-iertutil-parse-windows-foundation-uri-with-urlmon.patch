+    if (SUCCEEDED(hr = IUriRuntimeClass_get_AbsoluteUri(iface, &mine)) &&
+        SUCCEEDED(hr = IUriRuntimeClass_get_AbsoluteUri(uri, &theirs)))
+        hr = WindowsCompareStringOrdinal(mine, theirs, &res);
+    WindowsDeleteString(mine);
+    WindowsDeleteString(theirs);
