From: Stained Glass OS <dev@stained-glass.example>
Subject: explorer: Win+X lists Event Viewer, Device Manager, Disk Management, Computer Management

Windows 10's quick-link menu has them, in this order around System and
Network Connections; they open eventvwr.exe and the .msc consoles (0142).

Gate: test/admintools-gate.sh.
---
--- a/programs/explorer/shellkeys.c	2026-09-25 03:13:06.872011026 -0700
+++ b/programs/explorer/shellkeys.c	2026-09-25 07:01:45.621186500 -0700
@@ -4,7 +4,8 @@
  * The Windows key alone opens Start. Win+D shows the desktop (and puts the
  * windows back), Win+M minimizes all, Win+Shift+M restores them, Win+E opens
  * File Explorer, Win+R Run, Win+I settings (the Control Panel), Win+Pause
- * System, Win+X the quick-link menu, Win+H voice typing (sg-dictate.exe /toggle), Win+Shift+S and
+ * System, Win+X the quick-link menu (with Event Viewer, Device Manager, Disk
+ * Management and Computer Management), Win+H voice typing (sg-dictate.exe /toggle), Win+Shift+S and
  * Print Screen screen snipping (snippingtool.exe /clip), Ctrl+Shift+Esc Task Manager;
  * Win+Left/Right snap the active window
  * to half the screen, Win+Up maximizes it, Win+Down restores or minimizes it.
@@ -332,14 +333,18 @@
 static void quick_link(void)
 {
     enum { QL_APPS = 1, QL_SYSTEM, QL_NETWORK, QL_POWERSHELL, QL_TASKMGR, QL_SETTINGS, QL_EXPLORER,
-           QL_RUN, QL_DESKTOP, QL_CONTROL };
+           QL_RUN, QL_DESKTOP, QL_CONTROL, QL_EVENTS, QL_DEVICES, QL_DISKS, QL_COMPMGMT };
     HMENU menu = CreatePopupMenu();
     RECT work;
     int cmd;
 
     AppendMenuW( menu, MF_STRING, QL_APPS, L"Apps and &Features" );
+    AppendMenuW( menu, MF_STRING, QL_EVENTS, L"Event &Viewer" );
     AppendMenuW( menu, MF_STRING, QL_SYSTEM, L"S&ystem" );
+    AppendMenuW( menu, MF_STRING, QL_DEVICES, L"Device &Manager" );
     AppendMenuW( menu, MF_STRING, QL_NETWORK, L"Net&work Connections" );
+    AppendMenuW( menu, MF_STRING, QL_DISKS, L"D&isk Management" );
+    AppendMenuW( menu, MF_STRING, QL_COMPMGMT, L"Computer Mana&gement" );
     AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
     AppendMenuW( menu, MF_STRING, QL_POWERSHELL, L"Windows Power&Shell" );
     AppendMenuW( menu, MF_STRING, QL_TASKMGR, L"Tas&k Manager" );
@@ -358,6 +363,10 @@
     case QL_APPS: run( L"control.exe", L"appwiz.cpl" ); break;
     case QL_SYSTEM: run( L"control.exe", L"/name Microsoft.System" ); break;
     case QL_NETWORK: run( L"control.exe", L"ncpa.cpl" ); break;
+    case QL_EVENTS: run( L"eventvwr.exe", NULL ); break;
+    case QL_DEVICES: run( L"devmgmt.msc", NULL ); break;
+    case QL_DISKS: run( L"diskmgmt.msc", NULL ); break;
+    case QL_COMPMGMT: run( L"compmgmt.msc", NULL ); break;
     case QL_POWERSHELL:
         if ((INT_PTR)ShellExecuteW( NULL, NULL, L"pwsh.exe", NULL, NULL, SW_SHOWNORMAL ) <= 32) run( L"cmd.exe", NULL );
         break;
