+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(wrapped_size > plain_size, "got sizes %lu, %lu.\n", wrapped_size, plain_size);
+
+        SetLastError(0xdeadbeef);
+        ret = CryptMsgEncodeAndSignCTL(PKCS_7_ASN_ENCODING, &ctl, &sign_info, 0x80, NULL, &size);
+        ok(!ret && GetLastError() == E_INVALIDARG, "got ret %d, error %#lx.\n", ret, GetLastError());
+
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
