+/* The content of a CMS message that is not id-data may be wrapped in an
+ * OCTET STRING (CMSG_CMS_ENCAPSULATED_CONTENT_FLAG); a PKCS #7 content of
+ * another type is the encoding of that type, which never starts with one. */
+static BOOL CDecodeMsg_UnwrapEncapsulated(const CRYPT_DATA_BLOB *content, CRYPT_DATA_BLOB **octets)
+{
+    DWORD size;
+
+    if (content->cbData < 2 || content->pbData[0] != 0x04 /* OCTET STRING */) return FALSE;
+    return CryptDecodeObjectEx(X509_ASN_ENCODING, X509_OCTET_STRING, content->pbData, content->cbData,
+     CRYPT_DECODE_ALLOC_FLAG, NULL, octets, &size);
+}
