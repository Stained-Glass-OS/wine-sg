+    /* CMS encapsulated content: the content of a message whose type is not data is an OCTET STRING */
+    {
+        static const BYTE inner[] = { 0x30, 0x03, 0x02, 0x01, 0x05 };
+        const BYTE *inner_ptr = inner;
+        DWORD inner_size = sizeof(inner), size, type_size;
+        char type[64];
+        CERT_INFO cert_info;
+        BYTE *blob, *out;
+        HCRYPTMSG msg;
+
+        para.dwFlags = CRYPT_MESSAGE_ENCAPSULATED_CONTENT_OUT_FLAG;
+        para.dwInnerContentType = CMSG_SIGNED;
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, NULL, &size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        blob = CryptMemAlloc(size);
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, blob, &size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+        ret = CryptMsgUpdate(msg, blob, size, TRUE);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        type_size = sizeof(type);
+        ret = CryptMsgGetParam(msg, CMSG_INNER_CONTENT_TYPE_PARAM, 0, type, &type_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(!strcmp(type, szOID_RSA_signedData), "got type %s.\n", type);
+        ok(signed_data_version(blob, size) == CMSG_SIGNED_DATA_V3, "got version %d.\n", signed_data_version(blob, size));
+        size = 0;
+        ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, NULL, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(size == sizeof(inner), "got size %lu.\n", size);
+        out = CryptMemAlloc(size);
+        ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, out, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(size == sizeof(inner) && !memcmp(out, inner, sizeof(inner)), "unexpected content.\n");
+        CryptMemFree(out);
+        /* the signature covers the octets of the content */
+        cert_info = *para.pSigningCert->pCertInfo;
+        ret = CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE, &cert_info);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        CryptMsgClose(msg);
+        CryptMemFree(blob);
+
+        /* the same without the flag is a version 1 message */
+        para.dwFlags = 0;
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, NULL, &size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        blob = CryptMemAlloc(size);
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, blob, &size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+        ret = CryptMsgUpdate(msg, blob, size, TRUE);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(signed_data_version(blob, size) == CMSG_SIGNED_DATA_V1, "got version %d.\n", signed_data_version(blob, size));
+        CryptMsgClose(msg);
+        CryptMemFree(blob);
+
+        /* data content stays version 1 even when encapsulated */
+        para.dwFlags = CRYPT_MESSAGE_ENCAPSULATED_CONTENT_OUT_FLAG;
+        para.dwInnerContentType = CMSG_DATA;
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, NULL, &size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        blob = CryptMemAlloc(size);
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, blob, &size);
+        ok(ret, "CryptSignMessage failed: %08lx\n", GetLastError());
+        msg = CryptMsgOpenToDecode(PKCS_7_ASN_ENCODING, 0, 0, 0, NULL, NULL);
+        ret = CryptMsgUpdate(msg, blob, size, TRUE);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(signed_data_version(blob, size) == CMSG_SIGNED_DATA_V1, "got version %d.\n", signed_data_version(blob, size));
+        CryptMsgClose(msg);
+        CryptMemFree(blob);
+
+        /* an unknown inner content type */
+        para.dwInnerContentType = 99;
+        SetLastError(0xdeadbeef);
+        ret = CryptSignMessage(&para, FALSE, 1, &inner_ptr, &inner_size, NULL, &size);
+        ok(!ret && GetLastError() == E_INVALIDARG, "got ret %d, error %#lx.\n", ret, GetLastError());
+        para.dwFlags = 0;
+        para.dwInnerContentType = 0;
+    }
+
+    /* a signed CTL, in the CMS encapsulated form */
+    {
+        static char ctl_usage[] = szOID_PKIX_KP_SERVER_AUTH;
+        static char *usages[] = { ctl_usage };
+        CMSG_SIGNER_ENCODE_INFO signer;
+        CMSG_SIGNED_ENCODE_INFO sign_info;
+        CERT_BLOB cert_blob = { para.pSigningCert->cbCertEncoded, para.pSigningCert->pbCertEncoded };
+        CTL_INFO ctl;
+        CERT_INFO cert_info;
