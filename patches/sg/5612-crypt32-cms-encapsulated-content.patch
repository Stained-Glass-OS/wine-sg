+        HCRYPTMSG msg;
+
+        memset(&ctl, 0, sizeof(ctl));
+        ctl.dwVersion = CTL_V1;
+        ctl.SubjectUsage.cUsageIdentifier = 1;
+        ctl.SubjectUsage.rgpszUsageIdentifier = usages;
+        ctl.SubjectAlgorithm.pszObjId = (char *)szOID_OIWSEC_sha1;
+        ctl.ThisUpdate.dwLowDateTime = 0xd0000000;
+        ctl.ThisUpdate.dwHighDateTime = 0x01c00000;
+
+        memset(&signer, 0, sizeof(signer));
+        signer.cbSize = sizeof(signer);
+        signer.pCertInfo = para.pSigningCert->pCertInfo;
+        signer.hCryptProv = hCryptProv;
+        signer.dwKeySpec = AT_SIGNATURE;
+        signer.HashAlgorithm.pszObjId = (char *)szOID_RSA_MD5;
+        memset(&sign_info, 0, sizeof(sign_info));
+        sign_info.cbSize = sizeof(sign_info);
+        sign_info.cSigners = 1;
+        sign_info.rgSigners = &signer;
+        sign_info.cCertEncoded = 1;
+        sign_info.rgCertEncoded = &cert_blob;
+
+        ret = CryptMsgEncodeAndSignCTL(PKCS_7_ASN_ENCODING, &ctl, &sign_info, 0, NULL, &plain_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        plain = CryptMemAlloc(plain_size);
+        ret = CryptMsgEncodeAndSignCTL(PKCS_7_ASN_ENCODING, &ctl, &sign_info, 0, plain, &plain_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ret = CryptMsgEncodeAndSignCTL(PKCS_7_ASN_ENCODING, &ctl, &sign_info, CMSG_CMS_ENCAPSULATED_CTL_FLAG,
+                NULL, &wrapped_size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        wrapped = CryptMemAlloc(wrapped_size);
+        ret = CryptMsgEncodeAndSignCTL(PKCS_7_ASN_ENCODING, &ctl, &sign_info, CMSG_CMS_ENCAPSULATED_CTL_FLAG,
