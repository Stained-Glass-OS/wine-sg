+static void test_signed_msg_cms_encapsulated(void)
+{
+    static const BYTE pattern[] = { 0xa0, 0x06, 0x04, 0x04, 0x01, 0x02, 0x03, 0x04 };
+    static const BYTE v3[] = { 0x02, 0x01, 0x03 };
+    static const BYTE v1[] = { 0x02, 0x01, 0x01 };
+    CMSG_SIGNED_ENCODE_INFO signInfo = { sizeof(signInfo), 0 };
+    static char oid_other[] = "1.2.3.4";
+    static char oid_data[] = szOID_RSA_data;
+    BYTE data[] = { 1, 2, 3, 4 };
+    BYTE *bare;
+    DWORD size, i;
+    HCRYPTMSG msg;
+    BOOL ret, found;
+
+    /* the content of a message that is not data is wrapped in an OCTET STRING, and the version is 3 */
+    msg = CryptMsgOpenToEncode(PKCS_7_ASN_ENCODING, CMSG_CMS_ENCAPSULATED_CONTENT_FLAG, CMSG_SIGNED, &signInfo,
+            oid_other, NULL);
+    ok(!!msg, "CryptMsgOpenToEncode failed: %lx\n", GetLastError());
+    ret = CryptMsgUpdate(msg, data, sizeof(data), TRUE);
+    ok(ret, "CryptMsgUpdate failed: %lx\n", GetLastError());
+    size = 0;
+    ret = CryptMsgGetParam(msg, CMSG_BARE_CONTENT_PARAM, 0, NULL, &size);
+    ok(ret, "got error %lx\n", GetLastError());
+    bare = malloc(size);
+    ret = CryptMsgGetParam(msg, CMSG_BARE_CONTENT_PARAM, 0, bare, &size);
+    ok(ret, "got error %lx\n", GetLastError());
+    ok(size > 5 && !memcmp(bare + 2, v3, sizeof(v3)), "the version is not 3\n");
+    for (i = 0, found = FALSE; i + sizeof(pattern) <= size; i++)
+        if (!memcmp(bare + i, pattern, sizeof(pattern))) found = TRUE;
+    ok(found, "the content is not an OCTET STRING\n");
+    free(bare);
+    CryptMsgClose(msg);
+
+    /* without the flag, or with data content, neither applies */
+    msg = CryptMsgOpenToEncode(PKCS_7_ASN_ENCODING, 0, CMSG_SIGNED, &signInfo, oid_other, NULL);
+    ok(!!msg, "CryptMsgOpenToEncode failed: %lx\n", GetLastError());
+    ret = CryptMsgUpdate(msg, data, sizeof(data), TRUE);
+    ok(ret, "CryptMsgUpdate failed: %lx\n", GetLastError());
+    size = 0;
+    CryptMsgGetParam(msg, CMSG_BARE_CONTENT_PARAM, 0, NULL, &size);
+    bare = malloc(size);
+    CryptMsgGetParam(msg, CMSG_BARE_CONTENT_PARAM, 0, bare, &size);
+    ok(size > 5 && !memcmp(bare + 2, v1, sizeof(v1)), "the version is not 1\n");
+    for (i = 0, found = FALSE; i + sizeof(pattern) <= size; i++)
+        if (!memcmp(bare + i, pattern, sizeof(pattern))) found = TRUE;
+    ok(!found, "the content is wrapped\n");
+    free(bare);
+    CryptMsgClose(msg);
+
+    msg = CryptMsgOpenToEncode(PKCS_7_ASN_ENCODING, CMSG_CMS_ENCAPSULATED_CONTENT_FLAG, CMSG_SIGNED, &signInfo,
+            oid_data, NULL);
+    ok(!!msg, "CryptMsgOpenToEncode failed: %lx\n", GetLastError());
+    ret = CryptMsgUpdate(msg, data, sizeof(data), TRUE);
+    ok(ret, "CryptMsgUpdate failed: %lx\n", GetLastError());
+    size = 0;
+    CryptMsgGetParam(msg, CMSG_BARE_CONTENT_PARAM, 0, NULL, &size);
