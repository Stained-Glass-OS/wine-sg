--- a/dlls/crypt32/tests/message.c
+++ b/dlls/crypt32/tests/message.c
@@ -941,6 +941,27 @@ static const BYTE signedData[] = {
 0xef,0x98,0x2d,0xac,0xad,0xc1,0x93,0x60,0xc4,0x3a,0xdc,0xa7,0xd6,0x97,0x70,
 0x01,0xc1,0x84 };
 
+/* the version of a SignedData message, read from its encoding */
+static const BYTE *enter_tlv(const BYTE *p, const BYTE *end)
+{
+    if (!p || p + 2 > end) return NULL;
+    if (p[1] & 0x80) p += 2 + (p[1] & 0x7f); else p += 2;
+    return p <= end ? p : NULL;
+}
+
+static int signed_data_version(const BYTE *p, DWORD size)
+{
+    const BYTE *end = p + size;
+
+    p = enter_tlv(p, end);                     /* ContentInfo */
+    if (!p || p + 2 > end) return -1;
+    p += 2 + p[1];                             /* contentType */
+    p = enter_tlv(p, end);                     /* [0] */
+    p = enter_tlv(p, end);                     /* SignedData */
+    if (!p || p + 3 > end || p[0] != 0x02 || p[1] != 1) return -1;
+    return p[2];
+}
