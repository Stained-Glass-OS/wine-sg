+        ok(signed_data_version(plain, plain_size) == CMSG_SIGNED_DATA_V1, "got version %d.\n", signed_data_version(plain, plain_size));
+        size = 0;
+        ret = CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, NULL, &size);
