From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxgi: CreateSwapChainForCoreWindow clears the output on failure (3726)

dxgi: CreateSwapChainForCoreWindow clears the output on failure

The output pointer is set to NULL as soon as it is known to be valid, so a
caller that tests it after an invalid-call error sees no stale pointer.
Adds the argument test of stubs-7 patch 5514 to the dxgi conformance
suite.
---
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index 441d1f1..9d16edb 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -347,7 +347,12 @@ static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForCoreWindow(IWine
     TRACE("iface %p, device %p, window %p, desc %p, output %p, swapchain %p.\n",
             iface, device, window, desc, output, swapchain);
 
-    if (!device || !window || !desc || !swapchain)
+    if (!swapchain)
+        return DXGI_ERROR_INVALID_CALL;
+#ifndef SG_MUTANT_DXGI_CWNULL
+    *swapchain = NULL;
+#endif
+    if (!device || !window || !desc)
     {
         WARN("Invalid pointer.\n");
         return DXGI_ERROR_INVALID_CALL;
diff --git a/dlls/dxgi/tests/dxgi.c b/dlls/dxgi/tests/dxgi.c
index 8eda169..30a234f 100644
--- a/dlls/dxgi/tests/dxgi.c
+++ b/dlls/dxgi/tests/dxgi.c
@@ -7257,6 +7257,56 @@ static void test_frame_latency_event(IUnknown *device, BOOL is_d3d12)
     ok(ref_count == !is_d3d12, "Factory has %lu references left.\n", ref_count);
 }
 
+static void test_swapchain_for_core_window(IUnknown *device, BOOL is_d3d12)
+{
+    DXGI_SWAP_CHAIN_DESC1 desc = {0};
+    IDXGISwapChain1 *swapchain;
+    IDXGIFactory2 *factory2;
+    IDXGIFactory *factory;
+    HRESULT hr;
+
+    get_factory(device, is_d3d12, &factory);
+    hr = IDXGIFactory_QueryInterface(factory, &IID_IDXGIFactory2, (void **)&factory2);
+    IDXGIFactory_Release(factory);
+    if (FAILED(hr))
+    {
+        win_skip("IDXGIFactory2 not available.\n");
+        return;
+    }
+
+    desc.Width = 640;
+    desc.Height = 480;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+
+    /* "DXGI_ERROR_INVALID_CALL if ... pDesc or ppSwapChain is NULL" */
+    hr = IDXGIFactory2_CreateSwapChainForCoreWindow(factory2, device, device, &desc, NULL, NULL);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+    swapchain = (IDXGISwapChain1 *)0xdeadbeef;
+    hr = IDXGIFactory2_CreateSwapChainForCoreWindow(factory2, device, device, NULL, NULL, &swapchain);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+    ok(!swapchain, "Got swapchain %p.\n", swapchain);
+
+    /* the device, and the window which is no CoreWindow */
+    swapchain = (IDXGISwapChain1 *)0xdeadbeef;
+    hr = IDXGIFactory2_CreateSwapChainForCoreWindow(factory2, NULL, device, &desc, NULL, &swapchain);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+    ok(!swapchain, "Got swapchain %p.\n", swapchain);
+    swapchain = (IDXGISwapChain1 *)0xdeadbeef;
+    hr = IDXGIFactory2_CreateSwapChainForCoreWindow(factory2, device, NULL, &desc, NULL, &swapchain);
+    ok(hr == DXGI_ERROR_INVALID_CALL, "Got unexpected hr %#lx.\n", hr);
+    ok(!swapchain, "Got swapchain %p.\n", swapchain);
+    swapchain = (IDXGISwapChain1 *)0xdeadbeef;
+    hr = IDXGIFactory2_CreateSwapChainForCoreWindow(factory2, device, device, &desc, NULL, &swapchain);
+    ok(FAILED(hr), "Got unexpected hr %#lx for a window that is no CoreWindow.\n", hr);
+    ok(!swapchain, "Got swapchain %p.\n", swapchain);
+
+    IDXGIFactory2_Release(factory2);
+}
+
 static void test_colour_space_support(IUnknown *device, BOOL is_d3d12)
 {
     DXGI_SWAP_CHAIN_DESC1 swapchain_desc;
@@ -8069,6 +8119,7 @@ START_TEST(dxgi)
     run_on_d3d10(test_swapchain_present);
     run_on_d3d10(test_swapchain_backbuffer_index);
     run_on_d3d10(test_swapchain_formats);
+    run_on_d3d10(test_swapchain_for_core_window);
     run_on_d3d10(test_output_ownership);
     run_on_d3d10(test_cursor_clipping);
     run_on_d3d10(test_get_containing_output);
@@ -8104,6 +8155,7 @@ START_TEST(dxgi)
     run_on_d3d12(test_output_ownership);
     run_on_d3d12(test_cursor_clipping);
     run_on_d3d12(test_frame_latency_event);
+    run_on_d3d12(test_swapchain_for_core_window);
     run_on_d3d12(test_colour_space_support);
     run_on_d3d12(test_get_containing_output);
     run_on_d3d12(test_window_association);
