--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5396,6 +5396,17 @@ done:
 /******************************************************************************
  *              NtSetInformationFile   (NTDLL.@)
  */
+/* The status block of a request the file system refused (an error status) is left
+ * alone, as on Windows; only a request that went through writes it. */
+static NTSTATUS set_file_info_status( IO_STATUS_BLOCK *io, unsigned int status )
+{
+#ifndef SG_MUTANT_IOSB_ALWAYS
+    if (NT_ERROR( status )) return status;
+#endif
+    io->Information = 0;
+    return io->Status = status;
+}
+
 NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                                       void *ptr, ULONG len, FILE_INFORMATION_CLASS class )
 {
@@ -5414,7 +5425,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             char *unix_name;
 
             if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return set_file_info_status( io, status );
 
             if (server_get_unix_name( handle, &unix_name )) unix_name = NULL;
 
@@ -5440,7 +5451,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             const FILE_POSITION_INFORMATION *info = ptr;
 
             if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return set_file_info_status( io, status );
 
             if (lseek( fd, info->CurrentByteOffset.QuadPart, SEEK_SET ) == (off_t)-1)
                 status = errno_to_status( errno );
@@ -5569,7 +5580,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             struct stat st;
 
             if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return set_file_info_status( io, status );
 
             if (info->AllocationSize.QuadPart < 0) status = STATUS_INVALID_PARAMETER;
             else if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
@@ -5605,7 +5616,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             const FILE_VALID_DATA_LENGTH_INFORMATION *info = ptr;
 
             if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return set_file_info_status( io, status );
 
             if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
             else if (info->ValidDataLength.QuadPart <= 0 || (off_t)info->ValidDataLength.QuadPart > st.st_size)
@@ -5788,8 +5799,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         status = STATUS_NOT_IMPLEMENTED;
         break;
     }
-    io->Information = 0;
-    return io->Status = status;
+    return set_file_info_status( io, status );
 }
 
 
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -797,6 +797,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
 
     IO_STATUS_BLOCK io;
     NTSTATUS status;
