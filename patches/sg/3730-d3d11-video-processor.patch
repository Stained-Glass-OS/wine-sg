+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "d3d11_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d11);
+
+#define VP_MAX_STREAM_STATES 16
+#define VP_RATE_CONVERSION_CAPS_COUNT 1
+#define VP_PALETTE_MAX 256
+#define VP_FILTER_COUNT 8
+
+struct vp_stream_state
+{
+    D3D11_VIDEO_FRAME_FORMAT frame_format;
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE color_space;
+    D3D11_VIDEO_PROCESSOR_OUTPUT_RATE output_rate;
+    BOOL repeat_frame;
+    DXGI_RATIONAL custom_rate;
+    BOOL src_rect_enabled, dst_rect_enabled;
+    RECT src_rect, dst_rect;
+    BOOL alpha_enabled;
+    float alpha;
+    UINT palette_count;
+    UINT palette[VP_PALETTE_MAX];
+    BOOL aspect_enabled;
+    DXGI_RATIONAL src_aspect, dst_aspect;
+    BOOL luma_enabled;
+    float luma_lower, luma_upper;
+    BOOL stereo_enabled;
+    D3D11_VIDEO_PROCESSOR_STEREO_FORMAT stereo_format;
+    BOOL left_view_frame0, base_view_frame0;
+    D3D11_VIDEO_PROCESSOR_STEREO_FLIP_MODE flip_mode;
+    int mono_offset;
+    BOOL auto_processing;
+    struct {BOOL enabled; int level;} filter[VP_FILTER_COUNT];
+    BOOL rotation_enabled;
+    D3D11_VIDEO_PROCESSOR_ROTATION rotation;
+};
+
+struct d3d_video_processor_enumerator
+{
+    ID3D11VideoProcessorEnumerator1 ID3D11VideoProcessorEnumerator1_iface;
+    LONG refcount;
+
+    struct wined3d_private_store private_store;
+    struct d3d_device *device;
+    D3D11_VIDEO_PROCESSOR_CONTENT_DESC desc;
+};
+
+struct d3d_video_processor
+{
+    ID3D11VideoProcessor ID3D11VideoProcessor_iface;
+    LONG refcount;
+
+    struct wined3d_private_store private_store;
+    struct d3d_device *device;
+    struct d3d_video_processor_enumerator *enumerator;
+    UINT rate_conversion_index;
+
+    BOOL target_rect_enabled;
+    RECT target_rect;
+    BOOL background_yuv;
+    D3D11_VIDEO_COLOR background;
+    D3D11_VIDEO_PROCESSOR_COLOR_SPACE output_color_space;
+    D3D11_VIDEO_PROCESSOR_ALPHA_FILL_MODE alpha_fill_mode;
+    UINT alpha_fill_stream;
+    BOOL constriction_enabled;
+    SIZE constriction_size;
+    BOOL output_stereo;
+    struct vp_stream_state streams[VP_MAX_STREAM_STATES];
+};
+
+struct d3d_video_processor_input_view
+{
+    ID3D11VideoProcessorInputView ID3D11VideoProcessorInputView_iface;
+    LONG refcount;
+
+    struct wined3d_private_store private_store;
+    struct d3d_device *device;
+    ID3D11Resource *resource;
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC desc;
+};
+
+struct d3d_video_processor_output_view
+{
+    ID3D11VideoProcessorOutputView ID3D11VideoProcessorOutputView_iface;
+    LONG refcount;
+
+    struct wined3d_private_store private_store;
+    struct d3d_device *device;
+    ID3D11Resource *resource;
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC desc;
+};
+
+static const struct ID3D11VideoProcessorEnumerator1Vtbl d3d_video_processor_enumerator_vtbl;
+static const struct ID3D11VideoProcessorVtbl d3d_video_processor_vtbl;
+
+/* Formats the (absent) processing back end could read or write: none. */
+static UINT vp_format_support(DXGI_FORMAT format)
+{
+#ifdef SG_MUTANT_VP_FORMATS
+    if (format == DXGI_FORMAT_B8G8R8A8_UNORM)
+        return D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT | D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT;
+#endif
+    return 0;
