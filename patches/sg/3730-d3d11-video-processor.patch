+static struct vp_stream_state *vp_stream(struct d3d_video_processor *p, UINT idx)
+{
+#ifdef SG_MUTANT_VP_STREAM_ALIAS
+    idx = 0;
+#endif
+#ifdef SG_MUTANT_VP_STREAM_OOB
+    if (!p || idx > VP_MAX_STREAM_STATES)
+#else
+    if (!p || idx >= VP_MAX_STREAM_STATES)
+#endif
+    {
+        WARN("Invalid processor %p or stream index %u.\n", p, idx);
+        return NULL;
+    }
+    return &p->streams[idx];
+}
+
+#define VP_BEGIN_OUT(processor) \
+    struct d3d_video_processor *p = unsafe_impl_from_ID3D11VideoProcessor(processor); \
+    if (!p) { WARN("Invalid processor %p.\n", processor); return; } \
+    wined3d_mutex_lock();
+#define VP_BEGIN_STREAM(processor, idx) \
+    struct d3d_video_processor *p = unsafe_impl_from_ID3D11VideoProcessor(processor); \
+    struct vp_stream_state *s; \
+    wined3d_mutex_lock(); \
+    if (!(s = vp_stream(p, idx))) { wined3d_mutex_unlock(); return; }
+#define VP_END wined3d_mutex_unlock()
+
