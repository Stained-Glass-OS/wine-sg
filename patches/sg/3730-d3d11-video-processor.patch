+static HRESULT vp_view_check_resource(ID3D11Resource *resource, ID3D11VideoProcessorEnumerator *enumerator,
+        UINT *mip_levels, UINT *array_size)
+{
+    D3D11_RESOURCE_DIMENSION dim;
+    D3D11_TEXTURE2D_DESC tdesc;
+    ID3D11Texture2D *texture;
+
+    if (!resource || !unsafe_impl_from_ID3D11VideoProcessorEnumerator(enumerator))
+        return E_INVALIDARG;
+
+    ID3D11Resource_GetType(resource, &dim);
+    if (dim != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+    {
+        WARN("Resource dimension %#x is not a 2D texture.\n", dim);
+        return E_INVALIDARG;
+    }
+    if (FAILED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D, (void **)&texture)))
+        return E_INVALIDARG;
+    ID3D11Texture2D_GetDesc(texture, &tdesc);
+    ID3D11Texture2D_Release(texture);
+    *mip_levels = tdesc.MipLevels;
+    *array_size = tdesc.ArraySize;
+    return S_OK;
+}
