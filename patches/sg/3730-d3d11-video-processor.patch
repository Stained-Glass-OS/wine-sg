+HRESULT d3d_video_processor_input_view_create(struct d3d_device *device, ID3D11Resource *resource,
+        ID3D11VideoProcessorEnumerator *enumerator, const D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC *desc,
+        ID3D11VideoProcessorInputView **out)
+{
+    struct d3d_video_processor_input_view *object;
+    UINT mips, slices;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!desc || FAILED(hr = vp_view_check_resource(resource, enumerator, &mips, &slices)))
+        return E_INVALIDARG;
+
+    if (desc->ViewDimension != D3D11_VPIV_DIMENSION_TEXTURE2D
+#ifndef SG_MUTANT_VP_VIEW_NOCHECK
+            || desc->Texture2D.MipSlice >= mips || desc->Texture2D.ArraySlice >= slices
+#endif
+            )
+    {
+        WARN("Invalid input view description (dimension %#x, mip %u, slice %u).\n",
+                desc->ViewDimension, desc->Texture2D.MipSlice, desc->Texture2D.ArraySlice);
+        return E_INVALIDARG;
+    }
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID3D11VideoProcessorInputView_iface.lpVtbl = &d3d_video_processor_input_view_vtbl;
+    object->refcount = 1;
+    wined3d_private_store_init(&object->private_store);
+    object->device = device;
+    ID3D11Device2_AddRef(&device->ID3D11Device2_iface);
+    ID3D11Resource_AddRef(object->resource = resource);
+    object->desc = *desc;
+
+    TRACE("Created video processor input view %p.\n", object);
+    *out = &object->ID3D11VideoProcessorInputView_iface;
+    return S_OK;
+}
