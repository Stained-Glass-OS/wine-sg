+HRESULT d3d_video_processor_create(struct d3d_device *device, ID3D11VideoProcessorEnumerator *enumerator,
+        UINT rate_conversion_index, ID3D11VideoProcessor **out)
+{
+    struct d3d_video_processor_enumerator *e;
+    struct d3d_video_processor *object;
+    unsigned int i;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!(e = unsafe_impl_from_ID3D11VideoProcessorEnumerator(enumerator)))
+    {
+        WARN("Enumerator %p is not ours.\n", enumerator);
+        return E_INVALIDARG;
+    }
+#ifdef SG_MUTANT_VP_RATE_INDEX
+    if (rate_conversion_index > VP_RATE_CONVERSION_CAPS_COUNT)
+#else
+    if (rate_conversion_index >= VP_RATE_CONVERSION_CAPS_COUNT)
+#endif
+    {
+        WARN("Invalid rate conversion index %u.\n", rate_conversion_index);
+        return E_INVALIDARG;
+    }
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID3D11VideoProcessor_iface.lpVtbl = &d3d_video_processor_vtbl;
+    object->refcount = 1;
+    wined3d_private_store_init(&object->private_store);
+    object->device = device;
+    ID3D11Device2_AddRef(&device->ID3D11Device2_iface);
+    object->enumerator = e;
+    ID3D11VideoProcessorEnumerator_AddRef(enumerator);
+    object->rate_conversion_index = rate_conversion_index;
+    object->alpha_fill_mode = D3D11_VIDEO_PROCESSOR_ALPHA_FILL_MODE_OPAQUE;
+    for (i = 0; i < VP_MAX_STREAM_STATES; ++i)
+        vp_init_stream_state(&object->streams[i]);
+
+    TRACE("Created video processor %p.\n", object);
+    *out = &object->ID3D11VideoProcessor_iface;
+    return S_OK;
+}
