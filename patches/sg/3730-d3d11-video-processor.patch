+HRESULT d3d_video_processor_output_view_create(struct d3d_device *device, ID3D11Resource *resource,
+        ID3D11VideoProcessorEnumerator *enumerator, const D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC *desc,
+        ID3D11VideoProcessorOutputView **out)
+{
+    struct d3d_video_processor_output_view *object;
+    UINT mips, slices;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!desc || FAILED(hr = vp_view_check_resource(resource, enumerator, &mips, &slices)))
+        return E_INVALIDARG;
+
+    if (desc->ViewDimension == D3D11_VPOV_DIMENSION_TEXTURE2D)
+    {
+#ifndef SG_MUTANT_VP_VIEW_NOCHECK
+        if (desc->Texture2D.MipSlice >= mips)
+            return E_INVALIDARG;
+#endif
+    }
+    else if (desc->ViewDimension == D3D11_VPOV_DIMENSION_TEXTURE2DARRAY)
+    {
+#ifndef SG_MUTANT_VP_VIEW_NOCHECK
+        if (desc->Texture2DArray.MipSlice >= mips || !desc->Texture2DArray.ArraySize
+                || desc->Texture2DArray.FirstArraySlice >= slices
+                || desc->Texture2DArray.ArraySize > slices - desc->Texture2DArray.FirstArraySlice)
+            return E_INVALIDARG;
+#endif
+    }
+    else
+    {
+        WARN("Invalid output view dimension %#x.\n", desc->ViewDimension);
+        return E_INVALIDARG;
+    }
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID3D11VideoProcessorOutputView_iface.lpVtbl = &d3d_video_processor_output_view_vtbl;
+    object->refcount = 1;
+    wined3d_private_store_init(&object->private_store);
+    object->device = device;
+    ID3D11Device2_AddRef(&device->ID3D11Device2_iface);
+    ID3D11Resource_AddRef(object->resource = resource);
+    object->desc = *desc;
+
+    TRACE("Created video processor output view %p.\n", object);
+    *out = &object->ID3D11VideoProcessorOutputView_iface;
+    return S_OK;
+}
