+static ULONG STDMETHODCALLTYPE vpov_AddRef(ID3D11VideoProcessorOutputView *iface)
+{
+    struct d3d_video_processor_output_view *v = impl_from_ID3D11VideoProcessorOutputView(iface);
+    ULONG refcount = InterlockedIncrement(&v->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", v, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE vpov_Release(ID3D11VideoProcessorOutputView *iface)
+{
+    struct d3d_video_processor_output_view *v = impl_from_ID3D11VideoProcessorOutputView(iface);
+    ULONG refcount = InterlockedDecrement(&v->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", v, refcount);
+
+    if (!refcount)
+    {
+        ID3D11Resource_Release(v->resource);
+        ID3D11Device2_Release(&v->device->ID3D11Device2_iface);
+        wined3d_private_store_cleanup(&v->private_store);
+        free(v);
+    }
+    return refcount;
+}
