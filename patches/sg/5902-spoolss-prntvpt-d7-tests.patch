From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] spoolss, prntvpt: conformance tests from stubs-7 (5902)

Test additions of stubs-7 patches 5510 (spoolss other names, printer client
impersonation) and 5523 (PTQuerySchemaVersionSupport arguments and version),
with the prototype in prntvpt.h. They pass on fast-a 3238/3243 (spoolss 32
tests, prntvpt 2 tests, 0 failures, 64+32). Depends on fast-a 3238 and 3243.

Written by fast-b (work/for-fast-a/3243b, RECONCILE-CLOUD spoolss/prntvpt:
keep fast-a's code, take drafter 7's tests); numbered 5902 at integration
(integ-2026-10), which drops drafter 7's 5510 and 5523.
---
diff --git a/dlls/prntvpt/tests/prntvpt.c b/dlls/prntvpt/tests/prntvpt.c
index 8d955cd..90733e1 100644
--- a/dlls/prntvpt/tests/prntvpt.c
+++ b/dlls/prntvpt/tests/prntvpt.c
@@ -126,12 +126,41 @@ static void test_PTOpenProviderEx(void)
     }
 }
 
+static void test_PTQuerySchemaVersionSupport_args(void)
+{
+    DWORD version = 0xdeadbeef;
+    HRESULT hr;
+
+    hr = PTQuerySchemaVersionSupport(NULL, &version);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = PTQuerySchemaVersionSupport(L"no such printer queue", NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+}
+
+static void test_PTQuerySchemaVersionSupport(void)
+{
+    DWORD version;
+    HRESULT hr;
+
+    version = 0xdeadbeef;
+    hr = PTQuerySchemaVersionSupport(default_name, &version);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(version == 1, "got version %lu\n", version);
+
+    version = 0xdeadbeef;
+    hr = PTQuerySchemaVersionSupport(L"no such printer queue", &version);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    ok(version == 0xdeadbeef, "version modified: %lu\n", version);
+}
+
 START_TEST(prntvpt)
 {
     DWORD size;
 
     CoInitializeEx(NULL, COINIT_MULTITHREADED);
 
+    test_PTQuerySchemaVersionSupport_args();
+
     size = ARRAY_SIZE(default_name);
     if (!GetDefaultPrinterW(default_name, &size))
     {
@@ -141,6 +170,7 @@ START_TEST(prntvpt)
 
     trace("default printer: %s\n", wine_dbgstr_w(default_name));
 
+    test_PTQuerySchemaVersionSupport();
     test_PTOpenProvider();
     test_PTOpenProviderEx();
 
diff --git a/dlls/spoolss/tests/Makefile.in b/dlls/spoolss/tests/Makefile.in
index f6d18ee..dd62b79 100644
--- a/dlls/spoolss/tests/Makefile.in
+++ b/dlls/spoolss/tests/Makefile.in
@@ -1,4 +1,5 @@
 TESTDLL   = spoolss.dll
+IMPORTS   = iphlpapi advapi32
 
 SOURCES = \
 	spoolss.c
diff --git a/include/prntvpt.h b/include/prntvpt.h
index e060a26..5fb5b67 100644
--- a/include/prntvpt.h
+++ b/include/prntvpt.h
@@ -45,6 +45,7 @@ typedef enum
 HRESULT WINAPI PTOpenProvider(const WCHAR *printer, DWORD version, HPTPROVIDER *provider);
 HRESULT WINAPI PTOpenProviderEx(const WCHAR *printer, DWORD max_version, DWORD pref_version, HPTPROVIDER *provider, DWORD *used_version);
 HRESULT WINAPI PTCloseProvider(HPTPROVIDER);
+HRESULT WINAPI PTQuerySchemaVersionSupport(PCWSTR printer, DWORD *max_version);
 HRESULT WINAPI PTConvertDevModeToPrintTicket(HPTPROVIDER, ULONG, PDEVMODEW, EPrintTicketScope, IStream *);
 HRESULT WINAPI PTConvertPrintTicketToDevMode(HPTPROVIDER, IStream *, EDefaultDevmodeType, EPrintTicketScope, ULONG *, PDEVMODEW *, BSTR *);
 HRESULT WINAPI PTGetPrintCapabilities(HPTPROVIDER, IStream *, IStream *, BSTR *);
--- a/dlls/spoolss/tests/spoolss.c
+++ b/dlls/spoolss/tests/spoolss.c
@@ -23,6 +23,8 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winsock2.h"
+#include "iphlpapi.h"
 #include "winerror.h"
 #include "wine/test.h"
 
@@ -35,6 +37,8 @@
 static HMODULE hspl;
 static BOOL   (WINAPI * pBuildOtherNamesFromMachineName)(LPWSTR **, LPDWORD);
 static DWORD  (WINAPI * pSplInitializeWinSpoolDrv)(LPVOID *);
+static BOOL   (WINAPI * pImpersonatePrinterClient)(HANDLE);
+static HANDLE (WINAPI * pRevertToPrinterSelf)(void);
 
 #define WINSPOOL_TABLESIZE   16
 
@@ -57,6 +61,9 @@
     pBuildOtherNamesFromMachineName = (void *) GetProcAddress(hspl, ptr);
     if (!pBuildOtherNamesFromMachineName) return ptr;
 
+    pImpersonatePrinterClient = (void *) GetProcAddress(hspl, "ImpersonatePrinterClient");
+    pRevertToPrinterSelf = (void *) GetProcAddress(hspl, "RevertToPrinterSelf");
+
     ptr = "SplInitializeWinSpoolDrv";
     pSplInitializeWinSpoolDrv = (void *) GetProcAddress(hspl, ptr);
     if (!pSplInitializeWinSpoolDrv) return ptr;
@@ -164,11 +171,44 @@
       entry_#y: <ip-address> Tunnel adapter (string with a IPv6 ip-address)
     */
 
-    ok( res && (buffers != NULL) && (numentries >= 3) && (buffers[0] != NULL) && (buffers[0][0] == '\0'),
+    ok( res && (buffers != NULL) && (numentries >= 2) && (buffers[0] != NULL) && (buffers[0][0] == '\0'),
         "got %lu with %lu and %p,%lu (%p:%d)\n", res, GetLastError(), buffers, numentries,
         ((numentries > 0) && buffers) ? buffers[0] : NULL,
         ((numentries > 0) && buffers && buffers[0]) ? lstrlenW(buffers[0]) : -1);
 
+    if (res && buffers && numentries >= 2)
+    {
+        WCHAR host[MAX_COMPUTERNAME_LENGTH + 1];
+        DWORD len = ARRAY_SIZE(host), i;
+        ULONG size = 0;
+        BOOL adapter_up = FALSE;
+
+        ok(GetComputerNameW(host, &len), "GetComputerNameW failed: %lu\n", GetLastError());
+        ok(buffers[1] && !lstrcmpW(buffers[1], host), "got %s, expected the computer name %s\n",
+           wine_dbgstr_w(buffers[1]), wine_dbgstr_w(host));
+        for (i = 2; i < numentries; i++)
+            ok(buffers[i] && buffers[i][0], "entry %lu is empty\n", i);
+
+        /* "1 entry per ... adapter: <ip-address>" */
+        if (GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST, NULL, NULL, &size)
+                == ERROR_BUFFER_OVERFLOW)
+        {
+            IP_ADAPTER_ADDRESSES *adapters = HeapAlloc(GetProcessHeap(), 0, size), *adapter;
+
+            if (adapters && !GetAdaptersAddresses(AF_UNSPEC, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST,
+                                                  NULL, adapters, &size))
+            {
+                for (adapter = adapters; adapter; adapter = adapter->Next)
+                    if (adapter->OperStatus == IfOperStatusUp && adapter->IfType != IF_TYPE_SOFTWARE_LOOPBACK
+                            && adapter->FirstUnicastAddress)
+                        adapter_up = TRUE;
+            }
+            HeapFree(GetProcessHeap(), 0, adapters);
+        }
+        if (adapter_up)
+            ok(numentries >= 3, "got %lu entries with an adapter that is up\n", numentries);
+    }
+
 }
 
 /* ########################### */
@@ -203,6 +243,46 @@
 
 /* ########################### */
 
+static void test_printer_client_impersonation(void)
+{
+    HANDLE token, thread_token;
+    BOOL ret;
+
+    if (!pRevertToPrinterSelf || !pImpersonatePrinterClient)
+    {
+        win_skip("RevertToPrinterSelf and ImpersonatePrinterClient not found\n");
+        return;
+    }
+
+    /* not impersonating: nothing to revert */
+    token = pRevertToPrinterSelf();
+    ok(!token, "got %p, expected NULL while not impersonating\n", token);
+
+    ret = ImpersonateSelf(SecurityImpersonation);
+    ok(ret, "ImpersonateSelf failed: %lu\n", GetLastError());
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(ret, "OpenThreadToken failed while impersonating: %lu\n", GetLastError());
+    if (ret) CloseHandle(thread_token);
+
+    token = pRevertToPrinterSelf();
+    ok(token != NULL, "got NULL while impersonating\n");
+    SetLastError(0xdeadbeef);
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(!ret && GetLastError() == ERROR_NO_TOKEN, "got %d with %lu: the thread still impersonates\n", ret, GetLastError());
+    if (ret) CloseHandle(thread_token);
+
+    ret = pImpersonatePrinterClient(token);
+    ok(ret, "ImpersonatePrinterClient failed: %lu\n", GetLastError());
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(ret, "OpenThreadToken failed after ImpersonatePrinterClient: %lu\n", GetLastError());
+    if (ret) CloseHandle(thread_token);
+    /* the handle was cleaned up */
+    SetLastError(0xdeadbeef);
+    ok(!GetHandleInformation(token, (DWORD[1]){0}), "the token handle is still open\n");
+
+    RevertToSelf();
+}
+
 START_TEST(spoolss)
 {
     LPCSTR ptr;
@@ -216,5 +296,6 @@
 
     test_BuildOtherNamesFromMachineName();
     test_SplInitializeWinSpoolDrv();
+    test_printer_client_impersonation();
 
 }
