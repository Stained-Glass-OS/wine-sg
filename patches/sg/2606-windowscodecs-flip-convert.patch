+    if (This->swap_xy) { UINT t = dest_width; dest_width = dest_height; dest_height = t; }
+#endif
+    if (This->flip_x) x = dest_width - 1 - x;
+    if (This->flip_y) y = dest_height - 1 - y;
+    if (This->swap_xy)
+    {
+        *src_x = y;
+        *src_y = x;
+    }
+    else
+    {
+        *src_x = x;
+        *src_y = y;
+    }
+}
