+static BOOL wide_dest_is_direct(enum pixelformat dst)
+{
+    switch (dst)
+    {
+        case format_24bppBGR: case format_24bppRGB:
+        case format_32bppBGR: case format_32bppRGB: case format_32bppBGRA:
+        case format_32bppRGBA: case format_32bppPBGRA: case format_32bppPRGBA:
+        case format_64bppRGBA:
+            return TRUE;
+        default:
+            return FALSE;
+    }
+}
+
+static HRESULT copypixels_wide(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    return convert_wide(This, prc, cbStride, cbBufferSize, pbBuffer, source_format,
+            This->dst_format->format);
+}
+
+/* Reads prc from the source as 16 bit per channel, non-premultiplied RGBA. */
+static HRESULT read_rgba64(struct FormatConverter *This, const WICRect *prc,
+        enum pixelformat source_format, WORD **out)
+{
+    UINT count = prc->Width * prc->Height, i;
+    UINT stride = prc->Width * 8;
+    HRESULT hr;
+    BYTE *bgra;
+    WORD *data;
+
+    if (!(data = malloc(stride * prc->Height)))
+        return E_OUTOFMEMORY;
+
+    if (source_format == format_64bppRGBA || format_is_wide(source_format))
+    {
+        if (source_format == format_64bppRGBA)
+            hr = IWICBitmapSource_CopyPixels(This->source, prc, stride, stride * prc->Height, (BYTE *)data);
+        else
+            hr = convert_wide(This, prc, stride, stride * prc->Height, (BYTE *)data, source_format, format_64bppRGBA);
+    }
+    else if (source_format == format_48bppRGB)
+    {
+        hr = copypixels_to_64bppRGBA(This, prc, stride, stride * prc->Height, (BYTE *)data, source_format);
+    }
+    else if (source_format == format_16bppGray)
+    {
+        WORD *gray = malloc(prc->Width * 2 * prc->Height);
+
+        if (!gray)
+        {
+            free(data);
+            return E_OUTOFMEMORY;
+        }
+        hr = IWICBitmapSource_CopyPixels(This->source, prc, prc->Width * 2, prc->Width * 2 * prc->Height, (BYTE *)gray);
+        if (SUCCEEDED(hr))
+            for (i = 0; i < count; i++)
+                data[i * 4] = data[i * 4 + 1] = data[i * 4 + 2] = gray[i], data[i * 4 + 3] = 0xffff;
+        free(gray);
+    }
+    else
+    {
+        if (SUCCEEDED(hr = read_bgra(This, prc, source_format, &bgra)))
+        {
+            for (i = 0; i < count; i++)
+            {
+                data[i * 4] = bgra[i * 4 + 2] * EXPAND8_16;
+                data[i * 4 + 1] = bgra[i * 4 + 1] * EXPAND8_16;
+                data[i * 4 + 2] = bgra[i * 4] * EXPAND8_16;
+                data[i * 4 + 3] = bgra[i * 4 + 3] * EXPAND8_16;
+            }
+            free(bgra);
+        }
+    }
+
+    if (FAILED(hr))
+    {
+        free(data);
+        return hr;
+    }
+    *out = data;
+    return S_OK;
+}
+
+static HRESULT copypixels_to_48bppRGB(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    WORD *data;
+    HRESULT hr;
+    INT x, y;
+
+    if (!prc)
+        return S_OK;
+    if (source_format == format_48bppRGB)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+    if (FAILED(hr = read_rgba64(This, prc, source_format, &data)))
+        return hr;
+
+    for (y = 0; y < prc->Height; y++)
+    {
+        const WORD *src = data + y * prc->Width * 4;
+        WORD *dst = (WORD *)(pbBuffer + y * cbStride);
+
+        for (x = 0; x < prc->Width; x++, src += 4, dst += 3)
+        {
+            dst[0] = src[0];
+            dst[1] = src[1];
+            dst[2] = src[2];
+        }
+    }
+    free(data);
+    return S_OK;
+}
+
+static float gray_luma_to_srgb(float r, float g, float b)
+{
+    return to_sRGB_component(r * 0.2126f + g * 0.7152f + b * 0.0722f);
+}
+
+static HRESULT copypixels_to_16bppGray(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    WORD *data;
+    HRESULT hr;
+    INT x, y;
+
+    if (!prc)
+        return S_OK;
+    if (source_format == format_16bppGray)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+    if (FAILED(hr = read_rgba64(This, prc, source_format, &data)))
+        return hr;
+
+    for (y = 0; y < prc->Height; y++)
+    {
+        const WORD *src = data + y * prc->Width * 4;
+        WORD *dst = (WORD *)(pbBuffer + y * cbStride);
+
+        for (x = 0; x < prc->Width; x++, src += 4)
+        {
+            float gray = gray_luma_to_srgb(src[0] / 65535.0f, src[1] / 65535.0f, src[2] / 65535.0f);
+
+            dst[x] = floorf(min(max(gray, 0.0f), 1.0f) * 65535.0f + 0.51f);
+        }
+    }
+    free(data);
+    return S_OK;
+}
+
+static HRESULT copypixels_to_16bppBGR555(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    if (prc && source_format == format_16bppBGR555)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+    return copypixels_bgra_to_narrow(This, prc, cbStride, cbBufferSize, pbBuffer, source_format, format_16bppBGR555);
+}
+
+static HRESULT copypixels_to_16bppBGR565(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    if (prc && source_format == format_16bppBGR565)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+    return copypixels_bgra_to_narrow(This, prc, cbStride, cbBufferSize, pbBuffer, source_format, format_16bppBGR565);
+}
+
+/* Gray destinations narrower than 8 bits keep the top bits of the 8 bit gray value. */
+static HRESULT copypixels_gray_narrow(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format,
+    enum pixelformat dst, UINT bits)
+{
+    UINT srcstride, x, y;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!prc)
+        return S_OK;
+    if (source_format == dst)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+
+    srcstride = prc->Width;
+    if (!(data = malloc(srcstride * prc->Height)))
+        return E_OUTOFMEMORY;
+    hr = copypixels_to_8bppGray(This, prc, srcstride, srcstride * prc->Height, data, source_format);
+    if (SUCCEEDED(hr))
+    {
+        for (y = 0; y < prc->Height; y++)
+        {
+            BYTE *out = pbBuffer + y * cbStride;
+
+            memset(out, 0, (prc->Width * bits + 7) / 8);
+            for (x = 0; x < prc->Width; x++)
+            {
+#ifdef SG_MUTANT_CONV_GRAY_ROUND
+                BYTE v = (data[y * srcstride + x] * ((1 << bits) - 1) + 127) / 255;
+#else
+                BYTE v = data[y * srcstride + x] >> (8 - bits);
+#endif
+                UINT shift = 8 - bits - (x * bits) % 8;
+
+                out[x * bits / 8] |= v << shift;
+            }
+        }
+    }
+    free(data);
+    return hr;
+}
+
+static HRESULT copypixels_to_BlackWhite(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    return copypixels_gray_narrow(This, prc, cbStride, cbBufferSize, pbBuffer, source_format, format_BlackWhite, 1);
+}
+
+static HRESULT copypixels_to_2bppGray(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    return copypixels_gray_narrow(This, prc, cbStride, cbBufferSize, pbBuffer, source_format, format_2bppGray, 2);
+}
+
+static HRESULT copypixels_to_4bppGray(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    return copypixels_gray_narrow(This, prc, cbStride, cbBufferSize, pbBuffer, source_format, format_4bppGray, 4);
+}
+
+/* 1, 2 and 4 bit palette destinations pick the nearest palette entry for each pixel. */
+static HRESULT copypixels_indexed_narrow(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format,
+    enum pixelformat dst, UINT bits)
+{
+    WICColor colors[256];
+    UINT count, srcstride, x, y;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!prc)
+        return S_OK;
+    if (source_format == dst)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+    if (!This->palette)
+        return WINCODEC_ERR_WRONGSTATE;
+    if (FAILED(hr = IWICPalette_GetColors(This->palette, 1 << bits, colors, &count)))
+        return hr;
+
+    srcstride = 3 * prc->Width;
+    if (!(data = malloc(srcstride * prc->Height)))
+        return E_OUTOFMEMORY;
+    hr = copypixels_to_24bppBGR(This, prc, srcstride, srcstride * prc->Height, data, source_format);
+    if (SUCCEEDED(hr))
+    {
+        for (y = 0; y < prc->Height; y++)
+        {
+            BYTE *out = pbBuffer + y * cbStride;
+
+            memset(out, 0, (prc->Width * bits + 7) / 8);
+            for (x = 0; x < prc->Width; x++)
+            {
+                BYTE v = rgb_to_palette_index(data + y * srcstride + x * 3, colors, count);
+#ifdef SG_MUTANT_CONV_IDX_LSB
+                UINT shift = (x * bits) % 8;
+#else
+                UINT shift = 8 - bits - (x * bits) % 8;
+#endif
+
+                out[x * bits / 8] |= v << shift;
+            }
+        }
+    }
+    free(data);
+    return hr;
+}
+
+static HRESULT copypixels_to_1bppIndexed(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    return copypixels_indexed_narrow(This, prc, cbStride, cbBufferSize, pbBuffer, source_format, format_1bppIndexed, 1);
+}
+
+static HRESULT copypixels_to_2bppIndexed(struct FormatConverter *This, const WICRect *prc,
