+/* Fallback for the destinations without a direct path from source_format: go
+ * through 32bppBGRA and drop the alpha channel, or pack the colour. */
+static HRESULT copypixels_bgra_to_narrow(struct FormatConverter *This, const WICRect *prc,
+        UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format,
+        enum pixelformat dst)
+{
+    BYTE *data;
+    HRESULT hr;
+    INT x, y;
+
+    if (!prc)
+        return S_OK;
+    if (FAILED(hr = read_bgra(This, prc, source_format, &data)))
+        return hr;
+
+    for (y = 0; y < prc->Height; y++)
+    {
+        const BYTE *src = data + y * prc->Width * 4;
+        BYTE *out = pbBuffer + y * cbStride;
+
+        for (x = 0; x < prc->Width; x++, src += 4)
+        {
+            switch (dst)
+            {
+            case format_24bppBGR:
+                *out++ = src[0]; *out++ = src[1]; *out++ = src[2];
+                break;
+            case format_24bppRGB:
+                *out++ = src[2]; *out++ = src[1]; *out++ = src[0];
+                break;
+            case format_16bppBGRA5551:
+                *(WORD *)out = ((src[3] >> 7) << 15) | ((src[2] >> 3) << 10) | ((src[1] >> 3) << 5) | (src[0] >> 3);
+                out += 2;
+                break;
+            case format_16bppBGR555:
+                *(WORD *)out = ((src[2] >> 3) << 10) | ((src[1] >> 3) << 5) | (src[0] >> 3);
+                out += 2;
+                break;
+            case format_16bppBGR565:
+                *(WORD *)out = ((src[2] >> 3) << 11) | ((src[1] >> 2) << 5) | (src[0] >> 3);
+                out += 2;
+                break;
+            default:
+                break;
+            }
+        }
+    }
+
+    free(data);
+    return S_OK;
+}
