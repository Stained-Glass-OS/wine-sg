+/* Reads prc from the source converted to 32bppBGRA. The caller frees *data. */
+static HRESULT read_bgra(struct FormatConverter *This, const WICRect *prc,
+        enum pixelformat source_format, BYTE **data)
+{
+    UINT stride = prc->Width * 4;
+    HRESULT hr;
+
+    if (!(*data = malloc(stride * prc->Height)))
+        return E_OUTOFMEMORY;
+    if (format_is_wide(source_format))
+        hr = convert_wide(This, prc, stride, stride * prc->Height, *data, source_format, format_32bppBGRA);
+    else
+        hr = copypixels_to_32bppBGRA(This, prc, stride, stride * prc->Height, *data, source_format);
+    if (FAILED(hr))
+    {
+        free(*data);
+        *data = NULL;
+    }
+    return hr;
+}
