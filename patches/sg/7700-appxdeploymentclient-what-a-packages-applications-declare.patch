From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: what a package's applications declare reaches the shell; downloads keep a package extension

---
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index 771ce13..d14212f 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -91,6 +91,7 @@
 #include "shlobj.h"
 #include "shlguid.h"
 #include "shobjidl.h"
+#include "propkey.h"
 #include "appxpackaging.h"
 #include "xmllite.h"
 #include "wine/appexeclink.h"
@@ -455,7 +456,11 @@ static void safe_file_name( WCHAR *name )
 
 /* A shortcut for each application with an entry in the app list; their paths
  * go in the list, for removal. */
-static void create_shortcuts( IAppxManifestReader *manifest, const struct package_record *rec, struct strlist *list )
+static WCHAR *app_icon( const struct package_record *rec, const WCHAR *app, const WCHAR *name, const WCHAR *logo,
+                        struct strlist *integration );
+
+static void create_shortcuts( IAppxManifestReader *manifest, const struct package_record *rec, struct strlist *list,
+                              struct strlist *integration )
 {
     IAppxManifestApplicationsEnumerator *apps;
     IAppxManifestApplication *app;
@@ -470,13 +475,17 @@ static void create_shortcuts( IAppxManifestReader *manifest, const struct packag
     while (SUCCEEDED(IAppxManifestApplicationsEnumerator_GetHasCurrent( apps, &has_current )) && has_current)
     {
         WCHAR *exe = NULL, *display = NULL, *entry = NULL, name[MAX_PATH], target[MAX_PATH], link[MAX_PATH];
+        WCHAR *id = NULL, *logo = NULL, *icon = NULL, aumid[256];
         IShellLinkW *shell_link;
         IPersistFile *file;
+        IPropertyStore *store;
 
         if (FAILED(IAppxManifestApplicationsEnumerator_GetCurrent( apps, &app ))) break;
         IAppxManifestApplication_GetStringValue( app, L"Executable", &exe );
         IAppxManifestApplication_GetStringValue( app, L"DisplayName", &display );
         IAppxManifestApplication_GetStringValue( app, L"AppListEntry", &entry );
+        IAppxManifestApplication_GetStringValue( app, L"Id", &id );
+        IAppxManifestApplication_GetStringValue( app, L"Square44x44Logo", &logo );
 
         if (exe && (!entry || wcsicmp( entry, L"none" )))
         {
@@ -495,6 +504,21 @@ static void create_shortcuts( IAppxManifestReader *manifest, const struct packag
                 IShellLinkW_SetPath( shell_link, target );
                 IShellLinkW_SetWorkingDirectory( shell_link, content_root( rec ) );
                 IShellLinkW_SetDescription( shell_link, name );
+                /* Stained Glass OS: the application's identity (the taskbar groups by it) and its logo */
+                if (id && rec->family_name &&
+                    swprintf( aumid, ARRAY_SIZE(aumid), L"%s!%s", rec->family_name, id ) >= 0 &&
+                    SUCCEEDED(IShellLinkW_QueryInterface( shell_link, &IID_IPropertyStore, (void **)&store )))
+                {
+                    PROPVARIANT value;
+
+                    value.vt = VT_LPWSTR;
+                    value.pwszVal = aumid;
+                    IPropertyStore_SetValue( store, &PKEY_AppUserModel_ID, &value );
+                    IPropertyStore_Commit( store );
+                    IPropertyStore_Release( store );
+                }
+                if (id && integration && (icon = app_icon( rec, id, NULL, logo, integration )))
+                    IShellLinkW_SetIconLocation( shell_link, icon, 0 );
                 if (SUCCEEDED(IShellLinkW_QueryInterface( shell_link, &IID_IPersistFile, (void **)&file )))
                 {
                     if (SUCCEEDED(IPersistFile_Save( file, link, TRUE )))
@@ -510,6 +534,9 @@ static void create_shortcuts( IAppxManifestReader *manifest, const struct packag
         CoTaskMemFree( exe );
         CoTaskMemFree( display );
         CoTaskMemFree( entry );
+        CoTaskMemFree( id );
+        CoTaskMemFree( logo );
+        free( icon );
         IAppxManifestApplication_Release( app );
         IAppxManifestApplicationsEnumerator_MoveNext( apps, &has_current );
     }
@@ -1071,6 +1098,690 @@ static void unregister_com_classes( HKEY record, HKEY hive )
     free( list );
 }
 
+/* ---- Stained Glass OS: what an application declares to the shell ------------------------------
+ *
+ * Windows registers what a package's applications declare -- protocols
+ * (windows.protocol), file types (windows.fileTypeAssociation), startup tasks
+ * (windows.startupTask), their logos -- for the user who has the package, and the
+ * shell starts the application with the package's identity. Here each becomes the
+ * shell's ordinary registration in the hive the package is recorded in (the
+ * user's, or the machine's when SYSTEM installs it):
+ * - a ProgID "AppX" + 26 characters made from the family, the application and the
+ *   name, whose command line is the one the manifest gives (Parameters, else
+ *   "%1"), with Application\AppUserModelID; the scheme or the extension points at
+ *   it, the scheme only while no other program has it;
+ * - the application's Capabilities (URLAssociations, FileAssociations) named in
+ *   RegisteredApplications, the list Default apps offers;
+ * - an enabled startup task as a Run value "<family>!<task id>";
+ * - logos as icons (the PNG images of the logo's sizes in one .ico), for the
+ *   Start menu shortcut and the file types.
+ * What was written is recorded with the package (value ShellIntegration, entries
+ * "K:key below Software\Classes", "E:.ext:ProgID", "R:AUMID", "U:Run value",
+ * "I:icon file") and removed with it. A process started through any of these is
+ * inside the package's location, so it has the package's identity (0061). */
+
+#define INTEGRATION_VALUE L"ShellIntegration"
+#define CLASSES_PATH L"Software\\Classes"
+#define RUN_PATH L"Software\\Microsoft\\Windows\\CurrentVersion\\Run"
+#define REGISTERED_APPS_PATH L"Software\\RegisteredApplications"
+#define REC_RRF (REC_VIEW ? RRF_SUBKEY_WOW6464KEY : 0)
+
+/* a value in a key of the hive, in the records' view */
+static LSTATUS set_value_view( HKEY hive, const WCHAR *path, const WCHAR *name, const WCHAR *value )
+{
+    LSTATUS res;
+    HKEY key;
+
+    if ((res = RegCreateKeyExW( hive, path, 0, NULL, 0, KEY_SET_VALUE | REC_VIEW, NULL, &key, NULL ))) return res;
+    res = RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)value, (wcslen( value ) + 1) * sizeof(WCHAR) );
+    RegCloseKey( key );
+    return res;
+}
+
+static void delete_value_view( HKEY hive, const WCHAR *path, const WCHAR *name )
+{
+    HKEY key;
+
+    if (RegOpenKeyExW( hive, path, 0, KEY_SET_VALUE | REC_VIEW, &key )) return;
+    RegDeleteValueW( key, name );
+    RegCloseKey( key );
+}
+
+/* "AppX" and 26 base-32 digits of two 64-bit FNV-1a hashes of the parts, case-insensitive */
+static void appx_progid( const WCHAR *family, const WCHAR *app, const WCHAR *kind, const WCHAR *name, WCHAR *out )
+{
+    static const char digits[] = "0123456789abcdefghjkmnpqrstvwxyz";
+    const WCHAR *parts[4] = { family, app, kind, name };
+    UINT64 h[2] = { 0xcbf29ce484222325ull, 0x6c62272e07bb0142ull };
+    unsigned int i, bit;
+
+    for (i = 0; i < ARRAY_SIZE(parts); i++)
+    {
+        const WCHAR *p = parts[i] ? parts[i] : L"";
+        for (;; p++)
+        {
+            WCHAR c = towlower( *p );
+            h[0] = (h[0] ^ c) * 0x100000001b3ull;
+            h[1] = (h[1] ^ (c + 0x9e37)) * 0x100000001b3ull;
+            if (!*p) break;
+        }
+    }
+    wcscpy( out, L"AppX" );
+    for (i = 0, bit = 0; i < 26; i++, bit += 5)
+    {
+        UINT64 word = h[bit / 64 % 2];
+        unsigned int shift = bit % 64, v = (word >> shift) & 31;
+        if (shift > 59) v |= (h[(bit / 64 + 1) % 2] << (64 - shift)) & 31;
+        out[4 + i] = digits[v];
+    }
+    out[30] = 0;
+}
+
+/* a key below the hive's Software\Classes, created */
+static HKEY create_classes_key( HKEY hive, const WCHAR *path )
+{
+    WCHAR full[MAX_PATH];
+    HKEY key;
+
+    if (swprintf( full, ARRAY_SIZE(full), L"%s\\%s", CLASSES_PATH, path ) < 0) return NULL;
+    if (RegCreateKeyExW( hive, full, 0, NULL, 0, KEY_ALL_ACCESS | REC_VIEW, NULL, &key, NULL )) return NULL;
+    return key;
+}
+
+static void set_sub_string( HKEY key, const WCHAR *sub, const WCHAR *name, const WCHAR *value )
+{
+    HKEY child;
+
+    if (!value || RegCreateKeyExW( key, sub, 0, NULL, 0, KEY_SET_VALUE, NULL, &child, NULL )) return;
+    reg_set_string( child, name, value );
+    RegCloseKey( child );
+}
+
+/* A ProgID (or a scheme's own key) that runs the application. */
+static BOOL write_handler( HKEY hive, const WCHAR *path, const WCHAR *description, BOOL url, const WCHAR *aumid,
+                           const WCHAR *app_name, const WCHAR *icon, const WCHAR *command )
+{
+    HKEY key;
+
+    if (!(key = create_classes_key( hive, path ))) return FALSE;
+    reg_set_string( key, NULL, description );
+    if (url) reg_set_string( key, L"URL Protocol", L"" );
+    set_sub_string( key, L"DefaultIcon", NULL, icon );
+    set_sub_string( key, L"shell\\open\\command", NULL, command );
+    set_sub_string( key, L"Application", L"AppUserModelID", aumid );
+    set_sub_string( key, L"Application", L"ApplicationName", app_name );
+    set_sub_string( key, L"Application", L"ApplicationIcon", icon );
+    RegCloseKey( key );
+    return TRUE;
+}
+
+/* whether a key below Software\Classes of the hive runs a program of this package */
+static BOOL handler_is_ours( HKEY hive, const WCHAR *path, const WCHAR *root )
+{
+    WCHAR full[MAX_PATH], command[MAX_PATH * 2];
+    DWORD size = sizeof(command);
+
+    if (swprintf( full, ARRAY_SIZE(full), L"%s\\%s\\shell\\open\\command", CLASSES_PATH, path ) < 0) return FALSE;
+    if (RegGetValueW( hive, full, NULL, RRF_RT_REG_SZ | REC_RRF, NULL, command, &size )) return FALSE;
+    return command[0] == '"' && !wcsnicmp( command + 1, root, wcslen( root ) ) && command[1 + wcslen( root )] == '\\';
+}
+
+/* whether the merged classes (HKCR) know a scheme or an extension's program already */
+static BOOL classes_have( const WCHAR *name, BOOL extension )
+{
+    WCHAR value[MAX_PATH];
+    DWORD size = sizeof(value);
+    HKEY key;
+    BOOL ret;
+
+    if (RegOpenKeyExW( HKEY_CLASSES_ROOT, name, 0, KEY_READ | REC_VIEW, &key )) return FALSE;
+    if (extension) ret = !RegGetValueW( key, NULL, NULL, RRF_RT_REG_SZ, NULL, value, &size ) && value[0];
+    else ret = TRUE;
+    RegCloseKey( key );
+    return ret;
+}
+
+/* ---- logos as icons ---- */
+
+/* the file of a logo at a size: Windows' resource qualifiers (targetsize-N, scale-N) */
+static BOOL logo_variant( const WCHAR *path, const WCHAR *qualifier, WCHAR *out, size_t size )
+{
+    const WCHAR *dot = wcsrchr( path, '.' ), *slash = wcsrchr( path, '\\' );
+
+    if (!dot || (slash && dot < slash)) return FALSE;
+    if (!qualifier) return swprintf( out, size, L"%s", path ) >= 0 && GetFileAttributesW( out ) != INVALID_FILE_ATTRIBUTES;
+    if (swprintf( out, size, L"%.*s.%s%s", (int)(dot - path), path, qualifier, dot ) < 0) return FALSE;
+    return GetFileAttributesW( out ) != INVALID_FILE_ATTRIBUTES;
+}
+
+struct png_image
+{
+    BYTE *data;
+    DWORD size, width, height;
+};
+
+static BOOL read_png( const WCHAR *path, struct png_image *png )
+{
+    static const BYTE signature[8] = { 0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n' };
+    HANDLE file;
+    DWORD size, read;
+    BOOL ret = FALSE;
+
+    memset( png, 0, sizeof(*png) );
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    size = GetFileSize( file, NULL );
+    if (size >= 33 && size <= 4 * 1024 * 1024 && (png->data = malloc( size )) &&
+        ReadFile( file, png->data, size, &read, NULL ) && read == size &&
+        !memcmp( png->data, signature, 8 ) && !memcmp( png->data + 12, "IHDR", 4 ))
+    {
+        png->size = size;
+        png->width = (png->data[16] << 24) | (png->data[17] << 16) | (png->data[18] << 8) | png->data[19];
+        png->height = (png->data[20] << 24) | (png->data[21] << 16) | (png->data[22] << 8) | png->data[23];
+        ret = png->width && png->height && png->width <= 1024 && png->height <= 1024;
+    }
+    CloseHandle( file );
+    if (!ret)
+    {
+        free( png->data );
+        png->data = NULL;
+    }
+    return ret;
+}
+
+/* The logo's images (its target sizes, else one scale) in an .ico; TRUE when written. */
+static BOOL write_logo_icon( const WCHAR *root, const WCHAR *logo, const WCHAR *ico )
+{
+    static const WCHAR *sizes[] = { L"targetsize-16", L"targetsize-24", L"targetsize-32", L"targetsize-48",
+                                    L"targetsize-64", L"targetsize-256" };
+    static const WCHAR *fallbacks[] = { L"scale-100", L"scale-200", L"scale-150", L"scale-400", NULL };
+    struct png_image images[ARRAY_SIZE(sizes)];
+    WCHAR path[MAX_PATH], file_name[MAX_PATH];
+    unsigned int i, count = 0;
+    DWORD offset, written;
+    HANDLE file;
+    BOOL ret = FALSE;
+
+    if (!logo || !payload_path( root, logo, path, ARRAY_SIZE(path) )) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(sizes); i++)
+        if (logo_variant( path, sizes[i], file_name, ARRAY_SIZE(file_name) ) && read_png( file_name, &images[count] ))
+            count++;
+    for (i = 0; !count && i < ARRAY_SIZE(fallbacks); i++)
+        if (logo_variant( path, fallbacks[i], file_name, ARRAY_SIZE(file_name) ) && read_png( file_name, &images[count] ))
+            count++;
+    if (!count) return FALSE;
+
+    if (SUCCEEDED(create_parent_dirs( (WCHAR *)ico )) &&
+        (file = CreateFileW( ico, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL )) != INVALID_HANDLE_VALUE)
+    {
+        WORD header[3] = { 0, 1, count };
+
+        ret = WriteFile( file, header, sizeof(header), &written, NULL );
+        offset = sizeof(header) + count * 16;
+        for (i = 0; ret && i < count; i++)
+        {
+            BYTE entry[16] = { 0 };
+
+            entry[0] = images[i].width >= 256 ? 0 : images[i].width;
+            entry[1] = images[i].height >= 256 ? 0 : images[i].height;
+            entry[4] = 1;   /* planes */
+            entry[6] = 32;  /* bits per pixel */
+            memcpy( entry + 8, &images[i].size, 4 );
+            memcpy( entry + 12, &offset, 4 );
+            offset += images[i].size;
+            ret = WriteFile( file, entry, sizeof(entry), &written, NULL );
+        }
+        for (i = 0; ret && i < count; i++)
+            ret = WriteFile( file, images[i].data, images[i].size, &written, NULL ) && written == images[i].size;
+        CloseHandle( file );
+        if (!ret) DeleteFileW( ico );
+    }
+    for (i = 0; i < count; i++) free( images[i].data );
+    return ret;
+}
+
+/* where a package's icons are kept: the user's (or the machine's) AppIcons folder */
+static BOOL icon_path( const WCHAR *family, const WCHAR *app, const WCHAR *name, WCHAR *out, size_t size )
+{
+    WCHAR base[MAX_PATH], file_name[MAX_PATH];
+
+    if (FAILED(SHGetFolderPathW( NULL, caller_is_system() ? CSIDL_COMMON_APPDATA : CSIDL_LOCAL_APPDATA, NULL,
+                                 SHGFP_TYPE_CURRENT, base ))) return FALSE;
+    if (swprintf( file_name, ARRAY_SIZE(file_name), name ? L"%s-%s" : L"%s", app, name ) < 0) return FALSE;
+    safe_file_name( file_name );
+    return swprintf( out, size, L"%s\\Microsoft\\Windows\\AppIcons\\%s\\%s.ico", base, family, file_name ) >= 0;
+}
+
+/* An application's logo as an icon, recorded; NULL when it has none. */
+static WCHAR *app_icon( const struct package_record *rec, const WCHAR *app, const WCHAR *name, const WCHAR *logo,
+                        struct strlist *integration )
+{
+    WCHAR path[MAX_PATH], entry[MAX_PATH + 2];
+
+    if (!rec->family_name || !icon_path( rec->family_name, app, name, path, ARRAY_SIZE(path) )) return NULL;
+#ifdef SG_MUTANT_PKGINT_NO_ICON
+    return NULL;
+#endif
+    if (!write_logo_icon( content_root( rec ), logo, path )) return NULL;
+    swprintf( entry, ARRAY_SIZE(entry), L"I:%s", path );
+    if (!multi_contains( integration->data, entry )) strlist_add( integration, entry );
+    return wcsdup( path );
+}
+
+/* ---- the manifest's extensions ---- */
+
+struct app_context
+{
+    WCHAR *id, *exe, *display, *logo;
+    WCHAR aumid[256];
+    WCHAR app_key[32];          /* the application's own key below Classes: Application, Capabilities */
+    BOOL registered;            /* named in RegisteredApplications */
+};
+
+static void app_context_clear( struct app_context *app )
+{
+    free( app->id );
+    free( app->exe );
+    free( app->display );
+    free( app->logo );
+    memset( app, 0, sizeof(*app) );
+}
+
+/* the command line that runs the application for a scheme or a file */
+static BOOL handler_command( const struct package_record *rec, const struct app_context *app, const WCHAR *exe,
+                             const WCHAR *parameters, WCHAR *out, size_t size )
+{
+    WCHAR target[MAX_PATH];
+
+    if (!exe) exe = app->exe;
+    if (!exe || !payload_path( content_root( rec ), exe, target, ARRAY_SIZE(target) )) return FALSE;
+    return swprintf( out, size, L"\"%s\" %s", target, parameters ? parameters : L"\"%1\"" ) >= 0;
+}
+
+/* the application's Capabilities, named in RegisteredApplications once */
+static void app_capability( HKEY hive, const struct package_record *rec, struct app_context *app, const WCHAR *kind,
+                            const WCHAR *name, const WCHAR *progid, struct strlist *integration )
+{
+    WCHAR path[MAX_PATH], entry[300];
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Capabilities\\%s", app->app_key, kind );
+    if (!(key = create_classes_key( hive, path ))) return;
+    reg_set_string( key, name, progid );
+    RegCloseKey( key );
+    if (app->registered) return;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Capabilities", app->app_key );
+    if ((key = create_classes_key( hive, path )))
+    {
+        reg_set_string( key, L"ApplicationName", app->display ? app->display : rec->display_name );
+        reg_set_string( key, L"ApplicationDescription", rec->description );
+        RegCloseKey( key );
+    }
+    if ((key = create_classes_key( hive, app->app_key )))
+    {
+        set_sub_string( key, L"Application", L"AppUserModelID", app->aumid );
+        set_sub_string( key, L"Application", L"ApplicationName", app->display ? app->display : rec->display_name );
+        RegCloseKey( key );
+    }
+    swprintf( entry, ARRAY_SIZE(entry), L"K:%s", app->app_key );
+    strlist_add( integration, entry );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s\\Capabilities", CLASSES_PATH, app->app_key );
+    set_value_view( hive, REGISTERED_APPS_PATH, app->aumid, path );
+    swprintf( entry, ARRAY_SIZE(entry), L"R:%s", app->aumid );
+    strlist_add( integration, entry );
+    app->registered = TRUE;
+}
+
+static void register_protocol( HKEY hive, const struct package_record *rec, struct app_context *app, const WCHAR *exe,
+                               const WCHAR *scheme, const WCHAR *parameters, struct strlist *integration )
+{
+    WCHAR progid[32], command[MAX_PATH * 3], description[300], entry[300], icon[MAX_PATH + 4] = { 0 };
+    WCHAR target[MAX_PATH];
+    const WCHAR *p;
+
+    if (!scheme || !scheme[0] || wcslen( scheme ) > 64) return;
+    for (p = scheme; *p; p++) if (!iswalnum( *p ) && !wcschr( L"+-.", *p )) return;
+    if (!handler_command( rec, app, exe, parameters, command, ARRAY_SIZE(command) )) return;
+    if (payload_path( content_root( rec ), exe ? exe : app->exe, target, ARRAY_SIZE(target) ))
+        swprintf( icon, ARRAY_SIZE(icon), L"\"%s\",0", target );
+    appx_progid( rec->family_name, app->id, L"protocol", scheme, progid );
+    swprintf( description, ARRAY_SIZE(description), L"URL:%s", scheme );
+    if (!write_handler( hive, progid, description, TRUE, app->aumid, app->display, icon, command )) return;
+    swprintf( entry, ARRAY_SIZE(entry), L"K:%s", progid );
+    strlist_add( integration, entry );
+    app_capability( hive, rec, app, L"URLAssociations", scheme, progid, integration );
+#ifndef SG_MUTANT_PKGINT_NO_SCHEME
+    /* the scheme itself, while no other program has it */
+    if (!classes_have( scheme, FALSE ) &&
+        write_handler( hive, scheme, description, TRUE, app->aumid, app->display, icon, command ))
+    {
+        swprintf( entry, ARRAY_SIZE(entry), L"S:%s", scheme );
+        strlist_add( integration, entry );
+    }
+#endif
+    TRACE( "protocol %s -> %s\n", debugstr_w( scheme ), debugstr_w( command ) );
+}
+
+struct file_types
+{
+    WCHAR *name, *parameters, *display, *logo, *exe;
+    struct strlist extensions;
+};
+
+static void register_file_types( HKEY hive, const struct package_record *rec, struct app_context *app,
+                                 const struct file_types *types, struct strlist *integration )
+{
+    WCHAR progid[32], command[MAX_PATH * 3], entry[300], icon_value[MAX_PATH + 4] = { 0 }, target[MAX_PATH];
+    WCHAR *icon, *ext, path[MAX_PATH];
+    HKEY key;
+
+    if (!types->name || !types->extensions.data) return;
+    if (!handler_command( rec, app, types->exe, types->parameters, command, ARRAY_SIZE(command) )) return;
+    if ((icon = app_icon( rec, app->id, types->name, types->logo, integration )))
+        swprintf( icon_value, ARRAY_SIZE(icon_value), L"%s,0", icon );
+    else if (payload_path( content_root( rec ), types->exe ? types->exe : app->exe, target, ARRAY_SIZE(target) ))
+        swprintf( icon_value, ARRAY_SIZE(icon_value), L"\"%s\",0", target );
+    free( icon );
+    appx_progid( rec->family_name, app->id, L"file", types->name, progid );
+    if (!write_handler( hive, progid, types->display ? types->display : types->name, FALSE, app->aumid,
+                        app->display, icon_value, command )) return;
+    swprintf( entry, ARRAY_SIZE(entry), L"K:%s", progid );
+    strlist_add( integration, entry );
+
+    for (ext = types->extensions.data; *ext; ext += wcslen( ext ) + 1)
+    {
+        BOOL take_default;
+
+        if (ext[0] != '.' || wcslen( ext ) > 64 || wcspbrk( ext, L"\\/ " )) continue;
+        take_default = !classes_have( ext, TRUE );
+        swprintf( path, ARRAY_SIZE(path), L"%s\\OpenWithProgids", ext );
+        if (!(key = create_classes_key( hive, path ))) continue;
+        RegSetValueExW( key, progid, 0, REG_NONE, NULL, 0 );
+        RegCloseKey( key );
+#ifndef SG_MUTANT_PKGINT_NO_EXT_DEFAULT
+        if (take_default && (key = create_classes_key( hive, ext )))
+        {
+            reg_set_string( key, NULL, progid );
+            RegCloseKey( key );
+        }
+#endif
+        swprintf( entry, ARRAY_SIZE(entry), L"E:%s:%s", ext, progid );
+        strlist_add( integration, entry );
+        app_capability( hive, rec, app, L"FileAssociations", ext, progid, integration );
+        TRACE( "file type %s -> %s%s\n", debugstr_w( ext ), debugstr_w( progid ), take_default ? " (default)" : "" );
+    }
+}
