+static void register_startup_task( HKEY hive, const struct package_record *rec, struct app_context *app, const WCHAR *exe,
+                                   const WCHAR *task, const WCHAR *enabled, struct strlist *integration )
+{
+    WCHAR target[MAX_PATH], command[MAX_PATH + 2], name[300], entry[310];
+
+    if (!task || !rec->family_name) return;
+    /* a task the manifest leaves disabled waits for the application to enable it */
+    if (!enabled || wcsicmp( enabled, L"true" )) return;
+    if (!payload_path( content_root( rec ), exe ? exe : app->exe, target, ARRAY_SIZE(target) )) return;
+    swprintf( command, ARRAY_SIZE(command), L"\"%s\"", target );
+    swprintf( name, ARRAY_SIZE(name), L"%s!%s", rec->family_name, task );
+    if (set_value_view( hive, RUN_PATH, name, command )) return;
+    swprintf( entry, ARRAY_SIZE(entry), L"U:%s", name );
+    strlist_add( integration, entry );
+    TRACE( "startup task %s -> %s\n", debugstr_w( name ), debugstr_w( command ) );
+}
+
+/* the text of the element the reader is on; NULL for an empty one */
+static WCHAR *xml_text( IXmlReader *reader )
+{
+    XmlNodeType type;
+    const WCHAR *value;
+
+    if (IXmlReader_IsEmptyElement( reader )) return NULL;
+    if (IXmlReader_Read( reader, &type ) != S_OK || type != XmlNodeType_Text) return NULL;
+    if (FAILED(IXmlReader_GetValue( reader, &value, NULL ))) return NULL;
+    return wcsdup( value );
+}
+
+/* a FileTypeAssociation element, read to its end */
+static void read_file_types( IXmlReader *reader, struct file_types *types )
+{
+    UINT depth, start;
+    XmlNodeType type;
+
+    types->name = xml_attribute( reader, L"Name" );
+    types->parameters = xml_attribute( reader, L"Parameters" );
+    if (IXmlReader_IsEmptyElement( reader )) return;
+    IXmlReader_GetDepth( reader, &start );
+    while (IXmlReader_Read( reader, &type ) == S_OK)
+    {
+        const WCHAR *name;
+
+        IXmlReader_GetDepth( reader, &depth );
+        if (type == XmlNodeType_EndElement && depth <= start) break;
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        if (!wcscmp( name, L"FileType" ))
+        {
+            WCHAR *ext = xml_text( reader ), *p;
+            if (ext)
+            {
+                for (p = ext; *p; p++) *p = towlower( *p );
+                if (!multi_contains( types->extensions.data, ext )) strlist_add( &types->extensions, ext );
+            }
+            free( ext );
+        }
+        else if (!wcscmp( name, L"DisplayName" ) && depth == start + 1 && !types->display)
+            types->display = xml_text( reader );
+        else if (!wcscmp( name, L"Logo" ) && depth == start + 1 && !types->logo)
+            types->logo = xml_text( reader );
+    }
+    /* ms-resource: names are not names */
+    if (types->display && !wcsnicmp( types->display, L"ms-resource:", 12 ))
+    {
+        free( types->display );
+        types->display = NULL;
+    }
+}
+
+/* The applications' protocols, file types and startup tasks. */
+static void register_integration( IAppxManifestReader *manifest, const struct package_record *rec,
+                                  struct strlist *integration )
+{
+    struct app_context app = { 0 };
+    IXmlReader *reader = NULL;
+    IStream *stream = NULL;
+    XmlNodeType type;
+    WCHAR *ext_exe = NULL;
+    UINT app_depth = 0, ext_depth = 0;
+    HKEY hive = own_hive();
+
+    if (!rec->family_name) return;
+    if (FAILED(IAppxManifestReader_GetStream( manifest, &stream ))) return;
+    if (FAILED(CreateXmlReader( &IID_IXmlReader, (void **)&reader, NULL ))) goto done;
+    IXmlReader_SetProperty( reader, XmlReaderProperty_DtdProcessing, DtdProcessing_Prohibit );
+    if (FAILED(IXmlReader_SetInput( reader, (IUnknown *)stream ))) goto done;
+
+    while (IXmlReader_Read( reader, &type ) == S_OK)
+    {
+        const WCHAR *name;
+        UINT depth;
+
+        if (type != XmlNodeType_Element) continue;
+        IXmlReader_GetLocalName( reader, &name, NULL );
+        IXmlReader_GetDepth( reader, &depth );
+        if (ext_depth && depth <= ext_depth)
+        {
+            ext_depth = 0;
+            free( ext_exe );
+            ext_exe = NULL;
+        }
+        if (app_depth && depth <= app_depth)
+        {
+            app_depth = 0;
+            app_context_clear( &app );
+        }
+        if (!wcscmp( name, L"Application" ) && depth == 2)
+        {
+            app_depth = depth;
+            app.id = xml_attribute( reader, L"Id" );
+            app.exe = xml_attribute( reader, L"Executable" );
+            if (!app.id || swprintf( app.aumid, ARRAY_SIZE(app.aumid), L"%s!%s", rec->family_name, app.id ) < 0)
+            {
+                app_context_clear( &app );
+                app_depth = 0;
+                continue;
+            }
+            appx_progid( rec->family_name, app.id, L"application", NULL, app.app_key );
+            continue;
+        }
+        if (!app_depth) continue;
+        if (!wcscmp( name, L"VisualElements" ) && depth == app_depth + 1)
+        {
+            app.display = xml_attribute( reader, L"DisplayName" );
+            app.logo = xml_attribute( reader, L"Square44x44Logo" );
+            if (app.display && !wcsnicmp( app.display, L"ms-resource:", 12 ))
+            {
+                free( app.display );
+                app.display = NULL;
+            }
+            if (!app.display && rec->display_name && wcsnicmp( rec->display_name, L"ms-resource:", 12 ))
+                app.display = wcsdup( rec->display_name );
+        }
+        else if (!wcscmp( name, L"Extension" ))
+        {
+            ext_depth = depth;
+            free( ext_exe );
+            ext_exe = xml_attribute( reader, L"Executable" );
+        }
+        else if (ext_depth && !wcscmp( name, L"Protocol" ))
+        {
+            WCHAR *scheme = xml_attribute( reader, L"Name" ), *parameters = xml_attribute( reader, L"Parameters" );
+            WCHAR *p;
+
+            if (scheme) for (p = scheme; *p; p++) *p = towlower( *p );
+            register_protocol( hive, rec, &app, ext_exe, scheme, parameters, integration );
+            free( scheme );
+            free( parameters );
+        }
+        else if (ext_depth && !wcscmp( name, L"FileTypeAssociation" ))
+        {
+            struct file_types types = { 0 };
+
+            types.exe = ext_exe;
+            read_file_types( reader, &types );
+            register_file_types( hive, rec, &app, &types, integration );
+            free( types.name );
+            free( types.parameters );
+            free( types.display );
+            free( types.logo );
+            free( types.extensions.data );
+        }
+        else if (ext_depth && !wcscmp( name, L"StartupTask" ))
+        {
+            WCHAR *task = xml_attribute( reader, L"TaskId" ), *enabled = xml_attribute( reader, L"Enabled" );
+
+            register_startup_task( hive, rec, &app, ext_exe, task, enabled, integration );
+            free( task );
+            free( enabled );
+        }
+    }
+
+done:
+    app_context_clear( &app );
+    free( ext_exe );
+    if (reader) IXmlReader_Release( reader );
+    IStream_Release( stream );
+}
+
+static void record_integration( const WCHAR *full_name, const struct strlist *list )
+{
+    WCHAR path[MAX_PATH];
+    HKEY key;
+
+    if (!list->data) return;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, full_name );
+    if (RegOpenKeyExW( own_hive(), path, 0, KEY_SET_VALUE | REC_VIEW, &key )) return;
+    reg_set_multi( key, INTEGRATION_VALUE, list );
+    RegCloseKey( key );
+}
+
+/* What register_integration wrote for a package, taken away; a scheme or an extension another
+ * program has taken over since stays that program's. */
+static void unregister_integration( HKEY record, HKEY hive, const WCHAR *root )
+{
+    WCHAR *list, *p, path[MAX_PATH];
+
+#ifdef SG_MUTANT_PKGINT_KEEP
+    return;
+#endif
+    if (!(list = reg_multi( record, INTEGRATION_VALUE ))) return;
+    for (p = list; *p; p += wcslen( p ) + 1)
+    {
+        const WCHAR *arg = p + 2;
+
+        if (p[1] != ':') continue;
+        switch (p[0])
+        {
+        case 'S':
+            /* a scheme that still runs this package's program */
+            if (!root || !handler_is_ours( hive, arg, root )) break;
+            /* fall through */
+        case 'K':
+            /* this package's own ProgIDs and application keys */
+            if (!wcschr( arg, '\\' ))
+            {
+                swprintf( path, ARRAY_SIZE(path), L"%s\\%s", CLASSES_PATH, arg );
+                delete_tree_64( hive, path );
+            }
+            break;
+        case 'E':
+        {
+            const WCHAR *colon = wcschr( arg + 1, ':' );
+            WCHAR ext[80], value[64];
+            DWORD size = sizeof(value), subkeys = 0, values = 0;
+            HKEY key, sub;
+
+            if (!colon || colon - arg >= ARRAY_SIZE(ext)) break;
+            lstrcpynW( ext, arg, colon - arg + 1 );
+            swprintf( path, ARRAY_SIZE(path), L"%s\\%s\\OpenWithProgids", CLASSES_PATH, ext );
+            delete_value_view( hive, path, colon + 1 );
+            swprintf( path, ARRAY_SIZE(path), L"%s\\%s", CLASSES_PATH, ext );
+            if (RegOpenKeyExW( hive, path, 0, KEY_ALL_ACCESS | REC_VIEW, &key )) break;
+            if (!RegGetValueW( key, NULL, NULL, RRF_RT_REG_SZ, NULL, value, &size ) && !wcscmp( value, colon + 1 ))
+                RegDeleteValueW( key, NULL );
+            /* an empty OpenWithProgids and nothing else: the key was this package's */
+            if (!RegOpenKeyExW( key, L"OpenWithProgids", 0, KEY_READ, &sub ))
+            {
+                RegQueryInfoKeyW( sub, NULL, NULL, NULL, &subkeys, NULL, NULL, &values, NULL, NULL, NULL, NULL );
+                RegCloseKey( sub );
+                if (!subkeys && !values) RegDeleteKeyW( key, L"OpenWithProgids" );
+            }
+            subkeys = values = 0;
+            RegQueryInfoKeyW( key, NULL, NULL, NULL, &subkeys, NULL, NULL, &values, NULL, NULL, NULL, NULL );
+            RegCloseKey( key );
+            if (!subkeys && !values) delete_tree_64( hive, path );
+            break;
+        }
+        case 'R':
+            delete_value_view( hive, REGISTERED_APPS_PATH, arg );
+            break;
+        case 'U':
+            delete_value_view( hive, RUN_PATH, arg );
+            break;
+        case 'I':
+        {
+            WCHAR *slash;
+
+            DeleteFileW( arg );
+            lstrcpynW( path, arg, ARRAY_SIZE(path) );
+            if ((slash = wcsrchr( path, '\\' ))) *slash = 0;
+            RemoveDirectoryW( path );
+            break;
+        }
+        }
+    }
+    free( list );
+}
