+/* A gradient in one colour (where it is not drawn as one, a text colour): its colours averaged
+ * along it (each part between two stops the mean of theirs; before the first and after the last,
+ * theirs). */
+static BOOL gradient_color( struct brush *brush, struct xcolor *color )
+{
+    struct xgradient_stop list[64];
+    DOUBLE sum[4] = { 0 };
+    UINT32 count, i;
+
+#ifdef SG_MUTANT_GRADIENT_NO_COLOR
+    return FALSE;
+#endif
+    if (!(count = gradient_stop_list( brush, list, ARRAY_SIZE(list) ))) return FALSE;
 #define ADD(c, w) do { sum[0] += (c).a * (w); sum[1] += (c).r * (w); sum[2] += (c).g * (w); sum[3] += (c).b * (w); } while (0)
-    ADD( cols[0], offs[0] );
+    ADD( list[0].color, list[0].offset );
     for (i = 1; i < count; i++)
     {
-        DOUBLE w = (offs[i] - offs[i - 1]) / 2;
-        ADD( cols[i - 1], w );
-        ADD( cols[i], w );
+        DOUBLE w = (list[i].offset - list[i - 1].offset) / 2;
+        ADD( list[i - 1].color, w );
+        ADD( list[i].color, w );
     }
-    ADD( cols[count - 1], 1 - offs[count - 1] );
+    ADD( list[count - 1].color, 1 - list[count - 1].offset );
 #undef ADD
-    (void)prev_offset;
     color->a = (BYTE)(sum[0] + 0.5);
     color->r = (BYTE)(sum[1] + 0.5);
     color->g = (BYTE)(sum[2] + 0.5);
@@ -999,6 +1004,29 @@ BOOL xaml_brush_image( IInspectable *brush_iface, IInspectable **source, INT32 *
     return TRUE;
 }
 
+/* a LinearGradientBrush: its stops, ends, MappingMode (0 Absolute, 1 relative), SpreadMethod, opacity */
+BOOL xaml_brush_gradient( IInspectable *brush_iface, struct xgradient *gradient )
+{
+    struct dobj *obj = dobj_from_inspectable( brush_iface );
+    struct brush *brush;
+    IInspectable *box = NULL;
+
+#ifdef SG_MUTANT_GRADIENT_NOT_DRAWN
+    return FALSE;
+#endif
+    if (!obj || obj->obj.cls != &linear_class) return FALSE;
+    brush = CONTAINING_RECORD( obj, struct brush, d );
+    if (!(gradient->count = gradient_stop_list( brush, gradient->stops, ARRAY_SIZE(gradient->stops) ))) return FALSE;
+    get_point( brush, prop_start_point, &gradient->start );
+    get_point( brush, prop_end_point, &gradient->end );
+    get_int_prop( brush, prop_mapping_mode, &gradient->mapping, 1 );
+    get_int_prop( brush, prop_spread_method, &gradient->spread, 0 );
+    dobj_get_value( &brush->d, prop_brush_opacity, &box );
+    gradient->opacity = fmin( fmax( xunbox_double( box, 1.0 ), 0 ), 1 );
+    if (box) IInspectable_Release( box );
+    return TRUE;
+}
+
 IInspectable *xaml_solid_brush( struct xcolor color )
 {
     struct brush *brush = new_brush( BRUSH_SOLID, NULL );
