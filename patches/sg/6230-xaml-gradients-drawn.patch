From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: linear gradients drawn as gradients

A LinearGradientBrush (6229) was drawn in the mean of its colours. Backgrounds and borders of panels, borders and controls now draw it as a gradient: a Direct2D linear gradient over the area, its ends relative to the area (RelativeToBoundingBox) or in pixels from its corner (Absolute), its SpreadMethod (Pad, Reflect, Repeat) and opacity. Where one colour is needed (text, our own controls' parts) the mean stays.
---
diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
index 60e6511..248b4b4 100644
--- a/dlls/windows.ui.xaml/control.c
+++ b/dlls/windows.ui.xaml/control.c
@@ -380,7 +380,8 @@ void control_render( struct uielem *elem, struct xdraw *draw )
     get_ref( control, prop_corner_radius, &IID_IReference_CornerRadius, &corner, sizeof(corner) );
     get_ref( control, prop_border_thickness, &IID_IReference_Thickness, &thickness, sizeof(thickness) );
     dobj_get_value( &elem->d, prop_background, &brush );
-    if (brush && xaml_brush_color( brush, &color )) xdraw_fill( draw, &rect, color, &corner );
+    if (brush && xdraw_fill_brush( draw, &rect, brush, &corner )) ;
+    else if (brush && xaml_brush_color( brush, &color )) xdraw_fill( draw, &rect, color, &corner );
     else if (brush)
     {
         FLOAT r = fmax( fmax( corner.top_left, corner.top_right ), fmax( corner.bottom_right, corner.bottom_left ) );
@@ -389,7 +390,8 @@ void control_render( struct uielem *elem, struct xdraw *draw )
     if (brush) IInspectable_Release( brush );
     brush = NULL;
     dobj_get_value( &elem->d, prop_border_brush, &brush );
-    if (brush && xaml_brush_color( brush, &color )) xdraw_border( draw, &rect, &thickness, color, &corner );
+    if (brush && xdraw_border_brush( draw, &rect, &thickness, brush, &corner )) ;
+    else if (brush && xaml_brush_color( brush, &color )) xdraw_border( draw, &rect, &thickness, color, &corner );
     if (brush) IInspectable_Release( brush );
 }
 
