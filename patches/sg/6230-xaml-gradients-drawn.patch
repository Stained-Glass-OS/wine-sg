-    for (i = 0; i < n && count < ARRAY_SIZE(offs); i++)
+    for (i = 0; i < n && count < max; i++)
     {
         IInspectable *item = NULL;
         struct dobj *obj;
@@ -836,32 +828,45 @@ static BOOL gradient_color( struct brush *brush, struct xcolor *color )
         if (item) IInspectable_Release( item );
         if (!obj || obj->obj.cls != &stop_class) continue;
         stop = CONTAINING_RECORD( obj, struct gradient_stop, d );
-        stop_get_Offset( &stop->IGradientStop_iface, &offs[count] );
