From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: resources of a language-neutral module from its MUI file

A language-neutral module carries only a "MUI" resource; its strings, menus and dialogs are in
<dir>\<language>\<name>.mui, and Windows' resource loader finds them there. Wine looked in the
module only, so FindResource failed with ERROR_RESOURCE_TYPE_NOT_FOUND. Notepad3 loads
lng\np3lng.dll that way (LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE) when the UI
language is not English (US), found none of its texts, failed to show the error dialog and exited:
no window from Start.

When FindResourceEx does not find a resource in a module whose "MUI" resource marks it
language-neutral (file type MUI_FILETYPE_LANGUAGE_NEUTRAL_MAIN), it looks in the module's MUI file,
for the thread's, the user's and the system's UI language, the fallback language the module names
and en-US, each then as its neutral language; LoadResource reads entries of that file from it.
The MUI file is looked for once per module and freed with it. Data-file modules remember the file
they were loaded from, which GetModuleFileName does not know.
---
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -56,6 +56,73 @@
 };
 static CRITICAL_SECTION exclusive_datafile_list_section = { &critsect_debug, -1, 0, 0, 0, 0 };
 
+/* Stained Glass OS (8411): a language-neutral module keeps its resources in a MUI file beside it,
+ * <dir>\<language>\<name>.mui; FindResource falls back to that file and LoadResource reads from it, as
+ * Windows' resource loader does.  One link per module: the file a data-file module was loaded from
+ * (GetModuleFileName does not know those), and its MUI file once looked for. */
+struct mui_link
+{
+    struct list entry;
+    HMODULE     module;
+    WCHAR      *path;      /* data-file modules: the file; NULL: ask GetModuleFileName */
+    BOOL        looked;    /* the MUI file was looked for */
+    HMODULE     mui;       /* the MUI file, 0 when there is none */
+};
+static struct list mui_links = LIST_INIT( mui_links );
+
+static CRITICAL_SECTION mui_links_section;
+static CRITICAL_SECTION_DEBUG mui_links_critsect_debug =
+{
+    0, 0, &mui_links_section,
+    { &mui_links_critsect_debug.ProcessLocksList, &mui_links_critsect_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mui_links_section") }
+};
+static CRITICAL_SECTION mui_links_section = { &mui_links_critsect_debug, -1, 0, 0, 0, 0 };
+
+/* the link of a module; with add, made when missing (call with mui_links_section held) */
+static struct mui_link *get_mui_link( HMODULE module, BOOL add )
+{
+    struct mui_link *link;
+
+    LIST_FOR_EACH_ENTRY( link, &mui_links, struct mui_link, entry )
+        if (link->module == module) return link;
+    if (!add || !(link = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*link) ))) return NULL;
+    link->module = module;
+    list_add_head( &mui_links, &link->entry );
+    return link;
+}
+
+static void remember_datafile_path( HMODULE module, const WCHAR *path )
+{
+    struct mui_link *link;
+    WCHAR *copy;
+
+    if (!(copy = HeapAlloc( GetProcessHeap(), 0, (lstrlenW( path ) + 1) * sizeof(WCHAR) ))) return;
+    lstrcpyW( copy, path );
+    RtlEnterCriticalSection( &mui_links_section );
+    if ((link = get_mui_link( module, TRUE )) && !link->path) link->path = copy;
+    else HeapFree( GetProcessHeap(), 0, copy );
+    RtlLeaveCriticalSection( &mui_links_section );
+}
+
+/* the module is gone: forget it and free its MUI file */
+static void drop_mui_link( HMODULE module )
+{
+    struct mui_link *link;
+    HMODULE mui = 0;
+
+    RtlEnterCriticalSection( &mui_links_section );
+    if ((link = get_mui_link( module, FALSE )))
+    {
+        list_remove( &link->entry );
+        mui = link->mui;
+        HeapFree( GetProcessHeap(), 0, link->path );
+        HeapFree( GetProcessHeap(), 0, link );
+    }
+    RtlLeaveCriticalSection( &mui_links_section );
+    if (mui) FreeLibrary( mui );
+}
+
