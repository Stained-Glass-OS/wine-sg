+/* Stained Glass OS: a share that refuses a guest -- a Windows PC's, as
+ * Windows 10 and 11 set them -- asks for a name and password, as Windows'
+ * "Enter network credentials" does, and connects with them for this user
+ * (WNetAddConnection2 -> ntlanman -> sg-netmountd LOGON). It showed an empty
+ * folder. A Cancel is remembered for a little while: a tree view binds to a
+ * share more than once. */
+static void net_logon_if_needed(HWND owner, const WCHAR *server, const WCHAR *share)
+{
+    static WCHAR cancelled[300];
+    static DWORD cancelled_tick;
+    DWORD (WINAPI *prompt)(CREDUI_INFOW *, const WCHAR *, void *, DWORD, WCHAR *, ULONG, WCHAR *, ULONG, BOOL *, DWORD);
+    DWORD (WINAPI *connect)(NETRESOURCEW *, const WCHAR *, const WCHAR *, DWORD);
+    WCHAR unc[300], user[CREDUI_MAX_USERNAME_LENGTH + 1] = L"", password[CREDUI_MAX_PASSWORD_LENGTH + 1];
+    WCHAR message[400];
+    CREDUI_INFOW info = { sizeof(info) };
+    NETRESOURCEW resource = { 0 };
+    HMODULE credui, mpr;
+    DWORD rc = 0, attempt;
+    BOOL save = FALSE;
+
+    if (!share[0]) return;
+    swprintf(unc, ARRAY_SIZE(unc), L"\\\\%s\\%s", server, share);
+    if (!wcsicmp(unc, cancelled) && GetTickCount() - cancelled_tick < 30000) return;
+    if (GetFileAttributesW(unc) != INVALID_FILE_ATTRIBUTES) return;
+    if (!(credui = LoadLibraryW(L"credui.dll")) || !(mpr = LoadLibraryW(L"mpr.dll"))) return;
+    prompt = (void *)GetProcAddress(credui, "CredUIPromptForCredentialsW");
+    connect = (void *)GetProcAddress(mpr, "WNetAddConnection2W");
+    if (!prompt || !connect) return;
+
+    swprintf(message, ARRAY_SIZE(message), L"Enter your credentials to connect to: %s", server);
+    info.hwndParent = owner ? owner : GetActiveWindow();
+    info.pszMessageText = message;
+    info.pszCaptionText = L"Enter network credentials";
+    resource.dwType = RESOURCETYPE_DISK;
+    resource.lpRemoteName = unc;
+    for (attempt = 0; attempt < 3; attempt++)
+    {
+        password[0] = 0;
+        if (prompt(&info, server, NULL, attempt ? rc : 0, user, ARRAY_SIZE(user), password, ARRAY_SIZE(password), &save,
+                   CREDUI_FLAGS_GENERIC_CREDENTIALS | CREDUI_FLAGS_DO_NOT_PERSIST | CREDUI_FLAGS_ALWAYS_SHOW_UI |
+                   (attempt ? CREDUI_FLAGS_INCORRECT_PASSWORD : 0)))
+        {
+            lstrcpynW(cancelled, unc, ARRAY_SIZE(cancelled));
+            cancelled_tick = GetTickCount();
+            break;
+        }
+        rc = connect(&resource, password, user, 0);
+        SecureZeroMemory(password, sizeof(password));
+        TRACE("connect %s as %s: %lu\n", debugstr_w(unc), debugstr_w(user), rc);
+        if (!rc) break;
+        if (rc != ERROR_LOGON_FAILURE && rc != ERROR_ACCESS_DENIED && rc != WN_ACCESS_DENIED) break;
+    }
+}
