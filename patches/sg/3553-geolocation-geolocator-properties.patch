+    if (value != PositionAccuracy_Default && value != PositionAccuracy_High) return E_INVALIDARG;
+    impl->accuracy = value;
+    return S_OK;
 }
 
 HRESULT WINAPI geolocator_get_MovementThreshold(IGeolocator *iface, DOUBLE *value)
 {
-    FIXME("iface %p, value %p stub.\n", iface, value);
-    return E_NOTIMPL;
