--- a/dlls/geolocation/tests/geolocator.c
+++ b/dlls/geolocation/tests/geolocator.c
@@ -93,6 +93,66 @@
     IInspectable_Release(inspectable);
     inspectable = 0;
 
+    {
+        PositionAccuracy accuracy = 0xdeadbeef;
+        PositionStatus status = 0xdeadbeef;
+        EventRegistrationToken token, token2;
+        TrustLevel trust = 0xdeadbeef;
+        HSTRING name = NULL;
+        DOUBLE threshold = -1.0;
+        UINT32 interval = 0xdeadbeef;
+        ULONG count = 0;
+        IID *iids = NULL;
+        const WCHAR *buf;
+
+        hr = IGeolocator_get_DesiredAccuracy(geolocator, &accuracy);
+        ok(hr == S_OK && accuracy == PositionAccuracy_Default, "got hr %#lx, accuracy %d.\n", hr, accuracy);
+        hr = IGeolocator_put_DesiredAccuracy(geolocator, PositionAccuracy_High);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IGeolocator_get_DesiredAccuracy(geolocator, &accuracy);
+        ok(hr == S_OK && accuracy == PositionAccuracy_High, "got hr %#lx, accuracy %d.\n", hr, accuracy);
+        hr = IGeolocator_put_DesiredAccuracy(geolocator, 5);
+        ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+        hr = IGeolocator_get_DesiredAccuracy(geolocator, NULL);
+        ok(hr == E_POINTER, "got hr %#lx.\n", hr);
+
+        hr = IGeolocator_get_MovementThreshold(geolocator, &threshold);
+        ok(hr == S_OK && threshold == 0.0, "got hr %#lx, threshold %f.\n", hr, threshold);
+        hr = IGeolocator_put_MovementThreshold(geolocator, 12.5);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IGeolocator_get_MovementThreshold(geolocator, &threshold);
+        ok(hr == S_OK && threshold == 12.5, "got hr %#lx, threshold %f.\n", hr, threshold);
+
+        hr = IGeolocator_get_ReportInterval(geolocator, &interval);
+        ok(hr == S_OK && interval == 0, "got hr %#lx, interval %u.\n", hr, interval);
+        hr = IGeolocator_put_ReportInterval(geolocator, 3000);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IGeolocator_get_ReportInterval(geolocator, &interval);
+        ok(hr == S_OK && interval == 3000, "got hr %#lx, interval %u.\n", hr, interval);
+
+        hr = IGeolocator_get_LocationStatus(geolocator, &status);
+        ok(hr == S_OK && status == PositionStatus_NotAvailable, "got hr %#lx, status %d.\n", hr, status);
+
+        hr = IGeolocator_GetIids(geolocator, &count, &iids);
+        ok(hr == S_OK && count == 1 && IsEqualGUID(&iids[0], &IID_IGeolocator), "got hr %#lx, count %lu.\n", hr, count);
+        CoTaskMemFree(iids);
+        hr = IGeolocator_GetRuntimeClassName(geolocator, &name);
+        buf = WindowsGetStringRawBuffer(name, NULL);
+        ok(hr == S_OK && !wcscmp(buf, L"Windows.Devices.Geolocation.Geolocator"), "got hr %#lx.\n", hr);
+        WindowsDeleteString(name);
+        hr = IGeolocator_GetTrustLevel(geolocator, &trust);
+        ok(hr == S_OK && trust == BaseTrust, "got hr %#lx, trust %d.\n", hr, trust);
+
+        hr = IGeolocator_add_PositionChanged(geolocator, (void *)0xdead, &token);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IGeolocator_add_StatusChanged(geolocator, (void *)0xdead, &token2);
+        ok(hr == S_OK && token2.value != token.value, "got hr %#lx.\n", hr);
+        hr = IGeolocator_remove_PositionChanged(geolocator, token);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IGeolocator_remove_StatusChanged(geolocator, token2);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+    }
+
     hr = IGeolocator_QueryInterface(geolocator, &IID_IWeakReferenceSource, (void **)&weak_reference_source);
     ok(hr == S_OK && weak_reference_source, "got hr %#lx.\n", hr);
 
