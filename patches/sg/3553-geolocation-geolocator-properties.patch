From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] geolocation: Geolocator properties and events (3553)

geolocation: Geolocator properties, events and inspectable methods

DesiredAccuracy (Default/High), MovementThreshold (>= 0), ReportInterval keep their values; LocationStatus
reports NotAvailable (there is no location source); PositionChanged / StatusChanged accept handlers and
hand out distinct tokens, remove succeeds. GetIids / GetRuntimeClassName / GetTrustLevel on the Geolocator and
its factory. GetGeopositionAsync stays unimplemented (no source of positions).
---
--- a/dlls/geolocation/main.c
+++ b/dlls/geolocation/main.c
@@ -37,8 +37,36 @@
     IWeakReference IWeakReference_iface;
     LONG ref_public;
     LONG ref_weak;
+
+    PositionAccuracy accuracy;
+    DOUBLE threshold;
+    UINT32 interval;
+    LONGLONG next_token;
 };
 
+static HRESULT get_one_iid(const GUID *iid, ULONG *iid_count, IID **iids)
+{
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc(sizeof(IID)))) return E_OUTOFMEMORY;
+    **iids = *iid;
+    *iid_count = 1;
+    return S_OK;
+}
+
+static HRESULT get_class_name(HSTRING *class_name)
+{
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString(RuntimeClass_Windows_Devices_Geolocation_Geolocator,
+                               wcslen(RuntimeClass_Windows_Devices_Geolocation_Geolocator), class_name);
+}
+
+static HRESULT get_base_trust(TrustLevel *trust_level)
+{
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
 static inline struct geolocator *impl_from_IGeolocator(IGeolocator *iface)
 {
     return CONTAINING_RECORD(iface, struct geolocator, IGeolocator_iface);
@@ -92,62 +120,95 @@
 
 static HRESULT WINAPI geolocator_GetIids(IGeolocator *iface, ULONG *iid_count, IID **iids)
 {
-    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
-    return E_NOTIMPL;
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+    return get_one_iid(&IID_IGeolocator, iid_count, iids);
 }
 
 static HRESULT WINAPI geolocator_GetRuntimeClassName(IGeolocator *iface, HSTRING *class_name)
 {
-    FIXME("iface %p, class_name %p stub!\n", iface, class_name);
-    return E_NOTIMPL;
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+    return get_class_name(class_name);
 }
 
 static HRESULT WINAPI geolocator_GetTrustLevel(IGeolocator *iface, TrustLevel *trust_level)
 {
-    FIXME("iface %p, trust_level %p stub!\n", iface, trust_level);
-    return E_NOTIMPL;
+    TRACE("iface %p, trust_level %p.\n", iface, trust_level);
+    return get_base_trust(trust_level);
 }
 
 HRESULT WINAPI geolocator_get_DesiredAccuracy(IGeolocator *iface, PositionAccuracy *value)
 {
-    FIXME("iface %p, value %p stub.\n", iface, value);
-    return E_NOTIMPL;
+    struct geolocator *impl = impl_from_IGeolocator(iface);
+
+    TRACE("iface %p, value %p.\n", iface, value);
