From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:56:21 -0700
Subject: [PATCH] mscms: WcsGetUsePerUserProfiles (3278)

Returns TRUE with FALSE for a monitor, printer or scanner class (no per-user association list is kept), ERROR_INVALID_PARAMETER for a NULL argument or another class (GUESS for the code).

diff --git a/dlls/mscms/profile.c b/dlls/mscms/profile.c
index 395fe50..d110373 100644
--- a/dlls/mscms/profile.c
+++ b/dlls/mscms/profile.c
@@ -1442,9 +1442,20 @@ BOOL WINAPI CloseColorProfile( HPROFILE handle )
  */
 BOOL WINAPI WcsGetUsePerUserProfiles( const WCHAR* name, DWORD class, BOOL* use_per_user_profile )
 {
-    FIXME( "%s %s %p\n", debugstr_w(name), debugstr_fourcc(class), use_per_user_profile );
+    TRACE( "%s %s %p\n", debugstr_w(name), debugstr_fourcc(class), use_per_user_profile );
+
+#ifdef SG_MUTANT_WCS_PERUSER
     SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
     return FALSE;
+#endif
+    if (!name || !use_per_user_profile || (class != CLASS_MONITOR && class != CLASS_PRINTER && class != CLASS_SCANNER))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* no per-user association list is kept: the profiles of the device are the system's */
+    *use_per_user_profile = FALSE;
+    return TRUE;
 }
 
