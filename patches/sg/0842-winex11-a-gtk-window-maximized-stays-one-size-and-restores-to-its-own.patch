From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11: a GTK window maximized stays one size, and restores to its own

A GTK program that draws its own title bar and shadow (GNOME's File
Roller, GTK 4; 0813 keeps the shadow outside its Wine frame) drops the
shadow as soon as it is told it is maximized -- before its frame is
maximized. The frame then sized the program's window twice in a row: to
the maximized size with the old shadow around it, then without it. The
program's window reported the first size after the second request had
been made, and that stale size was taken for one the program chose
itself: the frame was sized to follow it, Wine kept a maximized frame to
the screen, the program's window was sized to the frame again -- and so
on, the frame and the program see-sawing between two sizes about sixty
times a second (over the taskbar half the time) for as long as it stayed
maximized, and restored at the wrong size afterwards.

A size the program's window reports from before our own last request
sizing it is now stale and not followed; and while the frame is
maximized or full screen, it keeps its size, as a window manager keeps a
maximized window's.

Test: test/csdmaxloop-gate.sh with test/csdmaxloop-ask.c and
test/csdframe-client.c (mutant SG_MUTANT_EMBED_SIZE_LOOP).
---
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -81,6 +81,8 @@
                            * bottom), kept outside the frame */
     BOOL     fullscreen;  /* the program asked for the whole screen */
     BOOL     maximized;   /* the frame is maximized (as the program knows it) */
+    unsigned long serial; /* our last request sizing the program's window: its
+                           * ConfigureNotify from before that is stale */
     LONG     style;       /* ...and the frame's style and place before */
     RECT     rect;
 };
@@ -461,6 +463,7 @@
     x -= e->ext[0]; y -= e->ext[2];
     w += e->ext[0] + e->ext[1]; h += e->ext[2] + e->ext[3];
     e->x = x; e->y = y; e->w = w; e->h = h;
+    e->serial = NextRequest( data->display );
     pthread_mutex_unlock( &embed_mutex );
 
     /* should this process go, the program's window goes back to the root,
@@ -569,6 +572,7 @@
     {
         e->x = x; e->y = y; e->w = w; e->h = h;
         X11DRV_expect_error( e->display, ignore_error, NULL );
+        e->serial = NextRequest( e->display );
         XMoveResizeWindow( e->display, e->child, x, y, w, h );
         X11DRV_check_error();
     }
@@ -876,6 +880,15 @@
         /* the program sized its window: the frame follows */
         RECT rect;
         int dw = (int)wp - (int)(lp & 0xffff), dh = (int)(wp >> 16) - (int)(lp >> 16);
+#ifndef SG_MUTANT_EMBED_SIZE_LOOP
+        /* not while maximized or full screen: the frame's size is the
+         * screen's then, as a window manager keeps it */
+        BOOL fixed;
+        pthread_mutex_lock( &embed_mutex );
+        fixed = (e = find_hwnd( hwnd )) && (e->maximized || e->fullscreen);
+        pthread_mutex_unlock( &embed_mutex );
+        if (fixed) return 0;
+#endif
         if (!(data = get_win_data( hwnd ))) return 0;
         rect = data->rects.window;
         release_win_data( data );
@@ -995,6 +1008,7 @@
     struct sg_embed *e;
     HWND hwnd = 0;
     int ew = 0, eh = 0, ex = 0, ey = 0;
+    BOOL stale = FALSE;
 
     if (!embed_count) return FALSE;
     pthread_mutex_lock( &embed_mutex );
@@ -1002,6 +1016,14 @@
     {
         hwnd = e->hwnd;
         ex = e->x; ey = e->y; ew = e->w; eh = e->h;
+#ifndef SG_MUTANT_EMBED_SIZE_LOOP
+        /* a size from before our last request sizing it: that request is on
+         * its way (the frame's own size, or a new shadow) -- taken for the
+         * program's, the frame was sized to it, the program's window to the
+         * frame, and so on: a maximized GTK window and its frame see-sawed
+         * between two sizes for as long as it stayed maximized */
+        stale = display == e->display && (long)(event->xany.serial - e->serial) < 0;
+#endif
         if (event->type == DestroyNotify && event->xdestroywindow.window == e->child) remove_embed( e );
     }
     pthread_mutex_unlock( &embed_mutex );
@@ -1018,7 +1040,7 @@
             XMoveWindow( display, event->xany.window, ex, ey );
             X11DRV_check_error();
         }
-        if (event->xconfigure.width != ew || event->xconfigure.height != eh)
+        if (!stale && (event->xconfigure.width != ew || event->xconfigure.height != eh))
             NtUserPostMessage( hwnd, WM_X11DRV_SG_EMBED_SIZE,
                                (WPARAM)(event->xconfigure.width | event->xconfigure.height << 16),
                                (LPARAM)(ew | eh << 16) );
@@ -1071,6 +1093,7 @@
                 e->h += ext[2] + ext[3] - e->ext[2] - e->ext[3];
                 memcpy( e->ext, ext, sizeof(ext) );
                 X11DRV_expect_error( display, ignore_error, NULL );
+                e->serial = NextRequest( display );
                 XMoveResizeWindow( display, e->child, e->x, e->y, max( 1, e->w ), max( 1, e->h ) );
                 X11DRV_check_error();
             }
