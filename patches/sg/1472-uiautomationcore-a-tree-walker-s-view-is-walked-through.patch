From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: a tree walker's view is walked through

Navigating to a child or a sibling under any condition but "true" was
E_NOTIMPL, so a walk of the control view or the content view -- what an
accessibility client does first (a screen reader, Accessibility
Insights, Opera's installer) -- stopped at the desktop. Now an element
the condition leaves out is seen through, as on Windows: the first
(last) child is found depth first through left-out elements, and past
the end of a left-out parent its own siblings follow.

Gate: test/uiaview-gate.sh (the shell's desktop with Notepad: control
view forwards and back, and views leaving out the taskbar and
SHELLDLL_DefView). Mutant: SG_MUTANT_UIA_NO_VIEW_NAV.
---
--- a/dlls/uiautomationcore/uia_client.c
+++ b/dlls/uiautomationcore/uia_client.c
@@ -999,6 +999,112 @@
     return S_OK;
 }
 
+/*
+ * Stained Glass OS (wine-sg 1472): a tree walker's view (the control view,
+ * the content view: a condition) seen through: an element the condition
+ * leaves out is transparent, its children are its parent's. Navigation to a
+ * child or a sibling under any condition but "true" was E_NOTIMPL, so every
+ * walk of the control view -- an accessibility client's, a screen reader's,
+ * Opera's installer's -- stopped at the desktop.
+ */
+#define SG_UIA_VIEW_DEPTH 64
+
+/* the first (or last) element under NODE in the view: depth first through
+ * the elements left out */
+static HRESULT sg_view_first_child(struct uia_node *node, int dir, struct UiaCondition *cond, HUIANODE *out,
+        int depth)
+{
+    int sib_dir = dir == NavigateDirection_FirstChild ? NavigateDirection_NextSibling : NavigateDirection_PreviousSibling;
+    HUIANODE child = NULL, next;
+    HRESULT hr;
+
+    *out = NULL;
+    if (depth > SG_UIA_VIEW_DEPTH)
+        return S_OK;
+    hr = navigate_uia_node(node, dir, &child);
+    while (SUCCEEDED(hr) && child)
+    {
+        hr = uia_condition_check(child, cond);
+        if (FAILED(hr))
+            break;
+        if (uia_condition_matched(hr))
+        {
+            *out = child;
+            return S_OK;
+        }
+        hr = sg_view_first_child(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)child), dir, cond, out, depth + 1);
+        if (FAILED(hr) || *out)
+            break;
+        next = NULL;
+        hr = navigate_uia_node(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)child), sib_dir, &next);
+        UiaNodeRelease(child);
+        child = next;
+    }
+    if (child)
+        UiaNodeRelease(child);
+    return FAILED(hr) ? hr : S_OK;
+}
+
+/* the next (or previous) element after NODE in the view: its own siblings
+ * and theirs seen through, then its parent's when the parent is left out */
+static HRESULT sg_view_sibling(struct uia_node *node, int dir, struct UiaCondition *cond, HUIANODE *out)
+{
+    int child_dir = dir == NavigateDirection_NextSibling ? NavigateDirection_FirstChild : NavigateDirection_LastChild;
+    struct uia_node *cur = node;
+    HUIANODE sib = NULL, next, parent;
+    HRESULT hr = S_OK;
+    int level;
+
+    *out = NULL;
+    IWineUiaNode_AddRef(&cur->IWineUiaNode_iface);
+    for (level = 0; level < SG_UIA_VIEW_DEPTH && !*out; level++)
+    {
+        hr = navigate_uia_node(cur, dir, &sib);
+        while (SUCCEEDED(hr) && sib)
+        {
+            hr = uia_condition_check(sib, cond);
+            if (FAILED(hr))
+                break;
+            if (uia_condition_matched(hr))
+            {
+                *out = sib;
+                sib = NULL;
+                break;
+            }
+            hr = sg_view_first_child(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)sib), child_dir, cond, out, 0);
+            if (FAILED(hr) || *out)
+                break;
+            next = NULL;
+            hr = navigate_uia_node(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)sib), dir, &next);
+            UiaNodeRelease(sib);
+            sib = next;
+        }
+        if (sib)
+        {
+            UiaNodeRelease(sib);
+            sib = NULL;
+        }
+        if (FAILED(hr) || *out)
+            break;
+
+        /* none: past the end of a parent the view leaves out, its own siblings */
+        parent = NULL;
+        hr = navigate_uia_node(cur, NavigateDirection_Parent, &parent);
+        if (FAILED(hr) || !parent)
+            break;
+        hr = uia_condition_check(parent, cond);
+        if (FAILED(hr) || uia_condition_matched(hr))
+        {
+            UiaNodeRelease(parent);
+            break;
+        }
+        IWineUiaNode_Release(&cur->IWineUiaNode_iface);
+        cur = unsafe_impl_from_IWineUiaNode((IWineUiaNode *)parent);
+    }
+    IWineUiaNode_Release(&cur->IWineUiaNode_iface);
+    return FAILED(hr) ? hr : S_OK;
+}
+
 static HRESULT conditional_navigate_uia_node(struct uia_node *node, int nav_dir, struct UiaCondition *cond,
         HUIANODE *out_node)
 {
@@ -1045,8 +1151,14 @@
     case NavigateDirection_LastChild:
         if (cond->ConditionType != ConditionType_True)
         {
+#ifndef SG_MUTANT_UIA_NO_VIEW_NAV
+            if (nav_dir == NavigateDirection_FirstChild || nav_dir == NavigateDirection_LastChild)
+                return sg_view_first_child(node, nav_dir, cond, out_node, 0);
+            return sg_view_sibling(node, nav_dir, cond, out_node);
+#else
             FIXME("ConditionType %d based navigation for dir %d is not implemented.\n", cond->ConditionType, nav_dir);
             return E_NOTIMPL;
+#endif
         }
 
         hr = navigate_uia_node(node, nav_dir, out_node);
