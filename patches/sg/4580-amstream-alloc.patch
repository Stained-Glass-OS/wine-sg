From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] amstream: Implement AllocateSample and CreateSharedSample of the DirectDraw and audio streams.

IMediaStream::AllocateSample "allocates the sample and its associated
backing object": the DirectDraw stream makes a sample with a surface of its
own, as CreateSample(NULL) does, and the audio stream one with an IAudioData
object in the stream's format holding one second of sound.
CreateSharedSample makes a sample sharing an existing sample's backing
object: the surface and rectangle of a DirectDraw sample, the IAudioData of
an audio sample; any other sample gives MS_E_INCOMPATIBLE.

Gate: test/amstream-alloc-gate.sh (64/32).
---
 dlls/amstream/audiostream.c | 41 +++++++++++++++++++++++++++++++++++++----
 dlls/amstream/ddrawstream.c | 30 +++++++++++++++++++++++++++---
 2 files changed, 64 insertions(+), 7 deletions(-)

diff --git a/dlls/amstream/audiostream.c b/dlls/amstream/audiostream.c
index 0b59177..1ef8027 100644
--- a/dlls/amstream/audiostream.c
+++ b/dlls/amstream/audiostream.c
@@ -590,19 +590,33 @@ static HRESULT WINAPI audio_IAMMediaStream_SetSameFormat(IAMMediaStream *iface,
     return IAudioMediaStream_SetFormat(&This->IAudioMediaStream_iface, &format);
 }
 
-/* Samples of this stream are always created from an IAudioData object with
- * CreateSample(); there is no stream-allocated or shared sample type. */
+/* A sample with an IAudioData object of its own, in the stream's format, with
+ * a buffer of one second of sound. */
 static HRESULT WINAPI audio_IAMMediaStream_AllocateSample(IAMMediaStream *iface,
         DWORD flags, IStreamSample **sample)
 {
     struct audio_stream *This = impl_from_IAMMediaStream(iface);
+    IAudioData *audio_data;
+    WAVEFORMATEX format;
+    HRESULT hr;
 
     TRACE("(%p/%p)->(%lx,%p)\n", This, iface, flags, sample);
 
     if (!sample)
         return E_POINTER;
     *sample = NULL;
-    return E_NOTIMPL;
+
+    if (FAILED(hr = AMAudioData_create(NULL, (void **)&audio_data)))
+        return hr;
+    EnterCriticalSection(&This->cs);
+    if (This->format.wFormatTag)
+        IAudioData_SetFormat(audio_data, &This->format);
+    LeaveCriticalSection(&This->cs);
+    IAudioData_GetFormat(audio_data, &format);
+    if (SUCCEEDED(hr = IAudioData_SetBuffer(audio_data, format.nAvgBytesPerSec, NULL, 0)))
+        hr = audiostreamsample_create(This, audio_data, (IAudioStreamSample **)sample);
+    IAudioData_Release(audio_data);
+    return hr;
 }
 
 static HRESULT WINAPI audio_IAMMediaStream_CreateSharedSample(IAMMediaStream *iface,
@@ -610,12 +624,31 @@ static HRESULT WINAPI audio_IAMMediaStream_CreateSharedSample(IAMMediaStream *if
 {
     struct audio_stream *This = impl_from_IAMMediaStream(iface);
 
+    IAudioStreamSample *audio_sample;
+    IAudioData *audio_data;
+    HRESULT hr;
+
     TRACE("(%p/%p)->(%p,%lx,%p)\n", This, iface, existing_sample, flags, sample);
 
     if (!sample)
         return E_POINTER;
     *sample = NULL;
-    return E_NOTIMPL;
+    if (!existing_sample)
+        return E_POINTER;
+    /* the new sample shares the IAudioData object of an audio sample */
+    if (FAILED(IStreamSample_QueryInterface(existing_sample, &IID_IAudioStreamSample, (void **)&audio_sample)))
+        return MS_E_INCOMPATIBLE;
+    hr = IAudioStreamSample_GetAudioData(audio_sample, &audio_data);
+    IAudioStreamSample_Release(audio_sample);
+    if (FAILED(hr))
+        return hr;
+#ifdef SG_MUTANT_AM_SHARED_OWN_DATA
+    IAudioData_Release(audio_data);
+    AMAudioData_create(NULL, (void **)&audio_data);
+#endif
+    hr = audiostreamsample_create(This, audio_data, (IAudioStreamSample **)sample);
+    IAudioData_Release(audio_data);
+    return hr;
 }
 
 /* The stream is an input-only sink: there is no downstream pin to notify. */
diff --git a/dlls/amstream/ddrawstream.c b/dlls/amstream/ddrawstream.c
index 7bff4c9..5ea5395 100644
--- a/dlls/amstream/ddrawstream.c
+++ b/dlls/amstream/ddrawstream.c
@@ -307,19 +307,25 @@ static HRESULT WINAPI ddraw_IAMMediaStream_SetSameFormat(IAMMediaStream *iface,
     return IDirectDrawMediaStream_SetFormat(&This->IDirectDrawMediaStream_iface, &desc, NULL);
 }
 
-/* Samples of this stream are always created from a surface with
- * CreateSample(); there is no stream-allocated or shared sample type. */
+/* A sample with a surface of its own, made as CreateSample(NULL) makes one. */
 static HRESULT WINAPI ddraw_IAMMediaStream_AllocateSample(IAMMediaStream *iface,
         DWORD flags, IStreamSample **sample)
 {
     struct ddraw_stream *This = impl_from_IAMMediaStream(iface);
+    HRESULT hr;
 
     TRACE("(%p/%p)->(%lx,%p)\n", This, iface, flags, sample);
 
     if (!sample)
         return E_POINTER;
     *sample = NULL;
+#ifdef SG_MUTANT_AM_ALLOC_NOTIMPL
     return E_NOTIMPL;
+#endif
+    EnterCriticalSection(&This->cs);
+    hr = ddrawstreamsample_create(This, NULL, NULL, (IDirectDrawStreamSample **)sample);
+    LeaveCriticalSection(&This->cs);
+    return hr;
 }
 
 static HRESULT WINAPI ddraw_IAMMediaStream_CreateSharedSample(IAMMediaStream *iface,
@@ -327,12 +333,30 @@ static HRESULT WINAPI ddraw_IAMMediaStream_CreateSharedSample(IAMMediaStream *if
 {
     struct ddraw_stream *This = impl_from_IAMMediaStream(iface);
 
+    IDirectDrawStreamSample *ddraw_sample;
+    IDirectDrawSurface *surface;
+    RECT rect;
+    HRESULT hr;
+
     TRACE("(%p/%p)->(%p,%lx,%p)\n", This, iface, existing_sample, flags, sample);
 
     if (!sample)
         return E_POINTER;
     *sample = NULL;
-    return E_NOTIMPL;
+    if (!existing_sample)
+        return E_POINTER;
+    /* the new sample shares the surface (and rectangle) of a DirectDraw sample */
+    if (FAILED(IStreamSample_QueryInterface(existing_sample, &IID_IDirectDrawStreamSample, (void **)&ddraw_sample)))
+        return MS_E_INCOMPATIBLE;
+    hr = IDirectDrawStreamSample_GetSurface(ddraw_sample, &surface, &rect);
+    IDirectDrawStreamSample_Release(ddraw_sample);
+    if (FAILED(hr))
+        return hr;
+    EnterCriticalSection(&This->cs);
+    hr = ddrawstreamsample_create(This, surface, &rect, (IDirectDrawStreamSample **)sample);
+    LeaveCriticalSection(&This->cs);
+    IDirectDrawSurface_Release(surface);
+    return hr;
 }
 
 /* The stream is an input-only sink: there is no downstream pin to notify. */
