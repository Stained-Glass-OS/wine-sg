diff --git a/include/wine/winusb_ioctl.h b/include/wine/winusb_ioctl.h
new file mode 100644
index 0000000..f4b381f
--- /dev/null
+++ b/include/wine/winusb_ioctl.h
@@ -0,0 +1,90 @@
+/*
+ * The private interface between winusb.dll and winusb.sys (wine-sg 6519)
+ *
+ * Copyright 2026 Stained Glass OS contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINUSB_IOCTL_H
+#define __WINE_WINUSB_IOCTL_H
+
+#include "winioctl.h"
+
+#define WINE_WINUSB_IOCTL(n, method) CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa50 + (n), method, FILE_ANY_ACCESS)
+
+/* out: struct wine_winusb_info */
+#define IOCTL_WINE_WINUSB_GET_INFO          WINE_WINUSB_IOCTL(0, METHOD_BUFFERED)
+/* out: the device's active configuration descriptor, whole */
+#define IOCTL_WINE_WINUSB_GET_CONFIG        WINE_WINUSB_IOCTL(1, METHOD_BUFFERED)
+/* in: struct wine_winusb_descriptor_request; out: the descriptor */
+#define IOCTL_WINE_WINUSB_GET_DESCRIPTOR    WINE_WINUSB_IOCTL(2, METHOD_BUFFERED)
+/* in: struct wine_winusb_control (and the data of an OUT transfer); out: the data of an IN transfer */
+#define IOCTL_WINE_WINUSB_CONTROL           WINE_WINUSB_IOCTL(3, METHOD_BUFFERED)
+/* in: struct wine_winusb_pipe_request; out: the data read */
+#define IOCTL_WINE_WINUSB_READ_PIPE         WINE_WINUSB_IOCTL(4, METHOD_BUFFERED)
+/* in: struct wine_winusb_pipe_request, then the data to write */
+#define IOCTL_WINE_WINUSB_WRITE_PIPE        WINE_WINUSB_IOCTL(5, METHOD_BUFFERED)
+/* in: struct wine_winusb_pipe_request */
+#define IOCTL_WINE_WINUSB_RESET_PIPE        WINE_WINUSB_IOCTL(6, METHOD_BUFFERED)
+#define IOCTL_WINE_WINUSB_ABORT_PIPE        WINE_WINUSB_IOCTL(7, METHOD_BUFFERED)
+/* in: struct wine_winusb_alternate */
+#define IOCTL_WINE_WINUSB_SET_ALTERNATE     WINE_WINUSB_IOCTL(8, METHOD_BUFFERED)
+
+struct wine_winusb_info
+{
+    UCHAR speed;            /* LowSpeed, FullSpeed, HighSpeed */
+    UCHAR first_interface;  /* the interface number the device handle is for */
+    UCHAR interface_count;  /* the interfaces of the function (the first and its associated ones) */
+    UCHAR reserved;
+    ULONG config_size;      /* the configuration descriptor's total length */
+};
+
+struct wine_winusb_descriptor_request
+{
+    UCHAR type;
+    UCHAR index;
+    USHORT language;
+};
+
+struct wine_winusb_control
+{
+    UCHAR setup[8];         /* bmRequestType, bRequest, wValue, wIndex, wLength */
+    ULONG timeout;          /* milliseconds, 0: none */
+    /* the data of an OUT transfer follows */
+};
+
+#define WINE_WINUSB_SHORT_PACKET_TERMINATE  0x01
+
+struct wine_winusb_pipe_request
+{
+    UCHAR pipe;             /* the endpoint address */
+    UCHAR flags;
+    USHORT reserved;
+    ULONG timeout;          /* milliseconds, 0: none */
+};
+
+struct wine_winusb_alternate
+{
+    UCHAR interface;
+    UCHAR setting;
+};
+
+/* wineusb.sys to winusb.sys, an internal ioctl of the device's PDO: Argument1 is a WCHAR[40]
+ * that receives the device interface GUID the device's Microsoft OS descriptors (or the
+ * administrator's list) name, "" for none */
+#define IOCTL_WINE_WINEUSB_GET_INTERFACE_GUID CTL_CODE(FILE_DEVICE_USB, 0xa60, METHOD_NEITHER, FILE_ANY_ACCESS)
+
+#endif
