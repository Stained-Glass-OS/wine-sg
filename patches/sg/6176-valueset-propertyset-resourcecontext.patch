+
+/* ---- ResourceContext's class: new contexts, the view's and the global qualifiers ---------------- */
+
+struct context_class
+{
+    IActivationFactory IActivationFactory_iface;
+    const void *statics_vtbl, *statics2_vtbl, *statics3_vtbl, *statics4_vtbl;
+};
+
+static struct context_class *context_class_from_factory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct context_class, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI context_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct context_class *impl = context_class_from_factory( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid( iid ), out );
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IResourceContextStatics_x )) *out = &impl->statics_vtbl;
+    else if (IsEqualGUID( iid, &IID_IResourceContextStatics2_x )) *out = &impl->statics2_vtbl;
+    else if (IsEqualGUID( iid, &IID_IResourceContextStatics3_x )) *out = &impl->statics3_vtbl;
+    else if (IsEqualGUID( iid, &IID_IResourceContextStatics4_x )) *out = &impl->statics4_vtbl;
+    if (*out) return S_OK;   /* static: no reference counting */
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    return E_NOINTERFACE;
+}
+
