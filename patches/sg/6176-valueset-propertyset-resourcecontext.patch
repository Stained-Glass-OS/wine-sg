+    context_factory_GetRuntimeClassName, factory_GetTrustLevel, context_factory_ActivateInstance,
+};
+
+static struct context_class context_class;
+
+/* the statics interfaces' IUnknown and IInspectable methods, through the class */
+#define CONTEXT_STATICS_BASE(field) \
+static HRESULT WINAPI field##_QueryInterface( void *iface, REFIID iid, void **out ) \
+{ return context_factory_QueryInterface( &context_class.IActivationFactory_iface, iid, out ); } \
+static ULONG WINAPI field##_AddRef( void *iface ) { return 2; } \
+static ULONG WINAPI field##_Release( void *iface ) { return 1; } \
+static HRESULT WINAPI field##_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI field##_GetRuntimeClassName( void *iface, HSTRING *name ) \
+{ return context_factory_GetRuntimeClassName( NULL, name ); } \
+static HRESULT WINAPI field##_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+#define CONTEXT_STATICS_METHODS(field) \
+    field##_QueryInterface, field##_AddRef, field##_Release, field##_GetIids, field##_GetRuntimeClassName, field##_GetTrustLevel
+
+CONTEXT_STATICS_BASE(cs)
+
+static HRESULT WINAPI cs_CreateMatchingContext( void *iface, void *result, void **value )
+{
+    return new_object( &context_vtbl, KIND_CONTEXT, NULL, value );
+}
+
+static HRESULT WINAPI cs_GetForCurrentView( void *iface, void **value )
+{
+    return new_object( &context_vtbl, KIND_CONTEXT, NULL, value );
+}
+
+static HRESULT WINAPI cs_SetGlobalQualifierValue( void *iface, HSTRING key, HSTRING value )
+{
+    TRACE( "%s = %s (kept as the system's)\n", debugstr_hstring( key ), debugstr_hstring( value ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI cs_ResetGlobalQualifierValues( void *iface )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI cs_ResetGlobalQualifierValuesForSpecifiedQualifiers( void *iface, void *names )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI cs_SetGlobalQualifierValueWithPersistence( void *iface, HSTRING key, HSTRING value, INT32 persistence )
+{
+    return cs_SetGlobalQualifierValue( iface, key, value );
+}
+
+static HRESULT WINAPI cs_GetForUIContext( void *iface, void *context, void **value )
+{
+    return new_object( &context_vtbl, KIND_CONTEXT, NULL, value );
+}
+
+static const struct { void *base[6]; void *CreateMatchingContext; } context_statics_vtbl =
+{
+    { CONTEXT_STATICS_METHODS(cs) }, cs_CreateMatchingContext,
+};
+
+static const struct
+{
+    void *base[6];
+    void *GetForCurrentView, *SetGlobalQualifierValue, *ResetGlobalQualifierValues,
+         *ResetGlobalQualifierValuesForSpecifiedQualifiers, *GetForViewIndependentUse;
+} context_statics2_vtbl =
+{
+    { CONTEXT_STATICS_METHODS(cs) }, cs_GetForCurrentView, cs_SetGlobalQualifierValue, cs_ResetGlobalQualifierValues,
+    cs_ResetGlobalQualifierValuesForSpecifiedQualifiers, cs_GetForCurrentView,
+};
+
+static const struct { void *base[6]; void *SetGlobalQualifierValueWithPersistence; } context_statics3_vtbl =
+{
+    { CONTEXT_STATICS_METHODS(cs) }, cs_SetGlobalQualifierValueWithPersistence,
+};
+
+static const struct { void *base[6]; void *GetForUIContext; } context_statics4_vtbl =
+{
+    { CONTEXT_STATICS_METHODS(cs) }, cs_GetForUIContext,
+};
+
+static struct context_class context_class =
+{
+    { &context_factory_vtbl }, &context_statics_vtbl, &context_statics2_vtbl, &context_statics3_vtbl, &context_statics4_vtbl,
+};
+
+IActivationFactory *resource_context_factory = &context_class.IActivationFactory_iface;
diff --git a/dlls/wintypes/main.c b/dlls/wintypes/main.c
index 5790cae..d216b54 100644
--- a/dlls/wintypes/main.c
+++ b/dlls/wintypes/main.c
@@ -1454,7 +1454,18 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **out)
 
 HRESULT WINAPI DllGetActivationFactory(HSTRING classid, IActivationFactory **factory)
 {
+    const WCHAR *name = WindowsGetStringRawBuffer( classid, NULL );
+
     TRACE("classid %s, factory %p.\n", debugstr_hstring(classid), factory);
+    /* Stained Glass OS: the collections registered here are made by windows.applicationmodel */
+    if (name && (!wcscmp( name, L"Windows.Foundation.Collections.ValueSet" ) ||
+                 !wcscmp( name, L"Windows.Foundation.Collections.PropertySet" )))
+    {
+        HMODULE module = LoadLibraryW( L"windows.applicationmodel.dll" );
+        HRESULT (WINAPI *get)( HSTRING, IActivationFactory ** );
+        if (module && (get = (void *)GetProcAddress( module, "DllGetActivationFactory" ))) return get( classid, factory );
+        WARN( "no windows.applicationmodel for %s\n", debugstr_w( name ) );
+    }
     *factory = &wintypes.IActivationFactory_iface;
     IUnknown_AddRef(*factory);
     return S_OK;
