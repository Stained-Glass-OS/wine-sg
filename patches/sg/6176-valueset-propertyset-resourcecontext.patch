     static inline impl_type *impl_from( iface_type *iface )                                        \
diff --git a/dlls/windows.applicationmodel/property_set.c b/dlls/windows.applicationmodel/property_set.c
index 73fa97b..d2b2e6d 100644
--- a/dlls/windows.applicationmodel/property_set.c
+++ b/dlls/windows.applicationmodel/property_set.c
@@ -1084,3 +1084,52 @@ HRESULT property_set_create( IPropertySet **out )
     *out = &impl->IPropertySet_iface;
     return S_OK;
 }
+
+/*
+ * Stained Glass OS: ValueSet and PropertySet made (wintypes, where they are registered, hands their
+ * activation here): Windows Terminal passes its start-up arguments in a ValueSet.
+ */
+
+static HRESULT WINAPI ps_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ps_factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI ps_factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI ps_factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI ps_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.Foundation.Collections.ValueSet", 39, name );
+}
+
+static HRESULT WINAPI ps_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI ps_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+#ifdef SG_MUTANT_VALUESET_NOT_MADE
+    return E_NOTIMPL;
+#endif
+    return property_set_create( (IPropertySet **)instance );
+}
+
+static const IActivationFactoryVtbl ps_factory_vtbl =
+{
+    ps_factory_QueryInterface, ps_factory_AddRef, ps_factory_Release, ps_factory_GetIids, ps_factory_GetRuntimeClassName,
+    ps_factory_GetTrustLevel, ps_factory_ActivateInstance,
+};
+
+static IActivationFactory ps_factory = { &ps_factory_vtbl };
+IActivationFactory *property_set_factory = &ps_factory;
