From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] olepro32, dpnhpast: DllGetClassObject says no class, and means it

olepro32's DllGetClassObject returned S_OK without setting the output
pointer, so a caller that trusted S_OK dereferenced garbage; the DLL
implements no class (StdFont and StdPicture are oleaut32's), so it now
returns CLASS_E_CLASSNOTAVAILABLE with a NULL pointer, the documented
answer. dpnhpast returned E_FAIL for the same situation and gets the same
precise code.
---
--- a/dlls/dpnhpast/main.c
+++ b/dlls/dpnhpast/main.c
@@ -45,6 +45,9 @@ HRESULT WINAPI DirectPlayNATHelpCreate(LPCGUID pIID, PVOID *ppvInterface)
  */
 HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, LPVOID *ppv)
 {
-	FIXME(":stub\n");
-	return E_FAIL;
+	TRACE("(%s, %s, %p)\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
+
+	/* the NAT helper's class factory is not available here */
+	if (ppv) *ppv = NULL;
+	return CLASS_E_CLASSNOTAVAILABLE;
 }
--- a/dlls/olepro32/olepro32stubs.c
+++ b/dlls/olepro32/olepro32stubs.c
@@ -32,9 +32,16 @@ WINE_DEFAULT_DEBUG_CHANNEL(ole);
 
 /***********************************************************************
  *		DllGetClassObject (OLEPRO32.@)
+ *
+ * No class is implemented in this DLL: StdFont and StdPicture are oleaut32's.
  */
 HRESULT WINAPI DllGetClassObject( REFCLSID rclsid, REFIID riid, LPVOID* ppv )
 {
-	FIXME("stub\n");
+	TRACE("(%s, %s, %p)\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
+
+#ifdef SG_MUTANT_OLEPRO32_OK
 	return S_OK;
+#endif
+	if (ppv) *ppv = NULL;
+	return CLASS_E_CLASSNOTAVAILABLE;
 }
