From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] oleaut32: OleCreatePropertyFrameIndirect honours dispidInitialProperty

Show the page that holds the initial property first and highlight
the property through IPropertyPage2::EditProperty.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/oleaut32/olepropframe.c b/dlls/oleaut32/olepropframe.c
--- a/dlls/oleaut32/olepropframe.c
+++ b/dlls/oleaut32/olepropframe.c
@@ -32,6 +32,15 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(ole);
 
+/* what a sheet page's dialog procedure needs: the page and, for the page that
+ * holds the initially highlighted property, its DISPID */
+struct sheet_page
+{
+    IPropertyPage *page;
+    DISPID initial_dispid;
+    BOOL has_initial;
+};
+
 typedef struct {
     IPropertyPageSite IPropertyPageSite_iface;
     LCID lcid;
@@ -49,14 +58,27 @@
 
     switch(msg) {
     case WM_INITDIALOG: {
+        struct sheet_page *sheet_page = (struct sheet_page *)((LPPROPSHEETPAGEW)lparam)->lParam;
         RECT rect;
 
-        property_page = (IPropertyPage*)((LPPROPSHEETPAGEW)lparam)->lParam;
+        property_page = sheet_page->page;
 
         GetClientRect(hwnd, &rect);
         IPropertyPage_Activate(property_page, hwnd, &rect, TRUE);
         IPropertyPage_Show(property_page, SW_SHOW);
 
+        if(sheet_page->has_initial) {
+            /* highlight the initial property through IPropertyPage2 */
+            IPropertyPage2 *page2;
+
+            if(SUCCEEDED(IPropertyPage_QueryInterface(property_page, &IID_IPropertyPage2, (void **)&page2))) {
+                HRESULT hr = IPropertyPage2_EditProperty(page2, sheet_page->initial_dispid);
+                if(FAILED(hr))
+                    WARN("EditProperty() failed, hr %#lx.\n", hr);
+                IPropertyPage2_Release(page2);
+            }
+        }
+
         SetWindowLongPtrW(hwnd, DWLP_USER, (LONG_PTR)property_page);
         return FALSE;
     }
@@ -161,7 +183,10 @@
         WORD title;
     } *dialogs;
     IPropertyPage **property_page;
+    struct sheet_page *sheet_pages;
     PropertyPageSite *property_page_site;
+    CLSID initial_clsid;
+    BOOL have_initial_page = FALSE;
     HRESULT res;
     ULONG i;
     HMODULE hcomctl;
@@ -190,9 +215,6 @@
         return E_INVALIDARG;
     }
 
-    if(lpParams->dispidInitialProperty)
-        FIXME("dispidInitialProperty not yet implemented\n");
-
     hdc = GetDC(NULL);
     hcomctl = LoadLibraryW(L"comctl32.dll");
     if(hcomctl)
@@ -235,6 +257,19 @@
         FreeLibrary(hcomctl);
     ReleaseDC(NULL, hdc);
 
+    /* DISPID_UNKNOWN: no initial property.  Otherwise the page that holds it is
+     * the first one shown, found through the first object's IPerPropertyBrowsing. */
+    if(lpParams->dispidInitialProperty != DISPID_UNKNOWN && lpParams->cObjects && lpParams->lplpUnk
+            && lpParams->lplpUnk[0]) {
+        IPerPropertyBrowsing *browsing;
+
+        if(SUCCEEDED(IUnknown_QueryInterface(lpParams->lplpUnk[0], &IID_IPerPropertyBrowsing, (void **)&browsing))) {
+            res = IPerPropertyBrowsing_MapPropertyToPage(browsing, lpParams->dispidInitialProperty, &initial_clsid);
+            have_initial_page = (res == S_OK);
+            IPerPropertyBrowsing_Release(browsing);
+        }
+    }
+
     memset(&property_sheet, 0, sizeof(property_sheet));
     property_sheet.dwSize = sizeof(property_sheet);
     if(lpParams->lpszCaption) {
@@ -248,10 +283,13 @@
             lpParams->cPages*sizeof(IPropertyPage*));
     dialogs = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY,
             lpParams->cPages*sizeof(*dialogs));
-    if(!property_sheet.phpage || !property_page || !dialogs) {
+    sheet_pages = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY,
+            lpParams->cPages*sizeof(*sheet_pages));
+    if(!property_sheet.phpage || !property_page || !dialogs || !sheet_pages) {
         HeapFree(GetProcessHeap(), 0, property_sheet.phpage);
         HeapFree(GetProcessHeap(), 0, property_page);
         HeapFree(GetProcessHeap(), 0, dialogs);
+        HeapFree(GetProcessHeap(), 0, sheet_pages);
         return E_OUTOFMEMORY;
     }
 
@@ -294,7 +332,13 @@
         dialogs[i].template.cy = MulDiv(page_info.size.cy, 8, font_height);
 
         property_sheet_page.pResource = &dialogs[i].template;
-        property_sheet_page.lParam = (LPARAM)property_page[i];
+        sheet_pages[i].page = property_page[i];
+        if(have_initial_page && IsEqualCLSID(&lpParams->lpPages[i], &initial_clsid)) {
+            sheet_pages[i].has_initial = TRUE;
+            sheet_pages[i].initial_dispid = lpParams->dispidInitialProperty;
+            property_sheet.nStartPage = property_sheet.nPages;
+        }
+        property_sheet_page.lParam = (LPARAM)&sheet_pages[i];
         property_sheet_page.pszTitle = page_info.pszTitle;
 
         property_sheet.phpage[property_sheet.nPages++] =
@@ -308,6 +352,7 @@
             IPropertyPage_Release(property_page[i]);
     }
 
+    HeapFree(GetProcessHeap(), 0, sheet_pages);
     HeapFree(GetProcessHeap(), 0, dialogs);
     HeapFree(GetProcessHeap(), 0, property_page);
     HeapFree(GetProcessHeap(), 0, property_sheet.phpage);
@@ -334,7 +379,7 @@
     ocpf.cPages       = cPages;
     ocpf.lpPages      = pPageClsID;
     ocpf.lcid         = lcid;
-    ocpf.dispidInitialProperty = 0;
+    ocpf.dispidInitialProperty = DISPID_UNKNOWN;
 
     return OleCreatePropertyFrameIndirect(&ocpf);
 }
-- 
2.47.0
