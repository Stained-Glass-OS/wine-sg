From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] cmd: CHOICE /T times out when it reads the console

CHOICE kept its timeout by waiting on an overlapped read of standard input; a console handle is
read synchronously, so the read itself waited for a key and the timeout never came. Squirrel
installers' uninstallers (Mudlet, Trilium Notes) delete themselves with
"cmd /C choice /C Y /N /D Y /T 3 & Del Update.exe", started without a window: that cmd stayed
for good, Update.exe was never deleted and SG Store waited on the uninstall for minutes.

With a console and a timeout, CHOICE now waits on the console's input for what is left of the
timeout and takes the first key press; the default answer comes when the time is up, as on
Windows. Input from a file or pipe works as before.
---
--- a/programs/cmd/builtins.c
+++ b/programs/cmd/builtins.c
@@ -405,6 +405,43 @@
     {
         if (opt_timeout == 0)
             answer[0] = opt_default;
+#ifndef SG_MUTANT_CHOICE_CONSOLE_NO_TIMEOUT
+        else if (have_console && opt_timeout != -1)
+        {
+            /* Stained Glass OS (8414): the console is read synchronously, so the timeout is
+             * kept here: wait on the console's input with what is left of it, take a key
+             * press. Squirrel uninstallers end with "cmd /C choice /D Y /T 3 & Del Update.exe"
+             * started without a window; no key ever came and that cmd never ended. */
+            HANDLE in = GetStdHandle(STD_INPUT_HANDLE);
+            DWORD start = GetTickCount(), elapsed, count;
+            INPUT_RECORD record;
+
+            answer[0] = 0;
+            while (!answer[0] && return_code == NO_ERROR)
+            {
+                elapsed = GetTickCount() - start;
+                if (elapsed >= opt_timeout * 1000)
+                {
+                    answer[0] = opt_default;
+                    break;
+                }
+                switch (WaitForSingleObject(in, opt_timeout * 1000 - elapsed))
+                {
+                case WAIT_OBJECT_0:
+                    if (!ReadConsoleInputW(in, &record, 1, &count)) return_code = ERROR_INVALID_FUNCTION;
+                    else if (count && record.EventType == KEY_EVENT && record.Event.KeyEvent.bKeyDown &&
+                             record.Event.KeyEvent.uChar.UnicodeChar)
+                        answer[0] = record.Event.KeyEvent.uChar.UnicodeChar;
+                    break;
+                case WAIT_TIMEOUT:
+                    answer[0] = opt_default;
+                    break;
+                default:
+                    return_code = ERROR_INVALID_FUNCTION;
+                }
+            }
+        }
+#endif
         else
         {
             LARGE_INTEGER li, zeroli = {0};
