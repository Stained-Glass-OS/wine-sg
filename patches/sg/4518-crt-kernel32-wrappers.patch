From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcr120: Implement the __crt wrappers of kernel32 functions.

msvcr110 and msvcr120 export cdecl wrappers of kernel32 functions that
were spec stubs: __crtCompareStringEx and __crtLCMapStringEx (without the
version and sort handle arguments), __crtEnumSystemLocalesEx,
__crtGetDateFormatEx, __crtGetTimeFormatEx, __crtGetUserDefaultLocaleName,
__crtIsValidLocaleName, __crtFlsAlloc/Free/GetValue/SetValue,
__crtSetThreadStackGuarantee, __crtCreateSymbolicLinkW,
__crtCreateSemaphoreExW (msvcr110's i386 ___crtCreateSemaphoreExW) and
__crtIsPackagedApp (GetCurrentPackageId); msvcr120 adds
__crtCreateEventExW, __crtGetTickCount64 and
__crtGet/SetFileInformationByHandle(Ex). Each keeps its spec's
architectures; msvcr120_app forwards __crtIsPackagedApp.
---
 dlls/msvcr110/msvcr110.spec         |  30 +++---
 dlls/msvcr120/msvcr120.spec         |  38 ++++----
 dlls/msvcr120_app/msvcr120_app.spec |   2 +-
 dlls/msvcrt/misc.c                  | 190 ++++++++++++++++++++++++++++++++++++
 4 files changed, 225 insertions(+), 35 deletions(-)

diff --git a/dlls/msvcr110/msvcr110.spec b/dlls/msvcr110/msvcr110.spec
index b80ac95..8c9fe4c 100644
--- a/dlls/msvcr110/msvcr110.spec
+++ b/dlls/msvcr110/msvcr110.spec
@@ -907,27 +907,27 @@
 @ cdecl -arch=win64 -norelay __crtCaptureCurrentContext(ptr) ntdll.RtlCaptureContext
 @ cdecl -arch=x86_64 -norelay __crtCapturePreviousContext(ptr)
 @ cdecl __crtCompareStringA(long long str long str long)
-@ stub -arch=i386,win64 __crtCompareStringEx
+@ cdecl -arch=i386,win64 __crtCompareStringEx(wstr long wstr long wstr long)
 @ cdecl __crtCompareStringW(long long wstr long wstr long)
-@ stub -arch=i386 ___crtCreateSemaphoreExW
-@ stub -arch=x86_64 __crtCreateSymbolicLinkW
-@ stub -arch=i386,win64 __crtEnumSystemLocalesEx
-@ stub -arch=i386,win64 __crtFlsAlloc
-@ stub -arch=i386,win64 __crtFlsFree
-@ stub -arch=i386,win64 __crtFlsGetValue
-@ stub -arch=i386,win64 __crtFlsSetValue
-@ stub -arch=i386,win64 __crtGetDateFormatEx
+@ cdecl -arch=i386 ___crtCreateSemaphoreExW(ptr long long wstr long long) __crtCreateSemaphoreExW
+@ cdecl -arch=x86_64 __crtCreateSymbolicLinkW(wstr wstr long)
+@ cdecl -arch=i386,win64 __crtEnumSystemLocalesEx(ptr long long)
+@ cdecl -arch=i386,win64 __crtFlsAlloc(ptr)
+@ cdecl -arch=i386,win64 __crtFlsFree(long)
+@ cdecl -arch=i386,win64 __crtFlsGetValue(long)
+@ cdecl -arch=i386,win64 __crtFlsSetValue(long ptr)
+@ cdecl -arch=i386,win64 __crtGetDateFormatEx(wstr long ptr wstr ptr long wstr)
 @ cdecl -arch=i386,win64 __crtGetLocaleInfoEx(wstr long ptr long)
 @ cdecl __crtGetShowWindowMode()
-@ stub -arch=i386,win64 __crtGetTimeFormatEx
-@ stub -arch=i386,win64 __crtGetUserDefaultLocaleName
+@ cdecl -arch=i386,win64 __crtGetTimeFormatEx(wstr long ptr wstr ptr long)
+@ cdecl -arch=i386,win64 __crtGetUserDefaultLocaleName(ptr long)
 @ cdecl -arch=i386,win64 __crtInitializeCriticalSectionEx(ptr long long)
-@ stub __crtIsPackagedApp
-@ stub -arch=i386,win64 __crtIsValidLocaleName
+@ cdecl __crtIsPackagedApp()
+@ cdecl -arch=i386,win64 __crtIsValidLocaleName(wstr)
 @ cdecl __crtLCMapStringA(long long str long ptr long long long)
-@ stub -arch=i386,win64 __crtLCMapStringEx
+@ cdecl -arch=i386,win64 __crtLCMapStringEx(wstr long wstr long ptr long)
 @ cdecl __crtLCMapStringW(long long wstr long ptr long long long)
-@ stub -arch=i386,win64 __crtSetThreadStackGuarantee
+@ cdecl -arch=i386,win64 __crtSetThreadStackGuarantee(ptr)
 @ cdecl __crtSetUnhandledExceptionFilter(ptr)
 @ cdecl -arch=i386,win64 __crtTerminateProcess(long)
 @ cdecl -arch=i386,win64 __crtUnhandledException(ptr)
diff --git a/dlls/msvcr120/msvcr120.spec b/dlls/msvcr120/msvcr120.spec
index 822195f..50f1cda 100644
--- a/dlls/msvcr120/msvcr120.spec
+++ b/dlls/msvcr120/msvcr120.spec
@@ -893,31 +893,31 @@
 @ cdecl -arch=win64 -norelay __crtCaptureCurrentContext(ptr) ntdll.RtlCaptureContext
 @ cdecl -arch=x86_64 -norelay __crtCapturePreviousContext(ptr)
 @ cdecl __crtCompareStringA(long long str long str long)
-@ stub -arch=i386,win64 __crtCompareStringEx
+@ cdecl -arch=i386,win64 __crtCompareStringEx(wstr long wstr long wstr long)
 @ cdecl __crtCompareStringW(long long wstr long wstr long)
-@ stub __crtCreateEventExW
-@ stub -arch=i386 __crtCreateSemaphoreExW
-@ stub __crtCreateSymbolicLinkW
-@ stub -arch=i386,win64 __crtEnumSystemLocalesEx
-@ stub -arch=i386,win64 __crtFlsAlloc
-@ stub -arch=i386,win64 __crtFlsFree
-@ stub -arch=i386,win64 __crtFlsGetValue
-@ stub -arch=i386,win64 __crtFlsSetValue
-@ stub -arch=i386,win64 __crtGetDateFormatEx
-@ stub __crtGetFileInformationByHandleEx
+@ cdecl __crtCreateEventExW(ptr wstr long long)
+@ cdecl -arch=i386 __crtCreateSemaphoreExW(ptr long long wstr long long)
+@ cdecl __crtCreateSymbolicLinkW(wstr wstr long)
+@ cdecl -arch=i386,win64 __crtEnumSystemLocalesEx(ptr long long)
+@ cdecl -arch=i386,win64 __crtFlsAlloc(ptr)
+@ cdecl -arch=i386,win64 __crtFlsFree(long)
+@ cdecl -arch=i386,win64 __crtFlsGetValue(long)
+@ cdecl -arch=i386,win64 __crtFlsSetValue(long ptr)
+@ cdecl -arch=i386,win64 __crtGetDateFormatEx(wstr long ptr wstr ptr long wstr)
+@ cdecl __crtGetFileInformationByHandleEx(long long ptr long)
 @ cdecl -arch=i386,win64 __crtGetLocaleInfoEx(wstr long ptr long)
 @ cdecl __crtGetShowWindowMode()
-@ stub __crtGetTickCount64
-@ stub -arch=i386,win64 __crtGetTimeFormatEx
-@ stub -arch=i386,win64 __crtGetUserDefaultLocaleName
+@ cdecl -ret64 __crtGetTickCount64()
+@ cdecl -arch=i386,win64 __crtGetTimeFormatEx(wstr long ptr wstr ptr long)
+@ cdecl -arch=i386,win64 __crtGetUserDefaultLocaleName(ptr long)
 @ cdecl -arch=i386,win64 __crtInitializeCriticalSectionEx(ptr long long)
-@ stub __crtIsPackagedApp
-@ stub -arch=i386,win64 __crtIsValidLocaleName
+@ cdecl __crtIsPackagedApp()
+@ cdecl -arch=i386,win64 __crtIsValidLocaleName(wstr)
 @ cdecl __crtLCMapStringA(long long str long ptr long long long)
-@ stub -arch=i386,win64 __crtLCMapStringEx
+@ cdecl -arch=i386,win64 __crtLCMapStringEx(wstr long wstr long ptr long)
 @ cdecl __crtLCMapStringW(long long wstr long ptr long long long)
-@ stub __crtSetFileInformationByHandle
-@ stub -arch=i386,win64 __crtSetThreadStackGuarantee
+@ cdecl __crtSetFileInformationByHandle(long long ptr long)
+@ cdecl -arch=i386,win64 __crtSetThreadStackGuarantee(ptr)
 @ cdecl __crtSetUnhandledExceptionFilter(ptr)
 @ cdecl -arch=i386,win64 __crtTerminateProcess(long)
 @ cdecl __crtSleep(long)
diff --git a/dlls/msvcr120_app/msvcr120_app.spec b/dlls/msvcr120_app/msvcr120_app.spec
index 430a5ed..56f5de9 100644
--- a/dlls/msvcr120_app/msvcr120_app.spec
+++ b/dlls/msvcr120_app/msvcr120_app.spec
@@ -894,7 +894,7 @@
 @ stub __crtGetCurrentWinRTThread
 @ stub __crtGetCurrentWinRTThreadId
 @ stub __crtGetExitCodeWinRTThread
-@ stub __crtIsPackagedApp
+@ cdecl __crtIsPackagedApp() msvcr120.__crtIsPackagedApp
 @ cdecl __crtLCMapStringA(long long str long ptr long long long) msvcr120.__crtLCMapStringA
 @ cdecl __crtLCMapStringW(long long wstr long ptr long long long) msvcr120.__crtLCMapStringW
 @ cdecl __crtSleep(long) msvcr120.__crtSleep
diff --git a/dlls/msvcrt/misc.c b/dlls/msvcrt/misc.c
index 1ed24e7..fcfbcda 100644
--- a/dlls/msvcrt/misc.c
+++ b/dlls/msvcrt/misc.c
@@ -532,6 +532,196 @@ BOOL CDECL __crtInitializeCriticalSectionEx(
 
 #endif /* _MSVCR_VER>=110 */
 
+#if _MSVCR_VER>=110 && _MSVCR_VER<=120
+/* the CRT's wrappers of functions the Vista and later kernel32 has */
+
+LONG WINAPI GetCurrentPackageId(UINT32 *, BYTE *);
+BOOL WINAPI SetThreadStackGuarantee(ULONG *);
+
+/*********************************************************************
+ *  __crtCompareStringEx (MSVCR110.@)
+ */
+int CDECL __crtCompareStringEx(const WCHAR *locale, DWORD flags, const WCHAR *str1, int len1,
+        const WCHAR *str2, int len2)
+{
+    TRACE("(%s %#lx %s %d %s %d)\n", debugstr_w(locale), flags, debugstr_wn(str1, len1), len1,
+            debugstr_wn(str2, len2), len2);
+    return CompareStringEx(locale, flags, str1, len1, str2, len2, NULL, NULL, 0);
+}
+
+/*********************************************************************
+ *  __crtLCMapStringEx (MSVCR110.@)
+ */
+int CDECL __crtLCMapStringEx(const WCHAR *locale, DWORD flags, const WCHAR *src, int srclen,
+        WCHAR *dst, int dstlen)
+{
+    TRACE("(%s %#lx %s %d %p %d)\n", debugstr_w(locale), flags, debugstr_wn(src, srclen), srclen, dst, dstlen);
+    return LCMapStringEx(locale, flags, src, srclen, dst, dstlen, NULL, NULL, 0);
+}
+
+/*********************************************************************
+ *  __crtEnumSystemLocalesEx (MSVCR110.@)
+ */
+BOOL CDECL __crtEnumSystemLocalesEx(LOCALE_ENUMPROCEX proc, DWORD flags, LPARAM param)
+{
+    TRACE("(%p %#lx %Ix)\n", proc, flags, param);
+    return EnumSystemLocalesEx(proc, flags, param, NULL);
+}
+
+/*********************************************************************
+ *  __crtGetDateFormatEx (MSVCR110.@)
+ */
+int CDECL __crtGetDateFormatEx(const WCHAR *locale, DWORD flags, const SYSTEMTIME *date,
+        const WCHAR *format, WCHAR *buf, int len, const WCHAR *calendar)
+{
+    TRACE("(%s %#lx %p %s %p %d %s)\n", debugstr_w(locale), flags, date, debugstr_w(format), buf, len,
+            debugstr_w(calendar));
+    return GetDateFormatEx(locale, flags, date, format, buf, len, calendar);
+}
+
+/*********************************************************************
+ *  __crtGetTimeFormatEx (MSVCR110.@)
+ */
+int CDECL __crtGetTimeFormatEx(const WCHAR *locale, DWORD flags, const SYSTEMTIME *time,
+        const WCHAR *format, WCHAR *buf, int len)
+{
+    TRACE("(%s %#lx %p %s %p %d)\n", debugstr_w(locale), flags, time, debugstr_w(format), buf, len);
+    return GetTimeFormatEx(locale, flags, time, format, buf, len);
+}
+
+/*********************************************************************
+ *  __crtGetUserDefaultLocaleName (MSVCR110.@)
+ */
+int CDECL __crtGetUserDefaultLocaleName(WCHAR *buf, int len)
+{
+    TRACE("(%p %d)\n", buf, len);
+    return GetUserDefaultLocaleName(buf, len);
+}
+
+/*********************************************************************
+ *  __crtIsValidLocaleName (MSVCR110.@)
+ */
+BOOL CDECL __crtIsValidLocaleName(const WCHAR *locale)
+{
+    TRACE("(%s)\n", debugstr_w(locale));
+    return IsValidLocaleName(locale);
+}
+
+/*********************************************************************
+ *  __crtFlsAlloc (MSVCR110.@)
+ */
+DWORD CDECL __crtFlsAlloc(PFLS_CALLBACK_FUNCTION callback)
+{
+    TRACE("(%p)\n", callback);
+    return FlsAlloc(callback);
+}
+
+/*********************************************************************
+ *  __crtFlsFree (MSVCR110.@)
+ */
+BOOL CDECL __crtFlsFree(DWORD index)
+{
+    TRACE("(%lu)\n", index);
+    return FlsFree(index);
+}
+
+/*********************************************************************
+ *  __crtFlsGetValue (MSVCR110.@)
+ */
+void * CDECL __crtFlsGetValue(DWORD index)
+{
+    return FlsGetValue(index);
+}
+
+/*********************************************************************
+ *  __crtFlsSetValue (MSVCR110.@)
+ */
+BOOL CDECL __crtFlsSetValue(DWORD index, void *value)
+{
+#ifdef SG_MUTANT_CRT_FLS_SET_NOP
+    return TRUE;
+#endif
+    return FlsSetValue(index, value);
+}
+
+/*********************************************************************
+ *  __crtSetThreadStackGuarantee (MSVCR110.@)
+ */
+BOOL CDECL __crtSetThreadStackGuarantee(ULONG *size)
+{
+    TRACE("(%p)\n", size);
+    return SetThreadStackGuarantee(size);
+}
+
+/*********************************************************************
+ *  __crtCreateSymbolicLinkW (MSVCR110.@)
+ */
+BOOLEAN CDECL __crtCreateSymbolicLinkW(const WCHAR *link, const WCHAR *target, DWORD flags)
+{
+    TRACE("(%s %s %#lx)\n", debugstr_w(link), debugstr_w(target), flags);
+    return CreateSymbolicLinkW(link, target, flags);
+}
+
+/*********************************************************************
+ *  __crtCreateSemaphoreExW (MSVCR110.@)
+ */
+HANDLE CDECL __crtCreateSemaphoreExW(SECURITY_ATTRIBUTES *sa, LONG initial, LONG max,
+        const WCHAR *name, DWORD flags, DWORD access)
+{
+    TRACE("(%p %ld %ld %s %#lx %#lx)\n", sa, initial, max, debugstr_w(name), flags, access);
+    return CreateSemaphoreExW(sa, initial, max, name, flags, access);
+}
+
+/*********************************************************************
+ *  __crtIsPackagedApp (MSVCR110.@)
+ */
+BOOL CDECL __crtIsPackagedApp(void)
+{
+    UINT32 len = 0;
+
+    return GetCurrentPackageId(&len, NULL) != APPMODEL_ERROR_NO_PACKAGE;
+}
+#endif
+
+#if _MSVCR_VER==120
+/*********************************************************************
+ *  __crtCreateEventExW (MSVCR120.@)
+ */
+HANDLE CDECL __crtCreateEventExW(SECURITY_ATTRIBUTES *sa, const WCHAR *name, DWORD flags, DWORD access)
+{
+    TRACE("(%p %s %#lx %#lx)\n", sa, debugstr_w(name), flags, access);
+    return CreateEventExW(sa, name, flags, access);
+}
+
+/*********************************************************************
+ *  __crtGetTickCount64 (MSVCR120.@)
+ */
+ULONGLONG CDECL __crtGetTickCount64(void)
+{
+    return GetTickCount64();
+}
+
+/*********************************************************************
+ *  __crtGetFileInformationByHandleEx (MSVCR120.@)
+ */
+BOOL CDECL __crtGetFileInformationByHandleEx(HANDLE file, FILE_INFO_BY_HANDLE_CLASS class,
+        void *info, DWORD size)
+{
+    TRACE("(%p %d %p %lu)\n", file, class, info, size);
+    return GetFileInformationByHandleEx(file, class, info, size);
+}
+
+/*********************************************************************
+ *  __crtSetFileInformationByHandle (MSVCR120.@)
+ */
+BOOL CDECL __crtSetFileInformationByHandle(HANDLE file, FILE_INFO_BY_HANDLE_CLASS class,
+        void *info, DWORD size)
+{
+    TRACE("(%p %d %p %lu)\n", file, class, info, size);
+    return SetFileInformationByHandle(file, class, info, size);
+}
+#endif
+
 #if _MSVCR_VER>=120
 /*********************************************************************
  * _vacopy (MSVCR120.@)
