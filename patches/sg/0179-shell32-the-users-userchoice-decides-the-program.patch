--- a/dlls/shell32/assoc.c
+++ b/dlls/shell32/assoc.c
@@ -175,6 +175,34 @@
  *  Success: S_OK. iface is initialised with the parameters given.
  *  Failure: An HRESULT error code indicating the error.
  */
+/**************************************************************************
+ *  SHELL_GetUserChoice [internal]
+ *
+ * The program the user chose for a file extension (".txt": Explorer's
+ * FileExts\.txt\UserChoice) or a URL protocol ("http": the Shell
+ * Associations' UrlAssociations\http\UserChoice), as its ProgId -- which
+ * Windows prefers over the class the extension names. Only a ProgId that is
+ * registered counts. (Windows also checks a hash of the choice; we do not.)
+ */
+BOOL SHELL_GetUserChoice(const WCHAR *assoc, WCHAR *progid, DWORD len)
+{
+    WCHAR path[MAX_PATH + 96];
+    DWORD size = len * sizeof(WCHAR);
+    HKEY hkey;
+
+    if (!assoc || !*assoc || *assoc == '{' || wcslen(assoc) > MAX_PATH) return FALSE;
+    if (*assoc == '.')
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FileExts\\%s\\UserChoice", assoc);
+    else
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows\\Shell\\Associations\\UrlAssociations\\%s\\UserChoice", assoc);
+    if (RegGetValueW(HKEY_CURRENT_USER, path, L"ProgId", RRF_RT_REG_SZ, NULL, progid, &size) || !*progid)
+        return FALSE;
+    if (RegOpenKeyExW(HKEY_CLASSES_ROOT, progid, 0, KEY_READ, &hkey)) return FALSE;
+    RegCloseKey(hkey);
+    TRACE("%s: the user chose %s\n", debugstr_w(assoc), debugstr_w(progid));
+    return TRUE;
+}
