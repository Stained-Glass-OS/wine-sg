From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dnsapi: resolv.conf's "search ." is no DNS suffix

systemd-resolved's stub resolv.conf says "search ." when there is no search
domain. "." is the DNS root, never a suffix Windows lists, but it became the
search list: every adapter's "Connection-specific DNS suffix" was "."
(ipconfig /all, GetAdaptersAddresses' DnsSuffix, .NET's
IPInterfaceProperties.DnsSuffix) and the Network List Manager named every
network "." after it. The root is left out of DnsConfigSearchList.

Gate: test/dnsroot-gate.sh (its own resolv.conf in a private mount namespace);
mutant SG_MUTANT_DNS_ROOT_SUFFIX.
---
--- a/dlls/dnsapi/libresolv.c
+++ b/dlls/dnsapi/libresolv.c
@@ -124,6 +124,18 @@
     }
 }
 
+/* Stained Glass OS (wine-sg 9660): systemd-resolved's stub resolv.conf says "search ." when there
+ * is no search domain. "." is the DNS root, never a suffix Windows lists: every adapter's
+ * "Connection-specific DNS suffix" was "." (ipconfig /all, GetAdaptersAddresses' DnsSuffix), and
+ * the Network List Manager named every network "." after it. */
+static int sg_root_domain( const char *name )
+{
+#ifdef SG_MUTANT_DNS_ROOT_SUFFIX
+    return 0;
+#endif
+    return !name[0] || !strcmp( name, "." );
+}
+
 static NTSTATUS resolv_get_searchlist( void *args )
 {
     const struct get_searchlist_params *params = args;
@@ -134,7 +146,7 @@
     init_resolver();
 
     for (i = 0; i < MAXDNSRCH + 1 && _res.dnsrch[i]; i++)
-        needed += (strlen(_res.dnsrch[i]) + 1) * sizeof(WCHAR);
+        if (!sg_root_domain( _res.dnsrch[i] )) needed += (strlen(_res.dnsrch[i]) + 1) * sizeof(WCHAR);
     needed += sizeof(WCHAR); /* null terminator */
 
     if (!list || *params->len < needed)
@@ -148,7 +160,8 @@
     ptr = list;
     end = ptr + needed / sizeof(WCHAR);
     for (i = 0; i < MAXDNSRCH + 1 && _res.dnsrch[i]; i++)
-        ptr += ntdll_umbstowcs( _res.dnsrch[i], strlen(_res.dnsrch[i]) + 1, ptr, end - ptr );
+        if (!sg_root_domain( _res.dnsrch[i] ))
+            ptr += ntdll_umbstowcs( _res.dnsrch[i], strlen(_res.dnsrch[i]) + 1, ptr, end - ptr );
     *ptr = 0; /* null terminator */
     return ERROR_SUCCESS;
 }
