From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uiautomationcore: UiaGetUpdatedCache for the children, descendants and subtree scopes

UiaGetUpdatedCache (and UiaNavigate with it) refused every cache request scope but the
element itself with E_NOTIMPL, so clients that cache a node together with its children
(UI Automation clients fetch whole subtrees this way) got nothing.

The nodes come back in tree order (the node first when the element is in the scope, then
its children, each followed by its own when descendants are asked for), one row each
with the cached properties, and the tree description is the one Windows gives: an
element is 'P', its children follow in parentheses, then ')' ("P)" for one element,
"(P)P))" for the two children of a node). Children are those that match the view
condition of the request. The nodes are owned by the array. The parent and ancestors
scopes stay unsupported.
---
--- a/dlls/uiautomationcore/tests/uiautomation.c
+++ b/dlls/uiautomationcore/tests/uiautomation.c
@@ -9863,11 +9863,11 @@ static void test_UiaGetUpdatedCache(void)
     tree_struct = NULL; out_req = NULL;
     set_cache_request(&cache_req, (struct UiaCondition *)&UiaTrueCondition, TreeScope_Children, NULL, 0, NULL, 0, AutomationElementMode_Full);
     hr = UiaGetUpdatedCache(node, &cache_req, NormalizeState_None, NULL, &out_req, &tree_struct);
-    todo_wine ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine ok(!!out_req, "out_req == NULL\n");
-    todo_wine ok(!!tree_struct, "tree_struct == NULL\n");
-    todo_wine ok(Provider_child.ref == 2, "Unexpected refcnt %ld\n", Provider_child.ref);
-    todo_wine ok(Provider_child2.ref == 2, "Unexpected refcnt %ld\n", Provider_child2.ref);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!!out_req, "out_req == NULL\n");
+    ok(!!tree_struct, "tree_struct == NULL\n");
+    ok(Provider_child.ref == 2, "Unexpected refcnt %ld\n", Provider_child.ref);
+    ok(Provider_child2.ref == 2, "Unexpected refcnt %ld\n", Provider_child2.ref);
     if (out_req)
     {
         exp_elems[0] = 2;
--- a/dlls/uiautomationcore/uia_client.c
+++ b/dlls/uiautomationcore/uia_client.c
@@ -3649,6 +3649,81 @@ static HRESULT uia_node_normalize(HUIANODE huianode, struct UiaCondition *cond,
     return S_OK;
 }
 
+/* The nodes of a cache request, in the order of the tree they make, and the tree description. */
+struct uia_cache_tree
+{
+    HUIANODE *nodes;
+    SIZE_T count, capacity;
+    WCHAR *tree;
+    SIZE_T tree_len, tree_capacity;
+};
+
+static HRESULT uia_cache_tree_add_node(struct uia_cache_tree *ct, HUIANODE node)
+{
+    if (!uia_array_reserve((void **)&ct->nodes, &ct->capacity, ct->count + 1, sizeof(*ct->nodes)))
+        return E_OUTOFMEMORY;
+    ct->nodes[ct->count++] = node;
+    return S_OK;
+}
+
+static HRESULT uia_cache_tree_put(struct uia_cache_tree *ct, WCHAR ch)
+{
+    if (!uia_array_reserve((void **)&ct->tree, &ct->tree_capacity, ct->tree_len + 2, sizeof(*ct->tree)))
+        return E_OUTOFMEMORY;
+    ct->tree[ct->tree_len++] = ch;
+    ct->tree[ct->tree_len] = 0;
+    return S_OK;
+}
+
+/*
+ * The children of a node that match the condition. A node is written as 'P', then its children in
+ * parentheses if it has any, then ')'.
+ */
+static HRESULT uia_cache_tree_add_children(HUIANODE parent, struct UiaCondition *cond, BOOL descend,
+        struct uia_cache_tree *ct)
+{
+    HUIANODE child, next;
+    HRESULT hr;
+
+    hr = conditional_navigate_uia_node(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)parent),
+            NavigateDirection_FirstChild, cond, &child);
+    while (SUCCEEDED(hr) && child)
+    {
+        SIZE_T before, mark;
+
+        if (FAILED(hr = uia_cache_tree_add_node(ct, child)))
+        {
+            UiaNodeRelease(child);
+            return hr;
+        }
+        if (FAILED(hr = uia_cache_tree_put(ct, 'P')))
+            return hr;
+
+        if (descend)
+        {
+            mark = ct->tree_len;
+            before = ct->count;
+            if (FAILED(hr = uia_cache_tree_put(ct, '('))
+                    || FAILED(hr = uia_cache_tree_add_children(child, cond, descend, ct)))
+                return hr;
+            if (ct->count == before)
+            {
+                ct->tree_len = mark;
+                ct->tree[mark] = 0;
+            }
+            else if (FAILED(hr = uia_cache_tree_put(ct, ')')))
+                return hr;
+        }
+        if (FAILED(hr = uia_cache_tree_put(ct, ')')))
+            return hr;
+
+        hr = conditional_navigate_uia_node(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)child),
+                NavigateDirection_NextSibling, cond, &next);
+        child = next;
+    }
+    return hr;
+}
+
 /***********************************************************************
  *          UiaGetUpdatedCache (uiautomationcore.@)
  */
@@ -3656,13 +3731,15 @@ HRESULT WINAPI UiaGetUpdatedCache(HUIANODE huianode, struct UiaCacheRequest *cac
         struct UiaCondition *normalize_cond, SAFEARRAY **out_req, BSTR *tree_struct)
 {
     struct uia_node *node = unsafe_impl_from_IWineUiaNode((IWineUiaNode *)huianode);
+    struct uia_cache_tree ct = {0};
     struct UiaCondition *cond;
     SAFEARRAYBOUND sabound[2];
     HUIANODE ret_node;
-    SAFEARRAY *sa;
+    SAFEARRAY *sa = NULL;
     LONG idx[2];
     HRESULT hr;
     VARIANT v;
+    SIZE_T n;
     int i;
 
     TRACE("(%p, %p, %u, %p, %p, %p)\n", huianode, cache_req, normalize_state, normalize_cond, out_req, tree_struct);
@@ -3673,7 +3750,8 @@ HRESULT WINAPI UiaGetUpdatedCache(HUIANODE huianode, struct UiaCacheRequest *cac
     *tree_struct = NULL;
     *out_req = NULL;
 
-    if (cache_req->Scope != TreeScope_Element)
+    if ((!(cache_req->Scope & TreeScope_Element) && !(cache_req->Scope & (TreeScope_Children | TreeScope_Descendants)))
+            || (cache_req->Scope & ~TreeScope_Subtree))
     {
         FIXME("Unsupported cache request scope %#x\n", cache_req->Scope);
         return E_NOTIMPL;
@@ -3720,7 +3798,62 @@ HRESULT WINAPI UiaGetUpdatedCache(HUIANODE huianode, struct UiaCacheRequest *cac
         return S_OK;
     }
 
-    sabound[0].cElements = 1;
+    if (cache_req->Scope & TreeScope_Element)
+    {
+        if (FAILED(hr = uia_cache_tree_add_node(&ct, ret_node)) || FAILED(hr = uia_cache_tree_put(&ct, 'P')))
+            goto exit;
+    }
+
+    if (cache_req->Scope & (TreeScope_Children | TreeScope_Descendants))
+    {
+        static struct UiaCondition true_cond = { ConditionType_True };
+        struct UiaCondition *child_cond = cache_req->pViewCondition ? cache_req->pViewCondition : &true_cond;
+        SIZE_T mark = ct.tree_len, before = ct.count;
+
+#ifdef SG_MUTANT_UIA_CACHE_NO_CHILDREN
+        goto skip_children;
+#endif
+        if (FAILED(hr = uia_cache_tree_put(&ct, '('))
+                || FAILED(hr = uia_cache_tree_add_children(ret_node, child_cond,
+#ifdef SG_MUTANT_UIA_CACHE_FLAT_TREE
+                        FALSE,
+#else
+                        (cache_req->Scope & TreeScope_Descendants) != 0,
+#endif
+                        &ct)))
+            goto exit;
+        if (ct.count == before)
+        {
+            ct.tree_len = mark;
+            if (ct.tree) ct.tree[mark] = 0;
+        }
+        else if (FAILED(hr = uia_cache_tree_put(&ct, ')')))
+            goto exit;
+#ifdef SG_MUTANT_UIA_CACHE_NO_CHILDREN
+skip_children:
+        ;
+#endif
+    }
+    if (cache_req->Scope & TreeScope_Element)
+    {
+        if (FAILED(hr = uia_cache_tree_put(&ct, ')')))
+            goto exit;
+    }
+    else
+    {
+        /* the root is only where the children come from */
+        UiaNodeRelease(ret_node);
+        ret_node = NULL;
+    }
+
+    if (!ct.count)
+    {
+        *tree_struct = SysAllocString(L"");
+        hr = *tree_struct ? S_OK : E_OUTOFMEMORY;
+        goto exit;
+    }
+
+    sabound[0].cElements = ct.count;
     sabound[1].cElements = 1 + cache_req->cProperties;
     sabound[0].lLbound = sabound[1].lLbound = 0;
     if (!(sa = SafeArrayCreate(VT_VARIANT, 2, sabound)))
@@ -3730,38 +3863,57 @@ HRESULT WINAPI UiaGetUpdatedCache(HUIANODE huianode, struct UiaCacheRequest *cac
         goto exit;
     }
 
-    get_variant_for_node(ret_node, &v);
-    idx[0] = idx[1] = 0;
-
-    hr = SafeArrayPutElement(sa, idx, &v);
-    if (FAILED(hr))
-        goto exit;
-
-    idx[0] = 0;
-    VariantClear(&v);
-    for (i = 0; i < cache_req->cProperties; i++)
+    for (n = 0; n < ct.count; n++)
     {
-        hr = UiaGetPropertyValue(ret_node, cache_req->pProperties[i], &v);
-        /* Don't fail on unimplemented properties. */
-        if (FAILED(hr) && hr != E_NOTIMPL)
-            goto exit;
-
-        idx[1] = 1 + i;
+        idx[0] = n;
+        idx[1] = 0;
+        get_variant_for_node(ct.nodes[n], &v);
         hr = SafeArrayPutElement(sa, idx, &v);
-        VariantClear(&v);
         if (FAILED(hr))
             goto exit;
+
+        VariantClear(&v);
+        for (i = 0; i < cache_req->cProperties; i++)
+        {
+            hr = UiaGetPropertyValue(ct.nodes[n], cache_req->pProperties[i], &v);
+            /* Don't fail on unimplemented properties. */
+            if (FAILED(hr) && hr != E_NOTIMPL)
+                goto exit;
+
+            idx[1] = 1 + i;
+            hr = SafeArrayPutElement(sa, idx, &v);
+            VariantClear(&v);
+            if (FAILED(hr))
+                goto exit;
+        }
     }
 
+    if (!(*tree_struct = SysAllocString(ct.tree)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto exit;
+    }
     *out_req = sa;
-    *tree_struct = SysAllocString(L"P)");
+    sa = NULL;
+    ct.count = 0; /* the array holds the nodes */
+    ret_node = NULL;
+    hr = S_OK;
 
 exit:
     if (FAILED(hr))
-    {
         SafeArrayDestroy(sa);
-        UiaNodeRelease(ret_node);
+    if (FAILED(hr) || !*out_req)
+    {
+        for (n = 0; n < ct.count; n++)
+        {
+            if (ct.nodes[n] != ret_node)
+                UiaNodeRelease(ct.nodes[n]);
+        }
+        if (ret_node)
+            UiaNodeRelease(ret_node);
     }
+    free(ct.nodes);
+    free(ct.tree);
 
     return hr;
 }
