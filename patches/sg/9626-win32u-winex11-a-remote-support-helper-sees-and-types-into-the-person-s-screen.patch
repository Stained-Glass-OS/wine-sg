+/***********************************************************************
+ *           x11drv_compositor_priv_connect
+ *
+ * The compositor's privileged socket (SG_COMPOSITOR_PRIV), if this is a
+ * remote-support helper: checked to be served by the account its directory
+ * is named for (a seat directory: .../<uid>/priv.sock), as sg-lockd and
+ * sg-elevated-run check theirs, so a socket put in its place by anyone else
+ * gets nothing -- not a keystroke a technician types. NULL: not a helper, or
+ * no such compositor.
+ */
+struct wl_display *x11drv_compositor_priv_connect(void)
+{
+    const char *path = getenv( "SG_COMPOSITOR_PRIV" ), *slash, *dir;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    struct ucred cred;
+    socklen_t len = sizeof(cred);
+    struct wl_display *display;
+    char *end;
+    unsigned long uid;
+    int fd;
+
+    if (!path || !*path || strlen( path ) >= sizeof(addr.sun_path)) return NULL;
+    /* the directory's name: the uid */
+    if (!(slash = strrchr( path, '/' )) || slash == path) return NULL;
+    for (dir = slash - 1; dir > path && dir[-1] != '/'; dir--) ;
+    if (dir == slash || *dir < '0' || *dir > '9') return NULL;
+    uid = strtoul( dir, &end, 10 );
+    if (end != slash) return NULL;
+    strcpy( addr.sun_path, path );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return NULL;
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0 ||
+        getsockopt( fd, SOL_SOCKET, SO_PEERCRED, &cred, &len ) < 0 ||
+        cred.uid != (uid_t)uid ||
+        !(display = wl_display_connect_to_fd( fd )))
+    {
+        WARN( "no compositor of uid %lu at %s\n", uid, path );
+        close( fd );
+        return NULL;
+    }
+    return display;
+}
+
+#define MAX_OUTPUTS 16
+
+static pthread_mutex_t inject_mutex = PTHREAD_MUTEX_INITIALIZER;
+static BOOL inject_tried;
+static struct wl_display *inject_display;
+static struct wl_seat *inject_seat;
+static struct zwp_virtual_keyboard_manager_v1 *keyboard_manager;
+static struct zwlr_virtual_pointer_manager_v1 *pointer_manager;
+static struct zxdg_output_manager_v1 *xdg_manager;
+static struct zwp_virtual_keyboard_v1 *keyboard;
+static struct zwlr_virtual_pointer_v1 *pointer;
+static struct xkb_context *xkb;
+static struct xkb_keymap *keymap;
+static struct xkb_state *xkb_state;
+static struct { struct wl_output *output; struct zxdg_output_v1 *xdg; int x, y, w, h; } outputs[MAX_OUTPUTS];
+static int output_count;
+static unsigned char keys_down[256];
+
+static void xdg_position( void *data, struct zxdg_output_v1 *xdg, int32_t x, int32_t y )
+{
+    int i = (int)(INT_PTR)data;
+    outputs[i].x = x;
+    outputs[i].y = y;
+}
+
+static void xdg_size( void *data, struct zxdg_output_v1 *xdg, int32_t w, int32_t h )
+{
+    int i = (int)(INT_PTR)data;
+    outputs[i].w = w;
+    outputs[i].h = h;
+}
+
+static void xdg_ignore( void *data, struct zxdg_output_v1 *xdg ) {}
+static void xdg_ignore_str( void *data, struct zxdg_output_v1 *xdg, const char *s ) {}
+
+static const struct zxdg_output_v1_listener xdg_listener =
+{
+    xdg_position, xdg_size, xdg_ignore, xdg_ignore_str, xdg_ignore_str
+};
+
+static void registry_global( void *data, struct wl_registry *registry, uint32_t name,
+                             const char *iface, uint32_t version )
+{
+    if (!strcmp( iface, wl_seat_interface.name ) && !inject_seat)
+        inject_seat = wl_registry_bind( registry, name, &wl_seat_interface, 1 );
+    else if (!strcmp( iface, zwp_virtual_keyboard_manager_v1_interface.name ))
+        keyboard_manager = wl_registry_bind( registry, name, &zwp_virtual_keyboard_manager_v1_interface, 1 );
+    else if (!strcmp( iface, zwlr_virtual_pointer_manager_v1_interface.name ))
+        pointer_manager = wl_registry_bind( registry, name, &zwlr_virtual_pointer_manager_v1_interface, 1 );
+    else if (!strcmp( iface, zxdg_output_manager_v1_interface.name ))
+        xdg_manager = wl_registry_bind( registry, name, &zxdg_output_manager_v1_interface,
+                                        version < 2 ? version : 2 );
+    else if (!strcmp( iface, wl_output_interface.name ) && output_count < MAX_OUTPUTS)
+        outputs[output_count++].output = wl_registry_bind( registry, name, &wl_output_interface, 1 );
+}
+
+static void registry_global_remove( void *data, struct wl_registry *registry, uint32_t name ) {}
+
+static const struct wl_registry_listener registry_listener = { registry_global, registry_global_remove };
+
+/* The ordinary evdev/us keymap, as sg-session's Remote Desktop stream uses:
+ * the keys go by their evdev codes (from the Windows scan codes), which mean
+ * the same whatever the session's layout. */
+static BOOL upload_keymap(void)
+{
+    struct xkb_rule_names names = { "evdev", "pc105", "us", "", "" };
+    char *text;
+    size_t len;
+    int fd;
+
+    if (!(xkb = xkb_context_new( XKB_CONTEXT_NO_FLAGS ))) return FALSE;
+    if (!(keymap = xkb_keymap_new_from_names( xkb, &names, XKB_KEYMAP_COMPILE_NO_FLAGS ))) return FALSE;
+    if (!(xkb_state = xkb_state_new( keymap ))) return FALSE;
+    if (!(text = xkb_keymap_get_as_string( keymap, XKB_KEYMAP_FORMAT_TEXT_V1 ))) return FALSE;
+    len = strlen( text ) + 1;
+    fd = memfd_create( "wine-remote-keymap", MFD_CLOEXEC );
+    if (fd < 0 || write( fd, text, len ) != (ssize_t)len)
+    {
+        free( text );
+        if (fd >= 0) close( fd );
+        return FALSE;
+    }
+    free( text );
+    zwp_virtual_keyboard_v1_keymap( keyboard, WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1, fd, (uint32_t)len );
+    close( fd );
+    return TRUE;
+}
+
+/* Connect once. FALSE: this program's input goes to the wineserver. */
+static BOOL inject_init(void)
+{
+    struct wl_registry *registry;
+    int i;
+
+    if (inject_tried) return keyboard && pointer;
+    inject_tried = TRUE;
+#ifdef SG_MUTANT_INJECT_SERVER_ONLY
+    return FALSE;
+#endif
+    if (!(inject_display = x11drv_compositor_priv_connect())) return FALSE;
+    registry = wl_display_get_registry( inject_display );
+    wl_registry_add_listener( registry, &registry_listener, NULL );
+    wl_display_roundtrip( inject_display );
+    if (xdg_manager)
+    {
+        for (i = 0; i < output_count; i++)
+        {
+            outputs[i].xdg = zxdg_output_manager_v1_get_xdg_output( xdg_manager, outputs[i].output );
+            zxdg_output_v1_add_listener( outputs[i].xdg, &xdg_listener, (void *)(INT_PTR)i );
+        }
+        wl_display_roundtrip( inject_display );
+    }
+    if (!inject_seat || !keyboard_manager || !pointer_manager || !xdg_manager || !output_count)
+    {
+        /* the compositor did not grant injection: not remote support */
+        WARN( "the compositor offers no input injection: SendInput goes to the wineserver\n" );
+        return FALSE;
+    }
+    keyboard = zwp_virtual_keyboard_manager_v1_create_virtual_keyboard( keyboard_manager, inject_seat );
+    pointer = zwlr_virtual_pointer_manager_v1_create_virtual_pointer( pointer_manager, inject_seat );
+    if (!keyboard || !pointer || !upload_keymap() || wl_display_roundtrip( inject_display ) < 0)
+    {
+        WARN( "cannot make the virtual keyboard and pointer\n" );
+        keyboard = NULL;
+        pointer = NULL;
+        return FALSE;
+    }
+    TRACE( "input goes to the compositor (%d outputs)\n", output_count );
+    return TRUE;
+}
+
+static UINT32 now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (UINT32)(ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
+}
+
+static void send_key( UINT evdev, BOOL down )
+{
+    if (!evdev || evdev >= ARRAY_SIZE(keys_down)) return;
+    if (!down && !keys_down[evdev]) return;   /* never release what was not pressed */
+    keys_down[evdev] = down;
+    xkb_state_update_key( xkb_state, evdev + 8, down ? XKB_KEY_DOWN : XKB_KEY_UP );
+    zwp_virtual_keyboard_v1_key( keyboard, now_ms(), evdev,
+                                 down ? WL_KEYBOARD_KEY_STATE_PRESSED : WL_KEYBOARD_KEY_STATE_RELEASED );
+    zwp_virtual_keyboard_v1_modifiers( keyboard,
+                                       xkb_state_serialize_mods( xkb_state, XKB_STATE_MODS_DEPRESSED ),
+                                       xkb_state_serialize_mods( xkb_state, XKB_STATE_MODS_LATCHED ),
+                                       xkb_state_serialize_mods( xkb_state, XKB_STATE_MODS_LOCKED ),
+                                       xkb_state_serialize_layout( xkb_state, XKB_STATE_LAYOUT_EFFECTIVE ) );
+}
+
+/* A Windows (set 1) scan code as an evdev key code: the same numbers for the
+ * keys without the E0 prefix, a table for those with it. */
+static UINT scan_to_evdev( UINT scan, BOOL extended )
+{
+    static const struct { BYTE scan; BYTE evdev; } e0[] =
+    {
+        { 0x1c, 96 /* KPENTER */ }, { 0x1d, 97 /* RIGHTCTRL */ }, { 0x35, 98 /* KPSLASH */ },
+        { 0x37, 99 /* SYSRQ */ }, { 0x38, 100 /* RIGHTALT */ }, { 0x47, 102 /* HOME */ },
+        { 0x48, 103 /* UP */ }, { 0x49, 104 /* PAGEUP */ }, { 0x4b, 105 /* LEFT */ },
+        { 0x4d, 106 /* RIGHT */ }, { 0x4f, 107 /* END */ }, { 0x50, 108 /* DOWN */ },
+        { 0x51, 109 /* PAGEDOWN */ }, { 0x52, 110 /* INSERT */ }, { 0x53, 111 /* DELETE */ },
+        { 0x5b, 125 /* LEFTMETA */ }, { 0x5c, 126 /* RIGHTMETA */ }, { 0x5d, 127 /* COMPOSE */ },
+    };
+    UINT i;
+
+    scan &= 0xff;
+    if (!extended) return (scan && scan <= 0x58) ? scan : 0;
+    for (i = 0; i < ARRAY_SIZE(e0); i++) if (e0[i].scan == scan) return e0[i].evdev;
+    return 0;
+}
+
+/* The scan code of a virtual key: the keys whose scan code has the E0
+ * prefix first, since a layout's table may give the numeric pad's. */
+static UINT vk_to_scan( WORD vk, BOOL *extended )
+{
+    static const struct { BYTE vk; BYTE scan; } e0[] =
+    {
+        { VK_PRIOR, 0x49 }, { VK_NEXT, 0x51 }, { VK_END, 0x4f }, { VK_HOME, 0x47 },
+        { VK_LEFT, 0x4b }, { VK_UP, 0x48 }, { VK_RIGHT, 0x4d }, { VK_DOWN, 0x50 },
+        { VK_INSERT, 0x52 }, { VK_DELETE, 0x53 }, { VK_LWIN, 0x5b }, { VK_RWIN, 0x5c },
+        { VK_APPS, 0x5d }, { VK_DIVIDE, 0x35 }, { VK_RCONTROL, 0x1d }, { VK_RMENU, 0x38 },
+        { VK_SNAPSHOT, 0x37 },
+    };
+    static const struct { BYTE vk; BYTE scan; } plain[] =
+    {
+        { VK_SHIFT, 0x2a }, { VK_LSHIFT, 0x2a }, { VK_RSHIFT, 0x36 }, { VK_CONTROL, 0x1d },
+        { VK_LCONTROL, 0x1d }, { VK_MENU, 0x38 }, { VK_LMENU, 0x38 }, { VK_RETURN, 0x1c },
+        { VK_BACK, 0x0e }, { VK_TAB, 0x0f }, { VK_ESCAPE, 0x01 }, { VK_SPACE, 0x39 },
+        { VK_CAPITAL, 0x3a }, { VK_NUMLOCK, 0x45 }, { VK_SCROLL, 0x46 },
+    };
+    UINT i, scan;
+
+    for (i = 0; i < ARRAY_SIZE(e0); i++) if (e0[i].vk == vk) { *extended = TRUE; return e0[i].scan; }
+    for (i = 0; i < ARRAY_SIZE(plain); i++) if (plain[i].vk == vk) return plain[i].scan;
+    if (vk >= VK_F1 && vk <= VK_F10) return 0x3b + (vk - VK_F1);
+    if (vk == VK_F11) return 0x57;
+    if (vk == VK_F12) return 0x58;
+    scan = NtUserMapVirtualKeyEx( vk, MAPVK_VK_TO_VSC_EX, NtUserGetKeyboardLayout( 0 ) );
+    if ((scan >> 8) == 0xe0) *extended = TRUE;
+    return scan & 0xff;
+}
+
+/* A character sent as text (KEYEVENTF_UNICODE): typed as the key that makes
+ * it in the us keymap, with Shift if it takes Shift. */
+static void send_unicode( WCHAR ch, BOOL down )
+{
+    xkb_keysym_t sym = xkb_utf32_to_keysym( ch == '\r' ? '\n' : ch );
+    xkb_keycode_t kc;
+    xkb_level_index_t level;
+
+    if (ch == '\r' || ch == '\n') sym = XKB_KEY_Return;
+    if (sym == XKB_KEY_NoSymbol) return;
+    for (level = 0; level < 2; level++)
+        for (kc = xkb_keymap_min_keycode( keymap ); kc <= xkb_keymap_max_keycode( keymap ); kc++)
+        {
+            const xkb_keysym_t *syms;
+            if (xkb_keymap_key_get_syms_by_level( keymap, kc, 0, level, &syms ) >= 1 && syms[0] == sym)
+            {
+                if (down)
+                {
+                    if (level) send_key( 42 /* LEFTSHIFT */, TRUE );
+                    send_key( kc - 8, TRUE );
+                }
+                else
+                {
+                    send_key( kc - 8, FALSE );
+                    if (level) send_key( 42 /* LEFTSHIFT */, FALSE );
+                }
+                return;
+            }
+        }
+    WARN( "no key types U+%04x\n", ch );
+}
+
+/* the layout's box (the compositor's outputs): absolute positions are in it */
+static void layout_box( int *x, int *y, int *w, int *h )
+{
+    int i, l = 0, t = 0, r = 0, b = 0;
+
+    for (i = 0; i < output_count; i++)
+    {
+        if (!outputs[i].w || !outputs[i].h) continue;
+        if (r == l || outputs[i].x < l) l = outputs[i].x;
+        if (b == t || outputs[i].y < t) t = outputs[i].y;
+        if (outputs[i].x + outputs[i].w > r) r = outputs[i].x + outputs[i].w;
+        if (outputs[i].y + outputs[i].h > b) b = outputs[i].y + outputs[i].h;
+    }
+    *x = l; *y = t; *w = r - l; *h = b - t;
+}
+
+/* a point of Wine's virtual screen as a position on the layout: the helper's
+ * X server is the compositor's (rootless), whose root is the layout's box */
+static void move_absolute( INT x, INT y )
+{
+    POINT root = virtual_screen_to_root( x, y );
+    int lx, ly, w, h;
+
+    layout_box( &lx, &ly, &w, &h );
+    if (w <= 0 || h <= 0) return;
+    root.x = max( 0, min( root.x, w - 1 ) );
+    root.y = max( 0, min( root.y, h - 1 ) );
+    zwlr_virtual_pointer_v1_motion_absolute( pointer, now_ms(), root.x, root.y, w, h );
+    zwlr_virtual_pointer_v1_frame( pointer );
+}
+
+static void send_mouse( const MOUSEINPUT *mi )
+{
+    UINT32 t = now_ms();
+    DWORD f = mi->dwFlags;
+
+    if (f & MOUSEEVENTF_MOVE)
+    {
+        /* win32u made an absolute move virtual-screen pixels (update_mouse_coords) */
+        if (f & MOUSEEVENTF_ABSOLUTE) move_absolute( mi->dx, mi->dy );
+        else
+        {
+            zwlr_virtual_pointer_v1_motion( pointer, t, wl_fixed_from_int( mi->dx ), wl_fixed_from_int( mi->dy ) );
+            zwlr_virtual_pointer_v1_frame( pointer );
+        }
+    }
+#define BUTTON(down, up, code) \
+    if (f & (down)) zwlr_virtual_pointer_v1_button( pointer, t, code, WL_POINTER_BUTTON_STATE_PRESSED ); \
+    if (f & (up)) zwlr_virtual_pointer_v1_button( pointer, t, code, WL_POINTER_BUTTON_STATE_RELEASED );
+    BUTTON( MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_LEFTUP, 0x110 /* BTN_LEFT */ )
+    BUTTON( MOUSEEVENTF_RIGHTDOWN, MOUSEEVENTF_RIGHTUP, 0x111 /* BTN_RIGHT */ )
+    BUTTON( MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_MIDDLEUP, 0x112 /* BTN_MIDDLE */ )
+#undef BUTTON
+    if (f & (MOUSEEVENTF_XDOWN | MOUSEEVENTF_XUP))
+    {
+        UINT code = (HIWORD( mi->mouseData ) & XBUTTON2) ? 0x114 /* BTN_EXTRA */ : 0x113 /* BTN_SIDE */;
+        zwlr_virtual_pointer_v1_button( pointer, t, code, (f & MOUSEEVENTF_XDOWN) ? WL_POINTER_BUTTON_STATE_PRESSED
+                                                                                    : WL_POINTER_BUTTON_STATE_RELEASED );
+    }
+    if (f & (MOUSEEVENTF_WHEEL | MOUSEEVENTF_HWHEEL))
+    {
+        int delta = (short)LOWORD( mi->mouseData ), steps = delta / WHEEL_DELTA;
+        /* Windows' up is Wayland's negative vertical; right is positive horizontal */
+        UINT axis = (f & MOUSEEVENTF_HWHEEL) ? WL_POINTER_AXIS_HORIZONTAL_SCROLL : WL_POINTER_AXIS_VERTICAL_SCROLL;
+        int sign = (f & MOUSEEVENTF_HWHEEL) ? 1 : -1;
+        if (!steps) steps = delta > 0 ? 1 : -1;
+        zwlr_virtual_pointer_v1_axis_source( pointer, WL_POINTER_AXIS_SOURCE_WHEEL );
+        zwlr_virtual_pointer_v1_axis_discrete( pointer, t, axis, wl_fixed_from_int( sign * steps * 15 ), sign * steps );
+    }
+    zwlr_virtual_pointer_v1_frame( pointer );
+}
+
+static void send_keyboard( const KEYBDINPUT *ki )
+{
+    BOOL down = !(ki->dwFlags & KEYEVENTF_KEYUP), extended = !!(ki->dwFlags & KEYEVENTF_EXTENDEDKEY);
+    UINT scan;
+
+    if (ki->dwFlags & KEYEVENTF_UNICODE)
+    {
+        send_unicode( ki->wScan, down );
+        return;
+    }
+    if (ki->dwFlags & KEYEVENTF_SCANCODE)
+    {
+        scan = ki->wScan & 0xff;
+        if ((ki->wScan >> 8) == 0xe0) extended = TRUE;
+    }
+    else scan = vk_to_scan( ki->wVk, &extended );
+    send_key( scan_to_evdev( scan, extended ), down );
+}
+
+/***********************************************************************
+ *           X11DRV_SendInput
+ *
+ * TRUE: the compositor took it (a remote-support helper's input).
+ */
+BOOL X11DRV_SendInput( const INPUT *input )
+{
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock( &inject_mutex );
+    if (inject_init())
+    {
+        if (input->type == INPUT_KEYBOARD) send_keyboard( &input->ki );
+        else if (input->type == INPUT_MOUSE) send_mouse( &input->mi );
+        if (wl_display_flush( inject_display ) < 0 && errno != EAGAIN)
+        {
+            /* the compositor went away (the person signed out): the
+             * wineserver from now on */
+            WARN( "the compositor is gone\n" );
+            keyboard = NULL;
+            pointer = NULL;
+        }
+        else ret = TRUE;
+        wl_display_dispatch_pending( inject_display );
+    }
+    pthread_mutex_unlock( &inject_mutex );
+    return ret;
+}
+
+/***********************************************************************
+ *           x11drv_compositor_warp
+ *
+ * SetCursorPos for a remote-support helper: the person's pointer moves.
+ * FALSE: not one; warp the X pointer as ever.
+ */
+BOOL x11drv_compositor_warp( INT x, INT y )
+{
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock( &inject_mutex );
+    if (inject_init())
+    {
+        move_absolute( x, y );
+        ret = wl_display_flush( inject_display ) >= 0 || errno == EAGAIN;
+    }
+    pthread_mutex_unlock( &inject_mutex );
+    return ret;
+}
