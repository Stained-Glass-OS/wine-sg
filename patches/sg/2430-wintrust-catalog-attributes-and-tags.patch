+/* One CAT_NAMEVALUE as a CRYPTCATATTRIBUTE, in one allocation. dwReserved is its position in the list. */
+static CRYPTCATATTRIBUTE *make_attribute(struct cryptcat *cc, const CRYPT_DATA_BLOB *encoded, DWORD index)
+{
+    CRYPTCATATTRIBUTE *attr;
+    CAT_NAMEVALUE *nv;
+    DWORD size, tag_len;
+
+    if (!CryptDecodeObject(cc->encoding, CAT_NAMEVALUE_OBJID, encoded->pbData, encoded->cbData, 0, NULL, &size))
+        return NULL;
+    if (!(nv = malloc(size))) return NULL;
+    if (!CryptDecodeObject(cc->encoding, CAT_NAMEVALUE_OBJID, encoded->pbData, encoded->cbData, 0, nv, &size))
+    {
+        free(nv);
+        return NULL;
+    }
+
+    tag_len = (lstrlenW(nv->pwszTag) + 1) * sizeof(WCHAR);
+    if ((attr = calloc(1, sizeof(*attr) + tag_len + nv->Value.cbData)))
+    {
+        attr->cbStruct            = sizeof(*attr);
+        attr->pwszReferenceTag    = (WCHAR *)(attr + 1);
+        memcpy(attr->pwszReferenceTag, nv->pwszTag, tag_len);
+        attr->dwAttrTypeAndAction = nv->fdwFlags;
+#ifndef SG_MUTANT_CAT_ATTRVAL
+        attr->cbValue             = nv->Value.cbData;
+#else
+        attr->cbValue             = nv->Value.cbData - sizeof(WCHAR);
+#endif
+        attr->pbValue             = (BYTE *)attr->pwszReferenceTag + tag_len;
+        memcpy(attr->pbValue, nv->Value.pbData, nv->Value.cbData);
+        attr->dwReserved          = index;
+    }
+    free(nv);
+    return attr;
+}
+
+/* The name/value attributes of a list of encoded attributes (extensions or entry attributes), in the
+ * order they are listed to callers: the reverse of the order in the file, like the members. */
+static BOOL collect_attributes(struct cryptcat *cc, DWORD count, const char *(*get)(const void *, DWORD, const CRYPT_DATA_BLOB **),
+                               const void *list, CRYPTCATATTRIBUTE ***out, DWORD *out_count)
+{
+    CRYPTCATATTRIBUTE **array;
+    const CRYPT_DATA_BLOB *blob;
+    DWORD i, n = 0;
+
+    if (!(array = calloc(count ? count : 1, sizeof(*array)))) return FALSE;
+    for (i = count; i > 0; i--)
+    {
+#ifndef SG_MUTANT_CAT_ATTRORDER
+        const char *oid = get(list, i - 1, &blob);
+#else
+        const char *oid = get(list, count - i, &blob);
+#endif
+        if (!oid || strcmp(oid, CAT_NAMEVALUE_OBJID)) continue;
+        if (!(array[n] = make_attribute(cc, blob, n)))
+        {
+            while (n--) free(array[n]);
+            free(array);
+            return FALSE;
+        }
+        n++;
+    }
+    *out = array;
+    *out_count = n;
+    return TRUE;
+}
+
+static const char *get_extension(const void *list, DWORD i, const CRYPT_DATA_BLOB **blob)
+{
+    const CERT_EXTENSION *ext = (const CERT_EXTENSION *)list + i;
+    *blob = &ext->Value;
+    return ext->pszObjId;
+}
+
+static const char *get_entry_attribute(const void *list, DWORD i, const CRYPT_DATA_BLOB **blob)
+{
+    const CRYPT_ATTRIBUTE *attr = (const CRYPT_ATTRIBUTE *)list + i;
+    *blob = attr->cValue == 1 ? attr->rgValue : NULL;
+    return *blob ? attr->pszObjId : NULL;
+}
+
+static BOOL build_cat_attributes(struct cryptcat *cc)
+{
+    if (cc->cat_attrs) return TRUE;
+    if (!cc->inner) return FALSE;
+    return collect_attributes(cc, cc->inner->cExtension, get_extension, cc->inner->rgExtension,
+                              &cc->cat_attrs, &cc->cat_attr_count);
+}
+
+static BOOL build_entry_attributes(struct cryptcat *cc, DWORD entry)
+{
+    if (!cc->inner || entry >= cc->inner->cCTLEntry) return FALSE;
+    if (!cc->entry_attrs)
+    {
+        cc->entry_attrs = calloc(cc->inner->cCTLEntry, sizeof(*cc->entry_attrs));
+        cc->entry_attr_count = calloc(cc->inner->cCTLEntry, sizeof(*cc->entry_attr_count));
+        if (!cc->entry_attrs || !cc->entry_attr_count) return FALSE;
+    }
+    if (cc->entry_attrs[entry]) return TRUE;
+    return collect_attributes(cc, cc->inner->rgCTLEntry[entry].cAttribute, get_entry_attribute,
+                              cc->inner->rgCTLEntry[entry].rgAttribute,
+                              &cc->entry_attrs[entry], &cc->entry_attr_count[entry]);
+}
+
+static void free_attribute_lists(struct cryptcat *cc)
+{
+    DWORD i, j;
+
+    for (i = 0; i < cc->cat_attr_count; i++) free(cc->cat_attrs[i]);
+    free(cc->cat_attrs);
+    if (cc->inner)
+    {
+        for (i = 0; cc->entry_attrs && i < cc->inner->cCTLEntry; i++)
+        {
+            for (j = 0; cc->entry_attrs[i] && j < cc->entry_attr_count[i]; j++) free(cc->entry_attrs[i][j]);
+            free(cc->entry_attrs[i]);
+        }
+    }
+    free(cc->entry_attrs);
+    free(cc->entry_attr_count);
+}
+
+static BOOL valid_catalog_handle(HANDLE h)
+{
+    struct cryptcat *cc = h;
+    return h && h != INVALID_HANDLE_VALUE && cc->magic == CRYPTCAT_MAGIC;
+}
+
+static CRYPTCATATTRIBUTE *next_attribute(CRYPTCATATTRIBUTE **list, DWORD count, CRYPTCATATTRIBUTE *prev)
+{
+    DWORD next = prev ? prev->dwReserved + 1 : 0;
+
+    if (next >= count)
+    {
+        SetLastError(CRYPT_E_NOT_FOUND);
+        return NULL;
+    }
+    return list[next];
+}
+
