 CRYPTCATATTRIBUTE * WINAPI CryptCATGetAttrInfo(HANDLE hCatalog, CRYPTCATMEMBER *member, LPWSTR tag)
 {
     struct cryptcat *cc = hCatalog;
+    CRYPTCATATTRIBUTE *attr = NULL;
