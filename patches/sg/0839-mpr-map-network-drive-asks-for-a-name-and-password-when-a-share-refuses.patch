From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mpr: Map Network Drive asks for a name and password when a share refuses

Mapping a share that refuses the signed-in user (a guest, or a domain user
the server does not know) showed "The folder cannot be reached. Access
denied." and stopped; the only way in was to tick "Connect using different
credentials" first. As Windows' Map Network Drive does, a refused share
now brings up "Enter network credentials" (for that server), asks again
with "Logon unsuccessful" while the name or password is wrong, and maps
the drive with the right ones; Cancel goes back to the dialog.

Test: test/mapcred-gate.sh with test/mapcred-probe.c and
test/mapcred-netmountd.py, a stand-in for sg-netmountd (mutant
SG_MUTANT_MAP_NO_CRED_RETRY). The lab machine: \\fs1\private mapped as Y:
after a wrong and a right password.
---
--- a/dlls/mpr/mapdlg.c
+++ b/dlls/mpr/mapdlg.c
@@ -201,7 +201,8 @@
         WCHAR pass[CREDUI_MAX_PASSWORD_LENGTH + 1] = L"";
         NETRESOURCEW res = { 0 };
         BOOL save = FALSE, other;
-        DWORD flags, err;
+        DWORD flags, err = 0;
+        int tries;
 
         run_dialog(&d, hwnd, owner);
         if (d.result != IDOK) break;
@@ -214,27 +215,58 @@
             continue;
         }
         other = SendMessageW(d.othercred, BM_GETCHECK, 0, 0) == BST_CHECKED;
-        if (other)
-        {
-            CREDUI_INFOW ui = { sizeof(ui), hwnd, L"Enter the user name and password to connect to this folder.",
-                                L"Map Network Drive" };
-            HMODULE credui = LoadLibraryW(L"credui.dll");
-            DWORD (WINAPI *prompt)(CREDUI_INFOW *, const WCHAR *, void *, DWORD, WCHAR *, ULONG, WCHAR *, ULONG, BOOL *, DWORD);
-
-            prompt = credui ? (void *)GetProcAddress(credui, "CredUIPromptForCredentialsW") : NULL;
-            if (!prompt || prompt(&ui, remote, NULL, 0, user, ARRAY_SIZE(user), pass, ARRAY_SIZE(pass), &save,
-                                  CREDUI_FLAGS_DO_NOT_PERSIST | CREDUI_FLAGS_GENERIC_CREDENTIALS))
-                continue;
-        }
         res.dwType = RESOURCETYPE_DISK;
         res.lpLocalName = letter;
         res.lpRemoteName = remote;
         flags = SendMessageW(d.reconnect, BM_GETCHECK, 0, 0) == BST_CHECKED ? CONNECT_UPDATE_PROFILE : 0;
-        SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_WAIT));
-        err = WNetAddConnection2W(&res, other ? pass : NULL, other ? user : NULL, flags);
-        SecureZeroMemory(pass, sizeof(pass));
-        SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_ARROW));
-        TRACE("%s -> %s: %lu\n", debugstr_w(letter), debugstr_w(remote), err);
+        /* Stained Glass OS: a share that refuses the signed-in user (or a
+         * guest) asks for a name and password, as Windows' Map Network Drive
+         * does, and asks again while they are refused -- it showed "Access
+         * denied" and nothing more. "Connect using different credentials"
+         * asks before the first try. */
+        for (tries = 0; ; tries++)
+        {
+            if (other)
+            {
+                WCHAR server[MAX_PATH], message[MAX_PATH + 64], *end;
+                CREDUI_INFOW ui = { sizeof(ui), hwnd, message, L"Map Network Drive" };
+                HMODULE credui = LoadLibraryW(L"credui.dll");
+                DWORD (WINAPI *prompt)(CREDUI_INFOW *, const WCHAR *, void *, DWORD, WCHAR *, ULONG, WCHAR *, ULONG, BOOL *, DWORD);
+                DWORD cflags = CREDUI_FLAGS_DO_NOT_PERSIST | CREDUI_FLAGS_GENERIC_CREDENTIALS |
+                               CREDUI_FLAGS_ALWAYS_SHOW_UI;
+
+                /* the server is what the name and password are for, as File
+                 * Explorer's Network folder asks (a name without a domain is
+                 * the server's account) */
+                lstrcpynW(server, remote + 2, ARRAY_SIZE(server));
+                if ((end = wcschr(server, '\\'))) *end = 0;
+                swprintf(message, ARRAY_SIZE(message), L"Enter your credentials to connect to: %s", server);
+                if (tries) cflags |= CREDUI_FLAGS_INCORRECT_PASSWORD;
+                prompt = credui ? (void *)GetProcAddress(credui, "CredUIPromptForCredentialsW") : NULL;
+                if (!prompt || prompt(&ui, server, NULL, tries ? err : 0, user, ARRAY_SIZE(user), pass, ARRAY_SIZE(pass),
+                                      &save, cflags))
+                {
+                    err = WN_CANCEL;
+                    break;
+                }
+            }
+            SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_WAIT));
+            err = WNetAddConnection2W(&res, other ? pass : NULL, other ? user : NULL, flags);
+            SecureZeroMemory(pass, sizeof(pass));
+            SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_ARROW));
+            TRACE("%s -> %s: %lu\n", debugstr_w(letter), debugstr_w(remote), err);
+#ifndef SG_MUTANT_MAP_NO_CRED_RETRY
+            if ((err == ERROR_ACCESS_DENIED || err == ERROR_LOGON_FAILURE || err == ERROR_INVALID_PASSWORD ||
+                 err == ERROR_BAD_USERNAME || err == ERROR_NOT_AUTHENTICATED) && tries < 5)
+            {
+                if (!other) tries = -1;   /* the first prompt shows no "incorrect" */
+                other = TRUE;
+                continue;
+            }
+#endif
+            break;
+        }
+        if (err == WN_CANCEL) continue;
         if (err)
         {
             error_box(hwnd, L"The folder cannot be reached.", err);
