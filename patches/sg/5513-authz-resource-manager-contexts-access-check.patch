@@ -46,9 +131,18 @@ BOOL WINAPI AuthzInitializeResourceManager(DWORD flags, PFN_AUTHZ_DYNAMIC_ACCESS
  */
 BOOL WINAPI AuthzFreeResourceManager(AUTHZ_RESOURCE_MANAGER_HANDLE handle)
 {
-    FIXME("%p\n", handle);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    struct resource_manager *rm = get_rm( handle );
+
+    TRACE("%p\n", handle);
+
+    if (!rm)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    rm->magic = 0;
+    HeapFree( GetProcessHeap(), 0, rm );
+    return TRUE;
 }
 
