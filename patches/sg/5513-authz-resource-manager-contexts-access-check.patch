@@ -61,6 +155,110 @@ BOOL WINAPI AuthzInstallSecurityEventSource(DWORD flags, AUTHZ_SOURCE_SCHEMA_REG
     return FALSE;
 }
 
+/* An ACE for the principal-self SID stands for the SID the request names; an
+ * ACE of that SID is replaced by one of the request's. Without a SID in the
+ * request it matches nobody. Only allow and deny ACEs name the SID in the
+ * place this reads; the others are copied as they are. */
+static BOOL add_ace_for_principal( ACL *acl, void *ace, PSID self )
+{
+    ACE_HEADER *header = ace;
+    BYTE ps_buffer[SECURITY_MAX_SID_SIZE];
+    DWORD len = sizeof(ps_buffer);
+
+    if (self && (header->AceType == ACCESS_ALLOWED_ACE_TYPE || header->AceType == ACCESS_DENIED_ACE_TYPE) &&
+        CreateWellKnownSid( WinSelfSid, NULL, ps_buffer, &len ))
+    {
+        ACCESS_ALLOWED_ACE *allowed = ace;
+
+        if (EqualSid( (PSID)&allowed->SidStart, ps_buffer ))
+        {
+            if (header->AceType == ACCESS_ALLOWED_ACE_TYPE)
+                return AddAccessAllowedAceEx( acl, ACL_REVISION4, header->AceFlags, allowed->Mask, self );
+            return AddAccessDeniedAceEx( acl, ACL_REVISION4, header->AceFlags, allowed->Mask, self );
+        }
+    }
+    return AddAce( acl, ACL_REVISION4, MAXDWORD, ace, header->AceSize );
+}
+
+/* The DACL a check goes by: the primary descriptor's ACEs followed by those of
+ * the optional descriptors, whose NULL DACLs count as empty ("the logical
+ * concatenation of all of the ACLs"). *sd is the descriptor to check, to be
+ * freed with HeapFree; the primary's own when nothing is concatenated. */
+static BOOL build_check_descriptor( PSECURITY_DESCRIPTOR primary, PSECURITY_DESCRIPTOR *optional, DWORD count,
+                                    PSID self, PSECURITY_DESCRIPTOR *sd )
+{
+    BOOL present, defaulted;
+    PSID owner, group;
+    ACL *dacl, *out;
+    SECURITY_DESCRIPTOR *result;
+    ACL_SIZE_INFORMATION info;
+    DWORD i, j, size = sizeof(ACL);
+    void *ace;
+
+    *sd = NULL;
+    if (!GetSecurityDescriptorOwner( primary, &owner, &defaulted ) || !owner)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!GetSecurityDescriptorDacl( primary, &present, &dacl, &defaulted ) || !present)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    GetSecurityDescriptorGroup( primary, &group, &defaulted );
+    /* the check needs a group; the owner stands in when there is none */
+    if (!group) group = owner;
+
+    if (dacl)
+    {
+        if (!GetAclInformation( dacl, &info, sizeof(info), AclSizeInformation )) return FALSE;
+        size += info.AclBytesInUse - sizeof(ACL) + info.AceCount * SECURITY_MAX_SID_SIZE;
+    }
+    for (i = 0; dacl && i < count; i++)
+    {
+        ACL *extra;
+
+        if (!optional[i] || !GetSecurityDescriptorDacl( optional[i], &present, &extra, &defaulted ))
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        if (!present || !extra) continue;
+        if (!GetAclInformation( extra, &info, sizeof(info), AclSizeInformation )) return FALSE;
+        size += info.AclBytesInUse - sizeof(ACL) + info.AceCount * SECURITY_MAX_SID_SIZE;
+    }
+
+    if (!(result = HeapAlloc( GetProcessHeap(), 0, sizeof(*result) + size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    out = (ACL *)(result + 1);
+    if (!InitializeSecurityDescriptor( result, SECURITY_DESCRIPTOR_REVISION ) || !InitializeAcl( out, size, ACL_REVISION4 ))
+        goto failed;
+    for (i = 0; dacl && i <= count; i++)
+    {
+        ACL *from = dacl;
+
+        if (i && (!optional[i - 1] || !GetSecurityDescriptorDacl( optional[i - 1], &present, &from, &defaulted )
+                  || !present || !from)) continue;
+        if (!GetAclInformation( from, &info, sizeof(info), AclSizeInformation )) goto failed;
+        for (j = 0; j < info.AceCount; j++)
+        {
+            if (!GetAce( from, j, &ace ) || !add_ace_for_principal( out, ace, self )) goto failed;
+        }
+    }
+    if (!SetSecurityDescriptorOwner( result, owner, FALSE ) || !SetSecurityDescriptorGroup( result, group, FALSE ) ||
+        !SetSecurityDescriptorDacl( result, TRUE, dacl ? out : NULL, FALSE ))
+        goto failed;
+    *sd = result;
+    return TRUE;
+
+failed:
+    HeapFree( GetProcessHeap(), 0, result );
+    return FALSE;
+}
 
 /***********************************************************************
  *              AuthzAccessCheck (AUTHZ.@)
@@ -71,11 +269,75 @@ BOOL WINAPI AuthzAccessCheck(DWORD flags, AUTHZ_CLIENT_CONTEXT_HANDLE client_con
         DWORD optional_security_count, AUTHZ_ACCESS_REPLY *reply,
         AUTHZ_ACCESS_CHECK_RESULTS_HANDLE *access_check_result)
 {
-    FIXME("(0x%lx,%p,%p,%p,%p,%p,0x%lx,%p,%p): stub\n", flags, client_context,
-            request, audit_event, security, optional_security,
-            optional_security_count, reply, access_check_result);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    struct client_context *context = get_context( client_context );
+    GENERIC_MAPPING mapping = {0};
+    PRIVILEGE_SET privileges;
+    DWORD priv_len = sizeof(privileges), granted = 0;
+    PSECURITY_DESCRIPTOR sd;
+    BOOL status = FALSE, ret;
+    DWORD error = ERROR_SUCCESS;
+
+    TRACE("(0x%lx,%p,%p,%p,%p,%p,0x%lx,%p,%p)\n", flags, client_context, request, audit_event, security,
+          optional_security, optional_security_count, reply, access_check_result);
+
+    if (!context || !request || !security || !reply || (flags & ~AUTHZ_ACCESS_CHECK_NO_DEEP_COPY_SD)
+        || (optional_security_count && !optional_security)
+        || reply->ResultListLength != 1 || !reply->GrantedAccessMask || !reply->Error)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (request->ObjectTypeListLength || request->ObjectTypeList || access_check_result)
+    {
+        /* object type lists and cached results (AuthzCachedAccessCheck) are not done */
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+
+#ifdef SG_MUTANT_AZ_NO_CONCAT
+    optional_security_count = 0;
+#endif
+    if (!build_check_descriptor( security, optional_security, optional_security_count, request->PrincipalSelfSid, &sd )) return FALSE;
+
+#ifdef SG_MUTANT_AZ_PROCESS_TOKEN
+    {
+        HANDLE process_token, imp;
+        OpenProcessToken( GetCurrentProcess(), TOKEN_ALL_ACCESS, &process_token );
+        DuplicateTokenEx( process_token, TOKEN_ALL_ACCESS, NULL, SecurityImpersonation, TokenImpersonation, &imp );
+        CloseHandle( context->token );
+        CloseHandle( process_token );
+        context->token = imp;
+    }
+#endif
+    ret = AccessCheck( sd, context->token, request->DesiredAccess, &mapping, &privileges, &priv_len, &granted, &status );
+    if (!ret)
+    {
+        error = GetLastError();
+        if (error != ERROR_ACCESS_DENIED)
+        {
+            if (sd != security) HeapFree( GetProcessHeap(), 0, sd );
+            SetLastError( error );
+            return FALSE;
+        }
+        granted = 0;
+    }
+    else if (!status)
+    {
+        granted = 0;
+        error = ERROR_ACCESS_DENIED;
+    }
+    if (sd != security) HeapFree( GetProcessHeap(), 0, sd );
+
+    /* the call worked; whether access is granted is in the reply */
+#ifdef SG_MUTANT_AZ_ALWAYS_GRANT
+    granted = request->DesiredAccess;
+    error = 0;
+#endif
+    reply->GrantedAccessMask[0] = granted;
+    reply->Error[0] = error;
+    if (reply->SaclEvaluationResults) reply->SaclEvaluationResults[0] = 0;
+    SetLastError( ERROR_SUCCESS );
+    return TRUE;
 }
 
 
@@ -84,9 +346,19 @@ BOOL WINAPI AuthzAccessCheck(DWORD flags, AUTHZ_CLIENT_CONTEXT_HANDLE client_con
  */
 BOOL WINAPI AuthzFreeContext(AUTHZ_CLIENT_CONTEXT_HANDLE client_context)
 {
-    FIXME("(%p): stub\n", client_context);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    struct client_context *context = get_context( client_context );
+
+    TRACE("(%p)\n", client_context);
+
+    if (!context)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    context->magic = 0;
+    CloseHandle( context->token );
+    HeapFree( GetProcessHeap(), 0, context );
+    return TRUE;
 }
 
 
@@ -111,8 +383,39 @@ BOOL WINAPI AuthzInitializeContextFromToken(DWORD flags, HANDLE token_handle,
         AUTHZ_RESOURCE_MANAGER_HANDLE resource_manager, LARGE_INTEGER *expire_time,
         LUID id, void *dynamic_group, AUTHZ_CLIENT_CONTEXT_HANDLE *client_context)
 {
-    FIXME("(0x%lx,%p,%p,%p,%08lx:%08lx,%p,%p): stub\n", flags, token_handle, resource_manager,
+    struct resource_manager *rm = get_rm( resource_manager );
+    struct client_context *context;
+    HANDLE token;
+
+    TRACE("(0x%lx,%p,%p,%p,%08lx:%08lx,%p,%p)\n", flags, token_handle, resource_manager,
             expire_time, id.HighPart, id.LowPart, dynamic_group, client_context);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+
+    if (!rm || !client_context)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (rm->compute_dyn_groups)
+    {
+        /* the callback adds SIDs to the client's groups, which a token cannot take */
+        FIXME("dynamic groups are not supported\n");
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (!DuplicateTokenEx( token_handle, TOKEN_QUERY | TOKEN_DUPLICATE | TOKEN_IMPERSONATE, NULL,
+                           SecurityImpersonation, TokenImpersonation, &token ))
+        return FALSE;
+    if (!(context = HeapAlloc( GetProcessHeap(), 0, sizeof(*context) )))
+    {
+        CloseHandle( token );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    context->magic = CONTEXT_MAGIC;
+    context->rm = rm;
+    context->token = token;
+    context->expire_time.QuadPart = expire_time ? expire_time->QuadPart : MAXLONGLONG;
+    context->id = id;
+    *client_context = (AUTHZ_CLIENT_CONTEXT_HANDLE)context;
+    return TRUE;
 }
