  *              AuthzInitializeResourceManager (AUTHZ.@)
  */
@@ -34,11 +90,40 @@ BOOL WINAPI AuthzInitializeResourceManager(DWORD flags, PFN_AUTHZ_DYNAMIC_ACCESS
         PFN_AUTHZ_COMPUTE_DYNAMIC_GROUPS compute_dyn_groups, PFN_AUTHZ_FREE_DYNAMIC_GROUPS free_dyn_groups,
         const WCHAR *managername, AUTHZ_RESOURCE_MANAGER_HANDLE *handle )
 {
-    FIXME("(0x%lx,%p,%p,%p,%s,%p): stub\n", flags, access_checker,
-        compute_dyn_groups, free_dyn_groups,
-        debugstr_w(managername), handle);
-    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
-    return FALSE;
+    struct resource_manager *rm;
+
+    TRACE("(0x%lx,%p,%p,%p,%s,%p)\n", flags, access_checker, compute_dyn_groups, free_dyn_groups,
+          debugstr_w(managername), handle);
+
+    if (!handle || (flags & ~(AUTHZ_RM_FLAG_NO_AUDIT | AUTHZ_RM_FLAG_INITIALIZE_UNDER_IMPERSONATION
+                              | AUTHZ_RM_FLAG_NO_CENTRAL_ACCESS_POLICIES)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* "unless the AUTHZ_RM_FLAG_NO_AUDIT flag is set, SeAuditPrivilege must be enabled for the function to succeed" */
+#ifdef SG_MUTANT_AZ_NO_PRIVILEGE
+    if (0 &&
+#else
+    if (!(flags & AUTHZ_RM_FLAG_NO_AUDIT) &&
+#endif
+        !audit_privilege_enabled( flags & AUTHZ_RM_FLAG_INITIALIZE_UNDER_IMPERSONATION ))
+    {
+        SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+        return FALSE;
+    }
+    if (!(rm = HeapAlloc( GetProcessHeap(), 0, sizeof(*rm) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    rm->magic = RM_MAGIC;
+    rm->flags = flags;
+    rm->access_checker = access_checker;
+    rm->compute_dyn_groups = compute_dyn_groups;
+    rm->free_dyn_groups = free_dyn_groups;
+    *handle = (AUTHZ_RESOURCE_MANAGER_HANDLE)rm;
+    return TRUE;
 }
 
