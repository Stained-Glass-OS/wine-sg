From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] authz: resource manager, client contexts, AuthzAccessCheck

authz.dll was a set of stubs that failed every call with
ERROR_CALL_NOT_IMPLEMENTED. A program that checks access with the Authz API
(administration tools, services with their own object model) could not.

AuthzInitializeResourceManager / AuthzFreeResourceManager make and free a
resource manager; without AUTHZ_RM_FLAG_NO_AUDIT the caller's token (the
thread's under AUTHZ_RM_FLAG_INITIALIZE_UNDER_IMPERSONATION) must have
SeAuditPrivilege enabled, as documented (ERROR_PRIVILEGE_NOT_HELD).
AuthzInitializeContextFromToken keeps an impersonation duplicate of the token
as the client; AuthzFreeContext releases it.

AuthzAccessCheck runs the access check of the context's token against the
descriptor: the reply holds the granted mask and ERROR_ACCESS_DENIED or 0 for
a one-entry result list, the call itself succeeding either way. The optional
descriptors' ACLs follow the primary's ("the logical concatenation of all of
the ACLs"; their NULL DACLs count as empty, the primary's NULL DACL stands for
the whole object); an ACE for the principal-self SID is for the SID the
request names. A descriptor without owner or DACL is ERROR_INVALID_PARAMETER.
Object type lists, cached results and dynamic groups are refused with
ERROR_NOT_SUPPORTED. The constants of the API are added to authz.h.
---
--- a/dlls/authz/Makefile.in
+++ b/dlls/authz/Makefile.in
@@ -1,4 +1,5 @@
 MODULE    = authz.dll
+IMPORTS   = advapi32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
--- a/dlls/authz/authz.c
+++ b/dlls/authz/authz.c
@@ -21,12 +21,68 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winerror.h"
+#include "winnt.h"
 #include "wine/debug.h"
 
 #include "authz.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(authz);
 
+#define RM_MAGIC      0x52485a41 /* "AZHR" */
+#define CONTEXT_MAGIC 0x43485a41 /* "AZHC" */
+
+struct resource_manager
+{
+    DWORD magic;
+    DWORD flags;
+    PFN_AUTHZ_DYNAMIC_ACCESS_CHECK access_checker;
+    PFN_AUTHZ_COMPUTE_DYNAMIC_GROUPS compute_dyn_groups;
+    PFN_AUTHZ_FREE_DYNAMIC_GROUPS free_dyn_groups;
+};
+
+/* the client: an impersonation token of its own */
+struct client_context
+{
+    DWORD magic;
+    struct resource_manager *rm;
+    HANDLE token;
+    LARGE_INTEGER expire_time;
+    LUID id;
+};
+
+static struct resource_manager *get_rm( AUTHZ_RESOURCE_MANAGER_HANDLE handle )
+{
+    struct resource_manager *rm = (struct resource_manager *)handle;
+    return rm && rm->magic == RM_MAGIC ? rm : NULL;
+}
+
+static struct client_context *get_context( AUTHZ_CLIENT_CONTEXT_HANDLE handle )
+{
+    struct client_context *context = (struct client_context *)handle;
+    return context && context->magic == CONTEXT_MAGIC ? context : NULL;
+}
+
+/* SeAuditPrivilege enabled in the token of the process, or of the thread */
+static BOOL audit_privilege_enabled( BOOL thread )
+{
+    HANDLE token = NULL, imp = NULL;
+    PRIVILEGE_SET set = {1, PRIVILEGE_SET_ALL_NECESSARY};
+    BOOL ret = FALSE, enabled = FALSE;
+
+    if (!LookupPrivilegeValueW( NULL, L"SeAuditPrivilege", &set.Privilege[0].Luid )) return FALSE;
+    set.Privilege[0].Attributes = 0;
+    if (thread && OpenThreadToken( GetCurrentThread(), TOKEN_QUERY | TOKEN_DUPLICATE, TRUE, &token )) {}
+    else if (!OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE, &token )) return FALSE;
+    if (DuplicateTokenEx( token, TOKEN_QUERY, NULL, SecurityImpersonation, TokenImpersonation, &imp ))
+    {
+        ret = PrivilegeCheck( imp, &set, &enabled ) && enabled;
+        CloseHandle( imp );
+    }
+    CloseHandle( token );
+    return ret;
+}
+
