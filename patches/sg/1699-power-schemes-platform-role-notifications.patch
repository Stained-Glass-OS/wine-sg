+/***********************************************************************
+ *		PowerSettingAccessCheck (POWRPROF.@)
+ */
+DWORD WINAPI PowerSettingAccessCheck( POWER_DATA_ACCESSOR type, const GUID *guid )
+{
+    HKEY key;
+
+    TRACE( "(%d,%s)\n", type, debugstr_guid(guid) );
+
+    switch (type)
+    {
+    case ACCESS_AC_POWER_SETTING_INDEX:
+    case ACCESS_DC_POWER_SETTING_INDEX:
+    case ACCESS_SCHEME:
+    case ACCESS_SUBGROUP:
+    case ACCESS_INDIVIDUAL_SETTING:
+    case ACCESS_ACTIVE_SCHEME:
+    case ACCESS_CREATE_SCHEME:
+        break;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
+    /* can this user change the schemes */
+    if (!(key = open_schemes( KEY_READ | KEY_WRITE ))) return ERROR_ACCESS_DENIED;
+    RegCloseKey( key );
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *		PowerSettingAccessCheckEx (POWRPROF.@)
+ */
+DWORD WINAPI PowerSettingAccessCheckEx( POWER_DATA_ACCESSOR type, const GUID *guid, REGSAM access )
+{
+    TRACE( "(%d,%s,%#lx)\n", type, debugstr_guid(guid), access );
+    if (!(access & (KEY_WRITE & ~READ_CONTROL)))
+    {
+        switch (type)
+        {
+        case ACCESS_AC_POWER_SETTING_INDEX:
+        case ACCESS_DC_POWER_SETTING_INDEX:
+        case ACCESS_SCHEME:
+        case ACCESS_SUBGROUP:
+        case ACCESS_INDIVIDUAL_SETTING:
+        case ACCESS_ACTIVE_SCHEME:
+        case ACCESS_CREATE_SCHEME:
+            return ERROR_SUCCESS;
+        default:
+            return ERROR_INVALID_PARAMETER;
+        }
+    }
+    return PowerSettingAccessCheck( type, guid );
+}
