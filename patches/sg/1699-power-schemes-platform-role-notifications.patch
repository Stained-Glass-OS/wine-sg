+/* the power scheme powrprof keeps active (Balanced unless changed), or the
+ * built-in scheme it was made from */
+static void get_active_power_scheme( GUID *scheme, BOOL personality )
+{
+    WCHAR str[64], path[128];
+    DWORD size = sizeof(str);
+    HKEY key;
+
+    *scheme = power_balanced_scheme;
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Power\\User\\PowerSchemes",
+                      L"ActivePowerScheme", RRF_RT_REG_SZ, NULL, str, &size ) || !power_guid_from_string( str, scheme ))
+        return;
+    if (!personality) return;
+    swprintf( path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\Power\\User\\PowerSchemes\\%s", str );
+    size = sizeof(str);
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key ))
+    {
+        if (!RegGetValueW( key, NULL, L"BaseScheme", RRF_RT_REG_SZ, NULL, str, &size )) power_guid_from_string( str, scheme );
+        RegCloseKey( key );
+    }
+}
