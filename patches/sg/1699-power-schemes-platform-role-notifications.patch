+DWORD WINAPI PowerWriteDCValueIndex( HKEY root, const GUID *scheme, const GUID *group, const GUID *setting, DWORD index )
+{
+    TRACE( "(%p,%s,%s,%s,%lu)\n", root, debugstr_guid(scheme), debugstr_guid(group), debugstr_guid(setting), index );
