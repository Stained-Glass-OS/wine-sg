+/* Notifications: a registration for a setting is told its current value at
+ * once, as on Windows, and again when this process changes it. Wine has no
+ * source of suspend and resume events, so a suspend and resume
+ * registration is kept but never called. */
+#ifndef PBT_POWERSETTINGCHANGE
+#define PBT_POWERSETTINGCHANGE 0x8013
+#endif
+#ifndef DEVICE_NOTIFY_CALLBACK
+#define DEVICE_NOTIFY_CALLBACK 2
+#endif
+
+typedef ULONG (CALLBACK *notify_callback)( void *context, ULONG type, void *setting );
+
+struct subscribe_params
+{
+    notify_callback callback;
+    void *context;
+};
+
+#define NOTIFY_MAGIC 0x504f4e54 /* "PONT" */
+
+struct power_notify
+{
+    struct list entry;
+    DWORD magic;
+    BOOL suspend_resume;
+    DWORD flags;
+    HANDLE recipient;
+    struct subscribe_params params;
+    GUID setting;
+};
+
+static CRITICAL_SECTION notify_cs;
+static CRITICAL_SECTION_DEBUG notify_cs_debug =
+{
+    0, 0, &notify_cs,
+    { &notify_cs_debug.ProcessLocksList, &notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": notify_cs") }
+};
+static CRITICAL_SECTION notify_cs = { &notify_cs_debug, -1, 0, 0, 0, 0 };
+static struct list notifies = LIST_INIT( notifies );
+
+struct setting_value
+{
+    GUID guid;
+    DWORD length;
+    union { DWORD value; GUID guid; } data;
+};
+
+static BOOL on_battery(void)
+{
+    SYSTEM_POWER_STATUS status;
+    return GetSystemPowerStatus( &status ) && status.ACLineStatus == 0;
+}
+
+static BOOL setting_value( const GUID *guid, struct setting_value *value )
+{
+    SYSTEM_POWER_STATUS status;
+    const struct setting_def *def;
+    GUID active;
+    int base;
+
+    value->guid = *guid;
+    value->length = sizeof(DWORD);
+    value->data.value = 0;
+    get_active_scheme( &active );
+    if (IsEqualGUID( guid, &note_active ))
+    {
+        value->length = sizeof(GUID);
+        value->data.guid = active;
+    }
+    else if (IsEqualGUID( guid, &note_personality ))
+    {
+        value->length = sizeof(GUID);
+        find_scheme( &active, &base );
+        value->data.guid = *schemes[base].guid;
+    }
+    else if (IsEqualGUID( guid, &note_acdc )) value->data.value = on_battery() ? 1 : 0;
+    else if (IsEqualGUID( guid, &note_battery ))
+    {
+        if (!GetSystemPowerStatus( &status ) || status.BatteryLifePercent > 100) return FALSE;
+        value->data.value = status.BatteryLifePercent;
+    }
+    else if (IsEqualGUID( guid, &note_monitor ) || IsEqualGUID( guid, &note_console )
+            || IsEqualGUID( guid, &note_session ) || IsEqualGUID( guid, &note_lid_state ))
+        value->data.value = 1;
+    else if (IsEqualGUID( guid, &note_away ) || IsEqualGUID( guid, &note_presence ))
+        value->data.value = 0;
+    else if ((def = find_setting( NULL, guid )))
+        read_index( &active, def->group, def->guid, on_battery(), &value->data.value );
+    else return FALSE;
+    return TRUE;
+}
+
+static void deliver( const struct power_notify *notify, struct setting_value *value )
+{
+    DWORD pid;
+
+    if (notify->flags == DEVICE_NOTIFY_CALLBACK)
+        notify->params.callback( notify->params.context, PBT_POWERSETTINGCHANGE, value );
+    else if (GetWindowThreadProcessId( notify->recipient, &pid ))
+        SendMessageTimeoutW( notify->recipient, WM_POWERBROADCAST, PBT_POWERSETTINGCHANGE, (LPARAM)value,
+                             SMTO_NORMAL, 10000, NULL );
+}
+
+static void CALLBACK send_current( TP_CALLBACK_INSTANCE *instance, void *arg )
+{
+    struct power_notify *copy = arg;
+    struct setting_value value;
+
+    if (setting_value( &copy->setting, &value )) deliver( copy, &value );
+    free( copy );
+}
+
+static void notify_setting_changed( const GUID *setting )
+{
+    struct power_notify *notify, *copy;
+    struct list copies = LIST_INIT( copies );
+    struct setting_value value;
+
+    if (!setting_value( setting, &value )) return;
+    EnterCriticalSection( &notify_cs );
+    LIST_FOR_EACH_ENTRY( notify, &notifies, struct power_notify, entry )
+    {
+        if (notify->suspend_resume || !IsEqualGUID( &notify->setting, setting )) continue;
+        if (!(copy = malloc( sizeof(*copy) ))) break;
+        *copy = *notify;
+        list_add_tail( &copies, &copy->entry );
+    }
+    LeaveCriticalSection( &notify_cs );
+
+    while (!list_empty( &copies ))
+    {
+        copy = LIST_ENTRY( list_head( &copies ), struct power_notify, entry );
+        list_remove( &copy->entry );
+        deliver( copy, &value );
+        free( copy );
+    }
+}
+
+static DWORD register_notify( const GUID *setting, DWORD flags, HANDLE recipient, HPOWERNOTIFY *handle,
+                              BOOL suspend_resume )
+{
+    struct power_notify *notify, *copy;
+
+    if (!handle || !recipient) return ERROR_INVALID_PARAMETER;
+    if (flags != DEVICE_NOTIFY_CALLBACK && flags != DEVICE_NOTIFY_WINDOW_HANDLE) return ERROR_INVALID_PARAMETER;
+    if (flags == DEVICE_NOTIFY_CALLBACK && !((struct subscribe_params *)recipient)->callback) return ERROR_INVALID_PARAMETER;
+    if (flags == DEVICE_NOTIFY_WINDOW_HANDLE && !IsWindow( recipient )) return ERROR_INVALID_PARAMETER;
+    if (!(notify = calloc( 1, sizeof(*notify) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    notify->magic = NOTIFY_MAGIC;
+    notify->suspend_resume = suspend_resume;
+    notify->flags = flags;
+    notify->recipient = recipient;
+    if (flags == DEVICE_NOTIFY_CALLBACK) notify->params = *(struct subscribe_params *)recipient;
+    if (setting) notify->setting = *setting;
+
+    EnterCriticalSection( &notify_cs );
+    list_add_tail( &notifies, &notify->entry );
+    LeaveCriticalSection( &notify_cs );
+
+#ifndef SG_MUTANT_NO_INITIAL_VALUE
+    if (!suspend_resume && (copy = malloc( sizeof(*copy) )))
+    {
+        *copy = *notify;
+        if (!TrySubmitThreadpoolCallback( send_current, copy, NULL )) free( copy );
+    }
+#else
+    (void)copy;
+#endif
+    *handle = notify;
+    return ERROR_SUCCESS;
+}
+
+static DWORD unregister_notify( HPOWERNOTIFY handle, BOOL suspend_resume )
+{
+    struct power_notify *notify, *iter;
+    BOOL found = FALSE;
+
+    EnterCriticalSection( &notify_cs );
+    LIST_FOR_EACH_ENTRY( iter, &notifies, struct power_notify, entry )
+    {
+        if (iter != handle || iter->suspend_resume != suspend_resume) continue;
+        found = TRUE;
+        break;
+    }
+    if (found)
+    {
+        notify = handle;
+        list_remove( &notify->entry );
+        notify->magic = 0;
+        free( notify );
+    }
+    LeaveCriticalSection( &notify_cs );
+    return found ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+}
+
+/***********************************************************************
+ *		PowerSettingRegisterNotification (POWRPROF.@)
+ */
+DWORD WINAPI PowerSettingRegisterNotification( const GUID *setting, DWORD flags, HANDLE recipient, HPOWERNOTIFY *handle )
+{
+    TRACE( "(%s,%#lx,%p,%p)\n", debugstr_guid(setting), flags, recipient, handle );
+    if (!setting) return ERROR_INVALID_PARAMETER;
+    return register_notify( setting, flags, recipient, handle, FALSE );
+}
+
+/***********************************************************************
+ *		PowerSettingUnregisterNotification (POWRPROF.@)
+ */
+DWORD WINAPI PowerSettingUnregisterNotification( HPOWERNOTIFY handle )
+{
+    TRACE( "(%p)\n", handle );
+    return unregister_notify( handle, FALSE );
+}
+
+/***********************************************************************
+ *		PowerRegisterSuspendResumeNotification (POWRPROF.@)
+ */
+DWORD WINAPI PowerRegisterSuspendResumeNotification( DWORD flags, HANDLE recipient, HPOWERNOTIFY *handle )
+{
+    TRACE( "(%#lx,%p,%p)\n", flags, recipient, handle );
+    return register_notify( NULL, flags, recipient, handle, TRUE );
+}
+
+/***********************************************************************
+ *		PowerUnregisterSuspendResumeNotification (POWRPROF.@)
+ */
+DWORD WINAPI PowerUnregisterSuspendResumeNotification( HPOWERNOTIFY handle )
+{
+    TRACE( "(%p)\n", handle );
+    return unregister_notify( handle, TRUE );
+}
