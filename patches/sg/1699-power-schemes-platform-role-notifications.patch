+static void guid_to_string( const GUID *guid, WCHAR *str )
+{
+    swprintf( str, 39, L"{%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}", guid->Data1, guid->Data2,
+              guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4],
+              guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+}
+
+static BOOL string_to_guid( const WCHAR *str, GUID *guid )
+{
+    WCHAR buf[37];
+
+    if (wcslen( str ) != 38 || str[0] != '{' || str[37] != '}') return FALSE;
+    memcpy( buf, str + 1, 36 * sizeof(WCHAR) );
+    buf[36] = 0;
+    return !UuidFromStringW( buf, guid );
+}
+
+static HKEY open_schemes( REGSAM access )
+{
+    HKEY key;
+
+    if (access & KEY_WRITE)
+    {
+        if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, SCHEMES_KEY, 0, NULL, 0, access, NULL, &key, NULL )) return NULL;
+    }
+    else if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, SCHEMES_KEY, 0, access, &key )) return NULL;
+    return key;
+}
+
+static HKEY open_scheme_key( const GUID *scheme, REGSAM access, BOOL create )
+{
+    WCHAR name[39];
+    HKEY schemes_key, key = NULL;
+
+    if (!(schemes_key = open_schemes( create ? access | KEY_WRITE : access ))) return NULL;
+    guid_to_string( scheme, name );
+    if (create) RegCreateKeyExW( schemes_key, name, 0, NULL, 0, access, NULL, &key, NULL );
+    else if (RegOpenKeyExW( schemes_key, name, 0, access, &key )) key = NULL;
+    RegCloseKey( schemes_key );
+    return key;
+}
+
+static int builtin_index( const GUID *scheme )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(schemes); i++) if (IsEqualGUID( scheme, schemes[i].guid )) return i;
+    return -1;
+}
+
+static DWORD get_dword( HKEY key, const WCHAR *name, DWORD *value )
+{
+    DWORD size = sizeof(*value), type;
+    LSTATUS ls = RegQueryValueExW( key, name, NULL, &type, (BYTE *)value, &size );
+    if (!ls && type != REG_DWORD) ls = ERROR_INVALID_DATA;
+    return ls;
+}
+
+/* whether a scheme exists, and the built-in scheme it is or was made from */
+static BOOL find_scheme( const GUID *scheme, int *base )
+{
+    WCHAR str[64];
+    DWORD size = sizeof(str), type, deleted = 0;
+    HKEY key;
+    GUID guid;
+    int index = builtin_index( scheme );
+
+    if ((key = open_scheme_key( scheme, KEY_READ, FALSE )))
+    {
+        get_dword( key, L"Deleted", &deleted );
+        if (index < 0 && !RegQueryValueExW( key, L"BaseScheme", NULL, &type, (BYTE *)str, &size )
+                && type == REG_SZ && string_to_guid( str, &guid ))
+            index = builtin_index( &guid );
+        if (index < 0) index = 0;
+        RegCloseKey( key );
+        if (deleted) return FALSE;
+    }
+    else if (index < 0) return FALSE;
+    if (base) *base = index;
+    return TRUE;
+}
+
+static const struct setting_def *find_setting( const GUID *group, const GUID *setting )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(settings); i++)
+        if (IsEqualGUID( settings[i].guid, setting ) && (!group || IsEqualGUID( settings[i].group, group )))
+            return &settings[i];
+    return NULL;
+}
+
+static const struct group_def *find_group( const GUID *group )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(groups); i++) if (IsEqualGUID( groups[i].guid, group )) return &groups[i];
+    return NULL;
+}
+
+static BOOL get_active_scheme( GUID *scheme )
+{
+    WCHAR str[64];
+    DWORD size = sizeof(str), type;
+    HKEY key;
+    BOOL ret = FALSE;
+
+    if ((key = open_schemes( KEY_READ )))
+    {
+        if (!RegQueryValueExW( key, L"ActivePowerScheme", NULL, &type, (BYTE *)str, &size ) && type == REG_SZ
+                && string_to_guid( str, scheme ) && find_scheme( scheme, NULL ))
+            ret = TRUE;
+        RegCloseKey( key );
+    }
+    if (!ret) *scheme = scheme_balanced;
+    return TRUE;
+}
+
+/* a setting's index in a scheme, as set or by default */
+static DWORD read_index( const GUID *scheme, const GUID *group, const GUID *setting, BOOL dc, DWORD *value )
+{
+    const struct setting_def *def;
+    WCHAR path[80];
+    HKEY key, sub;
+    int base;
+
+    if (!scheme || !setting) return ERROR_INVALID_PARAMETER;
+    if (!find_scheme( scheme, &base )) return ERROR_FILE_NOT_FOUND;
+    if (!(def = find_setting( group, setting ))) return ERROR_FILE_NOT_FOUND;
+
+    *value = def->defaults[base][dc];
+    if ((key = open_scheme_key( scheme, KEY_READ, FALSE )))
+    {
+        guid_to_string( def->group, path );
+        path[38] = '\\';
+        guid_to_string( def->guid, path + 39 );
+        if (!RegOpenKeyExW( key, path, 0, KEY_READ, &sub ))
+        {
+            get_dword( sub, dc ? L"DCSettingIndex" : L"ACSettingIndex", value );
+            RegCloseKey( sub );
+        }
+        RegCloseKey( key );
+    }
+    return ERROR_SUCCESS;
+}
+
+static DWORD check_index( const struct setting_def *def, DWORD value )
+{
+    if (def->kind == KIND_PERCENT && value > 100) return ERROR_INVALID_PARAMETER;
+    if (def->kind == KIND_ACTION && value >= ARRAY_SIZE(actions)) return ERROR_INVALID_PARAMETER;
+    return ERROR_SUCCESS;
+}
+
+static void notify_setting_changed( const GUID *setting );
+
+static DWORD write_index( const GUID *scheme, const GUID *group, const GUID *setting, BOOL dc, DWORD value )
+{
+    const struct setting_def *def;
+    WCHAR path[80];
+    HKEY key, sub;
+    DWORD ret;
+    GUID active;
+
+    if (!scheme || !setting) return ERROR_INVALID_PARAMETER;
+    if (!find_scheme( scheme, NULL )) return ERROR_FILE_NOT_FOUND;
+    if (!(def = find_setting( group, setting ))) return ERROR_FILE_NOT_FOUND;
+    if ((ret = check_index( def, value ))) return ret;
+    if (!(key = open_scheme_key( scheme, KEY_READ | KEY_WRITE, TRUE ))) return ERROR_ACCESS_DENIED;
+    guid_to_string( def->group, path );
+    path[38] = '\\';
+    guid_to_string( def->guid, path + 39 );
+    if (!(ret = RegCreateKeyExW( key, path, 0, NULL, 0, KEY_WRITE, NULL, &sub, NULL )))
+    {
+        ret = RegSetValueExW( sub, dc ? L"DCSettingIndex" : L"ACSettingIndex", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        RegCloseKey( sub );
+    }
+    RegCloseKey( key );
+    if (!ret && get_active_scheme( &active ) && IsEqualGUID( &active, scheme )) notify_setting_changed( def->guid );
+    return ret;
+}
+
+static DWORD return_data( const void *data, DWORD size, ULONG *type, ULONG reg_type, UCHAR *buffer, DWORD *buffer_size )
+{
+    if (type) *type = reg_type;
+    if (!buffer_size) return ERROR_INVALID_PARAMETER;
+    if (!buffer)
+    {
+        *buffer_size = size;
+        return ERROR_SUCCESS;
+    }
+    if (*buffer_size < size)
+    {
+        *buffer_size = size;
+        return ERROR_MORE_DATA;
+    }
+    memcpy( buffer, data, size );
+    *buffer_size = size;
+    return ERROR_SUCCESS;
+}
+
+static DWORD return_string( const WCHAR *str, UCHAR *buffer, DWORD *size )
+{
+    return return_data( str, (wcslen( str ) + 1) * sizeof(WCHAR), NULL, REG_SZ, buffer, size );
+}
+
+/***********************************************************************
+ *		PowerGetActiveScheme (POWRPROF.@)
+ */
+DWORD WINAPI PowerGetActiveScheme( HKEY root, GUID **scheme )
+{
+    TRACE( "(%p,%p)\n", root, scheme );
+
+    if (!scheme) return ERROR_INVALID_PARAMETER;
+    if (!(*scheme = LocalAlloc( 0, sizeof(GUID) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    get_active_scheme( *scheme );
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *		PowerSetActiveScheme (POWRPROF.@)
+ */
+DWORD WINAPI PowerSetActiveScheme( HKEY root, const GUID *scheme )
+{
+    WCHAR str[39];
+    HKEY key;
+    DWORD ret;
+    GUID active;
+
+    TRACE( "(%p,%s)\n", root, debugstr_guid(scheme) );
+
+    if (!scheme) return ERROR_INVALID_PARAMETER;
+    if (!find_scheme( scheme, NULL )) return ERROR_FILE_NOT_FOUND;
+    get_active_scheme( &active );
+    if (!(key = open_schemes( KEY_READ | KEY_WRITE ))) return ERROR_ACCESS_DENIED;
+    guid_to_string( scheme, str );
+#ifdef SG_MUTANT_ACTIVE_NOT_KEPT
+    ret = ERROR_SUCCESS;
+#else
+    ret = RegSetValueExW( key, L"ActivePowerScheme", 0, REG_SZ, (BYTE *)str, sizeof(str) );
+#endif
+    RegCloseKey( key );
+    if (!ret && !IsEqualGUID( &active, scheme ))
+    {
+        unsigned int i;
+        notify_setting_changed( &note_active );
+        notify_setting_changed( &note_personality );
+        for (i = 0; i < ARRAY_SIZE(settings); i++) notify_setting_changed( settings[i].guid );
+    }
+    return ret;
+}
