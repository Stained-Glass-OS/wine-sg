+    const struct setting_def *def;
+    int base;
+
+    TRACE( "(%p,%s,%s,%s,%p)\n", root, debugstr_guid(scheme), debugstr_guid(group), debugstr_guid(setting), index );
+    if (!scheme || !setting || !index) return ERROR_INVALID_PARAMETER;
