+    return ERROR_SUCCESS;
+}
+
+/* a scheme's name or description, kept when written */
+static DWORD read_scheme_text( const GUID *scheme, const WCHAR *value, UCHAR *buffer, DWORD *size )
+{
+    WCHAR text[256];
+    DWORD len = sizeof(text) - sizeof(WCHAR), type;
+    HKEY key;
+    int base;
+
+    if (!find_scheme( scheme, &base )) return ERROR_FILE_NOT_FOUND;
+    if ((key = open_scheme_key( scheme, KEY_READ, FALSE )))
+    {
+        LSTATUS ls = RegQueryValueExW( key, value, NULL, &type, (BYTE *)text, &len );
+        RegCloseKey( key );
+        if (!ls && type == REG_SZ)
+        {
+            text[len / sizeof(WCHAR)] = 0;
+            return return_string( text, buffer, size );
+        }
+    }
+    return return_string( !wcscmp( value, L"FriendlyName" ) ? schemes[base].name : schemes[base].description, buffer, size );
+}
+
+static DWORD read_text( const GUID *scheme, const GUID *group, const GUID *setting, BOOL description,
+                        UCHAR *buffer, DWORD *size )
+{
+    const struct setting_def *def;
+    const struct group_def *grp;
+
+    if (!size) return ERROR_INVALID_PARAMETER;
+    if (setting)
+    {
+        if (!(def = find_setting( group, setting ))) return ERROR_FILE_NOT_FOUND;
+        return return_string( description ? def->description : def->name, buffer, size );
+    }
+    if (group)
+    {
+        if (!(grp = find_group( group ))) return ERROR_FILE_NOT_FOUND;
+        return return_string( description ? grp->description : grp->name, buffer, size );
+    }
+    if (scheme) return read_scheme_text( scheme, description ? L"Description" : L"FriendlyName", buffer, size );
+    return ERROR_INVALID_PARAMETER;
+}
+
+/***********************************************************************
+ *		PowerReadFriendlyName (POWRPROF.@)
+ */
+DWORD WINAPI PowerReadFriendlyName( HKEY root, const GUID *scheme, const GUID *group, const GUID *setting,
+                                    UCHAR *buffer, DWORD *size )
+{
+    TRACE( "(%p,%s,%s,%s,%p,%p)\n", root, debugstr_guid(scheme), debugstr_guid(group), debugstr_guid(setting), buffer, size );
+    return read_text( scheme, group, setting, FALSE, buffer, size );
+}
+
+/***********************************************************************
+ *		PowerReadDescription (POWRPROF.@)
+ */
+DWORD WINAPI PowerReadDescription( HKEY root, const GUID *scheme, const GUID *group, const GUID *setting,
+                                   UCHAR *buffer, DWORD *size )
+{
+    TRACE( "(%p,%s,%s,%s,%p,%p)\n", root, debugstr_guid(scheme), debugstr_guid(group), debugstr_guid(setting), buffer, size );
+    return read_text( scheme, group, setting, TRUE, buffer, size );
+}
+
+static DWORD write_scheme_text( const GUID *scheme, const GUID *group, const GUID *setting, const WCHAR *value,
+                                const UCHAR *buffer, DWORD size )
+{
+    HKEY key;
+    DWORD ret;
+
+    if (!scheme || !buffer) return ERROR_INVALID_PARAMETER;
+    /* the names of subgroups and settings are the system's */
+    if (group || setting) return ERROR_ACCESS_DENIED;
+    if (!find_scheme( scheme, NULL )) return ERROR_FILE_NOT_FOUND;
+    if (!(key = open_scheme_key( scheme, KEY_READ | KEY_WRITE, TRUE ))) return ERROR_ACCESS_DENIED;
+    ret = RegSetValueExW( key, value, 0, REG_SZ, buffer, size );
+    RegCloseKey( key );
+    return ret;
+}
+
+/***********************************************************************
+ *		PowerWriteFriendlyName (POWRPROF.@)
+ */
+DWORD WINAPI PowerWriteFriendlyName( HKEY root, const GUID *scheme, const GUID *group, const GUID *setting,
+                                     UCHAR *buffer, DWORD size )
+{
+    TRACE( "(%p,%s,%s,%s,%p,%lu)\n", root, debugstr_guid(scheme), debugstr_guid(group), debugstr_guid(setting), buffer, size );
+    return write_scheme_text( scheme, group, setting, L"FriendlyName", buffer, size );
+}
+
+/***********************************************************************
+ *		PowerWriteDescription (POWRPROF.@)
+ */
+DWORD WINAPI PowerWriteDescription( HKEY root, const GUID *scheme, const GUID *group, const GUID *setting,
+                                    UCHAR *buffer, DWORD size )
+{
+    TRACE( "(%p,%s,%s,%s,%p,%lu)\n", root, debugstr_guid(scheme), debugstr_guid(group), debugstr_guid(setting), buffer, size );
+    return write_scheme_text( scheme, group, setting, L"Description", buffer, size );
+}
+
+/* the schemes, built in first, then those made */
+static BOOL enum_scheme( ULONG index, GUID *scheme )
+{
+    WCHAR name[64];
+    DWORD len, i;
+    ULONG n = 0;
+    HKEY key;
+    GUID guid;
+
+    for (i = 0; i < ARRAY_SIZE(schemes); i++)
+    {
+        if (!find_scheme( schemes[i].guid, NULL )) continue;
+        if (n++ == index)
+        {
+            *scheme = *schemes[i].guid;
+            return TRUE;
+        }
+    }
+    if (!(key = open_schemes( KEY_READ ))) return FALSE;
+    for (i = 0; ; i++)
+    {
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+        if (!string_to_guid( name, &guid ) || builtin_index( &guid ) >= 0 || !find_scheme( &guid, NULL )) continue;
+        if (n++ == index)
+        {
+            *scheme = guid;
+            RegCloseKey( key );
+            return TRUE;
+        }
+    }
+    RegCloseKey( key );
+    return FALSE;
+}
+
+/***********************************************************************
+ *		PowerEnumerate (POWRPROF.@)
+ */
+DWORD WINAPI PowerEnumerate( HKEY root, const GUID *scheme, const GUID *group, POWER_DATA_ACCESSOR flags,
+                             ULONG index, UCHAR *buffer, DWORD *size )
+{
+    GUID guid;
+    ULONG n = 0;
+    unsigned int i;
+
+    TRACE( "(%p,%s,%s,%d,%lu,%p,%p)\n", root, debugstr_guid(scheme), debugstr_guid(group), flags, index, buffer, size );
+
+    if (!size) return ERROR_INVALID_PARAMETER;
+    switch (flags)
+    {
+    case ACCESS_SCHEME:
+        if (!enum_scheme( index, &guid )) return ERROR_NO_MORE_ITEMS;
+        break;
+    case ACCESS_SUBGROUP:
+        if (!scheme) return ERROR_INVALID_PARAMETER;
+        if (!find_scheme( scheme, NULL )) return ERROR_FILE_NOT_FOUND;
+        if (index >= ARRAY_SIZE(groups)) return ERROR_NO_MORE_ITEMS;
+        guid = *groups[index].guid;
+        break;
+    case ACCESS_INDIVIDUAL_SETTING:
+        if (!scheme || !group) return ERROR_INVALID_PARAMETER;
+        if (!find_scheme( scheme, NULL )) return ERROR_FILE_NOT_FOUND;
+        for (i = 0; i < ARRAY_SIZE(settings); i++)
+        {
+            if (!IsEqualGUID( settings[i].group, group )) continue;
+            if (n++ == index) break;
+        }
+        if (i == ARRAY_SIZE(settings)) return ERROR_NO_MORE_ITEMS;
+        guid = *settings[i].guid;
+        break;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
+    return return_data( &guid, sizeof(guid), NULL, REG_BINARY, buffer, size );
+}
+
+/***********************************************************************
+ *		PowerDuplicateScheme (POWRPROF.@)
+ */
+DWORD WINAPI PowerDuplicateScheme( HKEY root, const GUID *source, GUID **dest )
+{
+    WCHAR str[39], name[256];
+    HKEY src_key, key;
+    DWORD ret, len = sizeof(name);
+    GUID guid;
+    int base;
+
+    TRACE( "(%p,%s,%p)\n", root, debugstr_guid(source), dest );
+
+    if (!source || !dest) return ERROR_INVALID_PARAMETER;
+    if (!find_scheme( source, &base )) return ERROR_FILE_NOT_FOUND;
+    if (*dest) guid = **dest;
+    else UuidCreate( &guid );
+    if (find_scheme( &guid, NULL )) return ERROR_ALREADY_EXISTS;
+
+    if (!(key = open_scheme_key( &guid, KEY_ALL_ACCESS, TRUE ))) return ERROR_ACCESS_DENIED;
+    RegDeleteValueW( key, L"Deleted" );
+    if ((src_key = open_scheme_key( source, KEY_READ, FALSE )))
+    {
+        RegCopyTreeW( src_key, NULL, key );
+        RegCloseKey( src_key );
+    }
+    RegDeleteValueW( key, L"Deleted" );
+    guid_to_string( schemes[base].guid, str );
+    ret = RegSetValueExW( key, L"BaseScheme", 0, REG_SZ, (BYTE *)str, sizeof(str) );
+    if (!ret && read_scheme_text( source, L"FriendlyName", (UCHAR *)name, &len ) == ERROR_SUCCESS)
+        RegSetValueExW( key, L"FriendlyName", 0, REG_SZ, (BYTE *)name, len );
+    RegCloseKey( key );
+    if (ret) return ret;
+
+    if (!*dest)
+    {
+        if (!(*dest = LocalAlloc( 0, sizeof(GUID) ))) return ERROR_NOT_ENOUGH_MEMORY;
+        **dest = guid;
+    }
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *		PowerDeleteScheme (POWRPROF.@)
+ */
+DWORD WINAPI PowerDeleteScheme( HKEY root, const GUID *scheme )
+{
+    WCHAR str[39];
+    HKEY key;
+    DWORD one = 1, ret;
+    GUID active;
+
+    TRACE( "(%p,%s)\n", root, debugstr_guid(scheme) );
+
+    if (!scheme) return ERROR_INVALID_PARAMETER;
+    if (!find_scheme( scheme, NULL )) return ERROR_FILE_NOT_FOUND;
+    get_active_scheme( &active );
+    if (IsEqualGUID( &active, scheme )) return ERROR_ACCESS_DENIED;
+    if (builtin_index( scheme ) >= 0)
+    {
+        /* gone until the defaults are restored */
+        if (!(key = open_scheme_key( scheme, KEY_ALL_ACCESS, TRUE ))) return ERROR_ACCESS_DENIED;
+        ret = RegSetValueExW( key, L"Deleted", 0, REG_DWORD, (BYTE *)&one, sizeof(one) );
+        RegCloseKey( key );
+        return ret;
+    }
+    if (!(key = open_schemes( KEY_ALL_ACCESS ))) return ERROR_ACCESS_DENIED;
+    guid_to_string( scheme, str );
+    ret = RegDeleteTreeW( key, str );
+    RegCloseKey( key );
+    return ret;
+}
+
+/***********************************************************************
+ *		PowerRestoreDefaultPowerSchemes (POWRPROF.@)
+ */
+DWORD WINAPI PowerRestoreDefaultPowerSchemes(void)
+{
+    LSTATUS ls;
+    GUID active;
+
+    TRACE( "()\n" );
+
+    get_active_scheme( &active );
+    ls = RegDeleteTreeW( HKEY_LOCAL_MACHINE, SCHEMES_KEY );
+    if (ls && ls != ERROR_FILE_NOT_FOUND) return ls;
+    if (!IsEqualGUID( &active, &scheme_balanced ))
+    {
+        unsigned int i;
+        notify_setting_changed( &note_active );
+        notify_setting_changed( &note_personality );
+        for (i = 0; i < ARRAY_SIZE(settings); i++) notify_setting_changed( settings[i].guid );
+    }
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *		PowerRestoreIndividualDefaultPowerScheme (POWRPROF.@)
+ */
+DWORD WINAPI PowerRestoreIndividualDefaultPowerScheme( const GUID *scheme )
+{
+    WCHAR str[39];
+    HKEY key;
+    LSTATUS ls;
+
+    TRACE( "(%s)\n", debugstr_guid(scheme) );
+
+    if (!scheme) return ERROR_INVALID_PARAMETER;
+    if (builtin_index( scheme ) < 0) return ERROR_FILE_NOT_FOUND;
+    if (!(key = open_schemes( KEY_ALL_ACCESS ))) return ERROR_SUCCESS;
+    guid_to_string( scheme, str );
+    ls = RegDeleteTreeW( key, str );
+    RegCloseKey( key );
+    return ls == ERROR_FILE_NOT_FOUND ? ERROR_SUCCESS : ls;
+}
+
+/***********************************************************************
+ *		PowerCanRestoreIndividualDefaultPowerScheme (POWRPROF.@)
+ */
+DWORD WINAPI PowerCanRestoreIndividualDefaultPowerScheme( const GUID *scheme )
+{
+    TRACE( "(%s)\n", debugstr_guid(scheme) );
+    if (!scheme) return ERROR_INVALID_PARAMETER;
+    return builtin_index( scheme ) >= 0 ? ERROR_SUCCESS : ERROR_FILE_NOT_FOUND;
+}
+
+static DWORD read_range( const GUID *group, const GUID *setting, int what, DWORD *value )
+{
+    const struct setting_def *def;
+
+    if (!setting || !value) return ERROR_INVALID_PARAMETER;
+    if (!(def = find_setting( group, setting ))) return ERROR_FILE_NOT_FOUND;
+    /* the actions are a list of possible values, not a range */
+    if (def->kind == KIND_ACTION) return ERROR_INVALID_PARAMETER;
+    switch (what)
+    {
+    case 0: *value = 0; break;
+    case 1: *value = def->kind == KIND_PERCENT ? 100 : 0xffffffff; break;
+    default: *value = 1; break;
+    }
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *		PowerReadValueMin (POWRPROF.@)
+ */
+DWORD WINAPI PowerReadValueMin( HKEY root, const GUID *group, const GUID *setting, DWORD *value )
+{
+    TRACE( "(%p,%s,%s,%p)\n", root, debugstr_guid(group), debugstr_guid(setting), value );
+    return read_range( group, setting, 0, value );
+}
+
+/***********************************************************************
+ *		PowerReadValueMax (POWRPROF.@)
+ */
+DWORD WINAPI PowerReadValueMax( HKEY root, const GUID *group, const GUID *setting, DWORD *value )
