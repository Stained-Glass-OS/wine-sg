+
+static DWORD read_value( const GUID *scheme, const GUID *group, const GUID *setting, BOOL dc,
+                         ULONG *type, UCHAR *buffer, DWORD *size )
+{
+    DWORD value, ret;
+    GUID active;
+
+    if (!scheme)
+    {
+        get_active_scheme( &active );
+        scheme = &active;
+    }
+    if ((ret = read_index( scheme, group, setting, dc, &value ))) return ret;
+    return return_data( &value, sizeof(value), type, REG_DWORD, buffer, size );
+}
