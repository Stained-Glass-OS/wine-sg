+/***********************************************************************
+ *		PowerDeterminePlatformRoleEx (POWRPROF.@)
+ *
+ * From the SMBIOS system enclosure's chassis type; a chassis that does not
+ * say, with a battery, is a mobile one.
+ */
+POWER_PLATFORM_ROLE WINAPI PowerDeterminePlatformRoleEx( ULONG version )
+{
+    POWER_PLATFORM_ROLE role = PlatformRoleUnspecified;
+    SYSTEM_POWER_STATUS status;
+    BYTE *table, *ptr, *end;
+    UINT size;
+
+    TRACE( "(%lu)\n", version );
+
+#ifndef SG_MUTANT_ROLE_ANY_VERSION
+    if (version != POWER_PLATFORM_ROLE_V1 && version != POWER_PLATFORM_ROLE_V2) return PlatformRoleUnspecified;
+#endif
+
+    if ((size = GetSystemFirmwareTable( 0x52534d42 /* RSMB */, 0, NULL, 0 )) && (table = malloc( size )))
+    {
+        if (GetSystemFirmwareTable( 0x52534d42 /* RSMB */, 0, table, size ) == size && size > 8)
+        {
+            /* RawSMBIOSData: 8 bytes, then the structures */
+            ptr = table + 8;
+            end = table + size;
+            while (ptr + 4 <= end && ptr[0] != 127)
+            {
+                BYTE *next = ptr + ptr[1];
+
+                if (ptr[0] == 3 && ptr[1] > 5)
+                {
+                    switch (ptr[5] & 0x7f)
+                    {
+                    case 0x03: case 0x04: case 0x05: case 0x06: case 0x07: case 0x0d: case 0x0f: case 0x10:
+                    case 0x22: case 0x23: case 0x24:
+                        role = PlatformRoleDesktop; break;
+                    case 0x08: case 0x09: case 0x0a: case 0x0e: case 0x0b: case 0x1f: case 0x20:
+                        role = PlatformRoleMobile; break;
+                    case 0x1e:
+                        role = PlatformRoleSlate; break;
+                    case 0x11: case 0x17: case 0x1c: case 0x1d:
+                        role = PlatformRoleEnterpriseServer; break;
+                    case 0x18:
+                        role = PlatformRoleSOHOServer; break;
+                    case 0x21:
+                        role = PlatformRoleAppliancePC; break;
+                    case 0x1a: case 0x1b: case 0x19:
+                        role = PlatformRolePerformanceServer; break;
+                    default: break;
+                    }
+                    break;
+                }
+                /* the strings after the formatted part end with two zeros */
+                while (next + 1 < end && (next[0] || next[1])) next++;
+                ptr = next + 2;
+            }
+        }
+        free( table );
+    }
+    if (role == PlatformRoleUnspecified)
+    {
+        role = PlatformRoleDesktop;
+        if (GetSystemPowerStatus( &status ) && !(status.BatteryFlag & 128) && status.BatteryFlag != 255)
+            role = PlatformRoleMobile;
+    }
+    /* a slate is mobile to callers that know of no slates */
+    if (role == PlatformRoleSlate && version == POWER_PLATFORM_ROLE_V1) role = PlatformRoleMobile;
+    return role;
+}
+
+/***********************************************************************
+ *		PowerDeterminePlatformRole (POWRPROF.@)
+ */
+POWER_PLATFORM_ROLE WINAPI PowerDeterminePlatformRole(void)
+{
+    return PowerDeterminePlatformRoleEx( POWER_PLATFORM_ROLE_V1 );
+}
