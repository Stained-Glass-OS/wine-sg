From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 04:31:34 -0700
Subject: [PATCH] msi: MsiGetMode cabinet/short-name/admin/advertise modes,
 MsiGetFeatureValidStates

MsiGetMode answers MSIRUNMODE_ADMIN/ADVERTISE (EXECUTEACTION or ACTION),
CABINET (a Media row names a cabinet), SOURCESHORTNAMES (summary word count
bit 0) and TARGETSHORTNAMES (SHORTFILENAMES set) instead of FIXME/TRUE.
MsiGetFeatureValidStates returns the mask of states the feature allows from its
components' source/local attributes and the feature's advertise/absent flags.

diff --git a/dlls/msi/install.c b/dlls/msi/install.c
index 286443d..68f12cd 100644
--- a/dlls/msi/install.c
+++ b/dlls/msi/install.c
@@ -667,6 +667,17 @@ UINT WINAPI MsiSetTargetPathW(MSIHANDLE hInstall, LPCWSTR szFolder,
  *    Not in the state: FALSE
  *
  */
+static BOOL package_has_cabinet( MSIPACKAGE *package )
+{
+    MSIRECORD *rec = MSI_QueryGetRecord( package->db, L"SELECT `Cabinet` FROM `Media` WHERE `Cabinet` IS NOT NULL" );
+    BOOL ret = rec != NULL;
+    if (rec) msiobj_release( &rec->hdr );
+#ifdef SG_MUTANT_MSI_MODE_CAB
+    ret = FALSE;
+#endif
+    return ret;
+}
+
 BOOL WINAPI MsiGetMode(MSIHANDLE hInstall, MSIRUNMODE iRunMode)
 {
     MSIPACKAGE *package;
@@ -698,13 +709,32 @@ BOOL WINAPI MsiGetMode(MSIHANDLE hInstall, MSIRUNMODE iRunMode)
     switch (iRunMode)
     {
     case MSIRUNMODE_ADMIN:
-        FIXME("no support for administrative installs\n");
+    case MSIRUNMODE_ADVERTISE:
+    {
+        const WCHAR *want = (iRunMode == MSIRUNMODE_ADMIN) ? L"ADMIN" : L"ADVERTISE";
+        WCHAR *action = msi_dup_property( package->db, L"EXECUTEACTION" );
+        if (!action) action = msi_dup_property( package->db, L"ACTION" );
+        r = action && !wcsicmp( action, want );
+        free( action );
         break;
+    }
 
-    case MSIRUNMODE_ADVERTISE:
-        FIXME("no support for advertised installs\n");
+    case MSIRUNMODE_CABINET:
+        r = package_has_cabinet( package );
+        break;
+
+    case MSIRUNMODE_SOURCESHORTNAMES:
+        r = (package->WordCount & msidbSumInfoSourceTypeSFN) != 0;
         break;
 
+    case MSIRUNMODE_TARGETSHORTNAMES:
+    {
+        WCHAR *sfn = msi_dup_property( package->db, L"SHORTFILENAMES" );
+        r = sfn && sfn[0];
+        free( sfn );
+        break;
+    }
+
     case MSIRUNMODE_WINDOWS9X:
         if (GetVersion() & 0x80000000)
             r = TRUE;
@@ -1636,9 +1666,51 @@ UINT WINAPI MsiSetInstallLevel(MSIHANDLE hInstall, int iInstallLevel)
  */
 UINT WINAPI MsiGetFeatureValidStatesW( MSIHANDLE hInstall, const WCHAR *szFeature, DWORD *pInstallState )
 {
-    if (pInstallState) *pInstallState = 1 << INSTALLSTATE_LOCAL;
-    FIXME( "%lu, %s, %p stub returning %lu\n", hInstall, debugstr_w(szFeature), pInstallState,
-           pInstallState ? *pInstallState : 0 );
+    MSIPACKAGE *package;
+    MSIFEATURE *feature;
+    ComponentList *cl;
+    BOOL local = TRUE, source = TRUE;
+    DWORD mask = 0;
+
+    TRACE( "%lu, %s, %p\n", hInstall, debugstr_w(szFeature), pInstallState );
+
+    if (!pInstallState) return ERROR_INVALID_PARAMETER;
+    if (!szFeature) return ERROR_UNKNOWN_FEATURE;
+
+    package = msihandle2msiinfo( hInstall, MSIHANDLETYPE_PACKAGE );
+    if (!package)
+    {
+        if (!msi_get_remote( hInstall )) return ERROR_INVALID_HANDLE;
+        /* no remote call for this one: report the common case */
+        *pInstallState = 1 << INSTALLSTATE_LOCAL;
+        return ERROR_SUCCESS;
+    }
+
+    feature = msi_get_loaded_feature( package, szFeature );
+    if (!feature)
+    {
+        msiobj_release( &package->hdr );
+        return ERROR_UNKNOWN_FEATURE;
+    }
+
+    /* component attributes: 0 local only, 1 source only, 2 either (optional) */
+    LIST_FOR_EACH_ENTRY( cl, &feature->Components, ComponentList, entry )
+    {
+        int attrs = cl->component->Attributes & (msidbComponentAttributesSourceOnly | msidbComponentAttributesOptional);
+#ifndef SG_MUTANT_MSI_VALIDSTATES
+        if (attrs == msidbComponentAttributesSourceOnly) local = FALSE;
+        else if (!attrs) source = FALSE;
+#endif
+    }
+    if (local) mask |= 1 << INSTALLSTATE_LOCAL;
+    if (source) mask |= 1 << INSTALLSTATE_SOURCE;
+    if (!(feature->Attributes & msidbFeatureAttributesDisallowAdvertise))
+        mask |= 1 << INSTALLSTATE_ADVERTISED;
+    if (!(feature->Attributes & msidbFeatureAttributesUIDisallowAbsent))
+        mask |= 1 << INSTALLSTATE_ABSENT;
+
+    *pInstallState = mask;
+    msiobj_release( &package->hdr );
     return ERROR_SUCCESS;
 }
 
