+/* Binds the service provider with the given guid to an object that has none
+ * yet. GUID_NULL means: no service provider. */
+static HRESULT DP_InitializeSPGuid( IDirectPlayImpl *This, const GUID *guid )
+{
+  CreateEnumData cbData;
+  HRESULT hr;
+
+  if( IsEqualGUID( &GUID_NULL, guid ) )
+  {
+    /* The GUID_NULL means don't bind a service provider */
+    return DP_OK;
+  }
+
+  TRACE( "Service Provider binding for %s\n", debugstr_guid( guid ) );
+
+  cbData.lpConn = NULL;
+  cbData.lpGuid = guid;
+
+  /* We were given a service provider, find info about it... */
+  hr = IDirectPlayX_EnumConnections( &This->IDirectPlay3A_iface, NULL, cbDPCreateEnumConnections,
+                                     &cbData, DPCONNECTION_DIRECTPLAY );
+  if( FAILED(hr) || cbData.lpConn == NULL )
+  {
+    ERR( "Failed to get Enum for SP: %s\n", DPLAYX_HresultToString(hr) );
+    return DPERR_UNAVAILABLE;
+  }
+
+  /* Initialize the service provider */
+  hr = IDirectPlayX_InitializeConnection( &This->IDirectPlay3A_iface, cbData.lpConn, 0 );
+  free( cbData.lpConn );
+
+  return hr;
+}
