+/* The two names come back in two buffers instead of one DPNAME */
 static HRESULT WINAPI IDirectPlayImpl_GetPlayerName( IDirectPlay *iface, DPID player, LPSTR name,
         DWORD *size_name, LPSTR fullname, DWORD *size_fullname )
 {
     IDirectPlayImpl *This = impl_from_IDirectPlay( iface );
-    FIXME( "(%p)->(0x%08lx,%p,%p,%p,%p): stub\n", This, player, name, size_name, fullname,
+    DWORD size = 0, needed_name, needed_fullname;
+    DPNAME *dpname;
+    HRESULT hr;
+
+    TRACE( "(%p)->(0x%08lx,%p,%p,%p,%p)\n", This, player, name, size_name, fullname,
             size_fullname );
-    return E_NOTIMPL;
+
+    if ( !size_name || !size_fullname )
+        return DPERR_INVALIDPARAMS;
+
+    hr = IDirectPlayX_GetPlayerName( dp1_to_dp4A( This ), player, NULL, &size );
+    if ( hr != DPERR_BUFFERTOOSMALL )
+        return hr;
+
+    dpname = malloc( size );
+    if ( !dpname )
+        return DPERR_OUTOFMEMORY;
+
+    hr = IDirectPlayX_GetPlayerName( dp1_to_dp4A( This ), player, dpname, &size );
+    if ( FAILED( hr ) )
+    {
+        free( dpname );
+        return hr;
+    }
+
+    needed_name     = dpname->lpszShortNameA ? strlen( dpname->lpszShortNameA ) + 1 : 0;
+    needed_fullname = dpname->lpszLongNameA ? strlen( dpname->lpszLongNameA ) + 1 : 0;
+
+    if ( ( needed_name && ( !name || *size_name < needed_name ) ) ||
+         ( needed_fullname && ( !fullname || *size_fullname < needed_fullname ) ) )
+        hr = DPERR_BUFFERTOOSMALL;
+    else
+    {
+        if ( needed_name )
+            memcpy( name, dpname->lpszShortNameA, needed_name );
+        if ( needed_fullname )
+            memcpy( fullname, dpname->lpszLongNameA, needed_fullname );
+        hr = DP_OK;
+    }
+
+#ifdef SG_MUTANT_V1_NAMES
+    needed_name = needed_fullname = 0;
+#endif
+    *size_name     = needed_name;
+    *size_fullname = needed_fullname;
+
+    free( dpname );
+
+    return hr;
 }
 
