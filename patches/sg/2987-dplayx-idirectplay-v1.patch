+/* A version 1 session is joined by the number a session enumeration gave it,
+ * anything else creates a new one. */
 static HRESULT WINAPI IDirectPlayImpl_Open( IDirectPlay *iface, DPSESSIONDESC *sdesc )
 {
     IDirectPlayImpl *This = impl_from_IDirectPlay( iface );
-    FIXME( "(%p)->(%p): stub\n", This, sdesc );
-    return E_NOTIMPL;
+    DPSESSIONDESC desc;
+    DPSESSIONDESC2 sdesc2;
+    DWORD flags = DPOPEN_CREATE;
+    DPSESSIONDESC2 *known;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", This, sdesc );
+
+    if ( !sdesc || sdesc->dwSize != sizeof( DPSESSIONDESC ) )
+        return DPERR_INVALIDPARAMS;
+
+    if ( This->dp2->connectionInitialized == NO_PROVIDER )
+        return DPERR_UNINITIALIZED;
+
+    desc = *sdesc;
+    DP1_SessionDescToV2( &sdesc2, &desc );
+
+#ifdef SG_MUTANT_V1_OPEN
+    if ( 0 )
+#else
+    if ( desc.dwSession )
+#endif
+    {
+        flags = DPOPEN_JOIN;
+
+        EnterCriticalSection( &This->lock );
+
+        NS_ResetSessionEnumeration( This->dp2->lpNameServerData );
+
+        for ( ;; )
+        {
+            known = NS_WalkSessions( This->dp2->lpNameServerData, NULL, TRUE );
+            if ( !known )
+            {
+                LeaveCriticalSection( &This->lock );
+                return DPERR_NOSESSIONS;
+            }
+            if ( DP1_SessionNumber( &known->guidInstance ) == desc.dwSession )
+                break;
+        }
+
+        sdesc2.guidInstance = known->guidInstance;
+
+        LeaveCriticalSection( &This->lock );
+    }
+
+    hr = IDirectPlayX_Open( dp1_to_dp4A( This ), &sdesc2, flags );
+
+    return hr;
 }
 
