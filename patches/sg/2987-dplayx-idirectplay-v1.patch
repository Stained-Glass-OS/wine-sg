+/* Allow or refuse new players: the session description of the host carries
+ * the setting. The ones that enumerated the session before it changed do not
+ * hear about it until they enumerate again. */
 static HRESULT WINAPI IDirectPlayImpl_EnableNewPlayers( IDirectPlay *iface, BOOL enable )
 {
     IDirectPlayImpl *This = impl_from_IDirectPlay( iface );
-    FIXME( "(%p)->(%d): stub\n", This, enable );
-    return E_NOTIMPL;
+    HRESULT hr = DP_OK;
+
+    TRACE( "(%p)->(%d)\n", This, enable );
+
+    if ( This->dp2->connectionInitialized == NO_PROVIDER )
+        return DPERR_UNINITIALIZED;
+
+    EnterCriticalSection( &This->lock );
+
+    if ( !This->dp2->bConnectionOpen )
+        hr = DPERR_NOSESSIONS;
+    else if ( !This->dp2->bHostInterface )
+        hr = DPERR_ACCESSDENIED;
+#ifdef SG_MUTANT_V1_ENABLE
+    else if ( !enable )
+#else
+    else if ( enable )
+#endif
+        This->dp2->lpSessionDesc->dwFlags &= ~DPSESSION_NEWPLAYERSDISABLED;
+    else
+        This->dp2->lpSessionDesc->dwFlags |= DPSESSION_NEWPLAYERSDISABLED;
+
+    LeaveCriticalSection( &This->lock );
+
+    return hr;
 }
 
