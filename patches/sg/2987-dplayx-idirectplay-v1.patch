From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dplayx: IDirectPlay (version 1) interface

The first version of the interface was E_NOTIMPL for everything. It shares
the object with the later versions, so each method is the DirectPlay 4 (ANSI)
method with the version 1 arguments converted: names are plain strings, a
session is a DPSESSIONDESC (dwSession is the number of the instance guid of
the enumerated session; Open joins the session with that number, anything
else creates one), the callbacks have their own shapes, CreatePlayer makes
the receive event for the application, GetPlayerName gives two buffers, and
EnableNewPlayers is the session flag. Initialize binds the service provider
like DirectPlayCreate does (DirectPlayCreate shares the code and no longer
leaks the object when it fails). SaveSession is DPERR_UNSUPPORTED (the
sessions "previously" played are not kept; EnumSessions(PREVIOUS) lists none).

---
diff --git a/dlls/dplayx/dplay.c b/dlls/dplayx/dplay.c
index 3ff298e..f99627a 100644
--- a/dlls/dplayx/dplay.c
+++ b/dlls/dplayx/dplay.c
@@ -759,175 +759,557 @@ static ULONG WINAPI IDirectPlayImpl_Release( IDirectPlay *iface )
     return ref;
 }
 
+/* IDirectPlay (the first version of the interface). It shares the object with
+ * the later versions: every method is the DirectPlay 4 (ANSI) method with its
+ * arguments converted. The differences are in the arguments: names are plain
+ * ANSI strings, a session is a DPSESSIONDESC, the callbacks have their own
+ * shapes, the receive event is created for the application and a session is
+ * named by the dwSession number of the session description. */
+
+static inline IDirectPlay4A *dp1_to_dp4A( IDirectPlayImpl *This )
+{
+    return &This->IDirectPlay4A_iface;
+}
+
+/* dwSession of a version 1 session description stands for the instance guid */
+static DWORD DP1_SessionNumber( const GUID *instance )
+{
+    return instance->Data1;
+}
+
+static void DP1_SessionDescFromV2( DPSESSIONDESC *dst, const DPSESSIONDESC2 *src )
+{
+    memset( dst, 0, sizeof( *dst ) );
+    dst->dwSize           = sizeof( *dst );
+    dst->guidSession      = src->guidApplication;
+    dst->dwSession        = DP1_SessionNumber( &src->guidInstance );
+#ifdef SG_MUTANT_V1_SESSION
+    dst->dwSession        = 0;
+#endif
+    dst->dwMaxPlayers     = src->dwMaxPlayers;
+    dst->dwCurrentPlayers = src->dwCurrentPlayers;
+    dst->dwFlags          = src->dwFlags;
+    if ( src->lpszSessionNameA )
+        lstrcpynA( dst->szSessionName, src->lpszSessionNameA, sizeof( dst->szSessionName ) );
+    if ( src->lpszPasswordA )
+        lstrcpynA( dst->szPassword, src->lpszPasswordA, sizeof( dst->szPassword ) );
+    dst->dwUser1          = src->dwUser1;
+    dst->dwUser2          = src->dwUser2;
+    dst->dwUser3          = src->dwUser3;
+    dst->dwUser4          = src->dwUser4;
+}
+
+/* The name and password point into src (and must stay valid while dst is
+ * used) */
+static void DP1_SessionDescToV2( DPSESSIONDESC2 *dst, DPSESSIONDESC *src )
+{
+    memset( dst, 0, sizeof( *dst ) );
+    dst->dwSize           = sizeof( *dst );
+    dst->guidApplication  = src->guidSession;
+    dst->dwMaxPlayers     = src->dwMaxPlayers;
+    dst->dwCurrentPlayers = src->dwCurrentPlayers;
+    dst->dwFlags          = src->dwFlags;
+    src->szSessionName[ sizeof( src->szSessionName ) - 1 ] = 0;
+    src->szPassword[ sizeof( src->szPassword ) - 1 ]       = 0;
+    if ( src->szSessionName[0] )
+        dst->lpszSessionNameA = src->szSessionName;
+    if ( src->szPassword[0] )
+        dst->lpszPasswordA = src->szPassword;
+    dst->dwUser1          = src->dwUser1;
+    dst->dwUser2          = src->dwUser2;
+    dst->dwUser3          = src->dwUser3;
+    dst->dwUser4          = src->dwUser4;
+}
+
+static void DP1_Name( DPNAME *dpname, char *name, char *fullname )
+{
+    memset( dpname, 0, sizeof( *dpname ) );
+    dpname->dwSize            = sizeof( *dpname );
+    dpname->lpszShortNameA    = name;
+    dpname->lpszLongNameA     = fullname;
+}
+
+struct DP1EnumSessions
+{
+    LPDPENUMSESSIONSCALLBACK callback;
+    void *context;
+};
+
+static BOOL CALLBACK DP1_EnumSessionsCallback( const DPSESSIONDESC2 *sdesc2, DWORD *timeout,
+        DWORD flags, void *context )
+{
+    struct DP1EnumSessions *data = context;
+    DPSESSIONDESC sdesc;
+
+    if ( !sdesc2 )
+        return data->callback( NULL, data->context, timeout, flags );
+
+    DP1_SessionDescFromV2( &sdesc, sdesc2 );
+
+    return data->callback( &sdesc, data->context, timeout, flags );
+}
+
+struct DP1EnumPlayers
+{
+    LPDPENUMPLAYERSCALLBACK callback;
+    void *context;
+};
+
+static BOOL CALLBACK DP1_EnumPlayersCallback( DPID id, DWORD type, const DPNAME *name,
+        DWORD flags, void *context )
+{
+    struct DP1EnumPlayers *data = context;
+
+#ifdef SG_MUTANT_V1_ENUMCB
+    return data->callback( id, name ? name->lpszLongNameA : NULL,
+                           name ? name->lpszShortNameA : NULL, flags, data->context );
+#endif
+    return data->callback( id, name ? name->lpszShortNameA : NULL,
+                           name ? name->lpszLongNameA : NULL, flags, data->context );
+}
+
+/* DPERR_UNINITIALIZED and DPERR_INVALIDPARAMS are checked by the methods */
+static HRESULT DP1_EnumPlayers( IDirectPlayImpl *This, DPID group, DWORD session,
+        LPDPENUMPLAYERSCALLBACK callback, void *context, DWORD flags, BOOL groups )
+{
+    struct DP1EnumPlayers data;
+    GUID instance;
+    GUID *pinstance = NULL;
+    HRESULT hr;
+
+    if ( This->dp2->connectionInitialized == NO_PROVIDER )
+        return DPERR_UNINITIALIZED;
+
+    if ( !callback )
+        return DPERR_INVALIDPARAMS;
+
+    data.callback = callback;
+    data.context  = context;
+
+    /* A session other than the open one cannot be enumerated */
+    if ( session )
+    {
+        EnterCriticalSection( &This->lock );
+        if ( This->dp2->bConnectionOpen && This->dp2->lpSessionDesc &&
+             DP1_SessionNumber( &This->dp2->lpSessionDesc->guidInstance ) == session )
+        {
+            instance = This->dp2->lpSessionDesc->guidInstance;
+            pinstance = &instance;
+        }
+        LeaveCriticalSection( &This->lock );
+
+        if ( !pinstance )
+            return DPERR_NOSESSIONS;
+    }
+
+    if ( groups )
+        hr = IDirectPlayX_EnumGroups( dp1_to_dp4A( This ), pinstance, DP1_EnumPlayersCallback,
+                                      &data, flags );
+    else
+        hr = IDirectPlayX_EnumGroupPlayers( dp1_to_dp4A( This ), group, pinstance,
+                                            DP1_EnumPlayersCallback, &data, flags );
+
+    return hr;
+}
