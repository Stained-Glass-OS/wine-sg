+/* Stained Glass OS: the system colours a colour scheme's [SysMetrics] names,
+ * without applying them or anything else it sets (fonts, sizes) -- switching
+ * between Light and Dark changes colours only. Returns how many. */
+int MSSTYLES_GetThemeSysColors(PTHEME_FILE tf, int *elements, COLORREF *colors, int max)
+{
+    struct PARSECOLORSTATE state;
+    WCHAR szPropertyName[MAX_THEME_VALUE_NAME];
+    int iPropertyPrimitive, iPropertyId, i;
+    DWORD dwLen, dwValueLen;
+    LPCWSTR lpName, lpValue;
+    PUXINI_FILE ini;
+
+    parse_init_color(&state);
+    if (!(ini = MSSTYLES_GetActiveThemeIni(tf))) return 0;
+    while ((lpName = UXINI_GetNextSection(ini, &dwLen)))
+    {
+        if (CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, lpName, dwLen, L"SysMetrics", -1) != CSTR_EQUAL)
+            continue;
+        while ((lpName = UXINI_GetNextValue(ini, &dwLen, &lpValue, &dwValueLen)))
+        {
+            lstrcpynW(szPropertyName, lpName, min(dwLen + 1, ARRAY_SIZE(szPropertyName)));
+            if (MSSTYLES_LookupProperty(szPropertyName, &iPropertyPrimitive, &iPropertyId) &&
+                iPropertyId >= TMT_FIRSTCOLOR && iPropertyId <= TMT_LASTCOLOR)
+                parse_handle_color_property(&state, iPropertyId, lpValue, dwValueLen);
+        }
+    }
+    UXINI_CloseINI(ini);
+    for (i = 0; i < state.colorCount && i < max; i++)
+    {
+        elements[i] = state.colorElements[i];
+        colors[i] = state.colorRgb[i];
+    }
+    return i;
+}
