 /***********************************************************************
+ * Stained Glass OS: dark mode, and following a theme change live.
+ *
+ * Wine loads the visual style once, when uxtheme is loaded, so a colour
+ * scheme chosen later reached only the process that chose it. Each process
+ * now watches the ThemeManager key and reloads the style (never its metrics)
+ * when another process switched it -- controls reopen their theme data on the
+ * WM_THEMECHANGED that follows.
+ *
+ * Dark mode is a colour scheme named "Dark" in the active style (our
+ * light.msstyles has one). RefreshImmersiveColorPolicyState -- the shell calls
+ * it on WM_SETTINGCHANGE "ImmersiveColorSet" and when it starts -- selects Dark
+ * while HKCU\...\Themes\Personalize AppsUseLightTheme is 0 and the style's
+ * default scheme otherwise, and applies the scheme's system colours only.
+ */
+static HKEY theme_notify_key;
+static HANDLE theme_notify_event;
+
+BOOLEAN WINAPI ShouldAppsUseDarkMode(void);
+
+static void watch_theme_manager(void)
+{
+    if (!theme_notify_key &&
+        RegOpenKeyExW(HKEY_CURRENT_USER, szThemeManager, 0, KEY_NOTIFY | KEY_QUERY_VALUE, &theme_notify_key))
+        return;
+    if (!theme_notify_event && !(theme_notify_event = CreateEventW(NULL, FALSE, FALSE, NULL)))
+        return;
+    RegNotifyChangeKeyValue(theme_notify_key, FALSE, REG_NOTIFY_CHANGE_LAST_SET, theme_notify_event, TRUE);
+}
+
+static void read_theme_config(BOOL *active, WCHAR *theme, WCHAR *color, DWORD color_size,
+                              WCHAR *size, DWORD size_size)
+{
+    WCHAR tmp[10];
+    DWORD len;
+    HKEY hKey;
+
+    *active = FALSE;
+    theme[0] = color[0] = size[0] = 0;
+    if (RegOpenKeyW(HKEY_CURRENT_USER, szThemeManager, &hKey)) return;
+    len = sizeof(tmp);
+    if (!RegQueryValueExW(hKey, L"ThemeActive", NULL, NULL, (BYTE *)tmp, &len)) *active = (tmp[0] != '0');
+    len = color_size;
+    if (RegQueryValueExW(hKey, L"ColorName", NULL, NULL, (BYTE *)color, &len)) color[0] = 0;
+    len = size_size;
+    if (RegQueryValueExW(hKey, L"SizeName", NULL, NULL, (BYTE *)size, &len)) size[0] = 0;
+    if (query_reg_path(hKey, L"DllName", theme)) theme[0] = 0;
+    RegCloseKey(hKey);
+}
+
+/* Another process changed the theme configuration: take the style it chose. */
+static void UXTHEME_FollowThemeChange(void)
+{
+    WCHAR theme[MAX_PATH], color[64], size[64];
+    PTHEME_FILE pt;
+    BOOL active;
+
+    if (!theme_notify_event || WaitForSingleObject(theme_notify_event, 0)) return;
+    watch_theme_manager();
+
+    read_theme_config(&active, theme, color, sizeof(color), size, sizeof(size));
+    if (active == bThemeActive && !lstrcmpiW(theme, szCurrentTheme) &&
+        !lstrcmpiW(color, szCurrentColor) && !lstrcmpiW(size, szCurrentSize))
+        return;
+    if (active && theme[0] &&
+        SUCCEEDED(MSSTYLES_OpenThemeFile(theme, color[0] ? color : NULL, size[0] ? size : NULL, &pt)))
+    {
+        TRACE("following %s %s %s\n", debugstr_w(theme), debugstr_w(color), debugstr_w(size));
+        lstrcpynW(szCurrentTheme, pt->szThemeFile, ARRAY_SIZE(szCurrentTheme));
+        lstrcpynW(szCurrentColor, pt->pszSelectedColor, ARRAY_SIZE(szCurrentColor));
+        lstrcpynW(szCurrentSize, pt->pszSelectedSize, ARRAY_SIZE(szCurrentSize));
+        bThemeActive = TRUE;
+        MSSTYLES_SetActiveTheme(pt, FALSE);
+        MSSTYLES_CloseThemeFile(pt);
+    }
+    else if (!active)
+    {
+        bThemeActive = FALSE;
+        szCurrentTheme[0] = szCurrentColor[0] = szCurrentSize[0] = 0;
+        MSSTYLES_SetActiveTheme(NULL, FALSE);
+    }
+}
+
+/* repaint the title bars and frames too (SetSysColors repaints client areas):
+ * only windows that are shown and have a frame -- invalidating the shell's
+ * transparent helper windows would erase the desktop's icons under them */
+static BOOL CALLBACK redraw_frame_proc(HWND hwnd, LPARAM lparam)
+{
+    DWORD style = GetWindowLongW(hwnd, GWL_STYLE);
+
+    if (IsWindowVisible(hwnd) && (style & (WS_CAPTION | WS_THICKFRAME | WS_BORDER | WS_DLGFRAME)))
+        RedrawWindow(hwnd, NULL, 0, RDW_INVALIDATE | RDW_FRAME);
+    return TRUE;
+}
+
+/* Switch the active style to another of its colour schemes, for everyone:
+ * the scheme's system colours (persisted, as the Control Panel keeps them),
+ * the ThemeManager's ColorName, WM_THEMECHANGED, and every frame repainted. */
+static void UXTHEME_ApplyColorScheme(PTHEME_FILE tf)
+{
+    int elements[NUM_SYS_COLORS], count, i, length;
+    COLORREF colors[NUM_SYS_COLORS];
+    WCHAR string[13];
+    HKEY hKey;
+
+    TRACE("colour scheme %s\n", debugstr_w(tf->pszSelectedColor));
+    if (!RegCreateKeyW(HKEY_CURRENT_USER, szThemeManager, &hKey))
+    {
+        RegSetValueExW(hKey, L"ColorName", 0, REG_SZ, (const BYTE *)tf->pszSelectedColor,
+                       (lstrlenW(tf->pszSelectedColor) + 1) * sizeof(WCHAR));
+        RegCloseKey(hKey);
+    }
+    lstrcpynW(szCurrentColor, tf->pszSelectedColor, ARRAY_SIZE(szCurrentColor));
+    MSSTYLES_SetActiveTheme(tf, FALSE);
+
+    count = MSSTYLES_GetThemeSysColors(tf, elements, colors, NUM_SYS_COLORS);
+    if (count && !RegCreateKeyExW(HKEY_CURRENT_USER, strColorKey, 0, 0, 0, KEY_ALL_ACCESS, 0, &hKey, 0))
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (elements[i] < 0 || elements[i] >= NUM_SYS_COLORS) continue;
+            length = swprintf(string, ARRAY_SIZE(string), L"%d %d %d", GetRValue(colors[i]),
+                              GetGValue(colors[i]), GetBValue(colors[i]));
+            RegSetValueExW(hKey, SysColorsNames[elements[i]], 0, REG_SZ, (BYTE *)string,
+                           (length + 1) * sizeof(WCHAR));
+        }
+        RegCloseKey(hKey);
+    }
+    /* our own notification is not for us: we are already there */
+    if (theme_notify_event) WaitForSingleObject(theme_notify_event, 0);
+    watch_theme_manager();
+    if (count) SetSysColors(count, elements, colors);
+    UXTHEME_broadcast_msg(NULL, WM_THEMECHANGED);
+    EnumWindows(redraw_frame_proc, 0);
+}
+
+/**********************************************************************
+ *      RefreshImmersiveColorPolicyState                  (UXTHEME.104)
+ *
+ * Stained Glass OS: make the visual style follow the app mode (see above).
+ */
+void WINAPI RefreshImmersiveColorPolicyState(void)
+{
+    WCHAR theme[MAX_PATH], color[64], size[64];
+    PTHEME_FILE light = NULL, dark = NULL, want;
+    BOOL active;
+
+    UXTHEME_FollowThemeChange();
+    read_theme_config(&active, theme, color, sizeof(color), size, sizeof(size));
+    if (!active || !theme[0]) return;
+    if (FAILED(MSSTYLES_OpenThemeFile(theme, L"Dark", size[0] ? size : NULL, &dark)))
+        return;   /* this style has no dark scheme */
+    if (SUCCEEDED(MSSTYLES_OpenThemeFile(theme, NULL, size[0] ? size : NULL, &light)))
+    {
+        want = ShouldAppsUseDarkMode() ? dark : light;
+        if (lstrcmpiW(color, want->pszSelectedColor) || lstrcmpiW(szCurrentColor, want->pszSelectedColor))
+            UXTHEME_ApplyColorScheme(want);
+        MSSTYLES_CloseThemeFile(light);
+    }
+    MSSTYLES_CloseThemeFile(dark);
+}
