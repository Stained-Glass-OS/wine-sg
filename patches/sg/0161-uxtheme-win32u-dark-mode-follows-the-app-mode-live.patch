+/* Stained Glass OS: another process changed the system colours --
+ * SetSysColors broadcasts WM_SYSCOLORCHANGE -- so read them again: each
+ * process caches them when first used, and stock Wine never looked twice.
+ * A changed colour gets a new brush and pen; the old ones stay valid (a
+ * program may be holding them), so they are left alone rather than deleted. */
+void reload_sys_colors(void)
+{
+    COLORREF old, now;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE( system_colors ); i++)
+    {
+        if (!system_colors[i].hdr.loaded) continue;
+        old = system_colors[i].val;
+        system_colors[i].hdr.loaded = FALSE;
+        get_entry( &system_colors[i], 0, &now );
+        if (now == old) continue;
+        InterlockedExchangePointer( (void **)&system_colors[i].brush, 0 );
+        InterlockedExchangePointer( (void **)&system_colors[i].pen, 0 );
+    }
+}
