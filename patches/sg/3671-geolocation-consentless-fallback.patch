From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] geolocation: AllowFallbackToConsentlessPositions (3671)

geolocation: AllowFallbackToConsentlessPositions

After an app calls IGeolocator2.AllowFallbackToConsentlessPositions, a request
that the app's own consent would refuse is answered with a coarse position:
GeoClue is asked for the city level only and the source is IPAddress. This
holds only while both the device switch (HKLM) and the user's location switch
(HKCU) are on; with either off the request is refused as before.
---
diff --git a/dlls/geolocation/main.c b/dlls/geolocation/main.c
index c037036..7b45ead 100644
--- a/dlls/geolocation/main.c
+++ b/dlls/geolocation/main.c
@@ -49,6 +49,8 @@ struct geolocator
 {
     IGeolocator IGeolocator_iface;
     IGeolocatorWithScalarAccuracy IGeolocatorWithScalarAccuracy_iface;
+    IGeolocator2 IGeolocator2_iface;
+    BOOL fallback;       /* AllowFallbackToConsentlessPositions was called */
     IWeakReferenceSource IWeakReferenceSource_iface;
     IWeakReference IWeakReference_iface;
     LONG ref_public;
@@ -101,6 +103,9 @@ static BOOL consent_value_denied( HKEY root, const WCHAR *subkey )
 
 /* Allow unless the device-wide switch, the user's switch or the desktop apps switch says Deny.
  * Read at every request: Settings can change it while an app runs. */
+static BOOL device_denied(void) { return consent_value_denied( HKEY_LOCAL_MACHINE, NULL ); }
+static BOOL user_denied(void) { return consent_value_denied( HKEY_CURRENT_USER, NULL ); }
+
 static BOOL location_denied(void)
 {
 #ifdef SG_MUTANT_GEO_NOHKLM
@@ -165,6 +170,13 @@ static HRESULT WINAPI geolocator_QueryInterface(IGeolocator *iface, REFIID iid,
         return S_OK;
     }
 
+    if (IsEqualGUID(iid, &IID_IGeolocator2))
+    {
+        *out = &impl->IGeolocator2_iface;
+        IInspectable_AddRef(*out);
+        return S_OK;
+    }
+
     if (IsEqualGUID(iid, &IID_IGeolocatorWithScalarAccuracy))
     {
         *out = &impl->IGeolocatorWithScalarAccuracy_iface;
@@ -199,10 +211,11 @@ static HRESULT WINAPI geolocator_GetIids(IGeolocator *iface, ULONG *iid_count, I
 {
     TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
     if (!iid_count || !iids) return E_POINTER;
-    if (!(*iids = CoTaskMemAlloc(2 * sizeof(IID)))) return E_OUTOFMEMORY;
+    if (!(*iids = CoTaskMemAlloc(3 * sizeof(IID)))) return E_OUTOFMEMORY;
     (*iids)[0] = IID_IGeolocator;
-    (*iids)[1] = IID_IGeolocatorWithScalarAccuracy;
-    *iid_count = 2;
+    (*iids)[1] = IID_IGeolocator2;
+    (*iids)[2] = IID_IGeolocatorWithScalarAccuracy;
+    *iid_count = 3;
     return S_OK;
 }
 
@@ -358,6 +371,24 @@ static void fire_position_changed(struct geolocator *impl, IGeoposition *positio
 }
 
 /* Ask GeoClue for the position.  Consent is checked first: with location denied nothing is sent anywhere. */
+/* AllowFallbackToConsentlessPositions: only the app's own consent is overridden, and only while the
+ * device switch and the user's switch are both on; the answer is then the city level. */
+static BOOL fallback_active(struct geolocator *impl)
+{
+    BOOL allowed;
+
+    EnterCriticalSection(&impl->cs);
+    allowed = impl->fallback;
+    LeaveCriticalSection(&impl->cs);
+#ifdef SG_MUTANT_GEO_FB_DEVICE
+    return allowed && !user_denied();
+#elif defined(SG_MUTANT_GEO_FB_USER)
+    return allowed && !device_denied();
+#else
+    return allowed && !device_denied() && !user_denied();
+#endif
+}
+
 /* The app's default geoposition (Geolocator.DefaultGeoposition), shared by the process. */
 static CRITICAL_SECTION default_cs;
 static CRITICAL_SECTION_DEBUG default_cs_debug =
@@ -402,13 +433,18 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
 {
     struct get_location_params params = {0};
     PositionAccuracy accuracy;
+    BOOL city_only = FALSE;
     HRESULT hr;
 
     if (location_denied())
     {
+        city_only = fallback_active(impl);
 #ifndef SG_MUTANT_GEO_CALL_WHEN_DENIED
-        set_status(impl, PositionStatus_Disabled);
-        return E_ACCESSDENIED;
+        if (!city_only)
+        {
+            set_status(impl, PositionStatus_Disabled);
+            return E_ACCESSDENIED;
+        }
 #endif
     }
 
@@ -425,6 +461,13 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
     set_status(impl, PositionStatus_Initializing);
 
     params.high_accuracy = accuracy == PositionAccuracy_High;
+    params.city_only = city_only;
+#ifdef SG_MUTANT_GEO_FB_EXACT
+    params.city_only = 0;
+    params.high_accuracy = 1;
+#else
+    if (city_only) params.high_accuracy = 0;     /* never more than the city through the fallback */
+#endif
     params.timeout_ms = timeout_ms;
     params.result = LOCATION_UNAVAILABLE;
     if (__wine_init_unix_call() || WINE_UNIX_CALL(unix_get_location, &params))
@@ -444,7 +487,7 @@ static HRESULT fetch_location(struct geolocator *impl, int timeout_ms, struct lo
         loc->has_speed = !!(params.flags & LOCATION_HAS_SPEED);
         loc->has_heading = !!(params.flags & LOCATION_HAS_HEADING);
         loc->timestamp = (LONGLONG)params.time_sec * 10000000 + params.time_usec * 10 + 116444736000000000ll;
-        loc->source = PositionSource_Unknown;   /* GeoClue does not say which source it used */
+        loc->source = city_only ? PositionSource_IPAddress : PositionSource_Unknown;   /* GeoClue does not say which source it used */
         EnterCriticalSection(&impl->cs);
         impl->cache = *loc;
         impl->has_cache = TRUE;
@@ -511,7 +554,7 @@ static HRESULT get_position_callback(void *context, IUnknown **object, INT32 *va
     HRESULT hr = S_OK;
     BOOL cached = FALSE;
 
-    if (location_denied())
+    if (location_denied() && !fallback_active(impl))
     {
 #ifndef SG_MUTANT_GEO_CALL_WHEN_DENIED
         set_status(impl, PositionStatus_Disabled);
@@ -933,6 +976,61 @@ static const IReference_BasicGeopositionVtbl bgp_ref_vtbl =
     bgp_ref_GetRuntimeClassName, bgp_ref_GetTrustLevel, bgp_ref_get_Value,
 };
 
+/* IGeolocator2 */
+
+static inline struct geolocator *impl_from_IGeolocator2(IGeolocator2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct geolocator, IGeolocator2_iface);
+}
+
+static HRESULT WINAPI geo2_QueryInterface(IGeolocator2 *iface, REFIID iid, void **out)
+{
+    return geolocator_QueryInterface(&impl_from_IGeolocator2(iface)->IGeolocator_iface, iid, out);
+}
+
+static ULONG WINAPI geo2_AddRef(IGeolocator2 *iface)
+{
+    return geolocator_AddRef(&impl_from_IGeolocator2(iface)->IGeolocator_iface);
+}
+
+static ULONG WINAPI geo2_Release(IGeolocator2 *iface)
+{
+    return geolocator_Release(&impl_from_IGeolocator2(iface)->IGeolocator_iface);
+}
+
+static HRESULT WINAPI geo2_GetIids(IGeolocator2 *iface, ULONG *count, IID **iids)
+{
+    return geolocator_GetIids(&impl_from_IGeolocator2(iface)->IGeolocator_iface, count, iids);
+}
+
+static HRESULT WINAPI geo2_GetRuntimeClassName(IGeolocator2 *iface, HSTRING *name)
+{
+    return get_class_name(name);
+}
+
+static HRESULT WINAPI geo2_GetTrustLevel(IGeolocator2 *iface, TrustLevel *level)
+{
+    return get_base_trust(level);
+}
+
+static HRESULT WINAPI geo2_AllowFallbackToConsentlessPositions(IGeolocator2 *iface)
+{
+    struct geolocator *impl = impl_from_IGeolocator2(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&impl->cs);
+    impl->fallback = TRUE;
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static const IGeolocator2Vtbl geo2_vtbl =
+{
+    geo2_QueryInterface, geo2_AddRef, geo2_Release, geo2_GetIids, geo2_GetRuntimeClassName,
+    geo2_GetTrustLevel, geo2_AllowFallbackToConsentlessPositions,
+};
+
 /* IGeolocatorWithScalarAccuracy: DesiredAccuracyInMeters */
 
 static inline struct geolocator *impl_from_IGeolocatorWithScalarAccuracy(IGeolocatorWithScalarAccuracy *iface)
@@ -1230,6 +1328,7 @@ static HRESULT WINAPI factory_ActivateInstance(IActivationFactory *iface, IInspe
 
     impl->IGeolocator_iface.lpVtbl = &geolocator_vtbl;
     impl->IGeolocatorWithScalarAccuracy_iface.lpVtbl = &scalar_vtbl;
+    impl->IGeolocator2_iface.lpVtbl = &geo2_vtbl;
     impl->IWeakReferenceSource_iface.lpVtbl = &weak_reference_source_vtbl;
     impl->IWeakReference_iface.lpVtbl = &weak_reference_vtbl;
     impl->ref_public = 1;
diff --git a/dlls/geolocation/tests/geolocator.c b/dlls/geolocation/tests/geolocator.c
index c241ee9..c707ab8 100644
--- a/dlls/geolocation/tests/geolocator.c
+++ b/dlls/geolocation/tests/geolocator.c
@@ -184,8 +184,8 @@ void test_basic(void)
            "got hr %#lx, status %d.\n", hr, status);
 
         hr = IGeolocator_GetIids(geolocator, &count, &iids);
-        ok(hr == S_OK && count == 2 && IsEqualGUID(&iids[0], &IID_IGeolocator) &&
-           IsEqualGUID(&iids[1], &IID_IGeolocatorWithScalarAccuracy), "got hr %#lx, count %lu.\n", hr, count);
+        ok(hr == S_OK && count == 3 && IsEqualGUID(&iids[0], &IID_IGeolocator) &&
+           IsEqualGUID(&iids[1], &IID_IGeolocator2) && IsEqualGUID(&iids[2], &IID_IGeolocatorWithScalarAccuracy), "got hr %#lx, count %lu.\n", hr, count);
         CoTaskMemFree(iids);
         hr = IGeolocator_GetRuntimeClassName(geolocator, &name);
         buf = WindowsGetStringRawBuffer(name, NULL);
diff --git a/dlls/geolocation/unixlib.c b/dlls/geolocation/unixlib.c
index 3906dee..aa0ee3e 100644
--- a/dlls/geolocation/unixlib.c
+++ b/dlls/geolocation/unixlib.c
@@ -96,6 +96,7 @@ static BOOL load_dbus(void)
 
 /* GeoClue's GClueAccuracyLevel */
 #define ACCURACY_NEIGHBORHOOD 5
+#define ACCURACY_CITY         4
 #define ACCURACY_EXACT        8
 
 /* test-only: a private bus instead of the system bus */
@@ -310,7 +311,7 @@ static int do_get_location( struct get_location_params *params )
     DBusError err;
     char client[256], location[256];
     const char *path, *desktop_id = "wine";
-    dbus_uint32_t level = params->high_accuracy ? ACCURACY_EXACT : ACCURACY_NEIGHBORHOOD;
+    dbus_uint32_t level = params->city_only ? ACCURACY_CITY : params->high_accuracy ? ACCURACY_EXACT : ACCURACY_NEIGHBORHOOD;
     int result;
 
     if (!load_dbus()) return LOCATION_UNAVAILABLE;
diff --git a/dlls/geolocation/unixlib.h b/dlls/geolocation/unixlib.h
index bec0dbe..fd7e3ae 100644
--- a/dlls/geolocation/unixlib.h
+++ b/dlls/geolocation/unixlib.h
@@ -46,7 +46,7 @@ struct get_location_params
     double heading;      /* degrees from true north */
     long long time_sec;  /* seconds since 1970 */
     int time_usec;
-    int pad;
+    int city_only;       /* in: ask GeoClue for the city level (never more) */
 };
 
 enum geolocation_funcs
