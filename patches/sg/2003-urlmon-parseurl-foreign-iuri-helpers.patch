+/* Actions that Windows answers by parsing the URL into its components. */
+static HRESULT parse_with_uri(LPCWSTR url, PARSEACTION action, DWORD flags, LPWSTR result,
+        DWORD size, DWORD *rsize)
+{
+    DWORD create_flags = Uri_CREATE_ALLOW_RELATIVE;
+    DWORD len = 0;
+    IUri *uri;
+    HRESULT hres;
+
+    TRACE("(%s %d %08lx %p %ld %p)\n", debugstr_w(url), action, flags, result, size, rsize);
+
+#ifdef SG_MUTANT_PARSEURL
+    return E_NOTIMPL;
+#endif
+    if(action == PARSE_URL_FROM_PATH)
+        create_flags |= Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME;
+
+    hres = CreateUri(url, create_flags, 0, &uri);
+    if(FAILED(hres))
+        return E_FAIL;
+
+    hres = CoInternetParseIUri(uri, action, flags, result, size, &len, 0);
+    IUri_Release(uri);
+
+    if(rsize)
+        *rsize = len;
+    if(hres == STRSAFE_E_INSUFFICIENT_BUFFER)
+        return E_POINTER;
+    return hres;
+}
+
+static HRESULT parse_escape(LPCWSTR url, DWORD flags, LPWSTR result, DWORD size, DWORD *rsize)
+{
+    IInternetProtocolInfo *protocol_info;
+    DWORD prsize;
+    HRESULT hres;
+
+    TRACE("(%s %08lx %p %ld %p)\n", debugstr_w(url), flags, result, size, rsize);
+
+    protocol_info = get_protocol_info(url);
+    if(protocol_info) {
+        hres = IInternetProtocolInfo_ParseUrl(protocol_info, url, PARSE_ESCAPE, flags, result, size, rsize, 0);
+        IInternetProtocolInfo_Release(protocol_info);
+        if(SUCCEEDED(hres))
+            return hres;
+    }
+
+    prsize = size;
+#ifdef SG_MUTANT_PARSEESCAPE
+    hres = UrlUnescapeW((LPWSTR)url, result, &prsize, flags);
+#else
+    hres = UrlEscapeW(url, result, &prsize, flags);
+#endif
+    if(rsize)
+        *rsize = prsize;
+    return hres;
+}
+
