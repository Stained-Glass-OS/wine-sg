+/* Callers outside this file may hand us an IUri that is not one of our own.
+ * Re-create it as a native Uri from its string form so that the code below
+ * can work on it.  On success *tmp holds the new object (to be released by
+ * the caller) when 'in' was foreign, and NULL when it already was native. */
+static Uri *get_uri_obj_or_copy(IUri *in, IUri **tmp)
+{
+    BSTR str = NULL;
+    HRESULT hres;
+    Uri *ret;
+
+    *tmp = NULL;
+    if((ret = get_uri_obj(in)))
+        return ret;
+#ifdef SG_MUTANT_FOREIGNURI
+    return NULL;
+#endif
+
+    hres = IUri_GetAbsoluteUri(in, &str);
+    if(SUCCEEDED(hres) && (!str || !*str)) {
+        SysFreeString(str);
+        str = NULL;
+        hres = IUri_GetRawUri(in, &str);
+    }
+    if(FAILED(hres) || !str)
+        return NULL;
+
+    hres = CreateUri(str, Uri_CREATE_ALLOW_RELATIVE, 0, tmp);
+    SysFreeString(str);
+    if(FAILED(hres)) {
+        *tmp = NULL;
+        return NULL;
+    }
+    return get_uri_obj(*tmp);
+}
