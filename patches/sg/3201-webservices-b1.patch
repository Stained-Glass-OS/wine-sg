+/* one child of a SOAP 1.2 Fault element, *handled is FALSE if it is not one that is known */
+static HRESULT read_fault_child_12( struct reader *reader, WS_HEAP *heap, WS_FAULT *fault, BOOL *handled )
+{
+    static const WS_XML_STRING code = {4, (BYTE *)"Code"}, reason = {6, (BYTE *)"Reason"};
+    static const WS_XML_STRING text = {4, (BYTE *)"Text"}, node = {4, (BYTE *)"Node"};
+    static const WS_XML_STRING role = {4, (BYTE *)"Role"}, detail = {6, (BYTE *)"Detail"};
+    static const WS_XML_STRING lang = {4, (BYTE *)"lang"};
+    static const WS_XML_STRING xml_ns = {36, (BYTE *)"http://www.w3.org/XML/1998/namespace"};
+    BOOL found;
+    HRESULT hr;
+
+    *handled = TRUE;
+    if (match_element( reader->current, &code, &soap12_ns ))
+    {
+        if (fault->code) return WS_E_INVALID_FORMAT;
+        if (!(fault->code = ws_alloc_zero( heap, sizeof(*fault->code) ))) return WS_E_QUOTA_EXCEEDED;
+        return read_fault_code_12( reader, heap, fault->code );
+    }
+    if (match_element( reader->current, &reason, &soap12_ns ))
+    {
+        const struct node *elem = reader->current;
+
+        if (fault->reasons) return WS_E_INVALID_FORMAT;
+        if ((hr = read_type_next_node( reader )) != S_OK) return hr;
+        for (;;)
+        {
+            WS_FAULT_REASON *new_reasons, *r;
+            const WS_XML_TEXT *attr;
+
+            if (node_type( reader->current ) == WS_XML_NODE_TYPE_END_ELEMENT && reader->current->parent == elem)
+                break;
+            if (!match_element( reader->current, &text, &soap12_ns ))
+            {
+                if ((hr = read_type_next_node( reader )) != S_OK) return hr;
+                continue;
+            }
+            if (!fault->reasons) new_reasons = ws_alloc_zero( heap, sizeof(*r) );
+            else new_reasons = ws_realloc_zero( heap, fault->reasons, fault->reasonCount * sizeof(*r),
+                                                (fault->reasonCount + 1) * sizeof(*r) );
+            if (!new_reasons) return WS_E_QUOTA_EXCEEDED;
+            fault->reasons = new_reasons;
+            r = &fault->reasons[fault->reasonCount++];
+            if ((hr = get_text( reader, WS_ATTRIBUTE_TYPE_MAPPING, &lang, &xml_ns, &attr, &found )) != S_OK)
+                return hr;
+#ifndef SG_MUTANT_WS2_FAULTLANG
+            if (found && (hr = text_to_string( attr, heap, &r->lang )) != S_OK) return hr;
+#endif
+            if ((hr = read_next_node( reader )) != S_OK) return hr;
+            if ((hr = read_type( reader, WS_ELEMENT_TYPE_MAPPING, WS_STRING_TYPE, NULL, NULL, NULL,
+                                 WS_READ_REQUIRED_VALUE, heap, &r->text, sizeof(r->text), &found )) != S_OK)
+                return hr;
+        }
+        return fault->reasonCount ? S_OK : WS_E_INVALID_FORMAT;
+    }
+    if (match_element( reader->current, &node, &soap12_ns ) || match_element( reader->current, &role, &soap12_ns ))
+    {
+        WS_STRING *str = match_element( reader->current, &node, &soap12_ns ) ? &fault->node : &fault->actor;
+        if (str->length) return WS_E_INVALID_FORMAT;
+        if ((hr = read_next_node( reader )) != S_OK) return hr;
+        return read_type( reader, WS_ELEMENT_TYPE_MAPPING, WS_STRING_TYPE, NULL, NULL, NULL,
+                          WS_READ_REQUIRED_VALUE, heap, str, sizeof(*str), &found );
+    }
+    if (match_element( reader->current, &detail, &soap12_ns ))
+    {
+        if (fault->detail) return WS_E_INVALID_FORMAT;
+        return WsReadXmlBuffer( (WS_XML_READER *)reader, heap, &fault->detail, NULL );
+    }
+    *handled = FALSE;
+    return S_OK;
+}
