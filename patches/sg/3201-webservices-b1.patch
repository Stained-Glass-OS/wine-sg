+/* the number of UTF-8 bytes of the lexical form of a text, -1 if it has none */
+static int lexical_length( const WS_XML_TEXT *text )
+{
+    WS_XML_UTF8_TEXT *utf8;
+    int len;
+
+    if (text_to_utf8text( text, NULL, NULL, &utf8 ) != S_OK) return -1;
+    len = utf8->value.length;
+    free( utf8 );
+    return len;
+}
+
+static enum record_type chars_record_type( int len, BOOL end )
+{
+    if (len < 0) return 0;
+    if (len <= MAX_UINT8) return end ? RECORD_CHARS8_TEXT_WITH_ENDELEMENT : RECORD_CHARS8_TEXT;
+    if (len <= MAX_UINT16) return end ? RECORD_CHARS16_TEXT_WITH_ENDELEMENT : RECORD_CHARS16_TEXT;
+    return end ? RECORD_CHARS32_TEXT_WITH_ENDELEMENT : RECORD_CHARS32_TEXT;
