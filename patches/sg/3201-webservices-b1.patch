+/* the error object keeps a copy of the buffer */
+static HRESULT set_header( struct error *error, WS_XML_BUFFER *value )
+{
+#ifdef SG_MUTANT_WS2_HDRPROP
+    return S_OK;
+#endif
+    const struct xmlbuf *src = (const struct xmlbuf *)value;
+    struct xmlbuf *copy = NULL;
+
+    if (src)
+    {
+        if (!(copy = alloc_xmlbuf( error->heap, src->bytes.length, src->encoding, src->charset, src->dict_static,
+                                   src->dict ))) return E_OUTOFMEMORY;
+        memcpy( copy->bytes.bytes, src->bytes.bytes, src->bytes.length );
+        copy->bytes.length = src->bytes.length;
+    }
+    free_xmlbuf( (struct xmlbuf *)error->header );
+    error->header = (WS_XML_BUFFER *)copy;
+    return S_OK;
+}
