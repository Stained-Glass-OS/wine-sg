+/* the children of a SOAP 1.2 Code or Subcode: Value and an optional Subcode */
+static HRESULT read_fault_code_12( struct reader *reader, WS_HEAP *heap, WS_FAULT_CODE *code )
+{
+    static const WS_XML_STRING value = {5, (BYTE *)"Value"}, subcode = {7, (BYTE *)"Subcode"};
+    const struct node *elem = reader->current;
+    BOOL found, have_value = FALSE;
+    HRESULT hr;
+
+    if ((hr = read_type_next_node( reader )) != S_OK) return hr;
+    for (;;)
+    {
+        if (node_type( reader->current ) == WS_XML_NODE_TYPE_END_ELEMENT && reader->current->parent == elem) break;
+
+        if (match_element( reader->current, &value, &soap12_ns ))
+        {
+            if (have_value) return WS_E_INVALID_FORMAT;
+            if ((hr = read_type( reader, WS_ELEMENT_TYPE_MAPPING, WS_XML_QNAME_TYPE, NULL, NULL, NULL,
+                                 WS_READ_REQUIRED_VALUE, heap, &code->value, sizeof(code->value), &found )) != S_OK)
+                return hr;
+            have_value = TRUE;
+        }
+        else if (match_element( reader->current, &subcode, &soap12_ns ))
+        {
+            if (code->subCode) return WS_E_INVALID_FORMAT;
+            if (!(code->subCode = ws_alloc_zero( heap, sizeof(*code->subCode) ))) return WS_E_QUOTA_EXCEEDED;
+            if ((hr = read_fault_code_12( reader, heap, code->subCode )) != S_OK) return hr;
+        }
+        else if ((hr = read_type_next_node( reader )) != S_OK) return hr;
+    }
+    return have_value ? S_OK : WS_E_INVALID_FORMAT;
+}
