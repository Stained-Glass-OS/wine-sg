+/* a decimal as a 160-bit integer (five 32-bit words, least significant first) */
+static void decimal_to_words( const DECIMAL *d, ULONG w[5] )
+{
+    ULONG carry, i, j;
+
+    w[0] = d->Lo32; w[1] = d->Mid32; w[2] = d->Hi32; w[3] = w[4] = 0;
+    /* scale up to 28 decimals so that values of different scales compare */
+    for (j = d->scale; j < 28; j++)
+    {
+        for (carry = 0, i = 0; i < 5; i++)
+        {
+            ULONGLONG v = (ULONGLONG)w[i] * 10 + carry;
+            w[i] = (ULONG)v;
+            carry = v >> 32;
+        }
+    }
+}
+
+int compare_decimal( const DECIMAL *a, const DECIMAL *b )
+{
+    ULONG wa[5], wb[5];
+    BOOL zero_a, zero_b, neg_a, neg_b;
+    int i;
+
+    decimal_to_words( a, wa );
+    decimal_to_words( b, wb );
+    zero_a = !(wa[0] | wa[1] | wa[2] | wa[3] | wa[4]);
+    zero_b = !(wb[0] | wb[1] | wb[2] | wb[3] | wb[4]);
+    neg_a = (a->sign & DECIMAL_NEG) && !zero_a;
+    neg_b = (b->sign & DECIMAL_NEG) && !zero_b;
+    if (neg_a != neg_b) return neg_a ? -1 : 1;
+    for (i = 4; i >= 0; i--)
+    {
+        if (wa[i] == wb[i]) continue;
+        if (wa[i] < wb[i]) return neg_a ? 1 : -1;
+        return neg_a ? -1 : 1;
+    }
+    return 0;
+}
+
+/* [-+]digits[.digits], at most 28 decimals and 96 bits */
+HRESULT str_to_decimal( const unsigned char *str, ULONG len, DECIMAL *ret )
+{
+    const unsigned char *end = str + len;
+    ULONG w[3] = {0, 0, 0}, i, ndigits = 0, scale = 0;
+    BOOL neg = FALSE, point = FALSE, trimmed_zero = FALSE;
+
+    while (str < end && read_isspace( *str )) str++;
+    while (end > str && read_isspace( end[-1] )) end--;
+    if (str < end && (*str == '-' || *str == '+')) neg = *str++ == '-';
+    if (str == end) return WS_E_INVALID_FORMAT;
+
+    for (; str < end; str++)
+    {
+        ULONGLONG carry;
+
+        if (*str == '.' && !point) { point = TRUE; continue; }
+        if (*str < '0' || *str > '9') return WS_E_INVALID_FORMAT;
+        ndigits++;
+        if (point && scale >= 28)
+        {
+            /* more decimals than a DECIMAL holds: the surplus must be zero */
+            if (*str != '0') return WS_E_NUMERIC_OVERFLOW;
+            continue;
+        }
+        carry = *str - '0';
+        for (i = 0; i < 3; i++)
+        {
+            ULONGLONG v = (ULONGLONG)w[i] * 10 + carry;
+            w[i] = (ULONG)v;
+            carry = v >> 32;
+        }
+        if (carry) return WS_E_NUMERIC_OVERFLOW;
+        if (point) scale++;
+    }
+    (void)trimmed_zero;
+    if (!ndigits) return WS_E_INVALID_FORMAT;
+    memset( ret, 0, sizeof(*ret) );
+    ret->scale = scale;
+    ret->sign  = neg ? DECIMAL_NEG : 0;
+    ret->Lo32 = w[0]; ret->Mid32 = w[1]; ret->Hi32 = w[2];
+    return S_OK;
+}
+
+static HRESULT text_to_decimal( const WS_XML_TEXT *text, DECIMAL *val )
+{
+    HRESULT hr;
+
+    switch (text->textType)
+    {
+    case WS_XML_TEXT_TYPE_UTF8:
+    {
+        const WS_XML_UTF8_TEXT *text_utf8 = (const WS_XML_UTF8_TEXT *)text;
+        return str_to_decimal( text_utf8->value.bytes, text_utf8->value.length, val );
+    }
+    case WS_XML_TEXT_TYPE_DECIMAL:
+    {
+        const WS_XML_DECIMAL_TEXT *text_decimal = (const WS_XML_DECIMAL_TEXT *)text;
+        *val = text_decimal->value;
+        return S_OK;
+    }
+    default:
+    {
+        WS_XML_UTF8_TEXT *utf8;
+#ifdef SG_MUTANT_WS2_CONV
         return E_NOTIMPL;
+#endif
+        if ((hr = text_to_utf8text( text, NULL, NULL, &utf8 )) != S_OK) return hr;
+        hr = text_to_decimal( &utf8->text, val );
+        free( utf8 );
+        return hr;
+    }
+    }
+}
+
+static HRESULT read_type_decimal( struct reader *reader, WS_TYPE_MAPPING mapping,
+                                  const WS_XML_STRING *localname, const WS_XML_STRING *ns,
+                                  const WS_DECIMAL_DESCRIPTION *desc, WS_READ_OPTION option,
+                                  WS_HEAP *heap, void *ret, ULONG size, BOOL *found )
+{
+    const WS_XML_TEXT *text;
+    HRESULT hr;
+    DECIMAL val;
+
+    memset( &val, 0, sizeof(val) );
+    if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
+    if (*found && (hr = text_to_decimal( text, &val )) != S_OK) return hr;
+#ifndef SG_MUTANT_WS2_DECRANGE
+    if (*found && desc && (compare_decimal( &val, &desc->minValue ) < 0 ||
+                           compare_decimal( &val, &desc->maxValue ) > 0)) return WS_E_INVALID_FORMAT;
+#endif
+
+    switch (option)
+    {
+    case WS_READ_REQUIRED_VALUE:
+        if (!*found) return WS_E_INVALID_FORMAT;
+        /* fall through */
+
+    case WS_READ_NILLABLE_VALUE:
+        if (size != sizeof(val)) return E_INVALIDARG;
+        *(DECIMAL *)ret = val;
+        break;
+
+    case WS_READ_REQUIRED_POINTER:
+        if (!*found) return WS_E_INVALID_FORMAT;
+        /* fall through */
+
+    case WS_READ_OPTIONAL_POINTER:
+    case WS_READ_NILLABLE_POINTER:
+    {
+        DECIMAL *heap_val = NULL;
+        if (size != sizeof(heap_val)) return E_INVALIDARG;
+        if (*found)
+        {
+            if (!(heap_val = ws_alloc( heap, sizeof(*heap_val) ))) return WS_E_QUOTA_EXCEEDED;
+            *heap_val = val;
+        }
+        *(DECIMAL **)ret = heap_val;
+        break;
+    }
+    default:
+        WARN( "invalid read option %u\n", option );
+        return E_INVALIDARG;
     }
 
     return S_OK;
 }
 
+/* a void value is read and thrown away */
+static HRESULT read_type_void( struct reader *reader, WS_TYPE_MAPPING mapping, const WS_XML_STRING *localname,
+                               const WS_XML_STRING *ns, BOOL *found )
+{
+    const WS_XML_TEXT *text;
+    HRESULT hr;
+
+    if (mapping == WS_ATTRIBUTE_TYPE_MAPPING) return get_text( reader, mapping, localname, ns, &text, found );
+
+    *found = TRUE;
+    if (mapping == WS_ELEMENT_TYPE_MAPPING && node_type( reader->current ) == WS_XML_NODE_TYPE_ELEMENT)
+    {
+        struct node *parent = find_parent( reader );
+        if (parent) parent->flags |= NODE_FLAG_IGNORE_TRAILING_ELEMENT_CONTENT;
+    }
+    (void)hr;
+    return S_OK;
+}
