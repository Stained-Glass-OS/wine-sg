+    if ((hr = WsWriteStartElement( writer, NULL, &value, &soap12_ns, NULL )) != S_OK) return hr;
+    if ((hr = WsWriteType( writer, WS_ELEMENT_CONTENT_TYPE_MAPPING, WS_XML_QNAME_TYPE, NULL, WS_WRITE_REQUIRED_VALUE,
+                           &code->value, sizeof(code->value), NULL )) != S_OK) return hr;
