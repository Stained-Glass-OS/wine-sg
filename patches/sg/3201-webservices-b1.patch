+/* Record a failure in the caller's error object, if any (guessed text: the native strings are not documented). */
+HRESULT set_error( WS_ERROR *handle, HRESULT hr )
+{
+    struct error *error = (struct error *)handle;
+    WCHAR buf[256];
+    WS_STRING str;
+    ULONG i, code = hr;
+
+    if (!error || hr >= 0) return hr;
+#ifdef SG_MUTANT_WS2_ERR
+    return hr;
+#endif
+
+    EnterCriticalSection( &error->cs );
+    if (error->magic != ERROR_MAGIC)
+    {
+        LeaveCriticalSection( &error->cs );
+        return hr;
+    }
+    prop_set( error->prop, error->prop_count, WS_ERROR_PROPERTY_ORIGINAL_ERROR_CODE, &code, sizeof(code) );
+    LeaveCriticalSection( &error->cs );
+
+    buf[0] = 0;
+    for (i = 0; i < ARRAY_SIZE(error_texts); i++)
+        if (error_texts[i].hr == hr) { lstrcpynW( buf, error_texts[i].text, ARRAY_SIZE(buf) ); break; }
+    if (!buf[0])
+    {
+        DWORD len = FormatMessageW( FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, NULL,
+                                    HRESULT_CODE(hr), 0, buf, ARRAY_SIZE(buf), NULL );
+        while (len && (buf[len - 1] == '\r' || buf[len - 1] == '\n' || buf[len - 1] == ' ')) buf[--len] = 0;
+        if (!len) swprintf( buf, ARRAY_SIZE(buf), L"The operation failed with error %#lx.", (ULONG)hr );
+    }
+    str.chars  = buf;
+    str.length = lstrlenW( buf );
+    WsAddErrorString( handle, &str );
+    return hr;
+}
