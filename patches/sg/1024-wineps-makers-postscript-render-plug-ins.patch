+
+/* the plug-in DLLs the driver's .ini names */
+static unsigned int plugin_files( HANDLE printer, WCHAR files[MAX_PLUGINS][MAX_PATH] )
+{
+    DRIVER_INFO_3W *info;
+    DWORD needed = 0;
+    unsigned int count = 0, i;
+    WCHAR *p;
+
+    GetPrinterDriverW( printer, NULL, 3, NULL, 0, &needed );
+    if (!needed || !(info = malloc( needed ))) return 0;
+    if (!GetPrinterDriverW( printer, NULL, 3, (BYTE *)info, needed, &needed )) needed = 0;
+    for (p = needed ? info->pDependentFiles : NULL; p && *p && !count; p += wcslen( p ) + 1)
+    {
+        const WCHAR *ext = wcsrchr( p, '.' );
+        WCHAR key[32], value[MAX_PATH], dir[MAX_PATH], *slash;
+
+        if (!ext || wcsicmp( ext, L".ini" )) continue;
+        lstrcpynW( dir, p, MAX_PATH );
+        if ((slash = wcsrchr( dir, '\\' ))) slash[1] = 0;
+        else dir[0] = 0;
+        for (i = 1; i <= MAX_PLUGINS; i++)
+        {
+            WCHAR *base;
+            swprintf( key, ARRAY_SIZE(key), L"OEMDriverFile%u", i );
+            if (!GetPrivateProfileStringW( L"OEMFiles", key, L"", value, MAX_PATH, p )) break;
+            base = wcsrchr( value, '\\' ) ? wcsrchr( value, '\\' ) + 1 : value;
+            swprintf( files[count++], MAX_PATH, L"%s%s", dir, base );
+        }
+    }
+    free( info );
+    return count;
+}
+
+static oem_ps *create_plugin( HMODULE module, BOOL *ps2 )
+{
+    HRESULT (WINAPI *get_class)( REFCLSID, REFIID, void ** );
+    IClassFactory *factory;
+    IUnknown *unk;
+    oem_ps *oem = NULL;
+
+    if (!(get_class = (void *)GetProcAddress( module, "DllGetClassObject" ))) return NULL;
+    if (FAILED(get_class( &clsid_oem_render, &IID_IClassFactory, (void **)&factory ))) return NULL;
+    if (SUCCEEDED(IClassFactory_CreateInstance( factory, NULL, &IID_IUnknown, (void **)&unk )))
+    {
+        *ps2 = SUCCEEDED(IUnknown_QueryInterface( unk, &iid_oem_ps2, (void **)&oem ));
+        if (!*ps2) IUnknown_QueryInterface( unk, &iid_oem_ps, (void **)&oem );
+        IUnknown_Release( unk );
+    }
+    IClassFactory_Release( factory );
+    return oem;
+}
+
+/* the job's plug-ins, made ready as the core does before a document */
+struct ps_plugins *ps_plugins_load( print_ctx *ctx, const WCHAR *printer_name, HANDLE port )
+{
+    WCHAR files[MAX_PLUGINS][MAX_PATH];
+    struct ps_plugins *pl;
+    unsigned int count, i;
+
+#ifdef SG_MUTANT_PSPLUGIN
+    return NULL;
+#endif
+    if (!ctx->pi->maker_driver) return NULL;
+    if (!(pl = calloc( 1, sizeof(*pl) ))) return NULL;
+    pl->magic = PLUGINS_MAGIC;
+    pl->ctx = ctx;
+    if (!OpenPrinterW( (WCHAR *)printer_name, &pl->printer, NULL ) ||
+        !(count = plugin_files( pl->printer, files )))
+    {
+        if (pl->printer) ClosePrinter( pl->printer );
+        free( pl );
+        return NULL;
+    }
+    /* what a plug-in writes to its printer handle is the job's data */
+    __wine_set_printer_output( pl->printer, port, NULL );
+    pl->devobj.size = sizeof(pl->devobj);
+    pl->devobj.printer = pl->printer;
+#ifndef SG_MUTANT_PSPROCS
+    pl->devobj.procs = &ps_procs;
+#endif
+    pl->devobj.public_dm = &ctx->Devmode->dmPublic;
+    pl->devobj.engine = ctx->hdc;
+
+    for (i = 0; i < count; i++)
+    {
+        struct ps_plugin *p = &pl->plugin[pl->count];
+        DRVENABLEDATA ded;
+        GDIINFO gi;
+        DEVINFO di;
+        DWORD sig = 0, size = 0, written = 0;
+        sg_oemdmparam param;
+        void *oem_pdev = NULL;
+        HRESULT hr;
+
+        if (!(p->module = LoadLibraryW( files[i] )))
+        {
+            WARN( "cannot load %s (a plug-in for another architecture?)\n", debugstr_w(files[i]) );
+            continue;
+        }
+        if (!(p->oem = create_plugin( p->module, &p->ps2 )))
+        {
+            WARN( "%s: no PostScript render interface\n", debugstr_w(files[i]) );
+            FreeLibrary( p->module );
+            continue;
+        }
+        p->oem->lpVtbl->GetInfo( p->oem, OEMGI_SIGNATURE, &sig, sizeof(sig), &size );
+        p->oem->lpVtbl->PublishDriverInterface( p->oem, (IUnknown *)&helper );
+        memset( &ded, 0, sizeof(ded) );
+        p->oem->lpVtbl->EnableDriver( p->oem, OEM_INTF_VERSION, sizeof(ded), &ded );
+
+        /* its part of the devmode, at its defaults */
+        memset( &param, 0, sizeof(param) );
+        param.size = sizeof(param);
+        param.driver_obj = &pl->devobj;
+        param.printer = pl->printer;
+        param.oem_module = p->module;
+        param.public_in = param.public_out = &ctx->Devmode->dmPublic;
+        if (SUCCEEDED(p->oem->lpVtbl->DevMode( p->oem, OEMDM_SIZE, &param )) && param.out_size &&
+            (p->dm_part = calloc( 1, param.out_size )))
+        {
+            p->dm_size = param.out_size;
+            param.oem_out = p->dm_part;
+            p->oem->lpVtbl->DevMode( p->oem, OEMDM_DEFAULT, &param );
+        }
+        pl->devobj.oem_dm = p->dm_part;
+
+        memset( &gi, 0, sizeof(gi) );
+        memset( &di, 0, sizeof(di) );
+        gi.ulVersion = 0x5000;
+        gi.ulTechnology = DT_RASPRINTER;
+        gi.ulLogPixelsX = GetDeviceCaps( ctx->hdc, LOGPIXELSX );
+        gi.ulLogPixelsY = GetDeviceCaps( ctx->hdc, LOGPIXELSY );
+        gi.ulHorzRes = GetDeviceCaps( ctx->hdc, HORZRES );
+        gi.ulVertRes = GetDeviceCaps( ctx->hdc, VERTRES );
+        gi.szlPhysSize.cx = GetDeviceCaps( ctx->hdc, PHYSICALWIDTH );
+        gi.szlPhysSize.cy = GetDeviceCaps( ctx->hdc, PHYSICALHEIGHT );
+        gi.ptlPhysOffset.x = GetDeviceCaps( ctx->hdc, PHYSICALOFFSETX );
+        gi.ptlPhysOffset.y = GetDeviceCaps( ctx->hdc, PHYSICALOFFSETY );
+        hr = p->oem->lpVtbl->EnablePDEV( p->oem, &pl->devobj, (WCHAR *)printer_name, 0, NULL, sizeof(gi), &gi,
+                                         sizeof(di), &di, &ded, &oem_pdev );
+        if (FAILED(hr))
+        {
+            WARN( "%s: EnablePDEV %#lx\n", debugstr_w(files[i]), hr );
+            p->oem->lpVtbl->DisableDriver( p->oem );
+            p->oem->lpVtbl->Release( p->oem );
+            FreeLibrary( p->module );
+            free( p->dm_part );
+            continue;
+        }
+        pl->devobj.oem_pdev = oem_pdev;
+#ifndef SG_MUTANT_PSWRITE
+        /* a plug-in whose WritePrinter answers a call without data sees
+         * the whole job */
+        if (p->ps2 && p->oem->lpVtbl->WritePrinter( p->oem, &pl->devobj, NULL, 0, &written ) == S_OK)
+            p->write_hook = TRUE;
+#endif
+        TRACE( "%s: plug-in %08lx, PS2 %d, WritePrinter %d, devmode part %lu\n", debugstr_w(files[i]), sig,
+               p->ps2, p->write_hook, p->dm_size );
+        pl->count++;
+    }
+    if (!pl->count)
+    {
+        ps_plugins_free( pl );
+        return NULL;
+    }
+    return pl;
+}
+
+void ps_plugins_free( struct ps_plugins *pl )
+{
+    unsigned int i;
+
+    if (!pl) return;
+    for (i = 0; i < pl->count; i++)
+    {
+        struct ps_plugin *p = &pl->plugin[i];
+        pl->devobj.oem_dm = p->dm_part;
+        p->oem->lpVtbl->DisablePDEV( p->oem, &pl->devobj );
+        p->oem->lpVtbl->DisableDriver( p->oem );
+        p->oem->lpVtbl->Release( p->oem );
+        FreeLibrary( p->module );
+        free( p->dm_part );
+    }
+    __wine_set_printer_output( pl->printer, NULL, NULL );
+    ClosePrinter( pl->printer );
+    pl->magic = 0;
+    free( pl );
+}
+
+/* an injection point of the job: each plug-in may add its code there */
+void ps_plugins_inject( print_ctx *ctx, DWORD index )
+{
+    struct ps_plugins *pl = ctx->plugins;
+    unsigned int i;
+
+#ifdef SG_MUTANT_PSINJECT
+    return;
+#endif
+    if (!pl) return;
+    for (i = 0; i < pl->count; i++)
+    {
+        DWORD result = 0;
+        pl->devobj.oem_dm = pl->plugin[i].dm_part;
+        pl->plugin[i].oem->lpVtbl->Command( pl->plugin[i].oem, &pl->devobj, index, NULL, 0, &result );
+    }
+}
+
+/* the job's data on its way out: through a plug-in that asked to see it */
+BOOL ps_plugins_write( print_ctx *ctx, const void *data, DWORD size, DWORD *written )
+{
+    struct ps_plugins *pl = ctx->plugins;
+    unsigned int i;
+
+    if (!pl || pl->in_hook) return FALSE;
+    for (i = 0; i < pl->count; i++)
+    {
+        HRESULT hr;
+        if (!pl->plugin[i].write_hook) continue;
+        pl->in_hook = TRUE;
+        pl->devobj.oem_dm = pl->plugin[i].dm_part;
+        hr = pl->plugin[i].oem->lpVtbl->WritePrinter( pl->plugin[i].oem, &pl->devobj, (void *)data, size, written );
+        pl->in_hook = FALSE;
+        if (FAILED(hr)) *written = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
