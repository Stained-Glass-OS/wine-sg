+/*
+ * A maker's PostScript driver may add a render plug-in (its .ini's
+ * [OEMFiles] OEMDriverFile1, OEMDriverFile2...): a COM object with the
+ * documented IPrintOemPS interface.  We create it as the PostScript core
+ * does, hand it our helper (IPrintOemDriverPS: the PPD's chosen options
+ * and a way to write into the job), and call it at the injection points of
+ * the job (PSINJECT_*: the start of the stream, the prolog, the setup,
+ * each page's setup, the trailer, the end), where it adds the PostScript
+ * or PJL it needs (job accounting, finishing, user codes).  A plug-in with
+ * IPrintOemPS2::WritePrinter sees all the job's data on its way out.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winspool.h"
+#include "objbase.h"
+#include "ddk/winddi.h"
+#include "psdrv.h"
+#include "wine/printdrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(psdrv);
+
+/* the interface ids, from the plug-in interface's public declaration */
+static const GUID clsid_oem_render = { 0x6d6abf26, 0x9f38, 0x11d1, { 0x88, 0x2a, 0x00, 0xc0, 0x4f, 0xb9, 0x61, 0xec } };
+static const GUID iid_oem_ps = { 0x688342b5, 0x8e1a, 0x11d1, { 0x88, 0x1f, 0x00, 0xc0, 0x4f, 0xb9, 0x61, 0xec } };
+static const GUID iid_oem_ps2 = { 0xbecf7f34, 0x51b3, 0x46c9, { 0x8a, 0x1c, 0x18, 0x67, 0x9b, 0xd2, 0x1f, 0x36 } };
+static const GUID iid_driver_ps = { 0xd90060c7, 0x8e1a, 0x11d1, { 0x88, 0x1f, 0x00, 0xc0, 0x4f, 0xb9, 0x61, 0xec } };
+static const GUID iid_core_ps2 = { 0xcdbb0b0b, 0xa917, 0x40d7, { 0x9f, 0xbf, 0x48, 0x3b, 0x3b, 0xe7, 0xef, 0x22 } };
+
+/* attribute data types */
+enum { ADT_UNKNOWN, ADT_BOOL, ADT_INT, ADT_LONG, ADT_DWORD, ADT_ASCII, ADT_UNICODE, ADT_BINARY };
+
+#define OEMGI_SIGNATURE 1
+#define OEMDM_SIZE      1
+#define OEMDM_DEFAULT   2
+#define OEM_INTF_VERSION 0x00010000
+
+typedef struct oem_ps oem_ps;
+typedef struct
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( oem_ps *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( oem_ps * );
+    ULONG   (STDMETHODCALLTYPE *Release)( oem_ps * );
+    HRESULT (STDMETHODCALLTYPE *GetInfo)( oem_ps *, DWORD, void *, DWORD, DWORD * );
+    HRESULT (STDMETHODCALLTYPE *DevMode)( oem_ps *, DWORD, sg_oemdmparam * );
+    HRESULT (STDMETHODCALLTYPE *EnableDriver)( oem_ps *, DWORD, DWORD, DRVENABLEDATA * );
+    HRESULT (STDMETHODCALLTYPE *DisableDriver)( oem_ps * );
+    HRESULT (STDMETHODCALLTYPE *EnablePDEV)( oem_ps *, sg_devobj *, WCHAR *, ULONG, HSURF *, ULONG, GDIINFO *, ULONG,
+                                             DEVINFO *, DRVENABLEDATA *, void ** );
+    HRESULT (STDMETHODCALLTYPE *DisablePDEV)( oem_ps *, sg_devobj * );
+    HRESULT (STDMETHODCALLTYPE *ResetPDEV)( oem_ps *, sg_devobj *, sg_devobj * );
+    HRESULT (STDMETHODCALLTYPE *PublishDriverInterface)( oem_ps *, IUnknown * );
+    HRESULT (STDMETHODCALLTYPE *Command)( oem_ps *, sg_devobj *, DWORD, void *, DWORD, DWORD * );
+    /* IPrintOemPS2 */
+    HRESULT (STDMETHODCALLTYPE *WritePrinter)( oem_ps *, sg_devobj *, void *, DWORD, DWORD * );
+    HRESULT (STDMETHODCALLTYPE *GetPDEVAdjustment)( oem_ps *, sg_devobj *, DWORD, void *, DWORD, BOOL * );
+} oem_ps_vtbl;
+struct oem_ps { const oem_ps_vtbl *lpVtbl; };
+
+/* our helper, handed to the plug-ins */
+typedef struct driver_ps driver_ps;
+typedef struct
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( driver_ps *, REFIID, void ** );
+    ULONG   (STDMETHODCALLTYPE *AddRef)( driver_ps * );
+    ULONG   (STDMETHODCALLTYPE *Release)( driver_ps * );
+    HRESULT (STDMETHODCALLTYPE *DrvGetDriverSetting)( driver_ps *, void *, const char *, void *, DWORD, DWORD *,
+                                                      DWORD * );
+    HRESULT (STDMETHODCALLTYPE *DrvWriteSpoolBuf)( driver_ps *, sg_devobj *, void *, DWORD, DWORD * );
+} driver_ps_vtbl;
+struct driver_ps { const driver_ps_vtbl *lpVtbl; };
+
+#define MAX_PLUGINS 8
+
+struct ps_plugin
+{
+    HMODULE  module;
+    oem_ps  *oem;
+    BOOL     ps2, write_hook;
+    BYTE    *dm_part;
+    DWORD    dm_size;
+};
+
+/* a job's plug-ins: the device object they see is ours */
+struct ps_plugins
+{
+    sg_devobj         devobj;     /* first: the plug-ins' pdevobj */
+    DWORD             magic;
+    print_ctx        *ctx;
+    HANDLE            printer;    /* the printer handle they are given; writes go to the port */
+    unsigned int      count;
+    struct ps_plugin  plugin[MAX_PLUGINS];
+    BOOL              in_hook;    /* the plug-in's WritePrinter is writing */
+};
+
+#define PLUGINS_MAGIC 0x50454f53
+
+static struct ps_plugins *from_devobj( void *obj )
+{
+    struct ps_plugins *pl = obj;
+    return pl && pl->magic == PLUGINS_MAGIC ? pl : NULL;
+}
+
+static void *core_ps2_object( void );
+
+static HRESULT STDMETHODCALLTYPE helper_QueryInterface( driver_ps *iface, REFIID riid, void **out )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &iid_driver_ps ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+#ifndef SG_MUTANT_COREPS2
+    if (IsEqualGUID( riid, &iid_core_ps2 ))
+    {
+        *out = core_ps2_object();
+        return S_OK;
+    }
+#endif
+    TRACE( "no %s\n", debugstr_guid(riid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE helper_AddRef( driver_ps *iface ) { return 2; }
+static ULONG STDMETHODCALLTYPE helper_Release( driver_ps *iface ) { return 1; }
+
+/* the option chosen for one of the PPD's features */
+static const char *chosen_option( struct ps_plugins *pl, const char *feature )
+{
+    PPD_FEATURE *f;
+    int cur;
+
+    if ((f = ppd_find_feature( pl->ctx->pi->ppd, feature )))
+        return (cur = features_selected( pl->ctx->pi, pl->ctx->Devmode, f )) >= 0 ? f->options[cur].name : NULL;
+    if (!strcmp( feature, "PageSize" ) || !strcmp( feature, "PageRegion" ))
+    {
+        PAGESIZE *page = find_pagesize( pl->ctx->pi->ppd, &pl->ctx->Devmode->dmPublic );
+        return page ? page->Name : NULL;
+    }
+    if (!strcmp( feature, "InputSlot" ))
+    {
+        INPUTSLOT *slot = find_slot( pl->ctx->pi->ppd, &pl->ctx->Devmode->dmPublic );
+        return slot ? slot->Name : NULL;
+    }
+    if (!strcmp( feature, "Duplex" ))
+    {
+        DUPLEX *duplex = find_duplex( pl->ctx->pi->ppd, &pl->ctx->Devmode->dmPublic );
+        return duplex ? duplex->Name : NULL;
+    }
+    return NULL;
+}
+
+/* the option chosen for a PPD feature, as a list of one */
+static HRESULT STDMETHODCALLTYPE helper_DrvGetDriverSetting( driver_ps *iface, void *obj, const char *feature,
+                                                             void *out, DWORD size, DWORD *needed, DWORD *count )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    const char *value;
+    DWORD len;
+
+    if (!pl || !feature) return E_INVALIDARG;
+    if (!((ULONG_PTR)feature >> 16)) return E_NOTIMPL;  /* the numbered settings */
+    value = chosen_option( pl, feature );
+    TRACE( "%s = %s\n", debugstr_a(feature), debugstr_a(value) );
+    if (!value) return E_INVALIDARG;
+    len = strlen( value ) + 2;
+    if (needed) *needed = len;
+    if (count) *count = 1;
+    if (!out || size < len) return E_OUTOFMEMORY;
+    memset( out, 0, len );
+    strcpy( out, value );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE helper_DrvWriteSpoolBuf( driver_ps *iface, sg_devobj *obj, void *buf, DWORD size,
+                                                          DWORD *written )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    DWORD done;
+
+    if (!pl) return E_INVALIDARG;
+    done = write_spool( pl->ctx, buf, size );
+    if (written) *written = done == size ? size : 0;
+    return done == size ? S_OK : E_FAIL;
+}
+
+static const driver_ps_vtbl helper_vtbl =
+{
+    helper_QueryInterface, helper_AddRef, helper_Release, helper_DrvGetDriverSetting, helper_DrvWriteSpoolBuf,
+};
+static driver_ps helper = { &helper_vtbl };
+
+/* ---- IPrintCorePS2: the PPD's features and options for a plug-in ---- */
+
+typedef struct core_ps2 core_ps2;
+struct core_ps2 { const void *lpVtbl; };
+
+static HRESULT STDMETHODCALLTYPE ps2_QueryInterface( core_ps2 *iface, REFIID riid, void **out )
+{
+    return helper_QueryInterface( &helper, riid, out );
+}
+static ULONG STDMETHODCALLTYPE ps2_AddRef( core_ps2 *iface ) { return 2; }
+static ULONG STDMETHODCALLTYPE ps2_Release( core_ps2 *iface ) { return 1; }
+
+static HRESULT STDMETHODCALLTYPE ps2_DrvWriteSpoolBuf( core_ps2 *iface, sg_devobj *obj, void *buf, DWORD size,
+                                                       DWORD *written )
+{
+    return helper_DrvWriteSpoolBuf( &helper, obj, buf, size, written );
+}
+
+/* appends a string to a list of strings (doubly terminated) */
+static void mstr_add( char *buf, DWORD size, DWORD *used, const char *str )
+{
+    DWORD len = strlen( str ) + 1;
+    if (buf && *used + len < size) memcpy( buf + *used, str, len );
+    *used += len;
+}
+
+static HRESULT mstr_done( char *buf, DWORD size, DWORD used, DWORD *needed )
+{
+    *needed = used + 1;
+    if (!buf || size < used + 1) return E_OUTOFMEMORY;
+    buf[used] = 0;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE ps2_GetOptions( core_ps2 *iface, sg_devobj *obj, DWORD flags, const char *wanted,
+                                                 DWORD in_size, char *buf, DWORD size, DWORD *needed )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    PPD_FEATURE *f;
+    DWORD used = 0;
+
+    if (!pl || !needed) return E_INVALIDARG;
+    if (wanted)
+    {
+        const char *p;
+        for (p = wanted; *p; p += strlen( p ) + 1)
+        {
+            const char *opt = chosen_option( pl, p );
+            mstr_add( buf, size, &used, p );
+            mstr_add( buf, size, &used, opt ? opt : "" );
+        }
+    }
+    else
+    {
+        static const char *builtin[] = { "PageSize", "PageRegion", "InputSlot", "Duplex" };
+        const char *opt;
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(builtin); i++)
+        {
+            if (!(opt = chosen_option( pl, builtin[i] ))) continue;
+            mstr_add( buf, size, &used, builtin[i] );
+            mstr_add( buf, size, &used, opt );
+        }
+        LIST_FOR_EACH_ENTRY( f, &pl->ctx->pi->ppd->Features, PPD_FEATURE, entry )
+        {
+            if (!(opt = chosen_option( pl, f->keyword ))) continue;
+            mstr_add( buf, size, &used, f->keyword );
+            mstr_add( buf, size, &used, opt );
+        }
+    }
+    return mstr_done( buf, size, used, needed );
+}
+
+static HRESULT put_attr( DWORD type, const void *data, DWORD len, DWORD *data_type, BYTE *buf, DWORD size, DWORD *needed )
+{
+    *data_type = type;
+    *needed = len;
+    if (!buf || size < len) return E_OUTOFMEMORY;
+    memcpy( buf, data, len );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE ps2_GetGlobalAttribute( core_ps2 *iface, sg_devobj *obj, DWORD flags,
+                                                         const char *attr, DWORD *type, BYTE *buf, DWORD size,
+                                                         DWORD *needed )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    PPD *ppd;
+    INT i;
+    BOOL b;
+
+    if (!pl || !type || !needed) return E_INVALIDARG;
+    ppd = pl->ctx->pi->ppd;
+    if (!attr) return put_attr( ADT_ASCII, "LanguageLevel\0ColorDevice\0NickName\0\0", 37, type, buf, size, needed );
+    if (!strcmp( attr, "LanguageLevel" )) { i = ppd->LanguageLevel; return put_attr( ADT_INT, &i, sizeof(i), type, buf, size, needed ); }
+    if (!strcmp( attr, "ColorDevice" )) { b = ppd->ColorDevice != CD_False; return put_attr( ADT_BOOL, &b, sizeof(b), type, buf, size, needed ); }
+    if (!strcmp( attr, "NickName" ) && ppd->NickName)
+        return put_attr( ADT_ASCII, ppd->NickName, strlen( ppd->NickName ) + 1, type, buf, size, needed );
+    TRACE( "%s\n", debugstr_a(attr) );
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE ps2_GetFeatureAttribute( core_ps2 *iface, sg_devobj *obj, DWORD flags,
+                                                          const char *keyword, const char *attr, DWORD *type,
+                                                          BYTE *buf, DWORD size, DWORD *needed )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    PPD_FEATURE *f;
+
+    if (!pl || !keyword || !type || !needed) return E_INVALIDARG;
+    if (!(f = ppd_find_feature( pl->ctx->pi->ppd, keyword ))) return E_INVALIDARG;
+    if (!attr) return put_attr( ADT_ASCII, "DisplayName\0DefaultOption\0\0", 27, type, buf, size, needed );
+    if (!strcmp( attr, "DisplayName" ))
+        return put_attr( ADT_UNICODE, f->text, (wcslen( f->text ) + 1) * sizeof(WCHAR), type, buf, size, needed );
+    if (!strcmp( attr, "DefaultOption" ) && f->default_option)
+        return put_attr( ADT_ASCII, f->default_option, strlen( f->default_option ) + 1, type, buf, size, needed );
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE ps2_GetOptionAttribute( core_ps2 *iface, sg_devobj *obj, DWORD flags,
+                                                         const char *keyword, const char *option, const char *attr,
+                                                         DWORD *type, BYTE *buf, DWORD size, DWORD *needed )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    PPD_FEATURE *f;
+    int i;
+
+    if (!pl || !keyword || !option || !type || !needed) return E_INVALIDARG;
+    if (!(f = ppd_find_feature( pl->ctx->pi->ppd, keyword )) || (i = ppd_feature_option( f, option )) < 0)
+        return E_INVALIDARG;
+    if (!attr) return put_attr( ADT_ASCII, "DisplayName\0Invocation\0\0", 24, type, buf, size, needed );
+    if (!strcmp( attr, "DisplayName" ))
+        return put_attr( ADT_UNICODE, f->options[i].text, (wcslen( f->options[i].text ) + 1) * sizeof(WCHAR), type,
+                         buf, size, needed );
+    if (!strcmp( attr, "Invocation" ))
+        return put_attr( ADT_BINARY, f->options[i].invocation, strlen( f->options[i].invocation ), type, buf,
+                         size, needed );
+    return E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE ps2_EnumFeatures( core_ps2 *iface, sg_devobj *obj, DWORD flags, char *buf,
+                                                   DWORD size, DWORD *needed )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    PPD_FEATURE *f;
+    DWORD used = 0;
+    PPD *ppd;
+
+    if (!pl || !needed) return E_INVALIDARG;
+    ppd = pl->ctx->pi->ppd;
+#ifndef SG_MUTANT_BUILTINFEATURES
+    /* the features wineps handles itself are the PPD's too */
+    if (!list_empty( &ppd->PageSizes ))
+    {
+        mstr_add( buf, size, &used, "PageSize" );
+        mstr_add( buf, size, &used, "PageRegion" );
+    }
+    if (!list_empty( &ppd->InputSlots )) mstr_add( buf, size, &used, "InputSlot" );
+    if (!list_empty( &ppd->Duplexes )) mstr_add( buf, size, &used, "Duplex" );
+#endif
+    LIST_FOR_EACH_ENTRY( f, &ppd->Features, PPD_FEATURE, entry ) mstr_add( buf, size, &used, f->keyword );
+    return mstr_done( buf, size, used, needed );
+}
+
+static HRESULT STDMETHODCALLTYPE ps2_EnumOptions( core_ps2 *iface, sg_devobj *obj, DWORD flags, const char *keyword,
+                                                  char *buf, DWORD size, DWORD *needed )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    PPD_FEATURE *f;
+    DWORD used = 0;
+    int i;
+
+    if (!pl || !keyword || !needed) return E_INVALIDARG;
+    if (!strcmp( keyword, "PageSize" ) || !strcmp( keyword, "PageRegion" ))
+    {
+        PAGESIZE *page;
+        LIST_FOR_EACH_ENTRY( page, &pl->ctx->pi->ppd->PageSizes, PAGESIZE, entry ) mstr_add( buf, size, &used, page->Name );
+        return mstr_done( buf, size, used, needed );
+    }
+    if (!strcmp( keyword, "InputSlot" ))
+    {
+        INPUTSLOT *slot;
+        LIST_FOR_EACH_ENTRY( slot, &pl->ctx->pi->ppd->InputSlots, INPUTSLOT, entry ) mstr_add( buf, size, &used, slot->Name );
+        return mstr_done( buf, size, used, needed );
+    }
+    if (!strcmp( keyword, "Duplex" ))
+    {
+        DUPLEX *duplex;
+        LIST_FOR_EACH_ENTRY( duplex, &pl->ctx->pi->ppd->Duplexes, DUPLEX, entry ) mstr_add( buf, size, &used, duplex->Name );
+        return mstr_done( buf, size, used, needed );
+    }
+    if (!(f = ppd_find_feature( pl->ctx->pi->ppd, keyword ))) return E_INVALIDARG;
+    for (i = 0; i < f->count; i++) mstr_add( buf, size, &used, f->options[i].name );
+    return mstr_done( buf, size, used, needed );
+}
+
+static const void *core_ps2_vtbl[] =
+{
+    ps2_QueryInterface, ps2_AddRef, ps2_Release, ps2_DrvWriteSpoolBuf, ps2_GetOptions, ps2_GetGlobalAttribute,
+    ps2_GetFeatureAttribute, ps2_GetOptionAttribute, ps2_EnumFeatures, ps2_EnumOptions,
+};
+static core_ps2 the_core_ps2 = { core_ps2_vtbl };
+
+static void *core_ps2_object( void )
+{
+    return &the_core_ps2;
+}
+
+/* the older function table some plug-ins write through (DEVOBJ.pDrvProcs) */
+static DWORD WINAPI procs_write( sg_devobj *obj, void *buf, DWORD size )
+{
+    struct ps_plugins *pl = from_devobj( obj );
+    return pl ? write_spool( pl->ctx, buf, size ) : 0;
+}
+
+static INT WINAPI procs_move( sg_devobj *obj, INT pos, DWORD flags ) { return 0; }
+
+static BOOL WINAPI procs_setting( void *obj, const char *feature, void *out, DWORD size, DWORD *needed, DWORD *count )
+{
+    return SUCCEEDED(helper_DrvGetDriverSetting( &helper, obj, feature, out, size, needed, count ));
+}
+
