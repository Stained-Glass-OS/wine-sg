From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] secur32: schannel honours the protocols SCH_CREDENTIALS' TLS parameters disable

SCH_CREDENTIALS carries TLS_PARAMETERS whose grbitDisabledProtocols turn protocols off; schannel ignored them with a FIXME and offered every default protocol. Qt's TLS backend asks this way. The protocols disabled by parameters that apply to every connection (no ALPN IDs) are now taken out of the defaults; with none left the credentials fail with SEC_E_ALGORITHM_MISMATCH as before.
---
--- a/dlls/secur32/schannel.c
+++ b/dlls/secur32/schannel.c
@@ -489,8 +489,10 @@
         return cred_old->grbitEnabledProtocols;
 
     case SCH_CREDENTIALS_VERSION:
+#ifdef SG_MUTANT_TLS_PARAMS_IGNORED
         if (cred->cTlsParameters) FIXME("handle TLS parameters\n");
-        return 0;
+#endif
+        return 0;   /* the defaults, less what its TLS parameters disable (get_disabled_protocols) */
 
     default:
         FIXME("unhandled version %lu\n", cred->dwVersion);
@@ -498,6 +500,31 @@
     }
 }
 
+/* (wine-sg 8295) SCH_CREDENTIALS: the protocols its TLS parameters disable.  Parameters that name ALPN
+ * IDs apply only when that protocol is negotiated, which is not chosen here: they are left out. */
+static DWORD get_disabled_protocols(const void *credentials)
+{
+    const SCH_CREDENTIALS *cred = credentials;
+    DWORD i, disabled = 0;
+
+#ifdef SG_MUTANT_TLS_PARAMS_IGNORED
+    return 0;
+#endif
+    if (cred->dwVersion != SCH_CREDENTIALS_VERSION || !cred->pTlsParameters) return 0;
+    for (i = 0; i < cred->cTlsParameters; i++)
+    {
+        if (cred->pTlsParameters[i].cAlpnIds)
+        {
+            TRACE("TLS parameters %lu are for %lu ALPN IDs, not applied\n", i, cred->pTlsParameters[i].cAlpnIds);
+            continue;
+        }
+        if (cred->pTlsParameters[i].cDisabledCrypto)
+            FIXME("TLS parameters %lu: %lu disabled crypto settings not applied\n", i, cred->pTlsParameters[i].cDisabledCrypto);
+        disabled |= cred->pTlsParameters[i].grbitDisabledProtocols;
+    }
+    return disabled;
+}
+
 static WCHAR *get_key_container_path(const CERT_CONTEXT *ctx)
 {
     CERT_KEY_CONTEXT keyctx;
@@ -640,6 +667,7 @@
         enabled_protocols = cred_enabled_protocols & config_enabled_protocols;
     else
         enabled_protocols = config_enabled_protocols & ~config_default_disabled_protocols;
+    if (schanCred) enabled_protocols &= ~get_disabled_protocols(schanCred);
     if (!(fCredentialUse & SECPKG_CRED_OUTBOUND))
         enabled_protocols &= ~SP_PROT_X_CLIENTS;
     if (!(fCredentialUse & SECPKG_CRED_INBOUND))
