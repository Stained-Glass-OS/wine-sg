From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rpcss, rpcrt4: endpoint map inquiries (ept_lookup, RpcMgmtEpEltInq*)

ept_lookup and ept_lookup_handle_free were stubs, and RpcMgmtEpEltInqBegin
failed every call (Next/Done were missing). rpcss now answers ept_lookup per
MS-RPCE: all elements, by interface (with the five version options), by
object or by both, in batches through a context-handle cursor; no match is
EPT_S_NOT_REGISTERED. rpcrt4 gets RpcMgmtEpEltInqBegin/NextA/NextW/Done on
top of it; a NULL binding inquires the local endpoint mapper.
ept_inq_object and ept_mgmt_delete stay as they are: MS-RPCE removed both.

Rebased at integration (integ-2026-10) onto earlier integration patches: clean 3-way merge.
---
diff --git a/dlls/rpcrt4/rpc_epmap.c b/dlls/rpcrt4/rpc_epmap.c
--- a/dlls/rpcrt4/rpc_epmap.c
+++ b/dlls/rpcrt4/rpc_epmap.c
@@ -517,6 +517,215 @@ RPC_STATUS WINAPI RpcEpResolveBinding( RPC_BINDING_HANDLE Binding, RPC_IF_HANDLE
   return EPT_S_NOT_REGISTERED;
 }
 
+#define EP_INQ_BATCH 8
+
+struct ep_inquiry
+{
+    handle_t epm;
+    ept_lookup_handle_t context;
+    ULONG type, vers_option;
+    RPC_IF_ID ifid;
+    UUID object;
+    ept_entry_t entries[EP_INQ_BATCH];
+    unsigned32 count, pos;
+    BOOL done;
+};
+
+static void free_inquiry_entries(struct ep_inquiry *inq)
+{
+    for (; inq->pos < inq->count; inq->pos++) I_RpcFree(inq->entries[inq->pos].tower);
+    inq->count = inq->pos = 0;
+}
+
+/***********************************************************************
+ *             RpcMgmtEpEltInqBegin (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcMgmtEpEltInqBegin(RPC_BINDING_HANDLE Binding, ULONG InquiryType,
+    RPC_IF_ID *IfId, ULONG VersOption, UUID *ObjectUuid, RPC_EP_INQ_HANDLE *InquiryContext)
+{
+    struct ep_inquiry *inq;
+    RPC_BINDING_HANDLE local = NULL;
+    RPC_STATUS status;
+
+    TRACE("(%p,%lu,%p,%lu,%p,%p)\n", Binding, InquiryType, IfId, VersOption, ObjectUuid, InquiryContext);
+
+    if (!InquiryContext || InquiryType > RPC_C_EP_MATCH_BY_BOTH) return RPC_S_INVALID_ARG;
+    if ((InquiryType == RPC_C_EP_MATCH_BY_IF || InquiryType == RPC_C_EP_MATCH_BY_BOTH) &&
+        (!IfId || VersOption < RPC_C_VERS_ALL || VersOption > RPC_C_VERS_UPTO))
+        return RPC_S_INVALID_ARG;
+
+    if (!Binding)
+    {
+        /* a NULL binding is the local endpoint mapper */
+        status = RpcBindingFromStringBindingA((RPC_CSTR)"ncalrpc:", &local);
+        if (status != RPC_S_OK) return status;
+        Binding = local;
+    }
+
+    if (!(inq = calloc(1, sizeof(*inq))))
+    {
+        if (local) RpcBindingFree(&local);
+        return RPC_S_OUT_OF_MEMORY;
+    }
+    status = get_epm_handle_client(Binding, &inq->epm);
+    if (local) RpcBindingFree(&local);
+    if (status != RPC_S_OK)
+    {
+        free(inq);
+        return status;
+    }
+    inq->type = InquiryType;
+    inq->vers_option = VersOption;
+    if (IfId) inq->ifid = *IfId;
+    if (ObjectUuid) inq->object = *ObjectUuid;
+    *InquiryContext = (RPC_EP_INQ_HANDLE)inq;
+    return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcMgmtEpEltInqDone (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcMgmtEpEltInqDone(RPC_EP_INQ_HANDLE *InquiryContext)
+{
+    struct ep_inquiry *inq;
+    error_status_t status2;
+
+    TRACE("(%p)\n", InquiryContext);
+
+    if (!InquiryContext || !*InquiryContext) return RPC_S_INVALID_BINDING;
+    inq = (struct ep_inquiry *)*InquiryContext;
+    free_inquiry_entries(inq);
+    if (inq->context)
+    {
+        __TRY
+        {
+            ept_lookup_handle_free(inq->epm, &inq->context, &status2);
+        }
+        __EXCEPT(rpc_filter)
+        {
+        }
+        __ENDTRY
+    }
+    RpcBindingFree(&inq->epm);
+    free(inq);
+    *InquiryContext = NULL;
+    return RPC_S_OK;
+}
+
+static RPC_STATUS inquiry_next(RPC_EP_INQ_HANDLE InquiryContext, RPC_IF_ID *IfId,
+    RPC_BINDING_HANDLE *Binding, UUID *ObjectUuid, char **annotation)
+{
+    struct ep_inquiry *inq = (struct ep_inquiry *)InquiryContext;
+    RPC_SYNTAX_IDENTIFIER iface, syntax;
+    char *protseq = NULL, *endpoint = NULL, *address = NULL, *string = NULL;
+    const ept_entry_t *entry;
+    RPC_STATUS status;
+
+    if (!inq) return RPC_S_INVALID_BINDING;
+
+    if (inq->pos >= inq->count)
+    {
+        error_status_t status2 = RPC_S_OK;
+
+        if (inq->done) return RPC_X_NO_MORE_ENTRIES;
+        inq->count = inq->pos = 0;
+        for (;;)
+        {
+            unsigned32 num = 0;
+            __TRY
+            {
+                ept_lookup(inq->epm, inq->type, &inq->object, (rpc_if_id_p_t)&inq->ifid, inq->vers_option,
+                           &inq->context, EP_INQ_BATCH, &num, inq->entries, &status2);
+            }
+            __EXCEPT(rpc_filter)
+            {
+                status2 = GetExceptionCode();
+            }
+            __ENDTRY
+            if (status2 == RPC_S_SERVER_UNAVAILABLE && is_epm_destination_local(inq->epm) && start_rpcss())
+                continue;
+            inq->count = status2 == RPC_S_OK ? num : 0;
+            break;
+        }
+        if (status2 == EPT_S_NOT_REGISTERED || (status2 == RPC_S_OK && !inq->count))
+        {
+            inq->done = TRUE;
+            return RPC_X_NO_MORE_ENTRIES;
+        }
+        if (status2 != RPC_S_OK) return status2;
+    }
+
+    entry = &inq->entries[inq->pos];
+    status = TowerExplode(entry->tower, &iface, &syntax, &protseq, &endpoint, &address);
+    if (status == RPC_S_OK && Binding)
+    {
+        RPC_CSTR str = NULL, uuid_str = NULL;
+
+        if (!IsEqualGUID(&entry->object, &GUID_NULL)) UuidToStringA((UUID *)&entry->object, &uuid_str);
+        status = RpcStringBindingComposeA(uuid_str, (RPC_CSTR)protseq, (RPC_CSTR)address,
+                                          (RPC_CSTR)endpoint, NULL, &str);
+        if (status == RPC_S_OK)
+        {
+            status = RpcBindingFromStringBindingA(str, Binding);
+            RpcStringFreeA(&str);
+        }
+        if (uuid_str) RpcStringFreeA(&uuid_str);
+    }
+    if (status == RPC_S_OK && annotation)
+    {
+        size_t len = strlen(entry->annotation) + 1;
+        if ((string = HeapAlloc(GetProcessHeap(), 0, len))) memcpy(string, entry->annotation, len);
+        else status = RPC_S_OUT_OF_MEMORY;
+        if (status != RPC_S_OK && Binding && *Binding) RpcBindingFree(Binding);
+    }
+    I_RpcFree(protseq);
+    I_RpcFree(endpoint);
+    I_RpcFree(address);
+    if (status != RPC_S_OK) return status;
+
+    if (IfId)
+    {
+        IfId->Uuid = iface.SyntaxGUID;
+        IfId->VersMajor = iface.SyntaxVersion.MajorVersion;
+        IfId->VersMinor = iface.SyntaxVersion.MinorVersion;
+    }
+    if (ObjectUuid) *ObjectUuid = entry->object;
+    if (annotation) *annotation = string;
+    I_RpcFree(inq->entries[inq->pos].tower);
+    inq->pos++;
+    return RPC_S_OK;
+}
+
+/***********************************************************************
+ *             RpcMgmtEpEltInqNextA (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcMgmtEpEltInqNextA(RPC_EP_INQ_HANDLE InquiryContext, RPC_IF_ID *IfId,
+    RPC_BINDING_HANDLE *Binding, UUID *ObjectUuid, RPC_CSTR *Annotation)
+{
+    TRACE("(%p,%p,%p,%p,%p)\n", InquiryContext, IfId, Binding, ObjectUuid, Annotation);
+    return inquiry_next(InquiryContext, IfId, Binding, ObjectUuid, (char **)Annotation);
+}
+
+/***********************************************************************
+ *             RpcMgmtEpEltInqNextW (RPCRT4.@)
+ */
+RPC_STATUS WINAPI RpcMgmtEpEltInqNextW(RPC_EP_INQ_HANDLE InquiryContext, RPC_IF_ID *IfId,
+    RPC_BINDING_HANDLE *Binding, UUID *ObjectUuid, RPC_WSTR *Annotation)
+{
+    char *annotation = NULL;
+    RPC_STATUS status;
+
+    TRACE("(%p,%p,%p,%p,%p)\n", InquiryContext, IfId, Binding, ObjectUuid, Annotation);
+    status = inquiry_next(InquiryContext, IfId, Binding, ObjectUuid, Annotation ? &annotation : NULL);
+    if (status == RPC_S_OK && Annotation)
+    {
+        *Annotation = (RPC_WSTR)RPCRT4_strdupAtoW(annotation);
+        HeapFree(GetProcessHeap(), 0, annotation);
+        if (!*Annotation) status = RPC_S_OUT_OF_MEMORY;
+    }
+    return status;
+}
+
 /*****************************************************************************
  * TowerExplode (RPCRT4.@)
  */
