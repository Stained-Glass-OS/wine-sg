diff --git a/dlls/rpcrt4/tests/rpc.c b/dlls/rpcrt4/tests/rpc.c
--- a/dlls/rpcrt4/tests/rpc.c
+++ b/dlls/rpcrt4/tests/rpc.c
@@ -1054,6 +1054,90 @@ static void test_RpcServerUseProtseq(void)
     RpcBindingVectorFree(&bindings);
 }
 
+static const UUID null_uuid;
+
+static unsigned int count_inquiry(RPC_CSTR protseq, RPC_BINDING_HANDLE epbind, ULONG type,
+        RPC_IF_ID *id, ULONG vers, UUID *obj, const RPC_IF_ID *want, BOOL *found_annotation)
+{
+    RPC_EP_INQ_HANDLE inq = NULL;
+    unsigned int count = 0;
+    RPC_STATUS status;
+
+    status = RpcMgmtEpEltInqBegin(epbind, type, id, vers, obj, &inq);
+    ok(status == RPC_S_OK, "%s: RpcMgmtEpEltInqBegin(%lu) failed with error %lu\n", protseq, type, status);
+    if (status != RPC_S_OK) return 0;
+
+    for (;;)
+    {
+        RPC_IF_ID got;
+        RPC_BINDING_HANDLE binding = NULL;
+        UUID object;
+        RPC_CSTR annotation = NULL, string, seq;
+
+        status = RpcMgmtEpEltInqNextA(inq, &got, &binding, &object, &annotation);
+        if (status == RPC_X_NO_MORE_ENTRIES) break;
+        ok(status == RPC_S_OK, "%s: RpcMgmtEpEltInqNextA failed with error %lu\n", protseq, status);
+        if (status != RPC_S_OK) break;
+        if (want && IsEqualGUID(&got.Uuid, &want->Uuid) && got.VersMajor == want->VersMajor &&
+            got.VersMinor == want->VersMinor)
+        {
+            count++;
+            status = RpcBindingToStringBindingA(binding, &string);
+            ok(status == RPC_S_OK, "RpcBindingToStringBindingA failed with error %lu\n", status);
+            if (status == RPC_S_OK)
+            {
+                status = RpcStringBindingParseA(string, NULL, &seq, NULL, NULL, NULL);
+                ok(status == RPC_S_OK, "RpcStringBindingParseA failed with error %lu\n", status);
+                ok(!strcmp((char *)seq, "ncacn_np") || !strcmp((char *)seq, "ncalrpc") ||
+                   !strcmp((char *)seq, "ncacn_ip_tcp"), "%s: got protseq %s\n", protseq, seq);
+                RpcStringFreeA(&seq);
+                RpcStringFreeA(&string);
+            }
+            ok(IsEqualGUID(&object, &null_uuid), "got object %s\n", wine_dbgstr_guid(&object));
+            if (found_annotation && annotation && !strcmp((char *)annotation, "Test annotation string."))
+                *found_annotation = TRUE;
+        }
+        else if (!want) count++;
+        if (binding) RpcBindingFree(&binding);
+        RpcStringFreeA(&annotation);
+    }
+
+    status = RpcMgmtEpEltInqDone(&inq);
+    ok(status == RPC_S_OK, "RpcMgmtEpEltInqDone failed with error %lu\n", status);
+    ok(!inq, "inquiry handle not cleared\n");
+    return count;
+}
+
+static void test_endpoint_inquiry(RPC_CSTR protseq, RPC_BINDING_HANDLE epbind)
+{
+    static const UUID other_object = {0x6f1c0d3a, 0x2b7e, 0x4c91, {0x8a, 0x55, 0x10, 0x20, 0x30, 0x40, 0x50, 0x60}};
+    RPC_IF_ID id, wrong;
+    UUID object = other_object;
+    unsigned int count;
+    RPC_STATUS status;
+
+    status = RpcIfInqId(IFoo_v0_0_s_ifspec, &id);
+    ok(status == RPC_S_OK, "RpcIfInqId failed with error %lu\n", status);
+
+    count = count_inquiry(protseq, epbind, RPC_C_EP_MATCH_BY_IF, &id, RPC_C_VERS_ALL, NULL, &id, NULL);
+    ok(count >= 1, "%s: no endpoint found by interface\n", protseq);
+    count = count_inquiry(protseq, epbind, RPC_C_EP_MATCH_BY_IF, &id, RPC_C_VERS_EXACT, NULL, &id, NULL);
+    ok(count >= 1, "%s: no endpoint found by exact version\n", protseq);
+    count = count_inquiry(protseq, epbind, RPC_C_EP_ALL_ELTS, NULL, 0, NULL, &id, NULL);
+    ok(count >= 1, "%s: our endpoint is not among all elements\n", protseq);
+
+    wrong = id;
+    wrong.VersMajor = 7;
+    count = count_inquiry(protseq, epbind, RPC_C_EP_MATCH_BY_IF, &wrong, RPC_C_VERS_EXACT, NULL, NULL, NULL);
+    ok(!count, "%s: %u endpoints found for another version\n", protseq, count);
+    wrong = id;
+    wrong.Uuid = other_object;
+    count = count_inquiry(protseq, epbind, RPC_C_EP_MATCH_BY_IF, &wrong, RPC_C_VERS_ALL, NULL, NULL, NULL);
+    ok(!count, "%s: %u endpoints found for another interface\n", protseq, count);
+    count = count_inquiry(protseq, epbind, RPC_C_EP_MATCH_BY_OBJ, NULL, 0, &object, NULL, NULL);
+    ok(!count, "%s: %u endpoints found for another object\n", protseq, count);
+}
+
 static void test_endpoint_mapper(RPC_CSTR protseq, RPC_CSTR address)
 {
     static unsigned char annotation[] = "Test annotation string.";
@@ -1094,6 +1178,8 @@ static void test_endpoint_mapper(RPC_CSTR protseq, RPC_CSTR address)
     status = RpcBindingReset(handle);
     ok(status == RPC_S_OK, "%s: RpcBindingReset failed with error %lu\n", protseq, status);
 
+    test_endpoint_inquiry(protseq, handle);
+
     status = RpcBindingFree(&handle);
     ok(status == RPC_S_OK, "%s: RpcBindingFree failed with error %lu\n", protseq, status);
 
