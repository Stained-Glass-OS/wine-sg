diff --git a/programs/rpcss/epmp.c b/programs/rpcss/epmp.c
--- a/programs/rpcss/epmp.c
+++ b/programs/rpcss/epmp.c
@@ -84,9 +84,57 @@ static struct registered_ept_entry *find_ept_entry(
     return NULL;
 }
 
+/* the cursor of an ept_lookup inquiry: how many entries of the map it has passed */
+struct lookup_cursor
+{
+    unsigned32 pos;
+};
+
 void __RPC_USER ept_lookup_handle_t_rundown(ept_lookup_handle_t entry_handle)
 {
-    WINE_FIXME("%p\n", entry_handle);
+    WINE_TRACE("%p\n", entry_handle);
+    free(entry_handle);
+}
+
+static BOOL lookup_matches(const struct registered_ept_entry *entry, unsigned32 inquiry_type,
+                           const UUID *object, const rpc_if_id_t *id, unsigned32 vers_option)
+{
+#ifdef SG_MUTANT_EPLOOKUP
+    return TRUE;
+#endif
+    if (inquiry_type == RPC_C_EP_MATCH_BY_IF || inquiry_type == RPC_C_EP_MATCH_BY_BOTH)
+    {
+        if (!id || !IsEqualGUID(&entry->iface.SyntaxGUID, &id->uuid)) return FALSE;
+        switch (vers_option)
+        {
+        case RPC_C_VERS_ALL:
+            break;
+        case RPC_C_VERS_COMPATIBLE:
+            if (entry->iface.SyntaxVersion.MajorVersion != id->vers_major ||
+                entry->iface.SyntaxVersion.MinorVersion < id->vers_minor) return FALSE;
+            break;
+        case RPC_C_VERS_EXACT:
+            if (entry->iface.SyntaxVersion.MajorVersion != id->vers_major ||
+                entry->iface.SyntaxVersion.MinorVersion != id->vers_minor) return FALSE;
+            break;
+        case RPC_C_VERS_MAJOR_ONLY:
+            if (entry->iface.SyntaxVersion.MajorVersion != id->vers_major) return FALSE;
+            break;
+        case RPC_C_VERS_UPTO:
+            if (entry->iface.SyntaxVersion.MajorVersion > id->vers_major ||
+                (entry->iface.SyntaxVersion.MajorVersion == id->vers_major &&
+                 entry->iface.SyntaxVersion.MinorVersion > id->vers_minor)) return FALSE;
+            break;
+        default:
+            return FALSE;
+        }
+    }
+    if (inquiry_type == RPC_C_EP_MATCH_BY_OBJ || inquiry_type == RPC_C_EP_MATCH_BY_BOTH)
+    {
+        const UUID *want = object ? object : &nil_object;
+        if (!IsEqualGUID(want, &entry->object)) return FALSE;
+    }
+    return TRUE;
 }
 
 void __cdecl ept_insert(handle_t h,
@@ -193,9 +241,63 @@ void __cdecl ept_lookup(handle_t h,
                         ept_entry_t entries[],
                         error_status_t *status)
 {
-    WINE_FIXME("(%p, %p, %p): stub\n", h, entry_handle, status);
+    struct lookup_cursor *cursor;
+    struct registered_ept_entry *entry;
+    unsigned32 index = 0;
 
-    *status = EPT_S_CANT_PERFORM_OP;
+    WINE_TRACE("(%p, %lu, %p, %p, %lu, %p, %lu, %p, %p, %p)\n", h, inquiry_type, object,
+               interface_id, vers_option, entry_handle, max_ents, num_ents, entries, status);
+
+    *status = RPC_S_OK;
+    *num_ents = 0;
+
+    if (inquiry_type > RPC_C_EP_MATCH_BY_BOTH)
+    {
+        *status = RPC_S_INVALID_ARG;
+        return;
+    }
+
+    cursor = *entry_handle;
+    if (!cursor)
+    {
+        if (!(cursor = calloc(1, sizeof(*cursor))))
+        {
+            *status = EPT_S_CANT_PERFORM_OP;
+            return;
+        }
+        *entry_handle = cursor;
+    }
+
+    EnterCriticalSection(&csEpm);
+
+    LIST_FOR_EACH_ENTRY(entry, &registered_ept_entry_list, struct registered_ept_entry, entry)
+    {
+        RPC_STATUS rpc_status;
+
+        if (index++ < cursor->pos) continue;
+        if (*num_ents >= max_ents) { index--; break; }
+        if (inquiry_type != RPC_C_EP_ALL_ELTS &&
+            !lookup_matches(entry, inquiry_type, object, interface_id, vers_option))
+            continue;
+
+        rpc_status = TowerConstruct(&entry->iface, &entry->syntax, entry->protseq,
+                                    entry->endpoint, entry->address,
+                                    &entries[*num_ents].tower);
+        if (rpc_status != RPC_S_OK)
+        {
+            *status = rpc_status;
+            break;
+        }
+        entries[*num_ents].object = entry->object;
+        memcpy(entries[*num_ents].annotation, entry->annotation, sizeof(entry->annotation));
+        (*num_ents)++;
+    }
+    cursor->pos = index;
+
+    LeaveCriticalSection(&csEpm);
+
+    if (*status == RPC_S_OK && !*num_ents)
+        *status = EPT_S_NOT_REGISTERED;
 }
 
 void __cdecl ept_map(handle_t h,
@@ -262,9 +364,11 @@ void __cdecl ept_lookup_handle_free(handle_t h,
                                     ept_lookup_handle_t *entry_handle,
                                     error_status_t *status)
 {
-    WINE_FIXME("(%p, %p, %p): stub\n", h, entry_handle, status);
+    WINE_TRACE("(%p, %p, %p)\n", h, entry_handle, status);
 
-    *status = EPT_S_CANT_PERFORM_OP;
+    free(*entry_handle);
+    *entry_handle = NULL;
+    *status = RPC_S_OK;
 }
 
 void __cdecl ept_inq_object(handle_t h,
