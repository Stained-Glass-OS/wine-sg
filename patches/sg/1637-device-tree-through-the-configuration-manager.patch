+/***********************************************************************
+ *      CM_Enumerate_Enumerators_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Enumerate_Enumerators_ExW(ULONG index, WCHAR *buffer, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    WCHAR name[MAX_DEVICE_ID_LEN];
+    DWORD size = ARRAY_SIZE(name);
+    HKEY key;
+    LONG l;
+
+    TRACE("%lu %p %p %#lx %p\n", index, buffer, len, flags, machine);
+
+    if (!buffer || !len) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, Enum, 0, KEY_READ, &key)) return CR_REGISTRY_ERROR;
+    l = RegEnumKeyExW(key, index, name, &size, NULL, NULL, NULL, NULL);
+    RegCloseKey(key);
+    if (l == ERROR_NO_MORE_ITEMS) return CR_NO_SUCH_VALUE;
+    if (l) return CR_REGISTRY_ERROR;
+    if (*len < size + 1)
+    {
+        *len = size + 1;
+        return CR_BUFFER_SMALL;
+    }
+    lstrcpyW(buffer, name);
+    *len = size + 1;
+    return CR_SUCCESS;
+}
