+CONFIGRET WINAPI CM_Get_Device_ID_List_ExA(const char *filter, char *buffer, ULONG len, ULONG flags, HMACHINE machine)
+{
+    WCHAR filterW[MAX_DEVICE_ID_LEN], *bufferW;
+    CONFIGRET cr;
+
+    if (!buffer || !len) return CR_INVALID_POINTER;
+    if (filter && !MultiByteToWideChar(CP_ACP, 0, filter, -1, filterW, ARRAY_SIZE(filterW))) return CR_INVALID_DATA;
+    if (!(bufferW = malloc(len * sizeof(WCHAR)))) return CR_OUT_OF_MEMORY;
+    cr = CM_Get_Device_ID_List_ExW(filter ? filterW : NULL, bufferW, len, flags, machine);
+    if (cr == CR_SUCCESS)
+    {
+        ULONG n = 0;
+        while (bufferW[n]) n += wcslen(bufferW + n) + 1;
+        WideCharToMultiByte(CP_ACP, 0, bufferW, n + 1, buffer, len, NULL, NULL);
+    }
+    free(bufferW);
+    return cr;
+}
