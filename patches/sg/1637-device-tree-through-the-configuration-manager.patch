+/* whether a device's id goes in a filtered list */
+static BOOL id_matches_filter(const WCHAR *id, const WCHAR *filter, ULONG flags)
+{
+    WCHAR value[MAX_DEVICE_ID_LEN], parent[MAX_DEVICE_ID_LEN];
+    DWORD size;
+    HKEY key;
+    BOOL ret = FALSE;
+
+    if ((flags & CM_GETIDLIST_FILTER_PRESENT) && !is_device_present(id)) return FALSE;
+    switch (flags & ~(CM_GETIDLIST_FILTER_PRESENT | CM_GETIDLIST_DONOTGENERATE))
+    {
+    case CM_GETIDLIST_FILTER_NONE:
+        return TRUE;
+    case CM_GETIDLIST_FILTER_ENUMERATOR:
+    {
+        /* "USB" or "USB\VID_xxxx&PID_xxxx" */
+        size_t len = wcslen(filter);
+        return !wcsnicmp(id, filter, len) && id[len] == '\\';
+    }
+    case CM_GETIDLIST_FILTER_SERVICE:
+        if (!(key = open_enum_subkey(id, NULL))) return FALSE;
+        size = sizeof(value);
+        if (!RegQueryValueExW(key, L"Service", NULL, NULL, (BYTE *)value, &size)) ret = !wcsicmp(value, filter);
+        RegCloseKey(key);
+        return ret;
+    case CM_GETIDLIST_FILTER_CLASS:
+        if (!(key = open_enum_subkey(id, NULL))) return FALSE;
+        size = sizeof(value);
+        if (!RegQueryValueExW(key, L"ClassGUID", NULL, NULL, (BYTE *)value, &size)) ret = !wcsicmp(value, filter);
+        RegCloseKey(key);
+        return ret;
+    case CM_GETIDLIST_FILTER_BUSRELATIONS:
+        /* the device's children */
+        get_parent_id(id, parent);
+        return !wcsicmp(parent, filter) || (!*parent && !wcsicmp(filter, root_id));
+    default:
+        /* removal, ejection, power and transport relations: none known here */
+        return FALSE;
+    }
+}
+
+static CONFIGRET get_id_list(const WCHAR *filter, WCHAR *buffer, ULONG *len, ULONG flags)
+{
+    DWORD count, i, needed = 1, pos = 0;
+    CONFIGRET cr = CR_SUCCESS;
+    WCHAR **ids;
+
+    if (flags & ~CM_GETIDLIST_FILTER_BITS) return CR_INVALID_FLAG;
+    if ((flags & ~(CM_GETIDLIST_FILTER_PRESENT | CM_GETIDLIST_DONOTGENERATE)) && !filter) return CR_INVALID_POINTER;
+    ids = get_device_ids(&count);
+    for (i = 0; i < count; i++)
+    {
+        size_t l;
+
+        if (!id_matches_filter(ids[i], filter, flags)) continue;
+        l = wcslen(ids[i]) + 1;
+        needed += l;
+        if (buffer)
+        {
+            if (pos + l + 1 > *len) cr = CR_BUFFER_SMALL;
+            else
+            {
+                memcpy(buffer + pos, ids[i], l * sizeof(WCHAR));
+                pos += l;
+            }
+        }
+    }
+    free_device_ids(ids, count);
+    if (buffer)
+    {
+        if (cr == CR_SUCCESS) buffer[pos] = 0;
+        else if (*len) buffer[0] = 0;
+    }
+    else *len = needed;
+    return cr;
+}
