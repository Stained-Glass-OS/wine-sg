+ */
+CONFIGRET WINAPI CM_Get_Class_Key_Name_ExW(GUID *class, WCHAR *name, ULONG *len, ULONG flags, HMACHINE machine)
+{
+    WCHAR str[39];
+
+    TRACE("%s %p %p %#lx %p\n", debugstr_guid(class), name, len, flags, machine);
+
+    if (!class || !len || (!name && *len)) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    /* the class's key under Control\Class is its GUID */
+    SETUPDI_GuidToString(class, str);
+    if (*len < ARRAY_SIZE(str))
+    {
+        *len = ARRAY_SIZE(str);
+        return CR_BUFFER_SMALL;
+    }
+    lstrcpyW(name, str);
+    *len = ARRAY_SIZE(str);
+    return CR_SUCCESS;
+}
