+/* Stained Glass OS: the device tree. The devices are those under the Enum
+ * key; a device is present while Wine's PnP manager has it started (its
+ * volatile Control key), or when a root or software enumerator made it.
+ * A process-lifetime set keeps the device nodes handed out valid. */
+static HDEVINFO tree_set;
+
+static HDEVINFO get_tree_set(void)
+{
+    HDEVINFO set;
+
+    if (!tree_set)
+    {
+        if ((set = SetupDiCreateDeviceInfoList(NULL, NULL)) == INVALID_HANDLE_VALUE) return NULL;
+        if (InterlockedCompareExchangePointer(&tree_set, set, NULL)) SetupDiDestroyDeviceInfoList(set);
+    }
+    return tree_set;
+}
+
+/* every device instance id, in the registry's order */
+static WCHAR **get_device_ids(DWORD *count)
+{
+    WCHAR enumerator[MAX_DEVICE_ID_LEN], device[MAX_DEVICE_ID_LEN], instance[MAX_DEVICE_ID_LEN], **ids = NULL, **tmp;
+    HKEY enum_key, enum_sub, dev_key;
+    DWORD i, j, k, len, alloc = 0;
+
+    *count = 0;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, Enum, 0, KEY_READ, &enum_key)) return NULL;
+    for (i = 0; len = ARRAY_SIZE(enumerator), !RegEnumKeyExW(enum_key, i, enumerator, &len, NULL, NULL, NULL, NULL); i++)
+    {
+        if (RegOpenKeyExW(enum_key, enumerator, 0, KEY_READ, &enum_sub)) continue;
+        for (j = 0; len = ARRAY_SIZE(device), !RegEnumKeyExW(enum_sub, j, device, &len, NULL, NULL, NULL, NULL); j++)
+        {
+            if (RegOpenKeyExW(enum_sub, device, 0, KEY_READ, &dev_key)) continue;
+            for (k = 0; len = ARRAY_SIZE(instance), !RegEnumKeyExW(dev_key, k, instance, &len, NULL, NULL, NULL, NULL); k++)
+            {
+                size_t size = wcslen(enumerator) + wcslen(device) + wcslen(instance) + 3;
+
+                if (*count == alloc)
+                {
+                    alloc = alloc ? alloc * 2 : 64;
+                    if (!(tmp = realloc(ids, alloc * sizeof(*ids)))) break;
+                    ids = tmp;
+                }
+                if (!(ids[*count] = malloc(size * sizeof(WCHAR)))) break;
+                swprintf(ids[*count], size, L"%s\\%s\\%s", enumerator, device, instance);
+                (*count)++;
+            }
+            RegCloseKey(dev_key);
+        }
+        RegCloseKey(enum_sub);
+    }
+    RegCloseKey(enum_key);
+    return ids;
+}
+
+static void free_device_ids(WCHAR **ids, DWORD count)
+{
+    while (count) free(ids[--count]);
+    free(ids);
+}
+
+static HKEY open_enum_subkey(const WCHAR *id, const WCHAR *sub)
+{
+    WCHAR path[MAX_PATH * 2];
+    HKEY key;
+
+    swprintf(path, ARRAY_SIZE(path), sub ? L"%s\\%s\\%s" : L"%s\\%s", Enum, id, sub);
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key)) return NULL;
+    return key;
+}
+
+static BOOL is_device_present(const WCHAR *id)
+{
+    HKEY key;
+
+#ifdef SG_MUTANT_ALL_PRESENT
+    return TRUE;
+#endif
+    if (!wcsnicmp(id, L"ROOT\\", 5) || !wcsnicmp(id, L"SWD\\", 4) || !wcsnicmp(id, L"HTREE\\", 6)) return TRUE;
+    if (!(key = open_enum_subkey(id, L"Control"))) return FALSE;
+    RegCloseKey(key);
+    return TRUE;
+}
+
+/* a device's parent's instance id, or empty for the root */
+static void get_parent_id(const WCHAR *id, WCHAR *parent)
+{
+    static const DEVPROPKEY parent_key = {{0x4340a6c5,0x93fa,0x4706,{0x97,0x2c,0x7b,0x64,0x80,0x08,0xa5,0xa7}}, 8};
+    SP_DEVINFO_DATA data = {sizeof(data)};
+    DEVPROPTYPE type;
+
+    *parent = 0;
+    if (!SetupDiOpenDeviceInfoW(get_tree_set(), id, NULL, 0, &data) ||
+        !SetupDiGetDevicePropertyW(get_tree_set(), &data, &parent_key, &type, (BYTE *)parent,
+                                   MAX_DEVICE_ID_LEN * sizeof(WCHAR), NULL, 0) || type != DEVPROP_TYPE_STRING)
+        *parent = 0;
+}
+
+static CONFIGRET devnode_from_id(const WCHAR *id, DEVINST *devnode)
+{
+    SP_DEVINFO_DATA data = {sizeof(data)};
+
+    if (!wcsicmp(id, root_id))
+    {
+        *devnode = ROOT_DEVNODE;
+        return CR_SUCCESS;
+    }
+    if (!get_tree_set() || !SetupDiOpenDeviceInfoW(get_tree_set(), id, NULL, 0, &data)) return CR_NO_SUCH_DEVNODE;
+    *devnode = data.DevInst;
+    return CR_SUCCESS;
+}
+
+static CONFIGRET devnode_id(DEVINST devnode, WCHAR *id)
+{
+    struct device *device;
+
+    if (devnode == ROOT_DEVNODE)
+    {
+        lstrcpyW(id, root_id);
+        return CR_SUCCESS;
+    }
+    if (!(device = get_devnode_device(devnode))) return CR_INVALID_DEVNODE;
+    lstrcpynW(id, device->instanceId, MAX_DEVICE_ID_LEN);
+    return CR_SUCCESS;
+}
+
+/* the present children of a device (the root's: those no device
+ * enumerated), in the registry's order; the one after "after", or the first */
+static CONFIGRET find_child(const WCHAR *parent, const WCHAR *after, DEVINST *ret)
+{
+    WCHAR **ids, id_parent[MAX_DEVICE_ID_LEN];
+    BOOL root = !wcsicmp(parent, root_id), seen = !after;
+    CONFIGRET cr = CR_NO_SUCH_DEVNODE;
+    DWORD count, i;
+
+    if (!(ids = get_device_ids(&count))) return CR_NO_SUCH_DEVNODE;
+    for (i = 0; i < count; i++)
+    {
+        if (!wcsicmp(ids[i], root_id) || !is_device_present(ids[i])) continue;
+        get_parent_id(ids[i], id_parent);
+        if (root ? *id_parent != 0 : wcsicmp(id_parent, parent)) continue;
+        if (!seen)
+        {
+            if (!wcsicmp(ids[i], after)) seen = TRUE;
+            continue;
+        }
+        if ((cr = devnode_from_id(ids[i], ret)) == CR_SUCCESS) break;
+    }
+    free_device_ids(ids, count);
+    return cr;
+}
+
+/***********************************************************************
+ *      CM_Locate_DevNode_ExW (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Locate_DevNode_ExW(DEVINST *devnode, DEVINSTID_W id, ULONG flags, HMACHINE machine)
+{
+    CONFIGRET cr;
+
+    TRACE("%p %s %#lx %p\n", devnode, debugstr_w(id), flags, machine);
+
+    if (!devnode) return CR_INVALID_POINTER;
+    *devnode = 0;
+    if (flags & ~CM_LOCATE_DEVNODE_BITS) return CR_INVALID_FLAG;
+    /* no id: the root of the tree */
+    if (!id || !*id)
+    {
+        *devnode = ROOT_DEVNODE;
+        return CR_SUCCESS;
+    }
+    if (wcslen(id) >= MAX_DEVICE_ID_LEN || id[0] == '\\') return CR_INVALID_DEVICE_ID;
+    if ((cr = devnode_from_id(id, devnode))) return cr;
+    /* a device not present is found only as a phantom */
+    if (!(flags & CM_LOCATE_DEVNODE_PHANTOM) && !is_device_present(id))
+    {
+        *devnode = 0;
+        return CR_NO_SUCH_DEVNODE;
+    }
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Locate_DevNodeW(DEVINST *devnode, DEVINSTID_W id, ULONG flags)
+{
+    return CM_Locate_DevNode_ExW(devnode, id, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Locate_DevNode_ExA(DEVINST *devnode, DEVINSTID_A id, ULONG flags, HMACHINE machine)
+{
+    WCHAR idW[MAX_DEVICE_ID_LEN];
+
+    if (id && !MultiByteToWideChar(CP_ACP, 0, id, -1, idW, ARRAY_SIZE(idW))) return CR_INVALID_DEVICE_ID;
+    return CM_Locate_DevNode_ExW(devnode, id ? idW : NULL, flags, machine);
+}
+
+CONFIGRET WINAPI CM_Locate_DevNodeA(DEVINST *devnode, DEVINSTID_A id, ULONG flags)
+{
+    return CM_Locate_DevNode_ExA(devnode, id, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Get_Child_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Child_Ex(DEVINST *child, DEVINST devnode, ULONG flags, HMACHINE machine)
+{
+    WCHAR id[MAX_DEVICE_ID_LEN];
+    CONFIGRET cr;
+
+    TRACE("%p %lu %#lx %p\n", child, devnode, flags, machine);
+
+    if (!child) return CR_INVALID_POINTER;
+    *child = 0;
+    if (flags) return CR_INVALID_FLAG;
+    if ((cr = devnode_id(devnode, id))) return cr;
+    return find_child(id, NULL, child);
+}
+
+CONFIGRET WINAPI CM_Get_Child(DEVINST *child, DEVINST devnode, ULONG flags)
+{
+    return CM_Get_Child_Ex(child, devnode, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Get_Sibling_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Sibling_Ex(DEVINST *sibling, DEVINST devnode, ULONG flags, HMACHINE machine)
+{
+    WCHAR id[MAX_DEVICE_ID_LEN], parent[MAX_DEVICE_ID_LEN];
+    CONFIGRET cr;
+
+    TRACE("%p %lu %#lx %p\n", sibling, devnode, flags, machine);
+
+    if (!sibling) return CR_INVALID_POINTER;
+    *sibling = 0;
+    if (flags) return CR_INVALID_FLAG;
+    if (devnode == ROOT_DEVNODE) return CR_NO_SUCH_DEVNODE;
+    if ((cr = devnode_id(devnode, id))) return cr;
+    get_parent_id(id, parent);
+    return find_child(*parent ? parent : root_id, id, sibling);
+}
+
+CONFIGRET WINAPI CM_Get_Sibling(DEVINST *sibling, DEVINST devnode, ULONG flags)
+{
+    return CM_Get_Sibling_Ex(sibling, devnode, flags, NULL);
+}
+
+/***********************************************************************
+ *      CM_Get_Parent_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Parent_Ex(DEVINST *parent, DEVINST devnode, ULONG flags, HMACHINE machine)
+{
+    return CM_Get_Parent(parent, devnode, flags);
+}
+
+/***********************************************************************
+ *      CM_Get_Depth_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Depth_Ex(ULONG *depth, DEVINST devnode, ULONG flags, HMACHINE machine)
+{
+    DEVINST parent;
+    CONFIGRET cr;
+
+    TRACE("%p %lu %#lx %p\n", depth, devnode, flags, machine);
+
+    if (!depth) return CR_INVALID_POINTER;
+    if (flags) return CR_INVALID_FLAG;
+    *depth = 0;
+    /* how far from the root */
+    while (devnode != ROOT_DEVNODE && *depth < 64)
+    {
+        if ((cr = CM_Get_Parent(&parent, devnode, 0))) return cr;
+        devnode = parent;
+        (*depth)++;
+    }
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_Depth(ULONG *depth, DEVINST devnode, ULONG flags)
+{
+    return CM_Get_Depth_Ex(depth, devnode, flags, NULL);
+}
+
+CONFIGRET WINAPI CM_Get_Device_ID_ExW(DEVINST devnode, WCHAR *buffer, ULONG len, ULONG flags, HMACHINE machine)
+{
+    return CM_Get_Device_IDW(devnode, buffer, len, flags);
+}
+
+CONFIGRET WINAPI CM_Get_Device_ID_ExA(DEVINST devnode, char *buffer, ULONG len, ULONG flags, HMACHINE machine)
+{
+    return CM_Get_Device_IDA(devnode, buffer, len, flags);
+}
+
+CONFIGRET WINAPI CM_Get_Device_ID_Size_Ex(ULONG *len, DEVINST devnode, ULONG flags, HMACHINE machine)
+{
+    return CM_Get_Device_ID_Size(len, devnode, flags);
+}
+
+/***********************************************************************
+ *      CM_Get_DevNode_Status_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_DevNode_Status_Ex(ULONG *status, ULONG *problem, DEVINST devnode, ULONG flags,
+                                          HMACHINE machine)
+{
+    WCHAR id[MAX_DEVICE_ID_LEN], service[MAX_SERVICE_NAME_LEN];
+    DWORD config = 0, size;
+    CONFIGRET cr;
+    HKEY key;
+
+    TRACE("%p %p %lu %#lx %p\n", status, problem, devnode, flags, machine);
+
+    if (!status || !problem) return CR_INVALID_POINTER;
+    *status = *problem = 0;
+    if (flags) return CR_INVALID_FLAG;
+    if ((cr = devnode_id(devnode, id))) return cr;
+    if (devnode == ROOT_DEVNODE)
+    {
+        *status = DN_ROOT_ENUMERATED | DN_DRIVER_LOADED | DN_STARTED | DN_NT_ENUMERATOR | DN_NT_DRIVER;
+        return CR_SUCCESS;
+    }
+    if (!is_device_present(id)) return CR_NO_SUCH_DEVINST;
+    if (!(key = open_enum_subkey(id, NULL))) return CR_NO_SUCH_DEVINST;
+    size = sizeof(config);
+    RegQueryValueExW(key, L"ConfigFlags", NULL, NULL, (BYTE *)&config, &size);
+    size = sizeof(service);
+    if (RegQueryValueExW(key, L"Service", NULL, NULL, (BYTE *)service, &size)) *service = 0;
+    RegCloseKey(key);
+    if (!wcsnicmp(id, L"ROOT\\", 5)) *status |= DN_ROOT_ENUMERATED;
+    *status |= DN_NT_ENUMERATOR;
+#ifndef SG_MUTANT_NO_DEVNODE_STATUS
+    if (config & CONFIGFLAG_DISABLED)
+    {
+        *status |= DN_HAS_PROBLEM;
+        *problem = CM_PROB_DISABLED;
+    }
+    else if (!*service && (config & CONFIGFLAG_FAILEDINSTALL))
+    {
+        *status |= DN_HAS_PROBLEM;
+        *problem = CM_PROB_FAILED_INSTALL;
+    }
+    else
+        *status |= DN_DRIVER_LOADED | DN_STARTED | DN_NT_DRIVER | DN_DISABLEABLE;
+#endif
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Get_DevNode_Status(ULONG *status, ULONG *problem, DEVINST devnode, ULONG flags)
+{
+    return CM_Get_DevNode_Status_Ex(status, problem, devnode, flags, NULL);
+}
