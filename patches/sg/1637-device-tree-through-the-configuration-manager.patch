+/* Stained Glass OS: a device is present while it is enumerated here: its
+ * volatile Control key under Enum says so (CM_Locate_DevNode and the
+ * device tree read it) */
+static void set_device_present( const WCHAR *id, BOOL present )
+{
+    WCHAR path[MAX_DEVICE_ID_LEN + 64];
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Enum\\%s\\Control", id );
+    if (!present)
+    {
+        RegDeleteKeyW( HKEY_LOCAL_MACHINE, path );
+        return;
+    }
+    if (!RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, REG_OPTION_VOLATILE, KEY_SET_VALUE, NULL, &key, NULL ))
+        RegCloseKey( key );
+}
