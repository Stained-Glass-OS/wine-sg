+/***********************************************************************
+ *      CM_Open_DevNode_Key_Ex (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Open_DevNode_Key_Ex(DEVINST devnode, REGSAM access, ULONG profile, REGDISPOSITION disposition,
+                                        HKEY *key, ULONG flags, HMACHINE machine)
+{
+    SP_DEVINFO_DATA data = {sizeof(data)};
+    WCHAR id[MAX_DEVICE_ID_LEN];
+    DWORD which;
+    CONFIGRET cr;
+    HKEY ret;
+
+    TRACE("%lu %#lx %lu %lu %p %#lx %p\n", devnode, access, profile, disposition, key, flags, machine);
+
+    if (!key) return CR_INVALID_POINTER;
+    *key = NULL;
+    if (flags & ~CM_REGISTRY_BITS) return CR_INVALID_FLAG;
+    if (disposition != RegDisposition_OpenAlways && disposition != RegDisposition_OpenExisting) return CR_INVALID_DATA;
+    if (devnode == ROOT_DEVNODE) return CR_INVALID_DEVNODE;
+    if ((cr = devnode_id(devnode, id))) return cr;
+    if (!SetupDiOpenDeviceInfoW(get_tree_set(), id, NULL, 0, &data)) return CR_INVALID_DEVNODE;
+    /* the hardware key (Device Parameters), or the driver's */
+    which = (flags & CM_REGISTRY_SOFTWARE) ? DIREG_DRV : DIREG_DEV;
+    ret = SetupDiOpenDevRegKey(get_tree_set(), &data, DICS_FLAG_GLOBAL, 0, which, access);
+    if (ret == INVALID_HANDLE_VALUE && disposition == RegDisposition_OpenAlways)
+        ret = SetupDiCreateDevRegKeyW(get_tree_set(), &data, DICS_FLAG_GLOBAL, 0, which, NULL, NULL);
+    if (ret == INVALID_HANDLE_VALUE) return CR_NO_SUCH_REGISTRY_KEY;
+    *key = ret;
+    return CR_SUCCESS;
+}
+
+CONFIGRET WINAPI CM_Open_DevNode_Key(DEVINST devnode, REGSAM access, ULONG profile, REGDISPOSITION disposition,
+                                     HKEY *key, ULONG flags)
+{
+    return CM_Open_DevNode_Key_Ex(devnode, access, profile, disposition, key, flags, NULL);
+}
