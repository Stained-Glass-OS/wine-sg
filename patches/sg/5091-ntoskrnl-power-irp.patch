From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: PoSetPowerState and PoRequestPowerIrp.

PoSetPowerState returned the state it was given; it now stores the state
and returns the previous one of that type (a device starts out
unspecified), which removes a todo_wine of the PnP test driver.
PoRequestPowerIrp returned STATUS_NOT_IMPLEMENTED; it allocates a power IRP
for the minor function and state, sends it to the top of the device's stack
and returns STATUS_PENDING, and the completion calls the caller's callback
with the IRP's status. PoStartNextPowerIrp no longer logs a FIXME.

Test: the PnP test driver (driver_pnp.c) requests a set-power IRP for its
child device and checks the callback and the states; gate
test/ntoskrnl-pnptest-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/pnp.c b/dlls/ntoskrnl.exe/pnp.c
--- a/dlls/ntoskrnl.exe/pnp.c
+++ b/dlls/ntoskrnl.exe/pnp.c
@@ -1122,15 +1122,82 @@
     return STATUS_SUCCESS;
 }
 
+/* a power IRP sent by PoRequestPowerIrp, until it completes */
+struct power_request
+{
+    DEVICE_OBJECT *device;
+    UCHAR minor;
+    POWER_STATE state;
+    PREQUEST_POWER_COMPLETE complete_cb;
+    void *context;
+};
+
+static NTSTATUS WINAPI power_request_complete( DEVICE_OBJECT *device, IRP *irp, void *context )
+{
+    struct power_request *request = context;
+    IO_STATUS_BLOCK io = irp->IoStatus;
+
+    TRACE( "irp %p, status %#lx.\n", irp, io.Status );
+
+    IoFreeIrp( irp );
+    if (request->complete_cb) request->complete_cb( request->device, request->minor, request->state, request->context, &io );
+    ObDereferenceObject( request->device );
+    free( request );
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
 /***********************************************************************
  *           PoRequestPowerIrp   (NTOSKRNL.EXE.@)
  */
 NTSTATUS WINAPI PoRequestPowerIrp( DEVICE_OBJECT *device, UCHAR minor,
-        POWER_STATE state, PREQUEST_POWER_COMPLETE complete_cb, void *ctx, IRP **irp )
+        POWER_STATE state, PREQUEST_POWER_COMPLETE complete_cb, void *ctx, IRP **out_irp )
 {
-    FIXME("device %p, minor %#x, state %u, complete_cb %p, ctx %p, irp %p, stub!\n",
-            device, minor, state.DeviceState, complete_cb, ctx, irp);
+    struct power_request *request;
+    IO_STACK_LOCATION *irpsp;
+    DEVICE_OBJECT *top;
+    IRP *irp;
+
+    TRACE("device %p, minor %#x, state %u, complete_cb %p, ctx %p, irp %p.\n",
+            device, minor, state.DeviceState, complete_cb, ctx, out_irp);
+
+#ifdef SG_MUTANT_POWER_REQUEST
     return STATUS_NOT_IMPLEMENTED;
+#endif
+    if (minor != IRP_MN_QUERY_POWER && minor != IRP_MN_SET_POWER && minor != IRP_MN_WAIT_WAKE)
+        return STATUS_INVALID_PARAMETER_2;
+
+    /* the IRP goes to the top of the device's stack */
+    top = IoGetAttachedDeviceReference( device );
+    if (!(irp = IoAllocateIrp( top->StackSize, FALSE )))
+    {
+        ObDereferenceObject( top );
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    if (!(request = malloc( sizeof(*request) )))
+    {
+        IoFreeIrp( irp );
+        ObDereferenceObject( top );
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    ObDereferenceObject( top );
+    ObReferenceObject( device );
+    request->device = device;
+    request->minor = minor;
+    request->state = state;
+    request->complete_cb = complete_cb;
+    request->context = ctx;
+
+    irpsp = IoGetNextIrpStackLocation( irp );
+    irpsp->MajorFunction = IRP_MJ_POWER;
+    irpsp->MinorFunction = minor;
+    irpsp->Parameters.Power.Type = minor == IRP_MN_WAIT_WAKE ? SystemPowerState : DevicePowerState;
+    irpsp->Parameters.Power.State = state;
+    irp->IoStatus.Status = STATUS_NOT_SUPPORTED;
+    IoSetCompletionRoutine( irp, power_request_complete, request, TRUE, TRUE, TRUE );
+
+    if (out_irp) *out_irp = irp;
+    PoCallDriver( IoGetAttachedDevice( device ), irp );
+    return STATUS_PENDING;
 }
 
 /***********************************************************************
@@ -1138,8 +1205,26 @@
  */
 POWER_STATE WINAPI PoSetPowerState( DEVICE_OBJECT *device, POWER_STATE_TYPE type, POWER_STATE state)
 {
-    FIXME("device %p, type %u, state %u, stub!\n", device, type, state.DeviceState);
+    struct wine_device *wine_device = CONTAINING_RECORD(device, struct wine_device, device_obj);
+    POWER_STATE previous = {0};
+
+    TRACE("device %p, type %u, state %u.\n", device, type, state.DeviceState);
+
+    /* the state the device was in before; a device starts out unspecified */
+    if (type == SystemPowerState)
+    {
+        previous.SystemState = wine_device->system_power_state;
+        wine_device->system_power_state = state.SystemState;
+    }
+    else
+    {
+        previous.DeviceState = wine_device->device_power_state;
+        wine_device->device_power_state = state.DeviceState;
+    }
+#ifdef SG_MUTANT_POWER_PREVIOUS
     return state;
+#endif
+    return previous;
 }
 
 /*****************************************************
@@ -1147,7 +1232,8 @@
  */
 void WINAPI PoStartNextPowerIrp( IRP *irp )
 {
-    FIXME("irp %p, stub!\n", irp);
+    /* power IRPs are not serialized here, so there is no queue to start the next one of */
+    TRACE("irp %p.\n", irp);
 }
 
 /*****************************************************
diff --git a/dlls/ntoskrnl.exe/ntoskrnl_private.h b/dlls/ntoskrnl.exe/ntoskrnl_private.h
--- a/dlls/ntoskrnl.exe/ntoskrnl_private.h
+++ b/dlls/ntoskrnl.exe/ntoskrnl_private.h
@@ -125,5 +125,7 @@
 {
     DEVICE_OBJECT device_obj;
     DEVICE_RELATIONS *children;
+    SYSTEM_POWER_STATE system_power_state;  /* PoSetPowerState */
+    DEVICE_POWER_STATE device_power_state;
 };
 #endif
diff --git a/dlls/ntoskrnl.exe/tests/driver_pnp.c b/dlls/ntoskrnl.exe/tests/driver_pnp.c
--- a/dlls/ntoskrnl.exe/tests/driver_pnp.c
+++ b/dlls/ntoskrnl.exe/tests/driver_pnp.c
@@ -121,6 +121,27 @@
 
 static struct list device_list = LIST_INIT(device_list);
 
+/* PoRequestPowerIrp: the only power IRPs expected are the ones a device asks for itself */
+static BOOL expect_power_irp;
+static KEVENT power_event;
+static unsigned int power_complete_count;
+static UCHAR power_complete_minor;
+static DEVICE_POWER_STATE power_complete_state, power_prev_state;
+static NTSTATUS power_complete_status;
+static DEVICE_OBJECT *power_complete_device;
+static void *power_complete_context;
+
+static void WINAPI power_complete(DEVICE_OBJECT *device, UCHAR minor, POWER_STATE state, void *context, IO_STATUS_BLOCK *io)
+{
+    power_complete_device = device;
+    power_complete_minor = minor;
+    power_complete_state = state.DeviceState;
+    power_complete_context = context;
+    power_complete_status = io->Status;
+    power_complete_count++;
+    KeSetEvent(&power_event, IO_NO_INCREMENT, FALSE);
+}
+
 static FAST_MUTEX driver_lock;
 
 static NTSTATUS fdo_pnp(IRP *irp)
@@ -297,9 +318,30 @@
             IoSetDeviceInterfaceState(&device->child_symlink, TRUE);
 
             state = PoSetPowerState(device_obj, DevicePowerState, state);
-            todo_wine ok(state.DeviceState == device->power_state, "got previous state %u\n", state.DeviceState);
+            ok(state.DeviceState == device->power_state, "got previous state %u\n", state.DeviceState);
             device->power_state = PowerDeviceD0;
 
+            /* a power IRP the device asks for goes to the top of its stack and completes with the callback */
+            KeInitializeEvent(&power_event, NotificationEvent, FALSE);
+            power_complete_count = 0;
+            expect_power_irp = TRUE;
+            state.DeviceState = PowerDeviceD3;
+            status = PoRequestPowerIrp(device_obj, IRP_MN_SET_POWER, state, power_complete, device, NULL);
+            ok(status == STATUS_PENDING, "got status %#lx\n", status);
+            status = KeWaitForSingleObject(&power_event, Executive, KernelMode, FALSE, (LARGE_INTEGER *)&wait_time);
+            ok(!status, "failed to wait for the power completion, status %#lx\n", status);
+            expect_power_irp = FALSE;
+            ok(power_complete_count == 1, "got %u completions\n", power_complete_count);
+            ok(power_complete_device == device_obj, "got device %p\n", power_complete_device);
+            ok(power_complete_minor == IRP_MN_SET_POWER, "got minor %#x\n", power_complete_minor);
+            ok(power_complete_state == PowerDeviceD3, "got state %u\n", power_complete_state);
+            ok(power_complete_context == device, "got context %p\n", power_complete_context);
+            ok(power_complete_status == STATUS_SUCCESS, "got status %#lx\n", power_complete_status);
+            ok(power_prev_state == PowerDeviceD0, "the IRP's handler saw previous state %u\n", power_prev_state);
+            state.DeviceState = PowerDeviceD0;
+            state = PoSetPowerState(device_obj, DevicePowerState, state);
+            ok(state.DeviceState == PowerDeviceD3, "got previous state %u\n", state.DeviceState);
+
             status = ZwWaitForSingleObject(device->plug_event, TRUE, &wait_time);
             ok(!status, "Failed to wait for child plug event, status %#lx.\n", status);
             status = ZwSetEvent(device->plug_event2, NULL);
@@ -435,7 +477,7 @@
     NTSTATUS ret = STATUS_NOT_SUPPORTED;
 
     /* We do not expect power IRPs as part of normal operation. */
-    ok(0, "unexpected call\n");
+    ok(expect_power_irp, "unexpected call\n");
 
     if (device == bus_fdo)
     {
@@ -447,7 +489,7 @@
     if (stack->MinorFunction == IRP_MN_SET_POWER)
     {
         if (stack->Parameters.Power.Type == DevicePowerState)
-            PoSetPowerState(device, DevicePowerState, stack->Parameters.Power.State);
+            power_prev_state = PoSetPowerState(device, DevicePowerState, stack->Parameters.Power.State).DeviceState;
         ret = STATUS_SUCCESS;
     }
 
