-/* Servers listen on the loopback interface only, unless an administrator explicitly allowed
- * all interfaces by listing 0.0.0.0 in the HTTP service's ListenOnlyList setting. */
-static BOOL listen_on_all_interfaces(void)
+static BOOL parse_ipv4(const WCHAR *str, ULONG *addr)
+{
+    unsigned int octets[4], i;
+    const WCHAR *p = str;
+
+    for (i = 0; i < 4; i++)
+    {
+        unsigned int value = 0, digits = 0;
+
+        while (*p >= '0' && *p <= '9' && digits < 4) { value = value * 10 + (*p++ - '0'); digits++; }
+        if (!digits || value > 255) return FALSE;
+        octets[i] = value;
+        if (i < 3 && *p++ != '.') return FALSE;
+    }
+    if (*p) return FALSE;
+    *addr = octets[0] | (octets[1] << 8) | (octets[2] << 16) | (octets[3] << 24);
+    return TRUE;
+}
+
+/* The addresses the administrator limited the server to (HttpServiceConfigIPListenList);
+ * returns the number of addresses, 0 when there is no limit. */
+static unsigned int get_listen_only_list(ULONG *addrs, unsigned int max)
 {
     static const WCHAR path[] = L"\\Registry\\Machine\\System\\CurrentControlSet\\Services\\HTTP\\Parameters";
     static const WCHAR name[] = L"ListenOnlyList";
     UNICODE_STRING key_name, value_name;
     OBJECT_ATTRIBUTES attr;
     KEY_VALUE_PARTIAL_INFORMATION *info;
+    unsigned int count = 0;
     ULONG size = 0;
     HANDLE key;
-    BOOL ret = FALSE;
 
     RtlInitUnicodeString(&key_name, path);
     InitializeObjectAttributes(&attr, &key_name, OBJ_KERNEL_HANDLE | OBJ_CASE_INSENSITIVE, NULL, NULL);
-    if (ZwOpenKey(&key, KEY_QUERY_VALUE, &attr)) return FALSE;
+    if (ZwOpenKey(&key, KEY_QUERY_VALUE, &attr)) return 0;
 
     RtlInitUnicodeString(&value_name, name);
     ZwQueryValueKey(key, &value_name, KeyValuePartialInformation, NULL, 0, &size);
@@ -751,16 +779,65 @@ static BOOL listen_on_all_interfaces(void)
             const WCHAR *p = (const WCHAR *)info->Data;
             const WCHAR *end = (const WCHAR *)(info->Data + info->DataLength);
 
-            while (p < end && *p)
+            while (p < end && *p && count < max)
             {
-                if (!wcscmp(p, L"0.0.0.0")) ret = TRUE;
+                if (parse_ipv4(p, &addrs[count])) count++;
                 p += wcslen(p) + 1;
             }
         }
         free(info);
     }
     ZwClose(key);
-    return ret;
+    return count;
+}
+
+/* Works out where a URL is served, the way http.sys does: "+" and "*" and host names listen on all
+ * interfaces, an IP address on that address and localhost on the loopback interface; the listen
+ * list restricts all of them. */
+static unsigned int get_bind_addrs(const char *url, ULONG *addrs, unsigned int max)
+{
+    ULONG list[MAX_LISTEN_ADDRS], explicit_addr = INADDR_ANY;
+    unsigned int list_count, count = 0, i;
+    const char *host = url + 7, *end = strchr(host, ':');
+    char name[64];
+    WCHAR wname[64];
+    BOOL specific = FALSE;
+
+    if (end && (size_t)(end - host) < sizeof(name))
+    {
+        memcpy(name, host, end - host);
+        name[end - host] = 0;
+        if (!_stricmp(name, "localhost"))
+        {
+            explicit_addr = htonl(INADDR_LOOPBACK);
+            specific = TRUE;
+        }
+        else
+        {
+            for (i = 0; name[i]; i++) wname[i] = (unsigned char)name[i];
+            wname[i] = 0;
+            if (parse_ipv4(wname, &explicit_addr))
+                specific = TRUE;
+        }
+    }
+
+    list_count = get_listen_only_list(list, ARRAY_SIZE(list));
+    if (specific)
+    {
+        if (explicit_addr == INADDR_ANY) specific = FALSE; /* 0.0.0.0 means all addresses */
+        else if (!list_count) addrs[count++] = explicit_addr;
+        else
+            for (i = 0; i < list_count; i++)
+                if (list[i] == INADDR_ANY || list[i] == explicit_addr) { addrs[count++] = explicit_addr; break; }
+    }
+    if (!specific)
+    {
+        if (!list_count) addrs[count++] = INADDR_ANY;
+        else
+            for (i = 0; i < list_count && count < max; i++)
+                addrs[count++] = list[i];
+    }
+    return count;
 }
 
 /* Sends the whole buffer on a non-blocking socket. */
@@ -793,6 +870,66 @@ static BOOL send_all(SOCKET s, const char *buffer, int len)
     return TRUE;
 }
 
+static NTSTATUS create_listening_socket(unsigned short port, ULONG address, const char *url,
+        struct listening_socket **ret)
+{
+    struct listening_socket *listening_sock;
+    struct sockaddr_in addr = {0};
+    ULONG one = 1, value = 1;
+    SOCKET s;
+
+    if ((s = socket(AF_INET, SOCK_STREAM, 0)) == INVALID_SOCKET)
+    {
+        ERR("Failed to create socket, error %u.\n", WSAGetLastError());
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    addr.sin_family = AF_INET;
+    addr.sin_port = port;
+    addr.sin_addr.S_un.S_addr = address;
+    setsockopt(s, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, (char *)&value, sizeof(value));
+    if (bind(s, (struct sockaddr *)&addr, sizeof(addr)) == -1)
+    {
+        int error = WSAGetLastError();
+
+        closesocket(s);
+        if (error == WSAEADDRINUSE)
+        {
+            WARN("Address %s is already in use.\n", debugstr_a(url));
+            return STATUS_SHARING_VIOLATION;
+        }
+        else if (error == WSAEACCES)
+        {
+            WARN("Not enough permissions to bind to address %s.\n", debugstr_a(url));
+            return STATUS_ACCESS_DENIED;
+        }
+        ERR("Failed to bind socket, error %u.\n", error);
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    if (listen(s, SOMAXCONN) == -1)
+    {
+        ERR("Failed to listen to port %u, error %u.\n", port, WSAGetLastError());
+        closesocket(s);
+        return STATUS_OBJECT_NAME_COLLISION;
+    }
+
+    if (!(listening_sock = calloc(1, sizeof(*listening_sock))))
+    {
+        closesocket(s);
+        return STATUS_NO_MEMORY;
+    }
+    listening_sock->port = port;
+    listening_sock->addr = address;
+    listening_sock->socket = s;
+    list_add_head(&listening_sockets, &listening_sock->entry);
+
+    ioctlsocket(s, FIONBIO, &one);
+    WSAEventSelect(s, request_event, FD_ACCEPT);
+    *ret = listening_sock;
+    return STATUS_SUCCESS;
+}
