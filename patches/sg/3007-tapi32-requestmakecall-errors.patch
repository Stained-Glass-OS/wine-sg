From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Mon, 12 Oct 2026 10:01:00 -0700
Subject: [PATCH] tapi32: tapiRequestMakeCall reports why a request cannot be
 taken, TAPIERR_ constants (3007)

tapiRequestMakeCall checked nothing and returned 0 ("connected"). Assisted
telephony hands a request to the application registered with
lineRegisterRequestRecipient; with no telephony service there is no such
application, so it returns TAPIERR_NOREQUESTRECIPIENT, and an empty, missing or
overlong (80 characters) destination address is TAPIERR_INVALDESTADDRESS. tapi.h
gets the TAPIERR_ values (0 to -18) and TAPIMAXDESTADDRESSSIZE.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS

diff --git a/dlls/tapi32/assisted.c b/dlls/tapi32/assisted.c
index 298087d..35cfc87 100644
--- a/dlls/tapi32/assisted.c
+++ b/dlls/tapi32/assisted.c
@@ -122,6 +122,13 @@ DWORD WINAPI tapiGetLocationInfoA(LPSTR countrycode, LPSTR citycode)
 DWORD WINAPI tapiRequestMakeCallA(LPCSTR lpszDestAddress, LPCSTR lpszAppName,
                                  LPCSTR lpszCalledParty, LPCSTR lpszComment)
 {
-    FIXME("(%s, %s, %s, %s): stub.\n", lpszDestAddress, lpszAppName, lpszCalledParty, lpszComment);
-    return 0;
+    TRACE("(%s, %s, %s, %s)\n", debugstr_a(lpszDestAddress), debugstr_a(lpszAppName),
+          debugstr_a(lpszCalledParty), debugstr_a(lpszComment));
+
+    if (!lpszDestAddress || !lpszDestAddress[0] || strlen(lpszDestAddress) >= TAPIMAXDESTADDRESSSIZE)
+        return TAPIERR_INVALDESTADDRESS;
+
+    /* the request is passed on to the application registered with lineRegisterRequestRecipient;
+       there is no telephony service to register with, so nobody can ever be */
+    return TAPIERR_NOREQUESTRECIPIENT;
 }
diff --git a/include/tapi.h b/include/tapi.h
index 476a958..f3715a8 100644
--- a/include/tapi.h
+++ b/include/tapi.h
@@ -35,7 +35,26 @@ typedef HANDLE HLINEAPP, *LPHLINEAPP;
 typedef HANDLE HPHONE, *LPHPHONE;
 typedef HANDLE HPHONEAPP, *LPHPHONEAPP;
 
+#define TAPIERR_CONNECTED              __MSABI_LONG(0)
+#define TAPIERR_DROPPED                __MSABI_LONG(-1)
+#define TAPIERR_NOREQUESTRECIPIENT     __MSABI_LONG(-2)
+#define TAPIERR_REQUESTQUEUEFULL       __MSABI_LONG(-3)
+#define TAPIERR_INVALDESTADDRESS       __MSABI_LONG(-4)
+#define TAPIERR_INVALWINDOWHANDLE      __MSABI_LONG(-5)
+#define TAPIERR_INVALDEVICECLASS       __MSABI_LONG(-6)
+#define TAPIERR_INVALDEVICEID          __MSABI_LONG(-7)
+#define TAPIERR_DEVICECLASSUNAVAIL     __MSABI_LONG(-8)
+#define TAPIERR_DEVICEIDUNAVAIL        __MSABI_LONG(-9)
+#define TAPIERR_DEVICEINUSE            __MSABI_LONG(-10)
+#define TAPIERR_DESTBUSY               __MSABI_LONG(-11)
+#define TAPIERR_DESTNOANSWER           __MSABI_LONG(-12)
+#define TAPIERR_DESTUNAVAIL            __MSABI_LONG(-13)
+#define TAPIERR_UNKNOWNWINHANDLE       __MSABI_LONG(-14)
+#define TAPIERR_UNKNOWNREQUESTID       __MSABI_LONG(-15)
 #define TAPIERR_REQUESTFAILED          __MSABI_LONG(-16)
+#define TAPIERR_REQUESTCANCELLED       __MSABI_LONG(-17)
+#define TAPIERR_INVALPOINTER           __MSABI_LONG(-18)
+#define TAPIMAXDESTADDRESSSIZE         80
 #define LINEERR_ALLOCATED              0x80000001
 #define LINEERR_BADDEVICEID            0x80000002
 #define LINEERR_BEARERMODEUNAVAIL      0x80000003
