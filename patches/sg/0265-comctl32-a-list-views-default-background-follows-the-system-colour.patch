From: Stained Glass OS <dev@stained-glass.example>
Subject: comctl32: a list view's default background follows the window colour

A list view took COLOR_WINDOW for its background once, when it was made,
and kept it: after a switch to the dark scheme its rows turned dark (their
text colours are the system's) while the space around them stayed white
(QA B19, File Explorer in Details). Until a program sets a background of its
own (LVM_SETBKCOLOR), WM_SYSCOLORCHANGE now gives it the new window colour
and repaints it.

Gate: test/explorer-dark-gate.sh (a build without this fails its folder view
checks in both views).
---
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -312,6 +312,7 @@
   /* colors */
   HBRUSH hBkBrush;
   COLORREF clrBk;
+  BOOL bDefaultBkColor;         /* Stained Glass: the background is still COLOR_WINDOW's */
   COLORREF clrText;
   COLORREF clrTextBk;
   HBITMAP hBkBitmap;
@@ -10497,6 +10498,7 @@
   infoPtr->clrText = CLR_DEFAULT;
   infoPtr->clrTextBk = CLR_DEFAULT;
   LISTVIEW_SetBkColor(infoPtr, comctl32_color.clrWindow);
+  infoPtr->bDefaultBkColor = TRUE;
 
   /* set default values */
   infoPtr->nFocusedItem = -1;
@@ -12661,6 +12663,7 @@
     return LISTVIEW_Scroll(infoPtr, (INT)wParam, (INT)lParam);
 
   case LVM_SETBKCOLOR:
+    infoPtr->bDefaultBkColor = FALSE;
     return LISTVIEW_SetBkColor(infoPtr, (COLORREF)lParam);
 
   case LVM_SETBKIMAGEA:
@@ -12900,6 +12903,13 @@
 
   case WM_SYSCOLORCHANGE:
     COMCTL32_RefreshSysColors();
+    /* Stained Glass: a background nobody chose is the window colour's, now
+     * too -- a dark scheme (wine-sg 0160-0163) left it white behind dark rows */
+    if (infoPtr->bDefaultBkColor)
+    {
+        LISTVIEW_SetBkColor(infoPtr, comctl32_color.clrWindow);
+        InvalidateRect(infoPtr->hwndSelf, NULL, TRUE);
+    }
     return 0;
 
 /*	case WM_TIMER: */
