From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msscript, oledb32, shlwapi, shell32: behaviour the gates of rebased patches showed missing (5915)

Behaviour of rebased or reduced patches that their gates showed missing
(coordinator rule: no feature lost in a drop), and one interaction fix:
- msscript (3658 reduced to tests on fast-a 3081): IOleObject::SetExtent
  marks the control dirty and tells the IViewObject sink (OnViewChange);
  IOleObject::Close checks its save option (E_INVALIDARG) and sends OnClose
  to the advise sinks. Mutants SG_MUTANT_MSSCRIPT_EXTENT_SILENT,
  SG_MUTANT_MSSCRIPT_NO_ONCLOSE.
- oledb32 (3663 on fast-a 3029): a DB_NUMERIC source reaches I8 through
  3029's DECIMAL step; DECIMAL -> I8 was missing (E_NOTIMPL).
- shlwapi (3705's bags are fast-a 3235's): the folder of a view-state bag is
  named by a hash of its parsing name (3705's identity), not of the item id
  bytes, which carry times and sizes that differ between two id lists of
  the same folder; mutant SG_MUTANT_VIEWBAG_BYTEID.
- shell32 (3600): what a file system item answers itself (size, type,
  attributes, names, dates) is final also when empty (a folder has no size);
  the parent's column text, which GetDetailsEx falls back to since fast-b
  3701, is not asked. Mutant SG_MUTANT_SHITEM_ASK_PARENT.

Integration patch (integ-2026-10). Compile-checked; gates msscript
(fastb-gapmsscript), oledb (fastb-gapoledb), fastb-ebstate, fastb-shitem
still to be rerun on a build that has it.
---
diff --git a/dlls/msscript.ocx/msscript.c b/dlls/msscript.ocx/msscript.c
--- a/dlls/msscript.ocx/msscript.c
+++ b/dlls/msscript.ocx/msscript.c
@@ -3230,7 +3230,13 @@ static HRESULT WINAPI OleObject_Close(IOleObject *iface, DWORD save)
 
     TRACE("(%p)->(%ld)\n", This, save);
 
-    /* an invisible control has no in-place window to close */
+    if (save != OLECLOSE_SAVEIFDIRTY && save != OLECLOSE_NOSAVE && save != OLECLOSE_PROMPTSAVE)
+        return E_INVALIDARG;
+    /* an invisible control has no in-place window to close; the advise sinks hear of the closing
+     * (fast-b 3658, ported in 5915) */
+#ifndef SG_MUTANT_MSSCRIPT_NO_ONCLOSE
+    if (This->advise_holder) IOleAdviseHolder_SendOnClose(This->advise_holder);
+#endif
     return S_OK;
 }
 
@@ -3361,6 +3367,12 @@ static HRESULT WINAPI OleObject_SetExtent(IOleObject *iface, DWORD aspect, SIZEL
     if (aspect != DVASPECT_CONTENT) return DV_E_DVASPECT;
     if (!size) return E_POINTER;
     This->extent = *size;
+    /* the container's view sink hears of the new extent, and the control has changed (fast-b 3658,
+     * ported in 5915) */
+#ifndef SG_MUTANT_MSSCRIPT_EXTENT_SILENT
+    This->dirty = TRUE;
+    if (This->view_sink) IAdviseSink_OnViewChange(This->view_sink, DVASPECT_CONTENT, -1);
+#endif
     return S_OK;
 }
 
diff --git a/dlls/oledb32/convert.c b/dlls/oledb32/convert.c
--- a/dlls/oledb32/convert.c
+++ b/dlls/oledb32/convert.c
@@ -426,6 +426,7 @@ static HRESULT WINAPI convert_DataConvert(IDataConvert* iface,
         case DBTYPE_BSTR:        hr = VarI8FromStr(*(WCHAR**)src, LOCALE_USER_DEFAULT, 0, d); break;
         case DBTYPE_I8:          *d = *(LONGLONG*)src; hr = S_OK;              break;
         case DBTYPE_NUMERIC:     if ((hr = numeric_to_decimal(src, &numdec)) == S_OK) hr = VarI8FromDec(&numdec, d); break;
+        case DBTYPE_DECIMAL:     hr = VarI8FromDec((DECIMAL*)src, d);            break;
         default: FIXME("Unimplemented conversion %04x -> I8\n", src_type); return E_NOTIMPL;
         }
         break;
diff --git a/dlls/shell32/shellitem.c b/dlls/shell32/shellitem.c
--- a/dlls/shell32/shellitem.c
+++ b/dlls/shell32/shellitem.c
@@ -535,6 +535,21 @@ static HRESULT shellitem_get_variant(struct shell_item *This, const PROPERTYKEY
     hr = shellitem_get_value(This, key, var);
     if (FAILED(hr) || var->vt != VT_EMPTY || _ILIsDesktop(This->pidl))
         return hr;
+#ifndef SG_MUTANT_SHITEM_ASK_PARENT
+    {
+        /* what a file system item answers itself from its file is final, also "no value" (a folder
+         * has no size): the parent's column text is not asked (5915; the parent's GetDetailsEx falls
+         * back to column text since fast-b 3701) */
+        static const PROPERTYKEY *own[] = { &SI_FileName, &SI_ItemNameDisplayWithoutExtension, &SI_FileExtension,
+                                            &SI_ItemType, &SI_FileAttributes, &SI_Size, &SI_DateModified,
+                                            &SI_DateCreated, &SI_DateAccessed };
+        WCHAR path[MAX_PATH];
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(own); i++)
+            if (IsEqualPropertyKey(*key, *own[i]) && shellitem_fs_path(This, path)) return S_OK;
+    }
+#endif
 
     /* the folder the item is in may know it */
     if (SUCCEEDED(SHBindToParent(This->pidl, &IID_IShellFolder2, (void **)&folder, &child)))
diff --git a/dlls/shlwapi/ordinal.c b/dlls/shlwapi/ordinal.c
--- a/dlls/shlwapi/ordinal.c
+++ b/dlls/shlwapi/ordinal.c
@@ -4604,24 +4604,45 @@ static const IPropertyBagVtbl view_bag_vtbl =
 
 HRESULT WINAPI SHCreatePropertyBagOnRegKey(HKEY hKey, LPCWSTR subkey, DWORD grfMode, REFIID riid, void **ppv);
 
-/* a name for the first "levels" items of the pidl */
+/* a name for the first "levels" items of the pidl: a hash of their parsing name, so that it does not
+ * depend on the times and sizes an item id carries (fast-b 3705's identity, ported in 5915); an id list
+ * the shell cannot name is hashed as it is */
 static void view_pidl_id(const ITEMIDLIST *pidl, int levels, WCHAR id[17])
 {
+    typedef HRESULT (WINAPI *get_name_t)(PCIDLIST_ABSOLUTE, int, WCHAR **);
+    static get_name_t get_name;
     const BYTE *p = (const BYTE *)pidl;
     ULONGLONG hash = 14695981039346656037ULL;   /* FNV-1a */
+    UINT size = 0;
+    BYTE *copy;
+    WCHAR *str = NULL;
     int i;
 
 #ifdef SG_MUTANT_VIEWBAG_SAMEID
     levels = 0;
 #endif
-    for (i = 0; p && i < levels && *(const USHORT *)p; i++)
+    for (i = 0; p && i < levels && *(const USHORT *)(p + size); i++) size += *(const USHORT *)(p + size);
+    if (!get_name)
     {
-        USHORT cb = *(const USHORT *)p;
-        USHORT n;
-
-        for (n = 0; n < cb; n++) { hash ^= p[n]; hash *= 1099511628211ULL; }
-        p += cb;
+        HMODULE shell32 = LoadLibraryW(L"shell32.dll");
+        if (shell32) get_name = (get_name_t)GetProcAddress(shell32, "SHGetNameFromIDList");
     }
+#ifndef SG_MUTANT_VIEWBAG_BYTEID
+    if (get_name && (copy = calloc(1, size + 2)))
+    {
+        if (p) memcpy(copy, p, size);
+        if (get_name((PCIDLIST_ABSOLUTE)copy, 0x80028000 /* SIGDN_DESKTOPABSOLUTEPARSING */, &str) == S_OK && str)
+        {
+            for (i = 0; str[i]; i++) { hash ^= towlower(str[i]); hash *= 1099511628211ULL; }
+            CoTaskMemFree(str);
+            free(copy);
+            swprintf(id, 17, L"%08x%08x", (unsigned int)(hash >> 32), (unsigned int)hash);
+            return;
+        }
+        free(copy);
+    }
+#endif
+    for (i = 0; i < (int)size; i++) { hash ^= p[i]; hash *= 1099511628211ULL; }
     swprintf(id, 17, L"%08x%08x", (unsigned int)(hash >> 32), (unsigned int)hash);
 }
 
