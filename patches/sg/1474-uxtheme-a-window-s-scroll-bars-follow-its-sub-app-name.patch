From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] uxtheme: a window's scroll bars follow its sub-app name

Windows' programs ask for dark scroll bars with
SetWindowTheme( hwnd, L"DarkMode_Explorer", NULL ). A window's own scroll
bars (WS_VSCROLL, WS_HSCROLL) were drawn with the plain ScrollBar class,
the window's sub-app name not looked at, so they stayed light. They are
drawn by the class under that name now when the style has it, without
making it the window's theme. The style's DarkMode_Explorer::ScrollBar
sections are generated by theme/dark.py from the Dark scheme's.

Gate: test/darkscroll-gate.sh. Mutant: SG_MUTANT_NO_PART_SUBAPP.
---
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -840,6 +840,26 @@
     return hTheme;
 }
 
+/* Stained Glass OS (wine-sg 1474): the theme of a part of a window that is
+ * not a control of its own -- its scroll bars -- by the sub-app name
+ * SetWindowTheme gave the window ("DarkMode_Explorer": a program's dark
+ * scroll bars), without making it the window's theme. They were drawn with
+ * the plain class, the sub-app name not looked at. */
+HTHEME UXTHEME_OpenPartTheme(HWND hwnd, LPCWSTR class_list, UINT dpi)
+{
+    WCHAR app[256];
+    LPCWSTR name;
+    HTHEME theme = NULL;
+
+    UXTHEME_FollowThemeChange();
+    if (!bThemeActive) return NULL;
+#ifndef SG_MUTANT_NO_PART_SUBAPP
+    if ((name = UXTHEME_GetWindowProperty(hwnd, atSubAppName, app, ARRAY_SIZE(app))) && name[0])
+        theme = MSSTYLES_OpenThemeClass(name, class_list, dpi);
+#endif
+    return theme ? theme : OpenThemeDataForDpi(NULL, class_list, dpi);
+}
+
 /***********************************************************************
  *      OpenThemeDataEx                                     (UXTHEME.61)
  */
--- a/dlls/uxtheme/scrollbar.c
+++ b/dlls/uxtheme/scrollbar.c
@@ -44,7 +44,7 @@
     if (bar == SB_CTL)
         theme = GetWindowTheme(hwnd);
     else
-        theme = OpenThemeDataForDpi(NULL, WC_SCROLLBARW, GetDpiForWindow(hwnd));
+        theme = UXTHEME_OpenPartTheme(hwnd, WC_SCROLLBARW, GetDpiForWindow(hwnd));
 
     if (!theme)
     {
--- a/dlls/uxtheme/uxthemedll.h
+++ b/dlls/uxtheme/uxthemedll.h
@@ -104,6 +104,7 @@
 extern void UXTHEME_InitSystem(HINSTANCE hInst);
 extern HRESULT UXTHEME_SetActiveTheme(PTHEME_FILE tf);
 extern void UXTHEME_UninitSystem(void);
+extern HTHEME UXTHEME_OpenPartTheme(HWND hwnd, LPCWSTR class_list, UINT dpi);
 
 extern struct user_api_hook user_api;
 LRESULT WINAPI UXTHEME_DefDlgProc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, BOOL unicode);
