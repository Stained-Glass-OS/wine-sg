+/* The triangles that fill the geometry: it is flattened and joined with itself, a path of the
+ * resulting figures is closed (which triangulates it) and its faces are handed to the sink. */
+HRESULT d2d_geometry_tessellate(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        ID2D1TessellationSink *sink)
+{
+    ID2D1GeometrySink *path_sink = NULL;
+    ID2D1PathGeometry *path = NULL;
+    struct d2d_geometry *path_impl;
+    ID2D1Factory *factory = NULL;
+    D2D1_TRIANGLE triangles[64];
+    struct flat_sink flat;
+    size_t i, n;
+    HRESULT hr;
+
+    if (!sink)
+        return E_INVALIDARG;
+#ifdef SG_MUTANT_D2D_TESS_NOTHING
+    return S_OK;
+#endif
+
+    if (FAILED(hr = flatten_filled(geometry, transform, tolerance, &flat)))
+    {
+        flat_cleanup(&flat);
+        return hr;
+    }
+
+    ID2D1Geometry_GetFactory(geometry, &factory);
+    if (SUCCEEDED(hr = ID2D1Factory_CreatePathGeometry(factory, &path))
+            && SUCCEEDED(hr = ID2D1PathGeometry_Open(path, &path_sink)))
+    {
+        ID2D1GeometrySink_SetFillMode(path_sink, flat.fill_mode);
+        for (i = 0; i < flat.figure_count; ++i)
+        {
+            const struct flat_figure *fig = &flat.figures[i];
+
+            if (fig->count < 3)
+                continue;
+            ID2D1GeometrySink_BeginFigure(path_sink, fig->points[0], D2D1_FIGURE_BEGIN_FILLED);
+            ID2D1GeometrySink_AddLines(path_sink, &fig->points[1], fig->count - 1);
+            ID2D1GeometrySink_EndFigure(path_sink, D2D1_FIGURE_END_CLOSED);
+        }
+        hr = ID2D1GeometrySink_Close(path_sink);
+        ID2D1GeometrySink_Release(path_sink);
+    }
+    flat_cleanup(&flat);
+    ID2D1Factory_Release(factory);
+
+    if (SUCCEEDED(hr))
+    {
+        path_impl = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)path);
+        for (i = 0, n = 0; i < path_impl->fill.face_count; ++i)
+        {
+            const struct d2d_face *face = &path_impl->fill.faces[i];
+
+            triangles[n].point1 = path_impl->fill.vertices[face->v[0]];
+            triangles[n].point2 = path_impl->fill.vertices[face->v[1]];
+            triangles[n].point3 = path_impl->fill.vertices[face->v[2]];
+            if (++n == ARRAY_SIZE(triangles))
+            {
+                ID2D1TessellationSink_AddTriangles(sink, triangles, n);
+                n = 0;
+            }
+        }
+        if (n)
+            ID2D1TessellationSink_AddTriangles(sink, triangles, n);
+    }
+    if (path)
+        ID2D1PathGeometry_Release(path);
+    return hr;
+}
