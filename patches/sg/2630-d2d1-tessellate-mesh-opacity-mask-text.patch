+/* The brush through the alpha of the mask bitmap: a rectangle filled with the brush, whose opacity
+ * comes from a bitmap brush that puts the source rectangle of the mask on the destination rectangle. */
+static void d2d_device_context_fill_opacity_mask(ID2D1DeviceContext6 *iface, struct d2d_device_context *context,
+        ID2D1Bitmap *mask, ID2D1Brush *brush, const D2D1_RECT_F *dst_rect, const D2D1_RECT_F *src_rect)
+{
+    D2D1_BITMAP_BRUSH_PROPERTIES bitmap_brush_desc;
+    D2D1_BRUSH_PROPERTIES brush_desc;
+    ID2D1BitmapBrush *opacity_brush;
+    ID2D1RectangleGeometry *rectangle;
+    D2D1_RECT_F src, dst;
+    D2D1_SIZE_F size;
+    float sx, sy;
+
+    if (!mask || !brush)
+        return;
+
+    size = ID2D1Bitmap_GetSize(mask);
+    d2d_rect_set(&src, 0.0f, 0.0f, size.width, size.height);
+    if (src_rect)
+        src = *src_rect;
+    dst = dst_rect ? *dst_rect : (D2D1_RECT_F){0.0f, 0.0f, src.right - src.left, src.bottom - src.top};
+    if (src.right <= src.left || src.bottom <= src.top || dst.right <= dst.left || dst.bottom <= dst.top)
+        return;
+
+    sx = (dst.right - dst.left) / (src.right - src.left);
+    sy = (dst.bottom - dst.top) / (src.bottom - src.top);
+
+    bitmap_brush_desc.extendModeX = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_brush_desc.extendModeY = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_brush_desc.interpolationMode = D2D1_BITMAP_INTERPOLATION_MODE_LINEAR;
+    brush_desc.opacity = 1.0f;
+    brush_desc.transform._11 = sx;
+    brush_desc.transform._12 = 0.0f;
+    brush_desc.transform._21 = 0.0f;
+    brush_desc.transform._22 = sy;
+    brush_desc.transform._31 = dst.left - src.left * sx;
+    brush_desc.transform._32 = dst.top - src.top * sy;
+
+    if (FAILED(ID2D1RenderTarget_CreateBitmapBrush((ID2D1RenderTarget *)iface, mask, &bitmap_brush_desc, &brush_desc,
+            &opacity_brush)))
+    {
+        WARN("Failed to create the opacity brush.\n");
+        return;
+    }
+    if (SUCCEEDED(ID2D1Factory_CreateRectangleGeometry(context->factory, &dst, &rectangle)))
+    {
+        if (FAILED(context->error.code))
+            ;
+        else if (context->target.type == D2D_TARGET_COMMAND_LIST)
+            ID2D1RenderTarget_FillGeometry((ID2D1RenderTarget *)iface, (ID2D1Geometry *)rectangle, brush,
+                    (ID2D1Brush *)opacity_brush);
+        else
+            d2d_device_context_fill_geometry(context, unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)rectangle),
+                    unsafe_impl_from_ID2D1Brush(brush),
+#ifdef SG_MUTANT_D2D_MASK_IGNORED
+                    NULL);
+#else
+                    unsafe_impl_from_ID2D1Brush((ID2D1Brush *)opacity_brush));
+#endif
+        ID2D1RectangleGeometry_Release(rectangle);
+    }
+    ID2D1BitmapBrush_Release(opacity_brush);
 }
 
