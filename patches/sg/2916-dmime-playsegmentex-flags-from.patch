     IDirectMusicSegment *segment;
     REFERENCE_TIME time;
     MUSIC_TIME music_time;
@@ -2235,8 +2289,7 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
             transition, segment_flags, start_time, segment_state, from, audio_path);
 
     if (segment_flags & ~handled_flags) FIXME("flags %#lx not implemented\n", segment_flags & ~handled_flags);
-    if (transition) FIXME("transition %p not implemented\n", transition);
-    if (from) FIXME("from %p not implemented\n", from);
+    if (segment_flags & DMUS_SEGF_AUTOTRANSITION) FIXME("transition %p not implemented\n", transition);
 
     if (!source) return E_POINTER;
     if (!This->dmusic) return DMUS_E_NO_MASTER_CLOCK;
@@ -2250,6 +2303,14 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
         return hr;
     }
 
+    /* the segment state, or all of an audio path, which the new segment replaces at its start */
+    if (from && FAILED(IUnknown_QueryInterface(from, &IID_IDirectMusicSegmentState, (void **)&from_state))
+            && FAILED(IUnknown_QueryInterface(from, &IID_IDirectMusicAudioPath, (void **)&from_path)))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
     /* The time is in music time unless the DMUS_SEGF_REFTIME flag is set, zero means now.
      * It is moved forward to the next boundary which the flags ask for, the segment's
      * default resolution is used for DMUS_SEGF_DEFAULT. Grid, beat and measure boundaries are the ones
@@ -2278,7 +2339,42 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
         LIST_FOR_EACH_ENTRY_SAFE(entry, next, &states, struct state_entry, entry) state_entry_destroy(entry);
         LeaveCriticalSection(&This->safe);
 
-        if (!playing) resolve &= ~(DMUS_SEGF_GRID | DMUS_SEGF_BEAT | DMUS_SEGF_MEASURE);
+#ifdef SG_MUTANT_TIMESIG_ALWAYS
+        if (!playing)
+#else
+        if (!playing && !(flags & DMUS_SEGF_TIMESIG_ALWAYS))
+#endif
+            resolve &= ~(DMUS_SEGF_GRID | DMUS_SEGF_BEAT | DMUS_SEGF_MEASURE);
+    }
+
+    /* DMUS_SEGF_QUEUE: a primary segment starts when the primary segments which are queued before it end */
+    if ((flags & DMUS_SEGF_QUEUE) && primary)
+    {
+        struct list states = LIST_INIT(states);
+        struct state_entry *entry, *next;
+        MUSIC_TIME end = 0, current;
+
+        IDirectMusicPerformance8_GetTime(iface, NULL, &current);
+        EnterCriticalSection(&This->safe);
+        if (This->primary_segment) enum_segment_states(This, This->primary_segment, &states);
+        LIST_FOR_EACH_ENTRY_SAFE(entry, next, &states, struct state_entry, entry)
+        {
+            MUSIC_TIME state_start, state_end;
+
+            segment_state_get_times(entry->state, &state_start, &state_end);
+            end = max(end, state_end);
+            state_entry_destroy(entry);
+        }
+        LeaveCriticalSection(&This->safe);
+
+#ifdef SG_MUTANT_PLAY_QUEUE
+        end = 0;
+#endif
+        if (end > current)
+        {
+            start_time = end;
+            flags &= ~DMUS_SEGF_REFTIME;
+        }
     }
 
 #ifdef SG_MUTANT_PLAY_REFTIME
@@ -2307,6 +2403,19 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
 
     EnterCriticalSection(&This->safe);
 
+    /* the new segment replaces the segment state or the audio path which it comes from */
+#ifndef SG_MUTANT_PLAY_FROM
+    if (from_state) IDirectMusicPerformance8_Stop(iface, NULL, from_state, music_time, 0);
+#endif
+    if (from_path) IDirectMusicPerformance8_StopEx(iface, (IUnknown *)from_path, music_time, 0);
+
+    /* the primary segment is invalidated (plays again from the start time of the new segment on) first */
+#ifdef SG_MUTANT_PLAY_INVALIDATE
+    segment_flags &= ~DMUS_SEGF_INVALIDATE_PRI;
+#endif
+    if ((segment_flags & DMUS_SEGF_INVALIDATE_PRI) && This->primary_segment)
+        performance_invalidate_states(This, This->primary_segment, music_time);
+
     if (primary) performance_set_primary_segment(This, segment);
     if (control) performance_set_control_segment(This, segment);
 
@@ -2318,6 +2427,17 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
         goto done;
     }
 
+    /* the segment starts at a valid start point on the asked for boundary, DMUS_SEGF_ALIGN puts that start
+     * point on the resolved boundary, which is where the state starts to play anyway */
+    if (segment_flags & valid_start_flags)
+    {
+        MUSIC_TIME point;
+#ifndef SG_MUTANT_VALID_START
+        if (segment_find_valid_start(segment, segment_flags, &point))
+            segment_state_set_start_point(state, point);
+#endif
+    }
+
     if (FAILED(hr = segment_state_play(state, iface)))
     {
         ERR("Failed to play segment state, hr %#lx\n", hr);
@@ -2334,6 +2454,8 @@ static HRESULT WINAPI performance_PlaySegmentEx(IDirectMusicPerformance8 *iface,
 
     IDirectMusicSegmentState_Release(state);
 done:
+    if (from_state) IDirectMusicSegmentState_Release(from_state);
+    if (from_path) IDirectMusicAudioPath_Release(from_path);
     if (path) IDirectMusicAudioPath_Release(path);
     IDirectMusicSegment_Release(segment);
     return hr;
