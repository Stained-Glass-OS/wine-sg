     static const DWORD handled_flags = DMUS_SEGF_REFTIME | DMUS_SEGF_SECONDARY | DMUS_SEGF_CONTROL
-            | DMUS_SEGF_DEFAULT | resolve_flags;
+            | DMUS_SEGF_DEFAULT | DMUS_SEGF_QUEUE | DMUS_SEGF_NOINVALIDATE | DMUS_SEGF_ALIGN
+            | DMUS_SEGF_TIMESIG_ALWAYS | DMUS_SEGF_USE_AUDIOPATH | DMUS_SEGF_INVALIDATE_PRI
+            | valid_start_flags | resolve_flags;
     BOOL primary = !(segment_flags & DMUS_SEGF_SECONDARY), control = (segment_flags & DMUS_SEGF_CONTROL);
     struct performance *This = impl_from_IDirectMusicPerformance8(iface);
     IDirectMusicAudioPath *path = NULL;
-    IDirectMusicSegmentState *state;
+    IDirectMusicSegmentState *state, *from_state = NULL;
