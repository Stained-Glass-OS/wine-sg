+/* The first valid start point (marker track) of the segment from its start point on which is on a boundary
+ * which the DMUS_SEGF_VALID_START_* flags ask for, in the time signature of the segment (4/4 with two grids
+ * per beat by default). */
+static BOOL segment_find_valid_start(IDirectMusicSegment *segment, DWORD flags, MUSIC_TIME *ret_point)
+{
+    DMUS_TIMESIGNATURE sig = {0, 4, 4, 2};
+    MUSIC_TIME start = 0, length = 0, time, beat, grid, measure;
+    unsigned int i;
+
+    IDirectMusicSegment_GetStartPoint(segment, &start);
+    IDirectMusicSegment_GetLength(segment, &length);
+    IDirectMusicSegment_GetParam(segment, &GUID_TimeSignature, -1, DMUS_SEG_ANYTRACK, 0, NULL, &sig);
+
+    beat = DMUS_PPQ * 4 / max(sig.bBeat, 1);
+    grid = beat / max(sig.wGridsPerBeat, 1);
+    measure = beat * max(sig.bBeatsPerMeasure, 1);
+
+    for (i = 0, time = start; i < 4096; i++)
+    {
+        DMUS_VALID_START_PARAM param;
+        MUSIC_TIME point;
+
+        if (IDirectMusicSegment_GetParam(segment, &GUID_Valid_Start_Time, -1, DMUS_SEG_ANYTRACK, time, NULL,
+                &param) != S_OK)
+            return FALSE;
+        point = time + param.mtTime;
+        if (point >= length) return FALSE;
+
+        if ((flags & DMUS_SEGF_VALID_START_TICK)
+                || ((flags & DMUS_SEGF_VALID_START_GRID) && grid > 0 && !(point % grid))
+                || ((flags & DMUS_SEGF_VALID_START_BEAT) && !(point % beat))
+                || ((flags & DMUS_SEGF_VALID_START_MEASURE) && !(point % measure)))
+        {
+            *ret_point = point;
+            return TRUE;
+        }
+        time = point + 1;
+    }
+    return FALSE;
+}
