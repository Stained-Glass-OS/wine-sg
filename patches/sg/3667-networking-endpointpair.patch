+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(hostname);
+
+/* EndpointPair is a plain property bag: two host names and two service names. */
+
+struct endpoint_pair
+{
+    IEndpointPair IEndpointPair_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    IHostName *local_host, *remote_host;
+    HSTRING local_service, remote_service;
+};
+
+static inline struct endpoint_pair *impl_from_IEndpointPair( IEndpointPair *iface )
+{
+    return CONTAINING_RECORD( iface, struct endpoint_pair, IEndpointPair_iface );
+}
+
+static HRESULT WINAPI pair_QueryInterface( IEndpointPair *iface, REFIID iid, void **out )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IEndpointPair ))
+    {
+        IInspectable_AddRef( (*out = &impl->IEndpointPair_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pair_AddRef( IEndpointPair *iface )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI pair_Release( IEndpointPair *iface )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->local_host) IHostName_Release( impl->local_host );
+        if (impl->remote_host) IHostName_Release( impl->remote_host );
+        WindowsDeleteString( impl->local_service );
+        WindowsDeleteString( impl->remote_service );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI pair_GetIids( IEndpointPair *iface, ULONG *iid_count, IID **iids )
+{
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IEndpointPair;
+    *iid_count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI pair_GetRuntimeClassName( IEndpointPair *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_Networking_EndpointPair,
+                                wcslen( RuntimeClass_Windows_Networking_EndpointPair ), class_name );
+}
+
+static HRESULT WINAPI pair_GetTrustLevel( IEndpointPair *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT get_host( struct endpoint_pair *impl, IHostName **member, IHostName **value )
+{
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if ((*value = *member))
+    {
+#ifndef SG_MUTANT_PAIR_ADDREF
+        IHostName_AddRef( *value );
+#endif
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT set_host( struct endpoint_pair *impl, IHostName **member, IHostName *value )
+{
+    IHostName *old;
+
+    if (value) IHostName_AddRef( value );
+    EnterCriticalSection( &impl->cs );
+    old = *member;
+    *member = value;
+    LeaveCriticalSection( &impl->cs );
+    if (old) IHostName_Release( old );
+    return S_OK;
+}
+
+static HRESULT get_service( struct endpoint_pair *impl, HSTRING *member, HSTRING *value )
+{
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    hr = WindowsDuplicateString( *member, value );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT set_service( struct endpoint_pair *impl, HSTRING *member, HSTRING value )
+{
+    HSTRING copy, old;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_PAIR_SETSVC
+    return S_OK;
+#endif
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    EnterCriticalSection( &impl->cs );
+    old = *member;
+    *member = copy;
+    LeaveCriticalSection( &impl->cs );
+    WindowsDeleteString( old );
+    return S_OK;
+}
+
+static HRESULT WINAPI pair_get_LocalHostName( IEndpointPair *iface, IHostName **value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_host( impl, &impl->local_host, value );
+}
+
+static HRESULT WINAPI pair_put_LocalHostName( IEndpointPair *iface, IHostName *value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return set_host( impl, &impl->local_host, value );
+}
+
+static HRESULT WINAPI pair_get_LocalServiceName( IEndpointPair *iface, HSTRING *value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_service( impl, &impl->local_service, value );
+}
+
+static HRESULT WINAPI pair_put_LocalServiceName( IEndpointPair *iface, HSTRING value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    return set_service( impl, &impl->local_service, value );
+}
+
+static HRESULT WINAPI pair_get_RemoteHostName( IEndpointPair *iface, IHostName **value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_host( impl, &impl->remote_host, value );
+}
+
+static HRESULT WINAPI pair_put_RemoteHostName( IEndpointPair *iface, IHostName *value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return set_host( impl, &impl->remote_host, value );
+}
+
+static HRESULT WINAPI pair_get_RemoteServiceName( IEndpointPair *iface, HSTRING *value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return get_service( impl, &impl->remote_service, value );
+}
+
+static HRESULT WINAPI pair_put_RemoteServiceName( IEndpointPair *iface, HSTRING value )
+{
+    struct endpoint_pair *impl = impl_from_IEndpointPair( iface );
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+    return set_service( impl, &impl->remote_service, value );
+}
+
+static const struct IEndpointPairVtbl pair_vtbl =
+{
+    pair_QueryInterface,
+    pair_AddRef,
+    pair_Release,
+    /* IInspectable methods */
+    pair_GetIids,
+    pair_GetRuntimeClassName,
+    pair_GetTrustLevel,
+    /* IEndpointPair methods */
+    pair_get_LocalHostName,
+    pair_put_LocalHostName,
+    pair_get_LocalServiceName,
+    pair_put_LocalServiceName,
+    pair_get_RemoteHostName,
+    pair_put_RemoteHostName,
+    pair_get_RemoteServiceName,
+    pair_put_RemoteServiceName,
+};
+
+/* ---- factory ---- */
+
+struct pair_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IEndpointPairFactory IEndpointPairFactory_iface;
+    LONG ref;
+};
+
+static inline struct pair_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct pair_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct pair_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*out = &impl->IActivationFactory_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IEndpointPairFactory ))
+    {
+        IInspectable_AddRef( (*out = &impl->IEndpointPairFactory_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IEndpointPairFactory;
+    *iid_count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return pair_GetRuntimeClassName( NULL, class_name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    return pair_GetTrustLevel( NULL, trust_level );
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p: EndpointPair has no default constructor.\n", iface, instance );
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( pair_factory, IEndpointPairFactory, struct pair_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI pair_factory_CreateEndpointPair( IEndpointPairFactory *iface, IHostName *host, HSTRING service,
+                                                       IHostName *remote_host, HSTRING remote_service,
+                                                       IEndpointPair **value )
+{
+    struct endpoint_pair *impl;
+    HRESULT hr;
+
+    TRACE( "iface %p, host %p, service %s, remote_host %p, remote_service %s, value %p.\n", iface, host,
+           debugstr_hstring( service ), remote_host, debugstr_hstring( remote_service ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IEndpointPair_iface.lpVtbl = &pair_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": endpoint_pair.cs");
+
+    if ((impl->local_host = host)) IHostName_AddRef( host );
+    if ((impl->remote_host = remote_host)) IHostName_AddRef( remote_host );
+#ifdef SG_MUTANT_PAIR_SWAP
+    service = remote_service;
+#endif
+    if (FAILED(hr = WindowsDuplicateString( service, &impl->local_service )) ||
+        FAILED(hr = WindowsDuplicateString( remote_service, &impl->remote_service )))
+    {
+        IEndpointPair_Release( &impl->IEndpointPair_iface );
+        return hr;
+    }
+
+    *value = &impl->IEndpointPair_iface;
+    return S_OK;
+}
+
+static const struct IEndpointPairFactoryVtbl pair_factory_vtbl =
+{
+    pair_factory_QueryInterface,
+    pair_factory_AddRef,
+    pair_factory_Release,
+    /* IInspectable methods */
+    pair_factory_GetIids,
+    pair_factory_GetRuntimeClassName,
+    pair_factory_GetTrustLevel,
+    /* IEndpointPairFactory methods */
+    pair_factory_CreateEndpointPair,
+};
+
+static struct pair_statics pair_statics =
+{
+    {&factory_vtbl},
+    {&pair_factory_vtbl},
+    1,
+};
+
+IActivationFactory *endpointpair_factory = &pair_statics.IActivationFactory_iface;
diff --git a/dlls/windows.networking.hostname/main.c b/dlls/windows.networking.hostname/main.c
index 14711a8..7666536 100644
--- a/dlls/windows.networking.hostname/main.c
+++ b/dlls/windows.networking.hostname/main.c
@@ -41,6 +41,9 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
     if (!wcscmp( buffer, RuntimeClass_Windows_Networking_HostName ))
         IActivationFactory_QueryInterface( hostname_factory, &IID_IActivationFactory, (void **)factory );
 
+    else if (!wcscmp( buffer, RuntimeClass_Windows_Networking_EndpointPair ))
+        IActivationFactory_QueryInterface( endpointpair_factory, &IID_IActivationFactory, (void **)factory );
+
     if (*factory) return S_OK;
     return CLASS_E_CLASSNOTAVAILABLE;
 }
diff --git a/dlls/windows.networking.hostname/private.h b/dlls/windows.networking.hostname/private.h
index 5c43a41..61480c8 100644
--- a/dlls/windows.networking.hostname/private.h
+++ b/dlls/windows.networking.hostname/private.h
@@ -37,6 +37,7 @@
 #include "windows.networking.connectivity.h"
 
 extern IActivationFactory *hostname_factory;
+extern IActivationFactory *endpointpair_factory;
 
 #define DEFINE_IINSPECTABLE_( pfx, iface_type, impl_type, impl_from, iface_mem, expr )             \
     static inline impl_type *impl_from( iface_type *iface )                                        \
diff --git a/dlls/windows.networking.hostname/tests/hostname.c b/dlls/windows.networking.hostname/tests/hostname.c
index 26af82a..78d029a 100644
--- a/dlls/windows.networking.hostname/tests/hostname.c
+++ b/dlls/windows.networking.hostname/tests/hostname.c
@@ -161,6 +161,97 @@ static void test_statics_and_stringable( IActivationFactory *factory, IHostName
     IStringable_Release( stringable );
 }
 
+static void test_EndpointPair( IHostNameFactory *hostfactory )
+{
+    static const WCHAR *name = L"Windows.Networking.EndpointPair";
+    IEndpointPairFactory *pair_factory;
+    IActivationFactory *factory;
+    IHostName *local, *remote, *got;
+    IEndpointPair *pair;
+    HSTRING_HEADER h1, h2, h3, h4;
+    HSTRING s_name, local_name, remote_name, local_svc, remote_svc, str;
+    IInspectable *inspectable;
+    INT32 cmp;
+    HRESULT hr;
+    ULONG ref;
+
+    hr = WindowsCreateString( name, wcslen( name ), &s_name );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = RoGetActivationFactory( s_name, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( s_name );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ), "got hr %#lx.\n", hr );
+    if (hr == REGDB_E_CLASSNOTREG)
+    {
+        win_skip( "%s runtimeclass not registered, skipping tests.\n", wine_dbgstr_w( name ) );
+        return;
+    }
+    check_interface( factory, &IID_IAgileObject );
+    hr = IActivationFactory_ActivateInstance( factory, &inspectable );
+    ok( hr == E_NOTIMPL, "got hr %#lx.\n", hr );
+    hr = IActivationFactory_QueryInterface( factory, &IID_IEndpointPairFactory, (void **)&pair_factory );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    WindowsCreateStringReference( L"192.168.1.5", 11, &h1, &local_name );
+    WindowsCreateStringReference( L"10.0.0.1", 8, &h2, &remote_name );
+    WindowsCreateStringReference( L"1234", 4, &h3, &local_svc );
+    WindowsCreateStringReference( L"http", 4, &h4, &remote_svc );
+    hr = IHostNameFactory_CreateHostName( hostfactory, local_name, &local );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IHostNameFactory_CreateHostName( hostfactory, remote_name, &remote );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = IEndpointPairFactory_CreateEndpointPair( pair_factory, local, local_svc, remote, remote_svc, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    hr = IEndpointPairFactory_CreateEndpointPair( pair_factory, local, local_svc, remote, remote_svc, &pair );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( pair, &IID_IAgileObject );
+
+    hr = IEndpointPair_get_LocalHostName( pair, &got );
+    ok( hr == S_OK && got == local, "got hr %#lx, host %p.\n", hr, got );
+    IHostName_Release( got );
+    hr = IEndpointPair_get_RemoteHostName( pair, &got );
+    ok( hr == S_OK && got == remote, "got hr %#lx, host %p.\n", hr, got );
+    IHostName_Release( got );
+    hr = IEndpointPair_get_LocalServiceName( pair, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsCompareStringOrdinal( str, local_svc, &cmp );
+    ok( !cmp, "got local service %s.\n", debugstr_hstring( str ) );
+    WindowsDeleteString( str );
+    hr = IEndpointPair_get_RemoteServiceName( pair, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsCompareStringOrdinal( str, remote_svc, &cmp );
+    ok( !cmp, "got remote service %s.\n", debugstr_hstring( str ) );
+    WindowsDeleteString( str );
+    hr = IEndpointPair_get_LocalHostName( pair, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+
+    /* setters replace the values */
+    hr = IEndpointPair_put_LocalHostName( pair, remote );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IEndpointPair_get_LocalHostName( pair, &got );
+    ok( hr == S_OK && got == remote, "got hr %#lx, host %p.\n", hr, got );
+    IHostName_Release( got );
+    hr = IEndpointPair_put_RemoteServiceName( pair, local_svc );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IEndpointPair_get_RemoteServiceName( pair, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsCompareStringOrdinal( str, local_svc, &cmp );
+    ok( !cmp, "got remote service %s.\n", debugstr_hstring( str ) );
+    WindowsDeleteString( str );
+    hr = IEndpointPair_put_RemoteHostName( pair, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IEndpointPair_get_RemoteHostName( pair, &got );
+    ok( hr == S_OK && !got, "got hr %#lx, host %p.\n", hr, got );
+
+    IEndpointPair_Release( pair );
+    ref = IHostName_Release( local );
+    ok( !ref, "got ref %lu.\n", ref );
+    ref = IHostName_Release( remote );
+    ok( !ref, "got ref %lu.\n", ref );
+    IEndpointPairFactory_Release( pair_factory );
+    IActivationFactory_Release( factory );
+}
+
 static void test_HostnameStatics(void)
 {
     static const WCHAR *hostname_statics_name = L"Windows.Networking.HostName";
@@ -221,6 +312,7 @@ static void test_HostnameStatics(void)
 
     test_HostName_properties( hostnamefactory, hostname );
     test_statics_and_stringable( factory, hostname );
+    test_EndpointPair( hostnamefactory );
 
     WindowsDeleteString( str );
     WindowsDeleteString( rawname );
