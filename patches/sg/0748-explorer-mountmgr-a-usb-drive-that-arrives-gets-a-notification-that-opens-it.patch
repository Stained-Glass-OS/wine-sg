+/* Stained Glass OS: the owner hears of its balloon, as on Windows --
+ * NIN_BALLOONSHOW, NIN_BALLOONUSERCLICK when it is clicked (a program opens
+ * what it announced: a new drive in File Explorer, an update), and
+ * NIN_BALLOONTIMEOUT when it goes unclicked. Wine's tray said nothing, and a
+ * click on a balloon did nothing. */
+static WNDPROC balloon_tooltip_proc;
+static BOOL notify_owner( struct icon *icon, UINT msg, LPARAM lparam );
+
+static LRESULT WINAPI balloon_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+#ifndef SG_MUTANT_NO_BALLOON_CLICK
+    if (msg == WM_LBUTTONUP && balloon_icon && !balloon_icon->balloon_clicked)
+    {
+        struct icon *icon = balloon_icon;
+        icon->balloon_clicked = TRUE;
+        notify_owner( icon, NIN_BALLOONUSERCLICK, 0 );
+        /* gone at once: the show timer's end, from the icon's own window */
+        SetTimer( icon->window, BALLOON_SHOW_TIMER, 1, NULL );
+        return 0;
+    }
+#endif
+    return CallWindowProcW( balloon_tooltip_proc, hwnd, msg, wparam, lparam );
+}
+
 static void balloon_create_timer( struct icon *icon )
 {
     TTTOOLINFOW ti;
@@ -447,13 +472,18 @@
     balloon_pos.x = balloon_pos.y = MAXLONG;
     update_systray_balloon_position();
     SendMessageW( balloon_window, TTM_TRACKACTIVATE, TRUE, (LPARAM)&ti );
+    balloon_tooltip_proc = (WNDPROC)SetWindowLongPtrW( balloon_window, GWLP_WNDPROC, (LONG_PTR)balloon_wndproc );
+    icon->balloon_clicked = FALSE;
+    notify_owner( icon, NIN_BALLOONSHOW, 0 );
     KillTimer( icon->window, BALLOON_CREATE_TIMER );
     SetTimer( icon->window, BALLOON_SHOW_TIMER, icon->info_timeout, NULL );
 }
 
 static BOOL show_balloon( struct icon *icon )
 {
-    if (!show_systray) return FALSE;  /* systray has been hidden */
+    /* Stained Glass OS: the shell's taskbar holds the icons (show_systray is
+     * the stand-alone tray's), and their balloons show there: none did */
+    if (!show_systray && !enable_taskbar) return FALSE;  /* systray has been hidden */
     if (icon->display == ICON_DISPLAY_HIDDEN) return FALSE;  /* not displayed */
     if (!icon->info_text[0]) return FALSE;  /* no balloon */
     balloon_icon = icon;
@@ -497,8 +527,13 @@
 
 static void balloon_timer( struct icon *icon )
 {
+    BOOL clicked = icon->balloon_clicked;
+
     icon->info_text[0] = 0;  /* clear text now that balloon has been shown */
+    icon->balloon_clicked = FALSE;
     hide_balloon( icon );
+    /* the owner may remove its icon now: nothing of it is used after this */
+    if (!clicked) notify_owner( icon, NIN_BALLOONTIMEOUT, 0 );
     show_next_balloon();
 }
 
