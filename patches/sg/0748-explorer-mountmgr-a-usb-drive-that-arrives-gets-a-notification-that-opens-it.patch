     /* Stained Glass OS: Horizon's notification panel grows with the icons */
     if (enable_taskbar && sg_look == SG_LOOK_HORIZON) RedrawWindow( tray_window, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
     TRACE( "added %u now %d icons\n", icon->id, nb_displayed );
+    /* Stained Glass OS: a balloon asked for with the icon (NIM_ADD with
+     * NIF_INFO) comes up now it is shown: it was refused while hidden and
+     * never asked for again (a new drive's notification did not appear) */
+    if (icon->info_text[0] && !balloon_icon) show_balloon( icon );
 }
 
