+/* Stained Glass OS: a USB drive or a disc that arrives gets a notification,
+ * as Windows' AutoPlay gives one: "USB Drive (E:) -- Select to open it in
+ * File Explorer", and selecting it opens the drive there (David
+ * 2026-10-01: plugging a USB drive did nothing). A tray icon of its own for
+ * each drive, with the balloon; gone when the balloon times out, when it is
+ * used, or when the drive goes. */
+#define WM_SG_DRIVE_ARRIVED (WM_APP + 0x51)
+#define WM_SG_DRIVE_GONE    (WM_APP + 0x52)
+#define WM_SG_AUTOPLAY_TRAY (WM_APP + 0x53)
+static HWND autoplay_window;
+
+static void autoplay_remove( HWND hwnd, UINT id )
+{
+    NOTIFYICONDATAW nid = { sizeof(nid) };
+
+    nid.hWnd = hwnd;
+    nid.uID = id;
+    Shell_NotifyIconW( NIM_DELETE, &nid );
+}
+
+static LRESULT WINAPI autoplay_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    switch (msg)
+    {
+    case WM_SG_DRIVE_ARRIVED:
+    {
+        WCHAR root[] = { 'A' + (WCHAR)wparam, ':', '\\', 0 };
+        NOTIFYICONDATAW nid = { sizeof(nid) };
+        SHFILEINFOW sfi = { 0 };
+        WCHAR label[MAX_PATH] = L"";
+
+        nid.hWnd = hwnd;
+        nid.uID = wparam + 1;
+        nid.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP | NIF_INFO;
+        nid.uCallbackMessage = WM_SG_AUTOPLAY_TRAY;
+        if (SHGetFileInfoW( root, 0, &sfi, sizeof(sfi), SHGFI_ICON | SHGFI_SMALLICON | SHGFI_DISPLAYNAME ))
+        {
+            nid.hIcon = sfi.hIcon;
+            lstrcpynW( label, sfi.szDisplayName, ARRAY_SIZE(label) );
+        }
+        if (!label[0])
+            swprintf( label, ARRAY_SIZE(label), L"%s (%c:)",
+                      GetDriveTypeW( root ) == DRIVE_CDROM ? L"DVD Drive" : L"USB Drive", root[0] );
+        lstrcpynW( nid.szTip, label, ARRAY_SIZE(nid.szTip) );
+        lstrcpynW( nid.szInfoTitle, label, ARRAY_SIZE(nid.szInfoTitle) );
+        lstrcpynW( nid.szInfo, L"Select to open it in File Explorer.", ARRAY_SIZE(nid.szInfo) );
+        nid.uTimeout = 15000;
+        autoplay_remove( hwnd, nid.uID );
+        Shell_NotifyIconW( NIM_ADD, &nid );
+        nid.uVersion = NOTIFYICON_VERSION_4;
+        Shell_NotifyIconW( NIM_SETVERSION, &nid );
+        if (sfi.hIcon) DestroyIcon( sfi.hIcon );
+        WINE_TRACE( "drive %c: notified\n", root[0] );
+        return 0;
+    }
+    case WM_SG_DRIVE_GONE:
+        autoplay_remove( hwnd, wparam + 1 );
+        return 0;
+    case WM_SG_AUTOPLAY_TRAY:
+    {
+        UINT id = HIWORD( lparam );
+        WCHAR root[] = { 'A' + (WCHAR)(id - 1), ':', '\\', 0 };
+
+        switch (LOWORD( lparam ))
+        {
+        case NIN_BALLOONUSERCLICK:
+        case NIN_SELECT:
+        case NIN_KEYSELECT:
+            ShellExecuteW( NULL, L"open", L"explorer.exe", root, NULL, SW_SHOWNORMAL );
+            autoplay_remove( hwnd, id );
+            break;
+        case NIN_BALLOONTIMEOUT:
+            autoplay_remove( hwnd, id );
+            break;
+        }
+        return 0;
+    }
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static void initialize_autoplay(void)
+{
+    WNDCLASSW wc = { 0 };
+
+    wc.lpfnWndProc = autoplay_wndproc;
+    wc.hInstance = GetModuleHandleW( NULL );
+    wc.lpszClassName = L"SgAutoPlay";
+    RegisterClassW( &wc );
+    autoplay_window = CreateWindowExW( 0, L"SgAutoPlay", NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, 0, wc.hInstance, NULL );
+}
+
