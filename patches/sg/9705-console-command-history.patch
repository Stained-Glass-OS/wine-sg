+/* Stained Glass OS (wine-sg 9705): command history, kept by conhost per executable name, as Windows'
+ * console host keeps it. Sizes are in bytes (characters for the A functions), the commands each end with a
+ * NUL; a program with no history has none (0). ReadConsole names the reading program first, so the line it
+ * reads goes to its history. */
+/* the console input executable name, as Windows starts it: the program's file name (SetConsoleInputExeName
+ * changes it); the name ReadConsole gives conhost for the history and GetConsoleInputExeName returns */
+static void init_input_exe(void)
+{
+    const UNICODE_STRING *path = &RtlGetCurrentPeb()->ProcessParameters->ImagePathName;
+    const WCHAR *end = path->Buffer + path->Length / sizeof(WCHAR), *start = end;
+
+    if (input_exe[0]) return;
+    while (start > path->Buffer && start[-1] != '\\' && start[-1] != '/') start--;
+    RtlEnterCriticalSection( &console_section );
+    if (!input_exe[0])
+        lstrcpynW( input_exe, start, min( end - start + 1, ARRAY_SIZE(input_exe) ) );
+    RtlLeaveCriticalSection( &console_section );
+}
+
+/* tell conhost whose line read comes next (an older conhost does not know the request: ignored) */
+static void set_read_exe( HANDLE handle )
+{
+    WCHAR exe[ARRAY_SIZE(input_exe)];
+    IO_STATUS_BLOCK io;
+
+#ifdef SG_MUTANT_NO_READ_EXE
+    return;
+#endif
+    if (handle == CONSOLE_HANDLE_SHELL_NO_WINDOW) return;
+    init_input_exe();
+    RtlEnterCriticalSection( &console_section );
+    lstrcpyW( exe, input_exe );
+    RtlLeaveCriticalSection( &console_section );
+    NtDeviceIoControlFile( handle, NULL, NULL, NULL, &io, IOCTL_CONDRV_SET_READ_EXE, exe,
+                           wcslen( exe ) * sizeof(WCHAR), NULL, 0 );
+}
+
+/* the commands of a program, NUL-ended one after the other; *chars is their total length in characters */
+static WCHAR *get_history_text( const WCHAR *exe, DWORD *chars )
+{
+    WCHAR *text = NULL;
+    NTSTATUS status;
+    DWORD total, got;
+
+    if (!exe)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    for (;;)
+    {
+        if (!alias_ioctl( IOCTL_CONDRV_GET_HISTORY, exe, wcslen( exe ) * sizeof(WCHAR), NULL, 0, &total, &status ))
+            return NULL;
+        if (status) { SetLastError( RtlNtStatusToDosError( status ) ); return NULL; }
+        if (!(text = HeapAlloc( GetProcessHeap(), 0, (total + 1) * sizeof(WCHAR) )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return NULL;
+        }
+        if (!alias_ioctl( IOCTL_CONDRV_GET_HISTORY, exe, wcslen( exe ) * sizeof(WCHAR), text, total, &got, &status ))
+        {
+            HeapFree( GetProcessHeap(), 0, text );
+            return NULL;
+        }
+        if (got <= total) break;   /* it grew meanwhile: again */
+        HeapFree( GetProcessHeap(), 0, text );
+    }
+    *chars = got;
+    return text;
+}
+
+static DWORD history_textWtoA( const WCHAR *text, DWORD chars, char *out, DWORD out_size )
+{
+    return chars ? WideCharToMultiByte( GetConsoleCP(), 0, text, chars, out, out_size, NULL, NULL ) : 0;
+}
