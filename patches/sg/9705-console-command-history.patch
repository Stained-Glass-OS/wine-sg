+static NTSTATUS alias_result( NTSTATUS status, const WCHAR *text, size_t length, size_t *out_size );
+
+/* Stained Glass OS (wine-sg 9705): command history per program, as Windows' console host keeps it --
+ * GetConsoleCommandHistory, GetConsoleCommandHistoryLength, ExpungeConsoleCommandHistory,
+ * SetConsoleNumberOfCommands and Get/SetConsoleHistoryInfo, each by executable name (matched without regard
+ * to case), and the line a program reads goes to that program's history (ReadConsole names the reader).
+ * At most NumberOfHistoryBuffers histories (4); a new program past that takes over the least recently
+ * used one, emptied. */
+static void resize_history_lines( struct history_line ***lines, unsigned int *size, unsigned int *count,
+                                  unsigned int new_size )
+{
+    struct history_line **mem = NULL;
+    unsigned int i, delta;
+
+    if (new_size == *size) return;
+    if (new_size && !(mem = calloc( new_size, sizeof(*mem) ))) return;
+    /* the newest commands stay */
+    delta = *count > new_size ? *count - new_size : 0;
+    for (i = 0; i < delta; i++) free( (*lines)[i] );
+    for (i = delta; i < *count; i++) mem[i - delta] = (*lines)[i];
+    free( *lines );
+    *lines = mem;
+    *size = new_size;
+    *count -= delta;
+}
+
+static void free_history_lines( struct history_line **lines, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) free( lines[i] );
+}
+
+void resize_all_history( struct console *console, unsigned int size )
+{
+    unsigned int i;
+
+    console->history_default = size;
+    resize_history_lines( &console->history, &console->history_size, &console->history_index, size );
+    for (i = 0; i < console->history_buf_count; i++)
+        resize_history_lines( &console->history_bufs[i].lines, &console->history_bufs[i].size,
+                              &console->history_bufs[i].count, size );
+}
+
+/* make the named program's history the active one */
+static void select_history( struct console *console, const WCHAR *exe )
+{
+    struct history_buffer cur, next, *bufs;
+    unsigned int i;
+
+    if (!exe || !exe[0]) return;
+    if (console->history_exe && !wcsicmp( console->history_exe, exe )) return;
+    if (!console->history_exe)
+    {
+        /* the first program named takes the history lines were typed to so far */
+        console->history_exe = wcsdup( exe );
+        return;
+    }
+    cur.exe   = console->history_exe;
+    cur.lines = console->history;
+    cur.size  = console->history_size;
+    cur.count = console->history_index;
+
+    for (i = 0; i < console->history_buf_count; i++)
+        if (!wcsicmp( console->history_bufs[i].exe, exe )) break;
+    if (i < console->history_buf_count)
+    {
+        next = console->history_bufs[i];
+        memmove( &console->history_bufs[1], &console->history_bufs[0], i * sizeof(*console->history_bufs) );
+        console->history_bufs[0] = cur;
+    }
+#ifndef SG_MUTANT_ONE_HISTORY
+    else if (console->history_buf_count + 1 < console->history_buffers)
+    {
+        if (!(next.exe = wcsdup( exe ))) return;
+        next.lines = NULL;
+        next.size  = next.count = 0;
+        if (console->history_default && !(next.lines = calloc( console->history_default, sizeof(*next.lines) )))
+        {
+            free( next.exe );
+            return;
+        }
+        next.size = console->history_default;
+        if (!(bufs = realloc( console->history_bufs, (console->history_buf_count + 1) * sizeof(*bufs) )))
+        {
+            free( next.lines );
+            free( next.exe );
+            return;
+        }
+        console->history_bufs = bufs;
+        memmove( &bufs[1], &bufs[0], console->history_buf_count * sizeof(*bufs) );
+        bufs[0] = cur;
+        console->history_buf_count++;
+    }
+#endif
+    else if (console->history_buf_count)
+    {
+        /* the least recently used program's history, emptied */
+        next = console->history_bufs[console->history_buf_count - 1];
+        free_history_lines( next.lines, next.count );
+        if (next.lines) memset( next.lines, 0, next.size * sizeof(*next.lines) );
+        next.count = 0;
+        free( next.exe );
+        if (!(next.exe = wcsdup( exe ))) next.exe = wcsdup( L"" );
+        memmove( &console->history_bufs[1], &console->history_bufs[0],
+                 (console->history_buf_count - 1) * sizeof(*console->history_bufs) );
+        console->history_bufs[0] = cur;
+    }
+    else
+    {
+        /* one history only: it changes hands, emptied */
+        free_history_lines( console->history, console->history_index );
+        console->history_index = 0;
+        free( console->history_exe );
+        console->history_exe = wcsdup( exe );
+        return;
+    }
+    console->history_exe   = next.exe;
+    console->history       = next.lines;
+    console->history_size  = next.size;
+    console->history_index = next.count;
+}
+
+/* the named program's history: its lines, size and count, as pointers into the console */
+static BOOL find_history( struct console *console, const WCHAR *exe, size_t len, struct history_line ****lines,
+                          unsigned int **size, unsigned int **count )
+{
+    unsigned int i;
+
+    if (console->history_exe && wcslen( console->history_exe ) == len && !wcsnicmp( console->history_exe, exe, len ))
+    {
+        *lines = &console->history;
+        *size  = &console->history_size;
+        *count = &console->history_index;
+        return TRUE;
+    }
+    for (i = 0; i < console->history_buf_count; i++)
+    {
+        struct history_buffer *buf = &console->history_bufs[i];
+        if (wcslen( buf->exe ) == len && !wcsnicmp( buf->exe, exe, len ))
+        {
+            *lines = &buf->lines;
+            *size  = &buf->size;
+            *count = &buf->count;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static NTSTATUS get_history( struct console *console, const WCHAR *exe, size_t len, size_t *out_size )
+{
+    struct history_line ***lines;
+    unsigned int *size, *count, i;
+    size_t total = 0;
+    WCHAR *text, *p;
+    NTSTATUS status;
+
+    if (!find_history( console, exe, len, &lines, &size, &count ) || !*count)
+        return alias_result( STATUS_SUCCESS, NULL, 0, out_size );
+    for (i = 0; i < *count; i++) total += (*lines)[i]->len / sizeof(WCHAR) + 1;
+    if (!(text = malloc( total * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+    for (i = 0, p = text; i < *count; i++)
+    {
+        memcpy( p, (*lines)[i]->text, (*lines)[i]->len );
+        p += (*lines)[i]->len / sizeof(WCHAR);
+        *p++ = 0;
+    }
+    status = alias_result( STATUS_SUCCESS, text, total, out_size );
+    free( text );
+    return status;
+}
+
+static void expunge_history( struct console *console, const WCHAR *exe, size_t len )
+{
+    struct history_line ***lines;
+    unsigned int *size, *count;
+
+    if (!find_history( console, exe, len, &lines, &size, &count )) return;
+    free_history_lines( *lines, *count );
+    if (*lines) memset( *lines, 0, *size * sizeof(**lines) );
+    *count = 0;
+}
+
+static void set_history_count( struct console *console, unsigned int new_size, const WCHAR *exe, size_t len )
+{
+    struct history_line ***lines;
+    unsigned int *size, *count;
+
+    if (find_history( console, exe, len, &lines, &size, &count ))
+        resize_history_lines( lines, size, count, new_size );
+}
