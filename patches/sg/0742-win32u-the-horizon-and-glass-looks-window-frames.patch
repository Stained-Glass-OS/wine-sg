From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] win32u: the Horizon and Glass looks' window frames

David: each look should be complete and close to its era -- window frames
and title bars too, not only the taskbar and Start. HKCU\Software\Stained
Glass\Style "Frame" (set with the look in Settings) chooses the frame of
top-level windows with a title bar: 1 Horizon, a blue gradient title bar
across the whole width, a blue frame, rounded blue caption buttons with a
red Close, the title in white with a shadow; 2 Glass, a pale blue-grey
glass-like bar and frame, glossy caption buttons, the title dark with a
light glow. Both round the window's top corners (the Rounded style's hidden
region, top only; square when maximized). Our own drawing in the manner of
the 2001-era and 2009-era desktops. 0, the default, is the flat frame as
before. A program that sets its caption colour keeps the flat frame.
---
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1526,6 +1526,349 @@
     return retval;
 }
 
+/* Stained Glass OS: the window frames of the Horizon and Glass looks
+ * (HKCU\Software\Stained Glass\Style "Frame" 1 and 2, set with the look in
+ * Settings > Personalization): our own drawing in the manner of the 2001-era
+ * and 2009-era desktops -- a gradient title bar across the whole width,
+ * a frame in its colours, rounded caption buttons (Close red), and the title
+ * in white with a shadow (Horizon) or dark with a light glow (Glass). The
+ * rounded top corners are window.c's hidden region. Frame 0 is the flat
+ * frame above, unchanged. */
+struct sg_stop { int pos; COLORREF c; };   /* pos: thousandths of the height */
+
+static void draw_close_button( HWND hwnd, HDC hdc, BOOL down, BOOL grayed );
+static void draw_max_button( HWND hwnd, HDC hdc, BOOL down, BOOL grayed );
+static void draw_min_button( HWND hwnd, HDC hdc, BOOL down, BOOL grayed );
+
+struct sg_frame_style
+{
+    struct sg_stop caption[6];
+    COLORREF outer, border, inner;          /* the frame's outer line, its body, the line at the client */
+    COLORREF text, halo;                    /* title text; its shadow or glow */
+    struct sg_stop button[4];
+    COLORREF button_edge, glyph;
+    struct sg_stop close[4];
+    COLORREF close_edge, close_glyph;
+    int radius;                             /* caption buttons' corners */
+};
+
+#define C(r,g,b) RGB(0x##r,0x##g,0x##b)
+static const struct sg_frame_style sg_frames[2][2] =   /* [look - 1][active] */
+{
+    {   /* Horizon, inactive */
+        {   {{0,C(a6,bf,f5)},{70,C(94,b1,f1)},{250,C(86,a5,ec)},{700,C(7d,9d,e9)},{900,C(78,98,e6)},{1000,C(6c,8c,dc)}},
+            C(5f,7f,d4), C(7d,9d,e9), C(94,b1,f1), C(e2,ea,fb), C(5a,74,c4),
+            {{0,C(b3,c9,f6)},{500,C(9a,b6,f1)},{1000,C(86,a5,ec)},{1000,C(86,a5,ec)}}, C(e6,ed,fc), C(f0,f4,fd),
+            {{0,C(ee,b8,a6)},{500,C(e2,9a,82)},{1000,C(d2,7e,64)},{1000,C(d2,7e,64)}}, C(f2,e4,e0), C(fb,f2,ef), 3 },
+        /* Horizon, active */
+        {   {{0,C(5d,9d,fb)},{70,C(2c,74,f1)},{250,C(16,5d,e6)},{700,C(0c,50,dc)},{900,C(0a,4a,d3)},{1000,C(05,3a,b4)}},
+            C(00,26,9a), C(0b,4c,d6), C(3a,77,ea), C(ff,ff,ff), C(0a,1f,66),
+            {{0,C(6c,a3,fa)},{500,C(3a,77,ec)},{1000,C(22,5f,dc)},{1000,C(22,5f,dc)}}, C(ff,ff,ff), C(ff,ff,ff),
+            {{0,C(ef,8d,6e)},{500,C(e0,5f,3a)},{1000,C(c2,3c,18)},{1000,C(c2,3c,18)}}, C(ff,ff,ff), C(ff,ff,ff), 3 },
+    },
+    {   /* Glass, inactive */
+        {   {{0,C(ec,f2,fa)},{80,C(e1,ea,f5)},{500,C(d6,e2,f1)},{1000,C(cf,dd,ef)},{1000,C(cf,dd,ef)},{1000,C(cf,dd,ef)}},
+            C(8c,a2,bd), C(d3,e0,f0), C(a9,bb,d2), C(55,5f,6b), C(f6,f9,fd),
+            {{0,C(f8,fa,fd)},{480,C(ec,f1,f8)},{520,C(dc,e5,f1)},{1000,C(e6,ed,f6)}}, C(9a,ad,c6), C(6c,7b,8f),
+            {{0,C(f4,e0,dd)},{480,C(ea,ca,c5)},{520,C(dc,ad,a6)},{1000,C(e4,bf,b9)}}, C(a8,8a,86), C(fb,f4,f3), 4 },
+        /* Glass, active */
+        {   {{0,C(d9,e7,f6)},{80,C(c3,d7,ef)},{500,C(ad,c8,e8)},{1000,C(a0,bf,e4)},{1000,C(a0,bf,e4)},{1000,C(a0,bf,e4)}},
+            C(46,66,8e), C(a7,c3,e6), C(6f,8e,b6), C(00,00,00), C(f4,f8,fd),
+            {{0,C(f6,f9,fd)},{480,C(e1,ea,f5)},{520,C(c5,d5,ea)},{1000,C(d7,e4,f3)}}, C(52,72,9a), C(1f,33,52),
+            {{0,C(f1,b9,ae)},{480,C(e2,8d,7c)},{520,C(c8,48,34)},{1000,C(d9,74,62)}}, C(6a,24,1c), C(ff,ff,ff), 4 },
+    },
+};
+#undef C
+
+static int sg_frame_cached = -1;
+static DWORD sg_frame_read_at;
+
+/* the look's frame: 0 flat, 1 Horizon, 2 Glass (read at most twice a second) */
+int sg_frame_look(void)
+{
+    DWORD now = NtGetTickCount();
+
+    if (sg_frame_cached < 0 || now - sg_frame_read_at > 500)
+    {
+        static const WCHAR frameW[] = {'F','r','a','m','e',0};
+        char buffer[sizeof(KEY_VALUE_PARTIAL_INFORMATION) + sizeof(DWORD)];
+        KEY_VALUE_PARTIAL_INFORMATION *info = (void *)buffer;
+        HKEY key;
+        int look = 0;
+
+        if ((key = reg_open_hkcu_key( "Software\\Stained Glass\\Style" )))
+        {
+            if (query_reg_value( key, frameW, info, sizeof(buffer) ) && info->Type == REG_DWORD &&
+                *(DWORD *)info->Data <= 2)
+                look = *(DWORD *)info->Data;
+            NtClose( key );
+        }
+#ifdef SG_MUTANT_FLATFRAMES
+        look = 0;
+#endif
+        sg_frame_cached = look;
+        sg_frame_read_at = now;
+    }
+    return sg_frame_cached;
+}
+
+/* a window drawn with the look's frame: top-level, a title bar, not a tool
+ * window's small one, not one that asked for its own caption colours */
+static const struct sg_frame_style *sg_frame_style_for( HWND hwnd, DWORD style, DWORD ex_style, BOOL active )
+{
+    static const WCHAR captionW[] = {'_','_','w','i','n','e','_','c','a','p','t','i','o','n','_','c','o','l','o','r',0};
+    int look;
+
+    if ((style & WS_CAPTION) != WS_CAPTION || (style & WS_CHILD)) return NULL;
+    if (!(look = sg_frame_look())) return NULL;
+    if (NtUserGetProp( hwnd, captionW )) return NULL;
+    return &sg_frames[look - 1][active ? 1 : 0];
+}
+
+static void sg_vgradient( HDC hdc, const RECT *r, const struct sg_stop *stops, int count )
+{
+    int i, h = r->bottom - r->top;
+
+    for (i = 0; i < count - 1; i++)
+    {
+        TRIVERTEX v[2];
+        GRADIENT_RECT mesh = { 0, 1 };
+        int y0 = r->top + muldiv( h, stops[i].pos, 1000 ), y1 = r->top + muldiv( h, stops[i + 1].pos, 1000 );
+
+        if (y1 <= y0) continue;
+        v[0].x = r->left;  v[0].y = y0;
+        v[1].x = r->right; v[1].y = y1;
+        v[0].Red = GetRValue( stops[i].c ) << 8; v[0].Green = GetGValue( stops[i].c ) << 8;
+        v[0].Blue = GetBValue( stops[i].c ) << 8; v[0].Alpha = 0xff00;
+        v[1].Red = GetRValue( stops[i + 1].c ) << 8; v[1].Green = GetGValue( stops[i + 1].c ) << 8;
+        v[1].Blue = GetBValue( stops[i + 1].c ) << 8; v[1].Alpha = 0xff00;
+        NtGdiGradientFill( hdc, v, 2, &mesh, 1, GRADIENT_FILL_RECT_V );
+    }
+}
+
+static void sg_fill( HDC hdc, const RECT *r, COLORREF c )
+{
+    HBRUSH brush = NtGdiCreateSolidBrush( c, NULL );
+    fill_rect( hdc, r, brush );
+    NtGdiDeleteObjectApp( brush );
+}
+
+/* the title bar's band: from the window's top edge to the caption's bottom */
+static void sg_frame_caption_band( HWND hwnd, RECT *band, DWORD style, DWORD ex_style )
+{
+    RECT inside;
+
+    get_window_rect_rel( hwnd, COORDS_WINDOW, band, get_thread_dpi() );
+    get_inside_rect( hwnd, COORDS_WINDOW, &inside, style, ex_style );
+    band->bottom = inside.top + get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ? SM_CYSMCAPTION : SM_CYCAPTION );
+}
+
+/* a caption button of the look: its slice of the title bar, then a rounded
+ * button with its glyph */
+static void sg_frame_button( HWND hwnd, HDC hdc, const RECT *r, UINT flags, const struct sg_frame_style *fs )
+{
+    DWORD style = get_window_long( hwnd, GWL_STYLE ), ex_style = get_window_long( hwnd, GWL_EXSTYLE );
+    BOOL pushed = (flags & DFCS_PUSHED) != 0, grayed = (flags & DFCS_INACTIVE) != 0;
+    UINT kind = flags & 0xf;
+    int dpi = get_dpi_for_window( hwnd ), lw = max( 2, muldiv( 2, dpi, 96 ) );
+    int w, h, g, x0, y0, rad = muldiv( fs->radius, dpi, 96 );
+    struct sg_stop stops[4];
+    RECT band, b = *r;
+    HRGN clip, button;
+    HPEN pen, prev_pen;
+    HBRUSH prev_brush;
+    COLORREF glyph;
+    int i, saved;
+
+    /* the title bar behind it */
+    saved = NtGdiSaveDC( hdc );
+    clip = NtGdiCreateRectRgn( r->left, r->top, r->right, r->bottom );
+    NtGdiExtSelectClipRgn( hdc, clip, RGN_AND );
+    NtGdiDeleteObjectApp( clip );
+    sg_frame_caption_band( hwnd, &band, style, ex_style );
+    sg_vgradient( hdc, &band, fs->caption, ARRAY_SIZE(fs->caption) );
+
+    /* the button: square-ish, a pixel in from the slot */
+    InflateRect( &b, -1, -1 );
+    w = b.right - b.left; h = b.bottom - b.top;
+    if (w > h + 2 && kind != DFCS_CAPTIONCLOSE) { b.left += (w - h) / 2; b.right = b.left + h; w = h; }
+    for (i = 0; i < 4; i++)
+    {
+        stops[i] = (kind == DFCS_CAPTIONCLOSE ? fs->close : fs->button)[i];
+        if (pushed && !grayed)   /* pressed: darker, the gloss turned over */
+            stops[i].c = RGB( GetRValue( stops[i].c ) * 3 / 4, GetGValue( stops[i].c ) * 3 / 4, GetBValue( stops[i].c ) * 3 / 4 );
+    }
+    button = NtGdiCreateRoundRectRgn( b.left, b.top, b.right + 1, b.bottom + 1, 2 * rad, 2 * rad );
+    NtGdiExtSelectClipRgn( hdc, button, RGN_AND );
+    NtGdiDeleteObjectApp( button );
+    sg_vgradient( hdc, &b, stops, 4 );
+    NtGdiRestoreDC( hdc, saved );
+
+    pen = NtGdiCreatePen( PS_SOLID, 1, kind == DFCS_CAPTIONCLOSE ? fs->close_edge : fs->button_edge, NULL );
+    prev_pen = NtGdiSelectPen( hdc, pen );
+    prev_brush = NtGdiSelectBrush( hdc, GetStockObject( NULL_BRUSH ));
+    NtGdiRoundRect( hdc, b.left, b.top, b.right, b.bottom, 2 * rad, 2 * rad );
+    NtGdiSelectBrush( hdc, prev_brush );
+    NtGdiSelectPen( hdc, prev_pen );
+    NtGdiDeleteObjectApp( pen );
+
+    /* the glyph, bold */
+    glyph = kind == DFCS_CAPTIONCLOSE ? fs->close_glyph : fs->glyph;
+    if (grayed) glyph = RGB( (GetRValue( glyph ) + GetRValue( fs->button[1].c )) / 2,
+                             (GetGValue( glyph ) + GetGValue( fs->button[1].c )) / 2,
+                             (GetBValue( glyph ) + GetBValue( fs->button[1].c )) / 2 );
+    g = min( b.right - b.left, b.bottom - b.top ) * 9 / 20;
+    if (g < 6) g = 6;
+    x0 = (b.left + b.right - g) / 2;
+    y0 = (b.top + b.bottom - g) / 2;
+    if (kind == DFCS_CAPTIONCLOSE)
+    {
+        POINT pts[4];
+        ULONG counts[2] = { 2, 2 };
+        pen = NtGdiExtCreatePen( PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_FLAT, lw, BS_SOLID, glyph, 0, 0, 0, NULL, 0, FALSE, NULL );
+        prev_pen = NtGdiSelectPen( hdc, pen );
+        pts[0].x = x0; pts[0].y = y0; pts[1].x = x0 + g; pts[1].y = y0 + g;
+        pts[2].x = x0 + g; pts[2].y = y0; pts[3].x = x0; pts[3].y = y0 + g;
+        NtGdiPolyPolyDraw( hdc, pts, counts, 2, NtGdiPolyPolyline );
+        NtGdiSelectPen( hdc, prev_pen );
+        NtGdiDeleteObjectApp( pen );
+    }
+    else
+    {
+        RECT gr;
+        switch (kind)
+        {
+        case DFCS_CAPTIONMIN:
+            SetRect( &gr, x0, y0 + g - lw, x0 + g * 2 / 3, y0 + g );
+            sg_fill( hdc, &gr, glyph );
+            break;
+        case DFCS_CAPTIONMAX:
+            SetRect( &gr, x0, y0, x0 + g, y0 + lw + 1 ); sg_fill( hdc, &gr, glyph );      /* the thick top */
+            SetRect( &gr, x0, y0, x0 + 1, y0 + g ); sg_fill( hdc, &gr, glyph );
+            SetRect( &gr, x0 + g - 1, y0, x0 + g, y0 + g ); sg_fill( hdc, &gr, glyph );
+            SetRect( &gr, x0, y0 + g - 1, x0 + g, y0 + g ); sg_fill( hdc, &gr, glyph );
+            break;
+        case DFCS_CAPTIONRESTORE:
+        {
+            int d = g / 3, s = g - d;
+            SetRect( &gr, x0 + d, y0, x0 + g, y0 + lw ); sg_fill( hdc, &gr, glyph );      /* the back one */
+            SetRect( &gr, x0 + g - 1, y0, x0 + g, y0 + s ); sg_fill( hdc, &gr, glyph );
+            SetRect( &gr, x0, y0 + d, x0 + s, y0 + d + lw ); sg_fill( hdc, &gr, glyph );  /* the front one */
+            SetRect( &gr, x0, y0 + d, x0 + 1, y0 + g ); sg_fill( hdc, &gr, glyph );
+            SetRect( &gr, x0 + s - 1, y0 + d, x0 + s, y0 + g ); sg_fill( hdc, &gr, glyph );
+            SetRect( &gr, x0, y0 + g - 1, x0 + s, y0 + g ); sg_fill( hdc, &gr, glyph );
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
+
+/* the frame and the title bar of the look, around *rect (the window's);
+ * *rect becomes what is inside the title bar, as the flat path leaves it */
+static void sg_frame_paint( HWND hwnd, HDC hdc, RECT *rect, DWORD style, DWORD ex_style, BOOL active,
+                            const struct sg_frame_style *fs, const RECT *clip_rect )
+{
+    RECT win = *rect, inside, band, r, rfuzz;
+    int cap = get_system_metrics( (ex_style & WS_EX_TOOLWINDOW) ? SM_CYSMCAPTION : SM_CYCAPTION );
+
+    get_inside_rect( hwnd, COORDS_WINDOW, &inside, style, ex_style );
+
+    /* the frame: its body, an outer line, a line at the client */
+    sg_fill( hdc, &(RECT){ win.left, win.top, win.right, inside.top }, fs->border );
+    sg_fill( hdc, &(RECT){ win.left, inside.top, inside.left, win.bottom }, fs->border );
+    sg_fill( hdc, &(RECT){ inside.right, inside.top, win.right, win.bottom }, fs->border );
+    sg_fill( hdc, &(RECT){ win.left, inside.bottom, win.right, win.bottom }, fs->border );
+    if (inside.left > win.left + 1)
+    {
+        r = inside; r.top += cap - 1; InflateRect( &r, 1, 1 );
+        sg_fill( hdc, &(RECT){ r.left, r.top, r.left + 1, r.bottom }, fs->inner );
+        sg_fill( hdc, &(RECT){ r.right - 1, r.top, r.right, r.bottom }, fs->inner );
+        sg_fill( hdc, &(RECT){ r.left, r.bottom - 1, r.right, r.bottom }, fs->inner );
+    }
+    /* the title bar, across the whole width */
+    band = win; band.bottom = inside.top + cap;
+    if (intersect_rect( &rfuzz, &band, clip_rect ))
+    {
+        WCHAR buffer[256];
+        int len;
+
+        r = band; r.left++; r.right--; r.top++;
+        sg_vgradient( hdc, &r, fs->caption, ARRAY_SIZE(fs->caption) );
+
+        r = inside; r.bottom = inside.top + cap;
+        if ((style & WS_SYSMENU) && !(ex_style & WS_EX_TOOLWINDOW))
+        {
+            if (draw_nc_sys_button( hwnd, hdc, FALSE ))
+                r.left += get_system_metrics( SM_CXSMICON ) + 2;
+        }
+        if (style & WS_SYSMENU)
+        {
+            HMENU sys_menu = NtUserGetSystemMenu( hwnd, FALSE );
+            UINT state = get_menu_state( sys_menu, SC_CLOSE, MF_BYCOMMAND );
+
+            draw_close_button( hwnd, hdc, FALSE, (state & (MF_DISABLED | MF_GRAYED)) || (state == 0xFFFFFFFF) );
+            r.right -= get_system_metrics( SM_CYCAPTION ) - 1;
+            if ((style & WS_MAXIMIZEBOX) || (style & WS_MINIMIZEBOX))
+            {
+                draw_max_button( hwnd, hdc, FALSE, !(style & WS_MAXIMIZEBOX) );
+                r.right -= get_system_metrics( SM_CXSIZE ) + 1;
+                draw_min_button( hwnd, hdc, FALSE, !(style & WS_MINIMIZEBOX) );
+                r.right -= get_system_metrics( SM_CXSIZE ) + 1;
+            }
+        }
+        if ((len = get_window_text( hwnd, buffer, ARRAY_SIZE( buffer ))))
+        {
+            NONCLIENTMETRICSW nclm;
+            HFONT font, prev;
+            LOGFONTW lf;
+            int dx, dy;
+
+            nclm.cbSize = sizeof(nclm);
+            NtUserSystemParametersInfo( SPI_GETNONCLIENTMETRICS, 0, &nclm, 0 );
+            lf = (ex_style & WS_EX_TOOLWINDOW) ? nclm.lfSmCaptionFont : nclm.lfCaptionFont;
+            if (fs == &sg_frames[0][1] || fs == &sg_frames[0][0]) lf.lfWeight = FW_BOLD;  /* Horizon: bold */
+            font = NtGdiHfontCreate( &lf, sizeof(lf), 0, 0, NULL );
+            prev = NtGdiSelectFont( hdc, font );
+            NtGdiGetAndSetDCDword( hdc, NtGdiSetBkMode, TRANSPARENT, NULL );
+            r.left += 3;
+            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, fs->halo, NULL );
+            if (fs == &sg_frames[0][1] || fs == &sg_frames[0][0])
+            {
+                RECT s = r;   /* a shadow down and to the right */
+                OffsetRect( &s, 1, 1 );
+                DrawTextW( hdc, buffer, -1, &s, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_LEFT | DT_END_ELLIPSIS );
+            }
+            else for (dy = -1; dy <= 1; dy++) for (dx = -1; dx <= 1; dx++)
+            {
+                RECT s = r;   /* a glow all round */
+                if (!dx && !dy) continue;
+                OffsetRect( &s, dx, dy );
+                DrawTextW( hdc, buffer, -1, &s, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_LEFT | DT_END_ELLIPSIS );
+            }
+            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, fs->text, NULL );
+            DrawTextW( hdc, buffer, -1, &r, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_LEFT | DT_END_ELLIPSIS );
+            NtGdiDeleteObjectApp( NtGdiSelectFont( hdc, prev ));
+        }
+    }
+    /* the outer line, round at the top where window.c's region is */
+    {
+        int radius = (style & (WS_MAXIMIZE | WS_MINIMIZE)) ? 0 :
+                     muldiv( fs == &sg_frames[0][0] || fs == &sg_frames[0][1] ? 7 : 6, get_dpi_for_window( hwnd ), 96 );
+        HPEN pen = NtGdiCreatePen( PS_SOLID, 1, fs->outer, NULL ), prev_pen = NtGdiSelectPen( hdc, pen );
+        HBRUSH prev_brush = NtGdiSelectBrush( hdc, GetStockObject( NULL_BRUSH ));
+        if (radius) NtGdiRoundRect( hdc, win.left, win.top, win.right, win.bottom + 2 * radius, 2 * radius, 2 * radius );
+        else NtGdiRectangle( hdc, win.left, win.top, win.right, win.bottom );
+        NtGdiSelectBrush( hdc, prev_brush );
+        NtGdiSelectPen( hdc, prev_pen );
+        NtGdiDeleteObjectApp( pen );
+        sg_fill( hdc, &(RECT){ win.left, win.bottom - 1, win.right, win.bottom }, fs->outer );
+    }
+    *rect = inside;
+    rect->top += cap;
+}
+
 /* Stained Glass OS: flat, Windows-10-style caption buttons -- no 3D frame,
  * the caption colour behind a thin line glyph, and a solid fill while pressed
  * (red for Close). Only the window's own caption buttons change: the public
@@ -1556,6 +1899,15 @@
         draw_frame_caption( hdc, &rc, flags );
         return;
     }
+    {
+        const struct sg_frame_style *fs = sg_frame_style_for( hwnd, get_window_long( hwnd, GWL_STYLE ),
+                                                              get_window_long( hwnd, GWL_EXSTYLE ), active );
+        if (fs)
+        {
+            sg_frame_button( hwnd, hdc, r, flags, fs );
+            return;
+        }
+    }
 
     bg = caption_color( hwnd, active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION );
     fg = caption_color( hwnd, grayed ? COLOR_GRAYTEXT :
@@ -1895,6 +2247,7 @@
     WORD flags;
     HRGN hrgn;
     RECT rectClient;
+    const struct sg_frame_style *era;
 
     if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS) return;
     style = win->dwStyle;
@@ -1931,14 +2284,19 @@
 
     NtGdiSelectPen( hdc, get_sys_color_pen( COLOR_WINDOWFRAME ));
 
+    if ((era = sg_frame_style_for( hwnd, style, ex_style, active )))
+        sg_frame_paint( hwnd, hdc, &rect, style, ex_style, active, era, &clip_rect );
+    else
+    {
