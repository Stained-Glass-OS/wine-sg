From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: 3DES in ECB mode

wine-sg 7819. BCryptSetProperty(BCRYPT_CHAINING_MODE, ECB) on a 3DES
algorithm said STATUS_NOT_SUPPORTED, so .NET's TripleDES in ECB mode threw a
CryptographicException: Devolutions Remote Desktop Manager could not save
its settings at its first start and stopped. ECB is now made from CBC with
the vector reset for each block, as for AES (gnutls's 3DES takes no missing
vector: zeros), and the mode reads back.
---
 dlls/bcrypt/bcrypt_main.c | 10 ++++++++++
 dlls/bcrypt/gnutls.c      | 10 +++++++++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 2819428..30755e3 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -683,6 +683,7 @@ static NTSTATUS get_3des_property( enum chain_mode mode, const WCHAR *prop, UCHA
         const WCHAR *str;
         switch (mode)
         {
+        case CHAIN_MODE_ECB: str = BCRYPT_CHAIN_MODE_ECB; break;
         case CHAIN_MODE_CBC: str = BCRYPT_CHAIN_MODE_CBC; break;
         default: return STATUS_NOT_IMPLEMENTED;
         }
@@ -885,6 +886,15 @@ static NTSTATUS set_alg_property( struct algorithm *alg, const WCHAR *prop, UCHA
                 alg->mode = CHAIN_MODE_CBC;
                 return STATUS_SUCCESS;
             }
+#ifndef SG_MUTANT_3DES_NO_ECB
+            /* Stained Glass OS (wine-sg 7819): ECB too, made from CBC with the vector reset per block as for
+             * AES (.NET's TripleDES in ECB mode, Remote Desktop Manager's settings, failed: STATUS_NOT_SUPPORTED) */
+            else if (!wcscmp( (WCHAR *)value, BCRYPT_CHAIN_MODE_ECB ))
+            {
+                alg->mode = CHAIN_MODE_ECB;
+                return STATUS_SUCCESS;
+            }
+#endif
             else
             {
                 FIXME( "unsupported mode %s\n", debugstr_w((WCHAR *)value) );
diff --git a/dlls/bcrypt/gnutls.c b/dlls/bcrypt/gnutls.c
index 7ea3f38..f6c7649 100644
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -608,6 +608,7 @@ static gnutls_cipher_algorithm_t get_gnutls_cipher( const struct key *key )
         WARN( "handle block size\n" );
         switch (key->u.s.mode)
         {
+        case CHAIN_MODE_ECB: /* can be emulated with CBC + empty IV (wine-sg 7819) */
         case CHAIN_MODE_CBC:
             return GNUTLS_CIPHER_3DES_CBC;
         default:
@@ -672,8 +673,15 @@ static NTSTATUS init_cipher_handle( struct key *key )
 
     vector.data = key->u.s.vector;
     vector.size = key->u.s.vector_len;
+    if (!key->u.s.vector && key->u.s.mode == CHAIN_MODE_ECB && key->alg_id == ALG_ID_3DES)
+    {
+        /* ECB made from CBC: a vector of zeros (3DES does not take a missing one: wine-sg 7819) */
+        static UCHAR zeros[16];
+        vector.data = zeros;
+        vector.size = key->u.s.block_size;
+    }
 
-    if ((ret = pgnutls_cipher_init( &key_data(key)->cipher, cipher, &secret, key->u.s.vector ? &vector : NULL )))
+    if ((ret = pgnutls_cipher_init( &key_data(key)->cipher, cipher, &secret, vector.data ? &vector : NULL )))
     {
         pgnutls_perror( ret );
         return STATUS_INTERNAL_ERROR;
-- 
