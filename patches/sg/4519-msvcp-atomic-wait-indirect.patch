From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcp140_atomic_wait: Implement indirect waits, deadlines and the 128-bit compare-exchange.

msvcp140_atomic_wait's remaining spec stubs, from the declarations in the
STL's public headers: __std_atomic_wait_indirect with
__std_atomic_notify_one/all_indirect (objects WaitOnAddress cannot compare:
a lock and condition variable per hash bucket, checked under the lock so
no wake-up is lost), __std_atomic_wait_get_deadline and
__std_atomic_wait_get_remaining_timeout, __std_atomic_set_api_level
(WaitOnAddress is always there), __std_atomic_get_mutex (the lock of a
lock-based atomic), __std_atomic_has_cmpxchg16b and
__std_atomic_compare_exchange_128 (cmpxchg16b when present, a lock
otherwise), and the parallel algorithms' __std_execution_wait_on_uchar and
__std_execution_wake_by_address_all.
---
 dlls/msvcp140_atomic_wait/main.c                   | 157 +++++++++++++++++++++
 .../msvcp140_atomic_wait/msvcp140_atomic_wait.spec |  22 +--
 2 files changed, 168 insertions(+), 11 deletions(-)

diff --git a/dlls/msvcp140_atomic_wait/main.c b/dlls/msvcp140_atomic_wait/main.c
index 52ecae4..75f1550 100644
--- a/dlls/msvcp140_atomic_wait/main.c
+++ b/dlls/msvcp140_atomic_wait/main.c
@@ -83,6 +83,163 @@ BOOL __stdcall __std_atomic_wait_direct(volatile void *addr, void *cmp,
     return WaitOnAddress(addr, cmp, size, timeout);
 }
 
+/* the deadline and timeout values meaning "never" */
+#define ATOMIC_WAIT_NO_DEADLINE (~(ULONGLONG)0)
+
+/* api levels of __std_atomic_set_api_level */
+enum atomic_api_level
+{
+    ATOMIC_API_NOT_SET,
+    ATOMIC_API_DETECTING,
+    ATOMIC_API_HAS_SRWLOCK,
+    ATOMIC_API_HAS_WAIT_ON_ADDRESS,
+};
+
+enum atomic_api_level __stdcall __std_atomic_set_api_level(enum atomic_api_level level)
+{
+    TRACE("(%d)\n", level);
+    /* WaitOnAddress is always there */
+    return ATOMIC_API_HAS_WAIT_ON_ADDRESS;
+}
+
+ULONGLONG __stdcall __std_atomic_wait_get_deadline(ULONGLONG timeout)
+{
+    TRACE("(%I64u)\n", timeout);
+    if (timeout == ATOMIC_WAIT_NO_DEADLINE) return ATOMIC_WAIT_NO_DEADLINE;
+    return GetTickCount64() + timeout;
+}
+
+DWORD __stdcall __std_atomic_wait_get_remaining_timeout(ULONGLONG deadline)
+{
+    ULONGLONG now;
+
+    TRACE("(%I64u)\n", deadline);
+    if (deadline == ATOMIC_WAIT_NO_DEADLINE) return INFINITE;
+    now = GetTickCount64();
+    if (now >= deadline) return 0;
+    if (deadline - now >= INFINITE) return INFINITE - 1;
+    return deadline - now;
+}
+
+/* Waits on objects WaitOnAddress cannot compare: a lock and a condition
+ * variable per hash bucket of the address. A waiter checks the value with
+ * the bucket locked and sleeps on its condition variable; a notifier takes
+ * the lock before waking, so no wake-up falls between the check and the
+ * sleep. */
+#define WAIT_BUCKETS 64
+
+static struct
+{
+    SRWLOCK lock;
+    CONDITION_VARIABLE cv;
+} wait_buckets[WAIT_BUCKETS];
+
+static unsigned int wait_bucket(const void *addr)
+{
+    ULONG_PTR p = (ULONG_PTR)addr;
+    return (p ^ (p >> 6) ^ (p >> 12)) % WAIT_BUCKETS;
+}
+
+typedef BOOL (__stdcall *atomic_wait_equal_func)(const void *, void *, SIZE_T, void *);
+
+BOOL __stdcall __std_atomic_wait_indirect(const void *addr, void *cmp, SIZE_T size, void *param,
+        atomic_wait_equal_func equal, DWORD timeout)
+{
+    unsigned int b = wait_bucket(addr);
+    BOOL ret = TRUE;
+
+    TRACE("(%p %p %Iu %p %p %lu)\n", addr, cmp, size, param, equal, timeout);
+
+    AcquireSRWLockExclusive(&wait_buckets[b].lock);
+    if (equal(addr, cmp, size, param))
+        ret = SleepConditionVariableSRW(&wait_buckets[b].cv, &wait_buckets[b].lock, timeout, 0);
+    ReleaseSRWLockExclusive(&wait_buckets[b].lock);
+    return ret;
+}
+
+void __stdcall __std_atomic_notify_one_indirect(const void *addr)
+{
+    unsigned int b = wait_bucket(addr);
+
+    TRACE("(%p)\n", addr);
+    /* other addresses share the bucket: wake them all, they check again */
+    AcquireSRWLockExclusive(&wait_buckets[b].lock);
+    ReleaseSRWLockExclusive(&wait_buckets[b].lock);
+#ifndef SG_MUTANT_NOTIFY_INDIRECT_NOP
+    WakeAllConditionVariable(&wait_buckets[b].cv);
+#endif
+}
+
+void __stdcall __std_atomic_notify_all_indirect(const void *addr)
+{
+    unsigned int b = wait_bucket(addr);
+
+    TRACE("(%p)\n", addr);
+    AcquireSRWLockExclusive(&wait_buckets[b].lock);
+    ReleaseSRWLockExclusive(&wait_buckets[b].lock);
+    WakeAllConditionVariable(&wait_buckets[b].cv);
+}
+
+/* the locks of the lock-based atomic objects, one per hash bucket */
+static SRWLOCK atomic_mutexes[WAIT_BUCKETS];
+
+SRWLOCK * __stdcall __std_atomic_get_mutex(const void *key)
+{
+    TRACE("(%p)\n", key);
+    return &atomic_mutexes[wait_bucket(key)];
+}
+
+BOOL __stdcall __std_atomic_has_cmpxchg16b(void)
+{
+    TRACE("()\n");
+#ifdef _WIN64
+    return IsProcessorFeaturePresent(PF_COMPARE_EXCHANGE128);
+#else
+    return FALSE;
+#endif
+}
+
+BOOL __stdcall __std_atomic_compare_exchange_128(LONGLONG *dst, LONGLONG exchange_high,
+        LONGLONG exchange_low, LONGLONG *cmp_result)
+{
+    static SRWLOCK lock = SRWLOCK_INIT;
+    BOOL ret;
+
+    TRACE("(%p %I64x %I64x %p)\n", dst, exchange_high, exchange_low, cmp_result);
+
+#if defined(_WIN64) && !defined(__aarch64__) && !defined(__arm64ec__)
+    if (__std_atomic_has_cmpxchg16b())
+        return InterlockedCompareExchange128(dst, exchange_high, exchange_low, cmp_result);
+#endif
+    /* the same lock for every 128-bit object */
+    AcquireSRWLockExclusive(&lock);
+    ret = dst[0] == cmp_result[0] && dst[1] == cmp_result[1];
+    if (ret)
+    {
+        dst[0] = exchange_low;
+        dst[1] = exchange_high;
+    }
+    else
+    {
+        cmp_result[0] = dst[0];
+        cmp_result[1] = dst[1];
+    }
+    ReleaseSRWLockExclusive(&lock);
+    return ret;
+}
+
+void __stdcall __std_execution_wait_on_uchar(const volatile unsigned char *addr, unsigned char cmp)
+{
+    TRACE("(%p %u)\n", addr, cmp);
+    WaitOnAddress((volatile void *)addr, &cmp, 1, INFINITE);
+}
+
+void __stdcall __std_execution_wake_by_address_all(const volatile void *addr)
+{
+    TRACE("(%p)\n", addr);
+    WakeByAddressAll((void *)addr);
+}
+
 typedef struct
 {
     SRWLOCK srwlock;
diff --git a/dlls/msvcp140_atomic_wait/msvcp140_atomic_wait.spec b/dlls/msvcp140_atomic_wait/msvcp140_atomic_wait.spec
index 9a63deb..f0303d0 100644
--- a/dlls/msvcp140_atomic_wait/msvcp140_atomic_wait.spec
+++ b/dlls/msvcp140_atomic_wait/msvcp140_atomic_wait.spec
@@ -1,22 +1,22 @@
 @ stdcall __std_acquire_shared_mutex_for_instance(ptr)
-@ stub __std_atomic_compare_exchange_128
-@ stub __std_atomic_get_mutex
-@ stub __std_atomic_has_cmpxchg16b
+@ stdcall __std_atomic_compare_exchange_128(ptr int64 int64 ptr)
+@ stdcall __std_atomic_get_mutex(ptr)
+@ stdcall __std_atomic_has_cmpxchg16b()
 @ stdcall __std_atomic_notify_all_direct(ptr)
-@ stub __std_atomic_notify_all_indirect
+@ stdcall __std_atomic_notify_all_indirect(ptr)
 @ stdcall __std_atomic_notify_one_direct(ptr)
-@ stub __std_atomic_notify_one_indirect
-@ stub __std_atomic_set_api_level
+@ stdcall __std_atomic_notify_one_indirect(ptr)
+@ stdcall __std_atomic_set_api_level(long)
 @ stdcall __std_atomic_wait_direct(ptr ptr long long)
-@ stub __std_atomic_wait_get_deadline
-@ stub __std_atomic_wait_get_remaining_timeout
-@ stub __std_atomic_wait_indirect
+@ stdcall -ret64 __std_atomic_wait_get_deadline(int64)
+@ stdcall __std_atomic_wait_get_remaining_timeout(int64)
+@ stdcall __std_atomic_wait_indirect(ptr ptr long ptr ptr long)
 @ stdcall __std_bulk_submit_threadpool_work(ptr long)
 @ stdcall __std_calloc_crt(long long)
 @ stdcall __std_close_threadpool_work(ptr)
 @ stdcall __std_create_threadpool_work(ptr ptr ptr)
-@ stub __std_execution_wait_on_uchar
-@ stub __std_execution_wake_by_address_all
+@ stdcall __std_execution_wait_on_uchar(ptr long)
+@ stdcall __std_execution_wake_by_address_all(ptr)
 @ stdcall __std_free_crt(ptr)
 @ stdcall __std_parallel_algorithms_hw_threads()
 @ stdcall __std_release_shared_mutex_for_instance(ptr)
