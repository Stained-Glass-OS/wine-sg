     ok( ref == 1, "got ref %ld.\n", ref );
 }
 
+static void test_Radio(void)
+{
+    static const WCHAR *radio_name = L"Windows.Devices.Radios.Radio";
+    IAsyncOperation_IVectorView_Radio *views_op;
+    IAsyncOperation_RadioAccessStatus *access_op;
+    IAsyncOperation_BluetoothAdapter *adapter_op;
+    IAsyncOperation_Radio *radio_op;
+    IVectorView_Radio *radios;
+    IBluetoothAdapterStatics *adapter_statics;
+    IBluetoothAdapter *adapter;
+    IActivationFactory *factory, *adapter_factory;
+    IIterator_Radio *iterator;
+    IIterable_Radio *iterable;
+    IRadioStatics *statics;
+    IInspectable *inspectable;
+    RadioAccessStatus access;
+    HSTRING str, bogus;
+    IAsyncInfo *info;
+    AsyncStatus status;
+    IRadio *radio;
+    IID *iids;
+    ULONG count;
+    UINT32 size, index, copied;
+    boolean found, has;
+    HRESULT hr;
+
+    hr = WindowsCreateString( radio_name, wcslen( radio_name ), &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ), "got hr %#lx.\n", hr );
+    if (hr == REGDB_E_CLASSNOTREG)
+    {
+        win_skip( "%s runtimeclass not registered, skipping tests.\n", wine_dbgstr_w( radio_name ) );
+        return;
+    }
+    check_interface( factory, &IID_IUnknown );
+    check_interface( factory, &IID_IInspectable );
+    check_interface( factory, &IID_IAgileObject );
+    hr = IActivationFactory_ActivateInstance( factory, &inspectable );
+    ok( hr == E_NOTIMPL, "got hr %#lx.\n", hr );
+    hr = IActivationFactory_QueryInterface( factory, &IID_IRadioStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = IRadioStatics_GetDeviceSelector( statics, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    hr = IRadioStatics_GetDeviceSelector( statics, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( WindowsGetStringLen( str ) > 0, "got empty selector.\n" );
+    WindowsDeleteString( str );
+
+    hr = IRadioStatics_RequestAccessAsync( statics, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    hr = IRadioStatics_RequestAccessAsync( statics, &access_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncOperation_RadioAccessStatus_QueryInterface( access_op, &IID_IAsyncInfo, (void **)&info );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncInfo_get_Status( info, &status );
+    ok( hr == S_OK && status == Completed, "got hr %#lx, status %d.\n", hr, status );
+    access = 99;
+    hr = IAsyncOperation_RadioAccessStatus_GetResults( access_op, &access );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( access == RadioAccessStatus_Allowed, "got access %d.\n", access );
+    hr = IAsyncInfo_Close( info );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncOperation_RadioAccessStatus_GetResults( access_op, &access );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    IAsyncInfo_Release( info );
+    IAsyncOperation_RadioAccessStatus_Release( access_op );
+
+    hr = IRadioStatics_GetRadiosAsync( statics, &views_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncOperation_IVectorView_Radio_GetResults( views_op, &radios );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IAsyncOperation_IVectorView_Radio_Release( views_op );
+    hr = IVectorView_Radio_get_Size( radios, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IVectorView_Radio_GetAt( radios, size, &radio );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    ok( !radio, "got radio %p.\n", radio );
+    hr = IVectorView_Radio_IndexOf( radios, (IRadio *)0xdeadbeef, &index, &found );
+    ok( hr == S_OK && !found && !index, "got hr %#lx, found %d, index %u.\n", hr, found, index );
+    hr = IVectorView_Radio_GetMany( radios, 0, 4, (IRadio **)&inspectable, &copied );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( copied == min( size, 4 ), "got copied %u for size %u.\n", copied, size );
+    if (copied) IRadio_Release( (IRadio *)inspectable );
+    hr = IVectorView_Radio_GetIids( radios, &count, &iids );
+    ok( hr == S_OK && count == 2, "got hr %#lx, count %lu.\n", hr, count );
+    if (SUCCEEDED(hr)) CoTaskMemFree( iids );
+    hr = IVectorView_Radio_QueryInterface( radios, &IID_IIterable_Radio, (void **)&iterable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IIterable_Radio_First( iterable, &iterator );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IIterator_Radio_get_HasCurrent( iterator, &has );
+    ok( hr == S_OK && has == !!size, "got hr %#lx, has %d for size %u.\n", hr, has, size );
+    while (has)
+    {
+        RadioKind kind;
+        RadioState state;
+
+        hr = IIterator_Radio_get_Current( iterator, &radio );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IRadio_get_Kind( radio, &kind );
+        ok( hr == S_OK && kind == RadioKind_Bluetooth, "got hr %#lx, kind %d.\n", hr, kind );
+        hr = IRadio_get_State( radio, &state );
+        ok( hr == S_OK && state != RadioState_Disabled, "got hr %#lx, state %d.\n", hr, state );
+        IRadio_Release( radio );
+        hr = IIterator_Radio_MoveNext( iterator, &has );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+    }
+    hr = IIterator_Radio_get_Current( iterator, &radio );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    IIterator_Radio_Release( iterator );
+    IIterable_Radio_Release( iterable );
+    IVectorView_Radio_Release( radios );
+
+    hr = WindowsCreateString( L"\\\\?\\bogus-radio", 15, &bogus );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IRadioStatics_FromIdAsync( statics, bogus, &radio_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    radio = (IRadio *)0xdeadbeef;
+    hr = IAsyncOperation_Radio_GetResults( radio_op, &radio );
+    ok( hr == S_OK && !radio, "got hr %#lx, radio %p.\n", hr, radio );
+    IAsyncOperation_Radio_Release( radio_op );
+    WindowsDeleteString( bogus );
+    hr = IRadioStatics_FromIdAsync( statics, NULL, &radio_op );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    IRadioStatics_Release( statics );
+    IActivationFactory_Release( factory );
+
+    /* the adapter and its radio: only when the host has a Bluetooth radio */
+    hr = WindowsCreateString( L"Windows.Devices.Bluetooth.BluetoothAdapter", 42, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&adapter_factory );
+    WindowsDeleteString( str );
+    if (hr != S_OK) return;
+    hr = IActivationFactory_QueryInterface( adapter_factory, &IID_IBluetoothAdapterStatics, (void **)&adapter_statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IBluetoothAdapterStatics_GetDefaultAsync( adapter_statics, &adapter_op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IAsyncOperation_BluetoothAdapter_GetResults( adapter_op, &adapter );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (adapter)
+    {
+        IBluetoothAdapter2 *adapter2;
+        IBluetoothAdapter3 *adapter3;
+        UINT32 length;
+        boolean value;
+
+        hr = IBluetoothAdapter_QueryInterface( adapter, &IID_IBluetoothAdapter2, (void **)&adapter2 );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IBluetoothAdapter2_get_AreClassicSecureConnectionsSupported( adapter2, &value );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        IBluetoothAdapter2_Release( adapter2 );
+        hr = IBluetoothAdapter_QueryInterface( adapter, &IID_IBluetoothAdapter3, (void **)&adapter3 );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IBluetoothAdapter3_get_MaxAdvertisementDataLength( adapter3, &length );
+        ok( hr == S_OK && length >= 31, "got hr %#lx, length %u.\n", hr, length );
+        IBluetoothAdapter3_Release( adapter3 );
+        hr = IBluetoothAdapter_GetRadioAsync( adapter, &radio_op );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IAsyncOperation_Radio_GetResults( radio_op, &radio );
+        ok( hr == S_OK && radio, "got hr %#lx, radio %p.\n", hr, radio );
+        if (radio) IRadio_Release( radio );
+        IAsyncOperation_Radio_Release( radio_op );
+        IBluetoothAdapter_Release( adapter );
+    }
+    else
+    {
+        trace( "no Bluetooth adapter\n" );
+    }
+    IAsyncOperation_BluetoothAdapter_Release( adapter_op );
+    IBluetoothAdapterStatics_Release( adapter_statics );
+    IActivationFactory_Release( adapter_factory );
+}
+
 START_TEST(bluetooth)
 {
     HRESULT hr;
@@ -103,6 +280,7 @@ START_TEST(bluetooth)
     ok( hr == S_OK, "RoInitialize failed, hr %#lx\n", hr );
 
     test_BluetoothAdapterStatics();
+    test_Radio();
 
     RoUninitialize();
 }
