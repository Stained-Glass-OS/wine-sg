+/* This DLL only knows Bluetooth radios (the Wi-Fi and mobile broadband radios of
+ * Windows have no counterpart here), so Radio.Kind is always Bluetooth. */
+
+/* ---- completed async operations ---- */
+
+/* One implementation serves IAsyncOperation<Radio>, IAsyncOperation<RadioAccessStatus> and
+ * IAsyncOperation<IVectorView<Radio>>: their vtables have the same layout (only the pointer
+ * type of GetResults and of the handler differ). */
+
+struct done_op
+{
+    IAsyncOperation_Radio IAsyncOperation_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    const IID *op_iid;
+    const IID *result_iid;      /* NULL: the result is an enum value */
+    const WCHAR *class_name;
+    IUnknown *result;
+    RadioAccessStatus value;
+    IAsyncOperationCompletedHandler_Radio *handler;
+    BOOL closed;
+};
+
+static inline struct done_op *impl_from_op( IAsyncOperation_Radio *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_op, IAsyncOperation_iface );
+}
+
+static inline struct done_op *impl_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct done_op, IAsyncInfo_iface );
+}
+
+static HRESULT done_op_query_interface( struct done_op *op, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, op->op_iid ))
+    {
+        IAsyncOperation_Radio_AddRef( (*out = &op->IAsyncOperation_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IAsyncInfo_AddRef( (*out = &op->IAsyncInfo_iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG done_op_release( struct done_op *op )
+{
+    ULONG ref = InterlockedDecrement( &op->ref );
+
+    if (!ref)
+    {
+        if (op->handler) IAsyncOperationCompletedHandler_Radio_Release( op->handler );
+        if (op->result) IUnknown_Release( op->result );
+        free( op );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_QueryInterface( IAsyncOperation_Radio *iface, REFIID iid, void **out )
+{
+    return done_op_query_interface( impl_from_op( iface ), iid, out );
+}
+
+static ULONG WINAPI op_AddRef( IAsyncOperation_Radio *iface )
+{
+    return InterlockedIncrement( &impl_from_op( iface )->ref );
+}
+
+static ULONG WINAPI op_Release( IAsyncOperation_Radio *iface )
+{
+    return done_op_release( impl_from_op( iface ) );
+}
+
+static HRESULT WINAPI op_GetIids( IAsyncOperation_Radio *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = *impl_from_op( iface )->op_iid;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IAsyncOperation_Radio *iface, HSTRING *name )
+{
+    const WCHAR *class_name = impl_from_op( iface )->class_name;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IAsyncOperation_Radio *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Completed( IAsyncOperation_Radio *iface, IAsyncOperationCompletedHandler_Radio *handler )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    if (op->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+
+    IAsyncOperationCompletedHandler_Radio_AddRef( (op->handler = handler) );
+    /* already completed: the handler runs at once */
+    IAsyncOperationCompletedHandler_Radio_Invoke( handler, iface, Completed );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Completed( IAsyncOperation_Radio *iface, IAsyncOperationCompletedHandler_Radio **handler )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    if (!handler) return E_POINTER;
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    if ((*handler = op->handler)) IAsyncOperationCompletedHandler_Radio_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults( IAsyncOperation_Radio *iface, void **results )
+{
+    struct done_op *op = impl_from_op( iface );
+
+    if (!results) return E_POINTER;
+    if (op->closed) return E_ILLEGAL_METHOD_CALL;
+    if (!op->result_iid)
+    {
+        *(RadioAccessStatus *)results = op->value;
+        return S_OK;
+    }
+    *results = NULL;
+    if (op->result) return IUnknown_QueryInterface( op->result, op->result_iid, results );
+    return S_OK;
+}
+
+static const IAsyncOperation_RadioVtbl op_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    op_put_Completed, op_get_Completed, (void *)op_GetResults,
+};
+
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return done_op_query_interface( impl_from_info( iface ), iid, out );
+}
+
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface )
+{
+    return InterlockedIncrement( &impl_from_info( iface )->ref );
+}
+
+static ULONG WINAPI info_Release( IAsyncInfo *iface )
+{
+    return done_op_release( impl_from_info( iface ) );
+}
+
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(IID) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncInfo;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )
+{
+    return op_GetRuntimeClassName( &impl_from_info( iface )->IAsyncOperation_iface, name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    if (impl_from_info( iface )->closed) return E_ILLEGAL_METHOD_CALL;
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct done_op *op = impl_from_info( iface );
+    *status = op->closed ? 4 : Completed;
+    return op->closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code )
+{
+    struct done_op *op = impl_from_info( iface );
+    *code = op->closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+    return *code;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    return impl_from_info( iface )->closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    impl_from_info( iface )->closed = TRUE;
+    return S_OK;
+}
+
+static const IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release, info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+static HRESULT done_op_create( const IID *op_iid, const IID *result_iid, const WCHAR *class_name, IUnknown *result,
+                               RadioAccessStatus value, void **out )
+{
+    struct done_op *op;
+
+    *out = NULL;
+    if (!(op = calloc( 1, sizeof(*op) ))) return E_OUTOFMEMORY;
+    op->IAsyncOperation_iface.lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    op->op_iid = op_iid;
+    op->result_iid = result_iid;
+    op->class_name = class_name;
+    if ((op->result = result)) IUnknown_AddRef( result );
+    op->value = value;
+    *out = &op->IAsyncOperation_iface;
+    return S_OK;
+}
+
+static HRESULT status_op_create( RadioAccessStatus status, IAsyncOperation_RadioAccessStatus **out )
+{
+    return done_op_create( &IID_IAsyncOperation_RadioAccessStatus, NULL,
+                           L"Windows.Foundation.IAsyncOperation`1<Windows.Devices.Radios.RadioAccessStatus>",
+                           NULL, status, (void **)out );
+}
+
+static HRESULT radio_op_create( IUnknown *radio, IAsyncOperation_Radio **out )
+{
+    return done_op_create( &IID_IAsyncOperation_Radio, &IID_IRadio,
+                           L"Windows.Foundation.IAsyncOperation`1<Windows.Devices.Radios.Radio>",
+                           radio, 0, (void **)out );
+}
+
+static HRESULT view_op_create( IUnknown *view, IAsyncOperation_IVectorView_Radio **out )
+{
+    return done_op_create( &IID_IAsyncOperation_IVectorView_Radio, &IID_IVectorView_Radio,
+                           L"Windows.Foundation.IAsyncOperation`1<Windows.Foundation.Collections.IVectorView`1<Windows.Devices.Radios.Radio>>",
+                           view, 0, (void **)out );
+}
+
+
+/* ---- the radio devices ---- */
+
+static HANDLE open_radio( const WCHAR *path )
+{
+    return CreateFileW( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+}
+
+/* The local radio information of the radio at "path"; FALSE when it is not a working radio. */
+static BOOL query_radio( const WCHAR *path, BTH_LOCAL_RADIO_INFO *info )
+{
+    DWORD size;
+    HANDLE device;
+    BOOL ok;
+
+    if ((device = open_radio( path )) == INVALID_HANDLE_VALUE) return FALSE;
+    ok = DeviceIoControl( device, IOCTL_BTH_GET_LOCAL_INFO, NULL, 0, info, sizeof(*info), &size, NULL );
+    CloseHandle( device );
+    return ok;
+}
+
+/* All present radios (device interface paths; "only" restricts to one path). */
+static HRESULT enum_radios( const WCHAR *only, WCHAR ***paths, UINT32 *count )
+{
+    char buffer[sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) + MAX_PATH * sizeof(WCHAR)];
+    SP_DEVICE_INTERFACE_DETAIL_DATA_W *detail = (SP_DEVICE_INTERFACE_DETAIL_DATA_W *)buffer;
+    SP_DEVICE_INTERFACE_DATA data = { sizeof(data) };
+    HDEVINFO devinfo;
+    WCHAR **list = NULL;
+    UINT32 n = 0;
+    DWORD i;
+
+    *paths = NULL;
+    *count = 0;
+    devinfo = SetupDiGetClassDevsW( &GUID_BLUETOOTH_RADIO_INTERFACE, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE );
+    if (devinfo == INVALID_HANDLE_VALUE) return S_OK;
+
+    detail->cbSize = sizeof(*detail);
+    for (i = 0; SetupDiEnumDeviceInterfaces( devinfo, NULL, &GUID_BLUETOOTH_RADIO_INTERFACE, i, &data ); i++)
+    {
+        BTH_LOCAL_RADIO_INFO info;
+        WCHAR **new_list;
+
+        if (!SetupDiGetDeviceInterfaceDetailW( devinfo, &data, detail, sizeof(buffer), NULL, NULL )) continue;
+        if (only && wcsicmp( only, detail->DevicePath )) continue;
+        if (!query_radio( detail->DevicePath, &info )) continue;
+        if (!(new_list = realloc( list, (n + 1) * sizeof(*list) )))
+        {
+            while (n) free( list[--n] );
+            free( list );
+            SetupDiDestroyDeviceInfoList( devinfo );
+            return E_OUTOFMEMORY;
+        }
+        list = new_list;
+        if (!(list[n] = wcsdup( detail->DevicePath )))
+        {
+            while (n) free( list[--n] );
+            free( list );
+            SetupDiDestroyDeviceInfoList( devinfo );
+            return E_OUTOFMEMORY;
+        }
+        n++;
+    }
+    SetupDiDestroyDeviceInfoList( devinfo );
+    *paths = list;
+    *count = n;
+    return S_OK;
+}
+
+
+/* ---- Radio ---- */
+
+struct handler_entry
+{
+    EventRegistrationToken token;
+    ITypedEventHandler_Radio_IInspectable *handler;
+};
+
+struct radio
+{
+    IRadio IRadio_iface;
+    LONG ref;
+    WCHAR *path;
+
+    CRITICAL_SECTION cs;
+    struct handler_entry *handlers;
+    UINT32 handler_count;
+    INT64 next_token;
+};
+
+static inline struct radio *impl_from_IRadio( IRadio *iface )
+{
+    return CONTAINING_RECORD( iface, struct radio, IRadio_iface );
+}
+
+static HRESULT WINAPI radio_QueryInterface( IRadio *iface, REFIID iid, void **out )
+{
+    struct radio *impl = impl_from_IRadio( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
