+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* Radio has no default constructor, only the statics */
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( radio_statics, IRadioStatics, struct radio_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI radio_statics_GetRadiosAsync( IRadioStatics *iface, IAsyncOperation_IVectorView_Radio **operation )
+{
+    struct radio_view *view;
+    WCHAR **paths;
+    UINT32 count, i;
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    if (FAILED(hr = enum_radios( NULL, &paths, &count ))) return hr;
+    if (!(view = calloc( 1, sizeof(*view) )) || !(view->radios = calloc( count + 1, sizeof(*view->radios) )))
+    {
+        free( view );
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    view->IVectorView_Radio_iface.lpVtbl = &view_vtbl;
+    view->IIterable_Radio_iface.lpVtbl = &iterable_vtbl;
+    view->ref = 1;
+    for (i = 0; i < count; i++)
+    {
+        struct radio *radio;
+
+        if (FAILED(hr = radio_create( paths[i], &radio ))) break;
+        view->radios[view->count++] = &radio->IRadio_iface;
+    }
+    if (SUCCEEDED(hr)) hr = view_op_create( (IUnknown *)&view->IVectorView_Radio_iface, operation );
+    IVectorView_Radio_Release( &view->IVectorView_Radio_iface );
+done:
+    for (i = 0; i < count; i++) free( paths[i] );
+    free( paths );
+    return hr;
+}
+
+/* The selector of the radio device interfaces (the same class the adapters use). */
+static HRESULT WINAPI radio_statics_GetDeviceSelector( IRadioStatics *iface, HSTRING *selector )
+{
+    static const WCHAR text[] = L"System.Devices.InterfaceClassGuid:=\"{92383B0E-F90E-4AC9-8D44-8C2D0D0EBDA2}\" "
+                                L"AND System.Devices.InterfaceEnabled:=System.StructuredQueryType.Boolean#True";
+
+    TRACE( "iface %p, selector %p.\n", iface, selector );
+
+    if (!selector) return E_POINTER;
+#ifdef SG_MUTANT_RADIO_SELECTOR
+    return WindowsCreateString( text, 0, selector );
+#endif
+    return WindowsCreateString( text, ARRAY_SIZE(text) - 1, selector );
+}
+
+static HRESULT WINAPI radio_statics_FromIdAsync( IRadioStatics *iface, HSTRING id, IAsyncOperation_Radio **operation )
+{
+    TRACE( "iface %p, id %s, operation %p.\n", iface, debugstr_hstring( id ), operation );
+
+    if (!operation) return E_POINTER;
+    if (!id) return E_INVALIDARG;
+    return bluetooth_radio_async( WindowsGetStringRawBuffer( id, NULL ), operation );
+}
+
+static HRESULT WINAPI radio_statics_RequestAccessAsync( IRadioStatics *iface, IAsyncOperation_RadioAccessStatus **operation )
+{
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+    /* there is no per-app radio privacy setting here */
+#ifdef SG_MUTANT_RADIO_ACCESS
+    return status_op_create( RadioAccessStatus_DeniedBySystem, operation );
+#endif
+    return status_op_create( RadioAccessStatus_Allowed, operation );
+}
+
+static const struct IRadioStaticsVtbl radio_statics_vtbl =
+{
+    radio_statics_QueryInterface, radio_statics_AddRef, radio_statics_Release,
+    radio_statics_GetIids, radio_statics_GetRuntimeClassName, radio_statics_GetTrustLevel,
+    radio_statics_GetRadiosAsync, radio_statics_GetDeviceSelector, radio_statics_FromIdAsync,
+    radio_statics_RequestAccessAsync,
+};
+
+static struct radio_statics radio_statics =
+{
+    {&factory_vtbl},
+    {&radio_statics_vtbl},
+    1,
+};
+
+IActivationFactory *radio_factory = &radio_statics.IActivationFactory_iface;
