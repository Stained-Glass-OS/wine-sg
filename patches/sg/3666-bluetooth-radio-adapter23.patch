+static HRESULT radio_create( const WCHAR *path, struct radio **out )
+{
+    struct radio *radio;
+
+    *out = NULL;
+    if (!(radio = calloc( 1, sizeof(*radio) ))) return E_OUTOFMEMORY;
+    if (!(radio->path = wcsdup( path )))
+    {
+        free( radio );
+        return E_OUTOFMEMORY;
+    }
+    radio->IRadio_iface.lpVtbl = &radio_vtbl;
+    radio->ref = 1;
+    InitializeCriticalSectionEx( &radio->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    radio->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": radio.cs");
+    *out = radio;
+    return S_OK;
+}
+
+/* The radio with the device id "path" as a completed operation: a null radio when there is none. */
+HRESULT bluetooth_radio_async( const WCHAR *path, IAsyncOperation_Radio **operation )
+{
+    WCHAR **paths;
+    UINT32 count;
+    struct radio *radio = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = enum_radios( path, &paths, &count ))) return hr;
+    if (count && FAILED(hr = radio_create( paths[0], &radio ))) goto done;
+    hr = radio_op_create( radio ? (IUnknown *)&radio->IRadio_iface : NULL, operation );
+    if (radio) IRadio_Release( &radio->IRadio_iface );
+done:
+    while (count) free( paths[--count] );
+    free( paths );
+    return hr;
+}
