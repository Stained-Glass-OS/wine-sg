+static RadioState radio_get_state( struct radio *radio )
+{
+    BTH_LOCAL_RADIO_INFO info;
+
+    if (!query_radio( radio->path, &info )) return RadioState_Unknown;
+    return (info.flags & WINEBTH_LOCAL_RADIO_POWERED) ? RadioState_On : RadioState_Off;
+}
+
+static void radio_fire_state_changed( struct radio *radio )
+{
+    struct handler_entry *copy;
+    UINT32 i, count;
+
+    EnterCriticalSection( &radio->cs );
+    count = radio->handler_count;
+    if (!count || !(copy = malloc( count * sizeof(*copy) )))
+    {
+        LeaveCriticalSection( &radio->cs );
+        return;
+    }
+    memcpy( copy, radio->handlers, count * sizeof(*copy) );
+    for (i = 0; i < count; i++) ITypedEventHandler_Radio_IInspectable_AddRef( copy[i].handler );
+    LeaveCriticalSection( &radio->cs );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_Radio_IInspectable_Invoke( copy[i].handler, &radio->IRadio_iface, NULL );
+        ITypedEventHandler_Radio_IInspectable_Release( copy[i].handler );
+    }
+    free( copy );
+}
+
+static HRESULT WINAPI radio_SetStateAsync( IRadio *iface, RadioState state, IAsyncOperation_RadioAccessStatus **operation )
+{
+    struct radio *impl = impl_from_IRadio( iface );
+    RadioAccessStatus status = RadioAccessStatus_DeniedBySystem;
+    RadioState before;
+
+    TRACE( "iface %p, state %d, operation %p.\n", iface, state, operation );
+
+    if (!operation) return E_POINTER;
+
+    /* only On and Off can be requested; Unknown and Disabled are states the system reports */
+    if (state == RadioState_On || state == RadioState_Off)
+    {
+        struct winebth_device_op op = { .op = WINEBTH_OP_SET_POWERED, .value = state == RadioState_On };
+        HANDLE device;
+        DWORD size;
+
+        before = radio_get_state( impl );
+        if ((device = open_radio( impl->path )) != INVALID_HANDLE_VALUE)
+        {
+            if (DeviceIoControl( device, IOCTL_WINEBTH_RADIO_DEVICE_OP, &op, sizeof(op), NULL, 0, &size, NULL ))
+                status = RadioAccessStatus_Allowed;
+            CloseHandle( device );
+        }
+        if (status == RadioAccessStatus_Allowed && before != state) radio_fire_state_changed( impl );
+    }
+    return status_op_create( status, operation );
+}
+
+static HRESULT WINAPI radio_add_StateChanged( IRadio *iface, ITypedEventHandler_Radio_IInspectable *handler,
+                                              EventRegistrationToken *token )
+{
+    struct radio *impl = impl_from_IRadio( iface );
+    struct handler_entry *new_list;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!token) return E_POINTER;
+    token->value = 0;
+    if (!handler) return E_INVALIDARG;
+
+    EnterCriticalSection( &impl->cs );
+    if (!(new_list = realloc( impl->handlers, (impl->handler_count + 1) * sizeof(*new_list) )))
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_OUTOFMEMORY;
+    }
+    impl->handlers = new_list;
+    ITypedEventHandler_Radio_IInspectable_AddRef( handler );
+    new_list[impl->handler_count].handler = handler;
+    new_list[impl->handler_count].token.value = token->value = ++impl->next_token;
+    impl->handler_count++;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI radio_remove_StateChanged( IRadio *iface, EventRegistrationToken token )
+{
+    struct radio *impl = impl_from_IRadio( iface );
+    UINT32 i;
+
+    TRACE( "iface %p, token %I64d.\n", iface, token.value );
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->handler_count; i++)
+    {
+        if (impl->handlers[i].token.value != token.value) continue;
+        ITypedEventHandler_Radio_IInspectable_Release( impl->handlers[i].handler );
+        memmove( impl->handlers + i, impl->handlers + i + 1, (impl->handler_count - i - 1) * sizeof(*impl->handlers) );
+        impl->handler_count--;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
