From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] explorer: an appbar docks at once while programs are busy

Since 1120 every window is told of a new work area (WM_SETTINGCHANGE
SPI_SETWORKAREA), so a maximized window fills it again. Explorer sent that
broadcast from inside the request that changed the work area -- an
appbar's SHAppBarMessage, or the taskbar's own resize -- and a broadcast
waits for each window in turn, up to two seconds for one whose thread is
busy. A docked touch keyboard took about 4.5 seconds to dock, and the
program that docked it hung meanwhile.

Explorer now sets the work area without the broadcast and has a thread of
its own tell every window; several changes in a row are told once. The
request returns at once; maximized windows still move.

Test: test/dpifollow-gate.sh part 8 (an appbar docks under a second beside
two busy programs, the maximized window moves right of it); mutant
SG_MUTANT_WORKAREA_SYNC_BROADCAST (explorer appbar.c). test/a11y-gate.sh
still passes.
---
--- a/programs/explorer/appbar.c
+++ b/programs/explorer/appbar.c
@@ -136,6 +136,50 @@
  * on Windows, so maximized and snapped windows make room for it (the docked
  * Magnifier, a toolbar). The work area is the screen less the taskbar and
  * every appbar's space; appbars whose window is gone give theirs back. */
+#ifndef SG_MUTANT_WORKAREA_SYNC_BROADCAST
+/* Stained Glass OS: every window hears of a new work area (WM_SETTINGCHANGE
+ * SPI_SETWORKAREA; a maximized one fills it again), but not while the
+ * program that moved an appbar, or the taskbar, waits on us. The broadcast
+ * waits for each window in turn, up to two seconds for one whose thread is
+ * busy, so a docked touch keyboard took seconds to dock (the broadcast ran
+ * inside its SHAppBarMessage). A thread of our own sends it; several changes
+ * in a row are told once, the latest work area. */
+static HANDLE work_area_event;
+
+static DWORD WINAPI work_area_thread( void *arg )
+{
+    for (;;)
+    {
+        WaitForSingleObject( work_area_event, INFINITE );
+        SendMessageTimeoutW( HWND_BROADCAST, WM_SETTINGCHANGE, SPI_SETWORKAREA, (LPARAM)L"",
+                             SMTO_ABORTIFHUNG, 2000, NULL );
+    }
+    return 0;
+}
+
+static void tell_work_area(void)
+{
+    HANDLE thread;
+
+    if (!work_area_event)
+    {
+        work_area_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+        if (work_area_event && (thread = CreateThread( NULL, 0, work_area_thread, NULL, 0, NULL )))
+            CloseHandle( thread );
+        else
+        {
+            if (work_area_event) CloseHandle( work_area_event );
+            work_area_event = NULL;
+            SendMessageTimeoutW( HWND_BROADCAST, WM_SETTINGCHANGE, SPI_SETWORKAREA, (LPARAM)L"",
+                                 SMTO_ABORTIFHUNG, 2000, NULL );
+            return;
+        }
+    }
+    SetEvent( work_area_event );
+}
+
+#endif
+
 void update_work_area(void)
 {
     struct appbar_data *data, *next;
@@ -178,7 +222,17 @@
         }
     }
     TRACE( "work area %s\n", wine_dbgstr_rect( &work ) );
+#ifndef SG_MUTANT_WORKAREA_SYNC_BROADCAST
+    {
+        RECT old;
+        BOOL changed = !SystemParametersInfoW( SPI_GETWORKAREA, 0, &old, 0 ) || !EqualRect( &old, &work );
+
+        SystemParametersInfoW( SPI_SETWORKAREA, 0, &work, 0 );
+        if (changed) tell_work_area();
+    }
+#else
     SystemParametersInfoW( SPI_SETWORKAREA, 0, &work, SPIF_SENDCHANGE );
+#endif
 }
 
 static UINT_PTR handle_appbarmessage(DWORD msg, struct appbar_data_msg *abd)
