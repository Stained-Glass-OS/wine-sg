From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] ntoskrnl: shutdown notification.

IoRegisterShutdownNotification and IoUnregisterShutdownNotification were
FIXMEs and IoRegisterLastChanceShutdownNotification was unimplemented. A
registered device carries DO_SHUTDOWN_REGISTERED; when services.exe sends the
shutdown control to the driver's service, winedevice has each registered
device of the driver receive IRP_MJ_SHUTDOWN, the last chance ones after the
others. Deleting a device unregisters it.

Gate: test/ntoskrnl-shutdown-gate.sh.
---

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1859,6 +1859,7 @@
 
 
 static void free_startio_state( DEVICE_OBJECT *device );
+static void unregister_shutdown( DEVICE_OBJECT *device );
 
 /***********************************************************************
  *           IoDeleteDevice   (NTOSKRNL.EXE.@)
@@ -1886,6 +1887,7 @@
 
         free_io_timer( device );
         free_startio_state( device );
+        unregister_shutdown( device );
         while (*prev && *prev != device) prev = &(*prev)->NextDevice;
         if (*prev) *prev = (*prev)->NextDevice;
         if ((children = wine_device->children))
@@ -2186,24 +2188,145 @@
     register_reinit( driver, proc, ctx );
 }
 
+/* devices registered for IRP_MJ_SHUTDOWN, with the last chance ones sent after the others */
+struct shutdown_device
+{
+    struct list entry;
+    DEVICE_OBJECT *device;
+    BOOL last_chance;
+};
+static struct list shutdown_devices = LIST_INIT( shutdown_devices );
+static CRITICAL_SECTION shutdown_cs;
+static CRITICAL_SECTION_DEBUG shutdown_cs_debug =
+{
+    0, 0, &shutdown_cs,
+    { &shutdown_cs_debug.ProcessLocksList, &shutdown_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": shutdown_cs") }
+};
+static CRITICAL_SECTION shutdown_cs = { &shutdown_cs_debug, -1, 0, 0, 0, 0 };
+
+static NTSTATUS register_shutdown( DEVICE_OBJECT *device, BOOL last_chance )
+{
+    struct shutdown_device *entry;
+
+    EnterCriticalSection( &shutdown_cs );
+    LIST_FOR_EACH_ENTRY( entry, &shutdown_devices, struct shutdown_device, entry )
+    {
+        if (entry->device == device)
+        {
+            LeaveCriticalSection( &shutdown_cs );
+            return STATUS_SUCCESS;
+        }
+    }
+    if (!(entry = malloc( sizeof(*entry) )))
+    {
+        LeaveCriticalSection( &shutdown_cs );
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    ObReferenceObject( device );
+    entry->device = device;
+    entry->last_chance = last_chance;
+    list_add_tail( &shutdown_devices, &entry->entry );
+#ifndef SG_MUTANT_SHUTDOWN_NO_FLAG
+    device->Flags |= DO_SHUTDOWN_REGISTERED;
+#endif
+    LeaveCriticalSection( &shutdown_cs );
+    return STATUS_SUCCESS;
+}
+
+static void unregister_shutdown( DEVICE_OBJECT *device )
+{
+    struct shutdown_device *entry;
+
+    EnterCriticalSection( &shutdown_cs );
+    LIST_FOR_EACH_ENTRY( entry, &shutdown_devices, struct shutdown_device, entry )
+    {
+        if (entry->device != device) continue;
+#ifdef SG_MUTANT_SHUTDOWN_UNREGISTER
+        break;
+#endif
+        list_remove( &entry->entry );
+        device->Flags &= ~DO_SHUTDOWN_REGISTERED;
+        ObDereferenceObject( device );
+        free( entry );
+        break;
+    }
+    LeaveCriticalSection( &shutdown_cs );
+}
+
 /***********************************************************************
  *           IoRegisterShutdownNotification    (NTOSKRNL.EXE.@)
  */
 NTSTATUS WINAPI IoRegisterShutdownNotification( PDEVICE_OBJECT obj )
 {
-    FIXME( "stub: %p\n", obj );
-    return STATUS_SUCCESS;
+    TRACE( "%p\n", obj );
+    return register_shutdown( obj, FALSE );
 }
 
+/***********************************************************************
+ *           IoRegisterLastChanceShutdownNotification    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoRegisterLastChanceShutdownNotification( PDEVICE_OBJECT obj )
+{
+    TRACE( "%p\n", obj );
+    return register_shutdown( obj, TRUE );
+}
 
 /***********************************************************************
  *           IoUnregisterShutdownNotification    (NTOSKRNL.EXE.@)
  */
 VOID WINAPI IoUnregisterShutdownNotification( PDEVICE_OBJECT obj )
 {
-    FIXME( "stub: %p\n", obj );
+    TRACE( "%p\n", obj );
+    unregister_shutdown( obj );
+}
+
+static void send_shutdown_irp( DEVICE_OBJECT *device )
+{
+    IO_STATUS_BLOCK io;
+    KEVENT event;
+    IRP *irp;
+
+    KeInitializeEvent( &event, NotificationEvent, FALSE );
+    if (!(irp = IoBuildSynchronousFsdRequest( IRP_MJ_SHUTDOWN, device, NULL, 0, NULL, &event, &io ))) return;
+    if (IoCallDriver( device, irp ) == STATUS_PENDING) KeWaitForSingleObject( &event, Executive, KernelMode, FALSE, NULL );
 }
 
+/* the system is shutting down: every device of the driver registered for it gets IRP_MJ_SHUTDOWN,
+ * the last chance ones after the others */
+void CDECL wine_ntoskrnl_shutdown_driver( const WCHAR *driver_name )
+{
+    struct shutdown_device *entry, *next;
+    DEVICE_OBJECT *devices[64];
+    unsigned int count, pass, i;
+    struct wine_driver *wine_driver;
+    DRIVER_OBJECT *driver;
+
+    TRACE( "%s\n", debugstr_w(driver_name) );
+
+    if (!(wine_driver = get_driver( driver_name ))) return;
+    driver = &wine_driver->driver_obj;
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        count = 0;
+        EnterCriticalSection( &shutdown_cs );
+        LIST_FOR_EACH_ENTRY_SAFE( entry, next, &shutdown_devices, struct shutdown_device, entry )
+        {
+#ifdef SG_MUTANT_SHUTDOWN_ORDER
+            if (entry->device->DriverObject != driver || count == ARRAY_SIZE(devices) || pass) continue;
+#else
+            if (entry->device->DriverObject != driver || entry->last_chance != pass || count == ARRAY_SIZE(devices)) continue;
+#endif
+            devices[count++] = entry->device;
+        }
+        LeaveCriticalSection( &shutdown_cs );
+        for (i = 0; i < count; i++)
+        {
+            send_shutdown_irp( devices[i] );
+        }
+    }
+}
 
 /***********************************************************************
  *           IoReportResourceForDetection   (NTOSKRNL.EXE.@)
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -455,7 +455,7 @@
 @ stdcall IoRegisterDriverReinitialization(ptr ptr ptr)
 @ stdcall IoRegisterFileSystem(ptr)
 @ stub IoRegisterFsRegistrationChange
-@ stub IoRegisterLastChanceShutdownNotification
+@ stdcall IoRegisterLastChanceShutdownNotification(ptr)
 @ stdcall IoRegisterPlugPlayNotification(long long ptr ptr ptr ptr ptr)
 @ stdcall IoRegisterShutdownNotification(ptr)
 @ stdcall IoReleaseCancelSpinLock(long)
@@ -1713,3 +1713,4 @@
 
 @ cdecl wine_ntoskrnl_main_loop(long)
 @ cdecl wine_enumerate_root_devices(wstr)
+@ cdecl wine_ntoskrnl_shutdown_driver(wstr)
diff --git a/dlls/ntoskrnl.exe/ntoskrnl_private.h b/dlls/ntoskrnl.exe/ntoskrnl_private.h
--- a/dlls/ntoskrnl.exe/ntoskrnl_private.h
+++ b/dlls/ntoskrnl.exe/ntoskrnl_private.h
@@ -110,6 +110,7 @@
 void pnp_manager_stop(void);
 
 void CDECL wine_enumerate_root_devices( const WCHAR *driver_name );
+void CDECL wine_ntoskrnl_shutdown_driver( const WCHAR *driver_name );
 
 struct wine_driver *get_driver( const WCHAR *name );
 
diff --git a/programs/winedevice/device.c b/programs/winedevice/device.c
--- a/programs/winedevice/device.c
+++ b/programs/winedevice/device.c
@@ -36,6 +36,7 @@
 
 extern NTSTATUS CDECL wine_ntoskrnl_main_loop( HANDLE stop_event );
 extern void CDECL wine_enumerate_root_devices( const WCHAR *driver_name );
+extern void CDECL wine_ntoskrnl_shutdown_driver( const WCHAR *driver_name );
 
 static WCHAR winedeviceW[] = L"winedevice";
 static SERVICE_STATUS_HANDLE service_handle;
@@ -85,6 +86,10 @@
         wine_enumerate_root_devices( driver_name );
         break;
 
+    case SERVICE_CONTROL_SHUTDOWN:
+        wine_ntoskrnl_shutdown_driver( driver_name );
+        break;
+
     default:
         FIXME( "got driver ctrl %lx for %s\n", ctrl, wine_dbgstr_w(driver_name) );
         break;
-- 
