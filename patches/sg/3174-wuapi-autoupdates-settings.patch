From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Tue, 13 Oct 2026 07:58:37 -0700
Subject: [PATCH] wuapi: IAutomaticUpdates Settings object and EnableService

IAutomaticUpdates::Settings returns an IAutomaticUpdatesSettings that reports a system without an update
service (not configured, read only, every day at 3:00); changes and Save are refused with E_ACCESSDENIED,
out-of-range values with E_INVALIDARG. EnableService reports that the service does not exist, consistent
with ServiceEnabled being false.

diff --git a/dlls/wuapi/updates.c b/dlls/wuapi/updates.c
index 45433ae..81a9ff9 100644
--- a/dlls/wuapi/updates.c
+++ b/dlls/wuapi/updates.c
@@ -109,6 +109,184 @@ static HRESULT WINAPI automatic_updates_Invoke( IAutomaticUpdates *iface, DISPID
     return wu_Invoke( (IDispatch *)iface, &IID_IAutomaticUpdates, id, riid, lcid, flags, params, result, excep, arg_err );
 }
 
+
+typedef struct _automatic_updates_settings
+{
+    IAutomaticUpdatesSettings IAutomaticUpdatesSettings_iface;
+    LONG refs;
+    AutomaticUpdatesNotificationLevel level;
+    AutomaticUpdatesScheduledInstallationDay day;
+    LONG time;
+} automatic_updates_settings;
+
+static inline automatic_updates_settings *impl_from_IAutomaticUpdatesSettings( IAutomaticUpdatesSettings *iface )
+{
+    return CONTAINING_RECORD(iface, automatic_updates_settings, IAutomaticUpdatesSettings_iface);
+}
+
+static ULONG WINAPI aus_AddRef( IAutomaticUpdatesSettings *iface )
+{
+    return InterlockedIncrement( &impl_from_IAutomaticUpdatesSettings( iface )->refs );
+}
+
+static ULONG WINAPI aus_Release( IAutomaticUpdatesSettings *iface )
+{
+    automatic_updates_settings *This = impl_from_IAutomaticUpdatesSettings( iface );
+    LONG refs = InterlockedDecrement( &This->refs );
+    if (!refs) HeapFree( GetProcessHeap(), 0, This );
+    return refs;
+}
+
+static HRESULT WINAPI aus_QueryInterface( IAutomaticUpdatesSettings *iface, REFIID riid, void **ppv )
+{
+    if (IsEqualGUID( riid, &IID_IAutomaticUpdatesSettings ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *ppv = iface;
+        IAutomaticUpdatesSettings_AddRef( iface );
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI aus_GetTypeInfoCount( IAutomaticUpdatesSettings *iface, UINT *count )
+{
+    return wu_GetTypeInfoCount( count );
+}
+
+static HRESULT WINAPI aus_GetTypeInfo( IAutomaticUpdatesSettings *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    return wu_GetTypeInfo( &IID_IAutomaticUpdatesSettings, index, lcid, info );
+}
+
+static HRESULT WINAPI aus_GetIDsOfNames( IAutomaticUpdatesSettings *iface, REFIID riid, LPOLESTR *names, UINT count,
+                                         LCID lcid, DISPID *dispid )
+{
+    return wu_GetIDsOfNames( &IID_IAutomaticUpdatesSettings, riid, names, count, lcid, dispid );
+}
+
+static HRESULT WINAPI aus_Invoke( IAutomaticUpdatesSettings *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+                                  DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    return wu_Invoke( (IDispatch *)iface, &IID_IAutomaticUpdatesSettings, id, riid, lcid, flags, params, result,
+                      excep, arg_err );
+}
+
+/* There is no update service here, so the settings cannot be changed or saved. */
+static HRESULT WINAPI aus_get_NotificationLevel( IAutomaticUpdatesSettings *iface, AutomaticUpdatesNotificationLevel *retval )
+{
+    TRACE( "%p, %p\n", iface, retval );
+    if (!retval) return E_POINTER;
+    *retval = impl_from_IAutomaticUpdatesSettings( iface )->level;
+    return S_OK;
+}
+
+static HRESULT WINAPI aus_put_NotificationLevel( IAutomaticUpdatesSettings *iface, AutomaticUpdatesNotificationLevel value )
+{
+    TRACE( "%p, %d\n", iface, value );
+    if (value < aunlNotConfigured || value > aunlScheduledInstallation) return E_INVALIDARG;
+#ifdef SG_MUTANT_WUAPI_WRITABLE
+    return S_OK;
+#endif
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI aus_get_ReadOnly( IAutomaticUpdatesSettings *iface, VARIANT_BOOL *retval )
+{
+    TRACE( "%p, %p\n", iface, retval );
+    if (!retval) return E_POINTER;
+    *retval = VARIANT_TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI aus_get_Required( IAutomaticUpdatesSettings *iface, VARIANT_BOOL *retval )
+{
+    TRACE( "%p, %p\n", iface, retval );
+    if (!retval) return E_POINTER;
+    *retval = VARIANT_FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI aus_get_ScheduledInstallationDay( IAutomaticUpdatesSettings *iface,
+                                                         AutomaticUpdatesScheduledInstallationDay *retval )
+{
+    TRACE( "%p, %p\n", iface, retval );
+    if (!retval) return E_POINTER;
+    *retval = impl_from_IAutomaticUpdatesSettings( iface )->day;
+    return S_OK;
+}
+
+static HRESULT WINAPI aus_put_ScheduledInstallationDay( IAutomaticUpdatesSettings *iface,
+                                                         AutomaticUpdatesScheduledInstallationDay value )
+{
+    TRACE( "%p, %d\n", iface, value );
+    if (value < ausidEveryDay || value > ausidEverySaturday) return E_INVALIDARG;
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI aus_get_ScheduledInstallationTime( IAutomaticUpdatesSettings *iface, LONG *retval )
+{
+    TRACE( "%p, %p\n", iface, retval );
+    if (!retval) return E_POINTER;
+    *retval = impl_from_IAutomaticUpdatesSettings( iface )->time;
+    return S_OK;
+}
+
+static HRESULT WINAPI aus_put_ScheduledInstallationTime( IAutomaticUpdatesSettings *iface, LONG value )
+{
+    TRACE( "%p, %ld\n", iface, value );
+    if (value < 0 || value > 23) return E_INVALIDARG;
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI aus_Refresh( IAutomaticUpdatesSettings *iface )
+{
+    TRACE( "%p\n", iface );
+    return S_OK;
+}
+
+static HRESULT WINAPI aus_Save( IAutomaticUpdatesSettings *iface )
+{
+    TRACE( "%p\n", iface );
+    return E_ACCESSDENIED;
+}
+
+static const IAutomaticUpdatesSettingsVtbl automatic_updates_settings_vtbl =
+{
+    aus_QueryInterface,
+    aus_AddRef,
+    aus_Release,
+    aus_GetTypeInfoCount,
+    aus_GetTypeInfo,
+    aus_GetIDsOfNames,
+    aus_Invoke,
+    aus_get_NotificationLevel,
+    aus_put_NotificationLevel,
+    aus_get_ReadOnly,
+    aus_get_Required,
+    aus_get_ScheduledInstallationDay,
+    aus_put_ScheduledInstallationDay,
+    aus_get_ScheduledInstallationTime,
+    aus_put_ScheduledInstallationTime,
+    aus_Refresh,
+    aus_Save
+};
+
+static HRESULT AutomaticUpdatesSettings_create( IAutomaticUpdatesSettings **ret )
+{
+    automatic_updates_settings *settings;
+
+    if (!(settings = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*settings) ))) return E_OUTOFMEMORY;
+    settings->IAutomaticUpdatesSettings_iface.lpVtbl = &automatic_updates_settings_vtbl;
+    settings->refs = 1;
+    settings->level = aunlNotConfigured;
+    settings->day = ausidEveryDay;
+    settings->time = 3;
+    *ret = &settings->IAutomaticUpdatesSettings_iface;
+    return S_OK;
+}
+
 static HRESULT WINAPI automatic_updates_DetectNow( IAutomaticUpdates *iface )
 {
     TRACE( "%p\n", iface );
@@ -137,8 +315,9 @@ static HRESULT WINAPI automatic_updates_ShowSettingsDialog(
 static HRESULT WINAPI automatic_updates_EnableService(
     IAutomaticUpdates *This )
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    TRACE( "%p\n", This );
+    /* there is no update service to enable (see ServiceEnabled) */
+    return HRESULT_FROM_WIN32( ERROR_SERVICE_DOES_NOT_EXIST );
 }
 
 static HRESULT WINAPI automatic_updates_get_ServiceEnabled( IAutomaticUpdates *iface, VARIANT_BOOL *retval )
@@ -154,8 +333,9 @@ static HRESULT WINAPI automatic_updates_get_Settings(
     IAutomaticUpdates *This,
     IAutomaticUpdatesSettings **retval )
 {
-    FIXME("%p\n", retval);
-    return E_NOTIMPL;
+    TRACE( "%p, %p\n", This, retval );
+    if (!retval) return E_POINTER;
+    return AutomaticUpdatesSettings_create( retval );
 }
 
 static const struct IAutomaticUpdatesVtbl automatic_updates_vtbl =
