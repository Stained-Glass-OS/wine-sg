From: Stained Glass OS <ke7oxh@gmail.com>
Subject: msxml3: an element's xml declares the namespaces it uses that are declared above it

A direct OfficeSetup.exe install reached "You're all set!", but no Word,
Excel or PowerPoint shortcut was made in ProgramData's Start Menu\Programs,
so nothing showed up in Start. Click-to-Run builds the machine's
AppXManifest.xml by merging each product's package manifest into the common
one: it takes the product's <appv:Extensions> element by its xml, loads that
into a document of its own and selects appv:Extension there. The xmlns:appv
declaration is on the manifest's <Package> root, and our xml left it out, so
the fragment loaded with appv as an undeclared prefix ("Namespace prefix appv
is not defined"), no appv:Extension was found, and the merged manifest had
only the common manifest's extensions: none of the products' shortcuts, COM
classes, file types or capabilities.

Windows' MSXML writes the declarations a node needs to stand on its own: an
element's xml declares, on that element, every namespace it or anything
inside it uses that is declared above it (the default namespace included).
The declarations are added only while the element is written; the document
is not changed. The document's and other nodes' xml are unchanged.

Gate: test-xmlscopens (the extensions of a Click-to-Run-shaped manifest,
reloaded on their own, have their extensions and shortcut; the default
namespace; no declaration twice; the document unchanged). Mutant
SG_MUTANT_XML_NO_SCOPE_NS. Wine's msxml3 domdoc, saxreader, schema and
xmldoc tests pass unchanged.

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 249054a..cbf2041 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -953,10 +953,120 @@ BSTR EnsureCorrectEOL(BSTR sInput)
  * reproduce behaviour exactly.
  *
  */
+/* Stained Glass OS: is this namespace declared on the element or inside it? */
+static BOOL ns_declared_within(xmlNodePtr top, xmlNsPtr ns)
+{
+    xmlNodePtr cur = top;
+
+    while (cur)
+    {
+        xmlNsPtr def;
+
+        if (cur->type == XML_ELEMENT_NODE)
+            for (def = cur->nsDef; def; def = def->next)
+                if (def == ns) return TRUE;
+
+        if (cur->type == XML_ELEMENT_NODE && cur->children)
+        {
+            cur = cur->children;
+            continue;
+        }
+        while (cur != top && !cur->next) cur = cur->parent;
+        if (cur == top) break;
+        cur = cur->next;
+    }
+    return FALSE;
+}
+
+struct scope_ns
+{
+    xmlNsPtr added;      /* the declarations to write on the element */
+    xmlNsPtr seen[16];   /* namespaces already looked at */
+    unsigned int count;
+};
+
+static void ns_add_needed(xmlNodePtr top, struct scope_ns *scope, xmlNsPtr ns)
+{
+    xmlNsPtr def;
+    unsigned int i;
+
+    if (!ns || !ns->href) return;
+    if (ns->prefix && !xmlStrcmp(ns->prefix, (const xmlChar *)"xml")) return;
+    for (i = 0; i < scope->count; i++)
+        if (scope->seen[i] == ns) return;
+    if (scope->count < ARRAY_SIZE(scope->seen)) scope->seen[scope->count++] = ns;
+
+    /* one declaration per prefix: the nearest one is the one in scope */
+    for (def = scope->added; def; def = def->next)
+        if (xmlStrEqual(def->prefix, ns->prefix)) return;
+    if (ns_declared_within(top, ns)) return;
+
+    if (!(def = xmlMalloc(sizeof(*def)))) return;
+    memset(def, 0, sizeof(*def));
+    def->type = XML_NAMESPACE_DECL;
+    def->href = xmlStrdup(ns->href);
+    def->prefix = ns->prefix ? xmlStrdup(ns->prefix) : NULL;
+    def->next = scope->added;
+    scope->added = def;
+}
+
+/* Stained Glass OS: an element's xml declares the namespaces it uses that are
+ * declared above it, as msxml's does, so that it stands on its own: Office's
+ * Click-to-Run took each product's <appv:Extensions> by its xml, loaded that
+ * into a document of its own and found no appv:Extension in it, so the merged
+ * manifest had none of the products' shortcuts, and no Word, Excel or
+ * PowerPoint appeared in Start. */
+static xmlNsPtr node_scope_namespaces(xmlNodePtr top)
+{
+    struct scope_ns scope;
+    xmlNodePtr cur = top;
+
+#ifdef SG_MUTANT_XML_NO_SCOPE_NS
+    return NULL;
+#endif
+    if (top->type != XML_ELEMENT_NODE || !top->parent || top->parent->type != XML_ELEMENT_NODE)
+        return NULL;
+
+    memset(&scope, 0, sizeof(scope));
+    while (cur)
+    {
+        if (cur->type == XML_ELEMENT_NODE)
+        {
+            xmlAttrPtr attr;
+
+            ns_add_needed(top, &scope, cur->ns);
+            for (attr = cur->properties; attr; attr = attr->next)
+                ns_add_needed(top, &scope, attr->ns);
+            if (cur->children)
+            {
+                cur = cur->children;
+                continue;
+            }
+        }
+        while (cur != top && !cur->next) cur = cur->parent;
+        if (cur == top) break;
+        cur = cur->next;
+    }
+    return scope.added;
+}
+
+static void free_scope_namespaces(xmlNsPtr ns)
+{
+    while (ns)
+    {
+        xmlNsPtr next = ns->next;
+        xmlFree((xmlChar *)ns->href);
+        xmlFree((xmlChar *)ns->prefix);
+        xmlFree(ns);
+        ns = next;
+    }
+}
+
