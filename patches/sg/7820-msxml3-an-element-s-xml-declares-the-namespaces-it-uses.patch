     xmlBufferPtr xml_buf;
     xmlNodePtr xmldecl;
+    xmlNsPtr scope_ns, last = NULL, saved_def;
     int size;
 
     if(!ret)
@@ -970,7 +1080,23 @@ HRESULT node_get_xml(xmlnode *This, BOOL ensure_eol, BSTR *ret)
 
     xmldecl = xmldoc_unlink_xmldecl( This->node->doc );
 
+    /* the declarations are put on the element only while it is written out */
+    saved_def = This->node->type == XML_ELEMENT_NODE ? This->node->nsDef : NULL;
+    if ((scope_ns = node_scope_namespaces(This->node)))
+    {
+        for (last = scope_ns; last->next; last = last->next) ;
+        last->next = This->node->nsDef;
+        This->node->nsDef = scope_ns;
+    }
