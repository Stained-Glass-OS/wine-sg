From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winex11, win32u: a move a framed Linux program asks for ends at the release, whoever gets it

David (2026-11-15): Steam, dragged by its own title bar, "got stuck in drag
mode": the window followed the pointer, switching desktops brought him
back to it, and after Alt+F4 (which only hid Steam) the Start button took
no clicks until Steam was quit. A move a framed program asks for
(_NET_WM_MOVERESIZE) is Wine's move loop, which ends at a release Wine
sees. When the program kept its press's grab, the frame's grab failed and
the release went to the program; Wine had never seen the press either, so
the loop took itself for a keyboard move and followed the pointer until a
click Wine would get.

As on Windows the loop now ends at the release whoever gets it, when the
window loses the capture, and when the window is hidden or destroyed:
- sg_embed.c: a thread watches the X buttons from the moment the move is
  asked; when they are up it tells the frame's thread (a property on the
  program's window), which ends the loop with a WM_LBUTTONUP. The program's
  window hidden or destroyed mid-move ends it with WM_CANCELMODE.
- win32u's move/size loop ends when the window has lost the capture or is
  no longer a visible window.
---
diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index c426cb1..4442674 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -902,6 +902,14 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
         if (!NtUserGetMessage( &msg, 0, 0, 0 )) break;
         if (NtUserCallMsgFilter( &msg, MSGF_SIZE )) continue;
 
+#ifndef SG_MUTANT_MOVESIZE_KEEPS_GOING
+        /* Stained Glass OS: the loop ends when the window loses the capture, as
+         * on Windows -- released (WM_CANCELMODE), taken by another window, or
+         * the window destroyed or hidden (wine-sg 7790) */
+        if (get_capture() != hwnd || !is_window( hwnd ) ||
+            !(get_window_long( hwnd, GWL_STYLE ) & WS_VISIBLE)) break;
+#endif
+
         /* Exit on button-up, Return, or Esc -- or, following the pointer
          * without a button, on a click */
         if (!mouse_drag && (msg.message == WM_LBUTTONDOWN || msg.message == WM_RBUTTONDOWN))
diff --git a/dlls/winex11.drv/sg_embed.c b/dlls/winex11.drv/sg_embed.c
index 6424fed..386bf97 100644
--- a/dlls/winex11.drv/sg_embed.c
+++ b/dlls/winex11.drv/sg_embed.c
@@ -107,6 +107,14 @@ static Atom moveresize_atom( Display *display )
     return atom;
 }
 
+/* the buttons are up again, from a move's release watch to the frame's thread */
+static Atom released_atom( Display *display )
+{
+    static Atom atom;
+    if (!atom) atom = XInternAtom( display, "_SG_EMBED_RELEASED", False );
+    return atom;
+}
+
 /* the program asked to be minimized (WM_CHANGE_STATE), from the state
  * thread to the frame's */
 static Atom minimize_atom( Display *display )
@@ -179,6 +187,9 @@ static Window get_window_prop( Display *d, Window w, Atom prop_atom )
     return ret;
 }
 
+static void stop_release_watch(void);
+static BOOL in_move_loop( HWND hwnd );
+
 static struct sg_embed embeds[MAX_EMBEDS];
 static int embed_count;
 static pthread_mutex_t embed_mutex = PTHREAD_MUTEX_INITIALIZER;
@@ -1217,6 +1228,10 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
          * title bar and menus too, the keyboard fine -- until Alt+F4 closed it
          * (David 2026-10-05). It is let go here. */
         struct x11drv_thread_data *thread_data = x11drv_thread_data();
+        /* (handled inside the loop, as its messages are: the watch goes on
+         * until the buttons are up) */
+        if (in_move_loop( hwnd )) return 0;
+        stop_release_watch();
         if (thread_data && thread_data->display && !thread_data->grab_hwnd)
         {
             TRACE( "%p: no move/size loop took the pointer: let go\n", hwnd );
@@ -1426,6 +1441,100 @@ LRESULT sg_embed_message( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
  * An event on a program's window we framed (call_event_handler): handled
  * here, never as an event of a Wine window.
  */
+/* A move or size the program asked for (_NET_WM_MOVERESIZE) is Wine's move
+ * loop, which ends at the button's release -- the release Wine sees. The
+ * program may still hold the pointer (its press's grab, kept: the frame's grab
+ * failed), or let the button go before the frame took the pointer: the release
+ * went to the program, and the loop went on for ever -- the window following
+ * the pointer, clicks on the program its own, the desktop switched back to it
+ * (David 2026-11-15, Steam). As on Windows the loop ends at the release
+ * whoever gets it: a thread of its own watches the buttons and tells the
+ * frame's thread (a property on the program's window) when they are up; the
+ * frame's thread then ends its loop (wine-sg 7790). */
+struct release_watch
+{
+    char  display_name[256];
+    Window child;
+    volatile LONG stop;
+};
+
+static struct release_watch *current_watch;
+static pthread_mutex_t watch_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void *release_watch_thread( void *arg )
+{
+    struct release_watch *w = arg;
+    Display *d = XOpenDisplay( w->display_name );
+    Window root_ret, child_ret;
+    int rx, ry, wx, wy, i;
+    unsigned int mask;
+
+    for (i = 0; d && !w->stop && i < 30000; i++)   /* 10 minutes at most */
+    {
+        usleep( 20000 );
+        if (!XQueryPointer( d, DefaultRootWindow( d ), &root_ret, &child_ret, &rx, &ry, &wx, &wy, &mask )) break;
+        if (mask & (Button1Mask | Button2Mask | Button3Mask)) continue;
+        if (!w->stop)
+        {
+            long one = 1;
+            X11DRV_expect_error( d, ignore_error, NULL );
+            XChangeProperty( d, w->child, released_atom( d ), XA_CARDINAL, 32, PropModeReplace,
+                             (unsigned char *)&one, 1 );
+            X11DRV_check_error();
+        }
+        break;
+    }
+    if (d) XCloseDisplay( d );
+    pthread_mutex_lock( &watch_mutex );
+    if (current_watch == w) current_watch = NULL;
+    pthread_mutex_unlock( &watch_mutex );
+    free( w );
+    return NULL;
+}
+
+static void stop_release_watch(void)
+{
+    pthread_mutex_lock( &watch_mutex );
+    if (current_watch) current_watch->stop = 1;
+    current_watch = NULL;
+    pthread_mutex_unlock( &watch_mutex );
+}
+
+static void start_release_watch( Display *display, Window child )
+{
+#ifndef SG_MUTANT_MOVESIZE_NO_RELEASE_WATCH
+    struct release_watch *w;
+    pthread_attr_t attr;
+    pthread_t t;
+
+    stop_release_watch();
+    if (!(w = calloc( 1, sizeof(*w) ))) return;
+    snprintf( w->display_name, sizeof(w->display_name), "%s", DisplayString( display ) );
+    w->child = child;
+    pthread_attr_init( &attr );
+    pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+    pthread_mutex_lock( &watch_mutex );
+    current_watch = w;
+    pthread_mutex_unlock( &watch_mutex );
+    if (pthread_create( &t, &attr, release_watch_thread, w ))
+    {
+        pthread_mutex_lock( &watch_mutex );
+        current_watch = NULL;
+        pthread_mutex_unlock( &watch_mutex );
+        free( w );
+    }
+    pthread_attr_destroy( &attr );
+#endif
+}
+
+/* this thread is in a move or size loop for HWND */
+static BOOL in_move_loop( HWND hwnd )
+{
+    GUITHREADINFO info = { sizeof(info) };
+    return NtUserGetGUIThreadInfo( GetCurrentThreadId(), &info ) && (info.flags & GUI_INMOVESIZE) &&
+           info.hwndCapture == hwnd;
+}
+
 BOOL sg_embed_event( Display *display, XEvent *event )
 {
     struct sg_embed *e;
@@ -1537,6 +1646,19 @@ BOOL sg_embed_event( Display *display, XEvent *event )
             }
             pthread_mutex_unlock( &embed_mutex );
         }
+        else if (event->xproperty.atom == released_atom( display ) && event->xproperty.state == PropertyNewValue)
+        {
+            X11DRV_expect_error( display, ignore_error, NULL );
+            XDeleteProperty( display, event->xany.window, released_atom( display ) );
+            sync_check_error( display );
+            /* the buttons are up: the move loop ends there, as at a release
+             * Wine sees (one it saw ended it already) */
+            if (in_move_loop( hwnd ))
+            {
+                TRACE( "%p: buttons up, the move/size loop ends\n", hwnd );
+                NtUserPostMessage( hwnd, WM_LBUTTONUP, 0, 0 );
+            }
+        }
         else if (event->xproperty.atom == moveresize_atom( display ) && event->xproperty.state == PropertyNewValue)
         {
             /* _NET_WM_MOVERESIZE's directions: top-left, top, top-right,
@@ -1604,6 +1726,7 @@ BOOL sg_embed_event( Display *display, XEvent *event )
 #endif
                     if (dir == 8) NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_MOVE | HTCAPTION, 0 );
                     else NtUserPostMessage( hwnd, WM_SYSCOMMAND, SC_SIZE | size_edge[dir], 0 );
+                    start_release_watch( display, event->xany.window );
 #ifndef SG_MUTANT_EMBED_MOVESIZE_GRAB_LEAK
                     /* and after it, our grab let go should Wine's loop not
                      * have taken it over (sg_embed_message) */
@@ -1615,7 +1738,13 @@ BOOL sg_embed_event( Display *display, XEvent *event )
         }
         break;
     case UnmapNotify:
-        if (event->xunmap.window == event->xunmap.event) NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 0, 0 );
+        if (event->xunmap.window == event->xunmap.event)
+        {
+            /* hidden (Steam's Alt+F4) or gone mid-move: the loop ends, as a
+             * window's does when it is hidden (wine-sg 7790) */
+            if (in_move_loop( hwnd )) NtUserPostMessage( hwnd, WM_CANCELMODE, 0, 0 );
+            NtUserPostMessage( hwnd, WM_SG_EMBED_SHOWN, 0, 0 );
+        }
         break;
 #ifndef SG_MUTANT_EMBED_NO_FOCUSED_STATE
     case FocusIn:
@@ -1649,7 +1778,11 @@ BOOL sg_embed_event( Display *display, XEvent *event )
         }
         break;
     case DestroyNotify:
-        if (event->xdestroywindow.window == event->xdestroywindow.event) NtUserPostMessage( hwnd, WM_SG_EMBED_GONE, 0, 0 );
+        if (event->xdestroywindow.window == event->xdestroywindow.event)
+        {
+            if (in_move_loop( hwnd )) NtUserPostMessage( hwnd, WM_CANCELMODE, 0, 0 );  /* wine-sg 7790 */
+            NtUserPostMessage( hwnd, WM_SG_EMBED_GONE, 0, 0 );
+        }
         break;
     }
     return TRUE;
