diff --git a/dlls/windows.ui.xaml/private.h b/dlls/windows.ui.xaml/private.h
index 32e77aa..1356961 100644
--- a/dlls/windows.ui.xaml/private.h
+++ b/dlls/windows.ui.xaml/private.h
@@ -349,6 +349,10 @@ enum xaml_routed { XROUTED_KEY_DOWN, XROUTED_KEY_UP, XROUTED_GOT_FOCUS, XROUTED_
 struct handler_list *xaml_routed_list( struct uielem *elem, enum xaml_routed which );
