From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windows.ui.xaml: buttons take the keyboard focus; Tab, Space and Enter

Buttons now take the keyboard focus like text boxes do, when enabled and tab stops (IsEnabled, IsTabStop). Tab and Shift+Tab move the focus through the island's focus targets in TabIndex order, then tree order, wrapping round; Space presses the focused button and clicks it when released, Enter clicks it. The keyboard focus is drawn as a rectangle in the text colour, a pointer focus is not. Control.FocusState now tells Pointer, Keyboard or Programmatic apart. Behind the XAML switch of 6131.
---
diff --git a/dlls/windows.ui.xaml/control.c b/dlls/windows.ui.xaml/control.c
index bc41046..bf58b31 100644
--- a/dlls/windows.ui.xaml/control.c
+++ b/dlls/windows.ui.xaml/control.c
@@ -421,7 +421,7 @@ static HRESULT WINAPI control_get_FocusState( struct xiface *iface, INT32 *value
     struct control *control = control_from_iface( iface );
 
     if (!value) return E_POINTER;
-    *value = xaml_focused() == &control->e ? 3 : 0;   /* Programmatic, Unfocused */
+    *value = xaml_focus_state( &control->e );   /* Unfocused, Pointer, Keyboard, Programmatic */
     return S_OK;
 }
 
@@ -432,7 +432,7 @@ static HRESULT WINAPI control_ApplyTemplate( struct xiface *iface, boolean *appl
     return S_OK;
 }
 
-/* Focus: the controls that take the keyboard (text boxes) take the focus */
+/* Focus: the controls that take the keyboard (text boxes, buttons) take the focus */
 static HRESULT WINAPI control_Focus( struct xiface *iface, INT32 state, boolean *focused )
 {
     struct control *control = control_from_iface( iface );
@@ -441,7 +441,7 @@ static HRESULT WINAPI control_Focus( struct xiface *iface, INT32 state, boolean
     if (!focused) return E_POINTER;
     if (!state) return E_INVALIDARG;   /* Unfocused */
     *focused = xaml_is_focus_target( &control->e );
-    if (*focused) xaml_focus_element( &control->e, NULL );
+    if (*focused) xaml_focus_element_state( &control->e, NULL, state );
     return S_OK;
 }
 
diff --git a/dlls/windows.ui.xaml/focus.c b/dlls/windows.ui.xaml/focus.c
index 345fee4..8a9272a 100644
--- a/dlls/windows.ui.xaml/focus.c
+++ b/dlls/windows.ui.xaml/focus.c
@@ -27,6 +27,7 @@
 
 #include <stdlib.h>
 #include "private.h"
+#include <limits.h>
 #include "winuser.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(xaml);
@@ -37,6 +38,8 @@ static const GUID IID_IKeyRoutedEventArgs2 = { 0x1b02d57a, 0x9634, 0x4f14, { 0x9
 
 static struct uielem *focus;        /* a reference on its object */
 static HWND focus_hwnd;
+static INT32 focus_state;           /* FocusState: Pointer 1, Keyboard 2, Programmatic 3 */
+static struct uielem *pressed_key;  /* a button held down by Space (a reference) */
 
 /* ---- KeyRoutedEventArgs ---- */
 
@@ -216,9 +219,32 @@ static void raise_focus_event( struct uielem *elem, enum xaml_routed which )
 
 /* ---- focus ---- */
 
+static BOOL control_flag( struct uielem *elem, const WCHAR *name, BOOL def )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.Control", name );
+    IInspectable *box = NULL;
+    BOOL ret;
+
+    if (!prop) return def;
+    dobj_get_value( &elem->d, prop, &box );
+    ret = xunbox_boolean( box, def );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+/* what takes the keyboard: text boxes and buttons, enabled tab stops */
 BOOL xaml_is_focus_target( struct uielem *elem )
 {
-    return xaml_is_text_box( elem );
+    if (!elem || (!xaml_is_text_box( elem ) && !xaml_is_button( elem ))) return FALSE;
+#ifdef SG_MUTANT_XAML_NO_BUTTON_FOCUS
+    if (!xaml_is_text_box( elem )) return FALSE;
+#endif
+    return control_flag( elem, L"IsEnabled", TRUE ) && control_flag( elem, L"IsTabStop", TRUE );
+}
+
+INT32 xaml_focus_state( struct uielem *elem )
+{
+    return elem && elem == focus ? focus_state : 0;
 }
 
 struct uielem *xaml_focused(void)
@@ -228,10 +254,17 @@ struct uielem *xaml_focused(void)
 
 /* the focus moved to an element (NULL: nowhere); its island has the keyboard */
 void xaml_focus_element( struct uielem *elem, HWND hwnd )
+{
+    xaml_focus_element_state( elem, hwnd, hwnd ? 1 : 3 );
+}
+
+void xaml_focus_element_state( struct uielem *elem, HWND hwnd, INT32 state )
 {
     struct uielem *old = focus;
 
     if (hwnd) focus_hwnd = hwnd;
+    if (state != focus_state) xaml_invalidate_visuals();
+    focus_state = state;
     if (elem == old) return;
     TRACE( "%p -> %p\n", old, elem );
 #ifdef SG_MUTANT_XAML_NO_FOCUS
@@ -263,6 +296,63 @@ static BOOL in_content( struct uielem *elem, IInspectable *content )
     return elem && elem == root;
 }
 
+/* the focus targets of a tree in tab order: TabIndex, then tree order */
+struct tab_list { struct uielem **items; INT32 *index; unsigned int count, size; };
+
+static INT32 tab_index( struct uielem *elem )
+{
+    struct xaml_property *prop = xaml_property_find( L"Windows.UI.Xaml.Controls.Control", L"TabIndex" );
+    IInspectable *box = NULL;
+    INT32 ret;
+
+    if (!prop) return INT_MAX;
+    dobj_get_value( &elem->d, prop, &box );
+    ret = xunbox_enum( box, NULL, INT_MAX );
+    if (box) IInspectable_Release( box );
+    return ret;
+}
+
+static void collect_tab( struct uielem *elem, struct tab_list *list )
+{
+    struct uielem *child;
+
+    if (elem->visibility == XCOLLAPSED || !elem->arrange_valid) return;
+    if (xaml_is_focus_target( elem ) && list->count < list->size)
+    {
+        unsigned int i = list->count++;
+        INT32 index = tab_index( elem );
+        /* stable insertion by TabIndex */
+        while (i > 0 && list->index[i - 1] > index)
+        {
+            list->items[i] = list->items[i - 1];
+            list->index[i] = list->index[i - 1];
+            i--;
+        }
+        list->items[i] = elem;
+        list->index[i] = index;
+    }
+    LIST_FOR_EACH_ENTRY( child, &elem->children, struct uielem, entry ) collect_tab( child, list );
+}
+
+/* Tab and Shift+Tab: the next or previous focus target of the island, round */
+static BOOL move_focus( HWND hwnd, IInspectable *content, BOOL back )
+{
+    struct uielem *root = uielem_from_inspectable( content ), *items[512];
+    INT32 index[512];
+    struct tab_list list = { items, index, 0, ARRAY_SIZE(items) };
+    unsigned int i, next;
+
+    if (!root) return FALSE;
+    collect_tab( root, &list );
+    if (!list.count) return FALSE;
+    for (i = 0; i < list.count; i++) if (items[i] == focus) break;
+    if (i == list.count) next = back ? list.count - 1 : 0;
+    else next = back ? (i + list.count - 1) % list.count : (i + 1) % list.count;
+    TRACE( "tab %s to %p\n", back ? "back" : "forward", items[next] );
+    xaml_focus_element_state( items[next], hwnd, 2 );
+    return TRUE;
+}
+
 BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspectable *content )
 {
     struct uielem *target = focus && in_content( focus, content ) ? focus : uielem_from_inspectable( content );
@@ -286,8 +376,37 @@ BOOL xaml_key_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, IInspe
                     (IInspectable *)&args->IKeyRoutedEventArgs_iface, &args->handled );
 #endif
         raise_up( target, up ? XROUTED_KEY_UP : XROUTED_KEY_DOWN, (IInspectable *)&args->IKeyRoutedEventArgs_iface, &args->handled );
-        if (!args->handled && !up && target == focus && xaml_is_text_box( target ))
+        if (!args->handled && !up && target == focus && xaml_is_text_box( target ) && wparam != VK_TAB)
             args->handled = xaml_text_box_key( target, wparam );
+        if (!args->handled && target == focus && xaml_is_button( target ))
+        {
+            /* Space presses a focused button and clicks it when released; Enter clicks it */
+            if (wparam == VK_SPACE && !up)
+            {
+                if (!pressed_key)
+                {
+                    pressed_key = target;
+                    IUnknown_AddRef( target->d.obj.outer );
+                }
+                xaml_button_state( target, TRUE, TRUE );
+                args->handled = TRUE;
+            }
+            else if (wparam == VK_SPACE && up && pressed_key == target)
+            {
+                IUnknown_Release( pressed_key->d.obj.outer );
+                pressed_key = NULL;
+                xaml_button_state( target, FALSE, FALSE );
+                xaml_button_click( target );
+                args->handled = TRUE;
+            }
+            else if (wparam == VK_RETURN && !up)
+            {
+                xaml_button_click( target );
+                args->handled = TRUE;
+            }
+        }
+        if (!args->handled && !up && wparam == VK_TAB)
+            args->handled = move_focus( hwnd, content, GetKeyState( VK_SHIFT ) < 0 );
         TRACE( "%p: key %#Ix %s, handled %d\n", target, wparam, up ? "up" : "down", args->handled );
         IUnknown_Release( args->obj.outer );
         return msg == WM_KEYDOWN || msg == WM_KEYUP;
