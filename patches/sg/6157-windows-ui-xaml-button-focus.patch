diff --git a/dlls/windows.ui.xaml/render.c b/dlls/windows.ui.xaml/render.c
index 51b40d5..c62d542 100644
--- a/dlls/windows.ui.xaml/render.c
+++ b/dlls/windows.ui.xaml/render.c
@@ -209,6 +209,32 @@ static void render_element( struct uielem *elem, ID2D1RenderTarget *target, FLOA
     if (elem->ops && elem->ops->render_over) elem->ops->render_over( elem, &draw );
 }
 
+/* the keyboard focus shown on its element (focused from the keyboard): a dotted rectangle in the text colour */
+static void render_focus( struct uielem *root, ID2D1RenderTarget *target )
+{
+    struct uielem *elem = xaml_focused(), *e;
+    struct xdraw draw = { target, 0, 0 };
+    struct xthickness one = { 1, 1, 1, 1 };
+    struct xrect rect;
+    FLOAT x = 0, y = 0;
+
+    if (!elem || xaml_focus_state( elem ) != 2 || xaml_is_text_box( elem )) return;
+    for (e = elem; e && e != root; e = e->parent)
+    {
+        x += e->offset.x;
+        y += e->offset.y;
+    }
+    if (e != root) return;
+    x += root->offset.x;
+    y += root->offset.y;
+    rect.x = x + 1;
+    rect.y = y + 1;
+    rect.width = elem->render.width - 2;
+    rect.height = elem->render.height - 2;
+    if (rect.width <= 0 || rect.height <= 0) return;
+    xdraw_border( &draw, &rect, &one, xaml_theme_color( XTHEME_TEXT ), NULL );
+}
+
 /* a host window's paint: its content laid out to its size and drawn on its DC */
 void xaml_render_window( HWND hwnd, HDC hdc, IInspectable *content )
 {
@@ -254,6 +280,7 @@ void xaml_render_window( HWND hwnd, HDC hdc, IInspectable *content )
         background = d2d_color( xaml_theme_color( XTHEME_BACKGROUND ) );
         ID2D1DCRenderTarget_Clear( target, &background );
         if (root) render_element( root, (ID2D1RenderTarget *)target, 0, 0 );
+        if (root) render_focus( root, (ID2D1RenderTarget *)target );
         if (FAILED(hr = ID2D1DCRenderTarget_EndDraw( target, NULL, NULL ))) WARN( "EndDraw hr %#lx\n", hr );
     }
     ID2D1DCRenderTarget_Release( target );
