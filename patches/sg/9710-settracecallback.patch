From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] sechost, advapi32: SetTraceCallback, RemoveTraceCallback

CrystalDiskMark imports SetTraceCallback statically and did not load. ProcessTrace calls the callback
set for an event class (its provider GUID) for each event of that class, besides the log file's own
EventCallback. Gate: test/tracecb-gate.sh. Mutant: SG_MUTANT_NO_CLASS_CALLBACK.
---
--- a/dlls/sechost/trace.c
+++ b/dlls/sechost/trace.c
@@ -1001,6 +1001,84 @@
     return ret;
 }
 
+/* Stained Glass OS (wine-sg 9710): SetTraceCallback / RemoveTraceCallback -- a callback per event class
+ * (the provider's GUID in the classic EVENT_TRACE view) that ProcessTrace calls for each event of that class,
+ * besides the log file's EventCallback (CrystalDiskMark imports them). */
+struct class_callback
+{
+    GUID guid;
+    PEVENT_CALLBACK callback;
+};
+static struct class_callback *class_callbacks;
+static unsigned int class_callback_count;
+static SRWLOCK class_callbacks_lock = SRWLOCK_INIT;
+
+static PEVENT_CALLBACK find_class_callback( const GUID *guid )
+{
+    PEVENT_CALLBACK ret = NULL;
+    unsigned int i;
+
+    AcquireSRWLockShared( &class_callbacks_lock );
+    for (i = 0; i < class_callback_count; i++)
+        if (IsEqualGUID( &class_callbacks[i].guid, guid )) ret = class_callbacks[i].callback;
+    ReleaseSRWLockShared( &class_callbacks_lock );
+#ifdef SG_MUTANT_NO_CLASS_CALLBACK
+    ret = NULL;
+#endif
+    return ret;
+}
+
+/******************************************************************************
+ *     SetTraceCallback   (sechost.@)
+ */
+ULONG WINAPI SetTraceCallback( const GUID *guid, PEVENT_CALLBACK callback )
+{
+    struct class_callback *list;
+    ULONG ret = ERROR_SUCCESS;
+    unsigned int i;
+
+    TRACE( "%s %p\n", debugstr_guid(guid), callback );
+
+    if (!guid || !callback) return ERROR_INVALID_PARAMETER;
+    AcquireSRWLockExclusive( &class_callbacks_lock );
+    for (i = 0; i < class_callback_count; i++)
+        if (IsEqualGUID( &class_callbacks[i].guid, guid )) break;
+    if (i < class_callback_count) class_callbacks[i].callback = callback;
+    else if ((list = realloc( class_callbacks, (class_callback_count + 1) * sizeof(*list) )))
+    {
+        class_callbacks = list;
+        class_callbacks[class_callback_count].guid = *guid;
+        class_callbacks[class_callback_count++].callback = callback;
+    }
+    else ret = ERROR_NOT_ENOUGH_MEMORY;
+    ReleaseSRWLockExclusive( &class_callbacks_lock );
+    return ret;
+}
+
+/******************************************************************************
+ *     RemoveTraceCallback   (sechost.@)
+ */
+ULONG WINAPI RemoveTraceCallback( const GUID *guid )
+{
+    ULONG ret = ERROR_WMI_GUID_NOT_FOUND;
+    unsigned int i;
+
+    TRACE( "%s\n", debugstr_guid(guid) );
+
+    if (!guid) return ERROR_INVALID_PARAMETER;
+    AcquireSRWLockExclusive( &class_callbacks_lock );
+    for (i = 0; i < class_callback_count; i++)
+    {
+        if (!IsEqualGUID( &class_callbacks[i].guid, guid )) continue;
+        memmove( &class_callbacks[i], &class_callbacks[i + 1], (class_callback_count - i - 1) * sizeof(*class_callbacks) );
+        class_callback_count--;
+        ret = ERROR_SUCCESS;
+        break;
+    }
+    ReleaseSRWLockExclusive( &class_callbacks_lock );
+    return ret;
+}
+
 /* one event to the consumer's callback */
 static void deliver( struct consumer *consumer, struct sg_etw_record *record )
 {
@@ -1033,10 +1111,11 @@
         }
         logfile->EventRecordCallback( &event );
     }
-    else if (logfile->EventCallback)
+    else
     {
         /* the classic view of it */
         EVENT_TRACE *trace = &logfile->CurrentEvent;
+        PEVENT_CALLBACK class_callback;
 
         memset( trace, 0, sizeof(*trace) );
         trace->Header.Size = sizeof(EVENT_TRACE_HEADER) + record->user_data_length;
@@ -1050,7 +1129,9 @@
         trace->MofData = record->user_data_length ? (void *)(record + 1) : NULL;
         trace->MofLength = record->user_data_length;
         if (consumer->logfile_a) consumer->logfile_a->CurrentEvent = *trace;
-        logfile->EventCallback( trace );
+        if (logfile->EventCallback) logfile->EventCallback( trace );
+        /* and the callback SetTraceCallback gave for the event's class */
+        if ((class_callback = find_class_callback( &trace->Header.Guid ))) class_callback( trace );
     }
     logfile->CurrentTime = record->header.TimeStamp.QuadPart;
 }
