+/* Line and Column follow what was read or written */
+static void track_position(struct textstream *stream, const WCHAR *text, size_t len)
+{
+    size_t i;
+
+#ifdef SG_MUTANT_NO_POSITION
+    return;
+#endif
+    for (i = 0; i < len; i++)
+    {
+        if (text[i] == '\n')
+        {
+            stream->line++;
+            stream->column = 1;
+        }
+        else stream->column++;
+    }
+}
+
 static HRESULT read_more_data(struct textstream *stream)
 {
     char buf[256];
@@ -485,11 +556,22 @@ static HRESULT read_more_data(struct textstream *stream)
 
     if (!ReadFile(stream->file, buf, sizeof(buf), &read, NULL))
     {
-        ITextStream_Release(&stream->ITextStream_iface);
+        /* a pipe's writer is gone: its end */
+        if (stream->pipe && (GetLastError() == ERROR_BROKEN_PIPE || GetLastError() == ERROR_NO_DATA ||
+                             GetLastError() == ERROR_PIPE_NOT_CONNECTED))
+        {
+            stream->eof = TRUE;
+            return S_OK;
+        }
         return create_error(GetLastError());
     }
 
+    /* a pipe gives what there is: only nothing at all is its end */
+#ifndef SG_MUTANT_PIPE_EOF_EARLY
+    stream->eof = stream->pipe ? !read : read != sizeof(buf);
+#else
     stream->eof = read != sizeof(buf);
+#endif
     return append_read_data(stream, buf, read);
 }
 
