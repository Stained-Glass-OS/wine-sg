From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: ECB has no chaining vector to complain about

Every AES-ECB BCryptEncrypt and BCryptDecrypt logged "Unexpected vector len 0" (KeePass 2's AES-KDF: dozens per
database opened): the output was right, the FIXME was for a chaining vector ECB never has. It now fires only for
a key that has a vector.
---
diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index 1d4fe7d..2819428 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1867,7 +1867,13 @@ static NTSTATUS key_symmetric_encrypt( struct key *key,  UCHAR *input, ULONG inp
             memcpy( key->u.s.vector, output + *ret_len - key->u.s.vector_len, key->u.s.vector_len );
             if (iv) memcpy( iv, key->u.s.vector, min( iv_len, key->u.s.vector_len ));
         }
-        else FIXME( "Unexpected vector len %lu, *ret_len %lu.\n", key->u.s.vector_len, *ret_len );
+#ifndef SG_MUTANT_ECB_VECTOR_FIXME
+        /* ECB has no chaining vector: nothing to carry over */
+        else if (key->u.s.vector)
+#else
+        else
+#endif
+            FIXME( "Unexpected vector len %lu, *ret_len %lu.\n", key->u.s.vector_len, *ret_len );
     }
 
     return status;
@@ -2006,7 +2012,13 @@ static NTSTATUS key_symmetric_decrypt( struct key *key, UCHAR *input, ULONG inpu
             memcpy( key->u.s.vector, input + input_len - key->u.s.vector_len, key->u.s.vector_len );
             if (iv) memcpy( iv, key->u.s.vector, min( iv_len, key->u.s.vector_len ));
         }
-        else FIXME( "Unexpected vector len %lu, *ret_len %lu.\n", key->u.s.vector_len, *ret_len );
+#ifndef SG_MUTANT_ECB_VECTOR_FIXME
+        /* ECB has no chaining vector: nothing to carry over */
+        else if (key->u.s.vector)
+#else
+        else
+#endif
+            FIXME( "Unexpected vector len %lu, *ret_len %lu.\n", key->u.s.vector_len, *ret_len );
     }
 
     return status;
