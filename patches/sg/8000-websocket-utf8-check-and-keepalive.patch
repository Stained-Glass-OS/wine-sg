From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] websocket: text messages received are checked to be UTF-8; a quiet connection sends a keep-alive.

A text message that is not UTF-8 (overlong forms, surrogates, code points above U+10FFFF, a
message ending inside a sequence; a sequence may continue in the next fragment) fails the receive
with E_INVALID_PROTOCOL_FORMAT, the code WebSocketGetAction's documentation gives for bad protocol
data, and the handle is aborted (RFC 6455 8.1: the connection fails). Not with
WEB_SOCKET_DISABLE_UTF8_VERIFICATION_PROPERTY_TYPE; binary messages are not checked.
WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE (default 30 seconds, minimum 15 as documented, 0 for
none) was accepted and ignored: with nothing else to send, a handle quiet for its interval now
hands out an unsolicited pong, the heartbeat RFC 6455 5.5.3 allows.
---
diff --git a/dlls/websocket/websocket.c b/dlls/websocket/websocket.c
index 2656289..4a32ac3 100644
--- a/dlls/websocket/websocket.c
+++ b/dlls/websocket/websocket.c
@@ -26,6 +26,14 @@
  * key and the server's Sec-WebSocket-Accept, frames masked by the client,
  * messages split in fragments as large as the receive buffer, pings answered
  * with pongs.
+ *
+ * Text messages received are checked to be UTF-8 (RFC 6455 8.1) unless the
+ * handle was made with WEB_SOCKET_DISABLE_UTF8_VERIFICATION_PROPERTY_TYPE: a
+ * message that is not fails the receive with E_INVALID_PROTOCOL_FORMAT and the
+ * handle is aborted. With nothing else to send, a handle whose keep-alive
+ * interval (WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE, 30 seconds unless set,
+ * 15 at least, 0 for none) has passed since its last frame sends an unsolicited
+ * pong, the heartbeat RFC 6455 5.5.3 allows.
  */
 
 #include <stdarg.h>
@@ -46,6 +54,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(websocket);
 #define DEFAULT_BUFFER_SIZE 4096
 #define MIN_BUFFER_SIZE     256
 #define MAX_BUFFER_SIZE     65536
+#define DEFAULT_KEEPALIVE   30000
+#define MIN_KEEPALIVE       15000
 
 enum ws_state { STATE_CREATED, STATE_HANDSHAKE, STATE_OPEN, STATE_ABORTED };
 
@@ -95,6 +105,10 @@ struct websocket
     ULONG64 frame_remaining, frame_pos;
     BYTE message_opcode;      /* text or binary, of a fragmented message */
     BYTE control[125];        /* a control frame's payload, handed to the program */
+    BOOL utf8_check;          /* text messages received are checked */
+    BYTE utf8_need, utf8_lo, utf8_hi; /* the rest of the UTF-8 sequence a text message is in */
+    ULONG keepalive;          /* milliseconds, 0 for none */
+    ULONGLONG last_send;      /* when the last frame went to the network */
 };
 
 static struct websocket *ws_from_handle( WEB_SOCKET_HANDLE handle )
@@ -147,6 +161,8 @@ static HRESULT create_handle( BOOL server, const WEB_SOCKET_PROPERTY *props, ULO
     ws->server = server;
     ws->recv_size = ws->send_size = DEFAULT_BUFFER_SIZE;
     ws->masking = !server;
+    ws->utf8_check = TRUE;
+    ws->keepalive = DEFAULT_KEEPALIVE;
     for (i = 0; i < count; i++)
     {
         const WEB_SOCKET_PROPERTY *p = &props[i];
@@ -181,8 +197,12 @@ static HRESULT create_handle( BOOL server, const WEB_SOCKET_PROPERTY *props, ULO
             }
             break;
         case WEB_SOCKET_ALLOCATED_MASKING_PROPERTY_TYPE:
+            break;
         case WEB_SOCKET_DISABLE_UTF8_VERIFICATION_PROPERTY_TYPE:
+            if (v) ws->utf8_check = FALSE;
+            break;
         case WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE:
+            ws->keepalive = v && v < MIN_KEEPALIVE ? MIN_KEEPALIVE : v;
             break;
         default:
             free( ws );
@@ -361,6 +381,7 @@ HRESULT WINAPI WebSocketEndClientHandshake(WEB_SOCKET_HANDLE handle, const PWEB_
             *selected_subprotocol = find_header( response_headers, response_header_count, "Sec-WebSocket-Protocol" ) ? 0 : ~0u;
         free_headers( ws );
         ws->state = STATE_OPEN;
+        ws->last_send = GetTickCount64();
     }
     LeaveCriticalSection( &ws->cs );
     return hr;
@@ -425,6 +446,7 @@ HRESULT WINAPI WebSocketEndServerHandshake(WEB_SOCKET_HANDLE handle)
     {
         free_headers( ws );
         ws->state = STATE_OPEN;
+        ws->last_send = GetTickCount64();
     }
     LeaveCriticalSection( &ws->cs );
     return hr;
@@ -571,8 +593,49 @@ HRESULT WINAPI WebSocketReceive(WEB_SOCKET_HANDLE handle, WEB_SOCKET_BUFFER *buf
     return hr;
 }
 
-/* parse what came from the network: a receive indication, or FALSE (more is needed) */
-static BOOL next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WEB_SOCKET_BUFFER_TYPE *type )
+/* the next bytes of a text message: FALSE if they cannot be UTF-8 (overlong
+ * forms, surrogates and code points above U+10FFFF included); a sequence may
+ * continue in the next piece */
+static BOOL utf8_continue( struct websocket *ws, const BYTE *p, ULONG len )
+{
+    ULONG i;
+
+    for (i = 0; i < len; i++)
+    {
+        BYTE b = p[i];
+
+        if (ws->utf8_need)
+        {
+            if (b < ws->utf8_lo || b > ws->utf8_hi) return FALSE;
+            ws->utf8_need--;
+            ws->utf8_lo = 0x80;
+            ws->utf8_hi = 0xbf;
+            continue;
+        }
+        if (b < 0x80) continue;
+        ws->utf8_lo = 0x80;
+        ws->utf8_hi = 0xbf;
+        if (b >= 0xc2 && b <= 0xdf) ws->utf8_need = 1;
+        else if (b >= 0xe0 && b <= 0xef)
+        {
+            ws->utf8_need = 2;
+            if (b == 0xe0) ws->utf8_lo = 0xa0;
+            else if (b == 0xed) ws->utf8_hi = 0x9f;
+        }
+        else if (b >= 0xf0 && b <= 0xf4)
+        {
+            ws->utf8_need = 3;
+            if (b == 0xf0) ws->utf8_lo = 0x90;
+            else if (b == 0xf4) ws->utf8_hi = 0x8f;
+        }
+        else return FALSE;
+    }
+    return TRUE;
+}
+
+/* parse what came from the network: 1 for a receive indication, 0 when more is
+ * needed, -1 when it breaks the protocol */
+static int next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WEB_SOCKET_BUFFER_TYPE *type )
 {
     for (;;)
     {
@@ -583,12 +646,12 @@ static BOOL next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WE
             ULONG need = 2, len;
             BYTE *p = ws->rbuf;
 
-            if (ws->rlen < 2) return FALSE;
+            if (ws->rlen < 2) return 0;
             len = p[1] & 0x7f;
             if (len == 126) need += 2;
             else if (len == 127) need += 8;
             if (p[1] & 0x80) need += 4;
-            if (ws->rlen < need) return FALSE;
+            if (ws->rlen < need) return 0;
             ws->frame_fin = !!(p[0] & 0x80);
             ws->frame_opcode = p[0] & 0x0f;
             ws->frame_masked = !!(p[1] & 0x80);
@@ -607,7 +670,7 @@ static BOOL next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WE
         {
             /* a control frame, whole */
             ULONG len = ws->frame_remaining;
-            if (len > 125 || ws->rlen < len) return FALSE;
+            if (len > 125 || ws->rlen < len) return 0;
             for (i = 0; i < len; i++) ws->control[i] = ws->rbuf[i] ^ (ws->frame_masked ? ws->frame_mask[i % 4] : 0);
             memmove( ws->rbuf, ws->rbuf + len, ws->rlen - len );
             ws->rlen -= len;
@@ -629,7 +692,7 @@ static BOOL next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WE
                 buffer->Data.ulBufferLength = len;
                 *type = WEB_SOCKET_UNSOLICITED_PONG_BUFFER_TYPE;
                 ws->consume = 0;
-                return TRUE;
+                return 1;
             }
             if (ws->frame_opcode == 0x8)
             {
@@ -638,17 +701,27 @@ static BOOL next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WE
                 buffer->CloseStatus.ulReasonLength = len > 2 ? len - 2 : 0;
                 *type = WEB_SOCKET_CLOSE_BUFFER_TYPE;
                 ws->consume = 0;
-                return TRUE;
+                return 1;
             }
             continue; /* unknown control frames are skipped */
         }
 
         /* data: as much of the frame as there is, a fragment unless it ends the message */
         avail = ws->rlen < ws->frame_remaining ? ws->rlen : (ULONG)ws->frame_remaining;
-        if (!avail && ws->frame_remaining) return FALSE;
-        if (ws->frame_opcode != 0x0) ws->message_opcode = ws->frame_opcode;
+        if (!avail && ws->frame_remaining) return 0;
+        if (ws->frame_opcode != 0x0)
+        {
+            ws->message_opcode = ws->frame_opcode;
+            if (!ws->frame_pos) ws->utf8_need = 0;
+        }
         for (i = 0; i < avail; i++)
             if (ws->frame_masked) ws->rbuf[pos + i] ^= ws->frame_mask[(ws->frame_pos + i) % 4];
+#ifndef SG_MUTANT_WS_NO_UTF8_CHECK
+        if (ws->utf8_check && ws->message_opcode == 0x1 &&
+            (!utf8_continue( ws, ws->rbuf, avail ) ||
+             (ws->frame_fin && avail == ws->frame_remaining && ws->utf8_need)))
+            return -1;
+#endif
         buffer->Data.pbBuffer = ws->rbuf;
         buffer->Data.ulBufferLength = avail;
         if (ws->frame_fin && avail == ws->frame_remaining)
@@ -659,7 +732,7 @@ static BOOL next_indication( struct websocket *ws, WEB_SOCKET_BUFFER *buffer, WE
         ws->frame_remaining -= avail;
         ws->consume = avail;
         if (!ws->frame_remaining) ws->in_frame = FALSE;
-        return TRUE;
+        return 1;
     }
 }
 
@@ -689,6 +762,21 @@ HRESULT WINAPI WebSocketGetAction(WEB_SOCKET_HANDLE handle, WEB_SOCKET_ACTION_QU
         return E_INVALID_PROTOCOL_OPERATION;
     }
 
+#ifndef SG_MUTANT_WS_NO_KEEPALIVE
+    /* a quiet connection's heartbeat */
+    if ((queue & WEB_SOCKET_SEND_ACTION_QUEUE) && ws->state == STATE_OPEN && ws->keepalive &&
+        ws->send_pending == PENDING_NONE && list_empty( &ws->sends ) &&
+        GetTickCount64() - ws->last_send >= ws->keepalive)
+    {
+        struct send_item *pong = build_frame( ws, 0x8a, NULL, 0, FALSE, 0 );
+        if (pong)
+        {
+            pong->internal = TRUE;
+            list_add_tail( &ws->sends, &pong->entry );
+        }
+    }
+#endif
+
     if ((queue & WEB_SOCKET_SEND_ACTION_QUEUE) && ws->send_pending == PENDING_NONE && !list_empty( &ws->sends ))
     {
         struct send_item *item = LIST_ENTRY( list_head( &ws->sends ), struct send_item, entry );
@@ -725,8 +813,19 @@ HRESULT WINAPI WebSocketGetAction(WEB_SOCKET_HANDLE handle, WEB_SOCKET_ACTION_QU
     {
         struct recv_item *item = LIST_ENTRY( list_head( &ws->receives ), struct recv_item, entry );
 
+        int got = 0;
+
         if (*buffer_count < 1) hr = HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
-        else if (next_indication( ws, &buffers[0], buffer_type ))
+        else if ((got = next_indication( ws, &buffers[0], buffer_type )) < 0)
+        {
+            /* not UTF-8 in a text message: the connection fails (RFC 6455 8.1) */
+            WARN("a text message that is not UTF-8\n");
+            *buffer_count = 0;
+            *buffer_type = 0;
+            ws->state = STATE_ABORTED;
+            hr = E_INVALID_PROTOCOL_FORMAT;
+        }
+        else if (got)
         {
             *buffer_count = 1;
             *action = WEB_SOCKET_INDICATE_RECEIVE_COMPLETE_ACTION;
@@ -767,6 +866,7 @@ VOID WINAPI WebSocketCompleteAction(WEB_SOCKET_HANDLE handle, PVOID action_conte
     {
         struct send_item *item = ws->send_current;
 
+        if (ws->send_pending == PENDING_SEND_NET) ws->last_send = GetTickCount64();
         if (ws->send_pending == PENDING_SEND_NET && !item->internal) item->on_network = TRUE;
         else
         {
