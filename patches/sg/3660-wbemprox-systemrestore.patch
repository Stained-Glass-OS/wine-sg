@@ -0,0 +1,231 @@
+/*
+ * Stained Glass OS additions: Win32_SystemRestore methods.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+#include <stdio.h>
+#include "windows.h"
+#include "objidl.h"
+#include "wbemcli.h"
+#include "wine/test.h"
+
+static HRESULT call( IWbemServices *services, const WCHAR *method, const WCHAR *names[], VARIANT vals[], int n,
+                     IWbemClassObject **out )
+{
+    IWbemClassObject *cls, *sig = NULL, *in = NULL;
+    BSTR class = SysAllocString( L"SystemRestore" ), m = SysAllocString( method );
+    HRESULT hr;
+    int i;
+
+    hr = IWbemServices_GetObject( services, class, 0, NULL, &cls, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IWbemClassObject_GetMethod( cls, method, 0, &sig, NULL );
+    ok( hr == S_OK, "GetMethod %s: %#lx\n", wine_dbgstr_w( method ), hr );
+    if (sig)
+    {
+        hr = IWbemClassObject_SpawnInstance( sig, 0, &in );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        for (i = 0; i < n; i++)
+        {
+            hr = IWbemClassObject_Put( in, names[i], 0, &vals[i], 0 );
+            ok( hr == S_OK, "Put %s: %#lx\n", wine_dbgstr_w( names[i] ), hr );
+        }
+    }
+    *out = NULL;
+    hr = IWbemServices_ExecMethod( services, class, m, 0, NULL, in, out, NULL );
+    if (in) IWbemClassObject_Release( in );
+    if (sig) IWbemClassObject_Release( sig );
+    IWbemClassObject_Release( cls );
+    SysFreeString( class );
+    SysFreeString( m );
+    return hr;
+}
+
+static LONG ret_value( IWbemClassObject *out )
+{
+    VARIANT v;
+    CIMTYPE type = 0;
+    HRESULT hr;
+    LONG ret = -1;
+
+    VariantInit( &v );
+    hr = IWbemClassObject_Get( out, L"ReturnValue", 0, &v, &type, NULL );
+    ok( hr == S_OK, "ReturnValue: %#lx\n", hr );
+    ok( type == CIM_UINT32, "type %#lx\n", type );
+    if (hr == S_OK) ret = V_I4( &v );
+    return ret;
+}
+
+static void test_systemrestore( IWbemServices *services )
+{
+    IWbemClassObject *out;
+    const WCHAR *cnames[] = { L"Description", L"RestorePointType", L"EventType" };
+    VARIANT v[3];
+    HRESULT hr;
+    HKEY key;
+    LONG seq1, seq2;
+    DWORD size, val;
+
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, L"Software\\Wine\\SystemRestore" );
+
+    V_VT( &v[0] ) = VT_BSTR; V_BSTR( &v[0] ) = SysAllocString( L"sg test point" );
+    V_VT( &v[1] ) = VT_I4; V_I4( &v[1] ) = 0;
+    V_VT( &v[2] ) = VT_I4; V_I4( &v[2] ) = 100;
+    hr = call( services, L"CreateRestorePoint", cnames, v, 3, &out );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        ok( !ret_value( out ), "CreateRestorePoint failed\n" );
+        IWbemClassObject_Release( out );
+    }
+    hr = call( services, L"CreateRestorePoint", cnames, v, 3, &out );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK) IWbemClassObject_Release( out );
+
+    /* two points were recorded, numbered in sequence */
+    ok( !RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Wine\\SystemRestore", 0, KEY_READ, &key ), "no state key\n" );
+    size = sizeof(val);
+    val = 0;
+    ok( !RegQueryValueExW( key, L"NextSequenceNumber", NULL, NULL, (BYTE *)&val, &size ) && val == 3, "next %lu\n", val );
+    RegCloseKey( key );
+    ok( !RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Wine\\SystemRestore\\Points\\2", 0, KEY_READ, &key ),
+        "point 2 missing\n" );
+    RegCloseKey( key );
+
+    /* invalid parameters */
+    SysFreeString( V_BSTR( &v[0] ) );
+    V_BSTR( &v[0] ) = SysAllocString( L"" );
+    hr = call( services, L"CreateRestorePoint", cnames, v, 3, &out );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        ok( ret_value( out ) == ERROR_INVALID_PARAMETER, "empty description accepted\n" );
+        IWbemClassObject_Release( out );
+    }
+    SysFreeString( V_BSTR( &v[0] ) );
+    V_BSTR( &v[0] ) = SysAllocString( L"x" );
+    V_I4( &v[2] ) = 7;
+    hr = call( services, L"CreateRestorePoint", cnames, v, 3, &out );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        ok( ret_value( out ) == ERROR_INVALID_PARAMETER, "bad event type accepted\n" );
+        IWbemClassObject_Release( out );
+    }
+    SysFreeString( V_BSTR( &v[0] ) );
+
+    /* Enable / Disable record the drive state */
+    {
+        const WCHAR *dn[] = { L"Drive" };
+        VARIANT d;
+
+        V_VT( &d ) = VT_BSTR;
+        V_BSTR( &d ) = SysAllocString( L"C:\\" );
+        hr = call( services, L"Disable", dn, &d, 1, &out );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            ok( !ret_value( out ), "Disable failed\n" );
+            IWbemClassObject_Release( out );
+        }
+        ok( !RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Wine\\SystemRestore\\Drives", 0, KEY_READ, &key ), "no drives\n" );
+        size = sizeof(val); val = 9;
+        RegQueryValueExW( key, L"C:", NULL, NULL, (BYTE *)&val, &size );
+        ok( val == 0, "disabled drive value %lu\n", val );
+        hr = call( services, L"Enable", dn, &d, 1, &out );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            ok( !ret_value( out ), "Enable failed\n" );
+            IWbemClassObject_Release( out );
+        }
+        size = sizeof(val); val = 9;
+        RegQueryValueExW( key, L"C:", NULL, NULL, (BYTE *)&val, &size );
+        ok( val == 1, "enabled drive value %lu\n", val );
+        RegCloseKey( key );
+
+        SysFreeString( V_BSTR( &d ) );
+        V_BSTR( &d ) = SysAllocString( L"nonsense" );
+        hr = call( services, L"Enable", dn, &d, 1, &out );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            ok( ret_value( out ) == ERROR_INVALID_PARAMETER, "bad drive accepted\n" );
+            IWbemClassObject_Release( out );
+        }
+        SysFreeString( V_BSTR( &d ) );
+    }
+
+    /* status of the last restore */
+    hr = call( services, L"GetLastRestoreStatus", NULL, NULL, 0, &out );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        seq1 = ret_value( out );
+        ok( seq1 == 0, "status %ld\n", seq1 );
+        IWbemClassObject_Release( out );
+    }
+
+    /* a restore of an unknown point fails, a known one cannot be applied */
+    {
+        const WCHAR *sn[] = { L"SequenceNumber" };
+        VARIANT s;
+
+        V_VT( &s ) = VT_I4;
+        V_I4( &s ) = 99;
+        hr = call( services, L"Restore", sn, &s, 1, &out );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            seq1 = ret_value( out );
+            ok( seq1 == ERROR_FILE_NOT_FOUND, "restore of unknown point: %ld\n", seq1 );
+            IWbemClassObject_Release( out );
+        }
+        V_I4( &s ) = 1;
+        hr = call( services, L"Restore", sn, &s, 1, &out );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            seq2 = ret_value( out );
+            ok( seq2 == ERROR_NOT_SUPPORTED, "restore of known point: %ld\n", seq2 );
+            IWbemClassObject_Release( out );
+        }
+    }
+
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, L"Software\\Wine\\SystemRestore" );
+}
+
+START_TEST(sgcalls)
+{
+    BSTR path = SysAllocString( L"ROOT\\CIMV2" );
+    IWbemLocator *locator;
+    IWbemServices *services;
+    HRESULT hr;
+
+    CoInitialize( NULL );
+    CoInitializeSecurity( NULL, -1, NULL, NULL, RPC_C_AUTHN_LEVEL_DEFAULT,
+                          RPC_C_IMP_LEVEL_IMPERSONATE, NULL, EOAC_NONE, NULL );
+    hr = CoCreateInstance( &CLSID_WbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemLocator, (void **)&locator );
+    if (hr != S_OK)
+    {
+        win_skip( "can't create instance of WbemLocator\n" );
+        return;
+    }
+    hr = IWbemLocator_ConnectServer( locator, path, NULL, NULL, NULL, 0, NULL, NULL, &services );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        CoSetProxyBlanket( (IUnknown *)services, RPC_C_AUTHN_WINNT, RPC_C_AUTHZ_NONE, NULL,
+                           RPC_C_AUTHN_LEVEL_CALL, RPC_C_IMP_LEVEL_IMPERSONATE, NULL, EOAC_NONE );
+        test_systemrestore( services );
+        IWbemServices_Release( services );
+    }
+    IWbemLocator_Release( locator );
+    SysFreeString( path );
+    CoUninitialize();
+}
