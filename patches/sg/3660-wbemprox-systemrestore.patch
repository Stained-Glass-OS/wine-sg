+    { L"SystemRestore", L"GetLastRestoreStatus", -1, L"ReturnValue", CIM_UINT32 },
+    { L"SystemRestore", L"Restore", 1, L"SequenceNumber", CIM_UINT32 },
+    { L"SystemRestore", L"Restore", -1, L"ReturnValue", CIM_UINT32 },
     { L"Win32_Process", L"Create", 1, L"CommandLine", CIM_STRING },
     { L"Win32_Process", L"Create", 1, L"CurrentDirectory", CIM_STRING },
     { L"Win32_Process", L"Create", -1, L"ProcessId", CIM_UINT32 },
