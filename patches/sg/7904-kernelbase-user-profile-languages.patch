From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: HKCU\Control Panel\International\User Profile.

Windows 8 and later keep the person's language list in
HKCU\Control Panel\International\User Profile ("Languages", REG_MULTI_SZ, most
preferred first, and a key per language naming its keyboard), made with the
profile. Programs read it for their UI language: VisualBoyAdvance-M (wxWidgets)
showed "Can't open registry key ... User Profile (error 2)" at every start.
kernelbase makes it once, from the user's language, when it is missing; a list the
person changed is never touched.
---
diff --git a/dlls/kernelbase/locale.c b/dlls/kernelbase/locale.c
index 4f6aff2..0ac34fa 100644
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -1985,6 +1985,40 @@ static void update_locale_registry(void)
 }
 
 
+/* Windows 8 and later keep the person's language list in
+ * HKCU\Control Panel\International\User Profile ("Languages", most preferred
+ * first, and a key per language naming its keyboard), made with the profile.
+ * Programs read it for their UI language (wxWidgets' VisualBoyAdvance-M showed
+ * "Can't open registry key ... User Profile" at every start). It is made here
+ * once, from the user's language, and never changed after: it is the
+ * person's list. */
+static void init_user_profile_languages(void)
+{
+    WCHAR name[LOCALE_NAME_MAX_LENGTH + 1], value[16];
+    HKEY key, lang;
+    DWORD disp, one = 1;
+    LANGID id;
+    int len;
+
+    if (!intl_key) return;
+    if (RegCreateKeyExW( intl_key, L"User Profile", 0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL,
+                         &key, &disp )) return;
+    if (disp == REG_CREATED_NEW_KEY && (len = LCIDToLocaleName( GetUserDefaultLCID(), name, LOCALE_NAME_MAX_LENGTH, 0 )))
+    {
+        name[len] = 0;  /* REG_MULTI_SZ: the list ends with an empty string */
+        RegSetValueExW( key, L"Languages", 0, REG_MULTI_SZ, (BYTE *)name, (len + 1) * sizeof(WCHAR) );
+        if (!RegCreateKeyExW( key, name, 0, NULL, REG_OPTION_NON_VOLATILE, KEY_ALL_ACCESS, NULL, &lang, NULL ))
+        {
+            id = LANGIDFROMLCID( GetUserDefaultLCID() );
+            swprintf( value, ARRAY_SIZE(value), L"%04x:%08x", id, id );
+            RegSetValueExW( lang, value, 0, REG_DWORD, (BYTE *)&one, sizeof(one) );
+            RegCloseKey( lang );
+        }
+    }
+    RegCloseKey( key );
+}
+
+
 /***********************************************************************
  *		init_locale
  */
@@ -2070,6 +2104,9 @@ void init_locale( HMODULE module )
     }
 
     current_locale_sort = get_language_sort( LOCALE_NAME_USER_DEFAULT );
+#ifndef SG_MUTANT_NO_USER_PROFILE
+    init_user_profile_languages();
+#endif
 
     if (GetDynamicTimeZoneInformation( &timezone ) != TIME_ZONE_ID_INVALID &&
         !RegCreateKeyExW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\TimeZoneInformation",
