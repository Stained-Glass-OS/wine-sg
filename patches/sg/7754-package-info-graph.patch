diff --git a/dlls/kernelbase/version.c b/dlls/kernelbase/version.c
index bc6decf..4399dce 100644
--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -1811,25 +1811,42 @@ LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackageId( UINT32 *len, BYTE *buff
     return PackageIdFromFullName( full_name, 0, len, buffer );
 }
 
-/***********************************************************************
- *         GetCurrentPackageInfo   (kernelbase.@)
- */
-/* The current package's graph: the package itself, then the frameworks it
+/* A package's graph: the package itself, then the frameworks it
  * depends on (its record's Dependencies, which ntdll also puts on the DLL
  * path). The buffer holds the PACKAGE_INFO array, then their strings. */
-LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
+/* Stained Glass OS: the graph of any deployed package (GetPackageInfo) and the path kind the "2"
+ * forms ask for. A package's files have one place here: its install location serves as its
+ * mutable and effective paths, and its external location (a sparse package) as the external ones. */
+static void package_path_of( const WCHAR *full_name, PackagePathType type, WCHAR *path, DWORD size )
+{
+    WCHAR key[MAX_PATH];
+    DWORD bytes = size * sizeof(WCHAR);
+
+    path[0] = 0;
+    if ((type == PackagePathType_MachineExternal || type == PackagePathType_UserExternal ||
+         type == PackagePathType_EffectiveExternal) &&
+        wcslen( full_name ) + ARRAY_SIZE(deployed_packagesW) + 1 < ARRAY_SIZE(key))
+    {
+        swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, full_name );
+        if (!RegGetValueW( record_hive( key ), key, L"ExternalLocation", RRF_RT_REG_SZ | RRF_SUBKEY_WOW6464KEY, NULL, path, &bytes ))
+            return;
+        if (type != PackagePathType_EffectiveExternal) return;
+    }
+    if (!package_location( full_name, path, size )) path[0] = 0;
+}
+
+static LONG package_graph_info( const WCHAR *head, const UINT32 flags, PackagePathType path_type,
+                                UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
 {
     WCHAR key[MAX_PATH], deps[4096], *names[32], *p;
     UINT32 props[32], n = 0, i, size, len, family_len, id_len;
-    const WCHAR *head = current_package();
     BOOL all = !(flags & (PACKAGE_FILTER_HEAD | PACKAGE_FILTER_DIRECT));
     DWORD bytes, value;
     BYTE *strings;
 
-    TRACE( "(%#x %p %p %p)\n", flags, buffer_size, buffer, count );
-
     if (!head) return APPMODEL_ERROR_NO_PACKAGE;
     if (!buffer_size) return ERROR_INVALID_PARAMETER;
+    if (path_type > PackagePathType_EffectiveExternal) return ERROR_INVALID_PARAMETER;
 
     swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, head );
     if (all || (flags & PACKAGE_FILTER_HEAD))
@@ -1858,7 +1875,7 @@ LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE
     for (i = 0; i < n; i++)
     {
         WCHAR location[MAX_PATH];
-        if (!package_location( names[i], location, ARRAY_SIZE(location) )) location[0] = 0;
+        package_path_of( names[i], path_type, location, ARRAY_SIZE(location) );
         family_len = 0;
         PackageFamilyNameFromFullName( names[i], &family_len, NULL );
         id_len = 0;
@@ -1881,7 +1898,7 @@ LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE
         PACKAGE_INFO *info = (PACKAGE_INFO *)buffer + i;
         WCHAR location[MAX_PATH];
 
-        if (!package_location( names[i], location, ARRAY_SIZE(location) )) location[0] = 0;
+        package_path_of( names[i], path_type, location, ARRAY_SIZE(location) );
         memset( info, 0, sizeof(*info) );
         info->flags = props[i];
         info->path = (WCHAR *)strings;
@@ -1907,6 +1924,152 @@ LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE
     return ERROR_SUCCESS;
 }
 
+/***********************************************************************
+ *         GetCurrentPackageInfo   (kernelbase.@)
+ */
+LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
+{
+    TRACE( "(%#x %p %p %p)\n", flags, buffer_size, buffer, count );
+    return package_graph_info( current_package(), flags, PackagePathType_Install, buffer_size, buffer, count );
+}
+
+/***********************************************************************
+ *         GetCurrentPackageInfo2   (kernelbase.@)
+ */
+LONG WINAPI GetCurrentPackageInfo2( const UINT32 flags, PackagePathType path_type, UINT32 *buffer_size,
+                                    BYTE *buffer, UINT32 *count )
+{
+    TRACE( "(%#x %d %p %p %p)\n", flags, path_type, buffer_size, buffer, count );
+#ifdef SG_MUTANT_NO_PACKAGEINFO2
+    return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
+    return package_graph_info( current_package(), flags, path_type, buffer_size, buffer, count );
+}
+
+/***********************************************************************
+ *         GetCurrentPackageInfo3   (kernelbase.@)
+ */
+/* The internal form the Windows App SDK's dynamic dependencies hook (it looks the export up and
+ * stops the process if it is missing): the path kinds as in GetCurrentPackageInfo2, as an
+ * HRESULT, and the package graph's generation. */
+HRESULT WINAPI GetCurrentPackageInfo3( UINT32 flags, UINT32 info_type, UINT32 *buffer_size, void *buffer,
+                                       UINT32 *count )
+{
+    TRACE( "(%#x %u %p %p %p)\n", flags, info_type, buffer_size, buffer, count );
+
+    if (info_type == PackageInfo3Type_PackageInfoGeneration)
+    {
+        if (!buffer_size) return E_INVALIDARG;
+        if (count) *count = 1;
+        if (!buffer || *buffer_size < sizeof(UINT32))
+        {
+            *buffer_size = sizeof(UINT32);
+            return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        }
+        *buffer_size = sizeof(UINT32);
+        *(UINT32 *)buffer = GetPackageGraphRevisionId();
+        return S_OK;
+    }
+    return HRESULT_FROM_WIN32( package_graph_info( current_package(), flags, info_type, buffer_size, buffer, count ) );
+}
+
+/***********************************************************************
+ *         GetPackageGraphRevisionId   (kernelbase.@)
+ */
+/* The process's package graph is fixed for its life here (no dynamic dependencies are added). */
+UINT32 WINAPI GetPackageGraphRevisionId(void)
+{
+    TRACE( "()\n" );
+    return 1;
+}
+
+struct package_info_reference
+{
+    DWORD magic;
+    WCHAR full_name[1];
+};
+#define PACKAGE_INFO_MAGIC 0x49474b50 /* PKGI */
+
+/***********************************************************************
+ *         OpenPackageInfoByFullNameForUser   (kernelbase.@)
+ */
+LONG WINAPI OpenPackageInfoByFullNameForUser( PSID sid, const WCHAR *full_name, const UINT32 reserved,
+                                              PACKAGE_INFO_REFERENCE *ref )
+{
+    struct package_info_reference *info;
+    WCHAR path[MAX_PATH];
+    DWORD len;
+
+    TRACE( "(%p %s %#x %p)\n", sid, debugstr_w(full_name), reserved, ref );
+
+    if (!full_name || !ref || reserved) return ERROR_INVALID_PARAMETER;
+    *ref = NULL;
+    if (VerifyPackageFullName( full_name )) return ERROR_INVALID_PARAMETER;
+    if (!package_location( full_name, path, ARRAY_SIZE(path) )) return ERROR_NOT_FOUND;
+    len = wcslen( full_name );
+    if (!(info = HeapAlloc( GetProcessHeap(), 0, offsetof( struct package_info_reference, full_name[len + 1] ) )))
+        return ERROR_OUTOFMEMORY;
+    info->magic = PACKAGE_INFO_MAGIC;
+    memcpy( info->full_name, full_name, (len + 1) * sizeof(WCHAR) );
+    *ref = (PACKAGE_INFO_REFERENCE)info;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         OpenPackageInfoByFullName   (kernelbase.@)
+ */
+LONG WINAPI OpenPackageInfoByFullName( const WCHAR *full_name, const UINT32 reserved, PACKAGE_INFO_REFERENCE *ref )
+{
+    return OpenPackageInfoByFullNameForUser( NULL, full_name, reserved, ref );
+}
+
+static const WCHAR *package_info_name( PACKAGE_INFO_REFERENCE ref )
+{
+    struct package_info_reference *info = (struct package_info_reference *)ref;
+
+    if (!info || info->magic != PACKAGE_INFO_MAGIC) return NULL;
+    return info->full_name;
+}
+
+/***********************************************************************
+ *         GetPackageInfo2   (kernelbase.@)
+ */
+LONG WINAPI GetPackageInfo2( PACKAGE_INFO_REFERENCE ref, const UINT32 flags, PackagePathType path_type,
+                             UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
+{
+    const WCHAR *name = package_info_name( ref );
+
+    TRACE( "(%p %#x %d %p %p %p)\n", ref, flags, path_type, buffer_size, buffer, count );
+    if (!name) return ERROR_INVALID_PARAMETER;
+#ifdef SG_MUTANT_PACKAGEINFO_CURRENT
+    name = current_package();
+#endif
+    return package_graph_info( name, flags, path_type, buffer_size, buffer, count );
+}
+
+/***********************************************************************
+ *         GetPackageInfo   (kernelbase.@)
+ */
+LONG WINAPI GetPackageInfo( PACKAGE_INFO_REFERENCE ref, const UINT32 flags, UINT32 *buffer_size, BYTE *buffer,
+                            UINT32 *count )
+{
+    return GetPackageInfo2( ref, flags, PackagePathType_Install, buffer_size, buffer, count );
+}
+
+/***********************************************************************
+ *         ClosePackageInfo   (kernelbase.@)
+ */
+LONG WINAPI ClosePackageInfo( PACKAGE_INFO_REFERENCE ref )
+{
+    struct package_info_reference *info = (struct package_info_reference *)ref;
+
+    TRACE( "(%p)\n", ref );
+    if (!package_info_name( ref )) return ERROR_INVALID_PARAMETER;
+    info->magic = 0;
+    HeapFree( GetProcessHeap(), 0, info );
+    return ERROR_SUCCESS;
+}
+
 /***********************************************************************
  *         GetCurrentPackagePath   (kernelbase.@)
  */
diff --git a/include/appmodel.h b/include/appmodel.h
index c56cb2d..d53ba5a 100644
--- a/include/appmodel.h
+++ b/include/appmodel.h
@@ -95,6 +95,23 @@ typedef struct PACKAGE_INFO
 }
 PACKAGE_INFO;
 
+typedef enum PackagePathType
+{
+    PackagePathType_Install = 0,
+    PackagePathType_Mutable = 1,
+    PackagePathType_Effective = 2,
+    PackagePathType_MachineExternal = 3,
+    PackagePathType_UserExternal = 4,
+    PackagePathType_EffectiveExternal = 5
+} PackagePathType;
+
+typedef enum PackageInfo3Type
+{
+    PackageInfo3Type_PackageInfoGeneration = 16
+} PackageInfo3Type;
+
+typedef struct _PACKAGE_INFO_REFERENCE { void *reserved; } *PACKAGE_INFO_REFERENCE;
+
 #define PACKAGE_PROPERTY_FRAMEWORK          0x00000001
 #define PACKAGE_PROPERTY_RESOURCE           0x00000002
 #define PACKAGE_PROPERTY_BUNDLE             0x00000004
@@ -124,7 +141,14 @@ LONG WINAPI FindPackagesByPackageFamily(const WCHAR *family_name, UINT32 filters
 LONG WINAPI GetApplicationUserModelId(HANDLE process, UINT32 *length, WCHAR *id);
 LONG WINAPI GetCurrentApplicationUserModelId(UINT32 *length, WCHAR *id);
 LONG WINAPI GetCurrentPackageFamilyName(UINT32 *length, WCHAR *name);
+LONG WINAPI ClosePackageInfo(PACKAGE_INFO_REFERENCE ref);
 LONG WINAPI GetCurrentPackageInfo(const UINT32 flags, UINT32 *buffer_length, BYTE *buffer, UINT32 *count);
+LONG WINAPI GetCurrentPackageInfo2(const UINT32 flags, PackagePathType path_type, UINT32 *buffer_length, BYTE *buffer, UINT32 *count);
+LONG WINAPI GetPackageInfo(PACKAGE_INFO_REFERENCE ref, const UINT32 flags, UINT32 *buffer_length, BYTE *buffer, UINT32 *count);
+LONG WINAPI GetPackageInfo2(PACKAGE_INFO_REFERENCE ref, const UINT32 flags, PackagePathType path_type, UINT32 *buffer_length, BYTE *buffer, UINT32 *count);
+UINT32 WINAPI GetPackageGraphRevisionId(void);
+LONG WINAPI OpenPackageInfoByFullName(const WCHAR *full_name, const UINT32 reserved, PACKAGE_INFO_REFERENCE *ref);
+LONG WINAPI OpenPackageInfoByFullNameForUser(PSID sid, const WCHAR *full_name, const UINT32 reserved, PACKAGE_INFO_REFERENCE *ref);
 LONG WINAPI GetCurrentPackageFullName(UINT32 *length, WCHAR *name);
 LONG WINAPI PackageFamilyNameFromFullName(const WCHAR *full_name, UINT32 *length, WCHAR *family_name);
 LONG WINAPI PackageFamilyNameFromId(const PACKAGE_ID *id, UINT32 *length, WCHAR *family_name);
