+/* Returns the length of a valid UTF-8 sequence starting at p, or 0 when invalid. */
+static int utf8_sequence_len(const unsigned char *p, int left)
+{
+    int len, i;
+
+    if (p[0] < 0x80) return 1;
+    if (p[0] >= 0xc2 && p[0] <= 0xdf) len = 2;
+    else if (p[0] >= 0xe0 && p[0] <= 0xef) len = 3;
+    else if (p[0] >= 0xf0 && p[0] <= 0xf4) len = 4;
+    else return 0;
+    if (len > left) return 0;
+    for (i = 1; i < len; i++)
+        if ((p[i] & 0xc0) != 0x80) return 0;
+    return len;
+}
+
+static HRESULT detect_input_codepage(DWORD flags, DWORD pref_cp, const char *src, int size,
+        DetectEncodingInfo *info, INT *count)
+{
+    const unsigned char *p = (const unsigned char *)src;
+    BOOL ascii = TRUE, utf8 = TRUE, has_esc = FALSE, has_multi = FALSE;
+    INT max = *count, n = 0;
+    UINT japanese;
+    int i;
+
+    if (size >= 3 && p[0] == 0xef && p[1] == 0xbb && p[2] == 0xbf)
+        info[n].nCodePage = CP_UTF8, info[n].nConfidence = 100, n++;
+    else if (size >= 2 && p[0] == 0xff && p[1] == 0xfe)
+        info[n].nCodePage = 1200, info[n].nConfidence = 100, n++;
+    else if (size >= 2 && p[0] == 0xfe && p[1] == 0xff)
+        info[n].nCodePage = 1201, info[n].nConfidence = 100, n++;
+
+    if (!n)
+    {
+        for (i = 0; i < size; i++)
+        {
+            int len;
+
+            if (p[i] == 0x1b) has_esc = TRUE;
+            if (p[i] < 0x80) continue;
+            ascii = FALSE;
+            if (!utf8) continue;
+            if (!(len = utf8_sequence_len(p + i, size - i))) utf8 = FALSE;
+            else { has_multi = TRUE; i += len - 1; }
+        }
+
+        japanese = DetectJapaneseCode(src, size);
+        if (!ascii && utf8 && has_multi)
+            info[n].nCodePage = CP_UTF8, info[n].nConfidence = 90, n++;
+        if (japanese && n < max)
+            info[n].nCodePage = japanese, info[n].nConfidence = n ? 40 : 90, n++;
+        else if (ascii && !has_esc)
+            info[n].nCodePage = 20127, info[n].nConfidence = 100, n++;
+        if (!n || !ascii)
+        {
+            UINT cp = pref_cp ? pref_cp : GetACP();
+            BOOL dup = FALSE;
+            for (i = 0; i < n; i++) if (info[i].nCodePage == cp) dup = TRUE;
+            if (!dup && n < max)
+                info[n].nCodePage = cp, info[n].nConfidence = ascii ? 100 : 50, n++;
+        }
+    }
+
+    if (n > max) n = max;
+    for (i = 0; i < n; i++)
+    {
+        info[i].nLangID = 0;
+        info[i].nDocPercent = 100;
+    }
+    *count = n;
+    return n ? S_OK : E_FAIL;
+}
+
+static HRESULT detect_outbound_codepages(const WCHAR *str, int len, const UINT *preferred, UINT npreferred,
+        UINT *detected, UINT *ndetected)
+{
+    UINT max = *ndetected, n = 0, i;
+    BOOL ascii = TRUE;
+    int j;
+
+    for (j = 0; j < len; j++)
+        if (str[j] >= 0x80) { ascii = FALSE; break; }
+
+    /* pure ASCII text is representable by the Unicode encodings only, in this order */
+    if (!ascii && preferred)
+    {
+        for (i = 0; i < npreferred && n < max; i++)
+        {
+            BOOL used_default = FALSE;
+            UINT cp = preferred[i];
+
+            if (cp == CP_UTF8 || cp == CP_UTF7 || cp == 1200) continue;
+            if (!IsValidCodePage(cp)) continue;
+            if (!WideCharToMultiByte(cp, WC_NO_BEST_FIT_CHARS, str, len, NULL, 0, NULL, &used_default) || used_default)
+                continue;
+            detected[n++] = cp;
+        }
+    }
+    if (n < max) detected[n++] = CP_UTF8;
+    if (n < max) detected[n++] = CP_UTF7;
+    if (n < max) detected[n++] = 1200;
+    *ndetected = n;
+    return S_OK;
+}
+
+static HRESULT read_whole_stream(IStream *stream, char **data, int *size)
+{
+    const int limit = 16 * 1024 * 1024;
+    int allocated = 4096, used = 0;
+    char *buf = malloc(allocated);
+
+    if (!buf) return E_OUTOFMEMORY;
+    for (;;)
+    {
+        ULONG read = 0;
+        HRESULT hr;
+
+        if (used == allocated)
+        {
+            char *new;
+            if (allocated >= limit) break;
+            if (!(new = realloc(buf, allocated *= 2))) { free(buf); return E_OUTOFMEMORY; }
+            buf = new;
+        }
+        hr = IStream_Read(stream, buf + used, allocated - used, &read);
+        if (FAILED(hr)) { free(buf); return hr; }
+        if (!read) break;
+        used += read;
+    }
+    *data = buf;
+    *size = used;
+    return S_OK;
+}
