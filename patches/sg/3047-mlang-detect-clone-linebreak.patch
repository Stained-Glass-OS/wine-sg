+static void test_DetectInputCodepage(IMultiLanguage3 *ml)
+{
+    static const char ascii[] = "plain ascii";
+    static const char utf8[] = "caf\xc3\xa9 \xe2\x82\xac";
+    static const char bom16[] = "\xff\xfeh\0i\0";
+    DetectEncodingInfo info[4];
+    INT size, scores;
+    HRESULT hr;
+
+    size = sizeof(ascii) - 1;
+    scores = 4;
+    hr = IMultiLanguage3_DetectInputCodepage(ml, 0, 0, (char *)ascii, &size, info, &scores);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(scores >= 1 && info[0].nCodePage == 20127, "got %d scores, cp %u\n", scores, info[0].nCodePage);
+
+    size = sizeof(utf8) - 1;
+    scores = 4;
+    hr = IMultiLanguage3_DetectInputCodepage(ml, 0, 1252, (char *)utf8, &size, info, &scores);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(scores >= 1 && info[0].nCodePage == CP_UTF8, "got %d scores, cp %u\n", scores, info[0].nCodePage);
+
+    size = sizeof(bom16) - 1;
+    scores = 4;
+    hr = IMultiLanguage3_DetectInputCodepage(ml, 0, 0, (char *)bom16, &size, info, &scores);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(scores == 1 && info[0].nCodePage == 1200, "got %d scores, cp %u\n", scores, info[0].nCodePage);
+
+    scores = 0;
+    hr = IMultiLanguage3_DetectInputCodepage(ml, 0, 0, (char *)ascii, &size, info, &scores);
+    ok(hr == E_INVALIDARG, "got %08lx\n", hr);
+}
