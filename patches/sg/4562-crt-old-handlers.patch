From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] msvcrt: Implement the VC 7.0 buffer overrun handler functions and msvcr80's fastcall heap exports.

msvcr70 and msvcr71's __set_buffer_overrun_handler, the VC 7.0 name of
_set_security_error_handler (one handler for both), and
__buffer_overrun, the VC 7.0 report of a detected buffer overrun
(__security_error_handler with _SECERR_BUFFER_OVERRUN); msvcr80's i386
fastcall exports @_calloc_crt@8 and @_realloc_crt@8.
---
 dlls/msvcr70/msvcr70.spec |  4 ++--
 dlls/msvcr71/msvcr71.spec |  4 ++--
 dlls/msvcr80/msvcr80.spec |  4 ++--
 dlls/msvcrt/except.c      | 23 +++++++++++++++++++++++
 dlls/msvcrt/heap.c        | 23 +++++++++++++++++++++++
 5 files changed, 52 insertions(+), 6 deletions(-)

diff --git a/dlls/msvcr70/msvcr70.spec b/dlls/msvcr70/msvcr70.spec
index 8763c8c..eeb59c0 100644
--- a/dlls/msvcr70/msvcr70.spec
+++ b/dlls/msvcr70/msvcr70.spec
@@ -167,7 +167,7 @@
 @ extern __argc MSVCRT___argc
 @ extern __argv MSVCRT___argv
 @ extern __badioinfo MSVCRT___badioinfo
-@ stub __buffer_overrun
+@ cdecl __buffer_overrun()
 @ cdecl __crtCompareStringA(long long str long str long)
 @ cdecl __crtCompareStringW(long long wstr long wstr long)
 @ cdecl __crtGetLocaleInfoW(long long ptr long)
@@ -224,7 +224,7 @@
 @ cdecl __pxcptinfoptrs()
 @ cdecl __security_error_handler(long ptr)
 @ cdecl __set_app_type(long)
-@ stub __set_buffer_overrun_handler
+@ cdecl __set_buffer_overrun_handler(ptr)
 @ extern __setlc_active MSVCRT___setlc_active
 @ cdecl __setusermatherr(ptr)
 @ cdecl __threadhandle() kernel32.GetCurrentThread
diff --git a/dlls/msvcr71/msvcr71.spec b/dlls/msvcr71/msvcr71.spec
index 246f460..ac88360 100644
--- a/dlls/msvcr71/msvcr71.spec
+++ b/dlls/msvcr71/msvcr71.spec
@@ -162,7 +162,7 @@
 @ extern __argc MSVCRT___argc
 @ extern __argv MSVCRT___argv
 @ extern __badioinfo MSVCRT___badioinfo
-@ stub __buffer_overrun
+@ cdecl __buffer_overrun()
 @ cdecl __crtCompareStringA(long long str long str long)
 @ cdecl __crtCompareStringW(long long wstr long wstr long)
 @ cdecl __crtGetLocaleInfoW(long long ptr long)
@@ -219,7 +219,7 @@
 @ cdecl __pxcptinfoptrs()
 @ cdecl __security_error_handler(long ptr)
 @ cdecl __set_app_type(long)
-@ stub __set_buffer_overrun_handler
+@ cdecl __set_buffer_overrun_handler(ptr)
 @ extern __setlc_active MSVCRT___setlc_active
 @ cdecl __setusermatherr(ptr)
 @ cdecl __threadhandle() kernel32.GetCurrentThread
diff --git a/dlls/msvcr80/msvcr80.spec b/dlls/msvcr80/msvcr80.spec
index 30deb25..52f624a 100644
--- a/dlls/msvcr80/msvcr80.spec
+++ b/dlls/msvcr80/msvcr80.spec
@@ -153,9 +153,9 @@
 @ cdecl -arch=arm ?what@exception@std@@UBAPBDXZ(ptr) exception_what
 @ thiscall -arch=i386 ?what@exception@std@@UBEPBDXZ(ptr) exception_what
 @ cdecl -arch=win64 ?what@exception@std@@UEBAPEBDXZ(ptr) exception_what
-@ stub @_calloc_crt@8
+@ stdcall -fastcall -arch=i386 @_calloc_crt@8(long long) _calloc_crt_fastcall
 @ cdecl @_malloc_crt@4(long) malloc
-@ stub @_realloc_crt@8
+@ stdcall -fastcall -arch=i386 @_realloc_crt@8(ptr long) _realloc_crt_fastcall
 @ cdecl -norelay $I10_OUTPUT(double long long long ptr) I10_OUTPUT
 @ cdecl -arch=i386 _CIacos()
 @ cdecl -arch=i386 _CIasin()
diff --git a/dlls/msvcrt/except.c b/dlls/msvcrt/except.c
index 71b7f83..a5126bb 100644
--- a/dlls/msvcrt/except.c
+++ b/dlls/msvcrt/except.c
@@ -881,6 +881,29 @@ void CDECL __security_error_handler(int code, void *data)
     _exit(3);
 }
 
+/*********************************************************************
+ *		__set_buffer_overrun_handler (MSVCR70.@)
+ *
+ * The VC 7.0 name of _set_security_error_handler: one handler for both.
+ */
+MSVCRT_security_error_handler CDECL __set_buffer_overrun_handler(MSVCRT_security_error_handler handler)
+{
+    return _set_security_error_handler(handler);
+}
+
+/*********************************************************************
+ *		__buffer_overrun (MSVCR70.@)
+ *
+ * The VC 7.0 report of a detected buffer overrun.
+ */
+void CDECL __buffer_overrun(void)
+{
+#ifdef SG_MUTANT_BUFFER_OVERRUN_CODE
+    __security_error_handler(0, NULL);
+#endif
+    __security_error_handler(1 /* _SECERR_BUFFER_OVERRUN */, NULL);
+}
+
 #endif /* _MSVCR_VER>=70 && _MSVCR_VER<=71 */
 
 #if _MSVCR_VER>=110
diff --git a/dlls/msvcrt/heap.c b/dlls/msvcrt/heap.c
index 7251060..790a891 100644
--- a/dlls/msvcrt/heap.c
+++ b/dlls/msvcrt/heap.c
@@ -500,6 +500,29 @@ void* CDECL _recalloc(void *mem, size_t num, size_t size)
     return ret;
 }
 
+#if _MSVCR_VER >= 80 && _MSVCR_VER < 90 && defined(__i386__)
+/*********************************************************************
+ * @_calloc_crt@8 (MSVCR80.@)
+ *
+ * The fastcall forms of _calloc_crt and _realloc_crt.
+ */
+void* __fastcall _calloc_crt_fastcall(size_t count, size_t size)
+{
+    return calloc(count, size);
+}
+
+/*********************************************************************
+ * @_realloc_crt@8 (MSVCR80.@)
+ */
+void* __fastcall _realloc_crt_fastcall(void *ptr, size_t size)
+{
+#ifdef SG_MUTANT_REALLOC_CRT_FASTCALL_NEW
+    return malloc(size);
+#endif
+    return realloc(ptr, size);
+}
+#endif
+
 /*********************************************************************
  * _recalloc_crt (MSVCR80.@)
  */
