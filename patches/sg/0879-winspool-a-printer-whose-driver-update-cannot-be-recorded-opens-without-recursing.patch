From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] winspool: a printer whose driver update cannot be recorded opens without recursing

Opening a printer whose Status asks for a driver update (a CUPS queue new to
the machine) installs the driver from the queue's PPD and calls the driver
for its DEVMODE (DocumentProperties); wineps opens the printer again. The
update clears the Status first -- but a standard user may not write the
machine's printer keys, so the Status stayed, and every open updated again:
OpenPrinter2W -> update_driver -> AddPrinterDriverEx (access denied) ->
DocumentProperties -> OpenPrinter2W ... about 600 levels deep, until the
stack ran out. DYMO Connect started by a standard user with a LabelWriter's
queue died at every launch, and the desktop, which keeps winspool loaded
(0609), could go the same way.

A process now updates a printer's driver once at a time, and a printer whose
Status it could not clear, once: the open returns. (The driver is still
installed only by a user who may -- SYSTEM, an administrator.)

Test: test/usbprint-gate.sh -- the printer's Status set and its key made
read-only, as the machine's printer keys are to a standard user, then opened
twice, 64- and 32-bit (mutant SG_MUTANT_DRIVERLOOP: the probe dies of the
recursion).
---
--- a/dlls/winspool.drv/info.c
+++ b/dlls/winspool.drv/info.c
@@ -830,6 +830,78 @@
     if (params.name != buffer) free( params.name );
 }
 
+#ifndef SG_MUTANT_DRIVERLOOP
+/* Stained Glass OS: the printers whose driver this process is updating, or
+ * updated without being able to record it. Opening a printer whose Status
+ * asks for a driver update updates the driver, and the update opens the
+ * printer again (DocumentProperties, wineps); the update clears the Status
+ * first -- but a standard user may not write the machine's printer keys, so
+ * the Status stayed and every open updated again, recursing until the stack
+ * ran out: DYMO Connect, started by a standard user with a LabelWriter's
+ * queue whose driver was not installed yet, died at every launch, and the
+ * desktop, which keeps winspool loaded, could go the same way. A printer is
+ * updated once at a time; one whose Status could not be cleared, once per
+ * process. */
+struct driver_update
+{
+    struct list entry;
+    WCHAR *name;
+};
+static struct list driver_updates = LIST_INIT( driver_updates );
+static CRITICAL_SECTION driver_updates_cs;
+static CRITICAL_SECTION_DEBUG driver_updates_cs_debug =
+{
+    0, 0, &driver_updates_cs,
+    { &driver_updates_cs_debug.ProcessLocksList, &driver_updates_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": driver_updates_cs") }
+};
+static CRITICAL_SECTION driver_updates_cs = { &driver_updates_cs_debug, -1, 0, 0, 0, 0 };
+
+/* whether this process may update NAME's driver now */
+static BOOL begin_driver_update( const WCHAR *name )
+{
+    struct driver_update *update;
+    BOOL ret = TRUE;
+
+    EnterCriticalSection( &driver_updates_cs );
+    LIST_FOR_EACH_ENTRY( update, &driver_updates, struct driver_update, entry )
+    {
+        if (!wcsicmp( update->name, name ))
+        {
+            ret = FALSE;
+            break;
+        }
+    }
+    if (ret && (update = malloc( sizeof(*update) )))
+    {
+        if ((update->name = wcsdup( name ))) list_add_tail( &driver_updates, &update->entry );
+        else free( update );
+    }
+    LeaveCriticalSection( &driver_updates_cs );
+    if (!ret) TRACE( "%s: its driver is being updated, or was and could not be recorded\n", debugstr_w(name) );
+    return ret;
+}
+
+/* the update recorded in the Status: a later one may run (the printer made again) */
+static void end_driver_update( const WCHAR *name )
+{
+    struct driver_update *update;
+
+    EnterCriticalSection( &driver_updates_cs );
+    LIST_FOR_EACH_ENTRY( update, &driver_updates, struct driver_update, entry )
+    {
+        if (!wcsicmp( update->name, name ))
+        {
+            list_remove( &update->entry );
+            free( update->name );
+            free( update );
+            break;
+        }
+    }
+    LeaveCriticalSection( &driver_updates_cs );
+}
+#endif
+
 static BOOL update_driver( HANDLE printer )
 {
     BOOL ret;
@@ -2165,14 +2237,27 @@
     if (*printer && WINSPOOL_GetOpenedPrinterRegKey( *printer, &key ) == ERROR_SUCCESS)
     {
         DWORD deleting = 0, size = sizeof( deleting ), type;
-        DWORD status;
+        DWORD status, cleared;
         RegQueryValueExW( key, May_Delete_Value, NULL, &type, (LPBYTE)&deleting, &size );
         WaitForSingleObject( init_mutex, INFINITE );
         status = get_dword_from_reg( key, L"Status" );
-        set_reg_DWORD( key, L"Status", status & ~PRINTER_STATUS_DRIVER_UPDATE_NEEDED );
+        cleared = !(status & PRINTER_STATUS_DRIVER_UPDATE_NEEDED) ||
+                  !set_reg_DWORD( key, L"Status", status & ~PRINTER_STATUS_DRIVER_UPDATE_NEEDED );
         ReleaseMutex( init_mutex );
         if (!deleting && (status & PRINTER_STATUS_DRIVER_UPDATE_NEEDED))
+        {
+#ifndef SG_MUTANT_DRIVERLOOP
+            const WCHAR *printer_name = get_opened_printer_name( *printer );
+
+            if (printer_name && begin_driver_update( printer_name ))
+            {
+                update_driver( *printer );
+                if (cleared) end_driver_update( printer_name );
+            }
+#else
             update_driver( *printer );
+#endif
+        }
         RegCloseKey( key );
     }
 
