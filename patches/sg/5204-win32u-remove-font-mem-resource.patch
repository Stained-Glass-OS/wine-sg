From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 12:00:00 +0000
Subject: [PATCH] win32u: RemoveFontMemResourceEx removes the memory fonts

The handle AddFontMemResourceEx returns is now a number from a list of added
resources (the old scrambled address did not fit a WoW64 handle).
RemoveFontMemResourceEx drops the faces made from the font image and the
unused realized fonts, and refuses unknown or removed handles. CORE: integrator
must review (patches/notes/5204.txt).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XZFS4SPPzeH5d2c1MuzqCS
---

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -3044,6 +3044,50 @@
     pthread_mutex_unlock( &font_lock );
 }
 
+/* the fonts AddFontMemResourceEx added, by the handle it returned */
+struct mem_font_resource
+{
+    struct list entry;
+    ULONG_PTR   id;
+    void       *data;
+};
+static struct list mem_font_list = LIST_INIT( mem_font_list );
+static ULONG_PTR next_mem_font_id;
+
+/* the faces AddFontMemResourceEx made from the font image at 'data' */
+static int remove_mem_font( const void *data )
+{
+    struct gdi_font_family *family, *family_next;
+    struct gdi_font_face *face, *face_next;
+    struct gdi_font *font, *font_next;
+    int count = 0;
+
+    pthread_mutex_lock( &font_lock );
+    /* realized fonts nobody uses any more would still be found by name */
+    LIST_FOR_EACH_ENTRY_SAFE( font, font_next, &unused_gdi_font_list, struct gdi_font, unused_entry )
+    {
+        if (font->data_ptr != data) continue;
+        list_remove( &font->entry );
+        list_remove( &font->unused_entry );
+        unused_font_count--;
+        free_gdi_font( font );
+    }
+    WINE_RB_FOR_EACH_ENTRY_DESTRUCTOR( family, family_next, &family_name_tree, struct gdi_font_family, name_entry )
+    {
+        family->refcount++;
+        LIST_FOR_EACH_ENTRY_SAFE( face, face_next, &family->faces, struct gdi_font_face, entry )
+        {
+            if (face->file || face->data_ptr != data) continue;
+            TRACE( "removing memory face %s refcount %d\n", debugstr_w(face->full_name), face->refcount );
+            release_face( face );
+            count++;
+        }
+        release_family( family );
+    }
+    pthread_mutex_unlock( &font_lock );
+    return count;
+}
+
 static void add_font_list(HKEY hkey, const struct nls_update_font_list *fl, int dpi)
 {
     const char *sserif = (dpi <= 108) ? fl->sserif_96 : fl->sserif_120;
@@ -7021,10 +7065,22 @@
         return NULL;
     }
 
-    /* FIXME: is the handle only for use in RemoveFontMemResourceEx or should it be a true handle?
-     * For now return something unique but quite random
-     */
-    ret = (HANDLE)((INT_PTR)copy ^ 0x87654321);
+    /* the handle is only for RemoveFontMemResourceEx: a number we can look up (the font image's
+     * address would not survive the 32-bit handle of a WoW64 process) */
+    {
+        struct mem_font_resource *res = malloc( sizeof(*res) );
+        if (res)
+        {
+            res->data = copy;
+            pthread_mutex_lock( &font_lock );
+            res->id = ++next_mem_font_id;
+            list_add_tail( &mem_font_list, &res->entry );
+            pthread_mutex_unlock( &font_lock );
+            ret = (HANDLE)res->id;
+        }
+        else ret = NULL;
+    }
+    if (!ret) return NULL;
 
     __TRY
     {
@@ -7046,7 +7102,33 @@
  */
 BOOL WINAPI NtGdiRemoveFontMemResourceEx( HANDLE handle )
 {
-    FIXME( "(%p) stub\n", handle );
+    /* the handle AddFontMemResourceEx returned is the font image's address, scrambled; the image
+     * itself stays allocated: fonts that were already selected into a DC still read from it */
+    struct mem_font_resource *res, *found = NULL;
+    void *data;
+
+    TRACE( "(%p)\n", handle );
+
+#ifdef SG_MUTANT_MEMFONT_STUB
+    return TRUE;
+#endif
+    pthread_mutex_lock( &font_lock );
+    LIST_FOR_EACH_ENTRY( res, &mem_font_list, struct mem_font_resource, entry )
+    {
+        if (res->id != (ULONG_PTR)handle) continue;
+        list_remove( &res->entry );
+        found = res;
+        break;
+    }
+    pthread_mutex_unlock( &font_lock );
+    if (!found)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    data = found->data;
+    free( found );
+    remove_mem_font( data );
     return TRUE;
 }
 
