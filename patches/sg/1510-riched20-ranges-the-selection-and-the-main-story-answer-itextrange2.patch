+static HRESULT WINAPI textrange2_GetChar2( ITextRange2 *iface, LONG *ch, LONG offset )
+{
+    ITextRange *range = (ITextRange *)iface, *dup;
+    LONG start;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p %ld)\n", iface, ch, offset );
+    if (!ch) return E_INVALIDARG;
+    if (!offset) return ITextRange_GetChar( range, ch );
+    if (FAILED(hr = ITextRange_GetStart( range, &start ))) return hr;
+    if (start + offset < 0)
+    {
+        *ch = 0;
+        return S_FALSE;
+    }
+    if (FAILED(hr = ITextRange_GetDuplicate( range, &dup ))) return hr;
+    hr = ITextRange_SetRange( dup, start + offset, start + offset );
+    if (SUCCEEDED(hr)) hr = ITextRange_GetChar( dup, ch );
+    ITextRange_Release( dup );
+    return hr;
+}
