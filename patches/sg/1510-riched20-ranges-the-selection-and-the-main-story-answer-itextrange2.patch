+/* ITextRange2 (Stained Glass OS, wine-sg 1510): a range's and the selection's
+ * methods beyond ITextSelection's, the same for both -- they work through the
+ * object's own ITextRange methods. Office's text boxes (Word's start screen)
+ * read and replace their text through these; the rest are not there yet. */
+static HRESULT WINAPI textrange2_GetCch( ITextRange2 *iface, LONG *count )
+{
+    ITextRange *range = (ITextRange *)iface;
+    LONG start, end;
+    HRESULT hr;
+
+    TRACE( "(%p)->(%p)\n", iface, count );
+    if (!count) return E_INVALIDARG;
+    if (FAILED(hr = ITextRange_GetStart( range, &start )) || FAILED(hr = ITextRange_GetEnd( range, &end ))) return hr;
+    *count = end - start;
+    return S_OK;
+}
