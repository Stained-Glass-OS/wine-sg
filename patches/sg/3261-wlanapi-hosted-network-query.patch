From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 20:47:46 -0700
Subject: [PATCH] wlanapi: Hosted Network queries validate, then report the
 service as not active (3261)

WlanHostedNetworkQueryProperty, QuerySecondaryKey and QueryStatus
answered ERROR_CALL_NOT_IMPLEMENTED for everything. There is no Hosted
Network here, which the documentation gives as ERROR_SERVICE_NOT_ACTIVE
(the Wireless LAN AutoConfig service is not running); the checks that come
before it are now made: NULL handle, NULL out parameters and a reserved
pointer that is not NULL give ERROR_INVALID_PARAMETER, and an unknown
(or closed) handle gives ERROR_INVALID_HANDLE. Nothing touches a real
adapter.

diff --git a/dlls/wlanapi/main.c b/dlls/wlanapi/main.c
index c371266..23ac48c 100644
--- a/dlls/wlanapi/main.c
+++ b/dlls/wlanapi/main.c
@@ -173,31 +173,50 @@ DWORD WINAPI WlanQueryInterface(HANDLE handle, const GUID *guid, WLAN_INTF_OPCOD
     return ERROR_CALL_NOT_IMPLEMENTED;
 }
 
+/* There is no Hosted Network here: the Wireless LAN AutoConfig service that provides it is not running,
+ * which the documentation gives as ERROR_SERVICE_NOT_ACTIVE once the arguments and the handle are valid. */
+static DWORD hosted_network_check(HANDLE handle)
+{
+    if (!handle_index(handle))
+        return ERROR_INVALID_HANDLE;
+#ifdef SG_MUTANT_WLAN_HOSTED
+    return ERROR_CALL_NOT_IMPLEMENTED;
+#endif
+    return ERROR_SERVICE_NOT_ACTIVE;
+}
+
 DWORD WINAPI WlanHostedNetworkQueryProperty(HANDLE handle, WLAN_HOSTED_NETWORK_OPCODE opcode,
                                             DWORD *data_size, void **data,
                                             WLAN_OPCODE_VALUE_TYPE *opcode_type, void *reserved)
 {
-    FIXME("(%p, 0x%x, %p, %p, %p, %p) stub\n",
-          handle, opcode, data_size, data, opcode_type, reserved);
+    TRACE("(%p, 0x%x, %p, %p, %p, %p)\n", handle, opcode, data_size, data, opcode_type, reserved);
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!handle || !data_size || !data || !opcode_type || reserved)
+        return ERROR_INVALID_PARAMETER;
+
+    return hosted_network_check(handle);
 }
 
 DWORD WINAPI WlanHostedNetworkQuerySecondaryKey(HANDLE handle, DWORD *key_size, unsigned char *key,
                                                 BOOL *passphrase, BOOL *persistent,
                                                 WLAN_HOSTED_NETWORK_REASON *error, void *reserved)
 {
-    FIXME("(%p, %p, %p, %p, %p, %p, %p) stub\n",
-          handle, key_size, key, passphrase, persistent, error, reserved);
+    TRACE("(%p, %p, %p, %p, %p, %p, %p)\n", handle, key_size, key, passphrase, persistent, error, reserved);
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!handle || !key_size || !key || !passphrase || !persistent || reserved)
+        return ERROR_INVALID_PARAMETER;
+
+    return hosted_network_check(handle);
 }
 
 DWORD WINAPI WlanHostedNetworkQueryStatus(HANDLE handle, WLAN_HOSTED_NETWORK_STATUS *status, void *reserved)
 {
-    FIXME("(%p, %p, %p) stub\n", handle, status, reserved);
+    TRACE("(%p, %p, %p)\n", handle, status, reserved);
 
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    if (!handle || !status || reserved)
+        return ERROR_INVALID_PARAMETER;
+
+    return hosted_network_check(handle);
 }
 
 void WINAPI WlanFreeMemory(void *ptr)
