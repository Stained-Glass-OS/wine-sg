From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] mf: File URLs open (9420)

The file scheme handler cut "file://" off a URL and took the rest for a
path: file:///C:/... became "/C:/...", with %20 for each space, which no
file is. Players and the media engine handed a file URL (a .NET or WinRT
Uri's) failed to open it. A file URL is now the path it names
(PathCreateFromUrl: percent escapes, file://server/share as a UNC path);
a drive letter right after "file://" stays as before.
---
--- a/dlls/mf/scheme_handler.c
+++ b/dlls/mf/scheme_handler.c
@@ -18,12 +18,14 @@
 
 #include <stddef.h>
 #include <stdarg.h>
+#include <wctype.h>
 
 #define COBJMACROS
 #include "windef.h"
 #include "winbase.h"
 
 #include "evr.h"
+#include "shlwapi.h"
 #include "mfidl.h"
 #include "mf_private.h"
 
@@ -454,10 +456,30 @@
 
 static HRESULT file_stream_create(const WCHAR *url, DWORD flags, IMFByteStream **out)
 {
-    if (!wcsnicmp(url, L"file://", 7))
+    WCHAR *path = NULL;
+    DWORD len;
+    HRESULT hr;
+
+    /* Stained Glass OS (wine-sg 9420): a file URL is the path it names, as a URL's
+     * rules have it: file:///C:/My%20Videos/a.mp4 is C:\My Videos\a.mp4,
+     * file://server/share/a.mp4 \\server\share\a.mp4. Only "file://" was cut
+     * off, leaving "/C:/My%20Videos/a.mp4", which no file is: media players and the
+     * media engine given a file URL (a .NET or WinRT Uri's) failed to open it. A
+     * drive letter right after "file://" (file://C:/a.mp4) stays as before. */
+#ifndef SG_MUTANT_FILEURL_CUT_ONLY
+    if (!wcsnicmp(url, L"file:", 5) && !(!wcsnicmp(url, L"file://", 7) && iswalpha(url[7]) && url[8] == ':'))
+    {
+        len = wcslen(url) + 1;
+        if ((path = malloc(len * sizeof(WCHAR))) && PathCreateFromUrlW(url, path, &len, 0) == S_OK)
+            url = path;
+    }
+#endif
+    if (url != path && !wcsnicmp(url, L"file://", 7))
         url += 7;
-    return MFCreateFile(flags & MF_RESOLUTION_WRITE ? MF_ACCESSMODE_READWRITE : MF_ACCESSMODE_READ,
+    hr = MFCreateFile(flags & MF_RESOLUTION_WRITE ? MF_ACCESSMODE_READWRITE : MF_ACCESSMODE_READ,
             MF_OPENMODE_FAIL_IF_NOT_EXIST, MF_FILEFLAGS_NONE, url, out);
+    free(path);
+    return hr;
 }
 
 HRESULT file_scheme_handler_construct(REFIID riid, void **obj)
--- a/dlls/mf/Makefile.in
+++ b/dlls/mf/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = mf.dll
 IMPORTLIB = mf
 IMPORTS   = advapi32 mfplat ole32 propsys uuid mfuuid strmiids
-DELAYIMPORTS = evr urlmon user32
+DELAYIMPORTS = evr urlmon user32 shlwapi
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
