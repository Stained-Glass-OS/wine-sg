+/***********************************************************************
+ *           package_key_string
+ *
+ * A REG_SZ or REG_MULTI_SZ value of a deployed package's record, allocated.
+ */
+static WCHAR *package_key_string( HANDLE key, const WCHAR *name, ULONG type )
+{
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UNICODE_STRING str;
+    ULONG size = 0;
+    WCHAR *ret;
+
+    RtlInitUnicodeString( &str, name );
+    if (NtQueryValueKey( key, &str, KeyValuePartialInformation, NULL, 0, &size ) != STATUS_BUFFER_TOO_SMALL ||
+        size > 65536)
+        return NULL;
+    if (!(info = RtlAllocateHeap( GetProcessHeap(), 0, size + 2 * sizeof(WCHAR) ))) return NULL;
+    if (NtQueryValueKey( key, &str, KeyValuePartialInformation, info, size, &size ) || info->Type != type)
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, info );
+        return NULL;
+    }
+    /* the data, NUL-terminated twice, at the start of the block */
+    size = info->DataLength / sizeof(WCHAR);
+    ret = (WCHAR *)info;
+    memmove( ret, info->Data, size * sizeof(WCHAR) );
+    ret[size] = 0;
+    ret[size + 1] = 0;
+    return ret;
+}
+
+/***********************************************************************
+ *           add_package_graph
+ *
+ * A packaged process (its executable is inside a package deployed for the
+ * user: appxdeploymentclient's HKCU\Software\Wine\AppModel\Packages\<full
+ * name> records) loads DLLs from the frameworks it depends on, as on
+ * Windows: their install locations go at the front of the process's PATH,
+ * before the imports are resolved. The record's Dependencies value lists
+ * them.
+ */
+static void add_package_graph( const UNICODE_STRING *image )
+{
+    static const WCHAR packagesW[] = L"Software\\Wine\\AppModel\\Packages";
+    UNICODE_STRING name, path_name = RTL_CONSTANT_STRING( L"PATH" ), value;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE user, root, key;
+    char buffer[sizeof(KEY_BASIC_INFORMATION) + 256 * sizeof(WCHAR)];
+    KEY_BASIC_INFORMATION *info = (KEY_BASIC_INFORMATION *)buffer;
+    WCHAR *deps = NULL, *location, *graph = NULL, *p, *new_path;
+    ULONG index = 0, size, graph_len = 0, len;
+
+    if (!image->Length || RtlOpenCurrentUser( KEY_READ, &user )) return;
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, user, NULL );
+    RtlInitUnicodeString( &name, packagesW );
+    if (NtOpenKey( &root, KEY_READ, &attr ))
+    {
+        NtClose( user );
+        return;
+    }
+    /* whose package is this executable in */
+    while (!deps && !NtEnumerateKey( root, index++, KeyBasicInformation, buffer, sizeof(buffer) - sizeof(WCHAR), &size ))
+    {
+        name.Buffer = info->Name;
+        name.Length = name.MaximumLength = info->NameLength;
+        InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, root, NULL );
+        if (NtOpenKey( &key, KEY_QUERY_VALUE, &attr )) continue;
+        if ((location = package_key_string( key, L"InstallLocation", REG_SZ )))
+        {
+            len = wcslen( location );
+            if (len && image->Length / sizeof(WCHAR) > len && !wcsnicmp( image->Buffer, location, len ) &&
+                image->Buffer[len] == '\\')
+            {
+                if (!(deps = package_key_string( key, L"Dependencies", REG_MULTI_SZ )))
+                {
+                    RtlFreeHeap( GetProcessHeap(), 0, location );
+                    NtClose( key );
+                    break;
+                }
+            }
+            RtlFreeHeap( GetProcessHeap(), 0, location );
+        }
+        NtClose( key );
+    }
+    /* the frameworks' folders */
+    for (p = deps; p && *p; p += wcslen( p ) + 1)
+    {
+        RtlInitUnicodeString( &name, p );
+        InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, root, NULL );
+        if (wcschr( p, '\\' ) || NtOpenKey( &key, KEY_QUERY_VALUE, &attr )) continue;
+        if ((location = package_key_string( key, L"InstallLocation", REG_SZ )))
+        {
+            WCHAR *grown;
+            len = wcslen( location );
+            if (graph) grown = RtlReAllocateHeap( GetProcessHeap(), 0, graph, (graph_len + len + 2) * sizeof(WCHAR) );
+            else grown = RtlAllocateHeap( GetProcessHeap(), 0, (len + 2) * sizeof(WCHAR) );
+            if (grown)
+            {
+                graph = grown;
+                memcpy( graph + graph_len, location, len * sizeof(WCHAR) );
+                graph_len += len;
+                graph[graph_len++] = ';';
+                graph[graph_len] = 0;
+            }
+            RtlFreeHeap( GetProcessHeap(), 0, location );
+        }
+        NtClose( key );
+    }
+    NtClose( root );
+    NtClose( user );
+    RtlFreeHeap( GetProcessHeap(), 0, deps );
+    if (!graph) return;
+
+    value.Length = value.MaximumLength = 0;
+    value.Buffer = NULL;
+    size = 0;
+    if (RtlQueryEnvironmentVariable_U( NULL, &path_name, &value ) == STATUS_BUFFER_TOO_SMALL) size = value.Length;
+    if ((new_path = RtlAllocateHeap( GetProcessHeap(), 0, (graph_len + 1) * sizeof(WCHAR) + size + sizeof(WCHAR) )))
+    {
+        memcpy( new_path, graph, graph_len * sizeof(WCHAR) );
+        value.Buffer = new_path + graph_len;
+        value.MaximumLength = size + sizeof(WCHAR);
+        value.Length = 0;
+        if (size) RtlQueryEnvironmentVariable_U( NULL, &path_name, &value );
+        new_path[graph_len + value.Length / sizeof(WCHAR)] = 0;
+        RtlInitUnicodeString( &value, new_path );
+        RtlSetEnvironmentVariable( NULL, &path_name, &value );
+        TRACE( "package graph: PATH=%s\n", debugstr_w( new_path ) );
+        RtlFreeHeap( GetProcessHeap(), 0, new_path );
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, graph );
+}
+
