 /***********************************************************************
  *         GetCurrentPackageInfo   (kernelbase.@)
  */
+/* The current package's graph: the package itself, then the frameworks it
+ * depends on (its record's Dependencies, which ntdll also puts on the DLL
+ * path). The buffer holds the PACKAGE_INFO array, then their strings. */
 LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
 {
-    FIXME( "(%#x %p %p %p): stub\n", flags, buffer_size, buffer, count );
-    return APPMODEL_ERROR_NO_PACKAGE;
+    WCHAR key[MAX_PATH], deps[4096], *names[32], *p;
+    UINT32 props[32], n = 0, i, size, len, family_len, id_len;
+    const WCHAR *head = current_package();
+    BOOL all = !(flags & (PACKAGE_FILTER_HEAD | PACKAGE_FILTER_DIRECT));
+    DWORD bytes, value;
+    BYTE *strings;
+
+    TRACE( "(%#x %p %p %p)\n", flags, buffer_size, buffer, count );
+
+    if (!head) return APPMODEL_ERROR_NO_PACKAGE;
+    if (!buffer_size) return ERROR_INVALID_PARAMETER;
+
+    swprintf( key, ARRAY_SIZE(key), L"%s\\%s", deployed_packagesW, head );
+    if (all || (flags & PACKAGE_FILTER_HEAD))
+    {
+        names[n] = (WCHAR *)head;
+        props[n] = 0;
+        bytes = sizeof(value);
+        if (!RegGetValueW( HKEY_CURRENT_USER, key, L"DevelopmentMode", RRF_RT_REG_DWORD, NULL, &value, &bytes ) && value)
+            props[n] |= PACKAGE_PROPERTY_DEVELOPMENT_MODE;
+        n++;
+    }
+    bytes = sizeof(deps) - 2 * sizeof(WCHAR);
+    memset( deps, 0, sizeof(deps) );
+    if ((all || (flags & PACKAGE_FILTER_DIRECT)) &&
+        !RegGetValueW( HKEY_CURRENT_USER, key, L"Dependencies", RRF_RT_REG_MULTI_SZ, NULL, deps, &bytes ))
+    {
+        for (p = deps; *p && n < ARRAY_SIZE(names); p += wcslen( p ) + 1)
+        {
+            names[n] = p;
+            props[n++] = PACKAGE_PROPERTY_FRAMEWORK | PACKAGE_PROPERTY_STATIC;
+        }
+    }
+
+    /* the size: the array, then each one's path, full name, family name and id */
+    size = n * sizeof(PACKAGE_INFO);
+    for (i = 0; i < n; i++)
+    {
+        WCHAR location[MAX_PATH];
+        if (!package_location( names[i], location, ARRAY_SIZE(location) )) location[0] = 0;
+        family_len = 0;
+        PackageFamilyNameFromFullName( names[i], &family_len, NULL );
+        id_len = 0;
+        PackageIdFromFullName( names[i], 0, &id_len, NULL );
+        size += (wcslen( location ) + 1 + wcslen( names[i] ) + 1 + family_len) * sizeof(WCHAR);
+        size = (size + 7) & ~7;
+        size += id_len;
+        size = (size + 7) & ~7;
+    }
+    if (count) *count = n;
+    if (!buffer || *buffer_size < size)
+    {
+        *buffer_size = size;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    *buffer_size = size;
+    strings = buffer + n * sizeof(PACKAGE_INFO);
+    for (i = 0; i < n; i++)
+    {
+        PACKAGE_INFO *info = (PACKAGE_INFO *)buffer + i;
+        WCHAR location[MAX_PATH];
+
+        if (!package_location( names[i], location, ARRAY_SIZE(location) )) location[0] = 0;
+        memset( info, 0, sizeof(*info) );
+        info->flags = props[i];
+        info->path = (WCHAR *)strings;
+        wcscpy( info->path, location );
+        strings += (wcslen( location ) + 1) * sizeof(WCHAR);
+        info->packageFullName = (WCHAR *)strings;
+        wcscpy( info->packageFullName, names[i] );
+        strings += (wcslen( names[i] ) + 1) * sizeof(WCHAR);
+        info->packageFamilyName = (WCHAR *)strings;
+        family_len = 256;
+        PackageFamilyNameFromFullName( names[i], &family_len, info->packageFamilyName );
+        strings += family_len * sizeof(WCHAR);
+        strings = buffer + ((strings - buffer + 7) & ~7);
+        id_len = size - (strings - buffer);
+        if (!PackageIdFromFullName( names[i], 0, &id_len, strings ))
+        {
+            info->packageId = *(PACKAGE_ID *)strings;
+            strings += id_len;
+        }
+        len = strings - buffer;
+        strings = buffer + ((len + 7) & ~7);
+    }
+    return ERROR_SUCCESS;
 }
 
