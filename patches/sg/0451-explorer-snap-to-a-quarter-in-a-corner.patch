+static void snap_rect( const RECT *work, int side, RECT *rc )
+{
+    int midx = (work->left + work->right) / 2, midy = (work->top + work->bottom) / 2;
+    *rc = *work;
+    if (side == -1 || side == SNAP_TL || side == SNAP_BL) rc->right = midx;
+    if (side == 1 || side == SNAP_TR || side == SNAP_BR) rc->left = midx;
+    if (side == SNAP_TL || side == SNAP_TR) rc->bottom = midy;
+    if (side == SNAP_BL || side == SNAP_BR) rc->top = midy;
+}
+
+/* put HWND on SIDE of its work area (a half or a quarter), remembering where
+ * it was the first time */
+static void snap_to( HWND hwnd, struct snap *s, int side )
+{
+    RECT work, rc;
+    if (!s->side)
+    {
+        if (IsZoomed( hwnd ) || IsIconic( hwnd )) ShowWindow( hwnd, SW_RESTORE );
+        GetWindowRect( hwnd, &s->restore );
+    }
+    work_area( hwnd, &work );
+    snap_rect( &work, side, &rc );
+    SetWindowPos( hwnd, 0, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER );
+    s->side = side;
+}
