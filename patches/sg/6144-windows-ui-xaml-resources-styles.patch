+/* markup's TargetType="Name" (resolved to a full name by the writer), and its implicit key */
+BOOL xaml_style_markup_target( IInspectable *obj, const WCHAR *full_name )
+{
+    struct style *style = style_from_inspectable( obj );
+
+    if (!style) return FALSE;
