+/* ---- lookup ---- */
+
+static struct resdict *system_resources;
+
+/* the desktop's own theme resources, by the names programs use */
+static void system_brush( struct resdict *dict, const WCHAR *key, struct xcolor color )
+{
+    IInspectable *brush = xaml_solid_brush( color );
+    if (brush)
+    {
+        dict_insert( dict, key, brush );
+        IInspectable_Release( brush );
+    }
+}
+
+static struct xcolor alpha( struct xcolor c, BYTE a ) { c.a = a; return c; }
+
+static BOOL rounded_look(void)
+{
+    DWORD value = 0, size = sizeof(value);
+
+    /* the desktop's look: Rounded (Stained Glass OS's Rounded style) or Classic */
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\StainedGlass\\Look", L"Rounded", RRF_RT_REG_DWORD, NULL, &value, &size );
+    return value != 0;
+}
+
+static BOOL WINAPI init_system_resources( INIT_ONCE *once, void *param, void **context )
+{
+    struct xcolor text = xaml_theme_color( XTHEME_TEXT ), back = xaml_theme_color( XTHEME_BACKGROUND );
+    struct xcolor control = xaml_theme_color( XTHEME_CONTROL ), border = xaml_theme_color( XTHEME_BORDER );
+    struct xcolor accent = xaml_theme_color( XTHEME_ACCENT ), disabled = xaml_theme_color( XTHEME_DISABLED_TEXT );
+    struct xcorner corner = { 0 };
+    struct xthickness one = { 1, 1, 1, 1 };
+    IInspectable *box;
+
+    if (!(system_resources = new_dict( NULL ))) return TRUE;
+    system_brush( system_resources, L"TextFillColorPrimaryBrush", text );
+    system_brush( system_resources, L"TextFillColorSecondaryBrush", alpha( text, 0xc8 ) );
+    system_brush( system_resources, L"TextFillColorTertiaryBrush", alpha( text, 0x8b ) );
+    system_brush( system_resources, L"TextFillColorDisabledBrush", disabled );
+    system_brush( system_resources, L"SystemControlForegroundBaseHighBrush", text );
+    system_brush( system_resources, L"SystemControlForegroundBaseMediumBrush", alpha( text, 0x99 ) );
+    system_brush( system_resources, L"ApplicationForegroundThemeBrush", text );
+    system_brush( system_resources, L"ApplicationPageBackgroundThemeBrush", back );
+    system_brush( system_resources, L"SolidBackgroundFillColorBaseBrush", back );
+    system_brush( system_resources, L"LayerFillColorDefaultBrush", back );
+    system_brush( system_resources, L"CardBackgroundFillColorDefaultBrush", control );
+    system_brush( system_resources, L"ControlFillColorDefaultBrush", control );
+    system_brush( system_resources, L"ControlFillColorSecondaryBrush", control );
+    system_brush( system_resources, L"ControlStrokeColorDefaultBrush", border );
+    system_brush( system_resources, L"ControlStrokeColorSecondaryBrush", border );
+    system_brush( system_resources, L"DividerStrokeColorDefaultBrush", border );
+    system_brush( system_resources, L"CardStrokeColorDefaultBrush", border );
+    system_brush( system_resources, L"SubtleFillColorTransparentBrush", alpha( control, 0 ) );
+    system_brush( system_resources, L"AccentFillColorDefaultBrush", accent );
+    system_brush( system_resources, L"SystemControlHighlightAccentBrush", accent );
+    system_brush( system_resources, L"TextControlForeground", text );
+    system_brush( system_resources, L"TextControlBackground", back );
+    system_brush( system_resources, L"TextControlBorderBrush", border );
+    system_brush( system_resources, L"TextControlHeaderForeground", text );
+    system_brush( system_resources, L"ButtonBackground", control );
+    system_brush( system_resources, L"ButtonForeground", xaml_theme_color( XTHEME_CONTROL_TEXT ) );
+    system_brush( system_resources, L"ButtonBorderBrush", border );
+    if (rounded_look()) corner.top_left = corner.top_right = corner.bottom_right = corner.bottom_left = 4;
+    if ((box = xbox_ref( &IID_IReference_CornerRadius, &corner, sizeof(corner) )))
+    {
+        dict_insert( system_resources, L"ControlCornerRadius", box );
+        dict_insert( system_resources, L"OverlayCornerRadius", box );
+        IInspectable_Release( box );
+    }
+    if ((box = xbox_ref( &IID_IReference_Thickness, &one, sizeof(one) )))
+    {
+        dict_insert( system_resources, L"TextControlBorderThemeThickness", box );
+        IInspectable_Release( box );
+    }
+    if ((box = xbox_double( 14 ))) { dict_insert( system_resources, L"ControlContentThemeFontSize", box ); IInspectable_Release( box ); }
+    if ((box = xbox_double( 32 ))) { dict_insert( system_resources, L"TextControlThemeMinHeight", box ); IInspectable_Release( box ); }
+    if ((box = xbox_double( 64 ))) { dict_insert( system_resources, L"TextControlThemeMinWidth", box ); IInspectable_Release( box ); }
+    if ((box = xaml_font_family( L"XamlAutoFontFamily" )))
+    {
+        dict_insert( system_resources, L"ContentControlThemeFontFamily", box );
+        IInspectable_Release( box );
+    }
+    return TRUE;
+}
+
+static IInspectable *system_lookup( const WCHAR *key )
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_system_resources, NULL, NULL );
+    return dict_lookup( system_resources, key, 0 );
+}
+
+/* an element's Resources (FrameworkElement.Resources), made when asked for */
+static IInspectable *element_resources( struct uielem *elem, BOOL create )
+{
+    if (!elem->resources && create)
+    {
+        struct resdict *dict = new_dict( NULL );
+        if (dict) elem->resources = (IInspectable *)&dict->IResourceDictionary_iface;
+    }
+    return elem->resources;
+}
+
+IInspectable *xaml_element_resources( struct uielem *elem )
+{
+    return element_resources( elem, TRUE );
+}
+
+/* a resource by key, from an element (or NULL) up, then the application's, then the desktop's (no reference) */
+IInspectable *xaml_find_resource( struct uielem *elem, IInspectable *const *scope, unsigned int scope_count, const WCHAR *key )
+{
+    IInspectable *app, *app_resources = NULL, *value;
+    unsigned int i;
+
+    for (i = scope_count; i > 0; i--)
+    {
+        struct uielem *e = uielem_from_inspectable( scope[i - 1] );
+        IInspectable *app_iface;
+        struct resdict *dict = dict_from_inspectable( scope[i - 1] );
+
+        if (!dict && e && e->resources) dict = dict_from_inspectable( e->resources );
+        if (!dict && SUCCEEDED(IInspectable_QueryInterface( scope[i - 1], &IID_IApplication, (void **)&app_iface )))
+        {
+            IInspectable_Release( app_iface );
+            dict = dict_from_inspectable( xaml_application_resources( scope[i - 1] ) );
+        }
+        if ((value = dict_lookup( dict, key, 0 ))) return value;
+    }
+    for (; elem; elem = elem->parent)
+        if (elem->resources && (value = dict_lookup( dict_from_inspectable( elem->resources ), key, 0 ))) return value;
+    if ((app = xaml_current_application()))
+    {
+        app_resources = xaml_application_resources( app );
+        IInspectable_Release( app );
+        if ((value = dict_lookup( dict_from_inspectable( app_resources ), key, 0 ))) return value;
+    }
+    if ((value = system_lookup( key ))) return value;
+    return NULL;
+}
+
+/* the implicit style for an element: a style keyed by its type, ours or the application's */
+void xaml_apply_implicit_style( struct uielem *elem )
+{
+    HSTRING name = NULL;
+    IInspectable *style;
+    WCHAR key[300];
+
+    if (elem->style_applied) return;
+    elem->style_applied = TRUE;
+    if (FAILED(IUnknown_QueryInterface( elem->d.obj.outer, &IID_IInspectable, (void **)&style ))) return;
+    IInspectable_GetRuntimeClassName( style, &name );
+    IInspectable_Release( style );
+    if (!name) return;
+    swprintf( key, ARRAY_SIZE(key), L"#type:%s", WindowsGetStringRawBuffer( name, NULL ) );
+    WindowsDeleteString( name );
+    if ((style = xaml_find_resource( elem, NULL, 0, key )))
+    {
+        TRACE( "%p: implicit style %s\n", elem, debugstr_w( key ) );
+        apply_style( style_from_inspectable( style ), &elem->d, 0 );
+        uielem_invalidate_measure( elem );
+    }
+}
