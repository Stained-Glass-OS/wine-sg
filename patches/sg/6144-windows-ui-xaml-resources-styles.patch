+++ b/dlls/windows.ui.xaml/application.c
@@ -112,6 +112,7 @@ static HRESULT WINAPI app_get_Resources( struct xiface *iface, IInspectable **va
 
     TRACE( "%p, %p\n", app, value );
     if (!value) return E_POINTER;
+    if (!app->resources && app == current_app) xaml_application_resources( NULL );
     if ((*value = app->resources)) IInspectable_AddRef( *value );
     return S_OK;
 }
@@ -286,6 +287,34 @@ static HRESULT WINAPI app_statics_LoadComponent( struct xfiface *iface, IInspect
     return xaml_load_component( component, locator );
 }
 
+/* the application's Resources (made when first asked for), no reference */
+IInspectable *xaml_application_resources( IInspectable *app_iface )
+{
+    struct application *app;
+    IInspectable *dict = NULL;
+
+    EnterCriticalSection( &app_cs );
+    app = current_app;
+    LeaveCriticalSection( &app_cs );
+    if (!app) return NULL;
+    if (!app->resources)
+    {
+        IActivationFactory *factory;
+        if (SUCCEEDED(xaml_get_factory( L"Windows.UI.Xaml.ResourceDictionary", &factory )))
+        {
+            IInspectable *f = NULL, *inner = NULL;
+            if (SUCCEEDED(IActivationFactory_QueryInterface( factory, &IID_IResourceDictionaryFactory, (void **)&f )))
+            {
+                ((HRESULT (WINAPI *)( IInspectable *, IInspectable *, IInspectable **, IInspectable ** ))((void **)f->lpVtbl)[6])( f, NULL, &inner, &dict );
+                IInspectable_Release( f );
+            }
+            IActivationFactory_Release( factory );
+        }
+        app->resources = dict;
+    }
+    return app->resources;
+}
+
 /* the application object (its outer: the program's App), with a reference */
 IInspectable *xaml_current_application(void)
 {
