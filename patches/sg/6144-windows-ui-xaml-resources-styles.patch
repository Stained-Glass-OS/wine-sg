@@ -69,6 +69,16 @@ static void layout_changed( struct dobj *obj, struct xaml_property *prop, IInspe
     uielem_invalidate_measure( elem );
 }
 
+/* an explicit Style: its setters are the element's style values */
+static void style_changed( struct dobj *obj, struct xaml_property *prop, IInspectable *old_value, IInspectable *new_value )
+{
+    struct uielem *elem = elem_from_dobj( obj );
+
+    elem->style_applied = TRUE;
+    xaml_apply_style( new_value, obj );
+    uielem_invalidate_measure( elem );
+}
