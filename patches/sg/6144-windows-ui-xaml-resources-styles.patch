+WCHAR *xaml_style_implicit_key( IInspectable *obj )
+{
+    struct style *style = style_from_inspectable( obj );
+    WCHAR *key;
+
+    if (!style || !style->target_type) return NULL;
+    if ((key = malloc( (wcslen( style->target_type ) + 7) * sizeof(WCHAR) )))
+        swprintf( key, wcslen( style->target_type ) + 7, L"#type:%s", style->target_type );
+    return key;
+}
+
+/* the style's setters, its BasedOn's first, as style values of the element */
+static void apply_style( struct style *style, struct dobj *target, int depth )
+{
+    struct style *base;
+    UINT32 i;
+
+    if (!style || depth > 16) return;
+    if ((base = style_from_inspectable( style->based_on ))) apply_style( base, target, depth + 1 );
+#ifdef SG_MUTANT_STYLE_NO_SETTERS
+    return;
+#endif
+    for (i = 0; i < xvector_size( style->setters ); i++)
+    {
+        struct setter *setter = setter_from_inspectable( xvector_item( style->setters, i ) );
+        struct xaml_property *prop;
+        IInspectable *value = NULL;
+
+        if (!setter) continue;
+        if (!(prop = xaml_property_from_inspectable( setter->property )) &&
+            !(setter->property_name && (prop = xaml_find_member( target, setter->property_name ))))
+        {
+            if (setter->property_name) FIXME( "no property %s to style\n", debugstr_w( setter->property_name ) );
+            continue;
+        }
+        if (setter->value) IInspectable_AddRef( (value = setter->value) );
+        else if (setter->value_text && FAILED(xaml_value_from_string( prop->type, setter->value_text, &value ))) continue;
+        dobj_set_style_value( target, prop, value );
+        if (value) IInspectable_Release( value );
+    }
+}
+
+void xaml_apply_style( IInspectable *style, struct dobj *target )
+{
+    dobj_clear_style_values( target );
+    apply_style( style_from_inspectable( style ), target, 0 );
+}
