+/* markup's Setter Property="Name" Value="text": kept as text until the style is applied */
+BOOL xaml_setter_markup( IInspectable *obj, const WCHAR *name, const WCHAR *str, IInspectable *value )
+{
+    struct setter *setter = setter_from_inspectable( obj );
