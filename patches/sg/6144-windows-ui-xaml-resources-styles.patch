index c78d495..aa86364 100644
--- a/dlls/windows.ui.xaml/dependency.c
+++ b/dlls/windows.ui.xaml/dependency.c
@@ -472,6 +472,8 @@ struct dvalue
     struct xaml_property *prop;
     BOOL has_local;
     IInspectable *local;            /* set on the object (may be null) */
+    BOOL has_style;
+    IInspectable *style_value;      /* set by its style (may be null) */
     IInspectable *made_default;     /* by the metadata's CreateDefaultValueCallback */
 };
 
@@ -579,6 +581,7 @@ HRESULT dobj_get_value( struct dobj *obj, struct xaml_property *prop, IInspectab
 
     *result = NULL;
     if (value && value->has_local) ret = value->local;
+    else if (value && value->has_style) ret = value->style_value;
     else if (value && value->made_default) ret = value->made_default;
     else if (md && md->create_default)
     {
@@ -669,6 +672,45 @@ HRESULT dobj_set_value( struct dobj *obj, struct xaml_property *prop, IInspectab
     return set_local( obj, prop, TRUE, value );
 }
 
+/* a value from a style: below the local value */
+HRESULT dobj_set_style_value( struct dobj *obj, struct xaml_property *prop, IInspectable *new_value )
+{
+    IInspectable *old_value, *now;
+    struct dvalue *value;
+    HRESULT hr;
+
+    if (FAILED(hr = dobj_get_value( obj, prop, &old_value ))) return hr;
+    if (!(value = find_value( obj, prop, TRUE )))
+    {
+        if (old_value) IInspectable_Release( old_value );
+        return E_OUTOFMEMORY;
+    }
+    if (new_value) IInspectable_AddRef( new_value );
+    if (value->style_value) IInspectable_Release( value->style_value );
+    value->style_value = new_value;
+    value->has_style = TRUE;
+    if (SUCCEEDED(dobj_get_value( obj, prop, &now )))
+    {
+        if (!values_equal( old_value, now )) notify_changed( obj, prop, old_value, now );
+        if (now) IInspectable_Release( now );
+    }
+    if (old_value) IInspectable_Release( old_value );
+    return S_OK;
+}
+
+void dobj_clear_style_values( struct dobj *obj )
+{
+    struct dvalue *value;
+
+    LIST_FOR_EACH_ENTRY( value, &obj->values, struct dvalue, entry )
+    {
+        if (!value->has_style) continue;
+        if (value->style_value) IInspectable_Release( value->style_value );
+        value->style_value = NULL;
+        value->has_style = FALSE;
+    }
+}
+
 BOOL dobj_has_local( struct dobj *obj, struct xaml_property *prop )
 {
     struct dvalue *value = find_value( obj, prop, FALSE );
@@ -808,6 +850,7 @@ void dobj_cleanup( struct dobj *obj )
     {
         list_remove( &value->entry );
         if (value->local) IInspectable_Release( value->local );
+        if (value->style_value) IInspectable_Release( value->style_value );
         if (value->made_default) IInspectable_Release( value->made_default );
         free( value );
     }
diff --git a/dlls/windows.ui.xaml/element.c b/dlls/windows.ui.xaml/element.c
