+
+/*
+ * A resource is found by its key in the dictionaries from an element up its parents
+ * (FrameworkElement.Resources), then the application's (Application.Resources), each with its merged
+ * dictionaries (last first) and its theme dictionary for the current theme; last come the desktop's
+ * own theme resources -- the brushes, sizes and corner radii programs ask for by their usual names,
+ * made from the desktop's look (its system colours; Classic square, Rounded rounded), not Microsoft's.
+ * A Style sets values below an element's own (local) values; an element without a Style gets the
+ * implicit one for its type (a style keyed by its TargetType).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include "private.h"
+#include "winuser.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const GUID IID_IMap_Object = { 0xf5f69427, 0x55ed, 0x5512, { 0x84, 0x29, 0xd4, 0xf6, 0x62, 0x6d, 0xfc, 0xdd } };
+static const GUID IID_IVector_ResourceDictionary = { 0xfe820a0c, 0x694d, 0x518b, { 0x8e, 0xc5, 0x37, 0x29, 0x93, 0xf6, 0xce, 0xaf } };
+static const GUID IID_IVectorView_ResourceDictionary = { 0x36ce8ed8, 0xc1a9, 0x55b7, { 0x86, 0xdc, 0xb4, 0x1b, 0x8e, 0xd8, 0xed, 0xf4 } };
+static const GUID IID_IIterable_ResourceDictionary = { 0xeaf20635, 0xa462, 0x5397, { 0xbe, 0xe1, 0xf7, 0xa0, 0x95, 0x04, 0x65, 0x3b } };
+static const GUID IID_IIterator_ResourceDictionary = { 0x849a2f3a, 0x2e5e, 0x58a8, { 0xb7, 0x6e, 0x73, 0x45, 0x0e, 0xa6, 0x80, 0xc0 } };
+static const GUID IID_IVector_SetterBase = { 0xbd55a7fd, 0x7501, 0x5519, { 0x9f, 0xfb, 0xd0, 0x07, 0x42, 0x40, 0xdb, 0x61 } };
+static const GUID IID_IVectorView_SetterBase = { 0x88eef29a, 0x842b, 0x55c2, { 0xa9, 0x36, 0x2b, 0x9d, 0x75, 0xe9, 0x23, 0xe5 } };
+static const GUID IID_IIterable_SetterBase = { 0xaafe70cb, 0x90a8, 0x5719, { 0xbd, 0x3e, 0xf0, 0xb0, 0x66, 0xed, 0x16, 0x26 } };
+static const GUID IID_IIterator_SetterBase = { 0x3198322e, 0x2527, 0x58d1, { 0x8d, 0x92, 0x9d, 0x22, 0xb9, 0x77, 0xd2, 0x55 } };
+
+/* ---- keys ---- */
+
+/* a key as text: a string key, or "#type:<full name>" for a style's TargetType (an implicit style) */
+WCHAR *xaml_resource_key( IInspectable *key )
+{
+    struct xaml_type_name tn;
+    WCHAR *str, *ret;
+
+    if (!key) return NULL;
+    if ((str = xunbox_string( key ))) return str;
+    if (xunbox_ref( key, &IID_IReference_TypeName, &tn, sizeof(tn) ))
+    {
+        const WCHAR *name = WindowsGetStringRawBuffer( tn.Name, NULL );
+        if (!name) return NULL;
+        if ((ret = malloc( (wcslen( name ) + 7) * sizeof(WCHAR) ))) swprintf( ret, wcslen( name ) + 7, L"#type:%s", name );
+        return ret;
+    }
+    return NULL;
+}
+
+/* ---- ResourceDictionary ---- */
+
+struct resource
+{
+    struct list entry;
+    WCHAR *key;
+    IInspectable *value;
+};
+
+struct resdict
+{
+    struct dobj d;
+    struct xiface IResourceDictionary_iface;
+    struct xiface IMap_iface;
+    struct list entries;
+    struct xvector *merged;
+    struct resdict *themes;         /* ThemeDictionaries: "Light", "Dark", "Default", "HighContrast" */
+    IInspectable *source;
+};
+
+static struct resdict *dict_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct resdict, d.obj );
+}
+
+static struct resource *find_entry( struct resdict *dict, const WCHAR *key )
+{
+    struct resource *res;
+
+    LIST_FOR_EACH_ENTRY( res, &dict->entries, struct resource, entry )
+        if (!wcscmp( res->key, key )) return res;
+    return NULL;
+}
+
+static struct resdict *dict_from_inspectable( IInspectable *iface );
+
+/* a key's value in a dictionary, its merged ones and its theme dictionary (no reference) */
+static IInspectable *dict_lookup( struct resdict *dict, const WCHAR *key, int depth )
+{
+    struct resource *res;
+    IInspectable *value;
+    INT32 i;
+
+    if (!dict || depth > 16) return NULL;
+    if ((res = find_entry( dict, key ))) return res->value;
+    for (i = (INT32)xvector_size( dict->merged ) - 1; i >= 0; i--)
+        if ((value = dict_lookup( dict_from_inspectable( xvector_item( dict->merged, i ) ), key, depth + 1 ))) return value;
+    if (dict->themes)
+    {
+        const WCHAR *theme = system_app_theme() ? L"Dark" : L"Light";
+        struct resource *t = find_entry( dict->themes, theme );
+        if (!t) t = find_entry( dict->themes, L"Default" );
+        if (t && (value = dict_lookup( dict_from_inspectable( t->value ), key, depth + 1 ))) return value;
+    }
+    return NULL;
+}
+
+static HRESULT dict_insert( struct resdict *dict, const WCHAR *key, IInspectable *value )
+{
+    struct resource *res;
+
+    if ((res = find_entry( dict, key )))
+    {
+        if (value) IInspectable_AddRef( value );
+        if (res->value) IInspectable_Release( res->value );
+        res->value = value;
+        return S_OK;
+    }
+    if (!(res = calloc( 1, sizeof(*res) )) || !(res->key = wcsdup( key )))
+    {
+        free( res );
+        return E_OUTOFMEMORY;
+    }
+    if ((res->value = value)) IInspectable_AddRef( value );
+    list_add_tail( &dict->entries, &res->entry );
+    return S_OK;
+}
+
+static HRESULT merged_added( void *owner, IInspectable *item )
+{
+    return dict_from_inspectable( item ) ? S_OK : E_INVALIDARG;
+}
+
+static const struct xvector_type merged_type =
+{
+    L"Windows.Foundation.Collections.IVector`1<Windows.UI.Xaml.ResourceDictionary>",
+    &IID_IVector_ResourceDictionary, &IID_IVectorView_ResourceDictionary, &IID_IIterable_ResourceDictionary,
+    &IID_IIterator_ResourceDictionary, &IID_IResourceDictionary, NULL, merged_added, NULL, NULL,
+};
+
+static HRESULT WINAPI dict_get_Source( struct xiface *iface, IInspectable **value )
+{
+    struct resdict *dict = dict_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if ((*value = dict->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI dict_put_Source( struct xiface *iface, IInspectable *value )
+{
+    struct resdict *dict = dict_from_iface( iface );
+
+    FIXME( "%p: a dictionary's Source is not loaded yet\n", dict );
+    if (value) IInspectable_AddRef( value );
+    if (dict->source) IInspectable_Release( dict->source );
+    dict->source = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI dict_get_MergedDictionaries( struct xiface *iface, IInspectable **value )
+{
+    struct resdict *dict = dict_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    IInspectable_AddRef( (*value = xvector_iface( dict->merged )) );
+    return S_OK;
+}
+
+static struct resdict *new_dict( IInspectable *outer );
+
+static HRESULT WINAPI dict_get_ThemeDictionaries( struct xiface *iface, IInspectable **value )
+{
+    struct resdict *dict = dict_from_iface( iface );
+
+    if (!value) return E_POINTER;
+    if (!dict->themes && !(dict->themes = new_dict( NULL ))) return E_OUTOFMEMORY;
+    IInspectable_AddRef( (*value = (IInspectable *)&dict->themes->IMap_iface) );
+    return S_OK;
+}
+
+static const void *dict_vtbl[] =
+{
+    IResourceDictionary_STUBS,
+    [IResourceDictionary_Source] = dict_get_Source,
+    [IResourceDictionary_SetSource] = dict_put_Source,
+    [IResourceDictionary_MergedDictionaries] = dict_get_MergedDictionaries,
+    [IResourceDictionary_ThemeDictionaries] = dict_get_ThemeDictionaries,
+};
+
+/* IMap<Object, Object>: Lookup, Size, HasKey, GetView, Insert, Remove, Clear */
+static HRESULT WINAPI map_Lookup( struct xiface *iface, IInspectable *key, IInspectable **value )
+{
+    WCHAR *str = xaml_resource_key( key );
+    IInspectable *found;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!str) return E_INVALIDARG;
+    found = dict_lookup( dict_from_iface( iface ), str, 0 );
+    free( str );
+    if (!found) return E_BOUNDS;
+    IInspectable_AddRef( (*value = found) );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_get_Size( struct xiface *iface, UINT32 *size )
+{
+    if (!size) return E_POINTER;
+    *size = list_count( &dict_from_iface( iface )->entries );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_HasKey( struct xiface *iface, IInspectable *key, boolean *found )
+{
+    WCHAR *str = xaml_resource_key( key );
+
+    if (!found) return E_POINTER;
+    *found = str && dict_lookup( dict_from_iface( iface ), str, 0 ) != NULL;
+    free( str );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_GetView( struct xiface *iface, IInspectable **view )
+{
+    FIXME( "%p: no view of a dictionary yet\n", iface );
+    if (view) *view = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI map_Insert( struct xiface *iface, IInspectable *key, IInspectable *value, boolean *replaced )
+{
+    struct resdict *dict = dict_from_iface( iface );
+    WCHAR *str = xaml_resource_key( key );
+    HRESULT hr;
+
+    if (!str) return E_INVALIDARG;
+    if (replaced) *replaced = find_entry( dict, str ) != NULL;
+    hr = dict_insert( dict, str, value );
+    free( str );
+    return hr;
+}
+
+static HRESULT WINAPI map_Remove( struct xiface *iface, IInspectable *key )
+{
+    struct resdict *dict = dict_from_iface( iface );
+    WCHAR *str = xaml_resource_key( key );
+    struct resource *res = str ? find_entry( dict, str ) : NULL;
+
+    free( str );
+    if (!res) return E_BOUNDS;
+    list_remove( &res->entry );
+    if (res->value) IInspectable_Release( res->value );
+    free( res->key );
+    free( res );
+    return S_OK;
+}
+
+static void dict_clear( struct resdict *dict )
+{
+    struct resource *res, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( res, next, &dict->entries, struct resource, entry )
+    {
+        list_remove( &res->entry );
+        if (res->value) IInspectable_Release( res->value );
+        free( res->key );
+        free( res );
+    }
+}
+
+static HRESULT WINAPI map_Clear( struct xiface *iface )
+{
+    dict_clear( dict_from_iface( iface ) );
+    return S_OK;
+}
+
+static const void *map_vtbl[] =
+{
+    XIFACE_COMMON, map_Lookup, map_get_Size, map_HasKey, map_GetView, map_Insert, map_Remove, map_Clear,
+};
+
+static const struct xiface_entry dict_ifaces[] =
+{
+    { &IID_IResourceDictionary, offsetof(struct resdict, IResourceDictionary_iface) },
+    { &IID_IMap_Object, offsetof(struct resdict, IMap_iface) },
+    DOBJ_IFACES(struct dobj),
+};
+
+static void dict_destroy( struct xobj *obj )
+{
+    struct resdict *dict = CONTAINING_RECORD( obj, struct resdict, d.obj );
+
+    dict_clear( dict );
+    if (dict->merged) xvector_detach( dict->merged );
+    if (dict->themes) IInspectable_Release( &dict->themes->d.obj.IInspectable_inner );
+    if (dict->source) IInspectable_Release( dict->source );
+    dobj_cleanup( &dict->d );
+}
+
+static const struct xclass dict_class =
+{
+    L"Windows.UI.Xaml.ResourceDictionary", dict_ifaces, ARRAY_SIZE(dict_ifaces), dict_destroy,
+};
+
+static struct resdict *new_dict( IInspectable *outer )
+{
+    struct resdict *dict;
+
+    if (!(dict = calloc( 1, sizeof(*dict) ))) return NULL;
+    dict->IResourceDictionary_iface.vtbl = dict_vtbl;
+    dict->IMap_iface.vtbl = map_vtbl;
+    list_init( &dict->entries );
+    xvector_create( &merged_type, dict, &dict->merged );
+    dobj_init( &dict->d, &dict_class, outer );
+    return dict;
+}
+
+static struct resdict *dict_from_inspectable( IInspectable *iface )
+{
+    struct dobj *obj = dobj_from_inspectable( iface );
+    return obj && obj->obj.cls == &dict_class ? CONTAINING_RECORD( obj, struct resdict, d ) : NULL;
+}
+
+BOOL xaml_is_resource_dictionary( IInspectable *obj )
+{
+    return dict_from_inspectable( obj ) != NULL;
+}
+
+/* a keyed resource added to a dictionary (markup's x:Key) */
+HRESULT xaml_dictionary_add( IInspectable *dict_iface, const WCHAR *key, IInspectable *value )
+{
+    struct resdict *dict = dict_from_inspectable( dict_iface );
+    return dict ? dict_insert( dict, key, value ) : E_INVALIDARG;
+}
+
+HRESULT xaml_dictionary_merge( IInspectable *dict_iface, IInspectable *merged )
+{
+    struct resdict *dict = dict_from_inspectable( dict_iface );
+    IInspectable *vector;
+
+    if (!dict) return E_INVALIDARG;
+    vector = xvector_iface( dict->merged );
+    return ((HRESULT (WINAPI *)( IInspectable *, IInspectable * ))((void **)vector->lpVtbl)[13])( vector, merged );
+}
+
+static HRESULT WINAPI dict_factory_CreateInstance( struct xfiface *iface, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct resdict *dict;
+
+    if (!value) return E_POINTER;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(dict = new_dict( outer ))) return E_OUTOFMEMORY;
+    if (outer)
+    {
+        *inner = &dict->d.obj.IInspectable_inner;
+        IUnknown_AddRef( dict->d.obj.outer );
+    }
+    *value = &dict->IResourceDictionary_iface;
+    return S_OK;
+}
+
+static const void *dict_factory_vtbl[] =
+{
+    IResourceDictionaryFactory_FSTUBS, [IResourceDictionaryFactory_CreateInstance] = dict_factory_CreateInstance,
+};
+
+static struct xfactory dict_factory_obj = { { &xfactory_vtbl }, L"Windows.UI.Xaml.ResourceDictionary",
+                                            { &IID_IResourceDictionaryFactory }, { { dict_factory_vtbl } } };
+IActivationFactory *resource_dictionary_factory = &dict_factory_obj.IActivationFactory_iface;
+
+/* ---- Setter ---- */
+
+struct setter
+{
+    struct dobj d;
+    struct xiface ISetter_iface, ISetter2_iface, ISetterBase_iface;
+    IInspectable *property;         /* a DependencyProperty, or NULL */
+    WCHAR *property_name;           /* from markup: resolved against the style's TargetType */
+    IInspectable *value;
+    WCHAR *value_text;              /* from markup: converted by the property's type */
+};
+
+static struct setter *setter_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct setter, d.obj );
+}
+
+static HRESULT WINAPI setter_get_Property( struct xiface *iface, IInspectable **value )
+{
+    struct setter *setter = setter_from_iface( iface );
+
+    if (!value) return E_POINTER;
