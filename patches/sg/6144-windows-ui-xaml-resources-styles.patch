+    if (!setter) return FALSE;
+    if (!wcscmp( name, L"Property" ) && str)
+    {
+        free( setter->property_name );
+        setter->property_name = wcsdup( str );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"Value" ))
+    {
+        if (str)
+        {
+            free( setter->value_text );
+            setter->value_text = wcsdup( str );
+            if (setter->value) IInspectable_Release( setter->value );
+            setter->value = NULL;
+        }
+        else setter_put_Value( &setter->ISetter_iface, value );
+        return TRUE;
+    }
+    return FALSE;
