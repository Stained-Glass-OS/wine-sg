 static BOOL WINAPI init_elements( INIT_ONCE *once, void *param, void **context )
 {
     static const WCHAR ui[] = L"Windows.UI.Xaml.UIElement", fe[] = L"Windows.UI.Xaml.FrameworkElement";
@@ -100,7 +110,7 @@ static BOOL WINAPI init_elements( INIT_ONCE *once, void *param, void **context )
     prop_language = xaml_property_register( fe, L"Language", L"String", xbox_string( L"en-US" ), FALSE, NULL );
     prop_flow_direction = xaml_property_register( fe, L"FlowDirection", L"Windows.UI.Xaml.FlowDirection",
             NULL, FALSE, layout_changed );
-    prop_style = xaml_property_register( fe, L"Style", L"Windows.UI.Xaml.Style", NULL, FALSE, NULL );
+    prop_style = xaml_property_register( fe, L"Style", L"Windows.UI.Xaml.Style", NULL, FALSE, style_changed );
     prop_actual_width = xaml_property_register( fe, L"ActualWidth", L"Double", xbox_double( 0 ), FALSE, NULL );
     prop_actual_height = xaml_property_register( fe, L"ActualHeight", L"Double", xbox_double( 0 ), FALSE, NULL );
     prop_requested_theme = xaml_property_register( fe, L"RequestedTheme", L"Windows.UI.Xaml.ElementTheme",
@@ -234,6 +244,7 @@ void uielem_measure( struct uielem *elem, struct xsize available )
 
     if (elem->measure_valid && elem->measured && elem->constraint.width == available.width &&
         elem->constraint.height == available.height) return;
+    if (!elem->style_applied) xaml_apply_implicit_style( elem );
     elem->constraint = available;
     elem->measured = TRUE;
     elem->measure_valid = TRUE;
@@ -595,9 +606,20 @@ OBJECT_PROPERTY(Style, prop_style)
 
 static HRESULT WINAPI fe_get_Resources( struct xiface *iface, IInspectable **value )
 {
-    FIXME( "%p: no ResourceDictionary yet\n", iface );
     if (!value) return E_POINTER;
-    *value = NULL;
+    if (!(*value = xaml_element_resources( elem_from_iface( iface ) ))) return E_OUTOFMEMORY;
+    IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI fe_put_Resources( struct xiface *iface, IInspectable *value )
+{
+    struct uielem *elem = elem_from_iface( iface );
+
+    if (value && !xaml_is_resource_dictionary( value )) return E_INVALIDARG;
+    if (value) IInspectable_AddRef( value );
+    if (elem->resources) IInspectable_Release( elem->resources );
+    elem->resources = value;
     return S_OK;
 }
 
@@ -787,6 +809,7 @@ static const void *fe_vtbl[] =
     IFrameworkElement_STUBS,
     [IFrameworkElement_Triggers] = fe_get_Triggers,
     [IFrameworkElement_Resources] = fe_get_Resources,
+    [IFrameworkElement_SetResources] = fe_put_Resources,
     [IFrameworkElement_Tag] = fe_get_Tag,
     [IFrameworkElement_SetTag] = fe_put_Tag,
     [IFrameworkElement_Language] = fe_get_Language,
@@ -994,6 +1017,8 @@ void uielem_cleanup( struct uielem *elem )
 {
     struct uielem *child, *next;
 
+    if (elem->resources) IInspectable_Release( elem->resources );
+    elem->resources = NULL;
     LIST_FOR_EACH_ENTRY_SAFE( child, next, &elem->children, struct uielem, entry )
         uielem_remove_child( elem, child );
     handlers_clear( &elem->loaded );
