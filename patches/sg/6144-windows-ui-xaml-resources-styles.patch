+++ b/dlls/windows.ui.xaml/resources.c
@@ -0,0 +1,922 @@
+/*
+ * Windows.UI.Xaml resources and styles: ResourceDictionary, Style, Setter; resource lookup; the
+ * desktop's own theme resources
