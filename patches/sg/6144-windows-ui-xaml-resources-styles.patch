+static HRESULT markup_extension( struct xaml_writer *writer, const WCHAR *str, IInspectable **value )
+{
+    WCHAR name[32], arg[256];
+    const WCHAR *p = str + 1, *e;
+    size_t n;
+    IInspectable *found;
+
+    *value = NULL;
+    while (*p == ' ') p++;
+    for (n = 0; *p && *p != ' ' && *p != '}' && n < ARRAY_SIZE(name) - 1; p++) name[n++] = *p;
+    name[n] = 0;
+    while (*p == ' ') p++;
+    if (!(e = wcschr( p, '}' ))) return E_INVALIDARG;
+    n = min( (size_t)(e - p), ARRAY_SIZE(arg) - 1 );
+    memcpy( arg, p, n * sizeof(WCHAR) );
+    arg[n] = 0;
+    while (n && arg[n - 1] == ' ') arg[--n] = 0;
+    if (!wcsncmp( arg, L"ResourceKey=", 12 )) memmove( arg, arg + 12, (wcslen( arg + 12 ) + 1) * sizeof(WCHAR) );
+    if (!wcscmp( name, L"x:Null" )) return S_OK;
+    if (!wcscmp( name, L"StaticResource" ) || !wcscmp( name, L"ThemeResource" ))
+    {
+        if (!(found = xaml_find_resource( NULL, writer->scope, writer->depth, arg )))
+        {
