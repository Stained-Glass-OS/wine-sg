+/* a numeric property of a Win32_ProcessStartup object, if the client set it */
+static BOOL get_startup_uint( IWbemClassObject *startup, const WCHAR *name, DWORD *val )
+{
+    VARIANT v, n;
+    BOOL ret = FALSE;
+
+    VariantInit( &v );
+    VariantInit( &n );
+    if (IWbemClassObject_Get( startup, name, 0, &v, NULL, NULL ) == S_OK && V_VT( &v ) != VT_NULL
+            && V_VT( &v ) != VT_EMPTY && SUCCEEDED(VariantChangeType( &n, &v, 0, VT_UI4 )))
+    {
+        *val = V_UI4( &n );
+        ret = TRUE;
+    }
+    VariantClear( &v );
+    VariantClear( &n );
+    return ret;
+}
+
+static WCHAR *get_startup_string( IWbemClassObject *startup, const WCHAR *name )
+{
+    VARIANT v;
+    WCHAR *ret = NULL;
+
+    VariantInit( &v );
+    if (IWbemClassObject_Get( startup, name, 0, &v, NULL, NULL ) == S_OK && V_VT( &v ) == VT_BSTR && V_BSTR( &v ))
+        ret = wcsdup( V_BSTR( &v ) );
+    VariantClear( &v );
+    return ret;
+}
