+/* the environment of the caller with the NAME=VALUE strings of EnvironmentVariables added or replaced
+ * (GUESSED: Windows' process provider may build the block from the user's default environment instead) */
+static WCHAR *build_environment( IWbemClassObject *startup )
+{
+    VARIANT v;
+    SAFEARRAY *sa;
+    LONG lower, upper, i;
+    WCHAR *env, *cur, *p, *ret = NULL, *dst;
+    SIZE_T len = 1, add_len = 0;
+
+    VariantInit( &v );
+    if (IWbemClassObject_Get( startup, L"EnvironmentVariables", 0, &v, NULL, NULL ) != S_OK
+            || V_VT( &v ) != (VT_BSTR | VT_ARRAY) || !(sa = V_ARRAY( &v )))
+    {
+        VariantClear( &v );
+        return NULL;
+    }
+    if (FAILED(SafeArrayGetLBound( sa, 1, &lower )) || FAILED(SafeArrayGetUBound( sa, 1, &upper )) || upper < lower)
+    {
+        VariantClear( &v );
+        return NULL;
+    }
+    if (!(cur = GetEnvironmentStringsW()))
+    {
+        VariantClear( &v );
+        return NULL;
+    }
+    for (p = cur; *p; p += wcslen( p ) + 1) len += wcslen( p ) + 1;
+    for (i = lower; i <= upper; i++)
+    {
+        BSTR str;
+
+        if (SUCCEEDED(SafeArrayGetElement( sa, &i, &str )) && str)
+        {
+            add_len += wcslen( str ) + 1;
+            SysFreeString( str );
+        }
+    }
+    if (!(env = malloc( (len + add_len) * sizeof(WCHAR) )))
+        goto done;
+    dst = env;
+    /* the caller's variables, except the ones the client names again */
+    for (p = cur; *p; p += wcslen( p ) + 1)
+    {
+        BOOL replaced = FALSE;
+        const WCHAR *eq = wcschr( p + (*p == '=' ? 1 : 0), '=' );
+        SIZE_T name_len = eq ? eq - p : wcslen( p );
+
+        for (i = lower; i <= upper && !replaced; i++)
+        {
+            BSTR str;
+
+            if (SUCCEEDED(SafeArrayGetElement( sa, &i, &str )) && str)
+            {
+                const WCHAR *e = wcschr( str, '=' );
+
+                replaced = e && (SIZE_T)(e - str) == name_len && !wcsnicmp( str, p, name_len );
+                SysFreeString( str );
+            }
+        }
+        if (!replaced)
+        {
+            wcscpy( dst, p );
+            dst += wcslen( p ) + 1;
+        }
+    }
+    for (i = lower; i <= upper; i++)
+    {
+        BSTR str;
+
+        if (SUCCEEDED(SafeArrayGetElement( sa, &i, &str )) && str)
+        {
+            if (wcschr( str, '=' ))
+            {
+                wcscpy( dst, str );
+                dst += wcslen( str ) + 1;
+            }
+            SysFreeString( str );
+        }
+    }
+    *dst = 0;
+    ret = env;
+done:
+    FreeEnvironmentStringsW( cur );
+    VariantClear( &v );
+    return ret;
+}
