+/* an embedded object: the instance keeps a copy of the object it is given, NULL clears it */
+static HRESULT record_set_object( struct record *record, UINT index, VARIANT *var )
+{
+    IWbemClassObject *obj = NULL, *clone = NULL;
+    IUnknown *unk;
+    HRESULT hr;
+
+    switch (V_VT( var ))
+    {
+    case VT_NULL:
+    case VT_EMPTY:
+        unk = NULL;
+        break;
+    case VT_UNKNOWN:
+        unk = V_UNKNOWN( var );
+        break;
+    case VT_DISPATCH:
+        unk = (IUnknown *)V_DISPATCH( var );
+        break;
+    default:
+        return WBEM_E_TYPE_MISMATCH;
+    }
+    if (unk)
+    {
+        /* an SWbemObject hands out its IWbemClassObject through IUnknown too */
+        if (FAILED(hr = IUnknown_QueryInterface( unk, &IID_IWbemClassObject, (void **)&obj )))
+        {
+            return WBEM_E_TYPE_MISMATCH;
+        }
+#ifdef SG_MUTANT_WBEM_OBJ_COPY
+        clone = obj;
+        IWbemClassObject_AddRef( clone );
+        hr = S_OK;
+#else
+        hr = IWbemClassObject_Clone( obj, &clone );
+#endif
+        IWbemClassObject_Release( obj );
+        if (FAILED(hr)) return hr;
+    }
+    if (record->fields[index].u.ival)
+        IWbemClassObject_Release( (IWbemClassObject *)(INT_PTR)record->fields[index].u.ival );
+    record->fields[index].u.ival = (INT_PTR)clone;
+    record->fields[index].is_set = clone != NULL;
+    return S_OK;
+}
