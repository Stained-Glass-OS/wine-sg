From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] server, win32u: keys in order, Alt and Ctrl as typed, with slow keyboard hooks

Two programs hook the keyboard in every session (explorer's Win keys, voice
typing). The hook thread that chains to the next program's hook took the next
key's hook call inside the wait, so keys came out last first; and the server
judged Alt and Ctrl from the desktop key state, which a key enters only after
the hooks: Alt+F4 became F4 then Alt's menu, typing went astray (field report
2026-10-17, the focus issue). The chain is waited for with SMTO_BLOCK, and
Alt/Ctrl are tracked as the input comes.
---
--- a/server/queue.c
+++ b/server/queue.c
@@ -2382,6 +2382,25 @@
         break;
     }
 
+    /* Stained Glass: Alt and Ctrl as the input comes. The desktop's key state
+     * is updated only when a key's message is queued -- after a low-level
+     * keyboard hook (explorer's Win-key shortcuts, always there) has seen it
+     * -- so with the hook a moment slow, F4 right after Alt was judged without
+     * Alt: Alt+F4 became F4 and then Alt's menu (David, 2026-10-17: the
+     * keyboard "not mapped" to the window clicked). */
+    {
+        unsigned char bit = vkey == VK_LMENU ? 1 : vkey == VK_RMENU ? 2 : vkey == VK_LCONTROL ? 4 : vkey == VK_RCONTROL ? 8 : 0;
+        if (input->kbd.flags & KEYEVENTF_KEYUP) desktop->input_mods &= ~bit;
+        else desktop->input_mods |= bit;
+    }
+
+#ifndef SG_MUTANT_MODS_AFTER_HOOK
+#define SG_ALT_DOWN  (desktop->input_mods & 3)
+#define SG_CTRL_DOWN (desktop->input_mods & 12)
+#else
+#define SG_ALT_DOWN  (desktop_shm->keystate[VK_MENU] & 0x80)
+#define SG_CTRL_DOWN (desktop_shm->keystate[VK_CONTROL] & 0x80)
+#endif
     message_code = (input->kbd.flags & KEYEVENTF_KEYUP) ? WM_KEYUP : WM_KEYDOWN;
     switch (vkey)
     {
@@ -2390,14 +2409,14 @@
         if (input->kbd.flags & KEYEVENTF_KEYUP)
         {
             /* send WM_SYSKEYUP if Alt still pressed and no other key in between */
-            if (!(desktop_shm->keystate[VK_MENU] & 0x80) || !desktop->alt_pressed) break;
+            if (!SG_ALT_DOWN || !desktop->alt_pressed) break;
             message_code = WM_SYSKEYUP;
             desktop->alt_pressed = 0;
         }
         else
         {
             /* send WM_SYSKEYDOWN for Alt except with Ctrl */
-            if (desktop_shm->keystate[VK_CONTROL] & 0x80) break;
+            if (SG_CTRL_DOWN) break;
             message_code = WM_SYSKEYDOWN;
             desktop->alt_pressed = 1;
         }
@@ -2407,15 +2426,15 @@
     case VK_RCONTROL:
         /* send WM_SYSKEYUP on release if Alt still pressed */
         if (!(input->kbd.flags & KEYEVENTF_KEYUP)) break;
-        if (!(desktop_shm->keystate[VK_MENU] & 0x80)) break;
+        if (!SG_ALT_DOWN) break;
         message_code = WM_SYSKEYUP;
         desktop->alt_pressed = 0;
         break;
 
     default:
         /* send WM_SYSKEY for Alt-anykey and for F10 */
-        if (desktop_shm->keystate[VK_CONTROL] & 0x80) break;
-        if (!(desktop_shm->keystate[VK_MENU] & 0x80)) break;
+        if (SG_CTRL_DOWN) break;
+        if (!SG_ALT_DOWN) break;
         /* fall through */
     case VK_F10:
         message_code = (input->kbd.flags & KEYEVENTF_KEYUP) ? WM_SYSKEYUP : WM_SYSKEYDOWN;
@@ -4146,6 +4165,14 @@
             memcpy( (void *)shared->keystate, get_req_data(), size );
         }
         SHARED_WRITE_END;
+        /* Stained Glass: the keyboard resynchronised (focus back from outside):
+         * Alt and Ctrl as it says now */
+        if (size > VK_RCONTROL)
+        {
+            const unsigned char *ks = get_req_data();
+            desktop->input_mods = (ks[VK_LMENU] & 0x80 ? 1 : 0) | (ks[VK_RMENU] & 0x80 ? 2 : 0) |
+                                  (ks[VK_LCONTROL] & 0x80 ? 4 : 0) | (ks[VK_RCONTROL] & 0x80 ? 8 : 0);
+        }
         release_object( desktop );
     }
 }
--- a/server/user.h
+++ b/server/user.h
@@ -92,6 +92,7 @@
     unsigned int         input_blocker;    /* id of the thread that called BlockInput (0 if none) */
     unsigned char        keystate[256];    /* asynchronous key state */
     unsigned char        alt_pressed;      /* last key press was Alt (used to determine msg on release) */
+    unsigned char        input_mods;       /* Stained Glass: Alt and Ctrl as the input came (1/2 L/R Alt, 4/8 L/R Ctrl) */
     struct key_repeat    key_repeat;       /* key auto-repeat */
     unsigned int         clip_flags;       /* last cursor clip flags */
     user_handle_t        cursor_win;       /* window that contains the cursor */
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -327,6 +327,7 @@
             desktop->clip_flags = 0;
             desktop->cursor_win = 0;
             desktop->alt_pressed = 0;
+            desktop->input_mods = 0;
             memset( &desktop->key_repeat, 0, sizeof(desktop->key_repeat) );
             list_add_tail( &winstation->desktops, &desktop->entry );
             list_init( &desktop->hotkeys );
--- a/dlls/win32u/hook.c
+++ b/dlls/win32u/hook.c
@@ -218,16 +218,27 @@
                (int)info->tid, hook_names[info->id-WH_MINHOOK],
                info->code, (long)info->wparam, info->lparam );
 
+        /* Stained Glass: the next low-level hook in the chain (another program's)
+         * is waited for without taking other sent messages meanwhile: taken,
+         * the next key's hook ran inside this one and the keys came out last
+         * first -- Alt+F4 as F4 then Alt, typing out of order, whenever two
+         * programs hook the keyboard (explorer's Win keys, voice typing's)
+         * and one is a moment slow (David, 2026-10-17) */
+#ifndef SG_MUTANT_LL_CHAIN_NESTS
+#define SG_LL_SMTO (SMTO_ABORTIFHUNG | SMTO_BLOCK)
+#else
+#define SG_LL_SMTO SMTO_ABORTIFHUNG
+#endif
         switch(info->id)
         {
         case WH_KEYBOARD_LL:
             send_internal_message_timeout( info->pid, info->tid, WM_WINE_KEYBOARD_LL_HOOK,
-                                           info->wparam, (LPARAM)&h_extra, SMTO_ABORTIFHUNG,
+                                           info->wparam, (LPARAM)&h_extra, SG_LL_SMTO,
                                            get_ll_hook_timeout(), &ret );
             break;
         case WH_MOUSE_LL:
             send_internal_message_timeout( info->pid, info->tid, WM_WINE_MOUSE_LL_HOOK,
-                                           info->wparam, (LPARAM)&h_extra, SMTO_ABORTIFHUNG,
+                                           info->wparam, (LPARAM)&h_extra, SG_LL_SMTO,
                                            get_ll_hook_timeout(), &ret );
             break;
         default:
