From: Stained Glass OS contributors
Subject: ntdll: a handle opened on a symlink itself reports FILE_ATTRIBUTE_REPARSE_POINT

NtQueryInformationFile took a handle's attributes from fstat of the file
Unix opened. A handle opened with FILE_OPEN_REPARSE_POINT on a symlink is
the link itself, but Unix opened the link's target, so FileBasicInfo (and
the other classes) lacked FILE_ATTRIBUTE_REPARSE_POINT. Office's
Click-to-Run checks a package leaf that way before replacing it; seeing a
plain file it tried to create the link over it and staging failed
(0xa0000058). With FILE_OPEN_REPARSE_POINT, a symlink's lstat now adds the
attribute.

--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -1683,6 +1683,27 @@
 }
 
 
+/* Stained Glass OS: fd_get_file_info for a handle: a symbolic link opened as
+ * itself (FILE_OPEN_REPARSE_POINT) is a reparse point in every information
+ * class, as on Windows -- FileBasicInformation said it was its target, and
+ * Microsoft 365 setup, finding its link "not a link", made it again and
+ * failed (0xa0000058). */
+static unsigned int server_get_unix_name( HANDLE handle, char **unix_name );
+
+static int fd_get_file_info_h( HANDLE handle, int fd, unsigned int options, struct stat *st, ULONG *attr )
+{
+    int ret = fd_get_file_info( fd, options, st, attr );
+    char *unix_name;
+    struct stat lst;
+
+    if (ret != -1 && (options & FILE_OPEN_REPARSE_POINT) && !server_get_unix_name( handle, &unix_name ))
+    {
+        if (!lstat( unix_name, &lst ) && S_ISLNK( lst.st_mode )) *attr |= FILE_ATTRIBUTE_REPARSE_POINT;
+        free( unix_name );
+    }
+    return ret;
+}
+
 static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set )
 {
     /* we only store the HIDDEN and SYSTEM attributes */
@@ -4907,7 +4928,7 @@
     switch (class)
