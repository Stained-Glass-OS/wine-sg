 NTSTATUS WINAPI RtlSetThreadPreferredUILanguages( DWORD flags, PCZZWSTR buffer, ULONG *count )
 {
-    FIXME( "%lu, %p, %p\n", flags, buffer, count );
+    struct ui_languages langs, *thread;
+    NTSTATUS status;
+
+    TRACE( "%#lx, %s, %p\n", flags, debugstr_w(buffer), count );
+
+    if (flags & ~(MUI_LANGUAGE_NAME | MUI_LANGUAGE_ID | MUI_CONSOLE_FILTER | MUI_COMPLEX_SCRIPT_FILTER | MUI_RESET_FILTERS))
+        return STATUS_INVALID_PARAMETER;
+    if (check_format_flags( flags )) return STATUS_INVALID_PARAMETER;
+    if (buffer && !(flags & (MUI_LANGUAGE_NAME | MUI_LANGUAGE_ID))) return STATUS_INVALID_PARAMETER;
+    /* the console and complex script filters keep languages a console can
+     * show: every language can be shown here */
+    if ((status = parse_languages( flags, buffer, &langs ))) return status;
+
+    thread = NtCurrentTeb()->PreferredLanguages;
+    if (!langs.count)
+    {
+        NtCurrentTeb()->PreferredLanguages = NULL;
+        RtlFreeHeap( GetProcessHeap(), 0, thread );
+    }
+    else
+    {
+        if (!thread && !(thread = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*thread) ))) return STATUS_NO_MEMORY;
+        *thread = langs;
+        NtCurrentTeb()->PreferredLanguages = thread;
+    }
+    if (count) *count = langs.count;
     return STATUS_SUCCESS;
 }
 
 
+/* a thread's list goes with it */
+void free_thread_preferred_languages(void)
+{
+    RtlFreeHeap( GetProcessHeap(), 0, NtCurrentTeb()->PreferredLanguages );
+    NtCurrentTeb()->PreferredLanguages = NULL;
+}
