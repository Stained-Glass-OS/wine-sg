+/* Stained Glass OS (1644): preferred UI languages, as Windows keeps them:
+ * the thread's and the process's lists (Set*PreferredUILanguages, up to five
+ * each), the user's (the MUI override, the language list, else the Linux
+ * LANGUAGE preference list, else the UI language) and the system's (the
+ * install language). The thread's and process's lists also come first when
+ * a resource's language is chosen. */
+#define MAX_PREFERRED_LANGS 5
+#define MAX_MERGED_LANGS    32
+
+struct ui_languages
 {
-    WCHAR name[LOCALE_NAME_MAX_LENGTH + 2];
-    NTSTATUS status;
-    ULONG len;
+    ULONG  count;
+    LANGID langs[MAX_PREFERRED_LANGS];
+};
 
-    FIXME("(0x%lx %#x %p %p %p) returning a dummy value (current locale)\n", flags, lang, count, buffer, size);
+static struct ui_languages process_languages;
+static RTL_SRWLOCK process_languages_lock = RTL_SRWLOCK_INIT;
 
-    if (flags & MUI_LANGUAGE_ID) swprintf( name, ARRAY_SIZE(name), L"%04lX", lang );
-    else
+static ULONG add_language( LANGID *list, ULONG count, ULONG max, LANGID lang )
+{
+    ULONG i;
+
+    if (!lang || count >= max) return count;
+    for (i = 0; i < count; i++) if (list[i] == lang) return count;
+    list[count] = lang;
+    return count + 1;
+}
+
+/* a language name (or "de_DE", as Linux writes it) to a language id; a
+ * neutral one ("de") becomes its default specific one when asked */
+static LANGID language_from_name( const WCHAR *name, BOOL specific )
+{
+    WCHAR buffer[LOCALE_NAME_MAX_LENGTH], *p;
+    LCID lcid;
+
+    if (!name[0] || wcslen( name ) >= LOCALE_NAME_MAX_LENGTH) return 0;
+    wcscpy( buffer, name );
+    if ((p = wcschr( buffer, '.' ))) *p = 0;   /* de_DE.UTF-8 */
+    if ((p = wcschr( buffer, '@' ))) *p = 0;   /* de_DE@euro */
+    for (p = buffer; *p; p++) if (*p == '_') *p = '-';
+    if (!wcsicmp( buffer, L"C" ) || !wcsicmp( buffer, L"POSIX" )) return 0;
+    if (RtlLocaleNameToLcid( buffer, &lcid, 2 /* neutral ones too */ )) return 0;
+    if (LANGIDFROMLCID( lcid ) == LOCALE_CUSTOM_UNSPECIFIED || LANGIDFROMLCID( lcid ) == LOCALE_CUSTOM_DEFAULT) return 0;
+    if (specific && !SUBLANGID( LANGIDFROMLCID( lcid )))
+        return MAKELANGID( PRIMARYLANGID( LANGIDFROMLCID( lcid )), SUBLANG_DEFAULT );
+    return LANGIDFROMLCID( lcid );
+}
+
+/* the languages of a REG_MULTI_SZ value under the user's key */
+static ULONG read_language_list( const WCHAR *keyname, const WCHAR *valuename, LANGID *list, ULONG count, ULONG max )
+{
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE root, key;
+    char buffer[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data[1024] )];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    DWORD size;
+    const WCHAR *p, *end;
+
+    if (RtlOpenCurrentUser( KEY_READ, &root )) return count;
+    RtlInitUnicodeString( &name, keyname );
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, root, NULL );
+    if (!NtOpenKey( &key, KEY_READ, &attr ))
     {
-        UNICODE_STRING str;
+        RtlInitUnicodeString( &name, valuename );
+        if (!NtQueryValueKey( key, &name, KeyValuePartialInformation, buffer, sizeof(buffer) - sizeof(WCHAR), &size ) &&
+            (info->Type == REG_MULTI_SZ || info->Type == REG_SZ))
+        {
+            p = (const WCHAR *)info->Data;
+            end = p + info->DataLength / sizeof(WCHAR);
+            ((WCHAR *)info->Data)[info->DataLength / sizeof(WCHAR)] = 0;
+            while (p < end && *p)
+            {
+                count = add_language( list, count, max, language_from_name( p, TRUE ));
+                p += wcslen( p ) + 1;
+            }
+        }
+        NtClose( key );
+    }
+    NtClose( root );
+    return count;
+}
 
-        if (lang == LOCALE_CUSTOM_UNSPECIFIED)
-            NtQueryInstallUILanguage( &lang );
+/* the user's preferred UI languages */
+static ULONG get_user_languages( LANGID *list, ULONG max )
+{
+    ULONG count = 0;
+    LANGID ui_language;
 
-        str.Buffer = name;
-        str.MaximumLength = sizeof(name);
-        status = RtlLcidToLocaleName( lang, &str, 0, FALSE );
-        if (status) return status;
+    /* the MUI override, then the language list (Settings > Time & language) */
+    count = read_language_list( L"Control Panel\\Desktop", L"PreferredUILanguages", list, count, max );
+    if (!count) count = read_language_list( L"Control Panel\\International\\User Profile", L"Languages", list, count, max );
+    if (!count)
+    {
+        /* the Linux preference list, LANGUAGE=de_DE:de:en */
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"LANGUAGE" ), value;
+        WCHAR buffer[256], *p, *next;
+
+        value.Buffer = buffer;
+        value.MaximumLength = sizeof(buffer) - sizeof(WCHAR);
+        value.Length = 0;
+        NtQueryDefaultUILanguage( &ui_language );
+        if (!RtlQueryEnvironmentVariable_U( NULL, &name, &value ))
+        {
+            buffer[value.Length / sizeof(WCHAR)] = 0;
+            /* the UI language first: LANGUAGE only orders the fallbacks */
+            count = add_language( list, count, max, ui_language );
+            for (p = buffer; p && *p; p = next)
+            {
+                if ((next = wcschr( p, ':' ))) *next++ = 0;
+                count = add_language( list, count, max, language_from_name( p, TRUE ));
+            }
+        }
+    }
+    if (!count)
+    {
+        NtQueryDefaultUILanguage( &ui_language );
+        count = add_language( list, count, max, ui_language );
+    }
+    return count;
+}
+
+static ULONG get_system_languages( LANGID *list, ULONG max )
+{
+    LANGID lang;
+
+    NtQueryInstallUILanguage( &lang );
+    return add_language( list, 0, max, lang );
+}
+
+static ULONG get_thread_languages( LANGID *list, ULONG max )
+{
+    struct ui_languages *thread = NtCurrentTeb()->PreferredLanguages;
+    ULONG i, count = 0;
+
+    if (thread) for (i = 0; i < thread->count; i++) count = add_language( list, count, max, thread->langs[i] );
+    return count;
+}
+
+static ULONG get_process_languages( LANGID *list, ULONG max )
+{
+    ULONG i, count = 0;
+
+    RtlAcquireSRWLockShared( &process_languages_lock );
+    for (i = 0; i < process_languages.count; i++) count = add_language( list, count, max, process_languages.langs[i] );
+    RtlReleaseSRWLockShared( &process_languages_lock );
+    return count;
+}
+
+/* the languages resources are looked for in first: the thread's, then the process's */
+ULONG get_preferred_resource_languages( LANGID *list, ULONG max )
+{
+    ULONG count = get_thread_languages( list, max );
+    LANGID process[MAX_PREFERRED_LANGS];
+    ULONG i, n = get_process_languages( process, ARRAY_SIZE(process) );
+
+    for (i = 0; i < n; i++) count = add_language( list, count, max, process[i] );
+    return count;
+}
+
+/* writes a language list in the asked format: names ("en-US\0de-DE\0\0")
+ * or ids ("0409\0" ...) */
+static NTSTATUS put_languages( DWORD flags, const LANGID *list, ULONG count, ULONG *ret_count,
+                               WCHAR *buffer, ULONG *size )
+{
+    WCHAR names[MAX_MERGED_LANGS][LOCALE_NAME_MAX_LENGTH];
+    ULONG i, len = 0, valid = 0, pos = 0;
+
+    for (i = 0; i < count; i++)
+    {
+        if (flags & MUI_LANGUAGE_ID) swprintf( names[valid], LOCALE_NAME_MAX_LENGTH, L"%04X", list[i] );
+        else
+        {
+            UNICODE_STRING str;
+            str.Buffer = names[valid];
+            str.MaximumLength = sizeof(names[valid]);
+            str.Length = 0;
+            if (RtlLcidToLocaleName( MAKELCID( list[i], SORT_DEFAULT ), &str, 2 /* neutral ones too */, FALSE )) continue;
+            names[valid][str.Length / sizeof(WCHAR)] = 0;
+        }
+        len += wcslen( names[valid] ) + 1;
+        valid++;
     }
+    len++;   /* the list's final null */
+    if (!valid) len = 2;   /* an empty list: two nulls */
 
-    len = wcslen( name ) + 2;
-    name[len - 1] = 0;
     if (buffer)
     {
         if (len > *size)
@@ -227,13 +388,72 @@ static NTSTATUS get_dummy_preferred_ui_language( DWORD flags, LANGID lang, ULONG
             *size = len;
             return STATUS_BUFFER_TOO_SMALL;
         }
-        memcpy( buffer, name, len * sizeof(WCHAR) );
+        for (i = 0; i < valid; i++)
+        {
+            wcscpy( buffer + pos, names[i] );
+            pos += wcslen( names[i] ) + 1;
+        }
+        buffer[pos++] = 0;
+        if (!valid) buffer[pos++] = 0;
     }
     *size = len;
-    *count = 1;
-    TRACE("returned variable content: %ld, \"%s\", %ld\n", *count, debugstr_w(buffer), *size);
+    *ret_count = valid;
+    TRACE( "%lu languages, size %lu\n", valid, len );
+    return STATUS_SUCCESS;
+}
+
+/* the neutral languages after each specific one, as the resource loader
+ * falls back (MUI_MERGE_SYSTEM_FALLBACK) */
+static ULONG add_fallbacks( LANGID *list, ULONG count, ULONG max )
+{
+    LANGID merged[MAX_MERGED_LANGS];
+    ULONG i, n = 0;
+
+    for (i = 0; i < count; i++)
+    {
+        n = add_language( merged, n, ARRAY_SIZE(merged), list[i] );
+        if (SUBLANGID( list[i] )) n = add_language( merged, n, ARRAY_SIZE(merged), MAKELANGID( PRIMARYLANGID( list[i] ), SUBLANG_NEUTRAL ));
+    }
+    n = min( n, max );
+    memcpy( list, merged, n * sizeof(*list) );
+    return n;
+}
+
+static NTSTATUS check_format_flags( DWORD flags )
+{
+    if ((flags & MUI_LANGUAGE_NAME) && (flags & MUI_LANGUAGE_ID)) return STATUS_INVALID_PARAMETER;
     return STATUS_SUCCESS;
+}
+
+/* parse a list given to Set*PreferredUILanguages */
+static NTSTATUS parse_languages( DWORD flags, PCZZWSTR buffer, struct ui_languages *langs )
+{
+    const WCHAR *p;
 
+    langs->count = 0;
+    if (!buffer) return STATUS_SUCCESS;
+    for (p = buffer; *p; p += wcslen( p ) + 1)
+    {
+        LANGID lang;
+
+        if (flags & MUI_LANGUAGE_ID)
+        {
+            WCHAR *end;
+            ULONG id = wcstoul( p, &end, 16 );
+            UNICODE_STRING str;
+            WCHAR name[LOCALE_NAME_MAX_LENGTH];
+
+            str.Buffer = name;
+            str.MaximumLength = sizeof(name);
+            if (*end || !id || id > 0xffff || RtlLcidToLocaleName( MAKELCID( id, SORT_DEFAULT ), &str, 0, FALSE ))
+                return STATUS_INVALID_PARAMETER;
+            lang = id;
+        }
+        else if (!(lang = language_from_name( p, FALSE ))) return STATUS_INVALID_PARAMETER;
+        if (langs->count >= MAX_PREFERRED_LANGS) return STATUS_INVALID_PARAMETER;
+        langs->count = add_language( langs->langs, langs->count, MAX_PREFERRED_LANGS, lang );
+    }
+    return STATUS_SUCCESS;
 }
 
