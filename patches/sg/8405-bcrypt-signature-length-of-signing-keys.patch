From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] bcrypt: a signing key's signature length (BCRYPT_SIGNATURE_LENGTH)

BCryptGetProperty(key, BCRYPT_SIGNATURE_LENGTH) gives the size of the key's signatures on
Windows: the modulus bytes of an RSA key, twice the coordinate size of an ECDSA key (64 for
P-256, 96 for P-384), 40 for DSA. Wine answered STATUS_NOT_SUPPORTED for every asymmetric key.
Bitvise SSH Client sizes the host key signature by it, and every connection ended in key
exchange ("AsymKey::CngSigLen: BCryptGetProperty: NT status 0xc00000bb"); its update check
failed the same way.
---
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1055,6 +1055,30 @@
         return STATUS_SUCCESS;
     }
 
+#ifndef SG_MUTANT_NO_SIGNATURE_LENGTH
+    /* Stained Glass OS (wine-sg 8405): the size of a signing key's signatures, as Windows gives
+     * it for asymmetric keys (Bitvise SSH Client sizes its host key signatures by it: every
+     * connection ended in key exchange with STATUS_NOT_SUPPORTED) */
+    if (!wcscmp( prop, BCRYPT_SIGNATURE_LENGTH ) && !is_symmetric_key( key ))
+    {
+        ULONG len;
+
+        switch (key->alg_id)
+        {
+        case ALG_ID_RSA:
+        case ALG_ID_RSA_SIGN:    len = (key->u.a.bitlen + 7) / 8; break;
+        case ALG_ID_ECDSA_P256:  len = 2 * 32; break;
+        case ALG_ID_ECDSA_P384:  len = 2 * 48; break;
+        case ALG_ID_DSA:         len = 2 * 20; break;
+        default: return STATUS_NOT_SUPPORTED;
+        }
+        *ret_size = sizeof(DWORD);
+        if (size < sizeof(DWORD)) return STATUS_BUFFER_TOO_SMALL;
+        if (buf) *(DWORD *)buf = len;
+        return STATUS_SUCCESS;
+    }
+#endif
+
     switch (key->alg_id)
     {
     case ALG_ID_3DES:
