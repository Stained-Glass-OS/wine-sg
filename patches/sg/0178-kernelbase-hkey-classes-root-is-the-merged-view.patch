+/******************************************************************************
+ * RegQueryValueExW   (kernelbase.@)
+ */
+LSTATUS WINAPI DECLSPEC_HOTPATCH RegQueryValueExW( HKEY hkey, LPCWSTR name, LPDWORD reserved, LPDWORD type,
+                                                   LPBYTE data, LPDWORD count )
+{
+    HKEY tmp, key = classes_value_key( hkey, name, FALSE, &tmp );
+    LSTATUS ret = query_value_ex_w( key, name, reserved, type, data, count );
+    if (tmp) NtClose( tmp );
+    return ret;
+}
+
+/******************************************************************************
+ * RegQueryValueExA   (kernelbase.@)
+ */
+LSTATUS WINAPI DECLSPEC_HOTPATCH RegQueryValueExA( HKEY hkey, LPCSTR name, LPDWORD reserved, LPDWORD type,
+                                                   LPBYTE data, LPDWORD count )
+{
+    WCHAR *nameW = ansi_to_wide( name );
+    HKEY tmp, key = classes_value_key( hkey, nameW, FALSE, &tmp );
+    LSTATUS ret = query_value_ex_a( key, name, reserved, type, data, count );
+    if (tmp) NtClose( tmp );
+    heap_free( nameW );
+    return ret;
+}
+
+/******************************************************************************
+ * RegSetValueExW   (kernelbase.@)
+ */
+LSTATUS WINAPI DECLSPEC_HOTPATCH RegSetValueExW( HKEY hkey, LPCWSTR name, DWORD reserved, DWORD type,
+                                                 const BYTE *data, DWORD count )
+{
+    HKEY tmp, key = classes_value_key( hkey, name, TRUE, &tmp );
+    LSTATUS ret = set_value_ex_w( key, name, reserved, type, data, count );
+    if (tmp) NtClose( tmp );
+    return ret;
+}
+
+/******************************************************************************
+ * RegSetValueExA   (kernelbase.@)
+ */
+LSTATUS WINAPI DECLSPEC_HOTPATCH RegSetValueExA( HKEY hkey, LPCSTR name, DWORD reserved, DWORD type,
+                                                 const BYTE *data, DWORD count )
+{
+    WCHAR *nameW = ansi_to_wide( name );
+    HKEY tmp, key = classes_value_key( hkey, nameW, TRUE, &tmp );
+    LSTATUS ret = set_value_ex_a( key, name, reserved, type, data, count );
+    if (tmp) NtClose( tmp );
+    heap_free( nameW );
+    return ret;
+}
+
+/******************************************************************************
+ * RegDeleteValueW   (kernelbase.@)
+ */
+LSTATUS WINAPI RegDeleteValueW( HKEY hkey, LPCWSTR name )
+{
+    HKEY tmp, key = classes_value_key( hkey, name, FALSE, &tmp );
+    LSTATUS ret;
+
+    /* the side that has it, opened for writing */
+    if (tmp)
+    {
+        HKEY writable;
+        UNICODE_STRING empty = { 0 };
+        if (!open_key( &writable, tmp, &empty, 0, KEY_SET_VALUE, FALSE ))
+        {
+            NtClose( tmp );
+            tmp = key = writable;
+        }
+    }
+    ret = delete_value_w( key, name );
+    if (tmp) NtClose( tmp );
+    return ret;
+}
+
+/******************************************************************************
+ * RegDeleteValueA   (kernelbase.@)
+ */
+LSTATUS WINAPI RegDeleteValueA( HKEY hkey, LPCSTR name )
+{
+    WCHAR *nameW = ansi_to_wide( name );
+    LSTATUS ret;
+
+    WCHAR *path = get_classes_path( hkey );
+
+    if (path && (nameW || !name))
+    {
+        heap_free( path );
+        ret = RegDeleteValueW( hkey, nameW );
+        heap_free( nameW );
+        return ret;
+    }
+    heap_free( path );
+    heap_free( nameW );
+    return delete_value_a( hkey, name );
+}
+
+/******************************************************************************
+ * RegEnumValueW   (kernelbase.@)
+ */
+LSTATUS WINAPI RegEnumValueW( HKEY hkey, DWORD index, LPWSTR value, LPDWORD val_count,
+                              LPDWORD reserved, LPDWORD type, LPBYTE data, LPDWORD count )
+{
+    HKEY side;
+    DWORD side_index;
+    LSTATUS ret;
+
+    if (!classes_enum_value( hkey, index, &side, &side_index ))
+        return enum_value_w( hkey, index, value, val_count, reserved, type, data, count );
+    ret = side_index == ~0u ? ERROR_NO_MORE_ITEMS
+                            : enum_value_w( side, side_index, value, val_count, reserved, type, data, count );
+    NtClose( side );
+    return ret;
+}
+
+/******************************************************************************
+ * RegEnumValueA   (kernelbase.@)
+ */
+LSTATUS WINAPI RegEnumValueA( HKEY hkey, DWORD index, LPSTR value, LPDWORD val_count,
+                              LPDWORD reserved, LPDWORD type, LPBYTE data, LPDWORD count )
+{
+    HKEY side;
+    DWORD side_index;
+    LSTATUS ret;
+
+    if (!classes_enum_value( hkey, index, &side, &side_index ))
+        return enum_value_a( hkey, index, value, val_count, reserved, type, data, count );
+    ret = side_index == ~0u ? ERROR_NO_MORE_ITEMS
+                            : enum_value_a( side, side_index, value, val_count, reserved, type, data, count );
+    NtClose( side );
+    return ret;
+}
