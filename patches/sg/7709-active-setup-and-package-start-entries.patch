diff --git a/programs/explorer/startup.c b/programs/explorer/startup.c
index 5d4eea3..1f48dfe 100644
--- a/programs/explorer/startup.c
+++ b/programs/explorer/startup.c
@@ -164,6 +164,285 @@ static void run_folder( int csidl, HKEY approved_root )
     FindClose( find );
 }
 
+/* ---- Active Setup ---------------------------------------------------------------- */
+
+/* Stained Glass OS: as Windows' shell does at sign-in, before the Run keys: each component of
+ * HKLM\Software\Microsoft\Active Setup\Installed Components (both registry views) that is
+ * installed and has a StubPath runs that command once per person -- again when the machine's
+ * Version is higher than the one in the person's HKCU key.  Installers put there what each user
+ * needs: eM Client's MSI, run as SYSTEM by the Store, has its MailClient.exe --install-msix set up
+ * the application for each person (qa4, 2026-11-07); nothing ran them. */
+#define ACTIVE_SETUP_KEY L"Software\\Microsoft\\Active Setup\\Installed Components"
+
+static void parse_version( const WCHAR *str, DWORD v[4] )
+{
+    int i;
+
+    v[0] = v[1] = v[2] = v[3] = 0;
+    for (i = 0; i < 4 && str && *str; i++)
+    {
+        v[i] = wcstoul( str, (WCHAR **)&str, 10 );
+        while (*str && *str != ',' && *str != '.') str++;
+        if (*str) str++;
+    }
+}
+
+static int compare_version( const WCHAR *a, const WCHAR *b )
+{
+    DWORD va[4], vb[4];
+    int i;
+
+    parse_version( a, va );
+    parse_version( b, vb );
+    for (i = 0; i < 4; i++) if (va[i] != vb[i]) return va[i] < vb[i] ? -1 : 1;
+    return 0;
+}
+
+static BOOL reg_sz( HKEY key, const WCHAR *name, WCHAR *out, DWORD size )
+{
+    DWORD type, cb = size - sizeof(WCHAR);
+
+    out[0] = 0;
+    if (RegQueryValueExW( key, name, NULL, &type, (BYTE *)out, &cb ) || (type != REG_SZ && type != REG_EXPAND_SZ))
+    {
+        out[0] = 0;
+        return FALSE;
+    }
+    out[cb / sizeof(WCHAR)] = 0;
+    return TRUE;
+}
+
+/* the command, waited for -- the next one, and the Run keys, after it -- while the shell's
+ * windows still answer */
+static void run_and_wait( const WCHAR *cmd )
+{
+    WCHAR expanded[2048];
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    DWORD start = GetTickCount(), ret;
+    MSG msg;
+
+    if (!ExpandEnvironmentStringsW( cmd, expanded, ARRAY_SIZE(expanded) )) lstrcpynW( expanded, cmd, ARRAY_SIZE(expanded) );
+    if (!CreateProcessW( NULL, expanded, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        WARN( "could not start %s: %lu\n", debugstr_w(expanded), GetLastError() );
+        return;
+    }
+    TRACE( "started %s\n", debugstr_w(expanded) );
+    CloseHandle( pi.hThread );
+    /* not for ever: a stub that hangs must not keep the rest from starting */
+    while (GetTickCount() - start < 120000)
+    {
+        ret = MsgWaitForMultipleObjects( 1, &pi.hProcess, FALSE, 1000, QS_ALLINPUT );
+        if (ret == WAIT_OBJECT_0 || ret == WAIT_FAILED) break;
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE ))
+        {
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+        }
+    }
+    CloseHandle( pi.hProcess );
+}
+
+/* one component, unless the person has it at its version */
+static void active_setup_component( HKEY machine, const WCHAR *id, HKEY user_root )
+{
+    WCHAR stub[2048], version[64], user_version[64];
+    DWORD installed = 1, type, cb = sizeof(installed);
+    HKEY key, user;
+    BOOL have_user;
+
+    if (RegOpenKeyExW( machine, id, 0, KEY_READ, &key )) return;
+    if (!RegQueryValueExW( key, L"IsInstalled", NULL, &type, (BYTE *)&installed, &cb ) && type == REG_DWORD && !installed)
+        goto done;
+    if (!reg_sz( key, L"StubPath", stub, sizeof(stub) ) || !stub[0]) goto done;
+    reg_sz( key, L"Version", version, sizeof(version) );
+    have_user = !RegOpenKeyExW( user_root, id, 0, KEY_READ, &user );
+    if (have_user)
+    {
+        BOOL newer;
+
+        reg_sz( user, L"Version", user_version, sizeof(user_version) );
+        RegCloseKey( user );
+        /* the person's key without a version: done, unless the machine's has one */
+        newer = version[0] && (!user_version[0] || compare_version( user_version, version ) < 0);
+        if (!newer) goto done;
+    }
+    /* marked first: a stub that fails does not run at every sign-in */
+    if (!RegCreateKeyExW( user_root, id, 0, NULL, 0, KEY_SET_VALUE, NULL, &user, NULL ))
+    {
+        if (version[0]) RegSetValueExW( user, L"Version", 0, REG_SZ, (const BYTE *)version, (lstrlenW( version ) + 1) * sizeof(WCHAR) );
+        RegCloseKey( user );
+    }
+    TRACE( "component %s, version %s\n", debugstr_w(id), debugstr_w(version) );
+#ifndef SG_MUTANT_ACTIVE_SETUP_NO_RUN
+    run_and_wait( stub );
+#endif
+done:
+    RegCloseKey( key );
+}
+
+static void run_active_setup(void)
+{
+    static const REGSAM views[2] = { KEY_WOW64_64KEY, KEY_WOW64_32KEY };
+    WCHAR name[256], *names = NULL, *grown;
+    DWORD len, index, count = 0, i, j;
+    HKEY machine[2] = { 0 }, user_root;
+    int pass, order;
+
+#ifdef SG_MUTANT_NO_ACTIVE_SETUP
+    return;
+#endif
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, ACTIVE_SETUP_KEY, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &user_root, NULL )) return;
+    for (i = 0; i < 2; i++) RegOpenKeyExW( HKEY_LOCAL_MACHINE, ACTIVE_SETUP_KEY, 0, KEY_READ | views[i], &machine[i] );
+    /* the names of both views, each once (the 64-bit view's counts) */
+    for (i = 0; i < 2; i++)
+    {
+        if (!machine[i]) continue;
+        for (index = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( machine[i], index, name, &len, NULL, NULL, NULL, NULL ); index++)
+        {
+            for (j = 0; j < count; j++) if (!wcsicmp( names + j * 256, name )) break;
+            if (j < count) continue;
+            if (!(grown = realloc( names, (count + 1) * 256 * sizeof(WCHAR) ))) break;
+            names = grown;
+            lstrcpyW( names + count * 256, name );
+            names[count * 256 + 255] = (WCHAR)i;   /* the view it came from */
+            count++;
+        }
+    }
+    /* those whose names start with '>' first, '<' last, as Windows orders them */
+    for (order = 0; order < 3; order++)
+        for (j = 0; j < count; j++)
+        {
+            const WCHAR *id = names + j * 256;
+            int o = id[0] == '>' ? 0 : id[0] == '<' ? 2 : 1;
+
+            if (o != order) continue;
+            pass = names[j * 256 + 255];
+            active_setup_component( machine[pass], id, user_root );
+        }
+    free( names );
+    for (i = 0; i < 2; i++) if (machine[i]) RegCloseKey( machine[i] );
+    RegCloseKey( user_root );
+}
+
+/* ---- packages ----------------------------------------------------------------------- */
+
+/* Stained Glass OS: the person's Start entries of the packages they see -- at sign-in, after
+ * Active Setup, and while they are signed in when the machine's packages or its Start menu change
+ * (an application the Store installs as SYSTEM, eM Client's, is in the Start menu of who is
+ * signed in at once, as on Windows).  A process of its own does it (appxdeploymentclient). */
+static void sync_packages(void)
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR cmd[] = L"rundll32.exe appxdeploymentclient.dll,SgSyncStartEntries";
+
+    si.dwFlags = STARTF_USESHOWWINDOW;
+    si.wShowWindow = SW_HIDE;
+    TRACE( "syncing the packages' Start entries\n" );
+    if (!CreateProcessW( NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi )) return;
+    CloseHandle( pi.hThread );
+    WaitForSingleObject( pi.hProcess, 60000 );
+    CloseHandle( pi.hProcess );
+}
+
+/* the deepest of the machine's package keys there is (a person cannot make them), not above
+ * *depth (0: the packages' own) */
+static HKEY open_packages_key( int *depth )
+{
+    static const WCHAR *paths[] = { L"Software\\Wine\\AppModel\\Packages", L"Software\\Wine\\AppModel", L"Software\\Wine" };
+    HKEY key;
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(paths) && i < *depth; i++)
+        if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, paths[i], 0, KEY_NOTIFY | KEY_WOW64_64KEY, &key ))
+        {
+            *depth = i;
+            return key;
+        }
+    return NULL;
+}
+
+/* (again) the notification of a change below the machine's packages: it is one-shot.  A deeper
+ * key than the one watched may be there now: that one instead (closing a watched key may signal
+ * the event once more: a sync more, nothing else). */
+static void watch_packages( HKEY *key, int *depth, HANDLE event )
+{
+    int deeper = *key ? *depth : 3;
+    HKEY other;
+
+    if (deeper && (other = open_packages_key( &deeper )))
+    {
+        if (*key) RegCloseKey( *key );
+        *key = other;
+        *depth = deeper;
+    }
+    if (!*key) return;
+#ifdef SG_MUTANT_PACKAGE_WATCH_ONCE
+    {
+        static BOOL done;
+        if (done) return;
+        done = TRUE;
+    }
+#endif
+    RegNotifyChangeKeyValue( *key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET, event, TRUE );
+}
+
+static DWORD WINAPI package_watch( void *arg )
+{
+    WCHAR programs[MAX_PATH];
+    HANDLE events[2] = { CreateEventW( NULL, FALSE, FALSE, NULL ), INVALID_HANDLE_VALUE };
+    HKEY key = NULL;
+    DWORD count, ret;
+    int depth = 3;
+
+    sync_packages();
+#ifdef SG_MUTANT_NO_PACKAGE_WATCH
+    return 0;
+#endif
+    if (!events[0]) return 0;
+    if (SUCCEEDED(SHGetFolderPathW( NULL, CSIDL_COMMON_PROGRAMS, NULL, SHGFP_TYPE_CURRENT, programs )))
+        events[1] = FindFirstChangeNotificationW( programs, TRUE, FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME );
+    count = events[1] != INVALID_HANDLE_VALUE ? 2 : 1;
+    watch_packages( &key, &depth, events[0] );
+    for (;;)
+    {
+        ret = WaitForMultipleObjects( count, events, FALSE, key ? INFINITE : 60000 );
+        if (ret == WAIT_TIMEOUT)
+        {
+            watch_packages( &key, &depth, events[0] );
+            continue;
+        }
+        if (ret != WAIT_OBJECT_0 && ret != WAIT_OBJECT_0 + 1) break;
+        /* an installer does more than one thing: once it has been quiet for a moment; each change
+         * is watched for again, and one during the sync is not missed */
+        do
+        {
+            if (ret == WAIT_OBJECT_0) watch_packages( &key, &depth, events[0] );
+            else FindNextChangeNotification( events[1] );
+        } while ((ret = WaitForMultipleObjects( count, events, FALSE, 3000 )) != WAIT_TIMEOUT && ret < WAIT_OBJECT_0 + count);
+        TRACE( "the machine's packages or Start menu changed\n" );
+        sync_packages();
+    }
+    return 0;
+}
+
+static void start_package_watch(void)
+{
+    HANDLE thread;
+
+    /* no windows on it: a thread for its waits */
+    if ((thread = CreateThread( NULL, 0, package_watch, NULL, 0, NULL ))) CloseHandle( thread );
+}
+
+/* a shell started again in the same sign-in watches the packages again */
+static void CALLBACK package_watch_timer( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    KillTimer( NULL, id );
+    start_package_watch();
