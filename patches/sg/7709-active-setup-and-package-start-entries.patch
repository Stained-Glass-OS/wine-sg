+void WINAPI SgSyncStartEntriesW( HWND hwnd, HINSTANCE instance, WCHAR *cmdline, int show )
+{
+    HRESULT hr = CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+
+    TRACE( "\n" );
+    sync_start_entries();
+    if (SUCCEEDED(hr)) CoUninitialize();
+}
