 /* ---- extraction -------------------------------------------------------------- */
 
 /* A name from the package, as a path under root: never absolute, never "..". */
@@ -4064,3 +4070,168 @@ HRESULT package_dependencies( const WCHAR *dependencies, IVectorView_Package **o
     }
     return hr;
 }
+
+/* ---- each person's Start entries -------------------------------------------------- */
+
+/* Stained Glass OS: a package is in the Start menu of every user it is registered for, as on
+ * Windows, where its entries are the package's, not files an application can delete.  Here they
+ * are shortcuts, and an installer's clean-up of its older versions' shortcuts takes them too: eM
+ * Client's MSI, run as SYSTEM by the Store, deploys its MSIX for the machine and then deletes
+ * "eM Client.lnk" from the Start menus (qa4, 2026-11-07) -- nobody had the application in Start.
+ * At each sign-in, and while the person is signed in when the machine's packages or its Start
+ * menu change (the shell runs "rundll32 appxdeploymentclient.dll,SgSyncStartEntries"), the
+ * person's own packages get back the shortcuts they lost, and a machine package whose shortcut
+ * in the machine's Start menu has gone gets one in the person's.  Those are kept in
+ * HKCU\Software\Wine\AppModel\UserShortcuts\<full name> and go when the machine's shortcut is
+ * back or the package is gone. */
+static const WCHAR user_shortcuts_keyW[] = L"Software\\Wine\\AppModel\\UserShortcuts";
+
+static BOOL any_missing( const WCHAR *multi )
+{
+    for (; multi && *multi; multi += wcslen( multi ) + 1)
+        if (GetFileAttributesW( multi ) == INVALID_FILE_ATTRIBUTES) return TRUE;
+    return FALSE;
+}
+
+static HRESULT record_manifest( const struct package_record *rec, IAppxManifestReader **manifest )
+{
+    IAppxFactory *factory;
+    IStream *stream;
+    WCHAR path[MAX_PATH];
+    HRESULT hr;
+
+    *manifest = NULL;
+    if (!rec->install_location) return E_FAIL;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\AppxManifest.xml", rec->install_location );
+    if (FAILED(hr = SHCreateStreamOnFileEx( path, STGM_READ | STGM_SHARE_DENY_WRITE, 0, FALSE, NULL, &stream )))
+        return hr;
+    if (SUCCEEDED(hr = CoCreateInstance( &CLSID_AppxFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IAppxFactory, (void **)&factory )))
+    {
+        hr = IAppxFactory_CreateManifestReader( factory, stream, manifest );
+        IAppxFactory_Release( factory );
+    }
+    IStream_Release( stream );
+    return hr;
+}
+
+/* the person's copies of a machine package's shortcuts, and their icons */
+static void drop_user_shortcuts( HKEY root, const WCHAR *full_name )
+{
+    WCHAR *list, *p;
+    HKEY key;
+
+    if (RegOpenKeyExW( root, full_name, 0, KEY_READ, &key )) return;
+    if ((list = reg_multi( key, L"Shortcuts" )))
+    {
+        for (p = list; *p; p += wcslen( p ) + 1) DeleteFileW( p );
+        free( list );
+    }
+    if ((list = reg_multi( key, L"Integration" )))
+    {
+        for (p = list; *p; p += wcslen( p ) + 1) if (!wcsncmp( p, L"I:", 2 )) DeleteFileW( p + 2 );
+        free( list );
+    }
+    RegCloseKey( key );
+    RegDeleteKeyW( root, full_name );
+    TRACE( "the person's shortcuts of %s are gone\n", debugstr_w( full_name ) );
+}
+
+struct start_sync
+{
+    HKEY user_root;           /* UserShortcuts */
+    struct strlist seen;      /* the machine packages the person sees */
+};
+
+static BOOL sync_record( struct package_record *rec, void *context )
+{
+    struct start_sync *sync = context;
+    struct strlist shortcuts = { 0 }, integration = { 0 };
+    IAppxManifestReader *manifest;
+    WCHAR path[MAX_PATH], *recorded = NULL, *tracked = NULL;
+    HKEY rec_key, key;
+
+    if (rec->framework || rec->resource_package || rec->staged || removed_for_all( rec->full_name )) return TRUE;
+    if (rec->install_location && GetFileAttributesW( rec->install_location ) == INVALID_FILE_ATTRIBUTES) return TRUE;
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", packages_keyW, rec->full_name );
+    if (RegOpenKeyExW( rec->machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, path, 0,
+                       KEY_READ | (rec->machine ? 0 : KEY_SET_VALUE) | REC_VIEW, &rec_key ))
+        return TRUE;
+    recorded = reg_multi( rec_key, L"Shortcuts" );
+
+    if (!rec->machine)
+    {
+        /* the person's own package: its shortcuts where they were */
+        if (recorded && any_missing( recorded ) && SUCCEEDED(record_manifest( rec, &manifest )))
+        {
+            create_shortcuts_in( manifest, rec, &shortcuts, &integration, CSIDL_PROGRAMS );
+            if (shortcuts.data) reg_set_multi( rec_key, L"Shortcuts", &shortcuts );
+            TRACE( "%s: its shortcuts again\n", debugstr_w( rec->full_name ) );
+            IAppxManifestReader_Release( manifest );
+        }
+        goto done;
+    }
+
+    strlist_add( &sync->seen, rec->full_name );
+    if (sync->user_root && !RegOpenKeyExW( sync->user_root, rec->full_name, 0, KEY_READ, &key ))
+    {
+        tracked = reg_multi( key, L"Shortcuts" );
+        RegCloseKey( key );
+    }
+#ifndef SG_MUTANT_STARTSYNC_NO_MACHINE
+    if (recorded && recorded[0] && any_missing( recorded ))
+    {
+        /* the machine's Start menu lost it: the person's has it */
+        if (tracked && !any_missing( tracked )) goto done;
+        if (tracked) drop_user_shortcuts( sync->user_root, rec->full_name );
+        if (!sync->user_root || FAILED(record_manifest( rec, &manifest ))) goto done;
+        create_shortcuts_in( manifest, rec, &shortcuts, &integration, CSIDL_PROGRAMS );
+        IAppxManifestReader_Release( manifest );
+        if (shortcuts.data && !RegCreateKeyExW( sync->user_root, rec->full_name, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL ))
+        {
+            reg_set_multi( key, L"Shortcuts", &shortcuts );
+            reg_set_multi( key, L"Integration", &integration );
+            RegCloseKey( key );
+            TRACE( "%s: shortcuts in the person's Start menu\n", debugstr_w( rec->full_name ) );
+        }
+    }
+    else
+#endif
+    if (tracked) drop_user_shortcuts( sync->user_root, rec->full_name );
+
+done:
+    RegCloseKey( rec_key );
+    free( recorded );
+    free( tracked );
+    free( shortcuts.data );
+    free( integration.data );
+    return TRUE;
+}
+
+void sync_start_entries(void)
+{
+    struct start_sync sync = { 0 };
+    struct strlist gone = { 0 };
+    WCHAR full_name[256];
+    DWORD len, index = 0;
+    const WCHAR *p;
+
+#ifdef SG_MUTANT_STARTSYNC_NONE
+    return;
+#endif
+    /* each person's own: never SYSTEM writing into the profiles */
+#ifndef SG_MUTANT_STARTSYNC_AS_SYSTEM
+    if (caller_is_system()) return;
+#endif
+    RegCreateKeyExW( HKEY_CURRENT_USER, user_shortcuts_keyW, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sync.user_root, NULL );
+    for_each_record( sync_record, &sync );
+    if (sync.user_root)
+    {
+        /* a machine package the person no longer sees: its copies go */
+        while (len = ARRAY_SIZE(full_name), !RegEnumKeyExW( sync.user_root, index++, full_name, &len, NULL, NULL, NULL, NULL ))
+            if (!multi_contains( sync.seen.data, full_name )) strlist_add( &gone, full_name );
+        for (p = gone.data; p && *p; p += wcslen( p ) + 1) drop_user_shortcuts( sync.user_root, p );
+        RegCloseKey( sync.user_root );
+    }
+    free( gone.data );
+    free( sync.seen.data );
+}
