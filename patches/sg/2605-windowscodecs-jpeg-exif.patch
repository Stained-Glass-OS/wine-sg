From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] windowscodecs: Exif metadata of JPEG files (app1 reader with an ifd child)

The JPEG decoder reported no metadata blocks at all, so photo viewers could not
read orientation, camera make or resolution from the Exif data. The decoder now
walks the marker segments in front of the scan and reports each Exif APP1
segment as a block read by a new app1 metadata reader. The reader checks the
Exif signature and the TIFF header (either byte order, IFD at the offset the
header gives) and exposes the first IFD as a child reader, so queries such as
/app1/ifd/{ushort=274} work. IWICMetadataBlockReader::GetReaderByIndex now
returns the failure of a block that cannot be read instead of S_OK with a NULL
reader.
---
--- a/dlls/windowscodecs/clsfactory.c
+++ b/dlls/windowscodecs/clsfactory.c
@@ -63,6 +63,7 @@ static const classinfo wic_classes[] = {
     {&CLSID_WineTgaDecoder, TgaDecoder_CreateInstance},
     {&CLSID_WICUnknownMetadataReader, UnknownMetadataReader_CreateInstance},
     {&CLSID_WICIfdMetadataReader, IfdMetadataReader_CreateInstance},
+    {&CLSID_WICApp1MetadataReader, App1MetadataReader_CreateInstance},
     {&CLSID_WICPngChrmMetadataReader, PngChrmReader_CreateInstance},
     {&CLSID_WICPngGamaMetadataReader, PngGamaReader_CreateInstance},
     {&CLSID_WICPngHistMetadataReader, PngHistReader_CreateInstance},
--- a/dlls/windowscodecs/decoder.c
+++ b/dlls/windowscodecs/decoder.c
@@ -693,7 +693,7 @@ static HRESULT WINAPI CommonDecoderFrame_Block_GetReaderByIndex(IWICMetadataBloc
     if (FAILED(hr))
         *ppIMetadataReader = NULL;
 
-    return S_OK;
+    return hr;
 }
 
 static HRESULT WINAPI CommonDecoderFrame_Block_GetEnumerator(IWICMetadataBlockReader *iface,
--- a/dlls/windowscodecs/libjpeg.c
+++ b/dlls/windowscodecs/libjpeg.c
@@ -314,12 +314,99 @@ static HRESULT CDECL jpeg_decoder_copy_pixels(struct decoder* iface, UINT frame,
         prc, stride, buffersize, buffer);
 }
 
+/* Walk the marker segments in front of the scan and report the Exif block
+ * (APP1 with the "Exif\0\0" signature); its payload is handed to the app1
+ * metadata reader, which exposes the TIFF structure as an ifd child. */
 static HRESULT CDECL jpeg_decoder_get_metadata_blocks(struct decoder* iface, UINT frame,
     UINT *count, struct decoder_block **blocks)
 {
-    FIXME("stub\n");
+    struct jpeg_decoder *This = impl_from_decoder(iface);
+    struct decoder_block *result = NULL;
+    UINT result_count = 0, result_size = 0;
+    ULONGLONG pos = 2;
+    HRESULT hr;
+    BYTE hdr[4];
+    ULONG got;
+
     *count = 0;
     *blocks = NULL;
+
+    if (frame) return WINCODEC_ERR_FRAMEMISSING;
+
+    hr = stream_seek(This->stream, 0, STREAM_SEEK_SET, NULL);
+    if (FAILED(hr)) return S_OK;
+    hr = stream_read(This->stream, hdr, 2, &got);
+    if (FAILED(hr) || got != 2 || hdr[0] != 0xff || hdr[1] != 0xd8) return S_OK;
+
+    for (;;)
+    {
+        BYTE marker, sig[6];
+        UINT len;
+
+        /* find the next marker: 0xff, optional fill 0xff bytes, then the code */
+        do
+        {
+            hr = stream_read(This->stream, hdr, 1, &got);
+            if (FAILED(hr) || got != 1) goto done;
+            pos++;
+        } while (hdr[0] != 0xff);
+        do
+        {
+            hr = stream_read(This->stream, &marker, 1, &got);
+            if (FAILED(hr) || got != 1) goto done;
+            pos++;
+        } while (marker == 0xff);
+
+        if (marker == 0xd9 || marker == 0xda) break; /* EOI, SOS: the metadata is before the scan */
+        if (marker == 0x00 || marker == 0x01 || (marker >= 0xd0 && marker <= 0xd8)) continue; /* no length */
+
+        hr = stream_read(This->stream, hdr, 2, &got);
+        if (FAILED(hr) || got != 2) break;
+        pos += 2;
+        len = (hdr[0] << 8) | hdr[1];
+        if (len < 2) break;
+        len -= 2;
+
+        if (marker == 0xe1 && len > sizeof(sig))
+        {
+            hr = stream_read(This->stream, sig, sizeof(sig), &got);
+            if (FAILED(hr) || got != sizeof(sig)) break;
+#ifdef SG_MUTANT_JPEG_APP1_ANY
+            if (1)
+#else
+            if (!memcmp(sig, "Exif\0\0", 6))
+#endif
+            {
+                if (result_count == result_size)
+                {
+                    struct decoder_block *new_blocks;
+                    result_size = result_size ? result_size * 2 : 4;
+                    new_blocks = realloc(result, result_size * sizeof(*new_blocks));
+                    if (!new_blocks)
+                    {
+                        free(result);
+                        return E_OUTOFMEMORY;
+                    }
+                    result = new_blocks;
+                }
+                memset(&result[result_count], 0, sizeof(*result));
+                result[result_count].offset = pos;
+                result[result_count].length = len;
+                result[result_count].options = DECODER_BLOCK_READER_CLSID;
+                result[result_count].reader_clsid = CLSID_WICApp1MetadataReader;
+                result_count++;
+            }
+            hr = stream_seek(This->stream, pos + len, STREAM_SEEK_SET, NULL);
+        }
+        else
+            hr = stream_seek(This->stream, len, STREAM_SEEK_CUR, NULL);
+        if (FAILED(hr)) break;
+        pos += len;
+    }
+
+done:
+    *count = result_count;
+    *blocks = result;
     return S_OK;
 }
 
--- a/dlls/windowscodecs/metadatahandler.c
+++ b/dlls/windowscodecs/metadatahandler.c
@@ -1174,3 +1174,129 @@ HRESULT IfdMetadataReader_CreateInstance(REFIID iid, void **ppv)
 {
     return MetadataReader_Create(&IfdMetadataReader_Vtbl, iid, ppv);
 }
+
+/* The app1 block of a JPEG file: the "Exif\0\0" signature followed by a TIFF
+ * structure. It has a single item, the first IFD, as a reader of its own
+ * (queries address it as /app1/ifd). Offsets inside the IFD are relative to
+ * the TIFF header, so the IFD reader gets a stream that starts there. */
+static HRESULT LoadApp1Metadata(IStream *input, const GUID *preferred_vendor,
+    DWORD persist_options, MetadataItem **items, DWORD *item_count)
+{
+    static const BYTE exif_sig[6] = { 'E', 'x', 'i', 'f', 0, 0 };
+    BYTE sig[6], chunk[512];
+    IStream *tiff = NULL;
+    IWICMetadataReader *ifd = NULL;
+    IWICPersistStream *persist = NULL;
+    MetadataItem *result;
+    LARGE_INTEGER pos;
+    ULONG bytesread, written;
+    ULARGE_INTEGER total;
+    DWORD ifd_options;
+    BOOL big_endian;
+    HRESULT hr;
+    UINT32 ifd_offset;
+    BYTE head[8];
+
+    TRACE("\n");
+
+    hr = IStream_Read(input, sig, sizeof(sig), &bytesread);
+    if (FAILED(hr)) return hr;
+    if (bytesread != sizeof(sig) || memcmp(sig, exif_sig, sizeof(sig)))
+        return WINCODEC_ERR_BADMETADATAHEADER;
+
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &tiff);
+    if (FAILED(hr)) return hr;
+
+    total.QuadPart = 0;
+    for (;;)
+    {
+        hr = IStream_Read(input, chunk, sizeof(chunk), &bytesread);
+        if (FAILED(hr)) goto fail;
+        if (!bytesread) break;
+        hr = IStream_Write(tiff, chunk, bytesread, &written);
+        if (FAILED(hr)) goto fail;
+        total.QuadPart += written;
+    }
+
+    pos.QuadPart = 0;
+    IStream_Seek(tiff, pos, STREAM_SEEK_SET, NULL);
+    hr = IStream_Read(tiff, head, sizeof(head), &bytesread);
+    if (FAILED(hr)) goto fail;
+    hr = WINCODEC_ERR_BADMETADATAHEADER;
+    if (bytesread != sizeof(head)) goto fail;
+
+    if (head[0] == 'I' && head[1] == 'I' && head[2] == 42 && head[3] == 0)
+    {
+        big_endian = FALSE;
+        ifd_offset = head[4] | (head[5] << 8) | (head[6] << 16) | ((UINT32)head[7] << 24);
+    }
+    else if (head[0] == 'M' && head[1] == 'M' && head[2] == 0 && head[3] == 42)
+    {
+        big_endian = TRUE;
+        ifd_offset = head[7] | (head[6] << 8) | (head[5] << 16) | ((UINT32)head[4] << 24);
+    }
+    else
+        goto fail;
+
+    if (ifd_offset < 8 || ifd_offset >= total.QuadPart) goto fail;
+
+#ifdef SG_MUTANT_APP1_IFD_AT_8
+    ifd_offset = 8;
+#endif
+    pos.QuadPart = ifd_offset;
+    hr = IStream_Seek(tiff, pos, STREAM_SEEK_SET, NULL);
+    if (FAILED(hr)) goto fail;
+
+#ifdef SG_MUTANT_APP1_LITTLE_ONLY
+    big_endian = FALSE;
+#endif
+    ifd_options = big_endian ? WICPersistOptionBigEndian : WICPersistOptionLittleEndian;
+    ifd_options |= WICPersistOptionNoCacheStream;
+
+    hr = IfdMetadataReader_CreateInstance(&IID_IWICMetadataReader, (void **)&ifd);
+    if (FAILED(hr)) goto fail;
+    hr = IWICMetadataReader_QueryInterface(ifd, &IID_IWICPersistStream, (void **)&persist);
+    if (FAILED(hr)) goto fail;
+    hr = IWICPersistStream_LoadEx(persist, tiff, NULL, ifd_options);
+    if (FAILED(hr)) goto fail;
+
+    result = calloc(1, sizeof(*result));
+    if (!result)
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    result->id.vt = VT_CLSID;
+    result->id.puuid = CoTaskMemAlloc(sizeof(GUID));
+    if (!result->id.puuid)
+    {
+        free(result);
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    *result->id.puuid = GUID_MetadataFormatIfd;
+    result->value.vt = VT_UNKNOWN;
+    result->value.punkVal = (IUnknown *)ifd;
+    IWICMetadataReader_AddRef(ifd);
+
+    *items = result;
+    *item_count = 1;
+    hr = S_OK;
+
+fail:
+    if (persist) IWICPersistStream_Release(persist);
+    if (ifd) IWICMetadataReader_Release(ifd);
+    IStream_Release(tiff);
+    return hr;
+}
+
+static const MetadataHandlerVtbl App1MetadataReader_Vtbl = {
+    0,
+    &CLSID_WICApp1MetadataReader,
+    LoadApp1Metadata
+};
+
+HRESULT App1MetadataReader_CreateInstance(REFIID iid, void **ppv)
+{
+    return MetadataReader_Create(&App1MetadataReader_Vtbl, iid, ppv);
+}
--- a/dlls/windowscodecs/regsvr.c
+++ b/dlls/windowscodecs/regsvr.c
@@ -1580,6 +1580,21 @@ static const struct reader_containers ifd_containers[] = {
     { NULL } /* list terminator */
 };
 
+static const BYTE exif_signature[] = { 'E', 'x', 'i', 'f', 0, 0 };
+
+static const struct metadata_pattern app1_metadata_pattern[] = {
+    { 0, 6, exif_signature, mask_all, 0 },
+    { 0 }
+};
+
+static const struct reader_containers app1_containers[] = {
+    {
+        &GUID_ContainerFormatJpeg,
+        app1_metadata_pattern
+    },
+    { NULL } /* list terminator */
+};
+
 static const BYTE tEXt[] = "tEXt";
 
 static const struct metadata_pattern pngtext_metadata_pattern[] = {
@@ -1750,6 +1765,16 @@ static struct regsvr_metadatareader const metadatareader_list[] = {
         1, 1, 0,
         ifd_containers
     },
+    {   &CLSID_WICApp1MetadataReader,
+        "The Wine Project",
+        "App1 Reader",
+        "1.0.0.0",
+        "1.0.0.0",
+        &GUID_VendorMicrosoft,
+        &GUID_MetadataFormatApp1,
+        0, 0, 0,
+        app1_containers
+    },
     {   &CLSID_WICPngChrmMetadataReader,
         "The Wine Project",
         "Chunk cHRM Reader",
--- a/dlls/windowscodecs/wincodecs_private.h
+++ b/dlls/windowscodecs/wincodecs_private.h
@@ -217,6 +217,7 @@ extern HRESULT MetadataReader_Create(const MetadataHandlerVtbl *vtable, REFIID i
 
 extern HRESULT UnknownMetadataReader_CreateInstance(REFIID iid, void** ppv);
 extern HRESULT IfdMetadataReader_CreateInstance(REFIID iid, void **ppv);
+extern HRESULT App1MetadataReader_CreateInstance(REFIID iid, void **ppv);
 extern HRESULT PngChrmReader_CreateInstance(REFIID iid, void** ppv);
 extern HRESULT PngGamaReader_CreateInstance(REFIID iid, void** ppv);
 extern HRESULT PngHistReader_CreateInstance(REFIID iid, void** ppv);
