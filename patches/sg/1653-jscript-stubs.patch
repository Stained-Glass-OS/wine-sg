+/* GetObject(pathname, class) (Stained Glass OS 1653): with no path the
+ * running object of the class (GetActiveObject), with an empty path a new
+ * one, else a new one that loads the file (IPersistFile). */
+#ifdef SG_MUTANT_URI_E_FAIL
+#define SG_URI_ERROR E_FAIL
+#else
+#define SG_URI_ERROR JS_E_INVALID_URI_CODING
+#endif
+
+static HRESULT get_object_of_class(script_ctx_t *ctx, jsval_t path, jsval_t class, jsval_t *r)
+{
+    const WCHAR *path_str = NULL, *class_str;
+    jsstr_t *pstr = NULL, *cstr;
+    IPersistFile *persist;
+    IUnknown *unk = NULL;
+    IDispatch *disp;
+    HRESULT hres;
+    CLSID clsid;
+
+    hres = to_flat_string(ctx, class, &cstr, &class_str);
+    if(FAILED(hres))
+        return hres;
+    hres = CLSIDFromProgID(class_str, &clsid);
+    if(FAILED(hres))
+        hres = CLSIDFromString(class_str, &clsid);
+    jsstr_release(cstr);
+    if(FAILED(hres))
+        return JS_E_CANNOT_CREATE_OBJ;
+
+    if(!is_undefined(path) && !is_null(path)) {
+        hres = to_flat_string(ctx, path, &pstr, &path_str);
+        if(FAILED(hres))
+            return hres;
+    }
+
+    if(!path_str) {
+        hres = GetActiveObject(&clsid, NULL, &unk);
+    }else {
+        hres = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER|CLSCTX_LOCAL_SERVER, &IID_IUnknown, (void**)&unk);
+        if(SUCCEEDED(hres) && *path_str) {
+            hres = IUnknown_QueryInterface(unk, &IID_IPersistFile, (void**)&persist);
+            if(SUCCEEDED(hres)) {
+                hres = IPersistFile_Load(persist, path_str, STGM_READ);
+                IPersistFile_Release(persist);
+            }
+        }
+    }
+    if(pstr)
+        jsstr_release(pstr);
+    if(FAILED(hres)) {
+        if(unk)
+            IUnknown_Release(unk);
+        return JS_E_CANNOT_CREATE_OBJ;
+    }
+
+    hres = IUnknown_QueryInterface(unk, &IID_IDispatch, (void**)&disp);
+    IUnknown_Release(unk);
+    if(FAILED(hres))
+        return JS_E_CANNOT_CREATE_OBJ;
+    if(r)
+        *r = jsval_disp(disp);
+    else
+        IDispatch_Release(disp);
+    return S_OK;
+}
