From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: SHUpdateImage, SHValidateUNC, DDE wild connect (3703)

shell32: SHUpdateImage, SHValidateUNC, DDE wild connect

SHUpdateImageW and SHUpdateImageA now tell the shell that an icon of the
system image list changed (an update-image notice carrying the image index
as a SHChangeDWORDAsIDList). SHValidateUNC connects to the share of the UNC
path through WNetUseConnectionW with the documented flags (connect to a
drive letter, no UI, print share, persistent) and returns whether the share
answered; with the connect flag the path becomes the drive. The shell's DDE
server answers XTYP_WILDCONNECT with the array of its service and topic pairs
that match the service and topic asked for (null matches any).
---
diff --git a/dlls/shell32/dde.c b/dlls/shell32/dde.c
index eea8b8e..7e92c74 100644
--- a/dlls/shell32/dde.c
+++ b/dlls/shell32/dde.c
@@ -85,10 +85,28 @@ static inline void Dde_OnConnectConfirm(HCONV hconv, HSZ hszTopic, HSZ hszServic
     TRACE( "%p %s %s\n", hconv, debugstr_hsz(hszTopic), debugstr_hsz(hszService) );
 }
 
-static inline BOOL Dde_OnWildConnect(HSZ hszTopic, HSZ hszService)
+/* XTYP_WILDCONNECT: a null service or topic matches any; the answer is the array of the
+ * service and topic pairs the server has that match, ended by a null pair */
+static inline HDDEDATA Dde_OnWildConnect(HSZ hszTopic, HSZ hszService)
 {
-    FIXME("stub\n");
-    return FALSE;
+    HSZPAIR pairs[5] = { { 0 } };
+    unsigned int i, n = 0;
+    struct { HSZ topic, service; } have[] =
+    {
+        { hszProgmanTopic, hszProgmanService }, { hszProgmanTopic, hszAppProperties },
+        { hszShell, hszFolders }, { hszShell, hszAppProperties },
+    };
+
+    for (i = 0; i < ARRAY_SIZE(have); i++)
+    {
+        if (hszTopic && hszTopic != have[i].topic) continue;
+        if (hszService && hszService != have[i].service) continue;
+        pairs[n].hszSvc = have[i].service;
+        pairs[n].hszTopic = have[i].topic;
+        n++;
+    }
+    if (!n) return NULL;
+    return DdeCreateDataHandle(dwDDEInst, (BYTE *)pairs, (n + 1) * sizeof(HSZPAIR), 0, 0, 0, 0);
 }
 
 static WCHAR *combine_path(const WCHAR *directory, const WCHAR *name, const WCHAR *extension, BOOL sanitize)
@@ -484,7 +502,7 @@ static HDDEDATA CALLBACK DdeCallback(
         Dde_OnConnectConfirm(hconv, hsz1, hsz2);
         return NULL;
     case XTYP_WILDCONNECT:
-        return (HDDEDATA)(DWORD_PTR)Dde_OnWildConnect(hsz1, hsz2);
+        return Dde_OnWildConnect(hsz1, hsz2);
     case XTYP_REQUEST:
         return Dde_OnRequest(uFmt, hconv, hsz1, hsz2);
     case XTYP_EXECUTE:
diff --git a/dlls/shell32/shellord.c b/dlls/shell32/shellord.c
index 0d99897..47357e9 100644
--- a/dlls/shell32/shellord.c
+++ b/dlls/shell32/shellord.c
@@ -1575,8 +1575,39 @@ DWORD WINAPI RLBuildListOfPaths (void)
  */
 BOOL WINAPI SHValidateUNC (HWND hwndOwner, PWSTR pszFile, UINT fConnect)
 {
-	FIXME("(%p, %s, 0x%08x): stub\n", hwndOwner, debugstr_w(pszFile), fConnect);
-	return FALSE;
+    typedef DWORD (WINAPI *use_fn)(HWND, NETRESOURCEW *, const WCHAR *, const WCHAR *, DWORD, WCHAR *, DWORD *, DWORD *);
+    NETRESOURCEW nr = { 0 };
+    WCHAR share[MAX_PATH], local[MAX_PATH] = L"", *p;
+    DWORD size = ARRAY_SIZE(local), result, ret, flags = 0;
+    use_fn use;
+    HMODULE mpr;
+
+    TRACE("(%p, %s, 0x%08x)\n", hwndOwner, debugstr_w(pszFile), fConnect);
+
+    /* VALIDATEUNC_CONNECT 1, NOUI 2, PRINT 4, PERSIST 8 */
+    if (!pszFile || !PathIsUNCW(pszFile) || (fConnect & ~0xf)) return FALSE;
+#ifdef SG_MUTANT_VALIDATE_UNC
+    return TRUE;
+#endif
+
+    /* the connection is to the share: \\server\share */
+    lstrcpynW(share, pszFile, ARRAY_SIZE(share));
+    if ((p = wcschr(share + 2, '\\')) && (p = wcschr(p + 1, '\\'))) *p = 0;
+
+    if (!(mpr = LoadLibraryW(L"mpr.dll"))) return FALSE;
+    if (!(use = (use_fn)GetProcAddress(mpr, "WNetUseConnectionW"))) { FreeLibrary(mpr); return FALSE; }
+    nr.dwType = (fConnect & 4) ? RESOURCETYPE_PRINT : RESOURCETYPE_DISK;
+    nr.lpRemoteName = share;
+    if (!(fConnect & 2)) flags |= CONNECT_INTERACTIVE;
+    if (fConnect & 8) flags |= CONNECT_UPDATE_PROFILE;
+    /* without the connect flag no drive letter is wanted: the share only has to answer */
+    if (!(fConnect & 1) || (fConnect & 4)) flags |= CONNECT_REDIRECT;
+    ret = use((fConnect & 2) ? NULL : hwndOwner, &nr, NULL, NULL, flags, local, &size, &result);
+    FreeLibrary(mpr);
+    if (ret != NO_ERROR && ret != ERROR_ALREADY_ASSIGNED) return FALSE;
+    /* the path is now the drive it is mapped to */
+    if ((fConnect & 1) && local[0] && lstrlenW(local) <= lstrlenW(pszFile)) lstrcpyW(pszFile, local);
+    return TRUE;
 }
 
 /************************************************************************
@@ -2039,7 +2070,18 @@ BOOL WINAPI SHFindFiles( LPCITEMIDLIST pidlFolder, LPCITEMIDLIST pidlSaveFile )
  */
 void WINAPI SHUpdateImageW(LPCWSTR pszHashItem, int iIndex, UINT uFlags, int iImageIndex)
 {
-    FIXME("%s, %d, 0x%x, %d - stub\n", debugstr_w(pszHashItem), iIndex, uFlags, iImageIndex);
+    TRACE("%s, %d, 0x%x, %d\n", debugstr_w(pszHashItem), iIndex, uFlags, iImageIndex);
+
+    /* the views that show the image are told its index in the system image list changed */
+#ifndef SG_MUTANT_UPDATEIMAGE
+    {
+        /* SHChangeDWORDAsIDList: a size, the image index, a second number, the end of the list */
+#include "pshpack1.h"
+        struct { USHORT cb; DWORD index; DWORD flags; USHORT end; } id = { 10, iImageIndex, uFlags, 0 };
+#include "poppack.h"
+        SHChangeNotify(SHCNE_UPDATEIMAGE, SHCNF_IDLIST | SHCNF_FLUSH, &id, NULL);
+    }
+#endif
 }
 
 /*************************************************************************
@@ -2049,7 +2091,8 @@ void WINAPI SHUpdateImageW(LPCWSTR pszHashItem, int iIndex, UINT uFlags, int iIm
  */
 VOID WINAPI SHUpdateImageA(LPCSTR pszHashItem, INT iIndex, UINT uFlags, INT iImageIndex)
 {
-    FIXME("%s, %d, 0x%x, %d - stub\n", debugstr_a(pszHashItem), iIndex, uFlags, iImageIndex);
+    TRACE("%s, %d, 0x%x, %d\n", debugstr_a(pszHashItem), iIndex, uFlags, iImageIndex);
+    SHUpdateImageW(NULL, iIndex, uFlags, iImageIndex);
 }
 
 INT WINAPI SHHandleUpdateImage(LPCITEMIDLIST pidlExtra)
