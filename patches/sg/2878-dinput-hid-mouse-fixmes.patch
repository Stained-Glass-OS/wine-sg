From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dinput: drop FIXMEs on ignorable HID input and handle MOUSE_VIRTUAL_DESKTOP

Pressed usages outside the button / PID pages, PID usages without a device state bit and HID devices with other top level usages are ignored (TRACE); unreachable enum_object filter becomes a WARN; absolute raw mouse motion is normalized over the primary monitor or, with MOUSE_VIRTUAL_DESKTOP, over the virtual desktop.
---
diff --git a/dlls/dinput/joystick_hid.c b/dlls/dinput/joystick_hid.c
index 3b27f39..c5a20c2 100644
--- a/dlls/dinput/joystick_hid.c
+++ b/dlls/dinput/joystick_hid.c
@@ -499,7 +499,8 @@ static BOOL enum_object( struct hid_joystick *impl, const DIPROPHEADER *filter,
         if (LOWORD( filter->dwObj ) != instance->wUsage) return DIENUM_CONTINUE;
         return callback( &impl->base, index, caps, instance, data );
     default:
-        FIXME( "unimplemented filter dwHow %#lx dwObj %#lx\n", filter->dwHow, filter->dwObj );
+        /* callers reject dwHow values above DIPH_BYUSAGE before enumerating */
+        WARN( "invalid filter dwHow %#lx dwObj %#lx\n", filter->dwHow, filter->dwObj );
         break;
     }
 
@@ -1289,8 +1290,9 @@ static HRESULT hid_joystick_read( IDirectInputDevice8W *iface )
             while (count--)
             {
                 usages = impl->usages_buf + count;
+                /* only buttons contribute to the device state, other pressed usages are ignored */
                 if (usages->UsagePage != HID_USAGE_PAGE_BUTTON)
-                    FIXME( "unimplemented usage page %x.\n", usages->UsagePage );
+                    TRACE( "ignoring usage page %x usage %x.\n", usages->UsagePage, usages->Usage );
                 else if (usages->Usage >= 128)
                     FIXME( "ignoring extraneous button %d.\n", usages->Usage );
                 else
@@ -1314,7 +1316,7 @@ static HRESULT hid_joystick_read( IDirectInputDevice8W *iface )
             {
                 USAGE_AND_PAGE *button = impl->usages_buf + count;
                 if (button->UsagePage != HID_USAGE_PAGE_PID)
-                    FIXME( "unimplemented usage page %#04x.\n", button->UsagePage );
+                    TRACE( "ignoring usage page %#04x usage %#04x.\n", button->UsagePage, button->Usage );
                 else switch (button->Usage)
                 {
                 case PID_USAGE_DEVICE_PAUSED: device_state |= DIGFFS_PAUSED; break;
@@ -1323,7 +1325,7 @@ static HRESULT hid_joystick_read( IDirectInputDevice8W *iface )
                 case PID_USAGE_ACTUATOR_OVERRIDE_SWITCH: device_state |= DIGFFS_USERFFSWITCHON; break;
                 case PID_USAGE_ACTUATOR_POWER: device_state |= DIGFFS_POWERON; break;
                 case PID_USAGE_EFFECT_PLAYING: effect_state = DIEGES_PLAYING; break;
-                default: FIXME( "unimplemented usage %#04x\n", button->Usage ); break;
+                default: TRACE( "ignoring PID usage %#04x\n", button->Usage ); break;
                 }
             }
             if (!(device_state & DIGFFS_ACTUATORSON)) device_state |= DIGFFS_ACTUATORSOFF;
@@ -1446,7 +1448,8 @@ static HRESULT hid_joystick_device_try_open( const WCHAR *path, HANDLE *device,
     case MAKELONG( HID_USAGE_GENERIC_KEYBOARD, HID_USAGE_PAGE_GENERIC ):  goto failed;
     case MAKELONG( HID_USAGE_GENERIC_GAMEPAD, HID_USAGE_PAGE_GENERIC ): type = DI8DEVTYPE_GAMEPAD; break;
     case MAKELONG( HID_USAGE_GENERIC_JOYSTICK, HID_USAGE_PAGE_GENERIC ): type = DI8DEVTYPE_JOYSTICK; break;
-    default: FIXME( "device usage %04x:%04x not implemented!\n", caps->UsagePage, caps->Usage); goto failed;
+    /* other top level usages (consumer controls, vendor pages, ...) are not game controllers */
+    default: TRACE( "ignoring device with usage %04x:%04x\n", caps->UsagePage, caps->Usage ); goto failed;
     }
 
     if (!HidD_GetProductString( device_file, instance->tszInstanceName, MAX_PATH * sizeof(WCHAR) )) goto failed;
diff --git a/dlls/dinput/mouse.c b/dlls/dinput/mouse.c
index d43dcbe..e7b9628 100644
--- a/dlls/dinput/mouse.c
+++ b/dlls/dinput/mouse.c
@@ -122,8 +122,6 @@ void dinput_mouse_rawinput_hook( IDirectInputDevice8W *iface, WPARAM wparam, LPA
 
     TRACE( "iface %p, wparam %#Ix, lparam %#Ix, ri %p.\n", iface, wparam, lparam, ri );
 
-    if (ri->data.mouse.usFlags & MOUSE_VIRTUAL_DESKTOP)
-        FIXME( "Unimplemented MOUSE_VIRTUAL_DESKTOP flag\n" );
     if (ri->data.mouse.usFlags & MOUSE_ATTRIBUTES_CHANGED)
         FIXME( "Unimplemented MOUSE_ATTRIBUTES_CHANGED flag\n" );
 
@@ -134,6 +132,21 @@ void dinput_mouse_rawinput_hook( IDirectInputDevice8W *iface, WPARAM wparam, LPA
     rel.y = ri->data.mouse.lLastY;
     if (ri->data.mouse.usFlags & MOUSE_MOVE_ABSOLUTE)
     {
+        /* absolute coordinates are normalized to 0..65535 over the primary monitor,
+         * or over the whole virtual desktop with MOUSE_VIRTUAL_DESKTOP */
+        if (ri->data.mouse.usFlags & MOUSE_VIRTUAL_DESKTOP)
+        {
+            RECT rect = {GetSystemMetrics( SM_XVIRTUALSCREEN ), GetSystemMetrics( SM_YVIRTUALSCREEN )};
+            rect.right = rect.left + GetSystemMetrics( SM_CXVIRTUALSCREEN );
+            rect.bottom = rect.top + GetSystemMetrics( SM_CYVIRTUALSCREEN );
+            rel.x = rect.left + MulDiv( rel.x, rect.right - rect.left, 65535 );
+            rel.y = rect.top + MulDiv( rel.y, rect.bottom - rect.top, 65535 );
+        }
+        else
+        {
+            rel.x = MulDiv( rel.x, GetSystemMetrics( SM_CXSCREEN ), 65535 );
+            rel.y = MulDiv( rel.y, GetSystemMetrics( SM_CYSCREEN ), 65535 );
+        }
         GetCursorPos( &pt );
         rel.x -= pt.x;
         rel.y -= pt.y;
