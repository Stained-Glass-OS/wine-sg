-static HRESULT WINAPI IPersistStreamImpl_Load(IPersistStream *iface, IStream *pStm)
+static HRESULT parse_script_event(DirectMusicScriptTrack *This, IStream *stream,
+        struct chunk_entry *list)
+{
+    struct chunk_entry chunk = {.parent = list};
+    DMUS_IO_SCRIPTTRACK_EVENTHEADER header = {0};
+    IDirectMusicObject *object = NULL;
+    IDirectMusicScript *script = NULL;
+    struct script_event *event;
+    WCHAR *routine = NULL;
+    BOOL have_header = FALSE;
+    HRESULT hr;
+
+    while ((hr = stream_next_chunk(stream, &chunk)) == S_OK)
+    {
+        switch (MAKE_IDTYPE(chunk.id, chunk.type))
+        {
+        case DMUS_FOURCC_SCRIPTTRACKEVENTHEADER_CHUNK:
+            hr = stream_chunk_get_data(stream, &chunk, &header, sizeof(header));
+            have_header = SUCCEEDED(hr);
+            break;
+        case DMUS_FOURCC_SCRIPTTRACKEVENTNAME_CHUNK:
+            if (!(routine = calloc(1, chunk.size + sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+            else hr = stream_chunk_get_data(stream, &chunk, routine, chunk.size);
+            break;
+        case MAKE_IDTYPE(FOURCC_LIST, DMUS_FOURCC_REF_LIST):
+            if (SUCCEEDED(hr = dmobj_parsereference(stream, &chunk, &object)))
+            {
+                hr = IDirectMusicObject_QueryInterface(object, &IID_IDirectMusicScript, (void **)&script);
+                IDirectMusicObject_Release(object);
+            }
+            break;
+        default:
+            TRACE("Ignoring chunk %s\n", debugstr_chunk(&chunk));
+            break;
+        }
+        if (FAILED(hr)) goto fail;
+    }
+    if (FAILED(hr)) goto fail;
+
+    if (!have_header || !routine || !script)
+    {
+        hr = DMUS_E_UNSUPPORTED_STREAM;
+        goto fail;
+    }
+    if (!(event = calloc(1, sizeof(*event))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
+    event->header = header;
+    event->routine = routine;
+    event->script = script;
+    list_add_tail(&This->events, &event->entry);
+    return S_OK;
+
+fail:
+    if (script) IDirectMusicScript_Release(script);
+    free(routine);
+    return hr;
+}
+
+static HRESULT WINAPI IPersistStreamImpl_Load(IPersistStream *iface, IStream *stream)
 {
-	FIXME(": Loading not implemented yet\n");
-	return S_OK;
+    DirectMusicScriptTrack *This = impl_from_IPersistStream(iface);
+    struct chunk_entry scrt = {0}, scrl = {.parent = &scrt}, scre = {.parent = &scrl};
+    HRESULT hr;
+
+    TRACE("(%p, %p)\n", This, stream);
+
+    if (!stream) return E_POINTER;
+    if ((hr = stream_get_chunk(stream, &scrt)) != S_OK) return hr;
+    if (scrt.id != FOURCC_LIST || scrt.type != DMUS_FOURCC_SCRIPTTRACK_LIST)
+        return DMUS_E_UNSUPPORTED_STREAM;
+
+    if (FAILED(hr = stream_next_chunk(stream, &scrl))) return hr;
+    if (scrl.id != FOURCC_LIST || scrl.type != DMUS_FOURCC_SCRIPTTRACKEVENTS_LIST)
+        return DMUS_E_UNSUPPORTED_STREAM;
+
+    while ((hr = stream_next_chunk(stream, &scre)) == S_OK)
+    {
+        if (scre.id != FOURCC_LIST || scre.type != DMUS_FOURCC_SCRIPTTRACKEVENT_LIST) continue;
+        if (FAILED(hr = parse_script_event(This, stream, &scre))) return hr;
+    }
+    return SUCCEEDED(hr) ? S_OK : hr;
 }
 
