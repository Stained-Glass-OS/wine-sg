@@ -84,41 +99,119 @@ static ULONG WINAPI script_track_Release(IDirectMusicTrack8 *iface)
 
     TRACE("(%p) ref=%ld\n", This, ref);
 
-    if (!ref) free(This);
+    if (!ref) {
+        struct script_event *event, *next;
+
+        LIST_FOR_EACH_ENTRY_SAFE(event, next, &This->events, struct script_event, entry)
+        {
+            list_remove(&event->entry);
+            if (event->script) IDirectMusicScript_Release(event->script);
+            free(event->routine);
+            free(event);
+        }
+        free(This);
+    }
 
     return ref;
 }
 
