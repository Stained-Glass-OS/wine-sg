From: Stained Glass OS contributors
Subject: ntdll: every user of a shared prefix has the logon variables

A Windows logon defines APPDATA, LOCALAPPDATA, HOMEDRIVE and HOMEPATH from the
profile. On a shared prefix wineboot writes them into Volatile Environment
only for SYSTEM, the owner, so every other user's programs had no %APPDATA%
or %LOCALAPPDATA%: the .NET SDK's NuGet failed every restore ("Value cannot be
null. (Parameter 'path1')"). They are now defined from the profile, beside
USERPROFILE (0018); Volatile Environment, when present, still sets them.

--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1177,6 +1177,39 @@
  * helper for add_registry_environment().
  * Note that Windows happily truncates the value if it's too big.
  */
+/* Stained Glass OS: the variables a Windows logon defines from the profile
+ * (Volatile Environment): APPDATA, LOCALAPPDATA, HOMEDRIVE and HOMEPATH. On a
+ * shared prefix wineboot writes them only for SYSTEM, the owner, and every
+ * other user's programs had no %APPDATA% or %LOCALAPPDATA% -- NuGet ("Value
+ * cannot be null. (Parameter 'path1')", the .NET SDK) and many installers.
+ * Volatile Environment, when present, sets them again below. */
+
+static void sg_set_profile_vars( WCHAR **env, SIZE_T *pos, SIZE_T *size, const WCHAR *profile )
+{
+    static const WCHAR appdataW[] = {'A','P','P','D','A','T','A',0};
+    static const WCHAR localW[] = {'L','O','C','A','L','A','P','P','D','A','T','A',0};
+    static const WCHAR homedriveW[] = {'H','O','M','E','D','R','I','V','E',0};
+    static const WCHAR homepathW[] = {'H','O','M','E','P','A','T','H',0};
+    static const WCHAR roamingW[] = {'\\','A','p','p','D','a','t','a','\\','R','o','a','m','i','n','g',0};
+    static const WCHAR localdirW[] = {'\\','A','p','p','D','a','t','a','\\','L','o','c','a','l',0};
+    size_t len = wcslen( profile );
+    WCHAR *buf, drive[3];
+
+    if (!(buf = malloc( (len + 20) * sizeof(WCHAR) ))) return;
+    memcpy( buf, profile, len * sizeof(WCHAR) );
+    memcpy( buf + len, roamingW, sizeof(roamingW) );
+    set_env_var( env, pos, size, appdataW, wcslen(appdataW), buf );
+    memcpy( buf + len, localdirW, sizeof(localdirW) );
+    set_env_var( env, pos, size, localW, wcslen(localW), buf );
+    if (len > 2 && profile[1] == ':')
+    {
+        drive[0] = profile[0]; drive[1] = ':'; drive[2] = 0;
+        set_env_var( env, pos, size, homedriveW, wcslen(homedriveW), drive );
+        set_env_var( env, pos, size, homepathW, wcslen(homepathW), profile + 2 );
+    }
+    free( buf );
+}
+
 static void add_registry_variables( WCHAR **env, SIZE_T *pos, SIZE_T *size, HANDLE key )
 {
     static const WCHAR pathW[] = {'P','A','T','H'};
@@ -1318,6 +1351,7 @@
                 path[len] = '\\';
                 path[len + 1 + ntdll_umbstowcs( user_name, ulen, path + len + 1, ulen )] = 0;
                 set_env_var( env, pos, size, userprofW, wcslen(userprofW), path );
+                sg_set_profile_vars( env, pos, size, path );
                 free( path );
             }
             free( value );
