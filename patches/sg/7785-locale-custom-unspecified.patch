From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] kernelbase: GetLocaleInfoEx answers for any well-formed locale name, as Windows 10 does

Windows 10 answers GetLocaleInfoEx for any well-formed locale name it
has no data of its own for, as a "custom unspecified" locale (LCID
0x1000). .NET 5 and later on Windows create an ICU culture only when
GetLocaleInfoEx(name, LOCALE_SNAME) succeeds, so new CultureInfo("sr-SP")
threw CultureNotFoundException, and DevToys 2 stopped at its start.
---
diff --git a/dlls/kernelbase/locale.c b/dlls/kernelbase/locale.c
index b570d4c..4f6aff2 100644
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -6343,6 +6343,103 @@ INT WINAPI DECLSPEC_HOTPATCH GetLocaleInfoW( LCID lcid, LCTYPE lctype, WCHAR *bu
 }
 
 
+/* Stained Glass OS: Windows 10 answers for any well-formed locale name it has
+ * no data of its own for (a "custom unspecified" locale, LCID 0x1000): the
+ * name, in its canonical case, and the data of the nearest locale it knows
+ * (its language), or the invariant locale's. .NET 5 and later on Windows
+ * take a culture from ICU only when GetLocaleInfoEx(name, LOCALE_SNAME)
+ * succeeds, so new CultureInfo("sr-SP") threw CultureNotFoundException
+ * (DevToys 2 stopped at its start), where Windows and Linux create it. */
+static BOOL canonical_locale_name( const WCHAR *name, WCHAR *out )
+{
+    const WCHAR *p = name, *start;
+    int part = 0, n, i;
+    WCHAR *o = out;
+
+    for (;;)
+    {
+        for (start = p; (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9'); p++) ;
+        n = p - start;
+        if (part == 0)      /* language: 2 or 3 letters */
+        {
+            if (n < 2 || n > 3) return FALSE;
+            for (i = 0; i < n; i++) if (start[i] >= '0' && start[i] <= '9') return FALSE;
+            for (i = 0; i < n; i++) *o++ = (start[i] >= 'A' && start[i] <= 'Z') ? start[i] + 32 : start[i];
+            part = 1;
+        }
+        else if (part == 1 && n == 4 && !(start[0] >= '0' && start[0] <= '9'))  /* script */
+        {
+            for (i = 0; i < 4; i++) if (start[i] >= '0' && start[i] <= '9') return FALSE;
+            *o++ = '-';
+            *o++ = (start[0] >= 'a' && start[0] <= 'z') ? start[0] - 32 : start[0];
+            for (i = 1; i < 4; i++) *o++ = (start[i] >= 'A' && start[i] <= 'Z') ? start[i] + 32 : start[i];
+            part = 2;
+        }
+        else if (part <= 2 && (n == 2 || n == 3))  /* region: 2 letters or 3 digits */
+        {
+            BOOL digits = n == 3;
+            for (i = 0; i < n; i++)
+                if (digits != (start[i] >= '0' && start[i] <= '9')) return FALSE;
+            *o++ = '-';
+            for (i = 0; i < n; i++) *o++ = (start[i] >= 'a' && start[i] <= 'z') ? start[i] - 32 : start[i];
+            part = 3;
+        }
+        else return FALSE;
+        if (!*p) break;
+        if ((*p != '-' && *p != '_') || part == 3) return FALSE;
+        p++;
+    }
+    *o = 0;
+    return TRUE;
+}
+
+static int get_synthesized_locale_info( const WCHAR *name, LCTYPE info, WCHAR *buffer, int len )
+{
+    WCHAR canon[LOCALE_NAME_MAX_LENGTH], tmp[LOCALE_NAME_MAX_LENGTH], *p;
+    const NLS_LOCALE_DATA *locale = NULL;
+    LCID lcid;
+
+    if (name == LOCALE_NAME_USER_DEFAULT || wcslen( name ) >= LOCALE_NAME_MAX_LENGTH ||
+        !canonical_locale_name( name, canon ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    wcscpy( tmp, canon );
+    while (!locale && (p = wcsrchr( tmp, '-' )))
+    {
+        *p = 0;
+        locale = get_locale_by_name( tmp, &lcid );
+    }
+    if (!locale && !(locale = get_locale_by_name( LOCALE_NAME_INVARIANT, &lcid )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    TRACE( "%s: not a locale of ours, as %s\n", debugstr_w(name), debugstr_w(locale_strings + locale->sname + 1) );
+
+    switch (LOWORD(info))
+    {
+    case LOCALE_SNAME:
+    {
+        int ret = wcslen( canon ) + 1;
+        if (info & LOCALE_RETURN_NUMBER) break;
+        if (!len) return ret;
+        if (ret > len)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return 0;
+        }
+        wcscpy( buffer, canon );
+        return ret;
+    }
+    case LOCALE_ILANGUAGE:
+        return locale_return_number( LOCALE_CUSTOM_UNSPECIFIED, info, buffer, len );
+    }
+    return get_locale_info( locale, LOCALE_CUSTOM_UNSPECIFIED, info | LOCALE_NOUSEROVERRIDE, buffer, len );
+}
+
+
 /******************************************************************************
  *	GetLocaleInfoEx   (kernelbase.@)
  */
@@ -6353,6 +6450,9 @@ INT WINAPI DECLSPEC_HOTPATCH GetLocaleInfoEx( const WCHAR *name, LCTYPE info, WC
 
     TRACE( "%s 0x%lx %p %d\n", debugstr_w(name), info, buffer, len );
 
+#ifndef SG_MUTANT_NO_SYNTH_LOCALE
+    if (!locale && name) return get_synthesized_locale_info( name, info, buffer, len );
+#endif
     if (!locale)
     {
         SetLastError( ERROR_INVALID_PARAMETER );
