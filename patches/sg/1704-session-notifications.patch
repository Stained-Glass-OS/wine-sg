+/* The compositor's control socket: SG_LOCK_CONTROL, which the session
+ * exports, else where the session puts it for this user. A SESSION
+ * connection is told the state at once and then each change, a line each. */
+static const char *control_path( char *buf, size_t size )
+{
+    const char *path = getenv( "SG_LOCK_CONTROL" );
+
+    if (path && *path) return path;
+    snprintf( buf, size, "/run/stained-glass-seat/seat0/%u/control.sock", (unsigned int)getuid() );
+    return buf;
+}
+
+static int read_line( int fd, char *line, size_t size )
+{
+    size_t n = 0;
+    char c;
+
+    for (;;)
+    {
+        ssize_t r = read( fd, &c, 1 );
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) break;
+        if (c == '\n')
+        {
+            line[n] = 0;
+            return 1;
+        }
+        if (n + 1 < size) line[n++] = c;
+    }
+    line[0] = 0;
+    return 0;
+}
+
+static NTSTATUS session_open( void *args )
+{
+    struct session_open_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    char buf[128];
+    const char *path = control_path( buf, sizeof(buf) );
+    int fd;
+
+    params->fd = -1;
+    params->line[0] = 0;
+    if (strlen( path ) >= sizeof(addr.sun_path)) return STATUS_NOT_FOUND;
+    strcpy( addr.sun_path, path );
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return STATUS_NOT_FOUND;
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) < 0 ||
+        write( fd, "SESSION\n", 8 ) != 8 ||
+        !read_line( fd, params->line, sizeof(params->line) ) || strncmp( params->line, "OK session", 10 ))
+    {
+        close( fd );
+        params->line[0] = 0;
+        return STATUS_NOT_FOUND;
+    }
+    params->fd = fd;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS session_read( void *args )
+{
+    struct session_read_params *params = args;
+
+    if (!read_line( params->fd, params->line, sizeof(params->line) )) return STATUS_END_OF_FILE;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS session_close( void *args )
+{
+    struct session_close_params *params = args;
+
+    if (params->fd >= 0) close( params->fd );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    session_open,
+    session_read,
+    session_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    session_open,
+    session_read,
+    session_close,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif
