+#include "wine/unixlib.h"
+
+/* no pointers: the same for 32- and 64-bit callers */
+struct session_open_params
+{
+    int fd;          /* out: the connection, -1 when there is none */
+    char line[64];   /* out: the state, "OK session locked=N remote=N shadow=N" */
+};
+
+struct session_read_params
+{
+    int fd;
+    char line[64];   /* out: the next event, "" when the connection ended */
+};
+
+struct session_close_params
+{
+    int fd;
+};
+
+enum wtsapi32_funcs
+{
+    unix_session_open,
+    unix_session_read,
+    unix_session_close,
+    unix_funcs_count
+};
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -24,11 +24,239 @@
 #include "winternl.h"
 #include "winnls.h"
 #include "lmcons.h"
+#include "winuser.h"
 #include "wtsapi32.h"
 #include "wine/debug.h"
+#include "wine/list.h"
+#include "unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wtsapi);
 
+/* Stained Glass OS: session notifications. The session's compositor says
+ * when the user locks and unlocks, when Remote Desktop takes the session and
+ * gives it back and when a remote viewer watches (its control socket's
+ * SESSION). A process with registrations follows it on a thread of its own
+ * and sends WM_WTSSESSION_CHANGE to the registered windows, as Windows does:
+ * Chrome, Edge, Firefox and VS Code stop timers, blank sensitive content or
+ * reconnect on lock and unlock. There is one session, so registrations for
+ * all sessions get the same; no logon or logoff of another session happens. */
+struct session_registration
+{
+    struct list entry;
+    HWND hwnd;
+    DWORD flags;
+};
+
+static CRITICAL_SECTION session_cs;
+static CRITICAL_SECTION_DEBUG session_cs_debug =
+{
+    0, 0, &session_cs,
+    { &session_cs_debug.ProcessLocksList, &session_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": session_cs") }
+};
+static CRITICAL_SECTION session_cs = { &session_cs_debug, -1, 0, 0, 0, 0 };
+static struct list session_registrations = LIST_INIT( session_registrations );
+static HANDLE session_thread;
+static INIT_ONCE unix_once = INIT_ONCE_STATIC_INIT;
+static BOOL unix_ready;
+
+struct session_state
+{
+    BOOL known;   /* a compositor said */
+    BOOL locked;
+    BOOL remote;
+    BOOL shadow;
+};
+
+static BOOL CALLBACK init_unix( INIT_ONCE *once, void *param, void **context )
+{
+    unix_ready = !__wine_init_unix_call();
+    return TRUE;
+}
+
+static BOOL parse_state( const char *line, struct session_state *state )
+{
+    int locked, remote, shadow;
+
+    if (sscanf( line, "OK session locked=%d remote=%d shadow=%d", &locked, &remote, &shadow ) != 3) return FALSE;
+    state->known = TRUE;
+    state->locked = locked;
+    state->remote = remote;
+    state->shadow = shadow;
+    return TRUE;
+}
+
+/* the state now, from a connection of its own */
+static void get_session_state( struct session_state *state )
+{
+    struct session_open_params params;
+    struct session_close_params close_params;
+
+    memset( state, 0, sizeof(*state) );
+    InitOnceExecuteOnce( &unix_once, init_unix, NULL, NULL );
+    if (!unix_ready || WINE_UNIX_CALL( unix_session_open, &params )) return;
+    parse_state( params.line, state );
+    close_params.fd = params.fd;
+    WINE_UNIX_CALL( unix_session_close, &close_params );
+}
+
+static void send_session_change( WPARAM code )
+{
+    struct session_registration *reg;
+    DWORD session_id = 0;
+    HWND *hwnds = NULL;
+    unsigned int count = 0, i;
+
+    ProcessIdToSessionId( GetCurrentProcessId(), &session_id );
+    EnterCriticalSection( &session_cs );
+    if ((hwnds = malloc( list_count( &session_registrations ) * sizeof(*hwnds) + 1 )))
+        LIST_FOR_EACH_ENTRY( reg, &session_registrations, struct session_registration, entry )
+            hwnds[count++] = reg->hwnd;
+    LeaveCriticalSection( &session_cs );
+
+    TRACE( "code %#Ix to %u windows\n", code, count );
+    for (i = 0; i < count; i++)
+        if (IsWindow( hwnds[i] )) SendNotifyMessageW( hwnds[i], WM_WTSSESSION_CHANGE, code, session_id );
+    free( hwnds );
+}
+
+static void session_event( const char *line )
+{
+#ifdef SG_MUTANT_NO_SESSION_EVENTS
+    return;
+#endif
+    if (!strcmp( line, "lock" )) send_session_change( WTS_SESSION_LOCK );
+    else if (!strcmp( line, "unlock" )) send_session_change( WTS_SESSION_UNLOCK );
+    else if (!strcmp( line, "remote-connect" ))
+    {
+        /* the session leaves the console for the remote connection */
+        send_session_change( WTS_CONSOLE_DISCONNECT );
+        send_session_change( WTS_REMOTE_CONNECT );
+    }
+    else if (!strcmp( line, "remote-disconnect" ))
+    {
+        send_session_change( WTS_REMOTE_DISCONNECT );
+        send_session_change( WTS_CONSOLE_CONNECT );
+    }
+    else if (!strcmp( line, "shadow-start" ) || !strcmp( line, "shadow-end" ))
+        send_session_change( WTS_SESSION_REMOTE_CONTROL );
+    else WARN( "unknown event %s\n", debugstr_a(line) );
+}
+
+static BOOL have_registrations(void)
+{
+    BOOL ret;
+
+    EnterCriticalSection( &session_cs );
+    ret = !list_empty( &session_registrations );
+    LeaveCriticalSection( &session_cs );
+    return ret;
+}
+
+static DWORD WINAPI session_thread_proc( void *arg )
+{
+    HANDLE ready = arg;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_wtsapi32_session" );
+    for (;;)
+    {
+        struct session_open_params open_params;
+        struct session_read_params read_params;
+        struct session_close_params close_params;
+
+        if (!WINE_UNIX_CALL( unix_session_open, &open_params ))
+        {
+            if (ready) SetEvent( ready );
+            ready = NULL;
+            TRACE( "following the session: %s\n", debugstr_a(open_params.line) );
+            read_params.fd = open_params.fd;
+            while (!WINE_UNIX_CALL( unix_session_read, &read_params )) session_event( read_params.line );
+            close_params.fd = open_params.fd;
+            WINE_UNIX_CALL( unix_session_close, &close_params );
+        }
+        if (ready) SetEvent( ready );
+        ready = NULL;
+        /* no compositor, or it went away: try again while anyone listens */
+        Sleep( 5000 );
+        if (!have_registrations())
+        {
+            EnterCriticalSection( &session_cs );
+            if (list_empty( &session_registrations ))
+            {
+                CloseHandle( session_thread );
+                session_thread = NULL;
+                LeaveCriticalSection( &session_cs );
+                return 0;
+            }
+            LeaveCriticalSection( &session_cs );
+        }
+    }
+}
+
+static BOOL register_session_notification( HWND hwnd, DWORD flags )
+{
+    struct session_registration *reg;
+    HANDLE ready = NULL;
+
+    if (flags & ~NOTIFY_FOR_ALL_SESSIONS || !IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    InitOnceExecuteOnce( &unix_once, init_unix, NULL, NULL );
+
+    EnterCriticalSection( &session_cs );
+    LIST_FOR_EACH_ENTRY( reg, &session_registrations, struct session_registration, entry )
+    {
+        if (reg->hwnd != hwnd) continue;
+        reg->flags = flags;
+        LeaveCriticalSection( &session_cs );
+        return TRUE;
+    }
+    if (!(reg = malloc( sizeof(*reg) )))
+    {
+        LeaveCriticalSection( &session_cs );
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    reg->hwnd = hwnd;
+    reg->flags = flags;
+    list_add_tail( &session_registrations, &reg->entry );
+    if (!session_thread && unix_ready)
+    {
+        ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+        session_thread = CreateThread( NULL, 0, session_thread_proc, ready, 0, NULL );
+    }
+    LeaveCriticalSection( &session_cs );
+
+    /* following the session (or not able to) before this returns: a lock
+     * right after registering is not lost */
+    if (ready)
+    {
+        WaitForSingleObject( ready, 5000 );
+        CloseHandle( ready );
+    }
+    return TRUE;
+}
+
+static BOOL unregister_session_notification( HWND hwnd )
+{
+    struct session_registration *reg;
+
+    EnterCriticalSection( &session_cs );
+    LIST_FOR_EACH_ENTRY( reg, &session_registrations, struct session_registration, entry )
+    {
+        if (reg->hwnd != hwnd) continue;
+        list_remove( &reg->entry );
+        free( reg );
+        LeaveCriticalSection( &session_cs );
+        return TRUE;
+    }
+    LeaveCriticalSection( &session_cs );
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return FALSE;
+}
+
 
