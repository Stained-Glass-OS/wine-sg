+static void wined3d_so_counter_gl_end(struct wined3d_so_counter_gl *counter, unsigned int stream_idx)
+{
+    const struct wined3d_gl_info *gl_info = counter->context_gl->gl_info;
+
+    if (!counter->active)
+        return;
+    if (gl_info->supported[ARB_TRANSFORM_FEEDBACK3])
+        GL_EXTCALL(glEndQueryIndexed(GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN, stream_idx));
+    else
+        GL_EXTCALL(glEndQuery(GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN));
+    checkGLcall("end stream output counter");
+    counter->active = false;
+}
+
+static void wined3d_so_counter_gl_release(struct wined3d_so_counter_gl *counter,
+        struct wined3d_context_gl *context_gl)
+{
+    const struct wined3d_gl_info *gl_info;
+
+    if (--counter->refcount)
+        return;
+    if (counter->context_gl == context_gl)
+    {
+        gl_info = context_gl->gl_info;
+        GL_EXTCALL(glDeleteQueries(1, &counter->id));
+        checkGLcall("delete stream output counter");
+    }
+    else
+    {
+        WARN("Leaking query %u of context %p.\n", counter->id, counter->context_gl);
+    }
+    free(counter);
+}
+
+void wined3d_buffer_gl_so_counter_release(struct wined3d_buffer_gl *buffer_gl,
+        struct wined3d_context_gl *context_gl)
+{
+    if (!buffer_gl->so_counter)
+        return;
+    wined3d_so_counter_gl_release(buffer_gl->so_counter, context_gl);
+    buffer_gl->so_counter = NULL;
+}
+
+/* Direct3D's BufferFilledSize of a stream output buffer: where appending (an SOSetTargets offset of
+ * -1) goes on and how many vertices DrawAuto draws. The buffer keeps it across being unbound. */
+unsigned int wined3d_buffer_gl_so_filled_size(struct wined3d_buffer_gl *buffer_gl,
+        struct wined3d_context_gl *context_gl)
+{
+    struct wined3d_so_counter_gl *counter;
+    const struct wined3d_gl_info *gl_info;
+    uint64_t size;
+
+    if (!(counter = buffer_gl->so_counter))
+        return buffer_gl->so_filled_size;
+
+    if (counter->active)
+    {
+        /* Still capturing into it (bound for stream output and read in the same session). */
+        WARN("Buffer %p is still a stream output target, ending transform feedback.\n", buffer_gl);
+        wined3d_context_gl_end_transform_feedback(counter->context_gl);
+    }
+    if (!counter->resolved)
+    {
+        if (counter->context_gl == context_gl)
+        {
+            gl_info = context_gl->gl_info;
+            GL_EXTCALL(glGetQueryObjectuiv(counter->id, GL_QUERY_RESULT, &counter->primitives));
+            checkGLcall("stream output counter result");
+        }
+        else
+        {
+            FIXME("Stream output counter of another context %p.\n", counter->context_gl);
+            counter->primitives = 0;
+        }
+        counter->resolved = true;
+    }
+    size = buffer_gl->so_start + (uint64_t)counter->primitives * buffer_gl->so_primitive_bytes;
+    buffer_gl->so_filled_size = min(size, buffer_gl->b.resource.size);
+    TRACE("Buffer %p: %u primitives of %u bytes from %u, filled size %u.\n", buffer_gl, counter->primitives,
+            buffer_gl->so_primitive_bytes, buffer_gl->so_start, buffer_gl->so_filled_size);
+    wined3d_buffer_gl_so_counter_release(buffer_gl, context_gl);
+    return buffer_gl->so_filled_size;
+}
+
+/* An application's own primitives-written query cannot run beside ours on the same stream. */
+void wined3d_context_gl_so_app_query_begin(struct wined3d_context_gl *context_gl, unsigned int stream_idx)
+{
+    struct wined3d_so_counter_gl *counter;
+
+    if (stream_idx >= ARRAY_SIZE(context_gl->so_counters) || !(counter = context_gl->so_counters[stream_idx]))
+        return;
+    if (counter->active)
+        FIXME("Stream %u's filled size is lost to a query begun during stream output.\n", stream_idx);
+    wined3d_so_counter_gl_end(counter, stream_idx);
+}
+
+/* A transform feedback session begins: count what each bound stream writes. */
+static void wined3d_context_gl_begin_so_counters(struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state, GLenum mode)
+{
+    const struct wined3d_shader *shader = state->shader[WINED3D_SHADER_TYPE_GEOMETRY];
+    const struct wined3d_stream_output_desc *so_desc = shader ? shader->u.gs.so_desc : NULL;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    unsigned int i, j, stream_idx, stride, vertex_count;
+    struct wined3d_so_counter_gl *counter;
+    struct wined3d_buffer_gl *buffer_gl;
+
+    vertex_count = mode == GL_POINTS ? 1 : mode == GL_LINES ? 2 : 3;
+
+    for (i = 0; i < ARRAY_SIZE(state->stream_output); ++i)
+    {
+        if (!state->stream_output[i].buffer)
+            continue;
+        buffer_gl = wined3d_buffer_gl(state->stream_output[i].buffer);
+
+        stream_idx = 0;
+        stride = 0;
+        if (so_desc)
+        {
+            for (j = 0; j < so_desc->element_count; ++j)
+            {
+                if (so_desc->elements[j].output_slot != i)
+                    continue;
+                stream_idx = so_desc->elements[j].stream_idx;
+                stride += so_desc->elements[j].component_count * sizeof(float);
+            }
+            if (i < so_desc->buffer_stride_count && so_desc->buffer_strides[i])
+                stride = so_desc->buffer_strides[i];
+        }
+        if (stream_idx >= ARRAY_SIZE(context_gl->so_counters))
+            stream_idx = 0;
+
+        if (!(counter = context_gl->so_counters[stream_idx])
+                && !context_gl->so_app_queries[stream_idx]
+                && (!stream_idx || gl_info->supported[ARB_TRANSFORM_FEEDBACK3])
+                && (counter = calloc(1, sizeof(*counter))))
+        {
+            counter->refcount = 1;
+            counter->context_gl = context_gl;
+            GL_EXTCALL(glGenQueries(1, &counter->id));
+            if (gl_info->supported[ARB_TRANSFORM_FEEDBACK3])
+                GL_EXTCALL(glBeginQueryIndexed(GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN, stream_idx, counter->id));
+            else
+                GL_EXTCALL(glBeginQuery(GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN, counter->id));
+            checkGLcall("begin stream output counter");
+            counter->active = true;
+            context_gl->so_counters[stream_idx] = counter;
+        }
+
+        wined3d_buffer_gl_so_counter_release(buffer_gl, context_gl);
+        buffer_gl->so_start = context_gl->so_start[i];
+        buffer_gl->so_primitive_bytes = stride * vertex_count;
+        buffer_gl->so_filled_size = buffer_gl->so_start;
+#ifndef SG_MUTANT_SO_NO_FILLED_SIZE
+        if (counter)
+        {
+            ++counter->refcount;
+            buffer_gl->so_counter = counter;
+        }
+        else
+#endif
+        {
+            FIXME("Not counting what stream %u writes to buffer %p.\n", stream_idx, buffer_gl);
+        }
+    }
+}
