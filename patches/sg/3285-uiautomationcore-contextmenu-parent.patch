From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 22:14:33 -0700
Subject: [PATCH] uiautomationcore: ShowContextMenu falls back to the parent
 element (3285)

IUIAutomationElement::ShowContextMenu asks the element's providers and, when none supports it, the nearest ancestor that does, as documented.

diff --git a/dlls/uiautomationcore/uia_com_client.c b/dlls/uiautomationcore/uia_com_client.c
index 5d3f8e9..2550130 100644
--- a/dlls/uiautomationcore/uia_com_client.c
+++ b/dlls/uiautomationcore/uia_com_client.c
@@ -4571,22 +4571,12 @@ static HRESULT WINAPI uia_element_get_CachedFlowsFrom(IUIAutomationElement9 *ifa
     return cached_get_elements(impl_from_IUIAutomationElement9(iface), UIA_FlowsFromPropertyId, ret_val);
 }
 
-static HRESULT WINAPI uia_element_ShowContextMenu(IUIAutomationElement9 *iface)
+static HRESULT show_context_menu_on_node(IWineUiaNode *node)
 {
-    IWineUiaNode *node = uia_checked_node(impl_from_IUIAutomationElement9(iface)->node);
     HRESULT hr = UIA_E_NOTSUPPORTED;
     int idx;
 
-    TRACE("%p\n", iface);
-
-#ifdef SG_MUTANT_UIACOM_NO_MENU
-    return E_NOTIMPL;
-#endif
-    if (!node)
-        return E_INVALIDARG;
-
-    /* Asks each provider of the element in turn. GUESS: the parent's menu when the element has none
-     * (documented) is not tried. */
+    /* asks each provider of the node in turn */
     for (idx = 0; ; idx++)
     {
         VARIANT v;
@@ -4604,6 +4594,44 @@ static HRESULT WINAPI uia_element_ShowContextMenu(IUIAutomationElement9 *iface)
     return hr;
 }
 
+static HRESULT WINAPI uia_element_ShowContextMenu(IUIAutomationElement9 *iface)
+{
+    IWineUiaNode *node = uia_checked_node(impl_from_IUIAutomationElement9(iface)->node), *cur;
+    HRESULT hr;
+
+    TRACE("%p\n", iface);
+
+#ifdef SG_MUTANT_UIACOM_NO_MENU
+    return E_NOTIMPL;
+#endif
+    if (!node)
+        return E_INVALIDARG;
+
+    /* the element's own menu, else (documented) the nearest ancestor's */
+    cur = node;
+    IWineUiaNode_AddRef(cur);
+    while (1)
+    {
+        HUIANODE parent = NULL;
+        HRESULT nav;
+
+        hr = show_context_menu_on_node(cur);
+#ifdef SG_MUTANT_UIACOM_NO_PARENT_MENU
+        break;
+#endif
+        if (hr != UIA_E_NOTSUPPORTED)
+            break;
+
+        nav = navigate_uia_node(impl_from_IWineUiaNode(cur), NavigateDirection_Parent, &parent);
+        if (FAILED(nav) || !parent)
+            break;
+        IWineUiaNode_Release(cur);
+        cur = (IWineUiaNode *)parent;
+    }
+    IWineUiaNode_Release(cur);
+    return hr;
+}
+
 static HRESULT WINAPI uia_element_get_CurrentIsPeripheral(IUIAutomationElement9 *iface, BOOL *ret_val)
 {
     TRACE("%p, %p\n", iface, ret_val);
