+/* Stained Glass OS: the rest of what programs call. Authentication data is
+ * accepted and there is never a result to read; events can be registered
+ * (none ever fires); nothing is genuine-validated online, so the machine is
+ * genuine locally; offline activation is not offered. Office's licensing
+ * thread calls SLSetAuthenticationData at start, and a stub ended Word. */
+#define SL_E_NOT_SUPPORTED_SG 0xC004F016
+
+HRESULT WINAPI SLSetAuthenticationData(HSLC handle, UINT size, const BYTE *data)
+{
+    TRACE("(%p %u %p)\n", handle, size, data);
+    if (!handle || (size && !data)) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLGetAuthenticationResult(HSLC handle, UINT *size, BYTE **data)
+{
+    TRACE("(%p %p %p)\n", handle, size, data);
+    if (!handle || !size || !data) return E_INVALIDARG;
+    *size = 0;
+    *data = NULL;
+    return SL_E_VALUE_NOT_FOUND;
+}
+
+HRESULT WINAPI SLRegisterEvent(HSLC handle, const WCHAR *event, const SLID *app, HANDLE hevent)
+{
+    TRACE("(%p %s %s %p)\n", handle, debugstr_w(event), debugstr_guid(app), hevent);
+    if (!event || !hevent) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLUnregisterEvent(HSLC handle, const WCHAR *event, const SLID *app, HANDLE hevent)
+{
+    TRACE("(%p %s %s %p)\n", handle, debugstr_w(event), debugstr_guid(app), hevent);
+    if (!event || !hevent) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLFireEvent(HSLC handle, const WCHAR *event, const SLID *app)
+{
+    TRACE("(%p %s %s)\n", handle, debugstr_w(event), debugstr_guid(app));
+    if (!handle || !event) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLGetGenuineInformation(const SLID *app, const WCHAR *name, SLDATATYPE *type, UINT *size, BYTE **value)
+{
+    TRACE("(%s %s %p %p %p)\n", debugstr_guid(app), debugstr_w(name), type, size, value);
+    if (!app) return E_INVALIDARG;
+    return not_found(name, type, size, value);
+}
+
+HRESULT WINAPI SLSetGenuineInformation(const SLID *app, const WCHAR *name, SLDATATYPE type, UINT size, const BYTE *value)
+{
+    TRACE("(%s %s %u %u %p)\n", debugstr_guid(app), debugstr_w(name), type, size, value);
+    if (!app || !name) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLIsGenuineLocalEx(const SLID *app, const SLID *sku, SL_GENUINE_STATE *state)
+{
+    TRACE("(%s %s %p)\n", debugstr_guid(app), debugstr_guid(sku), state);
+    if (!app || !state) return E_INVALIDARG;
+    *state = SL_GEN_STATE_IS_GENUINE;
+    return S_OK;
+}
+
+HRESULT WINAPI SLReArm(HSLC handle, const SLID *app, const SLID *sku, UINT flags)
+{
+    TRACE("(%p %s %s %#x)\n", handle, debugstr_guid(app), debugstr_guid(sku), flags);
+    if (!handle || !app) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLSetCurrentProductKey(HSLC handle, const SLID *sku, const SLID *key)
+{
+    TRACE("(%p %s %s)\n", handle, debugstr_guid(sku), debugstr_guid(key));
+    if (!handle || !sku || !key) return E_INVALIDARG;
+    return S_OK;
+}
+
+HRESULT WINAPI SLGenerateOfflineInstallationId(HSLC handle, const SLID *key, WCHAR **id)
+{
+    TRACE("(%p %s %p)\n", handle, debugstr_guid(key), id);
+    if (!handle || !key || !id) return E_INVALIDARG;
+    *id = NULL;
+    return SL_E_NOT_SUPPORTED_SG;
+}
+
+HRESULT WINAPI SLDepositOfflineConfirmationId(HSLC handle, const SLID *key, const WCHAR *iid, const WCHAR *cid)
+{
+    TRACE("(%p %s %s %s)\n", handle, debugstr_guid(key), debugstr_w(iid), debugstr_w(cid));
+    if (!handle || !key || !iid || !cid) return E_INVALIDARG;
+    return SL_E_NOT_SUPPORTED_SG;
+}
