From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] rasapi32: RasGetEapUserIdentity, RasFreeEapUserIdentity

RasGetEapUserIdentity answers for a phonebook entry: no entry here authenticates with EAP, so an existing entry gives ERROR_INVALID_FUNCTION_FOR_ENTRY and a missing one ERROR_CANNOT_FIND_PHONEBOOK_ENTRY, with no identity; RasFreeEapUserIdentity frees one. They were not exported.
---
--- a/dlls/rasapi32/rasapi.c
+++ b/dlls/rasapi32/rasapi.c
@@ -1394,3 +1394,53 @@
     if (!statistics) return ERROR_INVALID_PARAMETER;
     return sg_statistics( connection );
 }
+
+#ifndef SG_MUTANT_NO_EAP_IDENTITY
+/* (wine-sg 8271) EAP user identities: no phonebook entry here authenticates with EAP (the entries are plain
+ * PPP/VPN ones), so an existing entry has no EAP identity to give and a missing one is not found. */
+static DWORD eap_identity( const WCHAR *phonebook, const WCHAR *entry, void **identity )
+{
+    DWORD size = 0, ret;
+
+    if (!entry || !identity) return ERROR_INVALID_PARAMETER;
+    *identity = NULL;
+    ret = RasGetEntryPropertiesW( phonebook, entry, NULL, &size, NULL, NULL );
+    if (ret == ERROR_BUFFER_TOO_SMALL || ret == ERROR_SUCCESS) return ERROR_INVALID_FUNCTION_FOR_ENTRY;
+    return ERROR_CANNOT_FIND_PHONEBOOK_ENTRY;
+}
+
+DWORD WINAPI RasGetEapUserIdentityW( const WCHAR *phonebook, const WCHAR *entry, DWORD flags, HWND hwnd, void **identity )
+{
+    TRACE( "(%s, %s, %#lx, %p, %p)\n", debugstr_w(phonebook), debugstr_w(entry), flags, hwnd, identity );
+    return eap_identity( phonebook, entry, identity );
+}
+
+DWORD WINAPI RasGetEapUserIdentityA( const char *phonebook, const char *entry, DWORD flags, HWND hwnd, void **identity )
+{
+    WCHAR *pbk = dup_acp( phonebook ), *name = dup_acp( entry );
+    DWORD ret;
+
+    TRACE( "(%s, %s, %#lx, %p, %p)\n", debugstr_a(phonebook), debugstr_a(entry), flags, hwnd, identity );
+    ret = (entry && !name) ? ERROR_NOT_ENOUGH_MEMORY : eap_identity( pbk, name, identity );
+    free( pbk );
+    free( name );
+    return ret;
+}
+
+void WINAPI RasFreeEapUserIdentityW( void *identity )
+{
+    TRACE( "(%p)\n", identity );
+    HeapFree( GetProcessHeap(), 0, identity );
+}
+
+void WINAPI RasFreeEapUserIdentityA( void *identity )
+{
+    TRACE( "(%p)\n", identity );
+    HeapFree( GetProcessHeap(), 0, identity );
+}
+#else
+DWORD WINAPI RasGetEapUserIdentityW( const WCHAR *phonebook, const WCHAR *entry, DWORD flags, HWND hwnd, void **identity ) { return ERROR_CALL_NOT_IMPLEMENTED; }
+DWORD WINAPI RasGetEapUserIdentityA( const char *phonebook, const char *entry, DWORD flags, HWND hwnd, void **identity ) { return ERROR_CALL_NOT_IMPLEMENTED; }
+void WINAPI RasFreeEapUserIdentityW( void *identity ) { }
+void WINAPI RasFreeEapUserIdentityA( void *identity ) { }
+#endif
--- a/dlls/rasapi32/rasapi32.spec
+++ b/dlls/rasapi32/rasapi32.spec
@@ -50,8 +50,8 @@
 @ stdcall RasEnumEntriesA(str str ptr ptr ptr)
 @ stdcall RasEnumEntriesW(wstr wstr ptr ptr ptr)
 @ stub RasEnumEntriesWow
-# @ stub RasFreeEapUserIdentityA
-# @ stub RasFreeEapUserIdentityW
+@ stdcall RasFreeEapUserIdentityA(ptr)
+@ stdcall RasFreeEapUserIdentityW(ptr)
 # @ stub RasFreeEntryAdvancedProperties
 # @ stub RasGetAutoTriggerConnectStatus
 @ stdcall RasGetAutodialAddressA(str ptr ptr ptr ptr)
@@ -74,8 +74,8 @@
 # @ stub RasGetCustomAuthDataW
 # @ stub RasGetEapUserDataA
 # @ stub RasGetEapUserDataW
-# @ stub RasGetEapUserIdentityA
-# @ stub RasGetEapUserIdentityW
+@ stdcall RasGetEapUserIdentityA(str str long long ptr)
+@ stdcall RasGetEapUserIdentityW(wstr wstr long long ptr)
 # @ stub RasGetEntryAdvancedProperties
 @ stdcall RasGetEntryDialParamsA(str ptr ptr)
 @ stdcall RasGetEntryDialParamsW(wstr ptr ptr)
