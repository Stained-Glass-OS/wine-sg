+/* Stained Glass OS: NtLoadKeyEx with REG_APP_HIVE -- a private hive, named
+ * \REGISTRY\A\<name>, loaded without privileges and returned as a handle
+ * (RegLoadAppKey). A hive file is Windows' binary hive or Wine's text file;
+ * a file that is empty (or short of a header) starts an empty hive. */
+static NTSTATUS load_app_hive( const OBJECT_ATTRIBUTES *attr, OBJECT_ATTRIBUTES *file, ULONG flags,
+                               ACCESS_MASK access, HANDLE *roothandle )
+{
+    static const WCHAR prefix[] = { '\\','R','E','G','I','S','T','R','Y','\\','A','\\' };
+    OBJECT_ATTRIBUTES new_attr = *file;
+    UNICODE_STRING nt_name;
+    ULONG disposition;
+    HANDLE hive = 0, key = 0;
+    char *unix_name, magic[4];
+    BOOL binary = FALSE;
+    off_t size = 0;
+    NTSTATUS status;
+    ULONG i;
+
+    if (!roothandle) return STATUS_INVALID_PARAMETER_7;
+    if (flags & ~(REG_APP_HIVE | REG_NO_LAZY_FLUSH | REG_OPTION_VOLATILE)) return STATUS_INVALID_PARAMETER_3;
+    if (!attr || attr->Length != sizeof(*attr) || attr->RootDirectory || !attr->ObjectName ||
+        attr->ObjectName->Length <= sizeof(prefix))
+        return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < ARRAY_SIZE(prefix); i++)
+        if (ntdll_towupper( attr->ObjectName->Buffer[i] ) != prefix[i]) return STATUS_INVALID_PARAMETER;
+
+    get_redirect( &new_attr, &nt_name );
+    if (!(status = nt_to_unix_file_name( &new_attr, &unix_name, FILE_OPEN )))
+    {
+        status = open_unix_file( &hive, unix_name, GENERIC_READ | SYNCHRONIZE, &new_attr, 0, 0, FILE_OPEN, 0, NULL, 0 );
+        free( unix_name );
+    }
+    free( nt_name.Buffer );
+    if (status) return status;
+
+    {
+        struct stat st;
+        int fd, needs_close;
+
+        if ((status = server_get_unix_fd( hive, FILE_READ_DATA, &fd, &needs_close, NULL, NULL ))) goto done;
+        if (!fstat( fd, &st )) size = st.st_size;
+        if (size >= 4 && pread( fd, magic, sizeof(magic), 0 ) == sizeof(magic) && !memcmp( magic, "regf", 4 ))
+            binary = TRUE;
+        if (needs_close) close( fd );
+    }
+
+    if (size >= 13 && !binary)
+    {
+        /* a text file is read by the server, which makes the key */
+        struct object_attributes *objattr;
+        data_size_t len;
+
+        TRACE( "loading the text hive\n" );
+        if ((status = alloc_object_attributes( attr, &objattr, &len ))) goto done;
+        objattr->attributes |= OBJ_CASE_INSENSITIVE;
+        SERVER_START_REQ( load_registry )
+        {
+            req->file = wine_server_obj_handle( hive );
+            wine_server_add_data( req, objattr, len );
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        free( objattr );
+        if (!status) status = NtOpenKey( &key, KEY_ALL_ACCESS, attr );
+        if (status) goto done;
+    }
+    else
+    {
+        if ((status = NtCreateKey( &key, KEY_ALL_ACCESS, attr, 0, NULL, 0, &disposition )))
+            goto done;
+        if (disposition != REG_CREATED_NEW_KEY)
+        {
+            status = STATUS_OBJECT_NAME_COLLISION;
+            goto done;
+        }
+        if (binary && (status = NtRestoreKey( key, hive, 0 )))
+        {
+            NtDeleteKey( key );
+            goto done;
+        }
+    }
+    if (access && access != KEY_ALL_ACCESS)
+    {
+        /* the hive was filled with every right; the caller gets the access asked for */
+        HANDLE asked;
+        if ((status = NtOpenKey( &asked, access, attr ))) goto done;
+        NtClose( key );
+        key = asked;
+    }
+    *roothandle = key;
+    key = 0;
+    status = STATUS_SUCCESS;
+
+done:
+    if (key) NtClose( key );
+    NtClose( hive );
+    return status;
+}
