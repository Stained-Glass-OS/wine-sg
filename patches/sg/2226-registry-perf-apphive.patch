+/* Stained Glass OS: application hives (RegLoadAppKey). The hive is a private
+ * key under \Registry\A; the file is written back when its root handle is
+ * closed (or flushed) and the hive unloaded, as Windows does on the last
+ * handle. A Windows binary hive is only read, never overwritten. */
+struct app_hive
+{
+    struct list entry;
+    HKEY key;
+    UNICODE_STRING name;
+    UNICODE_STRING file;
+    BOOL writeback;
+};
+static struct list app_hives = LIST_INIT( app_hives );
+
+static void save_app_hive( HKEY key, const UNICODE_STRING *file )
+{
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    HANDLE handle;
+
+    InitializeObjectAttributes( &attr, (UNICODE_STRING *)file, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtCreateFile( &handle, GENERIC_WRITE | SYNCHRONIZE, &attr, &io, NULL, FILE_ATTRIBUTE_NORMAL,
+                      FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OVERWRITE_IF,
+                      FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT, NULL, 0 ))
+        return;
+    NtSaveKey( key, handle );
+    NtClose( handle );
+}
+
+/* the app hive whose root handle is key, removed from the table if take */
+static struct app_hive *find_app_hive( HKEY key, BOOL take )
+{
+    struct app_hive *hive, *found = NULL;
+
+    if (list_empty( &app_hives )) return NULL;
+    RtlEnterCriticalSection( &classes_cs );
+    LIST_FOR_EACH_ENTRY( hive, &app_hives, struct app_hive, entry )
+    {
+        if (hive->key != key) continue;
+        found = hive;
+        if (take) list_remove( &hive->entry );
+        break;
+    }
+    RtlLeaveCriticalSection( &classes_cs );
+    return found;
+}
+
+static void flush_app_hive( HKEY key )
+{
+    struct app_hive *hive = find_app_hive( key, FALSE );
+    if (hive && hive->writeback) save_app_hive( key, &hive->file );
+}
+
+static void close_app_hive( HKEY key )
+{
+    struct app_hive *hive = find_app_hive( key, TRUE );
+    OBJECT_ATTRIBUTES attr;
+
+    if (!hive) return;
+#ifndef SG_MUTANT_APPHIVE_NO_SAVE
+    if (hive->writeback) save_app_hive( key, &hive->file );
+#endif
+    NtClose( key );
+    InitializeObjectAttributes( &attr, &hive->name, OBJ_CASE_INSENSITIVE, 0, NULL );
+#ifndef SG_MUTANT_APPHIVE_NO_UNLOAD
+    NtUnloadKey( &attr );   /* stays loaded while subkeys are open; the file is saved */
+#endif
+    RtlFreeUnicodeString( &hive->name );
+    RtlFreeUnicodeString( &hive->file );
+    heap_free( hive );
+}
