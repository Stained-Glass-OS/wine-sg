From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] wscript, cscript: For Each over WScript.Arguments, WScript.Arguments.Named and .Unnamed (9619)

Windows Script Host 5.6 scripts read their command line with
For Each arg In WScript.Arguments, WScript.Arguments.Named("path"),
.Named.Exists("q") and .Unnamed(0). Wine's IArguments2 had only Item, Count
and length, so For Each failed with error 451 and Named/Unnamed with 438. The
arguments collection now has _NewEnum; Named holds the /name:value and /name
arguments (names without case, the last one given wins; a switch without a
value and a name not given read Empty) with Item, Exists, Count, length and
For Each over the names; Unnamed holds the others with Item, Count, length
and For Each.
---
--- a/programs/wscript/arguments.c
+++ b/programs/wscript/arguments.c
@@ -17,6 +17,7 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
 
 #define COBJMACROS
 #define CONST_VTABLE
@@ -124,6 +125,380 @@
     return S_OK;
 }
 
+/* WSH 5.6 argument collections (Stained Glass OS, wine-sg 9619): For Each over
+ * WScript.Arguments, WScript.Arguments.Named ("/name:value" and "/name", names without case) and
+ * WScript.Arguments.Unnamed (the others), each with Item, Count, length and For Each; Named has
+ * Exists. A named argument without a value reads Empty, a name not given reads Empty. */
+
+typedef struct {
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    WCHAR **list;   /* the values (not owned) */
+    int count, pos;
+} ArgEnum;
+
+static inline ArgEnum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, ArgEnum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI ArgEnum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IEnumVARIANT, riid)) {
+        *ppv = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ArgEnum_AddRef(IEnumVARIANT *iface)
+{
+    return InterlockedIncrement(&impl_from_IEnumVARIANT(iface)->ref);
+}
+
+static ULONG WINAPI ArgEnum_Release(IEnumVARIANT *iface)
+{
+    ArgEnum *This = impl_from_IEnumVARIANT(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if(!ref)
+        free(This);
+    return ref;
+}
+
+static HRESULT WINAPI ArgEnum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched)
+{
+    ArgEnum *This = impl_from_IEnumVARIANT(iface);
+    ULONG i;
+
+    for(i = 0; i < celt && This->pos < This->count; i++, This->pos++) {
+        V_VT(&var[i]) = VT_BSTR;
+        if(!(V_BSTR(&var[i]) = SysAllocString(This->list[This->pos]))) {
+            V_VT(&var[i]) = VT_EMPTY;
+            break;
+        }
+    }
+    if(fetched)
+        *fetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI ArgEnum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    ArgEnum *This = impl_from_IEnumVARIANT(iface);
+
+    if(This->count - This->pos < (int)celt) {
+        This->pos = This->count;
+        return S_FALSE;
+    }
+    This->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI ArgEnum_Reset(IEnumVARIANT *iface)
+{
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_arg_enum(WCHAR **list, int count, int pos, IUnknown **ret);
+
+static HRESULT WINAPI ArgEnum_Clone(IEnumVARIANT *iface, IEnumVARIANT **ppenum)
+{
+    ArgEnum *This = impl_from_IEnumVARIANT(iface);
+
+    return create_arg_enum(This->list, This->count, This->pos, (IUnknown **)ppenum);
+}
+
+static const IEnumVARIANTVtbl ArgEnumVtbl = {
+    ArgEnum_QueryInterface,
+    ArgEnum_AddRef,
+    ArgEnum_Release,
+    ArgEnum_Next,
+    ArgEnum_Skip,
+    ArgEnum_Reset,
+    ArgEnum_Clone
+};
+
+static HRESULT create_arg_enum(WCHAR **list, int count, int pos, IUnknown **ret)
+{
+    ArgEnum *e;
+
+#ifdef SG_MUTANT_WSH_NO_ARG_COLLECTIONS
+    return E_NOTIMPL;
+#endif
+    if(!(e = malloc(sizeof(*e))))
+        return E_OUTOFMEMORY;
+    e->IEnumVARIANT_iface.lpVtbl = &ArgEnumVtbl;
+    e->ref = 1;
+    e->list = list;
+    e->count = count;
+    e->pos = pos;
+    *ret = (IUnknown *)&e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+/* the split of the command line, made once */
+static WCHAR **unnamed_list, **named_names, **named_values;
+static int unnamed_count, named_count;
+
+static WCHAR *dup_n(const WCHAR *str, size_t len)
+{
+    WCHAR *ret = malloc((len + 1) * sizeof(WCHAR));
+
+    if(ret) {
+        memcpy(ret, str, len * sizeof(WCHAR));
+        ret[len] = 0;
+    }
+    return ret;
+}
+
+static void split_arguments(void)
+{
+    static BOOL done;
+    int i;
+
+    if(done)
+        return;
+    done = TRUE;
+    unnamed_list = calloc(numOfArgs + 1, sizeof(WCHAR *));
+    named_names = calloc(numOfArgs + 1, sizeof(WCHAR *));
+    named_values = calloc(numOfArgs + 1, sizeof(WCHAR *));
+    if(!unnamed_list || !named_names || !named_values)
+        return;
+    for(i = 0; i < numOfArgs; i++) {
+        const WCHAR *arg = argums[i], *colon;
+
+        if(arg[0] == '/' && arg[1] && arg[1] != ':') {
+            colon = wcschr(arg + 1, ':');
+            named_names[named_count] = dup_n(arg + 1, colon ? (size_t)(colon - arg - 1) : wcslen(arg + 1));
+            named_values[named_count] = colon ? wcsdup(colon + 1) : NULL;
+            named_count++;
+        }else {
+            unnamed_list[unnamed_count++] = argums[i];
+        }
+    }
+}
+
+static int find_named(const WCHAR *name)
+{
+    int i;
+
+    /* the last one given wins, as a later switch overrides an earlier one */
+    for(i = named_count - 1; i >= 0; i--)
+        if(named_names[i] && !wcsicmp(named_names[i], name))
+            return i;
+    return -1;
+}
+
+typedef struct {
+    IDispatch IDispatch_iface;
+    BOOL named;
+} ArgCollection;
+
+enum { COLL_ITEM = DISPID_VALUE, COLL_COUNT = 1, COLL_LENGTH = 2, COLL_EXISTS = 3 };
+
+static inline ArgCollection *impl_from_IDispatch(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, ArgCollection, IDispatch_iface);
+}
+
+static HRESULT WINAPI ArgCollection_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(&IID_IUnknown, riid) || IsEqualGUID(&IID_IDispatch, riid)) {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ArgCollection_AddRef(IDispatch *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI ArgCollection_Release(IDispatch *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI ArgCollection_GetTypeInfoCount(IDispatch *iface, UINT *pctinfo)
+{
+    *pctinfo = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI ArgCollection_GetTypeInfo(IDispatch *iface, UINT iTInfo, LCID lcid, ITypeInfo **ppTInfo)
+{
+    *ppTInfo = NULL;
+    return DISP_E_BADINDEX;
+}
+
+static HRESULT WINAPI ArgCollection_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names,
+        UINT count, LCID lcid, DISPID *ids)
+{
+    ArgCollection *This = impl_from_IDispatch(iface);
+    UINT i;
+
+    for(i = 0; i < count; i++) {
+        if(!wcsicmp(names[i], L"Item")) ids[i] = COLL_ITEM;
+        else if(!wcsicmp(names[i], L"Count")) ids[i] = COLL_COUNT;
+        else if(!wcsicmp(names[i], L"length")) ids[i] = COLL_LENGTH;
+        else if(This->named && !wcsicmp(names[i], L"Exists")) ids[i] = COLL_EXISTS;
+        else if(!wcsicmp(names[i], L"_NewEnum")) ids[i] = DISPID_NEWENUM;
+        else {
+            ids[i] = DISPID_UNKNOWN;
+            return DISP_E_UNKNOWNNAME;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT arg_bstr(DISPPARAMS *dp, BSTR *str, VARIANT *buf)
+{
+    VARIANT *v;
+
+    if(dp->cArgs != 1)
+        return DISP_E_BADPARAMCOUNT;
+    v = dp->rgvarg;
+    if(V_VT(v) == (VT_BYREF | VT_VARIANT))
+        v = V_VARIANTREF(v);
+    VariantInit(buf);
+    if(FAILED(VariantChangeType(buf, v, 0, VT_BSTR)))
+        return DISP_E_TYPEMISMATCH;
+    *str = V_BSTR(buf);
+    return S_OK;
+}
+
+static HRESULT WINAPI ArgCollection_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *dp, VARIANT *res, EXCEPINFO *ei, UINT *err)
+{
+    ArgCollection *This = impl_from_IDispatch(iface);
+    int count = This->named ? named_count : unnamed_count;
+    VARIANT buf, tmp;
+    HRESULT hres;
+    BSTR name;
+    int i;
+
+    WINE_TRACE("(%s %ld %x)\n", This->named ? "named" : "unnamed", id, flags);
+
+    if(!res)
+        res = &tmp;
+    V_VT(res) = VT_EMPTY;
+    switch(id) {
+    case COLL_COUNT:
+    case COLL_LENGTH:
+        V_VT(res) = VT_I4;
+        V_I4(res) = count;
+        break;
+    case DISPID_NEWENUM:
+        V_VT(res) = VT_UNKNOWN;
+        hres = create_arg_enum(This->named ? named_names : unnamed_list, count, 0, &V_UNKNOWN(res));
+        if(FAILED(hres)) {
+            V_VT(res) = VT_EMPTY;
+            return hres;
+        }
+        break;
+    case COLL_EXISTS:
+        if(FAILED(hres = arg_bstr(dp, &name, &buf)))
+            return hres;
+        V_VT(res) = VT_BOOL;
+        V_BOOL(res) = find_named(name) >= 0 ? VARIANT_TRUE : VARIANT_FALSE;
+        VariantClear(&buf);
+        break;
+    case COLL_ITEM:
+        if(!dp->cArgs) {
+            /* the collection itself */
+            V_VT(res) = VT_DISPATCH;
+            V_DISPATCH(res) = iface;
+            break;
+        }
+        if(This->named) {
+            if(FAILED(hres = arg_bstr(dp, &name, &buf)))
+                return hres;
+            i = find_named(name);
+            VariantClear(&buf);
+            if(i >= 0 && named_values[i]) {
+                V_VT(res) = VT_BSTR;
+                if(!(V_BSTR(res) = SysAllocString(named_values[i]))) {
+                    V_VT(res) = VT_EMPTY;
+                    return E_OUTOFMEMORY;
+                }
+            }
+        }else {
+            VARIANT *v = dp->rgvarg;
+
+            if(dp->cArgs != 1)
+                return DISP_E_BADPARAMCOUNT;
+            if(V_VT(v) == (VT_BYREF | VT_VARIANT))
+                v = V_VARIANTREF(v);
+            VariantInit(&buf);
+            if(FAILED(VariantChangeType(&buf, v, 0, VT_I4)))
+                return DISP_E_TYPEMISMATCH;
+            if(V_I4(&buf) < 0 || V_I4(&buf) >= count)
+                return E_INVALIDARG; /* the index is out of range, as Item of WScript.Arguments */
+            V_VT(res) = VT_BSTR;
+            if(!(V_BSTR(res) = SysAllocString(unnamed_list[V_I4(&buf)]))) {
+                V_VT(res) = VT_EMPTY;
+                return E_OUTOFMEMORY;
+            }
+        }
+        break;
+    default:
+        return DISP_E_MEMBERNOTFOUND;
+    }
+    if(res == &tmp)
+        VariantClear(&tmp);
+    return S_OK;
+}
+
+static const IDispatchVtbl ArgCollectionVtbl = {
+    ArgCollection_QueryInterface,
+    ArgCollection_AddRef,
+    ArgCollection_Release,
+    ArgCollection_GetTypeInfoCount,
+    ArgCollection_GetTypeInfo,
+    ArgCollection_GetIDsOfNames,
+    ArgCollection_Invoke
+};
+
+static ArgCollection named_obj = { { &ArgCollectionVtbl }, TRUE };
+static ArgCollection unnamed_obj = { { &ArgCollectionVtbl }, FALSE };
+
+static HRESULT WINAPI Arguments2_get__NewEnum(IArguments2 *iface, IUnknown **out_Enum)
+{
+    WINE_TRACE("(%p)\n", out_Enum);
+
+    return create_arg_enum(argums, numOfArgs, 0, out_Enum);
+}
+
+static HRESULT WINAPI Arguments2_get_Named(IArguments2 *iface, IDispatch **out_Named)
+{
+    WINE_TRACE("(%p)\n", out_Named);
+
+#ifdef SG_MUTANT_WSH_NO_ARG_COLLECTIONS
+    return E_NOTIMPL;
+#endif
+    split_arguments();
+    *out_Named = &named_obj.IDispatch_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI Arguments2_get_Unnamed(IArguments2 *iface, IDispatch **out_Unnamed)
+{
+    WINE_TRACE("(%p)\n", out_Unnamed);
+
+#ifdef SG_MUTANT_WSH_NO_ARG_COLLECTIONS
+    return E_NOTIMPL;
+#endif
+    split_arguments();
+    *out_Unnamed = &unnamed_obj.IDispatch_iface;
+    return S_OK;
+}
+
 static const IArguments2Vtbl Arguments2Vtbl = {
     Arguments2_QueryInterface,
     Arguments2_AddRef,
@@ -134,7 +509,10 @@
     Arguments2_Invoke,
     Arguments2_Item,
     Arguments2_Count,
-    Arguments2_get_length
+    Arguments2_get_length,
+    Arguments2_get__NewEnum,
+    Arguments2_get_Named,
+    Arguments2_get_Unnamed
 };
 
 IArguments2 arguments_obj = { &Arguments2Vtbl };
--- a/programs/wscript/ihost.idl
+++ b/programs/wscript/ihost.idl
@@ -47,6 +47,15 @@
 
         [id(IARGUMENTS2_LENGTH_DISPID), propget]
         HRESULT length([out, retval] LONG *out_Count);
+
+        [id(DISPID_NEWENUM), propget, restricted, hidden]
+        HRESULT _NewEnum([out, retval] IUnknown **out_Enum);
+
+        [id(IARGUMENTS2_NAMED_DISPID), propget]
+        HRESULT Named([out, retval] IDispatch **out_Named);
+
+        [id(IARGUMENTS2_UNNAMED_DISPID), propget]
+        HRESULT Unnamed([out, retval] IDispatch **out_Unnamed);
     }
 
     [
--- a/programs/wscript/ihost_dispid.h
+++ b/programs/wscript/ihost_dispid.h
@@ -40,6 +40,8 @@
 
 #define IARGUMENTS2_COUNT_DISPID   1
 #define IARGUMENTS2_LENGTH_DISPID  2
+#define IARGUMENTS2_NAMED_DISPID   3
+#define IARGUMENTS2_UNNAMED_DISPID 4
 
 #define ITEXTSTREAM_LINE_DISPID             10000
 #define ITEXTSTREAM_COLUMN_DISPID           -529
