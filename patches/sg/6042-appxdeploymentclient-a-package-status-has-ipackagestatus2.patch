From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] appxdeploymentclient: A package's status has IPackageStatus2; one version of a family (6042)

Dropbox crashed at start: it walks its family's packages, checks each
status, and then asks the status for IPackageStatus2 (IsPartiallyStaged).
It got E_NOINTERFACE and used the NULL. The status now has
IPackageStatus2; a package registered for the user is never partially
staged here. Before 6028 Dropbox's sparse package could not be added, so
it never got that far.

A family's main package also shows once for the user, as on Windows: the
version whose content is there, then the newest. A registration for the
user and one SYSTEM added for the machine, or one left over from an
update whose files are gone, showed side by side. Frameworks keep their
versions.
---
diff --git a/dlls/appxdeploymentclient/deploy.c b/dlls/appxdeploymentclient/deploy.c
index b0e04ce..22ca99f 100644
--- a/dlls/appxdeploymentclient/deploy.c
+++ b/dlls/appxdeploymentclient/deploy.c
@@ -2933,8 +2933,22 @@ struct query
     PackageTypes types;
     IPackage **packages;
     UINT32 count;
+    /* Stained Glass OS: per package, its main family (NULL for a framework or resource package),
+     * version and whether its content is there */
+    WCHAR **families;
+    UINT64 *versions;
+    BOOL *available;
 };
 
+/* One version of a main package's family for the user, as on Windows: the one whose content is
+ * there, then the newest. (A family registered for the user and added for the machine by SYSTEM, or
+ * left over from an update, would show twice.) Frameworks keep their versions side by side. */
+static BOOL prefer_record( BOOL available, UINT64 version, BOOL other_available, UINT64 other_version )
+{
+    if (available != other_available) return available;
+    return version > other_version;
+}
+
 static BOOL query_record( struct package_record *rec, void *context )
 {
     struct query *q = context;
@@ -2950,13 +2964,50 @@ static BOOL query_record( struct package_record *rec, void *context )
         !(q->types & type) || !matches( q->name, rec->name ) || !matches( q->publisher, rec->publisher ) ||
         !matches( q->family_name, rec->family_name ))
         return TRUE;
-    if (FAILED(package_create( rec, &package ))) return TRUE;
-    if ((grown = realloc( q->packages, (q->count + 1) * sizeof(*grown) )))
     {
-        q->packages = grown;
-        q->packages[q->count++] = package;
+        BOOL main = type == PackageTypes_Main && rec->family_name, available;
+        UINT64 version = rec->version;
+        WCHAR *family;
+        UINT32 i;
+
+        available = rec->install_location && GetFileAttributesW( rec->install_location ) != INVALID_FILE_ATTRIBUTES;
+#ifndef SG_MUTANT_AX_TWO_VERSIONS
+        for (i = 0; main && i < q->count; i++)
+        {
+            if (!q->families[i] || wcsicmp( q->families[i], rec->family_name )) continue;
+            if (!prefer_record( available, version, q->available[i], q->versions[i] )) return TRUE;
+            /* this one replaces the version listed */
+            if (FAILED(package_create( rec, &package ))) return TRUE;
+            IPackage_Release( q->packages[i] );
+            q->packages[i] = package;
+            q->versions[i] = version;
+            q->available[i] = available;
+            return TRUE;
+        }
+#endif
+        /* the record's strings go to the package: the family is kept apart */
+        family = main ? wcsdup( rec->family_name ) : NULL;
+        if (FAILED(package_create( rec, &package )))
+        {
+            free( family );
+            return TRUE;
+        }
+        if ((grown = realloc( q->packages, (q->count + 1) * sizeof(*grown) )) && (q->packages = grown) &&
+            (q->families = realloc( q->families, (q->count + 1) * sizeof(*q->families) )) &&
+            (q->versions = realloc( q->versions, (q->count + 1) * sizeof(*q->versions) )) &&
+            (q->available = realloc( q->available, (q->count + 1) * sizeof(*q->available) )))
+        {
+            q->families[q->count] = family;
+            q->versions[q->count] = version;
+            q->available[q->count] = available;
+            q->packages[q->count++] = package;
+        }
+        else
+        {
+            free( family );
+            IPackage_Release( package );
+        }
     }
-    else IPackage_Release( package );
     return TRUE;
 }
 
@@ -2972,6 +3023,10 @@ HRESULT deployed_packages( const WCHAR *user_sid, const WCHAR *name, const WCHAR
 
     if (user_sid && user_sid[0]) FIXME( "packages of user %s: the calling user's are listed\n", debugstr_w( user_sid ) );
     for_each_record( query_record, &q );
+    for (i = 0; i < q.count; i++) free( q.families[i] );
+    free( q.families );
+    free( q.versions );
+    free( q.available );
 
     /* the list takes the packages */
     if (FAILED(hr = package_list_create( q.packages, q.count, out )))
diff --git a/dlls/appxdeploymentclient/package_obj.c b/dlls/appxdeploymentclient/package_obj.c
index b0f1b52..52a25f7 100644
--- a/dlls/appxdeploymentclient/package_obj.c
+++ b/dlls/appxdeploymentclient/package_obj.c
@@ -359,6 +359,7 @@ static const struct IPackage2Vtbl package2_vtbl =
 struct package_status
 {
     IPackageStatus IPackageStatus_iface;
+    IPackageStatus2 IPackageStatus2_iface;
     LONG ref;
     BOOL not_available, license_issue, modified, tampered, dependency_issue;
 };
@@ -377,6 +378,15 @@ static HRESULT WINAPI status_QueryInterface( IPackageStatus *iface, REFIID iid,
         IPackageStatus_AddRef( iface );
         return S_OK;
     }
+#ifndef SG_MUTANT_AX_NO_STATUS2
+    if (IsEqualGUID( iid, &IID_IPackageStatus2 ))
+    {
+        *out = &impl_from_IPackageStatus( iface )->IPackageStatus2_iface;
+        IPackageStatus_AddRef( iface );
+        return S_OK;
+    }
+#endif
+    FIXME( "%s not implemented\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -399,9 +409,10 @@ static HRESULT WINAPI status_GetIids( IPackageStatus *iface, ULONG *count, IID *
     IID *list;
 
     if (!count || !iids) return E_POINTER;
-    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
-    *list = IID_IPackageStatus;
-    *count = 1;
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = IID_IPackageStatus;
+    list[1] = IID_IPackageStatus2;
+    *count = 2;
     *iids = list;
     return S_OK;
 }
@@ -481,6 +492,30 @@ static const struct IPackageStatusVtbl status_vtbl =
 };
 
 /* The state set with SetPackageState, whether the files are there, and whether what it depends on is installed. */
+/* IPackageStatus2 (Windows 10 1709 and later): a package found as deployed for the user has all its
+ * content -- this module stages no package in part. Dropbox asks it once the package is OK and
+ * used the NULL it got before. */
+DEFINE_IINSPECTABLE( status2, IPackageStatus2, struct package_status, IPackageStatus_iface )
+
+static HRESULT WINAPI status2_get_IsPartiallyStaged( IPackageStatus2 *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct IPackageStatus2Vtbl status2_vtbl =
+{
+    status2_QueryInterface,
+    status2_AddRef,
+    status2_Release,
+    status2_GetIids,
+    status2_GetRuntimeClassName,
+    status2_GetTrustLevel,
+    status2_get_IsPartiallyStaged,
+};
+
 HRESULT package_status_create( const struct package_record *rec, IPackageStatus **out )
 {
     struct package_status *impl;
@@ -488,6 +523,7 @@ HRESULT package_status_create( const struct package_record *rec, IPackageStatus
 
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
     impl->IPackageStatus_iface.lpVtbl = &status_vtbl;
+    impl->IPackageStatus2_iface.lpVtbl = &status2_vtbl;
     impl->ref = 1;
     impl->license_issue = rec->state == PackageState_LicenseInvalid;
     impl->modified = rec->state == PackageState_Modified;
diff --git a/include/windows.applicationmodel.idl b/include/windows.applicationmodel.idl
index 5fef87f..914e208 100644
--- a/include/windows.applicationmodel.idl
+++ b/include/windows.applicationmodel.idl
@@ -334,6 +334,16 @@ namespace Windows.ApplicationModel {
         [propget] HRESULT DeploymentInProgress([out, retval] boolean *value);
     }
 
+    [
+        contract(Windows.Foundation.UniversalApiContract, 4.0),
+        exclusiveto(Windows.ApplicationModel.PackageStatus),
+        uuid(f428fa93-7c56-4862-acfa-abaedcc0694d)
+    ]
+    interface IPackageStatus2 : IInspectable
+    {
+        [propget] HRESULT IsPartiallyStaged([out, retval] boolean *value);
+    }
+
     [
         contract(Windows.Foundation.UniversalApiContract, 1.0),
         exclusiveto(Windows.ApplicationModel.PackageId),
