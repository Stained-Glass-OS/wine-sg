+/* Wide formats (16-bit integer, half and float) go through an intermediate of
+ * premultiplied RGBA floats. Float and half formats are linear (scRGB); the
+ * integer formats are sRGB coded. */
+static BOOL format_is_float(enum pixelformat format)
+{
+    return format == format_64bppRGBAHalf || format == format_64bppPRGBAHalf
+            || format == format_128bppRGBAFloat || format == format_128bppPRGBAFloat;
+}
+
+static BOOL format_is_wide(enum pixelformat format)
+{
+    return format_is_float(format) || format == format_64bppPRGBA;
+}
+
+static float half_to_float(WORD h)
+{
+    UINT sign = (h & 0x8000) << 16, exp = (h >> 10) & 0x1f, mant = h & 0x3ff;
+    union { UINT u; float f; } v;
+
+    if (!exp)
+    {
+        v.f = mant * (1.0f / 16777216.0f);
+        v.u |= sign;
+        return v.f;
+    }
+    if (exp == 31)
+        v.u = sign | 0x7f800000 | (mant << 13);
+    else
+        v.u = sign | ((exp + 112) << 23) | (mant << 13);
+    return v.f;
+}
+
+static WORD float_to_half(float f)
+{
+    union { float f; UINT u; } v;
+    UINT sign, exp, mant;
+
+    v.f = f;
+    sign = (v.u >> 16) & 0x8000;
+    exp = (v.u >> 23) & 0xff;
+    mant = v.u & 0x7fffff;
+    if (exp == 0xff)
+        return sign | 0x7c00 | (mant ? 0x200 : 0);
+    if (exp > 142)
+        return sign | 0x7c00;
+    if (exp < 113)
+    {
+        if (exp < 102)
+            return sign;
+        mant |= 0x800000;
+        return sign | ((mant >> (126 - exp)) + ((mant >> (125 - exp)) & 1));
+    }
+    return (sign | ((exp - 112) << 10) | (mant >> 13)) + ((mant >> 12) & 1);
+}
+
+static float srgb_to_linear(float c)
+{
+    if (c <= 0.04045f) return c / 12.92f;
+    return powf((c + 0.055f) / 1.055f, 2.4f);
+}
+
+static float linear_to_srgb(float c)
+{
+    if (c <= 0.0f) return 0.0f;
+    if (c >= 1.0f) return 1.0f;
+    if (c <= 0.0031308f) return c * 12.92f;
+    return 1.055f * powf(c, 1.0f / 2.4f) - 0.055f;
+}
+
+static BYTE float_to_byte(float c)
+{
+    if (!(c > 0.0f)) return 0;
+    if (c >= 1.0f) return 255;
+    return c * 255.0f + 0.5f;
+}
+
+static WORD float_to_word(float c)
+{
+    if (!(c > 0.0f)) return 0;
+    if (c >= 1.0f) return 65535;
+    return c * 65535.0f + 0.5f;
+}
+
+/* Reads prc from the source as premultiplied linear RGBA floats. */
+static HRESULT read_premultiplied_floats(struct FormatConverter *This, const WICRect *prc,
+        enum pixelformat source_format, float *out)
+{
+    UINT count = prc->Width * prc->Height, i, bpp, stride;
+    BYTE *data;
+    HRESULT hr;
+
+    switch (source_format)
+    {
+        case format_64bppRGBA: case format_64bppPRGBA:
+        case format_64bppRGBAHalf: case format_64bppPRGBAHalf: bpp = 8; break;
+        case format_128bppRGBAFloat: case format_128bppPRGBAFloat: bpp = 16; break;
+        default: bpp = 4; break;
+    }
+    stride = prc->Width * bpp;
+    if (!(data = malloc(stride * prc->Height)))
+        return E_OUTOFMEMORY;
+
+    if (bpp == 4)
+        hr = copypixels_to_32bppPBGRA(This, prc, stride, stride * prc->Height, data, source_format);
+    else
+        hr = IWICBitmapSource_CopyPixels(This->source, prc, stride, stride * prc->Height, data);
+    if (FAILED(hr))
+    {
+        free(data);
+        return hr;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        float *o = &out[i * 4], a;
+        BOOL premultiplied = TRUE, srgb = FALSE;
+
+        switch (source_format)
+        {
+            case format_64bppRGBA: case format_64bppPRGBA:
+            {
+                const WORD *w = (const WORD *)data + i * 4;
+                o[0] = w[0] / 65535.0f; o[1] = w[1] / 65535.0f; o[2] = w[2] / 65535.0f; o[3] = w[3] / 65535.0f;
+                premultiplied = source_format == format_64bppPRGBA;
+                srgb = TRUE;
+                break;
+            }
+            case format_64bppRGBAHalf: case format_64bppPRGBAHalf:
+            {
+                const WORD *w = (const WORD *)data + i * 4;
+                o[0] = half_to_float(w[0]); o[1] = half_to_float(w[1]);
+                o[2] = half_to_float(w[2]); o[3] = half_to_float(w[3]);
+                premultiplied = source_format == format_64bppPRGBAHalf;
+                break;
+            }
+            case format_128bppRGBAFloat: case format_128bppPRGBAFloat:
+                memcpy(o, (const float *)data + i * 4, 4 * sizeof(float));
+                premultiplied = source_format == format_128bppPRGBAFloat;
+                break;
+            default:
+            {
+                const BYTE *b = data + i * 4;
+                o[0] = b[2] / 255.0f; o[1] = b[1] / 255.0f; o[2] = b[0] / 255.0f; o[3] = b[3] / 255.0f;
+                srgb = TRUE;
+                break;
+            }
+        }
+
+        a = o[3];
+        if (srgb)
+        {
+            if (premultiplied && a > 0.0f)
+            {
+                o[0] /= a; o[1] /= a; o[2] /= a;
+            }
+            o[0] = srgb_to_linear(o[0]); o[1] = srgb_to_linear(o[1]); o[2] = srgb_to_linear(o[2]);
+            premultiplied = FALSE;
+        }
+        if (!premultiplied)
+        {
+            o[0] *= a; o[1] *= a; o[2] *= a;
+        }
+    }
+
+    free(data);
+    return S_OK;
+}
+
+static HRESULT copypixels_wide(struct FormatConverter *This, const WICRect *prc,
+    UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer, enum pixelformat source_format)
+{
+    enum pixelformat dst;
+    UINT x, y, bpp;
+    float *px;
+    HRESULT hr;
+
+    if (!prc)
+        return S_OK;
+    dst = This->dst_format->format;
+
+    switch (dst)
+    {
+        case format_24bppBGR: case format_24bppRGB: bpp = 3; break;
+        case format_32bppBGR: case format_32bppRGB: case format_32bppBGRA:
+        case format_32bppRGBA: case format_32bppPBGRA: case format_32bppPRGBA: bpp = 4; break;
+        case format_64bppRGBA: case format_64bppPRGBA:
+        case format_64bppRGBAHalf: case format_64bppPRGBAHalf: bpp = 8; break;
+        case format_128bppRGBAFloat: case format_128bppPRGBAFloat: bpp = 16; break;
+        default:
+            FIXME("Unsupported conversion %d -> %d.\n", source_format, dst);
+            return WINCODEC_ERR_UNSUPPORTEDOPERATION;
+    }
+
+    if (cbStride < prc->Width * bpp || cbBufferSize < cbStride * (prc->Height - 1) + prc->Width * bpp)
+        return E_INVALIDARG;
+
+    if (source_format == dst)
+        return IWICBitmapSource_CopyPixels(This->source, prc, cbStride, cbBufferSize, pbBuffer);
+
+    if (!(px = malloc(prc->Width * prc->Height * 4 * sizeof(float))))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = read_premultiplied_floats(This, prc, source_format, px)))
+    {
+        free(px);
+        return hr;
+    }
+
+    for (y = 0; y < prc->Height; ++y)
+    {
+        BYTE *row = pbBuffer + cbStride * y;
+
+        for (x = 0; x < prc->Width; ++x)
+        {
+            const float *c = &px[(y * prc->Width + x) * 4];
+            float a = c[3], r = c[0], g = c[1], b = c[2];
+            BOOL straight;
+
+            switch (dst)
+            {
+                case format_64bppRGBAHalf: case format_64bppPRGBAHalf:
+                {
+                    WORD *w = (WORD *)(row + x * 8);
+                    if (dst == format_64bppRGBAHalf && a > 0.0f)
+                    {
+                        r /= a; g /= a; b /= a;
+                    }
+                    w[0] = float_to_half(r); w[1] = float_to_half(g); w[2] = float_to_half(b); w[3] = float_to_half(a);
+                    break;
+                }
+                case format_128bppRGBAFloat: case format_128bppPRGBAFloat:
+                {
+                    float *f = (float *)(row + x * 16);
+                    if (dst == format_128bppRGBAFloat && a > 0.0f)
+                    {
+                        r /= a; g /= a; b /= a;
+                    }
+                    f[0] = r; f[1] = g; f[2] = b; f[3] = a;
+                    break;
+                }
+                default:
+                    if (a > 0.0f)
+                    {
+                        r /= a; g /= a; b /= a;
+                    }
+                    r = linear_to_srgb(r); g = linear_to_srgb(g); b = linear_to_srgb(b);
+                    if (a < 0.0f) a = 0.0f;
+                    if (a > 1.0f) a = 1.0f;
+                    straight = !(dst == format_32bppPBGRA || dst == format_32bppPRGBA || dst == format_64bppPRGBA);
+                    if (!straight)
+                    {
+                        r *= a; g *= a; b *= a;
+                    }
+                    if (dst == format_64bppRGBA || dst == format_64bppPRGBA)
+                    {
+                        WORD *w = (WORD *)(row + x * 8);
+                        w[0] = float_to_word(r); w[1] = float_to_word(g); w[2] = float_to_word(b); w[3] = float_to_word(a);
+                    }
+                    else
+                    {
+                        BYTE *o = row + x * bpp;
+                        BOOL bgr = dst == format_24bppBGR || dst == format_32bppBGR
+                                || dst == format_32bppBGRA || dst == format_32bppPBGRA;
+                        o[0] = float_to_byte(bgr ? b : r);
+                        o[1] = float_to_byte(g);
+                        o[2] = float_to_byte(bgr ? r : b);
+                        if (bpp == 4)
+                            o[3] = (dst == format_32bppBGR || dst == format_32bppRGB) ? 255 : float_to_byte(a);
+                    }
+                    break;
+            }
+        }
+    }
+
+    free(px);
+    return S_OK;
+}
