+/*********************************************************************
+ *		_getsystime (MSVCRT.@)
+ *
+ * Fills tp with the local time and returns its milliseconds.
+ */
+unsigned int CDECL _getsystime(struct tm *tp)
+{
+    static const int days[] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
+    TIME_ZONE_INFORMATION tzi;
+    SYSTEMTIME st;
+    int year;
+
+    TRACE("(%p)\n", tp);
+
+    GetLocalTime(&st);
+    year = st.wYear;
+    tp->tm_year = year - 1900;
+#ifndef SG_MUTANT_GETSYSTIME_MONTH_1BASED
+    tp->tm_mon = st.wMonth - 1;
+#else
+    tp->tm_mon = st.wMonth;
+#endif
+    tp->tm_mday = st.wDay;
+    tp->tm_hour = st.wHour;
+    tp->tm_min = st.wMinute;
+    tp->tm_sec = st.wSecond;
+    tp->tm_wday = st.wDayOfWeek;
+    tp->tm_yday = days[st.wMonth - 1] + st.wDay - 1 +
+            (st.wMonth > 2 && !(year % 4) && ((year % 100) || !(year % 400)));
+    tp->tm_isdst = GetTimeZoneInformation(&tzi) == TIME_ZONE_ID_DAYLIGHT;
+    return st.wMilliseconds;
+}
+
+/*********************************************************************
+ *		_setsystime (MSVCRT.@)
+ *
+ * Sets the local time from tp and ms; returns 0 or the system error.
+ */
+unsigned int CDECL _setsystime(struct tm *tp, unsigned int ms)
+{
+    SYSTEMTIME st;
+
+    TRACE("(%p %u)\n", tp, ms);
+
+    st.wYear = tp->tm_year + 1900;
+    st.wMonth = tp->tm_mon + 1;
+    st.wDayOfWeek = tp->tm_wday;
+    st.wDay = tp->tm_mday;
+    st.wHour = tp->tm_hour;
+    st.wMinute = tp->tm_min;
+    st.wSecond = tp->tm_sec;
+    st.wMilliseconds = ms;
+    if (!SetLocalTime(&st)) return GetLastError();
+    return 0;
+}
+
 /*********************************************************************
  *		_wstrtime (MSVCRT.@)
  */
