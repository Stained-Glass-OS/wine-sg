From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] shell32: FOLDERID_UserProgramFiles is %LOCALAPPDATA%\Programs

FOLDERID_UserProgramFiles and its Common were "disallowed" (a FIXME): a
per-user installer that asks where a user's own programs go got nothing,
and Opera's stopped with code 103 ("The path is invalid"). They are the
user's AppData\Local\Programs and its Common, as on Windows.
---
--- a/dlls/shell32/shellpath.c
+++ b/dlls/shell32/shellpath.c
@@ -2044,7 +2044,7 @@
     },
     { /* 0x6e */
         .id         = &FOLDERID_UserProgramFiles,
-        .type       = CSIDL_Type_Disallowed, /* FIXME */
+        .type       = CSIDL_Type_User, /* Stained Glass OS: %LOCALAPPDATA%\\Programs (Opera's installer) */
         .category   = KF_CATEGORY_PERUSER,
         .name       = L"UserProgramFiles",
         .parent     = &FOLDERID_LocalAppData,
@@ -2052,7 +2052,7 @@
     },
     { /* 0x6f */
         .id         = &FOLDERID_UserProgramFilesCommon,
-        .type       = CSIDL_Type_Disallowed, /* FIXME */
+        .type       = CSIDL_Type_User, /* Stained Glass OS: %LOCALAPPDATA%\\Programs\\Common */
         .category   = KF_CATEGORY_PERUSER,
         .name       = L"UserProgramFilesCommon",
         .parent     = &FOLDERID_UserProgramFiles,
