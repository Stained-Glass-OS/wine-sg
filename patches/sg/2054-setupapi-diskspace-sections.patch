+/***********************************************************************
+ *		SetupSetDirectoryIdExW    (SETUPAPI.@)
+ *
+ * Like SetupSetDirectoryIdW, with flags: SETDIRID_NOT_FULL_PATH says the
+ * directory may be relative, which is how it is stored here as well.
+ */
+BOOL WINAPI SetupSetDirectoryIdExW( HINF hinf, DWORD id, PCWSTR dir, DWORD flags, DWORD reserved1, PVOID reserved2 )
+{
+    TRACE( "%p, %lu, %s, %#lx, %lu, %p\n", hinf, id, debugstr_w(dir), flags, reserved1, reserved2 );
+
+    if ((flags & ~SETDIRID_NOT_FULL_PATH) || reserved1 || reserved2)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (id && !dir)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return SetupSetDirectoryIdW( hinf, id, dir );
+}
+
+
+/***********************************************************************
+ *		SetupSetDirectoryIdExA    (SETUPAPI.@)
+ */
+BOOL WINAPI SetupSetDirectoryIdExA( HINF hinf, DWORD id, PCSTR dir, DWORD flags, DWORD reserved1, PVOID reserved2 )
+{
+    WCHAR *dirW = NULL;
+    BOOL ret;
+
+    if (dir)
+    {
+        int len = MultiByteToWideChar( CP_ACP, 0, dir, -1, NULL, 0 );
+        if (!(dirW = malloc( len * sizeof(WCHAR) )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+        MultiByteToWideChar( CP_ACP, 0, dir, -1, dirW, len );
+    }
+    ret = SetupSetDirectoryIdExW( hinf, id, dirW, flags, reserved1, reserved2 );
+    free( dirW );
+    return ret;
+}
