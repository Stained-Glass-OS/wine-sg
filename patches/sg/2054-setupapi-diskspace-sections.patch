+/***********************************************************************
+ *		SetupAdjustDiskSpaceListW  (SETUPAPI.@)
+ *
+ * The space needed on a drive is changed by an amount, beyond the files.
+ */
+BOOL WINAPI SetupAdjustDiskSpaceListW(HDSKSPC diskspace, LPCWSTR drive, LONGLONG amount, PVOID reserved1, UINT reserved2)
+{
+    DISKSPACELIST *list = diskspace;
+    int index;
+
+    TRACE("(%p, %s, %I64d, %p, %u)\n", diskspace, debugstr_w(drive), amount, reserved1, reserved2);
+
+    if (!diskspace)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!drive || reserved1 || reserved2)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if ((index = find_drive(list, drive)) < 0)
+    {
+        SetLastError(ERROR_INVALID_DRIVE);
+        return FALSE;
+    }
+#ifndef SG_MUTANT_ADJUST_IGNORED
+    list->Drives[index].dwWantedSpace += amount;
+#endif
+    return TRUE;
+}
+
+/***********************************************************************
+ *		SetupAdjustDiskSpaceListA  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupAdjustDiskSpaceListA(HDSKSPC diskspace, LPCSTR drive, LONGLONG amount, PVOID reserved1, UINT reserved2)
+{
+    WCHAR driveW[MAX_PATH];
+
+    if (!drive)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    MultiByteToWideChar(CP_ACP, 0, drive, -1, driveW, ARRAY_SIZE(driveW));
+    return SetupAdjustDiskSpaceListW(diskspace, driveW, amount, reserved1, reserved2);
+}
