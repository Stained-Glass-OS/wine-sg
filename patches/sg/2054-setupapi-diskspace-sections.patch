+                                            UINT operation, PVOID reserved1, UINT reserved2)
+{
+    TRACE("(%p, %p, %p, %s, %u, %p, %u)\n", diskspace, inf, list_inf, debugstr_w(section), operation, reserved1, reserved2);
+    return disk_space_section(diskspace, inf, list_inf, section, operation, reserved1, reserved2, FALSE);
+}
