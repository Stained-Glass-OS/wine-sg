+/* the destination directory of a section of an inf: its DestinationDirs entry, else the default one */
+static WCHAR *section_dest_dir(HINF inf, const WCHAR *section)
+{
+    INFCONTEXT context;
+    WCHAR *dir;
+    BOOL found = section && SetupFindFirstLineW(inf, L"DestinationDirs", section, &context);
+
+    if (!found) found = SetupFindFirstLineW(inf, L"DestinationDirs", L"DefaultDestDir", &context);
+    if (found && (dir = PARSER_get_dest_dir(&context))) return dir;
+    return NULL;
+}
+
+/* the size an inf gives a source file (the third field of its SourceDisksFiles line), 0 when it gives none */
+static LONGLONG inf_source_size(HINF inf, const WCHAR *name)
+{
+    static const WCHAR *const sections[] = { L"SourceDisksFiles.amd64", L"SourceDisksFiles.ntamd64", L"SourceDisksFiles" };
+    INFCONTEXT context;
+    unsigned int i;
+    INT size;
+
+    for (i = 0; i < ARRAY_SIZE(sections); i++)
+        if (SetupFindFirstLineW(inf, sections[i], name, &context))
+            return SetupGetIntField(&context, 3, &size) ? size : 0;
+    return 0;
+}
+
+/* the files of a copy or delete section go to (or come out of) the list */
+static BOOL disk_space_section(HDSKSPC diskspace, HINF inf, HINF list_inf, const WCHAR *section, UINT operation,
+                               PVOID reserved1, UINT reserved2, BOOL remove)
+{
+    INFCONTEXT context;
+    WCHAR *dir;
+    BOOL ok = TRUE;
+
+    if (!diskspace)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!inf || !section || reserved1 || reserved2 || (operation != FILEOP_COPY && operation != FILEOP_DELETE))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!list_inf) list_inf = inf;
+    if (!SetupFindFirstLineW(list_inf, section, NULL, &context)) return FALSE;
+    if (!(dir = section_dest_dir(inf, section)))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+
+    do
+    {
+        WCHAR dst[MAX_PATH], src[MAX_PATH], path[MAX_PATH];
+        DWORD len;
+
+        if (!SetupGetStringFieldW(&context, 1, dst, ARRAY_SIZE(dst), NULL)) { ok = FALSE; break; }
+        if (!SetupGetStringFieldW(&context, 2, src, ARRAY_SIZE(src), &len) || len <= 1) lstrcpyW(src, dst);
+        if (lstrlenW(dir) + lstrlenW(dst) + 2 > MAX_PATH) { SetLastError(ERROR_BUFFER_OVERFLOW); ok = FALSE; break; }
+        lstrcpyW(path, dir);
+        if (path[0] && path[lstrlenW(path) - 1] != '\\') lstrcatW(path, L"\\");
+        lstrcatW(path, dst);
+
+        if (remove) SetupRemoveFromDiskSpaceListW(diskspace, path, operation, NULL, 0);
+#ifdef SG_MUTANT_SECTION_SIZE
+        else if (!SetupAddToDiskSpaceListW(diskspace, path, 0, operation, NULL, 0))
+#elif defined(SG_MUTANT_SECTION_DELETE)
+        else if (!SetupAddToDiskSpaceListW(diskspace, path, inf_source_size(list_inf, src), FILEOP_COPY, NULL, 0))
+#else
+        else if (!SetupAddToDiskSpaceListW(diskspace, path, operation == FILEOP_COPY ? inf_source_size(list_inf, src) : 0,
+                                            operation, NULL, 0))
+#endif
+        {
+            ok = FALSE;
+            break;
+        }
+    } while (SetupFindNextLine(&context, &context));
+
+    free(dir);
+    return ok;
+}
+
+/* the CopyFiles and DelFiles of an install section: their sections, or "@file" for one file */
+static BOOL disk_space_install_section(HDSKSPC diskspace, HINF inf, HINF layout_inf, const WCHAR *section,
+                                       PVOID reserved1, UINT reserved2, BOOL remove)
+{
+    static const struct { const WCHAR *key; UINT operation; } directives[] =
+    {
+        { L"CopyFiles", FILEOP_COPY },
+        { L"DelFiles", FILEOP_DELETE },
+    };
+    unsigned int i;
+    INFCONTEXT context;
+
+    if (!diskspace)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!inf || !section || reserved1 || reserved2)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!layout_inf) layout_inf = inf;
+
+    for (i = 0; i < ARRAY_SIZE(directives); i++)
+    {
+        BOOL found = SetupFindFirstLineW(inf, section, directives[i].key, &context);
+
+        for (; found; found = SetupFindNextMatchLineW(&context, directives[i].key, &context))
+        {
+            DWORD n, count = SetupGetFieldCount(&context);
+
+            for (n = 1; n <= count; n++)
+            {
+                WCHAR name[MAX_PATH];
+
+                if (!SetupGetStringFieldW(&context, n, name, ARRAY_SIZE(name), NULL)) return FALSE;
+                if (name[0] == '@')
+                {
+                    WCHAR path[MAX_PATH], *dir = section_dest_dir(inf, NULL);
+
+                    if (!dir) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return FALSE; }
+                    if (lstrlenW(dir) + lstrlenW(name) + 2 > MAX_PATH) { free(dir); SetLastError(ERROR_BUFFER_OVERFLOW); return FALSE; }
+                    lstrcpyW(path, dir);
+                    if (path[0] && path[lstrlenW(path) - 1] != '\\') lstrcatW(path, L"\\");
+                    lstrcatW(path, name + 1);
+                    free(dir);
+                    if (remove) SetupRemoveFromDiskSpaceListW(diskspace, path, directives[i].operation, NULL, 0);
+                    else if (!SetupAddToDiskSpaceListW(diskspace, path,
+                             directives[i].operation == FILEOP_COPY ? inf_source_size(layout_inf, name + 1) : 0,
+                             directives[i].operation, NULL, 0))
+                        return FALSE;
+                }
+                else if (!disk_space_section(diskspace, inf, layout_inf, name, directives[i].operation, NULL, 0, remove))
+                    return FALSE;
+            }
+        }
+    }
+    return TRUE;
+}
+
+#define SECTION_A_TO_W(call_w, ...) \
+    do { \
+        WCHAR *sectionW; \
+        BOOL ret; \
+        int n; \
+        if (!section) { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; } \
+        n = MultiByteToWideChar(CP_ACP, 0, section, -1, NULL, 0); \
+        if (!(sectionW = malloc(n * sizeof(WCHAR)))) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return FALSE; } \
+        MultiByteToWideChar(CP_ACP, 0, section, -1, sectionW, n); \
+        ret = call_w; \
+        free(sectionW); \
+        return ret; \
+    } while (0)
