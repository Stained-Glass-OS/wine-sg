+/***********************************************************************
+ *      SetupRemoveFromSourceListW (SETUPAPI.@)
+ */
+BOOL WINAPI SetupRemoveFromSourceListW( DWORD flags, PCWSTR source )
+{
+    struct string_list list, kept = {0};
+    HKEY root = NULL;
+    BOOL temporary, ok = TRUE;
+    const WCHAR *p;
+    LONG err = 0;
+    UINT i;
+
+    TRACE( "0x%08lx %s\n", flags, debugstr_w( source ) );
+
+    if ((flags & ~SRCLIST_KNOWN) || !(flags & SRCLIST_WHERE) || !source || !*source)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    source_root( flags, &root, &temporary );
+
+    EnterCriticalSection( &source_cs );
+    if (temporary) temporary_get( &list ); else registry_list_read( root, &list );
+    if (list_contains( &list, source ))
+    {
+        for (p = list.data, i = 0; i < list.count && ok; i++, p += wcslen( p ) + 1)
+#ifdef SG_MUTANT_SOURCE_NO_REMOVE
+            ok = list_append( &kept, p );
+#else
+            if (wcsicmp( p, source )) ok = list_append( &kept, p );
+#endif
+        if (!ok) err = ERROR_NOT_ENOUGH_MEMORY;
+        else if (temporary) temporary_set( &kept );
+        else err = registry_list_write( root, &kept );
+    }
+    LeaveCriticalSection( &source_cs );
+    list_free( &list );
+    list_free( &kept );
+    if (err) SetLastError( err );
+    return !err;
+}
+
+/***********************************************************************
+ *      SetupRemoveFromSourceListA (SETUPAPI.@)
+ */
+BOOL WINAPI SetupRemoveFromSourceListA( DWORD flags, PCSTR source )
+{
+    WCHAR *sourceW = NULL;
+    BOOL ret;
+
+    if (source)
+    {
+        DWORD len = MultiByteToWideChar( CP_ACP, 0, source, -1, NULL, 0 );
+        if (!(sourceW = malloc( len * sizeof(WCHAR) ))) { SetLastError( ERROR_NOT_ENOUGH_MEMORY ); return FALSE; }
+        MultiByteToWideChar( CP_ACP, 0, source, -1, sourceW, len );
+    }
+    ret = SetupRemoveFromSourceListW( flags, sourceW );
+    free( sourceW );
+    return ret;
+}
