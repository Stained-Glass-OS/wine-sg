+/***********************************************************************
+ *		SetupGetSourceFileSizeW  (SETUPAPI.@)
+ *
+ * The size of a source file as the inf gives it (the third field of its
+ * SourceDisksFiles line), or the sizes of all the files of a copy section
+ * added up; each is rounded up to a multiple of the rounding factor.
+ */
+BOOL WINAPI SetupGetSourceFileSizeW(HINF inf, PINFCONTEXT context, PCWSTR filename, PCWSTR section, PDWORD size,
+                                    UINT rounding)
+{
+    INFCONTEXT line;
+    LONGLONG total = 0;
+    WCHAR name[MAX_PATH];
+
+    TRACE("(%p, %p, %s, %s, %p, %u)\n", inf, context, debugstr_w(filename), debugstr_w(section), size, rounding);
+
+    if (!size || (!filename && !section && !context))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if (section)
+    {
+        /* all the files of a copy section: the second field names the source, else the first */
+        DWORD len;
+
+        if (!SetupFindFirstLineW(inf, section, NULL, &line)) return FALSE;
+        do
+        {
+            LONGLONG one;
+
+            if (!SetupGetStringFieldW(&line, 2, name, ARRAY_SIZE(name), &len) || len <= 1)
+                if (!SetupGetStringFieldW(&line, 1, name, ARRAY_SIZE(name), NULL)) return FALSE;
+            one = inf_source_size(inf, name);
+#ifndef SG_MUTANT_SOURCE_SIZE_ROUND
+            if (rounding) one = (one + rounding - 1) / rounding * rounding;
+#endif
+            total += one;
+        } while (SetupFindNextLine(&line, &line));
+    }
+    else
+    {
+        if (context && !filename)
+        {
+            if (!SetupGetStringFieldW(context, 1, name, ARRAY_SIZE(name), NULL)) return FALSE;
+            filename = name;
+        }
+        total = inf_source_size(inf, filename);
+#ifndef SG_MUTANT_SOURCE_SIZE_ROUND
+        if (rounding) total = (total + rounding - 1) / rounding * rounding;
+#endif
+    }
+    *size = (DWORD)total;
+    return TRUE;
+}
+
+/***********************************************************************
+ *		SetupGetSourceFileSizeA  (SETUPAPI.@)
+ */
+BOOL WINAPI SetupGetSourceFileSizeA(HINF inf, PINFCONTEXT context, PCSTR filename, PCSTR section, PDWORD size,
+                                    UINT rounding)
+{
+    WCHAR fileW[MAX_PATH], sectionW[MAX_PATH];
+
+    if (filename) MultiByteToWideChar(CP_ACP, 0, filename, -1, fileW, ARRAY_SIZE(fileW));
+    if (section) MultiByteToWideChar(CP_ACP, 0, section, -1, sectionW, ARRAY_SIZE(sectionW));
+    return SetupGetSourceFileSizeW(inf, context, filename ? fileW : NULL, section ? sectionW : NULL, size, rounding);
+}
