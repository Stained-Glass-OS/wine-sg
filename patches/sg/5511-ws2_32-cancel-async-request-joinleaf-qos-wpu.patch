From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] ws2_32: WSACancelAsyncRequest, WSAJoinLeaf, WSAGetQOSByName, WPUCompleteOverlappedRequest

WSACancelAsyncRequest did nothing and said it worked. A WSAAsyncGetXByY query
now stays on a list until its lookup ends; cancelling one in time drops its
answer (no message is posted) and returns 0; one that has been answered fails
with WSAEALREADY, an unknown or zero handle with WSAEINVAL, as documented.

WSAJoinLeaf returned INVALID_SOCKET without setting an error. It fails with
WSAENOTSOCK for a non-socket and with WSAEINVAL for a socket that was not
opened as a multipoint leaf, which is every socket here.

WSAGetQOSByName returned FALSE without an error. It checks its arguments
(WSAEFAULT, WSAENOTSOCK) and, since no QOS service provider is installed,
answers a request for the template names with an empty list and an unknown
template name with WSAEINVAL.

WPUCompleteOverlappedRequest was declared to return a WSAEVENT and returned
NULL, which is "success" for the int the documentation describes. It returns
SOCKET_ERROR with WSAEINVAL in lpErrno: the function is for sockets made by
WPUCreateSocketHandle, and there are none. The declaration in ws2spi.h is
corrected.
---
--- a/dlls/ws2_32/async.c
+++ b/dlls/ws2_32/async.c
@@ -35,6 +35,7 @@
  */
 
 #include "ws2_32_private.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(winsock);
 
@@ -47,8 +48,17 @@ struct async_query_header
     void  *sbuf;
     INT    sbuflen;
     HANDLE handle;
+    struct list entry;      /* in pending_queries until the result is posted */
+    BOOL   cancelled;
 };
 
+/* the queries that are running, and the last ones that were answered, so
+ * that WSACancelAsyncRequest can tell WSAEALREADY from WSAEINVAL */
+static SRWLOCK query_lock = SRWLOCK_INIT;
+static struct list pending_queries = LIST_INIT( pending_queries );
+static ULONG completed_handles[64];
+static unsigned int completed_pos;
+
 struct async_query_gethostbyname
 {
     struct async_query_header query;
@@ -244,7 +254,15 @@ static void WINAPI async_worker( TP_CALLBACK_INSTANCE *instance, void *context )
 {
     struct async_query_header *query = context;
     LPARAM lparam = query->func( query );
-    PostMessageW( query->hWnd, query->uMsg, (WPARAM)query->handle, lparam );
+    BOOL cancelled;
+
+    AcquireSRWLockExclusive( &query_lock );
+    list_remove( &query->entry );
+    if (!(cancelled = query->cancelled))
+        completed_handles[completed_pos++ % ARRAY_SIZE(completed_handles)] = HandleToUlong( query->handle );
+    ReleaseSRWLockExclusive( &query_lock );
+
+    if (!cancelled) PostMessageW( query->hWnd, query->uMsg, (WPARAM)query->handle, lparam );
     free( query );
 }
 
@@ -271,9 +289,17 @@ static HANDLE run_query( HWND hWnd, UINT uMsg, LPARAM (*func)(struct async_query
     query->handle  = UlongToHandle( handle );
     query->sbuf    = sbuf;
     query->sbuflen = sbuflen;
+    query->cancelled = FALSE;
+
+    AcquireSRWLockExclusive( &query_lock );
+    list_add_tail( &pending_queries, &query->entry );
+    ReleaseSRWLockExclusive( &query_lock );
 
     if (!TrySubmitThreadpoolCallback( async_worker, query, NULL ))
     {
+        AcquireSRWLockExclusive( &query_lock );
+        list_remove( &query->entry );
+        ReleaseSRWLockExclusive( &query_lock );
         SetLastError( WSAEWOULDBLOCK );
         free( query );
         return 0;
@@ -433,10 +459,38 @@ HANDLE WINAPI WSAAsyncGetServByPort(HWND hWnd, UINT uMsg, INT port,
  */
 INT WINAPI WSACancelAsyncRequest(HANDLE hAsyncTaskHandle)
 {
-    FIXME("(%p),stub\n", hAsyncTaskHandle);
-    return 0;
-}
+    struct async_query_header *query;
+    ULONG handle = HandleToUlong( hAsyncTaskHandle );
+    INT ret = SOCKET_ERROR;
+    unsigned int i;
+    int err = WSAEINVAL;
 
+    TRACE( "(%p)\n", hAsyncTaskHandle );
+
+    if (handle)
+    {
+        AcquireSRWLockExclusive( &query_lock );
+        LIST_FOR_EACH_ENTRY( query, &pending_queries, struct async_query_header, entry )
+        {
+            if (query->handle != hAsyncTaskHandle || query->cancelled) continue;
+            /* the answer is dropped when the lookup ends */
+#ifndef SG_MUTANT_CANCEL_NOOP
+            query->cancelled = TRUE;
+#endif
+            ret = 0;
+            break;
+        }
+        if (ret)
+        {
+            /* answered: the message is posted or was handled */
+            for (i = 0; i < ARRAY_SIZE(completed_handles); i++)
+                if (completed_handles[i] == handle) err = WSAEALREADY;
+        }
+        ReleaseSRWLockExclusive( &query_lock );
+    }
+    if (ret) SetLastError( err );
+    return ret;
+}
 /***********************************************************************
  *       WSApSetPostRoutine	(WS2_32.24)
  */
@@ -449,14 +503,19 @@ INT WINAPI WSApSetPostRoutine(LPWPUPOSTMESSAGE lpPostRoutine)
 /***********************************************************************
  *        WPUCompleteOverlappedRequest   (WS2_32.25)
  */
-WSAEVENT WINAPI WPUCompleteOverlappedRequest(SOCKET s, LPWSAOVERLAPPED overlapped,
-                                             DWORD error, DWORD transferred, LPINT errcode)
+int WINAPI WPUCompleteOverlappedRequest(SOCKET s, LPWSAOVERLAPPED overlapped,
+                                        DWORD error, DWORD transferred, LPINT errcode)
 {
-    FIXME( "socket %#Ix, overlapped %p, error %lu, transferred %lu, errcode %p, stub!\n",
+    TRACE( "socket %#Ix, overlapped %p, error %lu, transferred %lu, errcode %p\n",
            s, overlapped, error, transferred, errcode );
 
+    /* Only for sockets made by WPUCreateSocketHandle, which belongs to
+     * service providers that Wine does not load: no socket here is one. */
     if (errcode)
         *errcode = WSAEINVAL;
 
-    return NULL;
-}
+#ifdef SG_MUTANT_WPU_SUCCESS
+    return 0;
+#endif
+    return SOCKET_ERROR;
+}
\ No newline at end of file
--- a/dlls/ws2_32/socket.c
+++ b/dlls/ws2_32/socket.c
@@ -4270,10 +4270,22 @@ SOCKET WINAPI WSASocketW(int af, int type, int protocol,
 SOCKET WINAPI WSAJoinLeaf( SOCKET s, const struct sockaddr *addr, int addrlen, WSABUF *caller_data,
                            WSABUF *callee_data, QOS *socket_qos, QOS *group_qos, DWORD flags)
 {
-    FIXME("stub.\n");
+    int type, len = sizeof(type);
+
+    TRACE( "socket %#Ix, addr %p, addrlen %d, caller_data %p, callee_data %p, socket_qos %p, group_qos %p, flags %#lx\n",
+           s, addr, addrlen, caller_data, callee_data, socket_qos, group_qos, flags );
+
+#ifndef SG_MUTANT_JOIN_NOCHECK
+    if (getsockopt( s, SOL_SOCKET, SO_TYPE, (char *)&type, &len ))
+        return INVALID_SOCKET; /* WSAENOTSOCK and the like */
+#endif
+
+    /* Only a socket opened as a multipoint leaf can join a session, and no
+     * socket here is one. */
+    WARN( "multipoint sessions are not supported\n" );
+    SetLastError( WSAEINVAL );
     return INVALID_SOCKET;
 }
-
 /***********************************************************************
  *      __WSAFDIsSet			(WS2_32.151)
  */
@@ -4479,11 +4491,44 @@ int WINAPI WSADuplicateSocketW( SOCKET s, DWORD dwProcessId, LPWSAPROTOCOL_INFOW
  */
 BOOL WINAPI WSAGetQOSByName( SOCKET s, WSABUF *name, QOS *qos )
 {
-    FIXME( "socket %#Ix, name %p, qos %p, stub!\n", s, name, qos );
+    int type, len = sizeof(type);
+
+    TRACE( "socket %#Ix, name %p, qos %p\n", s, name, qos );
+
+    if (!name || !name->buf)
+    {
+        SetLastError( WSAEFAULT );
+        return FALSE;
+    }
+    if (getsockopt( s, SOL_SOCKET, SO_TYPE, (char *)&type, &len ))
+        return FALSE;
+
+    /* No QOS service provider is installed, so there are no templates. An empty
+     * name asks for the list of template names: an empty list, ended by the
+     * empty name. */
+#ifdef SG_MUTANT_QOS_NOLIST
+    if (0)
+#else
+    if (!name->buf[0])
+#endif
+    {
+        if (!name->len)
+        {
+            SetLastError( WSAEFAULT );
+            return FALSE;
+        }
+        name->buf[0] = 0;
+        return TRUE;
+    }
+    if (!qos)
+    {
+        SetLastError( WSAEFAULT );
+        return FALSE;
+    }
+    SetLastError( WSAEINVAL );
     return FALSE;
 }
 
