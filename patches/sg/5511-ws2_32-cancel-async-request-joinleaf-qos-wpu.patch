@@ -627,6 +627,144 @@ static void test_WSAAsyncGetServByName(void)
     DestroyWindow(hwnd);
 }
 
+static void test_WSACancelAsyncRequest(void)
+{
+    HWND hwnd = create_async_message_window();
+    char buffer[MAXGETHOSTSTRUCT];
+    HANDLE handles[50];
+    BOOL cancelled[50];
+    int i, ret, err, wins = 0, posted[50] = {0};
+    DWORD end;
+    MSG msg;
+
+    SetLastError(0xdeadbeef);
+    ret = WSACancelAsyncRequest(NULL);
+    err = WSAGetLastError();
+    ok(ret == SOCKET_ERROR, "got %d\n", ret);
+    ok(err == WSAEINVAL, "got %d\n", err);
+
+    SetLastError(0xdeadbeef);
+    ret = WSACancelAsyncRequest((HANDLE)0x7fff0000);
+    err = WSAGetLastError();
+    ok(ret == SOCKET_ERROR, "got %d\n", ret);
+    ok(err == WSAEINVAL, "got %d\n", err);
+
+    /* an answered request cannot be cancelled */
+    handles[0] = WSAAsyncGetServByPort(hwnd, WM_ASYNCCOMPLETE, htons(80), NULL, buffer, MAXGETHOSTSTRUCT);
+    ok(handles[0] != NULL, "WSAAsyncGetServByPort returned NULL\n");
+    wait_for_async_message(hwnd, handles[0]);
+    SetLastError(0xdeadbeef);
+    ret = WSACancelAsyncRequest(handles[0]);
+    err = WSAGetLastError();
+    ok(ret == SOCKET_ERROR, "got %d\n", ret);
+    ok(err == WSAEALREADY || err == WSAEINVAL, "got %d\n", err);
+
+    /* a request that is cancelled in time never posts its message; one that is
+     * not (it was answered already) does */
+    for (i = 0; i < ARRAY_SIZE(handles); i++)
+    {
+        handles[i] = WSAAsyncGetServByPort(hwnd, WM_ASYNCCOMPLETE, htons(80), NULL, buffer, MAXGETHOSTSTRUCT);
+        ok(handles[i] != NULL, "WSAAsyncGetServByPort returned NULL\n");
+        SetLastError(0xdeadbeef);
+        ret = WSACancelAsyncRequest(handles[i]);
+        err = WSAGetLastError();
+        cancelled[i] = !ret;
+        if (ret) ok(err == WSAEALREADY || err == WSAEINVAL, "got %d\n", err);
+        else wins++;
+    }
+    end = GetTickCount() + 300;
+    while (GetTickCount() < end)
+    {
+        while (PeekMessageA(&msg, 0, 0, 0, PM_REMOVE))
+        {
+            if (msg.hwnd == hwnd && msg.message == WM_ASYNCCOMPLETE)
+            {
+                for (i = 0; i < ARRAY_SIZE(handles); i++)
+                    if ((WPARAM)handles[i] == msg.wParam) posted[i]++;
+            }
+            else
+            {
+                TranslateMessage(&msg);
+                DispatchMessageA(&msg);
+            }
+        }
+        Sleep(10);
+    }
+    for (i = 0; i < ARRAY_SIZE(handles); i++)
+    {
+        if (cancelled[i]) ok(!posted[i], "request %d was cancelled but its message arrived\n", i);
+        else ok(posted[i] == 1, "request %d was not cancelled, got %d messages\n", i, posted[i]);
+    }
+    trace("%d of %d requests were cancelled in time\n", wins, (int)ARRAY_SIZE(handles));
+
+    DestroyWindow(hwnd);
+}
+
+static void test_WSAJoinLeaf_and_QOS(void)
+{
+    char names[64] = "";
+    WSABUF name = {sizeof(names), names};
+    SOCKET s, joined;
+    SOCKADDR_IN addr = {0};
+    OVERLAPPED overlapped = {0};
+    BOOL bret;
+    QOS qos;
+    int ret, err, count;
+    char *p;
+
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr.sin_port = htons(9);
+
+    SetLastError(0xdeadbeef);
+    joined = WSAJoinLeaf(INVALID_SOCKET, (struct sockaddr *)&addr, sizeof(addr), NULL, NULL, NULL, NULL, JL_BOTH);
+    err = WSAGetLastError();
+    ok(joined == INVALID_SOCKET, "got %#Ix\n", joined);
+    ok(err == WSAENOTSOCK, "got %d\n", err);
+
+    s = socket(AF_INET, SOCK_DGRAM, 0);
+    ok(s != INVALID_SOCKET, "got error %d\n", WSAGetLastError());
+
+    /* a UDP socket that was not opened as a multipoint leaf */
+    SetLastError(0xdeadbeef);
+    joined = WSAJoinLeaf(s, (struct sockaddr *)&addr, sizeof(addr), NULL, NULL, NULL, NULL, JL_BOTH);
+    err = WSAGetLastError();
+    ok(joined == INVALID_SOCKET, "got %#Ix\n", joined);
+    ok(err == WSAEINVAL, "got %d\n", err);
+
+    /* QOS templates */
+    SetLastError(0xdeadbeef);
+    bret = WSAGetQOSByName(INVALID_SOCKET, &name, &qos);
+    err = WSAGetLastError();
+    ok(!bret, "got %d\n", bret);
+    ok(err == WSAENOTSOCK, "got %d\n", err);
+
+    SetLastError(0xdeadbeef);
+    bret = WSAGetQOSByName(s, NULL, &qos);
+    err = WSAGetLastError();
+    ok(!bret, "got %d\n", bret);
+    ok(err == WSAEFAULT, "got %d\n", err);
+
+    /* an empty name asks for the names: a list ended by an empty name */
+    memset(names, 'x', sizeof(names));
+    names[0] = 0;
+    bret = WSAGetQOSByName(s, &name, &qos);
+    ok(bret, "got %d, error %d\n", bret, WSAGetLastError());
+    count = 0;
+    for (p = names; p < names + sizeof(names) && *p; p += strlen(p) + 1) count++;
+    ok(p < names + sizeof(names), "the list of names is not ended (%d names)\n", count);
+
+    closesocket(s);
+
+    /* only for sockets of a provider that uses WPUCreateSocketHandle */
+    s = socket(AF_INET, SOCK_STREAM, 0);
+    err = 0xdeadbeef;
+    ret = WPUCompleteOverlappedRequest(s, &overlapped, 0, 0, &err);
+    ok(ret == SOCKET_ERROR, "got %d\n", ret);
+    ok(err == WSAEINVAL, "got %d\n", err);
+    closesocket(s);
+}
