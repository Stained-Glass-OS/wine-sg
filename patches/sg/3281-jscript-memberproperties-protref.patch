From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stained Glass OS <ke7oxh@gmail.com>
Date: Wed, 14 Oct 2026 22:06:05 -0700
Subject: [PATCH] jscript: GetMemberProperties follows an inherited property to
 the prototype (3281)

IDispatchEx::GetMemberProperties of a property that an object has from its prototype (every DOM method and property of an IE9+ mode element, the builtin members of a script object) now answers with the prototype's property, not with "cannot put, cannot call" of the empty reference.

diff --git a/dlls/jscript/dispex.c b/dlls/jscript/dispex.c
index 271140f..ac5cf8c 100644
--- a/dlls/jscript/dispex.c
+++ b/dlls/jscript/dispex.c
@@ -2327,7 +2327,7 @@ static HRESULT WINAPI DispatchEx_DeleteMemberByDispID(IWineJSDispatch *iface, DI
 
 static HRESULT WINAPI DispatchEx_GetMemberProperties(IWineJSDispatch *iface, DISPID id, DWORD grfdexFetch, DWORD *pgrfdex)
 {
-    jsdisp_t *This = impl_from_IWineJSDispatch(iface);
+    jsdisp_t *This = impl_from_IWineJSDispatch(iface), *proto_obj = This;
     dispex_prop_t *prop;
 
     TRACE("(%p)->(%lx %lx %p)\n", This, id, grfdexFetch, pgrfdex);
@@ -2337,6 +2337,15 @@ static HRESULT WINAPI DispatchEx_GetMemberProperties(IWineJSDispatch *iface, DIS
         return DISP_E_MEMBERNOTFOUND;
     *pgrfdex = 0;
 
+    /* a property inherited from a prototype is the prototype's property */
+#ifndef SG_MUTANT_JSB1_PROTREF
+    while(prop->type == PROP_PROTREF) {
+        if(!(proto_obj = proto_obj->prototype))
+            return DISP_E_MEMBERNOTFOUND;
+        prop = proto_obj->props + prop->u.ref;
+    }
+#endif
+
     if(grfdexFetch) {
         BOOL can_get = TRUE, can_put = !!(prop->flags & PROPF_WRITABLE), can_call = FALSE, can_construct = FALSE;
 
