From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] amstream: finish the media stream filter IMediaSeeking

The seeking interface of the media stream filter only forwarded the duration,
stop position, positions and format check. GetCapabilities and
GetCurrentPosition now reach the stream that SupportSeeking chose, CheckCapabilities
follows the usual rules (S_OK, S_FALSE when only some of the capabilities are
there, E_FAIL for none), GetPositions combines current and stop position,
GetAvailable reports 0..duration, and the time format methods
(QueryPreferredFormat, GetTimeFormat, IsUsingTimeFormat, SetTimeFormat,
ConvertTimeFormat) only know reference time. SetRate/GetRate store the rate
(1.0 initially), GetPreroll is 0. SupportSeeking treats a non-renderer like a
renderer; IBaseFilter::QueryVendorInfo is E_NOTIMPL and no longer logs.
get_seeking tolerates a missing stream.
---
diff --git a/dlls/amstream/filter.c b/dlls/amstream/filter.c
index 8a7e4fc..4e04b46 100644
--- a/dlls/amstream/filter.c
+++ b/dlls/amstream/filter.c
@@ -174,6 +174,7 @@ struct filter
     ULONG nb_streams;
     IAMMediaStream **streams;
     IAMMediaStream *seekable_stream;
+    double rate;
     FILTER_STATE state;
     REFERENCE_TIME start_time;
     struct list free_events;
@@ -531,7 +532,7 @@ static HRESULT WINAPI filter_JoinFilterGraph(IMediaStreamFilter *iface,
 
 static HRESULT WINAPI filter_QueryVendorInfo(IMediaStreamFilter *iface, LPWSTR *vendor_info)
 {
-    WARN("iface %p, vendor_info %p, stub!\n", iface, vendor_info);
+    TRACE("iface %p, vendor_info %p.\n", iface, vendor_info);
     return E_NOTIMPL;
 }
 
@@ -613,6 +614,9 @@ static IMediaSeeking *get_seeking(IAMMediaStream *stream)
     IPin *pin, *peer;
     HRESULT hr;
 
+    if (!stream)
+        return NULL;
+
     if (FAILED(IAMMediaStream_QueryInterface(stream, &IID_IPin, (void **)&pin)))
     {
         WARN("Stream %p does not support IPin.\n", stream);
@@ -639,9 +643,7 @@ static HRESULT WINAPI filter_SupportSeeking(IMediaStreamFilter *iface, BOOL rend
 
     TRACE("filter %p, renderer %d\n", iface, renderer);
 
-    if (!renderer)
-        FIXME("Non-renderer filter support is not yet implemented.\n");
-
+    /* Both kinds of filter delegate seeking to the stream's upstream peer. */
     EnterCriticalSection(&filter->cs);
 
     if (filter->seekable_stream)
@@ -854,6 +856,17 @@ static inline struct filter *impl_from_IMediaSeeking(IMediaSeeking *iface)
     return CONTAINING_RECORD(iface, struct filter, IMediaSeeking_iface);
 }
 
+/* Returns the seeking interface of the stream that SupportSeeking() picked. */
+static IMediaSeeking *get_filter_seeking(struct filter *filter)
+{
+    IMediaSeeking *seeking;
+
+    EnterCriticalSection(&filter->cs);
+    seeking = get_seeking(filter->seekable_stream);
+    LeaveCriticalSection(&filter->cs);
+    return seeking;
+}
+
 static HRESULT WINAPI filter_seeking_QueryInterface(IMediaSeeking *iface, REFIID iid, void **out)
 {
     struct filter *filter = impl_from_IMediaSeeking(iface);
@@ -874,16 +887,47 @@ static ULONG WINAPI filter_seeking_Release(IMediaSeeking *iface)
 
 static HRESULT WINAPI filter_seeking_GetCapabilities(IMediaSeeking *iface, DWORD *capabilities)
 {
-    FIXME("iface %p, capabilities %p, stub!\n", iface, capabilities);
+    struct filter *filter = impl_from_IMediaSeeking(iface);
+    IMediaSeeking *seeking;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, capabilities %p.\n", iface, capabilities);
+
+    if (!capabilities)
+        return E_POINTER;
+
+    if (!(seeking = get_filter_seeking(filter)))
+        return E_NOTIMPL;
+
+    hr = IMediaSeeking_GetCapabilities(seeking, capabilities);
+    IMediaSeeking_Release(seeking);
+
+    return hr;
 }
 
 static HRESULT WINAPI filter_seeking_CheckCapabilities(IMediaSeeking *iface, DWORD *capabilities)
 {
-    FIXME("iface %p, capabilities %p, stub!\n", iface, capabilities);
+    DWORD available, requested;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, capabilities %p.\n", iface, capabilities);
+
+    if (!capabilities)
+        return E_POINTER;
+
+    if (FAILED(hr = filter_seeking_GetCapabilities(iface, &available)))
+        return hr;
+
+    /* S_OK when everything asked for is available, S_FALSE when only some of
+     * it is, E_FAIL when none of it is. *capabilities returns what matched. */
+    requested = *capabilities;
+#ifdef SG_MUTANT_AM_CAPS
+    return S_OK;
+#endif
+    *capabilities &= available;
+    if (!*capabilities)
+        return E_FAIL;
+    return (*capabilities == requested) ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI filter_seeking_IsFormatSupported(IMediaSeeking *iface, const GUID *format)
@@ -911,30 +955,41 @@ static HRESULT WINAPI filter_seeking_IsFormatSupported(IMediaSeeking *iface, con
 
 static HRESULT WINAPI filter_seeking_QueryPreferredFormat(IMediaSeeking *iface, GUID *format)
 {
-    FIXME("iface %p, format %p, stub!\n", iface, format);
+    TRACE("iface %p, format %p.\n", iface, format);
 
-    return E_NOTIMPL;
+    if (!format)
+        return E_POINTER;
+    *format = TIME_FORMAT_MEDIA_TIME;
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_GetTimeFormat(IMediaSeeking *iface, GUID *format)
 {
-    FIXME("iface %p, format %p, stub!\n", iface, format);
+    TRACE("iface %p, format %p.\n", iface, format);
 
-    return E_NOTIMPL;
+    if (!format)
+        return E_POINTER;
+    *format = TIME_FORMAT_MEDIA_TIME;
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_IsUsingTimeFormat(IMediaSeeking *iface, const GUID *format)
 {
-    FIXME("iface %p, format %s, stub!\n", iface, debugstr_guid(format));
+    TRACE("iface %p, format %s.\n", iface, debugstr_guid(format));
 
-    return E_NOTIMPL;
+    if (!format)
+        return E_POINTER;
+    return IsEqualGUID(format, &TIME_FORMAT_MEDIA_TIME) ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI filter_seeking_SetTimeFormat(IMediaSeeking *iface, const GUID *format)
 {
-    FIXME("iface %p, format %s, stub!\n", iface, debugstr_guid(format));
+    TRACE("iface %p, format %s.\n", iface, debugstr_guid(format));
 
-    return E_NOTIMPL;
+    if (!format)
+        return E_POINTER;
+    /* Only reference time is supported, which is also the only format in use. */
+    return IsEqualGUID(format, &TIME_FORMAT_MEDIA_TIME) ? S_OK : E_INVALIDARG;
 }
 
 static HRESULT WINAPI filter_seeking_GetDuration(IMediaSeeking *iface, LONGLONG *duration)
@@ -985,18 +1040,40 @@ static HRESULT WINAPI filter_seeking_GetStopPosition(IMediaSeeking *iface, LONGL
 
 static HRESULT WINAPI filter_seeking_GetCurrentPosition(IMediaSeeking *iface, LONGLONG *current)
 {
-    FIXME("iface %p, current %p, stub!\n", iface, current);
+    struct filter *filter = impl_from_IMediaSeeking(iface);
+    IMediaSeeking *seeking;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, current %p.\n", iface, current);
+
+    if (!current)
+        return E_POINTER;
+
+    if (!(seeking = get_filter_seeking(filter)))
+        return E_NOTIMPL;
+
+    hr = IMediaSeeking_GetCurrentPosition(seeking, current);
+    IMediaSeeking_Release(seeking);
+
+    return hr;
 }
 
 static HRESULT WINAPI filter_seeking_ConvertTimeFormat(IMediaSeeking *iface, LONGLONG *target,
         const GUID *target_format, LONGLONG source, const GUID *source_format)
 {
-    FIXME("iface %p, target %p, target_format %s, source 0x%s, source_format %s, stub!\n", iface, target, debugstr_guid(target_format),
-            wine_dbgstr_longlong(source), debugstr_guid(source_format));
+    TRACE("iface %p, target %p, target_format %s, source %s, source_format %s.\n", iface, target,
+            debugstr_guid(target_format), wine_dbgstr_longlong(source), debugstr_guid(source_format));
 
-    return E_NOTIMPL;
+    if (!target)
+        return E_POINTER;
+
+    /* A NULL format means the current format, which is always reference time. */
+    if ((target_format && !IsEqualGUID(target_format, &TIME_FORMAT_MEDIA_TIME))
+            || (source_format && !IsEqualGUID(source_format, &TIME_FORMAT_MEDIA_TIME)))
+        return E_INVALIDARG;
+
+    *target = source;
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_SetPositions(IMediaSeeking *iface, LONGLONG *current_ptr, DWORD current_flags,
@@ -1028,37 +1105,73 @@ static HRESULT WINAPI filter_seeking_SetPositions(IMediaSeeking *iface, LONGLONG
 
 static HRESULT WINAPI filter_seeking_GetPositions(IMediaSeeking *iface, LONGLONG *current, LONGLONG *stop)
 {
-    FIXME("iface %p, current %p, stop %p, stub!\n", iface, current, stop);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, current %p, stop %p.\n", iface, current, stop);
+
+    if (current && FAILED(hr = filter_seeking_GetCurrentPosition(iface, current)))
+        return hr;
+    if (stop && FAILED(hr = filter_seeking_GetStopPosition(iface, stop)))
+        return hr;
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_GetAvailable(IMediaSeeking *iface, LONGLONG *earliest, LONGLONG *latest)
 {
-    FIXME("iface %p, earliest %p, latest %p, stub!\n", iface, earliest, latest);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, earliest %p, latest %p.\n", iface, earliest, latest);
+
+    /* Everything between the start and the duration of the stream is available. */
+    if (latest && FAILED(hr = filter_seeking_GetDuration(iface, latest)))
+        return hr;
+#ifdef SG_MUTANT_AM_AVAILABLE
+    if (latest) *latest = 0;
+#endif
+    if (earliest) *earliest = 0;
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_SetRate(IMediaSeeking *iface, double rate)
 {
-    FIXME("iface %p, rate %f, stub!\n", iface, rate);
+    struct filter *filter = impl_from_IMediaSeeking(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, rate %f.\n", iface, rate);
+
+#ifndef SG_MUTANT_AM_RATE
+    if (rate <= 0.0)
+        return E_INVALIDARG;
+#endif
+
+    EnterCriticalSection(&filter->cs);
+    filter->rate = rate;
+    LeaveCriticalSection(&filter->cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_GetRate(IMediaSeeking *iface, double *rate)
 {
-    FIXME("iface %p, rate %p, stub!\n", iface, rate);
+    struct filter *filter = impl_from_IMediaSeeking(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, rate %p.\n", iface, rate);
+
+    if (!rate)
+        return E_POINTER;
+
+    EnterCriticalSection(&filter->cs);
+    *rate = filter->rate;
+    LeaveCriticalSection(&filter->cs);
+    return S_OK;
 }
 
 static HRESULT WINAPI filter_seeking_GetPreroll(IMediaSeeking *iface, LONGLONG *preroll)
 {
-    FIXME("iface %p, preroll %p, stub!\n", iface, preroll);
+    TRACE("iface %p, preroll %p.\n", iface, preroll);
 
-    return E_NOTIMPL;
+    if (!preroll)
+        return E_POINTER;
+    *preroll = 0;
+    return S_OK;
 }
 
 static const IMediaSeekingVtbl filter_seeking_vtbl =
@@ -1097,6 +1210,8 @@ HRESULT filter_create(IUnknown *outer, void **out)
     if (!(object = calloc(1, sizeof(*object))))
         return E_OUTOFMEMORY;
 
+    object->rate = 1.0;
+
     object->IMediaStreamFilter_iface.lpVtbl = &filter_vtbl;
     object->IMediaSeeking_iface.lpVtbl = &filter_seeking_vtbl;
     object->refcount = 1;
