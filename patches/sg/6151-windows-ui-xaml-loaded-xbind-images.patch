+/*
+ * An image source holds premultiplied BGRA pixels: a SoftwareBitmapSource takes them from a
+ * SoftwareBitmap (Bgra8, premultiplied, as the documentation requires) through its WIC bitmap
+ * (ISoftwareBitmapNative), a BitmapImage decodes its UriSource (an ms-appx:/// file of the
+ * application, or a file path) with WIC.  An Image draws its Source scaled by its Stretch (Uniform
+ * by default), its natural size the source's pixels.
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#define WIDL_using_Windows_Foundation
+#include "private.h"
+#include "wincodec.h"
+#include "windows.foundation.h"
+
+HRESULT WINAPI WICCreateImagingFactory_Proxy( UINT version, IWICImagingFactory **factory );
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+enum { STRETCH_NONE = 0, STRETCH_FILL = 1, STRETCH_UNIFORM = 2, STRETCH_UNIFORM_TO_FILL = 3 };
+
+static const GUID IID_ISoftwareBitmapNative_x = { 0x94bc8415, 0x04ea, 0x4b2e, { 0xaf, 0x13, 0x4d, 0xe9, 0x5a, 0xa8, 0x98, 0xeb } };
+static const GUID IID_IAsyncAction_x = { 0x5a648006, 0x843a, 0x4da9, { 0x86, 0x5b, 0x9d, 0x26, 0xe5, 0xdf, 0xad, 0x7b } };
+static const GUID IID_IClosable_x = { 0x30d5a829, 0x7fa4, 0x4026, { 0x83, 0xbb, 0xd7, 0x5b, 0xae, 0x4e, 0xa9, 0x9e } };
+static const GUID IID_IAsyncInfo_x = { 0x00000036, 0x0000, 0x0000, { 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };
+
+static struct xaml_property *prop_image_source, *prop_image_stretch, *prop_image_nine_grid, *prop_uri_source,
+                            *prop_decode_width, *prop_decode_height;
+
+static void imaging_init(void);
+
+/* ---- a completed IAsyncAction ---- */
+
+struct action
+{
+    IAsyncAction IAsyncAction_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    HRESULT result;
+    IAsyncActionCompletedHandler *handler;
+};
+
+static struct action *action_from_IAsyncAction( IAsyncAction *iface ) { return CONTAINING_RECORD( iface, struct action, IAsyncAction_iface ); }
+static struct action *action_from_IAsyncInfo( IAsyncInfo *iface ) { return CONTAINING_RECORD( iface, struct action, IAsyncInfo_iface ); }
+
+static HRESULT WINAPI action_QueryInterface( IAsyncAction *iface, REFIID iid, void **out )
+{
+    struct action *action = action_from_IAsyncAction( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncAction_x ))
+        *out = &action->IAsyncAction_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo_x )) *out = &action->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI action_AddRef( IAsyncAction *iface ) { return InterlockedIncrement( &action_from_IAsyncAction( iface )->ref ); }
+
+static ULONG WINAPI action_Release( IAsyncAction *iface )
+{
+    struct action *action = action_from_IAsyncAction( iface );
+    ULONG ref = InterlockedDecrement( &action->ref );
+
+    if (!ref)
+    {
+        if (action->handler) IAsyncActionCompletedHandler_Release( action->handler );
+        free( action );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI action_GetIids( IAsyncAction *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI action_GetRuntimeClassName( IAsyncAction *iface, HSTRING *name )
+{
+    return xaml_hstring( L"Windows.Foundation.IAsyncAction", name );
+}
+
+static HRESULT WINAPI action_GetTrustLevel( IAsyncAction *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+/* it completed already: a handler is called at once */
+static HRESULT WINAPI action_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct action *action = action_from_IAsyncAction( iface );
+
+    if (!handler) return E_POINTER;
+    if (action->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    IAsyncActionCompletedHandler_AddRef( (action->handler = handler) );
+    return IAsyncActionCompletedHandler_Invoke( handler, iface, SUCCEEDED(action->result) ? Completed : Error );
+}
+
+static HRESULT WINAPI action_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct action *action = action_from_IAsyncAction( iface );
+
+    if (!handler) return E_POINTER;
+    if ((*handler = action->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI action_GetResults( IAsyncAction *iface ) { return action_from_IAsyncAction( iface )->result; }
+
+static const struct IAsyncActionVtbl action_vtbl =
+{
+    action_QueryInterface, action_AddRef, action_Release, action_GetIids, action_GetRuntimeClassName,
+    action_GetTrustLevel, action_put_Completed, action_get_Completed, action_GetResults,
+};
+
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{ return action_QueryInterface( &action_from_IAsyncInfo( iface )->IAsyncAction_iface, iid, out ); }
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface ) { return action_AddRef( &action_from_IAsyncInfo( iface )->IAsyncAction_iface ); }
+static ULONG WINAPI info_Release( IAsyncInfo *iface ) { return action_Release( &action_from_IAsyncInfo( iface )->IAsyncAction_iface ); }
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )
+{ return action_GetRuntimeClassName( &action_from_IAsyncInfo( iface )->IAsyncAction_iface, name ); }
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id ) { *id = 1; return S_OK; }
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    *status = SUCCEEDED(action_from_IAsyncInfo( iface )->result) ? Completed : Error;
+    return S_OK;
+}
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *code ) { *code = action_from_IAsyncInfo( iface )->result; return S_OK; }
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface ) { return S_OK; }
+static HRESULT WINAPI info_Close( IAsyncInfo *iface ) { return S_OK; }
+
+static const struct IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release, info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+static HRESULT completed_action( HRESULT result, IInspectable **out )
+{
+    struct action *action;
+
+    if (!(action = calloc( 1, sizeof(*action) ))) return E_OUTOFMEMORY;
+    action->IAsyncAction_iface.lpVtbl = &action_vtbl;
+    action->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    action->ref = 1;
+    action->result = result;
+    *out = (IInspectable *)&action->IAsyncAction_iface;
+    return S_OK;
+}
+
+/* ---- image sources ---- */
+
+struct image_source
+{
+    struct dobj d;
+    struct xiface IImageSource_iface, IBitmapSource_iface, IKind_iface;   /* ISoftwareBitmapSource or IBitmapImage */
+    struct xiface IClosable_iface;
+    UINT width, height;
+    BYTE *pixels;                   /* premultiplied BGRA, width * 4 per row */
+    struct handler_list opened, failed;
+    BOOL bitmap_image;
+};
+
+static struct image_source *source_from_iface( struct xiface *iface )
+{
+    return CONTAINING_RECORD( iface->obj, struct image_source, d.obj );
+}
+
+/* a WIC source's pixels, premultiplied BGRA */
+static HRESULT take_pixels( struct image_source *source, IWICBitmapSource *wic )
+{
+    IWICBitmapSource *converted = NULL;
+    UINT width, height;
+    BYTE *pixels;
+    HRESULT hr;
+
+    if (FAILED(hr = WICConvertBitmapSource( &GUID_WICPixelFormat32bppPBGRA, wic, &converted ))) return hr;
+    if (FAILED(hr = IWICBitmapSource_GetSize( converted, &width, &height ))) goto done;
+    if (!width || !height || width > 16384 || height > 16384) { hr = E_INVALIDARG; goto done; }
+    if (!(pixels = malloc( (size_t)width * height * 4 ))) { hr = E_OUTOFMEMORY; goto done; }
+    if (FAILED(hr = IWICBitmapSource_CopyPixels( converted, NULL, width * 4, width * height * 4, pixels )))
+    {
+        free( pixels );
+        goto done;
+    }
+    free( source->pixels );
+    source->pixels = pixels;
+    source->width = width;
+    source->height = height;
+    xaml_invalidate_visuals();
+done:
+    IWICBitmapSource_Release( converted );
+    return hr;
+}
+
+/* an image source's pixels (no copy), or FALSE */
+BOOL xaml_image_pixels( IInspectable *obj, UINT *width, UINT *height, const BYTE **pixels );
+
+static const struct xclass software_source_class, bitmap_image_class;
+
+static struct image_source *source_from_inspectable( IInspectable *obj )
+{
+    struct dobj *d = dobj_from_inspectable( obj );
+
+    if (!d || (d->obj.cls != &software_source_class && d->obj.cls != &bitmap_image_class)) return NULL;
+    return CONTAINING_RECORD( d, struct image_source, d );
+}
+
+BOOL xaml_image_pixels( IInspectable *obj, UINT *width, UINT *height, const BYTE **pixels )
+{
+    struct image_source *source = obj ? source_from_inspectable( obj ) : NULL;
+
+    if (!source || !source->pixels) return FALSE;
+    *width = source->width;
+    *height = source->height;
+    *pixels = source->pixels;
+    return TRUE;
+}
+
+static HRESULT WINAPI bitmap_source_get_PixelWidth( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = source_from_iface( iface )->width;
+    return S_OK;
+}
+
+static HRESULT WINAPI bitmap_source_get_PixelHeight( struct xiface *iface, INT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = source_from_iface( iface )->height;
+    return S_OK;
+}
+
+static const void *image_source_vtbl[] = { IImageSource_STUBS };
