+/* SoftwareBitmapSource.SetBitmapAsync: the bitmap's pixels (Bgra8, premultiplied), or none */
+static HRESULT WINAPI software_source_SetBitmapAsync( struct xiface *iface, IInspectable *bitmap, IInspectable **action )
+{
+    struct image_source *source = source_from_iface( iface );
+    IUnknown *native = NULL;
+    IWICBitmap *wic = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE( "%p, %p\n", source, bitmap );
+    if (!action) return E_POINTER;
+    *action = NULL;
+    if (!bitmap)
+    {
+        free( source->pixels );
+        source->pixels = NULL;
+        source->width = source->height = 0;
+        xaml_invalidate_visuals();
+    }
+    else if (FAILED(hr = IInspectable_QueryInterface( bitmap, &IID_ISoftwareBitmapNative_x, (void **)&native )))
+        WARN( "not a software bitmap we can read: %#lx\n", hr );
+    else
+    {
+        hr = ((HRESULT (WINAPI *)( IUnknown *, REFIID, void ** ))((void **)native->lpVtbl)[6])( native, &IID_IWICBitmap, (void **)&wic );
+        IUnknown_Release( native );
+#ifdef SG_MUTANT_IMAGE_NO_PIXELS
+        if (wic) IWICBitmap_Release( wic );
+        wic = NULL;
+#endif
+        if (wic)
+        {
+            hr = take_pixels( source, (IWICBitmapSource *)wic );
+            IWICBitmap_Release( wic );
+        }
+    }
+    if (FAILED(hr)) return hr;
+    return completed_action( hr, action );
+}
