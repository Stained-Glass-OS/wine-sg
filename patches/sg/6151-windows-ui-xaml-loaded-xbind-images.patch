+static BOOL image_source_size( struct uielem *elem, UINT *width, UINT *height, const BYTE **pixels )
+{
+    IInspectable *source = NULL;
+    BOOL ret;
+
+    dobj_get_value( &elem->d, prop_image_source, &source );
+    ret = xaml_image_pixels( source, width, height, pixels );
+    if (source) IInspectable_Release( source );
+    return ret;
+}
+
+/* the size the source takes in a space by the stretch */
+static struct xsize stretched( INT32 stretch, UINT width, UINT height, struct xsize space )
+{
+    struct xsize size = { width, height };
+    DOUBLE sx = space.width / width, sy = space.height / height, scale;
+
+    if (stretch == STRETCH_NONE) return size;
+    if (isinf( sx ) && isinf( sy )) return size;
+    if (stretch == STRETCH_FILL)
+    {
+        size.width = isinf( sx ) ? width * sy : space.width;
+        size.height = isinf( sy ) ? height * sx : space.height;
+        return size;
+    }
+    if (isinf( sx )) scale = sy;
+    else if (isinf( sy )) scale = sx;
+    else scale = stretch == STRETCH_UNIFORM ? fmin( sx, sy ) : fmax( sx, sy );
+    size.width = width * scale;
+    size.height = height * scale;
+    return size;
+}
+
+static void image_measure( struct uielem *elem, struct xsize available, struct xsize *desired )
+{
+    const BYTE *pixels;
+    UINT width, height;
+
+    desired->width = desired->height = 0;
+    if (!image_source_size( elem, &width, &height, &pixels )) return;
+    *desired = stretched( image_stretch( elem ), width, height, available );
+    if (!isinf( available.width )) desired->width = fmin( desired->width, available.width );
+    if (!isinf( available.height )) desired->height = fmin( desired->height, available.height );
+}
+
+static void image_arrange( struct uielem *elem, struct xsize final, struct xsize *used )
+{
+    /* all of its space: the source is centred in it */
+    *used = final;
+}
+
+static void image_render( struct uielem *elem, struct xdraw *draw )
+{
+    const BYTE *pixels;
+    UINT width, height;
+    struct xsize space = elem->render, size;
+    struct xrect rect;
+
+    if (!image_source_size( elem, &width, &height, &pixels )) return;
+    size = stretched( image_stretch( elem ), width, height, space );
+    /* centred in its space (UniformToFill overflows it evenly) */
+    rect.x = (space.width - size.width) / 2;
+    rect.y = (space.height - size.height) / 2;
+    rect.width = size.width;
+    rect.height = size.height;
+    xdraw_bitmap( draw, &rect, pixels, width, height );
+}
