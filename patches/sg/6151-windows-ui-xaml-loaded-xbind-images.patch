+/*
+ * Code an application's XAML compiler generated for x:Bind sets a member through these: the value
+ * boxed and set as the dependency property's local value; the binding object of a template's
+ * scope is kept on its element (DataTemplateComponent, an attached property); ConvertValue turns
+ * text into a member's type as markup would.
+ */
+
+#include <stdlib.h>
+#define WIDL_using_Windows_Foundation
+#include "private.h"
+#include "windows.foundation.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+static const GUID IID_IPropertyValue_x = { 0x4bd682dd, 0x7554, 0x40e9, { 0x9a, 0x9b, 0x82, 0x65, 0x4e, 0xde, 0x7e, 0x62 } };
+
+static struct xaml_property *prop_template_component;
+
+static BOOL WINAPI init_helper( INIT_ONCE *once, void *param, void **context )
+{
+    xaml_elements_init();
+    prop_template_component = xaml_property_register( L"Windows.UI.Xaml.Markup.XamlBindingHelper", L"DataTemplateComponent",
+                                                      L"Object", NULL, TRUE, NULL );
+    return TRUE;
+}
+
+static void helper_init(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce( &once, init_helper, NULL, NULL );
+}
+
+static IPropertyValueStatics *statics(void)
+{
+    return xaml_pv_statics();
+}
+
+/* a boxed value set on an object's dependency property */
+static HRESULT set_boxed( IInspectable *target, IInspectable *dp, IInspectable *box, BOOL boxed )
+{
+    struct dobj *obj = dobj_from_inspectable( target );
+    struct xaml_property *prop = xaml_property_from_inspectable( dp );
+    HRESULT hr;
+
+#ifdef SG_MUTANT_XAML_BIND_NO_SET
+    if (box && boxed) IInspectable_Release( box );
+    return S_OK;
+#endif
+    TRACE( "%p, %p (%s), %p\n", target, dp, prop ? debugstr_w( prop->name ) : "?", box );
+    if (!obj || !prop)
+    {
+        if (box && boxed) IInspectable_Release( box );
+        return E_INVALIDARG;
+    }
+    hr = dobj_set_value( obj, prop, box );
+    if (box && boxed) IInspectable_Release( box );
+    return hr;
+}
+
+static HRESULT WINAPI helper_DataTemplateComponentProperty( struct xfiface *iface, IInspectable **value )
+{
+    helper_init();
+    if (!value) return E_POINTER;
+    IInspectable_AddRef( (*value = xaml_property_iface( prop_template_component )) );
+    return S_OK;
+}
+
+static HRESULT WINAPI helper_GetDataTemplateComponent( struct xfiface *iface, IInspectable *element, IInspectable **value )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+
+    helper_init();
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!obj) return E_INVALIDARG;
+    return dobj_get_value( obj, prop_template_component, value );
+}
+
+static HRESULT WINAPI helper_SetDataTemplateComponent( struct xfiface *iface, IInspectable *element, IInspectable *value )
+{
+    struct dobj *obj = dobj_from_inspectable( element );
+
+    helper_init();
+    if (!obj) return E_INVALIDARG;
+    return dobj_set_value( obj, prop_template_component, value );
+}
+
+static HRESULT WINAPI helper_SuspendRendering( struct xfiface *iface, IInspectable *target )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI helper_ResumeRendering( struct xfiface *iface, IInspectable *target )
+{
+    return S_OK;
+}
+
+/* a value converted to a type: text as markup reads it, anything else as it is */
+static HRESULT WINAPI helper_ConvertValue( struct xfiface *iface, struct xaml_type_name type, IInspectable *value, IInspectable **out )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( type.Name, NULL );
+    IPropertyValue *pv;
+    PropertyType kind;
+    HSTRING str;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!value) return S_OK;
+    if (SUCCEEDED(IInspectable_QueryInterface( value, &IID_IPropertyValue_x, (void **)&pv )))
+    {
+        if (SUCCEEDED(IPropertyValue_get_Type( pv, &kind )) && kind == PropertyType_String &&
+            SUCCEEDED(IPropertyValue_GetString( pv, &str )))
+        {
+            hr = xaml_value_from_string( name, WindowsGetStringRawBuffer( str, NULL ), out );
+            if (FAILED(hr)) WARN( "%s not converted to %s\n", debugstr_hstring( str ), debugstr_w( name ) );
+            WindowsDeleteString( str );
+            IPropertyValue_Release( pv );
+            return hr;
+        }
+        IPropertyValue_Release( pv );
+    }
+    IInspectable_AddRef( (*out = value) );
+    return S_OK;
+}
+
+static HRESULT WINAPI helper_SetPropertyFromString( struct xfiface *iface, IInspectable *target, IInspectable *dp, HSTRING value )
+{
+    IInspectable *box = NULL;
+    if (statics()) IPropertyValueStatics_CreateString( statics(), value, &box );
+    return set_boxed( target, dp, box, TRUE );
+}
+
+#define SET_FROM(name, type, create) \
+static HRESULT WINAPI helper_SetPropertyFrom##name( struct xfiface *iface, IInspectable *target, IInspectable *dp, type value ) \
+{ \
+    IInspectable *box = NULL; \
+    if (statics()) IPropertyValueStatics_##create( statics(), value, &box ); \
+    if (!box) return E_OUTOFMEMORY; \
+    return set_boxed( target, dp, box, TRUE ); \
+}
+
+SET_FROM(Boolean, boolean, CreateBoolean)
+SET_FROM(Char16, WCHAR, CreateChar16)
+SET_FROM(DateTime, DateTime, CreateDateTime)
+SET_FROM(Double, DOUBLE, CreateDouble)
+SET_FROM(Int32, INT32, CreateInt32)
+SET_FROM(UInt32, UINT32, CreateUInt32)
+SET_FROM(Int64, INT64, CreateInt64)
+SET_FROM(UInt64, UINT64, CreateUInt64)
+SET_FROM(Single, FLOAT, CreateSingle)
+SET_FROM(Point, Point, CreatePoint)
+SET_FROM(Rect, Rect, CreateRect)
+SET_FROM(Size, Size, CreateSize)
+SET_FROM(TimeSpan, TimeSpan, CreateTimeSpan)
+SET_FROM(Byte, BYTE, CreateUInt8)
+
+static HRESULT WINAPI helper_SetPropertyFromUri( struct xfiface *iface, IInspectable *target, IInspectable *dp, IInspectable *value )
+{
+    return set_boxed( target, dp, value, FALSE );
+}
+
+static HRESULT WINAPI helper_SetPropertyFromObject( struct xfiface *iface, IInspectable *target, IInspectable *dp, IInspectable *value )
+{
+    return set_boxed( target, dp, value, FALSE );
+}
+
+static const void *helper_statics_vtbl[] =
+{
+    IXamlBindingHelperStatics_FSTUBS,
+    [IXamlBindingHelperStatics_DataTemplateComponentProperty] = helper_DataTemplateComponentProperty,
+    [IXamlBindingHelperStatics_GetDataTemplateComponent] = helper_GetDataTemplateComponent,
+    [IXamlBindingHelperStatics_SetDataTemplateComponent] = helper_SetDataTemplateComponent,
+    [IXamlBindingHelperStatics_SuspendRendering] = helper_SuspendRendering,
+    [IXamlBindingHelperStatics_ResumeRendering] = helper_ResumeRendering,
+    [IXamlBindingHelperStatics_ConvertValue] = helper_ConvertValue,
+    [IXamlBindingHelperStatics_SetPropertyFromString] = helper_SetPropertyFromString,
+    [IXamlBindingHelperStatics_SetPropertyFromBoolean] = helper_SetPropertyFromBoolean,
+    [IXamlBindingHelperStatics_SetPropertyFromChar16] = helper_SetPropertyFromChar16,
+    [IXamlBindingHelperStatics_SetPropertyFromDateTime] = helper_SetPropertyFromDateTime,
+    [IXamlBindingHelperStatics_SetPropertyFromDouble] = helper_SetPropertyFromDouble,
+    [IXamlBindingHelperStatics_SetPropertyFromInt32] = helper_SetPropertyFromInt32,
+    [IXamlBindingHelperStatics_SetPropertyFromUInt32] = helper_SetPropertyFromUInt32,
+    [IXamlBindingHelperStatics_SetPropertyFromInt64] = helper_SetPropertyFromInt64,
+    [IXamlBindingHelperStatics_SetPropertyFromUInt64] = helper_SetPropertyFromUInt64,
+    [IXamlBindingHelperStatics_SetPropertyFromSingle] = helper_SetPropertyFromSingle,
+    [IXamlBindingHelperStatics_SetPropertyFromPoint] = helper_SetPropertyFromPoint,
+    [IXamlBindingHelperStatics_SetPropertyFromRect] = helper_SetPropertyFromRect,
+    [IXamlBindingHelperStatics_SetPropertyFromSize] = helper_SetPropertyFromSize,
+    [IXamlBindingHelperStatics_SetPropertyFromTimeSpan] = helper_SetPropertyFromTimeSpan,
+    [IXamlBindingHelperStatics_SetPropertyFromByte] = helper_SetPropertyFromByte,
+    [IXamlBindingHelperStatics_SetPropertyFromUri] = helper_SetPropertyFromUri,
+    [IXamlBindingHelperStatics_SetPropertyFromObject] = helper_SetPropertyFromObject,
+};
+
+static struct xfactory helper_factory_obj =
+{
+    { &xfactory_vtbl },
+    L"Windows.UI.Xaml.Markup.XamlBindingHelper",
+    { &IID_IXamlBindingHelperStatics },
+    { { helper_statics_vtbl } },
+};
+
+IActivationFactory *xaml_binding_helper_factory = &helper_factory_obj.IActivationFactory_iface;
