+/* ---- Loading, Loaded, Unloaded: an element enters or leaves a live tree (an island's content) ---- */
+
+/* an element and its children, each with a reference, in tree order (pre-order) */
+static struct uielem **subtree( struct uielem *root, unsigned int *count )
+{
+    struct uielem **items = NULL, **tmp, *child;
+    unsigned int n = 0, size = 0, i = 0;
+
+    if (!(items = malloc( 16 * sizeof(*items) ))) return NULL;
+    size = 16;
+    IUnknown_AddRef( root->d.obj.outer );
+    items[n++] = root;
+    for (i = 0; i < n; i++)
+    {
+        LIST_FOR_EACH_ENTRY( child, &items[i]->children, struct uielem, entry )
+        {
+            if (n == size)
+            {
+                if (!(tmp = realloc( items, size * 2 * sizeof(*items) ))) goto done;
+                items = tmp;
+                size *= 2;
+            }
+            IUnknown_AddRef( child->d.obj.outer );
+            items[n++] = child;
+        }
+    }
+done:
+    *count = n;
+    return items;
+}
+
+static void release_subtree( struct uielem **items, unsigned int count )
+{
+    while (count--) IUnknown_Release( items[count]->d.obj.outer );
+    free( items );
+}
+
+static IInspectable *sender_of( struct uielem *elem )
+{
+    IInspectable *sender = NULL;
+    IUnknown_QueryInterface( elem->d.obj.outer, &IID_IInspectable, (void **)&sender );
+    return sender;
+}
+
+/* Loading: before an element is first laid out in a live tree */
+void xaml_raise_loading( struct uielem *root )
+{
+    unsigned int i, count;
+    struct uielem **items;
+
+#ifdef SG_MUTANT_XAML_NO_LOADED
+    return;
+#endif
+    if (!(items = subtree( root, &count ))) return;
+    for (i = 0; i < count; i++)
+    {
+        IInspectable *sender;
+        if (items[i]->loading_raised) continue;
+        items[i]->loading_raised = TRUE;
+        if (list_empty( &items[i]->loading.entries ) || !(sender = sender_of( items[i] ))) continue;
+        TRACE( "%p: Loading\n", items[i] );
+        xaml_raise_routed( &items[i]->loading, sender, NULL );
+        TRACE( "%p: Loading done\n", items[i] );
+        IInspectable_Release( sender );
+    }
+    release_subtree( items, count );
+}
+
+/* Loaded: after it is laid out (children before their parent) */
+void xaml_raise_loaded( struct uielem *root )
+{
+    unsigned int i, count;
+    struct uielem **items;
+
+#ifdef SG_MUTANT_XAML_NO_LOADED
+    return;
+#endif
+    if (!(items = subtree( root, &count ))) return;
+    for (i = count; i > 0; i--)
+    {
+        struct uielem *elem = items[i - 1];
+        IInspectable *sender, *args;
+        if (elem->is_loaded) continue;
+        elem->is_loaded = TRUE;
+        if (list_empty( &elem->loaded.entries ) || !(sender = sender_of( elem ))) continue;
+        if ((args = xaml_routed_args( sender )))
+        {
+            TRACE( "%p: Loaded\n", elem );
+            xaml_raise_routed( &elem->loaded, sender, args );
+            TRACE( "%p: Loaded done\n", elem );
+            IInspectable_Release( args );
+        }
+        IInspectable_Release( sender );
+    }
+    release_subtree( items, count );
+}
+
+/* Unloaded: it left the live tree */
+static void raise_unloaded( struct uielem *root )
+{
+    unsigned int i, count;
+    struct uielem **items;
+
+    if (!root->is_loaded && !root->loading_raised) return;
+    if (!(items = subtree( root, &count ))) return;
+    for (i = 0; i < count; i++)
+    {
+        struct uielem *elem = items[i];
+        IInspectable *sender, *args;
+        BOOL was_loaded = elem->is_loaded;
+        elem->is_loaded = elem->loading_raised = FALSE;
+        if (!was_loaded || list_empty( &elem->unloaded.entries ) || !(sender = sender_of( elem ))) continue;
+        if ((args = xaml_routed_args( sender )))
+        {
+            xaml_raise_routed( &elem->unloaded, sender, args );
+            IInspectable_Release( args );
+        }
+        IInspectable_Release( sender );
+    }
+    release_subtree( items, count );
+}
+
 void uielem_remove_child( struct uielem *parent, struct uielem *child )
 {
     if (child->parent != parent) return;
+    raise_unloaded( child );
     list_remove( &child->entry );
     child->parent = NULL;
     uielem_invalidate_measure( parent );
