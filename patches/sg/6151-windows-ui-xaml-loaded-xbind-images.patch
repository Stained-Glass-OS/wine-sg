+/* BitmapImage: its UriSource decoded */
+static void load_uri( struct image_source *source, IInspectable *uri )
+{
+    IWICImagingFactory *factory = NULL;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    WCHAR *str, *path = NULL;
+    HRESULT hr = E_FAIL;
+
+    if (!uri || !(str = xaml_uri_string( uri ))) return;
+    if (!wcsnicmp( str, L"ms-appx:///", 11 )) path = xaml_app_path( str + 11 );
+    else if (!wcsnicmp( str, L"file:///", 8 )) path = wcsdup( str + 8 );
+    else FIXME( "%s: not a file of the application\n", debugstr_w( str ) );
+    free( str );
+    if (path && SUCCEEDED(hr = WICCreateImagingFactory_Proxy( WINCODEC_SDK_VERSION, &factory )))
+    {
+        if (SUCCEEDED(hr = IWICImagingFactory_CreateDecoderFromFilename( factory, path, NULL, GENERIC_READ,
+                                                                         WICDecodeMetadataCacheOnDemand, &decoder )))
+        {
+            if (SUCCEEDED(hr = IWICBitmapDecoder_GetFrame( decoder, 0, &frame )))
+            {
+                hr = take_pixels( source, (IWICBitmapSource *)frame );
+                IWICBitmapFrameDecode_Release( frame );
+            }
+            IWICBitmapDecoder_Release( decoder );
+        }
+        IWICImagingFactory_Release( factory );
+    }
+    if (FAILED(hr)) WARN( "%s not decoded: %#lx\n", debugstr_w( path ), hr );
+    free( path );
+}
