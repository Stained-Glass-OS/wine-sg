 static HRESULT WINAPI d3d9_device_WaitForVBlank(IDirect3DDevice9Ex *iface, UINT swapchain_idx)
 {
-    FIXME("iface %p, swapchain_idx %u stub!\n", iface, swapchain_idx);
+    struct d3d9_device *device = impl_from_IDirect3DDevice9Ex(iface);
+    struct wined3d_swapchain_desc desc;
+    LARGE_INTEGER freq, now;
+    unsigned int rate;
+    UINT64 period;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, swapchain_idx %u.\n", iface, swapchain_idx);
+
+    if (swapchain_idx >= device->implicit_swapchain_count)
+        return D3DERR_INVALIDCALL;
+
+    wined3d_mutex_lock();
+    wined3d_swapchain_get_desc(device->implicit_swapchains[swapchain_idx], &desc);
+    wined3d_mutex_unlock();
+    rate = desc.refresh_rate ? desc.refresh_rate : 60;
+
+    /* returns when the next refresh period begins */
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&now);
+    period = freq.QuadPart / rate;
+    if (period)
+        Sleep((DWORD)(((period - now.QuadPart % period) * 1000 + freq.QuadPart - 1) / freq.QuadPart));
+
+    return D3D_OK;
 }
 
 static HRESULT WINAPI d3d9_device_CheckResourceResidency(IDirect3DDevice9Ex *iface,
         IDirect3DResource9 **resources, UINT32 resource_count)
 {
-    FIXME("iface %p, resources %p, resource_count %u stub!\n",
-            iface, resources, resource_count);
+    TRACE("iface %p, resources %p, resource_count %u.\n", iface, resources, resource_count);
 
-    return E_NOTIMPL;
+    if (!resources || !resource_count)
+        return D3DERR_INVALIDCALL;
+
+    /* all resources live in memory the driver can always reach */
+    return S_OK;
 }
 
