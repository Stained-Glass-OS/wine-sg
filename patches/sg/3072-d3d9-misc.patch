 static HRESULT WINAPI d3d9_device_SetConvolutionMonoKernel(IDirect3DDevice9Ex *iface,
         UINT width, UINT height, float *rows, float *columns)
 {
-    FIXME("iface %p, width %u, height %u, rows %p, columns %p stub!\n",
-            iface, width, height, rows, columns);
+    struct d3d9_device *device = impl_from_IDirect3DDevice9Ex(iface);
+    float *new_rows = NULL, *new_columns = NULL;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, width %u, height %u, rows %p, columns %p.\n", iface, width, height, rows, columns);
+
+    /* a kernel is at most 7 taps in each direction, given as a row and a column vector */
+    if (!width || !height || width > 7 || height > 7 || !rows || !columns)
+        return D3DERR_INVALIDCALL;
+
+    /* kept for the convolution filter of StretchRect, which is not applied here */
+    if (!(new_rows = malloc(width * sizeof(*new_rows))) || !(new_columns = malloc(height * sizeof(*new_columns))))
+    {
+        free(new_rows);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(new_rows, rows, width * sizeof(*new_rows));
+    memcpy(new_columns, columns, height * sizeof(*new_columns));
+    wined3d_mutex_lock();
+    free(device->kernel_rows);
+    free(device->kernel_columns);
+    device->kernel_rows = new_rows;
+    device->kernel_columns = new_columns;
+    device->kernel_width = width;
+    device->kernel_height = height;
+    wined3d_mutex_unlock();
+
+    return D3D_OK;
 }
 
