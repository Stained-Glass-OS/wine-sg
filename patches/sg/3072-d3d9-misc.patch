+    {
+        WARN("Invalid usage %#lx.\n", usage);
+        return D3DERR_INVALIDCALL;
+    }
+
+    return d3d9_device_CreateOffscreenPlainSurface(iface, width, height, format, pool, surface, shared_handle);
 }
 
