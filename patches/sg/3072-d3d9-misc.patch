+        InterlockedIncrement(&swapchain->present_count);
+    return hr;
 }
 
 static HRESULT WINAPI d3d9_swapchain_GetFrontBufferData(IDirect3DSwapChain9Ex *iface, IDirect3DSurface9 *surface)
@@ -278,10 +282,13 @@ static HRESULT WINAPI d3d9_swapchain_GetPresentParameters(IDirect3DSwapChain9Ex
 static HRESULT WINAPI d3d9_swapchain_GetLastPresentCount(IDirect3DSwapChain9Ex *iface,
         UINT *last_present_count)
 {
-    FIXME("iface %p, last_present_count %p, stub!\n", iface, last_present_count);
+    struct d3d9_swapchain *swapchain = impl_from_IDirect3DSwapChain9Ex(iface);
 
-    if (last_present_count)
-        *last_present_count = 0;
+    TRACE("iface %p, last_present_count %p.\n", iface, last_present_count);
+
+    if (!last_present_count)
+        return D3DERR_INVALIDCALL;
+    *last_present_count = InterlockedCompareExchange(&swapchain->present_count, 0, 0);
 
     return D3D_OK;
 }
@@ -289,10 +296,28 @@ static HRESULT WINAPI d3d9_swapchain_GetLastPresentCount(IDirect3DSwapChain9Ex *
 static HRESULT WINAPI d3d9_swapchain_GetPresentStatistics(IDirect3DSwapChain9Ex *iface,
         D3DPRESENTSTATS *present_stats)
 {
-    FIXME("iface %p, present_stats %p, stub!\n", iface, present_stats);
+    struct d3d9_swapchain *swapchain = impl_from_IDirect3DSwapChain9Ex(iface);
+    struct wined3d_swapchain_desc desc;
+    LARGE_INTEGER freq, now;
+    unsigned int rate;
+
+    TRACE("iface %p, present_stats %p.\n", iface, present_stats);
+
+    if (!present_stats)
+        return D3DERR_INVALIDCALL;
 
-    if (present_stats)
-        memset(present_stats, 0, sizeof(*present_stats));
+    wined3d_mutex_lock();
+    wined3d_swapchain_get_desc(swapchain->wined3d_swapchain, &desc);
+    wined3d_mutex_unlock();
+    rate = desc.refresh_rate ? desc.refresh_rate : 60;
+
+    /* the refresh count is the time since the counter's origin in refresh periods */
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&now);
+    memset(present_stats, 0, sizeof(*present_stats));
+    present_stats->PresentCount = InterlockedCompareExchange(&swapchain->present_count, 0, 0);
+    present_stats->PresentRefreshCount = present_stats->SyncRefreshCount = now.QuadPart / (freq.QuadPart / rate);
+    present_stats->SyncQPCTime = now;
 
     return D3D_OK;
 }
