+/* IEnumConnections over a connection point's sinks, as they were */
+struct connections_list
+{
+    IEnumConnections IEnumConnections_iface;
+    LONG refs;
+    CONNECTDATA *data;
+    ULONG count, pos;
+};
+
+static inline struct connections_list *impl_from_IEnumConnections( IEnumConnections *iface )
+{
+    return CONTAINING_RECORD( iface, struct connections_list, IEnumConnections_iface );
+}
+
+static HRESULT WINAPI enum_connections_QueryInterface( IEnumConnections *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumConnections ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumConnections_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_connections_AddRef( IEnumConnections *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumConnections( iface )->refs );
+}
+
+static ULONG WINAPI enum_connections_Release( IEnumConnections *iface )
+{
+    struct connections_list *list = impl_from_IEnumConnections( iface );
+    ULONG refs = InterlockedDecrement( &list->refs ), i;
+
+    if (!refs)
+    {
+        for (i = 0; i < list->count; i++) IUnknown_Release( list->data[i].pUnk );
+        free( list->data );
+        free( list );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI enum_connections_Next( IEnumConnections *iface, ULONG count, CONNECTDATA *data, ULONG *fetched )
+{
+    struct connections_list *list = impl_from_IEnumConnections( iface );
+    ULONG i;
+
+    if (!data) return E_POINTER;
+    for (i = 0; i < count && list->pos < list->count; i++, list->pos++)
+    {
+        data[i] = list->data[list->pos];
+        IUnknown_AddRef( data[i].pUnk );
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_connections_Skip( IEnumConnections *iface, ULONG count )
+{
+    struct connections_list *list = impl_from_IEnumConnections( iface );
+
+    if (list->pos + count > list->count)
+    {
+        list->pos = list->count;
+        return S_FALSE;
+    }
+    list->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_connections_Reset( IEnumConnections *iface )
+{
+    impl_from_IEnumConnections( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_connections( const CONNECTDATA *data, ULONG count, ULONG pos, IEnumConnections **ret );
+
+static HRESULT WINAPI enum_connections_Clone( IEnumConnections *iface, IEnumConnections **ret )
+{
+    struct connections_list *list = impl_from_IEnumConnections( iface );
+    return create_enum_connections( list->data, list->count, list->pos, ret );
+}
+
+static const IEnumConnectionsVtbl enum_connections_vtbl =
+{
+    enum_connections_QueryInterface,
+    enum_connections_AddRef,
+    enum_connections_Release,
+    enum_connections_Next,
+    enum_connections_Skip,
+    enum_connections_Reset,
+    enum_connections_Clone
+};
+
+static HRESULT create_enum_connections( const CONNECTDATA *data, ULONG count, ULONG pos, IEnumConnections **ret )
+{
+    struct connections_list *list;
+    ULONG i;
+
+    if (!(list = calloc( 1, sizeof(*list) ))) return E_OUTOFMEMORY;
+    if (count && !(list->data = malloc( count * sizeof(*data) )))
+    {
+        free( list );
+        return E_OUTOFMEMORY;
+    }
+    list->IEnumConnections_iface.lpVtbl = &enum_connections_vtbl;
+    list->refs = 1;
+    list->count = count;
+    list->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        list->data[i] = data[i];
+        IUnknown_AddRef( data[i].pUnk );
+    }
+    *ret = &list->IEnumConnections_iface;
+    return S_OK;
+}
+
