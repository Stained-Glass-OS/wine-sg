+/* Stained Glass OS 1689: the dual interfaces' IDispatch, from the type library */
+static ITypeLib *netprofm_typelib;
+
+static HRESULT get_typeinfo( REFIID riid, ITypeInfo **info )
+{
+    HRESULT hr;
+
+    *info = NULL;
+    if (!netprofm_typelib)
+    {
+        WCHAR path[MAX_PATH];
+        HMODULE module;
+        ITypeLib *lib;
+
+        GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            (const WCHAR *)get_typeinfo, &module );
+        GetModuleFileNameW( module, path, ARRAY_SIZE(path) );
+        if (FAILED(hr = LoadTypeLibEx( path, REGKIND_NONE, &lib ))) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&netprofm_typelib, lib, NULL )) ITypeLib_Release( lib );
+    }
+    return ITypeLib_GetTypeInfoOfGuid( netprofm_typelib, riid, info );
+}
+
+static HRESULT disp_get_type_info_count( UINT *count )
+{
+    if (!count) return E_INVALIDARG;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT disp_get_type_info( REFIID riid, UINT index, ITypeInfo **info )
+{
+    if (!info) return E_INVALIDARG;
+    *info = NULL;
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo( riid, info );
+}
+
+static HRESULT disp_get_ids_of_names( REFIID riid, LPOLESTR *names, UINT count, DISPID *ids )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo( riid, &info ))) return hr;
+    hr = ITypeInfo_GetIDsOfNames( info, names, count, ids );
+    ITypeInfo_Release( info );
+    return hr;
+}
+
+static HRESULT disp_invoke( REFIID riid, void *obj, DISPID member, WORD flags, DISPPARAMS *params,
+                            VARIANT *result, EXCEPINFO *excep_info, UINT *arg_err )
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+#ifdef SG_MUTANT_NO_DISPATCH
+    return E_NOTIMPL;
+#endif
+    if (FAILED(hr = get_typeinfo( riid, &info ))) return hr;
+    hr = ITypeInfo_Invoke( info, obj, member, flags, params, result, excep_info, arg_err );
+    ITypeInfo_Release( info );
+    return hr;
+}
