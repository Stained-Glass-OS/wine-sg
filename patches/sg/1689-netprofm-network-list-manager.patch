+/* Stained Glass OS 1689: the host's network changes, told to the sinks */
+struct sink_call
+{
+    IUnknown *sink;
+};
+
+static ULONG get_sinks( struct connection_point *cp, IUnknown ***sinks )
+{
+    struct sink_entry *iter;
+    ULONG count = 0;
+
+    *sinks = NULL;
+    EnterCriticalSection( &sinks_cs );
+    if (!list_empty( &cp->sinks ) && (*sinks = calloc( list_count( &cp->sinks ), sizeof(IUnknown *) )))
+    {
+        LIST_FOR_EACH_ENTRY( iter, &cp->sinks, struct sink_entry, entry )
+        {
+            IUnknown *unk = NULL;
+            if (iter->git_cookie && get_git() &&
+                SUCCEEDED(IGlobalInterfaceTable_GetInterfaceFromGlobal( get_git(), iter->git_cookie, &cp->iid,
+                                                                        (void **)&unk )))
+                (*sinks)[count++] = unk;
+        }
+    }
+    LeaveCriticalSection( &sinks_cs );
+    return count;
+}
+
+static void refresh_networks( struct list_manager *mgr )
+{
+    IP_ADAPTER_ADDRESSES *buf, *aa;
+    struct connection *connection;
+    NLM_CONNECTIVITY old_total, changed[64];
+    GUID changed_ids[64];
+    IUnknown **sinks;
+    DWORD old_cost;
+    ULONG i, n, nchanged = 0;
+    HRESULT init;
+
+    if (!(buf = get_network_adapters())) return;
+    init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+
+    EnterCriticalSection( &mgr->cs );
+    old_total = mgr->connectivity;
+    old_cost = mgr->cost;
+    LIST_FOR_EACH_ENTRY( connection, &mgr->connections, struct connection, entry )
+    {
+        struct network *network = CONTAINING_RECORD( connection->network, struct network, INetwork_iface );
+        NLM_CONNECTIVITY before = connection->connectivity;
+        BOOL found = FALSE;
+
+        for (aa = buf; aa; aa = aa->Next)
+        {
+            NET_LUID luid;
+            GUID id;
+
+            ConvertInterfaceIndexToLuid( aa->IfIndex, &luid );
+            ConvertInterfaceLuidToGuid( &luid, &id );
+            if (!IsEqualGUID( &id, &connection->id )) continue;
+            apply_adapter( network, connection, aa );
+            found = TRUE;
+            break;
+        }
+        if (!found)
+        {
+            network->connectivity = connection->connectivity = NLM_CONNECTIVITY_DISCONNECTED;
+            network->connected = connection->connected = VARIANT_FALSE;
+            network->connected_to_internet = connection->connected_to_internet = VARIANT_FALSE;
+        }
+        if (before != connection->connectivity && nchanged < ARRAY_SIZE(changed))
+        {
+            if (!before) GetSystemTimeAsFileTime( &network->connected_time );
+            changed_ids[nchanged] = connection->id;
+            changed[nchanged++] = connection->connectivity;
+        }
+    }
+    update_totals( mgr );
+    LeaveCriticalSection( &mgr->cs );
+    free( buf );
+
+#ifdef SG_MUTANT_NO_EVENTS
+    nchanged = 0;
+    old_total = mgr->connectivity;
+    old_cost = mgr->cost;
+#endif
+    for (i = 0; i < nchanged; i++)
+    {
+        n = get_sinks( &mgr->events_cp, &sinks );
+        while (n--)
+        {
+            INetworkEvents_NetworkConnectivityChanged( (INetworkEvents *)sinks[n], changed_ids[i], changed[i] );
+            IUnknown_Release( sinks[n] );
+        }
+        free( sinks );
+        n = get_sinks( &mgr->conn_mgr_cp, &sinks );
+        while (n--)
+        {
+            INetworkConnectionEvents_NetworkConnectionConnectivityChanged( (INetworkConnectionEvents *)sinks[n],
+                                                                           changed_ids[i], changed[i] );
+            IUnknown_Release( sinks[n] );
+        }
+        free( sinks );
+    }
+    if (old_total != mgr->connectivity)
+    {
+        n = get_sinks( &mgr->list_mgr_cp, &sinks );
+        while (n--)
+        {
+            INetworkListManagerEvents_ConnectivityChanged( (INetworkListManagerEvents *)sinks[n], mgr->connectivity );
+            IUnknown_Release( sinks[n] );
+        }
+        free( sinks );
+    }
+    if (old_cost != mgr->cost)
+    {
+        n = get_sinks( &mgr->cost_mgr_cp, &sinks );
+        while (n--)
+        {
+            INetworkCostManagerEvents_CostChanged( (INetworkCostManagerEvents *)sinks[n], mgr->cost, NULL );
+            IUnknown_Release( sinks[n] );
+        }
+        free( sinks );
+    }
+    if (SUCCEEDED(init)) CoUninitialize();
+}
+
