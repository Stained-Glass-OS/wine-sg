+/* Stained Glass OS 1689: _NewEnum, an IEnumVARIANT of IDispatch objects
+ * over a copy of an IEnumNetworks or IEnumNetworkConnections */
+struct var_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refs;
+    IUnknown *inner;
+    BOOL networks;
+};
+
+static inline struct var_enum *impl_from_IEnumVARIANT( IEnumVARIANT *iface )
+{
+    return CONTAINING_RECORD( iface, struct var_enum, IEnumVARIANT_iface );
+}
+
+static HRESULT WINAPI var_enum_QueryInterface( IEnumVARIANT *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumVARIANT ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumVARIANT_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI var_enum_AddRef( IEnumVARIANT *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumVARIANT( iface )->refs );
+}
+
+static ULONG WINAPI var_enum_Release( IEnumVARIANT *iface )
+{
+    struct var_enum *e = impl_from_IEnumVARIANT( iface );
+    ULONG refs = InterlockedDecrement( &e->refs );
+
+    if (!refs)
+    {
+        IUnknown_Release( e->inner );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI var_enum_Next( IEnumVARIANT *iface, ULONG count, VARIANT *var, ULONG *fetched )
+{
+    struct var_enum *e = impl_from_IEnumVARIANT( iface );
+    ULONG i;
+
+    if (!var) return E_POINTER;
+    for (i = 0; i < count; i++)
+    {
+        IDispatch *disp = NULL;
+        ULONG got = 0;
+        HRESULT hr = e->networks ? IEnumNetworks_Next( (IEnumNetworks *)e->inner, 1, (INetwork **)&disp, &got )
+                                 : IEnumNetworkConnections_Next( (IEnumNetworkConnections *)e->inner, 1,
+                                                                 (INetworkConnection **)&disp, &got );
+        if (hr != S_OK || !got) break;
+        V_VT(&var[i]) = VT_DISPATCH;
+        V_DISPATCH(&var[i]) = disp;
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI var_enum_Skip( IEnumVARIANT *iface, ULONG count )
+{
+    struct var_enum *e = impl_from_IEnumVARIANT( iface );
+    return e->networks ? IEnumNetworks_Skip( (IEnumNetworks *)e->inner, count )
+                       : IEnumNetworkConnections_Skip( (IEnumNetworkConnections *)e->inner, count );
+}
+
+static HRESULT WINAPI var_enum_Reset( IEnumVARIANT *iface )
+{
+    struct var_enum *e = impl_from_IEnumVARIANT( iface );
+    return e->networks ? IEnumNetworks_Reset( (IEnumNetworks *)e->inner )
+                       : IEnumNetworkConnections_Reset( (IEnumNetworkConnections *)e->inner );
+}
+
+static HRESULT create_var_enum( IUnknown *inner, BOOL networks, IEnumVARIANT **ret );
+
+static HRESULT WINAPI var_enum_Clone( IEnumVARIANT *iface, IEnumVARIANT **ret )
+{
+    struct var_enum *e = impl_from_IEnumVARIANT( iface );
+    IUnknown *copy;
+    HRESULT hr;
+
+    hr = e->networks ? IEnumNetworks_Clone( (IEnumNetworks *)e->inner, (IEnumNetworks **)&copy )
+                     : IEnumNetworkConnections_Clone( (IEnumNetworkConnections *)e->inner,
+                                                      (IEnumNetworkConnections **)&copy );
+    if (FAILED(hr)) return hr;
+    hr = create_var_enum( copy, e->networks, ret );
+    IUnknown_Release( copy );
+    return hr;
+}
+
+static const IEnumVARIANTVtbl var_enum_vtbl =
+{
+    var_enum_QueryInterface, var_enum_AddRef, var_enum_Release,
+    var_enum_Next, var_enum_Skip, var_enum_Reset, var_enum_Clone
+};
+
+static HRESULT create_var_enum( IUnknown *inner, BOOL networks, IEnumVARIANT **ret )
+{
+    struct var_enum *e;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->IEnumVARIANT_iface.lpVtbl = &var_enum_vtbl;
+    e->refs = 1;
+    e->inner = inner;
+    IUnknown_AddRef( inner );
+    e->networks = networks;
+    *ret = &e->IEnumVARIANT_iface;
+    return S_OK;
+}
