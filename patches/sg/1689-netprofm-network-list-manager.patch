+              id->Data4[0], id->Data4[1], id->Data4[2], id->Data4[3], id->Data4[4], id->Data4[5],
+              id->Data4[6], id->Data4[7] );
+}
+
+static HRESULT set_profile_value( const GUID *id, const WCHAR *name, DWORD type, const void *data, DWORD size )
+{
+    WCHAR path[256];
+    LSTATUS ret;
+    HKEY key;
+
+    profile_key_name( id, path, ARRAY_SIZE(path) );
+    if ((ret = RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, 0, KEY_SET_VALUE, NULL, &key, NULL )))
+        return HRESULT_FROM_WIN32( ret );
+    ret = RegSetValueExW( key, name, 0, type, data, size );
+    RegCloseKey( key );
+    return HRESULT_FROM_WIN32( ret );
+}
+
+static HRESULT set_profile_string( const GUID *id, const WCHAR *name, const WCHAR *value )
+{
+    return set_profile_value( id, name, REG_SZ, value, (wcslen( value ) + 1) * sizeof(WCHAR) );
+}
+
+static void read_profile( struct network *network )
+{
+    WCHAR path[256];
+    DWORD size, value;
+    SYSTEMTIME st;
+    HKEY key;
+
+    profile_key_name( &network->id, path, ARRAY_SIZE(path) );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key )) return;
+    size = sizeof(network->name);
+    RegQueryValueExW( key, L"ProfileName", NULL, NULL, (BYTE *)network->name, &size );
+    size = sizeof(network->description);
+    RegQueryValueExW( key, L"Description", NULL, NULL, (BYTE *)network->description, &size );
+    size = sizeof(value);
+    if (!RegQueryValueExW( key, L"Category", NULL, NULL, (BYTE *)&value, &size ) && value <= 2)
+        network->category = value;
+    size = sizeof(st);
+    if (!RegQueryValueExW( key, L"DateCreated", NULL, NULL, (BYTE *)&st, &size ) && size == sizeof(st))
+        SystemTimeToFileTime( &st, &network->created );
+    RegCloseKey( key );
+}
+
+/* the cost Windows gives a medium: HKLM\...\NetworkList\DefaultMediaCost
+ * (1 unrestricted, 2 fixed, i.e. metered) */
+static DWORD media_cost( DWORD if_type )
+{
+    const WCHAR *name = L"Default";
+    DWORD value = 0, size = sizeof(value);
+
+    if (if_type == IF_TYPE_ETHERNET_CSMACD) name = L"Ethernet";
+    else if (if_type == IF_TYPE_IEEE80211) name = L"WiFi";
+    else if (if_type == IF_TYPE_WWANPP || if_type == IF_TYPE_WWANPP2) name = L"4G";
+#ifndef SG_MUTANT_NO_MEDIA_COST
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\NetworkList\\DefaultMediaCost",
+                      name, RRF_RT_REG_DWORD, NULL, &value, &size ) || !value)
+#endif
+        value = 1;
+    return value == 2 ? NLM_CONNECTION_COST_FIXED : NLM_CONNECTION_COST_UNRESTRICTED;
+}
+
+static BOOL ipv6_is_global( const SOCKADDR_IN6 *addr )
+{
+    const BYTE *b = addr->sin6_addr.u.Byte;
+
+    if (b[0] == 0xfe && (b[1] & 0xc0) == 0x80) return FALSE;   /* link-local */
+    if (IN6_IS_ADDR_LOOPBACK( &addr->sin6_addr )) return FALSE;
+    return TRUE;
+}
+
+/* an adapter's connectivity: addresses for the local network, a gateway
+ * (a default route) for the internet, IPv4 and IPv6 apart */
+static NLM_CONNECTIVITY adapter_connectivity( const IP_ADAPTER_ADDRESSES *aa )
+{
+    IP_ADAPTER_UNICAST_ADDRESS *ua;
+    IP_ADAPTER_GATEWAY_ADDRESS *gw;
+    NLM_CONNECTIVITY ret = NLM_CONNECTIVITY_DISCONNECTED;
+    BOOL v4 = FALSE, v6 = FALSE;
+
+    if (aa->OperStatus != IfOperStatusUp || aa->IfType == IF_TYPE_SOFTWARE_LOOPBACK) return ret;
+    for (ua = aa->FirstUnicastAddress; ua; ua = ua->Next)
+    {
+        if (ua->Address.lpSockaddr->sa_family == AF_INET) v4 = TRUE;
+        else if (ua->Address.lpSockaddr->sa_family == AF_INET6 &&
+                 ipv6_is_global( (SOCKADDR_IN6 *)ua->Address.lpSockaddr )) v6 = TRUE;
+    }
+    if (v4) ret |= NLM_CONNECTIVITY_IPV4_LOCALNETWORK;
+    if (v6) ret |= NLM_CONNECTIVITY_IPV6_LOCALNETWORK;
+    for (gw = aa->FirstGatewayAddress; gw; gw = gw->Next)
+    {
+        if (gw->Address.lpSockaddr->sa_family == AF_INET && v4)
+            ret = (ret & ~NLM_CONNECTIVITY_IPV4_LOCALNETWORK) | NLM_CONNECTIVITY_IPV4_INTERNET;
+        else if (gw->Address.lpSockaddr->sa_family == AF_INET6 && v6)
+            ret = (ret & ~NLM_CONNECTIVITY_IPV6_LOCALNETWORK) | NLM_CONNECTIVITY_IPV6_INTERNET;
+    }
+    return ret;
+}
+
+static NLM_DOMAIN_TYPE adapter_domain_type( const IP_ADAPTER_ADDRESSES *aa )
+{
+    WCHAR domain[256];
+    DWORD size = ARRAY_SIZE(domain);
+
+    /* a network of the machine's own domain */
+    if (GetComputerNameExW( ComputerNameDnsDomain, domain, &size ) && domain[0] &&
+        aa->DnsSuffix && !wcsicmp( aa->DnsSuffix, domain ))
+        return NLM_DOMAIN_TYPE_DOMAIN_AUTHENTICATED;
+    return NLM_DOMAIN_TYPE_NON_DOMAIN_NETWORK;
+}
