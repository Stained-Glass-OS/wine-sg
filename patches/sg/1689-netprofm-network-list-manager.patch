+    if (IsEqualGUID( riid, &IID_IEnumConnectionPoints ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumConnectionPoints_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cp_enum_AddRef( IEnumConnectionPoints *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumConnectionPoints( iface )->refs );
+}
+
+static ULONG WINAPI cp_enum_Release( IEnumConnectionPoints *iface )
+{
+    struct cp_enum *e = impl_from_IEnumConnectionPoints( iface );
+    ULONG refs = InterlockedDecrement( &e->refs );
+
+    if (!refs)
+    {
+        INetworkListManager_Release( &e->mgr->INetworkListManager_iface );
+        free( e );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI cp_enum_Next( IEnumConnectionPoints *iface, ULONG count, IConnectionPoint **cps, ULONG *fetched )
+{
+    struct cp_enum *e = impl_from_IEnumConnectionPoints( iface );
+    ULONG i;
+
+    if (!cps) return E_POINTER;
+    for (i = 0; i < count && e->pos < 4; i++, e->pos++)
+    {
+        cps[i] = cp_at( e->mgr, e->pos );
+        IConnectionPoint_AddRef( cps[i] );
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI cp_enum_Skip( IEnumConnectionPoints *iface, ULONG count )
+{
+    struct cp_enum *e = impl_from_IEnumConnectionPoints( iface );
+
+    if (e->pos + count > 4)
+    {
+        e->pos = 4;
+        return S_FALSE;
+    }
+    e->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI cp_enum_Reset( IEnumConnectionPoints *iface )
+{
+    impl_from_IEnumConnectionPoints( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_cp_enum( struct list_manager *mgr, ULONG pos, IEnumConnectionPoints **ret );
+
+static HRESULT WINAPI cp_enum_Clone( IEnumConnectionPoints *iface, IEnumConnectionPoints **ret )
+{
+    struct cp_enum *e = impl_from_IEnumConnectionPoints( iface );
+    return create_cp_enum( e->mgr, e->pos, ret );
+}
+
+static const IEnumConnectionPointsVtbl cp_enum_vtbl =
+{
+    cp_enum_QueryInterface, cp_enum_AddRef, cp_enum_Release,
+    cp_enum_Next, cp_enum_Skip, cp_enum_Reset, cp_enum_Clone
+};
+
+static HRESULT create_cp_enum( struct list_manager *mgr, ULONG pos, IEnumConnectionPoints **ret )
+{
+    struct cp_enum *e;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->IEnumConnectionPoints_iface.lpVtbl = &cp_enum_vtbl;
+    e->refs = 1;
+    e->mgr = mgr;
+    INetworkListManager_AddRef( &mgr->INetworkListManager_iface );
+    e->pos = pos;
+    *ret = &e->IEnumConnectionPoints_iface;
+    return S_OK;
+}
