+    if (!(data = malloc( max( count, 1 ) * sizeof(*data) )))
+    {
+        LeaveCriticalSection( &sinks_cs );
+        return E_OUTOFMEMORY;
+    }
+    count = 0;
+    LIST_FOR_EACH_ENTRY( iter, &cp->sinks, struct sink_entry, entry )
+    {
+        data[count].pUnk = iter->unk;
+        data[count].dwCookie = iter->cookie;
+        count++;
+    }
+    hr = create_enum_connections( data, count, 0, connections );
+    LeaveCriticalSection( &sinks_cs );
+    free( data );
+    return hr;
 }
 
